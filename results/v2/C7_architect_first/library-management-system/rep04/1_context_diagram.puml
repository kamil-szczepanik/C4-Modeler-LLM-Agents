@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patron_Library_Administrator_Staff, "Patron & Library Administrator / Staff", "End-users accessing self-service portals, circulation tools, and reporting via WCAG 2.1 AA accessibility standards.")
System(Library_Management_System_LMS, "Library Management System (LMS)", "A EU-hosted solution providing public and academic libraries with cataloging, circulation, and self-service portals, ensuring high-performance item searches and strict regional compliance.")
System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "Manages authentication via OAuth 2.0 / OpenID Connect and issues signed JWTs.")
System_Ext(Payment_Gateway, "Payment Gateway", "Processes fines and fees with PCI-DSS compliance.")
System_Ext(Notification_Service, "Notification Service", "Handles automated transactional alerts (SendGrid/Twilio EU region).")

Rel(Patron_Library_Administrator_Staff, Library_Management_System_LMS, "Accesses self-service portals, circulation tools, and reporting", "HTTPS / REST using TLS 1.3, mTLS, and API rate-limiting")
Rel(Library_Management_System_LMS, Identity_Provider_IdP, "Authenticates users and enforces RBAC", "OpenID Connect / OAuth 2.0")
Rel(Library_Management_System_LMS, Payment_Gateway, "Processes fines and fees securely", "HTTPS / REST with regional EU acquirers")
Rel(Library_Management_System_LMS, Notification_Service, "Sends automated transactional alerts", "Asynchronous webhooks with HMAC signature verification")
@enduml