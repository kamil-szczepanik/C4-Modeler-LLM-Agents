@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System (LMS)

Person(patron_staff, "Patron & Library Administrator / Staff", "End-users accessing self-service portals, circulation tools, and reporting via WCAG 2.1 AA accessibility standards.")

System_Ext(idp, "Identity Provider (IdP)", "Manages authentication via OAuth 2.0 / OpenID Connect and issues signed JWTs.")
System_Ext(payment_gateway, "Payment Gateway", "Processes fines and fees with PCI-DSS compliance.")
System_Ext(notification_service, "Notification Service", "Handles automated transactional alerts (SendGrid/Twilio EU region).")

System_Boundary(lms, "Library Management System (LMS)") {
    Container(web_app, "Web App (SPA)", "React, Nginx", "Frontend delivery for patrons and staff.")
    Container(api_gateway, "API Gateway", "Spring Cloud Gateway, OAuth2/OIDC", "Microservice orchestration and API routing.")
    Container(core_services, "Core Services Container", "Spring Boot", "Microservices handling core business logic.")
    Container(search_container, "Search Container", "Elasticsearch", "High-performance catalogue searching.")
    Container(worker_container, "Worker Container", "Python, Celery, RabbitMQ, Redis", "Background worker processing and broker.")
    Container(telemetry_container, "Telemetry Container", "Prometheus, Grafana, Fluentbit", "Monitoring, telemetry, and logging.")
    ContainerDb(database, "Database", "PostgreSQL, AES-256 encryption", "Transactional relational data storage.")
}

Rel(patron_staff, web_app, "Accesses portals and UI", "HTTPS with TLS 1.3")
Rel(web_app, api_gateway, "Sends API requests", "HTTPS with TLS 1.3")
Rel(api_gateway, core_services, "Routes requests to core services", "gRPC / internal REST with mTLS")
Rel(core_services, database, "Reads and writes transactional data", "Restricted private EU subnet with AES-256")
Rel(core_services, search_container, "Synchronizes data for searching", "Asynchronous change data capture (CDC) sync")

Rel(api_gateway, idp, "Authenticates users and enforces RBAC", "OpenID Connect / OAuth 2.0")
Rel(core_services, payment_gateway, "Processes fines and fees securely", "HTTPS / REST with regional EU acquirers")
Rel(core_services, notification_service, "Sends automated transactional alerts", "Asynchronous webhooks with HMAC signature verification")

@enduml