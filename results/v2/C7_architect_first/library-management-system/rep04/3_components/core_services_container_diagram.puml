@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Services Container container

System_Ext(api_gateway, "API Gateway", "Gateway", "External dependency handling routing and authentication.")
System_Ext(postgresql_database, "PostgreSQL Database", "PostgreSQL", "External database dependency.")
System_Ext(elasticsearch_search_container, "Elasticsearch Search Container", "Elasticsearch", "External search container dependency.")
System_Ext(rabbitmq, "RabbitMQ", "RabbitMQ", "External message broker and dead-letter queue.")

Container_Boundary(core_services_container, "Core Services Container") {
    Component(catalog_component, "Catalog Component", "Spring @Service, JPA", "Manages physical and digital item metadata.")
    Component(circulation_component, "Circulation Component", "Spring @Service, JPA", "Handles borrowing, returns, and holds logic.")
    Component(patron_account_component, "Patron Account Component", "Spring @Service, JPA", "Manages user profiles and EU-constrained PII.")
    Component(data_access_layer, "Data Access Layer", "Spring Data JPA, Hibernate", "Enforces EU-only data residency and AES-256 encryption.")
}

Rel(api_gateway, catalog_component, "Authenticated gRPC / internal REST", "mTLS, W3C Trace Context, Spring Security @PreAuthorize")
Rel(api_gateway, circulation_component, "Authenticated gRPC / internal REST", "mTLS, W3C Trace Context, Spring Security @PreAuthorize")
Rel(api_gateway, patron_account_component, "Authenticated gRPC / internal REST", "mTLS, W3C Trace Context, Spring Security @PreAuthorize")
Rel(catalog_component, data_access_layer, "JDBC over TLS 1.3", "private EU subnet")
Rel(circulation_component, data_access_layer, "JDBC over TLS 1.3", "private EU subnet")
Rel(catalog_component, elasticsearch_search_container, "Asynchronous Change Data Capture (CDC)", "Debezium and RabbitMQ DLQ")

@enduml