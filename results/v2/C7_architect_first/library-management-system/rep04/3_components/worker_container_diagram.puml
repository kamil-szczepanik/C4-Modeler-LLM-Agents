@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Worker Container container

Container_Boundary(worker_container, "Worker Container") {
    Component(Task_Dispatch_Consumer, "Task Dispatch Consumer", "Python, Celery", "Executes asynchronous background tasks and consumes messages from the message broker.")
    Component(Notification_Processor, "Notification Processor", "Python", "Processes and sends notifications to external notification services.")
    Component(Index_Synchronizer, "Index Synchronizer", "Python", "Pushes updates to the Search Container to keep indexes synchronized.")
    Component(State_Cache_Manager, "State Cache Manager", "Python client, Redis", "Manages ephemeral state, rate-limiting, and distributed locking.")
    Component(Fine_Circulation_Batch_Processor, "Fine & Circulation Batch Processor", "Python", "Handles batch processing for fines and circulation, querying the database and calling payment gateways.")
}

Component_Ext(RabbitMQ, "RabbitMQ", "RabbitMQ", "Message broker with AMQPS transport security and Dead Letter Queues.")
Component_Ext(Search_Container, "Search Container", "Elasticsearch", "External search container for indexing and searching.")
Component_Ext(Notification_Service, "Notification Service", "External Service", "External service responsible for dispatching notifications.")
Component_Ext(Payment_Gateway, "Payment Gateway", "External Service", "External service for processing financial transactions and fines.")
Component_Ext(Database, "Database", "PostgreSQL", "Relational database for storing library data.")
Component_Ext(Telemetry_Container, "Telemetry Container", "Prometheus, Grafana, Fluentbit", "Provides telemetry, audit log streaming, and PII masking.")

Rel(Task_Dispatch_Consumer, RabbitMQ, "Receives messages from via AMQPS (TLS 1.3)", "AMQPS")
Rel(Index_Synchronizer, Search_Container, "Pushes updates via HTTP/REST", "HTTP/REST")
Rel(Notification_Processor, Notification_Service, "Calls external service via HTTPS (TLS 1.3)", "HTTPS")
Rel(Fine_Circulation_Batch_Processor, Payment_Gateway, "Calls external service via HTTPS (TLS 1.3)", "HTTPS")
Rel(Task_Dispatch_Consumer, State_Cache_Manager, "Interacts via TCP/RESP (TLS)", "TCP/RESP")
Rel(Notification_Processor, State_Cache_Manager, "Interacts via TCP/RESP (TLS)", "TCP/RESP")
Rel(Index_Synchronizer, State_Cache_Manager, "Interacts via TCP/RESP (TLS)", "TCP/RESP")
Rel(Fine_Circulation_Batch_Processor, State_Cache_Manager, "Interacts via TCP/RESP (TLS)", "TCP/RESP")
Rel(Fine_Circulation_Batch_Processor, Database, "Queries via JDBC/TCP", "JDBC/TCP")

@enduml