@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component Diagram for the Database Container

Container_Ext(core_services, "Core Services Container", "Microservices", "Provides cataloging, circulation, and self-service logic.")
Container_Ext(telemetry, "Telemetry Container", "Monitoring", "Collects metrics and system performance data.")

Container_Boundary(database_container, "Database Container") {
    Component(Connection_Pooler, "Connection Pooler", "PgBouncer", "Inbound connection management to prevent exhaustion under load.")
    Component(Relational_Storage_Engine, "Relational Storage Engine", "PostgreSQL Core", "Core relational data storage enforcing ACID compliance.")
    Component(Read_Replica_Routing_Layer, "Read-Replica Routing Layer", "Routing Layer", "Routes read-only queries to replicas.")
    Component(Row_Level_Security_RLS_Policy_Engine, "Row-Level Security (RLS) Policy Engine", "PostgreSQL RLS", "Enforces row-level security for data protection.")
    Component(Audit_Logging_Module, "Audit Logging Module", "pgaudit", "Security and administrative event capture for compliance reporting.")
    Component(Patroni_Primary_Replica_Cluster, "Patroni Primary-Replica Cluster", "Patroni with etcd", "Automated high-availability failover and consensus management.")
    Component(HashiCorp_Vault, "HashiCorp Vault", "HashiCorp Vault", "Dynamic, short-lived database credential provisioning.")
}

Rel(core_services, Connection_Pooler, "Manages persistent connections", "JDBC/TCP, TLS 1.3")
Rel(Connection_Pooler, Relational_Storage_Engine, "Routes write and transactional queries", "TCP")
Rel(Connection_Pooler, Read_Replica_Routing_Layer, "Routes read-only queries", "TCP")
Rel(Read_Replica_Routing_Layer, Patroni_Primary_Replica_Cluster, "Distributes read queries", "TCP, mTLS")
Rel(telemetry, Connection_Pooler, "Scrapes metrics and replication lag", "Prometheus exporter")

@enduml