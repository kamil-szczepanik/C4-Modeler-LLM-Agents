@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web App (SPA) container

Container_Boundary(web_app_spa, "Web App (SPA)") {
    Component(API_Client, "API Client", "React Query / Zustand", "Executes deduplicated HTTP calls and implements in-memory state management and caching.")
    Component(Telemetry_Wrapper, "Telemetry Wrapper", "Sentry / Telemetry SDK", "Tracks anonymized Real User Monitoring and Core Web Vitals.")
}

System_Ext(Telemetry_Container, "Telemetry Container", "Prometheus, Grafana, Fluentbit")

Rel(State_Management_Layer, API_Client, "Executes deduplicated HTTP calls")
Rel(Telemetry_Wrapper, Telemetry_Container, "Forwards anonymized performance metrics", "HTTPS")

@enduml