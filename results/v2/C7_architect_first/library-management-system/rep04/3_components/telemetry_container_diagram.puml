@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Library Administrator, "Library Administrator", "Business-value dashboard consumer")

System_Ext(Core Services, "Core Services", "External core services container pulling metrics.")
System_Ext(Search, "Search", "External search container pulling metrics.")
System_Ext(API Gateway, "API Gateway", "External API gateway pulling metrics.")
System_Ext(All Containers, "All Containers", "All system containers writing logs.")
System_Ext(External Alert Sink, "External Alert Sink", "External tool receiving webhooks from Grafana.")

Container_Boundary(telemetry_container, "Telemetry Container") {
    Component(Prometheus, "Prometheus", "Prometheus & Prometheus Rule Evaluator", "Metrics Scraper, TSDB, Rule Evaluator, and secondary replication for long-term storage, providing metrics collection and pre-aggregation for PromQL queries.")
    Component(Fluentbit, "Fluentbit", "Fluentbit", "Log Forwarder with disk-backed queues, rate limiting, and PII sanitization for log collection, scrubbing, and rate-limited log forwarding.")
    Component(Grafana, "Grafana", "Grafana", "Visualization and Alerting UI with RBAC and immutable audit logging for operational and business dashboard visualization.")
    Component(Blackbox Exporter, "Blackbox Exporter", "Blackbox Exporter", "Synthetic probing for search SLA verification (< 800ms) and R-05 SLA tracking.")
}

Rel(Core Services, Prometheus, "Pulls metrics", "HTTP/TCP")
Rel(Search, Prometheus, "Pulls metrics", "HTTP/TCP")
Rel(API Gateway, Prometheus, "Pulls metrics", "HTTP/TCP")
Rel(All Containers, Fluentbit, "Writes logs", "local socket/file mounts")
Rel(Prometheus, Prometheus, "Internal evaluation loop", "Scraper to Rule Evaluator")
Rel(Library Administrator, Grafana, "HTTPS", "via API Gateway OIDC integration")
Rel(Grafana, External Alert Sink, "Webhooks", "PagerDuty/EU-hosted incident tool")
@enduml