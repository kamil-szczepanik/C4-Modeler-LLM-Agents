@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

System_Ext(IdP, "Identity Provider (IdP)", "Identity Provider system")
System_Ext(CoreServicesContainer, "Core Services Container", "Core Services backend container")
System_Ext(Redis, "Redis", "Redis infrastructure (EU-only)")

Container_Boundary(api_gateway, "API Gateway") {
    Component(RoutingFilter, "Routing Filter", "Spring Cloud Gateway Filter", "Proxies and routes incoming client requests to core services.")
    Component(AuthFilter, "Auth Filter", "Spring Cloud Gateway Filter", "Validates OAuth2/OIDC JWT tokens against the Identity Provider.")
    Component(RateLimitingResiliency, "Rate Limiting & Resiliency", "Resilience4j & Redis", "Protects backend SLAs using token bucket rate-limiting and circuit breakers.")
    Component(DistributedTracingFilter, "Distributed Tracing Filter", "W3C Trace Context", "Enables distributed tracing across requests.")
    Component(TokenTranslationComponent, "Token Translation Component", "Spring Bean", "Translates and validates tokens at the edge to protect backend systems.")
}

Rel(AuthFilter, IdP, "Validates OAuth2/OIDC JWT tokens", "HTTPS")
Rel(RoutingFilter, CoreServicesContainer, "Proxies requests", "gRPC over mTLS")
Rel(RateLimitingResiliency, Redis, "Checks token bucket rate-limiting", "TCP")

@enduml