@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Search Container container

System_Ext(api_gateway, "API Gateway", "External API Gateway routing requests.")

Container_Boundary(search_container, "Search Container") {
    Component(search_router, "Search Router / API Handler", "Java / Spring Boot", "Processes complex search queries, facets, and spelling suggestions, and handles JWT validation.")
    Component(facet_processor, "Facet & Aggregation Processor", "Java / Spring Boot", "Processes facets and aggregations for item discovery.")
    Component(search_index, "Search Engine Index", "Elasticsearch 8.x, 3-node Kubernetes StatefulSet", "Delivers fast, secure item discovery for patrons and staff using inverted indices and multi-match queries.")
    Component(cdc_listener, "CDC Ingestion Listener", "Logstash / Kafka Connect", "Handles low-latency index updates via internal TCP/Transport protocol.")
    Component(caching_layer, "Caching Layer", "Redis", "Implements short-TTL caching for frequent search queries, facet counts, and rate limiting.")
}

Rel(api_gateway, search_router, "REST/HTTPS (JSON payload) with JWT validation")
Rel(search_router, search_index, "REST/Transport protocol using optimized Query DSL")
Rel(cdc_listener, search_index, "Internal TCP/Transport protocol for low-latency index updates")
Rel(search_router, caching_layer, "In-memory caching for frequent search queries and facet counts")

@enduml