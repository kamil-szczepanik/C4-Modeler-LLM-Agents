@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Library Management System

Person(Library Patrons & Staff, "Library Patrons & Staff", "End-users accessing self-service portals and administrative workflows.")
System(Library Management System, "Library Management System", "A cloud-native platform designed for public and academic libraries to catalogue physical and digital items, manage circulation, and provide self-service portals with strict EU-only data residency.")
System_Ext(CDN / Edge Layer, "CDN / Edge Layer", "Cloudflare or AWS CloudFront with EU-only POPs providing edge routing and caching.")
System_Ext(Identity Provider, "Identity Provider", "Keycloak or Auth0 EU instance supporting OIDC and MFA.")
System_Ext(External Payment Gateway, "External Payment Gateway", "EU-compliant vendor for processing fines and fees.")
System_Ext(National Library Database, "National Library Database", "EU-compliant source for bibliographic data imports.")
System_Ext(Centralized Observability Platform, "Centralized Observability Platform", "APM and distributed tracing system.")

Rel(Library Patrons & Staff, CDN / Edge Layer, "Accesses self-service portals and admin workflows", "HTTPS (TLS 1.3)")
Rel(CDN / Edge Layer, Library Management System, "Routes client requests to the core platform", "HTTPS/REST")
Rel(Library Management System, Identity Provider, "Authenticates users and manages sessions", "OIDC")
Rel(Library Management System, External Payment Gateway, "Processes library fines and fees", "HTTPS/REST (EU endpoints via DPAs)")
Rel(Library Management System, National Library Database, "Imports bibliographic data", "HTTPS/REST (EU endpoints via DPAs)")

@enduml