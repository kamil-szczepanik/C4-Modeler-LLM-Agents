@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(patrons_staff, "Library Patrons & Staff", "Users of the system")
System_Ext(api_gateway, "API Gateway", "Nginx / Kong", "Gateway for API requests")

Container_Boundary(web_app_spa, "Web Application (SPA)") {
    Component(router_component, "Router Component", "React Router", "Navigates views.")
    Component(state_management, "State Management & Data Fetching Component", "TanStack Query / Zustand", "Handles caching, optimistic UI updates, and data synchronization.")
    Component(ui_component_library, "UI Component Library", "Tailwind CSS / Radix UI", "Ensures accessible, responsive design meeting WCAG 2.1 AA.")
    Component(ui_rbac_adapter, "UI RBAC & Claims Adapter", "React / JavaScript", "Validates session state and handles role-based access control.")
    Component(offline_persistence, "Offline Persistence & Queue Component", "IndexedDB / Workbox / Web Crypto API", "Enables offline persistence, mutation queuing, and client-side encryption for sensitive data at rest.")
}

Rel(patrons_staff, router_component, "Navigates views", "HTTPS")
Rel(state_management, api_gateway, "Sends API requests", "HTTPS/REST with TLS 1.3")
Rel(state_management, offline_persistence, "Persists drafts and queued mutations", "Local IndexedDB")
Rel(ui_rbac_adapter, api_gateway, "Validates session state via HttpOnly cookies", "HTTPS/REST")

@enduml