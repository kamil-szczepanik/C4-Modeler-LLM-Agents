@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "External gateway routing requests")

Container_Boundary(search_service, "Search Service") {
    Component(search_controller, "Search REST/gRPC Controller", "Java / Spring Boot", "Exposes search endpoints and handles incoming search requests.")
    Component(query_builder, "Query Builder Component", "Java", "Processes sanitized requests and user roles, and constructs DSL queries.")
    Component(faceting_engine, "Faceting & Suggestion Engine", "Java", "Processes aggregations, faceting, and spellcheck suggestions.")
    Component(es_adapter, "Elasticsearch Client Adapter", "Java / High-Level REST Client", "Executes queries and indexing operations against the search engine cluster.")
    Component(kafka_consumer, "Index Synchronization Consumer", "Java / Kafka Consumer", "Consumes Kafka domain events to asynchronously update index data.")
}

System_Ext(search_cluster, "Search Engine Cluster", "Elasticsearch, EU-hosted", "Provides high-performance full-text search, native faceting, and suggestion capabilities.")

Rel(api_gateway, search_controller, "Forwards search requests", "gRPC over mTLS")
Rel(search_controller, query_builder, "Passes sanitized requests and user roles", "In-process Java method calls")
Rel(query_builder, faceting_engine, "Processes aggregations and spellcheck", "In-process Java method calls")
Rel(query_builder, es_adapter, "Passes constructed DSL queries", "In-process Java method calls")
Rel(es_adapter, search_cluster, "Executes queries/indexing", "HTTP/Bolt over TCP with TLS v1.3")
Rel(kafka_consumer, search_cluster, "Updates index data", "Kafka domain events")

@enduml