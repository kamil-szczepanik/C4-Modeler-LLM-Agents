@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Async Worker container

Component(CoreDomainService, "Core Domain Service", "Microservice", "Core domain service providing system triggers.")
Component_Ext(NationalLibraryDatabase, "National Library Database", "External Database", "External national library database for synchronization.")
Component_Ext(TelemetrySidecarOTELCollector, "Telemetry Sidecar / OTEL Collector", "OpenTelemetry", "Collects distributed telemetry and traces.")

Container_Boundary(AsyncWorker, "Async Worker") {
    Component(TaskDispatcherReceiver, "Task Dispatcher Receiver", "Python / Celery (AMQP)", "Consumes messages via AMQP.")
    Component(CeleryTaskRouterComponent, "Celery Task Router Component", "Python / Celery", "Validates AMQP signatures, enforces JSON serialization, and routes tasks.")
    Component(DLQHandlerComponent, "DLQ Handler Component", "Python / Celery", "Captures failed tasks and sanitizes PII payloads.")
    Component(SyncOrchestratorComponent, "Sync Orchestrator Component", "Python / Celery", "Manages National Library Database synchronization.")
    Component(NotificationProcessorComponent, "Notification Processor Component", "Python / Celery", "Handles multi-language patron alerts.")
    Component(NotificationTemplatesComponent, "Notification Templates Component", "Python / Celery", "Manages localized messaging policies.")
}

Rel(CoreDomainService, TaskDispatcherReceiver, "AMQP over TLS with RabbitMQ", "AMQP")
Rel(TaskDispatcherReceiver, CeleryTaskRouterComponent, "In-memory function call", "In-memory")
Rel(CeleryTaskRouterComponent, DLQHandlerComponent, "In-memory on failure", "In-memory")
Rel(SyncOrchestratorComponent, NationalLibraryDatabase, "HTTPS/REST with TLS 1.3", "HTTPS/REST")
Rel(AsyncWorker, TelemetrySidecarOTELCollector, "OpenTelemetry context propagation", "OpenTelemetry")

@enduml