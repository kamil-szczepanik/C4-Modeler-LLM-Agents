@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("API Gateway", "API Gateway") {
    Component(Ingress_Listener, "Ingress Listener", "Kong Proxy", "Handles incoming HTTP/HTTPS traffic from the Web Application SPA and routes it appropriately.")
    Component(Security_Auth_Plugin, "Security & Auth Plugin", "Kong Plugin / Coraza WAF", "Enforces JWT/OIDC authentication, mTLS, and web application firewall security rules.")
    Component(Rate_Limiting_Quota_Component, "Rate-Limiting & Quota Component", "Kong Rate Limiting / Redis", "Manages sliding-window rate-limiting using a high-availability Redis cluster.")
    Component(Routing_Upstream_Balancer, "Routing & Upstream Balancer", "Kong Upstream Balancer", "Routes core business and search requests to downstream microservices via gRPC over mTLS.")
    Component(Transform_Error_Mapping_Component, "Transform & Error Mapping Component", "Kong Transform Plugin", "Transforms request/response payloads and maps error codes for consistent API responses.")
    Component(Telemetry_Exporter, "Telemetry Exporter", "OpenTelemetry (OTLP)", "Forwards access logs and metrics to the Centralized Observability Platform.")
}

Rel(Ingress_Listener, Security_Auth_Plugin, "Passes incoming requests for authentication and security inspection", "")
Rel(Security_Auth_Plugin, Rate_Limiting_Quota_Component, "Checks rate limits for authenticated requests", "")
Rel(Rate_Limiting_Quota_Component, Transform_Error_Mapping_Component, "Forwards valid requests for payload transformation", "")
Rel(Transform_Error_Mapping_Component, Routing_Upstream_Balancer, "Dispatches processed requests to upstream services", "")
Rel(Routing_Upstream_Balancer, Telemetry_Exporter, "Emits request metrics and access logs", "")

@enduml