@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Search Engine container

Component(CoreServicesAPI, "Core Services API", "HTTPS / REST with mTLS", "Submits search queries to the Search Engine.")
Component(AsyncWorker, "Async Worker", "HTTP / REST (Bulk API)", "Synchronizes catalogue item mutations secured by mTLS/IAM.")

Container_Boundary(SearchEngine, "Search Engine") {
    Component(QueryParserComponent, "Query Parser Component", "Lucene Query DSL engine", "Handling sanitization, fuzzy matching, facets, and PII masking.")
    Component(IndexingPipelineComponent, "Indexing Pipeline Component", "Tokenizer and bulk ingestion pipeline", "Featuring language analyzers and circuit breakers.")
    Component(StorageClusterRoutingComponent, "Storage & Cluster Routing Component", "Apache Lucene distributed shards on multi-AZ OpenSearch data nodes", "Manages distributed shards and cluster routing.")
    Component(RedisDeadLetterQueueDLQ, "Redis Dead-Letter Queue (DLQ)", "Redis", "Backpressure handler for bulk synchronization.")
    Component(AnalyticsDatastore, "Analytics Datastore", "ClickHouse/TimescaleDB", "Receiving search analytics, zero-result tracking, and audit logs.")
}

Rel(CoreServicesAPI, QueryParserComponent, "Submits search queries", "HTTPS / REST with mTLS")
Rel(AsyncWorker, IndexingPipelineComponent, "Synchronizes catalogue item mutations", "HTTP / REST (Bulk API)")
Rel(QueryParserComponent, StorageClusterRoutingComponent, "Executes optimized Lucene search shards", "Internal Bolt/Transport Protocol")
Rel(QueryParserComponent, AnalyticsDatastore, "Streams metrics, slow-logs, and zero-results tracking", "")
Rel(IndexingPipelineComponent, AnalyticsDatastore, "Streams metrics, slow-logs, and zero-results tracking", "")
Rel(StorageClusterRoutingComponent, AnalyticsDatastore, "Streams metrics, slow-logs, and zero-results tracking", "")

@enduml