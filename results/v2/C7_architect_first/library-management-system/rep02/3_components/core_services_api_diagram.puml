@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Services API container

Component(API_Gateway, "API Gateway", "API Gateway", "Routes requests via gRPC with mTLS to the Core Services API.")

System_Boundary(Core_Services_API, "Core Services API") {
    Component(Catalogue_Management_Component, "Catalogue Management Component", "NestJS module", "NestJS module for physical and digital item CRUD operations.")
    Component(Circulation___RBAC_Component, "Circulation & RBAC Component", "NestJS module", "NestJS module enforcing role-based access control and loan logic.")
    Component(Search_Integration_Component, "Search Integration Component", "NestJS module", "NestJS module interfacing with Elasticsearch or OpenSearch.")
    Component(Integration_Facade_Component, "Integration Facade Component", "NestJS module", "NestJS module managing outbound calls to payment, DRM, and notification services.")
    Component(Event_Emitter_Module, "Event Emitter Module", "NestJS module", "Internal NestJS asynchronous event dispatcher for transaction decoupling.")
}

Component(Relational_Database, "Relational Database", "PostgreSQL", "Persistent transactional storage with SSL/TLS encryption.")
Component(Search_Engine, "Search Engine", "Elasticsearch or OpenSearch", "Used for catalog queries.")
Component(Async_Worker, "Async Worker", "Python/Celery and Redis", "Background task processing.")
Component(External_Payment_Gateway, "External Payment Gateway", "HTTPS/REST", "Processes fines.")
Component(DRM_Provider, "DRM Provider", "HTTPS/REST", "Fetches digital assets.")
Component(Notification_Service, "Notification Service", "HTTPS/REST", "Sends automated alerts.")

Rel(API_Gateway, Core_Services_API, "Routes requests", "gRPC with mTLS")
Rel(Core_Services_API, Relational_Database, "Reads and writes transactional data", "TCP / PostgreSQL protocol")
Rel(Core_Services_API, Search_Engine, "Performs catalog queries", "HTTP/REST")
Rel(Core_Services_API, Async_Worker, "Queues background tasks", "Redis")
Rel(Core_Services_API, External_Payment_Gateway, "Processes fines", "HTTPS/REST")
Rel(Core_Services_API, DRM_Provider, "Fetches digital assets", "HTTPS/REST")
Rel(Core_Services_API, Notification_Service, "Sends automated alerts", "HTTPS/REST")

@enduml