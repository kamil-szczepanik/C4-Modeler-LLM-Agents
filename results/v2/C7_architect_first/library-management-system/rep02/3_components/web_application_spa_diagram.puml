@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application (SPA) container

Container_Boundary(web_app_spa, "Web Application (SPA)") {
    Component(router_and_state_management, "Router & State Management", "React Router and Zustand", "Manages routing, global application state, and volatile in-memory JWT tokens to mitigate XSS vulnerabilities.")
    Component(authentication_module, "Authentication Module", "OpenID Connect/OAuth2 client", "Handles user authentication and attaches volatile JWT headers to API requests.")
    Component(catalog_and_search_ui, "Catalog & Search UI", "React components", "Provides interfaces for querying search indices and managing item catalogues.")
    Component(self_service_and_circulation_ui, "Self-Service & Circulation UI", "React components", "Provides self-service portals and circulation interfaces for library patrons and staff.")
    Component(api_client, "API Client", "Axios/Fetch API", "Communicates with external backend services and sends HTTPS/JSON requests to the API Gateway.")
    Component(offline_sync_and_optimistic_cache_layer, "Offline Sync & Optimistic Cache Layer", "IndexedDB repository pattern, Web Crypto API", "Persists transient actions for offline circulation resilience and encrypts transient patron borrowing data at rest.")
    Component(accessibility_and_localization_core, "Accessibility & Localization Core", "React-Intl and ARIA-compliant primitives", "Ensures accessibility compliance and multi-language support across the UI.")
}

System_Ext(api_gateway, "API Gateway", "API Gateway external system")

Rel(catalog_and_search_ui, api_client, "Queries search indices", "HTTPS / JSON")
Rel(self_service_and_circulation_ui, offline_sync_and_optimistic_cache_layer, "Persists transient actions", "IndexedDB")
Rel(authentication_module, api_client, "Attaches volatile JWT headers", "HTTPS")
Rel(api_client, api_gateway, "Sends requests", "HTTPS / JSON")

@enduml