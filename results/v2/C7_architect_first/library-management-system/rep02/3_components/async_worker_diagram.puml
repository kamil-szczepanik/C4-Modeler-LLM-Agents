@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Async Worker container

Container_Boundary(async_worker, "Async Worker") {
    Component(TaskConsumerRouter, "Task Consumer / Router", "Python/Celery", "Manages background processing, routing tasks, and ensuring asynchronous reliability.")
    Component(NotificationDispatcher, "Notification Dispatcher", "Python", "Dispatches alerts and notifications to external services.")
    Component(IndexSynchronizer, "Index Synchronizer", "Python", "Synchronizes and updates the search index using the outbox pattern.")
    Component(IntegrationSyncEngine, "Integration Sync Engine", "Python", "Manages third-party integrations, updates transaction/sync states, and fetches secure API keys.")
    Component(Redis, "Redis", "Message Broker / Cluster with AOF+RDB, TLS", "Acts as message broker for background task processing and queue management.")
    Component(RelationalDatabase, "Relational Database", "PostgreSQL with PgBouncer", "Stores transaction and sync states, utilizing connection pooling.")
    Component(SearchEngine, "Search Engine", "OpenSearch", "Provides search capabilities meeting sub-800ms search SLA.")
}

Component_Ext(CoreServicesAPI, "Core Services API", "API Service", "Enqueues jobs into the task consumer.")
Component_Ext(ExternalNotificationService, "External Notification Service", "HTTPS/REST", "External service for sending alerts and notifications.")
Component_Ext(DigitalContentProviderDRM, "Digital Content Provider / DRM", "Third-party Integration", "External digital content and DRM provider.")
Component_Ext(ExternalPaymentGateway, "External Payment Gateway", "Third-party Integration", "External payment gateway service.")
Component_Ext(HashiCorpVault, "HashiCorp Vault", "HTTPS/REST", "Provides secure storage for API keys and secrets.")

Rel(CoreServicesAPI, TaskConsumerRouter, "Enqueues jobs", "Redis, AMQP, TLS, mTLS")
Rel(NotificationDispatcher, ExternalNotificationService, "Sends alerts", "HTTPS/REST")
Rel(IndexSynchronizer, SearchEngine, "Updates search index", "HTTP/REST")
Rel(IntegrationSyncEngine, RelationalDatabase, "Updates transaction/sync states", "SQL/PostgreSQL, connection pooling")
Rel(IntegrationSyncEngine, HashiCorpVault, "Fetches API keys securely", "HTTPS/REST")

@enduml