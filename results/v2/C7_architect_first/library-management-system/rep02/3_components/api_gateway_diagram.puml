@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(web_application_spa, "Web Application (SPA)", "React/TypeScript frontend served via CDN", "Used by patrons, staff, and administrators.")

System_Boundary(api_gateway, "API Gateway") {
    Component(routing_upstream_component, "Routing & Upstream Component", "Kong Proxy (Lua/Nginx core)", "Handling reverse proxying, load balancing, circuit breaking, and fallback responses.")
    Component(authentication_authorization_component, "Authentication & Authorization Component", "Kong OIDC / JWT Plugin", "Enforcing edge validation of JSON Web Tokens.")
    Component(rate_limiting_security_component, "Rate Limiting & Security Component", "Kong plugins", "Enforcing role-aware throttling and WAF payload inspection.")
    Component(telemetry_emission_component, "Telemetry Emission Component", "OpenTelemetry and Prometheus plugin", "Capturing metrics and scrubbing PII for EU compliance.")
}

System_Ext(core_services_api, "Core Services API", "Node.js/NestJS", "Downstream services receiving proxied gRPC traffic.")
System_Ext(analytics_event_collector, "Analytics Event Collector", "HTTP / TLS 1.3", "Receives streamed logs and metrics.")

Rel(web_application_spa, authentication_authorization_component, "Sends requests", "HTTPS / JSON")
Rel(authentication_authorization_component, rate_limiting_security_component, "Passes enriched context", "Internal Lua context")
Rel(rate_limiting_security_component, routing_upstream_component, "Forwards sanitized requests")
Rel(routing_upstream_component, core_services_api, "Proxies payload", "gRPC / mTLS 1.3")
Rel(telemetry_emission_component, analytics_event_collector, "Streams logs and metrics", "HTTP / TLS 1.3")

@enduml