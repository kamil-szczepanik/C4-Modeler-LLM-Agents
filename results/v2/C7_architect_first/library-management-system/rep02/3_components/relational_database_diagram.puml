@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(relational_database, "Relational Database") {
    Component(PgBouncer, "PgBouncer", "PgBouncer", "Connection pooling subsystem for internal connection routing, throttling, and protecting PostgreSQL under peak loads.")
    Component(PostgreSQL, "PostgreSQL", "PostgreSQL with pg_trgm, pgaudit, TDE, and AES-256", "Primary EU-hosted relational storage engine with transparent data encryption, column-level PII encryption, and DDL/DML auditing.")
    Component(Patroni, "Patroni", "Patroni", "High availability manager providing automated failover and multi-AZ deployment for zero-downtime maintenance.")
    Component(postgres_exporter, "postgres_exporter", "postgres_exporter", "Telemetry exporter capturing metrics and slow queries for Prometheus.")
}

Rel(PgBouncer, PostgreSQL, "Internal connection routing and throttling", "")
Rel(Patroni, PostgreSQL, "Manages high availability and automated failover", "")
@enduml