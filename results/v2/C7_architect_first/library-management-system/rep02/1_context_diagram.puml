@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Library_Patron, "Library Patron", "A library user who accesses self-service portals to search and borrow items.")
Person(Librarian___Staff, "Librarian / Staff", "Staff members who manage the catalogue and circulation.")
Person(Library_Administrator, "Library Administrator", "Administrators who access reporting dashboards and manage system access.")

System(Library_Management_System, "Library Management System", "A cloud-native solution designed for public and academic libraries to catalogue physical and digital items, manage circulation, and provide self-service portals, enforcing strict EU-only data residency and high-performance search capabilities.")

System_Ext(External_Payment_Gateway, "External Payment Gateway", "External system used to process fines and fees.")
System_Ext(Digital_Content_Provider___DRM, "Digital Content Provider / DRM", "External provider used to fetch digital assets.")
System_Ext(External_Notification_Service, "External Notification Service", "External service used to send automated alerts.")

Rel(Library_Patron, Library_Management_System, "Uses self-service portals", "HTTPS/REST, OpenID Connect")
Rel(Librarian___Staff, Library_Management_System, "Manages catalogue and circulation", "HTTPS/REST with MFA")
Rel(Library_Administrator, Library_Management_System, "Accesses reporting dashboards", "HTTPS/REST with strict RBAC/MFA")
Rel(Library_Management_System, External_Payment_Gateway, "Processes fines and fees", "REST over TLS 1.3")
Rel(Library_Management_System, Digital_Content_Provider___DRM, "Fetches digital assets", "Asynchronous queuing and REST over TLS 1.3")
Rel(Library_Management_System, External_Notification_Service, "Sends automated alerts", "REST over TLS 1.3")
@enduml