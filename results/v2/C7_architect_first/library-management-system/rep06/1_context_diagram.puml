@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(LibraryPatrons, "Library Patrons", "End-users accessing public catalogs and self-service portals.")
Person(LibraryStaff, "Library Staff", "Administrative users managing cataloging and circulation.")
System(LibraryManagementSystem, "Library Management System", "Core software system handling business logic, cataloging, circulation, and high-performance search capabilities for public and academic libraries within EU infrastructure.")
System_Ext(ExternalPaymentGateway, "External Payment Gateway", "Third-party system for processing fines and fees.")
System_Ext(DigitalContentRepositories, "Digital Content Repositories", "External systems for streaming and downloading digital items.")

Rel(LibraryPatrons, LibraryManagementSystem, "Accesses public catalogs and self-service portals", "HTTPS/TLS 1.3")
Rel(LibraryStaff, LibraryManagementSystem, "Manages cataloging and circulation", "HTTPS/TLS 1.3")
Rel(LibraryManagementSystem, ExternalPaymentGateway, "Processes financial transactions for fines and fees", "mTLS over HTTPS")
Rel(LibraryManagementSystem, DigitalContentRepositories, "Handles digital item streaming and downloads", "mTLS over HTTPS with OIDC SSO")
@enduml