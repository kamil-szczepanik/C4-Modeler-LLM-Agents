@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application container

Container_Boundary(web_application, "Web Application") {
    Component(Client-Side SPA, "Client-Side SPA", "React, TypeScript", "Renders the user interface for public catalogs, self-service portals, and staff cataloging/circulation management.")
    Component(Nginx Reverse Proxy, "Nginx Reverse Proxy", "Nginx", "Handles static asset hosting, secure reverse proxy/BFF pattern, and session management using HttpOnly cookies.")
}

Rel(Client-Side SPA, Nginx Reverse Proxy, "Routes API requests and serves static assets", "HTTPS")

@enduml