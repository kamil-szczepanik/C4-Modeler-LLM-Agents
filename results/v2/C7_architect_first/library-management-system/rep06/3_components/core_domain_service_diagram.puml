@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Domain Service container

System_Ext(api_gateway, "API Gateway", "External entry point that forwards requests via gRPC with mTLS.")
System_Ext(postgresql_database, "PostgreSQL Database", "Stores operational transactional state and isolated, immutable audit logs.")
System_Ext(rabbitmq_message_broker, "RabbitMQ Message Broker", "Handles asynchronous domain event dispatching with circuit breakers and dead-letter queues.")

Container_Boundary(core_domain_service, "Core Domain Service") {
    Component(security_interceptor_component, "Security Interceptor Component", "Spring Security / gRPC Interceptor", "Authorizes validated gRPC calls and validates method-level OAuth2/JWT scopes for roles.")
    Component(circulation_manager_component, "Circulation Manager Component", "Spring Bean/Service", "Handles circulation management, loan policies, and business logic.")
    Component(catalogue_manager_component, "Catalogue Manager Component", "Spring Bean/Service", "Handles item cataloguing and related inventory operations.")
    Component(audit_logger_component, "Audit Logger Component", "Spring Bean/Data JPA", "Provides EU-compliant audit logging and writes to a restricted, append-only schema.")
    Component(event_publisher_component, "Event Publisher Component", "Spring Cloud Stream / RabbitMQ Template", "Publishes domain events like ItemCheckedOut asynchronously.")
}

Rel(api_gateway, security_interceptor_component, "Forwards requests", "gRPC with mTLS")
Rel(security_interceptor_component, circulation_manager_component, "Authorizes validated gRPC calls")
Rel(security_interceptor_component, catalogue_manager_component, "Authorizes validated gRPC calls")
Rel(circulation_manager_component, postgresql_database, "Persists transactional state", "JDBC over TLS 1.3")
Rel(catalogue_manager_component, postgresql_database, "Persists transactional state", "JDBC over TLS 1.3")
Rel(audit_logger_component, postgresql_database, "Writes to a restricted, append-only schema", "JDBC over TLS 1.3")
Rel(event_publisher_component, rabbitmq_message_broker, "Publishes domain events like ItemCheckedOut", "AMQP 0-9-1 over TLS 1.3")

@enduml