@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(postgresql_database, "PostgreSQL Database") {
    Component(PostgreSQL_Storage, "PostgreSQL Storage", "PostgreSQL", "Relational database engine managing ACID transactions")
    Component(PgBouncer, "PgBouncer", "PgBouncer", "Connection pooler preventing resource exhaustion")
    Component(Patroni_with_etcd, "Patroni with etcd", "Patroni, etcd", "Consensus-based automated failover manager")
    Component(Read_Only_Replica_Router, "Read-Only Replica Router", "Routing Layer", "Logical routing layer for administrative traffic")
    Component(PostgreSQL_Read_Replica, "PostgreSQL Read Replica", "PostgreSQL", "Asynchronous replica for reporting workloads")
    Component(Prometheus_Exporter, "Prometheus Exporter", "Prometheus", "Metrics sidecar for operational observability")
    Component(pgaudit, "pgaudit", "pgaudit extension", "Audit logging extension for compliance monitoring")
    Component(Volume_Mount, "Volume Mount", "LUKS/AES-256", "Encrypted persistence storage")
}

Rel(PgBouncer, PostgreSQL_Storage, "SQL queries", "TCP/IP over mTLS 1.3")
Rel(Read_Only_Replica_Router, PostgreSQL_Read_Replica, "SQL queries", "TCP/IP over mTLS 1.3")
Rel(PostgreSQL_Storage, Volume_Mount, "Encrypted persistence", "LUKS/AES-256")
@enduml