@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(web_application, "Web Application", "External client application")
System_Ext(core_domain_service, "Core Domain Service", "Downstream core domain service")
System_Ext(search_service, "Search Service", "Downstream search service")
System_Ext(telemetry_exporter, "Telemetry Exporter", "Observability platform for metrics and traces")

Container_Boundary(api_gateway, "API Gateway") {
    Component(routing_engine, "Routing Engine (Kong Proxy)", "Kong API Gateway, DB-less Kubernetes Mode", "Handles API versioning, priority routing for Library Staff, and downstream traffic direction.")
    Component(auth_filter, "Authentication Filter", "Kong OIDC Plugin, Local JWT/OIDC", "Performs local JWT/OIDC token validation at the edge.")
    Component(rate_limiting, "Rate Limiting & Circuit Breaker", "Kong Plugin Ecosystem", "Protects downstream services and enforces throttling on search/auth endpoints.")
    Component(security_telemetry, "Security & Telemetry Enforcers", "OpenTelemetry, Prometheus", "Injects security headers, sanitizes inputs, and emits OpenTelemetry/Prometheus metrics.")
}

Rel(web_application, routing_engine, "Forwards versioned client requests", "HTTPS/REST using TLS 1.3")
Rel(routing_engine, core_domain_service, "Proxies validated traffic", "gRPC with mTLS")
Rel(routing_engine, search_service, "Proxies validated traffic", "gRPC with mTLS")
Rel(routing_engine, telemetry_exporter, "Emits distributed traces and Prometheus metrics", "Internal")

@enduml