@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(notification_service, "Notification Service") {
    Component(amqp_consumer, "AMQP Consumer Component", "Node.js, amqplib", "Consumes event messages from the message broker.")
    Component(notification_router, "Notification Router Component", "Node.js", "Routes notification payloads and orchestrates the delivery workflow.")
    Component(template_engine, "Template Engine Component", "Nunjucks", "Renders localized templates for alerts.")
    Component(provider_adapters, "Provider Integration Adapters", "Node.js, Axios, SendGrid, Twilio", "Sends payloads to external communication providers.")
    Component(outbox_repository, "Outbox Repository Component", "Node.js, TypeORM, PostgreSQL", "Persists delivery status and outbox audit logs.")
    Component(preference_cache, "Preference Cache Component", "Node.js, ioredis, Redis", "Provides low-latency lookups for patron preferences.")
}

System_Ext(rabbitmq, "RabbitMQ Message Broker", "Message broker with manual acknowledgments and dead-letter exchanges.")

Rel(amqp_consumer, rabbitmq, "Consumes event messages", "AMQP 0-9-1 with TLS 1.3")
Rel(notification_router, preference_cache, "Queries patron preferences", "In-Memory/TCP")
Rel(notification_router, template_engine, "Renders localized templates", "Internal Call")
Rel(notification_router, provider_adapters, "Sends payload", "HTTPS")
Rel(provider_adapters, outbox_repository, "Persists delivery status", "SQL/TCP")

@enduml