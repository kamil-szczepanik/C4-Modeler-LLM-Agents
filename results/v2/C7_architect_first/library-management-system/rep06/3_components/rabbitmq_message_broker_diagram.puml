@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the RabbitMQ Message Broker container

Container(CoreDomainService, "Core Domain Service", "Microservice", "Core business domain service interacting with the message broker.")
Container(NotificationService, "Notification Service", "Microservice", "Service responsible for dispatching notifications.")
System_Ext(MonitoringStack, "Monitoring Stack", "Centralized observability and metrics collection platform.")

Container_Boundary(RabbitMQMessageBroker, "RabbitMQ Message Broker") {
    Component(ExchangeRouterComponent, "Exchange Router Component", "RabbitMQ Exchange", "Routes incoming messages to appropriate queues based on routing keys and bindings.")
    Component(QuorumQueueComponent, "Quorum Queue Component", "Quorum Queues (Raft-consensus)", "Provides zero-loss messaging and robust storage backed by Raft consensus.")
    Component(ConnectionManagerComponent, "Connection Manager Component", "AMQP 0-9-1 with TLS 1.3 & mTLS", "Handles secure client connections and authentication under strict EU data residency constraints.")
    Component(ManagementAPIUIComponent, "Management API/UI Component", "HTTP/S over Port 15672", "Exposes management interfaces and exports operational metrics.")
    Component(DeadLetterRouterComponent, "Dead Letter Router Component", "RabbitMQ DLX", "Routes undeliverable or failed messages for error handling and analysis.")
    Component(PolicyEnforcementComponent, "Policy Enforcement Component", "RabbitMQ Policies", "Enforces security controls, resource guardrails, and priority handling.")
}

Rel(CoreDomainService, ConnectionManagerComponent, "AMQP 0-9-1 with TLS 1.3")
Rel(NotificationService, ConnectionManagerComponent, "AMQP 0-9-1 with TLS 1.3")
Rel(QuorumQueueComponent, DeadLetterRouterComponent, "AMQP 0-9-1")
Rel(ManagementAPIUIComponent, MonitoringStack, "HTTP/S over Port 15672")

@enduml