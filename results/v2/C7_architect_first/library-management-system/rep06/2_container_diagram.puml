@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(LibraryPatrons, "Library Patrons", "End-users accessing public catalogs and self-service portals.")
Person(LibraryStaff, "Library Staff", "Administrative users managing cataloging and circulation.")
System_Ext(ExternalPaymentGateway, "External Payment Gateway", "External system for processing fines and fees.")
System_Ext(DigitalContentRepositories, "Digital Content Repositories", "External systems for digital content and assets.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(WebApp, "Web Application", "React/TypeScript, Nginx", "Client-side rendering and static asset hosting.")
    Container(ApiGateway, "API Gateway", "Kong or Spring Cloud Gateway", "API routing, rate limiting, and OAuth2/OIDC token validation.")
    Container(CoreDomainService, "Core Domain Service", "Java/Spring Boot", "Core business logic, circulation management, and immutable audit logging.")
    Container(SearchService, "Search Service", "Python/FastAPI, Elasticsearch", "High-performance search to meet the <800ms P99 requirement.")
    Container(NotificationService, "Notification Service", "Node.js", "Asynchronous messaging and zero-loss notifications.")
    ContainerDb(PostgreSQLDatabase, "PostgreSQL Database", "PostgreSQL", "Relational operational data store with primary-replica streaming.")
    Container(RabbitMQMessageBroker, "RabbitMQ Message Broker", "RabbitMQ", "Asynchronous messaging with quorum queues for zero-loss notifications.")
}

Rel(LibraryPatrons, WebApp, "Accesses public catalogs and self-service portals", "HTTPS")
Rel(LibraryStaff, WebApp, "Manages cataloging and circulation", "HTTPS")
Rel(WebApp, ApiGateway, "Routes API requests", "HTTPS/REST")
Rel(ApiGateway, CoreDomainService, "Forwards core business requests", "gRPC with mTLS")
Rel(ApiGateway, SearchService, "Forwards search queries", "gRPC with mTLS")
Rel(CoreDomainService, PostgreSQLDatabase, "Persists operational data", "TLS 1.3")
Rel(NotificationService, RabbitMQMessageBroker, "Publishes and consumes asynchronous messages", "AMQP with TLS 1.3")
Rel(ExternalPaymentGateway, ApiGateway, "Integrates with external payment and financial workflows", "HTTPS")
Rel(DigitalContentRepositories, ApiGateway, "Integrates with digital asset storage", "HTTPS")

@enduml