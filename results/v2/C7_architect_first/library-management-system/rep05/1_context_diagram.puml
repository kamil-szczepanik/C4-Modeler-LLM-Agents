@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Library Management System

Person(LibraryPatron, "Library Patron", "End user who borrows physical and digital items and uses self-service portals.")
Person(AcademicResearcher, "Academic Researcher", "User who searches and accesses academic resources and catalogues.")
Person(LibrarianAdministrator, "Librarian / Administrator", "Staff member managing daily circulation, catalogue items, and administrative tasks.")
Person(LibraryManager, "Library Manager", "Management user overseeing library operations, analytics, and system configurations.")

System(LibraryManagementSystem, "Library Management System", "A multi-tenant cloud SaaS platform designed to catalogue physical and digital items, manage circulation, and provide self-service portals for academic and public libraries with strict EU data residency.")

System_Ext(EUCompliantPaymentGateway, "EU-Compliant Payment Gateway", "External payment processor handling tokenized payments securely.")
System_Ext(ThirdPartyNotificationService, "Third-Party Notification Service", "External service used for sending due-date alerts and notifications.")
System_Ext(ExternalIdentityProvidersIdP, "External Identity Provider (IdP)", "External provider handling user authentication and role/attribute mapping.")

Rel(LibraryPatron, LibraryManagementSystem, "Accesses web portals for circulation and self-service", "HTTPS (TLS 1.3), OAuth 2.0 / OIDC, MFA")
Rel(AcademicResearcher, LibraryManagementSystem, "Searches and accesses academic catalogues", "HTTPS (TLS 1.3), OAuth 2.0 / OIDC")
Rel(LibrarianAdministrator, LibraryManagementSystem, "Manages cataloging, circulation, and admin dashboards", "HTTPS (TLS 1.3), OAuth 2.0 / OIDC, MFA")
Rel(LibraryManager, LibraryManagementSystem, "Accesses management reports and administration", "HTTPS (TLS 1.3), OAuth 2.0 / OIDC, MFA")
Rel(LibraryManagementSystem, EUCompliantPaymentGateway, "Processes tokenized payments and webhook verification", "REST over mTLS")
Rel(LibraryManagementSystem, ThirdPartyNotificationService, "Sends due-date alerts and notifications", "REST API over HTTPS with circuit-breaker")
Rel(LibraryManagementSystem, ExternalIdentityProvidersIdP, "Authenticates users and maps RBAC/ABAC permissions", "OIDC / OAuth 2.0")

@enduml