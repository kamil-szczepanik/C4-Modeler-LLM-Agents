@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Catalog Service container

System_Ext(api_gateway_circulation_service, "API Gateway / Circulation Service", "Istio service mesh, mTLS", "External callers routing gRPC requests over Istio service mesh using mTLS.")
System_Ext(postgresql_database, "PostgreSQL Database", "PostgreSQL, RLS, AES-256", "Primary-replica relational database with EU data residency, Row-Level Security, and encryption-at-rest.")
System_Ext(rabbitmq, "RabbitMQ", "RabbitMQ, mTLS, DLX", "Message broker secured with mTLS and dead-letter exchanges for asynchronous search synchronization.")

Container_Boundary(core_catalog_service, "Core Catalog Service") {
    Component(catalogcontroller, "CatalogController", "Spring MVC/REST adapter, gRPC, SPIFFE/SPIRE", "Exposes gRPC endpoints with SPIFFE/SPIRE SVID authentication.")
    Component(catalogservice, "CatalogService", "Java / Spring Boot, MARC21/Dublin Core", "Domain component containing metadata validation, dynamic schema adapters, and facet generation.")
    Component(catalogrepository, "CatalogRepository", "Spring Data JPA, Hibernate, HikariCP, PostgreSQL JDBC", "Data access component with connection pooling and PostgreSQL JDBC drivers.")
    Component(outbox_poller, "Outbox Poller", "Java / Asynchronous Event Drainer", "Asynchronous event drainer implementing the transactional outbox pattern.")
    Component(searchsyncpublisher, "SearchSyncPublisher", "HMAC-SHA256, Event Emitter", "Event emitter generating cryptographically signed outbox messages.")
}

Rel(api_gateway_circulation_service, catalogcontroller, "Routes gRPC requests over Istio service mesh using mTLS.", "gRPC / Istio")
Rel(catalogcontroller, catalogservice, "Direct in-process method invocation.", "")
Rel(catalogservice, catalogrepository, "Spring Data JPA / JDBC calls with Hibernate Envers auditing.", "Spring Data JPA")
Rel(catalogrepository, postgresql_database, "TLS 1.3 encrypted JDBC queries, utilizing JSONB columns for flexible metadata.", "JDBC / TLS 1.3")
Rel(outbox_poller, rabbitmq, "Publishes HMAC-SHA256 signed transactional outbox events for downstream search indexing.", "AMQP / mTLS")
@enduml