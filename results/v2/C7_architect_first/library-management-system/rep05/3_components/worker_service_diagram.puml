@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Worker Service container

System_Ext(API_Gateway, "API Gateway", "External API Gateway")

Container_Boundary(worker_service, "Worker Service") {
    Component(Task_Dispatcher, "Task Dispatcher", "Python, Celery", "Handles background tasks, asynchronous operations, and worker management.")
    Component(Payment_Processor_Component, "Payment Processor Component", "Python", "Processes financial transactions securely via the EU-Compliant Payment Gateway.")
    Component(Notification_Dispatcher, "Notification Dispatcher", "Python", "Sends notifications and alerts through the Third-Party Notification Service.")
    Component(Data_Sync_Component, "Data Sync Component", "Python", "Handles indexing updates for the Circulation & Search Service.")
    Component(Scheduled_Task_Scheduler_Component, "Scheduled Task Scheduler Component", "Python, Celery Beat", "Drives scheduled batch workflows and periodic task scheduling.")
    Component(Transient_Job_State_Store, "Transient Job State Store", "Redis", "Transient job state store for idempotency deduplication keys with replication and AOF persistence.")
    Component(RabbitMQ_Message_Broker, "RabbitMQ Message Broker", "RabbitMQ", "Message broker with Dead Letter Queues (DLQ) for reliable task routing.")
}

System_Ext(EU_Compliant_Payment_Gateway, "EU-Compliant Payment Gateway", "External Service", "Processes financial transactions securely.")
System_Ext(Third_Party_Notification_Service, "Third-Party Notification Service", "External Service", "Sends notifications and alerts.")
System_Ext(Circulation_Search_Service, "Circulation & Search Service", "Elasticsearch", "External search and circulation service handling indexing updates.")

Rel(API_Gateway, Task_Dispatcher, "Triggers asynchronous background tasks", "gRPC over Istio service mesh with mTLS")
Rel(Scheduled_Task_Scheduler_Component, Task_Dispatcher, "Triggers periodic background jobs", "Internal function call")
Rel(Task_Dispatcher, RabbitMQ_Message_Broker, "Consumes and routes background jobs", "AMQP with TLS 1.3, SCRAM-SHA-512")
Rel(Task_Dispatcher, Transient_Job_State_Store, "Checks and sets idempotency deduplication keys", "Redis Protocol over TLS")
Rel(Payment_Processor_Component, EU_Compliant_Payment_Gateway, "Processes financial transactions securely", "HTTPS")
Rel(Notification_Dispatcher, Third_Party_Notification_Service, "Sends notifications and alerts", "HTTPS")
Rel(Data_Sync_Component, Circulation_Search_Service, "Handles indexing updates", "REST/gRPC")

@enduml