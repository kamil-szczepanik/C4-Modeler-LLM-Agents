@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Frontend container

System_Ext(ExternalIdP, "External IdP", "External Identity Provider")
System_Ext(APIGateway, "API Gateway", "API Gateway")

Container_Boundary(WebFrontend, "Web Frontend") {
    Component(AuthenticationManager, "Authentication Manager", "React, TypeScript, OIDC Client", "Handles login and session tokens via OIDC Client interacting with the External IdP.")
    Component(CatalogueSearchUI, "Catalogue & Search UI", "React, TypeScript, TanStack Query, Chart.js", "Provides interfaces for cataloguing items, searching, and viewing analytics while ensuring sub-800ms search responses.")
    Component(CirculationSelfServicePortal, "Circulation & Self-Service Portal", "React, TypeScript, TanStack Query", "Allows library patrons and researchers to manage circulation and self-service activities.")
    Component(AdminDashboard, "Admin Dashboard", "React, TypeScript, Chart.js", "Enables librarians and administrators to manage system configurations and administrative tasks.")
    Component(StateSessionStore, "State & Session Store", "Zustand", "Manages in-memory state management and user session data on the client side.")
    Component(APIClient, "API Client", "TypeScript, HTTPS/REST, WebSockets", "Sends API requests to the API Gateway via HTTPS/REST and WebSockets.")
}

Rel(AuthenticationManager, ExternalIdP, "Handles login and session tokens via OIDC Client", "OIDC")
Rel(APIClient, APIGateway, "Sends API requests via HTTPS/REST and WebSockets", "HTTPS/REST, WebSockets")
Rel(CatalogueSearchUI, StateSessionStore, "Reads and writes UI state", "In-memory")
Rel(CirculationSelfServicePortal, StateSessionStore, "Reads and writes session state", "In-memory")
Rel(AdminDashboard, StateSessionStore, "Reads and writes admin state", "In-memory")

@enduml