@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

System_Ext(ExternalIdP, "External Identity Provider (IdP)", "External Identity Provider")
System_Ext(CoreCatalogService, "Core Catalog Service", "Core Catalog Service")
System_Ext(CirculationSearchService, "Circulation & Search Service", "Circulation & Search Service")
System_Ext(WorkerService, "Worker Service", "Worker Service")

Container_Boundary(api_gateway, "API Gateway") {
    Component(Auth, "Authentication & Authorization", "Kong / Spring Cloud Gateway Plugins", "Validates OAuth2/OIDC JWT tokens against the External Identity Provider and enforces access control.")
    Component(Routing, "Routing & Load Balancing", "Kong / Spring Cloud Gateway", "Routes incoming requests from the Web Frontend to the appropriate backend microservices.")
    Component(RateLimiting, "Rate Limiting & Throttling", "Redis backed Kong Plugin", "Provides tiered rate-limiting and throttling to ensure system stability and fair usage.")
    Component(Telemetry, "Telemetry & Logging", "Kong Observability Plugins", "Collects metrics, logs, and trace data for monitoring API operations.")
    Component(Transformation, "Request Transformation", "Kong Plugin", "Modifies incoming and outgoing request/response headers and payloads as required.")
    Component(CircuitBreaker, "Circuit Breaker & Fallback", "Kong Resilience Plugins", "Detects failures and provides fallback mechanisms to ensure reliability when backend services are degraded.")
}

Rel(Auth, ExternalIdP, "OAuth2/OIDC JWT validation", "")
Rel(Routing, CoreCatalogService, "gRPC over Istio service mesh (mTLS)", "")
Rel(Routing, CirculationSearchService, "gRPC over Istio service mesh (mTLS)", "")
Rel(Routing, WorkerService, "gRPC over Istio service mesh (mTLS)", "")

@enduml