@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(circulation_and_search_service, "Circulation & Search Service") {
    Component(Search_API_Handler, "Search API Handler", "FastAPI", "Managing queries, fuzzy matching, and input sanitization.")
    Component(Circulation_Engine, "Circulation Engine", "FastAPI", "Handling checkout, hold, and return workflows with RBAC.")
    Component(Circulation_State_Manager, "Circulation State Manager", "FastAPI", "Managing loan transactions and state.")
    Component(Catalog_Indexer_Worker, "Catalog Indexer Worker", "Python async consumer", "Keeping indices synchronized.")
    Component(Search_Analytics_Adapter, "Search Analytics Adapter", "FastAPI", "Collecting anonymized query metrics.")
    Component(Elasticsearch, "Elasticsearch", "Elasticsearch", "Datastore enforcing AES-256 encryption at rest and localized EU volumes.")
    Component(RabbitMQ, "RabbitMQ", "RabbitMQ", "Message broker managing asynchronous event updates.")
}

Component(Core_Catalog_Service, "Core Catalog Service", "External Service", "Queries operational data via gRPC over Istio service mesh.")

Rel(Search_API_Handler, Elasticsearch, "Queries and indexes catalogue data", "REST/Transport over mTLS (TLS)")
Rel(RabbitMQ, Catalog_Indexer_Worker, "Consumes catalog sync events", "AMQP")
Rel(Circulation_Engine, Circulation_State_Manager, "Executes internal Python function calls", "")
Rel(Circulation_State_Manager, Core_Catalog_Service, "Queries operational data", "gRPC over Istio service mesh (mTLS)")
Rel(Search_API_Handler, Search_Analytics_Adapter, "Emits asynchronous query metrics internally", "")

@enduml