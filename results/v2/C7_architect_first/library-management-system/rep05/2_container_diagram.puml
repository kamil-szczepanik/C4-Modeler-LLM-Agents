@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(LibraryPatron, "Library Patron", "End user who borrows physical and digital items and uses self-service portals.")
Person(AcademicResearcher, "Academic Researcher", "User who searches and accesses academic resources and catalogues.")
Person(LibrarianAdministrator, "Librarian / Administrator", "Staff member managing daily circulation, catalogue items, and administrative tasks.")
Person(LibraryManager, "Library Manager", "Management user overseeing library operations, analytics, and system configurations.")

System_Ext(EUCompliantPaymentGateway, "EU-Compliant Payment Gateway", "External payment processor handling tokenized payments securely.")
System_Ext(ThirdPartyNotificationService, "Third-Party Notification Service", "External service used for sending due-date alerts and notifications.")
System_Ext(ExternalIdentityProvierIdP, "External Identity Provider (IdP)", "External provider handling user authentication and role/attribute mapping.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(WebFrontend, "Web Frontend", "React, Nginx", "Provides cataloging, circulation, and self-service portals for users.")
    Container(APIGateway, "API Gateway", "Kong, Spring Cloud Gateway", "Routes, manages, and secures incoming traffic to internal services.")
    Container(CoreCatalogService, "Core Catalog Service", "Spring Boot, PostgreSQL", "Manages catalog data and operational data storage.")
    Container(CirculationSearchService, "Circulation & Search Service", "FastAPI, Elasticsearch", "Handles search functionality and circulation processes with high performance.")
    Container(WorkerService, "Worker Service", "Celery, RabbitMQ", "Handles background tasks, asynchronous operations, and external integrations.")
}

Rel(LibraryPatron, WebFrontend, "Accesses portals for circulation and self-service", "HTTPS")
Rel(AcademicResearcher, WebFrontend, "Searches academic catalogues via web interface", "HTTPS")
Rel(LibrarianAdministrator, WebFrontend, "Manages cataloging and circulation via admin UI", "HTTPS")
Rel(LibraryManager, WebFrontend, "Accesses management reports and administration", "HTTPS")

Rel(WebFrontend, APIGateway, "Sends API requests to backend services", "HTTPS/REST")
Rel(APIGateway, CoreCatalogService, "Routes internal catalog requests", "gRPC over Istio service mesh (mTLS)")
Rel(APIGateway, CirculationSearchService, "Routes circulation and search requests", "gRPC over Istio service mesh (mTLS)")
Rel(APIGateway, WorkerService, "Triggers asynchronous background tasks", "gRPC over Istio service mesh (mTLS)")
Rel(APIGateway, ExternalIdentityProvierIdP, "Validates user tokens and identity", "OAuth2/OIDC JWT validation")

Rel(WorkerService, EUCompliantPaymentGateway, "Processes payments securely", "HTTPS")
Rel(WorkerService, ThirdPartyNotificationService, "Sends notifications and alerts", "HTTPS")
Rel(CirculationSearchService, CoreCatalogService, "Queries operational data", "gRPC over Istio service mesh (mTLS)")

@enduml