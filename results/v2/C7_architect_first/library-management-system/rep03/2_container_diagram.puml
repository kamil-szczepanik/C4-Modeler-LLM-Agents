@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(LibraryPatron, "Library Patron", "Accesses self-service portals to borrow books, search catalogues, and manage their library accounts.")
Person(LibrarianStaff, "Librarian / Staff", "Manages library circulation, cataloguing, and administrative tasks using the management system.")

System_Ext(PaymentGateway, "Payment Gateway", "External system used for processing fines, fees, and payments securely via tokenized PAN.")
System_Ext(NationalLibraryRegistry, "National Library Registry", "External system for national bibliographic data exchange and cataloguing synchronization.")
System_Ext(ThirdPartyIdPAcademicSSO, "Third-Party IdP / Academic SSO", "Provides federated authentication and multi-factor authentication compliance using SAML 2.0 / OIDC.")
System_Ext(NotificationSystem, "Notification System", "External system responsible for sending out alerts, reminders, and notifications to patrons and staff.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(WebApplicationSPA, "Web Application SPA", "React/TypeScript", "Client-side routing for patron/staff portals delivered via CDN.")
    Container(APIGateway, "API Gateway", "NGINX / Spring Cloud Gateway", "Handles routing, SSL termination, and JWT validation.")
    Container(CoreDomainService, "Core Domain Service", "Java/Spring Boot", "Manages cataloging, circulation, and business logic.")
    Container(SearchService, "Search Service", "Python/FastAPI with Elasticsearch", "Optimizes indices for sub-800ms search NFR.")
    ContainerDb(Database, "Database", "PostgreSQL", "Relational storage with EU-only data residency and column-level PII encryption.")
    Container(BackgroundWorker, "Background Worker", "Python/Celery", "Asynchronous background task processing.")
    Container(AsynchronousBroker, "Asynchronous Broker", "Redis", "Event pub/sub and task queue with AOF persistence.")
}

Rel(LibraryPatron, WebApplicationSPA, "Accesses self-service portals and search", "HTTPS/WSS")
Rel(LibrarianStaff, WebApplicationSPA, "Accesses management and circulation features", "HTTPS/WSS")
Rel(WebApplicationSPA, APIGateway, "Sends API requests with JWT validation", "HTTPS/WSS with JWT")
Rel(APIGateway, CoreDomainService, "Routes business logic requests", "gRPC over HTTP/2 with mTLS")
Rel(APIGateway, SearchService, "Routes search requests", "gRPC over HTTP/2 with mTLS")
Rel(CoreDomainService, Database, "Reads and writes relational data", "JDBC/TLS")
Rel(SearchService, Database, "Queries search index data", "JDBC/TLS")
Rel(CoreDomainService, AsynchronousBroker, "Dispatches async tasks and events", "TLS")
Rel(BackgroundWorker, AsynchronousBroker, "Consumes background tasks", "TLS")

Rel(CoreDomainService, PaymentGateway, "Processes payments and fines", "HTTPS/REST")
Rel(CoreDomainService, NationalLibraryRegistry, "Synchronizes bibliographic data", "HTTPS/REST")
Rel(CoreDomainService, ThirdPartyIdPAcademicSSO, "Authenticates users", "SAML 2.0 / OIDC over HTTPS")
Rel(CoreDomainService, NotificationSystem, "Sends alerts and notifications", "HTTPS/REST")

@enduml