@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Library_Patron, "Library Patron", "Accesses self-service portals to borrow books, search catalogues, and manage their library accounts.")
Person(Librarian_Staff, "Librarian / Staff", "Manages library circulation, cataloguing, and administrative tasks using the management system.")

System(Library_Management_System, "Library Management System", "Provides cataloguing, circulation, and self-service portals for public and academic libraries while ensuring strict EU-only data residency and high-performance search.")

System_Ext(Payment_Gateway, "Payment Gateway", "External system used for processing fines, fees, and payments securely via tokenized PAN.")
System_Ext(National_Library_Registry, "National Library Registry", "External system for national bibliographic data exchange and cataloguing synchronization.")
System_Ext(Third_Party_IdP_Academic_SSO, "Third-Party IdP / Academic SSO", "Provides federated authentication and multi-factor authentication compliance using SAML 2.0 / OIDC.")
System_Ext(Notification_System, "Notification System", "External system responsible for sending out alerts, reminders, and notifications to patrons and staff.")

System_Ext(CDN_Edge_Caching_Layer, "CDN / Edge Caching Layer", "Edge caching layer implemented to achieve high-performance search response times.")

Rel(Library_Patron, CDN_Edge_Caching_Layer, "Accesses portal and search services", "HTTPS, TLS 1.3")
Rel(Librarian_Staff, CDN_Edge_Caching_Layer, "Accesses staff and management features", "HTTPS, TLS 1.3")
Rel(CDN_Edge_Caching_Layer, Library_Management_System, "Forwards requests", "HTTPS, TLS 1.3")
Rel(Library_Management_System, Third_Party_IdP_Academic_SSO, "Authenticates users via federated identity", "SAML 2.0 / OIDC over HTTPS")
Rel(Library_Management_System, Payment_Gateway, "Processes financial transactions and fees", "HTTPS/REST, tokenized PAN")
Rel(Library_Management_System, National_Library_Registry, "Synchronizes registry and cataloguing data", "HTTPS/REST")
Rel(Library_Management_System, Notification_System, "Dispatches notifications and alerts", "HTTPS/REST")

@enduml