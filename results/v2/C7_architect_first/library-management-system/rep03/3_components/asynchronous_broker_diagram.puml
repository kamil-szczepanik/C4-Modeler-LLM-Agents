@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(asynchronous_broker, "Asynchronous Broker") {
    Component(Event_Publisher, "Event Publisher", "Redis Pub/Sub", "Publishes domain events using TCP/RESP3 and mTLS.")
    Component(Task_Queue_Manager, "Task Queue Manager", "Redis Streams / Lists", "Enqueues background tasks with encrypted PII payloads and manages stream acknowledgments.")
    Component(Dead_Letter_Queue, "Dead-Letter Queue", "Redis List / Stream", "Routes unprocessable poison-pill messages.")
}

Rel(Event_Publisher, Task_Queue_Manager, "Publishes domain events and coordinates message flow", "TCP/RESP3, mTLS")
Rel(Task_Queue_Manager, Dead_Letter_Queue, "Routes unprocessable poison-pill messages", "TCP/RESP3, mTLS")

@enduml