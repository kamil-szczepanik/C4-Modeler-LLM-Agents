@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(search_service, "Search Service") {
    Component(API_Controller, "API Controller", "FastAPI routing and request validation handler", "FastAPI routing and request validation handler for incoming client traffic.")
    Component(Query_Builder, "Query Builder", "Python / FastAPI", "Handles fuzzy matching, synonyms, and facets.")
    Component(Access_Control_Filter, "Access Control Filter", "Python / FastAPI", "Enforces pre-query role-based filtering.")
    Component(Elasticsearch_Client, "Elasticsearch Client", "elasticsearch-py async client", "Executes asynchronous search queries against Elasticsearch.")
    Component(Index_Sync_Listener, "Index Sync Listener", "Background consumer / Python", "Background consumer keeping indices synchronized via Redis.")
}

Rel(API_Controller, Query_Builder, "Routes validated search requests to", "")
Rel(Query_Builder, Access_Control_Filter, "Applies access control rules to", "")
Rel(Access_Control_Filter, Elasticsearch_Client, "Sends secure query parameters to", "")
Rel(Index_Sync_Listener, Elasticsearch_Client, "Synchronizes index updates to", "")

@enduml