@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "API Gateway")
System_Ext(eu_api_gateway, "EU-hosted API Gateway", "EU-hosted API Gateway")
System_Ext(idp, "Third-Party IdP / Academic SSO", "Third-Party IdP / Academic SSO")

Container_Boundary(web_application_spa, "Web Application SPA") {
    Component(routing_state_management_component, "Routing & State Management Component", "React Router & Zustand", "Manages navigation, roles, and in-memory state.")
    Component(api_client_component, "API Client Component", "Axios/Fetch with interceptors", "Handles communication with the Gateway.")
    Component(search_catalog_ui_component, "Search & Catalog UI Component", "Reactive UI (React/TypeScript)", "Reactive UI supporting WCAG 2.1 AA accessibility and <800ms search NFR.")
    Component(authentication_session_component, "Authentication & Session Component", "OIDC Client", "Handles authentication using Authorization Code Flow with PKCE.")
    Component(accessibility_localization_provider, "Accessibility & Localization Provider", "Cross-cutting context", "Cross-cutting context for i18n and screen-reader compliance.")
    Component(telemetry_resilience_middleware, "Telemetry & Resilience Middleware", "OpenTelemetry SDK & Circuit-breaker", "Exports sanitized OpenTelemetry traces and handles resilience.")
}

Rel(routing_state_management_component, api_client_component, "Passes state and session data for requests", "")
Rel(api_client_component, api_gateway, "Sends API requests and JWT validation", "HTTPS/WSS with JWT")
Rel(authentication_session_component, idp, "Authenticates via Authorization Code Flow with PKCE", "HTTPS")
Rel(telemetry_resilience_middleware, eu_api_gateway, "Exports sanitized OpenTelemetry traces", "HTTPS")

@enduml