@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(Routing_Load_Balancing_Component, "Routing & Load Balancing Component", "Spring Cloud Gateway", "Manages dynamic request routing, load balancing, and edge caching/compression coordination.")
    Component(Authentication_Authorization_Filter, "Authentication & Authorization Filter", "Spring Security / Custom Filter", "Validates JWTs and enforces strict authentication and authorization.")
    Component(Rate_Limiting_Throttling_Component, "Rate Limiting & Throttling Component", "Redis", "Distributed token bucket rate limiting and pub/sub cache invalidation.")
    Component(Caching_Compression_Component, "Caching & Compression Component", "Spring Caching / Compression", "Caches responses to ensure low-latency search performance.")
    Component(Telemetry_Audit_Interceptor, "Telemetry & Audit Interceptor", "OpenTelemetry", "Handles distributed tracing and telemetry collection.")
    Component(Web_Application_Firewall_WAF_Layer, "Web Application Firewall (WAF) Layer", "WAF Layer", "Provides security enforcement for public and academic library portals.")
    Component(Kubernetes_Deployment_Infrastructure, "Kubernetes Deployment Infrastructure", "Kubernetes", "Manages horizontal autoscaling and resource allocation.")
}

Component(Web_Application_SPA, "Web Application SPA", "Single Page Application", "External or peer client application sending requests.")
Component(Core_Domain_Search_Service, "Core Domain / Search Service", "gRPC over HTTP/2 with mTLS", "Internal backend services handling domain and search logic.")
Component(Kubernetes_Cloud_Load_Balancer, "Kubernetes Cloud Load Balancer", "Cloud Load Balancer", "Routes EU-only traffic into the cluster.")

Rel(Web_Application_SPA, Authentication_Authorization_Filter, "Validates JWTs", "HTTPS")
Rel(Routing_Load_Balancing_Component, Caching_Compression_Component, "Checks cached responses", "Internal")
Rel(Routing_Load_Balancing_Component, Rate_Limiting_Throttling_Component, "Checks request quotas", "In-memory Redis protocol")
Rel(Authentication_Authorization_Filter, Core_Domain_Search_Service, "Propagates cryptographic assertion tokens", "gRPC over HTTP/2 with mTLS")
Rel(Kubernetes_Cloud_Load_Balancer, Routing_Load_Balancing_Component, "Routes EU-only traffic", "HTTPS")

@enduml