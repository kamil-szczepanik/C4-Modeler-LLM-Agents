@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(database, "Database") {
    Component(PgBouncer, "PgBouncer", "PgBouncer", "Connection pooler managing client connections and statement timeouts.")
    Component(PostgreSQL_Core_Relational_Data_Engine, "PostgreSQL Core (Relational Data Engine)", "PostgreSQL", "Stores structured data and enforces row/column-level security (RLS/CLS).")
    Component(pgaudit_Extension, "pgaudit Extension", "pgaudit", "Captures detailed statements and session audit logs for PII access.")
    Component(pgcrypto_Extension, "pgcrypto Extension", "pgcrypto", "Handles transparent column-level encryption for sensitive patron data.")
}

Rel(PgBouncer, PostgreSQL_Core_Relational_Data_Engine, "Routes and manages pooled connections", "TCP")
Rel(PostgreSQL_Core_Relational_Data_Engine, pgaudit_Extension, "Emits database activity logs", "Internal")

@enduml