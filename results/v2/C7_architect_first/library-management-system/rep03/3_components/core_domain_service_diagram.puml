@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(core_domain_service, "Core Domain Service") {
    Component(CatalogManagementComponent, "Catalog Management Component", "Spring @Service, Java", "Manages cataloging rules and operations for the Library Management System.")
    Component(CirculationEngineComponent, "Circulation Engine Component", "Spring @Service, Java", "Processes circulation logic and patron borrowing rules.")
    Component(FineFeeManagementComponent, "Fine & Fee Management Component", "Spring @Service, Java", "Handles financial rules, fines, and fee processing for patrons.")
    Component(DomainEventPublisher, "Domain Event Publisher", "Spring Component, Java", "Delegates and dispatches domain state changes via Spring's ApplicationEventPublisher.")
}

System_Ext(Database, "Database", "PostgreSQL with TDE, EU region")
System_Ext(AsynchronousBroker, "Asynchronous Broker", "Redis with TLS, EU region")

Rel(CatalogManagementComponent, Database, "Executes transactional reads and writes", "Spring Data JPA and JDBC over TLS")
Rel(CirculationEngineComponent, Database, "Executes transactional reads and writes", "Spring Data JPA and JDBC over TLS")
Rel(FineFeeManagementComponent, Database, "Executes transactional reads and writes", "Spring Data JPA and JDBC over TLS")
Rel(CirculationEngineComponent, DomainEventPublisher, "Delegates domain state changes")
Rel(FineFeeManagementComponent, DomainEventPublisher, "Delegates domain state changes")
Rel(DomainEventPublisher, AsynchronousBroker, "Dispatches domain events", "Spring Data Redis over TLS with application-layer encryption for financial payloads")
@enduml