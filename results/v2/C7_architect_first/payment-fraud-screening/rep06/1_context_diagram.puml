@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Real-Time Payment Fraud Screening System

Person(FraudAnalysts, "Fraud Analysts", "Reviews suspicious cases to make final fraud determinations.")
Person(DataScientistsRiskManagers, "Data Scientists / Risk Managers", "Updates scoring models and rules to adapt to new fraud patterns.")
Person(RegulatoryComplianceAuditors, "Regulatory / Compliance Auditors", "Audits system logs and decision inputs for compliance.")

System_Ext(PaymentGatewayAcquirerSystems, "Payment Gateway / Acquirer Systems", "Submits payment authorizations for fraud screening.")
System_Ext(CardNetworksTokenizationProviders, "Card Networks / Tokenization Providers", "Provides token resolution and network-level integrations.")

System(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System", "Screens card-not-present payment authorizations for fraud at scale and supports case management for analysts under PCI-DSS Level 1 compliance.")

Container_Boundary(InfrastructureBoundary, "Supporting Infrastructure") {
    Container(AWSECSonFargate, "AWS ECS on Fargate", "AWS ECS on Fargate", "Runs containerized microservices within a single region (eu-west-1).")
    Container(AWSGlobalAccelerator, "AWS Global Accelerator", "Amazon S3", "Ensures predictable, low-latency routing for high-throughput traffic.")
    Container(S3ObjectLockComplianceMode, "S3 Object Lock (Compliance Mode)", "Amazon S3", "Enforces tamper-evident, 7-year retention for audit logs and decision inputs.")
    Container(AWSSecretsManager, "AWS Secrets Manager", "AWS Secrets Manager", "Manages database credentials, JWT signing keys, and model encryption keys.")
}

Rel(PaymentGatewayAcquirerSystems, RealTimePaymentFraudScreeningSystem, "Submits payment authorizations for fraud screening", "HTTPS / REST (<50ms SLA)")
Rel(FraudAnalysts, RealTimePaymentFraudScreeningSystem, "Reviews suspicious cases", "HTTPS with OIDC/OAuth2 and MFA")
Rel(DataScientistsRiskManagers, RealTimePaymentFraudScreeningSystem, "Updates scoring models and rules", "HTTPS with IAM authentication")
Rel(RealTimePaymentFraudScreeningSystem, CardNetworksTokenizationProviders, "Resolves tokens", "HTTPS / REST with mTLS")

@enduml