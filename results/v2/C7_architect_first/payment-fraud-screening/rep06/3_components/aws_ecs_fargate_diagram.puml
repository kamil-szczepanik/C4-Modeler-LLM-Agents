@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_ecs_fargate, "AWS ECS Fargate") {
    Component(ScoringEngine, "Scoring Engine", "Go, ONNX Runtime", "Screens card-not-present payment authorizations for fraud prior to approval with <50ms P99 latency.")
    Component(CaseManagement, "Case Management", "Node.js, Express", "Provides case management for suspicious transactions and queries persistent fraud cases.")
    Component(ModelRuleManager, "Model/Rule Manager", "Python, FastAPI", "Manages rules and administration workloads, pulling artifacts from storage.")
}

Rel(ScoringEngine, CaseManagement, "Routes decision inputs and flagged transactions", "")
Rel(ModelRuleManager, ScoringEngine, "Deploys updated models and rules", "")
@enduml