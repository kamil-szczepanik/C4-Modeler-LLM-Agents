@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(fraud_scoring_engine, "Fraud Scoring Engine") {
    Component(api_handler, "API Handler", "Go", "Routes authorization requests and coordinates the fraud screening workflow.")
    Component(feature_aggregator, "Feature Aggregator", "Go", "Performs parallel feature lookups to construct feature vectors.")
    Component(inference_orchestrator, "Inference Orchestrator", "Go with embedded ONNX Runtime", "Executes in-memory machine learning model inference for fraud scoring.")
    Component(explainability_engine, "Explainability Engine", "Go", "Calculates tree-path contribution scores for decision explainability.")
    Component(buffered_dispatcher, "Buffered Dispatcher", "Go with BadgerDB", "Batches encrypted audit logs and provides ephemeral storage for zero-loss audit queuing.")
}

Rel(api_handler, feature_aggregator, "Requests feature vectors", "In-memory")
Rel(inference_orchestrator, explainability_engine, "Calculates tree-path contribution scores", "In-memory")

@enduml