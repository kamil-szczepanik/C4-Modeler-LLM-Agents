@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon MSK Serverless container

Container_Boundary(amazon_msk_serverless, "Amazon MSK Serverless") {
    Component(payment_audit_events_Topic, "payment-audit-events Topic", "Apache Kafka Topic", "Kafka topic used to stream asynchronous audit logs from the Fraud Scoring Engine.")
}

System_Ext(consumer_worker_pool, "Consumer Worker Pool", "AWS Lambda / ECS Fargate")

Rel(payment_audit_events_Topic, consumer_worker_pool, "Polls streaming data", "Kafka consumer poll protocol over TLS 1.3")

@enduml