@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalysts, "Fraud Analysts", "Fraud analysts")
System_Ext(AmazonAuroraServerlessv2, "Amazon Aurora Serverless v2", "Relational storage")
System_Ext(AmazonMSKServerless, "Amazon MSK Serverless", "Event streaming")

Container_Boundary(CaseManagementBackend, "Case Management Backend") {
    Component(CaseAPIRouter, "Case API Router", "Express.js", "Express.js controller handling REST endpoints over HTTPS for fraud analysts.")
    Component(CaseService, "Case Service", "TypeScript", "TypeScript domain logic managing case assignment, prioritization, notes, and workflows.")
    Component(AuditLogger, "Audit Logger", "TypeScript SDK", "TypeScript SDK securing tamper-evident audit logs for 7-year retention.")
    Component(EventConsumer, "Event Consumer", "KafkaJS", "KafkaJS background worker ingesting asynchronous review events from Amazon MSK Serverless.")
}

Rel(FraudAnalysts, CaseAPIRouter, "HTTPS via AWS ALB with OIDC-backed JWT validation")
Rel(CaseAPIRouter, CaseService, "In-process function call")
Rel(CaseService, AuditLogger, "In-process function call")
Rel(CaseService, AmazonAuroraServerlessv2, "SQL/TCP over TLS 1.3 via Prisma ORM")
Rel(AmazonMSKServerless, EventConsumer, "Kafka Protocol over TLS 1.3 with IAM authentication")
Rel(EventConsumer, CaseService, "In-process function call")

@enduml