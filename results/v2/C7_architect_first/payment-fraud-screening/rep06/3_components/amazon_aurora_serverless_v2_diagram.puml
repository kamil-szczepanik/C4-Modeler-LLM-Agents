@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(aws_lambda, "AWS Lambda", "External system component")
System_Ext(case_management_backend, "Case Management Backend", "External system component")
System_Ext(amazon_s3, "Amazon S3", "External system component")

Container_Boundary(amazon_aurora_serverless_v2, "Amazon Aurora Serverless v2") {
    Component(case_data_schema, "Case Data Schema", "PostgreSQL-compatible relational engine", "Securely persists case data and review decisions for the real-time payment fraud screening system.")
    Component(audit_log_table, "Audit Log Table", "PostgreSQL pgaudit extension, Row-Level Security", "Append-only, tamper-evident storage for audit trails enforcing strict PCI-DSS boundaries and a 7-year retention policy.")
    Component(amazon_rds_proxy_layer, "Amazon RDS Proxy Layer", "Amazon RDS Proxy", "Provides connection pooling and multiplexing to prevent serverless scaling exhaustion.")
    Component(aws_secrets_manager, "AWS Secrets Manager", "AWS Secrets Manager", "Handles credential and secret management for database access.")
}

Rel(aws_lambda, amazon_rds_proxy_layer, "Ingests streaming audit records", "SQL/TLS over TCP")
Rel(case_management_backend, amazon_rds_proxy_layer, "Queries and mutates case data and audit logs", "SQL/TLS over TCP")
Rel(amazon_rds_proxy_layer, case_data_schema, "Manages multiplexed database connections", "TCP")
Rel(amazon_aurora_serverless_v2, amazon_s3, "Ships immutable audit logs with Object Lock enabled", "HTTPS")

@enduml