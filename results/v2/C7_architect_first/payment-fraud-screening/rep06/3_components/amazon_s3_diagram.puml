@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Regulatory Auditors, "Regulatory Auditors", "External compliance auditors reviewing audit logs.")

System_Ext(Amazon MSK Serverless, "Amazon MSK Serverless", "Streaming platform providing authorization inputs and decisions.")

Container_Boundary(Amazon S3, "Amazon S3") {
    Component(Fraud-Audit-Active, "Fraud-Audit-Active", "Amazon S3 Standard Bucket", "Persists raw authorization inputs, model versions, and decisions via Amazon S3 Sink Connector.")
    Component(WORM-Policy, "WORM-Policy", "Amazon S3 Object Lock Configuration", "Enforces Write-Once-Read-Many (WORM) storage for 7-year tamper-evident audit retention in Compliance Mode.")
    Component(Amazon S3 Lifecycle Management Engine, "Amazon S3 Lifecycle Management Engine", "AWS S3 Lifecycle", "Automates lifecycle transitions to S3 Glacier Flexible Archive after 30 days to stay within budget.")
    Component(Amazon Athena Query Layer, "Amazon Athena Query Layer", "Amazon Athena", "Provides low-cost, serverless querying over parquet-formatted audit logs in place.")
    Component(AWS KMS Customer Managed Keys, "AWS KMS Customer Managed Keys", "AWS KMS (SSE-KMS)", "Encrypts data at rest using Customer Managed Keys to meet PCI-DSS Level 1 standards.")
}

Rel(Amazon MSK Serverless, Fraud-Audit-Active, "Persists raw authorization inputs, model versions, and decisions via Amazon S3 Sink Connector", "HTTPS/REST with TLS 1.3")
Rel(Fraud-Audit-Active, WORM-Policy, "Protected by")
Rel(Fraud-Audit-Active, Amazon S3 Lifecycle Management Engine, "Managed by lifecycle rules for transition to Glacier")
Rel(Regulatory Auditors, Amazon Athena Query Layer, "Queries parquet-formatted audit logs in place", "Pre-signed URLs (HTTPS)")
Rel(Amazon Athena Query Layer, Fraud-Audit-Active, "Reads audit logs from")
Rel(Fraud-Audit-Active, AWS KMS Customer Managed Keys, "Encrypted using")
@enduml