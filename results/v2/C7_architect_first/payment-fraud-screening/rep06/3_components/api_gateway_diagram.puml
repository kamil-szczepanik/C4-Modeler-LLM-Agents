@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(aws_api_gateway_aws_waf, "AWS API Gateway + AWS WAF", "AWS API Gateway, AWS WAF", "Handles edge routing, TLS 1.3 termination, rate limiting, and DDoS protection.")
    Component(edge_tokenizer_sanitizer, "Edge Tokenizer & Sanitizer", "AWS Lambda", "Performs edge tokenization and PAN data sanitization to enforce PCI-DSS compliance.")
}

Rel(aws_api_gateway_aws_waf, edge_tokenizer_sanitizer, "Invokes synchronous payload validation", "Internal AWS Runtime")

@enduml