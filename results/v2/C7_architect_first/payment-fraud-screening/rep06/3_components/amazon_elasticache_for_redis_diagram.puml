@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Boundary(amazon_elasticache_for_redis, "Amazon ElastiCache for Redis") {
    Component(Redis Feature Store Engine, "Redis Feature Store Engine", "Redis Engine v7.x with Cluster Proxy and AOF Persistence", "Provides sub-millisecond real-time feature lookups using volatile-lru eviction and TTLs.")
}

Rel(Fraud Scoring Engine, Redis Feature Store Engine, "Performs real-time feature lookups", "TCP over TLS")

@enduml