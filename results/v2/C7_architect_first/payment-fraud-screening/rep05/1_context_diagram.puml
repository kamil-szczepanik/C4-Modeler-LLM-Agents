@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalystsAndRiskOperationsManagers, "Fraud Analysts and Risk Operations Managers", "Internal users responsible for case management, reporting, and reviewing flagged payment authorizations.")

System_Ext(PaymentGatewayAcquirerSystems, "Payment Gateway / Acquirer Systems", "External software systems submitting card-not-present payment authorizations for real-time fraud screening.")
System_Ext(CardNetworksTokenizationVault, "Card Networks / Tokenization Vault", "External system used for secure API calls to validate card tokens without storing PANs.")
System_Ext(ImmutableAuditLogSink, "Immutable Audit Log Sink", "AWS-based storage utilizing S3 Object Lock, KMS, and CloudTrail Lake for automated cryptographic log shipping and 7-year audit retention.")

System(CoreFraudScreeningSystem, "Core Fraud Screening System", "Evaluates card-not-present payment authorizations in AWS (eu-west-1) to detect fraud and manage reviews while satisfying PCI-DSS Level 1 compliance.")

Rel(PaymentGatewayAcquirerSystems, CoreFraudScreeningSystem, "Sends payment authorizations for real-time scoring", "gRPC over TLS (mTLS)")
Rel(FraudAnalystsAndRiskOperationsManagers, CoreFraudScreeningSystem, "Accesses case management and reporting", "HTTPS via ZTNA / identity-aware proxies with SSO")
Rel(CoreFraudScreeningSystem, CardNetworksTokenizationVault, "Validates card tokens securely without storing PANs", "Secure API calls")
Rel(CoreFraudScreeningSystem, ImmutableAuditLogSink, "Performs automated cryptographic log shipping and S3 Object Lock", "AWS S3 Object Lock, KMS, and CloudTrail Lake")

@enduml