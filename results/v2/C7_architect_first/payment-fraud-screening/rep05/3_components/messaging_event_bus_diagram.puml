@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Messaging & Event Bus", "Messaging & Event Bus") {
    Component(Audit_Event_Publisher_SNS, "Audit Event Publisher (SNS)", "Amazon SNS", "Asynchronously publishes decision payloads and case review events.")
    Component(Audit_Buffer_Queue_SQS, "Audit Buffer Queue (SQS)", "Amazon SQS with FIFO/DLQ", "Buffers event copies for batch delivery to audit storage.")
}

Rel(Audit_Event_Publisher_SNS, Audit_Buffer_Queue_SQS, "Delivers event copies", "SQS Subscriptions")

@enduml