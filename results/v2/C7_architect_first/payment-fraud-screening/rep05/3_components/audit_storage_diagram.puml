@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(MessagingEventBus, "Messaging & Event Bus", "External messaging/event bus system")

Container_Boundary(AuditStorage, "Audit Storage") {
    Component(AmazonKinesisDataFirehose, "Amazon Kinesis Data Firehose", "AWS Kinesis Data Firehose", "Natively handles batching, compression, and buffering without custom code to minimize operational overhead for a 3-engineer team.")
    Component(AmazonS3withObjectLock, "Amazon S3 with Object Lock", "Amazon S3 (Object Lock in Compliance Mode)", "Enforces strict WORM storage to satisfy 7-year regulatory retention mandates.")
    Component(AWSKMS, "AWS KMS", "AWS Key Management Service", "Manages customer-managed keys (CMK) and envelope encryption to protect cardholder and audit data.")
    Component(S3CrossRegionReplication, "S3 Cross-Region Replication", "S3 Cross-Region Replication (CRR)", "Replicates immutable audit objects across AWS regions securely via HTTPS.")
    Component(AmazonS3GlacierFlexibleRetrieval, "Amazon S3 Glacier Flexible Retrieval", "Amazon S3 Glacier Flexible Retrieval / Deep Archive", "Automatically transitions aged audit logs to low-cost storage to stay within budget constraints.")
}

Rel(MessagingEventBus, AmazonKinesisDataFirehose, "Pushes batch audit events", "AWS SQS/SNS integration (HTTPS)")
Rel(AmazonKinesisDataFirehose, AmazonS3withObjectLock, "Writes encrypted, immutable objects", "TLS 1.3 and AWS SigV4")
Rel(AmazonS3withObjectLock, S3CrossRegionReplication, "Replicates immutable audit objects", "HTTPS")
@enduml