@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(RealTimeScoringService, "Real-Time Scoring Service", "External scoring service container.")
System_Ext(AmazonSNSSQS, "Amazon SNS/SQS", "External messaging service.")

Container_Boundary(FeatureCache, "Feature Cache") {
    Component(AmazonDynamoDB, "Amazon DynamoDB", "Amazon DynamoDB", "Serverless primary data store for transactional features and velocity metrics.")
    Component(FeatureDataAccessComponent, "Feature Data Access Component", "Go (AWS SDK)", "Application layer utilizing the AWS SDK for optimized batch reads and writes.")
    Component(TTLManagerComponent, "TTL Manager Component", "DynamoDB Time-To-Live", "DynamoDB Time-To-Live feature for automatically expiring stale transactional records.")
    Component(InProcessGoCache, "In-Process Go Cache", "In-Process Go Memory", "Local, short-TTL memory cache inside the Real-Time Scoring Service for static features.")
    Component(AWSKeyManagementServiceKMS, "AWS Key Management Service (KMS)", "AWS KMS (CMK)", "Customer-managed keys securing data encryption-at-rest.")
}

Rel(RealTimeScoringService, FeatureDataAccessComponent, "Retrieves and updates features via VPC Endpoints using HTTPS/gRPC.", "HTTPS/gRPC")
Rel(FeatureDataAccessComponent, AmazonDynamoDB, "Executes encrypted data read/write queries over AWS VPC infrastructure.", "AWS VPC")
Rel(RealTimeScoringService, InProcessGoCache, "Fetches static cached features via internal application memory access.", "Internal Memory")
Rel(AmazonSNSSQS, InProcessGoCache, "Delivers event-driven cache invalidation messages for velocity updates.", "Event Stream")

@enduml