@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Audit_and_Case_Data_Store", "Audit and Case Data Store") {
    Component(Transactional_and_Audit_Schema, "Transactional and Audit Schema", "Amazon Aurora PostgreSQL", "Houses transactional and audit schemas for storing immutable decision logs.")
    Component(Case_Schema, "Case Schema", "Amazon Aurora PostgreSQL", "Houses case schemas for managing analyst workflows and query processing.")
}

Rel(Transactional_and_Audit_Schema, Case_Schema, "Replicates data to read replica", "PostgreSQL wire protocol")

@enduml