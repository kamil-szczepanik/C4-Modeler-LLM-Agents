@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(real_time_scoring_service, "Real-Time Scoring Service") {
    Component(API_Handler_Component, "API Handler Component", "Go / net/http", "Processes card-not-present payment authorizations to approve, decline, or route transactions for review.")
    Component(Feature_Aggregator_Component, "Feature Aggregator Component", "Go", "Reads and writes low-latency features via VPC endpoints over AWS.")
    Component(Scoring_Engine_Component, "Scoring Engine Component", "Go", "Executes fraud scoring logic and internally consumes data via Go channels and context propagation.")
    Component(Audit_Publisher_Component, "Audit Publisher Component", "Go / AWS SDK", "Publishes asynchronous audit events to decoupling messaging infrastructure.")
    Component(Fallback_Circuit_Breaker_Component, "Fallback Circuit Breaker Component", "Go", "Ensures high performance, fault tolerance, and resilience under failure conditions.")
    Component(Telemetry_Interceptor_Component, "Telemetry Interceptor Component", "Go", "Monitors and captures telemetry data for performance and latency tracking.")
}

Component(Amazon_API_Gateway__Fallback_Layer, "Amazon API Gateway & Fallback Layer", "Amazon API Gateway", "Handles internal routing of scoring requests.")
Component(Amazon_ECS_Fargate, "Amazon ECS Fargate", "AWS ECS Fargate", "Container orchestration maintaining low operational load.")
Component(Amazon_DynamoDB, "Amazon DynamoDB", "Amazon DynamoDB", "Low-latency NoSQL data store used for the Feature Cache.")
Component(Amazon_SQS_and_SNS, "Amazon SQS and SNS", "Amazon SQS and SNS", "Messaging infrastructure used to decouple non-blocking audit event generation.")
Component(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Relational data store supporting system operations.")
Component(Amazon_S3_with_Object_Lock, "Amazon S3 with Object Lock", "Amazon S3", "Dynamically loads cryptographically verified model binaries and rules.")
Component(AWS_KMS, "AWS KMS", "AWS KMS", "Secures model decryption keys and audit signing keys.")
Person(Fraud_Analysts_and_Risk_Operations_Managers, "Fraud Analysts and Risk Operations Managers", "Users who interact with the system for review and auditable decision-making.")

Rel(Amazon_API_Gateway__Fallback_Layer, API_Handler_Component, "Internal routing of scoring requests", "REST/gRPC")
Rel(Feature_Aggregator_Component, Amazon_DynamoDB, "Reads and writes low-latency features", "VPC endpoints over AWS")
Rel(Scoring_Engine_Component, Feature_Aggregator_Component, "Internal data consumption", "Go channels and context propagation")
Rel(Audit_Publisher_Component, Amazon_SQS_and_SNS, "Publishes asynchronous audit events", "AWS SDK")
Rel(real_time_scoring_service, Amazon_S3_with_Object_Lock, "Dynamically loads cryptographically verified model binaries and rules", "HTTPS/AWS SDK")

@enduml