@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management Backend container

Container_Boundary(case_management_backend, "Case Management Backend") {
    Component(case_api_controller, "Case API Controller", "Node.js, Express, TypeScript", "Handling incoming HTTPS requests from Fraud Analysts.")
    Component(case_workflow_engine, "Case Workflow Engine", "TypeScript", "Managing case state transitions and SLA timers.")
    Component(audit_evidence_assembler, "Audit & Evidence Assembler", "TypeScript", "Sanitizing payloads and gathering decision metadata.")
    Component(read_model_projection_component, "Read Model Projection Component", "TypeScript", "Maintaining denormalized read views from asynchronous events.")
    Component(data_access_layer, "Data Access Layer", "TypeORM/Prisma", "Interfacing with PostgreSQL via AWS RDS Proxy.")
    ComponentDb(audit_and_case_data_store, "Audit and Case Data Store", "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL database storing transactional case data.")
    Component(messaging_event_bus, "Messaging & Event Bus", "Amazon SQS and SNS", "Amazon SQS and SNS for asynchronous event distribution.")
}

Rel(case_api_controller, case_workflow_engine, "Invokes workflow operations", "In-process")
Rel(case_api_controller, audit_evidence_assembler, "Gathers decision metadata and sanitized evidence", "In-process")
Rel(case_api_controller, read_model_projection_component, "Queries paginated audit trails", "In-process")
Rel(case_workflow_engine, data_access_layer, "Executes queries", "In-process")
Rel(audit_evidence_assembler, data_access_layer, "Executes queries", "In-process")
Rel(case_workflow_engine, messaging_event_bus, "Publishes state change events", "Amazon SQS/SNS")
Rel(data_access_layer, audit_and_case_data_store, "Performs transactional queries", "AWS RDS Proxy over VPC endpoints")

@enduml