@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Fraud_Analysts, "Fraud Analysts", "Fraud analysts who use the Case Management UI to review and manage fraud cases.")
Person(Compliance_Auditors, "Compliance Auditors", "Compliance auditors who review audit logs and ensure strict regulatory compliance.")

System_Ext(Payment_Gateway_Acquirer, "Payment Gateway / Acquirer", "Sends authorization requests for card-not-present transactions.")
System_Ext(Card_Schemes_External_Credit_Bureaus, "Card Schemes / External Credit Bureaus", "External systems used for data enrichment during transaction evaluation.")

System(Real_Time_Payment_Fraud_Screening_System, "Real-Time Payment Fraud Screening System", "A real-time payment fraud screening system that evaluates card-not-present transactions for a mid-size payment processor, providing instant authorization decisions and case management for fraud analysts while ensuring strict regulatory compliance.")

Rel(Payment_Gateway_Acquirer, Real_Time_Payment_Fraud_Screening_System, "Sends authorization requests", "gRPC / TLS 1.3 (mTLS)")
Rel(Fraud_Analysts, Real_Time_Payment_Fraud_Screening_System, "Accesses Case Management UI", "HTTPS / Browser")
Rel(Real_Time_Payment_Fraud_Screening_System, Card_Schemes_External_Credit_Bureaus, "Fetches data enrichment", "HTTPS / REST")
@enduml