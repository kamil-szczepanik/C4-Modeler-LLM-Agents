@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(fraud_analysts, "Fraud Analysts", "Users reviewing suspicious payments and managing fraud cases.")
System_Ext(case_management_backend, "Case Management Backend", "Node.js / TypeScript, Amazon ECS Fargate", "Handles backend business logic, case management, rules, and decision feedback.")

Container_Boundary(fraud_analyst_ui, "Fraud Analyst UI") {
    Component(authentication_module, "Authentication Module", "React, AWS Amplify, AWS Cognito", "Handles user authentication, MFA, session management, and short-lived JWTs.")
    Component(case_dashboard_queue, "Case Dashboard & Queue", "React, TanStack Table", "Enables fraud analysts to manage queues and inspect case data.")
    Component(transaction_inspector, "Transaction Inspector with Decision Feedback Widget", "React", "Inspects transactions and allows analysts to submit decision feedback.")
    Component(rule_model_panel, "Rule & Model Management Panel", "React", "Allows fraud analysts to view, update, and manage fraud rules and models.")
    Component(observability_service, "Observability Service", "AWS RUM, AWS X-Ray, OpenTelemetry", "Tracks client-side observability and performance.")
}

Rel(fraud_analysts, authentication_module, "Authenticates via", "HTTPS / Browser")
Rel(authentication_module, case_dashboard_queue, "Passes in-memory state", "React Context API")
Rel(case_dashboard_queue, case_management_backend, "Sends requests", "HTTPS / REST, Authorization: Bearer JWT")
Rel(transaction_inspector, case_management_backend, "Sends requests for decision feedback", "HTTPS / REST")
Rel(rule_model_panel, case_management_backend, "Sends requests for rule management", "HTTPS / REST")

@enduml