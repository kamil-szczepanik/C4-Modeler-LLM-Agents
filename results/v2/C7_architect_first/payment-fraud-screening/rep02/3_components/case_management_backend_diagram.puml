@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management Backend container

Container_Boundary(case_management_backend, "Case Management Backend") {
    Component(api_router_controller, "API Router / Controller", "Express.js / Node.js", "Manages incoming HTTPS REST requests and JWT validation.")
    Component(case_service, "Case Service", "TypeScript", "Handles domain business logic, case lifecycles, and WebSockets.")
    Component(audit_logger_component, "Audit Logger Component", "TypeScript", "Asynchronously processes tamper-evident audit records.")
    Component(metrics_telemetry_collector, "Metrics & Telemetry Collector", "OpenTelemetry", "Captures operational SLAs and review turnaround times.")
    Component(data_access_layer, "Data Access Layer", "AWS SDK v3", "Enforces data masking and tokenization against databases.")
}

Component(fraud_analyst_ui, "Fraud Analyst UI", "Web UI", "User interface for fraud analysts reviewing cases.")
Component(amazon_sqs_fifo_queue, "Amazon SQS FIFO Queue", "Amazon SQS FIFO (with DLQ)", "Guarantees ordered, reliable, and retriable audit event dispatching.")

Rel(fraud_analyst_ui, api_router_controller, "HTTPS / REST and WebSockets", "HTTPS / WebSocket")
Rel(api_router_controller, case_service, "In-process function calls", "")
Rel(case_service, metrics_telemetry_collector, "In-process telemetry calls", "")
Rel(case_service, data_access_layer, "Reads/writes hot cases", "DynamoDB SDK")
Rel(audit_logger_component, amazon_sqs_fifo_queue, "Publishes audit events", "HTTPS / SigV4")
Rel(amazon_sqs_fifo_queue, data_access_layer, "Batched consumption", "Aurora SDK")
Rel(case_management_backend, amazon_sqs_fifo_queue, "Interface VPC Endpoints", "")

@enduml