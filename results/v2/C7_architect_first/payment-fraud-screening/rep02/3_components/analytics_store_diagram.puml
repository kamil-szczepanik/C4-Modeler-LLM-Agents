@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Analytics Store container

Person(FraudAnalystsComplianceAuditors, "Fraud Analysts & Compliance Auditors", "HTTPS via AWS Cognito", "Users querying analytics and compliance dashboards.")

Container(AuditLogStore, "Audit Log Store", "Aurora PostgreSQL", "Source of audit logs for the analytics pipeline.")

Container_Boundary(AnalyticsStore, "Analytics Store") {
    Component(DataLakeStorage, "Data Lake Storage", "Amazon S3, Parquet format, Object Lock", "Immutable, cost-effective storage meeting the 7-year retention rule under budget.")
    Component(QueryEngine, "Query Engine", "Amazon Athena", "Serverless SQL query engine eliminating operational infrastructure overhead.")
    Component(SchemaCatalog, "Schema Catalog", "AWS Glue Data Catalog", "Manages schema definitions for data lake storage.")
    Component(ETLIngestionWorker, "ETL Ingestion Worker", "AWS Lambda (Python)", "Serverless ETL execution enforcing automated PII masking without AWS DMS.")
    Component(BIDashboardInterface, "BI Dashboard Interface", "Amazon QuickSight", "Pay-per-session BI dashboarding layer empowering non-technical analysts.")
    Component(SecurityControls, "Security Controls", "AWS Lake Formation, AWS KMS", "Granular row and column-level access control for compliance.")
}

Rel(AuditLogStore, DataLakeStorage, "Lambda PutObject", "HTTPS")
Rel(DataLakeStorage, SchemaCatalog, "AWS Glue Crawler / Explicit Schema", "")
Rel(SchemaCatalog, QueryEngine, "SQL", "HTTPS")
Rel(QueryEngine, BIDashboardInterface, "JDBC/ODBC", "HTTPS")
Rel(FraudAnalystsComplianceAuditors, BIDashboardInterface, "HTTPS", "AWS Cognito")

@enduml