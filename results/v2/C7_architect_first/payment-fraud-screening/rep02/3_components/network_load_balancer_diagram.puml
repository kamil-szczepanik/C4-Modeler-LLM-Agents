@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(network_load_balancer, "Network Load Balancer") {
    Component(TLS_Termination, "TLS Termination", "AWS Network Load Balancer TLS Listener", "Handles Layer 4/7 edge routing with TLS 1.3/1.2 ciphers and terminates incoming mTLS connections from the API Gateway.")
    Component(Health_Check, "Health Check", "AWS NLB Target Group Health Checks", "Monitors the health and availability of downstream Fraud Scoring Engine instances.")
}

Rel(TLS_Termination, Health_Check, "Validates target availability before forwarding traffic", "")

@enduml