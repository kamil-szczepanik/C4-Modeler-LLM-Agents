@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit Log Store container

System_Ext(FraudScoringEngine, "Fraud Scoring Engine", "External system writing decision logs.")
System_Ext(CaseManagementBackend, "Case Management Backend", "External system writing audit trails and querying audit bundles.")
System_Ext(AmazonS3, "Amazon S3", "External cloud storage for WORM-compliant archives.")

Container_Boundary(AuditLogStore, "Audit Log Store") {
    Component(AuditIngestionComponent, "Audit Ingestion Component", "Go", "Ingests decision logs and audit trails from the Fraud Scoring Engine and Case Management Backend.")
    ComponentDb(LedgerStorageEngine, "Ledger Storage Engine", "Amazon Aurora PostgreSQL Ledger Tables", "Stores ledger data for cryptographic immutability and simple operations.")
    Component(RetentionArchivalComponent, "Retention & Archival Component", "AWS Step Functions + Amazon ECS Fargate + Amazon S3 Object Lock", "Offloads historical partitions and stores WORM-compliant archives.")
    Component(AuditorQueryService, "Auditor Query Service", "Go", "Provides audit bundles to the Case Management Backend via internal REST API to satisfy sub-50ms constraints.")
}

Rel(FraudScoringEngine, AuditIngestionComponent, "Writes decision logs", "internal HTTP/gRPC [AWS SDK, mTLS, IAM]")
Rel(CaseManagementBackend, AuditIngestionComponent, "Writes audit trails", "internal HTTP/gRPC [AWS SDK, mTLS, IAM]")
Rel(CaseManagementBackend, AuditorQueryService, "Requests audit bundles", "internal REST API [TLS 1.3]")
Rel(RetentionArchivalComponent, LedgerStorageEngine, "Offloads historical partitions", "PostgreSQL wire protocol")
Rel(RetentionArchivalComponent, AmazonS3, "Stores WORM-compliant archives", "HTTPS/TLS 1.3")
Rel(AuditIngestionComponent, LedgerStorageEngine, "Persists logs", "PostgreSQL wire protocol")

@enduml