@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalysts, "Fraud Analysts", "Views business and technical KPIs via HTTPS.")
System_Ext(FraudScoringEngine, "Fraud Scoring Engine", "Sends masked traces and metrics.")

Container_Boundary(ObservabilityService, "Observability Service") {
    Component(TelemetryCollector, "Telemetry Collector", "AWS Distro for OpenTelemetry (ADOT) sidecar", "Collects and performs local payload scrubbing on traces and metrics to protect cardholder data (PANs).")
    Component(MetricsTracingBackend, "Metrics & Tracing Backend", "Amazon CloudWatch Metrics & AWS X-Ray", "Stores and visualizes sanitized metrics and traces with native AWS integration.")
    Component(LogIngestionRetentionManager, "Log Ingestion & Retention Manager", "Amazon CloudWatch Logs and Amazon S3 with S3 Object Lock (Compliance Mode)", "Manages log ingestion and guarantees tamper-evident 7-year audit retention.")
    Component(OperationsDashboard, "Operations Dashboard", "Amazon CloudWatch Dashboards", "Provides business and technical KPIs for operations and analysts.")
    Component(SyntheticMonitoring, "Synthetic Monitoring", "CloudWatch Synthetic Canaries", "Performs continuous uptime validation against the 1-minute availability SLA.")
}

Rel(FraudScoringEngine, TelemetryCollector, "Sends masked traces and metrics", "gRPC over TLS 1.3")
Rel(TelemetryCollector, MetricsTracingBackend, "Forwards sanitized metrics and traces", "TLS 1.3")
Rel(FraudAnalysts, OperationsDashboard, "Views business and technical KPIs", "HTTPS")

@enduml