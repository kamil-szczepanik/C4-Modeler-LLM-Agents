@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalystsAndComplianceAuditors, "Fraud Analysts and Compliance Auditors", "Users who authenticate via the Authentication Component.")
Container(FraudAnalystUI, "Fraud Analyst UI", "Web UI", "UI for fraud analysts.")
Container(FraudScoringEngine, "Fraud Scoring Engine", "Backend Service", "Engine that scores transactions.")
Container(CaseManagementBackend, "Case Management Backend", "Backend Service", "Backend for managing cases.")
ContainerDb(AuditLogStore, "Audit Log Store", "Database", "Store for audit logs.")

System_Boundary(IdentityAndSecurityService, "Identity & Security Service") {
    Component(AuthenticationComponent, "Authentication Component", "AWS Cognito", "Manages user authentication and short-lived JWT tokens for analysts.")
    Component(KeyManagementComponent, "Key Management Component", "AWS KMS", "Handles envelope encryption, cryptographic signing, and data key caching via AWS Encryption SDK.")
    Component(SecretsManagementComponent, "Secrets Management Component", "AWS Secrets Manager", "Secures and automatically rotates database credentials and API keys.")
    Component(AccessControlAndPolicyComponent, "Access Control & Policy Component", "AWS IAM", "Enforces strict least-privilege service-to-service authorization and segregation of duties.")
}

Rel(FraudAnalystUI, AuthenticationComponent, "Authenticates", "HTTPS/OIDC")
Rel(FraudScoringEngine, SecretsManagementComponent, "Retrieves secrets", "HTTPS/AWS SDK")
Rel(CaseManagementBackend, SecretsManagementComponent, "Retrieves secrets", "HTTPS/AWS SDK")
Rel(FraudScoringEngine, AccessControlAndPolicyComponent, "Enforces IAM roles", "AWS STS/IAM API")
Rel(CaseManagementBackend, AccessControlAndPolicyComponent, "Enforces IAM roles", "AWS STS/IAM API")
Rel(AuditLogStore, KeyManagementComponent, "Uses for ledger table encryption", "AWS KMS API")

@enduml