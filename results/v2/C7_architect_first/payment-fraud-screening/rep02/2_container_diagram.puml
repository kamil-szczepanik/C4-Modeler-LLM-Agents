@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Real-Time Payment Fraud Screening System

Person(FraudAnalysts, "Fraud Analysts", "Fraud analysts who use the Case Management UI to review and manage fraud cases.")
Person(ComplianceAuditors, "Compliance Auditors", "Compliance auditors who review audit logs and ensure strict regulatory compliance.")

System_Ext(PaymentGatewayAcquirer, "Payment Gateway / Acquirer", "Sends authorization requests for card-not-present transactions.")
System_Ext(CardSchemesExternalCreditBureaus, "Card Schemes / External Credit Bureaus", "External systems used for data enrichment during transaction evaluation.")

System_Boundary(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System") {
    Container(APIGateway, "API Gateway", "AWS API Gateway (REST)", "Handles ingress, JWT validation, and token masking.")
    Container(NetworkLoadBalancer, "Network Load Balancer", "AWS Network Load Balancer (NLB)", "Handles load balancing with mTLS via AWS Certificate Manager Private CA.")
    Container(FraudScoringEngine, "Fraud Scoring Engine", "Go, Amazon ECS on EC2 (c6i)", "Provides real-time fraud scoring and evaluation for payment authorizations.")
    Container(CaseManagementBackend, "Case Management Backend", "Node.js / TypeScript, Amazon ECS Fargate", "Backend service powering the fraud analyst case management workflow.")
    Container(FraudAnalystUI, "Fraud Analyst UI", "React Single Page Application, Amazon S3, Amazon CloudFront", "User interface for fraud analysts to review and manage fraud cases.")
    ContainerDb(FeatureRuleStoreHotCaseData, "Feature/Rule Store & Hot Case Data", "Amazon DynamoDB", "Stores features, rules, and hot case data.")
    ContainerDb(AuditLogStore, "Audit Log Store", "Amazon Aurora PostgreSQL with ledger tables", "Provides tamper-evident 7-year audit logs.")
    Container(AnalyticsStore, "Analytics Store", "Amazon S3 with Athena", "Storage and analytics for transaction and fraud data.")
    Container(IdentitySecurityService, "Identity & Security Service", "AWS Cognito, AWS Secrets Manager, AWS KMS", "Manages authentication, secrets, and encryption.")
    Container(ObservabilityService, "Observability Service", "AWS X-Ray, AWS Container Insights", "Provides tracing, metrics, and monitoring for services.")
}

Rel(PaymentGatewayAcquirer, APIGateway, "Communicates authorization requests", "HTTPS (REST, TLS 1.3)")
Rel(APIGateway, NetworkLoadBalancer, "Routes traffic", "mTLS")
Rel(NetworkLoadBalancer, FraudScoringEngine, "Routes scored requests", "mTLS")
Rel(FraudAnalysts, FraudAnalystUI, "Interacts with", "HTTPS / Browser")
Rel(FraudAnalystUI, CaseManagementBackend, "Interacts with", "HTTPS")
Rel(CaseManagementBackend, FeatureRuleStoreHotCaseData, "Reads/writes", "AWS SDK")
Rel(CaseManagementBackend, AuditLogStore, "Reads/writes", "AWS SDK")
Rel(FraudScoringEngine, FeatureRuleStoreHotCaseData, "Queries features and rules", "AWS SDK using IAM Roles")
Rel(FraudScoringEngine, AuditLogStore, "Writes tamper-evident decision logs", "AWS SDK using IAM Roles")
Rel(FraudScoringEngine, ObservabilityService, "Sends metrics and traces", "AWS X-Ray / Container Insights")

@enduml