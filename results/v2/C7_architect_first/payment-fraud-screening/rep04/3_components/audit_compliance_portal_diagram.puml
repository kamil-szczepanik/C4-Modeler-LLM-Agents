@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(ComplianceOfficerAuditor, "Compliance Officer / Auditor", "End user accessing the secure portal to review audit logs and generate compliance reports.")

System_Ext(IdentityPoviderIdP, "Identity Provider (IdP)", "External OIDC/JWT authentication provider.")
System_Ext(AuditQueryAPI, "Audit Query API", "Backend service for retrieving audit records.")

Container_Boundary(AuditCompliancePortal, "Audit & Compliance Portal") {
    Component(PortalUIComponent, "Portal UI Component", "React SPA served via AWS S3 / CloudFront", "Powers the SPA frontend for lightweight client-side routing and timeline visualization.")
    Component(BFFRoutingRBACComponent, "BFF Routing & RBAC Component", "Node.js & NestJS, AWS ECS Fargate", "Powers the BFF container for centralized RBAC, session management, and routing.")
    Component(AmazonElastiCacheRedis, "Amazon ElastiCache (Redis)", "Amazon ElastiCache (Redis) with AWS KMS", "Caches historical queries to optimize performance for auditor workloads and encrypts cached audit data at rest.")
}

Rel(ComplianceOfficerAuditor, PortalUIComponent, "Accesses interface via HTTPS")
Rel(PortalUIComponent, BFFRoutingRBACComponent, "API requests via HTTPS/JSON using HTTP-only cookies")
Rel(BFFRoutingRBACComponent, AuditQueryAPI, "Fetches audit data via HTTPS/gRPC over mTLS with propagated JWTs")
Rel(BFFRoutingRBACComponent, AmazonElastiCacheRedis, "Caches and retrieves encrypted audit read results")
Rel(BFFRoutingRBACComponent, IdentityPoviderIdP, "Authenticates users via OIDC/JWT")

@enduml