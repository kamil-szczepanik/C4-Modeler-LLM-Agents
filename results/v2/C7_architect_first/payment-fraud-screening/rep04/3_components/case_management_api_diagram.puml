@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Case Management API", "Case Management API") {
    Component("Case Controller Component", "Case Controller Component", "Go, chi Router", "Provides lightweight, native HTTP routing and handles incoming API requests from the Analyst Web Application.")
    Component("Workflow Service Component", "Workflow Service Component", "Go, In-process function calls", "Invokes state transitions and manages the core case management workflow.")
    Component("Audit Logger Component", "Audit Logger Component", "Go, Transactional outbox pattern", "Publishes events and ensures secure audit logging.")
    Component("Case Metrics / SLA Service Component", "Case Metrics / SLA Service Component", "Go, Prometheus", "Tracks internal metrics for queue depth and SLA tracking.")
}

Rel("Case Controller Component", "Workflow Service Component", "Invokes state transitions", "In-process Go function calls")
Rel("Workflow Service Component", "Audit Logger Component", "Publishes events", "Transactional outbox pattern")
@enduml