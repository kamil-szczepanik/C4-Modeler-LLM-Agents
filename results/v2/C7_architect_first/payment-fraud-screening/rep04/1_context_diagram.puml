@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Fraud_Analyst, "Fraud Analyst", "Reviews fraud cases using the web-based UI.")
Person(Compliance_Officer_Auditor, "Compliance Officer / Auditor", "Accesses audit logs and compliance data.")
Person(Cardholder, "Cardholder", "Initiates card-not-present payment transactions.")
System_Ext(Payment_Gateway_Core_Processing_Platform, "Payment Gateway / Core Processing Platform", "Sends payment authorizations for fraud screening.")
System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "Authenticates users via OAuth2/OIDC.")
System_Ext(AWS_Cloud_Services_eu_west_1, "AWS Cloud Services (eu-west-1)", "Cloud infrastructure hosting the system and S3 audit logs.")
System_Ext(AWS_S3, "AWS S3", "Object storage with Object Lock for 7-year tamper-evident audit retention.")

System(Real_Time_Payment_Fraud_Screening_System, "Real-Time Payment Fraud Screening System", "Screens card-not-present payment authorizations for fraud at 3,000 TPS while supporting analyst case reviews, enforcing PCI-DSS Level 1 compliance and 7-year tamper-evident auditability within a €25k/month AWS budget.")

Rel(Payment_Gateway_Core_Processing_Platform, Real_Time_Payment_Fraud_Screening_System, "Sends payment authorizations for fraud screening", "gRPC over TLS 1.3")
Rel(Fraud_Analyst, Real_Time_Payment_Fraud_Screening_System, "Performs analyst case reviews", "HTTPS (Web-based UI)")
Rel(Compliance_Officer_Auditor, AWS_S3, "Accesses audit records", "HTTPS")
Rel(Real_Time_Payment_Fraud_Screening_System, Identity_Provider_IdP, "Authenticates users and sessions", "OAuth2/OIDC")

@enduml