@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalyst, "Fraud Analyst", "Evaluates flagged transactions and manages fraud cases.")
Person(MerchantRiskManager, "Merchant Risk Manager", "Monitors KPIs and rule efficacy via a web dashboard.")
Person(ComplianceAuditorOfficer, "Compliance / Auditor Officer", "Reviews audit trails and ensures regulatory compliance.")

System_Ext(PaymentGatewayAcquirerSystems, "Payment Gateway / Acquirer Systems", "External software system providing payment authorization traffic.")
System_Ext(CardNetworksTokenizationVaults, "Card Networks / Tokenization Vaults", "External software system for card data tokenization and network interaction.")
System_Ext(CoreBankingLedgerSystems, "Core Banking / Ledger Systems", "External software system receiving asynchronous post-processing messages.")

System(RealTimePaymentFraudScreening, "Real-Time Payment Fraud Screening", "A real-time payment fraud screening system for a mid-size payment processor that evaluates card-not-present authorizations against fraud models before approval, providing case management for fraud analysts while ensuring strict PCI-DSS Level 1 compliance and sub-50ms latency.")

Rel(PaymentGatewayAcquirerSystems, RealTimePaymentFraudScreening, "Evaluates card-not-present authorizations against fraud models", "REST/JSON over HTTPS with mTLS and OAuth2/JWT")
Rel(FraudAnalyst, RealTimePaymentFraudScreening, "Performs case management", "HTTPS via Web UI")
Rel(MerchantRiskManager, RealTimePaymentFraudScreening, "Views KPIs and rule efficacy", "HTTPS via Web Dashboard")
Rel(ComplianceAuditorOfficer, RealTimePaymentFraudScreening, "Accesses secure audit trails", "Secure Read-Only API/Console")
Rel(RealTimePaymentFraudScreening, CoreBankingLedgerSystems, "Sends asynchronous post-screening messages", "AWS SQS/SNS")

@enduml