@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("real_time_scoring_engine", "Real-Time Scoring Engine") {
    Component(rule_evaluation_component, "Rule Evaluation Component", "Go", "Evaluates business rules against incoming authorization traffic.")
    Component(feature_aggregator_component, "Feature Aggregator Component", "Go", "Aggregates features and velocity counters for real-time scoring.")
    Component(model_rule_registry_component, "Model & Rule Registry Component", "Go", "Downloads immutable rules and model weights from Amazon S3.")
    Component(explainability_engine_component, "Explainability Engine Component", "Go", "Provides explainability for risk decisions.")
    Component(audit_trail_emitter, "Audit Trail Emitter", "Go", "Pushes cryptographically signed decision payloads to Amazon SQS.")
}

System_Ext(amazon_s3, "Amazon S3", "Stores versioned machine learning models and fraud rules.")
System_Ext(amazon_sqs, "Amazon SQS", "Queue for decision payloads.")

Rel(rule_evaluation_component, feature_aggregator_component, "Retrieves velocity counters and features", "")
Rel(model_rule_registry_component, amazon_s3, "Downloads immutable rules and model weights", "HTTPS")
Rel(audit_trail_emitter, amazon_sqs, "Pushes cryptographically signed decision payloads", "AWS SDK/SQS API")

@enduml