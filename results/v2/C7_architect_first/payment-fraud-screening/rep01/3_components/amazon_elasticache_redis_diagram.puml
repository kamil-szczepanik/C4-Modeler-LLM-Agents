@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_elasticache_redis, "Amazon ElastiCache (Redis)") {
    Component(feature_store_engine_redis_oss, "Feature Store Engine (Redis OSS)", "Amazon ElastiCache (Redis) / cache.m6g", "In-memory key-value store holding pre-computed user/device velocity metrics.")
    Component(replication_manager, "Replication Manager", "Redis Cluster & Multi-AZ", "Handles asynchronous replication across Multi-AZ nodes for high availability.")
    Component(write_through_ingestion_handler, "Write-Through Ingestion Handler", "Redis Handler", "Manages asynchronous updates to feature states without blocking scoring.")
}

Rel(write_through_ingestion_handler, feature_store_engine_redis_oss, "Updates feature states", "Internal")
Rel(replication_manager, feature_store_engine_redis_oss, "Synchronizes data across Multi-AZ nodes", "Internal")

@enduml