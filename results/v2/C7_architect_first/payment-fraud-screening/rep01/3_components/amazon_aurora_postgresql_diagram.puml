@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_aurora_postgresql, "Amazon Aurora PostgreSQL") {
    Component(Relational_Storage_Engine, "Relational Storage Engine", "PostgreSQL Database Engine", "Stores active case management data, transaction history, and fraud investigation records.")
}

Rel(Relational_Storage_Engine, Amazon_RDS_Proxy, "Accepts connection pools and queries", "PostgreSQL wire protocol over TLS 1.3")

@enduml