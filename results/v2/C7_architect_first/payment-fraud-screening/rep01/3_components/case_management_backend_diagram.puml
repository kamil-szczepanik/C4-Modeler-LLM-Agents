@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalystMerchantRiskManager, "Fraud Analyst / Merchant Risk Manager", "External actor who reviews cases and monitors metrics via HTTPS with mTLS and OAuth2/OIDC.")

System_Ext(AmazonSQS, "Amazon SQS", "Messaging service for asynchronous event ingestion with a Dead Letter Queue.")
System_Ext(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL", "Relational database for persisting case records and metadata.")
System_Ext(AmazonS3, "Amazon S3", "Object storage with Object Lock for 7-year tamper-evident audit logging.")

Container_Boundary(CaseManagementBackend, "Case Management Backend") {
    Component(APIControllerComponent, "API Controller Component", "TypeScript/Node.js or Go", "RESTful interface handling authentication, RBAC, input validation, and bulk case operations over HTTPS.")
    Component(CaseWorkflowEngineComponent, "Case Workflow Engine Component", "TypeScript/Node.js or Go", "Manages case states (Open, Under Review, Resolved) and bulk resolution logic.")
    Component(EventConsumerComponent, "Event Consumer Component", "TypeScript/Node.js or Go", "Subscribes to Amazon SQS to ingest flagged transaction payloads and hydrate case records.")
    Component(AuditLoggerComponent, "Audit Logger Component", "TypeScript/Node.js or Go", "Streams immutable records to S3 Object Lock (Compliance Mode) and maintains an indexed metadata view in Amazon Aurora PostgreSQL.")
    Component(SLAMetricsComponent, "SLA Metrics Component", "TypeScript/Node.js or Go", "Calculates time-to-decision metrics for compliance and operational tracking.")
    Component(RDSProxy, "RDS Proxy", "AWS RDS Proxy", "Manages database connection pooling between ECS Fargate tasks and Amazon Aurora PostgreSQL.")
}

Rel(FraudAnalystMerchantRiskManager, APIControllerComponent, "Reviews cases and monitors metrics", "HTTPS / mTLS / OAuth2/OIDC")
Rel(EventConsumerComponent, AmazonSQS, "Consumes transaction messages", "AWS SDK / SQS API")
Rel(CaseWorkflowEngineComponent, RDSProxy, "Persists case records and SLA metrics", "RDS Proxy / mTLS / AWS IAM")
Rel(AuditLoggerComponent, AmazonS3, "Stores tamper-evident logs", "AWS SDK / S3 API / Object Lock")
Rel(RDSProxy, AmazonAuroraPostgreSQL, "Proxies connections to database", "Database Protocol")

@enduml