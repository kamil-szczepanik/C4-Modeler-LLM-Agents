@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Real_Time_Scoring_Engine, "Real-Time Scoring Engine", "Go / Java, AWS ECS Fargate", "Sends asynchronous telemetry and audit events")
System_Ext(Case_Management_Backend, "Case Management Backend", "AWS ECS Fargate", "Consumes messages via Long Polling and DeleteMessage")

Container_Boundary(amazon_sqs, "Amazon SQS") {
    Component(Standard_Queue, "Standard Queue", "Amazon SQS Standard Queue", "Buffers asynchronous telemetry and audit events sent by the Real-Time Scoring Engine.")
    Component(Dead_Letter_Queue, "Dead-Letter Queue", "Amazon SQS DLQ", "Captures messages that fail processing for later analysis and error handling.")
}

Rel(Real_Time_Scoring_Engine, Standard_Queue, "Sends asynchronous telemetry and audit events", "AWS SDK/SQS API via Interface VPC Endpoint")
Rel(Standard_Queue, Case_Management_Backend, "Consumes messages via Long Polling and DeleteMessage", "AWS SDK/SQS API via Interface VPC Endpoint")
Rel(Standard_Queue, Dead_Letter_Queue, "Routes failed messages upon processing exhaustion", "Internal SQS Redrive")
@enduml