@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS API Gateway container

Person(PaymentGateway, "Payment Gateway / Acquirer Systems", "External system")

System_Boundary(aws_api_gateway, "AWS API Gateway") {
    Component(HTTPAPIRouteResolver, "HTTP API Route Resolver", "Amazon API Gateway (HTTP APIs)", "Terminates TLS 1.3, enforces native JSON schema validation, and routes validated authorization traffic.")
    Component(EdgeRateLimiterWAF, "Edge Rate Limiter & WAF", "AWS WAF", "Mitigates DDoS attacks, enforces rate limits, and inspects incoming payloads for malicious traffic.")
}

Component(RealTimeScoringEngine, "Real-Time Scoring Engine", "AWS ECS Fargate", "Downstream scoring engine")

Rel(PaymentGateway, HTTPAPIRouteResolver, "Sends payment authorization requests", "HTTPS/REST")
Rel(HTTPAPIRouteResolver, RealTimeScoringEngine, "Routes validated authorization traffic", "gRPC with mTLS via VPC Private Link")
Rel(HTTPAPIRouteResolver, EdgeRateLimiterWAF, "Inspects incoming payloads for malicious traffic", "Internal AWS Integration")

@enduml