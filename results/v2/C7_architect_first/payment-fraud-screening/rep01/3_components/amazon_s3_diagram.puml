@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(RealTimeScoringEngine, "Real-Time Scoring Engine", "Writes decision audit payloads via HTTPS/TLS 1.3.")
Person(ComplianceOfficer, "Compliance Officer", "External persona querying reporting and audit logs.")
Person(MerchantRiskManager, "Merchant Risk Manager", "External persona querying reporting and audit logs.")
Person(DevOpsSpecialist, "DevOps Specialist", "Manages automated tiering policies via Terraform.")

Container_Boundary(AmazonS3, "Amazon S3") {
    Component(BucketPolicyEnforcer, "Bucket Policy Enforcer", "IAM / AWS Lake Formation", "Manages fine-grained access control and IAM conditions.")
    Component(ObjectLockVaultManager, "Object Lock & Vault Manager", "S3 Object Lock", "Enforces Write-Once-Read-Many (WORM) compliance in Compliance Mode.")
    Component(ServerSideEncryptionEngine, "Server-Side Encryption Engine", "AWS KMS", "Applies envelope encryption using customer-managed keys (CMK).")
    Component(S3LifecycleEngine, "S3 Lifecycle Engine", "AWS S3 Lifecycle", "Manages automated tiering from Standard to S3 Glacier Deep Archive.")
    Component(AthenaQueryGateway, "Athena Query Gateway", "Amazon Athena", "Executes sanitized queries over partitioned audit data.")
}

Rel(RealTimeScoringEngine, ObjectLockVaultManager, "Writes decision audit payloads via AWS SDK", "HTTPS/TLS 1.3")
Rel(ComplianceOfficer, BucketPolicyEnforcer, "Queries archived audit logs via AWS Management Console / Athena", "HTTPS")
Rel(MerchantRiskManager, AthenaQueryGateway, "Queries pseudonymized fraud trends via BI tools", "HTTPS")
Rel(AthenaQueryGateway, ObjectLockVaultManager, "Reads parquet-formatted audit partitions", "internal AWS backbone")
Rel(DevOpsSpecialist, S3LifecycleEngine, "Manages automated tiering policies", "Terraform (IaC)")

@enduml