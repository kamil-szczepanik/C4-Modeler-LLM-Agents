@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Real-Time Payment Fraud Screening Platform

Person(FraudAnalyst, "Fraud Analyst", "Internal user reviewing suspicious cases and monitoring metrics.")
Person(FraudOperationsManager, "Fraud Operations Manager", "Internal user reviewing suspicious cases and monitoring metrics.")
Person(RiskRuleAuthor, "Risk Rule Author", "Internal user managing fraud models.")
Person(DataScientist, "Data Scientist", "Internal user managing fraud models.")
Person(RegulatoryComplianceAuditor, "Regulatory / Compliance Auditor", "External actor reviewing audit logs.")

System_Ext(PaymentGatewayAcquirer, "Payment Gateway / Acquirer", "External actor sending authorization requests.")
System_Ext(AWSS3ObjectLock, "AWS S3 Object Lock", "Cloud storage providing tamper-evident audit logging.")
System_Ext(ModelRegistry, "Model Registry", "Repository for secure model retrieval.")

System_Boundary(RealTimePaymentFraudScreeningPlatform, "Real-Time Payment Fraud Screening Platform") {
    Container(LowLatencyScoringEngine, "Low-Latency Scoring Engine", "AWS ECS on EC2", "Container handling real-time authorization scoring.")
    Container(CaseManagementPortal, "Case Management Portal", "Web-based Portal with OAuth2/OIDC", "Container handling analyst reviews and reporting.")
    Container(AWSInfrastructure, "AWS Infrastructure", "AWS (ECS, EC2, S3, Secrets Manager, IAM)", "Cloud provider hosting ECS, EC2, S3, and Secrets Manager.")
}

Rel(PaymentGatewayAcquirer, LowLatencyScoringEngine, "Sends authorization requests", "REST/gRpC over mTLS (TLS 1.3)")
Rel(FraudAnalyst, CaseManagementPortal, "Reviews suspicious cases and monitors metrics", "HTTPS over TLS 1.3 with OAuth2/OIDC")
Rel(FraudOperationsManager, CaseManagementPortal, "Reviews suspicious cases and monitors metrics", "HTTPS over TLS 1.3 with OAuth2/OIDC")
Rel(RiskRuleAuthor, CaseManagementPortal, "Manages fraud models", "HTTPS over TLS 1.3 with OAuth2/OIDC")
Rel(DataScientist, CaseManagementPortal, "Manages fraud models", "HTTPS over TLS 1.3 with OAuth2/OIDC")
Rel(RegulatoryComplianceAuditor, CaseManagementPortal, "Reviews audit logs", "HTTPS over TLS 1.3")
Rel(LowLatencyScoringEngine, AWSS3ObjectLock, "Tamper-evident audit logging", "AWS SDK")
Rel(LowLatencyScoringEngine, ModelRegistry, "Secure model retrieval", "HTTPS with digital signature verification")

@enduml