@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalystOperationsManager, "Fraud Analyst / Operations Manager", "External user reviewing fraud cases and managing queues.")

Container_Boundary(CaseManagementAPIUI, "Case Management API & UI") {
    Component(APIGatewayRouter, "API Gateway / Router", "Go", "Routes API requests and WebSocket streams for real-time fraud case review and queue management.")
    Component(CaseHandlerService, "Case Handler Service", "Go", "Handles business logic for case management and consumes review queues.")
    Component(AuditComplianceLogger, "Audit & Compliance Logger", "Go", "Writes HMAC-SHA256 signed audit logs ensuring PCI-DSS compliance and long-term regulatory auditability.")
    Component(FraudAnalystSPA, "Fraud Analyst SPA", "React, AWS S3, CloudFront", "Frontend Single Page Application providing fraud case review capabilities for analysts.")
    Component(AmazonSQS, "Amazon SQS", "Amazon SQS", "Reliable asynchronous message queuing for review cases.")
    Component(AWSECSFargate, "AWS ECS Fargate", "AWS ECS Fargate", "Serverless container execution minimizing operational overhead.")
    Component(AWSS3ObjectLock, "AWS S3 Object Lock", "S3 Object Lock", "Tamper-evident 7-year retention storage for compliance audits.")
}

Rel(FraudAnalystOperationsManager, APIGatewayRouter, "Reviews cases and monitors queues", "HTTPS / WebSockets")
Rel(APIGatewayRouter, CaseHandlerService, "Routes API requests and WebSocket streams", "Internal gRPC/REST")
Rel(CaseHandlerService, AmazonSQS, "Consumes review queues", "SQS Message Polling")
Rel(AuditComplianceLogger, AWSS3ObjectLock, "Writes HMAC-SHA256 signed audit logs", "HTTPS / S3 API")
@enduml