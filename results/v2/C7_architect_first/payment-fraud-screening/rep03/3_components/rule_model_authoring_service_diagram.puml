@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(rule_model_authoring_service, "Rule/Model Authoring Service") {
    Component(Rule_Authoring_Controller, "Rule Authoring Controller", "Spring Boot / Java REST API", "Manages, validates, and securely publishes fraud detection rules and ONNX scoring models; reads/writes draft rules and triggers dry-runs.")
    Component(Drools_Rule_Engine_DRL_Compiler, "Drools Rule Engine / DRL Compiler", "Drools / Java", "Rule validation component for checking rule syntax and logic.")
    Component(Model_Validation_Service, "Model Validation Service", "Worker / Java", "Performs security scanning and constraint validation on models.")
    Component(Simulation_Worker, "Simulation Worker", "AWS Lambda", "Handles serverless dry-run testing and simulations.")
}

System_Ext(Authoring_Database, "Authoring Database", "Amazon DynamoDB with Point-in-Time Recovery")
System_Ext(Amazon_SQS, "Amazon SQS", "Message broker for rule publishing and simulation triggers")
System_Ext(Amazon_S3, "Amazon S3", "Historical sample data storage")

Rel(Rule_Authoring_Controller, Authoring_Database, "Reads/Writes draft rules", "AWS SDK (HTTPS)")
Rel(Rule_Authoring_Controller, Simulation_Worker, "Triggers dry-runs", "Amazon SQS")
Rel(Rule_Authoring_Controller, Amazon_SQS, "Publishes cryptographically signed rule/model packages", "AWS SDK (SQS)")
Rel(Simulation_Worker, Amazon_S3, "Accesses historical sample data", "HTTPS")
@enduml