@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Fraud Scoring Engine container

Container_Boundary(fraud_scoring_engine, "Fraud Scoring Engine") {
    Component(api_handler, "API Handler Component", "Spring WebFlux / Netty", "Screens card-not-present payment authorizations for fraud, providing real-time decisions.")
    Component(feature_enriched, "Feature Enriched Component", "Embedded Caffeine cache and Redis client", "Delivers high-performance in-memory feature caching and velocity counting.")
    Component(inference_engine, "Inference Engine Component", "Embedded ONNX Runtime with Java bindings", "Provides embedded machine learning model inference to meet the sub-50ms latency constraint.")
    Component(explainability_formatter, "Explainability Formatter Component", "Java", "Formats explainable auditability and output data.")
    Component(circuit_breaker, "Circuit Breaker & Fallback Component", "Resilience4j", "Implements circuit breaking for fault tolerance and R-07 fail-open compliance.")
    Component(audit_logger, "Audit Logger Component", "SHA-256 hashing", "Generates cryptographic hashing for tamper-evident audit logs ensuring PCI-DSS compliance.")
}

Rel(api_handler, circuit_breaker, "Manages execution flow", "Direct method call")
Rel(feature_enriched, inference_engine, "Passes tensor features", "Direct memory transfer")
Rel(inference_engine, explainability_formatter, "Passes raw tensors", "Direct memory transfer")
Rel(inference_engine, audit_logger, "Emits decision record", "Blocking queue")

@enduml