@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_sqs, "Amazon SQS") {
    Component(Amazon_SQS_Ingestion_Interface, "Amazon SQS Ingestion Interface", "Amazon SQS Standard Queue with HTTPS (TLS 1.3, SigV4)", "Receives asynchronous case messages from the Fraud Scoring Engine.")
    Component(Amazon_SQS_Polling_Dispatcher, "Amazon SQS Polling & Dispatcher", "AWS SDK / Polling & Dispatcher", "Delivers asynchronous cases via HTTPS Long-Polling to the Case Management API & UI.")
}

Rel(Amazon_SQS_Ingestion_Interface, Amazon_SQS_Polling_Dispatcher, "Buffers and routes asynchronous case messages", "")
@enduml