@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS ALB container

System_Ext(Payment_Gateway, "Payment Gateway", "External Gateway", "Sends ingress traffic to the AWS ALB.")
System_Ext(Fraud_Scoring_Engine, "Fraud Scoring Engine", "Microservice", "Receives sanitized traffic from AWS ALB via internal TLS 1.3.")

Container_Boundary(AWS_ALB, "AWS ALB") {
    Component(AWS_ALB_Native_Listener_with_ACM, "AWS ALB Native Listener with ACM", "AWS ALB Native Listener, ACM, AWS Private CA", "Terminates TLS 1.3 and enforces mTLS via AWS Private CA.")
    Component(AWS_WAF, "AWS WAF", "AWS WAF", "Provides L7 threat inspection, DDoS protection, and rate-limiting.")
    Component(AWS_ALB_Target_Groups, "AWS ALB Target Groups", "AWS ALB Target Groups", "Handles path-based routing, connection draining, and circuit-breaker health checks.")
    Component(S3_Bucket_with_Object_Lock, "S3 Bucket with Object Lock", "Amazon S3 Object Lock", "Stores immutable ALB access logs for compliance.")
}

Rel(Payment_Gateway, AWS_ALB_Native_Listener_with_ACM, "Ingress traffic via HTTPS / TLS 1.3 with mTLS", "mTLS/HTTPS")
Rel(AWS_ALB_Native_Listener_with_ACM, AWS_WAF, "Inspects decrypted L7 payloads", "Internal")
Rel(AWS_ALB_Target_Groups, Fraud_Scoring_Engine, "Forwards sanitized traffic with internal TLS 1.3", "HTTP/2 over gRPC")
Rel(AWS_ALB_Native_Listener_with_ACM, S3_Bucket_with_Object_Lock, "Streams access logs for auditability", "HTTPS")

@enduml