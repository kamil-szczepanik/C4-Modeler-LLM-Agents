@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Database container

Container_Boundary(claims_database, "Claims Database") {
    Component(Claim Core Store, "Claim Core Store", "Azure SQL Database with Temporal Tables and Row-Level Security", "Relational storage providing Transparent Data Encryption, Column-Level Encryption, and Dynamic Data Masking for PII security.")
    Component(Migration Sync Staging, "Migration Sync Staging", "Azure SQL Staging Tables", "Staging tables used for batch synchronization during hybrid cloud migration.")
}

Component(Data Access Layer, "Data Access Layer", "Entity Framework Core libraries", "ORM for data access and automated migration down-scripts supporting rapid rollbacks")

Rel(Data Access Layer, Claim Core Store, "Executes queries and transactions", "TDS / SQL")
Rel(Data Access Layer, Migration Sync Staging, "Executes queries and transactions", "TDS / SQL")

@enduml