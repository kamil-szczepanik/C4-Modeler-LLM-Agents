@startuml
!include https://raw.githubusercontent.eno/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration & Anti-Corruption Layer container

Container_Boundary(integration_layer, "Integration & Anti-Corruption Layer") {
    Component(Mainframe_Translation_Adapter, "Mainframe Translation Adapter", ".NET 8 / Azure Functions", "Translates payloads between modern cloud formats and legacy systems, interacting with the mainframe via mTLS.")
    Component(Batch_Window_Throttler, "Batch Window Throttler", "Azure Service Bus", "Queues and throttles messages to respect the strict nightly batch window.")
    Component(Dual_Write_Router, "Dual-Write Router", ".NET Core / Azure Functions with Durable Functions", "Orchestrates dual-write synchronization, protocol translation, and state routing.")
    Component(Claim_Provenance_Audit_Registry, "Claim Provenance & Audit Registry", "Azure Cosmos DB / Redis / Azure Table Storage", "Maintains real-time claim provenance and routing state for rapid fallback.")
}

Component(Claims_Processing_Service, "Claims Processing Service", ".NET Core / Azure Container Apps", "Processes claims logic within the hybrid Azure cloud platform.")
System_Ext(Mainframe_Claims_System, "Mainframe Claims System", "COBOL / DB2", "Legacy regional insurer mainframe claims system.")

Rel(Claims_Processing_Service, Dual_Write_Router, "gRPC", "gRPC")
Rel(Dual_Write_Router, Claim_Provenance_Audit_Registry, "gRPC / Low-latency read-write", "gRPC / Low-latency read-write")
Rel(Mainframe_Translation_Adapter, Claim_Provenance_Audit_Registry, "gRPC", "gRPC")
Rel(Mainframe_Translation_Adapter, Mainframe_Claims_System, "mTLS / TCP via ExpressRoute", "mTLS / TCP via ExpressRoute")

@enduml