@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(EmergencyOperators, "Emergency Operators", "Human / External", "Operators who trigger instant claim-type fallback during emergencies.")

System_Ext(APIGatewayBFF, "API Gateway / BFF", ".NET Core", "Evaluates feature flags and retrieves endpoint routing maps.")

Container_Boundary(ConfigurationFeatureStore, "Configuration & Feature Store") {
    Component(FeatureFlagManager, "Feature Flag Manager", "Azure App Configuration Feature Management", "Manages dynamic feature flags for gradual claim type migration and toggling.")
    Component(DynamicRoutingStore, "Dynamic Routing Store", "Azure App Configuration KV-sets", "Stores endpoint routing maps for navigation between legacy mainframe and the new cloud platform.")
    Component(GitOpsDeploymentPipeline, "GitOps Deployment Pipeline", "Bicep/Terraform with automated JSON schema validation", "Ensures all routing changes and feature toggles are version-controlled, validated, and automatically synced.")
    Component(BreakGlassWorkflow, "Break-Glass Workflow", "Automated emergency PR mechanism", "Triggers rapid rollbacks and instant claim-type fallback during emergencies.")
}

Rel(APIGatewayBFF, FeatureFlagManager, "Evaluates feature flags", "HTTPS / Azure SDK, polling/push via Event Grid")
Rel(APIGatewayBFF, DynamicRoutingStore, "Retrieves endpoint routing maps", "HTTPS / Azure SDK")
Rel(EmergencyOperators, BreakGlassWorkflow, "Triggers instant claim-type fallback", "HTTPS")

@enduml