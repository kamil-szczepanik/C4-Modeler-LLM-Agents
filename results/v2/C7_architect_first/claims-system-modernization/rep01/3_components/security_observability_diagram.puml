@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Security & Observability container

Container_Boundary(sec_obs, "Security & Observability") {
    Component(Token Validator Component, "Token Validator Component", ".NET Core Middleware, OpenID Connect", "Validates security tokens and integrates with identity providers.")
    Component(Secret Manager Client, "Secret Manager Client", "Managed Identities, Azure Key Vault", "Manages secure access to secrets and credentials.")
    Component(Telemetry Aggregator, "Telemetry Aggregator", "OpenTelemetry SDK, gRPC, Azure Monitor", "Collects and aggregates distributed tracing and metrics.")
    Component(Audit Logger Component, "Audit Logger Component", ".NET Core library, Azure Log Analytics", "Provides immutable audit logging for compliance and tracking.")
    Component(mTLS Termination Proxy, "mTLS Termination Proxy", "Azure Container Apps Ingress", "Handles mTLS termination for secure hybrid communication.")
    Component(Automated Rotation Service, "Automated Rotation Service", "Azure Event Grid, Azure Functions", "Automates the rotation of credentials and secrets.")
}

System_Ext(Azure AD (Entra ID), "Azure AD (Entra ID)", "External Identity Provider")
System_Ext(Azure Key Vault, "Azure Key Vault", "External Secret Management Service")
System_Ext(Azure Monitor, "Azure Monitor", "External Monitoring and Observability Service")
System_Ext(On-Premise Mainframe, "On-Premise Mainframe", "External On-Premise Legacy System")

Rel(Token Validator Component, Azure AD (Entra ID), "OpenID Connect / HTTPS", "HTTPS")
Rel(Secret Manager Client, Azure Key Vault, "Managed Identities / HTTPS / REST", "HTTPS/REST")
Rel(Telemetry Aggregator, Azure Monitor, "gRPC / OpenTelemetry", "gRPC")
Rel(mTLS Termination Proxy, On-Premise Mainframe, "mTLS / HTTPS", "mTLS/HTTPS")

@enduml