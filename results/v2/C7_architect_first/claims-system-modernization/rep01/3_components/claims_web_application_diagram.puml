@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Web Application container

Container_Boundary(claims_web_app, "Claims Web Application") {
    Component(RoutingShellComponent, "Routing & Shell Component", "React Router, WCAG 2.1 AA", "Provides layout structure, navigation, and ensures accessibility standards.")
    Component(AuthenticationClientComponent, "Authentication Client Component", "MSAL.js, memory-only token storage", "Handles user authentication and maintains security via memory-only token storage.")
    Component(ClaimSubmissionFeatureComponent, "Claim Submission Feature Component", "React Hook Form, Zod, local storage persistence", "Manages multi-step claim submissions with client-side validation and local storage resilience.")
    Component(AdjusterWorkspaceComponent, "Adjuster Workspace Component", "TanStack Query", "Delivers adjuster dashboard interfaces leveraging aggressive caching to maintain <2s screen loads.")
    Component(ApiClientComponent, "API Client Component", "Axios, Application Insights integration", "Centralized HTTP client managing communication with the BFF and streaming telemetry.")
}

System_Ext(AzureMonitorApplicationInsights, "Azure Monitor / Application Insights", "Telemetry monitoring and logging system.")

Rel(RoutingShellComponent, AuthenticationClientComponent, "Validates user session and access permissions")
Rel(RoutingShellComponent, ClaimSubmissionFeatureComponent, "Renders submission view")
Rel(RoutingShellComponent, AdjusterWorkspaceComponent, "Renders adjuster workspace view")
Rel(ClaimSubmissionFeatureComponent, ApiClientComponent, "Sends claim payloads", "HTTPS")
Rel(AdjusterWorkspaceComponent, ApiClientComponent, "Fetches claim data", "HTTPS")
Rel(ApiClientComponent, AzureMonitorApplicationInsights, "Streams telemetry", "HTTPS")

@enduml