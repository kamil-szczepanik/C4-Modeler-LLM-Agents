@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Processing Service container

Container_Boundary("Claims Processing Service", "Claims Processing Service") {
    Component(Claims Orchestrator, "Claims Orchestrator", ".NET/C#", "State machine managing claim lifecycles and idempotency.")
    Component(Claim Type Adapter, "Claim Type Adapter", ".NET/C# (Strategy Pattern)", "Strategy-pattern implementation for isolated feature toggling and rapid rollbacks.")
    Component(Validation & Rules Engine, "Validation & Rules Engine", ".NET/C#", "Evaluates business logic locally before persistence.")
    Component(Idempotency & Outbox Processor, "Idempotency & Outbox Processor", ".NET/C#", "Ensures exactly-once processing and handles circuit breaking during batch windows.")
    Component(Audit Logging Component, "Audit Logging Component", ".NET/C# / Azure SQL Ledger", "Captures immutable business events using Azure SQL Ledger.")
    ComponentDb(Claims Database, "Claims Database", "Azure SQL / Entity Framework Core", "Primary database offering tamper-evident audit logs and persistence.")
}

Rel(Claims Orchestrator, Claim Type Adapter, "Invokes type-specific workflows", "In-process C# Interfaces")
Rel(Claim Type Adapter, Claims Database, "Persists state changes", "Entity Framework Core [TDS / SQL]")
Rel(Claims Orchestrator, Idempotency & Outbox Processor, "Persists outbox messages transactionally", "In-process / C#")
Rel(Claims Orchestrator, Audit Logging Component, "Emits audit trails", "In-process / C#")
Rel(Idempotency & Outbox Processor, Claims Database, "Stores deduplication keys", "TDS / SQL")

@enduml