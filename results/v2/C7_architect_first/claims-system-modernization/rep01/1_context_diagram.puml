@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "End-users who submit claims via the modern web applications.")
Person(Broker, "Broker", "Intermediaries who assist in managing and submitting claims.")
Person(ClaimsAdjuster, "Claims Adjuster", "Internal staff who utilize the adjuster workflows with asynchronous caching for fast load times.")

System(ModernClaimsPlatform, "Modern Claims Platform", "A hybrid cloud platform built on Azure that modernizes customer submissions and adjuster workflows while integrating with a legacy mainframe system of record.")

System_Ext(MainframeClaimsSystem, "Mainframe Claims System", "30-year-old on-premise legacy system (IBM z/OS, COBOL, DB2) acting as the system of record.")
System_Ext(CorporateActiveDirectory, "Corporate Active Directory", "Directory service used for user authentication via OIDC and OAuth2.")
System_Ext(ExternalPaymentGateway, "External Payment Gateway", "Third-party service utilized for automated claim payouts.")

Rel(Customer, ModernClaimsPlatform, "Interacts with the platform for claim submissions", "HTTPS / TLS 1.3")
Rel(Broker, ModernClaimsPlatform, "Interacts with the platform for claim submissions and management", "HTTPS / TLS 1.3")
Rel(ClaimsAdjuster, ModernClaimsPlatform, "Utilizes the web application with asynchronous caching", "HTTPS / TLS 1.3")
Rel(ModernClaimsPlatform, MainframeClaimsSystem, "Synchronizes data and decouples traffic via hybrid integration", "Azure Service Bus, ExpressRoute, mTLS, IPsec VPN")
Rel(ModernClaimsPlatform, CorporateActiveDirectory, "Authenticates users", "OIDC / OAuth2")
Rel(ModernClaimsPlatform, ExternalPaymentGateway, "Integrates for automated claim payouts", "HTTPS / REST API")

@enduml