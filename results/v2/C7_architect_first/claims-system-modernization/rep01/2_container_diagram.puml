@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Modern Claims Platform

Person(Customer, "Customer", "End-users who submit claims via the modern web applications.")
Person(Broker, "Broker", "Intermediaries who assist in managing and submitting claims.")
Person(Claims Adjuster, "Claims Adjuster", "Internal staff who utilize the adjuster workflows with asynchronous caching for fast load times.")

System_Ext(Mainframe Claims System, "Mainframe Claims System", "30-year-old on-premise legacy system (IBM z/OS, COBOL, DB2) acting as the system of record.")
System_Ext(Corporate Active Directory, "Corporate Active Directory", "Directory service used for user authentication via OIDC and OAuth2.")
System_Ext(External Payment Gateway, "External Payment Gateway", "Third-party service utilized for automated claim payouts.")

System_Boundary(Modern Claims Platform, "Modern Claims Platform") {
    Container(Claims Web Application, "Claims Web Application", "Azure Static Web Apps, React, TypeScript", "Frontend application providing fast client-side rendering for customer submissions and adjuster workflows.")
    Container(API Gateway / BFF, "API Gateway / BFF", ".NET Core", "Backend-for-Frontend managing routing, authentication, and communication with backend services.")
    Container(Claims Processing Service, "Claims Processing Service", ".NET Core, Azure Container Apps", "Scalable business logic service for processing insurance claims.")
    Container(Integration & Anti-Corruption Layer, "Integration & Anti-Corruption Layer", "Azure Functions, Azure Service Bus", "Asynchronous hybrid synchronization layer decoupling modern platform from the legacy mainframe.")
    ContainerDb(Claims Database, "Claims Database", "Azure SQL, Transparent Data Encryption (TDE)", "Structured claim data store.")
    Container(Configuration & Feature Store, "Configuration & Feature Store", "Azure App Configuration", "Dynamic feature flagging and routing configuration.")
    Container(Security & Observability, "Security & Observability", "Azure Key Vault, Azure Monitor, Azure WAF, Azure Active Directory (Entra ID)", "Robust protection, secret management, and monitoring.")
}

Rel(Customer, Claims Web Application, "Interacts with the web application for claim submissions", "HTTPS / JSON")
Rel(Broker, Claims Web Application, "Interacts with the web application for claim submissions and management", "HTTPS / JSON")
Rel(Claims Adjuster, Claims Web Application, "Utilizes the adjuster workflows via the web application", "HTTPS / JSON")
Rel(Claims Web Application, API Gateway / BFF, "Sends API requests and authenticates users", "HTTPS / JSON (OIDC/JWT)")
Rel(API Gateway / BFF, Claims Processing Service, "Routes requests to business logic", "HTTPS / gRPC")
Rel(API Gateway / BFF, Configuration & Feature Store, "Fetches dynamic feature flags and routing configurations", "HTTPS / gRPC")
Rel(Claims Processing Service, Claims Database, "Reads and writes structured claim data", "TDS / SQL")
Rel(Integration & Anti-Corruption Layer, Mainframe Claims System, "Synchronizes data and handles hybrid integration fallback", "mTLS / AMQP")
Rel(API Gateway / BFF, Corporate Active Directory, "Authenticates users", "OIDC / OAuth2")
Rel(Claims Processing Service, External Payment Gateway, "Integrates for automated claim payouts", "HTTPS / REST API")

@enduml