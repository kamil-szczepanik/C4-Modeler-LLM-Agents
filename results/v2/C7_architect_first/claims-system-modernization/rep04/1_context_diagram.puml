@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Insurance Claims Modernization

Person(Customer_Broker, "Customer/Broker", "External user who submits online claims.")
Person(Claims_Adjuster, "Claims Adjuster", "Internal user who manages and processes claims using the web UI.")

System_Ext(Legacy_Mainframe, "Legacy Mainframe", "On-premise DB2/COBOL system serving as the system of record.")
System_Ext(Corporate_Active_Directory, "Corporate Active Directory", "On-premise Identity Provider (IDP) used for SSO.")

System_Boundary(c1, "Insurance Claims Modernization") {
    Container(Insurance_Claims_Platform, "Insurance Claims Platform", "Azure Cloud-Native", "Cloud-native platform handling online claims submission and adjuster workflows.")
    Container(Anti_Corruption_Layer_ACL, "Anti-Corruption Layer (ACL)", "Azure", "Decouples cloud domain models from rigid mainframe schemas.")
    Container(CQRS_Read_Model, "CQRS Read Model", "Azure", "Isolates legacy latency to ensure sub-2-second adjuster screen loads.")
    Container(API_Gateway, "API Gateway", "Azure", "Manages incoming traffic and routing for the platform.")
    Container(Azure_Service_Bus, "Azure Service Bus", "Azure Service Bus", "Handles asynchronous state synchronization using dead-letter queues.")
}

Rel(Customer_Broker, Insurance_Claims_Platform, "Online submission of claims", "HTTPS")
Rel(Claims_Adjuster, Insurance_Claims_Platform, "Web UI access for workflows", "HTTPS")
Rel(Insurance_Claims_Platform, Legacy_Mainframe, "Asynchronous state sync via batch window (23:00-05:00)", "Asynchronous Messaging/ETL over secure Site-to-Site VPN with mTLS")
Rel(Insurance_Claims_Platform, Corporate_Active_Directory, "Single Sign-On (SSO) authentication", "OIDC/SAML")

@enduml