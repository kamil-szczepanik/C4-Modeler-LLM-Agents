@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Mainframe Adapter container

System_Ext(Claims_Integration_Service, "Claims Integration Service", "Integration Service", "External service calling the Mainframe Adapter.")
System_Ext(Active_Directory, "Active Directory", "Corporate Identity Provider", "Provides corporate identity and access management.")
System_Ext(Azure_Key_Vault, "Azure Key Vault", "Azure Key Vault", "Provides dynamic credential sync via hybrid sync.")
System_Ext(Legacy_COBOL_DB2_Mainframe, "Legacy COBOL/DB2 Mainframe", "Mainframe COBOL/DB2", "The legacy core banking and claims processing mainframe.")

Container_Boundary(Mainframe_Adapter, "Mainframe Adapter") {
    Component(API_Controller, "API Controller", ".NET Core Web API", "Handles incoming REST/JSON over mTLS requests from the Claims Integration Service.")
    Component(Translation_Service, "Translation Service", ".NET Core Business Logic", "Performs in-memory data mapping and processes domain models.")
    Component(Mainframe_Connector, "Mainframe Connector", ".NET Core Infrastructure", "Communicates with the legacy mainframe via legacy protocol and DB2 over TCP/Sockets/CICS/MQ.")
    Component(Audit_Reconciliation_Logger, "Audit & Reconciliation Logger", ".NET Core State/Log Component", "Logs state and operational metrics for audit and reconciliation purposes.")
    Component(Idempotency_Manager, "Idempotency Manager", ".NET Core with Local SQLite/PostgreSQL", "Ensures idempotency and state persistence using local storage.")
}

Rel(Claims_Integration_Service, API_Controller, "REST/JSON over mTLS")
Rel(API_Controller, Translation_Service, "In-memory data mapping")
Rel(Translation_Service, Mainframe_Connector, "Processed domain models")
Rel(Mainframe_Connector, Legacy_COBOL_DB2_Mainframe, "Legacy Protocol / DB2 over TCP/Sockets/CICS/MQ")
Rel(Mainframe_Connector, Azure_Key_Vault, "Dynamic credential sync via hybrid sync")

@enduml