@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Claims Integration Service", "Claims Integration Service") {
    Component(ClaimRouterComponent, "Claim Router Component", ".NET Core", "Routes hybrid claims processing between the Azure cloud platform and the legacy mainframe.")
    Component(OutboxProcessorComponent, "Outbox Processor Component", ".NET Core", "Ensures zero-data-loss claim migration using the Transactional Outbox pattern.")
    Component(LegacyFallbackComponent, "Legacy Fallback Component", ".NET Core", "Handles fallback logic and integration paths for legacy mainframe processing.")
    Component(AuditTelemetryLoggerComponent, "Audit & Telemetry Logger Component", ".NET Core", "Records audit logs and telemetry data for compliance and system reliability.")
    Component(AzureServiceBus, "Azure Service Bus", "AMQP/AMQPS", "Reliable message broker for asynchronous event processing.")
    Component(AzureAppConfiguration, "Azure App Configuration", "HTTPS/REST", "Centralized feature flagging to support quick claim-type rollbacks.")
    Component(AzureKeyVault, "Azure Key Vault", "Managed Identities", "Secure credential management and envelope encryption.")
    Component(AzureApplicationInsights, "Azure Application Insights", "TLS 1.3", "Monitoring and telemetry with Customer-Managed Keys.")
    Component(MainframeAdapter, "Mainframe Adapter", ".NET Core API, On-Premises", "Bridges modern cloud components with the on-premise legacy mainframe.")
}

Rel(ClaimRouterComponent, LegacyFallbackComponent, "Internal C# method calls")
Rel(ClaimRouterComponent, AuditTelemetryLoggerComponent, "In-memory C# events")
Rel(OutboxProcessorComponent, AzureServiceBus, "AMQP with AMQPS / TLS 1.3")
Rel(ClaimRouterComponent, AzureAppConfiguration, "HTTPS/REST via Managed Identity")
Rel(ClaimRouterComponent, MainframeAdapter, "REST/JSON over mTLS")
Rel(ClaimRouterComponent, AzureApplicationInsights, "TLS 1.3 with Customer-Managed Keys")

@enduml