@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Key Vault container

Container_Boundary(azure_key_vault, "Azure Key Vault") {
    Component(Secrets_Management_Engine, "Secrets Management Engine", "Azure Key Vault with HSM", "Manages secure credential, secret, and certificate storage backed by Hardware Security Modules.")
    Component(Access_Control_and_Identity_Provider, "Access Control and Identity Provider", "Azure Managed Identities and Private Endpoints", "Enforces token-only authentication and secures network traffic between Azure workloads and Key Vault.")
}

Rel(Secrets_Management_Engine, Access_Control_and_Identity_Provider, "Secures access using Managed Identities and Private Endpoints", "HTTPS / REST API")

@enduml