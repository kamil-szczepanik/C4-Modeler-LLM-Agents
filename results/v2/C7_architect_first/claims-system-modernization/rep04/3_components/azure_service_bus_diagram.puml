@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Boundary(azure_service_bus, "Azure Service Bus") {
    Component(claims_lifecycle_Topic, "claims-lifecycle Topic", "Azure Service Bus (Premium Tier, AMQP)", "Publishes claim state changes initiated by the Claims Integration Service.")
    Component(mainframe_sync_queue, "mainframe-sync-queue", "Azure Service Bus (Premium Tier, AMQP)", "Dispatches queued legacy transactions to the Mainframe Adapter.")
}

Rel(Claims Integration Service, claims_lifecycle_Topic, "Publishes claim state changes", "AMQP")
Rel(mainframe_sync_queue, Mainframe Adapter, "Dispatches queued legacy transactions", "AMQP")

@enduml