@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Customer_Broker, "Customer / Broker", "Human / External User", "End user accessing the web interface.")

System_Ext(Microsoft_Entra_ID, "Microsoft Entra ID", "Microsoft Entra ID", "Identity provider for OIDC authentication.")
System_Ext(Azure_API_Management, "Azure API Management", "Azure API Management", "API gateway managing secure HTTPS/REST communication.")

System_Boundary(Customer_Portal, "Customer Portal") {
    Component(Authentication_Controller, "Authentication Controller", "React Router / OIDC client library", "Handles user authentication via OpenID Connect.")
    Component(Claim_Submission_Form, "Claim Submission Form", "React Component", "Provides the interface for submitting online claims.")
    Component(Claim_Status_Viewer, "Claim Status Viewer", "React Component with Broker Workspace View", "Displays claim status and includes a broker workspace view.")
    Component(Draft_Management_Component, "Draft Management Component", "React / Encrypted IndexedDB", "Manages secure local offline draft persistence.")
    Component(API_Gateway_Client, "API Gateway Client", "TypeScript / Axios", "Communicates securely with the API Gateway.")
    Component(Application_Insights_Frontend_SDK, "Application Insights Frontend SDK", "Azure Application Insights SDK", "Provides Real User Monitoring (RUM) and synthetic testing.")
    Component(Azure_Static_Web_Apps, "Azure Static Web Apps", "Azure Static Web Apps", "Serverless hosting platform for the React single-page application.")
}

Rel(Customer_Broker, Customer_Portal, "Accesses web interface", "HTTPS/REST")
Rel(Authentication_Controller, Microsoft_Entra_ID, "Authenticates users", "OpenID Connect (OIDC)")
Rel(Claim_Submission_Form, API_Gateway_Client, "Sends/retrieves data locally", "")
Rel(Claim_Status_Viewer, API_Gateway_Client, "Sends/retrieves data locally", "")
Rel(Draft_Management_Component, API_Gateway_Client, "Sends/retrieves data locally", "")
Rel(API_Gateway_Client, Azure_API_Management, "Communicates securely", "HTTPS/REST")

@enduml