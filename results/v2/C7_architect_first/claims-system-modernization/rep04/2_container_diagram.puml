@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Insurance Claims Modernization

Person(Customer_Broker, "Customer/Broker", "External user who submits and views online insurance claims.")
Person(Claims_Adjuster, "Claims Adjuster", "Internal user who manages and processes claims using the adjuster workspace.")

System_Ext(Legacy_COBOL_DB2_Mainframe, "Legacy COBOL/DB2 Mainframe", "30-year-old on-premise mainframe system acting as the core system of record.")
System_Ext(Corporate_Active_Directory_Microsoft_Entra_ID, "Corporate Active Directory / Microsoft Entra ID", "Identity Provider used for user authentication and Single Sign-On.")

System_Boundary(Insurance_Claims_Modernization, "Insurance Claims Modernization") {
    Container(Customer_Portal, "Customer Portal", "React, Azure Static Web Apps", "Modern web application providing online claims submission and viewing for customers and brokers.")
    Container(Adjuster_Workspace, "Adjuster Workspace", ".NET Core, Azure App Service", "Modern web application allowing adjusters to manage and process claims.")
    Container(Claims_Integration_Service, "Claims Integration Service", ".NET Core Worker Service, Azure Container Apps", "Backend service handling integration logic and asynchronous event processing.")
    Container(Mainframe_Adapter, "Mainframe Adapter", ".NET Core API, On-Premises", "On-premises API adapter that secures and translates communication with the legacy mainframe.")
    Container(Azure_Service_Bus, "Azure Service Bus", "Azure Service Bus (AMQP)", "Message broker providing reliable asynchronous eventing and zero data loss.")
    Container(Azure_Key_Vault, "Azure Key Vault", "Azure Key Vault with Managed Identities", "Secure storage for secrets, certificates, and configuration data.")
}

Rel(Customer_Broker, Customer_Portal, "Interacts with via web interface", "HTTPS/REST")
Rel(Claims_Adjuster, Adjuster_Workspace, "Interacts with to process claims", "HTTPS/REST")
Rel(Adjuster_Workspace, Claims_Integration_Service, "Communicates with for claims processing logic", "gRPC over HTTP/2 (with mandatory TLS)")
Rel(Claims_Integration_Service, Azure_Service_Bus, "Publishes events to message broker", "AMQP")
Rel(Claims_Integration_Service, Mainframe_Adapter, "Communicates with for mainframe integration", "REST/JSON over mTLS")
Rel(Mainframe_Adapter, Legacy_COBOL_DB2_Mainframe, "Integrates with legacy system", "Legacy Protocol / DB2")
Rel(Customer_Portal, Corporate_Active_Directory_Microsoft_Entra_ID, "Authenticates users", "OpenID Connect (OIDC)")
Rel(Adjuster_Workspace, Corporate_Active_Directory_Microsoft_Entra_ID, "Authenticates users", "OpenID Connect (OIDC)")

@enduml