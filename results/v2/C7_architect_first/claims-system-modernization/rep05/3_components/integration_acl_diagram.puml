@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration & ACL container

Container_Boundary(integration_acl, "Integration & ACL") {
    Component(ACL_Router_Circuit_Breaker_Component, "ACL Router & Circuit-Breaker Component", "Java Spring Boot, Resilience4j", "Dynamically routes traffic and protects the fragile legacy mainframe during high loads using circuit-breaking and rate-limiting.")
    Component(Data_Mapper_Sanitizer_Component, "Data Mapper & Sanitizer Component", "Java Spring Boot, MapStruct, JSON Schema/XML", "Enforces payload schema validation and PII sanitization between modern and legacy data structures.")
    Component(Outbox_Inbox_Processor_Component, "Outbox/Inbox Processor Component", "Java Spring Boot, JDBC/JPA, Azure SQL Database", "Handles reliable message processing and publishes/consumes reliable messages.")
}

Component(Claims_Processing_Service, "Claims Processing Service", "Java Spring Boot", "Sends asynchronous domain events.")
Component(Azure_Service_Bus, "Azure Service Bus", "Azure Service Bus topics, Azure Dead-Letter Queues", "Ensures durable, reliable message queuing and at-least-once delivery.")
Component(Legacy_Mainframe_System, "Legacy Mainframe System", "COBOL/DB2 Legacy Mainframe System", "The 30-year-old legacy mainframe system for insurance claims.")
Component(Azure_Key_Vault, "Azure Key Vault", "Azure Key Vault, Azure Managed Identities", "Retrieves database credentials and certificates securely.")

Rel(Claims_Processing_Service, Outbox_Inbox_Processor_Component, "Sends asynchronous domain events", "JDBC/JPA")
Rel(Outbox_Inbox_Processor_Component, Azure_Service_Bus, "Publishes and consumes reliable messages", "AMQP protocol")
Rel(ACL_Router_Circuit_Breaker_Component, Legacy_Mainframe_System, "Dynamically routes traffic and synchronizes data", "mTLS over restricted interface protocols")
Rel(Outbox_Inbox_Processor_Component, Azure_Key_Vault, "Retrieves database credentials and certificates", "Azure Managed Identities")

@enduml