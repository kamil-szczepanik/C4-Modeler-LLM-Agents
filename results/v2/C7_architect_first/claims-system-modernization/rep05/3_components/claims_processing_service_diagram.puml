@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Processing Service container

Container_Boundary(claims_processing_service, "Claims Processing Service") {
    Component(ClaimCommandHandler, "Claim Command Handler", "Spring Web/MVC, Java", "Handles claim commands, validates payload and idempotency, and triggers state transitions.")
    Component(ClaimReadServiceMaterializer, "Claim Read Service & Materializer", "Spring Data JPA, Java", "Reads denormalized views and materializes data for clients.")
    Component(WorkflowOrchestrator, "Workflow Orchestrator", "Spring State Machine, Java", "Orchestrates workflows and persists workflow state.")
    Component(ClaimPolicyValidationEngine, "Claim Policy & Validation Engine", "Spring Validation, Java", "Validates claim policies and rules.")
    Component(AzureSQLDatabase, "Azure SQL Database", "JDBC / JPA", "Relational storage for ACID compliance and workflow state persistence.")
    Component(AzureServiceBus, "Azure Service Bus", "AMQP", "Asynchronous messaging for decoupled event-driven integration.")
    Component(IntegrationACL, "Integration & ACL", "Java / Messaging Adapter", "Anti-corruption layer for external system communication.")
}

Rel(ClaimCommandHandler, ClaimPolicyValidationEngine, "Validates payload and idempotency", "In-memory / Java Method")
Rel(ClaimCommandHandler, IntegrationACL, "Publishes state changes", "Azure Service Bus / AMQP")
Rel(ClaimReadServiceMaterializer, AzureSQLDatabase, "Reads denormalized views", "JDBC")
Rel(WorkflowOrchestrator, AzureSQLDatabase, "Persists workflow state", "JPA / JDBC")
Rel(WorkflowOrchestrator, ClaimCommandHandler, "Triggers state transitions", "In-memory / Java Method")

@enduml