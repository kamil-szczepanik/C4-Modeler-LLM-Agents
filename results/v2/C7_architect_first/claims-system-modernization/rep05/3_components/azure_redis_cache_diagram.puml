@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Boundary(azure_redis_cache, "Azure Redis Cache") {
    Component(Cache_Manager, "Cache Manager", "Azure Redis Cache, Standard Tier C1", "Manages sub-second caching for adjuster screens and reference data.")
}

System(Claims_Processing_Service, "Claims Processing Service", "Java Spring Boot, JPA, Azure Container Apps")

Rel(Claims_Processing_Service, Cache_Manager, "Reads/writes cached claim states and reference data", "Redis Protocol / TCP 6380, SSL")

@enduml