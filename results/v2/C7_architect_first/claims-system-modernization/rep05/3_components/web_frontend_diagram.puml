@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Frontend container

System_Ext(insurer_active_directory, "Insurer's Active Directory", "Handles user authentication and session validation.")
System_Ext(bff_api_gateway, "BFF / API Gateway", "Proxies requests, routes traffic, and handles session cookies.")

Container_Boundary(web_frontend, "Web Frontend") {
    Component(claim_submission_ui, "Claim Submission UI", "React, TypeScript", "Allows customers and brokers to submit online claims.")
    Component(adjuster_dashboard, "Adjuster Dashboard", "React, TypeScript", "Provides workflows for claims adjusters.")
    Component(auth_client_module, "Auth Client Module", "OAuth2 / OIDC with PKCE", "Handles user authentication and session validation with the Insurer's Active Directory.")
    Component(accessibility_localization_module, "Accessibility & Localization Module", "React", "Ensures accessibility standards and localization for users.")
    Component(user_analytics_telemetry_tracking, "User Analytics & Telemetry Tracking", "Azure Application Insights", "Tracks user analytics, RUM, synthetic monitoring, and telemetry.")
}

Rel(auth_client_module, insurer_active_directory, "Authenticates users and validates sessions", "OAuth2 / OIDC with PKCE")
Rel(claim_submission_ui, bff_api_gateway, "Proxies requests, routes traffic, and handles session cookies", "HTTPS / REST")
Rel(adjuster_dashboard, bff_api_gateway, "Proxies requests, routes traffic, and handles session cookies", "HTTPS / REST")

@enduml