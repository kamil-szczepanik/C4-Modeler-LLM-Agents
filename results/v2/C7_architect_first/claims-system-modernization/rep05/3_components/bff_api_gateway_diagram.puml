@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(bff_api_gateway, "BFF / API Gateway") {
    Component(api_gateway_proxy, "API Gateway Proxy", "Azure API Management", "Handles edge routing, OAuth2/OIDC validation, and OpenAPI schema enforcement.")
    Component(customer_bff, "Customer BFF", "Java Spring Boot", "Serves customer-facing frontend requests and aggregates backend services.")
    Component(adjuster_bff, "Adjuster BFF", "Java Spring Boot", "Serves adjuster-facing frontend requests, managing UI state and claim queries.")
    Component(dynamic_routing, "Dynamic Routing & Feature Dispatcher", "Azure App Configuration", "Stores dynamic routing rules for rapid claim-type rollbacks.")
    Component(circuit_breaker, "Circuit Breaker & Fallback Manager", "Resilience4j", "Implements circuit breaking and fallback logic for slow mainframe responses.")
    Component(redis_cache, "Azure Redis Cache", "Azure Redis", "Reads UI state and cached data for the Adjuster BFF.")
}

Rel(api_gateway_proxy, customer_bff, "Forwards authenticated routes", "mTLS / HTTP")
Rel(api_gateway_proxy, adjuster_bff, "Forwards authenticated routes", "mTLS / HTTP")
Rel(adjuster_bff, redis_cache, "Reads UI state and cached data", "Redis Protocol / TLS")
Rel(adjuster_bff, circuit_breaker, "Protects outgoing calls to backend systems")
Rel(dynamic_routing, customer_bff, "Supplies dynamic routing and feature flags")
Rel(dynamic_routing, adjuster_bff, "Supplies dynamic routing and feature flags")

@enduml