@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Azure SQL Database", "Azure SQL Database") {
    Component("Claims Core Schema", "Claims Core Schema", "Azure SQL Database (Hyperscale/Serverless)", "Stores core insurance claims data and transactional information.")
    Component("Audit & Reconciliation Log Store", "Audit & Reconciliation Log Store", "Azure SQL Database", "Maintains logs for auditing and reconciliation to ensure zero data loss during migration.")
    Component("Row-Level Security Engine", "Row-Level Security Engine", "Azure SQL Database Security", "Enforces strict access control based on user roles and permissions.")
    Component("Temporal Tables", "Temporal Tables", "Azure SQL Database Temporal Features", "Tracks historical data changes automatically for auditing and compliance.")
    Component("Change Data Capture (CDC)", "Change Data Capture (CDC)", "Azure SQL Database CDC", "Captures insert, update, and delete activity applied to tables for synchronization.")
}

Rel("Claims Core Schema", "Temporal Tables", "Tracks history using", "")
Rel("Claims Core Schema", "Change Data Capture (CDC)", "Publishes changes via", "")
@enduml