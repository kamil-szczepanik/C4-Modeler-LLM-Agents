@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Insurance Claims Modernization Platform

Person(CustomersBrokers, "Customers & Brokers", "External users submitting claims online.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal staff handling claims via a new web application.")

System_Ext(LegacyMainframeSystem, "Legacy Mainframe System", "On-premises COBOL/DB2 system of record.")
System_Ext(InsurersActiveDirectory, "Insurer's Active Directory", "Identity Provider (Entra ID) for Single Sign-On.")

System_Boundary(InsuranceClaimsModernizationPlatform, "Insurance Claims Modernization Platform") {
    Container(WebFrontend, "Web Frontend", "React, Azure App Service", "Web application for online claims and adjuster workflows.")
    Container(BFFApiGateway, "BFF / API Gateway", "Azure API Management, Node.js, Java Spring Boot", "Backend-for-Frontend and API Gateway routing requests.")
    Container(ClaimsProcessingService, "Claims Processing Service", "Java Spring Boot, JPA, Azure Container Apps", "Core service handling claims processing and business logic.")
    Container(IntegrationAcl, "Integration & ACL", "Azure Service Bus, Custom Routing & Circuit-Breaker Worker", "Anti-corruption layer protecting and synchronizing with the legacy mainframe.")
    ContainerDb(AzureRedisCache, "Azure Redis Cache", "Azure Redis Cache", "Caching layer for reference data retrieval and sub-second adjuster screens.")
    ContainerDb(AzureSQLDatabase, "Azure SQL Database", "Azure SQL Database, JDBC/JPA", "Primary transactional database for the claims processing service.")
}

Rel(CustomersBrokers, WebFrontend, "Submits online claims and views status", "HTTPS / REST")
Rel(ClaimsAdjusters, WebFrontend, "Executes adjuster workflows", "HTTPS / REST")
Rel(WebFrontend, BFFApiGateway, "Proxies API requests and handles routing", "HTTPS / REST")
Rel(BFFApiGateway, ClaimsProcessingService, "Delegates claims processing workflows", "HTTPS / REST")
Rel(BFFApiGateway, AzureRedisCache, "Retrieves reference data", "Redis Protocol")
Rel(ClaimsProcessingService, AzureSQLDatabase, "Reads and writes claim data", "JDBC / JPA")
Rel(ClaimsProcessingService, IntegrationAcl, "Sends asynchronous events and messages", "Azure Service Bus")
Rel(IntegrationAcl, LegacyMainframeSystem, "Synchronizes data via restricted interface protocols", "Restricted Interface Protocols")
Rel(WebFrontend, InsurersActiveDirectory, "Authenticates users via OAuth2/OIDC", "OAuth2 / OIDC")

@enduml