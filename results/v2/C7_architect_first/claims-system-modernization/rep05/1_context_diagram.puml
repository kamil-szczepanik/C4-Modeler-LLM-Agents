@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers_and_Brokers, "Customers & Brokers", "External users submitting claims online.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal staff handling claims via a new web application.")
System(Insurance_Claims_Modernization_Platform, "Insurance Claims Modernization Platform", "Modernizes a regional insurer's claims platform by gradually migrating claims from a 30-year-old legacy mainframe to a cloud-native Azure environment.")
System_Ext(Legacy_Mainframe_System, "Legacy Mainframe System", "On-premises COBOL/DB2 system of record.")
System_Ext(Core_Integration_Hub, "Core Integration Hub", "Anti-corruption layer bridging Azure and the mainframe.")
System_Ext(Insurers_Active_Directory, "Insurer's Active Directory", "Identity Provider (Entra ID) for Single Sign-On.")
System_Ext(Payment_Gateway_and_Notification_System, "Payment Gateway & Notification System", "External services for payouts and SMS/Email updates.")

Rel(Customers_and_Brokers, Insurance_Claims_Modernization_Platform, "Online claim submission", "HTTPS / OIDC / MFA")
Rel(Claims_Adjusters, Insurance_Claims_Modernization_Platform, "Claim handling via new web application", "HTTPS / OIDC / OAuth 2.0")
Rel(Insurance_Claims_Modernization_Platform, Core_Integration_Hub, "Internal communication and data synchronization", "Internal REST APIs / Messaging")
Rel(Core_Integration_Hub, Legacy_Mainframe_System, "Hybrid data synchronization with legacy system of record", "mTLS, IPsec VPN / Azure ExpressRoute")
Rel(Insurance_Claims_Modernization_Platform, Insurers_Active_Directory, "Single Sign-On and authentication", "OIDC / SAML")
Rel(Insurance_Claims_Modernization_Platform, Payment_Gateway_and_Notification_System, "Automated status updates and payouts", "HTTPS / REST")

@enduml