@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Modern Hybrid Claims Platform

Person(Customers, "Customers", "End users submitting and tracking their insurance claims.")
Person(Brokers, "Brokers", "Intermediaries who assist customers and manage claims processing.")
Person(Claims Adjusters, "Claims Adjusters", "Internal staff responsible for reviewing, processing, and adjudicating claims.")

System_Ext(Legacy Mainframe System, "Legacy Mainframe System", "On-premise COBOL/DB2 system of record for core claims processing.")
System_Ext(Corporate Active Directory, "Corporate Active Directory", "On-premise identity provider for authentication and centralized single sign-on.")

System_Boundary(Modern Hybrid Claims Platform, "Modern Hybrid Claims Platform") {
    Container(Customer Portal, "Customer Portal", "Azure App Service, React", "Provides online claims submission and tracking for customers and brokers.")
    Container(Adjuster Workspace, "Adjuster Workspace", "Azure App Service, React, Node.js BFF", "Enables fast adjuster workflows for reviewing and processing claims.")
    Container(API Gateway, "API Gateway", "Azure API Management", "Routes incoming traffic to the customer portal, adjuster workspace, and integration services.")
    Container(Integration / ACL Service, "Integration / ACL Service", "Azure Container Apps, .NET", "Anti-Corruption Layer (ACL) that bridges the modern cloud architecture with the legacy mainframe.")
    ContainerDb(Claims Read/Write Database, "Claims Read/Write Database", "Azure Database for PostgreSQL", "Provides local caching and transactional data storage to achieve fast screen loads.")
    Container(Azure Service Bus, "Azure Service Bus", "Azure Service Bus", "Orchestrates reliable asynchronous messaging for zero-loss consistency across the platform.")
}

Rel(Customers, Customer Portal, "Interacts with and submits claims", "HTTPS/REST")
Rel(Brokers, Customer Portal, "Assists with claims and interactions", "HTTPS/REST")
Rel(Claims Adjusters, Adjuster Workspace, "Reviews and processes claims", "HTTPS/REST")
Rel(Customer Portal, API Gateway, "Sends and receives routed traffic", "HTTPS")
Rel(Adjuster Workspace, API Gateway, "Sends and receives routed traffic", "HTTPS")
Rel(API Gateway, Customer Portal, "Routes traffic", "HTTPS")
Rel(API Gateway, Adjuster Workspace, "Routes traffic", "HTTPS")
Rel(API Gateway, Integration / ACL Service, "Routes traffic", "HTTPS")
Rel(Integration / ACL Service, Legacy Mainframe System, "Communicates with COBOL/DB2 mainframe", "mTLS over IPsec VPN / Azure ExpressRoute")
Rel(Customer Portal, Claims Read/Write Database, "Reads and writes claim data", "Azure Managed Identities")
Rel(Adjuster Workspace, Claims Read/Write Database, "Reads and writes claim data for fast loads", "Azure Managed Identities")
Rel(Integration / ACL Service, Claims Read/Write Database, "Synchronizes claim data", "Azure Managed Identities")
Rel(Integration / ACL Service, Azure Service Bus, "Publishes and consumes asynchronous messages", "Azure Managed Identities")
Rel(Customer Portal, Corporate Active Directory, "Authenticates via SSO", "OIDC / SAML")
Rel(Adjuster Workspace, Corporate Active Directory, "Authenticates via SSO", "OIDC / SAML")

@enduml