@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(customer_portal, "Customer Portal") {
    Component(React_SPA, "React SPA", "React", "Powers the customer-facing SPA with accessibility and local session autosave.")
    Component(DotNet_BFF, ".NET BFF", ".NET Minimal API", "Implements the BFF pattern to handle secure token management and cookie-based authentication.")
}

Rel(React_SPA, DotNet_BFF, "Forwards UI requests", "HTTPS")
@enduml