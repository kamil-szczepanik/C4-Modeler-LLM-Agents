@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(azure_service_bus, "Azure Service Bus") {
    Component(ClaimSubmissionTopicSubscriptions, "Claim Submission Topic & Subscriptions", "Azure Service Bus Premium", "Publishes and routes incoming claim submission messages to appropriate downstream handlers.")
    Component(DeadLetterQueueDLQHandler, "Dead-Letter Queue (DLQ) Handler", "Azure Service Bus DLQ", "Captures and isolates malformed or failed messages for administrative review and reprocessing.")
    Component(SessionStateManager, "Session State Manager", "Azure Service Bus Sessions", "Maintains ordered processing state for related claim transactions to ensure strict consistency.")
    Component(PartitionedTopicEngine, "Partitioned Topic Engine", "Azure Service Bus Partitioned Topics", "Scales throughput horizontally across multiple message brokers to handle peak loads.")
    Component(DuplicateDetectionFilter, "Duplicate Detection Filter", "Azure Service Bus Duplicate Detection", "Prevents duplicate claim processing by identifying and discarding retransmitted messages.")
}

Rel(ClaimSubmissionTopicSubscriptions, SessionStateManager, "Enforces ordered processing using message sessions", "AMQP 1.0")
Rel(ClaimSubmissionTopicSubscriptions, DuplicateDetectionFilter, "Validates incoming messages for uniqueness", "AMQP 1.0")
Rel(ClaimSubmissionTopicSubscriptions, PartitionedTopicEngine, "Distributes message load across partitions", "AMQP 1.0")
Rel(ClaimSubmissionTopicSubscriptions, DeadLetterQueueDLQHandler, "Routes failed or poisoned messages", "AMQP 1.0")

@enduml