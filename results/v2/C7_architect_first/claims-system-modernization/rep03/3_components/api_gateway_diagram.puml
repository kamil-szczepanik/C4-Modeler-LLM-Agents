@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(auth_validator, "Authentication & Token Validator", "Azure API Management Policy / OIDC / JWT", "Validates incoming tokens and authenticates requests against Corporate Active Directory.")
    Component(routing_dispatcher, "Routing & Path Dispatcher", "Azure API Management Routing", "Dispatches incoming traffic to appropriate backend services like the Integration / ACL Service.")
    Component(rate_limiter, "Rate Limiting & Throttling", "Azure API Management Policy", "Protects backend systems by enforcing rate limits and throttling incoming traffic.")
    Component(versioning_transform, "API Versioning & Transformation", "Azure API Management Policy", "Handles API versioning and transforms request/response payloads as needed.")
    Component(circuit_breaker, "Circuit Breaker", "Azure API Management Policy", "Prevents cascading failures by monitoring backend health and tripping during outages.")
}

Rel(auth_validator, routing_dispatcher, "Passes authenticated requests")
Rel(routing_dispatcher, rate_limiter, "Evaluates rate limits")
Rel(routing_dispatcher, versioning_transform, "Transforms payload")
Rel(routing_dispatcher, circuit_breaker, "Checks circuit status before routing")

@enduml