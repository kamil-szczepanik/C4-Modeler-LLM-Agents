@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Read/Write Database container

System_Ext(CustomerPortal, "Customer Portal", "Reads and writes claim data")
System_Ext(AdjusterWorkspace, "Adjuster Workspace", "Reads and writes claim data")
System_Ext(IntegrationACLService, "Integration / ACL Service", "Synchronizes claim data")
System_Ext(AzureServiceBus, "Azure Service Bus", "Receives domain events")

Container_Boundary(ClaimsReadWriteDatabase, "Claims Read/Write Database") {
    Component(ClaimOperationalStore, "Claim Operational Store", "Azure Database for PostgreSQL (Flexible Server) / PostgreSQL 15+", "Provides robust ACID compliance, high availability, and stores primary claim data using JSONB and Row-Level Security.")
    Component(SyncStateManager, "Sync State Manager", "PostgreSQL 15+ / PgBouncer", "Manages synchronization state and connection pooling for low-latency queries between systems.")
    Component(AuditFallbackLog, "Audit & Fallback Log", "PostgreSQL 15+ / Azure Key Vault", "Provides database activity monitoring, audit logging, and safeguards fallback data for zero data loss.")
    Component(ClaimStateMachineTables, "Claim State Machine Tables", "PostgreSQL 15+", "Tracks the operational states of claims within the modern hybrid platform workflows.")
    Component(OutboxPatternTable, "Outbox Pattern Table", "PostgreSQL 15+", "Enables reliable publishing of domain events to the Azure Service Bus.")
}

Rel(CustomerPortal, ClaimOperationalStore, "Reads and writes claim data", "Azure Managed Identities, SQL over TLS 1.3")
Rel(AdjusterWorkspace, ClaimOperationalStore, "Reads and writes claim data", "Azure Managed Identities, SQL over TLS 1.3")
Rel(IntegrationACLService, ClaimOperationalStore, "Synchronizes claim data", "Azure Managed Identities, SQL over TLS 1.3")
Rel(OutboxPatternTable, AzureServiceBus, "Publishes domain events via Outbox Pattern Table", "AMQP / HTTPS")

@enduml