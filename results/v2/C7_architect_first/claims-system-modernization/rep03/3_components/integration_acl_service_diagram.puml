@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration / ACL Service container

System_Ext(Legacy_Mainframe_System, "Legacy Mainframe System", "Legacy mainframe system handling legacy data structures.")
ContainerDb(Azure_Database_for_PostgreSQL, "Azure Database for PostgreSQL", "Azure Database for PostgreSQL", "Relational persistence for consistency.")
System_Ext(Azure_Service_Bus, "Azure Service Bus", "Asynchronous messaging platform.")
System_Ext(Mainframe_Mocking_Harness, "Mainframe Mocking Harness", "Mocking harness for testing.")
System_Ext(GitHub_Actions_CICD_Pipeline, "GitHub Actions CI/CD Pipeline", "CI/CD Pipeline.")

Container_Boundary(Integration_ACL_Service, "Integration / ACL Service") {
    Component(Mainframe_Translator_Component, "Mainframe Translator Component", ".NET, Serviceakami copybook parsers", "Translates data structures between modern formats and legacy copybooks.")
    Component(Sync_Orchestrator_Component, "Sync Orchestrator Component", ".NET Hosted Service, Serilog", "Orchestrates synchronization processes and logging.")
    Component(Circuit_Breaker_Fallback_Component, "Circuit Breaker & Fallback Component", "Polly for .NET", "Provides circuit breaker and retry policies to isolate mainframe latency.")
    Component(Audit_Logger_Sub_component, "Audit Logger Sub-component", "Azure Monitor / Log Analytics", "Captures audit logs and monitoring data.")
}

Rel(Mainframe_Translator_Component, Legacy_Mainframe_System, "Communicates via mTLS over IPsec VPN / Azure ExpressRoute", "mTLS / IPsec VPN")
Rel(Sync_Orchestrator_Component, Azure_Database_for_PostgreSQL, "Synchronizes claim data via Entity Framework Core and Azure Managed Identities", "Entity Framework Core")
Rel(Sync_Orchestrator_Component, Azure_Service_Bus, "Publishes and consumes asynchronous messages using transport-level security", "TLS")
Rel(GitHub_Actions_CICD_Pipeline, Mainframe_Mocking_Harness, "Executes automated regression testing without live VPN connectivity", "Automation")

@enduml