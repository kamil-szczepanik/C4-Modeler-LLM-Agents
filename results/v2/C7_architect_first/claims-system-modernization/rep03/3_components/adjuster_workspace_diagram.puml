@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Adjuster Workspace container

Container_Boundary(adjuster_workspace, "Adjuster Workspace") {
    Component(spa_client, "SPA Client", "React, TypeScript", "Delivers responsive client-side rendering for fast adjuster UI loads.")
    Component(bff_controller, "BFF Routing & Session Controller", "Node.js, Express", "Powers the Backend-For-Frontend (BFF) and internal routing components.")
    Component(claims_orchestration, "Claims Orchestration Service", "Node.js", "Orchestrates claims workflows and communicates with backend services.")
    Component(local_cache_mgr, "Local View Cache Manager", "Node.js", "Manages local read models and caching to isolate legacy latency.")
    Component(feature_flag_adapter, "Feature Flag & Routing Adapter", "Node.js", "Evaluates active claim types and handles dynamic routing.")
    Component(audit_interceptor, "Audit Logging Interceptor", "Node.js", "Intercepts requests to handle security and audit logging.")
    ComponentDb(claims_db, "Claims Read/Write Database", "Azure Database for PostgreSQL", "Stores local claim read models and audit logs.")
    Component(api_gateway, "API Gateway", "Azure API Management", "Routes and secures traffic between cloud and on-premise mainframe.")
    Component(corp_ad, "Corporate Active Directory", "OIDC/SAML", "Authenticates users via SSO.")
}

Rel(spa_client, bff_controller, "Renders UI and invokes BFF APIs", "HTTPS/REST")
Rel(claims_orchestration, api_gateway, "Fetches domain data", "HTTPS/REST")
Rel(local_cache_mgr, claims_db, "Queries local read models", "TCP/PostgreSQL")
Rel(spa_client, feature_flag_adapter, "Evaluates active claim types", "HTTPS/REST")
Rel(bff_controller, corp_ad, "Authenticates via SSO", "OIDC/SAML")

@enduml