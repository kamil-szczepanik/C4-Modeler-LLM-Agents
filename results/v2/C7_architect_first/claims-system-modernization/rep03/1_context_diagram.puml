@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers, "Customers", "End users submitting and tracking their insurance claims.")
Person(Brokers, "Brokers", "Intermediaries who assist customers and manage claims processing.")
Person(Claims Adjusters, "Claims Adjusters", "Internal staff responsible for reviewing, processing, and adjudicating claims.")

System(Modern Hybrid Claims Platform, "Modern Hybrid Claims Platform", "Gradually replaces a 30-year-old mainframe claims system with a modern hybrid cloud platform while ensuring uninterrupted legacy processing and decoupling real-time user experiences from mainframe batch constraints.")

System_Ext(Legacy Mainframe System, "Legacy Mainframe System", "On-premise COBOL/DB2 system of record for core claims processing.")
System_Ext(Corporate Active Directory, "Corporate Active Directory", "On-premise identity provider for authentication and identity federation.")

Rel(Customers, Modern Hybrid Claims Platform, "Submits and manages claims via real-time user experiences", "HTTPS via TLS 1.3, OIDC, OAuth 2.0")
Rel(Brokers, Modern Hybrid Claims Platform, "Assists with claims management and interactions", "HTTPS via TLS 1.3, OIDC, OAuth 2.0")
Rel(Claims Adjusters, Modern Hybrid Claims Platform, "Reviews and processes claims", "HTTPS via TLS 1.3, OIDC, OAuth 2.0")
Rel(Modern Hybrid Claims Platform, Corporate Active Directory, "Authenticates users and performs identity federation", "LDAPS / SAML")
Rel(Modern Hybrid Claims Platform, Legacy Mainframe System, "Synchronizes claim states asynchronously via integration middleware", "Azure Service Bus, mTLS, AES-256, ExpressRoute/VPN")

@enduml