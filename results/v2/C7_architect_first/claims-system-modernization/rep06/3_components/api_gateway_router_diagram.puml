@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway / Router container

Person(Web_Portal_SPA, "Web Portal (SPA)", "Sends API requests [HTTPS / TLS 1.3 / OAuth 2.0 / OIDC]")
Person(Adjuster_Workspace, "Adjuster Workspace", "Sends API requests [HTTPS / TLS 1.3 / OAuth 2.0 / OIDC]")

Container_Boundary(api_gateway_router, "API Gateway / Router") {
    Component(Dynamic_Route_Dispatcher, "Dynamic Route Dispatcher", "YARP (Yet Another Reverse Proxy)", "Routes migrated claim traffic and unmigrated legacy traffic dynamically.")
    Component(Circuit_Breaker_Fallback_Handler, "Circuit Breaker & Fallback Handler", ".NET / YARP Middleware", "Handles circuit breaking and fallbacks for service resilience.")
    Component(Token_Validation_Middleware, "Token Validation Middleware", ".NET Middleware / OAuth 2.0 / OIDC", "Validates incoming authentication tokens for requests.")
    Component(Audit_Interceptor, "Audit Interceptor", ".NET Middleware", "Dispatches routing telemetry and audit data.")
    Component(Error_Translation_Middleware, "Error Translation Middleware", ".NET Middleware / RFC 7807", "Translates errors into standardized error payloads.")
}

System_Ext(Claims_Core_Service, "Claims Core Service", "Spring Boot")
System_Ext(Legacy_Mainframe, "Legacy Mainframe", "COBOL/DB2")

Rel(Web_Portal_SPA, Token_Validation_Middleware, "Sends API requests", "HTTPS / TLS 1.3")
Rel(Adjuster_Workspace, Token_Validation_Middleware, "Sends API requests", "HTTPS / TLS 1.3")
Rel(Dynamic_Route_Dispatcher, Claims_Core_Service, "Routes migrated claim traffic", "gRPC / HTTPS")
Rel(Dynamic_Route_Dispatcher, Legacy_Mainframe, "Routes unmigrated traffic", "HTTPS / mTLS")
Rel(Dynamic_Route_Dispatcher, Audit_Interceptor, "Dispatches routing telemetry", "In-process")
Rel(Error_Translation_Middleware, Web_Portal_SPA, "Returns standardized error payloads", "HTTPS / RFC 7807")
Rel(Error_Translation_Middleware, Adjuster_Workspace, "Returns standardized error payloads", "HTTPS / RFC 7807")
@enduml