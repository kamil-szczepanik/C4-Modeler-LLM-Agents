@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Integration & Sync Engine", "Integration & Sync Engine") {
    Component("Message Broker Interface", "Message Broker Interface", "Azure Service Bus Premium", "Handles pub/sub, partitioning, and dead-lettering for reliable data synchronization.")
    Component("Idempotency & Reconciliation Worker", "Idempotency & Reconciliation Worker", "Spring Boot (Java)", "Enforces deduplication, business-level reconciliation, and state tracking.")
    Component("Azure SQL Database", "Azure SQL Database", "Azure SQL", "Persistent store for transaction hashes and state tracking.")
    Component("Azure Key Vault", "Azure Key Vault", "Azure Key Vault", "Secure storage for tokenized PII and sensitive claim field values.")
    Component("Business-Facing DLQ Dashboard & Metrics", "Business-Facing DLQ Dashboard & Metrics", "Operational Visibility Tools", "Provides operational visibility for tracking failed syncs and migration progress.")
}

System_Ext("Claims Core Service", "Claims Core Service", "External claims core service")
System_Ext("Anti-Corruption Layer (ACL)", "Anti-Corruption Layer (ACL)", "External anti-corruption layer")

Rel("Claims Core Service", "Message Broker Interface", "Publishes domain events", "AMQP over TLS")
Rel("Message Broker Interface", "Anti-Corruption Layer (ACL)", "Relays sync messages to mainframe", "AMQP over ExpressRoute/mTLS")
Rel("Idempotency & Reconciliation Worker", "Azure SQL Database", "Enforces deduplication", "JDBC/TLS")
Rel("Claims Core Service", "Azure Key Vault", "Tokenizes and retrieves high-risk PII", "HTTPS/REST")

@enduml