@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Portal (SPA) container

Container_Boundary(web_portal_spa, "Web Portal (SPA)") {
    Component(Core_Frontend_Framework, "Core Frontend Framework", "React & TypeScript", "Core frontend framework for building the SPA with high maintainability.")
    Component(Global_Edge_Hosting, "Global Edge Hosting", "Azure Static Web Apps", "Global edge hosting and deployment for the SPA.")
    Component(State_Management_Engine, "State Management Engine", "TanStack Query", "Manages server-state caching, retries, and synchronization.")
    Component(Local_Storage_Engine, "Local Storage Engine", "Dexie.js & IndexedDB", "Enables offline-resilient local form persistence.")
    Component(Monitoring_Service, "Monitoring Service", "Azure Application Insights", "Provides real-user monitoring (RUM) and error telemetry.")
}

Rel(Core_Frontend_Framework, State_Management_Engine, "Uses for server-state caching and synchronization")
Rel(Core_Frontend_Framework, Local_Storage_Engine, "Persists form data locally for offline resilience")
Rel(Core_Frontend_Framework, Monitoring_Service, "Sends telemetry and RUM data")

@enduml