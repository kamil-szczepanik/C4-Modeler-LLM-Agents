@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(azure_sql_database, "Azure SQL Database") {
    Component(ClaimAggregatesRepository, "Claim Aggregates Repository", "Azure SQL Database (Serverless tier), TDE, Azure Private Endpoint", "Stores and manages claim aggregates with strong consistency, auto-scaling, and secure data isolation.")
    Component(ManagedIdentityAuthenticationHandler, "Managed Identity Authentication Handler", "Azure AD Managed Identity", "Enforces passwordless authentication and eliminates embedded credentials for database access.")
    Component(PIIProtectionEnclave, "PII Protection Enclave", "Always Encrypted with Secure Enclaves", "Protects sensitive PII data at rest, in transit, and during computation.")
}

Rel(ClaimAggregatesRepository, PIIProtectionEnclave, "Secures sensitive PII fields within claim records")
Rel(ManagedIdentityAuthenticationHandler, ClaimAggregatesRepository, "Authenticates incoming database connections securely")

@enduml