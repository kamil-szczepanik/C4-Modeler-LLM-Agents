@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Adjuster Workspace container

Person(Claims_Adjusters, "Claims Adjusters", "Users of the Adjuster Workspace")
System_Ext(Identity_Provider, "Identity Provider", "Active Directory")
System_Ext(API_Gateway, "API Gateway / Router", "YARP reverse proxy")
System_Ext(Azure_Application_Insights, "Azure Application Insights", "Telemetry and monitoring")

Container_Boundary(Adjuster_Workspace, "Adjuster Workspace") {
    Component(Workspace_Shell_Component, "Workspace Shell Component", "React, TypeScript", "Powers responsive frontend components for rapid UI development and integrates with the Identity Provider.")
    Component(Claim_Processing_Dashboard, "Claim Processing Dashboard", "React, TanStack Query", "Provides optimistic UI updates and local caching to mask legacy mainframe latency.")
    Component(Integration_Client_Layer, "Integration Client Layer", "Axios, OpenAPI client", "Handles outbound API calls to the API Gateway and interfaces with telemetry.")
    Component(State___Offline_Manager_Component, "State & Offline Manager Component", "Zustand, IndexedDB, Web Crypto API", "Manages local offline state and draft caching with client-side encryption.")
    Component(Telemetry___Tracing_Interceptor, "Telemetry & Tracing Interceptor", "OpenTelemetry JS", "Captures distributed tracing headers (W3C Trace Context) while scrubbing PII.")
}

Rel(Claims_Adjusters, Workspace_Shell_Component, "Interacts", "HTTPS")
Rel(Claim_Processing_Dashboard, State___Offline_Manager_Component, "Uses", "In-memory / IndexedDB")
Rel(Integration_Client_Layer, Telemetry___Tracing_Interceptor, "Uses", "HTTPS")
Rel(Integration_Client_Layer, API_Gateway, "Calls", "TLS 1.3 / REST / JSON")
Rel(Workspace_Shell_Component, Identity_Provider, "Authenticates", "OAuth 2.0 / OpenID Connect")
Rel(Telemetry___Tracing_Interceptor, Azure_Application_Insights, "Sends telemetry", "HTTPS")

@enduml