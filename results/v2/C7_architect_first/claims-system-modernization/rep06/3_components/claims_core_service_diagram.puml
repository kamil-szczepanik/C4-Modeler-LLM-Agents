@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Core Service container

System_Ext(api_gateway, "API Gateway / Router", "External router routing requests.")
System_Ext(integration_engine, "Integration & Sync Engine", "External integration and sync engine.")
System_Ext(audit_service, "Audit & Activity Trail Service", "External audit and activity trail service.")

Container_Boundary(claims_core_service, "Claims Core Service") {
    Component(claim_submission_rest_api, "Claim Submission REST API", "Spring Web", "Handling online submissions via HTTPS.")
    Component(claim_workflow_engine, "Claim Workflow Engine", "Spring State Machine", "Managing adjuster lifecycles, SLAs, and audits.")
    Component(mainframe_sync_adaptor, "Mainframe Sync Adaptor", "Apache Kafka", "Component communicating with the Anti-Corruption Layer via Apache Kafka.")
    Component(data_access_repository, "Data Access Repository", "Spring Data JPA", "Spring Data JPA component interacting with Azure SQL Database.")
    Component(feature_flag_router_component, "Feature Flag Router Component", "Spring Cloud Feature Management", "Spring Cloud Feature Management component for dynamic claim-type routing.")
}

Rel(api_gateway, claim_submission_rest_api, "Routes online claim requests", "HTTPS / OAuth2")
Rel(claim_submission_rest_api, claim_workflow_engine, "Forwards validated submissions for processing", "Internal Method Call")
Rel(claim_workflow_engine, data_access_repository, "Persists workflow state and claim data", "Spring Data JPA / TLS 1.3")
Rel(mainframe_sync_adaptor, integration_engine, "Publishes and consumes asynchronous events", "AMQP / Apache Kafka Protocol with mTLS")
Rel(claim_workflow_engine, audit_service, "Emits cryptographically signed business audit events", "REST / Internal Messaging")

@enduml