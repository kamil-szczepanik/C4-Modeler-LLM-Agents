@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers_and_Brokers, "Customers and Brokers", "External users submitting claims online.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal users managing claims in the new web application.")

System(Insurance_Claims_Modernization, "Insurance Claims Modernization", "Gradually replaces a 30-year-old on-premises mainframe with a modern cloud platform in Azure West Europe, maintaining hybrid coexistence and data consistency while migrating claim types incrementally.")

System_Ext(Legacy_Mainframe, "Legacy Mainframe", "On-premises COBOL/DB2 system of record.")
System_Ext(Identity_Provider, "Identity Provider", "Active Directory / Azure AD handling authentication.")
System_Ext(Anti_Corruption_Layer, "Anti-Corruption Layer (ACL)", "Buffering proxy service in Azure protecting the legacy mainframe.")

Rel(Customers_and_Brokers, Insurance_Claims_Modernization, "Submitting claims online", "HTTPS / OpenID Connect")
Rel(Claims_Adjusters, Insurance_Claims_Modernization, "Managing claims in the new web application", "HTTPS")
Rel(Insurance_Claims_Modernization, Identity_Provider, "Authenticating users", "OpenID Connect / OAuth 2.0")
Rel(Insurance_Claims_Modernization, Anti_Corruption_Layer, "Accessing legacy system of record", "mTLS over VPN/ExpressRoute")
Rel(Anti_Corruption_Layer, Legacy_Mainframe, "Synchronizing data and protecting backend", "mTLS / Internal Protocol")

@enduml