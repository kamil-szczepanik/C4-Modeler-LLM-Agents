@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Hybrid Cloud Insurance Claims Modernization Platform

Person(CustomersAndBrokers, "Customers and Brokers", "External actors who submit claims and interact via digital channels.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal staff who process claims using the adjuster workspace.")
System_Ext(InsurerActiveDirectory, "Insurer Active Directory", "External identity provider system for authentication and authorization.")
System_Ext(OnPremisesCOBOLDB2Mainframe, "On-Premises COBOL/DB2 Mainframe", "Legacy system of record for core insurance processing.")

System_Boundary(HybridCloudInsuranceClaimsModernizationPlatform, "Hybrid Cloud Insurance Claims Modernization Platform") {
    Container(APIGatewayBFF, "API Gateway / BFF", "Node.js / TypeScript Container", "Backend for Frontend and API gateway managing client requests.")
    Container(CustomerPortalandAdjusterWorkspace, "Customer Portal and Adjuster Workspace", "React Web Apps in Azure Static Web Apps", "Frontend web applications for customers, brokers, and adjusters.")
    Container(ClaimsProcessingService, "Claims Processing Service", "Java Spring Boot Container", "Core business logic service for processing claims.")
    Container(IntegrationBridge, "Integration Bridge", "Apache Camel / Azure Integration Services Container", "Middleware bridging modern services and legacy mainframe via secure channels.")
    ContainerDb(ReferenceDataPolicyCache, "Reference Data & Policy Cache", "Redis Container", "Caching layer providing fast access to reference data and policies.")
    Container(NotificationService, "Notification Service", "Azure Communication Services Container", "Service responsible for dispatching notifications to users.")
    Container(AuditLoggingContainer, "Audit Logging Container", "WORM Storage", "Secure storage ensuring immutable audit logs.")
    Container(DocumentEvidenceManagementService, "Document & Evidence Management Service", "Azure Blob Storage Container", "Storage container for managing documents and claim evidence.")
    Container(SelfServiceDashboardBackend, "Self-Service Dashboard Backend", "Container", "Backend supporting the self-service dashboard capabilities.")
}

Rel(CustomersAndBrokers, APIGatewayBFF, "Accesses APIs via BFF", "HTTPS/REST")
Rel(APIGatewayBFF, InsurerActiveDirectory, "Performs Single Sign-On", "OpenID Connect (OIDC)")
Rel(ClaimsAdjusters, CustomerPortalandAdjusterWorkspace, "Uses the adjuster workspace", "HTTPS")
Rel(CustomerPortalandAdjusterWorkspace, ReferenceDataPolicyCache, "Queries data for sub-2s performance", "gRPC")
Rel(ClaimsProcessingService, IntegrationBridge, "Sends asynchronous messages", "Azure Service Bus")
Rel(IntegrationBridge, OnPremisesCOBOLDB2Mainframe, "Communicates with legacy mainframe securely", "IPsec VPN, ExpressRoute, and mTLS")

@enduml