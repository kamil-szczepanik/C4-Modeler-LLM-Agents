@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Hybrid Cloud Insurance Claims Modernization Platform

Person(Customers, "Customers", "End users who perform modern digital claim submission via web and mobile clients.")
Person(Brokers, "Brokers", "Partners who assist with insurance claims and interact via digital channels.")
Person(Claims Adjusters, "Claims Adjusters", "Internal staff who use the high-performance web application for claims processing.")

System(Hybrid Cloud Insurance Claims Modernization Platform, "Hybrid Cloud Insurance Claims Modernization Platform", "A hybrid cloud insurance claims modernization platform that gradually replaces a legacy COBOL/DB2 mainframe while ensuring zero data loss and continuous operations.")

System_Ext(On-premises COBOL/DB2 Mainframe, "On-premises COBOL/DB2 Mainframe", "The legacy System of Record containing core insurance data.")
System_Ext(Insurer Active Directory, "Insurer Active Directory", "On-premises identity provider connected via Azure AD / Entra ID Connect.")

Rel(Customers, Hybrid Cloud Insurance Claims Modernization Platform, "Accesses web and mobile client interfaces for claim submission", "HTTPS via TLS 1.3")
Rel(Brokers, Hybrid Cloud Insurance Claims Modernization Platform, "Accesses web and mobile client interfaces for claims assistance", "HTTPS via TLS 1.3")
Rel(Claims Adjusters, Hybrid Cloud Insurance Claims Modernization Platform, "Uses the high-performance web application for claims processing", "HTTPS via TLS 1.3")
Rel(Hybrid Cloud Insurance Claims Modernization Platform, On-premises COBOL/DB2 Mainframe, "Asynchronous messaging and integration through the Anti-Corruption Layer", "Azure Service Bus with Dead Letter Queues, mTLS, TLS 1.3")
Rel(Hybrid Cloud Insurance Claims Modernization Platform, Insurer Active Directory, "Performs Single Sign-On and user authentication", "OIDC / OAuth2 over HTTPS")

@enduml