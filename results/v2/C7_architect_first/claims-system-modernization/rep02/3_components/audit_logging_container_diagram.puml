@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit Logging Container container

System_Ext(Claims_Processing_Service, "Claims Processing Service", "External service that invokes the audit logging.")

Container_Boundary(Audit_Logging_Container, "Audit Logging Container") {
    Component(Audit_Ingestion_API, "Audit Ingestion API", "Azure Function, Node.js", "Receives raw audit events via HTTPS and OAuth2/JWT using Azure Managed Identities.")
    Component(PII_Sanitizer_Normalizer, "PII Sanitizer & Normalizer", "Lightweight container", "Sanitizes and normalizes raw events from the internal queue.")
    Component(Immutable_Storage_Writer, "Immutable Storage Writer", "Azure Blob Storage with WORM Policy", "Writes encrypted objects ensuring regulatory compliance through time-based immutability.")
    Component(Azure_Key_Vault_HSM, "Azure Key Vault HSM", "Azure Key Vault HSM", "Provides Customer-Managed Keys (CMK) for envelope encryption of sensitive claims data.")
    Component(Azure_Monitor_and_Application_Insights, "Azure Monitor and Application Insights", "Azure Monitor", "Collects telemetry from the Audit Ingestion API and Sanitizer via HTTPS.")
}

Rel(Claims_Processing_Service, Audit_Ingestion_API, "Invokes via HTTPS and OAuth2/JWT using Azure Managed Identities", "HTTPS / OAuth2")
Rel(Audit_Ingestion_API, PII_Sanitizer_Normalizer, "Passes raw events via internal queue", "Internal Queue")
Rel(PII_Sanitizer_Normalizer, Immutable_Storage_Writer, "Writes encrypted objects via Azure SDK (HTTPS)", "Azure SDK / HTTPS")
Rel(Azure_Monitor_and_Application_Insights, Audit_Ingestion_API, "Collects telemetry via HTTPS", "HTTPS")
Rel(Azure_Monitor_and_Application_Insights, PII_Sanitizer_Normalizer, "Collects telemetry via HTTPS", "HTTPS")

@enduml