@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Integration Bridge", "Integration Bridge") {
    Component("Route Orchestrator", "Route Orchestrator", "Apache Camel Core Component", "Handles internal routing and enterprise integration patterns.")
    Component("Mainframe Adapter Component", "Mainframe Adapter Component", "Apache Camel / Azure Integration Services", "Interfaces securely with the on-premises legacy mainframe.")
    Component("DLQ Handler Component", "Dead Letter Queue (DLQ) Handler Component", "Apache Camel", "Handles failed messages and triggers business exception alerts.")
    Component("Circuit Breaker & Rate Limiting Component", "Circuit Breaker & Rate Limiting Component", "Resilience4j via Camel", "Protects the legacy mainframe via circuit breaking and backpressure.")
    Component("Fallback Routing Switch Component", "Fallback Routing Switch Component", "Apache Camel", "Allows rapid fallback per claim type.")
    Component("Key Vault Secrets Provider Component", "Key Vault Secrets Provider Component", "Azure Key Vault / Managed Identity", "Dynamically fetches credentials and secrets.")
    Component("Reconciliation & Business Dashboard Adapter Component", "Reconciliation & Business Dashboard Adapter Component", "Apache Camel", "Adapts data for reconciliation and business dashboards.")
}

Rel("Route Orchestrator", "Mainframe Adapter Component", "Internal routing", "Direct VM / In-Memory")
Rel("Key Vault Secrets Provider Component", "Azure Key Vault", "Dynamically fetches credentials and secrets", "HTTPS / Managed Identity")
Rel("DLQ Handler Component", "Notification Service", "Triggers business exception alerts", "REST API")
@enduml