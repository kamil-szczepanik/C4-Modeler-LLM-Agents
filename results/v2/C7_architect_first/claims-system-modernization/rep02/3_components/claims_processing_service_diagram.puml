@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Processing Service container

Container_Boundary(claims_processing_service, "Claims Processing Service") {
    Component(ClaimOrchestrator, "Claim Orchestrator", "Spring State Machine", "Manages claim lifecycles and workflow states.")
    Component(ClaimCommandAPI, "Claim Command API", "Spring MVC", "Exposes REST endpoints for handling claim commands.")
    Component(MainframeAntiCorruptionLayer, "Mainframe Anti-Corruption Layer", "Spring Integration", "Translates payloads and decouples legacy mainframe dependencies.")
    Component(EventPublisher, "Event Publisher", "Spring Cloud Stream", "Publishes domain events to the integration bridge.")
    Component(SLAEscalationComponent, "SLA & Escalation Component", "Java / Spring Boot", "Monitors and enforces claim processing SLAs and escalations.")
    Component(BusinessMetricsAuditTrailComponent, "Business Metrics & Audit Trail Component", "Java / Spring Boot", "Tracks business metrics and maintains audit trails.")
    Component(DataAccessLayer, "Data Access Layer", "Spring Data JPA", "Handles persistence and data retrieval against Azure PostgreSQL.")
    Component(FeatureFlagComponent, "Feature Flag Component", "Toggle Service", "Manages feature flags to support fallback to the mainframe.")
    Component(CustomerNotificationTriggerComponent, "Customer Notification Trigger Component", "Java / Spring Boot", "Triggers notifications for customers regarding claim status updates.")
}

Rel(ClaimCommandAPI, ClaimOrchestrator, "Delegates command execution and state transitions", "HTTPS / REST")
Rel(ClaimOrchestrator, MainframeAntiCorruptionLayer, "Interacts with legacy mainframe via translation layer", "Internal")
Rel(ClaimOrchestrator, EventPublisher, "Publishes state change events", "Spring Cloud Stream")
Rel(ClaimOrchestrator, DataAccessLayer, "Persists claim state data", "Spring Data JPA / JDBC")
Rel(ClaimOrchestrator, CustomerNotificationTriggerComponent, "Triggers notifications based on state events", "Internal")
Rel(ClaimOrchestrator, SLAEscalationComponent, "Evaluates SLA rules during lifecycle", "Internal")
Rel(ClaimOrchestrator, BusinessMetricsAuditTrailComponent, "Records audit and metric data", "Internal")
Rel(ClaimOrchestrator, FeatureFlagComponent, "Checks feature flags for routing and rollback support", "API")

@enduml