@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Reference_Data___Policy_Cache", "Reference Data & Policy Cache") {
    Component(Policy_Data_Cache_Manager, "Policy Data Cache Manager", "Azure Cache for Redis", "Manages in-memory caching and rapid retrieval of policy and reference data for sub-2-second adjuster response times.")
    Component(Sync_Ingestion_Listener, "Sync Ingestion Listener", "Apache Camel / Redis Pub-Sub", "Listens for nightly batch deltas and real-time updates to keep the cache synchronized.")
}

Rel(Sync_Ingestion_Listener, Policy_Data_Cache_Manager, "Updates cached records", "Internal Redis API")

@enduml