@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification Service container

System_Ext(ClaimsProcessingService, "Claims Processing Service", "External claims service")
System_Ext(AzureCommunicationServices, "Azure Communication Services", "Native multi-channel cloud notifications")

Container_Boundary(NotificationService, "Notification Service") {
    Component(NotificationRouterComponent, "Notification Router Component", "Java / Spring Boot", "Extracts claim events via Azure Service Bus to route notifications.")
    Component(PreferenceResolutionComponent, "Preference Resolution Component", "Java / Spring Boot, Redis", "Resolves user notification preferences backed by Redis cache.")
    Component(TemplateEngineComponent, "Template Engine Component", "Java", "Renders notification templates for multi-channel delivery.")
    Component(AzureCommunicationAdapterComponent, "Azure Communication Adapter Component", "Java, Azure SDK for Java", "Adapts messages to Azure Communication Services.")
    Component(DeliveryStatusTrackerComponent, "Delivery Status Tracker Component", "Cosmos DB", "Tracks message delivery states asynchronously with CMK encryption.")
}

Rel(ClaimsProcessingService, NotificationRouterComponent, "AMQP via Azure Service Bus", "AMQP")
Rel(NotificationRouterComponent, PreferenceResolutionComponent, "REST/gRPC with Redis cache", "REST/gRPC")
Rel(TemplateEngineComponent, AzureCommunicationAdapterComponent, "Spring Application Events", "In-Process")
Rel(AzureCommunicationAdapterComponent, AzureCommunicationServices, "HTTPS / TLS 1.3", "HTTPS")
@enduml