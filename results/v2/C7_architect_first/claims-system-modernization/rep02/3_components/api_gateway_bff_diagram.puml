@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway / BFF container

System_Ext(Insurer_Active_Directory, "Insurer Active Directory", "Enables single sign-on with Insurer Active Directory.")
System_Ext(Redis, "Cache Client", "Redis", "Interfaces with Redis to store and retrieve dynamic claim-type routing rules and fallback flags.")
System_Ext(Claims_Processing_Service_Integration_Bridge, "Claims Processing Service & Integration Bridge", "Communicates securely with the Claims Processing Service & Integration Bridge.")

Container_Boundary(api_gateway_bff, "API Gateway / BFF") {
    Component(Routing_Router, "Routing Router", "Node.js / TypeScript", "Evaluates dynamic claim-type routing rules and handles geo-routing coordination.")
    Component(Authentication_Middleware, "Authentication Middleware", "OpenID Connect & JWT", "Enables single sign-on with Insurer Active Directory.")
    Component(Cache_Client, "Cache Client", "Redis", "Interfaces with Redis to store and retrieve dynamic claim-type routing rules and fallback flags.")
    Component(Bridge_Client, "Bridge Client", "gRPC/mTLS", "Communicates securely with the Claims Processing Service & Integration Bridge.")
}

Rel(Routing_Router, Cache_Client, "Fetches routing rules via TCP", "TCP")
Rel(Authentication_Middleware, Insurer_Active_Directory, "Authenticates users via OpenID Connect (OIDC)", "OpenID Connect (OIDC)")
Rel(Bridge_Client, Claims_Processing_Service_Integration_Bridge, "Sends claims data via gRPC/mTLS", "gRPC/mTLS")
@enduml