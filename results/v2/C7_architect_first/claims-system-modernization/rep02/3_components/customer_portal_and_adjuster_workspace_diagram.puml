@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(InsurerActiveDirectory, "Insurer Active Directory", "Active Directory")

Container_Boundary(CustomerPortalandAdjusterWorkspace, "Customer Portal and Adjuster Workspace") {
    Component(PublicPortalUI, "Public Portal UI", "React", "Handles customer and broker claim submissions.")
    Component(InternalWorkspaceUI, "Internal Workspace UI", "React", "Manages adjuster workflows and multi-client broker dashboards.")
    Component(AuthenticationInterceptor, "Authentication Interceptor", "TypeScript / MSAL.js", "Handles OIDC/OAuth2 integration with Active Directory.")
    Component(BFFClientSDK, "BFF Client SDK", "TypeScript", "Encapsulates API requests to backend services.")
    Component(OptimisticStateManager, "Optimistic State Manager", "React / Zustand / IndexedDB / Web Crypto API (AES-GCM)", "Manages local state mutations, IndexedDB storage, and PII encryption at rest.")
}

Rel(InternalWorkspaceUI, BFFClientSDK, "Invokes claims operations", "HTTPS/REST")
Rel(PublicPortalUI, BFFClientSDK, "Submits new claims", "HTTPS/REST")
Rel(AuthenticationInterceptor, InsurerActiveDirectory, "Validates tokens", "OIDC/HTTPS")
Rel(OptimisticStateManager, BFFClientSDK, "Synchronizes background requests", "HTTPS/REST")
@enduml