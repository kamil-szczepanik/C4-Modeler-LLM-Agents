@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Self-Service Dashboard Backend container

Container_Boundary(self_service_dashboard_backend, "Self-Service Dashboard Backend") {
    Component(Dashboard Aggregator Component, "Dashboard Aggregator Component", "NestJS / TypeScript, RxJS", "Aggregates data from legacy and modern sources using reactive stream merging.")
    Component(Claim Submission Orchestrator Component, "Claim Submission Orchestrator Component", "NestJS / TypeScript", "Orchestrates claim submission workflows between the interface and backend services.")
    Component(Cache-Aside Client Component, "Cache-Aside Client Component", "NestJS / TypeScript, Redis", "Manages data retrieval and caching with the Reference Data & Policy Cache.")
    Component(Auth & Context Validator Component, "Auth & Context Validator Component", "NestJS / TypeScript, OAuth2/OIDC (JWKS)", "Validates security tokens locally to minimize latency against Insurer Active Directory.")
    Component(Normalization Service Component, "Normalization Service Component", "NestJS / TypeScript", "Enforces an Anti-Corruption Layer to seamlessly blend legacy mainframe and modern platform data.")
    Component(Event-Driven Projection Listener, "Event-Driven Projection Listener", "NestJS / TypeScript, Azure WORM Storage", "Listens to events and writes audit logs to Azure WORM Storage.")
}

System_Ext(Claims Processing Service, "Claims Processing Service", "External claims processing service.")
System_Ext(Reference Data & Policy Cache (Redis), "Reference Data & Policy Cache (Redis)", "External Redis cache for reference data and policies.")
System_Ext(Insurer Active Directory, "Insurer Active Directory", "External identity provider for authentication.")
System_Ext(Azure WORM Storage, "Azure WORM Storage", "External WORM storage for secure audit logging.")

Rel(Dashboard Aggregator Component, Claims Processing Service, "Communicates via gRPC / Async messaging over TLS 1.3", "gRPC / Async")
Rel(Claim Submission Orchestrator Component, Claims Processing Service, "Submits claims via gRPC / Async messaging over TLS 1.3", "gRPC / Async")
Rel(Cache-Aside Client Component, Reference Data & Policy Cache (Redis), "Connects via mTLS", "mTLS")
Rel(Auth & Context Validator Component, Insurer Active Directory, "Validates tokens via OAuth2/OIDC (JWKS)", "OAuth2/OIDC")
Rel(Event-Driven Projection Listener, Azure WORM Storage, "Writes audit logging securely", "HTTPS")

@enduml