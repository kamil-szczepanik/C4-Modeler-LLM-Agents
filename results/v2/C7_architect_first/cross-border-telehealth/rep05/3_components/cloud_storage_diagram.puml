@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Cloud Storage container

Container_Boundary(cloud_storage, "Cloud Storage") {
    Component(Storage_Gateway, "Storage Gateway", "Go / REST API", "Reads/writes encrypted blobs and interacts with Google Cloud Storage Buckets.")
    Component(Upload_Session_Manager, "Upload Session Manager", "Go / REST API", "Initiates resumable upload sessions and issues signed upload handles.")
    Component(Encryption_Service, "Encryption Service", "Google Cloud KMS", "Encrypts/decrypts payloads and provides customer-managed encryption keys.")
    Component(Data_Residency_Auditor, "Data Residency Auditor", "Google Cloud Functions", "Enforces strict regional data residency and compliance.")
    Component(Access_Control_Enforcer, "Access Control Enforcer", "Go / Open Policy Agent", "Verifies key access rights and enforces security controls.")
    ComponentDb(Google_Cloud_Storage_Buckets, "Google Cloud Storage Buckets", "Google Cloud Storage", "Regional EU and US buckets for isolated data storage.")
}

Rel(Storage_Gateway, Google_Cloud_Storage_Buckets, "Reads/writes encrypted blobs", "HTTPS / GCP API")
Rel(Storage_Gateway, Encryption_Service, "Encrypts/decrypts payloads", "gRPC")
Rel(Storage_Gateway, Upload_Session_Manager, "Initiates resumable upload sessions", "gRPC")
Rel(Upload_Session_Manager, Google_Cloud_Storage_Buckets, "Issues signed upload handles", "HTTPS")
Rel(Access_Control_Enforcer, Encryption_Service, "Verifies key access rights", "gRPC")

@enduml