@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Cloud Pub/Sub container

Container_Boundary("Cloud Pub/Sub", "Cloud Pub/Sub") {
    Component("Event Publisher", "Event Publisher", "Google Cloud Pub/Sub Publisher API / TLS 1.3", "Publishes asynchronous healthcare events and messages from Core Services and Integration Service.")
    Component("Event Consumer", "Event Consumer", "Google Cloud Pub/Sub Subscriber API / TLS 1.3", "Consumes asynchronous events to ensure resilient and prioritized delivery for critical healthcare workflows.")
}

Rel("Event Publisher", "Event Consumer", "Dispatches and routes asynchronous healthcare events via Google Cloud Pub/Sub using TLS 1.3.", "Google Cloud Pub/Sub / TLS 1.3")

@enduml