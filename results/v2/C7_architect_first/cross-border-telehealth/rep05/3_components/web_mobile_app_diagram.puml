@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(web_mobile_app, "Web & Mobile App") {
    Component(ui_layer, "UI Layer", "Flutter / TypeScript", "Cross-platform mobile and web presentation layers providing platform interfaces for patients, clinicians, and regional pharmacists.")
    Component(state_offline_manager, "State & Offline Manager", "SQLCipher & IndexedDB", "Manages local encrypted storage for offline caching and resilience in unstable rural environments.")
    Component(video_client_wrapper, "Video Client Wrapper", "LiveKit Web/Mobile SDK", "Handles real-time WebRTC video consultation delivery between patients, clinicians, and pharmacists.")
    Component(api_websocket_client, "API & WebSocket Client", "TypeScript / WebSockets / HTTPS", "Sends API requests and WebSocket messages to the API Gateway.")
    Component(consent_policy_interceptor, "Consent & Policy Interceptor", "Android Keystore / iOS Keychain / Unleash", "Routes region-locked, consented sync payloads via HTTPS ensuring data residency and compliance.")
}

System_Ext(api_gateway, "API Gateway", "Google Cloud API Gateway")

Rel(ui_layer, state_offline_manager, "Caches and retrieves local data using")
Rel(ui_layer, video_client_wrapper, "Initiates video consultations via")
Rel(ui_layer, api_websocket_client, "Triggers API requests and messages via")
Rel(state_offline_manager, consent_policy_interceptor, "Routes offline-synced payloads through")
Rel(consent_policy_interceptor, api_gateway, "Sends region-locked, consented sync payloads via HTTPS")

@enduml