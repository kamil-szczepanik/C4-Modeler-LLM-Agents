@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(Policy Enforcement Proxy, "Policy Enforcement Proxy", "Envoy Proxy", "Dispatches validated, consent-checked requests to core services.")
    Component(Auth & Rate Limiter, "Auth & Rate Limiter", "Envoy Filter / Lua", "Handles JWT validation and routing rules.")
    Component(Signaling Proxy, "Signaling Proxy", "NGINX", "Relays real-time session metadata for video consultations.")
    Component(Protocol Translation Bridge, "Protocol Translation Bridge", "Custom Bridge", "Translates protocols to ensure continuous, degraded-mode availability for rural connections.")
}

System_Ext(Core_Services_Container, "Core Services Container", "Spring Boot / Java")
System_Ext(Video_Media_Server, "Video Media Server", "LiveKit / WebRTC")

Rel(Policy Enforcement Proxy, Core_Services_Container, "Dispatches validated, consent-checked requests", "gRPC / mTLS")
Rel(Signaling Proxy, Video_Media_Server, "Relays real-time session metadata", "WSS")

@enduml