@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(core_services_container, "Core Services Container") {
    Component(Telehealth_API_Controller, "Telehealth API Controller", "Spring Boot / Java", "Handles incoming routing requests from the API Gateway via gRPC over mTLS.")
    Component(Consent_Policy_Evaluator, "Consent Policy Evaluator", "Spring Boot / Java", "Evaluates cached consent policies by interacting with Memorystore for Redis.")
    Component(Audit_Logger, "Audit Logger", "Spring Boot / Java", "Stores immutable audit logs in Cloud Storage via HTTPS / GCP API.")
}

Rel(Telehealth_API_Controller, Consent_Policy_Evaluator, "Evaluates cached consent policies", "Redis Protocol over TLS")
Rel(Telehealth_API_Controller, Audit_Logger, "Dispatches compliance and audit records", "HTTPS / GCP API")

@enduml