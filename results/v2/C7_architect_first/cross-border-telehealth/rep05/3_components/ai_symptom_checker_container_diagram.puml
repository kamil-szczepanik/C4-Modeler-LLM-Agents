@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Symptom Checker Container container

Container(CoreServicesContainer, "Core Services Container", "Microservice", "Sends symptom analysis requests")

System_Boundary(AISymptomCheckerContainer, "AI Symptom Checker Container") {
    Component(APIRouterEndpointHandler, "API Router / Endpoint Handler", "Python / FastAPI", "High-performance asynchronous API framework for handling routing and request validation.")
    Component(DataResidencyGuard, "Data Residency Guard", "In-process logic", "Validates regional payload boundaries and enforces compliance.")
    Component(InferenceEngine, "Inference Engine", "PyTorch / ONNX Runtime", "Optimized machine learning inference engine for rapid symptom analysis.")
    Component(ModelCacheWarmLoader, "Model Cache / Warm Loader", "In-memory cache", "Retrieves pre-loaded model weights for rapid inference.")
    Component(ClinicalOutputFormatter, "Clinical Output Formatter", "Python", "Passes and formats raw prediction vectors into structured clinical outputs.")
    Component(AuditTraceabilityLogger, "Audit & Traceability Logger", "OpenTelemetry / Cloud Logging", "Exports and persists prediction metadata, inputs, and model versions.")
}

System_Ext(GoogleCloudCloudLoggingCloudStorage, "Google Cloud Cloud Logging / Cloud Storage", "HTTPS / Cloud Storage API", "Persists immutable audit logs.")

Rel(CoreServicesContainer, APIRouterEndpointHandler, "Sends symptom analysis requests", "gRPC over mTLS")
Rel(APIRouterEndpointHandler, DataResidencyGuard, "Validates regional payload boundaries", "In-process")
Rel(DataResidencyGuard, InferenceEngine, "Forwards verified payloads", "In-process")
Rel(InferenceEngine, ModelCacheWarmLoader, "Retrieves pre-loaded model weights", "In-memory")
Rel(InferenceEngine, ClinicalOutputFormatter, "Passes raw prediction vectors", "In-process")
Rel(InferenceEngine, AuditTraceabilityLogger, "Exports prediction metadata, inputs, and model versions", "Asynchronous")
Rel(AuditTraceabilityLogger, GoogleCloudCloudLoggingCloudStorage, "Persists immutable audit logs", "HTTPS / Cloud Storage API")

@enduml