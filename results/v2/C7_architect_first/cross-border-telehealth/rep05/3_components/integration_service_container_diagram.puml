@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Service Container container

Container_Boundary(integration_service_container, "Integration Service Container") {
    Component(Prescription_Router, "Prescription Router", "Node.js / TypeScript", "Routes prescription requests to the appropriate regional adapters.")
    Component(EU_US_E_Prescription_Adapters, "EU/US E-Prescription Adapters", "Node.js / TypeScript", "Adapts and sends e-prescription data to EU National E-Prescription Gateways and US Pharmacy Networks.")
    Component(Outbox_Event_Processor, "Outbox Event Processor", "Node.js / TypeScript", "Processes outbox events for asynchronous messaging and decoupled communication.")
    Component(Audit_Telemetry_Interceptor, "Audit & Telemetry Interceptor", "Node.js / TypeScript", "Intercepts and records audit logs and telemetry data for compliance and tracking.")
    Component(DLQ_Manager, "DLQ Manager", "Node.js / TypeScript", "Manages dead-letter queues and publishes permanent dispatch failure notifications via Cloud Pub/Sub.")
}

System(Core_Services_Container, "Core Services Container", "Spring Boot / Java")

Rel(DLQ_Manager, Core_Services_Container, "Publishes permanent dispatch failure notifications", "Cloud Pub/Sub")

@enduml