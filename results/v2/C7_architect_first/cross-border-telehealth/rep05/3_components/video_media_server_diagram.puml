@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(Video_Media_Server, "Video Media Server") {
    Component(SFU_Core, "SFU Core", "Go / LiveKit Engine", "Handles real-time media streams and core SFU functionality.")
    Component(Room___Session_Manager, "Room & Session Manager", "Go", "Manages video rooms and user sessions.")
    Component(Adaptive_Bitrate_Controller, "Adaptive Bitrate Controller", "Go", "Dynamically adjusts media codecs and enforces audio-only fallback.")
    Component(Token_Verifier, "Token Verifier", "Go", "Validates incoming client JWTs locally.")
}

Rel(Room___Session_Manager, Core_Services_Container, "Validates session authorization", "gRPC over mTLS")
Rel(SFU_Core, Token_Verifier, "Validates incoming client JWTs locally", "In-Memory")
Rel(Adaptive_Bitrate_Controller, SFU_Core, "Dynamically adjusts media codecs and enforces audio-only fallback", "In-Memory Go API")

@enduml