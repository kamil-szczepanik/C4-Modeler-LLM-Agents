@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Cloud SQL (PostgreSQL) container

Container(Core Services Container, "Core Services Container", "Spring Boot / Java", "Core application services")

Container_Boundary("Cloud SQL (PostgreSQL)", "Cloud SQL (PostgreSQL)") {
    Component(ConnectionPoolingComponent, "Connection Pooling Component", "TCP/SSL", "Manages database sessions and connection pooling via TCP/SSL for core services.")
    Component(DatabaseInstanceComponent, "Database Instance Component", "PostgreSQL with pgaudit", "Manages physically isolated relational data instances in europe-west3 and us-central1 ensuring GDPR and HIPAA compliance.")
}

Rel(Core Services Container, ConnectionPoolingComponent, "Manages database sessions via TCP/SSL", "TCP/SSL")
Rel(ConnectionPoolingComponent, DatabaseInstanceComponent, "Routes queries to relational data instances", "PostgreSQL Wire Protocol")

@enduml