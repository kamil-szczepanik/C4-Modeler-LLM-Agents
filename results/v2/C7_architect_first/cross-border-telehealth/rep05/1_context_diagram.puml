@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "Patients using mobile or web clients for video consultations, e-prescriptions, and the AI symptom checker.")
Person(Clinicians, "Clinicians", "Clinicians using web clients to conduct video consultations and manage patient care.")
Person(Regional Pharmacists, "Regional Pharmacists", "Regional pharmacists fulfilling prescriptions across borders.")

System(Cross-Border Telehealth Platform, "Cross-Border Telehealth Platform", "A cross-border telehealth platform providing video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and the US.")

System_Ext(EU National E-Prescription Gateways, "EU National E-Prescription Gateways", "External national gateways for e-prescriptions in the European Union.")
System_Ext(US Pharmacy Networks, "US Pharmacy Networks", "External pharmacy networks in the United States.")
System_Ext(Regional Identity Providers, "Regional Identity Providers", "OIDC/OAuth2 identity providers for authentication.")

Rel(Patients, Cross-Border Telehealth Platform, "Connects via TLS 1.3 for video consultations, symptom checking, and prescriptions", "HTTPS / WebRTC / TLS 1.3")
Rel(Clinicians, Cross-Border Telehealth Platform, "Connects via TLS 1.3 to manage consultations and patient records", "HTTPS / TLS 1.3")
Rel(Regional Pharmacists, Cross-Border Telehealth Platform, "Accesses prescription data and fulfillment details", "HTTPS")
Rel(Cross-Border Telehealth Platform, EU National E-Prescription Gateways, "Integrates for EU e-prescriptions", "REST / HL7 FHIR")
Rel(Cross-Border Telehealth Platform, US Pharmacy Networks, "Integrates for US e-prescriptions", "REST / HL7 FHIR")
Rel(Cross-Border Telehealth Platform, Regional Identity Providers, "Authenticates users via OIDC/OAuth2", "OIDC / OAuth2")

@enduml