@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "Patients using mobile or web clients for video consultations, e-prescriptions, and the AI symptom checker.")
Person(Clinicians, "Clinicians", "Clinicians using web clients to conduct video consultations and manage patient care.")
Person(RegionalPharmacists, "Regional Pharmacists", "Regional Pharmacists", "Regional pharmacists fulfilling prescriptions across borders.")

System_Ext(EUNationalEPrescriptionGateways, "EU National E-Prescription Gateways", "External national gateways for e-prescriptions in the European Union.")
System_Ext(USPharmacyNetworks, "US Pharmacy Networks", "External pharmacy networks in the United States using HL7 FHIR.")
System_Ext(RegionalIdentityProviders, "Regional Identity Providers", "OIDC/OAuth2 identity providers for authentication.")

System_Boundary(CrossBorderTelehealthPlatform, "Cross-Border Telehealth Platform") {
    Container(WebMobileApp, "Web & Mobile App", "Flutter / TypeScript", "Client applications for cross-platform support providing user interfaces for video, e-prescriptions, and symptom checking.")
    Container(APIGateway, "API Gateway", "Google Cloud API Gateway", "Manages and routes incoming HTTPS and WebSocket traffic, and handles WebRTC signaling.")
    Container(CoreServicesContainer, "Core Services Container", "Spring Boot / Java", "Handles core business logic, consent management, and data orchestration.")
    Container(AISymptomCheckerContainer, "AI Symptom Checker Container", "Python / FastAPI", "Provides AI symptom checker inference and logging.")
    Container(IntegrationServiceContainer, "Integration Service Container", "Node.js / TypeScript", "Handles asynchronous e-prescription dispatch and external integrations.")
    Container(VideoMediaServer, "Video Media Server", "LiveKit / WebRTC", "Provides low-bandwidth resilient video consultations.")
    ContainerDb(CloudSQLPostgreSQL, "Cloud SQL (PostgreSQL)", "PostgreSQL", "Provides encrypted, region-isolated data persistence.")
    Container(CloudStorage, "Cloud Storage", "Google Cloud Storage", "Stores encrypted documents and media files with region isolation.")
    Container(CloudPubSub, "Cloud Pub/Sub", "Google Cloud Pub/Sub", "Handles asynchronous messaging and region-isolated event dispatch.")
}

Rel(Patients, WebMobileApp, "Interacts with the platform via mobile and web interfaces", "HTTPS / WebSockets")
Rel(Clinicians, WebMobileApp, "Manages consultations and patient care via web client", "HTTPS / WebSockets")
Rel(RegionalPharmacists, WebMobileApp, "Accesses prescription fulfillment workflows", "HTTPS")

Rel(WebMobileApp, APIGateway, "Sends API requests and WebSocket messages", "HTTPS / WebSockets")
Rel(WebMobileApp, VideoMediaServer, "Connects for video consultations (signaled via API Gateway)", "WebRTC")

Rel(APIGateway, CoreServicesContainer, "Routes backend requests securely", "gRPC over mTLS")

Rel(CoreServicesContainer, AISymptomCheckerContainer, "Sends inference requests", "gRPC over mTLS")
Rel(CoreServicesContainer, IntegrationServiceContainer, "Dispatches events via regionally isolated topics", "Cloud Pub/Sub")
Rel(CoreServicesContainer, CloudSQLPostgreSQL, "Reads and writes relational data", "JDBC / SQL")
Rel(CoreServicesContainer, CloudStorage, "Reads and writes encrypted files", "HTTPS / GCP API")
Rel(CoreServicesContainer, RegionalIdentityProviders, "Authenticates users", "OIDC / OAuth2")

Rel(IntegrationServiceContainer, EUNationalEPrescriptionGateways, "Sends e-prescription data", "REST / HL7 FHIR")
Rel(IntegrationServiceContainer, USPharmacyNetworks, "Sends e-prescription data", "REST / HL7 FHIR")

@enduml