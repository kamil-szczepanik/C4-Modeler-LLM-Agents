@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(Patients_and_Licensed_Clinicians, "Patients and Licensed Clinicians", "Mobile and web clients interacting with the telehealth platform for consultations, e-prescriptions, and symptom checking.")
System_Ext(EU_Telehealth_System, "EU Telehealth System", "Regional deployment located in europe-west3 handling EU operations under GDPR.")
System_Ext(US_Telehealth_System, "US Telehealth System", "Regional deployment located in us-central1 handling US operations under HIPAA.")
System_Ext(External_EU_National_EPrescription_Gateways_and_US_Pharmacy_Networks, "External EU National E-Prescription Gateways and US Pharmacy Networks", "External networks and gateways for processing e-prescriptions.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(API_Gateway, "API Gateway", "Cloud Armor, Cloud Load Balancing", "Entry point managing inbound traffic, security, and load balancing across regional deployments.")
    Container(Patient_PWA_Clinician_Dashboard_Frontends, "Patient PWA & Clinician Dashboard Frontends", "React, Cloud Storage, Cloud CDN", "Web and progressive web application frontends for patients and clinicians.")
    Container(Core_Telehealth_Backend, "Core Telehealth Backend", "Node.js, Express", "Core backend service handling business logic, consultations, and prescriptions.")
    Container(AI_Symptom_Checker_Service, "AI Symptom Checker Service", "Python, FastAPI", "AI service providing automated symptom checking for patients.")
    Container(Video_Media_Router, "Video Media Router", "Mediasoup SFU", "Real-time video media router for video consultations in degraded network conditions.")
    Container(Consent_Preference_Management_Service, "Consent & Preference Management Service", "Node.js, Express", "Manages patient consent, data preferences, and compliance tracking.")
    ContainerDb(Data_Tier, "Data Tier", "Cloud SQL PostgreSQL, Cloud Storage, Cloud KMS", "Region-isolated relational databases and object storage encrypted with CMEK.")
}

Rel(Patients_and_Licensed_Clinicians, API_Gateway, "Sends HTTPS/WSS/WebRTC requests to access the platform frontends and services", "HTTPS/WSS/WebRTC")
Rel(Patient_PWA_Clinician_Dashboard_Frontends, API_Gateway, "Communicates via API calls through the gateway", "HTTPS")
Rel(API_Gateway, Core_Telehealth_Backend, "Routes API requests to the core backend", "gRPC / mTLS")
Rel(API_Gateway, Consent_Preference_Management_Service, "Routes consent and preference queries", "gRPC / mTLS")
Rel(Core_Telehealth_Backend, Data_Tier, "Reads and writes patient and clinical data", "TCP/PostgreSQL")
Rel(AI_Symptom_Checker_Service, Core_Telehealth_Backend, "Communicates symptom analysis results and data", "gRPC / mTLS")
Rel(Core_Telehealth_Backend, Video_Media_Router, "Coordinates video consultation sessions", "WebRTC")
Rel(Cross_Border_Telehealth_Platform, EU_Telehealth_System, "Processes regional workloads for compliance and data residency", "GCP europe-west3 with VPC Service Controls")
Rel(Cross_Border_Telehealth_Platform, US_Telehealth_System, "Processes regional workloads for compliance and data residency", "GCP us-central1 with VPC Service Controls")
Rel(Cross_Border_Telehealth_Platform, External_EU_National_EPrescription_Gateways_and_US_Pharmacy_Networks, "Fulfills e-prescriptions and medication requests", "REST/FHIR over mTLS")

@enduml