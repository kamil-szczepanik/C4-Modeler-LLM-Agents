@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_and_Licensed_Clinicians, "Patients and Licensed Clinicians", "Mobile and web clients interacting with the telehealth platform for consultations, e-prescriptions, and symptom checking.")
System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides secure video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and US with strict regional data residency, HIPAA/GDPR compliance, and EU MDR traceability.")
System_Ext(EU_Telehealth_System, "EU Telehealth System", "Regional deployment located in europe-west3 handling EU operations.")
System_Ext(US_Telehealth_System, "US Telehealth System", "Regional deployment located in us-central1 handling US operations.")
System_Ext(AI_Symptom_Checker_Subsystem, "AI Symptom Checker Subsystem", "Subsystem providing AI-driven symptom checking.")
System_Ext(External_EU_National_E_Prescription_Gateways_and_US_Pharmacy_Networks, "External EU National E-Prescription Gateways and US Pharmacy Networks", "External networks and gateways for processing e-prescriptions.")
System_Ext(Third_Party_Video_Infrastructure, "Third-Party Video Infrastructure", "WebRTC-based infrastructure providing video consultation capabilities.")
System_Ext(Zero_Trust_Consent_Gateways, "Zero-Trust Consent Gateways", "Cryptographically isolated proxies managing cross-region access with OAuth 2.0 and signed consent scopes.")

Rel(Patients_and_Licensed_Clinicians, Cross_Border_Telehealth_Platform, "Accesses video consultations, e-prescriptions, and symptom checker", "HTTPS (REST/GraphQL) and WebRTC (secure SRTP/DTLS)")
Rel(Cross_Border_Telehealth_Platform, EU_Telehealth_System, "Processes regional workloads for compliance and data residency", "GCP europe-west3 with VPC Service Controls")
Rel(Cross_Border_Telehealth_Platform, US_Telehealth_System, "Processes regional workloads for compliance and data residency", "GCP us-central1 with VPC Service Controls")
Rel(Cross_Border_Telehealth_Platform, AI_Symptom_Checker_Subsystem, "Evaluates patient symptoms", "mTLS")
Rel(Cross_Border_Telehealth_Platform, External_EU_National_E_Prescription_Gateways_and_US_Pharmacy_Networks, "Fulfills e-prescriptions and medication requests", "REST/FHIR over mTLS")
Rel(Cross_Border_Telehealth_Platform, Third_Party_Video_Infrastructure, "Facilitates secure video consultations", "WebRTC")
Rel(Cross_Border_Telehealth_Platform, Zero_Trust_Consent_Gateways, "Manages secure cross-region access and consent", "OAuth 2.0 and signed consent scopes")
@enduml