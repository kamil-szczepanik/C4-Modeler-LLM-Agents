@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component Diagram for Patient PWA & Clinician Dashboard Frontends

System_Ext(api_gateway, "API Gateway", "Cloud Armor, Cloud Load Balancing", "Handles incoming API requests and authentication.")
System_Ext(video_router, "Video Media Router (SFU)", "Mediasoup SFU", "Handles WebRTC media streams with DTLS-SRTP.")

Container_Boundary(frontend_container, "Patient Pwa & Clinician Dashboard Frontends") {
    Component(patient_pwa, "Patient PWA", "React 18+, TypeScript, Zustand", "Provides video consultations, e-prescriptions, and AI symptom checker interface for patients in the EU and US.")
    Component(clinician_dashboard, "Clinician Dashboard", "React 18+, TypeScript, Zustand", "Allows clinicians to view patient data, fetch FHIR records, and manage e-prescriptions.")
    Component(ai_symptom_checker_ui, "AI Symptom Checker UI", "React 18+, TypeScript", "Submits symptom payloads to the API Gateway.")
    Component(video_consultation_view, "Video Consultation View", "WebRTC, React 18+", "Handles video consultation streams via the Video Media Router.")
    Component(service_workers_workbox, "Service Workers Workbox", "Workbox", "Provides PWA offline caching and resilience for unstable connections.")
}

Rel(patient_pwa, api_gateway, "API requests and authentication", "HTTPS")
Rel(clinician_dashboard, api_gateway, "Fetches FHIR/e-prescription data", "HTTPS")
Rel(ai_symptom_checker_ui, api_gateway, "Submits symptom payloads", "HTTPS")
Rel(video_consultation_view, video_router, "WebRTC media streams", "DTLS-SRTP")

@enduml