@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(AuthConsentInspectionProxy, "Auth & Consent Inspection Proxy", "Envoy Proxy", "Performs OAuth2/OIDC validation, consent inspection, and W3C trace context injection.")
    Component(mTLSUpstreamDispatcher, "mTLS Upstream Dispatcher", "Envoy Proxy", "Forwards validated requests securely to upstream regional backends using mTLS.")
}

Rel(AuthConsentInspectionProxy, mTLSUpstreamDispatcher, "Forwards validated requests", "gRPC")

@enduml