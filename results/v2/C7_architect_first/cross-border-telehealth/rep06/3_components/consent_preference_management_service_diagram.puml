@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(consent_boundary, "Consent & Preference Management Service") {
    Component(ConsentAPIController, "Consent API Controller", "Node.js, Express", "Handles incoming API requests related to consent and preference management.")
    Component(ConsentEvaluationEngine, "Consent Evaluation Engine", "Node.js, Express, TypeScript", "Evaluates active consent states and policies for data access.")
    Component(AuditPublisherComponent, "Audit Publisher Component", "Node.js, Express, GCP Pub/Sub SDK", "Dispatches asynchronous audit logs for consent evaluation events.")
    Component(ConsentCacheManager, "Consent Cache Manager", "Node.js, Express, GCP Memorystore Redis", "Manages the caching layer for active consent states to ensure low latency.")
    Component(ConsentDataAccessRepository, "Consent Data Access Repository", "Node.js, Express, Cloud SQL PostgreSQL", "Interacts with the relational data store for persistent consent records.")
}

System_Ext(GCPPubSub, "GCP Pub/Sub", "Resilient message transport for audit logs.")

Rel(ConsentAPIController, ConsentEvaluationEngine, "In-memory function calls", "TypeScript")
Rel(ConsentEvaluationEngine, ConsentCacheManager, "TCP / Redis Protocol", "TLS")
Rel(ConsentEvaluationEngine, AuditPublisherComponent, "Asynchronous dispatch", "GCP Pub/Sub SDK")
Rel(ConsentEvaluationEngine, ConsentDataAccessRepository, "Parameterized SQL", "TLS 1.3 / IAM Auth")
Rel(AuditPublisherComponent, GCPPubSub, "HTTPS", "TLS 1.3")

@enduml