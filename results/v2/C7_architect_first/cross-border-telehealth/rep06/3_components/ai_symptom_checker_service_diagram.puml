@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component Diagram for the AI Symptom Checker Service

Container_Boundary(ai_symptom_checker_service, "AI Symptom Checker Service") {
    Component(ApiRouter, "API Router / Controller", "FastAPI", "Handles incoming gRPC requests")
    Component(ClinicalNlp, "Clinical NLP / Feature Extractor", "spaCy / SciSpaCy", "Normalizes text into HL7 FHIR / SNOMED CT")
    Component(InferenceEngine, "Inference Engine", "PyTorch / Hugging Face", "Executes clinical triage models")
    Component(ExplainabilityModule, "Explainability Module", "SHAP / LIME", "Generates feature-attribution weights")
    ComponentDb(SemanticCachingComponent, "Semantic Caching Component", "Regional Memorystore for Redis", "Caches symptom results")
    Component(AuditLogger, "Audit & Traceability Logger", "Regional Cloud SQL & WORM Cloud Storage", "Captures synchronous write-ahead logs")
}

System_Ext(CoreTelehealthBackend, "Core Telehealth Backend", "External backend sending symptom data")
System_Ext(ClinicianDashboard, "Clinician Dashboard", "External dashboard receiving transparency data")

Rel(CoreTelehealthBackend, ApiRouter, "Sends symptom data", "gRPC / mTLS")
Rel(ApiRouter, SemanticCachingComponent, "Checks for cached triage results", "Redis Protocol / mTLS")
Rel(ApiRouter, InferenceEngine, "Evaluates uncached symptom inputs", "Internal Python function call")
Rel(InferenceEngine, AuditLogger, "Persists immutable logs", "Regional Cloud SQL & WORM Cloud Storage")
Rel(ExplainabilityModule, ClinicianDashboard, "Provides transparency data", "HTTPS / REST")

@enduml