@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Video Media Router container

Container_Boundary(video_media_router, "Video Media Router") {
    Component(Signaling_Handler, "Signaling Handler", "Node.js / WebSockets", "Manages signaling connections and authenticates room parameters.")
    Component(SFU_Worker_Manager, "SFU Worker Manager", "Mediasoup SFU Worker", "Manages underlying worker processes and communicates with the ABR Controller.")
    Component(ABR_Controller, "ABR Controller", "Node.js / Internal IPC", "Monitors packet loss and adjusts streams for low-bandwidth resilience.")
    Component(Media_Relayer_Transport, "Media Relayer/Transport", "WebRTC / UDP", "Relays media streams between participants.")
    Component(DTLS_SRTP_Encryptor_Decryptor, "DTLS-SRTP Encryptor/Decryptor", "SRTP over UDP", "Secures media streams with ephemeral key negotiation.")
    Component(Event_Dispatcher, "Event Dispatcher", "Internal Event Bus", "Triggers fallback notifications and system events.")
}

Rel(SFU_Worker_Manager, ABR_Controller, "Monitors packet loss and adjusts streams", "Internal IPC")
Rel(ABR_Controller, Event_Dispatcher, "Triggers fallback notifications", "Internal Event Bus")
Rel(Media_Relayer_Transport, DTLS_SRTP_Encryptor_Decryptor, "Secures media streams", "SRTP over UDP")

@enduml