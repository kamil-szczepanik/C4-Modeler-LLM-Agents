@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(core_telehealth_backend, "Core Telehealth Backend") {
    Component(Consultation_Orchestrator, "Consultation Orchestrator", "Node.js, Express", "Coordinates video sessions and manages telehealth workflows.")
    Component(Prescription_Manager, "Prescription Manager", "Node.js, Express", "Manages e-prescriptions and interacts with external regional gateways.")
    Component(Audit_Compliance_Logger, "Audit & Compliance Logger", "Node.js, Express", "Logs compliance data and ensures cryptographic sealing for audit trails.")
    Component(Identity_Consent_Enforcer, "Identity & Consent Enforcer", "Node.js, Express", "Validates access rights and consent scopes for secure operations.")
}

System_Ext(Video_Media_Router, "Video Media Router", "Mediasoup SFU")
System_Ext(Data_Tier, "Data Tier", "Cloud SQL PostgreSQL, Cloud Storage, Cloud KMS")
System_Ext(External_Gateways, "External EU National E-Prescription Gateways and US Pharmacy Networks", "External Systems")

Rel(Consultation_Orchestrator, Video_Media_Router, "Coordinates video sessions", "WebRTC")
Rel(Consultation_Orchestrator, Identity_Consent_Enforcer, "Validates access rights and consent scopes", "Internal gRPC")
Rel(Prescription_Manager, Identity_Consent_Enforcer, "Validates access rights and consent scopes", "Internal gRPC")
Rel(Consultation_Orchestrator, Data_Tier, "Reads/writes clinical data", "TCP/PostgreSQL")
Rel(Prescription_Manager, Data_Tier, "Reads/writes clinical data", "TCP/PostgreSQL")
Rel(Audit_Compliance_Logger, Data_Tier, "Writes immutable compliance data", "TCP/PostgreSQL")
Rel(Prescription_Manager, External_Gateways, "Transmits regional prescriptions", "HTTPS / TLS 1.3")

@enduml