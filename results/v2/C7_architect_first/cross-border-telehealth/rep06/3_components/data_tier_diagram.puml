@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Tier container

System_Ext(Core_Telehealth_Backend, "Core Telehealth Backend", "Backend Service", "External telehealth backend that reads and writes clinical data, consent preferences, and sync queues.")

Container_Boundary(Data_Tier, "Data Tier") {
    Component(Region_Isolated_PostgreSQL_Instances, "Region-Isolated PostgreSQL Instances", "Cloud SQL PostgreSQL", "Independent clusters in europe-west3 and us-central1 providing region-isolated relational storage with Row-Level Security (RLS) for consent enforcement.")
    Component(Encrypted_Object_Store, "Encrypted Object Store", "Cloud Storage", "Buckets for storing media and AI artifacts securely.")
    Component(Key_Management_Service, "Key Management Service", "Cloud KMS", "Enforces region-locked Customer-Managed Encryption Keys (CMEK) to guarantee GDPR and HIPAA compliance.")
    Component(Audit_Ledger_Subsystem, "Audit Ledger Subsystem", "PostgreSQL Append-Only Tables", "Append-only tables with cryptographic hashing ensuring full traceability for EU MDR compliance.")
    Component(Connection_Management, "Connection Management", "PgBouncer", "Sidecars for connection pooling, managing intermittent rural reconnection spikes and preventing database exhaustion.")
    Component(Schema_Migration_Automation, "Schema Migration Automation", "Cloud Deploy", "Automates region-aware, backward-compatible schema migrations.")
}

Rel(Core_Telehealth_Backend, Region_Isolated_PostgreSQL_Instances, "Reads and writes clinical data, consent preferences, and sync queues", "TCP/PostgreSQL via mTLS")
Rel(Region_Isolated_PostgreSQL_Instances, Key_Management_Service, "Requests regional encryption keys and dynamic IAM authentication", "HTTPS/REST")
Rel(Connection_Management, Region_Isolated_PostgreSQL_Instances, "Manages connection pooling and prevents database exhaustion", "TCP/PostgreSQL")
Rel(Region_Isolated_PostgreSQL_Instances, Audit_Ledger_Subsystem, "Records cryptographic audit logs for AI diagnostics and compliance", "Internal")

@enduml