@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients (EU/US)", "Patients located in the EU or US accessing video consultations, e-prescriptions, and the AI symptom checker.")
Person(Clinicians, "Licensed Clinicians", "Licensed medical professionals providing video consultations and issuing e-prescriptions.")
Person(Authorities, "Compliance/Audit Authorities", "Regulatory and audit authorities reviewing system compliance and WORM audit logs.")

System(Platform, "Cross-Border Telehealth Platform", "A cross-border telehealth platform providing video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and US, enforcing strict regional data residency, regulatory compliance, and resilience for low-bandwidth users.")

System_Ext(EUGateways, "EU National E-Prescription Gateways", "External national gateways in the EU for processing e-prescriptions.")
System_Ext(USPharmacies, "US Pharmacy Systems", "External US pharmacy systems for integrating and fulfilling prescriptions.")
System_Ext(IdP, "Identity Providers (OAuth2/OIDC)", "External identity providers handling authentication via OAuth2 and OIDC.")

Rel(Patients, Platform, "Interact with regional platform instances for consultations and symptom checking", "HTTPS, WebRTC (SRTP/DTLS-SRTP)")
Rel(Clinicians, Platform, "Provide telehealth consultations and manage patient care", "HTTPS, WebRTC (SRTP/DTLS-SRTP)")
Rel(Authorities, Platform, "Review system audit logs and compliance data", "HTTPS")
Rel(Platform, EUGateways, "Integrates with EU gateways for e-prescriptions", "REST/SOAP")
Rel(Platform, USPharmacies, "Integrates with US pharmacy systems for prescription fulfillment", "HL7 FHIR, NCPDP")
Rel(Platform, IdP, "Authenticates users", "OAuth2/OIDC")

@enduml