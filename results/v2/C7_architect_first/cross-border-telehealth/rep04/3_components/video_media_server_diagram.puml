@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(PatientsClinicians, "Patients/Clinicians", "Users participating in telehealth consultations")
System_Ext(APIGateway, "API Gateway", "External API Gateway handling ingress requests")
System_Ext(GCPCloudStorage, "GCP Cloud Storage", "Region-locked storage enforcing data residency")

Container_Boundary(VideoMediaServer, "Video Media Server") {
    Component(WebRTC_Ingress_Egress_Handler, "WebRTC Ingress/Egress Handler", "LiveKit SDK / C++", "Handles live video and audio media streams using WebRTC over UDP/TCP, DTLS/SRTP.")
    Component(Adaptive_Bitrate_ABR_Controller, "Adaptive Bitrate (ABR) Controller", "LiveKit SFU", "Maintains stable consultations in rural areas below 300 kbit/s.")
    Component(Session_Auth_Coordinator, "Session & Auth Coordinator", "Backend Service", "Manages room creation, participant management, and real-time control events.")
    Component(Media_Recorder, "Media Recorder", "GStreamer / GCP Cloud Storage", "Handles secure local and archived session media recording.")
    Component(Distributed_TURN_Relays, "Distributed TURN Relays", "TURN / Network Infrastructure", "Ensures communication across unstable rural network connections.")
    Component(Redis_PubSub_Event_Bus, "Redis Pub/Sub Event Bus", "Redis", "In-memory event bus for real-time control messaging and consent updates.")
}

Rel(APIGateway, Session_Auth_Coordinator, "Room creation and participant management", "gRPC")
Rel(PatientsClinicians, WebRTC_Ingress_Egress_Handler, "Video and audio media streams", "WebRTC over UDP/TCP, DTLS/SRTP")
Rel(Session_Auth_Coordinator, Media_Recorder, "Real-time control events for consent management", "Redis Pub/Sub")
Rel(Media_Recorder, GCPCloudStorage, "Encrypted session archives", "HTTPS / Regional CMEK")

@enduml