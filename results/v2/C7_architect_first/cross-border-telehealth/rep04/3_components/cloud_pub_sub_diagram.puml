@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(cloud_pub_sub, "Cloud Pub/Sub") {
    Component(Topic_Router, "Topic Router", "Google Cloud Pub/Sub", "Routes validated events to regional topics.")
    Component(Schema_Registry, "Schema Registry", "Google Cloud Pub/Sub", "Validates raw event payloads.")
    Component(Retry___Backoff_Controller, "Retry & Backoff Controller", "Google Cloud Pub/Sub", "Manages retry and backoff logic for messaging.")
    Component(DLQ_Handler, "DLQ Handler", "Google Cloud Pub/Sub", "Handles dead letter queues for failed message deliveries.")
    Component(Audit_Logger, "Audit Logger", "Google Cloud Pub/Sub", "Logs event activities for auditing and traceability.")
}

Rel(Schema_Registry, Topic_Router, "Forwards validated events", "Internal Buffer")
Rel(DLQ_Handler, Interoperability_Worker, "Triggers redelivery or alerts", "gRPC")

@enduml