@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Symptom Service container

Container_Boundary(ai_symptom_service, "AI Symptom Service") {
    Component(api_controller, "API Controller", "Python / FastAPI", "Routes requests via gRPC over VPC.")
    Component(symptom_inference_engine, "Symptom Inference Engine", "Python / FastAPI", "Evaluates inputs in-process.")
    Component(traceability_audit_logger, "Traceability & Audit Logger", "Python / FastAPI", "Delegates audit payloads in-process.")
    Component(data_residency_filter, "Data Residency Filter", "Python / FastAPI", "Filters and isolates data regionally to satisfy GDPR and HIPAA mandates.")
    Component(resilience_fallback_handler, "Resilience & Fallback Handler", "Python / FastAPI", "Maintains availability and traceability for unstable connections.")
}

Rel(api_controller, symptom_inference_engine, "Evaluates inputs in-process")
Rel(symptom_inference_engine, traceability_audit_logger, "Delegates audit payloads in-process")
@enduml