@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Interoperability Worker container

Container_Boundary(interoperability_worker, "Interoperability Worker") {
    Component(PubSubConsumerModule, "PubSub Consumer Module", "Go", "Consumes regional e-prescription tasks from Cloud Pub/Sub.")
    Component(PrescriptionTranslator, "Prescription Translator", "Go", "Maps internal prescription models to EU REST/SOAP and US HL7 FHIR/NCPDP formats.")
    Component(GatewayDispatcher, "Gateway Dispatcher", "Go, mTLS, TLS 1.3", "Transmits prescriptions securely to EU National E-Prescription Gateways and US Pharmacy Systems.")
    Component(StatusNotifier, "Status Notifier", "Go, gRPC", "Pushes delivery status updates back to the Core Telehealth Backend.")
}

Rel(PubSubConsumerModule, PrescriptionTranslator, "Passes raw e-prescription messages for transformation")
Rel(PrescriptionTranslator, GatewayDispatcher, "Forwards formatted prescription payloads")
Rel(GatewayDispatcher, StatusNotifier, "Triggers status updates upon transmission completion")

@enduml