@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the BigQuery container

System_Ext(CloudPubSub, "Cloud Pub/Sub", "External System")
System_Ext(AISymptomServiceCompliancePortal, "AI Symptom Service / Compliance Portal", "External System")

Container_Boundary(BigQuery, "BigQuery") {
    Component(EUUSAnalyticsDatasets, "EU/US Analytics Datasets", "Google Cloud BigQuery", "Regional datasets enforcing strict EU/US data residency compliance and storing audit logs and telemetry.")
    Component(BigQueryWriteAPI, "BigQuery Write API", "gRPC", "Batch-loads audit logs and telemetry data from Cloud Pub/Sub into regional datasets.")
    Component(AuthorizedViews, "Authorized Views", "BigQuery SQL API", "Safely exposes aggregated AI metrics and audit reports to internal teams and auditors without exposing raw PHI.")
    Component(BigQueryReservationAPI, "BigQuery Reservation API", "Management API", "Allocates and isolates compute capacity for regional analytics datasets.")
}

Rel(CloudPubSub, EUUSAnalyticsDatasets, "Batch-loads audit logs via BigQuery Storage Write API", "gRPC")
Rel(AISymptomServiceCompliancePortal, AuthorizedViews, "Queries aggregated AI metrics and audit reports", "BigQuery SQL API")
Rel(BigQueryReservationAPI, EUUSAnalyticsDatasets, "Allocates and isolates compute capacity", "Management API")

@enduml