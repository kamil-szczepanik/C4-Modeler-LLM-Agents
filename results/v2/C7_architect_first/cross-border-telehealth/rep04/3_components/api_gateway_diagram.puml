@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(Edge_Routing_Proxy, "Edge Routing Proxy", "Envoy Proxy / Google Cloud Run", "Handles edge routing, WASM consent filters, and rate-limiting to support unstable connections.")
    Component(Web_Security_WAF, "Web Security WAF", "Google Cloud Armor", "Provides API threat protection and DDoS mitigation.")
}

Rel(Edge_Routing_Proxy, Web_Security_WAF, "Inspects inbound traffic for threats", "")

@enduml