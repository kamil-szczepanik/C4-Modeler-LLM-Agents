@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(core_telehealth_backend, "Core Telehealth Backend") {
    Component(ConsentManager, "ConsentManager", "TypeScript", "Validates purpose-based consent and stores cryptographic consent tokens using Prisma ORM over regional VPC.")
    Component(AuditLogger, "AuditLogger", "TypeScript", "Encrypts audit payloads using GCP KMS API and dispatches audit events asynchronously via Pub/Sub SDK.")
    Component(FhirAdapter, "FhirAdapter", "TypeScript", "Handles healthcare data interoperability and FHIR standard translations.")
    Component(PatientPortalAPI, "PatientPortalAPI", "TypeScript / NestJS", "Exposes endpoints for patient portal interactions and validates consent via in-process calls.")
}

System_Ext(Cloud_SQL, "Cloud SQL", "PostgreSQL database storing persistent relational data.")
System_Ext(Cloud_KMS, "Cloud KMS", "Google Cloud Key Management Service for encryption operations.")
System_Ext(Cloud_Pub_Sub, "Cloud Pub/Sub", "Google Cloud messaging service for asynchronous event publishing.")

Rel(PatientPortalAPI, ConsentManager, "Validates purpose-based consent via in-process TypeScript calls")
Rel(ConsentManager, Cloud_SQL, "Stores cryptographic consent tokens using Prisma ORM over regional VPC")
Rel(AuditLogger, Cloud_KMS, "Encrypts audit payloads before transport via GCP KMS API")
Rel(AuditLogger, Cloud_Pub_Sub, "Dispatches audit events asynchronously using Pub/Sub SDK")

@enduml