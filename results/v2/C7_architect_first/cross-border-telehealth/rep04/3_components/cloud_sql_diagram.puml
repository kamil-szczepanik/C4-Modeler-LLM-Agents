@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Cloud SQL container

System_Ext(Core_Telehealth_Backend, "Core Telehealth Backend", "External system connecting to the database")
System_Ext(Cloud_KMS, "Cloud KMS", "Provides Customer-Managed Encryption Keys (CMEK)")

Container_Boundary(Cloud_SQL, "Cloud SQL") {
    Component(PostgreSQL_Database_Engine, "PostgreSQL Database Engine", "PostgreSQL 15", "Managed relational database service configured with physically isolated instances per region to satisfy GDPR and HIPAA.")
    Component(Row_Level_Security_RLS_Policy_Enforcer, "Row-Level Security (RLS) Policy Enforcer", "PostgreSQL RLS", "Enforces data access boundaries based on regional and user context.")
    Component(Audit_Logging_Extension_pgAudit, "Audit Logging Extension (pgAudit)", "pgAudit", "Intercepts and logs transactional events to Cloud Logging.")
    Component(Consent_Indexing_Verification_Engine, "Consent Indexing & Verification Engine", "PostgreSQL Extension / Pl/pgSQL", "Validates patient data-sharing scope before transactional writes.")
    Component(PgBouncer_Connection_Pooler, "PgBouncer Connection Pooler", "PgBouncer", "Connection pooling service at container ingress to manage rural internet reconnection surges.")
}

Rel(Core_Telehealth_Backend, PostgreSQL_Database_Engine, "Executes SQL queries over TLS", "TCP/PostgreSQL Protocol via mTLS")
Rel(Core_Telehealth_Backend, Consent_Indexing_Verification_Engine, "Validates patient data-sharing scope before transactional writes", "TCP/PostgreSQL Protocol")
Rel(PostgreSQL_Database_Engine, Audit_Logging_Extension_pgAudit, "Intercepts and logs transactional events to Cloud Logging", "Internal IPC")
Rel(PostgreSQL_Database_Engine, Cloud_KMS, "Encrypts data-at-rest using regional Customer-Managed Encryption Keys", "Google Cloud API")
@enduml