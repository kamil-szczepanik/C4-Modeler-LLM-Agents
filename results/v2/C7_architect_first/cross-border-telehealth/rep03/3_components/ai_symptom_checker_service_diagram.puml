@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(ai_symptom_checker_service, "AI Symptom Checker Service") {
    Component(API_Controller_Component, "API Controller Component", "Python / FastAPI", "Routes symptom checking requests and returns compliant payloads.")
    Component(Inference_Orchestrator_Component, "Inference Orchestrator Component", "Python / FastAPI", "Delegates pseudonymized analysis and interacts with the AI model registry.")
    Component(Audit_Compliance_Logger_Component, "Audit & Compliance Logger Component", "Python / FastAPI, OpenTelemetry", "Emits prediction audit events and writes immutable logs.")
    Component(Response_Formatting_Disclaimer_Engine_Component, "Response Formatting & Disclaimer Engine Component", "Python / FastAPI", "Passes raw triage output and applies required compliance disclaimers.")
}

System_Ext(Data_Storage_Layer, "Data Storage Layer", "Cloud SQL PostgreSQL + WORM Cloud Storage")

Rel(API_Controller_Component, Inference_Orchestrator_Component, "Delegates pseudonymized analysis", "In-memory")
Rel(Inference_Orchestrator_Component, Audit_Compliance_Logger_Component, "Emits prediction audit events", "Async Pub/Sub")
Rel(Inference_Orchestrator_Component, Response_Formatting_Disclaimer_Engine_Component, "Passes raw triage output", "In-memory")
Rel(Response_Formatting_Disclaimer_Engine_Component, API_Controller_Component, "Returns compliant payload", "In-memory")
Rel(Audit_Compliance_Logger_Component, Data_Storage_Layer, "Writes immutable logs", "SSL-enforced TCP/Postgres & WORM Storage")

@enduml