@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

System_Ext(External_Identity_Providers, "External Identity Providers", "External Systems")
System_Ext(Consultation_Service, "Consultation Service", "Go, WebRTC SFU")
System_Ext(AI_Symptom_Checker_Service, "AI Symptom Checker Service", "Python / FastAPI")
System_Ext(E_Prescription___Interoperability_Service, "E-Prescription & Interoperability Service", "Node.js / Java")

Container_Boundary(api_gateway, "API Gateway") {
    Component(Edge_Router_and_Load_Shedder, "Edge Router and Load Shedder", "Envoy / Google Cloud API Gateway", "Handles edge routing, rate limiting, TLS 1.3 termination, and regional traffic management.")
    Component(Auth_Component, "Auth Component", "OIDC / JWKS", "Validates tokens against External Identity Providers.")
}

Rel(Edge_Router_and_Load_Shedder, Consultation_Service, "Routes consultation requests", "gRPC over mTLS")
Rel(Edge_Router_and_Load_Shedder, AI_Symptom_Checker_Service, "Routes symptom checking requests with W3C Trace Context", "gRPC over mTLS")
Rel(Edge_Router_and_Load_Shedder, E_Prescription___Interoperability_Service, "Routes e-prescription requests", "gRPC over mTLS")
Rel(Auth_Component, External_Identity_Providers, "Token validation", "OIDC/JWKS over HTTPS")

@enduml