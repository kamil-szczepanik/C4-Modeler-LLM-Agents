@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Consultation Service container

System_Ext(api_gateway, "API Gateway", "External API Gateway routing requests.")
System_Ext(data_storage, "Data Storage Layer", "Regional session states persistence.")
System_Ext(client_apps, "Client Applications", "End-user applications.")

Container_Boundary(consultation_service, "Consultation Service") {
    Component(SignalingComponent, "Signaling Component", "Go, WebSockets", "Manages WebRTC connection setup and room coordination.")
    Component(SFUMediaRouter, "SFU Media Router", "Go, Pion WebRTC", "Handles media mixing and routing with adaptive bitrate control.")
    Component(SessionManagementComponent, "Session Management Component", "Go", "Enforces access control, checks patient consent, and logs session metadata.")
    Component(BandwidthAdaptatorComponent, "Bandwidth Adaptator Component", "Go", "Dynamically monitors stream metrics and triggers downscaling for degraded mode.")
}

Rel(api_gateway, SignalingComponent, "Routes consultation requests", "gRPC over mTLS")
Rel(SignalingComponent, SFUMediaRouter, "Manages media tracks", "In-process / Go function calls")
Rel(SignalingComponent, SessionManagementComponent, "Validates auth tokens", "In-process")
Rel(BandwidthAdaptatorComponent, SFUMediaRouter, "Adjusts track bitrates dynamically", "In-process / Go channels")
Rel(SessionManagementComponent, data_storage, "Persists regional session states", "SSL-enforced TCP/Postgres")
Rel(SFUMediaRouter, client_apps, "Relays encrypted video/audio", "DTLS-SRTP")

@enduml