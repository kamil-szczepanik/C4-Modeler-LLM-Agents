@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(API_Gateway, "API Gateway", "Envoy / Google Cloud API Gateway", "External API Gateway handling routing and security for backend services.")

Container_Boundary(Web_Mobile_Frontend_Applications, "Web & Mobile Frontend Applications") {
    Component(UI_Router___State_Management_Component, "UI Router & State Management Component", "Flutter / React State Management", "Manages application navigation, view states, and client-side data flow across mobile and web interfaces.")
    Component(Video_Consultation_Module, "Video Consultation Module", "WebRTC / Flutter WebRTC", "Handles real-time media streams and adaptive bitrate control for video consultations over unstable rural connections.")
    Component(AI_Symptom_Checker_UI_Component, "AI Symptom Checker UI Component", "Flutter / React", "Allows patients to submit symptoms and receive traceable model outputs.")
    Component(Patient_Consent_Dashboard_Component, "Patient Consent Dashboard Component", "Flutter / React", "Enables users to manage and submit granular consent preferences for cross-border compliance.")
}

Rel(Video_Consultation_Module, API_Gateway, "Streams media and signaling", "WSS / WebRTC DTLS/SRTP")
Rel(AI_Symptom_Checker_UI_Component, API_Gateway, "Submits symptoms and receives traceable model outputs", "HTTPS / REST")
Rel(Patient_Consent_Dashboard_Component, API_Gateway, "Submits granular consent preferences", "HTTPS / REST")
@enduml