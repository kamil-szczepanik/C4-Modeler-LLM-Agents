@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Storage Layer container

System_Ext(Consultation_Service, "Consultation Service", "External service interacting with the Data Storage Layer.")
System_Ext(AI_Symptom_Checker_Service, "AI Symptom Checker Service", "External service interacting with the Data Storage Layer.")
System_Ext(E_Prescription___Interoperability_Service, "E-Prescription & Interoperability Service", "External service interacting with the Data Storage Layer.")

Container_Boundary(data_storage_layer, "Data Storage Layer") {
    Component(EU_Data_Store, "EU Data Store", "GCP europe-west3 (Cloud SQL PostgreSQL & Cloud Storage)", "Region-isolated persistent storage, structured PHI/PII, and unstructured media for European deployments.")
    Component(US_Data_Store, "US Data Store", "GCP us-central1 (Cloud SQL PostgreSQL & Cloud Storage)", "Region-isolated persistent storage, structured PHI/PII, and unstructured media for US deployments.")
    Component(Clinical_Database, "Clinical Database", "Cloud SQL PostgreSQL", "Stores structured PHI/PII and e-prescriptions using Row-Level Security.")
    Component(Consent___Audit_Engine, "Consent & Audit Engine", "PostgreSQL Schema/Triggers", "Maintains immutable audit logs and granular consent states.")
    Component(Blob_Storage_Repository, "Blob Storage Repository", "Cloud Storage", "Handles unstructured media and raw AI payloads via regional buckets.")
    Component(Data_Access_Proxy, "Data Access Proxy", "Envoy / Sidecar", "Intercepts traffic to inject regional context and validate client certificates.")
    Component(PgBouncer, "PgBouncer", "PgBouncer", "Manages connection pooling for high availability during peak hours.")
}

Rel(Consultation_Service, Data_Access_Proxy, "Reads and writes consultation data", "SSL-enforced TCP/Postgres via mTLS")
Rel(AI_Symptom_Checker_Service, Data_Access_Proxy, "Reads and writes symptom check data and model versions", "SSL-enforced TCP/Postgres")
Rel(E_Prescription___Interoperability_Service, Data_Access_Proxy, "Reads and writes prescription data", "SSL-enforced TCP/Postgres")
Rel(Data_Access_Proxy, Clinical_Database, "Routes regional traffic and injects session context", "Local TCP")

@enduml