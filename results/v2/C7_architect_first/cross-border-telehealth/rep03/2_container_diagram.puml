@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "Mobile and Web clients who use the platform for video consultations, e-prescriptions, and AI symptom checking.")
Person(Clinicians, "Clinicians", "Web clients who use the platform to conduct video consultations and manage patient care.")

System_Ext(ExternalPharmacies, "External Pharmacies", "EU national e-prescription networks and US pharmacy networks that receive prescription orders.")
System_Ext(IdentityProviders, "Identity Providers", "External systems handling authentication via OAuth2/OIDC.")

System_Boundary(CrossBorderTelehealthPlatform, "Cross-Border Telehealth Platform") {
    Container(WebMobileFrontendApplications, "Web & Mobile Frontend Applications", "Flutter / React", "Provides the user interface for patients and clinicians to access platform features.")
    Container(APIGateway, "API Gateway", "Envoy / Google Cloud API Gateway", "Routes incoming requests and enforces security policies at the edge.")
    Container(ConsultationService, "Consultation Service", "Go, WebRTC SFU", "Handles real-time video consultations and communication.")
    Container(AISymptomCheckerService, "AI Symptom Checker Service", "Python / FastAPI", "Provides AI-driven symptom checking functionality for patients.")
    Container(EPrescriptionInteroperabilityService, "E-Prescription & Interoperability Service", "Node.js / Java", "Manages e-prescriptions and interoperability with external pharmacies.")
    ContainerDb(DataStorageLayer, "Data Storage Layer", "Cloud SQL PostgreSQL + Cloud Storage", "Provides secure, region-isolated persistent storage for platform data.")
}

Rel(Patients, WebMobileFrontendApplications, "Interacts with the platform", "HTTPS, WSS")
Rel(Clinicians, WebMobileFrontendApplications, "Interacts with the platform", "HTTPS, WSS")
Rel(WebMobileFrontendApplications, APIGateway, "Sends API requests and establishes WebSocket connections", "HTTPS, REST/JSON, WSS")
Rel(APIGateway, ConsultationService, "Routes consultation requests", "gRPC over mTLS")
Rel(APIGateway, AISymptomCheckerService, "Routes symptom checking requests", "gRPC over mTLS")
Rel(APIGateway, EPrescriptionInteroperabilityService, "Routes e-prescription requests", "gRPC over mTLS")
Rel(ConsultationService, DataStorageLayer, "Reads and writes consultation data", "SSL-enforced TCP/Postgres")
Rel(AISymptomCheckerService, DataStorageLayer, "Reads and writes symptom check data", "SSL-enforced TCP/Postgres")
Rel(EPrescriptionInteroperabilityService, DataStorageLayer, "Reads and writes prescription data", "SSL-enforced TCP/Postgres")
Rel(EPrescriptionInteroperabilityService, ExternalPharmacies, "Sends prescription orders", "HL7 FHIR (US) and national standards (EU)")
Rel(WebMobileFrontendApplications, IdentityProviders, "Authenticates users", "OAuth2/OIDC over HTTPS")

@enduml