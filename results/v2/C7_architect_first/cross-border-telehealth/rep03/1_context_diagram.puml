@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "Mobile and Web clients who use the platform for video consultations, e-prescriptions, and AI symptom checking.")
Person(Clinicians, "Clinicians", "Web clients who use the platform to conduct video consultations and manage patient care.")
System(Cross-Border Telehealth Platform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and the US while ensuring strict cross-border health data residency and regulatory compliance.")
System_Ext(External Pharmacies, "External Pharmacies", "EU national e-prescription networks and US pharmacy networks that receive prescription orders.")
System_Ext(Identity Providers, "Identity Providers", "External systems handling authentication via OAuth2/OIDC.")

Rel(Patients, Cross-Border Telehealth Platform, "Accesses video consultations, e-prescriptions, and AI symptom checker", "HTTPS, WebRTC, OIDC")
Rel(Clinicians, Cross-Border Telehealth Platform, "Manages consultations and patient interactions", "HTTPS, WebRTC, OIDC")
Rel(Cross-Border Telehealth Platform, External Pharmacies, "Sends prescriptions and pharmacy requests", "mTLS, HL7 FHIR (US), REST/SOAP (EU)")
Rel(Cross-Border Telehealth Platform, Identity Providers, "Authenticates users", "OAuth2/OIDC over HTTPS")
@enduml