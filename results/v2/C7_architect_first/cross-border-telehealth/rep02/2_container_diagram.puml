@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "End users receiving video consultations, e-prescriptions, and using the AI symptom checker.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Medical professionals conducting video consultations and issuing prescriptions.")
Person(Local_Pharmacists, "Local Pharmacists", "Pharmacy staff fulfilling e-prescriptions.")
Person(Compliance_Auditors, "Compliance Auditors", "Auditors verifying regulatory compliance and data residency.")
Person(Platform_Administrators, "Platform Administrators", "Administrators managing platform infrastructure and zero-trust IAM.")

System_Ext(National_EU_E_Prescription_Gateways_and_US_Pharmacy_Systems, "National EU E-Prescription Gateways and US Pharmacy Systems", "External systems for processing and fulfilling national e-prescriptions.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(Web_Application___Mobile_Client_Gateway, "Web Application & Mobile Client Gateway", "React / React Native", "Provides secure user interfaces and client gateway for patients, clinicians, and administrators.")
    Container(API_Gateway, "API Gateway", "Node.js / Go", "Routes and manages API requests across the platform services.")
    Container(AI_Symptom_Checker_Service, "AI Symptom Checker Service", "Python / FastAPI, Vertex AI", "Powers the AI symptom checker with model monitoring and immutable audit logging.")
    Container(WebRTC_Video_Session_Orchestrator, "WebRTC Video Session Orchestrator", "WebRTC, STUN/TURN", "Orchestrates secure video consultation sessions with edge-optimized servers.")
    ContainerDb(Database_and_Storage, "Database and Storage", "Google Cloud SQL PostgreSQL, Google Cloud Storage WORM", "Enforces regional encryption via CMEK and WORM audit logging.")
    Container(Service_Mesh, "Service Mesh", "Istio Service Mesh, Envoy proxy", "Orchestrates container workloads and enforces mTLS service mesh security.")
}

Rel(Patients, Web_Application___Mobile_Client_Gateway, "Accesses video consultations, e-prescriptions, and AI symptom checker", "HTTPS / JSON over REST and WebSockets")
Rel(Licensed_Clinicians, Web_Application___Mobile_Client_Gateway, "Conducts video consultations and manages prescriptions", "HTTPS / JSON over REST and WebSockets")
Rel(Local_Pharmacists, Web_Application___Mobile_Client_Gateway, "Fulfills e-prescriptions", "HTTPS / JSON over REST")
Rel(Compliance_Auditors, Web_Application___Mobile_Client_Gateway, "Audits platform compliance and logs", "HTTPS")
Rel(Platform_Administrators, Web_Application___Mobile_Client_Gateway, "Manages platform infrastructure and zero-trust IAM", "HTTPS")
Rel(Web_Application___Mobile_Client_Gateway, API_Gateway, "Sends client requests to core services", "HTTPS / JSON over REST and WebSockets")
Rel(API_Gateway, AI_Symptom_Checker_Service, "Invokes AI symptom analysis and audit logging", "gRPC over mTLS (Istio)")
Rel(API_Gateway, WebRTC_Video_Session_Orchestrator, "Orchestrates video sessions", "gRPC over mTLS (Istio)")
Rel(API_Gateway, Database_and_Storage, "Persists patient data, operational records, and audit logs", "gRPC over mTLS (Istio)")
Rel(AI_Symptom_Checker_Service, Database_and_Storage, "Writes immutable audit logs to WORM storage and invokes Vertex AI", "gRPC over mTLS (Istio) / Cloud APIs")
Rel(API_Gateway, National_EU_E_Prescription_Gateways_and_US_Pharmacy_Systems, "Transmits e-prescriptions securely via interoperability adapters", "mTLS and regional APIs")

@enduml