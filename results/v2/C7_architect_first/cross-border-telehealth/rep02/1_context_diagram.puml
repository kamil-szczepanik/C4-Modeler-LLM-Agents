@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "End users receiving video consultations and using the AI symptom checker.")
Person(LicensedClinicians, "Licensed Clinicians", "Medical professionals conducting video consultations and issuing prescriptions.")
Person(LocalPharmacists, "Local Pharmacists", "Pharmacy staff fulfilling e-prescriptions.")
Person(ComplianceAuditors, "Compliance Auditors", "Auditors verifying regulatory compliance and data residency.")
Person(PlatformAdministrators, "Platform Administrators", "Administrators managing platform infrastructure and zero-trust IAM.")

System_Ext(NationalE_PrescriptionGateways, "National EU E-Prescription Gateways and US Pharmacy Systems", "External systems for processing and fulfilling national e-prescriptions.")
System_Ext(WebRTCVideoInfrastructure, "WebRTC Video Infrastructure", "Regional video infrastructure supporting consultations and degraded modes.")

System_Boundary(cross_border_telehealth_platform, "Cross-Border Telehealth Platform") {
    Container(EUTelehealthPlatform, "EU Telehealth Platform", "Google Cloud Platform (GCP europe-west3), HL7 FHIR, CMEK, OAuth2/OIDC", "GCP europe-west3 isolated deployment for EU users.")
    Container(USTelehealthPlatform, "US Telehealth Platform", "Google Cloud Platform (GCP us-central1), HL7 FHIR, CMEK, OAuth2/OIDC", "GCP us-central1 isolated deployment for US users.")
    Container(RegionalGCPArtifactRegistriesandKMS, "Regional GCP Artifact Registries and KMS", "GCP KMS, GCP Artifact Registries", "Stores cryptographically signed AI model weights and provides CMEK.")
}

Rel(Patients, EUTelehealthPlatform, "Accesses video consultations, e-prescriptions, and AI symptom checker", "HTTPS and TLS 1.3")
Rel(Patients, USTelehealthPlatform, "Accesses video consultations, e-prescriptions, and AI symptom checker", "HTTPS and TLS 1.3")
Rel(LicensedClinicians, EUTelehealthPlatform, "Conducts video consultations and manages prescriptions", "HTTPS and TLS 1.3")
Rel(LicensedClinicians, USTelehealthPlatform, "Conducts video consultations and manages prescriptions", "HTTPS and TLS 1.3")
Rel(EUTelehealthPlatform, NationalE_PrescriptionGateways, "Sends e-prescriptions and interoperability data", "mTLS and regional APIs")
Rel(USTelehealthPlatform, NationalE_PrescriptionGateways, "Sends e-prescriptions and interoperability data", "mTLS and regional APIs")
Rel(EUTelehealthPlatform, WebRTCVideoInfrastructure, "Establishes video consultation sessions supporting sub-300 kbit/s degraded modes", "Regional endpoints")
Rel(USTelehealthPlatform, WebRTCVideoInfrastructure, "Establishes video consultation sessions supporting sub-300 kbit/s degraded modes", "Regional endpoints")
Rel(EUTelehealthPlatform, USTelehealthPlatform, "Performs cross-region data access via token-exchange proxies based on patient consent", "Short-lived OAuth2 tokens")

@enduml