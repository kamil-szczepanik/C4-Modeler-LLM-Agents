@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Routing_Regional_Affinity_Router, "Routing & Regional Affinity Router", "Go", "Enforces regional data residency and routes client requests to appropriate regional downstream services.")
    Component(Authentication_Authorization_Filter, "Authentication & Authorization Filter", "Go", "Validates credentials and enforces granular consent scopes for incoming requests.")
    Component(Rate_Limiting_Circuit_Breaker, "Rate Limiting & Circuit Breaker", "Go", "Protects downstream services from traffic spikes and system failures.")
    Component(Interoperability_Protocol_Adapter, "Interoperability Protocol Adapter", "Go", "Facilitates secure e-prescription transmission and translation to external national EU and US pharmacy systems.")
}

System_Ext(Downstream_Services, "Downstream Services", "Regional downstream microservices")
System_Ext(External_Gateways, "External Gateways", "External national EU and US pharmacy systems")

Rel(Routing_Regional_Affinity_Router, Downstream_Services, "Internal communication", "gRPC over mTLS via Istio Service Mesh")
Rel(Interoperability_Protocol_Adapter, External_Gateways, "E-prescription transmission", "mTLS and regional APIs / HTTPS")

@enduml