@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(ai_symptom_checker_service, "AI Symptom Checker Service") {
    Component(api_router, "API Router", "Python / FastAPI", "Routes incoming symptom analysis requests and manages endpoint traffic.")
    Component(pseudonymization_sanitization, "Pseudonymization & Sanitization", "Python", "Sanitizes patient input and pseudonymizes data to ensure GDPR and HIPAA compliance.")
    Component(inference_orchestrator, "Inference Orchestrator", "Python / FastAPI", "Orchestrates symptom analysis requests and communicates with Vertex AI.")
    Component(audit_traceability, "Audit & Traceability", "Python", "Generates and persists immutable logs for EU MDR traceability.")
    Component(external_fallback_handler, "External Fallback Handler", "Python", "Handles fallback logic and alternative routing when external AI services fail.")
}

Rel(api_router, pseudonymization_sanitization, "Passes raw input for sanitization")
Rel(pseudonymization_sanitization, inference_orchestrator, "Sends sanitized data for inference")
Rel(inference_orchestrator, external_fallback_handler, "Invokes fallback on service failure")
Rel(inference_orchestrator, audit_traceability, "Logs inference steps and decisions")

@enduml