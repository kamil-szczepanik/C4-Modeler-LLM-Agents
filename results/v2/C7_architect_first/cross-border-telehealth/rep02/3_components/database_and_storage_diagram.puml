@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database and Storage container

Container_Boundary(database_and_storage, "Database and Storage") {
    Component(PostgreSQL Database, "PostgreSQL Database", "Google Cloud SQL PostgreSQL (Enterprise Plus), Row-Level Security, TLS 1.3", "Persists patient data, operational records, and audit logs with region-locked data residency.")
    Component(WORM Storage, "WORM Storage", "Google Cloud Storage, Regional WORM Bucket Lock, CMEK via Cloud KMS", "Stores immutable audit logs and compliance records to satisfy EU MDR traceability and accountability.")
}

Rel(PostgreSQL Database, WORM Storage, "Synchronizes or archives operational audit data for compliance retention.")

@enduml