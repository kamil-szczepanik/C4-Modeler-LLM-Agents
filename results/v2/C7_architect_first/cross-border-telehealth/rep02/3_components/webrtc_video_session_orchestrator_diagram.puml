@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(Web_RTC_Video_Session_Orchestrator, "WebRTC Video Session Orchestrator") {
    Component(Signaling_Controller, "Signaling Controller", "Node.js / WebSockets", "Manages real-time session signaling, coordination, and asynchronous audit logging via gRPC.")
    Component(Adaptive_Bitrate_Manager, "Adaptive Bitrate Manager", "Go", "Monitors network conditions and dynamically adjusts media streams for low-bandwidth resilience.")
    Component(TURN_SFU_Proxy_Controller, "TURN/SFU Proxy Controller", "C++ / Pion-based", "Handles media relay and routing for real-time video/audio sessions using blind-relay enforcement.")
}

Rel(Signaling_Controller, Adaptive_Bitrate_Manager, "Communicates via internal channels to manage stream bitrates", "Internal channels")
Rel(TURN_SFU_Proxy_Controller, Signaling_Controller, "Coordinates media session paths and signaling states", "Internal")

@enduml