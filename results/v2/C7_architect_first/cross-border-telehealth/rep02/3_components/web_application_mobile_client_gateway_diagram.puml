@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(web_mobile_client_gateway, "Web Application & Mobile Client Gateway") {
    Component(Web_and_Mobile_Client_Interface, "Web and Mobile Client Interface", "React / React Native", "Cross-platform frontend supporting multilingual UI and accessibility for patients, clinicians, pharmacists, auditors, and administrators.")
    Component(Client_Routing___Auth_Interceptor, "Client Routing & Auth Interceptor", "Envoy Proxy", "Handles edge routing, TLS termination, WAF, rate limiting, and circuit breaking.")
    Component(Offline_Resilience_Cache, "Offline Resilience Cache", "Redux Persist / SQLCipher", "Provides client-side storage encryption for PHI protection on mobile devices and offline resilience.")
}

Rel(Web_and_Mobile_Client_Interface, Client_Routing___Auth_Interceptor, "Routes client requests and handles authentication", "HTTPS / JSON")
Rel(Client_Routing___Auth_Interceptor, Offline_Resilience_Cache, "Persists local state and encrypted PHI", "Local Storage")

@enduml