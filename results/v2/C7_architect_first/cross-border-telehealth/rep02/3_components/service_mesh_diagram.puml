@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(Service_Mesh, "Service Mesh") {
    Component(Istio_Service_Mesh, "Istio Service Mesh", "Istio", "Manages service-to-service communication, enforcing strict mTLS and routing policies.")
    Component(Envoy_Proxy, "Envoy Proxy", "Envoy proxy", "Acts as the data plane proxy enforcing security and consent-driven access control.")
}

Rel(Istio_Service_Mesh, Envoy_Proxy, "Pushes routing and security policies", "gRPC")

@enduml