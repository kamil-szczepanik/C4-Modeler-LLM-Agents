@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Containers container

Container_Boundary(data_containers, "Data Containers") {
    Component(PostgreSQL_Regional_Instances, "PostgreSQL Regional Instances", "Cloud SQL for PostgreSQL 15", "Stores transactional records, audit logs, and consent states with regional isolation in europe-west3 and us-central1.")
    Component(Medical_Artifact_Buckets, "Medical Artifact Buckets", "GCP Cloud Storage", "Persists encrypted medical files and AI trace bundles with Object Lock and CMEK for WORM compliance.")
    Component(Regional_Redis_Caches, "Regional Redis Caches", "GCP Memorystore for Redis", "Manages session state and fast-path authorization tokens for ephemeral session caching and rate-limiting.")
    Component(Security_and_Encryption_Services, "Security and Encryption Services", "GCP Cloud KMS & VPC Service Controls", "Provides regional encryption key management and network isolation.")
}

Rel(PostgreSQL_Regional_Instances, Security_and_Encryption_Services, "Secured by regional encryption keys and VPC Service Controls")
Rel(Medical_Artifact_Buckets, Security_and_Encryption_Services, "Encrypted using CMEK and protected by VPC Service Controls")
Rel(Regional_Redis_Caches, Security_and_Encryption_Services, "Secured via network isolation and encryption controls")

@enduml