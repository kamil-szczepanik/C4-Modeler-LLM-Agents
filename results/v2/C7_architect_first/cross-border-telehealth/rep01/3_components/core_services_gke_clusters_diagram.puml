@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Services GKE Clusters container

Container_Boundary(core_services, "Core Services GKE Clusters") {
    Component(Consultation, "Consultation", "Java (Spring Boot) / Python (FastAPI)", "Handles video consultations and session management.")
    Component(Prescription, "Prescription", "Java (Spring Boot) / Python (FastAPI)", "Manages e-prescriptions and integration with gateways.")
    Component(AI_Symptom_Checker, "AI Symptom Checker", "Python (FastAPI)", "Provides AI symptom checking and invokes third-party AI models.")
    Component(Consent_and_Policy, "Consent & Policy", "Java (Spring Boot) / OPA", "Manages consent and policy enforcement for regulatory compliance.")
    Component(Localization_and_Fallbandwidth, "Localization & Fallbandwidth", "Go", "Ensures robust performance and low-bandwidth optimizations.")
    Component(Notification, "Notification", "Java (Spring Boot) / Go", "Handles system notifications and messaging.")
    Component(BI_Ingestion, "BI Ingestion", "Java (Spring Boot) / Python (FastAPI)", "Ingests data for Business Intelligence processing.")
}

System_Ext(Third_Party_AI_Model_Providers, "Third-Party AI Model Providers", "External AI model providers.")
System_Ext(Media_Relay_Containers, "Media Relay Containers", "Media relay containers (Coturn/Mediasoup).")
System_Ext(EU_US_e_Prescription_Gateways, "EU/US e-Prescription Gateways", "External e-prescription gateways for EU and US.")

Rel(AI_Symptom_Checker, Third_Party_AI_Model_Providers, "Invokes external models via Istio Egress Gateways using HTTPS with strict L7 filtering.", "HTTPS")
Rel(Consultation, Media_Relay_Containers, "Connects session traffic using WebRTC (DTLS-SRTP).", "WebRTC (DTLS-SRTP)")
Rel(Prescription, EU_US_e_Prescription_Gateways, "Integrates prescription workflows using REST and HL7 FHIR over secure mTLS.", "REST / HL7 FHIR / mTLS")

@enduml