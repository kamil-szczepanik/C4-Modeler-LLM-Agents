@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Media Relay Containers container

Container_Boundary("Media Relay Containers", "Media Relay Containers") {
    Component(SFU_Media_Router, "SFU Media Router", "Mediasoup (C++ core with Node.js wrapper)", "Selective Forwarding Unit managing real-time media streaming for video and audio consultations.")
    Component(TURN_STUN_Relay, "TURN/STUN Relay", "Coturn", "Handles NAT traversal and relaying for media streams to support users with unstable internet connections.")
}

Rel(SFU_Media_Router, TURN_STUN_Relay, "Routes media streams through NAT traversal endpoints when direct peer-to-peer connection fails", "")

@enduml