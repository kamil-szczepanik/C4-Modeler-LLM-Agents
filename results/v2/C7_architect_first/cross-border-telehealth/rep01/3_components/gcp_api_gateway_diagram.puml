@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the GCP API Gateway container

Container_Boundary(gcp_api_gateway, "GCP API Gateway") {
    Component(Auth_Interceptor_Token_Validator_Component, "Auth Interceptor & Token Validator Component", "Cloud IAM & Firebase Auth, JWT/OAuth2", "Validates JWT/OAuth2 tokens and handles identity verification for incoming requests.")
    Component(Request_Validator_Schema_Validation_Component, "Request Validator & Schema Validation Component", "GCP API Gateway / Cloud Endpoints", "Performs edge validation and schema validation for incoming requests.")
    Component(Context_Consent_Injector_Component, "Context & Consent Injector Component", "GCP API Gateway custom extension", "Injects regional context and patient consent data into the request payload.")
}

Rel(Auth_Interceptor_Token_Validator_Component, Request_Validator_Schema_Validation_Component, "Passes authenticated context")
Rel(Request_Validator_Schema_Validation_Component, Context_Consent_Injector_Component, "Forwards validated request")

@enduml