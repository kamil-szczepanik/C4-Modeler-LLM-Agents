@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application & Mobile App Containers container

Container_Boundary(web_mobile_container, "Web Application & Mobile App Containers") {
    Component(UI_Layer, "UI Layer", "React / React Native", "Client-facing web and mobile applications delivering video consultations, e-prescriptions, and user interfaces.")
    Component(AI_Symptom_Checker_Client_Module, "AI Symptom Checker Client Module", "Client-side Module", "Handles AI-driven symptom checking logic on the client side.")
    Component(Media_Client_Module, "Media Client Module", "WebRTC", "Manages real-time video streaming and media interactions.")
    Component(Local_State_Consent_Manager, "Local State & Consent Manager", "SQLCipher", "Encrypted local storage for offline-first caching and PHI protection, managing consent gating.")
    Component(Offline_Sync_Queue, "Offline Sync Queue", "Client-side Queue", "Queues data for synchronization when network connectivity is restored.")
}

System_Ext(GCP_API_Gateway, "GCP API Gateway", "External API Gateway handling ingress traffic.")
System_Ext(Media_Relay_Containers, "Media Relay Containers", "External media relay (Coturn TURN/STUN, Mediasoup SFU).")

Rel(UI_Layer, AI_Symptom_Checker_Client_Module, "Internal Application Events")
Rel(UI_Layer, Media_Client_Module, "Internal Application Events")
Rel(AI_Symptom_Checker_Client_Module, GCP_API_Gateway, "HTTPS/REST")
Rel(Media_Client_Module, Media_Relay_Containers, "WSS/WebRTC")
Rel(Local_State_Consent_Manager, GCP_API_Gateway, "HTTPS with Signed Consent Claims")

@enduml