@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "Patients accessing video consultations, e-prescriptions, and the AI symptom checker.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Licensed clinicians accessing the platform to conduct video consultations and manage healthcare delivery.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and US, bridging fragmented healthcare systems while enforcing regional data residency and compliance.")

System_Ext(National_e_Prescription_Gateways_EU, "National e-Prescription Gateways (EU)", "External national gateways for e-prescriptions within the EU.")
System_Ext(Pharmacy_Networks_US, "Pharmacy Networks (US)", "External pharmacy networks within the US.")
System_Ext(Third_Party_AI_Model_Providers, "Third-Party AI Model Providers", "External AI providers powering the symptom checker.")
System_Ext(Identity_Providers, "Identity Providers", "External OAuth2/OIDC, EU eIDAS, and US Login.gov authentication systems.")
System_Ext(Infrastructure_Services, "Infrastructure Services", "GCP Cloud Logging, Cloud KMS, and WORM storage.")

Rel(Patients, Cross_Border_Telehealth_Platform, "Accesses video consultations, e-prescriptions, and AI symptom checker", "HTTPS, WebRTC with adaptive bitrates, and TLS 1.3")
Rel(Licensed_Clinicians, Cross_Border_Telehealth_Platform, "Accesses platform to manage consultations and patient care", "HTTPS, WebRTC with adaptive bitrates, and TLS 1.3")
Rel(Cross_Border_Telehealth_Platform, National_e_Prescription_Gateways_EU, "Exchanges e-prescription data", "REST and HL7 FHIR over secure mTLS")
Rel(Cross_Border_Telehealth_Platform, Pharmacy_Networks_US, "Exchanges prescription and pharmacy data", "REST and HL7 FHIR over secure mTLS")
Rel(Cross_Border_Telehealth_Platform, Third_Party_AI_Model_Providers, "Sends anonymized symptom data for AI analysis", "HTTPS with pre-processor PII/PHI stripping")
Rel(Cross_Border_Telehealth_Platform, Identity_Providers, "Authenticates users via OAuth2/OIDC, eIDAS, and Login.gov", "OAuth2/OIDC, mTLS")
Rel(Cross_Border_Telehealth_Platform, Infrastructure_Services, "Uses infrastructure for logging, encryption keys, and immutable audit logs", "GCP Cloud Logging, Cloud KMS, WORM storage")

@enduml