@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing Service container

System_Ext(api_gateway, "API Gateway / Edge Proxy", "External routing proxy")
System_Ext(external_payment, "External Payment Gateway & Insurance Clearinghouse", "External payment and insurance processing systems")

Container_Boundary(billing_service, "Billing Service") {
    Component(billing_api, "Billing API Controller & Patient Billing Portal API", "FastAPI", "Manages incoming traffic, routes API requests, and handles patient billing portal interactions.")
    Component(invoice_engine, "Invoice & Ledger Engine", "Python", "Handles core business logic for patient financial transactions, invoicing, and ledger updates.")
    Component(claims_processor, "Claims Processor & Insurance Reconciliation Engine", "Python/Celery", "Decouples and manages asynchronous insurance claims processing and reconciliation.")
    Component(payment_integrator, "Payment Integrator", "Python/HTTPX", "Interfaces with external payment gateways and insurance clearinghouses to process payments.")
    ComponentDb(billing_db, "Billing Data Repository", "PostgreSQL with SQLAlchemy ORM", "Provides relational data integrity and handles data persistence for financial records.")
    Component(idempotency_store, "Idempotency State Store", "Distributed Redis", "Powers idempotency controls to ensure safe, duplicate-free financial operations.")
}

Rel(api_gateway, billing_api, "Routes incoming traffic", "mTLS/gRPC/HTTPS")
Rel(billing_api, invoice_engine, "Delegates business logic", "In-Memory / Python Function Calls")
Rel(claims_processor, external_payment, "Submits claims and processes payments", "HTTPS")
Rel(payment_integrator, external_payment, "Submits claims and processes payments", "HTTPS")
Rel(invoice_engine, billing_db, "Interfaces for data persistence and ledger updates", "SQLAlchemy Connection Pooling")
Rel(claims_processor, idempotency_store, "Uses for idempotency state management", "Redis")

@enduml