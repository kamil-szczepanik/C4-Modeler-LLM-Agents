@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient & Scheduling Service container

Container_Boundary(patient_scheduling_service, "Patient & Scheduling Service") {
    Component(PatientController_SchedulingController, "PatientController & SchedulingController", "REST and gRPC (NestJS)", "REST and gRPC entry points for client and API Gateway traffic.")
    Component(PatientDomainService, "PatientDomainService", "TypeScript (NestJS)", "Manages demographic capture, RBAC/ABAC authorization, and GDPR data masking.")
    Component(SchedulingEngine, "SchedulingEngine", "TypeScript (NestJS)", "Executes real-time resource clash checks and asynchronous booking workflows.")
    Component(AuditInterceptor, "AuditInterceptor", "TypeScript (NestJS)", "Generates fail-secure, immutable audit trails for compliance.")
    Component(EventDispatcher, "EventDispatcher", "Transactional Outbox Pattern (Kafka)", "Emits domain events using the Transactional Outbox Pattern over Kafka.")
    Component(AvailabilityCacheManager, "AvailabilityCacheManager", "Encrypted Redis", "Caches anonymous slot metadata via encrypted Redis.")
    Component(DataRepository, "DataRepository", "PostgreSQL with TypeORM & AES-256", "Interfaces with PostgreSQL using TypeORM and AES-256 encryption.")
}

Component(API_Gateway, "API Gateway", "API Gateway / Edge Proxy", "External entry point routing client traffic.")
Component(Kafka_Message_Broker, "Kafka Message Broker", "Kafka over TLS 1.3 with SASL/SCRAM", "Handles asynchronous event streaming.")
Component(HashiCorp_Vault, "HashiCorp Vault", "HTTPS", "Secret management and dynamic credential issuance.")

Rel(API_Gateway, PatientController_SchedulingController, "gRPC / mTLS", "gRPC / mTLS")
Rel(SchedulingEngine, AvailabilityCacheManager, "Redis over TLS", "Redis over TLS")
Rel(SchedulingEngine, DataRepository, "TCP/SQL over TLS", "TCP/SQL over TLS")
Rel(PatientDomainService, DataRepository, "TCP/SQL over TLS", "TCP/SQL over TLS")
Rel(EventDispatcher, Kafka_Message_Broker, "Kafka over TLS 1.3 with SASL/SCRAM", "Kafka over TLS 1.3 with SASL/SCRAM")
Rel(AuditInterceptor, HashiCorp_Vault, "HTTPS", "HTTPS")

@enduml