@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway / Edge Proxy container

Container_Boundary(api_gateway_edge_proxy, "API Gateway / Edge Proxy") {
    Component(EnvoyEdgeRouter, "Envoy Edge Router", "Envoy", "Acts as the high-performance API Gateway supporting TLS 1.3, mTLS, and dynamic routing.")
    Component(RateLimitingEngine, "Rate Limiting Engine", "Redis", "Backs the distributed quota and rate-limiting engine.")
}

System_Ext(PatientSchedulingService, "Patient & Scheduling Service", "Node.js/TypeScript microservice for scheduling.")
System_Ext(EMRCoreService, "EMR Core Service", "Java/Spring Boot microservice for electronic medical records.")
System_Ext(BillingService, "Billing Service", "Python/FastAPI microservice for billing.")
System_Ext(FHIRInteroperabilityService, "FHIR Interoperability Service", "Java/HAPI FHIR microservice.")

Rel(EnvoyEdgeRouter, RateLimitingEngine, "Checks distributed quotas and rate limits", "Redis")
Rel(EnvoyEdgeRouter, PatientSchedulingService, "Routes requests", "mTLS/gRPC")
Rel(EnvoyEdgeRouter, EMRCoreService, "Routes requests", "mTLS/gRPC")
Rel(EnvoyEdgeRouter, BillingService, "Routes requests", "mTLS/gRPC")
Rel(EnvoyEdgeRouter, FHIRInteroperabilityService, "Routes requests", "mTLS/gRPC")

@enduml