@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Storage Layer container

Component(EMRCoreService, "EMR Core Service", "External Service", "Consumes relational database and object storage.")
Component(BillingService, "Billing Service", "External Service", "Consumes relational database.")

Container_Boundary(DataStorageLayer, "Data Storage Layer") {
    Component(RelationalDatabaseEngine, "Relational Database Engine", "PostgreSQL 15+ with Citus/Patroni, PgAudit", "Provides relational storage with active-active high availability and Row-Level Security (RLS).")
    Component(ObjectStorageRepository, "Object Storage Repository", "MinIO on-prem / AWS S3 in eu-central-1", "Supplies object storage with WORM policies and S3 Object Lock in Compliance mode for 10-year retention.")
    Component(DatabaseAuditEncryptionProxy, "Database Audit & Encryption Proxy", "HashiCorp Vault and PgAudit", "Manages envelope encryption keys, automatic 90-day key rotation, and audit logging.")
    Component(ConnectionPoolingLoadBalancing, "Connection Pooling & Load Balancing", "PgBouncer", "Separates read-only queries from transactional writes to meet P95 performance targets.")
    Component(BackupandDisasterRecovery, "Backup and Disaster Recovery", "Velero and automated WAL archiving", "Executes Kubernetes-native continuous snapshotting of persistent volumes and WAL archiving.")
}

Rel(EMRCoreService, RelationalDatabaseEngine, "TLS/SQL with RLS, TCP 5432")
Rel(BillingService, RelationalDatabaseEngine, "TLS/SQL with RLS, TCP 5432")
Rel(EMRCoreService, ObjectStorageRepository, "HTTPS/S3 API, TLS 1.3")
Rel(RelationalDatabaseEngine, ObjectStorageRepository, "Continuous WAL archiving, HTTPS")
@enduml