@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the FHIR Interoperability Service container

Container_Boundary(fhir_interoperability_service, "FHIR Interoperability Service") {
    Component(FHIR_REST_Controller, "FHIR REST Controller", "Java / Spring MVC", "Exposes FHIR R4/R5 endpoints and validates OAuth 2.0 / SMART-on-FHIR scopes.")
    Component(Resource_Mapping_Engine, "Resource Mapping Engine", "HAPI FHIR / Java", "Translates internal EMR models to FHIR JSON/XML, prioritizing patient-facing reads.")
    Component(Audit___Compliance_Interceptor, "Audit & Compliance Interceptor", "Java", "Captures transactions and enforces redacted, HIPAA-compliant access logs.")
    Component(FHIR_Message_Queue_Broker, "FHIR Message Queue Broker", "NATS JetStream", "Buffers asynchronous FHIR bundles with AES-256 encrypted persistent volumes.")
    Component(External_Integration_Client, "External Integration Client", "Apache HttpClient/WebClient", "Manages outbound communication with external lab and imaging systems.")
}

System_Ext(External_Lab___Imaging_Systems, "External Lab & Imaging Systems", "HTTPS / mTLS", "External systems exchanging clinical data.")

Rel(FHIR_REST_Controller, Resource_Mapping_Engine, "Delegates payload transformation", "In-memory Java Method Calls")
Rel(Resource_Mapping_Engine, Audit___Compliance_Interceptor, "Emits transaction audit events", "Spring Application Events")
Rel(FHIR_REST_Controller, FHIR_Message_Queue_Broker, "Offloads asynchronous FHIR ingestion", "AMQP/NATS")
Rel(FHIR_Message_Queue_Broker, External_Integration_Client, "Feeds queued outbound transactions", "AMQP/NATS")
Rel(External_Integration_Client, External_Lab___Imaging_Systems, "Exchanges clinical data", "HTTPS / mTLS with client certificate pinning")

@enduml