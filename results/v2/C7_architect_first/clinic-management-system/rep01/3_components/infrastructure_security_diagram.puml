@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Infrastructure & Security container

System_Ext(api_gateway, "API Gateway", "API Gateway external to the container")
System_Ext(emr_core_service, "EMR Core Service", "EMR Core Service external to the container")
Person(system_administrators, "System Administrators", "System administrators triggering deployments")
System_Ext(all_containers, "All Containers", "All other containers in the system")

Container_Boundary(infrastructure_security, "Infrastructure & Security") {
    Component(service_mesh, "Service Mesh Control Plane & Envoys", "Istio", "Manages mTLS and zero-trust traffic policies across hybrid clusters, enforcing ingress security.")
    Component(secrets_kms, "Secrets & Key Management Service", "HashiCorp Vault & AWS KMS with FIPS HSM backing", "Enforces AES-256 encryption at rest and FIPS-validated key management.")
    Component(gitops_engine, "GitOps Deployment Engine", "ArgoCD", "Triggers hybrid deployments across on-premise Kubernetes clusters and AWS.")
    Component(observability_pipeline, "Observability & Distributed Tracing Pipeline", "OpenTelemetry, Prometheus, Grafana Tempo", "Delivers distributed tracing and PHI-scrubbed observability, collecting metrics, logs, and traces.")
    Component(policy_engine, "Policy & Identity Enforcement Engine", "Open Policy Agent / OPA", "Provides fine-grained ABAC and patient consent enforcement.")
    Component(policy_cache, "Distributed Policy Cache", "Redis / OPA sidecar caching", "Localizes policy evaluation to maintain <50ms latency budgets by reading cached evaluation rules.")
    Component(secrets_replication, "Secrets & Key Replication Manager", "Custom Replication Engine", "Manages secrets and key replication to ensure high resilience across hybrid environments.")
}

Rel(api_gateway, service_mesh, "Enforces ingress security and mutual TLS", "gRPC")
Rel(emr_core_service, secrets_kms, "Fetches envelope encryption keys with local caching", "gRPC / HTTPS")
Rel(system_administrators, gitops_engine, "Triggers hybrid deployments", "Git/HTTPS")
Rel(all_containers, observability_pipeline, "Exports metrics, logs, and traces", "OTLP/gRPC")
Rel(policy_engine, policy_cache, "Reads cached evaluation rules", "In-memory / Local IPC")

@enduml