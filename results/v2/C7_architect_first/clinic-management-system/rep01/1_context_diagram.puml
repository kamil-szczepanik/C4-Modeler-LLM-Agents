@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_Clinical_Staff, "Patients & Clinical Staff", "Doctors, nurses, receptionists, and patients who access the system via web or mobile interfaces for admissions, records, and scheduling.")
Person(System_Administrators, "System Administrators", "Administrators responsible for managing and maintaining the Clinic Management System infrastructure.")
System(Clinic_Management_System_CMS, "Clinic Management System (CMS)", "Manages patient admissions, electronic medical records, scheduling, and billing for medium-sized hospitals and clinics, delivering high-availability, HIPAA- and GDPR-compliant clinical IT operations across a hybrid cloud infrastructure.")
System_Ext(External_Lab_Imaging_Systems, "External Lab & Imaging Systems", "External systems providing laboratory and medical imaging data.")
System_Ext(Payment_Gateway_Insurance_Clearinghouse, "Payment Gateway & Insurance Clearinghouse", "External financial systems handling billing, payments, and insurance claims.")
System_Ext(External_Identity_Provider_IdP, "External Identity Provider (IdP)", "External provider handling authentication and Multi-Factor Authentication (MFA).")

Rel(Patients_Clinical_Staff, Clinic_Management_System_CMS, "Accesses web and mobile interfaces for clinical operations", "HTTPS/TLS 1.3")
Rel(System_Administrators, Clinic_Management_System_CMS, "Manages infrastructure using GitOps", "ArgoCD / mTLS")
Rel(Clinic_Management_System_CMS, External_Lab_Imaging_Systems, "Exchanges clinical lab and imaging data", "HL7 FHIR (REST over HTTPS)")
Rel(Clinic_Management_System_CMS, Payment_Gateway_Insurance_Clearinghouse, "Processes payments and insurance claims", "Secure REST APIs")
Rel(Clinic_Management_System_CMS, External_Identity_Provider_IdP, "Authenticates users and enforces MFA", "OIDC/OAuth2")
@enduml