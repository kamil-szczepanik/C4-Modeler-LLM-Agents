@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(Patients_Clinical_Staff, "Patients & Clinical Staff", "Doctors, nurses, receptionists, and patients who access the system via web or mobile interfaces for admissions, records, and scheduling.")
Person(System_Administrators, "System Administrators", "Administrators responsible for managing and maintaining the Clinic Management System infrastructure.")

System_Ext(External_Lab_Imaging_Systems, "External Lab & Imaging Systems", "External systems providing laboratory and medical imaging data.")
System_Ext(Payment_Gateway_Insurance_Clearinghouse, "Payment Gateway & Insurance Clearinghouse", "External financial systems handling billing, payments, and insurance claims.")
System_Ext(External_Identity_Provider_IdP, "External Identity Provider (IdP)", "External provider handling authentication and Multi-Factor Authentication (MFA).")

System_Boundary(cms_boundary, "Clinic Management System (CMS)") {
    Container(API_Gateway_Edge_Proxy, "API Gateway / Edge Proxy", "Kong/Envoy", "Manages incoming traffic, security enforcement, and routing to internal microservices.")
    Container(Patient_Scheduling_Service, "Patient & Scheduling Service", "Node.js/TypeScript", "Manages patient admissions, profiles, and appointment scheduling.")
    Container(EMR_Core_Service, "EMR Core Service", "Java/Spring Boot", "Handles core electronic medical records and clinical data processing.")
    Container(Billing_Service, "Billing Service", "Python/FastAPI", "Processes patient billing, payments, and insurance claims.")
    Container(FHIR_Interoperability_Service, "FHIR Interoperability Service", "Java/HAPI FHIR", "Facilitates healthcare data exchange using the FHIR standard with external systems.")
    ContainerDb(Data_Storage_Layer, "Data Storage Layer", "PostgreSQL, MinIO/AWS S3 Object Storage", "Provides secure persistent storage for relational data with RLS and object storage.")
    Container(Infrastructure_Security, "Infrastructure & Security", "Istio Service Mesh, HashiCorp Vault/AWS KMS, ArgoCD", "Manages service-to-service communication security, encryption keys, and declarative deployments.")
}

Rel(Patients_Clinical_Staff, API_Gateway_Edge_Proxy, "Accesses system features via secure web or mobile interfaces", "HTTPS/REST")
Rel(System_Administrators, Infrastructure_Security, "Manages hybrid infrastructure and deployments", "ArgoCD / mTLS")
Rel(API_Gateway_Edge_Proxy, Patient_Scheduling_Service, "Routes client requests securely", "mTLS/gRPC")
Rel(API_Gateway_Edge_Proxy, EMR_Core_Service, "Routes client requests securely", "mTLS/gRPC")
Rel(API_Gateway_Edge_Proxy, Billing_Service, "Routes client requests securely", "mTLS/gRPC")
Rel(API_Gateway_Edge_Proxy, FHIR_Interoperability_Service, "Routes client requests securely", "mTLS/gRPC")
Rel(EMR_Core_Service, Data_Storage_Layer, "Reads and writes electronic medical records", "TLS/SQL with RLS")
Rel(FHIR_Interoperability_Service, External_Lab_Imaging_Systems, "Exchanges clinical lab and imaging data", "HTTPS/TLS with client certificate pinning")
Rel(Billing_Service, Payment_Gateway_Insurance_Clearinghouse, "Processes payments and insurance claims", "HTTPS")

@enduml