@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Business Services container

Container_Boundary(core_business_services, "Core Business Services") {
    Component(PatientManagementComponent, "Patient Management Component", "Java Spring Boot", "Handles patient admissions and profile management.")
    Component(SchedulingEngineComponent, "Scheduling Engine Component", "Java Spring Boot, Redis", "Manages appointment scheduling and acquires distributed locks.")
    Component(EMRCoreComponent, "EMR Core Component", "Java Spring Boot, CockroachDB, WORM Audit Store", "Manages Electronic Medical Records, ACID transactions, and guaranteed-delivery audit trails.")
    Component(BillingServiceComponent, "Billing Service Component", "Java Spring Boot", "Processes billing and financial services for healthcare facilities.")
    Component(APIGateway, "API Gateway", "Istio", "Routes requests via gRPC over mTLS to core components.")
    ComponentDb(CockroachDB, "CockroachDB", "Distributed SQL", "Stores relational data, providing active-active multi-region resiliency and ACID transactions.")
    Component(Redis, "Redis", "In-memory data store", "Provides high-performance appointment locking via Redis RESP / TLS.")
    Component(WORMAuditStore, "WORM Audit Store", "Storage", "Stores guaranteed-delivery audit trails using the transactional outbox pattern.")
    Component(ExternalKMSSHashiCorpVault, "External KMS (HashiCorp Vault)", "HashiCorp Vault, AES-256", "Performs envelope encryption and acts as an external key management system.")
}

Rel(APIGateway, PatientManagementComponent, "Routes requests via gRPC over mTLS (Istio)", "gRPC/mTLS")
Rel(APIGateway, SchedulingEngineComponent, "Routes requests via gRPC over mTLS (Istio)", "gRPC/mTLS")
Rel(APIGateway, EMRCoreComponent, "Routes requests via gRPC over mTLS (Istio)", "gRPC/mTLS")
Rel(APIGateway, BillingServiceComponent, "Routes requests via gRPC over mTLS (Istio)", "gRPC/mTLS")
Rel(SchedulingEngineComponent, Redis, "Acquires distributed locks via Redis RESP / TLS", "RESP / TLS")
Rel(EMRCoreComponent, CockroachDB, "Executes ACID transactions via JDBC / TLS", "JDBC / TLS")
Rel(PatientManagementComponent, CockroachDB, "Executes ACID transactions via JDBC / TLS", "JDBC / TLS")
Rel(EMRCoreComponent, WORMAuditStore, "Writes guaranteed-delivery audit trails using the transactional outbox pattern", "Transactional Outbox")
Rel(PatientManagementComponent, ExternalKMSSHashiCorpVault, "Performs envelope encryption via TLS", "TLS")
Rel(SchedulingEngineComponent, ExternalKMSSHashiCorpVault, "Performs envelope encryption via TLS", "TLS")
Rel(EMRCoreComponent, ExternalKMSSHashiCorpVault, "Performs envelope encryption via TLS", "TLS")
Rel(BillingServiceComponent, ExternalKMSSHashiCorpVault, "Performs envelope encryption via TLS", "TLS")

@enduml