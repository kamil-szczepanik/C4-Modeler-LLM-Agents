@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Frontend container

Container_Boundary(web_frontend, "Web Frontend") {
    Component(Web_Frontend, "Web Frontend", "React / TypeScript", "Component-based SPA framework for responsive clinical interfaces.")
    Component(API_Gateway, "API Gateway", "Envoy / Nginx", "Containerized static asset delivery and edge routing.")
    Component(Authentication_Module, "Authentication Module", "oidc-client-ts", "OAuth2/OIDC login and MFA token management.")
    Component(Session_Guardian, "Session Guardian", "TypeScript", "Manages session state and token teardown.")
    Component(RBAC_Router, "RBAC Router", "React Router / TypeScript", "Enforces role-based access control and routing.")
    Component(EMR_View_Controller, "EMR View Controller", "React / TypeScript", "Controls the rendering and interaction of Electronic Medical Records.")
    Component(API_Client, "API Client", "Axios", "HTTP client for telemetry, JWT injection, and error boundaries.")
    Component(Scheduling_Workspace, "Scheduling Workspace", "React / TypeScript", "Provides interface for clinical scheduling operations.")
}

Rel(Web_Frontend, API_Gateway, "HTTPS / REST / JSON, WebSocket", "HTTPS / WSS")
Rel(RBAC_Router, Authentication_Module, "Internal component call for claims verification", "")
Rel(Session_Guardian, API_Client, "Internal component call for token refresh/teardown", "")

@enduml