@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "External client routing and validation")
System_Ext(core_business_services, "Core Business Services", "Business logic and clinical workflow services")

Container_Boundary(redis, "Redis") {
    Component(redis_enterprise_cluster_engine, "Redis Enterprise Cluster Engine", "Multi-master, multi-replica in-memory store", "Provides high availability and horizontal scalability.")
    Component(distributed_lock_manager, "Distributed Lock Manager", "Redlock algorithm", "Coordinates appointment scheduling locks.")
    Component(session_and_token_cache, "Session & Token Cache", "Ephemeral cache", "Stores user sessions and OAuth2 tokens.")
    Component(emr_read_through_cache, "EMR Read-Through Cache", "In-memory cache", "Holds hot patient demographic and scheduling records.")
    Component(persistence_and_encryption_engine, "Persistence & Encryption Engine", "AES-256 RDB/AOF snapshots", "Secures persistence snapshots for HIPAA/GDPR compliance.")
}

Rel(api_gateway, session_and_token_cache, "Validates ephemeral auth tokens", "RESP over mTLS")
Rel(core_business_services, distributed_lock_manager, "Coordinates scheduling locks via Redlock", "RESP over mTLS")
Rel(core_business_services, emr_read_through_cache, "Reads/writes cached patient state", "RESP over mTLS")

@enduml