@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Mobile Frontend container

System_Ext(api_gateway, "API Gateway", "Envoy / Nginx")
System_Ext(secure_cloud_storage, "Secure Cloud Storage", "Cloud storage for OTA bundles")

Container_Boundary(mobile_frontend, "Mobile Frontend") {
    Component(auth_manager, "Authentication & Session Manager", "React Native Keychain / Flutter Secure Storage", "Manages secure enclave token storage and user authentication sessions.")
    Component(emr_module, "EMR & Scheduling View Module", "React Native / Flutter UI Widgets", "Provides the user interface for electronic medical records and scheduling.")
    Component(api_client, "API Client & Offline Sync Engine", "WatermelonDB / Isar", "Handles encrypted local caching with AES-256 and offline-first data synchronization.")
    Component(ota_manager, "OTA Update & Telemetry Manager", "Sentry SDK / Native OTA runtime", "Manages real-time telemetry, privacy-compliant crash tracking, and signed bundle updates.")
    Component(security_rasp, "Security & RASP Enclave", "Native Security Libraries", "Provides client-side PHI scrubbing, local encryption enforcement, and security protection.")
}

Rel(security_rasp, api_gateway, "Sends mTLS-pinned, authenticated requests", "HTTPS/JSON")
Rel(auth_manager, api_gateway, "Validates tokens & sends requests", "HTTPS/JSON")
Rel(emr_module, api_client, "Reads/Writes cached clinical data", "Local IPC")
Rel(ota_manager, secure_cloud_storage, "Fetches signed bundle updates", "HTTPS")

@enduml