@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(edge_router, "Edge Router & Reverse Proxy", "Envoy / Nginx", "Handles external access, TLS termination, WAF security controls, and perimeter defense.")
    Component(auth_filter, "Authentication & Authorization Filter", "OAuth2/OIDC + OPA", "Performs perimeter authentication and RBAC/ABAC enforcement.")
    Component(rate_limiter, "Rate Limiter & Circuit Breaker", "Redis-backed with local token-bucket caching", "Manages rate limiting and circuit breaking with active-active replication.")
    Component(versioning_filter, "API Versioning & Transformation Filter", "Internal Routing Middleware", "Handles API versioning and payload transformation.")
    Component(dedup_module, "Request Deduplication & Idempotency Module", "Redis-backed tracking", "Ensures request deduplication and idempotency tracking.")
}

System_Ext(core_services, "Core Business Services", "Go / Spring Boot backend core services")
System_Ext(compliance_service, "Compliance & Reporting Service", "Compliance and audit logging service")

Rel(edge_router, auth_filter, "Intercepts requests", "In-memory / gRPC")
Rel(auth_filter, versioning_filter, "Passes validated claims", "In-memory")
Rel(versioning_filter, core_services, "Forwards payloads", "gRPC / mTLS via Istio")
Rel(edge_router, compliance_service, "Audit log routing", "HTTPS")

@enduml