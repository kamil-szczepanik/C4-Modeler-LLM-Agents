@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(hl7_fhir_integration_engine, "HL7 FHIR Integration Engine") {
    Component(FHIR_API_Gateway_Router, "FHIR API Gateway / Router", "Apache Camel (REST DSL)", "Manages TLS termination, OAuth2/JWT validation, and mTLS.")
    Component(Transformation_Mapping_Engine, "Transformation & Mapping Engine", "Apache Camel (DataFormats)", "Translating internal domain models to FHIR R4 JSON.")
    Component(Validation_Compliance_Service, "Validation & Compliance Service", "HAPI FHIR Validator", "Stateless HAPI FHIR Validator ensuring profile conformance and stripping PII.")
    Component(Outbound_Dispatcher, "Outbound Dispatcher", "Apache Camel (HTTP4/Netty)", "Dispatcher with RabbitMQ DLQ and resilience4j circuit breakers.")
}

Rel(FHIR_API_Gateway_Router, Validation_Compliance_Service, "In-process Java API with OpenTelemetry correlation ID headers.")
Rel(Validation_Compliance_Service, Transformation_Mapping_Engine, "In-process Java API.")
Rel(Transformation_Mapping_Engine, Outbound_Dispatcher, "Forwards lab/imaging payloads with AES-256 encryption at rest.", "AMQP / RabbitMQ")

@enduml