@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Core_Business_Services, "Core Business Services", "External system interacting with the database")

Container_Boundary(CockroachDB, "CockroachDB") {
    Component(SQL_Layer, "SQL Layer", "Go", "Parses queries and enforces Role-Based Access Control (RBAC).")
    Component(Transaction_Engine, "Transaction Engine", "Go", "Manages distributed MVCC transactions and consensus.")
    Component(Raft_Consensus_Module, "Raft Consensus Module", "Go", "Replicates data ranges across nodes for active-active availability.")
    Component(Storage_Engine_RocksDB, "Storage Engine / RocksDB", "C++/Go, RocksDB, AES-256", "Persists data locally on disk with AES-256 encryption.")
    Component(Distributed_Leaseholder__Multi_Region_Coordinator, "Distributed Leaseholder & Multi-Region Coordinator", "Go", "Pin-points range leaseholders to minimize cross-boundary latency.")
}

Rel(Core_Business_Services, SQL_Layer, "Executes distributed SQL queries", "PostgreSQL Wire Protocol over TLS 1.3")
Rel(SQL_Layer, Transaction_Engine, "Translates queries into transactional read/write intents")
Rel(Transaction_Engine, Raft_Consensus_Module, "Replicates state changes", "gRPC over TLS")
Rel(Raft_Consensus_Module, Storage_Engine_RocksDB, "Persists committed ranges", "Cgo / Direct File I/O")
Rel(SQL_Layer, Distributed_Leaseholder__Multi_Region_Coordinator, "Routes queries to leaseholders", "Internal RPC over TLS")

@enduml