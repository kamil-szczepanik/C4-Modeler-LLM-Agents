@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Core_Business_Services, "Core Business Services", "External system calling the notification service")
System_Ext(External_Providers, "External Providers (Twilio/SendGrid)", "Third-party messaging providers for SMS and Email")
System_Ext(CockroachDB_and_Redis, "CockroachDB and Redis", "Data storage for retries, DLQ, and encrypted data")

Container_Boundary(Patient_Notification_Service, "Patient Notification Service") {
    Component(Notification_Router_Component, "Notification Router Component", "Spring Cloud Gateway / Routing", "Routes notification requests and queries consent preferences.")
    Component(Channel_Adapter_Component, "Channel Adapter Component", "Apache Camel", "Integrates third-party messaging providers and decouples external latency.")
    Component(Template_Engine_Component, "Template Engine Component", "Thymeleaf", "Generates secure, compliant patient alerts and reminders.")
    Component(Delivery_Status_Tracker_Component, "Delivery Status Tracker Component", "Redis Streams / CockroachDB", "Processes retries and Dead Letter Queues ensuring high availability.")
    Component(Consent__Preference_Manager_Component, "Consent & Preference Manager Component", "Redis caching layer", "Manages patient consent and preference checks for HIPAA and GDPR compliance.")
}

Rel(Core_Business_Services, Notification_Router_Component, "Invokes via gRPC with mTLS and OAuth2/JWT", "gRPC")
Rel(Notification_Router_Component, Consent__Preference_Manager_Component, "Queries via local method calls", "In-process")
Rel(Channel_Adapter_Component, External_Providers, "Calls via HTTPS/SMTP over TLS 1.3", "HTTPS/SMTP")
Rel(Delivery_Status_Tracker_Component, CockroachDB_and_Redis, "Processes retries and Dead Letter Queues", "TCP/Redis Protocol")

@enduml