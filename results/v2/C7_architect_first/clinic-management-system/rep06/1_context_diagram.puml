@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(MedicalStaffAdministrators, "Medical Staff & Administrators", "Primary clinical users accessing daily workflows via HTTPS and MFA.")
Person(Patients, "Patients", "End-users accessing self-service scheduling and viewing records via the Patient Portal.")
Person(BillingSpecialists, "Billing Specialists", "Financial users managing revenue cycles and claims.")

System(ClinicManagementSystem, "Clinic Management System", "A hybrid clinical IT platform that manages patient admissions, electronic medical records (EMR), scheduling, and billing for medium-sized hospitals and clinics.")

System_Ext(ExternalLabsImagingSystems, "External Labs & Imaging Systems", "External diagnostic partners integrating via HL7 FHIR.")
System_Ext(InsuranceClearinghouse, "Insurance Clearinghouse", "External entity for automated claims processing.")
System_Ext(WORMAuditStore, "WORM Audit Store", "Dedicated compliance boundary for immutable logs.")

Rel(MedicalStaffAdministrators, ClinicManagementSystem, "Interacts for daily workflows", "HTTPS with TLS 1.3 and MFA")
Rel(Patients, ClinicManagementSystem, "Accesses self-service scheduling and views records", "HTTPS with TLS 1.3 and MFA")
Rel(BillingSpecialists, ClinicManagementSystem, "Manages revenue cycles and claims", "HTTPS with TLS 1.3 and MFA")
Rel(ClinicManagementSystem, ExternalLabsImagingSystems, "Integrates for diagnostic data", "HL7 FHIR (REST/JSON over TLS 1.3)")
Rel(ClinicManagementSystem, InsuranceClearinghouse, "Submits claims", "Secure EDI/HTTPS")
Rel(ClinicManagementSystem, WORMAuditStore, "Streams immutable access and admin logs", "Secure syslog/TLS")

@enduml