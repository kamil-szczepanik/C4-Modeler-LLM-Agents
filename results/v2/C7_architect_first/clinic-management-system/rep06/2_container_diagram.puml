@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(MedicalStaff, "Medical Staff", "Medical staff managing patient admissions, EMR, and scheduling.")
Person(Administrators, "Administrators", "System administrators managing the platform and compliance.")
Person(Patients, "Patients", "End-users accessing portal services and scheduling.")
Person(BillingSpecialists, "Billing Specialists", "Financial users managing revenue cycles and billing.")

System_Ext(ExternalLabsImagingSystems, "External Labs & Imaging Systems", "External diagnostic partners integrating via HL7 FHIR.")
System_Ext(WORMAuditStore, "WORM Audit Store", "Dedicated compliance boundary for immutable logs and audit records.")

System_Boundary(ClinicManagementSystem, "Clinic Management System") {
    Container(APIGateway, "API Gateway", "Envoy / Nginx", "Routes incoming requests and secures perimeter access.")
    Container(WebFrontend, "Web Frontend", "React / TypeScript SPA", "Web-based user interface for medical staff, administrators, patients, and billing specialists.")
    Container(MobileFrontend, "Mobile Frontend", "React Native / Flutter", "Mobile application for users accessing the platform on-the-go.")
    Container(CoreBusinessServices, "Core Business Services", "Go / Spring Boot", "Microservices handling Patient, EMR, Scheduling, and Billing domains.")
    Container(HL7FHIRIntegrationEngine, "HL7 FHIR Integration Engine", "Apache Camel / Node-RED", "Integration engine handling HL7 FHIR APIs for external labs and imaging systems.")
    Container(PatientNotificationService, "Patient Notification Service", "Microservice", "Handles patient notifications and alerts.")
    Container(ComplianceReportingService, "Compliance & Reporting Service", "Spring Boot / Python", "Ensures compliance and generates regulatory reports.")
    ContainerDb(CockroachDB, "CockroachDB", "Distributed SQL", "Distributed database for ACID transactions and persistence.")
    ContainerDb(Redis, "Redis", "In-memory Data Store", "Used for caching and distributed locks.")
}

Rel(MedicalStaff, APIGateway, "Accesses daily workflows via web/mobile", "HTTPS")
Rel(Administrators, APIGateway, "Manages system and compliance", "HTTPS")
Rel(Patients, APIGateway, "Accesses portal and scheduling", "HTTPS")
Rel(BillingSpecialists, APIGateway, "Manages billing and revenue", "HTTPS")

Rel(APIGateway, WebFrontend, "Serves web application", "HTTPS")
Rel(APIGateway, MobileFrontend, "Serves mobile application", "HTTPS")
Rel(APIGateway, CoreBusinessServices, "Routes API requests", "HTTPS / gRPC (mTLS via Istio)")

Rel(CoreBusinessServices, CockroachDB, "Reads and writes transactional data", "TLS")
Rel(CoreBusinessServices, Redis, "Caches data and acquires locks", "TLS")
Rel(CoreBusinessServices, WORMAuditStore, "Writes audit logs", "gRPC/TLS")

Rel(HL7FHIRIntegrationEngine, ExternalLabsImagingSystems, "Exchanges diagnostic data", "HL7 FHIR APIs")
Rel(ComplianceReportingService, WORMAuditStore, "Sends compliance and reporting data", "gRPC/TLS")

@enduml