@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Local Storage/Sync Daemon container

Container_Boundary(local_storage_sync_daemon, "Local Storage/Sync Daemon") {
    Component(SyncEngineCoordinator, "Sync Engine Coordinator", "TypeScript / RxJS", "Manages reactive, bi-directional delta synchronization and communicates with the core service.")
    Component(LocalStorageManager, "Local Storage Manager", "IndexedDB / SQLCipher with Web Crypto API", "Persists data locally using AES-256 encryption and provides offline storage.")
    Component(ConflictResolutionController, "Conflict Resolution Controller", "TypeScript", "Resolves data conflicts during synchronization.")
    Component(AuditSafetyInterceptor, "Audit & Safety Interceptor", "TypeScript", "Enforces clinical safety checks and compliance.")
    Component(KeyDerivationSessionWrapper, "Key Derivation & Session Wrapper", "Web Crypto API", "Handles transient key derivation without storing encryption keys permanently on disk.")
    Component(EncryptedLocalDeadLetterQueueDLQ, "Encrypted Local Dead-Letter Queue (DLQ)", "TypeScript / Encrypted Storage", "Queues failed messages securely to meet HIPAA and GDPR mandates.")
}

Component_Ext(CoreClinicalEMRService, "Core Clinical & EMR Service", "Java / Spring Boot", "Backend core service handling clinical data and EMRs.")
Component_Ext(WebApplicationFrontend, "Web Application Frontend", "React / TypeScript", "Provides the user interface for the clinic management system.")

Rel(SyncEngineCoordinator, CoreClinicalEMRService, "Communicates via gRPC over mTLS 1.3", "gRPC over mTLS 1.3")
Rel(LocalStorageManager, EncryptedLocalDeadLetterQueueDLQ, "Persists and queues failed synchronization data", "Internal")
Rel(WebApplicationFrontend, SyncEngineCoordinator, "Interacts via Local IPC / Custom DOM Events", "Local IPC / Custom DOM Events")

@enduml