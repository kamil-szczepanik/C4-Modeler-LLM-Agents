@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Scheduling & Billing Service container

System_Boundary(scheduling_billing_service, "Scheduling & Billing Service") {
    Component(Appointment_Scheduler_Component, "Appointment Scheduler Component", "NestJS / TypeScript", "Manages resource clash checks and appointment scheduling.")
    Component(Billing___Claims_Processor_Component, "Billing & Claims Processor Component", "NestJS / TypeScript", "Handles billing, insurance claims, and processing payments.")
    Component(Notification_Handler_Component, "Notification Handler Component", "NestJS / TypeScript", "Handles automated patient reminders and dispatches scrubbed notifications.")
    Component(Data_Access___Encryption_Component, "Data Access & Encryption Component", "TypeORM / AES-256", "Manages data access, transactional persistence, and encryption at rest.")
    ComponentDb(Redis_Cluster, "Redis Cluster", "Multi-node with automatic failover", "Provides high-availability distributed locking and durable local queues for retry logic.")
    ComponentDb(PostgreSQL, "PostgreSQL", "Shared database with Outbox table and row-level security", "Shared database utilized for transactional data persistence and outbox pattern implementation.")
}

System_Ext(Payment_Gateway___Insurance_Clearinghouse, "Payment Gateway / Insurance Clearinghouse", "External System", "External system for submitting claims and processing payments.")
System_Ext(External_Notification_Service, "External Notification Service", "External System", "External system that dispatches scrubbed reminders.")
Container(Patient_Self_Service_Portal, "Patient Self-Service Portal", "Container", "Portal for patients to view itemized billing data.")

Rel(Appointment_Scheduler_Component, Redis_Cluster, "Acquires distributed locks via Redlock", "TCP/TLS")
Rel(Appointment_Scheduler_Component, PostgreSQL, "Persists transactional events", "TypeORM / TCP")
Rel(Billing___Claims_Processor_Component, PostgreSQL, "Utilizes transactional outbox table for claim dispatch", "TypeORM / TCP")
Rel(Billing___Claims_Processor_Component, Payment_Gateway___Insurance_Clearinghouse, "Submits claims and processes payments", "HTTPS/REST with mTLS")
Rel(Billing___Claims_Processor_Component, Patient_Self_Service_Portal, "Exposes itemized billing data", "gRPC/REST")
Rel(Notification_Handler_Component, External_Notification_Service, "Dispatches scrubbed reminders", "HTTPS/REST")
Rel(Notification_Handler_Component, Redis_Cluster, "Utilizes durable local queue for retry logic", "TCP/TLS")
Rel(Notification_Handler_Component, PostgreSQL, "Utilizes durable local queue for retry logic", "TCP/TLS")

@enduml