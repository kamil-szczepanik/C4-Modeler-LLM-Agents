@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL container

System_Ext(OnPrisHSM, "On-Premises HSM", "Cryptographic key management")
System_Ext(ImmutableAuditLog, "Immutable Audit Log", "External audit storage")

Container_Boundary(PostgreSQL, "PostgreSQL") {
    Component(RowLevelSecurityEncryptionManager, "Row-Level Security & Encryption Manager", "PostgreSQL RLS & Transparent Data Encryption", "Manages row-level data segregation and cryptographic encryption at rest.")
    Component(pgauditComplianceModule, "pgaudit Compliance Module", "PostgreSQL Extension (pgaudit)", "Captures immutable DDL and DML audit trails for compliance.")
}

Rel(RowLevelSecurityEncryptionManager, OnPrisHSM, "Requests cryptographic keys", "PKCS#11 / gRPC over TLS")
Rel(pgauditComplianceModule, ImmutableAuditLog, "Streams audit records", "Syslog / TLS")

@enduml