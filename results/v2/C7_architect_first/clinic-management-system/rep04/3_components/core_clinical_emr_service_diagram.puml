@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(core_clinical_emr_service, "Core Clinical & EMR Service") {
    Component(PatientRecordManager, "Patient Record Manager", "Java / Spring Boot", "Manages patient admissions and electronic medical records (EMR).")
    Component(AuthorizationPolicyEngine, "Authorization & Policy Engine", "Java / Spring Boot", "Evaluates fine-grained access policies for requests.")
    Component(AuditLoggingInterceptor, "Audit Logging Interceptor", "Java / Spring Boot", "Intercepts requests and appends audit events for HIPAA/GDPR compliance.")
    Component(FHIRInteroperabilityAdapter, "FHIR Interoperability Adapter", "Java / Spring Boot / HAPI FHIR", "Exchanges standardized clinical data with external lab and imaging systems.")
    Component(CryptoKeyManagementFacade, "Crypto & Key Management Facade", "Java / Spring Boot / Secure Hardware Interface", "Manages envelope encryption keys using an On-Premises HSM.")
}

Rel(AuthorizationPolicyEngine, PatientRecordManager, "Evaluates fine-grained access", "In-process calls")

@enduml