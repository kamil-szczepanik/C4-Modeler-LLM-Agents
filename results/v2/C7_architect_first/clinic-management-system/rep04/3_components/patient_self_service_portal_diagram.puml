@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient Self-Service Portal container

Container_Boundary(patient_self_service_portal, "Patient Self-Service Portal") {
    Component(AuthSessionManager, "Authentication & Session Manager", "React Context / OAuth2 SDK", "Handles OIDC tokens and 15-minute inactivity timeouts.")
    Component(DashboardRecordViewer, "Dashboard & Record Viewer", "React Components", "Renders demographics, localized UI, and WCAG 2.1 AA accessible EMR summaries.")
    Component(AppointmentBookingWidget, "Appointment Booking Widget", "React / Redux", "Interface for slot selection and clash checks.")
    Component(LocalStateCache, "Local State Cache", "IndexedDB / Web Crypto API", "Provides client-side AES-256 encryption for temporary PHI.")
    Component(TelemetryErrorHandler, "Telemetry & Error Handler", "OpenTelemetry JS SDK", "Captures RUM metrics with strict PHI sanitization.")
}

System_Ext(IdentityPoviderIdP, "Identity Provider (IdP)", "External system for authentication and token management.")
System_Ext(ApiGatewayEdgeProxy, "API Gateway / Edge Proxy", "External gateway routing requests to backend services.")

Rel(AuthSessionManager, IdentityPoviderIdP, "Exchanges and refreshes tokens", "OIDC/OAuth2 over HTTPS")
Rel(DashboardRecordViewer, ApiGatewayEdgeProxy, "Fetches medical history", "HTTPS / REST, JSON")
Rel(AppointmentBookingWidget, ApiGatewayEdgeProxy, "Submits appointment requests", "HTTPS / REST, JSON")
Rel(DashboardRecordViewer, TelemetryErrorHandler, "Reports runtime UI metrics", "HTTPS")
@enduml