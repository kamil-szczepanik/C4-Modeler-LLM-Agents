@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application Frontend container

Container_Boundary(web_application_frontend, "Web Application Frontend") {
    Component(AuthSessionComponent, "Auth & Session Component", "oidc-client-ts", "Manages user authentication, session state, and securely passes memory-only tokens for API requests.")
    Component(ClinicalWorkflowRouterStateComponent, "Clinical Workflow Router & State Component", "React Router & Redux Toolkit", "Manages complex multi-step application state and navigation for clinical workflows.")
    Component(DataFetchingCacheComponent, "Data Fetching & Cache Component", "TanStack Query / React Query", "Optimizes data retrieval, local caching, and communicates with the API Gateway.")
    Component(LocalStorageSyncService, "Local Storage Sync Service", "IndexedDB with Web Crypto API", "Enables offline resilience through secure client-side storage with AES-256 encryption.")
    Component(UIComponentDesignSystemLibrary, "UI Component & Design System Library", "Tailwind CSS & Radix UI", "Provides accessible, WCAG 2.1 AA compliant UI primitives with minimal DOM overhead.")
}

System_Ext(ApiGateway, "API Gateway", "External API Gateway handling backend service routing.", "HTTPS/REST/GraphQL")

Rel(ClinicalWorkflowRouterStateComponent, DataFetchingCacheComponent, "Uses to query the API Gateway", "HTTPS/REST/GraphQL")
Rel(DataFetchingCacheComponent, LocalStorageSyncService, "Reads/writes to local storage", "IndexedDB/AES-256")
Rel(ClinicalWorkflowRouterStateComponent, UIComponentDesignSystemLibrary, "Renders views using UI component library")
Rel(AuthSessionComponent, DataFetchingCacheComponent, "Securely passes memory-only tokens for requests to the API Gateway", "HTTPS")
Rel(DataFetchingCacheComponent, ApiGateway, "Queries data", "HTTPS/REST/GraphQL")

@enduml