@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_edge_proxy, "API Gateway / Edge Proxy") {
    Component(api_gateway_edge_proxy_envoy, "API Gateway / Edge Proxy (Envoy)", "Envoy", "Acts as the secure entry point for the Clinic Management System, routing all external traffic to internal microservices.")
    Component(tls_termination_ssl_offloading_engine, "TLS Termination & SSL Offloading Engine", "TLS 1.3", "Handles secure transport-layer encryption and SSL offloading.")
    Component(authentication_authorization_filter, "Authentication & Authorization Filter", "Identity Provider / OAuth2 / OIDC", "Validates tokens and enforces authentication and authorization.")
    Component(rate_limiting_threat_protection, "Rate Limiting & Threat Protection", "Redis, local token-bucket", "Provides distributed rate limiting and threat protection with local token fallback.")
    Component(routing_load_balancing_core, "Routing & Load Balancing Core", "Envoy xDS", "Manages routing and load balancing core for hybrid cloud traffic.")
    Component(priority_traffic_shaping_filter, "Priority & Traffic Shaping Filter", "Envoy Traffic Shaping", "Applies priority and traffic shaping for resilient traffic management.")
    Component(egress_dlp_sanitization_filter, "Egress DLP & Sanitization Filter", "Envoy DLP", "Ensures strict HIPAA/GDPR compliance via egress data loss prevention and sanitization.")
    Component(telemetry_distributed_tracing_sidecar, "Telemetry & Distributed Tracing Sidecar", "OpenTelemetry, W3C Trace Context, Prometheus / Grafana", "Handles distributed tracing and telemetry metrics.")
}

Rel(api_gateway_edge_proxy_envoy, tls_termination_ssl_offloading_engine, "Terminates inbound HTTPS/WSS traffic", "")
Rel(tls_termination_ssl_offloading_engine, authentication_authorization_filter, "Passes decrypted requests to auth", "")
Rel(authentication_authorization_filter, rate_limiting_threat_protection, "Checks limits and threats using Redis and local token fallback", "")
Rel(rate_limiting_threat_protection, routing_load_balancing_core, "Routes validated requests", "")
Rel(routing_load_balancing_core, priority_traffic_shaping_filter, "Shapes traffic priority", "")
Rel(priority_traffic_shaping_filter, egress_dlp_sanitization_filter, "Sanitizes data for HIPAA/GDPR compliance", "")
Rel(api_gateway_edge_proxy_envoy, telemetry_distributed_tracing_sidecar, "Exports metrics and W3C trace contexts", "")
@enduml