@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Redis container

Person(Scheduling_Billing_Service, "Scheduling & Billing Service", "External service interacting with Redis")

Container_Boundary(Redis, "Redis") {
    Component(Core_In_Memory_Data_Store, "Core In-Memory Data Store", "Redis OSS / Enterprise", "Caches encrypted session/lookup data and provides high-throughput in-memory storage.")
    Component(Lock_Coordination_Engine, "Lock Coordination Engine", "Redlock Engine", "Acquires scheduling mutex locks for conflict-free appointment management.")
    Component(Replication_Persistence_Controller, "Replication & Persistence Controller", "Redis Sentinel, AOF (fsync everysec), and RDB", "Ensures automated failover under 3 seconds and balances data durability with performance.")
}

Rel(Scheduling_Billing_Service, Core_In_Memory_Data_Store, "Caches encrypted session/lookup data", "RESP/TLS 1.3")
Rel(Scheduling_Billing_Service, Lock_Coordination_Engine, "Acquires scheduling mutex locks", "RESP/TLS 1.3")

@enduml