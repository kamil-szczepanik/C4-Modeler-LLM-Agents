@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Clinic Management System

Person(Patient, "Patient", "Accesses the Patient Portal to manage appointments and records via HTTPS.")
Person(Clinician_Doctor, "Clinician/Doctor", "Manages clinical data and patient care securely using HTTPS/MFA and RBAC/ABAC.")
Person(Receptionist, "Receptionist", "Handles patient admissions and scheduling using HTTPS/MFA and RBAC/ABAC.")
Person(Billing_Staff, "Billing Staff", "Manages billing and claims using HTTPS/MFA and RBAC/ABAC.")

System(Clinic_Management_System, "Clinic Management System", "A hybrid cloud platform designed to manage patient admissions, electronic medical records (EMR), scheduling, and billing for medium-sized hospitals and clinics.")

System_Ext(External_Lab___Imaging_Systems, "External Lab & Imaging Systems", "External systems providing clinical laboratory and imaging results via HL7 FHIR.")
System_Ext(Payment_Gateway___Insurance_Clearinghouse, "Payment Gateway / Insurance Clearinghouse", "External systems for processing payments and insurance claims.")
System_Ext(Identity_Provider__IdP_, "Identity Provider (IdP)", "Handles authentication and identity services via OIDC/SAML.")
System_Ext(On_Premises_Hardware_Security_Module__HSM_, "On-Premises Hardware Security Module (HSM)", "Provides key management and cryptographic security for on-premises data.")

Rel(Patient, Clinic_Management_System, "Accesses patient portal and services", "HTTPS/TLS 1.3")
Rel(Clinician_Doctor, Clinic_Management_System, "Manages clinical workflows and EMR", "HTTPS/MFA with RBAC/ABAC")
Rel(Receptionist, Clinic_Management_System, "Manages patient admissions and scheduling", "HTTPS/MFA with RBAC/ABAC")
Rel(Billing_Staff, Clinic_Management_System, "Processes billing and claims", "HTTPS/MFA with RBAC/ABAC")
Rel(Clinic_Management_System, External_Lab___Imaging_Systems, "Exchanges clinical data", "HL7 FHIR over REST/TLS 1.3")
Rel(Clinic_Management_System, Payment_Gateway___Insurance_Clearinghouse, "Processes payments and claims", "REST/TLS 1.3")
Rel(Clinic_Management_System, Identity_Provider__IdP_, "Authenticates users", "OIDC/SAML")

@enduml