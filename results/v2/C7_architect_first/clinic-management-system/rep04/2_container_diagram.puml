@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Patient, "Patient", "Accesses the Patient Self-Service Portal to manage appointments and records.")
Person(ClinicianDoctor, "Clinician/Doctor", "Manages clinical data and patient care using web applications.")
Person(Receptionist, "Receptionist", "Handles patient admissions and scheduling.")
Person(BillingStaff, "Billing Staff", "Manages billing, payments, and insurance claims.")

System_Ext(ExternalLabImagingSystems, "External Lab & Imaging Systems", "External systems providing clinical laboratory and imaging results via HL7 FHIR.")
System_Ext(PaymentGatewayInsuranceClearinghouse, "Payment Gateway / Insurance Clearinghouse", "External systems for processing payments and insurance claims.")
System_Ext(IdentityPoviderIdP, "Identity Provider (IdP)", "Handles authentication and identity services via OIDC/SAML.")
System_Ext(OnPremisesHardwareSecurityModuleHSM, "On-Premises Hardware Security Module (HSM)", "Provides key management and cryptographic security.")

System_Boundary(ClinicManagementSystem, "Clinic Management System") {
    Container(APIGatewayEdgeProxy, "API Gateway / Edge Proxy", "NGINX / Envoy", "Acts as the edge proxy managing incoming traffic and routing.")
    Container(WebApplicationFrontend, "Web Application Frontend", "React / TypeScript", "Provides clinical workflows and user interfaces for staff.")
    Container(PatientSelfServicePortal, "Patient Self-Service Portal", "React / TypeScript", "Enables patients to access records and manage appointments.")
    Container(CoreClinicalEMRService, "Core Clinical & EMR Service", "Java / Spring Boot", "Manages electronic medical records and core clinical workflows.")
    Container(SchedulingBillingService, "Scheduling & Billing Service", "Node.js / NestJS", "Handles appointment scheduling, billing, and payment processing.")
    Container(LocalStorageSyncDaemon, "Local Storage/Sync Daemon", "IndexedDB / AES-256", "Provides offline resilience and client-side storage.")
    ContainerDb(PostgreSQL, "PostgreSQL", "PostgreSQL with row-level encryption", "Primary database for relational storage and clinical records.")
    ContainerDb(Redis, "Redis", "Redis", "Provides caching and scheduling locks.")
    ContainerDb(ImmutableAuditLog, "Immutable Audit Log", "AWS QLDB / Append-only Postgres", "Maintains immutable audit trails for compliance.")
}

Rel(Patient, APIGatewayEdgeProxy, "Accesses patient portal services", "HTTPS / WSS")
Rel(ClinicianDoctor, APIGatewayEdgeProxy, "Accesses clinical workflows", "HTTPS / WSS")
Rel(Receptionist, APIGatewayEdgeProxy, "Accesses scheduling and admissions", "HTTPS / WSS")
Rel(BillingStaff, APIGatewayEdgeProxy, "Accesses billing and claims", "HTTPS / WSS")

Rel(APIGatewayEdgeProxy, WebApplicationFrontend, "Serves web frontend", "HTTPS")
Rel(APIGatewayEdgeProxy, PatientSelfServicePortal, "Serves patient portal", "HTTPS")
Rel(APIGatewayEdgeProxy, CoreClinicalEMRService, "Routes internal API requests", "gRPC over Istio Service Mesh")
Rel(APIGatewayEdgeProxy, SchedulingBillingService, "Routes internal API requests", "gRPC over Istio Service Mesh")

Rel(CoreClinicalEMRService, PostgreSQL, "Reads and writes clinical data", "JDBC/TLS with mTLS")
Rel(CoreClinicalEMRService, ImmutableAuditLog, "Appends audit logs", "JDBC/TLS with mTLS")
Rel(CoreClinicalEMRService, OnPremisesHardwareSecurityModuleHSM, "Manages encryption keys", "Secure Hardware Interface")
Rel(CoreClinicalEMRService, ExternalLabImagingSystems, "Exchanges clinical data", "HL7 FHIR over REST/TLS 1.3")

Rel(SchedulingBillingService, Redis, "Manages cache and locks", "TCP/TLS")
Rel(SchedulingBillingService, PaymentGatewayInsuranceClearinghouse, "Processes payments and claims", "HTTPS/REST")

Rel(WebApplicationFrontend, IdentityPoviderIdP, "Authenticates users", "OIDC/SAML")
Rel(PatientSelfServicePortal, IdentityPoviderIdP, "Authenticates patients", "OIDC/SAML")

@enduml