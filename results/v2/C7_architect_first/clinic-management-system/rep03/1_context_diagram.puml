@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Doctors, "Doctors", "Medical professionals who access and update electronic medical records and patient data.")
Person(Nurses, "Nurses", "Healthcare staff who manage patient admissions, scheduling, and basic EMR entries.")
Person(Receptionists, "Receptionists", "Front-desk staff responsible for patient scheduling and initial intake.")
Person("Billing Staff", "Billing Staff", "Personnel who manage patient invoices, payments, and insurance claims.")
Person("Clinic Administrators", "Clinic Administrators", "Management staff overseeing system configuration, users, and overall clinic operations.")
Person(Patients, "Patients", "End-users who access the patient portal to view health records, schedule appointments, and pay bills.")

System("Clinic Management System", "Clinic Management System", "A hybrid cloud platform designed for medium-sized hospitals and clinics to manage patient admissions, EMRs, scheduling, and billing while ensuring HIPAA and GDPR compliance.")

System_Ext("Identity Provider (IdP)", "Identity Provider (IdP)", "External system responsible for user authentication and authorization.")
System_Ext("External Labs & Imaging Systems", "External Labs & Imaging Systems", "Third-party diagnostic systems exchanging standardized medical data.")
System_Ext("Payment Gateway / Insurance Clearinghouse", "Payment Gateway / Insurance Clearinghouse", "External financial systems processing payments and insurance claims.")

Rel(Doctors, "Clinic Management System", "Accesses patient admissions, EMRs, and scheduling", "HTTPS / TLS 1.3 with MFA")
Rel(Nurses, "Clinic Management System", "Manages admissions, scheduling, and patient data", "HTTPS / TLS 1.3 with MFA")
Rel(Receptionists, "Clinic Management System", "Handles patient scheduling and intake", "HTTPS / TLS 1.3 with MFA")
Rel("Billing Staff", "Clinic Management System", "Manages billing, invoicing, and claims", "HTTPS / TLS 1.3 with MFA")
Rel("Clinic Administrators", "Clinic Management System", "Manages clinic operations and system administration", "HTTPS / TLS 1.3 with MFA")
Rel(Patients, "Clinic Management System", "Interacts via the Patient Portal / Web UI for health records and billing", "HTTPS / TLS 1.3 with MFA")

Rel("Clinic Management System", "Identity Provider (IdP)", "Authenticates users securely", "OpenID Connect (OIDC) over mTLS")
Rel("Clinic Management System", "External Labs & Imaging Systems", "Exchanges lab and imaging data", "HL7 FHIR over HTTPS")
Rel("Clinic Management System", "Payment Gateway / Insurance Clearinghouse", "Processes transactions and insurance claims", "REST over TLS 1.3")
@enduml