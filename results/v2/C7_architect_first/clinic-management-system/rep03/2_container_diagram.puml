@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Doctors, "Doctors", "Medical professionals who access and update electronic medical records and patient data.")
Person(Nurses, "Nurses", "Healthcare staff who manage patient admissions, scheduling, and basic EMR entries.")
Person(Receptionists, "Receptionists", "Front-desk staff responsible for patient scheduling and initial intake.")
Person(BillingStaff, "Billing Staff", "Personnel who manage patient invoices, payments, and insurance claims.")
Person(ClinicAdministrators, "Clinic Administrators", "Management staff overseeing system configuration, users, and overall clinic operations.")
Person(Patients, "Patients", "End-users who access the patient portal to view health records, schedule appointments, and pay bills.")

System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "External system responsible for user authentication and authorization.")
System_Ext(External_Labs__Imaging_Systems, "External Labs & Imaging Systems", "Third-party diagnostic systems exchanging standardized medical data.")
System_Ext(Payment_Gateway___Insurance_Clearinghouse, "Payment Gateway / Insurance Clearinghouse", "External financial systems processing payments and insurance claims.")

System_Boundary(Clinic_Management_System, "Clinic Management System") {
    Container(API_Gateway, "API Gateway", "Nginx / Kong", "Manages TLS termination, rate limiting, and traffic routing.")
    Container(Web_Application_SPA, "Web Application (SPA)", "React / TypeScript, Nginx", "Frontend interface serving users via browser.")
    Container(Core_Services, "Core Services (Patient & Scheduling, EMR, Billing, FHIR Interoperability)", "Node.js / NestJS or Java / Spring Boot", "Microservices handling business logic, patient records, scheduling, billing, and interoperability.")
    ContainerDb(PostgreSQL, "PostgreSQL", "PostgreSQL (Active-Passive)", "Relational database storing encrypted application data with AES-256 at rest.")
    ContainerDb(Redis, "Redis", "Redis", "Caching layer for edge caching and fast data access.")
    Container(Apache_Kafka, "Apache Kafka", "Apache Kafka", "Message broker supporting event-driven workflows and Transactional Outbox Pattern.")
    Container(AWS_S3_Object_Lock, "AWS S3 Object Lock", "AWS S3", "Immutable storage ensuring strict compliance and data retention.")
}

Rel(Doctors, Web_Application_SPA, "Accesses Web Application via HTTPS/TLS terminated at the API Gateway", "HTTPS / TLS")
Rel(Nurses, Web_Application_SPA, "Accesses Web Application via HTTPS/TLS terminated at the API Gateway", "HTTPS / TLS")
Rel(Receptionists, Web_Application_SPA, "Accesses Web Application via HTTPS/TLS terminated at the API Gateway", "HTTPS / TLS")
Rel(BillingStaff, Web_Application_SPA, "Accesses Web Application via HTTPS/TLS terminated at the API Gateway", "HTTPS / TLS")
Rel(ClinicAdministrators, Web_Application_SPA, "Accesses Web Application via HTTPS/TLS terminated at the API Gateway", "HTTPS / TLS")
Rel(Patients, Web_Application_SPA, "Accesses Web Application via HTTPS/TLS terminated at the API Gateway", "HTTPS / TLS")
Rel(Web_Application_SPA, API_Gateway, "Sends requests to API Gateway", "HTTPS / TLS")
Rel(API_Gateway, Identity_Provider_IdP, "Authenticates requests via OAuth2/OIDC", "OAuth2 / OIDC")
Rel(API_Gateway, Core_Services, "Routes traffic securely", "gRPC over mTLS")
Rel(Core_Services, PostgreSQL, "Reads and writes relational data with AES-256 at rest", "SQL / TLS")
Rel(Core_Services, Redis, "Caches and retrieves edge data", "Redis Protocol")
Rel(Core_Services, Apache_Kafka, "Publishes and consumes events for asynchronous workflows", "Kafka Protocol")
Rel(Core_Services, AWS_S3_Object_Lock, "Stores immutable compliance data", "HTTPS / AWS API")
Rel(Core_Services, External_Labs__Imaging_Systems, "Exchanges medical data using HL7 FHIR APIs", "HL7 FHIR APIs")
Rel(Core_Services, Payment_Gateway___Insurance_Clearinghouse, "Submits claims asynchronously", "Apache Kafka / REST")

@enduml