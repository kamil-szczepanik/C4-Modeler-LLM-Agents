@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Services (Patient & Scheduling, EMR, Billing, FHIR Interoperability) container

Container_Boundary(core_services, "Core Services") {
    Component(Patient_Scheduling_Component, "Patient & Scheduling Component", "NestJS (TypeScript)", "Handles patient registration and appointment scheduling workflows.")
    Component(EMR_Component, "EMR Component", "NestJS (TypeScript)", "Manages Electronic Medical Records with sub-second response times.")
    Component(Billing_Component, "Billing Component", "NestJS (TypeScript)", "Processes billing and interacts with insurance clearinghouses and payment gateways.")
    Component(FHIR_Interoperability_Component, "FHIR Interoperability Component", "NestJS (TypeScript) / HL7 FHIR APIs", "Exchanges medical data using HL7 FHIR APIs and SMART-on-FHIR scopes with external labs.")
}

Rel(Patient_Scheduling_Component, EMR_Component, "Shares patient context and scheduling data")
Rel(EMR_Component, Billing_Component, "Triggers billing events based on clinical services")
Rel(FHIR_Interoperability_Component, EMR_Component, "Ingests and exports interoperable medical data")

@enduml