@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(apache_kafka, "Apache Kafka") {
    Component(Kafka_Brokers, "Kafka Brokers", "Apache Kafka (acks=all)", "Handles zero-data-loss event streaming, publishing, and consuming asynchronous clinical events.")
    Component(KRaft_Controller_Quorum, "KRaft Controller Quorum", "Apache Kafka KRaft Mode", "Manages metadata and consensus for streamlined failovers without ZooKeeper.")
    Component(Kafka_Connect, "Kafka Connect", "Kafka Connect Framework", "Provides exactly-once event syncing to PostgreSQL and AWS S3 Object Lock.")
    Component(Schema_Registry, "Schema Registry", "Confluent Schema Registry", "Stores and enforces Avro/Protobuf backward-compatibility rules for event schemas.")
    Component(Kafka_Stream_Processors, "Kafka Stream Processors", "Kafka Streams", "Performs real-time appointment clash checks and event aggregation.")
}

Rel(Kafka_Brokers, AWS_S3_Object_Lock, "Tiered storage and audit log archiving", "HTTPS")
Rel(Kafka_Brokers, Schema_Registry, "Stores schema definitions", "Kafka Protocol")

@enduml