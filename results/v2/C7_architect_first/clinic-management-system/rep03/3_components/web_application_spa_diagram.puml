@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Users, "Users", "Access via HTTPS/TLS terminated at the API Gateway")
System_Ext(API_Gateway, "API Gateway", "Routes requests to backend services")
System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "Handles authentication and MFA")
System_Ext(Delivery_CDN_Proxies, "Delivery CDN / Proxies", "Serves immutable static assets")

Container_Boundary(web_application_spa, "Web Application (SPA)") {
    Component(Routing_State_Management_Component, "Routing & State Management Component", "React Router, Zustand, Zod", "Handles client-side routing, in-memory session state management, and runtime claim validation.")
    Component(RBAC_Router_Guard_Component, "RBAC Router Guard Component", "Zod, TypeScript", "Enforces role-based access control and secure routing based on runtime claim validation.")
    Component(Authentication_Interceptor_Component, "Authentication Interceptor Component", "OAuth2/OIDC", "Manages token exchange and MFA triggers with the Identity Provider.")
    Component(Session_Lifecycle_Manager_Component, "Session Lifecycle Manager Component", "Zustand, React 18", "Manages the active session lifecycle and ensures memory-only state without local PHI caching.")
    Component(Clinical_Workspace_Component, "Clinical Workspace Component", "React 18, TypeScript", "Delivers role-based clinical and administrative workflows to healthcare staff and patients.")
    Component(API_Client_Component, "API Client Component", "Axios, OpenTelemetry", "Wraps HTTP requests to backend services and captures browser tracing for performance metrics.")
}

Rel(Users, web_application_spa, "Access via HTTPS/TLS terminated at the API Gateway", "HTTPS / TLS")
Rel(web_application_spa, API_Gateway, "Sends requests to backend services", "HTTPS / REST / JSON")
Rel(Authentication_Interceptor_Component, Identity_Provider_IdP, "Token exchange and MFA triggers", "OAuth2 / OIDC")
Rel(Delivery_CDN_Proxies, web_application_spa, "Serves immutable Vite static assets with nonces-based CSP", "HTTPS")

@enduml