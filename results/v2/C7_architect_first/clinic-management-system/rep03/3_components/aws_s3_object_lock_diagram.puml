@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_s3_object_lock, "AWS S3 Object Lock") {
    Component(Object_Ingestion_API, "Object Ingestion API", "AWS SDK / REST API", "Handles incoming compliance data and document uploads securely over AWS PrivateLink.")
    Component(Retention_Enforcement_Engine, "Retention Enforcement Engine", "AWS S3 Object Lock (WORM Compliance Mode)", "Enforces strict 10-year immutable retention policies on stored medical records.")
    Component(Audit_Logger, "Audit Logger", "Node.js / AWS CloudTrail integration", "Tracks and logs all data access, modifications, and retention events for compliance monitoring.")
    Component(KMS_Envelope_Encryption_Wrapper, "KMS Envelope Encryption Wrapper", "AWS KMS", "Provides cryptographic envelope encryption and enables cryptographic GDPR erasure.")
}

Rel(Object_Ingestion_API, Retention_Enforcement_Engine, "Routes uploaded data to be locked under WORM compliance mode")
Rel(Retention_Enforcement_Engine, KMS_Envelope_Encryption_Wrapper, "Encrypts and secures stored medical data objects")
Rel(Object_Ingestion_API, Audit_Logger, "Logs ingestion and access activities")

@enduml