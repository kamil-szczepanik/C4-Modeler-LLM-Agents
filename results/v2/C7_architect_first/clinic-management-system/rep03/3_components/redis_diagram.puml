@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Redis container

Container_Boundary(redis, "Redis") {
    Component(RedisClusterCoordinatorProxy, "Redis Cluster Coordinator / Proxy", "Redis Cluster Coordinator", "Manages cluster topology, routing, and proxying requests to the underlying data nodes.")
    Component(InMemoryDataStore, "In-Memory Data Store", "Redis In-Memory Data Store", "Provides low-latency access for caching and active session/EMR data.")
    Component(PersistenceEngine, "Persistence Engine", "Redis Persistence Engine", "Handles data persistence with AES-256 encryption for secure data storage.")
}

Rel(RedisClusterCoordinatorProxy, InMemoryDataStore, "Routes read/write operations")
Rel(RedisClusterCoordinatorProxy, PersistenceEngine, "Triggers secure disk persistence")

@enduml