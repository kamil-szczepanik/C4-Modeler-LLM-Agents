@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Core_Services, "Core Services", "External services connecting to the PostgreSQL container.")

Container_Boundary(PostgreSQL, "PostgreSQL") {
    Component(Database_Engine, "Database Engine", "PostgreSQL v16 with pgaudit, Row-Level Security, and TDE", "Relational database providing robust storage, querying capabilities, and strict compliance enforcement.")
    Component(Connection_Pooler, "Connection Pooler", "PgBouncer", "Manages incoming connections to maintain performance during peak clinic hours.")
    Component(Replication_Agent, "Replication Agent", "Patroni + etcd", "Orchestrates automated failover for primary-standby deployment to hit 99.99% uptime.")
    Component(Storage_and_Backup, "Storage and Backup", "AWS S3 Object Lock", "Ensures immutable 10-year data retention for backups and audit logs.")
    Component(Secret_Management, "Secret Management", "HashiCorp Vault", "Automates short-lived X.509 certificate rotation and dynamic credential generation.")
}

Rel(Core_Services, Connection_Pooler, "TCP / mTLS, port 6432 with X.509 client certificate authentication", "TCP / mTLS")
Rel(Connection_Pooler, Database_Engine, "TCP / mTLS, port 5432 enforcing TLS 1.3", "TCP / mTLS")
Rel(Database_Engine, Storage_and_Backup, "HTTPS / TLS 1.3 for continuous WAL archiving and backups", "HTTPS / TLS 1.3")
Rel(Replication_Agent, Replication_Agent, "Internal IPC / TCP for cluster health checks and leader election", "Internal IPC / TCP")

@enduml