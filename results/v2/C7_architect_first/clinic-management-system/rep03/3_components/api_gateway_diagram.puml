@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

System_Ext(spa, "Web Application (SPA)", "Client Single Page Application")
System_Ext(idp, "Identity Provider (IdP)", "External Identity Provider for OAuth2/OIDC")
System_Ext(core_services, "Core Services", "Backend microservices handling business logic")
System_Ext(immutable_store, "Immutable Data Store", "Secure log storage for audit logs")

Container_Boundary(api_gateway, "API Gateway") {
    Component(tls_controller, "TLS Termination & Ingress Controller", "Kong Ingress Controller / Nginx", "Handles TLS termination and ingress routing for low latency and high throughput.")
    Component(auth_plugin, "Authentication & JWT Validation Plugin", "Kong OAuth2/OIDC Plugin with local JWKS", "Validates JWT tokens using decentralized, low-latency token verification.")
    Component(rbac_filter, "RBAC/ABAC Policy Enforcement Filter", "Kong Policy Enforcement Filter", "Enforces role-based and attribute-based access control policies for HIPAA and GDPR compliance.")
    Component(rate_limit, "Rate Limiting & Throttling Filter", "Kong Rate Limiting Plugin / Redis", "Performs distributed rate-limiting and throttling using Redis.")
    Component(priority_router, "Tenant-Aware Priority Router", "Kong Upstream Service", "Proxies prioritized requests to core services.")
    Component(audit_filter, "Audit Logging & Redaction Filter", "Fluentbit over TLS", "Streams redacted audit logs with strict PHI redaction.")
}

Rel(spa, tls_controller, "Sends requests", "HTTPS / TLS 1.3")
Rel(tls_controller, auth_plugin, "Passes request for validation", "")
Rel(auth_plugin, idp, "Fetches JWKS keys", "HTTPS")
Rel(auth_plugin, rbac_filter, "Passes authenticated context", "")
Rel(rbac_filter, rate_limit, "Evaluates limits", "")
Rel(rate_limit, priority_router, "Forwards allowed requests", "")
Rel(priority_router, core_services, "Proxies prioritized requests", "gRPC over mTLS")
Rel(api_gateway, audit_filter, "Generates audit events", "")
Rel(audit_filter, immutable_store, "Streams redacted logs", "Fluentbit over TLS")

@enduml