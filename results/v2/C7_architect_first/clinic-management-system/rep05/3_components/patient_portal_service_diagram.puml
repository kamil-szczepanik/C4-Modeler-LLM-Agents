@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "External or edge routing gateway")
System_Ext(kafka, "Apache Kafka Event Broker", "Event broker for asynchronous, decoupled event-driven communication")
System_Ext(ext_notification, "External Notification Gateway", "Third-party service for sending SMS and email alerts")

Container_Boundary(patient_portal_service, "Patient Portal Service") {
    Component(portal_controller, "Portal Controller / Router", "NestJS / Express.js, gRPC, HTTP", "Router handling incoming gRPC and HTTP requests.")
    Component(auth_manager, "Patient Profile & Auth Manager", "Node.js / TypeScript, OIDC, JWT, RBAC/ABAC", "Enforces MFA, OIDC JWT validation, RBAC/ABAC, and proxy access.")
    Component(appointment_view, "Appointment View Component", "Node.js / TypeScript, ORM", "Manages appointment history and slot selection.")
    Component(consent_handler, "Consent & Preference Handler", "Node.js / TypeScript", "Captures and verifies GDPR/HIPAA compliance flags with cryptographic audit trails.")
    Component(notification_manager, "Notification & Engagement Manager", "Node.js / TypeScript, HTTPS / REST", "Triggers SMS/email alerts via external gateways with stripped PHI/PII.")
    Component(data_access, "Data Access Repository", "TypeScript, ORM, TCP/TLS", "Manages encrypted database persistence.")
    Component(event_publisher, "Event Publisher", "Node.js / TypeScript, TCP / TLS", "Emits domain events to Apache Kafka.")
}

Rel(api_gateway, portal_controller, "Routes incoming requests", "gRPC / Internal Mesh with mTLS")
Rel(portal_controller, auth_manager, "Forwards authentication and demographic interactions", "In-memory / Function Call")
Rel(appointment_view, data_access, "Queries and updates appointment data", "TypeScript/ORM via TCP/TLS")
Rel(event_publisher, kafka, "Publishes domain events", "TCP / TLS")
Rel(notification_manager, ext_notification, "Sends alerts", "HTTPS / REST")

@enduml