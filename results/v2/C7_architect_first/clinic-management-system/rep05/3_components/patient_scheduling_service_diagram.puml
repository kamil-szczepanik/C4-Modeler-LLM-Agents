@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(patient_scheduling_service, "Patient & Scheduling Service") {
    Component(patient_controller, "Patient Controller", "NestJS Controller", "Handles gRPC endpoints for patient registration and electronic medical records.")
    Component(scheduling_controller, "Scheduling Controller", "NestJS Controller", "Handles gRPC endpoints for appointment scheduling.")
    Component(appointment_engine, "Appointment Engine", "Node.js / TypeScript", "Manages business logic for resource checks and scheduling workflows.")
    Component(conflict_resolution_service, "Conflict Resolution Service", "Node.js / TypeScript", "Manages slot-finding logic and resolves scheduling clashes.")
    Component(data_access_repository, "Data Access Repository", "TypeORM / Prisma", "Persistence layer handling reads and writes to the relational database with pessimistic locking.")
    Component(outbox_dispatcher, "Outbox Dispatcher", "Node.js / TypeScript", "Implements the transactional outbox pattern to persist domain events atomically.")
    Component(event_publisher, "Event Publisher", "KafkaJS", "Publishes domain events via TCP/TLS to the event broker.")
}

Rel(scheduling_controller, appointment_engine, "Invokes business logic via direct method calls")
Rel(appointment_engine, conflict_resolution_service, "Triggers slot-finding logic upon clash detection")
Rel(data_access_repository, outbox_dispatcher, "Persists domain events atomically")
@enduml