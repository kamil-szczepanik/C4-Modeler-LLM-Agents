@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the HashiCorp Vault container

Container_Boundary("HashiCorp Vault", "HashiCorp Vault") {
    Component("HTTP API / Core Router", "HTTP API / Core Router", "Go", "Handles incoming HTTP/gRPC requests, routing them to the appropriate internal Vault subsystems.")
    Component("Secrets Engines Manager", "Secrets Engines Manager", "Go", "Manages secrets engines, handling dynamic credential generation for PostgreSQL Databases and data encryption.")
    Component("Auth Methods Manager", "Auth Methods Manager", "Go", "Manages authentication methods including Kubernetes Auth and AppRole for microservices.")
    Component("Audit Log Subsystem", "Audit Log Subsystem", "Go", "Streams compliance and audit logs to tamper-evident storage.")
    Component("Consul Storage Backend / Raft Consensus", "Consul Storage Backend / Raft Consensus", "Go / Raft", "Provides durable, highly available storage and consensus for Vault data.")
}

Rel("HTTP API / Core Router", "Secrets Engines Manager", "Delegates secret retrieval and dynamic credential requests", "")
Rel("HTTP API / Core Router", "Auth Methods Manager", "Delegates authentication requests", "")
Rel("Auth Methods Manager", "HTTP API / Core Router", "Returns authentication tokens", "")
Rel("Secrets Engines Manager", "Consul Storage Backend / Raft Consensus", "Reads and writes encrypted state data", "")
Rel("HTTP API / Core Router", "Audit Log Subsystem", "Logs request and response audit trails", "")

@enduml