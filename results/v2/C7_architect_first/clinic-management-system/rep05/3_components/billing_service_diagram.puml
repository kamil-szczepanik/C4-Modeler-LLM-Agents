@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing Service container

Container_Boundary(billing_service, "Billing Service") {
    Component(Invoice_Controller, "Invoice Controller", "Python / FastAPI", "Handles incoming HTTP and gRPC requests related to invoicing and billing operations.")
    Component(Claim_Processing_Engine, "Claim Processing Engine", "Python / FastAPI", "Processes claims and manages insurance clearinghouse workflows.")
    Component(Payment_Gateway_Adapter, "Payment Gateway Adapter", "Python / FastAPI", "Interfaces with external payment gateways and insurance clearinghouses to process payments and settlements.")
    Component(Billing_Data_Access_Repository, "Billing Data Access Repository", "SQLAlchemy ORM", "Manages transactional boundaries and interacts with PostgreSQL databases, enforcing field-level encryption.")
    Component(Audit_Compliance_Interceptor, "Audit & Compliance Interceptor", "Python / FastAPI", "Enforces cryptographic audit logging and compliance checks for HIPAA and GDPR.")
    Component(Kafka_Event_Consumer, "Kafka Event Consumer", "Python / aiokafka", "Consumes asynchronous events and handles message processing from the Apache Kafka Event Broker.")
}

Rel(Invoice_Controller, Claim_Processing_Engine, "Passes invoice and billing data for claim evaluation", "In-process")
Rel(Claim_Processing_Engine, Payment_Gateway_Adapter, "Sends settlement and payment requests", "HTTPS")
Rel(Invoice_Controller, Billing_Data_Access_Repository, "Reads and writes transactional billing data", "TCP / TLS")
Rel(Claim_Processing_Engine, Billing_Data_Access_Repository, "Persists claim status and transaction logs", "TCP / TLS")
Rel(Audit_Compliance_Interceptor, Billing_Data_Access_Repository, "Records compliance and audit trails", "TCP / TLS")
Rel(Kafka_Event_Consumer, Claim_Processing_Engine, "Dispatches asynchronous failure events and exception feeds", "In-process")

@enduml