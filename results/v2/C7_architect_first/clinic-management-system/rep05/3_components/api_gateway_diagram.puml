@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(api_gateway_core, "API Gateway Core", "Envoy / Kong", "Active-active Kubernetes ingress and high-performance routing.")
    Component(envoy_sidecar_container, "Envoy Sidecar Container", "Envoy", "Manages sidecar proxying and service mesh communication.")
    Component(tls_termination_mtls_enforcer, "TLS Termination & mTLS Enforcer", "Envoy Security Filter", "Handles TLS termination and enforces mutual TLS.")
    Component(oauth2_oidc_token_introspection_scope_enforcer, "OAuth2/OIDC Token Introspection & Scope Enforcer", "Envoy Auth Filter / Lua", "Validates tokens and enforces security scopes.")
    Component(waf_payload_sanitization_filter, "WAF & Payload Sanitization Filter", "WASM / Envoy Filter", "Protects against web attacks and sanitizes payloads.")
    Component(data_masking_pii_redirection_filter, "Data Masking & PII Redirection Filter", "WASM / Lua", "Masks sensitive data and handles PII redirection.")
    Component(dynamic_router, "Dynamic Router", "Envoy Router", "Dynamically routes incoming requests.")
    Component(rate_limiting_circuit_breaker_engine, "Rate Limiting & Circuit Breaker Engine", "Envoy Rate Limit Service", "Prevents overloading and provides circuit breaking.")
    Component(request_transformation_engine, "Request Transformation Engine", "Native Lua / WASM filters", "Translates REST/GraphQL to gRPC.")
    Component(patient_resource_session_router, "Patient & Resource Session Router", "Envoy Routing Rules", "Routes patient and resource sessions.")
    Component(health_probe_canary_traffic_controller, "Health Probe & Canary Traffic Controller", "Kubernetes Probes / Envoy", "Manages health checks and canary deployments.")
    Component(distributed_tracing_injector, "Distributed Tracing Injector", "OpenTelemetry", "Injects tracing headers into requests.")
    Component(telemetry_exporter, "Telemetry Exporter", "Prometheus Exporter", "Exports metrics to the central monitoring stack.")
    Component(api_usage_analytics_monetization_logger, "API Usage Analytics & Monetization Logger", "Analytics Logger", "Logs API usage and monetization metrics.")
}

Rel(api_gateway_core, dynamic_router, "Passes routed requests")
Rel(tls_termination_mtls_enforcer, oauth2_oidc_token_introspection_scope_enforcer, "Forwards authenticated traffic")
Rel(oauth2_oidc_token_introspection_scope_enforcer, waf_payload_sanitization_filter, "Passes inspected requests")
Rel(waf_payload_sanitization_filter, data_masking_pii_redirection_filter, "Passes sanitized payloads")
Rel(dynamic_router, request_transformation_engine, "Transforms request protocols")
Rel(request_transformation_engine, patient_resource_session_router, "Directs session traffic")
Rel(rate_limiting_circuit_breaker_engine, dynamic_router, "Enforces limits on routing")
Rel(distributed_tracing_injector, telemetry_exporter, "Sends tracing and telemetry data")

@enduml