@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Kafka_Broker_Container", "Apache Kafka Event Broker") {
    Component("Kafka_Broker_Core", "Kafka Broker Core", "Apache Kafka with KRaft consensus", "Publishes and consumes partitioned event logs via mTLS.")
    Component("Schema_Registry", "Schema Registry", "Confluent Schema Registry", "Validates message structure against enforced contracts via HTTP/REST over TLS.")
    Component("Kafka_Connect", "Kafka Connect", "Apache Kafka Connect", "Offloads immutable audit and EMR logs to object storage / long-term archive.")
}

Rel("Kafka_Broker_Core", "Schema_Registry", "Validates message structure against enforced contracts", "HTTP/REST over TLS")
Rel("Kafka_Connect", "Kafka_Broker_Core", "Consumes event logs for offloading to long-term archive", "TCP / TLS 1.3")
@enduml