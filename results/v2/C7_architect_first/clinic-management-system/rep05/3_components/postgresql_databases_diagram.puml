@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL Databases container

Container(patient_portal_service, "Patient Portal Service", "Microservice", "Client-facing patient portal service.")
Container(patient_scheduling_service, "Patient & Scheduling Service", "Microservice", "Handles patient management and appointment scheduling.")
Container(emr_service, "EMR Service", "Microservice", "Manages electronic medical records.")
Container(billing_service, "Billing Service", "Microservice", "Manages financial records and billing.")
Container(integration_service, "Integration Service", "Microservice", "Handles interoperability and data synchronization.")

Container_Boundary(postgresql_databases, "PostgreSQL Databases") {
    Component(patient_portal_db, "Patient & Portal DB", "PostgreSQL 16, Patroni, CloudNativePG", "Stores patient portal and profile data with mTLS TCP connectivity.")
    Component(scheduling_db, "Scheduling DB", "PostgreSQL 16, Patroni, CloudNativePG", "Stores scheduling and appointment data with mTLS TCP connectivity.")
    Component(emr_db, "EMR DB", "PostgreSQL 16, Patroni, CloudNativePG, pgaudit", "Stores active and archival electronic medical records with HIPAA audit logging.")
    Component(billing_db, "Billing DB", "PostgreSQL 16, Patroni, CloudNativePG", "Stores financial records and billing information with mTLS TCP connectivity.")
}

Rel(patient_portal_service, patient_portal_db, "Reads/writes data", "TCP / mTLS")
Rel(patient_scheduling_service, scheduling_db, "Reads/writes data", "TCP / mTLS")
Rel(emr_service, emr_db, "Reads/writes active and archival data", "TCP / mTLS")
Rel(billing_service, billing_db, "Reads/writes financial records", "TCP / mTLS")
Rel(integration_service, patient_portal_db, "Interoperability data sync", "TCP / mTLS")
Rel(integration_service, scheduling_db, "Interoperability data sync", "TCP / mTLS")
Rel(integration_service, emr_db, "Interoperability data sync", "TCP / mTLS")
Rel(integration_service, billing_db, "Interoperability data sync", "TCP / mTLS")

@enduml