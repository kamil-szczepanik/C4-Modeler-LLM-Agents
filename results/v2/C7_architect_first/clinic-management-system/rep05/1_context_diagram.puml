@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Clinic Management System

Person(Patients, "Patients", "Individuals who access the system for appointments, portals, and billing interactions.")
Person(Clinicians, "Clinicians", "Medical professionals who access latency-critical electronic medical records (EMR) workflows.")
Person(Hospital Administrators, "Hospital Administrators", "Staff members who manage administrative, scheduling, and billing operations.")

System(Clinic Management System, "Clinic Management System", "A hybrid clinical IT platform that manages patient admissions, electronic medical records, appointment scheduling, and billing, providing high availability, stringent compliance, and seamless interoperability.")

System_Ext(Identity Provider (IdP), "Identity Provider (IdP)", "External system responsible for issuing OAuth2/JWT tokens for user authentication.")
System_Ext(External Lab & Imaging Systems, "External Lab & Imaging Systems", "External medical systems that integrate with the platform for clinical data exchange.")
System_Ext(Payment Gateways/Insurance Clearinghouses, "Payment Gateways/Insurance Clearinghouses", "External financial systems utilized for billing and payment processing.")

Rel(Patients, Clinic Management System, "Accesses the system via portal and billing traffic", "HTTPS/TLS 1.3, OAuth2/JWT")
Rel(Clinicians, Clinic Management System, "Accesses latency-critical EMR workflows", "HTTPS/TLS 1.3, OAuth2/JWT")
Rel(Hospital Administrators, Clinic Management System, "Manages system operations and administrative functions", "HTTPS/TLS 1.3, OAuth2/JWT")
Rel(Clinic Management System, Identity Provider (IdP), "Authenticates users and issues tokens", "OAuth2/JWT")
Rel(Clinic Management System, External Lab & Imaging Systems, "Exchanges standardized clinical data", "RESTful HL7 FHIR over mutual TLS (mTLS)")
Rel(Clinic Management System, Payment Gateways/Insurance Clearinghouses, "Processes payments and insurance claims", "HTTPS")
@enduml