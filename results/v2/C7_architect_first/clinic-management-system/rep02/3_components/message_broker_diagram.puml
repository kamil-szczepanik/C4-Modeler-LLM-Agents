@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Core_Services, "Core Services", "External container interacting with the Message Broker")

Container_Boundary(message_broker, "Message Broker") {
    Component(Ingestion_Router, "Ingestion Router", "Kafka KRaft", "Routes raw event streams and publishes domain events via mTLS and Kafka Protocol.")
    Component(Schema_Registry, "Schema Registry", "Confluent Schema Registry", "Validates event schemas via HTTP/REST over TLS.")
    Component(DLQ_Manager, "DLQ Manager", "Apache Kafka Topic", "Diverts failed processing messages via Kafka Topic.")
    Component(Encryption_Key_Manager, "Encryption Key Manager", "KMS", "Fetches data encryption keys via internal gRPC over TLS.")
    Component(Topic_Replicator, "Topic Replicator", "MirrorMaker 2", "Streams replicated topics for hybrid DR via Kafka TLS.")
    Component(Broker_Authorization___ACL_Enforcement_Engine, "Broker Authorization & ACL Enforcement Engine", "Internal API/Plugin", "Validates client publish/consume permissions via internal API/Plugin.")
    Component(Operational_Audit___Compliance_Exporter, "Operational Audit & Compliance Exporter", "Async Exporter", "Forwards non-payload access telemetry asynchronously.")
    Component(Stream_Processing___State_Handler, "Stream Processing / State Handler", "Kafka Streams", "Manages event aggregations and windowing for complex clinical workflows.")
    Component(Broker_Health___Metrics_Exporter, "Broker Health & Metrics Exporter", "Prometheus", "Exposes Prometheus metrics via HTTP Scrape over TLS.")
}

Rel(Core_Services, Ingestion_Router, "Publishes domain events", "mTLS and Kafka Protocol")
Rel(Ingestion_Router, Schema_Registry, "Validates event schemas", "HTTP/REST over TLS")
Rel(Ingestion_Router, Encryption_Key_Manager, "Fetches data encryption keys", "internal gRPC over TLS")
Rel(Ingestion_Router, Topic_Replicator, "Streams replicated topics for hybrid DR", "Kafka TLS")
Rel(Ingestion_Router, Broker_Authorization___ACL_Enforcement_Engine, "Validates client publish/consume permissions", "internal API/Plugin")
Rel(Ingestion_Router, Operational_Audit___Compliance_Exporter, "Forwards non-payload access telemetry asynchronously", "Async")
Rel(Ingestion_Router, Stream_Processing___State_Handler, "Routes raw event streams", "internal Kafka Protocol")
Rel(Stream_Processing___State_Handler, DLQ_Manager, "Diverts failed processing messages", "Kafka Topic")
Rel(Ingestion_Router, Broker_Health___Metrics_Exporter, "Exposes Prometheus metrics", "HTTP Scrape over TLS")

@enduml