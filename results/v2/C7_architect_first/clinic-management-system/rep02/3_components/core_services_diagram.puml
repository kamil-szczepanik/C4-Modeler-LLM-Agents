@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(core_services, "Core Services") {
    Component(patient_registry_component, "Patient Registry Component", "Spring Boot / Java", "Manages patient admissions, demographics, and registry data.")
    Component(scheduling_engine, "Scheduling Engine", "Spring Boot / Java", "Handles appointment scheduling and emits lifecycle events.")
    Component(emr_management_component, "EMR Management Component", "Spring Boot / Java", "Manages electronic medical records, writes encrypted records, and creates audit logs.")
    Component(billing_processor, "Billing Processor", "Spring Boot / Java", "Processes billing and revenue cycle operations.")
}

System_Ext(data_tier, "Data Tier", "PostgreSQL database storing transactional patient and billing data.")
System_Ext(message_broker, "Message Broker", "Kafka message broker for asynchronous event-driven messaging.")
System_Ext(worm_storage, "WORM Storage", "WORM Object Storage for long-term retention of cryptographically signed audit logs.")

Rel(emr_management_component, data_tier, "Writes encrypted patient records and tamper-evident audit logs", "JDBC with AES-256")
Rel(scheduling_engine, message_broker, "Emits appointment lifecycle events", "Kafka")
Rel(core_services, worm_storage, "Archives cryptographically signed audit logs for long-term retention", "HTTPS")

@enduml