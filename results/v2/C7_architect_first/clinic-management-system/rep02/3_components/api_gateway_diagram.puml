@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(Edge_Router_Component, "Edge Router Component", "Envoy", "Provides dynamic routing and strict mTLS for incoming traffic.")
    Component(Authentication_Filter_Component, "Authentication Filter Component", "OAuth2 / OpenID Connect / JWT", "Authenticates users and validates tokens.")
    Component(Rate_Limiter_Component, "Rate Limiter Component", "Envoy Rate Limiter", "Enforces rate limits on incoming requests.")
    Component(Local_Rate_Limit_Cache_Component, "Local Rate Limit Cache Component", "In-Memory Cache", "Caches rate-limiting data locally for fast evaluation.")
    Component(Telemetry___Audit_Filter_Component, "Telemetry & Audit Filter Component", "Envoy Native Tracing", "Handles native tracing and PHI-sanitized audit logging.")
}

Rel(Edge_Router_Component, Authentication_Filter_Component, "Passes requests for token validation")
Rel(Authentication_Filter_Component, Rate_Limiter_Component, "Forwards authenticated requests for rate limit checks")
Rel(Rate_Limiter_Component, Local_Rate_Limit_Cache_Component, "Queries local cache")
Rel(Rate_Limiter_Component, Telemetry___Audit_Filter_Component, "Passes requests for telemetry and auditing")

@enduml