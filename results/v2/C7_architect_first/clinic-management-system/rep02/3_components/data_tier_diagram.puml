@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Tier container

Container_Boundary(data_tier, "Data Tier") {
    Component(Primary_DB_Instance, "Primary DB Instance", "PostgreSQL 16", "Handling transactional writes and critical reads.")
    Component(Replica_DB_Instances, "Replica DB Instances", "PostgreSQL 16, Patroni", "Managed by Patroni for read-only EMR and reporting queries.")
    Component(Audit_Ledger_Component, "Audit Ledger Component", "PostgreSQL 16 Partition, Row-Level Security", "WORM-enabled append-only database table partition.")
    Component(Connection_Pooler, "Connection Pooler", "PgBouncer", "Routing traffic and preventing connection starvation.")
    Component(External_KMS, "External KMS", "HashiCorp Vault", "Managing per-record Data Encryption Keys (DEKs).")
}

Rel(Primary_DB_Instance, Replica_DB_Instances, "Synchronous/asynchronous data replication via Patroni.")

@enduml