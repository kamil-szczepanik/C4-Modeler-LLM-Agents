@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(Storage, "Storage") {
    Component(Core Services, "Core Services", "Spring Boot / Java", "Manages patient admissions, EMRs, scheduling, and billing while ensuring strict HIPAA and GDPR compliance.")
    Component(Ingestion & Validation Engine, "Ingestion & Validation Engine", "Node.js", "Powers high-throughput request handling and payload ingestion.")
    Component(Encryption Manager, "Encryption Manager", "Java / BouncyCastle", "Enforces envelope encryption and KMS integration.")
    Component(Retention & Compliance Controller, "Retention & Compliance Controller", "Go", "Implements robust WORM immutability enforcement.")
    Component(Metadata Indexer, "Metadata Indexer", "Elasticsearch / OpenSearch", "Handles indexed metadata search with strict RBAC and AES-256 encryption.")
    Component(Object Store Backend, "Object Store Backend", "MinIO / AWS S3 Object Lock", "Provides secure, highly available, and immutable long-term data retention for audit logs and medical records.")
    Component(Buffer Queue, "Buffer Queue", "Embedded SQLite/WAL", "Provides local write-ahead logging to guarantee zero audit log loss during network partitions.")
}

Rel(Core Services, Ingestion & Validation Engine, "Sends audit logs and EMR archives", "gRPC over mTLS")
Rel(Ingestion & Validation Engine, Encryption Manager, "Passes raw payloads for encryption", "Internal In-Memory API")
Rel(Ingestion & Validation Engine, Metadata Indexer, "Publishes search metadata", "Kafka/Async")
Rel(Encryption Manager, Object Store Backend, "Writes encrypted objects", "S3 API")
@enduml