@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Identity & Access Management container

Container(API_Gateway, "API Gateway", "API Gateway Technology", "Entry point for external and internal requests.")
Container_Db(Message_Broker, "Message Broker", "Apache Kafka", "Handles asynchronous messaging and event streaming.")

Container_Boundary(IAM, "Identity & Access Management") {
    Component(Authentication_Engine_Keycloak_Core, "Authentication Engine (Keycloak Core)", "Keycloak Core", "Manages credentials, federation, and MFA to ensure robust IAM.")
    Component(Token_Service, "Token Service", "JSON Web Tokens (JWT)", "Uses asymmetric keys (RS256/ES256) for stateless, secure session handling.")
    Component(Policy_Decision_Point_PDP, "Policy Decision Point (PDP)", "Java / Custom Policy Engine", "Evaluates access rules and fine-grained access control.")
    Component(Audit_Logger, "Audit Logger", "Apache Kafka", "Publishes security events and handles asynchronous audit logging to meet 10-year retention rules.")
    Component(Caching_Redis_Cluster, "Caching & Redis Cluster", "Redis Cluster", "Provides in-memory caching for sub-millisecond RBAC evaluations.")
    Component(User_Role_Sync_Service, "User & Role Sync Service", "Async Worker Service", "Syncs user roles asynchronously to the Redis cluster.")
    Component(Identity_Federation_Adapter, "Identity Federation Adapter", "OIDC / SAML", "Delegates external patient logins.")
}

Rel(API_Gateway, Token_Service, "Validates incoming JWTs", "gRPC / Internal REST")
Rel(Policy_Decision_Point_PDP, Caching_Redis_Cluster, "Evaluates access rules", "Redis Protocol")
Rel(Audit_Logger, Message_Broker, "Publishes security events", "Kafka Protocol")
Rel(Authentication_Engine_Keycloak_Core, Identity_Federation_Adapter, "Delegates external patient logins", "OIDC / SAML")
Rel(User_Role_Sync_Service, Caching_Redis_Cluster, "Syncs user roles asynchronously", "Redis Protocol")

@enduml