@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(integration_service, "Integration Service") {
    Component(FHIR_Transformer_Engine, "FHIR Transformer Engine", "Apache Camel/Java", "Forwards normalized payloads and handles HL7 FHIR transformations using robust enterprise integration patterns.")
    Component(External_Protocol_Adapter, "External Protocol Adapter", "HTTPS/REST with mTLS", "Exchanges health data with external lab and imaging systems.")
    Component(Resilience_Circuit_Breaker_Manager, "Resilience & Circuit Breaker Manager", "Resilience4j", "Protects against external cascading failures using circuit breaking, timeouts, and backoff retry policies.")
    Component(Outbox_Message_Publisher, "Outbox Message Publisher", "Java / Message Publisher", "Publishes integration audit events.")
    Component(DLQ_Exception_Router, "DLQ Exception Router", "Java / Exception Router", "Routes poisoned or failed payloads to the DLQ topic with AES-GCM envelope encryption for PHI payloads.")
    Component(Message_Broker_Kafka, "Message Broker (Kafka)", "Apache Kafka", "Handles integration event messaging and DLQ topics.")
}

Component_Ext(External_Lab_Imaging_Systems, "External Lab & Imaging Systems", "External Systems", "External clinical and imaging systems exchanging health data.")

Rel(FHIR_Transformer_Engine, External_Protocol_Adapter, "Forwards normalized payloads", "Direct Route")
Rel(Resilience_Circuit_Breaker_Manager, External_Protocol_Adapter, "Protects against external cascading failures", "In-memory wrapper")
Rel(Outbox_Message_Publisher, Message_Broker_Kafka, "Publishes integration audit events", "TCP/Kafka")
Rel(DLQ_Exception_Router, Message_Broker_Kafka, "Routes poisoned or failed payloads to the DLQ topic", "TCP/Kafka")
Rel(External_Protocol_Adapter, External_Lab_Imaging_Systems, "Exchanges health data", "mTLS over HTTPS/REST")

@enduml