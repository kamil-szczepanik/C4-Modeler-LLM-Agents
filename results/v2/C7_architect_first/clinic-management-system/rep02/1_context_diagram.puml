@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Clinic Management System

Person(Patients, "Patients", "Patients who interact with the system for self-service scheduling and viewing lab results.")
Person(Doctors_Nurses_and_Clinic_Staff, "Doctors, Nurses, and Clinic Staff", "Clinical staff who access the system for patient care and management.")
Person(Hospital_Administrators, "Hospital Administrators", "Administrative staff managing overall clinic operations.")
Person(Billing_Specialists___Revenue_Cycle_Managers, "Billing Specialists / Revenue Cycle Managers", "Staff handling billing and financial transactions.")

System(Clinic_Management_System, "Clinic Management System", "Manages patient admissions, electronic medical records (EMR), scheduling, and billing for medium-sized clinics via a hybrid cloud architecture.")

System_Ext(Payment_Gateway, "Payment Gateway", "External service processing billing transactions.")
System_Ext(Insurance_Verification_Service, "Insurance Verification Service", "External service used for verifying patient insurance.")
System_Ext(External_Lab___Imaging_Systems, "External Lab & Imaging Systems", "External systems providing laboratory and imaging data.")
System_Ext(Public_Health_Registries, "Public Health Registries", "External registries for public health reporting.")

Rel(Patients, Clinic_Management_System, "Interact with the system for self-service scheduling and lab results.", "HTTPS")
Rel(Doctors_Nurses_and_Clinic_Staff, Clinic_Management_System, "Access the system for clinical and administrative workflows with Multi-Factor Authentication.", "HTTPS with MFA")
Rel(Hospital_Administrators, Clinic_Management_System, "Access the system for administrative management.", "HTTPS with MFA")
Rel(Billing_Specialists___Revenue_Cycle_Managers, Clinic_Management_System, "Access the system for managing billing and revenue.", "HTTPS with MFA")
Rel(Clinic_Management_System, Payment_Gateway, "Connects for billing transactions.", "REST over TLS 1.3")
Rel(Clinic_Management_System, Insurance_Verification_Service, "Integrates for verifying insurance.", "REST and OAuth2 over HTTPS")
Rel(External_Lab___Imaging_Systems, Clinic_Management_System, "Communicate platform data and lab results.", "HL7 FHIR over HTTPS/TLS")
Rel(Clinic_Management_System, Public_Health_Registries, "Integrates for public health reporting.", "REST and OAuth2 over HTTPS")
@enduml