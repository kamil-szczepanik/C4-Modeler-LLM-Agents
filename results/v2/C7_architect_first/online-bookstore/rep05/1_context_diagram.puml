@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(CustomersAdmin, "Customers & Admins", "End-users browsing the catalog, making purchases, and internal support staff managing the platform.")

System_Ext(GlobalEdgeLayer, "Global Edge Layer", "CDN and edge routing layer with AWS WAF and AWS Shield for security and routing.")
System_Ext(StripePayPal, "Stripe/PayPal", "Payment Gateway for secure payment processing.")
System_Ext(FedExUPS, "FedEx/UPS", "Shipping APIs for order fulfillment and shipping.")
System_Ext(SendGridAwssEs, "SendGrid/AWS SES", "Notification Service for transactional messaging.")
System_Ext(FixerOpenExchangeRates, "Fixer/Open Exchange Rates", "Currency Exchange Rate Provider for multi-currency support.")

System(OnlineBookstoreSystem, "Online Bookstore System", "A globally distributed e-commerce platform designed to support 1 million monthly active users with multi-currency checkout, secure payments, and strict regulatory compliance.")

Rel(CustomersAdmin, GlobalEdgeLayer, "Accesses the platform via global edge routing", "HTTPS / TLS 1.3 via Global Anycast DNS (AWS Route 53)")
Rel(GlobalEdgeLayer, OnlineBookstoreSystem, "Routes traffic to regional deployments", "HTTPS / TLS 1.3")
Rel(OnlineBookstoreSystem, StripePayPal, "Processes secure payments and checkout", "HTTPS / REST / mTLS 1.3")
Rel(OnlineBookstoreSystem, FedExUPS, "Handles shipping and fulfillment integration", "HTTPS / REST / mTLS 1.3")
Rel(OnlineBookstoreSystem, FixerOpenExchangeRates, "Fetches currency exchange rates", "HTTPS / REST / mTLS 1.3")
Rel(OnlineBookstoreSystem, SendGridAwssEs, "Sends transactional messages and notifications", "HTTPS / SMTP / TLS 1.3")

@enduml