@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Customer Privacy/Compliance Service container

Container_Boundary(customer_privacy_compliance_service, "Customer Privacy/Compliance Service") {
    Component(Consent_and_Preference_Controller, "Consent & Preference Controller", "gRPC, Spring Boot", "Manages opt-ins/opt-outs and self-service privacy portal APIs.")
    Component(Data_Erasure_and_Anonymization_Engine, "Data Erasure & Anonymization Engine", "Amazon SQS, Distributed Saga Pattern", "Executes distributed saga patterns via Amazon SQS for data deletion.")
    Component(Data_Export_Handler, "Data Export Handler", "Amazon S3, Java", "Aggregates customer data and generates secure Amazon S3 export packages.")
    Component(Compliance_Audit_Logger, "Compliance Audit Logger", "Amazon DynamoDB, AWS KMS", "Records immutable regulatory audit trails in Amazon DynamoDB.")
}

System_Ext(Amazon_SQS, "Amazon SQS", "Message Queue")
System_Ext(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Database")
System_Ext(Amazon_DynamoDB, "Amazon DynamoDB", "NoSQL Database")

Rel(Consent_and_Preference_Controller, Data_Erasure_and_Anonymization_Engine, "Triggers asynchronous deletion workflows")
Rel(Data_Erasure_and_Anonymization_Engine, Amazon_SQS, "Publishes and consumes asynchronous deletion and saga events")
Rel(Data_Export_Handler, Amazon_Aurora_PostgreSQL, "Queries customer data for export packages")
Rel(Compliance_Audit_Logger, Amazon_DynamoDB, "Persists immutable audit trails with AWS KMS encryption")

@enduml