@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification Service container

Container_Boundary(notification_service, "Notification Service") {
    Component(Event_Consumer_Component, "Event Consumer Component", "Spring Boot (Java)", "Processes asynchronous domain events.")
    Component(Notification_Router_Component, "Notification Router Component", "Java / gRPC", "Handles user preferences and routing decisions.")
    Component(Template_Engine_Component, "Template Engine Component", "Thymeleaf", "Renders localized messages using templates from Amazon S3.")
    Component(Dispatch_Adapter_Component, "Dispatch Adapter Component", "Java / AWS SDK", "Integrates with external providers via HTTPS/SMTP, backed by AWS Secrets Manager.")
    Component(Amazon_SQS, "Amazon SQS", "Amazon SQS", "Buffers incoming domain events and includes Dead Letter Queues (DLQ).")
    Component(Amazon_DynamoDB, "Amazon DynamoDB", "Amazon DynamoDB", "Stores scalable, non-PII delivery audit trails.")
}

System_Ext(Customer_Privacy_Compliance_Service, "Customer Privacy/Compliance Service", "External service for compliance.")
System_Ext(Amazon_S3, "Amazon S3", "Object storage for templates.")
System_Ext(External_Providers, "External Providers", "SendGrid, Amazon SES, and Amazon SNS")
System_Ext(AWS_Secrets_Manager, "AWS Secrets Manager", "Secrets management service.")

Rel(Amazon_SQS, Event_Consumer_Component, "Consumes domain events", "Polling over AWS SDK")
Rel(Notification_Router_Component, Customer_Privacy_Compliance_Service, "Validates opt-in preferences", "gRPC over AWS App Mesh with mTLS")
Rel(Template_Engine_Component, Amazon_S3, "Fetches notification templates", "HTTPS")
Rel(Dispatch_Adapter_Component, External_Providers, "Sends emails and SMS", "HTTPS/SMTP")
Rel(Dispatch_Adapter_Component, AWS_Secrets_Manager, "Fetches credentials", "AWS SDK over HTTPS")
Rel(Dispatch_Adapter_Component, Amazon_DynamoDB, "Persists delivery logs", "DynamoDB Wire Protocol")

@enduml