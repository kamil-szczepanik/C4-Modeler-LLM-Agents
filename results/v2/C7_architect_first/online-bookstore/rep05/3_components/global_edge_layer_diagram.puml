@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(global_edge_layer, "Global Edge Layer") {
    Component(DNS_Router, "DNS Router", "Amazon Route 53 (Anycast geo-DNS)", "Directs global user traffic with geo-DNS routing and automated health-check failovers.")
    Component(Web_Application_Firewall, "Web Application Firewall", "AWS WAF", "Provides OWASP Top-10 mitigation, rate-limiting, and geo-restriction compliance.")
    Component(Edge_Request_Transformer, "Edge Request Transformer", "CloudFront Functions / Lambda@Edge", "Performs header sanitization, sub-millisecond request transformation, and edge JWT validation.")
    Component(Edge_Content_Delivery_Network, "Edge Content Delivery Network", "Amazon CloudFront and Amazon S3", "Handles static asset caching, global delivery, and dynamic origin shielding.")
    Component(Amazon_API_Gateway, "Amazon API Gateway", "Amazon API Gateway", "Routes dynamic API traffic from the edge to the regional backend.")
}

Rel(DNS_Router, Web_Application_Firewall, "Directs global user traffic", "DNS")
Rel(Web_Application_Firewall, Edge_Request_Transformer, "Forwards filtered HTTP/S requests", "HTTPS")
Rel(Edge_Request_Transformer, Edge_Content_Delivery_Network, "Passes enriched requests for cache evaluation", "Internal")
Rel(Edge_Content_Delivery_Network, Amazon_API_Gateway, "Routes dynamic API traffic and bypasses cache for authenticated routes", "HTTPS/REST")

@enduml