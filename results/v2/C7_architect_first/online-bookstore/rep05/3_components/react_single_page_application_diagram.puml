@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the React Single Page Application container

Container_Boundary(react_spa, "React Single Page Application") {
    Component(Routing_App_Shell, "Routing & App Shell", "React, react-router-dom", "Handles client-side routing and application layout, supporting dynamic imports and code-splitting.")
    Component(Catalog_Search_Module, "Catalog & Search Module", "React, Redux Toolkit", "Manages catalog browsing, search state, and related UI components.")
    Component(Cart_Checkout_Flow, "Cart & Checkout Flow", "React Hook Form, Stripe Elements SDK", "Manages shopping cart operations, checkout validation, and secure payment processing.")
    Component(Recommendation_Review_Widgets, "Recommendation & Review Widgets", "React", "Renders personalized recommendations and product reviews.")
    Component(API_Client, "API Client", "Axios, GraphQL Client", "Communicates with backend APIs via HTTPS, REST, and GraphQL.")
    Component(Browser_Local_Storage, "Browser Local Storage", "Browser Local Storage", "Provides an encrypted guest cart fallback mechanism.")
}

Component(Global_Edge_Layer, "Global Edge Layer", "Amazon CloudFront, Amazon S3", "Delivers static assets globally with low latency and high availability.")
Component(Amazon_API_Gateway, "Amazon API Gateway", "Amazon API Gateway", "Routes client requests securely to backend services.")

Rel(Global_Edge_Layer, Routing_App_Shell, "HTTPS", "HTTPS")
Rel(Routing_App_Shell, Catalog_Search_Module, "Dynamic Import / React.lazy", "Dynamic Import")
Rel(Routing_App_Shell, Cart_Checkout_Flow, "Dynamic Import / React.lazy", "Dynamic Import")
Rel(Catalog_Search_Module, API_Client, "HTTPS/REST/GraphQL", "HTTPS/REST/GraphQL")
Rel(Cart_Checkout_Flow, API_Client, "HTTPS/REST/GraphQL", "HTTPS/REST/GraphQL")
Rel(Recommendation_Review_Widgets, API_Client, "HTTPS/REST/GraphQL", "HTTPS/REST/GraphQL")
Rel(API_Client, Amazon_API_Gateway, "HTTPS/WSS", "HTTPS/WSS")
Rel(Cart_Checkout_Flow, Browser_Local_Storage, "Encrypted JSON, fallback only", "Encrypted JSON")

@enduml