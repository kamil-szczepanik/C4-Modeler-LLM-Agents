@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(review_service, "Review Service") {
    Component(Review_API_Controller, "Review API Controller", "Node.js/TypeScript (Express/gRPC)", "Handles authenticated review requests and routes gRPC traffic.")
    Component(Review_Data_Access_Component, "Review Data Access Component", "Node.js/TypeScript", "Manages persistence and cache invalidation.")
    Component(Rating_Aggregator_Component, "Rating Aggregator Component", "Node.js/TypeScript", "Handles asynchronous aggregate score recalculation.")
    Component(Review_Moderation_Engine, "Review Moderation Engine", "AWS Lambda", "Processes text for sentiment and compliance.")
}

Component_Ext(Amazon_API_Gateway, "Amazon API Gateway", "AWS API Gateway", "Routes incoming gRPC traffic over HTTP/2 with mTLS via AWS App Mesh.")
Component_Ext(Order___Checkout_Service, "Order & Checkout Service", "Microservice", "Validates purchase history via gRPC calls.")
Component_Ext(Amazon_ElastiCache__Redis_, "Amazon ElastiCache (Redis)", "Amazon ElastiCache Redis", "Caches queries and invalidates keys on writes/GDPR deletions.")
Component_Ext(AWS_RDS_Proxy, "AWS RDS Proxy", "AWS RDS Proxy", "Manages database connection pools securely.")
Component_Ext(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Executes relational database queries with KMS encryption.")
Component_Ext(Amazon_SQS, "Amazon SQS", "Amazon SQS with DLQs", "Processes moderation tasks asynchronously.")

Rel(Amazon_API_Gateway, Review_API_Controller, "Routes incoming gRPC traffic over HTTP/2 with mTLS via AWS App Mesh.", "HTTP/2 / gRPC")
Rel(Review_API_Controller, Order___Checkout_Service, "Validates purchase history via gRPC calls.", "gRPC")
Rel(Review_API_Controller, Review_Data_Access_Component, "Executes internal function calls.", "Function Call")
Rel(Review_Data_Access_Component, Amazon_ElastiCache__Redis_, "Caches queries and invalidates keys on writes/GDPR deletions.", "Redis Protocol")
Rel(Review_Data_Access_Component, AWS_RDS_Proxy, "Manages database connection pools securely.", "TCP")
Rel(AWS_RDS_Proxy, Amazon_Aurora_PostgreSQL, "Executes JDBC/TLS over TCP queries with KMS encryption.", "JDBC/TLS")
Rel(Review_Moderation_Engine, Amazon_SQS, "Processes moderation tasks asynchronously.", "AWS SDK")

@enduml