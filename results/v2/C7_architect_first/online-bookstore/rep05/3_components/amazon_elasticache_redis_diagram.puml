@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Order_Checkout_Service, "Order & Checkout Service", "ECS Fargate container handling transactions and acquiring locks via Amazon DynamoDB.")
System_Ext(Recommendation_Service, "Recommendation Service", "ECS Fargate container fetching item affinities.")
System_Ext(Customer_Privacy_Compliance_Service, "Customer Privacy/Compliance Service", "Manages data erasure and GDPR/CCPA 'Right to be Forgotten' requests.")

Container_Boundary(Amazon_ElastiCache_Redis, "Amazon ElastiCache Redis") {
    Component(Session_Store_Engine, "Session Store Engine", "Redis Hashes, Redis (Cluster Mode), RESP v3", "Manages user shopping cart states and session data with a 7-day TTL and noeviction policy.")
    Component(Recommendation_Cache_Engine, "Recommendation Cache Engine", "Redis Sorted Sets (ZSET), Redis (Cluster Mode), RESP v3", "Stores precomputed 'Customers also bought' item affinities using volatile-lru eviction.")
}

Rel(Order_Checkout_Service, Session_Store_Engine, "Reads and writes cart state", "RESP v3 over TLS")
Rel(Recommendation_Service, Recommendation_Cache_Engine, "Fetches item affinities", "RESP v3 over TLS")
Rel(Customer_Privacy_Compliance_Service, Session_Store_Engine, "Purges user session hashes and PII", "Redis SCAN and DEL")
@enduml