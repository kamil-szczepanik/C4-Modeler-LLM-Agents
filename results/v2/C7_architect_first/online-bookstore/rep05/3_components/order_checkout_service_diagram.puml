@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Order & Checkout Service container

Container_Boundary(order_checkout_service, "Order & Checkout Service") {
    Component(Order_Management, "Order Management", "Spring Boot / Java", "Handles core order processing, transactional state, and audit trails.")
    Component(Payment_Orchestration, "Payment Orchestration", "Spring Boot / Java", "Coordinates payment processing and stores idempotency keys.")
    Component(Fulfillment_Integration, "Fulfillment Integration", "Spring Boot / Java", "Integrates with external shipping providers to generate shipping labels.")
    Component(Outbox_Event_Publisher, "Outbox Event Publisher", "Spring Boot / Java", "Publishes asynchronous fulfillment messages using the outbox pattern.")
}

System_Ext(Stripe_PayPal, "Stripe/PayPal", "External payment processing system.")
System_Ext(FedEx_UPS, "FedEx/UPS", "External shipping providers.")
System_Ext(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Relational database for ACID-compliant transactional data and outbox pattern.")
System_Ext(Amazon_SQS, "Amazon SQS", "Message queue for asynchronous fulfillment workflows.")
System_Ext(Amazon_ElastiCache_Redis, "Amazon ElastiCache Redis", "Distributed cache for idempotency key management.")

Rel(Order_Management, Payment_Orchestration, "Internal method calls", "Java")
Rel(Payment_Orchestration, Stripe_PayPal, "Processes payments", "HTTPS with TLS 1.3")
Rel(Fulfillment_Integration, FedEx_UPS, "Generates shipping labels", "HTTPS")
Rel(Order_Management, Amazon_Aurora_PostgreSQL, "Persists transactional state and audit trails", "PostgreSQL Wire Protocol via HikariCP")
Rel(Outbox_Event_Publisher, Amazon_SQS, "Publishes asynchronous fulfillment messages", "AWS SDK")
Rel(Payment_Orchestration, Amazon_ElastiCache_Redis, "Stores idempotency keys", "Redis Wire Protocol with TLS")

@enduml