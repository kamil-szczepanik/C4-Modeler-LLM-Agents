@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Recommendation Service container

System_Ext(AmazonAPI_Gateway, "Amazon API Gateway", "External API Gateway")

Container_Boundary(recommendation_service, "Recommendation Service") {
    Component(RecommendationAPI_Controller, "Recommendation API Controller", "Go", "Go service handling incoming gRPC requests, input validation, and fallback logic.")
    Component(RecommendationEngine, "Recommendation Engine", "Python FastAPI", "Python FastAPI service running collaborative filtering and ML scoring models.")
    Component(FallbackResiliency_Manager, "Fallback & Resiliency Manager", "Go / Resilience Logic", "Component handling circuit breaking and static top-seller fallbacks.")
    Component(DataAccess_Repository, "Data Access Repository", "Go Module", "Go module interfacing with databases and caches.")
    Component(AmazonElastiCache_Redis, "Amazon ElastiCache Redis", "Amazon ElastiCache Redis", "High-performance cache storing pre-computed recommendation vectors and fallbacks.")
    Component(AmazonAurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Relational database storing anonymized historical purchase data.")
    Component(AWSApp_Mesh, "AWS App Mesh", "AWS App Mesh", "Service mesh managing secure internal communications and telemetry.")
}

Rel(AmazonAPI_Gateway, RecommendationAPI_Controller, "Routes gRPC requests", "gRPC over HTTP/2 via AWS App Mesh")
Rel(RecommendationAPI_Controller, RecommendationEngine, "Forwards scoring requests", "gRPC over mTLS via AWS App Mesh")
Rel(RecommendationAPI_Controller, AmazonElastiCache_Redis, "Queries fallback top-sellers", "Redis Protocol over TLS")
Rel(RecommendationEngine, AmazonElastiCache_Redis, "Fetches pre-computed vectors", "Redis Protocol over TLS")
Rel(RecommendationEngine, AmazonAurora_PostgreSQL, "Queries order history", "SQL/TCP with IAM Auth")

@enduml