@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_api_gateway, "Amazon API Gateway") {
    Component(API_Router, "API Router", "AWS API Gateway Routing", "Proxies requests and routes traffic to backend microservices.")
    Component(Auth_Authorization, "Auth & Authorization", "AWS API Gateway Custom Authorizer / AWS Cognito", "Validates user JSON Web Tokens (JWT) and handles authorization.")
    Component(Rate_Limiting_Throttling, "Rate Limiting & Throttling", "AWS API Gateway Usage Plans", "Enforces rate limits and throttles incoming API requests to protect backend services.")
}

Rel(API_Router, Auth_Authorization, "Validates user JWT", "HTTPS/WSS")
Rel(Auth_Authorization, API_Router, "Passes execution context", "Internal")

@enduml