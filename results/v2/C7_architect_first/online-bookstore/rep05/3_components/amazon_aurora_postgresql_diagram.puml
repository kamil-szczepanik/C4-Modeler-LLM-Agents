@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon Aurora PostgreSQL container

Container_Boundary(amazon_aurora_postgresql, "Amazon Aurora PostgreSQL") {
    Component(Writer Node, "Writer Node", "AWS Aurora PostgreSQL Engine", "Handles database write operations and transactions.")
    Component(Reader Node, "Reader Node", "AWS Aurora PostgreSQL Engine", "Handles read-only queries and data retrieval workloads.")
    Component(Connection Pooler, "Connection Pooler", "AWS RDS Proxy", "Manages connection spikes and prevents max-connection exhaustion from ECS Fargate.")
    Component(Distributed Storage Volume, "Distributed Storage Volume", "AWS Aurora Distributed Storage", "Provides multi-region durability and storage replication.")
}

Rel(Connection Pooler, Writer Node, "Routes write traffic", "Internal Routing")
Rel(Connection Pooler, Reader Node, "Routes read traffic", "Internal Routing")
Rel(Writer Node, Distributed Storage Volume, "Replicates data", "Storage Replication")

@enduml