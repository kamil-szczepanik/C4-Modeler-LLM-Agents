@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog Service container

Container_Boundary(catalog_service, "Catalog Service") {
    Component(CatalogAPIController, "Catalog API Controller", "Go, gRPC", "Handles incoming catalog requests and coordinates in-process method calls.")
    Component(SearchEngineAdapter, "Search Engine Adapter", "Go", "Adapts search queries for the underlying search engine.")
    Component(InventoryManager, "Inventory Manager", "Go", "Manages real-time inventory tracking and database operations.")
    Component(CatalogCacheLayer, "Catalog Cache Layer", "Go, go-redis", "Provides sub-second catalog detail caching and resiliency fallbacks.")
    Component(PricingLocalizationInterceptor, "Pricing & Localization Interceptor", "Go", "Provides multi-currency support and localization.")
    Component(InventoryWriteThroughEventPublisher, "Inventory Write-Through / Event Publisher", "Go", "Publishes inventory events and handles write-through updates.")
}

Component(AmazonOpenSearch, "Amazon OpenSearch", "Amazon OpenSearch", "High-performance keyword search and faceted catalog browsing.")
Component(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "ACID-compliant transactional data storage with multi-region read replicas.")
Component(AmazonElastiCacheRedis, "Amazon ElastiCache (Redis)", "Amazon ElastiCache (Redis)", "In-memory data store for caching.")
Component(AmazonSQSSNS, "Amazon SQS/SNS", "Amazon SQS/SNS", "Messaging and event publishing service.")

Rel(CatalogAPIController, SearchEngineAdapter, "In-process method calls")
Rel(CatalogAPIController, InventoryManager, "In-process method calls")
Rel(SearchEngineAdapter, AmazonOpenSearch, "Query DSL over HTTPS")
Rel(InventoryManager, AmazonAuroraPostgreSQL, "PostgreSQL Wire Protocol via TCP")
Rel(CatalogCacheLayer, AmazonElastiCacheRedis, "RESP protocol via TCP")
Rel(InventoryWriteThroughEventPublisher, AmazonSQSSNS, "AWS SDK / HTTPS")

@enduml