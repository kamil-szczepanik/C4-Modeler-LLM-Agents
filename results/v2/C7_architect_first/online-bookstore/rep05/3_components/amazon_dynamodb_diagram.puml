@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon DynamoDB container

System_Ext(CatalogService, "Catalog Service", "External catalog service")
System_Ext(RecommendationService, "Recommendation Service", "External recommendation service")
System_Ext(AWSKMS, "AWS KMS", "Key Management Service")
System_Ext(DynamoDBStreams, "DynamoDB Streams", "Stream processing service")

Container_Boundary(AmazonDynamoDB, "Amazon DynamoDB") {
    Component(CatalogTableStore, "Catalog Table Store", "Amazon DynamoDB Standard Tables", "Stores book metadata, inventory counts, and categories partitioned by BookID.")
    Component(SearchIndexAccelerator, "Search Index Accelerator", "Global Secondary Indexes (GSIs) and DynamoDB Streams", "Maintains Global Secondary Indexes (GSIs) and DynamoDB Streams for faceted keyword/author searches and analytics.")
    Component(GlobalTableReplicaManager, "Global Table Replica Manager", "DynamoDB Global Tables", "Manages active-active multi-region replication across us-east-1, eu-west-1, and ap-southeast-1.")
}

Rel(CatalogService, CatalogTableStore, "Reads/writes book details and stock levels", "DynamoDB API over HTTPS via VPC Endpoint")
Rel(RecommendationService, CatalogTableStore, "Queries co-purchase patterns and GSI projections", "DynamoDB API over HTTPS via VPC Endpoint")
Rel(CatalogTableStore, AWSKMS, "Encrypts data at rest using Customer Managed Keys", "AWS internal API")
Rel(CatalogTableStore, DynamoDBStreams, "Emits item updates for downstream analytics", "AWS internal IPC")

@enduml