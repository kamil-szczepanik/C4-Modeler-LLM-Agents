@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(CustomersAndAdministrators, "Customers and Administrators", "End-users browsing the catalog, managing accounts, purchasing books, and internal staff administering the platform.")

System_Ext(StripePayPal, "Stripe/PayPal", "Payment Gateway for secure payment processing.")
System_Ext(FedExUPS, "FedEx/UPS", "Shipping APIs for order fulfillment and shipping.")
System_Ext(SendGridAmazonSES, "SendGrid/Amazon SES", "Notification Service for transactional messaging.")
System_Ext(FixerOpenExchangeRates, "Fixer/Open Exchange Rates", "Currency Exchange Rate Provider for multi-currency support.")

System_Boundary(OnlineBookstoreSystem, "Online Bookstore System") {
    Container(GlobalEdgeLayer, "Global Edge Layer", "Amazon CloudFront, Amazon Route 53, AWS WAF", "Provides global static asset delivery, DNS routing, and security/WAF mitigations.")
    Container(ReactSinglePageApplication, "React Single Page Application", "React, Amazon S3", "Frontend user interface hosted as a fast global static asset.")
    Container(AmazonAPIGateway, "Amazon API Gateway", "Amazon API Gateway (REST/GraphQL)", "Ingress layer handling authentication and routing requests to internal microservices.")
    Container(CatalogService, "Catalog Service", "Amazon ECS Fargate, gRPC, AWS App Mesh", "Manages book catalog, searching, and inventory.")
    Container(OrderCheckoutService, "Order & Checkout Service", "Amazon ECS Fargate, gRPC, AWS App Mesh", "Handles secure ordering, payment processing integrations, and checkout logic.")
    Container(RecommendationService, "Recommendation Service", "Amazon ECS Fargate, gRPC, AWS App Mesh", "Provides real-time personalized book recommendations.")
    Container(CustomerPrivacyComplianceService, "Customer Privacy/Compliance Service", "Amazon ECS Fargate, gRPC, AWS App Mesh", "Ensures strict GDPR and CCPA compliance and data protection.")
    Container(NotificationService, "Notification Service", "Amazon ECS Fargate, Amazon SQS/SNS", "Consumes events and dispatches transactional emails and notifications.")
    Container(ReviewService, "Review Service", "Amazon ECS Fargate, gRPC, AWS App Mesh", "Handles customer reviews and ratings for books.")
    Container(AnalyticsIngestionPipeline, "Analytics Ingestion Pipeline", "Amazon ECS Fargate, gRPC, AWS App Mesh", "Ingests operational and user activity data for analytics.")
    ContainerDb(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora (PostgreSQL)", "Primary transactional database ensuring checkout integrity.")
    ContainerDb(AmazonDynamoDB, "Amazon DynamoDB", "Amazon DynamoDB", "Fast NoSQL database supporting catalog and search features.")
    ContainerDb(AmazonElastiCacheRedis, "Amazon ElastiCache Redis", "Amazon ElastiCache (Redis)", "In-memory caching layer for real-time recommendations and fast data retrieval.")
}

Rel(CustomersAndAdministrators, GlobalEdgeLayer, "Accesses the React SPA via HTTPS through Amazon CloudFront and Amazon Route 53", "HTTPS")
Rel(GlobalEdgeLayer, ReactSinglePageApplication, "Serves static frontend assets from Amazon S3", "HTTPS")
Rel(ReactSinglePageApplication, AmazonAPIGateway, "Communicates for authentication, routing, and API requests", "HTTPS/WSS")
Rel(AmazonAPIGateway, CatalogService, "Routes requests to backend microservices", "gRPC over HTTP/2 via AWS App Mesh")
Rel(AmazonAPIGateway, OrderCheckoutService, "Routes requests to backend microservices", "gRPC over HTTP/2 via AWS App Mesh")
Rel(AmazonAPIGateway, RecommendationService, "Routes requests to backend microservices", "gRPC over HTTP/2 via AWS App Mesh")
Rel(AmazonAPIGateway, CustomerPrivacyComplianceService, "Routes requests to backend microservices", "gRPC over HTTP/2 via AWS App Mesh")
Rel(AmazonAPIGateway, NotificationService, "Routes requests to backend microservices", "gRPC over HTTP/2 via AWS App Mesh")
Rel(AmazonAPIGateway, ReviewService, "Routes requests to backend microservices", "gRPC over HTTP/2 via AWS App Mesh")
Rel(AmazonAPIGateway, AnalyticsIngestionPipeline, "Routes requests to backend microservices", "gRPC over HTTP/2 via AWS App Mesh")
Rel(OrderCheckoutService, StripePayPal, "Integrates securely for payment processing", "HTTPS")
Rel(OrderCheckoutService, FedExUPS, "Triggers third-party shipping APIs for fulfillment", "HTTPS")
Rel(NotificationService, SendGridAmazonSES, "Sends messages and transactional notifications", "HTTPS/SMTP")
Rel(OrderCheckoutService, AmazonAuroraPostgreSQL, "Persists transactional checkout and order data", "PostgreSQL Wire Protocol")
Rel(CatalogService, AmazonDynamoDB, "Reads and writes catalog and search data", "DynamoDB API")
Rel(RecommendationService, AmazonElastiCacheRedis, "Queries real-time caching for recommendations", "Redis Protocol")
Rel(NotificationService, AmazonAuroraPostgreSQL, "Consumes events and reads/writes state", "PostgreSQL Wire Protocol")

@enduml