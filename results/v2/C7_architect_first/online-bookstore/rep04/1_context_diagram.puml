@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Online Bookstore System

Person(Customer, "Customer", "End-user who browses books, purchases items via shopping cart/checkout, views recommendations, and leaves reviews.")
Person(Inventory_Manager, "Inventory Manager", "Staff member responsible for managing product catalog and inventory levels.")
Person(Customer_Support_Representative, "Customer Support Representative", "Staff member who manages orders and moderation using HTTPS with MFA/RBAC.")

System_Ext(AWS_Cognito, "AWS Cognito", "Identity Provider handling OIDC/OAuth 2.0 authentication and GDPR/CCPA consent.")
System_Ext(Payment_Gateway, "Payment Gateway", "External system (Stripe/PayPal) handling transaction authorizations with PCI-DSS scope isolation.")
System_Ext(Shipping_APIs, "Shipping APIs", "External logistics services (FedEx/UPS) coordinating shipping and fulfillment via REST/TLS with circuit breakers.")
System_Ext(Notification_Service, "Notification Service", "AWS SES providing communication and notification capabilities.")
System_Ext(Publisher_Partner_Systems, "Publisher Partner Systems", "Supply chain systems providing inventory feeds via SFTP/REST with IP allowlisting.")

System(Online_Bookstore_System, "Online Bookstore System", "An Amazon-style global e-commerce platform for physical and electronic books with recommendations and reviews, designed for 1M MAU across multiple geographic regions with high availability and strict privacy compliance.")

Rel(Customer, Online_Bookstore_System, "Browses and purchases items", "HTTPS/TLS 1.3")
Rel(Inventory_Manager, Online_Bookstore_System, "Manages catalog and inventory", "HTTPS")
Rel(Customer_Support_Representative, Online_Bookstore_System, "Manages orders and moderation", "HTTPS with MFA/RBAC")
Rel(Online_Bookstore_System, Payment_Gateway, "Authorizes transactions", "REST/TLS")
Rel(Online_Bookstore_System, Shipping_APIs, "Coordinates logistics", "REST/TLS with circuit breakers")
Rel(Online_Bookstore_System, AWS_Cognito, "Validates tokens and manages authentication", "OIDC/HTTPS")
Rel(Publisher_Partner_Systems, Online_Bookstore_System, "Syncs catalog and inventory feeds", "SFTP/HTTPS")

@enduml