@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore System

Person(Customer, "Customer", "End-user who browses books, purchases items via shopping cart/checkout, views recommendations, and leaves reviews.")
Person(InventoryManager, "Inventory Manager", "Staff member responsible for managing product catalog and inventory levels.")
Person(CustomerSupportRepresentative, "Customer Support Representative", "Staff member who manages orders and moderation using HTTPS with MFA/RBAC.")

System_Ext(AWSCognito, "AWS Cognito", "Identity Provider handling OIDC/OAuth 2.0 authentication and GDPR/CCPA consent.")
System_Ext(PaymentGateway, "Payment Gateway", "External system handling transaction authorizations with PCI-DSS scope isolation.")
System_Ext(ThirdPartyShippingAPIs, "Third-Party Shipping APIs", "External logistics services coordinating shipping and fulfillment.")
System_Ext(NotificationService, "Notification Service", "AWS SES providing communication and notification capabilities.")
System_Ext(PublisherPartnerSystems, "Publisher Partner Systems", "Supply chain systems providing inventory feeds.")

System_Boundary(OnlineBookstoreSystem, "Online Bookstore System") {
    Container(SPA, "Single-Page Application (SPA)", "React/TypeScript, AWS S3, Amazon CloudFront", "Frontend interface for users to interact with the e-commerce platform.")
    Container(AmazonAPIGateway, "Amazon API Gateway", "AWS", "Entry point managing REST/GraphQL requests and security.")
    Container(CatalogSearchService, "Catalog & Search Service", "Node.js/Express, Amazon ECS on AWS Fargate", "Handles product catalog and search functionality.")
    Container(OrderCheckoutService, "Order & Checkout Service", "Java/Spring Boot, Amazon ECS on AWS Fargate", "Manages order placement and checkout workflows.")
    Container(RecommendationService, "Recommendation Service", "Python/FastAPI, Amazon ECS on AWS Fargate", "Provides personalized book recommendations to users.")
    Container(LocalizationService, "Localization Service", "Node.js/Express, Amazon ECS on AWS Fargate", "Manages multi-region and localization support.")
    Container(ReviewModerationContainer, "Review Moderation Container", "Amazon ECS on AWS Fargate", "Moderates user reviews and feedback.")
    ContainerDb(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora (Multi-AZ/Global)", "Transactional database for core relational data.")
    ContainerDb(AmazonDynamoDB, "Amazon DynamoDB", "AWS NoSQL", "Stores shopping carts and session data.")
    ContainerDb(AmazonElastiCache, "Amazon ElastiCache", "Redis", "Caching layer for high-performance data retrieval.")
    Container(AmazonSQSSNS, "Amazon SQS/SNS", "AWS", "Async messaging for decoupling core microservices.")
}

Rel(Customer, SPA, "Browses and purchases items via HTTPS", "HTTPS/TLS 1.3 (Amazon CloudFront)")
Rel(InventoryManager, SPA, "Manages catalog and inventory", "HTTPS")
Rel(CustomerSupportRepresentative, SPA, "Manages orders and moderation", "HTTPS with MFA/RBAC")
Rel(SPA, AmazonAPIGateway, "Sends API requests", "REST/GraphQL over HTTPS")
Rel(AmazonAPIGateway, AWSCognito, "Validates tokens and authenticates users", "OIDC/HTTPS")
Rel(AmazonAPIGateway, CatalogSearchService, "Routes catalog and search queries", "gRPC over HTTP/2")
Rel(AmazonAPIGateway, OrderCheckoutService, "Routes order and checkout requests", "gRPC over HTTP/2")
Rel(AmazonAPIGateway, RecommendationService, "Routes recommendation requests", "gRPC over HTTP/2")
Rel(AmazonAPIGateway, LocalizationService, "Routes localization requests", "gRPC over HTTP/2")
Rel(AmazonAPIGateway, ReviewModerationContainer, "Routes review moderation requests", "gRPC over HTTP/2")
Rel(CatalogSearchService, AmazonAuroraPostgreSQL, "Reads and writes transactional data", "TCP/TLS")
Rel(OrderCheckoutService, AmazonAuroraPostgreSQL, "Reads and writes transactional data", "TCP/TLS")
Rel(OrderCheckoutService, AmazonDynamoDB, "Manages cart and session data", "TCP/TLS")
Rel(RecommendationService, AmazonAuroraPostgreSQL, "Reads catalog data", "TCP/TLS")
Rel(LocalizationService, AmazonAuroraPostgreSQL, "Reads localization data", "TCP/TLS")
Rel(OrderCheckoutService, PaymentGateway, "Authorizes transactions", "HTTPS")
Rel(OrderCheckoutService, ThirdPartyShippingAPIs, "Coordinates fulfillment and logistics", "HTTPS")
Rel(OrderCheckoutService, AmazonSQSSNS, "Publishes asynchronous events", "AWS SQS/SNS protocols")
Rel(CatalogSearchService, AmazonSQSSNS, "Publishes asynchronous events", "AWS SQS/SNS protocols")
Rel(PublisherPartnerSystems, CatalogSearchService, "Syncs catalog and inventory feeds", "SFTP/REST")
Rel(NotificationService, Customer, "Sends notifications and communications", "SES/HTTPS")

@enduml