@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_dynamodb, "Amazon DynamoDB") {
    Component(Cart_Table_Component, "Cart Table Component", "Amazon DynamoDB Table", "Stores shopping cart items, read and deleted during checkout via AWS SDK.")
    Component(Session_Store_Component, "Session Store Component", "Amazon DynamoDB Table", "Stores low-latency user session data.")
    Component(DynamoDB_Streams_Component, "DynamoDB Streams Component", "Amazon DynamoDB Streams", "Emits real-time item mutation events from the cart table.")
}

Rel(Cart_Table_Component, DynamoDB_Streams_Component, "Emits real-time item mutation events", "Internal AWS IPC")
@enduml