@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Catalog_Search_Service, "Catalog & Search Service", "AWS ECS on Fargate")
System_Ext(Order_Checkout_Service, "Order & Checkout Service", "AWS ECS on Fargate")
System_Ext(Recommendation_Service, "Recommendation Service", "AWS ECS on Fargate")
System_Ext(Localization_Service, "Localization Service", "AWS ECS on Fargate")

System_Ext(AWS_Secrets_Manager, "AWS Secrets Manager", "Manages secrets")
System_Ext(Amazon_CloudWatch, "Amazon CloudWatch", "Collects metrics and logs")

Container_Boundary(Amazon_ElastiCache, "Amazon ElastiCache") {
    Component(Session_Store_Component, "Session Store Component", "Redis Engine (v6/v7)", "Manages active user carts and sessions for 1 million monthly active users.")
    Component(Product_Catalog_Cache_Component, "Product Catalog Cache Component", "Redis Engine (v6/v7)", "Caches book details and search aggregations to support sub-2-second page loads.")
    Component(Recommendation_Cache_Component, "Recommendation Cache Component", "Redis Engine (v6/v7)", "Stores pre-computed recommendation vectors for fast retrieval.")
}

Rel(Catalog_Search_Service, Product_Catalog_Cache_Component, "Retrieves book details and search aggregations", "TCP (RESP protocol)")
Rel(Order_Checkout_Service, Session_Store_Component, "Reads and writes active user carts and session data", "TCP (RESP protocol)")
Rel(Recommendation_Service, Recommendation_Cache_Component, "Fetches pre-computed recommendation vectors", "TCP (RESP protocol)")
Rel(Localization_Service, Session_Store_Component, "Accesses user localization context and session preferences", "TCP (RESP protocol)")

Rel(Session_Store_Component, AWS_Secrets_Manager, "Performs automated auth token rotation", "HTTPS")
Rel(Product_Catalog_Cache_Component, AWS_Secrets_Manager, "Performs automated auth token rotation", "HTTPS")
Rel(Recommendation_Cache_Component, AWS_Secrets_Manager, "Performs automated auth token rotation", "HTTPS")

Rel(Session_Store_Component, Amazon_CloudWatch, "Sends metric telemetry and alarm monitoring", "AWS internal APIs")
Rel(Product_Catalog_Cache_Component, Amazon_CloudWatch, "Sends metric telemetry and alarm monitoring", "AWS internal APIs")
Rel(Recommendation_Cache_Component, Amazon_CloudWatch, "Sends metric telemetry and alarm monitoring", "AWS internal APIs")

@startuml