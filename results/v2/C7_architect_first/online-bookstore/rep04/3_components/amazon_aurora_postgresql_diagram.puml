@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(order_checkout_service, "Order & Checkout Service", "External microservice")
System_Ext(catalog_search_service, "Catalog & Search Service", "External microservice")

Container_Boundary(amazon_aurora_postgresql, "Amazon Aurora PostgreSQL") {
    Component(connection_pooler, "Connection Pooler Component (PgBouncer/AWS RDS Proxy)", "PgBouncer / AWS RDS Proxy", "Manages dynamic microservice connection limits.")
    Component(catalog_schema, "Catalog & Localization Schema Component", "PostgreSQL Schema", "Stores book metadata and localization data.")
    Component(order_schema, "Order & Transaction Schema Component", "PostgreSQL Schema", "Handles ACID transactions for orders and checkout.")
    Component(storage_engine, "Aurora Global Database Storage Engine Component", "Amazon Aurora PostgreSQL Global Database", "Provides global replication, high availability, and storage.")
    Component(read_replica_routing, "Read-Replica Routing Component", "PostgreSQL Read-Replicas", "Directs read queries to local regional replicas.")
    Component(materialized_view, "Materialized View / Indexing Component", "PostgreSQL Views and Indexes", "Optimizes query performance for low-latency retrieval.")
}

Rel(order_checkout_service, order_schema, "Executes ACID transactions", "TCP/TLS via Proxy")
Rel(catalog_search_service, read_replica_routing, "Directs read queries to local regional replicas", "TCP/TLS via Proxy")
Rel(catalog_search_service, catalog_schema, "Queries book metadata", "TCP/TLS via Proxy")

@enduml