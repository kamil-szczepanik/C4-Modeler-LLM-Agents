@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(order_checkout_service, "Order & Checkout Service") {
    Component(OrderController, "Order Controller", "Spring MVC", "Exposes RESTful endpoints for cart finalization and checkout workflows.")
    Component(CheckoutOrchestrator, "Checkout Orchestrator", "Java / Spring Boot", "Manages multi-step saga patterns for payment processing and inventory reservation.")
    Component(PaymentIntegrationClient, "Payment Integration Client", "HTTPS/REST", "Communicates securely with external Payment Gateways using PCI-DSS compliant tokenization.")
    Component(ShippingFacade, "Shipping Facade", "gRPC", "Interfaces with external Third-Party Shipping APIs for rate calculations.")
    Component(PromotionDiscountEngine, "Promotion & Discount Engine", "In-memory / Java", "Validates and applies coupon codes and promotional discounts in real-time.")
    Component(IdempotencyManager, "Idempotency Manager", "Lettuce", "Prevents double-charging and duplicate order creation.")
    Component(OrderDataAccessComponent, "Order Data Access Component", "Spring Data JPA / TCP", "Persists transactional order state and audit logs.")
    Component(EventPublisher, "Event Publisher", "AWS SDK for Java", "Emits asynchronous order fulfillment events.")
    Component(OrderNotificationTrigger, "Order Notification Trigger", "gRPC / HTTPS", "Dispatches confirmation messages and digital receipts.")
    Component(AmazonElastiCache, "Amazon ElastiCache", "Redis protocol", "Stores idempotency keys.")
    Component(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL", "Spring Data JPA / TCP", "Persists transactional data.")
    Component(AmazonSQSSNS, "Amazon SQS/SNS", "AWS SDK for Java", "Publishes fulfillment events.")
    Component(NotificationService, "Notification Service", "gRPC / HTTPS", "Dispatches customer communications.")
}

Rel(OrderController, CheckoutOrchestrator, "Triggers saga execution", "Java Method Calls")
Rel(CheckoutOrchestrator, PaymentIntegrationClient, "Executes secure payment processing", "HTTPS/REST")
Rel(CheckoutOrchestrator, ShippingFacade, "Fetches shipping rates", "gRPC")
Rel(CheckoutOrchestrator, PromotionDiscountEngine, "Validates coupons", "In-memory / Java")
Rel(CheckoutOrchestrator, IdempotencyManager, "Checks request uniqueness", "Lettuce")
Rel(IdempotencyManager, AmazonElastiCache, "Stores idempotency keys", "Redis protocol")
Rel(OrderDataAccessComponent, AmazonAuroraPostgreSQL, "Persists transactional data", "Spring Data JPA / TCP")
Rel(EventPublisher, AmazonSQSSNS, "Publishes fulfillment events", "AWS SDK for Java")
Rel(OrderNotificationTrigger, NotificationService, "Dispatches customer communications", "gRPC / HTTPS")
@enduml