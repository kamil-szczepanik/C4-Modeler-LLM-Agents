@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Review Moderation Container container

Container_Boundary("Review Moderation Container", "Review Moderation Container") {
    Component(ModerationAPIController, "Moderation API Controller", "Node.js/Express, Amazon ECS on AWS Fargate", "Handles incoming review moderation API requests.")
    Component(ModerationQueueConsumer, "Moderation Queue Consumer", "Node.js/Express, Amazon ECS on AWS Fargate", "Consumes messages from the ingestion queue for asynchronous processing.")
    Component(AutoModeratorEngine, "Auto-Moderator Engine", "Node.js/Express, Amazon ECS on AWS Fargate", "Performs automated filtering and moderation of user-submitted reviews.")
    Component(ModeratorDashboardService, "Moderator Dashboard Service", "Node.js/Express, Amazon ECS on AWS Fargate", "Provides human-in-the-loop review moderation capabilities.")
    Component(ModerationDataAccessLayer, "Moderation Data Access Layer", "Node.js/Express, Amazon ECS on AWS Fargate", "Manages data persistence and retrieval for moderation workflows.")
}

Component(AmazonAPIGateway, "Amazon API Gateway", "AWS API Gateway", "External entry point routing traffic to the Moderation API Controller.")
Component(AmazonSQS, "Amazon SQS", "AWS SQS", "Message queue for asynchronous decoupling and protection against NLP processing traffic spikes.")
Component(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Relational database with AWS KMS encryption for secure review state and audit log persistence.")
Component(AmazonSNS, "Amazon SNS", "Amazon SNS", "Notification service for event broadcasting.")

Rel(AmazonAPIGateway, ModerationAPIController, "gRPC over HTTP/2 via mTLS", "gRPC over HTTP/2 via mTLS")
Rel(ModerationAPIController, AmazonSQS, "HTTPS/AWS SDK", "HTTPS/AWS SDK")
Rel(ModerationQueueConsumer, AutoModeratorEngine, "In-process", "In-process")
Rel(ModeratorDashboardService, AmazonAuroraPostgreSQL, "TCP/PostgreSQL wire protocol via TLS 1.3", "TCP/PostgreSQL wire protocol via TLS 1.3")
Rel(ReviewModerationContainer, AmazonSNS, "Amazon SNS/SQS", "Amazon SNS/SQS")

@enduml