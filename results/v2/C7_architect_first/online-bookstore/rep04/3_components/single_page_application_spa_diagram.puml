@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Single-Page Application (SPA) container

Container_Boundary(spa_container, "Single-Page Application (SPA)") {
    Component(RoutingShellComponent, "Routing & Shell Component", "React Router, React lazy, Suspense", "Handles client-side routing, code splitting, and application shell rendering.")
    Component(CatalogSearchComponent, "Catalog & Search Component", "React, local caching", "Provides catalog browsing, search capabilities, and local caching with accessibility features.")
    Component(CartCheckoutComponent, "Cart & Checkout Component", "Zustand, React Context", "Manages shopping cart state, transient UI states, and multi-currency checkouts.")
    Component(RecommendationsReviewsComponent, "Recommendations & Reviews Component", "React UI modules", "Displays product recommendations and user reviews.")
    Component(AuthProfileComponent, "Auth & Profile Component", "AWS Cognito integration", "Manages user authentication, role-based access control, and secure session tokens.")
    Component(CentralizedApiClientModule, "Centralized API Client Module", "Fetch-based with interceptors", "Handles secure HTTP communication and request/response interceptors for backend APIs.")
    Component(CloudFrontFunctionsLambdaEdge, "CloudFront Functions / Lambda@Edge", "AWS Edge Computing", "Executes edge computing tasks for content delivery and request processing.")
}

Rel(RoutingShellComponent, CatalogSearchComponent, "Renders and navigates to")
Rel(RoutingShellComponent, CartCheckoutComponent, "Renders and navigates to")
Rel(RoutingShellComponent, RecommendationsReviewsComponent, "Renders and navigates to")
Rel(RoutingShellComponent, AuthProfileComponent, "Renders and navigates to")
Rel(CartCheckoutComponent, CentralizedApiClientModule, "Sends checkout and cart requests via")
Rel(CatalogSearchComponent, CentralizedApiClientModule, "Fetches catalog data via")
Rel(AuthProfileComponent, CentralizedApiClientModule, "Authenticates sessions via")

@enduml