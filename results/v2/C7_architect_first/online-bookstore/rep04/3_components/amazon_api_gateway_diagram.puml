@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon API Gateway container

Component(SPA, "SPA", "Single-Page Application", "Client application interacting with the global API Gateway.")
Component(AmazonCognito, "Amazon Cognito", "Amazon Cognito", "External or integrated identity provider for authentication.")
Component(CatalogOrderECSContainers, "Catalog & Order ECS Containers", "ECS Containers", "Backend microservices handling catalog and order processing.")
Component(AmazonKinesis, "Amazon Kinesis", "Amazon Kinesis", "Data streaming service for async analytics ingestion.")

Container_Boundary(AmazonAPIGateway, "Amazon API Gateway") {
    Component(RoutingRegionalEdgeComponent, "Routing & Regional Edge Component", "AWS Regional API Gateway, CloudFront, AWS WAF, AWS Shield", "Manages global ingress, edge routing, and mTLS termination across AWS infrastructure.")
    Component(AuthenticationAuthorizationComponent, "Authentication & Authorization Component", "AWS Lambda Authorizer, Amazon Cognito", "Handles custom token authorization, identity management, and OIDC-compliant JWT generation.")
    Component(RateLimitingThrottlingComponent, "Rate Limiting & Throttling Component", "API Gateway Usage Plans, Token Bucket", "Enforces rate limiting and throttling policies to protect backend microservices.")
    Component(RequestResponseTransformationComponent, "Request/Response Transformation Component", "VTL, AWS Lambda mappers", "Executes request validation and payload transformations.")
    Component(APIVersioningRoutingComponent, "API Versioning & Routing Component", "Path/header-based routing engine", "Directs traffic using path or header-based routing rules to backend services.")
    Component(MonetizationUsageAnalyticsComponent, "Monetization & Usage Analytics Component", "AWS CloudWatch, Amazon Kinesis Data Firehose", "Captures sanitized monetization metrics and operational telemetry.")
}

Rel(SPA, RoutingRegionalEdgeComponent, "HTTPS / JSON")
Rel(AuthenticationAuthorizationComponent, AmazonCognito, "HTTPS / OIDC")
Rel(RoutingRegionalEdgeComponent, APIVersioningRoutingComponent, "Internal HTTP")
Rel(APIVersioningRoutingComponent, CatalogOrderECSContainers, "HTTP/2")
Rel(MonetizationUsageAnalyticsComponent, AmazonKinesis, "Async JSON")

@enduml