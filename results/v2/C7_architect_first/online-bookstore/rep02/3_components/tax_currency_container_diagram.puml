@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(tax_currency_container, "Tax & Currency Container") {
    Component(Tax_Calculation_Component, "Tax Calculation Component", "Node.js", "Calculates localized taxes and interacts with external tax APIs.")
    Component(Currency_Conversion_Component, "Currency Conversion Component", "Node.js", "Handles multi-currency conversions and interfaces with caching layers.")
}

System_Ext(External_Tax_API, "External Tax API (Avalara/TaxJar)", "External tax calculation service.")
System_Ext(Amazon_ElastiCache_Redis, "Amazon ElastiCache Redis", "In-memory data store for caching exchange rates.")

Rel(Tax_Calculation_Component, External_Tax_API, "HTTPS / REST", "TLS 1.3")
Rel(Currency_Conversion_Component, Amazon_ElastiCache_Redis, "TCP", "TLS and AWS KMS encryption")
@enduml