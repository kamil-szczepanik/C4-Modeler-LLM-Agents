@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Recommendation & Review Container container

Container_Boundary(recommendation_review_container, "Recommendation & Review Container") {
    Component(Review_API_Component, "Review API Component", "Python, FastAPI, Pydantic", "FastAPI application handling review CRUD operations, moderation flags, and verified purchase badging.")
    Component(Recommendation_Query_Component, "Recommendation Query Component", "Python, FastAPI, Pydantic", "FastAPI application serving low-latency 'Customers also bought' suggestions.")
    Component(Recommendation_Worker_Component, "Recommendation Worker Component", "Python, Background Worker", "Decoupled Python background worker processing purchase events.")
    Component(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Relational Database", "Relational database for persistent storage of reviews and purchase histories.")
    Component(Amazon_ElastiCache_Redis, "Amazon ElastiCache Redis", "Redis, Multi-AZ", "In-memory cache for fast recommendation lookups with Multi-AZ replication.")
    Component(Amazon_SQS_SNS, "Amazon SQS / SNS", "AWS SQS / SNS", "Event bus used for triggering background workers and publishing analytics.")
}

Component(API_Gateway, "API Gateway", "API Gateway", "Routes HTTP/REST requests to internal APIs.")

Rel(API_Gateway, Review_API_Component, "Routes HTTP/REST requests", "HTTPS")
Rel(API_Gateway, Recommendation_Query_Component, "Routes HTTP/REST requests", "HTTPS")
Rel(Review_API_Component, Amazon_Aurora_PostgreSQL, "Reads and writes transactional data", "TCP / PostgreSQL Wire Protocol with TLS")
Rel(Recommendation_Query_Component, Amazon_Aurora_PostgreSQL, "Reads and writes transactional data", "TCP / PostgreSQL Wire Protocol with TLS")
Rel(Recommendation_Query_Component, Amazon_ElastiCache_Redis, "Fetches cached recommendations", "Redis TCP with TLS and AUTH")
Rel(Amazon_SQS_SNS, Recommendation_Worker_Component, "Triggers asynchronous background model updates", "AWS SDK / SQS API")
Rel(Recommendation_Query_Component, Amazon_SQS_SNS, "Logs impression and click-through metrics", "AWS SDK")

@enduml