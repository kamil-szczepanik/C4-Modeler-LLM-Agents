@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Boundary(amazon_aurora_postgresql, "Amazon Aurora PostgreSQL") {
    Component(WriterInstance, "Writer Instance", "Aurora PostgreSQL engine", "Primary Aurora PostgreSQL engine handling regional write traffic.")
    Component(ReaderInstances, "Reader Instances", "Aurora PostgreSQL read replicas", "Aurora PostgreSQL read replicas scaled horizontally across availability zones.")
    Component(ClusterEndpointWriter, "Cluster Endpoint (Writer)", "DNS routing component", "DNS routing component directing write traffic.")
    Component(ReaderEndpoint, "Reader Endpoint", "Load-balanced DNS endpoint", "Load-balanced DNS endpoint for read queries.")
    Component(AmazonRDSProxy, "Amazon RDS Proxy", "Connection pooler", "Connection pooler securing and managing database connections.")
    Component(AuroraDistributedStorage, "Aurora Distributed Storage", "Asynchronously replicated global storage layer", "Asynchronously replicated global storage layer across AWS regions.")
}

Container(CoreEcommerceContainer, "Core E-Commerce Container", "Container", "Core application container")

Rel(CoreEcommerceContainer, ClusterEndpointWriter, "Transmits transactional writes", "PostgreSQL wire protocol / TLS 1.3")
Rel(CoreEcommerceContainer, ReaderEndpoint, "Transmits read queries", "PostgreSQL wire protocol / TLS 1.3")
Rel(ClusterEndpointWriter, WriterInstance, "Routes write traffic", "TCP")
Rel(ReaderEndpoint, AmazonRDSProxy, "Pools and forwards read traffic", "PostgreSQL wire protocol")
Rel(AmazonRDSProxy, ReaderInstances, "Manages query distribution", "PostgreSQL wire protocol")
Rel(WriterInstance, AuroraDistributedStorage, "Persists writes", "Storage protocol")
Rel(ReaderInstances, AuroraDistributedStorage, "Reads data", "Storage protocol")

@enduml