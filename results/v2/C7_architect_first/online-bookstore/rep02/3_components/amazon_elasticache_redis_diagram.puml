@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_elasticache_redis, "Amazon ElastiCache Redis") {
    Component(Rate_Limiter_Component, "Rate Limiter Component", "Amazon ElastiCache Redis OSS (volatile-ttl)", "Evaluates and enforces rate-limiting counters for API Gateway requests.")
    Component(Cart_Cache_Component, "Cart Cache Component", "Amazon ElastiCache Redis OSS (noeviction)", "Persists active shopping sessions and cart state for the Core E-Commerce container.")
    Component(Recommendation_Cache_Component, "Recommendation Cache Component", "Amazon ElastiCache Redis OSS (allkeys-lru)", "Reads and writes pre-computed product recommendations for the Recommendation & Review container.")
}

Rel(Rate_Limiter_Component, Cart_Cache_Component, "Segregates cache workloads to prevent cross-component memory exhaustion", "RESP over TLS 1.3")
Rel(Cart_Cache_Component, Recommendation_Cache_Component, "Maintains isolated memory spaces for independent microservices workloads", "RESP over TLS 1.3")

@enduml