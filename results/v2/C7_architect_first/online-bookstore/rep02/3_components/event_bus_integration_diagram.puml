@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Event Bus & Integration container

System_Ext(Core_E_Commerce_Container, "Core E-Commerce Container", "Microservices", "Publishes domain events.")

Container_Boundary(Event_Bus_Integration, "Event Bus & Integration") {
    Component(Event_Router, "Event Router", "AWS EventBridge", "Provides content-based asynchronous event routing across microservices.")
    Component(Notification_Queue, "Notification Queue", "Amazon SQS & DLQs", "Handles asynchronous backpressure and isolation of poisoned messages.")
    Component(Integration_Dispatcher, "Integration Dispatcher", "AWS Lambda", "Performs secure third-party webhook dispatching and PII tokenization.")
    Component(Audit_Streamer, "Audit Streamer", "Amazon Kinesis Data Firehose", "Streams order lifecycle events for high-throughput, scalable audit logging.")
    Component(Notification_Status_Tracker, "Notification Status Tracker", "Amazon DynamoDB / AWS Lambda", "Tracks notification status and integrates with storage.")
    Component(Secure_Analytics_Store, "Secure Analytics Store", "Amazon S3", "Persists immutable audit logs.")
}

Rel(Core_E_Commerce_Container, Event_Router, "Publishes domain events", "JSON over AWS SNS/EventBridge")
Rel(Event_Router, Notification_Queue, "Forwards background tasks", "AWS SQS")
Rel(Notification_Queue, Integration_Dispatcher, "Triggers asynchronous processing", "AWS Lambda Event Source Mapping")
Rel(Event_Router, Audit_Streamer, "Streams order lifecycle events", "AWS EventBridge Target / Kinesis")
Rel(Audit_Streamer, Secure_Analytics_Store, "Persists immutable audit logs", "HTTPS / AWS S3 API")

@enduml