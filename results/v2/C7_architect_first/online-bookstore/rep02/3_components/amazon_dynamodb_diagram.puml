@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_dynamodb, "Amazon DynamoDB") {
    Component(Request_Router_API_Frontend, "Request Router / API Frontend", "HTTPS / DynamoDB API", "Handles incoming requests from the Core E-Commerce Container for cart, catalog, and session data.")
    Component(Partition_Router_Storage_Nodes, "Partition Router & Storage Nodes", "TCP / Consistent Hashing", "Routes internal RPC requests and manages data partitioning across storage nodes.")
    Component(Storage_Engine, "Storage Engine", "B+-Tree & LSM-like indexing, Local PCIe/SATA", "Executes persistent B+-Tree updates and manages low-latency NoSQL datastore operations.")
    Component(Streams_Processor, "Streams Processor", "DynamoDB Streams, Internal Memory Buffers", "Triggers change data capture events and publishes item-level modification events.")
    Component(Global_Tables, "Global Tables", "Multi-region active-active replication", "Provides active-active multi-region replication across us-east-1, eu-west-1, and ap-southeast-1.")
}

Rel(Request_Router_API_Frontend, Partition_Router_Storage_Nodes, "Routes internal RPC requests", "TCP / Consistent Hashing")
Rel(Partition_Router_Storage_Nodes, Storage_Engine, "Executes persistent B+-Tree updates", "Local PCIe/SATA")
Rel(Storage_Engine, Streams_Processor, "Triggers change data capture events", "Internal Memory Buffers")
@enduml