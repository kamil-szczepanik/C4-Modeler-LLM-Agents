@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(core_ecommerce_container, "Core E-Commerce Container") {
    Component(CatalogueComponent, "Catalogue Component", "NestJS / TypeORM", "NestJS module managing product browsing and search via TypeORM.")
    Component(CartCheckoutComponent, "Cart & Checkout Component", "NestJS", "NestJS module handling ephemeral cart states and tokenized payment processing.")
    Component(OrderFulfillmentComponent, "Order Fulfillment Component", "NestJS", "Manages order state transitions and third-party logistics integration.")
    Component(CustomerNotificationComponent, "Customer Notification Component", "NestJS / AWS SES", "Handles transactional communications via AWS SES.")
}

System_Ext(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL", "Relational database for product data")
System_Ext(AmazonElastiCacheRedis, "Amazon ElastiCache Redis", "Low-latency storage for cart session management")
System_Ext(StripePayPal, "Stripe/PayPal", "Payment gateway")
System_Ext(FedExUPS, "FedEx/UPS", "Third-party logistics")
System_Ext(AmazonDynamoDB, "Amazon DynamoDB", "NoSQL database for order data")
System_Ext(AWSSES, "AWS SES", "Email service for transactional communications")
System_Ext(AmazonSQSSNS, "Amazon SQS/SNS", "Asynchronous event messaging")

Rel(CatalogueComponent, AmazonAuroraPostgreSQL, "Reads and writes product data", "PostgreSQL wire protocol")
Rel(CartCheckoutComponent, AmazonElastiCacheRedis, "Manages cart state and session management", "Redis protocol")
Rel(CartCheckoutComponent, StripePayPal, "Processes tokenized payments", "Outbound HTTPS/REST")
Rel(OrderFulfillmentComponent, FedExUPS, "Integrates with third-party logistics", "Outbound HTTPS/REST")
Rel(OrderFulfillmentComponent, AmazonDynamoDB, "Stores order data", "DynamoDB API")
Rel(CustomerNotificationComponent, AWSSES, "Sends transactional communications", "Outbound HTTPS/API")
Rel(core_ecommerce_container, AmazonSQSSNS, "Publishes asynchronous events", "AWS API")

@enduml