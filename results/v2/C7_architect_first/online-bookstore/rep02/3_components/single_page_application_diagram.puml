@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Single Page Application container

Container_Boundary("Single Page Application", "Single Page Application") {
    Component(Router Component, "Router Component", "React Router v6", "Handles client-side navigation with code-splitting for <2s page load times.")
    Component(State Management Store, "State Management Store", "Zustand", "Lightweight state management ensuring tokens are kept strictly in-memory for security.")
    Component(API Client Layer, "API Client Layer", "Axios", "HTTP client with interceptors for JWT injection and multi-currency headers.")
    Component(Feature Modules, "Feature Modules", "React.js", "Includes Catalog Browser, Checkout Flow, Review Manager, and Recommendation Widget.")
}

System_Ext(External Infrastructure, "External Infrastructure", "AWS S3, AWS CloudFront, AWS API Gateway")

Rel(Router Component, Feature Modules, "Loads Feature Modules on-demand", "In-Memory")
Rel(Feature Modules, State Management Store, "Read/write state", "In-Memory")
Rel(Feature Modules, API Client Layer, "Invoke API Client Layer", "TypeScript / HTTPS")
Rel(API Client Layer, External Infrastructure, "Sends requests to AWS API Gateway", "HTTPS")

@enduml