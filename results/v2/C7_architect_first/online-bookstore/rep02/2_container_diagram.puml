@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore

Person(GuestBuyer, "Guest Buyer", "Unauthenticated visitor browsing the catalog and adding items to the cart.")
Person(RegisteredBuyer, "Registered Buyer", "Authenticated customer purchasing books, writing reviews, and managing account details.")
Person(StoreAdministrator, "Store Administrator", "User managing store operations, catalog data, and platform settings.")
Person(ThirdPartyVendorPublisher, "Third-Party Vendor/Publisher", "External partner managing inventory, listings, and digital publications.")

System_Ext(StripePayPal, "Stripe/PayPal", "Payment Gateway handling secure financial transactions.")
System_Ext(FedExUPS, "FedEx/UPS", "Shipping Provider API handling physical book fulfillment and tracking.")
System_Ext(AWSSES, "AWS SES", "Email and Notification Service for user communications.")
System_Ext(AWSCognitoAuth0, "AWS Cognito/Auth0", "Identity Provider for user authentication and authorization.")

System_Boundary(OnlineBookstore, "Online Bookstore") {
    Container(SinglePageApplication, "Single Page Application", "React.js, AWS S3, CloudFront", "High-performance frontend delivery for <2s page load times.")
    Container(APIGateway, "API Gateway", "AWS API Gateway, AWS Cognito JWT validation", "Scalable entry point with secure JWT validation.")
    Container(CoreECommerceContainer, "Core E-Commerce Container", "Node.js / TypeScript, Amazon ECS with AWS Fargate", "Handles core e-commerce functionalities and transactions.")
    Container(RecommendationReviewContainer, "Recommendation & Review Container", "Python, FastAPI, Amazon ECS with AWS Fargate", "Handles book recommendations and user reviews.")
    Container(TaxCurrencyContainer, "Tax & Currency Container", "Node.js, Amazon ECS with AWS Fargate", "Manages multi-currency calculations and taxation.")
    ContainerDb(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Transactional relational database with global replication and geo-fencing.")
    ContainerDb(AmazonDynamoDB, "Amazon DynamoDB", "Amazon DynamoDB", "Low-latency NoSQL storage for catalog and operational data.")
    ContainerDb(AmazonElastiCacheRedis, "Amazon ElastiCache Redis", "Amazon ElastiCache Redis", "Local caching for recommendations to protect performance.")
    Container(EventBusIntegration, "Event Bus & Integration", "Amazon SQS / SNS", "Asynchronous messaging and event distribution.")
}

Rel(GuestBuyer, SinglePageApplication, "Browses catalog and interacts via web", "HTTPS / WSS")
Rel(RegisteredBuyer, SinglePageApplication, "Purchases books, manages account, and leaves reviews", "HTTPS / WSS")
Rel(StoreAdministrator, SinglePageApplication, "Manages store operations and catalog", "HTTPS / WSS")
Rel(ThirdPartyVendorPublisher, APIGateway, "Manages inventory and product listings via APIs", "HTTPS")
Rel(SinglePageApplication, APIGateway, "Sends API requests and handles authentication", "HTTPS / WSS")
Rel(APIGateway, CoreECommerceContainer, "Routes requests to core e-commerce services", "gRPC / HTTPS via Internal VPC Application Load Balancers")
Rel(APIGateway, RecommendationReviewContainer, "Routes requests for recommendations and reviews", "gRPC / HTTPS via Internal VPC Application Load Balancers")
Rel(APIGateway, TaxCurrencyContainer, "Routes requests for tax and currency calculations", "gRPC / HTTPS via Internal VPC Application Load Balancers")
Rel(CoreECommerceContainer, AmazonAuroraPostgreSQL, "Reads and writes transactional data", "PostgreSQL wire protocol")
Rel(CoreECommerceContainer, AmazonDynamoDB, "Reads and writes low-latency operational data", "DynamoDB API")
Rel(RecommendationReviewContainer, AmazonElastiCacheRedis, "Caches recommendation data", "Redis protocol")
Rel(CoreECommerceContainer, EventBusIntegration, "Publishes and consumes asynchronous events", "Amazon SQS / SNS")
Rel(APIGateway, AWSCognitoAuth0, "Validates user JWT tokens", "OIDC/OAuth2 over HTTPS/JWT")
Rel(CoreECommerceContainer, StripePayPal, "Processes secure payments", "Outbound HTTPS/REST")
Rel(CoreECommerceContainer, FedExUPS, "Coordinates physical shipping and fulfillment", "Outbound HTTPS/REST")
Rel(CoreECommerceContainer, AWSSES, "Sends transactional emails and notifications", "Outbound HTTPS/API")

@enduml