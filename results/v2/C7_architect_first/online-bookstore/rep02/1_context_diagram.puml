@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(GuestBuyer, "Guest Buyer", "Unauthenticated visitor browsing the catalog and adding items to the cart.")
Person(RegisteredBuyer, "Registered Buyer", "Authenticated customer purchasing books, writing reviews, and managing account details.")
Person(StoreAdministrator, "Store Administrator", "User managing store operations, catalog data, and platform settings.")
Person(ThirdPartyVendorPublisher, "Third-Party Vendor/Publisher", "External partner managing inventory, listings, and digital publications.")

System(OnlineBookstore, "Online Bookstore", "Global e-commerce platform handling physical and electronic books with integrated recommendations, reviews, and secure checkout.")

System_Ext(StripePayPal, "Stripe/PayPal", "Payment Gateway handling secure financial transactions.")
System_Ext(FedExUPS, "FedEx/UPS", "Shipping Provider API handling physical book fulfillment and tracking.")
System_Ext(AWSSES, "AWS SES", "Email and Notification Service for user communications.")
System_Ext(AWSCognitoAuth0, "AWS Cognito/Auth0", "Identity Provider for user authentication and authorization.")

Rel(GuestBuyer, OnlineBookstore, "Browses catalog and interacts via web/mobile", "HTTPS/TLS 1.3")
Rel(RegisteredBuyer, OnlineBookstore, "Purchases books, manages account, and leaves reviews", "HTTPS/TLS 1.3")
Rel(StoreAdministrator, OnlineBookstore, "Manages store operations and catalog", "HTTPS/TLS 1.3")
Rel(ThirdPartyVendorPublisher, OnlineBookstore, "Manages inventory and product listings", "HTTPS/TLS 1.3")
Rel(OnlineBookstore, AWSCognitoAuth0, "Authenticates users", "OIDC/OAuth2 over HTTPS/JWT")
Rel(OnlineBookstore, StripePayPal, "Processes secure payments", "Outbound HTTPS/REST with circuit breakers")
Rel(OnlineBookstore, FedExUPS, "Coordinates physical shipping and fulfillment", "Outbound HTTPS/REST with circuit breakers")
Rel(OnlineBookstore, AWSSES, "Sends transactional emails and notifications", "Outbound HTTPS/API")
@enduml