@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "End user who browses the catalog, makes purchases, leaves reviews, and receives personalized recommendations.")
Person(Admin, "Admin / Content Manager", "User responsible for managing system content, catalog, and administrative tasks.")

System(OnlineBookstoreSystem, "Online Bookstore System", "A globally distributed e-commerce platform built on AWS to serve 1 million Monthly Active Users with high availability and stringent regulatory compliance, providing catalog browsing, secure checkout, personalized recommendations, and reviews.")

System_Ext(PaymentGateway, "Payment Gateway", "External service (Stripe/PayPal) for processing secure transactions.")
System_Ext(ShippingProviderAPI, "Shipping Provider API", "External fulfillment and tracking service (FedEx/UPS).")
System_Ext(NotificationService, "Notification Service", "External service (SendGrid/AWS SES) for sending notifications.")
System_Ext(TaxCalculationService, "Tax Calculation Service", "External service (Avalara/TaxJar) for real-time tax evaluation.")
System_Ext(ThirdPartyRecommendationEngine, "Third-Party Recommendation Engine", "External recommendation engine providing product suggestions.")
System_Ext(IdentityProvider, "Identity Provider", "External service (Auth0/AWS Cognito) for authentication and MFA.")

Rel(Customer, OnlineBookstoreSystem, "Browsing and purchasing products", "HTTPS (Web/Mobile)")
Rel(OnlineBookstoreSystem, PaymentGateway, "Transaction processing", "HTTPS/REST")
Rel(OnlineBookstoreSystem, ShippingProviderAPI, "Fulfillment and tracking", "HTTPS/REST")
Rel(OnlineBookstoreSystem, TaxCalculationService, "Real-time tax evaluation", "HTTPS/REST (synchronous)")
Rel(OnlineBookstoreSystem, ThirdPartyRecommendationEngine, "Product suggestions", "HTTPS/REST with <200ms timeout")
Rel(OnlineBookstoreSystem, IdentityProvider, "Authentication and MFA", "OIDC/OAuth 2.0")

@enduml