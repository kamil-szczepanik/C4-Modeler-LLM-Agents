@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore System

Person(Customer, "Customer", "End user who browses the catalog, makes purchases, leaves reviews, and receives personalized recommendations.")
Person(AdminContentManager, "Admin / Content Manager", "User responsible for managing system content, catalog, and administrative tasks.")

System_Ext(PaymentGateway, "Payment Gateway", "External service for processing secure transactions.")
System_Ext(ShippingProviderAPI, "Shipping Provider API", "External fulfillment and tracking service.")
System_Ext(NotificationService, "Notification Service", "External service for sending notifications.")
System_Ext(TaxCalculationService, "Tax Calculation Service", "External service for real-time tax evaluation.")
System_Ext(ThirdPartyRecommendationEngine, "Third-Party Recommendation Engine", "External recommendation engine providing product suggestions.")
System_Ext(IdentityProvider, "Identity Provider", "External service for authentication and MFA.")

System_Boundary(OnlineBookstoreSystem, "Online Bookstore System") {
    Container(SinglePageApplicationSPA, "Single Page Application (SPA)", "React, Amazon CloudFront, Amazon S3", "Client-side rendering and global CDN for sub-2s page load SLA.")
    Container(AmazonAPIGateway, "Amazon API Gateway", "AWS API Gateway, JWT", "Ingress interface handling client requests with JWT validation.")
    Container(CoreECommerceAPI, "Core E-Commerce API", "Node.js, Express, Amazon ECS (Fargate)", "Microservice handling core e-commerce business logic.")
    Container(RecommendationReviewService, "Recommendation & Review Service", "Python, FastAPI, Amazon ECS (Fargate)", "Microservice handling async recommendations and reviews.")
    ContainerDb(AmazonAuroraPostgreSQLGlobalDatabase, "Amazon Aurora (PostgreSQL) Global Database", "Amazon Aurora PostgreSQL", "Transactional storage with cross-region replication for GDPR data residency.")
    ContainerDb(AmazonElastiCacheRedis, "Amazon ElastiCache (Redis)", "Amazon ElastiCache Redis", "Write-through session and catalogue caching for persistent carts and low latency.")
}

Rel(Customer, SinglePageApplicationSPA, "Browses catalog, manages cart, and places orders", "HTTPS/JSON")
Rel(AdminContentManager, SinglePageApplicationSPA, "Manages system content and catalog", "HTTPS/JSON")
Rel(SinglePageApplicationSPA, AmazonAPIGateway, "Sends client API requests", "HTTPS/JSON")
Rel(AmazonAPIGateway, CoreECommerceAPI, "Routes validated requests", "HTTPS via AWS App Mesh/ECS Service Connect")
Rel(CoreECommerceAPI, RecommendationReviewService, "Fetches recommendations and reviews", "gRPC over mTLS")
Rel(CoreECommerceAPI, AmazonAuroraPostgreSQLGlobalDatabase, "Reads and writes transactional data", "TLS 1.3 with AES-256")
Rel(CoreECommerceAPI, AmazonElastiCacheRedis, "Caches sessions and catalog data", "TLS 1.3 with AES-256")
Rel(RecommendationReviewService, AmazonAuroraPostgreSQLGlobalDatabase, "Reads and writes recommendation and review data", "TLS 1.3 with AES-256")
Rel(CoreECommerceAPI, PaymentGateway, "Processes transactions", "HTTPS/REST")
Rel(CoreECommerceAPI, ShippingProviderAPI, "Manages fulfillment and tracking", "HTTPS/REST")
Rel(CoreECommerceAPI, NotificationService, "Sends user notifications", "HTTPS/REST")
Rel(CoreECommerceAPI, TaxCalculationService, "Calculates real-time taxes", "HTTPS/REST")
Rel(RecommendationReviewService, ThirdPartyRecommendationEngine, "Fetches third-party product suggestions", "HTTPS/REST")
Rel(AmazonAPIGateway, IdentityProvider, "Validates user authentication and tokens", "OIDC/OAuth 2.0")

@enduml