@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_elasticache_redis, "Amazon ElastiCache (Redis)") {
    Component(RedisClusterEngine, "Redis Cluster Engine", "Amazon ElastiCache (Redis OSS) with Primary and Replica nodes", "Multi-AZ caching engine ensuring high availability, failover management, and sub-millisecond latency.")
    Component(SessionStoreModule, "Session Store Module", "Redis Keyspace (`sess:*`) with AWS KMS encryption", "Stores encrypted user sessions and shopping carts for sub-millisecond lookups and zero cart data loss.")
    Component(CatalogueCacheModule, "Catalogue Cache Module", "Redis Keyspace (`cat:*`) with LRU eviction", "Caches product metadata and search facets to support read-heavy catalog operations without cache thrashing.")
}

Rel(SessionStoreModule, RedisClusterEngine, "Operates on primary and replica shards with TLS 1.3 encryption and AOF persistence", "Redis RESP / TLS 1.3")
Rel(CatalogueCacheModule, RedisClusterEngine, "Utilizes LRU eviction policies and multi-AZ replication across shards", "Redis RESP / TLS 1.3")
@enduml