@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component Diagram for Amazon Aurora (PostgreSQL) Global Database

Container_Boundary(aurora_global_db, "Amazon Aurora (PostgreSQL) Global Database") {
    Component(primary_writer, "Primary Cluster Instance (Writer)", "PostgreSQL", "Handles write operations and transactional data for the core e-commerce platform.")
    Component(read_replicas, "Cross-Region Read Replica Instances", "PostgreSQL", "Handles regional read operations and personalized queries to reduce latency.")
    Component(storage_volume, "Aurora Storage Volume", "Distributed Storage", "Provides scalable, replicated storage underlying the Aurora database clusters.")
    Component(extension_manager, "PostgreSQL Extension Manager", "PostgreSQL Extension", "Manages database extensions for specialized functions and data types.")
}

Rel(primary_writer, storage_volume, "Persists transactional data", "PostgreSQL wire protocol")
Rel(read_replicas, storage_volume, "Replicates data globally", "PostgreSQL wire protocol")

@enduml