@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core E-Commerce API container

Container_Boundary(core_ecommerce_api, "Core E-Commerce API") {
    Component(Catalog_Component, "Catalog Component", "Express Router, pg query builder", "Manages book browsing and keyword search.")
    Component(Cart_Management_Component, "Cart Management Component", "In-memory session manager, Amazon ElastiCache", "Handles ephemeral shopping carts and promotional discounts.")
    Component(Order___Checkout_Component, "Order & Checkout Component", "Domain service module", "Handles secure checkout, tax calculation, payment processing, and inventory reservation.")
    Component(Fulfillment_Component, "Fulfillment Component", "Integration adapter", "Manages shipping provider APIs and tracking data.")
}

Component(Amazon_API_Gateway, "Amazon API Gateway", "AWS App Mesh, HTTPS", "Routes validated HTTP requests.")
Component(Amazon_Aurora__PostgreSQL_, "Amazon Aurora (PostgreSQL)", "TCP, SQL", "Relational database for durable transactional data.")
Component(Amazon_ElastiCache__Redis_, "Amazon ElastiCache (Redis)", "Redis RESP", "In-memory cache for sub-millisecond cart retrieval and session management.")
Component(Tax_Calculation_Service, "Tax Calculation Service", "HTTPS, REST", "External service for calculating taxes during checkout.")
Component(Payment_Gateway, "Payment Gateway", "HTTPS, REST", "External service for processing payments.")
Component(Notification_Service, "Notification Service", "HTTPS, REST", "External service for sending transaction notifications.")
Component(Shipping_Provider_API, "Shipping Provider API", "HTTPS, REST", "External shipping provider API for order fulfillment and tracking.")

Rel(Amazon_API_Gateway, core_ecommerce_api, "Routes validated HTTP requests", "HTTPS via AWS App Mesh")
Rel(Catalog_Component, Amazon_Aurora__PostgreSQL_, "Queries catalog data", "TCP/SQL")
Rel(Catalog_Component, Amazon_ElastiCache__Redis_, "Queries catalog data", "Redis RESP")
Rel(Cart_Management_Component, Amazon_ElastiCache__Redis_, "Stores session and cart states", "Redis RESP")
Rel(Order___Checkout_Component, Tax_Calculation_Service, "Communicates for tax calculation", "HTTPS/REST")
Rel(Order___Checkout_Component, Payment_Gateway, "Communicates for payment processing", "HTTPS/REST")
Rel(Order___Checkout_Component, Notification_Service, "Communicates for transaction notifications", "HTTPS/REST")
Rel(Fulfillment_Component, Shipping_Provider_API, "Manages order fulfillment and tracking", "HTTPS/REST")

@enduml