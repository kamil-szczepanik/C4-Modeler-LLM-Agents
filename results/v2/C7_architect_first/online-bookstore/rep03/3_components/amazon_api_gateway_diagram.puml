@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon API Gateway container

System_Ext(IdentityProvider, "Identity Provider", "External OIDC/OAuth 2.0 provider")
System_Ext(CoreEcommerceAPI, "Core E-Commerce API", "Backend ECS Service")

Container_Boundary(AmazonAPIGateway, "Amazon API Gateway") {
    Component(RequestValidator, "Request Validator", "Amazon API Gateway Built-in Validation / AWS WAF", "Validates incoming client requests and enforces input sanitization.")
    Component(RouterAndAuthorizer, "Router and Authorizer", "AWS Lambda / JWT (OIDC/OAuth 2.0)", "Validates user tokens and handles routing logic.")
    Component(ThrottlingAndRateLimiting, "Throttling and Rate Limiting", "Amazon API Gateway Usage Plans and Throttling", "Controls request rates to protect backend services from surges.")
    Component(TransformAndEdgeRouting, "Transform and Edge Routing", "Amazon API Gateway Mappings / AWS App Mesh", "Transforms and routes sanitized requests with currency context to backend services.")
    Component(EdgeCaching, "Edge Caching", "Amazon API Gateway Caching", "Caches responses at the edge to ensure low-latency performance.")
}

Rel(RequestValidator, RouterAndAuthorizer, "Passes validated and sanitized request")
Rel(RouterAndAuthorizer, IdentityProvider, "Validates user tokens", "OIDC/OAuth 2.0")
Rel(RouterAndAuthorizer, ThrottlingAndRateLimiting, "Checks rate limits")
Rel(ThrottlingAndRateLimiting, TransformAndEdgeRouting, "Allows throttled and authorized requests")
Rel(TransformAndEdgeRouting, EdgeCaching, "Retrieves or stores cached content")
Rel(TransformAndEdgeRouting, CoreEcommerceAPI, "Routes validated, sanitized requests with currency context", "HTTPS via AWS App Mesh/ECS Service Connect using mTLS or AWS IAM SigV4")

@enduml