@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "External customer using the e-commerce storefront")

Container_Boundary(spa_container, "Single Page Application (SPA)") {
    Component(Routing_View_Manager, "Routing & View Manager", "React Router", "Handles client-side routing and lazy-loading for performance.")
    Component(Catalog_Search_Module, "Catalog & Search Module", "React", "Delivers high-performance catalog browsing and search.")
    Component(Cart_Checkout_Module, "Cart & Checkout Module", "React", "Manages secure checkout and cart operations.")
    Component(Auth_Session_Context, "Auth & Session Context", "React Context", "Manages user authentication and session state with in-memory token handling.")
    Component(State_Management_Layer, "State Management Layer", "Zustand / React Context", "Provides lightweight state management for optimistic UI updates.")
    Component(Analytics_Tracking_Wrapper, "Analytics & Tracking Wrapper", "React", "Dispatches async tracking and analytics events.")
    Component(Amazon_S3_Amazon_CloudFront_CDN, "Amazon S3 & Amazon CloudFront (CDN)", "AWS S3, CloudFront, Lambda@Edge", "Global static asset hosting and CDN delivery with geo-based currency routing and security headers.")
    Component(Amazon_API_Gateway, "Amazon API Gateway", "AWS API Gateway", "Provides API endpoint access via HTTPS/JSON using Axios.")
}

Rel(Routing_View_Manager, Catalog_Search_Module, "In-memory routing", "In-memory")
Rel(Routing_View_Manager, Cart_Checkout_Module, "In-memory routing", "In-memory")
Rel(Cart_Checkout_Module, State_Management_Layer, "In-memory state sync", "In-memory")
Rel(Routing_View_Manager, Analytics_Tracking_Wrapper, "Async event dispatch", "Async")
Rel(Catalog_Search_Module, Analytics_Tracking_Wrapper, "Async event dispatch", "Async")
Rel(Cart_Checkout_Module, Analytics_Tracking_Wrapper, "Async event dispatch", "Async")
Rel(Auth_Session_Context, Analytics_Tracking_Wrapper, "Async event dispatch", "Async")
Rel(State_Management_Layer, Analytics_Tracking_Wrapper, "Async event dispatch", "Async")
Rel(Routing_View_Manager, Amazon_API_Gateway, "HTTPS/JSON via Axios", "HTTPS/JSON")
Rel(Catalog_Search_Module, Amazon_API_Gateway, "HTTPS/JSON via Axios", "HTTPS/JSON")
Rel(Cart_Checkout_Module, Amazon_API_Gateway, "HTTPS/JSON via Axios", "HTTPS/JSON")
Rel(Auth_Session_Context, Amazon_API_Gateway, "HTTPS/JSON via Axios", "HTTPS/JSON")
Rel(State_Management_Layer, Amazon_API_Gateway, "HTTPS/JSON via Axios", "HTTPS/JSON")
Rel(Customer, Amazon_S3_Amazon_CloudFront_CDN, "HTTPS", "HTTPS")

@enduml