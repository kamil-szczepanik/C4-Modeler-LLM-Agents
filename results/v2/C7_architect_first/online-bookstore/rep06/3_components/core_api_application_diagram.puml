@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core API Application container

Container_Boundary(core_api_application, "Core API Application") {
    Component(Catalog_Component, "Catalog Component", "TypeScript", "Handles browsing, keyword search queries, and caching interactions.")
    Component(Cart_Checkout_Component, "Cart & Checkout Component", "TypeScript", "Manages shopping carts, payment coordination, session persistence, and idempotency.")
    Component(Order_Management_Component, "Order Management Component", "TypeScript", "Orchestrates fulfillment, transactional outbox pattern, and event publishing.")
    Component(Review_Component, "Review Component", "TypeScript", "Manages customer reviews, 5-star ratings, and moderation workflows.")
}

System_Ext(Database_Cache, "Database & Cache", "Amazon Aurora PostgreSQL and Amazon ElastiCache Redis")
System_Ext(Payment_Gateway, "Payment Gateway", "Processes secure financial transactions")
System_Ext(Messaging_Integration, "Messaging & Integration", "Amazon SQS, Amazon SNS, and Amazon EventBridge")
System_Ext(Shipping_Provider_APIs, "Shipping Provider APIs", "Calculates shipping and generates labels")

Rel(Catalog_Component, Database_Cache, "Queries and caches data", "Prisma ORM over TLS / ioredis")
Rel(Cart_Checkout_Component, Database_Cache, "Persists session and cart data", "Prisma ORM / ioredis")
Rel(Cart_Checkout_Component, Payment_Gateway, "Processes secure financial transactions", "HTTPS via AWS Network Firewall")
Rel(Order_Management_Component, Database_Cache, "Executes transactions using Prisma ORM", "Prisma ORM over TLS")
Rel(Order_Management_Component, Messaging_Integration, "Publishes events for async processing", "AWS SQS/SNS/EventBridge")
Rel(Order_Management_Component, Shipping_Provider_APIs, "Calculates shipping and generates labels", "HTTPS via AWS Network Firewall")
Rel(Review_Component, Database_Cache, "Stores and retrieves reviews", "Prisma ORM over TLS")

@enduml