@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Admin Dashboard Container

Person(Administrator_Content_Manager, "Administrator / Content Manager", "Accesses the dashboard via HTTPS with mandatory MFA.")

System_Ext(Identity_Provider, "Identity Provider", "Validates JWT tokens and enforces RBAC.")
System_Ext(Core_API_Application, "Core API Application", "Performs inventory and catalogue operations.")
System_Ext(Shipping_Provider_APIs, "Shipping Provider APIs", "Monitors fulfillment and exceptions.")
System_Ext(Amazon_CloudWatch_AWS_X_Ray, "Amazon CloudWatch & AWS X-Ray", "Ships immutable audit logs, structured JSON logs, and provides distributed tracing.")

Container_Boundary(Admin_Dashboard_Container, "Admin Dashboard Container") {
    Component(Internal_Application_Load_Balancer, "Internal Application Load Balancer", "AWS ALB", "Routes secure traffic using mTLS and restricts network access via VPC peering and AWS Security Groups.")
    Component(React_Nginx_SPA_Frontend, "React/Nginx SPA Frontend", "React, Nginx", "Provides internal management interfaces for catalogue inventory, order fulfillment, and review moderation.")
    Component(Node_js_API_Backend, "Node.js API Backend", "Node.js", "Implements the unified backend logic, validates JWT tokens, enforces RBAC, and coordinates internal operations.")
}

Rel(Administrator_Content_Manager, Internal_Application_Load_Balancer, "Accesses dashboard via HTTPS with mandatory MFA", "HTTPS")
Rel(Internal_Application_Load_Balancer, React_Nginx_SPA_Frontend, "Routes secure traffic using mTLS", "mTLS")
Rel(React_Nginx_SPA_Frontend, Node_js_API_Backend, "Communicates with unified backend", "HTTP")
Rel(Node_js_API_Backend, Identity_Provider, "Validates JWT tokens and enforces RBAC", "HTTPS")
Rel(Node_js_API_Backend, Core_API_Application, "Performs inventory and catalogue operations", "gRPC over TLS")
Rel(Node_js_API_Backend, Shipping_Provider_APIs, "Monitors fulfillment and exceptions", "HTTPS")
Rel(Node_js_API_Backend, Amazon_CloudWatch_AWS_X_Ray, "Ships immutable audit logs and structured JSON logs", "HTTPS")

@enduml