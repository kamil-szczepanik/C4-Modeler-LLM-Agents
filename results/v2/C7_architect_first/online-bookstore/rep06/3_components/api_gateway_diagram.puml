@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Request Router / Reverse Proxy, "Request Router / Reverse Proxy", "AWS API Gateway", "Dispatches incoming traffic securely to backend core containers and microservices.")
    Component(Authentication & Authorization Filter, "Authentication & Authorization Filter", "AWS API Gateway, AWS WAF", "Handles security checks, token validation, and scope enforcement.")
    Component(Rate Limiting & Throttling Controller, "Rate Limiting & Throttling Controller", "AWS API Gateway, Amazon ElastiCache Redis", "Controls traffic rates and protects backend services from being overwhelmed.")
    Component(Request/Response Transformation Engine, "Request/Response Transformation Engine", "AWS API Gateway", "Transforms payloads and headers between clients and backend microservices.")
}

Rel(Request Router / Reverse Proxy, Authentication & Authorization Filter, "Passes requests for security validation")
Rel(Authentication & Authorization Filter, Rate Limiting & Throttling Controller, "Enforces rate limits for authenticated requests")
Rel(Rate Limiting & Throttling Controller, Request/Response Transformation Engine, "Forwards validated and throttled requests for payload transformation")

@enduml