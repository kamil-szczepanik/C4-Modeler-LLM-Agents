@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Messaging & Integration container

Container_Boundary("messaging_and_integration", "Messaging & Integration") {
    Component(Event_Router, "Event Router", "Amazon EventBridge", "Serverless event bus that routes domain events and provides schema validation.")
    Component(Notification_Dispatcher_Queue, "Notification Dispatcher Queue", "Amazon SQS", "Standard queue for forwarding notification events.")
    Component(Shipping_Fulfillment_Topic, "Shipping Fulfillment Topic", "Amazon SNS", "Pub/sub topic for forwarding checkout events.")
    Component(Dead_Letter_Queue_Handlers, "Dead Letter Queue Handlers", "Amazon SQS DLQ", "Paired DLQs that route failed messages after max retries.")
    Component(Schema_Registry, "Schema Registry", "AWS Glue Schema Registry", "Enforces strict payload validation and secrets redaction.")
    Component(State_Store, "State Store", "Amazon ElastiCache Redis", "Manages deduplication and idempotency tracking.")
}

System(Core_API_Application, "Core API Application", "External caller to the messaging container.")

Rel(Core_API_Application, Event_Router, "Publishes domain events", "HTTPS / AWS SDK")
Rel(Event_Router, Notification_Dispatcher_Queue, "Forwards notification events", "AWS SQS integration")
Rel(Event_Router, Shipping_Fulfillment_Topic, "Forwards checkout events", "AWS SNS integration")
Rel(Event_Router, Dead_Letter_Queue_Handlers, "Routes failed messages after max retries", "AWS SQS")
Rel(Dead_Letter_Queue_Handlers, Event_Router, "Publishes OrderProcessingFailed event", "AWS SDK")

@enduml