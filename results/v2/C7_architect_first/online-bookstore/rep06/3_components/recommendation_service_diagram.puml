@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "External API Gateway")
System_Ext(amazon_s3, "Amazon S3", "Manages artifact storage with least-privilege IAM roles.")
System_Ext(amazon_elasticache_redis, "Amazon ElastiCache Redis", "Provides caching infrastructure using the Redis Protocol.")
System_Ext(amazon_sqs, "Amazon SQS", "Manages asynchronous event queues.")
System_Ext(downstream_analytics_stores, "Downstream Analytics Stores", "External analytics storage.")

Container_Boundary(recommendation_service, "Recommendation Service") {
    Component(recommendation_api_router, "Recommendation API Router", "FastAPI, Python", "High-performance REST routing and strict input schema validation.")
    Component(recommendation_engine_core, "Recommendation Engine Core", "SciPy, NumPy, Python", "Provides mathematical operations for collaborative filtering and ranking logic.")
    Component(ml_model_client, "ML Model Client", "boto3, gRPC, Python", "Handles communication with ML models and Amazon S3.")
    Component(cache_persistence_repository, "Cache & Persistence Repository", "redis-py client, Python", "Delivers low-latency retrieval and persistence of pre-computed recommendation lists.")
    Component(event_consumer, "Event Consumer", "boto3 worker, Python", "Manages asynchronous event processing from Amazon SQS.")
    Component(business_analytics_logging_component, "Business Analytics Logging Component", "Python", "Handles business analytics logging via asynchronous events.")
    Component(amazon_ecs_fargate, "Amazon ECS Fargate", "Amazon ECS Fargate", "Serverless container execution ensuring scalable, zero-downtime rolling updates.")
}

Rel(api_gateway, recommendation_api_router, "mTLS/IAM", "HTTP/REST")
Rel(ml_model_client, amazon_s3, "IAM Task Roles", "HTTPS/gRPC")
Rel(cache_persistence_repository, amazon_elasticache_redis, "Redis Protocol", "Redis Protocol")
Rel(event_consumer, amazon_sqs, "AMQP/SQS", "AMQP/SQS")
Rel(business_analytics_logging_component, downstream_analytics_stores, "Asynchronous Events", "HTTP/Queue")

@enduml