@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Single Page Application container

System_Ext(api_gateway, "API Gateway", "API Gateway for backend services.")

Container_Boundary(spa_boundary, "Single Page Application") {
    Component(Router_Component, "Router Component", "React Router, React Suspense, React.lazy()", "Manages client-side navigation, code-splitting, and dynamic feature bundle loading.")
    Component(State_Management_Store, "State Management Store", "Redux Toolkit, Zustand", "Manages global state, multi-currency preferences (USD, EUR, GBP), and GDPR/CCPA consent.")
    Component(API_Client_Layer, "API Client Layer", "Axios, Apollo Client", "Handles secure communication with the API Gateway via HTTPS/REST/GraphQL with token injection and telemetry.")
    Component(UI_Component_Library, "UI Component Library", "Tailwind CSS, Atomic Design", "Renders feature views using atomic design elements with localization banners and automatic XSS output encoding.")
    Component(Code_Splitting_Lazy_Loading_Manager, "Code-Splitting & Lazy Loading Manager", "React Suspense, React.lazy()", "Dynamically loads feature bundles on demand.")
    Component(Local_Caching_Middleware, "Local Caching Middleware", "IndexedDB wrapper, Web Crypto API", "Handles offline cart persistence and encrypted local metadata caching using Web Crypto API encryption.")
}

Rel(Router_Component, UI_Component_Library, "Renders feature views using atomic design elements.")
Rel(Router_Component, Code_Splitting_Lazy_Loading_Manager, "Dynamically loads feature bundles on demand.")
Rel(State_Management_Store, Local_Caching_Middleware, "Persists cart and metadata locally using Web Crypto API encryption.")
Rel(API_Client_Layer, api_gateway, "Communicates via HTTPS/REST/GraphQL with token injection and telemetry.", "HTTPS/REST/GraphQL")

@enduml