@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database & Cache container

Container_Boundary(database_cache, "Database & Cache") {
    Component(Connection Pooling Component, "Connection Pooling Component", "Amazon RDS Proxy / PgBouncer sidecar", "Manages connection limits from auto-scaling ECS Fargate tasks and executes transactional queries.")
    Component(Primary Relational Datastore, "Primary Relational Datastore", "Amazon Aurora PostgreSQL Multi-AZ", "Handles ACID-compliant transactional data, multi-currency decimal precision, and automated cross-region replication.")
    Component(Read Replica Cluster, "Read Replica Cluster", "Amazon Aurora PostgreSQL Read Replicas", "Provides scaled read operations to ensure sub-second response times under heavy traffic.")
    Component(Distributed Cache Layer, "Distributed Cache Layer", "Amazon ElastiCache for Redis", "Provides low-latency session persistence and cache-aside catalogue performance.")
}

Rel(Connection Pooling Component, Primary Relational Datastore, "Executes transactional queries on port 5432 using pgJDBC over TLS", "pgJDBC / TLS")

@enduml