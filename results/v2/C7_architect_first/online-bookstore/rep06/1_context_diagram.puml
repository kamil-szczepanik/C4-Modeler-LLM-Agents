@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "Global user browsing, purchasing physical and electronic books, and writing reviews.")
Person(Admin_Content_Manager, "Administrator / Content Manager", "System user managing catalogue, content, and system administration.")

System(Online_Bookstore_System, "Online Bookstore System", "An Amazon-style e-commerce web platform enabling global users to purchase physical and electronic books with integrated reviews and recommendations, built for high availability across three AWS regions.")

System_Ext(Payment_Gateway, "Payment Gateway", "External provider like Stripe/PayPal for secure transactions and tokenization.")
System_Ext(Shipping_Provider_APIs, "Shipping Provider APIs", "External services for rate calculation and label generation.")
System_Ext(Identity_Provider, "Identity Provider", "AWS Cognito/Auth0 for authentication and MFA.")
System_Ext(Recommendation_ML_Service, "Recommendation ML Service", "Machine learning service for item affinity scoring.")
System_Ext(Notification_Service, "Notification Service", "Amazon SES/SendGrid for asynchronous transactional alerts.")

Rel(Customer, Online_Bookstore_System, "Browses, purchases, and writes reviews via web/mobile", "HTTPS")
Rel(Admin_Content_Manager, Online_Bookstore_System, "Manages catalogue and system administration", "HTTPS")
Rel(Online_Bookstore_System, Payment_Gateway, "Processes secure transactions and tokenization", "REST/HTTPS")
Rel(Online_Bookstore_System, Shipping_Provider_APIs, "Requests rate calculation and label generation asynchronously", "REST/HTTPS")
Rel(Online_Bookstore_System, Identity_Provider, "Authenticates users and handles MFA", "OAuth2/OIDC via HTTPS")
Rel(Online_Bookstore_System, Recommendation_ML_Service, "Fetches item affinity scoring", "REST/gRPC via HTTPS")
Rel(Online_Bookstore_System, Notification_Service, "Dispatches asynchronous transactional alerts", "REST/SMTP")

@enduml