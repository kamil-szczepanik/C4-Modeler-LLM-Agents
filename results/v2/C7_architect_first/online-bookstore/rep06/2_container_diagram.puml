@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore System

Person(Customer, "Customer", "Global user browsing, purchasing physical and electronic books, and writing reviews.")
Person(Admin, "Administrator / Content Manager", "System user managing catalogue, content, and system administration.")

System_Ext(PaymentGateway, "Payment Gateway", "External provider like Stripe/PayPal for secure transactions and tokenization.")
System_Ext(ShippingAPIs, "Shipping Provider APIs", "External services for rate calculation and label generation.")

System_Boundary(OnlineBookstore, "Online Bookstore System") {
    Container(SPA, "Single Page Application", "React, TypeScript, Amazon S3, Amazon CloudFront", "Frontend interface for users to browse, purchase, review, and receive book recommendations securely.")
    Container(ApiGateway, "API Gateway", "AWS API Gateway", "Routes and manages incoming traffic from the Single Page Application to internal services.")
    Container(CoreApi, "Core API Application", "Node.js, Express, Amazon ECS Fargate", "Handles core e-commerce business logic, routing, and event publishing.")
    Container(RecommendationService, "Recommendation Service", "Python, FastAPI, Amazon ECS Fargate", "Provides book recommendations based on user activity.")
    Container(AdminDashboard, "Admin Dashboard Container", "Amazon ECS Fargate", "Provides administrative interfaces for managing catalogue, content, and system administration.")
    ContainerDb(DatabaseCache, "Database & Cache", "Amazon Aurora PostgreSQL, Amazon ElastiCache Redis", "Stores transactional data, user information, and handles cache-aside patterns.")
    Container(Messaging, "Messaging & Integration", "Amazon SQS, Amazon SNS, Amazon EventBridge", "Handles asynchronous decoupling for shipping, notification, and analytics processing.")
}

Rel(Customer, SPA, "Accesses SPA via static asset delivery and CloudFront", "HTTPS")
Rel(Admin, AdminDashboard, "Manages catalogue, content, and system administration", "HTTPS")
Rel(SPA, ApiGateway, "Communicates with API Gateway", "HTTPS/REST/GraphQL")
Rel(ApiGateway, CoreApi, "Routes traffic to Core API", "mTLS / AWS Service Connect")
Rel(ApiGateway, RecommendationService, "Routes traffic to Recommendation Service", "mTLS / AWS Service Connect")
Rel(ApiGateway, AdminDashboard, "Routes traffic to Admin Dashboard", "mTLS / AWS Service Connect")
Rel(CoreApi, DatabaseCache, "Interacts with Aurora PostgreSQL and ElastiCache Redis", "JDBC/TLS and RESP")
Rel(CoreApi, Messaging, "Publishes events for async shipping, notification, and analytics processing", "AWS SQS/SNS/EventBridge")
Rel(CoreApi, PaymentGateway, "Egresses securely for payment processing", "HTTPS via AWS Network Firewall")
Rel(CoreApi, ShippingAPIs, "Egresses securely for shipping calculations and labels", "HTTPS via AWS Network Firewall")

@enduml