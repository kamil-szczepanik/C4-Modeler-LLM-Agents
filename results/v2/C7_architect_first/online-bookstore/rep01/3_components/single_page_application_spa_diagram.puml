@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(API_Gateway, "API Gateway", "AWS API Gateway with WAF")

Container_Boundary(spa_boundary, "Single Page Application (SPA)") {
    Component(Routing_View_Manager, "Routing & View Manager", "React Router", "Manages responsive navigation and dynamically loads views via lazy loading.")
    Component(State_Management_Store, "State Management Store", "Redux Toolkit / Zustand", "Handles resilient client-side state handling.")
    Component(API_Client, "API Client", "Axios / Fetch with Performance Monitoring Interceptor", "Transmits telemetry and fetches catalog/checkout data from the API Gateway.")
    Component(UI_Component_Library, "UI Component Library", "Tailwind CSS / Shadcn UI", "Provides the visual UI components for the customer interface.")
}

Rel(Routing_View_Manager, UI_Component_Library, "Dynamically loads views via lazy loading", "")
Rel(API_Client, API_Gateway, "Transmits telemetry and fetches catalog/checkout data", "HTTPS / REST / JSON")

@enduml