@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container(spa, "Single Page Application (SPA)", "React / TypeScript", "Client application")
System_Ext(catalog_service, "Catalog Service", "Microservice")
System_Ext(order_service, "Order Management & Payment Integration Containers", "Microservice")
System_Ext(recommendation_service, "Recommendation Service", "Microservice")

Container_Boundary(api_gateway, "API Gateway") {
    Component(auth_filter, "Authentication & Authorization Filter", "AWS API Gateway / AWS WAF", "Sends API requests and handles authentication and authorization.")
    Component(rbac_component, "Scope & RBAC Enforcement Component", "AWS API Gateway", "Passes validated identity claims and enforces scope and RBAC.")
    Component(transform_component, "Request Transformation & Localization Component", "AWS API Gateway", "Forwards authorized requests and injects locale/currency.")
    Component(routing_component, "Routing & Rate Limiting Component", "AWS API Gateway", "Routes traffic to backend services and handles rate limiting.")
    Component(telemetry_component, "Edge Observability & Telemetry Component", "AWS X-Ray / AWS CloudWatch", "Offloads request metrics and logs from edge routing.")
}

Rel(spa, auth_filter, "Sends API requests", "HTTPS / REST / JSON")
Rel(auth_filter, rbac_component, "Passes validated identity claims", "Internal")
Rel(rbac_component, transform_component, "Forwards authorized requests", "Internal")
Rel(transform_component, routing_component, "Injects locale/currency and forwards requests", "Internal")
Rel(routing_component, telemetry_component, "Offloads request metrics and logs", "Internal")
Rel(routing_component, catalog_service, "Routes traffic", "HTTPS / mTLS via AWS App Mesh")
Rel(routing_component, order_service, "Routes traffic", "HTTPS / mTLS via AWS App Mesh")
Rel(routing_component, recommendation_service, "Routes traffic", "HTTPS / mTLS via AWS App Mesh")

@enduml