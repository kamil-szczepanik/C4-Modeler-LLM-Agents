@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(API_Gateway, "API Gateway", "AWS", "Routes catalog queries via HTTPS / mTLS.")

System_Boundary(catalog_service, "Catalog Service") {
    Component(CatalogController, "CatalogController", "Node.js / Express", "Manages book discovery, browsing, and search endpoints.")
    Component(AdminCatalogController, "AdminCatalogController", "Node.js / Express", "Handles administrative catalog operations and metadata management.")
    Component(SearchService, "SearchService", "Node.js", "Processes search and filtering logic using Amazon OpenSearch.")
    Component(PricingService, "PricingService", "Node.js", "Calculates multi-currency pricing and utilizes Redis cache for exchange rates.")
    Component(CatalogRepository, "CatalogRepository", "Node.js / TypeORM", "Persists and retrieves structured book metadata from Amazon RDS PostgreSQL.")
}

ComponentDb(Amazon_RDS_PostgreSQL, "Amazon RDS (PostgreSQL)", "Amazon RDS", "Stores authoritative book metadata and multi-currency pricing.")
Component(Amazon_OpenSearch, "Amazon OpenSearch", "Amazon OpenSearch", "Delivers high-performance keyword search and filtering.")
ComponentDb(Amazon_ElastiCache_Redis, "Amazon ElastiCache (Redis)", "Amazon ElastiCache (Redis)", "Caches exchange rates and hot queries for low latency.")

Rel(API_Gateway, CatalogController, "Routes catalog queries", "HTTPS / mTLS via AWS App Mesh")
Rel(CatalogController, SearchService, "In-memory function calls", "TypeScript")
Rel(SearchService, Amazon_OpenSearch, "Queries catalog index", "HTTPS")
Rel(CatalogController, PricingService, "In-memory calculation", "TypeScript")
Rel(CatalogController, CatalogRepository, "In-memory function calls", "TypeScript")
Rel(AdminCatalogController, CatalogRepository, "In-memory persistence calls", "TypeScript")
Rel(CatalogRepository, Amazon_RDS_PostgreSQL, "Reads/Writes structured data", "TCP / SQL via TLS")
Rel(PricingService, Amazon_ElastiCache_Redis, "Caches exchange rates and hot queries", "TCP via TLS")

@enduml