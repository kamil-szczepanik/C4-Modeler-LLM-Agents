@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(order_management_payment_integration_containers, "Order Management & Payment Integration Containers") {
    Component(Order_Controller, "Order Controller", "Spring Boot REST Controller", "Handles incoming HTTP requests from the API Gateway for checkout and payment processing.")
    Component(Payment_Service, "Payment Service", "Spring Boot Service with Circuit Breakers", "Communicates with the external Payment Gateway to process secure transactions.")
    Component(Shipping_Integration_Service, "Shipping Integration Service", "Spring Boot Service with Circuit Breakers", "Interfaces with external Shipping Provider APIs to generate labels and fulfillment details.")
    Component(Notification_Publisher, "Notification Publisher", "Spring Boot AWS SQS/SNS Client", "Asynchronously dispatches order confirmation messages to the AWS SNS/SQS messaging infrastructure.")
}

Rel(Order_Controller, Payment_Service, "Processes transactions", "HTTPS with Circuit Breakers")
Rel(Order_Controller, Shipping_Integration_Service, "Generates shipping labels", "HTTPS with Circuit Breakers")
Rel(Order_Controller, Notification_Publisher, "Triggers asynchronous confirmations", "AWS SNS / SQS")
@enduml