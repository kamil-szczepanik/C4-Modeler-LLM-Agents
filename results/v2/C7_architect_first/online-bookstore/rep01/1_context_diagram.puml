@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "End user who browses catalogues, purchases books, leaves 5-star reviews, and receives recommendations.")
Person(Admin_Support_Staff, "Admin / Support Staff", "Internal staff member who manages the catalogue, handles orders, and resolves disputes.")
Person(Authors_Publishers, "Authors / Publishers", "External partners who access sales analytics and royalty reports.")

System(Online_Bookstore_System, "Online Bookstore System", "An Amazon-style online bookstore providing catalogue browsing, secure checkout, 5-star reviews, and book recommendations, handling 1M monthly active users globally with GDPR and CCPA compliance.")

System_Ext(Payment_Gateway, "Payment Gateway", "External financial system used to process secure transactions.")
System_Ext(Shipping_Provider_API, "Shipping Provider API", "External logistics system used to generate shipping labels asynchronously.")
System_Ext(Email_Notification_Service, "Email / Notification Service", "External communication service used to send transactional emails.")

Rel(Customer, Online_Bookstore_System, "Browses, purchases, reviews, and receives recommendations", "HTTPS (TLS 1.3)")
Rel(Admin_Support_Staff, Online_Bookstore_System, "Manages catalogue, orders, and disputes", "HTTPS with MFA")
Rel(Authors_Publishers, Online_Bookstore_System, "Accesses sales analytics and royalty reports", "HTTPS")
Rel(Online_Bookstore_System, Payment_Gateway, "Processes secure transactions", "REST/TLS")
Rel(Online_Bookstore_System, Shipping_Provider_API, "Generates shipping labels asynchronously", "REST/JSON")
Rel(Online_Bookstore_System, Email_Notification_Service, "Sends transactional emails asynchronously", "Managed Message Queues")

@enduml