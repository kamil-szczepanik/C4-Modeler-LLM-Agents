@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore System

Person(Customer, "Customer", "End user who browses catalogues, purchases books, leaves 5-star reviews, and receives recommendations.")
Person(Admin_Support_Staff, "Admin / Support Staff", "Internal staff member who manages the catalogue, handles orders, and resolves disputes.")
Person(Authors_Publishers, "Authors / Publishers", "External partners who access sales analytics and royalty reports.")

System_Ext(Payment_Gateway, "Payment Gateway", "External financial system used to process secure transactions.")
System_Ext(Shipping_Provider_API, "Shipping Provider API", "External logistics system used to generate shipping labels asynchronously.")
System_Ext(Email_Notification_Service, "Email / Notification Service", "External communication service used to send transactional emails.")

System_Boundary(Online_Bookstore_System, "Online Bookstore System") {
    Container(Single_Page_Application_SPA, "Single Page Application (SPA)", "React and TypeScript, AWS S3 & CloudFront", "Responsive client-side rendering for the online bookstore interface.")
    Container(API_Gateway, "API Gateway", "AWS API Gateway with WAF and JWT validation", "Entry point for client requests, providing security, WAF protection, and token validation.")
    Container(Catalog_Service, "Catalog Service", "Node.js (Express), Amazon RDS (PostgreSQL)", "Manages book catalogs, browsing, and relational data.")
    Container(Order_Management_Payment_Integration_Containers, "Order Management & Payment Integration Containers", "Spring Boot (Java), AWS SQS", "Handles order processing, payment workflows, and decouples via AWS SQS to prevent cascading failures.")
    Container(Recommendation_Service, "Recommendation Service", "Python (FastAPI), Amazon DynamoDB", "Generates and serves book recommendations based on user interactions.")
}

Rel(Customer, Single_Page_Application_SPA, "Accesses bookstore frontend", "HTTPS")
Rel(Admin_Support_Staff, Single_Page_Application_SPA, "Manages store operations", "HTTPS")
Rel(Authors_Publishers, Single_Page_Application_SPA, "Accesses reports and analytics", "HTTPS")
Rel(Single_Page_Application_SPA, API_Gateway, "Sends API requests", "HTTPS / REST / JSON")
Rel(API_Gateway, Catalog_Service, "Routes catalog queries", "HTTPS / mTLS via AWS App Mesh")
Rel(API_Gateway, Order_Management_Payment_Integration_Containers, "Routes order and payment actions", "HTTPS / mTLS via AWS App Mesh")
Rel(API_Gateway, Recommendation_Service, "Routes recommendation queries", "HTTPS / mTLS via AWS App Mesh")
Rel(Order_Management_Payment_Integration_Containers, Payment_Gateway, "Processes payments", "HTTPS with Circuit Breakers")
Rel(Order_Management_Payment_Integration_Containers, Shipping_Provider_API, "Generates shipping labels", "HTTPS with Circuit Breakers")
Rel(Order_Management_Payment_Integration_Containers, Email_Notification_Service, "Triggers notifications asynchronously", "AWS SNS / SQS")

@enduml