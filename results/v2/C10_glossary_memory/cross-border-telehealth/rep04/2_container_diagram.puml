@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "EU & US patients seeking video consultations, e-prescriptions, and AI symptom checks.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Medical professionals providing video consultations and issuing e-prescriptions.")

System_Ext(Pharmacies, "Pharmacies", "EU/US pharmacies fulfilling prescriptions.")
System_Ext(External_Pharmacies, "External Pharmacies", "EU national gateways and US pharmacy networks.")
System_Ext(Regional_Identity___Consent_Providers, "Regional Identity & Consent Providers", "eIDAS/EU login and US IAM managing identity and consent.")
System_Ext(AI_Model_Providers___Medical_Devices, "AI Model Providers / Medical Devices", "External AI inference APIs powering the AI symptom checker.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(Patient_Web_Mobile_App, "Patient Web/Mobile App", "Flutter / React Native", "Powers the Patient Web/Mobile App with local state caching for unstable connections.")
    Container(Clinician_Portal, "Clinician Portal", "React SPA", "Powers the Clinician Portal.")
    Container(API_Gateway___Routing_Service, "API Gateway & Routing Service", "Envoy Proxy / Istio", "Manages API gateway routing, Istio service mesh mTLS, and Canary deployments.")
    Container(Core_Telehealth_Service, "Core Telehealth Service", "Node.js / Go", "Powers the Core Telehealth Service handling consultations and consent.")
    Container(E_Prescription_Interoperability_Service, "E-Prescription Interoperability Service", "Spring Boot / Apache Camel", "Powers the E-Prescription Interoperability Service translating HL7 FHIR and national EU standards.")
    Container(AI_Symptom_Checker_Service, "AI Symptom Checker Service", "Python / FastAPI", "Powers the AI Symptom Checker Service with local PII/PHI masking.")
    ContainerDb(Database_Cluster, "Database Cluster", "Cloud Spanner / PostgreSQL", "Regional data stores secured with Google Cloud KMS CMEK.")
}

Rel(Patients, Patient_Web_Mobile_App, "Accesses video consultations, e-prescriptions, and AI symptom checker", "HTTPS / WebSockets (adaptive codec)")
Rel(Licensed_Clinicians, Clinician_Portal, "Manages patient consultations and issues e-prescriptions", "HTTPS")
Rel(Patient_Web_Mobile_App, API_Gateway___Routing_Service, "Sends client requests through gateway", "HTTPS / WebSockets")
Rel(Clinician_Portal, API_Gateway___Routing_Service, "Sends clinician requests through gateway", "HTTPS")
Rel(API_Gateway___Routing_Service, Core_Telehealth_Service, "Routes consultation and consent requests", "gRPC / mTLS")
Rel(API_Gateway___Routing_Service, E_Prescription_Interoperability_Service, "Routes e-prescription requests", "gRPC / mTLS")
Rel(API_Gateway___Routing_Service, AI_Symptom_Checker_Service, "Routes symptom check requests", "gRPC / mTLS")
Rel(Core_Telehealth_Service, Database_Cluster, "Reads and writes telehealth and consent data", "TCP / CMEK")
Rel(E_Prescription_Interoperability_Service, External_Pharmacies, "Sends e-prescriptions and fulfillment requests", "TLS / Mutual TLS")
Rel(AI_Symptom_Checker_Service, AI_Model_Providers___Medical_Devices, "Sends masked payloads for AI inference", "HTTPS (REST/gRPC with payload masking)")
Rel(Core_Telehealth_Service, Regional_Identity___Consent_Providers, "Authenticates users and validates consent", "OAuth2 / OpenID Connect")

@enduml