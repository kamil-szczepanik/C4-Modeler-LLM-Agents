@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "EU & US patients seeking video consultations, e-prescriptions, and AI symptom checks.")
Person("Licensed Clinicians", "Licensed Clinicians", "Medical professionals providing video consultations and issuing e-prescriptions.")
System("Cross-Border Telehealth Platform", "Cross-Border Telehealth Platform", "A cross-border telehealth platform delivering video consultations, e-prescriptions, and an AI symptom checker for EU and US patients with strict regional data residency and compliance using GCP.")
System_Ext(Pharmacies, "Pharmacies", "EU/US pharmacies fulfilling prescriptions.")
System_Ext("External Pharmacies", "External Pharmacies", "EU national gateways and US pharmacy networks.")
System_Ext("Regional Identity & Consent Providers", "Regional Identity & Consent Providers", "eIDAS/EU login and US IAM managing identity and consent.")
System_Ext("AI Model Providers / Medical Devices", "AI Model Providers / Medical Devices", "External AI inference APIs powering the AI symptom checker.")

Rel(Patients, "Cross-Border Telehealth Platform", "Uses platform for consultations and symptom checking", "HTTPS / WebSockets (adaptive codec)")
Rel("Licensed Clinicians", "Cross-Border Telehealth Platform", "Conducts consultations and manages e-prescriptions", "HTTPS")
Rel("Cross-Border Telehealth Platform", "External Pharmacies", "Sends e-prescriptions and fulfillment requests", "TLS / Mutual TLS")
Rel("Cross-Border Telehealth Platform", "AI Model Providers / Medical Devices", "Sends masked payloads for AI inference", "HTTPS (REST/gRPC with payload masking)")
Rel("Cross-Border Telehealth Platform", "Regional Identity & Consent Providers", "Authenticates users and validates consent", "OAuth2 / OpenID Connect")
@enduml