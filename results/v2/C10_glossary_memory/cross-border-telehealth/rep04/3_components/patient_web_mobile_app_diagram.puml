@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient Web/Mobile App container

System_Ext(api_gateway, "API Gateway & Routing Service", "Envoy Proxy / Istio", "Routes external requests to appropriate backend services.")

Container_Boundary(patient_app, "Patient Web/Mobile App") {
    Component(local_storage, "Local Secure Storage Component", "SQLite / Encrypted Shared Preferences", "Provides local secure storage for offline-first resilience and encrypted local caching.")
    Component(consent_ui, "Consent Management UI Component", "Flutter / React Native", "Manages user consent and interacts with local storage for GDPR and HIPAA compliance.")
    Component(symptom_checker, "Symptom Checker Client Component", "Flutter / React Native", "Provides the client-side interface for the AI symptom checker with client-side telemetry and strict PII/PHI redaction.")
    Component(video_consultation, "Video Consultation Client Component", "WebRTC with adaptive codecs", "Delivers secure video consultations optimized for low-bandwidth connections.")
}

Rel(local_storage, api_gateway, "HTTPS (REST) / mTLS", "")
Rel(consent_ui, local_storage, "Local Encrypted Write / Read", "")
Rel(video_consultation, api_gateway, "WebSockets / HTTPS", "")

@enduml