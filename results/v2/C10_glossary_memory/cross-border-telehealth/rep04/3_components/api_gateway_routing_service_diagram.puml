@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_routing_service, "API Gateway & Routing Service") {
    Component(Envoy Edge Proxy, "Envoy Edge Proxy", "Envoy Proxy", "Manages regional API gateway routing, ingress traffic, and geo-routing policies.")
    Component(Istio Service Mesh Sidecar, "Istio Service Mesh Sidecar", "Istio", "Handles mTLS security, service-to-service encryption, and Canary deployments.")
    Component(Rate Limiter & Consent Router, "Rate Limiter & Consent Router", "Node.js / Envoy Extension", "Enforces regional rate-limiting and verifies consent states before routing requests.")
}

Rel(Envoy Edge Proxy, Istio Service Mesh Sidecar, "Routes filtered traffic", "gRPC / mTLS")
Rel(Rate Limiter & Consent Router, Envoy Edge Proxy, "Controls request flow and validation", "")

@enduml