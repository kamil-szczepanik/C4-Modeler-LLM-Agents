@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the E-Prescription Interoperability Service container

System_Ext(api_gateway, "API Gateway & Routing Service", "External API gateway routing incoming requests.")

Container_Boundary(e_prescription_interoperability_service, "E-Prescription Interoperability Service") {
    Component(security_and_token_validation_component, "Security & Token Validation Component", "Spring Security / OAuth2", "Handles security checks and token validation for incoming requests.")
    Component(prescription_router_component, "Prescription Router Component", "Apache Camel EIP", "Routes e-prescription messages using Enterprise Integration Patterns.")
    Component(hl7_fhir_translator_component, "HL7 FHIR Translator Component", "Java / HAPI FHIR", "Implements HL7 FHIR standard translations for US prescription compliance.")
    Component(eu_national_gateway_adapter_component, "EU National Gateway Adapter Component", "Apache Camel / Spring Integration", "Adapts and communicates with EU national gateways for cross-border prescription delivery.")
    Component(prescription_audit_and_status_service_component, "Prescription Audit & Status Service Component", "Spring Boot / Data JPA", "Tracks prescription audit trails and operational status.")
    Component(dead_letter_queue_dlq_and_retry_handler_component, "Dead-Letter Queue (DLQ) & Retry Handler Component", "Google Cloud Pub/Sub", "Manages resilient asynchronous dead-letter queues and message retries.")
}

System_Ext(external_pharmacies, "External Pharmacies", "EU national gateways and US pharmacy networks")

Rel(api_gateway, security_and_token_validation_component, "gRPC / mTLS")
Rel(security_and_token_validation_component, prescription_router_component, "Direct / In-memory")
Rel(prescription_router_component, eu_national_gateway_adapter_component, "Direct / In-memory")
Rel(prescription_router_component, hl7_fhir_translator_component, "Direct / In-memory")
Rel(prescription_router_component, dead_letter_queue_dlq_and_retry_handler_component, "AMQP / Pub/Sub")
Rel(eu_national_gateway_adapter_component, external_pharmacies, "TLS / Mutual TLS with digital signatures")

@enduml