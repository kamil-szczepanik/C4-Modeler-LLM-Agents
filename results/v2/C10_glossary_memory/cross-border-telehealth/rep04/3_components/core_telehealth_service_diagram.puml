@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(DatabaseCluster, "Database Cluster", "Cloud Spanner / PostgreSQL", "Regional data stores secured via Google Cloud KMS CMEK.")
System_Ext(RegionalIdentityAndConsentProviders, "Regional Identity & Consent Providers", "OAuth2 / OpenID Connect", "External identity and consent providers for EU and US compliance.")

Container_Boundary(CoreTelehealthService, "Core Telehealth Service") {
    Component(ConsultationManagementComponent, "Consultation Management Component", "Go", "Handles secure video consultations, session handling, and real-time communication routing.")
    Component(ConsentAndIdentityIntegrationComponent, "Consent & Identity Integration Component", "Go / OAuth2 / OpenID Connect", "Manages integration with Regional Identity & Consent Providers for EU and US compliance.")
}

Rel(ConsultationManagementComponent, DatabaseCluster, "Stores consultation metadata and state", "TCP / CMEK")
Rel(ConsentAndIdentityIntegrationComponent, RegionalIdentityAndConsentProviders, "Authenticates users and verifies consent", "OAuth2 / OpenID Connect")

@enduml