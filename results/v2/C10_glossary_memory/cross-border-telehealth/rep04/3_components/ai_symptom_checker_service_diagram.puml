@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Symptom Checker Service container

Container_Boundary(ai_symptom_checker_service, "AI Symptom Checker Service") {
    Component(InferenceOrchestratorComponent, "Inference Orchestrator Component", "Python / FastAPI", "Orchestrates AI symptom checker request handling and fallback logic.")
    Component(PIIPHIMaskingComponent, "PII/PHI Masking Component", "Python / SpaCy/Regex", "Enables local PII/PHI masking to satisfy GDPR and HIPAA.")
    Component(AuditTraceabilityComponent, "Audit & Traceability Component", "Python / SQLAlchemy", "Manages audit logging and traceability via database writes.")
}

Rel(InferenceOrchestratorComponent, PIIPHIMaskingComponent, "In-memory function call", "")
Rel(InferenceOrchestratorComponent, AuditTraceabilityComponent, "Asynchronous gRPC / Database write", "")

@enduml