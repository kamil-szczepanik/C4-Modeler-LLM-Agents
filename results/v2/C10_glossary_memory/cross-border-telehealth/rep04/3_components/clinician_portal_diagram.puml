@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Clinician Portal container

System_Ext(GCP_Cloud_Storage_Cloud_CDN, "GCP Cloud Storage / Cloud CDN", "GCP Cloud Storage / Cloud CDN")
System_Ext(Regional_Identity_Consent_Providers, "Regional Identity & Consent Providers", "Regional Identity & Consent Providers")
System_Ext(API_Gateway_Routing_Service, "API Gateway & Routing Service", "API Gateway & Routing Service")

Container_Boundary(Clinician_Portal_boundary, "Clinician Portal") {
    Component(Consultation_Workspace_Component, "Consultation Workspace Component", "React / WebRTC", "Manages live video feeds and low-bandwidth fallback tools.")
    Component(AI_Audit_Reviewer_Component, "AI Audit Reviewer Component", "React SPA", "Displays traceable AI symptom-checker recommendations and model versions.")
    Component(E_Prescription_Dashboard_Component, "E-Prescription Dashboard Component", "React SPA", "Interfaces with regional standards and features a Cross-Border Pharmacy Routing Indicator.")
    Component(Portal_Navigation_Shell_Component, "Portal Navigation Shell Component", "React Router", "Manages layout routing, role-based view rendering, and error boundaries.")
    Component(Portal_State_Management_Component, "Portal State Management Component", "Redux Toolkit / React Query", "Managing session state, RBAC, and inactivity timeouts without caching PHI/PII.")
    Component(API_Client_Component, "API Client Component", "Axios / WebSockets / OpenTelemetry", "Client handling secure egress with OpenTelemetry distributed tracing.")
    Component(Clinician_Portal, "Clinician Portal", "GCP Cloud Storage / Cloud CDN", "React SPA providing the clinician user interface.")
}

Rel(Clinician_Portal, GCP_Cloud_Storage_Cloud_CDN, "Serves static SPA assets globally per region", "HTTPS")
Rel(Clinician_Portal, Regional_Identity_Consent_Providers, "Authenticates clinicians via OIDC with short-lived JWTs", "HTTPS")
Rel(Clinician_Portal, API_Gateway_Routing_Service, "Routes all outbound traffic via API Client Component", "HTTPS")
Rel(Portal_Navigation_Shell_Component, Consultation_Workspace_Component, "Renders active consultation view", "React Props / State")
Rel(Portal_Navigation_Shell_Component, AI_Audit_Reviewer_Component, "Renders audit logs view", "React Props / State")
Rel(Portal_Navigation_Shell_Component, E_Prescription_Dashboard_Component, "Renders prescription and routing view", "React Props / State")
Rel(Consultation_Workspace_Component, API_Client_Component, "Fetches video stream metadata", "HTTPS / WebSockets")
Rel(AI_Audit_Reviewer_Component, API_Client_Component, "Queries traceable AI logs", "HTTPS")
Rel(E_Prescription_Dashboard_Component, API_Client_Component, "Submits prescriptions", "HTTPS")

@enduml