@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database Cluster container

Container_Boundary(database_cluster, "Database Cluster") {
    Component(RegionalDataStore, "Regional Data Store", "Cloud Spanner / PostgreSQL", "Regional data stores with native change streams for compliance and low-latency transactions.")
    Component(AuditLoggingandEncryptionEngine, "Audit Logging and Encryption Engine", "Google Cloud KMS CMEK", "Provides column-level and storage encryption with automated key rotation and immutable audit logging.")
}

Rel(RegionalDataStore, AuditLoggingandEncryptionEngine, "Secured with CMEK and logs transactions via", "")

@enduml