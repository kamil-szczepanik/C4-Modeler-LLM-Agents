@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "Users accessing care, managing consent, and utilizing the AI symptom checker.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Healthcare providers delivering video consultations and issuing cross-border e-prescriptions.")
Person(Compliance_Officers, "Compliance Officers", "Overseeing audit trails, AI traceability, and data residency.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "A multi-region cross-border telehealth platform providing video consultations, e-prescriptions, and an AI symptom checker for EU and US patients while enforcing strict regional data residency and regulatory compliance under GDPR, HIPAA, and EU MDR.")

System_Ext(Video_Infrastructure_Provider, "Video Infrastructure Provider", "Third-party WebRTC SFU handling low-bandwidth consultations.")
System_Ext(AI_Inference_Engine, "AI Inference Engine", "External LLM service providing urgency recommendations.")
System_Ext(Regional_Pharmacy_Gateways, "Regional Pharmacy Gateways", "External HL7 FHIR APIs (US) and national gateways (EU) for e-prescription delivery.")
System_Ext(Identity_Consent_Providers, "Identity & Consent Providers", "Regional OIDC/OAuth2 authentication and consent management services.")

Rel(Patients, Cross_Border_Telehealth_Platform, "Accesses care, manages consent, and utilizes AI symptom checker", "HTTPS, WebSockets")
Rel(Licensed_Clinicians, Cross_Border_Telehealth_Platform, "Delivers video consultations and issues e-prescriptions", "HTTPS, WebSockets")
Rel(Compliance_Officers, Cross_Border_Telehealth_Platform, "Oversees audit trails, AI traceability, and data residency", "HTTPS")
Rel(Cross_Border_Telehealth_Platform, Video_Infrastructure_Provider, "Handles real-time video streaming for consultations", "HTTPS, WebSockets (WSS)")
Rel(Cross_Border_Telehealth_Platform, AI_Inference_Engine, "Sends symptom evaluation requests and receives urgencies", "HTTPS (REST/gRPC)")
Rel(Cross_Border_Telehealth_Platform, Regional_Pharmacy_Gateways, "Delivers e-prescriptions to US and EU pharmacies", "HTTPS (HL7 FHIR / National APIs)")
Rel(Cross_Border_Telehealth_Platform, Identity_Consent_Providers, "Authenticates users and manages consent", "OIDC/OAuth2 with FIDO2/WebAuthn")

@enduml