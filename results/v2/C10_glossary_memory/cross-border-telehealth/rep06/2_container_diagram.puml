@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "Users accessing care, managing consent, and utilizing the AI symptom checker.")
Person("Licensed Clinicians", "Licensed Clinicians", "Healthcare providers delivering video consultations and issuing cross-border e-prescriptions.")
Person("Compliance Officers", "Compliance Officers", "Overseeing audit trails, AI traceability, and data residency.")

System_Ext("Video Infrastructure Provider", "Video Infrastructure Provider", "Third-party WebRTC SFU handling low-bandwidth consultations.")
System_Ext("AI Inference Engine", "AI Inference Engine", "External LLM service providing urgency recommendations.")
System_Ext("Regional Pharmacy Gateways", "Regional Pharmacy Gateways", "External HL7 FHIR APIs (US) and national gateways (EU) for e-prescription delivery.")
System_Ext("Identity & Consent Providers", "Identity & Consent Providers", "Regional OIDC/OAuth2 authentication and consent management services.")

System_Boundary(system_boundary, "Cross-Border Telehealth Platform") {
    Container("API Gateway / BFF", "API Gateway / BFF", "Node.js/GraphQL", "API Gateway / BFF for efficient client-driven data fetching.")
    Container("Consultation & Prescriptions Service", "Consultation & Prescriptions Service", "Go/gRPC", "High-performance backend microservices and inter-container communication.")
    Container("AI Traceability & Logging Service", "AI Traceability & Logging Service", "Python/FastAPI", "AI Traceability & Logging Service for machine learning integration and auditing.")
    Container("Consent & Policy Engine", "Consent & Policy Engine", "Go/OPA", "Fine-grained ABAC enforcement for patient consent validation.")
    Container("Patient Portal App", "Patient Portal App", "Flutter/Web & Mobile", "Client applications optimized for multi-standard records and offline caching.")
    Container("Clinician Workspace App", "Clinician Workspace App", "React/TypeScript SPA", "Client applications optimized for multi-standard records and offline caching.")
}

Rel(Patients, "API Gateway / BFF", "Accesses API Gateway / BFF", "HTTPS, WebSockets")
Rel("Licensed Clinicians", "API Gateway / BFF", "Accesses API Gateway / BFF", "HTTPS, WebSockets")
Rel("Compliance Officers", "API Gateway / BFF", "Accesses API Gateway / BFF", "HTTPS")
Rel("Consultation & Prescriptions Service", "Regional Pharmacy Gateways", "Delivers e-prescriptions to US and EU pharmacies", "HTTPS (HL7 FHIR in US / National APIs in EU)")
Rel("API Gateway / BFF", "Consultation & Prescriptions Service", "Communicates via gRPC over TLS", "gRPC over TLS (mTLS via SPIFFE/SPIRE)")
Rel(system_boundary, "Video Infrastructure Provider", "Handles real-time video streaming for consultations", "HTTPS, WebSockets (WSS), SRTP/DTLS")
Rel(system_boundary, "AI Inference Engine", "Sends symptom evaluation requests and receives urgencies", "HTTPS (REST/gRPC)")
Rel(system_boundary, "Identity & Consent Providers", "Authenticates users and manages consent", "OIDC/OAuth2 with FIDO2/WebAuthn")

@enduml