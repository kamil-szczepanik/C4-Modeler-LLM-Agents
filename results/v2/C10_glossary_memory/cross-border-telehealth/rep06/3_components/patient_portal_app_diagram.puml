@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(patient_portal_app, "Patient Portal App") {
    Component(patient_portal_ui, "Patient Portal UI", "Flutter (Web & Mobile)", "Cross-platform user interface for patients, supporting web and mobile views with offline caching.")
    Component(symptom_checker_ui_module, "Symptom Checker UI Module", "Flutter", "Interactive UI module for patients to input symptoms and interact with the AI symptom checker.")
    Component(consultation_and_record_manager, "Consultation & Record Manager", "Flutter", "Manages video consultation links, e-prescriptions, and local cached patient records.")
}

Rel(patient_portal_ui, symptom_checker_ui_module, "Renders AI symptom triage workflow", "")
Rel(patient_portal_ui, consultation_and_record_manager, "Displays video sessions and e-prescriptions", "")
@enduml