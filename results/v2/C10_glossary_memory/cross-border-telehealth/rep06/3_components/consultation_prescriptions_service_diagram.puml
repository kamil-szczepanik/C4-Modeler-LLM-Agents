@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("consultation_prescriptions_service", "Consultation & Prescriptions Service") {
    Component("Consultation Controller", "Consultation Controller", "Go/gRPC", "Exposes gRPC endpoints for consultation management, video session coordination, and clinician interaction.")
    Component("Prescription Manager", "Prescription Manager", "Go", "Handles business logic for cross-border e-prescriptions and coordinates with external pharmacy gateways.")
    Component("Prescription Data Access", "Prescription Data Access", "Go / SQL Driver", "Persists and retrieves consultation history and prescription records with regional data residency enforcement.")
}

Rel("Consultation Controller", "Prescription Manager", "Delegates e-prescription workflow requests")
Rel("Prescription Manager", "Prescription Data Access", "Reads and writes prescription state")
@enduml