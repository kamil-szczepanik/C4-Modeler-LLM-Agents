@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(consent_and_policy_engine, "Consent & Policy Engine") {
    Component(PolicyDecisionPoint, "Policy Decision Point (PDP)", "Open Policy Agent", "Evaluates sub-millisecond ABAC and purpose-based consent rules.")
    Component(ConsentRepositoryProxy, "Consent Repository Proxy", "Go", "Proxies requests to the consent datastore enforcing regional data residency.")
    Component(AuditTraceabilityPublisher, "Audit & Traceability Publisher", "Go", "Asynchronously publishes policy decisions and audit logs to WORM storage.")
}

Rel(PolicyDecisionPoint, ConsentRepositoryProxy, "Internal Go interface", "")
Rel(PolicyDecisionPoint, AuditTraceabilityPublisher, "Asynchronous channel", "")

@enduml