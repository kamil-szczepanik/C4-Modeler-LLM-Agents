@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(clinician_workspace_app, "Clinician Workspace App") {
    Component(Clinician_UI_Router, "Clinician UI Router", "React Router / TypeScript", "Manages single-page application navigation and view rendering for clinicians.")
    Component(Consultation_View_Controller, "Consultation View Controller", "React / TypeScript", "Handles video consultation interfaces, WebRTC streaming controls, and session management.")
    Component(E_Prescription_Module, "E-Prescription Module", "React / TypeScript", "Enables clinicians to issue and manage cross-border e-prescriptions.")
}

Rel(Clinician_UI_Router, Consultation_View_Controller, "Renders")
Rel(Clinician_UI_Router, E_Prescription_Module, "Renders")
@enduml