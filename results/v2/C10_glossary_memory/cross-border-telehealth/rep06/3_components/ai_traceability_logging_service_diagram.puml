@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(ai_traceability_logging_service, "AI Traceability & Logging Service") {
    Component(AI_Logging_API_Controller, "AI Logging API Controller", "Python/FastAPI", "Exposes REST endpoints for ingestion and auditing of AI inference logs and traceability records.")
    Component(Audit_Traceability_Processor, "Audit & Traceability Processor", "Python/FastAPI / Pandas", "Processes, normalizes, and structures audit logs for compliance with EU MDR and regional requirements.")
    Component(Export_Formatter, "Export Formatter", "Python/FastAPI", "Generates exportable audit reports and compliance logs for review by compliance officers.")
}

Rel(AI_Logging_API_Controller, Audit_Traceability_Processor, "Ingests and forwards logs for normalization and validation", "")
Rel(Audit_Traceability_Processor, Export_Formatter, "Feeds processed audit trails for reporting and export", "")

@enduml