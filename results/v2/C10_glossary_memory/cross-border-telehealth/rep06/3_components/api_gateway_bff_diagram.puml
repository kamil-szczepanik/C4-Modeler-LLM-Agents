@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_bff, "API Gateway / BFF") {
    Component(GraphQL_Schema_Federation_Router, "GraphQL Schema Federation Router", "Node.js / GraphQL", "Federates GraphQL schemas and routes client-driven data fetching requests across microservices.")
    Component(Authentication_Authorization_Middleware, "Authentication & Authorization Middleware", "Node.js / OIDC / OAuth2", "Validates incoming tokens and enforces security policies for incoming client traffic.")
    Component(gRPC_Client_Proxy, "gRPC Client Proxy", "Node.js / gRPC / SPIFFE/SPIRE", "Manages secure mTLS connections and forwards backend requests to internal microservices.")
}

System_Ext(Consultation_Prescriptions_Service, "Consultation & Prescriptions Service", "Go/gRPC backend microservice")
System_Ext(Consent_Policy_Engine, "Consent & Policy Engine", "Go/OPA backend microservice")
System_Ext(AI_Traceability_Logging_Service, "AI Traceability & Logging Service", "Python/FastAPI backend microservice")

Rel(GraphQL_Schema_Federation_Router, Authentication_Authorization_Middleware, "Authenticates requests before resolving GraphQL queries", "")
Rel(GraphQL_Schema_Federation_Router, gRPC_Client_Proxy, "Dispatches backend calls", "")
Rel(gRPC_Client_Proxy, Consultation_Prescriptions_Service, "Invokes gRPC over TLS", "mTLS via SPIFFE/SPIRE")
Rel(gRPC_Client_Proxy, Consent_Policy_Engine, "Invokes gRPC over TLS", "mTLS")
Rel(gRPC_Client_Proxy, AI_Traceability_Logging_Service, "Invokes gRPC over TLS", "mTLS")
@enduml