@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(PatientsEUUS, "Patients (EU & US)", "Patients seeking video consultations, e-prescriptions, and AI symptom checking.")
Person(LicensedClinicians, "Licensed Clinicians", "Clinicians conducting video consultations and issuing e-prescriptions.")

System_Ext(EUUSRegionalPharmacies, "EU/US Regional Pharmacies", "Regional pharmacies fulfilling e-prescriptions using national EU standards and US HL7 FHIR.")
System_Ext(RegulatoryAuthoritiesNotifiedBodiesEUUS, "Regulatory Authorities / Notified Bodies (EU/US)", "Authorities auditing and ensuring compliance with GDPR, HIPAA, and EU MDR.")
System_Ext(IdentityProvidersIDPs, "Identity Providers (IDPs)", "External identity providers handling authentication via OAuth2/OIDC.")
System_Ext(ThirdPartyVideoInfrastructure, "Third-Party Video Infrastructure", "WebRTC-compliant SFU/MCU provider supporting adaptive bitrate streaming.")

System_Boundary(CrossBorderTelehealthPlatform, "Cross-Border Telehealth Platform") {
    Container(APIGatewayBFF, "API Gateway / BFF", "Node.js", "Provides API gateway and backend-for-frontend services.")
    Container(ConsultationPrescriptionsService, "Consultation & Prescriptions Service", "Java/Spring Boot", "Manages video consultations and prescription logic.")
    Container(EPrescriptionAdapter, "E-Prescription Adapter", "Node.js", "Adapts and communicates with regional pharmacies.")
    Container(AISymptomCheckerService, "AI Symptom Checker Service", "Python/FastAPI", "Provides AI-driven symptom checking for patients.")
    Container(ConsentPrivacyService, "Consent & Privacy Service", "Go", "Manages user consent and privacy compliance.")
    ContainerDb(RegionalDatabases, "Regional Databases", "Cloud SQL PostgreSQL", "Provides strictly partitioned regional relational databases for data residency compliance.")
}

Rel(PatientsEUUS, APIGatewayBFF, "Accesses video consultations, e-prescriptions, and AI symptom checker", "HTTPS/TLS 1.3 and WebRTC")
Rel(LicensedClinicians, APIGatewayBFF, "Conducts consultations and manages prescriptions", "HTTPS/TLS 1.3 and WebRTC")
Rel(APIGatewayBFF, ConsultationPrescriptionsService, "Routes consultation and prescription requests", "gRPC over mTLS")
Rel(ConsultationPrescriptionsService, EPrescriptionAdapter, "Sends e-prescription data for fulfillment", "gRPC over mTLS")
Rel(EPrescriptionAdapter, EUUSRegionalPharmacies, "Sends e-prescriptions", "HTTPS/REST with national EU standards and US HL7 FHIR")
Rel(APIGatewayBFF, AISymptomCheckerService, "Requests AI symptom analysis", "gRPC over mTLS")
Rel(APIGatewayBFF, ConsentPrivacyService, "Verifies and records user consent and privacy settings", "gRPC over mTLS")
Rel(CrossBorderTelehealthPlatform, IdentityProvidersIDPs, "Authenticates users", "OAuth2/OIDC")
Rel(RegulatoryAuthoritiesNotifiedBodiesEUUS, APIGatewayBFF, "Audits regional instances", "HTTPS / TLS 1.3 with mTLS and signed JWT")

@enduml