@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Symptom Checker Service container

Container_Boundary(ai_symptom_checker_service, "AI Symptom Checker Service") {
    Component(symptom_checker_api_controller, "Symptom Checker API Controller", "Python / FastAPI", "Exposes REST and gRPC endpoints to handle symptom checking requests from the API Gateway.")
    Component(inference_engine, "Inference Engine", "Python / PyTorch", "Executes machine learning models to analyze patient symptoms and generate preliminary health insights.")
    Component(consent_verification_client, "Consent Verification Client", "Python / gRPC Client", "Communicates with the Consent & Privacy Service over mTLS to verify user consent before processing symptom data.")
    Component(data_access_repository, "Data Access Repository", "SQLAlchemy / PostgreSQL Driver", "Manages secure data persistence and retrieval from the Regional Databases over mTLS.")
}

Rel(symptom_checker_api_controller, inference_engine, "Delegates symptom text and data for AI model inference.")
Rel(symptom_checker_api_controller, consent_verification_client, "Requests user privacy and consent validation via gRPC over mTLS.", "gRPC / mTLS")
Rel(inference_engine, data_access_repository, "Persists and retrieves anonymized diagnostic data using PostgreSQL over mTLS.", "PostgreSQL / mTLS")
@enduml