@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the E-Prescription Adapter container

Container_Boundary(eprescription_adapter, "E-Prescription Adapter") {
    Component(Prescription Routing Controller, "Prescription Routing Controller", "Node.js / Express Router", "Receives gRPC prescription dispatch requests from the Consultation & Prescriptions Service and handles routing logic.")
    Component(EU Standard Formatter, "EU Standard Formatter", "Node.js / JavaScript Module", "Transforms prescription payloads into national EU pharmacy standards.")
    Component(US HL7 FHIR Adapter, "US HL7 FHIR Adapter", "Node.js / HL7 FHIR Client", "Transforms and formats prescription payloads into US HL7 FHIR compliant requests.")
    Component(Pharmacy Integration Client, "Pharmacy Integration Client", "Node.js / Axios (HTTPS/REST)", "Communicates securely with EU/US Regional Pharmacies to deliver e-prescriptions.")
}

Rel(Prescription Routing Controller, EU Standard Formatter, "Forwards EU-bound prescriptions")
Rel(Prescription Routing Controller, US HL7 FHIR Adapter, "Forwards US-bound prescriptions")
Rel(EU Standard Formatter, Pharmacy Integration Client, "Passes formatted EU prescription payload")
Rel(US HL7 FHIR Adapter, Pharmacy Integration Client, "Passes formatted FHIR prescription payload")
@enduml