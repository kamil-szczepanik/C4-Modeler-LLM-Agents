@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_bff, "API Gateway / BFF") {
    Component(Ingress_Router_Geo_Routing_Middleware, "Ingress Router & Geo-Routing Middleware", "Node.js/Express", "Secures edge ingress, applies rate limiting, and enforces geo-routing.")
    Component(Consent_Enforcement_Proxy, "Consent Enforcement Proxy", "Node.js", "Enforces consent checks at the gateway layer.")
    Component(BFF_Aggregator_Payload_Optimizer, "BFF Aggregator & Payload Optimizer", "Node.js", "Aggregates responses and optimizes payloads for low-bandwidth rural connections.")
}

Rel(Ingress_Router_Geo_Routing_Middleware, Consent_Enforcement_Proxy, "Routes requests for consent validation", "")
Rel(Consent_Enforcement_Proxy, BFF_Aggregator_Payload_Optimizer, "Forwards validated requests", "")

@enduml