@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Consultation & Prescriptions Service container

System_Ext(Third_Party_Video_Infrastructure, "Third-Party Video Infrastructure", "External video infrastructure provider.")
System_Ext(Regional_Databases, "Regional Databases", "Cloud SQL PostgreSQL for regionally partitioned relational storage.")
System_Ext(Consent_Privacy_Service, "Consent & Privacy Service", "Service for verifying consent and privacy compliance.")

Container_Boundary(Consultation_Prescriptions_Service, "Consultation & Prescriptions Service") {
    Component(Consultation_Session_Manager, "Consultation Session Manager", "Java/Spring Boot, WebRTC, Redis Protocol", "Manages video consultation sessions, adaptive bitrate video streaming, and ephemeral session states.")
    Component(Prescription_Domain_Controller, "Prescription Domain Controller", "Java/Spring Boot, JDBC", "Handles prescription business logic and interacts with regional relational databases.")
}

Rel(Consultation_Session_Manager, Third_Party_Video_Infrastructure, "Connects for video consultations", "HTTPS/WebSocket over TLS 1.3")
Rel(Prescription_Domain_Controller, Regional_Databases, "Persists prescription and consultation data", "JDBC over mTLS")
Rel(Consultation_Session_Manager, Regional_Databases, "Caches ephemeral session states", "Redis Protocol over mTLS")
Rel(Consultation_Prescriptions_Service, Consent_Privacy_Service, "Verifies consent and privacy compliance", "gRPC over mTLS")

@enduml