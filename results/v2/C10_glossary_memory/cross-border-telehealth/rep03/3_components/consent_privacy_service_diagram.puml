@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(consent_privacy_service, "Consent & Privacy Service") {
    Component(consent_api_controller, "Consent API Controller", "Go HTTP Handler", "Handles incoming gRPC requests related to user consent and privacy management.")
    Component(privacy_enforcement_engine, "Privacy Enforcement Engine", "Go Business Logic", "Validates and enforces regional data privacy policies, GDPR, and HIPAA compliance rules.")
    Component(consent_data_access_component, "Consent Data Access Component", "Go Database Driver", "Interacts securely with the regional partitioned database to store and retrieve consent records.")
}

Rel(consent_api_controller, privacy_enforcement_engine, "Delegates validation and enforcement of privacy policies", "gRPC / In-Memory")
Rel(privacy_enforcement_engine, consent_data_access_component, "Persists and queries consent records", "Function Call")

@enduml