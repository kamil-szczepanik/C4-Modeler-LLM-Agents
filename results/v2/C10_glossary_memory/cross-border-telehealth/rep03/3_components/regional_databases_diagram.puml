@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(regional_databases, "Regional Databases") {
    Component(DataPartitionManager, "Data Partition Manager", "PostgreSQL Partitioning", "Manages regional data partitioning to enforce strict data residency compliance.")
    Component(AuditLoggingStore, "Audit Logging Store", "PostgreSQL Append-Only Tables / pgAudit", "Stores immutable audit logs for regulatory compliance and traceability.")
    Component(ConsentIndexer, "Consent Indexer", "PostgreSQL B-Tree/GIN Indexes", "Provides indexing for fast and efficient consent and privacy record retrieval.")
    Component(PatientDataArchivalPurgeManager, "Patient Data Archival & Purge Manager", "PostgreSQL Partition Dropping / Retention Jobs", "Manages data retention policies, archiving, and purging of patient data.")
}

Rel(DataPartitionManager, AuditLoggingStore, "Logs partitioning events")
Rel(ConsentIndexer, DataPartitionManager, "Indexes partitioned consent data")
Rel(PatientDataArchivalPurgeManager, DataPartitionManager, "Executes partition dropping and retention cleanup")
@enduml