@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_EU_US, "Patients (EU & US)", "Patients seeking video consultations, e-prescriptions, and AI symptom checking.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Clinicians conducting video consultations and issuing e-prescriptions.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and US while enforcing strict regional data residency, regulatory compliance, and low-bandwidth availability.")

System_Ext(EU_US_Regional_Pharmacies, "EU/US Regional Pharmacies", "Regional pharmacies fulfilling e-prescriptions using national EU standards and US HL7 FHIR.")
System_Ext(Regulatory_Authorities_Notified_Bodies_EU_US, "Regulatory Authorities / Notified Bodies (EU/US)", "Authorities auditing and ensuring compliance with GDPR, HIPAA, and EU MDR.")
System_Ext(Identity_Providers_IDPs, "Identity Providers (IDPs)", "External identity providers handling authentication via OAuth2/OIDC.")
System_Ext(Third_Party_Video_Infrastructure, "Third-Party Video Infrastructure", "WebRTC-compliant SFU/MCU provider supporting adaptive bitrate streaming.")

Rel(Patients_EU_US, Cross_Border_Telehealth_Platform, "Accesses video consultations, e-prescriptions, and AI symptom checker", "HTTPS/TLS 1.3 and WebRTC")
Rel(Licensed_Clinicians, Cross_Border_Telehealth_Platform, "Conducts consultations and manages prescriptions", "HTTPS/TLS 1.3 and WebRTC")
Rel(Cross_Border_Telehealth_Platform, EU_US_Regional_Pharmacies, "Sends e-prescriptions", "HTTPS/REST (national EU standards and US HL7 FHIR)")
Rel(Cross_Border_Telehealth_Platform, Identity_Providers_IDPs, "Authenticates users", "OAuth2/OIDC")
Rel(Regulatory_Authorities_Notified_Bodies_EU_US, Cross_Border_Telehealth_Platform, "Audits regional instances", "HTTPS / TLS 1.3 with mTLS and signed JWT")

@enduml