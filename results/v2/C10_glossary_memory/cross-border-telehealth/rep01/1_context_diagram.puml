@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_Licensed_Clinicians, "Patients & Licensed Clinicians", "Primary human users interacting via Web and Mobile Apps for video consultations, e-prescriptions, and symptom checking.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "A unified cross-border telehealth SaaS platform providing video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and US, enforcing strict regional data residency and compliance using isolated cloud deployments.")

System_Ext(Pharmacies_Regional_Health_Authorities_Payers, "Pharmacies & Regional Health Authorities/Payers", "External systems handling prescriptions, claims, and reimbursement.")
System_Ext(AI_Triage_Model_Provider, "AI Triage Model Provider", "GCP Vertex AI managing symptom-checking inference.")
System_Ext(Identity_Consent_Providers, "Identity & Consent Providers", "Region-specific IAM systems supporting OIDC/SAML.")

Rel(Patients_Licensed_Clinicians, Cross_Border_Telehealth_Platform, "Connect via WebRTC for video and HTTPS for APIs", "HTTPS/WebRTC")
Rel(Cross_Border_Telehealth_Platform, Pharmacies_Regional_Health_Authorities_Payers, "Integrates using REST and HL7 FHIR protocols", "REST / HL7 FHIR")
Rel(Cross_Border_Telehealth_Platform, AI_Triage_Model_Provider, "Communicates via version-pinned inference APIs", "Version-pinned inference APIs (mTLS)")
Rel(Cross_Border_Telehealth_Platform, Identity_Consent_Providers, "Authenticates users via regional IAM systems", "OIDC / SAML")
@enduml