@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(web_mobile_apps, "Web & Mobile Apps") {
    Component(CrossPlatformUI, "Cross-Platform UI Layer", "Flutter/React", "Cross-platform UI providing resilient local-first client state and offline caching for rural areas.")
    Component(WebRTCModule, "WebRTC Video Module", "WebRTC", "Low-bandwidth video consultations supporting degraded connections below 300 kbit/s.")
    Component(StaticAssetDelivery, "Static Asset Delivery", "GCP Cloud CDN / Cloud Storage", "Global static asset delivery isolated across europe-west3 and us-central1.")
}

Rel(CrossPlatformUI, WebRTCModule, "Initiates video consultation streams")
Rel(CrossPlatformUI, StaticAssetDelivery, "Fetches static assets and cached resources")

@enduml