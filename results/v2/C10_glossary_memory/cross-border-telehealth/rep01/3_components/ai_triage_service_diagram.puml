@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Triage Service container

Container_Boundary(ai_triage_service, "AI Triage Service") {
    Component(PHI_Sanitizer_Component, "PHI Sanitizer Component", "Python / FastAPI", "Sanitizes Protected Health Information (PHI) and PII locally before model processing.")
    Component(Inference_Orchestrator_Component, "Inference Orchestrator Component", "Python / FastAPI", "Orchestrates symptom-checking inference requests and model interactions.")
    Component(Audit_Logger_Component, "Audit Logger Component", "Python / FastAPI", "Logs AI triage activities and ensures EU MDR traceability and audit compliance.")
    Component(Clinical_Feedback_Collector_Component, "Clinical Feedback Collector Component", "Python / FastAPI", "Collects clinical feedback for AI triage model refinement and monitoring.")
}

Rel(PHI_Sanitizer_Component, Inference_Orchestrator_Component, "Sends sanitized data")
Rel(Inference_Orchestrator_Component, Audit_Logger_Component, "Records audit logs")
Rel(Clinical_Feedback_Collector_Component, Audit_Logger_Component, "Logs feedback events")

@enduml