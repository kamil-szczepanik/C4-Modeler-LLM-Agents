@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(e_prescription_dispatcher, "E-Prescription Dispatcher") {
    Component(Prescription_Receiver, "Prescription Receiver", "Go / gRPC", "Receives internal prescription dispatch requests from the Core Telehealth Service.")
    Component(Dispatch_Engine, "Dispatch Engine", "Go", "Orchestrates secure, reliable, and idempotent cross-border prescription routing.")
    Component(Pharmacy_Client, "Pharmacy Client", "Go / REST / HL7 FHIR", "Handles external communication and API interactions with regional pharmacies, health authorities, and payers.")
}

Rel(Prescription_Receiver, Dispatch_Engine, "Passes incoming dispatch requests")
Rel(Dispatch_Engine, Pharmacy_Client, "Triggers external prescription transmission")
@enduml