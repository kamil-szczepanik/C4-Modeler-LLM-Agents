@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Consent & Audit Ledger container

Container_Boundary(consent_and_audit_ledger, "Consent & Audit Ledger") {
    Component(Consent_Ledger_Manager, "Consent Ledger Manager", "Go", "Manages consent records and immutable audit logs with cryptographic integrity.")
    Component(Auditor_Reporting_API, "Auditor Reporting API", "Go / HTTPS", "Provides auditor reporting interface via HTTPS for compliance checks.")
    Component(PostgreSQL_Database_Engine, "PostgreSQL Database Engine", "Cloud SQL for PostgreSQL", "Regionally isolated data persistence secured via GCP Cloud KMS (CMEK), row-level security, and pgcrypto.")
}

Rel(Consent_Ledger_Manager, PostgreSQL_Database_Engine, "Persists audit logs and consent records", "PostgreSQL Wire Protocol")
Rel(Auditor_Reporting_API, Consent_Ledger_Manager, "Queries consent and audit data for compliance reporting")
@enduml