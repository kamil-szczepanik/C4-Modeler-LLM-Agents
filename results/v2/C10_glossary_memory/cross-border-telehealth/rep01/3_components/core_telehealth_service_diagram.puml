@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(core_telehealth_service, "Core Telehealth Service") {
    Component(consultation_session_manager, "Consultation Session Manager", "Java / Spring Boot", "Manages telehealth consultation sessions and session state recovery.")
    Component(consent_enforcement_interceptor, "Consent Enforcement Interceptor", "Java / Spring Boot", "Enforces strict regional consent and data access checks before method execution.")
    Component(telehealth_orchestrator, "Telehealth Orchestrator", "Java / Spring Boot", "Orchestrates workflows between telehealth services, dispatchers, and triage.")
    Component(telehealth_notification_audit_adapter, "Telehealth Notification & Audit Adapter", "Java / Spring Boot", "Adapts and dispatches audit logs and notifications to the Consent & Audit Ledger.")
}

System_Ext(e_prescription_dispatcher, "E-Prescription Dispatcher", "Go")
System_Ext(consent_audit_ledger, "Consent & Audit Ledger", "PostgreSQL")
System_Ext(ai_triage_service, "AI Triage Service", "Python / FastAPI")

Rel(consultation_session_manager, consent_enforcement_interceptor, "Internal Method Call", "")
Rel(telehealth_orchestrator, e_prescription_dispatcher, "gRPC", "")
Rel(telehealth_notification_audit_adapter, consent_audit_ledger, "PostgreSQL Wire Protocol", "")
Rel(core_telehealth_service, ai_triage_service, "gRPC", "")

@enduml