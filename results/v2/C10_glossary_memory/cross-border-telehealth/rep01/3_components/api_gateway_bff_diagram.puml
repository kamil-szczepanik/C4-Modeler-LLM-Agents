@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway & BFF container

Container_Boundary(api_gateway_bff, "API Gateway & BFF") {
    Component(Edge_Router_TLS_Terminator, "Edge Router & TLS Terminator", "Envoy Proxy", "Handles edge routing, TLS termination, and WAF.")
    Component(Rate_Limiting_Resilience_Proxy, "Rate Limiting & Resilience Proxy", "Envoy/Go", "Manages rate limiting and resilience proxies for high performance.")
    Component(Patient_Clinician_BFF_Service, "Patient & Clinician BFF Service", "Go", "Powers the BFF service for frontend optimization.")
    Component(Audit_Metadata_Interceptor, "Audit & Metadata Interceptor", "Go", "Intercepts requests for audit and metadata logging.")
}

System(Core_Telehealth_Service, "Core Telehealth Service", "Java/Spring Boot")
System(AI_Triage_Service, "AI Triage Service", "Python/FastAPI")

Rel(Edge_Router_TLS_Terminator, Rate_Limiting_Resilience_Proxy, "Routes client traffic")
Rel(Rate_Limiting_Resilience_Proxy, Patient_Clinician_BFF_Service, "Forwards validated requests")
Rel(Patient_Clinician_BFF_Service, Audit_Metadata_Interceptor, "Logs metadata")
Rel(Patient_Clinician_BFF_Service, Core_Telehealth_Service, "Routes business logic requests", "gRPC / mTLS")
Rel(Patient_Clinician_BFF_Service, AI_Triage_Service, "Routes symptom-checker requests", "gRPC / mTLS")

@enduml