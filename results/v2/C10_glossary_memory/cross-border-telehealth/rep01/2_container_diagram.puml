@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(PatientsLicensedClinicians, "Patients & Licensed Clinicians", "Primary human users interacting via Web and Mobile Apps for video consultations, e-prescriptions, and symptom checking.")

System_Ext(PharmaciesRegionalHealthAuthoritiesPayers, "Pharmacies & Regional Health Authorities/Payers", "External systems handling prescriptions, claims, and reimbursement.")
System_Ext(AITriageModelProvider, "AI Triage Model Provider", "GCP Vertex AI managing symptom-checking inference.")
System_Ext(IdentityConsentProviders, "Identity & Consent Providers", "Region-specific IAM systems supporting OIDC/SAML.")

System_Boundary(CrossBorderTelehealthPlatform, "Cross-Border Telehealth Platform") {
    Container(WebMobileApps, "Web & Mobile Apps", "Flutter/React", "Client-facing applications for patients and clinicians.")
    Container(APIGatewayBFF, "API Gateway & BFF", "Envoy/Go", "External traffic routing, TLS termination, and backend-for-frontend logic.")
    Container(CoreTelehealthService, "Core Telehealth Service", "Java/Spring Boot", "Implements the core telehealth service business logic.")
    Container(AITriageService, "AI Triage Service", "Python/FastAPI", "Powers the AI Triage Service for local PHI/PII sanitization and model interaction.")
    ContainerDb(ConsentAuditLedger, "Consent & Audit Ledger", "PostgreSQL", "Serves as the Consent & Audit Ledger, secured via Customer-Managed Encryption Keys (CMEK) via Cloud KMS.")
    Container(EPrescriptionDispatcher, "E-Prescription Dispatcher", "Go", "Dispatches e-prescriptions to regional pharmacies and health authorities.")
}

Rel(PatientsLicensedClinicians, WebMobileApps, "Interacts with UI for video consultations, e-prescriptions, and symptom checking", "HTTPS/WebRTC")
Rel(WebMobileApps, APIGatewayBFF, "Sends client requests and API calls", "HTTPS")
Rel(APIGatewayBFF, CoreTelehealthService, "Routes business logic requests", "gRPC / REST")
Rel(APIGatewayBFF, AITriageService, "Routes AI symptom checker requests", "gRPC / REST")
Rel(CoreTelehealthService, ConsentAuditLedger, "Reads and writes audit logs and consent records", "PostgreSQL Wire Protocol")
Rel(CoreTelehealthService, EPrescriptionDispatcher, "Triggers e-prescription dispatch", "Internal Messaging / gRPC")
Rel(AITriageService, AITriageModelProvider, "Performs version-pinned inference APIs", "Version-pinned inference APIs (mTLS)")
Rel(EPrescriptionDispatcher, PharmaciesRegionalHealthAuthoritiesPayers, "Sends e-prescriptions and health claims", "REST / HL7 FHIR")
Rel(APIGatewayBFF, IdentityConsentProviders, "Authenticates users", "OIDC / SAML")

@enduml