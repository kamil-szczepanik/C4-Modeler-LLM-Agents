@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Cross-Border Telehealth Platform

Person(Patients_EU_US, "Patients (EU & US)", "Patients located in the EU and US seeking video consultations, e-prescriptions, and AI symptom checking.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Medical professionals providing remote video consultations and issuing e-prescriptions.")
Person(Pharmacists_EU_US, "Pharmacists (EU/US)", "Pharmacists fulfilling e-prescriptions across EU and US regions.")
Person(Compliance_Regulatory_Auditors, "Compliance & Regulatory Auditors", "Auditors reviewing system compliance against HIPAA and EU MDR regulations.")

System_Ext(National_e_Prescription_Gateways_EU, "National e-Prescription Gateways (EU)", "External national gateways in the EU for processing e-prescriptions using national standards.")
System_Ext(Pharmacy_Systems_US, "Pharmacy Systems (US)", "External US pharmacy systems for fulfilling prescriptions using HL7 FHIR.")
System_Ext(Third_Party_Video_Infrastructure_WebRTC_CPaaS, "Third-Party Video Infrastructure (WebRTC CPaaS)", "CPaaS providing WebRTC-compatible video streaming services with adaptive bitrate codecs and TURN relays.")
System_Ext(Regional_Identity_Providers_eIDAS_OIDC_OAuth_2_0, "Regional Identity Providers (eIDAS/OIDC/OAuth 2.0)", "External identity providers validating authentication tokens using eIDAS, OIDC, and OAuth 2.0.")

System_Boundary(Cross_Border_Telehealth_Platform_boundary, "Cross-Border Telehealth Platform") {
    Container(Regional_API_Gateways, "Regional API Gateways", "GCP", "API gateways deployed in GCP regions to handle incoming regional traffic.")
    Container(Frontend_UI_with_localization, "Frontend UI (with localization)", "Web / Mobile", "Localized user interface for patients, clinicians, and pharmacists.")
    Container(Video_Streaming_Service, "Video Streaming Service", "WebRTC, UDP/TCP/TLS, TURN", "Manages low-bandwidth video consultations.")
    Container(AI_Symptom_Checker_Service, "AI Symptom Checker Service", "AI / GCP", "Provides AI-driven symptom checking with cryptographically signed outputs.")
    Container(Consent_Data_Management_Service, "Consent & Data Management Service", "CMEK, GCP (`europe-west3`, `us-central1`)", "Manages user consent and enforces regional data residency and CMEK encryption.")
    Container(Immutable_Logging_Service, "Immutable Logging Service", "Cryptographic Logging", "Records audit trails and cryptographically signed AI outputs locally per region.")
}

Rel(Patients_EU_US, Cross_Border_Telehealth_Platform_boundary, "Interact with the platform for consultations and symptom checking via secure channels", "HTTPS (TLS 1.3), secure WebSockets, OIDC/OAuth 2.0")
Rel(Licensed_Clinicians, Cross_Border_Telehealth_Platform_boundary, "Conduct video consultations and manage e-prescriptions", "HTTPS (TLS 1.3), secure WebSockets, OIDC/OAuth 2.0")
Rel(Pharmacists_EU_US, Cross_Border_Telehealth_Platform_boundary, "Access and fulfill e-prescriptions", "HTTPS / REST, HL7 FHIR")
Rel(Compliance_Regulatory_Auditors, Cross_Border_Telehealth_Platform_boundary, "Review audit trails and compliance logs", "HTTPS")
Rel(Cross_Border_Telehealth_Platform_boundary, National_e_Prescription_Gateways_EU, "Integrate for EU e-prescriptions", "HTTPS/REST, national standards")
Rel(Cross_Border_Telehealth_Platform_boundary, Pharmacy_Systems_US, "Integrate for US prescription fulfillment", "HTTPS/REST, HL7 FHIR")
Rel(Cross_Border_Telehealth_Platform_boundary, Third_Party_Video_Infrastructure_WebRTC_CPaaS, "Connect for low-bandwidth video consultations", "WebRTC (UDP/TCP/TLS fallback via TURN relays)")
Rel(Cross_Border_Telehealth_Platform_boundary, Regional_Identity_Providers_eIDAS_OIDC_OAuth_2_0, "Validate authentication tokens", "OpenID Connect / OAuth 2.0 / eIDAS")

@enduml