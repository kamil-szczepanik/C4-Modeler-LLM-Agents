@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Frontend UI (with localization) container

Container_Boundary(frontend_ui_with_localization, "Frontend UI (with localization)") {
    Component(Localization_Module, "Localization Module", "Flutter Localization Engine", "Manages dynamic localization and language packs for EU and US users.")
    Component(Offline_Storage_Module, "Offline Storage Module", "Local SQLite / Secure Storage", "Handles offline-first caching of patient session data and compliance records.")
    Component(UI_Presentation_Layer, "UI Presentation Layer", "Flutter Web/Mobile Widgets", "Renders responsive views for patients, clinicians, pharmacists, and auditors.")
}

Rel(Localization_Module, UI_Presentation_Layer, "Provides localized strings", "")
Rel(Offline_Storage_Module, UI_Presentation_Layer, "Syncs cached offline data", "")

@enduml