@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component Diagram for Regional API Gateways

Container_Boundary(regional_api_gateways, "Regional API Gateways") {
    Component(Edge_Routing___Residency_Enforcer, "Edge Routing & Residency Enforcer", "Envoy proxy components", "Enforces strict regional data residency and handles edge routing for incoming regional traffic.")
    Component(JWT___Consent_Validator, "JWT & Consent Validator", "Envoy proxy components", "Validates JSON Web Tokens and user consent against regional policies.")
    Component(Rate_Limiting___Degradation_Handler, "Rate Limiting & Degradation Handler", "Envoy proxy components", "Manages rate limiting and ensures graceful degradation for users with low-bandwidth connections.")
    Component(Localized_Error___Fallback_Responder, "Localized Error & Fallback Responder", "Envoy proxy components", "Provides localized error messages and fallback responses tailored to regional requirements.")
}

Rel(Edge_Routing___Residency_Enforcer, JWT___Consent_Validator, "Routes requests for token and consent validation")
Rel(JWT___Consent_Validator, Rate_Limiting___Degradation_Handler, "Passes authenticated requests for traffic management")
Rel(Rate_Limiting___Degradation_Handler, Localized_Error___Fallback_Responder, "Invokes fallback logic on system degradation or errors")

@enduml