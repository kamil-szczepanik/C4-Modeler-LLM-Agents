@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(immutable_logging_service, "Immutable Logging Service") {
    Component(Log Ingestion Component, "Log Ingestion Component", "Go, gRPC/PubSub subscriber", "Ingests log entries via Pub/Sub and gRPC subscribers for immutable tracking.")
    Component(Cryptographic Verifier Component, "Cryptographic Verifier Component", "Go, Tink/Cloud HSM", "Verifies and signs logs cryptographically using Tink and Cloud HSM.")
    Component(WORM Storage Manager Component, "WORM Storage Manager Component", "Java/Go, GCP Cloud Storage Object Lock", "Manages Write Once, Read Many (WORM) storage using GCP Cloud Storage Object Lock.")
}

Rel(Log Ingestion Component, Cryptographic Verifier Component, "Sends ingested logs for cryptographic verification")
Rel(Cryptographic Verifier Component, WORM Storage Manager Component, "Forwards verified signed logs to WORM storage")
@enduml