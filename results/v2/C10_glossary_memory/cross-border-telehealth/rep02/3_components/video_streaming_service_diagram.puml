@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(video_streaming_service, "Video Streaming Service") {
    Component(Signaling___Session_Manager_Component, "Signaling & Session Manager Component", "Node.js/Go, gRPC/WebSockets", "Manages session signaling, connection negotiation, and real-time messaging for video consultations.")
    Component(Adaptive_Quality___Fallback_Controller_Component, "Adaptive Quality & Fallback Controller Component", "C++/WebRTC, DTLS/SCTP", "Controls video stream quality dynamically and manages fallback paths under unstable network conditions.")
    Component(TURN_Relay_Coordinator_Component, "TURN Relay Coordinator Component", "Coturn-based, UDP/TCP/TLS", "Coordinates NAT traversal and relay allocations for secure peer-to-peer media streams.")
}

Rel(Signaling___Session_Manager_Component, Adaptive_Quality___Fallback_Controller_Component, "Coordinates session state and adaptation parameters")
Rel(Signaling___Session_Manager_Component, TURN_Relay_Coordinator_Component, "Allocates relay paths for session media")
@enduml