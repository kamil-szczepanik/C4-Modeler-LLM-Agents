@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Symptom Checker Service container

Container_Boundary(ai_symptom_checker_service, "AI Symptom Checker Service") {
    Component(Triage_Controller, "Triage Controller", "FastAPI / Python", "Handles incoming symptom checking requests and orchestrates the triage workflow.")
    Component(AI_Inference_Engine, "AI Inference Engine", "PyTorch & GCP Vertex AI", "Powers regional AI symptom triage models with auto-scaling capabilities.")
    Component(Cryptographic_Signer, "Cryptographic Signer", "Google Cloud HSM", "Provides cryptographic hardware security for signing AI outputs ensuring EU MDR traceability.")
}

Rel(Triage_Controller, AI_Inference_Engine, "Sends symptom data for processing")
Rel(AI_Inference_Engine, Cryptographic_Signer, "Requests cryptographic signature for AI outputs")

@enduml