@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(consent_container, "Consent & Data Management Service") {
    Component(ConsentAPIController, "Consent API Controller", "Go / Java (Spring Boot)", "Handles incoming consent-related API requests and coordinates validation and processing workflows.")
    Component(ResidencyEnforcerPolicyEngine, "Residency Enforcer & Policy Engine", "Open Policy Agent (OPA)", "Evaluates dynamic consent and regional data residency policies.")
    Component(RegionalVaultManager, "Regional Vault Manager", "JDBC over mTLS", "Manages regional data storage and vault access ensuring regional isolation.")
    Component(ConsentEventPublisher, "Consent Event Publisher", "GCP Pub/Sub", "Publishes consent and revocation events across regions instantly.")
    Component(BreakGlassEvaluator, "Break-Glass Evaluator", "Go / Java (Spring Boot)", "Validates and evaluates emergency break-glass access requests.")
}

System_Ext(ImmutableLoggingService, "Immutable Logging Service", "GCP Cloud Storage, Cloud Logging, Pub/Sub")

Rel(ConsentAPIController, ResidencyEnforcerPolicyEngine, "In-process function calls")
Rel(ResidencyEnforcerPolicyEngine, RegionalVaultManager, "JDBC over mTLS")
Rel(ResidencyEnforcerPolicyEngine, ConsentEventPublisher, "GCP Pub/Sub")
Rel(ConsentAPIController, BreakGlassEvaluator, "In-process validation")
Rel(BreakGlassEvaluator, ImmutableLoggingService, "GCP Pub/Sub, regional CMEK", "GCP Pub/Sub, regional CMEK")

@enduml