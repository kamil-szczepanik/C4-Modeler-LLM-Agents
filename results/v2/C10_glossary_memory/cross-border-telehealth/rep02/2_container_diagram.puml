@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients_EU_US, "Patients (EU & US)", "Patients located in the EU and US seeking video consultations, e-prescriptions, and AI symptom checking.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Medical professionals providing remote video consultations and issuing e-prescriptions.")
Person(Pharmacists_EU_US, "Pharmacists (EU/US)", "Pharmacists fulfilling e-prescriptions across EU and US regions.")
Person(Compliance_Regulatory_Auditors, "Compliance & Regulatory Auditors", "Auditors reviewing system compliance against HIPAA and EU MDR regulations.")

System_Ext(National_ePrescription_Gateways_EU, "National e-Prescription Gateways (EU)", "External national gateways in the EU for processing e-prescriptions using national standards.")
System_Ext(Pharmacy_Systems_US, "Pharmacy Systems (US)", "External US pharmacy systems for fulfilling prescriptions using HL7 FHIR.")
System_Ext(Third_Party_Video_Infrastructure_WebRTC_CPaaS, "Third-Party Video Infrastructure (WebRTC CPaaS)", "CPaaS providing WebRTC-compatible video streaming services with adaptive bitrate codecs and TURN relays.")
System_Ext(Regional_Identity_Providers_eIDAS_OIDC_OAuth_2_0, "Regional Identity Providers (eIDAS/OIDC/OAuth 2.0)", "External identity providers validating authentication tokens using eIDAS, OIDC, and OAuth 2.0.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(Frontend_UI_with_localization, "Frontend UI (with localization)", "Flutter Web/Mobile", "Localized user interface with offline-first local storage supporting compliance flows.")
    Container(Regional_API_Gateways, "Regional API Gateways", "GCP Cloud Endpoints/API Gateway", "API gateways deployed in GCP regions to handle incoming regional traffic.")
    Container(Video_Streaming_Service, "Video Streaming Service", "WebRTC, UDP/TCP/TLS, TURN", "Manages low-bandwidth video consultations.")
    Container(AI_Symptom_Checker_Service, "AI Symptom Checker Service", "AI / GCP, Cloud HSM", "Provides AI-driven symptom checking with cryptographically signed outputs.")
    Container(Consent_Data_Management_Service, "Consent & Data Management Service", "CMEK, GCP", "Manages user consent and enforces regional data residency and CMEK encryption.")
    Container(Immutable_Logging_Service, "Immutable Logging Service", "GCP Cloud Storage, Cloud Logging, Pub/Sub", "Records audit trails and cryptographically signed AI outputs locally per region.")
}

Rel(Patients_EU_US, Frontend_UI_with_localization, "Interact with the platform for consultations and symptom checking", "HTTPS (TLS 1.3), secure WebSockets, OIDC/OAuth 2.0")
Rel(Licensed_Clinicians, Frontend_UI_with_localization, "Conduct video consultations and manage e-prescriptions", "HTTPS (TLS 1.3), secure WebSockets, OIDC/OAuth 2.0")
Rel(Pharmacists_EU_US, Frontend_UI_with_localization, "Access and fulfill e-prescriptions", "HTTPS (TLS 1.3), secure WebSockets, OIDC/OAuth 2.0")
Rel(Compliance_Regulatory_Auditors, Frontend_UI_with_localization, "Review audit trails and compliance logs", "HTTPS (TLS 1.3)")
Rel(Frontend_UI_with_localization, Regional_API_Gateways, "Sends API requests for core telehealth operations", "HTTPS (REST/GraphQL), TLS 1.3")
Rel(Regional_API_Gateways, Consent_Data_Management_Service, "Manages encrypted patient data and regional consents", "gRPC over mTLS")
Rel(AI_Symptom_Checker_Service, Immutable_Logging_Service, "Streams cryptographically signed AI outputs for audit and traceability", "GCP Pub/Sub (encrypted with regional CMEK)")
Rel(Regional_API_Gateways, Third_Party_Video_Infrastructure_WebRTC_CPaaS, "Connects for low-bandwidth video consultations", "WebRTC (UDP/TCP/TLS via TURN relays)")
Rel(Regional_API_Gateways, National_ePrescription_Gateways_EU, "Integrates for EU e-prescriptions", "HTTPS/REST (national standards)")
Rel(Regional_API_Gateways, Pharmacy_Systems_US, "Integrates for US prescription fulfillment", "HTTPS/REST (HL7 FHIR)")

@enduml