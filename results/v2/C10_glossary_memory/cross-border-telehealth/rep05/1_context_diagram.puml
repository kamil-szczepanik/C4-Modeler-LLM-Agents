@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "End-users receiving video consultations, e-prescriptions, and using the AI symptom checker.")
Person(Licensed Clinicians, "Licensed Clinicians", "Healthcare professionals providing video consultations and issuing e-prescriptions to patients.")
Person(Auditors, "Compliance Officers / Auditors", "Personnel responsible for auditing system logs and ensuring regulatory compliance.")

System(Cross-Border Telehealth Platform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for patients across the EU and US while enforcing strict regional data residency and regulatory compliance.")

System_Ext(EU National E-Prescription Gateways, "EU National E-Prescription Gateways", "External EU gateways for managing and transmitting e-prescriptions.")
System_Ext(US Pharmacy Networks (Surescripts), "US Pharmacy Networks (Surescripts)", "External US pharmacy networks for processing prescriptions.")
System_Ext(Identity Providers (eIDAS / OAuth2/OIDC), "Identity Providers (eIDAS / OAuth2/OIDC)", "External identity providers for secure authentication and identity verification.")
System_Ext(Regional Payment & Insurance Gateways, "Regional Payment & Insurance Gateways", "External gateways handling regional payments and insurance verification.")

Rel(Patients, Cross-Border Telehealth Platform, "Video consultations, e-prescriptions, and AI symptom checking", "HTTPS/WebRTC (DTLS-SRTP, adaptive bitrate)")
Rel(Licensed Clinicians, Cross-Border Telehealth Platform, "Conducting video consultations and managing patient care", "HTTPS/WebRTC (DTLS-SRTP, adaptive bitrate)")
Rel(Auditors, Cross-Border Telehealth Platform, "Accessing read-only audit logs", "HTTPS (IAM roles)")
Rel(Cross-Border Telehealth Platform, EU National E-Prescription Gateways, "Transmitting e-prescriptions", "secure APIs via mTLS and HL7 FHIR / REST")
Rel(Cross-Border Telehealth Platform, US Pharmacy Networks (Surescripts), "Transmitting e-prescriptions", "secure APIs via mTLS and HL7 FHIR / REST")
Rel(Cross-Border Telehealth Platform, Identity Providers (eIDAS / OAuth2/OIDC), "Authenticating users", "OIDC/OAuth2")
Rel(Cross-Border Telehealth Platform, Regional Payment & Insurance Gateways, "Processing payments and insurance claims", "HTTPS/REST with tokenization via GCP VPC Service Controls")

@enduml