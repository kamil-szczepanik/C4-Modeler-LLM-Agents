@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "End-users receiving video consultations, e-prescriptions, and using the AI symptom checker.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Healthcare professionals providing video consultations and issuing e-prescriptions to patients.")
Person(Compliance_Officers_Auditors, "Compliance Officers / Auditors", "Personnel responsible for auditing system logs and ensuring regulatory compliance.")

System_Ext(EU_National_EPrescription_Gateways, "EU National E-Prescription Gateways", "External EU gateways for managing and transmitting e-prescriptions.")
System_Ext(US_Pharmacy_Networks_Surescripts, "US Pharmacy Networks (Surescripts)", "External US pharmacy networks for processing prescriptions.")
System_Ext(Identity_Providers_eIDAS_OAuth2_OIDC, "Identity Providers (eIDAS / OAuth2/OIDC)", "External identity providers for secure authentication and identity verification.")
System_Ext(Regional_Payment_Insurance_Gateways, "Regional Payment & Insurance Gateways", "External gateways handling regional payments and insurance verification.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(Web_Application_Container, "Web Application Container", "React / Next.js", "Frontend web application serving patients and clinicians.")
    Container(API_Gateway_Container, "API Gateway Container", "Envoy / GCP API Gateway", "Manages and routes incoming API requests to internal microservices.")
    Container(Core_Services_Container, "Core Services Container", "Go / Node.js microservices", "Core business logic microservices for telehealth operations.")
    Container(AI_Symptom_Checker_Container, "AI Symptom Checker Container", "Python / FastAPI + Vertex AI", "Processes symptom inputs and generates traceable, versioned recommendations.")
    Container(Media_Relay_Container, "Media Relay Container", "Janus / WebRTC SFU", "Handles WebRTC media streaming for video consultations.")
    Container(EPrescription_Integration_Container, "E-Prescription Integration Container", "Java / Spring Boot", "Integrates with external e-prescription gateways and pharmacy networks.")
    ContainerDb(Databases, "Databases", "GCP Cloud SQL for PostgreSQL", "Relational database secured via CMEK for persistent data storage.")
}

Rel(Patients, Web_Application_Container, "Views and interacts with the platform", "HTTPS")
Rel(Licensed_Clinicians, Web_Application_Container, "Manages consultations and patient care", "HTTPS")
Rel(Web_Application_Container, API_Gateway_Container, "Sends API requests", "HTTPS / REST & GraphQL")
Rel(Patients, Media_Relay_Container, "Streams video consultations", "WebRTC / DTLS-SRTP, UDP")
Rel(Licensed_Clinicians, Media_Relay_Container, "Streams video consultations", "WebRTC / DTLS-SRTP, UDP")
Rel(API_Gateway_Container, Core_Services_Container, "Routes requests to core business logic", "gRPC over mTLS")
Rel(API_Gateway_Container, AI_Symptom_Checker_Container, "Routes symptom check requests", "gRPC over mTLS")
Rel(Core_Services_Container, EPrescription_Integration_Container, "Requests e-prescription processing", "gRPC over mTLS")
Rel(Core_Services_Container, Databases, "Reads and writes relational data", "TCP / SSL")
Rel(EPrescription_Integration_Container, EU_National_EPrescription_Gateways, "Transmits e-prescriptions", "HTTPS / mTLS / HL7 FHIR")
Rel(EPrescription_Integration_Container, US_Pharmacy_Networks_Surescripts, "Transmits e-prescriptions", "HTTPS / mTLS / HL7 FHIR")

@enduml