@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Media Relay Container container

Container_Boundary("Media Relay Container", "Media Relay Container") {
    Component("SFU Core Engine", "SFU Core Engine", "Janus / WebRTC SFU", "Handles media stream routing, multiplexing, and WebRTC signaling for video consultations.")
    Component("Adaptive Bitrate Controller", "Adaptive Bitrate Controller", "C++ / Janus Plugin", "Monitors network conditions and dynamically adjusts video bitrate for degraded network modes (< 300 kbit/s).")
    Component("DTLS-SRTP Security Module", "DTLS-SRTP Security Module", "OpenSSL / WebRTC", "Encrypts media streams and secures peer-to-peer transport channels.")
}

Rel("Adaptive Bitrate Controller", "SFU Core Engine", "Adjusts stream quality parameters", "")
Rel("SFU Core Engine", "DTLS-SRTP Security Module", "Secures media packets via encryption", "")

@enduml