@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(ai_symptom_checker_container, "AI Symptom Checker Container") {
    Component(Symptom Router, "Symptom Router", "Python / FastAPI Router", "Handles incoming gRPC requests over mTLS and routes symptom triage payloads.")
    Component(Triage Engine, "Triage Engine", "Python / Asyncio", "Processes symptom inputs asynchronously for high-performance recommendation generation.")
    Component(Vertex AI Integration Client, "Vertex AI Integration Client", "Python / GCP SDK via Private Service Connect", "Communicates securely with GCP Vertex AI to fetch managed AI triage recommendations.")
}

Rel(Symptom Router, Triage Engine, "Forwards structured triage requests")
Rel(Triage Engine, Vertex AI Integration Client, "Invokes managed AI models")
@enduml