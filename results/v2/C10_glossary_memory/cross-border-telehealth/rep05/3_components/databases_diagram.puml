@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Databases container

Container_Boundary(databases, "Databases") {
    Component(PostgreSQL_Database_Engine, "PostgreSQL Database Engine", "GCP Cloud SQL for PostgreSQL", "Multi-region relational persistence for telehealth records, patient data, and transactional integrity.")
    Component(CMEK_Encryption_Manager, "CMEK Encryption Manager", "GCP Cloud KMS", "Manages Customer-Managed Encryption Keys with annual rotation for data-at-rest security.")
}

Rel(PostgreSQL_Database_Engine, CMEK_Encryption_Manager, "Secured by")

@enduml