@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Core Services Container", "Core Services Container") {
    Component(TelehealthCoreAPIController, "Telehealth Core API Controller", "Go / Node.js REST & gRPC handler", "Handles incoming API requests from the API Gateway, enforcing business workflows for video consultations and user management.")
    Component(AppointmentConsultationService, "Appointment & Consultation Service", "Go / Node.js business logic module", "Manages scheduling, session states, and coordination for cross-border video consultations between patients and clinicians.")
    Component(PrescriptionOrchestrator, "Prescription Orchestrator", "Go / Node.js orchestration module", "Coordinates e-prescription workflows by dispatching requests to the E-Prescription Integration Container.")
    Component(DataAccessRepository, "Data Access Repository", "Go / Node.js database connector (TCP/SSL)", "Manages secure data persistence and retrieval interacting with GCP Cloud SQL for PostgreSQL.")
}

Rel(TelehealthCoreAPIController, AppointmentConsultationService, "Delegates appointment and consultation requests", "")
Rel(TelehealthCoreAPIController, PrescriptionOrchestrator, "Delegates prescription handling workflows", "")
Rel(AppointmentConsultationService, DataAccessRepository, "Reads and writes consultation state data", "TCP / SSL")
Rel(PrescriptionOrchestrator, DataAccessRepository, "Reads and writes prescription tracking records", "TCP / SSL")

@enduml