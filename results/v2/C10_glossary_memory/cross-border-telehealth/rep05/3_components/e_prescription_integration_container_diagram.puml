@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(eprescription_integration, "E-Prescription Integration Container") {
    Component(Prescription Gateway Controller, "Prescription Gateway Controller", "Spring MVC / REST", "Exposes REST endpoints for receiving e-prescription requests from core microservices.")
    Component(Prescription Orchestrator Service, "Prescription Orchestrator Service", "Spring Service / Business Logic", "Manages business logic, data mapping, and routing for international prescriptions.")
    Component(EU Gateway Client, "EU Gateway Client", "Spring Cloud OpenFeign / HL7 FHIR", "Integrates securely with EU National E-Prescription Gateways via mTLS.")
    Component(US Pharmacy Client, "US Pharmacy Client", "Spring Cloud OpenFeign / HL7 FHIR", "Integrates securely with US Pharmacy Networks (Surescripts) via mTLS.")
    Component(Resilience Handler, "Resilience Handler", "Resilience4j", "Provides circuit breaking, retries, and fault tolerance for external network calls.")
}

Rel(Prescription Gateway Controller, Prescription Orchestrator Service, "Delegates requests")
Rel(Prescription Orchestrator Service, EU Gateway Client, "Dispatches EU prescriptions")
Rel(Prescription Orchestrator Service, US Pharmacy Client, "Dispatches US prescriptions")
Rel(EU Gateway Client, Resilience Handler, "Wraps external calls with fault tolerance")
Rel(US Pharmacy Client, Resilience Handler, "Wraps external calls with fault tolerance")
@enduml