@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application Container container

Container_Boundary(web_application_container_boundary, "Web Application Container") {
    Component(Web UI Router, "Web UI Router", "Next.js Pages/App Router", "Manages client-side routing, page rendering strategies (SSR/SSG), and initial view composition for patients and clinicians.")
    Component(Authentication Client, "Authentication Client", "OAuth2 / OIDC SDK", "Handles user login, token management, and integration with external Identity Providers (eIDAS / OAuth2/OIDC).")
    Component(Telehealth Video Interface, "Telehealth Video Interface", "WebRTC Client / React Components", "Renders real-time video consultation views and manages streaming sessions interfacing with the Media Relay Container.")
    Component(API Service Client, "API Service Client", "GraphQL / REST Client (Axios/Apollo)", "Communicates securely via HTTPS with the API Gateway Container to fetch and update application data.")
}

System_Ext(API Gateway Container, "API Gateway Container", "Envoy / GCP API Gateway")
System_Ext(Media Relay Container, "Media Relay Container", "Janus / WebRTC SFU")

Rel(Web UI Router, Authentication Client, "Authenticates users", "")
Rel(Web UI Router, Telehealth Video Interface, "Loads video consultation views", "")
Rel(Web UI Router, API Service Client, "Requests business data and mutations", "")
Rel(API Service Client, API Gateway Container, "Sends HTTPS / REST & GraphQL requests", "HTTPS")
Rel(Telehealth Video Interface, Media Relay Container, "Establishes WebRTC / DTLS-SRTP, UDP connections", "WebRTC / DTLS-SRTP, UDP")

@enduml