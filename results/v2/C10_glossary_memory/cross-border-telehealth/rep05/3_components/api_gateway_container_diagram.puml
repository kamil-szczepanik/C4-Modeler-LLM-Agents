@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway Container") {
    Component(rate_limiting, "Rate Limiting Component", "Envoy WASM/Lua filter", "Enforces rate limits on incoming API requests to prevent abuse.")
    Component(geo_router, "Geo-Router Component", "Envoy routing filter", "Routes regional traffic to isolate workloads in appropriate data centers.")
    Component(auth_token, "Auth & Token Introspection Component", "Envoy OIDC/OAuth2 filter", "Validates security tokens and integrates with identity providers.")
    Component(upstream_proxy, "Upstream Proxy Component", "Envoy proxy cluster", "Proxies and balances traffic to upstream microservices.")
}

Rel(rate_limiting, upstream_proxy, "Inspects and passes allowed requests")
Rel(geo_router, upstream_proxy, "Directs traffic to regional endpoints")
Rel(auth_token, rate_limiting, "Authenticates requests before rate limiting")

@enduml