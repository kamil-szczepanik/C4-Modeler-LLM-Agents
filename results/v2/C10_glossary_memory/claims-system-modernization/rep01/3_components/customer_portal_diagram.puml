@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(customer_portal, "Customer Portal") {
    Component(Claim Submission Controller, "Claim Submission Controller", "Next.js API Route / TypeScript", "Handles incoming online claim submissions and validation from customers and brokers.")
    Component(Broker Dashboard Service, "Broker Dashboard Service", "React / TypeScript", "Provides customer-facing interactions, submission tracking, and broker dashboards.")
    Component(Authentication Client, "Authentication Client", "NextAuth.js", "Manages OpenID Connect / OAuth 2.0 authentication flow with Azure AD.")
}

Rel(Claim Submission Controller, Broker Dashboard Service, "Updates UI state")
Rel(Authentication Client, Claim Submission Controller, "Provides security context")
@enduml