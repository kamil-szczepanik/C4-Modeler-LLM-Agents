@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(integration_gateway, "Integration Gateway / ACL") {
    Component(Message_Translator, "Message Translator", "Azure Container Apps / .NET Core", "Translates modern JSON/REST messages into legacy COBOL copybook formats for mainframe consumption.")
    Component(Mainframe_Adapter, "Mainframe Adapter", "Azure Container Apps / ESB Client", "Manages secure, hybrid ESB/MQ connections with the on-premise Legacy Mainframe.")
}

Rel(Message_Translator, Mainframe_Adapter, "Forwards translated legacy messages")

@enduml