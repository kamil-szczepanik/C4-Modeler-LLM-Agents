@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application container

Container_Boundary(web_application, "Web Application") {
    Component(Web UI Router & BFF Controller, "Web UI Router & BFF Controller", "Next.js & React / TypeScript", "Handles server-side rendering, routing, and BFF logic for adjuster and customer web interfaces.")
    Component(Authentication Client, "Authentication Client", "OpenID Connect / OAuth 2.0 SDK", "Manages user authentication and token exchange with Azure AD (Entra ID).")
    Component(API Gateway Proxy, "API Gateway Proxy", "TypeScript / Axios with mTLS", "Forwards backend queries and operations to the Claim Processing API securely.")
}

System_Ext(Claim Processing API, "Claim Processing API", "Azure Container Apps")

Rel(Web UI Router & BFF Controller, Authentication Client, "Authenticates users", "OpenID Connect / OAuth 2.0")
Rel(Web UI Router & BFF Controller, API Gateway Proxy, "Forwards queries and operations", "Internal")
Rel(API Gateway Proxy, Claim Processing API, "Sends backend operations via HTTPS with mTLS", "HTTPS / mTLS")
@enduml