@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claim Processing API container

Container_Boundary(claim_processing_api, "Claim Processing API") {
    Component(ClaimOrchestratorComponent, "Claim Orchestrator Component", ".NET 8 / MediatR", "Handles core business logic for processing claims and orchestrating workflows.")
    Component(PaymentNotificationCoordinatorComponent, "Payment & Notification Coordinator Component", ".NET 8 / HTTP Client", "Coordinates payments and notifications with external systems.")
    Component(MigrationRoutingClientComponent, "Migration & Routing Client Component", ".NET 8 / gRPC Client", "Client component for interacting with the migration router.")
    Component(DataPersistenceComponent, "Data Persistence Component", ".NET 8 / Azure Cosmos DB SDK", "Manages data persistence operations against Azure Cosmos DB.")
}

Component_Ext(FeatureFlagMigrationRouter, "Feature Flag / Migration Router", "Azure Container Apps", "Routes requests dynamically to support the 3-year transition strategy.")
Component_Ext(PaymentGateway, "Payment Gateway", "External system", "External financial system for automated claim payouts.")
Component_Ext(CoreNotificationService, "Core Notification Service", "External system", "External system for automated SMS/email updates.")
Component_Ext(DocumentAuditStore, "Document & Audit Store", "Azure Blob Storage & Azure Cosmos DB", "Provides secure, cloud-native document and audit data storage.")

Rel(ClaimOrchestratorComponent, MigrationRoutingClientComponent, "In-memory MediatR dispatch")
Rel(MigrationRoutingClientComponent, FeatureFlagMigrationRouter, "Internal gRPC")
Rel(PaymentNotificationCoordinatorComponent, PaymentGateway, "HTTPS with OAuth 2.0 and idempotency tokens")
Rel(PaymentNotificationCoordinatorComponent, CoreNotificationService, "Asynchronous Webhooks via Azure Event Grid (HTTPS)")
Rel(DataPersistenceComponent, DocumentAuditStore, "HTTPS / TLS 1.3 via Azure Cosmos DB SDK")

@enduml