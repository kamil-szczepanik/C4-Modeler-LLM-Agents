@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Feature_Flag_Migration_Router", "Feature Flag / Migration Router") {
    Component(Router_Controller, "Router Controller", "Azure Container Apps / ASP.NET Core", "Handles incoming routing requests and evaluates migration paths for claims.")
    Component(Feature_Flag_Evaluator, "Feature Flag Evaluator", "Azure App Configuration SDK", "Queries feature flags and rules to determine legacy vs modern processing.")
}

Rel(Router_Controller, Feature_Flag_Evaluator, "Evaluates flags", "")
@enduml