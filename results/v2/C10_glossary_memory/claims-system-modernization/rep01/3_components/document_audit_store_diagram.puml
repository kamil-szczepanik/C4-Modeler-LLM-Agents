@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(ClaimProcessingApi, "Claim Processing API", "Azure Container Apps")

Container_Boundary(DocumentAuditStore, "Document & Audit Store") {
    Component(DocumentRepository, "Document Repository", "Azure Blob Storage with WORM and Azure Key Vault CMK", "Azure Blob Storage with WORM and Azure Key Vault CMK")
    Component(AuditLedger, "Audit Ledger", "Azure Cosmos DB SQL API with change feed", "Azure Cosmos DB SQL API with change feed")
    Component(ReconciliationSyncService, "Reconciliation & Sync Service", "Azure Container Apps with Azure Service Bus", "Azure Container Apps with Azure Service Bus")
}

Rel(ClaimProcessingApi, DocumentRepository, "Uploads and retrieves binary assets", "HTTPS / TLS 1.3 (Azure SDK)")
Rel(ClaimProcessingApi, AuditLedger, "Writes transaction and event logs", "HTTPS / TLS 1.3 (Azure SDK)")
Rel(ClaimProcessingApi, ReconciliationSyncService, "Triggers asynchronous reconciliation tasks", "Azure Service Bus / AMQP")
Rel(ReconciliationSyncService, AuditLedger, "Reads/writes state logs", "HTTPS / TLS 1.3 (Azure SDK)")
Rel(ReconciliationSyncService, DocumentRepository, "Archives/verifies document states", "HTTPS / TLS 1.3 (Azure SDK)")

@enduml