@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers_Brokers, "Customers & Brokers", "External users performing online claim submissions.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal users handling claims via the new web application.")

System(Insurance_Claims_Modernization_platform, "Insurance Claims Modernization platform", "A hybrid cloud-native platform gradually replacing an on-premise mainframe system while ensuring continuous, zero-loss claim processing during a 3-year transition.")

System_Ext(Legacy_Mainframe, "Legacy Mainframe", "On-premise COBOL/DB2 system of record with a 3-year retention constraint.")
System_Ext(Azure_AD_Entra_ID, "Azure AD (Entra ID)", "Identity provider for Single Sign-On and RBAC.")
System_Ext(Payment_Gateway, "Payment Gateway", "External financial system for automated claim payouts.")
System_Ext(Core_Notification_Service, "Core Notification Service", "External system for automated SMS/email updates.")
System_Ext(Enterprise_Service_Bus_ESBMQ, "Enterprise Service Bus (ESB/MQ)", "Hybrid messaging intermediary for asynchronous decoupling.")

Rel(Customers_Brokers, Insurance_Claims_Modernization_platform, "Submit online claims", "HTTPS (REST/GraphQL)")
Rel(Claims_Adjusters, Insurance_Claims_Modernization_platform, "Handle claims via web application UI", "HTTPS")
Rel(Insurance_Claims_Modernization_platform, Legacy_Mainframe, "Asynchronous data synchronization and queue transfers", "ESB/MQ")
Rel(Insurance_Claims_Modernization_platform, Azure_AD_Entra_ID, "Authenticate users and authorize access", "OpenID Connect / OAuth 2.0 via HTTPS")
Rel(Insurance_Claims_Modernization_platform, Payment_Gateway, "Process automated claim payouts with idempotency tokens", "HTTPS (REST with OAuth 2.0)")
Rel(Insurance_Claims_Modernization_platform, Core_Notification_Service, "Send automated SMS and email updates", "Asynchronous Webhooks via Azure Event Grid (HTTPS)")
@enduml