@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Modern Claims Platform

Person(EndCustomersandBrokers, "End Customers and Brokers", "Web users who submit and manage claims.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal web users responsible for claim handling.")

System(ModernClaimsPlatform, "Modern Claims Platform", "A cloud-based web application modernizing a regional insurer's legacy COBOL/DB2 mainframe claims platform for customers and adjusters, ensuring business continuity via a hybrid architecture.")

System_Ext(LegacyMainframeSystem, "Legacy Mainframe System", "On-premises DB2/COBOL system of record for legacy claims data.")
System_Ext(CorporateActiveDirectoryEntraID, "Corporate Active Directory / Entra ID", "Identity Provider used for user authentication.")
System_Ext(IntegrationMiddlewareAPIGateway, "Integration Middleware / API Gateway", "Azure Service Bus and Azure Functions facilitating integration and secure messaging.")

Rel(EndCustomersandBrokers, ModernClaimsPlatform, "Interact for claim submission", "HTTPS/REST")
Rel(ClaimsAdjusters, ModernClaimsPlatform, "Interact for claim handling", "HTTPS/REST")
Rel(ModernClaimsPlatform, CorporateActiveDirectoryEntraID, "Authenticates users", "OIDC/SAML")
Rel(ModernClaimsPlatform, LegacyMainframeSystem, "Synchronizes data with legacy system", "Secure message queues and APIs over hybrid IPsec VPN/ExpressRoute with mTLS")
Rel(ModernClaimsPlatform, IntegrationMiddlewareAPIGateway, "Processes integration logic and asynchronous messaging", "Azure Service Bus / Azure Functions")

@enduml