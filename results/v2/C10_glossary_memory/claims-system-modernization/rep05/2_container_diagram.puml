@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(End Customers and Brokers, "End Customers and Brokers", "Web users who submit and manage claims.")
Person(Claims Adjusters, "Claims Adjusters", "Internal web users responsible for claim handling.")
Person(Migration Operations Managers, "Migration Operations Managers", "Internal users managing claim type migration and dashboard operations.")

System_Ext(Legacy Mainframe System, "Legacy Mainframe System", "On-premises DB2/COBOL system of record for legacy claims data.")
System_Ext(Corporate Active Directory / Entra ID, "Corporate Active Directory / Entra ID", "Identity Provider used for user authentication.")
System_Ext(Integration Middleware / API Gateway, "Integration Middleware / API Gateway", "Azure Service Bus and Azure Functions facilitating integration and secure messaging.")

System_Boundary(Modern Claims Platform, "Modern Claims Platform") {
    Container(Customer Web Portal, "Customer Web Portal", "SPA/React", "Web portal allowing end customers and brokers to submit and manage claims.")
    Container(Adjuster Web Application, "Adjuster Web Application", "Modular Monolith/.NET", "Web application used by claims adjusters for claim handling.")
    Container(Migration Operations Dashboard, "Migration Operations Dashboard", "Web App/.NET", "Dashboard for migration operations managers to oversee gradual claim type migration.")
    Container(Claims Core API Service, "Claims Core API Service", "Modular Monolith/.NET", "Core API service handling business logic and data processing.")
    Container(Claim Router & Integration Worker, "Claim Router & Integration Worker", ".NET Worker Service", "Asynchronous worker service for routing claims and integrating with the legacy mainframe.")
    Container(Azure Service Bus, "Azure Service Bus", "Azure Messaging Service", "Manages messaging, backpressure, dead-letter queues, and rate-limiting.")
}

Rel(End Customers and Brokers, Customer Web Portal, "Submit and manage claims", "HTTPS/REST")
Rel(Claims Adjusters, Adjuster Web Application, "Handle claims", "HTTPS/REST")
Rel(Migration Operations Managers, Migration Operations Dashboard, "Monitor migration operations", "HTTPS/REST")
Rel(Customer Web Portal, Corporate Active Directory / Entra ID, "Authenticates users", "OIDC/SAML")
Rel(Adjuster Web Application, Corporate Active Directory / Entra ID, "Authenticates users", "OIDC/SAML")
Rel(Migration Operations Dashboard, Corporate Active Directory / Entra ID, "Authenticates users", "OIDC/SAML")
Rel(Claim Router & Integration Worker, Legacy Mainframe System, "Routes claims and synchronizes data", "mTLS/VPN and signed JWT")
Rel(Claims Core API Service, Azure Service Bus, "Sends and receives asynchronous messages", "AMQP")
@enduml