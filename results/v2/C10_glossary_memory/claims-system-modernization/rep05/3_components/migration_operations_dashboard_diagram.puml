@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(migration_operations_dashboard, "Migration Operations Dashboard") {
    Component(Migration_Dashboard_UI, "Migration Dashboard UI", "ASP.NET Core Razor Pages / Blazor", "Provides the web interface for migration operations managers to oversee and control the gradual claim-type migration process.")
    Component(Migration_Control_API, "Migration Control API", "ASP.NET Core Web API", "Exposes secure endpoints for managing migration states, feature flags, and viewing audit logs.")
    Component(Migration_Audit_Service, "Migration Audit Service", ".NET Class Library", "Handles tracking, validation, and reporting of claim migration progress and rollback operations.")
}

Rel(Migration_Dashboard_UI, Migration_Control_API, "Calls REST endpoints for status and control actions", "HTTPS/REST, JWT")
Rel(Migration_Control_API, Migration_Audit_Service, "Invokes business logic for tracking and auditing migration events")

@enduml