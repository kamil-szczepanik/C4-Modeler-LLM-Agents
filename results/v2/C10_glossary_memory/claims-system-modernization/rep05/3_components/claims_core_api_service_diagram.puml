@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Core API Service container

System_Ext(AzureServiceBus, "Azure Service Bus", "Azure Messaging Service", "Manages asynchronous messaging, backpressure, and dead-letter queues.")

Container_Boundary(ClaimsCoreAPIService, "Claims Core API Service") {
    Component(ClaimSubmissionController, "Claim Submission Controller", ".NET Controller", "Handles incoming HTTP/REST requests for claim submissions from the client applications.")
    Component(ClaimsDomainService, "Claims Domain Service", ".NET Modular Monolith Service", "Encapsulates core business logic, validation, and orchestration for claims processing.")
    Component(ClaimDataAccessRepository, "Claim Data Access Repository", "Entity Framework Core / Azure SQL", "Manages local read models and persistence for sub-2-second adjuster response times.")
    Component(MessagingPublisher, "Messaging Publisher", ".NET Client Library / AMQP", "Publishes asynchronous integration events and messages to Azure Service Bus.")
}

Rel(ClaimSubmissionController, ClaimsDomainService, "Invokes business logic")
Rel(ClaimsDomainService, ClaimDataAccessRepository, "Reads and writes claim data")
Rel(ClaimsDomainService, MessagingPublisher, "Triggers asynchronous events")
Rel(MessagingPublisher, AzureServiceBus, "Publishes messages", "AMQP")
@enduml