@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(End_Customers_and_Brokers, "End Customers and Brokers", "Web users who submit and manage claims.")
System_Ext(Corporate_Active_Directory___Entra_ID, "Corporate Active Directory / Entra ID", "Identity Provider used for user authentication.")
System_Ext(Claims_Core_API_Service, "Claims Core API Service", "Core API service handling business logic and data processing via BFF.")
System_Ext(Azure_Application_Insights, "Azure Application Insights", "Provides real user monitoring (RUM) and synthetic transaction logging.")

Container_Boundary(Customer_Web_Portal, "Customer Web Portal") {
    Component(Authentication_Component, "Authentication Component", "TypeScript / MSAL.js", "Implements authentication flows with OIDC/SAML protocols, securing user sessions via a BFF pattern.")
    Component(Claim_Submission_Form_Component, "Claim Submission Form Component", "React / Formik", "Provides dynamic UI for users to input and submit claim payloads.")
    Component(Claim_Status___Dashboard_Component, "Claim Status & Dashboard Component", "React", "Displays claim statuses and dashboard metrics, adapting dynamically to support gradual claim type migrations.")
    Component(API_Gateway_Client_Component, "API Gateway Client Component", "Axios / Fetch", "Handles outbound HTTP/REST requests to backend services.")
    Component(Resilience___Fallback_Component, "Resilience & Fallback Component", "TypeScript / React", "Ensures UI resilience and handles fallback states during errors or latency.")
}

Rel(End_Customers_and_Brokers, Customer_Web_Portal, "Accesses portal UI", "HTTPS/REST")
Rel(Customer_Web_Portal, Corporate_Active_Directory___Entra_ID, "Authenticates users", "OIDC/SAML")
Rel(Claim_Submission_Form_Component, API_Gateway_Client_Component, "Sends claim payload", "HTTPS/REST")
Rel(API_Gateway_Client_Component, Azure_Application_Insights, "Tracks frontend performance and errors", "RUM/Telemetry")
Rel(Customer_Web_Portal, Claims_Core_API_Service, "Submits and retrieves claim data via BFF", "HTTPS/REST")
@enduml