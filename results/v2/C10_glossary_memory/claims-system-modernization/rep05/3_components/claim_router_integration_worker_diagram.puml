@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(claim_router_integration_worker, "Claim Router & Integration Worker") {
    Component(RoutingEngineComponent, "Routing Engine Component", ".NET class library", "Handles dynamic routing rules and claim type migration logic.")
    Component(MainframeAdapterComponent, "Mainframe Adapter Component", ".NET HttpClient/gRPC", "Interfaces with the legacy mainframe system using secure mTLS and signed JWT.")
    Component(OutboxProcessorComponent, "Outbox Processor Component", ".NET Hosted Service", "Ensures zero data loss and supports rapid rollbacks through an outbox pattern.")
    Component(AuditTelemetryComponent, "Audit & Telemetry Component", "Application Insights", "Provides monitoring and telemetry for the integration worker.")
}

Container(AzureServiceBus, "Azure Service Bus", "Azure Messaging Service", "Manages messaging, backpressure, and reliable queueing to prevent duplicate or lost claims.")
Container(LegacyMainframeSystem, "Legacy Mainframe System", "On-premises DB2/COBOL", "System of record for legacy claims data.")
Container(AzureKeyVault, "Azure Key Vault", "Secret Management", "Secures sensitive mTLS certificates and signing keys using managed identities.")
Container(ClaimsCoreAPIService, "Claims Core API Service", "Modular Monolith/.NET", "Core API service handling business logic and data processing.")

Rel(claim_router_integration_worker, AzureServiceBus, "AMQP", "")
Rel(claim_router_integration_worker, LegacyMainframeSystem, "mTLS and signed JWT over hybrid IPsec VPN", "")
Rel(claim_router_integration_worker, AzureKeyVault, "HTTPS/Managed Identity", "")
Rel(RoutingEngineComponent, ClaimsCoreAPIService, "HTTPS/SQL", "")

@enduml