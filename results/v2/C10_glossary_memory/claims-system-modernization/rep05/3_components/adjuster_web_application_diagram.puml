@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(ClaimsAdjusters, "Claims Adjusters", "Internal web users responsible for claim handling.")
System_Ext(CorporateActiveDirectoryEntraID, "Corporate Active Directory / Entra ID", "Identity Provider used for user authentication.")
System_Ext(ClaimsCoreAPIService, "Claims Core API Service", "Core API service handling business logic and data processing.")

Container_Boundary(AdjusterWebApplication, "Adjuster Web Application") {
    Component(AdjusterUI, "Adjuster UI", "SPA/React", "Provides responsive adjuster screens with optimistic updates.")
    Component(ClaimHandlingAPI, "Claim Handling API", "ASP.NET Core", "Powers the modular monolith backend API.")
    Component(ClaimContextRoutingComponent, "Claim Context & Routing Component", ".NET Component", "Evaluates routing and feature flags for rapid claim type rollbacks.")
    Component(MainframeAbstractionLayer, "Mainframe Abstraction Layer", ".NET Component", "Fetches fallback data and insulates user screens from slow legacy mainframe responses.")
}

Rel(ClaimsAdjusters, AdjusterUI, "Manage claims", "HTTPS/REST")
Rel(AdjusterUI, ClaimHandlingAPI, "Invoke workflows", "HTTPS/REST")
Rel(ClaimHandlingAPI, ClaimContextRoutingComponent, "Evaluate routing", "In-Memory")
Rel(ClaimContextRoutingComponent, MainframeAbstractionLayer, "Fetch fallback data", "In-Memory")
Rel(ClaimHandlingAPI, CorporateActiveDirectoryEntraID, "Authenticate users", "OIDC/OAuth 2.0")

@enduml