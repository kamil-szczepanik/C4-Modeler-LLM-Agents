@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers, "Customers", "External users submitting claims online.")
Person(Brokers, "Brokers", "External users submitting claims on behalf of customers.")
Person("Claims Adjusters", "Claims Adjusters", "Internal users managing and processing claims via the new web application.")

System(NewInsuranceClaimsPlatform, "New Insurance Claims Platform", "Modern cloud-native claims processing platform built on Azure West Europe, replacing legacy components while maintaining continuity through a hybrid migration approach.")

System_Ext("Legacy Mainframe", "Legacy Mainframe", "On-premise COBOL/DB2 system of record operating under a 3-year constraint.")
System_Ext("Identity Provider", "Identity Provider", "Corporate Active Directory / Azure AD providing authentication services.")
System_Ext("Notification Service", "Notification Service", "SendGrid/Twilio external SMS/email provider for sending notifications.")

Rel(Customers, NewInsuranceClaimsPlatform, "Submit claims online", "HTTPS/WSS")
Rel(Brokers, NewInsuranceClaimsPlatform, "Submit claims online", "HTTPS/WSS")
Rel("Claims Adjusters", NewInsuranceClaimsPlatform, "Manage claims via the web application", "HTTPS/WSS")
Rel(NewInsuranceClaimsPlatform, "Identity Provider", "Authenticates users", "OpenID Connect / OAuth 2.0")
Rel(NewInsuranceClaimsPlatform, "Legacy Mainframe", "Synchronizes data and protects batch window", "Azure Service Bus over Azure ExpressRoute/VPN")
Rel(NewInsuranceClaimsPlatform, "Notification Service", "Sends SMS and email notifications", "HTTPS REST API")

@enduml