@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for New Insurance Claims Platform

Person(Customers, "Customers", "External users submitting claims online.")
Person(Brokers, "Brokers", "External users submitting claims on behalf of customers.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal users managing and processing claims via the new web application.")

System_Ext(LegacyMainframe, "Legacy Mainframe", "On-premise COBOL/DB2 system of record operating under a 3-year constraint.")
System_Ext(IdentityProvider, "Identity Provider", "Corporate Active Directory / Azure AD providing authentication services.")
System_Ext(NotificationService, "Notification Service", "SendGrid/Twilio external SMS/email provider for sending notifications.")

System_Boundary(NewInsuranceClaimsPlatform, "New Insurance Claims Platform") {
    Container(CustomerPortalSPA, "Customer Portal SPA", "Azure Static Web Apps, React/TypeScript", "Hosts the React/TypeScript Customer Portal SPA.")
    Container(APIGateway, "API Gateway", "Azure API Management", "Enforces rate limiting, OAuth 2.0 token validation, and circuit breaking toward the mainframe.")
    Container(ClaimsProcessingCoreBFF, "Claims Processing Core & BFF", "Azure Kubernetes Service", "Standardizes backend compute for claims processing and BFF to minimize operational overhead.")
    Container(RoutingReconciliationService, "Routing & Reconciliation Service", "Azure Kubernetes Service + Azure Cosmos DB", "Tracks claims state and reconciliation data for zero-loss guarantees and rapid fallbacks.")
}

Rel(Customers, CustomerPortalSPA, "Accesses portal to submit and manage claims", "HTTPS/WSS")
Rel(Brokers, CustomerPortalSPA, "Accesses portal to submit claims on behalf of customers", "HTTPS/WSS")
Rel(ClaimsAdjusters, CustomerPortalSPA, "Accesses portal to manage and process claims", "HTTPS/WSS")
Rel(CustomerPortalSPA, APIGateway, "Sends API requests", "HTTPS REST/GraphQL")
Rel(APIGateway, ClaimsProcessingCoreBFF, "Forwards requests to backend services", "HTTPS / mTLS")
Rel(ClaimsProcessingCoreBFF, RoutingReconciliationService, "Coordinates routing and reconciliation", "Internal gRPC/REST")
Rel(RoutingReconciliationService, LegacyMainframe, "Synchronizes data and protects batch window", "Azure Service Bus over Azure ExpressRoute/VPN")
Rel(CustomerPortalSPA, IdentityProvider, "Authenticates users", "OpenID Connect / OAuth 2.0")
Rel(ClaimsProcessingCoreBFF, NotificationService, "Sends SMS and email notifications", "HTTPS REST API")

@enduml