@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Processing Core & BFF

Container_Boundary("Claims Processing Core & BFF", "Claims Processing Core & BFF") {
    Component("Claims BFF Controller", "Claims BFF Controller", ".NET 8 Web API", "Handles frontend requests from the API Gateway, optimizing payloads and exposing REST/GraphQL endpoints for the Customer Portal SPA.")
    Component("Claims Processing Engine", "Claims Processing Engine", ".NET 8 Worker Service", "Executes core business logic and workflows for processing insurance claims within Azure Kubernetes Service.")
    Component("Notification Client", "Notification Client", ".NET 8 HTTP Client", "Integrates with the external Notification Service to send SMS and email alerts via SendGrid/Twilio.")
    Component("Routing & Reconciliation Client", "Routing & Reconciliation Client", ".NET 8 gRPC Client", "Communicates securely with the Routing & Reconciliation Service using internal gRPC over TLS 1.3.")
}

Rel("Claims BFF Controller", "Claims Processing Engine", "Delegates claims processing workflows")
Rel("Claims Processing Engine", "Notification Client", "Triggers notifications", "HTTPS REST API")
Rel("Claims Processing Engine", "Routing & Reconciliation Client", "Synchronizes claim state and routing data", "gRPC over TLS 1.3")

@enduml