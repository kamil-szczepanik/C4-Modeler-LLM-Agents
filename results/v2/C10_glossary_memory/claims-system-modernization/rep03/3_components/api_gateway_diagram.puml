@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(Rate_Limiting_Module, "Rate Limiting Module", "Azure API Management Policy", "Enforces rate limiting to protect backend services from excessive traffic.")
    Component(JWT_Validation_Module, "JWT Validation Module", "Azure API Management / JWKS", "Validates OAuth 2.0 JSON Web Tokens for incoming requests.")
    Component(WAF_Security_Module, "WAF & Security Module", "Azure Web Application Firewall", "Inspects traffic for common web vulnerabilities and enforces security policies.")
    Component(Error_Mapping_Module, "Error Mapping Module", "Azure API Management Policy", "Maps backend errors to RFC 7807 standard problem details.")
}

Rel(Rate_Limiting_Module, JWT_Validation_Module, "Passes filtered requests for token validation")
Rel(JWT_Validation_Module, WAF_Security_Module, "Forwards authenticated traffic to security inspection")
Rel(WAF_Security_Module, Error_Mapping_Module, "Routes processed requests and handles formatting errors")

@enduml