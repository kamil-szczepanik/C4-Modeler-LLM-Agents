@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Customer Portal SPA", "Customer Portal SPA") {
    Component("Customer Portal UI", "Customer Portal UI", "React, TypeScript, Azure Static Web Apps", "Provides the user interface for customers and brokers to submit and track insurance claims.")
    Component("Authentication Client", "Authentication Client", "OpenID Connect / OAuth 2.0 Client", "Handles user authentication and token management with the Identity Provider.")
    Component("API Integration Client", "API Integration Client", "HTTPS REST/GraphQL Client", "Communicates securely with the API Gateway for claim submissions and status updates.")
}

System_Ext("API Gateway", "API Gateway", "Azure API Management")

Rel("Customer Portal UI", "Authentication Client", "Authenticates users via", "")
Rel("Customer Portal UI", "API Integration Client", "Sends API requests via", "")
Rel("API Integration Client", "API Gateway", "Makes HTTPS REST/GraphQL calls to", "HTTPS REST/GraphQL")

@startuml