@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Routing & Reconciliation Service container

Container_Boundary(routing_reconciliation_service, "Routing & Reconciliation Service") {
    Component(ClaimRouterComponent, "Claim Router Component", "C# / .NET Core / gRPC", "Routes claims between services and handles gRPC communication.")
    Component(ReconciliationEngineComponent, "Reconciliation Engine Component", "C# / .NET Core Worker Service", "Executes reconciliation processes to ensure zero data loss.")
    Component(DLQManagerComponent, "DLQ Manager Component", "C# / .NET Core / Azure Service Bus SDK", "Manages dead-letter queues and failed message reprocessing.")
    Component(ReconciliationDashboardAPIComponent, "Reconciliation Dashboard API Component", "C# / .NET Core / ASP.NET Web API", "Provides APIs for the reconciliation dashboard.")
    Component(AuditStateStoreComponent, "Audit & State Store Component", "Azure Cosmos DB, SQL API", "Persists immutable transaction logs and state data.")
}

Rel(ClaimRouterComponent, AuditStateStoreComponent, "Persists state and transaction logs", "HTTPS / Cosmos DB SQL API")
Rel(ReconciliationEngineComponent, AuditStateStoreComponent, "Persists state and transaction logs", "HTTPS / Cosmos DB SQL API")
Rel(DLQManagerComponent, AuditStateStoreComponent, "Persists state and transaction logs", "HTTPS / Cosmos DB SQL API")
Rel(ReconciliationDashboardAPIComponent, AuditStateStoreComponent, "Reads/writes state data", "HTTPS / Cosmos DB SQL API")

@enduml