@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(CustomersAndBrokers, "Customers and Brokers", "External users who interact with the system to submit and manage claims.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal staff who review, process, and manage claims within the system.")
Person(OperationsAndSupportStaff, "Operations and Support Staff", "Staff responsible for monitoring system operations and providing user support.")
Person(FinanceAndAccounting, "Finance and Accounting", "Internal department responsible for financial reconciliation and reporting.")

System_Ext(LegacyMainframeSystem, "Legacy Mainframe System", "On-Premises COBOL/DB2 mainframe system acting as the system of record.")
System_Ext(EnterpriseIdentityProvider, "Enterprise Identity Provider", "Active Directory / Entra ID providing Single Sign-On (OIDC).")

System_Boundary(ModernClaimsPlatform, "Modern Claims Platform") {
    Container(WebFrontend, "Web Frontend", "React/TypeScript on Azure Static Web Apps", "Serves adjusters and customers with a responsive interface.")
    Container(ApiGatewayBff, "API Gateway / Backend-for-Frontend (BFF)", "Azure Container Apps (Node.js/Go)", "Implements API Gateway/BFF for caching and async orchestration.")
    Container(CoreClaimsService, "Core Claims Service", "Azure Container Apps (Java/Spring Boot or .NET)", "Hosts Core Claims Service domain logic.")
    Container(DataSyncEngine, "Data Sync Engine", "Azure Service Bus & Azure Functions", "Powers Data Sync Engine for reliable messaging.")
    ContainerDb(AzureSqlDatabase, "Azure SQL Database", "Azure SQL Database", "Acts as cloud system of record with Transparent Data Encryption (TDE).")
}

Rel(CustomersAndBrokers, WebFrontend, "Interacts with the platform to manage claims", "HTTPS/TLS (REST/GraphQL)")
Rel(ClaimsAdjusters, WebFrontend, "Processes and manages claims", "HTTPS/TLS (REST/GraphQL)")
Rel(OperationsAndSupportStaff, WebFrontend, "Supports and monitors the platform", "HTTPS/TLS (REST/GraphQL)")
Rel(FinanceAndAccounting, WebFrontend, "Receives financial feeds and reconciliation data", "SFTP / encrypted API feeds")
Rel(WebFrontend, ApiGatewayBff, "Sends API requests", "HTTPS/TLS (REST/GraphQL)")
Rel(WebFrontend, EnterpriseIdentityProvider, "Authenticates users for Single Sign-On", "OpenID Connect (OIDC)")
Rel(ApiGatewayBff, CoreClaimsService, "Forwards requests and orchestrates services", "HTTPS/TLS (gRPC/REST)")
Rel(CoreClaimsService, AzureSqlDatabase, "Reads and writes claim data", "TDS (Tabular Data Stream) with encryption")
Rel(DataSyncEngine, LegacyMainframeSystem, "Synchronizes claims data asynchronously", "Encrypted TCP/MQ with mTLS via Enterprise Service Bus")

@enduml