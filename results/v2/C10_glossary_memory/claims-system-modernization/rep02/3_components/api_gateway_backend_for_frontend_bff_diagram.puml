@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_bff, "API Gateway / Backend-for-Frontend (BFF)") {
    Component(api_router_and_gateway, "API Router and Gateway", "Azure Container Apps (Node.js/Go)", "Handles incoming client requests, request routing, and reverse proxying to downstream services.")
    Component(authentication_and_token_translation, "Authentication & Token Translation", "Azure Container Apps (Node.js/Go)", "Validates incoming tokens from the Enterprise Identity Provider and translates them for backend services.")
    Component(response_cache, "Response Cache", "Azure Container Apps (Node.js/Go)", "Provides caching layers to improve performance and reduce latency for frequent client requests.")
}

Rel(api_router_and_gateway, authentication_and_token_translation, "Validates security tokens for requests")
Rel(api_router_and_gateway, response_cache, "Retrieves and stores cached responses")
@enduml