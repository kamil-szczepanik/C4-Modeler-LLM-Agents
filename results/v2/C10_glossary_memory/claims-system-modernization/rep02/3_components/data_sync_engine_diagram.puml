@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Sync Engine container

Person(Operations and Support Staff, "Operations and Support Staff", "Staff responsible for monitoring system operations and providing user support.")

System_Ext(LegacyMainframeSystem, "Legacy Mainframe System", "On-Premises COBOL/DB2 mainframe system acting as the system of record.")
System_Ext(AzureMonitorApplicationInsights, "Azure Monitor / Application Insights", "Delivers native observability without custom UI maintenance overhead.")
System_Ext(AzureKeyVault, "Azure Key Vault", "Secures mTLS client certificates and encryption keys for compliance and security.")

Container_Boundary(DataSyncEngine, "Data Sync Engine") {
    Component(SyncIngestionFunction, "Sync Ingestion Function", "Azure Functions (.NET)", "Synchronizes claims between the cloud and the on-premises mainframe.")
    Component(MainframeAdapterComponent, "Mainframe Adapter Component", "Azure Functions (.NET)", "Adapts and interfaces with the legacy mainframe system.")
    Component(DeadLetterReconciliationHandler, "Dead-Letter & Reconciliation Handler", "Azure Functions (.NET)", "Handles dead-letter messages and reconciliation logic.")
    ComponentDb(IdempotencyStore, "Idempotency Store", "Azure SQL Database", "Powers the Idempotency Store for deduplication and exactly-once processing.")
}

Rel(SyncIngestionFunction, IdempotencyStore, "TDS (Tabular Data Stream) with encryption")
Rel(MainframeAdapterComponent, LegacyMainframeSystem, "Encrypted TCP/MQ with mTLS via Enterprise Service Bus")
Rel(DeadLetterReconciliationHandler, AzureMonitorApplicationInsights, "HTTPS/TLS (REST)")
Rel(MainframeAdapterComponent, AzureKeyVault, "HTTPS/TLS (REST)")

@enduml