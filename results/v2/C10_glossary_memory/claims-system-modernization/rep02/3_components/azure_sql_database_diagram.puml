@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(azure_sql_database, "Azure SQL Database") {
    Component(Claims Relational Tables, "Claims Relational Tables", "Azure SQL Database Tables", "Stores core claims data, policies, and participant details relational structures.")
    Component(Azure SQL Ledger Tables, "Azure SQL Ledger Tables", "Azure SQL Ledger", "Provides tamper-evident auditing and cryptographic verification for claims transactions.")
    Component(Change Tracking Engine, "Change Tracking Engine", "Azure SQL Change Tracking", "Monitors and records data modifications to support incremental synchronization with the Data Sync Engine.")
}

Rel(Claims Relational Tables, Azure SQL Ledger Tables, "Records immutable history of data modifications")
Rel(Claims Relational Tables, Change Tracking Engine, "Exposes changed rows for synchronization")

@enduml