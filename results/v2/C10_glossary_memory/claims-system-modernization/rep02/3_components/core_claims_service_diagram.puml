@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(core_claims_service, "Core Claims Service") {
    Component(claim_domain_controller, "Claim Domain Controller", "Java / Spring Boot or .NET", "Serves as the entry point for handling core claims requests within the Core Claims Service.")
    Component(claim_processing_engine, "Claim Processing Engine", "Java / Spring Boot or .NET", "Implements the core claims processing business logic and domain rules.")
    Component(mainframe_acl, "Mainframe Anti-Corruption Layer (ACL)", "Java / Spring Boot or .NET", "Translates and isolates interactions between the modern claims platform and the legacy mainframe system.")
    Component(outbox_event_publisher, "Outbox Event Publisher", "Java / Spring Boot or .NET", "Implements the Transactional Outbox pattern to reliably publish events to the messaging infrastructure.")
    Component(repository_data_access_component, "Repository / Data Access Component", "Spring Data JPA / Entity Framework", "Encapsulates persistence logic and data access operations for the Azure SQL Database.")
}

ContainerDb(azure_sql_database, "Azure SQL Database", "Azure SQL Database", "Acts as the cloud system of record using Transparent Data Encryption.")
Container(data_sync_engine, "Data Sync Engine", "Azure Service Bus & Azure Functions", "Powers Data Sync Engine for reliable messaging.")

Rel(claim_domain_controller, claim_processing_engine, "In-process method calls")
Rel(claim_processing_engine, mainframe_acl, "In-process method calls")
Rel(claim_processing_engine, outbox_event_publisher, "JDBC / Transactional Outbox")
Rel(claim_processing_engine, repository_data_access_component, "In-process method calls")
Rel(repository_data_access_component, azure_sql_database, "TDS with encryption")
Rel(outbox_event_publisher, data_sync_engine, "AMQP / Azure Service Bus")

@enduml