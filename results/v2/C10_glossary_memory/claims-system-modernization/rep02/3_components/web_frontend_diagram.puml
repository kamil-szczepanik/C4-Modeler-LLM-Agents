@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Frontend container

Container_Boundary(web_frontend, "Web Frontend") {
    Component(WebFrontend, "Web Frontend", "React/TypeScript on Azure Static Web Apps", "Serves adjusters and customers with a responsive interface.")
    Component(AuthComponent, "Auth Component", "TypeScript / MSAL.js", "Manages OIDC authentication and Single Sign-On session tokens.")
    Component(CustomerPortalUI, "Customer Portal UI", "React", "Provides customer-facing claims submission and management interface.")
    Component(AdjusterWorkspaceUI, "Adjuster Workspace UI", "React", "Provides adjusters with claims review and processing interface.")
    Component(MigrationFeatureFlagAdapter, "Migration Feature Flag Adapter", "TypeScript", "Handles feature flagging for incremental migration of claim types.")
}

Rel(WebFrontend, AuthComponent, "Delegates authentication")
Rel(WebFrontend, CustomerPortalUI, "Renders")
Rel(WebFrontend, AdjusterWorkspaceUI, "Renders")
Rel(WebFrontend, MigrationFeatureFlagAdapter, "Evaluates feature flags")

@enduml