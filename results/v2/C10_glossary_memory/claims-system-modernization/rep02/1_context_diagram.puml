@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Modern Claims Platform

Person(CustomersAndBrokers, "Customers and Brokers", "External users who interact with the system to submit and manage claims.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal staff who review, process, and manage claims within the system.")
Person(OperationsAndSupportStaff, "Operations and Support Staff", "Staff responsible for monitoring system operations and providing user support.")
Person(FinanceAndAccounting, "Finance and Accounting", "Internal department responsible for financial reconciliation and reporting.")

System(ModernClaimsPlatform, "Modern Claims Platform", "A modern cloud-based platform that gradually replaces a 30-year-old mainframe claims system through a hybrid architecture, ensuring seamless incremental migration of claim types without service disruption.")

System_Ext(LegacyMainframeSystem, "Legacy Mainframe System", "On-Premises COBOL/DB2 mainframe system acting as the system of record.")
System_Ext(EnterpriseIdentityProvider, "Enterprise Identity Provider", "Active Directory / Entra ID providing Single Sign-On (OIDC).")

Rel(CustomersAndBrokers, ModernClaimsPlatform, "Interacts with the platform to manage claims", "HTTPS/TLS (REST/GraphQL)")
Rel(ClaimsAdjusters, ModernClaimsPlatform, "Processes and manages claims", "HTTPS/TLS (REST/GraphQL)")
Rel(OperationsAndSupportStaff, ModernClaimsPlatform, "Supports and monitors the platform", "HTTPS/TLS (REST/GraphQL)")
Rel(FinanceAndAccounting, ModernClaimsPlatform, "Receives financial feeds and reconciliation data", "SFTP / encrypted API feeds")
Rel(ModernClaimsPlatform, EnterpriseIdentityProvider, "Authenticates users for Single Sign-On", "OpenID Connect (OIDC)")
Rel(ModernClaimsPlatform, LegacyMainframeSystem, "Synchronizes claims data asynchronously", "Encrypted TCP/MQ with mTLS via Enterprise Service Bus")

@enduml