@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for New Claims Platform

Person(Customers_and_Brokers, "Customers & Brokers", "External users performing online claim submissions.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal staff handling web application claims processing.")
Person(Finance_and_Compliance_Auditors, "Finance & Compliance Auditors", "Auditors reviewing financial and compliance data.")

System(New_Claims_Platform, "New Claims Platform", "A hybrid architecture gradually modernizing a legacy regional insurance claims system by decoupling online submission and adjuster interfaces from an on-premise mainframe using managed Azure services and asynchronous integration patterns.")

System_Ext(Azure_Service_Bus, "Azure Service Bus", "Asynchronous event queuing and message broker to buffer events and protect against the mainframe batch window.")
System_Ext(Enterprise_Service_Bus_Integration_Gateway, "Enterprise Service Bus / Integration Gateway", "On-premise integration gateway handling hybrid message transit.")
System_Ext(Legacy_Mainframe_COBOL_DB2_System_of_Record, "Legacy Mainframe COBOL/DB2 System of Record", "On-premise legacy system of record for insurance claims data.")
System_Ext(Insurer_Active_Directory, "Insurer Active Directory", "On-premise directory service providing single sign-on and MFA.")

Rel(Customers_and_Brokers, New_Claims_Platform, "Online claim submission", "HTTPS / JSON")
Rel(Claims_Adjusters, New_Claims_Platform, "Web application handling", "HTTPS / HTML")
Rel(New_Claims_Platform, Azure_Service_Bus, "Asynchronous event queuing", "AMQP / HTTPS")
Rel(Azure_Service_Bus, Enterprise_Service_Bus_Integration_Gateway, "Hybrid message transit", "IPsec VPN / Azure ExpressRoute, TLS 1.3")
Rel(Enterprise_Service_Bus_Integration_Gateway, Legacy_Mainframe_COBOL_DB2_System_of_Record, "Gradual data synchronization", "Managed File Transfer / MQ / APIs")
Rel(New_Claims_Platform, Insurer_Active_Directory, "Single sign-on and MFA", "OIDC / OAuth2 via Entra ID Connect")

@enduml