@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Claims Adjusters, "Claims Adjusters", "")
System_Ext(Claims Core API, "Claims Core API", "")
System_Ext(Insurer Active Directory, "Insurer Active Directory", "")

Container_Boundary(Adjuster Web App, "Adjuster Web App") {
    Component(UI Shell & Routing, "UI Shell & Routing", "React / TypeScript", "Delivers sub-2-second adjuster screen loads and manages frontend routing.")
    Component(Claim Action Queue, "Claim Action Queue", "React / TypeScript", "Displays modern claims processing queues for adjusters.")
    Component(BFF Orchestrator Service / BFF Claim Controller, "BFF Orchestrator Service / BFF Claim Controller", "Node.js / Express / Zod / Joi", "Implements the Backend-For-Frontend pattern, isolating frontend from backend latency and validating JSON payloads.")
    Component(Session & Token Manager, "Session & Token Manager", "Node.js", "Manages authentication sessions and tokens via OIDC/OAuth2.")
}

Rel(Claims Adjusters, UI Shell & Routing, "HTTPS / HTML")
Rel(UI Shell & Routing, BFF Orchestrator Service / BFF Claim Controller, "HTTP / JSON")
Rel(BFF Orchestrator Service / BFF Claim Controller, Claims Core API, "HTTPS / JSON")
Rel(Session & Token Manager, Insurer Active Directory, "OIDC / OAuth2 via Azure Entra ID Connect")
@enduml