@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(FinanceComplianceAuditors, "Finance & Compliance Auditors", "Auditors reviewing financial and compliance data.")

System_Ext(AzureServiceBus, "Azure Service Bus", "Asynchronous event queuing and message broker.")
System_Ext(InsurerActiveDirectory, "Insurer Active Directory", "Directory service providing single sign-on and MFA.")
System_Ext(AzureMonitorApplicationInsights, "Azure Monitor / Application Insights", "Monitoring and telemetry platform.")

ContainerDb(AuditDataStore, "Audit Data Store", "Azure SQL Database Ledger with Read Replica", "Tamper-evident, cryptographically secure append-only audit tables.")

Container_Boundary(AuditComplianceService, "Audit & Compliance Service") {
    Component(AuditEventConsumer, "Audit Event Consumer", ".NET Isolated Azure Function Trigger", "Consumes audit events from the message broker and records them.")
    Component(ComplianceRulesEngine, "Compliance Rules Engine", "C# Domain Component", "Evaluates compliance rules against audit and claims data.")
    Component(AuditQueryAPI, "Audit Query API", "ASP.NET Core Functions HTTP Trigger", "Provides query endpoints for auditors to access audit logs.")
    Component(ComplianceReportGenerator, "Compliance Report Generator", ".NET Timer Trigger Azure Function", "Periodically generates scheduled compliance reports.")
}

Rel(FinanceComplianceAuditors, AuditQueryAPI, "HTTPS / JSON, Role-Based Access Control")
Rel(AuditEventConsumer, AzureServiceBus, "AMQP")
Rel(AuditEventConsumer, AuditDataStore, "TDS / TCP via Entity Framework Core")
Rel(ComplianceRulesEngine, AuditDataStore, "TDS / TCP via Entity Framework Core")
Rel(ComplianceReportGenerator, AuditDataStore, "TDS / TCP (Ledger Read Replica)")
Rel(AuditQueryAPI, AuditDataStore, "TDS / TCP (Ledger Read Replica)")
Rel(AuditComplianceService, InsurerActiveDirectory, "OIDC / OAuth2 via Azure Entra ID, Azure Managed Identity")
Rel(AuditComplianceService, AzureMonitorApplicationInsights, "HTTPS")

@enduml