@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container(Claims Core API, "Claims Core API", ".NET Core", "Modular monolith running in Azure Container Apps")

Container_Boundary(Claim Read Database, "Claim Read Database") {
    Component(Claim Read Store, "Claim Read Store", "Azure SQL Database", "Provides relational read storage with encryption, private endpoints, and Dynamic Data Masking for claims data.")
}

Rel(Claims Core API, Claim Read Store, "Reads and queries claim data", "TDS / TCP")

@enduml