@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Customer Portal App container

Container_Boundary(customer_portal_app, "Customer Portal App") {
    Component(Claim_Submission_UI, "Claim Submission UI", "React, TypeScript", "User interface for customers and brokers to submit and view claims online.")
    Component(Authentication_Client, "Authentication Client", "OIDC / OAuth2, Azure Entra ID Connect", "Handles user authentication and single sign-on securely.")
}

System_Ext(Claims_Core_API, "Claims Core API", "Claims Core API (.NET Core modular monolith)")

Rel(Claim_Submission_UI, Authentication_Client, "Authenticates users via", "OIDC / OAuth2")
Rel(Claim_Submission_UI, Claims_Core_API, "Sends claim data via", "HTTPS / JSON")

@enduml