@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Core API container

Person(CustomerPortalApp, "Customer Portal App", "External customer-facing application.")
Person(AdjusterWebApp, "Adjuster Web App", "External adjuster-facing application.")
System_Ext(AzureServiceBus, "Azure Service Bus", "Asynchronous message broker [AMQP].")
System_Ext(ClaimReadDatabase, "Claim Read Database", "Azure SQL Database [TDS / TCP].")
System_Ext(InsurerActiveDirectory, "Insurer Active Directory", "Azure Entra ID Connect [OIDC / OAuth2].")

Container_Boundary(ClaimsCoreAPI, "Claims Core API") {
    Component(ClaimSubmissionComponent, "Claim Submission Component", ".NET Core", "Handles incoming claim submissions and processes validation logic.")
    Component(ClaimQueryRoutingComponent, "Claim Query & Routing Component", ".NET Core", "Fetches optimized read models and handles query routing.")
    Component(FallbackOrchestratorComponent, "Fallback Orchestrator Component", ".NET Core", "Orchestrates fallback mechanisms across the hybrid cloud-mainframe boundary using circuit breakers and resilience patterns.")
    Component(ClaimAdminMetadataComponent, "Claim Admin & Metadata Component", ".NET Core", "Manages administrative tasks and claim metadata operations.")
}

Rel(CustomerPortalApp, ClaimSubmissionComponent, "Sends claim submissions", "HTTPS / JSON")
Rel(AdjusterWebApp, ClaimQueryRoutingComponent, "Fetches and updates claim data", "HTTPS / JSON")
Rel(ClaimSubmissionComponent, AzureServiceBus, "Publishes new claim events", "AMQP")
Rel(ClaimQueryRoutingComponent, ClaimReadDatabase, "Fetches optimized read models", "TDS / TCP")
Rel(ClaimSubmissionComponent, InsurerActiveDirectory, "Authenticates requests", "OIDC / OAuth2")
Rel(ClaimQueryRoutingComponent, InsurerActiveDirectory, "Authenticates requests", "OIDC / OAuth2")
Rel(ClaimAdminMetadataComponent, InsurerActiveDirectory, "Authenticates requests", "OIDC / OAuth2")

@enduml