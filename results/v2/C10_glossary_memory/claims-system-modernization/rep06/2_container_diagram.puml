@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for New Claims Platform

Person(Customers_Brokers, "Customers & Brokers", "External users performing online claim submissions.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal staff handling web application claims processing.")

System_Ext(Azure_Service_Bus, "Azure Service Bus", "Asynchronous event queuing and message broker to buffer events and protect against the mainframe batch window.")
System_Ext(Enterprise_Service_Bus___Integration_Gateway, "Enterprise Service Bus / Integration Gateway", "On-premise integration gateway handling hybrid message transit.")
System_Ext(Legacy_Mainframe_COBOL_DB2_System_of_Record, "Legacy Mainframe COBOL/DB2 System of Record", "On-premise legacy system of record for insurance claims data.")
System_Ext(Insurer_Active_Directory, "Insurer Active Directory", "On-premise directory service providing single sign-on and MFA.")

System_Boundary(New_Claims_Platform, "New Claims Platform") {
    Container(Customer_Portal_App, "Customer Portal App", "React/TypeScript, Azure Static Web Apps", "Allows customers and brokers to perform online claim submissions.")
    Container(Adjuster_Web_App, "Adjuster Web App", "React/Node.js BFF", "Web application for claims adjusters to process claims.")
    Container(Claims_Core_API, "Claims Core API", ".NET Core modular monolith, Azure Container Apps", "Core business logic and backend APIs for claim handling.")
    Container(Integration_Worker, "Integration Worker", ".NET background service, Azure Container Apps", "Background worker service handling asynchronous integration processes.")
    Container(Audit___Compliance_Service, "Audit & Compliance Service", "Azure Function", "Auditing service reviewing financial and compliance data.")
    ContainerDb(Claim_Read_Database, "Claim Read Database", "Azure SQL Database", "Relational storage providing fast read performance with Transparent Data Encryption (TDE).")
}

Rel(Customers_Brokers, Customer_Portal_App, "Submits claims online", "HTTPS / JSON")
Rel(Claims_Adjusters, Adjuster_Web_App, "Manages claims processing", "HTTPS / HTML")
Rel(Customer_Portal_App, Claims_Core_API, "Sends claim submissions", "HTTPS / JSON")
Rel(Adjuster_Web_App, Claims_Core_API, "Fetches and updates claim data", "HTTPS / JSON")
Rel(Claims_Core_API, Claim_Read_Database, "Reads and writes claim read data", "TDS / TCP")
Rel(Claims_Core_API, Azure_Service_Bus, "Publishes asynchronous events", "AMQP")
Rel(Integration_Worker, Azure_Service_Bus, "Consumes and produces asynchronous messages", "AMQP")
Rel(Azure_Service_Bus, Enterprise_Service_Bus___Integration_Gateway, "Transits messages across hybrid boundary", "IPsec VPN / Azure ExpressRoute, TLS 1.3")
Rel(Enterprise_Service_Bus___Integration_Gateway, Legacy_Mainframe_COBOL_DB2_System_of_Record, "Synchronizes data with legacy system", "Managed File Transfer / MQ / APIs")
Rel(Customer_Portal_App, Insurer_Active_Directory, "Authenticates users", "OIDC / OAuth2 via Azure Entra ID Connect")
Rel(Adjuster_Web_App, Insurer_Active_Directory, "Authenticates adjusters", "OIDC / OAuth2 via Azure Entra ID Connect")

@enduml