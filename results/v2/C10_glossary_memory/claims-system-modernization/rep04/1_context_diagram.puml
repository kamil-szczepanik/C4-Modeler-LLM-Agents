@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Insurance Claims Modernization

Person(End_Customers_and_Brokers, "End Customers and Brokers", "External users who submit online claims and interact with the insurance platform.")
Person(Claims_Adjusters_and_Claims_Managers, "Claims Adjusters and Claims Managers", "Internal staff who use adjuster workflows to manage and process claims.")

System_Ext(Legacy_Mainframe, "Legacy Mainframe", "On-premise 30-year-old COBOL/DB2 system serving as the system of record.")
System_Ext(Corporate_Active_Directory_Azure_AD, "Corporate Active Directory / Azure AD", "Identity Provider for authentication and Single Sign-On.")
System_Ext(Analytics_Reporting_System, "Analytics & Reporting System", "Azure Synapse / Power BI system for reporting and analytics.")

System_Boundary(Insurance_Claims_Modernization, "Insurance Claims Modernization") {
    Container(New_Claims_Platform, "New Claims Platform", "Azure App Service, Azure SQL", "Modern Azure platform hosting application services and databases for online claim submission and adjuster workflows.")
    Container(Azure_API_Management_APM_Gateway, "Azure API Management (APM) Gateway", "Azure API Management", "Gateway for rate-limiting, token validation, and protecting fragile mainframe interfaces.")
}

Rel(End_Customers_and_Brokers, New_Claims_Platform, "Online claim submission", "HTTPS")
Rel(Claims_Adjusters_and_Claims_Managers, New_Claims_Platform, "Web application access for adjuster workflows", "HTTPS")
Rel(New_Claims_Platform, Legacy_Mainframe, "Data synchronization and legacy integration", "Azure ExpressRoute, mTLS, and Azure API Management")
Rel(New_Claims_Platform, Analytics_Reporting_System, "Event streaming for reporting", "Azure Event Hubs, TLS 1.3")
Rel(End_Customers_and_Brokers, Corporate_Active_Directory_Azure_AD, "Authentication and Single Sign-On", "OAuth 2.0 / OIDC")
Rel(Claims_Adjusters_and_Claims_Managers, Corporate_Active_Directory_Azure_AD, "Authentication and Single Sign-On", "OAuth 2.0 / OIDC")

@enduml