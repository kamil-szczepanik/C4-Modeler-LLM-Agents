@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Insurance Claims Modernization

Person(End_Customers_and_Brokers, "End Customers and Brokers", "External users who submit online claims and interact with the insurance platform.")
Person(Claims_Adjusters_and_Claims_Managers, "Claims Adjusters and Claims Managers", "Internal staff who use adjuster workflows to manage and process claims.")

System_Ext(Legacy_Mainframe, "Legacy Mainframe", "On-premise 30-year-old COBOL/DB2 system serving as the system of record.")
System_Ext(Corporate_Active_Directory___Azure_AD, "Corporate Active Directory / Azure AD", "Identity Provider for authentication and Single Sign-On.")
System_Ext(Analytics___Reporting_System, "Analytics & Reporting System", "Azure Synapse / Power BI system for reporting and analytics.")

System_Boundary(Insurance_Claims_Modernization, "Insurance Claims Modernization") {
    Container(Customer_Broker_Portal, "Customer/Broker Portal", "Azure App Service, React", "Public SPA and BFF for end customers and brokers to interact with the insurance platform.")
    Container(Adjuster_Workstation, "Adjuster Workstation", "Azure App Service, Angular", "Internal UI optimized for sub-2s loads used by claims adjusters and managers.")
    Container(Integration___Routing_Engine, "Integration & Routing Engine", "Azure Service Bus, Azure Functions", "Handles asynchronous queuing, DLQ, and deduplication for claims routing.")
    Container(Azure_API_Management_Gateway, "Azure API Management Gateway", "Azure API Management", "Gateway for rate-limiting, token validation, and mainframe protection.")
    Container(Observability___Audit_Logging, "Observability & Audit Logging", "Azure Application Insights, Azure Cosmos DB", "Provides distributed tracing and state tracking across the platform.")
    Container(Secret_Management, "Secret Management", "Azure Key Vault", "Provides managed identities and automated rotation for secrets.")
}

Rel(End_Customers_and_Brokers, Customer_Broker_Portal, "Submit and manage claims", "HTTPS")
Rel(Claims_Adjusters_and_Claims_Managers, Adjuster_Workstation, "Manage and process claims workflows", "HTTPS")
Rel(Customer_Broker_Portal, Integration___Routing_Engine, "Route claim submissions and messages", "HTTPS / AMQP")
Rel(Adjuster_Workstation, Integration___Routing_Engine, "Route adjuster actions and messages", "HTTPS / AMQP")
Rel(Integration___Routing_Engine, Azure_API_Management_Gateway, "Forward routed traffic to backend interfaces", "HTTPS")
Rel(Azure_API_Management_Gateway, Legacy_Mainframe, "Secure data exchange and mainframe integration", "Azure ExpressRoute, mTLS")
Rel(Integration___Routing_Engine, Analytics___Reporting_System, "Stream event data for reporting", "Azure Event Hubs, TLS 1.3")
Rel(End_Customers_and_Brokers, Corporate_Active_Directory___Azure_AD, "Authentication and Single Sign-On", "OAuth 2.0 / OIDC")
Rel(Claims_Adjusters_and_Claims_Managers, Corporate_Active_Directory___Azure_AD, "Authentication and Single Sign-On", "OAuth 2.0 / OIDC")
Rel(Customer_Broker_Portal, Observability___Audit_Logging, "Send telemetry and logs", "HTTPS")
Rel(Adjuster_Workstation, Observability___Audit_Logging, "Send telemetry and logs", "HTTPS")
Rel(Integration___Routing_Engine, Observability___Audit_Logging, "Send telemetry and logs", "HTTPS")
Rel(Azure_API_Management_Gateway, Observability___Audit_Logging, "Send telemetry and logs", "HTTPS")
Rel(Observability___Audit_Logging, Observability___Audit_Logging, "Internal state tracking", "HTTPS")
Rel(Secret_Management, Observability___Audit_Logging, "Send telemetry and logs", "HTTPS")

@enduml