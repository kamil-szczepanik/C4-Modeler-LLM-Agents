@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("integration_routing_engine", "Integration & Routing Engine") {
    Component(Claim_Router_Component, "Claim Router Component", ".NET Isolated Azure Functions", "Routes claim submissions using Azure Functions.")
    Component(Deduplication_State_Component, "Deduplication & State Component", "Azure Cosmos DB", "Enforces idempotency and tracks state for deduplication.")
    Component(Fallback_Switch_Component, "Fallback Switch Component", "Azure App Configuration", "Dynamically manages routing rules for the 1-day mainframe fallback.")
    Component(Retry_DLQ_Handler_Component, "Retry & DLQ Handler Component", ".NET Azure Functions", "Manages asynchronous queuing, AMQP delivery, and Dead-Letter Queues.")
}

Rel(Claim_Router_Component, Deduplication_State_Component, "Checks state and enforces idempotency", "")
Rel(Claim_Router_Component, Fallback_Switch_Component, "Evaluates fallback routing rules", "")
Rel(Retry_DLQ_Handler_Component, Claim_Router_Component, "Retries failed claim routing", "")

@enduml