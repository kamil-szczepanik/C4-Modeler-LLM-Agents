@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Secret Management container

Container_Boundary(secret_management, "Secret Management") {
    Component(Key_Vault_Service, "Key Vault Service", "Azure Key Vault, HSM", "Secures sensitive keys, connection strings, and certificates, eliminating hardcoded credentials.")
    Component(Managed_Identity_Provider, "Managed Identity Provider", "Azure Managed Identities, Azure AD", "Handles token generation and automated secret rotation for consuming containers.")
}

Rel(Managed_Identity_Provider, Key_Vault_Service, "Authenticates and authorizes access to secrets", "HTTPS / Azure SDK")

@enduml