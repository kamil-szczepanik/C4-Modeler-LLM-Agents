@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(adjuster_workstation, "Adjuster Workstation") {
    Component(adjuster_ui_controller, "Adjuster UI Controller", "Angular, Azure App Service", "Renders the internal UI optimized for sub-2s loads and handles user interactions for claims adjusters and managers.")
    Component(adjuster_session_auth_handler, "Adjuster Session & Auth Handler", "OAuth 2.0 / OIDC, Azure App Service", "Manages authentication and secure session tokens for claims adjusters communicating via Corporate Active Directory / Azure AD.")
    Component(local_read_model_cache, "Local Read-Model Cache", "Azure SQL Database", "Provides fast local caching of claim data to ensure sub-2s UI response times for the adjuster workstation.")
}

Rel(adjuster_ui_controller, local_read_model_cache, "Queries cached claim data for rapid UI rendering", "HTTPS")
Rel(adjuster_ui_controller, adjuster_session_auth_handler, "Authenticates user session", "OAuth 2.0 / OIDC")

@enduml