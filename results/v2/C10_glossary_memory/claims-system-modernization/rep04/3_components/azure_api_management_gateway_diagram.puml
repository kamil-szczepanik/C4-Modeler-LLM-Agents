@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure API Management Gateway container

Container_Boundary(apim_gateway, "Azure API Management Gateway") {
    Component(api_gateway_policy_engine, "API Gateway Policy Engine", "Azure API Management Policy", "Enforces rate-limiting, token validation, and request filtering for incoming traffic.")
    Component(mainframe_proxy_route, "Mainframe Proxy Route", "Azure API Management Routing", "Routes validated requests securely to the legacy mainframe via Azure ExpressRoute and mTLS.")
}

Rel(api_gateway_policy_engine, mainframe_proxy_route, "Forwards validated requests", "")

@enduml