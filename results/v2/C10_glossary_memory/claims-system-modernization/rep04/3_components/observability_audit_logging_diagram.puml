@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Observability & Audit Logging container

Container_Boundary(observability_audit_logging, "Observability & Audit Logging") {
    Component(Telemetry_Collector, "Telemetry Collector", "Azure Application Insights", "Collects distributed telemetry and tracing across hybrid environments.")
    ComponentDb(Audit_Trail_Ledger, "Audit Trail Ledger", "Azure Cosmos DB Ledger mode", "Ensures immutable, cryptographically verified audit trails for compliance and consistency.")
}

Rel(Telemetry_Collector, Audit_Trail_Ledger, "Persists audit events and traceability data")

@enduml