@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Routing_Upstream_Proxy, "Routing & Upstream Proxy", "Nginx/Kong Core", "Ensures secure, low-latency routing to upstream microservices.")
    Component(Auth_Token_Validation_Filter, "Auth & Token Validation Filter", "Kong JWT / OAuth2 Plugin", "Validates OAuth2/OIDC tokens and JSON Web Tokens (JWT) for incoming requests.")
    Component(Rate_Limiting_Throttling_Engine, "Rate Limiting & Throttling Engine", "Kong Rate Limiting / Redis", "Enforces distributed rate-limiting counters using a high-availability Redis data store.")
    Component(Telemetry_Logging_Exporter, "Telemetry & Logging Exporter", "OpenTelemetry / OTLP", "Emits structured access logs, metrics, and distributed traces via OTLP/gRPC.")
    Component(Request_Transformation_Validation_Engine, "Request Transformation & Validation Engine", "Kong Schema Validation", "Validates and transforms incoming requests before routing them to internal services.")
}

Rel(Auth_Token_Validation_Filter, Routing_Upstream_Proxy, "Authorizes and passes validated requests for")
Rel(Rate_Limiting_Throttling_Engine, Routing_Upstream_Proxy, "Throttles excessive requests before")
Rel(Request_Transformation_Validation_Engine, Routing_Upstream_Proxy, "Validates request payloads prior to")
Rel(Routing_Upstream_Proxy, Telemetry_Logging_Exporter, "Exports access metrics and traces via")

@enduml