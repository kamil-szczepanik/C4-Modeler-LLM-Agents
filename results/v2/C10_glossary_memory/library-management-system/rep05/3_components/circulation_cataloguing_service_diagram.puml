@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Circulation & Cataloguing Service container

System_Ext(Database, "Database", "PostgreSQL", "Stores transactional data with AES-256 encryption at rest and a transactional outbox pattern.")
System_Ext(Core_Search_Engine, "Core Search Engine", "Elasticsearch", "Delivers low-latency catalog search meeting the <800ms SLA.")
System_Ext(Third_Party_Digital_Content_Providers, "Third-Party Digital Content Providers", "External API", "Provides external digital assets and media.")
System_Ext(Payment_Gateway, "Payment Gateway", "External API", "Processes patron fine payments securely.")
System_Ext(Notification_Service, "Notification Service", "External Service", "Dispatches notifications and webhooks to patrons.")

Container_Boundary(Circulation_and_Cataloguing_Service, "Circulation & Cataloguing Service") {
    Component(Cataloguing_Controller, "Cataloguing Controller", "Node.js / Express / Zod", "Handles incoming gRPC and REST requests for cataloguing books, physical media, and digital assets.")
    Component(Circulation_Controller, "Circulation Controller", "Node.js / Express / Zod", "Manages patron checkouts, returns, renewals, and fine calculations.")
    Component(Cataloguing_and_Circulation_Service_Logic, "Cataloguing & Circulation Service Logic", "TypeScript / Domain Services", "Encapsulates core business rules for library operations, inventory tracking, and search integrations.")
    Component(Data_Access_Repository, "Data Access Repository", "Node-Postgres / Outbox Pattern", "Interacts with PostgreSQL using secure connections and implements the transactional outbox pattern for audit logs and webhooks.")
}

Rel(Cataloguing_Controller, Cataloguing_and_Circulation_Service_Logic, "Delegates cataloguing requests to")
Rel(Circulation_Controller, Cataloguing_and_Circulation_Service_Logic, "Delegates circulation requests to")
Rel(Cataloguing_and_Circulation_Service_Logic, Data_Access_Repository, "Persists and queries transaction data using")
Rel(Data_Access_Repository, Database, "PostgreSQL Wire Protocol over TLS")
Rel(Cataloguing_and_Circulation_Service_Logic, Core_Search_Engine, "TCP over TLS")
Rel(Cataloguing_and_Circulation_Service_Logic, Third_Party_Digital_Content_Providers, "REST/JSON over HTTPS")
Rel(Cataloguing_and_Circulation_Service_Logic, Payment_Gateway, "HTTPS/REST")
Rel(Cataloguing_and_Circulation_Service_Logic, Notification_Service, "Webhooks/SMTP with HMAC")
@enduml