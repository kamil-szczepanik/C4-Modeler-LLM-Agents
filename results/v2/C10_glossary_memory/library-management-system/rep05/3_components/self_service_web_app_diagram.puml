@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "Nginx/Kong")
System_Ext(payment_gateway, "Payment Gateway", "External payment provider")

Container_Boundary(self_service_web_app, "Self-Service Web App") {
    Component(bff_routing_and_session_handler, "BFF Routing & Session Handler", "Next.js API Routes / Node.js", "Handles client-side routing, renders UI pages, and translates HttpOnly cookies to JWT tokens for backend API communication.")
    Component(catalogue_search_ui, "Catalogue Search UI", "React Component / Client-side Cache", "Provides rapid catalogue search interactions and caches search results in the browser.")
    Component(fine_payment_widget, "Fine Payment Widget", "React Component / Iframe Integration", "Manages fine settlements securely via an isolated iframe tokenization mechanism.")
}

Rel(bff_routing_and_session_handler, api_gateway, "HTTPS/REST with HttpOnly Cookie-to-JWT translation", "HTTPS")
Rel(fine_payment_widget, payment_gateway, "HTTPS, via isolated iframe tokenization", "HTTPS")

@enduml