@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(core_search_engine, "Core Search Engine") {
    Component(query_processing_component, "Query Processing Component", "Elasticsearch Module", "Processes and parses incoming search queries from the circulation and cataloguing service.")
    Component(indexing_component, "Indexing Component", "Elasticsearch Module", "Manages the ingestion and indexing of physical and digital items for fast retrieval.")
    Component(search_indices, "Search Indices", "Inverted Index", "Stores optimized indices to natively guarantee sub-800ms search latencies.")
    Component(analysis_component, "Analysis Component", "Elasticsearch Module", "Performs text analysis, tokenization, and linguistic processing for search queries.")
    Component(cluster_coordination_component, "Cluster Coordination Component", "Elasticsearch 3-node cluster", "Manages cluster state, node communication, and high availability across EU availability zones.")
}

Rel(query_processing_component, analysis_component, "Analyzes and tokenizes query text")
Rel(query_processing_component, search_indices, "Executes searches against")
Rel(indexing_component, search_indices, "Updates and maintains")
Rel(cluster_coordination_component, query_processing_component, "Coordinates cluster nodes for")
Rel(cluster_coordination_component, indexing_component, "Coordinates cluster nodes for")

@enduml