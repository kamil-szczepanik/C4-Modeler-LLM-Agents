@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(admin_staff_portal, "Admin/Staff Portal") {
    Component(Staff_Authentication_Controller, "Staff Authentication Controller", "React Router / OIDC Client", "Manages staff authentication flows, token exchange, and secure session state within the Admin/Staff Portal.")
    Component(Admin_Dashboard_UI, "Admin Dashboard UI", "React Admin / Material-UI", "High-density data grids and administrative workflows for managing library operations and cataloguing.")
    Component(Staff_API_Client, "Staff API Client", "Axios / Fetch API", "Handles secure HTTP/REST communication with JWT authentication headers targeting the API Gateway.")
}

Rel(Staff_Authentication_Controller, Staff_API_Client, "Supplies JWT for authorized requests", "")
Rel(Admin_Dashboard_UI, Staff_API_Client, "Initiates data queries and administrative mutations", "")
@enduml