@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database container

Container_Boundary(database, "Database") {
    Component(ConnectionPoolManager, "Connection Pool Manager", "PostgreSQL Connection Pooling", "Manages database connections efficiently for the circulation and cataloguing service.")
    Component(RelationalStorageEngine, "Relational Storage Engine", "PostgreSQL B-tree/GIN Indexing", "Provides structured relational storage and indexing for library data.")
    Component(AuditEncryptionSubsystem, "Audit & Encryption Subsystem", "AES-256 Encryption at Rest", "Ensures data security and compliance with strict EU data residency regulations.")
    Component(ReplicationBackupSubsystem, "Replication & Backup Subsystem", "PostgreSQL Replication", "Handles data redundancy and disaster recovery.")
    Component(DataRetentionArchivalSubsystem, "Data Retention & Archival Subsystem", "PostgreSQL Archival Policies", "Manages historical data and compliance retention schedules.")
}

Rel(ConnectionPoolManager, RelationalStorageEngine, "Routes queries to")
Rel(RelationalStorageEngine, AuditEncryptionSubsystem, "Secures data using")
Rel(RelationalStorageEngine, ReplicationBackupSubsystem, "Replicates data via")
Rel(RelationalStorageEngine, DataRetentionArchivalSubsystem, "Archives old records through")

@enduml