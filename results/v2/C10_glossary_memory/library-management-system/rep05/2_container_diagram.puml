@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(LibraryPatronsStaff, "Library Patrons & Staff", "Actors interacting via HTTPS/TLS to use self-service portals, circulation management, and cataloguing.")

System_Ext(EUedgeReverseProxy, "EU-edge Reverse Proxy", "Edge-caching and CDN layer with WAF and rate limiting deployed on EU-Hosted Cloud Infrastructure.")
System_Ext(ThirdPartyDigitalContentProviders, "Third-Party Digital Content Providers", "External system integrated via REST APIs for digital content.")
System_Ext(PaymentGateway, "Payment Gateway", "External system for processing fines and fees securely.")
System_Ext(NotificationService, "Notification Service", "External system for patron alerts via Webhooks/SMTP.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(SelfServiceWebApp, "Self-Service Web App", "React/Next.js SPA", "Frontend UI deployed on EU-edge static hosting for library patrons.")
    Container(AdminStaffPortal, "Admin/Staff Portal", "React Admin SPA", "Frontend UI deployed on EU-edge static hosting for library staff and administrators.")
    Container(APIGateway, "API Gateway", "Nginx/Kong", "API Gateway for routing, rate limiting, and OAuth2/OIDC token validation.")
    Container(CirculationCataloguingService, "Circulation & Cataloguing Service", "Node.js/TypeScript", "Service responsible for core business logic regarding circulation and cataloguing.")
    Container(CoreSearchEngine, "Core Search Engine", "Elasticsearch", "Search engine hosted in EU regions to satisfy R-05 search SLA (<800ms).")
    ContainerDb(Database, "Database", "PostgreSQL", "Managed database with AES-256 encryption at rest in EU region for data residency.")
}

Rel(LibraryPatronsStaff, EUedgeReverseProxy, "Interacts via HTTPS/TLS 1.3, OIDC/OAuth2 authentication (with MFA for staff).", "HTTPS/TLS 1.3, OIDC/OAuth2")
Rel(EUedgeReverseProxy, SelfServiceWebApp, "Serves static assets and forwards requests.", "HTTPS")
Rel(EUedgeReverseProxy, AdminStaffPortal, "Serves static assets and forwards requests.", "HTTPS")
Rel(SelfServiceWebApp, APIGateway, "Makes API requests with JWT.", "HTTPS/REST with JWT")
Rel(AdminStaffPortal, APIGateway, "Makes API requests with JWT.", "HTTPS/REST with JWT")
Rel(APIGateway, CirculationCataloguingService, "Routes validated requests to the backend service.", "gRPC/Internal, mTLS")
Rel(CirculationCataloguingService, CoreSearchEngine, "Queries search index for catalog search.", "TCP")
Rel(CirculationCataloguingService, Database, "Reads and writes transactional data.", "PostgreSQL Wire Protocol")
Rel(CirculationCataloguingService, ThirdPartyDigitalContentProviders, "Integrates via REST APIs with circuit breakers and fallback caching.", "REST/JSON over HTTPS")
Rel(CirculationCataloguingService, PaymentGateway, "Processes secure financial transactions for fines and fees.", "HTTPS/REST")
Rel(CirculationCataloguingService, NotificationService, "Sends patron alerts using cryptographic message signing.", "Webhooks/SMTP with HMAC")

@enduml