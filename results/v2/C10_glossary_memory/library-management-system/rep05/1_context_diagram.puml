@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Library_Patrons_Staff, "Library Patrons & Staff", "Actors interacting via HTTPS/TLS to use self-service portals, circulation management, and cataloguing.")

System(Library_Management_System, "Library Management System", "Provides self-service portals, circulation management, and cataloguing for public and academic libraries with EU-only data residency and strict search SLAs.")

System_Ext(Third_Party_Digital_Content_Providers, "Third-Party Digital Content Providers", "External system integrated via REST APIs for digital content.")
System_Ext(Payment_Gateway, "Payment Gateway", "External system for processing fines and fees securely.")
System_Ext(Notification_Service, "Notification Service", "External system for patron alerts via Webhooks/SMTP.")
System_Ext(EU_edge_Reverse_Proxy, "EU-edge Reverse Proxy", "Edge-caching and CDN layer with WAF and rate limiting deployed on EU-Hosted Cloud Infrastructure.")

Rel(Library_Patrons_Staff, EU_edge_Reverse_Proxy, "Interacts via HTTPS/TLS 1.3, OIDC/OAuth2 authentication (with MFA for staff).", "HTTPS/TLS 1.3, OIDC/OAuth2")
Rel(Library_Patrons_Staff, Library_Management_System, "Accesses self-service portals, circulation management, and cataloguing.", "HTTPS/TLS")
Rel(Library_Management_System, Third_Party_Digital_Content_Providers, "Integrates via REST APIs with circuit breakers and fallback caching.", "REST/JSON over HTTPS")
Rel(Library_Management_System, Payment_Gateway, "Processes secure financial transactions for fines and fees.", "HTTPS/REST")
Rel(Library_Management_System, Notification_Service, "Sends patron alerts using cryptographic message signing.", "Webhooks/SMTP with HMAC")

@enduml