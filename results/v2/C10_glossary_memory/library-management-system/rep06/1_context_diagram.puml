@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(LibraryPatrons, "Library Patrons", "Students and public users who access the self-service portals and search the catalog.")
Person(Librarians, "Librarians", "Circulation staff who manage daily library operations and patron accounts.")
Person(LibraryAdministrators, "Library Administrators", "Administrators who oversee system configurations and manage diverse user personas.")

System(LibraryManagementSystem, "Library Management System", "Provides cataloging, circulation, and self-service portals while enforcing EU data residency, high-performance search, and role-based access control.")

System_Ext(EUIdentityProviderIdP, "EU Identity Provider (IdP)", "Manages authentication and token exchange using OIDC.")
System_Ext(PaymentGateway, "Payment Gateway", "Processes transactions via REST/JSON over HTTPS.")
System_Ext(DigitalContentProviders, "Digital Content Providers", "Supplies external digital content and media via APIs over HTTPS.")

Rel(LibraryPatrons, LibraryManagementSystem, "Accesses self-service portals and cataloging", "HTTPS (TLS 1.3)")
Rel(Librarians, LibraryManagementSystem, "Manages circulation and library operations", "HTTPS (TLS 1.3)")
Rel(LibraryAdministrators, LibraryManagementSystem, "Performs administrative tasks and role-based access control", "HTTPS (TLS 1.3)")
Rel(LibraryManagementSystem, EUIdentityProviderIdP, "Authenticates users and handles token exchange", "OIDC over HTTPS")
Rel(LibraryManagementSystem, PaymentGateway, "Processes payments for fines and services", "REST/JSON over HTTPS")
Rel(LibraryManagementSystem, DigitalContentProviders, "Retrieves digital content and media resources", "API over HTTPS")

@enduml