@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Librarians, "Librarians", "Library staff managing circulation and daily operations.")
Person(Library Administrators, "Library Administrators", "Administrators overseeing catalog and system management.")

System_Ext(Core API Gateway, "Core API Gateway", "Envoy, Spring Cloud Gateway")
System_Ext(EU Identity Provider (IdP), "EU Identity Provider (IdP)", "OIDC")
System_Ext(Circulation Service, "Circulation Service", "Microservice handling circulation workflows.")
System_Ext(Catalog & Search Service, "Catalog & Search Service", "Microservice handling catalog and search.")

Container_Boundary(Staff_Web_App, "Staff Web App") {
    Component(Circulation Desk Component, "Circulation Desk Component", "Angular", "Provides offline-resilient circulation desk workflows and local caching with IndexedDB.")
    Component(Catalog Management Component, "Catalog Management Component", "Angular", "Handles catalog management and administrative library interfaces.")
    Component(Admin Dashboard Component, "Admin Dashboard Component", "Angular", "Provides robust administrative workflows and overview dashboards.")
    Component(Auth Guard & State Service, "Auth Guard & State Service", "Angular", "Manages state and enforces authentication token exchange via OIDC.")
}

Rel(Librarians, Staff_Web_App, "Accesses", "HTTPS, TLS 1.3")
Rel(Library Administrators, Staff_Web_App, "Accesses", "HTTPS, TLS 1.3")
Rel(Staff_Web_App, Core API Gateway, "Sends API traffic", "HTTPS, TLS 1.3")
Rel(Auth Guard & State Service, EU Identity Provider (IdP), "Authenticates", "OIDC over HTTPS")
Rel(Circulation Desk Component, Circulation Service, "Invokes via Core API Gateway", "HTTPS, TLS 1.3")
Rel(Catalog Management Component, Catalog & Search Service, "Invokes via Core API Gateway", "HTTPS, TLS 1.3")

@enduml