@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Core_API_Gateway, "Core API Gateway", "Envoy, Spring Cloud Gateway")
System_Ext(Payment_Gateway, "Payment Gateway", "REST/JSON")
System_Ext(Notification_Service, "Notification Service", "Node.js, TypeScript, RabbitMQ/Kafka")
System_Ext(Primary_Database_Read_Replica, "Primary Database & Read Replica", "PostgreSQL")

Container_Boundary(Circulation_Service, "Circulation Service") {
    Component(Loan_Management_Component, "Loan Management Component", "Spring Data JPA", "Manages patron loans and borrowing history with EU-compliant handling.")
    Component(Hold_Reservation_Component, "Hold & Reservation Component", "Java", "Handles item holds and reservations.")
    Component(Fine_Management_Component, "Fine Management Component", "Java", "Manages fine settlements and financial transactions.")
    Component(Audit_Logging_Component, "Audit Logging Component", "Java", "Provides audit logging for circulation and access activities.")
}

Rel(Core_API_Gateway, Circulation_Service, "gRPC / HTTPS, mTLS")
Rel(Fine_Management_Component, Payment_Gateway, "REST/JSON, mTLS over HTTPS with Idempotency Keys")
Rel(Loan_Management_Component, Notification_Service, "AMQP / RabbitMQ")
Rel(Loan_Management_Component, Primary_Database_Read_Replica, "PostgreSQL Protocol over TLS 1.3")
Rel(Fine_Management_Component, Primary_Database_Read_Replica, "PostgreSQL Protocol over TLS 1.3")
Rel(Loan_Management_Component, Hold_Reservation_Component, "In-process / Java Method Call")

@enduml