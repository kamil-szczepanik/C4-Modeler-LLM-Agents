@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification Service container

System_Ext(core_api, "Core API Gateway / Circulation Service", "External service interacting with the notification service")
System_Ext(eu_providers, "EU-Hosted Email/SMS Providers", "Delivers messages to library patrons and staff via secure channels.")

Container_Boundary(notification_service, "Notification Service") {
    Component(api_handler, "Notification API Handler", "Express.js, TypeScript", "Exposes gRPC/HTTP endpoints for secure ingress from core services.")
    Component(dispatcher, "Message Dispatcher Engine", "Node.js, TypeScript", "Buffers traffic spikes and decouples ingestion from dispatch.")
    Component(channel_adapter, "Channel Adapter Module", "Node.js, TypeScript", "Handles secure message dispatch to external providers.")
    Component(template_manager, "Template & Localization Manager", "Node.js, TypeScript", "Manages message templates and localization requirements.")
    Component(consent_manager, "Preference & Consent Manager", "Node.js, TypeScript", "Validates patron preferences and GDPR consent states.")
    Component(message_broker, "RabbitMQ/Kafka Message Broker", "RabbitMQ/Kafka", "Buffers traffic spikes during bulk notification events.")
    Component(redis_cache, "Redis In-Memory Cache", "Redis", "Caches GDPR consent states to maintain low dispatch latencies.")
    Component(database, "Primary Database & Read Replica", "PostgreSQL", "Persists user consent settings within strict EU data residency boundaries.")
}

Rel(core_api, api_handler, "gRPC, mTLS")
Rel(api_handler, message_broker, "AMQP / Kafka Protocol")
Rel(dispatcher, consent_manager, "Internal Function Call")
Rel(consent_manager, database, "PostgreSQL Protocol")
Rel(dispatcher, channel_adapter, "Internal Function Call")
Rel(channel_adapter, eu_providers, "HTTPS, TLS 1.3")

@enduml