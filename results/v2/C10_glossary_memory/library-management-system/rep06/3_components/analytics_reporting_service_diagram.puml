@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Ext(Core_API_Gateway, "Core API Gateway", "Envoy, Spring Cloud Gateway", "API Gateway")
ContainerDb_Ext(Primary_Database_Read_Replica, "Primary Database & Read Replica", "PostgreSQL", "Primary Database & Read Replica")

Container_Boundary(Analytics_Reporting_Service, "Analytics & Reporting Service") {
    Component(Circulation_Analytics_Component, "Circulation Analytics Component", "Python, Pandas", "Queries and analyzes circulation data from the primary database read replica.")
    Component(Usage_Engagement_Reporting_Component, "Usage & Engagement Reporting Component", "Python, Pandas", "Queries and processes usage and engagement metrics.")
    Component(Report_Generation_Export_Component, "Report Generation & Export Component", "Python, ReportLab/Openpyxl", "Generates export artifacts and queues background export tasks.")
    Component(Report_Export_Job_Queue, "Report Export Job Queue", "Celery, Redis/RabbitMQ", "Manages asynchronous report export job tasks and worker pools.")
    Component(EU_Pinned_Object_Storage, "EU-Pinned Object Storage", "S3-compatible storage", "Secures and stores exported report artifacts within compliant EU boundaries.")
}

Rel(Core_API_Gateway, Report_Generation_Export_Component, "Initiates async report jobs", "gRPC, mTLS")
Rel(Circulation_Analytics_Component, Primary_Database_Read_Replica, "Queries analytical data", "PostgreSQL Protocol, Read Replica")
Rel(Usage_Engagement_Reporting_Component, Primary_Database_Read_Replica, "Queries engagement data", "PostgreSQL Protocol, Read Replica")
Rel(Report_Generation_Export_Component, Report_Export_Job_Queue, "Queues export tasks", "AMQP / Redis Protocol")
Rel(Report_Generation_Export_Component, EU_Pinned_Object_Storage, "Stores export artifacts", "HTTPS, TLS 1.3")

@enduml