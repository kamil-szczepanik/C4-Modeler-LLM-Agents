@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(patron_web_app, "Patron Web App") {
    Component(Search_and_Discovery_UI, "Search & Discovery UI", "React, TypeScript", "Provides high-performance client-side rendering for searching library catalogs.")
    Component(Account_and_Circulation_Portal, "Account & Circulation Portal", "React, TypeScript", "Enables library patrons to manage accounts and handle self-service circulation securely.")
    Component(Payment_Integration_Client, "Payment Integration Client", "React, TypeScript", "Handles secure payment workflows for library patrons.")
    Component(Auth_Client_Module, "Auth Client Module", "OIDC Client", "Manages secure authentication and token exchange using OIDC with PKCE.")
}

System(Core_API_Gateway, "Core API Gateway", "Envoy, Spring Cloud Gateway")
System_Ext(EU_Identity_Provider_IdP, "EU Identity Provider (IdP)", "OIDC")

Rel(Search_and_Discovery_UI, Core_API_Gateway, "HTTPS (TLS 1.3), JSON", "HTTPS")
Rel(Account_and_Circulation_Portal, Core_API_Gateway, "HTTPS (TLS 1.3), JSON", "HTTPS")
Rel(Payment_Integration_Client, Core_API_Gateway, "HTTPS (TLS 1.3), JSON", "HTTPS")
Rel(Auth_Client_Module, EU_Identity_Provider_IdP, "OIDC over HTTPS, TLS 1.3 with PKCE", "HTTPS")
@enduml