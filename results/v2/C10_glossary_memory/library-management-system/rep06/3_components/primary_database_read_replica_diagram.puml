@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Primary Database & Read Replica container

Container_Boundary(primary_database_and_read_replica, "Primary Database & Read Replica") {
    Component(Connection_Pooler, "Connection Pooler", "PgBouncer", "Connection pooling to prevent resource exhaustion from microservices and route traffic.")
    Component(Primary_Database_Instance, "Primary Database Instance", "PostgreSQL 15", "Core relational database engine for robust ACID compliance and write transactions.")
    Component(Read_Replica_Instance, "Read Replica Instance", "PostgreSQL 15", "Handles heavy read traffic to ensure uninterrupted self-service borrowing and sub-800ms search responses.")
    Component(Failover_and_Consensus_Manager, "Failover & Consensus Manager", "Patroni / etcd", "Automated high-availability failover and consensus management, monitoring health.")
}

Rel(Connection_Pooler, Primary_Database_Instance, "Routes write transactions", "PostgreSQL Protocol, TLS 1.3")
Rel(Connection_Pooler, Read_Replica_Instance, "Routes read queries", "PostgreSQL Protocol, TLS 1.3")
Rel(Primary_Database_Instance, Read_Replica_Instance, "Replicates data", "Streaming Replication, TLS 1.3")
Rel(Failover_and_Consensus_Manager, Primary_Database_Instance, "Monitors health and manages failover", "TCP/HTTP")
Rel(Failover_and_Consensus_Manager, Read_Replica_Instance, "Monitors health and manages promotion", "TCP/HTTP")

@enduml