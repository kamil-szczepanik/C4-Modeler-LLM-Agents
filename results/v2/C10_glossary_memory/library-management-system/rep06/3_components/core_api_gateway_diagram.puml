@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(LibraryPatrons, "Library Patrons", "Users interacting with the library system")
System_Ext(EUIdentityP, "EU Identity Provider (IdP)", "OIDC")
System_Ext(CatalogSearchService, "Catalog & Search Service", "Java, Spring Boot, Elasticsearch")
System_Ext(CirculationService, "Circulation Service", "Java, Spring Boot")

Container_Boundary(CoreAPIGateway, "Core API Gateway") {
    Component(AuthenticationFilterComponent, "Authentication Filter Component", "Envoy OAuth2/OIDC filter", "Validates tokens and manages edge security authentication.")
    Component(RateLimitingComponent, "Rate Limiting Component", "Redis-backed Token Bucket", "Powers high-performance rate limiting aligned with EU data residency.")
    Component(RequestPrioritizationShapingComponent, "Request Prioritization & Shaping Component", "Envoy Traffic Director", "Enforces traffic shaping and prioritization to meet search SLAs.")
    Component(CircuitBreakerResilienceComponent, "Circuit Breaker & Resilience Component", "Spring Cloud Circuit Breaker", "Provides resilience and fault tolerance for gateway routing.")
    Component(RoutingLoadBalancingComponent, "Routing & Load Balancing Component", "Spring Cloud Gateway", "Manages edge routing, traffic distribution, and load balancing.")
}

Rel(LibraryPatrons, CoreAPIGateway, "Sends API requests", "HTTPS, TLS 1.3")
Rel(CoreAPIGateway, EUIdentityP, "Validates tokens", "OIDC over HTTPS")
Rel(CoreAPIGateway, CatalogSearchService, "Routes queries", "gRPC, mTLS")
Rel(CoreAPIGateway, CirculationService, "Routes requests", "gRPC, mTLS")

@enduml