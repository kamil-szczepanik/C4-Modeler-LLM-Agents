@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog & Search Service container

Container_Boundary(catalog_search_service, "Catalog & Search Service") {
    Component(SearchController, "Search Controller", "Java, Spring Boot", "Exposes endpoints for catalog search and handles incoming requests.")
    Component(SearchEngineClient, "Search Engine Client", "Java, Spring Boot", "Communicates with the Elasticsearch cluster to execute search queries.")
    Component(CatalogManager, "Catalog Manager", "Java, Spring Boot", "Manages catalog items and interacts with the primary database and digital content providers.")
    Component(MetadataIndexer, "Metadata Indexer", "Java, Spring Boot", "Indexes catalog metadata into the Elasticsearch cluster.")
    Component(DigitalAssetSynchronizer, "Digital Asset Synchronizer", "Java, Spring Boot", "Synchronizes digital assets and content providers with the system.")
}

System_Ext(ElasticsearchCluster, "Elasticsearch Cluster", "External Elasticsearch cluster for search and indexing.")
System_Ext(PrimaryDatabase, "Primary Database & Read Replica", "PostgreSQL database for transactional data.")
System_Ext(DigitalContentProviders, "Digital Content Providers", "External digital content providers via REST API.")

Rel(SearchController, SearchEngineClient, "In-Memory Java API")
Rel(SearchEngineClient, ElasticsearchCluster, "Transport Client / REST over HTTPS, mTLS")
Rel(CatalogManager, PrimaryDatabase, "PostgreSQL Protocol, SCRAM-SHA-256, TLS")
Rel(CatalogManager, DigitalContentProviders, "HTTPS (REST API), TLS 1.3, Certificate Pinning")
Rel(MetadataIndexer, ElasticsearchCluster, "REST over HTTPS, mTLS")
@enduml