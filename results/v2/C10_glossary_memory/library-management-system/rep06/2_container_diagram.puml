@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(Library_Patrons, "Library Patrons", "Students and public users who access the self-service portals and search the catalog.")
Person(Librarians, "Librarians", "Circulation staff who manage daily library operations and patron accounts.")
Person(Library_Administrators, "Library Administrators", "Administrators who oversee system configurations and manage diverse user personas.")

System_Ext(EU_Identity_Provider_IdP, "EU Identity Provider (IdP)", "Manages authentication and token exchange using OIDC.")
System_Ext(Payment_Gateway, "Payment Gateway", "Processes transactions via REST/JSON over HTTPS.")
System_Ext(Digital_Content_Providers, "Digital Content Providers", "Supplies external digital content and media via APIs over HTTPS.")

System_Boundary(Library_Management_System, "Library Management System") {
    Container(Patron_Web_App, "Patron Web App", "React, TypeScript", "Powers the responsive Patron Web App for fast client-side rendering.")
    Container(Staff_Web_App, "Staff Web App", "Angular, TypeScript", "Structures the robust Staff Web App for administrative workflows.")
    Container(Core_API_Gateway, "Core API Gateway", "Envoy, Spring Cloud Gateway", "Routes and manages incoming traffic and security boundaries.")
    Container(Catalog_Search_Service, "Catalog & Search Service", "Java, Spring Boot, Elasticsearch", "Implements high-performance microservices and meets the sub-800ms search SLA.")
    Container(Circulation_Service, "Circulation Service", "Java, Spring Boot", "Manages circulation workflows and patron accounts.")
    Container(Notification_Service, "Notification Service", "Node.js, TypeScript, RabbitMQ/Kafka", "Handles asynchronous notifications and messaging.")
    Container(Analytics_Reporting_Service, "Analytics & Reporting Service", "Python, FastAPI", "Processes reporting and analytics workloads.")
    ContainerDb(Primary_Database_Read_Replica, "Primary Database & Read Replica", "PostgreSQL", "Manages transactional data with strict EU-only data residency constraints.")
}

Rel(Library_Patrons, Patron_Web_App, "Accesses self-service portals and searches the catalog", "HTTPS, TLS 1.3")
Rel(Librarians, Staff_Web_App, "Manages daily library operations and patron accounts", "HTTPS, TLS 1.3")
Rel(Library_Administrators, Staff_Web_App, "Oversees system configurations and user personas", "HTTPS, TLS 1.3")
Rel(Patron_Web_App, Core_API_Gateway, "Sends API requests", "HTTPS, TLS 1.3")
Rel(Staff_Web_App, Core_API_Gateway, "Sends API requests", "HTTPS, TLS 1.3")
Rel(Core_API_Gateway, Catalog_Search_Service, "Routes search and catalog queries", "gRPC / HTTPS, mTLS")
Rel(Core_API_Gateway, Circulation_Service, "Routes circulation requests", "gRPC / HTTPS, mTLS")
Rel(Core_API_Gateway, Notification_Service, "Triggers notifications", "gRPC / HTTPS, mTLS")
Rel(Core_API_Gateway, Analytics_Reporting_Service, "Sends reporting requests", "gRPC / HTTPS, mTLS")
Rel(Core_API_Gateway, EU_Identity_Provider_IdP, "Authenticates users and validates tokens", "OIDC over HTTPS")
Rel(Circulation_Service, Payment_Gateway, "Processes fines and financial transactions", "REST/JSON, mTLS over HTTPS")
Rel(Catalog_Search_Service, Primary_Database_Read_Replica, "Reads and writes catalog data", "PostgreSQL Protocol")
Rel(Circulation_Service, Primary_Database_Read_Replica, "Reads and writes transaction and user data", "PostgreSQL Protocol")
Rel(Core_API_Gateway, Digital_Content_Providers, "Retrieves digital content and media resources", "API over HTTPS")

@enduml