@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Library_Member_Patron, "Library Member (Patron)", "End-user who accesses self-service portals for searching catalogs and managing loans.")
Person(Librarian_Staff, "Librarian / Staff", "Library personnel who manage circulation, cataloging, and day-to-day operations.")
Person(Library_Administrator, "Library Administrator", "System administrator responsible for managing the library management system configuration and settings.")

System(Library_Management_System, "Library Management System", "Provides cataloging, circulation management, and self-service portals for public and academic libraries while enforcing strict EU-only data residency and high-performance search capabilities.")

System_Ext(Payment_Gateway, "Payment Gateway", "External system used for processing fine settlements.")
System_Ext(Notification_Provider, "Notification Provider", "External system used for sending out loan reminders and alerts.")
System_Ext(Identity_Provider, "Identity Provider", "External system used for user authentication and identity management.")

Rel(Library_Member_Patron, Library_Management_System, "Interacts with the system via self-service portals", "HTTPS / TLS 1.3")
Rel(Librarian_Staff, Library_Management_System, "Manages circulation and cataloging", "HTTPS / TLS 1.3")
Rel(Library_Administrator, Library_Management_System, "Administers the system", "HTTPS / TLS 1.3")
Rel(Library_Management_System, Payment_Gateway, "Integrates for fine settlements", "HTTPS/REST")
Rel(Library_Management_System, Notification_Provider, "Integrates for loan reminders", "HTTPS/REST")
Rel(Library_Management_System, Identity_Provider, "Authenticates users", "OIDC/OAuth2 over HTTPS")
@enduml