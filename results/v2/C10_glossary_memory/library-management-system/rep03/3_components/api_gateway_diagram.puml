@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Edge_Router_Reverse_Proxy, "Edge Router & Reverse Proxy", "NGINX / Envoy", "Provides high-performance edge routing and load balancing for incoming requests.")
    Component(TLS_Termination_Security_Manager, "TLS Termination & Security Manager", "NGINX / Envoy", "Handles mTLS termination and enforces secure communication boundaries.")
    Component(Rate_Limiter_Auth_Validator, "Rate Limiter & Auth Validator", "NGINX / Envoy", "Applies rate limiting rules and validates OIDC tokens against the Identity Provider.")
}

Rel(Edge_Router_Reverse_Proxy, TLS_Termination_Security_Manager, "Passes decrypted traffic securely")
Rel(TLS_Termination_Security_Manager, Rate_Limiter_Auth_Validator, "Evaluates authentication and request rate")

@enduml