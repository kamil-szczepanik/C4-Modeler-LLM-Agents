@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(MessageBroker, "Message Broker", "Apache Kafka / RabbitMQ")
System_Ext(ApiGateway, "API Gateway", "NGINX / Envoy")

Container_Boundary(audit_service, "Audit Service") {
    Component(AuditConsumer, "Audit Consumer", "Go", "Consumes audit events from the message broker and writes them to the audit database.")
    Component(AuditApiHandler, "Audit API Handler", "Go", "Handles incoming API requests for audit data and queries the audit database.")
    Component(AuditDatabase, "Audit Database", "PostgreSQL", "Immutable audit data store enforcing EU-only data residency.")
}

Rel(MessageBroker, AuditConsumer, "AMQP/Kafka Protocol over mTLS")
Rel(ApiGateway, AuditApiHandler, "gRPC over mTLS")
Rel(AuditConsumer, AuditDatabase, "SQL over mTLS")
Rel(AuditApiHandler, AuditDatabase, "SQL over mTLS")
@enduml