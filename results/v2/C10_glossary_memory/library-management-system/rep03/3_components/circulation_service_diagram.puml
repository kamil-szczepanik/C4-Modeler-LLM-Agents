@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(circulation_service, "Circulation Service") {
    Component(Circulation_Controller, "Circulation Controller", "NestJS Controller", "Handles incoming REST/gRPC endpoints for loan, return, and fine operations.")
    Component(Loan_Management_Service, "Loan Management Service", "NestJS Service", "Contains business logic for processing book loans, renewals, and returns.")
    Component(Fine_Management_Service, "Fine Management Service", "NestJS Service", "Manages fine calculations and processing integration.")
    Component(Database_Repository, "Database Repository", "TypeORM / PostgreSQL Client", "Handles secure persistence and querying of relational transactional data.")
}

Rel(Circulation_Controller, Loan_Management_Service, "Delegates loan and return requests")
Rel(Circulation_Controller, Fine_Management_Service, "Delegates fine settlement operations")
Rel(Loan_Management_Service, Database_Repository, "Reads and writes transactional data")
Rel(Fine_Management_Service, Database_Repository, "Updates fine records")

@enduml