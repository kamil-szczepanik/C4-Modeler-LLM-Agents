@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog & Search Service container

Container_Boundary(catalog_search_service, "Catalog & Search Service") {
    Component(SearchQueryEngine, "Search Query Engine", "Java, Spring Data Elasticsearch", "Handles high-performance search queries ensuring sub-800ms response times.")
    Component(CatalogManagementAPI, "Catalog Management API", "Java, Spring MVC", "Manages cataloging operations and librarian updates securely.")
    Component(IndexSynchronizationWorker, "Index Synchronization Worker", "Java, Spring Integration", "Asynchronous worker responsible for event-driven index synchronization.")
    Component(ElasticsearchIndex, "Elasticsearch Index", "Elasticsearch", "High-speed search index for fast retrieval.")
}

Container(Database, "Database", "PostgreSQL", "Relational database providing ACID-compliant transactional persistence.")
Container(ApiGateway, "API Gateway", "NGINX / Envoy", "Edge routing, TLS termination, and OIDC token validation.")
Container(MessageBroker, "Message Broker", "Apache Kafka / RabbitMQ", "Asynchronous message broker for event-driven index synchronization.")
Container(AuditService, "Audit Service", "Go", "High-performance audit logging service ensuring compliance with security constraints.")

Rel(ApiGateway, SearchQueryEngine, "gRPC over mTLS")
Rel(ApiGateway, CatalogManagementAPI, "gRPC over mTLS")
Rel(SearchQueryEngine, ElasticsearchIndex, "Internal Java API / Transport over mTLS")
Rel(CatalogManagementAPI, Database, "SQL over mTLS")
Rel(IndexSynchronizationWorker, MessageBroker, "AMQP/Kafka Protocol over mTLS")
Rel(IndexSynchronizationWorker, Database, "SQL over mTLS")
Rel(CatalogManagementAPI, AuditService, "REST over mTLS")

@enduml