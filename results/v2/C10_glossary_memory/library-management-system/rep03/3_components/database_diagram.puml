@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database container

Container_Boundary(database, "Database") {
    Component(Relational Data Store, "Relational Data Store", "PostgreSQL Engine", "Provides robust ACID compliance and row-level security for transactional integrity.")
    Component(Connection Pooler, "Connection Pooler", "PgBouncer", "Manages and optimizes incoming database connections under peak load.")
    Component(Audit Logging Module, "Audit Logging Module", "pgAudit", "Captures security-relevant DDL/DML events for compliance.")
    Component(HA Failover Manager, "HA Failover Manager", "Patroni", "Handles automated leader election and high availability across availability zones.")
    Component(Backup & Archival Agent, "Backup & Archival Agent", "Barman / WAL-G", "Manages continuous WAL archiving and point-in-time recovery.")
    Component(Circulation Service, "Circulation Service", "Node.js / NestJS", "Manages loans, fines, and business integrations.")
    Component(Catalog & Search Service, "Catalog & Search Service", "Java, Spring Boot + Elasticsearch", "Dedicated to meeting sub-800ms search and cataloging requirements.")
}

Rel(Circulation Service, Connection Pooler, "Submits loan and fine transactions", "SQL over mTLS")
Rel(Catalog & Search Service, Connection Pooler, "Queries and updates item metadata", "SQL over mTLS")
Rel(Connection Pooler, Relational Data Store, "Forwards pooled queries", "TCP/IP")
Rel(Relational Data Store, Audit Logging Module, "Emits audit logs", "Internal IPC")

@enduml