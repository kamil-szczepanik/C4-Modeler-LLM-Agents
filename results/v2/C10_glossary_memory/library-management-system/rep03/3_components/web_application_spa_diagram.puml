@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(web_app, "Web Application / SPA") {
    Component(UI_Framework_Core, "UI Framework Core", "React, TypeScript", "Provides modular component architecture, UI views for patrons and staff, and role-based feature toggling.")
}

System_Ext(API_Gateway, "API Gateway", "NGINX / Envoy")

Rel(UI_Framework_Core, API_Gateway, "Sends requests", "HTTPS/TLS 1.3")

@enduml