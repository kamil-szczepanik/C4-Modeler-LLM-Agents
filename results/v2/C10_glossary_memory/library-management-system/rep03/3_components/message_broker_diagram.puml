@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Message Broker container

System_Boundary(message_broker, "Message Broker") {
    Component(KafkaEventBus, "Kafka Event Bus", "Apache Kafka", "Persistent, event-driven message broker supporting dead-letter queues and EU data residency for asynchronous communication between services.")
    Component(CatalogEventsTopic, "Catalog Events Topic", "Kafka Topic", "Stores catalog and search-related asynchronous events.")
    Component(CirculationEventsTopic, "Circulation Events Topic", "Kafka Topic", "Stores loan, fine, and circulation-related asynchronous events.")
    Component(AuditEventsTopic, "Audit Events Topic", "Kafka Topic", "Stores security and compliance audit event streams.")
}

Rel(Catalog_Search_Service, KafkaEventBus, "Publishes and consumes search-related events over mTLS", "Kafka Protocol")
Rel(Circulation_Service, KafkaEventBus, "Publishes and consumes circulation-related events over mTLS", "Kafka Protocol")
Rel(Audit_Service, KafkaEventBus, "Consumes audit logs and compliance events over mTLS", "Kafka Protocol")

@enduml