@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(Library_Member_Patron, "Library Member (Patron)", "End-user who accesses self-service portals for searching catalogs and managing loans.")
Person(Librarian_Staff, "Librarian / Staff", "Library personnel who manage circulation, cataloging, and day-to-day operations.")
Person(Library_Administrator, "Library Administrator", "System administrator responsible for managing the library management system configuration and settings.")

System_Ext(Payment_Gateway, "Payment Gateway", "External system used for processing fine settlements.")
System_Ext(Notification_Provider, "Notification Provider", "External system used for sending out loan reminders and alerts.")
System_Ext(Identity_Provider, "Identity Provider", "External system used for user authentication and identity management.")

System_Boundary(Library_Management_System, "Library Management System") {
    Container(Web_Application_SPA, "Web Application / SPA", "React, TypeScript", "UI logic for patrons and staff providing cataloging, circulation management, and self-service portals.")
    Container(API_Gateway, "API Gateway", "NGINX / Envoy", "Edge routing, TLS termination, and OIDC token validation.")
    Container(Catalog_Search_Service, "Catalog & Search Service", "Java, Spring Boot + Elasticsearch", "Dedicated to meeting sub-800ms search and cataloging requirements.")
    Container(Circulation_Service, "Circulation Service", "Node.js / NestJS", "Manages loans, fines, and business integrations.")
    ContainerDb(Database, "Database", "PostgreSQL", "Primary relational data store for transactional data.")
    Container(Message_Broker, "Message Broker", "Apache Kafka / RabbitMQ", "Asynchronous, event-driven communication.")
    Container(Audit_Service, "Audit Service", "Go", "High-performance audit logging service ensuring compliance with security constraints.")
}

Rel(Library_Member_Patron, API_Gateway, "Accesses self-service portals", "HTTPS / TLS 1.3")
Rel(Librarian_Staff, API_Gateway, "Manages circulation and cataloging", "HTTPS / TLS 1.3")
Rel(Library_Administrator, API_Gateway, "Administers the system", "HTTPS / TLS 1.3")
Rel(API_Gateway, Catalog_Search_Service, "Routes search and catalog requests", "gRPC over mTLS")
Rel(API_Gateway, Circulation_Service, "Routes circulation requests", "gRPC over mTLS")
Rel(Circulation_Service, Message_Broker, "Publishes and consumes asynchronous events", "AMQP/Kafka Protocol over mTLS")
Rel(Circulation_Service, Database, "Reads and writes transactional data", "SQL over mTLS")
Rel(Catalog_Search_Service, Database, "Reads and writes catalog data", "SQL over mTLS")
Rel(Circulation_Service, Audit_Service, "Sends audit logs", "REST over mTLS")
Rel(Circulation_Service, Payment_Gateway, "Processes fine settlements", "HTTPS/REST")
Rel(Circulation_Service, Notification_Provider, "Sends loan reminders and alerts", "HTTPS/REST")
Rel(API_Gateway, Identity_Provider, "Validates and authenticates user identities", "OIDC/OAuth2 over HTTPS")

@enduml