@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Reporting & Analytics Service container

System_Ext(api_gateway, "API Gateway", "External API Gateway")

Container_Boundary(reporting_analytics_service, "Reporting & Analytics Service") {
    Component(api_controller, "API Controller", "FastAPI Router", "Routes HTTP/2 reverse proxy requests and manages low-latency asynchronous API handling.")
    Component(report_generation_engine, "Report Generation Engine", "Pandas / NumPy", "Processes heavy data frames for executive reports and delegates tasks via internal Python function calls.")
    Component(data_access_repository, "Data Access Repository", "SQLAlchemy", "Fetches pseudonymized data using SQLAlchemy ORM and SQL queries.")
    Component(alert_evaluation_worker, "Alert Evaluation Worker", "Celery / Background Tasks", "Manages asynchronous background worker tasks, queues, and triggers threshold alerts.")
}

Component(admin_console, "Administration Console", "Web App", "Console for library administrators to manage reporting, inventory, and budgets.")
Component(circulation_loan_service, "Circulation & Loan Service", "Node.js / Express", "Manages item circulation, loans, and transactional state.")
Component(notification_dispatcher, "Notification Dispatcher", "Go", "Dispatches asynchronous notifications.")
Component(postgresql_database, "PostgreSQL Database", "PostgreSQL 15", "Stores transactional state and analytics data using read-replicas.")

Rel(api_gateway, api_controller, "Routes HTTP/2 reverse proxy requests", "HTTP/2")
Rel(circulation_loan_service, api_controller, "Handles interservice communication", "gRPC over TLS 1.3 / mTLS")
Rel(api_controller, report_generation_engine, "Delegates tasks", "Internal Python function call / task queue")
Rel(report_generation_engine, data_access_repository, "Fetches pseudonymized data", "SQLAlchemy ORM / SQL query")
Rel(data_access_repository, postgresql_database, "Queries analytics data", "SQL / PostgreSQL protocol")
Rel(alert_evaluation_worker, notification_dispatcher, "Triggers threshold alerts", "gRPC over TLS 1.3")

@enduml