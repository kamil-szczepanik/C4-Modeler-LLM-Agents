@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Circulation & Loan Service container

Container_Boundary(circulation_loan_service, "Circulation & Loan Service") {
    Component(LoanOrchestrator, "Loan Orchestrator", "Node.js / Express", "Orchestrates item circulation, loans, and transactional state.")
    Component(FineFeeManager, "Fine & Fee Manager", "Node.js / Express", "Manages fine and fee collection and processing.")
    Component(LoanDataAccessRepository, "Loan Data Access Repository", "Sequelize ORM", "Manages transactional state against PostgreSQL with strict ACID isolation.")
    Component(EventPublisher, "Event Publisher", "amqplib", "Publishes asynchronous events to the message broker.")
}

Component(APIGateway, "API Gateway", "NGINX / Kong", "Handles TLS termination, WAF policies, and routing for all incoming traffic.")
Component(PostgreSQLDatabase, "PostgreSQL Database", "PostgreSQL 15", "Stores transactional state and analytics data.")
Component(RabbitMQ, "RabbitMQ", "Message Broker", "Facilitates asynchronous event-driven messaging.")
Component(PaymentGateway, "Payment Gateway", "Adyen/Stripe EU", "External payment processing.")

Rel(APIGateway, LoanOrchestrator, "HTTP/2 reverse proxy", "HTTP/2")
Rel(LoanOrchestrator, FineFeeManager, "In-memory function call", "Function Call")
Rel(LoanOrchestrator, LoanDataAccessRepository, "TypeScript Async/Await", "Async/Await")
Rel(LoanOrchestrator, EventPublisher, "AMQP protocol", "AMQP")
Rel(FineFeeManager, PaymentGateway, "REST / HTTPS over TLS 1.3", "HTTPS")
Rel(LoanDataAccessRepository, PostgreSQLDatabase, "SQL / PostgreSQL protocol over TLS 1.3", "SQL/TLS")
Rel(EventPublisher, RabbitMQ, "AMQP over TLS 1.3", "AMQP/TLS")

@enduml