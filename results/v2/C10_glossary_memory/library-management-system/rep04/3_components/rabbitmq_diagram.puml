@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the RabbitMQ container

Container_Boundary(RabbitMQ, "RabbitMQ") {
  Component(ExchangeRouter, "Exchange Router", "Erlang / Direct & Topic Exchanges", "Routes incoming published messages to target queues based on exchange rules.")
  Component(QueueManager, "Queue Manager", "Erlang / Mnesia", "Manages queue state, durable message storage, and queue operations.")
  Component(DLQPolicyEngine, "DLQ & Policy Engine", "Erlang", "Handles poisoned messages and routes them to dead-letter queues according to defined policies.")
  Component(MetricsExporter, "Metrics Exporter", "Erlang / Prometheus Plugin", "Extracts runtime and depth metrics for monitoring with low overhead.")
}

Component(CatalogSearchService, "Catalog & Search Service", "Spring Boot, Elasticsearch", "External service publishing catalogue events to the broker.")
Component(CirculationLoanService, "Circulation & Loan Service", "Node.js / Express", "External service publishing loan and payment events to the broker.")
Component(NotificationDispatcher, "Notification Dispatcher", "Go", "External service consuming queued events to dispatch asynchronous notifications.")

Rel(CatalogSearchService, ExchangeRouter, "Publishes catalogue events", "AMQP 0-9-1 over TLS 1.3 with mTLS")
Rel(CirculationLoanService, ExchangeRouter, "Publishes loan and payment events", "AMQP 0-9-1 over TLS 1.3 with mTLS")
Rel(ExchangeRouter, QueueManager, "Dispatches messages to target queues", "Internal Erlang messaging")
Rel(QueueManager, NotificationDispatcher, "Consumes queued events", "AMQP 0-9-1 over TLS 1.3")
Rel(QueueManager, DLQPolicyEngine, "Routes poisoned messages", "Internal Erlang messaging")
Rel(QueueManager, MetricsExporter, "Feeds runtime and depth metrics", "Internal Erlang messaging")

@enduml