@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container(RabbitMQ, "RabbitMQ", "Message Broker", "Facilitates asynchronous event-driven messaging with Dead-Letter Exchange support.")
System_Ext("Notification Service", "Notification Service", "External service for sending system notifications.")

Container_Boundary("Notification Dispatcher", "Notification Dispatcher") {
    Component(Event_Consumer, "Event Consumer", "Go / AMQP", "Consumes notification events from RabbitMQ.")
    Component(Notification_Router, "Notification Router", "Go", "Routes notification events to the appropriate template engine.")
    Component(Template_Engine, "Template Engine", "Go", "Processes notification templates.")
    Component(Delivery_Worker_Pool, "Delivery Worker Pool", "Go", "Manages worker pool for dispatching notifications.")
    Component(External_Client_Adapter, "External Client Adapter", "Go / HTTP Client", "Adapts calls to external notification services.")
    Component(Audit_Logger, "Audit Logger", "Go", "Logs dispatch actions for auditing and compliance.")
}

Rel(RabbitMQ, Event_Consumer, "Consumes notification events", "AMQP over TLS 1.3")
Rel(Event_Consumer, Notification_Router, "Internal function call")
Rel(Notification_Router, Template_Engine, "Internal function call")
Rel(Template_Engine, Delivery_Worker_Pool, "Internal channel-based dispatch")
Rel(Delivery_Worker_Pool, External_Client_Adapter, "Internal function call")
Rel(External_Client_Adapter, "Notification Service", "Sends notifications", "REST / HTTPS over TLS 1.3 with mTLS/OAuth 2.0")

@enduml