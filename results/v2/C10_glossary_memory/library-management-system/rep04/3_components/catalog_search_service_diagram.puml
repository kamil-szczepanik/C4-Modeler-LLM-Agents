@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Catalog & Search Service", "Catalog & Search Service") {
    Component("Catalog & Search Controller", "Catalog & Search Controller", "Spring MVC REST Controller", "Exposes HTTP endpoints for catalog discovery, faceted search queries, and digital content aggregation, enforcing the <800ms SLA.")
    Component("Search Query Engine", "Search Query Engine", "Spring Boot Service, Elasticsearch Client", "Processes search queries, optimizes indexing, and manages high-performance caching for rapid item discovery.")
    Component("Content Integrator", "Content Integrator", "Spring WebClient / RestTemplate", "Integrates with external Digital Content Providers to fetch and cache e-Book and digital metadata securely over TLS 1.3.")
    Component("Event Publisher", "Event Publisher", "Spring AMQP", "Publishes catalog and search-related domain events asynchronously to RabbitMQ using AMQP over TLS 1.3.")
}

Rel("Catalog & Search Controller", "Search Query Engine", "Delegates search and retrieval requests")
Rel("Search Query Engine", "Content Integrator", "Requests digital metadata from external content providers when needed")
Rel("Search Query Engine", "Event Publisher", "Dispatches search index and catalog modification events")
@enduml