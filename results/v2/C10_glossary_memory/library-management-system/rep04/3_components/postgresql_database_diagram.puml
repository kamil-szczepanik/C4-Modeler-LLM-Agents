@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL Database container

Container_Boundary(postgresql_database, "PostgreSQL Database") {
    Component(Primary_Database_Instance, "Primary Database Instance", "PostgreSQL 15", "Handles transactional read/write operations for the Circulation & Loan Service.")
    Component(Analytics_Read_Replica, "Analytics Read-Replica", "PostgreSQL 15 Read-Replica", "Dedicated replica serving heavy analytical queries from the Reporting & Analytics Service.")
    Component(PgBouncer_Connection_Pooler, "PgBouncer Connection Pooler", "PgBouncer", "Manages client connections efficiently to prevent resource exhaustion.")
    Component(Data_Anonymization_Engine, "Data Anonymization Engine", "Scheduled PL/pgSQL routines", "Executing automated pseudonymization of PII for closed accounts.")
    Component(Security_Governance_Controls, "Security & Governance Controls", "Row-Level Security (RLS) policies, pgAudit logging, TLS 1.3 / mTLS enforcement", "Enforces security policies, audit logging, and encryption for the database.")
}

Rel(PgBouncer_Connection_Pooler, Primary_Database_Instance, "Forwards write traffic", "SQL / PostgreSQL protocol")
Rel(PgBouncer_Connection_Pooler, Analytics_Read_Replica, "Forwards read-only analytical traffic", "SQL / PostgreSQL protocol")

@enduml