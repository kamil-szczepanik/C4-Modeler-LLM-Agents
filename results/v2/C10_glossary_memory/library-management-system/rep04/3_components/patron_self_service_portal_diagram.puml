@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Library_Patrons, "Library Patrons", "Students and public users accessing self-service portals.")

System_Ext(API_Gateway, "API Gateway", "NGINX / Kong", "Handles TLS termination, WAF policies, and routing for all incoming traffic.")
System_Ext(Identity_Provider, "Identity Provider", "Keycloak / Auth0 EU", "Authentication and identity management.")
System_Ext(Circulation_Loan_Service, "Circulation & Loan Service", "Node.js / Express", "Manages item circulation, loans, and transactional state.")
System_Ext(Digital_Content_Providers, "Digital Content Providers", "External e-Book Vendors", "External providers of digital e-Book content.")

Container_Boundary(Patron_Self_Service_Portal, "Patron Self-Service Portal") {
    Component(UIRouting_Layout_Component, "UI Routing & Layout Component", "React / TypeScript", "Manages client-side routing, layout structure, and navigation across the portal.")
    Component(Catalogue_Search_Discovery_Component, "Catalogue Search & Discovery Component", "React / TypeScript", "Enables public and academic library patrons to discover catalogue items.")
    Component(Loan_Account_Management_Component, "Loan & Account Management Component", "React / TypeScript", "Allows patrons to manage their loans and account details.")
    Component(Payment_Fine_Settlement_Component, "Payment & Fine Settlement Component", "React / TypeScript", "Handles the UI flow for settling fines and making payments securely.")
    Component(Digital_Content_Viewer_Component, "Digital Content Viewer Component", "React / TypeScript", "Provides viewing capabilities for digital content and e-books.")
}

Rel(Library_Patrons, Patron_Self_Service_Portal, "Uses", "HTTPS")
Rel(Patron_Self_Service_Portal, API_Gateway, "HTTPS / TLS 1.3", "HTTPS / TLS 1.3")
Rel(Patron_Self_Service_Portal, Identity_Provider, "OIDC / OAuth 2.0 over HTTPS with PKCE", "OIDC / OAuth 2.0")
Rel(Payment_Fine_Settlement_Component, Circulation_Loan_Service, "REST / HTTPS over TLS 1.3 via Gateway", "REST / HTTPS")
Rel(Digital_Content_Viewer_Component, Digital_Content_Providers, "REST / HTTPS over TLS 1.3", "REST / HTTPS")

@enduml