@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("API Gateway", "API Gateway") {
    Component(WAF, "WAF", "NGINX / Kong WAF Module", "Inspects incoming HTTP/HTTPS traffic to block common web exploits and enforce edge security.")
    Component(JWT_Validation, "JWT Validation", "NGINX / Kong JWT Plugin", "Validates JSON Web Tokens against the Identity Provider for incoming requests.")
    Component(Rate_Limiting, "Rate Limiting", "NGINX / Kong Rate Limiting Plugin", "Throttles incoming requests to ensure high-availability performance and prevent abuse.")
    Component(Reverse_Proxy, "Reverse Proxy", "NGINX / Kong Core Proxy", "Routes verified requests to backend microservices via HTTP/2 over TLS 1.3 (mTLS).")
}

Rel(WAF, JWT_Validation, "Passes inspected requests for authentication")
Rel(JWT_Validation, Rate_Limiting, "Passes authenticated requests for rate limit evaluation")
Rel(Rate_Limiting, Reverse_Proxy, "Forwards allowed requests to internal microservices")

@enduml