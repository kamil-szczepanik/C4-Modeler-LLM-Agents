@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(LibraryAdministrators, "Library Administrators", "System users managing inventory, budgets, and reporting.")

System_Ext(IdentityProvider, "Identity Provider", "Keycloak/Auth0 EU")
Container(APIGateway, "API Gateway", "NGINX / Kong", "Gateway for routing requests.")
Container(ReportingAnalyticsService, "Reporting & Analytics Service", "Python / FastAPI", "Provides reporting and analytics.")

Container_Boundary(AdministrationConsole, "Administration Console") {
    Component(AuthenticationManager, "Authentication Manager", "React / OIDC Client", "Manages OIDC / OAuth 2.0 authentication flows with PKCE and secures session storage.")
    Component(DashboardUIModule, "Dashboard UI Module", "React Component", "Provides a responsive, component-driven user interface for administrative workflows and high-level metrics.")
    Component(ReportingEngineClient, "Reporting Engine Client", "React / REST Client", "Interfaces with the Reporting & Analytics Service to retrieve reporting and vendor ROI analytics.")
    Component(InventoryBudgetManagementModule, "Inventory & Budget Management Module", "React Component", "Empowers Library Administrators to manage library inventory and financial budgets.")
    Component(VendorAnalyticsModule, "Vendor Analytics Module", "React Component", "Displays analytics and insights regarding vendor performance and ROI.")
}

Rel(LibraryAdministrators, AdministrationConsole, "HTTPS / WAF-protected API Gateway")
Rel(AdministrationConsole, IdentityProvider, "OIDC / OAuth 2.0 over HTTPS with PKCE")
Rel(AdministrationConsole, APIGateway, "REST / HTTPS over TLS 1.3")
Rel(AdministrationConsole, ReportingAnalyticsService, "REST / HTTPS over TLS 1.3 via API Gateway")

@enduml