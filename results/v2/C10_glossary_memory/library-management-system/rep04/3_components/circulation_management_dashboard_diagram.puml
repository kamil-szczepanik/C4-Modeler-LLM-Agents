@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Librarians_Circulation_Staff, "Librarians / Circulation Staff", "Interacts with circulation workflows")
System_Ext(API_Gateway, "API Gateway", "NGINX / Kong")
System_Ext(Identity_Provider, "Identity Provider", "Keycloak/Auth0 EU")
System_Ext(Circulation_Loan_Service, "Circulation & Loan Service", "Node.js / Express")

Container_Boundary(Circulation_Management_Dashboard, "Circulation Management Dashboard") {
    Component(IndexedDB_Local_Cache, "IndexedDB Local Cache", "IndexedDB with Web Crypto API", "Provides encrypted client-side storage to safely buffer offline transactions at rest.")
    Component(Sync_Manager, "Sync Manager", "TypeScript", "Manages encrypted offline operations and flushes queued offline transactions to the API Gateway.")
    Component(Loan_Processing_Component, "Loan Processing Component", "React / TypeScript", "Empowers staff to execute rapid check-outs, returns, and processes loans via the Circulation & Loan Service.")
    Component(Exception_Management_Component, "Exception Management Component", "React / TypeScript", "Handles exception management and resolves workflow anomalies.")
}

Rel(Librarians_Circulation_Staff, Circulation_Management_Dashboard, "Interacts with circulation workflows", "HTTPS")
Rel(Circulation_Management_Dashboard, API_Gateway, "Routes synchronous operational commands and flushes queued offline transactions", "REST / JSON over HTTPS / TLS 1.3")
Rel(Circulation_Management_Dashboard, Identity_Provider, "Manages session tokens and authentication", "OIDC / OAuth 2.0 over HTTPS with PKCE")
Rel(Circulation_Management_Dashboard, Circulation_Loan_Service, "Processes loans and resolves exceptions (via API Gateway)", "REST / JSON over HTTPS / TLS 1.3")
@enduml