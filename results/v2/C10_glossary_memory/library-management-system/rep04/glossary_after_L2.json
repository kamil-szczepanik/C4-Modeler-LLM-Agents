{
 "entities": [
  {
   "name": "Library Management System",
   "type": "softwareSystem",
   "level": "context",
   "description": "A cloud-native enterprise solution that enables public and academic libraries to catalogue physical and digital items, manage circulation, and provide self-service portals with EU-only data residency and security compliance."
  },
  {
   "name": "Library Patrons",
   "type": "person",
   "level": "context",
   "description": "Students and public users accessing self-service portals."
  },
  {
   "name": "Librarians / Circulation Staff",
   "type": "person",
   "level": "context",
   "description": "Staff managing item cataloguing and circulation workflows."
  },
  {
   "name": "Library Administrators",
   "type": "person",
   "level": "context",
   "description": "Personnel managing system reporting, inventory, and budgets."
  },
  {
   "name": "Payment Gateway",
   "type": "externalSystem",
   "level": "context",
   "description": "External payment processing (Adyen/Stripe EU)."
  },
  {
   "name": "Digital Content Providers",
   "type": "externalSystem",
   "level": "context",
   "description": "External e-Book Vendors providing digital content."
  },
  {
   "name": "Notification Service",
   "type": "externalSystem",
   "level": "context",
   "description": "External service for sending system notifications."
  },
  {
   "name": "Identity Provider",
   "type": "externalSystem",
   "level": "context",
   "description": "Authentication and identity management (Keycloak/Auth0 EU)."
  },
  {
   "name": "Patron Self-Service Portal",
   "type": "container",
   "level": "container",
   "description": "Provides self-service capabilities for library patrons.",
   "technology": "Web/Mobile App"
  },
  {
   "name": "Circulation Management Dashboard",
   "type": "container",
   "level": "container",
   "description": "Dashboard for librarians and circulation staff to manage circulation workflows.",
   "technology": "Web App"
  },
  {
   "name": "Administration Console",
   "type": "container",
   "level": "container",
   "description": "Console for library administrators to manage reporting, inventory, and budgets.",
   "technology": "Web App"
  },
  {
   "name": "API Gateway",
   "type": "container",
   "level": "container",
   "description": "Handles TLS termination, WAF policies, and routing for all incoming traffic.",
   "technology": "NGINX / Kong"
  },
  {
   "name": "Catalog & Search Service",
   "type": "container",
   "level": "container",
   "description": "Manages catalogue queries and search operations.",
   "technology": "Spring Boot, Elasticsearch"
  },
  {
   "name": "Circulation & Loan Service",
   "type": "container",
   "level": "container",
   "description": "Manages item circulation, loans, and transactional state.",
   "technology": "Node.js / Express"
  },
  {
   "name": "Reporting & Analytics Service",
   "type": "container",
   "level": "container",
   "description": "Handles reporting and analytics workloads.",
   "technology": "Python / FastAPI"
  },
  {
   "name": "Notification Dispatcher",
   "type": "container",
   "level": "container",
   "description": "Dispatches asynchronous notifications.",
   "technology": "Go"
  },
  {
   "name": "PostgreSQL Database",
   "type": "container",
   "level": "container",
   "description": "Stores transactional state and analytics data.",
   "technology": "PostgreSQL 15"
  },
  {
   "name": "RabbitMQ",
   "type": "container",
   "level": "container",
   "description": "Facilitates asynchronous event-driven messaging.",
   "technology": "Message Broker"
  }
 ],
