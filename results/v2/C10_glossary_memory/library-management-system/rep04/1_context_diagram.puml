@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Library Patrons, "Library Patrons", "Students and public users accessing self-service portals.")
Person(Librarians / Circulation Staff, "Librarians / Circulation Staff", "Staff managing item cataloguing and circulation workflows.")
Person(Library Administrators, "Library Administrators", "Personnel managing system reporting, inventory, and budgets.")

System(Library Management System, "Library Management System", "A cloud-native enterprise solution that enables public and academic libraries to catalogue physical and digital items, manage circulation, and provide self-service portals with EU-only data residency and security compliance.")

System_Ext(Payment Gateway, "Payment Gateway", "External payment processing (Adyen/Stripe EU).")
System_Ext(Digital Content Providers, "Digital Content Providers", "External e-Book Vendors providing digital content.")
System_Ext(Notification Service, "Notification Service", "External service for sending system notifications.")
System_Ext(Identity Provider, "Identity Provider", "Authentication and identity management (Keycloak/Auth0 EU).")

Rel(Library Patrons, Library Management System, "Interact via self-service portals", "HTTPS / WAF-protected API Gateway")
Rel(Librarians / Circulation Staff, Library Management System, "Manage cataloguing and circulation workflows", "HTTPS / WAF-protected API Gateway")
Rel(Library Administrators, Library Management System, "Manage system reporting, inventory, and budgets", "HTTPS / WAF-protected API Gateway")
Rel(Library Management System, Identity Provider, "Authenticates users", "OIDC / OAuth 2.0 over HTTPS")
Rel(Library Management System, Payment Gateway, "Processes payments securely", "REST / HTTPS over TLS 1.3")
Rel(Library Management System, Digital Content Providers, "Accesses digital items and e-books", "REST / HTTPS over TLS 1.3")
Rel(Library Management System, Notification Service, "Sends notifications to users", "REST / HTTPS over TLS 1.3")

@enduml