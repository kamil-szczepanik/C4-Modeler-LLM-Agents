@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Admin Console container

Container_Boundary(admin_console, "Admin Console") {
    Component(Admin UI Router & View Controller, "Admin UI Router & View Controller", "React/TypeScript SPA", "Provides a responsive, maintainable single-page application framework for administrative interfaces.")
    Component(System Configuration Client, "System Configuration Client", "TypeScript Module", "Enables Library Administrators to configure operations and system settings.")
    Component(Admin Authentication & Session Manager, "Admin Authentication & Session Manager", "OpenID Connect SDK", "Implements secure OIDC/OAuth2 authentication and multi-factor authentication flows.")
    Component(Audit & Telemetry Dispatcher, "Audit & Telemetry Dispatcher", "TypeScript Module", "Dispatches compliance audit events and operational telemetry.")
    Component(Reporting & Analytics Dashboard Module, "Reporting & Analytics Dashboard Module", "React/TypeScript Module", "Monitors metrics and generates reporting and analytics data for administrators.")
}

Component(API Gateway / BFF, "API Gateway / BFF", "Nginx/Envoy", "Handles edge routing, TLS termination, and rate limiting.")
Component(EU Identity Provider (IdP), "EU Identity Provider (IdP)", "External Service", "Provides authentication services via OIDC/OAuth2 with MFA for users and administrators.")
Component(EU Compliance & Audit Logging Service, "EU Compliance & Audit Logging Service", "External Service", "Receives exported audit events for compliance tracking.")
Component(EU Monitoring & APM Provider, "EU Monitoring & APM Provider", "External Service", "Receives operational telemetry to meet performance and latency requirements.")

Rel(Admin UI Router & View Controller, System Configuration Client, "In-memory TS calls")
Rel(Admin UI Router & View Controller, Reporting & Analytics Dashboard Module, "In-memory TS calls")
Rel(System Configuration Client, API Gateway / BFF, "HTTPS/REST, TLS 1.3")
Rel(Reporting & Analytics Dashboard Module, API Gateway / BFF, "HTTPS/REST, TLS 1.3")
Rel(Admin Authentication & Session Manager, EU Identity Provider (IdP), "OIDC/OAuth2, TLS 1.3")
Rel(Audit & Telemetry Dispatcher, EU Compliance & Audit Logging Service, "Syslog/HTTPS, TLS 1.3")
Rel(Audit & Telemetry Dispatcher, EU Monitoring & APM Provider, "OTLP/HTTPS, TLS 1.3")

@enduml