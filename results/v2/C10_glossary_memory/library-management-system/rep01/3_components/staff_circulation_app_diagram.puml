@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Staff Circulation App container

Person(Librarian_Staff, "Librarian / Staff", "Library staff member managing circulation workflows.")

System_Ext(Anycast_CDN_DDoS_Protection_Service_EU_PoPs, "Anycast CDN / DDoS Protection Service (EU-PoPs)", "Provides edge protection and content delivery.")
System_Ext(API_Gateway_BFF, "API Gateway / BFF", "Backend for Frontend and API routing.")
System_Ext(EU_Identity_Provider_IdP, "EU Identity Provider (IdP)", "Handles OIDC/OAuth2 authentication.")

Container_Boundary(Staff_Circulation_App, "Staff Circulation App") {
    Component(Circulation_Dashboard_Component, "Circulation Dashboard Component", "React SPA / TypeScript", "Provides the main interface for librarians to manage circulation workflows, checkouts, and returns.")
    Component(Patron_Lookup_Verification_Component, "Patron Lookup & Verification Component", "React SPA / TypeScript, IndexedDB & Web Crypto API", "Enables rapid patron search and verification, interfacing with local encrypted storage.")
    Component(Loan_Management_UI_Component, "Loan Management UI Component", "React SPA / TypeScript", "Manages active loans, renewals, and item status updates.")
    Component(Fine_Grained_Override_Management_Feature, "Fine-Grained Override Management Feature", "React SPA / TypeScript", "Allows authorized staff to apply circulation overrides based on permissions.")
    Component(Authentication_Session_Manager, "Authentication & Session Manager", "OIDC/OAuth2, React SPA / TypeScript", "Enforces secure multi-factor authentication and token-based session management via the EU Identity Provider.")
    Component(Offline_Sync_Caching_Service, "Offline Sync & Caching Service", "IndexedDB & Web Crypto API, AES-GCM", "Provides secure, encrypted offline-tolerant caching of patron PII and records during network partitions.")
    Component(Audit_Telemetry_Dispatcher, "Audit & Telemetry Dispatcher", "React SPA / TypeScript", "Dispatches audit logs and operational telemetry through the API Gateway.")
}

Rel(Librarian_Staff, Anycast_CDN_DDoS_Protection_Service_EU_PoPs, "Accesses via", "TLS 1.3, HTTPS")
Rel(Staff_Circulation_App, API_Gateway_BFF, "Communicates via", "HTTPS/REST")
Rel(Authentication_Session_Manager, EU_Identity_Provider_IdP, "Authenticates via", "OIDC/OAuth2")
Rel(Audit_Telemetry_Dispatcher, API_Gateway_BFF, "Sends audit and telemetry data via", "HTTPS/REST")
Rel(Patron_Lookup_Verification_Component, Offline_Sync_Caching_Service, "Reads and writes via", "Encrypted local storage (AES-GCM)")

@enduml