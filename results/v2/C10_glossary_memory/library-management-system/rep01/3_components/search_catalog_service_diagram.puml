@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Search & Catalog Service container

Container_Boundary("Search & Catalog Service", "Search & Catalog Service") {
    Component("Search API Controller", "Search API Controller", "Java / Spring Boot REST Controller", "Handles HTTP/gRPC requests for catalog searching and book discovery.")
    Component("Catalog Management Service", "Catalog Management Service", "Java / Spring Boot Service", "Business logic layer for managing library catalog entries and metadata.")
    Component("Elasticsearch Client Adapter", "Elasticsearch Client Adapter", "Elasticsearch Java REST Client", "Interfaces with the Elasticsearch cluster to execute high-performance sub-800ms search queries.")
}

Rel("Search API Controller", "Catalog Management Service", "Invokes business logic for search and catalog operations", "")
Rel("Catalog Management Service", "Elasticsearch Client Adapter", "Executes queries and indexes catalog records", "")

@enduml