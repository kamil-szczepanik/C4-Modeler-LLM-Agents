@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patron Portal container

Person(LibraryMemberPatron, "Library Member (Patron)", "Library patron accessing the portal.")
System_Ext(AnycastCDNCDNDDoSProtectionServiceEUPoPs, "Anycast CDN / DDoS Protection Service (EU-PoPs)", "Delivers static assets exclusively from EU points of presence.")
System_Ext(APIGatewayBFF, "API Gateway / BFF", "Nginx/Envoy acting as edge router and BFF.")
System_Ext(EUIdentityP_IdP, "EU Identity Provider (IdP)", "Authenticates users securely via OIDC/OAuth2.")
System_Ext(ThirdPartyDigitalContentProvidersOverDriveLibby, "Third-Party Digital Content Providers (OverDrive/Libby)", "External digital content providers.")
System_Ext(EUMonitoringAPMProvider, "EU Monitoring & APM Provider", "Monitors performance and telemetry.")

Container_Boundary(PatronPortal, "Patron Portal") {
    Component(CatalogDiscoveryUI, "Catalog Discovery UI", "React/TypeScript", "Component providing catalog discovery and search functionality.")
    Component(LoanManagementDashboardUI, "Loan Management Dashboard UI", "React/TypeScript", "Component providing loan management dashboard capabilities.")
    Component(DigitalContentAccessHandler, "Digital Content Access Handler", "React/TypeScript", "Component handling access to digital content.")
    Component(SessionAuthStateManager, "Session & Auth State Manager", "React/TypeScript", "Component managing user session and authentication state.")
}

Rel(LibraryMemberPatron, AnycastCDNCDNDDoSProtectionServiceEUPoPs, "TLS 1.3, HTTPS", "")
Rel(AnycastCDNCDNDDoSProtectionServiceEUPoPs, APIGatewayBFF, "TLS 1.3, HTTPS", "")
Rel(CatalogDiscoveryUI, APIGatewayBFF, "HTTPS/REST", "")
Rel(LoanManagementDashboardUI, APIGatewayBFF, "HTTPS/REST, WSS", "")
Rel(SessionAuthStateManager, EUIdentityP_IdP, "OIDC/OAuth2 via BFF", "")
Rel(DigitalContentAccessHandler, ThirdPartyDigitalContentProvidersOverDriveLibby, "Server-side OAuth2, HTTPS/REST via BFF", "")
Rel(PatronPortal, EUMonitoringAPMProvider, "OTLP/HTTPS", "")

@enduml