@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway / BFF container

Container_Boundary(api_gateway_bff, "API Gateway / BFF") {
    Component(Edge_Router_TLS_Termination_Component, "Edge Router & TLS Termination Component", "Envoy", "Handles edge routing, TLS 1.3 termination, and low-latency proxying.")
    Component(Authentication_JWT_Validation_Filter, "Authentication & JWT Validation Filter", "Envoy Filter / OIDC", "Validates JSON Web Tokens and handles authentication flows with the EU Identity Provider.")
    Component(Rate_Limiting_Threat_Protection_Component, "Rate Limiting & Threat Protection Component", "Envoy + Redis", "Protects catalog search and endpoints from scraping and excessive traffic using multi-AZ replicated Redis.")
    Component(BFF_Aggregator_Protocol_Translator, "BFF Aggregator & Protocol Translator", "Envoy / Go", "Translates external REST/WSS traffic to internal gRPC over mTLS for backend services.")
}

Rel(Edge_Router_TLS_Termination_Component, Authentication_JWT_Validation_Filter, "Passes terminated HTTPS traffic for token validation", "HTTPS")
Rel(Authentication_JWT_Validation_Filter, Rate_Limiting_Threat_Protection_Component, "Enforces rate limits on authenticated requests", "")
Rel(Rate_Limiting_Threat_Protection_Component, BFF_Aggregator_Protocol_Translator, "Routes validated and rate-limited traffic to the aggregator", "")
@enduml