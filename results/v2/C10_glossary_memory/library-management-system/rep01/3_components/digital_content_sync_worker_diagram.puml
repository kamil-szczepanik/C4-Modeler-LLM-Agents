@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Digital Content Sync Worker container

System_Ext(Circulation_Core_Engine, "Circulation & Core Engine", "Core system container")
System_Ext(Third_Party_Digital_Content_Providers_OverDrive_Libby, "Third-Party Digital Content Providers (OverDrive/Libby)", "External digital content provider")
System_Ext(Primary_Database, "Primary Database", "Primary data storage")
System_Ext(EU_Monitoring_APM_Provider, "EU Monitoring & APM Provider", "Monitoring and APM provider")

Container_Boundary(Digital_Content_Sync_Worker, "Digital Content Sync Worker") {
    Component(Sync_Task_Consumer, "Sync Task Consumer", "Node.js with TypeScript, Async Message Queues (RabbitMQ/Redis)", "Queues and consumes sync tasks asynchronously.")
    Component(Provider_Integration_Client, "Provider Integration Client", "Node.js with TypeScript, OAuth2, HTTPS/REST", "Syncs digital assets from third-party digital content providers.")
    Component(Catalog_Persistence_Adapter, "Catalog Persistence Adapter", "Node.js with TypeScript, Postgres Wire Protocol over mTLS, AES-256", "Writes metadata to the primary database securely.")
    Component(Telemetry_Audit_Publisher, "Telemetry & Audit Publisher", "Node.js with TypeScript, OTLP/HTTPS", "Sends metrics and traces to the EU monitoring and APM provider.")
    Component(Sync_Circuit_Breaker_Retry_Manager, "Sync Circuit Breaker & Retry Manager", "Node.js with TypeScript", "Prevents database exhaustion and third-party API throttling using circuit breakers and retries.")
}

Rel(Circulation_Core_Engine, Sync_Task_Consumer, "Queues sync tasks", "Async Message Queues (RabbitMQ/Redis, AMQPS)")
Rel(Provider_Integration_Client, Third_Party_Digital_Content_Providers_OverDrive_Libby, "Syncs digital assets", "OAuth2, HTTPS/REST")
Rel(Catalog_Persistence_Adapter, Primary_Database, "Writes metadata", "Postgres Wire Protocol over mTLS")
Rel(Telemetry_Audit_Publisher, EU_Monitoring_APM_Provider, "Sends metrics and traces", "OTLP/HTTPS")

@enduml