@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification Worker container

Container_Db(Primary Database, "Primary Database", "PostgreSQL, EU-hosted", "Provides persistent storage for patron preferences with mTLS encryption")
System_Ext(External Notification Service, "External Notification Service", "External notification service for alerts and emails")
System_Ext(EU Monitoring & APM Provider, "EU Monitoring & APM Provider", "Exports telemetry metrics")

Container_Boundary(Notification Worker, "Notification Worker") {
    Component(Queue Consumer Component, "Queue Consumer Component", "Go / RabbitMQ Client", "Consumes raw notification tasks from message queues.")
    Component(Preference & Routing Component, "Preference & Routing Component", "Go", "Validates and routes raw jobs based on patron preferences.")
    Component(Template Engine Component, "Template Engine Component", "Go template library", "Renders localized alerts and notifications using templates.")
    Component(Dispatch Handler Component, "Dispatch Handler Component", "Go HTTP/SMTP Client", "Dispatches rendered messages to external notification services.")
}

Rel(Queue Consumer Component, Preference & Routing Component, "Passes raw job for preference validation", "In-memory function call")
Rel(Preference & Routing Component, Primary Database, "Queries patron preferences", "Postgres Wire Protocol over mTLS")
Rel(Preference & Routing Component, Template Engine Component, "Passes filtered/routed payload", "In-memory function call")
Rel(Template Engine Component, Dispatch Handler Component, "Passes rendered message", "In-memory function call")
Rel(Dispatch Handler Component, External Notification Service, "Dispatches alerts and notifications", "SMTP/HTTPS API, TLS 1.3")
Rel(Notification Worker, EU Monitoring & APM Provider, "Exports telemetry metrics", "OTLP/HTTPS")
@enduml