@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Primary Database", "Primary Database") {
    Component(ConnectionPoolerComponent, "Connection Pooler Component", "PgBouncer", "Manages database connections to prevent thread exhaustion during peak academic loads.")
    Component(RelationalStorageEngineComponent, "Relational Storage Engine Component", "PostgreSQL Core", "Provides ACID transactional integrity and EU-hosted relational storage.")
    Component(EncryptionKeyManagementComponent, "Encryption & Key Management Component", "AES-256 and pgcrypto", "Secures application data at rest and column-level PII.")
    Component(ReplicationFailoverComponent, "Replication & Failover Component", "PostgreSQL Replication", "Handles automated replication and failover to ensure high availability.")
}

Rel("Circulation & Core Engine", ConnectionPoolerComponent, "Postgres Wire Protocol over mTLS")
Rel(ConnectionPoolerComponent, RelationalStorageEngineComponent, "Proxies connections")
Rel(RelationalStorageEngineComponent, EncryptionKeyManagementComponent, "Applies encryption at rest and column-level PII protection")
Rel(RelationalStorageEngineComponent, ReplicationFailoverComponent, "Synchronizes data for high availability and backup targets")

@enduml