@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(LibraryMemberPatron, "Library Member (Patron)", "End-user who searches for items, manages loans, and uses self-service portals.")
Person(LibrarianStaff, "Librarian / Staff", "Staff member who manages circulation, catalogs items, and assists patrons.")
Person(LibraryAdministrator, "Library Administrator", "Administrator who configures the system, manages users, and oversees system operations.")

System_Ext(AnycastCDNDDoSRetectServiceEUPoPs, "Anycast CDN / DDoS Protection Service (EU-PoPs)", "Edge service providing DDoS protection and routing traffic via EU points of presence.")
System(LibraryManagementSystem, "Library Management System", "A cloud-native platform for public and academic libraries to catalogue physical and digital items, manage circulation, and provide self-service portals, enforcing strict EU-only data residency.")
System_Ext(EUCloudInfrastructureAWSAzureEURegion, "EU Cloud Infrastructure (AWS/Azure EU Region)", "Hosting environment that persists data and anchors all hosting within certified EU regions.")
System_Ext(EUIdentityProvidingIdP, "EU Identity Provider (IdP)", "Provides authentication services via OIDC/OAuth2 with MFA for users and administrators.")
System_Ext(EUComplianceAuditLoggingService, "EU Compliance & Audit Logging Service", "Receives exported audit events for compliance tracking.")
System_Ext(EUMonitoringAPMProvider, "EU Monitoring & APM Provider", "Receives operational telemetry to meet performance and latency requirements.")
System_Ext(ThirdPartyDigitalContentProvidersOverDriveLibby, "Third-Party Digital Content Providers (OverDrive/Libby)", "Provides digital assets and content syncing for circulation.")
System_Ext(ExternalNotificationService, "External Notification Service", "Dispatches alerts and notifications via SMTP or HTTPS API.")
System_Ext(EUSecondaryRegionBackupTarget, "EU Secondary Region Backup Target", "Target for replicated backups within EU regions.")

Rel(LibraryMemberPatron, AnycastCDNDDoSRetectServiceEUPoPs, "Uses system via web/mobile portal", "TLS 1.3, HTTPS")
Rel(LibrarianStaff, AnycastCDNDDoSRetectServiceEUPoPs, "Uses system for staff workflows", "TLS 1.3, HTTPS")
Rel(LibraryAdministrator, AnycastCDNDDoSRetectServiceEUPoPs, "Uses system for administration", "TLS 1.3, HTTPS")
Rel(AnycastCDNDDoSRetectServiceEUPoPs, LibraryManagementSystem, "Routes traffic to the core system", "TLS 1.3")
Rel(LibraryManagementSystem, EUCloudInfrastructureAWSAzureEURegion, "Persists data securely", "mTLS, Encrypted TLS/IPsec")
Rel(LibraryManagementSystem, EUIdentityProvidingIdP, "Authenticate users and administrators", "OIDC/OAuth2")
Rel(LibraryManagementSystem, EUComplianceAuditLoggingService, "Export audit events", "Syslog/HTTPS")
Rel(LibraryManagementSystem, EUMonitoringAPMProvider, "Emit operational metrics", "OTLP/HTTPS")
Rel(LibraryManagementSystem, ThirdPartyDigitalContentProvidersOverDriveLibby, "Lend and sync digital assets", "OAuth2, HTTPS/REST")
Rel(LibraryManagementSystem, ExternalNotificationService, "Dispatch alerts and notifications", "SMTP/HTTPS API")
Rel(EUCloudInfrastructureAWSAzureEURegion, EUSecondaryRegionBackupTarget, "Replicates backup data", "Encrypted TLS/IPsec")

@enduml