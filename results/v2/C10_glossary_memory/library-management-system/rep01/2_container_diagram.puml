@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(Patron, "Library Member (Patron)", "End-user who searches for items, manages loans, and uses self-service portals.")
Person(Staff, "Librarian / Staff", "Staff member who manages circulation, catalogs items, and assists patrons.")
Person(Admin, "Library Administrator", "Administrator who configures the system, manages users, and oversees system operations.")

System_Ext(CDN, "Anycast CDN / DDoS Protection Service (EU-PoPs)", "Edge service providing DDoS protection and routing traffic via EU points of presence.")
System_Ext(CloudInfra, "EU Cloud Infrastructure (AWS/Azure EU Region)", "Hosting environment that persists data and anchors all hosting within certified EU regions.")
System_Ext(IdP, "EU Identity Provider (IdP)", "Provides authentication services via OIDC/OAuth2 with MFA for users and administrators.")
System_Ext(AuditService, "EU Compliance & Audit Logging Service", "Receives exported audit events for compliance tracking.")
System_Ext(Monitoring, "EU Monitoring & APM Provider", "Receives operational telemetry to meet performance and latency requirements.")
System_Ext(ContentProviders, "Third-Party Digital Content Providers (OverDrive/Libby)", "Provides digital assets and content syncing for circulation.")
System_Ext(NotificationService, "External Notification Service", "Dispatches alerts and notifications via SMTP or HTTPS API.")

System_Boundary(LMS, "Library Management System") {
    Container(ApiGateway, "API Gateway / BFF", "Nginx/Envoy", "Handles edge routing, TLS termination, and rate limiting.")
    Container(PatronPortal, "Patron Portal", "Web/Mobile Container", "Self-service portal for library members to search and manage loans.")
    Container(StaffApp, "Staff Circulation App", "Web/Mobile Container", "Application for staff to manage circulation and assist patrons.")
    Container(AdminConsole, "Admin Console", "Web/Mobile Container", "Console for administrators to configure system operations.")
    Container(SearchService, "Search & Catalog Service", "Java/Spring Boot + Elasticsearch", "Provides sub-800ms search performance and catalog management.")
    Container(CoreEngine, "Circulation & Core Engine", "Go/Node.js", "Core business logic engine for managing circulation and library workflows.")
    ContainerDb(PrimaryDb, "Primary Database", "PostgreSQL, EU-hosted", "Persists application data with AES-256 encryption at rest.")
    Container(NotificationWorker, "Notification Worker", "Async Worker", "Dispatches notifications asynchronously.")
    Container(SyncWorker, "Digital Content Sync Worker", "Async Worker", "Syncs digital content from third-party providers asynchronously.")
}

Rel(Patron, CDN, "Uses system via web/mobile portal", "TLS 1.3, HTTPS")
Rel(Staff, CDN, "Uses system for staff workflows", "TLS 1.3, HTTPS")
Rel(Admin, CDN, "Uses system for administration", "TLS 1.3, HTTPS")

Rel(CDN, ApiGateway, "Routes traffic to the API Gateway", "TLS 1.3, HTTPS")

Rel(PatronPortal, ApiGateway, "Sends API requests and WebSocket messages", "HTTPS/REST, WSS")
Rel(StaffApp, ApiGateway, "Sends API requests", "HTTPS/REST")
Rel(AdminConsole, ApiGateway, "Sends API requests", "HTTPS/REST")

Rel(ApiGateway, SearchService, "Queries search and catalog data", "gRPC")
Rel(ApiGateway, CoreEngine, "Invokes core business operations", "gRPC / HTTPS")
Rel(ApiGateway, IdP, "Validates authentication and JWT tokens", "OIDC/OAuth2")

Rel(CoreEngine, PrimaryDb, "Reads and writes core data securely", "Postgres Wire Protocol over mTLS")
Rel(CoreEngine, SyncWorker, "Queues synchronization tasks", "Async Message Queues (RabbitMQ/Redis)")
Rel(CoreEngine, NotificationWorker, "Queues notification tasks", "Async Message Queues (RabbitMQ/Redis)")

Rel(SyncWorker, ContentProviders, "Syncs digital assets", "OAuth2, HTTPS/REST")
Rel(NotificationWorker, NotificationService, "Dispatches alerts and notifications", "SMTP/HTTPS API")

@enduml