@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(LibraryPatrons, "Library Patrons", "Students and public citizens who use the self-service portals to access catalogue management and digital content.")
Person(CirculationStaffandLibraryAdministrators, "Circulation Staff and Library Administrators", "Staff and administrators responsible for managing library operations, circulation control, and system administration.")

System_Ext(IdentityProviderSSO, "Identity Provider / SSO", "External system supporting SAML/Shibboleth and local accounts for federated authentication.")
System_Ext(DigitalContentProviders, "Digital Content Providers", "External vendor systems for e-books and audiobooks.")
System_Ext(NotificationGateway, "Notification Gateway", "External SMS/Email provider for dispatching notifications.")
System_Ext(ObservabilityLoggingPlatform, "Observability & Logging Platform", "Prometheus/Grafana platform for monitoring and logging.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(WebPortal, "Web Portal", "React/TypeScript on Nginx", "Provides the user interface for library patrons and staff.")
    Container(APIGateway, "API Gateway", "Envoy/Kong", "Handles routing, edge security, circuit breaking, and OIDC validation.")
    Container(CoreServicesAPI, "Core Services API", "Java/Spring Boot", "Handles core business logic and transactional operations.")
    Container(SearchCatalogueService, "Search & Catalogue Service", "Elasticsearch/OpenSearch", "Provides high-performance search queries for the catalogue.")
    ContainerDb(Database, "Database", "PostgreSQL with EU hosting", "Stores persistent relational data with EU residency compliance.")
}

Rel(LibraryPatrons, WebPortal, "Accesses self-service portals", "HTTPS/TLS 1.3")
Rel(CirculationStaffandLibraryAdministrators, WebPortal, "Manages library operations", "HTTPS/TLS 1.3")
Rel(APIGateway, IdentityProviderSSO, "Validates user authentication", "OIDC/SAML over HTTPS")
Rel(WebPortal, APIGateway, "Sends API requests", "HTTPS / JSON over TLS 1.3")
Rel(APIGateway, CoreServicesAPI, "Routes core requests", "gRPC over mTLS")
Rel(APIGateway, SearchCatalogueService, "Routes search requests", "gRPC over mTLS")
Rel(CoreServicesAPI, Database, "Reads and writes transactional data", "PostgreSQL Wire Protocol over TLS 1.3")
Rel(SearchCatalogueService, Database, "Syncs or queries catalogue data", "PostgreSQL Wire Protocol over TLS 1.3")
Rel(CoreServicesAPI, NotificationGateway, "Dispatches notifications asynchronously", "Asynchronous HTTPS/REST webhooks over TLS 1.3")
Rel(CoreServicesAPI, DigitalContentProviders, "Integrates with external digital content vendors", "HTTPS/REST with mutual TLS")

@enduml