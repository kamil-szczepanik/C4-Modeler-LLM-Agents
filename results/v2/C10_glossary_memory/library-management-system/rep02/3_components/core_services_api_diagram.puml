@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Services API container

System_Ext(api_gateway, "API Gateway", "Envoy/Kong")
System_Ext(database, "Database", "PostgreSQL with EU hosting")
System_Ext(notification_gateway, "Notification Gateway", "Notification Gateway")
System_Ext(digital_content_providers, "Digital Content Providers", "Digital Content Providers")
System_Ext(observability_platform, "Observability & Logging Platform", "Prometheus/Grafana")

Container_Boundary(core_services_api, "Core Services API") {
    Component(circulation_management_component, "Circulation Management Component", "Java / Spring Boot", "Orchestrates library transactions and circulation management.")
    Component(patron_account_component, "Patron Account Component", "Java / Spring Boot", "Manages patron account logic and validates memberships.")
    Component(integration_orchestrator_component, "Integration Orchestrator Component", "Java / Spring Boot", "Integration orchestrator component that brokers external digital content and dispatches alerts.")
}

Rel(api_gateway, core_services_api, "Routes core requests", "gRPC over mTLS with OAuth2 metadata headers")
Rel(circulation_management_component, database, "Persists loans and audit events", "PostgreSQL Wire Protocol over TLS 1.3")
Rel(patron_account_component, database, "Validates memberships", "PostgreSQL Wire Protocol over TLS 1.3")
Rel(integration_orchestrator_component, notification_gateway, "Dispatches alerts", "Asynchronous HTTPS/REST webhooks over TLS 1.3")
Rel(integration_orchestrator_component, digital_content_providers, "Brokers external licensing", "HTTPS/REST with mutual TLS")
Rel(core_services_api, observability_platform, "Emits sanitized distributed traces", "OpenTelemetry over gRPC / TLS 1.3")

@enduml