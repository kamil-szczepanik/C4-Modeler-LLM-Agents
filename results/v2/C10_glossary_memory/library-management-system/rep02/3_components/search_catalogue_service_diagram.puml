@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(search_catalogue_service, "Search & Catalogue Service") {
    Component(search_api_handler, "Search API Handler", "Java/Spring Boot", "Handles incoming search requests and routes them within the search service.")
    Component(query_builder_faceting_engine, "Query Builder & Faceting Engine", "Java", "Constructs complex search queries and manages faceting logic.")
    Component(indexing_worker, "Indexing Worker", "Java/Spring Boot", "Processes data streams and updates the search index.")
    Component(search_engine_index, "Search Engine Index", "OpenSearch", "Executes inverted-index queries for high-performance search.")
}

Rel(search_api_handler, query_builder_faceting_engine, "In-process method call", "")
Rel(query_builder_faceting_engine, search_engine_index, "REST over mTLS", "")
@enduml