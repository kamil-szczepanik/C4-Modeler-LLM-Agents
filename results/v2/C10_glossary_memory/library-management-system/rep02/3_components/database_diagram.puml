@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database container

Container_Boundary(database_container, "Database") {
    Component(Connection_Pool___Session_Manager, "Connection Pool & Session Manager", "PgBouncer", "Manages and pools client database connections over TLS 1.3 to ensure high performance and EU data residency compliance.")
    Component(Relational_Data_Store, "Relational Data Store", "PostgreSQL with EU hosting", "Stores persistent relational data including patron records, circulation logs, and catalogue metadata with row/column encryption.")
}

Rel(Connection_Pool___Session_Manager, Relational_Data_Store, "Routes and multiplexes database queries over PostgreSQL Wire Protocol")

@enduml