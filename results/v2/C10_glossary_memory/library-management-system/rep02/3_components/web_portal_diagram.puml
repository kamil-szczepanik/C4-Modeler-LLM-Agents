@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Portal container

Container_Boundary(web_portal, "Web Portal") {
    Component(Patron_UI_SPA, "Patron UI SPA", "React / TypeScript", "Provides the user interface and client-side routing for library patrons to browse catalogues, manage loans, and access self-service portals.")
    Component(Staff_Dashboard_SPA, "Staff Dashboard SPA", "React / TypeScript", "Provides administrative and circulation control interfaces for staff and library administrators.")
    Component(Nginx_Web_Server, "Nginx Web Server", "Nginx on EU-restricted container", "Serves static assets and handles reverse proxying within an EU-restricted container deployment.")
}

Rel(Patron_UI_SPA, Nginx_Web_Server, "Routed and served through")
Rel(Staff_Dashboard_SPA, Nginx_Web_Server, "Routed and served through")

@enduml