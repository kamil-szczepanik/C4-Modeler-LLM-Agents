@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Routing_and_Edge_Router, "Routing and Edge Router", "Envoy/Kong", "Handles high-performance edge routing, rate limiting, and security termination.")
    Component(Authentication_and_OIDC_Validator, "Authentication & OIDC Validator", "Envoy/Kong Plugin / Lua", "Validates incoming tokens against the Identity Provider / SSO.")
    Component(gRPC_Upstream_Proxy, "gRPC Upstream Proxy", "Envoy/Kong Proxy", "Routes internal traffic securely to Core Services API and Search & Catalogue Service via gRPC over mTLS.")
}

Rel(Routing_and_Edge_Router, Authentication_and_OIDC_Validator, "Delegates token validation", "")
Rel(Routing_and_Edge_Router, gRPC_Upstream_Proxy, "Forwards validated requests", "")
@enduml