@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Library Management System

Person(Library_Patrons, "Library Patrons", "Students and public citizens who use the self-service portals to access catalogue management and digital content.")
Person(Circulation_Staff_and_Library_Administrators, "Circulation Staff and Library Administrators", "Staff and administrators responsible for managing library operations, circulation control, and system administration.")

System(Library_Management_System, "Library Management System", "Provides public and academic libraries with catalogue management, circulation control, and self-service portals, enforcing strict EU-only data residency and high-performance search requirements.")

System_Ext(Identity_Provider___SSO, "Identity Provider / SSO", "External system supporting SAML/Shibboleth and local accounts for federated authentication.")
System_Ext(Digital_Content_Providers, "Digital Content Providers", "External vendor systems for e-books and audiobooks.")
System_Ext(Notification_Gateway, "Notification Gateway", "External SMS/Email provider for dispatching notifications.")
System_Ext(Observability___Logging_Platform, "Observability & Logging Platform", "Prometheus/Grafana platform for monitoring and logging.")

Rel(Library_Patrons, Library_Management_System, "Accesses catalogue management, circulation control, and self-service portals", "HTTPS (Web/Mobile) using TLS 1.3")
Rel(Circulation_Staff_and_Library_Administrators, Library_Management_System, "Manages library operations and system administration", "HTTPS (Web/Mobile) using TLS 1.3")
Rel(Library_Management_System, Identity_Provider___SSO, "Authenticates users via federated identity", "OIDC/SAML over HTTPS")
Rel(Library_Management_System, Digital_Content_Providers, "Integrates with vendor systems for e-books and audiobooks", "HTTPS/REST with mutual TLS (mTLS)")
Rel(Library_Management_System, Notification_Gateway, "Dispatches SMS and email notifications", "Asynchronous HTTPS/REST webhooks")

@enduml