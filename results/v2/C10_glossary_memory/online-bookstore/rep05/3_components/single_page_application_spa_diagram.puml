@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Single-Page Application (SPA) container

System_Ext(api_gateway, "API Gateway / Backend-for-Frontend (BFF)", "AWS API Gateway / NestJS on AWS ECS Fargate", "Handles request routing, rate limiting, and TLS termination for the BFF.")

Container_Boundary(spa_container, "Single-Page Application (SPA)") {
    Component(router_view_controller, "Router & View Controller", "React Router, TypeScript", "Manages client-side routing, view rendering, and navigation across catalogue browsing, checkout, reviews, and recommendations.")
    Component(catalogue_search_module, "Catalogue & Search Module", "React, TypeScript, Vite", "Handles user interfaces for browsing books, executing keyword searches, and displaying item details.")
    Component(checkout_cart_module, "Checkout & Cart Module", "React, TypeScript, Vite", "Manages shopping cart state and coordinates secure checkout interactions.")
    Component(recommendations_reviews_module, "Recommendations & Reviews Module", "React, TypeScript, Vite", "Displays personalized book recommendations and handles user review submissions.")
}

Rel(router_view_controller, catalogue_search_module, "Renders")
Rel(router_view_controller, checkout_cart_module, "Renders")
Rel(router_view_controller, recommendations_reviews_module, "Renders")
Rel(catalogue_search_module, api_gateway, "Fetches catalogue and search data", "HTTPS/REST and GraphQL")
Rel(checkout_cart_module, api_gateway, "Processes cart operations and checkout", "HTTPS/REST and GraphQL")
Rel(recommendations_reviews_module, api_gateway, "Fetches recommendations and submits reviews", "HTTPS/REST and GraphQL")

@enduml