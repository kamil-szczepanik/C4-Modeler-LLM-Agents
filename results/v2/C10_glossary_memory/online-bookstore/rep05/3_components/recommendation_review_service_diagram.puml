@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Recommendation & Review Service container

System_Ext(aws_elasticache, "AWS ElastiCache (Redis)", "In-memory data store for caching")
System_Ext(aws_dynamodb, "AWS DynamoDB", "NoSQL database for reviews and ratings")

Container_Boundary(rec_review_service, "Recommendation & Review Service") {
    Component(recommendation_engine_component, "Recommendation Engine Component", "Python / FastAPI", "Handles personalized book recommendations using caching.")
    Component(review_management_component, "Review Management Component", "Python / FastAPI", "Manages customer reviews and ratings.")
}

Rel(recommendation_engine_component, aws_elasticache, "TCP / Redis Protocol", "TCP / Redis")
Rel(review_management_component, aws_dynamodb, "HTTPS / AWS SDK", "HTTPS")

@enduml