@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(catalog_search_service, "Catalog & Search Service") {
    Component(CatalogController, "Catalog Controller", "Node.js / Express or Spring MVC REST Controller", "Exposes REST and gRPC endpoints for searching books, browsing categories, and retrieving product details.")
    Component(SearchIndexerService, "Search Indexer Service", "Node.js / Java", "Synchronizes product catalogue data and manages indices in AWS OpenSearch for fast keyword matching.")
    Component(CatalogueRepository, "Catalogue Repository", "AWS OpenSearch Client", "Handles data persistence queries and full-text search operations against AWS OpenSearch.")
}

Rel(CatalogController, SearchIndexerService, "Delegates search and query execution")
Rel(SearchIndexerService, CatalogueRepository, "Queries and indexes catalogue data")

@enduml