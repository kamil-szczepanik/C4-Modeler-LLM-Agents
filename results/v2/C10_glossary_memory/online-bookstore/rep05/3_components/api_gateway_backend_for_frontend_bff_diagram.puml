@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway / Backend-for-Frontend (BFF) container

Person(spa, "Single-Page Application (SPA)", "Global customers browsing and checking out books.")
System_Ext(identity_provider, "Identity Provider", "OAuth2/OIDC authentication service.")
System_Ext(analytics, "Analytics & Monitoring Platform", "Monitoring and telemetry platform.")
System_Ext(catalog_service, "Catalog & Search Service", "Backend gRPC service.")
System_Ext(order_service, "Order & Checkout Service", "Backend gRPC service.")
System_Ext(recommendation_service, "Recommendation & Review Service", "Backend gRPC service.")

Container_Boundary(bff_container, "API Gateway / Backend-for-Frontend (BFF)") {
    Component(api_router, "API Router & Rate Limiter Component", "AWS API Gateway", "Provides edge routing, WAF evaluation, and token bucket rate limiting for security.")
    Component(graphql_resolver, "GraphQL / REST Resolver Component", "NestJS on AWS ECS Fargate", "Powers the backend-for-frontend containers with horizontal autoscaling.")
    Component(auth_middleware, "Session & Auth Middleware Component", "NestJS", "Manages session and authentication middleware.")
    Component(telemetry_interceptor, "Telemetry & Logging Interceptor Component", "NestJS / OpenTelemetry", "Standardizes distributed tracing across BFF and backend gRPC services.")
    ComponentDb(cache, "Regional Distributed Caching", "AWS ElastiCache / Redis", "Implements regional distributed caching for currency rates and catalogue metadata to reduce latency.")
}

Rel(spa, api_router, "HTTPS/REST and GraphQL", "HTTPS")
Rel(api_router, auth_middleware, "Internal HTTP", "HTTP")
Rel(auth_middleware, graphql_resolver, "In-process calls", "")
Rel(graphql_resolver, catalog_service, "gRPC over mTLS", "gRPC")
Rel(graphql_resolver, order_service, "gRPC over mTLS", "gRPC")
Rel(graphql_resolver, recommendation_service, "gRPC over mTLS", "gRPC")
Rel(api_router, identity_provider, "OAuth2/OIDC with short-lived JWTs", "HTTPS")
Rel(api_router, analytics, "HTTPS", "HTTPS")

@enduml