@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Order & Checkout Service container

System_Ext(api_gateway, "API Gateway / Backend-for-Frontend (BFF)", "Backend-for-Frontend")
System_Ext(payment_gateway, "Payment Gateway", "External payment processing service")

Container_Boundary(order_checkout_service, "Order & Checkout Service") {
    Component(cart_management_component, "Cart Management Component", "Spring Boot / Go", "Manages ephemeral and persistent user cart states.")
    Component(checkout_orchestrator_component, "Checkout Orchestrator Component", "Spring Boot / Go", "Enforces ACID transactions and coordinates payment/shipping.")
    Component(order_fulfillment_component, "Order Fulfillment Component", "Spring Boot / Go", "Handles asynchronous downstream event dispatch.")
    Component(aws_aurora_postgresql_multi_region, "AWS Aurora PostgreSQL Multi-Region", "AWS Aurora PostgreSQL", "Provides durable relational storage for orders.")
    Component(aws_elasticache_for_redis, "AWS ElastiCache for Redis", "AWS ElastiCache for Redis", "Caches transient cart sessions and multi-currency rates.")
    Component(aws_sqs_sns, "AWS SQS/SNS", "AWS SQS/SNS", "Delivers asynchronous event messaging and dead-letter queues.")
}

Rel(api_gateway, checkout_orchestrator_component, "Routes gRPC requests with mTLS over AWS Cloud Map", "gRPC / mTLS")
Rel(checkout_orchestrator_component, payment_gateway, "Transacts securely via HTTPS/REST using tokenized iframe SDKs", "HTTPS / REST")
Rel(checkout_orchestrator_component, aws_aurora_postgresql_multi_region, "Executes transactional reads and writes over JDBC/SQL", "JDBC / SQL")
Rel(cart_management_component, aws_elasticache_for_redis, "Accesses cached cart state via RESP protocol", "RESP")
Rel(checkout_orchestrator_component, order_fulfillment_component, "Publishes domain events asynchronously via AWS SQS/SNS", "AWS SQS/SNS")

@enduml