@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Online Bookstore System

Person(Customers_Shoppers, "Customers / Shoppers", "End-users browsing catalogues and purchasing books.")
Person(Registered_Users_Reviewers, "Registered Users / Reviewers", "Authenticated customers writing reviews and ratings.")
Person(Store_Administrators, "Store Administrators", "Internal staff managing content and catalogue accuracy.")

System(Online_Bookstore_System, "Online Bookstore System", "An AWS-hosted global online bookstore handling 1 million monthly active users with multi-currency support and secure e-commerce operations, providing catalogue browsing, secure checkout, reviews, and personalized book recommendations.")

System_Ext(Payment_Gateway, "Payment Gateway", "Stripe/PayPal handling secure tokenized transactions.")
System_Ext(Third_Party_Shipping_APIs, "Third-Party Shipping APIs", "FedEx/UPS/DHL providing real-time rates.")
System_Ext(Identity_Provider, "Identity Provider", "AWS Cognito managing OAuth2/OIDC authentication.")
System_Ext(Analytics_Monitoring_Platform, "Analytics & Monitoring Platform", "Datadog/Segment tracking checkout friction and telemetry.")

Rel(Customers_Shoppers, Online_Bookstore_System, "Browses catalogues and purchases books", "HTTPS (TLS 1.3) via global CDN/WAF and Route 53")
Rel(Registered_Users_Reviewers, Online_Bookstore_System, "Authenticates, writes reviews, and manages account", "HTTPS (TLS 1.3)")
Rel(Store_Administrators, Online_Bookstore_System, "Manages content and catalogue accuracy", "HTTPS (TLS 1.3)")

Rel(Online_Bookstore_System, Payment_Gateway, "Handles secure tokenized transactions for checkout", "HTTPS/REST using tokenized iframe SDKs")
Rel(Online_Bookstore_System, Third_Party_Shipping_APIs, "Retrieves real-time shipping rates", "HTTPS/REST with circuit breakers and fallback caching")
Rel(Online_Bookstore_System, Identity_Provider, "Authenticates users and manages sessions", "OAuth2/OIDC with short-lived JWTs")
Rel(Online_Bookstore_System, Analytics_Monitoring_Platform, "Tracks checkout friction and system telemetry", "HTTPS")

@enduml