@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore System

Person(Customers_Shoppers, "Customers / Shoppers", "End-users browsing catalogues and purchasing books.")
Person(Registered_Users_Reviewers, "Registered Users / Reviewers", "Authenticated customers writing reviews and ratings.")
Person(Store_Administrators, "Store Administrators", "Internal staff managing content and catalogue accuracy.")

System_Ext(Payment_Gateway, "Payment Gateway", "Stripe/PayPal handling secure tokenized transactions.")
System_Ext(Third_Party_Shipping_APIs, "Third-Party Shipping APIs", "FedEx/UPS/DHL providing real-time rates.")
System_Ext(Identity_Provider, "Identity Provider", "AWS Cognito managing OAuth2/OIDC authentication.")
System_Ext(Analytics_Monitoring_Platform, "Analytics & Monitoring Platform", "Datadog/Segment tracking checkout friction and telemetry.")

System_Boundary(Online_Bookstore_System, "Online Bookstore System") {
    Container(Single_Page_Application_SPA, "Single-Page Application (SPA)", "React, TypeScript, Vite", "Delivers sub-2s page loads on 3G for the SPA hosted globally on AWS CloudFront/S3.")
    Container(API_Gateway_Backend_for_Frontend_BFF, "API Gateway / Backend-for-Frontend (BFF)", "AWS API Gateway / NestJS on AWS ECS Fargate", "Handles request routing, rate limiting, and TLS termination.")
    Container(Catalog_Search_Service, "Catalog & Search Service", "Node.js / Java, AWS OpenSearch", "Isolates keyword searches for scalable catalogue browsing.")
    Container(Order_Checkout_Service, "Order & Checkout Service", "Spring Boot / Go", "Ensures ACID-compliant transactions for carts and orders across multiple regions.")
    Container(Recommendation_Review_Service, "Recommendation & Review Service", "Python / FastAPI, AWS DynamoDB / ElastiCache", "Isolates heavy analytical recommendation and review queries from checkout.")
}

Rel(Customers_Shoppers, Single_Page_Application_SPA, "Browses catalogues and purchases books", "HTTPS (TLS 1.3) via global CDN/WAF and Route 53")
Rel(Registered_Users_Reviewers, Single_Page_Application_SPA, "Authenticates, writes reviews, and manages account", "HTTPS (TLS 1.3)")
Rel(Store_Administrators, Single_Page_Application_SPA, "Manages content and catalogue accuracy", "HTTPS (TLS 1.3)")

Rel(Single_Page_Application_SPA, API_Gateway_Backend_for_Frontend_BFF, "Sends API requests", "HTTPS/REST and GraphQL")

Rel(API_Gateway_Backend_for_Frontend_BFF, Catalog_Search_Service, "Routes catalogue and search queries", "internal gRPC over AWS Cloud Map / ECS Service Connect with mTLS")
Rel(API_Gateway_Backend_for_Frontend_BFF, Order_Checkout_Service, "Routes order and checkout requests", "internal gRPC over AWS Cloud Map / ECS Service Connect with mTLS")
Rel(API_Gateway_Backend_for_Frontend_BFF, Recommendation_Review_Service, "Routes recommendation and review requests", "internal gRPC over AWS Cloud Map / ECS Service Connect with mTLS")
Rel(API_Gateway_Backend_for_Frontend_BFF, Identity_Provider, "Authenticates users and manages sessions", "OAuth2/OIDC with short-lived JWTs")
Rel(API_Gateway_Backend_for_Frontend_BFF, Analytics_Monitoring_Platform, "Tracks checkout friction and system telemetry", "HTTPS")

Rel(Order_Checkout_Service, Payment_Gateway, "Handles secure tokenized transactions for checkout", "HTTPS/REST using tokenized iframe SDKs")
Rel(Order_Checkout_Service, Third_Party_Shipping_APIs, "Retrieves real-time shipping rates", "HTTPS/REST with circuit breakers and fallback caching")

@enduml