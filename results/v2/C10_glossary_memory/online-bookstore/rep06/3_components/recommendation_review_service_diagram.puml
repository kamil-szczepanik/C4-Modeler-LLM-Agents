@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(recommendation_review_service, "Recommendation & Review Service") {
    Component(Recommendation_Controller, "Recommendation Controller", "FastAPI Router", "Handles incoming HTTP requests for book recommendations and user reviews.")
    Component(Recommendation_Engine, "Recommendation Engine", "Python Machine Learning Library", "Processes user behavior and catalog data to generate personalized book recommendations.")
    Component(Review_Manager, "Review Manager", "Python Service Logic", "Validates, stores, and retrieves book reviews submitted by registered reviewers.")
}

Rel(Recommendation_Controller, Recommendation_Engine, "Invokes recommendation generation algorithms")
Rel(Recommendation_Controller, Review_Manager, "Delegates review CRUD operations")
@enduml