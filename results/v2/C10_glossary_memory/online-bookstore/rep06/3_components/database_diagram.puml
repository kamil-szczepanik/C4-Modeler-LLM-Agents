@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database container

System_Ext(Catalog_Search_Service, "Catalog & Search Service", "External service interacting with the database")
System_Ext(Order_Checkout_Service, "Order & Checkout Service", "External service interacting with the database")
System_Ext(Recommendation_Review_Service, "Recommendation & Review Service", "External service interacting with the database")
System_Ext(Async_Notification_Service, "Async Notification Service", "External service interacting with the database")
System_Ext(Amazon_Kinesis, "Amazon Kinesis", "Streams audit logs for compliance")

Container_Boundary(Database, "Database Container") {
    Component(Catalog_Schema_Component, "Catalog Schema Component", "Relational tables with GiST/GIN indexes", "Stores books, authors, and categories with keyword search and catalog query optimizations.")
    Component(Order_Transactions_Schema_Component, "Order & Transactions Schema Component", "ACID-compliant relational tables", "Stores carts, orders, and multi-currency pricing with TTL cleanup.")
    Component(Reviews_Recommendations_Schema_Component, "Reviews & Recommendations Schema Component", "Relational tables", "Stores user ratings and review texts.")
    Component(Audit_Compliance_Component, "Audit & Compliance Component", "Row-level security (RLS) and automated anonymization", "Enforces strict security, encryption, and automated anonymization controls to meet GDPR and CCPA regulatory mandates.")
    Component(Supporting_Infrastructure, "Supporting Infrastructure", "Amazon RDS Proxy and AWS Database Activity Streams", "Prevents connection exhaustion and mitigates thread exhaustion under high traffic while streaming audit logs.")
}

Rel(Catalog_Search_Service, Database, "Reads and writes catalog data", "PostgreSQL Protocol over TLS")
Rel(Order_Checkout_Service, Database, "Reads and writes order data", "PostgreSQL Protocol over TLS")
Rel(Recommendation_Review_Service, Database, "Reads and writes review and recommendation data", "PostgreSQL Protocol over TLS")
Rel(Async_Notification_Service, Database, "Persists notification state", "PostgreSQL Protocol over TLS")
Rel(Database, Amazon_Kinesis, "Streams audit logs for compliance", "AWS Kinesis Protocol")
@enduml