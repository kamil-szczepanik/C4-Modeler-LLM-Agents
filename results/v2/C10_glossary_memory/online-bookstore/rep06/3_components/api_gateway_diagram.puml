@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

System_Ext(Identity_Provider, "Identity Provider", "Auth0/AWS Cognito")
System_Ext(Catalog_Search_Service, "Catalog & Search Service", "Go/Gin, Elasticsearch")
System_Ext(Order_Checkout_Service, "Order & Checkout Service", "Node.js/Express")
System_Ext(Recommendation_Review_Service, "Recommendation & Review Service", "Python/FastAPI")

Container_Boundary(api_gateway, "API Gateway") {
    Component(Edge_Router_SSL_Termination, "Edge Router & SSL Termination", "AWS API Gateway", "Handles edge routing and SSL termination.")
    Component(Auth_Validation_Middleware, "Auth Validation Middleware", "AWS Lambda & WAF", "Performs edge token validation and OWASP Top-10 security mitigations.")
    Component(Throttling_Rate_Limiting, "Throttling & Rate Limiting", "AWS API Gateway", "Manages traffic throttling and rate limiting.")
    Component(API_Analytics_Monetization, "API Analytics & Monetization", "AWS API Gateway", "Provides API analytics and monetization capabilities.")
}

Rel(Auth_Validation_Middleware, Identity_Provider, "Validates tokens and authenticates requests", "HTTPS")
Rel(Edge_Router_SSL_Termination, Catalog_Search_Service, "Routes traffic", "HTTPS/REST with mTLS")
Rel(Edge_Router_SSL_Termination, Order_Checkout_Service, "Routes traffic", "HTTPS/REST with mTLS")
Rel(Edge_Router_SSL_Termination, Recommendation_Review_Service, "Routes traffic", "HTTPS/REST with mTLS")
@enduml