@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(storefront_spa, "Storefront SPA") {
    Component(Router, "Router", "React Router", "Manages client-side routing and view transitions within the single-page application.")
    Component(Catalog_View, "Catalog View", "React Component", "Provides the user interface for browsing books and searching the catalog.")
    Component(Checkout_View, "Checkout View", "React Component", "Handles user interactions for the secure multi-currency checkout process.")
    Component(Review_Recommendation_View, "Review & Recommendation View", "React Component", "Displays book recommendations and user-submitted reviews.")
}

Rel(Router, Catalog_View, "Renders", "")
Rel(Router, Checkout_View, "Renders", "")
Rel(Router, Review_Recommendation_View, "Renders", "")

@enduml