@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(catalog_search_service, "Catalog & Search Service") {
    Component(API_Router_Component, "API Router Component", "Go/Gin", "High-throughput, low-latency REST API routing for catalog search.")
    Component(Search_Engine_Client, "Search Engine Client", "Go, Elasticsearch Client", "Interacts with Elasticsearch for search and multi-facet filtering.")
    Component(Catalog_Repository, "Catalog Repository", "Go, database/sql", "Handles relational database operations for catalog records.")
    Component(Index_Synchronization_Worker, "Index Synchronization Worker", "Go, Debezium CDC", "Synchronizes data between the database and Elasticsearch using Debezium CDC.")
    Component(Pricing_Localization_Resolver, "Pricing & Localization Resolver", "Go", "Resolves multi-currency pricing and localization requirements.")
    Component(Cache_Management_Middleware, "Cache Management Middleware", "Go, Redis Client", "Manages caching layer interactions to ensure fast page loads.")
    Component(Elasticsearch_Amazon_OpenSearch_Service, "Elasticsearch / Amazon OpenSearch Service", "Elasticsearch / OpenSearch", "Provides fast, typo-tolerant keyword search and multi-facet filtering.")
    Component(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Delivers reliable, multi-AZ relational persistence for catalog records.")
    Component(Amazon_ElastiCache_Redis, "Amazon ElastiCache (Redis)", "Amazon ElastiCache (Redis)", "Caches search snippets to ensure sub-2-second page loads.")
}

Rel(API_Router_Component, Search_Engine_Client, "In-process Go interfaces")
Rel(API_Router_Component, Cache_Management_Middleware, "In-process Go interfaces")
Rel(Cache_Management_Middleware, Amazon_ElastiCache_Redis, "Redis Protocol over TLS")
Rel(Search_Engine_Client, Elasticsearch_Amazon_OpenSearch_Service, "HTTP/REST over TLS")
Rel(Search_Engine_Client, Pricing_Localization_Resolver, "In-process Go structs")
Rel(Catalog_Repository, Amazon_Aurora_PostgreSQL, "PostgreSQL Protocol over TLS")
Rel(Index_Synchronization_Worker, Amazon_Aurora_PostgreSQL, "Transactional Outbox via CDC")
Rel(Index_Synchronization_Worker, Elasticsearch_Amazon_OpenSearch_Service, "Transactional Outbox via CDC")

@enduml