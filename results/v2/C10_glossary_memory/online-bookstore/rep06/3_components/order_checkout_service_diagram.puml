@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Order & Checkout Service", "Order & Checkout Service") {
    Component("Order API Controller", "Order API Controller", "Node.js, Express, TypeScript", "Handles incoming HTTP/REST requests from the API Gateway for order creation and checkout operations.")
    Component("Checkout Processing Engine", "Checkout Processing Engine", "Node.js, TypeScript", "Executes core business logic for processing orders, managing carts, and coordinating payments.")
    Component("Payment Integration Client", "Payment Integration Client", "Node.js, HTTPS/REST, mTLS, HMAC", "Communicates securely with the external Payment Gateway for processing transactions.")
    Component("Shipping Integration Client", "Shipping Integration Client", "Node.js, HTTPS/REST, mTLS, HMAC", "Interacts with Third-Party Shipping APIs to handle logistics and shipping arrangements.")
    Component("Messaging Publisher", "Messaging Publisher", "Node.js, AWS SQS SDK", "Publishes asynchronous notification events to AWS SQS queues with Dead-Letter Queue support.")
    Component("Data Access Repository", "Data Access Repository", "Node.js, PostgreSQL Driver, TLS", "Manages persistence and retrieval of transactional data in Amazon Aurora PostgreSQL.")
}

Rel("Order API Controller", "Checkout Processing Engine", "Delegates request processing")
Rel("Checkout Processing Engine", "Payment Integration Client", "Invokes payment authorization")
Rel("Checkout Processing Engine", "Shipping Integration Client", "Coordinates fulfillment logistics")
Rel("Checkout Processing Engine", "Messaging Publisher", "Dispatches asynchronous events")
Rel("Checkout Processing Engine", "Data Access Repository", "Persists order state")

@enduml