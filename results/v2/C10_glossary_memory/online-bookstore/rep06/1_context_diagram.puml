@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Online Bookstore

Person(Book_Buyer_Customer, "Book Buyer (Customer)", "End-user who browses the catalog, makes purchases, and leaves reviews.")
Person(Registered_Reviewer, "Registered Reviewer", "User who writes and manages reviews for books.")
Person(Store_Administrator, "Store Administrator", "User who manages store operations and administration.")

System(Online_Bookstore, "Online Bookstore", "A cloud-native e-commerce platform designed to provide catalog browsing, secure multi-currency checkout, recommendations, and reviews for physical and electronic books.")

System_Ext(Payment_Gateway, "Payment Gateway", "Stripe/PayPal used for secure multi-currency checkout.")
System_Ext(Third_Party_Shipping_APIs, "Third-Party Shipping APIs", "FedEx/UPS used for handling shipping logistics.")
System_Ext(Identity_Provider, "Identity Provider", "Auth0/AWS Cognito used for OAuth2/OIDC authentication and JWT scopes.")
System_Ext(Notification_Provider, "Notification Provider", "SendGrid/Twilio used for sending user notifications.")
System_Ext(Tax_Calculation_Service, "Tax Calculation Service", "Avalara used for calculating order taxes.")
System_Ext(AWS_CloudFront, "AWS CloudFront", "CDN for global content caching and edge acceleration.")

Rel(Book_Buyer_Customer, Online_Bookstore, "Interacts via Web/Mobile", "HTTPS")
Rel(Registered_Reviewer, Online_Bookstore, "Interacts via Web/Mobile", "HTTPS")
Rel(Store_Administrator, Online_Bookstore, "Interacts via Web/Mobile", "HTTPS")

Rel(Online_Bookstore, AWS_CloudFront, "Uses for global content caching and edge acceleration", "CDN")
Rel(Online_Bookstore, Payment_Gateway, "Processes secure payments", "Outbound HTTPS/REST with mTLS and HMAC")
Rel(Online_Bookstore, Third_Party_Shipping_APIs, "Manages shipping logistics", "Outbound HTTPS/REST with mTLS and HMAC")
Rel(Online_Bookstore, Identity_Provider, "Enforces authentication and authorization", "OAuth2/OIDC with JWT scopes")
Rel(Online_Bookstore, Notification_Provider, "Sends notifications to users", "Outbound HTTPS/REST with mTLS and HMAC")
Rel(Online_Bookstore, Tax_Calculation_Service, "Calculates taxes for purchases", "Outbound HTTPS/REST with mTLS and HMAC")

@enduml