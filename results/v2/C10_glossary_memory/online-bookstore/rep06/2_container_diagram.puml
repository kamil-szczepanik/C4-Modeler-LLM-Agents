@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore

Person(BookBuyerCustomer, "Book Buyer (Customer)", "End-user who browses the catalog, makes purchases, and leaves reviews.")
Person(RegisteredReviewer, "Registered Reviewer", "User who writes and manages reviews for books.")
Person(StoreAdministrator, "Store Administrator", "User who manages store operations and administration.")

System_Ext(PaymentGateway, "Payment Gateway", "Stripe/PayPal used for secure multi-currency checkout.")
System_Ext(ThirdPartyShippingAPIs, "Third-Party Shipping APIs", "FedEx/UPS used for handling shipping logistics.")
System_Ext(IdentityProvider, "Identity Provider", "Auth0/AWS Cognito used for OAuth2/OIDC authentication and JWT scopes.")
System_Ext(NotificationProvider, "Notification Provider", "SendGrid/Twilio used for sending user notifications.")
System_Ext(TaxCalculationService, "Tax Calculation Service", "Avalara used for calculating order taxes.")
System_Ext(AWSCloudFront, "AWS CloudFront", "CDN for global content caching and edge acceleration.")

System_Boundary(OnlineBookstore, "Online Bookstore") {
    Container(StorefrontSPA, "Storefront SPA", "React hosted on AWS S3 & CloudFront", "Single page application providing catalog browsing, checkout, recommendations, and reviews.")
    Container(APIGateway, "API Gateway", "AWS API Gateway", "Entry point for routing client requests to backend microservices.")
    Container(CatalogSearchService, "Catalog & Search Service", "Go/Gin, Elasticsearch", "Handles book catalog browsing and search capabilities.")
    Container(OrderCheckoutService, "Order & Checkout Service", "Node.js/Express", "Manages secure multi-currency checkout and order processing.")
    Container(RecommendationReviewService, "Recommendation & Review Service", "Python/FastAPI", "Provides product recommendations and manages user reviews.")
    Container(AsyncNotificationService, "Async Notification Service", "Node.js, AWS SQS", "Handles asynchronous messaging and event notifications.")
    ContainerDb(Database, "Database", "Amazon Aurora PostgreSQL with multi-AZ and read replicas", "Stores persistent platform data.")
    ContainerDb(CachingLayer, "Caching Layer", "Amazon ElastiCache (Redis)", "Caches frequently accessed catalog and session data.")
}

Rel(BookBuyerCustomer, StorefrontSPA, "Browses catalog, places orders, and leaves reviews", "HTTPS")
Rel(RegisteredReviewer, StorefrontSPA, "Manages reviews", "HTTPS")
Rel(StoreAdministrator, StorefrontSPA, "Manages store operations", "HTTPS")
Rel(StorefrontSPA, AWSCloudFront, "Loaded and cached via CDN", "CDN")
Rel(StorefrontSPA, APIGateway, "Makes API requests", "HTTPS")
Rel(APIGateway, CatalogSearchService, "Routes catalog requests", "HTTPS/REST")
Rel(APIGateway, OrderCheckoutService, "Routes checkout requests", "HTTPS/REST")
Rel(APIGateway, RecommendationReviewService, "Routes recommendation and review requests", "HTTPS/REST")
Rel(OrderCheckoutService, AsyncNotificationService, "Dispatches asynchronous events", "AWS SQS")
Rel(CatalogSearchService, Database, "Reads and writes catalog data", "PostgreSQL Protocol over TLS")
Rel(OrderCheckoutService, Database, "Reads and writes order data", "PostgreSQL Protocol over TLS")
Rel(RecommendationReviewService, Database, "Reads and writes review and recommendation data", "PostgreSQL Protocol over TLS")
Rel(AsyncNotificationService, Database, "Persists notification state", "PostgreSQL Protocol over TLS")
Rel(CatalogSearchService, CachingLayer, "Caches catalog search results", "Redis Protocol")
Rel(StorefrontSPA, PaymentGateway, "Processes secure payments", "Outbound HTTPS/REST with mTLS and HMAC")
Rel(StorefrontSPA, ThirdPartyShippingAPIs, "Manages shipping logistics", "Outbound HTTPS/REST with mTLS and HMAC")
Rel(StorefrontSPA, NotificationProvider, "Sends user notifications", "Outbound HTTPS/REST with mTLS and HMAC")
Rel(StorefrontSPA, TaxCalculationService, "Calculates purchase taxes", "Outbound HTTPS/REST with mTLS and HMAC")
Rel(StorefrontSPA, IdentityProvider, "Enforces authentication and authorization", "OAuth2/OIDC with JWT scopes")

@enduml