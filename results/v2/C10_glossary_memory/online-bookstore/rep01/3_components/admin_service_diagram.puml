@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(admin_service, "Admin Service") {
    Component(CatalogueManagementController, "Catalogue Management Controller", "Express Router / Joi", "Manages catalogue curation and input validation during batch imports.")
    Component(AuditLoggingMiddleware, "Audit Logging Middleware", "Winston / Amazon CloudWatch", "Handles asynchronous structured compliance and audit logging.")
    Component(AdminDataRepository, "Admin Data Repository", "Sequelize ORM", "Executes structured database interactions for administrative operations.")
}

System_Ext(AmazonCloudWatchS3, "Amazon CloudWatch / S3", "External logging and storage service.")
System_Ext(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL", "Relational database for administrative data.")
System_Ext(AWSSecretsManager, "AWS Secrets Manager", "Secret management service.")

Rel(CatalogueManagementController, AdminDataRepository, "TCP/Sequelize")
Rel(AuditLoggingMiddleware, AmazonCloudWatchS3, "HTTPS/REST")
Rel(AdminDataRepository, AmazonAuroraPostgreSQL, "TLS/TCP")
Rel(admin_service, AWSSecretsManager, "HTTPS/REST")

@enduml