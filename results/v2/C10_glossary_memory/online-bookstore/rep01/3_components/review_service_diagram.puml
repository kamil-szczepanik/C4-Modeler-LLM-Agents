@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Review Service", "Review Service") {
    Component("Review API Router", "Review API Router", "Python / FastAPI Router", "Handles incoming HTTP/REST requests and routing for review submission and retrieval.")
    Component("Review Controller", "Review Controller", "Python / FastAPI", "Orchestrates review business logic, validation, and JWT verification handling.")
    Component("Review Repository", "Review Repository", "SQLAlchemy ORM", "Manages data access and persistence operations for book reviews in Amazon Aurora PostgreSQL.")
}

System_Ext("Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Relational database for storing book reviews.")

Rel("Review API Router", "Review Controller", "Routes requests to")
Rel("Review Controller", "Review Repository", "Invokes data persistence operations")
Rel("Review Repository", "Amazon Aurora PostgreSQL", "Reads and writes review data", "TCP with mTLS")

@enduml