@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Store_Administrator, "Store Administrator", "An administrator managing system configurations, catalogue items, and store operations.")

System_Ext(Identity_Provider, "Identity Provider", "Authentication and authorization service utilizing OAuth2/OIDC.")

Container_Boundary(Admin_Portal, "Admin Portal") {
    Component(Authentication_Module, "Authentication Module", "React & TypeScript / OIDC/OAuth2", "Handles user authentication and identity verification with the Identity Provider.")
    Component(Catalogue_Management_Dashboard, "Catalogue Management Dashboard", "React & TypeScript / Material-UI", "Provides administrative UI to manage catalogue items and pricing.")
    Component(Operations_Fulfillment_View, "Operations & Fulfillment View", "React & TypeScript / Material-UI", "Provides operational analytics and fulfillment management.")
    Component(Reporting_Analytics_View, "Reporting & Analytics View", "React & TypeScript / Material-UI", "Displays operational reports and system analytics.")
    Component(Audit_Logging_Client, "Audit & Logging Client", "React & TypeScript", "Collects and forwards audit logs to the backend to meet GDPR and CCPA compliance.")
}

Container(Amazon_API_Gateway, "Amazon API Gateway", "Amazon API Gateway", "Secure ingress routing and JWT validation.")
Container(Admin_Service, "Admin Service", "Node.js / Express", "Handles administrative backend logic and system configurations.")

Rel(Store_Administrator, Authentication_Module, "OIDC/OAuth2")
Rel(Authentication_Module, Identity_Provider, "HTTPS/OIDC")
Rel(Catalogue_Management_Dashboard, Amazon_API_Gateway, "HTTPS/REST with JWT validation")
Rel(Operations_Fulfillment_View, Amazon_API_Gateway, "HTTPS/REST with JWT validation")
Rel(Reporting_Analytics_View, Amazon_API_Gateway, "HTTPS/REST with JWT validation")
Rel(Audit_Logging_Client, Amazon_API_Gateway, "HTTPS/REST")
Rel(Amazon_API_Gateway, Admin_Service, "HTTPS/REST with JWT validation")

@enduml