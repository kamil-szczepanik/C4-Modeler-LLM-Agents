@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon API Gateway container

Container(Web Frontend, "Web Frontend", "React SPA", "User interface for the e-commerce platform.")
Container(Catalogue Service, "Catalogue Service", "Node.js / Express", "Manages book catalogue and queries relational data.")
Container(Order and Checkout Service, "Order and Checkout Service", "Go", "Handles order placement and checkout.")

Container_Boundary("Amazon API Gateway", "Amazon API Gateway") {
    Component(WAF & Threat Protection, "WAF & Threat Protection", "AWS WAF", "Inspects incoming traffic and provides threat protection.")
    Component(JWT Authorizer, "JWT Authorizer", "AWS Lambda / Native IAM", "Forwards sanitized requests and handles authentication context.")
    Component(Request Validator, "Request Validator", "API Gateway Request Validator", "Passes validated security context.")
    Component(Throttling & Rate Limiter, "Throttling & Rate Limiter", "API Gateway Usage Plans", "Evaluates rate limits and throttles requests.")
    Component(Response Caching, "Response Caching", "API Gateway Cache", "Checks cache for read operations.")
    Component(API Router, "API Router", "Amazon API Gateway Routes/Stages", "Forwards approved requests to downstream services.")
    Component(Access Logging & Tracing, "Access Logging & Tracing", "Amazon CloudWatch / AWS X-Ray", "Emits metrics and handles logging and tracing.")
}

Rel(Web Frontend, WAF & Threat Protection, "Inspects incoming traffic", "HTTPS/REST")
Rel(WAF & Threat Protection, JWT Authorizer, "Forwards sanitized requests", "Internal")
Rel(JWT Authorizer, Request Validator, "Passes validated security context", "Internal")
Rel(Request Validator, Throttling & Rate Limiter, "Evaluates rate limits", "Internal")
Rel(Throttling & Rate Limiter, API Router, "Forwards approved requests", "Internal")
Rel(API Router, Response Caching, "Checks cache for read operations", "Internal")
Rel(API Router, Catalogue Service, "Routes catalogue requests", "HTTPS/REST with mTLS")
Rel(API Router, Order and Checkout Service, "Routes checkout requests", "HTTPS/REST with mTLS")
Rel(API Router, Access Logging & Tracing, "Emits metrics", "Internal")

@enduml