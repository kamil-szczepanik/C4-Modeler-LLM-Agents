@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Frontend container

System_Ext(Amazon_API_Gateway, "Amazon API Gateway", "Amazon API Gateway")

Container_Boundary(Web_Frontend, "Web Frontend") {
    Component(Catalogue_Browser, "Catalogue Browser", "React Component", "Renders book catalogue, search results, and details for customers.")
    Component(Shopping_Cart_Manager, "Shopping Cart Manager", "React Component", "Handles user cart operations and session state.")
    Component(Checkout_UI, "Checkout UI", "React Component", "Provides interface for secure checkout and payment processing.")
    Component(Review_Component, "Review Component", "React Component", "Allows users to read and submit book reviews.")
}

Rel(Catalogue_Browser, Amazon_API_Gateway, "Fetches catalogue data", "HTTPS/REST")
Rel(Shopping_Cart_Manager, Amazon_API_Gateway, "Syncs cart state", "HTTPS/REST")
Rel(Checkout_UI, Amazon_API_Gateway, "Submits orders", "HTTPS/REST")
Rel(Review_Component, Amazon_API_Gateway, "Manages reviews", "HTTPS/REST")

@enduml