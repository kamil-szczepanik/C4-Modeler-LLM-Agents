@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(order_service, "Order and Checkout Service", "Go-based backend service handling customer orders and checkouts.")

Container_Boundary(dynamodb, "Amazon DynamoDB") {
    Component(cart_table, "Cart Table", "Amazon DynamoDB Global Table", "Low-latency data store for managing user shopping carts across multiple regions with TTL and KMS encryption.")
    Component(session_table, "Session Table", "Amazon DynamoDB Global Table", "Low-latency data store for managing active user sessions across multiple regions.")
}

Rel(order_service, cart_table, "Reads and writes shopping cart data", "TLS 1.3 with VPC Endpoints")
Rel(order_service, session_table, "Reads and writes session data", "TLS 1.3 with VPC Endpoints")

@enduml