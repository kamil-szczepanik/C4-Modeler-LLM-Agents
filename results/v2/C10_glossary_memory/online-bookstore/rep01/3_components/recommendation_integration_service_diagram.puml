@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Db(aurora, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Multi-region relational database for persistent catalogue and sales data storage.")
System_Ext(ml_engine, "ML Recommendation Engine", "Amazon Personalize", "Managed machine learning service for real-time personalized recommendations.")

Container_Boundary(recommendation_integration_service, "Recommendation Integration Service") {
    Component(api_controller, "Recommendation API Controller", "Node.js / Express", "Handles incoming recommendation requests and exposes the recommendation API endpoints.")
    Component(fallback_manager, "Recommendation Fallback Manager", "Node.js", "Invokes fallback mechanisms on failure and manages cache refresh operations.")
    Component(fallback_cache, "Contextual Fallback Cache", "Node.js / LRU-Cache", "Queries and stores category-specific fallback items for low-latency access.")
    Component(event_publisher, "Clickstream Event Publisher", "Node.js / AWS SDK", "Publishes user interaction events asynchronously to the ML recommendation engine.")
}

Rel(api_controller, fallback_manager, "Invokes fallback on failure", "In-process function call")
Rel(fallback_manager, fallback_cache, "Queries category-specific fallback items", "In-process memory lookup")
Rel(fallback_manager, aurora, "Refreshes fallback cache", "TCP")
Rel(event_publisher, ml_engine, "Publishes user interaction events", "Asynchronous SQS/SNS")
@enduml