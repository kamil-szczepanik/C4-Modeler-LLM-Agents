@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_opensearch, "Amazon OpenSearch") {
    Component(Search_Index_Engine, "Search Index Engine", "Amazon OpenSearch Engine", "Delivers sub-second full-text and faceted search capabilities.")
    Component(Ingestion_Indexing_Pipeline, "Ingestion & Indexing Pipeline", "Logstash / OpenSearch Ingestion", "Handles data ingestion and indexing pipelines for catalogue and search updates.")
    Component(Cluster_Management_Security, "Cluster Management & Security", "AWS IAM & OpenSearch Security", "Manages cluster scaling, node orchestration, and access security with SigV4.")
}

Rel(Ingestion_Indexing_Pipeline, Search_Index_Engine, "Indexes documents into")
Rel(Cluster_Management_Security, Search_Index_Engine, "Secures and manages cluster nodes for")
@enduml