@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Order and Checkout Service container

Container_Boundary(order_and_checkout_service, "Order and Checkout Service") {
    Component(Cart_Component, "Cart Component", "Go / In-Memory", "Low-latency shopping cart persistence to minimize cart abandonment.")
    Component(Checkout_Orchestrator, "Checkout Orchestrator", "Go", "Handles transactional safety, multi-currency support, and checkout orchestration.")
    Component(Order_Processing_Component, "Order Processing Component", "Go", "Handles ACID-compliant order finalization and multi-region replication.")
    Component(Notification_Component, "Notification Component", "Go", "Sends asynchronous transactional email notifications without blocking checkout.")
}

System_Ext(Payment_Gateway, "Payment Gateway", "Stripe or PayPal")
System_Ext(Third_Party_Shipping_APIs, "Third-Party Shipping APIs", "External Shipping Provider")
System_Ext(Email_Service, "Email Service", "Amazon SES")
ContainerDb(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Relational Database", "ACID-compliant order finalization and multi-region replication")
ContainerDb(Amazon_DynamoDB, "Amazon DynamoDB", "NoSQL Database", "Low-latency shopping cart persistence")

Rel(Checkout_Orchestrator, Cart_Component, "In-Memory / Function Call")
Rel(Checkout_Orchestrator, Payment_Gateway, "HTTPS/REST")
Rel(Checkout_Orchestrator, Third_Party_Shipping_APIs, "HTTPS/REST")
Rel(Order_Processing_Component, Amazon_Aurora_PostgreSQL, "TCP with TLS 1.3")
Rel(Cart_Component, Amazon_DynamoDB, "TCP with TLS 1.3")
Rel(Notification_Component, Email_Service, "Amazon SES")

@enduml