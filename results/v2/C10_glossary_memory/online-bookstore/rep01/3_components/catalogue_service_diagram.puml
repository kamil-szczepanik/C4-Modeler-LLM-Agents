@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(catalogue_service, "Catalogue Service") {
    Component(Catalogue_API_Router, "Catalogue API Router", "Express Router", "Handles incoming REST endpoints.")
    Component(Search_Component, "Search Component", "Node.js / OpenSearch SDK", "Executes low-latency queries.")
    Component(Inventory_Pricing_Component, "Inventory & Pricing Component", "Node.js / Sequelize ORM", "Manages relational book data.")
    Component(Catalogue_Sync_Worker, "Catalogue Sync Worker", "Node.js background process", "Synchronizes updates.")
    ComponentDb(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Relational data store.")
    Component(Amazon_OpenSearch, "Amazon OpenSearch", "Amazon OpenSearch", "Search engine.")
    Component(Amazon_SQS, "Amazon SQS", "Amazon SQS", "Event queue for synchronization.")
}

Rel(Catalogue_API_Router, Search_Component, "In-Process Function Call")
Rel(Catalogue_API_Router, Inventory_Pricing_Component, "In-Process Function Call with JWT validation")
Rel(Search_Component, Amazon_OpenSearch, "TLS/TCP")
Rel(Inventory_Pricing_Component, Amazon_Aurora_PostgreSQL, "TLS/TCP")
Rel(Catalogue_Sync_Worker, Amazon_OpenSearch, "TLS/TCP using bulk ingestion APIs")
Rel(Catalogue_Sync_Worker, Amazon_SQS, "HTTPS")
@enduml