@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_aurora_postgresql, "Amazon Aurora PostgreSQL") {
    Component(Catalogue_Data_Manager, "Catalogue Data Manager", "PostgreSQL Schema / SQL", "Manages persistent storage and retrieval for the book catalogue data.")
    Component(Order_Data_Manager, "Order Data Manager", "PostgreSQL Schema / SQL", "Handles relational data persistence for transactional orders and checkout safety.")
    Component(Review_Data_Manager, "Review Data Manager", "PostgreSQL Schema / SQL", "Manages relational persistence for user book reviews and ratings.")
    Component(Admin_Data_Manager, "Admin Data Manager", "PostgreSQL Schema / SQL", "Stores administrative configurations, catalogue management data, and system settings.")
}

Rel(Catalogue_Data_Manager, Order_Data_Manager, "Maintains relational consistency for order items and catalogue references")
@enduml