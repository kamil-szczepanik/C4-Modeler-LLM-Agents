@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(Book_Shopper, "Book Shopper", "An end-user browsing the catalogue, purchasing books, and leaving reviews.")
Person(Reviewer, "Reviewer", "A user who interacts with the system to read and submit book reviews.")
Person(Store_Administrator, "Store Administrator", "An administrator managing system configurations, catalogue items, and store operations.")

System_Ext(Payment_Gateway, "Payment Gateway", "External payment processor such as Stripe or PayPal handling secure checkout transactions.")
System_Ext(Third_Party_Shipping_APIs, "Third-Party Shipping APIs", "External shipping providers handling order fulfillment and delivery tracking.")
System_Ext(Identity_Provider, "Identity Provider", "Authentication and authorization service such as Auth0 or AWS Cognito utilizing OAuth2/OIDC.")
System_Ext(Email_Service, "Email Service", "Amazon SES used for sending transactional and notification emails.")
System_Ext(ML_Recommendation_Engine, "ML Recommendation Engine", "Amazon Personalize providing personalized book recommendations.")

System_Boundary(Online_Bookstore, "Online Bookstore") {
    Container(Web_Frontend, "Web Frontend", "React SPA", "Provides catalogue browsing, user account management, and customer-facing UI.")
    Container(Admin_Portal, "Admin Portal", "React SPA", "Provides administrative UI for managing catalogue items and store operations.")
    Container(Amazon_API_Gateway, "Amazon API Gateway", "Amazon API Gateway", "Entry point for client requests, routing traffic and validating JWT tokens.")
    Container(Catalogue_Service, "Catalogue Service", "Node.js / Express", "Manages book catalogue data and sub-second keyword search.")
    Container(Order_and_Checkout_Service, "Order and Checkout Service", "Go", "Handles transactional checkout safety and order processing.")
    Container(Review_Service, "Review Service", "Python / FastAPI", "Manages submission and retrieval of book reviews.")
    Container(Admin_Service, "Admin Service", "Node.js / Express", "Handles administrative backend logic and system configurations.")
    Container(Recommendation_Integration_Service, "Recommendation Integration Service", "Node.js", "Integrates with external ML recommendation engine for personalized book suggestions.")
    ContainerDb(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Multi-region relational data store for persistent application data.")
    ContainerDb(Amazon_DynamoDB, "Amazon DynamoDB", "Amazon DynamoDB", "Low-latency data store for user shopping carts and active sessions.")
    ContainerDb(Amazon_OpenSearch, "Amazon OpenSearch", "Amazon OpenSearch", "Provides sub-second keyword search capabilities for the catalogue.")
}

Rel(Book_Shopper, Web_Frontend, "Browses catalogue, manages account, and performs secure checkout", "HTTPS via AWS CloudFront")
Rel(Reviewer, Web_Frontend, "Submits and reads book reviews", "HTTPS via AWS CloudFront")
Rel(Store_Administrator, Admin_Portal, "Manages store catalogue and administrative operations", "HTTPS via AWS CloudFront")

Rel(Web_Frontend, Amazon_API_Gateway, "Sends API requests for catalogue, orders, and reviews", "HTTPS/REST with JWT validation")
Rel(Admin_Portal, Amazon_API_Gateway, "Sends API requests for administrative tasks", "HTTPS/REST with JWT validation")

Rel(Amazon_API_Gateway, Catalogue_Service, "Routes catalogue and search requests", "HTTPS/REST with JWT validation")
Rel(Amazon_API_Gateway, Order_and_Checkout_Service, "Routes checkout and order processing requests", "HTTPS/REST with JWT validation")
Rel(Amazon_API_Gateway, Review_Service, "Routes review submission and retrieval requests", "HTTPS/REST with JWT validation")
Rel(Amazon_API_Gateway, Admin_Service, "Routes administrative backend requests", "HTTPS/REST with JWT validation")
Rel(Amazon_API_Gateway, Recommendation_Integration_Service, "Routes recommendation requests", "HTTPS/REST with JWT validation")

Rel(Order_and_Checkout_Service, Payment_Gateway, "Processes secure checkout payments", "HTTPS/REST")
Rel(Order_and_Checkout_Service, Third_Party_Shipping_APIs, "Coordinates order fulfillment and shipping", "HTTPS/REST and Webhooks")
Rel(Web_Frontend, Identity_Provider, "Authenticates users and manages sessions", "OAuth2/OIDC")
Rel(Admin_Portal, Identity_Provider, "Authenticates administrators and manages sessions", "OAuth2/OIDC")
Rel(Order_and_Checkout_Service, Email_Service, "Sends automated notifications and receipts", "Amazon SES")
Rel(Recommendation_Integration_Service, ML_Recommendation_Engine, "Fetches personalized product recommendations", "HTTPS/REST and Asynchronous SQS/SNS")

Rel(Catalogue_Service, Amazon_Aurora_PostgreSQL, "Reads and writes relational catalogue data", "TCP")
Rel(Catalogue_Service, Amazon_OpenSearch, "Queries catalogue index for keyword search", "TCP")
Rel(Order_and_Checkout_Service, Amazon_Aurora_PostgreSQL, "Persists order and transaction data", "TCP")
Rel(Order_and_Checkout_Service, Amazon_DynamoDB, "Reads and writes shopping cart data", "TCP")
Rel(Review_Service, Amazon_Aurora_PostgreSQL, "Persists book reviews", "TCP")
Rel(Admin_Service, Amazon_Aurora_PostgreSQL, "Updates administrative and catalogue records", "TCP")

@enduml