@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Book_Shopper, "Book Shopper", "An end-user browsing the catalogue, purchasing books, and leaving reviews.")
Person(Reviewer, "Reviewer", "A user who interacts with the system to read and submit book reviews.")
Person(Store_Administrator, "Store Administrator", "An administrator managing system configurations, catalogue items, and store operations.")

System(Online_Bookstore, "Online Bookstore", "A multi-region e-commerce platform providing catalogue browsing, secure checkout, reviews, and personalized recommendations for 1 million monthly active users.")

System_Ext(Payment_Gateway, "Payment Gateway", "External payment processor such as Stripe or PayPal handling secure checkout transactions.")
System_Ext(Third_Party_Shipping_APIs, "Third-Party Shipping APIs", "External shipping providers handling order fulfillment and delivery tracking.")
System_Ext(Identity_Provider, "Identity Provider", "Authentication and authorization service such as Auth0 or AWS Cognito utilizing OAuth2/OIDC.")
System_Ext(Email_Service, "Email Service", "Amazon SES used for sending transactional and notification emails.")
System_Ext(ML_Recommendation_Engine, "ML Recommendation Engine", "Amazon Personalize providing personalized book recommendations.")

Rel(Book_Shopper, Online_Bookstore, "Browses catalogue, manages account, and performs secure checkout", "HTTPS via CloudFront")
Rel(Reviewer, Online_Bookstore, "Submits and reads book reviews", "HTTPS via CloudFront")
Rel(Store_Administrator, Online_Bookstore, "Manages store catalogue and administrative operations", "HTTPS via CloudFront")

Rel(Online_Bookstore, Payment_Gateway, "Processes secure checkout payments", "HTTPS/REST")
Rel(Online_Bookstore, Third_Party_Shipping_APIs, "Coordinates order fulfillment and shipping", "HTTPS/REST and Webhooks")
Rel(Online_Bookstore, Identity_Provider, "Authenticates users and manages sessions", "OAuth2/OIDC")
Rel(Online_Bookstore, Email_Service, "Sends automated notifications and receipts", "Amazon SES")
Rel(Online_Bookstore, ML_Recommendation_Engine, "Fetches personalized product recommendations", "HTTPS/REST and Asynchronous SQS/SNS")

@enduml