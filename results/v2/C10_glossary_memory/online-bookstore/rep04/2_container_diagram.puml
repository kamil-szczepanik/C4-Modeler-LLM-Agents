@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore System

Person(Customers, "Customers", "Primary system users interacting via web and mobile interfaces to browse catalogs, purchase books, and write reviews.")
Person(Authors_Publishers, "Authors/Publishers", "Users who interact with the system regarding catalog content and publications.")
Person(Store_Administrators, "Store Administrators", "Users responsible for managing the e-commerce platform, catalogs, orders, and support.")

System_Ext(Payment_Gateway, "Payment Gateway", "External system processing secure financial transactions via client-side tokenization and webhook callbacks.")
System_Ext(Third_Party_Shipping_APIs, "Third-Party Shipping APIs", "External APIs used for fulfillment and shipping synchronization.")
System_Ext(Identity_Provider, "Identity Provider", "External Identity Provider (AWS Cognito/Auth0) handling authentication and MFA.")
System_Ext(AWS_CloudFront_CDN_WAF, "AWS CloudFront CDN/WAF", "Edge and security infrastructure for DDoS protection, TLS 1.3 termination, and content delivery.")
System_Ext(Route_53, "Route 53", "DNS routing service for global traffic management.")
System_Ext(AWS_Secrets_Manager, "AWS Secrets Manager", "Service for dynamic credential rotation.")
System_Ext(AWS_KMS, "AWS KMS", "Service for encryption at rest using AES-256.")

System_Boundary(Online_Bookstore_System, "Online Bookstore System") {
    Container(Web_App_Frontend, "Web App Frontend", "React, Next.js, TypeScript", "Delivers catalog browsing, secure checkout, reviews, and personalized recommendations.")
    Container(API_Gateway, "API Gateway", "Amazon API Gateway", "Routes and manages incoming API requests to backend microservices.")
    Container(Catalog_Search_Service, "Catalog & Search Service", "Java, Spring Boot, Amazon OpenSearch", "Handles catalog management and search functionalities.")
    Container(Checkout_Order_Service, "Checkout & Order Service", "Go, gRPC/REST", "Handles secure checkout and order processing for ACID performance.")
    Container(Recommendation_Service, "Recommendation Service", "Python, FastAPI", "Delivers personalized recommendations to users.")
    Container(Admin_Management_Service, "Admin Management Service", "Java, Spring Boot", "Manages store administration and operational tasks.")
    ContainerDb(Database_Storage, "Database Storage", "Amazon Aurora PostgreSQL Global Database", "Multi-region transactional persistence layer.")
    ContainerDb(Caching_Layer, "Caching Layer", "Amazon ElastiCache (Redis)", "Provides sub-100ms caching for recommendations and data.")
}

Rel(Customers, Web_App_Frontend, "Interacts with the web application for browsing, purchasing, and reviews", "HTTPS / TLS 1.3 / OAuth 2.0 / OIDC")
Rel(Web_App_Frontend, API_Gateway, "Sends API requests to backend services", "HTTPS / REST / gRPC")
Rel(API_Gateway, Catalog_Search_Service, "Routes catalog and search queries", "HTTPS / gRPC")
Rel(API_Gateway, Checkout_Order_Service, "Routes checkout and order processing requests", "HTTPS / gRPC")
Rel(API_Gateway, Recommendation_Service, "Routes recommendation requests", "HTTPS / gRPC")
Rel(API_Gateway, Admin_Management_Service, "Routes administrative management requests", "HTTPS / gRPC")
Rel(Checkout_Order_Service, Payment_Gateway, "Processes secure payments", "HTTPS / REST APIs")
Rel(Checkout_Order_Service, Third_Party_Shipping_APIs, "Handles order fulfillment and shipping synchronization", "HTTPS / REST APIs")
Rel(API_Gateway, Identity_Provider, "Authenticates users via OIDC/OAuth 2.0", "OIDC / OAuth 2.0 / HTTPS")
Rel(Recommendation_Service, Caching_Layer, "Retrieves and stores cached recommendation data", "Redis Protocol")
Rel(Catalog_Search_Service, Database_Storage, "Reads and writes transactional data", "PostgreSQL Protocol over TLS")
Rel(Checkout_Order_Service, Database_Storage, "Reads and writes transactional data", "PostgreSQL Protocol over TLS")
Rel(Admin_Management_Service, Database_Storage, "Reads and writes transactional data", "PostgreSQL Protocol over TLS")

@enduml