@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Online Bookstore System

Person(Customers, "Customers", "Primary system users interacting via web and mobile interfaces to browse catalogs, purchase books, and write reviews.")
Person(Authors_Publishers, "Authors/Publishers", "Users who interact with the system regarding catalog content and publications.")
Person(Store_Administrators, "Store Administrators", "Users responsible for managing the e-commerce platform, catalogs, orders, and support.")

System(Online_Bookstore_System, "Online Bookstore System", "An AWS-hosted online bookstore built for 1M MAU, delivering catalog browsing, secure checkout, reviews, and personalized recommendations.")

System_Ext(Payment_Gateway, "Payment Gateway", "External system processing secure financial transactions via client-side tokenization and webhook callbacks.")
System_Ext(Third_Party_Shipping_APIs, "Third-Party Shipping APIs", "External APIs used for fulfillment and shipping synchronization.")
System_Ext(Notification_Service, "Notification Service", "External notification service (SES/SendGrid) for sending system emails and alerts.")
System_Ext(Customer_Support_CRM, "Customer Support CRM", "External CRM system for managing customer support operations.")
System_Ext(Identity_Provider, "Identity Provider", "External Identity Provider (AWS Cognito/Auth0) handling authentication and MFA.")
System_Ext(AWS_CloudFront_CDN_WAF, "AWS CloudFront CDN/WAF", "Edge and security infrastructure for DDoS protection, TLS 1.3 termination, and content delivery.")
System_Ext(Route_53, "Route 53", "DNS routing service for global traffic management.")
System_Ext(AWS_Secrets_Manager, "AWS Secrets Manager", "Service for dynamic credential rotation.")
System_Ext(AWS_KMS, "AWS KMS", "Service for encryption at rest using AES-256.")

Rel(Customers, Online_Bookstore_System, "Connect via HTTPS (TLS 1.3) through CDN/WAF for browsing, purchasing, and reviews", "HTTPS / TLS 1.3 / OAuth 2.0 / OIDC")
Rel(Authors_Publishers, Online_Bookstore_System, "Interact with system via web and mobile interfaces", "HTTPS")
Rel(Store_Administrators, Online_Bookstore_System, "Administer the store and manage operations", "HTTPS")
Rel(Online_Bookstore_System, Payment_Gateway, "Integrates for secure payment processing and webhook callbacks", "HTTPS / REST APIs")
Rel(Online_Bookstore_System, Third_Party_Shipping_APIs, "Integrates for order fulfillment and shipping", "HTTPS / REST APIs")
Rel(Online_Bookstore_System, Customer_Support_CRM, "Synchronizes customer support data", "HTTPS / REST APIs")
Rel(Online_Bookstore_System, Identity_Provider, "Authenticates users via OIDC/OAuth 2.0 supporting MFA", "OIDC / OAuth 2.0 / HTTPS")

@enduml