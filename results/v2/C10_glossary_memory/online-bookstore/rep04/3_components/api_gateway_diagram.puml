@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Routing__Dispatcher_Component, "Routing & Dispatcher Component", "Amazon API Gateway Router", "Forwards queries and routes checkout payloads to downstream microservices.")
    Component(Authentication__Authorization_Authorizer, "Authentication & Authorization Authorizer", "Lambda Authorizer / IAM", "Validates tokens against the Identity Provider.")
    Component(Throttling__Rate_Limiting_Component, "Throttling & Rate Limiting Component", "API Gateway Usage Plans", "Manages ingress traffic limits and ensures scalable throughput.")
    Component(Request_Transformation__Enrichment_Component, "Request Transformation & Enrichment Component", "API Gateway Mapping Templates", "Fetches routing secrets and enriches incoming requests.")
}

System_Ext(Catalog___Search_Service, "Catalog & Search Service", "Java, Spring Boot, Amazon OpenSearch")
System_Ext(Checkout___Order_Service, "Checkout & Order Service", "Go, gRPC/REST")
System_Ext(Identity_Provider, "Identity Provider", "AWS Cognito/Auth0")
System_Ext(AWS_Secrets_Manager, "AWS Secrets Manager", "Secrets Management")

Rel(Routing__Dispatcher_Component, Catalog___Search_Service, "Forwards queries", "gRPC over TLS with mTLS")
Rel(Routing__Dispatcher_Component, Checkout___Order_Service, "Routes checkout payloads", "gRPC/HTTP/2 over mTLS")
Rel(Authentication__Authorization_Authorizer, Identity_Provider, "Validates tokens", "HTTPS / OAuth 2.0 / OIDC")
Rel(Request_Transformation__Enrichment_Component, AWS_Secrets_Manager, "Fetches routing secrets", "HTTPS")

@enduml