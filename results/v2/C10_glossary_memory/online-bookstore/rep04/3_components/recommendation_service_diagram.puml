@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Recommendation Service container

Container_Boundary(recommendation_service, "Recommendation Service") {
    Component(Recommendation_API_Controller, "Recommendation API Controller", "Python, FastAPI", "Handles incoming API requests and business logic routing for personalized book recommendations.")
    Component(Model_Inference_Engine, "Model Inference Engine", "PyTorch, Scikit-learn", "Processes machine learning models to generate real-time personalized recommendations.")
    Component(Event_Consumer, "Event Consumer", "Python, Amazon MSK / Kafka Client", "Consumes asynchronous events from the event stream for real-0time customer behavior tracking.")
    Component(Cache_Integration_Client, "Cache Integration Client", "Python, Redis Client, TLS 1.3", "Interacts with the caching layer to deliver sub-100ms recommendation data.")
}

Container(Caching_Layer, "Caching Layer", "Amazon ElastiCache (Redis)", "Delivers sub-100ms caching for recommendation data using TLS 1.3.")

Rel(Recommendation_API_Controller, Model_Inference_Engine, "Invokes model inference")
Rel(Recommendation_API_Controller, Cache_Integration_Client, "Retrieves cached recommendations")
Rel(Event_Consumer, Model_Inference_Engine, "Updates model features based on event stream")
Rel(Cache_Integration_Client, Caching_Layer, "Redis Protocol over TLS 1.3")
@enduml