@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Customers, "Customers", "Interacts with the web application")
System_Ext(IdentityProvider, "Identity Provider", "Handles authentication (OIDC / OAuth 2.0)")
System_Ext(APIGateway, "API Gateway", "Amazon API Gateway")

Container_Boundary(web_app_frontend, "Web App Frontend") {
    Component(SSR_Page_Router___Rendering_Component, "SSR Page Router / Rendering Component", "Next.js App Router, TypeScript", "Handles server-side rendering and user authentication flows.")
    Component(Catalog___Search_UI_Component, "Catalog & Search UI Component", "React, TypeScript", "Provides catalog browsing and search user interface.")
    Component(Shopping_Cart___Checkout_UI_Component, "Shopping Cart & Checkout UI Component", "React, TypeScript", "Manages shopping cart interactions and secure checkout workflows.")
    Component(Reviews___Recommendations_Component, "Reviews & Recommendations Component", "React, TypeScript", "Displays user reviews and personalized recommendations.")
    Component(Localization___Currency_Preference_Component, "Localization & Currency Preference Component", "React, TypeScript", "Manages user localization and currency preferences.")
    Component(API_Client___BFF_Proxy_Component, "API Client / BFF Proxy Component", "Next.js API Routes / TypeScript", "Proxies backend requests and handles internal function calls.")
}

Rel(Customers, web_app_frontend, "Interacts with the web application", "HTTPS / TLS 1.3 / OAuth 2.0 / OIDC")
Rel(SSR_Page_Router___Rendering_Component, IdentityProvider, "Handles user authentication flow", "OIDC / OAuth 2.0 / HTTPS")
Rel(SSR_Page_Router___Rendering_Component, API_Client___BFF_Proxy_Component, "Internal function calls", "Internal function call / HTTP")
Rel(API_Client___BFF_Proxy_Component, APIGateway, "Proxies backend requests", "HTTPS / REST")
Rel(web_app_frontend, APIGateway, "Sends API requests to backend services", "HTTPS / REST / gRPC")

@enduml