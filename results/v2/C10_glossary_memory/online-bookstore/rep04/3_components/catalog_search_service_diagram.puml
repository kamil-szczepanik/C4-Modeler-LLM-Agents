@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(catalog_search_service, "Catalog & Search Service") {
    Component(Catalog Search Controller, "Catalog Search Controller", "Java, Spring Boot", "Exposes REST and gRPC endpoints for searching and browsing the product catalog.")
    Component(Search Indexer, "Search Indexer", "Java, Spring Boot", "Synchronizes product catalog data and executes faceted search queries against Amazon OpenSearch.")
    Component(Cache Manager, "Cache Manager", "Java, Spring Boot, Redis Client", "Reads and writes cached search hits and metadata to the Caching Layer.")
}

System_Ext(Amazon OpenSearch, "Amazon OpenSearch", "Provides high-speed keyword and faceted search capabilities.")
System_Ext(Database Storage, "Database Storage", "Amazon Aurora PostgreSQL Global Database")
System_Ext(Caching Layer, "Caching Layer", "Amazon ElastiCache (Redis)")

Rel(Catalog Search Controller, Search Indexer, "Delegates search and retrieval requests")
Rel(Search Indexer, Amazon OpenSearch, "Executes faceted search queries", "TLS")
Rel(Search Indexer, Database Storage, "Syncs catalog source-of-truth", "PostgreSQL Protocol over TLS")
Rel(Search Indexer, Caching Layer, "Reads/writes cached search hits and metadata", "Redis Protocol over TLS")
@enduml