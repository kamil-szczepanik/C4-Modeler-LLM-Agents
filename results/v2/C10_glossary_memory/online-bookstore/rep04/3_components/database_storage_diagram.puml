@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Database Storage", "Database Storage") {
    Component(Global Database Instance, "Global Database Instance", "Amazon Aurora PostgreSQL Global Database", "Multi-region transactional persistence layer managing structured store data across regions.")
    Component(RDS Proxy, "RDS Proxy", "Amazon RDS Proxy", "Manages database connections, connection pooling, and multi-region failover.")
}

Rel(RDS Proxy, Global Database Instance, "Routes and pools database connections over TLS", "PostgreSQL Protocol over TLS")

@enduml