@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Boundary(caching_layer, "Caching Layer") {
    Component(Redis Cache Engine, "Redis Cache Engine", "Amazon ElastiCache (Redis)", "Provides sub-100ms in-memory caching for recommendations and high-traffic catalog data.")
}

Rel(Recommendation Service, Redis Cache Engine, "Reads and writes recommendation cache data", "Redis Protocol")
Rel(Catalog & Search Service, Redis Cache Engine, "Reads and writes catalog cache data", "Redis Protocol")

@enduml