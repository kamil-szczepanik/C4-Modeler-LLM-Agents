@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Admin Management Service container

System_Ext(api_gateway, "API Gateway", "Routes incoming requests")
System_Ext(database_storage, "Database Storage", "Stores transactional data")
System_Ext(catalog_search_service, "Catalog & Search Service", "Provides catalog search and indexing capabilities")
System_Ext(checkout_order_service, "Checkout & Order Service", "Manages customer orders and checkout flows")
System_Ext(aws_sqs_sns, "AWS SQS / SNS", "Managed messaging and notification services")
System_Ext(identity_provider, "Identity Provider", "Handles authentication and authorization")
System_Ext(aws_secrets_manager, "AWS Secrets Manager", "Manages secrets and credentials")

Container_Boundary(admin_management_service, "Admin Management Service") {
    Component(Admin_API_Controller, "Admin API Controller", "Spring MVC", "Exposes secure endpoints for administrative operations and RBAC validation.")
    Component(Catalog_Management_Component, "Catalog Management Component", "Spring Data JPA", "Manages administrative CRUD operations for books and categories.")
    Component(Order_Operations_Component, "Order Operations Component", "Java, Spring Boot", "Handles administrative overrides, refunds, and fulfillment tracking.")
    Component(Audit_Logging_Service, "Audit Logging Service", "Java, Spring Boot", "Captures immutable administrative action trails.")
    Component(Metrics_Reporting_Component, "Metrics & Reporting Component", "Java, Spring Boot", "Aggregates operational KPIs for the administrative dashboard.")
    Component(Workflow_Orchestrator_Component, "Workflow Orchestrator Component", "Java, Spring Boot", "Manages multi-step content governance state machines.")
}

Rel(api_gateway, Admin_API_Controller, "Routes administrative management requests", "HTTPS / gRPC")
Rel(Admin_API_Controller, database_storage, "Reads and writes transactional data", "PostgreSQL Protocol over TLS")
Rel(Catalog_Management_Component, catalog_search_service, "Interfaces for catalog synchronization", "gRPC")
Rel(Order_Operations_Component, checkout_order_service, "Communicates fulfillment updates", "gRPC")
Rel(Workflow_Orchestrator_Component, aws_sqs_sns, "Processes asynchronous workflows", "AWS SDK / HTTPS")
Rel(Admin_API_Controller, identity_provider, "Enforces step-up multi-factor authentication", "OIDC / OAuth 2.0 / HTTPS")
Rel(Admin_API_Controller, aws_secrets_manager, "Retrieves credentials via IAM role assumption", "HTTPS")

@enduml