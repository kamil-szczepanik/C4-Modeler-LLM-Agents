@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Checkout & Order Service container

System_Ext(API_Gateway, "API Gateway", "External API Gateway routing incoming requests.")
System_Ext(Payment_Gateway, "Payment Gateway", "External system processing secure financial transactions.")
System_Ext(Third_Party_Shipping_APIs, "Third-Party Shipping APIs", "External APIs used for fulfillment and shipping synchronization.")

Container_Boundary(checkout_and_order_service, "Checkout & Order Service") {
    Component(API_Handler_Component, "API Handler Component", "Go", "Handles incoming API requests and routing for checkout and order operations.")
    Component(Order_Management_Component, "Order Management Component", "Go", "Processes order fulfillment and management logic with ACID guarantees.")
    Component(Payment_Processing_Component, "Payment Processing Component", "Go", "Processes secure financial transactions interacting with external payment gateways.")
    Component(Fulfillment_Integration_Component, "Fulfillment Integration Component", "Go", "Integrates with third-party shipping APIs and includes a Shipping Rate & Estimation Sub-module.")
    Component(Compliance_Component, "Compliance Component", "Go", "Ensures strict GDPR, CCPA, and PCI-DSS compliance through tokenization, anonymization, and audit logging.")
    Component(Database_Storage, "Database Storage", "Amazon Aurora PostgreSQL Global Database", "Multi-region transactional persistence layer ensuring ACID guarantees.")
    Component(Caching_Layer, "Caching Layer", "Amazon ElastiCache (Redis)", "Provides sub-100ms caching for shipping fallback rates and related data.")
    Component(AWS_Secrets_Manager_AWS_KMS, "AWS Secrets Manager & AWS KMS", "AWS Secrets Manager & AWS KMS", "Enforces column-level PII encryption (AES-256) and dynamic credential rotation.")
}

Rel(API_Gateway, API_Handler_Component, "HTTPS / gRPC with TLS 1.3")
Rel(Order_Management_Component, Database_Storage, "PostgreSQL Protocol over TLS 1.3")
Rel(Payment_Processing_Component, Payment_Gateway, "HTTPS / REST APIs with TLS 1.3")
Rel(Fulfillment_Integration_Component, Third_Party_Shipping_APIs, "HTTPS / REST APIs with TLS 1.3")
Rel(Fulfillment_Integration_Component, Caching_Layer, "Redis Protocol")

@enduml