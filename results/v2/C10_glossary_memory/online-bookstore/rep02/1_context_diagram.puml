@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(BookBuyer, "Book Buyer / Customer and Site Visitor", "People interacting with the platform via HTTPS to browse catalogues, make purchases, write reviews, and receive recommendations.")

System(OnlineBookstore, "Online Bookstore", "A cloud-native e-commerce platform providing catalogue browsing, secure checkout, customer reviews, and personalized recommendations for physical and electronic books.")

System_Ext(PaymentGateway, "Payment Gateway", "External payment processing service such as Stripe or PayPal.")
System_Ext(ThirdPartyShippingProviders, "Third-Party Shipping Providers", "External shipping services such as FedEx and UPS APIs for fulfillment.")
System_Ext(TaxComplianceService, "Tax & Compliance Service", "External tax and compliance service such as Avalara.")
System_Ext(RecommendationEngine, "Recommendation Engine", "AWS Personalize service providing personalized book recommendations.")
System_Ext(EmailNotificationService, "Email/Notification Service", "Amazon SES for sending emails and notifications.")
System_Ext(CentralizedLoggingSIEM, "Centralized Logging & SIEM", "Centralized logging and security information and event management system.")

Rel(BookBuyer, OnlineBookstore, "Interact with the Online Bookstore for browsing, purchasing, and account management", "HTTPS (TLS 1.3)")
Rel(OnlineBookstore, PaymentGateway, "Processes secure payments with client-side payment tokenization", "REST over HTTPS with circuit breakers")
Rel(OnlineBookstore, ThirdPartyShippingProviders, "Calculates shipping rates and manages fulfillment", "REST over HTTPS with circuit breakers")
Rel(OnlineBookstore, TaxComplianceService, "Calculates applicable taxes for transactions", "REST over HTTPS with circuit breakers")
Rel(OnlineBookstore, RecommendationEngine, "Fetches personalized book recommendations", "AWS Personalize via REST over HTTPS")
Rel(OnlineBookstore, EmailNotificationService, "Sends transactional and notification emails", "Amazon SES")
Rel(OnlineBookstore, CentralizedLoggingSIEM, "Streams operational logs and security telemetry", "HTTPS / AWS Infrastructure")

@enduml