@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Content Moderator / Administrator, "Content Moderator / Administrator", "Human administrator managing complex moderation tasks.")
Person(Catalog / Quality Analyst, "Catalog / Quality Analyst", "Quality analyst reviewing metrics and catalog feedback.")

Container_Boundary(Customer Review & Moderation Service, "Customer Review & Moderation Service") {
    Component(Review Ingestion API, "Review Ingestion API", "Python/FastAPI", "Processes and ingests incoming customer reviews.")
    Component(Review Moderation Queue, "Review Moderation Queue", "Amazon SQS", "Queues reviews for moderation to protect system performance.")
    Component(Automated Moderation & Spam Filter, "Automated Moderation & Spam Filter", "Python/FastAPI with NLP/ML", "Performs automated moderation and spam filtering on reviews.")
    Component(Moderation Workflow & Analytics Engine, "Moderation Workflow & Analytics Engine", "Python/FastAPI", "Manages the moderation workflow and analytics.")
    Component(Review Persistence Repository, "Review Persistence Repository", "Amazon RDS", "Persistent relational storage for reviews and metrics.")
}

Rel(Review Ingestion API, Review Moderation Queue, "AWS SDK", "AWS SDK")
Rel(Review Moderation Queue, Automated Moderation & Spam Filter, "AWS SDK", "AWS SDK")
Rel(Automated Moderation & Spam Filter, Moderation Workflow & Analytics Engine, "Internal Function Call", "Internal Function Call")
Rel(Moderation Workflow & Analytics Engine, Review Persistence Repository, "AWS SDK", "AWS SDK")

@enduml