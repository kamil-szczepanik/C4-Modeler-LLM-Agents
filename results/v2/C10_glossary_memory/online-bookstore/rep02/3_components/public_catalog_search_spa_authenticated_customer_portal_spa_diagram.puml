@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(public_catalog_search_spa_authenticated_customer_portal_spa, "Public Catalog & Search SPA & Authenticated Customer Portal SPA") {
    Component(Public_Catalog_SPA, "Public Catalog SPA", "React, TypeScript, Vite, Amazon S3, Amazon CloudFront", "Provides public catalogue browsing and search functionalities to site visitors.")
    Component(Authenticated_Customer_Portal_SPA, "Authenticated Customer Portal SPA", "React, TypeScript, Vite, Amazon S3, Amazon CloudFront", "Provides authenticated customer portal capabilities for account and order management.")
    Component(Edge_Security_Routing_Component, "Edge Security & Routing Component", "AWS WAF, CloudFront Functions, Lambda@Edge", "Handles DDoS mitigation, edge routing, and CSP injection.")
}

Rel(Public_Catalog_SPA, AWS_API_Gateway, "Sends catalog and search API requests over HTTPS", "HTTPS")
Rel(Authenticated_Customer_Portal_SPA, AWS_API_Gateway, "Sends authenticated portal API requests over HTTPS", "HTTPS")

@enduml