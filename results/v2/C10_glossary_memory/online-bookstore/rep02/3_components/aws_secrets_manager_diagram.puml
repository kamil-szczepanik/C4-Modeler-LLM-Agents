@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("aws_secrets_manager", "AWS Secrets Manager") {
    Component(Secrets_Management_Engine, "Secrets Management Engine", "AWS Secrets Manager API", "Manages secrets, secure configuration data, and coordinates credential rotation.")
    Component(Encryption_Key_Service, "Encryption Key Service", "AWS KMS", "Provides envelope encryption and key management for protecting sensitive data.")
}

Rel(Secrets_Management_Engine, Encryption_Key_Service, "Uses for envelope encryption and decryption of secrets", "AWS SDK / API")
@enduml