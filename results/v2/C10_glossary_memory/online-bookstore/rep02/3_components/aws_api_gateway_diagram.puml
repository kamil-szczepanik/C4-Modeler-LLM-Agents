@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS API Gateway container

Container_Boundary(aws_api_gateway, "AWS API Gateway") {
    Component(api_gateway_http, "Amazon API Gateway HTTP API", "Amazon API Gateway HTTP API", "Handles and routes incoming HTTP requests from the frontend SPAs.")
    Component(aws_app_mesh, "AWS App Mesh", "AWS App Mesh", "Provides service mesh capabilities and routing management.")
    Component(api_router, "API Router / HTTP Proxy", "Envoy / HTTP Proxy", "Routes traffic to internal microservices.")
    Component(jwt_authorizer, "JWT Authorizer / Auth Validator", "AWS Lambda / JWT Validator", "Validates JSON Web Tokens for authenticated requests.")
    Component(rate_limiter, "Rate Limiter & Throttler", "API Gateway Native / Throttling Rules", "Controls traffic rates and protects backend services from overloads.")
    Component(service_mesh_proxy, "Service Mesh Proxy Sidecar", "Envoy Proxy Sidecar", "Manages secure communication via mutual TLS.")
    Component(request_validation, "Request Validation & Transformation", "API Gateway Validation", "Validates and transforms incoming request payloads.")
}

Rel(amazon_api_gateway_http_api, api_router, "Forwards routed requests")
Rel(api_router, service_mesh_proxy, "Proxies traffic via mTLS")
Rel(jwt_authorizer, amazon_api_gateway_http_api, "Validates tokens for requests")

@enduml