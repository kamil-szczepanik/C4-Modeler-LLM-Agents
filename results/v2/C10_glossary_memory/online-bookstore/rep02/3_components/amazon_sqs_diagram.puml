@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_sqs, "Amazon SQS") {
    Component(Order_Queue, "Order Queue", "Amazon SQS", "Decoupled asynchronous queue for managing order and checkout workflows.")
    Component(Notification_DLQ, "Notification DLQ", "Amazon SQS", "Dead letter queue for handling failed notification and engagement messages.")
}

Rel(Order_Queue, Notification_DLQ, "Routes failed messages", "AWS SDK")

@enduml