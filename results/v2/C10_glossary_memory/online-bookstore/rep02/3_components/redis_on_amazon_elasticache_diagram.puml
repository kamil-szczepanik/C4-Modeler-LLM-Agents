@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Catalog_Search_Service, "Catalog & Search Service", "Node.js/Express, Java/Spring Boot, Python/FastAPI, AWS ECS on Fargate")
System_Ext(Order_Checkout_Service, "Order & Checkout Service", "Node.js/Express, Java/Spring Boot, Python/FastAPI, AWS ECS on Fargate")
System_Ext(AWS_Secrets_Manager, "AWS Secrets Manager", "AWS Secrets Manager, AWS KMS")

Container_Boundary(Redis_on_Amazon_ElastiCache, "Redis on Amazon ElastiCache") {
    Component(Catalog_Cache_Store, "Catalog Cache Store", "In-Memory Key-Value Store", "Delivers sub-millisecond latency for high-frequency catalog searches and active shopping carts.")
    Component(Session_Cart_Store, "Session & Cart Store", "In-Memory Hash/String Store", "Maintains session state and active user shopping carts to protect checkout availability.")
}

Rel(Catalog_Search_Service, Catalog_Cache_Store, "RESP over TLS", "RESP over TLS")
Rel(Order_Checkout_Service, Session_Cart_Store, "RESP over TLS", "RESP over TLS")
Rel(Redis_on_Amazon_ElastiCache, AWS_Secrets_Manager, "AWS SDK for AUTH token management", "AWS SDK for AUTH token management")
@enduml