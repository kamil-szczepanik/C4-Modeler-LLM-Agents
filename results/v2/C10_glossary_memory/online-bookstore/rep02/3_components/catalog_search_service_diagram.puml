@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component Diagram for the Catalog & Search Service container

Container_Boundary(catalog_and_search_service, "Catalog & Search Service") {
    Component(CatalogSearchController, "Catalog Search Controller", "Spring MVC / gRPC Controller", "Handles incoming catalog search and browsing API requests from the API Gateway.")
    Component(CatalogSearchManager, "Catalog Search Manager", "Java / Spring Boot Service", "Implements business logic for searching, filtering, and retrieving book catalog information.")
    Component(CatalogRepository, "Catalog Repository", "Spring Data JPA / AWS SDK", "Interfaces with Amazon RDS for persistent catalog data storage and retrieval.")
    Component(SearchIndexClient, "Search Index Client", "Amazon OpenSearch Client / HTTPS", "Offloads heavy keyword searches, facets, and multi-currency catalog filtering to Amazon OpenSearch Service.")
    Component(CacheManager, "Cache Manager", "Spring Data Redis / RESP", "Manages in-memory caching with Redis on Amazon ElastiCache to optimize search and catalog performance.")
    Component(SecretConfigurationClient, "Secret Configuration Client", "AWS Secrets Manager SDK", "Retrieves encrypted secrets, database credentials, and configuration data from AWS Secrets Manager.")
}

Rel(CatalogSearchController, CatalogSearchManager, "Delegates requests")
Rel(CatalogSearchManager, CatalogRepository, "Queries relational catalog data via", "AWS SDK")
Rel(CatalogSearchManager, SearchIndexClient, "Executes keyword searches via", "HTTPS")
Rel(CatalogSearchManager, CacheManager, "Reads and writes cache entries via", "RESP over TLS")
Rel(CatalogSearchManager, SecretConfigurationClient, "Fetches credentials and secrets via", "AWS SDK")

@enduml