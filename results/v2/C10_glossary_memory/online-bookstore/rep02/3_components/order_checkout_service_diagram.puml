@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Order & Checkout Service container

Container_Boundary(order_checkout_service, "Order & Checkout Service") {
    Component(Checkout Orchestrator Component, "Checkout Orchestrator Component", "Java/Spring Boot, AWS ECS on Fargate", "Orchestrates the secure checkout and order processing workflow.")
    Component(Cart Management Component, "Cart Management Component", "Java/Spring Boot, AWS ECS on Fargate", "Manages shopping cart state and operations.")
    Component(Payment & Tax Integration Component, "Payment & Tax Integration Component", "Java/Spring Boot, AWS ECS on Fargate", "Integrates with payment gateways and tax compliance services.")
    Component(Order Fulfillment Component, "Order Fulfillment Component", "Java/Spring Boot, AWS ECS on Fargate", "Handles order fulfillment and dispatches asynchronous messages.")
}

System_Ext(Redis on Amazon ElastiCache, "Redis on Amazon ElastiCache", "In-memory store for session management and persistent cart state")
System_Ext(Amazon SQS, "Amazon SQS", "Asynchronous message queuing for decoupling order fulfillment events")
System_Ext(Amazon RDS, "Amazon RDS", "Relational database for storing order data")
System_Ext(PaymentGateway, "Payment Gateway", "External payment processing gateway")
System_Ext(ThirdPartyShippingProviders, "Third-Party Shipping Providers", "External shipping and logistics providers")
System_Ext(TaxComplianceService, "Tax & Compliance Service", "External tax calculation and compliance service")

Rel(Cart Management Component, Redis on Amazon ElastiCache, "RESP", "AWS SDK")
Rel(Order Fulfillment Component, Amazon SQS, "Sends fulfillment messages", "AWS SDK")
Rel(Checkout Orchestrator Component, Amazon RDS, "Reads/Writes order data", "AWS SDK")
Rel(Payment & Tax Integration Component, PaymentGateway, "REST over HTTPS with circuit breakers", "HTTPS")
Rel(Payment & Tax Integration Component, ThirdPartyShippingProviders, "REST over HTTPS with circuit breakers", "HTTPS")
Rel(Payment & Tax Integration Component, TaxComplianceService, "REST over HTTPS with circuit breakers", "HTTPS")

@enduml