@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification & Engagement Worker container

Container_Boundary(notification_worker, "Notification & Engagement Worker") {
    Component(notification_consumer, "Notification Consumer", "Node.js/Express, Java/Spring Boot, Python/FastAPI, AWS ECS on Fargate", "Consumes messages from Amazon SQS to process asynchronous notification tasks and engagement messages.")
    Component(notification_dispatcher, "Notification Dispatcher", "Node.js/Express, Java/Spring Boot, Python/FastAPI, AWS ECS on Fargate", "Sends emails and notifications using the Email/Notification Service (Amazon SES).")
}

Rel(notification_consumer, notification_dispatcher, "Triggers message dispatch", "")

@enduml