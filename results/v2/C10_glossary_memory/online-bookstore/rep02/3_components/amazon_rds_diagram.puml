@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_rds, "Amazon RDS") {
    Component(Amazon_RDS_Proxy, "Amazon RDS Proxy", "Amazon RDS Proxy", "Manages and pools database connections to prevent exhaustion during traffic spikes.")
    Component(Amazon_Aurora_PostgreSQL_Cluster, "Amazon Aurora PostgreSQL Cluster", "Amazon Aurora PostgreSQL, Multi-AZ", "Provides high-performance relational database storage with automated failover.")
}

Rel(Amazon_RDS_Proxy, Amazon_Aurora_PostgreSQL_Cluster, "PostgreSQL wire protocol over TLS 1.3 via internal VPC", "PostgreSQL wire protocol over TLS 1.3")

@enduml