@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(CustomerReviewer, "Customer / Reviewer", "End-users browsing catalogues, purchasing items, managing carts, and submitting 5-star ratings.")

System_Ext(PaymentGateway, "Payment Gateway", "External service processing secure multi-currency checkouts (USD, EUR, GBP).")
System_Ext(ShippingFulfillmentProvider, "Shipping / Fulfillment Provider", "External API handling physical book logistics.")
System_Ext(IdentityProvider, "Identity Provider", "AWS Cognito / Auth0 managing customer authentication and OIDC/OAuth 2.0 flows.")
System_Ext(NotificationService, "Notification Service", "AWS SES / SendGrid delivering order confirmations and review prompts.")

System_Boundary(OnlineBookstoreSystem, "Online Bookstore System") {
    Container(SinglePageAppMobileApp, "Single Page App / Mobile App", "React / React Native", "Client-side interface for customers to browse, search, purchase books, and manage reviews.")
    Container(APIGatewayBFFContainer, "API Gateway / BFF Container", "AWS API Gateway / Envoy", "Backend-for-frontend and entry point routing client requests to downstream microservices.")
    Container(CatalogSearchContainer, "Catalog & Search Container", "Node.js / Go", "Handles book catalog management and search functionalities.")
    Container(CheckoutOrderContainer, "Checkout & Order Container", "Java / Spring Boot", "Manages shopping cart, order placement, and integration with payment and fulfillment systems.")
    Container(NotificationReviewContainer, "Notification & Review Container", "Node.js / Express", "Handles customer reviews and triggers notifications asynchronously.")
    Container(AdminDashboardContainer, "Admin Dashboard Container", "React", "Internal dashboard for administrators to manage catalogue integrity, fulfillment, and compliance.")
    ContainerDb(DatabaseContainers, "Database Containers", "Amazon Aurora Global PostgreSQL", "Provides transactional data storage with cross-region replication.")
}

Rel(CustomerReviewer, SinglePageAppMobileApp, "Browses books, manages carts, and submits reviews", "HTTPS")
Rel(SinglePageAppMobileApp, APIGatewayBFFContainer, "Sends API requests", "HTTPS / REST")
Rel(APIGatewayBFFContainer, CatalogSearchContainer, "Queries and retrieves catalog and search data", "Internal mTLS / REST")
Rel(APIGatewayBFFContainer, CheckoutOrderContainer, "Processes checkouts and orders", "Internal mTLS / REST")
Rel(CheckoutOrderContainer, PaymentGateway, "Authorizes transactions", "HTTPS / REST, TLS 1.3, PCI-DSS")
Rel(CheckoutOrderContainer, ShippingFulfillmentProvider, "Dispatches fulfillment orders", "HTTPS / REST Webhooks")
Rel(CheckoutOrderContainer, NotificationReviewContainer, "Triggers asynchronous notification events", "Amazon SQS / SNS")
Rel(SinglePageAppMobileApp, IdentityProvider, "Authenticates and authorizes users", "JWT / JWKS via OpenID Connect")
Rel(NotificationReviewContainer, NotificationService, "Sends transactional emails and alerts", "SMTP / API")

@enduml