@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer_Reviewer, "Customer / Reviewer", "End-users browsing catalogues, purchasing items, managing carts, and submitting 5-star ratings.")
Person(Store_Administrator, "Store Administrator", "Internal personnel managing catalogue integrity, fulfillment, and GDPR/CCPA compliance.")
System(Online_Bookstore_System, "Online Bookstore System", "An Amazon-style e-commerce platform enabling users to browse, search, and purchase physical and electronic books with integrated reviews and recommendations.")
System_Ext(Payment_Gateway, "Payment Gateway", "External service processing secure multi-currency checkouts (USD, EUR, GBP).")
System_Ext(Shipping_Fulfillment_Provider, "Shipping / Fulfillment Provider", "External API handling physical book logistics.")
System_Ext(Identity_Provider, "Identity Provider", "AWS Cognito / Auth0 managing customer authentication and OIDC/OAuth 2.0 flows.")
System_Ext(Notification_Service, "Notification Service", "AWS SES / SendGrid delivering order confirmations and review prompts.")

Rel(Customer_Reviewer, Online_Bookstore_System, "Browses, searches, and checks out", "HTTPS (Web/Mobile)")
Rel(Customer_Reviewer, Identity_Provider, "Authenticates and authorizes", "HTTPS / OpenID Connect")
Rel(Online_Bookstore_System, Identity_Provider, "Validates tokens", "JWT / JWKS")
Rel(Online_Bookstore_System, Payment_Gateway, "Authorizes transactions", "HTTPS / REST (TLS 1.3, PCI-DSS)")
Rel(Online_Bookstore_System, Shipping_Fulfillment_Provider, "Dispatches fulfillment orders", "HTTPS / REST Webhooks")
Rel(Online_Bookstore_System, Notification_Service, "Triggers transactional emails", "SMTP / API")

@enduml