@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("database_containers", "Database Containers") {
    Component(DatabaseConnectionPooler, "Database Connection Pooler", "PgBouncer", "Connection pooling for high concurrency and connection management.")
    Component(CatalogDatabaseSchema, "Catalog Database Schema", "PostgreSQL Schema", "Database schema for catalog and search data.")
    Component(OrderCheckoutDatabaseSchema, "Order & Checkout Database Schema", "PostgreSQL Schema", "Database schema for orders and checkout data.")
    Component(ReviewNotificationDatabaseSchema, "Review & Notification Database Schema", "PostgreSQL Schema", "Database schema for reviews and notifications data.")
}

Rel(DatabaseConnectionPooler, CatalogDatabaseSchema, "TCP / PostgreSQL wire protocol", "TCP")
Rel(DatabaseConnectionPooler, OrderCheckoutDatabaseSchema, "TCP / PostgreSQL wire protocol", "TCP")
Rel(DatabaseConnectionPooler, ReviewNotificationDatabaseSchema, "TCP / PostgreSQL wire protocol", "TCP")

@enduml