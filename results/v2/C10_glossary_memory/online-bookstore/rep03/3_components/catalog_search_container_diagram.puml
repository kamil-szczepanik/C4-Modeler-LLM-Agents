@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(catalog_search_container, "Catalog & Search Container") {
    Component(Search_API_Controller, "Search API Controller", "Go / Fiber", "Handles search requests and queries.")
    Component(Query_Parser_Facet_Engine, "Query Parser & Facet Engine", "Go", "Parses queries and manages facets.")
    Component(Catalog_Management_Service, "Catalog Management Service", "Go", "Manages catalog data.")
    Component(Search_Indexer_Client, "Search Indexer Client", "Go", "Interacts with search indexes.")
    Component(Pricing_Currency_Resolver, "Pricing & Currency Resolver", "Go", "Resolves prices and currencies.")
    Component(Audit_Logging_Middleware, "Audit Logging Middleware", "Go", "Performs audit logging.")
}

System_Ext(Amazon_OpenSearch_Service, "Amazon OpenSearch Service", "Managed full-text search and faceted filtering.")
System_Ext(Database_Containers, "Database Containers", "Amazon Aurora Global PostgreSQL")
System_Ext(Amazon_S3, "Amazon S3", "Object storage for audit logs.")

Rel(Search_API_Controller, Amazon_OpenSearch_Service, "HTTPS / REST, TLS 1.3")
Rel(Catalog_Management_Service, Database_Containers, "Internal mTLS / PostgreSQL Protocol")
Rel(Audit_Logging_Middleware, Amazon_S3, "HTTPS / AWS IAM")
@enduml