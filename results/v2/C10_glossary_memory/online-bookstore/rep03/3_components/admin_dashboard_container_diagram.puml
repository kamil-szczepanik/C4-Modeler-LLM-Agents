@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Store_Administrator, "Store Administrator", "Internal user managing catalogue integrity, fulfillment, and GDPR/CCPA compliance.")

System_Ext(Identity_Provider, "Identity Provider", "Manages OIDC/OAuth 2.0 authentication and JWT issuance.")
System_Ext(API_Gateway_BFF_Container, "API Gateway / BFF Container", "Secure routing layer for downstream microservices.")
System_Ext(AWS_S3_CloudFront, "AWS S3 + CloudFront", "Delivers fast global static hosting.")

Container_Boundary(Admin_Dashboard_Container, "Admin Dashboard Container") {
    Component(Catalog_Management_Component, "Catalog Management Component", "React", "UI views for bulk inventory updates and review moderation.")
    Component(Order_Fulfillment_Component, "Order Fulfillment Component", "React", "Dashboard views displaying shipping exceptions and order statuses.")
    Component(Compliance_Audit_Component, "Compliance & Audit Component", "React", "Interface handling GDPR/CCPA data export and deletion workflows.")
    Component(Admin_State_Management_Telemetry_Component, "Admin State Management & Telemetry Component", "React Context / Redux Toolkit", "Manages token expiration, idle timeouts, and error boundaries.")
}

Rel(Store_Administrator, Admin_Dashboard_Container, "HTTPS")
Rel(Admin_Dashboard_Container, Identity_Provider, "HTTPS / OpenID Connect", "JWT / JWKS")
Rel(Admin_Dashboard_Container, API_Gateway_BFF_Container, "Internal mTLS / REST", "JWT claims")
Rel(Admin_Dashboard_Container, AWS_S3_CloudFront, "HTTPS", "CloudFront Functions / AWS WAF")

@enduml