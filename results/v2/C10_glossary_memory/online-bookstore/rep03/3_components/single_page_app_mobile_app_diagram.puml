@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Single Page App / Mobile App container

System_Ext(api_gateway, "API Gateway / BFF Container", "AWS API Gateway / Envoy", "Backend-for-frontend routing and service integration.")
System_Ext(identity_provider, "Identity Provider", "AWS Cognito / Auth0", "OIDC/OAuth 2.0 authentication and TLS 1.3 transport security.")

Container_Boundary(spa_mobile_app, "Single Page App / Mobile App") {
    Component(router_navigation_component, "Router & Navigation Component", "React Router / React Navigation", "Manages client-side routing, deep linking, and screen navigation across web and mobile platforms.")
    Component(state_management_component, "State Management Component", "Redux Toolkit", "Handles client-side state for user sessions, shopping cart, localization, and cached catalog data.")
    Component(catalog_search_view_component, "Catalog & Search View Component", "React / React Native", "Provides user interfaces for browsing books, executing search queries, and displaying product details.")
    Component(checkout_cart_view_component, "Checkout & Cart View Component", "React / React Native", "Manages shopping cart interactions, order placement forms, and multi-currency checkout flows.")
    Component(review_rating_component, "Review & Rating Component", "React / React Native", "Allows customers to submit 5-star ratings and read integrated book reviews.")
}

Rel(router_navigation_component, catalog_search_view_component, "Navigates to", "")
Rel(router_navigation_component, checkout_cart_view_component, "Navigates to", "")
Rel(router_navigation_component, review_rating_component, "Navigates to", "")
Rel(catalog_search_view_component, state_management_component, "Reads and updates catalog state", "")
Rel(checkout_cart_view_component, state_management_component, "Reads and updates cart state", "")
Rel(review_rating_component, state_management_component, "Updates review state", "")
Rel(catalog_search_view_component, api_gateway, "Fetches catalog and search data", "HTTPS / REST")
Rel(checkout_cart_view_component, api_gateway, "Submits orders and manages cart", "HTTPS / REST")
Rel(review_rating_component, api_gateway, "Submits and fetches reviews", "HTTPS / REST")
Rel(router_navigation_component, identity_provider, "Authenticates users", "JWT / JWKS via OpenID Connect")

@enduml