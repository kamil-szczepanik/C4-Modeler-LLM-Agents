@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Checkout & Order Container container

System_Ext(api_gateway, "API Gateway / BFF Container", "AWS API Gateway / Envoy", "Backend-for-frontend and entry point routing client requests to downstream microservices.")

Container_Boundary(checkout_order_container, "Checkout & Order Container") {
    Component(cart_component, "Cart Component", "Spring Data Redis / Amazon Aurora PostgreSQL", "Manages active cart state and persistence.")
    Component(order_orchestrator_component, "Order Orchestrator Component", "Spring State Machine / Saga", "Orchestrates distributed transactions and order workflows.")
    Component(payment_integration_component, "Payment Integration Component", "Spring Cloud OpenFeign", "Handles integration with external payment gateways.")
    Component(fulfillment_integration_component, "Fulfillment Integration Component", "Spring Cloud OpenFeign", "Handles integration with shipping and fulfillment providers.")
}

System_Db(database_containers, "Database Containers", "Amazon Aurora Global PostgreSQL", "Provides multi-region relational data durability and cross-region replication.")
System_Ext(payment_gateway, "Payment Gateway", "External secure payment processor", "External service processing secure multi-currency checkouts.")
System_Ext(shipping_fulfillment_provider, "Shipping / Fulfillment Provider", "External logistics API", "External API handling physical book logistics.")

Rel(api_gateway, order_orchestrator_component, "Internal mTLS / REST", "HTTPS/mTLS")
Rel(order_orchestrator_component, cart_component, "JDBC / Lettuce Redis Client", "TCP")
Rel(order_orchestrator_component, payment_integration_component, "Internal Method Call", "In-Process")
Rel(order_orchestrator_component, fulfillment_integration_component, "Internal Method Call", "In-Process")
Rel(payment_integration_component, payment_gateway, "HTTPS / REST, TLS 1.3, PCI-DSS", "HTTPS")
Rel(fulfillment_integration_component, shipping_fulfillment_provider, "HTTPS / REST Webhooks", "HTTPS")

@enduml