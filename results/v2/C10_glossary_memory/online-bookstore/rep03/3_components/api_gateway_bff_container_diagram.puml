@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway / BFF Container container

Container_Boundary(api_gateway_bff_container, "API Gateway / BFF Container") {
    Component(Routing_Edge_Proxy_Component, "Routing & Edge Proxy Component", "AWS API Gateway / Envoy", "Manages edge routing, TLS 1.3 termination, and zero-latency policy enforcement.")
    Component(Customer_BFF_Router_Component, "Customer BFF Router Component", "Node.js / Express", "BFF router optimized for customer mobile and web interactions.")
    Component(Admin_BFF_Router_Component, "Admin BFF Router Component", "Node.js / Express", "BFF router handling administrative dashboard requests.")
    Component(Security_Policy_Enforcement_Component, "Security & Policy Enforcement Component", "Envoy Lua / WAF Plugin", "Enforces security policies, authentication checks, and threat mitigation at the edge.")
}

Rel(Routing_Edge_Proxy_Component, Security_Policy_Enforcement_Component, "Internal gRPC")
Rel(Security_Policy_Enforcement_Component, Customer_BFF_Router_Component, "Internal HTTP/2")

@enduml