@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(NotificationService, "Notification Service", "AWS SES / SendGrid", "Delivers emails via SMTP / API")

Container_Boundary(NotificationAndReviewContainer, "Notification & Review Container") {
    Component(ReviewController, "Review Controller", "Express.js Router", "Handles HTTP requests for submitting and fetching customer book reviews.")
    Component(NotificationEventConsumer, "Notification Event Consumer", "Node.js SQS Consumer", "Consumes asynchronous notification events from Amazon SQS.")
    Component(ReviewService, "Review Service", "Node.js Business Logic", "Processes review validation, moderation rules, and database persistence.")
    Component(NotificationDispatcher, "Notification Dispatcher", "Node.js / Express Client", "Formats and sends emails via the external Notification Service.")
}

Rel(ReviewController, ReviewService, "Delegates review creation and retrieval requests")
Rel(NotificationEventConsumer, NotificationDispatcher, "Triggers notification dispatch upon receiving SQS messages")
Rel(NotificationDispatcher, NotificationService, "Delivers emails via SMTP / API", "SMTP / API")

@enduml