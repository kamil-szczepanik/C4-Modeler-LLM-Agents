@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patient, "Patient", "Patients interacting with the clinic management system for scheduling and records.")
Person(Clinician, "Clinician", "Doctors and Nurses managing electronic medical records and patient care.")
Person(Billing_Admin_Staff, "Billing/Admin Staff", "Staff managing billing, admissions, and administrative tasks.")
Person(Compliance_Officer, "Compliance Officer", "Officer responsible for ensuring HIPAA and GDPR compliance.")

System(Clinic_Management_System, "Clinic Management System", "A hybrid cloud platform designed to manage patient admissions, electronic medical records, scheduling, and billing for medium-sized hospitals and clinics, ensuring HIPAA and GDPR compliance.")

System_Ext(Lab___Imaging_Systems, "Lab & Imaging Systems", "External systems providing laboratory and imaging data.")
System_Ext(Insurance_Clearinghouse___External_Billing_Provider, "Insurance Clearinghouse / External Billing Provider", "External system for insurance claims and billing processing.")

Rel(Patient, Clinic_Management_System, "Manages admissions, appointments, and records", "HTTPS (TLS 1.3, OAuth2/OIDC, MFA)")
Rel(Clinician, Clinic_Management_System, "Accesses and updates electronic medical records and schedules", "HTTPS (TLS 1.3, OAuth2/OIDC, MFA)")
Rel(Billing_Admin_Staff, Clinic_Management_System, "Manages billing and administrative workflows", "HTTPS (TLS 1.3, OAuth2/OIDC, MFA)")
Rel(Compliance_Officer, Clinic_Management_System, "Monitors and audits system compliance and access logs", "HTTPS (TLS 1.3, OAuth2/OIDC, MFA)")
Rel(Clinic_Management_System, Lab___Imaging_Systems, "Exchanges clinical data and imaging results", "HL7 FHIR over REST/JSON (TLS 1.3)")
Rel(Clinic_Management_System, Insurance_Clearinghouse___External_Billing_Provider, "Submits billing and insurance claims", "HTTPS / EDI X12")
@enduml