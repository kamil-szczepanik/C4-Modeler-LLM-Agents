@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Service Container container

System_Ext(Lab_Imaging_Systems, "Lab & Imaging Systems", "External HL7 FHIR Endpoint", "External systems providing laboratory and imaging data.")
System_Ext(Core_Services_Container, "Core Services Container", "Java / Spring Boot", "Robust domain logic for core clinical services and electronic medical records.")
System_Ext(RabbitMQ, "RabbitMQ", "RabbitMQ", "Asynchronous messaging broker for asynchronous data flows.")
System_Ext(Prometheus_OpenTelemetry, "Prometheus / OpenTelemetry", "Prometheus / OpenTelemetry", "Monitoring and telemetry collection system.")

Container_Boundary(Integration_Service_Container, "Integration Service Container") {
    Component(Integration_Service_Container_Comp, "Integration Service Container", "Apache Camel / Spring Integration", "Hybrid cloud platform container designed to manage patient admissions, electronic medical records, scheduling, and billing.")
    Component(FHIR_Translator_Route, "FHIR Translator Route", "Apache Camel / Spring Integration", "Handles translation of integration routes to HL7 FHIR standards.")
    Component(Retry_Dead_Letter_Handler, "Retry & Dead-Letter Handler", "RabbitMQ / Apache Camel", "Manages message redelivery policies and dead-letter queuing for resilient communication.")
    Component(Connection_Monitor, "Connection Monitor", "Spring Boot / Resilience4j", "Monitors connectivity status to external endpoints and systems.")
    Component(Outbound_HTTP_Gateway, "Outbound HTTP Gateway", "Spring Integration HTTP", "Sends outbound HL7 FHIR requests over REST/JSON using TLS 1.3.")
    Component(Circuit_Breaker_Component, "Circuit Breaker Component", "Resilience4j", "Provides fault tolerance and circuit breaking for outbound and inbound calls.")
    Component(Observability_Probe, "Observability Probe", "Prometheus / OpenTelemetry", "Exposes operational metrics, latency tracking, and distributed tracing.")
    Component(Inbound_Polling_Adapter, "Inbound Polling Adapter", "Apache Camel Polling Consumer", "Polls incoming endpoints and messages for downstream processing.")
    Component(Message_Validation_Component, "Message Validation Component", "Spring Integration Validator", "Validates payload structures and ensures payload sanitization and PHI masking.")
    Component(Ingress_Rate_Limiter, "Ingress Rate Limiter", "Bucket4j", "Controls ingress traffic rates and protects against excessive loads.")
}

Rel(Integration_Service_Container_Comp, Lab_Imaging_Systems, "HL7 FHIR over REST/JSON (TLS 1.3 / mTLS)")
Rel(Lab_Imaging_Systems, Integration_Service_Container_Comp, "HL7 FHIR over REST/JSON (mTLS)")
Rel(FHIR_Translator_Route, Outbound_HTTP_Gateway, "In-memory / Direct VM")
Rel(Outbound_HTTP_Gateway, Lab_Imaging_Systems, "HL7 FHIR over REST/JSON (TLS 1.3)")
Rel(Integration_Service_Container_Comp, Prometheus_OpenTelemetry, "OpenMetrics (HTTP)")
Rel(Inbound_Polling_Adapter, Message_Validation_Component, "In-memory / Direct VM")
Rel(Message_Validation_Component, Core_Services_Container, "gRPC over mTLS")
Rel(Integration_Service_Container_Comp, RabbitMQ, "AMQP")

@enduml