@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Core Services Container", "Core Services Container") {
    Component("Clinical Domain Controller", "Clinical Domain Controller", "Spring MVC / REST", "Exposes REST endpoints for electronic medical records, patient admissions, and scheduling.")
    Component("EMR Clinical Service", "EMR Clinical Service", "Java / Spring Boot", "Encapsulates robust clinical domain logic and meets the <1s P95 EMR performance requirement.")
    Component("Persistence Repository", "Persistence Repository", "Spring Data JPA / JDBC", "Manages database operations and connects to the PostgreSQL data store securely.")
}

Rel("Clinical Domain Controller", "EMR Clinical Service", "Delegates business requests to")
Rel("EMR Clinical Service", "Persistence Repository", "Executes queries via")
@enduml