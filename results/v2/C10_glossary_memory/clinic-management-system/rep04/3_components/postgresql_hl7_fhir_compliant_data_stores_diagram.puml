@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Core_Services_Container, "Core Services Container", "Java/Spring Boot", "Robust domain logic for core clinical services and electronic medical records.")
System_Ext(Audit_Compliance_Logging_Container, "Audit & Compliance Logging Container", "WORM-compliant storage / Spring Integration", "Ensures comprehensive service mesh security and regulatory compliance logging.")

Container_Boundary(postgres_container, "PostgreSQL & HL7 FHIR Compliant Data Stores") {
    Component(Relational_Core_Component, "Relational Core Component", "PostgreSQL 15+ with AES-256 at rest", "Relational persistence partitioned for 10-year retention.")
    Component(FHIR_JSON_Document_Store_Component, "FHIR JSON Document Store Component", "PostgreSQL JSONB with GIN indexing", "HL7 FHIR compliant JSON document storage and querying.")
}

Rel(Core_Services_Container, Relational_Core_Component, "JDBC over mTLS", "JDBC over mTLS")
Rel(Core_Services_Container, FHIR_JSON_Document_Store_Component, "gRPC over mTLS / JSONB queries over mTLS", "gRPC over mTLS / JSONB queries over mTLS")
Rel(postgres_container, Audit_Compliance_Logging_Container, "pgaudit streaming logs", "pgaudit streaming logs")

@enduml