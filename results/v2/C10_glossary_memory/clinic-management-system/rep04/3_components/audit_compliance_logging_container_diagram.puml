@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Compliance Officer, "Compliance Officer", "Officer responsible for ensuring HIPAA and GDPR compliance.")
Container(Message Broker, "Message Broker", "RabbitMQ/Kafka", "Asynchronous messaging for resilient insurance claim submissions and decoupled communication.")

Container_Boundary(Audit_Compliance_Logging_Container, "Audit & Compliance Logging Container") {
    Component(Audit Collector Component, "Audit Collector Component", "Spring Integration", "Collects security event logging and messages.")
    Component(Compliance Query Service Component, "Compliance Query Service Component", "Spring MVC", "Provides secure REST query endpoints for compliance reporting.")
    Component(Audit Indexing & Tokenization Service Component, "Audit Indexing & Tokenization Service Component", "", "Indexes logs and tokenizes PHI for data minimization.")
    Component(WORM Storage Adapter Component, "WORM Storage Adapter Component", "AWS S3 Compliance Mode / Object Lock", "Enforces tamper-proof, >= 10-year data retention compliance.")
}

Rel(Compliance Officer, Compliance Query Service Component, "HTTPS (TLS 1.3, OAuth2/OIDC, MFA)", "")
Rel(Message Broker, Audit Collector Component, "AMQP", "")
Rel(Audit Collector Component, Audit Indexing & Tokenization Service Component, "gRPC over mTLS", "")
Rel(Audit Indexing & Tokenization Service Component, WORM Storage Adapter Component, "S3 API / TLS 1.3 (AES-256 at rest)", "")

@enduml