@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Clinician_Admin_Workspace_SPA", "Clinician/Admin Workspace SPA") {
    Component(Clinician_Workspace_Router, "Clinician Workspace Router", "React Router / TypeScript", "Manages navigation and route-based access control for clinician and administrator views.")
    Component(EMR_Patient_Management_Module, "EMR & Patient Management Module", "React Components / TypeScript", "Provides user interface components for viewing and updating electronic medical records and patient admissions.")
    Component(Scheduling_Billing_Dashboard, "Scheduling & Billing Dashboard", "React Components / TypeScript", "Provides interfaces for managing clinic scheduling, administrative tasks, and billing views.")
    Component(API_Client_Service, "API Client Service", "Axios / TypeScript", "Handles secure HTTP communication with the API Gateway / BFF.")
}

Rel(Clinician_Workspace_Router, EMR_Patient_Management_Module, "Renders views for")
Rel(Clinician_Workspace_Router, Scheduling_Billing_Dashboard, "Renders views for")
Rel(EMR_Patient_Management_Module, API_Client_Service, "Fetches and sends clinical data via")
Rel(Scheduling_Billing_Dashboard, API_Client_Service, "Fetches and sends administrative data via")

@enduml