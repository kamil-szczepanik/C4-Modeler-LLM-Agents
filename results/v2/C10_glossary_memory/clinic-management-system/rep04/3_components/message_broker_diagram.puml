@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("message_broker", "Message Broker") {
    Component("Ingestion & Authentication Gateway", "Ingestion & Authentication Gateway", "Apache Kafka / KRaft", "Handles incoming connections, mTLS verification, and client authentication for producers and consumers.")
    Component("Distributed Commit Log Engine", "Distributed Commit Log Engine", "Apache Kafka Log Storage", "Persists messages sequentially with AES-256 encryption at rest, ensuring high throughput and durability.")
    Component("Offset & Consumer Group Coordinator", "Offset & Consumer Group Coordinator", "Kafka Consumer Coordinator", "Manages consumer group rebalancing, offset tracking, and reliable asynchronous message delivery across services.")
}

Rel("Ingestion & Authentication Gateway", "Distributed Commit Log Engine", "Routes authenticated messages to", "")
Rel("Distributed Commit Log Engine", "Offset & Consumer Group Coordinator", "Coordinates consumption streams with", "")
@enduml