@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(billing_service_container, "Billing Service Container") {
    Component(Billing Controller, "Billing Controller", "Express.js / TypeScript", "Exposes REST and gRPC endpoints for financial processing and billing operations.")
    Component(Billing Processor Service, "Billing Processor Service", "Node.js / TypeScript", "Executes isolated financial logic, transaction handling, and insurance claim formatting.")
    Component(Insurance Integration Client, "Insurance Integration Client", "HTTPS / EDI X12 Client", "Manages secure communication with external insurance clearinghouses and billing providers.")
}

Rel(Billing Controller, Billing Processor Service, "Delegates financial processing requests")
Rel(Billing Processor Service, Insurance Integration Client, "Initiates external claim submissions")
@enduml