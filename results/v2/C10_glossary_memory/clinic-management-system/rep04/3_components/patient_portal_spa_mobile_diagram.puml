@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("patient_portal", "Patient Portal SPA/Mobile") {
    Component(patient_ui_router_views, "Patient UI Router & Views", "React/TypeScript", "Manages client-side routing and renders responsive views for patient scheduling and medical records.")
    Component(patient_api_client, "Patient API Client", "Axios / Fetch API (HTTPS)", "Handles secure communication with the API Gateway using OAuth2/OIDC tokens.")
}

Rel(patient_ui_router_views, patient_api_client, "Invokes backend services via", "")

@enduml