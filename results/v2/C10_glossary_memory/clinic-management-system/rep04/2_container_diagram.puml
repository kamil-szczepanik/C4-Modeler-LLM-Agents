@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Patient, "Patient", "Patients interacting with the clinic management system for scheduling and records.")
Person(Clinician, "Clinician", "Doctors and Nurses managing electronic medical records and patient care.")
Person(BillingStaff, "Billing/Admin Staff", "Staff managing billing, admissions, and administrative tasks.")
Person(ComplianceOfficer, "Compliance Officer", "Officer responsible for ensuring HIPAA and GDPR compliance.")

System_Ext(LabImagingSystems, "Lab & Imaging Systems", "External systems providing laboratory and imaging data.")
System_Ext(InsuranceClearinghouse, "Insurance Clearinghouse / External Billing Provider", "External system for insurance claims and billing processing.")

System_Boundary(ClinicManagementSystem, "Clinic Management System") {
    Container(PatientPortal, "Patient Portal SPA/Mobile", "React/TypeScript", "High-performance frontend user interface for patients.")
    Container(ClinicianAdminWorkspace, "Clinician/Admin Workspace SPA", "React/TypeScript", "High-performance frontend user interface for clinicians and administrative staff.")
    Container(ApiGateway, "API Gateway / BFF", "Envoy/Kong", "API gateway for reverse proxy, routing, and token exchange.")
    Container(CoreServices, "Core Services Container", "Java/Spring Boot", "Robust domain logic for core clinical services and electronic medical records.")
    Container(BillingService, "Billing Service Container", "Node.js/TypeScript", "Isolated financial and billing processing.")
    Container(IntegrationService, "Integration Service Container", "Apache Camel / Spring Integration", "HL7 FHIR translation adapters for interoperability with external lab and imaging systems.")
    Container(AuditService, "Audit & Compliance Logging Container", "WORM-compliant storage / Spring Integration", "Ensures comprehensive service mesh security and regulatory compliance logging.")
    ContainerDb(Database, "PostgreSQL & HL7 FHIR Compliant Data Stores", "PostgreSQL with AES-256 at rest", "Relational persistence with AES-256 encryption at rest.")
    Container(MessageBroker, "Message Broker", "RabbitMQ/Kafka", "Asynchronous messaging for resilient insurance claim submissions and decoupled communication.")
}

Rel(Patient, ApiGateway, "Interacts with portal for scheduling and records", "HTTPS (TLS 1.3, OAuth2/OIDC, MFA)")
Rel(Clinician, ApiGateway, "Accesses workspace for patient care and EMR", "HTTPS (TLS 1.3, OAuth2/OIDC, MFA)")
Rel(BillingStaff, ApiGateway, "Manages billing and administrative tasks", "HTTPS (TLS 1.3, OAuth2/OIDC, MFA)")
Rel(ComplianceOfficer, ApiGateway, "Monitors and audits system compliance", "HTTPS (TLS 1.3, OAuth2/OIDC, MFA)")

Rel(ApiGateway, PatientPortal, "Routes requests to", "HTTPS")
Rel(ApiGateway, ClinicianAdminWorkspace, "Routes requests to", "HTTPS")
Rel(ApiGateway, CoreServices, "Forwards core clinical requests", "gRPC over mTLS")
Rel(ApiGateway, BillingService, "Forwards billing requests", "gRPC over mTLS")

Rel(CoreServices, Database, "Persists and retrieves clinical data", "JDBC (AES-256 at rest)")
Rel(BillingService, MessageBroker, "Sends asynchronous insurance claim submissions", "AMQP")
Rel(IntegrationService, LabImagingSystems, "Exchanges clinical and imaging data", "HL7 FHIR over REST/JSON (TLS 1.3)")
Rel(BillingService, InsuranceClearinghouse, "Submits insurance claims", "HTTPS / EDI X12")

@enduml