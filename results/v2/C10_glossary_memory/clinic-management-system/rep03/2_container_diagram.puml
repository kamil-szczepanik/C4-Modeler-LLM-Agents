@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Patient, "Patient", "End-user interacting with the patient portals for scheduling and access.")
Person(Receptionist, "Receptionist / Front Desk", "Administrative user managing patient admissions and front desk scheduling.")
Person(Clinician, "Clinician / Doctor", "Medical professional managing electronic medical records and clinical workflows.")
Person(BillingSpecialist, "Billing Specialist", "Financial user handling billing and payment processing.")
Person(Admin, "Hospital Administrator", "System supervisor managing oversight, configuration, and compliance.")

System_Ext(PaymentGateway, "Payment Gateway", "External system processing payments via REST APIs.")
System_Ext(ExternalLab, "External Lab & Imaging Systems", "External clinical systems integrating via HL7 FHIR APIs.")
System_Ext(IdP, "Identity Provider (IdP)", "Centralized authentication system using OpenID Connect (OIDC) / OAuth2.")

System_Boundary(CMS, "Clinic Management System") {
    Container(APIGateway, "API Gateway / Reverse Proxy", "Envoy / NGINX", "Handles TLS 1.3 termination, WAF, and traffic routing.")
    Container(PatientPortal, "Patient Portal App", "React SPA / Node.js / CDN", "Provides front-end application access for patients.")
    Container(ClinicalCore, "Clinical Core Service", "Java / Spring Boot", "Manages EMR data, scheduling resource checks, and audit trails.")
    Container(BillingService, "Billing & Integration Service", "Go / Temporal.io", "Handles insurance claims and resilient payment retries.")
    Container(AdminService, "Administrative & Analytics Service", "Python / FastAPI + Celery", "Isolates compliance and reporting queries.")
    Container(NotificationService, "Notification & Messaging Service", "Node.js / Python", "Manages asynchronous patient alerts via SMS/Email APIs.")
    Container(FHIRAdapter, "FHIR Integration Adapter", "Dedicated Integration Service", "Decouples external clinical systems.")
    ContainerDb(ClinicalDB, "Clinical Core Database", "Encrypted SQL", "Stores EMR and core clinical data, providing read-only replicas.")
}

Rel(Patient, APIGateway, "Sends HTTPS requests via WAF", "HTTPS (TLS 1.3) via WAF with risk-based adaptive MFA")
Rel(Receptionist, APIGateway, "Sends HTTPS requests via WAF", "HTTPS (TLS 1.3) via WAF with risk-based adaptive MFA")
Rel(Clinician, APIGateway, "Sends HTTPS requests via WAF", "HTTPS (TLS 1.3) via WAF with risk-based adaptive MFA")
Rel(BillingSpecialist, APIGateway, "Sends HTTPS requests via WAF", "HTTPS (TLS 1.3) via WAF with risk-based adaptive MFA")
Rel(Admin, APIGateway, "Sends HTTPS requests via WAF", "HTTPS (TLS 1.3) via WAF with risk-based adaptive MFA")

Rel(APIGateway, PatientPortal, "Routes static assets and SPA traffic", "HTTPS")
Rel(APIGateway, ClinicalCore, "Routes clinical API traffic", "HTTPS / mTLS")
Rel(APIGateway, BillingService, "Routes billing API traffic", "HTTPS / mTLS")
Rel(APIGateway, AdminService, "Routes analytics API traffic", "HTTPS / mTLS")

Rel(ClinicalCore, NotificationService, "Publishes asynchronous patient alerts", "AMQP / Kafka over mTLS")
Rel(BillingService, PaymentGateway, "Processes insurance claims and payments", "Payment REST APIs over encrypted HTTPS")
Rel(FHIRAdapter, ExternalLab, "Exchanges clinical and imaging data", "HL7 FHIR APIs over encrypted HTTPS")
Rel(AdminService, ClinicalDB, "Executes read-only analytical queries", "Read-only replicas via encrypted SQL over mTLS")
Rel(ClinicalCore, IdP, "Authenticates users and manages identity", "OpenID Connect (OIDC) / OAuth2 over HTTPS")

@enduml