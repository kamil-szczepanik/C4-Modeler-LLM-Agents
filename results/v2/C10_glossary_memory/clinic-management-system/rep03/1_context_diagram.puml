@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patient, "Patient", "End-user interacting with the patient portals for scheduling and access.")
Person(Receptionist, "Receptionist / Front Desk", "Administrative user managing patient admissions and front desk scheduling.")
Person(Clinician, "Clinician / Doctor", "Medical professional managing electronic medical records and clinical workflows.")
Person(Billing, "Billing Specialist", "Financial user handling billing and payment processing.")
Person(Administrator, "Hospital Administrator", "System supervisor managing oversight, configuration, and compliance.")

System(ClinicManagementSystem, "Clinic Management System", "A hybrid clinical IT platform that manages patient admissions, electronic medical records, scheduling, and billing for medium-sized hospitals and clinics, delivering highly available, secure healthcare operations while maintaining strict regulatory compliance.")

System_Ext(PaymentGateway, "Payment Gateway", "External system processing payments via REST APIs.")
System_Ext(ExternalLab, "External Lab & Imaging Systems", "External clinical systems integrating via HL7 FHIR APIs.")
System_Ext(IdP, "Identity Provider (IdP)", "Centralized authentication system using OpenID Connect (OIDC) / OAuth2.")

Rel(Patient, ClinicManagementSystem, "Interacts via portal for admissions and scheduling", "HTTPS (TLS 1.3) via WAF with risk-based adaptive MFA")
Rel(Receptionist, ClinicManagementSystem, "Manages patient admissions and front desk workflows", "HTTPS (TLS 1.3) via WAF with risk-based adaptive MFA")
Rel(Clinician, ClinicManagementSystem, "Accesses and updates electronic medical records", "HTTPS (TLS 1.3) via WAF with risk-based adaptive MFA")
Rel(Billing, ClinicManagementSystem, "Processes financial transactions and billing", "HTTPS (TLS 1.3) via WAF with risk-based adaptive MFA")
Rel(Administrator, ClinicManagementSystem, "Configures and administers system operations", "HTTPS (TLS 1.3) via WAF with risk-based adaptive MFA")

Rel(ClinicManagementSystem, IdP, "Authenticates users and manages identity", "OpenID Connect (OIDC) / OAuth2 over HTTPS")
Rel(ClinicManagementSystem, ExternalLab, "Exchanges clinical and imaging data", "HL7 FHIR APIs over encrypted HTTPS")
Rel(ClinicManagementSystem, PaymentGateway, "Processes financial transactions", "Payment REST APIs over encrypted HTTPS")

@enduml