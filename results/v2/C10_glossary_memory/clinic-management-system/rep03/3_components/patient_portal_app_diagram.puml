@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient Portal App container

Container_Boundary(patient_portal_app, "Patient Portal App") {
    Component(PatientPortalFrontend, "Patient Portal Frontend", "React SPA / CDN", "Provides front-end application access for patients.")
    Component(PatientPortalBackend, "Patient Portal Backend", "Node.js", "Manages server-side rendering and secure session handling for the patient portal.")
}

Rel(PatientPortalFrontend, PatientPortalBackend, "Communicates via HTTPS for session handling and API calls.", "HTTPS")

@enduml