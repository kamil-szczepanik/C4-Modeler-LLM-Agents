@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the FHIR Integration Adapter container

System_Ext(ClinicalCoreService, "Clinical Core Service", "Central backend service handling core EMR and domain logic.")
System_Ext(ExternalLabAndImagingSystems, "External Lab & Imaging Systems", "External medical systems exchanging clinical data.")
System_Ext(IdentityPoviderIdP, "Identity Provider (IdP)", "External authentication and token service.")

Container_Boundary(FHIRIntegrationAdapter, "FHIR Integration Adapter") {
    Component(FHIRAPIEndpointController, "FHIR API Endpoint Controller", "Java / Spring Boot + Spring Security", "Handles secure REST endpoints, mTLS, and OAuth2.")
    Component(ResourceMapperValidator, "Resource Mapper & Validator", "Java / HAPI FHIR", "Translates payloads and enforces PHI filtering.")
    Component(OutboundSyncWorker, "Outbound Sync Worker", "Go / Temporal.io", "Manages resilient asynchronous retries.")
}

Rel(FHIRAPIEndpointController, ResourceMapperValidator, "In-memory method calls", "")
Rel(ResourceMapperValidator, ClinicalCoreService, "gRPC over mTLS", "gRPC / mTLS")
Rel(OutboundSyncWorker, ExternalLabAndImagingSystems, "HL7 FHIR APIs over encrypted HTTPS", "HTTPS / FHIR")
Rel(FHIRAPIEndpointController, IdentityPoviderIdP, "OAuth2 token introspection over HTTPS", "HTTPS")
@enduml