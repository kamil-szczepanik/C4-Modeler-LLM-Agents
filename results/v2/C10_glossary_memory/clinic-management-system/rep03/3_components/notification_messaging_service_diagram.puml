@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification & Messaging Service container

Container_Boundary(notification_service, "Notification & Messaging Service") {
    Component(Notification_Ingestion_Controller, "Notification Ingestion Controller", "Node.js / Express", "Receives notification requests and event messages from internal microservices via AMQP/Kafka.")
    Component(Messaging_Dispatcher, "Messaging Dispatcher", "Python / Celery", "Processes asynchronous notification tasks and interfaces with external SMS and email delivery APIs.")
}

Rel(Notification_Ingestion_Controller, Messaging_Dispatcher, "Queues and hands off messages for asynchronous dispatch.", "AMQP / Kafka")

@enduml