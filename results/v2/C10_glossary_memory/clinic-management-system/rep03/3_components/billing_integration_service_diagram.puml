@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing & Integration Service container

System_Ext(PaymentGateway, "Payment Gateway", "External payment gateway service.")
System_Ext(NotificationMessagingService, "Notification & Messaging Service", "External notification and messaging platform.")

Container_Boundary(BillingAndIntegrationService, "Billing & Integration Service") {
    Component(ClaimSubmissionHandler, "Claim Submission Handler", "Go", "Handles insurance claims processing and initiates payment workflows.")
    Component(PaymentWorkflowOrchestrator, "Payment Workflow Orchestrator", "Temporal.io", "Manages stateful, long-running financial retry workflows and sagas.")
    Component(GatewayIntegrationClient, "Gateway Integration Client", "Go", "Communicates securely with external payment gateways for transaction processing.")
    Component(FinancialLedgerAuditStore, "Financial Ledger & Audit Store", "Encrypted SQL", "Stores immutable transaction and audit logs securely.")
    Component(BillingNotificationTrigger, "Billing Notification Trigger", "Go", "Triggers asynchronous notifications following billing events.")
}

Rel(ClaimSubmissionHandler, PaymentWorkflowOrchestrator, "Internal Go Channel / gRPC", "Internal Go Channel / gRPC")
Rel(PaymentWorkflowOrchestrator, GatewayIntegrationClient, "Internal gRPC", "Internal gRPC")
Rel(GatewayIntegrationClient, PaymentGateway, "Payment REST APIs over encrypted HTTPS", "Payment REST APIs over encrypted HTTPS")
Rel(PaymentWorkflowOrchestrator, FinancialLedgerAuditStore, "Encrypted SQL over mTLS", "Encrypted SQL over mTLS")
Rel(PaymentWorkflowOrchestrator, BillingNotificationTrigger, "Internal Go Channel", "Internal Go Channel")
Rel(BillingNotificationTrigger, NotificationMessagingService, "AMQP / Kafka over mTLS", "AMQP / Kafka over mTLS")

@enduml