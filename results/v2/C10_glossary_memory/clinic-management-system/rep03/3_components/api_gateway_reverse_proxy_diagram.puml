@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component Diagram for the API Gateway / Reverse Proxy container

Container_Boundary(api_gateway_boundary, "API Gateway / Reverse Proxy") {
    Component(tls_termination_waf_module, "TLS Termination & WAF Module", "Envoy / NGINX", "Perimeter proxy featuring TLS Termination & WAF Module.")
    Component(authentication_claims_filter, "Authentication & Claims Filter", "Envoy / NGINX Filter", "Handles authentication and claims validation.")
    Component(dynamic_routing_rate_limiting_engine, "Dynamic Routing & Rate Limiting Engine", "Envoy / NGINX Engine", "Handles dynamic routing and tenant-aware rate limiting.")
    Component(resilience_fault_injection_module, "Resilience & Fault Injection Module", "Envoy / NGINX Module", "Ensures high availability and resilience.")
}

Rel(tls_termination_waf_module, authentication_claims_filter, "Passes decrypted requests with verified TLS", "")
Rel(authentication_claims_filter, dynamic_routing_rate_limiting_engine, "Forwards authenticated claims for routing", "")
Rel(dynamic_routing_rate_limiting_engine, resilience_fault_injection_module, "Applies resilience and routing rules", "")

@enduml