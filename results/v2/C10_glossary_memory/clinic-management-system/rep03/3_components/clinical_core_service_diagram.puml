@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container(api_gateway, "API Gateway / Reverse Proxy", "Envoy / NGINX", "Routes API traffic")
Container(notification_service, "Notification & Messaging Service", "Node.js / Python", "Publishes patient alerts")

Container_Boundary(clinical_core_service, "Clinical Core Service") {
    Component(emr_management_component, "EMR Management Component", "Java / Spring Data JPA", "Handles EMR CRUD operations and caching.")
    Component(audit_trail_interceptor, "Audit Trail Interceptor", "Spring AOP / JDBC", "Asynchronously logs medical record access.")
    Component(scheduling_engine, "Scheduling Engine", "Java / Quartz Scheduler", "Handles concurrency-safe resource clash checks and emergency overrides.")
    Component(distributed_cache_component, "Distributed Cache Component", "Redis Cluster", "Provides low-latency caching for patient data and EMR summaries.")
    Component(clinical_core_database, "Clinical Core Database", "Encrypted SQL", "Encrypted SQL database with read-only replicas storing core clinical data.")
}

Rel(api_gateway, clinical_core_service, "Routes API traffic", "HTTPS / mTLS")
Rel(emr_management_component, clinical_core_database, "Persists and retrieves medical records", "JDBC over mTLS")
Rel(scheduling_engine, clinical_core_database, "Evaluates appointment calendars and locks resources", "JDBC over mTLS")
Rel(emr_management_component, audit_trail_interceptor, "Triggers audit events", "In-process Spring ApplicationEvent")
Rel(emr_management_component, distributed_cache_component, "Caches and retrieves lightweight EMR summaries", "Redis Protocol over mTLS")
Rel(clinical_core_service, notification_service, "Publishes patient alerts", "AMQP / Kafka over mTLS")
@enduml