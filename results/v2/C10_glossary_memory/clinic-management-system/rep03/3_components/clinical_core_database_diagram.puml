@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Clinical Core Database container

Container_Boundary("Clinical Core Database", "Clinical Core Database") {
    Component("Primary_Write_Database", "Primary Write Database", "PostgreSQL multi-node synchronous replication cluster", "PostgreSQL multi-node synchronous replication cluster for primary write operations.")
    Component("Read_Only_Replica_Cluster", "Read-Only Replica Cluster", "Asynchronously replicated read-nodes", "Asynchronously replicated read-nodes for analytics and reporting queries.")
    Component("Audit_Log_Store", "Audit Log Store", "Append-only, tamper-evident storage subsystem with WORM compliance", "Append-only, tamper-evident storage subsystem with WORM compliance for secure audit trails.")
    Component("Database_Connection_Pooler", "Database Connection Pooler", "PgBouncer instances", "PgBouncer instances for connection management and high concurrent clinician traffic.")
}

Container(Clinical_Core_Service, "Clinical Core Service", "Java / Spring Boot", "Backend service")
Container(Administrative_Analytics_Service, "Administrative & Analytics Service", "Python / FastAPI + Celery", "Reporting service")

Rel(Database_Connection_Pooler, Primary_Write_Database, "PostgreSQL wire protocol over mTLS")
Rel(Clinical_Core_Service, Database_Connection_Pooler, "PostgreSQL wire protocol over mTLS")
Rel(Administrative_Analytics_Service, Read_Only_Replica_Cluster, "PostgreSQL wire protocol over mTLS")
Rel(Clinical_Core_Service, Audit_Log_Store, "Encrypted append-only stream over mTLS")

@enduml