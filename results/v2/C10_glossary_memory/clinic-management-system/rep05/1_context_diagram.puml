@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "Patients interacting with the healthcare system via the Patient Portal.")
Person(Receptionists, "Receptionists", "Staff managing patient admissions and scheduling.")
Person(Clinicians, "Clinicians", "Medical professionals managing Electronic Medical Records (EMRs).")
Person("Billing Specialists", "Billing Specialists", "Staff handling billing and insurance payments.")

System_Ext("Lab & Imaging Systems", "Lab & Imaging Systems", "External systems providing laboratory and imaging data.")
System_Ext("Insurance Payment Gateway", "Insurance Payment Gateway", "External gateway handling insurance payments.")
System_Ext("Identity Provider", "Identity Provider", "Provides authentication and identity services via OIDC/SAML 2.0.")
System_Ext("Patient Portal", "Patient Portal", "External portal for patient access.")
System_Ext("Notification Gateway", "Notification Gateway", "External gateway like Twilio/SendGrid for notifications.")
System_Ext("Hybrid API Gateway", "Hybrid API Gateway", "Gateway with WAF for hybrid cloud traffic management.")

System("Clinic Management System", "Clinic Management System", "Manages patient admissions, EMRs, scheduling, and billing for healthcare providers in a hybrid cloud environment, ensuring HIPAA and GDPR compliance.")

Rel("Patient Portal", "Clinic Management System", "Accesses core system features", "HTTPS/REST")
Rel("Lab & Imaging Systems", "Clinic Management System", "Transmits lab and imaging data", "HL7 FHIR over HTTPS")
Rel("Insurance Payment Gateway", "Clinic Management System", "Processes insurance transactions", "REST/SOAP with TLS 1.3")
Rel("Identity Provider", "Clinic Management System", "Authenticates users", "OIDC/SAML 2.0")

@enduml