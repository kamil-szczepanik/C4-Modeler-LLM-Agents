@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Patients, "Patients", "Patients interacting with the healthcare system via the Patient Portal.")
Person(Receptionists, "Receptionists", "Staff managing patient admissions and scheduling.")
Person(Clinicians, "Clinicians", "Medical professionals managing Electronic Medical Records (EMRs).")
Person(Billing_Specialists, "Billing Specialists", "Staff handling billing and insurance payments.")

System_Ext(Patient_Portal, "Patient Portal", "External portal for patient access.")
System_Ext(Lab___Imaging_Systems, "Lab & Imaging Systems", "External systems providing laboratory and imaging data.")
System_Ext(Insurance_Payment_Gateway, "Insurance Payment Gateway", "External gateway handling insurance payments.")
System_Ext(Identity_Provider, "Identity Provider", "Provides authentication and identity services via OIDC/SAML 2.0.")
System_Ext(Hybrid_API_Gateway, "Hybrid API Gateway", "Gateway with WAF for hybrid cloud traffic management.")

System_Boundary(Clinic_Management_System, "Clinic Management System") {
    Container(API_Gateway___BFF_Container, "API Gateway / BFF Container", "Kong / Envoy", "Handles ingress routing and TLS termination.")
    Container(EMR_Service_Container, "EMR Service Container", "Java / Spring Boot", "Resilient clinical record management.")
    Container(Scheduling_Service_Container, "Scheduling Service Container", "Node.js / TypeScript", "Manages resource clash logic.")
    Container(Billing_Service_Container, "Billing Service Container", "Go", "High-performance claim processing.")
    Container(Integration_Service_Container, "Integration Service Container", "Apache Camel / FHIR Server", "Handles HL7 interoperability.")
    ContainerDb(Clinical_Database, "Clinical Database", "PostgreSQL", "Distributed clinical database with AES-256 at rest and field-level encryption.")
    Container(Audit___Observability_Sidecar, "Audit & Observability Sidecar", "FluentBit / Prometheus", "Provides metrics and tamper-evident logs.")
}

Rel(Patient_Portal, API_Gateway___BFF_Container, "Accesses core system features via HTTPS/REST", "HTTPS/REST")
Rel(Lab___Imaging_Systems, Integration_Service_Container, "Transmits lab and imaging data", "HL7 FHIR over HTTPS")
Rel(Insurance_Payment_Gateway, Billing_Service_Container, "Processes insurance transactions", "TLS 1.3")
Rel(Identity_Provider, API_Gateway___BFF_Container, "Authenticates users", "OIDC/SAML 2.0")
Rel(API_Gateway___BFF_Container, EMR_Service_Container, "Routes internal requests", "gRPC over mTLS")
Rel(API_Gateway___BFF_Container, Scheduling_Service_Container, "Routes internal requests", "gRPC over mTLS")
Rel(API_Gateway___BFF_Container, Billing_Service_Container, "Routes internal requests", "gRPC over mTLS")
Rel(API_Gateway___BFF_Container, Integration_Service_Container, "Routes internal requests", "gRPC over mTLS")
Rel(EMR_Service_Container, Clinical_Database, "Reads and writes clinical records", "TLS 1.3")

@enduml