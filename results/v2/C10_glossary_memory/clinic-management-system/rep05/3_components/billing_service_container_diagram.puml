@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Insurance_Payment_Gateway, "Insurance Payment Gateway", "External payment and insurance processing system.")
ContainerDb(Clinical_Database, "Clinical Database", "PostgreSQL", "Provides reliable, ACID-compliant relational storage for financial ledgers and audits.")

Container_Boundary(Billing_Service_Container, "Billing Service Container") {
    Component(Claim_Validation_Engine, "Claim Validation Engine", "Go", "Validates billing claims against rules and standards.")
    Component(Claim_Dispatcher, "Claim Dispatcher", "Go", "Sends asynchronous claim payloads with retry backoff to external gateways.")
    Component(Ledger_Invoice_Manager, "Ledger & Invoice Manager", "Go", "Manages financial transactions, ledgers, and invoice records.")
}

Rel(Claim_Dispatcher, Insurance_Payment_Gateway, "Sends asynchronous claim payloads with retry backoff", "HTTPS / REST with TLS 1.3")
Rel(Ledger_Invoice_Manager, Clinical_Database, "Persists financial transactions and audit records", "SQL over TLS 1.3")

@enduml