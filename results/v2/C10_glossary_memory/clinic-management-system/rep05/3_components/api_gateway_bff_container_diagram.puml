@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("api_gateway_bff_container", "API Gateway / BFF Container") {
    Component("Ingress_Router_Component", "Ingress Router Component", "Kong / Envoy", "Manages ingress routing, TLS 1.3 termination, and canary deployments.")
    Component("Authentication___Token_Relay_Component", "Authentication & Token Relay Component", "OIDC/SAML 2.0", "Handles identity verification and token relay for downstream services.")
    Component("Rate_Limiting___Throttling_Component", "Rate Limiting & Throttling Component", "Redis-backed", "Powers multi-region rate-limiting and request throttling for high availability.")
    Component("BFF_Aggregator_Component", "BFF Aggregator Component", "Node.js / GraphQL", "Shapes tailored payloads to guarantee EMR load times under 1 second.")
    Component("Localization___Formatting_Middleware", "Localization & Formatting Middleware", "Node.js Middleware", "Provides localization and formatting for client responses.")
    Component("Audit___Observability_Sidecar", "Audit & Observability Sidecar", "FluentBit / Prometheus", "Delivers distributed tracing and tamper-evident audit logs for HIPAA compliance.")
}

System_Ext("EMR_Service_Container", "EMR Service Container", "Java / Spring Boot")
System_Ext("Scheduling_Service_Container", "Scheduling Service Container", "Node.js / TypeScript")
System_Ext("Billing_Service_Container", "Billing Service Container", "Go")
System_Ext("Integration_Service_Container", "Integration Service Container", "Apache Camel / FHIR Server")

Rel("Ingress_Router_Component", "Authentication___Token_Relay_Component", "Routes incoming requests for authentication", "HTTPS")
Rel("Authentication___Token_Relay_Component", "Rate_Limiting___Throttling_Component", "Enforces rate limits and throttling", "Redis")
Rel("Rate_Limiting___Throttling_Component", "BFF_Aggregator_Component", "Passes validated requests", "Internal")
Rel("BFF_Aggregator_Component", "Localization___Formatting_Middleware", "Applies localization and formatting", "")
Rel("BFF_Aggregator_Component", "EMR_Service_Container", "", "gRPC over mTLS")
Rel("BFF_Aggregator_Component", "Scheduling_Service_Container", "", "gRPC over mTLS")
Rel("BFF_Aggregator_Component", "Billing_Service_Container", "", "gRPC over mTLS")
Rel("BFF_Aggregator_Component", "Integration_Service_Container", "", "gRPC over mTLS")
Rel("Ingress_Router_Component", "Audit___Observability_Sidecar", "", "Local IPC / FluentBit")

@enduml