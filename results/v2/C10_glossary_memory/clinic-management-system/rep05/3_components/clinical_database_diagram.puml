@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("ClinicalDatabase", "Clinical Database") {
    Component(ConnectionPooler, "Connection Pooler", "PgBouncer", "Manages high concurrency and connection pooling for database services.")
    Component(PostgreSQLPrimaryNode, "PostgreSQL Primary Node", "PostgreSQL 15", "Provides robust transactional storage, read replicas, and row-level security for data isolation.")
    Component(PostgreSQLReadReplicas, "PostgreSQL Read Replicas", "PostgreSQL 15", "Handles read queries for database services to maintain high availability and sub-second response times.")
    Component(DataArchivalWorker, "Data Archival Worker", "Background Worker / PostgreSQL", "Archives historical records off-peak to ensure sub-second EMR performance.")
    Component(PostgreSQLRLSEnforcer, "PostgreSQL RLS Enforcer", "PostgreSQL Row-Level Security", "Ensures data isolation and satisfies strict HIPAA/GDPR compliance.")
}

Rel(ConnectionPooler, PostgreSQLPrimaryNode, "Routes write transactions", "TCP over mTLS")
Rel(ConnectionPooler, PostgreSQLReadReplicas, "Routes read queries", "TCP over mTLS")
Rel(DataArchivalWorker, PostgreSQLPrimaryNode, "Archives historical records", "TCP over mTLS")
Rel(PostgreSQLPrimaryNode, PostgreSQLRLSEnforcer, "Enforces row-level security policies")
@enduml