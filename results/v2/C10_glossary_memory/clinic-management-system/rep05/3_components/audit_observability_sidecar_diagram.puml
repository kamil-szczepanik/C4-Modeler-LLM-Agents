@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Secure_WORM_Storage, "Secure WORM Storage", "Secure Write-Once-Read-Many storage for tamper-evident logs.")

Container_Boundary(Audit_Observability_Sidecar, "Audit & Observability Sidecar") {
    Component(FluentBit_Log_Collector, "FluentBit Log Collector", "FluentBit", "Collects, sanitizes, and ships tamper-evident audit logs and PII-sanitized telemetry.")
    Component(Prometheus_Metrics_Collector, "Prometheus Metrics Collector", "Prometheus", "Gathers system performance metrics and high availability health checks.")
}

Rel(FluentBit_Log_Collector, Secure_WORM_Storage, "Ships tamper-evident logs", "HTTPS/TLS 1.3 with Object Lock")
@enduml