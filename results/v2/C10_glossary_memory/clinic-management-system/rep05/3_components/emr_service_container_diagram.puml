@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(emr_service_container, "EMR Service Container") {
    Component(EMR API Controller Component, "EMR API Controller Component", "Java / Spring Boot", "Handles incoming gRPC requests for electronic medical records from the API Gateway.")
    Component(Security & Compliance Policy Component, "Security & Compliance Policy Component", "Spring Security & AspectJ", "Enforces RBAC/ABAC and security policies for patient data access.")
    Component(Clinical Record Domain Component, "Clinical Record Domain Component", "Java / Spring Boot", "Contains core business logic for managing clinical records and patient health data.")
    Component(Audit Trail Interceptor Component, "Audit Trail Interceptor Component", "AspectJ", "Provides non-invasive audit logging and emits events for compliance tracking.")
}

ContainerDb(Clinical Database, "Clinical Database", "PostgreSQL", "Stores clinical records and patient health data with ACID compliance.")
System_Ext(Notification Gateway, "Notification Gateway", "External System", "Receives compliance tracking and audit events.")

Rel(EMR API Controller Component, Security & Compliance Policy Component, "In-memory method calls", "")
Rel(Security & Compliance Policy Component, Clinical Record Domain Component, "In-memory method calls", "")
Rel(Clinical Record Domain Component, Clinical Database, "JDBC via TLS 1.3", "")
Rel(Audit Trail Interceptor Component, Notification Gateway, "HTTPS/REST", "")

@enduml