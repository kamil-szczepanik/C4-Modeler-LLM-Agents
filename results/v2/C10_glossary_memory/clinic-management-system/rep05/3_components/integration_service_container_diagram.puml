@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Service Container container

System_Boundary(integration_service_container, "Integration Service Container") {
    Component(HL7 FHIR Ingress Listener, "HL7 FHIR Ingress Listener", "Apache Camel HTTP Consumer", "Receives HL7 FHIR over HTTPS requests from external Lab and Imaging Systems securely using mTLS.")
    Component(FHIR Transformation Engine, "FHIR Transformation Engine", "HAPI FHIR Server", "Translates and validates healthcare interoperability data formats against standard FHIR schemas.")
    Component(gRPC Integration Dispatcher, "gRPC Integration Dispatcher", "Apache Camel gRPC Component", "Forwards processed clinical and lab records downstream to the EMR Service Container over gRPC with mTLS.")
    Component(Async Error Publisher, "Async Error Publisher", "Apache Camel AMQP Component", "Publishes failed integration payloads and dead-letter events to the External Managed Message Queue via AMQP over TLS 1.3.")
}

System_Ext(EMR Service Container, "EMR Service Container", "Downstream service for electronic medical records.")
System_Ext(External Managed Message Queue, "External Managed Message Queue", "External message broker for decoupled error handling.")

Rel(HL7 FHIR Ingress Listener, FHIR Transformation Engine, "Passes raw HL7/FHIR payloads for validation and mapping")
Rel(FHIR Transformation Engine, gRPC Integration Dispatcher, "Sends normalized FHIR resources")
Rel(gRPC Integration Dispatcher, EMR Service Container, "Invokes EMR APIs using gRPC over mTLS", "gRPC over mTLS")
Rel(FHIR Transformation Engine, Async Error Publisher, "Dispatches unprocessable message payloads on failure")
Rel(Async Error Publisher, External Managed Message Queue, "Sends decoupled error queue messages over AMQP with TLS 1.3", "AMQP over TLS 1.3")

@enduml