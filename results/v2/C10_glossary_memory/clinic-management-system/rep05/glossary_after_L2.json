{
 "entities": [
  {
   "name": "Clinic Management System",
   "type": "system",
   "level": "context",
   "description": "Manages patient admissions, EMRs, scheduling, and billing for healthcare providers in a hybrid cloud environment, ensuring HIPAA and GDPR compliance."
  },
  {
   "name": "Patients",
   "type": "person",
   "level": "context",
   "description": "Patients interacting with the healthcare system via the Patient Portal."
  },
  {
   "name": "Receptionists",
   "type": "person",
   "level": "context",
   "description": "Staff managing patient admissions and scheduling."
  },
  {
   "name": "Clinicians",
   "type": "person",
   "level": "context",
   "description": "Medical professionals managing Electronic Medical Records (EMRs)."
  },
  {
   "name": "Billing Specialists",
   "type": "person",
   "level": "context",
   "description": "Staff handling billing and insurance payments."
  },
  {
   "name": "Lab & Imaging Systems",
   "type": "externalSystem",
   "level": "context",
   "description": "External systems providing laboratory and imaging data."
  },
  {
   "name": "Insurance Payment Gateway",
   "type": "externalSystem",
   "level": "context",
   "description": "External gateway handling insurance payments."
  },
  {
   "name": "Identity Provider",
   "type": "externalSystem",
   "level": "context",
   "description": "Provides authentication and identity services via OIDC/SAML 2.0."
  },
  {
   "name": "Patient Portal",
   "type": "externalSystem",
   "level": "context",
   "description": "External portal for patient access."
  },
  {
   "name": "Notification Gateway",
   "type": "externalSystem",
   "level": "context",
   "description": "External gateway like Twilio/SendGrid for notifications."
  },
  {
   "name": "Hybrid API Gateway",
   "type": "externalSystem",
   "level": "context",
   "description": "Gateway with WAF for hybrid cloud traffic management."
  },
  {
   "name": "API Gateway / BFF Container",
   "type": "container",
   "level": "container",
   "description": "Handles ingress routing and TLS termination.",
   "technology": "Kong / Envoy"
  },
  {
   "name": "EMR Service Container",
   "type": "container",
   "level": "container",
   "description": "Resilient clinical record management.",
   "technology": "Java / Spring Boot"
  },
  {
   "name": "Scheduling Service Container",
   "type": "container",
   "level": "container",
   "description": "Manages resource clash logic.",
   "technology": "Node.js / TypeScript"
  },
  {
   "name": "Billing Service Container",
   "type": "container",
   "level": "container",
   "description": "High-performance claim processing.",
   "technology": "Go"
  },
  {
   "name": "Integration Service Container",
   "type": "container",
   "level": "container",
   "description": "Handles HL7 interoperability.",
   "technology": "Apache Camel / FHIR Server"
  },
  {
   "name": "Clinical Database",
   "type": "container",
   "level": "container",
   "description": "Distributed clinical database with AES-256 at rest and field-level encryption.",
   "technology": "PostgreSQL"
  },
  {
   "name": "Audit & Observability Sidecar",
   "type": "container",
   "level": "container",
   "description": "Provides metrics and tamper-evident logs.",
   "technology": "FluentBit / Prometheus"
  }
 ],
