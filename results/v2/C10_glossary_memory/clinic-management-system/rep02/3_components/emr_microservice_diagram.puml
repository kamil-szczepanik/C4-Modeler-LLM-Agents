@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(emr_microservice, "EMR Microservice") {
    Component(EMR_API_Handler, "EMR API Handler", "Go / gRPC", "Handles incoming gRPC requests for electronic medical records from the Unified API Gateway.")
    Component(EMR_Domain_Service, "EMR Domain Service", "Go", "Contains business logic for managing electronic medical records and patient health information.")
    Component(EMR_Data_Access_Repository, "EMR Data Access Repository", "SQL / TLS", "Manages database operations and queries against the Cloud-Native Distributed SQL Database.")
}

System_Ext(Cloud_Native_Distributed_SQL_Database, "Cloud-Native Distributed SQL Database", "CockroachDB")

Rel(EMR_API_Handler, EMR_Domain_Service, "Delegates requests to", "")
Rel(EMR_Domain_Service, EMR_Data_Access_Repository, "Queries and updates records via", "")
Rel(EMR_Data_Access_Repository, Cloud_Native_Distributed_SQL_Database, "Executes SQL statements over TLS", "SQL / TLS")
@enduml