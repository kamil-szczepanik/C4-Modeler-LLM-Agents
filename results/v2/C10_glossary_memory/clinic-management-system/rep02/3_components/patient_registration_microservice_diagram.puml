@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(patient_registration_microservice, "Patient Registration Microservice") {
    Component(Registration_Controller, "Registration Controller", "Spring MVC", "Handles incoming patient registration and admission HTTP requests.")
    Component(Patient_Matching_Engine, "Patient Matching Engine", "Java / Algorithms", "Matches incoming patient data against existing records to prevent duplicates.")
    Component(Eligibility_Verification_Service, "Eligibility Verification Service", "Spring Cloud OpenFeign", "Verifies patient insurance and eligibility status via external services.")
    Component(Eligibility_Circuit_Breaker_Wrapper, "Eligibility Circuit Breaker Wrapper", "Resilience4j", "Wraps eligibility verification calls to ensure fault tolerance and resilience.")
    Component(Audit___Compliance_Interceptor, "Audit & Compliance Interceptor", "Spring AspectJ", "Intercepts requests for auditing and ensures compliance with HIPAA and GDPR mandates.")
    Component(Registration_Data_Repository, "Registration Data Repository", "Spring Data JPA", "Persists patient registration and onboarding data to the underlying database.")
}

Rel(Registration_Controller, Patient_Matching_Engine, "In-Memory Method Call")
Rel(Registration_Controller, Eligibility_Circuit_Breaker_Wrapper, "In-Memory Method Call")
Rel(Eligibility_Circuit_Breaker_Wrapper, Eligibility_Verification_Service, "HTTPS / JSON with Circuit Breaker")
Rel(Registration_Controller, Audit___Compliance_Interceptor, "AOP / AspectJ")
Rel(Audit___Compliance_Interceptor, Registration_Data_Repository, "JDBC / TLS")
Rel(Registration_Controller, Registration_Data_Repository, "JDBC / TLS")
@enduml