@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Scheduling Microservice container

System_Ext(UnifiedAPIgateway, "Unified API Gateway", "API Gateway, TLS 1.3")
System_Ext(DistributedCacheRedisEnterprise, "Distributed Cache (Redis Enterprise)", "Redis Enterprise")
System_Ext(CloudNativeDistributedSQLDatabase, "Cloud-Native Distributed SQL Database", "CockroachDB")

Container_Boundary(SchedulingMicroservice, "Scheduling Microservice") {
    Component(AppointmentController, "Appointment Controller", "Spring MVC", "Exposes REST endpoints for appointment scheduling and routes requests via mTLS.")
    Component(SchedulingEngine, "Scheduling Engine", "Spring Service", "Coordinates scheduling logic and manages interaction with calendar and slot reservation services.")
    Component(CalendarResourceManager, "Calendar Resource Manager", "Spring Service", "Manages calendar resources and availability.")
    Component(SlotReservationManager, "Slot Reservation Manager", "Spring Service", "Handles ephemeral slot reservation timeouts and concurrency.")
    Component(SchedulingDataAccessRepository, "Scheduling Data Access Repository", "Spring Data JPA", "Manages database persistence and transaction boundaries for scheduling.")
}

Rel(UnifiedAPIgateway, AppointmentController, "HTTP / REST via mTLS", "HTTP")
Rel(AppointmentController, SchedulingEngine, "In-process Java Method Call", "")
Rel(SchedulingEngine, CalendarResourceManager, "In-process Java Method Call", "")
Rel(SchedulingEngine, SlotReservationManager, "In-process Java Method Call", "")
Rel(SlotReservationManager, DistributedCacheRedisEnterprise, "Redis Protocol / TLS", "Redis")
Rel(SchedulingEngine, SchedulingDataAccessRepository, "In-process Java Method Call", "")
Rel(SchedulingDataAccessRepository, CloudNativeDistributedSQLDatabase, "SQL / TLS with serializable isolation", "SQL")

@enduml