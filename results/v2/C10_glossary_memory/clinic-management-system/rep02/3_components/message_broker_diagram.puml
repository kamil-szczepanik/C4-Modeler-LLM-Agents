@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(message_broker, "Message Broker") {
    Component(topic_manager, "Topic Manager", "Apache Kafka Topic Controller", "Manages Kafka topics, partitions, and replication policies for asynchronous event streams.")
    Component(access_control, "Access Control & Encryption Manager", "Kafka ACLs & SASL/SCRAM-512", "Enforces fine-grained access control lists and encryption for data in transit within the message broker.")
    Component(schema_registry, "Schema Registry", "Confluent Schema Registry", "Validates and manages event schemas to ensure backward and forward compatibility across microservices.")
    Component(metrics_exporter, "Broker Health & Metrics Exporter", "Prometheus Exporter", "Exposes health metrics, broker status, and telemetry data for cluster monitoring.")
    Component(tiered_storage, "Data Retention & Tiered Storage Manager", "Kafka Tiered Storage", "Enforces 10-year data retention mandates by tiering historical event logs to secure long-term storage.")
    Component(data_masking, "In-Transit Data Masking & Tokenization", "Custom Interceptor Middleware", "Masks and tokenizes sensitive patient and financial data flowing through event streams for HIPAA/GDPR compliance.")
    Component(audit_logger, "Broker Audit & Compliance Logger", "Kafka Audit Logger", "Logs all broker access attempts, message operations, and administrative actions for regulatory compliance.")
}

Rel(access_control, topic_manager, "Secures access to", "Kafka ACLs")
Rel(data_masking, topic_manager, "Masks payloads for", "Interceptor Middleware")
Rel(schema_registry, topic_manager, "Validates schemas for", "REST / Kafka")
Rel(tiered_storage, topic_manager, "Manages storage retention for", "Tiered Storage API")
Rel(metrics_exporter, topic_manager, "Monitors health of", "Prometheus")
Rel(audit_logger, access_control, "Records security and access events from", "Internal Log")

@enduml