@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(cloud_native_distributed_sql_database, "Cloud-Native Distributed SQL Database") {
    Component(sql_layer, "SQL Layer", "CockroachDB SQL Engine", "Parses, optimizes, and executes SQL queries and provides PostgreSQL wire protocol compatibility.")
    Component(distributed_transaction_engine, "Distributed Transaction Engine", "CockroachDB Distributed Transaction Coordinator", "Coordinates distributed ACID transactions across multiple nodes and shards.")
    Component(storage_layer_raft_consensus_rocksdb, "Storage Layer (Raft Consensus & RocksDB)", "RocksDB & Raft Consensus", "Persists data using RocksDB storage engines and ensures replication and consensus via Raft.")
}

Rel(sql_layer, distributed_transaction_engine, "Routes queries for transaction coordination", "")
Rel(distributed_transaction_engine, storage_layer_raft_consensus_rocksdb, "Reads and writes replicated data shards", "")
@enduml