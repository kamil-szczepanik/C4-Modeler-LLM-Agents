@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing Microservice container

Container_Boundary(billing_microservice, "Billing Microservice") {
    Component(Invoice_API_Controller, "Invoice API Controller", "Node.js / Express", "Handles HTTP/REST billing requests.")
    Component(Claims_Orchestrator, "Claims Orchestrator", "Node.js / Express", "Coordinates asynchronous claim events.")
    Component(Clearinghouse_Integration_Adapter, "Clearinghouse Integration Adapter", "Node.js / Axios", "Manages outbound API calls.")
    Component(Cloud_Native_Distributed_SQL_Database, "Cloud-Native Distributed SQL Database", "CockroachDB", "Stores financial records.")
    Component(Message_Broker, "Message Broker", "Apache Kafka", "Handles asynchronous claim messaging.")
    Component(Distributed_Cache_Redis_Enterprise, "Distributed Cache (Redis Enterprise)", "Redis Enterprise", "Manages session states and rate-limiting.")
}

System_Ext(Insurance_Clearinghouses, "Insurance Clearinghouses", "External claim processing systems.")

Rel(Invoice_API_Controller, Cloud_Native_Distributed_SQL_Database, "Reads/writes invoices", "SQL / TLS")
Rel(Claims_Orchestrator, Message_Broker, "Publishes claim events", "Apache Kafka Protocol")
Rel(Clearinghouse_Integration_Adapter, Insurance_Clearinghouses, "Submits claims", "Secure EDI / HTTPS")
Rel(Invoice_API_Controller, Distributed_Cache_Redis_Enterprise, "Caches session states", "RESP / TLS")
@enduml