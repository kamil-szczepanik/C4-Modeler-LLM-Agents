@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Distributed Cache (Redis Enterprise) container

Container_Boundary(redis_enterprise, "Distributed Cache (Redis Enterprise)") {
    Component(InMemoryDataStore, "In-Memory Data Store", "Redis Core / Redis Enterprise Active-Active CRDTs", "Manages high-performance distributed session state, real-time messaging, and transient caching with active-active CRDT multi-region synchronization.")
    Component(ClusterManagerProxy, "Cluster Manager & Proxy", "Envoy/Redis-Proxy", "Handles intelligent client routing, connection pooling, and TLS termination.")
    Component(PubSubWebSocketEngine, "Pub/Sub & WebSocket Engine", "Redis native Pub/Sub", "Enables real-time messaging and WebSocket pub/sub communications.")
}

Component(UnifiedAPIGateway, "Unified API Gateway", "API Gateway, TLS 1.3", "Handles rate-limiting, JWT validation, and routes traffic for the system.")
Component(EMRMicroservice, "EMR Microservice", "Go / gRPC", "Manages electronic medical records and patient health information.")
Component(SchedulingMicroservice, "Scheduling Microservice", "Spring Boot", "Manages appointments, scheduling, and calendar resources.")
Component(PatientPortalMobileApp, "Patient Portal / Mobile App", "External client application", "External client application used by patients to access healthcare services.")
Component(HashiCorpVault, "HashiCorp Vault", "Secrets Management", "Provides automated TLS certificate and AUTH token rotation via API.")

Rel(UnifiedAPIGateway, InMemoryDataStore, "RESP / mTLS 1.3 for session management and WebSocket pub/sub messaging", "RESP / mTLS 1.3")
Rel(EMRMicroservice, InMemoryDataStore, "RESP / mTLS 1.3 for transient data caching", "RESP / mTLS 1.3")
Rel(SchedulingMicroservice, InMemoryDataStore, "RESP / mTLS 1.3 for calendar lock states", "RESP / mTLS 1.3")
Rel(HashiCorpVault, InMemoryDataStore, "Automated TLS certificate and AUTH token rotation via API", "API")

@enduml