@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Unified API Gateway container

Container_Boundary(unified_api_gateway, "Unified API Gateway") {
    Component(api_gateway, "API Gateway", "Kong/Envoy", "Handles rate-limiting, TLS 1.3 termination, and entry point routing for inbound traffic.")
    Component(lua_wasm_plugins, "Lua/Wasm Plugins", "Lua / Wasm", "Implements zero-trust token validation, JWT verification, and security checks.")
}

Rel(api_gateway, lua_wasm_plugins, "Evaluates inbound requests for zero-trust token validation and routing", "")

@enduml