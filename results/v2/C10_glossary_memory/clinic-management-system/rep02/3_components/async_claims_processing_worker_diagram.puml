@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(async_claims_processing_worker, "Async Claims Processing Worker") {
    Component(Claims_Consumer, "Claims Consumer", "Node.js / Kafka Consumer", "Consumes asynchronous claims processing jobs from the message broker.")
    Component(EDI_Formatter, "EDI Formatter", "TypeScript / EDI Parser", "Formats processed claims into secure EDI format for clearinghouse submission.")
    Component(Clearinghouse_Integration_Client, "Clearinghouse Integration Client", "HTTPS Client with Circuit Breakers", "Communicates securely with external insurance clearinghouses using circuit breakers.")
}

Rel(Claims_Consumer, EDI_Formatter, "Passes raw claim messages for formatting")
Rel(EDI_Formatter, Clearinghouse_Integration_Client, "Sends formatted EDI payloads")
@enduml