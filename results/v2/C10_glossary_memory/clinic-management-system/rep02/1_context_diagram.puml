@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Clinic Management System

Person(Front_Desk_Receptionists, "Front-Desk Receptionists", "Manages patient check-ins, admissions, and basic front-desk operations.")
Person(Clinicians, "Clinicians", "Accesses and updates electronic medical records (EMRs) and manages patient care.")
Person(Billing_Specialists, "Billing Specialists", "Manages invoices, payments, and financial transactions with insurance providers.")
Person(IT_Compliance_Administrators, "IT/Compliance Administrators", "Manages system security, compliance, infrastructure, and access controls.")
Person(Patients, "Patients", "Interacts with the system via portal to view appointments, records, and billing.")

System_Ext(Lab___Imaging_Systems, "Lab & Imaging Systems", "External systems providing laboratory results and medical imaging data.")
System_Ext(Insurance_Clearinghouses, "Insurance Clearinghouses", "External systems for processing medical claims and insurance verifications.")
System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "Handles multi-factor authentication (MFA), OIDC, and SAML 2.0 identity services.")
System_Ext(Patient_Portal___Mobile_App, "Patient Portal / Mobile App", "External client application used by patients to access healthcare services.")

System(Clinic_Management_System, "Clinic Management System", "A hybrid healthcare IT platform designed to manage patient admissions, EMRs, scheduling, and billing, providing high availability, secure operations, and regulatory compliance for medium-sized hospitals and clinics.")

Container(Unified_API_Gateway, "Unified API Gateway", "API Gateway, TLS 1.3", "Handles rate-limiting, JWT validation, and routes traffic for the system.")
Container(EMR_Microservice, "EMR Microservice", "Microservice", "Manages electronic medical records and patient health information.")
Container(Scheduling_Service, "Scheduling Service", "Microservice", "Manages appointments, scheduling, and calendar resources.")
Container(Billing_Service, "Billing Service", "Microservice", "Processes billing, invoices, and clearinghouse integrations.")
Container(Distributed_Cache_Redis_Enterprise, "Distributed Cache (Redis Enterprise)", "Redis Enterprise", "Provides distributed session state and WebSocket message broker capabilities.")

Rel(Patient_Portal___Mobile_App, Unified_API_Gateway, "Requests API data and manages sessions", "HTTPS / REST and WebSocket via OIDC/OAuth 2.0")
Rel(Clinic_Management_System, Lab___Imaging_Systems, "Exchanges lab orders and imaging results", "HL7 FHIR over HTTPS (REST/JSON) with W3C trace contexts")
Rel(Clinic_Management_System, Insurance_Clearinghouses, "Submits claims and verifies insurance", "Secure EDI / HTTPS APIs with circuit breakers")
Rel(Clinic_Management_System, Identity_Provider_IdP, "Authenticates users and performs multi-factor authentication", "OIDC/SAML 2.0 over HTTPS")
Rel(on_prem_k8s, eu_central_1, "Hybrid cloud active-active communication and replication", "Encrypted IPsec site-to-site VPN and mutual TLS (mTLS)")
@enduml