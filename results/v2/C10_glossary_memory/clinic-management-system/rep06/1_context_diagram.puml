@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "Individuals receiving care who interact with the system for scheduling and portals via web or mobile clients.")
Person(Receptionists_Admins, "Receptionists/Admins", "Administrative staff managing patient admissions, front-desk workflows, and scheduling.")
Person(Clinicians_Doctors, "Clinicians/Doctors", "Medical professionals managing electronic medical records (EMR), clinical workflows, and patient care.")
Person(Billing_Specialists, "Billing Specialists", "Staff members handling financial records, invoicing, and insurance claims.")
Person(Compliance_Security_Officers, "Compliance/Security Officers", "Personnel responsible for monitoring audit trails, security, and regulatory compliance (HIPAA, GDPR).")
Person(Hospital_Clinic_Management, "Hospital/Clinic Management", "Executives viewing management dashboards and high-level clinical operations data.")

System(Clinic_Management_System, "Clinic Management System", "A hybrid-cloud platform designed for medium-sized hospitals and clinics to manage patient admissions, electronic medical records (EMR), scheduling, and billing while ensuring high availability, strict regulatory compliance, and high-performance clinical workflows.")

System_Ext(External_Identity_Provider_IdP, "External Identity Provider (IdP)", "External system providing authentication services via OpenID Connect (OIDC) / SAML 2.0 with MFA.")
System_Ext(External_Lab__Imaging_Systems, "External Lab & Imaging Systems", "External diagnostic systems exchanging medical imaging and lab data via HL7 FHIR.")
System_Ext(Insurance_Clearinghouse, "Insurance Clearinghouse", "External system receiving insurance and billing claims via EDI over secure SFTP / HTTPS.")

Rel(Patients, Clinic_Management_System, "Interacts for patient care, scheduling, and portal access", "HTTPS (Web/Mobile)")
Rel(Receptionists_Admins, Clinic_Management_System, "Manages patient admissions and scheduling", "HTTPS (Web)")
Rel(Clinicians_Doctors, Clinic_Management_System, "Accesses and updates EMR and clinical workflows", "HTTPS (Web/Mobile)")
Rel(Billing_Specialists, Clinic_Management_System, "Manages billing and financial processes", "HTTPS (Web)")
Rel(Compliance_Security_Officers, Clinic_Management_System, "Monitors audit trails, security logs, and compliance", "HTTPS (Web)")
Rel(Hospital_Clinic_Management, Clinic_Management_System, "Views management dashboards and operational metrics", "HTTPS (Web)")
Rel(Clinic_Management_System, External_Identity_Provider_IdP, "Authenticates users via OIDC/SAML with MFA", "HTTPS")
Rel(Clinic_Management_System, External_Lab__Imaging_Systems, "Exchanges diagnostic data", "HL7 FHIR over HTTPS (REST/JSON) with mTLS")
Rel(Clinic_Management_System, Insurance_Clearinghouse, "Submits insurance claims", "EDI over SFTP / HTTPS")

@enduml