@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(RoutingEngine, "Routing Engine", "Kong / Envoy", "Routes incoming requests from the client portals to the appropriate backend microservices over the internal mesh.")
    Component(AuthFilter, "Authentication & Authorization Filter", "Lua / WASM", "Validates OIDC tokens, interacts with the External Identity Provider for JWKS, and enforces RBAC/ABAC policies.")
    Component(RateLimitingModule, "Rate Limiting & Throttling Module", "Kong / Envoy Plugin", "Evaluates rate limits and throttling rules backed by a distributed cache.")
}

System_Ext(PatientAdmissionService, "Patient Admission Service", "Go / Node.js")
System_Ext(SchedulingService, "Scheduling Service", "Go / Node.js")
System_Ext(EMRService, "EMR Service", "Go / Node.js")
System_Ext(BillingService, "Billing Service", "Java Spring Boot")
System_Ext(IntegrationEngine, "Integration Engine", "Go / Node.js")
System_Ext(ExternalIdP, "External Identity Provider (IdP)", "External Identity Provider")
System_Ext(DataStore, "Data Store", "Distributed Cache / Redis")

Rel(RoutingEngine, PatientAdmissionService, "Routes admission requests", "gRPC / REST")
Rel(RoutingEngine, SchedulingService, "Routes scheduling requests", "gRPC / REST")
Rel(RoutingEngine, EMRService, "Routes EMR requests", "gRPC / REST")
Rel(RoutingEngine, BillingService, "Routes billing requests", "gRPC / REST")
Rel(RoutingEngine, IntegrationEngine, "Routes integration requests", "gRPC / REST")
Rel(AuthFilter, ExternalIdP, "Validates tokens and fetches JWKS", "HTTPS")
Rel(RateLimitingModule, DataStore, "Evaluates rate limits against distributed cache", "Redis Protocol")
@enduml