@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Internal Staff Application container

System_Ext(External_Identity_Provider_IdP, "External Identity Provider (IdP)", "External Identity Provider")
System_Ext(API_Gateway, "API Gateway", "API Gateway (Kong / Envoy)")

Container_Boundary(Internal_Staff_Application, "Internal Staff Application") {
    Component(Staff_Auth___Session_Manager, "Staff Auth & Session Manager", "OpenID Connect (OIDC) / SAML 2.0 with MFA", "Manages staff authentication, session management, and secure token isolation using HttpOnly, Secure, SameSite=Strict Cookies.")
    Component(Admission___Reception_Module, "Admission & Reception Module", "React / TypeScript, Nginx", "Handles patient admissions and front-desk workflows within the internal staff application.")
    Component(EMR_Clinical_Workspace_Module, "EMR Clinical Workspace Module", "React / TypeScript, Nginx", "Provides dynamic, role-based single-page application interfaces for managing electronic medical records with sub-second performance.")
    Component(Billing___Claims_Module, "Billing & Claims Module", "React / TypeScript, Nginx", "Handles financial records, invoicing, and insurance claims interfaces for billing specialists.")
    Component(Compliance___Audit_Dashboard, "Compliance & Audit Dashboard", "React / TypeScript, Nginx", "Monitors audit trails, security, and regulatory compliance (HIPAA, GDPR) for compliance and security officers.")
}

Rel(Staff_Auth___Session_Manager, External_Identity_Provider_IdP, "Authenticates users via HTTPS (OIDC / SAML 2.0 with MFA)", "HTTPS")
Rel(Admission___Reception_Module, API_Gateway, "Sends API requests via HTTPS (mTLS/OIDC, REST/GraphQL)", "HTTPS")
Rel(EMR_Clinical_Workspace_Module, API_Gateway, "Sends API requests via HTTPS (mTLS/OIDC, REST/GraphQL)", "HTTPS")
Rel(Billing___Claims_Module, API_Gateway, "Sends API requests via HTTPS (mTLS/OIDC, REST/GraphQL)", "HTTPS")
Rel(Compliance___Audit_Dashboard, API_Gateway, "Sends API requests via HTTPS (mTLS/OIDC, REST/GraphQL)", "HTTPS")

@enduml