@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Engine container

Container_Boundary(integration_engine, "Integration Engine") {
    Component(HL7FHIRAdapter, "HL7 FHIR Adapter", "Go / Node.js", "Exchanges diagnostic data and medical imaging via HL7 FHIR over HTTPS with mTLS.")
    Component(EDIClearinghouseAdapter, "EDI Clearinghouse Adapter", "Go / Node.js", "Submits insurance and billing claims via EDI over SFTP / HTTPS.")
    Component(MessageRoutingEngine, "Message Routing Engine", "RabbitMQ / NATS", "Routes internal and external messages across the integration pipeline.")
}

Rel(HL7FHIRAdapter, MessageRoutingEngine, "Publishes normalized diagnostic messages")
Rel(EDIClearinghouseAdapter, MessageRoutingEngine, "Publishes claims processing status")
Rel(MessageRoutingEngine, HL7FHIRAdapter, "Dispatches payloads for external lab systems")
Rel(MessageRoutingEngine, EDIClearinghouseAdapter, "Dispatches claims batches for insurance clearinghouses")
@enduml