@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(scheduling_service, "Scheduling Service") {
    Component(Scheduling_Controller, "Scheduling Controller", "Go / Node.js Router", "Handles incoming gRPC and REST requests for appointment scheduling and slot management from the API Gateway.")
    Component(Appointment_Workflow_Manager, "Appointment Workflow Manager", "Temporal SDK / Asynq (Redis)", "Manages complex appointment orchestration, reminders, and asynchronous task queues for reliable scheduling workflows.")
    Component(Scheduling_Repository, "Scheduling Repository", "PostgreSQL Client Driver", "Handles secure persistence and retrieval of appointment and calendar data with AES-256 encryption.")
}

System_Ext(Data_Store, "Data Store", "PostgreSQL & WORM Object Storage")
System_Ext(API_Gateway, "API Gateway", "Kong / Envoy")

Rel(API_Gateway, Scheduling_Controller, "Requests appointment scheduling and slot management", "gRPC / REST")
Rel(Scheduling_Controller, Appointment_Workflow_Manager, "Triggers appointment processing workflows", "")
Rel(Appointment_Workflow_Manager, Scheduling_Repository, "Persists appointment data", "")
Rel(Scheduling_Repository, Data_Store, "PostgreSQL protocol with AES-256", "PostgreSQL protocol with AES-256")

@enduml