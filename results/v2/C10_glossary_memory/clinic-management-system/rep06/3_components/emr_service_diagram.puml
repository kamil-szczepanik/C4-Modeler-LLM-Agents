@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("emr_service", "EMR Service") {
    Component("EMR_API_Controller", "EMR API Controller", "Go / Node.js", "Exposes REST and gRPC endpoints for electronic medical records management.")
    Component("Clinical_Workflow_Manager", "Clinical Workflow Manager", "Go / Node.js", "Manages clinical workflows, chart notes, and high-performance data processing.")
    Component("EMR_Data_Access_Layer", "EMR Data Access Layer", "Go / Node.js, PostgreSQL protocol", "Handles secure database transactions and AES-256 encrypted queries with the Data Store.")
}

Rel("EMR_API_Controller", "Clinical_Workflow_Manager", "Delegates clinical requests")
Rel("Clinical_Workflow_Manager", "EMR_Data_Access_Layer", "Persists and retrieves medical records")
@enduml