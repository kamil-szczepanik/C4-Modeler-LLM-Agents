@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing Service container

Container(api_gateway, "API Gateway", "Kong / Envoy", "Routes invoice and billing queries.")
Container(patient_portal, "Patient Portal", "React / TypeScript, Nginx", "Routes self-service payments via API Gateway.")
Container(integration_engine, "Integration Engine", "Go / Node.js", "Transmits EDI payloads to the insurance clearinghouse.")
ContainerDb(data_store, "Data Store", "PostgreSQL, WORM Object Storage", "Reads and writes financial records.")
System_Ext(insurance_clearinghouse, "Insurance Clearinghouse", "EDI over SFTP / HTTPS", "External system receiving insurance and billing claims.")

Container_Boundary(billing_service, "Billing Service") {
    Component(invoice_management_component, "Invoice Management Component", "Java Spring Boot", "Routes invoice and billing queries.")
    Component(claims_processing_component, "Claims Processing Component", "Spring Batch & Spring Integration", "Dispatches batch claims.")
    Component(payment_reconciliation_component, "Payment Reconciliation Component", "Java Spring Boot", "Handles financial record reconciliation.")
    Component(clearinghouse_adapter_component, "Clearinghouse Adapter Component", "Java Spring Boot", "Adapts and transmits payloads for insurance clearinghouses.")
    Component(patient_billing_portal_component, "Patient Billing Portal Component", "Java Spring Boot", "Routes self-service payments.")
}

Rel(api_gateway, invoice_management_component, "Routes invoice and billing queries", "gRPC / REST")
Rel(patient_portal, patient_billing_portal_component, "Routes self-service payments", "gRPC / REST via API Gateway")
Rel(claims_processing_component, clearinghouse_adapter_component, "Dispatches batch claims", "Internal Message Broker")
Rel(clearinghouse_adapter_component, integration_engine, "Transmits EDI payloads", "TLS 1.3, SFTP / HTTPS")
Rel(integration_engine, insurance_clearinghouse, "Transmits EDI payloads", "TLS 1.3, SFTP / HTTPS")
Rel(invoice_management_component, data_store, "Reads and writes financial records", "JDBC over PostgreSQL protocol with AES-256")
Rel(claims_processing_component, data_store, "Reads and writes financial records", "JDBC over PostgreSQL protocol with AES-256")
Rel(payment_reconciliation_component, data_store, "Reads and writes financial records", "JDBC over PostgreSQL protocol with AES-256")
Rel(clearinghouse_adapter_component, data_store, "Reads and writes financial records", "JDBC over PostgreSQL protocol with AES-256")
Rel(patient_billing_portal_component, data_store, "Reads and writes financial records", "JDBC over PostgreSQL protocol with AES-256")

@enduml