@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient Portal container

System_Ext(api_gateway, "API Gateway", "Kong / Envoy handling mTLS, rate limiting, and token validation")

Container_Boundary(patient_portal, "Patient Portal") {
    Component(patient_portal_ui, "Patient Portal UI", "React / TypeScript, Nginx", "Web and mobile user interface allowing patients to view personal portal information and manage scheduling.")
    Component(portal_auth_client, "Portal Authentication Client", "OIDC / OAuth 2.0 Client", "Handles user login, token management, and session validation against the External Identity Provider and API Gateway.")
    Component(appointment_scheduler_ui, "Appointment Scheduler UI", "React / TypeScript", "Component allowing patients to browse available appointment slots, book, and manage scheduling workflows.")
}

Rel(patient_portal_ui, portal_auth_client, "Authenticates users via")
Rel(patient_portal_ui, appointment_scheduler_ui, "Renders scheduling views via")
Rel(portal_auth_client, api_gateway, "Sends secure requests with OIDC tokens via", "HTTPS (mTLS/OIDC)")
Rel(appointment_scheduler_ui, api_gateway, "Requests scheduling data via", "HTTPS (mTLS/OIDC)")

@enduml