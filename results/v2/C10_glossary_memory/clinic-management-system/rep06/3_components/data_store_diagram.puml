@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Store container

Container_Boundary(data_store, "Data Store") {
    Component(Primary_Relational_Database, "Primary Relational Database", "PostgreSQL 16 & Read-Replicas", "Provides core transactional data storage and offloads analytical queries with active-passive replication.")
    Component(Audit_Archive_Object_Store, "Audit & Archive Object Store", "S3-compatible Object Storage with Object Lock", "Enforces immutable 10-year WORM retention and automated tiering.")
    Component(Read_Replica_Cluster, "Read Replica Cluster", "PostgreSQL Read-Replicas", "Handles read-heavy workloads and offloads analytical queries from the primary transactional database.")
}

Rel(Primary_Relational_Database, Audit_Archive_Object_Store, "S3 API / TLS 1.3", "")
Rel(Primary_Relational_Database, Read_Replica_Cluster, "Active-passive replication", "")

@enduml