@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System (CMS)

Person(Patients, "Patients", "Patients interacting with the clinic management system for scheduling and personal records.")
Person(Clinicians, "Clinicians / Medical Staff", "Medical professionals managing electronic medical records (EMRs) and patient care.")
Person(Administrative, "Administrative / Billing Staff", "Staff managing patient admissions, scheduling, and billing operations.")

System_Ext(External_Labs, "External Labs/Imaging", "External systems providing laboratory and imaging results via FHIR APIs.")
System_Ext(Insurance_Payment_Gateways, "Insurance Payment Gateways", "External payment processors handling insurance billing and transactions.")
System_Ext(Identity_Provider, "Identity Provider (IdP)", "External identity provider managing authentication, federation, and step-up MFA.")

System_Boundary(cms_system, "Clinic Management System (CMS)") {
    Container(API_Gateway, "API Gateway", "Kubernetes / AWS", "Manages incoming traffic and enforces security policies.")
    Container(FHIR_Integration_Engine, "FHIR Integration Engine", "Apache Camel / Node.js", "Handles HL7 FHIR interoperability and exchanges clinical data.")
    Container(Patient_Portal, "Patient Portal", "Kubernetes", "Provides patients access to scheduling and personal records.")
    Container(Clinical_Workspace, "Clinical Workspace", "Kubernetes", "Provides medical professionals tools for managing EMRs and patient care.")
    Container(Billing_Admin_Suite, "Billing & Admin Suite", "Kubernetes", "Handles patient admissions, scheduling, and billing operations.")
    ContainerDb(Core_Datastore, "Core Datastore", "PostgreSQL with CQRS", "Manages persistent storage with localized read replicas and primary master for writes.")
    Container(Hardware_Security_Module, "Hardware Security Module (HSM)", "FIPS 140-2 Hardware", "Provides FIPS 140-2 validated cryptographic operations and key management.")
    Container(WORM_Audit_Logging_Service, "WORM Audit Logging Service", "Secure Storage", "Provides asynchronous WORM auditing for compliance and security.")
}

Rel(Patients, API_Gateway, "Accesses scheduling and portal features", "HTTPS (TLS 1.3), OAuth 2.0 / OIDC, MFA")
Rel(Clinicians, API_Gateway, "Manages EMRs and patient care data", "HTTPS (TLS 1.3), OAuth 2.0 / OIDC, MFA")
Rel(Administrative, API_Gateway, "Handles admissions, scheduling, and billing", "HTTPS (TLS 1.3), OAuth 2.0 / OIDC, MFA")
Rel(External_Labs, API_Gateway, "Exchanges clinical data and lab results", "HL7 FHIR RESTful APIs over HTTPS")
Rel(Insurance_Payment_Gateways, API_Gateway, "Processes billing and payment transactions", "Secure API webhooks / REST")
Rel(Identity_Provider, API_Gateway, "Authenticates users and provides federation", "OAuth 2.0 / OpenID Connect (OIDC)")

Rel(API_Gateway, Patient_Portal, "Routes patient traffic", "gRPC over mTLS (Mutual TLS 1.3), SPIFFE/SPIRE X.509 certs")
Rel(API_Gateway, Clinical_Workspace, "Routes clinician traffic", "gRPC over mTLS (Mutual TLS 1.3), SPIFFE/SPIRE X.509 certs")
Rel(API_Gateway, Billing_Admin_Suite, "Routes administrative traffic", "gRPC over mTLS (Mutual TLS 1.3), SPIFFE/SPIRE X.509 certs")
Rel(API_Gateway, FHIR_Integration_Engine, "Routes FHIR integration traffic", "gRPC over mTLS (Mutual TLS 1.3), SPIFFE/SPIRE X.509 certs")

Rel(Clinical_Workspace, Core_Datastore, "Reads and writes clinical data", "PostgreSQL with CQRS")
Rel(Billing_Admin_Suite, Core_Datastore, "Reads and writes billing data", "PostgreSQL with CQRS")
Rel(FHIR_Integration_Engine, Core_Datastore, "Persists interoperability data", "PostgreSQL with CQRS")

Rel(Clinical_Workspace, Hardware_Security_Module, "Performs cryptographic encryption and key operations", "FIPS 140-2 / AES-256")
Rel(Billing_Admin_Suite, Hardware_Security_Module, "Performs cryptographic encryption and key operations", "FIPS 140-2 / AES-256")

Rel(Clinical_Workspace, WORM_Audit_Logging_Service, "Records immutable audit logs for compliance", "Asynchronous secure logging")
Rel(Billing_Admin_Suite, WORM_Audit_Logging_Service, "Records immutable audit logs for compliance", "Asynchronous secure logging")

@enduml