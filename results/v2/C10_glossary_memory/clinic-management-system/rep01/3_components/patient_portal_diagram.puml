@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(patient_portal, "Patient Portal") {
    Component(Portal_API_Controller, "Portal API Controller", "Node.js / Express", "Handles asynchronous gRPC traffic and coordinates requests.")
    Component(Appointment_Self_Service_Module, "Appointment Self-Service Module", "TypeScript", "Manages appointment scheduling and self-service workflows.")
    Component(Record_Viewer_Service, "Record Viewer Service", "TypeScript", "Retrieves and displays personal health records.")
    Component(Patient_Web_Frontend, "Patient Web Frontend", "React / Next.js", "Delivers a mobile-responsive UI with Content Security Policies.")
    Component(Patient_Cache_Manager, "Patient Cache Manager", "Redis", "In-memory cache manager with TLS 1.3 for sub-second P95 performance.")
}

Rel(Portal_API_Controller, Appointment_Self_Service_Module, "In-process gRPC / TypeScript function calls", "gRPC / TypeScript")
Rel(Portal_API_Controller, Record_Viewer_Service, "In-process gRPC / TypeScript function calls", "gRPC / TypeScript")
Rel(Record_Viewer_Service, Patient_Cache_Manager, "Read-through caching via TLS 1.3 over internal service mesh", "TLS 1.3")
@enduml