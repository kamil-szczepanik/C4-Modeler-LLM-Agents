@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(fhir_integration_engine, "FHIR Integration Engine") {
    Component(fhir_router, "FHIR Router", "Apache Camel", "Routes and maps incoming HL7 FHIR messages to internal domain models.")
    Component(fhir_resource_mapper, "FHIR Resource Mapper", "Node.js", "Transforms FHIR resources for persistence in the Core Datastore.")
}

SystemDb(core_datastore, "Core Datastore", "PostgreSQL with CQRS", "Persists clinical and domain data.")

Rel(fhir_router, fhir_resource_mapper, "Routes mapped payloads")
Rel(fhir_resource_mapper, core_datastore, "Persists clinical data using PostgreSQL with CQRS")

@enduml