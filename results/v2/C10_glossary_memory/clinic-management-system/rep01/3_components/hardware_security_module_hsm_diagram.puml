@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Hardware Security Module (HSM) container

Container_Boundary(hsm, "Hardware Security Module (HSM)") {
    Component(Cryptographic_Engine, "Cryptographic Engine", "FIPS 140-2 Level 3 Hardware", "Performs hardware-accelerated cryptographic operations and tamper-resistant key storage.")
    Component(KMS_Daemon, "Key Management Service (KMS) Daemon", "PKCS#11 / KMIP & TLS 1.3", "Manages cryptographic keys, lifecycle operations, and zero-downtime key rotation.")
    Component(Secure_Hardware_Vault, "Secure Hardware Vault", "FIPS 140-2 Level 3 Secure Storage", "Provides secure, isolated hardware storage for master keys and sensitive cryptographic material.")
    Component(Key_Version_Registry, "Key Version Registry", "Internal Secure Database", "Tracks key versions, metadata, and state transitions for cryptographic keys.")
}

Rel(KMS_Daemon, Secure_Hardware_Vault, "Communicates via internal proprietary bus")
Rel(KMS_Daemon, Key_Version_Registry, "Performs secure database read/write")
Rel(Cryptographic_Engine, Secure_Hardware_Vault, "Accesses keys for cryptographic operations")

@enduml