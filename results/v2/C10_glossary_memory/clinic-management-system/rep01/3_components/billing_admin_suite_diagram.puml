@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing & Admin Suite container

Container_Boundary(billing_admin_suite_boundary, "Billing & Admin Suite") {
    Component(Billing Management Service, "Billing Management Service", "Kubernetes / Node.js", "Handles patient billing operations, invoice generation, and financial transaction processing.")
    Component(Admission Management Service, "Admission Management Service", "Kubernetes / Node.js", "Manages patient admissions, registration workflows, and administrative scheduling.")
}

System_Ext(Core Datastore, "Core Datastore", "PostgreSQL with CQRS")
System_Ext(Hardware Security Module (HSM), "Hardware Security Module (HSM)", "FIPS 140-2 / AES-256")
System_Ext(WORM Audit Logging Service, "WORM Audit Logging Service", "Asynchronous secure logging")

Rel(Billing Management Service, Core Datastore, "PostgreSQL with CQRS")
Rel(Admission Management Service, Core Datastore, "PostgreSQL with CQRS")
Rel(Billing Management Service, Hardware Security Module (HSM), "FIPS 140-2 / AES-256")
Rel(Billing Management Service, WORM Audit Logging Service, "Asynchronous secure logging")

@enduml