@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Ingress Router, "Ingress Router", "Envoy / NGINX", "Provides high-performance ingress routing, payload sanitization, and TLS termination.")
    Component(Security Filter, "Security Filter", "Lua / WASM", "Executes low-latency JWT validation, MFA verification, and scope-based access checks.")
    Component(Rate Limiter, "Rate Limiter", "Redis (Cluster)", "Powers token-bucket rate limiting and distributed token revocation checks.")
}

Rel(Ingress Router, Security Filter, "Forwards requests for validation and authentication")
Rel(Security Filter, Rate Limiter, "Checks rate limits and token revocation")
@enduml