@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Clinical Workspace container

Container_Boundary(clinical_workspace, "Clinical Workspace") {
    Component(EMR_Presentation_Component, "EMR Presentation Component", "Kubernetes", "Handles EMR presentation and rendering for clinical workflows.")
    Component(Clinical_Data_Orchestrator, "Clinical Data Orchestrator", "Kubernetes", "Orchestrates clinical data processing and queries.")
    Component(Treatment_Prescription_Engine, "Treatment & Prescription Engine", "Kubernetes", "Manages medical treatments and digital prescription sign-offs.")
}

System_Ext(Core_Datastore, "Core Datastore", "PostgreSQL with CQRS")
System_Ext(Hardware_Security_Module_HSM, "Hardware Security Module (HSM)", "FIPS 140-2 Hardware")
System_Ext(WORM_Audit_Logging_Service, "WORM Audit Logging Service", "Secure Storage")

Rel(EMR_Presentation_Component, Clinical_Data_Orchestrator, "Communicates", "gRPC over mTLS")
Rel(Clinical_Data_Orchestrator, Core_Datastore, "Executes queries", "PostgreSQL Read Replicas using CQRS")
Rel(Treatment_Prescription_Engine, Hardware_Security_Module_HSM, "Performs cryptographic sign-offs", "FIPS 140-2 / AES-256")
Rel(Clinical_Data_Orchestrator, WORM_Audit_Logging_Service, "Emits compliance and break-glass events", "asynchronous secure logging")

@enduml