@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(core_datastore, "Core Datastore") {
    Component(PrimaryWriteDatastore, "Primary Write Datastore", "PostgreSQL Master", "Handles persistent write traffic for EMRs, patient admissions, and billing.")
    Component(ReadReplicas, "Read Replicas", "PostgreSQL Read Replicas", "Handles read traffic utilizing CQRS pattern to ensure sub-second EMR retrieval.")
}

Rel(PrimaryWriteDatastore, ReadReplicas, "Synchronizes data changes for read isolation and performance.", "PostgreSQL replication")
@enduml