@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Clinic Management System (CMS)

Person(Patients, "Patients", "Patients interacting with the clinic management system for scheduling and personal records.")
Person(Clinicians_Medical_Staff, "Clinicians / Medical Staff", "Medical professionals managing electronic medical records (EMRs) and patient care.")
Person(Administrative_Billing_Staff, "Administrative / Billing Staff", "Staff managing patient admissions, scheduling, and billing operations.")

System_Ext(External_Labs_Imaging, "External Labs/Imaging", "External systems providing laboratory and imaging results via FHIR APIs.")
System_Ext(Insurance_Payment_Gateways, "Insurance Payment Gateways", "External payment processors handling insurance billing and transactions.")
System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "External identity provider managing authentication, federation, and step-up MFA.")

System(Clinic_Management_System_CMS, "Clinic Management System (CMS)", "Manages patient admissions, EMRs, scheduling, and billing for healthcare facilities while ensuring strict HIPAA/GDPR compliance and 99.99% availability.")

System_Ext(API_Gateway, "API Gateway", "Manages incoming traffic and enforces security policies.")
System_Ext(Hardware_Security_Module_HSM, "Hardware Security Module (HSM)", "Provides FIPS 140-2 validated cryptographic operations and key management.")
System_Ext(WORM_Audit_Logging_Service, "WORM Audit Logging Service", "Provides asynchronous WORM auditing for compliance and security.")

Rel(Patients, Clinic_Management_System_CMS, "Accesses scheduling and portal features", "HTTPS (TLS 1.3), OAuth 2.0 / OIDC, MFA")
Rel(Clinicians_Medical_Staff, Clinic_Management_System_CMS, "Manages EMRs and patient care data", "HTTPS (TLS 1.3), OAuth 2.0 / OIDC, MFA")
Rel(Administrative_Billing_Staff, Clinic_Management_System_CMS, "Handles admissions, scheduling, and billing", "HTTPS (TLS 1.3), OAuth 2.0 / OIDC, MFA")
Rel(External_Labs_Imaging, Clinic_Management_System_CMS, "Exchanges clinical data and lab results", "HL7 FHIR RESTful APIs over HTTPS")
Rel(Insurance_Payment_Gateways, Clinic_Management_System_CMS, "Processes billing and payment transactions", "Secure API webhooks / REST")
Rel(Identity_Provider_IdP, Clinic_Management_System_CMS, "Authenticates users and provides federation", "OAuth 2.0 / OpenID Connect (OIDC)")
Rel(Clinic_Management_System_CMS, API_Gateway, "Routes and secures inbound/outbound traffic", "mTLS (Mutual TLS 1.3), ZTNA")
Rel(Clinic_Management_System_CMS, Hardware_Security_Module_HSM, "Performs cryptographic encryption and key operations", "FIPS 140-2 / AES-256")
Rel(Clinic_Management_System_CMS, WORM_Audit_Logging_Service, "Records immutable audit logs for compliance", "Asynchronous secure logging")

@enduml