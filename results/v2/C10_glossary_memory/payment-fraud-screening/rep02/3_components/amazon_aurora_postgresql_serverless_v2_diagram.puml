@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Amazon Aurora PostgreSQL Serverless v2", "Amazon Aurora PostgreSQL Serverless v2") {
    Component("Case Data Access Component", "Case Data Access Component", "PostgreSQL Data Access Library", "Handles relational mapping, query execution, and persistence of case management metadata and review actions.")
}

Rel("Case Management Container", "Case Data Access Component", "Executes queries and persists case data using PostgreSQL wire protocol over TLS 1.3")

@enduml