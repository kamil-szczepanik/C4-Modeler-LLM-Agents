@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Scoring_Service_Container", "Scoring Service Container") {
    Component("API_Handler_Component", "API Handler Component", "Go / AWS Fargate", "Handles incoming gRPC requests from the AWS API Gateway / Envoy Proxy and manages request validation.")
    Component("Scoring_Engine_Component", "Scoring Engine Component", "Go / AWS Fargate", "Executes real-time fraud scoring algorithms and interacts with Amazon ElastiCache for Redis.")
    Component("Audit_Dispatcher_Component", "Audit Dispatcher Component", "Go / AWS Fargate", "Dispatches audit logs and transaction details to AWS S3 Object Lock.")
    Component("Circuit_Breaker_Fallback_Manager_Component", "Circuit Breaker & Fallback Manager Component", "Go / AWS Fargate", "Manages fault tolerance, circuit breaking, and fallback behaviors during high load or partial outages.")
}

Rel("API_Handler_Component", "Scoring_Engine_Component", "Invokes scoring logic")
Rel("Scoring_Engine_Component", "Audit_Dispatcher_Component", "Triggers audit log dispatch")
Rel("API_Handler_Component", "Circuit_Breaker_Fallback_Manager_Component", "Monitors execution health")

@enduml