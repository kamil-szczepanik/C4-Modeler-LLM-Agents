@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container(scoring_service, "Scoring Service Container", "Go / AWS Fargate", "Executes containerized microservices for fraud scoring.")

Container_Boundary(redis_container, "Amazon ElastiCache for Redis") {
    Component(feature_store_engine, "Feature Store Engine", "In-Memory Cache Engine", "Delivers sub-millisecond lookups for feature storage.")
    Component(rules_cache_engine, "Rules Cache Engine", "In-Memory Cache Engine", "Caches hot rules for rapid evaluation.")
}

Rel(scoring_service, feature_store_engine, "Retrieves features", "RESP over TLS")
Rel(scoring_service, rules_cache_engine, "Retrieves hot rules", "RESP over TLS")

@enduml