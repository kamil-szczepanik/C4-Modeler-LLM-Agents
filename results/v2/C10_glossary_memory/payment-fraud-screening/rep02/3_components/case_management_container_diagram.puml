@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalyst, "Fraud Analyst & Risk Operations Manager", "Fraud analyst reviewing suspicious payments.")

Container_Boundary(CaseManagementContainer, "Case Management Container") {
    Component(CaseManagementAPIComponent, "Case Management API Component", "Node.js / TypeScript", "Powers analyst workflows, UI rendering, and processes case management requests.")
    Component(AuditComplianceWriterComponent, "Audit & Compliance Writer Component", "Node.js / TypeScript", "Captures structured audit logs and ensures PCI-DSS Level 1 compliance.")
    Component(AuthenticationAuthorizationMiddlewareComponent, "Authentication & Authorization Middleware Component", "Node.js / TypeScript", "Handles JWT validation, OIDC/OAuth2, and strict RBAC.")
}

System_Ext(AWSCognito, "AWS Cognito", "Managed Identity Provider handling JWT validation, OIDC/OAuth2, and strict RBAC.")
System_Ext(AmazonAuroraPostgreSQLServerlessv2, "Amazon Aurora PostgreSQL Serverless v2", "Relational database providing column-level encryption via AWS KMS for zero PAN footprint compliance.")
System_Ext(AmazonCloudWatch, "Amazon CloudWatch", "Centralized logging service capturing structured audit logs and metrics.")

Rel(FraudAnalyst, CaseManagementAPIComponent, "HTTPS/REST over TLS")
Rel(AuthenticationAuthorizationMiddlewareComponent, AWSCognito, "OIDC/OAuth2 verification")
Rel(CaseManagementAPIComponent, AmazonAuroraPostgreSQLServerlessv2, "PostgreSQL wire protocol over TLS with AWS KMS encryption")
Rel(AuditComplianceWriterComponent, AmazonCloudWatch, "Structured JSON over HTTPS")
@enduml