@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Real-Time Payment Fraud Screening System

Person(FraudAnalyst, "Fraud Analyst & Risk Operations Manager", "Internal users reviewing cases and updating rules.")
System_Ext(PaymentGateway, "Payment Gateway / Acquiring System", "External actor submitting authorization requests.")
System_Ext(ExternalFraudIntelligenceFeeds, "External Fraud Intelligence Feeds", "External sources providing risk data via webhooks.")
System_Ext(AWSAPIGatewayEnvoyProxy, "AWS API Gateway / Envoy Proxy", "Edge layer handling mTLS termination and traffic routing.")
System_Ext(AWSFargate, "AWS Fargate", "Containerized microservices executing fraud scoring and business logic.")
System_Ext(AWSCognito, "AWS Cognito", "Managed Identity Provider handling OIDC/OAuth2 authentication and RBAC.")
System_Ext(AWSS3ObjectLock, "AWS S3 Object Lock", "Immutable storage backend configured in Compliance Mode for audit logging.")
System_Ext(AWSKMS, "AWS KMS", "Cryptographic service managing envelope encryption and hardware-isolated keys.")

System(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System", "Processes card-not-present payment authorizations to detect fraud within a sub-50ms latency window while providing case management for analysts.")

Rel(PaymentGateway, AWSAPIGatewayEnvoyProxy, "Submits payment authorization requests", "gRPC over mTLS")
Rel(FraudAnalyst, AWSCognito, "Authenticates to the web frontend", "OIDC/OAuth2 over HTTPS/REST")
Rel(AWSFargate, AWSS3ObjectLock, "Archives scoring inputs and decisions", "AWS SDK (HTTPS)")
Rel(ExternalFraudIntelligenceFeeds, RealTimePaymentFraudScreeningSystem, "Ingests risk data", "HTTPS/REST webhooks")

@enduml