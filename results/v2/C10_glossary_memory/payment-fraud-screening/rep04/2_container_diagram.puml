@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Real-time Payment Fraud Screening Platform

Person(Fraud_Analyst, "Fraud Analyst", "Evaluates flagged transactions and manages cases.")

System_Ext(Payment_Gateway___Processor_Core, "Payment Gateway / Processor Core", "Core payment gateway routing authorization requests.")
System_Ext(Identity_Provider__IdP_, "Identity Provider (IdP)", "Provides authentication and OIDC services.")

System_Boundary(Real_time_Payment_Fraud_Screening_Platform, "Real-time Payment Fraud Screening Platform") {
    Container(Fraud_Scoring_API, "Fraud Scoring API", "Go, Embedded ONNX runtime", "Screens card-not-present payment authorizations for fraud in real-time.")
    Container(Case_Management_Backend, "Case Management Backend", "Node.js", "Provides backend services for fraud analyst workflows and case management.")
    Container(Case_Management_UI, "Case Management UI", "React", "Provides a user interface for fraud analysts reviewing suspicious payments.")
    ContainerDb(Audit___Event_Store, "Audit & Event Store", "AWS Aurora PostgreSQL", "Provides tamper-evident, 7-year append-only audit data retention.")
}

Rel(Payment_Gateway___Processor_Core, Fraud_Scoring_API, "Requests real-time fraud scoring", "gRPC / mTLS")
Rel(Fraud_Analyst, Case_Management_UI, "Accesses case management for fraud review", "HTTPS / OIDC")
Rel(Fraud_Scoring_API, Audit___Event_Store, "Persists audit events and logs", "TCP/TLS")
Rel(Case_Management_Backend, Audit___Event_Store, "Persists case data and audit logs", "TCP/TLS")
Rel(Case_Management_UI, Case_Management_Backend, "Sends API requests for case management workflows", "HTTPS")

@enduml