@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Real-time Payment Fraud Screening Platform

Person(FraudAnalyst, "Fraud Analyst", "Evaluates flagged transactions and manages cases.")
Person(RiskOperationsManagerDataScientist, "Risk Operations Manager / Data Scientist", "Manages rules, models, and overall risk operations.")
System_Ext(PaymentProcessorMerchantSystems, "Payment Processor / Merchant Systems", "External customer systems sending transaction data.")
System_Ext(PaymentGatewayProcessorCore, "Payment Gateway / Processor Core", "Core payment gateway routing authorization requests.")
System_Ext(IdentityPoviderIdP, "Identity Provider (IdP)", "Provides authentication and OIDC services.")

System(RealtimePaymentFraudScreeningPlatform, "Real-time Payment Fraud Screening Platform", "A real-time payment fraud screening platform that evaluates card-not-present transactions, provides case management for fraud analysts, blocks fraudulent transactions, and maintains immutable audit logs while complying with PCI-DSS Level 1.")

Rel(PaymentProcessorMerchantSystems, RealtimePaymentFraudScreeningPlatform, "Submits card-not-present transactions for evaluation", "REST / gRPC")
Rel(FraudAnalyst, RealtimePaymentFraudScreeningPlatform, "Accesses case management for fraud review", "HTTPS / OIDC")
Rel(PaymentGatewayProcessorCore, RealtimePaymentFraudScreeningPlatform, "Requests real-time fraud scoring", "gRPC / mTLS")

@enduml