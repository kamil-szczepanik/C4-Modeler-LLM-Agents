@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalyst, "Fraud Analyst", "Reviews suspicious payment transactions.")
System_Ext(IdentityPoviderIdP, "Identity Provider (IdP)", "External OIDC Identity Provider.")
System(CaseManagementBackend, "Case Management Backend", "Node.js Container", "Handles backend logic, queues, and database operations.")

Container_Boundary(CaseManagementUI, "Case Management UI") {
    Component(AuthenticationWrapperComponent, "Authentication Wrapper Component", "React / OIDC", "Manages OIDC session and authenticates the session.")
    Component(DashboardQueueViewComponent, "Dashboard & Queue View Component", "React SPA", "Fetches prioritized queues and SLA metrics.")
    Component(CaseDetailExplainabilityViewComponent, "Case Detail & Explainability View Component", "React SPA", "Retrieves transaction details and model feature attributions.")
    Component(ActionAuditLoggerComponent, "Action & Audit Logger Component", "React SPA", "Submits analyst decisions and audit payloads.")
}

Rel(FraudAnalyst, AuthenticationWrapperComponent, "Authenticates session", "HTTPS / OIDC")
Rel(AuthenticationWrapperComponent, IdentityPoviderIdP, "Manages OIDC session", "HTTPS / OIDC")
Rel(DashboardQueueViewComponent, CaseManagementBackend, "Fetches prioritized queues and SLA metrics", "HTTPS / REST")
Rel(CaseDetailExplainabilityViewComponent, CaseManagementBackend, "Retrieves transaction details and model feature attributions", "HTTPS / REST")
Rel(ActionAuditLoggerComponent, CaseManagementBackend, "Submits analyst decisions and audit payloads", "HTTPS / REST")

@enduml