@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(fraud_scoring_api, "Fraud Scoring API") {
    Component(api_router_validator, "API Router & Validator", "Go", "Routes incoming requests and validates payloads.")
    Component(feature_assembler, "Feature Assembler", "Go", "Assembles the feature vector required for inference.")
    Component(inference_engine, "Inference Engine", "Go, Embedded ONNX Runtime", "Executes machine learning models locally in-process to score transactions.")
    Component(audit_dispatcher, "Audit Dispatcher", "Go", "Emits scoring results, explanations, and model versions asynchronously.")
}

Rel(api_router_validator, feature_assembler, "Passes sanitized request and correlation ID", "Go method call")
Rel(feature_assembler, inference_engine, "Passes assembled feature vector", "Go method call")
Rel(inference_engine, audit_dispatcher, "Emits scoring result, explanation, and model version", "Go channel / async")

@enduml