@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(case_management_backend, "Case Management Backend") {
    Component(api_router_controller, "API Router / Controller", "Node.js with Express", "Routes API requests for case workflows and validates JWTs.")
    Component(case_service, "Case Service", "Node.js", "Handles case workflows and business logic.")
    Component(case_analytics_metrics_service, "Case Analytics & Metrics Service", "Node.js", "Requests KPI reports and queries historical case data.")
    Component(audit_logger_component, "Audit Logger Component", "Node.js", "Maintains tamper-evident audit logs.")
}

Rel(api_router_controller, case_service, "Routes case workflows", "Internal")
Rel(api_router_controller, case_analytics_metrics_service, "Requests KPI reports", "Internal")
@enduml