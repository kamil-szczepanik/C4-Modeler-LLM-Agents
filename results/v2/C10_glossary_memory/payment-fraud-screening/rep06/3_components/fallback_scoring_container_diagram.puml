@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(fallback_scoring_container, "Fallback Scoring Container") {
    Component(Heuristic_Evaluator, "Heuristic Evaluator", "Python / FastAPI", "Executes simplified heuristic rules during primary outages to maintain baseline fraud screening.")
    Component(Fallback_API_Handler, "Fallback API Handler", "FastAPI Routing", "Receives fallback scoring requests via HTTPS over mTLS from the primary scoring engine.")
}

Rel(Fallback_API_Handler, Heuristic_Evaluator, "Delegates requests for heuristic evaluation", "")

@enduml