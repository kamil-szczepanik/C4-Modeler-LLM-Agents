@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(ComplianceAuditOfficer, "Compliance & Audit Officer", "Performs compliance reviews and audit sign-offs.")
Person(RiskManager, "Risk Manager", "Monitors portfolio risk metrics and aggregated reports.")

System_Ext(AWSS3ObjectLock, "AWS S3 Object Lock", "Provides tamper-evident WORM storage for 7-year auditability.")

Container_Boundary(AuditReportingContainer, "Audit Reporting Container") {
    Component(AuditUIComponent, "Audit UI Component", "Express.js / React SSR", "Provides secure dashboards and export packages for compliance officers and risk managers.")
    Component(QueryAggregationComponent, "Query & Aggregation Component", "TypeScript", "Queries historical decisions and Parquet-compacted data via Athena.")
    Component(S3AccessComponent, "S3 Access Component", "AWS SDK for JavaScript", "Retrieves WORM-compliant logs securely.")
    Component(RegulatoryExceptionComponent, "Regulatory Exception Component", "TypeScript", "Attaches compliance sign-offs, overrides, and writes immutable exception sidecar objects.")
}

Rel(ComplianceAuditOfficer, AuditUIComponent, "Interacts for secure dashboards and export packages", "HTTPS")
Rel(RiskManager, AuditUIComponent, "Monitors portfolio risk metrics and aggregated reports", "HTTPS")
Rel(ComplianceAuditOfficer, RegulatoryExceptionComponent, "Attaches compliance sign-offs and overrides", "HTTPS")
Rel(QueryAggregationComponent, AWSS3ObjectLock, "Queries historical decisions and Parquet-compacted data via Athena", "AWS SDK / Athena / S3 API")
Rel(RegulatoryExceptionComponent, AWSS3ObjectLock, "Writes immutable exception sidecar objects", "AWS SDK / S3 API")
Rel(S3AccessComponent, AWSS3ObjectLock, "Retrieves WORM-compliant logs securely", "AWS SDK / S3 API")

@enduml