@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Scoring Engine Container container

Container_Boundary(scoring_engine_container, "Scoring Engine Container") {
    Component(API Ingress Component, "API Ingress Component", "Rust / Tonic gRPC", "Receives incoming payment authorization requests and enforces protocol security.")
    Component(Token Resolution Component, "Token Resolution Component", "Rust / Reqwest", "Securely resolves tokens against the external CDE/Tokenization Vault.")
    Component(Rule & Model Execution Component, "Rule & Model Execution Component", "Rust / Native Eval", "Executes cryptographic rules and models for low-latency scoring.")
    Component(Audit Dispatcher Component, "Audit Dispatcher Component", "Rust / Tokio async channel", "Dispatches decision inputs and audit logs asynchronously.")
    Component(Circuit Breaker & Fallback Coordinator Component, "Circuit Breaker & Fallback Coordinator Component", "Rust / custom Tokio-native wrapper", "Manages resilience, handling failover to the Fallback Scoring Container during primary outages.")
}

Rel(API Ingress Component, Token Resolution Component, "Forwards token data for resolution", "gRPC")
Rel(Token Resolution Component, Rule & Model Execution Component, "Passes resolved transaction data for scoring", "Internal")
Rel(Rule & Model Execution Component, Audit Dispatcher Component, "Sends scoring results and decision inputs for auditing", "Async Channel")
Rel(Rule & Model Execution Component, Circuit Breaker & Fallback Coordinator Component, "Monitors scoring health and coordinates fallbacks if needed", "Internal")

@enduml