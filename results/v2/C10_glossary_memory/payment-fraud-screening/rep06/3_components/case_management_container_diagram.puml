@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalyst, "Fraud Analyst", "Reviews cases and manages fraud rules via internal reporting tooling.")
Person(RiskManager, "Risk Manager", "Monitors risk metrics and system performance via internal tooling.")

System_Ext(AWSSQS, "AWS SQS", "Enables decoupled, asynchronous ingestion of suspicious transactions with Dead-Letter Queue support.")
Container(ScoringEngineContainer, "Scoring Engine Container", "Rust / Tokio, AWS ECS Fargate", "Handles high-throughput, low-latency real-time fraud scoring for payment authorizations.")

Container_Boundary(CaseManagementContainer, "Case Management Container") {
    Component(CaseUIComponent, "Case UI Component", "React / TypeScript SPA via AWS S3/CloudFront", "Delivers responsive single-page application dashboards for case reviews and monitoring.")
    Component(CaseAPIComponent, "Case API Component", "Node.js / Express on AWS ECS Fargate", "Handles backend requests and business logic for case management workflows.")
    Component(CaseIngestionWorkerComponent, "Case Ingestion Worker Component", "Node.js / TypeScript on AWS ECS Fargate", "Ingests suspicious transactions asynchronously for fraud analyst reviews.")
    Component(CaseDatabaseComponent, "Case Database Component", "AWS Aurora Serverless v2 PostgreSQL", "Provides cost-effective, auto-scaling relational storage for case reviews and audit logs.")
}

Rel(FraudAnalyst, CaseUIComponent, "HTTPS Web UI")
Rel(RiskManager, CaseUIComponent, "HTTPS Web UI")
Rel(FraudAnalyst, CaseAPIComponent, "HTTPS / REST over TLS 1.3")
Rel(RiskManager, CaseAPIComponent, "HTTPS / REST over TLS 1.3")
Rel(CaseAPIComponent, CaseDatabaseComponent, "PostgreSQL Wire Protocol over TLS 1.3")
Rel(ScoringEngineContainer, CaseIngestionWorkerComponent, "AWS SQS over TLS 1.3 with AWS KMS")
Rel(CaseIngestionWorkerComponent, CaseDatabaseComponent, "PostgreSQL Wire Protocol over TLS 1.3")

@enduml