@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalyst, "Fraud Analyst", "Reviews cases and manages fraud rules via internal reporting tooling.")
Person(RiskManager, "Risk Manager", "Monitors risk metrics and system performance via internal tooling.")
Person(ComplianceAuditOfficer, "Compliance & Audit Officer", "Ensures regulatory compliance and audits historical transaction logs.")

System_Ext(PaymentGatewayCoreProcessingSystem, "Payment Gateway / Core Processing System", "Sends card-not-present payment authorization requests.")
System_Ext(ExternalCardholderDataEnvironmentCDETokenizationVault, "External Cardholder Data Environment (CDE) / Tokenization Vault", "Resolves tokens securely via APIs to ensure raw PANs never enter application memory.")
System_Ext(AWSS3ObjectLock, "AWS S3 Object Lock", "Provides WORM-compliant tamper-evident storage for 7-year auditability.")
System_Ext(DynamicRuleModelRegistry, "Dynamic Rule & Model Registry", "Stores cryptographically signed rules and models hot-loaded via AWS KMS.")

System(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System", "Screens card-not-present payment authorizations at 3,000 TPS to protect merchant revenue while supporting case reviews and compliance, ensuring sub-50ms P99 latency.")

Rel(PaymentGatewayCoreProcessingSystem, RealTimePaymentFraudScreeningSystem, "Sends authorization requests", "gRPC/REST over TLS 1.3 with mTLS and OAuth2/JWT")
Rel(RealTimePaymentFraudScreeningSystem, ExternalCardholderDataEnvironmentCDETokenizationVault, "Resolves tokens securely", "Secure APIs")
Rel(RealTimePaymentFraudScreeningSystem, DynamicRuleModelRegistry, "Cryptographically validates and hot-loads signed rules", "AWS KMS")
Rel(RealTimePaymentFraudScreeningSystem, AWSS3ObjectLock, "Writes decision inputs, model versions, and explanations to append-only storage", "WORM storage")
Rel(FraudAnalyst, RealTimePaymentFraudScreeningSystem, "Interacts for case reviews and reporting", "HTTPS Web UI and internal reporting tooling")
Rel(RiskManager, RealTimePaymentFraudScreeningSystem, "Interacts for risk monitoring and reporting", "HTTPS Web UI and internal reporting tooling")
Rel(ComplianceAuditOfficer, RealTimePaymentFraudScreeningSystem, "Interacts for compliance audits and reporting", "HTTPS Web UI and internal reporting tooling")

@enduml