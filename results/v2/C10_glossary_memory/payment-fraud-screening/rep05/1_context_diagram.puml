@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(PaymentMerchantsEndConsumers, "Payment Merchants / End Consumers", "External users initiating transactions.")
Person(FraudAnalystsRiskComplianceOfficers, "Fraud Analysts & Risk/Compliance Officers", "Internal personnel reviewing flagged cases and ensuring regulatory compliance.")
Person(RiskDataScientists, "Risk / Data Scientists", "Internal users updating fraud rules and ML models.")

System_Ext(PaymentGatewayAcquirer, "Payment Gateway / Acquirer", "External system submitting authorization requests.")
System_Ext(CardNetworksTokenizationVault, "Card Networks / Tokenization Vault", "External provider supplying tokenized card data.")
System_Ext(IdentityProviderIdP, "Identity Provider (IdP)", "External system managing OAuth2/SAML authentication.")

System(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System", "A real-time fraud screening system for card-not-present payment authorizations that approves, declines, or flags suspicious transactions while maintaining PCI-DSS Level 1 compliance.")

Rel(PaymentGatewayAcquirer, RealTimePaymentFraudScreeningSystem, "Submits real-time authorization requests", "HTTPS / gRPC")
Rel(FraudAnalystsRiskComplianceOfficers, RealTimePaymentFraudScreeningSystem, "Reviews flagged cases via the Case Management UI", "HTTPS via TLS 1.3")
Rel(RealTimePaymentFraudScreeningSystem, CardNetworksTokenizationVault, "Performs token resolution", "HTTPS via mTLS")
Rel(RealTimePaymentFraudScreeningSystem, IdentityProviderIdP, "Handles authentication", "HTTPS via mTLS")
Rel(RiskDataScientists, RealTimePaymentFraudScreeningSystem, "Deploys secure model and rule artifacts", "HTTPS / AWS IAM")

@enduml