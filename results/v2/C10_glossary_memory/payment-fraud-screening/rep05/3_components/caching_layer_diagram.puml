@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container(FraudScoringEngineContainer, "Fraud Scoring Engine Container", "Go or Rust", "Evaluates card-not-present payment authorizations.")

Container_Boundary(CachingLayer, "Caching Layer") {
    Component(FeatureStoreCacheComponent, "Feature Store Cache Component", "Amazon ElastiCache with Redis OSS", "Provides low-latency feature lookups for the fraud scoring engine.")
    Component(RateLimiterComponent, "Rate Limiter Component", "Amazon ElastiCache with Redis OSS", "Enforces sliding window rate limiting for incoming authorization requests.")
}

Rel(FraudScoringEngineContainer, FeatureStoreCacheComponent, "Redis Protocol")
Rel(FraudScoringEngineContainer, RateLimiterComponent, "Redis Protocol")
@enduml