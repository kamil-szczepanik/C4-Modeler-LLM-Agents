@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(RiskDataScientists, "Risk / Data Scientists", "Data scientist or risk analyst role.")
System_Ext(IdentityPoviderIdP, "Identity Provider (IdP)", "External Identity Provider.")
System_Ext(FraudScoringEngineContainer, "Fraud Scoring Engine Container", "Scores payment transactions.")

Container_Boundary(ModelRegistryContainer, "Model Registry Container") {
    Component(ModelRegistryAPI, "Model Registry API", "MLflow API / Python", "Manages ML model artifacts, metadata, and versioning for zero-downtime updates.")
    Component(ModelStorageSynchronizer, "Model Storage Synchronizer", "AWS SDK / S3 Storage Integration", "Synchronizes cached model weights and rules to the Fraud Scoring Engine Container via S3 memory caching.")
}

Rel(RiskDataScientists, ModelRegistryAPI, "Uploads and manages fraud rules and ML models", "HTTPS / AWS IAM")
Rel(ModelRegistrySynchronizer, FraudScoringEngineContainer, "Pushes/caches model artifacts", "S3 memory caching")
Rel(ModelRegistryAPI, IdentityPoviderIdP, "Authenticates API requests", "HTTPS via mTLS / OAuth2/SAML")

@enduml