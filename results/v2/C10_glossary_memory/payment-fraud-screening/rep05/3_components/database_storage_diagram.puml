@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(database_storage, "Database & Storage") {
    Component(Amazon_Aurora_Serverless_v2_DB_Instance, "Amazon Aurora Serverless v2 DB Instance", "Amazon Aurora PostgreSQL with pgcrypto", "Stores transactional and audit data with append-only tables and immutable cryptographic triggers.")
    Component(AWS_RDS_Proxy, "AWS RDS Proxy", "AWS RDS Proxy", "Manages connection pooling for high-throughput concurrency from microservices.")
}

Rel(AWS_RDS_Proxy, Amazon_Aurora_Serverless_v2_DB_Instance, "Proxies and pools database connections")

@enduml