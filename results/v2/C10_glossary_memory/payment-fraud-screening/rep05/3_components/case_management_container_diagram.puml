@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalysts, "Fraud Analysts & Risk/Compliance Officers", "Users performing case management and fraud reviews.")

Container_Boundary(case_management_container, "Case Management Container") {
    Component(CaseManagementUI, "Case Management UI", "React SPA on Amazon S3 / CloudFront", "Delivers a secure, high-performance analyst interface.")
    Component(CaseAPIRouter, "Case API Router", "Node.js Express/Fastify", "Routes case management API requests from the frontend to internal services.")
    Component(AnalystActionService, "Analyst Action Service", "Node.js/Python", "Handles actions performed by fraud analysts on cases.")
    Component(CaseSearchFilterService, "Case Search & Filter Service", "Node.js/Python", "Provides searching and filtering capabilities for case data.")
    Component(BatchProcessingCoordinator, "Batch Processing Coordinator", "Node.js/Python", "Coordinates batch processing tasks for case management.")
}

ContainerDb(DatabaseStorage, "Database & Storage", "Amazon Aurora Serverless v2", "Provides auto-scaling transactional storage.")

Rel(FraudAnalysts, CaseManagementUI, "HTTPS via TLS 1.3")
Rel(CaseManagementUI, CaseAPIRouter, "HTTPS via TLS 1.3 (JSON/REST)")
Rel(CaseAPIRouter, AnalystActionService, "Internal function calls")
Rel(CaseAPIRouter, CaseSearchFilterService, "Internal function calls")
Rel(CaseAPIRouter, BatchProcessingCoordinator, "Internal function calls")
Rel(AnalystActionService, DatabaseStorage, "PostgreSQL Wire Protocol")
Rel(CaseSearchFilterService, DatabaseStorage, "PostgreSQL Wire Protocol")
Rel(BatchProcessingCoordinator, DatabaseStorage, "PostgreSQL Wire Protocol")

@enduml