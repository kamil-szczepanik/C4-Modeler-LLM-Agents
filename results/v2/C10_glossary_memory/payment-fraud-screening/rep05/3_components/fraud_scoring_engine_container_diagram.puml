@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(Fraud_Scoring_Engine_Container, "Fraud Scoring Engine Container") {
    Component(Ingress_Router_Component, "Ingress Router Component", "Go / Rust", "Routes incoming authorization requests and handles initial protocol parsing.")
    Component(Feature_Aggregator_Component, "Feature Aggregator Component", "Go / Rust", "Fetches user and device features from the caching layer for real-time evaluation.")
    Component(Execution___Scoring_Component, "Execution & Scoring Component", "Go / Rust", "Evaluates scoring rules and ML models to deliver sub-50ms fraud decisions.")
    Component(Audit___Persistence_Dispatcher_Component, "Audit & Persistence Dispatcher Component", "Go / Rust", "Dispatches transactional and audit data to the database storage asynchronously.")
    Component(Fallback_Circuit_Breaker_Component, "Fallback Circuit Breaker Component", "Go / Rust", "Provides robust fallback mechanisms to ensure high availability during partial failures.")
}

Rel(Ingress_Router_Component, Feature_Aggregator_Component, "Forwards parsed transactions to gather features", "")
Rel(Feature_Aggregator_Component, Execution___Scoring_Component, "Provides aggregated features for scoring", "")
Rel(Execution___Scoring_Component, Audit___Persistence_Dispatcher_Component, "Sends scoring results for persistence", "")
Rel(Fallback_Circuit_Breaker_Component, Execution___Scoring_Component, "Monitors and intercepts calls to handle faults", "")

@enduml