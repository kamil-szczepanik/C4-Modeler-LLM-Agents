@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Real-Time Payment Fraud Screening System

Person(FraudAnalyst, "Fraud Analyst", "Reviews flagged cases and manages fraud investigations.")

System_Ext(MerchantPaymentGateway, "Merchant / Payment Gateway", "Submits card-not-present payment authorizations for fraud screening.")
System_Ext(IdentityPoviderIdP, "Identity Provider (IdP)", "Secures authentication, RBAC, and hardware-backed MFA for analysts.")
System_Ext(AWSAuditComplianceStore, "AWS Audit & Compliance Store", "Stores tamper-evident WORM audit retention data.")
System_Ext(CICDModelRegistryPipeline, "CI/CD & Model Registry Pipeline", "Manages continuous integration, delivery, and model registry.")

System_Boundary(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System") {
    Container(DecisionAPIContainer, "Decision API Container", "Go, AWS Fargate", "Powers the Decision API for high-performance and low-latency authorization checks.")
    Container(ScoringEngineContainer, "Scoring Engine Container", "Python, FastAPI, AWS Fargate", "Powers the Scoring Engine for ML model inference.")
    Container(CaseManagementPortalContainer, "Case Management Portal Container", "AWS Fargate", "Provides case management interfaces for fraud analysts.")
    ContainerDb(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Stores transactional case data with read replicas.")
}

Rel(MerchantPaymentGateway, DecisionAPIContainer, "Sends payment authorizations for fraud screening", "gRPC / HTTPS")
Rel(DecisionAPIContainer, ScoringEngineContainer, "Requests scoring and model inference", "Internal VPC gRPC / mTLS")
Rel(FraudAnalyst, CaseManagementPortalContainer, "Performs case management and analyst reviews", "HTTPS (TLS 1.3)")
Rel(CaseManagementPortalContainer, IdentityPoviderIdP, "Authenticates users via OIDC/OAuth2", "OIDC / OAuth2")
Rel(ScoringEngineContainer, AWSAuditComplianceStore, "Saves audit logs for tamper-evident compliance", "HTTPS / S3 API")

@enduml