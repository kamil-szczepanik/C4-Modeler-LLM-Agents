@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Scoring Engine Container container

System_Ext(CI_CD_Model_Registry_Pipeline, "CI/CD & Model Registry Pipeline", "External system")
System_Ext(AWS_Audit_Compliance_Store, "AWS Audit & Compliance Store", "External system")

Container_Boundary(scoring_engine_container, "Scoring Engine Container") {
    Component(Inference_API_Controller, "Inference API Controller", "Python, FastAPI", "Exposes the scoring engine API endpoints and routes incoming scoring requests.")
    Component(Model_Registry_Sync_Agent, "Model Registry Sync Agent", "Python", "Synchronizes machine learning models from the model registry pipeline.")
    Component(Model_Execution_Engine, "Model Execution Engine", "Python, ONNX Runtime / Triton Inference Server", "Executes ML model inference using ONNX Runtime C-API for low latency.")
    Component(Feature_Extraction_Component, "Feature Extraction Component", "Python", "Extracts and transforms features required for model inference in-memory.")
    Component(Explanation_Generation_Component, "Explanation Generation Component", "Python", "Generates model explanations asynchronously for audit and compliance.")
}

Rel(Inference_API_Controller, Feature_Extraction_Component, "In-Memory Function Call", "In-Memory")
Rel(Inference_API_Controller, Model_Execution_Engine, "In-Memory Function Call / ONNX Runtime C-API", "In-Memory")
Rel(Model_Execution_Engine, Explanation_Generation_Component, "In-Memory Function Call", "In-Memory")
Rel(Model_Registry_Sync_Agent, CI_CD_Model_Registry_Pipeline, "HTTPS / S3 API", "HTTPS / S3")
Rel(scoring_engine_container, AWS_Audit_Compliance_Store, "HTTPS / S3 API", "HTTPS / S3")

@enduml