@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Decision API Container container

Person_Ext(Merchant_Payment_Gateway, "Merchant / Payment Gateway", "External payment system")
System_Ext(Scoring_Engine_Container, "Scoring Engine Container", "Python, FastAPI, AWS Fargate")
System_Ext(AWS_Audit_Compliance_Store, "AWS Audit & Compliance Store", "Secure external storage")
System_Ext(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL")

Container_Boundary(Decision_API_Container, "Decision API Container") {
    Component(API_Handler_Component, "API Handler Component", "Go", "Handles incoming authorization requests and orchestrates calls to internal components.")
    Component(Circuit_Breaker_Fallback_Manager, "Circuit Breaker & Fallback Manager", "Go", "Manages fault tolerance and fallbacks under strict latency constraints.")
    Component(Audit_Dispatcher_Component, "Audit Dispatcher Component", "Go", "Dispatches audit logs and compliance records to external secure storage.")
}

Rel(Merchant_Payment_Gateway, API_Handler_Component, "gRPC / HTTPS")
Rel(API_Handler_Component, Scoring_Engine_Container, "Internal VPC gRPC / mTLS")
Rel(API_Handler_Component, Circuit_Breaker_Fallback_Manager, "Internal")
Rel(API_Handler_Component, Amazon_Aurora_PostgreSQL, "TLS / SQL")
Rel(Audit_Dispatcher_Component, AWS_Audit_Compliance_Store, "HTTPS / S3 API")

@enduml