@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Boundary(amazon_aurora_postgresql, "Amazon Aurora PostgreSQL") {
    Component(Transactional_Database_Store, "Transactional Database Store", "Amazon Aurora PostgreSQL, pgAudit, RDS Proxy", "Stores transactional case data, utilizing read replicas, RDS Proxy, and pgAudit extension for mandatory compliance logging and sub-50ms latency.")
}

Container(Decision_API_Container, "Decision API Container", "Go, AWS Fargate", "Handles incoming authorization requests and coordinates fraud checks.")
Container(Scoring_EngineContainer, "Scoring Engine Container", "Python, FastAPI, AWS Fargate", "Performs machine learning inference for risk scoring.")
Container(Case_Management_Portal_Container, "Case Management Portal Container", "AWS Fargate", "Provides fraud analysts with case management tools.")

Rel(Decision_API_Container, Transactional_Database_Store, "Reads and writes transactional authorization and case data via RDS Proxy", "RDS Proxy / SQL")
Rel(Scoring_EngineContainer, Transactional_Database_Store, "Accesses feature stores and case metadata", "SQL")
Rel(Case_Management_Portal_Container, Transactional_Database_Store, "Queries and updates fraud investigation cases", "SQL")

@startuml