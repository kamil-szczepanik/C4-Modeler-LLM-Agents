@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Fraud Analyst, "Fraud Analyst", "Reviews flagged cases and manages fraud investigations.")
System_Ext(Identity Provider (IdP), "Identity Provider (IdP)", "Secures authentication, RBAC, and hardware-backed MFA for analysts.")
ContainerDb(Amazon Aurora PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Stores transactional case data with read replicas.")
System_Ext(AWS Audit & Compliance Store, "AWS Audit & Compliance Store", "HTTPS / S3 API", "Stores tamper-evident WORM audit retention data.")
System_Ext(AWS CloudWatch / Observability Platform, "AWS CloudWatch / Observability Platform", "HTTPS / AWS SDK", "Provides centralized observability and distributed tracing.")

Container_Boundary(Case Management Portal Container, "Case Management Portal Container") {
    Component(UI Presentation Component, "UI Presentation Component", "React/TypeScript, Nginx", "Powers the UI Presentation Component with strict CSP headers and client-side card data masking.")
    Component(Case Management API Component, "Case Management API Component", "Node.js/TypeScript", "Powers the Case Management API Component for efficient asynchronous case workflow handling.")
    Component(Audit Logging Component, "Audit Logging Component", "AWS KMS (AES-256)", "Secures local disk buffers and encrypted storage for tamper-evident compliance audit trails.")
}

Rel(Fraud Analyst, UI Presentation Component, "HTTPS (TLS 1.3)")
Rel(UI Presentation Component, Case Management API Component, "HTTPS (JSON/REST)")
Rel(Case Management API Component, Amazon Aurora PostgreSQL, "SQL / TLS")
Rel(Case Management API Component, AWS Audit & Compliance Store, "HTTPS / S3 API")
Rel(Case Management API Component, AWS CloudWatch / Observability Platform, "HTTPS / AWS SDK")
Rel(UI Presentation Component, Identity Provider (IdP), "OIDC / OAuth2")
@enduml