@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalyst, "Fraud Analyst", "Reviews flagged cases and manages fraud investigations.")
Person(RiskComplianceOfficer, "Risk & Compliance Officer", "Oversees risk management and compliance with regulatory standards.")

System_Ext(MerchantPaymentGateway, "Merchant / Payment Gateway", "Submits card-not-present payment authorizations for fraud screening.")
System_Ext(PaymentProcessingCoreAcquirer, "Payment Processing Core / Acquirer", "Processes payments and integrates with the screening system.")
System_Ext(IdentityProviderIdP, "Identity Provider (IdP)", "Secures authentication, RBAC, and hardware-backed MFA for analysts.")
System_Ext(AWSAuditComplianceStore, "AWS Audit & Compliance Store", "Stores tamper-evident WORM audit retention data.")
System_Ext(NotificationAlertingService, "Notification / Alerting Service", "Handles alerts and notifications.")
System_Ext(AWSCloudWatchObservabilityPlatform, "AWS CloudWatch / Observability Platform", "Provides centralized observability and distributed tracing.")
System_Ext(CICDModelRegistryPipeline, "CI/CD & Model Registry Pipeline", "Manages continuous integration, delivery, and model registry.")

System(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System", "Screens card-not-present payment authorizations for fraud before approval and provides case management for analyst reviews.")

Rel(MerchantPaymentGateway, RealTimePaymentFraudScreeningSystem, "Sends payment authorizations for fraud screening", "gRPC / HTTPS")
Rel(FraudAnalyst, RealTimePaymentFraudScreeningSystem, "Performs case management and analyst reviews", "HTTPS (TLS 1.3)")
Rel(RealTimePaymentFraudScreeningSystem, AWSAuditComplianceStore, "Saves audit logs for 7-year retention", "HTTPS / S3 API")
Rel(RealTimePaymentFraudScreeningSystem, NotificationAlertingService, "Triggers notifications and alerts", "API")
Rel(PaymentProcessingCoreAcquirer, RealTimePaymentFraudScreeningSystem, "Communicates payment and screening data securely", "mTLS")

@enduml