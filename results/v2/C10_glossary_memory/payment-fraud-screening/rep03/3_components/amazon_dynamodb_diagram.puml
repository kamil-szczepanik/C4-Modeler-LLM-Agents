@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System(Scoring_Engine, "Scoring Engine", "Java, Spring Boot, gRPC")

Container_Boundary(Amazon_DynamoDB, "Amazon DynamoDB") {
    Component(Amazon_DynamoDB, "Amazon DynamoDB", "Amazon DynamoDB", "Low-latency NoSQL feature store providing sub-10ms lookups via On-Demand billing.")
}

Rel(Scoring_Engine, Amazon_DynamoDB, "AWS SDK / HTTPS over AWS PrivateLink", "AWS SDK / HTTPS over AWS PrivateLink")

@enduml