@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management Service container

Container_Boundary("case_management_service", "Case Management Service") {
    Component("Case Management API Controller", "Case Management API Controller", "Node.js (Express)", "Exposes REST endpoints for fraud analysts and risk managers to review cases and update investigation statuses.")
    Component("Case Management UI", "Case Management UI", "React", "Web frontend serving the risk operations dashboard via Amazon CloudFront and S3.")
    Component("Case Business Logic Service", "Case Business Logic Service", "Node.js Service", "Orchestrates case workflows, communicates with the Scoring Engine via gRPC, and logs audit events.")
}

System_Ext("Scoring Engine", "Scoring Engine", "Scoring Engine container")
System_Ext("AWS S3 Object Lock", "AWS S3 Object Lock", "AWS S3 Object Lock storage")

Rel("Case Management UI", "Case Management API Controller", "Sends HTTPS API requests for case data", "HTTPS")
Rel("Case Management API Controller", "Case Business Logic Service", "Delegates workflow requests", "")
Rel("Case Business Logic Service", "Scoring Engine", "Queries scoring details via gRPC", "gRPC")
Rel("Case Business Logic Service", "AWS S3 Object Lock", "Persists tamper-evident audit logs via AWS API", "AWS API, HTTPS")

@enduml