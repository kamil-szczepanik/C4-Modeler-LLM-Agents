@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System(Scoring Engine, "Scoring Engine", "Java (Spring Boot / gRPC) on AWS ECS on Fargate")

Container_Boundary(aws_s3_object_lock, "AWS S3 Object Lock") {
    Component(Audit Log Storage API, "Audit Log Storage API", "AWS S3 API / Object Lock", "Provides tamper-evident, 7-year audit retention in Compliance Mode for transaction logs.")
}

Rel(Scoring Engine, Audit Log Storage API, "Writes audit logs", "AWS API")
@enduml