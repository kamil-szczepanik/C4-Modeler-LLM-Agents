@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Scoring Engine container

Container_Boundary(scoring_engine, "Scoring Engine") {
    Component(grpc_ingress_handler, "gRPC Ingress Handler", "Java (Spring Boot / gRPC)", "Handles incoming gRPC requests from the AWS Application Load Balancer.")
    Component(feature_evaluator_component, "Feature Evaluator Component", "Java", "Evaluates features by retrieving data from Amazon DynamoDB.")
    Component(ml_inference_rule_engine_component, "ML Inference & Rule Engine Component", "Java / ONNX Runtime", "Performs machine learning inference and rule evaluation with a Shadow Evaluation Router.")
    Component(audit_dispatcher_component, "Audit Dispatcher Component", "Java", "Dispatches audit logs to AWS S3 Object Lock via AWS API.")
}

System_Ext(amazon_dynamodb, "Amazon DynamoDB", "Low-latency feature store for transaction evaluation.")
System_Ext(aws_s3_object_lock, "AWS S3 Object Lock", "Tamper-evident, 7-year audit storage.")

Rel(grpc_ingress_handler, feature_evaluator_component, "Passes request payload for feature extraction.")
Rel(feature_evaluator_component, ml_inference_rule_engine_component, "Provides evaluated features for transaction scoring.")
Rel(ml_inference_rule_engine_component, audit_dispatcher_component, "Sends scoring results and audit data for recording.")
Rel(feature_evaluator_component, amazon_dynamodb, "Queries transaction features", "TCP")
Rel(audit_dispatcher_component, aws_s3_object_lock, "Stores tamper-evident audit logs", "AWS API")
@enduml