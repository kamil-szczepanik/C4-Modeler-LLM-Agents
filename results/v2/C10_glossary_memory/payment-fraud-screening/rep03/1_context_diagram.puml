@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Cardholders_Merchants, "Cardholders / Merchants", "External entities initiating transactions indirectly.")
Person(Fraud_Analysts_Risk_Managers, "Fraud Analysts & Risk Managers", "Internal users accessing the system for case reviews and rule updates.")
System_Ext(Payment_Gateway_Acquirer, "Payment Gateway / Acquirer", "External system sending authorization requests via REST/gRPC.")
System_Ext(AWS_ECS_on_Fargate, "AWS ECS on Fargate", "Container platform hosting the hot-path scoring engine.")
System_Ext(AWS_QLDB_S3_Object_Lock, "AWS QLDB / S3 Object Lock", "Storage for tamper-evident audit logs.")
System_Ext(AWS_Cognito, "AWS Cognito", "Identity provider handling OAuth2/OIDC and MFA.")

System(Real_Time_Payment_Fraud_Screening_System, "Real-Time Payment Fraud Screening System", "Processes card-not-present payment authorizations to detect fraud within a sub-50ms latency window while providing case management for analysts.")

Rel(Payment_Gateway_Acquirer, Real_Time_Payment_Fraud_Screening_System, "Sends synchronous authorization requests", "gRPC/HTTPS over mTLS")
Rel(Fraud_Analysts_Risk_Managers, Real_Time_Payment_Fraud_Screening_System, "Accesses case management for case reviews and rule updates", "HTTPS (TLS 1.3)")
Rel(Real_Time_Payment_Fraud_Screening_System, AWS_QLDB_S3_Object_Lock, "Streams asynchronous audit logs for tamper-evident retention", "AWS QLDB / S3 API")
Rel(Real_Time_Payment_Fraud_Screening_System, AWS_ECS_on_Fargate, "Executes scalable scoring containers for low-latency decisions", "AWS ECS / Fargate")
@enduml