@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

System_Ext(CoreServices, "Core Services", "Node.js / NestJS core business logic services")
System_Ext(EMRService, "EMR Service", "Java / Spring Boot electronic medical records service")
System_Ext(IdentityPolicyContainer, "Identity & Policy Container", "Keycloak OIDC/OAuth2 authentication and JWKS provider")
System_Ext(CacheStateStore, "Cache / State Store", "Redis Cluster for distributed rate-limiting evaluation")
System_Ext(MessageBroker, "Message Broker", "Apache Kafka for asynchronous audit log streaming")
System_Ext(IntegrationService, "Integration Service", "Apache Camel / Node.js interoperability service")

Container_Boundary(api_gateway, "API Gateway") {
    Component(EdgeRouter, "Edge Router", "Envoy", "Edge Router handling TLS 1.3 HTTPS traffic and upstream gRPC/mTLS routing.")
    Component(AuthFilter, "Auth Filter", "Envoy Filter", "Authenticates requests and synchronizes JWKS cache with the Identity & Policy Container.")
    Component(RateLimitingPlugin, "Rate Limiting Plugin", "Envoy Plugin", "Performs token bucket tracking and rate-limiting evaluation using Redis Cluster.")
    Component(AuditInterceptor, "Audit Interceptor", "Envoy Interceptor", "Streams asynchronous audit logs to Apache Kafka for HIPAA compliance.")
    Component(DataMaskingFilter, "Data Masking Filter", "Envoy Filter", "Masks sensitive patient data to ensure HIPAA and GDPR compliance.")
}

Rel(EdgeRouter, CoreServices, "Upstream requests", "gRPC over mTLS")
Rel(EdgeRouter, EMRService, "Upstream requests", "gRPC over mTLS")
Rel(AuthFilter, IdentityPolicyContainer, "JWKS cache sync", "HTTPS")
Rel(RateLimitingPlugin, CacheStateStore, "Token bucket tracking", "RESP / TCP")
Rel(AuditInterceptor, MessageBroker, "Asynchronous audit logs", "TCP / Kafka Protocol")
Rel(EdgeRouter, IntegrationService, "FHIR interoperability requests", "gRPC / HTTPS")

@enduml