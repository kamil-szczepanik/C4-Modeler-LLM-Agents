@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Cache / State Store container

System_Ext(core_services_emr, "Core Services & EMR Service", "External service")
System_Ext(message_broker, "Message Broker", "External message broker")

Container_Boundary(cache_state_store, "Cache / State Store") {
    Component(tls_termination_proxy, "TLS Termination Proxy", "Redis Proxy / TLS 1.3", "Terminates inbound TLS connections and enforces secure transport from core services.")
    Component(access_control_rbc_enforcer, "Access Control & RBAC Enforcer", "Redis ACL Module", "Validates permissions and handles internal routing of authenticated commands.")
    Component(in_memory_data_engine, "In-Memory Data Engine", "Redis Enterprise / Redis Cluster", "Provides ultra-low latency caching, distributed locking via Redlock, and keyspace operations.")
    Component(cluster_topology_manager, "Cluster Topology Manager", "Redis Cluster Consensus Manager", "Performs internal IPC for node state monitoring and high availability.")
    Component(encryption_key_management_module, "Encryption & Key Management Module", "AES-256 Module", "Handles internal crypto operations for transparent data encryption at rest.")
    Component(cache_state_store_active_active_sync, "Cache / State Store (Active-Active Sync)", "Redis Active-Active CRDTs", "Manages encrypted WAN replication link between on-prem-k8s and eu-central-1.")
}

Rel(core_services_emr, tls_termination_proxy, "TCP/TLS (RESP)")
Rel(tls_termination_proxy, access_control_rbc_enforcer, "Internal routing of authenticated commands")
Rel(access_control_rbc_enforcer, in_memory_data_engine, "Authorized keyspace operations")
Rel(in_memory_data_engine, cluster_topology_manager, "Internal IPC for node state monitoring")
Rel(in_memory_data_engine, encryption_key_management_module, "Internal crypto operations for disk persistence")
Rel(cache_state_store, cache_state_store_active_active_sync, "Encrypted WAN replication link (on-prem-k8s to eu-central-1)")
Rel(cache_state_store, message_broker, "TCP/TLS (AMQP/Kafka) for state-eviction events")

@enduml