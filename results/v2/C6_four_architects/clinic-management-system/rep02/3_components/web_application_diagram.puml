@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application container

Container_Boundary(web_application, "Web Application") {
    Component(router_state_controller, "Router & State Controller", "TypeScript, React Router", "Managing client-side navigation and session state enforcement.")
    Component(auth_session_manager, "Auth & Session Manager", "TypeScript module", "Handling OpenID Connect (OIDC) token exchange with Keycloak and enforcing multi-factor authentication (MFA).")
    Component(emr_ui_module, "EMR UI Module", "TypeScript, React", "Component tree optimized for medical records with local caching.")
    Component(billing_scheduling_ui_module, "Billing & Scheduling UI Module", "TypeScript, React", "Components handling patient registration, appointments, and insurance claims.")
    Component(api_client_interceptor, "API Client / Interceptor", "TypeScript, Axios", "Module managing centralized communication and injecting JWT bearer tokens.")
    Component(offline_state_sync_manager, "Offline State & Sync Manager", "TypeScript, browser IndexedDB, Web Crypto API", "Browser IndexedDB module with Web Crypto API encryption for transient data.")
    Component(telemetry_audit_logger, "Telemetry & Audit Logger", "TypeScript module", "Capturing client performance metrics and security audit events.")
}

System_Ext(api_gateway, "API Gateway", "HTTPS, TLS 1.3", "External API Gateway receiving requests from the Web Application.")

Rel(emr_ui_module, api_client_interceptor, "Internal function calls transmitting data via HTTPS", "REST/JSON and GraphQL over TLS 1.3")
Rel(billing_scheduling_ui_module, api_client_interceptor, "Internal function calls transmitting data via HTTPS", "REST/JSON and GraphQL over TLS 1.3")
Rel(router_state_controller, api_client_interceptor, "Internal function calls transmitting data via HTTPS", "REST/JSON and GraphQL over TLS 1.3")
Rel(auth_session_manager, api_client_interceptor, "Internal function calls transmitting data via HTTPS", "REST/JSON and GraphQL over TLS 1.3")
Rel(api_client_interceptor, api_gateway, "Network requests over HTTPS with injected JWT bearer tokens and audit headers", "REST/JSON and GraphQL")
Rel(emr_ui_module, offline_state_sync_manager, "Local read/write operations using browser IndexedDB", "Web Crypto API encryption")
Rel(billing_scheduling_ui_module, offline_state_sync_manager, "Local read/write operations using browser IndexedDB", "Web Crypto API encryption")
Rel(telemetry_audit_logger, api_gateway, "Asynchronous batch event dispatching via HTTPS", "REST/JSON")

@enduml