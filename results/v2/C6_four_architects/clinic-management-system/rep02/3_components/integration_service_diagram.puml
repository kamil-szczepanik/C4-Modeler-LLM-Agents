@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Service container

System_Ext(External_Lab_Imaging_Systems, "External Lab/Imaging Systems", "External systems for lab and imaging data.")
System_Ext(Message_Broker_Apache_Kafka, "Message Broker (Apache Kafka)", "High-throughput asynchronous messaging infrastructure.")
System_Ext(Cache_State_Store_Redis_Cluster, "Cache / State Store (Redis Cluster)", "Distributed state store for circuit breakers and resilience.")
System_Ext(Data_Layer_PostgreSQL_MinIO, "Data Layer (PostgreSQL/MinIO)", "Relational database and object storage for audit trails.")
System_Ext(Monitoring_Stack, "Monitoring Stack", "Observability and metrics platform.")

Container_Boundary(Integration_Service, "Integration Service") {
    Component(FHIR_Ingress_Egress_Router, "FHIR Ingress/Egress Router", "Apache Camel / Java", "Routes FHIR over HTTPS requests to and from external Lab/Imaging Systems.")
    Component(HL7_v2_MLLP_Adapter, "HL7 v2 MLLP Adapter", "Apache Camel / Java", "Handles legacy data ingestion via MLLP over TCP from external Lab/Imaging Systems.")
    Component(Schema_Validation_Component, "Schema Validation Component", "Apache Camel / Java", "Validates incoming and outgoing healthcare message schemas.")
    Component(Data_Transformation_Engine, "Data Transformation Engine", "Apache Camel / Java", "Transforms healthcare data formats between internal models and external standards.")
    Component(Circuit_Breaker_Resilience_Engine, "Circuit Breaker & Resilience Engine", "Apache Camel / Java", "Ensures resilience and fault tolerance using distributed state synchronized with Redis.")
    Component(OAuth2_mTLS_Security_Interceptor, "OAuth2/mTLS Security Interceptor", "Apache Camel / Java", "Provides security interception using OAuth2 and mTLS for secure communication.")
    Component(Dead_Letter_Channel_Audit_Component, "Dead Letter Channel & Audit Component", "Apache Camel / Java", "Manages failed messages and persists audit trails to the Data Layer.")
    Component(Integration_Queue_Producer, "Integration Queue Producer", "Apache Camel / Java", "Publishes integration events to the Message Broker.")
    Component(Metrics_Telemetry_Publisher, "Metrics & Telemetry Publisher", "Apache Camel / Java", "Publishes operational telemetry to the monitoring stack.")
}

Rel(FHIR_Ingress_Egress_Router, External_Lab_Imaging_Systems, "FHIR over HTTPS", "HTTPS/JSON")
Rel(HL7_v2_MLLP_Adapter, External_Lab_Imaging_Systems, "Legacy data ingestion via MLLP", "TCP")
Rel(Integration_Queue_Producer, Message_Broker_Apache_Kafka, "Event publishing", "TCP/Kafka")
Rel(Circuit_Breaker_Resilience_Engine, Cache_State_Store_Redis_Cluster, "State synchronization via RESP", "RESP/TLS")
Rel(Dead_Letter_Channel_Audit_Component, Data_Layer_PostgreSQL_MinIO, "Audit persistence via JDBC", "JDBC/TLS")
Rel(Metrics_Telemetry_Publisher, Monitoring_Stack, "Operational telemetry", "HTTP/TLS")

@enduml