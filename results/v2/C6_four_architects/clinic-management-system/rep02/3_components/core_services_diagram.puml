@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Services container

Container_Boundary(core_services, "Core Services") {
    Component(patient_management, "Patient Management Component", "TypeORM / Node.js", "Handles demographic capture via TypeORM.")
    Component(scheduling_engine, "Scheduling Engine Component", "Node.js / NestJS", "Manages appointment scheduling and resource clash checks.")
    Component(billing_service, "Billing Service Component", "HTTP/REST / Node.js", "Processes claims and invoices via HTTP/REST.")
    Component(audit_logger, "Audit Logger Component", "AMQP / Node.js", "Publishes immutable audit trails.")
    Component(access_control, "Access Control & Policy Enforcer Component", "JWT / NestJS", "Validates JWT claims and scopes.")
    Component(fhir_mapper, "FHIR Data Mapper Component", "HL7 FHIR / Node.js", "Translates models into HL7 FHIR standards.")
    Component(encryption_middleware, "Encryption-at-Rest Middleware Component", "Node.js Crypto Module (AES-256-GCM)", "Applies AES-256 field-level encryption.")
    Component(patient_repo, "Patient Data Repository Component", "SQL / Node.js", "Encapsulates data queries and PHI protection.")
    Component(config_manager, "Config & Secret Manager Component", "HTTPS / Node.js", "Fetches dynamic runtime configurations and keys.")
}

System_Ext(cache_store, "Cache / State Store", "Redis Cluster")
System_Ext(insurance_clearinghouses, "Insurance Clearinghouses", "External System")
System_Ext(message_broker, "Message Broker", "Apache Kafka")
System_Ext(integration_service, "Integration Service", "External System")
System_Ext(data_layer, "Data Layer", "PostgreSQL / MinIO")
System_Ext(secret_manager_ext, "Config & Secret Manager", "External Service")

Rel(scheduling_engine, cache_store, "Read/Write lock states", "TCP/TLS (RESP)")
Rel(billing_service, insurance_clearinghouses, "Submit claims", "HTTPS/REST")
Rel(audit_logger, message_broker, "Produce audit events", "AMQP/TLS")
Rel(fhir_mapper, integration_service, "Publish standardized resources", "gRPC/TLS")
Rel(patient_management, encryption_middleware, "Encrypt data", "Node.js Crypto Module (AES-256-GCM)")
Rel(billing_service, encryption_middleware, "Encrypt data", "Node.js Crypto Module (AES-256-GCM)")
Rel(patient_repo, data_layer, "Encrypted SQL queries", "TLS (TCP/JDBC)")
Rel(encryption_middleware, config_manager, "Retrieve keys", "HTTPS")
Rel(patient_management, access_control, "Validates permissions", "In-process / NestJS middleware")
Rel(scheduling_engine, access_control, "Validates permissions", "In-process / NestJS middleware")
Rel(billing_service, access_control, "Validates permissions", "In-process / NestJS middleware")
@enduml