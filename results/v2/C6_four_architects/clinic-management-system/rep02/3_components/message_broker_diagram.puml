@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Message Broker container

Container_Boundary(message_broker_container, "Message Broker") {
    Component(Topic Management & Partitioning Engine, "Topic Management & Partitioning Engine", "Apache Kafka", "Handles topic management and data partitioning for clinical event streams.")
    Component(Access Control & TLS Termination Module, "Access Control & TLS Termination Module", "TLS / mTLS", "Manages access control and TLS termination to ensure HIPAA/GDPR compliance.")
    Component(Schema Registry Component, "Schema Registry Component", "Confluent Schema Registry / Apicurio", "Enforces Avro/Protobuf clinical payload contracts.")
    Component(Broker Cluster Coordinator, "Broker Cluster Coordinator", "KRaft", "Provides metadata and leader election without ZooKeeper for high availability.")
    Component(Log Compaction & Retention Manager, "Log Compaction & Retention Manager", "Apache Kafka Log Compaction", "Manages long-term log compaction and historical log tiering to cold storage.")
    Component(Dead Letter Queue & Routing Component, "Dead Letter Queue & Routing Component", "Apache Kafka DLQ", "Handles internal stream redirection for failed messages.")
    Component(Audit Logging & Compliance Interceptor, "Audit Logging & Compliance Interceptor", "Kafka Interceptor", "Captures security audit streams for compliance.")
}

Component(Keycloak, "Keycloak", "Identity & Policy Container", "Manages identity and policies via OAuth2/OIDC.")
Component(MinIO / AWS S3, "MinIO / AWS S3", "MinIO / AWS S3", "Provides long-term cold storage for 10-year data retention compliance.")
Component(Core Services & EMR Service, "Core Services & EMR Service", "Clinical IT Platform Services", "Manages patient admissions, EMRs, scheduling, and billing workflows.")

Rel(Core Services & EMR Service, Schema Registry Component, "HTTP/TLS for schema validation", "HTTP/TLS")
Rel(Core Services & EMR Service, Topic Management & Partitioning Engine, "TCP/TLS (Kafka Protocol)", "TCP/TLS")
Rel(Access Control & TLS Termination Module, Keycloak, "OAuth2/OIDC via HTTPS", "HTTPS")
Rel(Topic Management & Partitioning Engine, Broker Cluster Coordinator, "Raft consensus over TCP/TLS", "TCP/TLS")
Rel(Broker Cluster Coordinator, Topic Management & Partitioning Engine, "Raft consensus over TCP/TLS", "TCP/TLS")
Rel(Log Compaction & Retention Manager, MinIO / AWS S3, "HTTPS for historical log tiering", "HTTPS")
Rel(Topic Management & Partitioning Engine, Dead Letter Queue & Routing Component, "Internal TCP/TLS stream redirection", "TCP/TLS")
Rel(Audit Logging & Compliance Interceptor, Core Services & EMR Service, "TCP/TLS for security audit streams", "TCP/TLS")
@enduml