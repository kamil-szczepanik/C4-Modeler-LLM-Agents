@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the EMR Service container

Container_Boundary(emr_service, "EMR Service") {
    Component(EMR REST Controller, "EMR REST Controller", "Spring MVC", "Handles incoming HTTP requests for patient admissions, electronic medical records, scheduling, and billing.")
    Component(EMR Domain Engine, "EMR Domain Engine", "Spring Data JPA", "Executes core clinical business logic and data persistence.")
    Component(Audit Interceptor, "Audit Interceptor", "Spring AOP", "Provides automated immutable audit trails for HIPAA compliance.")
    Component(FHIR Transformer Component, "FHIR Transformer Component", "HAPI FHIR library", "Handles HL7 FHIR standardization for external interoperability.")
    Component(EMR Cache Manager, "EMR Cache Manager", "Spring Cache / Redis Client", "Manages distributed caching for sub-second P95 screen loads.")
    Component(Clinical Document Storage Adapter, "Clinical Document Storage Adapter", "AWS SDK / S3 Client", "Manages encrypted binary blob storage with AES-256.")
    Component(Clinical Event Publisher, "Clinical Event Publisher", "Spring Cloud Stream / Kafka Client", "Publishes asynchronous events for cross-service messaging.")
}

Component_Ext(Cache / State Store (Redis Cluster), "Cache / State Store (Redis Cluster)", "Redis Cluster", "Distributed caching layer for state storage.")
Component_Ext(Data Layer (MinIO/AWS S3), "Data Layer (MinIO/AWS S3)", "MinIO / AWS S3", "Encrypted binary blob storage layer.")
Component_Ext(Message Broker (Kafka), "Message Broker (Kafka)", "Apache Kafka", "Asynchronous event-driven message broker.")

Rel(EMR REST Controller, EMR Domain Engine, "In-process method calls", "HTTPS")
Rel(EMR Domain Engine, Audit Interceptor, "In-process method calls", "TLS/JDBC")
Rel(EMR Domain Engine, FHIR Transformer Component, "In-process method calls", "")
Rel(EMR Domain Engine, EMR Cache Manager, "In-process method calls", "")
Rel(EMR Cache Manager, Cache / State Store (Redis Cluster), "Distributed caching", "TLS / RESP")
Rel(EMR Domain Engine, Clinical Document Storage Adapter, "In-process method calls", "")
Rel(Clinical Document Storage Adapter, Data Layer (MinIO/AWS S3), "Blob storage", "HTTPS / S3 API")
Rel(EMR Domain Engine, Clinical Event Publisher, "In-process method calls", "")
Rel(Clinical Event Publisher, Message Broker (Kafka), "Event publishing", "AMQP/TLS")

@enduml