@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Doctors, "Doctors", "Medical professionals who access and manage electronic medical records (EMR) and patient clinical data.")
Person(Nurses, "Nurses", "Healthcare staff who assist with patient care, updates, and clinical data entry.")
Person(Receptionists, "Receptionists", "Administrative staff responsible for patient registration and appointment scheduling.")
Person(Billing Officers, "Billing Officers", "Staff members who manage invoices, payments, and financial interactions.")
Person(Patients, "Patients", "End users who access their records, appointments, and billing information.")

System_Ext(External Lab/Imaging Systems, "External Lab/Imaging Systems", "External systems providing laboratory results and medical imaging data via HL7 FHIR.")
System_Ext(Insurance Clearinghouses, "Insurance Clearinghouses", "External systems handling insurance claims and verification.")
System_Ext(Payment Gateway, "Payment Gateway", "External service processing secure financial payments.")
System_Ext(Notification Service, "Notification Service", "External service handling system notifications and alerts.")

System_Boundary(Clinic Management System, "Clinic Management System") {
    Container(API Gateway, "API Gateway", "Kong/Envoy", "Edge routing, mTLS, and OAuth2/MFA enforcement.")
    Container(Web Application, "Web Application", "React / Nginx", "High-performance client-side UI rendering.")
    Container(Core Services, "Core Services", "Node.js / NestJS", "Rapid development of core administrative and billing workflows.")
    Container(EMR Service, "EMR Service", "Java / Spring Boot", "Robust enterprise transaction management and strict compliance auditing for EMR.")
    Container(Integration Service, "Integration Service", "Apache Camel / Node.js", "Handles integration with external clinical and laboratory systems.")
    Container(Async Worker Containers, "Async Worker Containers", "Python/Celery or Java", "Handles asynchronous background processing and tasks.")
    Container(Identity & Policy Container, "Identity & Policy Container", "Keycloak", "Local token validation and fine-grained RBAC.")
    Container(Message Broker, "Message Broker", "Apache Kafka or RabbitMQ", "Asynchronous decoupling for high availability during external system outages.")
    Container(Cache / State Store, "Cache / State Store", "Redis Cluster", "Active-active distributed locking for scheduling clash checks and rate-limiting.")
    ContainerDb(Data Layer, "Data Layer", "PostgreSQL and MinIO/AWS S3", "Active-active hybrid replication and immutable object storage for 10-year retention.")
}

Rel(Doctors, API Gateway, "HTTPS (JSON/REST)", "HTTPS")
Rel(Nurses, API Gateway, "HTTPS (JSON/REST)", "HTTPS")
Rel(Receptionists, API Gateway, "HTTPS (JSON/REST)", "HTTPS")
Rel(Billing Officers, API Gateway, "HTTPS (JSON/REST)", "HTTPS")
Rel(Patients, API Gateway, "HTTPS (JSON/REST)", "HTTPS")
Rel(API Gateway, Identity & Policy Container, "OIDC/OAuth2", "OIDC/OAuth2")
Rel(Core Services, Data Layer, "TLS (TCP/JDBC)", "TLS (TCP/JDBC)")
Rel(EMR Service, Data Layer, "TLS (TCP/JDBC) and S3 API", "TLS / HTTPS")
Rel(Core Services, Message Broker, "AMQP/TLS", "AMQP/TLS")
Rel(EMR Service, Message Broker, "AMQP/TLS", "AMQP/TLS")
Rel(Core Services, Cache / State Store, "TCP/TLS (RESP)", "TCP/TLS (RESP)")
Rel(Integration Service, External Lab/Imaging Systems, "HL7 FHIR over HTTPS", "HTTPS")
Rel(EMR Service, Data Layer, "HTTPS (S3 API)", "HTTPS")

@enduml