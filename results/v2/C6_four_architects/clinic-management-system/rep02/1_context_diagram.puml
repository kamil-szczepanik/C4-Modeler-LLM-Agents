@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Doctors, "Doctors", "Medical professionals who access and manage electronic medical records (EMR) and patient clinical data.")
Person(Nurses, "Nurses", "Healthcare staff who assist with patient care, updates, and clinical data entry.")
Person(Receptionists, "Receptionists", "Administrative staff responsible for patient registration and appointment scheduling.")
Person(Billing Officers, "Billing Officers", "Staff members who manage invoices, payments, and financial interactions.")
Person(Patients, "Patients", "End users who access their records, appointments, and billing information.")

System(Clinic Management System, "Clinic Management System", "A hybrid cloud platform designed to handle patient registration, scheduling, electronic medical records (EMR), and billing for medical clinics, ensuring HIPAA/GDPR compliance, 99.99% availability, and strict 10-year data retention.")

System_Ext(External Lab/Imaging Systems, "External Lab/Imaging Systems", "External systems providing laboratory results and medical imaging data via HL7 FHIR.")
System_Ext(Insurance Clearinghouses, "Insurance Clearinghouses", "External systems handling insurance claims and verification.")
System_Ext(Payment Gateway, "Payment Gateway", "Stripe-like external service processing secure financial payments.")
System_Ext(Identity Provider, "Identity Provider", "Keycloak or Azure AD handling authentication and OpenID Connect (OIDC) validation.")
System_Ext(Notification Service, "Notification Service", "Twilio or AWS SES handling system notifications and alerts.")

Rel(Doctors, Clinic Management System, "Accesses clinical records and schedules", "HTTPS (TLS 1.3), OpenID Connect (OIDC)")
Rel(Nurses, Clinic Management System, "Views and updates patient EMR data", "HTTPS (TLS 1.3), OpenID Connect (OIDC)")
Rel(Receptionists, Clinic Management System, "Registers patients and manages schedules", "HTTPS (TLS 1.3), OpenID Connect (OIDC)")
Rel(Billing Officers, Clinic Management System, "Manages patient billing and invoices", "HTTPS (TLS 1.3), OpenID Connect (OIDC)")
Rel(Patients, Clinic Management System, "Views personal health and billing information", "HTTPS (TLS 1.3), OpenID Connect (OIDC)")

Rel(Clinic Management System, External Lab/Imaging Systems, "Exchanges medical data and results", "HL7 FHIR over REST/HTTPS")
Rel(Clinic Management System, Insurance Clearinghouses, "Submits and processes insurance claims", "HL7 FHIR over REST/HTTPS")
Rel(Clinic Management System, Payment Gateway, "Processes secure patient payments", "REST/HTTPS")
Rel(Clinic Management System, Notification Service, "Dispatches alerts and messages to users", "REST/HTTPS")

@enduml