@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title System Container Diagram for Clinic Management System

Person(Doctor, "Doctor", "Medical professional who manages patient care, admissions, and electronic medical records.")
Person(Nurse, "Nurse", "Healthcare worker who assists in patient care and record updates.")
Person(Receptionist, "Receptionist", "Front-desk staff responsible for patient scheduling and admissions.")
Person(Billing Officer, "Billing Officer", "Financial staff handling billing and insurance interactions.")
Person(Patient, "Patient", "Recipient of medical care interacting with the system for scheduling and records.")
Person(Regulatory/Audit Authority, "Regulatory/Audit Authority", "Authority checking compliance and audit logs for regulatory standards.")

System_Ext(Identity Provider (IdP), "Identity Provider (IdP)", "External system handling user authentication and identity management.")
System_Ext(External Labs & Imaging Systems, "External Labs & Imaging Systems", "External medical systems providing lab results and medical imaging via HL7 FHIR.")
System_Ext(Insurance Payment Gateway, "Insurance Payment Gateway", "External payment processing system for handling insurance claims and billing.")
System_Ext(Hospital Notification/SMS Gateway, "Hospital Notification/SMS Gateway", "External gateway used for sending notifications and SMS messages to users and patients.")

System_Boundary(Clinic Management System, "Clinic Management System") {
    Container(API Gateway / Edge Proxy, "API Gateway / Edge Proxy", "AWS", "AWS-hosted entry point handling incoming traffic and routing.")
    Container(Scheduling & Billing Services, "Scheduling & Billing Services", "AWS", "AWS-hosted stateless scalable services for managing clinic schedules and financial billing.")
    Container(EMR & Patient Records Service, "EMR & Patient Records Service", "On-Premises Kubernetes", "On-premises service managing sensitive electronic medical records.")
    Container(FHIR Integration Broker, "FHIR Integration Broker", "On-Premises Kubernetes", "On-premises broker handling HL7 FHIR interoperability with external medical systems.")
    Container(Audit Logging Service & Storage, "Audit Logging Service & Storage", "On-Premises Kubernetes", "On-premises service recording audit logs for compliance.")
    ContainerDb(EMR Secure Datastore, "EMR Secure Datastore", "AES-256 encrypted relational database", "AES-256 encrypted relational database storing sensitive patient records on-premises.")
    Container(Message Broker / Event Bus, "Message Broker / Event Bus", "Kafka/RabbitMQ", "Kafka/RabbitMQ shared infrastructure providing asynchronous messaging.")
    ContainerDb(Transactional Datastore, "Transactional Datastore", "Managed PostgreSQL/Aurora", "Managed PostgreSQL/Aurora transactional database hosted in AWS.")
}

Rel(Doctor, API Gateway / Edge Proxy, "Accesses patient admissions, records, and scheduling via secure interface", "HTTPS and OAuth2/OIDC with MFA via TLS 1.3")
Rel(Nurse, API Gateway / Edge Proxy, "Manages patient records and scheduling via secure interface", "HTTPS and OAuth2/OIDC with MFA via TLS 1.3")
Rel(Receptionist, API Gateway / Edge Proxy, "Handles patient admissions and scheduling", "HTTPS and OAuth2/OIDC with MFA via TLS 1.3")
Rel(Billing Officer, API Gateway / Edge Proxy, "Manages billing operations", "HTTPS and OAuth2/OIDC with MFA via TLS 1.3")
Rel(Patient, API Gateway / Edge Proxy, "Views appointments and medical information", "HTTPS and OAuth2/OIDC with MFA via TLS 1.3")
Rel(Regulatory/Audit Authority, API Gateway / Edge Proxy, "Reviews audit logs and compliance data", "HTTPS and OAuth2/OIDC with MFA via TLS 1.3")
Rel(API Gateway / Edge Proxy, Scheduling & Billing Services, "Routes internal requests to microservices", "gRPC over mTLS")
Rel(API Gateway / Edge Proxy, EMR & Patient Records Service, "Routes internal requests to EMR service", "gRPC over mTLS")
Rel(EMR & Patient Records Service, EMR Secure Datastore, "Reads and writes encrypted patient data", "PostgreSQL wire protocol over mTLS with AES-256")
Rel(FHIR Integration Broker, External Labs & Imaging Systems, "Exchanges clinical data with external systems", "HL7 FHIR over HTTPS")
Rel(Scheduling & Billing Services, Insurance Payment Gateway, "Processes insurance claims and payments", "REST over TLS 1.3")
Rel(Scheduling & Billing Services, Hospital Notification/SMS Gateway, "Sends automated notifications and SMS", "REST over TLS 1.3")
Rel(EMR & Patient Records Service, Audit Logging Service & Storage, "Sends audit logs for compliance tracking", "gRPC over mTLS")

@enduml