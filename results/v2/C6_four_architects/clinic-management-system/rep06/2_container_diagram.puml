@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Doctor, "Doctor", "Medical professional who manages patient care, admissions, and electronic medical records.")
Person(Nurse, "Nurse", "Healthcare worker who assists in patient care and record updates.")
Person(Receptionist, "Receptionist", "Front-desk staff responsible for patient scheduling and admissions.")
Person(Billing_Officer, "Billing Officer", "Financial staff handling billing and insurance interactions.")
Person(Patient, "Patient", "Recipient of medical care interacting with the system for scheduling and records.")
Person(Regulatory_Audit_Authority, "Regulatory/Audit Authority", "Authority checking compliance and audit logs for regulatory standards.")

System_Ext(Insurance_Payment_Gateway, "Insurance Payment Gateway", "External payment processing system for handling insurance claims and billing.")

System_Boundary(Clinic_Management_System, "Clinic Management System") {
    Container(Frontend_Web_App, "Frontend Web App", "React SPA", "User-facing web application for interacting with the clinic management system.")
    Container(API_Gateway, "API Gateway", "Nginx / Kong", "Entry point handling incoming traffic, routing, and security.")
    Container(Identity_Access_Proxy, "Identity & Access Proxy", "OAuth2 Proxy / Keycloak Sidecar", "Handles identity verification and access proxying.")
    Container(Patient_Scheduling_Service, "Patient & Scheduling Service", "Java / Spring Boot", "Manages patient admissions and appointment scheduling.")
    Container(EMR_Service, "EMR Service", "Node.js / TypeScript", "Manages electronic medical records.")
    Container(Billing_Claims_Service, "Billing & Claims Service", ".NET Core", "Manages billing operations and insurance claims.")
    Container(FHIR_Integration_Broker, "FHIR Integration Broker", "Apache Camel / Python", "Integrates healthcare data using the FHIR standard.")
    Container(Async_Message_Broker, "Async Message Broker", "Apache Kafka / RabbitMQ", "Decouples services using event-driven messaging.")
    Container(Audit_Compliance_Log_Shipper, "Audit & Compliance Log Shipper", "Fluentbit / Vector", "Ships audit logs and compliance data securely.")
    ContainerDb(Patient_DB, "Patient DB", "PostgreSQL", "Relational database storing structured scheduling and patient data.")
    ContainerDb(EMR_DB, "EMR DB", "MongoDB", "NoSQL database storing flexible EMR payloads.")
    ContainerDb(Distributed_Cache, "Distributed Cache", "Redis", "Provides sub-second EMR retrieval and session caching.")
    ContainerDb(Audit_Data_Store, "Audit Data Store", "AWS S3 / MinIO WORM", "Stores audit logs with 10-year WORM retention.")
}

Rel(Doctor, Frontend_Web_App, "Accesses patient admissions, records, and scheduling", "HTTPS")
Rel(Nurse, Frontend_Web_App, "Manages patient records and scheduling", "HTTPS")
Rel(Receptionist, Frontend_Web_App, "Handles patient admissions and scheduling", "HTTPS")
Rel(Billing_Officer, Frontend_Web_App, "Manages billing operations", "HTTPS")
Rel(Patient, Frontend_Web_App, "Views appointments and medical information", "HTTPS")
Rel(Regulatory_Audit_Authority, Frontend_Web_App, "Reviews audit logs and compliance data", "HTTPS")

Rel(Frontend_Web_App, API_Gateway, "Sends client requests", "HTTPS")
Rel(API_Gateway, Identity_Access_Proxy, "Authenticates requests", "Internal gRPC")
Rel(API_Gateway, Patient_Scheduling_Service, "Routes requests to patient and scheduling domain", "gRPC")
Rel(API_Gateway, EMR_Service, "Routes requests to EMR domain", "gRPC")

Rel(Patient_Scheduling_Service, Async_Message_Broker, "Publishes and consumes events", "AMQP/TCP")
Rel(EMR_Service, Async_Message_Broker, "Publishes and consumes events", "AMQP/TCP")
Rel(Billing_Claims_Service, Async_Message_Broker, "Publishes and consumes events", "AMQP/TCP")
Rel(FHIR_Integration_Broker, Async_Message_Broker, "Publishes and consumes synchronization events", "AMQP/TCP")

Rel(Patient_Scheduling_Service, Patient_DB, "Reads and writes structured patient data", "TLS-encrypted SQL driver")
Rel(EMR_Service, EMR_DB, "Reads and writes EMR payloads", "TLS-encrypted NoSQL driver")
Rel(EMR_Service, Distributed_Cache, "Retrieves cached EMR data", "Redis Protocol")

Rel(Billing_Claims_Service, Insurance_Payment_Gateway, "Processes insurance claims and payments", "External HTTPS")
Rel(Audit_Compliance_Log_Shipper, Audit_Data_Store, "Writes compliance logs securely", "HTTPS/S3 API")

@enduml