@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the EMR Service container

System_Ext(AsyncMessageBroker, "Async Message Broker", "Apache Kafka/RabbitMQ", "Handles reliable asynchronous messaging and event distribution.")

Container_Boundary(emr_service, "EMR Service") {
    Component(emr_api_controller, "EMR API Controller", "Express.js/NestJS", "Handles incoming requests for the EMR Service.")
    Component(clinical_record_manager, "Clinical Record Manager", "Node.js/TypeScript", "Manages clinical records and interacts with the FHIR Transformer.")
    Component(fhir_transformer, "FHIR Transformer Component", "Node.js/TypeScript", "Converts records for external sync.")
    Component(data_access_repository, "Data Access Repository", "Node.js/TypeScript", "Data access repository interfacing with the FLE Interceptor.")
    Component(audit_event_dispatcher, "Audit Event Dispatcher", "Node.js/TypeScript", "Dispatches audit events for compliance.")
    Component(cache_aside_manager, "Cache-Aside Manager", "Node.js/TypeScript", "Manages cached EMR data retrieval.")
    Component(fle_interceptor, "Field-Level Encryption (FLE) Interceptor", "Node.js/TypeScript", "Encrypts and decrypts PHI payloads as in-memory middleware.")
    Component(telemetry_interceptor, "Telemetry & Health Probe Interceptor", "Node.js/TypeScript", "Propagates trace context and handles telemetry.")
}

Rel(clinical_record_manager, fhir_transformer, "Converts records for external sync", "In-memory")
Rel(data_access_repository, fle_interceptor, "Encrypts/decrypts PHI payloads", "In-memory middleware")
Rel(telemetry_interceptor, AsyncMessageBroker, "Propagates trace context", "AMQP headers")

@enduml