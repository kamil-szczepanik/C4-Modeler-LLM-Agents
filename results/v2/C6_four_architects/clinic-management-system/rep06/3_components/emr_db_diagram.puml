@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(emr_db, "EMR DB") {
    Component(WiredTiger_Engine, "WiredTiger Engine", "MongoDB WiredTiger Storage Engine", "Provides flexible schema EMR storage and native AES-256 encryption at rest.")
    Component(Node_Replica_Sets, "3-node Replica Sets", "MongoDB Replica Set", "Ensures high availability and automated failover across multi-availability zones.")
    Component(Change_Streams, "Change Streams", "MongoDB Change Streams", "Streams oplog data for immutable audit trails to the log shipper.")
    Component(Backup___PITR_Agent, "Backup & PITR Agent", "MongoDB Backup Agent", "Streams encrypted database backups and point-in-time recovery logs to the audit data store.")
    Component(Encryption_Key_Management_Module, "Encryption Key Management Module", "KMIP Module", "Fetches data encryption keys (DEKs) using envelope encryption from the Identity Provider/KMS.")
    Component(Query_Access_Control_Subsystem, "Query Access Control Subsystem", "MongoDB RBAC", "Validates incoming connection tokens, context, and permissions for database access.")
}

System_Ext(Distributed_Cache, "Distributed Cache", "Caches frequent patient EMR lookup segments [TCP / Redis wire protocol via TLS]")
System_Ext(Audit___Compliance_Log_Shipper, "Audit & Compliance Log Shipper", "Streams oplog data for immutable audit trails [Internal DB Oplog tailing / TLS]")
System_Ext(Audit_Data_Store, "Audit Data Store", "Streams encrypted database backups and PITR logs [HTTPS / S3 API over TLS]")
System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "Fetches data encryption keys (DEKs) using envelope encryption [KMIP over TLS]")
System_Ext(Identity___Access_Proxy, "Identity & Access Proxy", "Validates incoming connection tokens and context [TLS / SCRAM-SHA-256]")

Rel(WiredTiger_Engine, Distributed_Cache, "Caches frequent patient EMR lookup segments", "TCP / Redis wire protocol via TLS")
Rel(Change_Streams, Audit___Compliance_Log_Shipper, "Streams oplog data for immutable audit trails", "Internal DB Oplog tailing / TLS")
Rel(Backup___PITR_Agent, Audit_Data_Store, "Streams encrypted database backups and PITR logs", "HTTPS / S3 API over TLS")
Rel(Encryption_Key_Management_Module, Identity_Provider_IdP, "Fetches data encryption keys (DEKs) using envelope encryption", "KMIP over TLS")
Rel(Query_Access_Control_Subsystem, Identity___Access_Proxy, "Validates incoming connection tokens and context", "TLS / SCRAM-SHA-256")
@enduml