@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient & Scheduling Service container

Container(API_Gateway, "API Gateway", "Gateway Technology", "Routes demographic and scheduling requests.")
Container(Distributed_Cache, "Distributed Cache", "Redis", "Provides distributed caching and atomic resource locking.")
ContainerDb(Patient_DB, "Patient DB", "SQL Database", "Stores patient and appointment data.")
Container(Async_Message_Broker, "Async Message Broker", "AMQP / Kafka", "Handles asynchronous domain events.")
System_Ext(Hospital_Notification_SMS_Gateway, "Hospital Notification/SMS Gateway", "REST/HTTPS", "External system dispatching appointment alerts.")

Container_Boundary(Patient_Scheduling_Service, "Patient & Scheduling Service") {
    Component(Patient_Management_Controller, "Patient Management Controller", "Spring MVC", "Handles patient admissions, demographics, and scheduling requests.")
    Component(Scheduling_Engine_Component, "Scheduling Engine Component", "Spring Service", "Manages scheduling logic and resource clash prevention.")
    Component(FHIR_Mapping_Adapter_Component, "FHIR Mapping Adapter Component", "Apache Camel / Spring Integration", "Translates internal models to HL7 FHIR standards for external interoperability.")
    Component(Audit_Interceptor_Component, "Audit Interceptor Component", "Spring AOP", "Captures audit logs transparently without business logic pollution for HIPAA/GDPR compliance.")
    Component(Notification_Trigger_Component, "Notification Trigger Component", "Spring Event Listener", "Dispatches appointment alerts and notifications.")
    Component(Domain_Event_Publisher_Component, "Domain Event Publisher Component", "Spring AMQP / Kafka Client", "Emits domain events to the message broker.")
    Component(Data_Access_Repository_Layer, "Data Access Repository Layer", "Spring Data JPA", "Manages database persistence for patient and appointment data.")
}

Rel(API_Gateway, Patient_Management_Controller, "Routes demographic and scheduling requests", "gRPC")
Rel(Scheduling_Engine_Component, Distributed_Cache, "Acquires atomic resource locks", "Redis Protocol over TLS")
Rel(Scheduling_Engine_Component, Patient_DB, "Reads/writes appointment data", "TLS-encrypted SQL")
Rel(Domain_Event_Publisher_Component, Async_Message_Broker, "Emits domain events", "AMQP/Kafka")
Rel(Notification_Trigger_Component, Hospital_Notification_SMS_Gateway, "Dispatches appointment alerts", "REST/HTTPS")

@enduml