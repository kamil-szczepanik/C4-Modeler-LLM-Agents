@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit & Compliance Log Shipper container

Container_Boundary(audit_compliance_log_shipper, "Audit & Compliance Log Shipper") {
    Component(LogInputCollector, "Log Input Collector", "Fluent Bit and Vector", "Gathers local system and application logs.")
    Component(ComplianceFilterTransformer, "Compliance Filter & Transformer", "Lua-based transformation", "Sanitizes and transforms log entries for compliance.")
    Component(EncryptionIntegritySigner, "Encryption & Integrity Signer", "HMAC-SHA256 signing", "Cryptographically signs log batches to ensure integrity.")
    Component(LocalBufferRetryManager, "Local Buffer & Retry Manager", "Disk-backed buffering", "Persists signed log batches locally and manages retry logic.")
    Component(WORMStorageExporter, "WORM Storage Exporter", "HTTPS / S3 API", "Replays and writes immutable log batches to secure storage.")
}

System_Ext(AuditDataStore, "Audit Data Store", "AWS S3 / MinIO WORM storage")

Rel(LogInputCollector, ComplianceFilterTransformer, "Gathers local logs", "UNIX sockets / In-process")
Rel(ComplianceFilterTransformer, EncryptionIntegritySigner, "Passes sanitized batches", "In-process")
Rel(EncryptionIntegritySigner, LocalBufferRetryManager, "Persists signed batches", "Local File I/O")
Rel(LocalBufferRetryManager, WORMStorageExporter, "Replays log batches", "In-process")
Rel(WORMStorageExporter, AuditDataStore, "Writes immutable logs", "HTTPS / S3 API with TLS 1.3")

@enduml