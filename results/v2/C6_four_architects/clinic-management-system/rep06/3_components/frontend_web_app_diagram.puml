@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Frontend Web App container

System_Ext(api_gateway, "API Gateway / Identity & Access Proxy", "External system gateway")
System_Ext(audit_shipper, "Audit & Compliance Log Shipper", "External audit log shipper")

Container_Boundary(frontend_web_app, "Frontend Web App") {
    Component(routing_shell, "Routing & Shell Component", "React Router", "Handles SPA navigation and layout structuring.")
    Component(state_store, "State Management Store", "Redux Toolkit / Zustand", "Manages global user session and UI state.")
    Component(api_client, "API Client Layer", "Axios/Fetch wrapper", "Manages REST/JSON communication and JWT authentication over HTTPS.")
    Component(patient_reg, "PatientRegistration", "React SPA & TypeScript", "Feature module for handling patient admissions.")
    Component(appointment_sched, "AppointmentScheduler", "React SPA & TypeScript", "Feature module for appointment scheduling and real-time updates over WSS.")
    Component(emr_editor, "EMREditor", "React SPA & TypeScript", "Feature module for electronic medical records with sub-second performance.")
    Component(billing_module, "BillingModule", "React SPA & TypeScript", "Feature module for billing and claims management.")
    Component(security_guard, "Security & Audit Guard", "TypeScript", "Enforces Role-Based Access Control (RBAC).")
    Component(offline_manager, "Offline/Cache Manager", "LocalStorage / IndexedDB", "Supports offline capabilities and high availability.")
    Component(telemetry, "Telemetry & Error Boundary Component", "TypeScript", "Captures error boundaries and sends telemetry data.")
    Component(encryption_wrapper, "State Encryption Wrapper", "Web Crypto API (SubtleCrypto)", "Provides client-side PHI encryption at rest for HIPAA compliance.")
    Component(design_system, "Design System Component", "Headless UI / Tailwind CSS", "Provides standardized clinical data-grids and UI elements.")
}

Rel(patient_reg, api_client, "Internal TypeScript function calls")
Rel(appointment_sched, api_client, "Internal TypeScript function calls")
Rel(emr_editor, api_client, "Internal TypeScript function calls")
Rel(billing_module, api_client, "Internal TypeScript function calls")
Rel(api_client, api_gateway, "REST/JSON and JWT authentication over HTTPS")
Rel(appointment_sched, api_gateway, "Real-time scheduling updates over WSS (WebSocket Secure)")
Rel(patient_reg, offline_manager, "Local caching of PHI data")
Rel(appointment_sched, offline_manager, "Local caching of scheduling data")
Rel(emr_editor, offline_manager, "Local caching of EMR data")
Rel(billing_module, offline_manager, "Local caching of billing data")
Rel(offline_manager, encryption_wrapper, "PHI encryption via SubtleCrypto API and IndexedDB")
Rel(telemetry, audit_shipper, "Security event logs over HTTPS")

@enduml