@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Distributed Cache container

System_Ext(emr_service, "EMR Service", "External service interacting with the cache.")
System_Ext(wan_remote, "WAN Replication & Tunneling Module (Remote)", "Remote cross-site WAN tunneling module.")

Container_Boundary(distributed_cache, "Distributed Cache") {
    Component(client_connection_handler, "Client Connection Handler", "Multiplexing I/O Engine", "Handles incoming client connections and multiplexes I/O operations.")
    Component(cache_cluster_manager, "Cache Cluster Manager", "Redis Sentinel / Cluster Coordinator", "Coordinates high availability and automatic failover across hybrid nodes.")
    Component(in_memory_storage_engine, "In-Memory Storage Engine", "Redis Core", "Provides in-memory storage for high-performance sub-second EMR retrieval.")
    Component(data_encryption_module, "Data Encryption Module", "TLS / AES-256 Module", "Ensures in-transit and at-rest security for HIPAA and GDPR compliance.")
    Component(replication_agent, "Replication Agent", "Redis Master-Replica Sync Engine", "Streams write-ahead logs and manages master-replica synchronization.")
    Component(wan_replication_tunneling_module, "WAN Replication & Tunneling Module", "Redis Enterprise Active-Active / Envoy Proxy", "Handles secure cross-site WAN tunneling via mTLS.")
    Component(cache_eviction_expiry_manager, "Cache Eviction & Expiry Manager", "Memory Management Engine", "Purges expired keys and manages cache eviction.")
}

Rel(emr_service, client_connection_handler, "Sends read/write commands", "TCP / Redis Protocol")
Rel(client_connection_handler, data_encryption_module, "Decrypts incoming traffic", "In-Memory Processing")
Rel(cache_cluster_manager, in_memory_storage_engine, "Coordinates replication", "Internal Redis Cluster Bus")
Rel(in_memory_storage_engine, replication_agent, "Streams write-ahead logs", "TCP / Redis Replication Protocol")
Rel(replication_agent, wan_replication_tunneling_module, "Forwards cross-site data", "TCP")
Rel(wan_replication_tunneling_module, wan_remote, "Synchronizes state", "mTLS")
Rel(cache_eviction_expiry_manager, in_memory_storage_engine, "Purges expired keys", "Internal Memory Access")

@enduml