@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(patient_db, "Patient DB") {
    Component(Primary_DB_Instance, "Primary DB Instance", "PostgreSQL 15", "Provides robust, relational data storage for structured scheduling and patient demographics.")
    Component(Read_Replica, "Read Replica", "PostgreSQL 15 Standby", "Provides read-only scaling and handles standby traffic via streaming replication.")
    Component(Connection_Pooler, "Connection Pooler", "PgBouncer", "Manages incoming database connections to prevent connection exhaustion under high concurrency.")
    Component(Encryption_Manager, "Encryption Manager", "PostgreSQL TDE / pgcrypto", "Enforces AES-256 encryption at rest for HIPAA and GDPR compliance.")
    Component(Failover_Coordinator, "Failover Coordinator", "Patroni / etcd", "Enables automated leader election and failover for high availability.")
    Component(Backup_Archiving_Agent, "Backup & Archiving Agent", "Barman / pgBackRest", "Handles continuous WAL archiving and point-in-time recovery for long-term retention.")
    Component(Row_Level_Security_Policy_Engine, "Row-Level Security Policy Engine", "PostgreSQL RLS", "Enforces database-level multi-tenant security and context-aware access policies per query.")
}

Rel(Connection_Pooler, Primary_DB_Instance, "Pools and forwards database connections", "TCP / TLS")
Rel(Primary_DB_Instance, Read_Replica, "Streams transaction logs", "TCP / Streaming Replication")
Rel(Failover_Coordinator, Primary_DB_Instance, "Health checks and consensus state management", "TCP / HTTP")
Rel(Failover_Coordinator, Read_Replica, "Health checks and consensus state management", "TCP / HTTP")
Rel(Backup_Archiving_Agent, Primary_DB_Instance, "Pulls database backups and WAL streams", "TCP / SSH/TLS")
@enduml