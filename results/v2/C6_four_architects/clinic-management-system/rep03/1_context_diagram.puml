@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "Patients interacting with the clinic for scheduling and accessing their records.")
Person(Doctors, "Doctors", "Medical professionals managing patient EMR and diagnoses.")
Person(Administrators, "Administrators", "Clinic staff managing admissions, scheduling, and overall system administration.")

System(Clinic_Management_System, "Clinic Management System", "Manages patient admissions, EMR, scheduling, and billing for clinics via a hybrid cloud architecture, ensuring HIPAA/GDPR compliance and high availability.")

System_Ext(Identity_Provider, "Identity Provider", "Handles authentication via OIDC/SAML.")
System_Ext(Third_Party_Billing_Gateway, "Third-Party Billing Gateway", "Processes clinic billing transactions.")
System_Ext(External_Lab_Imaging_Systems, "External Lab/Imaging Systems", "External systems communicating via HL7 FHIR.")
System_Ext(Notification_Gateway, "Notification Gateway", "Sends notifications to users.")
System_Ext(Cloud_Backup_Archive, "Cloud Backup Archive", "Stores long-term data retention and backups using S5/HTTPS with AES-256.")

Rel(Patients, Clinic_Management_System, "Accesses portal for appointments and records", "HTTPS / WSS over TLS 1.3")
Rel(Doctors, Clinic_Management_System, "Manages EMR and patient schedules", "HTTPS / WSS over TLS 1.3")
Rel(Administrators, Clinic_Management_System, "Manages clinic admissions, scheduling, and billing", "HTTPS / WSS over TLS 1.3")
Rel(Clinic_Management_System, Identity_Provider, "Authenticates users", "OIDC / SAML")
Rel(Clinic_Management_System, Third_Party_Billing_Gateway, "Processes payments and financial transactions", "HTTPS / REST")
Rel(Clinic_Management_System, External_Lab_Imaging_Systems, "Exchanges lab and imaging data", "HL7 FHIR over REST/JSON")
Rel(Clinic_Management_System, Notification_Gateway, "Triggers notifications", "HTTPS / REST")
Rel(Clinic_Management_System, Cloud_Backup_Archive, "Performs long-term data archiving", "S5 / HTTPS with AES-256")

@enduml