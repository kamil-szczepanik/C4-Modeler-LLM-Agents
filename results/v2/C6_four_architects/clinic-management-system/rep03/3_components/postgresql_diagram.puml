@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL container

Container_Boundary(postgresql, "PostgreSQL") {
    Component(PgBouncer, "PgBouncer", "PgBouncer", "Connection pooling and multiplexing to prevent resource exhaustion.")
    Component(PostgreSQL_Primary_Instance, "PostgreSQL Primary Instance", "PostgreSQL 15+ / AES-256", "Relational data storage for EMR and scheduling with AES-256 encryption at rest.")
    Component(PostgreSQL_Standby_Replica, "PostgreSQL Standby Replica", "PostgreSQL 15+", "Standby replica(s) providing high availability and read scalability.")
    Component(Row_Level_Security_RLS_Policy_Engine, "Row-Level Security (RLS) Policy Engine", "PostgreSQL RLS", "Applies context-aware database queries and enforces data access policies.")
    Component(Logical_Replication_CDC_Publisher, "Logical Replication / CDC Publisher", "PostgreSQL CDC", "Publishes table mutations to the message broker.")
    Component(Backup_Agent, "Backup Agent", "Backup Agent", "Streams encrypted WAL archives and snapshots to cloud backup storage.")
    Component(Encryption_Manager, "Encryption Manager", "pgcrypto / KMS Integration", "Encrypts and decrypts sensitive fields using transparent data encryption and column-level hashing.")
}

Rel(PgBouncer, PostgreSQL_Primary_Instance, "Forwarded transactions", "TCP / TLS")
Rel(PostgreSQL_Primary_Instance, PostgreSQL_Standby_Replica, "Streaming replication", "TCP / TLS")
Rel(PostgreSQL_Primary_Instance, Logical_Replication_CDC_Publisher, "Publishes table mutations", "TCP / PostgreSQL Wire Protocol")
Rel(Backup_Agent, PostgreSQL_Primary_Instance, "Manages and streams encrypted WAL archives", "")
Rel(PostgreSQL_Primary_Instance, Encryption_Manager, "Encrypts/decrypts sensitive fields", "Internal C Extension / KMS API")

@enduml