@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Service container

Container_Boundary(integration_service, "Integration Service") {
    Component(Camel_Route_Orchestrator, "Camel Route Orchestrator", "Apache Camel / Spring Boot", "Orchestrates integration patterns and data flows between external healthcare systems and internal microservices.")
    Component(FHIR_Validator, "FHIR Validator", "HAPI FHIR Validator", "Performs strict HL7 FHIR profile validation for all incoming and outgoing interoperability messages.")
    Component(mTLS_Communication_Handler, "mTLS Communication Handler", "HTTPS with mTLS", "Secures external communications with lab and imaging systems using mutual TLS.")
}

Rel(Camel_Route_Orchestrator, FHIR_Validator, "Validates payloads")
Rel(Camel_Route_Orchestrator, mTLS_Communication_Handler, "Sends secure requests to external systems")

@enduml