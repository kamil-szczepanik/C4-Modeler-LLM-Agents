@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(web_frontend, "Web Frontend") {
    Component(spa_router_ui, "SPA Router & UI", "React / TypeScript", "Powers the frontend single-page application with client-side routing and strict CSP.")
    Component(web_server, "Web Server", "NGINX", "Serves static frontend assets and handles secure TLS termination.")
}

Rel(spa_router_ui, web_server, "Loads assets via", "")

@enduml