@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Message Broker container

System_Ext(Core_Microservices, "Core Microservices", "Core services of the system")
System_Ext(Background_Worker, "Background Worker", "Asynchronous processing worker")
System_Ext(Integration_Service, "Integration Service", "External integration service")
System_Ext(Audit_Compliance_Logging, "Audit & Compliance Logging", "Audit and compliance logging system")

Container_Boundary(message_broker, "Message Broker") {
    Component(Kafka_Broker_Nodes, "Kafka Broker Nodes", "Apache Kafka (KRaft mode)", "Provides immutable append-only event logs in KRaft mode, satisfying 10-year data retention and HIPAA audit requirements.")
    Component(Schema_Registry, "Schema Registry", "Kafka Schema Registry", "Manages and validates data schemas for messages flowing through the event streams.")
    Component(Kafka_Connect, "Kafka Connect", "Kafka Connect", "Integrates external data sources and sinks with the message broker ecosystem.")
    Component(Kafka_REST_Proxy, "Kafka REST Proxy", "Kafka REST Proxy", "Exposes RESTful APIs for interacting with the Kafka cluster, allowing HTTP-based ingestion from integration services.")
    Component(Access_Control_List_ACL_Authorizer, "Access Control List (ACL) Authorizer", "Kafka Security ACLs", "Validates client credentials and topic permissions via internal gRPC.")
    Component(Encryption_Key_Manager, "Encryption & Key Manager", "TLS 1.3 & AES-256 Key Management", "Encrypts sensitive EMR and demographic payloads at rest and in transit.")
    Component(Partition_Rebalancer_Controller, "Partition Rebalancer / Controller", "KRaft Controller", "Manages metadata and partition leadership without ZooKeeper overhead.")
    Component(Dead_Letter_Queue_DLQ_Manager, "Dead Letter Queue (DLQ) Manager", "Kafka DLQ Pattern", "Handles poisoned or unprocessable messages for asynchronous debugging and recovery.")
    Component(Topic_Mirroring_Agent, "Topic Mirroring Agent", "MirrorMaker 2", "Synchronizes partition logs bidirectionally across hybrid boundaries for high availability.")
    Component(Metrics_Telemetry_Exporter, "Metrics & Telemetry Exporter", "Prometheus Exporter / Kafka Telemetry", "Exports broker metrics and telemetry data for system observability.")
}

Rel(Core_Microservices, Kafka_Broker_Nodes, "Publishes domain events", "TCP / TLS 1.3 (Kafka protocol)")
Rel(Kafka_Broker_Nodes, Background_Worker, "Consumes streaming events for asynchronous processing", "TCP / TLS 1.3 (Kafka protocol)")
Rel(Integration_Service, Kafka_REST_Proxy, "Ingests external lab/imaging messages via authenticated HTTP", "HTTPS / TLS 1.3")
Rel(Access_Control_List_ACL_Authorizer, Kafka_Broker_Nodes, "Validates client credentials and topic permissions", "Internal gRPC / TLS 1.3")
Rel(Kafka_Broker_Nodes, Encryption_Key_Manager, "Encrypts sensitive EMR and demographic payloads at rest", "Internal API / TLS 1.3")
Rel(Topic_Mirroring_Agent, Kafka_Broker_Nodes, "Synchronizes partition logs bidirectionally across hybrid boundary", "Kafka Protocol / TLS 1.3")
Rel(Kafka_Broker_Nodes, Audit_Compliance_Logging, "Streams audit trails and security events", "gRPC / TLS 1.3")

@enduml