@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Caching & Session Container container

Container_Boundary(caching_session_container, "Caching & Session Container") {
    Component(Session_Manager, "Session Manager", "Redis Enterprise", "Manages user sessions and authentication states.")
    Component(EMR_Cache_Aside, "EMR Cache-Aside", "Redis Modules (ReJSON, RedisBloom)", "Enables structured EMR caching and partial document caching.")
    Component(Cluster_Coordination, "Cluster Coordination", "Redis Enterprise", "Synchronizes CRDT state across hybrid regions.")
    Component(Data_Masking_Encryption, "Data Masking & Encryption", "Redis Enterprise Security Module", "Enforces in-memory encryption and AES-256 for HIPAA/GDPR compliance.")
    Component(Eviction_TTL_Policy_Manager, "Eviction & TTL Policy Manager", "Redis Enterprise", "Manages data lifecycles, TTLs, and eviction policies.")
    Component(Redis_Core_Storage_Engine, "Redis Core Storage Engine", "Redis Enterprise", "Provides high-performance in-memory data storage.")
}

System_Ext(External_Redis_Enterprise_Peers, "External Redis Enterprise Peers", "External Redis Enterprise cluster peers in hybrid regions.")
System_Ext(Audit_Compliance_Logging, "Audit & Compliance Logging", "System for recording audit and compliance logs.")

Rel(Cluster_Coordination, External_Redis_Enterprise_Peers, "Synchronizes CRDT state across hybrid regions", "Encrypted TCP / TLS 1.3")
Rel(Data_Masking_Encryption, Audit_Compliance_Logging, "Sends audit logs", "Syslog / gRPC")

@enduml