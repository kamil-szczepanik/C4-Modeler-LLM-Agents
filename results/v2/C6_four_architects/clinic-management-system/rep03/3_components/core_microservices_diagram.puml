@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Microservices container

System_Ext(api_Gateway, "API Gateway", "External API Gateway")
ContainerDb(caching_Session_Container, "Caching & Session Container", "Redis Enterprise", "Manages caching, sessions, and distributed locks")
System_Ext(audit_Compliance_Logging, "Audit & Compliance Logging", "External System", "Auditing and compliance logging")
System_Ext(integration_Service, "Integration Service", "External System", "Integration service for external health records")
System_Ext(message_Broker, "Message Broker", "Apache Kafka", "Asynchronous event messaging broker")
ContainerDb(postgresql, "PostgreSQL", "PostgreSQL", "Relational data persistence with AES-256 encryption at rest")

Container_Boundary(core_microservices, "Core Microservices") {
    Component(core_api_dispatcher, "Core API Dispatcher", "Go", "Dispatches and routes validated API requests.")
    Component(access_control_policy_enforcement_component, "Access Control & Policy Enforcement Component", "Spring Boot", "Evaluates permissions and enforces access policies.")
    Component(patient_admissions_component, "Patient Admissions Component", "Go", "Manages patient admissions.")
    Component(scheduling_component, "Scheduling Component", "Spring Boot", "Handles appointment scheduling and acquires distributed locks.")
    Component(emr_component, "EMR Component", "Spring Boot", "Manages electronic medical records and dispatches audit events.")
    Component(billing_component, "Billing Component", "Go", "Manages billing for hospitals and clinics.")
    Component(fhir_interoperability_component, "FHIR Interoperability Component", "Go", "Transmits standardized health records.")
    Component(internal_event_dispatcher, "Internal Event Dispatcher", "Go", "Publishes domain events to the message broker.")
    Component(data_encryption_anonymization_component, "Data Encryption & Anonymization Component", "Go", "Persists encrypted clinical data and handles encryption/anonymization.")
    Component(database_repository_abstraction_layer, "Database Repository Abstraction Layer", "Go/Spring Data", "Provides database abstraction for persistence.")
}

Rel(api_Gateway, core_api_dispatcher, "Routes validated requests", "gRPC / mTLS")
Rel(core_api_dispatcher, access_control_policy_enforcement_component, "Evaluates permissions", "In-process method call / gRPC")
Rel(scheduling_component, caching_Session_Container, "Acquires distributed locks", "Redis Protocol / TLS")
Rel(emr_component, audit_Compliance_Logging, "Dispatches audit events", "gRPC")
Rel(fhir_interoperability_component, integration_Service, "Transmits standardized health records", "gRPC / mTLS")
Rel(internal_event_dispatcher, message_Broker, "Publishes domain events", "AMQP / TLS")
Rel(data_encryption_anonymization_component, postgresql, "Persists encrypted clinical data", "SQL / TLS")

@enduml