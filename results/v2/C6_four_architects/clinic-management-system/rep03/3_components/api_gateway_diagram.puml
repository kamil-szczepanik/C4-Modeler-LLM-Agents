@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(tls, "TLS Termination & Routing Engine", "Kong / NGINX", "Handles incoming client connections, terminates TLS, and routes traffic.")
    Component(auth, "Auth & Token Introspection Plugin", "Kong Plugin", "Validates user tokens against the Identity Provider.")
    Component(ratelimit, "Rate Limiting & Threat Protection Component", "Kong Plugin", "Protects against threats and enforces rate-limiting to meet uptime constraints.")
    Component(audit, "Audit & Request Correlation Interceptor", "Kong Plugin", "Forwards access logs and security events to audit and compliance logging.")
    Component(transform, "Request Transformation & Payload Validation Engine", "Kong Plugin", "Transforms requests and validates payloads before routing.")
    Component(cache, "Edge Caching & Session Store Component", "Kong Plugin / Redis", "Manages edge caching and session state.")
}

System_Ext(identity_provider, "Identity Provider", "External identity provider for authentication and token management.")
System_Ext(audit_logging, "Audit & Compliance Logging", "OpenSearch / Logging system for compliance and audit trails.")
System(core_microservices, "Core Microservices", "Go / Spring Boot backend microservices.")

Rel(auth, identity_provider, "Validates user tokens", "HTTPS / OIDC")
Rel(audit, audit_logging, "Forwards access logs and security events", "gRPC / mTLS")
Rel(tls, core_microservices, "Routes validated traffic", "gRPC / Internal mTLS")

@enduml