@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Object Storage container

System_Ext(Core_Microservices, "Core Microservices", "External core microservices")
System_Ext(Replication_Erasure_Coding_Manager_Remote, "Replication & Erasure Coding Manager (Remote)", "Remote replication manager")
System_Ext(Cloud_Backup_Archive, "Cloud Backup Archive", "Secondary cloud region backup storage")
System_Ext(Audit_Compliance_Logging, "Audit & Compliance Logging", "System logging and audit service")

Container_Boundary(Object_Storage, "Object Storage") {
    Component(Storage_API_Gateway, "Storage API Gateway", "MinIO / S3 API", "Provides object storage compatible APIs for scalable medical imaging and document storage.")
    Component(Encryption_Compliance_Engine, "Encryption & Compliance Engine", "HashiCorp Vault / OpenSSL", "Enforces mandatory AES-256 server-side encryption at rest for HIPAA/GDPR compliance.")
    Component(Replication_Erasure_Coding_Manager, "Replication & Erasure Coding Manager", "Reed-Solomon Erasure Coding", "Ensures multi-node data redundancy for high availability.")
    Component(Lifecycle_Retention_Manager, "Lifecycle & Retention Manager", "S3 Object Lock & ILM Rules", "Manages automated tiering and object-locking for mandatory >= 10-year retention.")
    Component(Metadata_Index_Catalog, "Metadata & Index Catalog", "Embedded RocksDB", "Delivers fast local metadata lookups and versioning states across distributed nodes.")
    Component(Integrity_Health_Monitor, "Integrity & Health Monitor", "SHA-256", "Performs continuous background bit-rot checks and integrity verification.")
}

Rel(Core_Microservices, Storage_API_Gateway, "Uploads/retrieves EMR attachments and DICOM medical imaging", "HTTPS/REST")
Rel(Storage_API_Gateway, Encryption_Compliance_Engine, "Delegates cryptographic operations", "Internal gRPC")
Rel(Storage_API_Gateway, Metadata_Index_Catalog, "Queries object metadata", "Internal IPC/Memory")
Rel(Replication_Erasure_Coding_Manager, Replication_Erasure_Coding_Manager_Remote, "Synchronizes data blocks across on-premise Kubernetes and eu-central-1", "mTLS/TCP")
Rel(Lifecycle_Retention_Manager, Cloud_Backup_Archive, "Replicates historical medical records to secondary cloud region", "HTTPS/S3 API")
Rel(Encryption_Compliance_Engine, Audit_Compliance_Logging, "Streams audit trails and integrity anomalies", "gRPC")
Rel(Integrity_Health_Monitor, Audit_Compliance_Logging, "Streams audit trails and integrity anomalies", "gRPC")

@enduml