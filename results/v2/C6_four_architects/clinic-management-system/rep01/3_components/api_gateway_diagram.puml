@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway_boundary, "API Gateway") {
    Component(Routing_and_Proxy_Module, "Routing and Proxy Module", "Kong / Envoy", "Routes incoming encrypted UI requests to core services and EMR services via gRPC over mTLS.")
    Component(Rate_Limiting_Module, "Rate Limiting Module", "Redis Sidecar", "Tracks distributed rate limits using RESP over TCP with TLS.")
    Component(Security_and_Key_Management_Integration, "Security and Key Management Integration", "HashiCorp Vault / AWS KMS Client", "Validates keys and secrets securely via HTTPS/REST.")
}

System(Core_Services_Container, "Core Services Container", "Java, Spring Boot")
System(EMR_Service, "EMR Service", "Node.js, TypeScript")
System_Ext(Key_Management_Service, "Key Management Service", "HashiCorp Vault, AWS KMS")
System_Ext(Redis_Sidecar, "Redis Sidecar", "Redis Cache")

Rel(Routing_and_Proxy_Module, Core_Services_Container, "Routes business logic traffic", "gRPC over mTLS")
Rel(Routing_and_Proxy_Module, EMR_Service, "Routes electronic medical records traffic", "gRPC over mTLS")
Rel(Routing_and_Proxy_Module, Key_Management_Service, "Validates keys and secrets", "HTTPS/REST")
Rel(Routing_and_Proxy_Module, Redis_Sidecar, "Tracks distributed rate limits", "RESP over TCP with TLS")

@enduml