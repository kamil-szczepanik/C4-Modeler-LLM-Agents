@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Worker container

Container_Boundary(integration_worker, "Integration Worker") {
    Component(Route_Orchestrator, "Route Orchestrator", "Apache Camel / Python", "Orchestrates integration routes and message flow within the Integration Worker.")
    Component(FHIR_Transformer, "FHIR Transformer", "Apache Camel / Python", "Transforms clinical data into HL7 FHIR formats for external exchange.")
    Component(Connector_Client, "Connector Client", "Apache Camel / Python", "Handles outbound and inbound connections to external lab, imaging, and insurance systems.")
    Component(Security_Enforcer, "Security Enforcer", "Apache Camel / Python", "Enforces security policies, compliance, and mTLS verification.")
    Component(DLQ_Handler, "DLQ Handler", "Apache Camel / Python", "Manages dead-letter queues and failed message processing.")
    Component(Worker_Health_Monitor, "Worker Health Monitor", "Apache Camel / Python", "Monitors the health and operational status of the Integration Worker components.")
}

Rel(Route_Orchestrator, FHIR_Transformer, "Passes raw messages for clinical data transformation", "Internal Pipeline")
Rel(Route_Orchestrator, Connector_Client, "Delegates message dispatch to external systems", "Internal Pipeline")
Rel(Security_Enforcer, Route_Orchestrator, "Validates security and compliance for routed messages", "Security Check")
Rel(Route_Orchestrator, DLQ_Handler, "Routes failed messages upon processing errors", "Error Handling")
Rel(Worker_Health_Monitor, Route_Orchestrator, "Monitors operational health", "Telemetry")

@enduml