@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Global Load Balancer container

Container_Boundary(global_load_balancer, "Global Load Balancer") {
    Component(Geo-DNS Resolver, "Geo-DNS Resolver", "AWS Route 53", "Ensures intelligent global routing and 99.99% uptime.")
    Component(Anycast Traffic Manager, "Anycast Traffic Manager", "Envoy Proxy / BGP Anycast", "Routes resolved client traffic and forwards incoming requests to regional entry points.")
    Component(Health Check Prober, "Health Check Prober", "Envoy Health Check Service", "Performs active health probes and reports regional degradation metrics.")
    Component(Traffic Routing Policy Engine, "Traffic Routing Policy Engine", "Open Policy Agent (OPA) / Custom Lua in Envoy", "Evaluates dynamic failover, GDPR data residency policies, and queries dynamic routing decisions.")
    Component(API Gateway, "API Gateway", "Kong / Envoy", "Handles incoming requests at regional entry points.")
    Component(Key Management Service (KMS), "Key Management Service (KMS)", "HashiCorp Vault / AWS KMS", "Retrieves TLS certificates and cipher suites, securing sensitive data.")
    Component(Observability Collector, "Observability Collector", "OpenTelemetry / Prometheus / Grafana Loki", "Provides centralized metrics collection across the hybrid deployment.")
}

Rel(Geo-DNS Resolver, Anycast Traffic Manager, "Routes resolved client traffic", "TCP/IP")
Rel(Anycast Traffic Manager, API Gateway, "Forwards incoming requests to regional entry points", "HTTPS/gRPC")
Rel(Anycast Traffic Manager, Key Management Service (KMS), "Retrieves TLS certificates and cipher suites", "gRPC over mTLS")
Rel(Anycast Traffic Manager, Traffic Routing Policy Engine, "Queries dynamic routing decisions", "In-process gRPC/Lua")
Rel(Health Check Prober, API Gateway, "Performs active health probes", "HTTPS/GET")
Rel(Health Check Prober, Observability Collector, "Reports regional degradation metrics", "gRPC/OTLP")
Rel(Traffic Routing Policy Engine, Health Check Prober, "Subscribes to real-time regional health status", "In-memory event stream")

@enduml