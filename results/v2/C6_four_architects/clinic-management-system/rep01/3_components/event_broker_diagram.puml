@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Event Broker container

System_Ext(kms, "Key Management Service (KMS)", "HashiCorp Vault / AWS KMS")

Container_Boundary(event_broker, "Event Broker") {
    Component(kafka_nodes, "Kafka Broker Nodes (KRaft)", "Apache Kafka (KRaft mode)", "Manages event streaming and consensus without ZooKeeper.")
    Component(schema_registry, "Confluent Schema Registry", "Confluent", "Enforces data schemas and serialization formats for messages.")
    Component(kafka_connect, "Kafka Connect", "Apache Kafka Connect", "Integrates external data sources and sinks with the event broker.")
    Component(interceptor, "Client-Side Interceptor Component", "Custom Kafka Interceptor", "Applies envelope encryption and security headers to messages.")
    Component(mirror_maker, "Kafka MirrorMaker 2", "Apache MirrorMaker 2", "Handles cross-datacenter topic replication between on-prem and AWS.")
    Component(acl, "Topic Authorization & Access Control Component (Kafka ACLs)", "Kafka ACLs", "Enforces fine-grained access control and topic-level permissions.")
    Component(cruise_control, "Broker Health & Partition Rebalancer (Kafka Cruise Control)", "Kafka Cruise Control", "Automates partition rebalancing and monitors broker health.")
    Component(dlq, "Dead Letter Queue (DLQ) Manager", "Kafka DLQ Pattern", "Captures and routes failed message processing attempts.")
}

Rel(kafka_nodes, kms, "Fetches encryption keys", "gRPC over mTLS")
Rel(mirror_maker, kafka_nodes, "Replicates topics cross-datacenter", "Kafka over mTLS")

@enduml