@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Key Management Service (KMS) container

System_Ext(AWS_KMS, "AWS KMS", "External cloud KMS provider")
System_Ext(AWS_S3_Glacier, "AWS S3 Glacier", "Cloud backup storage for KMS snapshots")

Container_Boundary(kms_container, "Key Management Service (KMS)") {
    Component(Access_Control___Policy_Enforcer, "Access Control & Policy Enforcer", "OPA / Vault ACLs", "Enforces policies and access control for keys and policies via zero-trust boundaries.")
    Component(Key_Manager_Component, "Key Manager Component", "Java / Spring Vault SDK", "Manages cryptographic keys, executing hardware-backed operations and orchestrating replication.")
    Component(Crypto_Worker_Component, "Crypto-Worker Component", "Go", "Performs low-level cryptographic operations and processing.")
    Component(Transit_Secrets_Engine_Component, "Transit Secrets Engine Component", "HashiCorp Vault Transit", "Provides cryptographic primitives as a service (transit encryption).")
    Component(Secrets_Engine_Component, "Secrets Engine Component", "HashiCorp Vault KV", "Stores and manages key-value secrets securely.")
    Component(Key_Rotation_Worker, "Key Rotation Worker", "Go / Cron", "Automatically rotates cryptographic keys on a scheduled basis.")
    Component(Key_Expiry___Revocation_Manager, "Key Expiry & Revocation Manager", "Go", "Manages the lifecycle, expiry, and revocation of cryptographic keys.")
    Component(Key_Sync___Replication_Manager, "Key Sync & Replication Manager", "Go", "Replicates encrypted key metadata across nodes using consensus protocols.")
    Component(HSM_Integration_Layer, "HSM Integration Layer", "PKCS#11 wrapper", "Interfaces with Hardware Security Modules for hardware-backed cryptographic operations.")
    Component(External_KMS_Interoperability_Adapter, "External KMS Interoperability Adapter", "Go / AWS SDK", "Synchronizes cloud-native cryptographic primitives with external KMS providers.")
    Component(Key_Health___Readiness_Probe, "Key Health & Readiness Probe", "Go", "Monitors and reports the health and readiness status of the key management infrastructure.")
    Component(Backup___Recovery_Agent, "Backup & Recovery Agent", "Python / Go", "Exports encrypted KMS snapshots and key metadata to cloud backup storage.")
}

Rel(Key_Manager_Component, HSM_Integration_Layer, "Executes hardware-backed cryptographic operations", "PKCS#11 / TLS 1.3")
Rel(Key_Manager_Component, Key_Sync___Replication_Manager, "Replicates encrypted key metadata", "Raft Consensus / TLS 1.3")
Rel(External_KMS_Interoperability_Adapter, AWS_KMS, "Synchronizes cloud-native cryptographic primitives", "HTTPS/REST with SigV4 and TLS 1.3")
Rel(Backup___Recovery_Agent, AWS_S3_Glacier, "Exports encrypted KMS snapshots and key metadata", "HTTPS/REST with AWS SigV4")

@enduml