@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the EMR Service container

Container_Boundary(emr_service, "EMR Service") {
    Component(EMR_API_Controller, "EMR API Controller", "Express.js / Fastify", "Manages patient admissions, scheduling, and API requests.")
    Component(CDR_Manager, "CDR Manager", "Prisma ORM / Node.js", "Manages electronic medical records and queries clinical data.")
    Component(Caching_Layer, "Caching Layer", "Redis / Dragonfly", "Caches hot patient records to guarantee low-latency load times.")
    Component(Encryption_Masking_Engine, "Encryption & Masking Engine", "Node.js crypto / Vault SDK", "Encrypts and decrypts PII fields for compliance.")
    Component(Audit_Trail_Interceptor, "Audit Trail Interceptor", "TypeScript Middleware", "Publishes immutable audit logs for security tracking.")
    Component(FHIR_Transformation_Engine, "FHIR Transformation Engine", "HAPI FHIR / TypeScript mapper", "Transforms clinical events and publishes FHIR payloads.")
}

System_Ext(Database_Layer, "Database Layer", "Encrypted relational data storage")
System_Ext(Audit_Log_Store, "Audit Log Store", "Secure storage for compliance logs")
System_Ext(Event_Broker, "Event Broker", "Apache Kafka event backbone")

Rel(EMR_API_Controller, CDR_Manager, "Queries clinical data", "In-memory TypeScript function calls")
Rel(CDR_Manager, Caching_Layer, "Reads/writes hot patient records", "In-memory Redis protocol")
Rel(CDR_Manager, Database_Layer, "Queries and persists EMR data", "Encrypted PostgreSQL wire protocol")
Rel(EMR_API_Controller, Encryption_Masking_Engine, "Encrypts/decrypts PII fields", "In-memory function calls")
Rel(Audit_Trail_Interceptor, Audit_Log_Store, "Publishes immutable audit logs", "Encrypted TLS / HTTPS")
Rel(FHIR_Transformation_Engine, Event_Broker, "Consumes clinical events and publishes FHIR payloads", "Kafka Protocol over TLS")

@enduml