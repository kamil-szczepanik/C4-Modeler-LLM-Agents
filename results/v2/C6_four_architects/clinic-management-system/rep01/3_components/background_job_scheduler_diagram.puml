@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Background Job Scheduler container

Container_Boundary("Background Job Scheduler", "Background Job Scheduler") {
    Component("Temporal Frontend Service", "Temporal Frontend Service", "Go", "Handles incoming client requests and routes workflow commands.")
    Component("Temporal History Service", "Temporal History Service", "Go", "Manages workflow state and history events.")
    Component("Temporal Matching Service", "Temporal Matching Service", "Go", "Matches workflow tasks to available workers.")
    Component("Temporal Worker Service", "Temporal Worker Service", "Go", "Executes workflow and activity tasks.")
    ComponentDb("Temporal Persistence Layer", "Temporal Persistence Layer", "PostgreSQL", "Stores persistent state, schedules, and workflow data with ACID compliance.")
    Component("Temporal Cluster Membership", "Temporal Cluster Membership", "Go/Ringpop", "Provides gossip-based node discovery and cluster health management.")
    Component("Temporal Crypt Interceptor", "Temporal Crypt Interceptor", "Go", "Secures Protected Health Information (PHI) via application-layer payload encryption.")
}

System_Ext("Key Management Service (KMS)", "Key Management Service (KMS)", "Manages cryptographic keys for payload encryption.")

Rel("Temporal Frontend Service", "Temporal History Service", "gRPC")
Rel("Temporal History Service", "Temporal Matching Service", "gRPC")
Rel("Temporal Matching Service", "Temporal Worker Service", "gRPC")
Rel("Temporal History Service", "Temporal Persistence Layer", "SQL/CQL over TLS")
Rel("Temporal Matching Service", "Temporal Persistence Layer", "SQL/CQL over TLS")
Rel("Temporal Frontend Service", "Temporal Cluster Membership", "gRPC / Custom TCP")
Rel("Temporal History Service", "Temporal Cluster Membership", "gRPC / Custom TCP")
Rel("Temporal Matching Service", "Temporal Cluster Membership", "gRPC / Custom TCP")
Rel("Temporal Worker Service", "Temporal Cluster Membership", "gRPC / Custom TCP")
Rel("Temporal Frontend Service", "Temporal Crypt Interceptor", "In-memory Go interface")
Rel("Temporal History Service", "Temporal Crypt Interceptor", "In-memory Go interface")
Rel("Temporal Crypt Interceptor", "Key Management Service (KMS)", "HTTPS/REST over mTLS")

@enduml