@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "Kong/Envoy", "Executes all data queries, mutations, and authentication")
System_Ext(observability, "Observability & Monitoring Collector", "OpenTelemetry / Prometheus / Grafana Loki", "Collects performance and error metrics")

Container_Boundary(web_frontend, "Web Frontend") {
    Component(routing_shell, "Routing & Shell", "React / TypeScript", "Manages application navigation, layout, and view routing.")
    Component(auth_module, "Auth & Session Module", "React / TypeScript", "Handles user authentication, session state, and security tokens.")
    Component(feature_modules, "Feature Modules", "React / TypeScript", "Contains clinical UI modules for patient admissions, EMR, scheduling, and billing.")
    Component(api_client, "API Client & Interceptor", "Axios / Fetch", "Centralizes API interception, token injection, and server-state communication.")
    Component(state_cache_manager, "Local State & Cache Manager", "TanStack Query / Redux Toolkit", "Manages server-state caching and local application state for sub-second EMR load times.")
    Component(telemetry_agent, "Telemetry Agent", "OpenTelemetry JS SDK", "Tracks and exports client performance and error metrics.")
}

Rel(feature_modules, api_client, "Uses", "")
Rel(api_client, api_gateway, "Executes data queries, mutations, and authentication", "HTTPS/REST, WSS")
Rel(auth_module, api_client, "Uses", "")
Rel(state_cache_manager, api_client, "Uses", "")
Rel(telemetry_agent, observability, "Exports client performance and error metrics", "gRPC/OTLP over TLS")
@enduml