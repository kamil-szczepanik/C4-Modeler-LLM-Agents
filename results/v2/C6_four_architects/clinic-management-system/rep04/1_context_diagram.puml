@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Doctors, "Doctors", "Clinical staff responsible for patient medical records and care.")
Person(Nurses, "Nurses", "Clinical staff assisting with patient admissions and care management.")
Person(Receptionists, "Receptionists", "Administrative staff managing patient scheduling and front-desk admissions.")
Person("Billing Staff", "Billing Staff", "Administrative staff handling invoicing and payment processing.")

System_Ext("Identity Provider (IdP)", "Identity Provider (IdP)", "External system providing authentication and OIDC token validation with MFA.")
System_Ext("Payment Gateway", "Payment Gateway", "External system for processing patient and insurance payments.")
System_Ext("Insurance Clearinghouse", "Insurance Clearinghouse", "External system for handling insurance claims and verification.")
System_Ext("External Lab & Imaging Systems", "External Lab & Imaging Systems", "External clinical systems for diagnostic tests and medical imaging.")

System_Boundary("Clinic Management System", "Clinic Management System") {
    Container("Edge API Gateway", "Edge API Gateway", "Envoy/Kong", "Entry point for users, managing traffic routing and security.")
    Container("On-Premises Core Service", "On-Premises Core Service", "Java/Spring Boot", "Local core service managing sensitive patient admissions and low-latency scheduling.")
    Container("Cloud EMR & Billing Services", "Cloud EMR & Billing Services", "Node.js/Python", "Cloud-hosted microservices for electronic medical records and billing.")
    Container("Service Mesh Bridge", "Service Mesh Bridge", "Istio/Linkerd", "Bridge facilitating secure streaming between on-premises and cloud environments.")
    Container("Audit Log Service", "Audit Log Service", "Microservice", "Service responsible for tracking and recording system audit logs.")
}

Rel(Doctors, "Edge API Gateway", "Accesses system features via secure web interface", "HTTPS/TLS with OIDC token validation")
Rel(Nurses, "Edge API Gateway", "Accesses system features via secure web interface", "HTTPS/TLS with OIDC token validation")
Rel(Receptionists, "Edge API Gateway", "Accesses system features via secure web interface", "HTTPS/TLS with OIDC token validation")
Rel("Billing Staff", "Edge API Gateway", "Accesses system features via secure web interface", "HTTPS/TLS with OIDC token validation")

Rel("Edge API Gateway", "On-Premises Core Service", "Routes admission and scheduling requests", "gRPC over TLS and REST/HTTPS")
Rel("Edge API Gateway", "Cloud EMR & Billing Services", "Routes EMR and billing requests", "REST/HTTPS")

Rel("On-Premises Core Service", "External Lab & Imaging Systems", "Exchanges clinical data and lab results", "HL7 FHIR over REST/TLS")
Rel("On-Premises Core Service", "Cloud EMR & Billing Services", "Streams clinical and operational data events via Service Mesh Bridge", "Apache Kafka streaming with mTLS")

@enduml