@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration / FHIR Service container

System_Ext(MessageBroker, "Message Broker / Event Bus", "Apache Kafka", "Publishes and consumes asynchronous domain events.")
System_Ext(DistributedRelationalDatabase, "Distributed Relational Database", "CockroachDB / PostgreSQL", "Persists canonical data.")
System_Ext(FHIRIntegrationBroker, "FHIR Integration Broker", "Apache Camel", "Handles advanced enterprise integration and FHIR transformations.")

Container_Boundary(IntegrationFHIRService, "Integration / FHIR Service") {
    Component(FHIRFacadeController, "FHIR Facade Controller", "Node.js & TypeScript", "Handles incoming FHIR API requests and coordinates routing.")
    Component(AuthenticationSMARTonFHIRAuthorizer, "Authentication & SMART-on-FHIR Authorizer", "Node.js & TypeScript", "Enforces security policies and SMART-on-FHIR authorization.")
    Component(FHIRtoDomainMapper, "FHIR-to-Domain Mapper", "Node.js & TypeScript", "Translates between FHIR resources and internal domain models.")
    Component(OutboundSyncEngine, "Outbound Sync Engine", "Node.js & TypeScript", "Manages outbound synchronization and forwards sync payloads.")
    Component(FHIRStorageRepository, "FHIR Storage Repository", "Node.js & TypeScript", "Interacts with persistent storage for FHIR resources.")
    Component(AuditComplianceInterceptor, "Audit & Compliance Interceptor", "Node.js & TypeScript", "Logs requests and ensures HIPAA/GDPR compliance measures.")
    Component(FHIRProfileValidator, "FHIR Profile Validator", "Node.js & TypeScript", "Validates incoming FHIR payloads against defined profiles.")
    Component(FHIRCachingManager, "FHIR Caching Manager", "Node.js & TypeScript", "Manages caching layers for frequent FHIR resources.")
}

Rel(FHIRFacadeController, FHIRCachingManager, "Caches resources", "TCP over TLS 1.3 to Redis Enterprise")
Rel(IntegrationFHIRService, MessageBroker, "Publishes domain events", "Kafka producer, JSON over TCP")
Rel(IntegrationFHIRService, DistributedRelationalDatabase, "Persists canonical data", "PostgreSQL wire protocol over TLS 1.3")
Rel(OutboundSyncEngine, FHIRIntegrationBroker, "Forwards sync payloads", "gRPC over mTLS")

@enduml