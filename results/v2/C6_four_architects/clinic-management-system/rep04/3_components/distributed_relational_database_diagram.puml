@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Component(Microservices, "Microservices", "PostgreSQL wire protocol over TLS 1.3", "External microservices persisting data.")
Component(KeyManagementService, "Key Management Service (Vault / Cloud KMS)", "HTTPS / REST over TLS 1.3", "External key management service for fetching and rotating keys.")
Component(MessageBroker, "Message Broker (Apache Kafka)", "gRPC / Kafka Protocol over TLS 1.3", "External message broker for publishing change feeds.")

Container_Boundary(DistributedRelationalDatabase, "Distributed Relational Database") {
    Component(ConnectionPoolManager, "Connection & Pool Manager", "Built-in SQL Proxy / PgBouncer", "Manages client connections and pooling.")
    Component(SQLLayer, "SQL Layer (Distributed Query Engine)", "CockroachDB SQL Parser / Optimizer", "Parses and optimizes SQL queries.")
    Component(TransactionCoordinator, "Transaction Coordinator / Raft Consensus Engine", "CockroachDB Raft / Multi-Raft", "Coordinates reads and writes using Raft consensus.")
    Component(StorageEngine, "Storage Engine (RocksDB)", "RocksDB via Go wrapper", "Persists key-value ranges locally.")
    Component(EncryptionSubsystem, "Encryption & Key Management Subsystem", "CockroachDB Enterprise Security / OpenSSL", "Handles encryption and security operations.")
    Component(CDCStreamer, "Change-Data-Capture (CDC) Streamer", "CockroachDB Changefeeds / gRPC", "Streams transactional change feeds.")
}

Rel(Microservices, ConnectionPoolManager, "Persists data", "PostgreSQL wire protocol over TLS 1.3")
Rel(EncryptionSubsystem, KeyManagementService, "Fetches and rotates encryption keys", "HTTPS / REST over TLS 1.3")
Rel(CDCStreamer, MessageBroker, "Publishes transactional change feeds", "gRPC / Kafka Protocol over TLS 1.3")
Rel(ConnectionPoolManager, SQLLayer, "Forwards authenticated queries", "In-memory function calls")
Rel(SQLLayer, TransactionCoordinator, "Coordinates reads and writes", "Multi-Raft")
Rel(TransactionCoordinator, StorageEngine, "Persists key-value ranges locally", "RocksDB API via CGO")
Rel(StorageEngine, TransactionCoordinator, "Persists key-value ranges locally", "RocksDB API via CGO")
@enduml