@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the FHIR Integration Broker container

Component(API_Gateway, "API Gateway", "Gateway Technology", "External API Gateway sending requests.")
Component(Audit_Log_Service, "Audit Log Service", "Audit Service Technology", "Service receiving compliance and audit records.")
Component(External_Lab___Imaging_Systems, "External Lab & Imaging Systems", "External Systems Technology", "External systems receiving outbound data.")
Component(Apache_Kafka, "Apache Kafka", "Distributed Event Broker", "Event broker for reliable asynchronous message delivery.")

Container_Boundary(FHIR_Integration_Broker, "FHIR Integration Broker") {
    Component(FHIR_REST_Endpoint_Listener, "FHIR REST Endpoint Listener", "Apache Camel REST DSL on OpenJDK 17", "Exposes FHIR R4 APIs and listens for incoming requests.")
    Component(HL7_FHIR_Transformation_Engine, "HL7/FHIR Transformation Engine", "HAPI FHIR Java Libraries", "Maps legacy formats to FHIR resources.")
    Component(Message_Router___Enrichener, "Message Router & Enrichener", "Apache Camel Content-Based Router", "Inspects resource types and enriches data.")
    Component(Kafka_Event_Publisher, "Kafka Event Publisher", "Apache Camel Kafka Connector", "Publishes standardized events.")
    Component(Security___Audit_Interceptor, "Security & Audit Interceptor", "Apache Camel policy component", "Enforces OAuth2/JWT validation and audit logging.")
    Component(Outbound_FHIR_Dispatcher, "Outbound FHIR Dispatcher", "Apache Camel HTTP4/Netty component", "Pushes notifications and query responses.")
    Component(Dead_Letter___Retry_Handler, "Dead Letter & Retry Handler", "Apache Camel Dead Letter Channel", "Captures and retries transient failures.")
}

Rel(API_Gateway, FHIR_REST_Endpoint_Listener, "Sends requests", "HTTPS")
Rel(FHIR_REST_Endpoint_Listener, Security___Audit_Interceptor, "Delegates requests", "In-JVM method calls")
Rel(Security___Audit_Interceptor, Audit_Log_Service, "Writes compliance records", "gRPC/TLS")
Rel(Outbound_FHIR_Dispatcher, External_Lab___Imaging_Systems, "Transmits data", "HTTPS (mTLS)")
Rel(Kafka_Event_Publisher, Apache_Kafka, "Send messages", "Kafka Wire Protocol")
Rel(Dead_Letter___Retry_Handler, Apache_Kafka, "Send messages", "Kafka Wire Protocol")

@enduml