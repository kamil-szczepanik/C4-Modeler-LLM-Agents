@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(scheduling_microservice, "Scheduling Microservice") {
    Component(API_Handler, "API Handler", "Go Router/gRPC", "Manages incoming mTLS traffic from the API Gateway.")
    Component(Policy_Consent_Evaluator, "Policy & Consent Evaluator", "Go Middleware + Open Policy Agent", "Enforces HIPAA/GDPR access controls.")
    Component(Scheduling_Engine, "Scheduling Engine", "Go Domain Logic", "Implements core scheduling algorithms and conflict detection.")
    Component(Lock_Manager_Component, "Lock Manager Component", "Redis Enterprise", "Provides distributed locks via TCP/RESP to prevent double-booking.")
    Component(Calendar_Synchronizer, "Calendar Synchronizer", "Go Worker", "Manages asynchronous event publishing using Go channels.")
    Component(Notification_Dispatcher, "Notification Dispatcher", "Go Worker", "Dispatches appointment confirmations and reminders.")
    Component(Data_Access_Layer, "Data Access Layer", "pgx", "Manages connection pooling and executes transactional queries.")
    Component(Message_Broker_Event_Bus, "Message Broker / Event Bus", "Apache Kafka", "Publishes CloudEvents asynchronously.")
}

Rel(API_Handler, Policy_Consent_Evaluator, "Intercepts requests for authorization", "In-memory function/gRPC")
Rel(Scheduling_Engine, Lock_Manager_Component, "Acquires distributed locks", "Redis RESP")
Rel(Scheduling_Engine, Data_Access_Layer, "Commits validated appointments", "PostgreSQL wire protocol over TLS 1.3")
Rel(Scheduling_Engine, Calendar_Synchronizer, "Emits domain events", "Go Channels")
Rel(Calendar_Synchronizer, Message_Broker_Event_Bus, "Publishes CloudEvents", "Apache Kafka")

@enduml