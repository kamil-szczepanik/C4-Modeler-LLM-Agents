@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Observability & Telemetry Collector container

Container_Boundary(observability_telemetry_collector, "Observability & Telemetry Collector") {
    Component(OpenTelemetry_Collector_Gateway, "OpenTelemetry Collector Gateway", "OpenTelemetry Collector", "Receives telemetry data from microservices via gRPC (OTLP).")
    Component(Sampling___Retention_Policy_Enforcer, "Sampling & Retention Policy Enforcer", "OpenTelemetry Policy Engine", "Enforces data sampling and retention policies on collected telemetry.")
    Component(Data_Sanitization_Processor, "Data Sanitization Processor", "OpenTelemetry Processor", "Sanitizes PHI and PII from logs, traces, and metrics to ensure HIPAA and GDPR compliance.")
    Component(Trace___Metrics_Processors, "Trace & Metrics Processors", "OpenTelemetry Processor", "Processes and transforms trace and metric data streams.")
    Component(Destination_Router, "Destination Router", "OpenTelemetry Router", "Dispatches sanitized logs, metrics, and traces to backend monitoring systems.")
    Component(Health___Readiness_Prober, "Health & Readiness Prober", "OpenTelemetry Prober", "Monitors and reports the health and readiness status of the observability pipeline.")
}

Rel(OpenTelemetry_Collector_Gateway, Sampling___Retention_Policy_Enforcer, "Passes incoming telemetry for policy evaluation")
Rel(Sampling___Retention_Policy_Enforcer, Data_Sanitization_Processor, "Sends sampled data for PHI/PII removal")
Rel(Data_Sanitization_Processor, Trace___Metrics_Processors, "Forwards sanitized telemetry for processing")
Rel(Trace___Metrics_Processors, Destination_Router, "Sends processed telemetry to destination router")
Rel(Destination_Router, Prometheus__Loki__and_Elasticsearch, "Dispatches sanitized logs and traces via HTTPS/mTLS", "HTTPS/mTLS")
Rel(Health___Readiness_Prober, OpenTelemetry_Collector_Gateway, "Monitors health status")

@enduml