@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing & Claims Microservice container

Container_Boundary(billing_claims_microservice, "Billing & Claims Microservice") {
    Component(ClaimsController, "ClaimsController", ".NET ASP.NET Core Web API", "Manages secure invoice generation, insurance claim processing, and real-time payment operations.")
    Component(BillingEngine, "BillingEngine", ".NET Class Library", "Enforces strict business orchestration rules and coordinates payment processing.")
    Component(ClaimsProcessor, "ClaimsProcessor", ".NET Class Library", "Processes insurance claims and coordinates external clearinghouse communication.")
    Component(ClearinghouseAdapter, "ClearinghouseAdapter", ".NET HttpClient/WCF", "Handles external integration for insurance claim clearinghouses via HTTPS/SOAP.")
    Component(PaymentGatewayClient, "PaymentGatewayClient", ".NET HttpClient with Polly", "Manages external payment gateway integrations with built-in resilience and circuit-breaking.")
    Component(DataRepository, "DataRepository", "Entity Framework Core", "Database ORM and persistence mapping for billing and claims data.")
    Component(EventPublisher, "EventPublisher", ".NET / Confluent.Kafka", "Asynchronous event publishing using CloudEvents.")
    Component(BillingAuditInterceptor, "BillingAuditInterceptor", "EF Core Interceptor", "Intercepts save operations to ensure HIPAA logging and audit traceability.")
}

System_Ext(apache_kafka, "Apache Kafka", "Asynchronous messaging platform")

Rel(ClaimsController, BillingEngine, "In-memory C# method calls")
Rel(ClaimsController, ClaimsProcessor, "In-memory C# method calls")
Rel(ClaimsProcessor, ClearinghouseAdapter, "External integration", "HTTPS / SOAP")
Rel(BillingEngine, PaymentGatewayClient, "External integration", "HTTPS / REST")
Rel(DataRepository, BillingAuditInterceptor, "Intercepts save operations for HIPAA logging")
Rel(EventPublisher, apache_kafka, "Asynchronous event publishing", "CloudEvents")

@enduml