@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Message Broker / Event Bus container

Person(SRE_Operations, "SRE / Operations", "System Reliability and Operations personnel.")
System_Ext(Core_Clinical_Microservice, "Core Clinical Microservice", "Core clinical operations microservice.")
System_Ext(Audit_Log_Store_Immutable_Object_Storage, "Audit Log Store / Immutable Object Storage", "External storage for audit logs and historical data.")

Container_Boundary(Message_Broker_Event_Bus, "Message Broker / Event Bus") {
    Component(Broker_Cluster, "Broker Cluster", "Apache Kafka", "Manages asynchronous CloudEvents production and consumption across microservices.")
    Component(Schema_Registry, "Schema Registry", "Confluent Schema Registry", "Validates event schemas for services like the Core Clinical Microservice.")
    Component(Kafka_Connect, "Kafka Connect", "Kafka Connect", "Streams audit events and offloads historical data to external storage.")
    Component(Stream_Processor, "Stream Processor", "Apache Flink / Kafka Streams", "Processes data streams within the event bus architecture.")
    Component(Topic_Access_Control_Manager, "Topic Access Control Manager", "Kafka Security Manager", "Manages access controls for messaging topics.")
    Component(DLQ_Manager, "DLQ Manager", "Kafka Dead Letter Queue Handler", "Handles failed message delivery and dead-letter queues.")
    Component(Kafka_UI, "Kafka UI", "Web-based Kafka Management UI", "Provides cluster health monitoring and consumer lag tracking for SRE / Operations.")
}

Rel(Core_Clinical_Microservice, Schema_Registry, "Validates event schemas", "HTTP/REST over TLS")
Rel(Kafka_Connect, Audit_Log_Store_Immutable_Object_Storage, "Streams audit events and offloads historical data", "HTTPS")
Rel(SRE_Operations, Kafka_UI, "Monitors cluster health and consumer lag", "HTTPS")

@enduml