@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Service Mesh container

Container_Boundary(service_mesh, "Service Mesh") {
    Component(SidecarProxyEnvoy, "Sidecar Proxy (Envoy)", "Envoy (C++)", "High-performance proxy for traffic interception and routing.")
    Component(ControlPlaneDiscoveryIstiod, "Control Plane / Discovery (Istiod)", "Istiod (Go)", "Central control plane for service discovery and configuration.")
    Component(AuthorizationPolicyEngine, "Authorization Policy Engine", "Envoy RBAC / SPIFFE/SPIRE", "Enforces zero-trust authorization policies across services.")
    Component(CrossNetworkGateway, "Cross-Network Gateway", "Envoy Multi-Cluster Gateway", "Manages encrypted mTLS traffic between on-premises and AWS environments.")
    Component(TelemetryCollectorAdapter, "Telemetry Collector Adapter", "Envoy OTel extension", "Collects and forwards metrics and traces via OTLP.")
    Component(CertificateAuthorityCAController, "Certificate Authority (CA) Controller", "Istiod CA / Citadel with HashiCorp Vault", "Provides automated X.509 certificate generation and rotation.")
}

Rel(SidecarProxyEnvoy, Microservices, "Secures communication via mTLS", "gRPC/HTTP/2")
Rel(ControlPlaneDiscoveryIstiod, SidecarProxyEnvoy, "Configures and manages", "xDS API (gRPC)")
Rel(SidecarProxyEnvoy, CrossNetworkGateway, "Routes traffic via Encrypted mTLS", "TLS Passthrough/Termination over TCP")
Rel(SidecarProxyEnvoy, TelemetryCollectorAdapter, "Sends telemetry data", "gRPC/OTLP")
Rel(CertificateAuthorityCAController, SidecarProxyEnvoy, "Provides secrets", "Secret Discovery Service (SDS / gRPC)")

@enduml