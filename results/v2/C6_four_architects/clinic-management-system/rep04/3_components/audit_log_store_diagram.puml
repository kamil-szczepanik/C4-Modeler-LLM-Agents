@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit Log Store container

Component(Core_Clinical_Microservice, "Core Clinical Microservice", "Microservice", "Core clinical microservice sending logs to ingestion API.")
Component(Auditor___Compliance_Service, "Auditor / Compliance Service", "External Service", "Accesses compliance query interface for auditing.")
Component(Vault___Cloud_KMS, "Vault / Cloud KMS", "Cloud KMS / Vault", "External key management service for encryption.")
Component(Message_Broker, "Message Broker", "Apache Kafka", "Decoupled, asynchronous event streaming to protect clinical performance.")
Component(Observability___Telemetry_Collector, "Observability & Telemetry Collector", "OpenTelemetry", "Collects telemetry data from the compliance query interface.")

Container_Boundary(Audit_Log_Store, "Audit Log Store") {
    Component(Log_Ingestion_API_Component, "Log Ingestion API Component", "Go / gRPC", "High-performance, secure audit event ingestion.")
    Component(Tamper_Evident_Hashing_Engine, "Tamper-Evident Hashing Engine", "SHA-256 Merkle Tree Processor", "Cryptographic chaining for log immutability and tamper detection.")
    Component(Primary_Storage_Indexer, "Primary Storage Indexer", "Elasticsearch / OpenSearch", "Fast compliance querying with role-based access control.")
    Component(Long_Term_Archival_Manager, "Long-Term Archival Manager", "S3 Glacier Object Lock / WORM Storage", "Cost-effective WORM storage for 10-year retention compliance.")
    Component(Compliance_Query_Interface, "Compliance Query Interface", "REST / HTTPS", "Provides compliance query interface for auditors and compliance services.")
    Component(Key_Management___Encryption_Component, "Key Management & Encryption Component", "HashiCorp Vault Integration", "HSM-backed envelope encryption and zero-knowledge verification.")
}

Rel(Core_Clinical_Microservice, Log_Ingestion_API_Component, "Invokes", "gRPC/TLS")
Rel(Log_Ingestion_API_Component, Tamper_Evident_Hashing_Engine, "Invokes", "Internal Method Call")
Rel(Tamper_Evident_Hashing_Engine, Primary_Storage_Indexer, "Sends data", "Internal Channel")
Rel(Primary_Storage_Indexer, Long_Term_Archival_Manager, "Archives data", "HTTPS")
Rel(Auditor___Compliance_Service, Compliance_Query_Interface, "Queries", "HTTPS/mTLS")
Rel(Tamper_Evident_Hashing_Engine, Key_Management___Encryption_Component, "Requests keys", "gRPC/TLS")
Rel(Primary_Storage_Indexer, Vault___Cloud_KMS, "Encrypts data", "HTTPS (AES-256)")
Rel(Message_Broker, Log_Ingestion_API_Component, "Streams events", "Kafka Consumer Protocol (TLS)")
Rel(Compliance_Query_Interface, Observability___Telemetry_Collector, "Sends telemetry", "OpenTelemetry (gRPC)")

@enduml