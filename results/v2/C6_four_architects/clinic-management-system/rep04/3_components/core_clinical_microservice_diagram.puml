@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(core_clinical_microservice, "Core Clinical Microservice") {
    Component(PatientManagementController, "Patient Management Controller", "Spring Boot Controller", "Handles patient admission and profile HTTP/gRPC requests.")
    Component(EMRServiceBean, "EMR Service Bean", "Spring Service", "Encapsulates business logic for electronic medical records.")
    Component(ClinicalDataRepositoryAdapter, "Clinical Data Repository Adapter", "Spring Data JPA / PostgreSQL Driver", "Manages data access and persistence to the distributed relational database.")
    Component(SecurityContextInterceptor, "Security & Context Interceptor", "Spring Security / OAuth2 / JWT", "Enforces RBAC/ABAC and validates security contexts for incoming requests.")
    Component(ClinicalEventPublisher, "Clinical Event Publisher", "Spring Kafka Template", "Publishes asynchronous clinical events to the message broker.")
    Component(ClinicalCacheManager, "Clinical Cache Manager", "Spring Data Redis", "Reads and invalidates cached records in the state caching layer.")
    Component(AuditComplianceInterceptor, "Audit & Compliance Interceptor", "Spring Aspect / Java Interceptor", "Captures audit logs for HIPAA and GDPR compliance.")
    Component(GlobalExceptionValidationHandler, "Global Exception & Validation Handler", "Spring Web ExceptionHandler", "Handles global validation and exception mapping.")
}

Rel(PatientManagementController, SecurityContextInterceptor, "Passes requests for authentication and authorization", "")
Rel(SecurityContextInterceptor, EMRServiceBean, "Delegates verified requests to business logic", "")
Rel(EMRServiceBean, ClinicalDataRepositoryAdapter, "Executes database transactions", "")
Rel(EMRServiceBean, ClinicalEventPublisher, "Triggers asynchronous events", "")
Rel(EMRServiceBean, ClinicalCacheManager, "Reads and writes session/record states", "")
Rel(EMRServiceBean, AuditComplianceInterceptor, "Logs access for compliance tracking", "")
Rel(PatientManagementController, GlobalExceptionValidationHandler, "Forwards exceptions for uniform handling", "")

@enduml