@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

System_Ext(IdentityProvider, "Identity Provider", "External identity provider for authentication.")
System_Ext(ApacheKafka, "Apache Kafka", "Event bus for audit and logging.")
System_Ext(SpringBootCoreClinical, "Spring Boot Core Clinical", "Core clinical microservice.")
System_Ext(GoScheduling, "Go Scheduling", "Scheduling microservice.")
System_Ext(DotNetBillingClaims, ".NET Billing & Claims", "Billing and claims microservice.")
System_Ext(NodejsIntegrationFHIR, "Node.js Integration/FHIR", "Integration and FHIR microservice.")

Container_Boundary(ApiGateway, "API Gateway") {
    Component(TLSTerminationIngress, "TLS Termination Ingress", "Kong / Envoy", "Handles incoming HTTPS and WSS traffic and terminates TLS.")
    Component(AuthJWTFilter, "Auth & JWT Filter", "Kong / Envoy Plugin", "Performs OIDC and JWKS verification via HTTPS with the Identity Provider.")
    Component(RateLimitingEngine, "Rate Limiting Engine", "Kong / Envoy Plugin", "Enforces traffic rate limits across client requests.")
    Component(RoutingLoadBalancingProxy, "Routing & Load Balancing Proxy", "Kong / Envoy Proxy", "Routes requests to backend microservices using gRPC over mTLS via Istio.")
    Component(AuditRequestLoggingInterceptor, "Audit & Request Logging Interceptor", "Kong / Envoy Plugin", "Sends audit logs and request records to Apache Kafka over mTLS.")
    Component(CircuitBreakerModule, "Circuit Breaker Module", "Kong / Envoy Plugin", "Prevents cascading failures by breaking circuits during service degradation.")
    Component(RequestTransformationFilter, "Request Transformation Filter", "Kong / Envoy Plugin", "Modifies and normalizes incoming request and response payloads.")
    Component(TokenCacheManager, "Token Cache Manager", "Redis / In-Memory Cache", "Caches authentication tokens for fast validation.")
}

Rel(AuthJWTFilter, IdentityProvider, "OIDC / JWKS verification via HTTPS", "HTTPS")
Rel(AuditRequestLoggingInterceptor, ApacheKafka, "Kafka Protocol over mTLS", "Kafka Protocol / mTLS")
Rel(RoutingLoadBalancingProxy, SpringBootCoreClinical, "gRPC over mTLS via Istio", "gRPC / mTLS")
Rel(RoutingLoadBalancingProxy, GoScheduling, "gRPC over mTLS via Istio", "gRPC / mTLS")
Rel(RoutingLoadBalancingProxy, DotNetBillingClaims, "gRPC over mTLS via Istio", "gRPC / mTLS")
Rel(RoutingLoadBalancingProxy, NodejsIntegrationFHIR, "gRPC over mTLS via Istio", "gRPC / mTLS")

@enduml