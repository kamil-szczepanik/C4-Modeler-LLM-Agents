@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Single-Page Application container

Person(User, "User", "Interacts with UI")
System_Ext(API_Gateway, "API Gateway", "Kong / Envoy")

Container_Boundary(spa_boundary, "Single-Page Application") {
    Component(Router, "Router", "React Router / TypeScript", "Manages client-side navigation and view rendering.")
    Component(Auth, "Auth", "TypeScript / OAuth2/OIDC Client", "Handles user authentication and session management.")
    Component(API_Client, "API Client", "TypeScript / TanStack Query", "Communicates with the backend API Gateway via HTTPS/WSS.")
    Component(UI_Modules, "UI Modules", "React / TypeScript / Redux Toolkit / Zustand", "Implements user interfaces for Doctors, Nurses, Receptionists, and Billing Staff.")
    Component(Security_Interceptor, "Security Interceptor", "TypeScript", "Injects security headers and tokens into outgoing requests.")
    Component(Telemetry, "Telemetry", "OpenTelemetry", "Collects and reports client-side metrics and telemetry data.")
    Component(Encryption_Manager, "Encryption Manager", "Web Crypto API", "Handles client-side encryption for sensitive data.")
}

Rel(User, UI_Modules, "Interacts with UI", "HTTPS / WSS")
Rel(Auth, API_Client, "Provides authentication tokens")
Rel(Security_Interceptor, API_Client, "Intercepts and secures requests")
Rel(UI_Modules, API_Client, "Sends data requests")
Rel(API_Client, API_Gateway, "Sends requests", "HTTPS / WSS")

@enduml