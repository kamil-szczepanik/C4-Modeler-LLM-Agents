@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Doctors, "Doctors", "Clinical staff responsible for patient medical records and care.")
Person(Nurses, "Nurses", "Clinical staff assisting with patient admissions and care management.")
Person(Receptionists, "Receptionists", "Administrative staff managing patient scheduling and front-desk admissions.")
Person("Billing Staff", "Billing Staff", "Administrative staff handling invoicing and payment processing.")

System_Ext("Identity Provider (IdP)", "Identity Provider (IdP)", "External system providing authentication and OIDC token validation with MFA.")
System_Ext("Payment Gateway", "Payment Gateway", "External system for processing patient and insurance payments.")
System_Ext("Insurance Clearinghouse", "Insurance Clearinghouse", "External system for handling insurance claims and verification.")
System_Ext("External Lab & Imaging Systems", "External Lab & Imaging Systems", "External clinical systems for diagnostic tests and medical imaging.")

System_Boundary("Clinic Management System", "Clinic Management System") {
    Container("Single-Page Application", "Single-Page Application", "React / TypeScript", "Frontend SPA for responsive user interactions.")
    Container("API Gateway", "API Gateway", "Kong / Envoy", "Manages traffic routing, ingress, and security.")
    Container("Core Clinical Microservice", "Core Clinical Microservice", "Spring Boot", "Core Clinical microservice for enterprise security and audit features.")
    Container("Scheduling Microservice", "Scheduling Microservice", "Go", "Scheduling microservice for high-throughput, low-latency concurrency.")
    Container("Billing & Claims Microservice", "Billing & Claims Microservice", ".NET", "Billing microservice for enterprise integrations and claims.")
    Container("Integration / FHIR Service", "Integration / FHIR Service", "Node.js", "Connects to external lab and imaging systems via HL7 FHIR APIs.")
    Container("FHIR Integration Broker", "FHIR Integration Broker", "Apache Camel", "Brokers FHIR and clinical integration messages.")
    ContainerDb("Distributed Relational Database", "Distributed Relational Database", "CockroachDB / PostgreSQL", "Distributed SQL database for active-active multi-region replication.")
    Container("Message Broker / Event Bus", "Message Broker / Event Bus", "Apache Kafka", "Event bus for decoupled, eventually consistent asynchronous messaging.")
    ContainerDb("State Caching Layer", "State Caching Layer", "Redis Enterprise", "Distributed caching for sub-second P95 EMR performance.")
    Container("Key Management Service", "Key Management Service", "Vault / Cloud KMS", "Key management for envelope encryption and AES-256 at rest compliance.")
    ContainerDb("Audit Log Store", "Audit Log Store", "Elasticsearch / Immutable Storage", "Stores tamper-evident audit logs.")
    Container("Observability & Telemetry Collector", "Observability & Telemetry Collector", "OpenTelemetry / Prometheus / Loki", "Collects metrics, logs, and traces for telemetry.")
    Container("Service Mesh", "Service Mesh", "Istio", "Zero-trust network policies and mTLS enforcement for HIPAA compliance.")
}

Rel(Doctors, "Single-Page Application", "Interacts with the user interface", "HTTPS / WSS")
Rel(Nurses, "Single-Page Application", "Interacts with the user interface", "HTTPS / WSS")
Rel(Receptionists, "Single-Page Application", "Interacts with the user interface", "HTTPS / WSS")
Rel("Billing Staff", "Single-Page Application", "Interacts with the user interface", "HTTPS / WSS")

Rel("Single-Page Application", "API Gateway", "Interacts via HTTPS / WSS", "HTTPS / WSS")

Rel("API Gateway", "Core Clinical Microservice", "Routes traffic to internal microservices", "gRPC over mTLS (Istio)")
Rel("API Gateway", "Scheduling Microservice", "Routes traffic to internal microservices", "gRPC over mTLS (Istio)")
Rel("API Gateway", "Billing & Claims Microservice", "Routes traffic to internal microservices", "gRPC over mTLS (Istio)")
Rel("API Gateway", "Integration / FHIR Service", "Routes traffic to internal microservices", "gRPC over mTLS (Istio)")

Rel("Core Clinical Microservice", "Message Broker / Event Bus", "Communicates asynchronously using CloudEvents", "Apache Kafka")
Rel("Scheduling Microservice", "Message Broker / Event Bus", "Communicates asynchronously using CloudEvents", "Apache Kafka")
Rel("Billing & Claims Microservice", "Message Broker / Event Bus", "Communicates asynchronously using CloudEvents", "Apache Kafka")
Rel("Integration / FHIR Service", "Message Broker / Event Bus", "Communicates asynchronously using CloudEvents", "Apache Kafka")

Rel("Core Clinical Microservice", "Distributed Relational Database", "Persists data", "PostgreSQL wire protocol over TLS 1.3")
Rel("Scheduling Microservice", "Distributed Relational Database", "Persists data", "PostgreSQL wire protocol over TLS 1.3")
Rel("Billing & Claims Microservice", "Distributed Relational Database", "Persists data", "PostgreSQL wire protocol over TLS 1.3")
Rel("Integration / FHIR Service", "Distributed Relational Database", "Persists data", "PostgreSQL wire protocol over TLS 1.3")

Rel("Core Clinical Microservice", "State Caching Layer", "Queries state and cache", "TCP/RESP")
Rel("Scheduling Microservice", "State Caching Layer", "Queries state and cache", "TCP/RESP")
Rel("Billing & Claims Microservice", "State Caching Layer", "Queries state and cache", "TCP/RESP")

Rel("Billing & Claims Microservice", "Insurance Clearinghouse", "Integrates with external clearinghouses", "HTTPS / SOAP / REST")
Rel("Integration / FHIR Service", "External Lab & Imaging Systems", "Connects to external lab and imaging systems", "HL7 FHIR APIs over mTLS")

@enduml