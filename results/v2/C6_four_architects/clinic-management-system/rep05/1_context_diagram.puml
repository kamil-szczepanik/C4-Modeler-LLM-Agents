@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Clinic Management System

Person(Patient, "Patient", "Web or Mobile users who access portal features, registration, and scheduling.")
Person(Clinician_Staff, "Clinician/Staff", "Desktop or Web users who manage clinical workflows and electronic medical records.")
Person(Billing_Administrator, "Billing Administrator", "Web users who manage billing and insurance claims.")

System(Clinic_Management_System, "Clinic Management System", "A distributed healthcare platform designed to manage patient admissions, electronic medical records, scheduling, and billing in a hybrid cloud environment.")

System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "Provides federated multi-factor authentication via OIDC/SAML 2.0.")
System_Ext(Insurance_Gateway, "Insurance Gateway", "Handles insurance claims and verifications.")
System_Ext(External_Lab__Imaging_Systems, "External Lab & Imaging Systems", "Integrates clinical lab and imaging data via HL7 FHIR.")
System_Ext(National_Health_Registry, "National Health Registry", "External registry for patient and health data reporting.")
System_Ext(External_Archival_Storage, "External Archival Storage", "Long-term external storage for archival data.")
System_Ext(SMS_Notification_Gateway, "SMS/Notification Gateway", "Sends notifications and SMS messages to users.")

Rel(Patient, Clinic_Management_System, "Portal access, registration, and scheduling", "HTTPS (TLS 1.3)")
Rel(Clinician_Staff, Clinic_Management_System, "Clinical operations and workspace access", "HTTPS (TLS 1.3)")
Rel(Billing_Administrator, Clinic_Management_System, "Billing and claims administration", "HTTPS (TLS 1.3)")
Rel(Clinic_Management_System, Identity_Provider_IdP, "Federated multi-factor authentication", "OIDC/SAML 2.0")
Rel(Clinic_Management_System, External_Lab__Imaging_Systems, "Clinical data exchange", "HL7 FHIR over HTTPS")
Rel(Clinic_Management_System, Insurance_Gateway, "Claims and verification processing", "REST/JSON over HTTPS with mTLS")
Rel(Clinic_Management_System, National_Health_Registry, "Health data reporting", "REST/JSON over HTTPS with mTLS")

@enduml