@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing Service container

Container(API_Gateway, "API Gateway", "Nginx / Kong", "Routes billing traffic into the system.")
Container(Message_Broker, "Message Broker", "Apache Kafka", "Event broker for reliable asynchronous messaging.")
Container(Primary_Database, "Primary Database", "PostgreSQL", "Relational storage meeting ACID and retention requirements.")

Container_Boundary(Billing_Service, "Billing Service") {
    Component(Invoice_Controller, "Invoice Controller", "Express.js / TypeScript", "Web framework for handling HTTP routing in the Invoice Controller.")
    Component(Claims_Processor, "Claims Processor", "TypeScript Business Logic Engine", "Processes insurance claims and manages external submissions.")
    Component(Circuit_Breaker_Middleware, "Circuit Breaker Middleware", "Opossum / TypeScript", "Provides resilience and fault tolerance for external insurance gateway calls.")
    Component(Insurance_Gateway_Client, "Insurance Gateway Client", "Axios / HTTPS over TLS 1.3", "Submits claims securely to external insurance gateways.")
    Component(Billing_Data_Repository, "Billing Data Repository", "TypeORM / TCP via PgBouncer", "Object-Relational Mapper for structured data access via PgBouncer.")
    Component(Billing_Audit_Logger, "Billing Audit Logger", "TypeScript Event-Driven / TCP", "Dedicated audit logging for compliance and tracking.")
    Component(Payment_Reconciliation_Worker, "Payment Reconciliation Worker", "Node.js Worker Threads / Kafka Consumer", "Consumes payment events and handles payment reconciliation asynchronously.")
}

Rel(API_Gateway, Invoice_Controller, "Routes billing traffic", "Istio Service Mesh (mTLS / HTTP/2)")
Rel(Claims_Processor, Circuit_Breaker_Middleware, "Invokes external submission", "TypeScript")
Rel(Circuit_Breaker_Middleware, Insurance_Gateway_Client, "Submits claims", "HTTPS / TLS 1.3")
Rel(Claims_Processor, Message_Broker, "Publishes domain events", "SASL/SCRAM over TLS")
Rel(Message_Broker, Payment_Reconciliation_Worker, "Consumes payment events", "SASL/SCRAM over TLS")
Rel(Invoice_Controller, Billing_Data_Repository, "Queries and persists data", "TCP")
Rel(Claims_Processor, Billing_Data_Repository, "Queries and persists data", "TCP")
Rel(Payment_Reconciliation_Worker, Billing_Data_Repository, "Queries and persists data", "TCP")
Rel(Billing_Data_Repository, Primary_Database, "Persists to", "TCP")

@enduml