@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Primary Database container

Container_Ext(database_access_proxy, "Database Access Proxy", "Container", "External access proxy.")
System_Ext(message_broker_kafka, "Message Broker (Apache Kafka)", "External System", "Message broker for streaming change data capture (CDC) and audit events.")
System_Ext(audit_archival_store, "Audit & Archival Store", "External System", "Stores automated backups and audit records.")
System_Ext(cicd_pipeline, "CI/CD Pipeline", "External System", "Continuous integration and deployment pipeline.")

Container_Boundary(primary_database, "Primary Database") {
    Component(postgresql_database_engine, "PostgreSQL Database Engine", "PostgreSQL 16, AES-256", "Core relational engine providing ACID transactions and AES-256 transparent data encryption at rest.")
    Component(streaming_replication_consensus_manager, "Streaming Replication & Consensus Manager", "PostgreSQL Replication", "Manages streaming replication and consensus for high availability across hybrid cloud environments.")
    Component(row_level_security_rls_policy_enforcer, "Row-Level Security (RLS) Policy Enforcer", "PostgreSQL RLS", "Enforces strict row-level security and compliance policies for HIPAA and GDPR.")
    Component(logical_replication_audit_streamer, "Logical Replication & Audit Streamer", "PostgreSQL Logical Replication, Internal TCP / TLS", "Streams change data capture and audit events to the message broker.")
    Component(schema_migration_versioning_manager, "Schema Migration & Versioning Manager", "Migration Tool, TLS 1.3", "Manages database schema migrations and versioning securely.")
    Component(backup_pitr_agent, "Backup & Point-in-Time Recovery (PITR) Agent", "PITR Agent, HTTPS / TLS 1.3", "Handles automated backups and point-in-time recovery to the archival store.")
}

Rel(database_access_proxy, postgresql_database_engine, "TLS 1.3")
Rel(postgresql_database_engine, streaming_replication_consensus_manager, "mTLS")
Rel(postgresql_database_engine, logical_replication_audit_streamer, "Internal TCP / TLS")
Rel(logical_replication_audit_streamer, message_broker_kafka, "TLS / TCP")
Rel(schema_migration_versioning_manager, postgresql_database_engine, "TLS 1.3")
Rel(backup_pitr_agent, audit_archival_store, "HTTPS / TLS 1.3")
Rel(cicd_pipeline, schema_migration_versioning_manager, "Secure API / SSH")

@enduml