@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(observability_agent, "Observability Agent") {
    Component(PrometheusMetricsScraper, "Prometheus Metrics Scraper", "Prometheus", "Collects system and service metrics from the application containers.")
    Component(LogCollector, "Log Collector", "Grafana Promtail", "Aggregates container logs and forwards them to the central observability cluster.")
    Component(DistributedTracer, "Distributed Tracer", "OpenTelemetry Collector", "Captures and exports distributed traces across microservices via gRPC over TLS.")
}

Rel(PrometheusMetricsScraper, LogCollector, "Coordinates telemetry pipeline")
Rel(DistributedTracer, PrometheusMetricsScraper, "Shares tracing context")

@enduml