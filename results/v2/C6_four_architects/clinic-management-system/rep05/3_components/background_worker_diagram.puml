@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Background Worker container

Container_Boundary(background_worker, "Background Worker") {
    Component(task_dispatcher_consumer, "Task Dispatcher / Consumer", "Python / Celery", "Manages stateless asynchronous task execution and worker distribution.")
    Component(document_generator, "Document Generator", "Python / ReportLab", "Handles CPU-bound PDF generation for medical reports and invoices.")
    Component(audit_offloader, "Audit Offloader", "Python / boto3", "Offloads audit data to secure object storage.")
    Component(data_purger_retention_manager, "Data Purger / Retention Manager", "Python", "Manages long-term data retention and compliance purges.")
    Component(notification_dispatcher, "Notification Dispatcher", "Python", "Dispatches notifications and SMS alerts via external gateways.")
    Component(fhir_sync_worker, "FHIR Sync Worker", "Python / Celery", "Synchronizes health data with the FHIR Interoperability Service.")
    Component(worker_health_metrics_agent, "Worker Health & Metrics Agent", "Python / Prometheus client", "Exposes real-time worker metrics for observability.")
}

System_Ext(message_broker, "Message Broker", "External message broker system")
System_Ext(primary_database, "Primary Database", "Primary transactional database")
System_Ext(audit_archival_store, "Audit & Archival Store", "Secure object storage for audit logs and documents")
System_Ext(sms_notification_gateway, "SMS/Notification Gateway", "External gateway for SMS and notifications")
System_Ext(fhir_interoperability_service, "FHIR Interoperability Service", "External FHIR service")
System_Ext(observability_agent, "Observability Agent", "Monitoring and metrics collection system")

Rel(task_dispatcher_consumer, message_broker, "Consumes messages", "SASL/SCRAM over TLS")
Rel(task_dispatcher_consumer, primary_database, "Queries data", "SQL over TLS")
Rel(task_dispatcher_consumer, notification_dispatcher, "Dispatches tasks", "In-process / Celery Task")
Rel(task_dispatcher_consumer, fhir_sync_worker, "Dispatches tasks", "In-process / Celery Task")
Rel(document_generator, audit_archival_store, "Stores documents", "HTTPS")
Rel(audit_offloader, primary_database, "Reads audit logs", "SQL over TLS")
Rel(audit_offloader, audit_archival_store, "Offloads logs", "HTTPS")
Rel(notification_dispatcher, sms_notification_gateway, "Sends notifications", "HTTPS")
Rel(fhir_sync_worker, fhir_interoperability_service, "Syncs resources", "gRPC / TLS")
Rel(worker_health_metrics_agent, observability_agent, "Exposes metrics", "HTTP / Prometheus Scraping")

@enduml