@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Keycloak Container container

Container_Boundary(keycloak_container, "Keycloak Container") {
    Component(Authentication_SPI, "Authentication SPI", "Java / Keycloak SPI", "Handles user authentication and credential verification.")
    Component(User_Federation_Provider, "User Federation Provider", "Java / Keycloak SPI", "Connects to external user stores and directories.")
    Component(Token_Service, "Token Service", "Java / Quarkus", "Issues, validates, and manages OAuth2/OIDC tokens.")
    Component(Session_Cache_Manager, "Session Cache Manager", "Infinispan", "Manages and synchronizes active user sessions across nodes.")
    Component(Admin_REST_API___Theme_Engine, "Admin REST API / Theme Engine", "Java / Quarkus", "Provides administration endpoints and login UI templates.")
    Component(Audit_Event_SPI, "Audit Event SPI", "Java / Keycloak SPI", "Captures and exports security audit events.")
    Component(Identity_Brokering___Federation_Engine, "Identity Brokering & Federation Engine", "Java / Keycloak", "Enables single sign-on and integration with external identity providers.")
}

System_Ext(Primary_Database, "Primary Database", "PostgreSQL / PgBouncer")
System_Ext(Session_Cache_Manager_Remote, "Session Cache Manager (Remote)", "Infinispan")
System_Ext(Observability_Agent, "Observability Agent", "Monitoring")

Rel(Authentication_SPI, Primary_Database, "Persists credentials and config", "JDBC / TLS via PgBouncer")
Rel(Token_Service, Primary_Database, "Persists credentials and config", "JDBC / TLS via PgBouncer")
Rel(Session_Cache_Manager, Session_Cache_Manager_Remote, "Synchronizes user sessions", "Infinispan / TCP")
Rel(Audit_Event_SPI, Observability_Agent, "Exports security logs", "Syslog / HTTPS")

@enduml