@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit & Archival Store container

Container_Boundary(audit_archival_store, "Audit & Archival Store") {
    Component(Ingestion_API_Gateway, "Ingestion API Gateway", "Java/Spring Boot", "Accepts cold audit data writes from the background worker.")
    Component(Encryption_Hashing_Engine, "Encryption & Hashing Engine", "Java/Spring Boot", "Passes logs for encryption and hashing.")
    Component(Tiering_Lifecycle_Manager, "Tiering & Lifecycle Manager", "Python/FastAPI", "Applies lifecycle rules to stored archival data.")
    Component(Compliance_Query_Interface, "Compliance Query Interface", "Node.js/TypeScript", "Provides compliance query endpoints and delegates exports.")
    Component(Integrity_Verifier, "Integrity Verifier", "Python/FastAPI", "Validates checksums and ensures audit data integrity.")
    Component(Audit_Export_Redaction_Service, "Audit Export & Redaction Service", "Python/FastAPI", "Retrieves archival subsets and performs redaction for exports.")
}

Rel(Ingestion_API_Gateway, Encryption_Hashing_Engine, "Passes logs for encryption", "In-memory / Internal IPC")
Rel(Encryption_Hashing_Engine, Tiering_Lifecycle_Manager, "Persists immutable objects", "HTTPS / S3 API")
Rel(Tiering_Lifecycle_Manager, Compliance_Query_Interface, "Applies lifecycle rules", "S3 Lifecycle API")
Rel(Integrity_Verifier, Audit_Export_Redaction_Service, "Validates checksums", "HTTPS / S3 API")
Rel(Compliance_Query_Interface, Audit_Export_Redaction_Service, "Delegates exports", "Internal gRPC")
Rel(Audit_Export_Redaction_Service, Ingestion_API_Gateway, "Retrieves archival subsets", "HTTPS / S3 API")

@enduml