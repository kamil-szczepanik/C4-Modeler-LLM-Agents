@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(TLS_Termination_Routing_Engine, "TLS Termination & Routing Engine", "Nginx / Kong", "Terminates TLS connections and routes incoming traffic to core microservices.")
    Component(Authentication_Authorization_Plugin, "Authentication & Authorization Plugin", "Kong OIDC", "Validates JWT tokens and manages IAM requests against Keycloak.")
    Component(Rate_Limiting_Component, "Rate Limiting Component", "Redis Enterprise", "Enforces rate limits using distributed counters.")
    Component(Request_Audit_Logging_Interceptor, "Request Audit & Logging Interceptor", "Custom Interceptor / Fluent Bit", "Captures and offloads audit events and access logs for compliance.")
    Component(WAF_Threat_Protection_Engine, "WAF & Threat Protection Engine", "Coraza WAF", "Provides edge security and threat protection against web vulnerabilities.")
    Component(Request_Transformation_Sanitization_Component, "Request Transformation & Sanitization Component", "Kong Plugin", "Sanitizes and transforms incoming requests before routing to backend services.")
    Component(Health_Check_Circuit_Breaker_Engine, "Health Check & Circuit Breaker Engine", "Kong Health Check Plugin", "Monitors downstream service health and implements circuit breaker patterns.")
}

System_Ext(Message_Broker_Apache_Kafka, "Message Broker (Apache Kafka)", "Apache Kafka event streaming platform")

Rel(TLS_Termination_Routing_Engine, Authentication_Authorization_Plugin, "Delegates request authentication", "OIDC / HTTPS")
Rel(Authentication_Authorization_Plugin, Rate_Limiting_Component, "Queries token caching and rate limit counters", "RESP / TCP")
Rel(TLS_Termination_Routing_Engine, WAF_Threat_Protection_Engine, "Inspects incoming requests for threats", "")
Rel(TLS_Termination_Routing_Engine, Request_Transformation_Sanitization_Component, "Sanitizes payloads", "")
Rel(Request_Transformation_Sanitization_Component, Health_Check_Circuit_Breaker_Engine, "Validates downstream availability", "")
Rel(Request_Audit_Logging_Interceptor, Message_Broker_Apache_Kafka, "Offloads audit events", "Kafka Protocol / TCP")

@enduml