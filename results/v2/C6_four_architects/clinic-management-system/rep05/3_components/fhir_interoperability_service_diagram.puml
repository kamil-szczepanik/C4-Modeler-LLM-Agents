@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the FHIR Interoperability Service container

Container_Boundary("FHIR Interoperability Service", "FHIR Interoperability Service") {
    Component("FHIR API Controller", "FHIR API Controller", "FastAPI Router, Python", "Handles incoming HTTP/REST requests and enforces JWT-based authorization scopes.")
    Component("Resource Transformer Engine", "Resource Transformer Engine", "Python, fhir.resources Library", "Maps internal domain models to/from standard HL7 FHIR JSON resources.")
    Component("Terminology Mapper", "Terminology Mapper", "Python, Redis Enterprise", "Translates local clinic codes to LOINC and SNOMED-CT reference tables.")
    Component("Data Sync Outbox Client & Resilience Manager", "Data Sync Outbox Client & Resilience Manager", "Python, SQLite with WAL, Apache Kafka", "Interfaces with Apache Kafka and uses SQLite/WAL for at-least-once delivery.")
    Component("External System Connector", "External System Connector", "Python, HTTP/2, mTLS", "Manages outbound HTTP/2 client calls to external systems using mTLS.")
    Component("Audit & Compliance Interceptor", "Audit & Compliance Interceptor", "Python", "Captures requests, hashes PHI, and emits immutable audit events.")
    Component("Distributed Cache", "Distributed Cache", "Redis Enterprise", "Provides low-latency caching for terminology mappings.")
}

Component("External Lab & Imaging Systems", "External Lab & Imaging Systems", "REST over HTTPS via mTLS", "External clinical systems receiving REST calls.")
Component("Message Broker", "Message Broker", "Apache Kafka", "Manages reliable, asynchronous event distribution.")

Rel("FHIR API Controller", "Resource Transformer Engine", "Direct async/await method calls", "")
Rel("Resource Transformer Engine", "Terminology Mapper", "Direct method calls with Distributed Cache (Redis) lookup", "")
Rel("External System Connector", "External Lab & Imaging Systems", "REST over HTTPS via mTLS", "")
Rel("Data Sync Outbox Client & Resilience Manager", "Message Broker", "Publishes asynchronous events via SASL/SCRAM over TLS", "")

@enduml