@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Distributed Cache container

System_Ext(patient_emr_billing, "Patient, EMR, and Billing Services", "External services utilizing the cache.")
System_Ext(message_broker, "Message Broker (Apache Kafka)", "Publishes cache invalidation events.")
System_Ext(observability_agent, "Observability Agent", "Scrapes metrics for monitoring.")

Container_Boundary(distributed_cache, "Distributed Cache") {
    Component(redis_proxy, "Redis Proxy", "Envoy / Redis Cluster Proxy", "Handles incoming requests from patient, EMR, and billing services using RESP protocol over TCP.")
    Component(in_memory_data_nodes, "In-Memory Data Nodes", "Redis Core", "Provides distributed, low-latency caching for sub-second EMR performance.")
    Component(persistence_engine, "Persistence Engine", "AOF/RDB", "Ensures data persistence and durability for the cache.")
    Component(data_encryption_tokenization_component, "Data Encryption & Tokenization Component", "AES-256", "Enforces data encryption at rest for HIPAA and GDPR compliance via internal memory hooks.")
    Component(cluster_management_replication_daemon, "Cluster Management & Replication Daemon", "TLS/TCP", "Manages cluster topology, replication, and high availability across nodes.")
    Component(cache_invalidation_ttl_manager, "Cache Invalidation & TTL Manager", "Apache Kafka Protocol / TCP", "Enables event-driven cache invalidation to prevent stale PHI reads.")
    Component(telemetry_metrics_exporter, "Telemetry & Metrics Exporter", "Prometheus / HTTP", "Scrapes cluster health and replication metrics for high availability monitoring.")
}

Rel(patient_emr_billing, redis_proxy, "RESP protocol over TCP", "RESP/TCP")
Rel(redis_proxy, in_memory_data_nodes, "Redis Cluster Bus", "Redis Cluster Bus")
Rel(in_memory_data_nodes, redis_proxy, "Redis Cluster Bus", "Redis Cluster Bus")
Rel(in_memory_data_nodes, data_encryption_tokenization_component, "Internal Memory Hooks", "Internal Hooks")
Rel(in_memory_data_nodes, cluster_management_replication_daemon, "TLS/TCP", "TLS/TCP")
Rel(cluster_management_replication_daemon, in_memory_data_nodes, "TLS/TCP", "TLS/TCP")
Rel(message_broker, cache_invalidation_ttl_manager, "Kafka Protocol/TCP", "Kafka Protocol/TCP")
Rel(telemetry_metrics_exporter, observability_agent, "HTTP/Prometheus", "HTTP/Prometheus")

@enduml