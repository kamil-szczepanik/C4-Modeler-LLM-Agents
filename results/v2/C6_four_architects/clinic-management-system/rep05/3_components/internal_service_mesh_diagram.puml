@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(internal_service_mesh, "Internal Service Mesh") {
    Component(Control_Plane_istiod, "Control Plane (istiod)", "Go, xDS APIs over gRPC", "Manages and configures the proxy instances, pushing policies via xDS APIs and handling authorization.")
    Component(Data_Plane_Sidecars_Envoy_Proxy, "Data Plane Sidecars (Envoy Proxy)", "Envoy Proxy, mTLS, gRPC/HTTP2", "Proxies running alongside microservices to handle secure, reliable, and observable communication.")
    Component(Telemetry_Policy_Enforcer_Telemetry_v2, "Telemetry & Policy Enforcer (Telemetry v2)", "Prometheus, OTLP/gRPC", "Enforces policies and streams low-latency telemetry metrics for compliance and audit logging.")
    Component(Ingress_Egress_Gateway_Proxies, "Ingress/Egress Gateway Proxies", "Envoy Gateway, HTTPS/gRPC", "Manages incoming and outgoing traffic crossing the service mesh boundary.")
    Component(Authorization_Policy_Controller, "Authorization Policy Controller", "Embedded in istiod", "Enforces zero-trust boundaries and regulatory compliance access policies.")
    Component(East_West_Gateways, "East-West Gateways", "mTLS over gRPC", "Synchronizes communication and secures traffic across hybrid Kubernetes clusters.")
}

Rel(Data_Plane_Sidecars_Envoy_Proxy, Data_Plane_Sidecars_Envoy_Proxy, "Communicate via mTLS over gRPC/HTTP2 for AES-256 encryption in transit.", "mTLS over gRPC/HTTP2")
Rel(Control_Plane_istiod, Data_Plane_Sidecars_Envoy_Proxy, "Pushes policies via xDS APIs over gRPC.", "xDS APIs over gRPC")
Rel(Data_Plane_Sidecars_Envoy_Proxy, Telemetry_Policy_Enforcer_Telemetry_v2, "Stream metrics to Prometheus via OTLP/gRPC.", "OTLP/gRPC")
Rel(Ingress_Egress_Gateway_Proxies, Data_Plane_Sidecars_Envoy_Proxy, "Routes external traffic via HTTPS/gRPC through Ingress Gateways.", "HTTPS/gRPC")
Rel(East_West_Gateways, East_West_Gateways, "Synchronizes hybrid clusters using mTLS over gRPC.", "mTLS over gRPC")
@enduml