@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database Access Proxy container

System_Ext(Application_Tier_Services, "Application Tier Services", "Patient & Scheduling, EMR, Billing services.")
System_Ext(Keycloak_Container, "Keycloak Container", "Identity and access management for OAuth2/IAM token validation.")
System_Ext(Istio_Envoy, "Istio/Envoy", "Service mesh for active-active high availability.")
System_Ext(Primary_Database, "Primary Database", "PostgreSQL with Row-Level Security (RLS).")
System_Ext(Observability_Agent, "Observability Agent", "Collects monitoring and telemetry data.")

Container_Boundary(database_access_proxy, "Database Access Proxy") {
    Component(Connection_Manager_Component, "Connection Manager Component", "C-based routing engine, PgBouncer container", "Forwards pooled queries to the primary database.")
    Component(IAM_Auth_Interceptor_Component, "IAM Auth Interceptor Component", "Dynamic OAuth2/IAM translation", "Validates authentication tokens against the Keycloak Container.")
    Component(Health_Metrics_Prober_Component, "Health & Metrics Prober Component", "Prometheus-compatible monitoring", "Exposes health check endpoints via Istio/Envoy.")
    Component(Audit_Logging_Interceptor_Component, "Audit Logging Interceptor Component", "Metadata-only event logger", "Ships audit metadata to the observability agent.")
}

Rel(Application_Tier_Services, Connection_Manager_Component, "Queries data via connection pooling", "TCP / TLS 1.3")
Rel(IAM_Auth_Interceptor_Component, Keycloak_Container, "Validates authentication tokens", "HTTPS")
Rel(Health_Metrics_Prober_Component, Istio_Envoy, "Exposes health check endpoints", "TCP/HTTP")
Rel(Connection_Manager_Component, Primary_Database, "Forwards pooled queries", "PostgreSQL Wire Protocol over TLS 1.3")
Rel(Audit_Logging_Interceptor_Component, Observability_Agent, "Ships audit metadata", "gRPC")

@enduml