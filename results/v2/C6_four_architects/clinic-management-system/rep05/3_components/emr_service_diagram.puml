@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the EMR Service container

Container_Boundary(emr_service, "EMR Service") {
    Component(emr_api_controller, "EMR API Controller", "Spring MVC", "Exposes REST/gRPC endpoints and routes requests.")
    Component(clinical_record_manager, "Clinical Record Manager", "Spring Service", "Core business logic for clinical notes and treatments.")
    Component(audit_trail_logger, "Audit Trail Logger", "Spring AOP / Aspect", "Intercepts operations for tamper-evident logs.")
    Component(encryption_interceptor, "Encryption Interceptor", "Hibernate / JPA Attribute Converter", "Enforces AES-256 field-level encryption for PHI.")
    Component(emr_cache_manager, "EMR Cache Manager", "Spring Data Redis", "Manages hot patient records in cache.")
    Component(cache_encryption_utility, "Cache Encryption Utility", "Java", "Encrypts and decrypts cached PHI.")
    Component(fhir_transformer_component, "FHIR Transformer Component", "HAPI FHIR Library", "Maps internal clinical models to HL7 FHIR standards.")
    Component(circuit_breaker_and_fallback_manager, "Circuit Breaker & Fallback Manager", "Resilience4j", "Provides fault tolerance for database and broker calls.")
    Component(async_event_publisher, "Async Event Publisher", "Spring Application Events / Kafka Template", "Decouples domain actions from event dispatching.")
    Component(database_access_proxy, "Database Access Proxy", "Proxy", "Executes database queries.")
    Component(message_broker, "Message Broker", "Messaging Infrastructure", "Publishes asynchronous events.")
}

Rel(emr_api_controller, fhir_transformer_component, "Converts inbound/outbound payloads", "Java Method Call")
Rel(clinical_record_manager, encryption_interceptor, "Secures PHI payload", "JPA lifecycle hooks")
Rel(clinical_record_manager, emr_cache_manager, "Reads/writes hot clinical records", "Lettuce / TCP")
Rel(emr_cache_manager, cache_encryption_utility, "Encrypts/decrypts cached PHI", "Java Method Call")
Rel(clinical_record_manager, circuit_breaker_and_fallback_manager, "Invokes guarded persistence", "Java Method Call")
Rel(circuit_breaker_and_fallback_manager, database_access_proxy, "Executes queries", "JDBC over TCP")
Rel(clinical_record_manager, async_event_publisher, "Dispatches domain events", "Java Method Call")
Rel(async_event_publisher, message_broker, "Publishes asynchronous events", "SASL/SCRAM over TLS")

@enduml