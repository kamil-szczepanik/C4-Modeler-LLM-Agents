@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Video Consultation Service container

Container_Boundary(video_consultation_service, "Video Consultation Service") {
    Component(Signaling_Component, "Signaling Component", "Node.js / Go", "Handles signaling, validates session access, manages room allocation and transport, and persists metadata and states.")
    Component(Media_Router_SFU_Node, "Media Router / SFU Node", "LiveKit Server", "SFU node responsible for real-time video media routing and transport.")
    Component(Session_Controller_Component, "Session Controller Component", "Go", "Controls session logic and publishes audit events.")
    Component(Bandwidth_Adaptator, "Bandwidth Adaptator", "Go", "Dynamically adjusts simulcast layers for reliable video consultations.")
    Component(Encryption_Compliance_Proxy, "Encryption & Compliance Proxy", "C++ / Go", "Enforces encryption and broadcasts telemetry for compliance.")
}

System_Ext(Cloud_SQL, "Cloud SQL", "Google Cloud SQL for PostgreSQL")
System_Ext(Pub_Sub, "Pub/Sub", "Google Cloud Pub/Sub")

Rel(Signaling_Component, Session_Controller_Component, "Validates session access", "Internal gRPC")
Rel(Signaling_Component, Media_Router_SFU_Node, "Manages room allocation and transport", "WebRTC / WebSocket")
Rel(Signaling_Component, Cloud_SQL, "Persists metadata and states", "PostgreSQL Wire Protocol with TLS")
Rel(Bandwidth_Adaptator, Media_Router_SFU_Node, "Dynamically adjusts simulcast layers", "LiveKit Server SDK")
Rel(Session_Controller_Component, Pub_Sub, "Publishes audit events", "gRPC over TLS")
Rel(Encryption_Compliance_Proxy, Pub_Sub, "Broadcasts telemetry", "Cloud Pub/Sub API over TLS")

@enduml