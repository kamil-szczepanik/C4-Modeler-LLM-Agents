@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Symptom Checker Service container

System_Ext(Google_Cloud_Pub_Sub, "Google Cloud Pub/Sub", "Asynchronous event streaming for audit logs", "Cloud Pub/Sub API over TLS")

Container_Boundary(AI_Symptom_Checker_Service, "AI Symptom Checker Service") {
    Component(API_Router___Controller, "API Router / Controller", "FastAPI", "Core framework for asynchronous REST endpoints.")
    Component(Region_Routing___Data_Residency_Enforcer, "Region Routing / Data Residency Enforcer", "Python", "Validates residency constraints and enforces region boundaries.")
    Component(FHIR_Normalizer, "FHIR Normalizer", "Python", "Translates patient data.")
    Component(Clinical_NLP_Pipeline, "Clinical NLP Pipeline", "spaCy / Hugging Face transformers", "Clinical NLP processing for entity extraction.")
    Component(Model_Registry_Client, "Model Registry Client", "Python", "Provides loaded model artifacts and version IDs.")
    Component(Inference_Engine, "Inference Engine", "PyTorch / ONNX Runtime", "Low-latency, predictable inference execution for triage models.")
    Component(Audit___Traceability_Component, "Audit & Traceability Component", "Python", "Emits cryptographic audit logs.")
}

Rel(API_Router___Controller, Region_Routing___Data_Residency_Enforcer, "Validates residency constraints", "Internal Python method call")
Rel(Region_Routing___Data_Residency_Enforcer, FHIR_Normalizer, "Translates patient data", "Internal Python method call")
Rel(FHIR_Normalizer, Clinical_NLP_Pipeline, "Extracts normalized medical entities", "Internal Python method call")
Rel(Model_Registry_Client, Inference_Engine, "Provides loaded model artifacts and version IDs", "In-memory reference")
Rel(Inference_Engine, Audit___Traceability_Component, "Passes inference payloads and model version metadata", "Internal event dispatch")
Rel(Audit___Traceability_Component, Google_Cloud_Pub_Sub, "Emits cryptographic audit logs", "Cloud Pub/Sub API over TLS")

@enduml