@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the E-Prescription & Interoperability Gateway container

Container_Boundary(gateway_boundary, "E-Prescription & Interoperability Gateway") {
    Component(Prescription Orchestrator Component, "Prescription Orchestrator Component", "Node.js / TypeScript", "Manages internal workflow state and regional dispatch logic.")
    Component(EU Translation Adapter Component, "EU Translation Adapter Component", "Node.js / TypeScript", "Translates prescription models into national EU formats.")
    Component(US FHIR Adapter Component, "US FHIR Adapter Component", "Java / Spring Boot", "Interoperates with US healthcare systems using HL7 FHIR.")
    Component(Audit & Signing Component, "Audit & Signing Component", "Node.js / TypeScript", "Cryptographically signs payloads and emits compliance audit events.")
    Component(Consent Verification Middleware Component, "Consent Verification Middleware Component", "Node.js / TypeScript", "Validates patient consent prior to prescription release.")
    Component(Outbound Resilience & Retry Component, "Outbound Resilience & Retry Component", "Node.js / TypeScript", "Implements circuit breaking, backoff, and store-and-forward queueing.")
}

System_Ext(Consent Management Service, "Consent Management Service", "External service that manages and provides consent tokens.")
System_Ext(Cloud Pub/Sub, "Cloud Pub/Sub", "Google Cloud Pub/Sub", "Asynchronous messaging service for event streaming.")
System_Ext(External Pharmacies, "External Pharmacies", "REST / SOAP / XML", "External pharmacy systems for prescription delivery.")
System_Ext(National Health Systems, "National Health Systems", "HL7 FHIR", "External US national health systems exchanging FHIR bundles.")

Rel(Prescription Orchestrator Component, EU Translation Adapter Component, "Delegates regional formatting", "Internal gRPC")
Rel(Prescription Orchestrator Component, US FHIR Adapter Component, "Delegates regional formatting", "Internal gRPC")
Rel(Prescription Orchestrator Component, Consent Verification Middleware Component, "Validates active patient consent", "Internal gRPC")
Rel(Prescription Orchestrator Component, Audit & Signing Component, "Requests payload digital signature", "In-memory function call")
Rel(EU Translation Adapter Component, Outbound Resilience & Retry Component, "Delegates dispatch execution", "In-memory async call")
Rel(US FHIR Adapter Component, Outbound Resilience & Retry Component, "Delegates dispatch execution", "In-memory async call")
Rel(Consent Verification Middleware Component, Consent Management Service, "Queries consent tokens", "gRPC over mTLS")
Rel(Audit & Signing Component, Cloud Pub/Sub, "Publishes audit events", "Cloud Pub/Sub API over TLS")
Rel(Outbound Resilience & Retry Component, External Pharmacies, "Transmits prescriptions", "REST / SOAP / XML over TLS 1.3")
Rel(US FHIR Adapter Component, National Health Systems, "Exchanges FHIR bundles", "REST over TLS 1.3")

@enduml