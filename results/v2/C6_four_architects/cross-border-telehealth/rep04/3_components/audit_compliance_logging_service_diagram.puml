@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Audit_Compliance_Logging_Service", "Audit & Compliance Logging Service") {
    Component("Audit_API_Handler", "Audit API Handler", "Go / Fiber", "Handles incoming audit API requests securely.")
    Component("Event_Consumer_Worker", "Event Consumer Worker", "Go / Goroutine", "Consumes asynchronous events for logging.")
    Component("Compliance_Sanitizer_Formatter", "Compliance Sanitizer & Formatter", "Go", "Sanitizes and formats audit payloads.")
    Component("Log_Persistence_Engine", "Log Persistence Engine", "Go / pgx", "Persists and retrieves logs from relational storage.")
    Component("Log_Integrity_Verifier", "Log Integrity Verifier", "Go / Cryptographic Hash Chaining", "Validates cryptographic hash chains for log integrity.")
    Component("Regulatory_Reporter", "Regulatory Reporter", "Go", "Fetches logs for compliance and regulatory reporting.")
}

Rel("Audit_API_Handler", "Compliance_Sanitizer_Formatter", "Processes audit payloads", "In-memory function calls")
Rel("Event_Consumer_Worker", "Compliance_Sanitizer_Formatter", "Processes audit payloads", "In-memory function calls")
Rel("Compliance_Sanitizer_Formatter", "Log_Persistence_Engine", "Forwards sanitized logs", "In-memory function calls")
Rel("Log_Persistence_Engine", "Log_Integrity_Verifier", "Validates cryptographic hash chains", "In-memory channels / background goroutine")
Rel("Log_Persistence_Engine", "Regulatory_Reporter", "Fetches logs for reporting", "In-memory function calls")
@enduml