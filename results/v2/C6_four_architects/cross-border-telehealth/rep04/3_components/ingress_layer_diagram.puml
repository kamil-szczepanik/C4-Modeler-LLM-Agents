@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Ingress Layer container

Container_Boundary(ingress_layer, "Ingress Layer") {
    Component(Google_Cloud_DNS, "Google Cloud DNS", "Google Cloud DNS", "Provides geo-routing to direct EU traffic to europe-west3 and US traffic to us-central1.")
    Component(Google_Cloud_Armor, "Google Cloud Armor", "Google Cloud Armor", "Edge security and WAF providing OWASP Top 10 protection and rate-limiting.")
    Component(Google_Cloud_Certificate_Manager, "Google Cloud Certificate Manager", "Google Cloud Certificate Manager", "Manages SSL/TLS certificates for secure traffic termination.")
    Component(Google_Cloud_Global_HTTPS_Load_Balancer, "Google Cloud Global HTTPS Load Balancer", "Google Cloud Global HTTPS Load Balancer", "Terminates TLS 1.3, handles WebSocket upgrades, and utilizes Regional Backend Multiplexing.")
    Component(Regional_Backend_Multiplexer, "Regional Backend Multiplexer", "Google Cloud Regional Backend Multiplexer", "Forwards decrypted traffic to regionally segregated API gateways.")
    Component(Ingress_Access_Logging, "Ingress Access Logging", "Google Cloud Logging & Pub/Sub", "Emits security events and access logs.")
}

Rel(Google_Cloud_DNS, Google_Cloud_Global_HTTPS_Load_Balancer, "Routes HTTPS/WSS traffic via geo-routing", "")
Rel(Google_Cloud_Armor, Google_Cloud_Global_HTTPS_Load_Balancer, "Passes filtered traffic", "Internal GCP Network")
Rel(Google_Cloud_Certificate_Manager, Google_Cloud_Global_HTTPS_Load_Balancer, "Provides SSL/TLS certificates for termination", "")
Rel(Google_Cloud_Global_HTTPS_Load_Balancer, Regional_Backend_Multiplexer, "Forwards decrypted traffic via internal proxy routing", "")
Rel(Google_Cloud_Armor, Ingress_Access_Logging, "Emits security events and access logs", "Cloud Pub/Sub / Cloud Logging")
Rel(Google_Cloud_Global_HTTPS_Load_Balancer, Ingress_Access_Logging, "Emits security events and access logs", "Cloud Pub/Sub / Cloud Logging")

@enduml