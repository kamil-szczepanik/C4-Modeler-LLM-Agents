@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application container

Container_Boundary(web_application, "Web Application") {
    Component(Patient_Portal_UI___Clinician_Dashboard, "Patient Portal UI & Clinician Dashboard", "React, TypeScript", "Powers the Single Page Application UI and clinician dashboard.")
    Component(Video_Client_Wrapper, "Video Client Wrapper", "WebRTC / LiveKit SDK", "Manages real-time audio/video streams with dynamic bitrate adaptation for unstable connections.")
    Component(State___Consent_Manager, "State & Consent Manager", "Redux Toolkit / LocalStorage", "Manages local session state and granular data-sharing consent checks.")
    Component(Local_Audit___Telemetry_Interceptor, "Local Audit & Telemetry Interceptor", "TypeScript", "Passes UI events and consent decisions via in-memory calls and batches audit payloads.")
    Component(Offline_Cache___Sync_Manager, "Offline Cache & Sync Manager", "IndexedDB / Service Worker", "Implements PWA caching strategies for offline resilience on rural connections.")
    Component(Routing___Localization_Engine, "Routing & Localization Engine", "React Router / i18next", "Handles client-side navigation and dynamic jurisdictional localization.")
    Component(Client_Auth___Session_Handler, "Client Auth & Session Handler", "OpenID Connect / OAuth2 SDK", "Handles secure in-memory token management for HIPAA and GDPR compliance.")
}

System_Ext(API_Gateway, "API Gateway", "API Gateway")
System_Ext(Video_Consultation_Service, "Video Consultation Service", "Video Consultation Service")

Rel(Patient_Portal_UI___Clinician_Dashboard, API_Gateway, "Communicates via HTTPS/REST for business logic, e-prescriptions, and symptom checking", "HTTPS/REST")
Rel(Video_Client_Wrapper, Video_Consultation_Service, "Connects via WSS/WebRTC for real-time video consultations", "WSS/WebRTC")
Rel(Patient_Portal_UI___Clinician_Dashboard, Local_Audit___Telemetry_Interceptor, "Passes UI events and consent decisions via In-Memory Function Calls", "In-Memory")
Rel(Local_Audit___Telemetry_Interceptor, API_Gateway, "Forwards batched telemetry, consent, and audit payloads via HTTPS/REST", "HTTPS/REST")
Rel(Patient_Portal_UI___Clinician_Dashboard, Offline_Cache___Sync_Manager, "Reads/writes cached state via IndexedDB API", "IndexedDB API")
Rel(Offline_Cache___Sync_Manager, API_Gateway, "Synchronizes queued requests via HTTPS/REST upon reconnection", "HTTPS/REST")
Rel(Patient_Portal_UI___Clinician_Dashboard, Routing___Localization_Engine, "Delegates route resolution and locale assets via In-Memory Function Calls", "In-Memory")
Rel(Patient_Portal_UI___Clinician_Dashboard, Client_Auth___Session_Handler, "Verifies active session tokens via In-Memory Function Calls", "In-Memory")
Rel(Client_Auth___Session_Handler, API_Gateway, "Authenticates requests via HTTPS with Bearer Tokens", "HTTPS")

@enduml