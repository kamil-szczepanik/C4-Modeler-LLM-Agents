@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Pub/Sub container

Container_Boundary(pub_sub, "Pub/Sub") {
    Component(eu_publisher, "EU Event Publisher", "Google Cloud Pub/Sub API", "Handles region-isolated asynchronous event publishing for EU patients and clinicians complying with GDPR.")
    Component(us_publisher, "US Event Publisher", "Google Cloud Pub/Sub API", "Handles region-isolated asynchronous event publishing for US patients and clinicians complying with HIPAA.")
    Component(event_router, "Event Router & Topic Manager", "Google Cloud Pub/Sub", "Manages topics and subscriptions to decouple microservices and ensure high resilience and auditability.")
}

Rel(eu_publisher, event_router, "Publishes encrypted events over TLS", "Cloud Pub/Sub API over TLS")
Rel(us_publisher, event_router, "Publishes encrypted events over TLS", "Cloud Pub/Sub API over TLS")

@enduml