@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(auth_validator, "Authentication & Token Validator Component", "Envoy/Lua-based JWT validator", "Validates JSON Web Tokens (JWT) for incoming requests.")
    Component(region_routing, "Region Routing & Geofencing Filter", "Custom Envoy Filter / Cloud API Gateway Extension", "Enforces regional data residency and geofencing rules.")
    Component(rate_limiter, "Rate Limiter & Threat Protection Component", "Redis-backed Rate Limiter", "Protects against threats and enforces rate limits.")
    Component(telemetry_injector, "Request Telemetry & Audit Injector Component", "OpenTelemetry SDK / Custom Interceptor", "Injects telemetry and audit metadata into requests.")
    Component(payload_validation, "Payload Validation & Sanitization Component", "JSON Schema / OpenAPI Validator", "Validates and sanitizes request payloads for EU MDR compliance.")
    Component(service_discovery, "Service Discovery & Upstream Router Component", "Envoy Cluster Manager / gRPC Resolver", "Routes requests to appropriate upstream core downstream services.")
}

Rel(auth_validator, payload_validation, "Internal", "Internal")
Rel(payload_validation, region_routing, "Internal", "Internal")
Rel(region_routing, telemetry_injector, "Internal", "Internal")
Rel(region_routing, service_discovery, "Internal", "Internal")

@enduml