@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Consent Management Service container

Container_Boundary(consent_management_service, "Consent Management Service") {
    Component(Consent_API_Controller, "Consent API Controller", "Go, gRPC over mTLS", "Component handling incoming gRPC requests.")
    Component(Consent_Policy_Engine, "Consent Policy Engine", "Go", "Component evaluating region-specific GDPR and HIPAA consent rules.")
    Component(Consent_Repository_Adapter, "Consent Repository Adapter", "Go", "Component interacting regionally with databases.")
    Component(Consent_Event_Publisher, "Consent Event Publisher", "Go", "Component emitting asynchronous privacy events.")
    ComponentDb(Google_Cloud_SQL_for_PostgreSQL, "Google Cloud SQL for PostgreSQL", "Google Cloud SQL (PostgreSQL)", "Regional managed relational database.")
    Component(Google_Cloud_Pub_Sub, "Google Cloud Pub/Sub", "Google Cloud Pub/Sub", "Asynchronous event messaging service.")
}

System_Ext(API_Gateway, "API Gateway", "External API Gateway routing requests.")

Rel(API_Gateway, Consent_API_Controller, "gRPC over mTLS", "gRPC over mTLS")
Rel(Consent_API_Controller, Consent_Policy_Engine, "In-process function calls", "In-process function calls")
Rel(Consent_Policy_Engine, Consent_Repository_Adapter, "In-process function calls", "In-process function calls")
Rel(Consent_Policy_Engine, Consent_Event_Publisher, "In-process function calls", "In-process function calls")
Rel(Consent_Repository_Adapter, Google_Cloud_SQL_for_PostgreSQL, "PostgreSQL Wire Protocol with TLS", "PostgreSQL Wire Protocol with TLS")
Rel(Consent_Event_Publisher, Google_Cloud_Pub_Sub, "Cloud Pub/Sub API over TLS", "Cloud Pub/Sub API over TLS")

@enduml