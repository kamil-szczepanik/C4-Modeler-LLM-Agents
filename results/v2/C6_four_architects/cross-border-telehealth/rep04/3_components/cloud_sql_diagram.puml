@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Cloud SQL container

Person_Ext(core_telehealth, "Core Telehealth Service", "Microservice for telehealth")
Person_Ext(video_consultation, "Video Consultation Service", "Microservice for video")
Person_Ext(ai_symptom_checker, "AI Symptom Checker Service", "Microservice for AI symptoms")
Person_Ext(consent_mgmt, "Consent Management Service", "Microservice for consent")
Person_Ext(eprescription_gw, "E-Prescription & Interoperability Gateway", "Gateway for prescriptions and interoperability")
Person_Ext(audit_logging_svc, "Audit & Compliance Logging Service", "Service for audit logging")
System_Ext(cloud_storage, "Cloud Storage Regional Bucket", "GCP Cloud Storage")
System_Ext(google_monitoring, "Google Cloud Monitoring", "GCP Monitoring System")

Container_Boundary(cloud_sql, "Cloud SQL") {
    Component(region_specific_db_instances, "Region-Specific Database Instances", "Google Cloud SQL for PostgreSQL", "Managed relational storage ensuring robust multi-region isolation in europe-west3 and us-central1.")
    Component(database_connection_pooler, "Database Connection Pooler", "PgBouncer", "Sidecar connection pooling for efficient handling of stateless microservices.")
    Component(row_level_security_engine, "Row-Level Security (RLS) Engine", "PostgreSQL Row-Level Security", "Enforces data access boundaries.")
    Component(audit_logging_encryption_module, "Audit Logging & Encryption Module", "pgAudit + Cloud KMS CMEK", "Handles immutable auditing and customer-managed encryption keys enforcing strict data-at-rest compliance.")
    Component(fhir_storage_schemas, "FHIR Storage Schemas", "PostgreSQL JSONB tables", "Stores standardized healthcare records for interoperability.")
    Component(partitioned_consent_audit_tables, "Partitioned Consent & Audit Tables", "PostgreSQL Partitions", "Manages partitioned data for consent and audit logs.")
    Component(read_replicas, "Read Replicas", "PostgreSQL Regional Replicas", "Provides scalable read operations.")
    Component(schema_migration_versioning_engine, "Schema Migration & Versioning Engine", "Flyway/Liquibase", "Manages database schema migrations and versioning.")
    Component(database_backup_pitr_agent, "Database Backup & Point-in-Time Recovery (PITR) Agent", "Google Cloud SQL Backup Agent", "Handles database backups and point-in-time recovery.")
    Component(automated_data_purging_daemon, "Automated Data Purging Daemon", "pg_cron", "Automates data purging tasks.")
    Component(in_database_cryptographic_erasure_engine, "In-Database Cryptographic Erasure Engine", "pgcrypto", "Provides cryptographic erasure capabilities.")
    Component(database_telemetry_metrics_exporter, "Database Telemetry & Metrics Exporter", "Prometheus Exporter", "Exports database telemetry and metrics.")
}

Rel(core_telehealth, region_specific_db_instances, "PostgreSQL Wire Protocol with TLS 1.3")
Rel(video_consultation, region_specific_db_instances, "PostgreSQL Wire Protocol with TLS 1.3")
Rel(ai_symptom_checker, region_specific_db_instances, "PostgreSQL Wire Protocol with TLS 1.3")
Rel(consent_mgmt, region_specific_db_instances, "PostgreSQL Wire Protocol with TLS 1.3")
Rel(eprescription_gw, region_specific_db_instances, "PostgreSQL Wire Protocol with TLS 1.3")
Rel(audit_logging_svc, audit_logging_encryption_module, "PostgreSQL Wire Protocol with TLS 1.3")
Rel(eprescription_gw, fhir_storage_schemas, "PostgreSQL Wire Protocol with TLS 1.3")
Rel(region_specific_db_instances, cloud_storage, "GCP Internal APIs with TLS 1.3")
Rel(google_monitoring, database_telemetry_metrics_exporter, "HTTPS / Prometheus Scrape Protocol with TLS 1.3")

@enduml