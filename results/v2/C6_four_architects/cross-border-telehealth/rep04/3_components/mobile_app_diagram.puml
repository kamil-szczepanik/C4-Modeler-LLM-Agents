@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Ingress_Layer, "Ingress Layer", "External ingress layer for routing requests.")

Container_Boundary(Mobile_App, "Mobile App") {
    Component(UI_Layer, "UI Layer", "Flutter Widgets", "Presentation layer for consultations, e-prescriptions, and symptom checker.")
    Component(State_Management_Local_Cache, "State Management & Local Cache", "Hive / SQLite", "Manages regional data isolation and offline-first capabilities.")
    Component(API_Client, "API Client", "Dio / gRPC", "Communicates with the Ingress Layer via HTTPS/WSS.")
    Component(Video_Module, "Video Module", "LiveKit Flutter SDK", "Handles adaptive bitrate streaming for low-bandwidth connections.")
    Component(Consent_Module, "Consent Module", "Flutter", "Manages local consent states.")
    Component(AI_Symptom_Checker_Client, "AI Symptom Checker Client", "Flutter", "Handles local input validation and securely transmits payloads.")
    Component(Secure_Storage_Manager, "Secure Storage Manager", "Flutter Secure Storage", "Encrypts auth tokens and regional routing preferences.")
    Component(Localization_Regional_Routing_Manager, "Localization & Regional Routing Manager", "Flutter", "Stamps payloads with jurisdictional context (europe-west3 vs us-central1).")
}

Rel(API_Client, Ingress_Layer, "Sends client requests via HTTPS/WSS with region-specific routing headers.", "HTTPS/WSS")

@enduml