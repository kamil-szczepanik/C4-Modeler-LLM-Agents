@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Cross-Border Telehealth Platform

Person(Patient, "Patient", "User accessing the platform via Mobile or Web Apps for video consultations and symptom checking.")
Person(Clinician, "Clinician", "User accessing the platform via Mobile or Web Apps to conduct video consultations and issue e-prescriptions.")

System(Cross-Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and US while enforcing strict regional data residency and compliance.")

System_Ext(External_Pharmacies, "External Pharmacies", "External systems receiving e-prescriptions via REST / HL7 FHIR over TLS 1.3.")
System_Ext(Identity_Providers, "Identity Providers", "Auth0/GCP IAM managing authentication and identity.")
System_Ext(Regional_Regulatory_Systems, "Regional Regulatory Systems", "Systems ensuring regional regulatory and compliance standards are met.")
System_Ext(National_Health_and_Insurance_Systems, "National Health and Insurance Systems", "Systems for health records and insurance integration via REST / HL7 FHIR.")

Rel(Patient, Cross-Border_Telehealth_Platform, "Accesses video consultations, e-prescriptions, and AI symptom checker", "HTTPS, WebRTC")
Rel(Clinician, Cross-Border_Telehealth_Platform, "Conducts consultations, manages sessions, and issues e-prescriptions", "HTTPS, WebRTC")
Rel(Cross-Border_Telehealth_Platform, External_Pharmacies, "Sends e-prescriptions", "REST / HL7 FHIR over TLS 1.3")
Rel(Cross-Border_Telehealth_Platform, Identity_Providers, "Authenticates users", "Auth0 / GCP IAM")
Rel(Cross-Border_Telehealth_Platform, Regional_Regulatory_Systems, "Reports compliance and audit data", "TLS 1.3")
Rel(Cross-Border_Telehealth_Platform, National_Health_and_Insurance_Systems, "Interoperates with health records", "REST / HL7 FHIR over TLS 1.3")

@enduml