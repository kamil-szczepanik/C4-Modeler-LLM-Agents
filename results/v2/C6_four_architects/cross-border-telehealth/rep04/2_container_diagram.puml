@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(Patient, "Patient", "User accessing the platform via Mobile or Web Apps for video consultations and symptom checking.")
Person(Clinician, "Clinician", "User accessing the platform via Mobile or Web Apps to conduct video consultations and issue e-prescriptions.")

System_Ext(ExternalPharmacies, "External Pharmacies", "External systems receiving e-prescriptions via REST / HL7 FHIR over TLS 1.3.")
System_Ext(IdentityProviders, "Identity Providers", "Auth0/GCP IAM managing authentication and identity.")
System_Ext(RegionalRegulatorySystems, "Regional Regulatory Systems", "Systems ensuring regional regulatory and compliance standards are met.")
System_Ext(NationalHealthandInsuranceSystems, "National Health and Insurance Systems", "Systems for health records and insurance integration via REST / HL7 FHIR.")

System_Boundary(CrossBorderTelehealthPlatform, "Cross-Border Telehealth Platform") {
    Container(WebApplication, "Web Application", "React", "Web-based client application for patients and clinicians.")
    Container(MobileApp, "Mobile App", "Flutter", "Mobile-based client application for patients and clinicians.")
    Container(IngressLayer, "Ingress Layer", "Google Cloud Global HTTPS Load Balancer, Google Cloud Armor, Google Cloud DNS", "Handles geo-routing, security filtering, and ingress traffic routing.")
    Container(APIGateway, "API Gateway", "Google Cloud API Gateway", "Manages and routes incoming API requests to core services.")
    Container(CoreTelehealthService, "Core Telehealth Service", "Node.js / Go", "Provides core telehealth business logic and operations.")
    Container(VideoConsultationService, "Video Consultation Service", "LiveKit", "Handles real-time video consultations within regional data boundaries.")
    Container(AISymptomCheckerService, "AI Symptom Checker Service", "Python / FastAPI", "Provides AI-driven symptom checking capabilities for patients.")
    Container(ConsentManagementService, "Consent Management Service", "Go", "Manages user consent and privacy settings.")
    Container(EPrescriptionInteroperabilityGateway, "E-Prescription & Interoperability Gateway", "Node.js / TypeScript, Java / Spring Boot FHIR Adapter", "Handles e-prescriptions and interoperability with HL7 FHIR and EU protocols.")
    Container(AuditComplianceLoggingService, "Audit & Compliance Logging Service", "Go", "Ensures robust audit logging for GDPR, HIPAA, and EU MDR compliance.")
    Container(PubSub, "Pub/Sub", "Google Cloud Pub/Sub", "Facilitates asynchronous event processing between services.")
    ContainerDb(CloudSQL, "Cloud SQL", "Google Cloud SQL for PostgreSQL", "Provides secure persistent data storage with TLS encryption.")
}

Rel(Patient, IngressLayer, "Accesses platform via web and mobile apps", "HTTPS/WSS via Google Cloud DNS geo-routing")
Rel(Clinician, IngressLayer, "Accesses platform via web and mobile apps", "HTTPS/WSS via Google Cloud DNS geo-routing")
Rel(WebApplication, IngressLayer, "Sends client requests", "HTTPS/WSS")
Rel(MobileApp, IngressLayer, "Sends client requests", "HTTPS/WSS")
Rel(IngressLayer, APIGateway, "Routes ingress traffic", "HTTPS")
Rel(APIGateway, CoreTelehealthService, "Routes requests securely", "gRPC over mTLS")
Rel(APIGateway, VideoConsultationService, "Routes requests securely", "gRPC over mTLS")
Rel(APIGateway, AISymptomCheckerService, "Routes requests securely", "gRPC over mTLS")
Rel(APIGateway, ConsentManagementService, "Routes requests securely", "gRPC over mTLS")
Rel(APIGateway, EPrescriptionInteroperabilityGateway, "Routes requests securely", "gRPC over mTLS")
Rel(APIGateway, AuditComplianceLoggingService, "Routes requests securely", "gRPC over mTLS")
Rel(CoreTelehealthService, CloudSQL, "Persists and retrieves relational data", "PostgreSQL Wire Protocol with TLS")
Rel(VideoConsultationService, CloudSQL, "Persists and retrieves relational data", "PostgreSQL Wire Protocol with TLS")
Rel(AISymptomCheckerService, CloudSQL, "Persists and retrieves relational data", "PostgreSQL Wire Protocol with TLS")
Rel(ConsentManagementService, CloudSQL, "Persists and retrieves relational data", "PostgreSQL Wire Protocol with TLS")
Rel(EPrescriptionInteroperabilityGateway, CloudSQL, "Persists and retrieves relational data", "PostgreSQL Wire Protocol with TLS")
Rel(AuditComplianceLoggingService, CloudSQL, "Persists and retrieves audit logs", "PostgreSQL Wire Protocol with TLS")
Rel(CoreTelehealthService, PubSub, "Publishes and consumes asynchronous events", "Cloud Pub/Sub API over TLS")
Rel(VideoConsultationService, PubSub, "Publishes and consumes asynchronous events", "Cloud Pub/Sub API over TLS")
Rel(AISymptomCheckerService, PubSub, "Publishes and consumes asynchronous events", "Cloud Pub/Sub API over TLS")
Rel(ConsentManagementService, PubSub, "Publishes and consumes asynchronous events", "Cloud Pub/Sub API over TLS")
Rel(EPrescriptionInteroperabilityGateway, PubSub, "Publishes and consumes asynchronous events", "Cloud Pub/Sub API over TLS")
Rel(AuditComplianceLoggingService, PubSub, "Publishes and consumes asynchronous events", "Cloud Pub/Sub API over TLS")
Rel(EPrescriptionInteroperabilityGateway, ExternalPharmacies, "Sends e-prescriptions", "REST / HL7 FHIR over TLS 1.3")
Rel(CoreTelehealthService, IdentityProviders, "Authenticates users", "Auth0 / GCP IAM")
Rel(AuditComplianceLoggingService, RegionalRegulatorySystems, "Reports compliance and audit data", "TLS 1.3")
Rel(EPrescriptionInteroperabilityGateway, NationalHealthandInsuranceSystems, "Interoperates with health records", "REST / HL7 FHIR over TLS 1.3")
@enduml