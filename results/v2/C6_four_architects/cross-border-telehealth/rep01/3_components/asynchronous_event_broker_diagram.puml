@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Asynchronous Event Broker container

Container_Boundary(asynchronous_event_broker, "Asynchronous Event Broker") {
    Component(Regional_EU_US_Topics, "Regional EU/US Topics", "GCP Pub/Sub", "Handles asynchronous event distribution with regional separation for EU and US data residency.")
    Component(Schema_Registry, "Schema Registry", "GCP Pub/Sub Schema Registry", "Enforces payload validation for structured recommendation and transaction events.")
    Component(Event_Flow_Router, "Event Flow Router", "GCP Pub/Sub Router", "Routes filtered events such as e-prescription events to downstream adapters.")
    Component(DLQ_Manager, "DLQ Manager", "GCP Pub/Sub DLQ Retry Manager", "Captures and manages unprocessable event payloads for archiving into regional storage.")
}

Rel(Schema_Registry, Regional_EU_US_Topics, "Validates message schemas for", "gRPC/HTTPS")
Rel(Regional_EU_US_Topics, Event_Flow_Router, "Dispatches asynchronous events for", "gRPC")
Rel(Event_Flow_Router, DLQ_Manager, "Forwards failed or unprocessable messages to", "gRPC")

@enduml