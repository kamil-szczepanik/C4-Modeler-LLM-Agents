@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Interoperability Adapter container

System_Ext(Core_Telehealth_Backend, "Core Telehealth Backend", "External system calling the adapter")
System_Ext(Regional_Databases, "Regional Databases", "External databases for regional data residency")
System_Ext(National_Pharmacies_National_EHR_Gateways, "National Pharmacies / National EHR Gateways", "External national endpoints")
System_Ext(Dedicated_Audit_Logging_Container, "Dedicated Audit & Logging Container", "External audit and logging container")

Container_Boundary(Interoperability_Adapter, "Interoperability Adapter") {
    Component(Region_Routing_Resolver, "Region Routing Resolver", "Spring Cloud Config / Routing", "Routes requests based on region for the Cross-Border Telehealth Platform.")
    Component(Schema_Validation_Interceptor, "Schema Validation Interceptor", "Hibernate Validator / JSON Schema", "Validates request schemas before processing.")
    Component(Data_Residency_Enforcer, "Data Residency Enforcer", "Spring Security / AspectJ", "Enforces strict regional data residency rules.")
    Component(FHIR_Translation_Engine, "FHIR Translation Engine", "Java / HAPI FHIR", "Translates US healthcare data using standardized FHIR libraries.")
    Component(EU_National_Gateway_Translator, "EU National Gateway Translator", "Java / Apache Camel", "Transforms diverse EU national formats.")
    Component(Outbound_Protocol_Dispatcher, "Outbound Protocol Dispatcher", "Spring WebClient / Resilience4j", "Dispatches outbound protocols with circuit breaker capabilities.")
    Component(Adapter_Audit_Interceptor, "Adapter Audit Interceptor", "Spring AOP", "Audits adapter activities and interactions.")
}

Rel(Core_Telehealth_Backend, Region_Routing_Resolver, "gRPC")
Rel(Region_Routing_Resolver, Schema_Validation_Interceptor, "In-memory")
Rel(Schema_Validation_Interceptor, FHIR_Translation_Engine, "In-memory")
Rel(Schema_Validation_Interceptor, EU_National_Gateway_Translator, "In-memory")
Rel(Data_Residency_Enforcer, Regional_Databases, "Database Protocol")
Rel(Data_Residency_Enforcer, Outbound_Protocol_Dispatcher, "In-memory method call")
Rel(Outbound_Protocol_Dispatcher, National_Pharmacies_National_EHR_Gateways, "mTLS over HTTPS")
Rel(Adapter_Audit_Interceptor, Dedicated_Audit_Logging_Container, "gRPC")

@enduml