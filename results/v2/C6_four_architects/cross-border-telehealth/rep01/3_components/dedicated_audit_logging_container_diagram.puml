@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Dedicated Audit & Logging Container container

Container_Boundary(Dedicated_Audit_Logging_Container, "Dedicated Audit & Logging Container") {
    Component(Log_Collector, "Log Collector", "Fluent Bit", "Lightweight log ingestion and PHI stripping at the edge.")
    Component(Audit_Compliance_Engine, "Audit & Compliance Engine", "OpenTelemetry Collector", "Normalization and structured schema tagging for AI traceability.")
    Component(Compliance_Archival_Manager, "Compliance Archival Manager", "Go", "Manages the archival of compliance and audit logs to regional storage.")
    Component(Log_Access_Proxy, "Log Access Proxy", "HTTPS / mTLS Proxy", "Provides secure access for external compliance auditors to regional cloud storage.")
}

Rel(Log_Collector, Audit_Compliance_Engine, "In-memory / IPC", "")
Rel(Audit_Compliance_Engine, Compliance_Archival_Manager, "Internal gRPC", "")

@enduml