@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway & Consent Container container

Container_Boundary(api_gateway_consent_container, "API Gateway & Consent Container") {
    Component(Envoy_Proxy, "Envoy Proxy", "Envoy Proxy", "Manages ingress TLS, WSS signaling, and gRPC routing.")
    Component(Open_Policy_Agent, "Open Policy Agent", "Open Policy Agent (OPA)", "Evaluates consent scopes and regional policies.")
    Component(WASM_Claims_Extension, "WASM Claims Extension", "WASM", "Inspects and extracts claims at the edge for policy validation.")
}

Rel(Envoy_Proxy, Open_Policy_Agent, "Queries for authorization and consent decisions", "gRPC")
Rel(Envoy_Proxy, WASM_Claims_Extension, "Executes for request claim validation", "Internal")

@enduml