@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Telehealth Backend container

System_Ext(VideoConsultationService, "Video Consultation Service", "WebRTC / Janus Media Server on GCE MIGs")
System_Ext(InteroperabilityAdapter, "Interoperability Adapter", "Java / Spring Boot")
System_Ext(AISymptomChecker, "AI Symptom Checker", "Python / FastAPI")
System_Ext(AsynchronousEventBroker, "Asynchronous Event Broker", "GCP Pub/Sub with region-pinned topics")
System_Ext(RegionalDatabases, "Regional Databases", "Cloud SQL PostgreSQL, Cloud Storage, Cloud Firestore")
System_Ext(DedicatedAuditLoggingContainer, "Dedicated Audit & Logging Container", "Fluentbit / OpenTelemetry")

Container_Boundary(CoreTelehealthBackend, "Core Telehealth Backend") {
    Component(ConsultationOrchestrator, "Consultation Orchestrator", "Go", "Manages consultation workflows and media stream interactions.")
    Component(EPrescriptionWorkflow, "E-Prescription Workflow", "Go", "Handles e-prescription generation and workflow management.")
    Component(ConsentEnforcementMiddleware, "Consent Enforcement Middleware", "Go / Open Policy Agent", "Enforces data access and consent policies.")
    Component(SymptomCheckerOrchestrator, "Symptom Checker Orchestrator", "Go", "Orchestrates symptom checks and communicates with the AI engine.")
    Component(PatientProfileConsentManager, "Patient Profile & Consent Manager", "Go", "Manages patient profiles and consent records.")
    Component(EventDispatcher, "Event Dispatcher", "Go", "Dispatches domain events to the message broker.")
    Component(OutboxPatternHandler, "Outbox Pattern Handler", "Go", "Ensures reliable message publishing via the transactional outbox pattern.")
}

Rel(ConsultationOrchestrator, VideoConsultationService, "Manages media streams", "gRPC")
Rel(EPrescriptionWorkflow, InteroperabilityAdapter, "Dispatches national-format payloads", "gRPC")
Rel(SymptomCheckerOrchestrator, AISymptomChecker, "Requests urgency recommendations", "gRPC")
Rel(EventDispatcher, AsynchronousEventBroker, "Publishes sanitized domain events to region-pinned topics", "gRPC/Protobuf")
Rel(ConsultationOrchestrator, RegionalDatabases, "Enforces geo-pinned data storage", "PostgreSQL wire protocol")
Rel(EPrescriptionWorkflow, RegionalDatabases, "Enforces geo-pinned data storage", "PostgreSQL wire protocol")
Rel(ConsentEnforcementMiddleware, RegionalDatabases, "Enforces geo-pinned data storage", "PostgreSQL wire protocol")
Rel(SymptomCheckerOrchestrator, RegionalDatabases, "Enforces geo-pinned data storage", "PostgreSQL wire protocol")
Rel(PatientProfileConsentManager, RegionalDatabases, "Enforces geo-pinned data storage", "PostgreSQL wire protocol")
Rel(EventDispatcher, RegionalDatabases, "Enforces geo-pinned data storage", "PostgreSQL wire protocol")
Rel(OutboxPatternHandler, RegionalDatabases, "Enforces geo-pinned data storage", "PostgreSQL wire protocol")
Rel(ConsultationOrchestrator, DedicatedAuditLoggingContainer, "Sends audit logs", "gRPC")
Rel(EPrescriptionWorkflow, DedicatedAuditLoggingContainer, "Sends audit logs", "gRPC")
Rel(ConsentEnforcementMiddleware, DedicatedAuditLoggingContainer, "Sends audit logs", "gRPC")
Rel(SymptomCheckerOrchestrator, DedicatedAuditLoggingContainer, "Sends audit logs", "gRPC")
Rel(PatientProfileConsentManager, DedicatedAuditLoggingContainer, "Sends audit logs", "gRPC")
Rel(EventDispatcher, DedicatedAuditLoggingContainer, "Sends audit logs", "gRPC")
Rel(OutboxPatternHandler, DedicatedAuditLoggingContainer, "Sends audit logs", "gRPC")

@enduml