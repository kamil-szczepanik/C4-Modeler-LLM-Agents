@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Video Consultation Service container

System_Ext(Regional Cloud Storage, "Regional Cloud Storage", "Cloud Storage in europe-west3 and us-central1", "Stores encrypted media chunks")
System_Ext(Dedicated Audit & Logging Container, "Dedicated Audit & Logging Container", "Fluentbit / OpenTelemetry", "Collects session telemetry")

Container_Boundary(video_consultation_service, "Video Consultation Service") {
    Component(Signaling_Controller, "Signaling Controller", "Node.js / WebSockets", "Handles WebSockets signaling for video consultation sessions and communicates with the API Gateway via gRPC for session authorization.")
    Component(Media_Router_SFU_Core, "Media Router / SFU Core", "Janus Media Server / C++", "Manages real-time video streaming, routing media streams between participants.")
    Component(Adaptive_Bitrate_Quality_Manager, "Adaptive Bitrate & Quality Manager", "C++ plugin", "Manages video quality and adapts bitrates for unstable rural internet connections.")
    Component(Room_Access_Control_Consent_Verifier, "Room Access Control & Consent Verifier", "Node.js", "Validates real-time consent and data residency via internal gRPC queries.")
    Component(Recording_Transcoding_Worker, "Recording & Transcoding Worker", "Python / GStreamer", "Records and transcodes consultation sessions, streaming encrypted media chunks to Regional Cloud Storage via HTTPS.")
    Component(TURN_STUN_Relay_Manager, "TURN/STUN Relay Manager", "Coturn on GCE Compute Engine", "Provides NAT traversal and relay services for WebRTC connections.")
}

Rel(Signaling_Controller, Room_Access_Control_Consent_Verifier, "Queries for real-time consent and data residency validation via internal gRPC", "gRPC")
Rel(Recording_Transcoding_Worker, Regional Cloud Storage, "Streams encrypted media chunks via HTTPS (REST)", "HTTPS")
Rel(Media_Router_SFU_Core, Dedicated Audit & Logging Container, "Emits session telemetry via OpenTelemetry (gRPC)", "gRPC / OpenTelemetry")

@enduml