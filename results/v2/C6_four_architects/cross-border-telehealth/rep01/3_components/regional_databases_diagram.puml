@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Regional Databases container

Container_Boundary(regional_databases, "Regional Databases") {
    Component(TransactionalStore, "Transactional Store", "Cloud SQL PostgreSQL", "Region-locked relational storage for patient records and e-prescriptions.")
    Component(DocumentAuditStore, "Document & Audit Store", "Cloud Firestore", "Document storage capturing immutable AI symptom-checker inputs and model versions.")
    Component(BlobStorage, "Blob Storage", "Cloud Storage", "Encrypted object storage for consultation artifacts with CMEK.")
    Component(DataEncryptionManager, "Data Encryption Manager", "Cloud KMS", "Regional Customer-Managed Encryption Keys ensuring cryptographic isolation.")
    Component(DatabaseMigrationSchemaManager, "Database Migration & Schema Manager", "Flyway / Cloud Build", "Apply localized schema migrations.")
    Component(RegionalReplicaRouter, "Regional Replica Router", "Cloud SQL Proxy / Built-in HA", "Localized read-scaling and automatic failover.")
    Component(DatabaseBackupRetentionManager, "Database Backup & Retention Manager", "Cloud Backup and DR / Storage Lifecycle", "Execute regional snapshots and lifecycle archival.")
}

Rel(TransactionalStore, DataEncryptionManager, "Encrypt/Decrypt regional data at rest", "Cloud KMS API / gRPC")
Rel(DocumentAuditStore, DataEncryptionManager, "Encrypt/Decrypt regional data at rest", "Cloud KMS API / gRPC")
Rel(BlobStorage, DataEncryptionManager, "Encrypt/Decrypt regional data at rest", "Cloud KMS API / gRPC")
Rel(DatabaseMigrationSchemaManager, TransactionalStore, "Apply localized schema migrations", "TCP / PostgreSQL Wire Protocol")
Rel(RegionalReplicaRouter, TransactionalStore, "Replicate transactional data within the same region", "TCP")
Rel(DatabaseBackupRetentionManager, TransactionalStore, "Execute regional snapshots", "GCP Internal API")
Rel(DatabaseBackupRetentionManager, BlobStorage, "Execute lifecycle archival", "GCP Internal API")

@enduml