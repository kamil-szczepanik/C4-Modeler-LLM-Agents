@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_EU_US, "Patients (EU/US)", "Patients from the EU and US accessing video consultations, e-prescriptions, and the AI symptom checker.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Licensed medical professionals conducting video consultations and prescribing treatments.")
System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for EU and US patients with strict regional data residency, regulatory compliance, and interoperability across dual GCP environments.")
System_Ext(National_Pharmacies, "National Pharmacies", "External national pharmacy systems for handling e-prescriptions.")
System_Ext(National_EHR_Gateways, "National EHR Gateways", "External Electronic Health Record gateways for medical record integration.")
System_Ext(Payment_Gateways_Stripe, "Payment Gateways (Stripe)", "External payment processing provider.")
System_Ext(Notification_Providers_Twilio_Firebase, "Notification Providers (Twilio/Firebase)", "External providers for sending system notifications.")

Rel(Patients_EU_US, Cross_Border_Telehealth_Platform, "Accesses telehealth services, video consultations, and AI symptom checker", "HTTPS, WebSockets, WebRTC")
Rel(Licensed_Clinicians, Cross_Border_Telehealth_Platform, "Conducts video consultations and manages patient care", "HTTPS, WebSockets, WebRTC")
Rel(Cross_Border_Telehealth_Platform, National_Pharmacies, "Sends e-prescriptions and prescription data", "HL7 FHIR / National e-Prescription APIs over REST/TLS")
Rel(Cross_Border_Telehealth_Platform, National_EHR_Gateways, "Exchanges patient health records", "HL7 FHIR over REST/TLS")
Rel(Cross_Border_Telehealth_Platform, Payment_Gateways_Stripe, "Processes consultation and service payments", "HTTPS/REST")
Rel(Cross_Border_Telehealth_Platform, Notification_Providers_Twilio_Firebase, "Sends SMS and push notifications to users", "HTTPS/REST")

@enduml