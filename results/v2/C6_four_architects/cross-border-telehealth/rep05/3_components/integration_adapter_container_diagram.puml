@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Adapter Container container

Component(BackendService, "Backend Service & Consent & Policy Service", "Backend Service", "External or parent boundary service interacting with the ingress router.")

Container_Boundary(IntegrationAdapterContainer, "Integration Adapter Container") {
    Component(InternalIngressRouter, "Internal Ingress Router", "Go", "Handles high-performance tenant-aware gRPC routing.")
    Component(FHIRTranslationComponent, "FHIR Translation Component", "Node.js/TypeScript", "Powers US HL7 FHIR standard transformations.")
    Component(EUNationalePrescriptionAdapter, "EU National e-Prescription Adapter", "Java/Spring Boot", "Implements regional compliance for EU e-prescriptions.")
    Component(AIGatewayIntermediary, "AI Gateway Intermediary", "Python/FastAPI", "Standardizes payloads for MDR traceability.")
    Component(AdapterSecurityAuditProxy, "Adapter Security & Audit Proxy", "Envoy Proxy (Sidecar)", "Acts as a sidecar proxy for strict egress policy and TLS 1.3 enforcement.")
}

Component_Ext(ExternalHIEs, "External HIEs", "REST/FHIR over mTLS", "External Health Information Exchanges in us-central1.")
Component_Ext(ExternalPharmacyNetworks, "External Pharmacy Networks", "SOAP/REST over mTLS", "External pharmacy networks in europe-west3.")
Component_Ext(ExternalSystems, "External Systems", "TLS 1.3, mTLS", "External systems subject to region-locked GCP egress.")

Rel(BackendService, InternalIngressRouter, "gRPC over Istio mTLS", "gRPC")
Rel(InternalIngressRouter, FHIRTranslationComponent, "Internal gRPC", "gRPC")
Rel(InternalIngressRouter, EUNationalePrescriptionAdapter, "Internal gRPC", "gRPC")
Rel(FHIRTranslationComponent, ExternalHIEs, "REST/FHIR over mTLS (us-central1)", "REST/FHIR")
Rel(EUNationalePrescriptionAdapter, ExternalPharmacyNetworks, "SOAP/REST over mTLS (europe-west3)", "SOAP/REST")
Rel(AdapterSecurityAuditProxy, ExternalSystems, "TLS 1.3, mTLS, and region-locked GCP egress", "TLS 1.3")

@enduml