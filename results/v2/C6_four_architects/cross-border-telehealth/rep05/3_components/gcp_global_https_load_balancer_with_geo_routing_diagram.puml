@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the GCP Global HTTPS Load Balancer with Geo-routing container

Container_Boundary(gcp_lb_container, "GCP Global HTTPS Load Balancer with Geo-routing") {
    Component(GCP_Global_External_HTTPS_Load_Balancer, "GCP Global External HTTP(S) Load Balancer", "GCP Anycast IP & SSL Termination", "Provides secure frontend access, SSL termination, and global traffic distribution.")
    Component(Google_Cloud_Armor, "Google Cloud Armor", "WAF & Security Policy Enforcer", "Enforces security policies, WAF rules, and rate limiting for compliance.")
    Component(GCP_URL_Map, "GCP URL Map", "Geo-Routing Engine", "Inspects client geolocation and routes traffic based on regional requirements.")
    Component(GCP_Backend_Services___Network_Endpoint_Groups, "GCP Backend Services & Network Endpoint Groups", "Regional Backend Selectors", "Selects and routes traffic to the appropriate regional backend.")
    Component(GCP_HTTPS_Health_Checks, "GCP HTTP(S) Health Checks", "Global Health Checker", "Monitors regional backend availability without violating data isolation.")
}

Rel(GCP_Global_External_HTTPS_Load_Balancer, Google_Cloud_Armor, "Inspects requests via", "Internal")
Rel(Google_Cloud_Armor, GCP_URL_Map, "Forwards filtered traffic to", "Internal")
Rel(GCP_URL_Map, GCP_Backend_Services___Network_Endpoint_Groups, "Routes geo-targeted traffic to", "Internal")
Rel(GCP_HTTPS_Health_Checks, GCP_Backend_Services___Network_Endpoint_Groups, "Monitors health of", "HTTPS")

@enduml