@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(backend_service_consent_policy_service, "Backend Service & Consent & Policy Service") {
    Component(api_router_controller_component, "API Router & Controller Component", "Spring Boot / FastAPI", "Implements API routing and control logic")
    Component(consent_policy_engine_component, "Consent & Policy Engine Component", "Open Policy Agent (OPA) + Java/Python", "Enforces GDPR and HIPAA consent rules")
    Component(fhir_e_prescription_domain_component, "FHIR & E-Prescription Domain Component", "HAPI FHIR / Spring Data", "Manages clinical data models and standards")
    Component(audit_traceability_logger_component, "Audit & Traceability Logger Component", "Custom Middleware", "Logs and tracks platform activities")
    Component(data_residency_router_component, "Data Residency Router Component", "Spring Cloud / Custom Middleware", "Handles regional routing for data-locality compliance")
    Component(ai_traceability_logging_interceptor_component, "AI Traceability & Logging Interceptor Component", "Spring AOP / Python Middleware", "Captures AI symptom checker inputs and model versions")
    Component(e_prescription_translation_adapter_component, "E-Prescription Translation Adapter Component", "Apache Camel", "Translates clinical models into regional e-prescription formats")
}

System_Ext(cloud_sql_postgresql_memorystore_redis, "Cloud SQL for PostgreSQL & Memorystore for Redis", "Database / Cache")
System_Ext(integration_adapter_container, "Integration Adapter Container", "Integration Container")
System_Ext(gcp_cloud_storage_with_object_retention_worm, "GCP Cloud Storage with Object Retention (WORM)", "Storage")

Rel(api_router_controller_component, consent_policy_engine_component, "Evaluates access permissions", "in-memory gRPC")
Rel(api_router_controller_component, data_residency_router_component, "Determines target region for data mutations", "in-process method calls")
Rel(data_residency_router_component, cloud_sql_postgresql_memorystore_redis, "Enforces regional connection pools", "JDBC over TLS")
Rel(fhir_e_prescription_domain_component, e_prescription_translation_adapter_component, "Hands off clinical orders", "in-process calls")
Rel(e_prescription_translation_adapter_component, integration_adapter_container, "Dispatches formatted prescriptions", "gRPC")
Rel(ai_traceability_logging_interceptor_component, gcp_cloud_storage_with_object_retention_worm, "Writes immutable audit logs", "HTTPS/Storage API")

@enduml