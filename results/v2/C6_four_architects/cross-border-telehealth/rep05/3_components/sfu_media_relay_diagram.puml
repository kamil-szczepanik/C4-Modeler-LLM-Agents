@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(sfu_media_relay, "SFU Media Relay") {
    Component(iceturn_server, "ICE/TURN Server", "WebRTC, STUN/TURN, UDP", "Handles NAT traversal and peer-to-peer connection establishment for low-bandwidth video streams.")
    Component(sfu_core_routing_engine, "SFU Core Routing Engine", "LiveKit / Mediasoup, WebRTC", "Manages selective forwarding unit core routing, real-time video processing, and session states.")
    Component(abr_controller, "ABR Controller", "Adaptive Bitrate Control", "Supports unstable rural connections through adaptive bitrate control and localized degradation modes.")
    Component(telemetry_qos_agent, "Telemetry & QoS Agent", "QoS Monitoring", "Monitors call quality and telemetry data during video consultations.")
    Component(token_auth_session_validator, "Token Auth & Session Validator", "gRPC, mTLS", "Verifies participant access tokens with the Backend Service securely.")
    Component(media_recorder_audit_interceptor, "Media Recorder / Audit Interceptor", "HTTPS", "Persists encrypted compliance recordings to GCP Cloud Storage.")
}

System_Ext(backend_service_consent_policy_service, "Backend Service & Consent & Policy Service", "GKE, Open Policy Agent")
System_Ext(gcp_cloud_storage_with_object_retention_worm, "GCP Cloud Storage with Object Retention (WORM)", "GCP Cloud Storage")

Rel(token_auth_session_validator, backend_service_consent_policy_service, "Verifies participant access tokens", "gRPC/mTLS")
Rel(sfu_core_routing_engine, backend_service_consent_policy_service, "Reports call session states and metrics", "gRPC")
Rel(media_recorder_audit_interceptor, gcp_cloud_storage_with_object_retention_worm, "Persists encrypted compliance recordings", "HTTPS")

@enduml