@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(gcp_cloud_storage, "GCP Cloud Storage with Object Retention (WORM)") {
    Component(bucket_manager, "Bucket Manager / Retention Policy Enforcer", "GCP Cloud Storage & Bucket Lock", "Manages buckets and enforces WORM retention policies in compliance mode.")
    Component(access_control, "Access Control & Encryption Router", "Cloud KMS & IAM", "Routes access control and executes envelope encryption using regional customer-managed encryption keys.")
    Component(audit_verifier, "Audit Log Verifier / Integrity Checker", "Cloud Pub/Sub & Integrity Validation Service", "Triggers and processes object integrity validation events asynchronously.")
    Component(audit_logger, "Audit & Access Logger", "Cloud Logging API & BigQuery", "Captures and exports security telemetry and audit trails for compliance.")
}

System_Ext(ai_service, "AI Symptom Checker Service", "AI Model Provider / Inference Service")
System_Ext(cloud_kms, "Cloud KMS (Regional)", "Key Management Service")
System_Ext(cloud_logging, "GCP Cloud Logging / BigQuery", "Logging and Analytics")

Rel(bucket_manager, audit_verifier, "Triggers integrity validation events", "Cloud Pub/Sub")
Rel(ai_service, access_control, "Streams immutable audit logs", "HTTPS / GCP IAM")
Rel(access_control, cloud_kms, "Executes envelope encryption", "gRPC")
Rel(audit_logger, cloud_logging, "Exports security telemetry", "Cloud Logging API")

@enduml