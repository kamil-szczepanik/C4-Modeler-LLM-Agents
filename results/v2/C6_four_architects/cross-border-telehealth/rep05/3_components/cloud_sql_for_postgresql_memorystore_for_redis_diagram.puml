@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Cloud SQL for PostgreSQL & Memorystore for Redis", "Cloud SQL for PostgreSQL & Memorystore for Redis") {
    Component("Cloud SQL for PostgreSQL (Enterprise Plus Edition)", "Cloud SQL for PostgreSQL (Enterprise Plus Edition)", "PostgreSQL, Enterprise Plus Edition", "Regional primary/replica relational database storing patient profiles, FHIR resources, consent logs, and AI audit records.")
    Component("PgBouncer", "PgBouncer", "PgBouncer Sidecar", "Connection pooling sidecar inside GKE pods managing database connections.")
    Component("Memorystore for Redis (Cluster Mode)", "Memorystore for Redis (Cluster Mode)", "Redis Cluster Mode, RESP3", "Regional in-memory cache handling session management and WebRTC states.")
}

Rel("PgBouncer", "Cloud SQL for PostgreSQL (Enterprise Plus Edition)", "PostgreSQL wire protocol over TLS 1.3 for transactional writes, read-heavy FHIR queries, and audit logs.", "TLS 1.3")

@enduml