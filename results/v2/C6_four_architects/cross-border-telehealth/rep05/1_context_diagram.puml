@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_and_Clinicians, "Patients and Clinicians", "Users who access the platform for video consultations, e-prescriptions, and AI symptom checking.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and US while enforcing strict regional data isolation to comply with GDPR and HIPAA mandates.")

System_Ext(Global_HTTPS_Load_Balancer_with_Georouting_GCP, "Global HTTPS Load Balancer with Geo-routing (GCP)", "Routes user traffic globally to appropriate regional systems based on geographic location.")
System_Ext(EU_Telehealth_System_GCP_europe_west3, "EU Telehealth System (GCP europe-west3)", "Regional system enforcing data residency and compliance for EU patients and clinicians.")
System_Ext(US_Telehealth_System_GCP_us_central1, "US Telehealth System (GCP us-central1)", "Regional system enforcing data residency and compliance for US patients and clinicians.")
System_Ext(Regional_Pharmacy_Networks_and_Health_Information_Exchanges_HIEs, "Regional Pharmacy Networks and Health Information Exchanges (HIEs)", "External networks for handling prescriptions and health information exchange.")
System_Ext(AI_Model_Provider___Inference_Service, "AI Model Provider / Inference Service", "External service providing AI-driven symptom checking capabilities.")
System_Ext(WebRTCSFU_Media_Relay, "WebRTC/SFU Media Relay", "Media relay supporting low-bandwidth video consultations with adaptive bitrate streaming.")

Rel(Patients_and_Clinicians, Cross_Border_Telehealth_Platform, "Accesses video consultations, e-prescriptions, and AI symptom checker", "HTTPS and WebRTC")
Rel(Global_HTTPS_Load_Balancer_with_Georouting_GCP, EU_Telehealth_System_GCP_europe_west3, "Routes regional EU traffic", "Regional Routing")
Rel(Global_HTTPS_Load_Balancer_with_Georouting_GCP, US_Telehealth_System_GCP_us_central1, "Routes regional US traffic", "Regional Routing")
Rel(EU_Telehealth_System_GCP_europe_west3, Regional_Pharmacy_Networks_and_Health_Information_Exchanges_HIEs, "Interoperates for e-prescriptions and health exchanges", "mTLS, REST, HL7 FHIR, and national gateways")
Rel(US_Telehealth_System_GCP_us_central1, Regional_Pharmacy_Networks_and_Health_Information_Exchanges_HIEs, "Interoperates for e-prescriptions and health exchanges", "mTLS, REST, HL7 FHIR, and national gateways")
Rel(EU_Telehealth_System_GCP_europe_west3, AI_Model_Provider___Inference_Service, "Requests AI inference for symptom checking", "mTLS and HTTPS")
Rel(US_Telehealth_System_GCP_us_central1, AI_Model_Provider___Inference_Service, "Requests AI inference for symptom checking", "mTLS and HTTPS")
Rel(EU_Telehealth_System_GCP_europe_west3, US_Telehealth_System_GCP_us_central1, "Performs consent-driven queries between regional systems", "mTLS and gRPC")

@enduml