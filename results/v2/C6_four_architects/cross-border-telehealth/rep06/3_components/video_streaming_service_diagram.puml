@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Web_Mobile_Apps, "Web & Mobile Apps", "Clients using the telehealth platform")

Container_Boundary(video_streaming_service, "Video Streaming Service") {
    Component(Signaling_Server, "Signaling Server", "Node.js / WebSockets", "Handles session control and WebSockets signaling for clients.")
    Component(SFU_Router_Core, "SFU Router Core", "mediasoup / C++ / Node.js", "Minimizes CPU and bandwidth overhead for video routing and media streaming.")
    Component(Adaptive_Bitrate_Quality_Manager, "Adaptive Bitrate & Quality Manager", "Go", "Adjusts simulcast layers and guarantees degraded-mode operation below 300 kbit/s.")
    Component(TURN_STUN_Relay_Manager, "TURN/STUN Relay Manager", "Coturn on GCP Compute Engine", "Handles NAT traversal for unstable rural connections.")
    Component(Media_Session_Audit_Logger, "Media Session Audit Logger", "Go", "Emits session telemetry.")
    Component(Geo_Distributed_TURN_Coordinator, "Geo-Distributed TURN Coordinator", "Go", "Provisions relay endpoints while ensuring regional data residency.")
}

Rel(Web_Mobile_Apps, Signaling_Server, "Session control", "WSS")
Rel(Web_Mobile_Apps, SFU_Router_Core, "Media streaming", "WebRTC/UDP/DTLS")
Rel(Adaptive_Bitrate_Quality_Manager, SFU_Router_Core, "Adjusts simulcast layers", "Internal IPC")
Rel(SFU_Router_Core, Media_Session_Audit_Logger, "Emits session telemetry", "gRPC")
Rel(Web_Mobile_Apps, Geo_Distributed_TURN_Coordinator, "Relay allocation", "HTTPS")
Rel(Geo_Distributed_TURN_Coordinator, TURN_STUN_Relay_Manager, "Provisions endpoints", "gRPC")

@enduml