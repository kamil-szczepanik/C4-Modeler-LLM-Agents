@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Symptom Checker Service container

Container_Boundary("ai_symptom_checker_service", "AI Symptom Checker Service") {
    Component(api_router, "API Router / Endpoint Controller", "FastAPI", "FastAPI-based controller validating incoming gRPC requests.")
    Component(consent_interceptor, "Consent & Policy Enforcement Interceptor", "FastAPI Middleware", "FastAPI Middleware verifying active patient consent per data-sharing purpose.")
    Component(guardrails_engine, "Regional Context & Guardrails Engine", "Python", "Enforces clinical triage guidelines and strips PHI prior to inference.")
    Component(inference_orchestrator, "Inference Orchestrator", "Python", "Manages prompt engineering, context windows, and model execution.")
    Component(ml_model_runtime, "ML Model Runtime", "ONNX Runtime / gRPC-local", "Runs local quantized LLM/classification models via ONNX Runtime / gRPC-local.")
    Component(clinical_triage_validator, "Clinical Triage Validator", "Python", "Post-processes urgency scores against deterministic safety thresholds.")
    Component(audit_logger, "Audit & Traceability Logger", "Python", "Captures inputs, model versions, and outputs for EU MDR traceability.")
}

System_Ext(google_cloud_pub_sub, "Google Cloud Pub/Sub", "Asynchronous messaging system")
System_Ext(google_cloud_storage, "Google Cloud BigQuery / Cloud Storage", "Regional datastores for compliance logging")

Rel(api_router, consent_interceptor, "In-process FastAPI Middleware", "In-process")
Rel(consent_interceptor, guardrails_engine, "In-process", "In-process")
Rel(guardrails_engine, inference_orchestrator, "In-process", "In-process")
Rel(inference_orchestrator, ml_model_runtime, "In-process via ONNX Runtime / gRPC-local", "gRPC-local")
Rel(inference_orchestrator, clinical_triage_validator, "In-process", "In-process")
Rel(clinical_triage_validator, api_router, "In-process", "In-process")
Rel(audit_logger, google_cloud_pub_sub, "gRPC", "gRPC")
Rel(audit_logger, google_cloud_storage, "REST/gRPC via Pub/Sub", "REST/gRPC")

@enduml