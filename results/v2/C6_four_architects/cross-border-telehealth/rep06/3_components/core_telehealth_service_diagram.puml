@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Telehealth Service container

Container_Boundary(core_telehealth_service, "Core Telehealth Service") {
    Component(consultation_manager, "Consultation Manager", "Go", "Orchestrates video session lifecycles.")
    Component(prescription_engine, "Prescription Engine", "Go", "Manages regional e-prescription routing.")
    Component(consent_policy_engine, "Consent & Policy Enforcement Engine", "Go", "Enforces region-specific data residency and explicit patient consents.")
    Component(audit_logger, "Audit Logger", "Go", "Emits structured audit trails.")
    Component(symptom_checker_orchestrator, "Symptom Checker Orchestrator", "Go", "Coordinates AI triage assessments and model versioning.")
    Component(degraded_mode_handler, "Degraded Mode Handler", "Go", "Adapts network quality for low-bandwidth connections.")
}

System_Ext(datastores, "Datastores", "Cloud SQL PostgreSQL, Memorystore Redis, and Google Cloud BigQuery.")
System_Ext(video_streaming_service, "Video Streaming Service", "mediasoup SFU on GCP Compute Engine with TURN/STUN relay.")
System_Ext(ai_symptom_checker_service, "AI Symptom Checker Service", "Python / FastAPI")
System_Ext(integration_service, "Integration Service", "Node.js")

Rel(consent_policy_engine, datastores, "Executes region-isolated queries", "PostgreSQL and Redis protocols")
Rel(consultation_manager, video_streaming_service, "Controls media sessions", "gRPC")
Rel(symptom_checker_orchestrator, ai_symptom_checker_service, "Triggers triage analysis", "gRPC")
Rel(prescription_engine, integration_service, "Dispatches regional e-prescription payloads", "gRPC")
Rel(consultation_manager, audit_logger, "Dispatches immutable tracing payloads", "Buffered Go Channels")
Rel(prescription_engine, audit_logger, "Dispatches immutable tracing payloads", "Buffered Go Channels")
Rel(consent_policy_engine, audit_logger, "Dispatches immutable tracing payloads", "Buffered Go Channels")
Rel(symptom_checker_orchestrator, audit_logger, "Dispatches immutable tracing payloads", "Buffered Go Channels")
Rel(degraded_mode_handler, audit_logger, "Dispatches immutable tracing payloads", "Buffered Go Channels")

@enduml