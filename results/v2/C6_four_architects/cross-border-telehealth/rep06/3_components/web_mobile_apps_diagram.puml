@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web & Mobile Apps container

System_Ext(Video_Streaming_Service, "Video Streaming Service", "mediasoup SFU on GCP Compute Engine")
System_Ext(Google_Cloud_API_Gateway_with_OPA, "Google Cloud API Gateway with OPA", "Secured API routing and policy enforcement across regions")

Container_Boundary(Web___Mobile_Apps, "Web & Mobile Apps") {
    Component(UI_Presentation_Layer, "UI Presentation Layer", "React / React Native Component", "Cross-platform UI development for web and mobile devices.")
    Component(Video_Audio_Session_Controller, "Video/Audio Session Controller", "Component", "Manages real-time video/audio streaming sessions with adaptive bitrate and fallback support.")
    Component(Offline_Data_Synchronizer, "Offline Data Synchronizer", "Component", "Handles offline data caching and synchronization using local storage.")
    Component(Regional_Configuration___Telemetry_Manager, "Regional Configuration & Telemetry Manager", "Component", "Manages regional configuration and telemetry data.")
    Component(Local_Consent___State_Manager, "Local Consent & State Manager", "Component", "Manages client-side consent and local state persistence.")
}

Rel(UI_Presentation_Layer, Regional_Configuration___Telemetry_Manager, "Local JS Calls", "")
Rel(UI_Presentation_Layer, Local_Consent___State_Manager, "Local JS Calls", "")
Rel(UI_Presentation_Layer, Offline_Data_Synchronizer, "Local JS Calls", "")
Rel(Video_Audio_Session_Controller, Video_Streaming_Service, "WebRTC/UDP, failing over to TCP/TURN relay via API Gateway", "")
Rel(Regional_Configuration___Telemetry_Manager, Google_Cloud_API_Gateway_with_OPA, "mTLS / HTTPS / WSS with regional headers", "")
Rel(UI_Presentation_Layer, Google_Cloud_API_Gateway_with_OPA, "mTLS / HTTPS / WSS with regional headers", "")
Rel(Local_Consent___State_Manager, Offline_Data_Synchronizer, "Local JS Calls", "")
@enduml