@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_boundary, "Google Cloud API Gateway with OPA") {
    Component(API_Router, "API Router", "Google Cloud API Gateway", "Routes incoming requests to backend services and coordinates with rate limiting and context extraction.")
    Component(Context_Extractor, "Context Extractor", "Google Cloud API Gateway", "Extracts raw requests and passes claims to the authorization engine.")
    Component(Rate_Limiting_Component, "Rate Limiting Component", "Google Cloud API Gateway / Memorystore Redis", "Checks quotas and throttles traffic.")
    Component(Authorization_Engine_OPA_, "Authorization Engine (OPA)", "Open Policy Agent", "Enforces dynamic purpose-based patient consent via Rego policies.")
    Component(Audit_Logger, "Audit Logger", "Fluentbit sidecar", "Emits and forwards structured decision logs.")
}

Rel(API_Router, Rate_Limiting_Component, "Checks quotas", "gRPC / Memorystore Redis")
Rel(API_Router, Context_Extractor, "Passes raw requests", "In-memory")
Rel(Context_Extractor, Authorization_Engine_OPA_, "Forwards claims", "gRPC")
Rel(Authorization_Engine_OPA_, Audit_Logger, "Emits decision logs", "Async IPC / Fluentd")

@enduml