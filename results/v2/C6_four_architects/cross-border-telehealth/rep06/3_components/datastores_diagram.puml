@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(datastores, "Datastores") {
    Component(RegionalTransactionalDB, "Regional Transactional DB", "Cloud SQL PostgreSQL", "Relational transactional database for core telehealth data and user management.")
    Component(CachingLayer, "Caching Layer", "Memorystore Redis", "In-memory cache for low-latency session management and temporary state.")
    Component(AuditAnalyticsStore, "Audit & Analytics Store", "Google Cloud BigQuery", "Immutable storage for AI traceability logging and compliance reporting.")
    Component(DocumentStoreFHIRRepository, "Document Store / FHIR Repository", "Google Cloud Storage", "Repository for FHIR resources and e-prescriptions.")
    Component(EncryptionKeyManagementComponent, "Encryption Key Management Component", "Google Cloud KMS", "Manages customer-managed encryption keys for strict cryptographic data-at-rest isolation.")
    Component(CDCEventIngestionPipeline, "CDC & Event Ingestion Pipeline", "Google Cloud Pub/Sub & Dataflow", "Asynchronous event ingestion pipeline for zero-loss telemetry logging and change data capture.")
    Component(DataMaskingTokenizationComponent, "Data Masking & Tokenization Component", "Internal Service / Custom Library", "Sanitizes PHI and PII data.")
    Component(DatabaseConnectionPooling, "Database Connection Pooling", "PgBouncer", "Manages database connections for resilience against network flapping.")
}

Rel(RegionalTransactionalDB, EncryptionKeyManagementComponent, "Data-at-rest encryption", "gRPC over TLS with IAM")
Rel(DocumentStoreFHIRRepository, EncryptionKeyManagementComponent, "Data-at-rest encryption", "gRPC over TLS with IAM")
Rel(AuditAnalyticsStore, EncryptionKeyManagementComponent, "Data-at-rest encryption", "gRPC over TLS with IAM")
Rel(RegionalTransactionalDB, CDCEventIngestionPipeline, "Change data capture streams", "Google Cloud Pub/Sub native protocol over TLS")
Rel(AuditAnalyticsStore, RegulatoryAndComplianceAuditors, "Compliance reporting", "BigQuery SQL via IAM-secured HTTPS")
@enduml