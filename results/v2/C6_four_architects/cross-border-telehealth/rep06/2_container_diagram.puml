@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients_and_Clinicians, "Patients and Clinicians", "Primary users who conduct video consultations, use the AI symptom checker, and manage e-prescriptions.")

System_Ext(External_Pharmacy_Networks, "External Pharmacy Networks", "External systems for processing regional e-prescriptions using HL7 FHIR and national standards.")
System_Ext(National_Identity_Providers, "National Identity Providers", "External systems providing authentication and identity verification via OIDC/SAML.")
System_Ext(Payment_and_Insurance_Providers, "Payment and Insurance Providers", "External systems handling payment transactions and insurance claims via HTTPS.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(Web_Mobile_Apps, "Web & Mobile Apps", "React / React Native", "Provides the user interface for patients and clinicians across web and mobile devices.")
    Container(Google_Cloud_API_Gateway_with_OPA, "Google Cloud API Gateway with OPA", "Google Cloud API Gateway, Open Policy Agent (OPA)", "Handles API routing, security enforcement, and dynamic, purpose-based patient consent policies.")
    Container(Core_Telehealth_Service, "Core Telehealth Service", "Go", "Powers the core business logic execution for telehealth operations.")
    Container(AI_Symptom_Checker_Service, "AI Symptom Checker Service", "Python / FastAPI", "Runs inference for the AI symptom checker service.")
    Container(Video_Streaming_Service, "Video Streaming Service", "mediasoup SFU on GCP Compute Engine, TURN/STUN relay", "Handles video streaming and rural low-bandwidth connections.")
    Container(Integration_Service, "Integration Service", "Node.js", "Integrates with external pharmacy networks via national standards and HL7 FHIR.")
    ContainerDb(Datastores, "Datastores", "Cloud SQL PostgreSQL, Memorystore Redis, Google Cloud BigQuery / Cloud Storage", "Provides region-isolated transactional, cache, and immutable audit log storage.")
}

Rel(Patients_and_Clinicians, Web_Mobile_Apps, "Interacts with the platform", "HTTPS, WSS, and WebRTC/UDP")
Rel(Web_Mobile_Apps, Google_Cloud_API_Gateway_with_OPA, "Sends API requests and establishes media connections", "HTTPS, WSS, and WebRTC/UDP")
Rel(Web_Mobile_Apps, Video_Streaming_Service, "Streams video consultations", "WebRTC/UDP")
Rel(Google_Cloud_API_Gateway_with_OPA, Core_Telehealth_Service, "Routes internal API requests", "gRPC")
Rel(Google_Cloud_API_Gateway_with_OPA, AI_Symptom_Checker_Service, "Routes AI symptom check requests", "gRPC")
Rel(Core_Telehealth_Service, Datastores, "Reads and writes transactional data and cache", "PostgreSQL and Redis protocols")
Rel(AI_Symptom_Checker_Service, Datastores, "Maintains immutable audit logs for AI traceability", "Google Cloud Pub/Sub and BigQuery / Cloud Storage")
Rel(Integration_Service, External_Pharmacy_Networks, "Sends and receives e-prescriptions", "National standards and HL7 FHIR")
Rel(Google_Cloud_API_Gateway_with_OPA, Google_Cloud_API_Gateway_with_OPA, "Cross-region access between gateways", "Federated mTLS over HTTPS")

@enduml