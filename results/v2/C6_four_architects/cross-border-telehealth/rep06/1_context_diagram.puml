@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Cross-Border Telehealth Platform

Person(Patients_and_Clinicians, "Patients and Clinicians", "Primary users who conduct video consultations, use the AI symptom checker, and manage e-prescriptions.")
Person(Regulatory_and_Compliance_Auditors, "Regulatory and Compliance Auditors", "External users who audit platform compliance with regional data residency and healthcare regulations.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and the US while ensuring strict regional data residency, regulatory compliance, and low-bandwidth availability.")

System_Ext(External_Pharmacy_Networks, "External Pharmacy Networks", "External systems for processing regional e-prescriptions using HL7 FHIR and REST APIs.")
System_Ext(National_Identity_Providers, "National Identity Providers", "External systems providing authentication and identity verification via OIDC/SAML.")
System_Ext(Payment_and_Insurance_Providers, "Payment and Insurance Providers", "External systems handling payment transactions and insurance claims via HTTPS.")

Rel(Patients_and_Clinicians, Cross_Border_Telehealth_Platform, "Accesses video consultations, e-prescriptions, and AI symptom checker", "HTTPS and WebRTC")
Rel(Regulatory_and_Compliance_Auditors, Cross_Border_Telehealth_Platform, "Audits platform logs and compliance data", "Cloud Logging and Regional Datastores")
Rel(Cross_Border_Telehealth_Platform, External_Pharmacy_Networks, "Sends and receives e-prescriptions and health records", "REST and HL7 FHIR APIs")
Rel(Cross_Border_Telehealth_Platform, National_Identity_Providers, "Authenticates users", "OIDC/SAML")
Rel(Cross_Border_Telehealth_Platform, Payment_and_Insurance_Providers, "Processes payments and insurance claims", "HTTPS")

@enduml