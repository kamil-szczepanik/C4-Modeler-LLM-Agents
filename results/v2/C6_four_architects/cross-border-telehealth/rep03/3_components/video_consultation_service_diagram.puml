@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Video Consultation Service container

Container_Boundary(video_consultation_service, "Video Consultation Service") {
    Component(Signaling, "Signaling", "Node.js", "Handles signaling for WebRTC peer connections.")
    Component(SFU_Router, "SFU Router", "Mediasoup", "Routes media streams between participants in a video session.")
    Component(Adaptive_Transcoder, "Adaptive Transcoder", "Node.js", "Adjusts media quality based on bandwidth conditions.")
    Component(Session_Policy_Enforcer, "Session Policy Enforcer", "Node.js", "Enforces session policies and access controls.")
    Component(Compliance_Audit_Interceptor, "Compliance Audit Interceptor", "Node.js", "Interprets and captures session data for compliance auditing.")
    Component(TURN_STUN_Orchestrator, "TURN/STUN Orchestrator", "Node.js", "Orchestrates NAT traversal via TURN/STUN servers.")
    Component(Media_Quality_Monitor, "Media Quality Monitor", "Node.js", "Monitors the quality of active media streams.")
    Component(Room_State_Manager, "Room State Manager", "Node.js / Redis", "Manages active session and room states.")
    Component(Media_Encryption_Enforcer, "Media Encryption Enforcer", "Node.js", "Enforces end-to-end encryption for media streams.")
}

System_Ext(Audit_Compliance_Logger_Sidecar, "Audit & Compliance Logger Sidecar", "Fluentbit / Go")
System_Ext(TURN_STUN_Relay_Server, "TURN/STUN Relay Server", "Coturn")

Rel(Signaling, Room_State_Manager, "Reads/writes active session states", "TCP/Redis")
Rel(Compliance_Audit_Interceptor, Audit_Compliance_Logger_Sidecar, "Streams session telemetry", "gRPC")
Rel(SFU_Router, TURN_STUN_Relay_Server, "Relays encrypted SRTP media streams", "UDP/TCP via TURN")

@enduml