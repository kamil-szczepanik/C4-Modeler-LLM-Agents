@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Storage container

Container_Boundary(data_storage, "Data Storage") {
    Component(Relational Data Store, "Relational Data Store", "Cloud SQL PostgreSQL", "Stores structured clinical records, prescription workflows, identity, and consent data.")
    Component(Object Store, "Object Store", "Cloud Storage", "Stores unstructured medical assets and binary transfers using signed URLs.")
    Component(Event Bus, "Event Bus", "Cloud Pub/Sub", "Handles asynchronous event-driven integration and messaging.")
    Component(Audit & Traceability Store, "Audit & Traceability Store", "Append-Only PostgreSQL", "Logs tamper-evident audit trails, inputs, and model versions.")
}

Component(Clinical Core & E-Prescription Service, "Clinical Core & E-Prescription Service", "Service", "Handles clinical records and prescription workflows.")
Component(AI Symptom Checker Service, "AI Symptom Checker Service", "Service", "Evaluates patient symptoms and recommends care urgency.")
Component(Consent & Identity Management Service, "Consent & Identity Management Service", "Service", "Manages authentication and user data-sharing permissions.")
Component(Notification & Pharmacy Integration Service, "Notification & Pharmacy Integration Service", "Service", "Handles messaging and external pharmacy communications.")

Rel(Clinical Core & E-Prescription Service, Relational Data Store, "Reads and writes structured data", "PostgreSQL Wire Protocol (TLS 1.3) using CMEK")
Rel(AI Symptom Checker Service, Relational Data Store, "Reads clinical context and writes session states", "PostgreSQL Wire Protocol (TLS 1.3)")
Rel(AI Symptom Checker Service, Audit & Traceability Store, "Logs inputs and model versions", "PostgreSQL Wire Protocol (TLS 1.3)")
Rel(Consent & Identity Management Service, Relational Data Store, "Stores identity and consent data", "PostgreSQL Wire Protocol (TLS 1.3)")
Rel(Notification & Pharmacy Integration Service, Event Bus, "Publishes and consumes events", "Cloud Pub/Sub (gRPC/HTTPS)")

@enduml