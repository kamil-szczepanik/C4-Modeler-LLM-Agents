@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit & Compliance Logger Sidecar container

Container_Boundary("Audit_Compliance_Logger_Sidecar", "Audit & Compliance Logger Sidecar") {
    Component("Log_Ingestion_Receiver", "Log Ingestion Receiver", "Fluentbit Core", "Captures logs securely from app containers via Unix Domain Sockets.")
    Component("Compliance_Sanitizer_Masker", "Compliance Sanitizer & Masker", "Go Custom Plugin / Filter", "Sanitizes and masks compliance logs to ensure regulatory adherence.")
    Component("Regional_Dispatcher", "Regional Dispatcher", "Fluentbit Output Plugin", "Routes compliance logs while enforcing regional data residency.")
    Component("Traceability_Indexer", "Traceability Indexer", "Go Sidecar Agent", "Handles AI traceability and indexing.")
    Component("Buffer_Resiliency_Manager", "Buffer & Resiliency Manager", "Fluentbit Mem/Filesystem Buffer", "Manages filesystem I/O chunk storage for resiliency and zero log loss.")
}

Rel("Log_Ingestion_Receiver", "Compliance_Sanitizer_Masker", "Passes raw logs", "Go-routine channels")
Rel("Compliance_Sanitizer_Masker", "Traceability_Indexer", "Sends sanitized data", "Go function calls")
Rel("Traceability_Indexer", "Buffer_Resiliency_Manager", "Writes data to filesystem", "Fluentbit Chunk Storage")
Rel("Buffer_Resiliency_Manager", "Regional_Dispatcher", "Dispatches buffered logs", "Mutual TLS")

@enduml