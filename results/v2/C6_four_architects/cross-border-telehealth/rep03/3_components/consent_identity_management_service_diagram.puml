@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(consent_identity_management_service, "Consent & Identity Management Service") {
    Component(Regional_Tenant_Router_Component, "Regional Tenant Router Component", "Spring Cloud / Java", "Routes identity and consent requests based on regional infrastructure and data residency constraints.")
    Component(Identity___Federation_Component, "Identity & Federation Component", "Spring Security / OAuth2", "Handles user authentication, federation, and session management.")
    Component(Consent_Ledger_Component, "Consent Ledger Component", "Spring Data JPA", "Manages localized database queries and maintains consent ledgers.")
    Component(OPA_Policy_Sidecar_Component, "OPA Policy Sidecar Component", "Rego / Go", "Delivers low-latency policy evaluation for cross-border access control.")
    Component(Local_Credential_Cache_Component, "Local Credential Cache Component", "Spring Cache / Redis", "Caches tokens and active consent for degraded network conditions.")
    Component(Compliance_Token_Verifier_Component, "Compliance Token Verifier Component", "Spring Security JWT", "Delegates token parsing and validation and passes verified residency metadata.")
    Component(Emergency_Break_Glass_Component, "Emergency Break-Glass Component", "Java / Spring Security", "Handles emergency override events and logs them via audit interceptors.")
    Component(Consent_Revocation_Broadcaster_Component, "Consent Revocation Broadcaster Component", "Spring Cloud Stream / Cloud Pub/Sub", "Emits revocation notices and publishes revocation events to data storage.")
    Component(Audit_Interceptor_Component, "Audit Interceptor Component", "Spring AOP", "Logs override events for compliance and auditing purposes.")
}

Rel(Identity___Federation_Component, Compliance_Token_Verifier_Component, "Delegates token parsing and validation", "In-process Java method call")
Rel(Compliance_Token_Verifier_Component, Regional_Tenant_Router_Component, "Passes verified residency metadata", "In-process Java method call")
Rel(Regional_Tenant_Router_Component, Consent_Ledger_Component, "Forwards localized database queries", "PostgreSQL Wire Protocol")
Rel(Consent_Policy_Engine, OPA_Policy_Sidecar_Component, "Delegates access authorization", "Local REST/UDS over mTLS")
Rel(Identity___Federation_Component, Local_Credential_Cache_Component, "Manages user sessions", "Redis protocol over mTLS")
Rel(Consent_Ledger_Component, Consent_Revocation_Broadcaster_Component, "Emits revocation notices", "Spring ApplicationEvent")
Rel(Consent_Revocation_Broadcaster_Component, Data_Storage, "Publishes revocation events", "Pub/Sub over mTLS")
Rel(Emergency_Break_Glass_Component, Audit_Interceptor_Component, "Logs override events", "Spring ApplicationEvent")

@enduml