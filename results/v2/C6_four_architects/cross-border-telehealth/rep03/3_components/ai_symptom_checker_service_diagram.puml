@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(ai_symptom_checker_service, "AI Symptom Checker Service") {
    Component(Symptom Assessment API Handler, "Symptom Assessment API Handler", "Python / FastAPI", "High-performance asynchronous API handling and request validation.")
    Component(Consent & Policy Enforcer, "Consent & Policy Enforcer", "Python / OPA SDK", "Runtime GDPR/HIPAA data-processing consent enforcement.")
    Component(Clinical NLP Processor, "Clinical NLP Processor", "Python / spaCy & Transformers", "Advanced NLP for extracting clinical entities from unstructured text.")
    Component(Inference Orchestrator, "Inference Orchestrator", "Python / PyTorch / LangChain", "Core ML inference orchestration and regional LLM execution.")
    Component(Regional Model Gateway, "Regional Model Gateway", "Python / HTTPX", "Enforces strict regional data residency in GCP via regional LLM endpoints.")
    Component(Safety & Fallback Guardrail Engine, "Safety & Fallback Guardrail Engine", "Python / Rule-based heuristics", "Validates raw urgency recommendations and provides deterministic safety guardrails.")
    Component(Traceability & Audit Emitter, "Traceability & Audit Emitter", "Python / OpenTelemetry SDK", "Publishes immutable audit logs for EU MDR traceability.")
    Component(Audit Persistence Hook, "Audit Persistence Hook", "Python / SQLAlchemy", "Regional PostgreSQL persistence for EU MDR traceability and audit logs.")
}

Rel(Symptom Assessment API Handler, Consent & Policy Enforcer, "Validates active data-processing consent", "gRPC / Local Cache")
Rel(Symptom Assessment API Handler, Clinical NLP Processor, "Extracts entities", "In-memory")
Rel(Clinical NLP Processor, Inference Orchestrator, "Requests urgency score", "In-memory")
Rel(Inference Orchestrator, Regional Model Gateway, "Dispatches sanitized features to regional LLM endpoints", "REST/mTLS")
Rel(Inference Orchestrator, Safety & Fallback Guardrail Engine, "Validates raw urgency recommendation", "In-memory")
Rel(Safety & Fallback Guardrail Engine, Symptom Assessment API Handler, "Returns finalized care urgency", "In-memory")
Rel(Inference Orchestrator, Traceability & Audit Emitter, "Publishes immutable audit logs", "gRPC")
Rel(Traceability & Audit Emitter, Audit Persistence Hook, "Persists audit logs locally", "PostgreSQL over mTLS")

@enduml