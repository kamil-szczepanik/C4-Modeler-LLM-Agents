@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification & Pharmacy Integration Service container

Container_Boundary(notification_pharmacy_integration_service, "Notification & Pharmacy Integration Service") {
    Component(Regional_Integration_Router_Component, "Regional Integration Router Component", "Go", "Routes regional integration requests and dispatches tasks to adapters and dispatchers.")
    Component(EU_US_Pharmacy_Adapter_Components, "EU/US Pharmacy Adapter Components", "Go", "Adapters for EU and US pharmacy integrations handling e-prescriptions.")
    Component(Notification_Dispatcher_Component, "Notification Dispatcher Component", "Go", "Dispatches notifications and alerts to external providers.")
    Component(Outbox_Delivery_Tracker_Component, "Outbox & Delivery Tracker Component", "Go", "Manages the transactional outbox pattern and tracks delivery states.")
    Component(Audit_Compliance_Logger_Sidecar, "Audit & Compliance Logger Sidecar", "Fluentbit / Go", "Emits audit logs via Unix Domain Sockets for compliance.")
}

Component(Cloud_Pub_Sub, "Cloud Pub/Sub", "Google Cloud Pub/Sub", "Regional messaging for reliable asynchronous event streaming.")
Component(Cloud_SQL_PostgreSQL, "Cloud SQL PostgreSQL", "PostgreSQL", "Regional persistence for transactional outbox and delivery tracking.")
Component(External_Pharmacy_Gateways, "External Pharmacy Gateways", "HTTPS/REST (TLS 1.3)", "External gateways for EU/US pharmacies.")
Component(External_Notification_Providers, "External Notification Providers", "Twilio, Firebase, HTTPS/REST (TLS 1.3)", "External providers for sending alerts.")

Rel(Cloud_Pub_Sub, Regional_Integration_Router_Component, "Delivers async events", "Pub/Sub Pull/Push")
Rel(Regional_Integration_Router_Component, EU_US_Pharmacy_Adapter_Components, "Dispatches tasks", "In-Process Go Channels")
Rel(Regional_Integration_Router_Component, Notification_Dispatcher_Component, "Dispatches tasks", "In-Process Go Channels")
Rel(EU_US_Pharmacy_Adapter_Components, External_Pharmacy_Gateways, "Sends e-prescription data", "HTTPS/REST (TLS 1.3)")
Rel(Notification_Dispatcher_Component, External_Notification_Providers, "Sends alerts", "HTTPS/REST (TLS 1.3)")
Rel(Outbox_Delivery_Tracker_Component, Cloud_SQL_PostgreSQL, "Persists delivery state", "pgx / SQL over TLS 1.3")
Rel(Outbox_Delivery_Tracker_Component, Audit_Compliance_Logger_Sidecar, "Emits audit logs", "Unix Domain Sockets")

@enduml