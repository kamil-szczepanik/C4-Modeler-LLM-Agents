@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(turn_stun_relay_server, "TURN/STUN Relay Server") {
    Component(stun_turn_allocation_manager, "STUN/TURN Allocation Manager", "C++", "Manages STUN/TURN allocations and validates HMAC time-limited tokens asynchronously.")
    Component(media_relay_engine, "Media Relay Engine", "C++", "Relays adaptive bitrate media streams to external WebRTC clients.")
    Component(region_bound_access_controller, "Region-Bound Access Controller", "Lua", "Enforces strict geo-routing for regional data residency.")
    Component(bandwidth_throttling_adaptation_module, "Bandwidth Throttling & Adaptation Module", "C++", "Handles bandwidth throttling and adaptation for resilient connectivity.")
    Component(load_balanced_listener_port_router, "Load-Balanced Listener & Port Router", "C++", "Routes incoming requests and handles STUN/TURN traffic over UDP/TCP/TLS 443/53.")
    Component(metrics_exporter_sidecar, "Metrics Exporter Sidecar", "Go", "Exports relay session telemetry for compliance auditing.")
    Component(audit_compliance_logger_sidecar, "Audit & Compliance Logger Sidecar", "Fluentbit / Go", "Logs audit and compliance data for GDPR and HIPAA adherence.")
}

System_Ext(external_webrtc_clients, "External WebRTC Clients", "External clients connecting via WebRTC.")
System_Ext(consent_identity_management_service, "Consent & Identity Management Service", "Manages consent and identity.")

Rel(external_webrtc_clients, load_balanced_listener_port_router, "Initiates STUN/TURN requests", "STUN/TURN over UDP/TCP/TLS 443/53")
Rel(stun_turn_allocation_manager, consent_identity_management_service, "Validates HMAC time-limited tokens asynchronously", "REST/HTTPS")
Rel(media_relay_engine, external_webrtc_clients, "Relays adaptive bitrate media streams", "SRTP over UDP/TCP")
Rel(metrics_exporter_sidecar, audit_compliance_logger_sidecar, "Exports relay session telemetry", "Prometheus/HTTP")
Rel(video_consultation_service, stun_turn_allocation_manager, "Provisions short-term TURN auth tokens")
@enduml