@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients_and_Clinicians, "Patients and Clinicians", "Users located in the EU and US interacting with the telehealth platform for consultations and health checks.")

System_Ext(External_Pharmacy_Gateways, "External Pharmacy Gateways", "External systems for processing e-prescriptions.")
System_Ext(Identity_Providers, "Identity Providers", "External identity providers handling authentication via OIDC/OAuth2.")
System_Ext(Stripe_Payment_Gateways, "Stripe Payment Gateways", "External payment processors handling financial transactions.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(API_Gateway___BFF, "API Gateway / BFF", "Go / Envoy", "Provides API gateway and backend-for-frontend services.")
    Container(Video_Consultation_Service, "Video Consultation Service", "Node.js / WebRTC SFU / Mediasoup", "Handles video consultations and real-time communication.")
    Container(TURN_STUN_Relay_Server, "TURN/STUN Relay Server", "Coturn", "Relays media traffic for WebRTC under restricted network conditions.")
    Container(Clinical_Core___E_Prescription_Service, "Clinical Core & E-Prescription Service", "Java / Spring Boot", "Manages clinical core business logic and e-prescriptions.")
    Container(AI_Symptom_Checker_Service, "AI Symptom Checker Service", "Python / FastAPI", "Provides AI-powered symptom checking for patients.")
    Container(Consent___Identity_Management_Service, "Consent & Identity Management Service", "Java / Spring Security", "Manages user consent, authentication, and identity security.")
    Container(Notification___Pharmacy_Integration_Service, "Notification & Pharmacy Integration Service", "Go", "Sends notifications and integrates with external pharmacies.")
    Container(Audit___Compliance_Logger_Sidecar, "Audit & Compliance Logger Sidecar", "Fluentbit / Go", "Logs audit trails and enforces compliance sidecar duties.")
    ContainerDb(Data_Storage, "Data Storage", "Cloud SQL PostgreSQL, Cloud Storage, Cloud Pub/Sub", "Provides persistent regional data storage, object storage, and messaging.")
}

Rel(Patients_and_Clinicians, API_Gateway___BFF, "Sends API requests and connects via client apps", "HTTPS / WSS (JSON/gRPC)")
Rel(API_Gateway___BFF, Video_Consultation_Service, "Routes consultation requests", "gRPC over mTLS")
Rel(API_Gateway___BFF, Clinical_Core___E_Prescription_Service, "Routes clinical requests", "gRPC over mTLS")
Rel(API_Gateway___BFF, AI_Symptom_Checker_Service, "Routes AI symptom check requests", "gRPC over mTLS")
Rel(API_Gateway___BFF, Consent___Identity_Management_Service, "Routes identity and consent requests", "gRPC over mTLS")
Rel(API_Gateway___BFF, Notification___Pharmacy_Integration_Service, "Routes notification and pharmacy requests", "gRPC over mTLS")
Rel(Video_Consultation_Service, TURN_STUN_Relay_Server, "Relays media streams", "UDP/TCP (WebRTC)")
Rel(Notification___Pharmacy_Integration_Service, External_Pharmacy_Gateways, "Sends e-prescription data", "HTTPS/REST (TLS 1.3)")
Rel(Consent___Identity_Management_Service, Identity_Providers, "Authenticates users", "OIDC/OAuth2")
Rel(API_Gateway___BFF, Stripe_Payment_Gateways, "Processes payments", "HTTPS/REST")
Rel(Clinical_Core___E_Prescription_Service, Data_Storage, "Reads and writes clinical data", "PostgreSQL Wire Protocol / HTTPS with CMEK")
Rel(Consent___Identity_Management_Service, Data_Storage, "Stores identity and consent data", "PostgreSQL Wire Protocol / HTTPS with CMEK")
Rel(Notification___Pharmacy_Integration_Service, Data_Storage, "Publishes and consumes events", "Cloud Pub/Sub")

@enduml