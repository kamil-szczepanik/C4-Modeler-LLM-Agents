@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_and_Clinicians, "Patients and Clinicians", "Users located in the EU and US interacting with the telehealth platform for consultations and health checks.")
System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and US while enforcing strict regional data residency and regulatory compliance on GCP.")
System_Ext(External_Pharmacy_Gateways, "External Pharmacy Gateways", "External systems for processing e-prescriptions.")
System_Ext(Identity_Providers_IdP, "Identity Providers (IdP)", "External identity providers handling authentication via OIDC/OAuth2.")
System_Ext(Payment_Gateways_Stripe, "Payment Gateways (Stripe)", "External payment processors handling financial transactions.")

Rel(Patients_and_Clinicians, Cross_Border_Telehealth_Platform, "Accesses video consultations, e-prescriptions, and AI symptom checker", "HTTPS, WebRTC, OIDC/OAuth2")
Rel(Cross_Border_Telehealth_Platform, External_Pharmacy_Gateways, "Sends e-prescription data", "mTLS, REST, SOAP, HL7 FHIR")
Rel(Cross_Border_Telehealth_Platform, Identity_Providers_IdP, "Authenticates users", "OIDC/OAuth2")
Rel(Cross_Border_Telehealth_Platform, Payment_Gateways_Stripe, "Processes payments", "HTTPS, REST with webhooks")
@enduml