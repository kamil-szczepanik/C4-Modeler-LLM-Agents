@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients_and_Clinicians, "Patients and Clinicians", "External actors who use the platform for video consultations, e-prescriptions, and AI symptom checking.")

System_Ext(Global_Media_Relay_Network, "Global Media Relay Network", "External WebRTC Infrastructure for video consultations.")
System_Ext(National_E_Prescription_Gateways_EU_and_US_Pharmacy_Networks, "National E-Prescription Gateways (EU) and US Pharmacy Networks", "External systems for handling e-prescriptions.")
System_Ext(Identity_and_Consent_Providers, "Identity & Consent Providers", "Regional External IDPs for authentication and consent management.")
System_Ext(AI_Model_Registry_and_Inference_Provider, "AI Model Registry & Inference Provider", "External ML Service for AI symptom checker.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(API_Gateway___BFF, "API Gateway / BFF", "Cloud Run / Cloud Load Balancing", "Handles signaling and app interactions.")
    Container(Consultation_Service___AI_Proxy___Audit_Service, "Consultation Service & AI Proxy & Audit Service", "GKE Microservices", "Core backend logic and proxy services.")
    Container(Consent___Identity_Service___E_Prescription_Integration_Service, "Consent & Identity Service & E-Prescription Integration Service", "Cloud Run Containers", "Manages identity, consent, and prescriptions.")
    ContainerDb(Cloud_SQL_and_Cloud_Storage, "Cloud SQL and Cloud Storage", "Cloud SQL (PostgreSQL) and Cloud Storage", "Regional persistence layer with Customer-Managed Encryption Keys.")
}

Rel(Patients_and_Clinicians, Global_Media_Relay_Network, "Video consultations", "WebRTC/UDP/TCP over TLS")
Rel(Patients_and_Clinicians, API_Gateway___BFF, "Signaling and app interactions", "HTTPS/WebSockets")
Rel(API_Gateway___BFF, Consultation_Service___AI_Proxy___Audit_Service, "Internal communication", "gRPC over mTLS")
Rel(Consent___Identity_Service___E_Prescription_Integration_Service, National_E_Prescription_Gateways_EU_and_US_Pharmacy_Networks, "E-prescription integration", "HTTPS/REST (HL7 FHIR in US)")
Rel(Consultation_Service___AI_Proxy___Audit_Service, AI_Model_Registry_and_Inference_Provider, "AI inference requests", "gRPC/HTTPS")

@enduml