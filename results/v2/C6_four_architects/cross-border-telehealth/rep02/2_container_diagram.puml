@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients_and_Clinicians, "Patients and Clinicians", "External actors who use the platform for video consultations, e-prescriptions, and AI symptom checking.")
System_Ext(National_EPrescription_Gateways_US_Pharmacy_Networks, "National E-Prescription Gateways & US Pharmacy Networks", "External systems for handling national and regional e-prescriptions.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(Web_and_Mobile_Clients, "Web & Mobile Clients", "React / React Native", "Client-facing applications for patients and clinicians.")
    Container(API_Gateway_and_Routing, "API Gateway & Routing", "Kong / GCP API Gateway", "Manages and routes incoming client traffic securely.")
    Container(Core_Telehealth_Service, "Core Telehealth Service", "Java / Spring Boot", "Handles core business logic for telehealth consultations.")
    Container(WebRTC_Media_Broker, "WebRTC Media Broker", "Node.js / Mediasoup", "Manages real-time video and audio media streams, supporting degraded modes for unstable connections.")
    Container(AI_Symptom_Checker_Service, "AI Symptom Checker Service", "Python / FastAPI", "Provides AI-powered symptom analysis for patients.")
    Container(FHIR_and_EPrescription_Integration_Service, "FHIR & E-Prescription Integration Service", "Python / Java", "Integrates with external e-prescription gateways and pharmacy networks.")
    Container(Consent_and_Audit_Logging_Service, "Consent & Audit Logging Service", "Go", "Manages user consent and records immutable audit logs.")
    Container(Messaging, "Messaging", "Cloud Pub/Sub", "Asynchronous messaging backbone for decoupled services.")
    ContainerDb(Databases, "Databases", "Cloud SQL PostgreSQL, Cloud Storage", "Region-isolated transactional stores and cryptographically bound audit logs.")
}

Rel(Patients_and_Clinicians, Web_and_Mobile_Clients, "Accesses video consultations, e-prescriptions, and AI symptom checker", "HTTPS, WSS")
Rel(Web_and_Mobile_Clients, API_Gateway_and_Routing, "Sends client requests and signaling", "TLS 1.3 over HTTPS, WSS")
Rel(API_Gateway_and_Routing, Core_Telehealth_Service, "Routes telehealth requests via internal VPC Service Controls", "gRPC")
Rel(API_Gateway_and_Routing, AI_Symptom_Checker_Service, "Routes AI inference requests via internal VPC Service Controls", "gRPC")
Rel(Core_Telehealth_Service, WebRTC_Media_Broker, "Establishes media and signaling sessions", "gRPC, WebSockets/UDP")
Rel(AI_Symptom_Checker_Service, Messaging, "Publishes asynchronous AI events and outputs", "gRPC")
Rel(FHIR_and_EPrescription_Integration_Service, National_EPrescription_Gateways_US_Pharmacy_Networks, "Exchanges e-prescription data", "HTTPS with mTLS")
Rel(Consent_and_Audit_Logging_Service, Databases, "Stores audit logs and consent records encrypted via CMEK", "Cloud Storage / Cloud SQL")

@enduml