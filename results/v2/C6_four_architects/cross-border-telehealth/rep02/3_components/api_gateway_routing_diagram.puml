@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_routing, "API Gateway & Routing") {
    Component(Ingress_WAF_Controller, "Ingress WAF Controller", "Kong Enterprise Plugin", "Manages ingress traffic, Web Application Firewall protection, and threat mitigation.")
    Component(Geo_Routing_DNS_Router, "Geo-Routing & DNS Router", "Kong Enterprise / GCP Cloud DNS", "Routes client requests to the appropriate regional data residency boundary (EU vs US).")
    Component(mTLS_Security_Terminator, "mTLS & Security Terminator", "Kong Enterprise mTLS Plugin", "Terminates incoming TLS connections and establishes secure mTLS sessions for internal routing.")
}

Rel(Ingress_WAF_Controller, Geo_Routing_DNS_Router, "Filters and passes validated ingress requests", "")
Rel(Geo_Routing_DNS_Router, mTLS_Security_Terminator, "Forwards geographically routed requests for secure internal dispatch", "")

@enduml