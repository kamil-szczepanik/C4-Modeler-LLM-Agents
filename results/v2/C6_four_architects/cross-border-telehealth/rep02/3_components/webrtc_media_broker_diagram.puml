@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(web_rtc_media_broker, "WebRTC Media Broker") {
    Component(Signaling___Room_Manager, "Signaling & Room Manager", "Node.js / TypeScript", "Manages signaling and room coordination for video consultations.")
    Component(SFU_Core_Router, "SFU Core Router", "Mediasoup C++ worker wrapper", "Selective Forwarding Unit core router handling media streams.")
    Component(Adaptive_Bitrate___Quality_Controller, "Adaptive Bitrate & Quality Controller", "Node.js", "Controls adaptive bitrate and stream quality for low-bandwidth users.")
    Component(NAT_Traversal_Agents, "NAT Traversal Agents", "GCP STUN/TURN integration", "Handles NAT traversal using GCP STUN/TURN.")
    Component(Media_Region_Router, "Media Region Router", "C++ / Node.js", "Routes media streams to regional GCP nodes.")
    Component(Media_Session_Logger, "Media Session Logger", "Node.js", "Logs media session metadata and regional telemetry.")
    Component(Media_Encryption_Enforcer, "Media Encryption Enforcer", "DTLS-SRTP with AES-GCM", "Enforces native secure transport configuration for encrypted media streams.")
    Component(STUN_TURN_Health___Metrics_Exporter, "STUN/TURN Health & Metrics Exporter", "Node.js", "Exports health checks and metrics for STUN/TURN infrastructure.")
}

Rel(Signaling___Room_Manager, SFU_Core_Router, "Coordinates media routing", "")
Rel(SFU_Core_Router, Adaptive_Bitrate___Quality_Controller, "Asynchronous Worker IPC", "")
Rel(Media_Session_Logger, Consent___Audit_Logging_Service, "Regional Telemetry", "gRPC")
Rel(STUN_TURN_Health___Metrics_Exporter, Core_Telehealth_Service, "Health Check", "gRPC")

@enduml