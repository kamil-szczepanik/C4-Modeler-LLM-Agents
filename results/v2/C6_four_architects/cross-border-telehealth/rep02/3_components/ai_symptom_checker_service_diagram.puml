@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Symptom Checker Service container

System_Ext(External_AI_Model_Registry__Inference_Provider, "External AI Model Registry & Inference Provider", "External AI model inference provider.")
System_Ext(Cloud_Pub_Sub, "Cloud Pub/Sub", "Messaging protocol ensuring asynchronous, reliable transmission of immutable audit logs.")

Container_Boundary(AI_Symptom_Checker_Service, "AI Symptom Checker Service") {
    Component(Inference_Controller, "Inference Controller", "Python / FastAPI", "High-performance asynchronous API framework for handling internal gRPC and HTTP routing.")
    Component(Region_Aware_State_Sanitizer, "Region-Aware State Sanitizer", "Python", "Enforces strict regional data residency and PII minimization to satisfy GDPR and HIPAA compliance.")
    Component(Model_Orchestrator, "Model Orchestrator", "Python / LangChain", "Orchestration tooling for managing external AI model inference requests.")
    Component(Fallback___Caching_Engine, "Fallback & Caching Engine", "Redis / Python LRU", "Caching layer providing offline resilience and non-diagnostic triage guidelines for unstable connections.")
    Component(Metadata_Redactor, "Metadata Redactor", "Python", "Redacts sensitive metadata to protect patient data before logging.")
    Component(Audit___Traceability_Logger, "Audit & Traceability Logger", "Python", "Ensures EU MDR traceability through immutable logging.")
}

Rel(Inference_Controller, Region_Aware_State_Sanitizer, "In-process", "")
Rel(Region_Aware_State_Sanitizer, Model_Orchestrator, "gRPC", "")
Rel(Model_Orchestrator, Fallback___Caching_Engine, "Redis Protocol", "")
Rel(Model_Orchestrator, External_AI_Model_Registry__Inference_Provider, "HTTPS/gRPC", "")
Rel(Model_Orchestrator, Metadata_Redactor, "In-process", "")
Rel(Metadata_Redactor, Audit___Traceability_Logger, "In-process", "")
Rel(Audit___Traceability_Logger, Cloud_Pub_Sub, "gRPC", "")

@enduml