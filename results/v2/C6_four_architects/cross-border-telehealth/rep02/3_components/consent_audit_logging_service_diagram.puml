@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "API Gateway", "External API Gateway routing traffic to the Consent API Handler.")
System_Ext(core_telehealth_service, "Core Telehealth Service", "Microservice", "External telehealth service performing synchronous checks against the Consent Manager.")
System_Ext(ai_symptom_checker_service, "AI Symptom Checker Service", "AI Service", "External AI service performing synchronous checks against the Consent Manager.")
System_Ext(cloud_pub_sub, "Cloud Pub/Sub", "Messaging", "Cloud messaging service sending audit events to the Audit Logger.")
System_Ext(cloud_storage, "Cloud Storage", "Cloud Storage (WORM configuration)", "Provides WORM storage for immutable audit logs.")
System_Ext(regional_cloud_sql_databases, "Regional Cloud SQL Databases", "Cloud SQL PostgreSQL (europe-west3, us-central1)", "Provides regional persistence via PostgreSQL wire protocol over TLS 1.3.")
System_Ext(gcp_kms, "GCP KMS", "GCP KMS", "Enforces regional Customer-Managed Encryption Keys (CMEK).")

Container_Boundary(consent_audit_logging_service, "Consent & Audit Logging Service") {
    Component(consent_api_handler_component, "Consent API Handler Component", "Go, grpc-go, net/http", "Handles incoming Consent API requests via gRPC over HTTP/2.")
    Component(consent_manager_component, "Consent Manager Component", "Go, Open Policy Agent", "Manages consent and enforces rapid, stateless GDPR and HIPAA access rule evaluations.")
    Component(audit_logger_component, "Audit Logger Component", "Go, Crypto-Shredding & Hashing Sub-component", "Manages immutable audit trails and processes messages from Cloud Pub/Sub.")
    Component(compliance_export_component, "Compliance Export Component", "Go", "Handles compliance export functions using internal Go interface calls.")
    Component(storage_abstraction_layer, "Storage Abstraction Layer", "Go, CMEK Key Management Interface", "Provides storage abstraction and interfaces with GCP KMS for regional CMEK.")
}

Rel(api_gateway, consent_api_handler_component, "gRPC over HTTP/2")
Rel(core_telehealth_service, consent_manager_component, "gRPC synchronous checks")
Rel(ai_symptom_checker_service, consent_manager_component, "gRPC synchronous checks")
Rel(cloud_pub_sub, audit_logger_component, "AMQP/PubSub protocol")
Rel(consent_api_handler_component, consent_manager_component, "In-process Go function calls / channels")
Rel(consent_api_handler_component, audit_logger_component, "In-process Go function calls / channels")
Rel(audit_logger_component, cloud_storage, "HTTPS/Storage API")
Rel(consent_manager_component, regional_cloud_sql_databases, "PostgreSQL wire protocol via TLS 1.3")
Rel(storage_abstraction_layer, gcp_kms, "gRPC/Cloud KMS API via TLS 1.3")
Rel(compliance_export_component, storage_abstraction_layer, "Internal Go interface calls")

@enduml