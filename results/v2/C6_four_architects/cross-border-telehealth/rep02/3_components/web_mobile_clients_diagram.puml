@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web & Mobile Clients container

System_Ext(WebRTC_Media_Broker, "WebRTC Media Broker", "Node.js / Mediasoup", "Handles peer-to-peer and SFU video consultations.")
System_Ext(API_Gateway_Routing, "API Gateway & Routing", "Kong / GCP API Gateway", "Routes authenticated traffic.")

Container_Boundary(web_mobile_clients, "Web & Mobile Clients") {
    Component(Patient_Portal_App, "Patient Portal App", "React, React Native, TypeScript", "Provides patient-facing telehealth features, video consultations, and AI symptom checking.")
    Component(Clinician_Workspace_App, "Clinician Workspace App", "React, React Native, TypeScript", "Provides clinician-facing tools for consultations, e-prescriptions, and FHIR records.")
    Component(WebRTC_Media_Client_Module, "WebRTC Media Client Module", "WebRTC, TypeScript", "Handles peer-to-peer and SFU video consultations.")
    Component(Local_State_Storage_Manager, "Local State & Storage Manager", "IndexedDB, SQLite, TypeScript", "Provides local offline caching to handle unstable rural connections.")
    Component(AI_Symptom_Checker_UI_Module, "AI Symptom Checker UI Module", "React, TypeScript", "Interface for patients to interact with the AI symptom checker.")
    Component(EPrescription_FHIR_Viewer, "E-Prescription & FHIR Viewer", "React, TypeScript", "Displays medical records and e-prescriptions.")
    Component(Consent_Privacy_Manager, "Consent & Privacy Manager", "TypeScript", "Manages privacy consents and regulatory compliance payloads.")
    Component(Telemetry_Audit_Logger, "Telemetry & Audit Logger", "TypeScript", "Captures audit logs and telemetry data.")
    Component(Adaptive_Bitrate_Controller, "Adaptive Bitrate Controller", "TypeScript", "Manages video streaming quality based on network conditions.")
    Component(Regional_Endpoint_Router, "Regional Endpoint Router", "TypeScript", "Pins geographic context and routes regional requests.")
    Component(Secure_Token_Session_Manager, "Secure Token & Session Manager", "OAuth 2.0, OIDC, TypeScript", "Secures session management and token refreshes.")
}

Rel(WebRTC_Media_Client_Module, WebRTC_Media_Broker, "Streams video", "UDP/DTLS via ICE/STUN/TURN")
Rel(Regional_Endpoint_Router, API_Gateway_Routing, "Transmits regional requests", "TLS 1.3 over HTTPS")
Rel(Consent_Privacy_Manager, API_Gateway_Routing, "Transmits consent payloads", "TLS 1.3 over HTTPS")
Rel(Telemetry_Audit_Logger, API_Gateway_Routing, "Transmits audit payloads", "TLS 1.3 over HTTPS")

@enduml