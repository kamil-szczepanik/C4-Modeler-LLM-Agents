@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Telehealth Service container

Container_Boundary(core_telehealth_service, "Core Telehealth Service") {
    Component(Consultation_Session_Manager, "Consultation Session Manager", "Java / Spring Boot", "Initiates room allocation and manages video sessions.")
    Component(Prescription_Orchestrator, "Prescription Orchestrator", "Java / Spring Boot", "Dispatches regional e-prescription payloads and publishes asynchronous e-prescription events.")
    Component(Data_Residency_Guard, "Data Residency Guard", "Java / Spring Boot", "Enforces region-locked connection strings (europe-west3 / us-central1).")
    Component(Symptom_Checker_Gateway, "Symptom Checker Gateway", "Java / Spring Boot", "Submits symptom payloads with metadata tracking.")
    Component(Consent_Enforcement_Interceptor, "Consent Enforcement Interceptor", "Java / Spring Boot", "Enforces consent rules using Spring Security aspects.")
    Component(Degraded_Mode_Adaptor, "Degraded Mode Adaptor", "Java / Spring Boot", "Ensures high availability in rural and low-bandwidth connections.")
    Component(Regional_Routing_Router, "Regional Routing Router", "Java / Spring Boot", "Routes ingress traffic with region context headers.")
    Component(Audit_Event_Dispatcher, "Audit Event Dispatcher", "Java / Spring Boot", "Publishes cryptographically signed audit payloads.")
}

System_Ext(WebRTC_Media_Broker, "WebRTC Media Broker", "Node.js / Mediasoup")
System_Ext(FHIR_E_Prescription_Integration_Service, "FHIR & E-Prescription Integration Service", "Python / Java")
System_Ext(Messaging_Cloud_Pub_Sub, "Messaging (Cloud Pub/Sub)", "Google Cloud Pub/Sub")
System_Ext(AI_Symptom_Checker_Service, "AI Symptom Checker Service", "Python / FastAPI")
System_Ext(Cloud_SQL_PostgreSQL, "Cloud SQL PostgreSQL", "PostgreSQL")

Rel(Consultation_Session_Manager, WebRTC_Media_Broker, "Initiates room allocation and manages video sessions", "gRPC, WebSockets/UDP")
Rel(Prescription_Orchestrator, FHIR_E_Prescription_Integration_Service, "Dispatches regional e-prescription payloads", "gRPC")
Rel(Prescription_Orchestrator, Messaging_Cloud_Pub_Sub, "Publishes asynchronous e-prescription events", "Protobuf over gRPC")
Rel(Symptom_Checker_Gateway, AI_Symptom_Checker_Service, "Submits symptom payloads with metadata tracking", "gRPC")
Rel(Audit_Event_Dispatcher, Messaging_Cloud_Pub_Sub, "Publishes cryptographically signed audit payloads", "gRPC / Protobuf")
Rel(Data_Residency_Guard, Cloud_SQL_PostgreSQL, "Enforces region-locked connection strings (europe-west3 / us-central1)", "JDBC/TLS")

@enduml