@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(fhirdatasvc, "FHIR & E-Prescription Integration Service") {
    Component(FHIR_Transformer, "FHIR Transformer", "Python / Java (HAPI FHIR)", "Transforms internal data models into US Core profiles and national eHDSI/OpenNCP standards.")
    Component(EPrescription_Router, "E-Prescription Router", "Python / Java", "Routes e-prescriptions to National E-Prescription Gateways in the EU and US Pharmacy Networks.")
}

Rel(FHIR_Transformer, EPrescription_Router, "Passes standardized FHIR payloads", "Internal")

@enduml