@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Component(Consent_Audit_Logging_Service, "Consent & Audit Logging Service", "Go", "External service interacting with databases")

Container_Boundary(Databases, "Databases") {
    Component(Cloud_SQL_PostgreSQL, "Cloud SQL PostgreSQL", "Google Cloud SQL / PostgreSQL with Row-Level Security", "Regional transactional databases managing patient data and consent enforcement.")
    Component(Cloud_Storage, "Cloud Storage", "Google Cloud Storage WORM Buckets", "Regional storage with CMEK for immutable AI traceability logging.")
    Component(Regional_Memorystore_for_Redis, "Regional Memorystore for Redis", "Google Cloud Memorystore", "Provides fast patient-to-region mapping caches.")
}

Rel(Consent_Audit_Logging_Service, Cloud_SQL_PostgreSQL, "Stores audit logs and consent records encrypted via CMEK", "HTTPS / Internal")
Rel(Consent_Audit_Logging_Service, Cloud_Storage, "Stores immutable audit and traceability logs encrypted via CMEK", "HTTPS / Internal")

@enduml