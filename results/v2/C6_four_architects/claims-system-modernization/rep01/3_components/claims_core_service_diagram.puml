@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(claims_core_service, "Claims Core Service") {
    Component(Feature_Routing_Dispatcher, "Feature Routing Dispatcher", ".NET class library", "Routes claims workflows to modern handlers or legacy fallback based on dynamic feature flags.")
    Component(Claim_Command_Processor, "Claim Command Processor", ".NET class library using MediatR", "Processes claim commands and executes business workflows.")
    Component(Claim_Query_Handler, "Claim Query Handler", ".NET class library", "Handles read workloads for optimized claim data.")
    Component(Domain_Model_Aggregate_Roots, "Domain Model / Aggregate Roots", ".NET class library", "Encapsulates core business rules and aggregate roots.")
    Component(Anti_Corruption_Layer_ACL, "Anti-Corruption Layer (ACL)", ".NET class library", "Translates modern domain models to legacy structures.")
    Component(Mainframe_Adapter_Component, "Mainframe Adapter Component", ".NET class library", "Delegates legacy fallback workflows to the mainframe system.")
    Component(Idempotency_Validator, "Idempotency Validator", "StackExchange.Redis", "Checks duplicate processing using distributed caching.")
    Component(Integration_Event_Publisher, "Integration Event Publisher", "Azure.Messaging.ServiceBus", "Emits state change events to the event broker.")
    Component(Claims_Database, "Claims Database", "Azure SQL / Database", "Stores optimized claim data.")
}

Rel(Feature_Routing_Dispatcher, Claim_Command_Processor, "Delegates modern claim workflows", "Internal C# Method Call")
Rel(Feature_Routing_Dispatcher, Mainframe_Adapter_Component, "Delegates legacy fallback workflows", "Internal C# Method Call")
Rel(Claim_Command_Processor, Idempotency_Validator, "Checks duplicate processing", "Redis Protocol over TLS")
Rel(Claim_Command_Processor, Domain_Model_Aggregate_Roots, "Executes business rules", "Internal C# Method Call")
Rel(Domain_Model_Aggregate_Roots, Anti_Corruption_Layer_ACL, "Translates domain models to legacy structures", "Internal C# Method Call")
Rel(Domain_Model_Aggregate_Roots, Integration_Event_Publisher, "Emits state change events", "AMQP over TLS (TCP 5671)")
Rel(Claim_Query_Handler, Claims_Database, "Reads optimized claim data", "TDS over TLS (TCP 1433)")

@enduml