@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Configuration & Feature Store container

Container_Boundary("Configuration_Feature_Store", "Configuration & Feature Store") {
    Component(Feature_Flag_Evaluator, "Feature Flag Evaluator", "Azure App Configuration SDK", "Evaluates dynamic feature toggles and rollout rules for the Claims Core Service and BFF.")
    Component(Secret_Manager_Client, "Secret Manager Client", "Azure Key Vault References", "Retrieves secure secrets and connection strings referenced by the configuration store.")
}

Rel(Feature_Flag_Evaluator, Secret_Manager_Client, "Resolves secure references", "HTTPS")

@enduml