@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Database container

Component(Claims_Core_Service, "Claims Core Service", "TDS over TLS (TCP 1433)", "External service executing domain queries against core claim tables and audit history.")
Component(Integration_Sync_Worker, "Integration & Sync Worker", "TDS over TLS (TCP 1433)", "External worker managing reconciliation data, polling delta changes, and reading unified snapshots.")

Container_Boundary(Claims_Database, "Claims Database") {
    Component(Claim_Tables, "Claim Tables", "Azure SQL Database Managed Instance, T-SQL", "Core relational Azure SQL storage enforcing strict ACID guarantees for migrated claim types.")
    Component(Sync_Staging_Tables, "Sync Staging Tables", "Azure SQL Database Managed Instance, T-SQL", "Azure SQL staging area for asynchronous replication payloads managed by the integration worker.")
    Component(Audit_Temporal_History, "Audit & Temporal History", "Azure SQL Database Managed Instance, System-Versioned Temporal Tables, T-SQL", "Azure SQL System-Versioned Temporal Tables tracking historical row versions for compliance and rollback.")
    Component(Change_Tracking_Mechanism, "Change Tracking Mechanism", "Azure SQL Database Managed Instance, Change Tracking", "Azure SQL Change Tracking feature capturing row-level changes asynchronously without table locks.")
    Component(Reconciliation_Rollback_Views, "Reconciliation & Rollback Views", "Azure SQL Database Managed Instance, T-SQL Views", "Azure SQL Views encapsulating complex JOINs to expose unified payload views for verification and rollback.")
}

Rel(Claims_Core_Service, Claim_Tables, "Executes domain queries", "TDS over TLS (TCP 1433)")
Rel(Claims_Core_Service, Audit_Temporal_History, "Executes domain queries", "TDS over TLS (TCP 1433)")
Rel(Integration_Sync_Worker, Sync_Staging_Tables, "Stages reconciliation data", "TDS over TLS (TCP 1433)")
Rel(Integration_Sync_Worker, Change_Tracking_Mechanism, "Polls delta changes", "TDS over TLS (TCP 1433)")
Rel(Integration_Sync_Worker, Reconciliation_Rollback_Views, "Reads unified snapshots", "TDS over TLS (TCP 1433)")

@enduml