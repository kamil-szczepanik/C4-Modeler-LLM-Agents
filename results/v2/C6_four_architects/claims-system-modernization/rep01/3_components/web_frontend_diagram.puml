@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(web_frontend, "Web Frontend") {
    Component(Customer_Portal_UI, "Customer Portal UI", "React / TypeScript", "Provides the user interface for customers to interact with the claims system.")
    Component(Broker_Portal_UI, "Broker Portal UI", "React / TypeScript", "Provides the user interface for brokers managing claims on behalf of clients.")
    Component(Claims_Adjuster_Dashboard, "Claims Adjuster Dashboard", "React / TypeScript", "Provides the user interface for claims adjusters to process and review claims.")
}

System_Ext(API_Gateway_BFF, "API Gateway / BFF", "Node.js / Express backend-for-frontend")

Rel(Customer_Portal_UI, API_Gateway_BFF, "Sends API requests and WebSocket messages", "HTTPS/REST, WSS (JSON)")
Rel(Broker_Portal_UI, API_Gateway_BFF, "Sends API requests and WebSocket messages", "HTTPS/REST, WSS (JSON)")
Rel(Claims_Adjuster_Dashboard, API_Gateway_BFF, "Sends API requests and WebSocket messages", "HTTPS/REST, WSS (JSON)")

@enduml