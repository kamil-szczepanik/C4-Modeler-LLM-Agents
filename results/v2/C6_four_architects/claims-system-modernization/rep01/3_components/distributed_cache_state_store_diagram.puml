@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Distributed Cache / State Store container

Person_Ext(claims_core, "Claims Core Service", ".NET 8 / C#")
Person_Ext(integration_worker, "Integration & Sync Worker", "Python / C# Azure Function")

Container_Boundary(distributed_cache, "Distributed Cache / State Store") {
    Component(idempotency, "Idempotency State Manager", "Redis SETNX / TTL", "Manages idempotency states to prevent event replay.")
    Component(session_provider, "Distributed Session Provider", "Redis Sessions", "Provides distributed session management.")
    Component(migration_cache, "Migration Routing & Fallback Cache", "Redis Hashes", "Evaluates migration status and supports rapid fallbacks.")
    Component(lock_manager, "Distributed Lock Manager", "Redlock pattern", "Acquires synchronization locks for distributed operations.")
    Component(eviction_engine, "Eviction & Expiration Policy Engine", "volatile-lru", "Handles eviction and expiration policies for cached data.")
}

Rel(claims_core, session_provider, "Manages session cache", "Redis RESP / TCP over TLS")
Rel(claims_core, idempotency, "Manages idempotency", "Redis RESP / TCP over TLS")
Rel(integration_worker, idempotency, "Prevents event replay", "Redis RESP / TCP over TLS")
Rel(claims_core, migration_cache, "Evaluates migration status", "Redis RESP / TCP over TLS")
Rel(integration_worker, lock_manager, "Acquires synchronization locks", "Redis RESP / TCP over TLS")

@enduml