@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(customer_portal, "Customer Portal") {
    Component(CustomerSPA, "Customer SPA", "React, TypeScript, Vite", "Renders the user interface and handles client-side routing and state for customers and brokers.")
    Component(StateAndQueryManager, "State and Query Manager", "TanStack Query, Zustand", "Manages lightweight client-side state and caches API responses.")
}

Rel(CustomerSPA, StateAndQueryManager, "Reads and writes application state and caches data", "")

@enduml