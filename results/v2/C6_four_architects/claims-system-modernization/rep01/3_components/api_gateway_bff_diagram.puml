@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway / BFF container

Container_Boundary(api_gateway_bff, "API Gateway / BFF") {
    Component(customer_bff, "Customer BFF", "Node.js / Express", "Lightweight, decoupled BFF tailored to customer workflows, communicating with core claims via gRPC.")
    Component(adjuster_bff, "Adjuster BFF", "Node.js / Express with WebSocket Gateway Module", "BFF tailored to adjuster workflows featuring a WebSocket Gateway Module for real-time push updates.")
}

System_Ext(claims_core, "Claims Core Service", ".NET 8 / C# core business logic service")
System_Ext(redis, "Azure Cache for Redis", "In-memory data store for caching and session state")
System_Ext(service_bus, "Azure Service Bus", "Cloud message broker for integration events")

Rel(customer_bff, claims_core, "Invokes core business logic via gRPC", "gRPC")
Rel(adjuster_bff, claims_core, "Invokes core business logic via gRPC", "gRPC")
Rel(adjuster_bff, redis, "Reads and writes session/cache data via TCP/RESP", "TCP/RESP")
Rel(service_bus, adjuster_bff, "Pushes real-time integration events via AMQP / Azure SDK", "AMQP / Azure SDK")

@enduml