@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration & Sync Worker container

Container_Boundary("Integration & Sync Worker", "Integration & Sync Worker") {
    Component(EventConsumer, "Event Consumer", "C# Azure Function", "Consumes messages and events from the integration event broker to trigger synchronization workflows.")
    Component(SyncOrchestrator, "Sync Orchestrator", "C# Azure Durable Functions", "Orchestrates long-running integration and synchronization workflows between the modern platform and mainframe.")
    Component(TransformationMappingEngine, "Transformation & Mapping Engine", "C# / .NET 8", "Maps and transforms data models between modern JSON/relational structures and legacy COBOL/DB2 formats.")
    Component(MainframeAdapter, "Mainframe Adapter", "C# / Secure SFTP / MQ", "Handles secure communication, data exchange, and interaction with the legacy mainframe system.")
    Component(ResiliencyRetryPolicy, "Resiliency & Retry Policy", "Polly (.NET library)", "Provides fault tolerance, retries, and circuit breaker patterns for integration calls.")
    Component(ReconciliationAuditLogger, "Reconciliation & Audit Logger", "Entity Framework Core / C#", "Logs sync activities and performs data reconciliation to ensure zero data loss.")
    Component(ConfigurationFeatureFlag, "Configuration & Feature Flag", "Azure App Configuration / C#", "Manages dynamic feature toggles and runtime configurations for the worker.")
}

Rel(EventConsumer, SyncOrchestrator, "Triggers workflow", "")
Rel(SyncOrchestrator, TransformationMappingEngine, "Transforms payloads", "")
Rel(TransformationMappingEngine, MainframeAdapter, "Sends/receives mapped data", "")
Rel(MainframeAdapter, ResiliencyRetryPolicy, "Applies retry and fault tolerance policies", "")
Rel(SyncOrchestrator, ReconciliationAuditLogger, "Logs execution and state", "")
Rel(SyncOrchestrator, ConfigurationFeatureFlag, "Reads configuration", "")

@enduml