@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(Customer_Broker, "Customer & Broker", "External users who submit and manage insurance claims through web and mobile interfaces.")
Person(Adjusters, "Adjusters", "Internal insurance adjusters who handle claim workflows.")

System_Ext(Legacy_Mainframe, "Legacy Mainframe", "COBOL/DB2 system acting as the core system of record.")
System_Ext(Active_Directory_Entra_ID_Connect, "Active Directory / Entra ID Connect", "Provides identity management and authentication services.")

System_Boundary(Modern_Claims_Platform, "Modern Claims Platform") {
    Container(Customer_Broker_Portal, "Customer & Broker Portal", "Web and Mobile", "Web and mobile portal allowing customers and brokers to interact with the claims system.")
    Container(Claims_Web_App, "Claims Web App", "Web Application", "Web application serving the modern claims platform interfaces.")
    Container(API_Management, "API Management", "Azure API Management", "Secures ingress, manages traffic, and handles API policies for the cloud platform.")
    Container(Claim_Routing_Service, "Claim Routing Service", "Microservice", "Dynamically routes claim types between the modern platform and the legacy system.")
    Container(Claims_Processing_Service, "Claims Processing Service", "Microservice", "Processes online claims and adjuster workflows.")
    ContainerDb(Azure_SQL_Database, "Azure SQL Database", "Azure SQL", "Cloud data persistence layer with rollback capability for migrated claim types.")
    Container(Azure_Service_Bus, "Azure Service Bus", "Azure Service Bus", "Enables asynchronous, decoupled hybrid messaging.")
    Container(On_Premises_Integration_Service, "On-Premises Integration Service", "Integration Service", "Bridges cloud messaging with the on-premises legacy environment.")
}

Rel(Customer_Broker, Customer_Broker_Portal, "Interacts with portal to submit and track claims", "HTTPS")
Rel(Customer_Broker_Portal, API_Management, "Sends API requests to the modern claims platform", "HTTPS/REST")
Rel(Adjusters, Claims_Web_App, "Manages claim workflows", "HTTPS/WebSockets")
Rel(Claims_Web_App, API_Management, "Routes workflow actions", "HTTPS/REST")
Rel(API_Management, Claims_Processing_Service, "Forwards requests", "HTTPS")
Rel(API_Management, Claim_Routing_Service, "Forwards claim routing requests", "HTTPS")
Rel(Modern_Claims_Platform, Active_Directory_Entra_ID_Connect, "Authenticates users", "HTTPS (OIDC/SAML)")
Rel(Claim_Routing_Service, Azure_SQL_Database, "Reads and writes claim data", "TDS via Entity Framework Core")
Rel(Modern_Claims_Platform, Azure_Service_Bus, "Publishes asynchronous messages", "AMQP")
Rel(Azure_Service_Bus, On_Premises_Integration_Service, "Transmits messages across hybrid boundary", "AMQP")
Rel(On_Premises_Integration_Service, Legacy_Mainframe, "Integrates with legacy backend", "IBM MQ protocol")

@enduml