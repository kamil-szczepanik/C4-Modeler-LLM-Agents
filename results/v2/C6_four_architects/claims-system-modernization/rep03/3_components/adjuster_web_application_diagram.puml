@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(adjuster_web_application, "Adjuster Web Application") {
    Component(Authentication_Module, "Authentication Module", "MSAL.js", "Handles Active Directory Single Sign-On integration for secure access.")
    Component(Routing_Layout_Component, "Routing & Layout Component", "React Router", "Manages modular single-page application navigation and renders dashboard and workspace.")
    Component(Claims_Dashboard_Component, "Claims Dashboard Component", "React / TypeScript", "Displays the main claims overview interface for adjusters.")
    Component(Claim_Details_Workspace_Component, "Claim Details Workspace Component", "React / TypeScript", "Provides detailed workspace views for individual claims.")
    Component(Client_Side_Cache_Component, "Client-Side Cache Component", "TanStack Query", "Provides client-side caching to meet sub-2-second performance goals despite slow mainframe responses.")
    Component(BFF_Client_SDK_API_Service_Layer, "BFF Client SDK / API Service Layer", "TypeScript / REST", "Encapsulates API communication with the backend services.")
}

System_Ext(api_gateway_bff, "API Gateway / BFF", "Azure API Management and Node.js")
System_Ext(observability_audit_container, "Observability & Audit Container", "Observability platform")

Rel(Routing_Layout_Component, Claims_Dashboard_Component, "Renders", "In-Memory")
Rel(Routing_Layout_Component, Claim_Details_Workspace_Component, "Renders", "In-Memory")
Rel(Claim_Details_Workspace_Component, Client_Side_Cache_Component, "Queries", "In-Memory")
Rel(BFF_Client_SDK_API_Service_Layer, Client_Side_Cache_Component, "Uses", "In-Memory")
Rel(adjuster_web_application, api_gateway_bff, "Sends requests", "HTTPS")
Rel(adjuster_web_application, observability_audit_container, "Sends telemetry", "OpenTelemetry/HTTPS")

@enduml