@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Customer_Broker, "Customer / Broker", "External user interacting with the insurance platform.")
System_Ext(External_Active_Directory, "External Active Directory", "Azure AD", "External identity provider for enterprise security compliance.")
System_Ext(API_Gateway_BFF, "API Gateway / BFF", "Azure API Management and Node.js", "Gateway isolating the legacy mainframe and handling requests.")

Container_Boundary(web_portal, "Web Portal") {
    Component(Web_Portal_Container, "Web Portal Container", "React / TypeScript on Azure Static Web Apps", "Modernized cloud-based web portal providing a secure, performant, and localized interface for customers and brokers.")
    Component(Authentication_Context, "Authentication Context / SSO Module", "MSAL.js", "Handles single sign-on and authentication via OIDC.")
    Component(Claim_Submission_Wizard, "Claim Submission Wizard", "React Hook Form and Zod", "Allows users to submit claims with form validation.")
    Component(Claim_Tracking_Dashboard, "Claim Tracking Dashboard", "React", "Provides an interface for tracking claim statuses.")
    Component(Local_State_Cache_Manager, "Local State & Cache Manager", "TanStack Query / React Query", "Manages server state and caches data locally for sub-second UI responsiveness.")
    Component(BFF_API_Client_Layer, "BFF API Client Layer", "Axios/Fetch", "Handles communication with the BFF API.")
    Component(Localization_Provider, "Localization Provider", "i18next", "Provides multi-language support for regional compliance.")
    Component(Security_Headers_CSP_Enforcer, "Security Headers & CSP Enforcer", "staticwebapp.config.json", "Applies security headers and content security policies.")
}

Rel(Customer_Broker, Web_Portal_Container, "Interacts with unified web interface", "HTTPS")
Rel(Authentication_Context, External_Active_Directory, "Authenticates via OIDC", "HTTPS via Azure AD")
Rel(Claim_Submission_Wizard, Local_State_Cache_Manager, "Manages server state", "TypeScript Module Call")
Rel(Claim_Tracking_Dashboard, Local_State_Cache_Manager, "Manages server state", "TypeScript Module Call")
Rel(Local_State_Cache_Manager, BFF_API_Client_Layer, "Fetches data", "TypeScript Module Call")
Rel(Web_Portal_Container, API_Gateway_BFF, "Sends requests to BFF", "HTTPS")
Rel(Web_Portal_Container, Security_Headers_CSP_Enforcer, "Applies security headers", "HTTP Security Headers / CSP")

@enduml