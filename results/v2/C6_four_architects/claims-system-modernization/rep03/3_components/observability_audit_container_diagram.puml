@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Observability & Audit Container", "Observability & Audit Container") {
    Component("Telemetry Collector", "Telemetry Collector", "Azure Monitor / Application Insights", "Collects telemetry data from all platform containers using OpenTelemetry.")
    Component("Audit Log Processor", "Audit Log Processor", "Azure Application Insights / Azure Functions", "Processes and persists tamper-evident audit logs.")
    Component("Alerting & Dashboard Engine", "Alerting & Dashboard Engine", "Azure Monitor / Azure Dashboards", "Provides alerts and monitoring dashboards for system health and performance.")
    Component("Migration Trace Correlator", "Migration Trace Correlator", "Azure Application Insights", "Correlates traces during the hybrid migration phase between legacy and cloud components.")
    Component("Security & Access Auditor", "Security & Access Auditor", "Azure Monitor / Azure Security Center", "Audits security events and access logs across the platform.")
}

Rel("Audit Log Processor", "Notification & Document Store", "Persists tamper-evident logs", "Azure SDK / WORM Blob Storage")
@enduml