@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Claims_Management_App", "Claims Management App") {
    Component(ClaimProcessingController, "Claim Processing Controller", ".NET 8 Web API", "Handles incoming API requests for claim processing.")
    Component(ClaimDomainModel, "Claim Domain Model", ".NET 8 / EF Core", "Encapsulates the core claim business logic and data manipulation.")
    Component(OutboxTransactionProcessor, "Outbox Transaction Processor", ".NET 8 Background Service", "Processes outbox messages in the background for reliable event publishing.")
    Component(MainframeAdapter, "Mainframe Adapter", ".NET 8 / Polly", "Communicates with external mainframe systems with built-in resilience via Polly.")
    Component(FeatureRoutingSwitcher, "Feature & Routing Switcher", ".NET 8 In-Memory Service", "Manages feature flags and claim type routing in-memory.")
    Component(AuthorizationContextEnforcer, "Authorization & Context Enforcer", "ASP.NET Core Middleware", "Enforces security context and request authorization.")
    Component(EventDispatcher, "Event Dispatcher", "Azure Service Bus Client", "Publishes domain events to Azure Service Bus.")
}

Rel(ClaimProcessingController, ClaimDomainModel, "Direct in-memory C# method calls", "Synchronous")
Rel(ClaimDomainModel, ClaimsDatabase, "Entity Framework Core", "TDS")
Rel(OutboxTransactionProcessor, EventDispatcher, "Background polling and publishing", "AMQP / Azure Service Bus")
Rel(MainframeAdapter, ClaimRoutingService, "Low-latency routing and fallback", "gRPC")
Rel(AuthorizationContextEnforcer, ClaimProcessingController, "Request interception", "HTTP / JWT")

@enduml