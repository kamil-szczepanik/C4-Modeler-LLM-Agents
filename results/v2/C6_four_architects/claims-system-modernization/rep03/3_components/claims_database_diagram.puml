@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(claims_database, "Claims Database") {
    Component(Claims_Core_Schema, "Claims Core Schema", "Azure SQL Database", "Stores core insurance claims data securely with Transparent Data Encryption.")
    Component(Migration_Sync_Staging_Schema, "Migration & Sync Staging Schema", "Azure SQL Database Staging Tables", "Handles data staging and synchronization between the hybrid mainframe and modern architecture.")
    Component(Audit_History_Table_Store, "Audit & History Table Store", "Azure SQL System-Versioned Temporal Tables", "Maintains complete historical records and audit trails for compliance and zero data loss.")
    Component(Data_Access_Security_Abstraction_Layer, "Data Access Security & Abstraction Layer", "Entity Framework Core / TDS", "Provides secure data access abstraction and enforces row-level security and access controls.")
    Component(Change_Data_Capture_CDC_Index_Management_Engine, "Change Data Capture (CDC) & Index Management Engine", "Azure SQL CDC", "Tracks and streams database changes to synchronize state and read change streams.")
    Component(Database_Migration_Versioning_Controller, "Database Migration & Versioning Controller", "Azure SQL Versioning Controller", "Manages database schema migrations and supports rapid rollbacks for migrated claim types.")
}

Rel(Claims_Core_Schema, Audit_History_Table_Store, "Automatically populates historical states")
Rel(Data_Access_Security_Abstraction_Layer, Claims_Core_Schema, "Reads and writes claim records")
Rel(Change_Data_Capture_CDC_Index_Management_Engine, Migration_Sync_Staging_Schema, "Captures and publishes change streams")

@enduml