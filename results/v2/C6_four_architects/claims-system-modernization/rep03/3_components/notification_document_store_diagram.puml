@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification & Document Store container

System_Ext(ClaimsManagementApp, "Claims Management App", "Claims Management App Technology", "External application interacting with the container.")
System_Ext(AzureServiceBus, "Azure Service Bus", "Azure Service Bus", "Messaging for decoupled hybrid integration.")
System_Ext(ExternalNotificationService, "External Notification Service", "External Service", "External service used to send alerts.")

Container_Boundary(NotificationAndDocumentStore, "Notification & Document Store") {
    Component(DocumentStorageComponent, "Document Storage Component", "Azure Blob Storage with Hot/Cool tiers", "Managed binary storage for claim attachments to reduce operational overhead.")
    Component(MetadataCatalogComponent, "Metadata Catalog Component", "Azure Cosmos DB with SQL API", "Flexible NoSQL schema for document metadata and notification history.")
    Component(DocumentIngestionProxyComponent, "Document Ingestion Proxy Component", "Azure Functions", "Serverless execution for proxying document uploads without cluster management.")
    Component(DocumentEventPublisherComponent, "Document Event Publisher Component", "Azure Event Grid", "Asynchronous event routing for decoupled hybrid integration.")
    Component(NotificationTemplateEngineComponent, "Notification Template Engine Component", "Azure Functions / Handlebars.js", "Serverless rendering of notification templates.")
    Component(NotificationDispatcherComponent, "Notification Dispatcher Component", "Azure Functions", "Serverless execution for dispatching notifications.")
}

Rel(ClaimsManagementApp, DocumentIngestionProxyComponent, "Uploads documents", "HTTPS/REST")
Rel(ClaimsManagementApp, MetadataCatalogComponent, "Queries indexes and saves notification logs", "HTTPS/Cosmos SDK")
Rel(DocumentIngestionProxyComponent, DocumentStorageComponent, "Stores binary attachments", "HTTPS/Blob SDK")
Rel(DocumentStorageComponent, DocumentEventPublisherComponent, "Emits object events", "Event Grid Webhook")
Rel(DocumentEventPublisherComponent, AzureServiceBus, "Publishes document lifecycle events", "AMQP")
Rel(NotificationDispatcherComponent, NotificationTemplateEngineComponent, "Renders templates", "In-memory function call")
Rel(NotificationDispatcherComponent, ExternalNotificationService, "Sends alerts", "HTTPS/REST")

@enduml