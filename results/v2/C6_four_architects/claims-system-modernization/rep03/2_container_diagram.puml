@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Insurance Claims Modernization Platform

Person(Customer, "Customer", "Customer interacting with the modern web interfaces for insurance claims.")
Person(Broker, "Broker", "Broker assisting clients and managing claims through the platform.")
Person("Claims Adjuster", "Claims Adjuster", "Claims Adjuster reviewing, processing, and managing insurance claims.")

System_Ext("Active Directory", "Active Directory", "Identity Provider used for authentication.")
System_Ext("Core Rating & Underwriting Engine", "Core Rating & Underwriting Engine", "External service for rating and underwriting policies and claims.")
System_Ext("Payment Gateway", "Payment Gateway", "External service handling financial transactions and claim payouts.")
System_Ext("Notification Service", "Notification Service", "External service for sending alerts and notifications.")
System_Ext("Legacy Mainframe", "Legacy Mainframe", "On-premises 30-year-old COBOL/DB2 system of record.")

System_Boundary(system_boundary, "Insurance Claims Modernization Platform") {
    Container("Web Portal", "Web Portal", "React / TypeScript on Azure Static Web Apps", "Unified web interface for customers and brokers.")
    Container("Adjuster Web Application", "Adjuster Web Application", "React / TypeScript on Azure Static Web Apps", "Web application for internal claims adjusters.")
    Container("API Gateway / BFF", "API Gateway / BFF", "Azure API Management and Node.js", "API routing, SSO, and Backend-for-Frontend layer.")
    Container_Boundary("Claims Management App", "Claims Management App") {
        Component("API / Controller Layer", "API / Controller Layer", "ASP.NET Core Controllers", "Handles incoming API requests for the Claims Management App.")
        Component("Domain / Business Logic Layer", "Domain / Business Logic Layer", "C# Class Library", "Encapsulates the core claims processing business rules.")
        Component("Data Access Layer", "Data Access Layer", "Entity Framework Core / TDS", "Manages database interactions for the Claims Management App.")
        Component("Mainframe Anti-Corruption Layer (ACL)", "Mainframe Anti-Corruption Layer (ACL)", "C# Integration Service", "Isolates and translates communications with the legacy mainframe.")
    }
    Container("Claim Routing Service", "Claim Routing Service", "Azure Container Apps", "Dedicated routing service ensuring rapid rollbacks and zero data loss.")
    Container("Integration & Sync Service", "Integration & Sync Service", "Azure Container Apps / Azure Service Bus", "Service managing synchronization with external and legacy systems.")
    ContainerDb("Claims Database", "Claims Database", "Azure SQL Database", "Primary database for storing claims data.")
    Container("Notification & Document Store", "Notification & Document Store", "Azure Blob Storage / Azure Cosmos DB", "Storage for notifications and documents.")
    Container("Mainframe Data Ingestion Worker", "Mainframe Data Ingestion Worker", "Azure Functions / Azure Data Factory", "Worker processing data ingestion from the legacy mainframe.")
    Container("Observability & Audit Container", "Observability & Audit Container", "Azure Application Insights and Azure Monitor", "Centralized monitoring and audit logging container.")
}

Rel(Customer, "Web Portal", "Interacts with unified web interface", "HTTPS")
Rel(Broker, "Web Portal", "Interacts with unified web interface", "HTTPS")
Rel("Claims Adjuster", "Adjuster Web Application", "Interacts with adjuster application", "HTTPS")
Rel("Web Portal", "API Gateway / BFF", "Sends requests to BFF", "HTTPS")
Rel("Adjuster Web Application", "API Gateway / BFF", "Sends requests to BFF", "HTTPS")
Rel("API Gateway / BFF", "Claims Management App", "Routes API calls", "gRPC/HTTP")
Rel("Claims Management App", "Claim Routing Service", "Routes claim traffic and manages rollbacks", "gRPC/REST")
Rel("Claims Management App", "Integration & Sync Service", "Sends asynchronous messages", "AMQP/Azure Service Bus")
Rel("Claims Management App", "Claims Database", "Reads and writes claim data", "Entity Framework Core / TDS")
Rel("Claims Management App", "Notification & Document Store", "Stores and retrieves documents", "HTTPS/Blob SDK")
Rel("Integration & Sync Service", "Mainframe Data Ingestion Worker", "Triggers data ingestion", "Azure Service Bus")
Rel("Integration & Sync Service", "Legacy Mainframe", "Synchronizes data with mainframe", "secure FTP/MQ")
Rel("Web Portal", "Observability & Audit Container", "Sends telemetry", "OpenTelemetry/HTTPS")
Rel("Adjuster Web Application", "Observability & Audit Container", "Sends telemetry", "OpenTelemetry/HTTPS")
Rel("API Gateway / BFF", "Observability & Audit Container", "Sends telemetry", "OpenTelemetry/HTTPS")
Rel("Claims Management App", "Observability & Audit Container", "Sends telemetry", "OpenTelemetry/HTTPS")
Rel("Claim Routing Service", "Observability & Audit Container", "Sends telemetry", "OpenTelemetry/HTTPS")
Rel("Integration & Sync Service", "Observability & Audit Container", "Sends telemetry", "OpenTelemetry/HTTPS")
Rel("Claims Database", "Observability & Audit Container", "Sends telemetry", "OpenTelemetry/HTTPS")
Rel("Notification & Document Store", "Observability & Audit Container", "Sends telemetry", "OpenTelemetry/HTTPS")
Rel("Mainframe Data Ingestion Worker", "Observability & Audit Container", "Sends telemetry", "OpenTelemetry/HTTPS")
Rel("API / Controller Layer", "Domain / Business Logic Layer", "Delegates requests", "In-process method call")
Rel("Domain / Business Logic Layer", "Data Access Layer", "Queries data", "In-process method call")
Rel("Domain / Business Logic Layer", "Mainframe Anti-Corruption Layer (ACL)", "Translates legacy models", "In-process method call")

@enduml