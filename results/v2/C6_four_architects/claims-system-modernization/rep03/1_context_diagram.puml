@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Insurance Claims Modernization Platform

Person(Customer, "Customer", "External user interacting with the modern web interfaces for insurance claims.")
Person(Broker, "Broker", "External user assisting clients and managing claims through the platform.")
Person(Claims Adjuster, "Claims Adjuster", "Internal user reviewing, processing, and managing insurance claims.")

System(Insurance Claims Modernization Platform, "Insurance Claims Modernization Platform", "A hybrid cloud platform that gradually replaces a legacy COBOL/DB2 mainframe while maintaining continuous claim processing and delivering modern web interfaces.")

System_Ext(Active Directory, "Active Directory", "Identity Provider used for authentication via SAML/OIDC.")
System_Ext(Core Rating & Underwriting Engine, "Core Rating & Underwriting Engine", "External service for rating and underwriting policies and claims.")
System_Ext(Payment Gateway, "Payment Gateway", "External service handling financial transactions and claim payouts.")
System_Ext(Notification Service, "Notification Service", "External service (SendGrid/Azure Communication Services) for sending alerts and notifications.")
System_Ext(Legacy Mainframe, "Legacy Mainframe", "On-premises COBOL/DB2 system of record.")

Rel(Customer, Insurance Claims Modernization Platform, "Interacts with the modern web interfaces", "HTTPS")
Rel(Broker, Insurance Claims Modernization Platform, "Interacts with the modern web interfaces", "HTTPS")
Rel(Claims Adjuster, Insurance Claims Modernization Platform, "Interacts with the modern web interfaces and Adjuster Web App", "HTTPS")
Rel(Insurance Claims Modernization Platform, Active Directory, "Authenticates users", "SAML/OIDC over HTTPS")
Rel(Insurance Claims Modernization Platform, Core Rating & Underwriting Engine, "Calls rating and underwriting functions", "HTTPS/REST")
Rel(Insurance Claims Modernization Platform, Payment Gateway, "Processes claim payments", "HTTPS/REST")
Rel(Insurance Claims Modernization Platform, Notification Service, "Sends notifications to users", "HTTPS/REST")
Rel(Insurance Claims Modernization Platform, Legacy Mainframe, "Communicates asynchronously via integration layer", "ExpressRoute and legacy protocols via Azure Service Bus")

@enduml