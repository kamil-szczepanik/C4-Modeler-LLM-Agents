@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers & Brokers, "Customers & Brokers", "External users submitting claims.")
Person(Claims Adjusters, "Claims Adjusters", "Internal staff managing claims.")
System_Ext(Active Directory, "Active Directory", "Enterprise identity provider.")
System_Ext(Legacy Mainframe, "Legacy Mainframe", "On-premise COBOL/DB2 system of record.")
System_Ext(API Gateway / Edge, "API Gateway / Edge", "Azure Container Apps / App Gateway handling ingress and TLS termination.")
System_Ext(Claims Web App, "Claims Web App", "React / Azure Static Web Apps user interface.")
System_Ext(Claims Core Service, "Claims Core Service", "Azure Container Apps / .NET backend domain logic.")
System_Ext(Integration & Anti-Corruption Layer, "Integration & Anti-Corruption Layer", "Azure Functions / Service Bus for mainframe decoupling.")
System_Ext(Modern Claims Database, "Modern Claims Database", "Azure SQL Database for migrated claim data.")
System_Ext(Asynchronous Message Broker, "Asynchronous Message Broker", "Azure Service Bus for reliable event processing.")
System_Ext(On-Premise Integration Agent, "On-Premise Integration Agent", "Azure Relay / Hybrid Worker for secure mainframe connectivity.")
System_Ext(Audit & Reconciliation Worker, "Audit & Reconciliation Worker", "Azure Functions / .NET background worker for batch reconciliation.")

System(Insurance Claims Modernization, "Insurance Claims Modernization", "A hybrid cloud solution that gradually replaces a 30-year-old COBOL/DB2 mainframe claims system, enabling online claim submission and modernized adjuster workflows.")

Rel(Customers & Brokers, API Gateway / Edge, "UI access and claim submission", "HTTPS (TLS 1.3)")
Rel(Claims Adjusters, API Gateway / Edge, "UI access and claim management", "HTTPS (TLS 1.3)")
Rel(API Gateway / Edge, Claims Core Service, "Routes requests to backend domain logic", "gRPC / internal HTTPS")
Rel(Claims Core Service, Modern Claims Database, "Reads and writes migrated claim data", "TDS via Entity Framework Core")
Rel(Claims Core Service, Asynchronous Message Broker, "Publishes and consumes events", "AMQP / Azure Service Bus SDK")
Rel(Integration & Anti-Corruption Layer, Legacy Mainframe, "Decouples mainframe interactions and batch transfers", "IBM MQ / z/OS Connect REST / SFTP")
Rel(API Gateway / Edge, Active Directory, "Handles Single Sign-On authentication", "OpenID Connect (OIDC) over HTTPS")

@enduml