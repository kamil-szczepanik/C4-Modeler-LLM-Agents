@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component Diagram for API Gateway / Edge

Container_Boundary(api_gateway, "API Gateway / Edge") {
    Component(jwt_engine, "JWT Validation Policy Engine", "Azure API Management Policy / OIDC / JWT", "Validates security tokens and authenticates requests.")
    Component(router, "Path-Based Routing Router", "Azure API Management Routing", "Forwards validated modern requests and routes hybrid/legacy-bound requests.")
    Component(rate_limiting, "Rate Limiting & Throttling Policy", "Azure API Management Policy", "Applies rate limiting and throttling to incoming requests.")
    Component(caching, "Response Caching Policy Component", "Azure API Management Policy", "Handles response caching.")
    Component(ssl_waf, "SSL/TLS Termination & WAF Component", "Azure Application Gateway / APIM WAF", "Serves as the ingress traffic entry point and handles SSL/TLS termination.")
    Component(telemetry, "Telemetry & Audit Logging Component", "Azure Monitor / APIM Logger", "Handles telemetry and audit logging.")
}

Rel(jwt_engine, router, "Passes validated requests for routing")

@enduml