@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Read-Through Cache container

System_Ext(claims_core, "Claims Core Service", "Java / Spring Boot on Azure App Service", "Powers core business logic and reads/writes to the cache.")
System_Ext(service_bus, "Azure Service Bus", "Azure Service Bus", "Handles asynchronous event-driven claim invalidations to prevent stale data.")

Container_Boundary(read_through_cache, "Read-Through Cache") {
    Component(redis_store, "Redis In-Memory Data Store", "Azure Cache for Redis Standard Tier", "Manages high-performance in-memory caching to ensure screen loads under 2 seconds.")
    Component(eviction_manager, "Eviction Policy Manager", "Native volatile-lru", "Manages data eviction within the cache using native policies.")
    Component(sync_listener, "Cache Synchronization Listener", "Azure Service Bus Listener", "Listens for invalidation events to synchronize cache state.")
}

Rel(claims_core, redis_store, "GET/SET", "Redis RESP / TCP over TLS")
Rel(service_bus, sync_listener, "ClaimInvalidated Event", "AMQP")
Rel(sync_listener, redis_store, "DEL {key}", "Redis RESP / TCP over TLS")

@enduml