@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit & Reconciliation Worker container

Container_Boundary(audit_reconciliation_worker, "Audit & Reconciliation Worker") {
    Component(Reconciliation Job Scheduler, "Reconciliation Job Scheduler", "Quartz / Spring Batch Scheduler", "Triggers Mainframe Data Reader and Modern DB Reader via in-process method calls.")
    Component(Mainframe Data Reader, "Mainframe Data Reader", "Spring Batch component using On-Premise Integration Agent", "Queries the On-Premise Integration Agent via REST over TLS 1.3.")
    Component(Modern DB Reader, "Modern DB Reader", "Spring Data JPA", "Queries the Modern Claims Database via JDBC over TLS 1.3.")
    Component(Discrepancy Analyzer, "Discrepancy Analyzer", "Java Streams", "Analyzes discrepancies and passes data to Audit Log Repository Writer synchronously and emits alerts to Alert & Compensation Publisher asynchronously.")
    Component(Alert & Compensation Publisher, "Alert & Compensation Publisher", "Azure Service Bus Client", "Emits alerts asynchronously via Azure Service Bus.")
    Component(Audit Log Repository Writer, "Audit Log Repository Writer", "Spring Data JDBC", "Persists audit logs synchronously via JDBC.")
}

System_Ext(On-Premise Integration Agent, "On-Premise Integration Agent", "External on-premise agent proxying requests to the mainframe.")
System_Ext(Modern Claims Database, "Modern Claims Database", "Azure SQL Database", "Stores modern claims data.")

Rel(Reconciliation Job Scheduler, Mainframe Data Reader, "Triggers via in-process method calls", "In-process")
Rel(Reconciliation Job Scheduler, Modern DB Reader, "Triggers via in-process method calls", "In-process")
Rel(Mainframe Data Reader, On-Premise Integration Agent, "Queries via REST over TLS 1.3", "REST / TLS 1.3")
Rel(Modern DB Reader, Modern Claims Database, "Queries via JDBC over TLS 1.3", "JDBC / TLS 1.3")
Rel(Discrepancy Analyzer, Audit Log Repository Writer, "Passes data synchronously via JDBC", "JDBC")
Rel(Discrepancy Analyzer, Alert & Compensation Publisher, "Emits alerts asynchronously via Azure Service Bus", "Azure Service Bus")

@enduml