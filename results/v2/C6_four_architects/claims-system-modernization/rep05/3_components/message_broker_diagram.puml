@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Message Broker container

Container_Boundary(message_broker, "Message Broker") {
    Component(TopicRouter, "Topic Router", "Azure Service Bus Topics", "Routes asynchronous events to appropriate subscription endpoints.")
    Component(DeadLetterQueueManager, "Dead-Letter Queue Manager", "Azure Service Bus DLQ", "Handles undeliverable or poisoned messages for manual inspection.")
    Component(SessionProcessor, "Session Processor", "Azure Service Bus Sessions", "Ensures strict FIFO ordering for related claim events.")
    Component(SubscriptionFilterEngine, "Subscription Filter Engine", "Azure Service Bus Rules", "Filters messages based on criteria defined per subscriber.")
    Component(BrokerAuthorizationFilter, "Broker Authorization Filter", "Azure RBAC / SAS", "Secures access to queues and topics.")
    Component(MessageTTLArchivalPolicyEngine, "Message TTL & Archival Policy Engine", "Azure Service Bus Policies", "Manages message expiration and archival workflows.")
    Component(TelemetryAuditForwarder, "Telemetry & Audit Forwarder", "Azure Monitor / Application Insights", "Forwards broker state metrics and audit trails.")
    Component(PartitionController, "Partition Controller", "Azure Service Bus Partitioning", "Scales throughput by partitioning messages across internal nodes.")
}

Rel(TopicRouter, SubscriptionFilterEngine, "Evaluates message filters")
Rel(SubscriptionFilterEngine, SessionProcessor, "Passes filtered messages for ordered processing")
Rel(SessionProcessor, DeadLetterQueueManager, "Routes failed messages")
Rel(TopicRouter, PartitionController, "Distributes load across partitions")
Rel(TopicRouter, TelemetryAuditForwarder, "Emits broker state metrics")
@enduml