@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Web App container

System_Ext(api_gateway, "API Gateway / Edge", "External API Gateway and Edge service")

Container_Boundary(claims_web_app, "Claims Web App") {
    Component(router_navigation_component, "Router / Navigation Component", "React Router", "Handles client-side routing and navigation across the modern claims application.")
    Component(authentication_wrapper, "Authentication Wrapper", "MSAL.js", "Secures Azure Active Directory Single Sign-On integration and validates tokens.")
    Component(claim_submission_feature_module, "Claim Submission Feature Module", "React Hook Form / Zod", "Provides secure online claim submissions with client-side validation.")
    Component(adjuster_workbench_module, "Adjuster Workbench Module", "TanStack Query", "Provides high-performance adjuster workflows with local caching and optimistic updates.")
    Component(feature_flag_claim_type_resolver, "Feature Flag / Claim Type Resolver", "React", "Resolves feature flags and claim types dynamically.")
    Component(api_client_layer, "API Client Layer", "TypeScript / Fetch", "Proxies all REST requests to the backend.")
    Component(audit_telemetry_interceptor, "Audit & Telemetry Interceptor", "OpenTelemetry JS / App Insights SDK", "Emits telemetry events for end-to-end traceability and audit compliance.")
    Component(state_management_store, "State Management Store", "Zustand", "Manages lightweight cross-component UI state and session data.")
}

Rel(authentication_wrapper, api_gateway, "Validates and sends tokens", "HTTPS (OIDC/Bearer)")
Rel(claim_submission_feature_module, api_gateway, "Fetches and mutates claim data", "HTTPS (REST)")
Rel(adjuster_workbench_module, api_gateway, "Fetches and mutates claim data", "HTTPS (REST)")
Rel(api_client_layer, api_gateway, "Proxies all REST requests", "HTTPS (REST)")
Rel(api_client_layer, audit_telemetry_interceptor, "Emits telemetry events", "In-memory / SDK")
Rel(authentication_wrapper, state_management_store, "Manages session and UI state", "In-memory")
Rel(claim_submission_feature_module, state_management_store, "Manages session and UI state", "In-memory")
Rel(adjuster_workbench_module, state_management_store, "Manages session and UI state", "In-memory")
Rel(feature_flag_claim_type_resolver, state_management_store, "Manages session and UI state", "In-memory")

@enduml