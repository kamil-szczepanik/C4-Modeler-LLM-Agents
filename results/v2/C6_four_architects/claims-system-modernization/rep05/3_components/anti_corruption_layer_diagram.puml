@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(anti_corruption_layer, "Anti-Corruption Layer") {
    Component(Routing_Feature_Flag_Dispatcher, "Routing & Feature Flag Dispatcher", "Azure Functions (.NET 8 / Java)", "Routes requests and handles feature flag dispatching for the hybrid migration window.")
    Component(Async_Event_Translator, "Async Event Translator", "Azure Functions (.NET 8 / Java)", "Translates asynchronous events between modern and legacy formats.")
    Component(Model_Transformer, "Model Transformer", "Azure Functions (.NET 8 / Java)", "Transforms data models between the modern schema and the legacy COBOL/DB2 structure.")
    Component(State_Deduplication_Ledger, "State & Deduplication Ledger", "Azure Cosmos DB Serverless", "Tracks in-flight transactions and ensures message deduplication.")
    Component(Circuit_Breaker_Fallback_Policy, "Circuit Breaker & Fallback Policy", "Resilience4j / Polly", "Provides resilience, circuit breaking, and fallback policies for mainframe integration.")
}

Rel(Routing_Feature_Flag_Dispatcher, Model_Transformer, "Dispatches and transforms payloads", "")
Rel(Async_Event_Translator, Model_Transformer, "Translates events for model transformation", "")
Rel(Model_Transformer, State_Deduplication_Ledger, "Records transaction state and checks deduplication", "")
Rel(Routing_Feature_Flag_Dispatcher, Circuit_Breaker_Fallback_Policy, "Invokes external calls through resilience policies", "")

@enduml