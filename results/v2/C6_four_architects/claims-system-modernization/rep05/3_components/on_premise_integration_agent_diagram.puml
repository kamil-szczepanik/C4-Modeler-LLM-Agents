@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the On-Premise Integration Agent container

Container_Boundary(on_premise_integration_agent, "On-Premise Integration Agent") {
    Component(InboundListener, "Inbound Listener", "Apache Camel (Java)", "Receives asynchronous messages from Azure Service Bus for hybrid messaging.")
    Component(MainframeProtocolAdapter, "Mainframe Protocol Adapter", "CICS/DB2 connectors, Java", "Translates modern messages into legacy transactions and queries for the mainframe.")
    Component(OutboundPoller, "Outbound Poller", "Apache Camel (Java)", "Polls legacy data sources and systems for outbound events and updates.")
    Component(CircuitBreakerRetryManager, "Circuit Breaker & Retry Manager", "Resilience4j", "Ensures fault-tolerant communication and handles transient failures during mainframe integration.")
    ComponentDb(LocalStateStore, "Local State Store", "H2 Database", "Maintains local state and buffers data to guarantee zero data loss during incremental migration.")
    Component(HealthTelemetryMonitor, "Health & Telemetry Monitor", "Micrometer (Java)", "Monitors system health and collects telemetry data for the integration agent.")
}

Rel(InboundListener, MainframeProtocolAdapter, "Routes inbound integration payloads", "Java Method Invocation")
Rel(MainframeProtocolAdapter, CircuitBreakerRetryManager, "Executes legacy transactions through fault-tolerant wrapper", "Resilience4j")
Rel(CircuitBreakerRetryManager, LocalStateStore, "Persists pending state and retry queues", "JDBC")
Rel(OutboundPoller, CircuitBreakerRetryManager, "Sends polled events through resilience wrapper", "Java Method Invocation")

@enduml