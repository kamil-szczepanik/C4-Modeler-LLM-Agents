@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person_Ext(Claims_Core_Service, "Claims Core Service", "External service interacting with the database container")
System_Ext(Message_Broker, "Message Broker", "External message broker for domain events")

Container_Boundary(Modern_Claims_Database, "Modern Claims Database") {
    Component(Claim_Data_Access_Component, "Claim Data Access Component", "Entity Framework Core", "Reads and writes claim records.")
    Component(Migration_Audit_Log_Component, "Migration Audit Log Component", "Azure SQL Ledger", "Enables tamper-evident, cryptographically verifiable migration audit logs.")
    Component(Reference_Data_Component, "Reference Data Component", "Azure SQL Database", "Provides ACID compliance for strict consistency requirements.")
    Component(Schema_Versioning_Temporal_Component, "Schema Versioning & Temporal Component", "Azure SQL Temporal Tables", "Native time-slicing to support rapid one-day claim-type rollbacks.")
    Component(Outbox_Event_Dispatcher_Component, "Outbox Event Dispatcher Component", "Transactional Outbox Pattern", "Guarantees atomic database writes and reliable messaging without distributed transactions.")
    Component(Database_Maintenance_Archival_Component, "Database Maintenance & Archival Component", "T-SQL partitioning", "Manages table partitions and index maintenance.")
}

Rel(Claims_Core_Service, Claim_Data_Access_Component, "Reads and writes claim records", "TDS (SQL)")
Rel(Claims_Core_Service, Schema_Versioning_Temporal_Component, "Queries historical claim snapshots", "Entity Framework / TDS")
Rel(Outbox_Event_Dispatcher_Component, Message_Broker, "Publishes domain events", "AMQP / Azure Service Bus SDK")
Rel(Database_Maintenance_Archival_Component, Claim_Data_Access_Component, "Manages table partitions and index maintenance", "SQL / T-SQL")

@enduml