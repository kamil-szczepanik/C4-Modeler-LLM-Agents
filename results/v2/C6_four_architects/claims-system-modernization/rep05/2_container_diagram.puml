@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Insurance Claims Modernization

Person(Customers, "Customers", "Customers submitting claims.")
Person(Brokers, "Brokers", "Brokers assisting with claims.")
Person("Claims Adjusters", "Claims Adjusters", "Internal staff managing claims.")

System_Ext("Legacy Mainframe", "Legacy Mainframe", "On-premise COBOL/DB2 system of record.")
System_Ext("Active Directory", "Active Directory", "Enterprise identity provider.")

System_Boundary("Insurance Claims Modernization", "Insurance Claims Modernization") {
    Container("API Gateway / Edge", "API Gateway / Edge", "Azure API Management", "Handles ingress, security, and routing.")
    Container("Claims Web App", "Claims Web App", "React on Azure Static Web Apps", "User interface for customers, brokers, and adjusters.")
    Container("Claims Core Service", "Claims Core Service", "Java / Spring Boot on Azure App Service", "Backend services for processing claims.")
    Container("Anti-Corruption Layer", "Anti-Corruption Layer", "Azure Functions", "Translates and decouples interactions with the legacy system.")
    Container("Audit & Reconciliation Worker", "Audit & Reconciliation Worker", "Java / Spring Batch", "Background worker for batch audit and data reconciliation.")
    Container("On-Premise Integration Agent", "On-Premise Integration Agent", "Integration Agent", "Ensures secure hybrid connectivity to the on-premise mainframe.")
    ContainerDb("Modern Claims Database", "Modern Claims Database", "Azure SQL Database", "Stores modern claim data with ACID compliance.")
    ContainerDb("Read-Through Cache", "Read-Through Cache", "Azure Cache for Redis", "Provides sub-2s performance caching.")
    Container("Message Broker", "Message Broker", "Azure Service Bus", "Handles asynchronous messaging and event processing.")
}

Rel(Customers, "Claims Web App", "Accesses claim submission and management", "HTTPS (REST)")
Rel(Brokers, "Claims Web App", "Accesses claim submission and management", "HTTPS (REST)")
Rel("Claims Adjusters", "Claims Web App", "Accesses adjuster UI workflows", "HTTPS (REST)")
Rel("Claims Web App", "API Gateway / Edge", "Sends API requests and authenticates", "HTTPS (REST / OpenID Connect)")
Rel("API Gateway / Edge", "Claims Core Service", "Routes requests to backend domain logic", "HTTPS (REST over internal VNet)")
Rel("API Gateway / Edge", "Active Directory", "Validates authentication and tokens", "OIDC/JWT")
Rel("Claims Core Service", "Modern Claims Database", "Reads and writes claim records", "TDS (SQL)")
Rel("Claims Core Service", "Read-Through Cache", "Caches frequently accessed data", "Redis TCP")
Rel("Claims Core Service", "Message Broker", "Publishes and consumes asynchronous events", "AMQP over TLS")
Rel("On-Premise Integration Agent", "Message Broker", "Connects hybrid messaging channels", "outbound AMQP/HTTPS over TLS")
Rel("On-Premise Integration Agent", "Legacy Mainframe", "Communicates with legacy records", "CICS/DB2 connectors")

@enduml