@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(CustomersAndBrokers, "Customers and Brokers", "External actors who submit online claims and interact with the platform.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal actors who manage and process claims within the adjuster workbench.")

System(ModernClaimsPlatform, "Modern Claims Platform", "A hybrid cloud Modern Claims Platform that gradually replaces a legacy COBOL/DB2 mainframe claims system over a 3-year period, enabling online claim submission and adjuster workflows while maintaining strict data consistency and synchronization.")

System_Ext(LegacyMainframe, "Legacy Mainframe", "External System of Record built on COBOL/DB2, hosted on-premise.")
System_Ext(ActiveDirectoryAzureAD, "Active Directory / Azure AD", "External Identity Provider used for SSO.")
System_Ext(NotificationService, "Notification Service", "External system for sending notifications.")
System_Ext(PaymentGateway, "Payment Gateway", "External system for processing payments.")
System_Ext(DocumentManagementSystem, "Document Management System", "External system for managing documents.")
System_Ext(AuditComplianceSystem, "Audit & Compliance System", "External system for auditing and compliance tracking.")

Rel(CustomersAndBrokers, ModernClaimsPlatform, "Submit online claims and interact with the portal", "HTTPS (REST/JSON)")
Rel(ClaimsAdjusters, ModernClaimsPlatform, "Manage and process claims via adjuster workbench for sub-2s response times", "HTTPS (REST/JSON)")
Rel(ModernClaimsPlatform, ActiveDirectoryAzureAD, "Authenticate users via Single Sign-On", "HTTPS (OIDC/OAuth 2.0)")
Rel(ModernClaimsPlatform, LegacyMainframe, "Synchronize data and process claims asynchronously", "Azure Service Bus and Azure Logic Apps")
Rel(ModernClaimsPlatform, NotificationService, "Trigger notifications", "HTTPS (REST)")
Rel(ModernClaimsPlatform, PaymentGateway, "Process claim payouts", "HTTPS (REST)")
Rel(ModernClaimsPlatform, DocumentManagementSystem, "Store and retrieve claim documents", "HTTPS (REST)")
Rel(ModernClaimsPlatform, AuditComplianceSystem, "Log compliance and audit trails", "HTTPS (REST)")

@enduml