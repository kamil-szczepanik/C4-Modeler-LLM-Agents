@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Core Service container

Container_Boundary(claims_core_service, "Claims Core Service") {
    Component(Claim Submission Controller, "Claim Submission Controller", "ASP.NET Core Web API", "Receives raw claim submissions.")
    Component(Claim Routing Engine, "Claim Routing Engine", "C# Component", "Routes claim types to either modernized engine or legacy ACL.")
    Component(Claim Domain Model & Engine, "Claim Domain Model & Engine", "C# Class Library", "Processes modernized claims and publishes domain events.")
    Component(Mainframe Anti-Corruption Layer - ACL, "Mainframe Anti-Corruption Layer - ACL", "C# Component", "Translates and routes legacy claim types.")
    Component(Persistence Repository, "Persistence Repository", "EF Core Context", "Performs transactional reads and writes to the database.")
    Component(Integration Event Publisher/Subscriber, "Integration Event Publisher/Subscriber", "MassTransit .NET", "Publishes domain events asynchronously.")
    Component(Workflow Orchestration Service, "Workflow Orchestration Service", "C# Component", "Orchestrates workflows and updates read models.")
    Component(Document Management Client, "Document Management Client", "Typed HttpClient", "Uploads and retrieves attachments from the document management system.")
    Component(Claim Caching & Read Model Component, "Claim Caching & Read Model Component", "Redis / Memory", "Implements CQRS-lite read models for fast UI responses.")
}

System_Ext(Document Management System, "Document Management System", "External document management system.")
System_Ext(Mainframe Integration Adapter, "Mainframe Integration Adapter", "External legacy mainframe integration adapter.")

Rel(Claim Submission Controller, Claim Routing Engine, "Forwards raw submissions", "In-process")
Rel(Claim Routing Engine, Claim Domain Model & Engine, "Routes modernized claim types", "In-process")
Rel(Claim Routing Engine, Mainframe Anti-Corruption Layer - ACL, "Routes legacy claim types", "In-process")
Rel(Claim Domain Model & Engine, Persistence Repository, "Performs transactional reads/writes", "TDS via EF Core")
Rel(Claim Domain Model & Engine, Integration Event Publisher/Subscriber, "Publishes domain events", "AMQP via Azure Service Bus")
Rel(Workflow Orchestration Service, Claim Caching & Read Model Component, "Updates read models", "In-process / Redis")
Rel(Document Management Client, Document Management System, "Uploads and retrieves attachments", "HTTPS")
Rel(Mainframe Anti-Corruption Layer - ACL, Mainframe Integration Adapter, "Syncs legacy data", "gRPC/HTTP")

@enduml