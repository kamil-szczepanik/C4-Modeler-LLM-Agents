@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component Diagram for Customer Portal and Adjuster Workspace SPAs

Container_Boundary(spa_container, "Customer Portal and Adjuster Workspace SPAs") {
    Component(ClaimSubmissionUIModule, "Claim Submission UI Module", "React, Azure Static Web Apps", "Provides online claim submission interfaces for customers and brokers.")
    Component(AdjusterWorkspaceUIModule, "Adjuster Workspace UI Module", "React, Azure Static Web Apps", "Provides modern workflows and interfaces for claims adjusters to manage and process claims.")
    Component(AuthenticationClientModule, "Authentication Client Module", "OIDC/OAuth2 Client Library", "Handles user authentication requests against Azure Active Directory.")
    Component(APIGatewayClientModule, "API Gateway Client Module", "Fetch / Axios REST Client", "Sends secure API requests over HTTPS to Azure API Management.")
}

Rel(ClaimSubmissionUIModule, APIGatewayClientModule, "Sends claim submission data", "HTTPS (REST/JSON)")
Rel(AdjusterWorkspaceUIModule, APIGatewayClientModule, "Sends claim management requests", "HTTPS (REST/JSON)")
Rel(ClaimSubmissionUIModule, AuthenticationClientModule, "Authenticates users", "OIDC/OAuth2")
Rel(AdjusterWorkspaceUIModule, AuthenticationClientModule, "Authenticates users", "OIDC/OAuth2")

@enduml