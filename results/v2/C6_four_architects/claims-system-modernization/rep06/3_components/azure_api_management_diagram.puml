@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("azure_api_management", "Azure API Management") {
    Component("JWT Validation Policy", "JWT Validation Policy", "Azure APIM Policy", "Validates incoming JSON Web Tokens and fetches OpenID Connect metadata and JWKS from Azure Active Directory.")
    Component("Response Caching Component", "Response Caching Component", "Azure Redis Cache integration", "Caches read-only claim lookup data to protect the legacy mainframe from performance degradation.")
    Component("Rate Limiting & Quota Policy", "Rate Limiting & Quota Policy", "Azure APIM Policy", "Enforces rate limits and quotas for incoming API requests.")
    Component("Transformation & Request Routing Policy", "Transformation & Request Routing Policy", "Azure APIM Policy", "Transforms and routes modern claim type requests to the Claims Core Service and legacy fallback requests to the Mainframe Integration Adapter.")
}

System_Ext("Azure Active Directory", "Azure Active Directory", "Identity Provider and OIDC metadata source.")
System_Ext("Azure Redis Cache", "Azure Redis Cache", "In-memory caching layer.")
System_Ext("Claims Core Service", "Claims Core Service", "Modern microservices backend for claim processing.")
System_Ext("Mainframe Integration Adapter", "Mainframe Integration Adapter", "Adapter for legacy system communication.")

Rel("JWT Validation Policy", "Azure Active Directory", "Fetch OpenID Connect metadata and JSON Web Keys (JWKS)", "HTTPS / OIDC")
Rel("Response Caching Component", "Azure Redis Cache", "Cache read-only claim lookup data", "TCP / Redis Protocol")
Rel("Transformation & Request Routing Policy", "Claims Core Service", "Route modern claim type requests", "HTTP/2")
Rel("Transformation & Request Routing Policy", "Mainframe Integration Adapter", "Route legacy fallback requests", "HTTP/2")
@enduml