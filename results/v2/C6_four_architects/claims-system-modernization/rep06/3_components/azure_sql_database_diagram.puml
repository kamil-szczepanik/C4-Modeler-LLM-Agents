@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure SQL Database container

Person(Claims_Core_Service, "Claims Core Service", "External or container-level dependent service interacting with the database")
Person(Azure_Data_Factory, "Azure Data Factory", "External data pipeline service")
Person(Mainframe_Integration_Adapter, "Mainframe Integration Adapter", "External integration adapter service")
Person(Audit_Compliance_System, "Audit & Compliance System", "External auditing service")

Container_Boundary(Azure_SQL_Database, "Azure SQL Database") {
    Component(Claims_Data_Model, "Claims Data Model", "Entity Framework Core Migrations", "Relational tables and schemas structured per claim type ensuring zero data loss.")
    Component(Data_Access_Layer, "Data Access Layer", ".NET 8 Libraries, Entity Framework Core, T-SQL", "Implements Repository and Unit of Work patterns for data access and transactions.")
    Component(Database_Security_Auditing, "Database Security & Auditing", "Azure SQL Transparent Data Encryption, Row-Level Security, SQL Audit", "Provides database security, row-level restrictions, and audit logs.")
    Component(Temporal_Tables, "Temporal Tables", "SQL Server System-Versioning", "Provides immutable historical audit trails for claims data.")
    Component(Mainframe_Sync_Staging_Tables, "Mainframe Sync Staging Tables", "Dedicated Schemas / T-SQL", "Buffers bi-directional state changes between the modern platform and the legacy mainframe.")
    Component(Stored_Procedures_Database_Triggers, "Stored Procedures & Database Triggers", "T-SQL", "Handles high-performance batch processing and validation within strict legacy batch windows.")
}

Rel(Claims_Core_Service, Data_Access_Layer, "In-process method calls", "C# / Entity Framework Core")
Rel(Data_Access_Layer, Claims_Data_Model, "Queries and transactions", "T-SQL")
Rel(Azure_Data_Factory, Mainframe_Sync_Staging_Tables, "Bulk copy operations", "Bulk Insert / T-SQL")
Rel(Mainframe_Integration_Adapter, Mainframe_Sync_Staging_Tables, "Read/Write sync states", "T-SQL via EF Core")
Rel(Audit_Compliance_System, Database_Security_Auditing, "Direct log scraping", "Azure Monitor / SQL Audit Output")

@enduml