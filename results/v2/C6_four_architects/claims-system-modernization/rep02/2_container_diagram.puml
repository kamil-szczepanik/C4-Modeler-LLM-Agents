@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Modern Claims Platform

Person(Customer_and_Broker, "Customer & Broker", "External actors submitting online claims via web UI.")
Person(Claims_Adjuster, "Claims Adjuster", "Internal actor processing claims in the new web application.")

System_Ext(Legacy_Mainframe_On_Premises, "Legacy Mainframe (On-Premises)", "COBOL/DB2 system of record handling nightly batch processing.")
System_Ext(Insurers_Active_Directory_Azure_AD__Entra_ID, "Insurer's Active Directory (Azure AD / Entra ID)", "Enterprise identity provider for SSO.")

System_Boundary(Modern_Claims_Platform, "Modern Claims Platform") {
    Container(Web_Portal, "Web Portal", "React on Azure Static Web Apps", "Customer and broker claim submission interface.")
    Container(Adjuster_Workspace, "Adjuster Workspace", "React on Azure App Service", "Asynchronous caching workspace for claims handlers.")
    Container(API_Management_Proxy, "API Management Proxy", "Azure API Management", "Handling routing and Azure AD (Entra ID) SSO.")
    Container(Claims_Processing_Service, "Claims Processing Service", "Java / Spring Boot on Azure Container Apps", "Core domain logic execution.")
    Container(Claim_Routing_Service, "Claim Routing Service", "Azure Service Bus", "Managing messaging and fallback routing.")
    ContainerDb(Primary_Datastore, "Primary Datastore", "Azure SQL Database", "Providing ACID compliance for the new platform.")
    ContainerDb(Claim_Read_Model_Store, "Claim Read Model Store", "Azure Cosmos DB / Redis", "Providing read-optimized projections.")
    Container(Mainframe_Integration_Adapter, "Mainframe Integration Adapter", "IBM MQ on-premises", "Managing legacy batch integration.")
    Container(Data_Sync_Worker, "Data Sync Worker", "Java / Spring Boot on Azure Container Apps", "Handling state reconciliation.")
    Container(Audit_and_Reconciliation_Service, "Audit and Reconciliation Service", "Azure Functions", "Cross-referencing state to prevent discrepancies.")
}

Rel(Customer_and_Broker, Web_Portal, "Submits claims", "HTTPS/TLS")
Rel(Claims_Adjuster, Adjuster_Workspace, "Processes claims", "HTTPS/TLS")
Rel(Web_Portal, API_Management_Proxy, "Routes portal traffic", "HTTPS/TLS")
Rel(Adjuster_Workspace, API_Management_Proxy, "Routes adjuster traffic", "HTTPS/TLS")
Rel(API_Management_Proxy, Claims_Processing_Service, "Forwards API requests", "Internal mTLS")
Rel(API_Management_Proxy, Insurers_Active_Directory_Azure_AD__Entra_ID, "Authenticates users", "HTTPS")
Rel(Claims_Processing_Service, Primary_Datastore, "Relational transactional persistence", "TDS over TLS")
Rel(Claims_Processing_Service, Claim_Routing_Service, "Publishes domain events", "AMQP")
Rel(Claim_Routing_Service, Claim_Read_Model_Store, "Updates projections via CDC and events", "Azure Service Bus")
Rel(Legacy_Mainframe_On_Premises, Mainframe_Integration_Adapter, "Legacy synchronization", "AMQP over Azure ExpressRoute/VPN")
Rel(Mainframe_Integration_Adapter, Data_Sync_Worker, "Feeds legacy batch data", "IBM MQ / Azure Service Bus")
Rel(Data_Sync_Worker, Primary_Datastore, "Reconciles state", "TDS over TLS")
Rel(Audit_and_Reconciliation_Service, Primary_Datastore, "Cross-references state", "TDS over TLS")
Rel(Audit_and_Reconciliation_Service, Claim_Read_Model_Store, "Validates read projections", "HTTPS")

@enduml