@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer_Broker, "Customer & Broker", "External actors submitting online claims via web UI.")
Person(Claims_Adjuster, "Claims Adjuster", "Internal actor processing claims in the new web application.")
Person(IT_Administrator, "IT Administrator", "Manages system administration and access.")

System(Modern_Claims_Platform, "Modern Claims Platform", "A hybrid cloud Modern Claims Platform that gradually replaces a 30-year-old COBOL/DB2 mainframe while maintaining continuous claims processing.")

System_Ext(Legacy_Mainframe_On_Premises, "Legacy Mainframe (On-Premises)", "COBOL/DB2 system of record handling nightly batch processing (23:00-05:00).")
System_Ext(Insurers_Active_Directory_Azure_AD__Entra_ID, "Insurer's Active Directory (Azure AD / Entra ID)", "Enterprise identity provider for SSO.")
System_Ext(Payment_Gateway, "Payment Gateway", "External third-party system for executing financial payouts.")

Rel(Customer_Broker, Modern_Claims_Platform, "Submits online claims", "HTTPS (TLS 1.3)")
Rel(Claims_Adjuster, Modern_Claims_Platform, "Processes claims in the new web application", "HTTPS (TLS 1.3)")
Rel(IT_Administrator, Modern_Claims_Platform, "Manages system administration and access", "HTTPS (TLS 1.3)")
Rel(Modern_Claims_Platform, Insurers_Active_Directory_Azure_AD__Entra_ID, "Authenticates users for Single Sign-On", "OIDC / OAuth 2.0 over HTTPS")
Rel(Modern_Claims_Platform, Legacy_Mainframe_On_Premises, "Asynchronous bidirectional messaging and state synchronization", "Azure Service Bus (AMQP/HTTPS)")
Rel(Legacy_Mainframe_On_Premises, Modern_Claims_Platform, "Asynchronous bidirectional messaging and state synchronization", "Azure Service Bus (AMQP/HTTPS)")
Rel(Modern_Claims_Platform, Payment_Gateway, "Executes financial payouts", "REST / HTTPS")

@enduml