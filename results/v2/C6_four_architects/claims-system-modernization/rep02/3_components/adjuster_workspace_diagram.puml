@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(adjuster_workspace_container, "Adjuster Workspace") {
    Component(shell, "Workspace Shell Component & Security Context Component", "React components, Azure AD / Entra ID SSO via MSAL.js [OIDC/JWT]", "Handles layout, session, and Azure AD / Entra ID SSO.")
    Component(controller, "Claim Interaction Controller & Caching & Synchronization Client", "React/Redux, IndexedDB, Service Worker", "Manages local state and masks slow backend latencies.")
    Component(conflict, "Conflict Resolution UI Handler & Telemetry & Audit Component", "React components, OpenTelemetry metrics", "Manages concurrent updates and telemetry/audit functions.")
    Component(api_client, "API Gateway Client Layer & Feature Flag & Routing Client", "Axios/Fetch communication layer, dynamic routing toggle component", "Handles communication layer and dynamic routing toggles.")
}

Rel(shell, api_client, "Transmits API requests with bearer tokens", "HTTPS/JSON via Interceptors")
Rel(controller, shell, "Renders within layout and session context", "")
Rel(conflict, controller, "Manages concurrent updates for local state", "")

@enduml