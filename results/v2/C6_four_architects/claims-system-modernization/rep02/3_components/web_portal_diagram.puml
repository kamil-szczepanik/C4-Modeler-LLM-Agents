@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Portal container

Container_Boundary(web_portal, "Web Portal") {
    Component(Customer_and_Broker_UI, "Customer and Broker UI", "React SPA, Azure Static Web Apps, TypeScript, TanStack Query, MSAL.js", "Provides the user interface for customers and brokers to submit and track claims with Azure AD SSO.")
}

System_Ext(API_Management_Proxy, "API Management Proxy", "Azure API Management gateway")

Rel(Customer_and_Broker_UI, API_Management_Proxy, "Routes portal traffic", "HTTPS/TLS")

@enduml