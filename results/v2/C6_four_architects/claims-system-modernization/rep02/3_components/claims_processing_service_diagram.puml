@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Processing Service container

Container_Boundary(claims_processing_service, "Claims Processing Service") {
    Component(ClaimSubmissionController, "Claim Submission Controller", "Spring MVC", "Handles incoming online claim submissions and adjuster workflows.")
    Component(ClaimsSecurityContextFacade, "Claims Security & Context Facade", "Spring Security", "Manages authentication, authorization, and security context propagation.")
    Component(ValidationEnrichmentEngine, "Validation & Enrichment Engine", "Spring Validation / Drools", "Validates and enriches claim data against business rules.")
    Component(MigrationStrategyRouter, "Migration Strategy Router", "Java SPI / Strategy Pattern", "Routes claims between modern persistence and legacy mainframe integration.")
    Component(ClaimDomainModelCore, "Claim Domain Model Core", "Spring Data JPA", "Manages the core domain model and transactional persistence.")
    Component(OutboxEventPublisher, "Outbox Event Publisher", "Java / Spring Boot", "Implements the Transactional Outbox pattern to guarantee zero data loss.")
    Component(MainframeSyncListener, "Mainframe Sync Listener", "Spring Integration", "Facilitates communication and synchronization with the legacy mainframe system.")
}

Rel(ClaimSubmissionController, ClaimsSecurityContextFacade, "In-memory Filter / Method Call")
Rel(ClaimsSecurityContextFacade, ValidationEnrichmentEngine, "In-memory Java Method Call")
Rel(ValidationEnrichmentEngine, MigrationStrategyRouter, "In-memory Java Method Call")
Rel(MigrationStrategyRouter, ClaimDomainModelCore, "In-memory Java Method Call")
Rel(MigrationStrategyRouter, MainframeIntegrationAdapter, "IBM MQ", "asynchronous")
Rel(ClaimDomainModelCore, OutboxEventPublisher, "In-memory transactional boundary")
Rel(OutboxEventPublisher, PrimaryDatastore, "JDBC over TLS")

@enduml