@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Primary Datastore container

System_Ext(ClaimsProcessingService, "Claims Processing Service", "External container interacting with the primary datastore.")
System_Ext(DataSyncWorker, "Data Sync Worker", "External container interacting with temporal tables.")
System_Ext(AuditAndReconciliationService, "Audit and Reconciliation Service", "External container interacting with the audit log.")

Container_Boundary(PrimaryDatastore, "Primary Datastore") {
    Component(ClaimTransactionalEngine, "Claim Transactional Engine", "Azure SQL Database, Azure SQL Core", "Handles relational transactional persistence and core database operations.")
    Component(MainframeCompatibilitySchemaAdapter, "Mainframe-Compatibility Schema Adapter", "Azure SQL Database Schema", "Ensures schema compatibility with legacy mainframe systems for seamless fallbacks.")
    Component(AuditTrailLogTable, "Audit Trail Log Table", "Azure SQL Database Table", "Logs audit trails and cross-references state changes.")
    Component(RowLevelSecurityRLSPartitioningManager, "Row-Level Security (RLS) & Partitioning Manager", "Azure SQL RLS & Partitioning", "Manages row-level security and data partitioning for hybrid security.")
    Component(TemporalTableArchivalEngine, "Temporal Table Archival Engine", "Azure SQL Temporal Tables", "Automatically tracks historical row versions to support rollbacks and auditing.")
}

Rel(ClaimsProcessingService, ClaimTransactionalEngine, "Relational transactional persistence", "TDS over TLS")
Rel(DataSyncWorker, TemporalTableArchivalEngine, "Reconciles state", "TDS over TLS")
Rel(AuditAndReconciliationService, AuditTrailLogTable, "Cross-references state", "TDS over TLS")

@enduml