@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claim Read Model Store container

Person(Adjuster_Workspace, "Adjuster Workspace", "External system / workspace interacting with read models.")
System_Ext(Data_Sync_Worker, "Data Sync Worker", "External worker syncing data.")
System_Ext(Audit_and_Reconciliation_Service, "Audit and Reconciliation Service", "External service auditing data streams.")

Container_Boundary(Claim_Read_Model_Store, "Claim Read Model Store") {
    Component(Claim_Projection_Container, "Claim Projection Container", "Azure Cosmos DB", "Stores denormalized read models for low-latency queries.")
    Component(Cosmos_DB_Access_Control, "Cosmos DB Access Control", "Azure IAM / Token Validation", "Validates scoped tokens for secure data access.")
    Component(Cosmos_DB_Change_Feed, "Cosmos DB Change Feed", "Cosmos DB Native Change Feed", "Streams mutation events from the projection container.")
    Component(Cosmos_DB_Telemetry___Diagnostic_Component, "Cosmos DB Telemetry & Diagnostic Component", "Azure Monitor Diagnostics", "Emits performance metrics and diagnostics.")
}

Rel(Adjuster_Workspace, Claim_Projection_Container, "Queries read models directly", "HTTPS / Cosmos DB SDK")
Rel(Adjuster_Workspace, Cosmos_DB_Access_Control, "Validates scoped tokens", "HTTPS")
Rel(Data_Sync_Worker, Claim_Projection_Container, "Upserts denormalized read models", "TCP / Cosmos DB SDK")
Rel(Claim_Projection_Container, Audit_and_Reconciliation_Service, "Streams mutation events", "Change Feed API")
Rel(Claim_Projection_Container, Cosmos_DB_Telemetry___Diagnostic_Component, "Emits performance metrics", "Azure Monitor Diagnostics")

@enduml