@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers, "Customers", "End users submitting insurance claims.")
Person(Brokers, "Brokers", "Intermediaries assisting with insurance claims and submissions.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal staff reviewing and processing insurance claims.")

System(NewInsuranceClaimsPlatform, "New Insurance Claims Platform", "A hybrid cloud insurance claims platform that progressively replaces a 30-year-old COBOL/DB2 mainframe, modernizing customer submissions and adjuster workflows while maintaining legacy data consistency.")

System_Ext(LegacyMainframe, "Legacy Mainframe", "On-premise COBOL/DB2 System of Record.")
System_Ext(IdentityProviderActiveDirectory, "Identity Provider / Active Directory", "On-premise SSO provider for authentication.")
System_Ext(DocumentManagementSystem, "Document Management System", "On-premise archive for document storage.")
System_Ext(CoreBankingPayoutSystem, "Core Banking / Payout System", "On-premise ledger for handling financial payouts.")
System_Ext(NotificationService, "Notification Service", "Cloud SaaS for sending notifications.")

Rel(Customers, NewInsuranceClaimsPlatform, "Submits claims and interacts with the platform", "HTTPS / REST")
Rel(Brokers, NewInsuranceClaimsPlatform, "Submits claims and manages policies on behalf of customers", "HTTPS / REST")
Rel(ClaimsAdjusters, NewInsuranceClaimsPlatform, "Manages and processes workflows", "HTTPS / Web")
Rel(NewInsuranceClaimsPlatform, LegacyMainframe, "Batch synchronization and data consistency", "Azure Data Factory / Secure FTP via Azure ExpressRoute")
Rel(LegacyMainframe, NewInsuranceClaimsPlatform, "Data synchronization", "Azure Data Factory / Secure FTP via Azure ExpressRoute")
Rel(NewInsuranceClaimsPlatform, IdentityProviderActiveDirectory, "Authenticates users via SSO", "OpenID Connect / OAuth 2.0 over mTLS / HTTPS")
Rel(NewInsuranceClaimsPlatform, DocumentManagementSystem, "Stores and retrieves archived documents", "HTTPS over Azure ExpressRoute")
Rel(DocumentManagementSystem, NewInsuranceClaimsPlatform, "Provides document access", "HTTPS over Azure ExpressRoute")
Rel(NewInsuranceClaimsPlatform, CoreBankingPayoutSystem, "Initiates financial payouts", "ISO 20022 / HTTPS over Azure ExpressRoute")
Rel(NewInsuranceClaimsPlatform, NotificationService, "Triggers notifications to users", "HTTPS / REST via TLS 1.3")

@enduml