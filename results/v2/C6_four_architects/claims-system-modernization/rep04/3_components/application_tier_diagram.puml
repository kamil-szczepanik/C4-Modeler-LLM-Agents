@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Application Tier container

Container_Boundary(app_tier, "Application Tier") {
    Component(ClaimSubmissionComponent, "Claim Submission Component", "Java, Spring Boot", "Handles the submission of new insurance claims.")
    Component(AdjusterWorkspaceComponent, "Adjuster Workspace Component", "Java, Spring Boot", "Provides the interface and logic for claims adjusters.")
    Component(AntiCorruptionLayerRouterComponent, "Anti-Corruption Layer (ACL) & Router Component", "Java, Spring Boot", "Routes unmigrated claim types to the legacy mainframe and translates models.")
    Component(OutboxProcessorComponent, "Outbox Processor Component", "Java, Spring Boot", "Processes transactional outbox messages for reliable event publishing.")
    Component(UnifiedWorkers, "Unified Workers", "Java, Spring Boot, Azure Container Apps, KEDA", "Executes event-driven background tasks with autoscaling.")
    Component(AuditComplianceComponent, "Audit & Compliance Component", "Java, Spring Boot, Spring AOP", "Ensures audit trails and compliance checks across internal components.")
}

System_Ext(DataTier, "Data Tier", "External Data Tier")
System_Ext(HybridBridge, "Hybrid Bridge", "External Hybrid Bridge")
System_Ext(IntegrationTier, "Integration Tier", "External Integration Tier")
System_Ext(CoreBankingNotificationServices, "Core Banking & Notification Services", "External Core Banking & Notification Services")

Rel(ClaimSubmissionComponent, DataTier, "Reads and writes data", "Spring Data JPA / PostgreSQL Protocol")
Rel(AdjusterWorkspaceComponent, DataTier, "Reads and writes data", "Spring Data JPA / PostgreSQL Protocol")
Rel(AntiCorruptionLayerRouterComponent, HybridBridge, "Communicates with mainframe", "gRPC over Azure Relay / TCP")
Rel(OutboxProcessorComponent, IntegrationTier, "Publishes messages", "AMQP over Azure Service Bus")
Rel(UnifiedWorkers, CoreBankingNotificationServices, "Invokes services", "HTTPS / REST")
Rel(ClaimSubmissionComponent, AuditComplianceComponent, "Monitored", "Spring AOP")
Rel(AdjusterWorkspaceComponent, AuditComplianceComponent, "Monitored", "Spring AOP")
Rel(AntiCorruptionLayerRouterComponent, AuditComplianceComponent, "Monitored", "Spring AOP")
Rel(OutboxProcessorComponent, AuditComplianceComponent, "Monitored", "Spring AOP")
Rel(UnifiedWorkers, AuditComplianceComponent, "Monitored", "Spring AOP")

@enduml