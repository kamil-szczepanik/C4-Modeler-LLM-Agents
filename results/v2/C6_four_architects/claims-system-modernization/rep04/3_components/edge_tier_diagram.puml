@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Edge Tier container

Container_Boundary(edge_tier, "Edge Tier") {
    Component(BFF_Orchestrator, "BFF Orchestrator", "Node.js / Express", "Orchestrates API calls, handles business logic aggregation, and communicates via gRPC with internal services.")
    Component(Edge_Security_Proxy, "Edge Security Proxy", "Node.js / TypeScript", "Ensures edge security and communicates securely with the integration tier via HTTPS and mTLS.")
    Component(Edge_Configuration_Component, "Edge Configuration Component", "Node.js with Redis Cache", "Provides sub-millisecond dynamic claim-type routing lookups and supports instant fallbacks.")
}

System_Ext(Integration_Tier_Azure_Relay, "Integration Tier (Azure Relay)", "Azure Service Bus and Azure Relay")
System_Ext(Application_Tier, "Application Tier", "Azure Container Apps (Java/Spring Boot, Python/C# Azure Functions)")

Rel(BFF_Orchestrator, Edge_Configuration_Component, "Redis Cache lookup", "")
Rel(BFF_Orchestrator, Edge_Security_Proxy, "gRPC", "")
Rel(Edge_Security_Proxy, Integration_Tier_Azure_Relay, "HTTPS / mTLS", "")
Rel(BFF_Orchestrator, Application_Tier, "gRPC", "")

@enduml