@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Frontend container

System_Ext(AzureActiveDirectoryEntraID, "Azure Active Directory (Entra ID)", "External System")
System_Ext(EdgeTier, "Edge Tier", "External System")

Container_Boundary(Frontend, "Frontend") {
    Component(AuthModule, "Auth Module", "MSAL.js", "Handles user authentication and integration with Azure AD for Single Sign-On (SSO).")
    Component(CustomerPortalUI, "Customer Portal UI", "React Single Page Application", "User interface for customers to interact with the claims system.")
    Component(AdjusterWorkspaceUI, "Adjuster Workspace UI", "React Single Page Application", "User interface for claims adjusters to manage and process claims.")
    Component(StateManagementStore, "State Management Store", "React Query", "Caches server state and enables optimistic UI updates to mask legacy latency.")
    Component(APIClient, "API Client", "Axios", "Sends API requests to the Edge Tier.")
    Component(FeatureFlagRoutingEngine, "Feature Flag & Routing Engine", "React", "Manages routing and feature flags for the application.")
    Component(ErrorBoundaryFallbackHandler, "Error Boundary & Fallback Handler", "React", "Handles runtime errors and provides fallback UI components.")
}

Rel(AuthModule, AzureActiveDirectoryEntraID, "Authenticates users", "OAuth2 / OIDC")
Rel(APIClient, EdgeTier, "Sends API requests and authenticates", "HTTPS / OIDC")
Rel(CustomerPortalUI, StateManagementStore, "Reads and writes cached server state")
Rel(AdjusterWorkspaceUI, StateManagementStore, "Reads and writes cached server state")
Rel(StateManagementStore, APIClient, "Fetches data via")
@enduml