@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Tier container

System_Ext(Application_Tier, "Application Tier", "Java/Spring Boot microservices")
System_Ext(Hybrid_Bridge, "Hybrid Bridge", "Spring Boot Mainframe Adapter on-premise")

Container_Boundary(Integration_Tier, "Integration Tier") {
    Component(Event_Bus_Router, "Event Bus Router", "Azure Service Bus", "Asynchronous pub/sub messaging ensuring guaranteed message delivery and zero data loss.")
    Component(Hybrid_Tunnel_Gateway, "Hybrid Tunnel Gateway", "Azure Relay", "Establishes secure, outbound-only hybrid connectivity respecting corporate firewall constraints.")
    Component(Dead_Letter_Reconciliation_Manager, "Dead Letter & Reconciliation Manager", "Azure Service Bus DLQ and Azure Functions", "Captures poisoned messages and automates error reconciliation.")
    Component(Schema_Transformation_Router, "Schema Transformation Router", "Azure Functions and API Management", "Centralized API routing and legacy data formatting to avoid costly mainframe modifications.")
}

Rel(Application_Tier, Event_Bus_Router, "Publishes domain events", "AMQP")
Rel(Event_Bus_Router, Schema_Transformation_Router, "Queues messages requiring legacy translation", "AMQP")
Rel(Schema_Transformation_Router, Hybrid_Tunnel_Gateway, "Forwards transformed payloads", "HTTPS/AMQP")
Rel(Hybrid_Tunnel_Gateway, Hybrid_Bridge, "Connects securely to on-premise mainframe", "Azure Relay")
Rel(Event_Bus_Router, Dead_Letter_Reconciliation_Manager, "Captures poisoned messages", "Internal Service Bus API")
Rel(Dead_Letter_Reconciliation_Manager, Application_Tier, "Triggers reconciliation alerts", "Webhooks/HTTPS")

@enduml