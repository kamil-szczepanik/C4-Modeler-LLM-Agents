@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Hybrid Bridge container

Container_Boundary(hybrid_bridge, "Hybrid Bridge") {
    Component(Sync_Router_Component, "Sync Router Component", "Spring Boot", "Routes incoming requests and integrates with Azure Service Bus / Azure Relay.")
    Component(Mainframe_Adapter_Component, "Mainframe Adapter Component", "Spring Boot", "Adapts calls between modern services and legacy mainframe formats.")
    Component(Transaction_Ledger_Component, "Transaction Ledger Component", "Local H2/PostgreSQL store", "Maintains a local transactional ledger to ensure idempotency and zero data loss.")
    Component(Configuration_Feature_Toggle_Component, "Configuration & Feature Toggle Component", "Database-backed registry", "Manages configuration and feature toggles via an in-memory Java API.")
    Component(Batch_Co_ordination_Component, "Batch Co-ordination Component", "Spring Boot", "Coordinates batch processing respecting rigid nightly batch windows.")
    Component(Schema_EBCDIC_Translation_Component, "Schema & EBCDIC Translation Component", "Apache Camel", "Handles bi-ordinated JSON-to-EBCDIC mapping and schema translation.")
    Component(Circuit_Breaker_Retry_Manager_Component, "Circuit Breaker & Retry Manager Component", "Resilience4j", "Provides fault tolerance, circuit breaker, and retry policies over hybrid networks.")
}

Rel(Sync_Router_Component, Configuration_Feature_Toggle_Component, "Queries feature toggles", "In-memory Java API")
Rel(Batch_Co_ordination_Component, Transaction_Ledger_Component, "Persists batch state", "Local JPA/SQL")
Rel(Mainframe_Adapter_Component, Schema_EBCDIC_Translation_Component, "Translates data", "Internal Java Method Calls")
Rel(Mainframe_Adapter_Component, Circuit_Breaker_Retry_Manager_Component, "Decorates calls", "Internal Java method decoration")

@enduml