@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(Patron_Staff, "Patron & Staff", "End-users accessing web and mobile interfaces to browse catalogs, manage circulation, and utilize self-service portals.")

System_Ext(Identity_Provider, "Identity Provider", "Keycloak or Auth0 hosted in the EU for OAuth2/OIDC authentication.")
System_Ext(External_Payment_Gateway, "External Payment Gateway", "Stripe or Adyen restricted to EU regions for fine collection.")
System_Ext(National_Library_Registry, "National Library Registry", "Used for ISBN and bibliographic metadata lookup.")
System_Ext(Notification_Service, "Notification Service", "Sendinblue/Brevo EU-hosted provider for circulation alerts.")
System_Ext(Digital_Content_Delivery_Provider, "Digital Content Delivery Provider", "OverDrive or Adobe APIs for digital asset fulfillment.")

System_Boundary(Library_Management_System, "Library Management System") {
    Container(Web_Frontend, "Web Frontend", "React/TypeScript, CDN", "React/TypeScript Single Page Application served via CDN.")
    Container(API_Gateway, "API Gateway", "Kong or Nginx", "Kong or Nginx reverse proxy managing routing and ingress.")
    Container(Core_Services, "Core Services", "Java/Spring Boot", "Java/Spring Boot application handling circulation and business logic.")
    Container(Search_Engine, "Search Engine", "OpenSearch", "OpenSearch cluster for high-performance catalog queries.")
    ContainerDb(Database_Cache, "Database & Cache", "PostgreSQL 15+, Redis/Valkey, AWS RDS Frankfurt", "PostgreSQL 15+ on AWS RDS Frankfurt and Redis/Valkey for in-memory caching.")
    Container(Async_Event_Bus, "Async Event Bus", "Apache Kafka or RabbitMQ", "Apache Kafka or RabbitMQ for decoupled messaging.")
}

Rel(Patron_Staff, Identity_Provider, "Authenticates via OAuth2/OIDC redirect", "HTTPS")
Rel(Patron_Staff, Web_Frontend, "Accesses web and mobile interfaces", "HTTPS/TLS")
Rel(Web_Frontend, API_Gateway, "Sends API requests", "HTTPS")
Rel(API_Gateway, Core_Services, "Routes requests to business logic", "gRPC over internal TLS")
Rel(API_Gateway, Search_Engine, "Queries catalog data", "gRPC over internal TLS")
Rel(Core_Services, Database_Cache, "Reads and writes relational data and cache", "Internal TLS / TCP")
Rel(Core_Services, Async_Event_Bus, "Publishes and consumes asynchronous events", "Internal TLS / TCP")
Rel(Core_Services, External_Payment_Gateway, "Processes fine collections", "REST/SOAP over HTTPS")
Rel(Core_Services, National_Library_Registry, "Looks up ISBN and bibliographic metadata", "REST/SOAP over HTTPS")
Rel(Core_Services, Notification_Service, "Sends circulation alerts", "REST/SOAP over HTTPS")
Rel(Core_Services, Digital_Content_Delivery_Provider, "Fulfills digital assets", "REST/SOAP over HTTPS")

@enduml