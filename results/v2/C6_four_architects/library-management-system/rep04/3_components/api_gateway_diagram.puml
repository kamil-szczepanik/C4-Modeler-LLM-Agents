@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(ssl_tls_termination_geo_routing_terminator, "SSL/TLS Termination & Geo-Routing Terminator", "Kong/Envoy", "Handles edge termination and enforces strict EU-only data residency.")
    Component(auth_rate_limiting_filter, "Auth & Rate Limiting Filter", "Kong/Envoy Plugin", "Performs token validation and rate-limiting utilizing Redis.")
    Component(route_dispatcher, "Route Dispatcher", "Kong/Envoy Router", "Routes validated and transformed business traffic to core services and search.")
    Component(request_transformation_engine, "Request Transformation Engine", "Kong/Envoy", "Transforms incoming requests before dispatching to internal containers.")
    Component(circuit_breaker_fallback_manager, "Circuit Breaker & Fallback Manager", "Kong/Envoy", "Implements fallback content and resilience patterns using Redis.")
    Component(analytics_logging_collector, "Analytics & Logging Collector", "OTLP/HTTPS", "Exports audit and observability data to external SIEM/Monitoring within EU boundaries.")
}

Rel(ssl_tls_termination_geo_routing_terminator, auth_rate_limiting_filter, "Passes incoming requests for validation")
Rel(auth_rate_limiting_filter, request_transformation_engine, "Passes authenticated requests")
Rel(request_transformation_engine, route_dispatcher, "Dispatches transformed requests")
Rel(route_dispatcher, analytics_logging_collector, "Sends metrics and logs")

@enduml