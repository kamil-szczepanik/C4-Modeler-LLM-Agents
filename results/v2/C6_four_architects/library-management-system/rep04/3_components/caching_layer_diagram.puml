@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Caching Layer container

Container_Boundary(caching_layer, "Caching Layer") {
    Component(CacheRouterComponent, "Cache Router Component", "Network / TCP", "Manages incoming TCP connections and client authentication.")
    Component(InMemoryStoreComponent, "In-MemoryStore Component", "Redis OSS / Enterprise, In-Memory", "Handles key-value data storage and LRU eviction policies for item catalogues.")
}

Rel(CacheRouterComponent, InMemoryStoreComponent, "Uses RESP Execution Engine [In-Process] for atomic command processing.", "In-Process")

@enduml