@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Worker Container container

System_Ext(MessageBroker, "Message Broker", "External messaging system")
System_Ext(ExternalSystems, "External Systems", "Third-party APIs and services")
System_Ext(ExternalClients, "External Clients", "Internal callers utilizing resilience wrappers")
System_Ext(APIGateway, "API Gateway", "Gateway for audit records")

Container_Boundary(IntegrationWorkerContainer, "Integration Worker Container") {
    Component(NationalLibraryRegistryClient, "National Library Registry Client", "Java with Spring Boot", "Syncs bibliographic metadata.")
    Component(PaymentIntegrationAdapter, "Payment Integration Adapter", "Java with Spring Boot", "Processes fines and fees.")
    Component(DigitalContentSyncComponent, "Digital Content Sync Component", "Java with Spring Boot", "Manages digital entitlement batch synchronization.")
    Component(NotificationEventConsumer, "Notification Event Consumer", "Java with Spring Cloud Stream", "Dispatches payloads to external notification services.")
    Component(IntegrationRouterCircuitBreaker, "Integration Router & Circuit Breaker", "Resilience4j and Java", "Manages outbound traffic resilience.")
    Component(IntegrationDLQHandler, "Integration DLQ Handler", "Java with Spring Boot", "Manages unrecoverable failed messages for auditing.")
}

Rel(MessageBroker, NotificationEventConsumer, "Consumes events", "AMQP")
Rel(NationalLibraryRegistryClient, ExternalSystems, "Outbound calls", "HTTPS/REST")
Rel(PaymentIntegrationAdapter, ExternalSystems, "Outbound calls", "HTTPS/REST")
Rel(DigitalContentSyncComponent, ExternalSystems, "Outbound calls", "HTTPS/REST")
Rel(IntegrationRouterCircuitBreaker, ExternalClients, "Wraps outbound calls with resilience policies", "Java Method Calls")
Rel(NotificationEventConsumer, IntegrationDLQHandler, "Forwards poison-pill messages", "In-memory")
Rel(IntegrationDLQHandler, APIGateway, "Forwards audit records", "HTTPS/REST")

@enduml