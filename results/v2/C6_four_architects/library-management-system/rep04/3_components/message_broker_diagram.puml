@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Message Broker container

System_Ext(Core_Services_Container, "Core Services Container", "External system container")
System_Ext(Async_Worker_Container, "Async Worker Container", "External system container")
System_Ext(Integration_Worker_Container, "Integration Worker Container", "External system container")
System_Ext(Search_Worker_Container, "Search Worker Container", "External system container")
System_Ext(Prometheus, "Prometheus", "External monitoring system")

Container_Boundary(message_broker, "Message Broker") {
    Component(Exchange_Router, "Exchange Router", "Topic Exchange (AMQP)", "Decouples publishers from queues using routing keys via AMQP 0-9-1 over TLS.")
    Component(Queue_Manager, "Queue Manager", "AMQP queues", "Maintains bounded buffers for worker containers and delivers messages using push-based consumption with manual basic.ack.")
    Component(Persistence_Log, "Persistence Log", "Mnesia / Disk storage", "Ensures localized message durability and strict EU-only data residency.")
    Component(Dead_Letter_Exchange_DLX, "Dead Letter Exchange (DLX)", "AMQP isolation mechanism", "Handles poisoned or unroutable messages for error isolation.")
    Component(Cluster_Federation_Sharding_Plugin, "Cluster Federation / Sharding Plugin", "Erlang-based clustering", "Enables clustering across availability zones.")
    Component(Management_Monitoring_Plugin, "Management & Monitoring Plugin", "HTTP/REST endpoint (Port 15672)", "Exposes broker metrics via HTTP/REST for Prometheus scraping.")
    Component(Access_Control_Virtual_Host_Manager, "Access Control & Virtual Host Manager", "AMQP SASL/TLS and x509", "Enforces in-transit encryption and access control.")
}

Rel(Core_Services_Container, Exchange_Router, "Publishes domain events via AMQP 0-9-1 over TLS", "AMQP/TLS")
Rel(Queue_Manager, Async_Worker_Container, "Delivers buffered messages using push-based consumption with manual basic.ack", "AMQP")
Rel(Queue_Manager, Integration_Worker_Container, "Delivers buffered messages using push-based consumption with manual basic.ack", "AMQP")
Rel(Queue_Manager, Search_Worker_Container, "Delivers buffered messages using push-based consumption with manual basic.ack", "AMQP")
Rel(Management_Monitoring_Plugin, Prometheus, "Exposes broker metrics via HTTP/REST for scraping", "HTTP/REST")

@enduml