@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Component(APIGateway, "API Gateway", "API Gateway", "Forwards search queries to the Search API Handler via gRPC.")
Component(SearchWorkerContainer, "Search Worker Container", "Container", "Ingests delta updates into the search index engine via HTTPS/REST.")

Container_Boundary(SearchContainer, "Search Container") {
    Component(SearchAPIHandler, "Search API Handler", "Java, Spring WebFlux", "Enables non-blocking I/O for low-latency request handling and processes search queries.")
    Component(QuerySanitizerMetricsInterceptor, "Query Sanitizer & Metrics Interceptor", "Middleware", "Sanitizes incoming queries and intercepts requests for metrics collection.")
    Component(SearchQueryCache, "Search Query Cache", "Redis", "Caches frequent search queries to reduce index load.")
    Component(SearchIndexEngine, "Search Index Engine", "Elasticsearch 8.x", "Provides high-performance indexing and full-text search with EU node pinning.")
    Component(IndexManagementService, "Index Management Service", "Python sidecar", "Implements sidecar index management operations via loopback HTTPS.")
}

Rel(APIGateway, SearchAPIHandler, "Forwards search queries", "gRPC")
Rel(SearchAPIHandler, SearchQueryCache, "Checks cached result sets", "RESP/TCP")
Rel(SearchQueryCache, SearchIndexEngine, "Fallback query on cache miss", "Transport Client / TCP")
Rel(SearchWorkerContainer, SearchIndexEngine, "Ingests delta updates", "HTTPS/REST")
Rel(IndexManagementService, SearchIndexEngine, "Admin operations", "loopback HTTPS")

@enduml