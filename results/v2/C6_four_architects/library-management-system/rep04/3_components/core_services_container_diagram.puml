@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Services Container container

System_Ext(api_gateway, "API Gateway", "External gateway routing requests.")
System_Ext(postgresql_database, "PostgreSQL Database", "Relational persistence layer.")
System_Ext(redis_caching_layer, "Redis Caching Layer", "High-performance caching layer.")
System_Ext(message_broker, "Message Broker", "Asynchronous messaging system.")
System_Ext(external_payment_gateway, "External Payment Gateway", "External payment processing service.")
System_Ext(national_library_registry, "National Library Registry", "External library registry service.")
System_Ext(notification_service, "Notification Service", "External notification service.")
System_Ext(digital_content_delivery_provider, "Digital Content Delivery Provider", "External digital content provider.")

Container_Boundary(core_services_container, "Core Services Container") {
    Component(catalogue_component, "Catalogue Component", "Spring Data JPA", "Manages physical and digital item metadata.")
    Component(circulation_component, "Circulation Component", "Spring Tx", "Implements checkout, hold, and fine-processing domain logic.")
    Component(integration_client_component, "Integration Client Component", "Spring Cloud OpenFeign/WebClient", "Encapsulates outbound HTTPS calls.")
    Component(compliance_auditing_component, "Compliance & Auditing Component", "Spring AOP", "Enforces regional anonymization and audit logs.")
    Component(event_publisher_component, "Event Publisher Component", "Spring AMQP", "Translates domain events.")
    Component(security_context_component, "Security Context & Session Component", "Spring Security", "Handles request context and JWT validation.")
}

Rel(api_gateway, security_context_component, "Forwards requests with JWT tokens", "gRPC/HTTPS")
Rel(catalogue_component, postgresql_database, "Persists and retrieves relational data", "TCP")
Rel(circulation_component, postgresql_database, "Persists and retrieves relational data", "TCP")
Rel(catalogue_component, redis_caching_layer, "Reads and writes metadata cache", "TCP")
Rel(event_publisher_component, message_broker, "Publishes asynchronous events", "AMQP")
Rel(integration_client_component, external_payment_gateway, "Executes external integrations", "HTTPS")
Rel(integration_client_component, national_library_registry, "Executes external integrations", "HTTPS")
Rel(integration_client_component, notification_service, "Executes external integrations", "HTTPS")
Rel(integration_client_component, digital_content_delivery_provider, "Executes external integrations", "HTTPS")

@enduml