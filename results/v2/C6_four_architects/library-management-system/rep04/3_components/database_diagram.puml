@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(database, "Database") {
    Component(Connection_Pooler_PgBouncer, "Connection Pooler (PgBouncer)", "PgBouncer", "Manages incoming database connections and prevents connection exhaustion.")
    Component(Relational_Storage_Engine, "Relational Storage Engine", "PostgreSQL with pg_trgm extension", "Provides robust relational storage and trigram-based fuzzy matching for search.")
    Component(Logical_Replication_Slot, "Logical Replication Slot", "PostgreSQL internal mechanism", "Streams Write-Ahead Log (WAL) data for Change Data Capture (CDC).")
}

Rel(Connection_Pooler_PgBouncer, Relational_Storage_Engine, "Forwards queued client connections via TCP and Unix Domain Sockets.", "")
Rel(Relational_Storage_Engine, Logical_Replication_Slot, "Streams Write-Ahead Log (WAL) data.", "")
@enduml