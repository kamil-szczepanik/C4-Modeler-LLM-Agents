@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application container

Container_Boundary(web_application, "Web Application") {
    Component(Patron Portal SPA, "Patron Portal SPA", "React, TypeScript", "Client-side single page application for public library patrons.")
    Component(Staff Portal SPA, "Staff Portal SPA", "React, TypeScript", "Client-side single page application for library staff workflows.")
    Component(API Client Service, "API Client Service", "Axios/Fetch wrapper", "Handles HTTP requests and API communication.")
    Component(State Management Store, "State Management Store", "Zustand/Redux Toolkit", "Manages client-side state and caching.")
    Component(Session & Localization Manager, "Session & Localization Manager", "JavaScript/Cookie utility", "Validates sessions and applies EU locales.")
    Component(Error Boundary & Telemetry Reporter, "Error Boundary & Telemetry Reporter", "Sentry/Custom JS", "Catches runtime exceptions and forwards client telemetry.")
    Component(API Gateway, "API Gateway", "NGINX/Envoy", "Manages API routing, ingress security, and rate limiting.")
    Component(Routing & Reverse Proxy Engine, "Routing & Reverse Proxy Engine", "Envoy Core", "Routes incoming API requests.")
    Component(Authentication & Authorization Filter, "Authentication & Authorization Filter", "JWT/OAuth2 module", "Inspects security tokens.")
    Component(Rate Limiter, "Rate Limiter", "Token Bucket algorithm", "Protects downstream services using rate limiting.")
}

Rel(Patron Portal SPA, API Client Service, "Dispatches requests", "In-Process")
Rel(Staff Portal SPA, API Client Service, "Dispatches requests", "In-Process")
Rel(Patron Portal SPA, Session & Localization Manager, "Validates session and applies EU locales", "In-Process")
Rel(Staff Portal SPA, Session & Localization Manager, "Validates session and applies EU locales", "In-Process")
Rel(Patron Portal SPA, Error Boundary & Telemetry Reporter, "Catches runtime exceptions", "In-Process")
Rel(Staff Portal SPA, Error Boundary & Telemetry Reporter, "Catches runtime exceptions", "In-Process")
Rel(API Client Service, API Gateway, "Sends API requests", "HTTPS/REST/GraphQL")
Rel(Error Boundary & Telemetry Reporter, API Gateway, "Forwards client telemetry", "HTTPS/REST")
Rel(web_application, Routing & Reverse Proxy Engine, "Sends API requests", "HTTPS/REST/GraphQL")
Rel(Routing & Reverse Proxy Engine, Authentication & Authorization Filter, "Inspects tokens", "In-Process")

@enduml