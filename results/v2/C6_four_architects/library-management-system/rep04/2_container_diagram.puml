@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(Patrons_and_Staff, "Patrons and Staff", "End-users accessing web interfaces to browse catalogues, manage circulation, and utilize self-service portals.")

System_Ext(Identity_Provider, "Identity Provider", "External system for authentication and identity management.")
System_Ext(Payment_Gateway, "Payment Gateway", "External system for processing payments and fines.")
System_Ext(National_Library_Registry, "National Library Registry", "External registry for bibliographic metadata and ISBN lookups.")
System_Ext(Notification_Service, "Notification Service", "External provider for sending alerts and notifications.")
System_Ext(Digital_Content_Delivery_Provider, "Digital Content Delivery Provider", "External system for fulfilling digital assets.")

System_Boundary(Library_Management_System, "Library Management System") {
    Container(Web_Application, "Web Application", "React, CDN", "Provides static patron and staff portals.")
    Container(API_Gateway, "API Gateway", "NGINX/Envoy", "Manages routing, ingress, and reverse proxying.")
    Container(Core_Services_Container, "Core Services Container", "Java, Spring Boot", "Handles transactional domain logic and circulation.")
    Container(Search_Container, "Search Container", "Elasticsearch", "Provides high-performance search capabilities.")
    ContainerDb(Database, "Database", "PostgreSQL", "Stores EU-resident relational data.")
    ContainerDb(Caching_Layer, "Caching Layer", "Redis", "Provides high-speed metadata caching.")
    Container(Async_Worker_Container, "Async Worker Container", "Background Workers", "Handles asynchronous background jobs.")
    Container(Integration_Worker_Container, "Integration Worker Container", "Integration Workers", "Handles external system integrations.")
    Container(Search_Worker_Container, "Search Worker Container", "Debezium/CDC", "Synchronizes database changes to search via Change Data Capture.")
    Container(Message_Broker, "Message Broker", "RabbitMQ", "Facilitates AMQP event streaming between services and workers.")
}

Rel(Patrons_and_Staff, Web_Application, "Accesses portals and interacts with the system", "HTTPS")
Rel(Web_Application, API_Gateway, "Sends API requests", "HTTPS/REST/GraphQL")
Rel(API_Gateway, Core_Services_Container, "Routes requests to business logic", "gRPC/HTTPS")
Rel(API_Gateway, Search_Container, "Queries search index", "gRPC/HTTPS")
Rel(Core_Services_Container, Database, "Reads and writes relational data", "TCP")
Rel(Core_Services_Container, Caching_Layer, "Reads and writes metadata cache", "TCP")
Rel(Core_Services_Container, Message_Broker, "Publishes asynchronous events", "AMQP")
Rel(Message_Broker, Async_Worker_Container, "Consumes background events", "AMQP")
Rel(Message_Broker, Integration_Worker_Container, "Consumes integration events", "AMQP")
Rel(Message_Broker, Search_Worker_Container, "Consumes search sync events", "AMQP")
Rel(Search_Worker_Container, Database, "Reads database changes via CDC", "PostgreSQL CDC")
Rel(Search_Worker_Container, Search_Container, "Indexes search data", "HTTPS/REST")
Rel(Core_Services_Container, Identity_Provider, "Authenticates users", "HTTPS")
Rel(Core_Services_Container, Payment_Gateway, "Processes fine collections", "HTTPS")
Rel(Core_Services_Container, National_Library_Registry, "Looks up metadata", "HTTPS")
Rel(Core_Services_Container, Notification_Service, "Sends notifications", "HTTPS")
Rel(Core_Services_Container, Digital_Content_Delivery_Provider, "Delivers digital content", "HTTPS")

@enduml