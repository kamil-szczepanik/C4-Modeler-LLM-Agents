@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("api_gateway", "API Gateway") {
    Component(ssl_tls, "SSL/TLS Termination & Reverse Proxy", "NGINX", "Edge termination, reverse proxy, and initial request buffering.")
    Component(routing_filter, "Routing Filter Component", "Spring Cloud Gateway", "Dynamic routing and filter-based extensibility.")
    Component(auth, "Authentication & Authorization Component", "Spring Security / OAuth2", "Token validation for users.")
    Component(rate_limiting, "Rate Limiting & Throttling Component", "Redis-backed", "Distributed rate-limiting and throttling.")
    Component(telemetry, "Telemetry & Request Tracing Component", "Micrometer / OpenTelemetry", "Telemetry and distributed tracing.")
    Component(circuit_breaker, "Circuit Breaker & Fallback Component", "Resilience4j", "Circuit breaking and fallback protection.")
    Component(request_validation, "Request Validation Component", "Spring Validation", "Validates incoming requests.")
    Component(caching, "Caching Component", "Spring Cache", "Response caching supporting low latency.")
}

System_Ext(web_app, "Web Application", "Web application serving users.")
System_Ext(core_domain, "Core Domain Service", "Core domain service.")
System_Ext(search_service, "Search Service", "Search service.")
System_Ext(integration_service, "Integration Service", "Integration service.")
System_Ext(redis, "Redis", "Redis data store.")

Rel(web_app, ssl_tls, "Sends encrypted client traffic", "HTTPS")
Rel(web_app, auth, "Authenticates users", "HTTPS / OAuth2")
Rel(ssl_tls, routing_filter, "Forwards decrypted traffic", "HTTP/2")
Rel(routing_filter, core_domain, "Forwards circulation requests", "gRPC over mTLS")
Rel(routing_filter, search_service, "Forwards search queries", "gRPC over mTLS")
Rel(circuit_breaker, integration_service, "Forwards third-party and legacy requests", "gRPC over mTLS")
Rel(caching, redis, "Reads/writes cache entries", "RESP / TCP")

@enduml