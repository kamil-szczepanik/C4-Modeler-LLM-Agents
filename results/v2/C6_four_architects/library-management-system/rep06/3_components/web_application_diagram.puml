@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(web_application, "Web Application") {
    Component(RouterComponent, "Router Component", "react-router-dom", "Handles client-side routing within the SPA.")
    Component(AuthStateStoreComponent, "Auth & State Store Component", "Zustand, OAuth2/OIDC Client", "Manages application state and secure sessions.")
    Component(UIComponentLibrary, "UI Component Library", "Tailwind CSS, Radix UI", "Delivers accessible, responsive design elements.")
    Component(APIClientComponent, "API Client Component", "Axios", "Handles HTTP communication with the API Gateway.")
    Component(SearchCatalogViewComponent, "Search & Catalog View Component", "React, TypeScript", "Optimized for performance and executes paginated queries.")
    Component(LocalizationComponent, "Localization Component", "react-i18next", "Provides multi-language support.")
    Component(ErrorBoundaryComponent, "Error Boundary Component", "React Error Boundary", "Handles faults and error catching in the UI.")
}

Rel(RouterComponent, APIClientComponent, "Fetches and renders data", "Internal TS Function Call")
Rel(UIComponentLibrary, APIClientComponent, "Fetches and renders data", "Internal TS Function Call")
Rel(SearchCatalogViewComponent, APIClientComponent, "Executes paginated queries", "Internal TS Function Call")

@enduml