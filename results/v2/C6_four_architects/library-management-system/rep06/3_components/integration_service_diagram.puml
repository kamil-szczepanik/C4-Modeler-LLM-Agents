@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Service container

Container_Boundary(integration_service, "Integration Service") {
    Component(router, "Integration Router / Controller", "Express component", "Handles internal REST endpoints for the Core Domain Service.")
    Component(payment_adapter, "Payment Gateway Adapter", "TypeScript component", "Communicates with the external payment gateway.")
    Component(ils_worker, "ILS Sync Worker", "TypeScript component", "Handles legacy ILS data synchronization.")
    Component(webhook_handler, "Webhook Handler", "Express component", "Handles payment asynchronous callbacks.")
    Component(mapper, "Data Mapper & Transformer", "TypeScript utility component", "Performs schema translations.")
    Component(circuit_breaker, "Circuit Breaker & Retry Manager", "TypeScript component", "Provides downstream resilience.")
    Component(audit_logger, "Audit & Compliance Logger", "TypeScript component", "Provides GDPR-compliant tracking.")
}

System(core_domain, "Core Domain Service", "Internal upstream container", "Upstream container interacting with the integration service.")
System_Ext(rabbitmq, "RabbitMQ", "Message broker container", "Asynchronous event messaging for ILS synchronization.")
System_Ext(external_payment, "External Payment Gateway", "External system", "External system for payment communication.")
System_Ext(legacy_ils, "Legacy ILS", "External system", "External legacy integrated library system.")
System_Ext(postgresql, "PostgreSQL", "Database container", "Local persistence for EU-compliant audit logs.")

Rel(core_domain, router, "REST / HTTPS")
Rel(ils_worker, rabbitmq, "AMQP")
Rel(external_payment, webhook_handler, "HTTPS / Webhook")
Rel(payment_adapter, mapper, "In-Memory Function Call")
Rel(ils_worker, mapper, "In-Memory Function Call")
Rel(payment_adapter, circuit_breaker, "In-Memory Function Call")
Rel(ils_worker, circuit_breaker, "In-Memory Function Call")
Rel(circuit_breaker, external_payment, "HTTPS")
Rel(circuit_breaker, legacy_ils, "HTTPS")
Rel(mapper, audit_logger, "In-Memory Function Call")
Rel(audit_logger, postgresql, "SQL / TCP")

@enduml