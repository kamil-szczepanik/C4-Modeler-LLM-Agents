@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Elasticsearch container

System_Ext(Search_Service, "Search Service", "External search service interacting with Elasticsearch")

Container_Boundary(Elasticsearch, "Elasticsearch") {
    Component(Search_REST_API_Endpoint, "Search REST API Endpoint", "HTTP/REST", "Exposes HTTP/REST endpoints for executing search queries.")
    Component(Query_Parsing___Analysis_Engine, "Query Parsing & Analysis Engine", "In-Process", "Parses and analyzes incoming search queries.")
    Component(Distributed_Index___Shard_Manager, "Distributed Index & Shard Manager", "In-Process", "Manages distributed indices and shard allocation.")
    Component(Caches___Segment_Buffer, "Caches & Segment Buffer", "In-Memory", "Caches search results and buffers index segments for performance.")
    Component(Cluster_Coordination___Replication_Manager, "Cluster Coordination & Replication Manager", "TCP", "Coordinates cluster state and manages data replication.")
    Component(Node_Transport_Layer, "Node Transport Layer", "Elasticsearch Transport Protocol", "Handles transport-layer communication between nodes.")
    Component(Lucene_Storage_Engine, "Lucene Storage Engine", "Low-level indexing / Apache Lucene", "Provides low-level indexing and storage operations.")
}

Rel(Search_Service, Search_REST_API_Endpoint, "HTTP/JSON")
Rel(Search_REST_API_Endpoint, Query_Parsing___Analysis_Engine, "In-Process")
Rel(Query_Parsing___Analysis_Engine, Caches___Segment_Buffer, "In-Process")
Rel(Query_Parsing___Analysis_Engine, Distributed_Index___Shard_Manager, "In-Process")
Rel(Distributed_Index___Shard_Manager, Node_Transport_Layer, "TCP")
Rel(Distributed_Index___Shard_Manager, Cluster_Coordination___Replication_Manager, "TCP")
Rel(Cluster_Coordination___Replication_Manager, Distributed_Index___Shard_Manager, "TCP")
Rel(Caches___Segment_Buffer, Lucene_Storage_Engine, "In-Process/JNI")
Rel(Distributed_Index___Shard_Manager, Lucene_Storage_Engine, "In-Process/JNI")
Rel(Lucene_Storage_Engine, Search_REST_API_Endpoint, "In-Process")

@enduml