@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Domain Service container

System_Ext(api_gateway, "API Gateway", "External API Gateway")
System_Ext(postgresql, "PostgreSQL", "ACID-compliant relational storage")
System_Ext(redis, "Redis", "Caching layer")
System_Ext(rabbitmq, "RabbitMQ", "Message broker")
System_Ext(monitoring, "Monitoring Infrastructure", "Monitoring and metrics")

Container_Boundary(core_domain_service, "Core Domain Service") {
    Component(catalog_component, "Catalog Component", "Java, Spring Data JPA", "Manages cataloging within the modular monolith architecture.")
    Component(circulation_engine, "Circulation Engine", "Java, Spring", "Manages circulation within the modular monolith architecture.")
    Component(user_management_component, "User Management Component", "Java, Spring Security", "Manages user profiles within the modular monolith architecture.")
    Component(domain_event_publisher_component, "Domain Event Publisher Component", "Java, Spring ApplicationEventPublisher", "Publishes domain events.")
    Component(cache_aside_component, "Cache-Aside Component", "Java, Spring Cache, Redis", "Handles caching layer for performance SLAs.")
    Component(transaction_management_component, "Transaction Management Component", "Java, Spring @Transactional", "Handles transaction management.")
    Component(security_gdpr_context_filter_component, "Security & GDPR Context Filter Component", "Java, Spring Security Filter", "Handles security and GDPR context filtering.")
    Component(domain_model_validators, "Domain Model Validators", "Java, JSR-380", "Validates domain models.")
    Component(health_metrics_actuator_component, "Health & Metrics Actuator Component", "Java, Spring Boot Actuator", "Provides health and metrics monitoring.")
}

Rel(api_gateway, security_gdpr_context_filter_component, "gRPC over mTLS")
Rel(security_gdpr_context_filter_component, catalog_component, "Java Method")
Rel(security_gdpr_context_filter_component, circulation_engine, "Java Method")
Rel(catalog_component, domain_model_validators, "Java Method")
Rel(circulation_engine, domain_model_validators, "Java Method")
Rel(circulation_engine, transaction_management_component, "Java Annotation")
Rel(transaction_management_component, postgresql, "JDBC over TLS 1.3")
Rel(catalog_component, cache_aside_component, "Java Method")
Rel(cache_aside_component, redis, "RESP over TLS 1.3")
Rel(catalog_component, domain_event_publisher_component, "Java Method")
Rel(circulation_engine, domain_event_publisher_component, "Java Method")
Rel(domain_event_publisher_component, rabbitmq, "AMQP over TLS")
Rel(health_metrics_actuator_component, monitoring, "HTTP over TLS")

@enduml