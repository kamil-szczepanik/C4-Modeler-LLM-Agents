@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Core_Domain_Service, "Core Domain Service", "External service interacting with the PostgreSQL database")

Container_Boundary(PostgreSQL, "PostgreSQL") {
    Component(Relation_Engine, "Relation Engine", "PostgreSQL 15", "Handles ACID transactions, B-Tree indexes, and foreign keys.")
    Component(Connection_Pooler, "Connection Pooler", "PgBouncer", "Manages client sessions from the Core Domain Service.")
    Component(Read_Only_Routing_Proxy, "Read-Only Routing Proxy", "HAProxy", "Routes read-heavy queries to streaming replicas.")
    Component(Replication_Manager, "Replication Manager", "Patroni", "Manages EU-region synchronous replication.")
    Component(Backup_Archival_Agent, "Backup & Archival Agent", "pgBackRest", "Handles point-in-time recovery and EU-bound storage.")
    Component(Security_Audit_Subsystem, "Security & Audit Subsystem", "pgAudit", "Logs DDL/DML operations for compliance.")
    Component(Query_Optimizer_Statistics_Engine, "Query Optimizer & Statistics Engine", "PostgreSQL Engine", "Evaluates execution plans with GIN/B-Tree indexes.")
    Component(Extension_Schema, "Extension Schema", "pg_stat_statements", "Tracks execution metrics for performance tuning.")
}

Rel(Core_Domain_Service, Connection_Pooler, "Manages database sessions", "TCP / TLS 1.3")
Rel(Core_Domain_Service, Read_Only_Routing_Proxy, "Submits read-only queries", "TCP / TLS 1.3")
Rel(Connection_Pooler, Relation_Engine, "Forwards write queries", "TCP")
Rel(Relation_Engine, Replication_Manager, "Streams WAL data", "TCP / TLS 1.3")
Rel(Backup_Archival_Agent, Relation_Engine, "Reads WAL archives", "Local Disk / S3 EU-Central bucket")

@enduml