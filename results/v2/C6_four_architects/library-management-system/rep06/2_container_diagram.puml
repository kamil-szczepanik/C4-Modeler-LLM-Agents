@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(Patron, "Patron", "Library user who interacts with the self-service portal to browse, borrow, and manage accounts.")
Person(Librarian, "Librarian", "Library staff member managing circulation, inventory, and patron assistance.")
Person(Library_Administrator, "Library Administrator", "System administrator managing system configurations, users, and overall library policies.")

System_Ext(External_Payment_Gateway, "External Payment Gateway", "External system used to process fines and payments securely.")
System_Ext(Legacy_ILS, "Legacy ILS", "Legacy Integrated Library System used for synchronizing records.")

System_Boundary(Library_Management_System, "Library Management System") {
    Container(Web_Application, "Web Application", "React, TypeScript, CDN", "React/TypeScript SPA hosted on a CDN providing the digital platform for public and academic libraries.")
    Container(API_Gateway, "API Gateway", "Spring Cloud Gateway, NGINX", "Entry point for routing client traffic and securing system access.")
    Container(Core_Domain_Service, "Core Domain Service", "Java, Spring Boot", "Service containing Catalog Management, Circulation Engine, User Management, and Data Access components.")
    Container(Search_Service, "Search Service", "Python, FastAPI", "Service providing high-performance search capabilities and search index queries.")
    Container(Integration_Service, "Integration Service", "Node.js, Express", "Service handling integrations with external payment gateways and legacy ILS.")
    
    ContainerDb(PostgreSQL, "PostgreSQL", "PostgreSQL", "Primary relational database hosted in the EU.")
    ContainerDb(Elasticsearch, "Elasticsearch", "Elasticsearch", "Search index hosted in the EU for high-performance search.")
    ContainerDb(Redis, "Redis", "Redis", "In-memory data store and cache hosted in the EU.")
    Container(RabbitMQ, "RabbitMQ", "RabbitMQ", "Message broker for asynchronous events hosted in the EU.")
}

Rel(Patron, Web_Application, "Interacts with self-service portal", "HTTPS")
Rel(Librarian, Web_Application, "Manages circulation and inventory via portal", "HTTPS")
Rel(Library_Administrator, Web_Application, "Manages system configurations", "HTTPS")

Rel(Web_Application, API_Gateway, "Sends API requests", "HTTPS / JSON")

Rel(API_Gateway, Core_Domain_Service, "Routes domain and circulation requests", "gRPC over mTLS")
Rel(API_Gateway, Search_Service, "Routes search requests", "gRPC over mTLS")

Rel(Core_Domain_Service, PostgreSQL, "Persists relational data", "JDBC over TLS 1.3")
Rel(Core_Domain_Service, Redis, "Caches session and metadata", "RESP over TLS 1.3")
Rel(Core_Domain_Service, RabbitMQ, "Publishes asynchronous events", "AMQP")

Rel(Integration_Service, External_Payment_Gateway, "Processes payments", "HTTPS / AMQP")
Rel(Integration_Service, Legacy_ILS, "Synchronizes legacy data", "HTTPS / AMQP")

@enduml