@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(Patron, "Patron", "Library user who interacts with the self-service portal to browse, borrow, and manage accounts.")
Person(Librarian, "Librarian", "Library staff member managing circulation, inventory, and patron assistance.")
Person(Library_Administrator, "Library Administrator", "System administrator managing system configurations, users, and overall library policies.")

System_Ext(External_Payment_Gateway, "External Payment Gateway", "External system used to process fines and payments securely.")
System_Ext(Digital_Content_Providers, "Digital Content Providers", "External providers used to fetch digital assets and media.")
System_Ext(Notification_Service, "Notification Service", "External service used to dispatch alerts and notifications via EU endpoints.")
System_Ext(Integrated_Library_System_ILS_Legacy_Data_Source, "Integrated Library System (ILS) / Legacy Data Source", "Legacy data source used for synchronizing bibliographic records via Z39.50 or HTTPS.")

System_Boundary(Library_Management_System, "Library Management System") {
    Container(Web_App_Self_Service_Portal, "Web App / Self-Service Portal", "React, Next.js, EU CDN", "React / Next.js frontend hosted on an EU Content Delivery Network (CDN).")
    Container(API_Gateway, "API Gateway", "Kong or Nginx, HTTPS", "Kong or Nginx handling single entry-point routing and UI/API traffic.")
    Container(Core_Backend_Services, "Core Backend Services", "Java 17, Spring Boot, gRPC", "Java 17 / Spring Boot backend handling business logic using gRPC for internal communication.")
    Container(Search_Engine, "Search Engine", "OpenSearch or Elasticsearch", "OpenSearch or Elasticsearch for sub-800ms catalog queries.")
    Container(Async_Worker, "Async Worker", "Apache Kafka or Redis streams", "Apache Kafka or Redis streams for decoupled event-driven indexing.")
    ContainerDb(Operational_Database_Cache, "Operational Database & Cache", "PostgreSQL, Redis, EU-Central", "PostgreSQL (OLTP) and Redis (Cache) deployed in EU-Central.")
}

Rel(Patron, API_Gateway, "Routes UI and API traffic", "HTTPS")
Rel(Librarian, API_Gateway, "Routes UI and API traffic", "HTTPS")
Rel(Library_Administrator, API_Gateway, "Routes UI and API traffic", "HTTPS")
Rel(Web_App_Self_Service_Portal, API_Gateway, "Fetches application data", "HTTPS/REST")
Rel(API_Gateway, External_Payment_Gateway, "Processes fines", "HTTPS/REST")
Rel(API_Gateway, Digital_Content_Providers, "Fetches digital assets", "HTTPS/REST")
Rel(API_Gateway, Notification_Service, "Dispatches alerts via EU endpoints", "HTTPS/REST")
Rel(API_Gateway, Integrated_Library_System_ILS_Legacy_Data_Source, "Synchronizes bibliographic records", "Z39.50 / HTTPS")
Rel(Core_Backend_Services, Search_Engine, "Updates search index via event streams", "TCP/REST")
Rel(Core_Backend_Services, Operational_Database_Cache, "Handles transactional persistence and session caching", "TCP")

@enduml