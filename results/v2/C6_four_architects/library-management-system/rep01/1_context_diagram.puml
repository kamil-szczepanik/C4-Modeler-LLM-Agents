@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patron_Public_Academic, "Patron (Public/Academic)", "End users who access self-service portals to search and borrow library items.")
Person(Librarian_Staff, "Librarian/Staff", "Internal staff who manage catalogue items and circulation processes.")

System(Library_Management_System_LMS, "Library Management System (LMS)", "An enterprise solution for public and academic libraries to catalogue items, manage circulation, and provide self-service portals with strict EU-only data residency and high-performance search capabilities.")

System_Ext(EU_Tenant_Identity_Provider_IdP, "EU-Tenant Identity Provider (IdP)", "External system for authentication and identity management restricted to EU endpoints.")
System_Ext(EU_Hosted_Payment_Gateway, "EU-Hosted Payment Gateway", "External system for processing financial transactions restricted to EU endpoints.")
System_Ext(Notification_Service_Email_SMS, "Notification Service (Email/SMS)", "External system for sending communications and notifications restricted to EU endpoints.")
System_Ext(Digital_Content_Repository___DRM_Provider, "Digital Content Repository / DRM Provider", "External system providing digital content and DRM services restricted to EU endpoints.")

Rel(Patron_Public_Academic, Library_Management_System_LMS, "Accesses portals for self-service and circulation management", "HTTPS (TLS 1.3)")
Rel(Librarian_Staff, Library_Management_System_LMS, "Manages library items and system operations", "HTTPS (TLS 1.3)")
Rel(Library_Management_System_LMS, EU_Tenant_Identity_Provider_IdP, "Authenticates users", "REST/HTTPS (TLS 1.3)")
Rel(Library_Management_System_LMS, EU_Hosted_Payment_Gateway, "Processes payments and fees", "REST/HTTPS (TLS 1.3)")
Rel(Library_Management_System_LMS, Notification_Service_Email_SMS, "Sends notifications to users", "REST/HTTPS (TLS 1.3)")
Rel(Library_Management_System_LMS, Digital_Content_Repository___DRM_Provider, "Retrieves digital content and manages DRM", "REST/HTTPS (TLS 1.3)")

@enduml