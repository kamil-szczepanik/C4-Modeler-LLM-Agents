@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(message_broker, "Message Broker") {
    Component(Kafka_Broker_Engine, "Kafka Broker Engine", "Apache Kafka (KRaft Mode)", "Eliminates ZooKeeper dependencies and handles event-driven decoupled communication.")
    Component(Topic_Manager, "Topic Manager", "Apache Kafka", "Provisions partitioned event logs.")
    Component(Schema_Registry, "Schema Registry", "Confluent Schema Registry", "Enforces payload contracts (Avro/JSON Schema) for backward compatibility.")
    Component(Producer_Consumer_Connection_Manager, "Producer/Consumer Connection Manager", "Apache Kafka", "Manages connections for producers and consumers.")
    Component(Log_Compaction_Storage_Engine, "Log Compaction & Storage Engine", "Apache Kafka", "Persists and flushes event logs to local storage.")
    Component(Partition_Replicas_Manager, "Partition Replicas Manager", "Apache Kafka", "Synchronizes partition state and ISR.")
    Component(Metrics_Health_Exporter, "Metrics & Health Exporter", "Prometheus/HTTP", "Feeds internal broker telemetry and monitors consumer lag.")
    Component(ACL_Authorizer, "ACL Authorizer", "Apache Kafka", "Validates topic-level produce/consume permissions.")
}

Rel(Kafka_Broker_Engine, Topic_Manager, "Provisions partitioned event logs", "TCP")
Rel(Kafka_Broker_Engine, Schema_Registry, "Caches and validates event schemas at runtime", "HTTP/REST")
Rel(Kafka_Broker_Engine, Log_Compaction_Storage_Engine, "Persists and flushes event logs to local storage", "POSIX I/O")
Rel(Kafka_Broker_Engine, Partition_Replicas_Manager, "Synchronizes partition state and ISR", "TCP")
Rel(Kafka_Broker_Engine, Metrics_Health_Exporter, "Feeds internal broker telemetry", "In-memory")
Rel(Producer_Consumer_Connection_Manager, ACL_Authorizer, "Validates topic-level produce/consume permissions", "In-memory")

@enduml