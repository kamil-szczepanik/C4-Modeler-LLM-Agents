@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Domain Service container

System_Ext(api_gateway, "API Gateway", "External API Gateway")
System_Ext(database, "Database", "Persistent relational database")
System_Ext(message_broker, "Message Broker", "Apache Kafka message broker")
System_Ext(k8s_monitor, "Kubernetes Platform Monitor", "Platform monitoring system")

Container_Boundary(core_domain_service, "Core Domain Service") {
    Component(catalog_management_component, "Catalog Management Component", "Spring @Service, Java", "Handles cataloging workflows for physical and digital items.")
    Component(circulation_workflow_component, "Circulation Workflow Component", "Spring @Service, Java", "Manages circulation and borrowing workflows.")
    Component(domain_event_publisher, "Domain Event Publisher", "Spring Event / Kafka Template, Java", "Publishes domain events asynchronously.")
    Component(patron_account_and_policy_engine_component, "Patron Account & Policy Engine Component", "Spring @Service, Java", "Enforces patron account rules and circulation policies.")
    Component(search_integration_facade, "Search Integration Facade", "Spring @Component, Java", "Provides integration interfaces for search indexing.")
    Component(data_governance_and_audit_interceptor, "Data Governance & Audit Interceptor", "Spring @Aspect, Java", "Intercepts operations for GDPR compliance and data residency.")
    Component(domain_health_and_metrics_actuator, "Domain Health & Metrics Actuator", "Spring Boot Actuator, Java", "Exposes internal health probes and metrics.")
}

Rel(api_gateway, catalog_management_component, "REST/TLS (JSON payloads)")
Rel(api_gateway, circulation_workflow_component, "REST/TLS (JSON payloads)")
Rel(catalog_management_component, database, "JDBC over SSL via HikariCP")
Rel(circulation_workflow_component, database, "JDBC over SSL via HikariCP")
Rel(catalog_management_component, search_integration_facade, "Synchronous Spring ApplicationEvent (in-memory)")
Rel(circulation_workflow_component, patron_account_and_policy_engine_component, "In-memory Java method call")
Rel(catalog_management_component, data_governance_and_audit_interceptor, "In-memory AOP method invocation")
Rel(circulation_workflow_component, data_governance_and_audit_interceptor, "In-memory AOP method invocation")
Rel(domain_event_publisher, message_broker, "Apache Kafka (TCP, TLS-encrypted)")
Rel(search_integration_facade, message_broker, "Apache Kafka (TCP, TLS-encrypted)")
Rel(k8s_monitor, domain_health_and_metrics_actuator, "Prometheus scraping / HTTP (TLS)")

@enduml