@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Person(web_app, "Web Application (SPA)", "React, Nginx")
System_Ext(idp, "EU-Tenant Identity Provider (IdP)", "Validates tokens")
System_Ext(core_service, "Core Domain Service", "Spring Boot, Java")
System_Ext(search_service, "Search Service", "OpenSearch")
System_Ext(redis, "Caching Layer (Redis)", "Redis, Caffeine")
System_Ext(monitoring, "EU-Hosted Monitoring Backend", "Metrics and traces destination")

Container_Boundary(api_gateway, "API Gateway") {
    Component(ssl_termination, "SSL/TLS Termination", "Netty", "Handles SSL/TLS termination for secure EU-compliant transport.")
    Component(auth_filter, "Authentication & Authorization Filter", "Spring Security", "Enforces authentication and RBAC validation.")
    Component(routing_filter, "Routing & Load Balancing Filter", "Spring Cloud Gateway, Java", "Powers the API Gateway routing and filtering mechanisms.")
    Component(rate_limiting_filter, "Rate Limiting Filter", "Bucket4j, Redis", "Implements distributed rate limiting for traffic protection.")
    Component(response_caching, "Response Caching Component", "Caffeine, Redis", "Delivers edge response caching for sub-800ms search performance.")
    Component(telemetry_filter, "API Analytics & Telemetry Filter", "OpenTelemetry", "Collects metrics and traces for EU-hosted monitoring.")
}

Rel(web_app, ssl_termination, "Initiates secure connection", "HTTPS/TLS 1.3")
Rel(auth_filter, idp, "Validates tokens", "REST/TLS")
Rel(routing_filter, core_service, "Forwards validated requests", "REST/TLS")
Rel(routing_filter, search_service, "Forwards search queries under 800ms SLA", "REST/TLS")
Rel(rate_limiting_filter, redis, "Reads/writes rate limit counters", "TCP/Redis Protocol")
Rel(response_caching, redis, "Retrieves cached catalogue payloads", "TCP/Redis Protocol")
Rel(telemetry_filter, monitoring, "Exports tracing and metrics", "OTLP/gRPC")

@enduml