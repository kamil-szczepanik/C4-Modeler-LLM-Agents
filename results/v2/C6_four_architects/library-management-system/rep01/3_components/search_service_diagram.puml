@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Search Service container

System_Ext(api_gateway, "API Gateway", "Spring Cloud Gateway, Java")
System_Ext(message_broker, "Message Broker", "Apache Kafka")
System_Ext(opensearch_cluster, "OpenSearch Cluster", "OpenSearch")
System_Ext(opensearch_indices, "OpenSearch Indices", "OpenSearch Indices")

Container_Boundary(search_service, "Search Service") {
    Component(query_parser_router, "Query Parser & Router", "Java", "Parses and routes search requests.")
    Component(tenant_security_context_filter, "Tenant Security Context Filter", "Java", "Validates tenant context for security and compliance.")
    Component(index_synchronization_worker, "Index Synchronization Worker", "Java", "Consumes catalogue events and applies index updates.")
    Component(search_analytics_caching_interceptor, "Search Analytics & Caching Interceptor", "Redis", "Handles caching and analytics for frequent searches and facets.")
    Component(index_lifecycle_manager, "Index Lifecycle Manager", "OpenSearch ISM", "Manages tiering, retention, and EU-compliant backups.")
}

Rel(api_gateway, query_parser_router, "Forwards search requests", "REST/TLS")
Rel(message_broker, index_synchronization_worker, "Consumes catalogue events", "Apache Kafka")
Rel(query_parser_router, search_analytics_caching_interceptor, "Checks cache", "RESP/TCP")
Rel(query_parser_router, tenant_security_context_filter, "Validates tenant context", "In-process")
Rel(tenant_security_context_filter, query_parser_router, "Passes validated context", "In-process")
Rel(query_parser_router, opensearch_cluster, "Executes queries", "OpenSearch REST/HTTPs")
Rel(index_synchronization_worker, opensearch_cluster, "Applies index updates", "OpenSearch REST/HTTPs")
Rel(index_lifecycle_manager, opensearch_indices, "Manages tiering and retention", "OpenSearch REST API")

@enduml