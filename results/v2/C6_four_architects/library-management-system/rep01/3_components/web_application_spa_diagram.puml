@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Web Application (SPA)", "Web Application (SPA)") {
    Component("Router & State Management", "Router & State Management", "React Router, Zustand/Redux Toolkit", "Handles client-side routing and global application state within the single-page application.")
    Component("API Client", "API Client", "Axios, oidc-client-ts", "Manages HTTP requests to the API Gateway and handles OIDC/OAuth2 authentication flows.")
    Component("UI Presentation Layer", "UI Presentation Layer", "React, Nginx", "Renders the user interface components for patrons and librarians while ensuring EU data residency.")
}

System_Ext("API Gateway", "API Gateway", "Spring Cloud Gateway (Java) routing external traffic.")

Rel("UI Presentation Layer", "Router & State Management", "Triggers navigation and state updates", "")
Rel("Router & State Management", "API Client", "Initiates authenticated API calls", "")
Rel("API Client", "API Gateway", "Sends API requests", "HTTPS/REST")
@enduml