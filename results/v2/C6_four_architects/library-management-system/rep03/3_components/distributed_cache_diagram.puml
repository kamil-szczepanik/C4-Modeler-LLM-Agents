@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Distributed Cache container

System_Ext(Core_Domain_Service, "Core Domain Service", "External system interacting with the distributed cache.")
System_Ext(Search_Service, "Search Service", "External system interacting with the distributed cache.")
System_Ext(Prometheus, "Prometheus", "Monitoring system.")

Container_Boundary(distributed_cache, "Distributed Cache") {
    Component(Session_Store_Component, "Session Store Component", "Redis 7.x In-Memory Data Structures", "Provides in-memory session management for transient patron data.")
    Component(Catalog_L2_Cache_Component, "Catalog L2 Cache Component", "Redis 7.x In-Memory Data Structures", "Provides fast catalog lookups and cache consistency for pre-serialized search facets and hot item metadata.")
    Component(Eviction_Expiry_Manager, "Eviction & Expiry Manager", "Redis volatile-lru Engine", "Enforces volatile-lru eviction to satisfy EU-only volatile data storage constraints.")
    Component(Cluster_Topology_Manager_Component, "Cluster Topology Manager Component", "Redis Cluster Mode", "Manages master-replica replication and slot-based redirection.")
    Component(Pub_Sub_Broker_Component, "Pub/Sub Broker Component", "Redis Pub/Sub", "Handles messaging and cache invalidation notifications.")
    Component(Health_Metrics_Exporter_Component, "Health & Metrics Exporter Component", "Redis Exporter Sidecar", "Exposes Prometheus-compatible metrics for monitoring memory fragmentation via HTTP/TLS.")
    Component(Circuit_Breaker_Rate_Limiter_Component, "Circuit Breaker & Rate Limiter Component", "Redis Lua Engine", "Executes atomic check-and-set operations for distributed locking and rate limiting.")
}

Rel(Core_Domain_Service, Session_Store_Component, "Manages sessions, executes cache invalidation, and acquires distributed locks", "RESP3/TCP (TLS 1.3)")
Rel(Search_Service, Catalog_L2_Cache_Component, "Queries pre-serialized search facets and hot item metadata", "RESP3/TCP (TLS 1.3)")
Rel(Prometheus, Health_Metrics_Exporter_Component, "Scrapes system and memory metrics", "HTTP/TLS on port 9121")

@enduml