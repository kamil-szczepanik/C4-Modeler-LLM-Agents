@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(reporting_analytics_service, "Reporting & Analytics Service") {
    Component(ReportOrchestrationEngine, "Report Orchestration Engine", "Python, Celery", "Handles heavy report orchestration workloads and delegates tasks.")
    Component(AnalyticsQueryProcessor, "Analytics Query Processor", "Python, Pandas/SQLAlchemy", "Processes data and handles analytical querying.")
    Component(ExportFormatter, "Export Formatter", "Python, ReportLab/Openpyxl", "Renders PDF and spreadsheet exports.")
    Component(DataIngestionComponent, "Data Ingestion Component", "Python, Faust/Kafka-Python", "Consumes raw events and persists metrics.")
    Component(ApiGateway, "API Gateway", "Nginx, Kong", "Forwards generation requests to the orchestration engine.")
    Component(NotificationEventBus, "Notification & Event Bus", "Apache Kafka", "High-throughput event ingestion bus.")
    Component(Database, "Database", "PostgreSQL", "Read-optimized data store for compliance with EU-only data residency.")
    Component(DistributedCache, "Distributed Cache", "Redis", "Distributed caching and broker protocol implementation.")
    Component(ObjectStorage, "Object Storage", "MinIO, S3-compatible", "Stores large reports ensuring regional data residency compliance.")
}

Rel(ApiGateway, ReportOrchestrationEngine, "Forwards generation requests", "gRPC over TLS")
Rel(ReportOrchestrationEngine, NotificationEventBus, "Consumes domain events", "Kafka Protocol")
Rel(ReportOrchestrationEngine, DistributedCache, "Delegates tasks", "Redis Broker Protocol")
Rel(ReportOrchestrationEngine, ExportFormatter, "Renders exports", "Direct Function Call")
Rel(ReportOrchestrationEngine, AnalyticsQueryProcessor, "Invokes queries", "Python Asyncio")
Rel(AnalyticsQueryProcessor, Database, "Queries analytical views", "SQL over TLS / psycopg2")
Rel(AnalyticsQueryProcessor, DistributedCache, "Caches aggregates", "RESP over TLS")
Rel(DataIngestionComponent, NotificationEventBus, "Consumes raw events", "Kafka Protocol")
Rel(DataIngestionComponent, Database, "Persists metrics", "SQL over TLS")
Rel(DataIngestionComponent, AnalyticsQueryProcessor, "Invalidates cache", "RESP over TLS")
Rel(ExportFormatter, ObjectStorage, "Stores large reports", "HTTPS / AWS S3 API")

@enduml