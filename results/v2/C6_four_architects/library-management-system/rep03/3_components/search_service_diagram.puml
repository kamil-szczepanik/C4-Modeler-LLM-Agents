@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Search Service container

Container_Boundary(search_service, "Search Service") {
    Component(SearchRESTController, "Search REST Controller", "Spring Boot", "Handles search requests via HTTP/REST over TLS.")
    Component(QueryBuilderComponent, "Query Builder Component", "Spring Boot", "Builds and constructs search queries.")
    Component(SearchCircuitBreaker, "Search Circuit Breaker", "Resilience4j", "Provides circuit breaking for graceful degradation under heavy load.")
    Component(ElasticsearchClientWrapper, "Elasticsearch Client Wrapper", "Spring Boot", "Encapsulates communication with the Elasticsearch Engine ensuring sub-800ms responses with EU boundary node pinning.")
    Component(SearchResultRankerPostProcessor, "Search Result Ranker / Post-Processor", "Spring Boot", "Ranks and post-processes search results.")
    Component(IndexSynchronizerConsumer, "Index Synchronizer Consumer", "Spring Boot", "Consumes asynchronous events from the notification and event bus for index synchronization.")
}

Rel(SearchRESTController, QueryBuilderComponent, "In-process Method Call", "")
Rel(QueryBuilderComponent, SearchCircuitBreaker, "In-process Method Call", "")
Rel(SearchCircuitBreaker, ElasticsearchClientWrapper, "In-process Method Call", "")
Rel(ElasticsearchClientWrapper, SearchResultRankerPostProcessor, "In-process Method Call", "")
Rel(SearchResultRankerPostProcessor, SearchRESTController, "In-process Method Call", "")
Rel(IndexSynchronizerConsumer, ElasticsearchClientWrapper, "In-process Method Call", "")

@enduml