@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification & Event Bus container

System_Ext(core_domain_service, "Core Domain Service", "External service interacting with the event bus.")
System_Ext(notification_service, "Notification Service", "External service receiving notifications via connectors.")
System_Ext(database, "Database", "External database storing system data.")
System_Ext(reporting_analytics_service, "Reporting & Analytics Service", "External reporting and analytics service.")

Container_Boundary(notification_event_bus, "Notification & Event Bus") {
    Component(event_router_topic_manager, "Event Router (Topic Manager)", "Apache Kafka Brokers", "Manages event routing and topics across the event bus.")
    Component(event_publisher_gateway, "Event Publisher Gateway", "Kafka Producer Client API (Java/Python)", "Publishes events to the event bus.")
    Component(consumer_dispatcher, "Consumer Dispatcher", "Kafka Consumer Client API", "Dispatches events to consumers.")
    Component(schema_registry, "Schema Registry", "Confluent Schema Registry", "Enforces Avro/JSON Schema contracts to prevent breaking changes.")
    Component(dead_letter_queue_dlq_manager, "Dead Letter Queue (DLQ) Manager", "Kafka DLQ Topics", "Manages dead letter queues for failed message processing.")
    Component(kafka_connect_engine, "Kafka Connect Engine", "Confluent Kafka Connect", "Handles integration with external systems and databases.")
    Component(access_control_tls_terminator, "Access Control & TLS Terminator", "Kafka TLS/SASL Security Layer", "Implements mTLS and SASL/SCRAM for secure internal communication.")
    Component(stream_processing_engine, "Stream Processing Engine", "Apache Kafka Streams", "Processes real-time event transformations locally.")
    Component(event_bus_metrics_exporter, "Event Bus Metrics Exporter", "Prometheus JMX Exporter", "Collects telemetry to meet performance goals.")
}

Rel(core_domain_service, access_control_tls_terminator, "Kafka Wire Protocol over TLS", "TCP/TLS")
Rel(event_publisher_gateway, schema_registry, "HTTP/REST", "HTTP/REST")
Rel(consumer_dispatcher, dead_letter_queue_dlq_manager, "Kafka Wire Protocol", "TCP")
Rel(kafka_connect_engine, notification_service, "HTTPS", "HTTPS")
Rel(kafka_connect_engine, database, "JDBC", "JDBC")
Rel(event_router_topic_manager, stream_processing_engine, "Kafka Wire Protocol", "TCP")
Rel(stream_processing_engine, reporting_analytics_service, "Kafka Wire Protocol", "TCP")
Rel(event_router_topic_manager, event_bus_metrics_exporter, "HTTP/JMX", "HTTP")
Rel(reporting_analytics_service, event_bus_metrics_exporter, "Prometheus Scrape Protocol", "HTTP")

@enduml