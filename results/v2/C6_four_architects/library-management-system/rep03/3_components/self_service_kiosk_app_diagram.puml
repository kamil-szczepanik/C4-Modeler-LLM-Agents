@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Self-Service Kiosk App container

System_Ext(HardwarePeripherals, "Hardware Peripherals", "External hardware devices connected to the kiosk.")
System_Ext(ApiGateway, "API Gateway", "External API Gateway for routing secure requests.")

Container_Boundary(SelfServiceKioskApp, "Self-Service Kiosk App") {
    Component(UIShell, "UI Shell", "Electron, React", "Powers the touch-optimized user interface for the UI Shell.")
    Component(KioskHostBridge, "Kiosk Host Bridge", "C# .NET Core", "Manages the Kiosk Host Bridge for low-level OS and hardware integration.")
    Component(SessionAuthManager, "Session & Auth Manager", "C# .NET Core", "Manages user sessions and authentication requests.")
    Component(OfflineQueueManager, "Offline Queue Manager", "SQLite, ADO.NET", "Provides local on-device transactional buffering for offline resilience.")
    Component(HardwareEventPollerPeripheralMonitor, "Hardware Event Poller / Peripheral Monitor", "C# .NET Core", "Monitors hardware peripherals and raises telemetry and fault alerts.")
}

Rel(UIShell, KioskHostBridge, "Inter-Process Communication", "gRPC over named pipes")
Rel(KioskHostBridge, HardwarePeripherals, "Direct hardware drivers", "USB/Serial, OPOS/UPOS")
Rel(SessionAuthManager, ApiGateway, "Secure API requests", "HTTPS (REST/JSON)")
Rel(SessionAuthManager, OfflineQueueManager, "Persists offline transactions", "ADO.NET / SQLite")
Rel(OfflineQueueManager, ApiGateway, "Background transaction sync", "HTTPS (REST/JSON)")
Rel(HardwareEventPollerPeripheralMonitor, ApiGateway, "Telemetry & fault alerts", "HTTPS (REST/JSON)")

@enduml