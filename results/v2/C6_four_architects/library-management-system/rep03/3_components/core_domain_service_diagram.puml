@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Domain Service container

System_Ext(api_gateway, "API Gateway", "Gateway", "External system routing requests to the Integration Facade.")
System_Ext(postgresql_database, "PostgreSQL Database", "PostgreSQL", "External database system storing core application data.")
System_Ext(elasticsearch_search_service, "Elasticsearch Search Service", "Elasticsearch", "External search service providing high-performance search capabilities.")
System_Ext(distributed_cache, "Distributed Cache", "Redis", "External distributed cache for sub-millisecond circulation validation.")
System_Ext(notification_event_bus, "Notification & Event Bus", "Apache Kafka", "External event bus for asynchronous messaging.")

Container_Boundary(core_domain_service, "Core Domain Service") {
    Component(integration_facade_component, "Integration Facade Component", "Spring @Controller / @GrpcService", "Handles inbound transport from API Gateway using gRPC over TLS.")
    Component(catalog_management_component, "Catalog Management Component", "Spring @Service", "Catalogues library items for public and academic libraries.")
    Component(circulation_lending_engine, "Circulation & Lending Engine", "Spring @Service", "Manages circulation and lending, utilizing distributed cache for sub-millisecond validation.")
    Component(patron_account_manager, "Patron Account Manager", "Spring @Service", "Manages patron accounts.")
    Component(search_integration_component, "Search Integration Component", "Spring @Service", "Integrates with Elasticsearch to meet high-performance search requirements.")
    Component(data_access_layer_component, "Data Access Layer Component", "Spring Data JPA", "Centralized database access enforcing strict EU data residency constraints.")
    Component(event_publisher_consumer_component, "Event Publisher/Consumer Component", "Spring @Component", "Handles asynchronous event publishing and consumption via Apache Kafka.")
}

Rel(api_gateway, integration_facade_component, "gRPC over TLS", "gRPC over TLS")
Rel(integration_facade_component, catalog_management_component, "In-memory Method Calls", "In-memory")
Rel(integration_facade_component, circulation_lending_engine, "In-memory Method Calls", "In-memory")
Rel(integration_facade_component, patron_account_manager, "In-memory Method Calls", "In-memory")
Rel(integration_facade_component, search_integration_component, "In-memory Method Calls", "In-memory")
Rel(catalog_management_component, data_access_layer_component, "In-memory Method Calls", "In-memory")
Rel(circulation_lending_engine, data_access_layer_component, "In-memory Method Calls", "In-memory")
Rel(patron_account_manager, data_access_layer_component, "In-memory Method Calls", "In-memory")
Rel(search_integration_component, data_access_layer_component, "In-memory Method Calls", "In-memory")
Rel(data_access_layer_component, postgresql_database, "JDBC", "JDBC")
Rel(search_integration_component, elasticsearch_search_service, "HTTP/REST over TLS", "HTTP/REST")
Rel(circulation_lending_engine, distributed_cache, "TCP / Spring Data Redis", "TCP")
Rel(event_publisher_consumer_component, notification_event_bus, "Kafka Wire Protocol", "Kafka Protocol")

@enduml