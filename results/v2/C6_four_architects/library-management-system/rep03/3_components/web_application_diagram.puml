@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(web_application, "Web Application") {
    Component(ui_router, "UI Router & View Layer", "React Router and Tailwind CSS", "Renders views and handles navigation for the Single Page Application.")
    Component(state_store, "State & Session Store", "Zustand", "Manages client-side application state and user sessions lightweight.")
    Component(search_controller, "Search & Filter Controller", "React Hook / Local State", "Delegates search input and triggers debounced search.")
    Component(auth_guard, "Auth & Authorization Guard", "React Context / JWT Decoder", "Checks permissions and injects Bearer tokens.")
    Component(api_client, "API Client", "Axios", "Handles outbound REST/JSON communication.")
    Component(telemetry, "Telemetry & Error Boundary", "Sentry SDK / React Error Boundary", "Captures client-side exceptions and forwards logs to EU-hosted endpoints.")
}

System_Ext(monitoring_endpoint, "EU-hosted Monitoring Endpoint", "External EU-hosted monitoring service.")
System_Ext(api_gateway, "API Gateway", "Nginx / Kong API Gateway.")

Rel(ui_router, state_store, "Reads/writes state", "In-memory")
Rel(state_store, api_client, "Triggers data fetching", "In-memory")
Rel(ui_router, search_controller, "Delegates search input", "In-memory")
Rel(search_controller, api_client, "Triggers debounced search", "HTTPS")
Rel(ui_router, auth_guard, "Checks permissions", "In-memory")
Rel(auth_guard, api_client, "Injects Bearer tokens", "In-memory")
Rel(ui_router, telemetry, "Reports exceptions", "In-memory")
Rel(telemetry, monitoring_endpoint, "Forwards logs", "HTTPS")
Rel(api_client, api_gateway, "Makes API requests", "HTTPS (REST/JSON)")
@enduml