@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Database", "Database Container") {
    Component(PgBouncer, "PgBouncer", "PgBouncer / TCP/IP", "Connection pooling layer managing database traffic to prevent exhaustion under peak loads.")
    Component(Primary_PostgreSQL_Instance, "Primary PostgreSQL Instance", "PostgreSQL / TCP/IP", "Handles write workloads and transactional operations with robust ACID compliance.")
    Component(Read_Replica_Instance, "Read Replica Instance", "PostgreSQL / TCP/IP", "Handles read-heavy analytical traffic and receives asynchronous streaming replication.")
    Component(Catalog_Circulation_Schema, "Catalog & Circulation Schema", "PostgreSQL Schema", "Stores items, loans, and patron data.")
    Component(Audit_Reporting_Schema, "Audit & Reporting Schema", "PostgreSQL Schema", "Stores historical data isolated from operational paths.")
    Component(Full_Text_Search_Indexer_Triggers, "Full-Text Search Indexer & Triggers", "Native Indexes / PostgreSQL Triggers / WAL", "Maintains real-time search synchronization via native indexes.")
    Component(EU_Data_Residency_Enforcer, "EU Data Residency Enforcer", "Configuration and Row-Level Security", "Enforces geographic restrictions to ensure strict compliance with EU-only data constraints.")
}

Rel(PgBouncer, Primary_PostgreSQL_Instance, "Routes and pools database connections", "TCP/IP")
Rel(Primary_PostgreSQL_Instance, Read_Replica_Instance, "Executes asynchronous streaming replication", "TCP/IP")
Rel(Catalog_Circulation_Schema, Full_Text_Search_Indexer_Triggers, "Propagates internal events", "PostgreSQL Triggers/WAL")

@enduml