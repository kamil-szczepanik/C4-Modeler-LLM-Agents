@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(LibraryPatron, "Library Patron", "A person who accesses the library portals for self-service.")
Person(Librarian, "Librarian", "A person who manages cataloging and circulation within the system.")

System(LibraryManagementSystem, "Library Management System", "Provides cataloging, circulation, and self-service portals for public and academic libraries, operating entirely within EU-compliant cloud regions.")

System_Ext(IdentityProvider, "Identity Provider", "Handles user authentication.")
System_Ext(PaymentGateway, "Payment Gateway", "Processes fines securely.")
System_Ext(DigitalContentProvider, "Digital Content Provider", "Provides digital assets and content.")
System_Ext(NotificationService, "Notification Service", "Sends reminders and notifications to users.")
System_Ext(NationalLibraryRegistry, "National Library Registry", "Integrates with national library data and records.")
System_Ext(PhysicalAccessControlSystem, "Physical Access Control System", "Controls physical access to library facilities.")

Rel(LibraryPatron, LibraryManagementSystem, "Accesses portals", "HTTPS")
Rel(Librarian, LibraryManagementSystem, "Manages cataloging and circulation", "HTTPS")
Rel(LibraryManagementSystem, IdentityProvider, "Authenticates users", "OIDC/HTTPS")
Rel(LibraryManagementSystem, PaymentGateway, "Processes fines", "REST/TLS")
Rel(LibraryManagementSystem, NotificationService, "Sends reminders", "REST/TLS")

@enduml