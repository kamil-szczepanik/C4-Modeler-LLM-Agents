@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(LibraryPatron, "Library Patron", "A person who accesses the library portals for self-service.")
Person(Librarian, "Librarian", "A person who manages cataloging and circulation within the system.")

System_Ext(IdentityProvider, "Identity Provider", "Handles user authentication.")
System_Ext(PaymentGateway, "Payment Gateway", "Processes fines securely.")
System_Ext(NotificationService, "Notification Service", "Sends reminders and notifications to users.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(WebApplication, "Web Application", "React, TypeScript", "Frontend rendering for responsive web UI served via CDN.")
    Container(SelfServiceKioskApp, "Self-Service Kiosk App", "Electron, C# WPF", "Desktop app providing self-service kiosk capabilities.")
    Container(ApiGateway, "API Gateway", "Nginx, Kong", "Reverse proxy routing and managing incoming traffic.")
    Container(CoreDomainService, "Core Domain Service", "Java, Spring Boot", "Robust backend platform for core business logic.")
    Container(SearchService, "Search Service", "Elasticsearch", "Dedicated search engine ensuring sub-800ms response times.")
    Container(ReportingAnalyticsService, "Reporting & Analytics Service", "Python, FastAPI", "Handles reporting and analytics workloads.")
    ContainerDb(Database, "Database", "PostgreSQL", "Relational storage ensuring ACID compliance within EU boundaries.")
    Container(DistributedCache, "Distributed Cache", "Redis", "In-memory caching for session management and fast catalog lookups.")
    Container(NotificationEventBus, "Notification & Event Bus", "Apache Kafka", "Event broker for decoupled, reliable asynchronous processing.")
    Container(AsyncWorker, "Async Worker", "Python, Celery", "Background worker handling asynchronous tasks.")
}

Rel(LibraryPatron, WebApplication, "Accesses cataloging and circulation features", "HTTPS")
Rel(LibraryPatron, SelfServiceKioskApp, "Uses self-service portals", "HTTPS")
Rel(Librarian, WebApplication, "Manages cataloging and circulation", "HTTPS")
Rel(WebApplication, ApiGateway, "Makes API requests", "HTTPS (REST/JSON)")
Rel(SelfServiceKioskApp, ApiGateway, "Makes API requests", "HTTPS (REST/JSON)")
Rel(ApiGateway, CoreDomainService, "Routes core business requests", "gRPC over TLS")
Rel(ApiGateway, ReportingAnalyticsService, "Routes reporting requests", "gRPC over TLS")
Rel(CoreDomainService, Database, "Persists and queries relational data", "JDBC")
Rel(CoreDomainService, SearchService, "Performs catalog searches", "HTTP/REST over TLS")
Rel(CoreDomainService, DistributedCache, "Caches session and catalog data", "TCP")
Rel(CoreDomainService, NotificationEventBus, "Publishes and consumes events", "Kafka Wire Protocol")
Rel(AsyncWorker, PaymentGateway, "Processes fines and payments", "HTTPS")
Rel(AsyncWorker, NotificationService, "Sends notifications and reminders", "HTTPS")

@enduml