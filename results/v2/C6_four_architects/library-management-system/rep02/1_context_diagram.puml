@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Library_Patron, "Library Patron", "End-user accessing self-service portals to borrow items and manage their account.")
Person(Librarian_Staff, "Librarian / Staff", "Internal user managing cataloging, inventory, and circulation.")

System(Library_Management_System, "Library Management System", "A cloud-native platform for public and academic libraries to catalogue physical and digital items, manage circulation, and provide self-service portals, deployed strictly within EU data centers.")

System_Ext(Stripe_EU, "Stripe EU", "Payment Gateway for processing fines and fees.")
System_Ext(SendGrid_EU, "SendGrid EU", "Notification Service for sending patron emails and alerts.")
System_Ext(EU_Identity_Provider, "EU Identity Provider", "OIDC/Keycloak/Auth0 provider for authentication and authorization.")
System_Ext(National_Library_Registry, "National Library Registry", "External registry for bibliographic data exchange via OAI-PMH.")
System_Ext(Interlibrary_Loan_ILL_Network, "Interlibrary Loan (ILL) Network", "Network for sharing library resources across institutions via ISO 18626.")

Rel(Library_Patron, Library_Management_System, "Accesses self-service portals and manages account", "HTTPS/TLS 1.3")
Rel(Librarian_Staff, Library_Management_System, "Manages cataloging and circulation operations", "HTTPS/TLS 1.3")
Rel(Library_Management_System, Stripe_EU, "Processes payments for fines and fees", "REST/HTTPS")
Rel(Library_Management_System, SendGrid_EU, "Sends notifications and alerts to patrons", "REST/HTTPS")
Rel(Library_Management_System, EU_Identity_Provider, "Authenticates users via OIDC", "OIDC/HTTPS")
Rel(Library_Management_System, National_Library_Registry, "Synchronizes catalog metadata", "OAI-PMH")
Rel(Library_Management_System, Interlibrary_Loan_ILL_Network, "Coordinates interlibrary loans", "ISO 18626/HTTPS")

@enduml