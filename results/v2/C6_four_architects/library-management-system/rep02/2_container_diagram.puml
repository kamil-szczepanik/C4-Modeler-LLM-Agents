@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(LibraryPatron, "Library Patron", "End-user accessing self-service portals to borrow items and manage their account.")
Person(LibrarianStaff, "Librarian / Staff", "Internal user managing cataloging, inventory, and circulation.")

System_Ext(StripeEU, "Stripe EU", "Payment Gateway for processing fines and fees.")
System_Ext(SendGridEU, "SendGrid EU", "Notification Service for sending patron emails and alerts.")
System_Ext(EUIdentityProvider, "EU Identity Provider", "OIDC/Keycloak/Auth0 provider for authentication and authorization.")
System_Ext(NationalLibraryRegistry, "National Library Registry", "External registry for bibliographic data exchange via OAI-PMH.")
System_Ext(InterlibraryLoanILLNetwork, "Interlibrary Loan (ILL) Network", "Network for sharing library resources across institutions via ISO 18626.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(WebApplicationContainer, "Web Application Container", "React/TypeScript, Nginx", "Frontend Single Page Application providing self-service portals and user interfaces.")
    Container(APIGatewayContainer, "API Gateway Container", "Kong/Envoy", "Handles edge routing, SSL termination, and JWT auth validation.")
    Container(CoreServicesContainer, "Core Services Container", "Java/Spring Boot", "Core business logic container for cataloguing and circulation.")
    Container(SearchServiceContainer, "Search Service Container", "Elasticsearch/OpenSearch", "Dedicated search index ensuring R-05 sub-800ms performance.")
    ContainerDb(DatabaseContainer, "Database Container", "PostgreSQL EU region", "Primary transactional store with strict EU data residency enforcement.")
    Container(RedisCacheContainer, "Redis Cache Container", "Redis", "In-memory cache for catalogue metadata acceleration.")
    Container(BackgroundWorkerContainer, "Background Worker Container", "Python/Celery", "Handles asynchronous background tasks.")
    Container(EventBrokerContainer, "Event Broker Container", "Apache Kafka EU-hosted", "Event streaming platform with TLS for decoupled, asynchronous messaging.")
    Container(DigitalAssetStorageContainer, "Digital Asset Storage Container", "MinIO / S3-compatible Object Storage", "EU-hosted binary storage for digital assets (PDFs, e-books).")
}

Rel(LibraryPatron, WebApplicationContainer, "Accesses self-service portals and manages account", "HTTPS/REST and WebSockets")
Rel(LibrarianStaff, WebApplicationContainer, "Manages cataloging and circulation operations", "HTTPS/REST and WebSockets")
Rel(WebApplicationContainer, APIGatewayContainer, "Routes frontend requests to backend services", "HTTPS/REST and WebSockets")
Rel(APIGatewayContainer, CoreServicesContainer, "Forwards validated requests to core business logic", "gRPC")
Rel(CoreServicesContainer, SearchServiceContainer, "Performs event-driven index updates", "Apache Kafka TCP protocol over TLS")
Rel(CoreServicesContainer, DatabaseContainer, "Executes transactional queries with EU data residency", "SQL over TCP")
Rel(CoreServicesContainer, RedisCacheContainer, "Caches catalogue metadata for acceleration", "RESP over TCP")
Rel(CoreServicesContainer, EventBrokerContainer, "Publishes and consumes domain events", "Kafka Protocol over TLS")
Rel(CoreServicesContainer, BackgroundWorkerContainer, "Delegates asynchronous tasks", "AMQP via RabbitMQ")
Rel(CoreServicesContainer, DigitalAssetStorageContainer, "Accesses digital assets using pre-signed URLs", "HTTPS/REST (S3 API)")
Rel(CoreServicesContainer, StripeEU, "Processes payments for fines and fees", "HTTPS/REST")
Rel(CoreServicesContainer, SendGridEU, "Sends notifications and alerts to patrons", "HTTPS/REST")
Rel(CoreServicesContainer, EUIdentityProvider, "Validates authentication and authorization", "HTTPS/REST")
Rel(CoreServicesContainer, NationalLibraryRegistry, "Synchronizes catalog metadata", "HTTPS/REST")
Rel(CoreServicesContainer, InterlibraryLoanILLNetwork, "Coordinates interlibrary loans", "HTTPS/REST")

@enduml