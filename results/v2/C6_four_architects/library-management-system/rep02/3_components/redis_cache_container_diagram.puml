@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Redis Cache Container container

Container(Core_Services_Container, "Core Services Container", "Service Layer", "External container sending queries and invalidation triggers.")

Container_Boundary(Redis_Cache_Container, "Redis Cache Container") {
    Component(In_Memory_Data_Store_Engine_Redis_Core_, "In-Memory Data Store Engine (Redis Core)", "Redis", "Manages key-value and sorted-set structures.")
    Component(Cache_Eviction___Expiry_Manager, "Cache Eviction & Expiry Manager", "Redis Engine", "Enforces TTL policies and LRU eviction algorithms.")
    Component(Persistence___Snapshot_Manager_RDB_AOF_, "Persistence & Snapshot Manager (RDB/AOF)", "RDB/AOF", "Handles point-in-time data durability.")
    Component(TLS_Termination___Security_Manager, "TLS Termination & Security Manager", "TLS/TCP", "Secures transport-layer encryption and authentication.")
    Component(Pub_Sub_Messaging_Module, "Pub/Sub Messaging Module", "Redis Pub/Sub", "Manages lightweight event channels for cache invalidation.")
    Component(Replication___High_Availability_Manager, "Replication & High Availability Manager", "Redis Sentinel/Clustering", "Handles master-replica synchronization and failover.")
}

Rel(Core_Services_Container, TLS_Termination___Security_Manager, "Securely transmits cache queries", "RESP over TLS/TCP")
Rel(Core_Services_Container, Pub_Sub_Messaging_Module, "Publishes and subscribes to cache invalidation triggers", "RESP over TLS/TCP")
Rel(Cache_Eviction___Expiry_Manager, In_Memory_Data_Store_Engine_Redis_Core_, "Clears expired cache entries", "Internal")
Rel(Replication___High_Availability_Manager, In_Memory_Data_Store_Engine_Redis_Core_, "Synchronizes state between instances", "RESP replication stream")

@enduml