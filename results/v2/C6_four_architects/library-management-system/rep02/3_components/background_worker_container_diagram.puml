@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Background Worker Container container

System_Ext(Core_Services_Container, "Core Services Container", "External core services container")
System_Ext(SendGrid_EU, "SendGrid EU", "External email and push notification service")
System_Ext(OpenSearch_PostgreSQL_EU, "OpenSearch & PostgreSQL EU", "External search engine and database")
System_Ext(National_Library_Registry_ILL_Network, "National Library Registry & ILL Network", "External library network and registry")
System_Ext(Digital_Asset_Storage_Container, "Digital Asset Storage Container", "External S3-compatible storage")
System_Ext(Redis_Cache_Container, "Redis Cache Container", "External Redis cache")

Container_Boundary(Background_Worker_Container, "Background Worker Container") {
    Component(Task_Router, "Task Router", "Python / Celery Task Dispatcher", "Routes messages from the Event Broker.")
    Component(Notification_Processor, "Notification Processor", "Python / Celery", "Handles asynchronous dispatch of emails and push alerts.")
    Component(Catalog_Synchronization_Engine, "Catalog Synchronization Engine", "Python / Celery", "Manages batch updates to search and database containers.")
    Component(ILL_Registry_Integrator, "ILL & Registry Integrator", "Python / Celery", "Executes scheduled polling with external library systems.")
    Component(Data_Purge_Archival_Worker, "Data Purge & Archival Worker", "Python / Celery", "Executes scheduled maintenance and lifecycle tasks.")
    Component(Task_Telemetry_DLQ_Handler, "Task Telemetry & DLQ Handler", "Python / Celery / Prometheus Python Client", "Manages failed jobs, Dead Letter Queues, and Prometheus metrics.")
}

Rel(Core_Services_Container, Task_Router, "Dispatches async jobs", "AMQP / Celery protocol via Apache Kafka EU-hosted")
Rel(Notification_Processor, SendGrid_EU, "Dispatches notifications", "HTTPS REST API")
Rel(Catalog_Synchronization_Engine, OpenSearch_PostgreSQL_EU, "Bulk indexing and state reconciliation", "REST/Transport TCP and PostgreSQL wire protocol over TLS")
Rel(ILL_Registry_Integrator, National_Library_Registry_ILL_Network, "Data synchronization", "HTTPS")
Rel(Data_Purge_Archival_Worker, Digital_Asset_Storage_Container, "Offloads expired media", "S3 API over HTTPS")
Rel(Task_Telemetry_DLQ_Handler, Redis_Cache_Container, "Persists retry states", "Redis Protocol over TLS")

@enduml