@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Services Container container

System_Ext(api_gateway, "API Gateway Container", "API Gateway")
System_Ext(database, "Database Container", "PostgreSQL EU region")
System_Ext(redis_cache, "Redis Cache Container", "Redis caching layer")
System_Ext(search_service, "Search Service Container", "Elasticsearch / OpenSearch")
System_Ext(event_broker, "Event Broker Container", "Apache Kafka EU-hosted")
System_Ext(digital_asset_storage, "Digital Asset Storage Container", "Digital Asset Storage")
System_Ext(stripe_eu, "Stripe EU", "Stripe EU payment gateway")
System_Ext(sendgrid_eu, "SendGrid EU", "SendGrid EU notification service")

Container_Boundary(core_services_container, "Core Services Container") {
    Component(CatalogueComponent, "CatalogueComponent", "Spring Data JPA", "Managing physical and digital items (R-01).")
    Component(CirculationComponent, "CirculationComponent", "Java / Spring Boot", "Handling lending and circulation workflows.")
    Component(SearchSyncComponent, "SearchSyncComponent", "Spring Event Listener", "Synchronizing search indexes.")
    Component(CacheManagerComponent, "CacheManagerComponent", "Spring Data Redis", "Spring Data Redis component for metadata caching.")
    Component(DigitalAssetComponent, "DigitalAssetComponent", "Java / Spring Boot", "Managing digital asset references and storage URLs.")
    Component(IdentityAdapter, "IdentityAdapter", "Spring Security OAuth2 Client", "JWT validation.")
    Component(PaymentAdapter, "PaymentAdapter", "Spring Cloud OpenFeign", "Stripe EU integration for processing fines.")
    Component(NotificationAdapter, "NotificationAdapter", "Java / Spring Boot", "Adapter for SendGrid EU notifications.")
    Component(IllNetworkAdapter, "IllNetworkAdapter", "Spring RestClient", "Interlibrary Loan Network integration.")
}

Rel(api_gateway, IdentityAdapter, "Forwards requests with bearer tokens", "gRPC")
Rel(api_gateway, CatalogueComponent, "Forwards validated requests", "gRPC")
Rel(CatalogueComponent, database, "Executes queries", "SQL over TCP")
Rel(CatalogueComponent, CacheManagerComponent, "Reads/writes cache", "RESP over TCP")
Rel(CacheManagerComponent, redis_cache, "Executes caching commands", "RESP over TCP")
Rel(SearchSyncComponent, search_service, "Updates indexes", "HTTP/REST over TLS")
Rel(CatalogueComponent, event_broker, "Publishes domain events", "Kafka Protocol over TLS")
Rel(DigitalAssetComponent, digital_asset_storage, "Requests pre-signed URLs", "HTTPS/REST S3 API")
Rel(PaymentAdapter, stripe_eu, "Processes fines", "HTTPS/REST")
Rel(NotificationAdapter, sendgrid_eu, "Sends alerts", "HTTPS/REST")
Rel(CirculationComponent, IllNetworkAdapter, "Coordinates loans", "HTTPS/REST")

@enduml