@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(API_Gateway_Container, "API Gateway Container", "Kong/Envoy", "API Gateway handling requests and frames via HTTPS/REST and WebSockets.")

Container_Boundary(Web_Application_Container, "Web Application Container") {
    Component(Router_Component, "Router Component", "React Router", "Manages application routing and enforces route guards.")
    Component(State_Management_Component, "State Management Component", "Redux Toolkit / React Query", "Manages server-state caching and local application state.")
    Component(API_Client_Component, "API Client Component", "Axios", "Handles HTTP requests and injects Bearer tokens.")
    Component(UI_Component_Library, "UI Component Library", "Tailwind CSS / Radix UI", "Provides accessible design system components and renders views.")
    Component(Authentication___Session_Component, "Authentication & Session Component", "OIDC/OAuth2 Client", "Manages secure user authentication and JWT session tokens.")
    Component(Localization__i18n__Component, "Localization (i18n) Component", "JavaScript/TypeScript", "Provides internationalization and localization support.")
    Component(Error_Boundary___Telemetry_Component, "Error Boundary & Telemetry Component", "JavaScript/TypeScript", "Handles application error boundaries and telemetry tracking.")
}

Rel(Router_Component, UI_Component_Library, "Renders views", "TypeScript/React props")
Rel(Router_Component, Authentication___Session_Component, "Enforces route guards", "TypeScript callbacks")
Rel(State_Management_Component, API_Client_Component, "Synchronizes server state", "TypeScript function calls")
Rel(Authentication___Session_Component, API_Client_Component, "Injects Bearer tokens", "Axios interceptors")
Rel(API_Client_Component, API_Gateway_Container, "Forwards API requests and frames", "HTTPS/REST and WebSockets")
@enduml