@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway Container") {
    Component(Routing_Proxy_Engine, "Routing & Proxy Engine", "Kong Gateway Routing Core", "Handles edge routing, proxying frontend traffic, and forwarding validated requests.")
    Component(Auth_Plugin, "Auth Plugin", "Kong JWT/OAuth2 Plugin", "Validates OAuth2/OIDC tokens and performs JWT revocation checks.")
    Component(Rate_Limiting_Plugin, "Rate Limiting Plugin", "Kong Rate Limiting Plugin", "Performs fast distributed rate-limiting using Redis.")
    Component(Request_Transformation_Plugin, "Request Transformation Plugin", "Kong Request Transformation Plugin", "Modifies incoming and outgoing request payloads and headers.")
    Component(Telemetry_Tracing_Component, "Telemetry & Tracing Component", "OpenTelemetry", "Handles telemetry, distributed tracing, and P99 latency monitoring.")
    Component(IP_Geolocation_Geo_Fencing_Plugin, "IP Geolocation & Geo-Fencing Plugin", "Kong Geo-IP Plugin", "Enforces strict EU-only data residency and geo-fencing policies.")
}

Rel(Routing_Proxy_Engine, Auth_Plugin, "Passes requests for token validation", "")
Rel(Auth_Plugin, Rate_Limiting_Plugin, "Passes authenticated requests for rate limiting", "")
Rel(Rate_Limiting_Plugin, Request_Transformation_Plugin, "Passes rate-limited requests for transformation", "")
Rel(Request_Transformation_Plugin, Routing_Proxy_Engine, "Returns transformed requests for downstream routing", "")
Rel(Routing_Proxy_Engine, Telemetry_Tracing_Component, "Reports telemetry and tracing data", "")
Rel(IP_Geolocation_Geo_Fencing_Plugin, Routing_Proxy_Engine, "Enforces geo-fencing on incoming requests", "")

@enduml