@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container(CoreServicesContainer, "Core Services Container", "Microservice Container", "External core service interacting with the storage container.")

Container_Boundary(DigitalAssetStorageContainer, "Digital Asset Storage Container") {
    Component(ObjectStorageEngine, "Object Storage Engine", "MinIO Server / MinIO Go binary", "Handles distributed disk persistence, erasure coding, and read/write I/O streams.")
    Component(AccessControlPolicyManager, "Access Control & Policy Manager", "MinIO IAM / Open Policy Agent (OPA)", "Enforces bucket policies, IAM, validates permissions, and issues pre-signed URLs.")
    Component(EncryptionService, "Encryption Service", "EU-hosted KMS / PKCS#11 / AES-256", "Enforces AES-256 encryption-at-rest for all digital assets.")
    Component(LifecycleReplicationWorker, "Lifecycle & Replication Worker", "MinIO Lifecycle Management", "Applies retention rules, automated tiering, WORM compliance, and sweeps expired objects.")
    Component(AuditTelemetryLogger, "Audit & Telemetry Logger", "FluentBit / Prometheus", "Captures and emits security events, access logs, audit trails, and performance metrics.")
}

Rel(CoreServicesContainer, AccessControlPolicyManager, "Requests pre-signed URLs and validates permissions", "HTTPS/REST (S3 API)")
Rel(AccessControlPolicyManager, ObjectStorageEngine, "Dispatches authorized read/write I/O streams", "")
Rel(ObjectStorageEngine, EncryptionService, "Enforces AES-256 encryption-at-rest", "EU-hosted KMS / PKCS#11/HTTPS")
Rel(LifecycleReplicationWorker, ObjectStorageEngine, "Applies retention rules and sweeps expired objects", "")
Rel(AccessControlPolicyManager, AuditTelemetryLogger, "Emits security events", "Local IPC / Syslog")
Rel(ObjectStorageEngine, AuditTelemetryLogger, "Reports metrics", "Prometheus metrics scrape")

@enduml