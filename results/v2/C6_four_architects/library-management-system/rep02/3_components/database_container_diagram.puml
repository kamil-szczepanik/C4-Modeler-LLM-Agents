@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database Container container

Container_Boundary(database_container, "Database Container") {
    Component(Relational_Engine, "Relational Engine", "PostgreSQL 16 EU region", "Core relational storage for ACID transactions.")
    Component(PgBouncer, "PgBouncer", "PgBouncer", "Connection pooling to meet <800ms performance target.")
    Component(Data_Residency_Enforcer_RLS, "Data Residency Enforcer (RLS)", "Row-Level Security (RLS)", "Native enforcement of EU-only data compliance.")
    Component(Audit_Logging___Encryption_Manager, "Audit Logging & Encryption Manager", "AES-256 & LUKS", "Data at rest encryption and audit logging.")
    Component(Backup___PITR_Agent, "Backup & PITR Agent", "Storage API / WAL streaming", "Handles backups and point-in-time recovery.")
    Component(Query_Optimization___Monitoring_Subsystem, "Query Optimization & Monitoring Subsystem", "pg_stat_statements", "Query optimization and performance monitoring.")
}

System_Ext(Core_Services_Container, "Core Services Container", "External core services container")

Rel(Core_Services_Container, PgBouncer, "SQL over TCP / TLS 1.3")
Rel(PgBouncer, Relational_Engine, "Local Unix Domain Socket / TCP")
Rel(Relational_Engine, Data_Residency_Enforcer_RLS, "Internal database hooks and policies")
Rel(Relational_Engine, Audit_Logging___Encryption_Manager, "Filesystem API via Internal DB triggers / OS-level encryption (LUKS)")
Rel(Relational_Engine, Backup___PITR_Agent, "Storage API via WAL streaming / Local file system")
Rel(Relational_Engine, Query_Optimization___Monitoring_Subsystem, "Shared Memory via Internal Extension Hooks")

@enduml