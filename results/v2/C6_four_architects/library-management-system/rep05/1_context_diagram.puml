@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Library_Patrons_and_Staff, "Library Patrons and Staff", "Users who interact with the library system via frontend SPA or mobile apps to catalogue items, manage circulation, and use self-service portals.")

System(Library_Management_System, "Library Management System", "A cloud platform for public and academic libraries to catalogue physical and digital items, manage circulation, and provide self-service portals with strict EU-only data residency and sub-800ms search performance SLAs.")

System_Ext(Stripe_EU, "Stripe EU", "External payment gateway used for handling transactions.")
System_Ext(LDAP_SAML_IdP, "LDAP/SAML IdP", "External identity provider for authentication and authorization.")
System_Ext(AWS_S3_EU_Central, "AWS S3 EU-Central", "External cloud storage for securing digital catalog asset storage within EU boundaries.")
System_Ext(University_SIS, "University SIS", "University Student Information System integrating via SFTP/HTTPS.")
System_Ext(Third_Party_Delivery, "Third-Party Delivery", "External delivery service for tracking and handling item logistics.")
System_Ext(RFID_Gates, "RFID Gates", "External hardware gates interacting with the library management system.")

Rel(Library_Patrons_and_Staff, Library_Management_System, "Interacts via Frontend SPA and Mobile App", "HTTPS")
Rel(University_SIS, Library_Management_System, "Syncs student and academic data", "SFTP/HTTPS")
Rel(Library_Management_System, Stripe_EU, "Processes payments", "HTTPS/REST")
Rel(Library_Management_System, AWS_S3_EU_Central, "Stores digital catalog assets securely within EU", "HTTPS/REST")
Rel(Library_Management_System, Third_Party_Delivery, "Manages physical item delivery logistics", "HTTPS/REST")
@enduml