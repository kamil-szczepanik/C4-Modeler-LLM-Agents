@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database container

Container_Ext(core_services_container, "Core Services Container", "Container", "Core application services.")
Container_Ext(search_container, "Search Container", "Container", "Search engine container.")
Container_Ext(file_storage_container, "File Storage Container", "Container", "File storage system.")

Container_Boundary(database, "Database") {
    Component(relational_data_store, "Relational Data Store", "PostgreSQL Managed RDS", "Stores core transactional entities ensuring transactional consistency and ACID compliance.")
    Component(connection_pooler, "Connection Pooler", "PgBouncer", "Manages inbound database connections to prevent connection exhaustion under peak loads.")
    Component(read_replica, "Read Replica", "PostgreSQL Replica", "Handles read-heavy queries and reporting.")
    Component(wal_publisher, "WAL Publisher", "PostgreSQL WAL / Debezium", "Emits transaction logs for Change Data Capture (CDC).")
    Component(backup_snapshot_manager, "Backup & Snapshot Manager", "AWS RDS Automated Backups", "Enforces region-locked recovery and encrypted backups.")
    Component(audit_security_monitor, "Audit & Security Monitor", "pgaudit", "Captures security events and query logs.")
    Component(database_schema_migration_engine, "Database Schema Migration Engine", "Flyway or Liquibase", "Manages version-controlled schema evolution.")
}

Rel(core_services_container, connection_pooler, "JDBC over TLS")
Rel(core_services_container, read_replica, "JDBC over TLS (Read-Only)")
Rel(core_services_container, relational_data_store, "JDBC over TLS (DDL execution)")
Rel(wal_publisher, search_container, "TCP/TLS stream (Debezium CDC)")
Rel(relational_data_store, read_replica, "PostgreSQL Streaming Replication [TCP/TLS]")
Rel(relational_data_store, backup_snapshot_manager, "Internal AWS Storage API over TLS")
Rel(audit_security_monitor, file_storage_container, "HTTPS / S3 API")

@enduml