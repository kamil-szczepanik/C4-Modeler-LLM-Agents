@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(geo_routing, "Geo-Routing & Compliance Filter", "Envoy Component (WebAssembly / Lua)", "Enforces strict EU-only data residency and geo-compliance filtering at the gateway perimeter.")
    Component(auth_filter, "Authentication Filter", "Envoy Component", "Validates user tokens against the identity provider.")
    Component(rate_limiting, "Rate Limiting Filter", "Envoy Component", "Checks rate limit counters against the cache and session store.")
    Component(transformation, "Transformation Filter", "Envoy Component", "Translates incoming JSON requests to gRPC.")
    Component(routing_engine, "Routing & Dispatcher Engine", "Envoy Component (with Circuit Breaker)", "Forwards requests to core services and search containers with built-in circuit breaking.")
}

System_Ext(cache_store, "Cache / Session Store", "Managed AWS Redis", "Handles caching, session storage, and rate-limiting counters.")
System_Ext(core_services, "Core Services Container", "Spring Boot / Java", "Powers backend business logic in the Core Services Container.")
System_Ext(search_container, "Search Container", "Elasticsearch Cluster", "Provides low-latency search capabilities.")

Rel(geo_routing, auth_filter, "Forwards validated, geo-compliant requests", "In-memory")
Rel(rate_limiting, cache_store, "Checks rate limit counters", "RESP over TLS")
Rel(transformation, routing_engine, "Translates JSON to gRPC", "In-memory")
Rel(routing_engine, core_services, "Forwards requests with circuit breaking", "gRPC")
Rel(routing_engine, search_container, "Routes search queries", "gRPC")

@enduml