@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Cache / Session Store container

System_Ext(API_Gateway, "API Gateway", "External API Gateway handling incoming client requests.")
System_Ext(Core_Services_Container, "Core Services Container", "Core business logic and backend services.")

Container_Boundary(Cache_Session_Store, "Cache / Session Store") {
    Component(Session_Store_Component, "Session Store Component", "AWS ElastiCache for Redis 7.x", "Manages active user authentication tokens and TTL-expiring keys.")
    Component(Hot_Data_Cache_Component, "Hot Data Cache Component", "AWS ElastiCache for Redis 7.x with volatile-lru eviction policy", "Caches frequent catalogue queries using a volatile-lru eviction policy.")
    Component(Distributed_Lock_Component, "Distributed Lock Component", "AWS ElastiCache for Redis 7.x", "Coordinates concurrency for circulation checkouts.")
}

Rel(API_Gateway, Session_Store_Component, "Validates active user sessions", "RESP3 over TLS 1.3 with IAM authentication")
Rel(Core_Services_Container, Hot_Data_Cache_Component, "Queries and invalidates cached catalogue data", "RESP3 over TLS 1.3")
Rel(Core_Services_Container, Distributed_Lock_Component, "Acquires and releases concurrency locks", "RESP3 over TLS 1.3")

@enduml