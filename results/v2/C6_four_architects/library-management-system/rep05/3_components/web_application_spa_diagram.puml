@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(web_application_spa, "Web Application (SPA)") {
    Component(router_shell, "Router & Shell Component", "react-router", "Manages application navigation, layout framing, and route-based code splitting.")
    Component(auth_state, "Authentication State Component", "Context API + oidc-client-ts", "Handles user authentication states, OIDC session management, and token storage.")
    Component(catalogue_search_ui, "Catalogue & Search UI Component", "React/TypeScript", "Provides the interface for browsing the library catalogue and executing searches with sub-800ms performance.")
    Component(circulation_self_service, "Circulation & Self-Service Component", "React/TypeScript", "Enables self-service borrowing, returns, and account management for library patrons and staff.")
    Component(state_management, "State Management & Caching Store", "TanStack Query", "Optimizes data fetching, server-state synchronization, and client-side caching to meet performance goals.")
    Component(notification_feedback, "Notification & Feedback Component", "React Toastify", "Renders toast notifications and system feedback messages to users.")
    Component(api_client, "API Client / HTTP Interceptor Component", "Axios", "Centralizes HTTP requests, handles error interception, and injects bearer tokens.")
}

System_Ext(api_gateway, "API Gateway", "Nginx / Envoy")

Rel(api_client, api_gateway, "Sends API requests", "HTTPS/REST")
Rel(auth_state, api_gateway, "Authenticates users", "HTTPS/REST")
Rel(catalogue_search_ui, api_gateway, "Fetches search results and catalogue data", "HTTPS/REST")

@enduml