@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Services Container container

Container_Boundary(core_services_container, "Core Services Container") {
    Component(CatalogueManagementComponent, "Catalogue Management Component", "Spring Bean / Java", "Provides cataloguing functionality for public and academic libraries.")
    Component(CirculationEngineComponent, "Circulation Engine Component", "Spring Bean / Java", "Handles circulation workflows and publishes domain events.")
    Component(SearchOrchestratorComponent, "Search Orchestrator Component", "Spring Bean / Java", "Orchestrates high-performance search queries.")
    Component(AuthenticationAuthorizationComponent, "Authentication/Authorization Component", "Spring Security / Java", "Manages authentication and authorization.")
    Component(NotificationEventDispatcherComponent, "Notification & Event Dispatcher Component", "Spring Event / Java", "Dispatches notifications and internal events.")
    Component(TransactionAuditComponent, "Transaction & Audit Component", "Spring @Transactional / Java", "Ensures atomic operations and audit logging.")
}

Component(SearchContainer, "Search Container", "Elasticsearch", "Executes high-performance queries.")
Component(MessageBroker, "Message Broker", "Managed RabbitMQ", "Handles asynchronous messaging.")
Component(Database, "Database", "PostgreSQL RDS", "Stores transactional data ensuring ACID compliance.")
Component(CacheSessionStore, "Cache / Session Store", "AWS Redis", "Manages transient states and session caching.")

Rel(SearchOrchestratorComponent, SearchContainer, "Executes high-performance queries", "REST over TLS")
Rel(CirculationEngineComponent, MessageBroker, "Publishes domain events", "AMQP/TLS")
Rel(TransactionAuditComponent, Database, "Commits atomic operations", "JDBC over TLS")
Rel(CirculationEngineComponent, CacheSessionStore, "Manages transient states", "RESP over TLS")
Rel(CatalogueManagementComponent, CirculationEngineComponent, "Communicate", "In-process Method Calls")

@enduml