@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Search Container container

Component(API Gateway, "API Gateway", "API Gateway", "External entry point routing search traffic.")
Component(Message Broker, "Message Broker", "Message Broker", "Event broker delivering asynchronous events.")
Component(Cache / Session Store, "Cache / Session Store", "Redis Protocol", "Low-latency caching layer for fast fallback search snippets.")

Container_Boundary(search_container, "Search Container") {
    Component(Query Service Component, "Query Service Component", "Java / Spring Boot", "Handles incoming search requests.")
    Component(Schema Validation & Sanitization Component, "Schema Validation & Sanitization Component", "Java / OWASP Validator", "Protects against query injection.")
    Component(Encryption & Compliance Component, "Encryption & Compliance Component", "Java / Spring Security", "Enforcing TLS 1.3 and data masking.")
    Component(Circuit Breaker & Fallback Component, "Circuit Breaker & Fallback Component", "Resilience4j", "Handling latency spikes and fallback results.")
    Component(Indexing Worker Component, "Indexing Worker Component", "Java / custom consumer", "Processing asynchronous updates.")
    Component(Index Lifecycle Management (ILM) Component, "Index Lifecycle Management (ILM) Component", "Elasticsearch ILM", "Managing index rollover and purging.")
    Component(Search Engine Core, "Search Engine Core", "Elasticsearch 8.x", "Distributed cluster deployed across 3 availability zones.")
}

Rel(API Gateway, Query Service Component, "gRPC")
Rel(Message Broker, Indexing Worker Component, "AMQP via Debezium CDC")
Rel(Query Service Component, Cache / Session Store, "Redis Protocol")
Rel(Query Service Component, Search Engine Core, "Transport Protocol / HTTP over TLS 1.3")
Rel(Indexing Worker Component, Search Engine Core, "HTTP/REST over TLS 1.3")
Rel(Search Engine Core, Search Engine Core, "Transport Protocol / TCP 9300")

@enduml