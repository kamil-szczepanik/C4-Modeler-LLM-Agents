@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Service container

Container_Boundary(integration_service, "Integration Service") {
    Component(IntegrationFacadeRouter, "Integration Facade / Router", "NestJS Module with Circuit Breaker & Retry Middleware", "Routes integration tasks and manages circuit breaking and retry logic.")
    Component(PaymentAdapterComponent, "Payment Adapter Component", "NestJS", "Processes payments with external payment systems.")
    Component(SISSyncComponent, "SIS Sync Component", "NestJS", "Syncs patron rosters with university student information systems.")
    Component(WebhookHandlerComponent, "Webhook Handler Component", "NestJS", "Handles incoming webhook events from external systems.")
    Component(IoTGatewayComponent, "IoT Gateway Component", "NestJS", "Receives item scans and communicates with IoT devices.")
    Component(NotificationAdapterComponent, "Notification Adapter Component", "NestJS", "Manages and dispatches external notifications.")
    Component(DeliveryLogisticsAdapterComponent, "Delivery & Logistics Adapter Component", "NestJS", "Coordinates shipments with third-party delivery services.")
}

System_Ext(CoreServicesContainer, "Core Services Container", "Core backend services that delegate integration tasks.")
System_Ext(StripeEU, "Stripe EU", "External payment processing platform.")
System_Ext(UniversitySIS, "University SIS", "External university student information system.")
System_Ext(ThirdPartyDelivery, "Third-Party Delivery", "External delivery and logistics provider.")
System_Ext(RFIDGates, "RFID Gates", "IoT hardware gates for library item scans.")

Rel(CoreServicesContainer, IntegrationFacadeRouter, "Delegates integration tasks", "gRPC")
Rel(IntegrationFacadeRouter, PaymentAdapterComponent, "Dispatches payloads", "In-Memory / Resilience4ts")
Rel(IntegrationFacadeRouter, SISSyncComponent, "Dispatches payloads", "In-Memory / Resilience4ts")
Rel(IntegrationFacadeRouter, WebhookHandlerComponent, "Dispatches payloads", "In-Memory / Resilience4ts")
Rel(IntegrationFacadeRouter, IoTGatewayComponent, "Dispatches payloads", "In-Memory / Resilience4ts")
Rel(IntegrationFacadeRouter, NotificationAdapterComponent, "Dispatches payloads", "In-Memory / Resilience4ts")
Rel(IntegrationFacadeRouter, DeliveryLogisticsAdapterComponent, "Dispatches payloads", "In-Memory / Resilience4ts")
Rel(PaymentAdapterComponent, StripeEU, "Processes payments", "HTTPS/REST")
Rel(SISSyncComponent, UniversitySIS, "Syncs patron rosters", "SFTP/REST")
Rel(IoTGatewayComponent, RFIDGates, "Receives item scans", "MQTT")
Rel(DeliveryLogisticsAdapterComponent, ThirdPartyDelivery, "Coordinates shipments", "HTTPS/REST")

@enduml