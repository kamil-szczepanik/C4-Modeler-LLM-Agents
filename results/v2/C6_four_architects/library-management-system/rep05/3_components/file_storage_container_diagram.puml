@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the File Storage Container container

Container_Boundary(file_storage_container, "File Storage Container") {
    Component(file_controller, "File Controller / API Router", "Spring WebFlux / Java", "Non-blocking reactive streaming of metadata and API routing.")
    Component(presigned_url_generator, "Presigned URL Generator", "Java", "Issues time-limited S3 upload/download tokens.")
    Component(virus_scanner, "Virus & Malware Scanner Service", "ClamAV via FastAPI / Python", "Lightweight wrapper and daemon for secure virus/malware scanning.")
    Component(storage_manager, "Storage Abstraction Manager", "AWS SDK for Java", "Handles AWS S3 encryption-at-rest (AES-256) and IAM integration.")
    Component(audit_logger, "Audit Logging & Access Policy Enforcer", "AWS IAM / CloudTrail", "Validates IAM permissions and EU residency.")
    Component(aws_s3, "AWS S3 EU-Central", "AWS S3 EU-Central-1 Region", "Ensures strict EU-only data residency and quarantine isolation.")
}

Component(integration_service, "Integration Service", "External Service", "Uploads/downloads digital assets and requests secure tokens.")

Rel(integration_service, file_controller, "Uploads/downloads digital assets and requests secure tokens", "HTTPS/REST")
Rel(file_controller, audit_logger, "Validates IAM permissions and EU residency", "In-Memory Java Call")
Rel(file_controller, presigned_url_generator, "Issues time-limited S3 upload/download tokens", "In-Memory")
Rel(presigned_url_generator, aws_s3, "Direct client data transfer", "HTTPS/SigV4")
Rel(file_controller, virus_scanner, "Triggers asynchronous security scan", "Internal gRPC")
Rel(virus_scanner, storage_manager, "Signals clean scan status for quarantine-to-production promotion", "Internal gRPC")
Rel(storage_manager, aws_s3, "Enforces AES-256 encryption-at-rest and bucket restrictions", "HTTPS/SigV4")

@enduml