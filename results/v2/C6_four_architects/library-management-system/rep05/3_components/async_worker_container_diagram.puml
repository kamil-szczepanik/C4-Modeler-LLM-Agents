@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Async Worker Container container

Container_Boundary(async_worker_container, "Async Worker Container") {
    Component(TaskRouterConsumer, "Task Router / Consumer", "Python 3.11, Celery Worker", "Consumes jobs from the message broker and routes them to appropriate workers.")
    Component(NotificationProcessor, "Notification Processor", "Python 3.11, Celery", "Triggers background payments and renewals.")
    Component(ReportBatchProcessor, "Report & Batch Processor", "Python 3.11, Celery", "Executes heavy analytical queries and generates reports.")
    Component(DataPurgeComplianceWorker, "Data Purge & Compliance Worker", "Python 3.11, Celery", "Executes GDPR data anonymisation.")
    Component(IntegrationSyncWorker, "Integration Sync Worker", "Python 3.11, Celery", "Fetches student and faculty updates from external systems.")
    Component(MessageBroker, "Message Broker", "Managed RabbitMQ / Redis", "Message broker and result backend for Celery.")
    Component(Database, "Database", "PostgreSQL Managed RDS EU-Central, SQLAlchemy, asyncpg", "Persists job state, updates statuses, and stores system data.")
    Component(FileStorageContainer, "File Storage Container", "AWS S3 EU-Central", "Stores generated reports and files.")
}

System_Ext(StripeEU, "Stripe EU", "External payment processing system")
System_Ext(UniversitySIS, "University SIS", "External University Student Information System")

Rel(TaskRouterConsumer, MessageBroker, "Consumes jobs", "AMQP/TLS")
Rel(TaskRouterConsumer, Database, "Persists job state and updates statuses", "PostgreSQL/JDBC, EU-Central")
Rel(NotificationProcessor, StripeEU, "Triggers background payments and renewals", "HTTPS/REST, TLS 1.3")
Rel(ReportBatchProcessor, Database, "Executes heavy analytical queries", "PostgreSQL/JDBC, EU-Central")
Rel(ReportBatchProcessor, FileStorageContainer, "Uploads generated reports", "HTTPS/REST, TLS 1.3")
Rel(DataPurgeComplianceWorker, Database, "Executes GDPR data anonymisation", "PostgreSQL/JDBC, EU-Central")
Rel(IntegrationSyncWorker, UniversitySIS, "Fetches student/faculty updates", "HTTPS/REST, TLS 1.3")

@enduml