@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalysts, "Fraud Analysts", "Internal users who access case management to review fraud cases.")
Person(MLEngineers, "ML Engineers", "Engineers who push model and rule updates to the system.")

System_Ext(PaymentGatewayAcquirerSystems, "Payment Gateway / Acquirer Systems", "External actor that sends card-not-present payment authorization requests and receives circuit breaker signals.")
System_Ext(CardNetworksTokenVaults, "Card Networks / Token Vaults", "External system used by the scoring engine to resolve tokens.")
System_Ext(AuditComplianceArchive, "Audit / Compliance Archive", "External storage for tamper-evident 7-year audit logs.")
System_Ext(MLModelRuleRegistry, "ML Model / Rule Registry", "External system storing machine learning models and business rules.")

System(RealTimeFraudScreeningandCaseManagementSystem, "Real-Time Fraud Screening and Case Management System", "Screens card-not-present payment authorizations for fraud in real-time and provides case management for fraud analysts within AWS eu-west-1.")

Rel(PaymentGatewayAcquirerSystems, RealTimeFraudScreeningandCaseManagementSystem, "Sends authorization requests", "gRPC over HTTP/2")
Rel(RealTimeFraudScreeningandCaseManagementSystem, CardNetworksTokenVaults, "Resolves tokens", "Secure API over mTLS")
Rel(RealTimeFraudScreeningandCaseManagementSystem, AuditComplianceArchive, "Streams audit logs asynchronously", "HTTPS / TLS 1.3")
Rel(FraudAnalysts, RealTimeFraudScreeningandCaseManagementSystem, "Accesses case management", "HTTPS")
Rel(MLEngineers, RealTimeFraudScreeningandCaseManagementSystem, "Pushes model and rule updates", "HTTPS / REST API")
Rel(RealTimeFraudScreeningandCaseManagementSystem, PaymentGatewayAcquirerSystems, "Sends circuit breaker signals for fail-open fallback", "gRPC")

@enduml