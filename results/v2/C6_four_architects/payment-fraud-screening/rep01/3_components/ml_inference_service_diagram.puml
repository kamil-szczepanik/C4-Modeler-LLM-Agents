@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("ml_inference_service", "ML Inference Service") {
    Component("grpc_api_handler", "gRPC API Handler", "Python gRPC/Protobuf", "Handles incoming gRPC requests for transaction screening.")
    Component("model_execution_engine", "Model Execution Engine", "Python with ONNX Runtime", "Executes ML model inference with low memory footprint and high speed.")
    Component("feature_preprocessor", "Feature Preprocessor", "Python NumPy/Pandas", "Preprocesses feature vectors for model inference.")
    Component("model_loader", "Model Loader", "Python Boto3", "Fetches updated model binaries from the registry.")
    Component("explainability_component", "Explainability Component", "ONNX-native TreeEnsemble Explainers", "Calculates lightweight tree path attributions.")
    Component("telemetry_audit_emitter", "Telemetry & Audit Emitter", "Python AWS SDK", "Dispatches audit payloads via an async queue.")
}

Rel("grpc_api_handler", "feature_preprocessor", "Passes feature vectors for preprocessing", "")
Rel("feature_preprocessor", "model_execution_engine", "Sends preprocessed data for inference", "")
Rel("model_loader", "model_execution_engine", "Supplies updated model binaries", "")
Rel("model_execution_engine", "explainability_component", "Calculates lightweight tree path attributions", "In-memory Python call")
Rel("model_execution_engine", "telemetry_audit_emitter", "Dispatches audit payload", "Async queue")
@enduml