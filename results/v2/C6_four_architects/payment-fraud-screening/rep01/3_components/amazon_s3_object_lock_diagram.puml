@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Amazon S3 Object Lock", "Amazon S3 Object Lock") {
    Component(AuditStreamProcessor, "Audit Stream Processor", "Go Lambda", "Streams audit logs from DynamoDB and writes signed logs to object storage.")
    Component(ObjectLifecycleManager, "Object Lifecycle Manager", "Go Lambda", "Manages the lifecycle and WORM storage enforcement of compliance logs.")
    Component(AuditQueryAPI, "Audit Query API", "Go Lambda", "Provides endpoints for compliance auditors to query historical decisions.")
    Component(IntegrityVerifier, "Integrity Verifier", "Go Lambda", "Verifies checksums and tamper-evident auditability for compliance.")
}

Rel(AuditStreamProcessor, ObjectLifecycleManager, "Writes signed logs", "AWS SDK / HTTPS")
Rel(IntegrityVerifier, ObjectLifecycleManager, "Verifies checksums", "AWS SDK / HTTPS")

@enduml