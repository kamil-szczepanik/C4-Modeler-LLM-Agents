@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon ElastiCache container

Container_Boundary(amazon_elasticache, "Amazon ElastiCache") {
    Component(Redis Feature Store, "Redis Feature Store", "Redis", "In-memory feature store providing sub-millisecond feature lookups for customer velocity profiles.")
}

System_Ext(Real-Time Scoring Engine, "Real-Time Scoring Engine", "External component or container")

Rel(Redis Feature Store, Real-Time Scoring Engine, "Serves customer velocity profiles", "TCP (RESP), TLS")

@enduml