@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Amazon EventBridge", "Amazon EventBridge") {
    Component("Default Event Bus", "Default Event Bus", "Amazon EventBridge", "Receives and routes system-wide fraud and case events.")
    Component("Fraud Event Rules", "Fraud Event Rules", "EventBridge Rules", "Evaluates and filters incoming events to direct them to appropriate targets.")
    Component("Case Management Target", "Case Management Target", "AWS internal SQS", "Dispatches filtered review events to the case management backend.")
    Component("Audit Archive Target", "Audit Archive Target", "Kinesis Data Firehose / HTTPS", "Streams decision logs for tamper-evident audit archiving.")
    Component("Dead-Letter Queue", "Dead-Letter Queue", "Amazon SQS DLQ", "Captures and stores undeliverable or failed event messages for troubleshooting.")
}

Rel("Default Event Bus", "Fraud Event Rules", "Evaluates events against")
Rel("Fraud Event Rules", "Case Management Target", "Dispatches filtered review events", "AWS internal SQS")
Rel("Fraud Event Rules", "Audit Archive Target", "Streams decision logs", "Kinesis Data Firehose / HTTPS")
Rel("Default Event Bus", "Dead-Letter Queue", "Routes failed deliveries to")
@enduml