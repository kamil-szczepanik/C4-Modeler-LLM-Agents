@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon DynamoDB container

System_Ext(RealTimeScoringEngine, "Real-Time Scoring Engine", "External system interacting with the transaction table.")
System_Ext(CaseManagementBackend, "Case Management Backend", "External system managing analyst workflows.")
System_Ext(AmazonS3ObjectLock, "Amazon S3 Object Lock", "External storage for tamper-evident audit logs.")

Container_Boundary(AmazonDynamoDB, "Amazon DynamoDB") {
    Component(TransactionTable, "Transaction Table", "Amazon DynamoDB", "Stores real-time authorization and transaction data with single-digit millisecond latency.")
    Component(CaseManagementTable, "Case Management Table", "Amazon DynamoDB", "Stores case management data to support analyst workflows.")
    Component(GlobalSecondaryIndexesGSIs, "Global Secondary Indexes (GSIs)", "Amazon DynamoDB GSI", "Provides alternative access patterns for querying case management data.")
    Component(DynamoDBStreamsProcessor, "DynamoDB Streams Processor", "AWS Lambda", "Processes real-time change data capture events from DynamoDB Streams.")
    Component(ClientSideEncryptionComponent, "Client-Side Encryption Component", "AWS Encryption SDK", "Performs client-side column-level encryption for PCI-DSS Level 1 compliance.")
    Component(AutoScalingConfiguration, "Auto-Scaling Configuration", "DynamoDB Auto-Scaling", "Manages capacity with 70% target utilization to handle 3,000 TPS within budget.")
}

Rel(RealTimeScoringEngine, TransactionTable, "Reads and writes authorization data using GetItem and PutItem", "AWS SDK [HTTPS]")
Rel(CaseManagementBackend, CaseManagementTable, "Manages analyst workflows using Query and UpdateItem", "AWS SDK [HTTPS]")
Rel(CaseManagementTable, DynamoDBStreamsProcessor, "Triggers event processing", "DynamoDB Streams [AWS Internal Stream]")
Rel(DynamoDBStreamsProcessor, AmazonS3ObjectLock, "Streams tamper-evident audit logs", "AWS SDK [HTTPS]")

@enduml