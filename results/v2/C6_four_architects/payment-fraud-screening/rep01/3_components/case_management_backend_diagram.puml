@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management Backend container

Container_Boundary(case_management_backend, "Case Management Backend") {
    Component(API_Controller, "API Controller", "Go (HTTPS)", "Handles incoming API requests from the Fraud Analyst Frontend for case management.")
    Component(Case_Logic_Handler, "Case Logic Handler", "Go", "Processes business logic for fraud cases and manages analyst decision events.")
    Component(DynamoDB_Client, "DynamoDB Client", "Go on AWS SDK (HTTPS)", "Reads and writes case data to and from Amazon DynamoDB.")
    Component(EventBridge_Integration, "EventBridge Integration", "AWS SDK / HTTPS", "Routes asynchronous events and publishes analyst decision events.")
}

Rel(API_Controller, Case_Logic_Handler, "Delegates request processing")
Rel(Case_Logic_Handler, DynamoDB_Client, "Invokes reads and writes")
Rel(Case_Logic_Handler, EventBridge_Integration, "Publishes decision and routing events")

@enduml