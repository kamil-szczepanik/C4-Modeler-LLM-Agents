@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalysts, "Fraud Analysts", "End users accessing the system interface.")

System_Ext(AWS_Cognito, "AWS Cognito", "External identity provider")
System_Ext(Case_Management_Backend, "Case Management Backend", "Backend service for queues and rules")

Container_Boundary(Fraud_Analyst_Frontend, "Fraud Analyst Frontend") {
    Component(Authentication_Authorization_Module, "Authentication & Authorization Module", "AWS Cognito, OAuth2/OIDC", "Enforces OAuth2/OIDC role-based access control.")
    Component(Case_Management_Dashboard, "Case Management Dashboard", "React, TypeScript", "Component rendering transaction queues and risk metadata.")
    Component(Audit_Logging_Redaction_Guard, "Audit Logging & Redaction Guard", "Client-side Proxy Interceptor", "Prevents raw card primary account numbers (PANs) from rendering in the DOM.")
    Component(Rule_Model_Management_Console, "Rule & Model Management Console", "React, TypeScript", "Administrative interface for zero-downtime rule and scoring model updates.")
    Component(WebSocket_Client_Module, "WebSocket Client Module", "Native Browser Client", "Maintains real-time queue synchronization.")
}

Rel(FraudAnalysts, Fraud_Analyst_Frontend, "Accesses review interface", "HTTPS")
Rel(Authentication_Authorization_Module, AWS_Cognito, "OAuth2/OIDC authentication", "HTTPS")
Rel(Case_Management_Dashboard, Case_Management_Backend, "Fetches review queues and submits decisions", "REST/JSON over HTTPS")
Rel(Rule_Model_Management_Console, Case_Management_Backend, "Triggers rule adjustments and model deployments", "REST/JSON over HTTPS")
Rel(WebSocket_Client_Module, Case_Management_Backend, "Receives real-time queue synchronization updates", "WSS over HTTPS")

@enduml