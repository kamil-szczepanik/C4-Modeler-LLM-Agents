@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalyst, "Fraud Analyst", "User reviewing suspicious cases via a Web Browser.")

System_Ext(PaymentGatewayAcquirer, "Payment Gateway / Acquirer", "External system sending authorization requests via REST/gRPC over HTTPS.")
System_Ext(CardNetworksTokenizationVault, "Card Networks / Tokenization Vault", "External system providing cardholder data and token resolution.")
System_Ext(ComplianceAuditArchive, "Compliance & Audit Archive", "External WORM storage using AWS S3 Object Lock.")
System_Ext(IdentityProviderIdP, "Identity Provider (IdP)", "External authentication and RBAC provider using OAuth2/OIDC.")
System_Ext(NotificationService, "Notification Service", "External alerting service using AWS SES/SNS.")
System_Ext(MLTrainingPlatform, "ML Training Platform", "External offline system supplying scoring models.")

System(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System", "Evaluates card-not-present payment authorizations for fraud, providing sub-millisecond scoring decisions and case management workflows for analysts.")

Rel(PaymentGatewayAcquirer, RealTimePaymentFraudScreeningSystem, "Synchronous authorization scoring requests", "HTTPS/gRPC")
Rel(FraudAnalyst, RealTimePaymentFraudScreeningSystem, "Case management and rule updates", "HTTPS")
Rel(MLTrainingPlatform, RealTimePaymentFraudScreeningSystem, "Model artifact synchronization", "HTTPS/S3")
Rel(RealTimePaymentFraudScreeningSystem, ComplianceAuditArchive, "Immutable audit record streaming", "AWS SDK/TLS")

@enduml