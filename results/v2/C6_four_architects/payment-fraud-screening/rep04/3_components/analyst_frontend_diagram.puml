@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Analyst Frontend container

Container_Boundary(analyst_frontend, "Analyst Frontend") {
    Component(Auth_Session_Manager_Component, "Auth & Session Manager Component", "React / TypeScript, Zustand / Redux", "Manages authentication state, short-lived JWTs, and RBAC visibility.")
    Component(Case_Dashboard_Queue_Component, "Case Dashboard & Queue Component", "React / TypeScript", "Enables fraud analysts to review suspicious payment cases.")
    Component(Decision_Audit_Inspector_Component, "Decision & Audit Inspector Component", "React / TypeScript", "Inspects explainability payloads and decision details.")
    Component(Rule_Model_Management_Console_Component, "Rule & Model Management Console Component", "React / TypeScript", "Manages fraud rules and model configurations.")
    Component(Audit_Trail_Viewer_Component, "Audit Trail Viewer Component", "React / TypeScript", "Supports 7-year auditability and tamper-evident compliance tracking.")
    Component(API_Gateway_Client_HTTP_Interceptor_Component, "API Gateway Client / HTTP Interceptor Component", "TypeScript, Axios / Fetch", "Handles secure HTTPS / REST and WebSocket communication using short-lived JWTs.")
    Component(Rule_Simulation_Testing_Sandbox_Component, "Rule Simulation & Testing Sandbox Component", "React / TypeScript", "Provides a sandbox for simulating and testing fraud rules.")
    Component(Router_State_Container_Component, "Router & State Container Component", "React Router, Zustand / Redux", "Manages client-side routing, global state, and strict Content Security Policies (CSP).")
}

System_Ext(Case_Management_Service, "Case Management Service", "Backend service for case management")

Rel(Auth_Session_Manager_Component, Case_Management_Service, "Authenticates requests using short-lived JWTs", "HTTPS")
Rel(API_Gateway_Client_HTTP_Interceptor_Component, Case_Management_Service, "Communicates via HTTPS / REST (JSON) and WebSockets", "HTTPS / REST / WebSockets")
Rel(Case_Dashboard_Queue_Component, API_Gateway_Client_HTTP_Interceptor_Component, "Fetches case data", "Internal")
Rel(Decision_Audit_Inspector_Component, API_Gateway_Client_HTTP_Interceptor_Component, "Fetches explainability payloads", "Internal")
Rel(Rule_Model_Management_Console_Component, API_Gateway_Client_HTTP_Interceptor_Component, "Manages rules and models", "Internal")
Rel(Audit_Trail_Viewer_Component, API_Gateway_Client_HTTP_Interceptor_Component, "Retrieves audit logs", "Internal")
Rel(Rule_Simulation_Testing_Sandbox_Component, API_Gateway_Client_HTTP_Interceptor_Component, "Simulates and tests rules", "Internal")

@enduml