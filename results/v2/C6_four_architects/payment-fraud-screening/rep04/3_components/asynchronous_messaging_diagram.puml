@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(asynchronous_messaging, "Asynchronous Messaging") {
    Component(Event Publisher Component, "Event Publisher Component", "AWS SDK", "Dispatches asynchronous audit and scoring events.")
    Component(Notification Dispatcher Component, "Notification Dispatcher Component", "Amazon SNS", "Fans out messages securely to queues.")
    Component(Dead-Letter Queue (DLQ) Handler, "Dead-Letter Queue (DLQ) Handler", "AWS SQS", "Archives unprocessable or poisoned messages for long-term compliance retention.")
    Component(Queue Consumer Routing Component, "Queue Consumer Routing Component", "AWS SDK", "Delivers review payloads and routes messages to consumers.")
}

Container(Audit Storage, "Audit Storage", "Amazon S3 with Object Lock", "Tamper-evident, long-term storage for 7-year audit requirements")

Rel(Event Publisher Component, Notification Dispatcher Component, "Publishes encrypted payloads", "AWS KMS SSE, AWS API")
Rel(Notification Dispatcher Component, Queue Consumer Routing Component, "Fans out messages securely", "AWS internal")
Rel(Dead-Letter Queue (DLQ) Handler, Audit Storage, "Archives unprocessable or poisoned messages for long-term compliance retention", "AWS SDK via HTTPS/TLS 1.3")

@enduml