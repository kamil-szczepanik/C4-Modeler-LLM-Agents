@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_application_load_balancer_alb, "AWS Application Load Balancer (ALB)") {
    Component(AWS_WAF_Rule_Evaluator, "AWS WAF Rule Evaluator", "AWS WAF", "Inspects incoming HTTP/2 traffic for malicious patterns, SQL injection, and DDoS threats at the edge.")
    Component(TLS_Termination_Listener, "TLS Termination Listener", "AWS Certificate Manager (ACM) / HTTPS/2", "Terminates TLS 1.3 connections from the Payment Gateway / Acquirer and handles secure routing.")
    Component(Route_Router, "Route Router", "AWS ALB Routing Engine", "Forwards validated scoring requests to the Fraud Scoring Engine via internal VPC and AWS Cloud Map.")
}

System_Ext(Fraud_Scoring_Engine, "Fraud Scoring Engine", "Java / Spring Boot, AWS ECS Fargate")

Rel(TLS_Termination_Listener, AWS_WAF_Rule_Evaluator, "Passes inspected traffic for security rule evaluation", "")
Rel(AWS_WAF_Rule_Evaluator, Route_Router, "Passes validated traffic to routing rules", "")
Rel(Route_Router, Fraud_Scoring_Engine, "Routes scoring requests", "HTTP/2 over internal VPC via AWS Cloud Map")

@enduml