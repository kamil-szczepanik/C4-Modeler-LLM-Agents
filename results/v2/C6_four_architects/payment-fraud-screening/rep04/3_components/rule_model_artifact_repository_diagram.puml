@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(rule_model_artifact_repository, "Rule/Model Artifact Repository") {
    Component(Model_Artifact_Storage, "Model Artifact Storage", "Amazon S3", "Stores versioned ONNX and LightGBM model binaries uploaded by the ML Training Platform.")
    Component(Artifact_Versioning_and_Metadata_Index, "Artifact Versioning and Metadata Index", "S3 Object Versioning & AWS Lambda", "Manages metadata, checksums, and version history for scoring rules and ML models.")
}

Rel(Artifact_Versioning_and_Metadata_Index, Model_Artifact_Storage, "Organizes and indexes")

@enduml