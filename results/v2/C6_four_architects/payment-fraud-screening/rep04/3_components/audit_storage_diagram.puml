@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit Storage container

Container_Boundary(audit_storage, "Audit Storage") {
    Component(audit_ingestion_api, "Audit Ingestion API", "AWS Lambda (Python)", "Receives audit payloads and coordinates secure writes to object storage and indexing.")
    Component(object_lock_manager, "Object Lock Manager", "Amazon S3 (Glacier Flexible Retrieval / Compliance Mode)", "Enforces WORM storage and 7-year tamper-evident retention for audit objects.")
    Component(audit_indexer_hash_verifier, "Audit Indexer & Hash Verifier", "Amazon DynamoDB and AWS Lambda", "Computes cryptographic hashes and maintains query indexes for audit data.")
    Component(audit_query_service, "Audit Query Service", "AWS Lambda (Python)", "Handles secure compliance reporting and retrieves audit trails.")
    Component(compliance_guardrails_iac, "Compliance Guardrails & IaC", "Terraform/CloudFormation with AWS Config and AWS KMS", "Automates infrastructure deployment and enforces security configurations.")
}

System_Ext(fraud_scoring_engine, "Fraud Scoring Engine / Case Management Service", "External system sending decision payloads")
System_Ext(fraud_analyst, "Fraud Analyst", "External user requesting audit trails")
System_Ext(compliance_audit_archive, "Compliance & Audit Archive", "External archive reading historical logs and queries")

Rel(fraud_scoring_engine, audit_ingestion_api, "Sends decision payloads", "AWS SDK (HTTPS/TLS 1.3)")
Rel(audit_ingestion_api, object_lock_manager, "Writes immutable audit objects", "AWS SDK (S3 PutObject with Legal Hold/Retention)")
Rel(audit_ingestion_api, audit_indexer_hash_verifier, "Stores audit metadata and cryptographic hashes", "AWS SDK (HTTPS)")
Rel(fraud_analyst, audit_query_service, "Requests audit trails", "HTTPS/TLS 1.3")
Rel(audit_query_service, audit_indexer_hash_verifier, "Resolves query metadata", "AWS SDK")
Rel(audit_query_service, object_lock_manager, "Fetches raw immutable payload data", "AWS SDK")
Rel(compliance_audit_archive, audit_query_service, "Requests audit trails", "HTTPS/TLS 1.3")
Rel(compliance_audit_archive, object_lock_manager, "Reads historical logs", "AWS SDK (HTTPS/TLS 1.3)")
Rel(compliance_audit_archive, audit_indexer_hash_verifier, "Queries indexes", "AWS SDK (HTTPS/TLS 1.3)")

@enduml