@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(feature_store_cache, "Feature Store / Cache") {
    Component(in_memory_cache, "In-Memory Cache", "Amazon ElastiCache Redis OSS", "Delivers ultra-low latency real-time rolling aggregates and stores hot velocity aggregates.")
    Component(feature_metadata_store, "Feature Metadata Store", "Amazon DynamoDB", "Stores user profiles and static feature vectors with point-in-time recovery and pre-computed profile features.")
}

Rel(in_memory_cache, feature_metadata_store, "Synchronizes cached metrics with persistent feature profiles", "")

@enduml