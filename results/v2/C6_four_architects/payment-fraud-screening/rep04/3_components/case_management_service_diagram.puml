@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management Service container

Container_Boundary(case_management_service, "Case Management Service") {
    Component(Case_API_Controller, "Case API Controller", "NestJS / Node.js", "Manages review workflows and handles HTTP requests from the Analyst Frontend.")
    Component(Case_Management_Service_Core, "Case Management Service Core", "NestJS / Node.js", "Implements business logic for case processing, security interceptors, and data sanitization.")
    Component(Messaging_Consumer___Publisher, "Messaging Consumer & Publisher", "AWS SDK", "Polls SQS for queued review events and publishes analyst feedback to SNS/SQS for model retraining.")
}

System_Ext(Transactional_Database__Aurora_PostgreSQL_, "Transactional Database (Aurora PostgreSQL)", "Transactional relational database for reliable case management state storage")
System_Ext(Audit_Storage__Amazon_S3_Object_Lock_, "Audit Storage (Amazon S3 Object Lock)", "Tamper-evident storage ensuring 7-year auditability for regulatory compliance")
System_Ext(Asynchronous_Messaging__SNS_SQS_, "Asynchronous Messaging (SNS/SQS)", "Amazon SQS & Amazon SNS")

Rel(Case_API_Controller, Case_Management_Service_Core, "Delegates workflow requests", "In-process / TypeScript")
Rel(Messaging_Consumer___Publisher, Case_Management_Service_Core, "Triggers case creation and state updates", "In-process / TypeScript")
Rel(Case_Management_Service_Core, Transactional_Database__Aurora_PostgreSQL_, "Persists case states", "TCP/Postgres, TLS")
Rel(Case_Management_Service_Core, Audit_Storage__Amazon_S3_Object_Lock_, "Stores tamper-evident decision and audit logs", "HTTPS / AWS SDK")
Rel(Messaging_Consumer___Publisher, Asynchronous_Messaging__SNS_SQS_, "Publishes analyst feedback for model retraining", "AWS SDK / HTTPS")

@enduml