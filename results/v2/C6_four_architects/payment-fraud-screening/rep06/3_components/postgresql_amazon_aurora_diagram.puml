@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL / Amazon Aurora container

Container(Case Management Backend, "Case Management Backend", "Software System", "External system interacting with the database")
Container(Model & Rule Registry Service, "Model & Rule Registry Service", "Software System", "External system querying rule metadata")
System_Ext(Compliance Archive (AWS S3), "Compliance Archive (AWS S3)", "AWS S3 for cost-effective 7-year compliance audit storage")

Container_Boundary(PostgreSQL / Amazon Aurora, "PostgreSQL / Amazon Aurora") {
    Component(Case Repository Component, "Case Repository Component", "PostgreSQL relational tables with JSONB", "Manages analyst decisions and investigation notes.")
    Component(Rule & Model Metadata Component, "Rule & Model Metadata Component", "PostgreSQL", "Stores active rule definitions and version pointers.")
    Component(Audit Ledger Component, "Audit Ledger Component", "PostgreSQL append-only tables with RLS and pgcrypto SHA-256 hashing", "Implements tamper-evident audit logs.")
    Component(Connection Pooling & Routing Component, "Connection Pooling & Routing Component", "PgBouncer / RDS Proxy", "Controls connection limits and multiplexes connections.")
    Component(Database Backup & PITR Component, "Database Backup & PITR Component", "AWS RDS Automated Snapshots and WAL archiving", "Handles automated snapshot lifecycles and Point-in-Time Recovery.")
    Component(Read Replica Routing Component, "Read Replica Routing Component", "Aurora PostgreSQL Read Replica endpoints", "Offloads analytical queries and rule metadata reads.")
}

Rel(Case Management Backend, Case Repository Component, "Read/Write case states", "SQL / PostgreSQL Wire Protocol over TLS")
Rel(Model & Rule Registry Service, Read Replica Routing Component, "Queries rule metadata and metrics", "SQL over TLS")
Rel(Audit Ledger Component, Compliance Archive (AWS S3), "Exports daily encrypted snapshots", "AWS Internal Storage APIs over TLS")

@enduml