@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway / Envoy container

Container_Boundary(api_gateway_envoy, "API Gateway / Envoy") {
    Component(Listener___TLS_Terminator, "Listener & TLS Terminator", "Envoy Listener", "Terminates inbound TLS connections and handles network-level entry for incoming payment authorizations and management requests.")
    Component(Path_Based_Router, "Path-Based Router", "Envoy Router", "Routes incoming requests to appropriate downstream services based on URL paths and traffic rules.")
    Component(ext_authz, "ext_authz", "Envoy External Authorization Filter", "Performs external authorization checks on incoming requests to ensure security and compliance.")
    Component(Redis_Rate_Limiter, "Redis Rate Limiter", "Envoy Rate Limit Service Integration", "Checks and enforces rate limits and quotas using the Redis Cluster.")
    Component(Circuit_Breaker, "Circuit Breaker", "Envoy Outlier Detection", "Protects downstream services by failing fast when error thresholds or latency spikes are detected.")
    Component(Access_Logger, "Access Logger", "Envoy Access Log Service", "Streams structured access logs and metrics to Amazon CloudWatch for observability and auditability.")
}

Rel(Listener___TLS_Terminator, Path_Based_Router, "Passes decrypted traffic")
Rel(Path_Based_Router, ext_authz, "Validates request security")
Rel(Path_Based_Router, Redis_Rate_Limiter, "Checks rate limits")
Rel(Path_Based_Router, Circuit_Breaker, "Wraps outbound calls")
Rel(Path_Based_Router, Access_Logger, "Generates access logs")

@enduml