@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalysts, "Fraud Analysts", "Users of the fraud screening platform")
System_Ext(ApiGatewayEnvoy, "API Gateway / Envoy", "Envoy")

Container_Boundary(AnalystUI, "Analyst UI") {
    Component(ReactSinglePageApplicationSPA, "React Single Page Application (SPA)", "React / JavaScript / HTML / CSS", "Provides the user interface for fraud analysts to manage fraud cases and review alerts.")
    Component(StaticAssetHosting, "Static Asset Hosting", "AWS S3", "Stores and serves the static build assets of the React SPA.")
    Component(ContentDeliveryNetwork, "Content Delivery Network", "Amazon CloudFront", "Distributes static assets globally with low latency over HTTPS.")
}

Rel(FraudAnalysts, ContentDeliveryNetwork, "Accesses case management dashboard via HTTPS [CloudFront]", "HTTPS")
Rel(ContentDeliveryNetwork, StaticAssetHosting, "Fetches static web assets from", "HTTPS")
Rel(ReactSinglePageApplicationSPA, ApiGatewayEnvoy, "Routes API calls via REST/JSON over HTTPS [TLS 1.3, JWT Bearer]", "REST/JSON over HTTPS")
@enduml