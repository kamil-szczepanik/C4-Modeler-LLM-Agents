@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Redis Cluster / Amazon ElastiCache container

Container_Boundary(redis_cluster, "Redis Cluster / Amazon ElastiCache") {
    Component(Primary_Shards, "Primary Shards", "Redis v7.x", "Handles primary write operations for feature data, rate limits, and tokens.")
    Component(Replica_Shards, "Replica Shards", "Redis v7.x", "Handles read scaling and high availability failover.")
    Component(Cluster_Manager_Redis_Sentinel, "Cluster Manager (Redis Sentinel)", "Redis Sentinel", "Monitors Redis instances and manages automatic failover.")
    Component(In_Memory_Token_Feature_Index, "In-Memory Token / Feature Index", "Redis In-Memory Data Structure", "Stores low-latency features and sliding window rate limits for fraud scoring.")
    Component(Sliding_Window_Rate_Limiter, "Sliding Window Rate Limiter", "Amazon ElastiCache (Redis)", "Enforces velocity checks and request throttling.")
}

System_Ext(Fraud_Scoring_Engine, "Fraud Scoring Engine", "External Fraud Scoring Engine service")

Rel(Fraud_Scoring_Engine, In_Memory_Token_Feature_Index, "Queries feature data and executes velocity checks", "Redis RESP / TCP/TLS")
Rel(Fraud_Scoring_Engine, Sliding_Window_Rate_Limiter, "Validates transaction request rates", "Redis RESP / TCP/TLS")
Rel(Cluster_Manager_Redis_Sentinel, Primary_Shards, "Monitors health and manages failover", "")
Rel(Cluster_Manager_Redis_Sentinel, Replica_Shards, "Monitors health and manages replication", "")

@enduml