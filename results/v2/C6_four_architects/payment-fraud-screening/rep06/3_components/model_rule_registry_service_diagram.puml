@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Compliance Archive / AWS S3 Object Lock, "Compliance Archive / AWS S3 Object Lock", "External tamper-evident storage for 7-year audit logs")

Container_Boundary(Model & Rule Registry Service, "Model & Rule Registry Service") {
    Component(Registry API Controller, "Registry API Controller", "Python / FastAPI", "Exposes endpoints for managing models and zero-downtime rule updates.")
    Component(Model Compiler & Validator, "Model Compiler & Validator", "Python", "Validates and compiles models before deployment.")
    Component(Artifact Storage Manager, "Artifact Storage Manager", "Python / S3", "Manages storage of model artifacts in compliance archive storage.")
    Component(Distribution Coordinator, "Distribution Coordinator", "Python", "Coordinates distribution of rules and models to scoring engines.")
    Component(Metadata Repository Client, "Metadata Repository Client", "Python", "Interacts with metadata repositories for tracking model states.")
    Component(Hot Cache Manager, "Hot Cache Manager", "Python", "Manages in-memory caching for rapid rule and model retrieval.")
    Component(Audit Event Emitter, "Audit Event Emitter", "Python", "Emits audit events for registry modifications.")
}

Rel(Registry API Controller, Model Compiler & Validator, "Sends model payloads for validation and compilation")
Rel(Model Compiler & Validator, Artifact Storage Manager, "Stores compiled artifacts")
Rel(Artifact Storage Manager, Compliance Archive / AWS S3 Object Lock, "Stores immutable model artifacts", "HTTPS / S3 API")
Rel(Registry API Controller, Distribution Coordinator, "Triggers distribution of new models/rules")
Rel(Registry API Controller, Metadata Repository Client, "Persists and queries model metadata")
Rel(Distribution Coordinator, Hot Cache Manager, "Updates cached active models and rules")
Rel(Registry API Controller, Audit Event Emitter, "Emits audit events on configuration changes")
@enduml