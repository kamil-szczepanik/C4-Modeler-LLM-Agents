@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_sqs_sns, "Amazon SQS / SNS") {
    Component(Amazon_SNS_Topic, "Amazon SNS Topic", "AWS SNS", "Publishes telemetry and audit events for fan-out processing.")
    Component(Amazon_SQS_Queues, "Amazon SQS Queues", "AWS SQS", "Buffers events for compliance processing and asynchronous workers.")
    Component(Audit_Dead_Line_Queue_DLQ, "Audit Dead-Line Queue (DLQ)", "AWS SQS DLQ", "Routes poisoned audit events after maximum receives are exceeded.")
}

Rel(Amazon_SNS_Topic, Amazon_SQS_Queues, "Delivers fan-out audit events", "AWS SNS Subscription / SQS integration")
Rel(Amazon_SQS_Queues, Audit_Dead_Line_Queue_DLQ, "Routes poisoned audit events after max receives", "AWS internal")

@enduml