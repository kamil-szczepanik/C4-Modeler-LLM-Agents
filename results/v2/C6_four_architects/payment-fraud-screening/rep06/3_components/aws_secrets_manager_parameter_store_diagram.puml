@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS Secrets Manager / Parameter Store container

System_Ext(fraud_scoring_engine, "Fraud Scoring Engine", "External system")
System_Ext(case_management_backend, "Case Management Backend", "External system")
System_Ext(model_rule_registry_service, "Model & Rule Registry Service", "External system")
System_Ext(postgresql_amazon_aurora, "PostgreSQL / Amazon Aurora", "External database")

Container_Boundary(aws_secrets_manager_parameter_store, "AWS Secrets Manager / Parameter Store") {
    Component(Secrets_Engine, "Secrets Engine", "AWS Secrets Manager", "Manages database credentials and tokens with automatic 30-day rotation.")
    Component(Parameter_Store, "Parameter Store", "AWS Systems Manager Parameter Store", "Stores non-sensitive dynamic configurations using the advanced throughput tier.")
    Component(Secrets_Caching_Component, "Secrets Caching Component", "AWS Secrets Manager Caching Library", "Provides client-side caching to maintain the 50ms P99 latency SLA.")
    Component(Secrets_Rotation_Handler, "Secrets Rotation Handler", "AWS Lambda", "Connects to Secrets Manager and Amazon Aurora for automated 30-day credential rotation.")
    Component(Audit_Logging_Bridge, "Audit Logging Bridge", "AWS CloudTrail / Amazon S3 Object Lock", "Ensures tamper-evident, 7-year auditability of all secret access events.")
    Component(Secret_Versioning_Manager, "Secret Versioning Manager", "AWS Secrets Manager Staging Labels", "Manages secret versions and staging labels for secure rollouts.")
    Component(Parameter_Throughput_Scaler, "Parameter Throughput Scaler", "AWS Systems Manager Advanced Tier", "Supports up to 10,000 req/sec for dynamic configuration parameters.")
}

Rel(fraud_scoring_engine, Secrets_Engine, "Retrieves secrets via AWS SDK v2 (HTTPS/TLS 1.3) with IAM least-privilege roles")
Rel(case_management_backend, Secrets_Engine, "Retrieves parameters via AWS SDK v2 (HTTPS/TLS 1.3) with IAM least-privilege roles")
Rel(model_rule_registry_service, Parameter_Store, "Fetches cryptographic signing keys and dynamic parameters via HTTPS")
Rel(Secrets_Engine, Audit_Logging_Bridge, "Streams audit events via AWS CloudTrail")
Rel(Parameter_Store, Audit_Logging_Bridge, "Streams audit events via AWS CloudTrail")
Rel(Secrets_Rotation_Handler, Secrets_Engine, "Executes automated 30-day credential rotation via HTTPS")
Rel(Secrets_Rotation_Handler, postgresql_amazon_aurora, "Updates database credentials during rotation via HTTPS")

@enduml