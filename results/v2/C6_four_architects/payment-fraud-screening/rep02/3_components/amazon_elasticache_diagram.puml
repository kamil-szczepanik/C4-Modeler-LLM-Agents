@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Real_Time_Scoring_Engine, "Real-Time Scoring Engine", "Java / Spring Boot + ONNX")
System_Ext(API_Gateway_Ingress, "API Gateway & Ingress", "Java / Spring Cloud Gateway")
System_Ext(Audit_Worker_Model_Service, "Audit Worker / Model Service", "Node.js / Python worker")

Container_Boundary(Amazon_ElastiCache, "Amazon ElastiCache") {
    Component(Feature_Store_Cache, "Feature Store Cache", "Redis Cluster", "Delivers microsecond-latency feature lookups and sliding-window velocity tracking.")
    Component(Blacklist_Denylist_Registry, "Blacklist / Denylist Registry", "Redis In-Memory Set / Hash", "Performs fast membership checks for fraud screening.")
    Component(Session_Idempotency_Store, "Session & Idempotency Store", "Redis Strings with TTL", "Validates request tokens and locks.")
    Component(Real_Time_Model_Feature_Cache, "Real-Time Model Feature Cache", "Redis Sorted Sets", "Caches real-time model features for scoring.")
    Component(Tokenized_Entity_Cache, "Tokenized Entity Cache", "Redis Encrypted Hash", "Stores and fetches token mappings securely over TLS.")
}

Rel(Real_Time_Scoring_Engine, Feature_Store_Cache, "Fetches sliding-window user velocity metrics", "RESP over TCP")
Rel(Real_Time_Scoring_Engine, Blacklist_Denylist_Registry, "Fast membership checks", "RESP over TCP")
Rel(API_Gateway_Ingress, Session_Idempotency_Store, "Validates request tokens and locks", "RESP over TCP")
Rel(Audit_Worker_Model_Service, Feature_Store_Cache, "Updates real-time aggregations", "RESP over TCP")
Rel(Real_Time_Scoring_Engine, Tokenized_Entity_Cache, "Fetches token mappings", "RESP over TLS")

@enduml