@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_ingress, "API Gateway & Ingress") {
    Component(SpringCloudGatewayRouteHandler, "Spring Cloud Gateway Route Handler", "Java / Spring Cloud Gateway", "High-performance API routing and ingress control for incoming payment authorizations.")
    Component(RateLimitingCircuitBreakerModule, "Rate Limiting & Circuit Breaker Module", "Amazon ElastiCache (Redis) / Resilience4j", "Handles distributed rate tracking and circuit breaking via RESP protocol over TCP.")
    Component(AuthenticationSecurityFilter, "Authentication & Security Filter", "Spring Security OAuth2 Resource Server", "Performs JWT authentication and enforces PCI-DSS edge security scoping.")
}

Rel(SpringCloudGatewayRouteHandler, RateLimitingCircuitBreakerModule, "Queries sliding window rate tracking", "RESP protocol over TCP")
Rel(SpringCloudGatewayRouteHandler, AuthenticationSecurityFilter, "Validates incoming authenticated requests")

@enduml