@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(case_management_backend, "Case Management Backend") {
    Component(Case_API_Controller, "Case API Controller", "Express.js / TypeScript", "Handles HTTP requests from the Fraud Analyst UI for case reviews and workflow actions.")
    Component(Case_Workflow_Service, "Case Workflow Service", "TypeScript", "Invokes business logic and orchestrates case workflows.")
    Component(Data_Access_Repository, "Data Access Repository", "Prisma ORM / TypeScript", "Persists state changes and executes parameterized queries with optimistic locking.")
    Component(Audit_Logging_Interceptor, "Audit Logging Interceptor", "TypeScript", "Dispatches tamper-evident audit events for compliance.")
    Component(Tokenization_Gateway_Client, "Tokenization Gateway Client", "Axios / TypeScript", "Requests tokenized payloads via HTTPS/REST.")
}

Rel(Case_API_Controller, Case_Workflow_Service, "Invokes business logic", "In-memory function calls")
Rel(Case_Workflow_Service, Audit_Logging_Interceptor, "Dispatches audit events", "Async/Sync method calls")
Rel(Case_Workflow_Service, Data_Access_Repository, "Persists state changes", "TypeScript/Prisma")
Rel(Case_Workflow_Service, Tokenization_Gateway_Client, "Requests tokenized payload", "HTTPS/REST")

@enduml