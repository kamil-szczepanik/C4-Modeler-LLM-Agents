@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Fraud Analyst UI container

Container_Boundary(fraud_analyst_ui, "Fraud Analyst UI") {
    Component(React_SPA_Root_Component, "React SPA Root Component", "React, Zustand, Tailwind CSS", "Main application entry point providing the single-page application structure for fraud analysts.")
    Component(Case_Management_View, "Case Management View", "React, TanStack Table", "UI component for browsing, sorting, and filtering suspicious transactions and review cases.")
    Component(Review_Decision_Form, "Review Decision Form", "React, Axios", "Form component used by analysts to submit decisions on suspicious transactions.")
    Component(Rule_Management_Dashboard, "Rule Management Dashboard", "React, Tailwind CSS", "Interface allowing fraud analysts to send rule update payloads and manage detection rules.")
}

System_Ext(Case_Management_Backend, "Case Management Backend", "Node.js / TypeScript service managing analyst workflows.")
System_Ext(Model___Rule_Management_Service, "Model & Rule Management Service", "Python / FastAPI service for zero-downtime updates.")
System_Ext(API_Gateway___Ingress, "API Gateway & Ingress", "Java / Spring Cloud Gateway managing incoming traffic.")

Rel(React_SPA_Root_Component, Case_Management_View, "Renders")
Rel(React_SPA_Root_Component, Review_Decision_Form, "Renders")
Rel(React_SPA_Root_Component, Rule_Management_Dashboard, "Renders")
Rel(Case_Management_View, Case_Management_Backend, "Fetches cases and submits review decisions", "HTTPS / JSON REST")
Rel(Review_Decision_Form, Case_Management_Backend, "Submits review decisions", "HTTPS / JSON REST")
Rel(Rule_Management_Dashboard, Model___Rule_Management_Service, "Sends rule update payloads", "HTTPS / JSON REST")
Rel(React_SPA_Root_Component, API_Gateway___Ingress, "Transmits secured requests and audit telemetry", "HTTPS / JSON REST")

@enduml