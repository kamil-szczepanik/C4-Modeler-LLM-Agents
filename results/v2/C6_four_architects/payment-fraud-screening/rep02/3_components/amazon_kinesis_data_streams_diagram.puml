@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Component(Real-Time Scoring Engine, "Real-Time Scoring Engine", "HTTPS (AWS SDK)", "Publishes events via HTTPS (AWS SDK).")
Component(Audit Worker, "Audit Worker", "HTTP/2 (KCL)", "Consumes event streams via HTTP/2 (KCL).")

Container_Boundary("Amazon Kinesis Data Streams", "Amazon Kinesis Data Streams") {
    Component(Shard Routing & Ingestion Service, "Shard Routing & Ingestion Service", "AWS-managed ingress", "AWS-managed ingress handling partition key hashing.")
    Component(Partition Log & Storage Engine, "Partition Log & Storage Engine", "AWS-managed log storage", "AWS-managed immutable, append-only log storage.")
    Component(Enhanced Fan-Out Consumer Endpoints, "Enhanced Fan-Out Consumer Endpoints", "KCL, HTTP/2", "Dedicated HTTP/2 throughput channels via KCL.")
    Component(Data Retention & Replay Controller, "Data Retention & Replay Controller", "AWS-managed component", "AWS-managed component enforcing log retention.")
}

Rel(Real-Time Scoring Engine, Shard Routing & Ingestion Service, "Publishes payment events", "HTTPS (AWS SDK)")
Rel(Partition Log & Storage Engine, Data Retention & Replay Controller, "Manages time-based log rotation", "AWS Internal API")
Rel(Partition Log & Storage Engine, Enhanced Fan-Out Consumer Endpoints, "Feeds real-time event streams", "AWS Internal Protocol")
Rel(Enhanced Fan-Out Consumer Endpoints, Audit Worker, "Delivers push-based event streams", "HTTP/2 (KCL)")
@enduml