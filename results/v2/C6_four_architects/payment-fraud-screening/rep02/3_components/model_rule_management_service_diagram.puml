@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Model & Rule Management Service container

Container_Boundary(model_rule_management_service, "Model & Rule Management Service") {
    Component(API_Controller, "API Controller", "FastAPI / Python", "FastAPI endpoints handling administrative requests over HTTPS.")
    Component(Rule_Model_Validator, "Rule & Model Validator", "Python", "Validates rule syntax and ONNX model compatibility.")
    Component(Sandbox_Evaluator, "Sandbox Evaluator", "Python", "Tests models against historical regression fixtures.")
    Component(Version_Registry, "Version Registry", "Amazon Aurora PostgreSQL / SQL/ORM", "Manages semantic versioning and metadata backed by Amazon Aurora PostgreSQL.")
    Component(Artifact_Bundler, "Artifact Bundler", "Python", "Packages models, configurations, and rules into immutable archives.")
    Component(Distribution_Publisher, "Distribution Publisher", "Amazon S3 / Amazon SNS", "Publishes rule sets and ONNX binaries via Amazon S3 and Amazon SNS.")
    Component(Audit_Event_Emitter, "Audit Event Emitter", "Python / Amazon SQS", "Emits cryptographically signed audit logs via Amazon SQS.")
    Component(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Relational Database", "Provides robust relational storage for version metadata and test fixtures.")
}

Component(Real_Time_Scoring_Engine, "Real-Time Scoring Engine", "External Container", "Receives distributed rule sets and ONNX binaries.")
Component(Audit_Worker, "Audit Worker", "External Component", "Processes tamper-evident audit logs from Amazon SQS.")

Rel(API_Controller, Rule_Model_Validator, "In-memory function call")
Rel(Rule_Model_Validator, Version_Registry, "SQL/ORM over TLS")
Rel(Rule_Model_Validator, Sandbox_Evaluator, "In-memory function call")
Rel(Sandbox_Evaluator, Amazon_Aurora_PostgreSQL, "Read historical test fixtures", "SQL/ORM over TLS")
Rel(Sandbox_Evaluator, Artifact_Bundler, "In-memory function call")
Rel(Artifact_Bundler, Distribution_Publisher, "In-memory function call")
Rel(Distribution_Publisher, Real_Time_Scoring_Engine, "AWS SNS / HTTPS webhook")
Rel(API_Controller, Audit_Event_Emitter, "Internal Event bus")
Rel(Version_Registry, Audit_Event_Emitter, "Internal Event bus")
Rel(Audit_Event_Emitter, Audit_Worker, "Amazon SQS over TLS")

@enduml