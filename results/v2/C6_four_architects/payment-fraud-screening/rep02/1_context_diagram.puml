@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalysts, "Fraud Analysts", "Human analysts who review cases and manage fraud workflows.")

System(RealTimePaymentFraudScreening, "Real-Time Payment Fraud Screening", "Evaluates card-not-present payment authorizations for fraud and provides case management for human analysts.")

System_Ext(PaymentGatewayAcquirer, "Payment Gateway / Acquirer", "Initiates payment authorizations and routes them to the screening system.")
System_Ext(CardNetworksTokenizationVault, "Card Networks & Tokenization Vault", "External networks and vaults handling card and token data.")
System_Ext(RegulatoryAuditAuthorities, "Regulatory & Audit Authorities", "External entities requiring compliant and tamper-evident audit logs.")
System_Ext(CoreBankingLedgerSystem, "Core Banking / Ledger System", "Backend financial ledger system for core banking records.")
System_Ext(MLModelTrainingEnvironment, "ML Model Training Environment", "Environment used to train and update fraud detection machine learning models.")
System_Ext(IdentityProvidingIdP, "Identity Provider (IdP)", "Provides authentication and identity management services.")

Rel(PaymentGatewayAcquirer, RealTimePaymentFraudScreening, "Sends payment authorizations for fraud evaluation", "gRPC over TLS 1.3")
Rel(FraudAnalysts, RealTimePaymentFraudScreening, "Accesses case management workflows and web UI", "HTTPS over TLS 1.3 via AWS Client VPN or IAM")

@enduml