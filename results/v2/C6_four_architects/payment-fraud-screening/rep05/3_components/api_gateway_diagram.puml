@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(Regional_API_Endpoint, "Regional API Endpoint", "Amazon API Gateway", "Regional endpoint configuration to optimize latency within eu-west-1 and reduce multi-region costs.")
    Component(Lambda_Authorizer, "Lambda Authorizer", "AWS Lambda", "Performs local JWT validation and caching to offload authentication overhead from the backend.")
}

Rel(Regional_API_Endpoint, Lambda_Authorizer, "Validates JWT tokens", "HTTPS")

@enduml