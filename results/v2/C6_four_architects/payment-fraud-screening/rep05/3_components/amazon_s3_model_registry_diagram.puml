@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon S3 Model Registry container

Container_Boundary(s3_model_registry, "Amazon S3 Model Registry") {
    Component(s3_bucket, "S3 Bucket & Versioning/Object Lock", "Amazon S3", "Provides immutable storage, secure access control, and atomic versioning for fraud scoring models and rules with 7-year auditability.")
    Component(s3_sqs, "S3 Event Notification to SQS Queue", "Amazon SQS", "Triggers asynchronous deployment alerts upon new model uploads to prevent dropped reload signals during ECS Fargate scaling events.")
    Component(access_control, "Access Control & Encryption", "AWS IAM & KMS SSE-S3", "Enforces least-privilege access and customer-managed encryption to satisfy PCI-DSS Level 1 compliance.")
    Component(model_manifest, "Model Metadata Manifest", "JSON Manifest", "Implements lightweight atomic version pinning (`manifest.json`) for zero-downtime hot-reloading.")
    Component(staging_prod_prefixes, "Staging and Production Prefixes", "Amazon S3 Prefixes", "Logical separation for /staged and /production model binaries.")
}

Rel(s3_bucket, s3_sqs, "Triggers asynchronous deployment alerts upon new model uploads", "HTTPS / S3 API")
Rel(model_manifest, s3_bucket, "References version-pinned binaries stored in S3", "")
Rel(staging_prod_prefixes, s3_bucket, "Organizes model storage paths within the bucket", "")

@enduml