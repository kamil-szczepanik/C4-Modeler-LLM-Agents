@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_aurora_postgresql, "Amazon Aurora PostgreSQL") {
    Component(Case_Data_Repository, "Case Data Repository", "PostgreSQL Tables", "Stores case management data, fraud analysis records, and audit logs.")
    Component(Audit_Log_Storage, "Audit Log Storage", "PostgreSQL Tables with S3 Export", "Maintains immutable audit records supporting 7-year retention compliance.")
}

Rel(Case_Management_API, Case_Data_Repository, "Executes CRUD operations on cases", "TCP/TLS, PostgreSQL Wire Protocol")
Rel(Audit_Log_Replication_Daemon, Audit_Log_Storage, "Exports immutable audit logs to Amazon S3 Object Lock", "HTTPS/TLS")

@enduml