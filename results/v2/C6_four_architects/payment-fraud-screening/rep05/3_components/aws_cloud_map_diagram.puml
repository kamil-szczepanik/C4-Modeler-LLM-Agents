@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("aws_cloud_map", "AWS Cloud Map") {
    Component(Registry_Manager, "Registry Manager", "AWS SDK", "Manages service registration and metadata updates.")
    Component(Health_Check_Prober, "Health Check Prober", "AWS Cloud Map Health Checker", "Continuously monitors the health of registered microservices.")
    Component(Discovery_API_DNS_Resolver, "Discovery API & DNS Resolver", "Amazon Route 53 Private DNS", "Delivers sub-millisecond internal service discovery via DNS and API.")
}

Rel(Registry_Manager, Discovery_API_DNS_Resolver, "Updates service endpoints and routing records", "")
Rel(Health_Check_Prober, Registry_Manager, "Reports instance health status", "")
@enduml