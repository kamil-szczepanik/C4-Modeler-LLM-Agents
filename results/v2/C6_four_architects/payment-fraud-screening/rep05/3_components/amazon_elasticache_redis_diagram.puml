@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_elasticache_redis, "Amazon ElastiCache (Redis)") {
    Component(In_Memory_Feature_Store_Engine, "In-Memory Feature Store Engine", "Redis Engine", "Handles low-latency in-memory feature storage and supports high-throughput sliding window lookups.")
    Component(Cluster_Replication_Multi_AZ_Manager, "Cluster Replication & Multi-AZ Manager", "Redis Cluster Manager", "Manages data replication across multiple Availability Zones to ensure high availability.")
    Component(Encryption_Access_Controller, "Encryption & Access Controller", "TLS and IAM", "Secures data in transit via TLS and enforces access controls.")
    Component(Connection_Pool_Command_Batching_Proxy, "Connection Pool & Command Batching Proxy", "Redis Proxy", "Manages TCP/RESP connections and implements command batching for optimal performance.")
    Component(Memory_Eviction_Policy_Manager, "Memory & Eviction Policy Manager", "Redis Memory Management", "Monitors memory usage and enforces eviction policies to maintain optimal performance.")
}

Rel(Connection_Pool_Command_Batching_Proxy, In_Memory_Feature_Store_Engine, "Routes batched TCP/RESP commands", "")
Rel(Encryption_Access_Controller, Connection_Pool_Command_Batching_Proxy, "Secures connections via TLS", "")

@enduml