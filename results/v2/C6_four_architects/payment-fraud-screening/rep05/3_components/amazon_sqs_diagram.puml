@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Amazon_SQS", "Amazon SQS") {
    Component("Amazon SQS Standard Queue", "Amazon SQS Standard Queue", "Amazon SQS", "Asynchronous decoupling queue with 14-day retention and 60s visibility timeout for zero operational toil.")
    Component("Amazon SQS Dead-Letter Queue (DLQ)", "Amazon SQS Dead-Letter Queue (DLQ)", "Amazon SQS", "Captures unprocessable messages after maximum retries for operational monitoring and alerting.")
}

Rel("Amazon SQS Standard Queue", "Amazon SQS Dead-Letter Queue (DLQ)", "Forwards unprocessable messages after max retries", "AWS SDK")

@enduml