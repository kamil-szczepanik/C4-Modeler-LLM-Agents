@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(cloud_front_react_spa, "CloudFront / React SPA") {
    Component(react_single_page_application, "React Single Page Application", "React, JavaScript, HTML5", "Provides the user interface for fraud analysts to review suspicious transactions and manage cases.")
    Component(static_asset_host, "Static Asset Host", "Amazon S3, Amazon CloudFront", "Hosts and distributes the frontend static assets globally via CDN.")
}

System_Ext(api_gateway, "API Gateway", "API Gateway")

Rel(react_single_page_application, api_gateway, "Sends API requests", "HTTPS/REST")

@enduml