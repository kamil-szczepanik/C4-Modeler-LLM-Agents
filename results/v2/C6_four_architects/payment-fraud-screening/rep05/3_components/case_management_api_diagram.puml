@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management API container

System_Ext(api_gateway, "API Gateway", "External API Gateway")

Container_Boundary(case_management_api, "Case Management API") {
    Component(api_controller, "API Controller Component", "Python, FastAPI", "Forwards REST requests and handles API routing.")
    Component(masking_interceptor, "Masking & Tokenization Interceptor Component", "Python", "In-process middleware hook that passes sanitized case data payloads.")
    Component(iam_auth, "IAM Authorization Component", "Python, FastAPI Dependency Injection", "In-process dependency check for authorization.")
    Component(case_service, "Case Service Component", "Python", "Manages suspicious cases and handles relational case state.")
    Component(audit_logger, "Audit Logger Component", "Python", "Writes tamper-evident audit trails.")
    ComponentDb(aurora_db, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Stores operational case data reliably with robust ACID compliance.")
    Component(s3_worm, "Amazon S3 Object Lock", "Amazon S3 Object Lock", "Implements write-once-read-many (WORM) storage for tamper-evident auditability.")
    Component(sqs, "Amazon SQS", "Amazon SQS", "Decouples downstream event publishing for model retraining.")
}

Rel(api_gateway, api_controller, "Forwards REST requests", "HTTPS/REST")
Rel(api_controller, masking_interceptor, "In-process middleware hook", "Python native")
Rel(api_controller, iam_auth, "In-process dependency check", "Python native")
Rel(masking_interceptor, case_service, "Passes sanitized case data payloads", "Python native")
Rel(case_service, aurora_db, "Reads and writes relational case state", "TCP/TLS via SQLAlchemy ORM")
Rel(case_service, sqs, "Emits case resolution events", "HTTPS/SQS API")
Rel(audit_logger, s3_worm, "Writes tamper-evident audit trails", "HTTPS/S3 API")

@enduml