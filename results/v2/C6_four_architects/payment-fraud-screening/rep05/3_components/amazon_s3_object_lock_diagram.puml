@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(aws_lambda, "AWS Lambda", "External component generating audit logs")

Container_Boundary(amazon_s3_object_lock, "Amazon S3 Object Lock") {
    Component(object_lock_enforcement_engine, "Object Lock Enforcement Engine", "AWS S3 Compliance Mode", "Enforces Write Once, Read Many (WORM) controls to guarantee 7-year tamper-evident audit retention.")
    Component(immutable_storage_api, "Immutable Storage API", "HTTPS (PutObject)", "Receives and securely stores immutable audit logs from AWS Lambda.")
}

Rel(aws_lambda, immutable_storage_api, "Stores immutable audit logs", "HTTPS (PutObject)")
Rel(immutable_storage_api, object_lock_enforcement_engine, "Enforces WORM controls", "Internal")

@enduml