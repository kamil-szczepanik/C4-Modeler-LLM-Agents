@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS ALB container

Container_Boundary(aws_alb, "AWS ALB") {
    Component(grpc_routing_listener, "gRPC Routing Listener", "AWS ALB Routing / AWS Cloud Map", "Routes gRPC scoring traffic to the Fraud Scoring Service.")
    Component(rest_routing_listener, "REST Routing Listener", "AWS ALB Routing / AWS Cloud Map", "Routes REST management traffic to the Case Management API.")
}

System_Ext(fraud_scoring_service, "Fraud Scoring Service", "Python, FastAPI, ONNX Runtime, Amazon ECS Fargate")
System_Ext(case_management_api, "Case Management API", "Amazon ECS Fargate")

Rel(grpc_routing_listener, fraud_scoring_service, "Routes gRPC scoring traffic", "gRPC over HTTP/2")
Rel(rest_routing_listener, case_management_api, "Routes REST management traffic", "HTTPS/REST")

@enduml