@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalyst, "Fraud Analyst", "Reviews suspicious transactions and manages cases through the case management interface.")

System(CardNotPresentFraudDetectionSystem, "Card-Not-Present Fraud Detection System", "Screens card-not-present payment authorizations for fraud in real-time and provides a case management interface for analysts, ensuring sub-50ms latency while maintaining PCI-DSS Level 1 compliance and 7-year auditability.")

System_Ext(PaymentGatewayCoreLedger, "Payment Gateway / Core Ledger", "Sends payment authorizations for fraud screening.")
System_Ext(CardSchemesTokenizationProvider, "Card Schemes / Tokenization Provider", "External card scheme and tokenization services.")
System_Ext(IdentityProviderIdP, "Identity Provider (IdP)", "Manages user authentication and identity.")
System_Ext(NotificationService, "Notification Service", "Handles external notifications.")

Rel(PaymentGatewayCoreLedger, CardNotPresentFraudDetectionSystem, "Sends payment authorizations for fraud screening", "gRPC (mTLS)")
Rel(FraudAnalyst, CardNotPresentFraudDetectionSystem, "Reviews suspicious transactions and manages cases", "HTTPS")

@enduml