@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS Application Load Balancer (ALB) container

System_Ext(Amazon_S3_Object_Lock, "Amazon S3 Object Lock", "Stores audit logs [HTTPS]")

Container_Boundary(AWS_Application_Load_Balancing_ALB, "AWS Application Load Balancer (ALB)") {
    Component(Listener_Component, "Listener Component", "AWS ALB Listener", "Routes external authorization traffic and interacts with the WAF and Routing Rules Engine.")
    Component(Routing_Rules_Engine, "Routing Rules Engine", "Routing Rules Engine", "Internal handoff to route traffic between backend containers, scoring engines, and tokenization proxies.")
    Component(Health_Check_Circuit_Breaker_Component, "Health Check & Circuit Breaker Component", "Health Check & Circuit Breaker Component", "Performs active health probes on backend services.")
    Component(WAF_Security_Filter_Component, "WAF & Security Filter Component", "AWS WAF", "Inspects headers and payloads for security filtering and OWASP Top 10 protection.")
    Component(Access_Logging_Telemetry_Component, "Access Logging & Telemetry Component", "Access Logging & Telemetry Component", "Emits metadata asynchronously and stores audit logs.")
    Component(Target_Group_Manager, "Target Group Manager", "Target Group Manager", "Resolves backend ECS tasks and manages connection pools.")
}

Rel(Listener_Component, WAF_Security_Filter_Component, "Inspects headers and payloads", "In-Memory")
Rel(Listener_Component, Routing_Rules_Engine, "Internal handoff", "In-Memory")
Rel(Routing_Rules_Engine, Access_Logging_Telemetry_Component, "Emits metadata asynchronously", "In-Memory/Queue")
Rel(Routing_Rules_Engine, Target_Group_Manager, "Resolves backend ECS tasks", "In-Memory")
Rel(Health_Check_Circuit_Breaker_Component, Target_Group_Manager, "Performs active health probes", "HTTP GET")
Rel(Access_Logging_Telemetry_Component, Amazon_S3_Object_Lock, "Stores audit logs", "HTTPS")

@enduml