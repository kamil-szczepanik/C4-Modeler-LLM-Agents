@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(case_management_backend_container, "Case Management Backend Container") {
    Component(Case_Controller, "Case Controller", "Node.js, TypeScript, Express", "Handles HTTP/REST requests from the AWS Application Load Balancer for case management.")
    Component(Case_Service, "Case Service", "Node.js, TypeScript", "Implements business logic for fraud case evaluation, review workflows, and analyst operations.")
    Component(Data_Access_Layer, "Data Access Layer", "Node.js, TypeScript, AWS SDK", "Manages read and write operations to Amazon DynamoDB using VPC Endpoints.")
    Component(Tokenization_Client, "Tokenization Client", "Node.js, TypeScript, gRPC", "Communicates securely with the Tokenization Proxy Container via mTLS over internal VPC.")
}

System_Ext(Tokenization_Proxy_Container, "Tokenization Proxy Container", "AWS Nitro Enclaves")
System_Ext(Amazon_DynamoDB, "Amazon DynamoDB", "Scalable case data persistence")

Rel(Case_Controller, Case_Service, "Delegates requests")
Rel(Case_Service, Data_Access_Layer, "Persists and retrieves case data")
Rel(Case_Service, Tokenization_Client, "Requests tokenization services")
Rel(Tokenization_Client, Tokenization_Proxy_Container, "gRPC over internal VPC, mTLS")
Rel(Data_Access_Layer, Amazon_DynamoDB, "Read/Write cases, VPC Endpoints")
@enduml