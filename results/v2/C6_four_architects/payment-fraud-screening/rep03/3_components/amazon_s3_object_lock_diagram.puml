@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(s3_object_lock, "Amazon S3 Object Lock") {
    Component(object_writer, "Object Writer", "AWS SDK, HTTPS", "Writes decision payloads and human review audit trails into the storage layer.")
    Component(lifecycle_management, "Lifecycle Management", "AWS SDK, HTTPS", "Configures transition of objects to S3 Glacier Deep Archive.")
    Component(audit_verification, "Audit Verification", "AWS SDK, HTTPS", "Reads and verifies object integrity for compliance and audit retention.")
    Component(access_control, "Access Control & Compliance Policy Manager", "AWS IAM / AWS SDK, HTTPS", "Configures bucket compliance parameters and enforces server-side encryption via AWS KMS.")
    Component(metadata_indexer, "Metadata Indexer", "S3 Event Notifications, AWS SDK, HTTPS", "Triggers event notifications and persists audit metadata pointers to Amazon DynamoDB.")
}

System_Ext(s3_storage, "AWS S3 Storage Layer", "Immutable object storage with Object Lock and Glacier Deep Archive.")
System_Ext(aws_kms, "AWS KMS", "Key Management Service for server-side encryption.")
System_Ext(dynamodb, "Amazon DynamoDB", "NoSQL database for audit metadata pointers.")

Rel(object_writer, s3_storage, "Persists immutable objects", "AWS SDK, HTTPS")
Rel(lifecycle_management, s3_storage, "Configures transition to S3 Glacier Deep Archive", "AWS SDK, HTTPS")
Rel(audit_verification, s3_storage, "Reads and verifies object integrity", "AWS SDK, HTTPS")
Rel(access_control, s3_storage, "Configures bucket compliance parameters", "AWS IAM / AWS SDK, HTTPS")
Rel(access_control, aws_kms, "Enforces server-side encryption", "AWS SDK, HTTPS")
Rel(s3_storage, metadata_indexer, "Triggers event notifications", "S3 Event Notifications, HTTPS")
Rel(metadata_indexer, dynamodb, "Persists audit metadata pointers", "AWS SDK, HTTPS")
@enduml