@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Real-Time Payment Fraud Screening System

Person(FraudAnalysts, "Fraud Analysts", "System users for case management and fraud reviews.")

System_Ext(PaymentGatewayCoreLedger, "Payment Gateway / Core Ledger", "Source of authorization requests.")
System_Ext(CardSchemesIssuer3DSDirectoryServers, "Card Schemes / Issuer 3DS Directory Servers", "Provides EMVCo 3DS 2.x APIs.")
System_Ext(MLFeatureStoreThreatIntelligenceProvider, "ML Feature Store / Threat Intelligence Provider", "External IP and device fingerprinting APIs.")
System_Ext(IdentityProvider, "Identity Provider", "IdP for authentication and RBAC.")
System_Ext(NotificationService, "Notification Service", "Email/SMS alerts.")
System_Ext(ModelTrainingExperimentationEnvironment, "Model Training & Experimentation Environment", "Amazon SageMaker Studio for out-of-band model development and zero-downtime updates.")
System_Ext(AWSCloudFrontALB, "AWS CloudFront & ALB", "Perimeter ingress and DDoS mitigation.")
System_Ext(AWSKMSS3ObjectLock, "AWS KMS & S3 Object Lock", "Cryptographic audit and immutable 7-year storage.")

System(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System", "Processes card-not-present payment authorizations in AWS to detect fraud and support analyst reviews under strict latency and compliance constraints.")

Rel(PaymentGatewayCoreLedger, RealTimePaymentFraudScreeningSystem, "Ingress of authorization requests", "gRPC over HTTP/2 with mTLS")
Rel(FraudAnalysts, AWSCloudFrontALB, "Ingress for case management and review", "HTTPS (TLS 1.3) with AWS WAF")
Rel(RealTimePaymentFraudScreeningSystem, CardSchemesIssuer3DSDirectoryServers, "Outbound egress for 3DS verification", "HTTPS")
Rel(RealTimePaymentFraudScreeningSystem, MLFeatureStoreThreatIntelligenceProvider, "Outbound egress for feature enrichment", "HTTPS")
Rel(RealTimePaymentFraudScreeningSystem, AWSKMSS3ObjectLock, "Tamper-evident 7-year audit logging and encryption", "AWS IAM policies")
Rel(ModelTrainingExperimentationEnvironment, RealTimePaymentFraudScreeningSystem, "Secure, signed model artifact transfer", "AWS S3 Cross-Account Policies")

@enduml