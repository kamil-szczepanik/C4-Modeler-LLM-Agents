@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore

Person(Customer, "Customer", "Customers accessing the platform via web browsers.")
Person(AdminContentManager, "Admin/Content Manager", "Admin and Content Managers accessing the platform via web browsers.")

System_Ext(PaymentGateway, "Payment Gateway", "External system for processing payments.")
System_Ext(ThirdPartyShippingAPI, "Third-Party Shipping API", "External system for order fulfillment and shipping.")
System_Ext(NotificationService, "Notification Service", "External system for sending emails and notifications.")
System_Ext(IdentityProvider, "Identity Provider", "External system for authentication and identity management.")
System_Ext(TaxCalculationService, "Tax Calculation Service", "External system for calculating taxes.")

System_Boundary(OnlineBookstore, "Online Bookstore") {
    Container(AWSRoute53AmazonCloudFront, "AWS Route 53 & Amazon CloudFront", "AWS Route 53, Amazon CloudFront CDN", "Global routing and content delivery network.")
    Container(FrontendSPA, "Frontend SPA", "React, TypeScript, AWS S3", "Presentation layer single-page application stored in AWS S3.")
    Container(BFFContainer, "BFF Container", "Next.js, Node.js, Amazon ECS/Fargate", "Backend-for-Frontend container for server-side rendering and routing.")
    Container(AWSAPIGateway, "AWS API Gateway", "AWS API Gateway", "Gateway for routing incoming traffic and security validation.")
    Container(ComplianceAuditLambda, "Compliance/Audit Lambda", "AWS Lambda", "Container/function for compliance and auditing.")
    Container(CoreECommerceService, "Core E-Commerce Service", "Spring Boot, Java", "Handles transactional core business logic.")
    Container(RecommendationEngine, "Recommendation Engine", "FastAPI, Python", "Generates AI-powered book recommendations.")
    Container(SearchDiscovery, "Search & Discovery", "Amazon OpenSearch", "Manages catalog queries and search functionality.")
    Container(NotificationWorker, "Notification Worker", "Amazon ECS/Fargate", "Processes background notification tasks.")
    ContainerDb(AmazonAuroraGlobalDatabase, "Amazon Aurora Global Database", "PostgreSQL, Amazon Aurora", "Relational database for ACID checkout and global operations.")
    ContainerDb(AmazonDynamoDB, "Amazon DynamoDB", "Amazon DynamoDB", "NoSQL database for reviews and caching.")
    ContainerDb(AmazonElastiCache, "Amazon ElastiCache", "Redis", "In-memory data store for low-latency read caching.")
    Container(AmazonMSK, "Amazon MSK", "Apache Kafka", "Event streaming and messaging bus.")
    Container(AWSGlueAthena, "AWS Glue & Athena", "AWS Glue, Amazon Athena", "Data lake and analytics infrastructure.")
}

Rel(Customer, AWSRoute53AmazonCloudFront, "Accesses via web browsers", "HTTPS")
Rel(AdminContentManager, AWSRoute53AmazonCloudFront, "Accesses via web browsers", "HTTPS")
Rel(AWSRoute53AmazonCloudFront, BFFContainer, "Routes client traffic", "HTTPS")
Rel(BFFContainer, AWSAPIGateway, "Proxies requests", "gRPC over TLS")
Rel(AWSAPIGateway, CoreECommerceService, "Routes business requests", "gRPC over TLS")
Rel(AWSAPIGateway, RecommendationEngine, "Routes recommendation requests", "gRPC over TLS")
Rel(AWSAPIGateway, SearchDiscovery, "Routes search queries", "gRPC over TLS")
Rel(CoreECommerceService, AmazonAuroraGlobalDatabase, "Executes ACID transactions", "TLS/JDBC")
Rel(CoreECommerceService, AmazonElastiCache, "Reads/writes cached data", "RESP over TLS")
Rel(CoreECommerceService, AmazonDynamoDB, "Accesses NoSQL data", "TLS")
Rel(RecommendationEngine, AmazonDynamoDB, "Accesses data", "TLS")
Rel(CoreECommerceService, AmazonMSK, "Publishes and consumes events", "Kafka protocol over TLS")
Rel(NotificationWorker, AmazonMSK, "Consumes event streams", "Kafka protocol over TLS")
Rel(NotificationWorker, NotificationService, "Sends notifications", "Secure REST/HTTPS")
Rel(CoreECommerceService, PaymentGateway, "Processes payments", "Secure REST/HTTPS")
Rel(CoreECommerceService, ThirdPartyShippingAPI, "Coordinates fulfillment", "Secure REST/HTTPS")
Rel(CoreECommerceService, TaxCalculationService, "Calculates taxes", "Secure REST/HTTPS")
Rel(AWSAPIGateway, IdentityProvider, "Authenticates users", "Secure REST/HTTPS")
Rel(AWSGlueAthena, AmazonAuroraGlobalDatabase, "Analyzes data lake", "JDBC/TLS")

@enduml