@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore

Person(Customer, "Customer", "Web/Mobile User who browses, purchases books, and interacts with the platform.")
Person(AdminContentManager, "Admin/Content Manager", "Manager who oversees content, catalogue, and system administration.")

System_Ext(PaymentGateway, "Payment Gateway", "Stripe/PayPal service for processing transactions.")
System_Ext(ThirdPartyShippingAPI, "Third-Party Shipping API", "FedEx/UPS for order fulfillment and shipping.")
System_Ext(EmailNotificationService, "Email/Notification Service", "SES/SendGrid for sending notifications and emails.")
System_Ext(ExternalIdentityProvider, "External Identity Provider", "AWS Cognito/Auth0 for authentication and identity management.")
System_Ext(TaxCalculationService, "Tax Calculation Service", "Avalara/TaxJar for calculating taxes.")

System_Boundary(OnlineBookstore, "Online Bookstore") {
    Container(FrontendSPA, "Frontend SPA", "React on AWS CloudFront/S3", "Delivers rapid content and performance to users.")
    Container(APIGateway, "API Gateway", "AWS API Gateway", "Routes incoming traffic and validates tokens.")
    Container(CatalogueSearchService, "Catalogue & Search Service", "Node.js/Go with Amazon OpenSearch", "Manages book catalogue and search functionalities.")
    Container(CheckoutOrderService, "Checkout & Order Service", "Java/Spring Boot", "Handles orders, transactions, and publishes events.")
    Container(RecommendationService, "Recommendation Service", "Python/FastAPI", "Generates personalized book recommendations.")
    Container(AsyncWorker, "Async Worker", "AWS Lambda/ECS Fargate", "Processes asynchronous tasks and workflows.")
    ContainerDb(AmazonAuroraGlobalDatabase, "Amazon Aurora Global Database", "Amazon Aurora", "Stores relational data and executes ACID transactions.")
    ContainerDb(AmazonElastiCache, "Amazon ElastiCache", "Redis", "Provides low-latency caching for catalogue data.")
    ContainerDb(AmazonDynamoDB, "Amazon DynamoDB", "Amazon DynamoDB", "NoSQL data store for catalogue and recommendations.")
    Container(AmazonSQSSNS, "Amazon SQS/SNS", "Amazon SQS/SNS", "Messaging system for decoupled event-driven workflows.")
}

Rel(Customer, FrontendSPA, "Browses and interacts with the platform", "HTTPS")
Rel(AdminContentManager, FrontendSPA, "Manages platform content and administration", "HTTPS")
Rel(FrontendSPA, APIGateway, "Sends requests to backend services", "REST/gRPC over TLS")
Rel(APIGateway, CatalogueSearchService, "Routes catalogue and search requests, validating tokens via External Identity Provider", "REST/gRPC over TLS")
Rel(APIGateway, CheckoutOrderService, "Routes checkout and order requests", "REST/gRPC over TLS")
Rel(APIGateway, RecommendationService, "Routes recommendation requests", "REST/gRPC over TLS")
Rel(CheckoutOrderService, AmazonAuroraGlobalDatabase, "Executes ACID transactions", "JDBC over TLS")
Rel(CatalogueSearchService, AmazonElastiCache, "Retrieves cached data", "Redis Protocol over TLS")
Rel(CheckoutOrderService, AmazonSQSSNS, "Publishes order events asynchronously", "Messaging over TLS")
Rel(AsyncWorker, ThirdPartyShippingAPI, "Integrates for fulfillment", "REST/HTTPS")
Rel(AsyncWorker, EmailNotificationService, "Sends alerts and notifications", "REST/HTTPS")
Rel(CheckoutOrderService, PaymentGateway, "Processes payments", "REST/HTTPS")
Rel(CheckoutOrderService, TaxCalculationService, "Calculates taxes", "REST/HTTPS")

@enduml