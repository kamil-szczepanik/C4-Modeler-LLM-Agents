@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS API Gateway container

Container_Boundary(aws_api_gateway, "AWS API Gateway") {
    Component(waf_security, "WAF & Security Shield", "AWS WAF", "Provides edge routing, security, and OWASP Top-10 mitigation.")
    Component(route_validator, "Route Validator & Authorizer", "AWS Lambda / IAM", "Validates routes and authorizes incoming requests.")
    Component(rate_limiter, "Rate Limiter", "AWS API Gateway Rate Limiting", "Controls the rate of incoming requests to protect downstream services.")
    Component(transformation, "Transformation & Validation", "API Gateway Mapping Templates", "Transforms and validates request payloads.")
    Component(request_router, "Request Router", "AWS VPC Links", "Routes validated requests to appropriate backend services.")
    Component(monitoring, "Monitoring & Logging", "Amazon CloudWatch", "Monitors and logs API traffic and performance metrics.")
}

Rel(waf_security, route_validator, "Passes filtered requests for authorization")
Rel(route_validator, rate_limiter, "Passes authenticated requests for rate checking")
Rel(rate_limiter, transformation, "Passes rate-checked requests for payload processing")
Rel(transformation, request_router, "Sends processed requests to routing")
Rel(request_router, monitoring, "Logs routing metrics and access data")

@enduml