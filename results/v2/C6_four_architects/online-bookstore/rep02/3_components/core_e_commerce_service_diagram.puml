@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core E-Commerce Service container

Container_Boundary(core_ecommerce_service, "Core E-Commerce Service") {
    Component(Order_Management_Component, "Order Management Component", "Spring @Service, Java", "Handles core order placement and orchestration of business logic.")
    Component(Catalog_Inventory_Component, "Catalog & Inventory Component", "Spring @Service, Java", "Manages book catalogs and tracks inventory stock levels.")
    Component(Checkout_Billing_Component, "Checkout & Billing Component", "Spring @Service, Java", "Processes secure financial transactions and payment checkouts.")
    Component(Shipping_Fulfillment_Component, "Shipping & Fulfillment Component", "Spring @Service, Java", "Coordinates delivery and logistics with external carriers.")
    Component(Customer_Account_Component, "Customer Account Component", "Spring @Service, Java", "Manages customer profiles and account information.")
    Component(Event_Publisher_Consumer_Component, "Event Publisher/Consumer Component", "Spring @Component / Spring Kafka, Java", "Publishes and consumes asynchronous domain events.")
    Component(Data_Access_Repository_Layer, "Data Access Repository Layer", "Spring Data JPA / JDBC, Java", "Abstracts database interactions and executes persistence queries.")
}

Component(Amazon_Aurora_Global_Database, "Amazon Aurora Global Database", "PostgreSQL", "Stores transactional data with strict ACID compliance.")
Component(Amazon_MSK, "Amazon MSK", "Apache Kafka", "Manages reliable, real-time event streaming.")
Component(External_Payment_Gateway, "External Payment Gateway", "Secure REST/HTTPS", "Processes external payment transactions.")
Component(Third_Party_Shipping_API, "Third-Party Shipping API", "Secure REST/HTTPS", "Coordinates shipping fulfillment with third-party logistics.")

Rel(Order_Management_Component, Checkout_Billing_Component, "Direct method invocation", "In-Process / Java Bean")
Rel(Order_Management_Component, Shipping_Fulfillment_Component, "Direct method invocation", "In-Process / Java Bean")
Rel(Order_Management_Component, Event_Publisher_Consumer_Component, "Delegates domain events", "In-Process / Java Bean")
Rel(Event_Publisher_Consumer_Component, Amazon_MSK, "Publishes/consumes streams", "Kafka protocol over TLS")
Rel(Catalog_Inventory_Component, Data_Access_Repository_Layer, "Queries stock states", "In-Process / Java Bean")
Rel(Data_Access_Repository_Layer, Amazon_Aurora_Global_Database, "Executes ACID transactions", "JDBC/TLS")
Rel(Checkout_Billing_Component, External_Payment_Gateway, "Processes payments", "Secure REST/HTTPS")
Rel(Shipping_Fulfillment_Component, Third_Party_Shipping_API, "Coordinates delivery", "Secure REST/HTTPS")

@enduml