@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_dynamodb, "Amazon DynamoDB") {
    Component(Request_Router_API_Frontend, "Request Router / API Frontend", "AWS Distributed Router", "Routes incoming API requests to appropriate storage nodes.")
    Component(Partition_Router_Storage_Nodes, "Partition Router / Storage Nodes", "DynamoDB Storage Engine", "Manages data partitions and handles read/write operations.")
    Component(Replication_Engine, "Replication Engine", "Internal AWS replication protocol", "Handles multi-AZ and cross-region data replication.")
    Component(DAX_Service_Node, "DAX Service Node", "Amazon DynamoDB Accelerator", "Provides low-latency in-memory caching and NoSQL data access.")
    Component(Global_Table_Replicator, "Global Table Replicator", "DynamoDB Global Tables", "Synchronizes data across multiple global AWS regions.")
    Component(Streams_Worker, "Streams Worker", "DynamoDB Streams", "Captures stream of item-level modifications in DynamoDB tables.")
    Component(Time_to_Live_TTL_Background_Worker, "Time-to-Live (TTL) Background Worker", "DynamoDB TTL Service", "Deletes expired items from tables automatically.")
}

System_Ext(Compliance_Audit_Lambda, "Compliance/Audit Lambda", "AWS Lambda")

Rel(Partition_Router_Storage_Nodes, Replication_Engine, "Multi-AZ and cross-region replication", "Internal AWS replication protocol over TLS")
Rel(Partition_Router_Storage_Nodes, Global_Table_Replicator, "Multi-AZ and cross-region replication", "Internal AWS replication protocol over TLS")
Rel(Streams_Worker, Compliance_Audit_Lambda, "Publishes change data capture events", "HTTPS / TLS 1.3, IAM")

@enduml