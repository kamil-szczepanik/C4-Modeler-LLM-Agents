@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the BFF Container container

Container_Boundary(bff_container, "BFF Container") {
    Component(ssr_router, "SSR Page Router / Controller", "Next.js App Router", "Handles server-side rendering and routing for fast initial page loads.")
    Component(api_proxy, "API Proxy Middleware", "Node.js / Express-style handlers", "Proxies and handles request routing to downstream API gateways and services.")
    Component(graphql_client, "GraphQL / Aggregator Client", "Apollo Client / native fetch", "Fetches and aggregates domain data from backend services.")
    Component(session_manager, "Session & Cache Manager", "ioredis", "Manages user session state and caching via Redis.")
    Component(security_interceptor, "Security & Compliance Interceptor", "Node.js middleware", "Enforces security compliance, sanitizes requests, and handles GDPR/CCPA requirements.")
    Component(telemetry_agent, "Telemetry & Tracing Agent", "OpenTelemetry Node.js SDK", "Exports telemetry metrics and enables distributed tracing.")
}

Container(aws_api_gateway, "AWS API Gateway", "AWS API Gateway", "API Gateway managed service.")
Container(amazon_elasticache, "Amazon ElastiCache", "Amazon ElastiCache & Redis", "Provides low-latency storage for user sessions and cached API responses.")
Container(compliance_lambda, "Compliance/Audit Lambda", "AWS Lambda", "Processes audit logs asynchronously.")
Container(aws_xray, "AWS X-Ray / CloudWatch", "AWS X-Ray / CloudWatch", "Monitoring and telemetry infrastructure.")

Rel(ssr_router, security_interceptor, "In-process function calls", "TypeScript")
Rel(security_interceptor, api_proxy, "Passes sanitized requests", "TypeScript")
Rel(api_proxy, aws_api_gateway, "Forwards proxied calls", "gRPC over TLS")
Rel(graphql_client, aws_api_gateway, "Fetches and aggregates domain data", "gRPC over TLS")
Rel(session_manager, amazon_elasticache, "Manages session state and caching", "RESP/Redis over TLS")
Rel(api_proxy, compliance_lambda, "Offwrites audit logs asynchronously", "HTTPS/JSON")
Rel(telemetry_agent, aws_xray, "Exports telemetry metrics", "HTTPS / AWS SDK")

@enduml