@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(CustomerAdminContentManager, "Customer & Admin/Content Manager", "System user")
System_Ext(BFFContainer, "BFF Container", "Backend For Frontend container")

Container_Boundary(AWS_Route_53_Amazon_CloudFront, "AWS Route 53 & Amazon CloudFront") {
    Component(Route_53_DNS_Resolver, "Route 53 DNS Resolver", "AWS Route 53", "Resolves domain and provides global DNS management with latency-based routing.")
    Component(CloudFront_CDN_Distribution, "CloudFront CDN Distribution", "Amazon CloudFront", "CDN for TLS 1.3 termination, caching, and reverse proxying.")
    Component(CloudFront_LambdaEdge_CloudFront_Functions, "CloudFront Lambda@Edge / CloudFront Functions", "CloudFront Lambda@Edge / Functions", "Executes edge logic for security headers, geo-routing, and modifying headers/routes.")
    Component(AWS_WAF, "AWS WAF", "AWS WAF", "Inspects incoming requests, enforces OWASP Top-10 mitigations, rate-limiting, and geo-blocking.")
    Component(CloudFront_Origin_Groups_Failover, "CloudFront Origin Groups & Failover", "Amazon CloudFront Origin Groups", "Evaluates failover routing to forward dynamic traffic.")
}

Rel(CustomerAdminContentManager, Route_53_DNS_Resolver, "Resolves domain", "DNS")
Rel(Route_53_DNS_Resolver, CloudFront_CDN_Distribution, "Points traffic to edge", "Anycast IP")
Rel(CloudFront_CDN_Distribution, AWS_WAF, "Inspects incoming requests", "Internal AWS API")
Rel(CloudFront_LambdaEdge_CloudFront_Functions, CloudFront_CDN_Distribution, "Modifies headers/routes", "In-memory execution")
Rel(CloudFront_CDN_Distribution, CloudFront_Origin_Groups_Failover, "Evaluates failover routing", "Internal")
Rel(CloudFront_Origin_Groups_Failover, BFFContainer, "Forwards dynamic traffic", "HTTPS, Mutual TLS, HSTS")

@enduml