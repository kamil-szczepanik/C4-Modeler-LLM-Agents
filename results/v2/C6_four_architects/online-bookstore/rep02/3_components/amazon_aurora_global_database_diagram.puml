@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon Aurora Global Database container

Container_Boundary(aurora_global_database, "Amazon Aurora Global Database") {
    Component(Primary_DB_Instance, "Primary DB Instance", "PostgreSQL, Amazon Aurora", "Handles master write operations and ACID transactions.")
    Component(Secondary_DB_Instances, "Secondary DB Instances", "PostgreSQL, Amazon Aurora", "Handles read-only queries across secondary global regions.")
    Component(Aurora_Distributed_Storage_Volume, "Aurora Distributed Storage Volume", "AWS Distributed Storage", "Persists transaction logs and data storage across block-level replication.")
    Component(Global_Database_Manager_GDM, "Global Database Manager (GDM)", "AWS Aurora GDM", "Manages replication and global state across regions.")
    Component(Aurora_Connection_Manager_AWS_RDS_Proxy, "Aurora Connection Manager (AWS RDS Proxy)", "AWS RDS Proxy", "Routes and manages pooled SQL connections for high availability.")
    Component(Global_Routing_Failover_Monitor, "Global Routing & Failover Monitor", "AWS Route 53 / Aurora Monitor", "Monitors health and orchestrates automatic cross-region failover.")
    Component(Audit_Compliance_Logging_Subsystem, "Audit & Compliance Logging Subsystem", "AWS Database Activity Streams / Kinesis / Lambda", "Streams security and audit events for compliance.")
    Component(Read_Write_Endpoint_Resolver, "Read/Write Endpoint Resolver", "AWS DNS / RDS Endpoint", "Resolves connection endpoints to primary or secondary instances.")
}

Rel(Aurora_Connection_Manager_AWS_RDS_Proxy, Primary_DB_Instance, "Forwards pooled write connections", "TLS/PostgreSQL wire protocol")
Rel(Aurora_Connection_Manager_AWS_RDS_Proxy, Secondary_DB_Instances, "Forwards pooled read connections", "TLS/PostgreSQL wire protocol")
Rel(Primary_DB_Instance, Aurora_Distributed_Storage_Volume, "Persists transaction logs via block-level replication", "Internal AWS Protocol")
Rel(Aurora_Distributed_Storage_Volume, Secondary_DB_Instances, "Cross-region storage replication < 1 second lag", "AWS Backbone Network")
Rel(Primary_DB_Instance, Audit_Compliance_Logging_Subsystem, "Streams security and audit events", "AWS Database Activity Streams / Kinesis")

@enduml