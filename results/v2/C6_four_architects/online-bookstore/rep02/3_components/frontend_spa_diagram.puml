@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(aws_cloudfront, "AWS Route 53 & Amazon CloudFront", "Global CDN and DNS")
System_Ext(bff_container, "BFF Container", "Backend For Frontend")

Container_Boundary(frontend_spa, "Frontend SPA") {
    Component(router_layout_component, "Router & Layout Component", "React Router", "Manages client-side routing via React Router and global layout shells.")
    Component(catalog_search_view, "Catalog & Search View", "React & TypeScript", "Renders product grids and search interfaces.")
    Component(checkout_cart_manager, "Checkout & Cart Manager", "React & TypeScript", "Handles shopping cart state and secure checkout flows.")
    Component(api_client_layer, "API Client Layer", "Axios", "Axios-based abstraction layer for REST/GraphQL communication.")
    Component(state_management_store, "State Management Store", "Redux Toolkit / Zustand", "Localized client state caching and multi-currency preferences (USD, EUR, GBP).")
    Component(consent_privacy_manager, "Consent & Privacy Manager", "React & TypeScript", "Captures user consent preferences to enforce GDPR and CCPA rights.")
    Component(auth_session_handler, "Auth & Session Handler", "React & TypeScript", "Manages user session state and token refresh lifecycles securely in memory.")
    Component(code_split_boundary_lazy_loader, "Code-Split Boundary / Lazy Loader", "React Lazy / Dynamic Import", "Manages dynamic import chunks per route to minimize initial bundle size.")
}

Rel(frontend_spa, aws_cloudfront, "Fetches static assets via", "HTTPS")
Rel(api_client_layer, bff_container, "Communicates exclusively via", "HTTPS/JSON")
Rel(auth_session_handler, bff_container, "Manages authentication tokens through", "HTTPS/JSON")

@enduml