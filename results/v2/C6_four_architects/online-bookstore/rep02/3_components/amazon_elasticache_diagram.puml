@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_elasticache, "Amazon ElastiCache") {
    Component(RedisPrimaryNode, "Redis Primary Node", "Redis Engine / Amazon ElastiCache", "Handles write operations and state management for sessions, cart, and catalogue queries.")
    Component(RedisReadReplicaNodes, "Redis Read Replica Nodes", "Redis Engine", "Offloads read traffic to ensure low-latency queries and high availability.")
    Component(ElastiCacheClusterManager, "ElastiCache Cluster Manager", "AWS Managed Control Plane", "Manages the cluster infrastructure, Multi-AZ with Auto-Failover, and automatic recovery.")
    Component(RedisClusterProxy, "Redis Cluster Proxy", "AWS ElastiCache Data Tiering / OSS Cluster API", "Routes session, cart, and catalogue queries from external services to primary and replica nodes.")
    Component(InMemoryEvictionManager, "In-Memory Eviction Manager", "Redis LRU/LFU Engine (volatile-lru)", "Eviction policy preventing Out-Of-Memory crashes under peak load.")
    Component(BackupSnapshotManager, "Backup & Snapshot Manager", "AWS Automated Backup / Amazon S3", "Exports periodic RDB snapshots for robust disaster recovery.")
    Component(ElastiCacheClusterNodetoNodeEncryptionAuthEngine, "ElastiCache Cluster Node-to-Node Encryption & Auth Engine", "Redis TLS/AUTH (TLS 1.3 & AUTH)", "Secures internal node communication for OWASP compliance.")
}

Rel(RedisPrimaryNode, BackupSnapshotManager, "Exports periodic RDB snapshots", "Internal AWS API")
Rel(RedisClusterProxy, RedisPrimaryNode, "Enforces secure command routing", "RESP over TLS with AUTH")
Rel(RedisClusterProxy, RedisReadReplicaNodes, "Enforces secure command routing", "RESP over TLS with AUTH")

@enduml