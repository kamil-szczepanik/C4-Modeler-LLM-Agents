@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Search & Discovery container

System_Ext(AWS_API_Gateway, "AWS API Gateway", "External API gateway routing client requests.")
System_Ext(Amazon_OpenSearch_Cluster, "Amazon OpenSearch Cluster", "Scalable search and analytics engine.")
System_Ext(Amazon_MSK, "Amazon MSK", "Managed Apache Kafka service for event streaming.")

Container_Boundary(Search_Discovery, "Search & Discovery") {
    Component(Search_API_Controller, "Search API Controller", "Java, Spring Boot", "Processes search requests and coordinates query parsing, aggregation, and analytics.")
    Component(Query_Parser_Matcher, "Query Parser & Matcher", "Apache Lucene Query DSL", "Handles fuzzy matching and relevance scoring using Apache Lucene.")
    Component(Catalog_Synchronization_Consumer, "Catalog Synchronization Consumer", "Java, Apache Kafka Consumer", "Consumes catalog data updates from Amazon MSK to keep search indexes synchronized.")
    Component(Facet_Filter_Aggregator, "Facet & Filter Aggregator", "Java, OpenSearch Aggregations API", "Aggregates facets and filters for search results using OpenSearch.")
    Component(Search_Analytics_Tracker, "Search Analytics Tracker", "Java, Kafka Producer", "Tracks and produces search analytics telemetry data to Amazon MSK.")
}

Rel(AWS_API_Gateway, Search_API_Controller, "gRPC over TLS")
Rel(Search_API_Controller, Query_Parser_Matcher, "In-process")
Rel(Search_API_Controller, Facet_Filter_Aggregator, "In-process")
Rel(Query_Parser_Matcher, Facet_Filter_Aggregator, "In-process")
Rel(Query_Parser_Matcher, Amazon_OpenSearch_Cluster, "HTTPS")
Rel(Facet_Filter_Aggregator, Amazon_OpenSearch_Cluster, "HTTPS")
Rel(Amazon_MSK, Catalog_Synchronization_Consumer, "Kafka Protocol")
Rel(Search_API_Controller, Search_Analytics_Tracker, "In-process")
Rel(Search_Analytics_Tracker, Amazon_MSK, "Kafka Protocol")

@enduml