@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification Worker container

Container_Boundary(notification_worker, "Notification Worker") {
    Component(Kafka_Consumer, "Kafka Consumer", "ECS / Java", "Consumes event streams from Amazon MSK via Kafka protocol over TLS.")
    Component(Preference___Compliance_Filter, "Preference & Compliance Filter", "ECS / Java", "Filters events based on user notification preferences and GDPR/CCPA compliance rules.")
    Component(Template_Renderer, "Template Renderer", "ECS / Java", "Renders notification templates for emails and alerts.")
    Component(Template_Cache_Manager, "Template Cache Manager", "ECS / Amazon ElastiCache", "Manages low-latency caching for notification templates.")
    Component(Dispatch_Adapter, "Dispatch Adapter", "ECS / Java", "Dispatches rendered notifications to external delivery services.")
    Component(DLQ_Handler, "DLQ Handler", "ECS / Java", "Handles dead-letter queue processing for failed notification deliveries.")
}

Rel(Kafka_Consumer, Preference___Compliance_Filter, "Passes raw events for validation")
Rel(Preference___Compliance_Filter, Template_Renderer, "Forwards filtered events for template processing")
Rel(Template_Renderer, Template_Cache_Manager, "Retrieves cached templates")
Rel(Template_Renderer, Dispatch_Adapter, "Sends rendered messages for delivery")
Rel(Dispatch_Adapter, DLQ_Handler, "Routes failed deliveries to DLQ")

@enduml