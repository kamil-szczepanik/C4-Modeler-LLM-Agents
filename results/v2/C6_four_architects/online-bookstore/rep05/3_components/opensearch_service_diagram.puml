@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Catalog_Service, "Catalog Service", "External container interacting with OpenSearch Service")

Container_Boundary(OpenSearch_Service, "OpenSearch Service") {
    Component(Search_API_Handler, "Search API Handler", "Java/Lucene-native REST layer", "Handles HTTP/REST requests for search queries.")
    Component(Security_Access_Control_Component, "Security & Access Control Component", "IAM/RBAC middleware", "Manages security, authentication, and access control.")
    Component(Query_Parser_DSL_Engine, "Query Parser & DSL Engine", "JSON-to-Lucene query tree translator", "Translates JSON queries into Lucene query trees.")
    Component(Indexing_Sharding_Manager, "Indexing & Sharding Manager", "Document routing and distributed shard allocator", "Manages document routing and distributed shard allocation.")
    Component(Cluster_State_Coordinator, "Cluster State Coordinator", "OpenSearch Cluster Manager node role", "Coordinates cluster state and node roles.")
    Component(Data_Nodes, "Data Nodes", "Apache Lucene Indices", "Stores and indexes data using Apache Lucene.")
}

Rel(Catalog_Service, Search_API_Handler, "HTTP/REST (JSON) over TLS 1.3")
Rel(Search_API_Handler, Security_Access_Control_Component, "In-memory middleware hook")
Rel(Security_Access_Control_Component, Query_Parser_DSL_Engine, "In-memory invocation")
Rel(Query_Parser_DSL_Engine, Data_Nodes, "Apache Lucene Java API")
Rel(Cluster_State_Coordinator, Data_Nodes, "Transport Protocol (TCP/Custom)")
Rel(Indexing_Sharding_Manager, Data_Nodes, "Transport Protocol (TCP/Custom)")

@enduml