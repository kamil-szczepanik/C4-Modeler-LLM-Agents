@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aurora_postgresql_database, "Aurora PostgreSQL Database") {
    Component(catalog_database_schema, "Catalog Database Schema", "PostgreSQL, schema-per-service isolation", "Stores book catalogue data with pg_trgm extension for search.")
    Component(order_database_schema, "Order Database Schema", "PostgreSQL, schema-per-service isolation", "Stores order and checkout information.")
    Component(review_database_schema, "Review Database Schema", "PostgreSQL, schema-per-service isolation", "Stores customer reviews and notification metadata.")
}

Rel(catalog_database_schema, order_database_schema, "Maintains relational data boundaries via service isolation", "")

@enduml