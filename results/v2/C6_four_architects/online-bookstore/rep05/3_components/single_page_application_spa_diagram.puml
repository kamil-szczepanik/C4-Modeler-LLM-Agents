@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Single Page Application (SPA) container

System_Ext(api_gateway, "API Gateway", "AWS API Gateway, Lambda Authorizer")

Container_Boundary(spa_container, "Single Page Application (SPA)") {
    Component(router_component, "Router Component", "React, TypeScript", "Handles client-side routing and lazy-loading of application views.")
    Component(catalog_search_view, "Catalog & Search View", "React, TypeScript", "Displays book catalogs, search interfaces, and interacts with the API client layer.")
    Component(checkout_cart_manager, "Checkout & Cart Manager", "React, TypeScript", "Manages user shopping carts and coordinates checkout flows.")
    Component(review_rating_widget, "Review & Rating Widget", "React, TypeScript", "Allows users to view and submit book reviews and ratings.")
    Component(recommendation_display_component, "Recommendation Display Component", "React, TypeScript", "Renders personalized book recommendations to the user.")
    Component(localization_context, "Localization Context", "React Context API", "Provides lightweight multi-currency and localization support.")
    Component(auth_state_manager, "Auth State Manager", "React Context API", "Manages user authentication state and injects tokens into the API client layer.")
    Component(api_client_layer, "API Client Layer", "TypeScript", "Handles HTTP/REST communication with the API Gateway.")
    Component(error_boundary_component, "Error Boundary Component", "React, TypeScript", "Catches and handles runtime errors gracefully across the UI.")
}

Rel(catalog_search_view, api_client_layer, "Sends data requests", "in-memory TypeScript function calls")
Rel(checkout_cart_manager, api_client_layer, "Sends checkout and cart operations", "in-memory TypeScript function calls")
Rel(auth_state_manager, api_client_layer, "Injects auth tokens", "in-memory token injection")
Rel(api_client_layer, api_gateway, "Sends authenticated requests", "HTTPS / REST")

@enduml