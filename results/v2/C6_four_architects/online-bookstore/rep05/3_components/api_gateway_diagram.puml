@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(Rate_Limiter_Component, "Rate Limiter Component", "API Gateway throttling / Amazon Redis", "Supports rate limiting functionality and DDoS mitigation.")
    Component(Auth_Integration_Component, "Auth Integration Component", "AWS Lambda Authorizer / JWT", "Executes edge validation, transformation, and stateless authentication.")
    Component(Request_Validator_Component, "Request Validator Component", "JSON Schema validation", "Enforces payload validation to satisfy OWASP Top-10 security requirements.")
    Component(Route_Dispatcher_Component, "Route Dispatcher Component", "AWS API Gateway routing", "Routes requests via internal Application Load Balancers.")
    Component(Response_Transformer_Component, "Response Transformer Component", "Lambda edge transformation", "Returns service responses and transforms payloads.")
}

Rel(Rate_Limiter_Component, Auth_Integration_Component, "Forwards requests for token validation", "Internal Invocation")
Rel(Auth_Integration_Component, Request_Validator_Component, "Forwards requests with context", "In-memory")
Rel(Request_Validator_Component, Route_Dispatcher_Component, "Forwards sanitized payloads", "In-memory")
Rel(Route_Dispatcher_Component, Response_Transformer_Component, "Routes requests to internal microservices and returns service responses", "HTTPS / REST")

@enduml