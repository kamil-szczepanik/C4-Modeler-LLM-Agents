@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "AWS API Gateway")
System_Ext(catalog_service, "Catalog Service", "Node.js, Express")
System_Ext(order_service, "Order & Checkout Service", "Spring Boot")
System_Ext(recommendation_service, "Recommendation Service", "Python, FastAPI")
System_Ext(cloudwatch, "Amazon CloudWatch", "AWS Monitoring Service")

Container_Boundary(redis_cache, "Redis Cache") {
    Component(session_store, "Session Store", "Amazon ElastiCache for Redis", "Stores and validates user sessions.")
    Component(shopping_cart_store, "Shopping Cart Store", "Amazon ElastiCache for Redis", "Persists shopping cart state.")
    Component(catalogue_cache, "Catalogue Cache", "Amazon ElastiCache for Redis", "Caches product data for fast retrieval.")
    Component(rate_limiting_store, "Rate Limiting Store", "Amazon ElastiCache for Redis", "Checks and manages request counters for rate limiting.")
    Component(persistence_manager, "Redis Persistence & Eviction Manager", "Amazon ElastiCache for Redis", "Manages AOF snapshots and volatile-lru eviction policies.")
    Component(namespace_manager, "Redis Key Namespace & TTL Policy Manager", "Amazon ElastiCache for Redis", "Manages key namespaces and time-to-live policies.")
    Component(telemetry_exporter, "Redis Telemetry & Metrics Exporter", "Amazon ElastiCache for Redis", "Publishes operational metrics to Amazon CloudWatch.")
}

Rel(api_gateway, session_store, "Validates user sessions", "Redis RESP")
Rel(api_gateway, rate_limiting_store, "Checks request counters", "Redis RESP")
Rel(catalog_service, catalogue_cache, "Reads/writes product data", "Redis RESP")
Rel(order_service, shopping_cart_store, "Persists cart state", "Redis RESP")
Rel(recommendation_service, catalogue_cache, "Reads product recommendations", "Redis RESP")
Rel(telemetry_exporter, cloudwatch, "Publishes operational metrics", "AWS CloudWatch API")

@enduml