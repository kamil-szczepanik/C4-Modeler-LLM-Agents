@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Recommendation Service container

System_Ext(api_gateway, "API Gateway", "External API Gateway")
System_Ext(amazon_redis, "Amazon Redis", "External Redis Cache")
System_Ext(catalog_service, "Catalog Service", "External Catalog Service")
System_Ext(amazon_sqs, "Amazon SQS", "External SQS Queue")
System_Ext(amazon_s3, "Amazon S3", "External S3 Bucket")

Container_Boundary(recommendation_service, "Recommendation Service") {
    Component(recommendation_api_controller, "Recommendation API Controller", "FastAPI", "Handles incoming REST requests over HTTPS from the API Gateway.")
    Component(recommendation_engine_core, "Recommendation Engine Core", "Python, NumPy, Scikit-learn", "Executes collaborative filtering algorithms.")
    Component(cache_repository, "Cache Repository", "Redis Client", "Interfaces with Amazon Redis via TCP for hot recommendations.")
    Component(data_enrichment_client, "Data Enrichment Client", "httpx", "Fetches real-time book metadata from the Catalog Service.")
    Component(event_consumer, "Event Consumer", "SQS Worker", "Consumes order and clickstream events asynchronously from Amazon SQS.")
    Component(offline_training_pipeline, "Offline Training Pipeline", "AWS SageMaker Job", "Computes model weights and embeddings.")
    Component(model_loader___feature_store_client, "Model Loader / Feature Store Client", "HTTP/HTTPS Client", "Fetches serialized models and embeddings from Amazon S3 over HTTPS.")
}

Rel(api_gateway, recommendation_api_controller, "Routes REST requests", "HTTPS")
Rel(recommendation_api_controller, cache_repository, "Queries hot recommendations", "TCP / Redis Protocol")
Rel(cache_repository, amazon_redis, "Reads/Writes hot data", "TCP")
Rel(recommendation_engine_core, data_enrichment_client, "Fetches book metadata", "HTTP/REST")
Rel(data_enrichment_client, catalog_service, "Requests catalog info", "HTTP/REST")
Rel(recommendation_engine_core, model_loader___feature_store_client, "Retrieves embeddings", "HTTPS / S3 API")
Rel(model_loader___feature_store_client, amazon_s3, "Downloads models", "HTTPS")
Rel(event_consumer, amazon_sqs, "Consumes real-time interaction updates", "AMQP / HTTPS")
Rel(offline_training_pipeline, amazon_s3, "Stores computed weights", "HTTPS")

@enduml