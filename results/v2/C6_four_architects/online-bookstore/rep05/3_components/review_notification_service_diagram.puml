@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Review & Notification Service container

Component(API_Gateway, "API Gateway", "Gateway", "External system routing traffic to the Review Controller.")
Component_Ext(Aurora_PostgreSQL_Database, "Aurora PostgreSQL Database", "PostgreSQL", "Database storing review and notification data.")
Component_Ext(Amazon_SQS, "Amazon SQS", "AWS SQS", "Message queue service for asynchronous notifications.")
Component_Ext(SendGrid_AWS_SES, "SendGrid/AWS SES", "HTTPS / REST APIs", "External email and notification service providers.")

Container_Boundary(Review_Notification_Service, "Review & Notification Service") {
    Component(Review_Controller, "Review Controller", "Node.js & NestJS REST", "Exposes REST endpoints for review submission and retrieval.")
    Component(Review_Service, "Review Service", "Node.js & NestJS", "Manages review business logic and domain event publishing.")
    Component(Moderation_Service, "Moderation Service", "Node.js & NestJS", "Sanitizes review text using compliance checks.")
    Component(Review_Repository, "Review Repository", "TypeORM", "Encapsulates database access using TypeORM.")
    Component(Review_Cache_Component, "Review Cache Component", "Amazon Redis / Redis TCP/RESP", "Interfaces with Redis for caching top reviews.")
    Component(Notification_Consumer, "Notification Consumer", "AWS SDK (v3) / Amazon SQS", "Processes background messages from message queues.")
    Component(Template_Engine, "Template Engine", "Handlebars", "Compiles localized notification templates using Handlebars.")
    Component(Notification_Dispatcher, "Notification Dispatcher", "SendGrid/AWS SES / HTTPS REST APIs", "Sends emails via external notification APIs.")
}

Rel(API_Gateway, Review_Controller, "HTTPS / REST")
Rel(Review_Service, Review_Cache_Component, "Redis TCP/RESP protocol")
Rel(Review_Repository, Aurora_PostgreSQL_Database, "Native TCP/TLS")
Rel(Notification_Consumer, Amazon_SQS, "Long Polling")
Rel(Notification_Dispatcher, SendGrid_AWS_SES, "HTTPS / REST APIs")

@enduml