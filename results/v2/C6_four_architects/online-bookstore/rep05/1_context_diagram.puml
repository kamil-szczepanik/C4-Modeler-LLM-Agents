@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Online Bookstore

Person(Customer, "Customer", "End-user browsing, reviewing, and purchasing books via web or mobile.")

System(Online Bookstore, "Online Bookstore", "A scaled-down Amazon-style e-commerce platform designed to provide browsing, searching, purchasing, reviews, and personalized recommendations for physical and electronic books.")

System_Ext(Stripe/PayPal, "Stripe/PayPal", "Payment gateway for processing transactions.")
System_Ext(FedEx/UPS, "FedEx/UPS", "Shipping provider APIs for handling order delivery.")
System_Ext(Auth0/AWS Cognito, "Auth0/AWS Cognito", "Identity and OIDC provider for authentication.")
System_Ext(SendGrid/AWS SES, "SendGrid/AWS SES", "Email and notification service.")
System_Ext(Avalara/TaxJar, "Avalara/TaxJar", "Tax calculation service.")

Rel(Customer, Online Bookstore, "Browses, reviews, and purchases books", "HTTPS")
Rel(Online Bookstore, Stripe/PayPal, "Processes payments", "REST APIs over TLS 1.3")
Rel(Online Bookstore, FedEx/UPS, "Manages shipping and delivery", "REST APIs over TLS 1.3")
Rel(Online Bookstore, Auth0/AWS Cognito, "Authenticates users", "OIDC / OAuth2 / REST over TLS 1.3")
Rel(Online Bookstore, SendGrid/AWS SES, "Sends notifications and emails", "REST APIs over TLS 1.3")
Rel(Online Bookstore, Avalara/TaxJar, "Calculates taxes", "REST APIs over TLS 1.3")

@enduml