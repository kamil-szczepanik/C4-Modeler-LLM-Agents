@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "End-user browsing, reviewing, and purchasing books via web or mobile.")

System_Ext(Stripe_PayPal, "Stripe/PayPal", "Payment gateway for processing transactions.")
System_Ext(FedEx_UPS, "FedEx/UPS", "Shipping provider APIs for handling order delivery.")
System_Ext(Auth0_AWS_Cognito, "Auth0/AWS Cognito", "Identity and OIDC provider for authentication.")
System_Ext(SendGrid_AWS_SES, "SendGrid/AWS SES", "Email and notification service.")
System_Ext(Avalara_TaxJar, "Avalara/TaxJar", "Tax calculation service.")

System_Boundary(Online_Bookstore, "Online Bookstore") {
    Container(Single_Page_Application_SPA, "Single Page Application (SPA)", "React, TypeScript, Amazon S3, Amazon CloudFront", "Provides the user interface for browsing, searching, purchasing, and reviewing books globally with sub-2-second page loads.")
    Container(API_Gateway, "API Gateway", "AWS API Gateway, Lambda Authorizer", "Acts as the single secure entry point routing incoming HTTPS/REST requests to internal microservices.")
    Container(Catalog_Service, "Catalog Service", "Node.js, Express", "Manages book catalog data, categories, and inventory details.")
    Container(Order___Checkout_Service, "Order & Checkout Service", "Spring Boot", "Handles shopping carts, checkout workflows, and order processing.")
    Container(Recommendation_Service, "Recommendation Service", "Python, FastAPI", "Generates AI-driven personalized book recommendations for users.")
    Container(Review___Notification_Service, "Review & Notification Service", "Node.js / Container", "Handles customer reviews and asynchronous notifications.")
    Container(Message_Broker, "Message Broker", "Amazon SNS, Amazon SQS", "Handles asynchronous event-driven workflows across microservices.")
    ContainerDb(Aurora_PostgreSQL_Database, "Aurora PostgreSQL Database", "Amazon Aurora PostgreSQL", "Managed database-per-service data tier providing strict isolation for GDPR compliance.")
    ContainerDb(OpenSearch_Service, "OpenSearch Service", "Amazon OpenSearch Service", "Provides sub-second search capabilities across the catalog.")
    ContainerDb(Redis_Cache, "Redis Cache", "Amazon Redis", "Provides fast in-memory caching and session management.")
}

Rel(Customer, Single_Page_Application_SPA, "Browses and interacts with the store", "HTTPS")
Rel(Single_Page_Application_SPA, API_Gateway, "Sends API requests", "HTTPS / REST")
Rel(API_Gateway, Catalog_Service, "Routes catalog requests", "HTTPS / REST via internal Application Load Balancers")
Rel(API_Gateway, Order___Checkout_Service, "Routes order and checkout requests", "HTTPS / REST via internal Application Load Balancers")
Rel(API_Gateway, Recommendation_Service, "Routes recommendation requests", "HTTPS / REST via internal Application Load Balancers")
Rel(API_Gateway, Review___Notification_Service, "Routes review and notification requests", "HTTPS / REST via internal Application Load Balancers")
Rel(Catalog_Service, Aurora_PostgreSQL_Database, "Reads and writes catalog data", "Native TCP/TLS drivers (PostgreSQL wire protocol)")
Rel(Order___Checkout_Service, Aurora_PostgreSQL_Database, "Reads and writes order data", "Native TCP/TLS drivers (PostgreSQL wire protocol)")
Rel(Review___Notification_Service, Aurora_PostgreSQL_Database, "Reads and writes review data", "Native TCP/TLS drivers (PostgreSQL wire protocol)")
Rel(Catalog_Service, OpenSearch_Service, "Indexes and queries catalog search data", "OpenSearch REST API")
Rel(Order___Checkout_Service, Redis_Cache, "Caches session and cart data", "Redis RESP")
Rel(Order___Checkout_Service, Message_Broker, "Publishes order events", "JSON event publishing via Amazon SNS/SQS")
Rel(Review___Notification_Service, Message_Broker, "Publishes and consumes notification events", "JSON event consumption/publishing via Amazon SNS/SQS")
Rel(Order___Checkout_Service, Stripe_PayPal, "Processes payments", "HTTPS / REST APIs")
Rel(Order___Checkout_Service, Avalara_TaxJar, "Calculates taxes", "HTTPS / REST APIs")
Rel(Order___Checkout_Service, FedEx_UPS, "Manages shipping and delivery", "HTTPS / REST APIs")
Rel(API_Gateway, Auth0_AWS_Cognito, "Authenticates requests via Lambda Authorizer", "OIDC / OAuth2 / HTTPS")
Rel(Review___Notification_Service, SendGrid_AWS_SES, "Sends emails and notifications", "HTTPS / REST APIs")

@enduml