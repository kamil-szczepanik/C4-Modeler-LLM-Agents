@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "End user browsing physical and electronic books, making purchases, and writing reviews.")
Person(Store_Administrator, "Store Administrator", "Manager overseeing product catalogue, orders, and store operations.")

System(E_Commerce_Book_Store, "E-Commerce Book Store", "A scaled-down Amazon-style e-commerce site for physical and electronic books with recommendations and reviews, serving 1M MAU.")

System_Ext(Payment_Gateway, "Payment Gateway", "Stripe or PayPal for processing financial transactions.")
System_Ext(Third_Party_Shipping_API, "Third-Party Shipping API", "FedEx or UPS for handling order fulfillment and shipping.")
System_Ext(Notification_Service, "Notification Service", "AWS SES for sending emails and notifications.")
System_Ext(Currency_Exchange_Rate_API, "Currency Exchange Rate API", "External service providing currency conversion rates.")

Rel(Customer, E_Commerce_Book_Store, "Browses catalogue, manages cart, places orders, and reads reviews", "HTTPS")
Rel(Store_Administrator, E_Commerce_Book_Store, "Manages store inventory, orders, and system administration", "HTTPS")
Rel(E_Commerce_Book_Store, Payment_Gateway, "Processes secure payments", "HTTPS/REST")
Rel(E_Commerce_Book_Store, Third_Party_Shipping_API, "Coordinates order shipping and tracking", "HTTPS/REST")
Rel(E_Commerce_Book_Store, Notification_Service, "Sends customer notifications and emails", "AWS SES")
Rel(E_Commerce_Book_Store, Currency_Exchange_Rate_API, "Fetches current exchange rates", "HTTPS/REST")

@enduml