@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_api_gateway, "AWS API Gateway") {
    Component(Custom Domain & SSL/TLS Termination, "Custom Domain & SSL/TLS Termination", "AWS Certificate Manager & Route 53", "Handles custom domain routing and SSL/TLS certificate termination at the edge.")
    Component(AWS WAF, "AWS WAF", "AWS WAF", "Protects APIs against common web exploits and OWASP Top-10 vulnerabilities.")
    Component(Amazon Cognito JWT Authorizer, "Amazon Cognito JWT Authorizer", "Amazon Cognito", "Validates JSON Web Tokens (JWT) for secure authentication and authorization.")
    Component(API Router & Validator, "API Router & Validator", "AWS API Gateway", "Routes incoming requests to appropriate downstream services and validates request payloads.")
    Component(API Gateway Usage Plans & Throttling, "API Gateway Usage Plans & Throttling", "AWS API Gateway", "Manages rate limits and usage plans to control traffic and prevent abuse.")
    Component(Request Transformer, "Request Transformer", "AWS API Gateway", "Transforms request and response payloads between the client and backend services.")
    Component(Endpoint Logging & Metrics, "Endpoint Logging & Metrics", "Amazon CloudWatch", "Captures logs and operational metrics for monitoring and auditing.")
    Component(Mock / Documentation, "Mock / Documentation", "OpenAPI / Swagger", "Provides API mock integrations and interactive API documentation.")
}

Rel(Custom Domain & SSL/TLS Termination, AWS WAF, "Inspects incoming secure traffic")
Rel(AWS WAF, Amazon Cognito JWT Authorizer, "Passes filtered requests for authentication")
Rel(Amazon Cognito JWT Authorizer, API Router & Validator, "Forwards authenticated requests for routing and validation")
Rel(API Router & Validator, API Gateway Usage Plans & Throttling, "Applies throttling limits")
Rel(API Gateway Usage Plans & Throttling, Request Transformer, "Transforms validated requests")
Rel(Request Transformer, Endpoint Logging & Metrics, "Logs request execution details")

@enduml