@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the React Single-Page Application (SPA) container

Container_Boundary(react_spa, "React Single-Page Application (SPA)") {
    Component(RoutingShell, "Routing & Shell Component", "React Router, Vite", "Manages application routing, layout shell, and global context provision.")
    Component(CatalogueSearch, "Catalogue & Search View", "React, Zustand", "Displays book catalogue and search results with local state management.")
    Component(CheckoutCart, "Checkout & Cart Workflow Component", "React", "Handles shopping cart state and the checkout process.")
    Component(RecommendationReview, "Recommendation & Review Widget", "React", "Displays product recommendations and user reviews.")
    Component(LocalizationCurrency, "Localization & Currency Context", "React Context", "Manages localization settings and currency formatting.")
    Component(ApiClientService, "API Client Service", "TanStack React Query, Axios", "Handles server-state caching, data fetching, and REST API communication.")
}

System_Ext(CloudFrontS3, "AWS CloudFront & Amazon S3", "Edge Delivery, Static Hosting", "Provides global content delivery and static asset hosting.")
System_Ext(ApiGateway, "AWS API Gateway", "AWS", "Acts as the backend interface and API gateway.")

Rel(CloudFrontS3, RoutingShell, "[HTTPS]")
Rel(RoutingShell, CatalogueSearch, "React props/context")
Rel(RoutingShell, CheckoutCart, "React props/context")
Rel(RoutingShell, RecommendationReview, "React props/context")
Rel(CatalogueSearch, ApiClientService, "Function invocation / REST wrapper")
Rel(CheckoutCart, ApiClientService, "Function invocation / REST wrapper")
Rel(RecommendationReview, ApiClientService, "Function invocation / REST wrapper")
Rel(ApiClientService, ApiGateway, "[HTTPS/REST]")

@enduml