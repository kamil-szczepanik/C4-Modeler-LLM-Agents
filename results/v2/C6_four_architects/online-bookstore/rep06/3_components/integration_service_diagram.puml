@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Service container

Container_Boundary(integration_service, "Integration Service") {
    Component(Payment_Orchestrator_Component, "Payment Orchestrator Component", "Node.js with TypeScript", "Orchestrates payment processing with external gateways.")
    Component(Shipping_Adaptor_Component, "Shipping Adaptor Component", "Node.js with TypeScript", "Coordinates fulfillment with third-party shipping APIs.")
    Component(Currency_Sync_Worker_Component, "Currency Sync Worker Component", "Node.js with TypeScript", "Fetches currency exchange rates and updates cache.")
    Component(Integration_Message_Consumer_Component, "Integration Message Consumer Component", "Node.js with TypeScript, Amazon SQS", "Consumes messages for asynchronous task distribution.")
    Component(Notification_Dispatcher_Component, "Notification Dispatcher Component", "Node.js with TypeScript", "Dispatches alerts to the notification service.")
    Component(Integration_State_Store_Client_Component, "Integration State Store Client Component", "Node.js with TypeScript, pg", "Persists outbox state in the relational database.")
}

System_Ext(Payment_Gateway, "Payment Gateway", "External API", "Processes secure payments.")
System_Ext(Third_Party_Shipping_API, "Third-Party Shipping API", "External API", "Coordinates order fulfillment.")
System_Ext(Currency_Exchange_Rate_API, "Currency Exchange Rate API", "External API", "Provides currency exchange rates.")
Container(Notification_Service, "Notification Service", "Container", "Sends alerts.")
ContainerDb(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Relational Database", "Transactional outbox pattern and auditability storage.")
ContainerDb(Amazon_ElastiCache_Redis, "Amazon ElastiCache (Redis)", "Redis", "Caches currency exchange rates.")
System_Ext(Amazon_SQS, "Amazon SQS", "Message Queue", "Asynchronous task distribution queue.")

Rel(Integration_Message_Consumer_Component, Integration_State_Store_Client_Component, "Persists outbox state", "SQL/TCP")
Rel(Integration_Message_Consumer_Component, Payment_Orchestrator_Component, "Internal dispatch", "In-Memory Function Call")
Rel(Integration_Message_Consumer_Component, Shipping_Adaptor_Component, "Internal dispatch", "In-Memory Function Call")
Rel(Integration_Message_Consumer_Component, Notification_Dispatcher_Component, "Internal dispatch", "In-Memory Function Call")
Rel(Payment_Orchestrator_Component, Payment_Gateway, "Processes secure payments", "HTTPS/REST")
Rel(Shipping_Adaptor_Component, Third_Party_Shipping_API, "Coordinates fulfillment", "HTTPS/REST")
Rel(Notification_Dispatcher_Component, Notification_Service, "Sends alerts", "HTTPS/REST")
Rel(Currency_Sync_Worker_Component, Currency_Exchange_Rate_API, "Fetches rates", "HTTPS/REST")
Rel(Currency_Sync_Worker_Component, Amazon_ElastiCache_Redis, "Updates exchange rates", "Redis Protocol")
@enduml