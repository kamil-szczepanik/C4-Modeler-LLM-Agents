@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon EventBridge container

Container_Boundary(amazon_eventbridge, "Amazon EventBridge") {
    Component(Event_Bus, "Event Bus", "AWS EventBridge Service", "Receives domain events from the Core E-Commerce Service and routes them asynchronously.")
    Component(Rule_Router, "Rule Router", "EventBridge Routing Rules", "Evaluates event patterns and dispatches payloads to appropriate downstream targets.")
}

Rel(Event_Bus, Rule_Router, "Evaluates incoming events against routing rules", "AWS Internal")

@enduml