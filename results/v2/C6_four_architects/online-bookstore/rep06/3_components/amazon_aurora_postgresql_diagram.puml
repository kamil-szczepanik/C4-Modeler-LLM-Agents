@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_aurora_postgresql, "Amazon Aurora PostgreSQL") {
    Component(Relational_Database_Engine, "Relational Database Engine", "PostgreSQL 15+", "Handles core relational data management and ACID-compliant transactions for the e-commerce platform.")
    Component(Aurora_Storage_Volume, "Aurora Storage Volume", "Distributed Storage", "Provides scalable, fault-tolerant cloud storage underlying the Aurora database cluster.")
    Component(Read_Replica_Endpoint, "Read Replica Endpoint", "PostgreSQL Replica", "Serves read-heavy queries to offload traffic from the primary database instance.")
    Component(Aurora_Global_Database_Extension, "Aurora Global Database Extension", "Cross-Region Replication", "Enables fast local reads and low-latency global disaster recovery through asynchronous cross-region replication.")
    Component(PostgreSQL_Audit_pgaudit, "PostgreSQL Audit (pgaudit)", "pgaudit Extension", "Generates detailed session and object audit logging to satisfy strict compliance constraints like GDPR and CCPA.")
    Component(Connection_Pooler_RDS_Proxy, "Connection Pooler (RDS Proxy)", "RDS Proxy", "Manages and multiplexes database connections efficiently to support high concurrency from core services.")
    Component(Automated_Backup_Subsystem, "Automated Backup Subsystem", "WAL streaming / Amazon S3", "Streams Write-Ahead Logs (WAL) to Amazon S3 to provide automated point-in-time recovery and backups.")
}

System_Ext(Secondary_Region_Storage, "Secondary Region Storage", "External AWS Region Storage")

Rel(Aurora_Global_Database_Extension, Secondary_Region_Storage, "Asynchronous replication across AWS regions", "Cross-Region Replication")
Rel(Relational_Database_Engine, Automated_Backup_Subsystem, "WAL streaming to Amazon S3", "WAL streaming")
@enduml