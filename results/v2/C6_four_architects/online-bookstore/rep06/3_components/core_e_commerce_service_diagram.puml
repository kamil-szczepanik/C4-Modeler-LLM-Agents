@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(core_ecommerce_service, "Core E-Commerce Service") {
    Component(CatalogComponent, "Catalog Component", "NestJS Module / TypeScript", "Manages book browsing, keyword searches, and product details.")
    Component(CartManagementComponent, "Cart Management Component", "NestJS Module / TypeScript", "Handles shopping cart state and low-latency session caching.")
    Component(CheckoutOrderProcessingComponent, "Checkout & Order Processing Component", "NestJS Module / TypeScript", "Orchestrates secure transactions and multi-currency pricing.")
    Component(RatingReviewComponent, "Rating & Review Component", "NestJS Module / TypeScript", "Manages customer reviews and 5-star ratings.")
    Component(CurrencyConversionComponent, "Currency Conversion Component", "NestJS Module / TypeScript", "Resolves dynamic pricing across USD, EUR, and GBP.")
    Component(ShippingIntegrationComponent, "Shipping Integration Component", "NestJS Module / TypeScript", "Coordinates asynchronous third-party shipping API calls.")
    Component(InventoryManagementComponent, "Inventory Management Component", "NestJS Module / TypeScript", "Validates and reserves stock levels to prevent overselling.")
    Component(EventDispatcherComponent, "Event Dispatcher Component", "NestJS Module / TypeScript", "Publishes domain events asynchronously.")
    
    ComponentDb(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL", "Relational Database", "Stores transactional data for orders, catalog, and reviews.")
    ComponentDb(AmazonDynamoDBAmazonElastiCacheRedis, "Amazon DynamoDB & Amazon ElastiCache (Redis)", "NoSQL & In-Memory Cache", "Persists session/cart state and caches currency rates.")
    Component(AmazonSQS, "Amazon SQS", "Message Queue", "Triggers shipping integration tasks.")
    Component(AmazonEventBridge, "Amazon EventBridge", "Event Bus", "Publishes domain events such as OrderPlaced and ReviewAdded.")
}

Rel(CatalogComponent, AmazonAuroraPostgreSQL, "Reads and writes transactional data", "SQL/TLS via TypeORM")
Rel(CheckoutOrderProcessingComponent, AmazonAuroraPostgreSQL, "Reads and writes transactional data", "SQL/TLS via TypeORM")
Rel(InventoryManagementComponent, AmazonAuroraPostgreSQL, "Reads and writes transactional data", "SQL/TLS via TypeORM")
Rel(RatingReviewComponent, AmazonAuroraPostgreSQL, "Reads and writes transactional data", "SQL/TLS via TypeORM")
Rel(CartManagementComponent, AmazonDynamoDBAmazonElastiCacheRedis, "Persists session/cart state", "Redis Protocol / TLS")
Rel(CheckoutOrderProcessingComponent, AmazonSQS, "Triggers shipping integration tasks", "AWS SDK / HTTPS")
Rel(EventDispatcherComponent, AmazonEventBridge, "Publishes domain events", "AWS SDK / HTTPS")
Rel(CatalogComponent, CurrencyConversionComponent, "Executes synchronous business logic", "TypeScript interfaces / In-Process Method Calls")
Rel(CheckoutOrderProcessingComponent, CurrencyConversionComponent, "Executes synchronous business logic", "TypeScript interfaces / In-Process Method Calls")
Rel(CheckoutOrderProcessingComponent, InventoryManagementComponent, "Executes synchronous business logic", "TypeScript interfaces / In-Process Method Calls")
Rel(CheckoutOrderProcessingComponent, EventDispatcherComponent, "Executes synchronous business logic", "TypeScript interfaces / In-Process Method Calls")
Rel(RatingReviewComponent, EventDispatcherComponent, "Executes synchronous business logic", "TypeScript interfaces / In-Process Method Calls")
@enduml