@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Component(Core_E_Commerce_Service, "Core E-Commerce Service", "AWS SDK", "Reads/writes cart state and validates/updates session state.")
Component(Amazon_EventBridge, "Amazon EventBridge", "Amazon EventBridge", "Receives forwarded cart abandonment events.")

Container_Boundary(Amazon_DynamoDB, "Amazon DynamoDB") {
    Component(Cart_Table_Component, "Cart Table Component", "Amazon DynamoDB Table", "Stores transient shopping cart items using partition key userId and sort key cartId.")
    Component(Session_Table_Component, "Session Table Component", "Amazon DynamoDB Table with Global Tables", "Stores user session states with automatic TTL cleanup and multi-active cross-region replication.")
    Component(DynamoDB_Encryption_Component, "DynamoDB Encryption Component", "AWS KMS", "Enforces data encryption at rest using AWS KMS.")
    Component(DynamoDB_Streams_Component, "DynamoDB Streams Component", "DynamoDB Streams", "Captures item modifications for real-time change data capture.")
    Component(DynamoDB_PITR, "DynamoDB PITR", "Amazon DynamoDB PITR", "Provides continuous backups for data durability.")
}

Rel(Core_E_Commerce_Service, Cart_Table_Component, "Reads and writes cart state", "HTTPS / TLS 1.3")
Rel(Core_E_Commerce_Service, Session_Table_Component, "Validates and updates session state", "HTTPS / TLS 1.3")
Rel(Cart_Table_Component, DynamoDB_Encryption_Component, "Encrypts stored PII data at rest", "AWS KMS API / TLS 1.3")
Rel(Session_Table_Component, DynamoDB_Encryption_Component, "Encrypts stored PII data at rest", "AWS KMS API / TLS 1.3")
Rel(Cart_Table_Component, DynamoDB_Streams_Component, "Emits cart abandonment events", "AWS Internal")
Rel(DynamoDB_Streams_Component, Amazon_EventBridge, "Forwards cart abandonment events", "AWS SDK / TLS 1.3")

@enduml