@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(recommendation_engine, "Recommendation Engine") {
    Component(ApiRouter, "API Router / Controller", "FastAPI", "Handles incoming HTTP requests and routes them to internal recommendation services.")
    Component(RecommendationService, "Recommendation Service", "Python", "Orchestrates personalized book recommendations and 'customers also bought' suggestions.")
    Component(ModelScoringAgent, "Model Scoring Agent", "Python / scikit-learn / PyTorch", "Scores models to generate real-time recommendations.")
    Component(DataAccessRepository, "Data Access Repository", "SQLAlchemy / Boto3", "Interfaces with underlying data stores for profile and search operations.")
    Component(EventIngestionListener, "Event Ingestion Listener", "Python / Celery or asyncio worker", "Listens for asynchronous events and ingestion tasks.")
    Component(ModelTrainingPipeline, "Model Training Pipeline / Job Scheduler", "Python / AWS SageMaker / ECS Scheduled Tasks", "Handles offline machine learning model training and scheduled jobs.")
    Component(RecommendationCacheManager, "Recommendation Cache Manager", "Python / Redis Client", "Manages in-memory caching to serve instant recommendations and protect the scoring engine.")
}

Rel(ApiRouter, RecommendationService, "Delegates recommendation requests", "HTTPS/JSON")
Rel(RecommendationService, ModelScoringAgent, "Requests model scoring", "In-process")
Rel(RecommendationService, RecommendationCacheManager, "Fetches and stores cached recommendations", "Redis protocol")
Rel(ModelScoringAgent, DataAccessRepository, "Retrieves profile and search data", "TCP/HTTPS")
Rel(EventIngestionListener, DataAccessRepository, "Persists ingested event data", "TCP/HTTPS")
Rel(ModelTrainingPipeline, DataAccessRepository, "Reads and writes historical training data", "TCP/SQL")
@enduml