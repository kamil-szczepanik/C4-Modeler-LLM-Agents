@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(search_analytics_service, "Search & Analytics Service") {
    Component(QueryAPIController, "Query API Controller", "Node.js/TypeScript on AWS Lambda", "Routes search requests and executes full-text searches.")
    Component(IndexingWorker, "Indexing Worker", "Python on AWS Lambda", "Triggers index updates and performs bulk updates and indexes data.")
    Component(AnalyticsAggregator, "Analytics Aggregator", "Python on AWS Lambda", "Publishes clickstream metrics.")
    Component(SearchCacheLayer, "Search Cache Layer", "Amazon ElastiCache for Redis", "Caches frequent query results.")
    Component(OpenSearchIndexCluster, "OpenSearch Index Cluster", "Amazon OpenSearch Service", "Provides distributed full-text search and analytical capabilities.")
    Component(AWSAPIGateway, "AWS API Gateway", "AWS API Gateway", "Routes search requests to the Query API Controller.")
    Component(AmazonSQSAmazonEventBridge, "Amazon SQS / Amazon EventBridge", "Amazon SQS / Amazon EventBridge", "Enables reliable asynchronous event-driven synchronization.")
}

Rel(AWSAPIGateway, QueryAPIController, "Routes search requests", "HTTPS/REST")
Rel(QueryAPIController, SearchCacheLayer, "Caches frequent query results", "Redis protocol")
Rel(QueryAPIController, OpenSearchIndexCluster, "Executes full-text searches", "HTTPS/REST")
Rel(AmazonSQSAmazonEventBridge, IndexingWorker, "Triggers index updates", "JSON over SQS")
Rel(IndexingWorker, OpenSearchIndexCluster, "Bulk updates and indexes data", "HTTPS/REST")
Rel(AnalyticsAggregator, AmazonSQSAmazonEventBridge, "Publishes clickstream metrics", "JSON over EventBridge")
@enduml