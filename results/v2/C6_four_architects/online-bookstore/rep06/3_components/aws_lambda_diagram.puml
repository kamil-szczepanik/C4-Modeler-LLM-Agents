@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS Lambda container

Container_Boundary(aws_lambda, "AWS Lambda") {
    Component(Order Confirmation Processor, "Order Confirmation Processor", "Node.js / TypeScript", "Processes order confirmations by subscribing to Amazon SQS / SNS.")
    Component(Shipping Webhook Handler, "Shipping Webhook Handler", "Node.js / TypeScript", "Handles shipping webhooks invoked via AWS API Gateway.")
    Component(Data Anonymizer, "Data Anonymizer", "Python 3.11", "Performs scheduled data anonymization interacting with Amazon Aurora PostgreSQL.")
    Component(Audit Log Exporter, "Audit Log Exporter", "Python 3.11", "Exports audit logs for compliance and reporting.")
    Component(Image Thumbnail Generator, "Image Thumbnail Generator", "Python 3.11", "Generates image thumbnails triggered by Amazon S3 object-creation events.")
}

System_Ext(AWS API Gateway, "AWS API Gateway", "API Gateway")
System_Ext(Amazon SQS / SNS, "Amazon SQS / SNS", "Messaging and Notification")
System_Ext(Amazon EventBridge, "Amazon EventBridge", "Event Bus")
System_Ext(Amazon Aurora PostgreSQL, "Amazon Aurora PostgreSQL", "Database")
System_Ext(Amazon S3, "Amazon S3", "Object Storage")
System_Ext(AWS Secrets Manager, "AWS Secrets Manager", "Secrets Management")
System_Ext(Amazon CloudWatch, "Amazon CloudWatch", "Logging and Monitoring")

Rel(Shipping Webhook Handler, AWS API Gateway, "Invoked via HTTPS", "HTTPS")
Rel(Order Confirmation Processor, Amazon SQS / SNS, "Subscribes via AWS SDK (SigV4)", "AWS SDK")
Rel(Data Anonymizer, Amazon EventBridge, "Scheduled via", "EventBridge")
Rel(Data Anonymizer, Amazon Aurora PostgreSQL, "Interacts via AWS SDK (SigV4)", "AWS SDK")
Rel(Image Thumbnail Generator, Amazon S3, "Triggered by object-creation events using AWS SDK (SigV4)", "AWS SDK")
Rel(Order Confirmation Processor, AWS Secrets Manager, "Fetches credentials", "HTTPS")
Rel(Shipping Webhook Handler, AWS Secrets Manager, "Fetches credentials", "HTTPS")
Rel(Data Anonymizer, AWS Secrets Manager, "Fetches credentials", "HTTPS")
Rel(Audit Log Exporter, AWS Secrets Manager, "Fetches credentials", "HTTPS")
Rel(Image Thumbnail Generator, AWS Secrets Manager, "Fetches credentials", "HTTPS")
Rel(Order Confirmation Processor, Amazon CloudWatch, "Emits structured JSON logs", "stdout")
Rel(Shipping Webhook Handler, Amazon CloudWatch, "Emits structured JSON logs", "stdout")
Rel(Data Anonymizer, Amazon CloudWatch, "Emits structured JSON logs", "stdout")
Rel(Audit Log Exporter, Amazon CloudWatch, "Emits structured JSON logs", "stdout")
Rel(Image Thumbnail Generator, Amazon CloudWatch, "Emits structured JSON logs", "stdout")

@enduml