@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon ElastiCache (Redis) container

Person(Core E_Commerce Service, "Core E-Commerce Service", "External service interacting with the cache")
Person(Recommendation Engine, "Recommendation Engine", "External service interacting with the cache")
Person(Integration Service, "Integration Service", "External service interacting with the cache")
Person(AWS CloudWatch, "AWS CloudWatch", "External monitoring service")

Container_Boundary(Amazon ElastiCache (Redis), "Amazon ElastiCache (Redis)") {
    Component(Session Store Component, "Session Store Component", "Amazon ElastiCache for Redis", "Stores user session data for fast retrieval and persistence across requests.")
    Component(Catalog Cache Component, "Catalog Cache Component", "Amazon ElastiCache for Redis", "Caches book catalog and product details to ensure sub-2-second page loads.")
    Component(Rate Limiter / Token Bucket Component, "Rate Limiter / Token Bucket Component", "Amazon ElastiCache for Redis, Lua scripting", "Controls request rates and enforces token bucket algorithm for API throttling.")
    Component(Distributed Lock Component, "Distributed Lock Component", "Amazon ElastiCache for Redis, Lua scripting", "Provides atomic execution for distributed locking and inventory management.")
    Component(Pub/Sub Broker Component, "Pub/Sub Broker Component", "Amazon ElastiCache for Redis", "Handles asynchronous messaging and event broadcasting between internal services.")
    Component(Shopping Cart & Checkout Cache Component, "Shopping Cart & Checkout Cache Component", "Amazon ElastiCache for Redis", "Temporarily holds active shopping cart and secure checkout state.")
    Component(Metrics & Slow-Log Collector, "Metrics & Slow-Log Collector", "Amazon CloudWatch Agent / Redis INFO API", "Gathers performance metrics, slow logs, and health status for monitoring.")
    Component(Redis Auth & ACL Enforcement, "Redis Auth & ACL Enforcement", "Redis AUTH & ACL", "Enforces security compliance via user/password credentials and access control lists over TLS.")
    Component(Redis Eviction Engine, "Redis Eviction Engine", "volatile-lru eviction policy", "Manages automated memory cleanup to prevent out-of-memory crashes.")
}

Rel(Core E_Commerce Service, Session Store Component, "Redis RESP protocol over TLS", "Redis RESP")
Rel(Core E_Commerce Service, Catalog Cache Component, "Redis RESP protocol over TLS", "Redis RESP")
Rel(Core E_Commerce Service, Shopping Cart & Checkout Cache Component, "Redis RESP protocol over TLS", "Redis RESP")
Rel(Core E_Commerce Service, Distributed Lock Component, "Redis RESP protocol over TLS", "Redis RESP")
Rel(Core E_Commerce Service, Pub/Sub Broker Component, "Redis RESP protocol over TLS", "Redis RESP")
Rel(Recommendation Engine, Catalog Cache Component, "Redis RESP protocol over TLS", "Redis RESP")
Rel(Integration Service, Rate Limiter / Token Bucket Component, "Redis RESP protocol over TLS", "Redis RESP")
Rel(AWS CloudWatch, Metrics & Slow-Log Collector, "Amazon CloudWatch Agent / Redis INFO API", "API")
Rel(Core E_Commerce Service & Recommendation Engine, Redis Auth & ACL Enforcement, "AUTH with user/password credentials over TLS", "TLS")

@enduml