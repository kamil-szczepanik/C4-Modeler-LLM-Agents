@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for E-Commerce Book Store

Person(Customer, "Customer", "End user browsing physical and electronic books, making purchases, and writing reviews.")
Person(StoreAdministrator, "Store Administrator", "Manager overseeing product catalogue, orders, and store operations.")

System_Ext(PaymentGateway, "Payment Gateway", "Stripe or PayPal for processing financial transactions.")
System_Ext(ThirdPartyShippingAPI, "Third-Party Shipping API", "FedEx or UPS for handling order fulfillment and shipping.")
System_Ext(NotificationService, "Notification Service", "AWS SES for sending emails and notifications.")
System_Ext(CurrencyExchangeRateAPI, "Currency Exchange Rate API", "External service providing currency conversion rates.")

System_Boundary(ECommerceBookStore, "E-Commerce Book Store") {
    Container(ReactSPA, "React Single-Page Application (SPA)", "React, AWS CloudFront, S3", "Global content delivery and user interface hosted at the edge for low latency.")
    Container(AWSApiGateway, "AWS API Gateway", "AWS API Gateway", "Routes incoming HTTPS/REST traffic from the SPA to core backend services.")
    Container(CoreECommerceService, "Core E-Commerce Service", "Node.js (TypeScript) or Python on Amazon ECS Fargate", "Handles primary bookstore operations, business logic, cart management, and order processing.")
    Container(RecommendationEngine, "Recommendation Engine", "Python on Amazon ECS Fargate", "Provides personalized book recommendations for customers.")
    Container(AuditComplianceService, "Audit & Compliance Service", "Node.js or Python on Amazon ECS Fargate", "Ensures GDPR compliance and logs audit trails.")
    Container(IntegrationService, "Integration Service", "Node.js or Python on Amazon ECS Fargate", "Communicates asynchronously via SQS/EventBridge with external third-party APIs.")
    Container(SearchAnalyticsService, "Search & Analytics Service", "Amazon OpenSearch Service", "Dedicated keyword search and review indexing.")
    ContainerDb(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Relational database for ACID-compliant transactional data storage.")
    ContainerDb(AmazonDynamoDB, "Amazon DynamoDB", "Amazon DynamoDB", "NoSQL database for cart storage and session data.")
    Container(AmazonElastiCacheRedis, "Amazon ElastiCache (Redis)", "Amazon ElastiCache (Redis)", "Distributed session caching and hot data performance.")
    Container(AmazonEventBridge, "Amazon EventBridge", "Amazon EventBridge", "Decoupled asynchronous event router.")
    Container(AmazonSQSSNS, "Amazon SQS/SNS", "Amazon SQS / SNS", "Message queuing for decoupled asynchronous event-driven messaging.")
    Container(AWSLambda, "AWS Lambda", "AWS Lambda", "Serverless compute for lightweight event processing and edge functions.")
}

Rel(Customer, ReactSPA, "Browses catalogue, manages cart, places orders, and reads reviews", "HTTPS")
Rel(StoreAdministrator, ReactSPA, "Manages store inventory, orders, and system administration", "HTTPS")
Rel(ReactSPA, AWSApiGateway, "Interacts with backend services via API calls", "HTTPS/REST")
Rel(AWSApiGateway, CoreECommerceService, "Routes API requests", "HTTPS/REST or gRPC")
Rel(AWSApiGateway, AuditComplianceService, "Routes compliance and audit requests", "HTTPS/REST or gRPC")
Rel(AWSApiGateway, SearchAnalyticsService, "Routes search and review queries", "HTTPS/REST or gRPC")
Rel(CoreECommerceService, AmazonAuroraPostgreSQL, "Reads and writes transactional data", "TLS")
Rel(CoreECommerceService, AmazonDynamoDB, "Reads and writes session and cart data", "TLS")
Rel(CoreECommerceService, AmazonElastiCacheRedis, "Caches hot data and sessions", "TLS")
Rel(CoreECommerceService, AmazonEventBridge, "Publishes domain events", "Asynchronous Messaging")
Rel(AmazonEventBridge, AmazonSQSSNS, "Forwards events to queues", "AWS Messaging")
Rel(AmazonSQSSNS, IntegrationService, "Triggers asynchronous integration tasks", "SQS Messaging")
Rel(IntegrationService, PaymentGateway, "Processes secure payments", "HTTPS/REST")
Rel(IntegrationService, ThirdPartyShippingAPI, "Coordinates fulfillment and shipping", "HTTPS/REST")
Rel(IntegrationService, NotificationService, "Triggers notifications and emails", "AWS SES / HTTPS")
Rel(IntegrationService, CurrencyExchangeRateAPI, "Fetches current currency exchange rates", "HTTPS/REST")

@enduml