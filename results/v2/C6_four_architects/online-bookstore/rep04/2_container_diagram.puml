@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore System

Person(Customers, "Customers", "End-users browsing, purchasing, reviewing, and receiving book recommendations.")
Person(Store Administrators, "Store Administrators", "Manage the product catalog, moderate reviews, and oversee fulfillment.")

System_Ext(PaymentGateway, "Payment Gateway", "Stripe/PayPal integration for secure financial transactions.")
System_Ext(ShippingProviderAPIs, "Shipping Provider APIs", "FedEx/UPS integrations for fulfillment and shipping.")
System_Ext(IdentityProvider, "Identity Provider", "Auth0/Cognito for authentication and OIDC.")
System_Ext(TaxCalculationService, "Tax Calculation Service", "Avalara/TaxJar for tax computation.")
System_Ext(NotificationService, "Notification Service", "SES/Twilio for user alerts and notifications.")

System_Boundary(OnlineBookstoreSystem, "Online Bookstore System") {
    Container(SPA, "Single-Page Application (SPA)", "React/TypeScript", "Client interface for browsing, purchasing, and managing accounts.")
    Container(APIGateway, "API Gateway", "Amazon API Gateway", "Manages entry traffic and routes requests to backend services.")
    Container(CatalogService, "Catalog Service", "Node.js (ECS Fargate)", "Manages the product catalog for physical and electronic books.")
    Container(OrderCheckoutService, "Order & Checkout Service", "Java/Spring Boot (ECS Fargate)", "Handles orders, checkout processing, and cart management.")
    Container(RecommendationService, "Recommendation Service", "Python/FastAPI (ECS Fargate)", "Provides personalized book recommendations.")
    Container(AuthService, "Auth Service", "ECS Fargate", "Manages authentication and user security.")
    Container(PrivacyService, "Privacy Service", "ECS Fargate", "Ensures strict GDPR and CCPA compliance.")
    Container(BackgroundWorker, "Background Worker", "ECS Fargate", "Handles asynchronous background tasks.")
    ContainerDb(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Managed relational storage for transactional data.")
    ContainerDb(AmazonDynamoDB, "Amazon DynamoDB", "Amazon DynamoDB", "NoSQL storage for carts and sessions.")
    Container(AmazonOpenSearch, "Amazon OpenSearch", "Amazon OpenSearch", "Dedicated search engine for catalogue browsing.")
    Container(AmazonS3CloudFront, "Amazon S3 & CloudFront", "Amazon S3, Amazon CloudFront", "Static asset delivery and digital book storage with low-latency CDN.")
    Container(MessagingObservability, "Messaging & Observability", "Amazon SNS/SQS, Amazon CloudWatch, AWS X-Ray", "Asynchronous event messaging and system observability.")
}

Rel(Customers, SPA, "Interacts with the client interface", "HTTPS")
Rel(Store Administrators, SPA, "Manages the platform via client interface", "HTTPS")
Rel(SPA, APIGateway, "Sends client requests", "HTTPS / JSON")
Rel(APIGateway, CatalogService, "Routes catalog requests", "Internal gRPC / HTTP/2")
Rel(APIGateway, OrderCheckoutService, "Routes order and checkout requests", "Internal gRPC / HTTP/2")
Rel(APIGateway, RecommendationService, "Routes recommendation requests", "Internal gRPC / HTTP/2")
Rel(APIGateway, AuthService, "Routes authentication requests", "Internal gRPC / HTTP/2")
Rel(APIGateway, PrivacyService, "Routes privacy compliance requests", "Internal gRPC / HTTP/2")
Rel(CatalogService, AmazonAuroraPostgreSQL, "Reads and writes relational data", "JDBC / TCP")
Rel(OrderCheckoutService, AmazonAuroraPostgreSQL, "Reads and writes transactional data", "JDBC / TCP")
Rel(OrderCheckoutService, AmazonDynamoDB, "Manages carts and sessions", "TCP")
Rel(CatalogService, AmazonOpenSearch, "Searches catalog data", "TCP")
Rel(CatalogService, AmazonS3CloudFront, "Retrieves digital book assets", "HTTPS")
Rel(OrderCheckoutService, MessagingObservability, "Publishes asynchronous events", "Amazon SNS/SQS")
Rel(CatalogService, MessagingObservability, "Publishes and consumes asynchronous events", "Amazon SNS/SQS")
Rel(BackgroundWorker, MessagingObservability, "Processes asynchronous messages", "Amazon SNS/SQS")

Rel(OnlineBookstoreSystem, IdentityProvider, "Authenticating users via OIDC", "HTTPS/OIDC")
Rel(OnlineBookstoreSystem, PaymentGateway, "Processing secure transactions", "HTTPS/REST")
Rel(OnlineBookstoreSystem, TaxCalculationService, "Computing taxes for purchases", "HTTPS/REST")
Rel(OnlineBookstoreSystem, ShippingProviderAPIs, "Handling fulfillment and shipping", "HTTPS/REST")
Rel(OnlineBookstoreSystem, NotificationService, "Sending alerts and notifications", "HTTPS/REST")

@enduml