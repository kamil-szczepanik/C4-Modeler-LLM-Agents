@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Single-Page Application (SPA) container

Container_Boundary(spa_boundary, "Single-Page Application (SPA)") {
    Component(RouterComponent, "Router Component", "React Router", "React Router for client-side navigation and code-splitting.")
    Component(FeatureModules, "Feature Modules", "React & TypeScript", "Lazy-loaded views for catalogue, search, checkout, cart, reviews, and recommendations.")
    Component(StateManagementStore, "State Management Store", "Redux Toolkit", "Redux Toolkit for global application state.")
    Component(ApiClientLayer, "API Client Layer", "Axios", "Axios wrapper incorporating a Security & Token Interceptor for in-memory JWT handling.")
    Component(PrivacyConsentManager, "Privacy & Consent Manager", "React / Local Storage", "Local management of cookie banners and GDPR/CCPA compliance states.")
    Component(LocalizationCurrencyProvider, "Localization & Currency Provider", "React Context", "Manages locale dictionaries and multi-currency formatting (USD, EUR, GBP).")
}

System_Ext(AmazonS3CloudFront, "Amazon S3 & CloudFront", "External hosting for static asset delivery and global edge caching.", "Amazon S3 / Amazon CloudFront")
System_Ext(ApiGateway, "API Gateway", "Receives authenticated requests from the API Client Layer.", "API Gateway")
System_Ext(GitHubActionsCICD, "GitHub Actions (CI/CD)", "Deploys optimized React build bundles to Amazon S3 & CloudFront.", "GitHub Actions")

Rel(RouterComponent, FeatureModules, "Dynamically imports and lazy-loads views on demand", "ES Modules")
Rel(FeatureModules, StateManagementStore, "Reads and writes global state", "Redux Dispatch")
Rel(FeatureModules, ApiClientLayer, "Invokes remote operations", "HTTPS / REST / JSON")
Rel(PrivacyConsentManager, ApiClientLayer, "Sends compliance triggers to the Privacy Service", "HTTPS / JSON")
Rel(ApiClientLayer, ApiGateway, "Sends authenticated requests", "HTTPS / JSON")
Rel(GitHubActionsCICD, AmazonS3CloudFront, "Deploys optimized React build bundles", "HTTPS")

@enduml