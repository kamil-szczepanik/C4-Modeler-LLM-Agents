@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon S3 & CloudFront container

Container_Boundary(amazon_s3_cloudfront_container, "Amazon S3 & CloudFront") {
    Component(Static_Web_Hosting_Bucket, "Static Web Hosting Bucket", "Amazon S3 (Standard)", "Stores built React SPA artifacts and logs with lifecycle policies.")
    Component(Digital_Assets_Bucket, "Digital Assets Bucket", "Amazon S3 (Standard-IA/Glacier)", "Securely stores encrypted e-book files and high-resolution media.")
    Component(CDN_Distribution, "CDN Distribution", "Amazon CloudFront with Lambda@Edge", "Edge-caches static assets and protects digital books using signed URLs, validating them via Lambda@Edge.")
    Component(Access_Logging_Bucket, "Access Logging Bucket", "Amazon S3 (Standard)", "Stores access logs streamed via S3 API.")
    Component(Media_Processing_Trigger, "Media Processing Trigger", "Python / AWS Lambda", "Automatically optimizes and generates thumbnails for user-uploaded review images upon new image upload.")
}

System_Ext(React_SPA_Container, "React SPA Container", "External Container")
System_Ext(Catalog_Order_Services, "Catalog & Order Services", "External Container")
System_Ext(Privacy_Service, "Privacy Service", "External Container")

Rel(React_SPA_Container, CDN_Distribution, "Loads static JS/CSS/HTML", "HTTPS")
Rel(Catalog_Order_Services, CDN_Distribution, "Requests signed URLs for e-book downloads", "HTTPS")
Rel(CDN_Distribution, Digital_Assets_Bucket, "Fetches private media via Origin Access Control (OAC)", "HTTPS")
Rel(CDN_Distribution, Access_Logging_Bucket, "Streams access logs", "S3 API / HTTPS")
Rel(Privacy_Service, Digital_Assets_Bucket, "Manages data deletion and anonymization", "AWS SDK (HTTPS)")
Rel(Digital_Assets_Bucket, Media_Processing_Trigger, "Invokes processing upon new image upload", "S3 Event Notifications (JSON/HTTPS)")
@enduml