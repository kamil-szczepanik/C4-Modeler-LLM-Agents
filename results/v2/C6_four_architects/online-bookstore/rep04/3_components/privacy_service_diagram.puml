@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(privacy_service, "Privacy Service") {
    Component(ConsentControllerMiddlewareComponent, "Consent Controller & Middleware Component", "Node.js / TypeScript", "Handles incoming privacy requests and manages user consent preferences.")
    Component(DSAROrchestratorComponent, "DSAR Orchestrator Component", "Node.js / TypeScript", "Coordinates asynchronous data export and erasure workflows.")
    Component(DataRedactionComponent, "Data Redaction Component", "Node.js / TypeScript", "Purges and anonymizes PII from databases.")
    Component(ComplianceReportingComponent, "Compliance Reporting Component", "Node.js / TypeScript", "Archives tamper-proof audit trails for regulatory compliance.")
    Component(AmazonAPIGateway, "Amazon API Gateway", "AWS API Gateway", "Routes incoming privacy requests to the consent controller.")
    Component(AmazonDynamoDB, "Amazon DynamoDB", "AWS DynamoDB", "Persists and queries user consent preferences.")
    Component(AmazonSQSSNS, "Amazon SQS & SNS", "AWS SQS / SNS", "Coordinates async data export and erasure workflows.")
    Component(AmazonS3, "Amazon S3", "AWS S3", "Stores user data export packages and archives tamper-proof audit trails.")
    Component(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL", "AWS Aurora PostgreSQL", "Relational database used for purging and anonymizing PII.")
}

Rel(AmazonAPIGateway, ConsentControllerMiddlewareComponent, "Routes incoming privacy requests", "gRPC / HTTP/2")
Rel(ConsentControllerMiddlewareComponent, AmazonDynamoDB, "Persists and queries user consent preferences", "AWS SDK / HTTPS")
Rel(DSAROrchestratorComponent, AmazonSQSSNS, "Coordinates async data export and erasure workflows", "AWS SDK / HTTPS")
Rel(DSAROrchestratorComponent, AmazonS3, "Stores user data export packages", "AWS SDK / HTTPS")
Rel(DataRedactionComponent, AmazonAuroraPostgreSQL, "Purges and anonymizes PII", "pg / TLS")
Rel(ComplianceReportingComponent, AmazonS3, "Archives tamper-proof audit trails", "AWS SDK / HTTPS")
@enduml