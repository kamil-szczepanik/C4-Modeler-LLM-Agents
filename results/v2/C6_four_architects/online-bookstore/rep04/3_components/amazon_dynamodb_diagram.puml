@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon DynamoDB container

Container_Boundary(amazon_dynamodb, "Amazon DynamoDB") {
    Component(Request_Router, "Request Router", "AWS DynamoDB Internal Routing", "Routes incoming requests to the appropriate storage nodes or DAX cluster.")
    Component(DAX_Cluster, "DAX Cluster", "Amazon DynamoDB Accelerator", "In-memory cache for high-throughput carts and session state reads.")
    Component(Storage_Node_Engine, "Storage Node Engine", "DynamoDB Distributed Storage", "Manages underlying partitioned data storage for tables.")
    Component(Index_Manager, "Index Manager", "DynamoDB Secondary Indexes", "Manages local and global secondary indexes for fast querying.")
    Component(TTL_Background_Cleaner, "TTL Background Cleaner", "DynamoDB Time-to-Live Engine", "Automatically removes expired items to enforce GDPR and CCPA compliance.")
    Component(Streams_Publisher, "Streams Publisher", "DynamoDB Streams", "Captures change data capture (CDC) events for asynchronous event relay.")
}

Rel(Request_Router, DAX_Cluster, "Routes cache-eligible requests via TCP")
Rel(Request_Router, Storage_Node_Engine, "Forwards storage read/write operations")
Rel(Storage_Node_Engine, Index_Manager, "Updates index data")
Rel(Storage_Node_Engine, TTL_Background_Cleaner, "Triggers data expiration removal")
Rel(Storage_Node_Engine, Streams_Publisher, "Publishes CDC events")

@enduml