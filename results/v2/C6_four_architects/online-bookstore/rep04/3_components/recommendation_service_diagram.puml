@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Recommendation Service container

Container_Boundary(recommendation_service, "Recommendation Service") {
    Component(Recommendation_API_Controller, "Recommendation API Controller", "Python / FastAPI", "High-performance asynchronous API framework for handling inbound requests.")
    Component(Scoring_Engine, "Scoring Engine", "Python / NumPy / Pandas", "Optimized libraries for in-memory collaborative filtering and scoring logic.")
    Component(Model_Ingestion_Worker, "Model Ingestion Worker", "Python / Celery", "Asynchronously processes model ingestion events.")
    Component(Recommendation_Cache_Client, "Recommendation Cache Client", "Redis-py", "Client for interacting with Amazon ElastiCache (Redis).")
    Component(Feature_Store_Vector_DB_Client, "Feature Store / Vector DB Client", "Python", "Client for querying feature stores and vector databases like Amazon OpenSearch.")
    Component(Telemetry_Interceptor_Middleware, "Telemetry Interceptor Middleware", "Python", "Emits traces to AWS X-Ray and metrics to Amazon CloudWatch.")
    Component(Amazon_ElastiCache_Redis, "Amazon ElastiCache (Redis)", "Amazon ElastiCache (Redis)", "In-memory data store for sub-second recommendation retrieval to meet performance SLAs.")
    Component(Amazon_OpenSearch, "Amazon OpenSearch", "Amazon OpenSearch", "Vector database and feature store for semantic similarity book recommendations.")
    Component(Amazon_SQS, "Amazon SQS", "Amazon SQS", "Message queue for asynchronously decoupling order events from the model ingestion pipeline.")
}

Rel(Recommendation_API_Controller, Scoring_Engine, "In-memory function call")
Rel(Scoring_Engine, Recommendation_Cache_Client, "Redis TCP / RESP")
Rel(Scoring_Engine, Feature_Store_Vector_DB_Client, "REST/HTTPS")
Rel(Model_Ingestion_Worker, Amazon_SQS, "AWS SDK / HTTPS")
Rel(Model_Ingestion_Worker, Recommendation_Cache_Client, "Redis TCP / RESP")
Rel(Telemetry_Interceptor_Middleware, Amazon_ElastiCache_Redis, "AWS SDK / HTTPS")

@enduml