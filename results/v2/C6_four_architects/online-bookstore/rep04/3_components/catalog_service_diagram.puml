@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog Service container

Container_Boundary(catalog_service, "Catalog Service") {
    Component(CatalogAPIController, "Catalog API Controller", "NestJS / Node.js", "Exposes HTTP/2 endpoints for browsing and searching.")
    Component(ProductDomainService, "Product Domain Service", "NestJS / Node.js", "Encapsulates business logic, featuring a decorator-patterned Cache Interceptor.")
    Component(SearchIndexingRepository, "Search & Indexing Repository", "Amazon OpenSearch Client / Node.js", "Integrates with Amazon OpenSearch for catalog searches.")
    Component(RelationalPersistenceAdapter, "Relational Persistence Adapter", "TypeORM / Node.js", "Uses TypeORM to communicate with Amazon Aurora PostgreSQL.")
    Component(CatalogCacheInterceptorRepository, "Catalog Cache Interceptor / Repository", "Redis / Node.js", "Backed by an Amazon ElastiCache Redis cluster via TCP.")
    Component(EventPublisher, "Event Publisher", "AWS SDK for Node.js", "Emits domain events using the AWS SDK for Node.js.")
    Component(AssetManagementAdapter, "Asset Management Adapter", "AWS SDK for Node.js", "Manages digital book assets stored in Amazon S3.")
}

System_Ext(AmazonOpenSearch, "Amazon OpenSearch", "External Search Service")
System_Ext(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL", "External Relational Database")
System_Ext(AmazonS3CloudFront, "Amazon S3 & CloudFront", "External Storage and CDN")
System_Ext(MessagingObservability, "Messaging & Observability", "External Messaging / Event Bus")

Rel(CatalogAPIController, ProductDomainService, "Invokes business logic", "TypeScript Interfaces")
Rel(ProductDomainService, CatalogCacheInterceptorRepository, "Reads/writes cached data", "Redis TCP")
Rel(SearchIndexingRepository, AmazonOpenSearch, "Queries catalog indices", "HTTP/2 / HTTPS REST")
Rel(RelationalPersistenceAdapter, AmazonAuroraPostgreSQL, "Manages relational records", "PostgreSQL TCP")
Rel(AssetManagementAdapter, AmazonS3CloudFront, "Generates pre-signed asset URLs", "HTTPS / AWS SDK")
Rel(EventPublisher, MessagingObservability, "Publishes asynchronous domain events", "AWS SDK / HTTPS")

@enduml