@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("AmazonOpenSearch", "Amazon OpenSearch") {
    Component(REST_API_Handler, "REST API Handler", "Java / HTTP Server", "Handles incoming REST requests and API calls from services like the Catalog Service.")
    Component(Distributed_Search_Engine, "Distributed Search Engine", "Apache Lucene Core", "Executes full-text search queries and document retrievals across the cluster.")
    Component(Index_Manager, "Index Manager", "OpenSearch Core", "Manages indices, mappings, and index lifecycle operations.")
    Component(Cluster_Coordinator, "Cluster Coordinator", "OpenSearch Cluster Manager", "Manages cluster state, node discovery, and topology coordination.")
    Component(Data_Replication_Manager, "Data Replication Manager", "OpenSearch Replication Engine", "Ensures high availability and data consistency through primary-replica replication.")
    Component(Security_Access_Control_Module, "Security & Access Control Module", "AWS IAM / OpenSearch Security Plugin", "Enforces authentication, authorization, and AWS SigV4 request verification.")
    Component(Snapshot_Manager, "Snapshot Manager", "OpenSearch Snapshot API", "Handles backing up cluster indices and persistent state to external storage.")
}

System_Ext(Catalog_Service, "Catalog Service", "Microservice managing the product catalog")
System_Ext(Amazon_S3, "Amazon S3", "External storage for backups")

Rel(Catalog_Service, REST_API_Handler, "Submits queries and index updates", "HTTPS (REST / JSON) / AWS SigV4")
Rel(REST_API_Handler, Security_Access_Control_Module, "Verifies requests", "Internal")
Security_Access_Control_Module --> Distributed_Search_Engine
Security_Access_Control_Module --> Index_Manager
Rest_API_Handler --> Distributed_Search_Engine
Rest_API_Handler --> Index_Manager
Index_Manager --> Distributed_Search_Engine
Cluster_Coordinator --> Data_Replication_Manager, "Coordinates topology"
Data_Replication_Manager --> Distributed_Search_Engine, "Replicates data"
Snapshot_Manager --> Amazon_S3, "Persists index backups", "HTTPS (S3 API)"

@enduml