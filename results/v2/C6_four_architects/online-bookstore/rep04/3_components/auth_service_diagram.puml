@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Auth Service container

Container_Boundary(auth_service, "Auth Service") {
    Component(AuthenticationController, "Authentication Controller", "Fastify / Node.js / TypeScript", "Handling inbound HTTP/2 requests.")
    Component(TokenManager, "Token Manager", "Node.js", "Manages JWTs and opaque sessions.")
    Component(IdentityProviderIntegrationAdapter, "Identity Provider Integration Adapter", "OAuth2/OIDC", "Federates logins via OAuth2/OIDC.")
    Component(UserCredentialRepository, "User Credential Repository", "Argon2 / Amazon Aurora PostgreSQL", "Handles Argon2 password hashing and user profiles.")
    Component(GDPRConsentManager, "GDPR Consent Manager", "Node.js", "Manages data access and deletion requests.")
    Component(SecurityAuditLogger, "Security Audit Logger", "Amazon SNS/SQS", "Captures authentication failures and security events.")
    Component(RateLimitingBruteForceGuard, "Rate Limiting & Brute-Force Guard", "Redis (ElastiCache)", "Mitigates credential stuffing via sliding-window tracking.")
}

Component_Ext(ApiGateway, "API Gateway", "gRPC / HTTP/2", "Routes authentication requests.")
Component_Ext(RedisElastiCache, "Redis (ElastiCache)", "Redis Protocol", "Caches sessions and revocation lists.")
Component_Ext(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL", "TLS / JDBC", "Reads/writes credentials.")
Component_Ext(PrivacyService, "Privacy Service", "gRPC", "Requests user data export/deletion.")
Component_Ext(AmazonSNSSQS, "Amazon SNS/SQS", "AWS SDK / HTTPS", "Publishes audit events.")

Rel(ApiGateway, AuthenticationController, "Routes authentication requests", "gRPC / HTTP/2")
Rel(TokenManager, RedisElastiCache, "Caches sessions and revocation lists", "Redis Protocol")
Rel(UserCredentialRepository, AmazonAuroraPostgreSQL, "Reads/writes credentials", "TLS / JDBC")
Rel(PrivacyService, GDPRConsentManager, "Requests user data export/deletion", "gRPC")
Rel(SecurityAuditLogger, AmazonSNSSQS, "Publishes audit events", "AWS SDK / HTTPS")

@enduml