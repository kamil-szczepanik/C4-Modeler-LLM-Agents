@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(messaging_observability, "Messaging & Observability") {
    Component(Amazon_SNS, "Amazon SNS", "AWS SNS", "Publishes asynchronous events from microservices.")
    Component(Amazon_SQS, "Amazon SQS", "AWS SQS", "Queues asynchronous messages for downstream services.")
    Component(Amazon_CloudWatch, "Amazon CloudWatch", "AWS CloudWatch", "Collects and stores logs and metrics from services.")
    Component(AWS_X_Ray, "AWS X-Ray", "AWS X-Ray", "Traces requests across distributed microservices.")
    Component(EventBridge_Schema_Registry, "EventBridge Schema Registry", "Amazon EventBridge", "Provides contract validation for event-driven messaging.")
}

System_Ext(Microservices, "Microservices", "Upstream and downstream application microservices")
System_Ext(Services, "Services", "Distributed microservices emitting telemetry")

Rel(Amazon_SNS, Amazon_SQS, "Delivers messages to queues", "HTTPS/Internal AWS API")
Rel(Microservices, Amazon_SNS, "Publish/Subscribe events", "HTTPS/Internal AWS API")
Rel(Services, Amazon_CloudWatch, "Emits logs and metrics", "UDP/HTTPS")
Rel(Services, AWS_X_Ray, "Emits traces", "UDP/HTTPS")

@enduml