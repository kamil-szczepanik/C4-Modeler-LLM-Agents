@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Order & Checkout Service container

Container_Boundary(order_checkout_service, "Order & Checkout Service") {
    Component(OrderAPIController, "Order API Controller", "Java / Spring Boot", "Handles incoming HTTP requests for order placement and status tracking.")
    Component(CheckoutOrchestrator, "Checkout Orchestrator", "Java / Spring Boot", "Orchestrates the multi-step checkout workflow across cart, pricing, payment, and fulfillment.")
    Component(CartManagement, "Cart Management", "Java / Spring Boot", "Manages user shopping carts and session data.")
    Component(OrderProcessing, "Order Processing", "Java / Spring Boot", "Processes core order business logic and prepares transactional records.")
    Component(PricingCurrency, "Pricing & Currency", "Java / Spring Boot", "Calculates item totals, discounts, taxes, and currency conversions.")
    Component(PaymentIntegration, "Payment Integration", "Java / Spring Boot / Resilience4j", "Integrates with external payment gateways securely with circuit breakers.")
    Component(FulfillmentIntegration, "Fulfillment Integration", "Java / Spring Boot", "Integrates with external shipping provider APIs and tax services for order fulfillment.")
}

Rel(OrderAPIController, CheckoutOrchestrator, "Delegates checkout requests")
Rel(CheckoutOrchestrator, CartManagement, "Retrieves and clears cart data")
Rel(CheckoutOrchestrator, PricingCurrency, "Calculates final order pricing")
Rel(CheckoutOrchestrator, OrderProcessing, "Initiates order processing")
Rel(CheckoutOrchestrator, PaymentIntegration, "Executes payment transactions")
Rel(CheckoutOrchestrator, FulfillmentIntegration, "Triggers shipping and tax calculations")

@enduml