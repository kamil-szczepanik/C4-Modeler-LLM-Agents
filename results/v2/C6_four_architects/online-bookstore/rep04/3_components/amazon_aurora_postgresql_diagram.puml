@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon Aurora PostgreSQL container

Container_Boundary(aurora_postgresql, "Amazon Aurora PostgreSQL") {
    Component(AWS_RDS_Proxy, "AWS RDS Proxy", "AWS RDS Proxy", "Connection pooling to prevent ECS Fargate connection exhaustion.")
    Component(Primary_DB_Instance, "Primary DB Instance", "Amazon Aurora PostgreSQL Primary Instance", "Managed relational storage for ACID transactions and scalability.")
    Component(Replica_DB_Instances, "Replica DB Instances", "Amazon Aurora PostgreSQL Replica Instances", "Read-replica instances for scaling read operations and multi-region availability.")
    Component(Aurora_Storage_Volume, "Aurora Storage Volume", "AWS Aurora Storage Fabric", "Persists data reliably across distributed multi-AZ storage volumes.")
    Component(PostgreSQL_Extension_Manager, "PostgreSQL Extension Manager", "pgAudit and pgcrypto", "Provides database-level auditing and column-level encryption for GDPR/CCPA compliance.")
}

Rel(AWS_RDS_Proxy, Primary_DB_Instance, "Manages connection pools and routes write transactions", "PostgreSQL Protocol / TCP/5432")
Rel(AWS_RDS_Proxy, Replica_DB_Instances, "Manages connection pools and routes read queries", "PostgreSQL Protocol / TCP/5432")
Rel(Primary_DB_Instance, Aurora_Storage_Volume, "Persists data", "AWS Aurora Storage Fabric / TCP")
Rel(Primary_DB_Instance, PostgreSQL_Extension_Manager, "Applies auditing and encryption policies", "")

@enduml