@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(ssl_termination, "SSL Termination", "AWS Certificate Manager", "Enforces TLS 1.3 at the edge for secure connections.")
    Component(rate_limiting, "Rate Limiting", "AWS WAF", "Enforces per-client usage quotas and rate limiting to protect against traffic spikes.")
    Component(auth_interceptor, "Authentication Interceptor", "JWT / Lambda Authorizer", "Validates incoming client requests and handles authentication.")
    Component(request_response_transformation, "Request/Response Transformation", "Amazon API Gateway", "Transforms payloads and handles request/response formatting.")
    Component(routing_dispatcher, "Routing & Dispatcher", "AWS Cloud Map / HTTP Integrations", "Routes requests to backend services via internal service discovery.")
    Component(request_logging_audit_component, "Request Logging & Audit Component", "CloudWatch", "Exports audit and metric data.")
}

Rel(ssl_termination, rate_limiting, "Passes secure traffic")
Rel(rate_limiting, auth_interceptor, "Forwards filtered requests")
Rel(auth_interceptor, request_response_transformation, "Passes authenticated requests")
Rel(request_response_transformation, routing_dispatcher, "Dispatches transformed requests")
Rel(routing_dispatcher, request_logging_audit_component, "Sends audit and metric data")

@enduml