@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon Aurora PostgreSQL container

System(OrderCheckoutService, "Order & Checkout Service", "Manages orders and checkout workflows.")
System(CatalogSearchService, "Catalog & Search Service", "Manages product catalog and search functionalities.")
System(AmazonEventBridgeSQS, "Amazon EventBridge / SQS", "Handles asynchronous messaging and event distribution.")
System(AWSKMS, "AWS KMS", "Provides cryptographic keys for data encryption.")

Container_Boundary(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL") {
    Component(AuroraPostgreSQLWriterInstance, "Aurora PostgreSQL Writer Instance", "Node", "Handles primary write operations and transactional integrity for the database.")
    Component(AuroraPostgreSQLReaderInstances, "Aurora PostgreSQL Reader Instances", "Replica Nodes", "Handles read-only queries and supports read scaling across instances.")
    Component(AuroraStorageVolume, "Aurora Storage Volume", "Distributed Shared Storage with Aurora Global Databases", "Provides distributed, replicated storage spanning multiple AWS regions.")
    Component(RowLevelSecurityEncryptionModule, "Row-Level Security & Encryption Module", "PostgreSQL RLS & AWS KMS Integration", "Ensures GDPR/CCPA compliance via row-level security and data encryption.")
    Component(ConnectionPooler, "Connection Pooler", "PgBouncer integration", "Manages database connections to prevent exhaustion during traffic spikes.")
    Component(LogicalReplicationCDCEngine, "Logical Replication & CDC Engine", "PostgreSQL Logical Replication", "Streams change data capture events to external AWS services.")
    Component(AuroraReaderWriteryEndpointRouter, "Aurora Reader/Writer Endpoint Router", "AWS RDS Endpoint Routing", "Routes incoming traffic to the appropriate writer or reader instances.")
}

Rel(OrderCheckoutService, AuroraReaderWriteryEndpointRouter, "Native Database Protocol / TCP over VPC")
Rel(CatalogSearchService, AuroraReaderWriteryEndpointRouter, "Native Database Protocol / TCP over VPC")
Rel(AuroraReaderWriteryEndpointRouter, AuroraPostgreSQLWriterInstance, "TCP")
Rel(AuroraReaderWriteryEndpointRouter, AuroraPostgreSQLReaderInstances, "TCP")
Rel(AuroraPostgreSQLWriterInstance, AuroraStorageVolume, "Distributed Storage Volume Protocol")
Rel(LogicalReplicationCDCEngine, AmazonEventBridgeSQS, "HTTPS / AWS SDK")
Rel(RowLevelSecurityEncryptionModule, AWSKMS, "HTTPS / AWS API")

@enduml