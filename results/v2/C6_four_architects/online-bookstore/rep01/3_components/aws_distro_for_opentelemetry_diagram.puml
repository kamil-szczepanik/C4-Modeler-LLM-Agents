@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS Distro for OpenTelemetry container

Container_Boundary(adot_container, "AWS Distro for OpenTelemetry") {
    Component(ADOTCollectorCore, "ADOT Collector Core", "OpenTelemetry Collector", "Receives, processes, and exports traces and metrics gathered from application containers.")
    Component(OTLPReceiver, "OTLP Receiver", "gRPC/HTTP", "Ingecsts local telemetry from application containers via OTLP on ports 4317/4318.")
    Component(XRayExporter, "X-Ray Exporter", "HTTPS", "Persists trace data to AWS X-Ray.")
    Component(PrometheusExporter, "Prometheus Exporter", "HTTP Remote Write", "Aggregates and pushes metric data to Amazon Managed Service for Prometheus.")
    Component(IMDSv2Connector, "IMDSv2 Connector", "HTTP (TCP port 80)", "Fetches runtime environment context from AWS IMDSv2.")
}

Rel(OTLPReceiver, ADOTCollectorCore, "Passes ingested telemetry data for processing", "")
Rel(ADOTCollectorCore, XRayExporter, "Sends processed traces", "")
Rel(ADOTCollectorCore, PrometheusExporter, "Sends aggregated metrics", "")
Rel(ADOTCollectorCore, IMDSv2Connector, "Enriches telemetry with runtime context", "")

@enduml