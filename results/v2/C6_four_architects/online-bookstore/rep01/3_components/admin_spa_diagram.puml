@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Admin SPA container

Container_Boundary(admin_spa, "Admin SPA") {
    Component(Authentication_Component, "Authentication Component", "TypeScript, React Context", "Handles user authentication and context management.")
    Component(Authorization_RBAC_Guard_Component, "Authorization & RBAC Guard Component", "TypeScript, React Router", "Validates user claims and enforces role-based access control.")
    Component(Catalog_Management_Component, "Catalog Management Component", "React, TanStack Query", "Manages catalogue listings, queries, and mutations.")
    Component(Order_Support_Dashboard_Component, "Order & Support Dashboard Component", "React, AG-Grid", "Manages order operations using high-performance data tables.")
    Component(Audit_Telemetry_Logger_Component, "Audit & Telemetry Logger Component", "TypeScript", "Dispatches action events, performance metrics, and errors.")
}

Rel(Authorization_RBAC_Guard_Component, Authentication_Component, "Validates user claims", "React Context")
Rel(Catalog_Management_Component, Audit_Telemetry_Logger_Component, "Dispatches action events", "TypeScript Calls")
Rel(Order_Support_Dashboard_Component, Audit_Telemetry_Logger_Component, "Dispatches action events", "TypeScript Calls")

@enduml