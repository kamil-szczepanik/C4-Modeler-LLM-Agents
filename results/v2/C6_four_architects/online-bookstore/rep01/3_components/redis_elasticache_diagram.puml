@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Redis ElastiCache container

Container_Boundary(Redis_ElastiCache, "Redis ElastiCache") {
    Component(Session_Store_Component, "Session Store Component", "Redis Protocol via AWS VPC Private Subnets", "Manages user sessions for the Order & Checkout Service.")
    Component(Product_Catalog_Cache_Component, "Product Catalog Cache Component", "Redis Protocol", "Reads/writes hot catalogue items for the Catalog & Search Service.")
    Component(Distributed_Rate_Limiter_Component, "Distributed Rate Limiter Component", "Redis Data Structures", "Enforces rate limits and distributes traffic control.")
    Component(Cart_Persistence_Component, "Cart Persistence Component", "Redis Protocol / gRPC", "Reads/updates active carts accessed via AWS API Gateway and Customer SPA.")
    Component(Idempotency___Deduplication_Component, "Idempotency & Deduplication Component", "Redis Data Structures (SETNX)", "Checks and sets transaction tokens for the Order & Checkout Service.")
    Component(AWS_ElastiCache_Cluster_Nodes, "AWS ElastiCache Cluster Nodes", "AWS ElastiCache for Redis (Cluster Mode Enabled)", "In-memory data store for sub-second caching and session management.")
    Component(AWS_Distro_for_OpenTelemetry__ADOT_Sidecar_, "AWS Distro for OpenTelemetry (ADOT Sidecar)", "AWS Distro for OpenTelemetry (ADOT)", "Exports Redis metrics via OpenTelemetry Protocol / Prometheus.")
}

System_Ext(Order___Checkout_Service, "Order & Checkout Service", "External service interacting with Redis components.")
System_Ext(Catalog___Search_Service, "Catalog & Search Service", "External service interacting with Redis components.")
System_Ext(Customer_SPA_via_AWS_API_Gateway, "Customer SPA via AWS API Gateway", "External client access.")
System_Ext(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Primary relational database.")

Rel(Order___Checkout_Service, Session_Store_Component, "Manages user sessions", "Redis Protocol via AWS VPC Private Subnets")
Rel(Catalog___Search_Service, Product_Catalog_Cache_Component, "Reads/writes hot catalogue items", "Redis Protocol")
Rel(Customer_SPA_via_AWS_API_Gateway, Cart_Persistence_Component, "Reads/updates active carts", "Redis Protocol / gRPC")
Rel(Product_Catalog_Cache_Component, Amazon_Aurora_PostgreSQL, "Cache-aside fallback", "PostgreSQL Wire Protocol")
Rel(Order___Checkout_Service, Idempotency___Deduplication_Component, "Checks/sets transaction tokens", "Redis Protocol")
Rel(Redis_ElastiCache, AWS_Distro_for_OpenTelemetry__ADOT_Sidecar_, "Exports Redis metrics", "OpenTelemetry Protocol / Prometheus")

@enduml