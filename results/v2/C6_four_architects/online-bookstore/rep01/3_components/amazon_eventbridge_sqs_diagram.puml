@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_eventbridge_sqs, "Amazon EventBridge & SQS") {
    Component(event_bus, "Event Bus", "Amazon EventBridge", "Publishes and routes domain events across the system.")
    Component(checkout_queue, "Checkout Queue", "Amazon SQS", "Buffers checkout events for asynchronous background execution.")
    Component(digital_asset_queue, "Digital Asset Queue", "Amazon SQS", "Buffers events to provision digital asset downloads.")
    Component(notification_queue, "Notification Queue", "Amazon SQS", "Buffers events for sending user notifications.")
    Component(general_dlq, "General DLQ", "Amazon SQS", "Receives failed messages after maximum retries for operational inspection.")
    Component(event_archive, "Event Archive", "Amazon EventBridge Archive", "Archives domain events for auditing and replay capabilities.")
    Component(cross_region_event_rule, "Cross-Region Event Rule", "Amazon EventBridge Rule", "Replicates critical domain events across regions.")
    Component(cloudwatch_alarms, "CloudWatch Alarms", "Amazon CloudWatch", "Monitors queue depth and operational metrics for DLQ and messaging.")
    Component(sqs_kms_encryption, "SQS KMS Encryption", "AWS KMS", "Provides encryption at rest for SQS queues.")
}

Rel(event_bus, checkout_queue, "Forwards filtered checkout domain events", "AWS SNS/SQS integration")
Rel(event_bus, digital_asset_queue, "Forwards filtered digital asset events", "AWS SNS/SQS integration")
Rel(event_bus, notification_queue, "Forwards filtered notification events", "AWS SNS/SQS integration")
Rel(event_bus, cross_region_event_rule, "Triggers cross-region event replication", "Cross-Region AWS API / HTTPS")
Rel(checkout_queue, general_dlq, "Forwards failed messages after max retries via redrive policy", "AWS Redrive Policy")
Rel(digital_asset_queue, general_dlq, "Forwards failed messages after max retries via redrive policy", "AWS Redrive Policy")
Rel(notification_queue, general_dlq, "Forwards failed messages after max retries via redrive policy", "AWS Redrive Policy")
Rel(general_dlq, cloudwatch_alarms, "Emits depth metrics for operational monitoring", "CloudWatch Metric Integration")
@enduml