@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS API Gateway container

Container_Boundary(aws_api_gateway, "AWS API Gateway") {
    Component(api_router_waf, "API Router & WAF Integration", "AWS WAF & API Gateway", "Inspects inbound client traffic, enforces edge security, and mitigates OWASP Top-10 threats.")
    Component(auth_middleware, "Authentication & Authorization Middleware", "Node.js / Lambda Authorizer", "Validates stateless JWT tokens for inbound client requests.")
    Component(internal_routing_proxy, "Internal Routing Proxy", "AWS API Gateway gRPC Proxy", "Routes verified requests to internal microservices using gRPC over TLS.")
}

System_Ext(catalog_service, "Catalog & Search Service", "Spring Boot, OpenSearch")
System_Ext(order_service, "Order & Checkout Service", "Node.js")
System_Ext(recommendation_service, "Recommendation Service", "Python, FastAPI")
System_Ext(digital_asset_service, "Digital Asset Delivery Service", "Go")

Rel(api_router_waf, auth_middleware, "Passes inbound requests for token validation", "")
Rel(auth_middleware, internal_routing_proxy, "Forwards authorized requests", "")
Rel(internal_routing_proxy, catalog_service, "Internal routing", "gRPC over TLS")
Rel(internal_routing_proxy, order_service, "Internal routing", "gRPC over TLS")
Rel(internal_routing_proxy, recommendation_service, "Internal routing", "gRPC over TLS")
Rel(internal_routing_proxy, digital_asset_service, "Internal routing", "gRPC over TLS")

@enduml