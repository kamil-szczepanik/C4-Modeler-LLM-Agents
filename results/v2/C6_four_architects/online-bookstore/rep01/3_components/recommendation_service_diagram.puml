@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Recommendation Service container

Container_Boundary(recommendation_service, "Recommendation Service") {
    Component(api_router, "API Router", "Python, FastAPI", "Handles incoming HTTP/REST requests and routes them to internal components.")
    Component(recommendation_engine, "Recommendation Engine", "Python, Scikit-Learn, Pandas, NumPy", "Powers vectorization, collaborative filtering logic, and real-time recommendations.")
    Component(model_cache_manager, "Model Cache Manager", "Python", "Manages caching layers to deliver sub-millisecond model responses.")
    Component(data_access_layer, "Data Access Layer", "Python, AWS SDK", "Interacts with data stores for cold-start seeding and item affinity graphs.")
    Component(telemetry_interceptor, "Telemetry Interceptor", "Python, OpenTelemetry", "Captures distributed tracing telemetry and forwards it locally.")
    Component(feature_extractor, "Feature Extractor", "Python, NumPy, Pandas", "Extracts and transforms features for the recommendation algorithms.")
}

System_Ext(redis_elasticache, "Redis ElastiCache", "Redis cache layer")
System_Ext(amazon_s3, "Amazon S3", "Object storage")
System_Ext(amazon_dynamodb, "Amazon DynamoDB", "NoSQL database")
System_Ext(adot_sidecar, "AWS Distro for OpenTelemetry", "Telemetry sidecar")

Rel(api_router, recommendation_engine, "Delegates recommendation requests")
Rel(recommendation_engine, model_cache_manager, "Retrieves cached models and inference data")
Rel(model_cache_manager, redis_elasticache, "Reads/writes cached model data", "TCP")
Rel(recommendation_engine, amazon_s3, "Fetches serialized machine learning models", "HTTPS")
Rel(data_access_layer, amazon_dynamodb, "Accesses item affinity graphs restricted to cold-start seeding", "HTTPS")
Rel(telemetry_interceptor, adot_sidecar, "Sends tracing data", "OTLP/gRPC")
Rel(api_router, feature_extractor, "Passes input parameters for feature extraction")
Rel(feature_extractor, recommendation_engine, "Provides processed feature vectors")

@enduml