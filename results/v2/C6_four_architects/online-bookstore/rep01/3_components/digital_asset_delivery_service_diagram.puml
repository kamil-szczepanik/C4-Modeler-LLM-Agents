@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Digital Asset Delivery Service container

Container_Boundary(digital_asset_delivery_service, "Digital Asset Delivery Service") {
    Component(api_handler_component, "API Handler Component", "Go (net/http)", "Handles incoming HTTP requests for digital asset delivery.")
    Component(entitlement_verifier_component, "Entitlement Verifier Component", "Go", "Verifies user licenses and purchase entitlements.")
    Component(asset_cache_manager_component, "Asset Cache Manager Component", "Go", "Manages caching to bypass redundant asset verification and processing.")
    Component(watermarking_component, "Watermarking Component", "Go", "Applies dynamic watermarks to digital assets.")
    Component(signed_url_generator_component, "Signed URL Generator Component", "Go", "Generates time-limited signed URLs for secure asset downloads.")
    Component(audit_logger_component, "Audit Logger Component", "Go", "Handles GDPR-compliant audit logging asynchronously.")
    Component(redis_elasticache, "Redis ElastiCache", "Redis ElastiCache", "Provides fast in-memory caching for assets and verification.")
    Component(amazon_aurora_postgresql, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Stores reliable purchase and entitlement records.")
    Component(amazon_s3_digital_assets, "Amazon S3 Digital Assets", "Amazon S3 & CloudFront", "Delivers secure, scalable cloud storage for e-books and digital assets.")
    Component(amazon_sqs, "Amazon SQS", "Amazon SQS", "Handles asynchronous, non-blocking event publishing for audit compliance.")
}

Rel(api_handler_component, entitlement_verifier_component, "In-memory function call")
Rel(entitlement_verifier_component, asset_cache_manager_component, "In-memory function call")
Rel(asset_cache_manager_component, redis_elasticache, "TCP/TLS using go-redis")
Rel(entitlement_verifier_component, amazon_aurora_postgresql, "TCP/TLS using database/sql")
Rel(entitlement_verifier_component, watermarking_component, "In-memory function call")
Rel(watermarking_component, amazon_s3_digital_assets, "HTTPS using aws-sdk-go-v2")
Rel(watermarking_component, signed_url_generator_component, "In-memory function call")
Rel(signed_url_generator_component, amazon_s3_digital_assets, "HTTPS using aws-sdk-go-v2")
Rel(audit_logger_component, amazon_sqs, "HTTPS using aws-sdk-go-v2")

@enduml