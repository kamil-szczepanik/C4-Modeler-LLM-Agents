@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon DynamoDB container

Container_Boundary(amazon_dynamodb, "Amazon DynamoDB") {
    Component(Recommendation Store Table, "Recommendation Store Table", "Amazon DynamoDB", "Stores recommendation data with Partition Key CustomerID and Sort Key ProductID.")
    Component(Customer Session State Table, "Customer Session State Table", "Amazon DynamoDB", "TTL-enabled cart persistence table for managing active shopping carts.")
    Component(Customer Reviews & Ratings Table, "Customer Reviews & Ratings Table", "Amazon DynamoDB", "Stores product reviews and ratings with Partition Key ProductID and Sort Key ReviewID.")
    Component(Idempotency & Lock Table, "Idempotency & Lock Table", "Amazon DynamoDB", "Verifies transaction states using Partition Key OperationID.")
}

System_Ext(Recommendation Service, "Recommendation Service", "External service that reads recommendations.")
System_Ext(Order & Checkout Service, "Order & Checkout Service", "External service handling orders and checkout.")
System_Ext(Catalog & Search Service, "Catalog & Search Service", "External service for catalog and search.")

Rel(Recommendation Service, Recommendation Store Table, "Reads recommendation data", "Native Database Protocol over VPC")
Rel(Order & Checkout Service, Customer Session State Table, "Persists active shopping carts", "Native AWS SDK over VPC, HTTPS/TLS")
Rel(Catalog & Search Service, Customer Reviews & Ratings Table, "Fetches product reviews and ratings", "Native AWS SDK over VPC, HTTPS/TLS")
Rel(Order & Checkout Service, Idempotency & Lock Table, "Verifies transaction states", "Native AWS SDK over VPC, HTTPS/TLS")

@enduml