@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(catalog_search_service, "Catalog & Search Service") {
    Component(Search_Controller, "Search Controller", "Spring Boot REST Controller", "Exposes REST endpoints for catalog browsing and full-text search queries.")
    Component(Catalog_Service, "Catalog Service", "Spring Boot Service", "Handles business logic for book catalog management and item retrieval.")
    Component(Search_Indexer, "Search Indexer", "Spring Boot Service", "Synchronizes product data with the search index for fast text retrieval.")
}

Rel(Search_Controller, Catalog_Service, "Delegates catalog queries")
Rel(Catalog_Service, Search_Indexer, "Triggers index updates")

@enduml