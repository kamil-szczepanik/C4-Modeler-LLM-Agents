@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon S3 Digital Assets container

Container_Boundary(amazon_s3_digital_assets, "Amazon S3 Digital Assets") {
    Component(Customer SPA, "Customer SPA", "React, Amazon S3, CloudFront", "Customer single-page application for browsing and managing book orders.")
    Component(Order & Checkout Service, "Order & Checkout Service", "Node.js", "Handles order processing and purchase entitlement validation.")
    Component(Asset Management Controller, "Asset Management Controller", "Go / AWS Lambda", "Manages asset requests and coordinates download tokens.")
    Component(CloudFront Signer Component, "CloudFront Signer Component", "Go SDK", "Generates signed URLs for secure e-book delivery.")
    Component(S3 Private Storage Bucket, "S3 Private Storage Bucket", "Amazon S3, AES-256", "Encrypted private object storage for binary e-book assets.")
    Component(Access Audit Monitor, "Access Audit Monitor", "Amazon CloudFront Standard Logs / CloudWatch", "Monitors access and logs delivery metrics.")
    Component(Bucket Policy Enforcer, "Bucket Policy Enforcer", "AWS IAM / S3 Bucket Policy", "Enforces strict bucket policies preventing public access.")
}

Component_Ext(CloudFront Edge, "CloudFront Edge", "Amazon CloudFront", "CloudFront CDN Edge location.")

Rel(Customer SPA, Asset Management Controller, "Requests download token", "HTTPS / REST")
Rel(Asset Management Controller, CloudFront Signer Component, "Requests signed URL generation", "In-process Go function")
Rel(CloudFront Signer Component, Order & Checkout Service, "Validates purchase entitlement", "gRPC / HTTPS")
Rel(CloudFront Edge, S3 Private Storage Bucket, "Retrieves objects", "HTTPS / AWS IAM Origin Access Control (OAC)")

@enduml