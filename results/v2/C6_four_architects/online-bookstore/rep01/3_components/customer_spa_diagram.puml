@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(customer_spa, "Customer SPA") {
    Component(catalog_module, "Catalog Module", "React, Vite", "Handles book browsing and keyword search.")
    Component(checkout_cart_module, "Checkout & Cart Module", "React, Vite", "Manages shopping cart and secure checkout.")
    Component(reviews_ratings_module, "Reviews & Ratings Module", "React, Vite", "Processes 5-star ratings and customer reviews.")
    Component(recommendation_display_module, "Recommendation Display Module", "React, Vite", "Renders \"Customers also bought\" suggestions.")
    Component(auth_context_provider, "Auth Context Provider", "React, OIDC", "Manages user authentication via OIDC.")
    Component(state_management_layer, "State Management Layer", "Zustand", "Utilizes Zustand for local cart and UI state.")
    Component(api_client_layer, "API Client Layer", "Axios", "Centralizes requests using Axios with interceptors.")
    Component(telemetry_error_modules, "Telemetry & Error Modules", "React Error Boundaries, Web Vitals", "Captures web vitals and implements React Error Boundaries.")
}

System_Ext(aws_api_gateway, "AWS API Gateway", "API Gateway")
System_Ext(amazon_cognito, "Amazon Cognito", "Identity Provider")

Rel(checkout_cart_module, state_management_layer, "Stores and retrieves cart state using", "Zustand")
Rel(api_client_layer, aws_api_gateway, "Sends API requests for data and transactions via", "HTTPS/REST")
Rel(auth_context_provider, amazon_cognito, "Authenticates users and manages tokens via", "HTTPS/OIDC")

@enduml