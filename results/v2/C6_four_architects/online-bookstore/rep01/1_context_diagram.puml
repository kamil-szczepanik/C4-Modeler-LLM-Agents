@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "End user who browses the catalogue, manages a cart, makes purchases, and leaves reviews.")
Person(Admin_Support_Staff, "Admin/Support Staff", "Staff member who manages catalogue, orders, and customer support operations.")

System(Online_Bookstore, "Online Bookstore", "An Amazon-style e-commerce online bookstore for physical and e-books handling multi-currency transactions, catalogue search, recommendations, and reviews at 1M MAU.")

System_Ext(Payment_Gateway, "Payment Gateway", "Stripe/PayPal integration for processing multi-currency transactions.")
System_Ext(Shipping_Provider_APIs, "Shipping Provider APIs", "External shipping services for fulfilling physical book deliveries.")
System_Ext(Identity_Provider, "Identity Provider", "Auth0/Cognito for authentication and user management.")
System_Ext(Notification_Service, "Notification Service", "SES/SendGrid for sending emails and notifications.")
System_Ext(Recommendation_Service, "Recommendation Service", "Amazon Personalize for generating book recommendations.")
System_Ext(Tax_Calculation_Service, "Tax Calculation Service", "Avalara/TaxJar for calculating applicable transaction taxes.")

Rel(Customer, Online_Bookstore, "Uses the bookstore via HTTPS for browsing, purchasing, and managing account.", "HTTPS")
Rel(Admin_Support_Staff, Online_Bookstore, "Manages system operations, catalogue, and support tasks.", "HTTPS")
Rel(Online_Bookstore, Payment_Gateway, "Calls payment gateway to process transactions.", "HTTPS/REST")
Rel(Online_Bookstore, Shipping_Provider_APIs, "Calls shipping APIs to manage order fulfillment.", "HTTPS/REST")
Rel(Online_Bookstore, Identity_Provider, "Authenticates users via identity provider.", "HTTPS/REST")
Rel(Online_Bookstore, Notification_Service, "Triggers notifications and emails.", "HTTPS/REST")
Rel(Online_Bookstore, Recommendation_Service, "Fetches personalized book recommendations.", "HTTPS/REST")
Rel(Online_Bookstore, Tax_Calculation_Service, "Calculates taxes for transactions.", "HTTPS/REST")

@enduml