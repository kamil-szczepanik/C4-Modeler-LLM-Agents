@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore

Person(Customer, "Customer", "End user who browses the catalogue, manages a cart, makes purchases, and leaves reviews.")
Person(AdminStaff, "Admin Staff", "Staff member who manages catalogue, orders, and administrative tasks.")

System_Ext(AmazonCognito, "Amazon Cognito", "Authentication and user management identity provider.")

System_Boundary(OnlineBookstore, "Online Bookstore") {
    Container(CustomerSPA, "Customer SPA", "React, Amazon S3, CloudFront", "Frontend single-page application for customers to browse, checkout, and view recommendations.")
    Container(AdminSPA, "Admin SPA", "React, Amazon S3, CloudFront", "Frontend single-page application for administrative staff.")
    Container(AWSPAPIGateway, "AWS API Gateway", "AWS API Gateway, AWS WAF", "Edge API gateway routing traffic and protecting against threats using WAF.")
    Container(CatalogSearchService, "Catalog & Search Service", "Spring Boot, OpenSearch", "Handles book catalogue management and keyword search.")
    Container(OrderCheckoutService, "Order & Checkout Service", "Node.js", "Processes customer orders and secure checkouts.")
    Container(RecommendationService, "Recommendation Service", "Python, FastAPI", "Generates personalized book recommendations.")
    Container(AsyncWorker, "Async Worker", "Container", "Processes asynchronous background tasks and events.")
    Container(DigitalAssetDeliveryService, "Digital Asset Delivery Service", "Go", "Secures and delivers digital assets and e-books.")
    Container(AmazonEventBridgeSQS, "Amazon EventBridge & SQS", "Amazon EventBridge, AWS SQS", "Asynchronous event bus for domain decoupling.")
    ContainerDb(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL, Global Tables", "Multi-region relational database for transactional integrity.")
    ContainerDb(AmazonDynamoDB, "Amazon DynamoDB", "Amazon DynamoDB", "NoSQL database supporting recommendations and scale.")
    ContainerDb(RedisElastiCache, "Redis ElastiCache", "Redis, ElastiCache", "In-memory data store for session management and caching.")
    Container(AmazonS3DigitalAssets, "Amazon S3 Digital Assets", "Amazon S3, CloudFront Signed URLs", "Storage bucket hosting secure digital e-book assets.")
    Container(AWSDistroforOpenTelemetry, "AWS Distro for OpenTelemetry", "ADOT Sidecar", "Observability sidecar for distributed tracing.")
}

Rel(Customer, CustomerSPA, "Interacts via browser for catalog browsing, checkout, and reviews.", "HTTPS")
Rel(AdminStaff, AdminSPA, "Interacts via browser for administrative operations.", "HTTPS")
Rel(CustomerSPA, AWSPAPIGateway, "Sends API requests and communicates via web sockets.", "HTTPS/WSS")
Rel(AdminSPA, AWSPAPIGateway, "Sends administrative API requests.", "HTTPS/WSS")
Rel(CustomerSPA, AmazonCognito, "Authenticates users via OIDC.", "HTTPS/OIDC")
Rel(AdminSPA, AmazonCognito, "Authenticates admin users via OIDC.", "HTTPS/OIDC")
Rel(AWSPAPIGateway, CatalogSearchService, "Routes internal traffic to catalog backend.", "gRPC over TLS / HTTPS")
Rel(AWSPAPIGateway, OrderCheckoutService, "Routes internal traffic to order backend.", "gRPC over TLS / HTTPS")
Rel(AWSPAPIGateway, RecommendationService, "Routes internal traffic to recommendation backend.", "gRPC over TLS / HTTPS")
Rel(AWSPAPIGateway, DigitalAssetDeliveryService, "Routes internal traffic to digital asset backend.", "gRPC over TLS / HTTPS")
Rel(OrderCheckoutService, AmazonEventBridgeSQS, "Publishes asynchronous events.", "AWS SDK / API")
Rel(AmazonEventBridgeSQS, AsyncWorker, "Triggers background tasks.", "AWS SDK / Queue Messaging")
Rel(AmazonEventBridgeSQS, DigitalAssetDeliveryService, "Triggers post-checkout asset delivery events.", "AWS SDK / Queue Messaging")
Rel(CatalogSearchService, AmazonAuroraPostgreSQL, "Reads and writes transactional catalog data.", "Native Database Protocol over VPC")
Rel(OrderCheckoutService, AmazonAuroraPostgreSQL, "Reads and writes order and transactional data.", "Native Database Protocol over VPC")
Rel(RecommendationService, AmazonDynamoDB, "Reads recommendation data.", "Native Database Protocol over VPC")
Rel(OrderCheckoutService, RedisElastiCache, "Manages user sessions and caching.", "Redis Protocol over VPC")
Rel(Customer, AmazonS3DigitalAssets, "Downloads e-books securely using CloudFront Signed URLs.", "HTTPS / CloudFront")

@enduml