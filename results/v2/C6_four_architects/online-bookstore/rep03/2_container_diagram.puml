@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore

Person(Customer, "Customer", "End user who browses, purchases physical and electronic books, leaves reviews, and manages their cart.")
Person(Store Administrator, "Store Administrator", "System administrator managing catalog, orders, and platform operations.")

System_Ext(Stripe/PayPal, "Stripe/PayPal", "External payment gateway services for secure financial transactions.")
System_Ext(UPS/FedEx, "UPS/FedEx", "External logistics and shipping providers for physical book fulfillment.")
System_Ext(Avalara, "Avalara", "External tax calculation service for compliance.")
System_Ext(AWS Personalize, "AWS Personalize", "Machine learning service for personalized book recommendations.")
System_Ext(AWS Fraud Detector, "AWS Fraud Detector", "Fraud detection service to secure transactions and user activity.")

System_Boundary(Online Bookstore, "Online Bookstore") {
    Container(React Single Page Application, "React Single Page Application", "React, Amazon S3, Amazon CloudFront", "Frontend SPA hosted on Amazon S3 and served via Amazon CloudFront for global content delivery.")
    Container(Amazon API Gateway, "Amazon API Gateway", "AWS API Gateway", "Edge service for routing, rate limiting, and JWT validation.")
    Container(Catalog & Search Service, "Catalog & Search Service", "Spring Boot", "Manages catalog browsing and search capabilities.")
    Container(Order & Checkout Service, "Order & Checkout Service", "Node.js", "Handles order processing and checkout flows.")
    Container(Payment & Currency Service, "Payment & Currency Service", ".NET Core", "Processes multi-currency payments and financial transactions.")
    Container(Recommendation & Review Service, "Recommendation & Review Service", "Python", "Delivers recommendations and user reviews.")
    Container(Data Privacy & User Service, "Data Privacy & User Service", "Python", "Manages user data and ensures GDPR compliance.")
    Container(Admin & Content Management Service, "Admin & Content Management Service", ".NET Core", "Administers content and platform management operations.")
    Container(Async Worker Service, "Async Worker Service", "Python", "Processes asynchronous background tasks and workflows.")
    ContainerDb(Amazon RDS (PostgreSQL), "Amazon RDS (PostgreSQL)", "Amazon RDS, PostgreSQL", "Relational database for structured data storage.")
    ContainerDb(Amazon DynamoDB, "Amazon DynamoDB", "Amazon DynamoDB", "NoSQL data store for shopping carts and high-scale data.")
    ContainerDb(Amazon ElastiCache (Redis), "Amazon ElastiCache (Redis)", "Amazon ElastiCache, Redis", "In-memory caching layer for low-latency search and currency caching.")
    ContainerDb(Amazon OpenSearch, "Amazon OpenSearch", "Amazon OpenSearch", "Search engine for catalogue indexing and discovery.")
    Container(Amazon EventBridge & SQS, "Amazon EventBridge & SQS", "Amazon EventBridge, Amazon SQS", "Event-driven messaging and integration bus for asynchronous workflows.")
}

Rel(Customer, React Single Page Application, "Browses catalogue and interacts with the storefront", "HTTPS via CloudFront")
Rel(Store Administrator, React Single Page Application, "Manages store administration and content", "HTTPS via CloudFront")
Rel(React Single Page Application, Amazon API Gateway, "Sends HTTPS API requests for data and actions", "HTTPS")
Rel(Amazon API Gateway, Catalog & Search Service, "Routes catalog and search requests", "gRPC / HTTPS over TLS")
Rel(Amazon API Gateway, Order & Checkout Service, "Routes order and checkout operations", "gRPC / HTTPS over TLS")
Rel(Amazon API Gateway, Payment & Currency Service, "Routes payment and currency requests", "gRPC / HTTPS over TLS")
Rel(Amazon API Gateway, Recommendation & Review Service, "Routes recommendation and review queries", "gRPC / HTTPS over TLS")
Rel(Amazon API Gateway, Data Privacy & User Service, "Routes user and GDPR compliance requests", "gRPC / HTTPS over TLS")
Rel(Amazon API Gateway, Admin & Content Management Service, "Routes admin operations", "gRPC / HTTPS over TLS")
Rel(Order & Checkout Service, Stripe/PayPal, "Processes payment transactions", "HTTPS Egress")
Rel(Payment & Currency Service, Stripe/PayPal, "Processes multi-currency payments", "HTTPS Egress")
Rel(Order & Checkout Service, Avalara, "Calculates taxes", "HTTPS Egress")
Rel(Order & Checkout Service, UPS/FedEx, "Coordinates shipment and fulfillment", "HTTPS Egress")
Rel(Recommendation & Review Service, AWS Personalize, "Fetches personalized recommendations", "HTTPS Egress")
Rel(Order & Checkout Service, AWS Fraud Detector, "Screens transactions for fraud", "HTTPS Egress")
Rel(Catalog & Search Service, Amazon RDS (PostgreSQL), "Reads and writes relational catalogue data", "JDBC / SQL over TCP")
Rel(Catalog & Search Service, Amazon OpenSearch, "Queries catalogue search indices", "TCP")
Rel(Order & Checkout Service, Amazon DynamoDB, "Manages shopping carts and order data", "NoSQL API over TCP")
Rel(Payment & Currency Service, Amazon ElastiCache (Redis), "Caches currency rates and session data", "Redis Protocol over TCP")
Rel(Catalog & Search Service, Amazon ElastiCache (Redis), "Caches search and catalogue data", "Redis Protocol over TCP")
Rel(Order & Checkout Service, Amazon EventBridge & SQS, "Publishes and consumes order processing events", "Event-driven Messaging")
Rel(Async Worker Service, Amazon EventBridge & SQS, "Processes asynchronous background tasks", "Event-driven Messaging")

@enduml