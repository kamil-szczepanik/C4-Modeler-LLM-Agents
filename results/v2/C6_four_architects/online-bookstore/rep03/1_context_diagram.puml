@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container Diagram for Online Bookstore

Person(Customer, "Customer", "End user who browses, purchases physical and electronic books, leaves reviews, and manages their cart.")
Person(StoreAdmin, "Store Administrator", "System administrator managing catalog, orders, and platform operations.")

System_Ext(CloudFront, "AWS CloudFront/Route 53", "Content delivery network and DNS routing for global frontend and API access.")
System_Ext(Stripe, "Stripe/PayPal", "External payment gateway services for secure financial transactions.")
System_Ext(UPS, "UPS/FedEx", "External logistics and shipping providers for physical book fulfillment.")
System_Ext(Avalara, "Avalara", "External tax calculation service for compliance.")
System_Ext(SES, "AWS SES/SNS", "Messaging and notification services for email and notifications.")
System_Ext(Personalize, "AWS Personalize", "Machine learning service for personalized book recommendations.")
System_Ext(FraudDetector, "AWS Fraud Detector", "Fraud detection service to secure transactions and user activity.")

System_Boundary(OnlineBookstore, "Online Bookstore") {
    Container(WebApp, "Web Application (React/Next.js SPA)", "React / Next.js / S3", "Frontend SPA hosted on S3 and CloudFront for fast page loads.")
    Container(ApiGateway, "API Gateway", "AWS API Gateway", "Entry point for routing client requests to backend microservices.")
    Container(CatalogService, "Catalog Service", "Microservice", "Manages the book catalog and product data.")
    Container(CartService, "Cart & Checkout Service", "Microservice", "Handles user shopping carts and checkout flows.")
    Container(OrderService, "Order & Fulfillment Service", "Microservice", "Processes orders and manages fulfillment workflows.")
    Container(UserService, "User & Auth Service", "Microservice", "Manages user accounts, authentication, and authorization.")
    Container(BackgroundWorker, "Background Worker / Job Processors", "Worker Process", "Processes asynchronous jobs and background tasks.")
    ContainerDb(Aurora, "Amazon Aurora", "Amazon Aurora", "Primary relational storage database.")
    ContainerDb(OpenSearch, "OpenSearch", "Amazon OpenSearch", "Catalog search engine for fast product discovery.")
    ContainerDb(Redis, "Amazon ElastiCache (Redis)", "Amazon ElastiCache (Redis)", "Caching layer for product searches and session management.")
    ContainerDb(EventBus, "Amazon EventBridge/SQS", "Amazon EventBridge / SQS", "Asynchronous messaging event bus for decoupled microservices.")
}

Rel(Customer, CloudFront, "Accesses the storefront via secure web traffic", "HTTPS (TLS 1.3)")
Rel(StoreAdmin, CloudFront, "Accesses administrative tools via secure web traffic", "HTTPS (TLS 1.3)")
Rel(CloudFront, WebApp, "Serves static assets", "HTTPS")
Rel(WebApp, ApiGateway, "Makes API requests", "HTTPS")
Rel(ApiGateway, CatalogService, "Routes catalog queries and requests", "REST / GraphQL / gRPC")
Rel(ApiGateway, CartService, "Routes cart and checkout operations", "REST / GraphQL / gRPC")
Rel(ApiGateway, OrderService, "Routes order creation and tracking requests", "REST / GraphQL / gRPC")
Rel(ApiGateway, UserService, "Routes authentication and user management requests", "REST / GraphQL / gRPC")

Rel(CartService, Stripe, "Processes payments", "REST / HTTPS")
Rel(CartService, Avalara, "Calculates taxes", "REST / HTTPS")
Rel(CartService, FraudDetector, "Screens transactions for fraud", "REST / HTTPS")
Rel(OrderService, UPS, "Coordinates shipment and fulfillment", "REST / HTTPS")
Rel(CatalogService, Personalize, "Fetches recommendations", "REST / HTTPS")
Rel(UserService, SES, "Sends notifications and emails", "AWS SES / SNS")

Rel(CatalogService, Aurora, "Reads and writes relational data", "TCP / Internal VPC")
Rel(CatalogService, OpenSearch, "Queries search index", "TCP / Internal VPC")
Rel(CartService, Redis, "Manages session and cache data", "TCP / Internal VPC")
Rel(OrderService, EventBus, "Publishes and consumes asynchronous events", "AWS EventBridge / SQS")

@enduml