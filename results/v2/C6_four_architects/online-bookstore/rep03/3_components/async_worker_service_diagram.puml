@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Async Worker Service", "Async Worker Service") {
    Component("Task Consumer Component", "Task Consumer Component", "Python / Celery or AWS Lambda", "Manages asynchronous workflows, task distribution, and message routing.")
    Component("Workflow Orchestrator Component", "Workflow Orchestrator Component", "Python / AWS Step Functions", "Orchestrates complex multi-step workflows and sagas.")
    Component("Notification Dispatcher Component", "Notification Dispatcher Component", "Python", "Dispatches customer alerts and notifications.")
    Component("Data Synchronization Component", "Data Synchronization Component", "Python", "Synchronizes data across data stores and services.")
    Component("GDPR/CCPA Compliance Purge Component", "GDPR/CCPA Compliance Purge Component", "Python", "Enforces regulatory compliance by anonymizing and purging PII data.")
    Component("Search Indexing Component", "Search Indexing Component", "Python", "Forwards catalogue updates and updates search indices.")
    Component("DLQ Handler Component", "DLQ Handler Component", "Python", "Routes failed messages and alerts the operations team.")
}

Component("Third-party Shipping APIs (UPS/FedEx)", "Third-party Shipping APIs (UPS/FedEx)", "HTTPS/REST", "External shipping services for shipment creation.")
Component("Avalara", "Avalara", "HTTPS/REST", "External tax calculation and commitment service.")
Component("AWS SES/SNS", "AWS SES/SNS", "AWS SDK / HTTPS", "Notification delivery infrastructure for customer alerts and operational paging.")
Component("Amazon RDS (PostgreSQL)", "Amazon RDS (PostgreSQL)", "PostgreSQL JDBC/TCP", "Relational database storing transactional state.")
Component("Amazon DynamoDB", "Amazon DynamoDB", "AWS SDK", "NoSQL database supporting PII anonymization and user data.")
Component("Amazon OpenSearch", "Amazon OpenSearch", "HTTPS / OpenSearch REST Client", "Search index synchronization target for catalogue browsing performance.")

Rel("Task Consumer Component", "Workflow Orchestrator Component", "Triggers sagas", "In-process Python function calls")
Rel("Task Consumer Component", "GDPR/CCPA Compliance Purge Component", "Triggers data deletion", "In-process Python function calls")
Rel("Task Consumer Component", "Search Indexing Component", "Forwards catalogue updates", "In-process Python function calls")
Rel("Task Consumer Component", "DLQ Handler Component", "Routes failed messages", "SQS SDK / Exception Handling")
Rel("Workflow Orchestrator Component", "Third-party Shipping APIs (UPS/FedEx)", "Requests shipment creation", "HTTPS/REST")
Rel("Workflow Orchestrator Component", "Avalara", "Calculates and commits taxes", "HTTPS/REST")
Rel("Notification Dispatcher Component", "AWS SES/SNS", "Sends notifications", "AWS SDK / HTTPS")
Rel("Data Synchronization Component", "Amazon RDS (PostgreSQL)", "Reads transactional state", "PostgreSQL JDBC/TCP")
Rel("GDPR/CCPA Compliance Purge Component", "Amazon RDS (PostgreSQL)", "Anonymizes PII", "SQL / AWS SDK")
Rel("GDPR/CCPA Compliance Purge Component", "Amazon DynamoDB", "Anonymizes PII", "SQL / AWS SDK")
Rel("Search Indexing Component", "Amazon OpenSearch", "Updates search indices", "HTTPS / OpenSearch REST Client")
Rel("DLQ Handler Component", "AWS SES/SNS", "Alerts operations team", "AWS SDK / HTTPS")

@enduml