@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon RDS (PostgreSQL) container

Container_(OrderCheckoutService, "Order & Checkout Service", "Microservice", "Persists transactional data")
Container_(CatalogSearchService, "Catalog & Search Service", "Microservice", "Reads catalogue data")
Container_(DataPrivacyUserService, "Data Privacy & User Service", "Microservice", "Manages profiles and compliance deletions")
Container_(PaymentCurrencyService, "Payment & Currency Service", "Microservice", "Persists transaction records")
Container_(RecommendationReviewService, "Recommendation & Review Service", "Microservice", "Reads history for feature extraction")
Container_(AdminContentManagementService, "Admin & Content Management Service", "Microservice", "Executes updates")
Container_(AsyncWorkerService, "Async Worker Service", "Microservice", "Updates job states")
Container_Ext(AmazonRDSReadReplicas, "Amazon RDS Read Replicas", "PostgreSQL Replicas", "Regional read replicas")

Container_Boundary(AmazonRDSPostgreSQL, "Amazon RDS (PostgreSQL)") {
    Component(PgBouncer, "PgBouncer", "PgBouncer", "Connection pooler for handling high-concurrency requests.")
    Component(PostgreSQLRelationalEngine, "PostgreSQL Relational Engine", "PostgreSQL 15+", "Core RDBMS managing ACID transactions.")
    Component(PartitionManager, "Partition Manager", "Declarative SQL", "Declarative table partitioning for performance and data purging.")
    Component(ExtensionManager, "Extension Manager", "Native extensions (pg_trgm, pgcrypto)", "Native extensions for search and encryption.")
    Component(RowLevelSecurityRLSPolicies, "Row-Level Security (RLS) Policies", "PostgreSQL RLS", "Tenant and regional data isolation mechanism.")
    Component(AuditLoggingSubsystem, "Audit & Logging Subsystem", "pgAudit", "Configured via pgAudit for compliance tracking.")
    Component(MigrationManager, "Migration Manager", "Flyway / Liquibase", "Schema version control integration.")
    Component(ReadReplicaRoutingLogic, "Read Replica Routing Logic", "PostgreSQL Streaming Replication / TCP", "Offloads read queries to regional replicas.")
}

Rel(OrderCheckoutService, PgBouncer, "Persists transactional data", "JDBC / TCP")
Rel(CatalogSearchService, PgBouncer, "Reads catalogue data", "JDBC / SQL over TCP")
Rel(DataPrivacyUserService, PgBouncer, "Manages profiles and compliance deletions", "SQL over TCP")
Rel(PaymentCurrencyService, PgBouncer, "Persists transaction records", "ADO.NET / SQL over TCP")
Rel(RecommendationReviewService, PgBouncer, "Reads history for feature extraction", "Psycopg2 / TCP")
Rel(AdminContentManagementService, PgBouncer, "Executes updates", "JDBC / SQL over TCP")
Rel(AsyncWorkerService, PgBouncer, "Updates job states", "JDBC / SQL over TCP")

Rel(PgBouncer, PostgreSQLRelationalEngine, "Routes connections", "TCP")
Rel(PostgreSQLRelationalEngine, PartitionManager, "Uses", "SQL")
Rel(PostgreSQLRelationalEngine, ExtensionManager, "Uses", "Internal")
Rel(PostgreSQLRelationalEngine, RowLevelSecurityRLSPolicies, "Enforces", "Internal")
Rel(PostgreSQLRelationalEngine, AuditLoggingSubsystem, "Logs to", "Internal")
Rel(MigrationManager, PostgreSQLRelationalEngine, "Applies schema changes", "SQL")
Rel(ReadReplicaRoutingLogic, AmazonRDSReadReplicas, "Replicates data", "PostgreSQL Streaming Replication / TCP")
@enduml