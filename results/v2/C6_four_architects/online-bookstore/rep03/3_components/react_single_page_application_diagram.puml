@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the React Single Page Application container

Container_Boundary(react_spa, "React Single Page Application") {
    Component(Routing_Shell_Component, "Routing & Shell Component", "React, React Router", "Delivers a responsive user experience and manages page layout and client-side routing.")
    Component(Catalog_Search_Component, "Catalog & Search Component", "React", "Handles browsing and searching of books within the store.")
    Component(Cart_Checkout_Component, "Cart & Checkout Component", "React", "Manages shopping cart contents and the checkout process.")
    Component(Recommendation_Review_Component, "Recommendation & Review Component", "React", "Displays book recommendations and user reviews.")
    Component(Auth_Profile_Component, "Auth & Profile Component", "React", "Handles user authentication and profile management.")
    Component(API_Client_Interceptor_Component, "API Client & Interceptor Component", "Axios", "Centralizes HTTP requests, token injection, and OWASP security headers, routing outbound traffic exclusively.")
    Component(Localization_Currency_Component, "Localization & Currency Component", "i18next", "Handles multi-currency display (USD, EUR, GBP) and client-side translation dictionaries.")
}

Rel(Routing_Shell_Component, API_Client_Interceptor_Component, "Routes outbound traffic exclusively", "In-memory")
Rel(Catalog_Search_Component, API_Client_Interceptor_Component, "Routes outbound traffic exclusively", "In-memory")
Rel(Cart_Checkout_Component, API_Client_Interceptor_Component, "Routes outbound traffic exclusively", "In-memory")
Rel(Recommendation_Review_Component, API_Client_Interceptor_Component, "Routes outbound traffic exclusively", "In-memory")
Rel(Auth_Profile_Component, API_Client_Interceptor_Component, "Routes outbound traffic exclusively", "In-memory")
Rel(Localization_Currency_Component, API_Client_Interceptor_Component, "Routes outbound traffic exclusively", "In-memory")

@enduml