@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(react_spa, "React Single Page Application", "Client application")
System_Ext(redis, "Amazon ElastiCache (Redis)", "In-memory data store")
System_Ext(backend_services, "Backend Microservices", "Internal microservices")

Container_Boundary(api_gateway, "Amazon API Gateway") {
    Component(edge_router, "Edge Router & Reverse Proxy", "AWS API Gateway V2 / HTTP APIs", "Acts as the edge router and reverse proxy, handling client requests and proxying sanitized payloads to backend microservices.")
    Component(waf, "WAF & Threat Mitigation Filter", "AWS WAF", "Inspects incoming payloads for SQLi, XSS, and bot traffic.")
    Component(auth_filter, "Authentication & Authorization Filter", "AWS Lambda Authorizer", "Validates JWT tokens for incoming requests.")
    Component(rate_limiter, "Rate Limiting & Throttling Engine", "API Gateway Usage Plans & Amazon ElastiCache Redis", "Tracks token-bucket sliding windows to enforce rate limits and throttling.")
    Component(transformer, "Request/Response Transformation Engine", "API Gateway Mapping Templates", "Transforms requests and responses at the edge boundary.")
    Component(logger, "API Logging & Telemetry Publisher", "Amazon CloudWatch & AWS X-Ray", "Publishes API logs and provides native distributed tracing and observability.")
}

Rel(react_spa, edge_router, "Submits client requests", "HTTPS / HTTP/2 over TLS 1.3")
Rel(edge_router, waf, "Inspects incoming payloads", "AWS WAF WebACL")
Rel(edge_router, auth_filter, "Validates JWT tokens", "AWS Lambda")
Rel(rate_limiter, redis, "Tracks token-bucket sliding windows", "TCP / Redis Protocol")
Rel(transformer, backend_services, "Proxies sanitized payloads", "gRPC over HTTP/2")

@enduml