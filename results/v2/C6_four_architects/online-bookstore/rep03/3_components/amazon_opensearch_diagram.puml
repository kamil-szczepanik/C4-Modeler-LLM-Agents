@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(catalog_search_service, "Catalog & Search Service", "External Backend Service")
Person(async_worker_service, "Async Worker Service", "External Async Worker Service")

Container_Boundary(amazon_opensearch, "Amazon OpenSearch") {
    Component(Search_Indexing_Engine, "Search Indexing Engine", "Apache Lucene / OpenSearch Core", "Indexes catalog data and provides fast text search capabilities for books.")
    Component(Query_Processing_API, "Query Processing API", "RESTful HTTP API / OpenSearch DSL", "Receives and evaluates search queries from the Catalog & Search Service.")
    Component(Data_Sync_Handler, "Data Sync Handler", "Event Listener / REST endpoint", "Ingests catalogue update events from Async Worker Services to keep search indices synchronized.")
}

Rel(catalog_search_service, Query_Processing_API, "Queries catalogue search indices", "HTTPS/REST via OpenSearch DSL")
Rel(async_worker_service, Data_Sync_Handler, "Syncs catalogue update events", "HTTPS/REST")

@enduml