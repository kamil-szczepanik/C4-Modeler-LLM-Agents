@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(catalog_and_search_service, "Catalog & Search Service") {
    Component(SearchController, "Search Controller", "Spring Boot", "Handles incoming search requests for books.")
    Component(CatalogController, "Catalog Controller", "Spring Boot", "Manages catalog retrieval and product details endpoints.")
    Component(SearchService, "Search Service", "Spring Boot", "Contains business logic for search and filtering operations.")
    Component(CatalogManager, "Catalog Manager", "Spring Boot", "Orchestrates catalog domain operations and data access.")
    Component(CatalogCacheManager, "Catalog Cache Manager", "Spring Boot, Amazon ElastiCache (Redis)", "Manages caching for search and catalogue data to ensure sub-second retrieval.")
    Component(EventConsumer, "Event Consumer", "Spring Boot, Amazon SQS", "Handles asynchronous event ingestion and synchronization.")
    Component(SearchIndexer, "Search Indexer", "Spring Boot, Amazon OpenSearch", "Updates and queries catalogue search indices.")
    Component(CatalogDomainModel, "Catalog Domain Model", "Java", "Represents the core catalog domain entities and business rules.")
    Component(CatalogSecurityValidationInterceptor, "Catalog Security/Validation Interceptor", "Spring AOP", "Provides security validation and interception for catalog requests.")
    Component(CatalogCircuitBreaker, "Catalog Circuit Breaker", "Resilience4j", "Ensures resilience and fault tolerance for catalog operations.")
    Component(CatalogMetricsTelemetryInterceptor, "Catalog Metrics & Telemetry Interceptor", "Micrometer", "Exposes operational telemetry and metrics.")
}

Rel(SearchController, SearchService, "Delegates search queries")
Rel(CatalogController, CatalogManager, "Delegates catalogue management requests")
Rel(SearchService, SearchIndexer, "Queries search indices")
Rel(CatalogManager, CatalogCacheManager, "Checks and updates cache")
Rel(CatalogManager, CatalogDomainModel, "Uses domain models")
Rel(EventConsumer, CatalogManager, "Triggers domain updates from async events")

@enduml