@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon ElastiCache (Redis) container

Container_Ext(payment_currency_service, "Payment & Currency Service", ".NET Core", "Provides payment and currency conversion capabilities.")
Container_Ext(catalog_search_service, "Catalog & Search Service", "Spring Boot", "Provides catalog search and query capabilities.")
Container_Ext(order_checkout_service, "Order & Checkout Service", "Node.js", "Handles order processing and checkout workflows.")
System_Ext(api_gateway, "Amazon API Gateway", "Managed API Gateway", "Manages external API requests and routing.")

Container_Boundary(elasticache_redis, "Amazon ElastiCache (Redis)") {
    Component(Currency_Rate_Cache_Component, "Currency Rate Cache Component", "Amazon ElastiCache, Redis", "Caches currency rates for the Payment & Currency Service.")
    Component(Catalog_Query_Cache_Component, "Catalog Query Cache Component", "Amazon ElastiCache, Redis", "Caches catalog queries for the Catalog & Search Service.")
    Component(Session_Store_Component, "Session Store Component", "Amazon ElastiCache, Redis", "Stores user sessions for the Order & Checkout Service.")
    Component(Distributed_Rate_Limiter_Component, "Distributed Rate Limiter Component", "Amazon ElastiCache, Redis", "Handles distributed rate limiting for Amazon API Gateway.")
    Component(Idempotency__Deduplication_Store_Component, "Idempotency & Deduplication Store Component", "Amazon ElastiCache, Redis", "Provides idempotency and deduplication for the Order & Checkout Service.")
}

Rel(payment_currency_service, Currency_Rate_Cache_Component, "Redis Protocol over TCP")
Rel(catalog_search_service, Catalog_Query_Cache_Component, "Redis Protocol over TCP")
Rel(order_checkout_service, Session_Store_Component, "Redis Protocol over TCP")
Rel(api_gateway, Distributed_Rate_Limiter_Component, "Redis Protocol over TCP")
Rel(order_checkout_service, Idempotency__Deduplication_Store_Component, "Redis Protocol over TCP")

@enduml