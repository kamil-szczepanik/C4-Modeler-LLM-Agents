@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon DynamoDB container

Container_Boundary("Amazon_DynamoDB", "Amazon DynamoDB") {
    Component("Request_Router", "Request Router", "AWS Managed Service", "Routes incoming client requests to the appropriate storage nodes.")
    Component("Storage_Nodes_RocksDB", "Storage Nodes (RocksDB)", "RocksDB", "Manages underlying data storage and retrieval using RocksDB.")
    Component("Streams_Processor", "Streams Processor", "AWS DynamoDB Streams", "Triggers change data capture events and processes table streams.")
    Component("Global_Tables_Replicator", "Global Tables Replicator", "AWS Global Tables", "Replicates data across multiple AWS regions.")
    Component("TTL_Background_Cleaner", "TTL Background Cleaner", "AWS Background Process", "Automatically removes expired items based on Time-To-Live settings.")
    Component("Request_Authenticator_AWS_IAM", "Request Authenticator (AWS IAM)", "AWS IAM", "Authenticates and authorizes incoming requests using AWS IAM.")
    Component("Partition_Metadata_Catalog", "Partition Metadata Catalog", "Internal Metadata Store", "Tracks partition locations and metadata for data routing.")
}

Rel("Storage_Nodes_RocksDB", "Streams_Processor", "Triggers change data capture events", "Internal RPC")

@enduml