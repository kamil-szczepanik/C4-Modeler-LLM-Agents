@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Privacy & User Service container

Container_Ext(Amazon_API_Gateway, "Amazon API Gateway", "AWS", "Edge and API gateway service routing traffic to internal services.")
Container_Ext(Amazon_RDS_PostgreSQL, "Amazon RDS (PostgreSQL)", "PostgreSQL", "Relational database for transactional user records.")
Container_Ext(AWS_KMS, "AWS KMS", "AWS KMS", "Key management service for field-level encryption.")
Container_Ext(Amazon_EventBridge_SQS, "Amazon EventBridge & SQS", "AWS", "Messaging and integration infrastructure.")
Container_Ext(Amazon_S3, "Amazon S3", "Amazon S3", "Object storage for compliance documentation and files.")
Container_Ext(Amazon_DynamoDB, "Amazon DynamoDB", "DynamoDB", "NoSQL store for immutable audit logs and consent trails.")
Container_Ext(Amazon_ElastiCache_Redis, "Amazon ElastiCache (Redis)", "Redis", "In-memory cache for profile reads.")

Container_Boundary(Data_Privacy_User_Service, "Data Privacy & User Service") {
    Component(UserController, "UserController", "Python / FastAPI", "Handles incoming API requests related to user management and data privacy.")
    Component(GDPRComplianceEngine, "GDPRComplianceEngine", "Python / FastAPI", "Manages GDPR and CCPA compliance workflows and data rights.")
    Component(UserRepository, "UserRepository", "Python / FastAPI", "Handles data persistence and retrieval for user records.")
    Component(ConsentManager, "ConsentManager", "Python / FastAPI", "Tracks and manages user consent preferences.")
    Component(DataEncryptionService, "DataEncryptionService", "Python / FastAPI", "Provides field-level encryption for PII compliance.")
    Component(AuditLogger, "AuditLogger", "Python / FastAPI", "Logs compliance and system audit trails.")
    Component(AuthTokenVerifier, "AuthTokenVerifier", "Python / FastAPI", "Verifies authentication tokens for secure access.")
    Component(DataRetentionEnforcer, "DataRetentionEnforcer", "Python / FastAPI", "Enforces data retention policies and automated deletion.")
    Component(UserProfileCacheManager, "UserProfileCacheManager", "Python / FastAPI", "Manages caching for high-performance non-sensitive profile reads.")
}

Rel(Amazon_API_Gateway, UserController, "gRPC / HTTPS over TLS")
Rel(UserController, AuthTokenVerifier, "In-process")
Rel(UserRepository, Amazon_RDS_PostgreSQL, "SQL / TCP")
Rel(UserRepository, AWS_KMS, "AWS SDK / HTTPS")
Rel(GDPRComplianceEngine, Amazon_EventBridge_SQS, "AMQP")
Rel(GDPRComplianceEngine, Amazon_S3, "HTTPS")
Rel(AuditLogger, Amazon_DynamoDB, "AWS SDK / HTTPS")
Rel(UserProfileCacheManager, Amazon_ElastiCache_Redis, "RESP / TCP")

@enduml