@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Admin & Content Management Service container

Container_Ext(api_gateway, "Amazon API Gateway", "API Gateway", "Routes incoming API requests.")
System_Ext(rds, "Amazon RDS (PostgreSQL)", "Relational Database", "Stores relational data.")
System_Ext(opensearch, "Amazon OpenSearch", "Search Engine", "Provides search and indexing capabilities.")
System_Ext(eventbridge, "Amazon EventBridge", "Event Bus", "Publishes and routes events.")
System_Ext(s3, "Amazon S3", "Object Storage", "Stores static assets and data exports.")
System_Ext(redis, "Amazon ElastiCache (Redis)", "Cache", "Provides low-latency caching.")

Container_Boundary(admin_service, "Admin & Content Management Service") {
    Component(catalog_admin, "Catalog Administration Component", ".NET Core", "Manages inventory data and triggers index re-syncs.")
    Component(content_moderation, "Content Moderation Component", ".NET Core", "Publishes moderation outcomes.")
    Component(iam_rbac, "IAM & RBAC Component", ".NET Core", "Authenticates administrative tokens.")
    Component(data_privacy, "Data Privacy & Compliance Component", ".NET Core", "Executes data export/erasure for GDPR/CCPA compliance.")
    Component(shipping_tax, "Shipping & Tax Configuration Component", ".NET Core", "Caches tax and shipping rules.")
    Component(cms_asset, "CMS & Asset Management Component", ".NET Core", "Uploads static media assets.")
}

Rel(api_gateway, iam_rbac, "Authenticates administrative tokens", "HTTPS")
Rel(catalog_admin, rds, "Manages inventory data", "ADO.NET / TLS")
Rel(catalog_admin, opensearch, "Triggers index re-syncs", "HTTPS / REST")
Rel(content_moderation, eventbridge, "Publishes moderation outcomes", "AWS SDK / HTTPS")
Rel(data_privacy, rds, "Executes data export/erasure", "ADO.NET / TLS")
Rel(data_privacy, s3, "Executes data export/erasure", "ADO.NET / TLS")
Rel(shipping_tax, redis, "Caches tax/shipping rules", "RESP / TCP over TLS")
Rel(cms_asset, s3, "Uploads static media assets", "AWS SDK / HTTPS over TLS")

@enduml