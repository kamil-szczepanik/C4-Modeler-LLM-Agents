@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_eventbridge_and_sqs, "Amazon EventBridge & SQS") {
    Component(Event_Bus, "Event Bus", "Amazon EventBridge", "Central JSON-based event router for domain events.")
    Component(Event_Rules_Targets, "Event Rules & Targets", "Amazon EventBridge Rules", "Filters and routes events based on patterns.")
    Component(Event_Archive_Replay, "Event Archive & Replay", "Amazon EventBridge Archive", "Stores events for retention, auditing, and lineage to maintain compliance with GDPR and CCPA.")
    Component(Order_Processing_Queue, "Order Processing Queue", "Amazon SQS Standard/FIFO", "Decouples services and buffers spike traffic.")
    Component(Dead_Letter_Queue, "Dead Letter Queue", "Amazon SQS", "Captures poisoned or failed messages to isolate failures and ensure audit compliance.")
}

Rel(Order_Checkout_Service, Event_Bus, "Publishes domain events via AWS SDK/HTTPS")
Rel(Event_Bus, Order_Processing_Queue, "Routes filtered events via EventBridge Rules")
Rel(Event_Bus, Event_Archive_Replay, "Retains events for GDPR/CCPA audit")
Rel(Async_Worker_Service, Order_Processing_Queue, "Polls via Long Polling / AWS SDK")
Rel(Order_Processing_Queue, Dead_Letter_Queue, "Redrives poisoned messages")
@enduml