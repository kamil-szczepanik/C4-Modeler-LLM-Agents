@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient & Scheduling Service container

System_Ext(api_gateway, "API Gateway / BFF", "External API Gateway routing requests")
System_Ext(kafka, "Apache Kafka", "Distributed event broker for asynchronous inter-service messaging")

Container_Boundary(patient_scheduling_service, "Patient & Scheduling Service") {
    Component(PatientController, "PatientController", "REST/gRPC (Java/Spring Boot)", "REST/gRPC endpoint handler for incoming API Gateway requests.")
    Component(SchedulingEngine, "SchedulingEngine", "Java/Spring Boot Domain Component", "Domain component executing appointment booking and resource clash checks.")
    Component(PatientRepository, "PatientRepository", "Spring Data JPA/JDBC", "Data access component using Spring Data JPA/JDBC.")
    Component(CacheManager, "CacheManager", "Redis Protocol", "Component interacting with Redis for schedule and availability caching.")
    Component(AuditLogger, "AuditLogger", "Spring AOP", "Spring AOP component generating immutable, cryptographically signed audit logs.")
    Component(KafkaEventPublisher, "KafkaEventPublisher", "Transactional Outbox Pattern", "Component using the transactional outbox pattern to emit events.")
}

Rel(api_gateway, PatientController, "Routes internal requests", "gRPC")
Rel(PatientController, AuditLogger, "Intercepts calls for auditing", "In-process / Aspect")
Rel(SchedulingEngine, AuditLogger, "Intercepts calls for auditing", "In-process / Aspect")
Rel(SchedulingEngine, PatientRepository, "Persists data", "JDBC/SQL")
Rel(SchedulingEngine, CacheManager, "Retrieves cached slots", "Redis Protocol")
Rel(KafkaEventPublisher, kafka, "Publishes domain events", "Kafka Protocol / TCP")

@enduml