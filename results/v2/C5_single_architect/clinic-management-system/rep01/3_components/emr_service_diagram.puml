@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the EMR Service container

Container_Boundary(emr_service, "EMR Service") {
    Component(emr_controller, "EMR Controller", "Spring MVC / Spring WebFlux", "Handles incoming HTTP/gRPC requests and routes them to business logic.")
    Component(clinical_record_manager, "Clinical Record Manager", "Spring Service / DDD", "Manages core clinical record business logic and domain rules.")
    Component(audit_logger_component, "Audit Logger Component", "Spring AOP / SLF4J", "Isolates compliance and audit logging without cluttering core domain logic.")
    Component(emr_data_access_repository, "EMR Data Access Repository", "Spring Data JPA / Hibernate", "Persists and retrieves records from the underlying database.")
    Component(clinical_cache_component, "Clinical Cache Component", "Spring Cache / Redis Client", "Checks and updates cached data to deliver fast EMR screen loads.")
}

Rel(emr_controller, clinical_record_manager, "Invokes business logic", "Java Method Calls")
Rel(clinical_record_manager, audit_logger_component, "Dispatches audit events", "Internal Event")
Rel(clinical_record_manager, emr_data_access_repository, "Persists records", "JDBC / SQL via TLS")
Rel(clinical_record_manager, clinical_cache_component, "Checks/updates cache", "Lettuce / In-memory")

@enduml