@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(apache_kafka, "Apache Kafka") {
    Component(Kafka Broker, "Kafka Broker", "Apache Kafka", "Provides the core event-driven messaging backbone for publishing and consuming domain events over TCP using mutual TLS (mTLS).")
    Component(KRaft Controller Quorum, "KRaft Controller Quorum", "KRaft", "Manages metadata and consensus for the Kafka cluster, eliminating ZooKeeper overhead for low latency and high availability.")
    Component(Kafka Connect, "Kafka Connect", "Kafka Connect", "Handles integration and data streaming between Kafka and external data stores or systems.")
    Component(Schema Registry, "Schema Registry", "Confluent Schema Registry", "Validates event schemas on produce via HTTP/REST over TLS.")
    Component(Kafka Tiered Storage, "Kafka Tiered Storage", "Apache Kafka Tiered Storage", "Archives historical segments to S3-compatible object storage using S3 API over TLS to support long-term data retention.")
}

Rel(Kafka Broker, Schema Registry, "Validates event schemas on produce via HTTP/REST over TLS.")
Rel(Kafka Broker, Kafka Tiered Storage, "Archives historical segments to object storage using S3 API over TLS.")

@enduml