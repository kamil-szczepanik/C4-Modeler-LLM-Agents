@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(billing_and_claims_service, "Billing & Claims Service") {
    Component(Claims_Processor_Component, "Claims Processor Component", ".NET Core / C#", "Managing adjudication and clearinghouse formatting.")
    Component(Payment_Integration_Component, "Payment Integration Component", ".NET Core / C#", "Handling secure tokenization and payment processing.")
    Component(Billing_API_Facade_Component, "Billing API Facade Component", "ASP.NET Web API", "Exposing endpoints and handling event publication.")
    Component(Financial_Audit_ & _Archive_Component, "Financial Audit & Archive Component", ".NET Core / C#", "Managing immutable, encrypted audit logs.")
}

System_Ext(Apache_Kafka, "Apache Kafka", "Distributed event streaming platform")
System_Ext(PostgreSQL, "PostgreSQL", "Relational database")
System_Ext(Payment_Gateway, "Payment Gateway", "External payment processing service")

Rel(Billing_API_Facade_Component, Apache_Kafka, "Publishes domain events like ClaimSubmitted", "TLS / Kafka Protocol")
Rel(Claims_Processor_Component, PostgreSQL, "Reads and writes transactional ledger data", "TCP/SQL")
Rel(Payment_Integration_Component, Payment_Gateway, "Processes secure financial transactions", "HTTPS / REST")
Rel(Financial_Audit_ & _Archive_Component, Apache_Kafka, "Consumes domain events for audit logging", "TLS")

@enduml