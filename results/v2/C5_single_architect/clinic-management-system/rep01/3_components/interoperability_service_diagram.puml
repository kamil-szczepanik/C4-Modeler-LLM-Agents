@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Interoperability Service container

Container_Boundary(interoperability_service, "Interoperability Service") {
    Component(Kafka_Event_Consumer_Component, "Kafka Event Consumer Component", "Apache Camel kafka module", "Consumes and routes domain events from the messaging backbone.")
    Component(Data_Transformer_Component, "Data Transformer Component", "Camel-fhir and Jackson", "Transforms domain events into standardized HL7 FHIR payloads.")
    Component(FHIR_Outbound_Connector_Component, "FHIR Outbound Connector Component", "HTTPS/REST client with mTLS", "Pushes HL7 FHIR payloads to external medical systems.")
    Component(Dead_Letter_Channel_Component, "Dead Letter Channel Component", "Retry routing queue", "Handles failed message routing and retry mechanisms.")
    Component(Audit_Logger_Component, "Audit Logger Component", "Asynchronous compliance logger", "Sends and records audit event payloads for compliance.")
    Component(Circuit_Breaker_Component, "Circuit Breaker Component", "Resilience4j wrapper", "Guards outbound calls to prevent cascading failures.")
}

System_Ext(Lab_and_Imaging_Systems, "Lab & Imaging Systems", "HTTPS/REST + mTLS & OAuth2", "External medical systems receiving standardized HL7 FHIR payloads.")

Rel(Kafka_Event_Consumer_Component, Data_Transformer_Component, "Consumes and routes domain events", "Direct Protocol")
Rel(Data_Transformer_Component, Audit_Logger_Component, "Sends audit event payload", "Direct Protocol")
Rel(Data_Transformer_Component, FHIR_Outbound_Connector_Component, "Enriched FHIR payload", "Direct Protocol")
Rel(FHIR_Outbound_Connector_Component, Circuit_Breaker_Component, "Guards outbound calls", "Resilience4j / Direct Protocol")
Rel(FHIR_Outbound_Connector_Component, Lab_and_Imaging_Systems, "Pushes HL7 FHIR payloads", "HTTPS/REST + mTLS & OAuth2")

@enduml