@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(postgresql, "PostgreSQL") {
    Component(PgBouncer, "PgBouncer", "PgBouncer", "Connection pooler for handling microservice traffic spikes and sustaining sub-second P95 EMR load performance.")
    Component(PostgreSQL_Container, "PostgreSQL Container", "PostgreSQL", "Primary relational data store providing robust ACID compliance and data integrity.")
    Component(Patroni_etcd, "Patroni & etcd", "Patroni / etcd", "Replication manager for automated failover, health checks, and guaranteeing 99.99% high availability.")
    Component(Barman, "Barman", "Barman", "Backup manager for point-in-time recovery, encrypted archival backups, and satisfying 10+ year data retention.")
    Component(Security_Modules, "Security Modules", "pgcrypto & pgaudit", "Provides AES-256 encryption at rest and comprehensive HIPAA/GDPR audit logging trails.")
}

Rel(PgBouncer, PostgreSQL_Container, "Routed database queries", "TCP/SQL")
Rel(PostgreSQL_Container, Patroni_etcd, "Health checks and replication state", "TCP")
Rel(PostgreSQL_Container, Barman, "Encrypted archival backups", "TCP/SSH")
@enduml