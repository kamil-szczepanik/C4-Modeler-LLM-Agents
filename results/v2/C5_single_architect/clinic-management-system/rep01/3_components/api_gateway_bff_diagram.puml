@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway / BFF container

Container_Boundary(api_gateway_bff, "API Gateway / BFF") {
    Component(Ingress_Router, "Ingress Router", "Kong", "Accesses portal and workflows via HTTPS/JSON with MFA.")
    Component(Auth_Enforcement_Filter, "Auth Enforcement Filter", "Plugin Hook", "Validates tokens and enforces security.")
    Component(Patient_BFF, "Patient BFF", "Node.js / Express", "Handles persona-specific orchestration for patients.")
    Component(Staff_BFF, "Staff BFF", "Node.js / Express", "Handles persona-specific orchestration for medical staff.")
    Component(Audit_Compliance_Interceptor, "Audit & Compliance Interceptor", "Interceptor Service", "Intercepts requests to publish audit logs for HIPAA and GDPR compliance.")
}

Rel(Ingress_Router, Auth_Enforcement_Filter, "Validates tokens", "Plugin Hook")
Rel(Auth_Enforcement_Filter, Patient_BFF, "Forwards session context", "HTTP/JSON")
Rel(Auth_Enforcement_Filter, Staff_BFF, "Forwards session context", "HTTP/JSON")
Rel(Patient_BFF, Audit_Compliance_Interceptor, "Intercepts requests", "Async Event / Function Hook")
Rel(Staff_BFF, Audit_Compliance_Interceptor, "Intercepts requests", "Async Event / Function Hook")

@enduml