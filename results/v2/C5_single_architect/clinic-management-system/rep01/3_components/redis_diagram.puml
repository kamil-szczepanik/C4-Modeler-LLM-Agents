@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(Redis, "Redis") {
    Component(Redis Master-Replica Cluster, "Redis Master-Replica Cluster", "Redis", "Provides high availability and sub-second caching performance for scheduling, session data, and patient lookup data.")
    Component(Redis Sentinel, "Redis Sentinel", "Redis Sentinel", "Monitors the Redis instances and manages automatic failover to ensure high availability.")
    Component(Redis ACL Manager, "Redis ACL Manager", "Redis ACL", "Enforces role-based access control and tenant isolation.")
}

Rel(Redis Master-Replica Cluster, Redis Sentinel, "Monitored and managed for high availability")
Rel(Redis ACL Manager, Redis Master-Replica Cluster, "Enforces access control and tenant isolation")
@enduml