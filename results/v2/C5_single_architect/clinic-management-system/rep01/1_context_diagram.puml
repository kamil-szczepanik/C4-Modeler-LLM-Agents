@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Clinic Management System

Person(Patients, "Patients", "End-users accessing the Web/Mobile Portal for registration and appointments.")
Person(MedicalStaff, "Medical Staff", "Doctors, nurses, and receptionists managing EMRs, scheduling, and billing.")

System(ClinicManagementSystem, "Clinic Management System", "A hybrid clinical IT platform that manages patient admissions, EMRs, scheduling, and billing, ensuring HIPAA/GDPR compliance, 99.99% uptime, and interoperability for medium-sized hospitals and clinics.")

System_Ext(ExternalIdP, "External IdP", "Azure AD / Okta handling Multi-Factor Authentication.")
System_Ext(PaymentGateway, "Payment Gateway", "External service processing patient billing and credit cards.")
System_Ext(LabImagingSystems, "Lab & Imaging Systems", "Third-party medical systems communicating via HL7 FHIR APIs.")
System_Ext(NotificationService, "Notification Service", "Twilio/SendGrid gateway for SMS/Email reminders.")

Rel(Patients, ClinicManagementSystem, "Interact with via Web/Mobile UI", "HTTPS/REST")
Rel(MedicalStaff, ClinicManagementSystem, "Manage clinical and billing workflows", "HTTPS/REST")
Rel(ClinicManagementSystem, ExternalIdP, "Authenticates users", "OIDC/SAML 2.0")
Rel(ClinicManagementSystem, PaymentGateway, "Processes payments", "HTTPS/REST")
Rel(ClinicManagementSystem, LabImagingSystems, "Exchanges clinical data", "HL7 FHIR REST APIs")
Rel(ClinicManagementSystem, NotificationService, "Dispatches alerts and reminders", "HTTPS/REST")

@enduml