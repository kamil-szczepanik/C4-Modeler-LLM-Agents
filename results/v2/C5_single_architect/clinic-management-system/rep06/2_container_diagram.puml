@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Patient_User, "Patient / User", "Internal actor accessing the portal and managing personal medical and billing details.")
Person(Clinician_Staff, "Clinician / Staff", "Internal actor accessing EMRs, scheduling, and clinical workflows via the system.")
Person(Hospital_Administrator, "Hospital Administrator", "Internal actor managing administrative tasks, billing, and system operations.")

System_Ext(External_Lab_Imaging_Systems, "External Lab & Imaging Systems", "External systems providing diagnostic results and imaging data to the CMS.")
System_Ext(Insurance_Payment_Gateways, "Insurance Payment Gateways", "Third-party financial processors handling insurance claims and payments.")
System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "External system enforcing multi-factor authentication and user identity management.")
System_Ext(SMS_Notification_Gateway, "SMS / Notification Gateway", "External service delivering alerts, notifications, and MFA codes.")
System_Ext(Regulatory_Compliance_Auditing_Authority, "Regulatory Compliance / Auditing Authority", "External entity receiving statutory reports and auditing data.")

System_Boundary(Clinic_Management_System, "Clinic Management System") {
    Container(API_Gateway, "API Gateway", "NGINX / Envoy", "Handling TLS termination, rate limiting, and JWT validation.")
    Container(Web_Application, "Web Application", "React / TypeScript", "Single Page Application served via NGINX for user interfaces.")
    Container(Core_Clinic_Service, "Core Clinic Service", "Java / Spring Boot", "Managing patient registration and EMR audit trails.")
    Container(Scheduling_Service, "Scheduling Service", "Go", "Handling appointment scheduling and resource clash checks.")
    Container(Billing_Service, "Billing Service", "Node.js", "Managing billing and insurance claim submissions.")
    Container(Integration_Service, "Integration Service", "Apache Camel / Spring Integration", "Handling HL7 FHIR translations.")
    Container(Event_Broker, "Event Broker", "Apache Kafka / RabbitMQ", "For asynchronous domain events.")
    ContainerDb(PostgreSQL_Database, "PostgreSQL Database", "PostgreSQL with AES-256", "Transactional data store with AES-256 encryption at rest.")
    ContainerDb(Redis_Cache, "Redis Cache", "Redis", "Used for scheduling locks and high-speed caching.")
}

Rel(Patient_User, Web_Application, "Accesses portal and medical details", "HTTPS")
Rel(Clinician_Staff, Web_Application, "Accesses EMRs and clinical workflows", "HTTPS")
Rel(Hospital_Administrator, Web_Application, "Accesses administrative and billing functions", "HTTPS")
Rel(Web_Application, API_Gateway, "Sends web traffic and API requests", "HTTPS / WSS")
Rel(API_Gateway, Core_Clinic_Service, "Routes requests", "gRPC over mTLS")
Rel(API_Gateway, Scheduling_Service, "Routes requests", "gRPC over mTLS")
Rel(API_Gateway, Billing_Service, "Routes requests", "gRPC over mTLS")
Rel(API_Gateway, Integration_Service, "Routes requests", "gRPC over mTLS")
Rel(Core_Clinic_Service, Event_Broker, "Publishes asynchronous domain events", "AMQP / Kafka protocol")
Rel(Billing_Service, Event_Broker, "Publishes asynchronous domain events", "AMQP / Kafka protocol")
Rel(Integration_Service, External_Lab_Imaging_Systems, "Exchanges medical data and diagnostics", "HL7 FHIR over HTTPS")
Rel(Billing_Service, Insurance_Payment_Gateways, "Submits insurance claims", "HTTPS")
Rel(Core_Clinic_Service, PostgreSQL_Database, "Reads and writes transactional data", "JDBC / SQL")
Rel(Scheduling_Service, Redis_Cache, "Manages scheduling locks", "Redis Protocol")
Rel(Billing_Service, PostgreSQL_Database, "Reads and writes billing data", "SQL")

@enduml