@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(PatientUser, "Patient / User", "Internal actor accessing the portal and managing personal medical and billing details.")
Person(ClinicianStaff, "Clinician / Staff", "Internal actor accessing EMRs, scheduling, and clinical workflows via the system.")
Person(HospitalAdministrator, "Hospital Administrator", "Internal actor managing administrative tasks, billing, and system operations.")

System(ClinicManagementSystem, "Clinic Management System", "A distributed clinical IT platform managing patient admissions, EMRs, scheduling, and billing while ensuring HIPAA/GDPR compliance, 99.99% uptime, and interoperability across hybrid cloud environments.")

System_Ext(ExternalLabImagingSystems, "External Lab & Imaging Systems", "External systems providing diagnostic results and imaging data to the CMS.")
System_Ext(InsurancePaymentGateways, "Insurance Payment Gateways", "Third-party financial processors handling insurance claims and payments.")
System_Ext(IdentityProviderIdP, "Identity Provider (IdP)", "External system enforcing multi-factor authentication and user identity management.")
System_Ext(SMSNotificationGateway, "SMS / Notification Gateway", "External service delivering alerts, notifications, and MFA codes.")
System_Ext(RegulatoryComplianceAuditingAuthority, "Regulatory Compliance / Auditing Authority", "External entity receiving statutory reports and auditing data.")

Rel(PatientUser, ClinicManagementSystem, "Accesses portal, EMR, and billing", "HTTPS (TLS 1.3)")
Rel(ClinicianStaff, ClinicManagementSystem, "Accesses portal, EMR, and clinical workflows", "HTTPS (TLS 1.3)")
Rel(HospitalAdministrator, ClinicManagementSystem, "Accesses administrative and billing functions", "HTTPS (TLS 1.3)")
Rel(ClinicManagementSystem, ExternalLabImagingSystems, "Exchanges medical data and diagnostics", "HL7 FHIR (REST/JSON over mTLS)")
Rel(ClinicManagementSystem, InsurancePaymentGateways, "Submits insurance claims", "HTTPS/REST")
Rel(ClinicManagementSystem, IdentityProviderIdP, "Authenticates users and enforces MFA", "OIDC/SAML 2.0")
Rel(ClinicManagementSystem, SMSNotificationGateway, "Sends alerts and notifications", "SMPP / HTTPS REST")
Rel(ClinicManagementSystem, RegulatoryComplianceAuditingAuthority, "Performs secure batch export for compliance", "SFTP/HTTPS")

@enduml