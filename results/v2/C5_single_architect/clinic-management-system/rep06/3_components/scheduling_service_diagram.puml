@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Scheduling Service container

System_Ext(api_gateway, "API Gateway", "External API Gateway routing client requests.")
System_Ext(redis_cache, "Redis Cache", "External cache managing distributed scheduling locks.", "Redis")
System_Ext(postgresql_database, "PostgreSQL Database", "Persistent storage with AES-256 encryption.", "PostgreSQL")
System_Ext(apache_kafka, "Apache Kafka", "Event broker for domain events.", "Apache Kafka")
System_Ext(sms_notification_gateway, "SMS / Notification Gateway", "External service for patient reminders.", "HTTPS/REST")

Container_Boundary(scheduling_service, "Scheduling Service") {
    Component(appointment_api_handler, "Appointment API Handler", "Go", "Receives gRPC requests from the API Gateway.")
    Component(conflict_detection_engine, "Conflict Detection Engine", "Go", "Business logic component for resource clash checks.")
    Component(calendar_storage_repository, "Calendar Storage Repository", "Go", "Database interface managing persistence.")
    Component(notification_dispatcher, "Notification Dispatcher", "Go", "Handles asynchronous event consumption.")
}

Rel(api_gateway, appointment_api_handler, "Routes requests via gRPC over mTLS.")
Rel(appointment_api_handler, conflict_detection_engine, "Invokes business rules via direct function calls.")
Rel(conflict_detection_engine, redis_cache, "Acquires distributed locks via Redis Protocol over TLS.")
Rel(conflict_detection_engine, postgresql_database, "Persists confirmed appointments via PostgreSQL wire protocol using TLS and AES-256.")
Rel(conflict_detection_engine, apache_kafka, "Publishes AppointmentScheduled events via Kafka Protocol over TLS.")
Rel(notification_dispatcher, sms_notification_gateway, "Sends appointment reminders via HTTPS/REST.")

@enduml