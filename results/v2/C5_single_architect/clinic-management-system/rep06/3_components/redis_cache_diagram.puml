@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(redis_cache, "Redis Cache") {
    Component(Redis Master Node, "Redis Master Node", "Redis v7.x", "Handles write operations, caching frequent EMR queries, and distributed appointment locks using Redlock.")
    Component(Redis Replica Nodes, "Redis Replica Nodes", "Redis v7.x", "Handles read scaling and high availability replication from the master node.")
    Component(Distributed Lock Manager, "Distributed Lock Manager", "Redlock", "Manages distributed locks for scheduling concurrency.")
}

Rel(Redis Master Node, Redis Replica Nodes, "Handles high availability replication", "RESP / TCP")
Rel(Distributed Lock Manager, Redis Master Node, "Acquires distributed locks", "RESP / TLS over TCP")
@enduml