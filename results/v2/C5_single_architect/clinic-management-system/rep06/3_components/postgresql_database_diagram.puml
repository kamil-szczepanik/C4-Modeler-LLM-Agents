@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Core_Clinic_Service, "Core Clinic Service", "Java / Spring Boot")
System_Ext(Billing_Service, "Billing Service", "Node.js")

Container_Boundary(PostgreSQL_Database, "PostgreSQL Database") {
    Component(Connection_Pooler, "Connection Pooler", "PgBouncer", "Connection pooler to prevent connection exhaustion from multiple microservices.")
    Component(Relational_Engine, "Relational Engine", "PostgreSQL v15+", "Core relational database engine for robust transactional data management.")
    Component(Replication_HA_Manager, "Replication & HA Manager", "Patroni / etcd", "Replication and high availability manager for automated failover and 99.99% uptime.")
    Component(Encryption_Audit_Extension, "Encryption & Audit Extension", "pgcrypto & pgaudit", "Database extensions for AES-256 encryption at rest and compliance audit logging.")
}

Rel(Core_Clinic_Service, Connection_Pooler, "Queries data", "TCP / SQL over TLS 1.3")
Rel(Billing_Service, Connection_Pooler, "Queries data", "TCP / SQL over TLS 1.3")
Rel(Connection_Pooler, Relational_Engine, "Forwards validated client queries", "TCP / Local Socket")
Rel(Relational_Engine, Replication_HA_Manager, "Synchronizes transaction logs", "TCP")
Rel(Replication_HA_Manager, Relational_Engine, "Synchronizes transaction logs", "TCP")
Rel(Relational_Engine, Encryption_Audit_Extension, "Writes audit trails and applies AES-256 encryption", "Internal SPI")

@enduml