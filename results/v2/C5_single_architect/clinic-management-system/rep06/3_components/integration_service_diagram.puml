@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Service container

Container_Boundary(integration_service, "Integration Service") {
    Component(API_Gateway, "API Gateway", "NGINX / Envoy", "Routes incoming requests.")
    Component(Integration_Service, "Integration Service", "Apache Camel / Spring Integration", "Handles HL7 FHIR translations and powers routing and integration patterns.")
    Component(FHIR_Router_Validator_Component, "FHIR Router & Validator Component", "Java / Spring", "Validates payloads against US Core FHIR profiles.")
    Component(HL7_v2_v3_Translation_Engine_Component, "HL7 v2/v3 Translation Engine Component", "HAPI FHIR / HAPI HL7", "Converts domain events to legacy HL7 messages.")
    Component(Outbound_Dispatcher_Component, "Outbound Dispatcher Component", "Resilience4j", "Manages retries and circuit breaking.")
    Component(Integration_Audit_DLQ_Component, "Integration Audit & DLQ Component", "Java / Spring", "Captures failed payloads for compliance auditing and reconciliation.")
    ComponentDb(PostgreSQL_Database, "PostgreSQL Database", "PostgreSQL with AES-256 encryption", "Stores transactional and audit data.")
}

System_Ext(External_Lab_Imaging_Systems, "External Lab & Imaging Systems", "External diagnostic and imaging systems.")

Rel(API_Gateway, Integration_Service, "Routes requests", "gRPC over mTLS")
Rel(FHIR_Router_Validator_Component, HL7_v2_v3_Translation_Engine_Component, "Transforms message formats", "in-memory")
Rel(Outbound_Dispatcher_Component, External_Lab_Imaging_Systems, "Transmits diagnostics", "HL7 FHIR / v2 over HTTPS/TLS 1.3")
Rel(Outbound_Dispatcher_Component, Integration_Audit_DLQ_Component, "Forwards failed delivery payloads", "asynchronous messaging")
Rel(Integration_Audit_DLQ_Component, PostgreSQL_Database, "Stores failed transaction logs", "JDBC over TLS 1.3")

@enduml