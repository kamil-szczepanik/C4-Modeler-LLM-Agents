@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Event Broker container

Container_Boundary(event_broker, "Event Broker") {
    Component(ingestion_routing_engine, "Ingestion & Routing Engine", "Apache Kafka Brokers", "Handles ingestion and routing of asynchronous domain events.")
    Component(schema_registry, "Schema Registry", "Confluent Schema Registry / Apicurio", "Validates event payloads.")
    Component(audit_log_interceptor, "Audit Log Interceptor", "Custom Kafka Streams / Log Compaction", "Intercepts events to maintain immutable audit trails.")
    Component(replication_mirroring_agent, "Replication & Mirroring Agent", "Apache Kafka MirrorMaker 2 / Confluent Cluster Linking", "Streams cross-site replication data.")
}

System_Ext(core_clinic_service, "Core Clinic Service", "Core Clinic Service")
System_Ext(billing_service, "Billing Service", "Billing Service")
System_Ext(integration_service, "Integration Service", "Integration Service")
System_Ext(postgresql_database, "PostgreSQL Database", "PostgreSQL Database")

Rel(core_clinic_service, ingestion_routing_engine, "Publishes asynchronous domain events", "TCP / Kafka Protocol")
Rel(billing_service, ingestion_routing_engine, "Publishes asynchronous domain events", "AMQP / Kafka protocol")
Rel(ingestion_routing_engine, schema_registry, "Validates event payloads", "HTTP/REST")
Rel(integration_service, ingestion_routing_engine, "Consumes clinical events for HL7 FHIR export", "Kafka Protocol")
Rel(ingestion_routing_engine, replication_mirroring_agent, "Streams cross-site replication data", "TCP / Kafka Protocol")
Rel(audit_log_interceptor, postgresql_database, "Persists immutable event audit trails", "JDBC / TLS")

@enduml