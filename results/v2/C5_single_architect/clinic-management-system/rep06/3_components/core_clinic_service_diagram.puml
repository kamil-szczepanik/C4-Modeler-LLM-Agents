@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Clinic Service container

Container_Boundary(core_clinic_service, "Core Clinic Service") {
    Component(PatientController, "PatientController", "Spring MVC", "Handles patient-related HTTP requests and routing within the Core Clinic Service.")
    Component(ClinicalRecordManager, "ClinicalRecordManager", "Spring Service", "Manages business logic for clinical records and coordinates encryption and data access.")
    Component(DataAccessor, "DataAccessor", "Spring Data JPA / Hibernate", "Handles data persistence and retrieval operations for the PostgreSQL Database.")
    Component(EncryptionEngine, "EncryptionEngine", "Spring Component", "Encrypts and decrypts PHI payloads using cryptographic controls.")
}

System_Ext(Event_Broker, "Event Broker", "Apache Kafka / RabbitMQ")

Rel(PatientController, ClinicalRecordManager, "Method calls", "In-process")
Rel(ClinicalRecordManager, EncryptionEngine, "Encrypts/decrypts PHI payloads", "In-process")
Rel(ClinicalRecordManager, DataAccessor, "Transactions", "JDBC over TLS")
Rel(ClinicalRecordManager, Event_Broker, "Publishes EMRUpdatedEvent", "Kafka Producer, AMQP")

@enduml