@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(InsurancePaymentGateways, "Insurance Payment Gateways", "External REST API", "Third-party payment gateways for processing claims.")

Container_Boundary(BillingService, "Billing Service") {
    Component(BillingAPIController, "Billing API Controller", "Express.js", "Processes clinical billing operations and insurance claim submissions.")
    Component(ClaimProcessingEngine, "Claim Processing Engine", "Node.js", "Handles core business logic for claim processing and coordination.")
    Component(GatewayIntegrationClient, "Gateway Integration Client", "Node.js with Opossum Circuit Breaker", "Manages communication with external insurance payment gateways.")
    Component(IdempotencyManager, "Idempotency Manager", "Node.js", "Verifies transactions and ensures idempotency for requests.")
    Component(BillingDataRepository, "Billing Data Repository", "TypeORM", "Handles data persistence supporting AES-256 data encryption at rest.")
    Component(RedisCache, "Redis Cache", "Redis", "In-memory store for session caching, rate limiting, and idempotency checks.")
    Component(PostgreSQLDatabase, "PostgreSQL Database", "PostgreSQL", "Relational database for storing billing and clinical data.")
}

Rel(BillingAPIController, ClaimProcessingEngine, "In-process direct function calls")
Rel(ClaimProcessingEngine, IdempotencyManager, "In-process transaction verification")
Rel(ClaimProcessingEngine, GatewayIntegrationClient, "In-process direct function calls")
Rel(ClaimProcessingEngine, BillingDataRepository, "TCP/Postgres Driver over TLS")
Rel(BillingDataRepository, PostgreSQLDatabase, "Persists data")
Rel(GatewayIntegrationClient, InsurancePaymentGateways, "HTTPS / JSON")
Rel(GatewayIntegrationClient, RedisCache, "RESP over TLS")

@enduml