@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Listener___TLS_Termination, "Listener & TLS Termination", "Envoy", "Handles incoming network traffic and terminates TLS connections.")
    Component(Auth___Authz_Filter, "Auth & Authz Filter", "Envoy Filter", "Validates authentication and authorization for incoming requests.")
    Component(Rate_Limiting___Throttling_Component, "Rate Limiting & Throttling Component", "Envoy Rate Limit", "Controls traffic flow and prevents abuse through rate limiting and throttling.")
    Component(Routing___Load_Balancing_Component, "Routing & Load Balancing Component", "Envoy Router", "Routes requests to appropriate downstream services and balances load.")
    Component(Audit_Logging___Telemetry_Filter, "Audit Logging & Telemetry Filter", "Envoy Telemetry", "Captures audit logs and telemetry data for monitoring and compliance.")
}

Rel(Listener___TLS_Termination, Auth___Authz_Filter, "Passes decrypted traffic")
Rel(Auth___Authz_Filter, Rate_Limiting___Throttling_Component, "Forwards authenticated requests")
Rel(Rate_Limiting___Throttling_Component, Routing___Load_Balancing_Component, "Passes cleared requests")
Rel(Routing___Load_Balancing_Component, Audit_Logging___Telemetry_Filter, "Triggers logging and metrics collection")

@enduml