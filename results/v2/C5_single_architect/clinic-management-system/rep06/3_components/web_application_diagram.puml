@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application container

System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "OAuth2 / OIDC, MFA")
System_Ext(API_Gateway, "API Gateway", "NGINX / Envoy")

Container_Boundary(Web_Application, "Web Application") {
    Component(Routing_Shell_Component, "Routing & Shell Component", "React / TypeScript", "Handles navigation and overall application layout.")
    Component(Authentication_Session_Manager, "Authentication & Session Manager", "OAuth2 / OIDC, MFA", "Authenticates users via Identity Provider (IdP).")
    Component(Clinical_Workflows_Module, "Clinical Workflows Module", "React / TypeScript", "Manages patient admissions, EMRs, and clinical functions.")
    Component(API_Client_Layer, "API Client Layer", "Axios / Fetch", "Handles secure API communication with enforced headers.")
    Component(Real_Time_Notification_Client, "Real-Time Notification Client", "WSS", "Connects for instant updates via WebSocket.")
    Component(State_Management_Store, "State Management Store", "Zustand / Redux Toolkit", "Manages in-memory state safely without triggering excessive re-renders.")
}

Rel(Authentication_Session_Manager, Identity_Provider_IdP, "Authenticates users via", "OAuth2 / OIDC, MFA")
Rel(Real_Time_Notification_Client, API_Gateway, "Connects for instant updates via", "WSS")

@enduml