@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing & Insurance Integration Worker container

System_Ext(Async_Message_Broker, "Async Message Broker", "Async message broker for handling events.")
System_Ext(Payment_Gateway_Insurance_Clearinghouse, "Payment Gateway / Insurance Clearinghouse", "External payment gateway or insurance clearinghouse.")

Container_Boundary(Billing_Insurance_Integration_Worker, "Billing & Insurance Integration Worker") {
    Component(Claim_Consumer_Component, "Claim Consumer Component", "Node.js with KafkaJS", "Consumes claims events from the async message broker.")
    Component(Claim_Transformation_Component, "Claim Transformation Component", "TypeScript", "Transforms raw payload into formatted claims.")
    Component(Clearinghouse_Adapter_Component, "Clearinghouse Adapter Component", "Axios with Opossum circuit breaker", "Submits encrypted claims to the payment gateway or insurance clearinghouse.")
    Component(Audit_Reconciliation_Logger_Component, "Audit & Reconciliation Logger Component", "Node.js / SQL with TLS", "Emits audit logs from integration operations.")
}

Rel(Claim_Consumer_Component, Claim_Transformation_Component, "Passes raw payload", "In-memory")
Rel(Claim_Transformation_Component, Clearinghouse_Adapter_Component, "Passes formatted claim", "HTTPS")
Rel(Clearinghouse_Adapter_Component, Payment_Gateway_Insurance_Clearinghouse, "Submits encrypted claims", "HTTPS / REST, TLS 1.3")
Rel(Claim_Consumer_Component, Audit_Reconciliation_Logger_Component, "Emits audit logs", "SQL / TLS")
Rel(Claim_Transformation_Component, Audit_Reconciliation_Logger_Component, "Emits audit logs", "SQL / TLS")
Rel(Clearinghouse_Adapter_Component, Audit_Reconciliation_Logger_Component, "Emits audit logs", "SQL / TLS")
Rel(Async_Message_Broker, Claim_Consumer_Component, "Consumes claims events", "AMQP / Kafka")

@enduml