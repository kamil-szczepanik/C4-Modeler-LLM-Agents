@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(PostgreSQL_Primary_DB, "PostgreSQL Primary DB") {
    Component(Relational_Storage_Engine, "Relational Storage Engine", "PostgreSQL 15+ with Citus", "Core relational storage engine with horizontal scaling capabilities.")
    Component(Connection_Pooler, "Connection Pooler", "PgBouncer", "Connection pooler for handling high-volume client traffic.")
    Component(Audit___Compliance_Logger, "Audit & Compliance Logger", "pgAudit", "Extension for comprehensive DDL/DML auditing to satisfy HIPAA/GDPR.")
    Component(Backup___Archival_Daemon, "Backup & Archival Daemon", "Barman", "Backup and recovery daemon for continuous WAL archiving.")
}

Rel(Connection_Pooler, Relational_Storage_Engine, "Pooled connections via TCP/IP.")
Rel(Relational_Storage_Engine, Backup___Archival_Daemon, "WAL streaming over TLS.")
@enduml