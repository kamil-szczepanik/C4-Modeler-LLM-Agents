@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Async Message Broker", "Async Message Broker") {
    Component("Event Ingestion & Routing Engine", "Event Ingestion & Routing Engine", "Apache Kafka", "Handles incoming domain events and routes them to appropriate topics.")
    Component("Schema Registry", "Schema Registry", "Kafka Schema Registry", "Manages and validates event schemas to ensure data consistency.")
    Component("Consumer Offset Manager", "Consumer Offset Manager", "Apache Kafka", "Tracks message consumption progress for consumers.")
    Component("Access Control & Audit Interceptor", "Access Control & Audit Interceptor", "Kafka ACLs / Java", "Persists broker audit logs and ACL metadata while enforcing security policies.")
    Component("Replication & Mirroring Agent (MirrorMaker 2)", "Replication & Mirroring Agent (MirrorMaker 2)", "Kafka MirrorMaker 2", "Handles cross-region replication and mirroring of event streams.")
}

System_Ext("PostgreSQL Primary DB", "PostgreSQL Primary DB", "Multi-region active-active with AES-256 encryption.")

Rel("Access Control & Audit Interceptor", "PostgreSQL Primary DB", "Persists broker audit logs and ACL metadata", "JDBC / TLS")

@enduml