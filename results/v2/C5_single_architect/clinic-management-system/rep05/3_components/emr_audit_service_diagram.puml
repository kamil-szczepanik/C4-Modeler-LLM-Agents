@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Emr Audit Service container

System_Ext(api_gateway, "API Gateway", "External system routing requests.")
System_Ext(postgresql_primary_db, "PostgreSQL Primary DB", "Persistent transactional storage.")
System_Ext(async_message_broker, "Async Message Broker", "Reliable event streaming.")
System_Ext(external_lab_imaging_systems, "External Lab & Imaging Systems", "External healthcare systems.")
System_Ext(worm_compliant_storage, "WORM-compliant storage", "Immutable long-term storage.")

Container_Boundary(emr_audit_service, "EMR & Audit Service") {
    Component(emr_management_controller_service, "EMR Management Controller / Service", "Java Spring Boot", "Handles clinical data and core EMR management operations.")
    Component(hl7_fhir_interoperability_adapter, "HL7 FHIR Interoperability Adapter", "HAPI FHIR library", "Exchanges test results and handles healthcare data interoperability.")
    Component(audit_trail_interceptor, "Audit Trail Interceptor", "Spring AOP", "Provides transparent, non-invasive audit logging for compliance.")
    Component(worm_storage_exporter, "WORM Storage Exporter", "Async Java worker", "Archives immutable logs asynchronously to WORM storage.")
    Component(emr_cache_layer, "EMR Cache Layer", "Redis", "In-memory distributed cache for rapid read performance.")
}

Rel(api_gateway, emr_management_controller_service, "Routes EMR requests", "Internal gRPC/REST over TLS 1.3")
Rel(emr_management_controller_service, emr_cache_layer, "Reads patient records", "Redis Protocol over TLS")
Rel(emr_management_controller_service, postgresql_primary_db, "Reads/writes clinical data", "JDBC / TLS 1.3")
Rel(audit_trail_interceptor, async_message_broker, "Publishes audit events", "Apache Kafka")
Rel(hl7_fhir_interoperability_adapter, external_lab_imaging_systems, "Exchanges test results", "HL7 FHIR APIs")
Rel(worm_storage_exporter, worm_compliant_storage, "Archives immutable logs", "HTTPS / S3 Object Lock API")

@enduml