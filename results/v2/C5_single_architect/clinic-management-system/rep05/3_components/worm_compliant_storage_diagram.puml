@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(worm_compliant_storage, "WORM-compliant storage") {
    Component(Ingestion_Validation_Engine, "Ingestion & Validation Engine", "Java / Node.js", "Ingests and validates incoming audit logs and clinical data records before WORM storage.")
    Component(Object_Lock_Manager, "Object Lock Manager", "Java Service", "Enforces 10-year retention policies and WORM compliance rules on stored objects.")
    Component(Encryption_Key_Service, "Encryption & Key Service", "PKCS#11 / AWS KMS API", "Handles AES-256 encryption and key management using Enterprise HSM and AWS KMS.")
    Component(MinIO_On_Prem, "MinIO (On-Prem)", "MinIO Object Storage", "Provides on-premise object storage with S3 API compatibility and Object Lock.")
    Component(AWS_S3_Cloud, "AWS S3 (Cloud)", "AWS S3 with Object Lock", "Provides cloud-based object storage supporting WORM compliance and high availability.")
}

Rel(Ingestion_Validation_Engine, Object_Lock_Manager, "Passes validated records for retention locking")
Rel(Object_Lock_Manager, Encryption_Key_Service, "Requests encryption for stored objects")
Rel(Object_Lock_Manager, MinIO_On_Prem, "Stores locked objects on-premise", "S3 API over TLS 1.3")
Rel(Object_Lock_Manager, AWS_S3_Cloud, "Stores locked objects in the cloud", "S3 API over TLS 1.3")
Rel(Encryption_Key_Service, MinIO_On_Prem, "Applies AES-256 encryption keys")
Rel(Encryption_Key_Service, AWS_S3_Cloud, "Applies AES-256 encryption keys")

@enduml