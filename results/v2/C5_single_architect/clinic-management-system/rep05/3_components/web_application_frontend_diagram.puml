@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application Frontend container

System_Ext(Enterprise_Identity_Provider, "Enterprise Identity Provider", "External Identity Provider system.")
System_Ext(API_Gateway, "API Gateway", "API Gateway (Kong / Nginx) for routing and rate limiting.")

Container_Boundary(Web_Application_Frontend, "Web Application Frontend") {
    Component(Auth_Session_Manager, "Authentication & Session Manager", "React / TypeScript, OAuth2/OIDC", "Manages user authentication, session state, and coordinates MFA redirect flows.")
    Component(EMR_View_Controller, "EMR View Controller", "React / TypeScript, TanStack Table", "Handles electronic medical records display and clinical data interactions.")
    Component(Scheduling_Calendar_Module, "Scheduling Calendar Module", "React / TypeScript, FullCalendar", "Provides scheduling calendar capabilities for doctors, nurses, and receptionists.")
    Component(Billing_Claims_Dashboard, "Billing & Claims Dashboard", "React / TypeScript", "Manages billing operations and claims tracking for billing specialists.")
    Component(Audit_Logging_Middleware, "Audit Logging Middleware", "React / TypeScript, HTTPS", "Captures and sends audit telemetry for user actions to the backend.")
}

Rel(Auth_Session_Manager, Enterprise_Identity_Provider, "Coordinates OAuth2/OIDC redirect flows for MFA", "HTTPS")
Rel(Web_Application_Frontend, API_Gateway, "Sends centralized REST/GraphQL requests and audit telemetry", "HTTPS")

@enduml