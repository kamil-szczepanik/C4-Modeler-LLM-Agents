@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(tls_proxy, "TLS Termination & Routing Proxy", "Kong / Nginx", "Handles incoming HTTPS traffic, performs TLS termination, and routes requests to appropriate backend services.")
    Component(auth_filter, "Authentication & Authorization Filter", "Kong / Nginx Security Filter / OAuth2/OIDC", "Validates OAuth2/OIDC tokens by communicating with the Enterprise Identity Provider.")
    Component(rate_limit, "Rate Limiting & Threat Protection Module", "Kong / Nginx Module", "Protects the system by enforcing rate limits and mitigating security threats.")
    Component(fhir_filter, "FHIR Protocol & Audit Translation Filter", "Kong / Nginx Custom Filter", "Translates and processes HL7 FHIR APIs for external interoperability and audit logging.")
}

Rel(tls_proxy, auth_filter, "Passes incoming requests for token validation", "")
Rel(auth_filter, rate_limit, "Forwards authenticated requests for traffic management", "")
Rel(rate_limit, fhir_filter, "Routes valid requests for protocol translation or internal routing", "")

@enduml