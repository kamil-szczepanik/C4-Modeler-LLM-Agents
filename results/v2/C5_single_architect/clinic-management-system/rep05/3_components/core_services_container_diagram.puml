@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Services Container container

Container(API_Gateway, "API Gateway", "Reverse Proxy / Gateway", "Routes internal and external requests to appropriate components.")
ContainerDb(PostgreSQL_Primary_DB, "PostgreSQL Primary DB", "PostgreSQL", "Stores primary relational data securely.")
Container(Async_Message_Broker, "Async Message Broker", "Apache Kafka", "Handles reliable asynchronous event-driven messaging.")
Container_Ext(EMR_Audit_Service, "EMR & Audit Service", "External Service", "Receives audit trails and clinical records.")

Container_Boundary(core_services_container, "Core Services Container") {
    Component(Patient_Management_Component, "Patient Management Component", "Spring MVC / Data", "Manages patient admissions and records within the Core Services Container.")
    Component(Scheduling_Engine_Component, "Scheduling Engine Component", "Spring Service", "Manages clinical scheduling and operations.")
    Component(Event_Publisher_Component, "Event Publisher Component", "Spring Cloud Stream / Kafka", "Publishes domain events asynchronously.")
    Component(FHIR_Interoperability_Component, "FHIR Interoperability Component", "Spring WebFlux", "Handles interoperability via reactive HL7 FHIR APIs.")
    Component(Security_Audit_Interceptor_Component, "Security & Audit Interceptor Component", "Spring AOP / Security", "Provides centralized access control and streams audit trails.")
}

Rel(API_Gateway, Patient_Management_Component, "Routes internal requests", "gRPC over TLS")
Rel(API_Gateway, Scheduling_Engine_Component, "Routes internal requests", "gRPC over TLS")
Rel(API_Gateway, FHIR_Interoperability_Component, "Routes external requests", "REST/HTTPS")
Rel(Patient_Management_Component, PostgreSQL_Primary_DB, "Reads and writes data", "JDBC over TLS")
Rel(Scheduling_Engine_Component, PostgreSQL_Primary_DB, "Reads and writes data", "JDBC over TLS")
Rel(Event_Publisher_Component, Async_Message_Broker, "Publishes domain events", "Kafka Protocol")
Rel(Security_Audit_Interceptor_Component, EMR_Audit_Service, "Streams audit trails", "Kafka Protocol")

@enduml