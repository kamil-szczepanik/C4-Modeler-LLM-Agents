@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Doctors, "Doctors", "Medical professionals who manage patient admissions, electronic medical records, and clinical workflows.")
Person(Nurses, "Nurses", "Healthcare staff who assist with patient care, scheduling, and updating medical records.")
Person(Receptionists, "Receptionists", "Administrative staff who handle patient scheduling, front-desk admissions, and initial registration.")
Person(Billing_Specialists, "Billing Specialists", "Financial staff who manage patient billing, payments, and insurance claims.")

System(Clinic_Management_System, "Clinic Management System", "A hybrid cloud platform designed to manage patient admissions, electronic medical records, scheduling, and billing for healthcare facilities while ensuring HIPAA and GDPR compliance.")

System_Ext(External_Lab___Imaging_Systems, "External Lab & Imaging Systems", "Third-party clinical systems providing laboratory and imaging data.")
System_Ext(Payment_Gateway___Insurance_Clearinghouse, "Payment Gateway / Insurance Clearinghouse", "External financial processors handling claims and billing payments.")
System_Ext(Enterprise_Identity_Provider, "Enterprise Identity Provider", "Handles multi-factor authentication and single sign-on via OAuth2/OIDC.")
System_Ext(Third_Party_Notification_Service, "Third-Party Notification Service", "Manages patient SMS and email reminders.")

Rel(Doctors, Clinic_Management_System, "Accesses admissions, EMR, and scheduling", "HTTPS with mandatory multi-factor authentication")
Rel(Nurses, Clinic_Management_System, "Accesses patient records and scheduling", "HTTPS with mandatory multi-factor authentication")
Rel(Receptionists, Clinic_Management_System, "Manages patient admissions and scheduling", "HTTPS with mandatory multi-factor authentication")
Rel(Billing_Specialists, Clinic_Management_System, "Processes patient billing and financials", "HTTPS with mandatory multi-factor authentication")
Rel(Clinic_Management_System, Enterprise_Identity_Provider, "Authenticates users and manages identity", "OpenID Connect over HTTPS")
Rel(Clinic_Management_System, External_Lab___Imaging_Systems, "Exchanges clinical data and test results", "HL7 FHIR APIs over TLS/REST")
Rel(Clinic_Management_System, Payment_Gateway___Insurance_Clearinghouse, "Processes claims and billing transactions", "HTTPS/REST")
Rel(Clinic_Management_System, Third_Party_Notification_Service, "Sends patient SMS and email alerts", "HTTPS/REST")
@enduml