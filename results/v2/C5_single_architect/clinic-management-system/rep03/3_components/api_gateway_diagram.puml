@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(tls_routing, "TLS Termination & Routing Engine", "Kong / Nginx", "Handles high-performance routing and TLS termination for incoming client requests.")
    Component(auth_filter, "Authentication & Authorization Filter", "Kong / Nginx Plugin", "Validates tokens and user authentication interacting with the Identity Provider.")
    Component(rate_limiting, "Rate Limiting & Threat Protection Plugin", "Kong / Nginx Plugin", "Protects the system by enforcing rate limits and providing threat protection.")
    Component(audit_interceptor, "Audit Logging Interceptor", "Kong / Nginx Plugin", "Intercepts requests to log audit data.")
    Component(phi_redaction, "PHI Redaction & Header Injector", "Kong / Nginx Plugin", "Redacts Protected Health Information and injects headers before dispatching sanitized access events.")
}

System_Ext(audit_worker, "Audit & Compliance Worker", "Worker for handling audit and compliance logs.")

Rel(phi_redaction, audit_worker, "Dispatches sanitized access events", "AMQP / Kafka over TLS")

@startuml