@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Database Cluster", "Database Cluster") {
    Component(Primary_Write_Node, "Primary Write Node", "PostgreSQL 16 with Citus", "Executes ACID transactions and writes.")
    Component(Read_Replica_Nodes, "Read Replica Nodes", "PostgreSQL 16", "Offloads non-blocking read queries.")
    Component(Encryption_Key_Manager_Agent, "Encryption & Key Manager Agent", "PKCS#11 / Vault API", "Injects envelope keys for TDE at rest.")
    Component(Distributed_Consensus_Manager, "Distributed Consensus Manager", "Patroni / etcd", "Handles heartbeating and state coordination.")
}

Rel(Primary_Write_Node, Distributed_Consensus_Manager, "Heartbeating and state coordination", "TCP/gRPC")
Rel(Distributed_Consensus_Manager, Primary_Write_Node, "Heartbeating and state coordination", "TCP/gRPC")
Rel(Encryption_Key_Manager_Agent, Primary_Write_Node, "Injects envelope keys for TDE at rest", "PKCS#11 / Vault API over TLS 1.3")
Rel(Encryption_Key_Manager_Agent, Read_Replica_Nodes, "Injects envelope keys for TDE at rest", "PKCS#11 / Vault API over TLS 1.3")
@enduml