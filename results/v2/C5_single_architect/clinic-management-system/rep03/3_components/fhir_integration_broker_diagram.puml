@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the FHIR Integration Broker container

Container_Ext(API Gateway, "API Gateway", "Kong / Nginx", "Forwards FHIR resource requests via mTLS / HTTPS.")
System_Ext(External Labs & Imaging Systems, "External Labs & Imaging Systems", "HL7 FHIR REST over HTTPS", "External systems receiving standardized bundles.")
Container_Ext(Message Broker, "Message Broker", "Kafka", "Enables asynchronous, decoupled clinical event processing for high availability.")
Container_Ext(Database Cluster, "Database Cluster", "PostgreSQL", "Provides secure transactional audit log persistence via JDBC over TLS.")

Container_Boundary("FHIR Integration Broker", "FHIR Integration Broker") {
    Component(FHIR Route Mediator, "FHIR Route Mediator", "Apache Camel", "Powers enterprise integration routing and mediation patterns for FHIR resource requests.")
    Component(HL7/FHIR Validator Component, "HL7/FHIR Validator Component", "Java", "Performs internal synchronous validation of healthcare data.")
    Component(Data Anonymization & Security Filter, "Data Anonymization & Security Filter", "Java", "Strictly enforces HIPAA and GDPR compliance requirements.")
    Component(FHIR Event Consumer, "FHIR Event Consumer", "Apache Camel JMS/Kafka Consumer", "Consumes asynchronous clinical domain events from the message broker.")
}

Rel(API Gateway, FHIR Route Mediator, "Forwards FHIR resource requests", "mTLS / HTTPS")
Rel(FHIR Route Mediator, HL7/FHIR Validator Component, "Internal synchronous validation", "Direct Java Route")
Rel(HL7/FHIR Validator Component, FHIR Route Mediator, "Internal synchronous validation", "Direct Java Route")
Rel(FHIR Route Mediator, External Labs & Imaging Systems, "Dispatches standardized bundles", "HL7 FHIR REST over HTTPS")
Rel(Message Broker, FHIR Event Consumer, "Consumes asynchronous clinical domain events", "AMQP / Kafka Protocol")
Rel(FHIR Event Consumer, HL7/FHIR Validator Component, "Internal validation", "Direct Java Route")
Rel(FHIR Route Mediator, Database Cluster, "Persists transaction audit logs", "JDBC over TLS")

@enduml