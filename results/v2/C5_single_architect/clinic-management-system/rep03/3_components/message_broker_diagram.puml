@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container(emr_service, "EMR Service", "Spring Boot", "Manages Electronic Medical Records")
Container(audit_worker, "Audit & Compliance Worker", "Go", "Processes audit and compliance events")

Container_Boundary(message_broker, "Message Broker") {
    Component(event_ingestion_router, "Event Ingestion Router", "Apache Kafka", "Accepts published audit and domain events and routes them within the message broker.")
    Component(commit_log_partition_manager, "Commit Log Partition Manager", "Apache Kafka", "Persists validated streams to disk using immutable distributed commit logs for 10-year data retention.")
    Component(consumer_group_coordinator, "Consumer Group Coordinator", "Apache Kafka", "Manages consumer group offsets and load balancing for message consumption.")
    Component(schema_registry, "Schema Registry", "Avro / JSON Schema", "Validates message schemas and guarantees message compatibility and data contracts across microservices.")
}

Rel(emr_service, schema_registry, "Validates message schemas", "HTTP/REST")
Rel(emr_service, event_ingestion_router, "Publishes audit and domain events", "TCP / Kafka Producer API")
Rel(event_ingestion_router, commit_log_partition_manager, "Persists validated streams to disk", "Internal Binary Protocol")
Rel(audit_worker, commit_log_partition_manager, "Consumes event streams", "TCP / Kafka Consumer API")

@enduml