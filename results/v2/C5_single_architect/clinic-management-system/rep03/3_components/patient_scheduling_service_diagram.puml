@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient & Scheduling Service container

System_Ext(api_gateway, "API Gateway", "Routes client requests via mTLS.")

Container_Boundary(patient_and_scheduling_service, "Patient & Scheduling Service") {
    Component(patient_registration_controller_and_service, "Patient Registration Controller & Service", "NestJS component", "Handles patient admissions and demographics.")
    Component(scheduling_engine_and_resource_validator, "Scheduling Engine & Resource Validator", "NestJS component", "Manages appointment scheduling and validates resources.")
    Component(notification_dispatcher, "Notification Dispatcher", "NestJS component", "Dispatches notifications regarding appointments.")
    Component(patient_consent_and_privacy_manager, "Patient Consent & Privacy Manager", "NestJS component", "Manages patient consent and privacy compliance.")
    ComponentDb(database_cluster, "Database Cluster", "PostgreSQL", "Relational storage for encrypted patient and scheduling data ensuring durability.")
    Component(message_broker, "Message Broker", "Apache Kafka", "Event broker for reliable asynchronous messaging and notifications.")
    Component(in_memory_cache, "In-Memory Cache", "Redis", "In-memory cache utilizing distributed locking (Redlock) for atomic appointment clash checks.")
}

Rel(api_gateway, patient_registration_controller_and_service, "Routes client requests", "mTLS")
Rel(patient_registration_controller_and_service, patient_consent_and_privacy_manager, "Validates consent metadata", "Internal TypeScript Function Call")
Rel(patient_registration_controller_and_service, database_cluster, "Persists demographics", "TypeORM / PostgreSQL protocol")
Rel(scheduling_engine_and_resource_validator, in_memory_cache, "Performs slot-locking and clash checks", "Redis Protocol")
Rel(scheduling_engine_and_resource_validator, database_cluster, "Persists appointments and audit logs", "TypeORM / PostgreSQL protocol")
Rel(scheduling_engine_and_resource_validator, message_broker, "Emits AppointmentBooked events", "Kafka protocol")

@enduml