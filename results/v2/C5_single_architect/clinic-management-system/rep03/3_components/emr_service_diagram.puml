@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the EMR Service container

Container_Boundary(emr_service, "EMR Service") {
    Component(emr_controller_layer, "EMR Controller Layer", "Spring MVC REST Controllers", "Handles incoming clinical HTTPS requests.")
    Component(clinical_record_manager, "Clinical Record Manager", "Spring Boot Domain Service", "Core domain service managing patient charts, progress notes, and diagnostics.")
    Component(audit_trail_interceptor, "Audit Trail Interceptor", "AOP Component", "Captures immutable access logs asynchronously.")
    Component(encryption_data_access_layer, "Encryption & Data Access Layer", "Spring Data JPA / Hibernate, AES-256", "Manages database interactions utilizing column-level AES-256 encryption.")
    Component(fhir_transformer_component, "FHIR Transformer Component", "Mapping Engine / Apache Camel", "Converts internal models to HL7 FHIR resources.")
    Component(message_broker, "Message Broker", "RabbitMQ / Kafka", "Enables asynchronous, decoupled audit event publishing.")
    Component(database_cluster, "Database Cluster", "PostgreSQL", "Stores clinical data and audit trails.")
}

Rel(emr_controller_layer, clinical_record_manager, "In-process method call")
Rel(clinical_record_manager, encryption_data_access_layer, "In-process JPA / PostgreSQL protocol")
Rel(clinical_record_manager, fhir_transformer_component, "In-process method call")
Rel(audit_trail_interceptor, message_broker, "AMQP / Kafka, async")
Rel(fhir_transformer_component, database_cluster, "Read-only queries via JPA")

@enduml