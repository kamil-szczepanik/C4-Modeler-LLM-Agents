@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "External routing system")
System_Ext(message_broker, "Message Broker (Kafka)", "Enterprise messaging system")
System_Ext(external_payment_gateway, "External Payment Gateway", "Third-party payment and claims processor")
System_Ext(postgresql_db, "PostgreSQL Database Cluster", "Relational database storage")

Container_Boundary(billing_service, "Billing Service") {
    Component(billing_api_controller, "Billing API Controller", "FastAPI Router", "Handles incoming payment processing and insurance claims requests.")
    Component(audit_logging_interceptor, "Audit Logging Interceptor", "FastAPI Middleware", "Performs HIPAA-compliant audit logging for security and tracking.")
    Component(claim_processing_engine, "Claim Processing Engine", "Python Domain Service", "Processes insurance claims and core billing business logic.")
    Component(claims_transformer_component, "Claims Transformer Component", "Pydantic-based Schema Validator", "Validates and maps schemas for clinical and financial data integrity.")
    Component(payment_gateway_integration_client, "Payment Gateway Integration Client", "HTTPS/REST Outbound Adapter", "Submits claims and processes payments via external payment gateways.")
    Component(billing_data_repository, "Billing Data Repository", "SQLAlchemy ORM with asyncpg", "Executes persistent data storage operations with AES-256 encryption.")
}

Rel(api_gateway, billing_api_controller, "Routes incoming financial and claim requests", "mTLS")
Rel(audit_logging_interceptor, message_broker, "Publishes immutable audit events asynchronously", "AMQP/Kafka")
Rel(claim_processing_engine, claims_transformer_component, "Passes domain models for format mapping (X12 / HL7)", "In-Memory")
Rel(payment_gateway_integration_client, external_payment_gateway, "Submits claims and processes payments", "HTTPS/REST / TLS 1.3")
Rel(billing_data_repository, postgresql_db, "Executes persistent data storage operations", "PostgreSQL / AES-256")

@enduml