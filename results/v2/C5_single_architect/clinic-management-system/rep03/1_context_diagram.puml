@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patient, "Patient", "Accesses the system via Web or Mobile to manage admissions, scheduling, and records.")
Person(Clinician_Staff, "Clinician/Staff", "Accesses the system via Web to manage electronic medical records and clinical workflows.")
Person(Hospital_Administrator, "Hospital Administrator", "Accesses the system via Web to oversee administration and system management.")

System(Clinic_Management_System, "Clinic Management System", "A hybrid cloud platform that securely manages patient admissions, electronic medical records, scheduling, and billing for clinical environments while ensuring strict regulatory compliance, high availability, and interoperability.")

System_Ext(Identity_Provider, "Identity Provider", "Handles user authentication via OIDC/SAML with multi-factor authentication.")
System_Ext(Payment_Gateway, "Payment Gateway", "Processes billing and insurance claims.")
System_Ext(External_Labs_Imaging_Systems, "External Labs & Imaging Systems", "Exchanges medical data using HL7 FHIR.")
System_Ext(Regulatory_Archiving_Audit_Storage, "Regulatory Archiving / Audit Storage", "Replicates audit logs and records for 10-year retention.")

Rel(Patient, Clinic_Management_System, "Accesses features via Web/Mobile", "HTTPS")
Rel(Clinician_Staff, Clinic_Management_System, "Accesses features via Web", "HTTPS")
Rel(Hospital_Administrator, Clinic_Management_System, "Accesses features via Web", "HTTPS")
Rel(Clinic_Management_System, Identity_Provider, "Authenticates users via OIDC/SAML with multi-factor auth", "OIDC/SAML, HTTPS")
Rel(Clinic_Management_System, Payment_Gateway, "Submits billing and insurance claims", "REST/TLS")
Rel(Clinic_Management_System, External_Labs_Imaging_Systems, "Exchanges medical data", "HL7 FHIR over TLS")
Rel(External_Labs_Imaging_Systems, Clinic_Management_System, "Exchanges medical data", "HL7 FHIR over TLS")
Rel(Clinic_Management_System, Regulatory_Archiving_Audit_Storage, "Replicates audit logs and records for 10-year retention", "HTTPS/TLS 1.3")

@enduml