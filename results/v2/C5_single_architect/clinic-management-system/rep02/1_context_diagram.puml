@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patient, "Patient", "Actor using the Patient Portal via Web/Mobile for scheduling and viewing records.")
Person(Clinician_Receptionist, "Clinician / Receptionist", "Actors using the Clinic Management System Web interface for admissions, EMR, and scheduling.")

System(Clinic_Management_System, "Clinic Management System", "A distributed enterprise platform that manages patient admissions, electronic medical records, scheduling, and billing for medium-sized hospitals and clinics.")

System_Ext(External_Lab_Imaging_Systems, "External Lab & Imaging Systems", "External systems for clinical diagnostics.")
System_Ext(Payment_Gateway_Insurance_Clearinghouse, "Payment Gateway / Insurance Clearinghouse", "External financial systems for billing and claims.")
System_Ext(Notification_Service, "Notification Service", "External SMS and email gateway (Twilio/SendGrid).")
System_Ext(On_Premise_K8s_AWS_Infrastructure, "On-Premise K8s / AWS Infrastructure", "Hybrid cloud infrastructure spanning on-premise Kubernetes and AWS eu-central-1.")

Rel(Patient, Clinic_Management_System, "Interacts for authentication and scheduling", "HTTPS (Web/Mobile) / OAuth 2.0 / OpenID Connect")
Rel(Clinician_Receptionist, Clinic_Management_System, "Interacts for admissions, EMR, and scheduling", "HTTPS with multi-factor authentication")
Rel(Clinic_Management_System, External_Lab_Imaging_Systems, "Integrates for clinical diagnostics", "HL7 FHIR over REST/TLS")
Rel(Clinic_Management_System, Payment_Gateway_Insurance_Clearinghouse, "Integrates for claims submission and billing", "HTTPS/REST")
Rel(Clinic_Management_System, Notification_Service, "Integrates for 2FA challenges and appointment reminders", "HTTPS/REST")
Rel(Clinic_Management_System, On_Premise_K8s_AWS_Infrastructure, "Synchronizes data across hybrid cloud environment", "Encrypted VPN/Direct Connect")

@enduml