@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Apache Kafka container

System_Ext(Billing_Claims_Service, "Billing & Claims Service", "Core container running business logic")
System_Ext(Elasticsearch_WORM_storage, "Elasticsearch / WORM storage", "External storage system")

Container_Boundary(apache_kafka, "Apache Kafka") {
    Component(Kafka_Broker, "Kafka Broker", "Apache Kafka", "Handles fault-tolerant event-driven messaging and publishes asynchronous clinical and billing events.")
    Component(KRaft_Controller, "KRaft Controller", "KRaft Mode", "Manages metadata and consensus without ZooKeeper overhead.")
    Component(Kafka_Connect, "Kafka Connect", "Kafka Connect", "Syncs audit logs and clinical data securely to Elasticsearch and WORM storage.")
    Component(Kafka_Schema_Registry, "Kafka Schema Registry", "Schema Registry", "Enforces Avro/Protobuf schema validation and validates message schemas.")
    Component(Kafka_Security_Interceptor_Module, "Kafka Security Interceptor Module", "Security Interceptor", "Enforces fine-grained ACLs and mTLS for HIPAA-compliant PHI data transit.")
}

Rel(Billing_Claims_Service, Kafka_Schema_Registry, "Validates message schemas", "HTTPS")
Rel(Kafka_Broker, Kafka_Schema_Registry, "Fetches schemas", "HTTP/REST")
Rel(Kafka_Connect, Elasticsearch_WORM_storage, "Syncs audit logs and clinical data securely", "TLS")

@enduml