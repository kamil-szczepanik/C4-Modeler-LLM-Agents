@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient & Scheduling Service container

Container_Boundary(patient_scheduling_service, "Patient & Scheduling Service") {
    Component(PatientRegistrationControllerService, "Patient Registration Controller & Service", "Spring Boot (Java)", "Manages patient admissions and demographic capture.")
    Component(SchedulingEngine, "Scheduling Engine", "Spring Boot (Java)", "Executes appointment scheduling and resource clash checks.")
    Component(CacheLockManager, "Cache & Lock Manager", "Redis", "Interfaces with Redis for distributed locking.")
    Component(DataAccessRepository, "Data Access Repository", "PostgreSQL, JDBC over TLS", "Handles persistent storage interactions with PostgreSQL.")
    Component(EventPublisher, "Event Publisher", "Apache Kafka, SASL_SSL", "Dispatches domain events to Apache Kafka.")
}

Component(APIGateway, "API Gateway", "gRPC", "External entry point routing ingress traffic.")
Component(ApacheKafka, "Apache Kafka", "Apache Kafka", "Message broker for publishing state changes.")

Rel(APIGateway, PatientRegistrationControllerService, "Routes ingress traffic", "gRPC")
Rel(PatientRegistrationControllerService, CacheLockManager, "Acquires distributed locks", "Redis RESP over TLS")
Rel(SchedulingEngine, CacheLockManager, "Acquires distributed locks", "Redis RESP over TLS")
Rel(SchedulingEngine, DataAccessRepository, "Persists state", "JDBC over TLS with AES-256")
Rel(SchedulingEngine, EventPublisher, "Dispatches domain events", "Internal method call")
Rel(PatientRegistrationControllerService, EventPublisher, "Dispatches domain events", "Internal method call")
Rel(EventPublisher, ApacheKafka, "Publishes state changes", "TCP/SASL_SSL")

@enduml