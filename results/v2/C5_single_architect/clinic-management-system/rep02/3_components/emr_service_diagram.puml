@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(emr_service, "EMR Service") {
    Component(emr_api_controller, "EMR API Controller", "Spring MVC / gRPC", "Manages incoming requests for electronic medical records.")
    Component(clinical_record_manager, "Clinical Record Manager", "Spring @Service", "Core service managing clinical record business logic.")
    Component(fhir_transformer_component, "FHIR Transformer Component", "Apache Camel / HAPI FHIR", "Translates domain models to HL7 FHIR standards for external lab interoperability.")
    Component(audit_trail_interceptor, "Audit Trail Interceptor", "Spring AOP", "Intercepts operations to generate audit trails for compliance.")
    Component(emr_cache_component, "EMR Cache Component", "Spring Cache / Redis", "Caches active patient charts to meet sub-second P95 performance constraints.")
    Component(emr_data_access_repository, "EMR Data Access Repository", "Spring Data JPA", "Provides persistence access for core clinical data.")
}

System_Ext(postgresql, "PostgreSQL", "Relational Database")

Rel(emr_api_controller, clinical_record_manager, "Invokes", "In-process")
Rel(clinical_record_manager, emr_cache_component, "Queries/Updates", "Redis Client, TLS")
Rel(clinical_record_manager, emr_data_access_repository, "Reads/Writes", "JPA/JDBC, TLS")
Rel(clinical_record_manager, audit_trail_interceptor, "Publishes audit events", "Async Event / Apache Kafka")
Rel(emr_cache_component, postgresql, "Fallback Read", "Encrypted JDBC")
@enduml