@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Service (FHIR Adapter) container

System_Ext(External_Lab_Imaging_Systems, "External Lab & Imaging Systems", "Exchanges clinical and imaging data.")
System_Ext(Apache_Kafka, "Apache Kafka", "Message Broker", "Handles asynchronous event streaming securely via mTLS.")
System_Ext(Audit_Service, "Audit Service", "Microservice", "Receives secure audit trails via gRPC.")

Container_Boundary(integration_service, "Integration Service (FHIR Adapter)") {
    Component(FHIR_Ingress_Egress_Router, "FHIR Ingress/Egress Router", "Apache Camel / Spring Integration", "Manages transport routing and HTTP/REST endpoints; exchanges clinical and imaging data with external systems.")
    Component(Data_Transformation_Mapping_Engine, "Data Transformation & Mapping Engine", "HAPI FHIR library", "Delegates payload parsing and serialization; converts internal domain models to standard HL7 FHIR R4 resources.")
    Component(Kafka_Event_Publisher_Component, "Kafka Event Publisher Component", "In-memory", "Hands off normalized event records for asynchronous domain event publishing.")
    Component(Audit_Compliance_Interceptor, "Audit & Compliance Interceptor", "Spring AOP / Camel Interceptor", "Intercepts requests for PII sanitization and audit logging; forwards raw payloads for compliance logging.")
}

Rel(External_Lab_Imaging_Systems, FHIR_Ingress_Egress_Router, "Exchanges clinical and imaging data", "HL7 FHIR over TLS 1.3")
Rel(FHIR_Ingress_Egress_Router, Data_Transformation_Mapping_Engine, "Delegates payload parsing and serialization", "In-memory Java API")
Rel(Data_Transformation_Mapping_Engine, Kafka_Event_Publisher_Component, "Hands off normalized event records", "In-memory")
Rel(Kafka_Event_Publisher_Component, Apache_Kafka, "Publishes asynchronous domain events", "mTLS over TCP")
Rel(FHIR_Ingress_Egress_Router, Audit_Compliance_Interceptor, "Forwards raw payloads for compliance logging", "In-memory")
Rel(Audit_Compliance_Interceptor, Audit_Service, "Streams secure audit trails", "gRPC over TLS 1.3")

@enduml