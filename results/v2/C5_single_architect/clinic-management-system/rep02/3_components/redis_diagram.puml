@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(redis_container, "Redis") {
    Component(RedisMasterNode, "Redis Master Node", "Redis Enterprise / Open Source Redis 7.x", "Stores encrypted key-values, caching, session state, and scheduling locks.")
    Component(RedisReplicaNodes, "Redis Replica Nodes", "Redis Enterprise / Open Source Redis 7.x", "Provides data replication for high availability.")
    Component(TLS13Proxy, "TLS 1.3 Proxy", "TLS 1.3", "Secures transport layer communication.")
    Component(ClientSideEncryptionDecryptionMiddleware, "Client-Side Encryption/Decryption Middleware", "Encryption Middleware", "Handles client-side encryption and decryption of serialized PII/PHI.")
}

Rel(ClientSideEncryptionDecryptionMiddleware, RedisMasterNode, "Stores encrypted key-values", "RESP protocol over TLS 1.3")
Rel(RedisMasterNode, RedisReplicaNodes, "Data replication", "RESP")

@enduml