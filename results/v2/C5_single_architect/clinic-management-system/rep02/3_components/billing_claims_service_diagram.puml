@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(billing_and_claims_service, "Billing & Claims Service") {
    Component(BillingController, "BillingController", "Spring Boot (Java)", "Handles incoming billing and claims HTTP/gRPC requests.")
    Component(InvoiceManager, "InvoiceManager", "Spring Boot (Java)", "Manages invoice generation and lifecycle.")
    Component(ClaimsProcessor, "ClaimsProcessor", "Spring Boot (Java)", "Processes medical claims for insurance clearinghouses.")
    Component(PaymentAdapter, "PaymentAdapter", "Spring Boot (Java)", "Adapts and communicates with external payment gateways and clearinghouses.")
    Component(BillingRepository, "BillingRepository", "Spring Data JPA / JDBC", "Persists billing and claims data to PostgreSQL.")
    Component(CircuitBreakerMiddleware, "CircuitBreakerMiddleware", "Opossum / Spring Cloud Circuit Breaker", "Provides resilience and fault tolerance for external calls.")
    Component(AuditInterceptor, "AuditInterceptor", "Spring Interceptor / AOP", "Intercepts requests for auditing and compliance tracking.")
}

Rel(BillingController, InvoiceManager, "Delegates invoice processing", "")
Rel(BillingController, ClaimsProcessor, "Delegates claims processing", "")
Rel(ClaimsProcessor, PaymentAdapter, "Transmits claims", "HTTPS/REST, TLS 1.3")
Rel(InvoiceManager, BillingRepository, "Persists invoice data", "Encrypted TCP with AES-256")
Rel(ClaimsProcessor, BillingRepository, "Persists claim data", "Encrypted TCP with AES-256")
Rel(BillingController, CircuitBreakerMiddleware, "Protects outgoing calls", "")
Rel(BillingController, AuditInterceptor, "Triggers audit logging", "")

@enduml