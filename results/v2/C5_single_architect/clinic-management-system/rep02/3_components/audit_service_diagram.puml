@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit Service container

Container_Boundary(audit_service, "Audit Service") {
    Component(audit_api_controller, "Audit API Controller", "Spring Boot / Java", "Receives audit requests and publishes events.")
    Component(event_normalizer_processor, "Event Normalizer & Processor", "Spring Boot / Java", "Normalizes and processes audit event streams.")
    Component(worm_storage_writer, "WORM Storage Writer", "Spring Boot / Java", "Writes immutable audit logs to secure storage.")
    Component(retention_enforcement_manager, "Retention Enforcement Manager", "Spring Boot / Java", "Manages 10-year data retention and compliance policies.")
}

Rel(audit_api_controller, event_normalizer_processor, "Passes raw events for processing", "")
Rel(event_normalizer_processor, worm_storage_writer, "Sends normalized events for immutable storage", "")
Rel(retention_enforcement_manager, worm_storage_writer, "Enforces retention policies on", "")

@enduml