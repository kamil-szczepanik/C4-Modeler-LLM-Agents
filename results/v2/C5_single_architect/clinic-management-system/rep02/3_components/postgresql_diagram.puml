@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL container

Container_Boundary(postgresql, "PostgreSQL") {
    Component(Connection Pooler, "Connection Pooler", "PgBouncer", "Manages incoming TCP/IP connections from microservices.")
    Component(Primary Database Instance, "Primary Database Instance", "PostgreSQL 15+", "Handles read/write transactions for EMR and patient records.")
    Component(High Availability Replica, "High Availability Replica", "Patroni / PostgreSQL Streaming Replication", "Active standby instance for automated failover.")
    Component(Read-Only Replica, "Read-Only Replica", "PostgreSQL Streaming Replication", "Offloads read traffic to improve performance.")
    Component(Audit Logging Engine, "Audit Logging Engine", "pgaudit", "Captures DDL/DML statements for HIPAA-compliant auditing.")
    Component(Backup & Archival Agent, "Backup & Archival Agent", "Barman / pgBackRest", "Manages point-in-time recovery and long-term data retention.")
}

Rel(Connection Pooler, Primary Database Instance, "Forwards write operations and dynamic queries.")
Rel(Primary Database Instance, High Availability Replica, "Synchronizes data in real-time", "TCP/IP, TLS 1.3")
Rel(Primary Database Instance, Read-Only Replica, "Feeds read-only data for scaling.")
Rel(Backup & Archival Agent, Primary Database Instance, "Performs backups", "Encrypted File System / API")
@enduml