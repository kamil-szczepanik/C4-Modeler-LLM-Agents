@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(AuthFilter, "Authentication & Authorization Filter", "Kong / NGINX Plugin (Lua)", "Validates incoming tokens and enforces OAuth2 / MFA access control.")
    Component(RoutingEngine, "Routing & Load Balancing Engine", "Kong / OpenResty", "Routes incoming requests to the appropriate backend microservices and balances traffic.")
    Component(RateLimitingPlugin, "Rate Limiting & Threat Protection Plugin", "Kong / Redis-backed Plugin", "Prevents abuse and protects against security threats by enforcing rate limits.")
    Component(AuditInterceptor, "mTLS & Audit Logging Interceptor", "Kong Plugin / NGINX", "Ensures secure mTLS communication and logs request metadata for auditing.")
    Component(FhirTransformer, "FHIR Request Transformer", "Kong Plugin / Lua", "Transforms incoming external lab and imaging system data into structured FHIR requests.")
}

System_Ext(PatientSchedulingService, "Patient & Scheduling Service", "Backend service for patient management and scheduling")
System_Ext(EmrService, "EMR Service", "Electronic Medical Records service")
System_Ext(BillingService, "Billing & Claims Service", "Billing and claims management service")
System_Ext(IntegrationService, "Integration Service (FHIR Adapter)", "Integration adapter for FHIR protocol")

Rel(AuthFilter, RoutingEngine, "Passes authenticated requests")
Rel(RoutingEngine, PatientSchedulingService, "Routes internal requests", "gRPC over TLS")
Rel(RoutingEngine, EmrService, "Routes internal requests", "gRPC over TLS")
Rel(RoutingEngine, BillingService, "Routes internal requests", "gRPC over TLS")
Rel(FhirTransformer, IntegrationService, "Forwards FHIR bundles", "gRPC over TLS")

@enduml