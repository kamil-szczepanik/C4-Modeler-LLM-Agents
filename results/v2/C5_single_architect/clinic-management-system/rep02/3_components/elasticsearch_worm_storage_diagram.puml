@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Elasticsearch / WORM storage container

Person(ComplianceOfficer, "Compliance Officer", "Queries audit trails via HTTPS, RBAC, OAuth2/OIDC")
System_Ext(AuditService, "Audit Service", "External or container-level Audit Service that streams audit events.")

Container_Boundary(ElasticsearchWORMstorage, "Elasticsearch / WORM storage") {
    Component(IngestNodeRESTAPIGateway, "Ingest Node / REST API Gateway", "Elasticsearch REST API", "Accepts and validates incoming audit records via REST over HTTPS.")
    Component(IndexLifecycleManagementILMEngine, "Index Lifecycle Management (ILM) Engine", "Elasticsearch ILM", "Manages index lifecycles, migrating and locking indexes to WORM storage.")
    Component(WORMStorageEngine, "WORM Storage Engine", "AWS S3 Object Lock", "Provides immutable, secure long-term storage for audit data.")
    Component(AuditDataNodeCluster, "Audit Data Node Cluster", "Elasticsearch Lucene Engine", "Indexes validated records and offloads older indices to WORM storage.")
    Component(AccessControlRBACComponent, "Access Control & RBAC Component", "OAuth2/OIDC, RBAC", "Handles secure queries and authorization for audit trails.")
}

Rel(AuditService, IngestNodeRESTAPIGateway, "Streams audit events", "REST over HTTPS, TLS 1.3, Mutual TLS")
Rel(IngestNodeRESTAPIGateway, AuditDataNodeCluster, "Indexes validated records", "Internal Transport Protocol over TCP, TLS 1.3")
Rel(IndexLifecycleManagementILMEngine, WORMStorageEngine, "Migrates and locks indexes", "S3 API with Object Lock")
Rel(AuditDataNodeCluster, WORMStorageEngine, "Offloads older indices", "S3 API, TLS 1.3")
Rel(ComplianceOfficer, AccessControlRBACComponent, "Queries audit trails", "HTTPS, RBAC, OAuth2/OIDC")

@enduml