@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Patients_and_Clinical_Administrative_Staff, "Patients and Clinical & Administrative Staff", "Users interacting with the system for admissions, EMRs, scheduling, and billing.")
System_Ext(External_Lab_Imaging_Systems_Payment_Gateways_and_Insurance_Clearinghouses, "External Lab & Imaging Systems, Payment Gateways, and Insurance Clearinghouses", "External systems for diagnostic tests, payments, and insurance claims.")

System_Boundary(Clinic_Management_System, "Clinic Management System") {
    Container(Nginx_Envoy_API_Gateway, "Nginx / Envoy API Gateway", "Nginx / Envoy", "Handles TLS termination, OAuth2/OIDC MFA validation, and rate limiting.")
    Container(React_TypeScript_Web_Application, "React / TypeScript Web Application", "React / TypeScript", "Provides high-performance responsive client-side UI rendering.")
    Container(Patient_EMR_Service, "Patient & EMR Service", "Spring Boot", "Manages patient data and electronic medical records.")
    Container(Scheduling_Service, "Scheduling Service", "Node.js / Go", "Handles high-concurrency appointment scheduling and resource clash checks.")
    Container(Billing_Integration_Service, "Billing & Integration Service", "Spring Boot with Apache Camel", "Processes billing and integrates with external healthcare systems using HL7 FHIR.")
    ContainerDb(Redis_Enterprise_Distributed_Cache, "Redis Enterprise Distributed Cache", "Redis Enterprise", "Provides active-active caching for fast data access.")
    Container(Apache_Kafka_Event_Broker, "Apache Kafka Event Broker", "Apache Kafka", "Handles asynchronous event-driven decoupling between services.")
    ContainerDb(PostgreSQL_Primary_Database, "PostgreSQL Primary Database", "PostgreSQL with AES-256 encryption", "Primary relational database ensuring ACID compliance and secure data storage.")
    Container(Immutable_Audit_Log_Store, "Immutable Audit Log Store", "Encrypted Storage", "Stores immutable audit logs for security and compliance.")
}

Rel(Patients_and_Clinical_Administrative_Staff, React_TypeScript_Web_Application, "Accesses via web browser", "HTTPS/REST")
Rel(React_TypeScript_Web_Application, Nginx_Envoy_API_Gateway, "Sends API requests", "HTTPS/REST")
Rel(Nginx_Envoy_API_Gateway, Patient_EMR_Service, "Routes requests", "gRPC and HTTPS/REST")
Rel(Nginx_Envoy_API_Gateway, Scheduling_Service, "Routes requests", "gRPC and HTTPS/REST")
Rel(Nginx_Envoy_API_Gateway, Billing_Integration_Service, "Routes requests", "gRPC and HTTPS/REST")
Rel(Patient_EMR_Service, PostgreSQL_Primary_Database, "Reads and writes patient and EMR data", "SQL/TCP")
Rel(Patient_EMR_Service, Redis_Enterprise_Distributed_Cache, "Caches frequently accessed data", "RESP")
Rel(Scheduling_Service, Billing_Integration_Service, "Sends scheduling and billing events", "Apache Kafka (AMQP/Kafka)")
Rel(Billing_Integration_Service, External_Lab_Imaging_Systems_Payment_Gateways_and_Insurance_Clearinghouses, "Exchanges billing, integration, and health data", "HL7 FHIR over HTTPS")

@enduml