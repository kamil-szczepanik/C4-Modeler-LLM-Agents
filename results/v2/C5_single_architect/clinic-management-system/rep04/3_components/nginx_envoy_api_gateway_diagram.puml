@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Nginx / Envoy API Gateway container

Container_Boundary(api_gateway_boundary, "Nginx / Envoy API Gateway") {
    Component(TLS_Termination_and_Ingress_Listener, "TLS Termination & Ingress Listener", "Envoy/Nginx Core", "Handles edge TLS 1.3 termination and mTLS zero-trust transport.")
    Component(Authentication_and_Authorization_Filter, "Authentication & Authorization Filter", "Lua/Wasm with OAuth2/OIDC", "Executes low-latency multi-factor authentication and token validation.")
    Component(Rate_Limiting_and_Threat_Protection_Engine, "Rate Limiting & Threat Protection Engine", "Envoy Rate Limit Service & Redis", "Enforces API rate limits and protects against volumetric attacks.")
    Component(Dynamic_Routing_and_Load_Balancing_Engine, "Dynamic Routing & Load Balancing Engine", "Envoy RDS & gRPC/HTTP2", "Manages high-performance dynamic routing across backend microservices.")
}

System_Ext(Patient_and_EMR_Service, "Patient & EMR Service", "Backend Microservice")
System_Ext(Scheduling_Service, "Scheduling Service", "Backend Microservice")
System_Ext(Billing_and_Integration_Service, "Billing & Integration Service", "Backend Microservice")

Rel(TLS_Termination_and_Ingress_Listener, Authentication_and_Authorization_Filter, "Envoy Filter Chain, In-Memory", "In-Memory")
Rel(Authentication_and_Authorization_Filter, Rate_Limiting_and_Threat_Protection_Engine, "gRPC over Unix Domain Socket", "gRPC/UDS")
Rel(Rate_Limiting_and_Threat_Protection_Engine, Dynamic_Routing_and_Load_Balancing_Engine, "Envoy Filter Chain, In-Memory", "In-Memory")
Rel(Dynamic_Routing_and_Load_Balancing_Engine, Patient_and_EMR_Service, "gRPC / HTTP/2 over mTLS", "gRPC/HTTP2")
Rel(Dynamic_Routing_and_Load_Balancing_Engine, Scheduling_Service, "gRPC / HTTP/2 over mTLS", "gRPC/HTTP2")
Rel(Dynamic_Routing_and_Load_Balancing_Engine, Billing_and_Integration_Service, "gRPC / HTTP/2 over mTLS", "gRPC/HTTP2")

@enduml