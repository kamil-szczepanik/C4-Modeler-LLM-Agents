@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient & EMR Service container

Container_Boundary(patient_emr_service, "Patient & EMR Service") {
    Component(PatientRegistryComponent, "Patient Registry Component", "Spring Boot", "Manages patient admissions and demographic records.")
    Component(EMRManagementComponent, "EMR Management Component", "Spring Boot", "Manages electronic medical records, interacting with database, cache, and audit components.")
    Component(AuditTrailInterceptor, "Audit Trail Interceptor", "Spring AOP", "Triggers audit events for compliance tracking.")
    Component(FHIRInteroperabilityAdapter, "FHIR Interoperability Adapter", "HAPI FHIR JPA", "Exchanges standardized healthcare data with external lab and imaging systems.")
    Component(EMRCachingProxyComponent, "EMR Caching Proxy Component", "Spring Data Redis", "Handles reads and writes for hot patient data.")
}

System_Ext(PostgreSQLPrimaryDatabase, "PostgreSQL Primary Database", "Reads and writes clinical records")
System_Ext(ImmutableAuditLogStore, "Immutable Audit Log Store", "Persists compliance records")
System_Ext(LabImagingSystems, "Lab & Imaging Systems", "Exchanges health data")

Rel(EMRManagementComponent, EMRCachingProxyComponent, "Reads/writes hot patient data", "RESP")
Rel(EMRManagementComponent, PostgreSQLPrimaryDatabase, "Reads and writes clinical records", "JPA/SQL")
Rel(EMRManagementComponent, AuditTrailInterceptor, "Triggers audit events", "In-memory")
Rel(AuditTrailInterceptor, ImmutableAuditLogStore, "Persists compliance records", "HTTPS/TLS")
Rel(FHIRInteroperabilityAdapter, LabImagingSystems, "Exchanges health data", "HL7 FHIR / HTTPS")

@enduml