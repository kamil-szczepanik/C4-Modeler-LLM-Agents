@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the React / TypeScript Web Application container

Container_Boundary("react_typescript_web_application", "React / TypeScript Web Application") {
    Component(router_state_management_component, "Router / State Management Component", "React Router, Redux Toolkit", "Manages scalable client-side state and navigation.")
    Component(authentication_authorization_component, "Authentication & Authorization Component", "OpenID Connect/OAuth2 SDK", "Secures communications and enforces MFA/JWT handling.")
    Component(emr_scheduling_ui_module, "EMR & Scheduling UI Module", "React", "Provides the user interface for EMR and scheduling.")
    Component(api_client_component, "API Client Component", "Axios", "Handles API requests to the API Gateway.")
    Component(client_side_cache_offline_storage_component, "Client-Side Cache & Offline Storage Component", "IndexedDB", "Provides local client-side caching to meet sub-second EMR load times.")
}

System_Ext(nginx_envoy_api_gateway, "Nginx / Envoy API Gateway", "Gateway")

Rel(emr_scheduling_ui_module, api_client_component, "Invokes API operations", "TypeScript Method Calls")
Rel(emr_scheduling_ui_module, client_side_cache_offline_storage_component, "Reads/writes cached state", "TypeScript Method Calls")
Rel(api_client_component, nginx_envoy_api_gateway, "Sends API requests", "HTTPS/REST")

@enduml