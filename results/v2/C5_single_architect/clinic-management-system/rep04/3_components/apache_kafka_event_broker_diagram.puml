@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Apache Kafka Event Broker container

System_Ext(PatientEMRService, "Patient & EMR Service", "External service publishing EMR events")
System_Ext(BillingIntegrationService, "Billing & Integration Service", "External service consuming billing triggers")

Container_Boundary(ApacheKafkaEventBroker, "Apache Kafka Event Broker") {
    Component(PartitionManagerReplicationEngine, "Partition Manager & Replication Engine", "Kraft / ZooKeeper Consensus, Java", "Handles leader election and In-Sync Replicas (ISR) for cluster coordination.")
    Component(KafkaRequestHandlerProduceConsumeAPI, "Kafka Request Handler & Produce/Consume API", "Java TCP Sockets, Java NIO", "Processes binary messaging and handles produce/consume requests.")
    Component(StorageLogCompactionEngine, "Storage & Log Compaction Engine", "OS Page Cache, Java NIO, AES-256", "Manages encrypted event retention and storage log compaction.")
    Component(MirrorMaker20ReplicationAgent, "MirrorMaker 2.0 Replication Agent", "Kafka Connect, Java", "Facilitates cross-site hybrid replication for active-active multi-region disaster recovery.")
}

Rel(PatientEMRService, KafkaRequestHandlerProduceConsumeAPI, "Publishes EMR events", "TCP / Kafka Protocol (SASL/TLS)")
Rel(BillingIntegrationService, KafkaRequestHandlerProduceConsumeAPI, "Consumes billing triggers", "TCP / Kafka Protocol (SASL/TLS)")
Rel(PartitionManagerReplicationEngine, MirrorMaker20ReplicationAgent, "Synchronizes state across regions", "TCP / Kafka Protocol (TLS)")

@enduml