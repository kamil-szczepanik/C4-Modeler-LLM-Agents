@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(postgresql_primary_database, "PostgreSQL Primary Database") {
    Component(PgBouncer, "PgBouncer", "Connection Pooler", "Manages and optimizes database connection pooling to maintain P95 performance.")
    Component(PostgreSQL_Relational_Engine, "PostgreSQL Relational Engine", "PostgreSQL 15+", "ACID-compliant relational data storage engine.")
    Component(Streaming_Replication_Module, "Streaming Replication Module", "PostgreSQL Module", "Handles replication of data to standby nodes.")
    Component(TDE___SSL_Module, "TDE / SSL Module", "AES-256 / TLS", "Provides Transparent Data Encryption and secure transport encryption.")
    Component(pgAudit, "pgAudit", "PostgreSQL Extension", "Tracks comprehensive DDL/DML for HIPAA and GDPR audit compliance.")
}

Rel(PgBouncer, PostgreSQL_Relational_Engine, "Routes SQL queries over TCP", "SQL/TCP")
Rel(PostgreSQL_Relational_Engine, Streaming_Replication_Module, "Replicates data streams", "")
Rel(PostgreSQL_Relational_Engine, TDE___SSL_Module, "Secures stored data", "")
Rel(PostgreSQL_Relational_Engine, pgAudit, "Logs audit events", "")

@enduml