@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Redis Enterprise Distributed Cache container

Container_Boundary(redis_enterprise_distributed_cache, "Redis Enterprise Distributed Cache") {
    Component(InMemoryDataStoreEngine, "In-Memory Data Store Engine", "C++ core", "Core engine for low-latency in-memory data storage and management.")
    Component(ActiveActiveCRDTSyncModule, "Active-Active CRDT Sync Module", "Conflict-free Replicated Data Types (CRDT)", "Handles cross-region state replication via encrypted TLS mesh.")
    Component(ClusterManagerProxy, "Cluster Manager & Proxy", "Golang proxy", "Manages cluster operations and routes RESP over TLS traffic.")
    Component(SecurityEncryptionEnforcer, "Security & Encryption Enforcer", "OpenSSL", "Enforces security policies and encryption for data access and replication.")
}

System_Ext(ExternalRegionReplicas, "External Region Replicas", "External region replicas for geo-replication")

Rel(ClusterManagerProxy, InMemoryDataStoreEngine, "Routes read/write requests")
Rel(ActiveActiveCRDTSyncModule, ExternalRegionReplicas, "Cross-region state replication via Encrypted TLS Mesh", "Encrypted TLS Mesh")
Rel(SecurityEncryptionEnforcer, ClusterManagerProxy, "Secures communication channels")

@enduml