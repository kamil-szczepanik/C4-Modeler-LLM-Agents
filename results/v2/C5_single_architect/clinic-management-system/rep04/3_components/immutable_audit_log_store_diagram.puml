@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(immutable_audit_log_store, "Immutable Audit Log Store") {
    Component(Audit_Ingestion_API, "Audit Ingestion API", "gRPC", "Ingests streaming audit logs from Apache Kafka via TLS 1.3 gRPC.")
    Component(Log_Normalizer_Enricher, "Log Normalizer & Enricher", "Microservice Processing Engine", "Normalizes and enriches incoming audit log events for compliance.")
    Component(WORM_Storage_Engine, "WORM Storage Engine", "S3 Object Lock / MinIO WORM mode", "Ensures tamper-proof 10-year data retention for HIPAA and GDPR compliance.")
    Component(Retention_Policy_Manager, "Retention Policy Manager", "Policy Enforcement Engine", "Manages the 10-year data retention lifecycle policies.")
    Component(Audit_Query_Interface, "Audit Query Interface", "API / Query Service", "Provides secure access interfaces for querying audit logs.")
    Component(Cryptographic_Verifier_Component, "Cryptographic Verifier Component", "Cryptographic Merkle Tree Verifier", "Performs cryptographic verification using Merkle trees to ensure log integrity.")
}

Rel(Audit_Ingestion_API, Log_Normalizer_Enricher, "Passes raw events for normalization", "gRPC")
Rel(Log_Normalizer_Enricher, WORM_Storage_Engine, "Stores processed logs", "Internal")
Rel(Retention_Policy_Manager, WORM_Storage_Engine, "Enforces retention rules", "Internal")
Rel(Cryptographic_Verifier_Component, WORM_Storage_Engine, "Verifies log integrity and tamper-resistance", "Internal")
Rel(Audit_Query_Interface, WORM_Storage_Engine, "Queries stored logs", "Internal")
@enduml