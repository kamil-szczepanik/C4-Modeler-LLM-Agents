@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing & Integration Service container

System_Ext(Nginx_Envoy_API_Gateway, "Nginx / Envoy API Gateway", "External system")
System_Ext(External_Lab_Imaging_Systems, "External Lab & Imaging Systems", "External system")
System_Ext(Payment_Gateway_Insurance_Clearinghouses, "Payment Gateway & Insurance Clearinghouses", "External system")
System_Ext(Apache_Kafka_Event_Broker, "Apache Kafka Event Broker", "Apache Kafka", "Broker for asynchronous messaging and event distribution.")
System_Ext(PostgreSQL_Primary_Database, "PostgreSQL Primary Database", "PostgreSQL", "Stores encrypted transactional billing data securely.")

Container_Boundary(billing_and_integration_service, "Billing & Integration Service") {
    Component(Billing_Controller, "Billing Controller", "Spring REST Controller", "Handles incoming financial and billing API requests.")
    Component(FHIR_Integration_Camel_Route, "FHIR Integration Camel Route", "Apache Camel", "Executes enterprise integration patterns for HL7 FHIR transformations and exchanges health data.")
    Component(Claim_Processing_Engine, "Claim Processing Engine", "Spring Service", "Processes insurance claims and manages external integrations.")
    Component(Kafka_Event_Consumer, "Kafka Event Consumer", "Spring Kafka Listener", "Consumes billing events from the event broker.")
    Component(Data_Access_Repository, "Data Access Repository", "Spring Data JPA", "Manages database persistence with encryption support for transactional billing data.")
    Component(Circuit_Breaker_Outbound_Gateway, "Circuit Breaker & Outbound Gateway", "Resilience4j", "Implements circuit breaker and retry patterns to protect outbound HTTP calls.")
}

Rel(Nginx_Envoy_API_Gateway, Billing_Controller, "Routes API requests", "gRPC/HTTPS")
Rel(Apache_Kafka_Event_Broker, Kafka_Event_Consumer, "Consumes billing events", "Kafka protocol")
Rel(FHIR_Integration_Camel_Route, External_Lab_Imaging_Systems, "Exchanges health data", "HTTPS (HL7 FHIR)")
Rel(Claim_Processing_Engine, Payment_Gateway_Insurance_Clearinghouses, "Submits claims", "Resilience4j and HTTPS")
Rel(Data_Access_Repository, PostgreSQL_Primary_Database, "Persists records", "JDBC with AES-256")

@enduml