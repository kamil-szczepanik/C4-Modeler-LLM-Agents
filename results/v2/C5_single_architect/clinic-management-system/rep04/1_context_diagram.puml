@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Clinic Management System

Person(Patients, "Patients", "External actors accessing the web/mobile portal for scheduling and billing.")
Person(ClinicalStaff, "Clinical & Administrative Staff", "Users such as doctors, nurses, and receptionists managing patient care and records.")
System(CMS, "Clinic Management System", "A hybrid healthcare platform managing patient admissions, EMRs, scheduling, and billing, ensuring high availability, strict regulatory compliance, and seamless interoperability for medium-sized hospitals and clinics.")
System_Ext(LabSystems, "Lab & Imaging Systems", "External diagnostic systems integrated for medical tests and imaging results.")
System_Ext(PaymentGateway, "Payment Gateway & Insurance Clearinghouses", "External financial systems processing payments and insurance claims.")

Rel(Patients, CMS, "Accesses portal for scheduling and billing", "HTTPS (TLS 1.3)")
Rel(ClinicalStaff, CMS, "Manages patient care and records with mandatory MFA", "HTTPS (TLS 1.3) with MFA")
Rel(CMS, LabSystems, "Exchanges diagnostic and healthcare data", "RESTful HL7 FHIR APIs over HTTPS")
Rel(CMS, PaymentGateway, "Processes financial transactions and insurance claims", "Secure HTTPS/TLS 1.3")

@enduml