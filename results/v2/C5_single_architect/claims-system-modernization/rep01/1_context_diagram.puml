@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Insurance Claims Modernization

Person(Customers, "Customers", "End users who interact with the system to submit and manage claims.")
Person(Brokers, "Brokers", "Intermediaries who interact with the system on behalf of customers.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal staff who access the platform to review and process claims.")

System_Ext(OnpremisesActiveDirectory, "On-premises Active Directory", "Provides identity and authentication services integrated with the cloud platform.")
System_Ext(LegacyMainframeCOBOLDB2, "Legacy Mainframe (COBOL/DB2)", "The 30-year-old backend system acting as the system of record.")

System_Boundary(InsuranceClaimsModernization, "Insurance Claims Modernization") {
    Container(CustomerPortal, "Customer Portal", "Azure App Service", "Web application hosted on Azure App Service for customer interactions.")
    Container(AdjusterWebApp, "Adjuster Web App", "Azure App Service", "Web application hosted on Azure App Service for claims adjusters.")
    Container(AntiCorruptionLayer, "Anti-Corruption Layer", "Azure Functions", "Service implemented using Azure Functions to isolate mainframe dependencies.")
    ContainerDb(StateDatabase, "State Database", "Azure SQL Database", "Database storing migrated claim data with transactional integrity.")
    Container(AzureEventHubs, "Azure Event Hubs", "Azure Event Hubs", "Messaging system managing asynchronous communication and decoupling.")
}

Rel(Customers, CustomerPortal, "Interacts with the portal to manage claims", "HTTPS/REST")
Rel(Brokers, CustomerPortal, "Interacts with the portal on behalf of customers", "HTTPS/REST")
Rel(ClaimsAdjusters, AdjusterWebApp, "Accesses the web application to process claims", "HTTPS/REST")
Rel(AdjusterWebApp, StateDatabase, "Communicates for data persistence and retrieval", "TDS/TCP")
Rel(AdjusterWebApp, AntiCorruptionLayer, "Requests data from the legacy system", "HTTPS/REST")
Rel(AntiCorruptionLayer, LegacyMainframeCOBOLDB2, "Retrieves legacy data", "HTTPS/REST")
Rel(InsuranceClaimsModernization, LegacyMainframeCOBOLDB2, "Integrates asynchronously to update records", "AMQP/Azure Event Hubs")
Rel(InsuranceClaimsModernization, OnpremisesActiveDirectory, "Authenticates users", "OIDC/OAuth2")

@enduml