@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Insurance Claims Modernization

Person(Customers, "Customers", "External users submitting claims online.")
Person(Brokers, "Brokers", "External users submitting claims online.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal users handling claims via the web application.")

System_Ext(ActiveDirectory, "Active Directory", "On-premises identity provider for Single Sign-On.")
System_Ext(LegacyMainframe, "Legacy Mainframe", "On-premises COBOL/DB2 system of record.")

System_Boundary(InsuranceClaimsModernization, "Insurance Claims Modernization") {
    Container(APIGateway, "API Gateway", "Azure Front Door / App Gateway", "Managing HTTPS routing.")
    Container(CustomerPortal, "Customer Portal", "React SPA on Azure Static Web Apps", "Modern UI delivery for customer interactions.")
    Container(AdjusterWorkspace, "Adjuster Workspace", "Node.js Backend-for-Frontend on Azure App Service", "Backend-for-Frontend handling adjuster workflows.")
    Container(ClaimsCoreEngine, "Claims Core Engine", "Java Spring Boot on Azure Container Apps", "Robust domain logic for claims processing.")
    Container(IntegrationLayer, "Integration Layer", "Azure Event Hubs with Apache Camel", "Low operational overhead and protocol translation.")
    ContainerDb(MigratedClaimsDatabase, "Migrated Claims Database", "Azure Database for PostgreSQL", "Transactional consistency for claims data.")
}

Rel(Customers, CustomerPortal, "Submitting claims online", "HTTPS")
Rel(Brokers, CustomerPortal, "Submitting claims online", "HTTPS")
Rel(ClaimsAdjusters, AdjusterWorkspace, "Handling claims", "HTTPS")
Rel(CustomerPortal, APIGateway, "Routing requests", "HTTPS using OpenID Connect")
Rel(AdjusterWorkspace, APIGateway, "Routing requests", "HTTPS using OpenID Connect")
Rel(APIGateway, AdjusterWorkspace, "Routing requests", "HTTPS")
Rel(AdjusterWorkspace, ClaimsCoreEngine, "Communicating for claims processing", "gRPC")
Rel(ClaimsCoreEngine, MigratedClaimsDatabase, "Persisting claims data", "JDBC over TLS")
Rel(ClaimsCoreEngine, IntegrationLayer, "Synchronizing events", "Apache Camel and Azure Event Hubs")
Rel(LegacyMainframe, IntegrationLayer, "Synchronizing records", "Apache Camel and Azure Event Hubs")
Rel(APIGateway, ActiveDirectory, "Authenticating users", "OpenID Connect")

@enduml