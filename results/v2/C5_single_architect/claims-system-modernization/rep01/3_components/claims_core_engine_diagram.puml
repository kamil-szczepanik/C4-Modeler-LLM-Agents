@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Core Engine container

Person(Adjuster_Workspace, "Adjuster Workspace", "External system interacting with the core engine")
System_Ext(Migrated_Claims_Database, "Migrated Claims Database", "Modern database storage")
System_Ext(Integration_Layer, "Integration Layer", "Azure Event Hubs integration layer")

Container_Boundary(Claims_Core_Engine, "Claims Core Engine") {
    Component(Claim_Domain_Service, "Claim Domain Service", "Java/Spring", "Encapsulates core claims processing business logic using Domain-Driven Design.")
    Component(Adapter_Router, "Adapter Router", "Java/Spring Integration", "Dynamically routes requests between the modern database and legacy mainframe.")
    Component(Anti_Corruption_Layer_ACL, "Anti-Corruption Layer (ACL)", "Java / Resilience4j", "Translates data models and insulates the system from mainframe latency and schema quirks.")
    Component(Event_Publisher_Component, "Event Publisher Component", "Apache Camel", "Handles asynchronous event dispatching for dual-run state synchronization.")
}

Rel(Adjuster_Workspace, Claim_Domain_Service, "Executes commands and reads claims data", "gRPC")
Rel(Claim_Domain_Service, Migrated_Claims_Database, "Persists modern claim records", "JDBC over TLS")
Rel(Claim_Domain_Service, Adapter_Router, "Delegates legacy fallback calls", "in-process Java method calls")
Rel(Adapter_Router, Anti_Corruption_Layer_ACL, "Transforms data structures for legacy compatibility", "Java")
Rel(Anti_Corruption_Layer_ACL, Integration_Layer, "Synchronizes events and bridges mainframe data", "AMQP over Azure Event Hubs")

@enduml