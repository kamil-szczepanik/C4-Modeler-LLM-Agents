@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Routing_and_SSL_Termination, "Routing & SSL Termination", "Azure Front Door / Azure Application Gateway", "Secures ingress, terminates SSL, and routes hybrid boundary traffic.")
    Component(Authentication_and_Authorization_Component, "Authentication & Authorization Component", "Azure Active Directory / OpenID Connect", "Validates incoming tokens and implements centralized Single Sign-On.")
    Component(Token_Exchange_and_Transformation, "Token Exchange & Transformation", "Internal Gateway Service", "Transforms and passes validated requests internally.")
}

Rel(Routing_and_SSL_Termination, Authentication_and_Authorization_Component, "Validates incoming tokens", "HTTPS / OIDC")
Rel(Routing_and_SSL_Termination, Token_Exchange_and_Transformation, "Passes validated requests", "Internal HTTP/2")

@enduml