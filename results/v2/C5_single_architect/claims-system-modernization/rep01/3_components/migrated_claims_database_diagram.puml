@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Migrated Claims Database container

Container_Boundary(migrated_claims_database, "Migrated Claims Database") {
    Component(Claim Aggregate Store, "Claim Aggregate Store", "PostgreSQL tables with JSONB", "Persists claims data for flexible claim types and transactional consistency.")
    Component(Migration Sync Ledger, "Migration Sync Ledger", "PostgreSQL relational tables", "Manages sync state during the hybrid migration phase.")
    Component(Audit & Fallback Log, "Audit & Fallback Log", "PostgreSQL append-only tables", "Provides append-only logging for audit trails and rapid rollbacks.")
    Component(Outbox Event Publisher, "Outbox Event Publisher", "PostgreSQL Debezium / Logical Decoding", "Implements the Transactional Outbox pattern for reliable asynchronous event publishing.")
}

System_Ext(Claims Core Engine, "Claims Core Engine", "Java Spring Boot on Azure Container Apps")
System_Ext(Integration Layer, "Integration Layer", "Azure Event Hubs with Apache Camel")

Rel(Claims Core Engine, Claim Aggregate Store, "Persisting claims data", "JDBC over TLS")
Rel(Claims Core Engine, Migration Sync Ledger, "Managing sync state", "JDBC over TLS")
Rel(Outbox Event Publisher, Integration Layer, "Publishing domain events", "AMQP over TLS")

@enduml