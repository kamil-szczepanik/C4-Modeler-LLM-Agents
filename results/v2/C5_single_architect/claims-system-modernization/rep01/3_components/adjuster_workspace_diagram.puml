@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Adjuster Workspace container

Container_Boundary("Adjuster Workspace", "Adjuster Workspace") {
    Component("Routing Controller", "Routing Controller", "Express.js", "Handles lightweight routing and fast I/O handling for the web interface.")
    Component("Workflow Orchestrator", "Workflow Orchestrator", "Node.js", "Orchestrates UI workflows, uses local caching and asynchronous integration adapters to guarantee sub-2-second UI load times.")
    Component("Engine Client", "Engine Client", "gRPC / Protobuf", "Enables high-performance, low-latency synchronous communication with the Claims Core Engine.")
    Component("Event Publisher", "Event Publisher", "Azure Event Hubs SDK", "Facilitates scalable, asynchronous event streaming and decoupled messaging.")
    Component("Integration Adapter", "Integration Adapter", "Apache Camel / Node SDK", "Handles asynchronous in-process dispatch to publish/subscribe messaging.")
}

System_Ext("Claims Core Engine", "Claims Core Engine", "External system")
System_Ext("Integration Layer", "Integration Layer", "External system")

Rel("Routing Controller", "Workflow Orchestrator", "In-process function calls", "HTTPS / OpenID Connect")
Rel("Workflow Orchestrator", "Engine Client", "Remote procedure calls", "gRPC")
Rel("Engine Client", "Claims Core Engine", "Secure remote procedure calls", "gRPC over TLS")
Rel("Workflow Orchestrator", "Integration Adapter", "Asynchronous in-process dispatch", "Internal")
Rel("Integration Adapter", "Integration Layer", "Publish/subscribe messaging", "AMQP / Azure Event Hubs")

@enduml