@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Customer Portal container

System_Ext(azure_active_directory, "Azure Active Directory", "Cloud-based identity and access management service.")
System_Ext(api_gateway, "API Gateway", "Azure Front Door / App Gateway providing secure routing and entry point.")

Container_Boundary(customer_portal, "Customer Portal") {
    Component(Authentication_Module, "Authentication Module", "MSAL.js", "Implements single sign-on authentication via OIDC/OAuth2 to meet security requirements.")
    Component(Claim_Submission_Form, "Claim Submission Form", "Formik/Yup", "Handles online claim submission inputs and validation.")
    Component(Claim_Status_Tracker, "Claim Status Tracker", "React Component", "Polls for updates via HTTPS/REST to track claim statuses.")
    Component(API_Client_Layer, "API Client Layer", "Axios", "Manages HTTP requests, responses, and interceptors for routing requests.")
}

Rel(Authentication_Module, azure_active_directory, "Authenticates users", "OIDC/OAuth2")
Rel(Claim_Submission_Form, API_Client_Layer, "Sends claim data")
Rel(Claim_Status_Tracker, api_gateway, "Polling for updates", "HTTPS/REST")
Rel(API_Client_Layer, api_gateway, "Routing requests", "HTTPS using OpenID Connect")

@enduml