@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Integration_Layer", "Integration Layer") {
    Component(Routing_Mediator, "Routing Mediator", "Apache Camel", "Routes claim events and orchestrates message flow within the integration layer.")
    Component(Protocol_Translator, "Protocol Translator", "Java / Apache Camel", "Transforms payloads and maps canonical events to legacy schemas.")
    Component(Idempotency_Replay_Manager, "Idempotency & Replay Manager", "Azure Redis Cache", "Provides state storage for idempotency, ensuring zero data loss during nightly batch windows.")
    Component(Mainframe_ACL, "Mainframe ACL", "Integration Layer / Mainframe ACL", "Anti-Corruption Layer that interfaces directly with the legacy mainframe system.")
}

Rel(Routing_Mediator, Protocol_Translator, "Transforms payload for legacy", "In-memory Camel EIP")
Rel(Protocol_Translator, Mainframe_ACL, "Maps canonical events to legacy schemas", "Java / Apache Camel")

@enduml