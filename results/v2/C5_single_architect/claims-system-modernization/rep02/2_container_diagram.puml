@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Insurance Claims Modernization Platform

Person(CustomersBrokers, "Customers & Brokers", "External users submitting claims online.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal users managing claims via the new web application.")

System_Ext(ActiveDirectory, "Active Directory", "Enterprise identity provider for authentication.")
System_Ext(LegacyMainframe, "Legacy Mainframe", "On-premises COBOL/DB2 system of record.")
System_Ext(AzureServiceBus, "Azure Service Bus", "Enterprise messaging middleware for decoupled communication.")

System_Boundary(InsuranceClaimsModernizationPlatform, "Insurance Claims Modernization Platform") {
    Container(CustomerPortal, "Customer Portal", "Vue.js/React, Azure Static Web Apps", "Frontend for online claim submissions.")
    Container(AdjusterWorkspace, "Adjuster Workspace", "Node.js/Java BFF, Azure App Service", "Application handling claims processing for adjusters.")
    Container(MigrationRouter, "Migration Router", "Azure Container Apps", "Anti-corruption layer for dynamic claim routing and rollbacks.")
    Container(ClaimsCoreAPI, "Claims Core API", "Azure Container Apps, Azure SQL", "Microservices backed by transactional storage for migrated claims.")
    Container(IntegrationGatewaySyncWorker, "Integration Gateway & Sync Worker", "Azure Functions", "Handles mainframe mediation and batch reconciliation.")
}

Rel(CustomersBrokers, CustomerPortal, "Claim submission", "HTTPS")
Rel(ClaimsAdjusters, AdjusterWorkspace, "Claim processing with SSO", "HTTPS / Active Directory SSO")
Rel(CustomerPortal, MigrationRouter, "Routes claim requests", "HTTPS/REST")
Rel(AdjusterWorkspace, MigrationRouter, "Routes claim requests", "HTTPS/REST")
Rel(MigrationRouter, ClaimsCoreAPI, "Internal communication for migrated claims", "Internal REST/gRPC")
Rel(MigrationRouter, IntegrationGatewaySyncWorker, "Mediates legacy mainframe requests", "HTTPS/SOAP")
Rel(IntegrationGatewaySyncWorker, LegacyMainframe, "Data synchronization and batch processing", "DB2/Batch protocols")
Rel(AdjusterWorkspace, ActiveDirectory, "Authentication", "HTTPS")

@enduml