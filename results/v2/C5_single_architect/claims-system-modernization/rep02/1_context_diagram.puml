@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers__Brokers, "Customers & Brokers", "External users submitting claims online.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal users managing claims via the new web application.")

System(Insurance_Claims_Modernization_Platform, "Insurance Claims Modernization Platform", "Modern cloud system hosted in Azure West Europe gradually replacing a 30-year-old COBOL/DB2 mainframe claims system using a hybrid cloud architecture.")

System_Ext(Active_Directory, "Active Directory", "Enterprise identity provider for authentication.")
System_Ext(Legacy_Mainframe, "Legacy Mainframe", "On-premises COBOL/DB2 system of record.")
System_Ext(Azure_Service_Bus, "Azure Service Bus", "Enterprise messaging middleware for decoupled communication.")

Rel(Customers__Brokers, Insurance_Claims_Modernization_Platform, "Online claim submission", "HTTPS")
Rel(Claims_Adjusters, Insurance_Claims_Modernization_Platform, "Claim processing and adjuster UI", "HTTPS")
Rel(Insurance_Claims_Modernization_Platform, Active_Directory, "Single Sign-On authentication", "SAML/OIDC over HTTPS")
Rel(Insurance_Claims_Modernization_Platform, Legacy_Mainframe, "Data synchronization via messaging and Anti-Corruption Layer", "AMQP/HTTPS")
Rel(Legacy_Mainframe, Insurance_Claims_Modernization_Platform, "Data synchronization via messaging and Anti-Corruption Layer", "AMQP/HTTPS")

@enduml