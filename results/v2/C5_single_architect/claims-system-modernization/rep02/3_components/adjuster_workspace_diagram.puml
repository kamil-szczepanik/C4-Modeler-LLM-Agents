@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Adjuster Workspace container

System_Ext(MigrationRouter, "Migration Router", "Legacy backend routing system")

Container_Boundary(AdjusterWorkspace, "Adjuster Workspace") {
    Component(UIControllerBFFRouter, "UI Controller / BFF Router", "Node.js/Express", "Lightweight handling of HTTP requests, routing, and session management.")
    Component(ClaimsPresentationService, "Claims Presentation Service", "TypeScript/React", "Type-safe rendering of adjuster user interface views.")
    Component(LocalCacheReadModel, "Local Cache & Read Model", "Azure Cache for Redis", "In-memory storage for materialized views to bypass slow legacy latency.")
    Component(SyncConsumer, "Sync Consumer", "Node.js worker", "Asynchronous background processing for cache synchronization via Azure Service Bus.")
    Component(MainframeAdapterComponent, "Mainframe Adapter Component", "Node.js client module", "Adapts and communicates with legacy backend services.")
}

Rel(UIControllerBFFRouter, ClaimsPresentationService, "In-memory / Function call")
Rel(ClaimsPresentationService, LocalCacheReadModel, "TCP / Redis Protocol")
Rel(SyncConsumer, LocalCacheReadModel, "TCP / Redis Protocol")
Rel(UIControllerBFFRouter, MainframeAdapterComponent, "In-process")
Rel(MainframeAdapterComponent, MigrationRouter, "HTTPS / REST")

@enduml