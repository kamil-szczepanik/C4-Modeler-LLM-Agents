@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Gateway & Sync Worker container

System_Ext(LegacyMainframe, "Legacy Mainframe", "COBOL/DB2")
System_Ext(AzureServiceBus, "Azure Service Bus", "Message Broker")

Container_Boundary(IntegrationGatewaySyncWorker, "Integration Gateway & Sync Worker") {
    Component(MainframeAdapterComponent, "Mainframe Adapter Component", "C# Azure Functions", "Forwards unmigrated claim traffic to legacy endpoints.")
    Component(SyncOrchestratorComponent, "Sync Orchestrator Component", "Azure Durable Functions", "Manages bulk data synchronization and batch reconciliation.")
    Component(OutboxProcessorComponent, "Outbox Processor Component", "C# Azure Functions", "Publishes transactional messages to the message broker.")
    Component(CircuitBreakerFallbackHandlerComponent, "Circuit Breaker & Fallback Handler Component", "C# Azure Functions", "Delegates outbound legacy calls with resilience policies.")
}

Rel(MainframeAdapterComponent, CircuitBreakerFallbackHandlerComponent, "Delegates outbound legacy calls", "HTTPS/SOAP")
Rel(OutboxProcessorComponent, AzureServiceBus, "Publishes transactional messages", "AMQP")
Rel(CircuitBreakerFallbackHandlerComponent, LegacyMainframe, "Invokes legacy endpoints with resilience policies", "HTTPS/SOAP")
Rel(SyncOrchestratorComponent, LegacyMainframe, "Bulk data synchronization and batch reconciliation", "DB2 Direct / SFTP")

@enduml