@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Migration Router container

Container_Boundary(migration_router, "Migration Router") {
    Component(Routing_Controller, "Routing Controller", "Spring Boot/Java", "Evaluates incoming claim types against the routing registry.")
    Component(Feature_Flag_Manager, "Feature Flag Manager", "Redis Cache", "Enables instant fallback switchbacks to the mainframe within one day.")
    Component(ACL_Mapper, "ACL Mapper", "MapStruct", "Translates modern JSON payloads to legacy formats.")
    Component(Audit_Failover_Logger, "Audit & Failover Logger", "Azure Cosmos DB", "Captures failed routing decisions and transient timeouts.")
}

Container(Claims_Core_API, "Claims Core API", "Azure Services", "Modern backend services handling migrated claim types.")
Container(Integration_Gateway_Sync_Worker, "Integration Gateway & Sync Worker", "Legacy Connector", "Mediates legacy mainframe requests.")

Rel(Routing_Controller, Feature_Flag_Manager, "Queries active routing rules", "In-process/Jedis")
Rel(Routing_Controller, ACL_Mapper, "Transforms unrouted payloads", "In-process")
Rel(Routing_Controller, Claims_Core_API, "Forwards migrated types", "gRPC over HTTP/2")
Rel(Routing_Controller, Audit_Failover_Logger, "Records routing telemetry and fallback events", "gRPC/Queue")
Rel(Routing_Controller, Integration_Gateway_Sync_Worker, "Mediates legacy mainframe requests", "HTTPS/SOAP")

@enduml