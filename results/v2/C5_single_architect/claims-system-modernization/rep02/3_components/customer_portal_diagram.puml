@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Customers_Brokers, "Customers & Brokers", "Users submitting insurance claims online.")
System_Ext(Active_Directory, "Active Directory", "Authenticates users via OIDC/OAuth2.")
Container(Migration_Router, "Migration Router", "Hybrid Cloud Modernization Platform", "Routes claim requests to downstream systems.")

Container_Boundary(Customer_Portal, "Customer Portal") {
    Component(Claim_Submission_UI, "Claim Submission UI", "Vue.js/React, Azure Static Web Apps", "Renders multi-step claim forms and client-side validation.")
    Component(Authentication_Handler, "Authentication Handler", "OIDC Client Library", "Manages user sessions and JWT tokens.")
    Component(API_Client, "API Client", "Axios/Fetch wrapper", "Manages outgoing HTTP requests with retry interceptors.")
    Component(Local_Session_Cache, "Local Session Cache", "IndexedDB / localStorage", "Persists draft submissions locally.")
}

Rel(Customers_Brokers, Claim_Submission_UI, "Claim submission", "HTTPS")
Rel(Authentication_Handler, Active_Directory, "User authentication", "OIDC/OAuth2")
Rel(API_Client, Migration_Router, "Routes claim requests", "HTTPS/REST")
Rel(Claim_Submission_UI, Local_Session_Cache, "Persists draft data", "Browser API")
Rel(API_Client, Authentication_Handler, "Attaches bearer tokens", "In-Memory/JWT")
@enduml