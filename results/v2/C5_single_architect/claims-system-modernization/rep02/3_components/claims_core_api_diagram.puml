@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Core API container

Container_Boundary(claims_core_api, "Claims Core API") {
    Component(ClaimManagementController, "Claim Management Controller", "Spring MVC", "Spring MVC REST endpoints receiving payloads from the Adjuster Workspace and Migration Router.")
    Component(ClaimDomainService, "Claim Domain Service", "Spring Data Domain Service", "Enforces R-04 consistency constraints using CQRS (Write Model Handler and Read Model Projections).")
    Component(LegacyACL, "Legacy Anti-Corruption Layer (ACL)", "Spring Integration", "Translates domain models for unmigrated claim types.")
    Component(ClaimRepository, "Claim Repository", "Spring Data JPA", "Manages transactional persistence in Azure SQL.")
    Component(EventPublisherComponent, "Event Publisher Component", "Spring Cloud Stream", "Emits domain events to Azure Service Bus.")
}

Rel(ClaimManagementController, ClaimDomainService, "Delegates request processing and payloads")
Rel(ClaimDomainService, ClaimRepository, "JDBC persistence calls", "JDBC")
Rel(ClaimDomainService, LegacyACL, "Internal method delegation for unmigrated types")
Rel(EventPublisherComponent, AzureServiceBus, "Asynchronous event publishing", "AMQP")
@enduml