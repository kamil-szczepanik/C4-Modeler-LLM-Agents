@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer_Broker, "Customer / Broker", "External actors submitting claims online.")
Person(Claims_Adjuster, "Claims Adjuster", "Internal users handling claims via the new web application.")
System(New_Claims_Platform_Azure, "New Claims Platform (Azure)", "Modern cloud platform gradually replacing a legacy COBOL/DB2 mainframe claims system, enabling online claim submission and adjuster workflows.")
System_Ext(Legacy_Mainframe_System_On_Premises, "Legacy Mainframe System (On-Premises)", "30-year-old COBOL/DB2 system of record maintained during the transition period.")
System_Ext(Active_Directory, "Active Directory", "On-premises identity provider used for authentication.")
System_Ext(Integration_Gateway, "Integration Gateway", "Anti-Corruption Layer managing communication boundaries and asynchronous messaging.")

Rel(Customer_Broker, New_Claims_Platform_Azure, "Submits claims online", "HTTPS")
Rel(Claims_Adjuster, New_Claims_Platform_Azure, "Handles claims via adjuster web UI workflows", "HTTPS")
Rel(New_Claims_Platform_Azure, Active_Directory, "Authenticates users via Single Sign-On", "OIDC / SAML")
Rel(New_Claims_Platform_Azure, Legacy_Mainframe_System_On_Premises, "Exchanges claims data asynchronously", "Asynchronous SFTP, file drops, and message queues")
@enduml