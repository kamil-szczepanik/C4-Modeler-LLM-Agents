@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Insurance Claims Modernization

Person(Customer_Broker, "Customer / Broker", "External actors submitting claims online.")
Person(Claims_Adjuster, "Claims Adjuster", "Internal users handling claims.")

System_Ext(Legacy_Mainframe_System, "Legacy Mainframe System", "On-premises COBOL/DB2 system.")
System_Ext(Active_Directory_Integration_Gateway, "Active Directory & Integration Gateway", "On-premises enterprise services and identity provider.")

System_Boundary(Insurance_Claims_Modernization, "Insurance Claims Modernization") {
    Container(Web_App_Portal, "Web App Portal", "React, Azure App Service", "Delivers sub-2s UI loads independently of backend latency.")
    Container(Claims_API_Gateway_BFF, "Claims API Gateway / BFF", ".NET Core, Azure API Management", "Provides robust API orchestration and security.")
    Container(Core_Claims_Service, "Core Claims Service", ".NET Core, Azure Container Apps", "Serverless Kubernetes abstraction mitigating the team's low cloud experience.")
    Container(Integration_Sync_Service, "Integration & Sync Service", "Azure Service Bus, Azure Functions", "Asynchronous messaging guarantees transactional consistency and respects batch windows.")
    Container(Feature_Flag_Routing_Service, "Feature Flag / Routing Service", ".NET Core middleware, Azure App Configuration", "Enables the 1-day rollback requirement per claim type.")
    ContainerDb(Claims_Database, "Claims Database", "Azure SQL Database", "ACID compliance ensures no data loss during incremental migration.")
}

Rel(Customer_Broker, Web_App_Portal, "Accesses portal to submit claims", "HTTPS")
Rel(Claims_Adjuster, Web_App_Portal, "Accesses portal for claim workflows", "HTTPS")
Rel(Web_App_Portal, Claims_API_Gateway_BFF, "Communicates with API gateway", "HTTPS")
Rel(Claims_API_Gateway_BFF, Active_Directory_Integration_Gateway, "Authenticates users via Active Directory", "OIDC/OAuth2")
Rel(Claims_API_Gateway_BFF, Feature_Flag_Routing_Service, "Routes requests dynamically", "gRPC/HTTPS")
Rel(Feature_Flag_Routing_Service, Core_Claims_Service, "Directs claim traffic", "gRPC/HTTPS")
Rel(Feature_Flag_Routing_Service, Integration_Sync_Service, "Directs claim traffic", "gRPC/HTTPS")
Rel(Core_Claims_Service, Claims_Database, "Persists and retrieves data", "TDS/ADO.NET")
Rel(Integration_Sync_Service, Active_Directory_Integration_Gateway, "Communicates with on-premises Integration Gateway", "AMQP and HTTPS")
Rel(Integration_Sync_Service, Legacy_Mainframe_System, "Synchronizes data with legacy system", "AMQP and HTTPS")

@enduml