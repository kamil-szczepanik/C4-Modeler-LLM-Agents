@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Feature Flag / Routing Service container

Container_Boundary(feature_flag_routing_service, "Feature Flag / Routing Service") {
    Component(Routing Engine Component, "Routing Engine Component", ".NET Core", "Dynamically directs claim traffic between a modern Azure platform and an on-premise mainframe.")
    Component(Configuration Cache Component, "Configuration Cache Component", "Azure App Configuration SDK with local JSON fallback", "Provides fast flag evaluation and offline resilience for dynamic rules.")
    Component(Audit & Telemetry Component, "Audit & Telemetry Component", ".NET Core / Application Insights", "Emits telemetry asynchronously and tracks routing audit trails.")
    Component(Circuit Breaker Component, "Circuit Breaker Component", ".NET Polly", "Provides automated circuit breaking and failover.")
}

Component(Claims API Gateway / BFF, "Claims API Gateway / BFF", "External System / BFF", "Invokes routing via gRPC/HTTPS.")
Component(Core Claims Service / Integration & Sync Service, "Core Claims Service / Integration & Sync Service", "External Services", "Receives directed claim traffic via gRPC/HTTPS.")
Component(Legacy Mainframe System, "Legacy Mainframe System", "On-Premise Mainframe", "Receives rerouted traffic on failure via HTTPS.")

Rel(Claims API Gateway / BFF, Routing Engine Component, "Invokes routing", "gRPC/HTTPS")
Rel(Routing Engine Component, Configuration Cache Component, "Reads dynamic rules", "in-memory lookup")
Rel(Routing Engine Component, Audit & Telemetry Component, "Emits telemetry asynchronously", ".NET Channel/Queue")
Rel(Routing Engine Component, Core Claims Service / Integration & Sync Service, "Directs claim traffic", "gRPC/HTTPS")
Rel(Circuit Breaker Component, Legacy Mainframe System, "Reroutes traffic on failure", "HTTPS")

@enduml