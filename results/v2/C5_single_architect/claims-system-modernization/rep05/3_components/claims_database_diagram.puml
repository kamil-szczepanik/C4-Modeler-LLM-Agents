@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Claims_Database", "Claims Database") {
    Component(Claim_Repository_Component, "Claim Repository Component", ".NET Entity Framework Core", "Invokes data access and executes queries against the Azure SQL Storage Engine.")
    Component(Audit_Reconciliation_Component, "Audit & Reconciliation Component", "Azure SQL Stored Procedures/Change Tracking", "Reads state snapshots from the claim repository for audit and reconciliation.")
    Component(Migration_Schema_Versioning_Component, "Migration Schema Versioning Component", "FluentMigrator", "Manages migration schema versioning for the database.")
    Component(Temporal_History_Rollback_Component, "Temporal History & Rollback Component", "Azure SQL System-Versioned Temporal Tables", "Manages row versions and historical data for rollbacks.")
}

Rel(Claim_Repository_Component, Temporal_History_Rollback_Component, "Manages row versions", "In-Process / T-SQL")
Rel(Audit_Reconciliation_Component, Claim_Repository_Component, "Reads state snapshots", "In-Process / LINQ")
@enduml