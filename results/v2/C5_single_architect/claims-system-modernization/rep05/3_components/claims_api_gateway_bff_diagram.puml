@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims API Gateway / BFF container

Person_Ext(WebAppPortal, "Web App Portal", "External web application portal used by adjusters and users.")
System_Ext(ActiveDirectory, "Active Directory", "Enterprise directory providing OIDC/OAuth2 authentication.")
System_Ext(FeatureFlagService, "Feature Flag / Routing Service", "Provides dynamic routing rules via gRPC/HTTPS.")
System_Ext(IntegrationGateway, "Integration Gateway", "Gateway for legacy integration.")
System_Ext(CoreClaimsService, "Core Claims Service", "Modern core claims microservice.")

Container_Boundary(ClaimsAPIGatewayBFF, "Claims API Gateway / BFF") {
    Component(APIRouterComponent, "API Router Component", "Azure API Management / .NET Core", "Handles rate limiting and token validation.")
    Component(BFFOrchestratorComponent, "BFF Orchestrator Component", ".NET Core minimal API on Azure Container Apps", "Handles client data aggregation.")
    Component(RoutingProxyComponent, "Routing Proxy Component", ".NET Core middleware", "Provides dynamic traffic splitting between modern and legacy systems.")
    Component(ResponseCachingTransformationComponent, "Response Caching & Transformation Component", ".NET Core with Azure Cache for Redis", "Performs payload optimization and caching.")
}

Rel(WebAppPortal, APIRouterComponent, "Communicates via HTTPS/JSON", "HTTPS/JSON")
Rel(APIRouterComponent, ActiveDirectory, "Authenticates users via OIDC/OAuth2", "OIDC/OAuth2")
Rel(APIRouterComponent, FeatureFlagService, "Routes requests dynamically via gRPC/HTTPS", "gRPC/HTTPS")
Rel(APIRouterComponent, BFFOrchestratorComponent, "Forwards aggregated requests", "HTTPS")
Rel(APIRouterComponent, RoutingProxyComponent, "Forwards routing requests", "HTTPS")
Rel(BFFOrchestratorComponent, ResponseCachingTransformationComponent, "Uses in-process gRPC/HTTP with Azure Cache for Redis", "gRPC/HTTP")
Rel(RoutingProxyComponent, IntegrationGateway, "Directs traffic via HTTPS", "HTTPS")
Rel(RoutingProxyComponent, CoreClaimsService, "Directs traffic via HTTPS", "HTTPS")

@enduml