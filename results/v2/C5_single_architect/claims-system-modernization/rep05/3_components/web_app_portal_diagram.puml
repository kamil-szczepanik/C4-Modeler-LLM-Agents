@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web App Portal container

System_Ext(ActiveDirectory, "Active Directory", "Identity Provider")
System_Ext(ClaimsApiGatewayBff, "Claims API Gateway / BFF", "Azure API Management")
System_Ext(AzureAppConfig, "Azure App Configuration", "Azure App Configuration Service")

Container_Boundary(WebAppPortal, "Web App Portal") {
    Component(AuthenticationWrapper, "Authentication Wrapper", "MSAL.js", "Authenticates users via SSO using OIDC/OAuth2 against Active Directory.")
    Component(ClaimSubmissionRoutingModule, "Claim Submission & Routing Module", "React SPA", "Enables customers and brokers to submit claims online.")
    Component(AdjusterWorkspaceModule, "Adjuster Workspace Module", "React SPA", "Provides claim workflows for claims adjusters.")
    Component(FeatureFlagClient, "Feature Flag Client", "Azure App Configuration SDK", "Manages dynamic feature toggles and claim-type migrations.")
}

Rel(AuthenticationWrapper, ActiveDirectory, "Authenticates users via SSO", "OIDC/OAuth2")
Rel(ClaimSubmissionRoutingModule, ClaimsApiGatewayBff, "Communicates with backend APIs", "HTTPS/REST")
Rel(AdjusterWorkspaceModule, ClaimsApiGatewayBff, "Communicates with backend APIs", "HTTPS/REST")
Rel(FeatureFlagClient, AzureAppConfig, "Fetches dynamic configurations and feature flags", "HTTPS")

@enduml