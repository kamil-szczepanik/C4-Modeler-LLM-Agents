@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(core_claims_service, "Core Claims Service") {
    Component(ClaimDomainModel, "Claim Domain Model", ".NET Core / C#", "Internal Component: Business logic")
    Component(MainframeAntiCorruptionLayer, "Mainframe Anti-Corruption Layer", ".NET Core / C#", "Internal Component: Format translation")
    Component(OutboxProcessor, "Outbox Processor", ".NET Core / C#", "Internal Component: Reliable message queuing")
    Component(DualWriteSyncCoordinator, "Dual-Write / Sync Coordinator", ".NET Core / C#", "Internal Component: State synchronization")
}

Rel(ClaimDomainModel, MainframeAntiCorruptionLayer, "Delegates unmigrated types", "Internal C# Interface")
Rel(ClaimDomainModel, OutboxProcessor, "Persists events", "EF Core / TDS")

@enduml