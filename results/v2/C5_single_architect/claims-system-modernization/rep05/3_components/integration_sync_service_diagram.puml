@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration & Sync Service container

Container_Boundary("Integration & Sync Service", "Integration & Sync Service") {
    Component("Sync Orchestrator Function", "Sync Orchestrator Function", ".NET 8 isolated durable functions", "Coordinating claim state synchronization.")
    Component("Mainframe Adapter Component", "Mainframe Adapter Component", ".NET 8 component", "Managing protocol translation.")
    Component("Outbox Event Publisher", "Outbox Event Publisher", ".NET 8 component", "Consuming Azure Service Bus topics.")
    Component("Idempotency & Deduplication Filter", "Idempotency & Deduplication Filter", ".NET 8 middleware", "Validating message uniqueness against Azure SQL.")
}

System_Ext("Integration Gateway", "Integration Gateway", "On-premises gateway interfacing with the legacy mainframe.")

Rel("Sync Orchestrator Function", "Outbox Event Publisher", "Dispatches messages", "Azure Service Bus [AMQP]")
Rel("Sync Orchestrator Function", "Idempotency & Deduplication Filter", "Validates message uniqueness", "In-memory / gRPC")
Rel("Mainframe Adapter Component", "Integration Gateway", "Sends transactional payloads", "HTTPS [REST/JSON] using mutual TLS (mTLS)")

@enduml