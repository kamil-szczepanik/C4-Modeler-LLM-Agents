@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Azure Service Bus", "Azure Service Bus") {
    Component("Claim Submission Topic", "Claim Submission Topic", "Azure Service Bus Topic", "Receives published claim events from the Migration Router via AMQP/TLS and handles routing filter rules.")
    Component("Mainframe Relay Queues", "Mainframe Relay Queues", "Azure Service Bus Queue", "Queues messages to forward them to the Mainframe Integration Adapter via AMQP/HTTPS.")
    Component("Dead-Letter Subsystems", "Dead-Letter Subsystems", "Azure Service Bus Dead-Letter Queue", "Captures and isolates undeliverable messages to ensure zero data loss requirements (R-04).")
    Component("Routing Filter Rules", "Routing Filter Rules", "Azure Service Bus Filters", "Evaluates and directs messages to appropriate downstream queues based on claim type and migration status.")
}

Rel("Claim Submission Topic", "Mainframe Relay Queues", "Forwards messages")
Rel("Claim Submission Topic", "Dead-Letter Subsystems", "Routes failed messages")
Rel("Routing Filter Rules", "Claim Submission Topic", "Applies routing logic")
@enduml