@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer / Broker", "External user submitting claims")
Person(Adjuster, "Claims Adjuster", "Internal user handling claims")

System_Ext(ActiveDirectory, "Active Directory", "Enterprise identity provider")
System_Ext(ApiGateway, "API Gateway / BFF", "Backend for Frontend / API Gateway")

Container_Boundary(ClaimsWebApp, "Claims Web Application") {
    Component(ClaimSubmissionModule, "Claim Submission Module", "React", "React wizard-style forms for online submissions.")
    Component(AdjusterDashboard, "Adjuster Dashboard & Case Workspace", "React", "React UI for claims handling.")
    Component(OptimisticUi, "Optimistic UI / Cache State Manager", "Redux Toolkit / React Query", "Local data caching and state management.")
    Component(AuthClient, "Auth Client", "MSAL.js", "Manages OIDC/OAuth2 tokens for Azure Active Directory SSO.")
    Component(OfflineDraftStorage, "Offline Draft Storage", "React / IndexedDB via Dexie.js", "Persistent local draft saves and offline resilience.")
}

Rel(Customer, ClaimSubmissionModule, "Interacts via", "HTTPS")
Rel(Adjuster, AdjusterDashboard, "Interacts via", "HTTPS")

Rel(ClaimSubmissionModule, OptimisticUi, "Updates state via", "")
Rel(AdjusterDashboard, OptimisticUi, "Fetches and updates data via", "")
Rel(AuthClient, ActiveDirectory, "Authenticate via", "OIDC/OAuth2")

Rel(ClaimSubmissionModule, ApiGateway, "Interacts via", "HTTPS/REST")
Rel(AdjusterDashboard, ApiGateway, "Interacts via", "HTTPS/REST")
@enduml