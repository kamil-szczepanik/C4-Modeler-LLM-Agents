@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Mainframe Integration Adapter container

System_Ext(LegacyMainframe, "Legacy Mainframe (COBOL/DB2)", "Legacy mainframe system.")
System_Ext(AzureServiceBus, "Azure Service Bus", "Asynchronous messaging for decoupling systems.")
System_Ext(AzureSqlDatabase, "Azure SQL Managed Instance", "Relational database for state and audit logging.")

Container_Boundary(MainframeIntegrationAdapter, "Mainframe Integration Adapter") {
    Component(MessageListener, "Message Listener Component", ".NET Background Service", "Listens for asynchronous messages from Azure Service Bus.")
    Component(TranslationEngine, "Translation & Mapping Engine", "AutoMapper, C# Domain Logic", "Transforms payloads between modern formats and legacy copybooks.")
    Component(LegacyClient, "Legacy Protocol Client", "IBM MQ .NET Client", "Handles communication with the legacy mainframe using TCP/IBM MQ.")
    Component(ResiliencyComponent, "Resiliency & Circuit Breaker Component", "Polly", "Provides resilience and circuit breaking for fault tolerance.")
    Component(AuditLogger, "Audit & Reconciliation Logger", "Entity Framework Core", "Logs audits and reconciliation data to the database.")
}

Rel(AzureServiceBus, MessageListener, "Receives messages", "AMQP")
Rel(MessageListener, TranslationEngine, "Passes messages for transformation", "In-memory")
Rel(TranslationEngine, LegacyClient, "Sends mapped requests", "In-memory")
Rel(LegacyClient, LegacyMainframe, "Communicates via TCP/IBM MQ", "TCP/IBM MQ")
Rel(TranslationEngine, AuditLogger, "Sends execution details", "In-memory")
Rel(AuditLogger, AzureSqlDatabase, "Persists logs via T-SQL", "T-SQL")
@enduml