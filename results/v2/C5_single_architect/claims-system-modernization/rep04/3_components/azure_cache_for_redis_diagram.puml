@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Azure Cache for Redis", "Azure Cache for Redis") {
    Component("Redis Cache Engine", "Redis Cache Engine", "Azure Cache for Redis", "In-memory data store engine providing high-throughput and low-latency access for performance optimization.")
    Component("Distributed Output Cache Provider", "Distributed Output Cache Provider", ".NET Core Distributed Caching", "Provides distributed output caching support to accelerate response times across API endpoints.")
    Component("Claim State Cache Manager", "Claim State Cache Manager", ".NET Core Caching Service", "Manages transient claim state caching to ensure fast retrieval during active adjuster workflows.")
}

Rel("Distributed Output Cache Provider", "Redis Cache Engine", "Reads and writes cached HTTP outputs via RESP over TCP/TLS", "RESP over TCP/TLS")
Rel("Claim State Cache Manager", "Redis Cache Engine", "Stores and invalidates claim session states via RESP over TCP/TLS", "RESP over TCP/TLS")
@enduml