@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Migration Router / Anti-Corruption Layer container

System_Ext(ApiGateway_BFF, "API Gateway / BFF", "External BFF system")
System_Ext(MainframeIntegrationAdapter, "Mainframe Integration Adapter", "External legacy integration adapter")
System_Ext(Database, "Database", "Modern platform claims data store")

Container_Boundary(MigrationRouterACL, "Migration Router / Anti-Corruption Layer") {
    Component(ClaimRoutingEngine, "Claim Routing Engine", ".NET Core / C#", "Evaluates incoming claims to determine target processing pathways.")
    Component(TranslationService, "Translation Service", ".NET Core / C#", "Translates domain models to legacy COBOL-compatible formats.")
    Component(DualWriteReconciliationManager, "Dual-Write & Reconciliation Manager", ".NET Core / C#", "Prevents double-processing and guarantees transactional consistency.")
    Component(FallbackFeatureFlagManager, "Fallback & Feature Flag Manager", "Azure App Configuration / .NET Core", "Handles dynamic routing rules and rapid rollback configurations.")
}

Rel(ApiGateway_BFF, ClaimRoutingEngine, "Sends claims", "HTTPS/REST")
Rel(ClaimRoutingEngine, TranslationService, "Invokes translation", "In-Process")
Rel(ClaimRoutingEngine, FallbackFeatureFlagManager, "Checks rules", "In-Process")
Rel(TranslationService, MainframeIntegrationAdapter, "Sends legacy messages", "AMQP via Azure Service Bus")
Rel(DualWriteReconciliationManager, Database, "Persists data", "TDS")

@enduml