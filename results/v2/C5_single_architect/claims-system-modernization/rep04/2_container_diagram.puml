@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Insurance Claims Modernization Platform

Person(Customers_and_Brokers, "Customers & Brokers", "External users submitting claims online.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal staff handling claims workflows.")

System_Ext(Legacy_Mainframe_COBOL_DB2, "Legacy Mainframe (COBOL/DB2)", "On-premise legacy system of record.")
System_Ext(Active_Directory, "Active Directory", "Identity Provider for authentication.")

System_Boundary(Insurance_Claims_Modernization_Platform, "Insurance Claims Modernization Platform") {
    Container(Claims_Web_Application, "Claims Web Application", "React, Azure Static Web Apps", "Modern web frontend for online claim submission and adjuster workflows.")
    Container(API_Gateway_BFF, "API Gateway / BFF", "Azure Container Apps, .NET Core", "Backend for frontend handling client requests and routing.")
    Container(Migration_Router_Anti_Corruption_Layer, "Migration Router / Anti-Corruption Layer", "Azure Container Apps, .NET Core", "Isolates legacy mainframe constraints and routes incremental claim migrations.")
    Container(Mainframe_Integration_Adapter, "Mainframe Integration Adapter", "Azure Container Apps, .NET Core", "Adapts modern messages for legacy mainframe integration.")
    Container(Azure_Service_Bus, "Azure Service Bus", "Messaging Container", "Decouples systems and buffers messages.")
    Container(Azure_Cache_for_Redis, "Azure Cache for Redis", "Caching Container", "Caches slow data for sub-2s adjuster screen loads.")
    ContainerDb(Database, "Database", "Azure SQL Managed Instance", "Stores modern claim data with strong consistency guarantees.")
}

Rel(Customers_and_Brokers, Claims_Web_Application, "interact with", "HTTPS")
Rel(Claims_Adjusters, Claims_Web_Application, "interact with", "HTTPS")
Rel(Claims_Web_Application, API_Gateway_BFF, "interacts with", "HTTPS/REST")
Rel(API_Gateway_BFF, Azure_Cache_for_Redis, "interacts with", "RESP")
Rel(API_Gateway_BFF, Migration_Router_Anti_Corruption_Layer, "interacts with", "HTTPS/REST")
Rel(Migration_Router_Anti_Corruption_Layer, Database, "interacts with", "TDS")
Rel(Migration_Router_Anti_Corruption_Layer, Azure_Service_Bus, "interacts with", "AMQP/HTTPS")
Rel(Azure_Service_Bus, Mainframe_Integration_Adapter, "interacts with", "AMQP/HTTPS")
Rel(Mainframe_Integration_Adapter, Legacy_Mainframe_COBOL_DB2, "interacts with", "TCP/MQ or SFTP")
Rel(Claims_Web_Application, Active_Directory, "authenticate against", "OIDC/OAuth2")
Rel(API_Gateway_BFF, Active_Directory, "authenticate against", "OIDC/OAuth2")

@enduml