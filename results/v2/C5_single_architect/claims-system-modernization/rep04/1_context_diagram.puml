@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers_Brokers, "Customers & Brokers", "External users submitting claims online via web interfaces.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal staff handling claims via the new web application.")

System(Insurance_Claims_Modernization_Platform, "Insurance Claims Modernization Platform", "A hybrid microservices platform deployed on Azure West Europe that gradually replaces a legacy COBOL/DB2 mainframe system, enabling online claim submission and adjuster workflows.")

System_Ext(Legacy_Mainframe_COBOL_DB2, "Legacy Mainframe (COBOL/DB2)", "On-premises system of record.")
System_Ext(Active_Directory, "Active Directory", "Enterprise identity provider for authentication.")
System_Ext(Azure_API_Management, "Azure API Management", "Integration gateway acting as an anti-corruption layer.")
System_Ext(Payment_Gateway, "Payment Gateway", "External supporting system for payment processing.")
System_Ext(Document_Management_System, "Document Management System", "On-premises supporting system for document handling.")

Rel(Customers_Brokers, Insurance_Claims_Modernization_Platform, "interact with the Modernization Platform for claim submission", "HTTPS")
Rel(Claims_Adjusters, Insurance_Claims_Modernization_Platform, "access the Modernization Platform for claim management", "HTTPS")
Rel(Insurance_Claims_Modernization_Platform, Active_Directory, "authenticates users against Active Directory", "OpenID Connect / SAML")
Rel(Insurance_Claims_Modernization_Platform, Legacy_Mainframe_COBOL_DB2, "integrates with the Legacy Mainframe via asynchronous messaging and batch interfaces", "Asynchronous Messaging / Batch")
Rel(Insurance_Claims_Modernization_Platform, Payment_Gateway, "connects to the Payment Gateway", "HTTPS / REST")
Rel(Insurance_Claims_Modernization_Platform, Document_Management_System, "connects to the Document Management System", "gRPC")

@enduml