@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer___Broker, "Customer / Broker", "External actors submitting claims online.")
Person(Claims_Adjuster, "Claims Adjuster", "Internal users handling claims via the new web application.")

System(Modern_Claims_Platform, "Modern Claims Platform", "Azure-hosted system replacing a 30-year-old COBOL/DB2 mainframe to enable online claims submission and adjuster workflows while ensuring continuous legacy operation and strict data consistency.")

System_Ext(Legacy_Mainframe, "Legacy Mainframe", "On-premises COBOL/DB2 system of record.")
System_Ext(Anti_Corruption_Layer__ACL_, "Anti-Corruption Layer (ACL)", "Isolation layer mitigating mainframe schema volatility.")
System_Ext(Identity_Provider, "Identity Provider", "Insurer Active Directory / Azure AD handling authentication.")

Rel(Customer___Broker, Modern_Claims_Platform, "Claim submission", "HTTPS/REST")
Rel(Claims_Adjuster, Modern_Claims_Platform, "Web application access under 2s", "HTTPS")
Rel(Modern_Claims_Platform, Anti_Corruption_Layer__ACL_, "Internal communication for claims data sync", "Internal REST/Messaging")
Rel(Anti_Corruption_Layer__ACL_, Legacy_Mainframe, "Asynchronous state synchronization", "HTTPS/REST and MQ")
Rel(Modern_Claims_Platform, Identity_Provider, "Single Sign-On authentication", "OpenID Connect / SAML")

@enduml