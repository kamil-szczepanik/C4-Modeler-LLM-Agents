@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Routing_Engine, "Routing Engine", ".NET YARP", "Handles incoming API requests and directs them to appropriate backend services.")
    Component(Authentication_Authorization_Filter, "Authentication & Authorization Filter", ".NET Middleware", "Validates user tokens and secures API routes.")
    Component(Rate_Limiting_Resiliency_Policy_Middleware, "Rate Limiting & Resiliency Policy Middleware", ".NET Polly", "Applies rate limiting and transient fault handling policies for slow responses.")
    Component(Transformation_Protocol_Bridge, "Transformation & Protocol Bridge", ".NET Core", "Translates and bridges protocols between incoming requests and backend services.")
}

Rel(Routing_Engine, Transformation_Protocol_Bridge, "Passes raw requests", "In-memory")

@enduml