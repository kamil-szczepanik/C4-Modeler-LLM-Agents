@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Customer Portal container

Person(Customer_Broker, "Customer / Broker", "External user submitting claims online.")

System_Ext(Identity_Provider, "Identity Provider", "Active Directory.")
System_Ext(API_Gateway, "API Gateway", "Azure Container Apps / .NET Yarp.")

Container_Boundary(Customer_Portal, "Customer Portal") {
    Component(Authentication_Controller, "Authentication Controller", "TypeScript / MSAL.js Component", "Authenticates via Single Sign-On with the Identity Provider.")
    Component(Claim_Submission_UI, "Claim Submission UI", "React / Formik Component", "Powers dynamic, type-specific claim forms and delegates payload validation.")
    Component(Claim_Tracker_Component, "Claim Tracker Component", "React Component", "Handles asynchronous command execution and real-time claim status tracking.")
    Component(API_Client_Service, "API Client Service", "Axios / OpenAPI Generated Component", "Delegates payload validation and sends API requests and receives real-time updates.")
}

Rel(Customer_Broker, Customer_Portal, "Submits claims online", "HTTPS")
Rel(Authentication_Controller, Identity_Provider, "Authenticates via Single Sign-On", "OIDC/HTTPS")
Rel(Claim_Submission_UI, API_Client_Service, "Delegates payload validation and invocation", "TypeScript Function Call")
Rel(API_Client_Service, API_Gateway, "Sends API requests and receives real-time updates", "HTTPS/JSON, WSS")

@enduml