@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Adjuster Workspace container

Container_Boundary("Adjuster Workspace", "Adjuster Workspace") {
    Component("UI Shell", "UI Shell", "React SPA", "Modern client-side rendering enabling claims adjusters to process claims efficiently.")
    Component("BFF API Controller", "BFF API Controller", ".NET Core", "Backend-for-Frontend API controller that isolates the user interface from high-latency backend systems.")
    Component("Event-Driven Sync Worker", "Event-Driven Sync Worker", ".NET Core Background Service", "Background service that consumes claim events and updates cached view models.")
    Component("Async View Model Cache", "Async View Model Cache", "Azure Cache for Redis", "Caches pre-aggregated claim states for sub-millisecond read performance.")
    Component("ACL Integration Client", "ACL Integration Client", ".NET Core / gRPC", "Handles integration and secure inter-service communication.")
}

System_Ext("API Gateway", "API Gateway", "External system")
System_Ext("Integration Message Broker", "Integration Message Broker", "External system")

Rel("UI Shell", "BFF API Controller", "API requests", "HTTPS/REST")
Rel("BFF API Controller", "Async View Model Cache", "Read/Write pre-aggregated claim states", "TCP")
Rel("BFF API Controller", "API Gateway", "Outbound commands", "gRPC/HTTPS")
Rel("Integration Message Broker", "Event-Driven Sync Worker", "Consume claim events", "AMQP")
Rel("Event-Driven Sync Worker", "Async View Model Cache", "Update cached view models", "TCP")

@enduml