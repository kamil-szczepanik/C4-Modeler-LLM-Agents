@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database container

Container(Claims_Core_Service, "Claims Core Service", "Azure Container Apps / .NET Core", "Handles core business logic and dispatches operations.")

Container_Boundary(Database, "Database") {
    Component(Claim_Write_Model_Component, "Claim Write Model Component", "Azure SQL Database / EF Core", "Handles write operations and domain data persistence for claims.")
    Component(Claim_Read_Model_Component, "Claim Read Model Component", "Azure SQL Database / EF Core", "Optimized read storage supporting the adjuster workspace and fast queries.")
    Component(Migration_Audit_Log_Component, "Migration & Audit Log Component", "Azure SQL Database / Temporal Tables", "Maintains audit logs and supports historical tracking and migration.")
    Component(Integration_Staging_Component, "Integration Staging Component", "Azure SQL Database / Stored Procedures", "Stages and transforms payloads for integration with the legacy mainframe.")
}

Rel(Claim_Write_Model_Component, Migration_Audit_Log_Component, "Records audit logs for write operations")
Rel(Claims_Core_Service, Claim_Write_Model_Component, "Reads and writes domain data", "EF Core / TDS")
Rel(Claims_Core_Service, Integration_Staging_Component, "Transforms staged payloads", "Stored Procedures / TDS")

@enduml