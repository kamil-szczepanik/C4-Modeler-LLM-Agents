@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(integration_message_broker, "Integration Message Broker") {
    Component(Claim_Routing_Topic, "Claim Routing Topic", "Azure Service Bus Topic", "Publishes domain events and satisfies zero-data-loss requirements.")
    Component(Session_Processor, "Session Processor", "Azure Service Bus Session Processor", "Enforces ordered delivery per session ID.")
    Component(Dead_Letter_Subsystem, "Dead-Letter Subsystem", "Azure Service Bus Dead-Letter Queue", "Handles undeliverable messages and duplicate detection.")
}

Rel(Claim_Routing_Topic, Session_Processor, "Enforces ordered delivery per session ID", "AMQP")

@enduml