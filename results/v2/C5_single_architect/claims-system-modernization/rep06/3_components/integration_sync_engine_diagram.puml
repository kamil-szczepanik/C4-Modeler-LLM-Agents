@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration & Sync Engine container

Container_Boundary(integration_sync_engine, "Integration & Sync Engine") {
    Component(Inbound_Event_Consumer, "Inbound Event Consumer", "Azure Function", "Consumes inbound events via Azure Service Bus and processes them.")
    Component(Mainframe_Batch_Staging_Repository, "Mainframe Batch Staging Repository", "Azure SQL / Cosmos DB", "Acts as a local buffer to decouple real-time events from the rigid mainframe batch window.")
    Component(Outbound_Sync_Orchestrator, "Outbound Sync Orchestrator", "Azure Function / Durable Functions", "Orchestrates outbound synchronization to the legacy mainframe.")
    Component(Reconciliation_Dead_Letter_Monitor, "Reconciliation & Dead Letter Monitor", "Azure Function / Timer Trigger", "Monitors dead letters and performs reconciliation between systems.")
}

Component(Core_Domain_Service, "Core Domain Service", "Azure Container Apps", "Core domain services running in Azure Container Apps.")
Component(Legacy_Mainframe, "Legacy Mainframe", "COBOL/DB2, On-Premises", "Legacy on-premises mainframe system.")

Rel(Core_Domain_Service, Inbound_Event_Consumer, "Consumes events", "AMQP / Azure Service Bus")
Rel(Inbound_Event_Consumer, Mainframe_Batch_Staging_Repository, "Buffers events", "Entity Framework Core / SQL")
Rel(Outbound_Sync_Orchestrator, Mainframe_Batch_Staging_Repository, "Reads staging data", "Entity Framework Core / SQL")
Rel(Outbound_Sync_Orchestrator, Legacy_Mainframe, "Syncs data", "SFTP / IBM MQ")
Rel(Reconciliation_Dead_Letter_Monitor, Mainframe_Batch_Staging_Repository, "Queries staging data", "SQL")
Rel(Reconciliation_Dead_Letter_Monitor, Legacy_Mainframe, "Reconciles data", "SFTP/Query - Read-Only")
@enduml