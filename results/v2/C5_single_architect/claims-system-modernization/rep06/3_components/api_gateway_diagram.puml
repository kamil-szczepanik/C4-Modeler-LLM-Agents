@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(Routing_Aggregation_Component, "Routing & Aggregation Component", "Azure API Management", "Routes requests to appropriate backend services and aggregates responses.")
    Component(Authentication_Authorization_Component, "Authentication & Authorization Component", "Azure API Management / OAuth2 / OpenID Connect", "Authenticates users via SSO with the Insurer's Active Directory.")
    Component(Rate_Limiting_Throttling_Component, "Rate Limiting & Throttling Component", "Azure API Management", "Protects backend systems by limiting and throttling incoming request rates.")
    Component(Request_Transformation_Component, "Request Transformation Component", "Azure API Management", "Transforms request formats between clients and internal services.")
    Component(Monitoring_Analytics_Component, "Monitoring & Analytics Component", "Azure API Management / Azure Application Insights", "Monitors traffic, performance, and tracks latency against constraints.")
}

System_Ext(Customer_Portal, "Customer Portal", "Azure App Service - React/Node.js")
System_Ext(Adjuster_Workspace, "Adjuster Workspace", "Azure App Service - React/.NET Core API")
System_Ext(Insurers_Active_Directory, "Insurer's Active Directory", "External Identity Provider")
System_Ext(Claims_Anti_Corruption_Layer, "Claims Anti-Corruption Layer", "Azure Container Apps - .NET Core")
System_Ext(Integration_Sync_Engine, "Integration & Sync Engine", "Azure Service Bus + Azure Functions")

Rel(Routing_Aggregation_Component, Customer_Portal, "Routes requests to customer portal", "HTTPS")
Rel(Routing_Aggregation_Component, Adjuster_Workspace, "Routes requests to adjuster workspace", "HTTPS")
Rel(Authentication_Authorization_Component, Insurers_Active_Directory, "Authenticates users via SSO", "OAuth2 / OpenID Connect")
Rel(Routing_Aggregation_Component, Claims_Anti_Corruption_Layer, "Routes direct API traffic for migrated claim types", "HTTPS / REST")
Rel(Routing_Aggregation_Component, Integration_Sync_Engine, "Forwards asynchronous event triggers", "HTTPS / AMQP")

@enduml