@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Adjuster Workspace container

Container_Boundary(adjuster_workspace, "Adjuster Workspace") {
    Component(SPA_Frontend, "SPA Frontend", "React and TypeScript", "Responsive single-page web application running in the browser for claims adjusters.")
    Component(Workspace_API_Controller, "Workspace API Controller", ".NET Core", "Backend handling orchestration and API requests.")
    Component(Claim_Cache_Service, "Claim Cache Service", "Azure Cache for Redis (Standard Tier)", "Low-latency state storage for fast data retrieval.")
    Component(Auth_Handler, "Auth Handler", ".NET Core middleware", "Handles authentication and token validation.")
    Component(Claims_Anti_Corruption_Layer___Core_Domain_Service, "Claims Anti-Corruption Layer / Core Domain Service", "Azure Container Apps", "Handles domain logic and communication with core systems.")
    Component(Integration___Sync_Engine, "Integration & Sync Engine", "Azure Service Bus and Azure Functions", "Manages data synchronization and cache invalidation events.")
}

System_Ext(Insurers_Active_Directory, "Insurer's Active Directory", "External system for authentication and identity management.")

Rel(SPA_Frontend, Workspace_API_Controller, "REST over HTTPS/JSON")
Rel(Workspace_API_Controller, Claim_Cache_Service, "In-memory TCP reads/writes")
Rel(Workspace_API_Controller, Claims_Anti_Corruption_Layer___Core_Domain_Service, "REST/gRPC over HTTPS")
Rel(Integration___Sync_Engine, Claim_Cache_Service, "Cache invalidation events", "AMQP (Azure Service Bus)")
Rel(Auth_Handler, Insurers_Active_Directory, "Token validation", "OpenID Connect (HTTPS)")

@enduml