@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Claims Anti-Corruption Layer / Core Domain Service", "Claims Anti-Corruption Layer / Core Domain Service") {
    Component(ClaimDomainModelComponent, "Claim Domain Model Component", ".NET Core / C#", "Encapsulates the core business logic and domain model for claims processing.")
    Component(ACLTranslatorComponent, "ACL Translator Component", ".NET Core / C#", "Translates modern domain models to and from legacy mainframe data formats.")
    Component(MainframeAdapterComponent, "Mainframe Adapter Component", ".NET Core / C#", "Handles communication and resilient retries with the legacy mainframe.")
    Component(RepositoryComponent, "Repository Component", "EF Core", "Manages relational persistence of claim data in the Azure SQL Database.")
    Component(OutboxPatternComponent, "Outbox Pattern Component", "EF Core", "Ensures reliable message publishing and consistency using the outbox pattern.")
}

Rel(ClaimDomainModelComponent, RepositoryComponent, "Persists and retrieves data via")
Rel(ClaimDomainModelComponent, OutboxPatternComponent, "Queues messages for integration via")
Rel(ACLTranslatorComponent, ClaimDomainModelComponent, "Maps data to and from")
Rel(MainframeAdapterComponent, ACLTranslatorComponent, "Sends translated data to")

@enduml