@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(API_Gateway, "API Gateway", "Azure API Management routing incoming external traffic.")
System_Ext(Claims_Anti_Corruption_Layer, "Claims Anti-Corruption Layer", "External service handling claim schemas and integrations.")

Container_Boundary(Customer_Portal, "Customer Portal") {
    Component(Claim_Frontend_UI, "Claim Frontend UI", "React", "React single-page application rendering dynamic claim forms.")
    Component(Authentication_Middleware, "Authentication Middleware", "Node.js / OpenID Connect / Azure App Service Easy Auth", "Node.js module handling OpenID Connect and SSO integration.")
    Component(Claim_Submission_Controller, "Claim Submission Controller", "Node.js / Express", "Node.js Backend-for-Frontend managing claim payload validation and routing.")
    Component(Claim_Type_Configuration_Client, "Claim Type Configuration Client", "JavaScript / React", "Component fetching dynamic claim-type schemas at runtime.")
}

Rel(API_Gateway, Customer_Portal, "Routes incoming external traffic", "HTTPS")
Rel(Claim_Frontend_UI, Authentication_Middleware, "Authenticates user session", "HTTPS")
Rel(Claim_Frontend_UI, Claim_Submission_Controller, "Submits claim data", "HTTPS/JSON")
Rel(Claim_Frontend_UI, Claims_Anti_Corruption_Layer, "Fetches dynamic claim form schemas", "HTTPS/REST")
Rel(Claim_Submission_Controller, Claims_Anti_Corruption_Layer, "Forwards validated claims", "HTTPS/REST")
@enduml