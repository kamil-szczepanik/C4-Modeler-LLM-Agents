@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title System Container Diagram for Insurance Claims Modernization

Person(Customer_Broker, "Customer/Broker", "Submits online claims and interacts with the customer portal.")
Person(Claims_Adjuster, "Claims Adjuster", "Manages claims and performs adjuster workflows using the web application.")

System_Ext(Insurers_Active_Directory, "Insurer's Active Directory", "Provides SSO authentication for users.")
System_Ext(Legacy_Mainframe_COBOL_DB2_On_Premises, "Legacy Mainframe (COBOL/DB2, On-Premises)", "On-premises legacy mainframe handling backend data and batch processing.")

System_Boundary(Insurance_Claims_Modernization, "Insurance Claims Modernization") {
    Container(Customer_Portal, "Customer Portal", "HTTPS/REST", "Web portal for online claim submission.")
    Container(Adjuster_Web_Application, "Adjuster Web Application", "HTTPS", "Web application for claim management by adjusters.")
    Container(Claims_Core_Service, "Claims Core Service", "Azure Cloud-Native", "Core service for processing claims on the modern platform.")
    Container(Enterprise_ESB_Integration_Middleware, "Enterprise ESB / Integration Middleware", "On-Premises Middleware", "Integration middleware for messaging and connectivity between systems.")
    Container(Data_Synchronization_Routing_Service, "Data Synchronization & Routing Service", "Azure Integration", "Anti-Corruption Layer for data consistency and routing.")
}

Rel(Customer_Broker, Customer_Portal, "Online claim submission", "HTTPS/REST")
Rel(Claims_Adjuster, Adjuster_Web_Application, "Claim management", "HTTPS")
Rel(Adjuster_Web_Application, Insurers_Active_Directory, "SSO authentication", "HTTPS")
Rel(Claims_Core_Service, Enterprise_ESB_Integration_Middleware, "Asynchronous messaging and REST APIs", "REST APIs / Asynchronous messaging")
Rel(Enterprise_ESB_Integration_Middleware, Legacy_Mainframe_COBOL_DB2_On_Premises, "Batch files and DB2 integration during the 23:00-05:00 window", "Batch files / DB2 integration")

@enduml