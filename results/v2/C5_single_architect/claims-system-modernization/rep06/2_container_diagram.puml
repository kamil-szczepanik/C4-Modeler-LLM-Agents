@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Insurance Claims Modernization

Person(CustomerBroker, "Customer / Broker", "Submits online claims and interacts with the customer portal.")
Person(ClaimsAdjuster, "Claims Adjuster", "Manages claims and performs adjuster workflows using the workspace.")

System_Ext(InsurersActiveDirectory, "Insurer's Active Directory", "Provides SSO authentication and security directory services.")
System_Ext(LegacyMainframeCOBOLDB2, "Legacy Mainframe COBOL/DB2", "On-premises legacy mainframe handling core backend data.")

System_Boundary(InsuranceClaimsModernization, "Insurance Claims Modernization") {
    Container(APIGateway, "API Gateway", "Azure API Management", "Single HTTPS entry point for security, rate limiting, and SSO.")
    Container(CustomerPortal, "Customer Portal", "Azure App Service - React/Node.js", "Web portal enabling online claim submission.")
    Container(AdjusterWorkspace, "Adjuster Workspace", "Azure App Service - React/.NET Core API", "Workspace application for claims adjusters.")
    Container(ClaimsAntiCorruptionLayerCoreDomainService, "Claims Anti-Corruption Layer / Core Domain Service", "Azure Container Apps - .NET Core", "Runs the Anti-Corruption Layer with manageable abstractions.")
    Container(IntegrationSyncEngine, "Integration & Sync Engine", "Azure Service Bus + Azure Functions", "Provides reliable messaging for zero claim loss and data synchronization.")
}

Rel(CustomerBroker, APIGateway, "Submits online claims and interacts", "HTTPS")
Rel(ClaimsAdjuster, APIGateway, "Processes claims and interacts", "HTTPS")
Rel(APIGateway, CustomerPortal, "Routes requests to customer portal", "HTTPS")
Rel(APIGateway, AdjusterWorkspace, "Routes requests to adjuster workspace", "HTTPS")
Rel(CustomerPortal, ClaimsAntiCorruptionLayerCoreDomainService, "Sends claim data for processing", "HTTPS")
Rel(AdjusterWorkspace, ClaimsAntiCorruptionLayerCoreDomainService, "Sends and retrieves claim data", "HTTPS")
Rel(ClaimsAntiCorruptionLayerCoreDomainService, IntegrationSyncEngine, "Publishes integration and sync messages", "AMQP / Azure Service Bus")
Rel(APIGateway, InsurersActiveDirectory, "Authenticates users via SSO", "OAuth2 / OpenID Connect")
Rel(IntegrationSyncEngine, LegacyMainframeCOBOLDB2, "Synchronizes data and transfers files", "Batch/File Transfer")

@enduml