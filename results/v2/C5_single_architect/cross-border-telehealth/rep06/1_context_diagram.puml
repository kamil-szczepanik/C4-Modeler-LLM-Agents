@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_Clinicians, "Patients & Clinicians", "External users interacting with the platform for video consultations, e-prescriptions, and symptom checking.")
System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and US while ensuring strict regional data residency, regulatory compliance, and low-bandwidth availability.")
System_Ext(National_Pharmacy_Networks_EU_US_Pharmacy_Systems, "National Pharmacy Networks (EU) & US Pharmacy Systems", "External systems for processing e-prescriptions.")
System_Ext(AI_Model_Provider_LLM_API, "AI Model Provider / LLM API", "External service for powering the AI symptom checker.")
System_Ext(Third_Party_Identity_Providers_Payment_Gateways, "Third-Party Identity Providers & Payment Gateways", "External systems providing authentication and cross-border billing capabilities.")

Rel(Patients_Clinicians, Cross_Border_Telehealth_Platform, "Interacts with the platform for video consultations and platform features", "HTTPS and WebSockets with adaptive bitrate streaming")
Rel(Cross_Border_Telehealth_Platform, AI_Model_Provider_LLM_API, "Sends requests to the AI model for symptom checking with immutable logging", "Secure HTTPS REST APIs")
Rel(Cross_Border_Telehealth_Platform, National_Pharmacy_Networks_EU_US_Pharmacy_Systems, "Submits e-prescriptions securely segregated by region", "TLS-encrypted REST and HL7 FHIR APIs")
Rel(Cross_Border_Telehealth_Platform, Third_Party_Identity_Providers_Payment_Gateways, "Processes cross-border billing and authentication", "HTTPS webhooks")
@enduml