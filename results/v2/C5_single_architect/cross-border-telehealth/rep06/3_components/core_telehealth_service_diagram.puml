@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component Diagram for Core Telehealth Service

Container_Boundary(core_telehealth_service, "Core Telehealth Service") {
    Component(profile_and_consent_manager, "Profile & Consent Manager", "Node.js / TypeScript", "Manages user profiles and consents with regional data isolation and row-level security.")
    Component(appointment_and_scheduling_engine, "Appointment & Scheduling Engine", "Node.js / TypeScript", "Handles booking, scheduling, and management of telehealth appointments.")
    Component(audit_logger, "Audit Logger", "Node.js / TypeScript", "Collects and publishes asynchronous event logs for system traceability.")
    Component(sync_and_state_manager, "Sync & State Manager", "Node.js / TypeScript", "Ensures resilience and state synchronization for unstable network connections.")
}

System_Ext(regional_cloud_sql, "Regional Cloud SQL (PostgreSQL)", "Relational database utilizing regional partitioning and row-level security.")
System_Ext(gcp_pub_sub, "GCP Pub/Sub", "Asynchronous event publishing and messaging backbone.")
System_Ext(api_gateway, "API Gateway / BFF", "Go, gRPC/REST gateway for handling incoming client traffic.")

Rel(api_gateway, profile_and_consent_manager, "Routes gRPC requests over mTLS", "gRPC / mTLS")
Rel(api_gateway, appointment_and_scheduling_engine, "Routes gRPC requests over mTLS", "gRPC / mTLS")
Rel(api_gateway, sync_and_state_manager, "Routes gRPC requests over mTLS", "gRPC / mTLS")

Rel(profile_and_consent_manager, regional_cloud_sql, "Stores user profiles and consent data using TypeORM via SSL with row-level security", "TypeORM / SSL")
Rel(profile_and_consent_manager, audit_logger, "Publishes asynchronous events", "GCP Pub/Sub")
Rel(appointment_and_scheduling_engine, audit_logger, "Publishes asynchronous events", "GCP Pub/Sub")
Rel(sync_and_state_manager, audit_logger, "Publishes asynchronous events", "GCP Pub/Sub")
Rel(audit_logger, gcp_pub_sub, "Publishes asynchronous event logs for system traceability", "GCP Pub/Sub")

Rel(sync_and_state_manager, appointment_and_scheduling_engine, "Communicates via internal asynchronous message queue", "Internal Queue")
@enduml