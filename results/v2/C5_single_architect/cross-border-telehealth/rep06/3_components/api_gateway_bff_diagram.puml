@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_bff, "API Gateway / BFF") {
    Component(region_router, "Region Router & Enforcement Filter", "Go (Golang)", "Routes geo-targeted traffic and enforces data residency and regulatory compliance constraints.")
    Component(auth_interceptor, "Authentication & Consent Interceptor", "Go (Golang)", "Validates requests and manages authentication and consent.")
    Component(regional_service_router, "Regional Service Router", "Go (Golang)", "Forwards validated requests to downstream regional services.")
}

Rel(auth_interceptor, regional_service_router, "Forwards validated requests", "In-process function call")

@enduml