@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Storage container

System_Ext(CoreTelehealthService, "Core Telehealth Service", "External service connecting to the database.")
System_Ext(AIOrchestrator, "AI Orchestrator", "External AI service.")
System_Ext(EPrescriptionIntegrator, "E-Prescription Integrator", "External e-prescription service.")

Container_Boundary(DataStorage, "Data Storage") {
    Component(RegionalRelationalDB, "Regional Relational DB", "Cloud SQL for PostgreSQL", "Stores user profiles, appointments, and granular consent records with CMEK encryption-at-rest for HIPAA/GDPR compliance.")
    Component(RegionalObjectStore, "Regional Object Store", "Google Cloud Storage", "Stores e-prescription documents and encrypted consultation media in region-partitioned buckets.")
    Component(AuditTraceabilityStore, "Audit & Traceability Store", "Cloud Bigtable", "Maintains append-only immutable logs for AI symptom-checker recommendations, ensuring medical device traceability (EU MDR).")
}

Rel(CoreTelehealthService, RegionalRelationalDB, "Read/Write patient data and consent", "PostgreSQL wire protocol (TCP/5432)")
Rel(AIOrchestrator, AuditTraceabilityStore, "Append-only writes for AI traceability logs", "Bigtable API (gRPC)")
Rel(EPrescriptionIntegrator, RegionalObjectStore, "Secure storage and retrieval of e-prescription artifacts", "HTTPS (REST API/GCP SDK)")

@enduml