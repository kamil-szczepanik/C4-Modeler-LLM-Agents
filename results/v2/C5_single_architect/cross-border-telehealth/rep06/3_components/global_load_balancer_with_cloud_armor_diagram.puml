@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(Global_Load_Balancer_with_Cloud_Armor, "Global Load Balancer with Cloud Armor") {
    Component(Anycast_IP_Termination, "Anycast IP Termination", "Google Cloud Global Load Balancer", "Terminates incoming HTTPS and WebSocket traffic globally and routes to the nearest region.")
    Component(Web_Application_Firewall_WAF_Rate_Limiting, "Web Application Firewall (WAF) & Rate Limiting", "Cloud Armor", "Provides geo-based rate-limiting, DDoS protection, and security filtering for incoming traffic.")
}

Rel(Anycast_IP_Termination, Web_Application_Firewall_WAF_Rate_Limiting, "Inspects and filters incoming traffic", "")
@enduml