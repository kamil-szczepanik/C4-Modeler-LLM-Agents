@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the E-Prescription Integrator container

Container_Boundary(eprescription_integrator, "E-Prescription Integrator") {
    Component(Routing_Consent_Validator, "Routing & Consent Validator", "Spring Cloud Gateway", "Validating patient consent and routing payloads by region (EU vs. US).")
    Component(US_FHIR_Translator, "US FHIR Translator", "HAPI FHIR", "Mapping domain models to HL7 FHIR for US pharmacies.")
    Component(EU_National_Adapter_Engine, "EU National Adapter Engine", "Apache Camel / Spring Integration", "Housing pluggable adapters for national EU e-prescription standards.")
    Component(Audit_Compliance_Logger, "Audit & Compliance Logger", "Java / Spring Boot", "Records transaction hashes to ensure accountability.")
    Component(Regional_Outbox_Dispatcher, "Regional Outbox Dispatcher", "Spring Batch / Debezium", "Ensuring transactional outbox execution for regional data locality.")
}

Component(API_Gateway_BFF, "API Gateway/BFF", "Gateway", "Inbound dispatching system.")
Component_Ext(National_Pharmacy_Networks_EU, "National Pharmacy Networks (EU)", "REST/SOAP over mTLS", "External EU national pharmacy networks.")
Component_Ext(US_Pharmacy_Systems, "US Pharmacy Systems", "HL7 FHIR over HTTPS", "External US pharmacy systems.")
ComponentDb(Data_Storage_Cloud_SQL, "Data Storage (Cloud SQL)", "Cloud SQL (PostgreSQL), JDBC/HikariCP", "Regional databases deployed in europe-west3 and us-central1 ensuring strict data segregation.")

Rel(API_Gateway_BFF, Routing_Consent_Validator, "Inbound dispatch via gRPC")
Rel(EU_National_Adapter_Engine, National_Pharmacy_Networks_EU, "Transmits prescriptions via REST/SOAP over mTLS")
Rel(US_FHIR_Translator, US_Pharmacy_Systems, "Transmits prescriptions via HL7 FHIR over HTTPS")
Rel(US_FHIR_Translator, Data_Storage_Cloud_SQL, "Persists audit states and outbox events", "JDBC/HikariCP")
Rel(EU_National_Adapter_Engine, Data_Storage_Cloud_SQL, "Persists audit states and outbox events", "JDBC/HikariCP")

@enduml