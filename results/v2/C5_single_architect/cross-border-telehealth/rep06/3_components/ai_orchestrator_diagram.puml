@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(ai_orchestrator, "AI Orchestrator") {
    Component(Prompt_Router, "Prompt Router", "Python, FastAPI", "Passes sanitized, region-validated payloads to the Model Gateway.")
    Component(Model_Gateway, "Model Gateway", "Python, FastAPI", "Executes external inference requests and emits immutable audit events.")
    Component(Traceability_Logger, "Traceability Logger", "Python, FastAPI", "Emits and persists immutable audit events to region-locked storage.")
}

Rel(Prompt_Router, Model_Gateway, "Passes sanitized, region-validated payloads", "In-process async function calls")
Rel(Model_Gateway, Traceability_Logger, "Emits immutable audit events", "In-process Python Queue")

@enduml