@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Video Consultation Service container

Container_Boundary(video_consultation_service_boundary, "Video Consultation Service") {
    Component(Signaling_Controller, "Signaling Controller", "Golang, WebSockets", "Coordinates peer sessions and joins consultation rooms.")
    Component(SFU_Media_Router, "SFU Media Router", "Golang / LiveKit SDK", "Handles scalable media routing for video consultations.")
    Component(Bandwidth_Adaptation_Engine, "Bandwidth Adaptation Engine", "Golang", "Dynamically adjusts bitrates for low-bandwidth resilience.")
    Component(NAT_Traversal_Manager, "NAT Traversal Manager", "Golang, Pion TURN", "Allocates UDP relay ports for network traversal.")
    Component(Audit_Compliance_Logger, "Audit & Compliance Logger", "Golang", "Persists localized session telemetry and compliance logs.")
}

Rel(Signaling_Controller, SFU_Media_Router, "Coordinates peer sessions", "In-memory Go channels")
Rel(SFU_Media_Router, NAT_Traversal_Manager, "Allocates UDP relay ports", "ICE/TURN protocol")
Rel(Bandwidth_Adaptation_Engine, SFU_Media_Router, "Dynamically adjusts bitrates", "In-memory Go function calls")
@enduml