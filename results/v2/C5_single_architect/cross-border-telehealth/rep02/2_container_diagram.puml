@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients (EU/US)", "End-users accessing telehealth services via web or mobile applications.")
Person(Clinicians, "Licensed Clinicians", "Healthcare providers conducting video consultations and issuing prescriptions.")

System_Ext(AISymptomChecker, "AI Symptom Checker Service", "Isolated cognitive service providing urgency recommendations.")
System_Ext(PrescriptionGateways, "National e-Prescription Gateways (EU) & Pharmacy Systems (US)", "External systems for dispatching prescriptions.")
System_Ext(VideoInfra, "Third-party Video Infrastructure", "WebRTC-based service handling real-time consultations.")

System_Boundary(CrossBorderTelehealthPlatform, "Cross-Border Telehealth Platform") {
    Container(WebApp, "Web Application & Mobile App", "Flutter / React", "Provides user interfaces for patients and clinicians across web and mobile platforms.")
    Container(APIGateway, "API Gateway", "Google Cloud API Gateway / Envoy", "Handles edge routing, traffic management, and protocol translation.")
    Container(CoreService, "Core Telehealth Service", "Go / Spring Boot", "Manages core business logic for video consultations and platform operations.")
    Container(AIOrchestrator, "AI Symptom Checker Orchestrator", "Python / FastAPI", "Orchestrates traceable AI symptom checks and inference requests.")
    Container(PrescriptionService, "E-Prescription Integration Service", "Node.js / Java", "Handles integration with national e-prescription standards and HL7 FHIR for external systems.")
    Container(MediaService, "Media Relay & Signaling Service", "WebRTC / LiveKit", "Enables resilient video consultations with adaptive bitrate control for low-bandwidth connections.")
    
    ContainerDb(Database, "Cloud SQL PostgreSQL", "PostgreSQL", "Stores relational data across regional instances adhering to GDPR and HIPAA data residency.")
    ContainerDb(Cache, "Memorystore Redis", "Redis", "Provides fast in-memory data storage for caching and session management.")
}

Rel(Patients, WebApp, "Access telehealth services", "HTTPS and WSS")
Rel(Clinicians, WebApp, "Conduct consultations and manage patient care", "HTTPS and WSS")
Rel(WebApp, APIGateway, "Sends application traffic and real-time signaling", "HTTPS and WSS")
Rel(APIGateway, CoreService, "Routes internal traffic", "gRPC over GCP VPC")
Rel(APIGateway, AIOrchestrator, "Routes AI inference requests", "gRPC over GCP VPC")
Rel(APIGateway, PrescriptionService, "Routes prescription integration requests", "gRPC over GCP VPC")
Rel(APIGateway, MediaService, "Routes media and signaling traffic", "gRPC over GCP VPC")
Rel(CoreService, Database, "Reads and writes relational data", "TLS 1.3")
Rel(CoreService, Cache, "Caches session and application data", "TLS 1.3")
Rel(AIOrchestrator, Database, "Persists symptom check logs and data", "TLS 1.3")
Rel(PrescriptionService, PrescriptionGateways, "Dispatches prescriptions using HL7 FHIR and national standards", "Secure API gateways using TLS and mTLS")
Rel(MediaService, VideoInfra, "Relays real-time video consultations supporting degraded connections", "WebRTC")

@enduml