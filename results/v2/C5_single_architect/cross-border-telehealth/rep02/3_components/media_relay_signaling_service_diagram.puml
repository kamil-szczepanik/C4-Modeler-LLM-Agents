@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(media_relay_signaling_service, "Media Relay & Signaling Service") {
    Component(Signaling_Controller, "Signaling Controller", "Node.js / Go", "Handles session signaling and orchestrates media tracks.")
    Component(SFU_Media_Router, "SFU Media Router", "LiveKit / WebRTC SFU", "Selective Forwarding Unit for multi-party video routing and congestion control.")
    Component(TURN_STUN_Relay_Module, "TURN/STUN Relay Module", "Coturn / LiveKit Egress", "Provides NAT traversal and media relay fallback for restricted networks.")
    Component(Bandwidth_Adaptation_Monitor, "Bandwidth Adaptation Monitor", "Go", "Monitors packet metrics and adjusts Simulcast/SVC layers for unstable connections.")
}

Rel(Signaling_Controller, SFU_Media_Router, "Orchestrate tracks", "gRPC")
Rel(SFU_Media_Router, Bandwidth_Adaptation_Monitor, "Track packet metrics", "Goroutines/Channels")
Rel(Bandwidth_Adaptation_Monitor, SFU_Media_Router, "Adjust Simulcast/SVC layers", "In-memory Go calls")

@enduml