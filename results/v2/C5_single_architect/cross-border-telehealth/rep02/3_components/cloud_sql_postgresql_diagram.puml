@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Core_Telehealth_Service, "Core Telehealth Service", "Go / Spring Boot")
System_Ext(AI_Symptom_Checker_Orchestrator, "AI Symptom Checker Orchestrator", "Python / FastAPI")
System_Ext(Cloud_KMS, "Cloud KMS", "Cloud Key Management Service")

Container_Boundary(Cloud_SQL_PostgreSQL, "Cloud SQL PostgreSQL") {
    Component(PostgreSQL_Relational_Engine, "PostgreSQL Relational Engine", "PostgreSQL Relational Engine", "Handles relational queries and transactions via pgx.")
    Component(Audit_Logging_Schema, "Audit & Logging Schema", "Audit & Logging Schema", "Maintains append-only audit tables for traceability and batched inserts.")
}

Rel(Core_Telehealth_Service, PostgreSQL_Relational_Engine, "Relational queries and transactions via pgx", "TLS 1.3, SQL")
Rel(AI_Symptom_Checker_Orchestrator, Audit_Logging_Schema, "Batched inserts via SQLAlchemy/Psycopg", "TLS 1.3, SQL")
Rel(Cloud_SQL_PostgreSQL, Cloud_KMS, "Fetches regional envelope encryption keys", "Internal VPC, gRPC")

@enduml