@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application & Mobile App container

System_Ext(API_Gateway, "API Gateway", "Google Cloud API Gateway / Envoy")

Container_Boundary(Web_Application___Mobile_App, "Web Application & Mobile App") {
    Component(Web_Portal_Interface, "Web Portal Interface", "React", "Provides the web-based user interface for patients and clinicians to access video consultations, e-prescriptions, and the AI symptom checker.")
    Component(Mobile_App_Client, "Mobile App Client", "Flutter", "Provides the cross-platform mobile application interface for patients and clinicians with offline-first client caching.")
}

Rel(Web_Portal_Interface, API_Gateway, "Sends application traffic and signaling", "HTTPS and WSS")
Rel(Mobile_App_Client, API_Gateway, "Sends application traffic and signaling", "HTTPS and WSS")

@enduml