@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Memorystore Redis container

Container_Boundary(memorystore_redis, "Memorystore Redis") {
    Component(Session_Cache_Component, "Session Cache Component", "Google Cloud Memorystore (Redis)", "Manages authentication tokens and active session states.")
    Component(Distributed_Rate_Limiter_Component, "Distributed Rate Limiter Component", "Google Cloud Memorystore (Redis)", "Enforces API quotas and protects backend services.")
    Component(Pub_Sub_Broker_Component, "Pub/Sub Broker Component", "Google Cloud Memorystore (Redis)", "Handles real-time signaling synchronization for video sessions.")
    Component(Idempotency_Store_Component, "Idempotency Store Component", "Google Cloud Memorystore (Redis)", "Prevents duplicate e-prescription submissions during retries.")
}

System_Ext(Core_Telehealth_Service, "Core Telehealth Service", "External service interacting with the session cache.")
System_Ext(API_Gateway, "API Gateway", "External gateway enforcing rate limits.")
System_Ext(Media_Relay_Signaling_Service, "Media Relay & Signaling Service", "External service for video session signaling.")
System_Ext(E_Prescription_Integration_Service, "E-Prescription Integration Service", "External service processing prescriptions.")

Rel(Core_Telehealth_Service, Session_Cache_Component, "Reads/writes session data", "RESP3 over TLS 1.3")
Rel(API_Gateway, Distributed_Rate_Limiter_Component, "Evaluates request rates", "RESP3 over TLS 1.3")
Rel(Media_Relay_Signaling_Service, Pub_Sub_Broker_Component, "Publishes signaling events", "RESP3 Pub/Sub over TLS 1.3")
Rel(E_Prescription_Integration_Service, Idempotency_Store_Component, "Checks transaction keys", "RESP3 over TLS 1.3")

@enduml