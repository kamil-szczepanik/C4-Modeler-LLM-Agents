@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Symptom Checker Orchestrator container

Container_Boundary(ai_symptom_checker_orchestrator, "AI Symptom Checker Orchestrator") {
    Component(Inference_Controller, "Inference Controller", "FastAPI, Python", "Exposing REST/gRPC endpoints and enforcing region isolation headers.")
    Component(Consent___Policy_Enforcer, "Consent & Policy Enforcer", "Python Middleware", "Validating patient consent and geographic compliance before processing.")
    Component(Region_Aware_AI_Gateway_Client, "Region-Aware AI Gateway Client", "gRPC Client, Python", "Routing requests securely to regional AI services via gRPC.")
    Component(Audit___Traceability_Logger, "Audit & Traceability Logger", "Python SDK", "Capturing exact inputs, model versions, and outputs for EU MDR compliance.")
    Component(Cloud_SQL_PostgreSQL, "Cloud SQL PostgreSQL", "SQLAlchemy, PostgreSQL, TLS 1.3", "Regional database storing versioned audit logs and persistent data.")
}

Rel(Inference_Controller, Consent___Policy_Enforcer, "Validates regional consent", "In-memory")
Rel(Consent___Policy_Enforcer, Region_Aware_AI_Gateway_Client, "Authorizes request dispatch", "In-memory")
Rel(Inference_Controller, Region_Aware_AI_Gateway_Client, "Invokes inference", "In-memory")
Rel(Inference_Controller, Audit___Traceability_Logger, "Dispatches audit payloads", "Asyncio Queue")
Rel(Audit___Traceability_Logger, Cloud_SQL_PostgreSQL, "Writes versioned audit logs", "SQLAlchemy via TLS 1.3")

@enduml