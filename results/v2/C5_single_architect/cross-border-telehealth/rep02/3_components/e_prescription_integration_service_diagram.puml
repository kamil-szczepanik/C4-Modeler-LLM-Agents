@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the E-Prescription Integration Service container

Container_Boundary(e_prescription_integration_service, "E-Prescription Integration Service") {
    Component(Prescription_Router_Component, "Prescription Router Component", "Node.js / Express", "Dispatches normalized prescription data to regional adapters.")
    Component(EU_National_Gateway_Adapter_Component, "EU National Gateway Adapter Component", "Node.js / TypeScript", "Adapts prescription data for EU national gateways.")
    Component(US_HL7_FHIR_Adapter_Component, "US HL7 FHIR Adapter Component", "Node.js / TypeScript", "Adapts prescription data for US HL7 FHIR systems.")
    Component(Audit___Compliance_Logger_Component, "Audit & Compliance Logger Component", "Node.js / TypeScript", "Emits compliance audit logs.")
}

Rel(Prescription_Router_Component, EU_National_Gateway_Adapter_Component, "Dispatches normalized prescription data", "In-process function calls")
Rel(Prescription_Router_Component, US_HL7_FHIR_Adapter_Component, "Dispatches normalized prescription data", "In-process function calls")
Rel(EU_National_Gateway_Adapter_Component, Audit___Compliance_Logger_Component, "Emits compliance audit logs", "")
Rel(US_HL7_FHIR_Adapter_Component, Audit___Compliance_Logger_Component, "Emits compliance audit logs", "")

@enduml