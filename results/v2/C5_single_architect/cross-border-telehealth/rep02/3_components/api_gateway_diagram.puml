@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(web_mobile_app, "Web App / Mobile App", "Client application used by patients and clinicians.")
System_Ext(core_services, "Core Telehealth, AI, & E-Prescription Services", "Backend microservices handling core logic, AI orchestration, and prescriptions.")
System_Ext(media_relay, "Media Relay & Signaling Service", "Handles media and signaling traffic for video consultations.")

System_Boundary(api_gateway, "API Gateway") {
    Component(geo_routing, "Geo-Routing & Region Enforcer", "Envoy Proxy / Google Cloud API Gateway", "Handles geo-routing and region enforcement for application traffic.")
    Component(rate_limiting, "Rate Limiting & Degradation Handler", "Envoy Proxy", "Manages rate limiting and degradation handling for filtered traffic.")
    Component(auth_verifier, "Authentication & Consent Verifier", "Envoy Proxy with custom Lua filters", "Verifies tokens, authentication, and consent.")
    Component(protocol_translator, "Protocol & Payload Translator", "Envoy Proxy", "Translates protocols and payloads.")
}

Rel(web_mobile_app, geo_routing, "Sends application traffic and real-time signaling", "HTTPS and WSS")
Rel(geo_routing, rate_limiting, "Routes filtered traffic", "Internal gRPC")
Rel(rate_limiting, auth_verifier, "Verifies tokens and consent", "Internal gRPC")
Rel(auth_verifier, core_services, "Forwards authorized requests", "gRPC over GCP VPC")
Rel(api_gateway, media_relay, "Routes media and signaling traffic", "gRPC over GCP VPC")

@enduml