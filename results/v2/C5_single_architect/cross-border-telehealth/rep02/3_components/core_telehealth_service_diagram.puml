@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(core_telehealth_service, "Core Telehealth Service") {
    Component(consultation_management, "Consultation Management", "Go", "Manages business logic for cross-border video consultations.")
    Component(consent_ledger, "Consent Ledger", "Go", "Manages user consent and evaluates permissions.")
    Component(audit_traceability, "Audit & Traceability", "Go", "Handles audit logging for compliance and traceability.")
    Component(prescription_dispatcher, "Prescription Dispatcher", "Go", "Handles prescription routing and dispatching.")
}

SystemDb(cloud_sql_postgresql, "Cloud SQL PostgreSQL", "Regional database")
SystemDb(memorystore_redis, "Memorystore Redis", "Regional cache")

Rel(consultation_management, prescription_dispatcher, "Internal execution", "Go interfaces")
Rel(consultation_management, cloud_sql_postgresql, "Persists relational data", "pgx driver over TLS 1.3")
Rel(audit_traceability, cloud_sql_postgresql, "Persists audit logs", "pgx driver over TLS 1.3")
Rel(consent_ledger, memorystore_redis, "Evaluates permissions", "Redis RESP3 over TLS 1.3")
@enduml