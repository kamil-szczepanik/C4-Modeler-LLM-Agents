@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_EU_US, "Patients (EU/US)", "End-users accessing telehealth services via web or mobile applications.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Healthcare providers conducting video consultations and issuing prescriptions.")
System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides secure video consultations, e-prescriptions, and AI symptom checks for patients in the EU and US while ensuring GDPR, HIPAA, and EU MDR compliance.")
System_Ext(AI_Symptom_Checker_Service, "AI Symptom Checker Service", "Isolated cognitive service providing urgency recommendations.")
System_Ext(National_e_Prescription_Gateways_EU_Pharmacy_Systems_US, "National e-Prescription Gateways (EU) & Pharmacy Systems (US)", "External systems for dispatching prescriptions.")
System_Ext(Third_party_Video_Infrastructure, "Third-party Video Infrastructure", "WebRTC-based service handling real-time consultations.")

Rel(Patients_EU_US, Cross_Border_Telehealth_Platform, "Access telehealth services via web or mobile applications", "HTTPS with TLS encryption")
Rel(Licensed_Clinicians, Cross_Border_Telehealth_Platform, "Conduct video consultations and issue prescriptions", "HTTPS with TLS encryption")
Rel(Cross_Border_Telehealth_Platform, Third_party_Video_Infrastructure, "Handle real-time consultations supporting degraded connections", "WebRTC")
Rel(Cross_Border_Telehealth_Platform, AI_Symptom_Checker_Service, "Send inference requests with immutable request logging", "gRPC over TLS")
Rel(Cross_Border_Telehealth_Platform, National_e_Prescription_Gateways_EU_Pharmacy_Systems_US, "Dispatch prescriptions securely", "Secure API gateways using TLS and mTLS (HL7 FHIR / national standards)")

@enduml