@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(web_mobile_frontend_app, "Web/Mobile Frontend App") {
    Component(UIPresentationLayer, "UI Presentation Layer", "Flutter", "Standardizes cross-platform mobile and web user interface presentation.")
    Component(LocalStateStorageManager, "Local State & Storage Manager", "SQLite/Hive with SQLCipher", "Enables encrypted offline data caching for degraded rural internet connections.")
    Component(APIClientSyncEngine, "API Client & Sync Engine", "HTTPS/WSS", "Sends API requests, consent payloads, and symptom-checker inputs with session telemetry.")
    Component(WebRTCMediaClient, "WebRTC Media Client", "WebRTC, DTLS, SRTP", "Streams media directly for consultations, delivering low-latency, resilient video streaming.")
    Component(RegionalRegionRoutingConfigModule, "Regional Region-Routing / Config Module", "HTTPS", "Pins app instance to correct regional endpoint.")
}

System_Ext(APIGateway, "API Gateway", "API Gateway")
System_Ext(WebRTCSFUVideoService, "WebRTC SFU Video Service", "WebRTC SFU Video Service")

Rel(RegionalRegionRoutingConfigModule, RegionalRegionRoutingConfigModule, "Pins app instance to correct regional endpoint", "HTTPS")
Rel(APIClientSyncEngine, APIGateway, "Sends API requests, consent payloads, and symptom-checker inputs with session telemetry", "HTTPS and WSS using TLS 1.3")
Rel(WebRTCMediaClient, WebRTCSFUVideoService, "Streams media directly for consultations", "WebRTC / ICE / DTLS / SRTP")

@enduml