@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(web_mobile_frontend_app, "Web/Mobile Frontend App", "Flutter/React client application.")
System_Ext(core_telehealth_service_ai_inference_service, "Core Telehealth Service & AI Inference Service", "Go/Spring Boot backend and Python/FastAPI service.")
System_Ext(regional_data_stores, "Regional Data Stores", "GCP Cloud SQL/Spanner deployed regionally.")

Container_Boundary(api_gateway, "API Gateway") {
    Component(auth_filter, "Authentication & Authorization Filter", "Envoy Authz/Lua", "Validates bearer tokens and handles security checks for incoming client requests.")
    Component(region_router, "Region Routing Router", "Envoy Route Configuration", "Routes validated traffic regionally to core services and AI inference.")
    Component(rate_limit, "Rate Limiting & Resilience Component", "Envoy Rate Limit Service", "Enforces rate limiting and resilience patterns for platform stability.")
    Component(audit_interceptor, "Audit & Telemetry Interceptor", "Envoy Access Log Service", "Emits request traces and audit events for compliance and monitoring.")
}

Rel(web_mobile_frontend_app, auth_filter, "Sends requests with bearer tokens", "HTTPS and WSS")
Rel(auth_filter, region_router, "Forwards validated requests internally", "gRPC")
Rel(region_router, core_telehealth_service_ai_inference_service, "Routes traffic regionally", "gRPC over mTLS")
Rel(region_router, audit_interceptor, "Emits request traces and audit events", "gRPC")
Rel(audit_interceptor, regional_data_stores, "Persists compliance logs regionally", "gRPC")

@enduml