@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(ai_inference_service, "AI Inference Service") {
    Component(API_Controller, "API Controller", "FastAPI", "Exposes endpoints for symptom check requests and coordinates AI processing.")
    Component(Consent___Policy_Enforcer, "Consent & Policy Enforcer", "Python middleware component", "Intercepts requests for consent validation and enforces compliance.")
    Component(Model_Orchestrator, "Model Orchestrator", "PyTorch / Hugging Face component", "Delegates inference tasks and runs region-locked symptom checker models.")
    Component(Audit___Lineage_Logger, "Audit & Lineage Logger", "SQLAlchemy component", "Persists inputs, outputs, and model versions for traceability.")
}

System_Ext(Regional_Data_Stores, "Regional Data Stores", "GCP Cloud SQL / Spanner")

Rel(API_Controller, Consent___Policy_Enforcer, "Intercepts requests for consent validation", "In-process middleware")
Rel(Consent___Policy_Enforcer, Regional_Data_Stores, "Reads active patient consent flags", "SQL")
Rel(API_Controller, Model_Orchestrator, "Delegates inference tasks", "In-process Python calls")
Rel(Model_Orchestrator, Audit___Lineage_Logger, "Persists inputs, outputs, and model versions", "SQL")
Rel(API_Controller, Audit___Lineage_Logger, "Persists inputs, outputs, and model versions", "SQL")

@enduml