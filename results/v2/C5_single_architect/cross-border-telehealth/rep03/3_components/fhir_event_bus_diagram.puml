@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(fhiring_event_bus, "FHIR Event Bus") {
    Component(EventRouter, "Event Router", "GCP Pub/Sub", "Publishes and routes regional FHIR bundles.")
    Component(FHiredSchemaValidator, "FHired Schema Validator", "HL7 FHIR", "Validates schema compliance of event payloads.")
    Component(AuditLedgerSink, "Audit Ledger Sink", "Go / GCP Pub/Sub", "Forwards event metadata for tracing and audit purposes.")
    Component(RegionalIsolationEnforcer, "Regional Isolation Enforcer", "Go", "Validates data residency before queuing events.")
}

Rel(EventRouter, RegionalIsolationEnforcer, "Validates residency before queuing", "Internal function call")
Rel(EventRouter, AuditLedgerSink, "Forwards event metadata for tracing", "Internal gRPC")

@startuml