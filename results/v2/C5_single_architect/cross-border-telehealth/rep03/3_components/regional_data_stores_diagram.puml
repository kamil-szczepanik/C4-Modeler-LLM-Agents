@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Regional Data Stores container

System_Ext(Core_Telehealth_Service, "Core Telehealth Service", "External telehealth service calling the regional data stores.")
System_Ext(Cloud_Logging_GCP, "Cloud Logging (GCP)", "External GCP Cloud Logging service for audit and compliance logs.")

Container_Boundary(Regional_Data_Stores, "Regional Data Stores") {
    Component(EU_Data_Store_Instance, "EU Data Store Instance", "GCP Cloud SQL (PostgreSQL)", "PostgreSQL database in europe-west3 managing partitioned EU patient health data.")
    Component(US_Data_Store_Instance, "US Data Store Instance", "GCP Cloud SQL (PostgreSQL with FHIR schema)", "PostgreSQL database in us-central1 managing partitioned US patient health data with FHIR schema.")
    Component(Audit_Traceability_Logger, "Audit & Traceability Logger", "PostgreSQL Append-Only Schema", "Append-only schema component within each instance streaming compliance and consent logs asynchronously.")
    Component(Consent_Enforcement_Proxy, "Consent Enforcement Proxy", "Access Control Middleware, gRPC", "Access control middleware protecting both database instances and validating patient consent scopes.")
}

Rel(Core_Telehealth_Service, Consent_Enforcement_Proxy, "Validates patient consent scopes", "gRPC")
Rel(Consent_Enforcement_Proxy, EU_Data_Store_Instance, "Executes scoped database queries", "SQL over TLS 1.3")
Rel(Consent_Enforcement_Proxy, US_Data_Store_Instance, "Executes scoped database queries", "SQL over TLS 1.3")
Rel(Audit_Traceability_Logger, Cloud_Logging_GCP, "Streams compliance and consent logs asynchronously", "gRPC")

@enduml