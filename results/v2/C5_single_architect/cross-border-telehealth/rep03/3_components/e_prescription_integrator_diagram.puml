@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(eprescription_integrator, "E-Prescription Integrator") {
    Component(FHIR_Event_Consumer_Component, "FHIR Event Consumer Component", "Node.js/TypeScript", "Consumes prescription events from the FHIR Event Bus.")
    Component(Jurisdiction_Routing_Guard_Component, "Jurisdiction Routing Guard Component", "Node.js/TypeScript", "Routes events and dispatches regionally compliant payloads.")
    Component(US_Pharmacy_Adapter_Component, "US Pharmacy Adapter Component", "Node.js/TypeScript", "Sends prescriptions to US Pharmacy Systems.")
    Component(EU_National_Gateway_Adapter_Component, "EU National Gateway Adapter Component", "Node.js/TypeScript", "Sends prescriptions to External National E-Prescription Networks (EU).")
    Component(Prescription_Status_Tracker_Component, "Prescription Status Tracker Component", "Node.js/TypeScript", "Reports delivery status.")
}

Rel(FHIR_Event_Consumer_Component, Jurisdiction_Routing_Guard_Component, "Routes event", "In-Memory")
Rel(Jurisdiction_Routing_Guard_Component, US_Pharmacy_Adapter_Component, "Dispatches regionally compliant payloads", "In-Memory")
Rel(Jurisdiction_Routing_Guard_Component, EU_National_Gateway_Adapter_Component, "Dispatches regionally compliant payloads", "In-Memory")
Rel(US_Pharmacy_Adapter_Component, Prescription_Status_Tracker_Component, "Reports delivery status", "gRPC")
Rel(EU_National_Gateway_Adapter_Component, Prescription_Status_Tracker_Component, "Reports delivery status", "gRPC")

@enduml