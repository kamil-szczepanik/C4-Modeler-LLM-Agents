@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(webRTC_sfu_video_service, "WebRTC SFU Video Service") {
    Component(Signaling_Room_Manager, "Signaling & Room Manager", "Node.js / TypeScript", "Manages signaling via gRPC and controls room sessions and tracks.")
    Component(Media_Router_Node, "Media Router Node", "Mediasoup Worker in C++ / Node.js", "Powers selective forwarding and simulcast stream adaptation.")
    Component(Bandwidth_Adaptation_Controller, "Bandwidth Adaptation Controller", "C++", "Guarantees resilient, degraded-mode consultations for unstable rural connections by processing media telemetry.")
}

Rel(Signaling_Room_Manager, Media_Router_Node, "Controls media tracks", "IPC (Local Pipe)")
Rel(Media_Router_Node, Bandwidth_Adaptation_Controller, "Feeds telemetry", "Internal Function Call")

@enduml