@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(core_telehealth_service, "Core Telehealth Service") {
    Component(consultation_manager, "Consultation Manager", "Go / Spring Boot", "Manages telehealth consultation sessions between patients and clinicians.")
    Component(consent_privacy_enforcement, "Consent & Privacy Enforcement", "Go / Spring Boot", "Validates patient consent and enforces privacy compliance.")
    Component(prescription_coordinator, "Prescription Coordinator", "Go / Spring Boot", "Coordinates e-prescriptions across regional networks.")
    Component(symptom_assessment_logger, "Symptom Assessment Logger", "Go / Spring Boot", "Logs and persists symptom assessment details and audit trails.")
}

Rel(consultation_manager, consent_privacy_enforcement, "Validates patient consent", "In-memory function call")

@enduml