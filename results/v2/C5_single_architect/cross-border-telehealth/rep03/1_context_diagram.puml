@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_Clinicians, "Patients & Clinicians", "End-users accessing the platform via Mobile and Web Applications for video consultations, e-prescriptions, and AI symptom checking.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and AI symptom checking for patients across the EU and US while enforcing strict regional data residency.")

System_Ext(National_E_Prescription_Networks_EU, "National E-Prescription Networks (EU)", "External systems utilizing country-specific standards (e.g., eHDSI/NCPeH) for European e-prescriptions.")

System_Ext(Pharmacy_Systems_US, "Pharmacy Systems (US)", "External systems utilizing HL7 FHIR for US pharmacy integrations.")

System_Ext(Identity_Providers_Gateways, "Identity Providers & Gateways", "External OAuth2/OIDC IdPs, Payment Gateways, and SMS Notification Gateways.")

Rel(Patients_Clinicians, Cross_Border_Telehealth_Platform, "Accesses application logic and video consultations", "HTTPS (REST) and WebRTC")
Rel(Cross_Border_Telehealth_Platform, National_E_Prescription_Networks_EU, "Sends and receives European e-prescriptions", "Mutual TLS (mTLS) and national standards (e.g., eHDSI/NCPeH)")
Rel(Cross_Border_Telehealth_Platform, Pharmacy_Systems_US, "Sends and receives US e-prescriptions and pharmacy data", "HL7 FHIR over HTTPS (REST)")
Rel(Cross_Border_Telehealth_Platform, Identity_Providers_Gateways, "Authenticates users, processes payments, and sends notifications", "OAuth2/OIDC, HTTPS REST, SMPP/APNs")

@enduml