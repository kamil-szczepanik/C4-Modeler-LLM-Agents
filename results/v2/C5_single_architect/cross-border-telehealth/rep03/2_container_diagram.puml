@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients_and_Clinicians, "Patients and Clinicians", "Users accessing video consultations, e-prescriptions, and AI symptom checker.")

System_Ext(External_National_EPrescription_Networks_and_US_Pharmacy_Systems, "External National E-Prescription Networks and US Pharmacy Systems", "External networks and pharmacy systems for handling cross-border prescriptions.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(Web_Mobile_Frontend_App, "Web/Mobile Frontend App", "Flutter/React", "Provides local caching and user interface for degraded connections.")
    Container(API_Gateway, "API Gateway", "Envoy/GCP API Gateway", "Manages incoming HTTPS and WSS traffic and routes requests.")
    Container(Core_Telehealth_Service, "Core Telehealth Service", "Go/Spring Boot", "Handles core business logic for telehealth consultations.")
    Container(WebRTC_SFU_Video_Service, "WebRTC SFU Video Service", "Mediasoup", "Adapts and routes video streaming for unstable rural internet.")
    Container(AI_Inference_Service, "AI Inference Service", "Python/FastAPI", "Implements traceable symptom checking with immutable audit logs.")
    Container(E_Prescription_Integrator, "E-Prescription Integrator", "Node.js", "Integrates asynchronous e-prescription messaging with external networks.")
    Container(FHIR_Event_Bus, "FHIR Event Bus", "GCP Pub/Sub", "Decouples asynchronous messaging using HL7 FHIR.")
    ContainerDb(Regional_Data_Stores, "Regional Data Stores", "GCP Cloud SQL/Spanner", "Stores partitioned regional data to satisfy GDPR and HIPAA mandates.")
}

Rel(Patients_and_Clinicians, Web_Mobile_Frontend_App, "Interacts with the platform", "HTTPS and WSS")
Rel(Web_Mobile_Frontend_App, API_Gateway, "Sends API requests", "HTTPS and WSS")
Rel(API_Gateway, Core_Telehealth_Service, "Routes API requests", "gRPC")
Rel(API_Gateway, AI_Inference_Service, "Routes symptom check requests", "gRPC")
Rel(Core_Telehealth_Service, WebRTC_SFU_Video_Service, "Establishes video sessions", "WebRTC/UDP")
Rel(Core_Telehealth_Service, FHIR_Event_Bus, "Publishes e-prescription events", "GCP Pub/Sub (HL7 FHIR)")
Rel(FHIR_Event_Bus, E_Prescription_Integrator, "Consumes e-prescription events", "GCP Pub/Sub (HL7 FHIR)")
Rel(E_Prescription_Integrator, External_National_EPrescription_Networks_and_US_Pharmacy_Systems, "Sends e-prescriptions", "REST/SOAP")
Rel(Core_Telehealth_Service, Regional_Data_Stores, "Reads and writes regional data", "SQL")

@enduml