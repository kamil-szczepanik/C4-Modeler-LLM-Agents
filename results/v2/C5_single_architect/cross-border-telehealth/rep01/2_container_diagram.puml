@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients_Clinicians, "Patients & Clinicians", "Users accessing the platform via web and mobile applications for video consultations, e-prescriptions, and symptom checking.")

System_Ext(Identity_Providers_IdP, "Identity Providers (IdP)", "External OAuth2/OIDC systems handling regional user authentication.")
System_Ext(Payment_Gateway, "Payment Gateway", "External service for processing consultation payments.")
System_Ext(External_Pharmacy_Systems, "External Pharmacy Systems", "National EU e-prescription gateways and US pharmacy networks.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(Single_Patient_Mobile_App, "Single-Patient / Mobile App", "Flutter / TypeScript", "Cross-platform client applications for users to interact with the platform.")
    Container(API_Gateway, "API Gateway", "Cloud API Gateway", "Routes and manages incoming traffic to internal microservices.")
    Container(Core_Telehealth_Service, "Core Telehealth Service", "Go / gRPC", "Implements high-performance core business logic for telehealth consultations.")
    Container(AI_Inference_Wrapper, "AI Inference Wrapper", "Python / FastAPI", "Manages AI Symptom Checker inference and traceability logging.")
    Container(SFU_Media_Server_LiveKit, "SFU Media Server / LiveKit", "LiveKit (GKE)", "Provides SFU media streaming with adaptive bitrate for consultations and rural connections.")
    Container(US_FHIR_Adapter, "US FHIR Adapter", "Node.js / TypeScript", "Handles regional interoperability and integrates with US pharmacy systems.")
    Container(EU_EPrescription_Gateway, "EU E-Prescription Gateway", "Java / Spring Boot", "Handles regional interoperability and integrates with national e-prescription standards.")
    ContainerDb(Cloud_SQL_PostgreSQL_Cloud_Storage, "Cloud SQL PostgreSQL & Cloud Storage", "PostgreSQL, Cloud Storage (GCP)", "Secures partitioned regional data storage ensuring data residency.")
}

Rel(Patients_Clinicians, Single_Patient_Mobile_App, "Interacts via video consultations, e-prescriptions, and symptom checking", "HTTPS and WebSockets")
Rel(Single_Patient_Mobile_App, API_Gateway, "Communicates requests to backend services", "HTTPS/mTLS")
Rel(API_Gateway, Core_Telehealth_Service, "Routes core telehealth requests", "gRPC and HTTPS")
Rel(API_Gateway, AI_Inference_Wrapper, "Routes AI symptom check requests", "gRPC and HTTPS")
Rel(API_Gateway, US_FHIR_Adapter, "Routes US-specific integration requests", "gRPC and HTTPS")
Rel(API_Gateway, EU_EPrescription_Gateway, "Routes EU-specific integration requests", "gRPC and HTTPS")
Rel(Single_Patient_Mobile_App, SFU_Media_Server_LiveKit, "Handles peer-to-peer and relayed video streams for consultations", "WebRTC/UDP")
Rel(US_FHIR_Adapter, External_Pharmacy_Systems, "Integrates with US pharmacy systems", "HTTPS/REST")
Rel(EU_EPrescription_Gateway, External_Pharmacy_Systems, "Integrates with national e-prescription standards", "mTLS, SOAP, and REST")
Rel(Core_Telehealth_Service, Cloud_SQL_PostgreSQL_Cloud_Storage, "Persists and retrieves consultation data", "SQL / TCP")
Rel(US_FHIR_Adapter, Cloud_SQL_PostgreSQL_Cloud_Storage, "Persists US region-specific data", "SQL / TCP")
Rel(EU_EPrescription_Gateway, Cloud_SQL_PostgreSQL_Cloud_Storage, "Persists EU region-specific data", "SQL / TCP")
Rel(Single_Patient_Mobile_App, Identity_Providers_IdP, "Authenticates users", "HTTPS (OIDC)")
Rel(Single_Patient_Mobile_App, Payment_Gateway, "Processes consultation billing", "HTTPS/REST")

@enduml