@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Cloud SQL PostgreSQL & Cloud Storage container

Container_Boundary(cloud_sql_postgresql_cloud_storage_boundary, "Cloud SQL PostgreSQL & Cloud Storage") {
    Component(Regional_Database_Instances, "Regional Database Instances", "Cloud SQL PostgreSQL 15", "Persists and retrieves regional data with strict physical separation in europe-west3 and us-central1.")
    Component(Encrypted_Blob_Storage, "Encrypted Blob Storage", "Google Cloud Storage & Cloud KMS", "Stores secure media and prescriptions using Customer-Managed Encryption Keys.")
    Component(Audit_Compliance_Ledger, "Audit & Compliance Ledger", "PostgreSQL extensions, triggers, and RLS", "Writes immutable symptom-checker logs and consent states.")
    Component(Backup_Retention_Manager, "Backup & Retention Manager", "Cloud Storage Lifecycle Rules with object locks", "Manages data retention and backup compliance.")
    Component(Database_Migration_Manager, "Database Migration Manager", "Flyway / Go", "Handles database schema migration and management.")
}

System_Ext(Core_Telehealth_Service, "Core Telehealth Service", "External dependency interacting with the database and ledger")
System_Ext(US_FHIR_Adapter, "US FHIR Adapter", "External dependency interacting with regional databases")
System_Ext(EU_E_Prescription_Gateway, "EU E-Prescription Gateway", "External dependency interacting with regional databases")

Rel(Cloud_SQL_PostgreSQL_Cloud_Storage, Encrypted_Blob_Storage, "Reference secure object URIs for media and prescriptions", "Internal GCP API")
Rel(Core_Telehealth_Service, Regional_Database_Instances, "Persist and retrieve regional data", "PostgreSQL wire protocol / TLS 1.3")
Rel(US_FHIR_Adapter, Regional_Database_Instances, "Persist and retrieve regional data", "PostgreSQL wire protocol / TLS 1.3")
Rel(EU_E_Prescription_Gateway, Regional_Database_Instances, "Persist and retrieve regional data", "PostgreSQL wire protocol / TLS 1.3")
Rel(Core_Telehealth_Service, Audit_Compliance_Ledger, "Write immutable symptom-checker logs and consent states", "SQL / TLS 1.3")

@enduml