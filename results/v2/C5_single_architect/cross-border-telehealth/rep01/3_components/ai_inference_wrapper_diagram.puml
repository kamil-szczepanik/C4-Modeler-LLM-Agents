@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Inference Wrapper container

Container_Boundary(ai_inference_wrapper, "AI Inference Wrapper") {
    Component(AIInferenceWrapper, "AI Inference Wrapper", "Python / FastAPI", "Wraps AI symptom check requests and coordinates inference workflows.")
    Component(InferenceRouter, "Inference Router", "Python / FastAPI", "Routes internal inference operations, dispatches audit logs, and validates consent tokens.")
    Component(ModelClientAdapter, "Model Client Adapter", "Python / LangChain / HTTPX", "Manages reliable model client communication and payload sanitization.")
    Component(AuditTraceabilityLogger, "Audit & Traceability Logger", "Python / Google Cloud Logging & SQLAlchemy", "Logs immutable audit data and ensures traceability.")
    Component(ConsentEnforcementInterceptor, "Consent Enforcement Interceptor", "Python Middleware", "Enforces patient consent tokens for requests.")
}

Rel(AIInferenceWrapper, InferenceRouter, "Delegates requests", "gRPC and HTTPS")
Rel(InferenceRouter, ModelClientAdapter, "Internal function calls", "Python")
Rel(InferenceRouter, AuditTraceabilityLogger, "Asynchronous event dispatch", "Google Cloud Pub/Sub")
Rel(InferenceRouter, ConsentEnforcementInterceptor, "Validates patient consent tokens", "gRPC")

@enduml