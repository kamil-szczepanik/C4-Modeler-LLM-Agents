@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the US FHIR Adapter container

System_Ext(external_pharmacy_systems, "External Pharmacy Systems", "External pharmacy systems")
System_Ext(cloud_sql_postgres_cloud_storage, "Cloud SQL PostgreSQL & Cloud Storage", "GCP Cloud SQL PostgreSQL & Cloud Storage")

Container_Boundary(us_fhir_adapter, "US FHIR Adapter") {
    Component(fhir_router, "FHIR Router", "Node.js / TypeScript / NestJS", "Provides native dependency injection and strict DTO validation, routing integration requests.")
    Component(fhir_mapping_engine, "FHIR Mapping Engine", "Node.js / TypeScript", "Handles data transformation for HL7 FHIR standards.")
    Component(pharmacy_integration_client, "Pharmacy Integration Client", "Node.js / TypeScript", "Sends e-prescriptions to external pharmacy systems.")
    Component(us_persistence_repository, "US Persistence Repository", "Node.js / TypeScript", "Persists US-specific data and enforces mandatory access logging.")
    Component(audit_logger, "Audit Logger", "Node.js / TypeScript", "Emits and logs audit events to enforce compliance.")
}

Rel(fhir_router, fhir_mapping_engine, "Delegates transformation", "In-process function calls")
Rel(fhir_router, audit_logger, "Emits audit events", "In-process event emitter")
Rel(us_persistence_repository, audit_logger, "Enforces mandatory access logging", "In-process")
Rel(us_persistence_repository, cloud_sql_postgres_cloud_storage, "Persists US-specific data", "SQL / TCP, locked to us-central1")
Rel(pharmacy_integration_client, external_pharmacy_systems, "Sends e-prescriptions", "HTTPS/REST")

@enduml