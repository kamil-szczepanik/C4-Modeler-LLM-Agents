@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Single-Patient / Mobile App container

System_Ext(api_gateway, "API Gateway", "External API Gateway")
System_Ext(livekit_sfu, "LiveKit SFU Media Server", "External Media Server")
System_Ext(sqlcipher, "SQLCipher", "Encrypted local database storage")

Container_Boundary(mobile_app, "Single-Patient / Mobile App") {
    Component(ui_layer, "UI Layer / Presentation Components", "Flutter / Dart", "Provides the user interface and presentation components for cross-platform mobile interaction.")
    Component(local_sync, "Local Sync & State Management Component", "Hive/SQLite with SQLCipher", "Secures encrypted local caching and manages offline-first operations for unstable network connections.")
    Component(api_client, "API Client & Gateway Adapter Component", "Flutter / Dart", "Communicates backend requests securely via HTTPS/mTLS and gRPC-Web.")
    Component(webrtc_client, "WebRTC Client Component", "LiveKit SDK", "Handles media streams, adaptive bitrate streaming, and degraded network recovery.")
    Component(security_comp, "Security & Cryptography Component", "flutter_secure_storage", "Secures local storage for OAuth tokens and credentials.")
    Component(consent_comp, "Consent Enforcement Component", "Flutter / Dart", "Queries consent flags prior to dispatch to ensure regional data sovereignty.")
}

Rel(ui_layer, consent_comp, "Queries consent flags prior to dispatch", "Internal Dart Method Calls")
Rel(api_client, consent_comp, "Queries consent flags prior to dispatch", "Internal Dart Method Calls")
Rel(local_sync, sqlcipher, "Secures encrypted local caching", "Local I/O")
Rel(mobile_app, api_gateway, "Communicates backend requests", "HTTPS/mTLS and gRPC-Web")
Rel(mobile_app, livekit_sfu, "Handles media streams", "WebRTC/UDP")

@enduml