@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the SFU Media Server / LiveKit container

Container_Boundary(sfu_media_server_livekit, "SFU Media Server / LiveKit") {
    Component(sfu_room_session_manager, "SFU Room & Session Manager", "Go, LiveKit Core", "Manages room lifecycles and session coordination.")
    Component(media_forwarding_engine, "Media Forwarding Engine", "Go, WebRTC", "Forwards real-time audio and video streams using WebRTC.")
    Component(turn_ice_relay_service, "TURN / ICE Relay Service", "Coturn, LiveKit Egress", "Provides NAT traversal for restricted rural networks.")
    Component(recording_egress_service, "Recording & Egress Service", "LiveKit Egress, Go", "Archives session media.")
}

System_Ext(core_telehealth_service, "Core Telehealth Service", "Core Telehealth Service")
System_Ext(cloud_storage_gcp, "Cloud Storage (GCP)", "Cloud Storage (GCP)")

Rel(sfu_room_session_manager, core_telehealth_service, "Validates room entry", "gRPC")
Rel(media_forwarding_engine, recording_egress_service, "Triggers media archiving", "gRPC")
Rel(recording_egress_service, cloud_storage_gcp, "Persists encrypted recordings", "HTTPS/TLS")

@enduml