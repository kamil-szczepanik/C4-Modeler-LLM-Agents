@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Telehealth Service container

Container_Boundary(core_telehealth_service, "Core Telehealth Service") {
    Component(Consultation Manager, "Consultation Manager", "Go", "Handles scheduling, session lifecycle, and real-time coordination.")
    Component(Prescription Coordinator, "Prescription Coordinator", "Go", "Manages e-prescription workflows routed to regional integration gateways.")
    Component(Consent & Policy Engine, "Consent & Policy Engine", "Go", "Enforces GDPR/HIPAA data residency and verifies purpose-based patient consents.")
    Component(Audit & Traceability Logger, "Audit & Traceability Logger", "Go", "Captures cryptographically signed audit trails for AI recommendations and cross-region data access.")
    Component(Symptom Checker Orchestrator, "Symptom Checker Orchestrator", "Go", "Manages secure interactions with the AI Inference Wrapper and ensures model version logging.")
}

System_Ext(LiveKit SFU Media Server, "LiveKit SFU Media Server", "Manages video streaming sessions.")
System_Ext(US FHIR Adapter & EU E-Prescription Gateway, "US FHIR Adapter & EU E-Prescription Gateway", "Translates prescriptions to regional standards.")
System_Ext(AI Inference Wrapper, "AI Inference Wrapper", "Provides AI urgency recommendations.")
System_Ext(Cloud SQL PostgreSQL & Cloud Storage, "Cloud SQL PostgreSQL & Cloud Storage", "Persists domain data and audit logs.")

Rel(Consultation Manager, LiveKit SFU Media Server, "Coordinates video rooms", "gRPC")
Rel(Prescription Coordinator, US FHIR Adapter & EU E-Prescription Gateway, "Dispatches prescriptions", "gRPC")
Rel(Symptom Checker Orchestrator, AI Inference Wrapper, "Requests urgency recommendations", "gRPC/HTTPS")
Rel(Consultation Manager, Cloud SQL PostgreSQL & Cloud Storage, "Persists transactional and audit data", "SQL/TCP")
Rel(Prescription Coordinator, Cloud SQL PostgreSQL & Cloud Storage, "Persists transactional and audit data", "SQL/TCP")
Rel(Consent & Policy Engine, Cloud SQL PostgreSQL & Cloud Storage, "Persists transactional and audit data", "SQL/TCP")
Rel(Audit & Traceability Logger, Cloud SQL PostgreSQL & Cloud Storage, "Persists transactional and audit data", "SQL/TCP")
Rel(Symptom Checker Orchestrator, Cloud SQL PostgreSQL & Cloud Storage, "Persists transactional and audit data", "SQL/TCP")
Rel(Consultation Manager, Consent & Policy Engine, "Intercepts data access for policy verification", "In-Memory Go Interfaces")
Rel(Prescription Coordinator, Consent & Policy Engine, "Intercepts data access for policy verification", "In-Memory Go Interfaces")
Rel(Audit & Traceability Logger, Consent & Policy Engine, "Intercepts data access for policy verification", "In-Memory Go Interfaces")
Rel(Symptom Checker Orchestrator, Consent & Policy Engine, "Intercepts data access for policy verification", "In-Memory Go Interfaces")

@enduml