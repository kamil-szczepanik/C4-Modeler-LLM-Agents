@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Routing_Regional_Dispatcher, "Routing & Regional Dispatcher", "Go / Envoy Proxy", "High-performance regional routing and dispatching of internal requests.")
    Component(JWT_mTLS_Termination_Filter, "JWT & mTLS Termination Filter", "Envoy Proxy Filter / Security Component", "Terminates incoming encrypted HTTPS/mTLS traffic and handles JWT authentication.")
    Component(Rate_Limiting_Circuit_Breaker, "Rate Limiting & Circuit Breaker", "Envoy Proxy / Traffic Management Component", "Protects backend services by managing traffic rates and failing fast over unstable networks.")
    Component(Compliance_Audit_Logger, "Compliance Audit Logger", "Go / Logging Component", "Logs routing telemetry and sends compliance data for auditing.")
}

Rel(JWT_mTLS_Termination_Filter, Routing_Regional_Dispatcher, "Passes authenticated and decrypted traffic", "Internal")
Rel(Routing_Regional_Dispatcher, Compliance_Audit_Logger, "Sends routing telemetry", "Internal gRPC")
@enduml