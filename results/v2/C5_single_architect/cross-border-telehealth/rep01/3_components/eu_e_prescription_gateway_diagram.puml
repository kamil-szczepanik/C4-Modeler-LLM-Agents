@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(eu_eprescription_gateway, "EU E-Prescription Gateway") {
    Component(Prescription Orchestrator, "Prescription Orchestrator", "Spring Batch/Core", "Component managing workflow state.")
    Component(National Adapter Engine, "National Adapter Engine", "Spring Integration", "Component hosting pluggable protocol adapters.")
    Component(Audit & Compliance Logger, "Audit & Compliance Logger", "Java / Spring Boot", "Component recording translation and dispatch actions.")
    Component(Consent Enforcement Interceptor, "Consent Enforcement Interceptor", "Spring Security / Aspect", "Component validating patient consent.")
}

System_Ext(Cloud SQL PostgreSQL, "Cloud SQL PostgreSQL", "GCP Database")
System_Ext(External Pharmacy Systems, "External Pharmacy Systems", "National EU pharmacy systems using diverse standards.")
System_Ext(API Gateway, "API Gateway", "Cloud API Gateway")

Rel(API Gateway, Consent Enforcement Interceptor, "Routes EU-specific requests", "gRPC / mTLS, signed JWTs")
Rel(Consent Enforcement Interceptor, National Adapter Engine, "Internal dispatch after consent validation.", "")
Rel(Prescription Orchestrator, Cloud SQL PostgreSQL, "Persists region-specific data", "JDBC (SQL/TCP, encrypted)")
Rel(National Adapter Engine, External Pharmacy Systems, "Integrates with national standards", "mTLS, SOAP, and REST")
@enduml