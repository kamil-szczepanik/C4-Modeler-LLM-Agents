@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(PatientsClinicians, "Patients & Clinicians", "External users accessing the platform via web and mobile applications for video consultations, e-prescriptions, and symptom checking.")
System(CrossBorderTelehealthPlatform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and the US while ensuring strict regional data residency and regulatory compliance.")
System_Ext(IdentityProvidersIdP, "Identity Providers (IdP)", "External OAuth2/OIDC systems handling regional user authentication.")
System_Ext(PaymentGateway, "Payment Gateway", "External service (e.g., Stripe) for processing consultation payments.")
System_Ext(ExternalPharmacySystems, "External Pharmacy Systems", "National EU e-prescription gateways and US pharmacy networks.")
System_Ext(AISymptomChecker, "AI Symptom Checker", "Integrated AI engine for urgency recommendations with strict version logging.")

Rel(PatientsClinicians, CrossBorderTelehealthPlatform, "Accesses video consultations and platform features", "HTTPS and WebRTC")
Rel(CrossBorderTelehealthPlatform, IdentityProvidersIdP, "Authenticates users", "HTTPS (OIDC)")
Rel(CrossBorderTelehealthPlatform, PaymentGateway, "Processes consultation billing", "HTTPS/REST")
Rel(CrossBorderTelehealthPlatform, ExternalPharmacySystems, "Submits e-prescriptions", "HTTPS (HL7 FHIR & national standards)")
Rel(CrossBorderTelehealthPlatform, AISymptomChecker, "Requests urgency recommendations and AI analysis", "gRPC/HTTPS")

@enduml