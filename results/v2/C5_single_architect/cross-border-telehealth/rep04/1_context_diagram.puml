@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Cross-Border Telehealth Platform

Person(Patient, "Patient", "End-user utilizing mobile and web clients for video consultations, symptom checks, and consent management.")
Person(Clinician, "Clinician", "Licensed medical professional conducting consultations and issuing prescriptions.")

System(CrossBorderTelehealthPlatform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and US, ensuring strict data residency, regulatory compliance, and interoperability across international healthcare networks.")

System_Ext(ExternalPharmacySystems, "External Pharmacy Systems", "Receives e-prescriptions via regional protocols.")
System_Ext(AIModelProviderLLMAPI, "AI Model Provider / LLM API", "External service powering the symptom checker.")
System_Ext(NationalIdentityProviders, "National Identity Providers", "External authentication systems using eIDAS and Login.gov for user authentication and jurisdictional verification.")
System_Ext(NationalHealthRegistries, "National Health Registries", "Country-specific health data exchanges and US HIEs for patient history and audit compliance.")

Rel(Patient, CrossBorderTelehealthPlatform, "Video consultations, symptom checks, and consent management.", "HTTPS/WebRTC")
Rel(Clinician, CrossBorderTelehealthPlatform, "Consultations and prescription authoring.", "HTTPS")
Rel(CrossBorderTelehealthPlatform, ExternalPharmacySystems, "E-prescription dispatch.", "REST/FHIR")
Rel(CrossBorderTelehealthPlatform, NationalIdentityProviders, "User authentication and jurisdictional verification.", "OIDC/SAML")
Rel(CrossBorderTelehealthPlatform, NationalHealthRegistries, "Patient history and audit compliance.", "REST/FHIR")

@enduml