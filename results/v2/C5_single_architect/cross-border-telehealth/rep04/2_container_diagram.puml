@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patient, "Patient", "End-user utilizing mobile and web clients for video consultations, symptom checks, and consent management.")
Person(Clinician, "Clinician", "Licensed medical professional conducting consultations and issuing prescriptions.")

System_Ext(ExternalPharmacySystems, "External Pharmacy Systems", "Receives e-prescriptions via regional protocols.")
System_Ext(AIModelProviderLLMAPI, "AI Model Provider / LLM API", "External service powering the symptom checker.")
System_Ext(NationalIdentityProviders, "National Identity Providers", "External authentication systems using eIDAS and Login.gov for user authentication and jurisdictional verification.")
System_Ext(NationalHealthRegistries, "National Health Registries", "Country-specific health data exchanges and US HIEs for patient history and audit compliance.")

System_Boundary(CrossBorderTelehealthPlatform, "Cross-Border Telehealth Platform") {
    Container(WebMobileClientSPAPWA, "Web/Mobile Client SPA/PWA", "Flutter/React", "Provides user interface for patients and clinicians.")
    Container(GoogleCloudAPIGateway, "Google Cloud API Gateway", "GCP API Gateway", "Entry point for client requests.")
    Container(DataResidencyConsentRouter, "Data Residency & Consent Router", "Go", "Enforces data residency boundaries and routes requests based on region and consent.")
    Container(CoreServicesBackend, "Core Services Backend", "Go/Spring Boot", "Handles core platform business logic and services.")
    Container(AISymptomCheckerService, "AI Symptom Checker Service", "Python/FastAPI", "Powers the AI symptom checker using ML libraries.")
    Container(VideoStreamingServer, "Video Streaming Server", "LiveKit WebRTC SFU on GKE", "Supports adaptive video streaming below 300 kbit/s.")
    Container(InteroperabilityAdapter, "Interoperability Adapter", "Node.js/TypeScript", "Handles FHIR/JSON manipulation for cross-border integration.")
    ContainerDb(CloudSQLPostgreSQL, "Cloud SQL PostgreSQL", "PostgreSQL", "Stores partitioned regional transactional data.")
}

Rel(Patient, WebMobileClientSPAPWA, "Interacts with platform via mobile or web client.", "HTTPS/WSS")
Rel(Clinician, WebMobileClientSPAPWA, "Interacts with platform via client applications.", "HTTPS/WSS")
Rel(WebMobileClientSPAPWA, GoogleCloudAPIGateway, "Sends API requests and handles communications.", "HTTPS/WSS")
Rel(GoogleCloudAPIGateway, DataResidencyConsentRouter, "Routes inbound requests.", "gRPC")
Rel(DataResidencyConsentRouter, CoreServicesBackend, "Forwards validated requests to core services.", "gRPC")
Rel(CoreServicesBackend, CloudSQLPostgreSQL, "Persists and queries transactional health data.", "TCP/SQL")
Rel(VideoStreamingServer, WebMobileClientSPAPWA, "Provides video consultations.", "WebRTC over UDP/TCP")
Rel(AISymptomCheckerService, AIModelProviderLLMAPI, "Queries external LLM API for symptom analysis.", "HTTPS")
Rel(CoreServicesBackend, InteroperabilityAdapter, "Exchanges health data with external registries and systems.", "REST/FHIR")
Rel(InteroperabilityAdapter, ExternalPharmacySystems, "Dispatches e-prescriptions.", "REST/FHIR")
Rel(InteroperabilityAdapter, NationalHealthRegistries, "Synchronizes patient history and audit logs.", "REST/FHIR")
Rel(DataResidencyConsentRouter, NationalIdentityProviders, "Authenticates users and verifies jurisdictions.", "OIDC/SAML")

@enduml