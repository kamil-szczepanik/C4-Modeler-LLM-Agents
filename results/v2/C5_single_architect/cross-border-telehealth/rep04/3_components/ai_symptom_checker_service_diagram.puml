@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Symptom Checker Service container

System_Boundary(ai_symptom_checker_service, "AI Symptom Checker Service") {
    Component(api_router_validator, "API Router & Validator", "Python / FastAPI", "High-performance framework for rapid API routing and payload validation using Pydantic for strict data schema validation ensuring compliance with healthcare data formats.")
    Component(region_aware_orchestrator, "Region-Aware Orchestrator", "Python", "Orchestrates regional data routing, enforces strict payload minimization, and manages the flow between validation, LLM integration, and auditing.")
    Component(audit_traceability_logger, "Audit & Traceability Logger", "Python / SQLAlchemy / Structured Logging", "Captures immutable audit trails for MDR and HIPAA compliance.")
    Component(llm_integration_client, "LLM Integration Client", "Python / HTTPX", "Asynchronous HTTP client providing robust LLM API communication with circuit breakers.")
    Component(cloud_sql_postgresql, "Cloud SQL PostgreSQL", "Database", "Regional relational database for secure, structured writes.")
}

Component_Ext(ai_model_provider_llm_api, "AI Model Provider / LLM API", "External System", "External system providing LLM-based symptom analysis.")

Rel(api_router_validator, region_aware_orchestrator, "In-memory function call with Pydantic models")
Rel(region_aware_orchestrator, llm_integration_client, "Asynchronous method call")
Rel(llm_integration_client, ai_model_provider_llm_api, "HTTPS / REST with TLS 1.3")
Rel(region_aware_orchestrator, audit_traceability_logger, "Local asynchronous event emission")
Rel(audit_traceability_logger, cloud_sql_postgresql, "SQLAlchemy / SQL over secure TCP")

@enduml