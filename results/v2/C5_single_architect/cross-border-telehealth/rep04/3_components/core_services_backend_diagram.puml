@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Services Backend container

Container_Boundary(core_services_backend, "Core Services Backend") {
    Component(Patient__Clinician_Management_Component, "Patient & Clinician Management Component", "Go, Gin/Fiber", "Manages patient and clinician profiles and operations.")
    Component(Consultation_Coordinator_Component, "Consultation Coordinator Component", "Go", "Orchestrates consultations and persists booking states.")
    Component(Prescription_Management_Component, "Prescription Management Component", "Go", "Manages prescriptions and dispatches payloads.")
    Component(Audit___Traceability_Component, "Audit & Traceability Component", "Go", "Writes tamper-evident audit trails for medical traceability.")
    Component(Region_Aware_Data_Router_Component, "Region-Aware Data Router Component", "Go", "Delegates and executes region-isolated transactional queries to ensure data residency compliance.")
    ComponentDb(Cloud_SQL_PostgreSQL, "Cloud SQL PostgreSQL", "GCP Database, PostgreSQL", "Relational database deployed regionally for data residency compliance.")
    Component(Interoperability_Adapter, "Interoperability Adapter", "Node.js/TypeScript", "External adapter for dispatching prescription payloads via gRPC.")
}

Rel(Consultation_Coordinator_Component, Cloud_SQL_PostgreSQL, "Persists booking states", "TCP/SQL")
Rel(Prescription_Management_Component, Interoperability_Adapter, "Dispatches prescription payloads", "gRPC")
Rel(Audit___Traceability_Component, Cloud_SQL_PostgreSQL, "Writes tamper-evident audit trails", "TCP/SQL")
Rel(Patient__Clinician_Management_Component, Region_Aware_Data_Router_Component, "Delegates persistence operations", "In-process Go interface")
Rel(Consultation_Coordinator_Component, Region_Aware_Data_Router_Component, "Delegates persistence operations", "In-process Go interface")
Rel(Prescription_Management_Component, Region_Aware_Data_Router_Component, "Delegates persistence operations", "In-process Go interface")
Rel(Region_Aware_Data_Router_Component, Cloud_SQL_PostgreSQL, "Executes region-isolated transactional queries", "TCP/SQL")

@enduml