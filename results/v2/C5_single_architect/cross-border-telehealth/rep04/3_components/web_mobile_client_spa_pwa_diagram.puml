@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(web_mobile_client, "Web/Mobile Client SPA/PWA") {
    Component(ui_presentation_layer, "UI Presentation Layer", "Flutter & React (SPA/PWA)", "Provides multi-platform UI consistency for patients and clinicians.")
    Component(state_sync_manager, "State & Sync Manager", "TypeScript / Dart State Management", "Manages application state and offline-first capabilities.")
    Component(secure_local_repository, "Secure Local Repository", "Encrypted SQLite and IndexedDB using AES-256 via Web Crypto API", "Handles secure caching of PHI/PII data locally.")
    Component(webrtc_media_client, "WebRTC Media Client", "WebRTC", "Streams video consultations with adaptive bitrate scaling.")
}

Rel(ui_presentation_layer, state_sync_manager, "Updates and retrieves application state")
Rel(state_sync_manager, secure_local_repository, "Reads and writes encrypted local data via")
Rel(ui_presentation_layer, webrtc_media_client, "Initiates video consultation sessions through")

@enduml