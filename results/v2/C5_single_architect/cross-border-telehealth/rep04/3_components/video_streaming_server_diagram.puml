@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(video_streaming_server, "Video Streaming Server") {
    Component(SignalingComponent, "Signaling Component", "LiveKit WebRTC SFU / Go", "Handles signaling and configures media tracks for video consultations.")
    Component(SFUMediaRouter, "SFU Media Router", "LiveKit WebRTC SFU", "Routes and transmits adaptive media streams to clients.")
    Component(RecordingAuditSidecar, "Recording & Audit Sidecar", "Go", "Manages recording and auditing for video sessions.")
    Component(MediaPolicyTokenEnforcer, "Media Policy & Token Enforcer", "Go", "Validates regional access tokens and verifies patient consent state.")
}

System_Ext(WebMobileClient, "Web/Mobile Client SPA/PWA", "Flutter/React")
System_Ext(DataResidencyConsentRouter, "Data Residency & Consent Router", "Go")

Rel(SignalingComponent, MediaPolicyTokenEnforcer, "Validates regional access tokens", "In-memory function call")
Rel(MediaPolicyTokenEnforcer, DataResidencyConsentRouter, "Verifies patient consent state", "gRPC over TLS")
Rel(SignalingComponent, SFUMediaRouter, "Configures media tracks", "Internal gRPC")
Rel(SFUMediaRouter, WebMobileClient, "Transmits adaptive media streams", "WebRTC over UDP/ICE/DTLS")

@enduml