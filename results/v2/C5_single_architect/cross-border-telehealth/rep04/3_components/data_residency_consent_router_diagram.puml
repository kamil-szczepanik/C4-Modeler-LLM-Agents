@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(data_residency_router, "Data Residency & Consent Router") {
    Component(Geo_Routing_Policy_Engine, "Geo-Routing Policy Engine", "Go", "Evaluates inbound client requests against regional data residency policies.")
    Component(Consent_Interceptor_Middleware, "Consent Interceptor Middleware", "Go", "Intercepts requests to validate patient consent and queries regional consent state.")
    Component(Audit_Logger, "Audit Logger", "Go", "Logs compliance events and requests for auditing purposes.")
    Component(Regional_Proxy_Dispatcher, "Regional Proxy Dispatcher", "Go", "Triggers inter-region dispatch upon verified consent to forward requests to region-pinned instances.")
}

ContainerDb(Cloud_SQL_PostgreSQL, "Cloud SQL PostgreSQL", "PostgreSQL", "Regional database instances.")

Rel(Geo_Routing_Policy_Engine, Consent_Interceptor_Middleware, "Passes validated regional context", "In-memory Go struct")
Rel(Consent_Interceptor_Middleware, Regional_Proxy_Dispatcher, "Triggers inter-region dispatch upon verified consent", "In-memory")
Rel(Consent_Interceptor_Middleware, Cloud_SQL_PostgreSQL, "Queries regional consent state", "pgx / gRPC")

@enduml