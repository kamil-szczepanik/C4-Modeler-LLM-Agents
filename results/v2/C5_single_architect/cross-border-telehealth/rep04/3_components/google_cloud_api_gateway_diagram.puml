@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(google_cloud_api_gateway, "Google Cloud API Gateway") {
    Component(api_router_regional_dispatcher, "API Router & Regional Dispatcher", "Envoy / Go", "Routes incoming requests and dispatches payloads to regional destinations.")
    Component(authentication_authorization_filter, "Authentication & Authorization Filter", "Envoy Filter", "Validates security tokens for incoming requests.")
    Component(rate_limiting_resiliency_policy_enforcer, "Rate Limiting & Resiliency Policy Enforcer", "Envoy Extension", "Enforces rate limits and resiliency policies across regional networks.")
    Component(audit_telemetry_logger, "Audit & Telemetry Logger", "Cloud Pub/Sub / gRPC", "Streams request metadata and audit logs for compliance.")
}

Rel(api_router_regional_dispatcher, authentication_authorization_filter, "Validates tokens", "Internal gRPC")
Rel(api_router_regional_dispatcher, data_residency_consent_router, "Forwards regional payloads", "gRPC")
Rel(api_router_regional_dispatcher, audit_telemetry_logger, "Streams request metadata", "Cloud Pub/Sub / gRPC")
@enduml