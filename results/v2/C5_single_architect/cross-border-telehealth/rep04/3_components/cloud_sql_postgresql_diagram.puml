@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(cloud_sql_postgresql, "Cloud SQL PostgreSQL") {
    Component(Regional_Database_Instances, "Regional Database Instances", "PostgreSQL 15", "Regional database instances (europe-west3 and us-central1) for data residency compliance.")
    Component(Database_Schema___Partitioning_Layer, "Database Schema & Partitioning Layer", "PostgreSQL Row-Level Security", "Database schema and partitioning layer utilizing PostgreSQL Row-Level Security for tenant isolation.")
    Component(Audit_Logging_Extension, "Audit Logging Extension", "pgAudit", "Database extension for comprehensive logging to satisfy AI traceability and accountability (R-07).")
    Component(Connection_Pooling___Encryption_Component, "Connection Pooling & Encryption Component", "Cloud SQL Auth Proxy & GCP Cloud KMS", "Secure connection management and Customer-Managed Encryption Keys (CMEK) for data privacy.")
}

Rel(Connection_Pooling___Encryption_Component, Regional_Database_Instances, "Forwards authenticated queries to regional databases", "")

@enduml