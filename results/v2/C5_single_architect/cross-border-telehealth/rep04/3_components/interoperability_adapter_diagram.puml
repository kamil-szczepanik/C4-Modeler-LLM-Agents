@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Interoperability Adapter container

Container_Boundary(interoperability_adapter, "Interoperability Adapter") {
    Component(Regional_Routing_Enforcer, "Regional Routing Enforcer", "TypeScript", "Routes payloads based on jurisdiction.")
    Component(FHIR_Translation_Engine, "FHIR Translation Engine", "TypeScript/HAPI FHIR JS", "Translates payloads into validated US FHIR resources.")
    Component(EU_National_Standard_Transformer, "EU National Standard Transformer", "TypeScript", "Transforms payloads into localized EU standard formats.")
    Component(Outbound_Integration_Dispatcher, "Outbound Integration Dispatcher", "TypeScript/Axios", "Dispatches payloads securely to external health systems and registries.")
}

Rel(Regional_Routing_Enforcer, FHIR_Translation_Engine, "Routes payloads based on jurisdiction", "In-memory")
Rel(Regional_Routing_Enforcer, EU_National_Standard_Transformer, "Routes payloads based on jurisdiction", "In-memory")
Rel(FHIR_Translation_Engine, Outbound_Integration_Dispatcher, "Passes validated US FHIR resources", "In-memory")
Rel(EU_National_Standard_Transformer, Outbound_Integration_Dispatcher, "Passes localized EU payloads", "In-memory")

@enduml