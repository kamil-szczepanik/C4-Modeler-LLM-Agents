@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit & Traceability Ledger container

Person(AuthorizedAuditors, "Authorized Auditors", "Authorized auditors who query compliance logs.")
System_Ext(AIInferenceWrapper, "AI Inference Wrapper", "AI Inference Wrapper container.")
System_Ext(BigQuery, "BigQuery", "BigQuery storage with WORM policies.")

Container_Boundary(AuditTraceabilityLedger, "Audit & Traceability Ledger") {
    Component(IngestRouter, "Ingest Router", "Go / gRPC", "Publishes and routes incoming audit events via Cloud Pub/Sub.")
    Component(ComplianceResidencyEnforcer, "Compliance & Residency Enforcer", "Go", "Enforces regional data residency and compliance, writing region-locked records to BigQuery.")
    Component(LedgerStorageAdapter, "Ledger Storage Adapter", "BigQuery Storage API", "Interfaces with BigQuery with WORM policies for immutable audit ledgers.")
    Component(AuditQueryAPI, "Audit Query API", "gRPC over mTLS", "Provides an interface for authorized auditors to query compliance logs securely.")
}

Rel(AIInferenceWrapper, IngestRouter, "Publishes audit events via gRPC over Cloud Pub/Sub", "gRPC / Cloud Pub/Sub")
Rel(ComplianceResidencyEnforcer, BigQuery, "Writes region-locked audit records via BigQuery Storage API (HTTPS/gRPC)", "BigQuery Storage API")
Rel(AuthorizedAuditors, AuditQueryAPI, "Queries compliance logs via gRPC over mTLS (HTTPS)", "gRPC over mTLS")

@enduml