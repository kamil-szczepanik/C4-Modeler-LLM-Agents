@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("ai_inference_wrapper", "AI Inference Wrapper") {
    Component(Inference Controller, "Inference Controller", "Python, FastAPI", "Manages incoming inference requests, routing them through sanitization and execution, and triggering audit logs.")
    Component(Regional Data Sanitizer, "Regional Data Sanitizer", "Python, Pandas", "Enforces regional data isolation and sanitizes input data to comply with GDPR and HIPAA mandates.")
    Component(Model Execution Engine, "Model Execution Engine", "Python, PyTorch, Vertex AI SDK", "Executes the AI symptom-checker model and interacts with the external AI Model Registry.")
    Component(Audit & Logging Interceptor, "Audit & Logging Interceptor", "Python middleware", "Captures audit and traceability logs asynchronously for regulatory compliance and AI output tracking.")
}

Rel(Inference Controller, Regional Data Sanitizer, "Passes input data for regional sanitization", "In-memory Python call")
Rel(Regional Data Sanitizer, Model Execution Engine, "Passes sanitized data for model execution", "In-memory Python call")
Rel(Inference Controller, Audit & Logging Interceptor, "Dispatches audit logs", "Async queue")

@enduml