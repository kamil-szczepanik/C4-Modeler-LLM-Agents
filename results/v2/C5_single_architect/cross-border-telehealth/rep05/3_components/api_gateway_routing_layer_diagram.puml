@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_boundary, "API Gateway & Routing Layer") {
    Component(Geo_Routing_Policy_Engine, "Geo-Routing Policy Engine", "Google Cloud Load Balancing & Apigee", "Handles regional geo-routing, TLS termination, and directs EU and US traffic to appropriate regional clusters.")
    Component(WebRTC_Signaling_Router, "WebRTC Signaling Router", "Envoy", "Routes SDP offers and manages real-time session negotiation for video consultations.")
    Component(JWT_Validation___Consent_Enforcement_Filter, "JWT Validation & Consent Enforcement Filter", "Apigee Policy Filter", "Validates tokens and verifies patient/clinician consent before requests reach core services.")
}

Rel(Geo_Routing_Policy_Engine, WebRTC_Signaling_Router, "Routes real-time signaling", "TCP / WebRTC")
Rel(JWT_Validation___Consent_Enforcement_Filter, Geo_Routing_Policy_Engine, "Enforces policies on incoming requests", "HTTPS")

@enduml