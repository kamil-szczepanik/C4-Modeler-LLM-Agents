@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Datastores container

Container_Boundary(Datastores, "Datastores") {
    Component(PrimaryOperationalDB, "Primary Operational DB", "Cloud SQL PostgreSQL per region", "Manages regional operational data, user profiles, and encrypted metadata.")
    Component(AIAuditStore, "AI Audit Store", "BigQuery per region", "Maintains tamper-evident, append-only logs for AI traceability and audits.")
    Component(ConsentEncryptionKeyStore, "Consent & Encryption Key Store", "Cloud KMS / Secret Manager per region", "Handles regional envelope encryption and consent mappings.")
}

Rel(PrimaryOperationalDB, ConsentEncryptionKeyStore, "Validates patient revocation flags", "Internal gRPC")

@enduml