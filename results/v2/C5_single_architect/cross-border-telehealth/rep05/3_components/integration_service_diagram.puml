@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Service container

Container_Boundary(IntegrationService, "Integration Service") {
    Component(EPrescriptionRouterComponent, "E-Prescription Router Component", "Go", "Orchestrates and routes prescription payloads.")
    Component(DataResidencyGuardComponent, "Data Residency Guard Component", "Go", "Validates regional routing rules and prevents cross-region data leaks.")
    Component(EUAdapterComponent, "EU Adapter Component", "Go", "Translates models to National e-Prescription Standards.")
    Component(USAdapterComponent, "US Adapter Component", "Go", "Formats messages into HL7 FHIR.")
}

Component(EUNationalEPrescriptionGateways, "EU National E-Prescription Gateways", "REST / HTTPS", "External EU National E-Prescription Gateways.")
Component(USSurescriptsPharmacyClearinghouses, "US Surescripts / Pharmacy Clearinghouses", "HL7 FHIR / HTTPS", "External US Surescripts and Pharmacy Clearinghouses.")
Component(AuditTraceabilityLedger, "Audit & Traceability Ledger", "Cloud Pub/Sub and BigQuery", "Emits and stores routing audit events.")

Rel(EPrescriptionRouterComponent, DataResidencyGuardComponent, "Validates regional routing rules", "In-memory function call")
Rel(DataResidencyGuardComponent, EUAdapterComponent, "Dispatches EU-bound payloads", "In-memory")
Rel(DataResidencyGuardComponent, USAdapterComponent, "Dispatches US-bound payloads", "In-memory")
Rel(DataResidencyGuardComponent, AuditTraceabilityLedger, "Emits routing audit events", "Cloud Pub/Sub")
Rel(EUAdapterComponent, EUNationalEPrescriptionGateways, "Sends prescriptions", "HTTPS / REST")
Rel(USAdapterComponent, USSurescriptsPharmacyClearinghouses, "Submits e-prescriptions", "HL7 FHIR / HTTPS")
@enduml