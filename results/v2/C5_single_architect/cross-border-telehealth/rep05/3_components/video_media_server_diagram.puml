@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Video Media Server container

Container_Boundary(video_media_server, "Video Media Server") {
    Component(sfu_core_router, "SFU Core Router", "Pion WebRTC / Go", "Routes media streams between participants during video consultations.")
    Component(abr_controller, "ABR Controller", "Go", "Manages adaptive bitrate streaming for unstable network connections.")
    Component(turn_stun_relay_module, "TURN/STUN Relay Module", "Coturn", "Handles NAT traversal and relaying of media streams.")
    Component(media_recording_compliance_logger, "Media Recording & Compliance Logger", "GStreamer / Go", "Records session media and forwards RTP streams for compliance.")
}

System_Ext(apis_signaling_service, "APIs & Signaling Service", "Core Telehealth Service / GKE")
System_Ext(datastores, "Datastores (Cloud SQL PostgreSQL / Cloud Storage)", "Cloud SQL / Cloud Storage", "Persists encrypted data and media chunks.")

Rel(sfu_core_router, apis_signaling_service, "Session setup", "gRPC / Protobuf")
Rel(sfu_core_router, media_recording_compliance_logger, "Forwards RTP streams", "Internal gRPC/RTP")
Rel(media_recording_compliance_logger, datastores, "Persists encrypted media chunks", "HTTPS / GCP IAM")

@enduml