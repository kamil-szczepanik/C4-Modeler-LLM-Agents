@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Telehealth Service container

Container_Boundary(core_telehealth_service, "Core Telehealth Service") {
    Component(ConsultationSessionManager, "Consultation Session Manager", "Go", "Coordinates media stream parameters and manages video consultation sessions.")
    Component(PrescriptionCoordinator, "Prescription Coordinator", "Go", "Routes prescription payloads to the integration service.")
    Component(ConsentEnforcementEngine, "Consent Enforcement Engine", "Go", "Executes localized queries and enforces data residency and consent policies.")
    Component(SymptomCheckerOrchestrator, "Symptom Checker Orchestrator", "Go", "Requests triage urgency from the AI inference wrapper.")
    Component(TelemetryAuditInterceptor, "Telemetry & Audit Interceptor", "Go", "Publishes immutable audit logs to the audit and traceability ledger.")
}

System_Ext(VideoMediaServer, "Video Media Server", "WebRTC SFU on GKE")
System_Ext(IntegrationService, "Integration Service", "Go / Camel-K on GKE")
System_Ext(Datastores, "Datastores", "Cloud SQL PostgreSQL")
System_Ext(AIInferenceWrapper, "AI Inference Wrapper", "Python on Vertex AI")
System_Ext(AuditTraceabilityLedger, "Audit & Traceability Ledger", "Cloud Pub/Sub, BigQuery")

Rel(ConsultationSessionManager, VideoMediaServer, "Coordinates media stream parameters", "gRPC")
Rel(PrescriptionCoordinator, IntegrationService, "Routes prescription payloads", "gRPC / REST")
Rel(ConsentEnforcementEngine, Datastores, "Executes localized queries", "SQL")
Rel(SymptomCheckerOrchestrator, AIInferenceWrapper, "Requests triage urgency", "gRPC")
Rel(TelemetryAuditInterceptor, AuditTraceabilityLedger, "Publishes immutable audit logs", "Cloud Pub/Sub")

@enduml