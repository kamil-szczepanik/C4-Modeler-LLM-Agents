@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_EU_US, "Patients (EU/US)", "End-users accessing services via mobile and web clients for video consultations and symptom checking.")
Person(Clinicians, "Clinicians", "Healthcare providers conducting consultations and issuing e-prescriptions.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for patients across the EU and US with strict regional data residency and resilient low-bandwidth connectivity.")

System_Ext(AI_Symptom_Checker, "AI Symptom Checker", "Component providing traceable care urgency recommendations.")
System_Ext(Identity_Consent_Provider, "Identity & Consent Provider", "Third-party/federated service managing OAuth2/OIDC authentication and consent ledgers.")
System_Ext(EU_National_E_Prescription_Gateways, "EU National E-Prescription Gateways", "External system for EU e-prescription standards integration.")
System_Ext(US_Surescripts_Pharmacy_Clearinghouses, "US Surescripts/Pharmacy Clearinghouses", "External system for US pharmacy clearinghouse integration using HL7 FHIR.")
System_Ext(AI_Model_Registry, "AI Model Registry", "External registry for symptom analysis and model version logging.")

Rel(Patients_EU_US, Cross_Border_Telehealth_Platform, "Accesses video consultations and platform services", "HTTPS / WebRTC (STUN/TURN)")
Rel(Clinicians, Cross_Border_Telehealth_Platform, "Conducts consultations and issues e-prescriptions", "HTTPS / WebRTC (STUN/TURN)")
Rel(Cross_Border_Telehealth_Platform, EU_National_E_Prescription_Gateways, "Transmits e-prescriptions using national standards", "REST")
Rel(Cross_Border_Telehealth_Platform, US_Surescripts_Pharmacy_Clearinghouses, "Transmits e-prescriptions and health records", "REST / HL7 FHIR")
Rel(Cross_Border_Telehealth_Platform, AI_Model_Registry, "Performs symptom analysis and model version logging", "gRPC / REST")
Rel(Cross_Border_Telehealth_Platform, Identity_Consent_Provider, "Authenticates users and manages consent", "OAuth2 / OIDC over HTTPS")
@enduml