@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "End-user browsing books, managing cart, and submitting reviews.")
Person(Admin_Support_Staff, "Admin / Support Staff", "Back-office users managing catalogue and fulfillment.")

System(Online_Bookstore_Software_System, "Online Bookstore Software System", "A scaled-down Amazon-style e-commerce platform for purchasing physical and electronic books with integrated reviews and recommendations, providing global catalogue browsing, secure multi-currency checkout, and fulfillment tracking for 1M MAU across AWS regions.")

System_Ext(Payment_Gateway, "Payment Gateway", "Stripe/PayPal processing secure checkouts via REST/TLS.")
System_Ext(Shipping_Provider_APIs, "Shipping Provider APIs", "FedEx/UPS managing order fulfillment tracking via REST/JSON.")
System_Ext(Tax_Calculation_Service, "Tax Calculation Service", "Avalara handling multi-region tax compliance (USD, EUR, GBP).")
System_Ext(Identity_Provider_SSO_Service, "Identity Provider / SSO Service", "Auth0 or AWS Cognito managing customer identity and sessions via OAuth2/OIDC.")

Rel(Customer, Online_Bookstore_Software_System, "Interacts for browsing, cart management, and reviews", "HTTPS (Web/Mobile App)")
Rel(Admin_Support_Staff, Online_Bookstore_Software_System, "Interacts for back-office management", "HTTPS")
Rel(Online_Bookstore_Software_System, Payment_Gateway, "Processes secure checkout", "REST/TLS")
Rel(Online_Bookstore_Software_System, Shipping_Provider_APIs, "Manages order fulfillment tracking", "REST/JSON")
Rel(Online_Bookstore_Software_System, Tax_Calculation_Service, "Handles multi-region tax compliance", "REST/TLS")
Rel(Online_Bookstore_Software_System, Identity_Provider_SSO_Service, "Manages authentication and sessions", "OAuth2/OIDC over TLS")

@enduml