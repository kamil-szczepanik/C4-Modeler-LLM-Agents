@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(customer_review_service, "Customer & Review Service") {
    Component(ReviewManagementComponent, "Review Management Component", "Node.js, Express/NestJS", "Manages 5-star reviews, publishes review events, and handles review operations.")
    Component(CustomerProfileComponent, "Customer Profile Component", "Node.js, Express/NestJS", "Manages user profiles and triggers compliance cascades.")
    Component(ReviewModerationComponent, "Review Moderation Component", "Node.js, Express/NestJS", "Handles review moderation workflows and consumes moderation failure events.")
    Component(DataPrivacyComplianceComponent, "Data Privacy / Compliance Component", "Node.js, Express/NestJS", "Enforces regulatory standards like GDPR and CCPA through compliance cascades.")
    ComponentDb(MongoDBAtlas, "MongoDB Atlas", "MongoDB Atlas, Mongoose ODM", "Offers flexible, semi-structured document storage for reviews and user profiles.")
    Component(AmazonSNSSQS, "Amazon SNS & SQS", "Amazon SNS & SQS", "Manages decoupled, asynchronous event-driven messaging for scalability.")
}

Rel(ReviewManagementComponent, MongoDBAtlas, "Persists documents", "TLS / MongoDB Protocol")
Rel(CustomerProfileComponent, MongoDBAtlas, "Persists documents", "TLS / MongoDB Protocol")
Rel(ReviewManagementComponent, AmazonSNSSQS, "Publishes review events", "HTTPS / MQTT")
Rel(ReviewManagementComponent, AmazonSNSSQS, "Consumes moderation failure events", "HTTPS")
Rel(CustomerProfileComponent, DataPrivacyComplianceComponent, "Triggers compliance cascades", "Internal Function Calls")

@enduml