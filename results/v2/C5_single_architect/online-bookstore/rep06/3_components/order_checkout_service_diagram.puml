@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Order & Checkout Service container

Container_Boundary(order_checkout_service, "Order & Checkout Service") {
    Component(checkout_controller, "Checkout Controller", "Spring Boot", "Handles secure checkout requests and entry points.")
    Component(order_management_service, "Order Management Service", "Spring Boot", "Manages order orchestration, domain logic, and publishes asynchronous events.")
    Component(payment_coordinator, "Payment Coordinator", "Spring Boot", "Coordinates payment processing with external gateways using idempotency keys.")
    Component(fulfillment_adapter, "Fulfillment Adapter", "Spring Boot Adapter", "Integrates with external shipping provider APIs for fulfillment.")
    Component(order_repository, "Order Repository", "Spring Data JPA", "Persists order data to Amazon Aurora PostgreSQL ensuring ACID compliance.")
    Component(cart_domain_component, "Cart Domain Component", "Spring Boot", "Encapsulates shopping cart logic and domain state.")
}

System_Ext(payment_gateway, "Payment Gateway", "External payment processing service.")
System_Ext(shipping_provider_apis, "Shipping Provider APIs", "External shipping and fulfillment providers.")
System_Ext(amazon_sns, "Amazon SNS / Messaging & Workers", "Messaging infrastructure for asynchronous events.")
System_Ext(amazon_aurora_postgresql, "Amazon Aurora PostgreSQL", "Relational database for persisting order data.")

Rel(checkout_controller, order_management_service, "In-memory Java method calls", "Synchronous")
Rel(payment_coordinator, payment_gateway, "Processes payments with idempotency keys", "HTTPS / REST")
Rel(fulfillment_adapter, shipping_provider_apis, "Arranges shipping and fulfillment", "HTTPS / REST")
Rel(order_management_service, amazon_sns, "Publishes asynchronous events", "Async / JSON")
Rel(order_repository, amazon_aurora_postgresql, "Persists order data", "TCP / PostgreSQL protocol")

@enduml