@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(catalog_service, "Catalog Service") {
    Component(CatalogAPIHandler, "Catalog API Handler", "Go component", "Handles incoming catalog requests and orchestrates calls to the repository, search client, and cache manager.")
    Component(SearchEngineClientIndexer, "Search Engine Client / Indexer", "Go component", "Executes keyword searches against the search engine.")
    Component(ProductRepository, "Product Repository", "Go component", "Encapsulates data access for transactional catalog data.")
    Component(CacheManager, "Cache Manager", "Go component", "Manages hot data retrieval and caching for frequent product details.")
}

Rel(CatalogAPIHandler, ProductRepository, "Encapsulates data access", "In-process Go interfaces")
Rel(CatalogAPIHandler, SearchEngineClientIndexer, "Executes keyword searches", "In-process Go interfaces")
Rel(CatalogAPIHandler, CacheManager, "Manages hot data retrieval", "In-process Go structs")
@enduml