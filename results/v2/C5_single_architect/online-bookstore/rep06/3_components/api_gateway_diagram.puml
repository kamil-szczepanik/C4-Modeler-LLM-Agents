@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Person(Customer, "Customers and Admin/Support Staff", "External users interacting with the online bookstore.")
System_Ext(Catalog_Service, "Catalog Service", "Downstream microservice for product catalog.")
System_Ext(Order_Checkout_Service, "Order & Checkout Service", "Downstream microservice for orders and checkout.")
System_Ext(Recommendation_Service, "Recommendation Service", "Downstream microservice for recommendations.")
System_Ext(Customer_Review_Service, "Customer & Review Service", "Downstream microservice for customers and reviews.")
System_Ext(Identity_Provider_SSO_Service, "Identity Provider / SSO Service", "External OIDC Identity Provider.")
System_Ext(Amazon_CloudWatch, "Amazon CloudWatch", "Captures and publishes real-time request metrics and access logs.")

Container_Boundary(API_Gateway, "API Gateway") {
    Component(Routing_Dispatcher, "Routing & Dispatcher", "Amazon API Gateway HTTP APIs (v2) & AWS VPC Links", "Manages client traffic routing, ingress, and dispatches proxied requests to downstream microservices.")
    Component(JWT_Auth_Filter, "JWT Auth Filter", "AWS Lambda Authorizers", "Performs custom security validation logic and JWT verification at the edge.")
    Component(Rate_Limiting_Throttling, "Rate Limiting & Throttling", "Amazon API Gateway HTTP APIs", "Controls traffic rates and throttles incoming requests to protect backend services.")
    Component(Request_Response_Transformation, "Request/Response Transformation", "Amazon API Gateway HTTP APIs", "Sanitizes and transforms request and response payloads.")
    Component(API_Analytics_Logging, "API Analytics & Logging", "Amazon CloudWatch", "Captures and publishes real-time request metrics, latency percentiles, and access logs.")
}

Rel(Customer, Routing_Dispatcher, "Sends API requests", "HTTPS / JSON (JWT authenticated)")
Rel(Routing_Dispatcher, Catalog_Service, "Routes proxied requests", "gRPC / HTTPS via AWS VPC Links")
Rel(Routing_Dispatcher, Order_Checkout_Service, "Routes proxied requests", "gRPC / HTTPS via AWS VPC Links")
Rel(Routing_Dispatcher, Recommendation_Service, "Routes proxied requests", "gRPC / HTTPS via AWS VPC Links")
Rel(Routing_Dispatcher, Customer_Review_Service, "Routes proxied requests", "gRPC / HTTPS via AWS VPC Links")
Rel(JWT_Auth_Filter, Identity_Provider_SSO_Service, "Validates user tokens", "HTTPS / OIDC")
Rel(API_Analytics_Logging, Amazon_CloudWatch, "Publishes access logs and metrics", "AWS SDK / HTTPS")

@enduml