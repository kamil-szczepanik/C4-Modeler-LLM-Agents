@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Single Page Application (SPA) container

Container_Boundary(spa, "Single Page Application (SPA)") {
    Component(routing_layout, "Routing & Layout", "React Router, React", "Manages application navigation, view routing, and structural layouts.")
    Component(catalog_search, "Catalog & Search", "React, Zustand", "Handles book catalog browsing, searching, and filtering interfaces.")
    Component(cart_checkout, "Cart & Checkout", "React, Zustand", "Manages shopping cart state and checkout flow interfaces.")
    Component(reviews_ratings, "Reviews & Ratings", "React", "Displays and collects customer reviews and book ratings.")
    Component(recommendations, "Recommendations", "React", "Renders personalized book recommendations.")
    Component(auth_client, "Authentication Context / API Client", "React, Axios / Fetch, JWT", "Manages user authentication state, secure token handling, and HTTP API communication.")
    Component(localization_currency, "Localization & Currency Context", "React", "Handles multi-language support and multi-currency formatting and context.")
}

Rel(routing_layout, catalog_search, "Renders", "")
Rel(routing_layout, cart_checkout, "Renders", "")
Rel(routing_layout, reviews_ratings, "Renders", "")
Rel(routing_layout, recommendations, "Renders", "")
Rel(catalog_search, auth_client, "Fetches catalog data via", "")
Rel(cart_checkout, auth_client, "Submits orders and cart data via", "")
Rel(reviews_ratings, auth_client, "Submits and retrieves reviews via", "")
Rel(recommendations, auth_client, "Fetches recommendations via", "")

@enduml