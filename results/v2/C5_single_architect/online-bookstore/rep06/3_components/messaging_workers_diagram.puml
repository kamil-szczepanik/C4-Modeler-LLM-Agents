@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Messaging & Workers container

Container_Boundary(messaging_and_workers, "Messaging & Workers") {
    Component(EventPublisherComponent, "Event Publisher Component", "AWS SNS (Simple Notification Service)", "Publishes domain events and enables scalable pub/sub fan-out messaging.")
    Component(TaskQueueCoordinator, "Task Queue Coordinator", "Amazon SQS (Simple Queue Service)", "Provides robust message buffering and decoupling.")
    Component(BackgroundWorkerPool, "Background Worker Pool", "AWS ECS Fargate tasks running Python/Celery", "Delivers serverless execution for long-running asynchronous tasks and third-party shipping integrations.")
    Component(DeadLetterQueueDLQ, "Dead Letter Queue (DLQ)", "Amazon SQS DLQ", "Ensures fault tolerance by capturing poison pills and failed requests.")
}

System(OrderCheckoutService, "Order & Checkout Service", "External or sibling service in the system")

Rel(OrderCheckoutService, EventPublisherComponent, "Publishes domain events", "HTTPS / SNS API")
Rel(EventPublisherComponent, TaskQueueCoordinator, "Forwards events to queues", "SNS-to-SQS subscription")
Rel(TaskQueueCoordinator, BackgroundWorkerPool, "Polls and processes tasks", "Long-polling / SQS API")
Rel(BackgroundWorkerPool, DeadLetterQueueDLQ, "Offloads failed messages after max retries", "SQS API")

@enduml