@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(Customer_Admin_Support_Staff, "Customer & Admin/Support Staff", "End users browsing books, managing cart, submitting reviews, and operators managing the system.")

System_Ext(Payment_Gateway, "Payment Gateway", "External system processing secure checkouts.")
System_Ext(Shipping_Provider_APIs, "Shipping Provider APIs", "External system managing order fulfillment and tracking.")
System_Ext(Tax_Calculation_Service, "Tax Calculation Service", "External system handling tax compliance.")
System_Ext(Identity_Provider_SSO, "Identity Provider / SSO", "External system managing customer identity and authentication.")

System_Boundary(Online_Bookstore_Software_System, "Online Bookstore Software System") {
    Container(Single_Page_Application_SPA, "Single Page Application (SPA)", "React, Amazon S3, Amazon CloudFront", "Frontend user interface hosted on S3 and distributed via CloudFront.")
    Container(API_Gateway, "API Gateway", "Amazon API Gateway", "Manages REST/GraphQL routing and JWT security.")
    Container(Catalog_Service, "Catalog Service", "Go", "Microservice managing book catalog data.")
    Container(Order___Checkout_Service, "Order & Checkout Service", "Spring Boot", "Microservice managing orders and checkout processing.")
    Container(Recommendation_Service, "Recommendation Service", "Python FastAPI", "Microservice providing book recommendations and caching.")
    Container(Customer___Review_Service, "Customer & Review Service", "Node.js", "Microservice managing customer profiles and reviews.")
    Container(Messaging___Workers, "Messaging & Workers", "Amazon SQS, Amazon SNS", "Asynchronous event-driven decoupling for reliable processing.")
    
    ContainerDb(Amazon_Aurora_PostgreSQL_Catalog, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Persists catalog data.")
    ContainerDb(Amazon_Aurora_PostgreSQL_Order, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Persists order data.")
    ContainerDb(Amazon_ElastiCache_Redis, "Amazon ElastiCache (Redis)", "Amazon ElastiCache (Redis)", "Caches and retrieves recommendation data.")
    ContainerDb(MongoDB, "MongoDB", "MongoDB", "Persists customer review data.")
}

Rel(Customer_Admin_Support_Staff, Single_Page_Application_SPA, "Browses, manages cart, and interacts with the store", "HTTPS / HTML / JS")
Rel(Single_Page_Application_SPA, API_Gateway, "Sends API requests", "HTTPS / JSON (JWT authenticated)")
Rel(API_Gateway, Catalog_Service, "Routes catalog requests", "gRPC / HTTPS")
Rel(API_Gateway, Order___Checkout_Service, "Routes order and checkout requests", "gRPC / HTTPS")
Rel(API_Gateway, Recommendation_Service, "Routes recommendation requests", "gRPC / HTTPS")
Rel(API_Gateway, Customer___Review_Service, "Routes customer and review requests", "gRPC / HTTPS")
Rel(Order___Checkout_Service, Payment_Gateway, "Processes payments", "HTTPS / REST")
Rel(Order___Checkout_Service, Shipping_Provider_APIs, "Arranges shipping and fulfillment", "HTTPS / REST")
Rel(Order___Checkout_Service, Messaging___Workers, "Publishes asynchronous events", "Async / JSON")
Rel(Catalog_Service, Amazon_Aurora_PostgreSQL_Catalog, "Persists catalog data", "TCP / PostgreSQL protocol")
Rel(Order___Checkout_Service, Amazon_Aurora_PostgreSQL_Order, "Persists order data", "TCP / PostgreSQL protocol")
Rel(Recommendation_Service, Amazon_ElastiCache_Redis, "Caches and retrieves recommendation data", "TCP / Redis protocol")
Rel(Customer___Review_Service, MongoDB, "Persists customer review data", "TCP / MongoDB protocol")

@enduml