@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "Primary user purchasing physical and electronic books, reading reviews, and receiving recommendations.")
Person(Store Administrator, "Store Administrator", "Primary user managing store operations and inventory.")

System_Ext(Payment Gateway, "Payment Gateway", "External system handling payment processing.")
System_Ext(Third-Party Shipping API, "Third-Party Shipping API", "External system handling order fulfillment and shipping.")
System_Ext(Notification Service, "Notification Service", "External system dispatching alerts and notifications.")
System_Ext(OAuth 2.0 Identity Provider, "OAuth 2.0 Identity Provider", "External system managing authentication and identity.")
System_Ext(Currency Exchange Rate Service, "Currency Exchange Rate Service", "External system providing currency conversion rates.")

System_Boundary(Online Bookstore, "Online Bookstore") {
    Container(Single Page Application (SPA), "Single Page Application (SPA)", "React, TypeScript, Amazon S3, Amazon CloudFront", "Frontend user interface providing client-side routing, catalog browsing, and user interactions.")
    Container(API Gateway, "API Gateway", "Amazon API Gateway", "Manages routing, SSL termination, and rate limiting for incoming traffic.")
    Container(Catalog Service, "Catalog Service", "Go, Amazon Aurora, Amazon OpenSearch", "Manages book catalog data and keyword search functionality.")
    Container(Order & Checkout Service, "Order & Checkout Service", "Node.js, Amazon Aurora, Amazon ElastiCache", "Manages shopping carts, orders, and checkout processing.")
    Container(Recommendation Service, "Recommendation Service", "Python, FastAPI, Amazon DocumentDB", "Generates personalized book recommendations for customers.")
    Container(Customer Review Service, "Customer Review Service", "Node.js, Amazon Aurora", "Manages customer ratings and reviews for books.")
    Container(Message Broker, "Message Broker", "Amazon SQS / SNS", "Handles asynchronous event publishing and decoupling between internal services.")
}

Rel(Customer, Single Page Application (SPA), "Interacts for browsing, recommendations, reviews, and purchases", "HTTPS / REST / GraphQL")
Rel(Store Administrator, Single Page Application (SPA), "Manages store administration and catalog", "HTTPS / REST / GraphQL")
Rel(Single Page Application (SPA), API Gateway, "Sends client requests for backend operations", "HTTPS / JSON")
Rel(API Gateway, Catalog Service, "Routes catalog and search requests", "HTTPS / REST / gRPC")
Rel(API Gateway, Order & Checkout Service, "Routes order and checkout requests", "HTTPS / REST / gRPC")
Rel(API Gateway, Recommendation Service, "Routes recommendation requests", "HTTPS / REST / gRPC")
Rel(API Gateway, Customer Review Service, "Routes review requests", "HTTPS / REST / gRPC")
Rel(Order & Checkout Service, Payment Gateway, "Processes secure payments", "HTTPS")
Rel(Order & Checkout Service, Third-Party Shipping API, "Coordinates shipment and tracking", "HTTPS")
Rel(Catalog Service, Message Broker, "Publishes asynchronous catalog events", "Amazon SQS / SNS")
Rel(Order & Checkout Service, Message Broker, "Publishes asynchronous order events", "Amazon SQS / SNS")
Rel(Customer Review Service, Message Broker, "Publishes asynchronous review events", "Amazon SQS / SNS")

@enduml