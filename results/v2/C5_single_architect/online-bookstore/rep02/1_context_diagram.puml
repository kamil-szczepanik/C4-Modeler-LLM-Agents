@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "End-user accessing the system via Web Browser or Mobile App.")
Person(Store Administrator, "Store Administrator", "Internal user managing inventory and pricing via Web Browser.")
System(Online Bookstore System, "Online Bookstore System", "Cloud-native e-commerce system built to sell physical and electronic books with recommendations, reviews, and secure global checkout.")
System_Ext(Payment Gateway, "Payment Gateway", "External Stripe/PayPal system handling secure checkout and multi-currency transactions.")
System_Ext(Third-Party Shipping Provider API, "Third-Party Shipping Provider API", "External service calculating shipping rates and tracking.")
System_Ext(Notification Service, "Notification Service", "External AWS SES/Twilio system dispatching alerts.")
System_Ext(Identity Provider / OAuth 2.0 Service, "Identity Provider / OAuth 2.0 Service", "External Auth0 or AWS Cognito service managing authentication.")
System_Ext(Currency Exchange Rate Service, "Currency Exchange Rate Service", "External API fetching daily conversion rates.")

Rel(Customer, Online Bookstore System, "interacts via Web/Mobile for browsing, recommendations, reviews, and checkout", "HTTPS/REST")
Rel(Store Administrator, Online Bookstore System, "manages inventory and pricing", "HTTPS/REST")
Rel(Online Bookstore System, Payment Gateway, "handles secure checkout and multi-currency transactions", "HTTPS/REST")
Rel(Online Bookstore System, Third-Party Shipping Provider API, "calculates shipping rates and tracking", "HTTPS/REST")
Rel(Online Bookstore System, Notification Service, "dispatches transactional alerts", "SMTP/APIs")
Rel(Online Bookstore System, Identity Provider / OAuth 2.0 Service, "authenticates users", "OIDC/HTTPS")
Rel(Online Bookstore System, Currency Exchange Rate Service, "fetches daily conversion rates for USD, EUR, and GBP", "HTTPS/REST")

@enduml