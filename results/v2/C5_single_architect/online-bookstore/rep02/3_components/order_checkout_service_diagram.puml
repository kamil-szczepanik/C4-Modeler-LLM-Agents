@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("OrderCheckoutService", "Order & Checkout Service") {
    Component(CartComponent, "Cart Component", "Node.js / TypeScript", "Manages temporary shopping cart state.")
    Component(CheckoutOrchestrator, "Checkout Orchestrator", "Node.js / TypeScript", "Manages state machines for multi-step checkout processes.")
    Component(PaymentAdapter, "Payment Adapter", "Node.js / TypeScript", "Encapsulates external payment gateway communication.")
    Component(ShippingAdapter, "Shipping Adapter", "Node.js / TypeScript", "Encapsulates third-party shipping API integration.")
    Component(OrderRepository, "Order Repository", "Node.js / TypeScript, Prisma ORM", "Persists finalized orders and transactional ledger data.")
    Component(EventPublisherComponent, "Event Publisher Component", "Node.js / TypeScript, AWS SDK", "Triggers domain events upon successful database commits.")
    Component(AmazonElastiCache, "Amazon ElastiCache", "Amazon ElastiCache (Redis)", "Low-latency in-memory store for high-performance shopping cart persistence.")
    Component(MessageBroker, "Message Broker", "Amazon SQS / SNS", "Managed message broker for reliable asynchronous domain event distribution.")
}

Rel(CheckoutOrchestrator, PaymentAdapter, "Processes secure payments", "HTTPS / REST")
Rel(CheckoutOrchestrator, ShippingAdapter, "Coordinates shipment and tracking", "HTTPS / REST")
Rel(CartComponent, AmazonElastiCache, "Reads and writes cart state", "Redis Protocol")
Rel(CheckoutOrchestrator, OrderRepository, "Persists finalized transactions", "Prisma ORM / SQL via TLS")
Rel(OrderRepository, EventPublisherComponent, "Triggers domain events post-commit", "Internal Function Call")
Rel(EventPublisherComponent, MessageBroker, "Publishes OrderPlaced events", "AWS SDK / HTTPS")

@enduml