@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(recommendation_service, "Recommendation Service") {
    Component(RecommendationAPIController, "Recommendation API Controller", "Python, FastAPI", "Exposes endpoints via HTTPS / REST / gRPC to serve personalized book recommendations.")
    Component(ScoringEngine, "Scoring Engine", "Python, NumPy, Pandas", "Computes recommendation weights and collaborative filtering heuristics using batch data from the data store.")
    Component(ModelCacheManager, "Model Cache Manager", "Python, Redis Client", "Manages in-memory caching using Amazon ElastiCache to achieve sub-50ms latency.")
    Component(DataAccessRepository, "Data Access Repository", "Python, PyMongo", "Handles database operations interacting with Amazon DocumentDB (NoSQL database).")
    Component(MessageConsumerComponent, "Message Consumer Component", "Python, Celery/SQS worker", "Consumes asynchronous messages from Amazon SQS for real-time model updates based on domain events.")
}

Rel(RecommendationAPIController, ModelCacheManager, "Queries cached recommendation models", "In-process / Redis Protocol")
Rel(ModelCacheManager, DataAccessRepository, "Fetches data on cache miss", "Async / MongoDB Wire Protocol")
Rel(ScoringEngine, DataAccessRepository, "Retrieves pre-computed user/item affinity matrices", "Batch / MongoDB Wire Protocol")
Rel(MessageConsumerComponent, DataAccessRepository, "Updates data store on incoming domain events", "In-process / PyMongo")

@enduml