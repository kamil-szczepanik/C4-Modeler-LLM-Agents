@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog Service container

Container_Boundary(catalog_service, "Catalog Service") {
    Component(CatalogAPIController, "Catalog API Controller", "Go (net/http)", "Component handling incoming REST and gRPC requests.")
    Component(BookManagementComponent, "Book Management Component", "Go", "Component managing CRUD operations and local caching.")
    Component(SearchDiscoveryComponent, "Search & Discovery Component", "Go", "Component executing complex keyword queries and faceting.")
    Component(CatalogEventPublisher, "Catalog Event Publisher", "Go", "Component emitting asynchronous domain events.")
    Component(LocalInMemoryCache, "Local In-Memory Cache", "In-process TTL cache", "In-process TTL cache for frequent read queries.")
}

Component(AmazonAurora, "Amazon Aurora", "Relational Database / Postgres", "Relational database for persistent book metadata.")
Component(AmazonOpenSearch, "Amazon OpenSearch", "Search Engine", "Search engine for catalog keyword indexing.")
Component(AmazonSQSSNS, "Amazon SQS / SNS", "Message Broker / AWS SDK", "Message broker for asynchronous event distribution.")

Rel(CatalogAPIController, BookManagementComponent, "Delegates requests", "In-process / Go interfaces")
Rel(CatalogAPIController, SearchDiscoveryComponent, "Delegates requests", "In-process / Go interfaces")
Rel(BookManagementComponent, LocalInMemoryCache, "Reads/writes frequent book data", "In-process")
Rel(BookManagementComponent, AmazonAurora, "Persists core book entities", "TCP / Postgres Protocol")
Rel(SearchDiscoveryComponent, AmazonOpenSearch, "Queries index", "TCP / HTTPS")
Rel(CatalogEventPublisher, AmazonSQSSNS, "Publishes domain events", "HTTPS / AWS SDK")
@enduml