@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(message_broker, "Message Broker") {
    Component(Event_Topic_Router, "Event Topic Router", "Amazon SNS", "Fan-out routing for published events.")
    Component(Execution_Queues, "Execution Queues", "Amazon SQS", "Holds asynchronous events for consumption by downstream services.")
    Component(Dead_Letter_Queue_Handler, "Dead Letter Queue Handler", "Amazon SQS DLQ", "Handles failed messages and execution anomalies.")
    Component(Event_Schema_Validator, "Event Schema Validator", "JSON Schema", "Validates published payloads from services.")
    Component(Message_Retry___Backoff_Controller, "Message Retry & Backoff Controller", "SQS Native Attributes", "Manages redrive policies and retry backoff.")
}

Rel(Event_Topic_Router, Execution_Queues, "Fan-out routing [AWS SNS to SQS subscription, HTTPS]", "HTTPS")
Rel(Execution_Queues, Message_Retry___Backoff_Controller, "Manages redrive policies [SQS Native Config]", "SQS Native Config")
@enduml