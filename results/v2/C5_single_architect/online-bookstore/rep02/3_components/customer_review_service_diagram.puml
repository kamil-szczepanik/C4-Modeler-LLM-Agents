@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Customer Review Service container

System_Ext(api_gateway, "API Gateway", "Routes incoming review requests.", "API Gateway")
System_Ext(amazon_aurora, "Amazon Aurora", "Relational database for review records and indices.", "PostgreSQL")
System_Ext(amazon_sns_sqs, "Amazon SNS / SQS", "Message broker for asynchronous event fan-out.", "AWS SNS/SQS")

Container_Boundary(customer_review_service, "Customer Review Service") {
    Component(review_api_controller, "Review API Controller", "Node.js, Express, REST, gRPC", "Node.js and Express interface handling incoming HTTP/REST/gRPC endpoints.")
    Component(review_domain_service, "Review Domain Service", "TypeScript", "TypeScript core containing business logic, rating aggregation, and validation.")
    Component(moderation_client, "Moderation Client", "Node.js", "Content safety and text filtering module for GDPR compliance.")
    Component(review_data_access_repository, "Review Data Access Repository", "Node.js, pg driver", "Node.js pg driver managing relational persistence.")
    Component(event_publisher_component, "Event Publisher Component", "AWS SDK v3, JavaScript", "AWS SDK v3 JavaScript module for event dispatch.")
}

Rel(api_gateway, review_api_controller, "Routes incoming review requests", "HTTPS / REST / JSON")
Rel(review_api_controller, review_domain_service, "Delegates requests", "Direct TypeScript Function Calls")
Rel(review_domain_service, moderation_client, "Validates text content", "Internal Module Call")
Rel(review_domain_service, review_data_access_repository, "Queries and persists review data", "SQL / TCP")
Rel(review_data_access_repository, amazon_aurora, "Stores and retrieves relational records", "PostgreSQL Wire Protocol / TCP")
Rel(review_domain_service, event_publisher_component, "Triggers event publishing", "Internal Module Call")
Rel(event_publisher_component, amazon_sns_sqs, "Publishes ReviewCreated and ReviewDeleted events", "HTTPS / AWS SDK v3")

@enduml