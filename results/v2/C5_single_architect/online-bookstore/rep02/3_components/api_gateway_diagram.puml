@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(ssl_terminator, "SSL Terminator & WAF", "AWS WAF / Amazon API Gateway", "Provides OWASP Top-10 mitigations, SSL termination, and handles incoming client requests securely.")
    Component(auth_filter, "Authentication & Authorization Filter", "Amazon API Gateway Custom Authorizer", "Validates JWT signatures and scopes against the Identity Provider.")
    Component(rate_limiter, "Rate Limiter & Throttler", "Amazon API Gateway / Amazon ElastiCache (Redis)", "Maintains token buckets and counters for distributed rate-limiting.")
    Component(request_router, "Request Router", "Amazon API Gateway Routing", "Forwards traffic to backend microservices including Catalog Service, Order & Checkout Service, Recommendation Service, and Customer Review Service.")
}

System_Ext(catalog_service, "Catalog Service", "Microservice")
System_Ext(order_service, "Order & Checkout Service", "Microservice")
System_Ext(recommendation_service, "Recommendation Service", "Microservice")
System_Ext(review_service, "Customer Review Service", "Microservice")

Rel(ssl_terminator, auth_filter, "Passes sanitized HTTPS requests")
Rel(auth_filter, rate_limiter, "Checks rate limits for authenticated requests")
Rel(rate_limiter, request_router, "Routes allowed requests")
Rel(request_router, catalog_service, "Forwards traffic", "HTTP/2 / gRPC")
Rel(request_router, order_service, "Forwards traffic", "HTTP/2 / gRPC")
Rel(request_router, recommendation_service, "Forwards traffic", "HTTP/2 / gRPC")
Rel(request_router, review_service, "Forwards traffic", "HTTP/2 / gRPC")

@enduml