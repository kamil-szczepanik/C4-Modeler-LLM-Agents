@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Single Page Application (SPA) container

Person(CustomerStoreAdministrator, "Customer & Store Administrator", "Users of the bookstore system")
System_Ext(AmazonAPIGateway, "Amazon API Gateway", "Backend API Gateway")

Container_Boundary(SinglePageApplicationSPA, "Single Page Application (SPA)") {
    Component(RouterComponent, "Router Component", "React Router", "Handles client-side routing and renders views for catalog, checkout, and recommendations.")
    Component(StateManagementComponent, "State Management Component", "Zustand/Redux Toolkit", "Manages in-memory global state to mitigate XSS vulnerabilities.")
    Component(APIClientComponent, "API Client Component", "Axios/Fetch wrapper", "Sends backend requests via HTTPS/JSON with Accept-Currency headers.")
    Component(LocalizationCurrencyComponent, "Localization/Currency Component", "React-i18next & Intl API", "Formats prices locally and provides client-side internationalization.")
    Component(CatalogSearchUIComponent, "Catalog & Search UI Component", "React & TypeScript", "Enables seamless catalog browsing and search.")
    Component(CheckoutCartUIComponent, "Checkout & Cart UI Component", "React & TypeScript", "Handles secure checkout and cart operations.")
    Component(RecommendationsReviewsUIComponent, "Recommendations & Reviews UI Component", "React & TypeScript", "Displays personalized recommendations and reviews.")
}

Rel(CustomerStoreAdministrator, SinglePageApplicationSPA, "Interacts via", "HTTPS / REST / GraphQL")
Rel(APIClientComponent, AmazonAPIGateway, "Sends backend requests with Accept-Currency headers", "HTTPS / JSON")
Rel(CatalogSearchUIComponent, LocalizationCurrencyComponent, "Formats prices locally", "JavaScript function calls")
Rel(CheckoutCartUIComponent, LocalizationCurrencyComponent, "Formats prices locally", "JavaScript function calls")
Rel(RecommendationsReviewsUIComponent, LocalizationCurrencyComponent, "Formats prices locally", "JavaScript function calls")
Rel(RouterComponent, CatalogSearchUIComponent, "Renders views", "Client-side routing")
Rel(RouterComponent, CheckoutCartUIComponent, "Renders views", "Client-side routing")
Rel(RouterComponent, RecommendationsReviewsUIComponent, "Renders views", "Client-side routing")

@enduml