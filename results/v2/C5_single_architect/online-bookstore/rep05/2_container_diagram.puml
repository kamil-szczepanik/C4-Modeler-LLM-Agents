@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "End-user browsing, purchasing, and reviewing books.")
Person(StoreAdministrator, "Store Administrator", "Manages catalogue, inventory, and system oversight.")

System_Ext(PaymentGateway, "Payment Gateway", "External payment processing system.")
System_Ext(ShippingProviderAPIs, "Shipping Provider APIs", "External fulfillment and shipping services.")
System_Ext(EmailNotificationService, "Email/Notification Service", "External service for alerts and emails.")
System_Ext(TaxCalculationService, "Tax Calculation Service", "External service for automated tax compliance.")
System_Ext(IdentityPIdP, "Identity Provider (IdP)", "External identity provider for authentication.")

System_Boundary(OnlineBookstore, "Online Bookstore") {
    Container(SinglePageAppSPA, "Single Page App (SPA)", "React, TypeScript, Amazon CloudFront, S3", "Delivers client-side interface for customers and administrators.")
    Container(APIGateway, "API Gateway", "Amazon API Gateway (REST/GraphQL)", "Routes client requests and handles API routing.")
    Container(CatalogService, "Catalog Service", "Go, Amazon ECS / AWS Fargate", "Manages book catalogs and search capabilities.")
    Container(OrderCheckoutService, "Order & Checkout Service", "Node.js, Express, Amazon ECS / AWS Fargate", "Handles ACID-compliant transactions, shopping carts, and order processing.")
    Container(RecommendationService, "Recommendation Service", "Python, FastAPI, Amazon ECS / AWS Fargate", "Delivers real-time personalized recommendations.")
    ContainerDb(DatabaseDynamoDB, "Database (DynamoDB)", "Amazon DynamoDB", "Provides catalogue search speed and scalable NoSQL storage.")
    ContainerDb(DatabaseAuroraPostgreSQL, "Database (Aurora PostgreSQL)", "Amazon Aurora PostgreSQL", "Provides ACID-compliant relational data storage.")
    ContainerDb(CacheElastiCacheRedis, "Cache (ElastiCache Redis)", "Amazon ElastiCache (Redis)", "Provides real-time caching for recommendations and sessions.")
    Container(MessageBroker, "Message Broker", "Amazon SQS, Amazon SNS, Amazon EventBridge", "Handles asynchronous event-driven workflows and messaging.")
}

Rel(Customer, SinglePageAppSPA, "Browses books, places orders, and manages account", "HTTPS via Amazon CloudFront")
Rel(StoreAdministrator, SinglePageAppSPA, "Manages inventory and catalogue", "HTTPS via Amazon CloudFront")
Rel(SinglePageAppSPA, APIGateway, "Sends API requests and queries", "HTTPS / GraphQL / REST")
Rel(APIGateway, CatalogService, "Routes catalogue and search queries", "gRPC / HTTPS over internal VPC")
Rel(APIGateway, OrderCheckoutService, "Routes order and checkout actions", "gRPC / HTTPS over internal VPC")
Rel(APIGateway, RecommendationService, "Routes recommendation queries", "gRPC / HTTPS over internal VPC")
Rel(CatalogService, DatabaseDynamoDB, "Reads and writes catalogue data", "DynamoDB Protocol")
Rel(OrderCheckoutService, DatabaseAuroraPostgreSQL, "Persists transactions and orders", "PostgreSQL Protocol")
Rel(RecommendationService, CacheElastiCacheRedis, "Reads and writes recommendation cache", "Redis Protocol")
Rel(OrderCheckoutService, MessageBroker, "Publishes and consumes asynchronous events", "AWS VPC messaging protocols")
Rel(OrderCheckoutService, PaymentGateway, "Processes payment transactions", "HTTPS webhooks and APIs")
Rel(OrderCheckoutService, ShippingProviderAPIs, "Arranges order fulfillment", "HTTPS webhooks and APIs")
Rel(OrderCheckoutService, TaxCalculationService, "Calculates order taxes", "HTTPS webhooks and APIs")
Rel(OrderCheckoutService, EmailNotificationService, "Sends order confirmations and alerts", "HTTPS webhooks and APIs")
Rel(SinglePageAppSPA, IdentityPIdP, "Authenticates users", "HTTPS / OIDC")

@enduml