@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "End-user browsing, purchasing, and reviewing books.")
Person(Store_Administrator, "Store Administrator", "Manages catalogue, inventory, and system oversight.")

System(Online_Bookstore, "Online Bookstore", "A cloud-native multi-region e-commerce system built to handle book sales, customer reviews, and personalized recommendations while maintaining compliance, high availability, and performance.")

System_Ext(Payment_Gateway, "Payment Gateway", "Stripe or PayPal processing transactions.")
System_Ext(Shipping_Provider_APIs, "Shipping Provider APIs", "FedEx, UPS, or DHL for order fulfillment.")
System_Ext(Email_Notification_Service, "Email/Notification Service", "Amazon SES or SendGrid for alerts.")
System_Ext(Tax_Calculation_Service, "Tax Calculation Service", "Avalara or TaxJar for automated tax compliance.")
System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "AWS Cognito or Auth0 for authentication.")

Rel(Customer, Online_Bookstore, "Interacts with the Online Bookstore via Web/Mobile", "HTTPS")
Rel(Store_Administrator, Online_Bookstore, "Interacts with the Online Bookstore for system oversight and management", "HTTPS")
Rel(Customer, Identity_Provider_IdP, "Authenticates against Identity Provider", "OIDC over HTTPS")
Rel(Store_Administrator, Identity_Provider_IdP, "Authenticates against Identity Provider", "OIDC over HTTPS")
Rel(Online_Bookstore, Payment_Gateway, "Processes transactions during checkout", "REST/TLS 1.3")
Rel(Online_Bookstore, Tax_Calculation_Service, "Calculates automated taxes during checkout", "REST/TLS 1.3")
Rel(Online_Bookstore, Shipping_Provider_APIs, "Integrates for order fulfillment", "REST/TLS 1.3")
Rel(Online_Bookstore, Email_Notification_Service, "Utilizes for order confirmations and alerts", "SMTP/HTTPS")

@enduml