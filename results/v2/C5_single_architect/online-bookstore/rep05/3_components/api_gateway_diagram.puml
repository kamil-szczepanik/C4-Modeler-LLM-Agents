@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Router_and_Request_Dispatcher, "Router and Request Dispatcher", "Amazon API Gateway", "Manages routing, security, and throttling for incoming API requests.")
    Component(Security_and_Auth_Validator, "Security and Auth Validator", "AWS Lambda Authorizers / Lambda@Edge", "Performs edge logic and stateless JWT validation.")
}

Rel(Router_and_Request_Dispatcher, Security_and_Auth_Validator, "Validates requests using")

@enduml