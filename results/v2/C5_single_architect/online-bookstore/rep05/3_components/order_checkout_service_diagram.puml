@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Order & Checkout Service container

Container_Boundary("Order & Checkout Service", "Order & Checkout Service") {
    Component(Checkout_Controller, "Checkout Controller", "Express.js", "Express.js component for request routing, input validation, and rate-limiting.")
    Component(Order_Management_Service, "Order Management Service", "Node.js / TypeScript", "Domain logic component for cart processing, order state transitions, and multi-currency pricing.")
    Component(Transaction_Coordinator, "Transaction Coordinator", "Prisma ORM", "Prisma ORM-backed component managing ACID database transactions.")
    Component(Idempotency_Manager, "Idempotency Manager", "Amazon ElastiCache (Redis)", "Redis-backed component deduplicating checkout requests to prevent double-charging.")
    Component(Integration_Facade, "Integration Facade", "Opossum", "Opossum-protected component handling external HTTPS integrations.")
    Component(Event_Publisher, "Event Publisher", "AWS SDK for JavaScript v3", "AWS SDK v3 component for asynchronous messaging.")
}

System_Ext(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Relational database providing strict ACID guarantees for financial data.")
System_Ext(Payment_Gateway, "Payment Gateway", "External system for processing payments.")
System_Ext(Shipping_Provider_APIs, "Shipping Provider APIs", "External systems for managing shipping and fulfillment.")
System_Ext(Tax_Calculation_Service, "Tax Calculation Service", "External service for calculating taxes.")
System_Ext(Email_Notification_Service, "Email/Notification Service", "External service for sending emails and notifications.")
System_Ext(Amazon_SNS_SQS, "Amazon SNS/SQS", "AWS messaging service for asynchronous events.")

Rel(Checkout_Controller, Order_Management_Service, "Direct TypeScript function calls", "In-Memory")
Rel(Order_Management_Service, Transaction_Coordinator, "Direct TypeScript function calls", "In-Memory")
Rel(Transaction_Coordinator, Amazon_Aurora_PostgreSQL, "Persists transactions and orders", "PostgreSQL Protocol over TCP")
Rel(Checkout_Controller, Idempotency_Manager, "Validates request tokens", "Redis Protocol over TCP")
Rel(Integration_Facade, Payment_Gateway, "Processes external workflows", "HTTPS REST APIs & webhooks")
Rel(Integration_Facade, Shipping_Provider_APIs, "Processes external workflows", "HTTPS REST APIs & webhooks")
Rel(Integration_Facade, Tax_Calculation_Service, "Processes external workflows", "HTTPS REST APIs & webhooks")
Rel(Integration_Facade, Email_Notification_Service, "Processes external workflows", "HTTPS REST APIs & webhooks")
Rel(Event_Publisher, Amazon_SNS_SQS, "Publishes domain events", "AWS SDK v3 over AWS VPC Endpoints")

@enduml