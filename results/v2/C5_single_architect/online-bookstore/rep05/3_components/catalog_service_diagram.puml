@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "API Gateway", "External system routing catalogue and search queries.")
System_Ext(database_dynamodb, "Database (DynamoDB)", "Amazon DynamoDB", "Scalable NoSQL storage for catalogue metadata.")
System_Ext(message_broker_amazon_sqs, "Message Broker (Amazon SQS)", "Amazon SQS", "Message broker providing inventory updates.")

Container_Boundary(catalog_service, "Catalog Service") {
    Component(catalog_api_controller, "Catalog API Controller", "Go, net/http", "Handles catalogue and search queries routed from the API Gateway.")
    Component(catalog_domain_manager, "Catalog Domain Manager", "Go", "Manages business logic, record persistence, cache interactions, and index synchronization.")
    Component(search_indexing_engine, "Search & Indexing Engine", "Go, Amazon OpenSearch Service", "Handles high-performance keyword searches and full-text search indexing.")
    Component(cache_aside_proxy, "Cache Aside Proxy", "Go, go-redis", "Performs in-memory lookups to cache hot-spot read requests and minimize latency.")
}

Rel(api_gateway, catalog_api_controller, "Routes catalogue and search queries", "gRPC / HTTPS")
Rel(catalog_api_controller, catalog_domain_manager, "Delegates requests", "In-process")
Rel(catalog_domain_manager, database_dynamodb, "Persists records", "DynamoDB Go SDK")
Rel(catalog_domain_manager, cache_aside_proxy, "In-memory lookups", "TCP / Redis RESP")
Rel(catalog_domain_manager, search_indexing_engine, "Index synchronization", "AWS SDK / Async")
Rel(message_broker_amazon_sqs, catalog_domain_manager, "Subscribes to inventory updates", "SQS Protocol")

@enduml