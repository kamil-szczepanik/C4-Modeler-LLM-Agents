@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database (DynamoDB) container

Container_Boundary("Database (DynamoDB)", "Database (DynamoDB)") {
    Component(Catalog Table (Books), "Catalog Table (Books)", "Amazon DynamoDB", "Stores catalogue data for physical and electronic books.")
    Component(Global Secondary Indexes (SearchIndex), "Global Secondary Indexes (SearchIndex)", "Amazon DynamoDB GSI", "Provides secondary access patterns for fast searching.")
    Component(DynamoDB Streams with AWS Lambda, "DynamoDB Streams with AWS Lambda", "DynamoDB Streams, AWS Lambda", "Captures change data events and triggers asynchronous processing.")
}

Rel(Catalog Table (Books), Global Secondary Indexes (SearchIndex), "Indexes data for search operations")
Rel(Catalog Table (Books), DynamoDB Streams with AWS Lambda, "Triggers change data capture events")

@enduml