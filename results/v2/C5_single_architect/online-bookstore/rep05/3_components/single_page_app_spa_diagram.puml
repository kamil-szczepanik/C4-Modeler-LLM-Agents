@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Single Page App (SPA) container

System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "External Identity Provider")
System_Ext(API_Gateway, "API Gateway", "API Gateway (Amazon API Gateway)")

Container_Boundary(Single_Page_App_SPA, "Single Page App (SPA)") {
    Component(Routing___Shell_Component, "Routing & Shell Component", "React Router, React & TypeScript", "Handles client-side routing, layout shells, and lazy loading for the application.")
    Component(Catalog___Search_View, "Catalog & Search View", "React & TypeScript", "Displays book browsing, search interfaces, and catalog data to customers.")
    Component(Cart___Checkout_Module, "Cart & Checkout Module", "React & TypeScript", "Manages shopping cart state, secure checkout flows, and order submission.")
    Component(Recommendation___Review_Widget, "Recommendation & Review Widget", "React & TypeScript", "Renders personalized recommendations and customer product reviews.")
    Component(Auth___State_Management_Client, "Auth & State Management Client", "React & TypeScript", "Manages user authentication sessions with the Identity Provider (IdP) via OIDC.")
    Component(Client_Side_Cache___API_Client, "Client-Side Cache & API Client", "TanStack Query, Axios, React & TypeScript", "Handles data fetching, request deduplication, optimistic updates, and caching.")
}

Rel(Routing___Shell_Component, Client_Side_Cache___API_Client, "Data fetching and state updates", "In-memory / Function Calls")
Rel(Catalog___Search_View, Client_Side_Cache___API_Client, "Data fetching and state updates", "In-memory / Function Calls")
Rel(Cart___Checkout_Module, Client_Side_Cache___API_Client, "Data fetching and state updates", "In-memory / Function Calls")
Rel(Recommendation___Review_Widget, Client_Side_Cache___API_Client, "Data fetching and state updates", "In-memory / Function Calls")
Rel(Auth___State_Management_Client, Identity_Provider_IdP, "User authentication", "HTTPS / OIDC")
Rel(Client_Side_Cache___API_Client, API_Gateway, "Fetches data and submits orders", "HTTPS / REST & GraphQL")

@enduml