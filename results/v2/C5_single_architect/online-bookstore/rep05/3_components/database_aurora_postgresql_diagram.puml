@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database (Aurora PostgreSQL) container

Container_Boundary(database_aurora_postgresql, "Database (Aurora PostgreSQL)") {
    Component(OrderSchema, "Order Schema", "Amazon Aurora PostgreSQL", "Manages ACID-compliant transactions, cart states, and immutable order history.")
    Component(CatalogInventorySchema, "Catalog & Inventory Schema", "Amazon Aurora PostgreSQL", "Handles book metadata, multi-currency pricing (USD, EUR, GBP), and stock levels.")
    Component(CustomerReviewSchema, "Customer & Review Schema", "Amazon Aurora PostgreSQL with Row-Level Security", "Stores user profiles and 5-star ratings with Row-Level Security for GDPR and CCPA compliance.")
}

Component(OrderCheckoutService, "Order & Checkout Service", "Microservice", "Processes secure customer transactions.")
Component(CatalogService, "Catalog Service", "Microservice", "Manages catalogue browsing and keyword search.")
Component(RecommendationService, "Recommendation Service", "Microservice", "Powers \"Customers also bought\" analytics.")

Rel(OrderCheckoutService, OrderSchema, "Persists transactional order data", "PostgreSQL Protocol")
Rel(CatalogService, CatalogInventorySchema, "Reads/writes book and pricing data", "PostgreSQL Protocol")
Rel(RecommendationService, CatalogInventorySchema, "Queries metadata and order history", "PostgreSQL Protocol")

@enduml