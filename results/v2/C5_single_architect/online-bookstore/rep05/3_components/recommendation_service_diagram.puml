@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Recommendation Service container

System_Ext(api_gateway, "API Gateway", "External system")
System_Ext(amazon_sqs, "Amazon SQS", "External system")

Container_Boundary(recommendation_service, "Recommendation Service") {
    Component(recommendation_api_controller, "Recommendation API Controller", "Python FastAPI", "Endpoint handling incoming recommendation requests.")
    Component(recommendation_engine, "Recommendation Engine", "Python NumPy/Scikit-learn", "Core logic implementing collaborative filtering and recommendation algorithms.")
    Component(model_ingestion_worker, "Model Ingestion Worker", "Python Celery", "Worker handling asynchronous model updates.")
    Component(cache_repository, "Cache Repository", "Python Redis-py", "Interface for high-performance caching.")
    Component(database_repository, "Database Repository", "Python SQLAlchemy/Boto3", "Data access layer for persistence.")
}

Rel(api_gateway, recommendation_api_controller, "Routes recommendation queries", "gRPC / HTTPS")
Rel(recommendation_api_controller, recommendation_engine, "Executes", "In-process Python function calls")
Rel(recommendation_engine, cache_repository, "Reads and writes pre-computed vectors", "Redis Protocol")
Rel(recommendation_engine, database_repository, "Fetches fallback catalog metadata", "In-process / HTTPS")
Rel(model_ingestion_worker, database_repository, "Persists computed recommendation weights", "In-process calls")
Rel(amazon_sqs, model_ingestion_worker, "Consumes user interaction events", "Polling / HTTPS")

@enduml