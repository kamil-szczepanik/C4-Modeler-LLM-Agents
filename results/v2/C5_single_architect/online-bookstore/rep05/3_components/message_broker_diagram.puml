@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Message Broker container

Person(Store_Administrator, "Store Administrator", "Receives operational alerts.")
System_Ext(Order_Checkout_Service, "Order & Checkout Service", "Publishes domain events.")
System_Ext(Recommendation_Service, "Recommendation Service", "Consumes asynchronous payloads.")

Container_Boundary(Message_Broker, "Message Broker") {
    Component(Event_Router, "Event Router", "Amazon EventBridge", "Amazon EventBridge for content-based domain event routing.")
    Component(Notification_Dispatcher, "Notification Dispatcher", "Amazon SNS", "Amazon SNS for broadcasting fan-out messages.")
    Component(Task_Queue_Manager, "Task Queue Manager", "Amazon SQS", "Amazon SQS for durable queue management and decoupling.")
    Component(DLQ_Monitor, "DLQ Monitor", "Amazon CloudWatch and AWS Lambda", "Amazon CloudWatch and AWS Lambda for alerting on unprocessable messages.")
}

Rel(Order_Checkout_Service, Event_Router, "Publishes domain events", "HTTPS / AWS SDK")
Rel(Event_Router, Task_Queue_Manager, "Dispatches asynchronous tasks", "AWS internal routing")
Rel(Task_Queue_Manager, Recommendation_Service, "Delivers payloads", "HTTP / SQS Long Polling")
Rel(Task_Queue_Manager, DLQ_Monitor, "Forwards unprocessable messages", "Amazon SQS Redrive Policy")
Rel(DLQ_Monitor, Store_Administrator, "Sends operational alerts", "Amazon SNS / Email")

@enduml