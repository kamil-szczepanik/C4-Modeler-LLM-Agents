@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person_Ext(recommendationservice, "Recommendation Service", "Python, FastAPI service that provides book recommendations.")
System_Ext(messagebroker, "Message Broker", "Amazon SQS, Amazon SNS, Amazon EventBridge")

Container_Boundary(cache, "Cache (ElastiCache Redis)") {
    Component(RecommendationCacheComponent, "Recommendation Cache Component", "Redis, ElastiCache", "Caches book recommendations for fast retrieval by the Recommendation Service.")
    Component(SessionStoreComponent, "Session Store Component", "Redis, ElastiCache", "Stores user session data for authentication and state management.")
}

Rel(recommendationservice, RecommendationCacheComponent, "Reads and writes recommendation data", "Redis Protocol")
Rel(messagebroker, RecommendationCacheComponent, "Triggers cache invalidation", "AMQP/SNS topics")
@enduml