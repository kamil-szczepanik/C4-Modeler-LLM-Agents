@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Recommendation Service container

Person(API Gateway, "API Gateway", "External system")
Person(Background Worker, "Background Worker", "External system")

Container_Boundary(Recommendation_Service, "Recommendation Service") {
    Component(API_Router, "API Router", "FastAPI Router (Python)", "Handling incoming requests.")
    Component(Recommendation_Engine, "Recommendation Engine", "Scikit-learn / PyTorch Light (Python)", "For inference and similarity computation.")
    Component(Feature_Store_Client, "Feature Store Client", "Redis Client (Python)", "Fetching user interaction history.")
    Component(Vector_DB_Repository, "Vector DB Repository", "Pinecone / pgvector client (Python)", "Querying book embeddings.")
    Component(Embedding_Sync_Worker, "Embedding Sync Worker", "Celery / Python Background Task (Python)", "Updating item embeddings asynchronously.")
}

Rel(API Gateway, API_Router, "Routes recommendation queries", "gRPC / HTTP")
Rel(API_Router, Recommendation_Engine, "Delegates scoring logic", "In-process / Python function calls")
Rel(Recommendation_Engine, Feature_Store_Client, "Retrieves user context", "TCP / Redis Protocol")
Rel(Recommendation_Engine, Vector_DB_Repository, "Queries book embeddings", "gRPC")
Rel(Background Worker, Embedding_Sync_Worker, "Publishes catalog change events", "AWS SQS / AMQP")
Rel(Embedding_Sync_Worker, Vector_DB_Repository, "Upserts book embeddings", "gRPC")

@enduml