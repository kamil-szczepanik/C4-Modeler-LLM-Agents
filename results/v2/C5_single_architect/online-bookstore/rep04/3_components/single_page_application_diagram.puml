@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("single_page_application", "Single Page Application") {
    Component(Router_and_Navigation, "Router and Navigation", "React Router", "Manages client-side routing and view navigation within the Single Page Application.")
    Component(State_Management_Store, "State Management Store", "Zustand", "Manages global application state including user session, cart data, and UI preferences.")
    Component(Catalog_and_Search_UI, "Catalog and Search UI", "React and TypeScript", "Renders book catalog browsing, filtering, and search interfaces.")
    Component(Checkout_and_Cart, "Checkout and Cart", "React and TypeScript", "Handles shopping cart management and checkout workflows for physical and electronic books.")
    Component(Recommendations_and_Reviews, "Recommendations and Reviews", "React and TypeScript", "Displays personalized book recommendations and customer reviews.")
    Component(Auth_and_Consent_Manager, "Auth and Consent Manager", "React and TypeScript", "Manages user authentication state and GDPR/CCPA compliance consent preferences.")
    Component(API_Client, "API Client", "Axios / Fetch", "Handles secure HTTPS/WSS communication with the backend API Gateway.")
}

Rel(Router_and_Navigation, Catalog_and_Search_UI, "Navigates to", "")
Rel(Router_and_Navigation, Checkout_and_Cart, "Navigates to", "")
Rel(Router_and_Navigation, Recommendations_and_Reviews, "Navigates to", "")
Rel(Checkout_and_Cart, State_Management_Store, "Reads and updates cart state", "")
Rel(Catalog_and_Search_UI, API_Client, "Fetches catalog and search data via", "")
Rel(Checkout_and_Cart, API_Client, "Submits orders via", "")
Rel(Recommendations_and_Reviews, API_Client, "Fetches recommendations and reviews via", "")
Rel(Auth_and_Consent_Manager, API_Client, "Sends authentication and consent data via", "")

@enduml