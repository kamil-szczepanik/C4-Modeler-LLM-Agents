@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(Cache, "Cache") {
    Component(CacheRoutingPolicyEngine, "Cache Routing & Policy Engine", "Go / Redis Go Client", "Powers the cache routing and policy engine for connection pooling and TTL enforcement.")
    Component(InMemoryStorageEngine, "In-Memory Storage Engine", "Redis Open Source Core", "Executes fast single-threaded key-value operations with volatile-lru eviction.")
}

Rel(CacheRoutingPolicyEngine, InMemoryStorageEngine, "Executes localized commands", "TCP Loopback")

@enduml