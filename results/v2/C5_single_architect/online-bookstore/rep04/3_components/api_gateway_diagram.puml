@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(JWT Authorizer, "JWT Authorizer", "AWS API Gateway Authorizer", "Validates JSON Web Tokens for incoming requests.")
    Component(Rate Limiter & WAF, "Rate Limiter & WAF", "AWS WAF", "Provides rate limiting and OWASP Top-10 mitigations.")
    Component(HTTP Proxy Router, "HTTP Proxy Router", "AWS API Gateway Proxy", "Routes incoming HTTP and gRPC requests to appropriate backend services.")
    Component(Request Transformation & Enrichment, "Request Transformation & Enrichment", "AWS API Gateway Mapping Templates", "Enriches payloads and transforms request structures.")
    Component(Response Caching, "Response Caching", "Amazon ElastiCache (Redis)", "Checks and stores cached responses for fast retrieval.")
}

System_Ext(Catalog Service, "Catalog Service", "Catalog microservice")
System_Ext(Recommendation Service, "Recommendation Service", "Recommendation microservice")
System_Ext(Order & Checkout Service, "Order & Checkout Service", "Order & Checkout microservice")
System_Ext(Review Service, "Review Service", "Review microservice")

Rel(JWT Authorizer, HTTP Proxy Router, "Forwards authenticated requests", "Internal")
Rel(HTTP Proxy Router, Request Transformation & Enrichment, "Enriches payloads", "Internal")
Rel(Request Transformation & Enrichment, Response Caching, "Checks and stores cache", "Internal / Amazon ElastiCache")
Rel(Response Caching, Catalog Service, "Fallback origin fetch", "gRPC over AWS VPC Link")
Rel(Response Caching, Recommendation Service, "Fallback origin fetch", "gRPC over AWS VPC Link")
Rel(HTTP Proxy Router, Order & Checkout Service, "Routes checkout requests", "gRPC / HTTP")
Rel(HTTP Proxy Router, Review Service, "Routes review queries", "gRPC / HTTP")

@enduml