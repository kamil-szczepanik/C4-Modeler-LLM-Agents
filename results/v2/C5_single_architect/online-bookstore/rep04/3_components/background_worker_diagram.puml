@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Background Worker container

Container_Boundary(background_worker, "Background Worker") {
    Component(Event_Consumer, "Event Consumer", "AWS Lambda / Python", "Polls message queues to process decoupled asynchronous tasks.")
    Component(Shipping_Integrator, "Shipping Integrator", "Python / AWS SDK", "Communicates with external shipping APIs for order fulfillment.")
    Component(Notification_Dispatcher, "Notification Dispatcher", "Python / AWS SDK", "Dispatches transactional emails and alerts.")
    Component(Outbox_Processor, "Outbox Processor", "Python / AWS ECS task", "Scans transaction tables to reliably publish domain events and prevent dual-write issues.")
    Component(AWS_SQS, "AWS SQS", "AWS SQS", "Asynchronous message queuing backbone.")
    Component(Order_Checkout_Database, "Order & Checkout Database", "RDS PostgreSQL", "Stores relational data and utilizes the transactional outbox pattern.")
}

Component(Shipping_Provider_API, "Shipping Provider API", "HTTPS (REST)", "External API for order fulfillment.")
Component(Notification_Service, "Notification Service", "HTTPS", "External service for dispatching alerts.")

Rel(Order_Checkout_Database, Outbox_Processor, "Queries unpublished outbox events", "SQL/TCP")
Rel(Outbox_Processor, Event_Consumer, "Relays reliable message payloads", "AWS SQS")
Rel(Shipping_Integrator, Shipping_Provider_API, "Submits fulfillment requests", "HTTPS (REST)")
Rel(Notification_Dispatcher, Notification_Service, "Dispatches alerts", "HTTPS")

@enduml