@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "External API Gateway routing requests")

Container_Boundary(catalog_service, "Catalog Service") {
    Component(Catalog_API_Controller, "Catalog API Controller", "Go", "Handles incoming gRPC and HTTP requests from the API Gateway.")
    Component(Catalog_Domain, "Catalog Domain", "Go modules", "Encapsulates business logic for browsing, keyword searching, and inventory status.")
    Component(Product_Repository, "Product Repository", "database/sql, pq driver", "Manages persistence and SQL query generation.")
    Component(Search_Adapter, "Search Adapter", "Go client packages", "Interfaces with text-search indices for complex keyword queries.")
    Component(Cache_Container, "Cache Container", "Amazon ElastiCache Redis", "Provides product caching.")
    Component(Product_Database, "Product Database", "PostgreSQL (RDS)", "Stores relational product data.")
}

Rel(api_gateway, Catalog_API_Controller, "Routes catalog queries", "gRPC and HTTP")
Rel(Catalog_API_Controller, Catalog_Domain, "Invokes business logic", "in-memory function calls")
Rel(Catalog_Domain, Product_Repository, "Reads and writes product data", "PostgreSQL Wire Protocol over TCP")
Rel(Product_Repository, Product_Database, "Reads and writes data", "TCP")
Rel(Catalog_Domain, Cache_Container, "Checks and populates product cache", "Redis Protocol over TCP")
Rel(Catalog_Domain, Search_Adapter, "Queries product indices", "HTTP over TCP")
@enduml