@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(review_service, "Review Service") {
    Component(ReviewController, "ReviewController", "Spring REST endpoint handler", "REST endpoint handler for review queries and submissions.")
    Component(ReviewServiceBean, "ReviewServiceBean", "Java Spring Boot", "Core business logic processor.")
    Component(ReviewRepository, "ReviewRepository", "MongoDB Java Driver", "Data access layer for review documents.")
    Component(RatingAggregator, "RatingAggregator", "Asynchronous event listener", "Asynchronous event listener and rating calculator.")
    Component(ModerationClient, "ModerationClient", "Spring Cloud OpenFeign", "Spring Cloud OpenFeign client for NLP content moderation.")
}

System_Ext(api_gateway, "API Gateway", "Entry point routing requests to the Review Service.")
System_Ext(mongodb, "MongoDB (Document DB)", "Persistent data store for reviews.")
System_Ext(redis, "Amazon ElastiCache (Redis)", "Caching layer for review data.")

Rel(api_gateway, ReviewController, "Routes review queries and submissions", "gRPC / HTTP")
Rel(ReviewController, ReviewServiceBean, "Delegates requests", "In-process")
Rel(ReviewServiceBean, ReviewRepository, "Invokes data operations", "In-process")
Rel(ReviewServiceBean, ModerationClient, "Sends review text for NLP checks", "REST / HTTPS")
Rel(ReviewRepository, mongodb, "Reads and writes review documents", "TCP")
Rel(RatingAggregator, redis, "Invalidates and updates cached review data", "TCP")
@enduml