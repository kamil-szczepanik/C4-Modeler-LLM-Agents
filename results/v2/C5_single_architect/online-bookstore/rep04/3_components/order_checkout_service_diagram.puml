@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Order & Checkout Service container

System_Ext(PaymentGateway, "Payment Gateway", "External payment processor")
System_Ext(TaxCalculationService, "Tax Calculation Service", "External tax calculation provider")
System_Ext(ShippingProviderAPI, "Shipping Provider API", "External shipping and logistics provider")
System_Ext(AwsSqsSns, "AWS SQS / SNS", "Amazon Web Services messaging infrastructure")
System_Ext(PostgreSQLRds, "PostgreSQL (RDS)", "Relational database for transactional data")

Container_Boundary(OrderCheckoutService, "Order & Checkout Service") {
    Component(CartControllerManager, "Cart Controller & Manager", "Node.js", "Manages shopping cart operations and user cart state.")
    Component(CheckoutOrchestrator, "Checkout Orchestrator", "Node.js / Saga / State Machine", "Orchestrates the checkout process and distributed transactions.")
    Component(FulfillmentAdapter, "Fulfillment Adapter", "Node.js", "Adapts and communicates with external shipping providers.")
    Component(DomainEventPublisher, "Domain Event Publisher", "Node.js / AWS SDK", "Publishes asynchronous events to AWS SQS / SNS.")
    Component(OrderRepository, "Order Repository", "Node.js", "Handles data persistence for orders in PostgreSQL.")
}

Rel(CheckoutOrchestrator, PaymentGateway, "Processes secure payments", "HTTPS")
Rel(CheckoutOrchestrator, TaxCalculationService, "Queries regional tax rates", "HTTPS")
Rel(FulfillmentAdapter, ShippingProviderAPI, "Requests fulfillment and shipping labels", "HTTPS")
Rel(DomainEventPublisher, AwsSqsSns, "Publishes asynchronous events", "AWS SDK")
Rel(OrderRepository, PostgreSQLRds, "Reads and writes order transactional data", "TCP")

@enduml