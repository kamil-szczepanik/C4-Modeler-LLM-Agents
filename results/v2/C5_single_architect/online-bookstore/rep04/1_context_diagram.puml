@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "End-user browsing books, managing cart, and purchasing via web/mobile browsers.")
System(OnlineBookstore, "Online Bookstore", "A scaled-down Amazon-style e-commerce platform for purchasing physical and electronic books, providing catalogue browsing, secure checkout, reviews, and personalized recommendations.")
System_Ext(PaymentGateway, "Payment Gateway", "Handles secure checkout and multi-currency transactions (USD, EUR, GBP).")
System_Ext(ShippingProviderAPI, "Shipping Provider API", "Manages logistics, shipping labels, and tracking.")
System_Ext(IdentityProviderOAuth, "Identity Provider / OAuth", "Manages secure customer authentication.")
System_Ext(NotificationService, "Notification Service", "Sends transactional emails and SMS for order confirmations and resets.")
System_Ext(TaxCalculationService, "Tax Calculation Service", "Calculates regional taxes for compliance during checkout.")

Rel(Customer, OnlineBookstore, "Browses catalogue, manages cart, and completes checkout", "HTTPS")
Rel(OnlineBookstore, PaymentGateway, "Processes secure multi-currency payments", "HTTPS / REST")
Rel(OnlineBookstore, ShippingProviderAPI, "Requests fulfillment and tracks shipments", "HTTPS / REST")
Rel(OnlineBookstore, IdentityProviderOAuth, "Authenticates users securely", "OIDC / OAuth2 over HTTPS")
Rel(OnlineBookstore, NotificationService, "Dispatches transactional alerts", "HTTPS / REST")
Rel(OnlineBookstore, TaxCalculationService, "Queries regional tax rates during checkout", "HTTPS / REST")
@enduml