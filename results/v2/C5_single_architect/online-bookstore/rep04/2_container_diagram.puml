@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "End-user browsing books, managing cart, and purchasing via web/mobile browsers.")

System_Ext(Payment Gateway, "Payment Gateway", "Handles secure checkout and multi-currency transactions.")
System_Ext(Shipping Provider API, "Shipping Provider API", "Manages logistics, shipping labels, and tracking.")
System_Ext(Identity Provider, "Identity Provider", "Manages secure customer authentication.")
System_Ext(Notification Service, "Notification Service", "Sends transactional emails and SMS for order confirmations and resets.")
System_Ext(Tax Calculation Service, "Tax Calculation Service", "Calculates regional taxes for compliance during checkout.")

System_Boundary(Online Bookstore, "Online Bookstore") {
    Container(Single Page Application, "Single Page Application", "React / TypeScript, AWS S3/CloudFront", "Provides the user interface for catalog browsing, recommendations, and reviews.")
    Container(API Gateway, "API Gateway", "AWS API Gateway", "Centralizes entry point, JWT validation, and OWASP rate limiting.")
    Container(Catalog Service, "Catalog Service", "Go, PostgreSQL (RDS)", "Manages book catalog and product information.")
    Container(Order & Checkout Service, "Order & Checkout Service", "Node.js, PostgreSQL (RDS)", "Handles shopping cart, checkout, and order fulfillment processes.")
    Container(Recommendation Service, "Recommendation Service", "Python FastAPI, Vector DB", "Provides personalized book recommendations using AI.")
    Container(Review Service, "Review Service", "Java Spring Boot, MongoDB", "Manages customer reviews and ratings.")
    Container(Background Worker, "Background Worker", "AWS ECS/Lambda, AWS SQS/SNS", "Handles asynchronous event-driven decoupling for shipping, notifications, and background tasks.")
    Container(Cache, "Cache", "Redis, Amazon ElastiCache", "Provides fast in-memory caching for core services.")
}

Rel(Customer, Single Page Application, "Browses bookstore, manages cart, and views recommendations", "HTTPS")
Rel(Single Page Application, API Gateway, "Makes API requests for catalog, orders, recommendations, and reviews", "HTTPS / WSS")
Rel(API Gateway, Catalog Service, "Routes catalog queries", "gRPC / HTTP")
Rel(API Gateway, Order & Checkout Service, "Routes checkout and order requests", "gRPC / HTTP")
Rel(API Gateway, Recommendation Service, "Routes recommendation queries", "gRPC / HTTP")
Rel(API Gateway, Review Service, "Routes review queries and submissions", "gRPC / HTTP")
Rel(Catalog Service, Cache, "Reads and writes cached catalog data", "TCP")
Rel(Order & Checkout Service, Cache, "Reads and writes cached session and order data", "TCP")
Rel(Recommendation Service, Cache, "Reads and writes cached recommendation data", "TCP")
Rel(Review Service, Cache, "Reads and writes cached review data", "TCP")
Rel(Order & Checkout Service, Background Worker, "Publishes asynchronous events for shipping and notifications", "AWS SQS (AWS SDK)")
Rel(Order & Checkout Service, Payment Gateway, "Processes secure payments and transactions", "HTTPS")
Rel(Order & Checkout Service, Shipping Provider API, "Requests fulfillment and shipping labels", "HTTPS")
Rel(Order & Checkout Service, Tax Calculation Service, "Queries regional tax rates", "HTTPS")
Rel(Background Worker, Notification Service, "Dispatches transactional emails and SMS", "HTTPS")

@enduml