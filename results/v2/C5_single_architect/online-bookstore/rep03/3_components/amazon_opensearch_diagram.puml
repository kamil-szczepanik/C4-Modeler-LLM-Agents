@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_opensearch, "Amazon OpenSearch") {
    Component(CatalogSearchIndex, "Catalog Search Index", "Amazon OpenSearch Managed Index", "Stores and indexes book catalog data for fast retrieval and full-text search.")
    Component(OpenSearchRESTAPIEngine, "OpenSearch REST API Engine", "OpenSearch REST API", "Handles incoming search and synchronization queries from the Catalog Service.")
    Component(IndexManagementIngestionService, "Index Management & Ingestion Service", "OpenSearch Ingestion Service", "Manages data ingestion pipelines and index lifecycles.")
    Component(SearchAnalyticsSuggestionsEngine, "Search Analytics & Suggestions Engine", "OpenSearch Analytics Engine", "Powers search auto-complete suggestions and search analytics for the platform.")
}

Rel(OpenSearchRESTAPIEngine, CatalogSearchIndex, "Queries and synchronizes product data")
Rel(SearchAnalyticsSuggestionsEngine, CatalogSearchIndex, "Fetches indexing data for auto-complete suggestions")

@enduml