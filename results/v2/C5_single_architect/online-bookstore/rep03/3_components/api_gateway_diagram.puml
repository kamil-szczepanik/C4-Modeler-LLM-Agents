@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(RoutingDispatcherComponent, "Routing & Dispatcher Component", "AWS API Gateway Routing", "Dispatches sanitized payloads to downstream services.")
    Component(AuthenticationAuthorizationComponent, "Authentication & Authorization Component", "AWS API Gateway Auth", "Validates tokens and forwards identity context.")
    Component(RateLimitingThrottlingComponent, "Rate Limiting & Throttling Component", "AWS API Gateway Throttling", "Manages edge rate-limiting.")
    Component(RequestTransformationValidationComponent, "Request Transformation & Validation Component", "AWS API Gateway Validation", "Validates and transforms incoming requests.")
}

Rel(AuthenticationAuthorizationComponent, RequestTransformationValidationComponent, "Forwards identity context", "Internal")
Rel(RequestTransformationValidationComponent, RoutingDispatcherComponent, "Dispatches sanitized payloads", "Internal")

@enduml