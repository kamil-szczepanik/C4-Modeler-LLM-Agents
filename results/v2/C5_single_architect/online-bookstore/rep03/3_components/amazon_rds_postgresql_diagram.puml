@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_rds_postgresql, "Amazon RDS (PostgreSQL)") {
    Component(Connection Pooler, "Connection Pooler", "PgBouncer / RDS Proxy", "Manages and pools database connections to mitigate exhaustion under high concurrency.")
    Component(Relational Schema, "Relational Schema", "PostgreSQL", "ACID-compliant relational data storage for core transactional data.")
    Component(Read Replica, "Read Replica", "PostgreSQL Read Replica", "Handles read-heavy workloads through asynchronous replication.")
    Component(Audit Component, "Audit Component", "pgAudit", "Provides detailed session and object audit logging for GDPR/CCPA compliance.")
    Component(PITR Component, "PITR Component", "AWS Automated Backups", "Enables Point-In-Time Recovery for data protection and disaster recovery.")
}

Rel(Connection Pooler, Relational Schema, "TCP Local / Unix Domain Sockets")
Rel(Relational Schema, Read Replica, "Asynchronous replication")

@enduml