@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Recommendation Service container

System_Ext(api_gateway, "API Gateway", "Routes inbound requests.")
System_Ext(sqs, "SQS", "Delivers asynchronous domain events.")
System_Ext(amazon_elasticache_redis, "Amazon ElastiCache (Redis)", "Enables low-latency caching to meet sub-2s page load constraints.")
System_Ext(amazon_opensearch, "Amazon OpenSearch", "Powers fast vector and catalog lookups for recommendations.")

Container_Boundary(recommendation_service, "Recommendation Service") {
    Component(recommendation_controller, "Recommendation Controller", "NestJS REST Controller", "Serves real-time recommendations to maintain high performance under scale.")
    Component(event_consumer_worker, "Event Consumer Worker", "NestJS Background Service", "Processes asynchronous order events.")
    Component(recommendation_engine_core, "Recommendation Engine Core", "TypeScript Domain Service", "Generates personalized 'Customers also bought' suggestions.")
    Component(model_cache_manager, "Model Cache Manager", "NestJS Provider", "Manages precomputed cache for low-latency lookups.")
    Component(data_access_repository, "Data Access Repository", "NestJS Provider", "Handles data access operations.")
}

Rel(api_gateway, recommendation_controller, "Routes inbound requests", "HTTP/REST")
Rel(sqs, event_consumer_worker, "Consumes asynchronous domain events", "SQS/Polling")
Rel(recommendation_engine_core, model_cache_manager, "Checks precomputed cache", "Function Call")
Rel(model_cache_manager, amazon_elasticache_redis, "Reads/writes cached payloads", "Redis Protocol")
Rel(recommendation_engine_core, amazon_opensearch, "Queries product metadata and vectors", "HTTPS/REST")

@enduml