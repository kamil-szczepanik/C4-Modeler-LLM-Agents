@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog Service container

Container_Boundary(catalog_service, "Catalog Service") {
    Component(CatalogController, "CatalogController", "NestJS Controller", "Exposes RESTful endpoints for browsing, search, and reviews.")
    Component(SearchService, "SearchService", "NestJS Service", "Encapsulates query logic for high-performance keyword searches.")
    Component(ReviewService, "ReviewService", "NestJS Service", "Manages business logic for customer reviews and 5-star ratings.")
    Component(CacheManager, "CacheManager", "NestJS Service", "Handles caching of hot catalog data to reduce database load.")
    Component(CatalogRepository, "CatalogRepository", "NestJS Repository", "Handles core book metadata persistence.")
}

System_Ext(AmazonOpenSearch, "Amazon OpenSearch", "External system providing keyword search indexing.")
System_Ext(AmazonDynamoDB, "Amazon DynamoDB", "NoSQL database for customer reviews and ratings.")
System_Ext(AmazonElastiCacheRedis, "Amazon ElastiCache (Redis)", "In-memory cache for frequently accessed book details and search results.")

Rel(CatalogController, SearchService, "In-process method calls", "TypeScript")
Rel(CatalogController, ReviewService, "In-process method calls", "TypeScript")
Rel(CatalogController, CacheManager, "In-process method calls", "TypeScript")
Rel(SearchService, AmazonOpenSearch, "Performs keyword search", "HTTPS / REST")
Rel(ReviewService, AmazonDynamoDB, "Reads and writes reviews", "TCP / DynamoDB API")
Rel(CacheManager, AmazonElastiCacheRedis, "Caches hot catalog data", "TCP / Redis Protocol")
@enduml