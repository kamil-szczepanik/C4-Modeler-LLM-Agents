@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_eventbridge_sqs, "AWS EventBridge & SQS") {
    Component(AWS_EventBridge_Event_Bus, "AWS EventBridge Event Bus", "AWS EventBridge", "Publishes and routes domain events based on pattern rules.")
    Component(Amazon_SQS_Queues, "Amazon SQS Queues", "Amazon SQS", "Queues messages routed from EventBridge for asynchronous processing.")
    Component(SQS_Dead_Letter_Queues_DLQs_, "SQS Dead Letter Queues (DLQs)", "Amazon SQS DLQ", "Captures failed messages for error handling and debugging.")
}

Rel(AWS_EventBridge_Event_Bus, Amazon_SQS_Queues, "Routes messages based on pattern rules", "SQS Queue Policy / AWS internal API")
Rel(Amazon_SQS_Queues, SQS_Dead_Letter_Queues_DLQs_, "Forwards failed messages after max receive count is exceeded")

@enduml