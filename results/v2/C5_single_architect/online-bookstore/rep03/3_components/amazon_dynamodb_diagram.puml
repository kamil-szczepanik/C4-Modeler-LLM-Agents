@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(CatalogService, "Catalog Service", "External caller to the DynamoDB container")

Container_Boundary(AmazonDynamoDB, "Amazon DynamoDB") {
    Component(RequestRouter, "Request Router", "AWS DynamoDB Internal", "Routes incoming requests to the appropriate partition nodes.")
    Component(PartitionRouter, "Partition Router", "AWS DynamoDB Internal", "Determines which partition stores the requested data based on primary keys.")
    Component(StorageNode, "Storage Node", "AWS DynamoDB Internal", "Persists the actual data items on solid-state storage.")
    Component(ReplicationManager, "Replication Manager", "AWS DynamoDB Internal", "Manages data replication across multiple availability zones for durability and high availability.")
    Component(StreamsProcessor, "Streams Processor", "AWS DynamoDB Streams", "Captures time-ordered sequence of item-level changes in tables.")
    Component(GSIManager, "Global Secondary Index (GSI) Manager", "AWS DynamoDB GSI", "Manages indexes that allow querying data using an alternate partition and sort key, such as book reviews and ratings sorted by date or score.")
}

Rel(CatalogService, RequestRouter, "Sends read and write requests for customer reviews and ratings", "DynamoDB API")
Rel(CatalogService, GSIManager, "Queries book reviews and ratings sorted by date or score", "DynamoDB API")

@enduml