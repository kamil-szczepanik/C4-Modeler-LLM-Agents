@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(OrderCheckoutService, "Order & Checkout Service", "Node.js, NestJS, Amazon ECS/Fargate", "Handles customer order placement and checkout flows.")
System_Ext(CatalogService, "Catalog Service", "Node.js, NestJS, Amazon ECS/Fargate", "Manages the book catalog and search functionality.")
System_Ext(RecommendationService, "Recommendation Service", "Node.js, NestJS, Amazon ECS/Fargate", "Provides book recommendations to customers.")

Container_Boundary(ElastiCache_Redis, "Amazon ElastiCache (Redis)") {
    Component(SessionStore, "SessionStore", "Redis", "Stores user session data for the Order & Checkout Service.")
    Component(RecommendationCache, "RecommendationCache", "Redis", "Caches recommendation data for the Recommendation Service.")
    Component(CatalogCache, "CatalogCache", "Redis", "Caches catalog data for the Catalog Service.")
}

Rel(OrderCheckoutService, SessionStore, "Reads and writes session data", "Redis Protocol / TCP")
Rel(CatalogService, CatalogCache, "Reads and writes catalog cache", "Redis Protocol / TCP")
Rel(RecommendationService, RecommendationCache, "Reads and writes recommendation cache", "Redis Protocol / TCP")

@enduml