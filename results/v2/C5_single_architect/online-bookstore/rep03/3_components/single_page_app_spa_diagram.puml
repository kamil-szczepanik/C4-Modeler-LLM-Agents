@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Single-Page App (SPA) container

Container_Boundary(spa, "Single-Page App (SPA)") {
    Component(router_view_controller, "Router & View Controller", "React Router", "Manages client-side routing, view rendering, and navigation across different pages of the bookstore.")
    Component(global_state_store, "Global State Store", "Redux Toolkit", "Manages global application state, user sessions, shopping cart data, and caching for fast rendering.")
    Component(api_client_service, "API Client Service", "Axios / Fetch API", "Handles HTTP requests and communication with the backend API Gateway.")
}

Rel(router_view_controller, global_state_store, "Reads and updates application state")
Rel(router_view_controller, api_client_service, "Triggers API calls on user interaction")
Rel(api_client_service, global_state_store, "Stores fetched data")

@enduml