@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "End-user browsing catalogues, purchasing items, and leaving reviews.")
Person(Administrator, "Administrator", "Manages inventory, pricing, and content moderation.")

System(OnlineBookstoreSystem, "Online Bookstore System", "A scaled-down Amazon-style e-commerce platform designed for purchasing physical and electronic books with recommendations, reviews, multi-currency support, and global retail capabilities.")

System_Ext(PaymentGateway, "Payment Gateway", "Stripe or PayPal for secure checkout and multi-currency transactions.")
System_Ext(ShippingProviderAPIs, "Shipping Provider APIs", "Third-party logistics for fulfillment tracking.")
System_Ext(EmailService, "Email Service", "Sendgrid or AWS SES for transactional notifications.")
System_Ext(IdentityProvider, "Identity Provider", "Auth0 or AWS Cognito for authentication and compliance.")
System_Ext(TaxCalculationService, "Tax Calculation Service", "Avalara or TaxJar for regional tax calculations.")

Rel(Customer, OnlineBookstoreSystem, "Browses catalogues, purchases items, and leaves reviews", "HTTPS")
Rel(Administrator, OnlineBookstoreSystem, "Manages inventory, pricing, and content moderation", "HTTPS")
Rel(OnlineBookstoreSystem, PaymentGateway, "Processes secure checkout and multi-currency transactions", "REST/TLS")
Rel(OnlineBookstoreSystem, ShippingProviderAPIs, "Handles fulfillment tracking", "REST/JSON")
Rel(OnlineBookstoreSystem, IdentityProvider, "Performs user authentication and identity management", "OIDC/OAuth2/HTTPS")
Rel(OnlineBookstoreSystem, TaxCalculationService, "Computes dynamic regional taxes", "REST/TLS")
Rel(OnlineBookstoreSystem, EmailService, "Sends transactional notifications", "REST/HTTPS")

@enduml