@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Recommendations Container container

Container_Boundary(recommendations_container, "Recommendations Container") {
    Component(Recommendation API Router, "Recommendation API Router", "FastAPI / Python", "Provides high-performance asynchronous API endpoints for real-time recommendation delivery.")
    Component(Recommendation Service, "Recommendation Service", "Python", "Orchestrates recommendation scoring, caching, and data retrieval workflows.")
    Component(Collaborative Filtering Engine, "Collaborative Filtering Engine", "Python / NumPy & SciPy", "Enables efficient computation of collaborative filtering and recommendation vectors.")
    Component(Cache & Persistence Access Layer, "Cache & Persistence Access Layer", "SQLAlchemy / Boto3", "Manages persistence access to Amazon Aurora PostgreSQL and Amazon DynamoDB securely over TLS.")
    Component(In-Memory Cache, "In-Memory Cache", "Redis / Amazon ElastiCache", "Caches pre-computed vectors and lists to ensure low-latency responses under high concurrency.")
    Component(Amazon Aurora PostgreSQL & Amazon DynamoDB, "Amazon Aurora PostgreSQL & Amazon DynamoDB", "SQL / NoSQL", "Persistent storage for recommendation data and user metrics.")
}

Rel(Recommendation API Router, Recommendation Service, "Direct function calls (In-memory)", "gRPC over TLS")
Rel(Recommendation Service, Collaborative Filtering Engine, "Invokes recommendation scoring algorithms", "In-memory")
Rel(Recommendation Service, In-Memory Cache, "Reads cached recommendation payloads", "RESP over TCP / TLS")
Rel(Recommendation Service, Cache & Persistence Access Layer, "Orchestrates data retrieval", "In-memory")
Rel(Cache & Persistence Access Layer, Amazon Aurora PostgreSQL & Amazon DynamoDB, "Reads and writes recommendation data", "SQL / NoSQL over TLS")
Rel(Cache & Persistence Access Layer, In-Memory Cache, "Fallback population on cache misses", "RESP over TCP")

@enduml