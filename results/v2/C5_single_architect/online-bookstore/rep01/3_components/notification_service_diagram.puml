@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(notification_service, "Notification Service") {
    Component(Notification_Router_Component, "Notification Router Component", "Go", "Handles incoming gRPC requests and domain events.")
    Component(Template_Engine_Component, "Template Engine Component", "Go", "Compiles localized templates using Amazon DynamoDB.")
    Component(Dispatcher_Worker_Pool_Component, "Dispatcher Worker Pool Component", "Go", "Concurrent Go workers executing third-party API dispatches.")
    Component(Delivery_Status_Tracker_Component, "Delivery Status Tracker Component", "Go", "Records audit logs to Amazon Aurora PostgreSQL.")
    Component(Event_Consumer_Component, "Event Consumer Component", "Go", "Subscribes to the async event bus.")
}

Rel(Notification_Router_Component, Template_Engine_Component, "Invokes rendering", "in-memory function calls")
Rel(Template_Engine_Component, Dispatcher_Worker_Pool_Component, "Passes payloads", "Go channels")
@enduml