@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Order & Checkout Container container

Container_Boundary("Order & Checkout Container", "Order & Checkout Container") {
    Component(ApiGateway, "API Gateway", "AWS API Gateway", "AWS API Gateway entry point routing external requests.")
    Component(CheckoutOrchestratorComponent, "Checkout Orchestrator Component", "TypeScript, In-memory state machine", "TypeScript domain service coordinating workflows and saga patterns via an in-memory state machine.")
    Component(CartManagementComponent, "Cart Management Component", "TypeScript, Express Router, Amazon DynamoDB", "TypeScript Express Router managing ephemeral and persistent cart state via Amazon DynamoDB.")
    Component(PaymentClientComponent, "Payment Client Component", "TypeScript, Axios, Circuit Breakers", "TypeScript Axios client encapsulating Third-Party Payment Gateway integrations with circuit breakers.")
    Component(OrderPersistenceComponent, "Order Persistence Component", "TypeScript, Prisma ORM, Amazon Aurora PostgreSQL", "TypeScript Prisma ORM managing transactional writes to Amazon Aurora PostgreSQL.")
}

System_Ext(ThirdPartyPaymentGateway, "Third-Party Payment Gateway", "External Service, HTTPS", "External system for authorizing and processing charges.")
System_Ext(AsyncEventBus, "Async Event Bus", "Amazon EventBridge / Amazon MSK", "Event bus for emitting asynchronous events such as OrderPlaced.")

Rel(ApiGateway, CheckoutOrchestratorComponent, "Routes order and cart requests", "gRPC over TLS")
Rel(CheckoutOrchestratorComponent, CartManagementComponent, "Fetches and updates shopping cart items", "In-process / NoSQL over TLS")
Rel(CheckoutOrchestratorComponent, PaymentClientComponent, "Requests secure payment processing", "In-process function calls")
Rel(PaymentClientComponent, ThirdPartyPaymentGateway, "Authorizes and processes charges", "HTTPS (TLS)")
Rel(CheckoutOrchestratorComponent, OrderPersistenceComponent, "Persists finalized order data", "Prisma ORM via SQL over TLS")
Rel(CheckoutOrchestratorComponent, AsyncEventBus, "Emits OrderPlaced events", "AWS SDK over TLS")

@enduml