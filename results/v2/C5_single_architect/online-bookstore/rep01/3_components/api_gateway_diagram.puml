@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(RoutingDispatcher, "Routing & Dispatcher", "AWS API Gateway Routing", "Routes API requests to the appropriate backend microservices.")
    Component(AuthFilter, "Auth Filter", "AWS API Gateway Auth Filter", "Validates tokens and handles authentication for incoming requests.")
    Component(RateLimiter, "Rate Limiter", "AWS API Gateway Rate Limiter", "Limits request rates to ensure availability and prevent abuse.")
    Component(RequestTransformationCaching, "Request Transformation/Caching", "AWS API Gateway Transformation & Cache", "Transforms payloads and caches responses for low-latency page loads.")
}

Rel(AuthFilter, RoutingDispatcher, "Validates tokens and proxies payloads", "Internal Memory")

@enduml