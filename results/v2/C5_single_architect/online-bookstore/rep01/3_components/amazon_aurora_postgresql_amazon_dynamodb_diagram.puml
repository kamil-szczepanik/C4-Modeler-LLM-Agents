@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_aurora_postgresql_amazon_dynamodb, "Amazon Aurora PostgreSQL & Amazon DynamoDB") {
    Component(Catalog_User_Relational_DB, "Catalog & User Relational DB", "Amazon Aurora PostgreSQL Multi-Region", "Stores structured book, review data, and provides ACID compliance for financial orders.")
    Component(Cart_Session_NoSQL_Store, "Cart & Session NoSQL Store", "Amazon DynamoDB Global Tables", "Delivers low-latency storage for shopping carts and sessions.")
}

Rel(Catalog_Search_Container, Catalog_User_Relational_DB, "Queries structured book/review data", "JDBC/SQL over TLS")
Rel(Order_Checkout_Container, Cart_Session_NoSQL_Store, "Reads/writes cart data", "AWS SDK / HTTPS")
@enduml