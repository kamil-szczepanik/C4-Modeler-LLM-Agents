@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog & Search Container container

System_Ext(api_gateway, "API Gateway", "External API Gateway routing requests.")
System_Ext(amazon_opensearch, "Amazon OpenSearch", "Managed search and analytics service.")

Container_Boundary(catalog_and_search_container, "Catalog & Search Container") {
    Component(catalog_controller, "Catalog Controller", "Spring Web/gRPC", "Component acting as the entry point.")
    Component(search_service, "Search Service", "Elasticsearch/AWS OpenSearch", "Component for full-text indexing and queries.")
    Component(inventory_manager, "Inventory Manager", "Spring Data JPA", "Component for stock and metadata.")
    Component(recommendation_ingestion_component, "Recommendation Ingestion Component", "Spring Batch", "Component for interaction data.")
    Component(ml_inference_bridge, "ML Inference Bridge", "AWS SDK / SageMaker Runtime", "Component for model invocation.")
    ComponentDb(amazon_aurora_postgresql_and_amazon_dynamodb, "Amazon Aurora PostgreSQL & Amazon DynamoDB", "Relational and NoSQL datastores", "Relational and NoSQL datastores.")
    Component_Ext(amazon_sagemaker, "Amazon SageMaker", "Managed machine learning service", "Managed machine learning service.")
}

Rel(api_gateway, catalog_controller, "Routes catalog requests", "gRPC over TLS")
Rel(catalog_controller, search_service, "Queries product indices", "Internal REST/HTTP over TLS")
Rel(catalog_controller, ml_inference_bridge, "Fetches recommendations", "gRPC")
Rel(search_service, amazon_opensearch, "Indexes and retrieves catalog items", "HTTPS")
Rel(inventory_manager, amazon_aurora_postgresql_and_amazon_dynamodb, "Persists book data", "JDBC over TLS")
Rel(recommendation_ingestion_component, amazon_aurora_postgresql_and_amazon_dynamodb, "Reads aggregated history", "NoSQL over TLS")
Rel(ml_inference_bridge, amazon_sagemaker, "Invokes models", "HTTPS over TLS")

@enduml