@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(spa, "Single Page Application (SPA)") {
    Component(RouterShell, "Router / Shell", "React Router, Context API", "Manages client-side routing, global context, and layouts.")
    Component(CatalogSearchView, "Catalog & Search View", "React, TanStack Query", "Renders book grids, filters, and keyword search.")
    Component(CartCheckoutView, "Cart & Checkout View", "React, Zustand", "Manages shopping cart state and checkout workflows.")
    Component(ReviewsRatingsWidget, "Reviews & Ratings Widget", "React", "Handles 5-star submissions and reviews display.")
    Component(StateHydrationCachingManager, "State Hydration / Caching Manager", "TanStack Query, Zustand persist", "Handles local storage persistence, JWT memory management, and optimistic UI updates.")
    Component(ApiClientLayer, "API Client Layer", "Axios, Fetch API", "Centralized HTTP client managing requests and token injection.")
}

System_Ext(ApiGateway, "API Gateway", "REST, GraphQL, HTTPS", "External entry point for backend microservices.")

Rel(CatalogSearchView, ApiGateway, "Fetches catalog and search data", "HTTPS")
Rel(CartCheckoutView, ApiGateway, "Submits cart and checkout orders", "HTTPS")
Rel(CatalogSearchView, ApiClientLayer, "Executes network requests", "internal function calls")
Rel(CartCheckoutView, ApiClientLayer, "Executes network requests", "internal function calls")
Rel(ReviewsRatingsWidget, ApiClientLayer, "Executes network requests", "internal function calls")
Rel(RouterShell, ApiClientLayer, "Executes network requests", "internal function calls")
Rel(CatalogSearchView, StateHydrationCachingManager, "Persists state and caches data locally", "")
Rel(CartCheckoutView, StateHydrationCachingManager, "Persists state and caches data locally", "")
Rel(ReviewsRatingsWidget, StateHydrationCachingManager, "Persists state and caches data locally", "")
Rel(RouterShell, StateHydrationCachingManager, "Persists state and caches data locally", "")

@enduml