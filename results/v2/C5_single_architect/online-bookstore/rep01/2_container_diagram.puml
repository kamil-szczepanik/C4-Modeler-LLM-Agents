@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore

Person(Customer, "Customer", "End-user accessing the platform via web or mobile to browse, purchase, and review physical and electronic books.")

System_Ext(ThirdPartyPaymentGateway, "Third-Party Payment Gateway", "External system for secure checkout and transaction processing.")
System_Ext(ThirdPartyShippingProvider, "Third-Party Shipping Provider", "External system for order fulfillment and tracking.")
System_Ext(IdentityProvider, "Identity Provider", "External system for authentication and identity management.")
System_Ext(CurrencyExchangeRateService, "Currency Exchange Rate Service", "External system providing live multi-currency conversion rates.")

System_Boundary(OnlineBookstore, "Online Bookstore") {
    Container(SinglePageApplicationSPA, "Single Page Application (SPA)", "React / TypeScript on Amazon S3 + CloudFront", "Provides the user interface for browsing books, managing carts, and viewing orders.")
    Container(APIGateway, "API Gateway", "AWS API Gateway", "Handles rate limiting, auth validation, and routing requests to backend containers.")
    Container(CatalogSearchContainer, "Catalog & Search Container", "Spring Boot, Amazon SageMaker", "Manages book inventory, search capabilities, and AI/ML recommendations.")
    Container(OrderCheckoutContainer, "Order & Checkout Container", "Node.js / Express", "Handles order processing, cart management, and payment orchestration.")
    Container(RecommendationsContainer, "Recommendations Container", "Python / FastAPI", "Computes and serves personalized book recommendations.")
    Container(NotificationService, "Notification Service", "Go", "Sends notifications and alerts to customers.")
    Container(AsyncEventBus, "Async Event Bus", "Amazon EventBridge / Amazon MSK", "Facilitates asynchronous event-driven decoupling between microservices.")
    ContainerDb(AmazonAuroraPostgreSQLAmazonDynamoDB, "Amazon Aurora PostgreSQL & Amazon DynamoDB", "Amazon Aurora PostgreSQL, Amazon DynamoDB", "Persistent storage for relational data, carts, and sessions.")
}

Rel(Customer, SinglePageApplicationSPA, "Interacts with the platform", "HTTPS / WSS")
Rel(SinglePageApplicationSPA, APIGateway, "Sends API requests", "HTTPS (REST/GraphQL)")
Rel(APIGateway, CatalogSearchContainer, "Routes catalog requests", "gRPC over TLS (VPC private subnets)")
Rel(APIGateway, OrderCheckoutContainer, "Routes order requests", "gRPC over TLS (VPC private subnets)")
Rel(APIGateway, RecommendationsContainer, "Routes recommendation requests", "gRPC over TLS (VPC private subnets)")
Rel(APIGateway, NotificationService, "Routes notification requests", "gRPC over TLS (VPC private subnets)")
Rel(OrderCheckoutContainer, ThirdPartyPaymentGateway, "Processes payments", "HTTPS (TLS)")
Rel(OrderCheckoutContainer, AsyncEventBus, "Publishes OrderPlaced events", "Publishes via TLS")
Rel(AsyncEventBus, ThirdPartyShippingProvider, "Sends fulfillment requests", "Webhooks / HTTPS APIs")
Rel(CatalogSearchContainer, AmazonAuroraPostgreSQLAmazonDynamoDB, "Reads and writes relational and inventory data", "SQL / NoSQL over TLS")
Rel(OrderCheckoutContainer, AmazonAuroraPostgreSQLAmazonDynamoDB, "Reads and writes order and cart data", "SQL / NoSQL over TLS")
Rel(RecommendationsContainer, AmazonAuroraPostgreSQLAmazonDynamoDB, "Reads and writes recommendation data", "SQL / NoSQL over TLS")
Rel(NotificationService, AmazonAuroraPostgreSQLAmazonDynamoDB, "Accesses database records", "SQL / NoSQL over TLS")

@enduml