@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Online Bookstore System

Person(Customer, "Customer", "End-user accessing the platform via web or mobile to browse, purchase, review books, and authenticate.")

System(Online_Bookstore_System, "Online Bookstore System", "A scaled-down Amazon-style e-commerce platform for purchasing physical and electronic books with integrated reviews and recommendations, operating globally with multi-currency support and GDPR/CCPA compliance.")

System_Ext(Third_Party_Payment_Gateway, "Third-Party Payment Gateway", "External system (Stripe/PayPal) for secure checkout and transaction processing.")
System_Ext(Third_Party_Shipping_Provider, "Third-Party Shipping Provider", "External system (FedEx/DHL) for order fulfillment and tracking.")
System_Ext(Identity_Provider___Auth_Service, "Identity Provider / Auth Service", "External system (Auth0/AWS Cognito) for authentication and identity management using OIDC/OAuth2.")
System_Ext(Currency_Exchange_Rate_Service, "Currency Exchange Rate Service", "External system providing live multi-currency conversion rates (USD, EUR, GBP).")

Rel(Customer, Online_Bookstore_System, "Browses, purchases, and leaves reviews", "HTTPS")
Rel(Customer, Online_Bookstore_System, "Authenticates using OIDC", "HTTPS / OIDC")
Rel(Online_Bookstore_System, Third_Party_Payment_Gateway, "Processes transactions", "HTTPS/REST")
Rel(Online_Bookstore_System, Third_Party_Shipping_Provider, "Requests fulfillment", "HTTPS/REST")
Rel(Online_Bookstore_System, Currency_Exchange_Rate_Service, "Fetches live rates", "HTTPS/REST")

@enduml