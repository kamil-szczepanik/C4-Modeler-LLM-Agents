@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Scoring Engine container

Container_Boundary(scoring_engine, "Scoring Engine") {
    Component(API_Router, "API Router", "Go", "Go service handling incoming gRPC requests.")
    Component(Feature_Aggregator, "Feature Aggregator", "Go", "Go concurrent routine orchestrator for feature store lookups and local caching.")
    Component(Model_Evaluator, "Model Evaluator", "Go / WebAssembly (WASM)", "Go execution engine processing compiled rules and lightweight machine learning models.")
    Component(In_Memory_Model_Registry, "In-Memory Model Registry", "Go / In-Memory", "Component managing zero-downtime hot-swapping of compiled WebAssembly models.")
    Component(Audit_Payload_Builder, "Audit Payload Builder", "Go", "Go component constructing tamper-evident decision records.")
    Component(Feature_Store, "Feature Store", "Amazon DynamoDB", "Amazon DynamoDB storing real-time user and card velocity vectors.")
    Component(Audit___Event_Bus, "Audit & Event Bus", "Amazon MSK (Apache Kafka)", "Amazon MSK (Apache Kafka) for asynchronous event publishing.")
}

Rel(API_Router, Feature_Aggregator, "Delegates feature retrieval", "Go internal function call")
Rel(Feature_Aggregator, Feature_Store, "Fetches velocity vectors", "DynamoDB API (<10ms)")
Rel(Model_Evaluator, In_Memory_Model_Registry, "Reads active scoring models", "In-memory pointer reference, zero-allocation")
Rel(Model_Evaluator, Audit_Payload_Builder, "Passes decision context", "Go internal channel")
Rel(Audit_Payload_Builder, Audit___Event_Bus, "Publishes tamper-evident payloads", "Kafka Protocol, asynchronous batching")
@enduml