@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit & Event Bus container

System_Ext(ScoringEngine, "Scoring Engine", "Amazon ECS Fargate with Go and in-memory model caching")
System_Ext(AuditArchivalWorker, "Audit Archival Worker", "AWS Lambda")
System_Ext(CaseManagementBackend, "Case Management Backend", "Amazon ECS Fargate with Node.js/Java")

Container_Boundary(AuditAndEventBus, "Audit & Event Bus") {
    Component(KafkaCluster, "Kafka Cluster", "Amazon MSK with KRaft", "Manages streaming event logs and publishes real-time decision events and review cases.")
    Component(EventProducer, "Event Producer", "Go / Kafka Producer Client", "Publishes scoring decision events from the Scoring Engine into the Kafka event bus.")
    Component(EventConsumerGroup, "Event Consumer Group", "Node.js / Java / AWS Lambda", "Consumes events from the MSK cluster to route review cases and trigger archival processing.")
}

Rel(ScoringEngine, KafkaCluster, "Publishes decision events", "TCP / Kafka Protocol")
Rel(KafkaCluster, AuditArchivalWorker, "Invokes archival processing", "AWS Internal Event Source Mapping")
Rel(KafkaCluster, CaseManagementBackend, "Broadcasts review cases", "TCP / Kafka Protocol")
@enduml