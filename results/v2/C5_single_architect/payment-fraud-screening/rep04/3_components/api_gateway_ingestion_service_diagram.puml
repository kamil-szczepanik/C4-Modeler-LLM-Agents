@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway / Ingestion Service container

System_Ext(PaymentGatewayCoreLedger, "Payment Gateway / Core Ledger", "External system sending authorization requests.")
System_Ext(ScoringEngine, "Scoring Engine", "External system for fraud evaluation.")
System_Ext(AuditEventBus, "Audit & Event Bus", "External system for audit and telemetry logs.")

Container_Boundary(ApiGatewayIngestionService, "API Gateway / Ingestion Service") {
    Component(RoutingRateLimitingFilter, "Routing & Rate Limiting Filter", "Go component", "Filters, routes, and applies rate limits to incoming requests.")
    Component(DataSanitizationTokenizationMaskingComponent, "Data Sanitization & Tokenization Masking Component", "Go component", "Sanitizes and tokenizes sensitive payload data for PCI-DSS compliance.")
    Component(InternalgRPCClientRouter, "Internal gRPC Client Router", "Go component", "Routes sanitized payloads to internal services via gRPC.")
    Component(AuditLoggerTelemetryInterceptor, "Audit Logger & Telemetry Interceptor", "Go component", "Emits telemetry and logs asynchronously to the audit and event bus.")
}

Rel(PaymentGatewayCoreLedger, RoutingRateLimitingFilter, "Sends authorization requests", "HTTPS/REST (TLS 1.3)")
Rel(RoutingRateLimitingFilter, DataSanitizationTokenizationMaskingComponent, "Hands off validated payloads", "In-memory function call")
Rel(DataSanitizationTokenizationMaskingComponent, InternalgRPCClientRouter, "Forwards sanitized payloads", "In-memory function call")
Rel(InternalgRPCClientRouter, ScoringEngine, "Forwards requests for fraud evaluation", "gRPC over mTLS")
Rel(AuditLoggerTelemetryInterceptor, AuditEventBus, "Emits telemetry and logs asynchronously", "Kafka Protocol")
@enduml