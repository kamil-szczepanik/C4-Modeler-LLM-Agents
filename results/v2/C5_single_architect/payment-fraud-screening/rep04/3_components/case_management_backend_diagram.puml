@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management Backend container

Container_Boundary(case_management_backend, "Case Management Backend") {
    Component(Case API Handler, "Case API Handler", "Go (chi router)", "Handles HTTP requests from Fraud Analysts reviewing flagged transactions and managing cases.")
    Component(Workflow Service, "Workflow Service", "Go", "Orchestrates the business logic and workflow state transitions for case management.")
    Component(Audit Publisher, "Audit Publisher", "Go", "Publishes case resolution audit trails to the audit and event infrastructure.")
}

System_Ext(Audit & Event Bus, "Audit & Event Bus", "External event infrastructure (Amazon MSK)")

Rel(Case API Handler, Workflow Service, "Delegates request processing and case actions")
Rel(Workflow Service, Audit Publisher, "Triggers audit event generation on case resolution")
Rel(Audit Publisher, Audit & Event Bus, "Publishes case resolution audit trails", "TCP / Kafka Protocol")

@enduml