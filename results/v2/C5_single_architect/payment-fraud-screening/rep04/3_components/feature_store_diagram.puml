@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(ScoringEngine, "Scoring Engine", "External system that evaluates payment authorizations for fraud.")

Container_Boundary(FeatureStore, "Feature Store") {
    Component(FeatureApiClientLibrary, "Feature API Client Library", "Embedded Go / AWS SDK", "Allows the Scoring Engine to query for real-time feature lookups.")
    Component(FeatureAggregatorWorker, "Feature Aggregator Worker", "AWS Lambda with Go", "Consumes transaction event streams and persists sliding-window aggregates.")
}

System_Ext(FeatureStoreDb, "Feature Store", "Amazon DynamoDB instance storing aggregates.")

Rel(ScoringEngine, FeatureApiClientLibrary, "Queries for real-time feature lookups via embedded client library", "AWS SDK / HTTPS")
Rel(FeatureAggregatorWorker, FeatureStoreDb, "Persists sliding-window aggregates", "AWS SDK / NoSQL API")

@enduml