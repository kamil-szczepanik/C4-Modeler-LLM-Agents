@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Transactional Data Store container

System_Ext(CaseManagementBackend, "Case Management Backend", "External system interacting with the data store.")
System_Ext(AuditArchivalStorage, "Audit Archival Storage", "External storage for audit logs.")
System_Ext(CICDPipeline, "CI/CD Pipeline", "External deployment pipeline.")

Container_Boundary(TransactionalDataStore, "Transactional Data Store") {
    Component(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Provides managed relational capabilities, high availability, native feature support, pgcrypto, and append-only tables for tamper-evident storage.")
    Component(RDSProxy, "RDS Proxy", "AWS RDS Proxy", "Provides managed connection pooling and resilience against traffic spikes.")
    Component(CaseRepositoryComponent, "Case Repository Component", "PostgreSQL Tables", "Manages reliable persistence and case management for fraud analyst workflows.")
    Component(AuditLedgerComponent, "Audit Ledger Component", "PostgreSQL Append-Only Tables & pgcrypto", "Provides secure, tamper-evident 7-year audit logging satisfying strict compliance.")
    Component(DatabaseMigrationComponent, "Database Migration Component", "Flyway", "Executes automated, zero-downtime database schema updates.")
}

Rel(CaseManagementBackend, RDSProxy, "Routes database traffic", "PostgreSQL Wire Protocol")
Rel(RDSProxy, CaseRepositoryComponent, "Forwards pooled queries", "PostgreSQL Wire Protocol")
Rel(RDSProxy, AuditLedgerComponent, "Forwards pooled queries", "PostgreSQL Wire Protocol")
Rel(AuditLedgerComponent, AuditArchivalStorage, "Streams append-only logs", "HTTPS")
Rel(CICDPipeline, DatabaseMigrationComponent, "Executes schema updates", "HTTPS")

@enduml