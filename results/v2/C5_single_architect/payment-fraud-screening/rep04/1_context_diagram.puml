@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Real-Time Payment Fraud Screening System

Person(FraudAnalyst, "Fraud Analyst", "Internal persona reviewing flagged transactions and suspicious payments using a secure Web UI.")

System_Ext(PaymentGatewayCoreLedger, "Payment Gateway / Core Ledger", "External system submitting tokenized payment authorizations.")
System_Ext(IdentityProviderIdP, "Identity Provider (IdP)", "Manages analyst authentication using OIDC/OAuth2.")
System_Ext(AuditArchivalStorage, "Audit Archival Storage", "External system for long-term compliance storage using AWS S3 with Object Lock for WORM storage.")

System(FraudScreeningSystem, "Fraud Screening System", "Evaluates card-not-present payment authorizations for fraud prior to approval and provides a case management interface for fraud analysts.")

Rel(PaymentGatewayCoreLedger, FraudScreeningSystem, "Sends payment authorizations and receives approval, decline, or review decisions", "Synchronous gRPC/REST over TLS 1.3")
Rel(FraudAnalyst, FraudScreeningSystem, "Reviews suspicious payments using a secure Web UI", "HTTPS")
Rel(FraudScreeningSystem, IdentityProviderIdP, "Authenticates analysts", "OIDC/OAuth2 / AWS Cognito / IAM")
Rel(FraudScreeningSystem, AuditArchivalStorage, "Exports decision inputs, model versions, and explanations asynchronously", "AWS S3 with Object Lock")

@enduml