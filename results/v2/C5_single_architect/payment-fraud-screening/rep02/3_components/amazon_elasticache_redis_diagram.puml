@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_elasticache_redis, "Amazon ElastiCache Redis") {
    Component(Feature_Store_Component, "Feature Store Component", "In-Memory Hash/Sorted Sets", "Reads/writes sliding-window aggregates and velocity metrics.")
    Component(Rule_Cache_Component, "Rule Cache Component", "In-Memory KV", "Reads active fraud rules and model thresholds.")
    Component(Session_State_Component, "Session State Component", "In-Memory KV", "Reads/writes analyst session states and workspace locks.")
}

Rel(Feature_Store_Component, Rule_Cache_Component, "Operates within the shared ElastiCache Redis cluster.")
@enduml