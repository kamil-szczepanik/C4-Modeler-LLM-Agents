@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_aurora_postgresql, "Amazon Aurora PostgreSQL") {
    Component(Database_Engine, "Database Engine", "Amazon Aurora PostgreSQL 15", "Manages ACID-compliant case data, transaction logs, and multi-AZ replication.")
    Component(PgBouncer_Connection_Pooler, "PgBouncer Connection Pooler", "PgBouncer", "Handles high concurrency, manages persistent connections, and prevents database connection exhaustion.")
}

Rel(PgBouncer_Connection_Pooler, Database_Engine, "Forwards pooled client queries and transactions", "PostgreSQL Wire Protocol")

@enduml