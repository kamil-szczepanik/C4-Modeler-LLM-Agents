@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon SQS / SNS container

Container_Boundary(amazon_sqs_sns, "Amazon SQS / SNS") {
    Component(Fraud_Event_Topic_Amazon_SNS, "Fraud Event Topic (Amazon SNS)", "Amazon SNS", "Publishes and fans out scoring outcomes to downstream queues.")
    Component(Review_Queue_Amazon_SQS_Standard, "Review Queue (Amazon SQS Standard)", "Amazon SQS Standard", "Buffers and filters review cases for human analysts.")
    Component(Audit_Event_Queue_Amazon_SQS_FIFO, "Audit Event Queue (Amazon SQS FIFO)", "Amazon SQS FIFO", "Guarantees strict ordering for asynchronous audit decision payloads.")
    Component(Audit_Dead_Letter_Queue_Amazon_SQS_FIFO, "Audit Dead-Letter Queue (Amazon SQS FIFO)", "Amazon SQS FIFO", "Captures failed audit log delivery messages for investigation.")
}

Rel(Fraud_Event_Topic_Amazon_SNS, Review_Queue_Amazon_SQS_Standard, "Filters and fans out review cases", "SNS Subscription")

@enduml