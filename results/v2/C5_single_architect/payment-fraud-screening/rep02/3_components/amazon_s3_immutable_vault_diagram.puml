@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_s3_immutable_vault, "Amazon S3 Immutable Vault") {
    Component(Vault_Ingestion_Interceptor, "Vault Ingestion Interceptor", "Go on AWS Lambda", "Submits immutable audit logs and case artifacts")
    Component(S3_Object_Lock_Manager, "S3 Object Lock Manager", "AWS S3 Configuration", "Stores objects with retention policies")
    Component(Audit_Verification_Worker, "Audit Verification Worker", "Python on AWS Lambda", "Reads and verifies payload hashes")
    Component(Access_Control_Enforcer, "Access Control Enforcer", "AWS IAM / S3 Bucket Policies", "Enforces strict least-privilege access control")
}

Rel(Vault_Ingestion_Interceptor, S3_Object_Lock_Manager, "Stores objects with retention policies", "S3 API")
Rel(Audit_Verification_Worker, S3_Object_Lock_Manager, "Reads and verifies payload hashes", "S3 API (Read-Only)")

@enduml