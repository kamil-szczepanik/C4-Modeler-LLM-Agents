@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway / Application Load Balancer") {
    Component(tls_termination, "TLS Termination Engine", "AWS ALB TLS Termination Engine", "Terminates incoming HTTPS connections using TLS 1.3 for payment authorizations and analyst commands.")
    Component(listener_rules, "Listener Rules", "AWS ALB Listener Rules", "Evaluates and routes incoming traffic to the Fraud Scoring Engine or Case Management Service.")
}

Rel(tls_termination, listener_rules, "Decrypts and forwards traffic", "")

@enduml