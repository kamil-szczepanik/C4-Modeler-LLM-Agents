@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Real-Time Payment Fraud Screening System

Person(FraudAnalyst, "Fraud Analyst", "Interacts with the system for case management and fraud analysis, authenticating securely via an Identity Provider.")

System(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System", "Screens card-not-present payment authorizations for a mid-size payment processor and provides case management for fraud analysts.")

System_Ext(PaymentGatewayCoreProcessingPlatform, "Payment Gateway / Core Processing Platform", "Sends payment authorization requests to be screened for fraud.")
System_Ext(IdentityProvideIdP, "Identity Provider (IdP)", "Authenticates fraud analysts via OIDC/SAML.")
System_Ext(AWSKeyManagementServiceKMSHSM, "AWS Key Management Service (KMS) / HSM", "Provides cryptographic signing and envelope encryption for tamper-evident audit logs.")

Rel(PaymentGatewayCoreProcessingPlatform, RealTimePaymentFraudScreeningSystem, "Sends authorization requests for fraud screening", "REST/gRPC over HTTPS with mTLS")
Rel(FraudAnalyst, RealTimePaymentFraudScreeningSystem, "Interacts with the system via Web UI for case management", "HTTPS")
Rel(FraudAnalyst, IdentityProvideIdP, "Authenticates against the identity provider", "OIDC/SAML")
Rel(RealTimePaymentFraudScreeningSystem, AWSKeyManagementServiceKMSHSM, "Connects for cryptographic signing and envelope encryption", "AWS PrivateLink and HTTPS")

@enduml