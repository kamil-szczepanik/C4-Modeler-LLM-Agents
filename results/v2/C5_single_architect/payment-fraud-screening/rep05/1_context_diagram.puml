@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalyst, "Fraud Analyst", "User reviewing suspicious transactions.")
System_Ext(PaymentGatewayAcquirer, "Payment Gateway / Acquirer", "External system sending authorization requests.")
System_Ext(CardNetworksFraudIntelligenceFeeds, "Card Networks & Fraud Intelligence Feeds", "External systems providing risk signals and blacklists.")
System_Ext(ArchivalComplianceStorage, "Archival / Compliance Storage", "External AWS S3 and KMS services for 7-year auditability.")

System(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System", "Screens card-not-present payment authorizations for a mid-size payment processor and provides case management for fraud analysts.")

Rel(PaymentGatewayAcquirer, RealTimePaymentFraudScreeningSystem, "Sends authorization requests for real-time scoring", "HTTPS / gRPC")
Rel(FraudAnalyst, RealTimePaymentFraudScreeningSystem, "Reviews suspicious transactions and performs case management", "HTTPS (TLS 1.3)")
Rel(RealTimePaymentFraudScreeningSystem, ArchivalComplianceStorage, "Stores WORM audit logs for 7-year auditability", "AWS SDK (TLS)")
Rel(RealTimePaymentFraudScreeningSystem, ArchivalComplianceStorage, "Handles card data tokenization and envelope encryption", "HTTPS")
@enduml