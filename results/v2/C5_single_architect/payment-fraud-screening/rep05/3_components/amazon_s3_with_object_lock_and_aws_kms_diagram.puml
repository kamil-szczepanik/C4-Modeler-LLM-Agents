@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(s3_kms_container, "Amazon S3 with Object Lock and AWS KMS") {
    Component(S3BucketComplianceAuditStore, "S3 Bucket (Compliance Audit Store)", "Amazon S3 with Object Lock", "Stores immutable audit logs with compliance mode ensuring 7-year tamper-evident retention.")
    Component(KeyManagementServiceAuditEncryptionKey, "Key Management Service (Audit Encryption Key)", "AWS KMS", "Provides envelope encryption keys to secure compliance audit payloads.")
    Component(S3LifecycleComponent, "S3 Lifecycle Component", "AWS S3 Lifecycle", "Transitions audit logs to Amazon S3 Glacier for cost-optimized long-term retention.")
    Component(BucketPolicyAccessController, "Bucket Policy & Access Controller", "AWS IAM & S3 Bucket Policies", "Enforces strict access controls and immutability rules on the compliance audit store.")
}

Rel(S3BucketComplianceAuditStore, KeyManagementServiceAuditEncryptionKey, "Encrypts/Decrypts payloads", "AWS internal API via AWS KMS VPC Endpoint")
Rel(S3LifecycleComponent, S3BucketComplianceAuditStore, "Transitions older audit logs to Glacier storage tier", "AWS internal API")
Rel(BucketPolicyAccessController, S3BucketComplianceAuditStore, "Applies security policies and prevents unauthorized modifications", "IAM Policy Engine")

@enduml