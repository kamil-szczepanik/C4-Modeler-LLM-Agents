@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(case_management_backend, "Case Management Backend") {
    Component(API_Router_Controller, "API Router / Controller", "Go / Rust", "Routes incoming API requests and handles controller logic.")
    Component(Masking_Sanitization_Middleware, "Masking & Sanitization Middleware", "Go / Rust", "Sanitizes incoming requests to maintain security and compliance.")
    Component(Case_Service, "Case Service", "Go / Rust", "Core business logic service for managing cases.")
    Component(Audit_Logger, "Audit Logger", "Go / Rust", "Emits audit events for strict compliance and tracking.")
    Component(Data_Repository, "Data Repository", "Go / Rust", "Handles data persistence interactions for case state.")
}

Rel(API_Router_Controller, Masking_Sanitization_Middleware, "Sanitizes incoming requests", "In-Process")
Rel(Masking_Sanitization_Middleware, Case_Service, "Forwards clean payload", "In-Process")
Rel(API_Router_Controller, Case_Service, "Method calls", "In-Process")
Rel(Case_Service, Data_Repository, "Reads/Writes case state", "SQL over TCP")
Rel(Case_Service, Audit_Logger, "Emits audit events", "In-Process")
@enduml