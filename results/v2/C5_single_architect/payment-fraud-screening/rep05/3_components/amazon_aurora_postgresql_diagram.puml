@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(CaseManagementBackend, "Case Management Backend", "External system accessing case data")
System_Ext(FraudScoringEngine, "Fraud Scoring Engine", "External system appending decision logs")

Container_Boundary(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL") {
    Component(CaseManagementSchema, "Case Management Schema", "PostgreSQL tables", "PostgreSQL tables storing analyst reviews and case states.")
    Component(AuditLogVault, "Audit Log Vault", "pg_audit and append-only tables", "pg_audit extension and append-only tables capturing immutable decision logs.")
    Component(RowLevelSecurityRLSEnforcer, "Row-Level Security (RLS) Enforcer", "PostgreSQL RLS policies", "PostgreSQL RLS policies enforcing PCI-DSS data segregation.")
    Component(DataMaskingTokenizationEngine, "Data Masking & Tokenization Engine", "PostgreSQL functions and pgcrypto", "PostgreSQL functions and pgcrypto dynamically masking primary account numbers (PANs).")
}

Rel(CaseManagementBackend, CaseManagementSchema, "Reads and writes case data", "SQL/TCP")
Rel(FraudScoringEngine, AuditLogVault, "Appends immutable decision logs", "SQL/TCP")
Rel(CaseManagementSchema, DataMaskingTokenizationEngine, "Sanitizes card data on read", "PL/pgSQL")

@enduml