@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Boundary(aws_nlb, "AWS Network Load Balancer") {
    Component(tcp_ingress_router, "TCP Ingress Router", "AWS NLB L4 Routing", "Routes high-throughput payment authorization requests at 3,000 TPS to backend services.")
}

System_Ext(fraud_scoring_engine, "Fraud Scoring Engine", "Routes high-throughput scoring requests via TCP")

Rel(tcp_ingress_router, fraud_scoring_engine, "Routes high-throughput scoring requests via TCP", "TCP")

@enduml