@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Redis container

System_Ext(fraud_scoring_engine, "Fraud Scoring Engine", "External component interacting with Redis")

Container_Boundary(redis, "Redis") {
    Component(redis_primary_node, "Redis Primary Node", "Amazon ElastiCache (Redis OSS)", "Amazon ElastiCache instance handling real-time feature writes, fast reads, and executing Lua scripts for atomic rate-limiting.")
    Component(redis_replica_node, "Redis Replica Node", "Amazon ElastiCache (Redis OSS)", "Amazon ElastiCache instance providing automatic failover through asynchronous replication.")
    Component(in_memory_feature_cache_store, "In-Memory Feature Cache Store", "Redis Hashes and Sorted Sets", "Stores sliding-window velocity metrics using tokenized identifiers.")
}

Rel(fraud_scoring_engine, redis_primary_node, "Fetches features and executes Lua scripts for atomic rate-limiting and feature retrieval", "RESP protocol [TCP]")
Rel(redis_primary_node, redis_replica_node, "Synchronizes state via asynchronous replication", "RESP protocol via TCP")

@enduml