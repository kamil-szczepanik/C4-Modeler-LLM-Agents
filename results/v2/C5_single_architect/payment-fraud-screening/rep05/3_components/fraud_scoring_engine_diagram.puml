@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(fraud_scoring_engine, "Fraud Scoring Engine") {
    Component(API_Handler_Component, "API Handler Component", "Go / Fiber", "Handles I/O-bound requests and ensures high-throughput request handling.")
    Component(Feature_Aggregator_Component, "Feature Aggregator Component", "Go", "Performs sub-millisecond feature lookup and coordinates with Redis.")
    Component(Scoring_Engine_Core, "Scoring Engine Core", "Rust", "Executes CPU-bound scoring to meet strict performance and memory safety constraints.")
    Component(Audit_Logger_Component, "Audit Logger Component", "Go", "Handles tamper-evident auditing and async logging.")
    Component(Rule_Model_Loader_Component, "Rule & Model Loader Component", "Rust", "Manages zero-downtime model updates and rule loading.")
    ComponentDb(Redis, "Redis", "Redis", "Provides low-latency storage for real-time feature lookups.")
    ComponentDb(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Stores persistent transactional and case management data.")
    Component(Amazon_S3_with_Object_Lock_and_AWS_KMS, "Amazon S3 with Object Lock and AWS KMS", "Amazon S3, AWS KMS", "Ensures tamper-evident, 7-year compliant audit storage.")
}

Rel(API_Handler_Component, Feature_Aggregator_Component, "In-process Function Call")
Rel(Feature_Aggregator_Component, Scoring_Engine_Core, "In-process Function Call")
Rel(Scoring_Engine_Core, Audit_Logger_Component, "Channel / Async Queue")
Rel(Rule_Model_Loader_Component, Scoring_Engine_Core, "In-process Shared Memory / Atomic Swap")
Rel(Feature_Aggregator_Component, Redis, "TCP")
Rel(Scoring_Engine_Core, Amazon_Aurora_PostgreSQL, "TCP")
Rel(Audit_Logger_Component, Amazon_S3_with_Object_Lock_and_AWS_KMS, "AWS SDK")

@enduml