@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Real-Time Payment Fraud Screening System

Person(Fraud_Analysts, "Fraud Analysts", "Internal actors reviewing suspicious transactions and case management.")
Person(Regulatory_Compliance_Auditors, "Regulatory / Compliance Auditors", "External actors verifying tamper-evident audit logs.")
System_Ext(Payment_Gateway___Acquirer_Systems, "Payment Gateway / Acquirer Systems", "External actor submitting card-not-present payment authorizations.")

System_Boundary(Real_Time_Payment_Fraud_Screening_System, "Real-Time Payment Fraud Screening System") {
    Container(AWS_API_Gateway, "AWS API Gateway", "AWS API Gateway (REST)", "Entry point for authorization requests and client traffic.")
    Container(Scoring_Engine, "Scoring Engine", "Go, AWS ECS Fargate", "Microservice providing real-time sub-50ms P99 latency fraud scoring.")
    Container(Case_Management_Backend, "Case Management Backend", "Node.js/Go, AWS ECS Fargate", "Handles analyst case reviews and management workflows.")
    ContainerDb(Amazon_DynamoDB, "Amazon DynamoDB", "Amazon DynamoDB", "Provides low-latency rule/model state and data storage.")
    ContainerDb(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Relational data store for structured application data.")
    Container(Amazon_Kinesis_Data_Firehose, "Amazon Kinesis Data Firehose", "Amazon Kinesis Data Firehose", "Streams audit logs from the scoring engine.")
    ContainerDb(Amazon_S3_Object_Lock, "Amazon S3 Object Lock", "Amazon S3 with Object Lock", "Tamper-evident storage for 7-year immutable audit log retention.")
}

Rel(Payment_Gateway___Acquirer_Systems, AWS_API_Gateway, "Submits authorization requests", "HTTPS/JSON")
Rel(Fraud_Analysts, Case_Management_Backend, "Performs case reviews", "HTTPS")
Rel(AWS_API_Gateway, Scoring_Engine, "Routes authorization requests for scoring", "Internal HTTP/REST")
Rel(Scoring_Engine, Amazon_DynamoDB, "Reads and writes rule/model state", "AWS SDK")
Rel(Scoring_Engine, Amazon_Kinesis_Data_Firehose, "Sends audit logs", "HTTPS")
Rel(Amazon_Kinesis_Data_Firehose, Amazon_S3_Object_Lock, "Persists immutable audit logs", "AWS S3 API")
Rel(Case_Management_Backend, Amazon_Aurora_PostgreSQL, "Reads and writes case data", "SQL / AWS SDK")

@enduml