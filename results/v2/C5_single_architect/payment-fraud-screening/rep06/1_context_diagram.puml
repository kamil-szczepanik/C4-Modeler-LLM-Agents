@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalysts, "Fraud Analysts", "Internal actors reviewing suspicious transactions.")
Person(RegulatoryComplianceAuditors, "Regulatory / Compliance Auditors", "External actors verifying 7-year audit logs.")
System_Ext(PaymentGatewayAcquirerSystems, "Payment Gateway / Acquirer Systems", "External actor submitting payment authorizations.")
System_Ext(IdentityPoviderIdP, "Identity Provider (IdP)", "External system managing authentication and RBAC.")
System_Ext(ExternalTokenizationVaultService, "External Tokenization/Vault Service", "External system handling card data.")

System(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System", "Evaluates card-not-present payment authorizations for fraud prior to approval and provides a case management workflow for fraud analysts.")

Rel(PaymentGatewayAcquirerSystems, RealTimePaymentFraudScreeningSystem, "Submits authorizations", "gRPC/REST over TLS")
Rel(FraudAnalysts, RealTimePaymentFraudScreeningSystem, "Reviews payments", "HTTPS")
Rel(RegulatoryComplianceAuditors, RealTimePaymentFraudScreeningSystem, "Accesses audit records", "secure export/audit portal")
Rel(RealTimePaymentFraudScreeningSystem, IdentityPoviderIdP, "Authenticates users", "OAuth2/OIDC over HTTPS")
Rel(RealTimePaymentFraudScreeningSystem, ExternalTokenizationVaultService, "Resolves payment tokens", "gRPC/mTLS")

@enduml