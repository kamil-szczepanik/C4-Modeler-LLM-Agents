@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalysts, "Fraud Analysts", "External users reviewing suspicious payments.")

Container_Boundary(CaseManagementBackend, "Case Management Backend") {
    Component(CaseAPIHandler, "Case API Handler", "Node.js/Express", "Manages incoming analyst HTTP requests.")
    Component(CaseWorkflowEngine, "Case Workflow Engine", "Go", "Executes state transitions and business logic.")
    Component(DataAccessRepository, "Data Access Repository", "Go", "Enforces data masking and queries the database.")
    Component(AuditLoggerComponent, "Audit Logger Component", "Go", "Generates and exports tamper-evident compliance trails.")
}

System_Ext(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL", "Stores case data.")
System_Ext(AmazonS3ObjectLock, "Amazon S3 Object Lock", "Stores immutable audit logs.")

Rel(FraudAnalysts, CaseAPIHandler, "Manages cases", "HTTPS/REST")
Rel(CaseAPIHandler, CaseWorkflowEngine, "Invokes business logic", "Internal Function Call / gRPC")
Rel(CaseWorkflowEngine, DataAccessRepository, "Persists case state", "In-memory / Go interfaces")
Rel(DataAccessRepository, AmazonAuroraPostgreSQL, "Reads/writes masked case data", "SQL/TCP")
Rel(CaseWorkflowEngine, AuditLoggerComponent, "Dispatches audit events", "Internal Async / Channel")
Rel(AuditLoggerComponent, AmazonS3ObjectLock, "Persists tamper-evident audit logs", "AWS SDK / HTTPS")
@enduml