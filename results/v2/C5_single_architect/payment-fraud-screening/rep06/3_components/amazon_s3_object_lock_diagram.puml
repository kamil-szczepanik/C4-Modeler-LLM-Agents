@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(Amazon_S3_Object_Lock, "Amazon S3 Object Lock") {
    Component(S3_Bucket_with_Object_Lock, "S3 Bucket with Object Lock", "AWS S3 Bucket with Object Lock (Compliance Mode)", "Stores immutable audit logs enforcing 7-year retention.")
    Component(Bucket_Lifecycle_Policy_Manager, "Bucket Lifecycle Policy Manager", "AWS S3 Lifecycle", "Manages object lifecycle and retention policies.")
    Component(AWS_KMS_Encryption_Key, "AWS KMS Encryption Key", "AWS KMS", "Provides encryption and decryption for audit objects.")
}

Rel(S3_Bucket_with_Object_Lock, AWS_KMS_Encryption_Key, "Encrypts and decrypts audit objects", "AWS KMS API")
Rel(Bucket_Lifecycle_Policy_Manager, S3_Bucket_with_Object_Lock, "Applies retention and lifecycle rules", "AWS S3 Lifecycle")
@enduml