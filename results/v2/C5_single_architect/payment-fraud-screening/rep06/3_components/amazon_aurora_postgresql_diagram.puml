@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container(scoring_engine, "Scoring Engine", "Go, AWS ECS Fargate", "Executes real-time fraud checks.")
Container(case_management_backend, "Case Management Backend", "Node.js/Go, AWS ECS Fargate", "Manages fraud analyst workflows and cases.")

Container_Boundary(amazon_aurora_postgresql, "Amazon Aurora PostgreSQL") {
    Component(Case_Management_Schema, "Case Management Schema", "PostgreSQL, Row-Level Security", "Stores case data for fraud analysts.")
    Component(Audit_Log_Tamper_Evident_Ledger, "Audit Log & Tamper-Evident Ledger", "PostgreSQL, pgaudit", "Appends immutable compliance logs for auditability.")
    Component(Model_Registry_Schema, "Model Registry Schema", "PostgreSQL", "Stores active rule and model metadata.")
}

Rel(scoring_engine, Model_Registry_Schema, "Polls active rule and model metadata", "TCP / PostgreSQL Wire Protocol")
Rel(case_management_backend, Case_Management_Schema, "Reads and writes case data", "TCP / PostgreSQL Wire Protocol")
Rel(case_management_backend, Audit_Log_Tamper_Evident_Ledger, "Appends immutable compliance logs", "TCP / PostgreSQL Wire Protocol")

@enduml