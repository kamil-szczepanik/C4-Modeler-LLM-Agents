@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS API Gateway container

Container_Boundary(aws_api_gateway, "AWS API Gateway") {
    Component(RequestValidator, "Request Validator", "AWS API Gateway native Request Validator", "Validates incoming JSON schema for payment authorization requests.")
    Component(Authorizer, "Authorizer", "AWS API Gateway Authorizer (mTLS)", "Handles mTLS authorization for external payment gateway and acquirer systems.")
    Component(HttpProxyIntegration, "HTTP Proxy Integration", "VPC Link / HTTP Proxy", "Routes validated requests to the Scoring Engine over internal VPC Links.")
}

Rel(RequestValidator, Authorizer, "Validates request payloads after authorization", "")
Rel(Authorizer, HttpProxyIntegration, "Passes authenticated requests for routing", "")

@enduml