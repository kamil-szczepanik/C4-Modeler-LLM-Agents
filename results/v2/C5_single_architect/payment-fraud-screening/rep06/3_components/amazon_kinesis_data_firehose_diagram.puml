@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Boundary(amazon_kinesis_data_firehose, "Amazon Kinesis Data Firehose") {
    Component(Firehose_Buffer_Manager, "Firehose Buffer Manager", "Amazon Kinesis Data Firehose Native", "Batches incoming audit logs before sending them for transformation.")
    Component(Firehose_Data_Transformer, "Firehose Data Transformer", "AWS Lambda", "Sanitizes audit logs natively before persistence.")
    Component(S3_Delivery_Stream_Writer, "S3 Delivery Stream Writer", "Amazon Kinesis Data Firehose Native", "Writes immutable log batches to storage.")
}

System_Ext(Amazon_S3_Object_Lock, "Amazon S3 Object Lock", "Enforces WORM storage for auditability")

Rel(Firehose_Buffer_Manager, Firehose_Data_Transformer, "Invokes record transformation", "AWS Lambda API")
Rel(S3_Delivery_Stream_Writer, Amazon_S3_Object_Lock, "Writes immutable log batches with SSE-KMS", "AWS S3 API")
@enduml