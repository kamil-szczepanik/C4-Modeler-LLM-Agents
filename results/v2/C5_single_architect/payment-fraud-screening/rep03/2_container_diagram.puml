@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Real-Time Payment Fraud Screening

Person(FraudAnalysts, "Fraud Analysts", "Internal users accessing the case management interface to review suspicious transactions.")
System_Ext(PaymentGatewayExternalSystems, "Payment Gateway / External Systems", "Inbound traffic source and core processing systems sending payment authorizations.")

System_Boundary(RealTimePaymentFraudScreening, "Real-Time Payment Fraud Screening") {
    Container(APIGateway, "API Gateway", "AWS API Gateway (REST/HTTP)", "Handles inbound traffic from the payment gateway.")
    Container(ScoringEngine, "Scoring Engine", "Go, AWS ECS Fargate, Embedded Model Runtime", "Microservice that screens payment authorizations in real-time to detect fraud.")
    Container(CaseManagementAPI, "Case Management API", "Node.js / Python, AWS ECS Fargate", "Service powering fraud analyst workflows and case management.")
    ContainerDb(DataStore, "Data Store", "Amazon Aurora PostgreSQL", "Stores transactional data and tamper-evident audit logs.")
    Container(EventStream, "Event Stream", "Amazon SQS", "Decouples events asynchronously off the critical path.")
}

Rel(PaymentGatewayExternalSystems, APIGateway, "Sends payment authorizations", "HTTPS/REST")
Rel(APIGateway, ScoringEngine, "Routes authorization requests for fraud scoring", "gRPC")
Rel(ScoringEngine, DataStore, "Reads and writes transactional data and logs", "TCP")
Rel(ScoringEngine, EventStream, "Publishes asynchronous events", "AWS SDK/HTTPS")
Rel(FraudAnalysts, CaseManagementAPI, "Accesses case management workflows", "HTTPS")

@enduml