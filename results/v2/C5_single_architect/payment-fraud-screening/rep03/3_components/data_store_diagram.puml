@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(data_store, "Data Store") {
    Component(TransactionalDatabase, "Transactional Database", "Amazon Aurora PostgreSQL", "Stores core transactional data for payment authorizations and review cases.")
    Component(AuditLedger, "Audit Ledger", "Amazon Aurora PostgreSQL", "Maintains cryptographic hash-chaining to satisfy 7-year tamper-evident auditability requirements.")
    Component(ModelandFeatureStoreSchema, "Model and Feature Store Schema", "Amazon Aurora PostgreSQL", "Houses feature store schemas and model metadata for real-time fraud scoring.")
    Component(ConnectionPooler, "Connection Pooler", "PgBouncer / Aurora Proxy", "Prevents connection exhaustion under 3,000 TPS load by managing database connections.")
}

Rel(ScoringEngine, ConnectionPooler, "Writes decisions and audit logs", "TCP (PostgreSQL Wire Protocol)")
Rel(CaseManagementAPI, ConnectionPooler, "Manages review cases", "TCP (PostgreSQL Wire Protocol)")
Rel(ConnectionPooler, TransactionalDatabase, "Routes queries and transactions", "")
Rel(ConnectionPooler, AuditLedger, "Routes audit logs and hash-chaining updates", "")
Rel(ConnectionPooler, ModelandFeatureStoreSchema, "Routes feature store queries and model data lookups", "")

@enduml