@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(event_stream, "Event Stream") {
    Component(AmazonKinesisDataStreams, "Amazon Kinesis Data Streams", "AWS Kinesis", "Ingests and distributes real-time asynchronous decision events from the Scoring Engine.")
    Component(AmazonKinesisDataFirehose, "Amazon Kinesis Data Firehose", "AWS Kinesis Data Firehose", "Batches and streams decision data from the data stream into long-term storage.")
}

Rel(AmazonKinesisDataStreams, AmazonKinesisDataFirehose, "Streams decision events for batch processing and archiving", "AWS Internal HTTPS")

@enduml