@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Scoring Engine container

Component_Ext(api_gateway, "API Gateway", "AWS API Gateway", "Routes authorization requests via gRPC to the API Handler.")

Container_Boundary(scoring_engine, "Scoring Engine") {
    Component(api_handler, "API Handler", "Go", "Manages inbound gRPC requests from the API Gateway.")
    Component(token_sanitizer, "Token Sanitizer", "Go", "Redacts and tokenizes raw Primary Account Numbers (PAN).")
    Component(rule_engine, "Rule Engine", "Go", "Evaluates deterministic business rules in-memory.")
    Component(model_runner, "Model Runner", "Go, ONNX Runtime", "Executes compiled machine learning models locally.")
    Component(audit_logger, "Audit Logger", "Go", "Asynchronously generates and persists tamper-evident decision logs.")
    Component(data_store, "Data Store", "Amazon Aurora PostgreSQL", "Stores transactional data and audit logs.")
}

Rel(api_gateway, api_handler, "Routes authorization requests", "gRPC")
Rel(api_handler, token_sanitizer, "Passes raw requests", "synchronous in-process calls")
Rel(token_sanitizer, rule_engine, "Forwards sanitized feature vectors", "synchronous in-process calls")
Rel(token_sanitizer, model_runner, "Forwards sanitized feature vectors", "synchronous in-process calls")
Rel(rule_engine, audit_logger, "Dispatches event data", "Go channels")
Rel(model_runner, audit_logger, "Dispatches event data", "Go channels")
Rel(audit_logger, data_store, "Writes audit logs", "TCP")

@enduml