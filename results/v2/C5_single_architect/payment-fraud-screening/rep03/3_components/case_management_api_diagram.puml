@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalysts, "Fraud Analysts", "External users reviewing suspicious payment cases via web UI.")

Container_Boundary(CaseManagementAPI, "Case Management API") {
    Component(CaseController, "Case Controller", "Node.js / Express / TypeScript", "Node.js/Express service exposing REST endpoints for analyst workflows.")
    Component(AuditEvidenceService, "Audit & Evidence Service", "TypeScript / Node.js", "Component capturing analyst decisions with cryptographically verifiable hashes.")
    Component(CaseRepository, "Case Repository", "Prisma / Amazon Aurora PostgreSQL", "Data access layer interacting with Amazon Aurora PostgreSQL.")
    Component(MaskingTokenizationProxy, "Masking & Tokenization Proxy", "Axios Interceptors", "Interceptor middleware ensuring card numbers are redacted.")
}

Rel(FraudAnalysts, CaseController, "HTTPS/JSON")
Rel(CaseController, AuditEvidenceService, "In-process Function Call")
Rel(CaseController, CaseRepository, "TCP/PostgreSQL Protocol")
Rel(CaseRepository, MaskingTokenizationProxy, "In-process Middleware")
@enduml