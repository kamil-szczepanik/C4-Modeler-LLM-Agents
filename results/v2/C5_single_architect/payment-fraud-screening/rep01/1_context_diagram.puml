@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(PaymentAnalysts, "Payment Analysts", "Users performing manual case reviews and accessing case management via Web UI.")
Person(ComplianceAuditors, "Compliance Auditors", "Users accessing 7-year audit logs for regulatory compliance.")

System_Ext(PaymentGatewayAcquirer, "Payment Gateway / Acquirer", "External system sending authorization requests.")
System_Ext(CardNetworksIssuers, "Card Networks / Issuers", "External systems providing chargeback feedback.")
System_Ext(TokenizationVaultProvider, "Tokenization / Vault Provider", "External service handling cardholder data and token resolution.")

System(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System", "Evaluates card-not-present payment authorizations, provides case management for fraud analysts, and ensures PCI-DSS compliance, <50ms P99 latency at 3,000 TPS, and tamper-evident 7-year auditability on AWS eu-west-1.")

Rel(PaymentGatewayAcquirer, RealTimePaymentFraudScreeningSystem, "Sends real-time authorization requests for scoring", "gRPC over HTTP/2")
Rel(RealTimePaymentFraudScreeningSystem, TokenizationVaultProvider, "Resolves tokens for secure card data processing", "HTTPS with mutual TLS")
Rel(PaymentAnalysts, RealTimePaymentFraudScreeningSystem, "Performs case management and reviews via Web UI", "HTTPS (TLS 1.3)")
Rel(CardNetworksIssuers, RealTimePaymentFraudScreeningSystem, "Sends asynchronous chargeback ingestion", "HTTPS")

@enduml