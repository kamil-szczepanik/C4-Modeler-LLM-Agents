@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalystUI, "Fraud Analyst UI", "Fraud Analyst UI")
System_Ext(AWSSQS, "AWS SQS", "AWS SQS")
System_Ext(AuditDecisionStore, "Audit & Decision Store", "Audit & Decision Store")

Container_Boundary(CaseManagementBackend, "Case Management Backend") {
    Component(CaseAPIController, "Case API Controller", "Spring Boot", "Exposes REST endpoints for the Fraud Analyst UI.")
    Component(WorkflowOrchestrator, "Workflow Orchestrator", "Java", "Manages state transitions for open, under review, escalated, and resolved cases.")
    Component(AuditLoggerComponent, "Audit Logger Component", "Java", "Records analyst actions and case mutations durably.")
    Component(QueueConsumerService, "Queue Consumer Service", "Java / AWS SDK", "Consumes flagged cases from message queues.")
    Component(TokenizationFilterRedactionComponent, "Tokenization Filter / Redaction Component", "Java", "Scrubs and masks sensitive cardholder data.")
}

Rel(FraudAnalystUI, CaseAPIController, "Communicates via HTTPS/REST.", "HTTPS/REST")
Rel(QueueConsumerService, WorkflowOrchestrator, "Triggers new cases via In-Memory Java Method Calls.", "In-Memory")
Rel(WorkflowOrchestrator, TokenizationFilterRedactionComponent, "Passes payloads via In-Memory calls.", "In-Memory")
Rel(TokenizationFilterRedactionComponent, AuditDecisionStore, "Persists sanitized data via PostgreSQL protocol.", "PostgreSQL")
Rel(QueueConsumerService, AWSSQS, "Ingests queue messages using AWS SDK.", "AWS SDK")

@enduml