@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway / Ingestion Service", "Go-based container handling initial requests.")
System_Ext(fraud_engine, "Fraud Scoring Engine", "Rust-based container providing low-latency fraud decisions.")
System_Ext(audit_store, "Audit & Decision Store (PostgreSQL)", "PostgreSQL on AWS RDS for persistent, tamper-evident logs.")
System_Ext(case_backend, "Case Management Backend", "Node.js/Java container managing analyst workflows.")

Container_Boundary(aws_sqs_sns, "AWS SQS / SNS") {
    Component(amazon_sns_audit_topic, "Amazon SNS Audit Topic", "AWS SNS", "Publishes raw events asynchronously for auditing and notification.")
    Component(amazon_sqs_case_routing_queue, "Amazon SQS Case Routing Queue", "AWS SQS", "Queues review-required cases for downstream processing with SSE-KMS.")
    Component(dead_letter_queues_dlq, "Dead-Letter Queues (DLQ)", "AWS SQS", "Captures failed messages for error handling and analysis.")
}

Rel(api_gateway, amazon_sns_audit_topic, "Publishes raw events asynchronously", "AWS SDK (HTTPS/TLS 1.3)")
Rel(amazon_sns_audit_topic, audit_store, "Persists immutable audit logs", "AWS Lambda (HTTPS)")
Rel(fraud_engine, amazon_sqs_case_routing_queue, "Pushes review-required cases", "AWS SDK (SQS SendMessage) with SSE-KMS")
Rel(amazon_sqs_case_routing_queue, case_backend, "Consumes messages", "AWS SDK (SQS Long Polling)")
@enduml