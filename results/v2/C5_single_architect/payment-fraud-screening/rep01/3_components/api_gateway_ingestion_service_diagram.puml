@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("api_gateway_ingestion_service", "API Gateway / Ingestion Service") {
    Component("HTTP_gRPC_Router_Component", "HTTP/gRPC Router Component", "Go", "Forwards raw payload internally.")
    Component("Tokenization_Proxy_Component", "Tokenization Proxy Component", "Go", "Strips PANs and tokenizes card data.")
    Component("Scoring_Orchestrator_Component", "Scoring Orchestrator Component", "Go", "Invokes fraud scoring with a 35ms timeout.")
    Component("Event_Publisher_Component", "Event Publisher Component", "Go, AWS SDK", "Publishes transaction and decision payloads.")
}

System_Ext("Tokenization___Vault_Provider", "Tokenization / Vault Provider", "External tokenization and vault provider.")
System_Ext("Fraud_Scoring_Engine", "Fraud Scoring Engine", "External fraud scoring engine.")
System_Ext("AWS_SQS___SNS", "AWS SQS / SNS", "AWS messaging services.")
System_Ext("Audit___Decision_Store", "Audit & Decision Store", "PostgreSQL on AWS RDS.")

Rel(HTTP_gRPC_Router_Component, Tokenization_Proxy_Component, "Forwards raw payload", "Internal Memory")
Rel(Tokenization_Proxy_Component, Tokenization___Vault_Provider, "Strips PANs and tokenizes card data", "mTLS / HTTPS")
Rel(Scoring_Orchestrator_Component, Fraud_Scoring_Engine, "Invokes fraud scoring with 35ms timeout", "gRPC")
Rel(Event_Publisher_Component, AWS_SQS___SNS, "Publishes transaction and decision payloads", "AWS SDK batching over HTTPS")
Rel(api_gateway_ingestion_service, Audit___Decision_Store, "Persists decisions", "PostgreSQL protocol")

@enduml