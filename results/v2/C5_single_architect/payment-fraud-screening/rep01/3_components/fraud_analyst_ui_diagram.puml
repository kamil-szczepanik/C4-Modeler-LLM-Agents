@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Fraud Analyst UI container

System_Ext(CaseManagementBackend, "Case Management Backend", "Node.js / Java backend handling case management, scoring, and persistence.")

Container_Boundary(FraudAnalystUI, "Fraud Analyst UI") {
    Component(TokenizationMaskingComponent, "Tokenization Masking Component", "[e.g., JavaScript / React]", "Masks sensitive cardholder data to satisfy PCI-DSS Level 1 compliance.")
    Component(WebSocketClientComponent, "WebSocket Client Component", "WSS / HTTPS", "Streams real-time alert notifications from the Case Management Backend.")
    Component(CaseQueueRouterComponent, "Case Queue Router Component", "React Router", "Handles routing and navigation for payment analyst case reviews.")
    Component(DecisionActionFormComponent, "Decision Action Form Component", "React SPA", "Allows payment analysts to submit case actions and decisions.")
    Component(RuleManagementPanelComponent, "Rule Management Panel Component", "React SPA", "Provides an interface for updating and managing fraud detection rules.")
}

Rel(TokenizationMaskingComponent, CaseManagementBackend, "Sends securely masked data", "HTTPS/REST")
Rel(WebSocketClientComponent, CaseManagementBackend, "Receives real-time alert notifications", "WSS / HTTPS")
Rel(DecisionActionFormComponent, CaseManagementBackend, "Submits case actions and fetches queues", "HTTPS/REST")
Rel(RuleManagementPanelComponent, CaseManagementBackend, "Updates rules", "HTTPS/REST")

@enduml