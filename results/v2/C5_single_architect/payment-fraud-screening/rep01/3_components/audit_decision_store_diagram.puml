@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit & Decision Store container

System_Ext(FraudScoringEngine, "Fraud Scoring Engine", "External System / Container", "Reads and writes decision logs.")
System_Ext(CaseManagementBackend, "Case Management Backend", "External System / Container", "Accesses decision and audit records.")
System_Ext(AmazonS3Glacier, "Amazon S3 Glacier", "AWS S3 Glacier", "Minimizes long-term storage costs for cold data archives.")

Container_Boundary(AuditDecisionStore, "Audit & Decision Store") {
    Component(DataAccessLayer, "Data Access Layer", "Go / pgx", "Handles database interactions and provides access for reading and writing decision logs.")
    Component(AuditCryptographicService, "Audit & Cryptographic Service", "Go", "Ensures tamper-evidence using application-level HMAC and Merkle-tree chaining.")
    Component(RetentionArchivalWorker, "Retention & Archival Worker", "Go / AWS Lambda", "Archives cold partitions to meet the 7-year retention policy.")
    Component(PartitionManager, "Partition Manager", "Go", "Manages database partitions for performance and data lifecycle management.")
    ComponentDb(AmazonRDSPostgreSQL, "Amazon RDS PostgreSQL", "Amazon RDS PostgreSQL", "Provides reliable ACID compliance and standard relational storage.")
}

Rel(FraudScoringEngine, DataAccessLayer, "Reads and writes decision logs", "PostgreSQL protocol")
Rel(CaseManagementBackend, DataAccessLayer, "Accesses decision and audit records", "PostgreSQL protocol")
Rel(AuditCryptographicService, PartitionManager, "Writes chained audit records to active partitions", "Internal Go Interface")
Rel(RetentionArchivalWorker, AmazonS3Glacier, "Archives cold partitions", "AWS SDK / HTTPS")
@enduml