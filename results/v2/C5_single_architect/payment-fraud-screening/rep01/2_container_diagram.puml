@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Real-Time Payment Fraud Screening System

Person(Payment_Analysts, "Payment Analysts", "Users reviewing suspicious transactions via the UI.")
System_Ext(Payment_Gateway___Acquirer, "Payment Gateway / Acquirer", "External system submitting authorization requests.")
System_Ext(Tokenization___Vault_Provider, "Tokenization / Vault Provider", "External system handling secure card data storage and tokenization.")

System_Boundary(Real_Time_Payment_Fraud_Screening_System, "Real-Time Payment Fraud Screening System") {
    Container(API_Gateway___Ingestion_Service, "API Gateway / Ingestion Service", "Go", "Container handling incoming requests via HTTPS/gRPC.")
    Container(Fraud_Scoring_Engine, "Fraud Scoring Engine", "Rust", "Container executing fraud rules and models.")
    Container(Case_Management_Backend, "Case Management Backend", "Node.js / Java", "Container managing analyst review workflows.")
    Container(Fraud_Analyst_UI, "Fraud Analyst UI", "React, AWS S3 + CloudFront", "Single Page Application hosted on AWS S3 + CloudFront for fraud analysts.")
    ContainerDb(Audit___Decision_Store, "Audit & Decision Store", "PostgreSQL on AWS RDS", "Provides tamper-evident storage for audit and decision logs.")
    Container(AWS_SQS___SNS, "AWS SQS / SNS", "AWS Serverless Messaging", "Serverless messaging service for asynchronous audit logging and case routing.")
}

Rel(Payment_Gateway___Acquirer, API_Gateway___Ingestion_Service, "Sends authorization requests", "HTTPS/gRPC")
Rel(API_Gateway___Ingestion_Service, Fraud_Scoring_Engine, "Invokes fraud scoring", "internal gRPC/REST")
Rel(API_Gateway___Ingestion_Service, AWS_SQS___SNS, "Publishes events", "AWS SDK")
Rel(Fraud_Scoring_Engine, Audit___Decision_Store, "Reads and writes tamper-evident decision logs", "PostgreSQL protocol")
Rel(Fraud_Analyst_UI, Case_Management_Backend, "Communicates with backend services", "HTTPS/REST")
Rel(Case_Management_Backend, Audit___Decision_Store, "Interacts with database", "PostgreSQL protocol")
Rel(Case_Management_Backend, AWS_SQS___SNS, "Consumes queue messages", "AWS SDK")
Rel(Payment_Analysts, Fraud_Analyst_UI, "Reviews suspicious transactions", "HTTPS")
@enduml