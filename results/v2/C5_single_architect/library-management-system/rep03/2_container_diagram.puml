@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(LibraryPatron, "Library Patron", "End-user accessing self-service portals.")
Person(LibraryStaff, "Library Staff", "Administrators managing inventory and desk operations.")

System_Ext(ExternalPaymentGateway, "External Payment Gateway", "Third-party service for fines and fee transactions.")
System_Ext(DigitalContentProvider, "Digital Content Provider", "External APIs for digital catalog items.")
System_Ext(NotificationService, "Notification Service", "Third-party or enterprise email/SMS provider for alerts.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(WebApplication, "Web Application", "React, TypeScript", "Powers the frontend Single-Page Application for responsive user interactions.")
    Container(APIGateway, "API Gateway", "Spring Cloud Gateway / Envoy", "Routes and manages incoming requests to internal microservices.")
    Container(CatalogueService, "Catalogue Service", "Java, Spring Boot", "Manages library items and catalog data.")
    Container(CirculationService, "Circulation Service", "Java, Spring Boot", "Manages item borrowing, returns, and payment integrations.")
    Container(DigitalContentProxyService, "Digital Content Proxy Service", "Java, Spring Boot", "Proxies requests to external digital content providers.")
    Container(NotificationWorker, "Notification Worker", "Node.js", "Processes asynchronous message queues for notifications.")
    ContainerDb(PostgreSQL, "PostgreSQL", "PostgreSQL", "Provides primary relational data persistence restricted to an EU region for compliance.")
    ContainerDb(Redis, "Redis", "Redis", "Caches frequent reads and user sessions to optimize performance.")
    ContainerDb(Elasticsearch, "Elasticsearch", "Elasticsearch", "Delivers high-speed search capabilities meeting the <800ms P99 performance requirement.")
    ContainerDb(RabbitMQ, "RabbitMQ", "RabbitMQ", "Manages asynchronous message queuing for notifications.")
}

Rel(LibraryPatron, WebApplication, "Accesses self-service portal", "HTTPS")
Rel(LibraryStaff, WebApplication, "Manages system via UI", "HTTPS")
Rel(WebApplication, APIGateway, "Sends API requests", "HTTPS/JSON")
Rel(APIGateway, CatalogueService, "Routes catalog requests", "gRPC over TLS")
Rel(APIGateway, CirculationService, "Routes circulation requests", "gRPC over TLS")
Rel(APIGateway, DigitalContentProxyService, "Routes digital content requests", "gRPC over TLS")
Rel(CirculationService, ExternalPaymentGateway, "Processes fines and fees", "REST/HTTPS")
Rel(DigitalContentProxyService, DigitalContentProvider, "Fetches digital assets", "HTTPS")
Rel(NotificationWorker, NotificationService, "Dispatches alerts", "AMQP/RabbitMQ")
Rel(CatalogueService, Elasticsearch, "Queries search index", "TCP")
Rel(CatalogueService, PostgreSQL, "Reads and writes catalogue data", "TCP")
Rel(CirculationService, PostgreSQL, "Reads and writes circulation data", "TCP")
Rel(WebApplication, Redis, "Caches session and frequent reads", "TCP")
Rel(NotificationWorker, RabbitMQ, "Consumes messages", "AMQP")

@enduml