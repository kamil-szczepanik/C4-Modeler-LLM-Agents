@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(LibraryPatron, "Library Patron", "End-user accessing self-service portals.")
Person(LibraryStaff, "Library Staff", "Administrators managing inventory and desk operations.")
System(LibraryManagementSystem, "Library Management System", "A comprehensive platform for public and academic libraries designed to catalogue physical and digital items, manage circulation, and provide self-service portals with strict EU data residency.")
System_Ext(ExternalPaymentGateway, "External Payment Gateway", "Third-party service for fines and fee transactions.")
System_Ext(DigitalContentProvider, "Digital Content Provider", "External APIs for digital catalog items.")
System_Ext(NotificationService, "Notification Service", "Third-party or enterprise email/SMS provider for alerts.")

Rel(LibraryPatron, LibraryManagementSystem, "Interacts via self-service portals", "HTTPS")
Rel(LibraryStaff, LibraryManagementSystem, "Interacts for catalog management and desk operations", "HTTPS")
Rel(LibraryManagementSystem, ExternalPaymentGateway, "Integrates for fines and fee transactions", "REST/TLS")
Rel(LibraryManagementSystem, DigitalContentProvider, "Fetches assets from digital catalog", "REST/TLS")
Rel(LibraryManagementSystem, NotificationService, "Sends alerts and notifications", "SMTP/REST/TLS")

@enduml