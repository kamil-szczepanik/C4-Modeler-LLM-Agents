@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL container

Container_Boundary(postgresql, "PostgreSQL") {
    Component(Connection_Pool___Auth_Manager, "Connection Pool & Auth Manager (PgBouncer)", "PgBouncer", "Manages connection pooling and authentication for PostgreSQL.")
    Component(Query_Planner___Execution_Engine, "Query Planner & Execution Engine", "PostgreSQL Core", "Routes authenticated queries and executes query execution plans.")
    Component(Relational_Storage_Engine, "Relational Storage Engine", "PostgreSQL Storage", "Accesses data blocks and manages underlying relational storage.")
    Component(Row_Level_Security_Policy_Enforcer, "Row-Level Security Policy Enforcer", "PostgreSQL RLS", "Enforces row-level security policies for data access.")
    Component(Write_Ahead_Log_WAL_Manager, "Write-Ahead Log (WAL) Manager", "PostgreSQL WAL", "Manages write-ahead logging to guarantee ACID compliance.")
}

Rel(Connection_Pool___Auth_Manager, Query_Planner___Execution_Engine, "Routes authenticated queries via Internal IPC")
Rel(Query_Planner___Execution_Engine, Relational_Storage_Engine, "Accesses data blocks via Internal IPC")

@enduml