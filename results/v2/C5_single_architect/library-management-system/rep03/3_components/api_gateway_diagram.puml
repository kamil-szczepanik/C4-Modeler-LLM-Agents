@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Spring Cloud Gateway Router, "Spring Cloud Gateway Router", "Spring Cloud Gateway, Project Reactor", "Routes incoming requests from the Web Application to downstream microservices using reactive routing.")
    Component(Authentication & Authorization Component, "Authentication & Authorization Component", "Spring Security, Redis", "Validates tokens and enforces rate limits in conjunction with Redis.")
    Component(Resilience Handler, "Resilience Handler", "Resilience4j", "Implements circuit breaking and retries natively to isolate downstream services from traffic surges.")
}

Rel(Spring Cloud Gateway Router, Authentication & Authorization Component, "Validates tokens and rate limits", "TCP")
Rel(Spring Cloud Gateway Router, Resilience Handler, "Applies circuit breaking and retry patterns", "")

@enduml