@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "External or boundary API Gateway")
System_Ext(circulation_service, "Circulation Service", "Microservice verifying active loans")
System_Ext(digital_content_provider, "Digital Content Provider", "External digital content provider streaming assets")

Container_Boundary(digital_content_proxy_service, "Digital Content Proxy Service") {
    Component(proxy_controller, "Proxy Controller", "Java, Spring MVC", "Component handling incoming gRPC requests.")
    Component(entitlement_validator, "Entitlement Validator", "Java, Spring Security/Service", "Component verifying user access and patron loans.")
    Component(content_orchestrator, "Content Orchestrator", "Java, Spring Service", "Component managing streaming logic and caching.")
    Component(provider_client, "Provider Client", "Java, Spring WebClient, Resilience4j", "Component handling outbound HTTPS calls.")
    Component(cache_manager, "Cache Manager", "Spring Data Redis, Caffeine", "Component interfacing with shared Redis.")
}

Rel(api_gateway, proxy_controller, "Routes requests", "gRPC over TLS")
Rel(proxy_controller, entitlement_validator, "Validates access", "In-memory Method Call")
Rel(entitlement_validator, circulation_service, "Verifies active loans", "gRPC over TLS")
Rel(entitlement_validator, content_orchestrator, "Proceeds with content fetch", "In-memory Method Call")
Rel(content_orchestrator, cache_manager, "Checks/stores metadata and tokens", "RESP over TCP")
Rel(content_orchestrator, provider_client, "Initiates asset fetch", "In-memory Method Call")
Rel(provider_client, digital_content_provider, "Streams content", "HTTPS")

@enduml