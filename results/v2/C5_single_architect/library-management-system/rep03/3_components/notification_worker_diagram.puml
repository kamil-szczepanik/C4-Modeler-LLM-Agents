@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification Worker container

Container_Boundary(notification_worker, "Notification Worker") {
    Component(Queue_Consumer_Component, "Queue Consumer Component", "TypeScript, amqplib", "Ingests messages from RabbitMQ.")
    Component(Template_Engine_Component, "Template Engine Component", "Nunjucks", "Renders localized message bodies.")
    Component(Data_Sanitizer_Component, "Data Sanitizer Component", "Custom TypeScript module", "Strips PII from payloads.")
    Component(Dispatch_Adapter_Component, "Dispatch Adapter Component", "Axios, Node.js HTTPS", "Handles external integration for alert delivery.")
}

System(RabbitMQ, "RabbitMQ", "Message broker container.")
System_Ext(Notification_Service, "Notification Service", "External system for final alert delivery.")

Rel(Queue_Consumer_Component, RabbitMQ, "Consumes messages", "AMQP")
Rel(Queue_Consumer_Component, Template_Engine_Component, "Passes raw payload", "In-Memory Function Call")
Rel(Template_Engine_Component, Data_Sanitizer_Component, "Passes rendered payload", "In-Memory Function Call")
Rel(Data_Sanitizer_Component, Dispatch_Adapter_Component, "Forwards sanitized payload", "In-Memory Function Call")
Rel(Dispatch_Adapter_Component, Notification_Service, "Delivers alerts", "HTTPS/REST")
Rel(notification_worker, Notification_Service, "Dispatches alerts", "AMQP/RabbitMQ")

@enduml