@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "Spring Cloud Gateway / Envoy", "Secures and routes API traffic")

Container_Boundary(web_application, "Web Application") {
    Component(router_state_management_component, "Router / State Management Component", "React Router, Redux Toolkit", "Manages application routing and global state.")
    Component(authentication_session_manager_component, "Authentication & Session Manager Component", "React Context / OIDC client", "Handles user authentication and session management.")
    Component(feature_modules_component, "Feature Modules Component", "React", "Implements core feature functionality for patrons and staff.")
    Component(api_client_component, "API Client Component", "Axios", "Handles HTTP communication with the backend API Gateway.")
    Component(ui_component_library, "UI Component Library", "Tailwind CSS, Radix UI", "Provides styled and accessible UI primitives.")
}

Rel(feature_modules_component, api_client_component, "Internal Function Call")
Rel(api_client_component, api_gateway, "HTTPS/JSON")

@enduml