@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Elasticsearch container

Container_Boundary(Elasticsearch, "Elasticsearch") {
    Component(Query_DSL_Engine, "Query DSL Engine", "Elasticsearch", "Processes incoming search queries using Elasticsearch Query DSL.")
    Component(Indexing_Lucene_Core, "Indexing & Lucene Core", "Apache Lucene", "Manages inverted indices and document storage using Apache Lucene.")
    Component(Cluster_Coordination_Module, "Cluster Coordination Module", "Elasticsearch Zen Discovery/Raft", "Handles node discovery, shard allocation, and cluster state using Elasticsearch Zen Discovery/Raft.")
    Component(Document_Routing_Shard_Manager, "Document Routing & Shard Manager", "Elasticsearch Routing Module", "Directs operations to appropriate shards using the Elasticsearch Routing Module.")
    Component(Catalogue_Service, "Catalogue Service", "REST / HTTP, JSON over TCP", "Executes search and index requests.")
}

Rel(Catalogue_Service, Query_DSL_Engine, "Executes search and index requests", "REST / HTTP, JSON over TCP")
Rel(Query_DSL_Engine, Document_Routing_Shard_Manager, "Resolves shard locations", "Internal JVM Method")
Rel(Document_Routing_Shard_Manager, Indexing_Lucene_Core, "Executes segment-level operations", "Apache Lucene API")

@enduml