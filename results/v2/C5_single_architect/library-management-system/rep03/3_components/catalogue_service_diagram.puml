@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalogue Service container

Component(API_Gateway, "API Gateway", "API Gateway", "Routes incoming traffic.")
Component_Ext(Digital_Content_Provider, "Digital Content Provider", "External System", "External system for digital assets.")

Container_Boundary(catalogue_service, "Catalogue Service") {
    Component(Catalogue_Controller, "Catalogue Controller", "Spring MVC", "Exposes endpoints and translates gRPC requests.")
    Component(Item_Management_Service, "Item Management Service", "Spring Service", "Encapsulates core cataloging business logic.")
    Component(Search_Indexing_Service, "Search Indexing Service", "Spring Service", "Manages dual-write synchronization and query building.")
    Component(Catalogue_Repository, "Catalogue Repository", "Spring Data JPA", "Handles transactional persistence.")
    Component(Digital_Asset_Adapter, "Digital Asset Adapter", "Spring Component", "Integrates with external content providers.")
    Component(PostgreSQL, "PostgreSQL", "PostgreSQL", "Primary data store for item metadata.")
    Component(Elasticsearch, "Elasticsearch", "Elasticsearch", "Search index engine for fast querying.")
}

Rel(API_Gateway, Catalogue_Controller, "Routes catalog requests", "gRPC over TLS")
Rel(Catalogue_Controller, Item_Management_Service, "Method calls", "In-process")
Rel(Item_Management_Service, Catalogue_Repository, "JPA/Hibernate", "JDBC over TCP")
Rel(Item_Management_Service, Search_Indexing_Service, "Spring Application Events", "In-process")
Rel(Item_Management_Service, Digital_Asset_Adapter, "Method calls", "In-process")
Rel(Search_Indexing_Service, Elasticsearch, "Jest/Spring Data Elasticsearch", "TCP")
Rel(Catalogue_Repository, PostgreSQL, "Reads and writes data", "JDBC over TCP")
Rel(Digital_Asset_Adapter, Digital_Content_Provider, "Imports metadata", "REST/HTTPS over TLS")

@enduml