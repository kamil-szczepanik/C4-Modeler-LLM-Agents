@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the RabbitMQ container

System_Ext(catalogue_service, "Catalogue Service", "Java, Spring Boot")
System_Ext(circulation_service, "Circulation Service", "Java, Spring Boot")
System_Ext(notification_worker, "Notification Worker", "Node.js")

Container_Boundary(rabbitmq, "RabbitMQ") {
    Component(exchange_router, "Exchange Router", "RabbitMQ", "Routes catalog and circulation events to appropriate queues.")
    Component(notification_queue, "Notification Queue", "RabbitMQ", "Enqueues pending notification tasks for asynchronous processing.")
    Component(dlx_dlq, "Dead Letter Exchange & Queue (DLX/DLQ)", "RabbitMQ", "Handles poisoned messages and failed notifications.")
}

Rel(catalogue_service, exchange_router, "Publishes catalog events", "AMQP")
Rel(circulation_service, exchange_router, "Publishes loan/circulation events", "AMQP")
Rel(exchange_router, notification_queue, "Enqueues notification tasks", "AMQP")
Rel(notification_queue, notification_worker, "Dispatches pending notification tasks", "AMQP")
Rel(notification_worker, exchange_router, "Routes poisoned messages to DLX on failure", "AMQP")

@enduml