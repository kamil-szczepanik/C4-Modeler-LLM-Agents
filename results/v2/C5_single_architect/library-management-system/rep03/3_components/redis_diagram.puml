@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Redis container

System_Ext(api_gateway, "API Gateway", "Spring Cloud Gateway / Envoy", "Routes and throttles client requests.")
System_Ext(catalogue_service, "Catalogue Service", "Java, Spring Boot", "Manages bibliographic records.")

Container_Boundary(redis, "Redis") {
    Component(session_management_component, "Session Management Component", "In-memory data store", "Handles user session states.")
    Component(catalog_read_through_cache_component, "Catalog Read-Through Cache Component", "In-memory data store", "Stores frequently accessed bibliographic records.")
    Component(rate_limiter_component, "Rate Limiter Component", "In-memory data store", "Backs API Gateway traffic throttling.")
}

Rel(api_gateway, rate_limiter_component, "Throttles traffic", "RESP3 over TCP with TLS")
Rel(catalogue_service, catalog_read_through_cache_component, "Caches frequent reads", "RESP3 over TCP with TLS")

@enduml