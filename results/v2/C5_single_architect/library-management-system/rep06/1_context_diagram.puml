@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patron, "Patron", "End-user accessing the Self-Service Portal to manage borrows, searches, and digital content.")
Person(Librarian / Staff, "Librarian / Staff", "Library employee accessing the Administration Dashboard to manage inventory and circulation.")
System(Library Management System, "Library Management System", "A cloud-hosted platform for public and academic libraries to catalogue items, manage circulation, and provide self-service portals with EU-only data residency.")
System_Ext(Payment Gateway, "Payment Gateway", "External service (Stripe/Adyen) for handling financial transactions and fines.")
System_Ext(Notification Provider, "Notification Provider", "External service (SendGrid/Twilio) for sending alerts, reminders, and notifications.")
System_Ext(Identity Provider, "Identity Provider", "External service (Auth0/Keycloak) for managing standardized SSO authentication.")
System_Ext(Digital Content Provider, "Digital Content Provider", "External ILS Federation and content services (OverDrive, OCLC) for external digital catalogs.")

Rel(Patron, Library Management System, "Accesses self-service portal to browse and manage library items", "HTTPS")
Rel(Librarian / Staff, Library Management System, "Manages catalog, circulation, and administrative tasks", "HTTPS")
Rel(Library Management System, Payment Gateway, "Processes fines and transactions", "HTTPS/REST")
Rel(Library Management System, Notification Provider, "Sends automated notifications and alerts", "HTTPS/REST")
Rel(Library Management System, Identity Provider, "Authenticates users via SSO", "OIDC")
Rel(Library Management System, Digital Content Provider, "Federates digital content and catalogs", "HTTPS/REST")
@enduml