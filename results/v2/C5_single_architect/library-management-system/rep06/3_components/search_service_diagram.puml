@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Search Service container

System_Ext(API_Gateway, "API Gateway", "API Gateway", "Routes incoming search requests.")
System_Ext(Async_Event_Broker, "Async Event Broker", "Apache Kafka", "Broker for CDC and domain events.")
System_Ext(Elasticsearch, "Elasticsearch", "External Database", "External database for low-latency indexing and complex query capabilities.")

Container_Boundary(Search_Service, "Search Service") {
    Component(Search_API_Controller, "Search API Controller", "Python, FastAPI, Pydantic", "Routes search requests and handles request validation and serialization.")
    Component(Query_Builder_Component, "Query Builder Component", "Python", "Delegates request parsing and compiles queries.")
    Component(Index_Synchronizer_Component, "Index Synchronizer Component", "aiokafka", "Consumes CDC and domain events to update indices.")
    Component(Search_Client_Component, "Search Client Component", "elasticsearch-py async client", "Executes compiled queries and bulk updates.")
}

Rel(API_Gateway, Search_API_Controller, "Routes search requests", "gRPC/REST")
Rel(Async_Event_Broker, Index_Synchronizer_Component, "Consumes CDC and domain events", "TCP/Kafka Protocol")
Rel(Search_API_Controller, Query_Builder_Component, "Delegates request parsing", "In-process")
Rel(Query_Builder_Component, Search_Client_Component, "Executes compiled queries", "In-process")
Rel(Index_Synchronizer_Component, Search_Client_Component, "Updates indices", "In-process")
Rel(Search_Client_Component, Elasticsearch, "Executes queries and bulk updates", "TCP/HTTP, port 9200")

@enduml