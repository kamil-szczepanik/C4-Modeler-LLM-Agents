@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Patron_Librarian_Staff, "Patron / Librarian & Staff", "Interacts with the application.")
System_Ext(Identity_Provider, "Identity Provider", "Authenticates users and issues tokens.")
Container(API_Gateway, "API Gateway", "REST/JSON", "Routes requests from the API client layer to backend services.")

Container_Boundary(Web_Application_SPA, "Web Application (SPA)") {
    Component(Routing_Layout_Manager, "Routing & Layout Manager", "React Router", "Manages application routing and layout structure.")
    Component(Authentication_State_Module, "Authentication State Module", "React Context, Zustand, OIDC Client", "Manages client-side state and authentication via OpenID Connect / OAuth 2.0 without persistent local PII storage.")
    Component(Catalogue_Search_Module, "Catalogue & Search Module", "React UI components", "Provides catalog management and search interface for library patrons and staff.")
    Component(Circulation_Self_Service_Portal, "Circulation & Self-Service Portal", "React workflows", "Provides self-service workflows for loans, renewals, and fines.")
    Component(API_Client_Layer, "API Client Layer", "Axios, Fetch API, TanStack Query", "Handles HTTP request caching, retry logic, deduplication, and communication with backend services.")
}

Rel(Patron_Librarian_Staff, Web_Application_SPA, "Interacts with the application", "HTTPS")
Rel(Authentication_State_Module, Identity_Provider, "OpenID Connect / OAuth 2.0", "HTTPS")
Rel(Catalogue_Search_Module, API_Client_Layer, "Invokes queries and mutations", "In-memory / TypeScript imports")
Rel(Circulation_Self_Service_Portal, API_Client_Layer, "Invokes queries and mutations", "In-memory / TypeScript imports")
Rel(API_Client_Layer, API_Gateway, "REST/JSON", "HTTPS")

@enduml