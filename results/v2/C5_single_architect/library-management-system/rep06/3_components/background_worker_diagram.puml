@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Background Worker container

System_Ext(Apache_Kafka, "Apache Kafka", "Apache Kafka", "Asynchronous event ingestion via secure TCP with TLS.")
System_Ext(Notification_Provider, "Notification Provider", "HTTPS Service", "External notification provider.")
System_Ext(Payment_Gateway, "Payment Gateway", "HTTPS Service", "External payment gateway.")
System_Ext(Digital_Content_Provider, "Digital Content Provider", "HTTPS Service", "External digital content provider.")
System_Ext(Search_Service, "Search Service", "Internal API / Database", "Search service for high-performance search SLAs.")

Container_Boundary(background_worker, "Background Worker") {
    Component(Task_Dispatcher_Consumer, "Task Dispatcher / Consumer", "Python, Celery Worker Core", "Processes asynchronous tasks and core task dispatching.")
    Component(Notification_Task_Handler, "Notification Task Handler", "Python, Celery", "Handles notification tasks and interacts with external providers.")
    Component(Payment_Processor_Worker, "Payment Processor Worker", "Python, Celery", "Processes payment-related background tasks and communicates with payment gateways.")
    Component(Content_Sync_Worker, "Content Sync Worker", "Python, Celery", "Synchronizes digital content with external providers.")
    Component(Data_Maintenance_Worker, "Data Maintenance Worker", "Python, Celery", "Performs data maintenance and interacts with the Search Service.")
    Component(Database_Maintenance_Analytics_Worker, "Database Maintenance & Analytics Worker", "Python, Celery", "Executes database maintenance and analytics processing.")
    Component(Redis, "Redis", "Redis", "Acts as Celery task state and result backend with strict persistence for EU data residency.")
}

Component(PostgreSQL, "PostgreSQL", "PostgreSQL", "Primary persistent data store.")

Rel(Apache_Kafka, Task_Dispatcher_Consumer, "Secure TCP with TLS", "Secure TCP with TLS")
Rel(Notification_Task_Handler, Notification_Provider, "HTTPS", "HTTPS")
Rel(Payment_Processor_Worker, Payment_Gateway, "HTTPS", "HTTPS")
Rel(Content_Sync_Worker, Digital_Content_Provider, "HTTPS", "HTTPS")
Rel(Data_Maintenance_Worker, Search_Service, "Internal API / Database queries", "Internal API / Database queries")
Rel(Task_Dispatcher_Consumer, PostgreSQL, "Reads/Writes data", "Reads/Writes data")
Rel(Notification_Task_Handler, PostgreSQL, "Reads/Writes data", "Reads/Writes data")
Rel(Payment_Processor_Worker, PostgreSQL, "Reads/Writes data", "Reads/Writes data")
Rel(Content_Sync_Worker, PostgreSQL, "Reads/Writes data", "Reads/Writes data")
Rel(Data_Maintenance_Worker, PostgreSQL, "Reads/Writes data", "Reads/Writes data")
Rel(Database_Maintenance_Analytics_Worker, PostgreSQL, "Reads/Writes data", "Reads/Writes data")

@enduml