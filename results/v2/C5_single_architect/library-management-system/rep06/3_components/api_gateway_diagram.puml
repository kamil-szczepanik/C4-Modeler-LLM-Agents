@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

System_Ext(Identity Provider, "Identity Provider", "External Identity Provider")
System_Ext(Redis Database, "Redis Database", "Redis database for rate limiting")
System_Ext(Core Domain Service, "Core Domain Service", "Core Domain Service")
System_Ext(Search Service, "Search Service", "Search Service")

Container_Boundary(API Gateway, "API Gateway") {
    Component(Routing Engine, "Routing Engine", "Spring Cloud Gateway (Java)", "Routes incoming sanitized requests to the Core Domain Service and Search Service.")
    Component(Auth & Token Relay Filter, "Auth & Token Relay Filter", "Spring Cloud Gateway (Java), HTTPS/OIDC", "Introspects and validates JSON Web Tokens (JWTs) against the Identity Provider.")
    Component(Rate Limiter / Throttler, "Rate Limiter / Throttler", "Spring Cloud Gateway (Java), Redis", "Checks request quotas against the Redis database.")
    Component(Request Transformation & Logging Filter, "Request Transformation & Logging Filter", "Spring Cloud Gateway (Java)", "Transforms and logs incoming requests before forwarding.")
}

Rel(Auth & Token Relay Filter, Identity Provider, "Introspects/Validates JWTs", "HTTPS/OIDC")
Rel(Rate Limiter / Throttler, Redis Database, "Checks request quotas", "RESP/TCP")
Rel(Routing Engine, Core Domain Service, "Forwards sanitized requests", "gRPC")
Rel(Routing Engine, Search Service, "Forwards sanitized requests", "gRPC")

@enduml