@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Domain Service container

Container_Boundary(core_domain_service, "Core Domain Service") {
    Component(CatalogueManagementComponent, "Catalogue Management Component", "Spring @Service (Java)", "Handling item cataloguing.")
    Component(CirculationEngineComponent, "Circulation Engine Component", "Spring @Service (Java)", "Managing loans and reservations.")
    Component(PaymentNotificationFacade, "Payment & Notification Facade", "Spring @Component (Java)", "Handling external integrations.")
    Component(DataAccessRepository, "Data Access Repository", "Spring Data JPA (Java)", "Managing persistence.")
    Component(EventPublisherComponent, "Event Publisher Component", "Spring Cloud Stream / Kafka Template (Java)", "Handling event dispatch.")
}

System_Ext(AsyncEventBroker, "Async Event Broker", "Apache Kafka", "External event broker.")
System_Ext(PaymentGatewayNotificationProvider, "Payment Gateway & Notification Provider", "HTTPS", "External payment and notification services.")

Rel(CatalogueManagementComponent, DataAccessRepository, "Persists and queries data", "JDBC / In-process method calls")
Rel(CirculationEngineComponent, DataAccessRepository, "Persists and queries data", "JDBC / In-process method calls")
Rel(CirculationEngineComponent, PaymentNotificationFacade, "Triggers payments and alerts", "In-process method calls")
Rel(CatalogueManagementComponent, EventPublisherComponent, "Dispatches domain events", "In-process method calls")
Rel(CirculationEngineComponent, EventPublisherComponent, "Dispatches domain events", "In-process method calls")
Rel(EventPublisherComponent, AsyncEventBroker, "Publishes events", "TCP / Kafka Protocol")
Rel(PaymentNotificationFacade, PaymentGatewayNotificationProvider, "Processes transactions and messages", "HTTPS")

@enduml