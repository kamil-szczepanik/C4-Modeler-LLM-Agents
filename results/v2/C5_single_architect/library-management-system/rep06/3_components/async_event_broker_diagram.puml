@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(async_event_broker, "Async Event Broker") {
    Component(Event_Router_Topic_Manager, "Event Router / Topic Manager", "Apache Kafka", "Manages topics and routes events across the event-driven architecture.")
    Component(Producer_Ingress_Handler, "Producer Ingress Handler", "Apache Kafka", "Handles incoming events produced by services like the Core Domain Service.")
    Component(Consumer_Egress_Dispatcher, "Consumer Egress Dispatcher", "Apache Kafka", "Dispatches events to consumers such as the Search Service.")
    Component(Schema_Registry, "Schema Registry", "Apache Avro", "Enforces schema validation and contract compatibility for events.")
}

Rel(Producer_Ingress_Handler, Schema_Registry, "Validates event schemas", "HTTP/REST")
Rel(Consumer_Egress_Dispatcher, Schema_Registry, "Validates event schemas", "HTTP/REST")

@enduml