@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(Patron, "Patron", "End-user interacting with the system.")
Person(Librarian_Staff, "Librarian/Staff", "End-user interacting with the system.")

System_Ext(Payment_Gateway, "Payment Gateway", "External system for handling payments.")
System_Ext(Notification_Provider, "Notification Provider", "External system for delivering notifications.")
System_Ext(Identity_Provider, "Identity Provider", "External system for authentication and identity management.")
System_Ext(Digital_Content_Provider, "Digital Content Provider", "External system for federated digital content and catalogs.")

System_Boundary(Library_Management_System, "Library Management System") {
    Container(Web_Application_SPA, "Web Application (SPA)", "React, TypeScript, Nginx", "Frontend interface for patrons and staff.")
    Container(API_Gateway, "API Gateway", "Spring Cloud Gateway, Envoy", "Handles routing and security.")
    Container(Core_Domain_Service, "Core Domain Service", "Java, Spring Boot", "Manages business logic and circulation.")
    Container(Search_Service, "Search Service", "Python, FastAPI, Elasticsearch", "Provides high-performance querying and search capabilities.")
    Container(Async_Event_Broker, "Async Event Broker", "Apache Kafka", "Managed EU instance for decoupled messaging.")
    Container(Background_Worker, "Background Worker", "Python, Celery", "Processes asynchronous tasks.")
    ContainerDb(Database, "Database", "PostgreSQL", "Managed EU instance for relational persistence.")
}

Rel(Patron, Web_Application_SPA, "Interacts with the application", "HTTPS")
Rel(Librarian_Staff, Web_Application_SPA, "Interacts with the application", "HTTPS")
Rel(Web_Application_SPA, API_Gateway, "Sends requests", "HTTPS")
Rel(API_Gateway, Core_Domain_Service, "Routes requests", "gRPC/REST")
Rel(API_Gateway, Search_Service, "Routes search requests", "gRPC/REST")
Rel(Core_Domain_Service, Database, "Persists and queries data", "JDBC")
Rel(Core_Domain_Service, Async_Event_Broker, "Publishes domain events", "TCP/Kafka Protocol")
Rel(Async_Event_Broker, Search_Service, "Consumes events to update indices", "TCP/Kafka Protocol")
Rel(Core_Domain_Service, Payment_Gateway, "Processes payments", "HTTPS")
Rel(Core_Domain_Service, Notification_Provider, "Sends notifications", "HTTPS")
Rel(Core_Domain_Service, Identity_Provider, "Authenticates users", "HTTPS")
Rel(Core_Domain_Service, Digital_Content_Provider, "Accesses digital content", "HTTPS")
Rel(Background_Worker, Payment_Gateway, "Processes asynchronous payment tasks", "HTTPS")
Rel(Background_Worker, Notification_Provider, "Sends asynchronous notifications", "HTTPS")
Rel(Background_Worker, Identity_Provider, "Handles identity tasks", "HTTPS")
Rel(Background_Worker, Digital_Content_Provider, "Syncs digital content", "HTTPS")

@enduml