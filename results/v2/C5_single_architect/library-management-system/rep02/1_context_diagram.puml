@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(LibraryPatronsandLibraryStaff, "Library Patrons and Library Staff", "Users who interact with the system for cataloguing, circulation, and self-service portal access.")
System(LibraryManagementSystem, "Library Management System", "A cloud-hosted SaaS solution that enables public and academic libraries to catalogue physical and digital items, manage circulation, and provide self-service portals while enforcing strict EU-only data residency.")
System_Ext(PaymentGateway, "Payment Gateway", "Third-party financial service (Stripe/Adyen) pinned to EU-region endpoints for fine processing.")
System_Ext(NotificationService, "Notification Service", "Third-party messaging service (SendGrid/Twilio) pinned to EU-region endpoints for alerts.")
System_Ext(NationalLibraryRegistry, "National Library Registry", "EU-hosted REST API used for metadata synchronization.")
System_Ext(IdentityProvider, "Identity Provider", "OAuth2/OIDC service for standardized single sign-on authentication.")

Rel(LibraryPatronsandLibraryStaff, LibraryManagementSystem, "UI interaction", "HTTPS")
Rel(LibraryManagementSystem, PaymentGateway, "Fine processing", "HTTPS")
Rel(LibraryManagementSystem, NotificationService, "Alerts", "HTTPS")
Rel(LibraryManagementSystem, NationalLibraryRegistry, "Metadata synchronization", "HTTPS/REST")
Rel(LibraryManagementSystem, IdentityProvider, "Authentication", "OIDC")
@enduml