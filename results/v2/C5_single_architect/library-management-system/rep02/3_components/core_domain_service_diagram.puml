@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(core_domain_service, "Core Domain Service") {
    Component(CatalogManagementComponent, "Catalog Management Component", "Spring MVC/Data", "Handling physical and digital items.")
    Component(CirculationFinesComponent, "Circulation & Fines Component", "Spring Boot", "Manages loans, returns, and payment processing.")
    Component(EventPublisherComponent, "Event Publisher Component", "Spring AMQP", "Dispatching domain events.")
    Component(RegistryIntegrationComponent, "Registry Integration Component", "Spring Cloud OpenFeign", "Synchronizing metadata.")
    Component(SecurityContextAuthComponent, "Security Context & Auth Component", "Spring Security", "Validating tokens locally.")
}

Rel(CatalogManagementComponent, CirculationFinesComponent, "Interacts with")
Rel(EventPublisherComponent, RegistryIntegrationComponent, "Coordinates with")
@enduml