@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(Database, "Database") {
    Component(Primary_PostgreSQL_Instance, "Primary PostgreSQL Instance", "PostgreSQL", "Primary relational OLTP data management system ensuring strict EU-only data residency.")
    Component(PostgreSQL_Read_Replicas, "PostgreSQL Read Replicas", "PostgreSQL", "Read replicas providing optimized read performance for catalogue searches.")
    Component(PgBouncer_Connection_Pooler, "PgBouncer Connection Pooler", "PgBouncer", "Manages and pools database connections efficiently under high concurrency.")
    Component(Audit_Logging_Subsystem, "Audit Logging Subsystem", "pgAudit", "Provides native audit logging to ensure strict EU data governance compliance.")
    Component(Fuzzy_Text_Search_Extension, "Fuzzy-Text Search Extension", "pg_trgm Extension", "Enabled in PostgreSQL to support fast fuzzy-text searches and meet performance requirements.")
}

Rel(PgBouncer_Connection_Pooler, Primary_PostgreSQL_Instance, "Routes write queries and transactions", "PostgreSQL Native Protocol over TLS")
Rel(PgBouncer_Connection_Pooler, PostgreSQL_Read_Replicas, "Routes read queries", "PostgreSQL Native Protocol over TLS")
@enduml