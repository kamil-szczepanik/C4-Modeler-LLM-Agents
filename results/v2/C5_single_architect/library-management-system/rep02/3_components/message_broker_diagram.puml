@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(message_broker, "Message Broker") {
    Component(ExchangeComponent, "Exchange Component", "RabbitMQ Exchange", "Routes incoming messages from the Core Domain Service to appropriate queues.")
    Component(notification_queue, "notification-queue", "RabbitMQ Queue", "Queues notification tasks for asynchronous processing by the Notification Worker.")
    Component(audit_event_queue, "audit-event-queue", "RabbitMQ Queue", "Stores audit event messages to maintain compliance and activity logs.")
    Component(DataPolicyEnforcementComponent, "Data Policy Enforcement Component", "RabbitMQ Policy Engine", "Enforces EU-only data residency and local storage policies.")
}

Rel(ExchangeComponent, notification_queue, "Routes notification messages", "AMQP")
Rel(ExchangeComponent, audit_event_queue, "Routes audit messages", "AMQP")

@enduml