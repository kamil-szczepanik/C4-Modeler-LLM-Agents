@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application container

System_Ext(api_gateway, "API Gateway", "Nginx / Spring Cloud Gateway", "External API Gateway")

Container_Boundary(web_app, "Web Application") {
    Component(Auth_Controller, "Auth Controller", "TypeScript / OIDC Client Library", "Handles authentication and security flow.")
    Component(Catalog_UI_Module, "Catalog UI Module", "React Components / TanStack Query", "Provides library cataloging interface and data fetching.")
    Component(Circulation_Module, "Circulation Module", "React Components", "Provides library circulation and self-service portal features.")
    Component(API_Client, "API Client", "Axios / Fetch API", "Invokes backend API requests.")
    Component(State_Management_Store, "State Management Store", "Zustand / Redux Toolkit", "Manages local application state and caching.")
    Component(Router_Component, "Router Component", "React Router", "Handles client-side navigation and lazy-loading.")
}

Rel(Router_Component, Catalog_UI_Module, "Lazy-loads views", "In-process")
Rel(Router_Component, Circulation_Module, "Lazy-loads views", "In-process")
Rel(Auth_Controller, State_Management_Store, "Manages state", "In-process")
Rel(Catalog_UI_Module, State_Management_Store, "Manages state", "In-process")
Rel(Circulation_Module, State_Management_Store, "Manages state", "In-process")
Rel(Auth_Controller, API_Client, "Invokes requests", "In-process")
Rel(Catalog_UI_Module, API_Client, "Invokes requests", "In-process")
Rel(API_Client, api_gateway, "Forwards authenticated requests", "HTTPS/REST")

@enduml