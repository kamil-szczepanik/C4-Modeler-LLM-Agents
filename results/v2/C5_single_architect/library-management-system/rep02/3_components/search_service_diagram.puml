@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(search_service, "Search Service") {
    Component(api_controller, "API Controller", "Spring MVC / Spring WebFlux", "Exposes endpoints for search requests.")
    Component(query_sanitizer, "Query Sanitizer Component", "In-memory Java", "Sanitizes inputs to ensure compliance with EU data residency rules.")
    Component(search_orchestrator, "Search Orchestrator", "Java Service Bean", "Orchestrates the search process and query handling.")
    Component(elasticsearch_repository, "Elasticsearch Repository", "Spring Data Elasticsearch", "Executes queries against the search engine.")
    Component(catalogue_sync_listener, "Catalogue Sync Listener", "Spring AMQP / Kafka Listener", "Consumes item events from the message broker for synchronization.")
}

Rel(api_controller, query_sanitizer, "Sanitizes inputs", "In-memory Java Method Call")
Rel(query_sanitizer, search_orchestrator, "Passes clean queries", "In-memory Java Method Call")
Rel(search_orchestrator, elasticsearch_repository, "Executes queries", "Elasticsearch Java Client")

@enduml