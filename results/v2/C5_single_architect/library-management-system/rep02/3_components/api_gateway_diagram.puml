@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

System_Ext(Core_Domain_Service, "Core Domain Service", "Java/Spring Boot")
System_Ext(Search_Service, "Search Service", "Java with Elasticsearch")
System_Ext(Identity_Provider, "Identity Provider", "External Systems")

Container_Boundary(api_gateway, "API Gateway") {
    Component(Routing_Load_Balancing_Component, "Routing & Load Balancing Component", "Spring Cloud Gateway", "Handles native reactive routing, dynamic service discovery, and load balancing.")
    Component(JWT_Validation_Filter, "JWT Validation Filter", "Spring Cloud Gateway Filter with WebClient", "Validates incoming tokens and performs non-blocking reactive key caching.")
    Component(Rate_Limiting_Throttling_Component, "Rate Limiting & Throttling Component", "Spring Cloud Gateway", "Enforces rate limits and throttles excessive requests to protect downstream services.")
    Component(Circuit_Breaker_Component, "Circuit Breaker Component", "Resilience4j", "Protects search endpoints and prevents cascading failures.")
}

Rel(Routing_Load_Balancing_Component, Core_Domain_Service, "Routes validated commands/queries", "gRPC")
Rel(Circuit_Breaker_Component, Search_Service, "Protects search endpoints", "gRPC")
Rel(JWT_Validation_Filter, Identity_Provider, "Validates tokens", "HTTPS/REST")

@enduml