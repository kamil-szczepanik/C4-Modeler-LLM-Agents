@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(LibraryPatron, "Library Patron", "End-user utilizing self-service portals.")
Person(LibrarianStaff, "Librarian / Staff", "Internal user managing the catalogue and desk operations.")

System_Ext(PaymentGateway, "Payment Gateway", "Third-party processor for fines and fees.")
System_Ext(NotificationService, "Notification Service", "EU-hosted provider for email and SMS alerts.")
System_Ext(DRMProvider, "DRM Provider", "Manages licensing and access control for digital assets.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(WebApplication, "Web Application", "React, TypeScript, Nginx", "Powers the responsive single-page Web Application.")
    Container(APIGateway, "API Gateway", "Spring Cloud Gateway / Kong", "Manages secure API entry routing.")
    Container(CoreDomainService, "Core Domain Service", "Java, Spring Boot", "Implements robust Core Domain business logic.")
    Container(SearchService, "Search Service", "Python, FastAPI, Elasticsearch", "Delivers high-performance search to meet <800ms response targets.")
    Container(BackgroundWorkerService, "Background Worker Service", "Python/Celery or Java/Spring Batch", "Handles asynchronous background jobs.")
    ContainerDb(PostgreSQLDatabase, "PostgreSQL Database", "PostgreSQL", "Guarantees compliance with EU-only data residency constraints.")
    ContainerDb(RedisCache, "Redis Cache", "Redis", "Accelerates frequent catalogue queries and session management.")
}

Rel(LibraryPatron, WebApplication, "Accesses self-service portals", "HTTPS")
Rel(LibrarianStaff, WebApplication, "Manages cataloging and circulation via Admin UI", "HTTPS")
Rel(WebApplication, APIGateway, "Calls API Gateway", "HTTPS/JSON")
Rel(APIGateway, SearchService, "Routes search queries", "gRPC")
Rel(CoreDomainService, RedisCache, "Accesses cache for session management", "TCP")
Rel(SearchService, RedisCache, "Accesses cache for frequent catalogue queries", "TCP")
Rel(CoreDomainService, PostgreSQLDatabase, "Persists EU-hosted data", "Database Protocol")
Rel(BackgroundWorkerService, NotificationService, "Sends notifications", "HTTPS/JSON")
Rel(BackgroundWorkerService, DRMProvider, "Communicates with DRM Provider", "HTTPS/JSON")

@enduml