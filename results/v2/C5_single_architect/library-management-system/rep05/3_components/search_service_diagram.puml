@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Search Service container

System_Ext(api_gateway, "API Gateway", "External API Gateway")
System_Ext(rabbitmq_kafka, "RabbitMQ / Kafka", "Internal message broker for domain events.")
System_Ext(elasticsearch_cluster, "Elasticsearch Cluster", "Storage and execution engine for catalog searches.")
System_Ext(postgresql_database, "PostgreSQL Database", "Primary relational data store.")
System_Ext(redis_cache, "Redis Cache", "Accesses frequent queries.")

Container_Boundary(search_service, "Search Service") {
    Component(search_controller, "Search Controller", "FastAPI routing layer", "Handles incoming queries and routes search requests.")
    Component(query_builder, "Query Builder", "Python", "Translates search parameters into Elasticsearch Query DSL.")
    Component(index_synchronizer, "Index Synchronizer", "Python", "Listens for domain events to maintain index consistency.")
    Component(elasticsearch_client, "Elasticsearch Client", "Python transport layer", "Interfacing with the search cluster.")
}

Rel(api_gateway, search_controller, "Routes search queries", "gRPC")
Rel(rabbitmq_kafka, index_synchronizer, "Consumes domain events", "AMQP/TCP")
Rel(index_synchronizer, postgresql_database, "Queries initial data", "TCP/JDBC")
Rel(search_controller, query_builder, "Executes internal method calls", "In-process")
Rel(query_builder, elasticsearch_client, "Translates Query DSL", "HTTP/JSON")
Rel(elasticsearch_client, elasticsearch_cluster, "Transports queries", "TCP/REST")
Rel(search_controller, redis_cache, "Accesses frequent queries", "TCP")

@enduml