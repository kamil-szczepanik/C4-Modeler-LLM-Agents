@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Background Worker Service container

Container_Boundary(background_worker_service, "Background Worker Service") {
    Component(Task_Dispatcher, "Task Dispatcher", "Python with Celery", "Dispatches and coordinates asynchronous tasks and background jobs.")
    Component(Maintenance_Job_Scheduler, "Maintenance Job Scheduler", "Python", "Schedules and executes periodic maintenance jobs and circulation updates.")
}

System_Ext(PostgreSQL_Database, "PostgreSQL Database", "Primary transactional database ensuring EU data residency")
System_Ext(Redis, "Redis", "Message broker and cache")
System_Ext(Notification_Service, "Notification Service", "External notification service")
System_Ext(DRM_Provider, "DRM Provider", "External DRM provider")

Rel(Maintenance_Job_Scheduler, PostgreSQL_Database, "Updates circulations", "TCP/Postgres")
Rel(Task_Dispatcher, Redis, "Consumes messages", "TCP")
Rel(Task_Dispatcher, Notification_Service, "Sends notifications", "HTTPS/JSON")
Rel(Task_Dispatcher, DRM_Provider, "Provisions digital rights", "HTTPS/JSON")

@enduml