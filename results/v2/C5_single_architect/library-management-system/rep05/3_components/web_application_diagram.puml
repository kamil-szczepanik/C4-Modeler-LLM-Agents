@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "Spring Cloud Gateway / Kong", "External API Gateway handling backend routing")

Container_Boundary(web_application, "Web Application") {
    Component(ui_router_and_views, "UI Router and Views", "React 18, TypeScript, Vite", "Provides page routing and view rendering for self-service portals and the Admin UI.")
    Component(state_management_and_caching, "State Management and Caching", "TanStack Query, Zustand, React Context", "Manages server state, client-side caching, global UI states, roles, and localization to meet performance requirements.")
    Component(http_api_client, "HTTP API Client", "Fetch / Axios", "Communicates securely with the API Gateway via HTTPS/JSON.")
}

Rel(ui_router_and_views, state_management_and_caching, "Reads and writes UI and server state")
Rel(state_management_and_caching, http_api_client, "Triggers data fetching and mutations")
Rel(http_api_client, api_gateway, "Calls backend APIs", "HTTPS/JSON")
@enduml