@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(api_gateway_comp, "API Gateway", "Spring Cloud Gateway (Java, Spring WebFlux)", "Manages secure, non-blocking routing and edge security for all ingress traffic.")
    Component(auth_filter, "Authentication & Authorization Filter", "Spring Security / OAuth2", "Validates JWT tokens for secure authentication and dispatches audit events.")
    Component(ssl_handler, "SSL Termination & CORS Handler", "Nginx / Spring Cloud Gateway", "Handles ingress traffic over HTTPS/JSON.")
}

System_Ext(search_service, "Search Service", "Backend search container")
System_Ext(core_domain_service, "Core Domain Service", "Backend business logic container")
System_Ext(redis_cache, "Redis Cache", "In-memory data store for rate limiting")
System_Ext(notification_service, "Notification Service", "External notification service")

Rel(ssl_handler, api_gateway_comp, "Routes verified ingress traffic", "HTTPS/JSON")
Rel(api_gateway_comp, search_service, "Routes search queries", "gRPC")
Rel(api_gateway_comp, core_domain_service, "Routes circulation requests", "gRPC")
Rel(api_gateway_comp, redis_cache, "Evaluates rate limits", "Redis Protocol")
Rel(auth_filter, notification_service, "Dispatches audit events", "HTTPS/JSON")

@enduml