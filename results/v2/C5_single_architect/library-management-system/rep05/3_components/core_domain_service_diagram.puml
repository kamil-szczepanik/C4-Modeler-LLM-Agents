@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Domain Service container

Container_Boundary(core_domain_service, "Core Domain Service") {
    Component(BookItemManagementComponent, "Book/Item Management Component", "Java, Spring Boot, Spring Data JPA", "Manages cataloguing and book/item inventories.")
    Component(CirculationEngineComponent, "Circulation Engine Component", "Java, Spring Boot", "Handles circulation management and processing.")
    Component(DomainEventPublisher, "Domain Event Publisher", "Apache Kafka, Spring Cloud Stream", "Publishes domain events for asynchronous catalogue synchronization.")
    Component(SecurityAuthComponent, "Security/Auth Component", "Spring Security, Java", "Ensures authentication and security controls within the container.")
}

Rel(CirculationEngineComponent, BookItemManagementComponent, "In-process method calls", "Java")

@enduml