@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Redis Cache container

Container_Boundary(redis_cache, "Redis Cache") {
    Component(Session_Store_Module, "Session Store Module", "Redis 7.x Module", "Validates tokens and retrieves user state for the Core Domain Service.")
    Component(Catalogue_Query_Cache_Module, "Catalogue Query Cache Module", "Redis 7.x Module", "Executes cache-aside pattern for frequent catalogue queries from the Search Service.")
    Component(Cache_Eviction_Expiry_Manager, "Cache Eviction & Expiry Manager", "Redis 7.x volatile-lru policies & TTLs", "Enforces strict memory management for EU-only data residency.")
}

System_Ext(Core_Domain_Service, "Core Domain Service", "Java, Spring Boot")
System_Ext(Search_Service, "Search Service", "Python, FastAPI, Elasticsearch")

Rel(Core_Domain_Service, Session_Store_Module, "Validates tokens and retrieves user state", "RESP3/TCP")
Rel(Search_Service, Catalogue_Query_Cache_Module, "Executes cache-aside pattern for frequent catalogue queries", "RESP3/TCP")
Rel(Core_Domain_Service, redis_cache, "Accesses cache for sessions and queries", "TCP")
Rel(Search_Service, redis_cache, "Accesses cache for sessions and queries", "TCP")

@enduml