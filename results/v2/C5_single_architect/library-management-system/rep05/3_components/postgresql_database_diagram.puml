@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(postgresql_database, "PostgreSQL Database") {
    Component(Relational Storage Engine, "Relational Storage Engine", "PostgreSQL container", "Enforces strict EU-only data residency and stores transactional data.")
    Component(PgBouncer Connection Pooler, "PgBouncer Connection Pooler", "PgBouncer", "Manages and isolates connection management for database queries.")
    Component(Database Migration Manager, "Database Migration Manager", "Flyway / Liquibase", "Handles schema migrations for the PostgreSQL database.")
}

Rel(PgBouncer Connection Pooler, Relational Storage Engine, "Routes and pools TCP connections")
Rel(Database Migration Manager, Relational Storage Engine, "Applies schema migrations")

@enduml