@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Library_Patron, "Library Patron", "End-user utilizing self-service portals.")
Person(Librarian_Staff, "Librarian / Staff", "Internal user managing the catalogue and desk operations.")

System(Library_Management_System, "Library Management System", "Core platform providing cataloging, circulation management, and self-service portals with EU-only data residency compliance.")

System_Ext(Payment_Gateway, "Payment Gateway", "Third-party processor for fines and fees.")
System_Ext(Notification_Service, "Notification Service", "EU-hosted provider for email and SMS alerts.")
System_Ext(Digital_Rights_Management_DRM_Provider, "Digital Rights Management (DRM) Provider", "Manages licensing and access control for digital assets.")

Rel(Library_Patron, Library_Management_System, "Accesses self-service portals", "HTTPS via Web/Mobile UI")
Rel(Librarian_Staff, Library_Management_System, "Manages cataloging and circulation via Admin UI", "HTTPS")
Rel(Library_Management_System, Payment_Gateway, "Processes transactions for fines and fees", "HTTPS/REST API")
Rel(Library_Management_System, Notification_Service, "Sends email and SMS alerts using EU-hosted endpoints", "SMTP and HTTPS APIs")
Rel(Library_Management_System, Digital_Rights_Management_DRM_Provider, "Manages digital asset licensing and access control", "HTTPS/REST API with OAuth 2.0")

@enduml