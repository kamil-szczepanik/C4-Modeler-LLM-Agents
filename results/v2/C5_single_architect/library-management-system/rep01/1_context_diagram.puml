@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patrons_Library_Members, "Patrons / Library Members", "Library members who use the self-service portals to access and borrow physical and digital items.")
Person(Librarians_Staff, "Librarians / Staff", "Staff members who manage the library catalogue, circulation, and system operations.")

System(Library_Management_System, "Library Management System", "Enterprise platform designed for public and academic libraries to catalogue physical and digital items, manage circulation, and provide self-service portals with strict EU-only data residency.")

System_Ext(External_Payment_Gateway, "External Payment Gateway", "External system used for processing payments.")
System_Ext(Digital_Content_Providers_eBook_Vendors, "Digital Content Providers / e-Book Vendors", "External vendors providing digital content and e-books.")
System_Ext(Notification_Service, "Notification Service", "External service used for sending automated alerts and notifications.")
System_Ext(External_Enterprise_Search_Service, "External Enterprise Search Service", "Subsystem providing high-performance search capabilities.")

Rel(Patrons_Library_Members, Library_Management_System, "Accesses self-service portals and manages circulation", "HTTPS/WSS")
Rel(Librarians_Staff, Library_Management_System, "Manages library operations and cataloguing", "HTTPS/WSS")
Rel(Library_Management_System, External_Payment_Gateway, "Processes financial transactions", "REST/TLS")
Rel(Library_Management_System, Digital_Content_Providers_eBook_Vendors, "Retrieves and manages digital content", "REST/OAuth2")
Rel(Library_Management_System, Notification_Service, "Sends automated alerts and notifications", "HTTPS/SMTP")

@enduml