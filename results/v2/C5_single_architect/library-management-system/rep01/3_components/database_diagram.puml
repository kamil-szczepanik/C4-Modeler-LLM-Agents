@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database container

Container_Boundary(database, "Database") {
    Component(Relational_Storage_Engine, "Relational Storage Engine", "PostgreSQL 15", "Core relational engine for ACID-compliant storage of patrons, items, and transactions within EU infrastructure.")
    Component(Connection_Pooler, "Connection Pooler", "PgBouncer", "Connection pooler to manage concurrent connections and meet performance NFRs.")
    Component(Audit_Logging_Extension, "Audit Logging Extension", "pgAudit", "Extension for strict database-level activity logging to satisfy EU compliance.")
    Component(Full_Text_Search_Index, "Full-Text Search Index", "PostgreSQL GIN Indexes", "Native full-text search index for fast metadata filtering.")
}

Rel(Connection_Pooler, Relational_Storage_Engine, "Proxied client connections [TCP, local socket]")
Rel(Relational_Storage_Engine, Audit_Logging_Extension, "Writes security and data access event logs [Internal PostgreSQL Hook]")

@enduml