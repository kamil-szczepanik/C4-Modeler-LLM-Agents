@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(redis_cache, "Redis Cache") {
    Component(CacheDataStore, "Cache Data Store", "Redis In-Memory Engine", "Manages internal Redis memory operations and stores cached data.")
    Component(EvictionTTLManager, "Eviction & TTL Manager", "Redis", "Manages cache eviction policies and time-to-live configurations.")
    Component(ConnectionCommandRouter, "Connection & Command Router", "Redis Cluster / Sentinel Interface", "Routes read/write and TTL configuration commands via TCP/RESP (Pooled).")
}

Rel(ConnectionCommandRouter, CacheDataStore, "Manages internal Redis memory operations", "")

@startuml