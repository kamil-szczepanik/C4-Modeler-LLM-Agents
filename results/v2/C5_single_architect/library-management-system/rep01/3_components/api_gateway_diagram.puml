@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("API Gateway", "API Gateway") {
    Component("SSL/TLS Termination Component", "SSL/TLS Termination Component", "OpenSSL / Nginx", "Terminates inbound HTTPS traffic and handles perimeter security enforcing EU data residency.")
    Component("Authentication & Authorization Component", "Authentication & Authorization Component", "Kong JWT Plugin & OAuth2", "Validates credentials and offloads edge-based authentication.")
    Component("Routing & Load Balancing Component", "Routing & Load Balancing Component", "Kong / Nginx & Lua", "Forwards authenticated traffic and search queries to backend services.")
    Component("Rate Limiting & Throttling Component", "Rate Limiting & Throttling Component", "Redis", "Backs rate limiting and throttling to protect search performance SLAs.")
}

System_Ext("Core Business Service", "Core Business Service", "Java, Spring Boot")
System_Ext("Search Service", "Search Service", "Elasticsearch")
System_Ext("Redis Cache", "Redis Cache", "Redis")

Rel("SSL/TLS Termination Component", "Authentication & Authorization Component", "Passes decrypted requests", "Internal")
Rel("Authentication & Authorization Component", "Routing & Load Balancing Component", "Forwards validated requests", "Internal")
Rel("Routing & Load Balancing Component", "Core Business Service", "Forwards authenticated traffic", "gRPC")
Rel("Routing & Load Balancing Component", "Search Service", "Forwards search queries", "gRPC")
Rel("Routing & Load Balancing Component", "Redis Cache", "Checks rate limits", "RESP/TCP")

@enduml