@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application container

System_Ext(api_gateway, "API Gateway", "Kong / Nginx", "Acts as API Gateway")

Container_Boundary(web_application, "Web Application") {
    Component(router_layout, "Router / Layout", "React Router", "Manages navigation and layouts for the web application.")
    Component(authentication, "Authentication", "Auth Context / OAuth2 SDK", "Handles authentication and role-based access.")
    Component(catalogue_search, "Catalogue & Search", "React, TypeScript, React Query / SWR", "Provides catalogue and search functionalities with client-side result caching.")
    Component(circulation_self_service, "Circulation & Self-Service", "React, TypeScript", "Manages circulation and self-service portals for patrons and staff.")
}

Rel(router_layout, authentication, "Uses", "HTTPS")
Rel(catalogue_search, api_gateway, "Queries search and catalogue data", "HTTPS/JSON")
Rel(circulation_self_service, api_gateway, "Executes transactions", "HTTPS/JSON")
Rel(web_application, api_gateway, "Sends requests to backend services", "HTTPS/JSON")
@enduml