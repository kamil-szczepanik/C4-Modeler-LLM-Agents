@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Notification Worker", "Notification Worker") {
    Component(Queue Consumer Component, "Queue Consumer Component", "Node.js, amqplib", "Node.js worker consuming background jobs.")
    Component(Template Engine Component, "Template Engine Component", "Handlebars", "Handlebars-based rendering engine.")
    Component(Compliance Sanitizer Component, "Compliance Sanitizer Component", "TypeScript", "TypeScript-based PII masking engine.")
    Component(Dispatcher Client Component, "Dispatcher Client Component", "Axios", "Axios-based HTTP client.")
    Component(Retry & Dead-Letter Handler Component, "Retry & Dead-Letter Handler Component", "Node.js", "Exception and backoff manager.")
}

System_Ext(Notification Service, "Notification Service", "External notification service receiving alerts.")

Rel(Queue Consumer Component, Template Engine Component, "Passes raw event payloads", "In-memory function call")
Rel(Template Engine Component, Compliance Sanitizer Component, "Passes rendered payload", "In-memory function call")
Rel(Compliance Sanitizer Component, Dispatcher Client Component, "Sends sanitized payload", "In-memory function call")
Rel(Dispatcher Client Component, Notification Service, "Sends alerts", "HTTPS")
Rel(Queue Consumer Component, Retry & Dead-Letter Handler Component, "Handles processing exceptions", "AMQP")
@enduml