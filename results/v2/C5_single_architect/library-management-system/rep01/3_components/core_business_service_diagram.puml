@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Business Service container

Container_Boundary(core_business_service, "Core Business Service") {
    Component(CatalogManagementComponent, "Catalog Management Component", "Spring Data JPA", "Manages catalog items and synchronizes item metadata with the search service, while caching hot items.")
    Component(CirculationComponent, "Circulation Component", "Spring Transactions", "Handles library circulation logic and persists transaction states to the database.")
    Component(PaymentIntegrationComponent, "Payment Integration Component", "Spring Cloud OpenFeign", "Processes library fines by communicating with the external payment gateway.")
    Component(SearchIntegrationComponent, "Search Integration Component", "Spring WebClient", "Integrates with search capabilities to support search requirements.")
}

System_Ext(RedisCache, "Redis Cache", "Redis Cache")
System_Ext(Database, "Database", "Database")
System_Ext(ExternalPaymentGateway, "External Payment Gateway", "External Payment Gateway")
System_Ext(SearchService, "Search Service", "Search Service")

Rel(CatalogManagementComponent, RedisCache, "Caches hot catalog items", "TCP/Lettuce")
Rel(CirculationComponent, Database, "Persists transaction states", "TCP/JDBC")
Rel(PaymentIntegrationComponent, ExternalPaymentGateway, "Processes fines", "HTTPS/JSON")
Rel(CatalogManagementComponent, SearchService, "Synchronizes item metadata", "HTTP/REST")

@enduml