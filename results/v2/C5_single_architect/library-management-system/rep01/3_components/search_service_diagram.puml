@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Search Service container

Container_Boundary(search_service, "Search Service") {
    Component(Search_API_Application, "Search API Application", "Java, Spring Boot", "Provides robust backend logic, executes queries against Elasticsearch, and enforces EU data residency.")
    Component(Query_Cache_Layer, "Query Cache Layer", "Local Caffeine cache", "In-memory query cache used to check recent search results and minimize latency.")
}

Rel(Search_API_Application, Query_Cache_Layer, "Checks recent search results", "In-memory Java API")
@enduml