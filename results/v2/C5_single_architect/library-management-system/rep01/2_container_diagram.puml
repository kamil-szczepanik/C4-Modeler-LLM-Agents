@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(Patrons, "Patrons", "Library members who use the self-service portal.")
Person(Librarians, "Librarians", "Staff members who manage cataloguing and circulation.")

System_Ext(PaymentGateway, "Payment Gateway", "External system used for processing payments.")
System_Ext(EBookVendors, "e-Book Vendors", "External vendors providing digital content and e-books.")
System_Ext(NotificationService, "Notification Service", "External service used for sending automated notifications.")
System_Ext(EnterpriseSearchService, "Enterprise Search Service", "External subsystem providing specialized search capabilities.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(WebApplication, "Web Application", "React, TypeScript", "Frontend web application for responsive user interfaces.")
    Container(ApiGateway, "API Gateway", "Kong / Nginx", "Entry point managing routing and security for incoming requests.")
    Container(CoreBusinessService, "Core Business Service", "Java, Spring Boot", "Robust backend handling core cataloguing and circulation business logic.")
    Container(SearchService, "Search Service", "Elasticsearch", "Dedicated search engine ensuring sub-800ms search performance.")
    ContainerDb(Database, "Database", "PostgreSQL", "Primary relational database restricted to EU infrastructure.")
    Container(RedisCache, "Redis Cache", "Redis", "In-memory cache to reduce database load.")
    Container(NotificationWorker, "Notification Worker", "Node.js", "Asynchronous background worker for decoupled notification processing.")
}

Rel(Patrons, WebApplication, "Accesses cataloguing, circulation, and self-service portals", "HTTPS/JSON")
Rel(Librarians, WebApplication, "Manages library cataloguing and system operations", "HTTPS/JSON")
Rel(WebApplication, ApiGateway, "Sends requests to backend services", "HTTPS/JSON")
Rel(ApiGateway, CoreBusinessService, "Routes business requests", "gRPC/REST")
Rel(ApiGateway, SearchService, "Routes search queries", "gRPC/REST")
Rel(CoreBusinessService, Database, "Reads and writes persistent data", "TCP")
Rel(CoreBusinessService, RedisCache, "Caches frequently accessed data", "TCP/RESP")
Rel(CoreBusinessService, PaymentGateway, "Processes financial transactions", "HTTPS")
Rel(NotificationWorker, NotificationService, "Dispatches automated alerts", "HTTPS/AMQP")

@enduml