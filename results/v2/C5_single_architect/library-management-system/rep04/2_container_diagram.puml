@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(LibraryPatron, "Library Patron", "External user interacting via the Self-Service Portal to browse, borrow, and manage their library account.")
Person(LibrarianLibraryStaff, "Librarian / Library Staff", "External user interacting via the Admin Portal to manage cataloging, circulation, and library operations.")

System_Ext(IdentityProviderIdS, "Identity Provider / IdS", "External system for authentication that enforces EU-only data residency for user identities.")
System_Ext(PaymentGateway, "Payment Gateway", "External system for fine processing, handling PCI-DSS scope outside the core boundary.")
System_Ext(NotificationService, "Notification Service", "External system for Email/SMS alerts via SendGrid/Twilio.")
System_Ext(DigitalContentRepositoryDRMProvider, "Digital Content Repository / DRM Provider", "External system providing e-books and audiobooks.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(WebApplication, "Web Application", "React, TypeScript", "Powers the frontend web application container for users.")
    Container(APIGateway, "API Gateway", "Kong or NGINX", "API Gateway for secure routing, SSL termination, and rate limiting.")
    Container(CoreDomain, "Core Domain", "Java, Spring Boot", "Implements the reliable Core Domain container logic.")
    Container(SearchEngine, "Search Engine", "Elasticsearch", "Dedicated engine to meet the sub-800ms search latency requirement.")
    Container(IntegrationWorker, "Integration Worker", "Node.js / Python", "Handles external integrations and asynchronous tasks.")
    Container(MessageBroker, "Message Broker", "RabbitMQ", "Asynchronous message broker to decouple workflows and integrations.")
    ContainerDb(PostgreSQLDatabase, "PostgreSQL Database", "PostgreSQL", "EU-hosted relational database for transactional data integrity.")
}

Rel(LibraryPatron, WebApplication, "Accesses Self-Service Portal", "HTTPS")
Rel(LibrarianLibraryStaff, WebApplication, "Accesses Admin Portal", "HTTPS")
Rel(WebApplication, APIGateway, "Routes requests", "HTTPS/REST and WebSockets")
Rel(APIGateway, CoreDomain, "Proxies internal requests", "gRPC and internal REST")
Rel(CoreDomain, PostgreSQLDatabase, "Reads and writes transactional data", "native TCP drivers over TLS")
Rel(CoreDomain, SearchEngine, "Queries catalog data", "native TCP drivers over TLS")
Rel(CoreDomain, MessageBroker, "Publishes and consumes messages", "AMQP over TLS")
Rel(IntegrationWorker, PaymentGateway, "Processes fine payments", "HTTPS/REST")
Rel(IntegrationWorker, NotificationService, "Sends alerts and notifications", "HTTPS/REST")

@enduml