@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Library Patron, "Library Patron", "External user interacting via the Self-Service Portal to browse, borrow, and manage their library account.")
Person(Librarian / Library Staff, "Librarian / Library Staff", "External user interacting via the Admin Portal to manage cataloging, circulation, and library operations.")
System(Library Management System, "Library Management System", "A comprehensive platform designed for public and academic libraries to catalogue items, manage circulation, and provide self-service portals, ensuring EU-only data residency and high-performance catalog searches.")
System_Ext(Identity Provider / IdS, "Identity Provider / IdS", "External system for authentication that enforces EU-only data residency for user identities.")
System_Ext(Payment Gateway, "Payment Gateway", "External system for fine processing, handling PCI-DSS scope outside the core boundary.")
System_Ext(Notification Service, "Notification Service", "External system for Email/SMS alerts via SendGrid/Twilio.")
System_Ext(Digital Content Repository / DRM Provider, "Digital Content Repository / DRM Provider", "External system providing e-books and audiobooks.")

Rel(Library Patron, Library Management System, "Accesses the Self-Service Portal", "HTTPS")
Rel(Librarian / Library Staff, Library Management System, "Accesses the Admin Portal", "HTTPS")
Rel(Library Management System, Payment Gateway, "Processes fines", "HTTPS/REST")
Rel(Library Management System, Notification Service, "Sends Email/SMS alerts", "HTTPS/REST API")
Rel(Library Management System, Digital Content Repository / DRM Provider, "Retrieves e-books, audiobooks, and verifies licenses", "HTTPS/REST and LTI/OAuth")
@enduml