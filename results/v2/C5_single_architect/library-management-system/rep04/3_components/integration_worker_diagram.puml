@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Worker container

System_Ext(Message_Broker, "Message Broker", "RabbitMQ message broker")
System_Ext(Payment_Gateway, "Payment Gateway", "External payment provider")
System_Ext(Notification_Service, "Notification Service", "External notification service")

Container_Boundary(Integration_Worker, "Integration Worker") {
    Component(Message_Consumer, "Message Consumer", "Node.js with TypeScript, BullMQ", "Subscribes to events from the Message Broker.")
    Component(Payment_Integrator, "Payment Integrator", "Node.js with TypeScript, HTTPS/REST", "Communicates with the Payment Gateway.")
    Component(Notification_Integrator, "Notification Integrator", "Node.js with TypeScript, HTTPS/REST", "Handles payload mapping and delivery to the Notification Service.")
    Component(Retry_Dead_Letter_Handler, "Retry & Dead-Letter Handler", "Node.js with TypeScript, BullMQ", "Manages transient failures and unprocessable messages.")
    Component(Webhook_Receiver, "Webhook Receiver", "Node.js with TypeScript, HTTPS/REST", "Ingests asynchronous callbacks from external systems.")
}

Rel(Message_Consumer, Message_Broker, "Subscribes to events", "AMQP")
Rel(Payment_Integrator, Payment_Gateway, "Processes fine payments", "HTTPS/REST")
Rel(Notification_Integrator, Notification_Service, "Sends alerts", "HTTPS/REST")
Rel(Webhook_Receiver, Payment_Gateway, "Ingests callbacks", "HTTPS/REST")

@enduml