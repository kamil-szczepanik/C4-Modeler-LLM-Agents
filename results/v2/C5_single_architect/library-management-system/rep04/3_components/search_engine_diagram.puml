@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Search Engine container

System(CoreDomain, "Core Domain", "Core Domain system")
System(MessageBroker, "Message Broker", "Message Broker system")

Container_Boundary(SearchEngine, "Search Engine") {
    Component(QueryParser, "Query Parser", "Elasticsearch Java Client / Elasticsearch Query DSL", "Sanitizes and translates search requests using Elasticsearch Query DSL.")
    Component(IndexingWorker, "Indexing Worker", "Elasticsearch", "Consumes synchronization events to update the index.")
    ComponentDb(SearchIndex, "Search Index (Storage Node)", "Lucene / LUKS", "Lucene-based storage node enforcing EU data residency with disk encryption at rest.")
    Component(RankingRelevanceTuner, "Ranking & Relevance Tuner", "Internal Lucene API", "Applies custom scoring scripts and synonym mappings.")
}

Rel(CoreDomain, QueryParser, "Submits search requests", "HTTP/JSON over TLS via Elasticsearch Java Client")
Rel(MessageBroker, IndexingWorker, "Streams catalog sync events", "AMQP")
Rel(QueryParser, RankingRelevanceTuner, "Applies custom scoring and boosts", "Internal Lucene API")
Rel(QueryParser, SearchIndex, "Executes low-latency index lookups", "Internal Java Transport / Lucene API")

@enduml