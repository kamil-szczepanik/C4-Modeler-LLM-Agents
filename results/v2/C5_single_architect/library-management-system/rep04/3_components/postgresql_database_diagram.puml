@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Core_Domain, "Core Domain", "Java and Spring Boot backend container.")
System_Ext(Integration_Worker, "Integration Worker", "Node.js or Python background worker.")

Container_Boundary(postgresql_database, "PostgreSQL Database") {
    Component(Relational_Schema_Engine, "Relational Schema Engine", "PostgreSQL", "Houses relational data and performs asynchronous bulk updates.")
    Component(Full_Text_Search_Index, "Full-Text Search Index", "pg_trgm", "Provides fast exact-match lookups and search capabilities.")
    Component(Audit___Data_Residency_Enforcement_Module, "Audit & Data Residency Enforcement Module", "PostgreSQL Module", "Ensures strict compliance with EU-only data residency constraints.")
    Component(Connection_Pooler, "Connection Pooler", "PgBouncer", "Manages database connection limits to sustain peak transactional throughput.")
}

Rel(Core_Domain, Connection_Pooler, "Manages pooled SQL transactions", "JDBC over TLS 1.3")
Rel(Integration_Worker, Relational_Schema_Engine, "Performs asynchronous bulk updates", "native PostgreSQL wire protocol")
Rel(Core_Domain, postgresql_database, "Reads and writes transactional data", "native TCP drivers over TLS")

@enduml