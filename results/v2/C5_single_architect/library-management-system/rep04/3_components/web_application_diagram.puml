@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(web_application, "Web Application") {
    Component(RoutingShellComponent, "Routing & Shell Component", "React, TypeScript", "Delegates views and provides structured SPA navigation and shell layout.")
    Component(CatalogSearchComponent, "Catalog & Search Component", "React, TypeScript, TanStack Query", "Handles catalog discovery and search with client-side caching and input debouncing.")
    Component(CirculationSelfServiceComponent, "Circulation & Self-Service Component", "React, TypeScript", "Manages circulation and self-service portal interactions for patrons and librarians.")
    Component(ApiClientService, "API Client Service", "Axios, Fetch, WebSockets", "Handles HTTP transport and streams real-time notifications via WebSockets.")
}

Rel(RoutingShellComponent, CatalogSearchComponent, "Delegates views", "HTTPS")
Rel(RoutingShellComponent, CirculationSelfServiceComponent, "Delegates views", "HTTPS")
Rel(CatalogSearchComponent, ApiClientService, "Fetches data", "HTTPS/REST")
Rel(CirculationSelfServiceComponent, ApiClientService, "Communicates with backend", "HTTPS/REST and WebSockets")

@enduml