@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Domain container

Container_Boundary(core_domain, "Core Domain") {
    Component(CatalogManagementComponent, "Catalog Management Component", "Spring Boot / Spring Data JPA", "Handles physical and digital item cataloguing (R-01).")
    Component(CirculationEngineComponent, "Circulation Engine Component", "Spring Boot / Spring TX", "Manages loans, reservations, and business invariants.")
    Component(EventPublisherComponent, "Event Publisher Component", "Spring AMQP", "Asynchronously emits domain events using Spring AMQP.")
    Component(SearchSynchronizerComponent, "Search Synchronizer Component", "Spring Boot", "Updates the search index to achieve < 800 ms search responses (R-05).")
    Component(PostgreSQLDatabase, "PostgreSQL Database", "PostgreSQL", "Stores transactional domain data locally.")
    Component(SearchEngine, "Search Engine", "Elasticsearch", "Externalized index providing fast catalog queries.")
    Component(MessageBroker, "Message Broker", "AMQP Broker", "Handles asynchronous message distribution.")
}

Rel(CatalogManagementComponent, PostgreSQLDatabase, "Reads and writes transactional data via native TCP drivers over TLS enforcing EU-only data residency.")
Rel(CirculationEngineComponent, PostgreSQLDatabase, "Reads and writes transactional data via native TCP drivers over TLS enforcing EU-only data residency.")
Rel(CirculationEngineComponent, EventPublisherComponent, "Communicates via in-process Spring Beans and direct method calls.")
Rel(EventPublisherComponent, MessageBroker, "Publishes domain events via AMQP over TLS.")
Rel(CatalogManagementComponent, SearchSynchronizerComponent, "Triggers indexing updates via direct method calls.")
Rel(SearchSynchronizerComponent, SearchEngine, "Updates indices via native TCP drivers over TLS.")

@enduml