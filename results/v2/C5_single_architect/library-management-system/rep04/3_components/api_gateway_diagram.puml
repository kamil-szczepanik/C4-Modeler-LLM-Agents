@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(routing_proxy, "Routing & Proxy Engine", "Kong/NGINX Core", "Proxies internal traffic to core domain and search engine.")
    Component(auth_filter, "Authentication & Authorization Filter", "Lua/OpenResty, JWT", "Validates requests and enforces authentication.")
    Component(rate_limit, "Rate Limiting & Throttling Module", "Redis-backed", "Handles rate limiting and throttling for API requests.")
    Component(ssl_term, "SSL/TLS Termination & Security Headers Module", "OpenSSL/NGINX", "Entry point for traffic, handles SSL/TLS termination and security headers.")
    Component(transform_analytics, "Request Transformation & Analytics Filter", "Lua/Go", "Transforms requests and collects analytics.")
}

Rel(ssl_term, auth_filter, "Forwards decrypted traffic")
Rel(auth_filter, routing_proxy, "Forwards validated requests")

@enduml