@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Core_Domain, "Core Domain", "External system representing the core domain.")
System_Ext(Integration_Worker, "Integration Worker", "External container for processing messages.")
System_Ext(PostgreSQL_Database, "PostgreSQL Database", "Relational database for persistent storage.")

Container_Boundary(Message_Broker, "Message Broker") {
    Component(Exchange_Router, "Exchange Router", "RabbitMQ Direct/Topic Exchanges", "Directs incoming messages using RabbitMQ Direct/Topic Exchanges.")
    Component(Queue_Manager, "Queue Manager", "RabbitMQ Quorum Queues", "Manages durable message queues via RabbitMQ Quorum Queues.")
    Component(Connection_Security_Manager, "Connection & Security Manager", "TLS 1.3, x.509/PLAIN auth", "Handles authentication and TLS termination using TLS 1.3 and x.509/PLAIN auth.")
    Component(Dead_Letter_Handler, "Dead Letter Handler", "RabbitMQ Dead Letter Exchanges (DLX)", "Captures failed messages using RabbitMQ Dead Letter Exchanges (DLX).")
}

Rel(Core_Domain, Exchange_Router, "Publishes domain events", "AMQP 0-9-1 over TLS")
Rel(Exchange_Router, Queue_Manager, "Routes events to queues", "AMQP internal")
Rel(Queue_Manager, Integration_Worker, "Delivers messages for processing", "AMQP 0-9-1 over TLS")
Rel(Queue_Manager, Dead_Letter_Handler, "Forwards failed messages", "AMQP internal")
Rel(Dead_Letter_Handler, PostgreSQL_Database, "Persists failed messages for audit/replay", "JDBC over TLS")
@enduml