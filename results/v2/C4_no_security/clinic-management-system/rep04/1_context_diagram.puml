@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Clinic Management System

Person(Patients, "Patients", "Individuals receiving care who interact with the clinic management system.")
Person(Receptionists, "Receptionists", "Staff members managing patient admissions and scheduling.")
Person(Clinicians, "Clinicians", "Medical professionals managing EMRs and patient care.")
Person(BillingSpecialists, "Billing Specialists", "Personnel handling financial transactions and insurance billing.")

System(ClinicManagementSystem, "Clinic Management System", "System manages patient admissions, EMRs, scheduling, and billing for clinics with high availability and strict HIPAA/GDPR compliance.")

System_Ext(IdentityProvider, "Identity Provider", "Authentication service such as Azure AD or Okta.")
System_Ext(ThirdPartyPaymentGatewayInsuranceClearinghouse, "Third-Party Payment Gateway & Insurance Clearinghouse", "External services for processing payments and insurance claims.")
System_Ext(ExternalLabImagingSystems, "External Lab & Imaging Systems", "External medical systems exchanging health data.")

Rel(Patients, ClinicManagementSystem, "Interacts with the clinic management system", "HTTPS / Web Protocols")
Rel(Receptionists, ClinicManagementSystem, "Interacts with the clinic management system", "HTTPS / Web Protocols")
Rel(Clinicians, ClinicManagementSystem, "Interacts with the clinic management system", "HTTPS / Web Protocols")
Rel(BillingSpecialists, ClinicManagementSystem, "Interacts with the clinic management system", "HTTPS / Web Protocols")

Rel(ClinicManagementSystem, IdentityProvider, "Authenticates users via OpenID Connect / SAML", "OpenID Connect / SAML")
Rel(ClinicManagementSystem, ThirdPartyPaymentGatewayInsuranceClearinghouse, "Processes payments and claims", "HTTPS REST APIs")
Rel(ClinicManagementSystem, ExternalLabImagingSystems, "Exchanges health data via HL7 FHIR", "HL7 FHIR REST APIs over TLS 1.3")

@enduml