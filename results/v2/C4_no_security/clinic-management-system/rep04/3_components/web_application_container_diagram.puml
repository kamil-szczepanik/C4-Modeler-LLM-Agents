@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application Container container

System_Ext(IdentityProvider, "Identity Provider", "Manages user authentication and issues tokens.")
System_Ext(APIGateway, "API Gateway", "API Gateway (Envoy/NGINX) routing incoming requests.")

Container_Boundary(Web_Application_Container, "Web Application Container") {
    Component(Routing__Layout_Component, "Routing & Layout Component", "React / Next.js", "Handles routing, page layouts, and responsive clinician dashboards with SSR/SSG.")
    Component(Authentication__Session_Component, "Authentication & Session Component", "React / Next.js / TypeScript", "Manages user authentication sessions and token exchange with the Identity Provider via OAuth2/OIDC.")
    Component(Feature_Modules, "Feature Modules", "React / TypeScript", "Implements core patient admissions, medical records, scheduling, and billing feature logic.")
    Component(API_Client_Component, "API Client Component", "TypeScript / Fetch/Axios", "Communicates securely via HTTPS with the API Gateway.")
    Component(State_Management__Caching_Component, "State Management & Caching Component", "React Query / Zustand", "Manages local client state and caching to minimize network round-trips.")
}

Rel(Authentication__Session_Component, IdentityProvider, "Token exchange", "OAuth2/OIDC")
Rel(Feature_Modules, State_Management__Caching_Component, "Reads/writes state", "In-Memory")
Rel(API_Client_Component, APIGateway, "Sends user requests", "HTTPS")
Rel(Routing__Layout_Component, Feature_Modules, "Renders")
Rel(Feature_Modules, API_Client_Component, "Fetches data via")

@enduml