@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(hl7_fhir_integration_container, "HL7 FHIR Integration Container") {
    Component(FHIR_API_Route_Controller, "FHIR API Route Controller", "Apache Camel", "Handles incoming FHIR API routes and requests.")
    Component(Data_Transformation_Mapping_Engine, "Data Transformation & Mapping Engine", "HAPI FHIR / Java", "Performs schema validation and resource mapping for clinical interoperability.")
    Component(Dead_Letter_Retry_Manager, "Dead-Letter & Retry Manager", "Apache Camel / Resilience4j", "Manages failed message routing, retries, and dead-letter queues.")
    Component(External_Connector_Client, "External Connector Client", "HTTPS / TLS 1.3 / mTLS", "Communicates securely with external Lab & Imaging Systems using HL7 FHIR APIs.")
    Component(Audit_Compliance_Publisher_Component, "Audit & Compliance Publisher Component", "JDBC / TLS", "Publishes audit events and compliance data to the Primary DB & Audit Store.")
}

System_Ext(Primary_DB_Audit_Store, "Primary DB & Audit Store", "PostgreSQL with Patroni")

Rel(FHIR_API_Route_Controller, Data_Transformation_Mapping_Engine, "Routes payloads for validation and mapping")
Rel(Data_Transformation_Mapping_Engine, External_Connector_Client, "Sends transformed FHIR resources to external labs")
Rel(FHIR_API_Route_Controller, Dead_Letter_Retry_Manager, "Handles message delivery failures")
Rel(Audit_Compliance_Publisher_Component, Primary_DB_Audit_Store, "Publishes audit event logs", "JDBC / TLS")

@enduml