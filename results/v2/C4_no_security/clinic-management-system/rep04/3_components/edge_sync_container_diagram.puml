@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(edge_sync_container, "Edge Sync Container") {
    Component(Outbox_Poller, "Outbox Poller", "Go Daemon", "Reads un-synced events from the Primary DB & Audit Store using the transactional outbox pattern.")
    Component(Encryption___Transformer, "Encryption & Transformer", "Go Daemon", "Encrypts and transforms offline patient care and transactional data for secure transmission.")
    Component(Cloud_Sync_Client, "Cloud Sync Client", "Go Daemon / gRPC over mTLS", "Syncs encrypted data to the cloud tier over secure channels.")
    Component(DLQ___Spool_Manager, "DLQ & Spool Manager", "Go Daemon / Local Disk Spooling", "Manages local disk spooling and dead-letter queues to ensure offline resilience and fault tolerance.")
}

Rel(Outbox_Poller, Encryption___Transformer, "Passes un-synced events")
Rel(Encryption___Transformer, Cloud_Sync_Client, "Sends encrypted payloads")
Rel(Cloud_Sync_Client, DLQ___Spool_Manager, "Handles delivery failures and spools data")

@enduml