@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(tls_termination, "TLS Termination", "Envoy / NGINX", "Handles secure HTTPS connections and terminates Transport Layer Security.")
    Component(auth_filter, "Auth Filter", "Envoy / NGINX Filter", "Validates JWT tokens and authenticates incoming requests.")
    Component(rate_limiter, "Rate Limiter", "Envoy / NGINX Filter", "Checks usage counters against Redis to enforce API traffic limits.")
    Component(dynamic_router, "Dynamic Router", "Envoy / NGINX", "Routes validated and prioritized traffic to internal containers.")
    Component(qos_filter, "QOS Filter", "Envoy / NGINX Filter", "Manages quality of service and request prioritization.")
    Component(circuit_breaker, "Circuit Breaker", "Envoy / NGINX", "Prevents cascading failures by monitoring downstream container health.")
}

System_Ext(redis_cache_cluster, "Redis Cache Cluster", "In-memory data store used for rate limiting.")

Rel(rate_limiter, redis_cache_cluster, "Checks usage counters", "gRPC / Redis Protocol, <2ms latency")

@enduml