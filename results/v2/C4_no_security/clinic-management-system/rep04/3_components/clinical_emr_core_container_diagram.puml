@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(clinical_emr_core_container, "Clinical & EMR Core Container") {
    Component(patient_demographic_service, "Patient Demographic Service", "Spring Boot / Java", "Manages and retrieves patient demographic information.")
    Component(scheduling_engine, "Scheduling Engine", "Spring Boot / Java", "Handles appointment scheduling and clash checks.")
    Component(emr_management_service, "EMR Management Service", "Spring Boot / Java", "Manages electronic medical records operations.")
    Component(audit_compliance_interceptor, "Audit & Compliance Interceptor", "Spring Boot / Java (AOP)", "Ensures HIPAA/GDPR compliance via asynchronous auditing.")
    Component(local_state_cache_sync_coordinator, "Local State Cache & Sync Coordinator", "Caffeine Cache & Embedded RocksDB", "Provides transient local state cache for offline resilience.")
}

Rel(emr_management_service, local_state_cache_sync_coordinator, "Accesses cached patient data", "In-Memory / Local IPC")

@enduml