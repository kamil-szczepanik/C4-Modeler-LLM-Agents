@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing & Claims Container container

Person(BillingSpecialists, "Billing Specialists", "Billing Specialists (Users)")
System_Ext(API Gateway, "API Gateway", "Network Gateway")
System_Ext(ThirdPartyPaymentGatewayInsuranceClearinghouse, "Third-Party Payment Gateway & Insurance Clearinghouse", "External Systems")

Container_Boundary(BillingClaimsContainer, "Billing & Claims Container") {
    Component(BillingAPIController, "Billing API Controller", "Express.js", "Billing API Controller")
    Component(ClaimValidationMappingEngine, "Claim Validation & Mapping Engine", "TypeScript / AJV", "Claim Validation & Mapping Engine")
    Component(PaymentClearinghouseIntegrationService, "Payment & Clearinghouse Integration Service", "Axios / Node SDKs", "Payment & Clearinghouse Integration Service")
    Component(IdempotentDispatcherMiddleware, "Idempotent Dispatcher Middleware", "Node.js / Express Middleware", "Idempotent Dispatcher Middleware")
    Component(TransactionDLQManager, "Transaction & DLQ Manager", "Node.js", "Transaction & DLQ Manager")
    Component(LedgerAuditWriter, "Ledger & Audit Writer", "TypeORM", "Ledger & Audit Writer")
    ComponentDb(PrimaryDBAuditStore, "Primary DB & Audit Store", "PostgreSQL with Patroni", "Primary DB & Audit Store")
}

Rel(API Gateway, BillingAPIController, "Routes validated requests", "TLS / JWT / HTTP")
Rel(BillingAPIController, ClaimValidationMappingEngine, "Passes billing data for validation", "Internal Function Call")
Rel(PaymentClearinghouseIntegrationService, ThirdPartyPaymentGatewayInsuranceClearinghouse, "Processes co-pays and balances / Submits insurance claims", "HTTPS / REST")
Rel(TransactionDLQManager, LedgerAuditWriter, "Logs transactions and failed payloads", "Internal Function Call")
Rel(LedgerAuditWriter, PrimaryDBAuditStore, "Enforces ACID-compliant writes", "PostgreSQL Protocol, AES-256")

@enduml