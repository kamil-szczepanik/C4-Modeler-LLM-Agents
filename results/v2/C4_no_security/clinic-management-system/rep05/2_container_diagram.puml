@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Receptionists, "Receptionists", "Front desk staff managing patient admissions and scheduling.")
Person(Clinicians, "Clinicians", "Medical professionals managing electronic medical records and clinical operations.")
Person(Billing Specialists, "Billing Specialists", "Staff handling financial operations, billing, and insurance claims.")
Person(Compliance Officers, "Compliance Officers", "Personnel ensuring regulatory adherence, HIPAA/GDPR compliance, and auditing.")
Person(Patients, "Patients", "Healthcare consumers interacting with clinic services.")

System_Ext(Lab & Imaging Systems, "Lab & Imaging Systems", "External systems providing laboratory results and medical imaging.")
System_Ext(Insurance Clearinghouses, "Insurance Clearinghouses", "External entities processing insurance claims and financial clearing.")
System_Ext(Enterprise IdP, "Enterprise IdP", "Identity provider managing authentication and authorization.")
System_Ext(Patient Portal, "Patient Portal", "External portal for self-service and patient engagement.")

System_Boundary(Clinic Management System, "Clinic Management System") {
    Container(SPA Frontend, "SPA Frontend", "React, TypeScript, Nginx", "Provides rapid UI rendering for users to interact with the system.")
    Container(EMR Core Service, "EMR Core Service", "Spring Boot, Java", "Manages electronic medical records and sub-second clinical performance.")
    Container(Billing & Claims Service, "Billing & Claims Service", "Spring Boot, Java", "Handles financial operations, billing, and insurance claims.")
    Container(Audit & Compliance Service, "Audit & Compliance Service", "Spring Boot, Java", "Ensures strict HIPAA/GDPR compliance and handles audit logging.")
    Container(Integration Gateway, "Integration Gateway", "Apache Camel, Spring Cloud Gateway", "Facilitates HL7 FHIR APIs and interoperability with external systems.")
    ContainerDb(PostgreSQL, "PostgreSQL", "PostgreSQL with Patroni, primary-replica", "Primary database for persistent healthcare data and state.")
    ContainerDb(Redis Cluster, "Redis Cluster", "Redis Cluster", "Provides low-latency EMR caching and data integrity.")
    Container(Apache Kafka, "Apache Kafka", "Apache Kafka", "Handles asynchronous event streaming across microservices.")
}

Rel(Receptionists, SPA Frontend, "Accesses patient admissions and scheduling", "HTTPS / WSS")
Rel(Clinicians, SPA Frontend, "Manages electronic medical records and clinical workflows", "HTTPS / WSS")
Rel(Billing Specialists, SPA Frontend, "Processes billing and financial records", "HTTPS / WSS")
Rel(Compliance Officers, SPA Frontend, "Reviews audit logs and compliance data", "HTTPS / WSS")
Rel(Patients, SPA Frontend, "Interacts with clinical services", "HTTPS / WSS")

Rel(SPA Frontend, EMR Core Service, "Requests EMR data and operations", "HTTPS / WSS")
Rel(SPA Frontend, Billing & Claims Service, "Requests billing data and operations", "HTTPS / WSS")
Rel(SPA Frontend, Audit & Compliance Service, "Sends audit and compliance queries", "HTTPS / WSS")

Rel(EMR Core Service, Billing & Claims Service, "Communicates internal service workflows", "gRPC over mTLS with eBPF routing")
Rel(EMR Core Service, Audit & Compliance Service, "Sends audit events", "gRPC over mTLS with eBPF routing")
Rel(Billing & Claims Service, Audit & Compliance Service, "Sends audit events", "gRPC over mTLS with eBPF routing")

Rel(Integration Gateway, Lab & Imaging Systems, "Exchanges lab orders and imaging data", "HL7 FHIR APIs over HTTPS")
Rel(Integration Gateway, Insurance Clearinghouses, "Exchanges insurance claims", "HL7 FHIR APIs over HTTPS")

Rel(EMR Core Service, PostgreSQL, "Reads and writes relational data", "TCP with AES-256 encryption at rest")
Rel(Billing & Claims Service, PostgreSQL, "Reads and writes billing data", "TCP with AES-256 encryption at rest")
Rel(Audit & Compliance Service, PostgreSQL, "Stores audit logs", "TCP with AES-256 encryption at rest")

Rel(EMR Core Service, Redis Cluster, "Caches EMR data for low latency", "TCP with AES-256 encryption at rest")

Rel(EMR Core Service, Apache Kafka, "Streams clinical events", "TCP event streaming")
Rel(Billing & Claims Service, Apache Kafka, "Streams billing events", "TCP event streaming")
Rel(Audit & Compliance Service, Apache Kafka, "Streams audit events", "TCP event streaming")

@enduml