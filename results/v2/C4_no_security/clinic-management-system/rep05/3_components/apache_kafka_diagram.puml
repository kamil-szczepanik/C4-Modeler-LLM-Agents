@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Apache Kafka container

Container_Boundary(apache_kafka, "Apache Kafka") {
    Component(Apache_Kafka_Broker_Cluster, "Apache Kafka Broker Cluster", "KRaft mode, Strimzi Operator", "Delivers scalable event streaming with high availability on Kubernetes.")
    Component(Schema_Registry, "Schema Registry", "Confluent Schema Registry, Avro/Protobuf", "Enforces schema validation and schema evolution.")
    Component(Kafka_Connect, "Kafka Connect", "Kafka Connect", "Connects Kafka data with external systems like PostgreSQL.")
    Component(Kafka_Interceptor, "Kafka Interceptor", "Kafka Interceptor", "Intercepts and processes message streams.")
    Component(Kafka_ACL_RBAC_Authorizer, "Kafka ACL & RBAC Authorizer", "Apache Ranger", "Ensures strict data governance and RBAC security.")
}

Component(EMR_Core_Service_Billing_Service, "EMR Core Service & Billing Service", "Spring Boot, Java", "Streams clinical and billing events")
Component(PostgreSQL, "PostgreSQL", "PostgreSQL", "Persists audit trails and long-term data")

Rel(Schema_Registry, Apache_Kafka_Broker_Cluster, "Enforces schema validation", "HTTP/REST")
Rel(EMR_Core_Service_Billing_Service, Apache_Kafka_Broker_Cluster, "Streams clinical and billing events", "TCP, Kafka Wire Protocol")
Rel(Kafka_Connect, PostgreSQL, "Persists audit trails and long-term data to PostgreSQL", "JDBC/TCP")

@enduml