@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing & Claims Service container

Component(SPA_Frontend, "SPA Frontend", "React, TypeScript, Nginx", "External frontend requesting billing data and operations.")
System_Ext(External_Insurance_Clearinghouses, "External Insurance Clearinghouses", "HTTPS / REST over TLS 1.3", "Receives submitted claims.")
System_Ext(Apache_Kafka, "Apache Kafka", "TCP event streaming", "Streams billing events and handles cache invalidation messaging.")
System_Ext(PostgreSQL, "PostgreSQL", "PostgreSQL with Patroni", "Primary-replica relational data storage with AES-256 encryption at rest.")

Container_Boundary(Billing_Claims_Service, "Billing & Claims Service") {
    Component(Billing_Controller, "Billing Controller", "Spring MVC / WebFlux", "Manages asynchronous and synchronous endpoints for billing operations.")
    Component(Payment_Gateway_Module, "Payment Gateway Module", "Spring WebFlux", "Triggers payment processing.")
    Component(Claim_Generation_Scrubbing_Engine, "Claim Generation & Scrubbing Engine", "Spring Integration / Drools", "Powers the claim scrubbing engine and handles claim generation.")
    Component(Payer_Rule_Management_Component, "Payer Rule Management Component", "Spring Data JPA / Redis", "Fetches active rules using low-latency rule evaluation.")
    Component(Insurance_Clearinghouse_Adapter, "Insurance Clearinghouse Adapter", "Spring Cloud OpenFeign / Resilience4j", "Handles resilient external communication for submitting claims.")
}

Rel(SPA_Frontend, Billing_Controller, "Requests billing data and operations", "HTTPS / WSS")
Rel(Billing_Controller, Payment_Gateway_Module, "Triggers payment processing", "Synchronous REST / HTTPS")
Rel(Claim_Generation_Scrubbing_Engine, Payer_Rule_Management_Component, "Fetches active rules", "In-memory cache read / Redis")
Rel(Claim_Generation_Scrubbing_Engine, Insurance_Clearinghouse_Adapter, "Internal handoff", "In-memory / Java Method")
Rel(Insurance_Clearinghouse_Adapter, External_Insurance_Clearinghouses, "Submits claims", "HTTPS / REST over TLS 1.3")
Rel(Billing_Claims_Service, Apache_Kafka, "Streams billing events", "TCP event streaming")
Rel(Billing_Claims_Service, PostgreSQL, "Reads and writes billing data", "TCP with AES-256 encryption at rest")

@enduml