@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Gateway container

Container_Boundary(integration_gateway, "Integration Gateway") {
    Component(routing_load_balancer_router, "Routing & Load Balancer Router", "Spring Cloud Gateway", "Manages dynamic routing and rate limiting with high performance.")
    Component(protocol_translation_engine, "Protocol Translation Engine", "Apache Camel", "Handles complex protocol translation between internal models and external FHIR standards.")
    Component(edge_security_audit_interceptor, "Edge Security & Audit Interceptor", "Spring Security, OpenTelemetry", "Enforces edge security and enables distributed tracing across the hybrid boundary.")
    Component(resilience_circuit_breaker_manager, "Resilience & Circuit Breaker Manager", "Resilience4j", "Provides circuit breakers and bulkheading for outbound routes.")
    Component(telemetry_publisher, "Telemetry Publisher", "OpenTelemetry", "Publishes telemetry data for distributed tracing and monitoring.")
}

System_Ext(lab_imaging_systems, "Lab & Imaging Systems", "External Lab & Imaging Systems")
System_Ext(insurance_clearinghouses, "Insurance Clearinghouses", "External Insurance Clearinghouses")
System_Ext(apache_kafka, "Apache Kafka", "Messaging backbone")
System_Ext(redis_cluster, "Redis Cluster", "Caching and session store")

Rel(routing_load_balancer_router, protocol_translation_engine, "Routes requests for translation", "Internal Routing")
Rel(protocol_translation_engine, lab_imaging_systems, "Exchanges lab orders and imaging data", "HL7 FHIR APIs over HTTPS")
Rel(protocol_translation_engine, insurance_clearinghouses, "Exchanges insurance claims", "HL7 FHIR APIs over HTTPS")
Rel(protocol_translation_engine, apache_kafka, "Publishes integration events", "Async / Kafka Protocol")
Rel(routing_load_balancer_router, redis_cluster, "Caches OAuth2 tokens and rate-limiting counters", "Redis Protocol over TCP")
Rel(edge_security_audit_interceptor, redis_cluster, "Validates tokens against cache", "Redis Protocol over TCP")
Rel(resilience_circuit_breaker_manager, protocol_translation_engine, "Protects outbound routes", "Resilience4j")

@enduml