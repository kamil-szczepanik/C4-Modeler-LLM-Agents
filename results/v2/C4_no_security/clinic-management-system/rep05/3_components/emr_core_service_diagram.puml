@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the EMR Core Service container

Container_Boundary(emr_core_service, "EMR Core Service") {
    Component(Clinical_Data_Controller, "Clinical Data Controller", "Spring Boot (Java)", "Handles incoming requests related to clinical data and EMR operations.")
    Component(EMR_Business_Logic_Engine, "EMR Business Logic Engine", "Spring Boot (Java)", "Executes core business rules, patient admissions logic, and scheduling workflows.")
    Component(Audit_Interceptor, "Audit Interceptor", "Spring Boot (Java)", "Intercepts operations to capture and route audit events for compliance.")
    Component(Data_Access_Repository, "Data Access Repository", "Spring Boot (Java), Resilience4j", "Manages data persistence, retrieval, and caching interactions with resilience patterns.")
    Component(Clinical_Notification_Dispatcher, "Clinical Notification Dispatcher", "Spring Boot (Java)", "Dispatches clinical notifications and alerts via event streams.")
    Component(FHIR_Mapping_Interoperability_Component, "FHIR Mapping & Interoperability Component", "Spring Boot (Java)", "Maps internal models to FHIR standards for healthcare interoperability and lab/imaging handoffs.")
}

System_Ext(PostgreSQL, "PostgreSQL", "Relational storage")
System_Ext(Redis_Cluster, "Redis Cluster", "Caching layer")
System_Ext(Apache_Kafka, "Apache Kafka", "Event streaming platform")

Rel(Clinical_Data_Controller, EMR_Business_Logic_Engine, "Delegates request processing")
Rel(EMR_Business_Logic_Engine, Data_Access_Repository, "Queries and persists data")
Rel(EMR_Business_Logic_Engine, Audit_Interceptor, "Triggers compliance audit events")
Rel(EMR_Business_Logic_Engine, Clinical_Notification_Dispatcher, "Triggers event dispatch")
Rel(EMR_Business_Logic_Engine, FHIR_Mapping_Interoperability_Component, "Transforms clinical data to FHIR standards")
Rel(Data_Access_Repository, PostgreSQL, "Relational storage", "TCP with AES-256 encryption at rest")
Rel(Data_Access_Repository, Redis_Cluster, "Caching layer", "TCP with AES-256 encryption at rest")
Rel(Clinical_Notification_Dispatcher, Apache_Kafka, "Event streaming and lab/imaging handoffs", "TCP event streaming")
Rel(FHIR_Mapping_Interoperability_Component, Apache_Kafka, "Event streaming and lab/imaging handoffs", "TCP event streaming")

@enduml