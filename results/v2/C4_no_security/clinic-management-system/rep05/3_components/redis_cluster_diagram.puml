@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Redis Cluster container

Container_Boundary(redis_cluster, "Redis Cluster") {
    Component(RedisMasterNodes, "Redis Master Nodes", "Redis 7.x", "Handling write operations via Raft-based consensus, native TLS 1.3 support, and low-latency EMR requirements.")
    Component(RedisReplicaNodesClusterReplicas, "Redis Replica Nodes / Cluster Replicas", "Redis 7.x Replication", "Providing synchronous/asynchronous replication for failover and zero data loss.")
    Component(RedisActiveActiveCRDT, "Redis Active-Active (CRDT)", "Redis CRDT", "Implemented for multi-master replication across the hybrid topology.")
}

Rel(RedisMasterNodes, RedisReplicaNodesClusterReplicas, "Replicates data via internal cluster replication protocols to ensure zero data loss.")

@enduml