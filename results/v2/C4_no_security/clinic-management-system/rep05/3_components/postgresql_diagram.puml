@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL container

Container_Boundary(postgresql, "PostgreSQL") {
    Component(ConnectionPooler, "Connection Pooler", "PgBouncer", "Manages and optimizes database connection pooling for client services.")
    Component(DatabaseEngine, "Database Engine", "PostgreSQL 16", "Core relational database engine storing clinical, billing, and audit records.")
    Component(HAFailoverManager, "HA & Failover Manager", "Patroni with etcd", "Ensures high availability and automated failover for the database cluster.")
    Component(AuditLoggingExtension, "Audit Logging Extension", "pgAudit", "Provides detailed session and object audit logging for HIPAA and GDPR compliance.")
    Component(PartitioningRetentionManager, "Partitioning & Retention Manager", "Declarative Partitioning", "Manages table partitioning and data retention policies for long-term storage requirements.")
}

Rel(ConnectionPooler, DatabaseEngine, "Routes and multiplexes database connections")
Rel(HAFailoverManager, DatabaseEngine, "Monitors and orchestrates cluster state and failover")
Rel(AuditLoggingExtension, DatabaseEngine, "Captures audit log events from database operations")
Rel(PartitioningRetentionManager, DatabaseEngine, "Maintains table partitions and enforces retention cycles")

@enduml