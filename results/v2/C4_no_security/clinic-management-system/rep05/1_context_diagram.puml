@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Clinic Management System

Person(Receptionists, "Receptionists / Front Desk Staff", "Front desk staff managing patient admissions, scheduling, and front-office workflows.")
Person(Clinicians, "Clinicians", "Medical professionals managing electronic medical records and clinical operations.")
Person(BillingSpecialists, "Billing Specialists", "Staff handling financial operations, billing, and insurance claims.")
Person(ComplianceOfficers, "Compliance Officers", "Personnel ensuring regulatory adherence, HIPAA/GDPR compliance, and auditing.")
Person(Patients, "Patients", "Healthcare consumers interacting with clinic services and the future Patient Portal.")

System(ClinicManagementSystem, "Clinic Management System", "A hybrid, edge-first healthcare platform that manages patient admissions, electronic medical records, scheduling, and billing for medium-sized hospitals and clinics.")

System_Ext(ExternalLabImagingSystems, "External Lab & Imaging Systems", "External systems providing laboratory results and medical imaging.")
System_Ext(InsuranceClearinghouses, "Insurance Clearinghouses", "External entities processing insurance claims and financial clearing.")
System_Ext(EnterpriseIdentityProvider, "Enterprise Identity Provider", "Identity provider (Azure AD/Keycloak) managing authentication and authorization.")
System_Ext(PatientPortal, "Patient Portal", "Future scope patient portal for self-service and patient engagement.")

Rel(Receptionists, ClinicManagementSystem, "Accesses patient admissions and scheduling", "HTTPS (TLS 1.3 Web UI)")
Rel(Clinicians, ClinicManagementSystem, "Manages electronic medical records and clinical workflows", "HTTPS (TLS 1.3 Web UI)")
Rel(BillingSpecialists, ClinicManagementSystem, "Processes billing and financial records", "HTTPS (TLS 1.3 Web UI)")
Rel(ComplianceOfficers, ClinicManagementSystem, "Reviews audit logs and compliance data", "HTTPS (TLS 1.3 Web UI)")
Rel(Patients, ClinicManagementSystem, "Interacts with clinical services", "HTTPS (TLS 1.3 Web UI)")
Rel(ClinicManagementSystem, ExternalLabImagingSystems, "Exchanges lab orders and imaging data", "HL7 FHIR over HTTPS (REST/JSON)")
Rel(ClinicManagementSystem, InsuranceClearinghouses, "Submits claims and processes insurance data", "SFTP, X12 EDI, and REST APIs")
Rel(ClinicManagementSystem, EnterpriseIdentityProvider, "Authenticates users and manages identity", "OIDC and SAML 2.0")

@enduml