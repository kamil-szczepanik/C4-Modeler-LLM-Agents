@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(front_desk_receptionist, "Front Desk Receptionist", "Manages patient registration, check-in, and daily appointments.")
Person(clinician_doctor, "Clinician/Doctor", "Accesses and updates Electronic Medical Records (EMR) and clinical notes.")
Person(billing_specialist, "Billing Specialist", "Processes patient billing and interacts with insurance clearinghouses.")
Person(patient, "Patient", "Receives care, notifications, and views personal health information.")
Person(compliance_officer, "Compliance Officer", "Monitors audit trails and ensures HIPAA/GDPR regulatory compliance.")

System_Ext(external_lab_imaging_systems, "External Lab & Imaging Systems", "External systems providing laboratory test results and medical imaging.")
System_Ext(insurance_clearinghouse_apis, "Insurance Clearinghouse APIs", "External APIs for processing insurance claims and verification.")
System_Ext(identity_provider_idp, "Identity Provider (IdP)", "Handles authentication and identity management using OIDC/SAML 2.0.")
System_Ext(sms_email_notification_gateway, "SMS/Email Notification Gateway", "External service for sending appointment reminders and notifications to patients.")

System_Boundary(clinic_management_system, "Clinic Management System") {
    Container(spa_mobile_client, "Single-Page Application (SPA) / Mobile Client", "React / TypeScript, CDN", "Client-side interface for patients and staff.")
    Container(api_gateway, "API Gateway", "Kong or NGINX, HTTPS / TLS 1.3", "Manages incoming traffic, routing, and edge security.")
    Container(service_mesh, "Service Mesh", "Istio / Linkerd, gRPC over mTLS", "Manages service-to-service communication and security.")
    Container(patient_scheduling_service, "Patient & Scheduling Service", "Spring Boot (Java) / Node.js", "Handles patient admissions and appointment scheduling.")
    Container(emr_service, "EMR Service", "Python / FastAPI / Go", "Manages Electronic Medical Records with high throughput.")
    Container(billing_claims_service, "Billing & Claims Service", "Spring Boot / NestJS", "Manages billing, invoicing, and insurance claims.")
    Container(integration_service, "Integration Service", "Apache Camel / Spring Integration", "Handles interoperability with external clinical systems via HL7 FHIR.")
    Container(audit_compliance_service, "Audit & Compliance Service", "Spring Boot / Python", "Monitors audit logs and ensures regulatory compliance.")
    ContainerDb(postgresql_clusters, "PostgreSQL Clusters", "PostgreSQL, Active-Active, AES-256", "Primary persistent data storage.")
    ContainerDb(redis_enterprise, "Redis Enterprise", "Redis, Distributed Caching", "Provides distributed caching and offline read resilience.")
}

Rel(front_desk_receptionist, spa_mobile_client, "Uses for patient registration and check-in", "HTTPS / WSS")
Rel(clinician_doctor, spa_mobile_client, "Uses to access and update EMR", "HTTPS / WSS")
Rel(billing_specialist, spa_mobile_client, "Uses to process patient billing", "HTTPS / WSS")
Rel(patient, spa_mobile_client, "Uses to view personal health information", "HTTPS / WSS")
Rel(compliance_officer, spa_mobile_client, "Uses to monitor audit trails", "HTTPS / WSS")

Rel(spa_mobile_client, api_gateway, "Sends client requests", "HTTPS / WSS")

Rel(api_gateway, patient_scheduling_service, "Routes patient requests", "gRPC over Istio mTLS")
Rel(api_gateway, emr_service, "Routes EMR requests", "gRPC over Istio mTLS")
Rel(api_gateway, billing_claims_service, "Routes billing requests", "gRPC over Istio mTLS")
Rel(api_gateway, integration_service, "Routes integration requests", "gRPC over Istio mTLS")
Rel(api_gateway, audit_compliance_service, "Routes compliance requests", "gRPC over Istio mTLS")

Rel(integration_service, external_lab_imaging_systems, "Exchanges clinical data", "HL7 FHIR over HTTPS")
Rel(billing_claims_service, insurance_clearinghouse_apis, "Submits and verifies claims", "HTTPS")
Rel(patient_scheduling_service, sms_email_notification_gateway, "Triggers notifications", "HTTPS")

Rel(patient_scheduling_service, identity_provider_idp, "Authenticates users", "OAuth2 / OIDC")
Rel(emr_service, identity_provider_idp, "Authenticates users", "OAuth2 / OIDC")
Rel(billing_claims_service, identity_provider_idp, "Authenticates users", "OAuth2 / OIDC")
Rel(integration_service, identity_provider_idp, "Authenticates services", "OAuth2 / OIDC")
Rel(audit_compliance_service, identity_provider_idp, "Authenticates users", "OAuth2 / OIDC")

Rel(patient_scheduling_service, postgresql_clusters, "Reads and writes data", "Encrypted internal connections (AES-256)")
Rel(emr_service, postgresql_clusters, "Reads and writes data", "Encrypted internal connections (AES-256)")
Rel(billing_claims_service, postgresql_clusters, "Reads and writes data", "Encrypted internal connections (AES-256)")
Rel(audit_compliance_service, postgresql_clusters, "Reads and writes audit logs", "Encrypted internal connections (AES-256)")

Rel(patient_scheduling_service, redis_enterprise, "Caches operational data", "Encrypted internal connections (AES-256)")
Rel(emr_service, redis_enterprise, "Caches EMR data for offline resilience", "Encrypted internal connections (AES-256)")

@enduml