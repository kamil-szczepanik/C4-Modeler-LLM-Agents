@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Service container

System_Ext(External_Lab_Imaging_Systems, "External Lab & Imaging Systems", "HL7 FHIR over HTTPS, TLS 1.3", "External systems receiving submitted clinical data.")

Container_Boundary(Integration_Service, "Integration Service") {
    Component(API_Gateway, "API Gateway", "Kong / NGINX, HTTPS / TLS 1.3", "Handles ingress traffic via HTTPS / TLS 1.3.")
    Component(Service_Mesh, "Service Mesh", "Istio / Linkerd, gRPC over mTLS", "Provides secure service-to-service communication via gRPC over mTLS.")
    Component(Message_Routing_Transformation_Engine, "Message Routing & Transformation Engine", "Spring Integration, Enterprise Integration Patterns", "Handles core routing and splitting using Enterprise Integration Patterns.")
    Component(FHIR_Adapter_Component, "FHIR Adapter Component", "Apache Camel, REST/FHIR components", "Transforming payloads into HL7 FHIR.")
    Component(Dead_Letter_Queue_DLQ_Manager, "Dead Letter Queue (DLQ) Manager", "RabbitMQ / Kafka, AES-256 encryption", "Capturing failed messages with AES-256 encryption.")
    Component(Integration_Health_Replay_API_Component, "Integration Health & Replay API Component", "Spring Boot Actuator / Camel REST DSL", "Exposing endpoints for administrative dashboards.")
    Component(Audit_Compliance_Service, "Audit & Compliance Service", "Spring Boot / Python", "Collecting immutable audit trails.")
    Component(Integration_Operations_Widget, "Integration Operations Widget", "Web UI", "Allows administrators to query failure statuses and trigger replays.")
}

Rel(API_Gateway, Message_Routing_Transformation_Engine, "Ingests outbound integration requests", "gRPC over Istio mTLS")
Rel(Message_Routing_Transformation_Engine, FHIR_Adapter_Component, "Dispatches formatted clinical payloads", "In-memory")
Rel(FHIR_Adapter_Component, External_Lab_Imaging_Systems, "Submits clinical data", "HL7 FHIR over HTTPS, TLS 1.3")
Rel(Message_Routing_Transformation_Engine, Dead_Letter_Queue_DLQ_Manager, "Offloads poisoned messages", "AMQP / Kafka protocol")
Rel(Integration_Operations_Widget, Integration_Health_Replay_API_Component, "Queries failure statuses and triggers replays", "HTTPS / REST")
Rel(Integration_Health_Replay_API_Component, Dead_Letter_Queue_DLQ_Manager, "Inspects and replays failed messages", "AMQP / Kafka admin API")
Rel(Integration_Health_Replay_API_Component, Audit_Compliance_Service, "Emits immutable audit logs for manual replays", "gRPC / mTLS")

@enduml