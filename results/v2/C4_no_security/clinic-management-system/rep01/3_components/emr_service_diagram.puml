@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the EMR Service container

System_Ext(api_gateway, "API Gateway", "External API Gateway")
System_Ext(redis_enterprise, "Redis Enterprise", "Distributed caching layer")
System_Ext(postgresql_clusters, "PostgreSQL Clusters", "Relational database")

Container_Boundary(emr_service, "EMR Service") {
    Component(emr_api_controller, "EMR API Controller", "Python / FastAPI", "Handles incoming gRPC/REST requests and enforces schema validation.")
    Component(clinical_record_manager, "Clinical Record Manager", "Python / FastAPI", "Executes patient chart business logic and FHIR resource mapping.")
    Component(audit_interceptor, "Audit Interceptor", "Python middleware", "Captures cryptographic hashes and immutable metadata for compliance.")
    Component(local_emr_cache_manager, "Local EMR Cache Manager", "Python / Redis-py", "Implements local-first read-through and write-behind caching patterns.")
    Component(data_access_layer, "Data Access Layer / Repository", "Python", "Manages database connectivity and failover recovery.")
}

Rel(api_gateway, emr_api_controller, "gRPC over Istio mTLS")
Rel(emr_api_controller, clinical_record_manager, "In-memory function calls")
Rel(clinical_record_manager, audit_interceptor, "Async event dispatch")
Rel(clinical_record_manager, local_emr_cache_manager, "In-memory async calls")
Rel(local_emr_cache_manager, redis_enterprise, "Encrypted Redis protocol over mTLS")
Rel(local_emr_cache_manager, postgresql_clusters, "Pooled async SQL with write-behind sync")

@enduml