@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(ComplianceOfficerAndSystemAdministrator, "Compliance Officer and System Administrator", "Primary users ensuring HIPAA and GDPR compliance.")

System_Boundary(AuditAndComplianceService, "Audit & Compliance Service") {
    Component(AuditEventIngestionEngine, "Audit Event Ingestion Engine", "Spring Boot / Reactive WebFlux", "Consumes audit streams and appends hot audit log entries.")
    Component(CompliancePolicyEvaluator, "Compliance Policy Evaluator", "Python / Celery", "Evaluates compliance policies and dispatches real-time security alerts.")
    Component(ReportGeneratorAndRedactor, "Report Generator & Redactor", "Spring Boot", "Exposes Compliance Dashboard API and queries archived immutable logs.")
    Component(RetentionManagementWorker, "Retention Management Worker", "Python", "Migrates logs for 10-year retention.")
}

Component_Ext(ServiceMesh, "Service Mesh", "Service Mesh", "Streams asynchronous audit events.")
Component_Ext(ApacheKafka, "Apache Kafka", "Message Broker", "Decoupled event streaming and buffering.")
Component_Ext(PostgreSQLClusters, "PostgreSQL Clusters", "PostgreSQL with AES-256", "Hot storage with 30-day active retention.")
Component_Ext(ObjectStorageS3WORM, "Object Storage (S3 / WORM)", "AWS S3 with Object Lock", "Cold-tier storage ensuring tamper-proof 10-year retention.")
Component_Ext(SMSEmailNotificationGateway, "SMS/Email Notification Gateway", "External Gateway", "Dispatches real-time security alerts.")
Component_Ext(APIGateway, "API Gateway", "API Gateway", "Exposes compliance dashboard API.")

Rel(ServiceMesh, ApacheKafka, "Streams asynchronous audit events", "gRPC over mTLS")
Rel(AuditEventIngestionEngine, ApacheKafka, "Consumes audit streams", "Kafka Protocol over mTLS")
Rel(AuditEventIngestionEngine, PostgreSQLClusters, "Appends hot audit log entries", "SQL over TLS 1.3 / AES-256")
Rel(CompliancePolicyEvaluator, SMSEmailNotificationGateway, "Dispatches real-time security alerts", "HTTPS")
Rel(ReportGeneratorAndRedactor, APIGateway, "Exposes Compliance Dashboard API", "gRPC")
Rel(ReportGeneratorAndRedactor, ObjectStorageS3WORM, "Queries archived immutable logs", "HTTPS / S3 API")
Rel(RetentionManagementWorker, ObjectStorageS3WORM, "Migrates logs for 10-year retention", "HTTPS / S3 API")

@enduml