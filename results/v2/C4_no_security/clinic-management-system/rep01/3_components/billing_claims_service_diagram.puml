@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Billing & Claims Service", "Billing & Claims Service") {
    Component("Invoice Management", "Invoice Management", "Spring Boot / Java 21", "Handles patient invoices and billing inquiries.")
    Component("Claims Engine", "Claims Engine", "Spring Boot / Java 21", "Processes and manages insurance claims.")
    Component("Payment Gateway Integration", "Payment Gateway Integration", "Spring Boot / Java 21", "Integrates with external payment gateways for processing financial transactions.")
    Component("Outbox Dispatcher", "Outbox Dispatcher", "Spring Boot / Java 21", "Persists and dispatches transactional messages asynchronously.")
    Component("Notification & Exception Handler", "Notification & Exception Handler", "Spring Boot / Java 21", "Manages notifications and exception handling within the billing and claims workflows.")
}

Rel("Claims Engine", "Outbox Dispatcher", "Persists and dispatches transactional messages", "Internal Java method call")

@enduml