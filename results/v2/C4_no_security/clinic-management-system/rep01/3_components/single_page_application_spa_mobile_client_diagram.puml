@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(spa_mobile_client, "Single-Page Application (SPA) / Mobile Client") {
    Component(AuthSessionManager, "Authentication & Session Manager", "React / TypeScript, OAuth2/OIDC", "Manages user authentication, sessions, and security contexts.")
    Component(EMRWorkspace, "EMR Workspace", "React / TypeScript", "Provides the primary interface for clinicians to interact with patient records and clinical workflows.")
    Component(OfflineSyncEngine, "Offline Sync Engine", "IndexedDB, TypeScript", "Handles local data storage and synchronization for offline resilience.")
    Component(ApiClient, "API Client", "Axios/Fetch wrapper", "Facilitates HTTP/REST and WebSocket communication with backend services.")
    Component(NotificationAlertUI, "Notification & Alert UI", "React / TypeScript, WSS", "Displays real-time notifications and system alerts to users.")
    Component(FeatureFlagRBACContextProvider, "Feature Flag & RBAC Context Provider", "React / TypeScript", "Manages role-based access control and feature toggles across the client application.")
}

Rel(NotificationAlertUI, ApiClient, "Establishes persistent connection via WSS.", "WSS")
Rel(EMRWorkspace, ApiClient, "Fetches patient data via HTTPS / REST over JSON.", "HTTPS / REST over JSON")

@enduml