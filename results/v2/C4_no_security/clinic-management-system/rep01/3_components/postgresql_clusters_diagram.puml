@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(postgresql_clusters, "PostgreSQL Clusters") {
    Component(primary_database_engine, "Primary Database Engine", "PostgreSQL 16", "Primary database engine for relational clinical and billing data.")
    Component(read_replica_engine, "Read Replica Engine", "PostgreSQL 16", "Read replica engine handling read queries and cross-region replication.")
    Component(pg_bouncer, "PgBouncer", "PgBouncer", "Connection pooling and smart read/write routing to reduce latency.")
    Component(distributed_consensus_fencing_manager, "Distributed Consensus / Fencing Manager", "etcd / Raft", "Distributed consensus and automated leader election for zero data loss.")
    Component(wal_archiver, "WAL Archiver", "pgBackRest", "Continuous backup and recovery supporting 10-year retention.")
    Component(kubernetes_operator, "Kubernetes Operator", "CloudNativePG / Crunchy Data", "Kubernetes operator managing hybrid database lifecycle and automated fencing.")
}

System_Ext(microservices, "Microservices", "System components interacting with the database")

Rel(microservices, pg_bouncer, "TCP / TLS 1.3", "TCP / TLS 1.3")
Rel(pg_bouncer, primary_database_engine, "TCP", "TCP")
Rel(pg_bouncer, read_replica_engine, "TCP", "TCP")
Rel(primary_database_engine, read_replica_engine, "Synchronous (on-prem) / Asynchronous (cross-region to eu-central-1)", "Synchronous (on-prem) / Asynchronous (cross-region to eu-central-1)")
Rel(primary_database_engine, wal_archiver, "FileSystem / S3 API", "FileSystem / S3 API")

@enduml