@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(patient_scheduling_service, "Patient & Scheduling Service") {
    Component(PatientManagementComponent, "Patient Management Component", "Spring Webflux / Spring MVC", "Handles patient admissions and electronic medical records requests.")
    Component(SchedulingEngine, "Scheduling Engine", "Java domain-driven service", "Executes scheduling logic and manages transactions with PostgreSQL and Redis.")
    Component(NotificationOrchestrator, "Notification Orchestrator", "Spring Cloud Stream / Spring Integration", "Orchestrates and dispatches alerts via external notification gateways.")
}

Rel(PatientManagementComponent, SchedulingEngine, "Coordinates scheduling workflows")
Rel(SchedulingEngine, NotificationOrchestrator, "Triggers notifications for appointments")

@enduml