@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Redis Enterprise container

Container_Boundary(redis_enterprise, "Redis Enterprise") {
    Component(RedisCoreEngine, "Redis Core Engine", "In-Memory Data Store", "Handles core in-memory data storage and caching.")
    Component(EncryptionSecurityModule, "Encryption & Security Module", "OpenSSL/TLS 1.3 & AES-256", "Enforces mandatory in-transit and at-rest encryption to satisfy HIPAA and GDPR.")
    Component(ClusterManagerRBAC, "Cluster Manager & RBAC", "Raft Consensus & RBAC", "Manages cluster coordination, access control, and security policies.")
    Component(ActiveActiveCRDTSyncEngine, "Active-Active CRDT Sync Engine", "CRDTs", "Ensures active-active multi-master replication and partition tolerance.")
    Component(ObservabilityBackupSidecar, "Observability & Backup Sidecar", "Prometheus", "Streams metrics for latency, memory, and cluster health monitoring.")
    Component(CacheInvalidationPurgeController, "Cache Invalidation & Purge Controller", "Event-driven Purge Controller", "Performs event-driven data purging to ensure compliance.")
    Component(PersistenceActiveFlashEngine, "Persistence & Active-Flash Engine", "RocksDB", "Powers Active-Flash NVMe persistence for cost-effective cold data tiering.")
    Component(HybridNetworkGatewayVPN1, "Hybrid Network Gateway & VPN Tunnel Manager", "IPsec / Encrypted Mesh Peering", "Manages hybrid network connectivity and VPN tunnels.")
}

System_Ext(PatientEMRServices, "Patient & EMR Services", "External EMR and patient services.")
System_Ext(AWSAndOnPrem, "AWS eu-central-1 and on-prem-k8s", "External cloud and on-premise Kubernetes clusters.")

Rel(PatientEMRServices, EncryptionSecurityModule, "Protocol: RESP over mTLS/TLS 1.3", "RESP / mTLS")
Rel(CacheInvalidationPurgeController, RedisCoreEngine, "Protocol: RESP", "RESP")
Rel(RedisCoreEngine, PersistenceActiveFlashEngine, "Protocol: Encrypted local storage", "Encrypted local storage")
Rel(HybridNetworkGatewayVPN1, AWSAndOnPrem, "Protocol: IPsec / Encrypted mesh peering", "IPsec / Mesh Peering")

@enduml