@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Service Mesh container

Container_Boundary("Service Mesh", "Service Mesh") {
    Component("Sidecar Proxy", "Sidecar Proxy", "Envoy", "Intercepts network traffic to and from services, enforcing mTLS and zero-trust policies.")
    Component("Control Plane", "Control Plane", "Istiod", "Manages and configures the sidecar proxies within the service mesh.")
    Component("Telemetry Collector", "Telemetry Collector", "Prometheus / OpenTelemetry", "Gathers centralized metrics and trace spans for audit trails and monitoring.")
    Component("Ingress/Egress Gateways", "Ingress/Egress Gateways", "Envoy", "Manages traffic entering and leaving the hybrid cloud service mesh boundary.")
    Component("Resilience & Policy Engine", "Resilience & Policy Engine", "Istio", "Provides automated circuit-breaking, traffic management, and security policies.")
}

Rel("Sidecar Proxy", "Control Plane", "Receives configuration and security policies", "")
Rel("Sidecar Proxy", "Telemetry Collector", "Sends metrics and trace spans via OTLP", "OpenTelemetry Protocol (OTLP)")
Rel("Ingress/Egress Gateways", "Sidecar Proxy", "Routes external and cross-network traffic securely", "")
Rel("Resilience & Policy Engine", "Sidecar Proxy", "Enforces resilience and security policies", "")

@enduml