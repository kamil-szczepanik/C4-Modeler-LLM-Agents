@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(JWT_Validation_Plugin, "JWT Validation Plugin", "Kong/NGINX Plugin", "Validates OAuth2 JWT tokens issued by the External IdP.")
    Component(Rate_Limiting___Throttling_Engine, "Rate Limiting & Throttling Engine", "Kong/NGINX Module", "Manages traffic rates and prevents abuse by enforcing throttling policies.")
    Component(FHIR_Request_Validator, "FHIR Request Validator", "Custom Middleware", "Validates incoming healthcare data requests against FHIR standards.")
    Component(Reverse_Proxy_Router, "Reverse Proxy Router", "Kong/NGINX Router", "Routes validated traffic to internal microservices via gRPC over Istio mTLS.")
    Component(Usage_Analytics___Audit_Logging_Plugin, "Usage Analytics & Audit Logging Plugin", "Kong/NGINX Plugin", "Collects usage analytics and generates audit logs for compliance.")
    Component(Audit___Analytics_Transporter, "Audit & Analytics Transporter", "gRPC Client", "Offloads asynchronous logs to the Audit & Compliance Service via gRPC.")
    Component(W3C_Trace_Context_Injector, "W3C Trace Context Injector", "OpenTelemetry / Middleware", "Injects W3C trace context headers into incoming requests for distributed tracing.")
}

Rel(JWT_Validation_Plugin, Reverse_Proxy_Router, "Passes authenticated requests")
Rel(Rate_Limiting___Throttling_Engine, Reverse_Proxy_Router, "Enforces traffic limits on requests")
Rel(FHIR_Request_Validator, Reverse_Proxy_Router, "Ensures structural validity of health data")
Rel(Reverse_Proxy_Router, Usage_Analytics___Audit_Logging_Plugin, "Triggers log creation")
Rel(Usage_Analytics___Audit_Logging_Plugin, Audit___Analytics_Transporter, "Sends log payloads")
Rel(W3C_Trace_Context_Injector, Reverse_Proxy_Router, "Enriches requests with trace headers")

@enduml