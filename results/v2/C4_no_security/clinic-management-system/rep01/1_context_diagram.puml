@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Clinic Management System

Person(Front_Desk_Receptionist, "Front Desk Receptionist", "Manages patient registration, check-in, and daily appointments.")
Person(Clinician_Doctor, "Clinician/Doctor", "Accesses and updates Electronic Medical Records (EMR) and clinical notes.")
Person(Billing_Specialist, "Billing Specialist", "Processes patient billing and interacts with insurance clearinghouses.")
Person(Patient, "Patient", "Receives care, notifications, and views personal health information.")
Person(Compliance_Officer, "Compliance Officer", "Monitors audit trails and ensures HIPAA/GDPR regulatory compliance.")

System(Clinic_Management_System, "Clinic Management System", "A hybrid healthcare platform providing patient registration, EMR, scheduling, billing, high availability, strict regulatory compliance, and seamless clinical interoperability.")

System_Ext(External_Lab__Imaging_Systems, "External Lab & Imaging Systems", "External systems providing laboratory test results and medical imaging.")
System_Ext(Insurance_Clearinghouse_APIs, "Insurance Clearinghouse APIs", "External APIs for processing insurance claims and verification.")
System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "Handles authentication and identity management using OIDC/SAML 2.0.")
System_Ext(SMS_Email_Notification_Gateway, "SMS/Email Notification Gateway", "External service for sending appointment reminders and notifications to patients.")

Rel(Front_Desk_Receptionist, Clinic_Management_System, "Interacts with the platform for registration and scheduling", "HTTPS, TLS 1.3")
Rel(Clinician_Doctor, Clinic_Management_System, "Accesses patient EMR and clinical tools", "HTTPS, TLS 1.3")
Rel(Billing_Specialist, Clinic_Management_System, "Manages billing and claims processing", "HTTPS, TLS 1.3")
Rel(Patient, Clinic_Management_System, "Accesses portal and receives notifications", "HTTPS, TLS 1.3")
Rel(Compliance_Officer, Clinic_Management_System, "Monitors audit trails and regulatory compliance", "HTTPS, TLS 1.3")
Rel(Clinic_Management_System, External_Lab__Imaging_Systems, "Exchanges clinical data and lab results", "HL7 FHIR REST API")
Rel(Clinic_Management_System, Insurance_Clearinghouse_APIs, "Submits and verifies insurance claims", "Secure REST / SFTP")
Rel(Clinic_Management_System, Identity_Provider_IdP, "Authenticates users and enforces MFA", "OIDC / SAML 2.0")
Rel(Clinic_Management_System, SMS_Email_Notification_Gateway, "Triggers automated patient notifications", "HTTPS REST")

@enduml