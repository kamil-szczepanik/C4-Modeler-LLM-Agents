@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(event_bus, "Event Bus") {
    Component(kafka_broker_cluster, "Kafka Broker Cluster", "Apache Kafka (KRaft Mode)", "Publishes and consumes domain events using Kafka Wire Protocol for asynchronous messaging.")
    Component(schema_registry, "Schema Registry", "Avro", "Validates event schemas for microservices.")
    Component(kafka_connect, "Kafka Connect", "Debezium", "Handles change data capture (CDC) and reliable asynchronous messaging.")
    Component(dlq_retry_router, "DLQ & Retry Router", "Kafka Wire Protocol", "Forwards unprocessable events from the Kafka Broker Cluster.")
    Component(event_governance, "Event Governance & Access Control Layer", "Apache Ranger / mTLS", "Authenticates and authorizes operations for microservices interacting with the event bus.")
}

Rel(kafka_broker_cluster, dlq_retry_router, "Forwards unprocessable events", "Kafka Wire Protocol")

@enduml