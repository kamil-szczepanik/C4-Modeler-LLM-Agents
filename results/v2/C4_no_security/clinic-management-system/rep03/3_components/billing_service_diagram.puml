@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing Service container

Container(FrontendContainer, "Frontend Container", "Web/Mobile", "Client application interacting with services.")
System_Ext(ApacheKafka, "Apache Kafka", "Event Bus", "Publishes asynchronous domain events via Transactional Outbox pattern.")
System_Ext(PaymentGatewayInsuranceClearinghouse, "Payment Gateway & Insurance Clearinghouse", "External System", "External system for processing claims and payments.")
ContainerDb(PostgreSQLDatabase, "PostgreSQL Database", "PostgreSQL", "Primary Write-Master and Read-Replica.")

Container_Boundary(BillingService, "Billing Service") {
    Component(ClaimManagementComponent, "Claim Management Component", "Drools rules engine", "Powers the automated claim validation rules engine.")
    Component(PaymentProcessingComponent, "Payment Processing Component", "Resilience4j circuit breakers", "Processes claims and payments while preventing cascading failures during clearinghouse outages.")
    Component(BillingAPIDashboardComponent, "Billing API & Dashboard Component", "Dual-datasource routing", "Manages financial data requests and executes dual-datasource routing.")
    Component(SecurityAuthorizationInterceptor, "Security & Authorization Interceptor", "JWT/OAuth2 validation", "Handles security and authorization via JWT and OAuth2 validation.")
}

Rel(FrontendContainer, BillingAPIDashboardComponent, "Requests financial data via gRPC and REST over mTLS", "gRPC / REST / mTLS")
Rel(ClaimManagementComponent, ApacheKafka, "Publishes asynchronous domain events via Transactional Outbox pattern", "Async / Event")
Rel(PaymentProcessingComponent, PaymentGatewayInsuranceClearinghouse, "Processes claims and payments via TLS-encrypted REST/SOAP APIs", "REST / SOAP / TLS")
Rel(BillingAPIDashboardComponent, PostgreSQLDatabase, "Executes strict ACID transactions and read-replica queries via TLS-encrypted connections (HikariCP)", "JDBC / TLS")

@enduml