@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Object Storage container

Container_Boundary(object_storage, "Object Storage") {
    Component(storage_gateway, "Storage Gateway", "Go / S3 API", "Uploads/retrieves EMR assets and coordinates storage operations.")
    Component(encryption_key_management, "Encryption & Key Management", "Vault / AWS KMS", "Applies AES-256 encryption via Internal gRPC.")
    Component(lifecycle_tiering_engine, "Lifecycle & Tiering Engine", "Go / Custom Engine", "Manages automated tiering and WORM locking for retention.")
    Component(audit_compliance_guardrail, "Audit & Compliance Guardrail", "Go / Internal gRPC", "Validates immutability policies and compliance guardrails.")
}

Rel(storage_gateway, audit_compliance_guardrail, "Validates immutability policies via Internal gRPC", "Internal gRPC")
Rel(storage_gateway, encryption_key_management, "Applies AES-256 via Internal gRPC", "Internal gRPC")
Rel(storage_gateway, lifecycle_tiering_engine, "Executes retention policies via Internal gRPC", "Internal gRPC")

@enduml