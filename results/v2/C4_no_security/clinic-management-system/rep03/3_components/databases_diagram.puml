@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Databases container

Container_Boundary(Databases, "Databases") {
    Component(Primary_OLTP_Store, "Primary OLTP Store", "PostgreSQL with Patroni", "Active-Passive hot standby cluster managed by Patroni for ACID compliance in billing and scheduling.")
    Component(Document_Store, "Document Store", "MongoDB", "Replica set with immutable collections for EMR and audit trails.")
    Component(In_Memory_Cache, "In-Memory Cache", "Redis", "Clustered in-memory cache with AOF/RDB persistence for sub-second EMR screen loads.")
    Component(Connection_Pooler, "Connection Pooler", "PgBouncer", "Connection pooling for resource management and availability.")
}

System_Ext(Object_Storage, "Object Storage", "Encrypted S3-compatible")

Rel(Primary_OLTP_Store, Object_Storage, "Pipes automated, daily snapshots for 10-year retention")
Rel(Document_Store, Object_Storage, "Pipes automated, daily snapshots for 10-year retention")
Rel(In_Memory_Cache, Object_Storage, "Pipes automated, daily snapshots for 10-year retention")

@enduml