@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(frontend_container, "Frontend Container") {
    Component(AuthSessionManager, "Authentication & Session Manager", "TypeScript, React", "Manages multi-factor authentication, OIDC/OAuth2 sessions, and user login state.")
    Component(RoleBasedRouter, "Role-Based Router & Shell", "TypeScript, React", "Controls navigation and UI shells based on user personas and authorization.")
    Component(ClinicalEMRViewComponent, "Clinical EMR View Component", "TypeScript, React", "Renders electronic medical records and interacts with local persistence.")
    Component(APIClientLayer, "API Client Layer", "TypeScript, Fetch / Axios", "Handles outbound HTTPS/JSON requests to the Edge Container.")
    Component(LocalPersistenceManager, "Local Persistence Manager", "IndexedDB", "Reads and writes encrypted drafts and offline data securely.")
    Component(CryptographicVaultManager, "Cryptographic Vault Manager", "Web Crypto API", "Provides client-side encryption and security operations.")
}

Rel(ClinicalEMRViewComponent, LocalPersistenceManager, "Reads/Writes encrypted drafts", "IndexedDB / Web Crypto API")

@enduml