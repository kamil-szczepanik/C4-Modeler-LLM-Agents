@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Service / FHIR Facade container

Container_Boundary("integration_service_fhir_facade", "Integration Service / FHIR Facade") {
    Component(gateway, "FHIR API Gateway / Router", "Go using Gin or Fiber", "Routes incoming API requests and handles protocol translation.")
    Component(mapper, "Resource Mapper & Validator", "Go using go-fhir models", "Maps and validates clinical resources against FHIR standards.")
    Component(client_pool, "Outbound/Inbound Client Pool", "Go HTTP/gRPC Client", "Manages client connections for external communication.")
    Component(dlq_handler, "DLQ Management Handler", "Go background worker", "Handles dead-letter queue management and message reprocessing.")
}

Rel(gateway, mapper, "Internal function calls", "Go structs")
Rel(mapper, dlq_handler, "Routes failed payloads", "Async")

@enduml