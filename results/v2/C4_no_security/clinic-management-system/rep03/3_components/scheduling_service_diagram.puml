@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Scheduling_Service", "Scheduling Service") {
    Component("API_Router_Component", "API Router Component", "Express.js / Fastify", "Routes requests and handles initial entry into the Scheduling Service.")
    Component("Booking_Engine_Component", "Booking Engine Component", "Node.js / TypeScript", "Manages patient and resource bookings with real-time conflict prevention.")
    Component("Availability_Cache_Component", "Availability Cache Component", "Redis Cluster", "Acquires distributed locks and checks availability using Redlock.")
    Component("Notification_Dispatcher_Component", "Notification Dispatcher Component", "Node.js", "Publishes domain events to the event bus for notifications and analytics.")
}

Rel("API_Router_Component", "Booking_Engine_Component", "Delegates requests", "In-process TypeScript interfaces")
Rel("Booking_Engine_Component", "Availability_Cache_Component", "Acquires distributed locks and checks availability", "TCP with TLS, rediss://")

@enduml