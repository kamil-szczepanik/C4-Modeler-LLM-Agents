@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Edge Container container

Container_Boundary(edge_container, "Edge Container") {
    Component(API_Gateway_Router, "API Gateway Router", "Kong / Envoy", "Handles internal routing for incoming API requests from the frontend.")
    Component(Authentication_Component, "Authentication Component", "OAuth 2.0 / OIDC", "Validates user authentication and manages MFA.")
    Component(Rate_Limiting_Component, "Rate Limiting Component", "Redis Cache Plugin", "Performs tenant-aware rate limiting and token validation.")
    Component(Telemetry_Component, "Telemetry Component", "Prometheus Telemetry Plugin", "Collects metrics and observability data for edge requests.")
}

Rel(API_Gateway_Router, Authentication_Component, "Authenticates users via", "OAuth 2.0 / OIDC")
Rel(API_Gateway_Router, Rate_Limiting_Component, "Enforces limits using", "Redis Cache")
Rel(API_Gateway_Router, Telemetry_Component, "Reports metrics to", "Prometheus")

@enduml