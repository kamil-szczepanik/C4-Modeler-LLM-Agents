@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Clinical Service container

Container_Boundary(clinical_service, "Clinical Service") {
    Component(emr_mgmt, "EMR Management Component", "Go", "Manages electronic medical records, ensuring sub-second P95 performance and HIPAA/GDPR compliance.")
    Component(patient_admission, "Patient Admission & Demographics Component", "Go", "Handles patient admissions and demographic data processing.")
    Component(data_repo, "Clinical Data Access Repository", "Go, PostgreSQL, Redis", "Reads and writes clinical records and cache using TLS-encrypted PostgreSQL and Redis.")
    Component(audit_publisher, "Audit & Event Publisher Component", "Go, Apache Kafka / RabbitMQ", "Publishes asynchronous domain events and maintains comprehensive audit trails.")
}

System_Ext(event_bus, "Event Bus", "Apache Kafka / RabbitMQ")

Rel(emr_mgmt, data_repo, "Reads and writes clinical records and cache", "TLS-encrypted PostgreSQL, Redis")
Rel(patient_admission, data_repo, "Stores and retrieves patient demographic data", "TLS-encrypted PostgreSQL, Redis")
Rel(data_repo, audit_publisher, "Triggers data modification events", "")
Rel(audit_publisher, event_bus, "Publishes asynchronous domain events", "Apache Kafka / RabbitMQ")

@enduml