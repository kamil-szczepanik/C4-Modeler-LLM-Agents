@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Patient, "Patient", "Receives care and interacts with the clinic system for admissions and scheduling.")
Person(Clinician, "Clinician / Doctor", "Medical professional who manages electronic medical records and clinical workflows.")
Person(Receptionist, "Receptionist / Admin", "Staff member handling front-desk tasks, patient admissions, and scheduling.")
Person(BillingSpecialist, "Billing Specialist", "Manages financial transactions, billing, and insurance claims.")
Person(Auditor, "Compliance / IT Auditor", "Ensures regulatory compliance and system security standards.")
Person(Executive, "Hospital Executive", "Reviews business analytics, reports, and high-level hospital performance.")

System_Ext(ExternalLab, "External Lab & Imaging Systems", "Third-party systems providing laboratory and medical imaging results.")
System_Ext(PaymentGateway, "Payment Gateway & Insurance Clearinghouse", "External services processing payments and insurance verifications.")
System_Ext(IdP, "Identity Provider (IdP)", "Manages user authentication and multi-factor access control.")
System_Ext(AnalyticsService, "Business Analytics / Reporting Service", "Receives sanitized telemetry and metrics for analytics and reporting.")

System_Boundary(ClinicSystem, "Clinic Management System") {
    Container(Frontend, "Frontend Container", "TypeScript, React, Nginx/CDN", "Single Page Application for client-side rendering and user interaction.")
    Container(Edge, "Edge Container", "Kong / Envoy", "API Gateway handling rate limiting, circuit breaking, and mTLS routing.")
    Container(ClinicalService, "Clinical Service", "Go", "High-performance backend service handling clinical workflows and EMR.")
    Container(SchedulingService, "Scheduling Service", "Node.js", "Backend service handling patient and resource scheduling.")
    Container(BillingService, "Billing Service", "Java / Spring Boot", "Robust transactional service handling financial billing and insurance claims.")
    Container(AuditService, "Audit & Compliance Log Service", "Go", "Backend service managing strict regulatory audit logs.")
    Container(IntegrationService, "Integration Service / FHIR Facade", "Go", "Backend service handling interoperability with external lab and imaging systems.")
    Container(EventBus, "Event Bus", "Apache Kafka / RabbitMQ", "Infrastructure container for asynchronous domain event publishing and decoupling.")
    ContainerDb(Databases, "Databases", "PostgreSQL, MongoDB, Redis", "Data storage containers for transactional clinical/scheduling data, immutable audit logs, and caching.")
    Container(ObjectStorage, "Object Storage", "Encrypted S3-compatible", "Tiered archiving and secure long-term object storage.")
}

Rel(Patient, Frontend, "Accesses patient portal and scheduling", "HTTPS / JSON")
Rel(Clinician, Frontend, "Accesses EMR and clinical workflows", "HTTPS / JSON")
Rel(Receptionist, Frontend, "Manages admissions and front-desk tasks", "HTTPS / JSON")
Rel(BillingSpecialist, Frontend, "Manages financial transactions and billing", "HTTPS / JSON")
Rel(Auditor, Frontend, "Reviews audit logs and system compliance", "HTTPS / JSON")
Rel(Executive, Frontend, "Views executive reports and dashboards", "HTTPS / JSON")

Rel(Frontend, Edge, "Sends API requests", "HTTPS / JSON")

Rel(Edge, ClinicalService, "Routes requests via internal mTLS", "Internal gRPC and REST over mTLS")
Rel(Edge, SchedulingService, "Routes requests via internal mTLS", "Internal gRPC and REST over mTLS")
Rel(Edge, BillingService, "Routes requests via internal mTLS", "Internal gRPC and REST over mTLS")
Rel(Edge, AuditService, "Routes requests via internal mTLS", "Internal gRPC and REST over mTLS")
Rel(Edge, IntegrationService, "Routes requests via internal mTLS", "Internal gRPC and REST over mTLS")

Rel(ClinicalService, EventBus, "Publishes asynchronous domain events", "Apache Kafka / RabbitMQ")
Rel(SchedulingService, EventBus, "Publishes asynchronous domain events", "Apache Kafka / RabbitMQ")
Rel(BillingService, EventBus, "Publishes asynchronous domain events", "Apache Kafka / RabbitMQ")
Rel(AuditService, EventBus, "Publishes and consumes audit events", "Apache Kafka / RabbitMQ")

Rel(IntegrationService, ExternalLab, "Exchanges lab and imaging interoperability data", "HL7 FHIR APIs")
Rel(BillingService, PaymentGateway, "Processes claims and payments", "Secure REST/SOAP APIs")
Rel(Edge, IdP, "Authenticates users", "OAuth 2.0 / OIDC with MFA")
Rel(AuditService, AnalyticsService, "Publishes sanitized telemetry and metrics", "Kafka / Debezium message streams")

Rel(ClinicalService, Databases, "Reads and writes clinical data and cache", "TLS-encrypted connections (PostgreSQL, Redis)")
Rel(SchedulingService, Databases, "Reads and writes scheduling data and cache", "TLS-encrypted connections (PostgreSQL, Redis)")
Rel(BillingService, Databases, "Reads and writes billing data", "TLS-encrypted connections (PostgreSQL)")
Rel(AuditService, Databases, "Stores immutable audit logs", "TLS-encrypted connections (MongoDB)")
Rel(ClinicalService, ObjectStorage, "Archives long-term medical records", "Encrypted S3-compatible APIs")

@enduml