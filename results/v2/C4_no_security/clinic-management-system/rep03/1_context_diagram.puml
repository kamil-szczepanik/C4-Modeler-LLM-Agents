@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Clinic Management System

Person(Patient, "Patient", "Receives care and interacts with the clinic system for admissions and scheduling.")
Person(Clinician___Doctor, "Clinician / Doctor", "Medical professional who manages electronic medical records and clinical workflows.")
Person(Receptionist___Admin, "Receptionist / Admin", "Staff member handling front-desk tasks, patient admissions, and scheduling.")
Person(Billing_Specialist, "Billing Specialist", "Manages financial transactions, billing, and insurance claims.")
Person(Compliance___IT_Auditor, "Compliance / IT Auditor", "Ensures regulatory compliance and system security standards.")
Person(Hospital_Executive, "Hospital Executive", "Reviews business analytics, reports, and high-level hospital performance.")

System(Clinic_Management_System, "Clinic Management System", "An enterprise software solution designed for medium-sized hospitals and clinics to manage patient admissions, electronic medical records, scheduling, and billing across hybrid cloud and on-premise environments.")

System_Ext(External_Lab___Imaging_Systems, "External Lab & Imaging Systems", "Third-party systems providing laboratory and medical imaging results.")
System_Ext(Payment_Gateway___Insurance_Clearinghouse, "Payment Gateway & Insurance Clearinghouse", "External services processing payments and insurance verifications.")
System_Ext(Identity_Provider__IdP_, "Identity Provider (IdP)", "Manages user authentication and multi-factor access control.")
System_Ext(Business_Analytics___Reporting_Service, "Business Analytics / Reporting Service", "Receives sanitized telemetry and metrics for analytics and reporting.")

Rel(Patient, Clinic_Management_System, "Interacts with the system via HTTPS / TLS 1.3", "HTTPS / TLS 1.3")
Rel(Clinician___Doctor, Clinic_Management_System, "Interacts with the system via HTTPS / TLS 1.3", "HTTPS / TLS 1.3")
Rel(Receptionist___Admin, Clinic_Management_System, "Interacts with the system via HTTPS / TLS 1.3", "HTTPS / TLS 1.3")
Rel(Billing_Specialist, Clinic_Management_System, "Interacts with the system via HTTPS / TLS 1.3", "HTTPS / TLS 1.3")
Rel(Hospital_Executive, Clinic_Management_System, "Interacts with the system via HTTPS / TLS 1.3", "HTTPS / TLS 1.3")
Rel(Clinic_Management_System, External_Lab___Imaging_Systems, "Integrates for lab and imaging data exchange", "HL7 FHIR REST APIs")
Rel(Clinic_Management_System, Payment_Gateway___Insurance_Clearinghouse, "Communicates for billing and payment processing", "Secure REST/SOAP APIs")
Rel(Clinic_Management_System, Identity_Provider__IdP_, "Authenticates users against the identity provider", "OAuth 2.0 / OIDC with Multi-Factor Authentication")
Rel(Clinic_Management_System, Business_Analytics___Reporting_Service, "Publishes sanitized telemetry and metrics", "Kafka / Debezium message streams")

@enduml