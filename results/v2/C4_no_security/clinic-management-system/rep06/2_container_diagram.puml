@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Patients, "Patients", "End users who interact with the system for scheduling and managing their healthcare information.")
Person(Clinicians, "Clinicians", "Medical professionals who access and update Electronic Medical Records (EMRs) and patient admissions.")
Person("Administrative Staff", "Administrative Staff", "Personnel responsible for clinic operations, scheduling, and general management within the system.")
Person("Billing Officers", "Billing Officers", "Staff members handling financial transactions, billing, and claims processing.")

System_Ext("Insurance Gateways", "Insurance Gateways", "External systems for processing medical claims and insurance verifications.")
System_Ext("Lab/Imaging Systems", "Lab/Imaging Systems", "External systems providing laboratory results and medical imaging data.")
System_Ext("Identity Provider (IdP)", "Identity Provider (IdP)", "External system responsible for user authentication and authorization.")

System_Boundary(cms_system, "Clinic Management System") {
    Container("API Gateway / Reverse Proxy", "API Gateway / Reverse Proxy", "NGINX / Envoy", "Entry point managing incoming traffic, routing requests, and enforcing security policies.")
    Container("Clinical Web/Mobile App", "Clinical Web/Mobile App", "React / React Native", "Provides interfaces for clinicians to manage patient admissions and EMRs.")
    Container("Patient Portal App", "Patient Portal App", "Next.js", "Provides patients with web access to scheduling and healthcare information.")
    Container("EMR & Scheduling Service", "EMR & Scheduling Service", "Node.js / NestJS", "Handles domain logic execution for patient admissions, electronic medical records, and scheduling.")
    Container("Billing Service", "Billing Service", "Java / Spring Boot", "Ensures robust transactional integrity for financial operations and billing.")
    Container("Integration & Interoperability Service", "Integration & Interoperability Service", "Apache Camel / Spring Boot", "Connects internal services with external systems like lab and imaging systems.")
    Container("Audit & Compliance Service", "Audit & Compliance Service", "Python / FastAPI", "Tracks and enforces regulatory compliance and auditing across operations.")
    ContainerDb("Data Tier", "Data Tier", "PostgreSQL with WORM Object Storage", "Provides primary transactional data storage with AES-256 encryption at rest.")
    Container("Message Broker", "Message Broker", "Apache Kafka", "Handles asynchronous event-driven decoupling of billing workloads and system events.")
}

Rel(Clinicians, "Clinical Web/Mobile App", "Accesses clinical features and patient records", "HTTPS/WSS")
Rel("Administrative Staff", "Clinical Web/Mobile App", "Accesses administrative features and scheduling", "HTTPS/WSS")
Rel(Patients, "Patient Portal App", "Manages healthcare information and scheduling", "HTTPS")
Rel("Clinical Web/Mobile App", "API Gateway / Reverse Proxy", "Sends requests to backend services", "HTTPS/WSS")
Rel("Patient Portal App", "API Gateway / Reverse Proxy", "Sends requests to backend services", "HTTPS")
Rel("API Gateway / Reverse Proxy", "EMR & Scheduling Service", "Routes API requests", "gRPC / REST")
Rel("API Gateway / Reverse Proxy", "Billing Service", "Routes API requests", "gRPC / REST")
Rel("API Gateway / Reverse Proxy", "Integration & Interoperability Service", "Routes API requests", "gRPC / REST")
Rel("EMR & Scheduling Service", "Audit & Compliance Service", "Sends audit logs and compliance events", "gRPC / Kafka")
Rel("Integration & Interoperability Service", "Lab/Imaging Systems", "Exchanges health data", "HTTPS/FHIR")
Rel("Billing Service", "Message Broker", "Publishes asynchronous events", "Apache Kafka")

@enduml