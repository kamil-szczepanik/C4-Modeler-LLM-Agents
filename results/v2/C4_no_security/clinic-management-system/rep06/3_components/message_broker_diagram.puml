@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(message_broker, "Message Broker") {
    Component(BrokerCluster, "Broker Cluster", "Apache Kafka Core", "Handles core event streaming and durability for decoupled microservices.")
    Component(SchemaRegistry, "Schema Registry", "Confluent Schema Registry", "Enforces data contracts and event schema validation across published events.")
    Component(MirrorMaker2Engine, "MirrorMaker 2 Engine", "MirrorMaker 2", "Replicates encrypted topic streams over mutual TLS (mTLS) across the hybrid boundary to AWS MSK / Cloud Broker.")
    Component(PrometheusJMXExporter, "Prometheus JMX Exporter", "Prometheus JMX Exporter", "Exports metrics from the message broker cluster for monitoring and observability.")
    Component(DeadLetterQueuesDLQ, "Dead Letter Queues (DLQ)", "Apache Kafka Topic", "Captures unprocessable or failed messages for error handling and analysis.")
}

Rel(BrokerCluster, SchemaRegistry, "Validates event schemas")
Rel(BrokerCluster, MirrorMaker2Engine, "Streams topics for cross-boundary replication")
Rel(BrokerCluster, PrometheusJMXExporter, "Exposes broker metrics")
Rel(BrokerCluster, DeadLetterQueuesDLQ, "Routes failed message processing attempts")
@enduml