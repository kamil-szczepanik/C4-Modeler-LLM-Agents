@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the EMR & Scheduling Service container

Container_Boundary(emr_scheduling_service, "EMR & Scheduling Service") {
    Component(api_gateway, "API Gateway / Reverse Proxy", "NGINX / Envoy", "Routes incoming client requests to internal services.")
    Component(security_middleware, "Security & RBAC Middleware", "JWT/OAuth2 enforcement layer", "Enforces security and role-based access control.")
    Component(patient_admission, "Patient Admission Component", "NestJS demographic management module", "Manages patient admissions and demographic information.")
    Component(scheduling_engine, "Scheduling Engine Component", "Redis-backed appointment and clash-check module", "Handles appointments and performs clash checks.")
    Component(emr_core, "EMR Core Component", "CQRS-pattern clinical records module", "Manages clinical records using the CQRS pattern.")
    Component(notification_publisher, "Notification Event Publisher", "Kafka event dispatch module", "Dispatches notification events to message brokers.")
    Component(outbox_handler, "Outbox Pattern Handler", "Transactional messaging component", "Ensures reliable transactional messaging without dual-write risks.")
    Component(data_tier, "Data Tier", "PostgreSQL with read-replicas and WORM Object Storage", "Persists relational data and audit trails.")
    Component(message_broker, "Message Broker", "Apache Kafka", "Provides reliable asynchronous messaging.")
}

System_Ext(integration_service, "Integration Service", "External integration service")

Rel(api_gateway, security_middleware, "Routes requests", "gRPC / REST over TLS 1.3")
Rel(security_middleware, scheduling_engine, "Invokes internal methods", "In-Memory")
Rel(security_middleware, emr_core, "Invokes internal methods", "In-Memory")
Rel(emr_core, data_tier, "Queries and persists records", "SQL/TypeORM over TLS 1.3")
Rel(scheduling_engine, message_broker, "Emits appointment mutation events", "Kafka/Async")
Rel(notification_publisher, integration_service, "Dispatches notification payloads", "gRPC")

@enduml