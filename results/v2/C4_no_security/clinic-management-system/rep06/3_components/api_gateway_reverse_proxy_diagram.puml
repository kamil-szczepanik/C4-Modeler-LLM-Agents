@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway / Reverse Proxy container

System_Ext(External_IdP, "External IdP", "External Identity Provider")
System_Ext(Redis_Cache, "Redis Cache", "Redis Caching Layer")
System_Ext(EMR_Scheduling_Service, "EMR & Scheduling Service", "Node.js / NestJS backend service")
System_Ext(Billing_Service, "Billing Service", "Java / Spring Boot backend service")
System_Ext(Audit_Compliance_Service, "Audit & Compliance Service", "Python / FastAPI service")

Container_Boundary(api_gateway_boundary, "API Gateway / Reverse Proxy") {
    Component(Routing_and_Load_Balancing_Engine, "Routing & Load Balancing Engine", "Envoy", "Handles high-performance routing and load balancing of incoming traffic to internal microservices.")
    Component(Authentication_and_Authorization_Filter, "Authentication & Authorization Filter", "Envoy / OIDC / OAuth2", "Validates user identity and permissions via the External Identity Provider.")
    Component(Rate_Limiting_and_Throttling_Module, "Rate Limiting & Throttling Module", "Envoy / Redis", "Enforces rate limits and request throttling using Redis cache.")
    Component(Audit_and_Telemetry_Interceptor, "Audit & Telemetry Interceptor", "Envoy", "Intercepts requests and forwards telemetry and audit data to the Audit & Compliance Service.")
    Component(Tenant_Quota_and_Policy_Enforcer, "Tenant Quota & Policy Enforcer", "Envoy", "Enforces tenant quotas and security policies across system interactions.")
}

Rel(Routing_and_Load_Balancing_Engine, EMR_Scheduling_Service, "Routes requests", "gRPC / REST")
Rel(Routing_and_Load_Balancing_Engine, Billing_Service, "Routes requests", "gRPC / REST")
Rel(Authentication_and_Authorization_Filter, External_IdP, "Authenticates users", "OIDC / OAuth2")
Rel(Rate_Limiting_and_Throttling_Module, Redis_Cache, "Queries rate limits", "Redis Protocol / TLS")
Rel(Audit_and_Telemetry_Interceptor, Audit_Compliance_Service, "Sends audit telemetry", "gRPC")

@enduml