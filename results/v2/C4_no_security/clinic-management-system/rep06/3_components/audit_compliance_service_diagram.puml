@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit & Compliance Service container

System_Ext(emr_scheduling, "EMR & Scheduling Service", "External service sending audit events.")

Container_Boundary(audit_compliance_service, "Audit & Compliance Service") {
    Component(IngestionEngine, "Audit Event Ingestion Engine", "Python / FastAPI / Pydantic", "Ingests audit events and validates data structures.")
    Component(StorageWriter, "Immutable Storage Writer", "SQLAlchemy / S3 SDK", "Writes audit logs to immutable storage for compliance.")
    Component(SearchEngine, "Search & Indexing Engine", "Elasticsearch / OpenSearch", "Provides sub-second search and indexing for audit logs.")
    Component(QueryAPI, "Compliance Query & Reporting API", "Python / FastAPI", "Serves queries and reporting for internal officers and external regulators.")
    Component(ReportGenerator, "Report & Cryptographic Export Generator", "Python / ReportLab / Celery / Redis", "Generates cryptographic export reports via asynchronous background processing.")
    Component(StorageTier, "Storage Tier", "WORM Object Storage with S3 Object Lock and Glacier Deep Archive", "Cryptographically secure 10-year data retention storage.")
    Component(KeyMgmt, "Key Management", "HashiCorp Vault / AWS KMS", "Secure cryptographic key management for digital signatures.")
}

Rel(emr_scheduling, IngestionEngine, "gRPC / Apache Kafka", "gRPC / Apache Kafka")
Rel(IngestionEngine, SearchEngine, "REST API / Bulk", "REST API / Bulk")
Rel(IngestionEngine, StorageWriter, "S3 API", "S3 API")
Rel(QueryAPI, SearchEngine, "REST API", "REST API")
Rel(ReportGenerator, StorageTier, "S3 API", "S3 API")
Rel(ReportGenerator, KeyMgmt, "HTTPS / KMS API", "HTTPS / KMS API")

@enduml