@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing Service container

Container_Boundary(billing_service, "Billing Service") {
    Component(Invoice_Controller, "Invoice Controller", "Spring MVC", "Handles REST/gRPC endpoints, invoice generation, and dispute workflows.")
    Component(Claim_Processor, "Claim Processor", "Spring Batch / Integration", "Manages claim generation and batch submission.")
    Component(Payment_Gateway_Client, "Payment Gateway Client", "Spring Cloud OpenFeign / Resilience4j", "Manages external communication with circuit breakers for external communication.")
    Component(Dispute_Manager, "Dispute Manager", "Spring Service", "Handles partial refunds and dispute tracking.")
    Component(Audit_Publisher, "Audit Publisher", "Spring Cloud Stream", "Emits immutable audit events.")
    Component(Billing_Data_Repository, "Billing Data Repository", "Spring Data JPA / Hibernate", "Interacts with PostgreSQL for data persistence.")
}

System_Ext(API_Gateway, "API Gateway / Reverse Proxy", "Routes requests")
System_Ext(Message_Broker, "Message Broker", "Apache Kafka")
System_Ext(Insurance_Gateways, "Insurance/Payer Gateways", "External payer systems")

Rel(API_Gateway, Invoice_Controller, "Routes API requests", "gRPC / REST")
Rel(Claim_Processor, Message_Broker, "Publishes ClaimSubmittedEvent", "Apache Kafka")
Rel(Payment_Gateway_Client, Insurance_Gateways, "Submissions and processing", "HTTPS / REST / EDI X12")
Rel(Audit_Publisher, Message_Broker, "Publishes FinancialAuditLogEvent", "Apache Kafka")
Rel(Dispute_Manager, Billing_Data_Repository, "Persists dispute states", "JPA / JDBC")

@enduml