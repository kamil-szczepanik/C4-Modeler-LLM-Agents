@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration & Interoperability Service container

System_Ext(MessageBroker, "Message Broker", "Apache Kafka")
System_Ext(AuditComplianceService, "Audit & Compliance Service", "Python / FastAPI")
System_Ext(LabImagingSystems, "Lab/Imaging Systems", "External clinical systems")

Container_Boundary(IntegrationInteroperabilityService, "Integration & Interoperability Service") {
    Component(FHIRTranslationEngine, "FHIR Translation Engine", "Camel Routes Component", "Translates and processes health data into FHIR format.")
    Component(HL7v2v3Adapter, "HL7 v2/v3 Adapter", "MLLP/TCP Component", "Handles legacy HL7 v2/v3 communication over MLLP/TCP.")
    Component(DataAnonymizationSecurityFilter, "Data Anonymization & Security Filter", "Spring Security Component", "Enforces token-based OAuth2 validation and data anonymization for compliance.")
    Component(ResilienceDLQHandler, "Resilience & DLQ Handler", "Resilience4j / Kafka Client Component", "Provides circuit breakers and handles dead-letter queues to prevent cascading timeouts.")
}

Rel(FHIRTranslationEngine, MessageBroker, "Consumes/produces events", "Apache Kafka / AMQP")
Rel(DataAnonymizationSecurityFilter, AuditComplianceService, "Offloads audit trails asynchronously", "Apache Kafka")
Rel(FHIRTranslationEngine, LabImagingSystems, "Exchanges health data", "HTTPS/FHIR or MLLP/TCP")
Rel(HL7v2v3Adapter, LabImagingSystems, "Exchanges health data", "HTTPS/FHIR or MLLP/TCP")
Rel(ResilienceDLQHandler, MessageBroker, "Publishes dead-letter and telemetry events", "Kafka")

@enduml