@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(data_tier, "Data Tier") {
    Component(Primary_Relational_DB_Cluster, "Primary Relational DB Cluster", "PostgreSQL", "Active-passive synchronous replication with automated fencing for secure, reliable transactional data storage.")
    Component(Audit_Compliance_WORM_Store, "Audit & Compliance WORM Store", "AWS S3 Object Lock / MinIO", "WORM Object Storage with AES-256 encryption at rest to guarantee immutable 10-year data retention.")
    Component(Change_Data_Capture_Component, "Change Data Capture Component", "Debezium", "Real-time change data capture to decouple microservices without impacting read/write latencies.")
    Component(Connection_Pooling_Component, "Connection Pooling Component", "PgBouncer", "Manages database connections for the EMR and scheduling service.")
    Component(Automated_PITR_Backup_Controller, "Automated PITR & Backup Controller", "Kubernetes / Custom Controller", "Handles automated point-in-time recovery and database backups.")
}

Rel(EMR_Scheduling_Service, Connection_Pooling_Component, "TCP/SQL via PgBouncer (TLS 1.3)")
Rel(Connection_Pooling_Component, Primary_Relational_DB_Cluster, "TCP/SQL (TLS 1.3)")
Rel(Primary_Relational_DB_Cluster, Change_Data_Capture_Component, "TCP (Database Replication Log Stream)")
Rel(Change_Data_Capture_Component, Message_Broker, "TCP")
Rel(Primary_Relational_DB_Cluster, Audit_Compliance_WORM_Store, "HTTPS (S3 API) via WAL Archiver")
@enduml