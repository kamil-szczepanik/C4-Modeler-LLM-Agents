@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "Primary end-users accessing healthcare information and services.")
System_Ext(Enterprise_Identity_Provider_IdP, "Enterprise Identity Provider (IdP)", "Validates credentials and issues JWT.")
System_Ext(API_Gateway_Reverse_Proxy, "API Gateway / Reverse Proxy", "Routes requests to backend services.")
System_Ext(Global_CDN, "Global CDN", "Delivers static assets and executes edge caching/routing.")

Container_Boundary(Patient_Portal_App, "Patient Portal App") {
    Component(Authentication_Controller, "Authentication Controller", "NextAuth.js / OpenID Connect Client", "Manages secure login and multi-factor authentication.")
    Component(Appointment___Scheduling_UI_Module, "Appointment & Scheduling UI Module", "React components", "Handles self-service visit booking and resource clash visibility.")
    Component(EMR_Viewer_Module, "EMR Viewer Module", "React components", "Renders medical records and lab results with data masking.")
    Component(Billing___Payments_Interface, "Billing & Payments Interface", "React components", "Handles secure online payments and claim statuses.")
    Component(Accessibility___Design_System_Module, "Accessibility & Design System Module", "React", "Enforces WCAG 2.1 AA compliance across all views.")
    Component(Telemetry___Client_Monitoring_Agent, "Telemetry & Client Monitoring Agent", "OpenTelemetry SDK", "Collects OpenTelemetry traces and RUM performance metrics.")
}

Rel(Patients, Authentication_Controller, "Manages healthcare information and scheduling", "HTTPS")
Rel(Authentication_Controller, Enterprise_Identity_Provider_IdP, "Validates credentials & issues JWT", "OIDC/HTTPS")
Rel(Appointment___Scheduling_UI_Module, API_Gateway_Reverse_Proxy, "Fetches domain data", "HTTPS/REST")
Rel(EMR_Viewer_Module, API_Gateway_Reverse_Proxy, "Fetches domain data", "HTTPS/REST")
Rel(Billing___Payments_Interface, API_Gateway_Reverse_Proxy, "Fetches domain data", "HTTPS/REST")
Rel(Appointment___Scheduling_UI_Module, Accessibility___Design_System_Module, "Applies a11y standards", "React Context")
Rel(EMR_Viewer_Module, Accessibility___Design_System_Module, "Applies a11y standards", "React Context")
Rel(Billing___Payments_Interface, Accessibility___Design_System_Module, "Applies a11y standards", "React Context")
Rel(Authentication_Controller, Telemetry___Client_Monitoring_Agent, "Reports performance metrics & anonymized error logs", "Internal Async")
Rel(Appointment___Scheduling_UI_Module, Telemetry___Client_Monitoring_Agent, "Reports performance metrics & anonymized error logs", "Internal Async")
Rel(EMR_Viewer_Module, Telemetry___Client_Monitoring_Agent, "Reports performance metrics & anonymized error logs", "Internal Async")
Rel(Billing___Payments_Interface, Telemetry___Client_Monitoring_Agent, "Reports performance metrics & anonymized error logs", "Internal Async")
Rel(Accessibility___Design_System_Module, Telemetry___Client_Monitoring_Agent, "Reports performance metrics & anonymized error logs", "Internal Async")
@enduml