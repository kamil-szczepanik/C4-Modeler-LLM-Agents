@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Clinical Web/Mobile App container

System_Ext(api_gateway, "API Gateway / Reverse Proxy", "NGINX / Envoy")

Container_Boundary(clinical_web_mobile_app, "Clinical Web/Mobile App") {
    Component(state_and_local_storage_manager, "State & Local Storage Manager", "Redux Toolkit / WatermelonDB with encrypted SQLite", "Manages state and local storage with offline resilience and AES-256 encryption.")
    Component(auth_and_session_guard_component, "Auth & Session Guard Component", "OpenID Connect / JWT SDK", "Handles authentication, session security, and clears local encrypted cache upon timeout.")
    Component(clinical_workspace_module, "Clinical Workspace Module", "React / React Native components", "Provides clinical and administrative UI features for workspace operations.")
    Component(telemetry_and_error_boundary_component, "Telemetry & Error Boundary Component", "Sentry SDK / React Error Boundaries", "Captures error boundaries and forwards scrubbed crash reports and performance metrics.")
}

Rel(clinical_workspace_module, api_gateway, "Fetches and submits clinical data", "HTTPS/REST")
Rel(telemetry_and_error_boundary_component, api_gateway, "Forwards scrubbed crash reports and performance metrics", "HTTPS/POST")
Rel(state_and_local_storage_manager, clinical_workspace_module, "Hydrates UI state", "In-Memory")
Rel(auth_and_session_guard_component, state_and_local_storage_manager, "Clears local encrypted cache upon session timeout", "In-Memory")

@enduml