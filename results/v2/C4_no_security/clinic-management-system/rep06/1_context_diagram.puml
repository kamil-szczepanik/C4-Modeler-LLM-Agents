@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "End users who interact with the system for scheduling and managing their healthcare information.")
Person(Clinicians, "Clinicians", "Medical professionals who access and update Electronic Medical Records (EMRs) and patient admissions.")
Person(AdministrativeStaff, "Administrative Staff", "Personnel responsible for clinic operations, scheduling, and general management within the system.")
Person(BillingOfficers, "Billing Officers", "Staff members handling financial transactions, billing, and claims processing.")

System(ClinicManagementSystem, "Clinic Management System", "A hybrid cloud platform managing patient admissions, EMRs, scheduling, and billing, ensuring high availability and HIPAA/GDPR compliance for medium-sized clinics and hospitals.")

System_Ext(InsurancePayerGateways, "Insurance/Payer Gateways", "External systems for processing medical claims and insurance verifications.")
System_Ext(ExternalLabImagingSystems, "External Lab/Imaging Systems", "External systems providing laboratory results and medical imaging data.")
System_Ext(IdentityProviderIdP, "Identity Provider (IdP)", "External system responsible for user authentication and authorization.")
System_Ext(KubernetesOnPremisesandAWS, "Kubernetes On-Premises and AWS", "Active-active hybrid infrastructure hosting the system containers.")

Rel(Patients, ClinicManagementSystem, "Interacts with the system for admissions, scheduling, and EMR access", "HTTPS/TLS 1.3 with Multi-Factor Authentication")
Rel(Clinicians, ClinicManagementSystem, "Manages patient admissions and EMRs", "HTTPS/TLS 1.3 with Multi-Factor Authentication")
Rel(AdministrativeStaff, ClinicManagementSystem, "Handles administrative tasks and scheduling", "HTTPS/TLS 1.3 with Multi-Factor Authentication")
Rel(BillingOfficers, ClinicManagementSystem, "Processes billing and claims", "HTTPS/TLS 1.3 with Multi-Factor Authentication")
Rel(ClinicManagementSystem, IdentityProviderIdP, "Authenticates users", "OIDC/OAuth2")
Rel(ClinicManagementSystem, InsurancePayerGateways, "Submits and manages insurance claims", "REST/JSON over HTTPS")
Rel(ClinicManagementSystem, ExternalLabImagingSystems, "Retrieves lab and imaging results", "HL7 FHIR APIs (RESTful)")
@enduml