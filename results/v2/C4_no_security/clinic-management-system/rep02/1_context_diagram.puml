@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Clinic Management System

Person(Patients, "Patients", "Individuals receiving care who interact via web browsers and the mobile app to manage appointments and view records.")
Person(Clinical Staff, "Clinical Staff", "Medical professionals who access and update Electronic Medical Records (EMRs) and patient schedules.")
Person(Administrative Staff, "Administrative Staff", "Personnel responsible for managing patient admissions, scheduling, and front-desk operations.")
Person(Billing & Finance Officers, "Billing & Finance Officers", "Staff members handling patient billing, insurance claims, and financial transactions.")
Person(System/Compliance Administrators, "System/Compliance Administrators", "IT and compliance personnel managing system configurations, security, and auditing.")

System_Ext(Web Browsers, "Web Browsers", "Client interface used by patients, staff, and administrators to access the system.")
System_Ext(Patient Mobile App, "Patient Mobile App", "Mobile client application used by patients for on-the-go access.")
System_Ext(External Lab & Imaging Systems, "External Lab & Imaging Systems", "External systems providing laboratory test results and medical imaging data.")
System_Ext(Third-Party Payment Gateway & Insurance Clearinghouse, "Third-Party Payment Gateway & Insurance Clearinghouse", "External services processing financial transactions and insurance claims.")
System_Ext(Identity Provider (IdP), "Identity Provider (IdP)", "External authentication system handling Multi-Factor Authentication (MFA) and Enterprise SSO.")
System_Ext(Audit & Compliance SIEM, "Audit & Compliance SIEM", "External system receiving immutable log streaming for security auditing and compliance.")

System(Clinic Management System, "Clinic Management System", "A hybrid cloud platform managing patient admissions, EMRs, scheduling, and billing for clinical environments while ensuring HIPAA/GDPR compliance and 99.99% availability.")

Rel(Web Browsers, Clinic Management System, "Accesses web interactions and system features securely.", "HTTPS/TLS 1.3")
Rel(Patient Mobile App, Clinic Management System, "Accesses mobile services and patient portal features securely.", "HTTPS/TLS 1.3")
Rel(Clinic Management System, Identity Provider (IdP), "Authenticates users via Multi-Factor Authentication and Enterprise SSO.", "OAuth2/OIDC")
Rel(Clinic Management System, External Lab & Imaging Systems, "Exchanges clinical data and lab results.", "HL7 FHIR REST APIs over HTTPS")
Rel(Clinic Management System, Third-Party Payment Gateway & Insurance Clearinghouse, "Processes payments and insurance claims.", "Secure REST APIs over HTTPS")
Rel(Clinic Management System, Audit & Compliance SIEM, "Streams immutable logs for compliance and monitoring.", "Secure syslog/HTTPS")

@enduml