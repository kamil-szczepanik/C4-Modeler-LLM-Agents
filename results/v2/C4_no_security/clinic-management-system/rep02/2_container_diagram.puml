@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Patients, "Patients", "Individuals receiving care who interact via web browsers and the mobile app to manage appointments and view records.")
Person(Clinical Staff, "Clinical Staff", "Medical professionals who access and update Electronic Medical Records (EMRs) and patient schedules.")
Person(Administrative Staff, "Administrative Staff", "Personnel responsible for managing patient admissions, scheduling, and front-desk operations.")
Person(Billing Officers, "Billing Officers", "Staff members handling patient billing, insurance claims, and financial transactions.")
Person(Compliance Administrators, "Compliance Administrators", "IT and compliance personnel managing system configurations, security, and auditing.")

System_Ext(Web Browsers, "Web Browsers", "Client interface used by patients, staff, and administrators to access the system.")
System_Ext(Patient Mobile App, "Patient Mobile App", "Mobile client application used by patients for on-the-go access.")
System_Ext(Lab & Imaging Systems, "Lab & Imaging Systems", "External systems providing laboratory test results and medical imaging data.")
System_Ext(Payment Gateway, "Payment Gateway", "External service processing financial transactions.")
System_Ext(Identity Provider, "Identity Provider", "External authentication system handling Multi-Factor Authentication and Enterprise SSO.")
System_Ext(SIEM, "SIEM", "External system receiving log streaming for security auditing and compliance.")

System_Boundary(Clinic Management System, "Clinic Management System") {
    Container(React SPA, "React SPA", "React", "Frontend single page application for web users.")
    Container(Node.js Mobile BFF, "Node.js Mobile BFF", "Node.js / Express", "Backend-for-frontend service handling mobile client requests.")
    Container(API Gateway, "API Gateway", "Nginx / Kong", "Gateway handling routing, security, and traffic management.")
    Container(Service Mesh, "Service Mesh", "Istio / Linkerd", "Infrastructure layer managing internal service-to-service communication.")
    Container(Clinical Services, "Clinical Services", "Java / Spring Boot", "Core backend services handling patient registration, EMR, and scheduling.")
    Container(Billing Services, "Billing Services", "Python / FastAPI", "Backend services handling billing and financial operations.")
    Container(HAPI FHIR Interoperability, "HAPI FHIR Interoperability", "Java", "Interoperability service providing FHIR standards support.")
    Container(Notification Worker, "Notification Worker", "Go", "Worker service for handling asynchronous notifications.")
    Container(Compliance Worker, "Compliance Worker", "Python", "Worker service handling compliance and long-term data retention.")
    ContainerDb(PostgreSQL, "PostgreSQL", "PostgreSQL with AES-256 encryption", "Relational database for operational data.")
    Container(Apache Kafka, "Apache Kafka", "Apache Kafka", "Event-driven messaging broker for asynchronous decoupling.")
    Container(Tiered Storage, "Tiered Storage", "S3-compatible Storage", "Long-term tiered storage for data retention and compliance archives.")
}

Rel(Web Browsers, API Gateway, "Sends user web requests", "HTTPS/OAuth2")
Rel(Patient Mobile App, Node.js Mobile BFF, "Sends mobile client requests", "HTTPS/OAuth2")
Rel(Node.js Mobile BFF, API Gateway, "Forwards aggregated mobile requests", "HTTPS")
Rel(API Gateway, Clinical Services, "Routes requests via service mesh", "gRPC over mTLS")
Rel(API Gateway, Billing Services, "Routes requests via service mesh", "gRPC over mTLS")
Rel(API Gateway, HAPI FHIR Interoperability, "Routes requests via service mesh", "gRPC over mTLS")
Rel(Clinical Services, Apache Kafka, "Publishes asynchronous events", "TCP")
Rel(Billing Services, Apache Kafka, "Publishes and consumes asynchronous events", "TCP")
Rel(Notification Worker, Apache Kafka, "Consumes event notifications", "TCP")
Rel(Clinical Services, PostgreSQL, "Reads and writes clinical data", "JDBC / TLS")
Rel(Billing Services, PostgreSQL, "Reads and writes billing data", "JDBC / TLS")
Rel(Billing Services, Payment Gateway, "Processes financial transactions", "REST")
Rel(HAPI FHIR Interoperability, Lab & Imaging Systems, "Exchanges clinical and lab data", "HL7 FHIR / REST")
Rel(Compliance Worker, Tiered Storage, "Stores long-term compliance archives", "HTTPS with AES-256")
Rel(Clinical Services, Identity Provider, "Authenticates tokens and sessions", "OAuth2/OIDC")

@enduml