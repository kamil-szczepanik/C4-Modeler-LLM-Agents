@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(HAPI_FHIR_Interoperability, "HAPI FHIR Interoperability") {
    Component(FHIR_REST_Facade, "FHIR REST Facade", "Java / HAPI FHIR", "Exposes standard RESTful FHIR endpoints for inbound client and external system requests.")
    Component(Validation_Engine, "Validation Engine", "Java", "Validates incoming and outgoing FHIR resources against structure definitions and profiles.")
    Component(Data_Transformation_Engine, "Data Transformation Engine", "Java", "Transforms data formats and maps legacy models to compliant FHIR resources.")
    Component(Consent_Enforcement_Interceptor, "Consent Enforcement Interceptor", "Java", "Enforces patient consent and privacy rules to ensure HIPAA/GDPR compliance on resource access.")
    Component(Outbox_Pattern_Worker, "Outbox Pattern Worker", "Java", "Reliably publishes domain events to the message broker using the transactional outbox pattern.")
}

Rel(FHIR_REST_Facade, Validation_Engine, "Passes incoming payloads for structural and profile validation")
Rel(FHIR_REST_Facade, Consent_Enforcement_Interceptor, "Queries access permissions and consent rules")
Rel(Validation_Engine, Data_Transformation_Engine, "Sends validated data for mapping and transformation")
Rel(Data_Transformation_Engine, Outbox_Pattern_Worker, "Triggers event generation for persisted state changes")

@enduml