@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL container

System_Ext(clinical_services, "Clinical Services", "External clinical services interacting with the database.")
System_Ext(billing_services, "Billing Services", "External billing services interacting with the database.")
System_Ext(apache_kafka, "Apache Kafka", "Event streaming platform.")

Container_Boundary(postgresql, "PostgreSQL") {
    Component(operational_database_engine, "Operational Database Engine", "PostgreSQL 16", "Relational database engine chosen for robust ACID compliance and advanced partitioning features.")
    Component(row_level_security_rls_enforcer, "Row-Level Security (RLS) Enforcer", "PostgreSQL Extension", "Enforces data access policies at the row level for HIPAA/GDPR compliance.")
    Component(partition_manager, "Partition Manager", "PostgreSQL Native Partitioning", "Manages data partitioning to decouple hot operational data from cold archival records.")
    Component(cdc_outreach_publisher, "CDC Outreach Publisher", "Debezium", "Captures and publishes audit logs and event streams to Apache Kafka.")
    Component(encryption_masking_module, "Encryption & Masking Module", "PostgreSQL Native / Extension", "Encrypts and masks PHI for secure access by clinical services.")
    Component(pgbouncer, "PgBouncer", "PgBouncer", "Connection pooling utility implemented to protect database resources under heavy clinical loads.")
    Component(tiered_storage, "Tiered Storage", "S3-compatible", "Cost-effective storage backend chosen to meet the >= 10 years data retention mandate.")
}

Rel(clinical_services, encryption_masking_module, "Queries encrypted/masked PHI", "JDBC / TLS 1.3")
Rel(billing_services, operational_database_engine, "Reads and writes billing data", "JDBC / TLS")
Rel(partition_manager, tiered_storage, "Offloads cold historical records", "S3 API / HTTPS")
Rel(cdc_outreach_publisher, apache_kafka, "Publishes audit logs and event streams", "TCP / Kafka Wire Protocol")

@enduml