@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(clinical_services, "Clinical Services") {
    Component(Patient_Registration, "Patient Registration", "Java / Spring Boot", "Manages patient admissions and registration workflows.")
    Component(Scheduling, "Scheduling", "Java / Spring Boot", "Handles appointments and scheduling workflows for healthcare facilities.")
    Component(EMR_Management, "EMR Management", "Java / Spring Boot", "Manages electronic medical records (EMR) and interacts with caching and encryption layers.")
    Component(Event_Publisher, "Event Publisher", "Java / Spring Boot", "Publishes asynchronous domain events to the message broker.")
    Component(Caching, "Caching", "Java / Spring Boot", "Handles caching operations for performance optimization.")
}

System_Ext(Redis, "Redis", "Caching layer for EMR data.")
System_Ext(AWS_KMS_HSM, "AWS KMS/HSM", "Storage and security for cryptographic keys.")
System_Ext(Apache_Kafka, "Apache Kafka", "Message broker for asynchronous domain events.")
System_Ext(PostgreSQL, "PostgreSQL", "Database with AES-256 encryption.")

Rel(EMR_Management, Redis, "Caches clinical views", "TCP over TLS")
Rel(EMR_Management, AWS_KMS_HSM, "Retrieves cryptographic keys", "HTTPS over mTLS")
Rel(Event_Publisher, Apache_Kafka, "Publishes asynchronous domain events", "TCP")
Rel(Patient_Registration, PostgreSQL, "Reads and writes clinical data", "JDBC over TLS")
Rel(Scheduling, PostgreSQL, "Reads and writes clinical data", "JDBC over TLS")
Rel(EMR_Management, PostgreSQL, "Reads and writes clinical data", "JDBC over TLS")

@enduml