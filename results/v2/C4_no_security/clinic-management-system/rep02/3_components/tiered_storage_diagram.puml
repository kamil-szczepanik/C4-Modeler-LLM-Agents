@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Tiered Storage container

Container_Boundary(tiered_storage, "Tiered Storage") {
    Component(Archive_Manager, "Archive Manager", "Java / Spring Boot", "Handles ingestion, compression, and AES-256 client-side encryption.")
    Component(Lifecycle_Policy_Engine, "Lifecycle Policy Engine", "Java / Spring Boot", "Manages S3 object lifecycle rules and S3 Object Lock.")
    Component(Retrieval_Hydration_Service, "Retrieval & Hydration Service", "Java / Spring Boot", "Executes accelerated S3 restores with a <5-minute SLA.")
    Component(S3_Compatible_Storage, "S3-Compatible Storage", "S3-Compatible Storage / Glacier", "Provides secure, immutable cloud object storage.")
    Component(Apache_Kafka, "Apache Kafka", "Apache Kafka", "Transmits asynchronous event notifications.")
    Component(Notification_Worker, "Notification Worker", "Java / Spring Boot", "Dispatches alerts to clinical staff upon hydration completion.")
}

Component_Ext(Compliance_Worker, "Compliance Worker", "External Component", "Pushes retention archives")
Component_Ext(UI_Clinician, "UI/Clinician", "External System", "Receives alerts")

Rel(Compliance_Worker, Archive_Manager, "Pushes retention archives", "gRPC / HTTPS")
Rel(Retrieval_Hydration_Service, S3_Compatible_Storage, "Initiates accelerated restores", "AWS SDK / HTTPS")
Rel(Retrieval_Hydration_Service, Apache_Kafka, "Publishes DataHydratedEvent", "")
Rel(Apache_Kafka, Notification_Worker, "Consumes hydration events", "")
Rel(Notification_Worker, UI_Clinician, "Pushes in-app or email alerts", "")

@enduml