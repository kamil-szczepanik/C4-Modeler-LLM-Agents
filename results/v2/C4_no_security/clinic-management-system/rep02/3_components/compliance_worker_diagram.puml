@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(compliance_worker, "Compliance Worker") {
    Component(Audit_Log_Ingestion, "Audit Log Ingestion", "Python / Celery", "Consumes audit logs from Apache Kafka for compliance processing.")
    Component(Retention_Policy_Engine, "Retention Policy Engine", "Python / Celery", "Manages data retention policies and schedules compliance jobs.")
    Component(Tiered_Storage_Archiver, "Tiered Storage Archiver", "Python / Celery", "Writes archives to S3-compatible Tiered Storage using HTTPS / S3 API with WORM headers.")
    Component(Report_Generation, "Report Generation", "Python / Celery", "Generates compliance and audit reports.")
}

Rel(Audit_Log_Ingestion, Retention_Policy_Engine, "Feeds ingested audit logs into")
Rel(Retention_Policy_Engine, Tiered_Storage_Archiver, "Triggers archiving for expired data based on retention policies")
Rel(Retention_Policy_Engine, Report_Generation, "Provides data for")

@enduml