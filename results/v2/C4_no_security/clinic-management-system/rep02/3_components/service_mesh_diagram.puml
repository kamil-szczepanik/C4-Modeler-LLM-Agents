@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(service_mesh, "Service Mesh") {
    Component(SidecarProxyEnvoy, "Sidecar Proxy (Envoy)", "Envoy", "High-performance proxy for sidecar and gateway duties ensuring low latency and secure mTLS communication.")
    Component(ControlPlaneIstiod, "Control Plane (Istiod)", "Istio", "Configures Sidecar Proxies via gRPC/xDS for zero-trust security and traffic management.")
    Component(TelemetryCollector, "Telemetry Collector", "Prometheus & OpenTelemetry Collector", "Collects metrics and distributed tracing without PII leaks, exporting logs to Audit & Compliance SIEM.")
    Component(AuthorizationPolicyEngine, "Authorization Policy Engine", "Istio Security", "Enforces strict zero-trust security and data encryption policies to satisfy HIPAA and GDPR mandates.")
    Component(IngressEgressGateway, "Ingress/Egress Gateway", "Envoy Gateway / cert-manager", "Manages external traffic via HTTPS/TLS 1.3 and provides automated certificate rotation.")
    Component(ClinicalServices, "Clinical Services", "Java / Spring Boot", "Provides patient admissions, EMR, and clinical domain processing.")
    Component(BillingServices, "Billing Services", "Python / FastAPI", "Handles billing domain microservices backend processing.")
    Component(PostgreSQLApacheKafka, "PostgreSQL & Apache Kafka", "PostgreSQL, Apache Kafka", "Data persistence and event streaming infrastructure.")
}

Rel(ClinicalServices, SidecarProxyEnvoy, "Communicates via HTTP/gRPC over mTLS (TLS 1.3)", "HTTP/gRPC, mTLS")
Rel(BillingServices, SidecarProxyEnvoy, "Communicates via HTTP/gRPC over mTLS (TLS 1.3)", "HTTP/gRPC, mTLS")
Rel(ControlPlaneIstiod, SidecarProxyEnvoy, "Configures via gRPC/xDS", "gRPC/xDS")
Rel(TelemetryCollector, SidecarProxyEnvoy, "Exports logs to Audit & Compliance SIEM via HTTP/gRPC", "HTTP/gRPC")
Rel(IngressEgressGateway, SidecarProxyEnvoy, "Manages external traffic via HTTPS/TLS 1.3", "HTTPS/TLS 1.3")

@enduml