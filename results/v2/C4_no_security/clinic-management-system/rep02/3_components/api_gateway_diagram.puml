@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(jwt_oauth2_validator, "JWT/OAuth2 Validator", "Kong/Nginx Plugin", "Validates JSON Web Tokens and OAuth2 credentials for incoming requests.")
    Component(rate_limiting_throttling, "Rate Limiting & Throttling", "Kong/Nginx Plugin", "Enforces traffic limits and prevents abuse using distributed Redis state.")
    Component(routing_transform_engine, "Routing & Transform Engine", "Kong/Nginx Configuration", "Routes inbound traffic to the appropriate backend services and transforms payloads.")
    Component(audit_logging_interceptor, "Audit Logging Interceptor", "Kong/Nginx Interceptor", "Captures and streams HIPAA audit events to the compliance SIEM.")
    Component(priority_policy_engine, "Priority & Policy Engine", "Kong/Nginx Custom Policy Plugin", "Ensures emergency clinical traffic is prioritized and never throttled by batch operations.")
}

Rel(jwt_oauth2_validator, routing_transform_engine, "Passes authenticated requests to")
Rel(rate_limiting_throttling, routing_transform_engine, "Applies traffic constraints to")
Rel(priority_policy_engine, routing_transform_engine, "Applies priority rules to")
Rel(routing_transform_engine, audit_logging_interceptor, "Triggers audit logs for")

@enduml