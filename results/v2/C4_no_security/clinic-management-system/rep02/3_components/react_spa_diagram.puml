@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the React SPA container

System_Ext(identity_provider, "Identity Provider (IdP)", "External Identity Provider handling OAuth2 / OIDC authentication.")
System_Ext(api_gateway, "API Gateway", "Nginx / Kong gateway handling REST and WSS requests.")
System_Ext(aws_cloudfront_cdn, "AWS CloudFront CDN", "Content Delivery Network for static asset delivery.")

Container_Boundary(react_spa, "React SPA") {
    Component(auth_session_manager, "Auth & Session Manager", "React Context, SessionStorage, Local Caching", "Manages user authentication sessions, form-state persistence, and local caching to optimize EMR load times and maintain compliance.")
    Component(routing_rbac_guard, "Routing & RBAC Guard", "React Router, TypeScript", "Enforces strict role-based access control (RBAC) and routing for clinical, administrative, and billing staff.")
    Component(api_client, "API Client", "OpenAPI, Fetch, WSS", "Handles low-latency REST communication via OpenAPI and real-time updates via WSS with the API Gateway.")
    Component(feature_modules, "Feature Modules", "React, Component-based UI framework", "Includes Patient Registration UI, Appointment Scheduler, EMR Viewer & Editor, and Billing Console for daily clinic operations.")
    Component(telemetry_rum_agent, "Telemetry & RUM Agent", "Sentry, Real User Monitoring (RUM)", "Provides client-side error tracking and performance monitoring to ensure high availability and sub-second interactions.")
}

Rel(auth_session_manager, identity_provider, "Authenticates via HTTPS", "OAuth2 / OIDC with PKCE")
Rel(api_client, api_gateway, "Sends HTTPS / JSON (REST) requests and maintains WSS", "HTTPS / JSON, WSS")
Rel(react_spa, aws_cloudfront_cdn, "Fetches static asset delivery", "HTTPS")

@enduml