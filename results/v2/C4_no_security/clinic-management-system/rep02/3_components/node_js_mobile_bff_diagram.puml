@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Patient_Mobile_App, "Patient Mobile App", "External client application used by patients.")

Container_Boundary(node_js_mobile_bff, "Node.js Mobile BFF") {
    Component(Route_Handler_Controller, "Route Handler / Controller", "Node.js & Express.js", "Handles client requests from the Patient Mobile App and coordinates processing.")
    Component(Security_Sanitization_Middleware, "Security & Sanitization Middleware", "Express.js Middleware", "Sanitizes inputs and ensures security compliance for incoming requests.")
    Component(Session_Token_Cache, "Session & Token Cache", "Redis (ioredis)", "Validates tokens and manages distributed sessions with TLS support.")
    Component(Aggregation_Transformation_Service, "Aggregation & Transformation Service", "Node.js", "Delegates and processes payload transformation for optimized mobile performance.")
    Component(Telemetry_Interceptor, "Telemetry Interceptor", "OpenTelemetry", "Injects tracing context and captures latency metrics across boundaries.")
}

System_Ext(API_Gateway, "API Gateway", "Nginx / Kong", "Forwards downstream calls via gRPC over HTTP/2.")

Rel(Patient_Mobile_App, Route_Handler_Controller, "Sends client requests", "HTTPS/OAuth2")
Rel(Route_Handler_Controller, Security_Sanitization_Middleware, "Passes incoming requests", "In-memory")
Rel(Route_Handler_Controller, Session_Token_Cache, "Validates tokens and sessions", "TCP/TLS via ioredis")
Rel(Route_Handler_Controller, Aggregation_Transformation_Service, "Delegates payload processing", "In-memory")
Rel(Aggregation_Transformation_Service, Telemetry_Interceptor, "Injects tracing context", "In-memory")
Rel(Telemetry_Interceptor, API_Gateway, "Forwards downstream calls", "gRPC over HTTP/2")

@enduml