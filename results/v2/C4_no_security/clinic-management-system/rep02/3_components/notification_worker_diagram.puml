@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification Worker container

Container_Boundary(notification_worker, "Notification Worker") {
    Component(Kafka_Event_Consumer, "Kafka Event Consumer", "Go", "Subscribes to input event streams.")
    Component(Preference___Routing_Engine, "Preference & Routing Engine", "Go", "Enforces PHI redaction and maps user preferences.")
    Component(Template_Engine_Component, "Template Engine Component", "Go", "Renders localized templates using dynamic object storage.")
    Component(Channel_Dispatcher_Adapters, "Channel Dispatcher Adapters", "Go", "Interfaces for SMTP and Twilio/APNS SDKs.")
    Component(DLQ___Audit_Router, "DLQ & Audit Router", "Go", "Manages retry logic and failed message persistence.")
}

Rel(Kafka_Event_Consumer, Preference___Routing_Engine, "Consumes raw notification events", "")
Rel(Preference___Routing_Engine, Template_Engine_Component, "Maps user preferences and requests templates", "")
Rel(Template_Engine_Component, Channel_Dispatcher_Adapters, "Sends rendered messages for dispatch", "")
Rel(Channel_Dispatcher_Adapters, DLQ___Audit_Router, "Routes failed deliveries to DLQ", "")

@enduml