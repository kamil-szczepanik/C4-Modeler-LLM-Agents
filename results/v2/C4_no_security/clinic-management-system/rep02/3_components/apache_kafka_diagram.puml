@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Apache Kafka container

Person_Ext(clinical_billing_services, "Clinical & Billing Services", "External services publishing and consuming domain events")

Container_Boundary(kafka_container, "Apache Kafka") {
    Component(kraft_controller_quorum, "KRaft Controller Quorum", "Java/Scala", "Replaces ZooKeeper for cluster metadata management and faster failovers.")
    Component(kafka_broker, "Kafka Broker", "Apache Kafka runtime", "Event-driven messaging broker for asynchronous service decoupling and high availability.")
    Component(storage_tier_manager, "Storage Tier Manager", "Kafka LogSegments", "Manages Kafka log segments for message processing and retention.")
    Component(schema_registry, "Schema Registry", "Confluent Schema Registry, Java", "Enforces Avro/Protobuf data contracts for long-term data governance.")
    Component(strimzi_operator, "Strimzi Operator", "Kubernetes", "Manages Kubernetes-native deployment across hybrid environments.")
}

System_Ext(tiered_storage, "Tiered Storage", "S3-compatible Storage", "Satisfies the 10-year data retention mandate with AES-256 encryption.")

Rel(clinical_billing_services, kafka_broker, "Publishes and consumes domain events", "TCP / Kafka Protocol with SASL/TLS")
Rel(kafka_broker, kraft_controller_quorum, "Replicates cluster state", "TCP")
Rel(kraft_controller_quorum, kafka_broker, "Replicates cluster state", "TCP")
Rel(kafka_broker, tiered_storage, "Offloads historical log segments", "HTTPS / S3 API")
Rel(kafka_broker, schema_registry, "Validates event schemas", "HTTP/REST over TCP")
Rel(schema_registry, kafka_broker, "Validates event schemas", "HTTP/REST over TCP")

@enduml