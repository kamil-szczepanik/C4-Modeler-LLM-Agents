@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers and Registered Reviewers, "Customers and Registered Reviewers", "Web and mobile users who browse books, manage carts, make purchases, and write reviews.")
Person(Store Administrators, "Store Administrators", "Internal management users who oversee operations and platform administration.")
System(Online Bookstore System, "Online Bookstore System", "An Amazon-style e-commerce platform delivering global book purchasing, recommendations, and reviews with high availability, GDPR compliance, and sub-second performance.")
System_Ext(Stripe / PayPal, "Stripe / PayPal", "Payment Gateway Provider handling payment processing.")
System_Ext(FedEx / UPS, "FedEx / UPS", "Third-Party Shipping APIs for label generation and tracking.")
System_Ext(AWS SES / SendGrid, "AWS SES / SendGrid", "Email and Notification Service for transactional alerts.")
System_Ext(Avalara / TaxJar, "Avalara / TaxJar", "Tax Calculation Service for real-time tax estimation.")

Rel(Customers and Registered Reviewers, Online Bookstore System, "Browsing, cart, and checkout operations", "HTTPS (Web/Mobile)")
Rel(Store Administrators, Online Bookstore System, "Internal management and administration", "HTTPS")
Rel(Online Bookstore System, Stripe / PayPal, "Payment processing", "HTTPS / REST API (TLS 1.3)")
Rel(Online Bookstore System, FedEx / UPS, "Label generation and tracking", "HTTPS / REST API")
Rel(Online Bookstore System, Avalara / TaxJar, "Real-time tax estimation", "HTTPS / REST API")
Rel(Online Bookstore System, AWS SES / SendGrid, "Transactional alerts and notifications", "HTTPS / SMTP")

@enduml