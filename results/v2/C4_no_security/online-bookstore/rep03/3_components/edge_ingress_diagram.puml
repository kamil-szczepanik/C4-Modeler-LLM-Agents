@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Component(DNS_Router, "DNS Router", "Amazon Route 53", "Provides latency-based global DNS routing and automatic multi-region failover.")
Component(Client_Frontend, "Client Frontend", "React, AWS CloudFront, Amazon S3", "Serves client interface and initiates HTTPS requests over TLS to the API Gateway.")
Component(Downstream_Containers, "Downstream Containers", "Catalog, Order, Review Containers", "Microservices receiving internal gRPC traffic from the edge routing layer.")

Container_Boundary(Edge_Ingress, "Edge & Ingress") {
    Component(API_Gateway_Service, "API Gateway Service", "Amazon API Gateway", "Handles rate-limiting, OWASP Top-10 mitigations, TLS termination, and response caching for anonymous catalog searches.")
    Component(Auth_Token_Verifier_Component, "Auth & Token Verifier Component", "In-memory validation", "Validates authentication and security tokens for incoming requests.")
    Component(Request_Router_Transformer_Component, "Request Router & Transformer Component", "gRPC over TLS with AWS X-Ray", "Transforms and routes requests to downstream containers with localization headers and trace contexts.")
}

Rel(Client_Frontend, API_Gateway_Service, "HTTPS over TLS")
Rel(API_Gateway_Service, Auth_Token_Verifier_Component, "In-memory validation")
Rel(Auth_Token_Verifier_Component, Request_Router_Transformer_Component, "Internal routing")
Rel(Request_Router_Transformer_Component, Downstream_Containers, "gRPC over TLS with AWS X-Ray Trace Context and localization headers")
Rel(DNS_Router, API_Gateway_Service, "Latency-based DNS routing with health-check failover")
@enduml