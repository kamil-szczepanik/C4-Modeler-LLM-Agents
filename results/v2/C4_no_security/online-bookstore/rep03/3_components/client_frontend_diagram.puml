@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(client_frontend, "Client Frontend") {
    Component(RoutingShellComponent, "Routing & Shell Component", "React Router", "Handles application routing and initializes core services.")
    Component(CatalogRecommendationUI, "Catalog & Recommendation UI", "React, Tailwind CSS", "Displays product catalogs and personalized recommendations.")
    Component(CartCheckoutUI, "Cart & Checkout UI", "React", "Manages shopping cart operations and secure checkout processes.")
    Component(ReviewRatingUI, "Review & Rating UI", "React", "Allows users to submit and view product reviews and ratings.")
    Component(ComplianceLocalizationService, "Compliance & Localization Service", "Client-side module", "Ensures GDPR/CCPA compliance and handles multi-currency browsing.")
    Component(StateStorageManager, "State & Storage Manager", "Zustand, LocalStorage Adapter", "Manages persistent local state for carts and currency preferences.")
}

Rel(RoutingShellComponent, ComplianceLocalizationService, "Initializes services", "In-memory")
Rel(RoutingShellComponent, StateStorageManager, "Initializes services", "In-memory")
Rel(CartCheckoutUI, StateStorageManager, "Reads and writes local cart and currency state", "In-memory / LocalStorage")

@enduml