@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(edge_ingress, "Edge & Ingress", "External ingress routing requests.")
System_Ext(amazon_eventbridge, "Amazon EventBridge", "Event bus handling asynchronous integrations.")
System_Ext(amazon_aurora_postgresql, "Amazon Aurora PostgreSQL", "Relational database storing reviews, votes, and aggregates.")

Container_Boundary(review_rating_container, "Review & Rating Container") {
    Component(review_api_controller, "Review API Controller", "Django REST Framework", "Django REST Framework endpoint handling CRUD operations and filtering.")
    Component(event_consumer_component, "Event Consumer Component", "Celery", "Celery worker processing OrderCompleted and UserDeletionRequested events.")
    Component(engagement_engine, "Engagement Engine", "Python module", "Python module calculating aggregate ratings and helpful votes.")
    Component(data_access_layer, "Data Access Layer", "Django ORM", "Django ORM interfacing with database storage.")
}

Rel(edge_ingress, review_api_controller, "Forwards review requests", "gRPC over TLS")
Rel(amazon_eventbridge, event_consumer_component, "Delivers `OrderCompleted` and `UserDeletionRequested` events", "AWS SQS")
Rel(review_api_controller, amazon_aurora_postgresql, "Queries and persists review data", "TCP/PostgreSQL Protocol")

@enduml