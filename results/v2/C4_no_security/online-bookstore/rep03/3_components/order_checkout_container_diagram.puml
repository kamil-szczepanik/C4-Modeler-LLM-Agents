@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Order & Checkout Container container

System_Ext(Edge_Ingress, "Edge & Ingress", "External gateway routing incoming client traffic.")

Container_Boundary(Order_Checkout_Container, "Order & Checkout Container") {
    Component(Cart_Management_Component, "Cart Management Component", "Node.js / Express", "Manages low-latency shopping sessions and ephemeral cart state.")
    Component(Checkout_Orchestrator_Component, "Checkout Orchestrator Component", "Java / Spring Boot", "Coordinates complex, multi-step transactional checkout workflows and guarantees idempotency.")
    Component(Payment_Fulfillment_Gateway_Client, "Payment & Fulfillment Gateway Client", "Java", "Invokes external payment and tax integrations securely.")
    Component(Event_Publisher_Component, "Event Publisher Component", "Java / Spring Cloud Stream", "Dispatches domain events asynchronously.")
    Component(Audit_Support_Query_Component, "Audit & Support Query Component", "Node.js", "Queries order audit trails for support and administrative purposes.")
    ComponentDb(Amazon_DynamoDB, "Amazon DynamoDB", "Amazon DynamoDB", "Persists ephemeral shopping cart sessions with low latency.")
    ComponentDb(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Stores transactional records and audit logs with automated failover.")
    Component(Amazon_SQS_SNS, "Amazon SQS / SNS", "Amazon SQS / SNS with DLQs", "Decouples fulfillment and transactional email tasks asynchronously.")
}

Rel(Edge_Ingress, Cart_Management_Component, "Forwards client requests", "gRPC over TLS")
Rel(Edge_Ingress, Checkout_Orchestrator_Component, "Forwards client requests", "gRPC over TLS")
Rel(Edge_Ingress, Audit_Support_Query_Component, "Queries order audit trails", "gRPC over TLS")
Rel(Checkout_Orchestrator_Component, Payment_Fulfillment_Gateway_Client, "Invokes payment and tax integrations", "Internal REST/gRPC")
Rel(Checkout_Orchestrator_Component, Event_Publisher_Component, "Dispatches domain events", "Spring Application Events")
Rel(Event_Publisher_Component, Amazon_SQS_SNS, "Publishes order events", "AWS SDK / HTTPS")

@enduml