@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Catalog_Search_Container", "Catalog & Search Container") {
    Component(API_Gateway_Router_Component, "API Gateway / Router Component", "Go", "Forwards search requests and routes internal queries.")
    Component(Search_Query_Component, "Search & Query Component", "Spring Boot", "Implements robust search query handling.")
    Component(Indexing_Synchronization_Component, "Indexing & Synchronization Component", "Spring Boot", "Implements indexing logic and consumes CDC events and clickstream payloads.")
    Component(Recommendation_Component, "Recommendation Component", "Go", "Powers recommendation processing for low latency.")
    Component(Amazon_OpenSearch, "Amazon OpenSearch", "Amazon OpenSearch", "Stores searchable catalog data and powers ML/KNN recommendations.")
    Component(Amazon_SQS, "Amazon SQS", "Amazon SQS", "Buffers clickstream data to prevent ingestion saturation.")
}

Rel(API_Gateway_Router_Component, Search_Query_Component, "Routes internal queries", "gRPC")
Rel(Indexing_Synchronization_Component, Amazon_SQS, "Consumes CDC events and clickstream payloads", "SQS Polling")
Rel(Search_Query_Component, Amazon_OpenSearch, "Executes queries and retrieves indices", "HTTPS / REST client")
Rel(Recommendation_Component, Amazon_OpenSearch, "Executes queries and retrieves indices", "HTTPS / REST client")

@enduml