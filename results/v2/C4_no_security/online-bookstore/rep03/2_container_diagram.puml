@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore System

Person(CasualShoppers, "Casual Shoppers", "Users who browse books, search the catalog, and view recommendations.")
Person(Buyers, "Buyers", "Customers who manage carts, complete multi-currency checkouts, and purchase books.")
Person(ContributorsReviewers, "Contributors/Reviewers", "Users who write reviews and rate books on the platform.")

System_Ext(StripePayPal, "Stripe/PayPal", "Payment Gateway Provider handling payment processing.")
System_Ext(FedExUPS, "FedEx/UPS", "Third-Party Shipping APIs for fulfillment and tracking.")
System_Ext(AvalaraTaxJar, "Avalara/TaxJar", "Tax Calculation Service for real-time tax estimation.")
System_Ext(AWSSESSendGrid, "AWS SES/SendGrid", "Email and Notification Service for transactional alerts.")

System_Boundary(OnlineBookstoreSystem, "Online Bookstore System") {
    Container(ClientFrontend, "Client Frontend", "React, AWS CloudFront, Amazon S3", "Single Page Application hosted on AWS CloudFront/S3 providing the user interface.")
    Container(EdgeIngress, "Edge & Ingress", "Amazon Route 53, Amazon API Gateway", "Handles latency-based DNS routing, rate-limiting, and JWT validation.")
    Container(CatalogSearchContainer, "Catalog & Search Container", "Spring Boot, Go, Amazon OpenSearch", "Handles rapid catalog browsing and personalized recommendations.")
    Container(OrderCheckoutContainer, "Order & Checkout Container", "Node.js, Java, Amazon Aurora PostgreSQL, Amazon DynamoDB", "Manages orders, cart sessions, and multi-currency checkout.")
    Container(ReviewRatingContainer, "Review & Rating Container", "Python, Django, Amazon Aurora PostgreSQL", "Manages user reviews and book ratings.")
}

Rel(CasualShoppers, ClientFrontend, "Browses catalog and views recommendations", "HTTPS")
Rel(Buyers, ClientFrontend, "Manages cart and completes checkout", "HTTPS")
Rel(ContributorsReviewers, ClientFrontend, "Writes reviews and rates books", "HTTPS")
Rel(ClientFrontend, EdgeIngress, "Sends client requests via DNS and API Gateway", "HTTPS over TLS")
Rel(EdgeIngress, CatalogSearchContainer, "Forwards catalog and search requests", "gRPC over TLS")
Rel(EdgeIngress, OrderCheckoutContainer, "Forwards order and checkout requests", "gRPC over TLS")
Rel(EdgeIngress, ReviewRatingContainer, "Forwards review and rating requests", "gRPC over TLS")
Rel(OrderCheckoutContainer, StripePayPal, "Processes payments", "Synchronous HTTPS via App Mesh / Envoy")
Rel(OrderCheckoutContainer, FedExUPS, "Handles shipping and fulfillment", "Synchronous HTTPS via App Mesh / Envoy")
Rel(OrderCheckoutContainer, AvalaraTaxJar, "Calculates real-time taxes", "Synchronous HTTPS via App Mesh / Envoy")
Rel(OrderCheckoutContainer, AWSSESSendGrid, "Sends transactional emails", "HTTPS")

@enduml