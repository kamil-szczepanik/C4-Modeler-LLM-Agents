@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_cloudfront_amazon_s3, "AWS CloudFront & Amazon S3") {
    Component(CloudFront_Distribution, "CloudFront Distribution", "AWS CloudFront", "Provides global content delivery and edge caching for static assets.")
    Component(Amazon_S3_Bucket, "Amazon S3 Bucket", "Amazon S3", "Stores static assets for the Single Page Application.")
}

Rel(CloudFront_Distribution, Amazon_S3_Bucket, "Fetches static assets via HTTPS [IAM OAC]", "HTTPS")

@enduml