@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_sqs_sns_with_dlqs, "AWS SQS/SNS with DLQs") {
    Component(Amazon_SNS, "Amazon SNS", "AWS SNS", "Pubsub messaging service used to broadcast order and system events.")
    Component(Amazon_SQS_Notification_Queue, "Amazon SQS Notification Queue", "AWS SQS", "Message queue holding asynchronous events for the Notification Service.")
    Component(Amazon_SQS_Recommendation_Queue, "Amazon SQS Recommendation Queue", "AWS SQS", "Message queue holding asynchronous events for the Recommendation Worker.")
    Component(Dead_Letter_Queues_DLQs, "Dead Letter Queues (DLQs)", "AWS SQS", "Queues for capturing failed or unprocessable messages for troubleshooting.")
}

Rel(Amazon_SNS, Amazon_SQS_Notification_Queue, "Broadcasts order events to", "HTTPS")
Rel(Amazon_SNS, Amazon_SQS_Recommendation_Queue, "Broadcasts order events to", "HTTPS")
Rel(Amazon_SQS_Notification_Queue, Dead_Letter_Queues_DLQs, "Routes failed messages to", "")
Rel(Amazon_SQS_Recommendation_Queue, Dead_Letter_Queues_DLQs, "Routes failed messages to", "")
@enduml