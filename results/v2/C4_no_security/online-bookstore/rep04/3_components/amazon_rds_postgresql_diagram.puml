@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon RDS PostgreSQL container

Container_Boundary(rds_postgresql, "Amazon RDS PostgreSQL") {
    Component(Primary Database Instance, "Primary Database Instance", "PostgreSQL", "Handles write operations and ensures transactional integrity for orders and user data.")
    Component(Read Replicas, "Read Replicas", "PostgreSQL Read Replicas", "Handles read-heavy workloads such as catalog browsing and reviews to reduce load on the primary database.")
}

Rel(Primary Database Instance, Read Replicas, "Replicates transactional data", "PostgreSQL Replication")

@enduml