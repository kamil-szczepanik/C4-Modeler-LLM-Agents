@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_api_gateway, "AWS API Gateway") {
    Component(Authorizer, "Authorizer", "Amazon API Gateway v2/HTTP API Authorizer", "Validates OAuth2/JWT tokens for incoming requests.")
    Component(Throttling, "Throttling", "Amazon API Gateway Rate-Limiting", "Manages rate-limiting and protects backend services from high traffic loads.")
    Component(Routing, "Routing", "Amazon API Gateway HTTP API Routing", "Routes incoming HTTPS REST/JSON and gRPC-Web requests to backend ECS/Fargate microservices via AWS VPC Link.")
}

Rel(Authorizer, Throttling, "Passes authenticated requests to")
Rel(Throttling, Routing, "Forwards rate-limited requests to")

@enduml