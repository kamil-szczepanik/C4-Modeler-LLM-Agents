@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog Service container

Container_Boundary(catalog_service, "Catalog Service") {
    Component(Product_API_Controller, "Product API Controller", "Spring Boot / Node.js", "Handles incoming product-related API requests and routes them to internal components.")
    Component(Search_Filter_Engine, "Search & Filter Engine", "In-memory / Java/Node.js", "Provides search and filter capabilities for catalog items.")
    Component(Catalog_Management_Domain_Logic, "Catalog Management Domain Logic", "Spring Boot / Node.js", "Contains core business logic for managing the product catalog.")
    Component(Cache_Aside_Proxy, "Cache-Aside Proxy", "Redis Protocol", "Manages caching for top-selling books and promotional banners with circuit breakers.")
    Component(Data_Access_Layer, "Data Access Layer", "JDBC", "Handles database interactions with Amazon RDS PostgreSQL.")
    Component(Localized_Pricing_Service, "Localized Pricing Service", "In-memory / Microservice logic", "Manages multi-currency and regional pricing logic.")
    Component(Search_Analytics_Collector, "Search Analytics Collector", "AWS SDK", "Collects search analytics and publishes events asynchronously to Amazon SQS.")
}

System_Ext(Amazon_SQS, "Amazon SQS", "Asynchronous message queue")

Rel(Product_API_Controller, Search_Filter_Engine, "Routes requests", "In-memory")
Rel(Catalog_Management_Domain_Logic, Localized_Pricing_Service, "Gets pricing", "In-memory")
Rel(Catalog_Management_Domain_Logic, Cache_Aside_Proxy, "Manages cache", "In-memory")
Rel(Catalog_Management_Domain_Logic, Data_Access_Layer, "Reads/Writes data", "JDBC")
Rel(Search_Filter_Engine, Amazon_SQS, "Publishes events", "AWS SDK")

@enduml