@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Shopper, "Shopper", "Global end-user browsing and purchasing books.")
System_Ext(AWSCloudFrontAmazonS3, "AWS CloudFront & Amazon S3", "Global content delivery and edge caching layer.")

Container_Boundary(AWS_Route_53, "AWS Route 53") {
    Component(HostedZone, "Hosted Zone", "AWS Route 53 Public Hosted Zone", "Manages authoritative DNS records and emits anonymized query logs.")
    Component(RoutingPoliciesEngine, "Routing Policies Engine", "AWS Route 53 Latency-Based and Geoproximity Routing", "Routes traffic globally based on latency and geoproximity.")
    Component(HealthCheckProbes, "Health Check Probes", "AWS Route 53 global HTTP/HTTPS probes", "Monitors edge availability.")
    Component(DNSFailoverController, "DNS Failover Controller", "AWS Route 53 Failover & Weighted Routing", "Manages active-passive/active-active failover and weighted routing.")
    Component(QueryLoggingAuditingComponent, "Query Logging & Auditing Component", "Route 53 Query Logging with Amazon CloudWatch", "Captures anonymized DNS query metrics for traffic analysis and DDoS detection while ensuring GDPR/CCPA compliance.")
}

Rel(Shopper, HostedZone, "Resolves domain", "DNS")
Rel(RoutingPoliciesEngine, AWSCloudFrontAmazonS3, "Routes traffic globally", "HTTPS")
Rel(HealthCheckProbes, AWSCloudFrontAmazonS3, "Monitors edge availability", "HTTPS GET")
Rel(HostedZone, QueryLoggingAuditingComponent, "Emits anonymized query logs", "Internal AWS Stream")

@enduml