@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(user_compliance_service, "User & Compliance Service") {
    Component(profile_controller, "Profile Controller", "Spring MVC / Express.js", "Manages user profiles and authentication requests.")
    Component(compliance_manager, "Compliance Manager", "Spring Boot / Node.js", "Handles GDPR/CCPA data compliance workflows.")
    Component(audit_logger, "Audit Logger", "Spring Data JPA / TypeORM", "Persists immutable audit logs for compliance tracking.")
    Component(erasure_event_publisher, "Erasure Event Publisher", "AWS SDK", "Publishes UserDeletedEvent for asynchronous event-driven data erasure.")
}

Rel(profile_controller, compliance_manager, "Delegates compliance requests")
Rel(compliance_manager, audit_logger, "Records audit logs")
Rel(compliance_manager, erasure_event_publisher, "Triggers data erasure events")

@enduml