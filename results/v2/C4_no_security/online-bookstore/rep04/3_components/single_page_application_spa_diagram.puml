@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(spa_boundary, "Single Page Application (SPA)") {
    Component(Routing_Shell_Component, "Routing & Shell Component", "React & React Router", "Client-side routing and module lazy-loading for navigation and shell layout.")
    Component(Catalog_Search_Module, "Catalog & Search Module", "React & TypeScript", "Enables book discovery and search functionality.")
    Component(Cart_Checkout_Module, "Cart & Checkout Module", "React, Zustand, Local Storage & IndexedDB", "Manages shopping cart items and secure multi-currency checkout with local persistence.")
    Component(Reviews_Recommendations_Module, "Reviews & Recommendations Module", "React & TypeScript", "Displays book reviews and recommendations.")
    Component(API_Client_State_Manager, "API Client & State Manager", "Zustand & TanStack Query (React Query)", "Handles server-state management, caching, request deduplication, and offline retry logic.")
}

System_Ext(AWS_API_Gateway, "AWS API Gateway", "Gateway handling HTTPS REST/GraphQL requests from the SPA.")
System_Ext(Amazon_CloudFront_Amazon_S3, "Amazon CloudFront & Amazon S3", "Edge caching, content delivery, and hosting for SPA artifacts.")

Rel(Routing_Shell_Component, Catalog_Search_Module, "In-memory state and props", "Props / State")
Rel(Routing_Shell_Component, Cart_Checkout_Module, "In-memory state and props", "Props / State")
Rel(Routing_Shell_Component, Reviews_Recommendations_Module, "In-memory state and props", "Props / State")
Rel(Catalog_Search_Module, API_Client_State_Manager, "In-memory function calls", "Function Call")
Rel(Cart_Checkout_Module, API_Client_State_Manager, "In-memory function calls", "Function Call")
Rel(Reviews_Recommendations_Module, API_Client_State_Manager, "In-memory function calls", "Function Call")
Rel(API_Client_State_Manager, AWS_API_Gateway, "HTTPS, REST/GraphQL", "HTTPS")
Rel(Cart_Checkout_Module, Amazon_CloudFront_Amazon_S3, "Zustand Persist Middleware", "Local Storage")
@enduml