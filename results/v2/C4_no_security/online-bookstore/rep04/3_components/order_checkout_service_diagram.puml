@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(order_checkout_service, "Order & Checkout Service") {
    Component(cart_controller_manager, "Cart Controller & Manager", "Spring Boot / Node.js", "Manages shopping cart operations and session states.")
    Component(checkout_orchestrator, "Checkout Orchestrator", "Spring Boot / Node.js", "Orchestrates the checkout workflow across services and adapters.")
    Component(promotions_component, "Promotions Component", "Spring Boot / Node.js", "Evaluates and applies promo codes and discounts.")
    Component(payment_adapter, "Payment Adapter", "Spring Boot / Node.js", "Integrates with external payment gateways for secure transactions.")
    Component(fulfillment_adapter, "Fulfillment Adapter", "Spring Boot / Node.js", "Integrates with shipping provider APIs to manage fulfillment.")
    Component(order_repository_component, "Order Repository Component", "Spring Boot / Node.js", "Handles data persistence for transactional order data.")
    Component(event_dispatcher_component, "Event Dispatcher Component", "Spring Boot / Node.js", "Publishes domain events using the Transactional Outbox Pattern.")
    Component(resilience_layer, "Resilience Layer", "Resilience4j", "Protects adapters and external calls from downstream outages.")
}

System_Ext(amazon_rds_postgresql, "Amazon RDS PostgreSQL", "Relational database for ACID-compliant financial ledgers and order data.")
System_Ext(amazon_elasticache_redis, "Amazon ElastiCache (Redis)", "In-memory data store for low-latency session management, temporary cart state, and promo code lookups.")
System_Ext(aws_sqs_sns, "AWS SQS/SNS", "Managed messaging service for asynchronous event-driven workflows and failure isolation.")

Rel(checkout_orchestrator, payment_adapter, "Processes secure transactions via HTTPS/REST", "HTTPS/REST")
Rel(checkout_orchestrator, fulfillment_adapter, "Manages fulfillment via HTTPS/REST", "HTTPS/REST")
Rel(order_repository_component, amazon_rds_postgresql, "Persists transactional order data via JDBC/SQL", "JDBC/SQL")
Rel(cart_controller_manager, amazon_elasticache_redis, "Caches sessions and cart state via Redis Protocol", "Redis Protocol")
Rel(promotions_component, amazon_elasticache_redis, "Performs promo lookups via Redis Protocol", "Redis Protocol")
Rel(event_dispatcher_component, aws_sqs_sns, "Publishes domain events using AWS SDK with Transactional Outbox Pattern", "AWS SDK")

@enduml