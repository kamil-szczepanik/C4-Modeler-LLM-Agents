@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(catalog_service, "Catalog Service", "External service interacting with the cache")
Person(order_checkout_service, "Order & Checkout Service", "External service interacting with the cache")

Container_Boundary(amazon_elasticache_redis, "Amazon ElastiCache (Redis)") {
    Component(Catalog_Cache_Component, "Catalog Cache Component", "Amazon ElastiCache for Redis (Cluster Mode Enabled)", "Stores serialized book metadata, search facets, and cached third-party recommendations.")
    Component(Session_Cart_Cache_Component, "Session & Cart Cache Component", "Amazon ElastiCache for Redis (Cluster Mode Enabled)", "Stores ephemeral user session tokens and active shopping cart hashes with strict non-eviction policies.")
    Component(Inventory_Counter_Component, "Inventory Counter Component", "Amazon ElastiCache for Redis (Cluster Mode Enabled)", "Stores atomic integer counters for real-time stock levels during flash sales.")
}

Rel(catalog_service, Catalog_Cache_Component, "Retrieves book metadata and recommendations", "Redis Protocol (rediss://)")
Rel(order_checkout_service, Session_Cart_Cache_Component, "Manages session state and active carts", "Redis Protocol (rediss://)")
Rel(order_checkout_service, Inventory_Counter_Component, "Executes atomic inventory decrements", "Redis Protocol (rediss://)")

@enduml