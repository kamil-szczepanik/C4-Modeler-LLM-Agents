@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon DynamoDB container

System_Ext(order_checkout_service, "Order & Checkout Service", "Amazon ECS/Fargate")
System_Ext(catalog_service, "Catalog Service", "Amazon ECS/Fargate")
System_Ext(recommendation_worker, "Recommendation Worker", "Amazon ECS/Fargate")

Container_Boundary(amazon_dynamodb, "Amazon DynamoDB") {
    Component(shopping_cart_table, "Shopping Cart Table", "AWS DynamoDB Table", "Manages ephemeral shopping cart state with single-digit millisecond latency.")
    Component(promotions_deals_table, "Promotions & Deals Table", "AWS DynamoDB Table", "Stores promotional metadata and deals data.")
    Component(user_activity_stream_table, "User Activity Stream Table", "AWS DynamoDB Table with DynamoDB Streams", "Captures user activity streams and browse history for asynchronous processing.")
}

Rel(order_checkout_service, shopping_cart_table, "Reads/writes ephemeral cart data via AWS SDK", "HTTPS / IAM")
Rel(catalog_service, promotions_deals_table, "Reads promotional metadata via AWS SDK", "HTTPS / IAM")
Rel(user_activity_stream_table, recommendation_worker, "Streams browse history via AWS SDK", "HTTPS")

@enduml