@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification Service container

Person(Shoppers_Customer_Support_Agents, "Shoppers & Customer Support Agents", "End-users receiving alerts and internal staff auditing sent notifications.")

System_Ext(AWS_SQS, "AWS SQS", "Asynchronous messaging backbone ensuring message durability.")
System_Ext(User_Compliance_Service, "User & Compliance Service", "External compliance and user service.")
System_Ext(SendGrid_Twilio_APIs, "SendGrid/Twilio APIs", "External third-party notification providers.")
System_Ext(Amazon_DynamoDB, "Amazon DynamoDB", "Storage for audit trails and support lookup histories.")

Container_Boundary(Notification_Service, "Notification Service") {
    Component(Event_Consumer_Component, "Event Consumer Component", "Spring Boot / Node.js", "Service ingesting messages from AWS SQS.")
    Component(Notification_Router_Component, "Notification Router Component", "Amazon ElastiCache (Redis)", "Internal orchestrator managing message flow and idempotency.")
    Component(Preference_Compliance_Manager_Component, "Preference & Compliance Manager Component", "REST / HTTPS", "Validator querying the User & Compliance Service.")
    Component(Template_Engine_Component, "Template Engine Component", "Compiled resource bundles", "Localized rendering engine.")
    Component(Channel_Dispatcher_Components, "Channel Dispatcher Components", "Resilience4j", "Adapters using circuit breakers for SendGrid (Email) and Twilio (SMS).")
    Component(Notification_Repository_Component, "Notification Repository Component", "Amazon DynamoDB", "Data access layer persisting audit trails.")
}

Rel(Event_Consumer_Component, AWS_SQS, "Consumes asynchronous notification requests", "AMQP/SQS")
Rel(Preference_Compliance_Manager_Component, User_Compliance_Service, "Verifies GDPR/CCPA consent and suppression lists", "REST/HTTPS")
Rel(Channel_Dispatcher_Components, SendGrid_Twilio_APIs, "Dispatches final payloads to external providers", "HTTPS")
Rel(Notification_Repository_Component, Amazon_DynamoDB, "Persists delivery states and audit logs", "TCP")

@enduml