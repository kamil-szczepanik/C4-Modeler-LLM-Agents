@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Shopper, "Shopper", "End-user browsing, purchasing, and reviewing via web/mobile.")
Person(CustomerSupportAgent, "Customer Support Agent", "Internal user managing GDPR data erasure and fulfillment.")

System(OnlineBookstoreSystem, "Online Bookstore System", "Global e-commerce platform providing physical and electronic book sales with integrated reviews, recommendations, and multi-currency support.")

System_Ext(PaymentGateway, "Payment Gateway", "External PCI-compliant checkout service (Stripe/PayPal).")
System_Ext(ShippingProviderAPIs, "Shipping Provider APIs", "External fulfillment and tracking service (FedEx/UPS).")
System_Ext(IdentityProvider, "Identity Provider", "External OIDC/OAuth2 authentication service (Auth0/AWS Cognito).")
System_Ext(ThirdPartyRecommendationEngine, "Third-Party Recommendation Engine", "External SaaS for product recommendations (AWS Personalize).")
System_Ext(AWSRoute53, "AWS Route 53", "Global DNS and Anycast routing layer.")

Rel(Shopper, OnlineBookstoreSystem, "Browsing, cart, and checkout", "HTTPS (Web/Mobile)")
Rel(CustomerSupportAgent, OnlineBookstoreSystem, "Support and compliance workflows", "HTTPS (Admin Portal)")
Rel(OnlineBookstoreSystem, PaymentGateway, "Financial transactions", "HTTPS/REST")
Rel(OnlineBookstoreSystem, ShippingProviderAPIs, "Order fulfillment and labels", "HTTPS/REST")
Rel(OnlineBookstoreSystem, IdentityProvider, "Authentication and profile management", "OIDC/OAuth2")
Rel(OnlineBookstoreSystem, ThirdPartyRecommendationEngine, "Asynchronous event ingestion and local region caching", "HTTPS/REST")

@enduml