@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore System

Person(BookShopper, "Book Shopper", "End user browsing the catalog, managing a cart, purchasing books, leaving reviews, and receiving personalized recommendations.")
Person(BookAuthorPublisher, "Book Author/Publisher", "User managing book listings, inventory, and publishing content to the platform.")
Person(StoreAdministrator, "Store Administrator", "User managing platform operations, user accounts, system configuration, and monitoring overall system health.")

System_Ext(StripePayPal, "Stripe/PayPal", "Payment Gateway handling secure financial transactions and checkouts.")
System_Ext(FedExUPSAPIs, "FedEx/UPS APIs", "Shipping Carrier APIs handling physical book delivery and tracking.")
System_Ext(AWSSES, "AWS SES", "Email Service handling transactional and marketing notifications.")
System_Ext(AWSCognitoAuth0, "AWS Cognito/Auth0", "Identity Provider managing authentication, authorization, and user identity via OAuth2/OIDC.")
System_Ext(AWSCloudFrontRoute53, "AWS CloudFront/Route 53", "CDN and Traffic Manager handling global edge routing, sub-2s page loads, and TLS termination.")
System_Ext(AWSCloudWatchDatadog, "AWS CloudWatch/Datadog", "Telemetry and observability platform providing centralized logging and distributed tracing.")

System_Boundary(OnlineBookstoreSystem, "Online Bookstore System") {
    Container(SinglePageApplication, "Single Page Application", "React / TypeScript, hosted on AWS S3", "Client application delivering the user interface for shoppers, authors, and administrators.")
    Container(AWSAPIGateway, "AWS API Gateway", "AWS API Gateway (REST / GraphQL)", "API layer routing incoming client requests to backend services.")
    Container(CatalogSearchService, "Catalog & Search Service", "Spring Boot (Java) / Python (FastAPI)", "Manages book catalog listings, inventory, and search functionality.")
    Container(OrderCheckoutService, "Order & Checkout Service", "Spring Boot (Java)", "Handles shopping cart management, order processing, and checkout workflows.")
    Container(PersonalizationService, "Personalization Service", "Python (FastAPI/Celery)", "Provides integrated book recommendations for users.")
    Container(CustomerReviewService, "Customer Review Service", "Node.js / Express", "Manages customer reviews and ratings for books.")
    Container(NotificationService, "Notification Service", "Node.js / Express", "Handles sending emails and handling shipping coordination.")
    ContainerDb(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Relational database storing structured transactional data.")
    ContainerDb(AmazonDynamoDB, "Amazon DynamoDB", "Amazon DynamoDB", "NoSQL data store for low-latency operational data.")
    ContainerDb(AmazonOpenSearch, "Amazon OpenSearch", "Amazon OpenSearch", "Search and analytics engine powering catalog search.")
    ContainerDb(Redis, "Redis", "Redis (ElastiCache)", "In-memory data store and cache.")
    Container(AmazonEventBridgeandAmazonSQS, "Amazon EventBridge and Amazon SQS", "Amazon EventBridge / Amazon SQS", "Inter-service messaging and event bus for asynchronous decoupling.")
}

Rel(BookShopper, AWSCloudFrontRoute53, "Browses catalog, places orders, and interacts with the platform", "HTTPS via TLS 1.3")
Rel(BookAuthorPublisher, AWSCloudFrontRoute53, "Manages catalog listings and published content", "HTTPS via TLS 1.3")
Rel(StoreAdministrator, AWSCloudFrontRoute53, "Administers platform operations and monitors system health", "HTTPS via TLS 1.3")
Rel(AWSCloudFrontRoute53, SinglePageApplication, "Delivers static assets and frontend application", "HTTPS")
Rel(SinglePageApplication, AWSAPIGateway, "Sends API requests for data and actions", "HTTPS / REST / GraphQL")
Rel(AWSAPIGateway, CatalogSearchService, "Routes catalog and search requests", "Internal HTTPS / gRPC")
Rel(AWSAPIGateway, OrderCheckoutService, "Routes order and checkout requests", "Internal HTTPS / gRPC")
Rel(AWSAPIGateway, PersonalizationService, "Routes recommendation requests", "Internal HTTPS / gRPC")
Rel(AWSAPIGateway, CustomerReviewService, "Routes review-related requests", "Internal HTTPS / gRPC")
Rel(AWSAPIGateway, NotificationService, "Routes notification requests", "Internal HTTPS / gRPC")
Rel(CatalogSearchService, AmazonAuroraPostgreSQL, "Reads and writes catalog data", "JDBC / AWS SDK")
Rel(CatalogSearchService, AmazonOpenSearch, "Indexes and queries search data", "AWS SDK")
Rel(OrderCheckoutService, AmazonAuroraPostgreSQL, "Reads and writes order data", "JDBC / AWS SDK")
Rel(PersonalizationService, AmazonDynamoDB, "Reads and writes user preference and recommendation data", "AWS SDK")
Rel(CustomerReviewService, AmazonDynamoDB, "Reads and writes review data", "AWS SDK")
Rel(CatalogSearchService, Redis, "Caches catalog data", "Redis Protocol / AWS SDK")
Rel(OrderCheckoutService, StripePayPal, "Processes payments and checkouts", "HTTPS")
Rel(NotificationService, AWSSES, "Sends emails and system notifications", "AWS SDK")
Rel(NotificationService, FedExUPSAPIs, "Coordinates physical book shipping and tracking", "AWS SDK / HTTPS")
Rel(OrderCheckoutService, AmazonEventBridgeandAmazonSQS, "Publishes and consumes order events", "AWS SDK")
Rel(NotificationService, AmazonEventBridgeandAmazonSQS, "Consumes async messaging for notifications", "AWS SDK")
Rel(SinglePageApplication, AWSCognitoAuth0, "Authenticates users and validates sessions", "OAuth2/OIDC over HTTPS")
Rel(SinglePageApplication, AWSCloudWatchDatadog, "Sends telemetry and logs", "HTTPS")
Rel(CatalogSearchService, AWSCloudWatchDatadog, "Sends telemetry and logs", "HTTPS")
Rel(OrderCheckoutService, AWSCloudWatchDatadog, "Sends telemetry and logs", "HTTPS")
Rel(PersonalizationService, AWSCloudWatchDatadog, "Sends telemetry and logs", "HTTPS")
Rel(CustomerReviewService, AWSCloudWatchDatadog, "Sends telemetry and logs", "HTTPS")
Rel(NotificationService, AWSCloudWatchDatadog, "Sends telemetry and logs", "HTTPS")

@enduml