@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Personalization Service container

System_Ext(aws_api_gateway, "AWS API Gateway", "External API Gateway")

Container_Boundary(personalization_service, "Personalization Service") {
    Component(recommendation_api_router, "Recommendation API Router", "Python / FastAPI", "Routes synchronous queries and handles incoming recommendation requests.")
    Component(recommendation_engine, "Recommendation Engine", "Python / NumPy / scikit-learn", "Triggers inference and powers collaborative filtering and recommendation heuristics.")
    Component(event_consumer_worker, "Event Consumer Worker", "Python / Celery", "Consumes clickstream events asynchronously.")
    Component(data_access_layer, "Data Access Layer", "Python / boto3", "Fetches user profiles, reads/writes vectors, and executes purges.")
    Component(amazon_dynamodb, "Amazon DynamoDB", "Multi-region Global Tables", "NoSQL database utilized for fast profile lookups and global replication.")
    Component(amazon_sqs, "Amazon SQS", "Event ingestion queue", "Messaging infrastructure ensuring resilient event delivery.")
    Component(amazon_elasticache_redis, "Amazon ElastiCache (Redis)", "Region-local caching", "Caching layer minimizing cross-region latency and absorbing traffic spikes.")
    Component(aws_cloudwatch_datadog, "AWS CloudWatch / Datadog", "Telemetry and alerts", "Emits telemetry and metrics for monitoring.")
}

Rel(aws_api_gateway, recommendation_api_router, "Routes synchronous queries", "Internal HTTPS / gRPC")
Rel(recommendation_api_router, recommendation_engine, "Triggers inference", "In-memory function call with 200ms timeout")
Rel(recommendation_engine, data_access_layer, "Fetches user profiles", "Python / boto3")
Rel(event_consumer_worker, amazon_sqs, "Consumes clickstream events", "AWS SDK / Long-polling")
Rel(data_access_layer, amazon_dynamodb, "Reads/writes vectors and executes purges", "HTTPS / AWS SDK")
Rel(data_access_layer, amazon_elasticache_redis, "Caches user profiles locally", "TCP / Redis Protocol")
Rel(recommendation_api_router, aws_cloudwatch_datadog, "Emits telemetry and metrics", "HTTPS")
Rel(recommendation_engine, aws_cloudwatch_datadog, "Emits telemetry and metrics", "HTTPS")
Rel(event_consumer_worker, aws_cloudwatch_datadog, "Emits telemetry and metrics", "HTTPS")
Rel(data_access_layer, aws_cloudwatch_datadog, "Emits telemetry and metrics", "HTTPS")

@enduml