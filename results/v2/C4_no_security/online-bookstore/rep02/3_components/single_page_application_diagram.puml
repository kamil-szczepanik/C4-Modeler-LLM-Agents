@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Single Page Application container

Container_Boundary(spa, "Single Page Application") {
    Component(RoutingShellComponent, "Routing & Shell Component", "React / TypeScript", "Manages application navigation, layout structure, and overall shell.")
    Component(ConsentLocalizationProvider, "Consent & Localization Provider", "React / TypeScript", "Handles multi-currency, localization, and strict GDPR/CCPA consent compliance.")
    Component(CatalogSearchComponent, "Catalog & Search Component", "React / TypeScript", "Provides lightning-fast book browsing, search, and filtering.")
    Component(CheckoutCartComponent, "Checkout & Cart Component", "React / TypeScript", "Manages secure checkout and shopping cart workflows.")
    Component(ReviewsRecommendationsComponent, "Reviews & Recommendations Component", "React / TypeScript", "Displays customer reviews and personalized book recommendations.")
    Component(AdminAuthorDashboardComponent, "Admin & Author Dashboard Component", "React / TypeScript", "Provides dashboard interfaces for store administrators, authors, and publishers.")
    Component(StateTelemetryComponent, "State & Telemetry Component", "Zustand & React Query, Datadog RUM SDK", "Manages efficient global state, server-state caching, and telemetry/RUM metrics.")
}

Rel(RoutingShellComponent, CatalogSearchComponent, "Renders and navigates to")
Rel(RoutingShellComponent, CheckoutCartComponent, "Renders and navigates to")
Rel(RoutingShellComponent, ReviewsRecommendationsComponent, "Renders and navigates to")
Rel(RoutingShellComponent, AdminAuthorDashboardComponent, "Renders and navigates to")
Rel(CatalogSearchComponent, StateTelemetryComponent, "Uses for state caching and data fetching")
Rel(CheckoutCartComponent, StateTelemetryComponent, "Uses for state management")
Rel(ReviewsRecommendationsComponent, StateTelemetryComponent, "Uses for state management")
Rel(AdminAuthorDashboardComponent, StateTelemetryComponent, "Uses for state management")

@enduml