@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS API Gateway container

Container_Boundary(aws_api_gateway, "AWS API Gateway") {
    Component(rest_api_router, "REST API Router", "AWS API Gateway REST Endpoint", "Routes incoming REST requests from the Single Page Application to appropriate backend microservices.")
    Component(graphql_api_router, "GraphQL API Router", "AWS API Gateway GraphQL Endpoint", "Handles GraphQL queries and mutations from the client for flexible data fetching.")
    Component(auth_validator, "Authentication Validator", "AWS API Gateway Lambda Authorizer / JWT", "Validates JWT tokens for authentication in conjunction with AWS Cognito/Auth0.")
    Component(caching_module, "Regional Caching and Throttling Module", "AWS API Gateway Native Caching & Throttling", "Manages regional response caching and request throttling to ensure high availability and performance.")
}

System_Ext(catalog_service, "Catalog & Search Service", "Microservice handling catalog data and search functionality.")
System_Ext(order_service, "Order & Checkout Service", "Microservice handling secure orders and checkout.")
System_Ext(cognito, "AWS Cognito/Auth0", "External identity provider for authentication.")

Rel(rest_api_router, catalog_service, "Routes search requests", "Internal HTTPS / gRPC")
Rel(rest_api_router, order_service, "Routes secure checkout payloads", "Internal HTTPS / gRPC")
Rel(graphql_api_router, catalog_service, "Forwards catalog queries", "Internal HTTPS / gRPC")
Rel(rest_api_router, auth_validator, "Delegates token validation")
Rel(auth_validator, cognito, "Validates JWT tokens", "HTTPS")

@enduml