@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Amazon EventBridge and Amazon SQS", "Amazon EventBridge and Amazon SQS") {
    Component(CentralEventBus, "Central Event Bus", "Amazon EventBridge", "Routes asynchronous events across microservices and integrates with KMS for payload encryption.")
    Component(EventPayloadSanitizerTokenizer, "Event Payload Sanitizer / Tokenizer", "AWS Lambda / Custom Logic", "Enforces GDPR and CCPA compliance by sanitizing and tokenizing event payloads.")
    Component(OrderProcessingQueue, "Order Processing Queue", "Amazon SQS", "Delivers retryable fulfillment tasks using long polling.")
    Component(NotificationQueue, "Notification Queue", "Amazon SQS", "Queues notification tasks for asynchronous processing.")
    Component(SQSDeadLetterQueuesDLQs, "SQS Dead-Letter Queues (DLQs)", "Amazon SQS", "Captures failed messages for troubleshooting and fault tolerance.")
}

Rel(EventPayloadSanitizerTokenizer, CentralEventBus, "Publishes sanitized events", "")
Rel(CentralEventBus, OrderProcessingQueue, "Dispatches order events to queue", "")
Rel(CentralEventBus, NotificationQueue, "Dispatches notification events to queue", "")
Rel(OrderProcessingQueue, SQSDeadLetterQueuesDLQs, "Fails over unprocessable messages", "")
@enduml