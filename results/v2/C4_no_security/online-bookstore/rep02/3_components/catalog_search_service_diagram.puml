@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog & Search Service container

Container_Boundary(catalog_search_service, "Catalog & Search Service") {
    Component(Catalog_Controller, "Catalog Controller", "Java / Spring Boot REST/gRPC", "Exposes REST/gRPC endpoints and handles multi-currency formatting (USD, EUR, GBP).")
    Component(Search_Engine_Client, "Search Engine Client", "AWS SDK / Java", "Integrates with Amazon OpenSearch for keyword search and faceted queries.")
    Component(Inventory_Manager, "Inventory Manager", "Java / Spring Boot", "Manages stock levels, pricing mutations, and includes an Audit Interceptor.")
    Component(Cache_Facade, "Cache Facade", "Redis Protocol / Java", "Manages hot-key caching with Redis, utilizing distributed locks and request collapsing.")
    Component(Catalog_Event_Listener, "Catalog Event Listener", "AWS SDK / Java", "Consumes events from Amazon SQS/EventBridge for cache invalidation.")
    Component(Faceted_Navigation_Component, "Faceted Navigation Component", "Java", "Delegates filtering and currency formatting via in-memory Java method calls.")
}

Component(AWS_API_Gateway, "AWS API Gateway", "AWS Gateway", "Routes catalog and search requests via internal HTTPS/gRPC.")
Component(Amazon_OpenSearch, "Amazon OpenSearch", "Amazon OpenSearch", "Search and indexing engine deployed in multi-AZ clusters.")
Component(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Primary relational database for catalog and inventory persistence.")
Component(Redis_ElastiCache, "Redis (ElastiCache)", "Redis", "In-memory cache for high-throughput read performance.")
Component(Amazon_EventBridge, "Amazon EventBridge", "Amazon EventBridge", "Messaging infrastructure for asynchronous event-driven synchronization.")

Rel(AWS_API_Gateway, Catalog_Controller, "Routes catalog and search requests via internal HTTPS/gRPC.", "HTTPS/gRPC")
Rel(Catalog_Controller, Faceted_Navigation_Component, "Delegates filtering and currency formatting via in-memory Java method calls.", "In-memory")
Rel(Search_Engine_Client, Amazon_OpenSearch, "Queries search data using the AWS SDK.", "AWS SDK")
Rel(Inventory_Manager, Amazon_Aurora_PostgreSQL, "Persists inventory changes via JDBC.", "JDBC")
Rel(Cache_Facade, Redis_ElastiCache, "Manages hot-key caching via the Redis Protocol.", "Redis Protocol")
Rel(Inventory_Manager, Amazon_EventBridge, "Publishes stock and pricing mutation events asynchronously.", "Async")

@enduml