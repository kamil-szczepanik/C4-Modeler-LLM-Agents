@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("OrderCheckoutService", "Order & Checkout Service") {
    Component(Order_Controller, "Order Controller", "Spring MVC RestController", "Handles incoming HTTP/gRPC requests for cart management, checkout orchestration, and multi-currency conversion.")
    Component(Order_Service, "Order Service", "Spring Service Bean", "Contains business logic for order processing, cart management, and coordinating payments and events.")
    Component(Payment_Gateway_Client, "Payment Gateway Client", "Spring Component / Resilience4j", "Communicates with external payment processors (Stripe/PayPal) and implements circuit breakers for fault tolerance.")
    Component(Persistence_Adapter, "Persistence Adapter", "Spring Data JPA / JDBC / AWS SDK", "Persists transactional order and cart data to Amazon Aurora PostgreSQL using HikariCP/RDS Proxy.")
    Component(Cache_Idempotency_Manager, "Cache & Idempotency Manager", "Redis Client", "Validates idempotency keys and caches exchange rates using Redis (ElastiCache).")
    Component(Event_Publisher, "Event Publisher", "AWS SDK", "Publishes order status events asynchronously to Amazon EventBridge and Amazon SQS.")
}

Rel(Order_Controller, Order_Service, "Delegates request processing")
Rel(Order_Service, Payment_Gateway_Client, "Processes payments and risk assessments", "HTTPS / REST")
Rel(Order_Service, Persistence_Adapter, "Persists transactional order and cart data", "JDBC / AWS SDK")
Rel(Order_Service, Cache_Idempotency_Manager, "Validates idempotency keys and caches exchange rates", "TCP / Redis Protocol")
Rel(Order_Service, Event_Publisher, "Publishes order status events", "AWS SDK")
@enduml