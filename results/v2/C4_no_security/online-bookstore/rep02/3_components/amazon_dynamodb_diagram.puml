@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon DynamoDB container

Container(PersonalizationService, "Personalization Service", "AWS SDK", "Reads/writes user preference and recommendation data.")
Container(CustomerReviewService, "Customer Review Service", "AWS SDK", "Reads/writes review data.")
System_Ext(AmazonEventBridge, "Amazon EventBridge", "Receives item-level modification events.")

Container_Boundary(AmazonDynamoDB, "Amazon DynamoDB") {
    Component(RequestRouterAPIFrontend, "Request Router / API Frontend", "AWS SDK / TLS", "Handles incoming requests from personalization and review services.")
    Component(StorageNodesPartitionEngine, "Storage Nodes (Partition Engine)", "DynamoDB On-Demand Capacity", "Provides low-latency NoSQL storage and handles data partitioning.")
    Component(ReplicationEngine, "Replication Engine", "Amazon DynamoDB Global Tables", "Supports multi-region active-active replication across us-east-1, eu-west-1, and ap-southeast-1.")
    Component(TTLBackgroundEvaluator, "TTL Background Evaluator", "DynamoDB Time-to-Live (TTL)", "Automatically expires temporary data to support GDPR and CCPA compliance.")
    Component(StreamsProcessor, "Streams Processor", "DynamoDB Streams", "Captures real-time item modifications for asynchronous event-driven architecture integration.")
}

Rel(PersonalizationService, RequestRouterAPIFrontend, "Reads/writes user preference and recommendation data via AWS SDK over TLS", "AWS SDK / TLS")
Rel(CustomerReviewService, RequestRouterAPIFrontend, "Reads/writes review data via AWS SDK over TLS", "AWS SDK / TLS")
Rel(StreamsProcessor, AmazonEventBridge, "Publishes item-level modification events using native AWS service-to-service integration over TLS", "AWS Service-to-Service Integration")
@enduml