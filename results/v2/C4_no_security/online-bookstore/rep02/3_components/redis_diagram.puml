@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Redis container

System_Ext(Catalog & Search Service, "Catalog & Search Service", "External service")
System_Ext(Order & Checkout Service, "Order & Checkout Service", "External service")
System_Ext(API Gateway, "API Gateway", "External service")
System_Ext(Personalization Service, "Personalization Service", "External service")

Container_Boundary(redis_boundary, "Redis") {
    Component(Catalog Cache Component, "Catalog Cache Component", "Redis Strings/Hashes", "Caches catalog data for the Catalog & Search Service.")
    Component(Session & Cart Store Component, "Session & Cart Store Component", "Redis Hashes/Sets", "Read/Write active carts for the Order & Checkout Service.")
    Component(Rate Limiter Component, "Rate Limiter Component", "Redis Atomic Counters", "Check and increment request counters for the API Gateway.")
    Component(Real-Time Recommendation Cache Component, "Real-Time Recommendation Cache Component", "Redis Sorted Sets/Hashes", "Read trending pairs for the Personalization Service.")
}

Rel(Catalog & Search Service, Catalog Cache Component, "Caches catalog data", "Redis Protocol / TCP")
Rel(Order & Checkout Service, Session & Cart Store Component, "Read/Write active carts", "Redis Protocol / TCP, port 6379")
Rel(API Gateway, Rate Limiter Component, "Check and increment request counters", "Redis Protocol / TCP, port 6379")
Rel(Personalization Service, Real-Time Recommendation Cache Component, "Read trending pairs", "Redis Protocol / TCP, port 6379")

@enduml