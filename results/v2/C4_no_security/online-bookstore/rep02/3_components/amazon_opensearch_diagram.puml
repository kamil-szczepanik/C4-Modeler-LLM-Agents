@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Store_Administrator, "Store Administrator", "Store Administrator")
System_Ext(Catalog_Search_Service, "Catalog & Search Service", "Spring Boot/Python service")
System_Ext(Amazon_S3, "Amazon S3", "Object storage for backups")

Container_Boundary(Amazon_OpenSearch, "Amazon OpenSearch") {
    Component(Search_Engine_Core, "Search Engine Core", "Apache Lucene", "Inverted-index storage powering the search engine core for keyword and faceted search queries.")
    Component(Ingest_Pipeline, "Ingest Pipeline", "OpenSearch Ingest Node", "Ingests and processes data to index and update book catalog documents.")
    Component(Cluster_Manager, "Cluster Manager", "OpenSearch Master Node", "Manages cluster state and coordination.")
    Component(OpenSearch_Dashboards, "OpenSearch Dashboards", "Web UI", "Visualization UI for store analytics and index management.")
}

Rel(Catalog_Search_Service, Ingest_Pipeline, "Index/Update book catalog documents", "HTTPS / JSON")
Rel(Catalog_Search_Service, Search_Engine_Core, "Execute keyword and faceted search queries", "HTTPS / JSON")
Rel(Store_Administrator, OpenSearch_Dashboards, "View search analytics and manage index patterns", "HTTPS / TLS")
Rel(OpenSearch_Dashboards, Search_Engine_Core, "Query internal indices for telemetry", "REST / JSON over HTTPS")
Rel(Amazon_OpenSearch, Amazon_S3, "Automated daily snapshots and cross-region backups", "AWS SDK")

@enduml