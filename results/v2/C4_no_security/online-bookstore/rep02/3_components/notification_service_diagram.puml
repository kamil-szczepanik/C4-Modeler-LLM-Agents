@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification Service container

Container_Ext(aws_api_gateway, "AWS API Gateway", "AWS API Gateway", "Routes internal notification requests.")
Container_Ext(amazon_sqs, "Amazon SQS", "Amazon SQS", "Message queue for async domain events.")
Container_Ext(redis_elasticache, "Redis (ElastiCache)", "Redis", "Fast in-memory caching to enforce message processing idempotency.")
Container_Ext(aws_ses, "AWS SES", "AWS SES", "Delivers cost-effective, highly scalable email notifications.")
Container_Ext(fedex_ups_apis, "FedEx/UPS APIs", "HTTPS", "Coordinates physical book shipping and tracking.")
Container_Ext(aws_cloudwatch_datadog, "AWS CloudWatch / Datadog", "HTTPS", "Receives telemetry, logs, and distributed traces.")

Container_Boundary(notification_service, "Notification Service") {
    Component(event_consumer_component, "Event Consumer Component", "Node.js / Express", "Subscribes to message queues for asynchronous domain event ingestion.")
    Component(template_localization_engine, "Template & Localization Engine", "Node.js / Express", "Renders dynamic templates supporting multi-currency (USD, EUR, GBP) and localized user preferences.")
    Component(dispatch_adapter_component, "Dispatch Adapter Component", "Node.js / Express", "Interfaces with external delivery systems.")
    Component(preference_manager_component, "Preference Manager Component", "Node.js / Express", "Enforces GDPR/CCPA compliance via user consent checks.")
    Component(feedback_bounce_handler_component, "Feedback & Bounce Handler Component", "Node.js / Express", "Ingests delivery failures and bounce metrics.")
}

Rel(aws_api_gateway, notification_service, "Routes internal notification requests", "Internal HTTPS / gRPC")
Rel(event_consumer_component, amazon_sqs, "Consumes async domain events", "AWS SDK")
Rel(event_consumer_component, redis_elasticache, "Checks and stores message idempotency keys", "Redis Protocol")
Rel(dispatch_adapter_component, aws_ses, "Sends emails and system notifications", "AWS SDK")
Rel(dispatch_adapter_component, fedex_ups_apis, "Coordinates physical book shipping and tracking", "HTTPS / Circuit Breaker")
Rel(aws_ses, feedback_bounce_handler_component, "Receives delivery failure and complaint webhooks", "HTTPS")
Rel(notification_service, aws_cloudwatch_datadog, "Sends telemetry, logs, and distributed traces", "HTTPS")

@enduml