@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Book Shopper, "Book Shopper", "End user browsing the catalog, managing a cart, purchasing books, leaving reviews, and receiving personalized recommendations.")
Person(Book Author/Publisher, "Book Author/Publisher", "User managing book listings, inventory, and publishing content to the platform.")
Person(Store Administrator, "Store Administrator", "User managing platform operations, user accounts, system configuration, and monitoring overall system health.")

System(Online Bookstore System, "Online Bookstore System", "An Amazon-style global e-commerce platform for physical and electronic books, supporting catalog browsing, secure checkout, reviews, and personalized recommendations.")

System_Ext(Stripe/PayPal, "Stripe/PayPal", "Payment Gateway handling secure financial transactions and checkouts.")
System_Ext(FedEx/UPS, "FedEx/UPS", "Shipping Carrier APIs handling physical book delivery and tracking.")
System_Ext(AWS SES, "AWS SES", "Email Service handling transactional and marketing notifications.")
System_Ext(AWS Cognito/Auth0, "AWS Cognito/Auth0", "Identity Provider managing authentication, authorization, and user identity via OAuth2/OIDC.")
System_Ext(AWS CloudFront/Route 53, "AWS CloudFront/Route 53", "CDN and Traffic Manager handling global edge routing, sub-2s page loads, and TLS termination.")
System_Ext(AWS CloudWatch/Datadog, "AWS CloudWatch/Datadog", "Telemetry and observability platform providing centralized logging and distributed tracing.")

Rel(Book Shopper, Online Bookstore System, "Browses catalog, places orders, and interacts with the platform", "HTTPS via TLS 1.3 (Web/Mobile)")
Rel(Book Author/Publisher, Online Bookstore System, "Manages catalog listings and published content", "HTTPS via TLS 1.3 (Web/Mobile)")
Rel(Store Administrator, Online Bookstore System, "Administers platform operations and monitors system health", "HTTPS via TLS 1.3 (Web/Mobile)")
Rel(Online Bookstore System, Stripe/PayPal, "Processes secure payments and checkouts", "REST/JSON over HTTPS")
Rel(Online Bookstore System, FedEx/UPS, "Coordinates physical book shipping and tracking", "REST/JSON over HTTPS")
Rel(Online Bookstore System, AWS SES, "Sends emails and system notifications", "REST/JSON over HTTPS")
Rel(Online Bookstore System, AWS Cognito/Auth0, "Authenticates users and validates sessions", "OAuth2/OIDC over HTTPS")
Rel(AWS CloudFront/Route 53, Online Bookstore System, "Routes global traffic across multi-region infrastructure", "HTTPS / Latency-based routing")
Rel(Online Bookstore System, AWS CloudWatch/Datadog, "Sends telemetry, logs, and distributed traces", "HTTPS / Telemetry Agents")
@enduml