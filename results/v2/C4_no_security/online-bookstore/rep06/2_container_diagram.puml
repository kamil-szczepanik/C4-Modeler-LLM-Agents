@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore Platform

Person(CasualShoppers, "Casual Shoppers", "End users who browse catalogues and purchase physical and electronic books.")
Person(BookEnthusiasts, "Book Enthusiasts", "Engaged users who leave reviews, read content, and look for recommendations.")
Person(StoreAdministrators, "Store Administrators", "Internal staff who manage the platform, catalogues, and operations via the back-office.")
Person(CustomerSupport, "Customer Support", "Support staff who assist customers with inquiries and orders.")

System_Ext(PaymentGateway, "Payment Gateway", "External system handling secure multi-currency transactions.")
System_Ext(ThirdPartyShippingProvider, "Third-Party Shipping Provider", "External system handling logistics and fulfillment.")
System_Ext(TaxCurrencyProvider, "Tax & Currency Provider", "External system providing tax rates and exchange rates.")

System_Boundary(OnlineBookstorePlatform, "Online Bookstore Platform") {
    Container(FrontendContainer, "Frontend Container", "React, Amazon CloudFront, Amazon S3", "Single Page Application served to users for browsing and interacting with the store.")
    Container(APIGateway, "API Gateway", "Amazon API Gateway", "Provides REST/GraphQL entry points, rate limiting, and JWT validation.")
    Container(CatalogSearch, "Catalog & Search", "Spring Boot, Amazon OpenSearch", "Manages book catalogs and provides search capabilities.")
    Container(OrderCheckout, "Order & Checkout", "Spring Boot", "Handles transaction integrity, orders, and integration with shipping and payment providers.")
    Container(Recommendation, "Recommendation", "Spring Boot / Python", "Provides personalized book recommendations to users.")
    Container(LocalizationTax, "Localization & Tax", "Spring Boot", "Manages multi-currency support, localization, and tax computations.")
    Container(ContentReview, "Content & Review", "Node.js, Amazon DocumentDB", "Manages content, book reviews, and user feedback.")
    Container(AdminBackOffice, "Admin Back-Office", "Spring Boot / React", "Provides administrative interfaces for store managers and support.")
}

Rel(CasualShoppers, FrontendContainer, "Interacts with the SPA via HTTPS to browse and shop", "HTTPS")
Rel(BookEnthusiasts, FrontendContainer, "Interacts with the SPA to read and write reviews and view recommendations", "HTTPS")
Rel(StoreAdministrators, FrontendContainer, "Manages platform administration and catalogues", "HTTPS")
Rel(CustomerSupport, FrontendContainer, "Accesses back-office tools to assist customers", "HTTPS")

Rel(FrontendContainer, APIGateway, "Calls API endpoints for data and operations", "HTTPS / REST / GraphQL")

Rel(APIGateway, CatalogSearch, "Routes internal traffic via VPC links", "gRPC")
Rel(APIGateway, OrderCheckout, "Routes internal traffic via VPC links", "gRPC")
Rel(APIGateway, Recommendation, "Routes internal traffic via VPC links", "gRPC")
Rel(APIGateway, LocalizationTax, "Routes internal traffic via VPC links", "gRPC")
Rel(APIGateway, ContentReview, "Routes internal traffic via VPC links", "gRPC")
Rel(APIGateway, AdminBackOffice, "Routes internal traffic via VPC links", "gRPC")

Rel(OrderCheckout, PaymentGateway, "Integrates for payment processing", "HTTPS")
Rel(OrderCheckout, ThirdPartyShippingProvider, "Integrates for logistics and fulfillment", "HTTPS")
Rel(LocalizationTax, TaxCurrencyProvider, "Queries for exchange rates and tax info", "HTTPS")

@enduml