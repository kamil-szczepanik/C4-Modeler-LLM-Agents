@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Admin Back-Office container

Container_Boundary(admin_back_office, "Admin Back-Office") {
    Component(Admin UI, "Admin UI", "React, Amazon S3, Amazon CloudFront", "Delivers the internal management single-page application for administrative and customer support tools.")
    Component(Auth & RBAC Controller, "Auth & RBAC Controller", "Spring Security, OAuth2/OIDC", "Enforces granular role-based access control and secure authentication.")
    Component(Operations & Support API, "Operations & Support API", "Spring Boot", "Provides scalable microservice logic for customer support and operational tooling.")
    Component(Catalog Management Component, "Catalog Management Component", "Spring Boot", "Handles catalog operations and offloads bulk updates.")
    Component(Dispute & Refund Component, "Dispute & Refund Component", "Spring Boot", "Manages disputes and refund workflows securely.")
    Component(Audit Logger, "Audit Logger", "Spring AOP, Amazon CloudWatch, Amazon S3 Object Lock", "Records security and audit events to ensure compliance and WORM storage.")
    Component(Asynchronous Processing Queue, "Asynchronous Processing Queue", "Amazon SQS", "Enables asynchronous processing for bulk catalog updates.")
}

Rel(Admin UI, Auth & RBAC Controller, "Communicates", "REST over HTTPS")
Rel(Admin UI, Operations & Support API, "Communicates", "REST over HTTPS")
Rel(Admin UI, Catalog Management Component, "Communicates", "REST over HTTPS")
Rel(Operations & Support API, Dispute & Refund Component, "Coordinates administrative workflows", "")
Rel(Catalog Management Component, Asynchronous Processing Queue, "Offloads bulk operations to", "")
Rel(Operations & Support API, Audit Logger, "Sends audit events to", "")
Rel(Catalog Management Component, Audit Logger, "Sends audit events to", "")

@enduml