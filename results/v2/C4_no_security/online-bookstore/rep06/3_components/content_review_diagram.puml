@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Content & Review container

Person(Customers_Shoppers, "Customers (Shoppers)", "External User", "Browses and submits reviews.")
Person(Store_Staff_Administrators, "Store Staff & Administrators", "External User", "Manages content compliance.")

System_Ext(Amazon_API_Gateway, "Amazon API Gateway", "AWS API Gateway", "Routes internal traffic via VPC links.")
System_Ext(Amazon_DocumentDB, "Amazon DocumentDB", "Amazon DocumentDB (MongoDB wire protocol)", "Persists and retrieves reviews.")
System_Ext(Amazon_ElastiCache_Redis, "Amazon ElastiCache (Redis)", "Redis Protocol", "Caches reviews and metadata.")
System_Ext(Amazon_SQS, "Amazon SQS", "AWS SQS with Dead Letter Queue", "Publishes review payloads for async moderation.")
System_Ext(AWS_Comprehend, "AWS Comprehend", "AWS SDK / HTTPS", "Analyzes text toxicity and sentiment.")
System_Ext(Admin_Back_Office, "Admin Back-Office", "External Container", "Administrative interface for back-office operations.")

Container_Boundary(Content_Review, "Content & Review") {
    Component(Content_Review_Container, "Content & Review Container", "Node.js, Express.js", "Manages customer ratings and reviews, processing high-throughput read operations and supporting moderation.")
}

Rel(Amazon_API_Gateway, Content_Review_Container, "Routes internal traffic via VPC links", "gRPC")
Rel(Content_Review_Container, Amazon_ElastiCache_Redis, "Reads cached reviews and metadata", "Redis Protocol")
Rel(Content_Review_Container, Amazon_DocumentDB, "Persists and retrieves reviews", "MongoDB wire protocol via TLS")
Rel(Content_Review_Container, Amazon_SQS, "Publishes review payloads for async moderation", "AWS SDK / HTTPS")
Rel(Content_Review_Container, AWS_Comprehend, "Analyzes text toxicity and sentiment", "AWS SDK / HTTPS")

@enduml