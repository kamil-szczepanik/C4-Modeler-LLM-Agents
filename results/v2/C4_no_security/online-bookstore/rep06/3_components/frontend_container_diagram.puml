@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Frontend Container container

Container_Boundary(frontend_container, "Frontend Container") {
    Component(sparouter, "SPA Router & Shell", "React Router, Error Boundary", "Manages client-side routing and layout frames.")
    Component(localization, "Localization & Currency Context", "i18next, React Context API", "Manages runtime language and currency states for USD, EUR, and GBP.")
    Component(compliance, "Compliance & Consent Manager", "JavaScript, Local Storage", "Handles GDPR/CCPA cookie banners locally.")
    Component(apiclient, "API Client Layer", "Axios, GraphQL", "Manages centralized request interception and caching.")
    Component(designsystem, "Design System & Accessible Component Library", "Tailwind CSS, Radix UI", "Powers UI primitives with WCAG 2.1 AA accessibility compliance.")
}

System_Ext(apigateway, "API Gateway", "Backend API Gateway")
System_Ext(cloudfront, "AWS CloudFront & Amazon S3", "Global CDN and static asset storage")
System_Ext(cloudwatch, "AWS CloudWatch / Sentry", "Telemetry and error logging service")

Rel(sparouter, designsystem, "Renders layout using")
Rel(localization, sparouter, "Provides state to")
Rel(apiclient, apigateway, "Calls backend services and operations", "HTTPS / REST / GraphQL")
Rel(sparouter, cloudfront, "Fetches static assets", "HTTPS")
Rel(sparouter, cloudwatch, "Pushes client-side telemetry and error logs", "HTTPS")

@enduml