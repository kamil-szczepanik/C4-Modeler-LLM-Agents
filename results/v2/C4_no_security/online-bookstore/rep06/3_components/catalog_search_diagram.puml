@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Catalog & Search", "Catalog & Search") {
    Component("Search Controller & Facade", "Search Controller & Facade", "Spring Boot", "Handles high-performance product discovery and faceted filtering requests.")
    Component("Catalog Management Service", "Catalog Management Service", "Spring Boot", "Manages catalog metadata and persists the source of truth.")
    Component("Sync Worker", "Sync Worker", "Spring Boot / AWS Lambda", "Synchronizes catalog mutations and updates search indices.")
    Component("Search Analytics Collector", "Search Analytics Collector", "Spring Boot", "Collects and dispatches telemetry and metrics for search usage.")
}

Rel("Catalog Management Service", "Sync Worker", "Publishes mutations", "Amazon EventBridge (JSON)")
Rel("Sync Worker", "Search Controller & Facade", "Updates indices", "HTTPS / REST")
Rel("Search Controller & Facade", "Search Analytics Collector", "Dispatches telemetry", "Spring ApplicationEvent")

@enduml