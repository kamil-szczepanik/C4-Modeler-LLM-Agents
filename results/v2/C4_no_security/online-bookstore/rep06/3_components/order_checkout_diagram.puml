@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Order & Checkout container

Container_Boundary(order_checkout, "Order & Checkout") {
    Component(CheckoutOrchestrator, "Checkout Orchestrator", "Spring Boot / Spring State Machine", "Manages complex saga workflows, calculates totals, and coordinates payments and idempotency.")
    Component(OrderManagement, "Order Management", "Spring Data JPA", "Handles ACID-compliant order state persistence and fulfillment workflows.")
    Component(PaymentIntegration, "Payment Integration", "Java / HTTPS", "Processes secure transactions with external payment gateways.")
    Component(EventPublisher, "Event Publisher", "AWS SDK", "Emits domain events such as OrderPlaced to messaging infrastructure.")
    Component(OrderModification, "Order Modification", "Spring Boot", "Handles updates and modifications to existing orders.")
    Component(IdempotencyManager, "Idempotency Manager", "Amazon ElastiCache (Redis)", "Tracks transaction states and request keys to prevent double-charging.")
}

System_Ext(LocalizationTax, "Localization & Tax", "Calculates local taxes and totals")
System_Ext(PaymentGateway, "Payment Gateway", "External payment processing")
System_Ext(ThirdPartyShippingProvider, "Third-Party Shipping Provider", "Handles logistics and fulfillment")
System_Ext(AmazonSQSSNS, "Amazon SQS/SNS", "Messaging infrastructure")

Rel(CheckoutOrchestrator, LocalizationTax, "Calculates local taxes and totals", "gRPC")
Rel(CheckoutOrchestrator, PaymentIntegration, "Processes secure transactions", "Internal REST/gRPC")
Rel(CheckoutOrchestrator, IdempotencyManager, "Tracks transaction states and request keys", "Redis Protocol")
Rel(PaymentIntegration, PaymentGateway, "Executes payment processing", "HTTPS")
Rel(order_checkout, ThirdPartyShippingProvider, "Handles logistics and fulfillment", "HTTPS")
Rel(EventPublisher, AmazonSQSSNS, "Emits domain events (OrderPlaced)", "AWS SDK")

@enduml