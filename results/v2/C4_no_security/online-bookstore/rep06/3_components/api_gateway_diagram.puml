@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway_boundary, "API Gateway") {
    Component(PerimeterRouterAndSecurityEnforcement, "Perimeter Router and Security Enforcement", "Amazon API Gateway with JWT authorizers and cached JWKS", "Serves as the perimeter router, handling edge security, JWT authorization, and low-latency validation.")
    Component(AccessLoggingEmitter, "Access Logging Emitter", "CloudWatch Logs SDK", "Asynchronously streams telemetry and access logs.")
}

System_Ext(CatalogAndSearch, "Catalog & Search", "Backend microservice")
System_Ext(OrderAndCheckout, "Order & Checkout", "Backend microservice")
System_Ext(Recommendation, "Recommendation", "Backend microservice")
System_Ext(LocalizationAndTax, "Localization & Tax", "Backend microservice")
System_Ext(ContentAndReview, "Content & Review", "Backend microservice")
System_Ext(AdminBackOffice, "Admin Back-Office", "Backend microservice")

Rel(PerimeterRouterAndSecurityEnforcement, AccessLoggingEmitter, "Asynchronously streams telemetry", "Async / CloudWatch Logs SDK")
Rel(PerimeterRouterAndSecurityEnforcement, CatalogAndSearch, "Routes internal traffic", "gRPC")
Rel(PerimeterRouterAndSecurityEnforcement, OrderAndCheckout, "Routes internal traffic", "gRPC")
Rel(PerimeterRouterAndSecurityEnforcement, Recommendation, "Routes internal traffic", "gRPC")
Rel(PerimeterRouterAndSecurityEnforcement, LocalizationAndTax, "Routes internal traffic", "gRPC")
Rel(PerimeterRouterAndSecurityEnforcement, ContentAndReview, "Routes internal traffic", "gRPC")
Rel(PerimeterRouterAndSecurityEnforcement, AdminBackOffice, "Routes internal traffic", "gRPC")

@enduml