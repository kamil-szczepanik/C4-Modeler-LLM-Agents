@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Recommendation container

Container_Boundary(Recommendation, "Recommendation Container") {
    Component(RecommendationAPIController, "Recommendation API Controller", "Spring Boot", "Handles incoming recommendation requests and serves pre-computed suggestions.")
    Component(AlgorithmEngine, "Algorithm Engine", "Python / AWS ECS / SageMaker", "Executes offline collaborative filtering and co-purchase analysis via scheduled batch machine learning jobs.")
    Component(TelemetryPublisherComponent, "Telemetry Publisher Component", "Spring Boot", "Dispatches interaction events and emits anonymous usage telemetry.")
}

SystemDb_Ext(ModelDataStore, "Model Data Store", "Amazon ElastiCache Redis")
System_Ext(AmazonKinesis, "Amazon Kinesis", "Streaming ingestion service")
System_Ext(CatalogSearch, "Catalog & Search", "External System")

Rel(RecommendationAPIController, ModelDataStore, "Fetches pre-computed recommendations", "Redis Protocol")
Rel(RecommendationAPIController, TelemetryPublisherComponent, "Dispatches interaction events", "In-process async")
Rel(TelemetryPublisherComponent, AmazonKinesis, "Emits anonymous usage telemetry", "HTTPS")
Rel(AlgorithmEngine, ModelDataStore, "Writes pre-computed co-purchase matrices", "Redis Protocol")
Rel(CatalogSearch, Recommendation, "Syncs product metadata asynchronously", "Amazon SQS")

@enduml