@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers_Shoppers, "Customers (Shoppers)", "End users who browse catalogues, purchase physical and electronic books, and access personalized recommendations and reviews.")
Person(Store_Staff_Administrators, "Store Staff & Administrators", "Internal staff who manage the bookstore platform, catalogues, and operations.")
Person(Customer_Support_Representatives, "Customer Support Representatives", "Support staff who assist customers with inquiries, orders, and platform issues.")

System(Online_Bookstore_Platform, "Online Bookstore Platform", "A cloud-native, multi-region e-commerce platform enabling customers to browse catalogues, securely purchase books, and access personalized recommendations and reviews.")

System_Ext(Payment_Gateway, "Payment Gateway", "External system handling secure multi-currency transactions.")
System_Ext(Third_Party_Shipping_Provider, "Third-Party Shipping Provider", "External system handling logistics and fulfillment.")
System_Ext(Tax_Currency_Provider, "Tax & Currency Provider", "External system providing tax rates and exchange rates.")

Rel(Customers_Shoppers, Online_Bookstore_Platform, "Interact with the platform to browse, purchase, and review books", "HTTPS (TLS 1.3)")
Rel(Store_Staff_Administrators, Online_Bookstore_Platform, "Manage platform operations and administration", "HTTPS (TLS 1.3)")
Rel(Customer_Support_Representatives, Online_Bookstore_Platform, "Provide customer support and manage support workflows", "HTTPS (TLS 1.3)")
Rel(Online_Bookstore_Platform, Payment_Gateway, "Integrates for multi-currency transactions", "HTTPS / REST APIs")
Rel(Online_Bookstore_Platform, Third_Party_Shipping_Provider, "Connects for logistics and fulfillment", "HTTPS / REST or SOAP APIs")
Rel(Online_Bookstore_Platform, Tax_Currency_Provider, "Queries for exchange rates and tax information with caching and circuit breakers", "HTTPS / REST APIs")
@enduml