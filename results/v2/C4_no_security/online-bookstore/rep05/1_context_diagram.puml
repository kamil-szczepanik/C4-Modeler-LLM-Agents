@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Online Bookstore

Person(Customer_Shopper, "Customer (Shopper)", "End user browsing books, managing cart, executing secure checkouts, writing reviews, and viewing recommendations.")
Person(Book_Author_Publisher, "Book Author/Publisher", "Publishers and authors managing catalog entries and monitoring sales performance.")
Person(Store_Administrator, "Store Administrator", "Platform operators managing system configurations, users, and store catalogs.")

System(Online_Bookstore_System, "Online Bookstore System", "A globally scaled e-commerce platform built on AWS providing book browsing, secure checkout, reviews, and recommendations for 1M MAU.")

System_Ext(Payment_Gateway, "Payment Gateway", "External payment processors like Stripe and PayPal handling secure payment transactions.")
System_Ext(Shipping_Provider_APIs, "Shipping Provider APIs", "External logistics providers like FedEx and UPS handling shipping and fulfillment tracking.")
System_Ext(Identity_Provider, "Identity Provider", "Authentication services like Auth0 and AWS Cognito providing identity verification and user management.")
System_Ext(Notification_System, "Notification System", "Messaging services like AWS SES and SNS sending transactional notifications and alerts.")
System_Ext(Tax_Calculation_Service, "Tax Calculation Service", "Tax services like Avalara and TaxJar calculating applicable sales and regional taxes.")

Rel(Customer_Shopper, Online_Bookstore_System, "Browses books, manages cart, and executes secure checkout", "HTTPS via Web/Mobile browsers")
Rel(Book_Author_Publisher, Online_Bookstore_System, "Manages catalog items and monitors publication data", "HTTPS via Web browsers")
Rel(Store_Administrator, Online_Bookstore_System, "Administers platform configurations and operations", "HTTPS via Web browsers")
Rel(Online_Bookstore_System, Payment_Gateway, "Processes secure customer payments", "REST/JSON over TLS 1.3")
Rel(Online_Bookstore_System, Shipping_Provider_APIs, "Calculates shipping rates and manages fulfillment", "REST/JSON over TLS 1.3")
Rel(Online_Bookstore_System, Identity_Provider, "Authenticates users and verifies identity", "REST/JSON over TLS 1.3")
Rel(Online_Bookstore_System, Notification_System, "Dispatches transactional emails and notifications", "REST/JSON over TLS 1.3")
Rel(Online_Bookstore_System, Tax_Calculation_Service, "Calculates applicable sales and regional taxes", "REST/JSON over TLS 1.3")
@enduml