@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore System

Person(Customer_Shopper, "Customer (Shopper)", "End-user browsing books, managing cart, executing secure checkouts, writing reviews, and viewing recommendations.")
Person(Book_Author_Publisher, "Book Author/Publisher", "Publishers and authors managing catalog entries and monitoring sales performance.")
Person(Store_Administrator, "Store Administrator", "Platform operators managing system configurations, users, and store catalogs.")

System_Ext(Payment_Gateway, "Payment Gateway", "External payment processors handling secure payment transactions.")
System_Ext(Shipping_Provider_APIs, "Shipping Provider APIs", "External logistics providers handling shipping and fulfillment tracking.")
System_Ext(Identity_Provider, "Identity Provider", "Authentication services providing identity verification and user management.")
System_Ext(Notification_System, "Notification System", "Messaging services sending transactional notifications and alerts.")
System_Ext(Tax_Calculation_Service, "Tax Calculation Service", "Tax services calculating applicable sales and regional taxes.")

System_Boundary(Online_Bookstore_System, "Online Bookstore System") {
    Container(Single_Page_Application_SPA, "Single Page Application (SPA)", "React, TypeScript, Amazon CloudFront, S3", "Frontend interface providing book search, reviews, and e-commerce workflows.")
    Container(API_Gateway_Load_Balancer, "API Gateway & Load Balancer", "AWS API Gateway, Application Load Balancer (ALB)", "Entry point for client traffic routing requests to core microservices.")
    Container(Catalog_Search_Service, "Catalog & Search Service", "Node.js, Amazon ECS on Fargate", "Manages book inventory and search capabilities.")
    Container(Checkout_Order_Service, "Checkout & Order Service", "Go/Java, Amazon ECS on Fargate", "Handles secure checkouts, order processing, and transaction workflows.")
    Container(Recommendation_Service, "Recommendation Service", "Python, FastAPI, Amazon ECS on Fargate", "Provides personalized book recommendations to customers.")
    Container(Data_Privacy_Service, "Data Privacy Service", "Amazon ECS on Fargate", "Ensures global regulatory compliance such as GDPR and CCPA.")
    Container(Localization_Service, "Localization Service", "Amazon ECS on Fargate", "Handles multi-region localization and formatting.")
    ContainerDb(Database_Cluster, "Database Cluster", "Amazon Aurora (PostgreSQL)", "Primary relational data store with global databases for transactional safety.")
    ContainerDb(Session_Cache_Store, "Session Cache Store", "Amazon DynamoDB", "NoSQL data store for cart sessions and rapid data access.")
    ContainerDb(Search_Index, "Search Index", "Amazon OpenSearch", "Search engine data store for catalogue indexing and search queries.")
    Container(Messaging_Bus, "Messaging Bus", "Amazon SQS, Amazon SNS, Dead Letter Queues", "Asynchronous event-driven messaging backbone for microservices.")
}

Rel(Customer_Shopper, Single_Page_Application_SPA, "Browses books, manages cart, and views recommendations", "HTTPS via Web/Mobile browsers")
Rel(Book_Author_Publisher, Single_Page_Application_SPA, "Manages catalog items and monitors publication data", "HTTPS via Web browsers")
Rel(Store_Administrator, Single_Page_Application_SPA, "Administers platform configurations and operations", "HTTPS via Web browsers")

Rel(Single_Page_Application_SPA, API_Gateway_Load_Balancer, "Sends API requests and establishes real-time streams", "HTTPS/REST and WebSockets")

Rel(API_Gateway_Load_Balancer, Catalog_Search_Service, "Routes catalog and search requests", "gRPC / REST")
Rel(API_Gateway_Load_Balancer, Checkout_Order_Service, "Routes checkout and order processing requests", "gRPC / REST")
Rel(API_Gateway_Load_Balancer, Recommendation_Service, "Routes recommendation requests", "gRPC / REST")
Rel(API_Gateway_Load_Balancer, Data_Privacy_Service, "Routes compliance and privacy requests", "gRPC / REST")
Rel(API_Gateway_Load_Balancer, Localization_Service, "Routes localization requests", "gRPC / REST")

Rel(Catalog_Search_Service, Database_Cluster, "Reads and writes catalog data", "Secure VPC / Amazon Aurora Global Databases")
Rel(Checkout_Order_Service, Database_Cluster, "Reads and writes order data", "Secure VPC / Amazon Aurora Global Databases")

Rel(Catalog_Search_Service, Search_Index, "Indexes and queries catalogue search", "Secure VPC connections")
Rel(Checkout_Order_Service, Session_Cache_Store, "Manages cart and session data", "Secure VPC connections")

Rel(Checkout_Order_Service, Messaging_Bus, "Publishes and consumes order events", "Amazon SQS/SNS")

Rel(Checkout_Order_Service, Payment_Gateway, "Processes secure customer payments", "Secure REST integration with circuit breakers")
Rel(Checkout_Order_Service, Shipping_Provider_APIs, "Manages shipping and fulfillment", "Secure REST integration with circuit breakers")
Rel(Catalog_Search_Service, Identity_Provider, "Verifies user identity", "Secure REST integration with circuit breakers")
Rel(Checkout_Order_Service, Notification_System, "Dispatches transactional alerts and emails", "Secure REST integration with circuit breakers")
Rel(Checkout_Order_Service, Tax_Calculation_Service, "Calculates applicable sales taxes", "Secure REST integration with circuit breakers")

@enduml