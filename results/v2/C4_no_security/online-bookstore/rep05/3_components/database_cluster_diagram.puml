@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database Cluster container

Container_Boundary(database_cluster, "Database Cluster") {
    Component(Primary_Writer_Instance, "Primary Writer Instance", "Amazon Aurora PostgreSQL", "Handles all write transactions, PII masking, and GDPR/CCPA requests from services.")
    Component(Cross_Region_Read_Replicas, "Cross-Region Read Replicas", "Amazon Aurora PostgreSQL Read Replicas", "Handles read queries for the catalog and search services globally.")
    Component(PgBouncer_Connection_Pooler, "PgBouncer Connection Pooler", "PgBouncer", "Manages container connection spikes to the database.")
    Component(Routing_Proxy, "Routing Proxy", "Aurora Read-Write Endpoint", "Routes database traffic appropriately between writer and reader instances.")
}

Rel(Checkout_and_Order_Service, Primary_Writer_Instance, "Write transactions", "TCP / TLS, PostgreSQL Wire Protocol")
Rel(Catalog_and_Search_Service, Cross_Region_Read_Replicas, "Read queries", "TCP / TLS, PostgreSQL Wire Protocol")
Rel(Data_Privacy_Service, Primary_Writer_Instance, "PII masking and GDPR/CCPA requests", "TCP / TLS, PostgreSQL Wire Protocol")
Rel(ECS_Fargate_Tasks, Primary_Writer_Instance, "Authenticated via AWS Secrets Manager and IAM database authentication", "")
@enduml