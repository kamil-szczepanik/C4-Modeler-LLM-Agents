@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Localization Service container

System_Ext(Upstream_Rate_APIL, "Upstream Rate APIs", "HTTPS", "External APIs providing currency exchange rate updates.")

Container_Boundary(localization_service, "Localization Service") {
    Component(Localization_Controller, "Localization Controller", "Node.js / TypeScript, gRPC", "Routes requests via gRPC / REST and handles multi-region regional adaptation and formatting.")
    Component(Currency_Exchange_Engine, "Currency Exchange Engine", "Node.js / TypeScript", "Handles dynamic multi-currency conversion (USD, EUR, GBP) and queries cached exchange rates.")
    Component(Locale_Policy___Compliance_Provider, "Locale Policy & Compliance Provider", "Node.js / TypeScript", "Reads regional compliance and tax-display JSON assets from storage.")
    Component(Amazon_ElastiCache__Redis_, "Amazon ElastiCache (Redis)", "Redis", "In-memory caching for live exchange rates supporting stale-while-revalidate patterns.")
    Component(Amazon_S3, "Amazon S3", "Amazon S3", "Static key-value store for fast regional compliance and tax-display JSON assets.")
    Component(AWS_API_Gateway___Application_Load_Balancer, "AWS API Gateway & Application Load Balancer", "AWS API Gateway & ALB", "Routes external requests to the Localization Controller.")
    Component(Amazon_ECS_on_Fargate, "Amazon ECS on Fargate", "AWS ECS on Fargate", "Container runtime hosting the core localization service components.")
    Component(CloudWatch_Canaries, "CloudWatch Canaries", "AWS CloudWatch", "Synthetic monitoring tools for multi-region availability probing.")
}

Rel(AWS_API_Gateway___Application_Load_Balancer, Localization_Controller, "Routes requests via", "gRPC / REST")
Rel(Currency_Exchange_Engine, Amazon_ElastiCache__Redis_, "Queries cached exchange rates via", "Redis Protocol")
Rel(Currency_Exchange_Engine, Upstream_Rate_APIL, "Fetches updates via", "HTTPS with Circuit Breaker")
Rel(Locale_Policy___Compliance_Provider, Amazon_S3, "Reads regional rules via", "HTTPS / AWS SDK")
@enduml