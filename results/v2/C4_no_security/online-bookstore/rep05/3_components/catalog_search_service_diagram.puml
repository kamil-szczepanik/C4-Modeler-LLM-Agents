@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog & Search Service container

Container_Boundary(catalog_and_search_service, "Catalog & Search Service") {
    Component(Search_Facade_Component, "Search Facade Component", "Amazon OpenSearch query builder", "Handles keyword searches, facet filtering, fuzzy matching, synonyms, and ranking boosts.")
    Component(Inventory_Manager_Component, "Inventory Manager Component", "Express.js service", "Handles stock mutations and catalog updates.")
    Component(Catalog_Event_Publisher, "Catalog Event Publisher", "Amazon SNS/SQS", "Emits state-change and low-stock events asynchronously.")
    Component(Stock_Event_Notifier, "Stock Event Notifier", "Amazon SNS/SQS", "Notifies system of stock and inventory events.")
}

System_Ext(Amazon_OpenSearch, "Amazon OpenSearch", "Dedicated read replica providing typo tolerance, fuzzy matching, and ranking.")
System_Ext(Amazon_Aurora, "Amazon Aurora", "Robust transactional persistence for inventory mutations (PostgreSQL).")
System_Ext(Amazon_SNS_SQS, "Amazon SNS/SQS", "Asynchronous event publishing for recommendations and alerts.")

Rel(Search_Facade_Component, Amazon_OpenSearch, "Queries keyword, facet, and fuzzy data", "TCP / HTTPS")
Rel(Inventory_Manager_Component, Amazon_Aurora, "Reads and writes stock/catalog mutations", "PostgreSQL Wire Protocol")
Rel(Catalog_Event_Publisher, Amazon_SNS_SQS, "Emits state-change and low-stock events", "AMQP / JSON")

@enduml