@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Search Index container

System_Ext(Catalog_Search_Service, "Catalog & Search Service", "Container")
System_Ext(Amazon_SQS, "Amazon SQS", "Messaging Bus")
System_Ext(Amazon_S3, "Amazon S3", "Backup Storage")

Container_Boundary(Search_Index, "Search Index") {
    Component(Search_Coordinator, "Search Coordinator", "Java/Kotlin, OpenSearch Plugin", "Submits and coordinates search queries for shoppers and administrators.")
    Component(Indexing_Worker_with_Merchandising_Rules_Engine, "Indexing Worker with Merchandising Rules Engine", "OpenSearch Ingestion Engine", "Bulk-indexes documents and applies dynamic scoring and merchandising rules.")
    Component(Index_Shards_Storage, "Index Shards & Storage", "Apache Lucene Engine, Amazon OpenSearch Service", "Powers inverted indices, vector embeddings, and stores index shards with multi-AZ high availability.")
}

Rel(Catalog_Search_Service, Search_Coordinator, "Submits search queries", "HTTPS / REST over secure VPC")
Rel(Amazon_SQS, Indexing_Worker_with_Merchandising_Rules_Engine, "Delivers catalogue delta events", "AWS SDK / SQS Pull")
Rel(Indexing_Worker_with_Merchandising_Rules_Engine, Index_Shards_Storage, "Bulk-indexes documents and applies dynamic scoring", "Internal Transport Protocol")
Rel(Index_Shards_Storage, Amazon_S3, "Stores daily automated snapshots", "AWS SDK / HTTPS")

@enduml