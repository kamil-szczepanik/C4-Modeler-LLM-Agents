@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Messaging_Bus", "Messaging Bus") {
    Component("Topic Router", "Topic Router", "Amazon SNS", "Publishes and fans out order events to downstream event queues.")
    Component("Command & Event Queues", "Command & Event Queues", "Amazon SQS", "Buffers asynchronous messages for processing by consuming microservices.")
    Component("Dead Letter Queues", "Dead Letter Queues", "Amazon SQS DLQ", "Captures and stores failed or poisoned messages for troubleshooting.")
    Component("Telemetry SDK", "Telemetry SDK", "AWS X-Ray SDK", "Injects and propagates trace context across messaging boundaries.")
    Component("Idempotency Deduplication Handler", "Idempotency Deduplication Handler", "Amazon DynamoDB", "Verifies transaction uniqueness and prevents duplicate message processing.")
}

Rel("Topic Router", "Command & Event Queues", "Fans out messages via push subscriptions")
Rel("Command & Event Queues", "Idempotency Deduplication Handler", "Verifies transaction uniqueness during message processing")
Rel("Command & Event Queues", "Dead Letter Queues", "Routes failed messages after max retries")
@enduml