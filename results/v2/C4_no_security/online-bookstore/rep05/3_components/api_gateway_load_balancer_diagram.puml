@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_load_balancer, "API Gateway & Load Balancer") {
    Component(Amazon_Route_53, "Amazon Route 53", "AWS DNS", "Handles latency-based DNS routing for global traffic distribution.")
    Component(AWS_WAF, "AWS WAF", "AWS Web Application Firewall", "Protects against web exploits and malicious traffic.")
    Component(Application_Load_Balancer, "Application Load Balancer", "AWS ALB", "Distributes incoming HTTP/HTTPS traffic across multiple targets.")
    Component(API_Gateway, "API Gateway", "AWS API Gateway", "Manages secure client requests and real-time streams via HTTPS/REST and WebSockets.")
}

Rel(Amazon_Route_53, AWS_WAF, "Routes filtered traffic to")
Rel(AWS_WAF, Application_Load_Balancer, "Forwards inspected traffic to")
Rel(Application_Load_Balancer, API_Gateway, "Routes client requests to")

@enduml