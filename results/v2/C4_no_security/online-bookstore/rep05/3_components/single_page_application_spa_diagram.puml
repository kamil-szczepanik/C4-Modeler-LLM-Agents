@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(aws_api_gateway, "AWS API Gateway & Load Balancer", "External system")

Container_Boundary(spa, "Single Page Application (SPA)") {
    Component(Router_Component, "Router Component", "React Router", "Managing client-side navigation and lazy loading.")
    Component(Auth_Component, "Authentication & User Context Component", "React / TypeScript", "Handles JWT tokens and role-based access.")
    Component(Catalog_Component, "Catalog & Search UI Component", "React / TypeScript", "Renders book search and recommendation widgets.")
    Component(Cart_Component, "Cart & Checkout UI Component", "React / TypeScript", "Manages local cart state and multi-step checkout.")
    Component(API_Client_Component, "API Client Component", "TypeScript / HTTPS / WebSocket", "Encapsulates HTTPS/REST and WebSocket communication.")
}

Rel(Router_Component, Catalog_Component, "Lazy-loads catalogue views", "Client-side routing")
Rel(Router_Component, Cart_Component, "Lazy-loads checkout workflows", "Client-side routing")
Rel(Catalog_Component, API_Client_Component, "Requests book data and search indices", "Internal method call")
Rel(Cart_Component, API_Client_Component, "Sends cart mutations and orders", "Internal method call")
Rel(API_Client_Component, aws_api_gateway, "Communicates via HTTPS/REST and WebSockets", "TLS 1.3")

@enduml