@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("checkout_order_service", "Checkout & Order Service") {
    Component("Checkout Orchestrator", "Checkout Orchestrator", "Go SDK, Temporal", "Manages multi-step saga state persistence and timeout workflows for orders.")
    Component("Order Management API", "Order Management API", "REST, gRPC", "Exposes endpoints for creating and managing customer orders.")
    Component("Fulfillment & Integration Engine", "Fulfillment & Integration Engine", "Node.js / Go / Python", "Ingests third-party webhooks and queues asynchronous fulfillment updates.")
    Component("Data Access Repository", "Data Access Repository", "SQL / ORM", "Handles data persistence operations for orders, refunds, and idempotency data.")
}

Rel("Checkout Orchestrator", "Data Access Repository", "Persists workflow state and transaction data")
Rel("Order Management API", "Checkout Orchestrator", "Triggers checkout saga execution")
Rel("Fulfillment & Integration Engine", "Checkout Orchestrator", "Updates order fulfillment status")

@enduml