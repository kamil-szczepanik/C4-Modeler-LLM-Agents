@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Session Cache Store container

Container_Boundary(Session_Cache_Store, "Session Cache Store") {
    Component(ShoppingCartsTable, "ShoppingCartsTable", "Amazon DynamoDB", "Core Amazon DynamoDB table storing session and cart items.")
    Component(UserIndex, "UserIndex", "Global Secondary Index (GSI)", "Global Secondary Index on UserID for efficient user-specific data lookups.")
    Component(SessionRepository, "SessionRepository", "AWS SDK v3 for Node.js/Go", "Data access layer utilizing AWS SDK v3 for Node.js/Go.")
}

Component(Checkout_Order_Service, "Checkout & Order Service", "AWS PrivateLink, TLS 1.3", "Primary client writing and reading session states.")
Component(Data_Privacy_Service, "Data Privacy Service", "AWS PrivateLink, TLS 1.3", "External consumer handling GDPR/CCPA requests via UserIndex.")

Rel(Checkout_Order_Service, ShoppingCartsTable, "Manages cart and session data", "HTTPS, TLS 1.3, AWS PrivateLink")
Rel(Data_Privacy_Service, UserIndex, "Queries and purges user session data for compliance", "HTTPS, TLS 1.3, AWS PrivateLink")
Rel(ShoppingCartsTable, ShoppingCartsTable, "Replicates global data across regions", "AWS DynamoDB Global Tables Protocol")

@enduml