@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(data_privacy_service, "Data Privacy Service") {
    Component(dsar_orchestrator, "DSAR Orchestrator", "Node.js / TypeScript", "Orchestrates Data Subject Access Requests (DSAR) workflows, interacts with messaging queues and notification systems.")
    Component(consent_manager, "Consent Manager", "Go", "Manages user privacy consents and compliance preferences.")
    Component(data_anonymization_engine, "Data Anonymization Engine", "Python / Pandas", "Handles data masking, anonymization, and processing for privacy regulations.")
}

System_Ext(messaging_bus, "Messaging Bus (Amazon SQS)", "Messaging queue system")
System_Ext(notification_system, "Notification System (External)", "External notification system")
System_Ext(database_cluster, "Database Cluster (Amazon Aurora)", "PostgreSQL database cluster")
System_Ext(s3_buckets, "S3 Temporary Staging Buckets", "Object storage")

Rel(dsar_orchestrator, messaging_bus, "Sends asynchronous DSAR workflow messages", "AMQP")
Rel(dsar_orchestrator, notification_system, "Sends DSAR status notifications", "Amazon SNS/HTTPS")
Rel(data_privacy_service, database_cluster, "Persists and retrieves user privacy and consent data", "TCP/PostgreSQL driver")
Rel(dsar_orchestrator, s3_buckets, "Reads and writes encrypted DSAR export packages", "HTTPS")
Rel(consent_manager, s3_buckets, "Reads and writes encrypted DSAR export packages", "HTTPS")

@enduml