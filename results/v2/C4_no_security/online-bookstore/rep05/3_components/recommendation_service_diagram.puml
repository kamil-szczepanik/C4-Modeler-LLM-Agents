@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(recommendation_service, "Recommendation Service") {
    Component(RecommendationAPI, "Recommendation API Router", "Python, FastAPI", "Routes incoming recommendation requests from the API Gateway.")
    Component(ABEvaluator, "A/B Experimentation Evaluator", "Python", "Evaluates A/B testing variants for users.")
    Component(AlgorithmEngine, "Algorithm Engine", "Python, NumPy, PyTorch", "Generates collaborative filtering and recommendations using ML models.")
    Component(CircuitBreaker, "Circuit Breaker", "Python", "Prevents cascading failures by stopping traffic to failing dependencies.")
    Component(FallbackManager, "Fallback Manager", "Python", "Provides fallback responses when the algorithm engine or dependencies fail.")
    Component(ClickstreamPublisher, "Clickstream Publisher", "Python, Amazon SQS/SNS", "Asynchronously publishes telemetry and clickstream events.")
    Component(DataAccessClient, "Data Access Client", "Python, SQL/ORM", "Fetches user history, metadata, cached vectors, and session data.")
}

Rel(RecommendationAPI, ABEvaluator, "Evaluates experiment variants", "")
Rel(ABEvaluator, AlgorithmEngine, "Requests model inference", "")
Rel(RecommendationAPI, CircuitBreaker, "Guards requests through", "")
Rel(CircuitBreaker, FallbackManager, "Triggers fallback on failure", "")
Rel(AlgorithmEngine, DataAccessClient, "Reads vectors and metadata", "SQL/ORM")
Rel(RecommendationAPI, ClickstreamPublisher, "Publishes clickstream telemetry", "SQS/SNS")

@enduml