@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore

Person(Guest_Shopper, "Guest Shopper", "An unauthenticated user browsing the catalogue and interacting with the bookstore.")
Person(Registered_Customer, "Registered Customer", "An authenticated user performing secure checkout, managing carts, and purchasing books.")
Person(Store_Administrator, "Store Administrator", "An administrator managing inventory and moderation via the Admin Portal.")
Person(Customer_Support_Agent, "Customer Support Agent", "An agent assisting customers with support requests.")

System_Ext(Payment_Gateway, "Payment Gateway", "External system handling secure synchronous payments with Circuit Breaker and TLS 1.3.")
System_Ext(Shipping_Provider_API, "Shipping Provider API", "External system handling order shipments via asynchronous event-driven messaging.")
System_Ext(Tax_Compliance_Service, "Tax/Compliance Service", "External system ensuring GDPR, CCPA, and multi-currency compliance.")
System_Ext(AWS_Route_53, "AWS Route 53", "Infrastructure container providing global DNS health-checking and latency-based routing.")
System_Ext(AWS_SQS_EventBridge, "AWS SQS/EventBridge", "Infrastructure container handling asynchronous event-driven messaging and decoupling.")
System_Ext(Amazon_DynamoDB, "Amazon DynamoDB", "Infrastructure container for session/cart state, idempotency storage, and safe transaction retries.")

System_Boundary(Online_Bookstore, "Online Bookstore") {
    Container(Frontend_Container, "Frontend Container", "React, TypeScript, Amazon CloudFront, S3", "Single-Page Application (SPA) for fast global content delivery and user interaction.")
    Container(API_Management, "API Management", "Amazon API Gateway", "Manages ingress, JSON routing, rate limiting, and JWT validation.")
    Container(Catalog_Search, "Catalog & Search", "Java, Spring Boot, Amazon OpenSearch", "Handles book catalog management and fast search capabilities.")
    Container(Checkout_Order, "Checkout & Order", "Node.js, Amazon RDS (PostgreSQL)", "Handles secure checkout, orders, and transactional data.")
    Container(Recommendation, "Recommendation", "Python, FastAPI", "Provides personalized recommendations for users.")
    Container(Analytics_Ingestion, "Analytics Ingestion", "Go, Amazon Kinesis", "Performs real-time clickstream streaming and analytics ingestion.")
    Container(Notification, "Notification", "Asynchronous messaging", "Handles asynchronous user notifications.")
    ContainerDb(Amazon_RDS_PostgreSQL, "Amazon RDS (PostgreSQL)", "PostgreSQL", "Transactional database for core services.")
    Container(AWS_SQS, "AWS SQS", "Amazon SQS", "Asynchronous messaging queue for inter-container communication.")
    Container(AWS_EventBridge, "AWS EventBridge", "Amazon EventBridge", "Event bus for asynchronous inter-container communication.")
}

Rel(Guest_Shopper, Frontend_Container, "Browses catalogue and interacts with the application.", "HTTPS")
Rel(Registered_Customer, Frontend_Container, "Performs secure checkout, manages carts, and purchases books.", "HTTPS")
Rel(Store_Administrator, Frontend_Container, "Manages inventory and moderation.", "HTTPS")
Rel(Customer_Support_Agent, Frontend_Container, "Assists customers with support requests.", "HTTPS")

Rel(Frontend_Container, API_Management, "Sends API requests for data and actions.", "HTTPS / REST & GraphQL")
Rel(API_Management, Catalog_Search, "Routes catalog and search requests with rate limiting and JWT validation.", "HTTPS / JSON")
Rel(API_Management, Checkout_Order, "Routes checkout and order requests with rate limiting and JWT validation.", "HTTPS / JSON")
Rel(API_Management, Recommendation, "Routes recommendation requests with rate limiting and JWT validation.", "HTTPS / JSON")
Rel(API_Management, Analytics_Ingestion, "Streams clickstream data.", "Amazon Kinesis")

Rel(Catalog_Search, AWS_SQS, "Publishes and consumes asynchronous messages.", "AWS SQS")
Rel(Catalog_Search, AWS_EventBridge, "Publishes and consumes events.", "AWS EventBridge")
Rel(Checkout_Order, AWS_SQS, "Publishes and consumes asynchronous messages.", "AWS SQS")
Rel(Checkout_Order, AWS_EventBridge, "Publishes and consumes events.", "AWS EventBridge")
Rel(Recommendation, AWS_SQS, "Publishes and consumes asynchronous messages.", "AWS SQS")
Rel(Recommendation, AWS_EventBridge, "Publishes and consumes events.", "AWS EventBridge")

Rel(Catalog_Search, Amazon_RDS_PostgreSQL, "Stores and retrieves transactional data.", "TLS-encrypted JDBC/TCP")
Rel(Checkout_Order, Amazon_RDS_PostgreSQL, "Stores and retrieves transactional data.", "TLS-encrypted JDBC/TCP")
Rel(Checkout_Order, Amazon_DynamoDB, "Stores session and cart state.", "TCP")

Rel(Checkout_Order, Payment_Gateway, "Processes secure payments.", "HTTPS / REST")
Rel(Checkout_Order, Shipping_Provider_API, "Dispatches shipping orders via asynchronous messaging.", "AWS SQS/EventBridge")
Rel(Checkout_Order, Tax_Compliance_Service, "Validates tax and compliance requirements.", "AWS SQS/EventBridge")

@enduml