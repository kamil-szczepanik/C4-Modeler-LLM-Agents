@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(frontend_container, "Frontend Container") {
    Component(Catalog__Search_UI_Module, "Catalog & Search UI Module", "React, TypeScript", "Handles book browsing, searching, and ratings/reviews display.")
    Component(Checkout__Cart_UI_Module, "Checkout & Cart UI Module", "React, TypeScript", "Manages multi-currency carts and secure checkout flows.")
    Component(Recommendation_Module, "Recommendation Module", "React, TypeScript", "Renders 'Customers also bought' widgets.")
    Component(Auth__Compliance_Module, "Auth & Compliance Module", "React, TypeScript, Zustand, React Context", "Manages user sessions and GDPR/CCPA consent states.")
    Component(API_Client__State_Layer, "API Client & State Layer", "Axios, Apollo Client, Zustand, React Context", "Centralizes network calls and global state management.")
}

Rel(Catalog__Search_UI_Module, API_Client__State_Layer, "Makes API requests via", "")
Rel(Checkout__Cart_UI_Module, API_Client__State_Layer, "Makes API requests via", "")
Rel(Recommendation_Module, API_Client__State_Layer, "Fetches recommendations via", "")
Rel(Auth__Compliance_Module, API_Client__State_Layer, "Sends auth and consent data via", "")

@enduml