@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_eventbridge, "AWS EventBridge") {
    Component(Default_Custom_Event_Buses, "Default & Custom Event Buses", "AWS EventBridge", "Receives and routes domain events across the system.")
    Component(Event_Rules, "Event Rules", "EventBridge Rules", "Evaluates incoming events and routes them to appropriate targets.")
    Component(Input_Transformers, "Input Transformers", "EventBridge Transformers", "Transforms event payloads before they are dispatched to targets.")
    Component(API_Destinations, "API Destinations", "EventBridge API Destinations", "Dispatches external shipping events via HTTPS with connection throttling.")
}

Rel(Default_Custom_Event_Buses, Event_Rules, "Evaluates events against")
Rel(Event_Rules, Input_Transformers, "Transforms payloads for")
Rel(Event_Rules, API_Destinations, "Dispatches external shipping events via")
@enduml