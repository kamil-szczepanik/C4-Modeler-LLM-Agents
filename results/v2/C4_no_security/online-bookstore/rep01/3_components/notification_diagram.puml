@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification container

System_Ext(aws_sqs, "AWS SQS", "Message Queue")
System_Ext(amazon_ses_amazon_sns, "Amazon SES / Amazon SNS", "External messaging services")

Container_Boundary(notification, "Notification") {
    Component(event_consumer_component, "Event Consumer Component", "Java, Spring Boot", "Polls AWS SQS to consume asynchronous transactional messaging.")
    Component(priority_router_component, "Priority Router Component", "Java", "Routes critical transactional payloads past bulk queues.")
    Component(template_engine_component, "Template Engine Component", "Handlebars.js", "Performs dynamic, localized message rendering.")
    Component(dispatch_adapter_component, "Dispatch Adapter Component", "HTTPS REST API", "Integrates with external messaging services for email and SMS delivery.")
    Component(preference_audit_repository_component, "Preference & Audit Repository Component", "Amazon RDS PostgreSQL, JDBC over TLS", "Manages GDPR/CCPA compliance logging and user preferences.")
}

Rel(aws_sqs, event_consumer_component, "AMQP/HTTPS polling", "AMQP/HTTPS")
Rel(event_consumer_component, priority_router_component, "In-Memory Java method call", "In-Memory")
Rel(priority_router_component, template_engine_component, "In-Memory Java method call", "In-Memory")
Rel(template_engine_component, dispatch_adapter_component, "HTTPS REST API", "HTTPS")
Rel(dispatch_adapter_component, amazon_ses_amazon_sns, "HTTPS REST API", "HTTPS")
Rel(event_consumer_component, preference_audit_repository_component, "JDBC over TLS", "JDBC/TLS")
Rel(dispatch_adapter_component, preference_audit_repository_component, "JDBC over TLS", "JDBC/TLS")

@enduml