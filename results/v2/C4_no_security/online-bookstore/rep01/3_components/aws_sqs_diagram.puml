@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_sqs, "AWS SQS") {
    Component(Amazon_SQS_Standard_Queues, "Amazon SQS Standard Queues", "Amazon SQS Standard", "Publishes event notifications via AWS SDK v2 (HTTPS) for Catalog & Search and Recommendation containers.")
    Component(Amazon_SQS_FIFO_Queues, "Amazon SQS FIFO Queues", "Amazon SQS FIFO", "Sends transaction events via AWS SDK v2 (HTTPS) using message group IDs for Checkout & Order container, ensuring strictly ordered payment workflows.")
    Component(Amazon_SQS_Dead_Letter_Queues_DLQs, "Amazon SQS Dead-Letter Queues (DLQs)", "Amazon SQS DLQ", "Captures failed payloads and triggers processing via long-polling (HTTPS).")
}

System(Checkout_and_Order_Container, "Checkout & Order Container", "External Container")
System(Catalog_and_Search_Container, "Catalog & Search Container", "External Container")
System(Recommendation_Container, "Recommendation Container", "External Container")
System(Notification_and_Logging_Container, "Notification & Logging Container", "External Container")

Rel(Checkout_and_Order_Container, Amazon_SQS_FIFO_Queues, "Sends transaction events via AWS SDK v2 (HTTPS) using message group IDs", "AWS SDK v2 (HTTPS)")
Rel(Catalog_and_Search_Container, Amazon_SQS_Standard_Queues, "Publishes event notifications via AWS SDK v2 (HTTPS)", "AWS SDK v2 (HTTPS)")
Rel(Recommendation_Container, Amazon_SQS_Standard_Queues, "Publishes event notifications via AWS SDK v2 (HTTPS)", "AWS SDK v2 (HTTPS)")
Rel(Amazon_SQS_Dead_Letter_Queues_DLQs, Notification_and_Logging_Container, "Triggers processing via long-polling (HTTPS) for failed payloads", "HTTPS")

@enduml