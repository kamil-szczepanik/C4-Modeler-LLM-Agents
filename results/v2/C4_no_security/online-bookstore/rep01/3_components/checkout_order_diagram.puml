@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Checkout_Order", "Checkout & Order") {
    Component("Checkout_Controller", "Checkout Controller", "Express.js router", "Express.js router for API Gateway requests.")
    Component("Order_Orchestrator", "Order Orchestrator", "Node.js & TypeScript", "Core domain logic and state machine.")
    Component("Cart_Manager", "Cart Manager", "Node.js & TypeScript", "DynamoDB session and cart state handler.")
    Component("Fulfillment_Publisher", "Fulfillment Publisher", "AWS EventBridge/SQS", "AWS EventBridge/SQS event emitter.")
    Component("Order_Repository", "Order Repository", "TypeORM", "TypeORM-based PostgreSQL mapper.")
    Component("Consent_Auditor", "Consent Auditor", "Node.js & TypeScript", "GDPR/CCPA compliance middleware.")
    Component("Payment_Gateway_Client", "Payment Gateway Client", "mTLS REST adapter", "mTLS REST adapter with circuit breakers.")
}

System_Ext("API_Management", "API Management", "External API Management Gateway")
System_Ext("Amazon_DynamoDB", "Amazon DynamoDB", "NoSQL database for sessions and cart state")
System_Ext("Payment_Gateway", "Payment Gateway", "External payment processing service")
System_Ext("AWS_SQS", "AWS SQS", "Simple Queue Service for asynchronous messaging")
System_Ext("AWS_EventBridge", "AWS EventBridge", "Serverless event bus")
System_Ext("Amazon_RDS_PostgreSQL", "Amazon RDS (PostgreSQL)", "Relational database for transactional data")

Rel("Checkout_Controller", "API_Management", "Receives HTTPS / JSON requests with JWT validation", "HTTPS / JSON")
Rel("Cart_Manager", "Amazon_DynamoDB", "Manages active shopping sessions over TCP", "TCP")
Rel("Order_Orchestrator", "Payment_Gateway", "Processes secure payments via HTTPS / REST with mTLS", "HTTPS / REST with mTLS")
Rel("Fulfillment_Publisher", "AWS_SQS", "Publishes asynchronous events for shipping and tax", "AWS SDK")
Rel("Fulfillment_Publisher", "AWS_EventBridge", "Publishes asynchronous events for shipping and tax", "AWS SDK")
Rel("Order_Repository", "Amazon_RDS_PostgreSQL", "Persists transactional data via TLS-encrypted JDBC/TCP", "TLS-encrypted JDBC/TCP")

@enduml