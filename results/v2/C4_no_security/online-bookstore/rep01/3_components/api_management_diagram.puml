@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Management container

Container(frontend_container, "Frontend Container", "React, TypeScript, Amazon CloudFront, Amazon S3", "Frontend application for users.")
System_Ext(catalog_and_search, "Catalog & Search", "Downstream Service", "Handles catalog browsing and search.")
System_Ext(checkout_and_order, "Checkout & Order", "Downstream Service", "Handles checkout and order processing.")
System_Ext(recommendation, "Recommendation", "Downstream Service", "Provides personalized recommendations.")
System_Ext(analytics_ingestion, "Analytics Ingestion", "Amazon Kinesis", "Ingests analytics and clickstream data.")

Container_Boundary(api_management, "API Management") {
    Component(auth_component, "Authentication & Authorization Component", "AWS Lambda Authorizer", "Executes edge-based JWT validation for GDPR/CCPA compliance and validates tokens.")
    Component(router_component, "Request Router & Transformation Component", "API Gateway Mappings / VTL", "Routes transformed payloads to downstream services.")
    Component(telemetry_component, "Telemetry & Analytics Proxy Component", "Amazon CloudWatch, AWS X-Ray", "Provides telemetry, active tracing, and 5xx error monitoring.")
    Component(rate_limiting_component, "Rate Limiting & Usage Metering Component", "API Gateway Usage Plans & API Keys", "Applies throttling and API key validation.")
}

Rel(frontend_container, auth_component, "Validates tokens", "HTTPS")
Rel(router_component, catalog_and_search, "Routes transformed payloads", "HTTPS / JSON")
Rel(router_component, checkout_and_order, "Routes transformed payloads", "HTTPS / JSON")
Rel(router_component, recommendation, "Routes transformed payloads", "HTTPS / JSON")
Rel(rate_limiting_component, api_management, "Applies throttling and API key validation", "Internal API")
Rel(api_management, analytics_ingestion, "Streams clickstream data", "Amazon Kinesis")

@enduml