@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(catalog_search, "Catalog & Search") {
    Component(Search Controller & Facade, "Search Controller & Facade", "Spring MVC", "Handling REST search requests.")
    Component(Catalog Management Service, "Catalog Management Service", "Spring Boot", "Admin service for CRUD book metadata operations.")
    Component(Index Synchronization Worker, "Index Synchronization Worker", "Spring Batch / Event Listener", "Processing async updates.")
    Component(OpenSearch Client Repository, "OpenSearch Client Repository", "Java Library", "Repository interacting with search indexes.")
    Component(Circuit Breaker & Fallback Manager, "Circuit Breaker & Fallback Manager", "Resilience4j", "Resilience component for graceful degradation.")
    Component(Amazon OpenSearch, "Amazon OpenSearch", "Amazon OpenSearch", "Managed search engine for catalog indexing.")
    Component(Amazon RDS (PostgreSQL), "Amazon RDS (PostgreSQL)", "PostgreSQL", "Relational database for transactional records.")
    Component(AWS EventBridge & SQS, "AWS EventBridge & SQS", "AWS EventBridge & SQS", "Event bus and message queue with DLQ support.")
}

Rel(Search Controller & Facade, Amazon OpenSearch, "Queries search indices over HTTPS.", "HTTPS")
Rel(Catalog Management Service, Amazon RDS (PostgreSQL), "Persists transactional data via TLS-encrypted JDBC/TCP.", "TLS-encrypted JDBC/TCP")
Rel(AWS EventBridge & SQS, Index Synchronization Worker, "Delivers domain events via AWS SQS using JSON over HTTPS.", "JSON over HTTPS")
Rel(Index Synchronization Worker, Amazon OpenSearch, "Applies document upserts using the OpenSearch REST Client over HTTPS.", "HTTPS")
@enduml