@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Online Bookstore

Person(Guest_Shopper, "Guest Shopper", "An unauthenticated user browsing the catalogue and interacting with the bookstore.")
Person(Registered_Customer, "Registered Customer", "An authenticated user performing secure checkout, managing carts, and purchasing books.")
Person(Store_Administrator, "Store Administrator", "An administrator managing inventory and moderation via the Admin Portal.")
Person(Customer_Support_Agent, "Customer Support Agent", "An agent assisting customers with support requests.")

System(Online_Bookstore, "Online Bookstore", "An Amazon-style online bookstore designed to provide scalable catalogue browsing, secure checkout, and recommendations for 1M MAU across multiple AWS regions.")

System_Ext(Payment_Gateway, "Payment Gateway", "External system handling secure synchronous payments with Circuit Breaker and TLS 1.3.")
System_Ext(Shipping_Provider_API, "Shipping Provider API", "External system handling order shipments via asynchronous event-driven messaging.")
System_Ext(Tax_Compliance_Service, "Tax/Compliance Service", "External system ensuring GDPR, CCPA, and multi-currency compliance.")
System_Ext(AWS_Route_53, "AWS Route 53", "Infrastructure container providing global DNS health-checking and latency-based routing.")
System_Ext(AWS_SQS_EventBridge, "AWS SQS/EventBridge", "Infrastructure container handling asynchronous event-driven messaging and decoupling.")
System_Ext(Amazon_DynamoDB, "Amazon DynamoDB", "Infrastructure container for idempotency storage and safe transaction retries.")

Rel(Guest_Shopper, Online_Bookstore, "HTTPS (Web/Mobile) for catalogue browsing, cart, and checkout.", "HTTPS")
Rel(Registered_Customer, Online_Bookstore, "HTTPS (Web/Mobile) for catalogue browsing, cart, and checkout.", "HTTPS")
Rel(Store_Administrator, Online_Bookstore, "HTTPS (Admin Portal) for inventory and moderation.", "HTTPS")
Rel(Customer_Support_Agent, Online_Bookstore, "HTTPS (Web/Mobile) for customer support interactions.", "HTTPS")
Rel(Online_Bookstore, Payment_Gateway, "Synchronous payment processing with Circuit Breaker and TLS 1.3.", "HTTPS / REST")
Rel(Online_Bookstore, Shipping_Provider_API, "Asynchronous event-driven messaging for shipping.", "AWS SQS/EventBridge")
Rel(Online_Bookstore, Tax_Compliance_Service, "Asynchronous event-driven messaging for tax and compliance.", "AWS SQS/EventBridge")

@enduml