@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Library Management System

Person(LibraryPatrons, "Library Patrons", "Students and public members who access the self-service portals to borrow books, search catalogs, and manage their accounts.")
Person(LibrariansandCirculationStaff, "Librarians and Circulation Staff", "Staff members responsible for managing circulation, cataloging, and daily library operations.")
Person(LibraryAdministrators, "Library Administrators", "Administrators who oversee system configurations, policies, and management reporting.")

System(LibraryManagementSystem, "Library Management System", "Provides cataloging, circulation, and self-service portals for public and academic libraries while ensuring strict EU data residency compliance and high-performance search requirements.")

System_Ext(IdentityProvider, "Identity Provider", "Auth0 EU or Keycloak handling OIDC/OAuth2 authentication and GDPR compliance.")
System_Ext(PaymentGateway, "Payment Gateway", "Stripe EU for secure fine and fee processing.")
System_Ext(NotificationService, "Notification Service", "Twilio EU / SendGrid for user notifications and alerts.")
System_Ext(DigitalContentProviders, "Digital Content Providers", "OverDrive/Libby APIs providing access to digital media and e-content.")
System_Ext(EUhostedLogMetricsAggregator, "EU-hosted Log & Metrics Aggregator", "OpenTelemetry / Grafana Cloud EU for EU-perimeter log and metric aggregation.")

Rel(LibraryPatrons, LibraryManagementSystem, "Accesses catalog and self-service portals", "HTTPS (TLS 1.3) via Web/Mobile")
Rel(LibrariansandCirculationStaff, LibraryManagementSystem, "Manages circulation and library operations", "HTTPS (TLS 1.3) via Web/Mobile")
Rel(LibraryAdministrators, LibraryManagementSystem, "Configures and administers the system", "HTTPS (TLS 1.3) via Web/Mobile")
Rel(LibraryManagementSystem, IdentityProvider, "Authenticates users and ensures GDPR compliance", "OIDC/OAuth2 over HTTPS")
Rel(LibraryManagementSystem, PaymentGateway, "Processes fines and fees securely", "HTTPS/REST")
Rel(LibraryManagementSystem, NotificationService, "Sends automated notifications to users", "HTTPS/REST")
Rel(LibraryManagementSystem, DigitalContentProviders, "Retrieves digital content and media APIs", "HTTPS/REST")

@enduml