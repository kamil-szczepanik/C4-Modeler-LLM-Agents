@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(LibraryPatrons, "Library Patrons", "Students and public members who access the self-service portals to borrow books, search catalogs, and manage their accounts.")
Person(LibrariansandCirculationStaff, "Librarians and Circulation Staff", "Staff members responsible for managing circulation, cataloging, and daily library operations.")
Person(LibraryAdministrators, "Library Administrators", "Administrators who oversee system configurations, policies, and management reporting.")

System_Ext(PaymentGateway, "Payment Gateway", "Stripe EU for secure fine and fee processing.")
System_Ext(IdentityProvider, "Identity Provider", "Auth0 EU or Keycloak handling OIDC/OAuth2 authentication and GDPR compliance.")
System_Ext(NotificationService, "Notification Service", "Twilio EU / SendGrid for user notifications and alerts.")
System_Ext(DigitalContentProviders, "Digital Content Providers", "OverDrive/Libby APIs providing access to digital media and e-content.")
System_Ext(EUhostedLogMetricsAggregator, "EU-hosted Log & Metrics Aggregator", "OpenTelemetry / Grafana Cloud EU for EU-perimeter log and metric aggregation.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(PatronWebAppStaffPortal, "Patron Web App & Staff Portal", "TypeScript/React SPAs", "Provides scalable self-service portals and staff management tools.")
    Container(APIGateway, "API Gateway", "Nginx or Spring Cloud Gateway", "Routes incoming client requests to backend microservices.")
    Container(CatalogSearchService, "Catalog & Search Service", "Java/Spring Boot + Elasticsearch", "Provides high-performance indexing for sub-800ms search compliance and catalog management.")
    Container(CirculationService, "Circulation Service", "Java/Spring Boot + PostgreSQL", "Manages transactional data for inventory and circulation.")
    Container(NotificationIntegrationWorker, "Notification & Integration Worker", "Node.js/Python", "Handles asynchronous notifications and system integrations.")
    Container(InternalEventBus, "Internal Event Bus", "Apache Kafka or RabbitMQ", "Facilitates asynchronous messaging between microservices.")
    Container(ManagedKubernetesCluster, "Managed Kubernetes Cluster", "EKS/AKS in EU-central", "GitOps-driven deployment infrastructure on EU-central infrastructure ensuring data residency compliance.")
    ContainerDb(Elasticsearch, "Elasticsearch", "Elasticsearch", "High-performance indexing database for search queries.")
    ContainerDb(PostgreSQL, "PostgreSQL", "PostgreSQL", "Relational storage for inventory and circulation data.")
}

Rel(LibraryPatrons, PatronWebAppStaffPortal, "Accesses self-service portal", "HTTPS/REST and WebSockets")
Rel(LibrariansandCirculationStaff, PatronWebAppStaffPortal, "Accesses staff management tools", "HTTPS/REST and WebSockets")
Rel(LibraryAdministrators, PatronWebAppStaffPortal, "Accesses system management tools", "HTTPS/REST and WebSockets")
Rel(PatronWebAppStaffPortal, APIGateway, "Sends client requests", "HTTPS/REST and WebSockets")
Rel(PatronWebAppStaffPortal, IdentityProvider, "Authenticates users", "OIDC/OAuth2 over HTTPS")
Rel(APIGateway, CatalogSearchService, "Routes search and catalog requests", "internal gRPC")
Rel(APIGateway, CirculationService, "Routes circulation requests", "internal gRPC")
Rel(CatalogSearchService, Elasticsearch, "Executes search queries and indexing", "Database Protocol")
Rel(CatalogSearchService, DigitalContentProviders, "Retrieves digital content APIs", "HTTPS/REST")
Rel(CirculationService, PostgreSQL, "Reads and writes transactional data", "Database Protocol")
Rel(CirculationService, PaymentGateway, "Processes fine payments", "HTTPS/REST")
Rel(CirculationService, InternalEventBus, "Publishes circulation events", "Apache Kafka/RabbitMQ")
Rel(InternalEventBus, NotificationIntegrationWorker, "Consumes events for notification processing", "Apache Kafka/RabbitMQ")
Rel(NotificationIntegrationWorker, NotificationService, "Sends notifications to users", "HTTPS/REST")
Rel(ManagedKubernetesCluster, EUhostedLogMetricsAggregator, "Aggregates logs and metrics", "OpenTelemetry over HTTPS")

@enduml