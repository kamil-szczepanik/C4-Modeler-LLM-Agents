@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Managed Kubernetes Cluster container

System_Ext(api_gateway, "API Gateway", "External API Gateway")
System_Ext(eu_log_aggregator, "EU-hosted Log & Metrics Aggregator", "External log and metrics aggregation system")
System_Ext(git_repo, "Git Repository", "External Git repository for declarative manifests")

Container_Boundary(managed_kubernetes_cluster_boundary, "Managed Kubernetes Cluster") {
    Component(managed_kubernetes_cluster, "Managed Kubernetes Cluster", "Kubernetes (EKS/AKS in EU-central)", "EU-central deployment infrastructure enforcing data residency and cloud container orchestration.")
    Component(gitops_operator, "GitOps Operator", "ArgoCD", "Declarative continuous delivery and zero-downtime rolling updates.")
    Component(ingress_controller, "Ingress Controller", "Nginx Ingress", "Routes external traffic with TLS termination and edge routing.")
    Component(cluster_autoscaler_hpa, "Cluster Autoscaler & HPA", "Kubernetes Autoscaling", "Dynamically scales nodes and pods for cost efficiency during off-peak hours.")
    Component(opentelemetry_collector_fluentbit, "OpenTelemetry Collector & Fluentbit", "OpenTelemetry & Fluentbit DaemonSets", "Batch-exporting logs, metrics, and API server audit logs for observability and compliance.")
    Component(backup_tool, "Backup Tool", "Velero", "Automated encrypted cluster-state backups targeting EU object storage for disaster recovery.")
}

Rel(managed_kubernetes_cluster, eu_log_aggregator, "Streams telemetry and audit logs", "OpenTelemetry/Vector over HTTPS")
Rel(api_gateway, ingress_controller, "Routes external user and staff traffic", "HTTPS")
Rel(gitops_operator, git_repo, "Pulls declarative manifests for continuous deployment", "HTTPS")

@enduml