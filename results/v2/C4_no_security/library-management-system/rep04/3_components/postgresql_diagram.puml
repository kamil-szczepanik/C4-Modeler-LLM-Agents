@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL container

Container_Boundary(postgresql, "PostgreSQL") {
    Component(Core_Relational_Engine, "Core Relational Engine", "PostgreSQL 16", "Core relational engine managing structured tables (Patrons, Inventory, Circulation_Transactions) with ACID compliance.")
    Component(PgBouncer, "PgBouncer", "PgBouncer", "Connection pooler managing backend processes over TCP to prevent connection thread exhaustion.")
    Component(Audit_Logging_Extension, "Audit Logging Extension", "pgaudit", "Audit logging extension for DDL/DML security activity.")
    Component(Partition_Manager, "Partition Manager", "pg_partman", "Extension for time-based partitioning and efficient GDPR data purging of Circulation_Transactions.")
    Component(Security_Automation, "Security & Automation", "PL/pgSQL Triggers & RLS", "Implemented for automated PII anonymization and masking.")
}

Rel(PgBouncer, Core_Relational_Engine, "Forwards queries", "TCP / PostgreSQL Wire Protocol")
Rel(Core_Relational_Engine, Partition_Manager, "Executes partition drop operations for GDPR data purging")
Rel(Core_Relational_Engine, Audit_Logging_Extension, "Records DDL/DML security activity")
@enduml