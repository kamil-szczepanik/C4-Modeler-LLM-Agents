@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patron Web App & Staff Portal container

Container_Boundary(patron_web_app_staff_portal, "Patron Web App & Staff Portal") {
    Component(Patron_SPA_Component, "Patron SPA Component", "TypeScript / React SPA", "Provides self-service portal functionality for library patrons.")
    Component(Staff_SPA_Component, "Staff SPA Component", "TypeScript / React SPA", "Provides circulation and management tools for librarians and staff.")
    Component(Session___Token_Management_Module, "Session & Token Management Module", "OAuth2 / OIDC Client", "Manages user authentication, tokens, and strict RBAC routing.")
    Component(API_Client_Component, "API Client Component", "Axios / Fetch API Client", "Manages request tracing, telemetry, and EU-header propagation.")
}

Rel(Patron_SPA_Component, Session___Token_Management_Module, "Authenticates users and manages sessions via", "OAuth2 / OIDC")
Rel(Staff_SPA_Component, Session___Token_Management_Module, "Authenticates users and manages sessions via", "OAuth2 / OIDC")
Rel(Patron_SPA_Component, API_Client_Component, "Sends HTTP requests via", "Axios / Fetch")
Rel(Staff_SPA_Component, API_Client_Component, "Sends HTTP requests via", "Axios / Fetch")

@enduml