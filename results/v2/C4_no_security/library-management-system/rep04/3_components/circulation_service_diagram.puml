@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Circulation Service container

Container_Boundary(circulation_service, "Circulation Service") {
    Component(LoanManagementComponent, "LoanManagementComponent", "Spring @Service", "Manages loan transactions and circulation workflows.")
    Component(HoldQueueComponent, "HoldQueueComponent", "Spring @Service", "Handles item hold queues and reservation logic.")
    Component(FineManagementComponent, "FineManagementComponent", "Spring @Service", "Calculates and processes patron fines.")
    Component(PolicyOverrideComponent, "PolicyOverrideComponent", "Spring @Service", "Evaluates and applies circulation policy overrides.")
    Component(CirculationDataRepository, "CirculationDataRepository", "Spring Data JPA / HikariCP", "Manages database interactions for transactional circulation data.")
    Component(CirculationEventPublisher, "CirculationEventPublisher", "Spring Cloud Stream / Apache Kafka", "Publishes domain events to the internal event bus.")
}

System_Ext(PostgreSQL, "PostgreSQL", "PostgreSQL database (EU-hosted)", "Stores transactional circulation data.")
System_Ext(Payment_Gateway, "Payment Gateway", "External REST API", "Processes fine payments.")
System_Ext(Internal_Event_Bus, "Internal Event Bus", "Apache Kafka", "Facilitates event-driven messaging.")
System_Ext(EU_hosted_Log_Metrics_Aggregator, "EU-hosted Log & Metrics Aggregator", "OpenTelemetry", "Collects and aggregates logs and metrics.")

Rel(LoanManagementComponent, CirculationDataRepository, "Reads/writes transactional data")
Rel(HoldQueueComponent, CirculationDataRepository, "Reads/writes transactional data")
Rel(FineManagementComponent, CirculationDataRepository, "Reads/writes transactional data")
Rel(PolicyOverrideComponent, CirculationDataRepository, "Reads/writes transactional data")
Rel(FineManagementComponent, Payment_Gateway, "Process fine payments", "HTTPS/REST")
Rel(CirculationEventPublisher, Internal_Event_Bus, "Publishes domain events", "Kafka protocol")
Rel(CirculationDataRepository, PostgreSQL, "Reads/writes transactional data", "PostgreSQL wire protocol")
Rel(LoanManagementComponent, EU_hosted_Log_Metrics_Aggregator, "Routes logs/metrics", "OpenTelemetry")
Rel(HoldQueueComponent, EU_hosted_Log_Metrics_Aggregator, "Routes logs/metrics", "OpenTelemetry")
Rel(FineManagementComponent, EU_hosted_Log_Metrics_Aggregator, "Routes logs/metrics", "OpenTelemetry")
Rel(PolicyOverrideComponent, EU_hosted_Log_Metrics_Aggregator, "Routes logs/metrics", "OpenTelemetry")

@enduml