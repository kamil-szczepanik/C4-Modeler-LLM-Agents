@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container(Catalog___Search_Service, "Catalog & Search Service", "Java/Spring Boot", "Handling item discovery and communicating with the search infrastructure.")

Container_Boundary(Elasticsearch, "Elasticsearch") {
    Component(Routing___Coordination_Component, "Routing & Coordination Component", "Elasticsearch Node / Java API", "Handles incoming query distribution and aggregation.")
    Component(Search___Query_Execution_Component, "Search & Query Execution Component", "Elasticsearch Core", "Executes full-text and faceted search queries.")
    Component(Indexing___Lucene_Storage_Component, "Indexing & Lucene Storage Component", "Apache Lucene / NVMe Storage", "Manages inverted indices and Lucene storage.")
    Component(Analysis___Tokenization_Component, "Analysis & Tokenization Component", "Elasticsearch Analysis Module", "Handles text normalization, stemming, and diacritic filtering.")
}

Rel(Catalog___Search_Service, Routing___Coordination_Component, "HTTP/REST or Transport Client", "TCP")
Rel(Routing___Coordination_Component, Analysis___Tokenization_Component, "Internal In-Memory Pipeline", "Java API")
Rel(Analysis___Tokenization_Component, Indexing___Lucene_Storage_Component, "Lucene Document Ingestion", "In-Memory")
Rel(Routing___Coordination_Component, Search___Query_Execution_Component, "Inter-node Transport Protocol", "TCP/9300")
Rel(Routing___Coordination_Component, Indexing___Lucene_Storage_Component, "Inter-node Transport Protocol", "TCP/9300")
@enduml