@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(internal_event_bus, "Internal Event Bus") {
    Component(Kafka_Broker, "Kafka Broker", "Apache Kafka", "Provides durable, append-only commit logs for at-least-once delivery and zero-blocking resilience during outages.")
    Component(Schema_Registry, "Schema Registry", "Confluent Schema Registry with Avro/JSON Schema", "Enforces strict payload contracts via Avro/JSON Schema to prevent breaking changes.")
    Component(Dead_Letter_Queue_Topics, "Dead Letter Queue Topics", "Apache Kafka Topics", "Routes failed messages after max retry attempts.")
}

System_Ext(Circulation_Service, "Circulation Service", "Circulation Service container")
System_Ext(Notification_Integration_Worker, "Notification & Integration Worker", "Notification & Integration Worker container")
System_Ext(Catalog_Search_Service, "Catalog & Search Service", "Catalog & Search Service container")
System_Ext(EU_hosted_Log_Metrics_Aggregator, "EU-hosted Log & Metrics Aggregator", "Log & Metrics Aggregator")

Rel(Circulation_Service, Kafka_Broker, "Publishes circulation events", "Apache Kafka Protocol")
Rel(Kafka_Broker, Notification_Integration_Worker, "Consumes events for notification processing", "Apache Kafka Protocol")
Rel(Catalog_Search_Service, Kafka_Broker, "Publishes item state change events", "Apache Kafka Topics")
Rel(Circulation_Service, Schema_Registry, "Validates event payloads prior to publishing", "HTTP/REST over TLS")
Rel(Kafka_Broker, Dead_Letter_Queue_Topics, "Routes failed messages after max retry attempts", "Apache Kafka Protocol")
Rel(Kafka_Broker, EU_hosted_Log_Metrics_Aggregator, "Forwards audit logs and metrics", "Syslog/OTLP over TLS")

@enduml