@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(catalog_search_service, "Catalog & Search Service") {
    Component(SearchController, "Search Controller", "Java/Spring Boot", "Exposes endpoints for catalog search and retrieval, guaranteeing sub-800ms responses.")
    Component(SearchEngineClient, "Search Engine Client", "Elasticsearch REST Client", "Communicates with Elasticsearch to perform fuzzy matching, typo tolerance, and faceted search.")
    Component(EventConsumer, "Event Consumer", "Apache Kafka Consumer", "Consumes asynchronous events from the internal event bus for real-time availability projections.")
    Component(ContentProviderIntegrationClient, "Content Provider Integration Client", "HTTPS/REST Client", "Connects to external Digital Content Providers to fetch additional catalog data.")
}

Rel(SearchController, SearchEngineClient, "Queries index", "")
Rel(EventConsumer, SearchEngineClient, "Updates index", "")
Rel(SearchController, ContentProviderIntegrationClient, "Fetches external content", "")

@enduml