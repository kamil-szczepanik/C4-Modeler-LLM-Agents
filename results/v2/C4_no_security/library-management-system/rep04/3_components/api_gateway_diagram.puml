@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

System_Ext(Catalog_Search_Service, "Catalog & Search Service", "Java/Spring Boot + Elasticsearch")
System_Ext(Circulation_Service, "Circulation Service", "Java/Spring Boot + PostgreSQL")
System_Ext(Identity_Provider, "Identity Provider", "OAuth2/OIDC Provider")
System_Ext(EU_hosted_Log_Metrics_Aggregator, "EU-hosted Log & Metrics Aggregator", "Log and metrics collection platform")
System_Ext(Internal_Event_Bus, "Internal Event Bus", "Apache Kafka")

Container_Boundary(API_Gateway, "API Gateway") {
    Component(Routing_Versioning_Filter, "Routing & Versioning Filter", "Spring Cloud Gateway (Java/WebFlux)", "Handles non-blocking reactive routing and versioning for incoming client requests.")
    Component(Tenant_Context_Extractor, "Tenant Context Extractor", "Spring Cloud Gateway (Java/WebFlux)", "Extracts and propagates tenant context to ensure secure multi-tenant operations.")
    Component(Security_Rate_Limiting_Filter, "Security & Rate Limiting Filter", "Spring Cloud Gateway (Java/WebFlux)", "Enforces security policies, rate limiting, and validates OAuth2/OIDC JWT tokens.")
    Component(Resilience_Tracing_Filter, "Resilience & Tracing Filter", "Spring Cloud Gateway (Java/WebFlux with Resilience4j)", "Provides circuit breaking, fault tolerance, and tracing telemetry for requests.")
}

Rel(Routing_Versioning_Filter, Catalog_Search_Service, "Routes search and catalog requests", "internal gRPC")
Rel(Routing_Versioning_Filter, Circulation_Service, "Routes circulation requests", "internal gRPC")
Rel(Security_Rate_Limiting_Filter, Identity_Provider, "Validates OAuth2/OIDC JWT tokens", "HTTPS/REST")
Rel(Resilience_Tracing_Filter, EU_hosted_Log_Metrics_Aggregator, "Forwards access logs and tracing metrics", "OTLP/gRPC")
Rel(Routing_Versioning_Filter, Internal_Event_Bus, "Publishes gateway audit events", "Apache Kafka")

@enduml