@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(API_Gateway, "API Gateway", "External API Gateway")
System_Ext(Async_Message_Broker_Kafka, "Async Message Broker (Kafka)", "External Message Broker")

Container_Boundary(Search_Engine, "Search Engine") {
    Component(Query_Parser_Component, "Query Parser Component", "Lucene Query DSL / Java", "Translates API Gateway requests, handling fuzzy matching.")
    Component(Indexing_Synchronization_Component, "Indexing & Synchronization Component", "Kafka Connect", "Applies bulk upserts with a 1-second refresh interval.")
    Component(Data_Storage_Nodes_Component, "Data Storage Nodes Component", "Elasticsearch Index Shards", "Persists search indices on EU-localized storage with encrypted persistent volumes.")
    Component(Faceted_Aggregation_Engine_Component, "Faceted Aggregation Engine Component", "Elasticsearch Aggregations", "Processes in-memory multi-faceted filters.")
}

Rel(API_Gateway, Query_Parser_Component, "Routes search queries", "gRPC / HTTPS")
Rel(Async_Message_Broker_Kafka, Indexing_Synchronization_Component, "Consumes catalogue mutation events", "Kafka Protocol / TCP")
@enduml