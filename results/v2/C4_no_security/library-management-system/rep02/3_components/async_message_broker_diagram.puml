@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Component(Producers_Consumers, "Producers & Consumers", "Core Domain Services, Notification Dispatcher", "Core Domain Services and Notification Dispatcher interacting with the broker.")

Container_Boundary(Async_Message_Broker, "Async Message Broker") {
    Component(Topic_Manager_Partition_Coordinator, "Topic Manager / Partition Coordinator", "Apache Kafka", "Manages topic creation, partitioning, and leader election.")
    Component(Event_Log_Storage_Engine, "Event Log Storage Engine", "Apache Kafka with LUKS", "Handles append-only disk I/O and zero-copy network transfers with LUKS volume encryption.")
    Component(Consumer_Group_Coordinator, "Consumer Group Coordinator", "Apache Kafka", "Manages offsets and rebalances using cooperative sticky assignors.")
    Component(Schema_Registry, "Schema Registry", "Confluent Schema Registry, Apache Avro", "Enforces Apache Avro schema validation and stores schemas in a compacted Kafka topic.")
}

Rel(Producers_Consumers, Topic_Manager_Partition_Coordinator, "Publishes and consumes validated domain events", "Apache Kafka Protocol")
Rel(Schema_Registry, Event_Log_Storage_Engine, "Stores schemas in a compacted Kafka topic", "Apache Kafka Protocol")
Rel(Topic_Manager_Partition_Coordinator, Consumer_Group_Coordinator, "Coordinates partitions and consumer group offsets", "Apache Kafka Protocol")

@enduml