@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patron Web/Mobile App container

System_Ext(api_gateway, "API Gateway", "Kong / Nginx")
System_Ext(eu_payment_gateway, "EU Payment Gateway", "External payment service")
System_Ext(eu_audit_sink, "EU-Resident Log & Audit Sink", "Telemetry and audit sink")

Container_Boundary(patron_app_boundary, "Patron Web/Mobile App") {
    Component(catalogue_search_ui, "Catalogue Search UI component", "React / React Native", "Provides the interface for searching the library catalogue while ensuring sub-800ms search performance.")
    Component(loan_account_manager, "Loan & Account Manager component", "React / React Native", "Manages patron loan details and account information.")
    Component(payment_fines_module, "Payment & Fines Module component", "React / React Native", "Handles payment and fines processing for library patrons.")
    Component(onboarding_feature_flag_manager, "Onboarding & Feature Flag Manager component", "React / React Native", "Manages patron onboarding and dynamic feature flags.")
}

Rel(catalogue_search_ui, api_gateway, "Routes search requests and data", "HTTPS / REST, WebSockets")
Rel(loan_account_manager, api_gateway, "Routes loan and account requests and data", "HTTPS / REST, WebSockets")
Rel(payment_fines_module, api_gateway, "Routes financial and fine-related requests and data", "HTTPS / REST, WebSockets")
Rel(payment_fines_module, eu_payment_gateway, "Processes financial transactions", "HTTPS")
Rel(onboarding_feature_flag_manager, api_gateway, "Routes onboarding requests and configuration data", "HTTPS / REST, WebSockets")
Rel(catalogue_search_ui, eu_audit_sink, "Sends telemetry and error data", "HTTPS")
Rel(loan_account_manager, eu_audit_sink, "Sends telemetry and error data", "HTTPS")
Rel(payment_fines_module, eu_audit_sink, "Sends telemetry and error data", "HTTPS")
Rel(onboarding_feature_flag_manager, eu_audit_sink, "Sends telemetry and error data", "HTTPS")

@enduml