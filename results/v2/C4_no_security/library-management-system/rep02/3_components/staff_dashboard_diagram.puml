@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Staff Dashboard container

System_Ext(api_gateway, "API Gateway", "HTTPS, REST, mTLS", "External API Gateway handling backend services communication.")

Container_Boundary(staff_dashboard_container, "Staff Dashboard") {
    Component(staff_dashboard_angular_spa, "Staff Dashboard (Angular SPA)", "Angular, TypeScript", "Primary frontend container for library staff operations.")
    Component(circulation_management_module, "Circulation Management Module", "Angular, TypeScript, RxJS", "Handles high-speed check-ins, check-outs, and patron lookups via reactive forms.")
    Component(cataloging_inventory_module, "Cataloging & Inventory Module", "Angular, TypeScript", "Manages physical and digital item inventories with bulk-editing and validation checks (R-01).")
    Component(api_client_service, "API Client Service", "Angular, TypeScript", "Encapsulates HTTP communication, JWT management, error boundaries, and interceptors.")
    Component(security_session_manager, "Security & Session Manager", "Angular, TypeScript", "Enforces auto-lockouts, rapid re-authentication, and encrypted local storage.")
    Component(telemetry_service, "Telemetry Service", "OpenTelemetry Browser SDK", "Captures Real User Monitoring (RUM) metrics using the OpenTelemetry browser SDK.")
}

Rel(circulation_management_module, security_session_manager, "TypeScript / Direct Method Calls")
Rel(cataloging_inventory_module, security_session_manager, "TypeScript / Direct Method Calls")
Rel(circulation_management_module, api_client_service, "TypeScript / Direct Method Calls")
Rel(cataloging_inventory_module, api_client_service, "TypeScript / Direct Method Calls")
Rel(api_client_service, api_gateway, "HTTPS / REST / mTLS")
Rel(api_client_service, telemetry_service, "OpenTelemetry SDK / HTTPS")

@enduml