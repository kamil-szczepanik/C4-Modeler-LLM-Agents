@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(core_domain_services, "Core Domain Services") {
    Component(Catalog Management Component, "Catalog Management Component", "Spring Data JPA", "Manages physical and digital item cataloging.")
    Component(Circulation Engine Component, "Circulation Engine Component", "Spring State Machine", "Handles check-in/out workflows with distributed locking.")
    Component(EU Policy Enforcement Interceptor, "EU Policy Enforcement Interceptor", "Spring AOP", "Validates EU data residency rules.")
    Component(Domain Event Publisher, "Domain Event Publisher", "Spring Kafka", "Emits cryptographically signed events.")
    Component(Search Sync Synchronizer Component, "Search Sync Synchronizer Component", "Spring Kafka Consumer", "Transforms and buffers events for index updates.")
    Component(Data Storage (PostgreSQL), "Data Storage (PostgreSQL)", "PostgreSQL", "Persists transactional data.")
    Component(Async Message Broker (Apache Kafka), "Async Message Broker (Apache Kafka)", "Apache Kafka", "Asynchronous event broker for domain events.")
    Component(Search Engine (Elasticsearch), "Search Engine (Elasticsearch)", "Elasticsearch", "Indexes metadata asynchronously.")
}

Rel(Circulation Engine Component, EU Policy Enforcement Interceptor, "Intercepts commands synchronously", "In-Memory Method Invocation")
Rel(EU Policy Enforcement Interceptor, Data Storage (PostgreSQL), "Persists transactional data", "SQL / JDBC")
Rel(Domain Event Publisher, Async Message Broker (Apache Kafka), "Publishes domain events", "Apache Kafka Protocol")
Rel(Async Message Broker (Apache Kafka), Search Sync Synchronizer Component, "Consumes change events", "Apache Kafka Protocol")
Rel(Search Sync Synchronizer Component, Search Engine (Elasticsearch), "Bulk indexes metadata asynchronously", "REST / HTTP with Bulk API")

@enduml