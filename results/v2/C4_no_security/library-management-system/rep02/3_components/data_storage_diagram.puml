@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Storage container

System_Ext(Core_Domain_Services, "Core Domain Services", "Microservice Logic", "External container that persists relational aggregates and manages connection pooling.")
System_Ext(Staff_Dashboard_Reporting, "Staff Dashboard / Reporting", "Web UI / Reporting Service", "External container that offloads non-critical read queries.")
System_Ext(EU_Resident_Log_Audit_Sink, "EU-Resident Log & Audit Sink", "Audit Storage", "External sink receiving asynchronous Write-Ahead Logs.")

Container_Boundary(Data_Storage, "Data Storage") {
    Component(PostgreSQL_16_Primary, "PostgreSQL 16 Primary", "PostgreSQL 16", "Provides transactional persistence, native JSONB metadata support, and robust transactional integrity.")
    Component(PostgreSQL_16_Read_Replicas, "PostgreSQL 16 Read-Replicas", "PostgreSQL 16", "Offloads non-critical read queries for staff dashboards and reporting.")
    Component(PgBouncer, "PgBouncer", "PgBouncer", "Manages and pools high-concurrency client connections to prevent thread exhaustion.")
    Component(Patroni, "Patroni", "Patroni", "Handles automated high availability failover for the database cluster.")
    Component(Debezium_Kafka_Connect, "Debezium / Kafka Connect", "Debezium / Apache Kafka", "Streams Write-Ahead Logs asynchronously to the audit sink.")
    Component(EU_Resident_Object_Storage, "EU-Resident Object Storage", "Encrypted Object Storage with CMK", "Provides encrypted backups and Point-In-Time Recovery (PITR) complying with EU data residency.")
    Component(Observability_Stack, "Observability Stack", "Prometheus & OpenTelemetry", "Monitors performance and operational metrics.")
}

Rel(Core_Domain_Services, PostgreSQL_16_Primary, "Persists relational aggregates", "SQL / JDBC over TLS 1.3")
Rel(Staff_Dashboard_Reporting, PostgreSQL_16_Read_Replicas, "Offloads non-critical read queries", "SQL / JDBC over TLS 1.3")
Rel(PostgreSQL_16_Primary, EU_Resident_Log_Audit_Sink, "Streams Write-Ahead Logs asynchronously", "Debezium / Apache Kafka")
Rel(Core_Domain_Services, PgBouncer, "Manages high-concurrency client connections", "TCP / TLS 1.3")

@enduml