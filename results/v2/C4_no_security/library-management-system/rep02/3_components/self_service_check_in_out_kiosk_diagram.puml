@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(kiosk, "Self-Service Check-In/Out Kiosk") {
    Component(UI_Presentation_Layer, "UI Presentation Layer", "React", "Provides the touch UI for patron autonomy and interaction during check-in/out.")
    Component(Kiosk_Core_Logic_Controller, "Kiosk Core Logic Controller", "Node.js / Electron Main Process", "Manages core application flow, orchestration, and IPC communication.")
    Component(Local_Sync___Cache_Store, "Local Sync & Cache Store", "SQLite / IndexedDB with SQLCipher", "Provides offline-resilient circulation services and encrypted local storage for EU data residency.")
    Component(Hardware_Abstraction_Layer, "Hardware Abstraction Layer", "Node.js Addons", "Interfaces with peripherals via USB/Serial native bindings.")
    Component(User_Facing_Error_Recovery___Assisted_Fallback_Component, "User-Facing Error Recovery & Assisted Fallback Component", "Electron / React", "Handles user-facing error recovery and provides assisted fallbacks.")
    Component(API_Gateway, "API Gateway", "Kong / Nginx", "Facilitates secure communication and syncs offline transactions via HTTPS / REST over mTLS.")
}

Rel(UI_Presentation_Layer, Kiosk_Core_Logic_Controller, "Communicates via IPC", "")
Rel(Kiosk_Core_Logic_Controller, Hardware_Abstraction_Layer, "Interfaces with peripherals via USB/Serial native bindings", "")
Rel(Kiosk_Core_Logic_Controller, API_Gateway, "Syncs offline transactions via HTTPS / REST over mTLS", "")

@enduml