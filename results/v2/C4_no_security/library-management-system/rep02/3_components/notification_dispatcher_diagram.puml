@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification Dispatcher container

Container_Boundary("Notification Dispatcher", "Notification Dispatcher") {
    Component(Kafka_Event_Consumer_Component, "Kafka Event Consumer Component", "Python / FastAPI", "Consumes asynchronous events from Kafka and handles event processing.")
    Component(Preference_Cache_Component, "Preference Cache Component", "Redis", "Low-latency in-memory cache with persistence for user preferences.")
    Component(Template_Engine_Component, "Template Engine Component", "Jinja2", "Dynamic multi-language template rendering engine.")
    Component(Provider_Adapter_Component, "Provider Adapter Component", "HTTPX / SMTP Client", "Adapters for delivering messages via SMTP/HTTPS to external notification services.")
    Component(Audit_Emitter_Component, "Audit Emitter Component", "Python", "Logs delivery status and forwards events for compliance auditing.")
}

System_Ext(EU_Notification_Service, "EU Notification Service", "External notification service for delivering messages.")
System_Ext(EU_Resident_Log_Audit_Sink, "EU-Resident Log & Audit Sink", "Compliance auditing and log storage.")
System_Ext(Observability_Stack, "Observability Stack", "End-to-end distributed tracing and metrics.")

Rel(Kafka_Event_Consumer_Component, Preference_Cache_Component, "Queries user settings", "Redis Protocol / TLS")
Rel(Preference_Cache_Component, Template_Engine_Component, "Supplies localization context", "In-Process")
Rel(Template_Engine_Component, Provider_Adapter_Component, "Forwards rendered payload", "In-Process")
Rel(Provider_Adapter_Component, EU_Notification_Service, "Delivers message", "SMTP/HTTPS over TLS")
Rel(Provider_Adapter_Component, Audit_Emitter_Component, "Logs delivery status", "In-Process")
Rel(Audit_Emitter_Component, EU_Resident_Log_Audit_Sink, "Forwards delivery events", "HTTPS/TLS")
Rel(Kafka_Event_Consumer_Component, Observability_Stack, "Traces propagation", "OpenTelemetry")

@enduml