@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Observability Stack container

System_Ext(core_domain_services, "Core Domain Services", "Internal system services")
System_Ext(api_gateway, "API Gateway", "Entry point for client requests")
System_Ext(notification_dispatcher, "Notification Dispatcher", "Dispatches notifications")

Container_Boundary(observability_stack, "Observability Stack") {
    Component(otel_collector, "OpenTelemetry Collector", "OpenTelemetry", "Standardized protocol for gathering metrics, logs, and traces.")
    Component(metrics_engine, "Metrics Storage & Query Engine", "Prometheus + Thanos sidecar", "Scalable time-series storage and high availability with long-term object storage.")
    Component(log_forwarder, "Log Aggregator & Forwarder", "Fluentbit / Promtail", "Lightweight log forwarding enforcing EU compliance.")
    Component(dashboard_engine, "Dashboard & Reporting Engine", "Grafana", "Unified visualization for SRE technical dashboards and Administrator SLA reports.")
    Component(synthetic_agent, "Synthetic Monitoring Agent", "Grafana Synthetic Monitoring / Blackbox Exporter", "Active probing to validate P99 search performance.")
    Component(log_sink, "EU-Resident Log & Audit Sink", "Encrypted Log Stream / HTTPS", "EU-resident log and audit sink for compliance.")
    Component(object_storage, "EU-Region Object Storage", "S3 API / TLS", "Long-term object storage complying with EU data residency.")
}

Rel(core_domain_services, otel_collector, "OTLP/gRPC", "OTLP/gRPC")
Rel(api_gateway, otel_collector, "OTLP/gRPC", "OTLP/gRPC")
Rel(notification_dispatcher, otel_collector, "OTLP/gRPC", "OTLP/gRPC")
Rel(otel_collector, metrics_engine, "Prometheus Remote Write", "Prometheus Remote Write")
Rel(metrics_engine, dashboard_engine, "PromQL/HTTP", "PromQL/HTTP")
Rel(log_forwarder, log_sink, "Encrypted Log Stream / HTTPS", "Encrypted Log Stream / HTTPS")
Rel(synthetic_agent, api_gateway, "HTTPS/REST", "HTTPS/REST")
Rel(metrics_engine, object_storage, "S3 API / TLS", "S3 API / TLS")

@enduml