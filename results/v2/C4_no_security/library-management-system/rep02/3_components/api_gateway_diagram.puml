@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Kong_Nginx_Edge_Proxy, "Kong / Nginx Edge Proxy", "Kong / Nginx", "Handles edge routing, reverse proxying, TLS/mTLS termination, and header/path-based API versioning.")
    Component(Kong_OAuth2_Plugin, "Kong OAuth2 Plugin", "Kong OAuth2 Plugin", "Performs token validation and authentication at the edge.")
    Component(Kong_Rate_Limiting_Plugin, "Kong Rate Limiting Plugin", "Kong Rate Limiting Plugin with Redis", "Enforces dynamic request throttling backed by Redis state store.")
    Component(Fluentbit_Sidecar, "Fluentbit Sidecar", "Fluentbit", "Handles standardized telemetry collection, PII log scrubbing, and sidecar buffering for EU-resident audit sinks.")
}

Rel(Kong_Nginx_Edge_Proxy, Kong_OAuth2_Plugin, "Validates incoming requests")
Rel(Kong_Nginx_Edge_Proxy, Kong_Rate_Limiting_Plugin, "Checks rate limits")
Rel(Kong_Nginx_Edge_Proxy, Fluentbit_Sidecar, "Forwards logs and metrics")

@enduml