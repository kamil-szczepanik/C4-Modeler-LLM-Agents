@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Library_Patrons_Library_Staff, "Library Patrons & Library Staff", "Primary users accessing self-service and circulation tools.")
Person(Library_Administrators_Library_Auditors_Compliance_Officers, "Library Administrators & Library Auditors / Compliance Officers", "Stakeholders managing reporting and GDPR/EU audits.")
System(Library_Management_System, "Library Management System", "A cloud-native SaaS platform designed for public and academic libraries to catalogue physical and digital items, manage circulation, provide self-service portals, and guarantee EU-only data residency with high-performance search.")
System_Ext(Digital_Content_Vendor_APIs, "Digital Content Vendor APIs", "External system for e-books and digital items.")
System_Ext(EU_Payment_Gateway, "EU Payment Gateway", "External system for processing fines and fees.")
System_Ext(EU_Notification_Service, "EU Notification Service", "External system for due date reminders via SMTP/Push.")
System_Ext(EU_Regulatory_Compliance_Audit_Portal, "EU Regulatory Compliance & Audit Portal", "External secure interface for auditors.")
System_Ext(EU_Resident_Log_Audit_Sink, "EU-Resident Log & Audit Sink", "External dependency for telemetry and compliance trails.")

Rel(Library_Patrons_Library_Staff, Library_Management_System, "Interact with the system via self-service and circulation tools", "HTTPS (Web/Mobile Clients)")
Rel(Library_Management_System, Digital_Content_Vendor_APIs, "Connects outbound for e-books and digital items with local metadata caching", "HTTPS/REST")
Rel(Library_Management_System, EU_Payment_Gateway, "Integrates for processing fines and fees over restricted EU channels", "TLS")
Rel(Library_Management_System, EU_Notification_Service, "Integrates for sending due date reminders over restricted EU channels", "SMTP/Push over TLS")
Rel(Library_Administrators_Library_Auditors_Compliance_Officers, EU_Regulatory_Compliance_Audit_Portal, "Access compliance and audit interfaces", "HTTPS")
Rel(Library_Management_System, EU_Resident_Log_Audit_Sink, "Routes system telemetry and logs for compliance trails", "Encrypted Log Stream")

@enduml