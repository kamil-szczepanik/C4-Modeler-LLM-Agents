@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Person(web_app, "Web Application (SPA)", "Patron and staff frontend application.")
System_Ext(catalogue_search, "Catalogue & Search Container", "Backend service for searching and browsing library assets.")
System_Ext(circulation_core, "Circulation & Core Container", "Backend service managing patron accounts, loans, and inventory.")
System_Ext(audit_log_sink, "Audit Log Sink", "External storage/system for compliance and audit logs.")

Container_Boundary(api_gateway_boundary, "API Gateway") {
    Component(kong_api_gateway, "Kong API Gateway", "Kong Edge Container Platform", "Core edge container handling ingress traffic, centralizing routing, authentication, and compliance.")
    Component(tls_geo_filter, "TLS Termination & Geo-Filter Plugin", "Kong Geo-Filter Plugin", "Inspects client IP geolocation at the edge to ensure EU data residency.")
    Component(jwt_auth, "JWT Authentication Plugin", "Kong OIDC/JWT Plugin", "Validates Identity Provider (IdP) tokens for public and academic library patrons.")
    Component(rate_limiting, "Rate Limiting & Analytics Plugin", "Kong Rate Limiting Plugin", "Enforces quotas and tiered API consumption.")
    Component(upstream_balancer, "Upstream Load Balancer & Router", "Kong Router / Upstream Load Balancer", "Directs traffic to backend services with high availability.")
    Component(opentelemetry, "OpenTelemetry Plugin", "OpenTelemetry Plugin (W3C Trace Context)", "Injects distributed tracing headers to maintain low-latency performance.")
    Component(audit_logging, "Audit Logging Plugin", "Kong Audit Logging Plugin", "Captures compliance and administrative logs.")
    Component(vault_secrets, "HashiCorp Vault / Kubernetes Secrets", "HashiCorp Vault / Kubernetes", "Manages dynamic credentials securely.")
}

Rel(web_app, kong_api_gateway, "Communicates via REST/GraphQL", "HTTPS")
Rel(kong_api_gateway, catalogue_search, "Routes internal traffic", "gRPC over HTTP/2")
Rel(kong_api_gateway, circulation_core, "Routes internal traffic", "gRPC")
Rel(kong_api_gateway, audit_log_sink, "Streams compliance logs asynchronously", "HTTPS")

@enduml