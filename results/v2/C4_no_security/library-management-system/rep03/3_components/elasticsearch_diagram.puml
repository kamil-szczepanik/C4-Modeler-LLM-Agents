@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Elasticsearch container

Container_Boundary(elasticsearch_container, "Elasticsearch") {
    Component(rest_api, "REST API / Transport Layer", "Java/Netty", "Powers the REST API and transport layer for high-throughput request handling, handling JSON search queries and bulk indexing payloads.")
    Component(query_engine, "Query & Search Engine", "Lucene Core", "Executes aggregations, relevancy scoring, and faceted search for catalogue items.")
    Component(index_manager, "Index & Shard Manager", "Elasticsearch", "Resolves targeted shards and routes document indexing requests.")
    Component(data_storage, "Data Storage & Translog Engine", "NVMe Storage & S3-compatible Object Storage", "Writes segments and translogs to local NVMe storage and encrypted EU-region backups.")
    Component(cluster_module, "Cluster Coordination & Discovery Module", "Elasticsearch", "Synchronizes cluster topology and shard allocation.")
}

Rel(rest_api, query_engine, "Passes parsed queries for execution")
Rel(query_engine, index_manager, "Resolves targeted shards")
Rel(rest_api, index_manager, "Routes document indexing requests to appropriate shards")
Rel(index_manager, data_storage, "Writes segments and translogs to local NVMe storage")
Rel(index_manager, cluster_module, "Synchronizes cluster topology and shard allocation")
Rel(cluster_module, index_manager, "Synchronizes cluster topology and shard allocation")

@enduml