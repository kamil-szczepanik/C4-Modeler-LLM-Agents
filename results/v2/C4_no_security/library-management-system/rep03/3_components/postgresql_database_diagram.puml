@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL Database container

Container_Boundary(postgresql_database, "PostgreSQL Database") {
    Component(Relational_Schema_Core_Tables, "Relational Schema / Core Tables", "PostgreSQL", "ACID-compliant normalization for Patrons, Items, and Loans.")
    Component(PgBouncer, "PgBouncer", "PgBouncer", "Connection pooler managing concurrent connections and preventing thread exhaustion.")
    Component(WAL_Write_Ahead_Log_Archiver, "WAL (Write-Ahead Log) Archiver", "PostgreSQL WAL", "Synchronous replication engine streaming replication logs.")
    Component(Patroni_with_etcd, "Patroni with etcd", "Patroni & etcd", "Automated high-availability, consensus store, and cluster state orchestration.")
    Component(pgaudit, "pgaudit", "PostgreSQL Extension", "Extension for GDPR-compliant and tamper-evident audit logging.")
    Component(Fluentbit, "Fluentbit", "Fluentbit", "Sidecar for log and audit forwarding to centralized SIEM.")
}

Rel(PgBouncer, Relational_Schema_Core_Tables, "Routes queries", "TCP")
Rel(Relational_Schema_Core_Tables, WAL_Write_Ahead_Log_Archiver, "Streams replication logs", "TCP")
Rel(Patroni_with_etcd, Relational_Schema_Core_Tables, "Orchestrates cluster state & failover", "TCP")

@enduml