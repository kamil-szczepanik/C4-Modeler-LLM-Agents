@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification & Payment Workers container

Container_Boundary(notification_and_payment_workers, "Notification & Payment Workers") {
    Component(Payment_Task_Handler, "Payment Task Handler", "Python/Celery + SQLAlchemy", "Handles payment processing and emits internal failure events.")
    Component(Notification_Dispatcher, "Notification Dispatcher", "Python/Celery", "Dispatches notifications and receives internal failure events.")
    Component(Queue_Consumer___Router, "Queue Consumer & Router", "Celery/RabbitMQ", "Consumes messages with DLQ routing.")
    Component(Audit___Ledger_Component, "Audit & Ledger Component", "Python/SQLAlchemy", "Persists state and immutable logs to the database.")
}

System_Ext(RabbitMQ_Message_Broker, "RabbitMQ Message Broker", "RabbitMQ Message Broker")
System_Ext(PostgreSQL_Database, "PostgreSQL Database", "PostgreSQL Database")

Rel(Queue_Consumer___Router, RabbitMQ_Message_Broker, "Consumes messages with DLQ routing", "AMQP")
Rel(Payment_Task_Handler, Notification_Dispatcher, "Internal failure event emission", "AMQP")
Rel(Payment_Task_Handler, PostgreSQL_Database, "Persists state and immutable logs", "SQL")
Rel(Audit___Ledger_Component, PostgreSQL_Database, "Persists state and immutable logs", "SQL")

@enduml