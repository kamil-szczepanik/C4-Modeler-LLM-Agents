@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Circulation & Core Container container

System_Ext(api_gateway, "API Gateway", "Nginx/Kong", "Routes internal traffic via gRPC.")
System_Ext(postgresql_database, "PostgreSQL Database", "PostgreSQL", "Relational database enforcing EU-only data residency and immutable audit logging.")
System_Ext(rabbitmq_message_broker, "RabbitMQ Message Broker", "RabbitMQ", "Message broker utilizing transactional outbox pattern for asynchronous event publishing.")

Container_Boundary(circulation_core_container, "Circulation & Core Container") {
    Component(loan_management_component, "Loan Management Component", "Node.js/Express, TypeScript", "Enforces circulation business rules and handles high-throughput circulation checkouts.")
    Component(fine_fee_component, "Fine & Fee Component", "Node.js/Express, TypeScript", "Handles automated fine calculations and fee management.")
    Component(policy_validation_engine, "Policy Validation Engine", "Node.js/Express, TypeScript", "Performs policy validations for circulation rules.")
    Component(core_data_access_layer, "Core Data Access Layer", "TypeORM, PgBouncer, PostgreSQL", "Interfaces with the PostgreSQL Database for secure data persistence, transactional data, and audit logs.")
    Component(audit_compliance_module, "Audit & Compliance Module", "Node.js/Express, PostgreSQL", "Ensures EU-only data residency and immutable audit logging.")
}

Rel(api_gateway, circulation_core_container, "Routes internal traffic", "gRPC")
Rel(circulation_core_container, rabbitmq_message_broker, "Publishes domain events", "AMQP")
Rel(circulation_core_container, postgresql_database, "Persists transactional data and audit logs", "TCP")
Rel(core_data_access_layer, postgresql_database, "Interfaces via TypeORM with PgBouncer connection pooling")

@enduml