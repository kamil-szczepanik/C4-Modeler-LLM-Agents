@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Catalogue & Search Container", "Catalogue & Search Container") {
    Component(Search Controller, "Search Controller", "Java/Spring Boot", "Handles incoming HTTP/gRPC search requests and routes them to the search service.")
    Component(Search Service, "Search Service", "Java/Spring Boot", "Implements business logic for cataloguing, searching, and telemetry event publishing.")
    Component(Index Repository, "Index Repository", "Java/Spring Boot", "Interacts with Elasticsearch to query the search index and execute upserts.")
    Component(Cataloguing Event Consumer, "Cataloguing Event Consumer", "Java/Spring Boot", "Consumes item mutation events from RabbitMQ to update the search index.")
}

Rel(Search Controller, Search Service, "Delegates search requests", "Method Call")
Rel(Search Service, Index Repository, "Executes queries and upserts", "Java Method")
Rel(Cataloguing Event Consumer, Index Repository, "Triggers index updates upon receiving mutation events", "Java Method")

@enduml