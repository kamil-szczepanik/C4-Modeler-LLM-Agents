@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application (SPA) container

Container_Boundary(web_app_spa, "Web Application (SPA)") {
    Component(RoutingShellComponent, "Routing & Shell Component", "React Router, TypeScript", "Manages client-side routing, role-based access, and offline-recovery states.")
    Component(CatalogSearchComponent, "Catalog & Search Component", "React, TypeScript", "Implements item search interfaces for physical and digital assets.")
    Component(CirculationSelfServiceComponent, "Circulation & Self-Service Component", "React, TypeScript", "Handles patron checkouts and renewals.")
    Component(APIClientLayer, "API Client Layer", "Axios/GraphQL, Sentry", "Provides secure, typed communication with JWT interceptors and Sentry error tracking.")
    Component(TelemetryMonitoringComponent, "Telemetry & Monitoring Component", "JavaScript, Sentry", "Captures metrics and reports exceptions/performance timings for EU-hosted analytics endpoints.")
}

System_Ext(EU_hosted_Analytics_Endpoint, "EU-hosted Analytics Endpoint", "Transmits payloads strictly within the EU [HTTPS]")

Rel(RoutingShellComponent, CatalogSearchComponent, "Renders views based on authenticated roles", "In-memory")
Rel(RoutingShellComponent, CirculationSelfServiceComponent, "Renders views based on authenticated roles", "In-memory")
Rel(CatalogSearchComponent, APIClientLayer, "Sends API requests", "In-memory")
Rel(CirculationSelfServiceComponent, APIClientLayer, "Sends API requests", "In-memory")
Rel(APIClientLayer, TelemetryMonitoringComponent, "Reports exceptions and performance timings", "In-memory asynchronous calls")
Rel(TelemetryMonitoringComponent, EU_hosted_Analytics_Endpoint, "Transmits payloads strictly within the EU", "HTTPS")

@enduml