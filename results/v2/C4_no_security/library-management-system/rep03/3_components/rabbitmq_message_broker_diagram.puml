@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the RabbitMQ Message Broker container

Container_Boundary("RabbitMQ Message Broker", "RabbitMQ Message Broker") {
    Component(Notification_Exchange, "Notification Exchange", "RabbitMQ Exchange", "Routes published async events to the notification queue.")
    Component(DLX_Exchange, "DLX Exchange", "RabbitMQ Dead Letter Exchange", "Handles routing of dead-lettered messages for later inspection and replay.")
    Component(Notification_Queue, "Notification Queue", "RabbitMQ Quorum Queue", "Stores critical notifications reliably for consumption by workers.")
    Component(Dead_Letter_Queue, "Dead Letter Queue", "RabbitMQ Quorum Queue", "Holds failed or unprocessable messages for administrative review.")
}

Rel(Notification_Exchange, Notification_Queue, "Routes messages", "AMQP")
Rel(Dead_Letter_Queue, Notification_Exchange, "Republishes messages for retry", "AMQP")

@enduml