@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Library Management System

Person(LibraryPatronsMembers, "Library Patrons (Members)", "Users accessing self-service search and loan management.")
Person(Librarians, "Librarians", "Staff managing cataloguing and circulation.")
Person(LibraryAdministrators, "Library Administrators", "Oversight users tracking reporting and usage.")

System(LibraryManagementSystem, "Library Management System", "A cloud-native Library Management System that provides cataloguing, circulation, and self-service portals for public and academic libraries while enforcing strict EU data residency.")

System_Ext(PaymentGateway, "Payment Gateway", "External system processing fines via Stripe/Adyen.")
System_Ext(NotificationService, "Notification Service", "External provider for reminders via SMTP/APNs/FCM.")
System_Ext(DigitalContentProviders, "Digital Content Providers", "External sources for streaming via OverDrive/Adobe DRM.")
System_Ext(IdentityProviderIdP, "Identity Provider (IdP)", "External system handling OIDC/OAuth 2.0 authentication.")

Rel(LibraryPatronsMembers, LibraryManagementSystem, "Accesses self-service search and loan management", "HTTPS (TLS 1.3)")
Rel(Librarians, LibraryManagementSystem, "Manages cataloguing and circulation", "HTTPS (TLS 1.3)")
Rel(LibraryAdministrators, LibraryManagementSystem, "Tracks reporting and usage", "HTTPS (TLS 1.3)")
Rel(LibraryManagementSystem, PaymentGateway, "Processes fines", "REST/JSON over HTTPS")
Rel(LibraryManagementSystem, NotificationService, "Sends reminders", "SMTP/APNs/FCM over EU-hosted infrastructure")
Rel(LibraryManagementSystem, DigitalContentProviders, "Streams digital content", "LTI and REST over HTTPS")
Rel(LibraryManagementSystem, IdentityProviderIdP, "Authenticates users", "OpenID Connect (OIDC) / OAuth 2.0 over HTTPS")

@enduml