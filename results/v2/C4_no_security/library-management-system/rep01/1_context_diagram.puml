@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(LibraryPatrons, "Library Patrons", "Students and public citizens who access self-service portals.")
Person(LibrariansLibraryStaff, "Librarians / Library Staff", "Library staff who perform cataloging and management workflows.")
Person(LibraryAdministrators, "Library Administrators", "Administrators who manage system configurations and oversight.")

System(LibraryManagementSystem, "Library Management System", "Provides cataloging, circulation management, and self-service portals for public and academic libraries within an EU data residency boundary, ensuring high-performance patron search capabilities and robust administrative workflows.")

System_Ext(ThirdPartyVendorsInterlibraryLoanILLPartners, "Third-Party Vendors / Interlibrary Loan (ILL) Partners", "External partners and systems for interlibrary loans.")
System_Ext(EUIdentityProvider, "EU Identity Provider", "Keycloak or EU Auth0 for identity and authentication, ensuring data remains within EU boundaries.")
System_Ext(DigitalContentDeliveryNetworkS3compatibleEUObjectStorage, "Digital Content Delivery Network / S3-compatible EU Object Storage", "Fulfills digital item cataloging and streaming requirements.")
System_Ext(SEPAStripeEUAPIPaymentGateway, "SEPA / Stripe EU API Payment Gateway", "Handles regulated fines and fee processing.")
System_Ext(ExternalNotificationService, "External Notification Service", "EU Mailgun or Twilio for sending notifications.")
System_Ext(CentralizedSIEMMonitoringPlatform, "Centralized SIEM / Monitoring Platform", "Datadog EU or Grafana Cloud Frankfurt providing centralized audit logging and telemetry within the EU.")

Rel(LibraryPatrons, LibraryManagementSystem, "Accesses self-service portals", "HTTPS/TLS 1.3")
Rel(LibrariansLibraryStaff, LibraryManagementSystem, "Performs cataloging and management tasks", "HTTPS/TLS 1.3")
Rel(LibraryAdministrators, LibraryManagementSystem, "Performs administrative workflows", "HTTPS/TLS 1.3")
Rel(LibraryManagementSystem, EUIdentityProvider, "Authenticates users and manages identity data", "OpenID Connect / OAuth 2.0")
Rel(LibraryManagementSystem, DigitalContentDeliveryNetworkS3compatibleEUObjectStorage, "Stores and retrieves digital items and streaming assets", "HTTPS")
Rel(LibraryManagementSystem, SEPAStripeEUAPIPaymentGateway, "Processes regulated fines and fees", "REST API over HTTPS")
Rel(LibraryManagementSystem, ThirdPartyVendorsInterlibraryLoanILLPartners, "Handles interlibrary loan operations", "ISO ILL protocol or REST/JSON over HTTPS with mTLS")
Rel(LibraryManagementSystem, ExternalNotificationService, "Sends notifications to patrons and staff", "HTTPS/TLS 1.3")
Rel(LibraryManagementSystem, CentralizedSIEMMonitoringPlatform, "Sends audit logs and telemetry data", "HTTPS/TLS 1.3")

@enduml