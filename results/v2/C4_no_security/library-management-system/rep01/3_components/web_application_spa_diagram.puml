@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application (SPA) container

Container_Boundary(web_app_spa, "Web Application (SPA)") {
    Component(Routing_Layout_Manager, "Routing & Layout Manager", "React Router", "Handles client-side routing and layout management for the single-page application.")
    Component(State_Management_Store, "State Management Store", "Zustand or Redux Toolkit", "Manages application state across various features and views.")
    Component(API_Client_Layer, "API Client Layer", "Axios", "Configured HTTP client for communicating with backend services.")
    Component(Catalog_Discovery_Component, "Catalog Discovery Component", "React / TypeScript", "Provides interface components for searching and discovering library catalog items.")
    Component(Circulation_Desk_Component, "Circulation Desk Component", "React / TypeScript", "Handles circulation workflows and interacts with local persistence for offline resilience.")
    Component(Admin_Dashboard_Component, "Admin Dashboard Component", "React / TypeScript", "Provides administrative portals and management tools.")
    Component(Local_Persistence_Layer, "Local Persistence Layer", "IndexedDB / Dexie.js / Web Crypto API", "Enables robust local persistence and offline circulation resilience with client-side encryption-at-rest.")
}

Rel(Circulation_Desk_Component, Local_Persistence_Layer, "Reads/writes cached transaction queues", "IndexedDB")

@enduml