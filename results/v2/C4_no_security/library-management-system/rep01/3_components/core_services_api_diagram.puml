@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Services API container

Container_Boundary(core_services_api, "Core Services API") {
    Component(CatalogModule, "Catalog Module", "Node.js / NestJS Module", "Manages physical and digital cataloging of library items.")
    Component(CirculationModule, "Circulation Module", "Node.js / NestJS Module", "Handles circulation management including checkouts, returns, and renewals.")
    Component(FinesAndFeesModule, "Fines & Fees Module", "Node.js / NestJS Module", "Tracks and processes fines and fees for library patrons.")
    Component(SearchOrchestratorModule, "Search Orchestrator Module", "Node.js / NestJS Module", "Orchestrates low-latency search queries against the search engine.")
    Component(DataGovernanceInterceptor, "Data Governance Interceptor", "Node.js / NestJS Interceptor", "Enforces strict EU data residency and handles audit logging.")
}

Rel(CatalogModule, CirculationModule, "Validates item availability")
Rel(CirculationModule, FinesAndFeesModule, "Triggers fine assessments for overdue items")
Rel(SearchOrchestratorModule, CatalogModule, "Retrieves catalog metadata for indexing")
Rel(DataGovernanceInterceptor, CatalogModule, "Intercepts and validates data access compliance")
Rel(DataGovernanceInterceptor, CirculationModule, "Intercepts and validates data access compliance")

@enduml