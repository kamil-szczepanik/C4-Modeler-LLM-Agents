@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Core Services API, "Core Services API", "External API calling the database.")
System_Ext(Centralized SIEM Platform, "Centralized SIEM Platform", "External SIEM platform collecting logs.")

Container_Boundary(Database, "Database") {
    Component(PgBouncer, "PgBouncer", "PgBouncer", "Sidecar connection pooler managing high concurrent connection spikes.")
    Component(PostgreSQL 16, "PostgreSQL 16", "PostgreSQL 16, pg_partman, pgaudit", "Relational database storing transactional library data, handling time-series data partitioning via pg_partman, and streaming security logs via pgaudit.")
    Component(secure_pii Schema, "secure_pii Schema", "PostgreSQL Schema", "Isolated database schema containing patron personal profiles.")
    Component(postgres_exporter, "postgres_exporter", "Prometheus Exporter Sidecar", "Sidecar exporting Prometheus metrics for query latency tracking.")
}

Rel(Core Services API, PgBouncer, "TCP/IP via PostgreSQL Wire Protocol with TLS 1.3", "TCP/IP")
Rel(PgBouncer, PostgreSQL 16, "Internal connection pooling via TCP/IP", "TCP/IP")
Rel(PostgreSQL 16, Centralized SIEM Platform, "Log streaming via pgaudit", "Log streaming")
@enduml