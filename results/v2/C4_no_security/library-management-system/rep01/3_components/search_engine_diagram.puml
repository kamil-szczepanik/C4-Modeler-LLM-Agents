@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Search Engine container

Container_Boundary(search_engine, "Search Engine") {
    Component(Query Parser & Router Component, "Query Parser & Router Component", "OpenSearch / Elasticsearch Internal Engine", "Submits search DSL/queries and parses incoming search requests.")
    Component(Index & Ranking Component, "Index & Ranking Component", "OpenSearch / Elasticsearch Internal Engine", "Delivers high-performance faceted search and relevance tuning.")
    Component(Ingestion & Synchronization Component, "Ingestion & Synchronization Component", "OpenSearch / Elasticsearch Internal Engine", "Handles catalogue updates delivered asynchronously.")
    Component(Suggest & Spellcheck Component, "Suggest & Spellcheck Component", "OpenSearch / Elasticsearch Built-in Suggester API", "Provides auto-suggest and spellchecking capabilities.")
    Component(Search Analytics Collector Component, "Search Analytics Collector Component", "OpenSearch / Elasticsearch Internal Engine", "Dispatches and collects search query logs and telemetry.")
}

System_Ext(Core Services API, "Core Services API", "Core Services API (Node.js / NestJS)")
System_Ext(Async Message Broker, "Async Message Broker", "RabbitMQ / Apache Kafka")

Rel(Core Services API, Query Parser & Router Component, "Submits search DSL/queries", "HTTP/REST over TCP")
Rel(Async Message Broker, Ingestion & Synchronization Component, "Delivers catalogue updates", "AMQP / Kafka Protocol")
Rel(Query Parser & Router Component, Index & Ranking Component, "Routes parsed queries for execution", "In-Memory")
Rel(Query Parser & Router Component, Search Analytics Collector Component, "Dispatches search query logs", "In-Memory Queue")
Rel(Ingestion & Synchronization Component, Index & Ranking Component, "Updates index data", "Internal Protocol")
Rel(Search Analytics Collector Component, Async Message Broker, "Emits search telemetry", "AMQP / Kafka Protocol")
@enduml