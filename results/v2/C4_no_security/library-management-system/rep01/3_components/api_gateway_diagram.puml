@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Person(Web_Application_SPA, "Web Application (SPA)", "Sends API requests with JWT [HTTPS]")

System_Ext(Redis_Cache, "Redis Cache", "In-memory rate limiting", "Queries rate limit counters [TCP/RESP]")
System_Ext(EU_Identity_Provider, "EU Identity Provider", "Identity and Access Management", "Validates incoming JWT [Internal]")
System_Ext(Core_Services_API, "Core Services API", "Node.js / NestJS", "Forwards routed requests with W3C Trace Context [REST/gRPC]")
System_Ext(Centralized_SIEM_Monitoring_Platform, "Centralized SIEM / Monitoring Platform", "Monitoring and Security", "Exports Prometheus metrics and access logs [HTTPS/Prometheus scrape]")

Container_Boundary(api_gateway, "API Gateway") {
    Component(Routing__Tenant_Resolver, "Routing & Tenant Resolver", "Nginx / Envoy", "Perimeter routing, tenant resolution, and TLS 1.3 termination for EU data residency.")
    Component(Rate_Limiter_Filter, "Rate Limiter Filter", "Nginx / Envoy & Redis", "Performs sliding-window rate limiting using in-memory Redis cache.")
    Component(Authentication_OAuth2_Proxy, "Authentication/OAuth2 Proxy", "Nginx / Envoy & EU Identity Provider", "Handles authentication, OAuth2 proxying, and JWT validation.")
    Component(Versioning__Transformation_Filter, "Versioning & Transformation Filter", "Nginx / Envoy", "Manages API versioning, payload transformation, and WAF protection.")
}

Rel(Web_Application_SPA, Routing__Tenant_Resolver, "Sends API requests with JWT", "HTTPS")
Rel(Routing__Tenant_Resolver, Rate_Limiter_Filter, "Evaluates request limits", "Internal")
Rel(Routing__Tenant_Resolver, Authentication_OAuth2_Proxy, "Validates incoming JWT", "Internal")
Rel(Authentication_OAuth2_Proxy, Versioning__Transformation_Filter, "Passes authenticated requests", "Internal")
Rel(Rate_Limiter_Filter, Redis_Cache, "Queries rate limit counters", "TCP/RESP")
Rel(Versioning__Transformation_Filter, Core_Services_API, "Forwards routed requests with W3C Trace Context", "REST/gRPC")
Rel(Routing__Tenant_Resolver, Centralized_SIEM_Monitoring_Platform, "Exports Prometheus metrics and access logs", "HTTPS/Prometheus scrape")

@enduml