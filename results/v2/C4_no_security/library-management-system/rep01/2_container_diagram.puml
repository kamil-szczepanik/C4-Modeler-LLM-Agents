@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(LibraryPatrons, "Library Patrons", "Students and public citizens who access self-service portals.")
Person(LibrariansLibraryStaff, "Librarians / Library Staff", "Library staff who perform cataloging and management workflows.")
Person(LibraryAdministrators, "Library Administrators", "Administrators who manage system configurations and oversight.")

System_Ext(EUIdentityProvider, "EU Identity Provider", "Keycloak or EU Auth0 for identity and authentication, ensuring data remains within EU boundaries.")
System_Ext(DigitalContentDeliveryNetworkS3compatibleEUObjectStorage, "Digital Content Delivery Network / S3-compatible EU Object Storage", "Fulfills digital item cataloging and streaming requirements.")
System_Ext(SEPAStripeEUAPIPaymentGateway, "SEPA / Stripe EU API Payment Gateway", "Handles regulated fines and fee processing.")
System_Ext(ExternalNotificationService, "External Notification Service", "EU Mailgun or Twilio for sending notifications.")
System_Ext(CentralizedSIEMMonitoringPlatform, "Centralized SIEM / Monitoring Platform", "Datadog EU or Grafana Cloud Frankfurt providing centralized audit logging and telemetry within the EU.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(WebApplicationSPA, "Web Application (SPA)", "React / TypeScript", "Provides cataloging, circulation management, and self-service portals for public and academic libraries.")
    Container(APIGateway, "API Gateway", "Nginx / Envoy", "Routes and manages incoming traffic to the core services.")
    Container(CoreServicesAPI, "Core Services API", "Node.js / NestJS (Modular Monolith)", "Contains the core business logic and modular monolith services.")
    Container(SearchEngine, "Search Engine", "Elasticsearch / OpenSearch", "Provides high-performance search capabilities and isolated search indexing.")
    ContainerDb(Database, "Database", "PostgreSQL", "Stores transactional library data with strict EU data residency.")
    Container(AsyncMessageBroker, "Async Message Broker", "RabbitMQ / Apache Kafka", "Handles asynchronous messaging and event-driven communication.")
}

Rel(LibraryPatrons, WebApplicationSPA, "Accesses self-service portals", "HTTPS")
Rel(LibrariansLibraryStaff, WebApplicationSPA, "Performs cataloging and management workflows", "HTTPS")
Rel(LibraryAdministrators, WebApplicationSPA, "Performs administrative workflows", "HTTPS")
Rel(WebApplicationSPA, APIGateway, "Sends API requests", "HTTPS")
Rel(APIGateway, CoreServicesAPI, "Forwards routed requests", "REST/gRPC")
Rel(CoreServicesAPI, Database, "Reads and writes transactional data", "TCP")
Rel(CoreServicesAPI, SearchEngine, "Queries and indexes search data", "TCP")
Rel(CoreServicesAPI, AsyncMessageBroker, "Publishes and consumes async messages", "AMQP")
Rel(CoreServicesAPI, EUIdentityProvider, "Authenticates users and manages identity data", "OpenID Connect / OAuth 2.0")
Rel(CoreServicesAPI, DigitalContentDeliveryNetworkS3compatibleEUObjectStorage, "Stores and retrieves digital items and streaming assets", "HTTPS")
Rel(CoreServicesAPI, SEPAStripeEUAPIPaymentGateway, "Processes regulated fines and fees", "REST API over HTTPS")
Rel(CoreServicesAPI, ExternalNotificationService, "Sends notifications to patrons and staff", "HTTPS/TLS 1.3")
Rel(CoreServicesAPI, CentralizedSIEMMonitoringPlatform, "Sends audit logs and telemetry data", "HTTPS/TLS 1.3")

@enduml