@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification Worker container

Container_Boundary(notification_worker, "Notification Worker") {
    Component(Event_Consumer_Component, "Event Consumer Component", "amqplib (Node.js)", "Consumes messages securely using amqplib.")
    Component(Retry___Circuit_Breaker_Component, "Retry & Circuit Breaker Component", "Opossum (Node.js)", "Manages transient failures using Opossum logic with exponential backoff.")
    Component(DLQ_Producer___Native_Exchanges, "DLQ Producer & Native Exchanges", "Node.js", "Handles permanently failed messages for administrative visibility.")
    Component(Notification_History_Store_Component, "Notification History Store Component", "PostgreSQL (EU-Hosted Managed)", "EU-hosted managed PostgreSQL instance for audit trails and delivery states.")
    Component(Preference_Cache_Component, "Preference Cache Component", "Redis (Replicated Cluster)", "Replicated Redis cluster caching patron communication preferences.")
    Component(Telemetry_Logger_Component, "Telemetry Logger Component", "OpenTelemetry SDK (Node.js)", "Ships structured logs via OpenTelemetry SDK.")
}

System_Ext(RabbitMQ, "RabbitMQ", "Message Broker")
System_Ext(Notification_Service, "Notification Service", "External notification provider")
System_Ext(RabbitMQ_DLQ, "RabbitMQ DLQ", "Dead Letter Queue")
System_Ext(Centralized_Observability_Platform, "Centralized Observability Platform", "Observability system")

Rel(Event_Consumer_Component, RabbitMQ, "Consumes async events", "AMQP over TLS")
Rel(Retry___Circuit_Breaker_Component, Notification_Service, "Calls external provider for delivery", "HTTPS")
Rel(DLQ_Producer___Native_Exchanges, RabbitMQ_DLQ, "Routes failed messages for administrative monitoring", "AMQP")
Rel(Telemetry_Logger_Component, Centralized_Observability_Platform, "Ships metrics and logs", "gRPC")
Rel(notification_worker, Notification_History_Store_Component, "Persists audit logs and history", "TCP/TLS")
Rel(notification_worker, Preference_Cache_Component, "Queries communication preferences", "Redis Protocol/TLS")

@enduml