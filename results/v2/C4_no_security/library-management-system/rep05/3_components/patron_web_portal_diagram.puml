@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patron Web Portal container

Container_Boundary(patron_web_portal, "Patron Web Portal") {
    Component(routing_shell_layout_component, "Routing & Shell Layout Component", "React Router", "Handles client-side routing and page layout framing for the portal.")
    Component(catalog_search_discovery_component, "Catalog Search & Discovery Component", "React", "Provides the self-service interface for searching and discovering catalog items.")
    Component(patron_account_dashboard_component, "Patron Account Dashboard Component", "React", "Manages patron account details, loans, and self-service actions.")
    Component(auth_session_management_component, "Auth & Session Management Component", "React, OAuth2/OIDC SDK, Consent Management Sub-component", "Handles authentication, session management, and user consent compliance.")
    Component(notification_center_component, "Notification Center Component", "React", "Displays real-time notifications to the library patron.")
    Component(api_client_service_component, "API Client Service Component", "TypeScript, Axios", "Manages HTTP communication and distributed tracing headers for backend API calls.")
}

Rel(routing_shell_layout_component, catalog_search_discovery_component, "Renders within layout")
Rel(routing_shell_layout_component, patron_account_dashboard_component, "Renders within layout")
Rel(routing_shell_layout_component, notification_center_component, "Renders within layout")
Rel(catalog_search_discovery_component, api_client_service_component, "Uses for API requests")
Rel(patron_account_dashboard_component, api_client_service_component, "Uses for API requests")
Rel(auth_session_management_component, api_client_service_component, "Uses for authenticated API requests")

@enduml