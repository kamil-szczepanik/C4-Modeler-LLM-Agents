@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog & Search Service container

System_Ext(Core_API_Gateway, "Core API Gateway", "External system routing requests.")
System_Ext(Elasticsearch_Cluster, "Elasticsearch Cluster", "Kubernetes StatefulSets with persistent volumes", "Stateful search backend deployed via Kubernetes StatefulSets.")
System_Ext(RabbitMQ, "RabbitMQ", "Message broker", "Managing event synchronization and Dead Letter Queues (DLQ).")
System_Ext(Centralized_Observability_Platform, "Centralized Observability Platform", "External observability system.")

Container_Boundary(Catalog___Search_Service, "Catalog & Search Service") {
    Component(Search_API_Controller, "Search API Controller", "Spring MVC controller", "Handling gRPC requests from the Core API Gateway.")
    Component(Search_Query_Engine, "Search Query Engine", "Spring Data Elasticsearch component", "Executing faceted search and auto-suggestion queries with typo tolerance.")
    Component(Catalog_Indexer, "Catalog Indexer", "Spring Integration and RabbitMQ Client", "Consuming item mutation events via AMQP over TLS.")
}

Rel(Core_API_Gateway, Search_API_Controller, "Routes search queries", "gRPC")
Rel(Search_API_Controller, Search_Query_Engine, "Invokes methods", "Java interface")
Rel(Catalog_Indexer, Elasticsearch_Cluster, "Synchronizes index data", "HTTP/REST over TLS")
Rel(RabbitMQ, Catalog_Indexer, "Publishes mutation events", "AMQP over TLS")
Rel(Search_Query_Engine, Centralized_Observability_Platform, "Ships telemetry and metrics", "gRPC")

@enduml