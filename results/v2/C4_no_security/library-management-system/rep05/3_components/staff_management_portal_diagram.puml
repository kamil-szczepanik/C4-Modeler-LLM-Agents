@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Staff Management Portal", "Staff Management Portal") {
    Component("Authentication & Authorization Guard", "Authentication & Authorization Guard", "Angular Router Guard", "Enforces role-based access.")
    Component("Core Feature Modules", "Core Feature Modules", "Angular Modules: Cataloging, Circulation, Admin", "Provides role-based circulation, cataloging, and administrative interfaces.")
    Component("API Client Service", "API Client Service", "Angular HttpClient", "Communicates via service injection.")
    Component("Telemetry & Audit Interceptor", "Telemetry & Audit Interceptor", "Angular HttpInterceptor", "Forwards requests and sends API requests with OTel and audit headers.")
}

System_Ext(Core_API_Gateway, "Core API Gateway", "Spring Cloud Gateway")
System_Ext(Centralized_Observability_Platform, "Centralized Observability Platform", "Observability Platform")

Rel(Authentication & Authorization Guard, Core Feature Modules, "Enforces role-based access", "TypeScript Dependency")
Rel(Core Feature Modules, API Client Service, "Communicates via service injection", "TypeScript Service Injection, HTTPS")
Rel(API Client Service, Telemetry & Audit Interceptor, "Forwards requests", "TypeScript Dependency")
Rel(Telemetry & Audit Interceptor, Core_API_Gateway, "Sends API requests with OTel and audit headers", "HTTPS REST/GraphQL")
Rel(Staff Management Portal, Centralized_Observability_Platform, "Ships browser telemetry, traces, and logs", "gRPC")
@enduml