@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Circulation Service container

System_Ext(Core_API_Gateway, "Core API Gateway", "External Dependency", "External API gateway routing traffic to the Circulation Service.")
System_Ext(RabbitMQ, "RabbitMQ", "AMQP over TLS", "External message broker used for real-time, event-driven patron updates.")
System_Ext(PostgreSQL, "PostgreSQL", "PostgreSQL (regional)", "Regional database for transactional reliability with encryption-at-rest.")
System_Ext(Centralized_Observability_Platform, "Centralized Observability Platform", "gRPC", "Platform for centralized logging, metrics, and tracing.")

Container_Boundary(Circulation_Service, "Circulation Service") {
    Component(Circulation_API_Resource, "Circulation API Resource", "Quarkus RESTEasy / gRPC Endpoint", "Handles incoming gRPC requests from the Core API Gateway for loans, renewals, and fines.")
    Component(Loan_Management_Component, "Loan Management Component", "Quarkus CDI Bean", "Manages loan processing and renewals logic.")
    Component(Fine_Fee_Component, "Fine & Fee Component", "Quarkus CDI Bean", "Manages fine and fee calculations and processing.")
    Component(Circulation_Event_Publisher, "Circulation Event Publisher", "SmallRye Reactive Messaging", "Publishes circulation events asynchronously.")
    Component(Circulation_Repository_Layer, "Circulation Repository Layer", "Hibernate/Panache", "Handles data persistence and database operations.")
    Component(SmallRye_Fault_Tolerance, "SmallRye Fault Tolerance", "SmallRye Fault Tolerance", "Implements circuit breakers for database and downstream resilience.")
    Component(OpenTelemetry, "OpenTelemetry", "OpenTelemetry", "Provides distributed tracing across API Gateway, components, and messaging.")
}

Rel(Core_API_Gateway, Circulation_API_Resource, "gRPC")
Rel(Circulation_API_Resource, Loan_Management_Component, "In-process Method Invocation")
Rel(Circulation_API_Resource, Fine_Fee_Component, "In-process Method Invocation")
Rel(Loan_Management_Component, Circulation_Repository_Layer, "JDBC over TLS")
Rel(Fine_Fee_Component, Circulation_Repository_Layer, "JDBC over TLS")
Rel(Loan_Management_Component, Circulation_Event_Publisher, "SmallRye Reactive Messaging")
Rel(Fine_Fee_Component, Circulation_Event_Publisher, "SmallRye Reactive Messaging")
Rel(Circulation_Event_Publisher, RabbitMQ, "AMQP over TLS")
Rel(Circulation_API_Resource, Centralized_Observability_Platform, "gRPC")
Rel(Loan_Management_Component, PostgreSQL, "JDBC over TLS")
Rel(Fine_Fee_Component, PostgreSQL, "JDBC over TLS")

@enduml