@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(core_api_gateway, "Core API Gateway") {
    Component(API_Route_Controller, "API Route Controller", "Spring Cloud Gateway, Spring Boot", "Routes and secures all inbound HTTP/REST and GraphQL traffic from web portals.")
    Component(Security_and_JWT_Validator, "Security and JWT Validator", "Spring Security OAuth2", "Provides stateless JWT validation against the Identity Provider.")
    Component(Rate_Limiter, "Rate Limiter", "Redis", "Powers distributed rate-limiting within EU data residency constraints.")
    Component(Circuit_Breaker, "Circuit Breaker", "Resilience4j", "Implements circuit breaking to prevent cascading downstream failures.")
}

Rel(API_Route_Controller, Security_and_JWT_Validator, "Validates incoming authentication tokens", "")
Rel(API_Route_Controller, Rate_Limiter, "Enforces rate limits using", "")
Rel(API_Route_Controller, Circuit_Breaker, "Wraps downstream calls with", "")
@enduml