@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(LibraryPatrons, "Library Patrons", "Students and public users who access self-service portals.")
Person(Librarians, "Librarians", "Staff members who manage circulation and operations.")
Person(CirculationStaff, "Circulation Staff", "Staff members who handle circulation and loans.")
Person(LibraryAdministrators, "Library Administrators", "Administrators who manage the system and configuration.")

System_Ext(PaymentGateway, "Payment Gateway", "Stripe/Adyen for fine processing.")
System_Ext(NotificationService, "Notification Service", "SendGrid/Twilio for alerts.")
System_Ext(IdentityProvider, "Identity Provider", "Keycloak / OAuth2/OIDC for authentication.")
System_Ext(ExternalAcademicIdentityFederation, "External Academic Identity Federation", "SAML/EduPerson for institutional single-sign-on.")
System_Ext(DigitalContentRepositories, "Digital Content Repositories", "Publishers providing digital content.")
System_Ext(CentralizedObservabilityPlatform, "Centralized Observability Platform", "Prometheus/Grafana/Loki deployed in EU infrastructure for monitoring.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(PatronWebPortal, "Patron Web Portal", "React, Nginx", "Provides self-service portals for library patrons.")
    Container(StaffManagementPortal, "Staff Management Portal", "Angular, Nginx", "Provides circulation and management interfaces for staff.")
    Container(CoreAPIGateway, "Core API Gateway", "Spring Cloud Gateway", "Handles centralized routing, rate-limiting, and JWT validation.")
    Container(CatalogSearchService, "Catalog & Search Service", "Spring Boot, Elasticsearch", "Dedicated search engine for high-performance catalog searches.")
    Container(CirculationService, "Circulation Service", "Quarkus, PostgreSQL", "Transactional datastore and service for loans, fines, and circulation data.")
    Container(NotificationWorker, "Notification Worker", "Node.js", "Consumes async events to process notifications.")
    Container(RabbitMQ, "RabbitMQ", "RabbitMQ", "Asynchronous event broker with dead-letter exchanges for resilient messaging.")
}

Rel(LibraryPatrons, PatronWebPortal, "Accesses self-service catalog and account features", "HTTPS")
Rel(Librarians, StaffManagementPortal, "Manages circulation and cataloging", "HTTPS")
Rel(CirculationStaff, StaffManagementPortal, "Manages circulation and operations", "HTTPS")
Rel(LibraryAdministrators, StaffManagementPortal, "Configures and manages system operations", "HTTPS")

Rel(PatronWebPortal, CoreAPIGateway, "Sends API requests for catalog and account actions", "HTTPS REST/GraphQL")
Rel(StaffManagementPortal, CoreAPIGateway, "Sends API requests for staff management operations", "HTTPS REST/GraphQL")

Rel(CoreAPIGateway, CatalogSearchService, "Routes search queries", "gRPC")
Rel(CoreAPIGateway, CirculationService, "Routes transaction requests", "gRPC")

Rel(CirculationService, RabbitMQ, "Publishes and synchronizes circulation events", "AMQP over TLS")
Rel(CatalogSearchService, RabbitMQ, "Publishes and synchronizes catalog events", "AMQP over TLS")
Rel(NotificationWorker, RabbitMQ, "Consumes events", "AMQP over TLS")

Rel(NotificationWorker, NotificationService, "Calls external notification service", "HTTPS")

Rel(PatronWebPortal, CentralizedObservabilityPlatform, "Ships telemetry and logs", "gRPC")
Rel(StaffManagementPortal, CentralizedObservabilityPlatform, "Ships telemetry and logs", "gRPC")
Rel(CoreAPIGateway, CentralizedObservabilityPlatform, "Ships telemetry and logs", "gRPC")
Rel(CatalogSearchService, CentralizedObservabilityPlatform, "Ships telemetry and logs", "gRPC")
Rel(CirculationService, CentralizedObservabilityPlatform, "Ships telemetry and logs", "gRPC")
Rel(NotificationWorker, CentralizedObservabilityPlatform, "Ships telemetry and logs", "gRPC")
Rel(RabbitMQ, CentralizedObservabilityPlatform, "Ships telemetry and logs", "gRPC")

@enduml