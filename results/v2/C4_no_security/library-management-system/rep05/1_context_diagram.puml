@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(LibraryPatrons, "Library Patrons", "Students and public users who access self-service portals.")
Person(LibrariansandCirculationStaff, "Librarians and Circulation Staff", "Staff members who manage circulation and operations.")
Person(LibraryAdministrators, "Library Administrators", "Administrators who manage the system and configuration.")

System(LibraryManagementSystem, "Library Management System", "Provides catalogue management, circulation, and self-service portals for public and academic libraries while ensuring high-performance operations and compliance with strict regulatory constraints.")

System_Ext(PaymentGateway, "Payment Gateway", "Stripe/Adyen for fine processing.")
System_Ext(NotificationService, "Notification Service", "SendGrid/Twilio for alerts.")
System_Ext(IdentityProvider, "Identity Provider", "Keycloak / OAuth2/OIDC for authentication.")
System_Ext(ExternalAcademicIdentityFederation, "External Academic Identity Federation", "SAML/EduPerson for institutional single-sign-on.")
System_Ext(DigitalContentRepositoriesandPublishers, "Digital Content Repositories and Publishers", "Publishers providing digital content.")
System_Ext(CentralizedObservabilityPlatform, "Centralized Observability Platform", "Prometheus/Grafana/Loki deployed in EU infrastructure for monitoring.")

Rel(LibraryPatrons, LibraryManagementSystem, "Interact for self-service and cataloging", "HTTPS/REST")
Rel(LibrariansandCirculationStaff, LibraryManagementSystem, "Interact for cataloging and circulation management", "HTTPS/REST")
Rel(LibraryAdministrators, LibraryManagementSystem, "Manage system operations", "HTTPS/REST")
Rel(LibraryManagementSystem, PaymentGateway, "Processes fines", "HTTPS/REST")
Rel(LibraryManagementSystem, NotificationService, "Sends alerts", "HTTPS/REST")
Rel(LibraryManagementSystem, IdentityProvider, "Authenticates users", "OAuth2/OIDC")
Rel(LibraryManagementSystem, ExternalAcademicIdentityFederation, "Authenticates academic users via single-sign-on", "SAML")
Rel(LibraryManagementSystem, DigitalContentRepositoriesandPublishers, "Fetches digital content", "HTTPS/REST")
Rel(LibraryManagementSystem, CentralizedObservabilityPlatform, "Sends metrics and logs for observability", "Prometheus/Grafana/Loki")

@enduml