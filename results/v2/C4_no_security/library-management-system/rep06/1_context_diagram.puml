@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(LibraryPatrons, "Library Patrons", "Students and public users who access the self-service portals and interact with the library system.")
Person(LibraryStaffandCirculationClerks, "Library Staff and Circulation Clerks", "Personnel responsible for managing circulation and day-to-day library operations.")
Person(LibraryAdministrators, "Library Administrators", "Administrators who access reporting dashboards and manage system configurations.")

System(LibraryManagementSystem, "Library Management System", "A cloud-native SaaS solution for public and academic libraries to catalogue items, manage circulation, and provide self-service portals with strict EU-only data residency.")

System_Ext(PaymentGateway, "Payment Gateway", "External system used for processing payments.")
System_Ext(ThirdPartyIdentityProviderLDAP, "Third-Party Identity Provider / LDAP", "External system providing authentication and SSO integration via SAML/OIDC.")
System_Ext(ThirdPartyDigitalContentProviders, "Third-Party Digital Content Providers", "External systems providing digital content to library users.")
System_Ext(NotificationService, "Notification Service", "External system for handling notifications via webhooks.")
System_Ext(CentralizedLogAuditAggregator, "Centralized Log/Audit Aggregator", "External system for aggregating logs and audit trails.")
System_Ext(APMandSyntheticMonitoringTool, "APM and Synthetic Monitoring Tool", "External tool used to validate performance SLAs and monitor system health.")

Rel(LibraryPatrons, LibraryManagementSystem, "Interact via Web/Mobile Apps", "HTTPS")
Rel(LibraryStaffandCirculationClerks, LibraryManagementSystem, "Manage circulation and operations via Web/Mobile Apps", "HTTPS")
Rel(LibraryAdministrators, LibraryManagementSystem, "Access reporting dashboards", "HTTPS")
Rel(LibraryManagementSystem, PaymentGateway, "Connects with pseudonymized data", "HTTPS/REST")
Rel(LibraryManagementSystem, ThirdPartyDigitalContentProviders, "Connects with pseudonymized data", "HTTPS/REST")
Rel(LibraryManagementSystem, ThirdPartyIdentityProviderLDAP, "Integrates for authentication and SSO", "SAML/OIDC")
Rel(LibraryManagementSystem, NotificationService, "Sends notification triggers", "HTTPS/Webhooks")

@enduml