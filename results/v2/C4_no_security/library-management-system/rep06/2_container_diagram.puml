@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(Library_Patrons, "Library Patrons", "Students and public users who access the self-service portals.")
Person(Library_Staff, "Library Staff", "Personnel responsible for managing circulation and operations via the staff dashboard.")
Person(Library_Administrators, "Library Administrators", "Administrators who access reporting dashboards and manage configurations.")

System_Ext(Payment_Gateway, "Payment Gateway", "External system used for processing payments.")
System_Ext(LDAP, "LDAP", "External system providing authentication and identity integration.")
System_Ext(Digital_Content_Providers, "Digital Content Providers", "External systems providing digital content to library users.")
System_Ext(Notification_Service, "Notification Service", "External system for handling notifications.")
System_Ext(APM_Tool, "APM Tool", "External tool used for application performance monitoring and metrics.")

System_Boundary(Library_Management_System, "Library Management System") {
    Container(API_Gateway, "API Gateway", "Kong / NGINX", "Handles rate limiting and TLS termination for incoming requests.")
    Container(Self_Service_Portal_Staff_Dashboard, "Self-Service Portal & Staff Dashboard", "React / TypeScript", "Frontend Single Page Applications served via CDN for user and staff interaction.")
    Container(Core_API_Application, "Core API Application", "Spring Boot / Java", "Handles domain logic and business operations.")
    Container(Search_Engine, "Search Engine", "OpenSearch", "Isolates heavy catalogue queries to meet search latency requirements.")
    ContainerDb(Primary_Database, "Primary Database", "Managed PostgreSQL", "Stores relational data and ensures transactional integrity in EU regions.")
    Container(Message_Broker, "Message Broker", "Kafka / RabbitMQ", "Facilitates asynchronous event publishing and consumption.")
    Container(Async_Workers, "Async Workers", "Spring Boot / Java", "Handles background processing and asynchronous tasks.")
}

Rel(Library_Patrons, Self_Service_Portal_Staff_Dashboard, "Interact via portals", "HTTPS/JSON")
Rel(Library_Staff, Self_Service_Portal_Staff_Dashboard, "Interact via portals", "HTTPS/JSON")
Rel(Library_Administrators, Self_Service_Portal_Staff_Dashboard, "Interact via portals", "HTTPS/JSON")
Rel(Self_Service_Portal_Staff_Dashboard, API_Gateway, "Communicates via API Gateway", "HTTPS/TLS")
Rel(API_Gateway, Core_API_Application, "Routes requests to Core API", "HTTPS")
Rel(Core_API_Application, Primary_Database, "Queries and updates transactional data", "gRPC/REST over TLS")
Rel(Core_API_Application, Search_Engine, "Performs catalogue searches", "gRPC/REST over TLS")
Rel(Core_API_Application, Message_Broker, "Publishes asynchronous events", "AMQP/Kafka")
Rel(Async_Workers, Message_Broker, "Consumes asynchronous events", "AMQP/Kafka")
Rel(Core_API_Application, Payment_Gateway, "Processes payments", "HTTPS")
Rel(Core_API_Application, LDAP, "Authenticates users", "LDAP/TLS")
Rel(Core_API_Application, Digital_Content_Providers, "Retrieves digital content", "HTTPS")
Rel(Core_API_Application, Notification_Service, "Triggers notifications", "HTTPS")
Rel(Core_API_Application, APM_Tool, "Streams performance metrics", "OpenTelemetry")

@enduml