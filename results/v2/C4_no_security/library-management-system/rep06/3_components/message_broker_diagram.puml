@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(message_broker, "Message Broker") {
    Component(event_log_manager, "Event Log Manager", "Apache Kafka", "Manages durable, partitioned commit logs for asynchronous event streams.")
    Component(topic_router, "Topic Router", "Apache Kafka", "Routes asynchronous events to the appropriate message queues and topics.")
    Component(schema_registry, "Schema Registry", "Avro & Schema Registry", "Enforces backward-compatible event schemas between producers and consumers.")
    Component(consumer_group_coordinator, "Consumer Group Coordinator", "Apache Kafka", "Coordinates consumer groups for parallelized and scalable message processing.")
    Component(access_control_auth_module, "Access Control & Auth Module", "SASL/SCRAM and TLS", "Authenticates Core API Application and Async Workers via SASL/SCRAM and TLS client certificates.")
}

Rel(event_log_manager, topic_router, "Supplies partitioned logs for routing", "")
Rel(topic_router, consumer_group_coordinator, "Dispatches events to consumer groups", "")
Rel(schema_registry, event_log_manager, "Validates event schemas for stored messages", "")

@enduml