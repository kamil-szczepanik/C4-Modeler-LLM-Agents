@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Person(SelfServicePortalStaffDashboard, "Self-Service Portal & Staff Dashboard", "Users of the Library Management System")
System_Ext(ThirdPartyIdentityProvider, "Third-Party Identity Provider", "OIDC/OAuth2 Provider")
System_Ext(CoreAPIApplication, "Core API Application", "Core backend services")
System_Ext(APMandSyntheticMonitoringTool, "APM and Synthetic Monitoring Tool", "Observability platform")
System_Ext(CentralizedLogAuditAggregator, "Centralized Log/Audit Aggregator", "Log management platform")

Container_Boundary(APIGateway, "API Gateway") {
    Component(TLSTerminationSSLTLSCertificateManager, "TLS Termination & SSL/TLS Certificate Manager", "Kong/NGINX", "Handles inbound HTTPS traffic and SSL/TLS certificates.")
    Component(AuthenticationPluginJWTOAuth2Validator, "Authentication Plugin (JWT/OAuth2 Validator)", "Kong Plugin / OIDC", "Validates tokens against the Third-Party Identity Provider.")
    Component(RateLimitingACLPlugin, "Rate Limiting & ACL Plugin", "Kong Plugin", "Enforces persona-based quotas for Patrons and Clerks.")
    Component(UpstreamProxyCircuitBreaker, "Upstream Proxy & Circuit Breaker", "Kong Proxy", "Routes to the Core API with health checks.")
    Component(TelemetryLogExporter, "Telemetry & Log Exporter", "Prometheus / Fluentd / Syslog", "Exports Prometheus metrics and streams scrubbed logs.")
    Component(ErrorTransformerPlugin, "Error Transformer Plugin", "Kong Plugin", "Outputs standardized, localized error payloads.")
}

Rel(SelfServicePortalStaffDashboard, TLSTerminationSSLTLSCertificateManager, "HTTPS/TLS", "HTTPS")
Rel(AuthenticationPluginJWTOAuth2Validator, ThirdPartyIdentityProvider, "OIDC/JWKS [HTTPS]", "HTTPS")
Rel(UpstreamProxyCircuitBreaker, CoreAPIApplication, "HTTP/REST [HTTPS]", "HTTPS")
Rel(TelemetryLogExporter, APMandSyntheticMonitoringTool, "Prometheus [HTTPS]", "HTTPS")
Rel(TelemetryLogExporter, CentralizedLogAuditAggregator, "Syslog/Fluentd [HTTPS]", "HTTPS")

@enduml