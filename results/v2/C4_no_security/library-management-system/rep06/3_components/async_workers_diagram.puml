@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(async_workers, "Async Workers") {
    Component(Event_Consumer_Engine, "Event Consumer Engine", "Spring Boot / Java", "Consumes asynchronous events from the message broker.")
    Component(Notification_Dispatcher_Component, "Notification Dispatcher Component", "Spring Boot / Java", "Dispatches alerts and notifications to external services.")
    Component(Index_Synchronizer_Component, "Index Synchronizer Component", "Spring Boot / Java", "Updates index data in the search engine.")
    Component(Fine___Payment_Processor_Component, "Fine & Payment Processor Component", "Spring Boot / Java", "Persists financial updates and emits immutable audit logs.")
}

System_Ext(Message_Broker, "Message Broker", "Message broker for asynchronous event distribution and queue management.")
System_Ext(Search_Engine, "Search Engine", "Search engine for sub-800ms catalogue queries and fast indexing.")
System_Ext(Notification_Service, "Notification Service", "External notification service.")
System_Ext(Primary_Database, "Primary Database", "Managed PostgreSQL primary relational database.")
System_Ext(Centralized_Log_Audit_Aggregator, "Centralized Log/Audit Aggregator", "External log and audit aggregation system.")

Rel(Event_Consumer_Engine, Message_Broker, "Consumes asynchronous events", "Kafka Protocol / AMQP")
Rel(Index_Synchronizer_Component, Search_Engine, "Updates index data", "HTTPS/REST")
Rel(Notification_Dispatcher_Component, Notification_Service, "Dispatches alerts", "HTTPS/REST")
Rel(Fine___Payment_Processor_Component, Primary_Database, "Persists financial updates", "JDBC/TCP")
Rel(Fine___Payment_Processor_Component, Centralized_Log_Audit_Aggregator, "Emits immutable audit logs", "Syslog/HTTPS")

@enduml