@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Primary Database container

Container_Boundary(primary_database, "Primary Database") {
    Component(CatalogModule, "Catalog Module", "Managed PostgreSQL", "Stores and manages library catalogue items and metadata.")
    Component(CirculationModule, "Circulation Module", "Managed PostgreSQL", "Manages lending, returns, and circulation records for patrons.")
    Component(IdentityAccessModule, "Identity & Access Module", "Managed PostgreSQL", "Manages patron and staff credentials, roles, and access permissions.")
    Component(ReadReplicaComponent, "Read Replica Component", "Managed PostgreSQL", "Handles read-heavy query traffic to optimize performance.")
    Component(ArchivalPartitioningModule, "Archival & Partitioning Module", "Managed PostgreSQL", "Handles scheduled batch cleanup jobs and data archiving.")
}

System_Ext(AsyncWorkers, "Async Workers", "Spring Boot / Java")

Rel(AsyncWorkers, ArchivalPartitioningModule, "Executes scheduled batch cleanup jobs", "PostgreSQL wire protocol over TLS 1.3")

@enduml