@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Search Engine container

Container_Boundary(search_engine, "Search Engine") {
    Component(SearchAPI_RoutingComponent, "Search API & Routing Component", "REST over TLS / gRPC", "Handles incoming search requests, API routing, and ensures sub-800ms response times for complex queries.")
    Component(QueryExecution_ScoringEngine, "Query Execution & Scoring Engine", "OpenSearch", "Performs full-text search, fuzzy matching, faceting, and custom synonyms.")
    Component(IndexManagement_IngestionComponent, "Index Management & Ingestion Component", "OpenSearch / Kafka Protocol", "Manages indices and processes real-time item catalogue updates asynchronously.")
    Component(ClusterCoordination_StorageNodes, "Cluster Coordination & Storage Nodes", "OpenSearch Cluster / EU Cloud Managed Storage", "Stores search data, ensures EU-only data residency, and performs automated snapshots for disaster recovery.")
}

System_Ext(CoreAPI, "Core API Application", "Spring Boot / Java")
System_Ext(MessageBroker, "Message Broker", "Kafka")
System_Ext(APMLogAggregator, "APM and Synthetic Monitoring Tool", "Centralized Log Aggregator")
System_Ext(EUObjectStorage, "EU-Region Object Storage", "EU Cloud Managed Storage")

Rel(CoreAPI, SearchAPI_RoutingComponent, "Executes catalogue searches", "REST/gRPC over TLS")
Rel(MessageBroker, IndexManagement_IngestionComponent, "Pushes real-time item catalogue updates", "Kafka Protocol over TLS")
Rel(SearchAPI_RoutingComponent, QueryExecution_ScoringEngine, "Routes parsed search queries for execution and scoring", "Internal")
Rel(IndexManagement_IngestionComponent, ClusterCoordination_StorageNodes, "Persists and indexes real-time catalogue updates", "Internal")
Rel(ClusterCoordination_StorageNodes, EUObjectStorage, "Performs automated snapshots for disaster recovery", "HTTPS")
Rel(ClusterCoordination_StorageNodes, APMLogAggregator, "Exports telemetry, JVM metrics, and audit logs", "TLS")

@startuml