@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Core API Application", "Core API Application") {
    Component("Catalog & Circulation Controller", "Catalog & Circulation Controller", "Spring MVC", "Manages item management and workflows.")
    Component("Security & Audit Interceptor", "Security & Audit Interceptor", "Spring Security / AOP", "Handles GDPR compliance and audit logging.")
    Component("Payment & External Integration Service", "Payment & External Integration Service", "Resilience4j / Java", "Manages third-party payment and digital content integrations.")
    Component("Catalog Search Component", "Catalog Search Component", "Resilience4j / Java", "Handles catalogue searches with circuit breaker and database fallback.")
    Component("Data Access Repository", "Data Access Repository", "Spring Data JPA / HikariCP", "Manages connections to PostgreSQL read replicas.")
}

Rel("Catalog & Circulation Controller", "Data Access Repository", "Queries and updates transactional data", "")
Rel("Catalog Search Component", "Data Access Repository", "Executes fallback queries using connection pooling", "")
Rel("Payment & External Integration Service", "Catalog & Circulation Controller", "Supports workflows with external integrations", "")
Rel("Security & Audit Interceptor", "Catalog & Circulation Controller", "Interceps requests for GDPR compliance and audit logging", "")

@enduml