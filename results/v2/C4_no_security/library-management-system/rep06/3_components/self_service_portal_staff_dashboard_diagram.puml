@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Self-Service Portal & Staff Dashboard container

Container_Boundary(self_service_portal_staff_dashboard, "Self-Service Portal & Staff Dashboard") {
    Component(Patron_Portal_Component, "Patron Portal Component", "React & TypeScript", "Provides the self-service interface for patrons to browse and manage library services.")
    Component(Staff_Circulation_Dashboard_Component, "Staff Circulation Dashboard Component", "React & TypeScript", "Enables staff to manage circulation, item cataloguing, and patron activities.")
    Component(Admin_Analytics_Dashboard_Component, "Admin Analytics Dashboard Component", "React, TypeScript, Chart.js / Recharts", "Delivers analytics rendering and administrative control panels for system administrators.")
    Component(Shared_API_Client___State_Component, "Shared API Client & State Component", "Axios, React Query, IndexedDB & SessionStorage", "Handles API communication, client-side caching, and local state storage for EU-compliant data handling.")
    Component(Guided_Onboarding_Component, "Guided Onboarding Component", "React & TypeScript", "Provides guided onboarding workflows for new users of the portal and dashboard.")
}

Component(API_Gateway__Kong___NGINX_, "API Gateway (Kong / NGINX)", "Kong / NGINX", "Routes requests securely from the frontend application to backend services.")
Component(CDN__Cloudflare___CloudFront_, "CDN (Cloudflare / CloudFront)", "Cloudflare / CloudFront", "Provides global asset delivery restricted to EU regions to ensure compliance with data residency constraints.")

Rel(Patron_Portal_Component, Shared_API_Client___State_Component, "Utilizes for API communication and state management")
Rel(Staff_Circulation_Dashboard_Component, Shared_API_Client___State_Component, "Utilizes for API communication and state management")
Rel(Admin_Analytics_Dashboard_Component, Shared_API_Client___State_Component, "Utilizes for API communication and state management")
Rel(Guided_Onboarding_Component, Shared_API_Client___State_Component, "Utilizes for API communication and state management")
Rel(Shared_API_Client___State_Component, API_Gateway__Kong___NGINX_, "Sends HTTPS/TLS requests to")
Rel(self_service_portal_staff_dashboard, CDN__Cloudflare___CloudFront_, "Loads static assets from EU-restricted")

@enduml