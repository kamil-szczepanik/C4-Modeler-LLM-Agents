@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Insurance Claims Modernization system

Person(Policyholders, "Policyholders", "External users submitting and checking the status of claims.")
Person(Brokers, "Brokers", "External intermediaries interacting with the platform on behalf of policyholders.")
Person("Claims Adjusters", "Claims Adjusters", "Internal users performing adjuster workflows and reviewing claims.")

System_Ext("Legacy COBOL/DB2 Mainframe", "Legacy COBOL/DB2 Mainframe", "30-year-old on-premises mainframe handling legacy batch processing and primary data storage.")
System_Ext("Microsoft Entra ID", "Microsoft Entra ID", "Identity Provider for single sign-on and secure entry.")

System_Boundary(system_boundary, "Insurance Claims Modernization system") {
    Container("Azure API Management (API Gateway)", "Azure API Management (API Gateway)", "Azure APIM", "Centralized API management, routing, and ingress security.")
    Container("Customer/Broker Portal", "Customer/Broker Portal", "Node.js, TypeScript, Azure App Service", "Frontend portal for policyholders and brokers to interact with the platform.")
    Container("Adjuster Workstation", "Adjuster Workstation", "Node.js, TypeScript, Azure App Service", "Frontend interface providing sub-2s performance for claims adjusters.")
    Container("Adjuster BFF", "Adjuster BFF", ".NET / C#", "Backend-for-Frontend service for adjuster workflows.")
    Container("Claim Migration Manager / Admin Portal", "Claim Migration Manager / Admin Portal", ".NET / C#", "Admin portal and migration manager for executing incremental claim migrations.")
    Container("Core Claims Domain", "Core Claims Domain", ".NET / C#", "Core business logic and domain services for modern claims processing.")
    Container("Integration Worker", "Integration Worker", ".NET / C#, Azure Service Bus", "Integration service using an Anti-Corruption Layer (ACL) for asynchronous messaging and data synchronization with the mainframe.")
    ContainerDb("Operational Data Store (PostgreSQL)", "Operational Data Store (PostgreSQL)", "Azure Database for PostgreSQL", "Operational data store for persistence and caching.")
    Container("Observability Service", "Observability Service", "Azure Application Insights, Prometheus, Grafana", "Monitors system health, metrics, and logs.")
}

Rel(Policyholders, "Azure API Management (API Gateway)", "Single sign-on and secure entry", "HTTPS, OIDC, OAuth2")
Rel(Brokers, "Azure API Management (API Gateway)", "Single sign-on and secure entry", "HTTPS, OIDC, OAuth2")
Rel("Claims Adjusters", "Azure API Management (API Gateway)", "Single sign-on and secure entry", "HTTPS, OIDC, OAuth2")
Rel("Azure API Management (API Gateway)", "Customer/Broker Portal", "Routes traffic to frontend portals", "HTTPS, gRPC")
Rel("Azure API Management (API Gateway)", "Adjuster Workstation", "Routes traffic to frontend workstations", "HTTPS, gRPC")
Rel("Customer/Broker Portal", "Core Claims Domain", "Internal domain communication", "HTTPS, gRPC")
Rel("Adjuster Workstation", "Adjuster BFF", "Internal domain communication", "HTTPS, gRPC")
Rel("Adjuster BFF", "Core Claims Domain", "Internal domain communication", "HTTPS, gRPC")
Rel("Integration Worker", "Legacy COBOL/DB2 Mainframe", "Asynchronous event processing and data synchronization via ACL Gateway and Azure Service Bus", "Asynchronous Messaging")
Rel("Core Claims Domain", "Operational Data Store (PostgreSQL)", "Operational data persistence and caching", "TLS")
Rel("Adjuster BFF", "Operational Data Store (PostgreSQL)", "Operational data persistence and caching", "TLS")

@enduml