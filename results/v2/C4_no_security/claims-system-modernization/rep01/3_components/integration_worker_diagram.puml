@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Worker container

Container_Ext(Integration_Worker, "Integration Worker", "Container", "The Integration Worker is a .NET-based core component that safely synchronizes claim data between the new cloud platform and the legacy mainframe.")
System_Ext(ACL_Gateway, "ACL Gateway", "Anti-Corruption Layer Gateway")
System_Ext(Azure_Service_Bus, "Azure Service Bus", "Messaging Platform")
System_Ext(Azure_Application_Insights, "Azure Application Insights", "Monitoring & Logging")

Container_Boundary(integration_worker_boundary, "Integration Worker") {
    Component(Message_Listener_Component, "Message Listener Component", ".NET / C#, AMQP", "Listens for messages from Azure Service Bus to synchronize claim data.")
    Component(Transformation_Engine_Component, "Transformation Engine Component", ".NET / C#", "Transforms claim data between the new cloud platform and legacy formats.")
    Component(Outbox_Retry_Dispatcher_Component, "Outbox/Retry Dispatcher Component", ".NET / C#", "Dispatches messages reliably with outbox pattern and retry logic.")
    Component(Integration_Audit_Logger_Component, "Integration Audit Logger Component", ".NET / C#", "Logs integration activities and audit trails.")
    Component(Circuit_Breaker_Policy_Manager, "Circuit Breaker Policy Manager", ".NET / C#, Polly", "Manages resilience and circuit breaking against mainframe outages.")
    Component(Feature_Kill_Switch_Component, "Feature/Kill-Switch Component", ".NET / C#, ASP.NET Core Minimal APIs", "Provides an administrative kill-switch for fast rollbacks.")
}

Rel(Message_Listener_Component, Transformation_Engine_Component, "In-process, Direct Method Calls")
Rel(Transformation_Engine_Component, Outbox_Retry_Dispatcher_Component, "In-process, Direct Method Calls")
Rel(Outbox_Retry_Dispatcher_Component, ACL_Gateway, "HTTPS/REST")
Rel(Integration_Worker, Azure_Service_Bus, "AMQP")
Rel(Integration_Audit_Logger_Component, Azure_Application_Insights, "HTTPS/REST")

@enduml