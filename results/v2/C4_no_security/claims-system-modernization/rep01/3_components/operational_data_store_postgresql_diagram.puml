@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Operational Data Store (PostgreSQL) container

Container_Boundary(operational_data_store, "Operational Data Store (PostgreSQL)") {
    Component(Claim_State___Domain_Store, "Claim State & Domain Store", "Azure Database for PostgreSQL Flexible Server", "Stores core claim states and domain data with native JSONB support and high availability.")
    Component(Read_Model___Cache_Store, "Read Model & Cache Store", "Azure Database for PostgreSQL Read Replica", "Provides optimized read access and caching for adjuster workflows to overcome legacy latency.")
    Component(Migration_Metadata_Store, "Migration Metadata Store", "Azure Database for PostgreSQL Flexible Server", "Tracks migration metadata to ensure continuous processing during mainframe transition.")
    Component(Audit___Compliance_Log_Store, "Audit & Compliance Log Store", "Azure Database for PostgreSQL with pgaudit Extension", "Maintains granular session and object audit logs for insurance regulatory compliance.")
    Component(PgBouncer_Connection_Pooler, "PgBouncer Connection Pooler", "PgBouncer", "Manages and optimizes database connection pooling to prevent exhaustion during peak loads.")
    Component(Azure_Monitor___Log_Analytics_Workspace, "Azure Monitor / Log Analytics Workspace", "Azure Monitor", "Centralizes audit and diagnostic log streaming from the operational database.")
}

Rel(Core_Claims_Domain, Claim_State___Domain_Store, "SQL / ADO.NET [TLS]")
Rel(Adjuster_BFF, Read_Model___Cache_Store, "SQL / Entity Framework Core [TLS]")
Rel(Core_Claims_Domain, Audit___Compliance_Log_Store, "Internal DB Write [TLS]")
Rel(Azure_Database_for_PostgreSQL, Azure_Monitor___Log_Analytics_Workspace, "Native Diagnostic Log Streaming [Encrypted]")

@enduml