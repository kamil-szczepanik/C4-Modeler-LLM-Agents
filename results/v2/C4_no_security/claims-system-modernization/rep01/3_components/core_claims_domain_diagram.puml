@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(adjuster_bff, "Adjuster BFF", "Backend For Frontend for adjusters")

Container_Boundary(core_claims_domain, "Core Claims Domain") {
    Component(claim_routing, "Claim Routing & Feature Flag Component", ".NET / C#, MediatR", "Routes claims and manages feature flags for hybrid architecture migration.")
    Component(claim_processing, "Claim Processing Engine", ".NET / C#, Domain-Driven Design", "Processes claims using domain-driven design principles.")
    Component(idempotency_manager, "Idempotency & Audit Manager", ".NET / C#, EF Core", "Manages idempotency and auditing using Entity Framework Core.")
    Component(reporting_adapter, "Reporting & Analytics Adapter", ".NET / C#, MassTransit", "Adapts reporting and analytics data via MassTransit messaging.")
    ComponentDb(operational_data_store, "Operational Data Store", "Azure Database for PostgreSQL", "Relational storage supporting distributed leasing and consistency.")
    Component(infrastructure_messaging, "Infrastructure & Messaging", "Azure Container Apps, Azure Service Bus", "Provides containerized cloud deployment and asynchronous messaging.")
}

Rel(adjuster_bff, claim_routing, "gRPC")
Rel(claim_routing, claim_processing, "In-Process, MediatR")
Rel(claim_processing, idempotency_manager, "In-Process")
Rel(idempotency_manager, operational_data_store, "TLS, TCP")
Rel(claim_processing, reporting_adapter, "In-Process, MediatR")
Rel(reporting_adapter, infrastructure_messaging, "AMQP")

@enduml