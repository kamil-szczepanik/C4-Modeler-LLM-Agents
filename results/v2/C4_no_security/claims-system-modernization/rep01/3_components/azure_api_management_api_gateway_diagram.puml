@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Policyholders, "Policyholders", "External users accessing the system")
Person(Brokers, "Brokers", "External brokers accessing the system")
Person(Claims Adjusters, "Claims Adjusters", "Internal users accessing the system")

System_Ext(Adjuster BFF, "Adjuster BFF", "Backend for Frontend service")
System_Ext(Anti-Corruption Layer (ACL) Gateway, "Anti-Corruption Layer (ACL) Gateway", "Gateway for legacy endpoints")

Container_Boundary(Azure API Management (API Gateway), "Azure API Management (API Gateway)") {
    Component(Token Validator Component, "Token Validator Component", "ASP.NET Core / OAuth2", "Validates incoming security tokens and extracts claims for authorization.")
    Component(API Router & Policy Engine, "API Router & Policy Engine", "XML-based APIM Policies", "Handles dynamic backend routing and policy enforcement.")
    Component(Internal Developer Portal, "Internal Developer Portal", "Azure APIM Developer Portal", "Provides documentation and self-service API management for internal developers.")
    Component(Rate Limiting & Quota Enforcer, "Rate Limiting & Quota Enforcer", "XML-based APIM Policies", "Enforces rate limits and quotas for API consumers.")
    Component(Backend Circuit Breaker & Retry Engine, "Backend Circuit Breaker & Retry Engine", "XML-based APIM Policies", "Provides fault tolerance, retries, and circuit breaking for backend systems.")
}

Rel(Policyholders, Azure API Management (API Gateway), "Single sign-on and secure entry", "HTTPS, OIDC, OAuth2")
Rel(Brokers, Azure API Management (API Gateway), "Single sign-on and secure entry", "HTTPS, OIDC, OAuth2")
Rel(Claims Adjusters, Azure API Management (API Gateway), "Single sign-on and secure entry", "HTTPS, OIDC, OAuth2")
Rel(API Router & Policy Engine, Adjuster BFF, "Routes authenticated adjuster requests", "HTTPS, gRPC")
Rel(API Router & Policy Engine, Anti-Corruption Layer (ACL) Gateway, "Routes unmigrated claim traffic to legacy endpoints", "HTTPS, JSON")

@enduml