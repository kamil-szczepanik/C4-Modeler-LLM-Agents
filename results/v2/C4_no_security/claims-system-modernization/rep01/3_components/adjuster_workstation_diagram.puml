@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Adjuster Workstation container

Container_Boundary(adjuster_workstation, "Adjuster Workstation") {
    Component(ClaimsDashboardComponent, "Claims Dashboard Component", "React SPA, Azure Static Web Apps", "Provides high-performance rendering for the claims adjusters dashboard.")
    Component(StateRealTimeSyncComponent, "State & Real-Time Sync Component", "Server-Sent Events (SSE)", "Handles real-time migration status updates and synchronization without polling overhead.")
    Component(ClaimActionFormEngineComponent, "Claim Action & Form Engine Component", "React SPA", "Manages claim actions and form rendering for internal adjusters.")
    Component(AuthSessionManagerComponent, "Auth & Session Manager Component", "Microsoft Entra ID, OIDC/OAuth2", "Manages user authentication, session state, and Single Sign-On integration.")
}

System_Ext(AdjusterBFF, "Adjuster BFF", ".NET / C#, Azure App Service")
System_Ext(MicrosoftEntraID, "Microsoft Entra ID", "Identity Provider")

Rel(ClaimsDashboardComponent, AdjusterBFF, "Routes web requests and interacts", "HTTPS")
Rel(StateRealTimeSyncComponent, AdjusterBFF, "Receives real-time updates", "Server-Sent Events (SSE)")
Rel(ClaimActionFormEngineComponent, AdjusterBFF, "Submits claim actions", "HTTPS")
Rel(AuthSessionManagerComponent, MicrosoftEntraID, "Authenticates users", "OIDC/OAuth2 over HTTPS")

@enduml