@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(adjuster_bff, "Adjuster BFF") {
    Component(api_controller, "API Controller", ".NET Core, C#", "Handles incoming UI requests from the Adjuster Workstation and maps them to domain commands and queries.")
    Component(domain_service_client, "Domain Service Client", ".NET Core, C#, gRPC", "Communicates with the Core Claims Domain for domain-specific business operations.")
    Component(legacy_integration_gateway, "Legacy Integration Gateway", ".NET Core, C#, Anti-Corruption Layer (ACL)", "Interfaces with the Legacy Mainframe through the Anti-Corruption Layer Gateway for legacy integration.")
    Component(read_model_cache_manager, "Read-Model Cache Manager", ".NET Core, C#, PostgreSQL", "Manages read-model caching and state persistence against the Operational Data Store.")
    Component(authentication_handler, "Authentication Handler", "Microsoft Entra ID, OIDC, OAuth 2.0", "Handles Single Sign-On and security validation for adjuster sessions.")
}

Rel(api_controller, domain_service_client, "Invokes domain queries and commands", "HTTPS, gRPC")
Rel(api_controller, legacy_integration_gateway, "Delegates legacy integration requests", "HTTPS, gRPC")
Rel(api_controller, read_model_cache_manager, "Performs read-model caching and state persistence", "TLS")
Rel(api_controller, authentication_handler, "Validates Single Sign-On", "OIDC, OAuth 2.0")

@enduml