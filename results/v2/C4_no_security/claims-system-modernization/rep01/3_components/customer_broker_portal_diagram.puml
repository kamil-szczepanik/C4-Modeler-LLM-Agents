@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component Diagram for the Customer/Broker Portal container

Container_Boundary(customer_broker_portal, "Customer/Broker Portal") {
    Component(next_js_frontend_ui, "Next.js Frontend UI", "Node.js, TypeScript, Next.js, React Server Components", "Provides the user interface for policyholders and brokers to submit and track claims.")
    Component(session_management_service, "Session Management Service", "Node.js, Azure Cache for Redis", "Handles distributed session caching and broker view caching.")
    Component(api_integration_client, "API Integration Client", "TypeScript, HTTPS", "Communicates securely with Azure API Management to route ingress API traffic.")
}

System_Ext(azure_api_management, "Azure API Management", "API Gateway")

Rel(next_js_frontend_ui, session_management_service, "Stores and retrieves session data", "TCP")
Rel(next_js_frontend_ui, api_integration_client, "Sends API requests for claim submission and tracking", "HTTPS")
Rel(api_integration_client, azure_api_management, "Routes ingress API traffic", "HTTPS")

@enduml