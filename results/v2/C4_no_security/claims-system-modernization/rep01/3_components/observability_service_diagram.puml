@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Observability Service container

Container_Boundary(observability_service, "Observability Service") {
    Component(OpenTelemetry_Collector_Component, "OpenTelemetry Collector Component", "Azure Container Apps, OpenTelemetry (OTLP)", "Collects telemetry from .NET and Node.js containers and routes logs, traces, and metrics to downstream Azure backends.")
    Component(Azure_Monitor_Exporter_Component, "Azure Monitor Exporter Component", "Azure Application Insights & Azure Monitor", "Captures APM traces and application logs with reduced operational overhead.")
    Component(Managed_Prometheus_Exporter_Component, "Managed Prometheus Exporter Component", "Azure Managed Prometheus", "Ingests operational metrics while abstracting underlying storage maintenance.")
    Component(Grafana_Visualization_Component, "Grafana Visualization Component", "Azure Managed Grafana", "Provides unified, business-centric dashboards for incident management by querying Azure backends via PromQL and Azure Monitor APIs.")
    Component(Secure_Hybrid_Ingress_Component, "Secure Hybrid Ingress Component", "Azure Private Link, VPN/ExpressRoute", "Secures hybrid telemetry ingestion from on-premise components like the legacy mainframe and ACL Gateway.")
}

System_Ext(dotnet_nodejs_containers, ".NET and Node.js containers", "Application containers generating telemetry")
System_Ext(onprem_mainframe_acl, "On-premise legacy mainframe and ACL Gateway", "Legacy systems generating telemetry from on-premise")

Rel(dotnet_nodejs_containers, OpenTelemetry_Collector_Component, "Transmit telemetry via OTLP over gRPC/HTTP", "OTLP/gRPC/HTTP")
Rel(OpenTelemetry_Collector_Component, Azure_Monitor_Exporter_Component, "Routes logs and traces", "Internal")
Rel(OpenTelemetry_Collector_Component, Managed_Prometheus_Exporter_Component, "Forwards metrics", "Internal")
Rel(Grafana_Visualization_Component, Azure_Monitor_Exporter_Component, "Queries Azure backends via Azure Monitor APIs", "HTTPS / API")
Rel(Grafana_Visualization_Component, Managed_Prometheus_Exporter_Component, "Queries Azure backends via PromQL", "PromQL / HTTP")
Rel(onprem_mainframe_acl, Secure_Hybrid_Ingress_Component, "Transmit telemetry using Azure Private Link and VPN/ExpressRoute", "Azure Private Link / VPN")

@enduml