title Component diagram for the Claim Migration Manager / Admin Portal container

Container_Boundary(admin_portal_boundary, "Claim Migration Manager / Admin Portal") {
    Component(Claim Migration Manager / Admin Portal, "Claim Migration Manager / Admin Portal", ".NET / C#", "Provides an administrative interface for managing the incremental migration of the mainframe claims system.")
}

System_Ext(Migration Controller API, "Migration Controller API", "Handles migration orchestration.")

Rel(Claim Migration Manager / Admin Portal, Migration Controller API, "Invokes", "REST/gRPC")

