@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Regional Insurer Mainframe Claims Platform Modernization

Person(Policyholders_and_Brokers, "Policyholders and Brokers", "External users submitting claims and interacting with the system.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal users performing adjuster workflows within the system.")
System(New_Claims_Platform, "New Claims Platform", "A cloud-based web application modernizing a 30-year-old regional insurer mainframe claims platform, enabling gradual, risk-mitigated claim migration while keeping the legacy system as the primary data store.")
System_Ext(Legacy_Mainframe, "Legacy Mainframe", "IBM z/OS, COBOL, and DB2 system serving as the primary data store and processing backbone.")
System_Ext(Microsoft_Entra_ID, "Microsoft Entra ID", "Identity Provider enforcing enterprise Single Sign-On and role-based access control.")
System_Ext(Anti_Corruption_Layer_ACL_Gateway, "Anti-Corruption Layer (ACL) Gateway", "Gateway isolating modern user experiences from legacy latency via asynchronous messaging.")

Rel(Policyholders_and_Brokers, New_Claims_Platform, "Submit claims and interact with the platform", "HTTPS/TLS")
Rel(Claims_Adjusters, New_Claims_Platform, "Execute adjuster workflows", "HTTPS/TLS")
Rel(New_Claims_Platform, Microsoft_Entra_ID, "Authenticates users for Single Sign-On", "OpenID Connect (OIDC) / OAuth 2.0")
Rel(New_Claims_Platform, Anti_Corruption_Layer_ACL_Gateway, "Sends and receives claim data asynchronously", "Azure Service Bus")
Rel(Anti_Corruption_Layer_ACL_Gateway, Legacy_Mainframe, "Syncs data and executes batch operations", "Asynchronous Messaging and Managed File Transfer (MFT)")

@enduml