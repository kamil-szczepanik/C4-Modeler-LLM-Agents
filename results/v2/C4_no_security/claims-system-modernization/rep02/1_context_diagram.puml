@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Regional Insurance Claims Platform

Person(Customer_Broker, "Customer / Broker", "External users who submit online claims and interact with the customer portal.")
Person(Claims_Adjuster, "Claims Adjuster", "External users who perform rapid adjuster processing of claims.")

System_Ext(Active_Directory_Azure_AD, "Active Directory / Azure AD", "Identity Provider handling authentication and authorization.")
System_Ext(Mainframe_COBOL_DB2_System, "Mainframe COBOL/DB2 System", "On-premises system of record.")

System_Boundary(Regional_Insurance_Claims_Platform, "Regional Insurance Claims Platform") {
    Container(Customer_Portal_SPA, "Customer Portal SPA", "Azure Static Web Apps", "Frontend application for customers and brokers.")
    Container(Adjuster_Web_App, "Adjuster Web App", "Azure App Service", "Frontend application for claims adjusters.")
    Container(Claims_Core_API, "Claims Core API", "Azure Container Apps", "Microservices container runtime for core claim processing and gradual claim type migration.")
    Container(Integration_Gateway_ACL, "Integration Gateway / ACL", "Azure API Management / Azure Functions", "Anti-Corruption Layer to protect the mainframe from frequent interface changes.")
    Container(Azure_Cache_for_Redis, "Azure Cache for Redis", "Azure Cache for Redis", "Distributed caching to achieve sub-2-second adjuster screen loads.")
    Container(Azure_Service_Bus, "Azure Service Bus", "Azure Service Bus", "Reliable messaging with dead-letter queues to ensure zero data loss during hybrid sync.")
    ContainerDb(Azure_Cosmos_DB_SQL_Database, "Azure Cosmos DB / SQL Database", "Azure Cosmos DB / SQL Database", "Modern persistence tier for newly migrated claim types.")
}

Rel(Customer_Broker, Customer_Portal_SPA, "Submits claims and interacts with portal", "HTTPS (R-01)")
Rel(Claims_Adjuster, Adjuster_Web_App, "Processes claims", "HTTPS (R-02)")
Rel(Customer_Portal_SPA, Claims_Core_API, "Requests claim data and processing", "HTTPS/REST")
Rel(Adjuster_Web_App, Claims_Core_API, "Requests adjuster workflows and data", "HTTPS/REST")
Rel(Claims_Core_API, Azure_Cosmos_DB_SQL_Database, "Reads and writes modern claim data", "TCP/TLS")
Rel(Claims_Core_API, Integration_Gateway_ACL, "Interfaces with legacy workflows", "HTTPS/gRPC")
Rel(Integration_Gateway_ACL, Mainframe_COBOL_DB2_System, "Syncs and retrieves legacy records", "IBM MQ / TN3270 / TCP")
Rel(Claims_Core_API, Azure_Service_Bus, "Publishes asynchronous messages", "AMQP (R-04)")
Rel(Adjuster_Web_App, Azure_Cache_for_Redis, "Caches data for fast screen loads", "TCP (R-05)")
Rel(Customer_Portal_SPA, Active_Directory_Azure_AD, "Authenticates users", "OIDC / OAuth2 (R-07)")
Rel(Adjuster_Web_App, Active_Directory_Azure_AD, "Authenticates users", "OIDC / OAuth2 (R-07)")
Rel(Claims_Core_API, Active_Directory_Azure_AD, "Authenticates requests", "OIDC / OAuth2 (R-07)")

@enduml