@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Insurance Claims Modernization

Person(Customer, "Customer", "External users who submit online claims.")
Person(Broker, "Broker", "External users who submit and manage claims on behalf of customers.")
Person(ClaimsAdjuster, "Claims Adjuster", "Internal users who manage claims and review details.")

System_Ext(ActiveDirectoryAzureAD, "Active Directory / Azure AD", "Identity provider handling Single Sign-On and authentication.")
System_Ext(MainframeCOBOLDB2System, "Mainframe COBOL/DB2 System", "Legacy 30-year-old on-premise claims platform and system of record.")

System_Boundary(InsuranceClaimsModernization, "Insurance Claims Modernization") {
    Container(WebApplicationContainer, "Web Application Container", "React / Node.js on Azure App Service", "Frontend interface supporting online claims submission and adjuster management.")
    Container(APIGatewayIntegrationContainer, "API Gateway / Integration Container", "Azure API Management", "Routes requests dynamically and acts as an anti-corruption layer protecting the mainframe.")
    Container(ClaimsCoreServiceContainer, "Claims Core Service Container", "Java / Spring Boot on Azure Container Apps", "Core processing service for claims and migration handling.")
    ContainerDb(DataCachingContainer, "Data & Caching Container", "Azure Cosmos DB + Redis", "Provides persistent storage and low-latency state caching for adjuster screens.")
    Container(MainframeAdapterContainer, "Mainframe Adapter Container", "Azure Service Bus with Dead Letter Queues", "Bridges asynchronous messaging with the on-premise mainframe during batch windows.")
    Container(Configuration, "Configuration", "Azure App Configuration", "Manages feature flags and dynamic routing configuration.")
}

Rel(Customer, WebApplicationContainer, "Interacts with web application for online claims submission", "HTTPS")
Rel(Broker, WebApplicationContainer, "Interacts with web application for online claims submission", "HTTPS")
Rel(ClaimsAdjuster, WebApplicationContainer, "Interacts with web application for adjuster management", "HTTPS")
Rel(ClaimsAdjuster, ActiveDirectoryAzureAD, "Authenticated via Single Sign-On", "OIDC / OAuth2")
Rel(WebApplicationContainer, APIGatewayIntegrationContainer, "Communicates requests to backend services", "HTTPS / REST")
Rel(APIGatewayIntegrationContainer, ClaimsCoreServiceContainer, "Routes requests dynamically", "HTTPS / REST")
Rel(APIGatewayIntegrationContainer, MainframeCOBOLDB2System, "Routes requests dynamically to legacy system", "TCP")
Rel(APIGatewayIntegrationContainer, Configuration, "Retrieves dynamic routing configurations", "HTTPS")
Rel(ClaimsCoreServiceContainer, DataCachingContainer, "Persists data and caches read models", "TCP/TLS")
Rel(MainframeAdapterContainer, MainframeCOBOLDB2System, "Bridges asynchronous messaging with on-premise mainframe during batch window", "AMQP / Batch Sync")

@enduml