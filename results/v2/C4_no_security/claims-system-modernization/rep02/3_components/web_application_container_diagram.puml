@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Web Application Container", "Web Application Container") {
    Component("React SPA Frontend", "React SPA Frontend", "React 18 & TypeScript, Azure Static Web Apps", "Static web hosting component serving the React SPA for customer and adjuster claim workflows.")
    Component("Node.js BFF", "Node.js BFF", "Node.js 20 LTS & Express, Azure App Service", "Backend-for-Frontend orchestration layer handling API requests and OAuth2 token validation.")
}

Rel("React SPA Frontend", "Node.js BFF", "Forwards API requests", "HTTPS / REST")

@enduml