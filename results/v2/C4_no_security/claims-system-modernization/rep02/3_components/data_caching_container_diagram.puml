@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data & Caching Container container

Container(Claims Core Service Container, "Claims Core Service Container", "Containerized Service", "External consumer interacting with the transactional store and read model cache.")

Container_Boundary("Data & Caching Container", "Data & Caching Container") {
    Component(Transactional Store Component, "Transactional Store Component", "Azure Cosmos DB (SQL API)", "Persists primary CRUD operations with strong session consistency and polymorphic schemas supporting incremental migration.")
    Component(Read Model Cache Component, "Read Model Cache Component", "Azure Cache for Redis", "Caches pre-aggregated claim views ensuring sub-2s latency.")
    Component(Audit & Reconciliation Log Component, "Audit & Reconciliation Log Component", "Cosmos DB Change Feed", "Tracks state mutations for rollbacks, automated state tracking, event-driven cache invalidation, and bi-directional mainframe reconciliation.")
    Component(Data Lifecycle & Compliance Worker, "Data Lifecycle & Compliance Worker", "Background processor", "Processes TTLs and archiving for data lifecycle and compliance.")
}

Rel(Claims Core Service Container, Transactional Store Component, "Persists primary CRUD operations", "TCP/TLS via Azure SDK")
Rel(Claims Core Service Container, Read Model Cache Component, "Fetches read projections for sub-2s loads", "TCP/TLS via Jedis")
Rel(Transactional Store Component, Audit & Reconciliation Log Component, "Tracks state mutations for rollbacks", "Internal async via Change Feed")

@enduml