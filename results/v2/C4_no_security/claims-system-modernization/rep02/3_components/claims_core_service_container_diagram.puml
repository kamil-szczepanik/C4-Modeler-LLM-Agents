@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Core Service Container container

Container_Boundary(claims_core_service_container, "Claims Core Service Container") {
    Component(ClaimOrchestrationComponent, "Claim Orchestration Component", "Spring State Machine", "Manages complex claim lifecycles asynchronously.")
    Component(MigrationRouterComponent, "Migration Router Component", "Java / Spring Boot with Resilience4j Circuit Breaker", "Routes claim traffic and protects against legacy mainframe outages during batch windows.")
    Component(DomainServiceComponents, "Domain Service Components", "Spring Data JPA", "Handles core domain logic and data persistence.")
    Component(AuditReconciliationComponent, "Audit & Reconciliation Component", "Spring Batch / Spring Integration", "Handles reliable asynchronous ledger checks, persists audit logs, and reconciles modern records against legacy batch exports.")
    Component(MainframeAdapterContainer, "Mainframe Adapter Container", "Azure Service Bus", "Interfaces with the mainframe system for unmigrated claim traffic and batch exports.")
    Component(DataCachingContainer, "Data & Caching Container", "Azure Cosmos DB + Redis", "Stores transactional data, read models, audit logs, and reconciliation state.")
}

Rel(MigrationRouterComponent, MainframeAdapterContainer, "Forwards unmigrated claim traffic", "AMQP / Azure Service Bus")
Rel(ClaimOrchestrationComponent, DataCachingContainer, "Reads/writes transactional data and read models", "TCP/TLS")
Rel(AuditReconciliationComponent, DataCachingContainer, "Persists audit logs and reconciliation state", "TCP/TLS")
Rel(AuditReconciliationComponent, MainframeAdapterContainer, "Reconciles modern records against legacy batch exports", "AMQP / REST")

@enduml