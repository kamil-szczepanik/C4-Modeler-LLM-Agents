@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Mainframe Adapter Container container

System_Ext(Mainframe_COBOL_DB2_System, "Mainframe COBOL/DB2 System", "Mainframe COBOL/DB2 System")

Container_Boundary(Mainframe_Adapter_Container, "Mainframe Adapter Container") {
    Component(Inbound_Message_Router, "Inbound Message Router", "Java / Azure Service Bus Listener", "Routes incoming messages from the Claims Core Service to appropriate mainframe queues.")
    Component(Batch_Window_Gatekeeper, "Batch Window Gatekeeper", "Java / Quartz Scheduler", "Controls the flow of transactions during designated mainframe batch windows.")
    Component(Mainframe_Connector_Client, "Mainframe Connector Client", "IBM MQ Client / TCP/IP", "Connects securely to the Mainframe COBOL/DB2 System via Azure ExpressRoute.")
    Component(DLQ_Management_Service, "DLQ Management Service", "Azure Service Bus Dead Letter Queue Handler", "Manages failed message processing, error handling, and message retries.")
    Component(Audit_Compliance_Interceptor, "Audit & Compliance Interceptor", "OpenTelemetry / Java Interceptor", "Captures audit trails and compliance logs for all mainframe transactions.")
    Component(DLQ_Notification_Publisher, "DLQ Notification Publisher", "Azure Service Bus / Event Notification", "Publishes alerts when messages are routed to the dead letter queue.")
}

Rel(Inbound_Message_Router, Batch_Window_Gatekeeper, "Checks batch schedule constraints")
Rel(Batch_Window_Gatekeeper, Mainframe_Connector_Client, "Dispatches validated messages")
Rel(Mainframe_Connector_Client, Mainframe_COBOL_DB2_System, "Transmits messages via IBM MQ / TCP/IP", "IBM MQ / TCP/IP")
Rel(Inbound_Message_Router, DLQ_Management_Service, "Routes failed messages")
Rel(DLQ_Management_Service, DLQ_Notification_Publisher, "Triggers alerts for failed messages")
Rel(Inbound_Message_Router, Audit_Compliance_Interceptor, "Logs transaction metadata")

@enduml