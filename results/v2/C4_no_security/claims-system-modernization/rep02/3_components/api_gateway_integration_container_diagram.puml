@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway / Integration Container container

Container_Boundary("API Gateway / Integration Container", "API Gateway / Integration Container") {
    Component("API Router and Policy Enforcer", "API Router and Policy Enforcer", "Azure API Management", "Enforces routing, security, and resilience policies, directing traffic between web frontend, cloud services, and legacy systems.")
    Component("Legacy Protocol Adapter", "Legacy Protocol Adapter", "Azure Service Bus with Dead Letter Queues", "Handles asynchronous message offloading and communication with the Mainframe COBOL/DB2 System.")
    Component("Configuration Manager", "Configuration Manager", "Azure App Configuration", "Stores dynamic routing rules to support rapid fallback to the mainframe.")
}

Rel("API Router and Policy Enforcer", "Legacy Protocol Adapter", "Offloads asynchronous messages via AMQP / HTTPS", "AMQP / HTTPS")
Rel("API Router and Policy Enforcer", "Configuration Manager", "Fetches dynamic routing rules via HTTPS", "HTTPS")

@enduml