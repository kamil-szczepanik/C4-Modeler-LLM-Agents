@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Configuration container

Container_Boundary(configuration_container, "Configuration") {
    Component(ConfigurationManager, "Configuration Manager", "Persona / ITSM Interface", "Triggers rollback and toggle requests.")
    Component(FeatureFlagStore, "Feature Flag Store", "Azure App Configuration Native Feature Manager", "Manages feature flags for seamless transitions and rapid rollbacks.")
    Component(DynamicRoutingStore, "Dynamic Routing Store", "Azure App Configuration Key-Value Store", "Manages dynamic routing rules to ensure seamless transitions.")
    Component(AuditComplianceLogger, "Audit & Compliance Logger", "Azure Monitor / Log Analytics", "Provides audit logging and alerting for synchronization drift and changes.")
    Component(ConfigurationSyncAgent, "Configuration Sync Agent", "Azure DevOps Pipeline / Azure Functions", "Automated synchronization and deployment of Git-backed configuration changes.")
    Component(GitRepository, "Git Repository", "Source Control for IaC", "Version control for Infrastructure as Code (IaC) and audit trails.")
}

System_Ext(ITSMTool, "ITSM Tool", "External ITSM system for change management and approvals.")
System_Ext(APIGateway, "API Gateway / Integration Container", "External integration gateway.")
System_Ext(ClaimsCoreService, "Claims Core Service Container", "External claims core microservice.")

Rel(ConfigurationManager, ITSMTool, "Triggers rollback and toggle requests", "HTTPS")
Rel(ITSMTool, GitRepository, "Initiates configuration updates upon approval", "Webhook / REST")
Rel(ConfigurationSyncAgent, FeatureFlagStore, "Applies validated configuration batches", "Azure App Configuration SDK, HTTPS")
Rel(ConfigurationSyncAgent, DynamicRoutingStore, "Applies validated configuration batches", "Azure App Configuration SDK, HTTPS")
Rel(APIGateway, DynamicRoutingStore, "Fetches routing rules and polls updates", "HTTPS, SDK")
Rel(ClaimsCoreService, FeatureFlagStore, "Evaluates feature flags locally with polling and caching", "HTTPS, SDK")

@enduml