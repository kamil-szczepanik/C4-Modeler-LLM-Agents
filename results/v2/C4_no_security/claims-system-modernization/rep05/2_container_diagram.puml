@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Modern Claims Platform

Person(EndCustomersBrokers, "End Customers & Brokers", "External users submitting online claims via the web interface.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal users managing claims in the new web application.")

System_Ext(LegacyMainframe, "Legacy Mainframe", "COBOL/DB2 on-prem system acting as the system of record.")
System_Ext(CorporateActiveDirectory, "Corporate Active Directory", "On-premises identity provider enforcing SSO.")

System_Boundary(ModernClaimsPlatform, "Modern Claims Platform") {
    Container(ClaimsWebApplication, "Claims Web Application", "React, Azure Static Web Apps", "React Single Page Application for sub-2-second UI responsiveness.")
    Container(APIGateway, "API Gateway", "Azure API Management", "Managed entry point enforcing SSO via Corporate Active Directory.")
    Container(ClaimsCoreService, "Claims Core Service", ".NET 8 / C#, Azure Kubernetes Service (AKS)", "Implements domain logic, Inbox/Outbox pattern, and Anti-Corruption Layer (ACL).")
    Container(IntegrationSyncEngine, "Integration & Sync Engine", "Azure Service Bus", "Bridging modern event flows with the legacy batch window.")
    ContainerDb(ModernClaimsDatabase, "Modern Claims Database", "Azure SQL Database / Cosmos DB", "Providing ACID compliance and dual-run state persistence.")
}

Rel(EndCustomersBrokers, ClaimsWebApplication, "Submit online claims", "HTTPS")
Rel(ClaimsAdjusters, ClaimsWebApplication, "Manage claims in the new web application", "HTTPS")
Rel(ClaimsWebApplication, APIGateway, "Communicates with API Gateway", "REST/HTTPS")
Rel(APIGateway, ClaimsCoreService, "Routes requests to the Claims Core Service", "Internal REST/gRPC")
Rel(ClaimsCoreService, ModernClaimsDatabase, "Persists data and state", "SQL/Cosmos protocols")
Rel(ClaimsCoreService, IntegrationSyncEngine, "Publishes asynchronous events", "AMQP")
Rel(IntegrationSyncEngine, LegacyMainframe, "Synchronizes data via batch file transfers and secure file protocols", "SFTP / Batch File Transfers")
Rel(APIGateway, CorporateActiveDirectory, "Enforces SSO integration", "OpenID Connect / OAuth 2.0")

@enduml