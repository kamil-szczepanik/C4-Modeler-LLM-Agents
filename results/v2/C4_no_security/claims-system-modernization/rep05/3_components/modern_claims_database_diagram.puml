@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Modern Claims Database container

Container_Boundary(modern_claims_database, "Modern Claims Database") {
    Component(relational_data_store, "Relational Data Store", "Azure SQL Database", "Provides strict ACID guarantees, relational foreign keys, and matches the legacy DB2 schema to satisfy consistency requirements.")
    Component(audit_trail_store, "Audit Trail Store", "Azure SQL Temporal Tables", "Automatically captures tamper-evident row history for compliance and audit requirements without custom trigger maintenance.")
}

Rel(relational_data_store, audit_trail_store, "Maintains historical row versions")

@enduml