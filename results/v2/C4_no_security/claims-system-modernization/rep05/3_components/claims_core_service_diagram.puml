@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(claims_core_service, "Claims Core Service") {
    Component(Routing_Orchestration_Component, "Routing & Orchestration Component", ".NET 8 / C# / Azure App Configuration", "Evaluates dynamic flags to route requests.")
    Component(Claim_Domain_Model_Component, "Claim Domain Model Component", ".NET 8 / C# / DDD", "Implements core business logic for migrated claim types via DDD.")
    Component(ACL_Component, "ACL Component", ".NET 8 / C#", "Anti-Corruption Layer translating modern commands to legacy formats.")
    Component(Outbox_Processor_Component, "Outbox Processor Component", ".NET 8 / C# / Entity Framework Core", "Ensures transactional consistency for event publishing.")
    Component(Claim_Status_Audit_Projection_Component, "Claim Status & Audit Projection Component", ".NET 8 / C# / CQRS", "Aggregates state changes into read-optimized models using CQRS.")
}

Rel(Routing_Orchestration_Component, Claim_Domain_Model_Component, "Routes requests to business logic")
Rel(Claim_Domain_Model_Component, Outbox_Processor_Component, "Triggers transactional outbox events")
Rel(Claim_Domain_Model_Component, ACL_Component, "Forwards requests to legacy when needed")
Rel(Outbox_Processor_Component, Claim_Status_Audit_Projection_Component, "Updates projections via events")

@enduml