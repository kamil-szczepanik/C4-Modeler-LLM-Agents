@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Developer_Portal, "Developer Portal", "Azure API Management Built-in Portal", "Brokers authenticate for API access and provide developer onboarding.")
    Component(JWT_Validation_Policy, "JWT Validation Policy", "API Management Policy", "Validates incoming JSON Web Tokens for authentication.")
    Component(Dynamic_Routing_Policy_Engine, "Dynamic Routing Policy Engine", "API Management Policy / C#", "Evaluates claim-type routing state and directs traffic to modern or legacy systems.")
    Component(App_Config_Lookup_Component, "App Config Lookup Component", "API Management Policy Extension", "Interfaces with Azure App Configuration to fetch routing rules and feature flags.")
    Component(Rate_Limiting, "Rate Limiting", "API Management Built-in Policy", "Protects backend systems by limiting request rates.")
}

Rel(Developer_Portal, JWT_Validation_Policy, "Brokers authenticate for API access", "OAuth 2.0 / OpenID Connect")
Rel(Dynamic_Routing_Policy_Engine, App_Config_Lookup_Component, "Fetches claim-type routing state", "REST/HTTPS with 60s token-aware caching")

@enduml