@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Web Application container

Container_Boundary("Claims Web Application", "Claims Web Application") {
    Component("Claim Intake Wizard", "Claim Intake Wizard", "React Component Bundle", "Allows customers and brokers to submit claims and interact with the intake process.")
    Component("Adjuster Workspace", "Adjuster Workspace", "React Component Bundle", "Provides tools for claims adjusters to handle claims and monitor sync status.")
    Component("Broker Portal Module", "Broker Portal Module", "React Component Bundle", "Enables brokers to manage portfolios and submit claims.")
    Component("Authentication Component", "Authentication Component", "MSAL / Azure AD Wrapper", "Handles security protocol, OIDC/OAuth2 single sign-on.")
    Component("API Client", "API Client", "Axios / Fetch Wrapper", "Communicates with the backend API Gateway via REST/HTTPS.")
    Component("Offline State Manager", "Offline State Manager", "IndexedDB Wrapper", "Persists claims drafts locally in the browser for offline capabilities.")
    Component("Sync Status Monitor", "Sync Status Monitor", "WebSocket / Polling Client", "Displays backend replication state and monitors synchronization.")
    Component("Telemetry & Feature Flag Provider", "Telemetry & Feature Flag Provider", "App Insights & Azure App Config SDK", "Provides real-user monitoring and fetches runtime feature flags.")
    Component("Client-Side Error Boundaries", "Client-Side Error Boundaries", "React Error Boundary", "Captures and handles runtime UI errors gracefully.")
}

System_Ext("API Gateway", "API Gateway", "External API Gateway system")
System_Ext("Azure App Configuration", "Azure App Configuration", "External Azure App Configuration service")

Rel("Claim Intake Wizard", "Offline State Manager", "Persists drafts", "IndexedDB/Local Storage")
Rel("Adjuster Workspace", "Sync Status Monitor", "Displays backend replication state", "Internal State")
Rel("Claims Web Application", "API Gateway", "Communicates via API client", "REST/HTTPS")
Rel("Telemetry & Feature Flag Provider", "Azure App Configuration", "Fetches runtime feature flags", "HTTPS")

@enduml