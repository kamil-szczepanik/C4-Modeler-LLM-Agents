@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(End_Customers_Brokers, "End Customers & Brokers", "Web users submitting claims via R-01.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal users handling claims via R-02/R-05.")
Person(Migration_Operations_Team, "Migration & Operations Team", "Managing hybrid coexistence and rollbacks.")
Person(Compliance_Audit_Officers, "Compliance & Audit Officers", "Tracing transactions across systems.")

System(Modern_Claims_Platform, "Modern Claims Platform", "A modern hybrid cloud platform gradually replacing a 30-year-old mainframe claims system, ensuring zero data loss and uninterrupted operations during a 3-year migration.")

System_Ext(Legacy_Mainframe, "Legacy Mainframe", "On-premises COBOL/DB2 system of record.")
System_Ext(Corporate_Active_Directory, "Corporate Active Directory", "On-premises identity provider.")
System_Ext(Observability_Platform, "Observability Platform", "Azure Monitor / App Insights for distributed tracing.")

Rel(End_Customers_Brokers, Modern_Claims_Platform, "Interact with Modern Claims Platform to submit claims", "HTTPS/TLS")
Rel(Claims_Adjusters, Modern_Claims_Platform, "Interact with Modern Claims Platform to handle claims", "HTTPS/TLS")
Rel(Modern_Claims_Platform, Corporate_Active_Directory, "Authenticates against Corporate Active Directory", "OpenID Connect / OAuth 2.0")
Rel(Modern_Claims_Platform, Legacy_Mainframe, "Synchronizes data via SFTP and restricted API gateway", "SFTP / REST API")
Rel(Modern_Claims_Platform, Observability_Platform, "Streams telemetry for end-to-end distributed tracing", "Azure Monitor / App Insights")

@enduml