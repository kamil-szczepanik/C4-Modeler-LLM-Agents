@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Core Processing Service container

Container_Boundary(claims_core_processing_service, "Claims Core Processing Service") {
    Component(ClaimsWorkflowOrchestrator, "Claims Workflow Orchestrator", "MassTransit State Machine", "Manages sagas and state machines to guarantee consistency and orchestrate the claims workflow.")
    Component(ClaimDomainModel, "Claim Domain Model", ".NET Core", "Encapsulates the core business logic and domain model for claims.")
    Component(MainframeSyncCoordinator, "Mainframe Sync Coordinator", ".NET Core with Polly", "Syncs dual-writes and implements circuit breakers for resilient mainframe integration.")
    Component(PayoutLedgerEngine, "Payout & Ledger Engine", ".NET Core", "Initiates and processes financial disbursements.")
    Component(AzureContainerAppsACA, "Azure Container Apps (ACA)", "Azure Container Apps with KEDA", "Hosts the event-driven microservices with event-driven scaling.")
    Component(AzureServiceBuswithDLQ, "Azure Service Bus with DLQ", "Azure Service Bus", "Dispatches and manages domain events with dead-letter queues.")
    Component(AzureSQLDatabase, "Azure SQL Database", "Azure SQL Database", "Provides reliable relational persistence and audit trails.")
}

Rel(ClaimsWorkflowOrchestrator, ClaimDomainModel, "Invokes", "In-process")
Rel(ClaimsWorkflowOrchestrator, PayoutLedgerEngine, "Initiates disbursements", "In-process")
Rel(ClaimsWorkflowOrchestrator, AzureSQLDatabase, "Persists state", "Entity Framework Core / T-SQL")
Rel(ClaimsWorkflowOrchestrator, AzureServiceBuswithDLQ, "Dispatches domain events", "AMQP")
Rel(MainframeSyncCoordinator, MainframeIntegrationAdapter, "Syncs dual-writes", "gRPC/HTTPS")

@enduml