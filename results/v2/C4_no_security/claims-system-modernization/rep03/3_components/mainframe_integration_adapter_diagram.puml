@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Mainframe Integration Adapter container

System_Ext(legacy_mainframe, "Legacy Mainframe", "COBOL/DB2 with IBM MQ/CICS", "Legacy mainframe system")
System_Ext(azure_app_config, "Azure App Configuration", "Azure App Configuration", "Externalized configuration store")

Container_Boundary(mainframe_integration_adapter, "Mainframe Integration Adapter") {
    Component(adapter_api_controller, "Adapter API Controller", ".NET 8 / Web API", "Handles incoming API requests and routes integration logic.")
    Component(mainframe_broker_client, "Mainframe Broker Client", ".NET 8 with Polly circuit breakers", "Communicates with the legacy mainframe and enforces batch-window protocols.")
    Component(routing_feature_flag_component, "Routing & Feature Flag Component", ".NET 8", "Manages routing and feature flags via Azure App Configuration for claim type rollbacks.")
}

Rel(adapter_api_controller, mainframe_broker_client, "Delegates mainframe requests", "gRPC/HTTPS")
Rel(mainframe_broker_client, legacy_mainframe, "Sends messages", "IBM MQ / CICS over TLS")
Rel(routing_feature_flag_component, azure_app_config, "Fetches configuration", "HTTPS")

@enduml