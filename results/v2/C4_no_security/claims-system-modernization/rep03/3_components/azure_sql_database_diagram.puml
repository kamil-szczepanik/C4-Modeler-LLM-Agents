@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure SQL Database container

Container_Ext(claims_core, "Claims Core Processing Service", "Microservice", "Reads and writes claim data")
Container_Ext(mainframe_adapter, "Mainframe Integration Adapter", "Integration Service", "Synchronizes state")
Container_Ext(reporting_tools, "Reporting / Compliance Tools", "Analytics", "Queries analytical data")
Container_Ext(blob_storage, "Azure Blob Storage", "Storage", "Archives historical claims")

Container_Boundary(azure_sql_database, "Azure SQL Database") {
    Component(claim_data_store, "Claim Data Store", "Extensible relational tables", "Provides transactional persistence and extensible relational tables for incrementally migrated claims.")
    Component(audit_security, "Audit & Security Subsystem", "Row-Level Security and Azure SQL Audit", "Enforces security policies and auditing at the row level.")
    Component(cdc, "Change Data Capture / CDC", "Row-level change emitter", "Emits row-level changes for synchronizing state with the mainframe integration adapter.")
    Component(partitioning_engine, "Partitioning & Retention Engine", "Sliding window table partitioning", "Manages sliding window table partitioning and archives historical claims to Azure Blob Storage.")
    Component(replica_routing, "Read-Only Replica Routing", "Secondary read endpoint", "Routes analytical queries to secondary read endpoints to protect critical performance constraints.")
}

Rel(claims_core, claim_data_store, "Reads and writes claim data", "T-SQL / TDS (TLS 1.3)")
Rel(mainframe_adapter, cdc, "Synchronizes state", "T-SQL / TDS Change Data Capture")
Rel(reporting_tools, replica_routing, "Queries analytical data", "Read-Only Replica T-SQL / TDS")
Rel(partitioning_engine, blob_storage, "Archives historical claims", "External Tables / Managed Backup")

@enduml