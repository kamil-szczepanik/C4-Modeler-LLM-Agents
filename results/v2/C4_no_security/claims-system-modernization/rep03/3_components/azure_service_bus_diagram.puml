@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Service Bus container

System_Boundary(azure_service_bus, "Azure Service Bus") {
    Component(Claims_Events_Topic, "Claims.Events Topic", "AMQP 1.0", "Publishes domain events with W3C trace context for the modern cloud platform.")
    Component(Mainframe_Outbox_Queue, "Mainframe.Outbox Queue", "AMQP 1.0 with FIFO sessions", "Consumes sync commands with FIFO ordering for mainframe integration.")
    Component(Dead_Letter_Queue_DLQ, "Dead-Letter Queue (DLQ)", "Azure Service Bus DLQ", "Stores poisoned messages for administrative review and reprocessing.")
}

Component(Claims_Core_Processing_Service, "Claims Core Processing Service", ".NET Core / C#", "External component interacting with the service bus.")
Component(Mainframe_Integration_Adapter, "Mainframe Integration Adapter", "Azure Functions", "External component interacting with the service bus.")
Component(DLQ_Reprocessing_Handler, "DLQ Reprocessing Handler", "Azure Function", "Handles poisoned messages for administrative review.")

Rel(Claims_Core_Processing_Service, Claims_Events_Topic, "Publishes domain events with W3C trace context", "AMQP 1.0")
Rel(Mainframe_Integration_Adapter, Mainframe_Outbox_Queue, "Consumes sync commands with FIFO ordering", "AMQP 1.0")
Rel(Dead_Letter_Queue_DLQ, DLQ_Reprocessing_Handler, "Forwards poisoned messages for administrative review", "AMQP / Event Grid")

@enduml