@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Adjuster Web Application container

Container_Boundary(adjuster_web_app, "Adjuster Web Application") {
    Component(Claim Workspace Router & State Manager, "Claim Workspace Router & State Manager", "React Context / Zustand", "Manages high-performance local UI state, routing, and optimistic updates for claims.")
    Component(Claim Details View Component, "Claim Details View Component", "React", "Provides responsive UI components for viewing claim details.")
    Component(Auth Guard Component, "Auth Guard Component", "MSAL.js", "Implements secure Single Sign-On and authentication via OAuth2/OpenID Connect.")
    Component(Inline Audit & Exception Flagging Component, "Inline Audit & Exception Flagging Component", "React with React Hook Form & Zod", "Ensures rigorous client-side validation for exception reports and audit logging.")
}

Rel(Claim Workspace Router & State Manager, Claim Details View Component, "Provides state and navigation")
Rel(Auth Guard Component, Claim Workspace Router & State Manager, "Secures access to")
Rel(Inline Audit & Exception Flagging Component, Claim Workspace Router & State Manager, "Integrates audit and exception data into")

@enduml