@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway / Backend-for-Frontend container

Person(Customer_and_Broker_Portal, "Customer & Broker Portal", "External portal for customers and brokers")
Person(Adjuster_Web_Application, "Adjuster Web Application", "External portal for claims adjusters")
System_Ext(Claims_Core_Processing_Service, "Claims Core Processing Service", "Core microservice for processing claims")
System_Ext(Mainframe_Integration_Adapter, "Mainframe Integration Adapter", "Adapter communicating with legacy backend")
System_Ext(Azure_Service_Bus, "Azure Service Bus", "Cloud messaging service for asynchronous events")
System_Ext(Azure_Application_Insights, "Azure Application Insights", "Cloud telemetry and analytics service")

Container_Boundary(api_gateway_bff, "API Gateway / Backend-for-Frontend") {
    Component(Authentication_and_Authorization_Component, "Authentication & Authorization Component", "Passport.js / OIDC", "Passport.js and OIDC validator for Azure AD tokens, implementing Single Sign-On integration with corporate Active Directory / Azure AD.")
    Component(Customer_BFF_Router_and_Aggregator, "Customer BFF Router & Aggregator", "NestJS", "NestJS controller handling lightweight customer and broker portals.")
    Component(Adjuster_BFF_Router_and_Aggregator, "Adjuster BFF Router & Aggregator", "NestJS", "NestJS controller providing parallel data fetching and caching for claims adjusters.")
    Component(Migration_Routing_Proxy, "Migration Routing Proxy", "NestJS Middleware / Interceptor", "NestJS middleware/interceptor dynamically routing claim types based on migration state.")
    Component(API_Composition_and_Data_Shaping_Service, "API Composition & Data Shaping Service", "RxJS", "RxJS-based service managing parallel data aggregation and partial-response fallbacks.")
    Component(Audit_Logging_and_Analytics_Component, "Audit Logging & Analytics Component", "NestJS Interceptor", "Interceptor emitting asynchronous telemetry to Azure Application Insights.")
}

Rel(Customer_and_Broker_Portal, Authentication_and_Authorization_Component, "Authenticates users", "HTTPS/OAuth2/OIDC")
Rel(Adjuster_Web_Application, Authentication_and_Authorization_Component, "Authenticates users", "HTTPS/OAuth2/OIDC")
Rel(Customer_BFF_Router_and_Aggregator, Claims_Core_Processing_Service, "Invokes core claims", "gRPC/HTTPS")
Rel(Adjuster_BFF_Router_and_Aggregator, Mainframe_Integration_Adapter, "Communicates with legacy backend", "gRPC/HTTPS")
Rel(Migration_Routing_Proxy, Azure_Service_Bus, "Publishes asynchronous events", "AMQP")
Rel(Audit_Logging_and_Analytics_Component, Azure_Application_Insights, "Dispatches telemetry", "HTTPS")

@enduml