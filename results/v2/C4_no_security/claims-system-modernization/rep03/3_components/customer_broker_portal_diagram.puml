@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Customer & Broker Portal container

Container_Boundary(customer_broker_portal, "Customer & Broker Portal") {
    Component(Claim_Submission_Controller, "Claim Submission Controller", "React Component", "Handles user input and validation for new claim submissions.")
    Component(Claim_Management_UI, "Claim Management UI", "React Component", "Allows customers and brokers to view and track existing claims.")
    Component(Authentication_Client, "Authentication Client", "OAuth2 / OpenID Connect Client", "Manages user login and session states via Azure AD.")
}

System_Ext(api_gateway, "API Gateway / BFF", "Node.js / NestJS API Gateway / BFF")
System_Ext(azure_ad, "Azure AD", "Insurer's Active Directory / Azure AD")

Rel(Claim_Submission_Controller, api_gateway, "Submits new claims", "HTTPS/REST")
Rel(Claim_Management_UI, api_gateway, "Fetches claim details", "HTTPS/REST")
Rel(Authentication_Client, azure_ad, "Authenticates users", "OAuth2/OpenID Connect")

@enduml