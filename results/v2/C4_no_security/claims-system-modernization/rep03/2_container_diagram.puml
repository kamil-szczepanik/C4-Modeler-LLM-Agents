@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for New Claims Platform

Person(Customers_Brokers, "Customers & Brokers", "External users submitting and managing claims via web portal.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal staff reviewing and processing claims via web application.")
System_Ext(Legacy_Mainframe, "Legacy Mainframe", "On-premise COBOL/DB2 system of record.")
System_Ext(Insurers_Active_Directory__Azure_AD, "Insurer's Active Directory / Azure AD", "Identity provider for authentication and authorization.")

System_Boundary(New_Claims_Platform, "New Claims Platform") {
    Container(Customer_Broker_Portal, "Customer & Broker Portal", "React SPA / Azure Static Web Apps", "Web interface for customers and brokers to submit and track claims.")
    Container(Adjuster_Web_Application, "Adjuster Web Application", "React SPA / Azure Static Web Apps", "Web interface for claims adjusters to process and manage claims.")
    Container(API_Gateway__Backend_for_Frontend, "API Gateway / Backend-for-Frontend", "Node.js / NestJS", "Routes API requests and aggregates data for frontend applications.")
    Container(Claims_Core_Processing_Service, "Claims Core Processing Service", ".NET Core / C# on Azure App Service", "Handles core business logic and claims processing workflows.")
    Container(Mainframe_Integration_Adapter, "Mainframe Integration Adapter", "Azure Functions / App Service", "Integrates with the legacy mainframe system respecting batch windows.")
    Container(Azure_Service_Bus, "Azure Service Bus", "Azure Service Bus with DLQ", "Handles asynchronous messaging and event distribution.")
    ContainerDb(Azure_SQL_Database, "Azure SQL Database", "Azure SQL Database", "Stores relational data for the new claims platform.")
}

Rel(Customers_Brokers, Customer_Broker_Portal, "Interacts with portal to submit and manage claims", "HTTPS/JSON")
Rel(Claims_Adjusters, Adjuster_Web_Application, "Interacts with web app to process claims", "HTTPS/JSON")
Rel(Customer_Broker_Portal, API_Gateway__Backend_for_Frontend, "Communicates with BFF for data and operations", "HTTPS/REST")
Rel(Adjuster_Web_Application, API_Gateway__Backend_for_Frontend, "Communicates with BFF for data and operations", "HTTPS/REST")
Rel(API_Gateway__Backend_for_Frontend, Claims_Core_Processing_Service, "Invokes core claims processing", "gRPC/HTTPS")
Rel(API_Gateway__Backend_for_Frontend, Mainframe_Integration_Adapter, "Communicates with mainframe adapter", "gRPC/HTTPS")
Rel(Claims_Core_Processing_Service, Azure_Service_Bus, "Publishes and consumes messages", "AMQP")
Rel(Mainframe_Integration_Adapter, Legacy_Mainframe, "Synchronizes data respecting batch window", "Legacy protocols (MQ/CICS)")
Rel(Customer_Broker_Portal, Insurers_Active_Directory__Azure_AD, "Authenticates users", "OAuth2/OpenID Connect")
Rel(Adjuster_Web_Application, Insurers_Active_Directory__Azure_AD, "Authenticates users", "OAuth2/OpenID Connect")
Rel(API_Gateway__Backend_for_Frontend, Insurers_Active_Directory__Azure_AD, "Authenticates tokens", "OAuth2/OpenID Connect")
Rel(Claims_Core_Processing_Service, Azure_SQL_Database, "Reads and writes claim data", "T-SQL / TDS")

@enduml