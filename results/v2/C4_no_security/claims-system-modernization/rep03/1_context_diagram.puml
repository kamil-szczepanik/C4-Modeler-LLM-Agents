@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers___Brokers, "Customers & Brokers", "External users submitting and managing claims via web or mobile UI.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal staff reviewing and processing claims via web app.")
Person(Business_Operations___Compliance_Officers, "Business Operations / Compliance Officers", "Internal stakeholders ensuring compliance and auditing.")

System(New_Claims_Platform, "New Claims Platform", "A hybrid cloud application modernizing a regional insurer's legacy COBOL/DB2 mainframe claims platform, enabling incremental claim-type migration with zero data loss.")

System_Ext(Legacy_Mainframe, "Legacy Mainframe", "On-premise COBOL/DB2 system-of-record operations.")
System_Ext(Insurer_s_Active_Directory___Azure_AD, "Insurer's Active Directory / Azure AD", "Identity provider for Single Sign-On.")
System_Ext(Payment_Gateway, "Payment Gateway", "Third-party SaaS for handling claim settlements.")
System_Ext(Notification_Service, "Notification Service", "Email/SMS provider for customer alerts.")

Rel(Customers___Brokers, New_Claims_Platform, "Submits and tracks claims", "HTTPS (Web/Mobile UI)")
Rel(Claims_Adjusters, New_Claims_Platform, "Processes and manages claims", "HTTPS (Web App < 2s load time)")
Rel(New_Claims_Platform, Legacy_Mainframe, "Synchronizes claim data", "Asynchronous messaging via Azure Service Bus and ESB")
Rel(New_Claims_Platform, Payment_Gateway, "Executes claim settlements", "HTTPS/REST")
Rel(New_Claims_Platform, Notification_Service, "Sends customer alerts", "HTTPS/API")
Rel(New_Claims_Platform, Insurer_s_Active_Directory___Azure_AD, "Authenticates users", "OIDC/OAuth2 (Single Sign-On)")

@enduml