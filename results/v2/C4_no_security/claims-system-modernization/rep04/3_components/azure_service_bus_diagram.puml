@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Azure_Service_Bus", "Azure Service Bus") {
    Component("Claims Topic", "Claims Topic", "Azure Service Bus Topic", "Publishes claims and handles sessions for the claims processing workflow.")
    Component("Migration Routing Filters", "Migration Routing Filters", "Service Bus Topic Filters", "Routes messages appropriately between modern engines and legacy integration mediators.")
    Component("Dead-Letter Subscriptions", "Dead-Letter Subscriptions", "Azure Service Bus DLQ", "Captures and isolates failed or poisoned messages for troubleshooting and reliability.")
}

Rel("Claims Topic", "Migration Routing Filters", "Evaluates message properties")
Rel("Migration Routing Filters", "Dead-Letter Subscriptions", "Routes unprocessable messages")
@enduml