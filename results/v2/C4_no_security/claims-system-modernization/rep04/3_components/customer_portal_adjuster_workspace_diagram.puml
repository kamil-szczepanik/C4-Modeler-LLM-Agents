@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Customer Portal & Adjuster Workspace container

System_Ext(Azure_API_Management, "Azure API Management", "API gateway")
System_Ext(Azure_App_Configuration, "Azure App Configuration", "Feature flag and toggle management")
System_Ext(Azure_Application_Insights, "Azure Application Insights", "APM and monitoring")

Container_Boundary(Customer_Portal_Adjuster_Workspace, "Customer Portal & Adjuster Workspace") {
    Component(Next_js_SSR___API_Routes_Component, "Next.js SSR / API Routes Component", "Next.js", "Combines React frontend and server-side rendering for <2s adjuster screen loads and acts as a BFF layer.")
    Component(Claim_Type_Feature_Flags_Component, "Claim Type Feature Flags Component", "Azure App Configuration", "Dynamic UI routing component that fetches migration metadata for instant claim type toggling and mainframe fallback.")
    Component(OpenTelemetry_Integration_Component, "OpenTelemetry Integration Component", "OpenTelemetry", "Provides distributed tracing to isolate legacy mainframe latency.")
}

Rel(Next_js_SSR___API_Routes_Component, Azure_API_Management, "Forwards domain requests", "HTTPS / REST")
Rel(Claim_Type_Feature_Flags_Component, Azure_App_Configuration, "Fetches migration metadata", "HTTPS / REST")
Rel(Next_js_SSR___API_Routes_Component, Azure_Application_Insights, "Exports telemetry and tracing data", "OpenTelemetry protocol")

@enduml