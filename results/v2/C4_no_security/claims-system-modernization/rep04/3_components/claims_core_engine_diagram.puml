@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(claims_core_engine, "Claims Core Engine") {
    Component(ClaimOrchestrator, "Claim Orchestrator", "Spring State Machine", "Manages complex claim lifecycles across mixed states.")
    Component(FeatureRouterComponent, "Feature Router Component", "Azure App Configuration", "Externalizes feature flags for business-driven rollbacks.")
    Component(SynchronizationReconciliationAdapter, "Synchronization & Reconciliation Adapter", "Java Spring Boot", "Handles data synchronization and reconciliation.")
    Component(DataAccessFacade, "Data Access Facade", "Spring Data JPA", "Reads and writes claim state to the persistence layer.")
    Component(ResilienceCachingProxy, "Resilience & Caching Proxy", "Resilience4j", "Implements circuit breakers to isolate legacy mainframe latency.")
    Component(TelemetryInterceptor, "Telemetry Interceptor", "OpenTelemetry", "Provides distributed tracing across hybrid infrastructure.")
}

Rel(ClaimOrchestrator, DataAccessFacade, "Persists claim state changes")
Rel(FeatureRouterComponent, ClaimOrchestrator, "Controls feature flags for claim processing")
Rel(ResilienceCachingProxy, SynchronizationReconciliationAdapter, "Protects communication with external systems")
Rel(TelemetryInterceptor, ClaimOrchestrator, "Traces execution flow")

@enduml