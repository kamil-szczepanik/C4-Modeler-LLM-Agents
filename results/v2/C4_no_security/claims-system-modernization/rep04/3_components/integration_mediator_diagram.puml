@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Mediator container

System_Ext(Claims_Core_Engine, "Claims Core Engine", "External system sending domain events.")
System_Ext(Legacy_Mainframe, "Legacy Mainframe", "On-premise mainframe handling COBOL transactions.")
System_Ext(Migration_Operations_Dashboard, "Migration Operations Dashboard", "Dashboard for monitoring and operations.")

Container_Boundary(Integration_Mediator, "Integration Mediator") {
    Component(Routing_Router_Component, "Routing Router Component", "Azure Logic Apps", "Routes domain events from the Claims Core Engine using serverless event routing.")
    Component(Circuit_Breaker_Retry_Policy_Component, "Circuit Breaker & Retry Policy Component", "Azure Function middleware", "Handles throttled transformation and provides persistent exponential backpressure.")
    Component(Copybook_Mapper_Component, "Copybook Mapper Component", "Azure Functions, Node.js/TypeScript", "Performs JSON-to-COBOL copybook mapping for mainframe transactions.")
    Component(Dead_Letter_Handler_Component, "Dead-Letter Handler Component", "Azure Functions & Azure Storage Queue", "Manages failed messages and enriches business exceptions.")
}

Rel(Claims_Core_Engine, Routing_Router_Component, "Domain Events", "HTTP/REST or AMQP")
Rel(Routing_Router_Component, Circuit_Breaker_Retry_Policy_Component, "Validated Payload", "HTTP")
Rel(Circuit_Breaker_Retry_Policy_Component, Copybook_Mapper_Component, "Throttled Transformation", "Internal Function Call")
Rel(Copybook_Mapper_Component, Legacy_Mainframe, "COBOL Transaction", "TCP/MQ via JSON-to-COBOL copybook mapping")
Rel(Dead_Letter_Handler_Component, Migration_Operations_Dashboard, "Enriched Business Exception", "REST/WebSockets with OpenTelemetry correlation ID")

@enduml