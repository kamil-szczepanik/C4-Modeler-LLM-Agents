@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Polyglot Persistence Layer container

Container_Boundary(polyglot_persistence_layer, "Polyglot Persistence Layer") {
    Component(DocumentStoreAzureCosmosDB, "Document Store (Azure Cosmos DB)", "Azure Cosmos DB", "Provides schema flexibility for migrating disparate claim types.")
    Component(RelationalStoreAzurePostgreSQL, "Relational Store (Azure PostgreSQL)", "Azure PostgreSQL", "Delivers strong transactional consistency for core claims data.")
    Component(ManagedCDCAuditStreamerAzureEventHubs, "Managed CDC & Audit Streamer (Azure Event Hubs)", "Azure Event Hubs", "Powers fully managed native change data capture (CDC) to minimize operational toil and ensure zero data loss.")
    Component(ClaimsCoreEngine, "Claims Core Engine", "Cosmos SDK / JDBC", "Interacts with document and relational stores for CRUD and transactional operations.")
    Component(ReconciliationServiceAuditSystem, "Reconciliation Service & Audit System", "AMQP / HTTPS", "Consumes audit logs from the audit streamer for reconciliation.")
    Component(MigrationOperationsDashboard, "Migration Operations Dashboard", "WebSockets / HTTPS", "Provides real-time tracking of the migration.")
}

Rel(ClaimsCoreEngine, DocumentStoreAzureCosmosDB, "HTTPS/TCP via Cosmos SDK for CRUD operations", "HTTPS/TCP")
Rel(ClaimsCoreEngine, RelationalStoreAzurePostgreSQL, "TCP/IP via JDBC for transactional consistency", "TCP/IP")
Rel(DocumentStoreAzureCosmosDB, ManagedCDCAuditStreamerAzureEventHubs, "Native change streams", "Native")
Rel(RelationalStoreAzurePostgreSQL, ManagedCDCAuditStreamerAzureEventHubs, "Native change streams", "Native")
Rel(ManagedCDCAuditStreamerAzureEventHubs, ReconciliationServiceAuditSystem, "AMQP/HTTPS for audit logging", "AMQP/HTTPS")
Rel(ManagedCDCAuditStreamerAzureEventHubs, MigrationOperationsDashboard, "WebSockets/HTTPS for real-time tracking", "WebSockets/HTTPS")

@enduml