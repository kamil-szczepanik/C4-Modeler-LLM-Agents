@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Migration Operations Dashboard container

Person(MigrationLeadsAndOperationsManagers, "Migration Leads and Operations Managers", "Primary users who monitor migration progress and discrepancy alerts.")

System_Ext(PolyglotPersistenceLayer, "Polyglot Persistence Layer", "External persistence layer providing real-time updates via Change Data Capture (CDC).")

Container_Boundary(MigrationOperationsDashboard, "Migration Operations Dashboard") {
    Component(DashboardUI, "Dashboard UI", "React SPA", "Provides real-time monitoring and discrepancy detection interface.")
    Component(DashboardBFFAPI, "Dashboard BFF / API", "Node.js/Express", "Fetches aggregated metrics and audit logs for the UI.")
    Component(ReconciliationProcessor, "Reconciliation Processor", "Python/Pandas", "Performs powerful data validation capabilities for cross-system comparisons.")
    Component(ComplianceAuditComponent, "Compliance & Audit Component", "Node.js / Serverless", "Handles compliance and audit tracking functions.")
    Component(OperationsDatastore, "Operations Datastore", "Azure PostgreSQL", "Ensures robust relational integrity, audit tracking, and Row-Level Security.")
    Component(AsynchronousBatchStagingQueue, "Asynchronous Batch Staging Queue", "Azure Blob Storage", "Buffers heavy mainframe batch extracts during the batch window.")
}

Rel(MigrationLeadsAndOperationsManagers, DashboardUI, "Monitors migration progress and discrepancy alerts", "HTTPS/WSS")
Rel(DashboardUI, DashboardBFFAPI, "Fetches aggregated metrics and audit logs", "HTTPS/REST/GraphQL")
Rel(DashboardBFFAPI, OperationsDatastore, "Queries audit logs and discrepancy states", "SQL/TLS")
Rel(ReconciliationProcessor, OperationsDatastore, "Persists audit logs and discrepancy states", "SQL/TLS")
Rel(ReconciliationProcessor, AsynchronousBatchStagingQueue, "Buffers mainframe batch dumps", "Azure Blob SDK/HTTPS")
Rel(PolyglotPersistenceLayer, ReconciliationProcessor, "Streams real-time updates", "Change Data Capture (CDC)")

@enduml