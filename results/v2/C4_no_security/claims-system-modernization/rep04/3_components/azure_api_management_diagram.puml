@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(azure_api_management, "Azure API Management") {
    Component(Token_Validator_Component, "Token Validator Component", "APIM Policy (OAuth2/OIDC)", "Validates incoming OAuth2 and OIDC tokens against the Active Directory / Identity Provider.")
    Component(Dynamic_Routing_Policy_Engine, "Dynamic Routing Policy Engine", "APIM Policy Fragments & Named Values", "Enables dynamic path-based routing and rapid rollbacks using rules fetched from Azure App Configuration.")
    Component(Transformation___Header_Injection_Component, "Transformation & Header Injection Component", "APIM Policies", "Handles data transformation and header injection for requests passing through the gateway.")
}

Rel(Token_Validator_Component, Dynamic_Routing_Policy_Engine, "Passes validated security context to", "")
Rel(Dynamic_Routing_Policy_Engine, Transformation___Header_Injection_Component, "Forwards routed requests to", "")

@enduml