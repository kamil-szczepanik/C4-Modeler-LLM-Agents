@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(End Customers & Brokers, "End Customers & Brokers", "Users who submit and track claims via web or mobile UI.")
Person(Claims Adjusters, "Claims Adjusters", "Internal staff who manage and process claims with a sub-second web experience.")

System(New Claims Platform, "New Claims Platform", "Modernized claims platform operating on Azure West Europe PaaS, gradually migrating claim types while the COBOL/DB2 mainframe remains the system of record.")

System_Ext(Legacy Mainframe, "Legacy Mainframe", "On-premise COBOL/DB2 system of record handling batch windows and core processing.")
System_Ext(Enterprise Messaging Queue, "Enterprise Messaging Queue", "Anti-Corruption Layer providing asynchronous messaging and buffering to protect mainframe connection pools.")
System_Ext(Active Directory / Identity Provider, "Active Directory / Identity Provider", "Provides authentication and single sign-on services.")
System_Ext(Reconciliation Service & Audit System, "Reconciliation Service & Audit System", "Ensures data integrity and tracks audit logs during the migration.")

Rel(End Customers & Brokers, New Claims Platform, "Submit and track claims", "HTTPS via Web/Mobile UI")
Rel(Claims Adjusters, New Claims Platform, "Process and manage claims", "HTTPS")
Rel(New Claims Platform, Enterprise Messaging Queue, "Asynchronous communication and buffering", "Enterprise Messaging Queue / DLQ")
Rel(Enterprise Messaging Queue, Legacy Mainframe, "Relays messages to and from the mainframe system of record", "Asynchronous messaging (Anti-Corruption Layer)")
Rel(New Claims Platform, Active Directory / Identity Provider, "Authenticates users for single sign-on", "OpenID Connect / SAML over HTTPS")

@enduml