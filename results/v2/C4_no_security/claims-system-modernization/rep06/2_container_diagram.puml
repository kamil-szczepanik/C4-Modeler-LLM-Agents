@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Insurance Claims Modernization

Person(Policyholders, "Policyholders", "Users who submit claims and interact with the customer portal.")
Person(Insurance_Brokers, "Insurance Brokers", "Users who interact with the customer portal on behalf of policyholders.")
Person(Claims_Adjusters, "Claims Adjusters", "Users who manage and process claims within the adjuster workspace.")
Person(Operations_Managers, "Operations Managers", "Users who monitor business operations via the dashboard.")

System_Ext(COBOL_DB2_Mainframe, "COBOL/DB2 Mainframe", "On-premises system of record maintaining legacy data consistency.")
System_Ext(Corporate_Active_Directory, "Corporate Active Directory", "Identity provider used for single sign-on authentication.")
System_Ext(Audit___Compliance_Archive, "Audit & Compliance Archive", "External archive for compliance and audit retention.")

System_Boundary(Insurance_Claims_Modernization, "Insurance Claims Modernization") {
    Container(Azure_API_Management, "Azure API Management", "Azure API Management", "API Gateway that routes traffic to frontends and microservices.")
    Container(Customer_Portal___Adjuster_Workspace_SPAs, "Customer Portal & Adjuster Workspace SPAs", "Azure Static Web Apps", "Frontend Single Page Applications for policyholders, brokers, and claims adjusters.")
    Container(Business_Operations_Dashboard_SPA, "Business Operations Dashboard SPA", "Azure Static Web Apps", "Frontend Single Page Application for operations managers.")
    Container(Claims_Processing_Core___Integration_Anti_Corruption_Layer, "Claims Processing Core & Integration/Anti-Corruption Layer", "Java / Spring Boot on Azure Container Apps", "Microservices responsible for claims business logic and interfacing with the legacy mainframe.")
    ContainerDb(Azure_SQL_Database, "Azure SQL Database", "Azure SQL Database", "Transactional database storing state and routing information.")
    Container(Azure_Service_Bus, "Azure Service Bus", "Azure Service Bus", "Message broker for asynchronous decoupling between services.")
}

Rel(Policyholders, Azure_API_Management, "Interacts with the customer portal via HTTPS/TLS", "HTTPS/TLS")
Rel(Insurance_Brokers, Azure_API_Management, "Interacts with the customer portal via HTTPS/TLS", "HTTPS/TLS")
Rel(Claims_Adjusters, Azure_API_Management, "Interacts with the adjuster workspace via HTTPS/TLS", "HTTPS/TLS")
Rel(Operations_Managers, Azure_API_Management, "Interacts with the business operations dashboard via HTTPS/TLS", "HTTPS/TLS")
Rel(Azure_API_Management, Corporate_Active_Directory, "Integrates for single sign-on", "OpenID Connect / OAuth2")
Rel(Azure_API_Management, Customer_Portal___Adjuster_Workspace_SPAs, "Routes traffic to frontends", "HTTPS")
Rel(Azure_API_Management, Business_Operations_Dashboard_SPA, "Routes traffic to dashboard frontend", "HTTPS")
Rel(Azure_API_Management, Claims_Processing_Core___Integration_Anti_Corruption_Layer, "Routes API requests to microservices", "HTTPS")
Rel(Claims_Processing_Core___Integration_Anti_Corruption_Layer, Azure_Service_Bus, "Communicates asynchronously using messages", "AMQP / Azure Service Bus")
Rel(Claims_Processing_Core___Integration_Anti_Corruption_Layer, COBOL_DB2_Mainframe, "Connects securely to the on-premise system of record", "Site-to-Site VPN / Azure ExpressRoute")
Rel(Claims_Processing_Core___Integration_Anti_Corruption_Layer, Azure_SQL_Database, "Reads and writes transactional state", "JDBC / TLS")
Rel(Claims_Processing_Core___Integration_Anti_Corruption_Layer, Audit___Compliance_Archive, "Archives audit and compliance logs", "HTTPS")

@enduml