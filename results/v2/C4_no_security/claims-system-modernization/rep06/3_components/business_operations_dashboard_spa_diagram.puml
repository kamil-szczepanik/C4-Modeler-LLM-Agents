@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Business Operations Dashboard SPA container

Container_Boundary(business_operations_dashboard_spa, "Business Operations Dashboard SPA") {
    Component(dashboard_router_state_manager, "Dashboard Router & State Manager", "React Router, TanStack Query", "Manages server state, routing, and polling intervals for real-time health checks.")
    Component(migration_metrics_view_switchback_alert_monitor, "Migration Metrics View & Switchback Alert Monitor", "React Components", "Displays migration transaction volumes, progress, and alerts for rapid switchbacks.")
    Component(audit_reconciliation_inspector, "Audit & Reconciliation Inspector", "React Component", "Ensures data consistency between the legacy mainframe and Azure.")
    Component(api_client_service, "API Client Service", "Axios, JWT-secured", "Fetches operational telemetry and reconciliation data from Azure API Management.")
    Component(telemetry_service, "Telemetry Service", "Azure Application Insights JS SDK", "Streams client-side errors and performance logs to Azure Application Insights.")
}

System_Ext(azure_api_management, "Azure API Management", "External API Management Gateway")
System_Ext(azure_application_insights, "Azure Application Insights", "Application Performance Monitoring")

Rel(api_client_service, azure_api_management, "Fetches operational telemetry and reconciliation data", "HTTPS / REST, JWT-secured")
Rel(telemetry_service, azure_application_insights, "Streams client-side errors and performance logs", "HTTPS")

@enduml