@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Processing Core & Integration/Anti-Corruption Layer container

Container_Boundary(claims_processing_core_and_integration_anti_corruption_layer, "Claims Processing Core & Integration/Anti-Corruption Layer") {
    Component(Claim_Routing_Component, "Claim Routing Component", "Spring Cloud Gateway/Router", "Evaluates claim types against a dynamic configuration store for routing and 1-day rollbacks.")
    Component(Legacy_Mainframe_Adapter, "Legacy Mainframe Adapter", "Spring Integration", "Translates JSON domain models into COBOL copybook structures via IBM MQ or CICS sockets.")
    Component(New_Domain_Core, "New Domain Core", "Spring Boot", "Domain service processing migrated claim types natively.")
    Component(Event_Publisher_Component, "Event Publisher Component", "Spring Cloud Stream", "Service emitting domain events.")
}

Rel(Claim_Routing_Component, Legacy_Mainframe_Adapter, "Routes unmigrated claims", "In-process / Java Method Call")
Rel(Claim_Routing_Component, New_Domain_Core, "Routes migrated claims", "In-process / Java Method Call")
Rel(New_Domain_Core, Event_Publisher_Component, "Triggers events", "In-process / Spring Application Events")

@enduml