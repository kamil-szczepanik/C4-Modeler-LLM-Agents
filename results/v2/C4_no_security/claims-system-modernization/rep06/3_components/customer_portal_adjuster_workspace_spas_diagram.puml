@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Customer Portal & Adjuster Workspace SPAs container

System_Ext(azure_api_management, "Azure API Management", "API Gateway")
System_Ext(corporate_identity_provider, "Corporate Identity Provider", "Active Directory / Identity Provider")
System_Ext(azure_application_insights, "Azure Application Insights", "Monitoring & Telemetry")

Container_Boundary(customer_portal_adjuster_workspace_spas, "Customer Portal & Adjuster Workspace SPAs") {
    Component(customer_broker_portal_spa, "Customer & Broker Portal SPA", "React.js", "Provides modular, responsive single-page application interfaces for customers and brokers.")
    Component(adjuster_workspace_spa, "Adjuster Workspace SPA", "React.js", "Provides modular, responsive single-page application interfaces for claims adjusters.")
    Component(authentication_session_manager, "Authentication & Session Manager", "MSAL.js / OAuth2 / OIDC", "Handles secure Single Sign-On integration and session management with Active Directory.")
    Component(api_client_caching_layer, "API Client & Caching Layer", "Axios / React Query", "Manages client-side state, caching, and mitigates mainframe latency.")
}

Rel(customer_broker_portal_spa, azure_api_management, "Communicates via", "HTTPS / REST (JSON)")
Rel(adjuster_workspace_spa, azure_api_management, "Communicates via", "HTTPS / REST (JSON)")
Rel(customer_broker_portal_spa, corporate_identity_provider, "Authenticates via", "HTTPS / OpenID Connect")
Rel(adjuster_workspace_spa, corporate_identity_provider, "Authenticates via", "HTTPS / OpenID Connect")
Rel(customer_broker_portal_spa, azure_application_insights, "Sends telemetry via", "HTTPS")
Rel(adjuster_workspace_spa, azure_application_insights, "Sends telemetry via", "HTTPS")

@enduml