@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(azure_service_bus, "Azure Service Bus") {
    Component(Claims_Topic, "Claims-Topic", "Azure Service Bus Topic", "Publishes and distributes claim events across the processing core and integration layers.")
    Component(Mainframe_Sync_Queue, "Mainframe-Sync-Queue", "Azure Service Bus Queue", "Relays batched sync payloads to the legacy mainframe via Azure Hybrid Connection.")
    Component(Audit_Relay, "Audit-Relay", "Azure Service Bus Queue/Topic", "Captures and routes audit trails to the compliance archive.")
    Component(DLQ_Replay_Processor, "DLQ-Replay-Processor", "Azure Service Bus Dead-Letter Queue Processor", "Listens to the dead-letter queue and triggers message replays for failed claim transactions.")
}

Rel(Claims Processing Core, Claims_Topic, "Publishes claim events", "AMQP over TLS")
Rel(Mainframe_Sync_Queue, Legacy Mainframe, "Relays batched sync payloads", "HTTPS / Azure Hybrid Connection")
Rel(DLQ_Replay_Processor, DLQ, "Listens and triggers replays", "AMQP")
@enduml