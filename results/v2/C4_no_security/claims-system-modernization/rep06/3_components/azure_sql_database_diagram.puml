@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure SQL Database container

Container_Boundary(azure_sql_database, "Azure SQL Database") {
    Component(claims_transactional_store, "Claims Transactional Store", "Relational tables with Snapshot Isolation", "Serves as the core transactional persistence layer storing relational claim data.")
    Component(migration_routing_state_registry, "Migration Routing & State Registry", "Feature-flag tables", "Tracks claim-type ownership and enables gradual, risk-mitigated claim type migration from the legacy mainframe.")
    Component(transactional_outbox_table, "Transactional Outbox Table", "Domain event buffer table", "Acts as a reliable domain event buffer for asynchronous messaging, replacing complex CDC.")
}

System_Ext(claims_processing_core, "Claims Processing Core & Integration/Anti-Corruption Layer", "Java / Spring Boot container client")
System_Ext(azure_service_bus, "Azure Service Bus", "Downstream event broker")

Rel(claims_processing_core, claims_transactional_store, "Reads and writes transactional state", "JDBC / TLS")
Rel(claims_processing_core, transactional_outbox_table, "Atomically writes domain events", "JDBC / TLS")
Rel(transactional_outbox_table, azure_service_bus, "Relays synchronization and migration events", "AMQP / TLS")

@enduml