@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Policyholders_and_Insurance_Brokers, "Policyholders and Insurance Brokers", "Users who submit claims and interact with the insurance platform.")
Person(Claims_Adjusters, "Claims Adjusters", "Users who process claims using the insurance platform.")
System(New_Insurance_Platform, "New Insurance Platform", "Modernizes a 30-year-old COBOL/DB2 mainframe claims platform into an Azure-hosted cloud solution, enabling online claim submission and adjuster processing.")
System_Ext(Legacy_Mainframe, "Legacy Mainframe", "On-premises COBOL/DB2 System of Record maintaining legacy data consistency.")
System_Ext(Corporate_Identity_Provider, "Corporate Identity Provider", "On-premises Active Directory used for authentication and identity management.")
System_Ext(Audit_Compliance_Archive, "Audit & Compliance Archive", "Azure Blob Storage with WORM policies for strict zero-data-loss compliance and audit retention.")

Rel(Policyholders_and_Insurance_Brokers, New_Insurance_Platform, "Interact with the platform for online claim submission", "HTTPS")
Rel(Claims_Adjusters, New_Insurance_Platform, "Process claims via the platform", "HTTPS")
Rel(New_Insurance_Platform, Corporate_Identity_Provider, "Authenticates users via Microsoft Entra ID federated with On-Premises Active Directory", "Microsoft Entra ID")
Rel(New_Insurance_Platform, Legacy_Mainframe, "Communicates asynchronously with the legacy system of record", "Enterprise Service Bus / Message Queues")
Rel(New_Insurance_Platform, Audit_Compliance_Archive, "Streams audit logs for compliance", "Azure Event Hubs / Azure Blob Storage")
@enduml