@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Real-Time Payment Fraud Screening System

Person(Fraud_Analyst, "Fraud Analyst", "Performs case management and reviews flagged payment fraud transactions.")
Person(Risk_Operations_Manager, "Risk Operations Manager", "Manages risk operations and reviews system metrics.")
Person(Compliance_Auditor, "Compliance Auditor", "Audits system logs to ensure compliance with regulatory requirements.")

System_Ext(Merchant___Payment_Gateway, "Merchant / Payment Gateway", "Sends card-not-present payment authorizations for fraud screening.")
System_Ext(External_Identity_Provider__IdP_, "External Identity Provider (IdP)", "Provides multi-factor authentication for users accessing the system.")

System_Boundary(Real_Time_Payment_Fraud_Screening_System, "Real-Time Payment Fraud Screening System") {
    Container(API_Gateway, "API Gateway", "AWS API Gateway / ALB", "Ingresses and routes incoming HTTP/REST traffic from merchants and gateways.")
    Container(Real_Time_Scoring_Engine, "Real-Time Scoring Engine", "Go, ECS Fargate, ONNX", "Evaluates transactions using embedded rules and static ML models under strict latency constraints.")
    Container(Case_Management_Backend___UI, "Case Management Backend & UI", "React, Node.js / Python, ECS Fargate", "Provides the case management interface and backend logic for analysts and managers.")
    ContainerDb(Feature_Store, "Feature Store", "Amazon ElastiCache Redis", "Provides sub-millisecond feature lookups for real-time scoring.")
    ContainerDb(Audit_Log_Storage, "Audit Log Storage", "Amazon S3, Amazon Athena", "Stores tamper-evident 7-year audit logs with Object Lock and query capabilities.")
}

Rel(Merchant___Payment_Gateway, API_Gateway, "Sends payment authorizations for fraud screening", "REST/HTTPS")
Rel(API_Gateway, Real_Time_Scoring_Engine, "Forwards payment authorizations for scoring", "REST/HTTPS")
Rel(Real_Time_Scoring_Engine, Feature_Store, "Retrieves features for real-time risk assessment", "Redis Protocol")
Rel(Real_Time_Scoring_Engine, Audit_Log_Storage, "Writes audit logs for compliance", "S3 API (HTTPS)")
Rel(Fraud_Analyst, Case_Management_Backend___UI, "Manages fraud cases and reviews flagged transactions", "REST/HTTPS")
Rel(Risk_Operations_Manager, Case_Management_Backend___UI, "Monitors and oversees risk operations", "REST/HTTPS")
Rel(Compliance_Auditor, Case_Management_Backend___UI, "Accesses audit data and compliance reports", "REST/HTTPS")

@enduml