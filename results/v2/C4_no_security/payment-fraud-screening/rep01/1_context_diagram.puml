@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalyst, "Fraud Analyst and Risk Operations Manager", "Performs case management and reviews flagged payment fraud transactions.")
Person(ComplianceAuditor, "Compliance Auditor / Regulators", "Audits system logs to ensure compliance with PCI-DSS Level 1 and regulatory requirements.")

System_Ext(MerchantPaymentGateway, "Merchant / Payment Gateway", "API Client sending card-not-present payment authorizations for scoring.")
System_Ext(ExternalIdentityIdP, "External Identity Provider (IdP)", "Provides multi-factor authentication for users accessing the system.")
System_Ext(AWSS3Glacier, "AWS S3 / Glacier", "Cold storage for 7-year tamper-evident audit logs.")

System(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System", "Screens card-not-present payment authorizations for fraud in real-time and provides case management for analysts, built for a mid-size payment processor in AWS eu-west-1.")

Rel(MerchantPaymentGateway, RealTimePaymentFraudScreeningSystem, "Submits payment authorizations for sub-50ms fraud scoring", "gRPC/REST over TLS")
Rel(FraudAnalyst, RealTimePaymentFraudScreeningSystem, "Manages cases and reviews system data via Web UI", "HTTPS")
Rel(RealTimePaymentFraudScreeningSystem, ExternalIdentityIdP, "Authenticates users via multi-factor authentication", "OAuth2/OIDC")
Rel(RealTimePaymentFraudScreeningSystem, AWSS3Glacier, "Stores 7-year tamper-evident audit logs", "AWS SDK/IAM")

@enduml