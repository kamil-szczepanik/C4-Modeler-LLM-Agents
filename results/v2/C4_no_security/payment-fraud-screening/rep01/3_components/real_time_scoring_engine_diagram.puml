@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Real-Time Scoring Engine container

System_Ext(API_Gateway, "API Gateway", "AWS API Gateway", "Forwards payment authorizations to the ingress router.")
System_Ext(Amazon_ElastiCache_Redis, "Amazon ElastiCache Redis", "Amazon ElastiCache Redis", "Provides low-latency, in-memory feature retrieval at 3,000 TPS.")
System_Ext(Amazon_S3, "Amazon S3", "Amazon S3", "Delivers cost-effective, tamper-evident storage for audit logs and model binaries.")

Container_Boundary(Real_Time_Scoring_Engine, "Real-Time Scoring Engine") {
    Component(HTTP_gRPC_Ingress_Router, "HTTP/gRPC Ingress Router", "Go container component", "Evaluates card-not-present payment authorizations and handles high-throughput transactions.")
    Component(Feature_Assembler, "Feature Assembler", "Go container component", "Retrieves transaction features from the feature store.")
    Component(Inference___Rule_Executor, "Inference & Rule Executor", "Go + ONNX Runtime C-API", "Executes compiled machine learning models and rules for fraud detection.")
    Component(Audit_Dispatcher, "Audit Dispatcher", "Go container component", "Flushes asynchronous audit payloads.")
    Component(Model___Rule_Synchronizer, "Model & Rule Synchronizer", "Go background goroutine component", "Atomically swaps model references via atomic.Value.")
}

Rel(API_Gateway, HTTP_gRPC_Ingress_Router, "Forwards payment authorizations", "REST/HTTPS")
Rel(Feature_Assembler, Amazon_ElastiCache_Redis, "Retrieves transaction features", "Redis Protocol")
Rel(Inference___Rule_Executor, Model___Rule_Synchronizer, "Atomically swaps model references via atomic.Value", "In-memory")
Rel(Audit_Dispatcher, Amazon_S3, "Flushes asynchronous audit payloads", "S3 API / HTTPS")
@enduml