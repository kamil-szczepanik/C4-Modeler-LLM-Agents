@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(feature_store, "Feature Store") {
    Component(feature_retrieval_api, "Feature Retrieval API", "Go", "Fetches online features for the Real-Time Scoring Engine.")
    Component(feature_snapshotter, "Feature Snapshotter", "Python", "Flushes immutable feature vectors to Audit Log Storage.")
    Component(feature_ingestion_worker, "Feature Ingestion Worker", "Python", "Ingests and processes feature data.")
    Component(feature_definition_registry, "Feature Definition Registry", "PostgreSQL / AWS RDS", "Stores feature definitions and metadata.")
}

System_Ext(real_time_scoring_engine, "Real-Time Scoring Engine", "Performs real-time fraud scoring.")
System_Ext(audit_log_storage, "Audit Log Storage", "Amazon S3 / Athena for 7-year audit logs.")

Rel(real_time_scoring_engine, feature_retrieval_api, "Fetches online features", "Redis Protocol")
Rel(feature_snapshotter, audit_log_storage, "Flushes immutable feature vectors", "HTTPS / S3 API")

@enduml