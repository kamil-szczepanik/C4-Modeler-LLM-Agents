@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(AWS_WAF, "AWS WAF", "AWS WAF", "Filters and monitors HTTP(S) requests to protect against common web exploits.")
    Component(Managed_Edge_Router, "Managed Edge Router", "AWS API Gateway / ALB", "Handles managed edge routing, rate limiting, and TLS termination.")
}

Rel(AWS_WAF, Managed_Edge_Router, "Forwards filtered requests")

@enduml