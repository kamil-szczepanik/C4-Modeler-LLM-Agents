@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(audit_log_storage, "Audit Log Storage") {
    Component(Audit_Buffer_Component, "Audit Buffer Component", "Amazon SQS", "Decouples the scoring engine from storage spikes to protect P99 latency by buffering log events.")
    Component(Audit_Ingestion_Component, "Audit Ingestion Component", "AWS Lambda", "Serverless ingestion component ensuring cost efficiency for processing audit logs.")
    Component(Tamper_Evident_Vault_Component, "Tamper-Evident Vault Component", "Amazon S3 with Object Lock and Lifecycle Rules", "Persists partitioned immutable logs enforcing WORM compliance mode for 7-year retention.")
    Component(Query_Access_Component, "Query & Access Component", "Amazon Athena", "Serverless SQL querying over partitioned data for rapid auditor reporting.")
}

Rel(Audit_Buffer_Component, Audit_Ingestion_Component, "Consume log events via AWS internal polling")
Rel(Audit_Ingestion_Component, Tamper_Evident_Vault_Component, "Persist partitioned immutable logs via S3 API")

@enduml