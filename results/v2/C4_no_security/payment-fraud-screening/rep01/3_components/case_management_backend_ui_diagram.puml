@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(case_management_backend_ui, "Case Management Backend & UI") {
    Component(React_Analyst_Web_App, "React Analyst Web App", "React, Amazon S3, Amazon CloudFront", "Single-page application hosted on Amazon S3 and distributed via Amazon CloudFront, enabling fraud analysts to review suspicious payment cases and manage workflows.")
    Component(FastAPI_Case_Management_Backend, "FastAPI Case Management Backend", "Python, FastAPI, AWS ECS Fargate", "Unified container handling API routing, RBAC, data masking, and orchestration.")
    Component(Audit_Event_Emitter, "Audit Event Emitter", "Python, AWS SDK (boto3)", "Internal module using AWS SDK (boto3) to stream immutable logs.")
    Component(Audit_Log_Storage, "Audit Log Storage", "Amazon S3, Object Lock", "Amazon S3 featuring Object Lock for tamper-evident retention satisfying the 7-year audit mandate.")
}

Rel(React_Analyst_Web_App, FastAPI_Case_Management_Backend, "Communicates request data and queue updates via REST/HTTPS and WebSockets.", "REST/HTTPS, WebSockets")
Rel(FastAPI_Case_Management_Backend, Audit_Event_Emitter, "Triggers audit event generation for actions.", "Internal call")
Rel(Audit_Event_Emitter, Audit_Log_Storage, "Streams append-only audit events via AWS SDK over HTTPS.", "AWS SDK / HTTPS")
@enduml