@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(DataScientists_FraudModelers, "Data Scientists / Fraud Modelers", "Users who commit fraud rules and models.")

Container_Boundary(ModelRuleDeploymentPipelineContainer, "Model/Rule Deployment Pipeline Container") {
    Component(GitHub, "GitHub", "Secure Git Repository", "Stores and manages fraud rules and models committed by Data Scientists and Fraud Modelers.")
    Component(AWSCodePipeline, "AWS CodePipeline", "AWS CodePipeline & CodeBuild", "Orchestrates the deployment pipeline, triggered via webhook to validate, compile, and update tasks.")
    Component(AWSCodeBuild, "AWS CodeBuild", "Python / FastAPI, ONNX", "Validates and compiles models into ONNX format.")
    Component(AmazonS3AuditFeatureStore, "Amazon S3 Audit & Feature Store", "Amazon S3", "Stores signed model artifacts and audit metadata.")
    Component(AmazonECSFargate, "Amazon ECS Fargate", "Amazon ECS API / HTTPS", "Runs task updates for zero-downtime model deployments.")
    Component(AmazonCloudWatch, "Amazon CloudWatch", "Amazon CloudWatch", "Monitors P99 latency and error rates for automated canary rollbacks.")
}

Rel(DataScientists_FraudModelers, GitHub, "Commits fraud rules and models", "HTTPS")
Rel(GitHub, AWSCodePipeline, "Triggers deployment pipeline", "Webhook / HTTPS")
Rel(AWSCodePipeline, AWSCodeBuild, "Validates and compiles models into ONNX format", "API")
Rel(AWSCodeBuild, AmazonS3AuditFeatureStore, "Stores signed model artifacts and audit metadata", "AWS SDK")
Rel(AWSCodePipeline, AmazonECSFargate, "Orchestrates zero-downtime task updates", "AWS ECS API / HTTPS")
Rel(AmazonCloudWatch, AWSCodePipeline, "Monitors P99 latency and error rates for automated canary rollbacks", "CloudWatch Alarms / EventBridge")
@enduml