@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Compliance Export Container container

Container_Boundary(compliance_export_container, "Compliance Export Container") {
    Component(Compliance_Export_Container, "Compliance Export Container", "AWS Lambda", "Serverless execution environment that provides scheduled, automated generation of standardized CSV and JSON audit trails to satisfy 7-year regulatory retention and PCI-DSS compliance.")
    Component(Athena_Query_Orchestrator, "Athena Query Orchestrator", "Python / boto3", "Executes scheduled audit queries against Amazon Athena.")
    Component(Schema_Formatter_Component, "Schema Formatter Component", "Python / Pandas", "Handles data streaming and formatting of query results within memory limits.")
    Component(Presigned_URL_Notifier, "Presigned URL Notifier", "Amazon SNS", "Publishes export status and secure download links.")
}

Component_Ext(Amazon_Athena, "Amazon Athena", "Amazon Athena", "Serverless query service used to process heavy 7-year compliance datasets without always-on compute.")
Component_Ext(Audit___Feature_Store, "Audit & Feature Store", "Amazon S3 with Object Lock", "Tamper-evident storage ensuring immutable audit logs for regulatory compliance.")
Component_Ext(Amazon_S3_Compliance_Bucket, "Amazon S3 Compliance Bucket", "Amazon S3", "Stores formatted CSV/JSON audit reports.")
Component_Ext(Amazon_SNS___Amazon_SQS_DLQ, "Amazon SNS & Amazon SQS DLQ", "Amazon SNS / Amazon SQS", "Captures unhandled execution failures for analysis and publishes notifications.")
Component_Ext(Amazon_EventBridge, "Amazon EventBridge", "Amazon EventBridge", "Triggers scheduled compliance exports via Cron / AWS Events.")

Rel(Compliance_Export_Container, Amazon_Athena, "Executes scheduled audit queries", "HTTPS / AWS SDK")
Rel(Compliance_Export_Container, Audit___Feature_Store, "Queries tamper-evident compliance logs", "Amazon Athena")
Rel(Compliance_Export_Container, Amazon_S3_Compliance_Bucket, "Writes formatted CSV/JSON audit reports", "HTTPS / AWS SDK")
Rel(Compliance_Export_Container, Amazon_SNS___Amazon_SQS_DLQ, "Publishes export status and secure download links", "AWS SDK")
Rel(Amazon_EventBridge, Compliance_Export_Container, "Triggers scheduled compliance exports", "Cron / AWS Events")
Rel(Compliance_Export_Container, Amazon_SNS___Amazon_SQS_DLQ, "Captures unhandled execution failures for analysis", "AWS SDK")

@enduml