@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Fraud Analyst SPA container

Container_Boundary(fraud_analyst_spa, "Fraud Analyst SPA") {
    Component(routing_auth_module, "Routing & Auth Module", "TypeScript / React Router", "Manages OAuth2/OIDC sessions and application routing.")
    Component(case_management_view_feedback_component, "Case Management View & Feedback Component", "React", "Provides the interface for fraud analysts to review suspicious transactions and submit feedback.")
    Component(xai_visualization_component, "XAI Visualization Component", "D3.js / Chart.js", "Renders explainable AI (XAI) feature-contribution graphs.")
    Component(api_client_layer, "API Client Layer", "Axios / Fetch", "Handles secure communication with strict CORS and token-header injection.")
}

System_Ext(case_management_backend_container, "Case Management Backend Container", "Amazon ECS Fargate")

Rel(routing_auth_module, fraud_analyst_spa, "Manages OAuth2/OIDC sessions")
Rel(case_management_view_feedback_component, api_client_layer, "Triggers data payloads", "HTTPS/REST")
Rel(api_client_layer, case_management_backend_container, "Transmits API requests with OAuth2 bearer tokens", "HTTPS/REST")

@enduml