@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Audit_Feature_Store", "Audit & Feature Store") {
    Component("Audit_Log_Store", "Audit Log Store", "Amazon S3 with Object Lock", "Ensures WORM-compliant, tamper-evident 7-year audit retention.")
    Component("Feature_Store", "Feature Store", "Amazon DynamoDB", "Provides single-digit millisecond feature reads and automated TTL pruning for cost control.")
    Component("Audit_Query_Engine", "Audit Query Engine", "Amazon Athena with AWS Glue Data Catalog", "Enables serverless SQL querying over S3 logs with zero operational overhead.")
    Component("Asynchronous_Ingestion", "Asynchronous Ingestion", "Amazon Kinesis Firehose", "Decouples audit writing from the critical path to protect P99 latency.")
}

Rel("Asynchronous_Ingestion", "Audit_Log_Store", "Batched persistence of tamper-evident logs", "S3 API / HTTPS")
Rel("Audit_Query_Engine", "Audit_Log_Store", "Serverless SQL audits", "Amazon Athena")
@enduml