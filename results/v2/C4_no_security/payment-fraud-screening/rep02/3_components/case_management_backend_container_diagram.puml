@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalystSPA, "Fraud Analyst SPA", "User interface for fraud analysts")
System_Ext(PrimaryOperationalDatastore, "Primary Operational Datastore", "SQL over TLS storage for transactional case states")
System_Ext(AmazonCloudWatch, "Amazon CloudWatch", "Zero-infrastructure operational metrics and dashboards")

Container_Boundary(CaseManagementBackendContainer, "Case Management Backend Container") {
    Component(CaseAPIRouterController, "Case API Router / Controller", "Node.js/TypeScript", "Handles API requests for case reviews from the Fraud Analyst SPA.")
    Component(WorkflowAssignmentEngine, "Workflow & Assignment Engine", "Node.js/TypeScript", "Manages case review workflows and writes transactional state.")
    Component(AuditActivityLogger, "Audit & Activity Logger", "Node.js/TypeScript", "Provides audit logging for fraud analysts reviewing suspicious payment authorizations.")
    Component(MetricsPublisher, "Metrics Publisher", "Node.js/TypeScript, Amazon CloudWatch EMF", "Publishes EMF telemetry asynchronously for operational metrics.")
}

Rel(FraudAnalystSPA, CaseAPIRouterController, "Sends API requests for case reviews", "HTTPS/REST")
Rel(CaseAPIRouterController, WorkflowAssignmentEngine, "Routes case review workflows")
Rel(WorkflowAssignmentEngine, AuditActivityLogger, "Logs case activities and audit events")
Rel(WorkflowAssignmentEngine, MetricsPublisher, "Triggers telemetry emission")
Rel(WorkflowAssignmentEngine, PrimaryOperationalDatastore, "Writes transactional state", "SQL over TLS")
Rel(MetricsPublisher, AmazonCloudWatch, "Publishes EMF telemetry", "Asynchronous in-process emission")

@enduml