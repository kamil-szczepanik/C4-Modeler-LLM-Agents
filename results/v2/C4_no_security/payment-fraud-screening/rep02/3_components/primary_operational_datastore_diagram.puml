@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Primary Operational Datastore container

Container_Boundary(primary_operational_datastore, "Primary Operational Datastore") {
    Component(Case_Management_Schema_Component, "Case Management Schema & Repository Component", "Amazon Aurora PostgreSQL Serverless v2, Native PostgreSQL Row-Level Security", "Manages transactional data, case workflows, and analyst overrides with strict PCI-DSS isolation.")
    Component(Transaction_Decision_Log_Component, "Transaction & Decision Log Component", "Amazon Aurora PostgreSQL Serverless v2", "Stores decision payloads, scores, and transactional logs, streaming aged partitions to S3.")
    Component(Encryption_Masking_Proxy_Component, "Encryption & Masking Proxy Component", "Native PostgreSQL pgcrypto", "Implements column-level encryption and data tokenization to meet compliance requirements.")
    Component(Amazon_RDS_Proxy, "Amazon RDS Proxy", "Amazon RDS Proxy", "Routes and pools database connections to handle high transaction spikes.")
    Component(Amazon_Aurora_PostgreSQL_Serverless_v2, "Amazon Aurora PostgreSQL Serverless v2", "Amazon Aurora PostgreSQL Serverless v2", "Provides auto-scaling relational database capabilities within the fixed infrastructure budget.")
    Component(Audit_Feature_Store_S3, "Audit & Feature Store (S3)", "Amazon S3", "External audit store receiving aged partitions older than 30 days.")
}

System_Ext(Case_Management_Backend_Container, "Case Management Backend Container", "External Container")
System_Ext(Real_Time_Scoring_Engine_Container, "Real-Time Scoring Engine Container", "External Container")
System_Ext(Amazon_ECS_Fargate_Containers, "Amazon ECS Fargate Containers", "External Container")

Rel(Case_Management_Backend_Container, Case_Management_Schema_Component, "Reads/writes analyst workflows and overrides", "SQL over TLS")
Rel(Real_Time_Scoring_Engine_Container, Transaction_Decision_Log_Component, "Writes decision payloads and scores", "SQL over TLS / Connection Pooling")
Rel(Transaction_Decision_Log_Component, Audit_Feature_Store_S3, "Streams aged partitions older than 30 days", "AWS SDK / S3 API")
Rel(Amazon_ECS_Fargate_Containers, Amazon_RDS_Proxy, "Routes and pools database connections", "TCP")

@enduml