@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Real-Time Scoring Engine Container container

Container(api_gateway, "API Gateway / Ingestion Service Container", "Container", "Ingestion service for authorization requests.")

Container_Boundary(real_time_scoring_engine_container, "Real-Time Scoring Engine Container") {
    Component(request_router___token_masker, "Request Router & Token Masker", "Rust", "Validates schemas and strips PCI data.")
    Component(feature_aggregator, "Feature Aggregator", "Rust", "Fetches real-time velocity metrics via Amazon ElastiCache Serverless.")
    Component(inference_executioner, "Inference Executioner", "Rust with ONNX Runtime", "Evaluates pre-compiled ML models and deterministic business rules.")
    Component(circuit_breaker___fallback_handler, "Circuit Breaker & Fallback Handler", "Rust", "Enforces 40ms timeouts and fails-open to review.")
    Component(audit___feature_store, "Audit & Feature Store", "Amazon S3 with Object Lock", "Stores 100% immutable audit logs and features for 7 years.")
    Component(amazon_elasticache_serverless, "Amazon ElastiCache Serverless", "Amazon ElastiCache Serverless", "Provides high-availability Redis caching within budget constraints.")
}

Rel(api_gateway, request_router___token_masker, "Forwards authorization requests", "gRPC over TLS")
Rel(feature_aggregator, amazon_elasticache_serverless, "Fetches real-time velocity metrics", "RESP over TCP")
Rel(inference_executioner, audit___feature_store, "Writes audit logs, model versions, and feature explanations", "AWS SDK / HTTPS")

@enduml