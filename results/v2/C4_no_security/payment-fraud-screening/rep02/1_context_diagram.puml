@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalystMerchantSupport, "Fraud Analyst & Merchant Support", "Internal users reviewing flagged cases and handling disputes.")
Person(DataScientistFraudModelerRiskManager, "Data Scientist / Fraud Modeler & Risk Manager", "Internal users updating rules, models, and auditing decisions.")
System_Ext(PaymentGatewayCoreProcessingSystem, "Payment Gateway / Core Processing System", "External system sending real-time authorization requests.")

System(RealTimePaymentFraudScreening, "Real-Time Payment Fraud Screening", "Processes card-not-present authorizations to detect fraud in real-time and provides case management for suspicious transactions, balancing risk mitigation, sub-50ms latency, and compliance.")

Rel(PaymentGatewayCoreProcessingSystem, RealTimePaymentFraudScreening, "Sends real-time authorization requests", "gRPC/REST over TLS")
Rel(FraudAnalystMerchantSupport, RealTimePaymentFraudScreening, "Accesses case management, rule updates, and audit logs", "HTTPS/TLS")
Rel(DataScientistFraudModelerRiskManager, RealTimePaymentFraudScreening, "Accesses case management, rule updates, and audit logs", "HTTPS/TLS")

@enduml