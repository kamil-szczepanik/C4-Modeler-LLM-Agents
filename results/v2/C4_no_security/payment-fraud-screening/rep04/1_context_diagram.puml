@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

System(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System", "AWS-hosted serverless platform for scoring, case management, and auditing card-not-present payment authorizations.")

Person(FraudAnalystRiskManager, "Fraud Analyst & Risk Manager", "Internal users managing reviews and fraud rules.")
System_Ext(PaymentGatewayAcquirerMerchantPlatforms, "Payment Gateway / Acquirer & Merchant Platforms", "External systems sending authorization requests.")
System_Ext(IdentityPoviderIdP, "Identity Provider (IdP)", "AWS Cognito or Okta for OAuth2/OIDC authentication.")
System_Ext(RegulatoryNotificationSink, "Regulatory & Notification Sink", "Immutable AWS S3 object storage vault for audit logs.")

Rel(PaymentGatewayAcquirerMerchantPlatforms, RealTimePaymentFraudScreeningSystem, "Sends sub-50ms authorization requests and receives decisions", "REST/gRPC over TLS 1.3")
Rel(FraudAnalystRiskManager, RealTimePaymentFraudScreeningSystem, "Manages cases and updates fraud rules", "HTTPS via IdP")
Rel(RealTimePaymentFraudScreeningSystem, RegulatoryNotificationSink, "Sends 7-year tamper-evident audit logs", "AWS S3 WORM policies")

@enduml