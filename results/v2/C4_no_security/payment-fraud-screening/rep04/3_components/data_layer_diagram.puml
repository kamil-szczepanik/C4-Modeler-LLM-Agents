@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Scoring_Engine_Container, "Scoring Engine Container", "Go/Rust on Amazon ECS", "Scoring Engine Container")
System_Ext(Case_Management_Container, "Case Management Container", "Node.js/Python Monolith on Amazon ECS", "Case Management Container")
System_Ext(Audit_Ledger_Compliance, "Audit Ledger & Compliance", "Amazon QLDB / CloudTrail Lake", "Audit Ledger & Compliance")

Container_Boundary(data_layer, "Data Layer") {
    Component(Transactional_Feature_and_Case_Storage, "Transactional Feature and Case Storage", "Amazon DynamoDB", "Single-table design with Point-in-Time Recovery for transactional feature and case storage.")
    Component(In_Memory_Cache, "In-Memory Cache", "Amazon ElastiCache for Redis OSS", "In-memory cache for low-latency rule and model weight retrieval.")
}

Rel(Scoring_Engine_Container, Transactional_Feature_and_Case_Storage, "Fetches rules, models, and case data", "HTTPS/TLS 1.3, AWS SDK, IAM SigV4")
Rel(Scoring_Engine_Container, In_Memory_Cache, "Retrieves low-latency rules and model weights", "")
Rel(Case_Management_Container, Transactional_Feature_and_Case_Storage, "Fetches rules, models, and case data", "HTTPS/TLS 1.3, AWS SDK, IAM SigV4")
Rel(Transactional_Feature_and_Case_Storage, Audit_Ledger_Compliance, "Exports immutable transaction inputs, model versions, and decisions", "Native AWS event streaming")
@enduml