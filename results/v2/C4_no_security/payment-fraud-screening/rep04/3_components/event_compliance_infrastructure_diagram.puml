@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Event & Compliance Infrastructure container

Container_Boundary(event_compliance_infrastructure, "Event & Compliance Infrastructure") {
    Component(Amazon_EventBridge_SNS, "Amazon EventBridge / SNS", "AWS EventBridge and Amazon SNS", "Handles asynchronous event decoupling and distribution for system-wide telemetry and alerts.")
    Component(Go_based_Audit_Logger, "Go-based Audit Logger", "Go", "Generates and exports tamper-evident audit logs and tracking events.")
    Component(Compliance_Vault_S3_Writer, "Compliance Vault S3 Writer", "AWS S3 with S3 Object Lock", "Writes and secures compliance data to S3 with Object Lock for 7-year auditability.")
    Component(Alerting_Dead_Letter_Monitor, "Alerting & Dead-Letter Monitor", "AWS SQS and Dead-Letter Queues", "Manages backpressure and monitors failures, exporting alerts asynchronously.")
}

Rel(Go_based_Audit_Logger, Compliance_Vault_S3_Writer, "Exports tamper-evident audit logs", "")
Rel(Alerting_Dead_Letter_Monitor, Amazon_EventBridge_SNS, "Sends failure alerts asynchronously", "")

@enduml