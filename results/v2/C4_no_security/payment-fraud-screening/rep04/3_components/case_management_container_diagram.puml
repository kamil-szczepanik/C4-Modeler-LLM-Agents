@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(case_management_container, "Case Management Container") {
    Component(CaseManagementAPI, "Case Management API", "Node.js / Python (FastAPI)", "Routes analyst and reporting traffic and handles business logic for case reviews.")
    Component(DataAccessLayer, "Data Access Layer", "AWS SDK", "Reads and writes case data, audit logs, and model metadata to Amazon DynamoDB.")
    Component(EventHandler, "Event Handler", "AWS SDK / SQS", "Handles dead-letter queues for failed asynchronous events and consumes event updates.")
}

Rel(CaseManagementAPI, DataAccessLayer, "Reads/writes case data, audit logs, and model metadata", "Amazon DynamoDB via AWS SDK")
Rel(EventHandler, DataAccessLayer, "Consumes asynchronous event updates", "Amazon DynamoDB Streams")
Rel(CaseManagementAPI, EventHandler, "Handles dead-letter queues for failed asynchronous events", "AWS SDK")

@enduml