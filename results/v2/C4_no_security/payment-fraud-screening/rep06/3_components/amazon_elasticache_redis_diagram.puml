@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_elasticache_redis, "Amazon ElastiCache (Redis)") {
    Component(Feature_Store_Module, "Feature Store Module", "Redis Hashes", "Stores transient feature vectors enabling O(1) lookups for sub-50ms P99 latency.")
    Component(Cache_Management_Module, "Cache Management Module", "Redis Engine", "Handles in-memory data caching and replication across multi-AZ deployments.")
}

Rel(Feature_Store_Module, Cache_Management_Module, "Maintains cached data state")

@enduml