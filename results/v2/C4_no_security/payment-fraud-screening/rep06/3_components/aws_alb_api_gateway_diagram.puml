@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS ALB / API Gateway container

Container_Boundary(aws_alb_api_gateway, "AWS ALB / API Gateway") {
    Component(AWS_WAF_Layer, "AWS WAF Layer", "AWS WAF", "Provides volumetric attack mitigation and Layer 7 ingress security.")
    Component(ALB_Ingress_Router, "ALB Ingress Router", "AWS Application Load Balancer", "Handles TLS 1.3 termination and routes traffic to internal services and APIs.")
}

System_Ext(Real_Time_Scoring_Engine, "Real-Time Scoring Engine", "Go, Amazon ECS Fargate Container")
System_Ext(Frontend_Web_App, "Frontend Web App", "React SPA Container")
System_Ext(Case_Management_Analytics_API, "Case Management & Analytics API", "Backend Container")
System_Ext(Amazon_S3_Object_Lock_KMS, "Amazon S3 with Object Lock and AWS KMS", "Storage Containers")

Rel(AWS_WAF_Layer, ALB_Ingress_Router, "Inspects and passes filtered traffic")
Rel(ALB_Ingress_Router, Real_Time_Scoring_Engine, "Routes scoring requests", "HTTP/2 / VPC Lattice")
Rel(ALB_Ingress_Router, Frontend_Web_App, "Serves static SPA assets", "HTTPS")
Rel(ALB_Ingress_Router, Case_Management_Analytics_API, "Routes management traffic", "HTTPS")
Rel(ALB_Ingress_Router, Amazon_S3_Object_Lock_KMS, "Stores AWS WAF and ALB access logs", "HTTPS")

@enduml