@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Amazon S3 with Object Lock and AWS KMS", "Amazon S3 with Object Lock and AWS KMS") {
    Component(WORM Storage Engine, "WORM Storage Engine", "Amazon S3 with Object Lock", "Provides immutable Write-Once-Read-Many storage ensuring 7-year tamper-evident auditability.")
    Component(Encryption Service, "Encryption Service", "AWS KMS", "Manages encryption keys to secure audit logs and sensitive payment data at rest.")
}

Rel(WORM Storage Engine, Encryption Service, "Uses encryption keys for data security", "AWS SDK")
@enduml