@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Real-Time Scoring Engine container

Container_Boundary(real_time_scoring_engine, "Real-Time Scoring Engine") {
    Component(api_handler_component, "API Handler Component", "Go / net/http", "Handles HTTP/2 scoring requests from the API gateway.")
    Component(feature_aggregator_component, "Feature Aggregator Component", "Go", "Retrieves real-time feature vectors via RESP from Redis.")
    Component(scoring_evaluator_component, "Scoring Evaluator Component", "Go", "Evaluates transactions for fraud scoring.")
    Component(audit_logger_component, "Audit Logger Component", "Go", "Logs decision payloads and audit trails.")
    Component(fallback_circuit_breaker_component, "Fallback Circuit Breaker Component", "Go / In-Memory", "Manages in-memory fallback routing states locally to ensure high availability.")
}

System_Ext(aws_alb_api_gateway, "AWS ALB / API Gateway", "External API Gateway")
System_Ext(amazon_elasticache_redis, "Amazon ElastiCache (Redis)", "In-memory data store")
System_Ext(aws_kinesis_data_streams_amazon_sqs, "AWS Kinesis Data Streams / Amazon SQS", "Messaging service")
System_Ext(amazon_s3_with_object_lock_and_aws_kms, "Amazon S3 with Object Lock and AWS KMS", "Storage service")

Rel(aws_alb_api_gateway, api_handler_component, "Routes HTTP/2 scoring requests", "HTTP/2")
Rel(feature_aggregator_component, amazon_elasticache_redis, "Retrieves real-time feature vectors", "RESP")
Rel(audit_logger_component, aws_kinesis_data_streams_amazon_sqs, "Batch-streams decision payloads", "HTTPS")
Rel(audit_logger_component, amazon_s3_with_object_lock_and_aws_kms, "Writes tamper-evident logs", "HTTPS")
Rel(fallback_circuit_breaker_component, scoring_evaluator_component, "Manages in-memory fallback routing states locally", "In-Memory")
@enduml