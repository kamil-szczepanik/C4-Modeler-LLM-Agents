@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("AWS Kinesis Data Streams / Amazon SQS", "AWS Kinesis Data Streams / Amazon SQS") {
    Component(AWS_Kinesis_Data_Streams, "AWS Kinesis Data Streams", "AWS Kinesis Data Streams (On-Demand)", "Ingests real-time payment event streams for the fraud screening system.")
    Component(Amazon_SQS, "Amazon SQS", "Amazon SQS (Standard/FIFO)", "Handles asynchronous task queues for audit logs and review cases.")
}

Rel(AWS_Kinesis_Data_Streams, Amazon_SQS, "Forwards event streams and processed tasks for asynchronous handling", "HTTPS")

@enduml