@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon RDS PostgreSQL container

System_Ext(s3_object_lock, "Amazon S3 with Object Lock", "Immutable, encrypted storage for 7-year audit retention.")

Container_Boundary(rds_postgresql, "Amazon RDS PostgreSQL") {
    Component(case_management_schema, "Case Management Schema", "Relational database schema", "Stores active cases and operational data for fraud analysts.")
    Component(audit_explainability_log, "Audit & Explainability Log", "Relational database schema", "Maintains immutable-style logs for 7-year audit retention and explainability.")
    Component(partition_manager, "Partition Manager", "pg_partman", "Manages structured data storage and table partitioning for optimal query performance.")
    Component(data_purge_ttl_worker, "Data Purge & TTL Worker", "PostgreSQL Worker / Cron", "Handles data retention lifecycles and offloading of expired partitions.")
}

Rel(partition_manager, s3_object_lock, "Offloads expired partitions", "HTTPS")

@enduml