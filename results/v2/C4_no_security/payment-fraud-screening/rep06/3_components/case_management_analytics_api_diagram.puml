@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(case_management_and_analytics_api, "Case Management & Analytics API") {
    Component(REST_GraphQL_Handler, "REST/GraphQL Handler", "NestJS, Data Masking Middleware", "Handles API requests from the Frontend Web App and enforces data masking and PCI-DSS compliance.")
    Component(Case_Service, "Case Service", "NestJS, In-Memory / TCP", "Processes transactional state updates and case reads/writes.")
    Component(Analytics_Query_Engine, "Analytics Query Engine", "NestJS, TCP/SQL", "Executes reporting and analytics queries against the OLAP read replica.")
    Component(Audit_Logger, "Audit Logger", "AWS SDK, HTTPS", "Generates and stores immutable 7-year audit logs.")
}

System_Ext(Amazon_RDS_PostgreSQL_Primary, "Amazon RDS PostgreSQL Primary", "OLTP database for case reads and writes")
System_Ext(Amazon_RDS_Read_Replica, "Amazon RDS Read Replica", "OLAP database for reporting and analytics queries")
System_Ext(Amazon_S3_with_Object_Lock, "Amazon S3 with Object Lock", "Storage for immutable audit records")

Rel(REST_GraphQL_Handler, Case_Service, "Transactional state updates", "In-Memory / TCP")
Rel(Case_Service, Amazon_RDS_PostgreSQL_Primary, "Case reads and writes", "TCP/SQL")
Rel(Analytics_Query_Engine, Amazon_RDS_Read_Replica, "Reporting queries", "TCP/SQL")
Rel(Audit_Logger, Amazon_S3_with_Object_Lock, "Immutable audit records", "HTTPS")
@enduml