@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Frontend Web App container

Container_Boundary(frontend_web_app, "Frontend Web App") {
    Component(Frontend_Web_App, "Frontend Web App", "React SPA", "Powers a responsive, modular user interface with low maintenance overhead for a 3-engineer team.")
    Component(Authentication_Session_Manager, "Authentication & Session Manager", "TypeScript, OIDC/OAuth2", "Authenticates analysts and manages OIDC tokens.")
    Component(Case_Management_Dashboard, "Case Management Dashboard", "React, Tailwind CSS", "Secure case management frontend for fraud analysts.")
    Component(Rule_Model_Configurator, "Rule & Model Configurator", "React", "Configures rules and models, submitting dry-run simulations and rule updates.")
    Component(API_Client_Layer, "API Client Layer", "Axios/Fetch", "Handles RESTful operations and communicates with backend APIs.")
    Component(AWS_S3_CloudFront, "AWS S3 & CloudFront", "AWS S3 & CloudFront (CDN)", "Provides secure, serverless static asset hosting.")
    Component(AWS_WAF_AWS_Cognito, "AWS WAF & AWS Cognito", "AWS WAF & AWS Cognito", "Secures edge distribution and delivers managed OIDC/OAuth2 authentication and RBAC.")
}

System_Ext(Case_Management_Analytics_API, "Case Management & Analytics API", "REST/JSON", "Backend API for case management and analytics.")

Rel(Case_Management_Dashboard, API_Client_Layer, "Invokes RESTful operations", "HTTPS/REST, JSON")
Rel(Rule_Model_Configurator, API_Client_Layer, "Submits dry-run simulations and rule updates", "HTTPS/REST, JSON")
Rel(Authentication_Session_Manager, AWS_WAF_AWS_Cognito, "Authenticates analysts and manages OIDC tokens", "HTTPS/OAuth2")
Rel(Frontend_Web_App, Case_Management_Analytics_API, "Communicates via strict CORS-enforced", "HTTPS")
Rel(AWS_WAF_AWS_Cognito, AWS_S3_CloudFront, "Blocks web exploits and enforces rate-limiting at the edge", "HTTPS")

@enduml