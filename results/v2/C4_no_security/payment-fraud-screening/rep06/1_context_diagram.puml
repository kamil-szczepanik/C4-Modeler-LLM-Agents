@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalyst, "Fraud Analyst", "Internal user who accesses case management tools to review and manage fraud cases.")
System_Ext(ShopperCardholder, "Shopper / Cardholder", "External entity initiating payment transactions.")
System_Ext(MerchantPaymentGateway, "Merchant / Payment Gateway", "External entity submitting payment authorizations for real-time fraud scoring.")

System(RealTimePaymentFraudScreening, "Real-Time Payment Fraud Screening", "Evaluates card-not-present payment authorizations to detect fraud and provides case management tools for analysts, processing 3,000 transactions per second.")

Rel(MerchantPaymentGateway, RealTimePaymentFraudScreening, "Connects for real-time scoring of payment authorizations.", "gRPC/TLS")
Rel(FraudAnalyst, RealTimePaymentFraudScreening, "Accesses case management tools authenticated via AWS Cognito.", "HTTPS/TLS")

@enduml