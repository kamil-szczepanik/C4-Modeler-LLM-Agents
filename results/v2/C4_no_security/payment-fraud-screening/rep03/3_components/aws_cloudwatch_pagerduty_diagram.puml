@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_cloudwatch_pagerduty, "AWS CloudWatch & PagerDuty") {
    Component(Amazon_CloudWatch, "Amazon CloudWatch", "AWS CloudWatch & Log Exports", "Monitors infrastructure, aggregates logs, and manages composite alarms.")
    Component(Amazon_SNS, "Amazon SNS", "Amazon Simple Notification Service", "Publishes infrastructure alarms and health status to downstream alerting services.")
    Component(PagerDuty_Integration, "PagerDuty Integration", "HTTPS Webhooks", "Receives alert notifications for on-call incident response.")
}

Rel(Amazon_CloudWatch, Amazon_SNS, "Triggers alarms and publishes health events", "AWS SDK / Internal")
Rel(Amazon_SNS, PagerDuty_Integration, "Publishes alarms and health status via HTTPS webhooks", "HTTPS")

@enduml