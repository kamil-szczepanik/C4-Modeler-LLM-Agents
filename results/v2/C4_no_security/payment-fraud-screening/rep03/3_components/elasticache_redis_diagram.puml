@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the ElastiCache Redis container

Container_Boundary(elasticache_redis, "ElastiCache Redis") {
    Component(redis_engine_oss_7_x, "Redis Engine OSS 7.x", "Amazon ElastiCache Redis OSS 7.x, cache.m6g.large", "In-memory cache providing ultra-low latency rules evaluation, feature states, and zero-downtime hot-reloads.")
    Component(multi_az_group_with_read_replica, "Multi-AZ Group with Read Replica", "AWS ElastiCache Multi-AZ with Automatic Failover", "Ensures high availability and automatic failover within seconds.")
    Component(redis_pub_sub_channel, "Redis Pub/Sub Channel", "Redis Pub/Sub", "Facilitates real-time messaging and hot-reloads for rules and feature states.")
    Component(redis_auth___iam_authentication, "Redis AUTH / IAM Authentication", "Redis AUTH / AWS KMS / TLS", "Protects cardholder data with in-transit and at-rest encryption to meet PCI-DSS Level 1 compliance.")
    Component(cluster_parameter_group, "Cluster Parameter Group", "Redis volatile-lru", "Manages memory eviction policy for cached rules and feature states.")
    Component(slow_log_export, "Slow Log Export", "AWS CloudWatch API", "Exports slow logs and operational metrics like CPUUtilization, SwapUsage, and CurrConnections.")
}

Rel(redis_engine_oss_7_x, multi_az_group_with_read_replica, "Replicates data and ensures high availability")
Rel(redis_engine_oss_7_x, redis_pub_sub_channel, "Broadcasts hot-reload updates")
Rel(redis_engine_oss_7_x, slow_log_export, "Exports performance logs and metrics")
@enduml