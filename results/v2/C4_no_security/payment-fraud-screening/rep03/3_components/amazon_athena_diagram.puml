@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Amazon Athena", "Amazon Athena") {
    Component("Athena Workgroups", "Athena Workgroups", "Amazon Athena", "Serverless query engine for cost-effective ad-hoc auditing.")
    Component("Presto/Trino Query Engine", "Presto/Trino Query Engine", "Presto/Trino", "Distributed query execution engine powering Athena queries.")
    Component("AWS Glue Data Catalog", "AWS Glue Data Catalog", "AWS Glue Data Catalog", "Schema registry with partition projection for performance and cost control.")
    Component("Amazon S3 Object Lock", "Amazon S3 Object Lock", "Amazon S3", "Tamper-evident storage ensuring 7-year auditability.")
}

Rel("Athena Workgroups", "Presto/Trino Query Engine", "Internal AWS Backbone")
Rel("Presto/Trino Query Engine", "AWS Glue Data Catalog", "Internal AWS Backbone")
Rel("Presto/Trino Query Engine", "Amazon S3 Object Lock", "SQL / AWS API")

@enduml