@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_s3_object_lock, "Amazon S3 Object Lock") {
    Component(Compliance Archive Bucket, "Compliance Archive Bucket", "Amazon S3 Object Lock", "Stores tamper-evident audit payloads in GOVERNANCE mode for 7-year retention.")
    Component(Cross-Region Replication Module, "Cross-Region Replication Module", "AWS Replication API", "Replicates immutable audit objects to the replica bucket in eu-central-1.")
}

Rel(Compliance Archive Bucket, Cross-Region Replication Module, "Triggers object replication", "AWS Replication API")
@enduml