@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_alb, "AWS ALB") {
    Component(ssl_termination_and_waf, "SSL Termination and WAF", "AWS WAF / AWS Certificate Manager", "Handles incoming HTTPS requests, terminates SSL, and applies Web Application Firewall rules.")
    Component(routing_and_health_check, "Routing and Health Check", "AWS ALB Target Groups", "Routes valid requests to backend containers and performs native target group health checks.")
}

Rel(ssl_termination_and_waf, routing_and_health_check, "Forwards inspected and decrypted traffic", "")

@enduml