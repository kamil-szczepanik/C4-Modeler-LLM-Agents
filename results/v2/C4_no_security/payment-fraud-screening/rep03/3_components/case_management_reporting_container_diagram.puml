@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management & Reporting Container container

Container_Boundary("Case Management & Reporting Container", "Case Management & Reporting Container") {
    Component("Frontend SPA", "Frontend SPA", "React, AWS S3 / CloudFront", "Provides the user interface for fraud analysts, risk managers, and compliance auditors.")
    Component("Case Management API", "Case Management API", "Node.js/Express, AWS ECS Fargate", "Evaluates card-not-present transactions, provides case management interface for fraud analysts, and persists active case state.")
    Component("Reporting Service", "Reporting Service", "Node.js, AWS ECS Fargate", "Aggregates false-positive metrics and analyst SLAs for reporting and analytics.")
    Component("Amazon DynamoDB", "Amazon DynamoDB", "Amazon DynamoDB (On-Demand)", "Persists active case state.")
    Component("Amazon SQS / Kinesis", "Amazon SQS / Kinesis", "Amazon SQS / Kinesis", "Dispatches audit events for archival.")
    Component("Amazon Athena", "Amazon Athena", "Amazon Athena & S3 Object Lock", "Aggregates false-positive metrics and analyst SLAs, providing tamper-evident 7-year audit logs.")
}

Rel("Frontend SPA", "Case Management API", "User interactions and data queries", "REST/HTTPS")
Rel("Frontend SPA", "Reporting Service", "User interactions and data queries", "REST/HTTPS")
Rel("Case Management API", "Amazon DynamoDB", "Persists active case state", "AWS SDK / HTTPS")
Rel("Case Management API", "Amazon SQS / Kinesis", "Dispatches audit events for archival", "JSON / HTTPS")
Rel("Reporting Service", "Amazon Athena", "Aggregates false-positive metrics and analyst SLAs", "AWS SDK / HTTPS")

@enduml