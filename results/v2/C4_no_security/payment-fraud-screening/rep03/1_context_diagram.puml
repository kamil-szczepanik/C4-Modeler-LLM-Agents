@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalystRiskManager, "Fraud Analyst & Risk Manager", "Internal users handling case management and rule updates.")
Person(ComplianceAuditor, "Compliance Auditor", "External user accessing audit logs.")
System_Ext(PaymentGateway, "Payment Gateway", "External upstream system submitting authorizations.")
System_Ext(TokenizationVaultService, "Tokenization / Vault Service", "External system handling card data.")
System_Ext(AWSCloudWatch, "AWS CloudWatch", "Telemetry, audit logging, and observability service.")

System(RealTimePaymentFraudScreening, "Real-Time Payment Fraud Screening", "Screens card-not-present payment authorizations to prevent fraud while enabling analysts to review suspicious transactions, ensuring compliance, low-latency processing, and high availability.")

Rel(PaymentGateway, RealTimePaymentFraudScreening, "Submits authorizations", "gRPC/HTTPS")
Rel(FraudAnalystRiskManager, RealTimePaymentFraudScreening, "Reviews suspicious transactions and manages cases", "HTTPS")
Rel(RealTimePaymentFraudScreening, TokenizationVaultService, "Queries masked/tokenized data", "Mutual TLS (mTLS)")
Rel(RealTimePaymentFraudScreening, AWSCloudWatch, "Exports tamper-evident logs", "OpenTelemetry")
Rel(ComplianceAuditor, AWSCloudWatch, "Accesses audit logs for compliance", "HTTPS")

@enduml