@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(fraud_scoring_engine, "Fraud Scoring Engine") {
    Component(API_Controller, "API Controller", "Go / Rust", "Receives payment requests from the API Gateway and exposes endpoints for scoring.")
    Component(Feature_Assembler, "Feature Assembler", "Go / Rust", "Queries real-time features from cache to assemble the feature set for evaluation.")
    Component(Evaluation_Core, "Evaluation Core", "Go / Rust", "Applies rules and models to evaluate payment transactions and produce risk scores.")
    Component(Telemetry_Publisher, "Telemetry Publisher", "Go / Rust", "Publishes decision events asynchronously to downstream message queues.")
}

Rel(API_Controller, Feature_Assembler, "Requests real-time feature assembly for incoming payments", "Internal")
Rel(Feature_Assembler, Evaluation_Core, "Passes assembled features for scoring", "Internal")
Rel(Evaluation_Core, Telemetry_Publisher, "Sends decision results for asynchronous publishing", "Internal")

@enduml