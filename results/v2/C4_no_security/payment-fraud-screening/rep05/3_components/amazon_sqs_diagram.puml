@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_sqs, "Amazon SQS") {
    Component(Standard_Queue, "Standard Queue", "AWS SQS Standard", "High-throughput message queue supporting 3,000 TPS for asynchronous audit events.")
    Component(Dead_Letter_Queue_DLQ, "Dead Letter Queue (DLQ)", "AWS SQS DLQ", "Captures failed audit messages and emits metric telemetry to AWS CloudWatch.")
}

Rel(Standard_Queue, Dead_Letter_Queue_DLQ, "Routes failed messages upon processing exhaustion", "")

@enduml