@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(audit_evidence_worker, "Audit & Evidence Worker") {
    Component(sqs_consumer, "SQS Consumer", "Go", "Polls asynchronous audit events from Amazon SQS.")
    Component(canonicalizer_sanitizer, "Canonicalizer & Sanitizer", "Go", "Normalizes and sanitizes incoming audit event payloads.")
    Component(s3_batch_writer, "S3 Batch Writer", "Go / AWS SDK v2", "Writes immutable audit logs with metadata to AWS S3 with Object Lock.")
    Component(sqs_dlq, "SQS DLQ", "Amazon SQS", "Routes failed writes on persistent errors.")
}

Rel(sqs_consumer, canonicalizer_sanitizer, "Forwards polled audit events")
Rel(canonicalizer_sanitizer, s3_batch_writer, "Sends sanitized records")
Rel(s3_batch_writer, sqs_dlq, "Routes failed writes on persistent errors", "SQS SendMessage")

@startuml