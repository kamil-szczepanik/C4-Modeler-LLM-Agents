@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS ElastiCache (Redis) container

Container_Boundary(aws_elasticache_redis, "AWS ElastiCache (Redis)") {
    Component(RedisCluster, "Redis Cluster", "AWS ElastiCache (Redis) cache.m6g.large", "Provides sub-millisecond feature lookup using cache.m6g.large instances via Redis Protocol (RESP) over TLS.")
}

Component(FraudScoringEngine, "Fraud Scoring Engine", "Go / Rust", "High-throughput, low-latency Fraud Scoring Engine")

Rel(RedisCluster, FraudScoringEngine, "Returns real-time features to", "Redis Protocol (RESP) over TLS")

@enduml