@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS API Gateway container

Container_Boundary(aws_api_gateway, "AWS API Gateway") {
    Component(Ingress_Traffic_Handler, "Ingress Traffic Handler", "AWS API Gateway / AWS WAF", "Handles ingress traffic and provides AWS WAF rate-limiting to protect against DDoS.")
    Component(JWT_Authorizer, "JWT Authorizer", "AWS API Gateway Native JWT", "Performs native JWT authorizer validation for incoming payment requests.")
}

Rel(Ingress_Traffic_Handler, JWT_Authorizer, "Passes validated payloads", "HTTPS/JSON")

@enduml