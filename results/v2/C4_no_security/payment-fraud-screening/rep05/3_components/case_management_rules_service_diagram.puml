@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management & Rules Service container

Person(FraudAnalystsAndComplianceOfficers, "Fraud Analysts and Compliance Officers", "Personas who interact with the Case Workflow Controller.")
Person(RiskManagersFraudTeamLeads, "Risk Managers / Fraud Team Leads", "Personas who oversee risk management and case workflows.")

System_Ext(AWSAppConfig, "AWS AppConfig", "Provides managed, zero-downtime rule configuration storage and state polling.")
System_Ext(AmazonSQS, "Amazon SQS", "Ensures reliable message delivery and tamper-evident audit logging.")

Container_Boundary(CaseManagementAndRulesService, "Case Management & Rules Service") {
    Component(CaseWorkflowController, "Case Workflow Controller", "Go", "Manages fraud analyst reviews, case workflows, and routes HTTPS/REST requests from fraud analysts.")
    Component(RuleAuthoringEngine, "Rule Authoring Engine", "Go, AWS AppConfig", "Handles zero-downtime rule updates and configuration storage using AWS AppConfig.")
    Component(AuditLogger, "Audit Logger", "Go, Amazon SQS", "Ensures tamper-evident audit logging and reliable message delivery.")
    Component(DataMaskingProxy, "Data Masking Proxy", "Go", "Ensures strict PCI-DSS compliance and data masking.")
    Component(DecisionMetadataExtractor, "Decision Metadata Extractor", "Go", "Extracts decision metadata for fraud mitigation.")
    Component(ApprovalWorkflowInterceptor, "Approval Workflow Interceptor", "Go", "Interceps and handles approval workflows for case management.")
}

Rel(FraudAnalystsAndComplianceOfficers, CaseWorkflowController, "HTTPS/REST")
Rel(RiskManagersFraudTeamLeads, CaseWorkflowController, "HTTPS/REST")
Rel(RuleAuthoringEngine, AWSAppConfig, "HTTPS/AWS SDK")
Rel(CaseWorkflowController, AuditLogger, "Internal Go Function Call")
Rel(AuditLogger, AmazonSQS, "HTTPS/AWS SDK")

@enduml