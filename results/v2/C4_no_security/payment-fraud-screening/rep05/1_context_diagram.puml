@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalystsAndComplianceOfficers, "Fraud Analysts and Compliance Officers", "Human analysts who review cases and ensure compliance.")
Person(AuditorsRegulators, "Auditors / Regulators", "External entities that review compliance reports and audit logs.")
System_Ext(PaymentGatewayMerchants, "Payment Gateway / Merchants", "API clients that send card-not-present payment authorization requests.")
System_Ext(AWSS3withObjectLockandGlacierDeepArchive, "AWS S3 with Object Lock and Glacier Deep Archive", "Provides immutable 7-year storage for regulatory audit compliance.")

System(RealTimePaymentFraudScreening, "Real-Time Payment Fraud Screening", "Evaluates card-not-present payment authorizations for fraud at 3,000 transactions per second while providing case management for human analysts.")

Rel(PaymentGatewayMerchants, RealTimePaymentFraudScreening, "Sends authorization requests", "gRPC/REST")
Rel(FraudAnalystsAndComplianceOfficers, RealTimePaymentFraudScreening, "Accesses the Case Management UI", "HTTPS")
Rel(RealTimePaymentFraudScreening, AWSS3withObjectLockandGlacierDeepArchive, "Stores tamper-evident audit logs", "AWS SDK")
Rel(AuditorsRegulators, RealTimePaymentFraudScreening, "Accesses compliance reports", "Secure export channels")

@enduml