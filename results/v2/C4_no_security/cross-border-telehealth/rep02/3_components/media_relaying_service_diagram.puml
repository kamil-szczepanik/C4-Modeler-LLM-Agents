@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(media_relaying_service, "Media Relaying Service") {
    Component(sfu_media_router, "SFU Media Router", "Go, LiveKit server node", "Handles real-time WebRTC media forwarding and adaptive bitrate scaling.")
    Component(room_session_manager, "Room & Session Manager", "Node.js / Go", "Manages virtual rooms, authentication, and region-locked policies.")
    Component(telemetry_audit_collector, "Telemetry & Audit Collector", "Go", "Captures WebRTC stats and compliance metadata.")
    Component(turn_stun_relay_gateway, "TURN/STUN Relay Gateway", "Coturn / LiveKit Egress", "Handles NAT traversal and TCP fallback.")
}

Rel(sfu_media_router, telemetry_audit_collector, "Streams session quality metrics", "Internal gRPC")

@enduml