@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Backend services container

System_Ext(AI_Symptom_Checker, "AI Symptom Checker", "Python / FastAPI", "AI symptom analysis service")
System_Ext(Data_Storage, "Data Storage", "Cloud SQL / WORM", "Persists records and audit logs")

Container_Boundary(core_backend_services, "Core Backend services") {
    Component(Consent_Policy_Engine, "Consent & Policy Engine", "Go / Spring Boot", "Enforces strict regional data residency, privacy policies, and emits access and consent decisions.")
    Component(Consultation_Orchestrator, "Consultation Orchestrator", "Go / Spring Boot", "Manages consultation workflows and buffers ephemeral session states for rural areas.")
    Component(Clinical_Record_Manager, "Clinical Record Manager", "Go / Spring Boot", "Handles secure management and persistence of patient clinical records.")
    Component(Audit_Compliance_Logger, "Audit & Compliance Logger", "Go / Spring Boot", "Logs access and compliance events for GDPR and HIPAA tracking.")
    Component(Session_State_Cache, "Session State Cache", "Redis / Memorystore", "Ephemeral session state buffer")
}

Rel(Consent_Policy_Engine, Audit_Compliance_Logger, "Emits access and consent decisions", "gRPC")
Rel(Consultation_Orchestrator, Session_State_Cache, "Buffers ephemeral session states", "Redis Protocol")
Rel(Consent_Policy_Engine, AI_Symptom_Checker, "Requests AI symptom analysis", "gRPC")
Rel(Consultation_Orchestrator, AI_Symptom_Checker, "Requests AI symptom analysis", "gRPC")
Rel(Clinical_Record_Manager, Data_Storage, "Persists records", "PostgreSQL Protocol")
Rel(Audit_Compliance_Logger, Data_Storage, "Persists audit logs", "WORM Storage")
@enduml