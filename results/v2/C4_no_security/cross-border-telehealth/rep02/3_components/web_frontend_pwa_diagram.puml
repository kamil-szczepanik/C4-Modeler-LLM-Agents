@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Frontend (PWA) container

Container_Boundary(web_frontend_pwa, "Web Frontend (PWA)") {
    Component(Telehealth_UI_Module, "Telehealth UI Module", "Next.js / React", "Provides the user interface for video consultations and patient interactions.")
    Component(AI_Symptom_Checker_Module, "AI Symptom Checker Module", "React", "Interfaces with the AI symptom checker to collect inputs and display preliminary assessments.")
    Component(Offline_Caching_Module, "Offline Caching Module", "IndexedDB & Service Workers", "Enables local caching and offline payload queuing for low-bandwidth rural connections.")
}

Rel(Telehealth_UI_Module, AI_Symptom_Checker_Module, "Passes user symptom data")
Rel(Telehealth_UI_Module, Offline_Caching_Module, "Queues payloads and caches data locally")
@enduml