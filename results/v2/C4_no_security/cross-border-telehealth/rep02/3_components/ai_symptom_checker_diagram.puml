@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Core_Backend, "Core Backend", "External system representing the main backend calling the symptom checker.")
System_Ext(BigQuery, "BigQuery", "External data warehouse for audit trails and telemetry.")
System_Ext(Cloud_SQL, "Cloud SQL", "External relational database for regional audit trails.")
System_Ext(PubSub, "Pub/Sub", "External messaging service for dead-letter queues.")

Container_Boundary(ai_symptom_checker, "AI Symptom Checker") {
    Component(Triage_API_Controller, "Triage API Controller", "FastAPI / Python, Protobuf / gRPC", "Exposes asynchronous endpoints for step-by-step symptom evaluation and handles requests from the Core Backend.")
    Component(Inference_Engine_Component, "Inference Engine Component", "PyTorch, LangChain", "Runs localized diagnostic models to generate urgency scores and plain-language rationales.")
    Component(Audit___Traceability_Logger, "Audit & Traceability Logger", "Python, OpenTelemetry, Prometheus", "Captures model versions, feature inputs, and output urgency levels for regulatory compliance, routing logs to storage and dead-letter queues.")
    Component(Feedback_Ingestion_Component, "Feedback Ingestion Component", "FastAPI / Python", "Handles post-triage patient feedback and escalation metrics.")
}

Rel(Core_Backend, Triage_API_Controller, "Sends symptom evaluation requests and feedback", "gRPC")
Rel(Triage_API_Controller, Inference_Engine_Component, "Invokes diagnostic models internally", "")
Rel(Inference_Engine_Component, Audit___Traceability_Logger, "Transmits structured reasoning and model version metadata", "")
Rel(Audit___Traceability_Logger, BigQuery, "Persists regional audit trails and feedback telemetry", "")
Rel(Audit___Traceability_Logger, Cloud_SQL, "Persists regional audit trails and feedback telemetry", "")
Rel(Audit___Traceability_Logger, PubSub, "Routes failed audit payloads to a dead-letter queue", "")

@enduml