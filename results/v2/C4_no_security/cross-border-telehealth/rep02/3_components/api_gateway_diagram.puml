@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Edge Load Balancer, "Edge Load Balancer", "Google Cloud Load Balancing", "Manages secure ingress traffic and distributes requests to the routing engine.")
    Component(Routing & Regional Affinity Engine, "Routing & Regional Affinity Engine", "Envoy Proxy", "Handles regional affinity and routes traffic to backend services based on data residency rules.")
    Component(Security & Policy Filter, "Security & Policy Filter", "Envoy WASM Plugin", "Performs low-latency JWT validation and internal consent header propagation.")
    Component(Resilience & Telemetry Adapter, "Resilience & Telemetry Adapter", "Envoy Circuit Breaker & Stats Filter", "Manages resilience for unstable connections and collects telemetry metrics.")
    Component(Audit & Logging Interceptor, "Audit & Logging Interceptor", "Envoy gRPC Access Log Service (ALS)", "Streams asynchronous compliance auditing logs.")
}

Rel(Edge Load Balancer, Routing & Regional Affinity Engine, "Forwards ingress traffic", "gRPC")
Rel(Routing & Regional Affinity Engine, Security & Policy Filter, "Applies security and policy validation")
Rel(Security & Policy Filter, Resilience & Telemetry Adapter, "Applies circuit breaking and resilience controls")
Rel(Resilience & Telemetry Adapter, Audit & Logging Interceptor, "Triggers asynchronous access logging")
@enduml