@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration / Interoperability Service container

Container_Boundary(integration_service, "Integration / Interoperability Service") {
    Component(Prescription Workflow Orchestrator, "Prescription Workflow Orchestrator", "Java / Spring Boot", "Triggers prescription workflows received from Core Backend Services.")
    Component(Interoperability Camel Router, "Interoperability Camel Router", "Apache Camel", "Routes and transforms messages to interface with external regional pharmacy networks.")
    Component(External Pharmacy Adapter, "External Pharmacy Adapter", "HL7 FHIR / HTTPS / NCPeH", "Sends e-prescriptions to US and EU National Adapters.")
    Component(Audit Event Publisher, "Audit Event Publisher", "PubSub API / gRPC", "Publishes delivery audit events to Cloud Pub/Sub.")
}

Rel(Prescription Workflow Orchestrator, Interoperability Camel Router, "Invokes routing workflow")
Rel(Interoperability Camel Router, External Pharmacy Adapter, "Sends e-prescriptions", "HL7 FHIR / HTTPS / NCPeH")
Rel(Interoperability Camel Router, Audit Event Publisher, "Publishes delivery audit events", "PubSub API / gRPC")
@enduml