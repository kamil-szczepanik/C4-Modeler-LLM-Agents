@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients_EU__US, "Patients (EU & US)", "Patients located in the EU and US accessing telehealth services, video consultations, and the AI symptom checker.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Medical professionals using the system to conduct video consultations and manage patient care.")
Person(Platform_Administrators___Compliance_Officers, "Platform Administrators / Compliance Officers", "Administrators and compliance officers managing and auditing platform operations and regulatory compliance.")

System_Ext(External_Pharmacies_EU__US, "External Pharmacies (EU & US)", "External pharmacy systems receiving e-prescriptions via HL7 FHIR and National Standards.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(Web_Frontend_PWA, "Web Frontend (PWA)", "Next.js / React", "Delivers a lightweight Progressive Web App for unstable rural connections and patient/clinician interactions.")
    Container(API_Gateway, "API Gateway", "Envoy and Cloud Load Balancing", "Manages secure ingress traffic and routing for client applications.")
    Container(Core_Backend_services, "Core Backend services", "Go / Spring Boot", "Powers robust core backend business logic and orchestration.")
    Container(AI_Symptom_Checker, "AI Symptom Checker", "Python / FastAPI", "Executes AI symptom checker microservices.")
    Container(Integration___Interoperability_Service, "Integration / Interoperability Service", "Node.js / Java", "Handles integration and interoperability with external pharmacies and national e-prescription adapters.")
    Container(Media_Relaying_Service, "Media Relaying Service", "LiveKit (SFU/MCU)", "Provides adaptive bitrate WebRTC media streaming for video consultations and low-bandwidth resilience.")
    ContainerDb(Data_Storage, "Data Storage", "Cloud SQL (PostgreSQL) and Cloud Storage", "Secures regionalized health records per strict data residency rules in GKE clusters.")
}

Rel(Patients_EU__US, Web_Frontend_PWA, "Accesses telehealth features and video consultations", "HTTPS / WSS")
Rel(Licensed_Clinicians, Web_Frontend_PWA, "Manages patient interactions and video consultations", "HTTPS / WSS")
Rel(Platform_Administrators___Compliance_Officers, Web_Frontend_PWA, "Monitors platform and compliance data", "HTTPS")
Rel(Web_Frontend_PWA, API_Gateway, "Sends API requests and WebSocket traffic", "HTTPS / WSS")
Rel(Web_Frontend_PWA, Media_Relaying_Service, "Streams video and audio for consultations", "WebRTC")
Rel(API_Gateway, Core_Backend_services, "Routes backend requests", "REST / gRPC")
Rel(Core_Backend_services, AI_Symptom_Checker, "Requests AI symptom analysis", "gRPC")
Rel(Core_Backend_services, Integration___Interoperability_Service, "Triggers prescription and interoperability workflows", "gRPC")
Rel(Core_Backend_services, Data_Storage, "Reads and writes health records and patient data", "PostgreSQL / Cloud SQL Protocol")
Rel(Integration___Interoperability_Service, External_Pharmacies_EU__US, "Sends e-prescriptions using HL7 FHIR (US) and national e-prescription adapters (EU)", "HL7 FHIR / HTTPS")

@enduml