@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_EU_US, "Patients (EU & US)", "Patients located in the EU and US accessing telehealth services, video consultations, and the AI symptom checker.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Medical professionals using the system to conduct video consultations and manage patient care.")
System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides secure video consultations, e-prescriptions, and an AI symptom checker for patients across the EU and US, ensuring strict regional data residency, regulatory compliance, and resilience for low-bandwidth rural users.")
System_Ext(External_Pharmacies_EU_US, "External Pharmacies (EU & US)", "External pharmacy systems receiving e-prescriptions via HL7 FHIR and National Standards.")

Rel(Patients_EU_US, Cross_Border_Telehealth_Platform, "Accesses video consultations, e-prescriptions, and AI symptom checker", "HTTPS / WebRTC")
Rel(Licensed_Clinicians, Cross_Border_Telehealth_Platform, "Conducts secure video consultations and manages patient interactions", "HTTPS / WebRTC")
Rel(Cross_Border_Telehealth_Platform, External_Pharmacies_EU_US, "Sends e-prescriptions using HL7 FHIR (US) and National Standards (EU)", "Mutual TLS / HTTPS")
@enduml