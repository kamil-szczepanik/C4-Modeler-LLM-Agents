@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Cross-Border Telehealth Platform

Person(Patients_Clinicians, "Patients & Clinicians", "End-users accessing the platform via cross-platform web and mobile clients.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and US while enforcing strict regional data residency and compliance.")

System_Ext(External_Pharmacies, "External Pharmacies", "Regional facilities receiving prescriptions via local EU standards and US HL7 FHIR.")
System_Ext(Identity_Providers_IdP, "Identity Providers (IdP)", "Regional OAuth2/OIDC services for user authentication.")
System_Ext(National_Health_Insurance_Systems, "National Health/Insurance Systems", "External platforms for coverage validation and billing.")
System_Ext(Regulatory_Authorities, "Regulatory Authorities", "EU/US auditors accessing immutable logs for EU MDR and HIPAA compliance.")

Rel(Patients_Clinicians, Cross_Border_Telehealth_Platform, "Accesses video consultations, e-prescriptions, and AI symptom checker", "HTTPS and WebRTC routed via Geo-DNS/Anycast")
Rel(Cross_Border_Telehealth_Platform, External_Pharmacies, "Sends prescriptions using local standards and US HL7 FHIR", "Secure REST APIs over HTTPS with mTLS and GCP Pub/Sub")
Rel(Cross_Border_Telehealth_Platform, National_Health_Insurance_Systems, "Performs coverage validation and billing", "Secure REST APIs over HTTPS with mTLS and GCP Pub/Sub")
Rel(Cross_Border_Telehealth_Platform, Identity_Providers_IdP, "Authenticates users", "OAuth2/OIDC token exchange over HTTPS")
Rel(Regulatory_Authorities, Cross_Border_Telehealth_Platform, "Accesses immutable logs for compliance audits", "Zero-Trust Network Access (ZTNA) via secure auditor portals")

@enduml