@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person_Ext(ClinicalManagersResearchers, "Clinical Managers & Researchers", "Users querying regional reports")
System_Ext(RegionalRelationalDatabase, "Regional Relational Database", "Source database for streaming CDC events")

Container_Boundary(RegionalDataWarehouseETL, "Regional Data Warehouse / ETL") {
    Component(IngestionAnonymizationWorker, "Ingestion & Anonymization Worker", "Google Cloud Dataflow (Python)", "Performs PII-stripping and de-identification of streaming CDC events.")
    Component(RegionalAnalyticsStorage, "Regional Analytics Storage", "Google Cloud BigQuery", "Stores regional analytics and secure data for reporting.")
    Component(AuditComplianceLogger, "Audit & Compliance Logger", "Cloud Logging / Pub/Sub", "Captures immutable audit logs and compliance data.")
    Component(DataGovernanceRBACManager, "Data Governance & RBAC Manager", "GCP IAM", "Applies IAM and column-level security.")
}

Rel(RegionalRelationalDatabase, IngestionAnonymizationWorker, "Streams CDC events", "gRPC/JSON via Debezium/Pub/Sub")
Rel(ClinicalManagersResearchers, RegionalAnalyticsStorage, "Queries regional reports", "HTTPS via Looker")
Rel(DataGovernanceRBACManager, RegionalAnalyticsStorage, "Applies IAM and column-level security", "Internal GCP IAM API")

@enduml