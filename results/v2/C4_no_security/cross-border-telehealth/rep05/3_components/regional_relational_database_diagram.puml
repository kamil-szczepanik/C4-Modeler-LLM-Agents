@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Regional Relational Database container

Container_Boundary(regional_relational_database, "Regional Relational Database") {
    Component(Google Cloud SQL PostgreSQL, "Google Cloud SQL PostgreSQL", "Google Cloud SQL PostgreSQL, pgAudit", "Stores transactional data and generates immutable access and transaction logs for compliance.")
    Component(Regional Relational Database Read Replica, "Regional Relational Database Read Replica", "PostgreSQL Replication", "Replicates data asynchronously from the primary database for read-scale.")
    Component(PgBouncer, "PgBouncer", "PgBouncer", "Manages connection spikes and prevents thread exhaustion.")
}

Rel(Google Cloud SQL PostgreSQL, Regional Relational Database Read Replica, "Replicates data asynchronously for read-scale", "Internal PostgreSQL Replication")

@enduml