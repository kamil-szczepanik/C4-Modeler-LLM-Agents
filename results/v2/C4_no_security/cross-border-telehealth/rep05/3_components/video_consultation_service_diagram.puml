@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(video_consultation_service, "Video Consultation Service") {
    Component(SignalingComponent, "Signaling Component", "Node.js / WebSockets", "Manages real-time WebRTC signaling for video consultations.")
    Component(SFUMediaRouter, "SFU Media Router", "MediaSoup / C++ / Node.js", "Handles adaptive bitrate video routing for unstable and low-bandwidth connections.")
    Component(SessionManagementController, "Session Management Controller", "Node.js / Express", "Manages consultation session logic and lifecycle.")
    Component(AuditMetadataLoggerComponent, "Audit & Metadata Logger Component", "Node.js", "Emits and persists compliance audit logs and session metadata.")
}

Rel(SignalingComponent, SFUMediaRouter, "Manages RTP/RTCP media routing", "Internal UDP/TCP")
Rel(SFUMediaRouter, SignalingComponent, "Manages RTP/RTCP media routing", "Internal UDP/TCP")
Rel(SessionManagementController, AuditMetadataLoggerComponent, "Emits session lifecycle events", "Internal gRPC")
@enduml