@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(ai_symptom_checker_service, "AI Symptom Checker Service") {
    Component(Triage_Orchestrator, "Triage Orchestrator", "Python / FastAPI", "Internal component that orchestrates symptom analysis requests and dispatches payload snapshots.")
    Component(Inference_Adapter, "Inference Adapter", "Python / LangChain / PyTorch", "Calculates urgency using AI models and inference runtime.")
    Component(Audit_Traceability_Logger, "Audit & Traceability Logger", "Python Component", "Dispatches payload snapshots and writes immutable records for compliance.")
    Component(Compliance_Exporter, "Compliance Exporter", "Python Background Worker", "Aggregates logs for compliance reports to ensure EU MDR traceability.")
}

Rel(Triage_Orchestrator, Inference_Adapter, "Requests urgency calculation", "In-process async / gRPC")
Rel(Triage_Orchestrator, Audit_Traceability_Logger, "Dispatches payload snapshots", "Cloud Pub/Sub Lite")

@enduml