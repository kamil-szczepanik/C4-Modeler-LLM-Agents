@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(consent_identity_service, "Consent & Identity Service") {
    Component(AuthComponent, "Auth Component", "Keycloak", "Handles OIDC/OAuth2 authentication and user federation.")
    Component(ConsentEnforcementComponent, "Consent Enforcement Component", "Java / Spring Boot", "Evaluates real-time purpose-based access policies and persists purpose-based consent ledgers.")
    Component(AuditTransparencyComponent, "Audit & Transparency Component", "Java / Spring Boot", "Emits and persists long-term compliance audit trails.")
}

Rel(AuthComponent, ConsentEnforcementComponent, "Validates user identity and OIDC tokens", "gRPC / REST")
Rel(ConsentEnforcementComponent, AuditTransparencyComponent, "Emits asynchronous access events", "Google Cloud Pub/Sub")

@enduml