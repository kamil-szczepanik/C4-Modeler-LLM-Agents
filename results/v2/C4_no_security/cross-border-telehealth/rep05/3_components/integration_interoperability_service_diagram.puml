@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration & Interoperability Service container

Container_Boundary(integration_interoperability_service, "Integration & Interoperability Service") {
    Component(api_router_transformer, "API Router & Transformer Component", "Apache Camel / Spring Integration", "Routes integration requests and handles format translation between internal formats and regional standards.")
    Component(us_fhir_connector, "US FHIR Connector Component", "Java / Spring Boot", "Connects to US external pharmacies and health systems using US FHIR standards.")
    Component(eu_national_connector, "EU National Standard Connector Component", "Java / Spring Boot", "Connects to EU national health systems using regional European standards.")
    Component(audit_logging_interceptor, "Audit & Logging Interceptor", "OpenTelemetry", "Secures telemetry, performs PAI/PHI log scrubbing, and streams compliance logs.")
    Component(dlq_handler, "Dead-Letter Queue (DLQ) Handler", "GCP Pub/Sub", "Manages dead-letter queues and asynchronous message retries for failed delivery requests.")
}

System_Ext(big_query, "BigQuery", "Regional Data Warehouse")

Rel(api_router_transformer, us_fhir_connector, "Delegates payloads", "Direct Java Method Calls")
Rel(api_router_transformer, eu_national_connector, "Delegates payloads", "Direct Java Method Calls")
Rel(us_fhir_connector, dlq_handler, "Captures failed delivery messages", "GCP Pub/Sub")
Rel(eu_national_connector, dlq_handler, "Captures failed delivery messages", "GCP Pub/Sub")
Rel(audit_logging_interceptor, big_query, "Streams scrubbed compliance logs", "gRPC / TLS")

@enduml