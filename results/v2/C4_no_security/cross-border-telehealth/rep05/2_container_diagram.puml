@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients_Clinicians, "Patients & Clinicians", "End-users accessing secure video consultations, e-prescriptions, and the AI symptom checker.")

System_Ext(External_Pharmacies, "External Pharmacies", "External facilities receiving prescriptions via regional standards and HL7 FHIR.")
System_Ext(Identity_Providers, "Identity Providers", "External identity providers integrated with regional authentication flows.")
System_Ext(National_Health_Systems, "National Health Systems", "External national health and insurance systems.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(API_Gateway_BFF, "API Gateway / BFF", "Envoy / Cloud Endpoints", "Routes external requests and provides Backend-For-Frontend services.")
    Container(Video_Consultation_Service, "Video Consultation Service", "MediaSoup WebRTC SFU", "Delivers adaptive bitrate video consultations for unstable connections.")
    Container(AI_Symptom_Checker_Service, "AI Symptom Checker Service", "Python / FastAPI", "Powers the AI symptom checker with model version logging.")
    Container(Integration_Interoperability_Service, "Integration & Interoperability Service", "REST, HL7 FHIR", "Handles interoperability with external pharmacies and regional standards.")
    Container(Consent_Identity_Service, "Consent & Identity Service", "Keycloak", "Manages identity, authentication, and granular consents.")
    ContainerDb(Regional_Relational_Database, "Regional Relational Database", "Google Cloud SQL PostgreSQL", "Manages transactional healthcare records and granular consents.")
    ContainerDb(Regional_Data_Warehouse_ETL, "Regional Data Warehouse / ETL", "BigQuery", "Processes anonymized regional analytics via ETL without violating privacy laws.")
}

Rel(Patients_Clinicians, API_Gateway_BFF, "Sends client requests for consultations, prescriptions, and symptoms", "HTTPS / WebSockets / WebRTC (UDP/TCP)")
Rel(API_Gateway_BFF, Video_Consultation_Service, "Forwards video consultation traffic", "gRPC / REST")
Rel(API_Gateway_BFF, AI_Symptom_Checker_Service, "Forwards symptom analysis requests", "gRPC / REST")
Rel(API_Gateway_BFF, Consent_Identity_Service, "Validates authentication and user sessions", "gRPC / REST")
Rel(API_Gateway_BFF, Integration_Interoperability_Service, "Routes interoperability requests", "gRPC / REST")
Rel(Integration_Interoperability_Service, External_Pharmacies, "Sends prescriptions and data using regional standards and HL7 FHIR", "REST")
Rel(AI_Symptom_Checker_Service, Regional_Relational_Database, "Reads and writes transactional data", "TLS")
Rel(Video_Consultation_Service, Regional_Relational_Database, "Persists consultation metadata", "TLS")
Rel(Consent_Identity_Service, Regional_Relational_Database, "Stores user identity and consent records", "TLS")
Rel(Integration_Interoperability_Service, Regional_Relational_Database, "Persists integrated healthcare records", "TLS")
Rel(Regional_Relational_Database, Regional_Data_Warehouse_ETL, "Syncs anonymized analytics via ETL", "Internal ETL pipeline")

@enduml