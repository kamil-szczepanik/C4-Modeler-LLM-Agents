@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Cross-Border Telehealth Platform

Person(Patients_EU_US, "Patients (EU/US)", "End-users accessing telehealth services, managing privacy consents, and utilizing the AI symptom checker.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Medical professionals conducting remote video consultations and reviewing patient records.")
Person(Pharmacists_EU_US, "Pharmacists (EU/US)", "Local providers receiving standards-compliant e-prescriptions.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and US while ensuring strict regional data residency and compliance.")

System_Ext(Third_Party_Video_Infrastructure, "Third-Party Video Infrastructure", "WebRTC/Twilio API for video consultations.")
System_Ext(National_E_Prescription_Gateways_US_Pharmacy_Networks, "National E-Prescription Gateways & US Pharmacy Networks", "External systems handling local prescriptions.")
System_Ext(AI_LLM_Diagnostic_Provider, "AI LLM / Diagnostic Provider", "GCP Vertex AI powering the symptom checker.")
System_Ext(Payment_Gateway, "Payment Gateway", "External service for cross-border transactions.")
System_Ext(Identity_Providers_IdP, "Identity Providers (IdP)", "OAuth2/OIDC providers for authentication (e.g., eIDAS).")
System_Ext(Notification_Service, "Notification Service", "Twilio SendGrid/SMS API for reminders and alerts.")

Rel(Patients_EU_US, Cross_Border_Telehealth_Platform, "Accesses telehealth services, privacy consents, and AI symptom checker", "HTTPS/WSS")
Rel(Licensed_Clinicians, Cross_Border_Telehealth_Platform, "Conducts remote video consultations and reviews patient records", "HTTPS/WSS")
Rel(Cross_Border_Telehealth_Platform, National_E_Prescription_Gateways_US_Pharmacy_Networks, "Sends e-prescriptions (HL7 FHIR for US, national standards for EU)", "HTTPS/REST")
Rel(Cross_Border_Telehealth_Platform, AI_LLM_Diagnostic_Provider, "Powers the symptom checker and AI diagnostic features", "gRPC/HTTPS")
Rel(Cross_Border_Telehealth_Platform, Payment_Gateway, "Processes cross-border transactions", "HTTPS/REST")
Rel(Cross_Border_Telehealth_Platform, Notification_Service, "Sends reminders and alerts", "HTTPS/REST")
Rel(Cross_Border_Telehealth_Platform, Identity_Providers_IdP, "Authenticates users via OAuth2/OIDC", "HTTPS/REST")

@enduml