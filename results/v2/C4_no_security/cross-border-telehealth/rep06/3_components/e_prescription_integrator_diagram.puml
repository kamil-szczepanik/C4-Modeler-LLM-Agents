@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the E-Prescription Integrator container

Container_Boundary(e_prescription_integrator, "E-Prescription Integrator") {
    Component(PrescriptionRouter, "Prescription Router", "Node.js / Express", "Routes prescription requests to appropriate regional pharmacy networks securely.")
    Component(ValidationEngine, "Validation Engine", "Python / Cerberus", "Validates prescription payloads against international healthcare standards.")
}

Rel(PrescriptionRouter, ValidationEngine, "Sends payload for schema and compliance validation")

@enduml