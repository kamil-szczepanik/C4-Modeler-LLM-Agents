@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Symptom Service container

System_Ext(ai_llm_provider, "AI LLM Provider", "External AI Large Language Model provider")
System_Ext(regional_cloud_storage, "Regional Cloud Storage", "GCP Cloud Storage with WORM compliance")

Container_Boundary(ai_symptom_service, "AI Symptom Service") {
    Component(api_router_controller_component, "API Router / Controller Component", "Python / FastAPI", "Routes symptom check requests and manages HTTP/REST/gRPC entrypoints.")
    Component(localization_normalization_engine, "Localization & Normalization Engine", "Python / Pydantic", "Contains the Clinical Semantic Normalizer sub-component to normalize raw patient inputs using regional localization dictionaries.")
    Component(llm_orchestrator_component, "LLM Orchestrator Component", "Python / FastAPI", "Coordinates diagnostic prompts and manages communication with the external AI LLM Provider.")
    Component(audit_traceability_logger_component, "Audit & Traceability Logger Component", "Python / GCP Pub/Sub Lite / Local Redis", "Writes versioned inputs, outputs, and model versions asynchronously to regional cloud storage for MDR compliance.")
}

Rel(api_router_controller_component, localization_normalization_engine, "Passes raw patient inputs", "In-memory Pydantic models")
Rel(localization_normalization_engine, llm_orchestrator_component, "Sends normalized clinical data", "In-memory Pydantic models")
Rel(llm_orchestrator_component, ai_llm_provider, "Sends diagnostic prompts and receives AI responses", "HTTPS")
Rel(audit_traceability_logger_component, regional_cloud_storage, "Writes versioned inputs, outputs, and model versions", "HTTPS / Direct Write")

@enduml