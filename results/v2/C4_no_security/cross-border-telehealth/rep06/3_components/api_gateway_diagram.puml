@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(routing_geo_dispatcher, "Routing & Regional Geo-Dispatcher", "GCP Cloud Endpoints / API Gateway", "Enforces geographic routing, data residency, and unified traffic distribution across regions.")
    Component(auth_scope_validator, "Auth & Scope Validator", "GCP Cloud Endpoints / API Gateway", "Validates authentication scopes and identities against compliance regulations.")
    Component(resilience_proxy, "Resilience Proxy", "GCP Cloud Endpoints / API Gateway", "Manages fallback logic and high availability for unstable network connections.")
}

System_Ext(core_telehealth_service, "Core Telehealth Service", "Core telehealth operations and business logic.")
System_Ext(ai_symptom_service, "AI Symptom Service", "AI-powered symptom analysis service.")
System_Ext(consent_identity_container, "Consent & Identity Container", "Manages consent and identity tokens.")
System_Ext(redis_cache, "Redis Cache", "Powers low-latency rate limiting and token caching.")

Rel(routing_geo_dispatcher, core_telehealth_service, "Invokes telehealth operations", "gRPC / REST")
Rel(routing_geo_dispatcher, ai_symptom_service, "Invokes symptom analysis", "gRPC / REST")
Rel(auth_scope_validator, consent_identity_container, "Validates consent and identity tokens", "gRPC")
Rel(resilience_proxy, redis_cache, "Caches tokens and rate-limiting data", "TCP")

@enduml