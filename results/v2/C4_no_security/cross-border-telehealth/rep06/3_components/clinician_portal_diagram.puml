@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Clinician Portal container

System_Ext(ThirdPartyVideoSDK, "Third-Party Video SDK", "External video service provider")
System_Ext(APIGateway, "API Gateway", "GCP Cloud Endpoints")

Container_Boundary(ClinicianPortal_boundary, "Clinician Portal") {
    Component(ClinicianPortal, "Clinician Portal", "React / TypeScript SPA", "Frontend single-page application for licensed clinicians to manage consultations and patient records.")
    Component(AuthJurisdictionContextManager, "Auth & Jurisdiction Context Manager", "TypeScript", "Manages authentication and jurisdiction context for cross-border compliance.")
    Component(ConsultationWorkspace, "Consultation Workspace", "React", "Provides the interface for active video consultations and clinical notes.")
    Component(AITriageAuditWidget, "AI Triage & Audit Widget", "React / TypeScript", "Interfaces with the AI symptom service and handles audit logging.")
    Component(OfflineDraftManager, "Offline Draft Manager", "IndexedDB", "Handles local persistence for consultation drafts during unstable connections.")
    Component(EPrescriptionRecordManager, "E-Prescription & Record Manager", "TypeScript", "Manages e-prescriptions and medical records within the clinician workspace.")
}

Rel(ClinicianPortal, AuthJurisdictionContextManager, "Authenticates and establishes jurisdiction context")
Rel(ClinicianPortal, ConsultationWorkspace, "Renders active video consultation interface")
Rel(ConsultationWorkspace, ThirdPartyVideoSDK, "Integrates via WebRTC", "WebRTC")
Rel(ConsultationWorkspace, OfflineDraftManager, "Utilizes IndexedDB for local persistence", "IndexedDB")
Rel(AITriageAuditWidget, APIGateway, "Communicates for audit logging", "HTTPS/JSON")
Rel(ClinicianPortal, APIGateway, "Accesses backend services", "HTTPS/REST and gRPC-Web")

@enduml