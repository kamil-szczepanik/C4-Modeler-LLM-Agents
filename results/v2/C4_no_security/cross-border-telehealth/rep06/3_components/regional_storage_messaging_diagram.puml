@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(regional_storage_messaging, "Regional Storage & Messaging") {
    Component(GCP_Cloud_SQL_PostgreSQL, "GCP Cloud SQL (PostgreSQL)", "GCP Cloud SQL (PostgreSQL)", "Provides isolated regional relational storage with row-level security and append-only audit tables.")
    Component(GCP_Cloud_Pub_Sub, "GCP Cloud Pub/Sub", "GCP Cloud Pub/Sub with Dead-Letter Queues (DLQ)", "Handles asynchronous event streaming and offline queuing with 7-to-14-day retention for rural resilience.")
    Component(GCP_Cloud_KMS, "GCP Cloud KMS", "GCP Cloud KMS", "Enforces regional compliance via Customer-Managed Encryption Keys (europe-west3 and us-central1).")
    Component(Cloud_Monitoring_Cloud_Functions, "Cloud Monitoring & Cloud Functions", "Cloud Monitoring & Cloud Functions", "Automates operational alerts and DLQ monitoring for system reliability.")
}

Rel(GCP_Cloud_SQL_PostgreSQL, GCP_Cloud_KMS, "Encrypts regional data using region-specific keys", "")
Rel(GCP_Cloud_Pub_Sub, Cloud_Monitoring_Cloud_Functions, "Triggers alerting payloads on DLQ threshold breaches", "")

@enduml