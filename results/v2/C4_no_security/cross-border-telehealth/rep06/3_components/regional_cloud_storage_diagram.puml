@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Regional Cloud Storage container

Container_Boundary(regional_cloud_storage, "Regional Cloud Storage") {
    Component(GCP_Cloud_Storage, "GCP Cloud Storage", "GCP Cloud Storage (Regional Storage Buckets in europe-west3 and us-central1) with Object Versioning and Bucket Lock", "Region-locked, immutable, and secure storage buckets providing versioned audit logs and custom metadata for AI symptom-checker outputs.")
    Component(AI_Symptom_Service, "AI Symptom Service", "Python / FastAPI", "Service that writes versioned audit logs and custom metadata to regional cloud storage.")
    Component(GCP_Cloud_KMS, "GCP Cloud KMS", "GCP Cloud Key Management Service", "Provides Customer-Managed Encryption Keys (CMEK) with regional key rings for strict data protection and encryption of audit logs.")
    Component(Cloud_Monitoring_Logging, "Cloud Monitoring & Logging", "GCP Cloud Monitoring API", "Monitors bucket metrics, errors, and IAM denials.")
}

Rel(AI_Symptom_Service, GCP_Cloud_Storage, "Writes versioned audit logs and custom metadata", "HTTPS / Storage API")
Rel(GCP_Cloud_Storage, GCP_Cloud_KMS, "Encrypts audit logs using Customer-Managed Encryption Keys", "Internal GCP API")
Rel(Cloud_Monitoring_Logging, GCP_Cloud_Storage, "Monitors bucket metrics, errors, and IAM denials", "Cloud Monitoring API")

@enduml