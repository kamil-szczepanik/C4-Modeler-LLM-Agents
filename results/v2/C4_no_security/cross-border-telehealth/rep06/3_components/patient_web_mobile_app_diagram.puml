@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient Web/Mobile App container

System_Ext(GCP_Cloud_Endpoints_API_Gateway, "GCP Cloud Endpoints / API Gateway", "Regional API Gateway")

Container_Boundary(Patient_Web_Mobile_App, "Patient Web/Mobile App") {
    Component(UIRouterLocalizationComponent, "UI Router & Localization Component", "Flutter / WASM", "Handles internal application routing, UI rendering, and localization for cross-platform clients.")
    Component(OfflineStateSyncManager, "Offline State & Sync Manager", "Hive / SQLite with SQLCipher", "Manages local secure client storage and synchronization for offline resilience under low bandwidth.")
    Component(APIClientComponent, "API Client Component", "Flutter / WASM", "Connects to the regional API Gateway using TLS 1.3 / HTTPS to facilitate communication.")
    Component(ConsentProfileController, "Consent & Profile Controller", "Flutter / WASM", "Manages patient consent and profile information on the client side.")
    Component(AITransparencyAccessibilityComponent, "AI Transparency & Accessibility Component", "Flutter / WASM", "Provides AI transparency and accessibility features within the client application.")
    Component(TelemetryErrorBoundaryComponentwithDataScrubbingMiddleware, "Telemetry & Error Boundary Component with Data Scrubbing Middleware", "OpenTelemetry / Firebase Crashlytics", "Handles client-side observability and automated PII scrubbing middleware.")
}

Rel(UIRouterLocalizationComponent, AITransparencyAccessibilityComponent, "Delegates rendering and interaction", "Internal Routing")
Rel(UIRouterLocalizationComponent, ConsentProfileController, "Delegates consent management", "Internal Routing")
Rel(AITransparencyAccessibilityComponent, APIClientComponent, "Communicates via", "HTTPS/REST and WebSockets")
Rel(OfflineStateSyncManager, APIClientComponent, "Communicates state sync via", "HTTPS/REST and WebSockets")
Rel(APIClientComponent, GCP_Cloud_Endpoints_API_Gateway, "Connects to regional API Gateway", "TLS 1.3 / HTTPS")

@enduml