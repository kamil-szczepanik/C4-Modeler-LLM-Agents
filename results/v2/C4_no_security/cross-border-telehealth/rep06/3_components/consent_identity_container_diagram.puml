@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Consent & Identity Container container

System_Ext(api_gateway, "API Gateway", "GCP Cloud Endpoints / API Gateway")
System_Ext(client_apps, "Client Apps", "Patients and Clinicians")

Container_Boundary(consent_identity_container, "Consent & Identity Container") {
    Component(token_service, "Token Service", "Keycloak / GCP Identity Platform", "Manages user tokens and authentication state.")
    Component(consent_engine, "Consent Engine", "Java / Spring Boot", "Evaluates fine-grained consent policies for the platform.")
    Component(consent_ledger_service, "Consent Ledger Service", "Go / gRPC", "Provides high-throughput, low-latency audit logging for user consent history.")
    Component(federated_identity_broker, "Federated Identity Broker", "Keycloak SPI / OAuth2 Proxy", "Authenticates users via external IdPs.")
    ComponentDb(iam_database, "IAM Database", "GCP Cloud SQL - PostgreSQL", "Provides isolated regional databases to satisfy data residency requirements.")
    Component(gcp_cloud_kms, "GCP Cloud KMS", "GCP Cloud HSM", "Secures regional cryptographic keys to ensure tamper-evident audit trails.")
}

Rel(api_gateway, consent_engine, "Evaluates fine-grained consent policies", "gRPC")
Rel(client_apps, federated_identity_broker, "Authenticates users via external IdPs", "REST/HTTPS")
Rel(client_apps, consent_ledger_service, "Accesses user audit history", "REST/HTTPS")
Rel(token_service, gcp_cloud_kms, "Secures signing and hashing keys", "GCP Internal API")
Rel(consent_ledger_service, gcp_cloud_kms, "Secures signing and hashing keys", "GCP Internal API")

@enduml