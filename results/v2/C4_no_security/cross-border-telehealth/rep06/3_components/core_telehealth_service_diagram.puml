@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "External API Gateway")
System_Ext(client_apps, "Client Applications", "External Client Applications")

Container_Boundary(core_telehealth_service, "Core Telehealth Service") {
    Component(ConsultationSessionManager, "Consultation Session Manager", "Go", "Orchestrates video consultation lifecycles and states.")
    Component(BandwidthAdaptabilityController, "Bandwidth Adaptability Controller", "Go", "Monitors QoS and triggers network fallback modes.")
    Component(RegionalRoutingAuditInterceptor, "Regional Routing & Audit Interceptor", "Go / gRPC Middleware", "Enforces data residency and logs access events.")
    Component(FallbackSignalingComponent, "Fallback Signaling Component", "Go", "Pushes audio/text fallback states to clients.")
    Component(ConsentAuditLogger, "Consent & Audit Logger", "Go", "Captures cross-border access attempts for compliance.")
    Component(GCPGKECloudSQL, "GCP GKE & Cloud SQL", "PostgreSQL", "Regional hosting and isolated database storage.")
    Component(GCPHTTPSLoadBalancerRedis, "GCP HTTP(S) Load Balancer & Redis", "Redis, GCP HTTP(S) Load Balancer", "Manages persistent WebSocket connections and session affinity.")
}

Rel(api_gateway, ConsultationSessionManager, "Initiates session commands", "gRPC")
Rel(ConsultationSessionManager, BandwidthAdaptabilityController, "Evaluates QoS metrics", "Internal Go Channel")
Rel(BandwidthAdaptabilityController, FallbackSignalingComponent, "Triggers fallback state", "Internal Go Channel")
Rel(RegionalRoutingAuditInterceptor, ConsentAuditLogger, "Forwards access events", "gRPC")
Rel(FallbackSignalingComponent, client_apps, "Pushes fallback commands", "WebSocket / HTTPS")

@enduml