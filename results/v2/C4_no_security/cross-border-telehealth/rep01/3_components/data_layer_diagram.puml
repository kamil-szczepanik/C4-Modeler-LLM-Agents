@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(CoreTelehealthService, "Core Telehealth Service", "External component interacting with the Data Layer")
System_Ext(PatientPortal, "Patient Portal", "External component interacting with the Data Layer")
System_Ext(AIGateway, "AI Gateway", "External component interacting with the Data Layer")

Container_Boundary(DataLayer, "Data Layer") {
    Component(CloudSQLPostgreSQL, "Cloud SQL PostgreSQL", "Google Cloud Platform / PostgreSQL", "Stores structured patient profiles, encrypted PHI, and consent states with row-level security.")
    Component(FirestoreRegional, "Firestore (Regional)", "Google Cloud Platform / Firestore", "Acts as a real-time sync and caching broker for intermittent connections.")
    Component(CloudStorage, "Cloud Storage", "Google Cloud Platform / Cloud Storage", "Stores consultation recordings and clinical documents encrypted with CMEK with regional locks.")
    Component(CloudKMS, "Cloud KMS", "Google Cloud Platform / Cloud KMS", "Manages regional Customer-Managed Encryption Keys for cryptographic isolation and data purging.")
}

Rel(CoreTelehealthService, CloudSQLPostgreSQL, "SQL over TLS 1.3")
Rel(PatientPortal, FirestoreRegional, "Real-time sync over HTTPS/WebSockets (regional endpoints)")
Rel(AIGateway, CloudSQLPostgreSQL, "SQL over TLS 1.3 (write-once) for Audit & Traceability Store")
Rel(CoreTelehealthService, CloudKMS, "Envelope encryption via Cloud KMS API")
@enduml