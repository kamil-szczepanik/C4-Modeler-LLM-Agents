@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Telehealth Service container

Container_Boundary(core_telehealth_service, "Core Telehealth Service") {
    Component(Consultation_Orchestrator, "Consultation Orchestrator", "Go", "Manages cross-border video consultations, stream parameters adjustment, and low-bandwidth resilience.")
    Component(Consent_Policy_Engine, "Consent & Policy Engine", "Go, Open Policy Agent", "Validates access rights and enforces GDPR/HIPAA compliance and consent rules.")
    Component(Prescription_Coordinator, "Prescription Coordinator", "Go", "Coordinates e-prescriptions and publishes prescription status updates.")
    Component(Notification_Event_Publisher, "Notification Event Publisher", "Go, Cloud Pub/Sub", "Publishes stream degradation events and asynchronous notifications with Dead Letter Queues.")
}

System_Ext(webrtc_sfu_media_server, "WebRTC SFU Media Server", "External Media Server")

Rel(Consultation_Orchestrator, webrtc_sfu_media_server, "Adjusts stream parameters", "gRPC / WebRTC control plane")
Rel(Consultation_Orchestrator, Consent_Policy_Engine, "Validates access rights", "In-memory / gRPC")
Rel(Consultation_Orchestrator, Notification_Event_Publisher, "Publishes stream degradation events", "Asynchronous / Cloud Pub/Sub")
Rel(Prescription_Coordinator, Notification_Event_Publisher, "Publishes prescription status updates", "Asynchronous / Cloud Pub/Sub")

@enduml