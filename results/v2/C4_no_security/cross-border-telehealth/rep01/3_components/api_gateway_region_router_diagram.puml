@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway / Region Router container

Container_Boundary(api_gateway_region_router, "API Gateway / Region Router") {
    Component(Edge Router & TLS Terminator, "Edge Router & TLS Terminator", "Envoy Proxy, Anycast", "Handles edge routing, TLS termination, HTTP/3 (QUIC) and WSS connectivity for unstable rural connections.")
    Component(Cloud Endpoints Gateway, "Cloud Endpoints Gateway", "Cloud Endpoints", "Manages API routing and request validation across EU and US regions.")
    Component(Geo-fencing & Context Injector, "Geo-fencing & Context Injector", "Envoy Filter / Go", "Enforces strict data residency and compliance by injecting context without modifying core microservices.")
}

Rel(Edge Router & TLS Terminator, Cloud Endpoints Gateway, "Forwards terminated HTTPS/WSS/QUIC traffic", "")
Rel(Cloud Endpoints Gateway, Geo-fencing & Context Injector, "Injects compliance and routing context", "")
@enduml