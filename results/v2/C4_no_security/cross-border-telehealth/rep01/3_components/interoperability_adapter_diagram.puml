@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Interoperability Adapter container

Container_Boundary(interoperability_adapter, "Interoperability Adapter") {
    Component(us_fhir_translator_component, "US FHIR Translator Component", "Go, GKE", "Translates core telehealth payloads into US-specific FHIR formats for US pharmacy networks.")
    Component(eu_national_gateway_adapter_component, "EU National Gateway Adapter Component", "Go, GKE", "Adapts core telehealth payloads to conform with EU national e-prescription gateway requirements.")
    Component(prescription_status_retry_queue_component, "Prescription Status & Retry Queue Component", "Google Cloud Pub/Sub", "Handles asynchronous messaging for reliable retry queues and dead-letter routing of prescription states.")
    Component(prescription_status_manager_component, "Prescription Status Manager Component", "Go", "Manages and emits standardized status updates based on transmission events.")
}

Rel(us_fhir_translator_component, prescription_status_retry_queue_component, "Publishes success/failure states", "Google Cloud Pub/Sub")
Rel(eu_national_gateway_adapter_component, prescription_status_retry_queue_component, "Publishes success/failure states", "Google Cloud Pub/Sub")
Rel(prescription_status_retry_queue_component, prescription_status_manager_component, "Delivers transmission events", "Internal Pub/Sub")
@enduml