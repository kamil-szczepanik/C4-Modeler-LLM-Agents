@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(webrtc_sfu_media_server, "WebRTC SFU Media Server") {
    Component(LiveKit_SFU_Node, "LiveKit SFU Node", "LiveKit, Go, WebRTC", "Handles real-time video and audio stream routing for consultations.")
    Component(Janus_Gateway, "Janus Gateway", "C, Janus, WebRTC", "Provides auxiliary media routing and fallback streaming capabilities.")
    Component(Bandwidth_Adapter, "Bandwidth Adapter", "Python, WebRTC", "Manages dynamic bitrate scaling and adaptive streaming for low-bandwidth rural environments.")
}

Rel(LiveKit_SFU_Node, Bandwidth_Adapter, "Sends stream metrics to")
Rel(Janus_Gateway, Bandwidth_Adapter, "Sends fallback stream metrics to")
@enduml