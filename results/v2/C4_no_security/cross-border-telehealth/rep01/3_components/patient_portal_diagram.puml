@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway_region_router, "API Gateway / Region Router", "Cloud Endpoints and Envoy routing cross-region traffic")

Container_Boundary(patient_portal, "Patient Portal") {
    Component(spa_router_view_manager, "SPA Router & View Manager", "React, Flutter", "Manages application views, user routing, and UI state for telehealth services.")
    Component(offline_storage_manager, "Offline Storage Manager", "IndexedDB, Web Crypto API (AES-GCM 256)", "Handles secure offline data persistence and encryption for resilient access.")
    Component(api_communication_client, "API Communication Client", "HTTPS, WSS, GCP Cloud CDN", "Transmits API requests, video telemetry, and real-time messaging to the region router.")
}

Rel(spa_router_view_manager, offline_storage_manager, "Persists and retrieves encrypted health data locally")
Rel(spa_router_view_manager, api_communication_client, "Initiates HTTP and WebSocket requests")
Rel(api_communication_client, api_gateway_region_router, "Routes API requests and telemetry via Cloud CDN", "HTTPS, WSS")
@enduml