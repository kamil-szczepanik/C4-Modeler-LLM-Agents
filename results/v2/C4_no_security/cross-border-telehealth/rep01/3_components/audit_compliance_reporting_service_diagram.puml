@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit & Compliance Reporting Service container

Container_Boundary(audit_compliance_reporting_service, "Audit & Compliance Reporting Service") {
    Component(Log_Ingestion_Engine, "Log Ingestion Engine", "Go", "Ingests compliance and audit logs via gRPC over internal VPC.")
    Component(Jurisdictional_Storage_Router, "Jurisdictional Storage Router", "Go", "Routes logs and data to appropriate regional storage ensuring data residency.")
    Component(Report_Generation___Query_API, "Report Generation & Query API", "Node.js/GraphQL", "Provides GraphQL API for compliance reporting and dashboard queries.")
    Component(Compliance___Export_Orchestrator, "Compliance & Export Orchestrator", "Node.js", "Orchestrates compliance tasks and exports via Cloud Pub/Sub.")
}

Rel(Log_Ingestion_Engine, Jurisdictional_Storage_Router, "Passes log data via in-process calls", "")
Rel(Report_Generation___Query_API, Compliance___Export_Orchestrator, "Queries orchestration data and triggers reports", "")

@enduml