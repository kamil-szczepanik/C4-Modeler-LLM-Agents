@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients_EU_and_US, "Patients (EU and US)", "Patients from the EU and US seeking secure video consultations, e-prescriptions, and AI symptom checking.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Licensed medical professionals conducting secure video consultations and managing patient care.")

System_Ext(AI_Symptom_Checker_Engine, "AI Symptom Checker Engine", "External Medical Device providing AI-powered symptom checking via REST/gRPC.")
System_Ext(EU_National_E_Prescription_Gateways_and_US_Pharmacy_Networks, "EU National E-Prescription Gateways and US Pharmacy Networks", "External systems handling cross-border prescriptions and pharmacy network integrations.")
System_Ext(Identity_Providers, "Identity Providers", "EU eID / US OAuth/SAML providers for user authentication.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(Patient_Portal, "Patient Portal", "React, Flutter, IndexedDB", "Single Page Application (SPA) providing user interface with local offline caching for resilience.")
    Container(API_Gateway_Region_Router, "API Gateway / Region Router", "Cloud Endpoints, Envoy", "Routes client requests to regional deployments and enforces entry security.")
    Container(Core_Telehealth_Service, "Core Telehealth Service", "GKE, Node.js, Go, Python", "Handles core telehealth business logic and service execution.")
    Container(AI_Gateway, "AI Gateway", "GKE, Node.js, Go, Python", "Interfaces with the external AI Symptom Checker Engine.")
    Container(Interoperability_Adapter, "Interoperability Adapter", "GKE, Node.js, Go, Python", "Integrates with external EU e-prescription gateways and US pharmacy networks.")
    Container(Audit_Compliance_Reporting_Service, "Audit & Compliance Reporting Service", "GKE, Node.js, Go, Python", "Monitors and logs activity to ensure adherence to GDPR, HIPAA, and data residency.")
    Container(WebRTC_SFU_Media_Server, "WebRTC SFU Media Server", "LiveKit, Janus", "Manages real-time video consultations with dynamic bitrate scaling.")
    ContainerDb(Data_Layer, "Data Layer", "Cloud SQL PostgreSQL, Firestore, Cloud Storage", "Provides transactional data storage, state caching, and secure file storage.")
}

Rel(Patients_EU_and_US, Patient_Portal, "Interact with the patient portal for consultations and health services", "HTTPS and WSS")
Rel(Licensed_Clinicians, Patient_Portal, "Interact with the patient portal to conduct consultations", "HTTPS and WSS")
Rel(Patient_Portal, API_Gateway_Region_Router, "Communicates with API gateway for routing requests", "HTTPS/WSS")
Rel(API_Gateway_Region_Router, Core_Telehealth_Service, "Routes calls to core microservices internally", "gRPC over internal VPC networks")
Rel(API_Gateway_Region_Router, AI_Gateway, "Routes AI symptom check requests", "gRPC over internal VPC networks")
Rel(API_Gateway_Region_Router, Interoperability_Adapter, "Routes prescription and pharmacy network tasks", "gRPC over internal VPC networks")
Rel(API_Gateway_Region_Router, Audit_Compliance_Reporting_Service, "Sends audit logs for compliance monitoring", "gRPC over internal VPC networks")
Rel(Core_Telehealth_Service, WebRTC_SFU_Media_Server, "Coordinates real-time video session streaming", "WebRTC")
Rel(Core_Telehealth_Service, Data_Layer, "Reads and writes transactional and state data", "PostgreSQL, Firestore, Cloud Storage")
Rel(AI_Gateway, AI_Symptom_Checker_Engine, "Connects to external AI symptom checker engine", "mTLS")
Rel(Interoperability_Adapter, EU_National_E_Prescription_Gateways_and_US_Pharmacy_Networks, "Integrates with external prescription and pharmacy networks", "mTLS")
Rel(API_Gateway_Region_Router, Identity_Providers, "Authenticates users against regional identity providers", "HTTPS")

@enduml