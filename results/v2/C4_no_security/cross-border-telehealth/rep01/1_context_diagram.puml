@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients (EU and US)", "Patients from the EU and US seeking secure video consultations, e-prescriptions, and AI symptom checking.")
Person(Clinicians, "Licensed Clinicians", "Licensed medical professionals conducting secure video consultations and managing patient care.")

System(Platform, "Cross-Border Telehealth Platform", "Provides secure video consultations, e-prescriptions, and AI symptom checking for EU and US patients while strictly enforcing regional data residency and compliance with GDPR, HIPAA, and EU MDR.")

System_Ext(AISymptomChecker, "AI Symptom Checker Engine", "External Medical Device providing AI-powered symptom checking via REST/gRPC.")
System_Ext(PrescriptionGateways, "EU National E-Prescription Gateways and US Pharmacy Networks", "External systems handling cross-border prescriptions and pharmacy network integrations.")
System_Ext(NotificationService, "Notification Service", "Twilio/FCM service utilized via regional asynchronous message queues for notifications.")
System_Ext(IdentityProviders, "Identity Providers", "EU eID / US OAuth/SAML providers for user authentication.")

Rel(Patients, Platform, "Interact with the Platform for video consultations and health services", "HTTPS and WebRTC")
Rel(Clinicians, Platform, "Interact with the Platform to conduct consultations and manage care", "HTTPS and WebRTC")
Rel(Platform, PrescriptionGateways, "Connects to external pharmacy networks and e-prescription gateways", "Secured APIs (TLS 1.3)")
Rel(Platform, AISymptomChecker, "Integrates with external AI symptom checker engine with payload logging", "REST/gRPC (TLS 1.3)")
Rel(Platform, NotificationService, "Utilizes regional asynchronous message queues for notifications", "Twilio/FCM")
Rel(Platform, IdentityProviders, "Authenticates users via regional identity providers", "EU eID / US OAuth/SAML")

@enduml