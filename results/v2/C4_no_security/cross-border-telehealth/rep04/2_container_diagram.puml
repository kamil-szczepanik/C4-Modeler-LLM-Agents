@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients_EU_US, "Patients (EU & US)", "Patients in the EU and US seeking video consultations, e-prescriptions, and AI symptom checking.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Medical professionals providing video consultations and healthcare services to patients.")

System_Ext(Pharmacies, "Pharmacies", "External pharmacies fulfilling e-prescriptions.")
System_Ext(Identity_Providers_Auth0_GCP_IAM, "Identity Providers (Auth0/GCP IAM)", "Handles secure authentication and identity management.")
System_Ext(National_e_Prescription_Gateways, "National e-Prescription Gateways", "Gateways for transmitting and managing e-prescriptions.")
System_Ext(Stripe, "Stripe", "Payment gateway for processing financial transactions.")
System_Ext(Twilio, "Twilio", "API for SMS and communication alerts.")
System_Ext(SendGrid, "SendGrid", "API for email notifications.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(Web_Mobile_Client, "Web/Mobile Client", "Flutter / React Native", "Client application providing user interfaces for patients and clinicians with offline-first local SQLite caching.")
    Container(API_Gateway, "API Gateway", "Cloud Endpoints / Envoy", "Routes internal traffic and handles mTLS and JWT validation.")
    Container(Core_Telehealth_Backend, "Core Telehealth Backend", "Node.js / Go", "Stateless microservice handling core telehealth business logic and e-prescriptions.")
    Container(AI_Symptom_Checker, "AI Symptom Checker", "Containerized AI Service", "Provides AI-powered symptom checking for patients.")
    Container(Consent_Management, "Consent Management", "Containerized Service", "Manages user consents and regulatory compliance records.")
    Container(Billing_Subscriptions, "Billing & Subscriptions", "Go", "Manages billing, subscriptions, and integrations with payment gateways.")
    Container(Notification_Container, "Notification Container", "Containerized Service", "Triggers SMS, email, and push notifications via external APIs.")
    Container(Video_Media_Server, "Video Media Server", "Janus / WebRTC on GCE", "Handles secure video consultations and real-time media streaming.")
    Container(TURN_STUN_Relay_Tier, "TURN/STUN Relay Tier", "WebRTC Relay", "Provides regional TURN/STUN relay services for video calls.")
    ContainerDb(Databases, "Databases", "Cloud SQL PostgreSQL & Cloud Storage", "Provides region-locked, encrypted persistent data storage.")
}

Rel(Patients_EU_US, Web_Mobile_Client, "Interacts via HTTPS and WebRTC for consultations and symptom checking", "HTTPS / WebRTC")
Rel(Licensed_Clinicians, Web_Mobile_Client, "Interacts via HTTPS and WebRTC to conduct consultations", "HTTPS / WebRTC")
Rel(Web_Mobile_Client, API_Gateway, "Communicates using mTLS and JWT validation", "mTLS / JWT")
Rel(API_Gateway, Core_Telehealth_Backend, "Routes internal traffic via gRPC", "gRPC")
Rel(API_Gateway, Consent_Management, "Routes consent management traffic via gRPC", "gRPC")
Rel(API_Gateway, AI_Symptom_Checker, "Routes symptom checking requests via gRPC", "gRPC")
Rel(API_Gateway, Billing_Subscriptions, "Routes billing requests via gRPC", "gRPC")
Rel(API_Gateway, Notification_Container, "Routes notification requests via gRPC", "gRPC")
Rel(Core_Telehealth_Backend, National_e_Prescription_Gateways, "Communicates with EU/US national e-prescription gateways", "HTTPS / REST")
Rel(Core_Telehealth_Backend, Pharmacies, "Sends prescriptions to external pharmacies", "HTTPS / REST")
Rel(Notification_Container, Twilio, "Triggers SMS and push alerts", "HTTPS / API")
Rel(Notification_Container, SendGrid, "Triggers email alerts", "HTTPS / API")
Rel(Billing_Subscriptions, Stripe, "Integrates with Stripe API using regional keys", "HTTPS / API")
Rel(Web_Mobile_Client, Video_Media_Server, "Connects for video consultation media streaming", "WebRTC")
Rel(Core_Telehealth_Backend, Databases, "Reads and writes health and user data", "PostgreSQL / Cloud Storage")

@enduml