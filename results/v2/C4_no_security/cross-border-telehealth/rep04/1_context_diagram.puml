@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Cross-Border Telehealth Platform

Person(Patients_EU_US, "Patients (EU & US)", "Patients in the EU and US seeking video consultations, e-prescriptions, and AI symptom checking.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Medical professionals providing video consultations and healthcare services to patients.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "A cross-border telehealth platform providing video consultations, e-prescriptions, and an AI symptom checker for EU and US patients with regional data residency and regulatory compliance.")

System_Ext(Pharmacies_EU_US, "Pharmacies (EU & US)", "Pharmacies in the EU and US fulfilling e-prescriptions.")
System_Ext(Identity_Providers_Auth0_GCP_IAM, "Identity Providers (Auth0 / GCP IAM)", "Handles secure authentication via OAuth2/OIDC.")
System_Ext(National_e_Prescription_Gateways_EU_and_US_Pharmacy_Networks, "National e-Prescription Gateways (EU) and US Pharmacy Networks", "Gateways and networks for transmitting prescriptions using REST and HL7 FHIR.")
System_Ext(Payment_Gateways_Stripe, "Payment Gateways (Stripe)", "Processes payments for consultations and platform services.")

Rel(Patients_EU_US, Cross_Border_Telehealth_Platform, "Interacts with regional telehealth platforms for consultations and symptom checking", "HTTPS/WebRTC")
Rel(Licensed_Clinicians, Cross_Border_Telehealth_Platform, "Interacts with regional telehealth platforms to conduct consultations", "HTTPS/WebRTC")
Rel(Cross_Border_Telehealth_Platform, Identity_Providers_Auth0_GCP_IAM, "Authenticates users and manages access", "OAuth2/OIDC")
Rel(Cross_Border_Telehealth_Platform, National_e_Prescription_Gateways_EU_and_US_Pharmacy_Networks, "Sends and manages e-prescriptions", "REST / HL7 FHIR")
Rel(Cross_Border_Telehealth_Platform, Pharmacies_EU_US, "Fulfills prescriptions and coordinates pharmacy services", "REST / HL7 FHIR")
Rel(Cross_Border_Telehealth_Platform, Payment_Gateways_Stripe, "Processes financial transactions", "HTTPS")

@enduml