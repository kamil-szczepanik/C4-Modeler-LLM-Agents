@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(notification_container, "Notification Container") {
    Component(Notification_Router, "Notification Router", "Node.js (TypeScript)", "Routes notification requests and queries user channel settings.")
    Component(Template_Engine, "Template Engine", "Node.js (TypeScript)", "Renders notification templates for multi-channel outbound messaging.")
    Component(Dispatcher_Adapters, "Dispatcher Adapters", "Node.js (TypeScript)", "Adapts and dispatches payloads to external delivery providers.")
    Component(Delivery_Status_Tracker, "Delivery Status Tracker", "Node.js (TypeScript)", "Tracks regional delivery status and retry queues.")
    Component(User_Notification_Preferences, "User Notification Preferences", "Node.js (TypeScript)", "Manages and stores user notification preferences.")
}

Rel(Notification_Router, User_Notification_Preferences, "Queries user channel settings", "Local DB query")

@enduml