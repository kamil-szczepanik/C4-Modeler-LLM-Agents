@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "Cloud Endpoints / Envoy")
System_Ext(core_backend, "Core Telehealth Backend", "Node.js / Go")

Container_Boundary(consent_management, "Consent Management") {
    Component(consent_api_controller, "Consent API Controller", "Node.js / Go", "Exposes endpoints to manage and verify consent permissions.")
    Component(consent_evaluation_engine, "Consent Evaluation Engine", "Node.js / Go", "Evaluates consent rules and queries compliance records.")
    Component(audit_logger_ledger, "Audit Logger & Ledger", "WORM Cloud Storage / PostgreSQL", "Maintains immutable audit ledgers and compliance records.")
    Component(consent_pub_sub_broker, "Consent Pub/Sub Broker", "Redis / Memorystore", "Broadcasts revocation events via RESP.")
}

Rel(api_gateway, consent_api_controller, "Verifies permissions via gRPC", "gRPC")
Rel(consent_evaluation_engine, audit_logger_ledger, "Queries compliance records via internal gRPC", "internal gRPC")
Rel(consent_evaluation_engine, consent_pub_sub_broker, "Broadcasts revocation events via RESP", "RESP")
Rel(core_backend, consent_pub_sub_broker, "Subscribes to revocation events via RESP", "RESP")

@enduml