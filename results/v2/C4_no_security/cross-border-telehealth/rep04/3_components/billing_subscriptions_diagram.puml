@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "Cloud Endpoints / Envoy", "External API Gateway")
System_Ext(stripe, "Stripe", "Payment Gateway", "Global payment gateway with regional key isolation.")
System_Ext(cloud_storage, "Cloud Storage", "GCP Cloud Storage", "Stores regional PDF invoices with data residency compliance.")

Container_Boundary(billing_subscriptions, "Billing & Subscriptions") {
    Component(subscription_engine, "Subscription Engine", "Go", "Manages recurring revenue and subscription lifecycles.")
    Component(payment_orchestrator, "Payment Orchestrator", "Go", "Handles secure payment processing and interacts with external payment gateways.")
    Component(tax_invoicing_adapter, "Tax & Invoicing Adapter", "Go", "Manages regional taxes and invoicing compliance.")
    Component(invoice_receipt_generator, "Invoice & Receipt Generator", "Go", "Generates regional PDF invoices and receipts.")
    Component(webhook_handler, "Webhook Handler", "Go", "Processes asynchronous webhook events from external systems like Stripe.")
}

Rel(api_gateway, subscription_engine, "Invokes", "gRPC")
Rel(payment_orchestrator, stripe, "Processes payments", "HTTPS (TLS 1.3)")
Rel(stripe, webhook_handler, "Sends events", "HTTPS / Webhooks (secured via GCP Secret Manager)")
Rel(subscription_engine, invoice_receipt_generator, "Triggers", "gRPC / Async")
Rel(invoice_receipt_generator, cloud_storage, "Stores PDF invoices", "Cloud Storage API (region-locked)")

@enduml