@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Routing_Engine, "Routing Engine", "Envoy proxy", "Handles path-based gRPC routing and canary traffic splitting.")
    Component(Auth_Policy_Enforcer, "Auth/Policy Enforcer", "Cloud Endpoints / Envoy extension", "Validates JWTs, regional claims, and consent headers to enforce regional data residency.")
    Component(Rate_Limiting_Idempotency_Filter, "Rate Limiting / Idempotency Filter", "Redis", "Enforces token buckets for rate limiting and maintains idempotency state for unstable connections.")
    Component(Audit_Telemetry_Interceptor, "Audit & Telemetry Interceptor", "W3C Trace Context", "Captures W3C trace context, AI traceability logs, and anonymized metrics for regulatory auditability.")
}

Rel(Routing_Engine, Auth_Policy_Enforcer, "Validates incoming traffic claims and headers", "JWT / Policy Check")
Rel(Auth_Policy_Enforcer, Rate_Limiting_Idempotency_Filter, "Checks token buckets and idempotency keys", "Redis / gRPC")
Rel(Rate_Limiting_Idempotency_Filter, Audit_Telemetry_Interceptor, "Forwards telemetry and trace context", "W3C Trace Context")

@enduml