@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Core_Telehealth_Backend, "Core Telehealth Backend", "Node.js / Go services managing business logic and session authorization.")

Container_Boundary(Video_Media_Server, "Video Media Server") {
    Component(Janus_WebRTC_Engine, "Janus WebRTC Engine", "Janus Gateway, C", "Handles low-latency real-time video streaming, media processing, and simulcast management.")
    Component(Media_Session_Manager, "Media Session Manager", "Node.js / Go", "Manages room authorization, session establishment, and coordinates with the Core Telehealth Backend.")
}

Rel(Janus_WebRTC_Engine, Media_Session_Manager, "Forwards session events and room authorization requests", "")
Rel(Media_Session_Manager, Core_Telehealth_Backend, "Manages session establishment and room authorization", "WebSocket / WSS")

@enduml