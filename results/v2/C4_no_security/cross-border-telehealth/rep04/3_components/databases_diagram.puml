@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Databases container

Container_Boundary(Databases, "Databases") {
    Component(EU_Clinical_Database, "EU Clinical Database", "Cloud SQL for PostgreSQL", "Stores EU patient records and logs in europe-west3 with strict regional data residency.")
    Component(US_Clinical_Database, "US Clinical Database", "Cloud SQL for PostgreSQL", "Stores US patient records in us-central1.")
    Component(Blob_Storage, "Blob Storage", "Cloud Storage", "Regional blob storage buckets with regional locking in europe-west3 and us-central1.")
    Component(PgBouncer, "PgBouncer", "PgBouncer", "Handles connection pooling for high concurrency to the databases.")
}

Rel(PgBouncer, EU_Clinical_Database, "Pools database connections for EU services via TLS 1.3", "TLS 1.3")
Rel(PgBouncer, US_Clinical_Database, "Pools database connections for US services via TLS 1.3", "TLS 1.3")

@enduml