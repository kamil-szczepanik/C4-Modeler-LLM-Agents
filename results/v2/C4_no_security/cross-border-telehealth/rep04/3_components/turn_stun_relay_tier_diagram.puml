@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person_Ext(web_mobile_client, "Web/Mobile Client", "Web and Mobile applications used by patients and clinicians.")
System_Ext(video_media_server, "Video Media Server", "Janus / WebRTC on GCE handling video media processing.")

Container_Boundary(turn_stun_relay_tier, "TURN/STUN Relay Tier") {
    Component(stun_ice_discovery_engine, "STUN/ICE Discovery Engine", "Coturn (C++)", "Handles NAT traversal and peer connection discovery for clients.")
    Component(turn_allocation_relay_manager, "TURN Allocation & Relay Manager", "Coturn (C++)", "Manages relay allocations and routes media streams between clients and the media server.")
}

Rel(web_mobile_client, turn_allocation_relay_manager, "Streams media", "TURN/UDP or TURN/TLS")
Rel(turn_allocation_relay_manager, video_media_server, "Routes media", "RTP/SRTP over local GCP VPC networking")
@enduml