@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(ai_symptom_checker, "AI Symptom Checker") {
    Component(triage_orchestrator, "Triage Orchestrator Service", "Go", "Orchestrates symptom checks, coordinates triage flow, routes clinical handoffs, and manages transactional dual-write logging.")
    Component(inference_engine, "Inference Execution Engine", "Python / PyTorch", "Powers medical NLP models and executes AI inference.")
    Component(localization_component, "Localization & Normalization Component", "Python", "Normalizes and localizes data for international compatibility under regional regulations.")
    Component(handoff_router, "Clinical Handoff Router", "Go", "Routes clinical handoffs to human practitioners when necessary.")
    Component(audit_interceptor, "Audit Logging & Versioning Interceptor", "Go", "Interprets and logs model versions and audit trails securely.")
}

Rel(triage_orchestrator, localization_component, "Sends data for localization", "gRPC")
Rel(localization_component, inference_engine, "Sends normalized data for inference", "gRPC")
Rel(triage_orchestrator, handoff_router, "Routes clinical escalations", "Go internal function call")
@enduml