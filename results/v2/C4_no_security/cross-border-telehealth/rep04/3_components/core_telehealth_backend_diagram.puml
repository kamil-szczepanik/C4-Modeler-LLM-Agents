@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(core_telehealth_backend, "Core Telehealth Backend") {
    Component(PrescriptionOrchestrator, "Prescription Orchestrator", "Go", "Orchestrates e-prescription workflows and coordinates cross-border integration.")
    Component(AuditLoggingInterceptor, "Audit Logging Interceptor", "Node.js/Go", "Intercepts and records append-only immutable audit logs for compliance.")
    Component(IntegrationAdapter, "Integration Adapter", "Go", "Connects the backend to external EU National e-Prescription Gateways and US Pharmacy Networks.")
}

Rel(PrescriptionOrchestrator, AuditLoggingInterceptor, "Records operational and compliance events")
Rel(PrescriptionOrchestrator, IntegrationAdapter, "Dispatches regional e-prescriptions")

@enduml