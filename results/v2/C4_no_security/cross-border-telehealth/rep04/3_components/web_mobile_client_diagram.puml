@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(web_mobile_client, "Web/Mobile Client") {
    Component(Cross_Platform_UI, "Cross-Platform UI", "Flutter / React Native", "Provides the user interface for patients and clinicians across web and mobile devices.")
    Component(Local_Storage_Manager, "Local Storage Manager", "SQLite", "Enables offline-first caching for unstable networks and rural areas.")
    Component(WebRTC_Client_Module, "WebRTC Client Module", "WebRTC", "Handles low-latency video streaming and media traversal for consultations.")
}

Rel(Cross_Platform_UI, Local_Storage_Manager, "Reads and writes offline cache data", "SQLite")
Rel(Cross_Platform_UI, WebRTC_Client_Module, "Initiates video consultations", "WebRTC / SRTP")

@enduml