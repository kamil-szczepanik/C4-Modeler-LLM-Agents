@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "Patients in the EU and US seeking video consultations, e-prescriptions, and AI symptom checking.")
Person(LicensedClinicians, "Licensed Clinicians", "Licensed medical professionals providing video consultations and issuing e-prescriptions.")
System(CrossBorderTelehealthPlatform, "Cross-Border Telehealth Platform", "A cross-border telehealth platform providing video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and the US.")

System_Ext(PharmaciesandNationalPharmacyNetworksEUUSPharmacySystems, "Pharmacies and National Pharmacy Networks (EU) / US Pharmacy Systems", "National and regional pharmacy systems for fulfilling e-prescriptions.")
System_Ext(AISymptomCheckerEngine, "AI Symptom Checker Engine", "Engine providing AI symptom checking with immutable audit logging sidecars.")
System_Ext(RegionalIdentityProviders, "Regional Identity Providers", "EU eIDAS-compliant and US OAuth via OIDC identity providers.")
System_Ext(RegionalHealthAuthoritiesandAuditors, "Regional Health Authorities and Auditors", "Authorities accessing regional audit endpoints for compliance and oversight.")

Rel(Patients, CrossBorderTelehealthPlatform, "Interact with regional telehealth platforms via HTTPS/REST and WebRTC for video", "HTTPS/REST, WebRTC")
Rel(LicensedClinicians, CrossBorderTelehealthPlatform, "Interact with regional telehealth platforms via HTTPS/REST and WebRTC for video", "HTTPS/REST, WebRTC")
Rel(CrossBorderTelehealthPlatform, PharmaciesandNationalPharmacyNetworksEUUSPharmacySystems, "Connect to pharmacy systems using national standards and HL7 FHIR over HTTPS/REST", "HL7 FHIR, HTTPS/REST")
Rel(CrossBorderTelehealthPlatform, AISymptomCheckerEngine, "Call AI Symptom Checker Engine via gRPC with strict local caching", "gRPC")
Rel(CrossBorderTelehealthPlatform, RegionalIdentityProviders, "Integrate via OpenID Connect (OIDC) over HTTPS", "OIDC, HTTPS")
Rel(RegionalHealthAuthoritiesandAuditors, CrossBorderTelehealthPlatform, "Access regional audit endpoints via mTLS and signed JWTs over HTTPS", "mTLS, signed JWTs, HTTPS")

@enduml