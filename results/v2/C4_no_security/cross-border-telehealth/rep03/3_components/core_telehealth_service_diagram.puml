@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Telehealth Service container

Container_Boundary(core_telehealth_service, "Core Telehealth Service") {
    Component(Telehealth_API_Router, "Telehealth API Router", "Go / Gin", "Handles incoming API requests routed from the GCP API Gateway.")
    Component(Session_Telemetry_Manager, "Session & Telemetry Manager", "Go / Gin", "Manages session state and persists telemetry data to Cloud SQL PostgreSQL.")
    Component(AI_Symptom_Check_Coordinator, "AI Symptom-Check Coordinator", "Go / Gin with gRPC", "Sends symptom-check requests to the AI Inference Wrapper with audit logging.")
    Component(Prescription_Dispatcher, "Prescription Dispatcher", "Go / Gin with GCP Pub/Sub", "Dispatches prescriptions asynchronously to the Pharmacy Integration Gateway.")
}

System_Ext(Cloud_SQL_PostgreSQL, "Cloud SQL PostgreSQL", "Stores region-pinned health data to satisfy HIPAA and GDPR residency constraints.")
System_Ext(AI_Inference_Wrapper, "AI Inference Wrapper", "Python / FastAPI", "Powers the AI Inference Wrapper for rapid machine learning integration.")
System_Ext(Pharmacy_Integration_Gateway, "Pharmacy Integration Gateway", "External System", "Handles external pharmacy integrations.")

Rel(Telehealth_API_Router, Session_Telemetry_Manager, "Delegates session state handling")
Rel(Telehealth_API_Router, AI_Symptom_Check_Coordinator, "Triggers AI symptom checks")
Rel(Telehealth_API_Router, Prescription_Dispatcher, "Initiates prescription dispatch")
Rel(Session_Telemetry_Manager, Cloud_SQL_PostgreSQL, "Persists session state and telemetry", "TLS")
Rel(AI_Symptom_Check_Coordinator, AI_Inference_Wrapper, "Sends symptom-check requests with audit logging", "gRPC")
Rel(Prescription_Dispatcher, Pharmacy_Integration_Gateway, "Dispatches prescriptions asynchronously", "GCP Pub/Sub")

@enduml