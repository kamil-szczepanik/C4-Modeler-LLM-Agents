@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(gcp_gke_regional_clusters, "GCP GKE Regional Clusters") {
    Component(ingress_controllers, "Kubernetes Ingress Controllers (NGINX / Envoy)", "NGINX / Envoy", "Manages TLS termination and ingress traffic routing for regional clusters.")
    Component(network_policy_enforcer, "Network Policy Enforcer (GKE Dataplane V2 / eBPF)", "GKE Dataplane V2 / eBPF", "Enforces pod isolation and namespace segmentation using Layer 3/4 eBPF protocols.")
    Component(log_forwarder, "Log Forwarder & OTel Collectors", "Fluentbit / OpenTelemetry", "Streams audit logs and telemetry data to observability platforms.")
    Component(core_services, "Core Telehealth & AI Inference Services", "Microservices (Containerized)", "Handles video streaming, prescriptions, and AI symptom analysis.")
}

Rel(ingress_controllers, core_services, "Routes HTTPS/gRPC application traffic to internal microservices.", "HTTPS/gRPC")
Rel(network_policy_enforcer, core_services, "Enforces workload isolation and security boundaries.", "Layer 3/4 eBPF")
Rel(log_forwarder, core_services, "Collects logs and telemetry data from microservices.", "gRPC/HTTPS")

@enduml