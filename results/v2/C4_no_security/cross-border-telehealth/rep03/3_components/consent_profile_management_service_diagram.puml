@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Consent & Profile Management Service container

System_Ext(CloudSQL, "Cloud SQL PostgreSQL Databases", "Relational storage", "Reads and writes profile data using Row-Level Security (RLS)")
System_Ext(PubSub, "GCP Cloud Pub/Sub", "Messaging service", "Streams audit events asynchronously to GCP Cloud Pub/Sub for compliance and tracking")

Container_Boundary(consent_profile_service, "Consent & Profile Management Service") {
    Component(ConsentController, "Consent Controller", "Go / Spring Boot", "Handles incoming REST/gRPC requests regarding patient and clinician consent profiles.")
    Component(ProfileManager, "Profile Manager", "Go / Spring Boot", "Manages profile data, cross-border access validation, and low-latency consent evaluation.")
    Component(AuditEventPublisher, "Audit Event Publisher", "Go / Spring Boot", "Streams audit events asynchronously to GCP Cloud Pub/Sub for compliance and tracking.")
}

Rel(ConsentController, ProfileManager, "Evaluates consent and manages user profiles", "Internal")
Rel(ProfileManager, CloudSQL, "Reads and writes profile data using Row-Level Security (RLS)", "Database connection")
Rel(ProfileManager, PubSub, "Publishes audit events", "Asynchronous")
@enduml