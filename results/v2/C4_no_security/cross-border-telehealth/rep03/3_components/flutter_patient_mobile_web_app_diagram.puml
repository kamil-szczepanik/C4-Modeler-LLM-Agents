@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Flutter Patient Mobile/Web App container

Container_Boundary("Flutter_Patient_MobileWeb_App", "Flutter Patient Mobile/Web App") {
    Component("Presentation_Layer", "Presentation Layer", "Dart/Flutter UI component", "Provides the user interface for video consultations, e-prescriptions, and the AI symptom checker.")
    Component("State__Local_Storage_Manager", "State & Local Storage Manager", "Hive / SQLite component", "Handles client-side caching for offline resilience and low-bandwidth conditions.")
    Component("API_Client__Region_Router", "API Client & Region Router", "Dio / HTTP component", "Manages regional API routing and communication based on user geolocation.")
    Component("WebRTC_Video_Module", "WebRTC Video Module", "WebRTC component", "Enables low-bandwidth video consultations with regional TURN/STUN fallback.")
    Component("Feature_Flag__Configuration_Provider", "Feature Flag & Configuration Provider", "Feature Flag & Configuration Provider component", "Provides feature flags and configuration settings, syncing asynchronously with backend services.")
}

System_Ext("GCP_API_Gateway", "GCP API Gateway", "External GCP API Gateway")
System_Ext("TURNSTUN_relays", "TURN/STUN relays", "External TURN/STUN relay servers")
System_Ext("Consent__Profile_Management_Service", "Consent & Profile Management Service", "External Backend Service")

Rel("API_Client__Region_Router", "GCP_API_Gateway", "Routes requests via HTTPS (REST/GraphQL) based on user geolocation.", "HTTPS")
Rel("WebRTC_Video_Module", "TURNSTUN_relays", "Connects to regional relays for peer-to-peer media streams.", "WebRTC / UDP/TCP")
Rel("Feature_Flag__Configuration_Provider", "Consent__Profile_Management_Service", "Syncs asynchronously via HTTPS.", "HTTPS")

@enduml