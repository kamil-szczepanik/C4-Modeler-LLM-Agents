@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(gcp_cloud_pub_sub, "GCP Cloud Pub/Sub") {
    Component(Regional_Topics, "Regional Topics", "GCP Cloud Pub/Sub", "Region-isolated messaging topics ensuring regional data residency for e-prescriptions and audit logs.")
    Component(Dead_Letter_Topics, "Dead Letter Topics", "GCP Cloud Pub/Sub", "Captures undeliverable messages to ensure e-prescription reliability for unstable connections.")
    Component(Schema_Validator, "Schema Validator", "Avro / Protocol Buffers", "Enforces data contracts at the Pub/Sub ingestion boundary.")
}

Rel(Regional_Topics, Dead_Letter_Topics, "Routes undeliverable messages", "")
Rel(Schema_Validator, Regional_Topics, "Validates message payloads before ingestion", "")

@enduml