@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Inference Wrapper container

Container_Boundary(ai_inference_wrapper, "AI Inference Wrapper") {
    Component(AI_Inference_API_Router, "AI Inference API Router", "Python / FastAPI", "Handles incoming gRPC requests from the Core Telehealth Service and routes them to the symptom checker models.")
    Component(Model_Execution_Engine, "Model Execution Engine", "Python", "Executes symptom checking AI models and formats the clinical output.")
    Component(Audit_Log_Publisher, "Audit Log Publisher", "Python gRPC Client", "Publishes asynchronous audit logs and traceability data to GCP Cloud Pub/Sub for EU MDR compliance.")
}

Rel(AI_Inference_API_Router, Model_Execution_Engine, "Invokes symptom analysis", "gRPC")
Rel(AI_Inference_API_Router, Audit_Log_Publisher, "Sends audit events asynchronously", "Internal Call")
@enduml