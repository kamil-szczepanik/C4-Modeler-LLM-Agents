@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Cloud SQL PostgreSQL Databases container

Person(Core Telehealth Service, "Core Telehealth Service", "External service calling the core telehealth schema")
Person(Consent & Profile Management Service, "Consent & Profile Management Service", "External service calling the consent and audit schema")
Person(Pharmacy Integration Gateway, "Pharmacy Integration Gateway", "External gateway calling the FHIR schema")

Container_Boundary(Cloud SQL PostgreSQL Databases, "Cloud SQL PostgreSQL Databases") {
    Component(Core Telehealth Schema, "Core Telehealth Schema", "Cloud SQL PostgreSQL 15, SQL over TLS 1.3", "Stores core telehealth consultation data, supported by PgBouncer and IAM authentication.")
    Component(Consent & Audit Schema, "Consent & Audit Schema", "Cloud SQL PostgreSQL 15, SQL over TLS 1.3", "Manages patient consent records and audit logs using least-privilege accounts.")
    Component(FHIR Interoperability Schema, "FHIR Interoperability Schema", "Cloud SQL PostgreSQL 15, JSONB", "Stores and indexes US FHIR resources for interoperability and pharmacy integrations.")
}

Rel(Core Telehealth Service, Core Telehealth Schema, "SQL over TLS 1.3 with IAM authentication and PgBouncer")
Rel(Consent & Profile Management Service, Consent & Audit Schema, "SQL over TLS 1.3 with least-privilege accounts")
Rel(Pharmacy Integration Gateway, FHIR Interoperability Schema, "SQL over TLS 1.3 using dedicated credentials")

@enduml