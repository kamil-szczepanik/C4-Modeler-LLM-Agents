@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(pharmacy_integration_gateway, "Pharmacy Integration Gateway") {
    Component(Routing_Mediation_Engine, "Routing & Mediation Engine", "Apache Camel / Spring Integration", "Transforms canonical models to regional formats.")
    Component(Adapter_Registry, "Adapter Registry", "Apache Camel / Spring Integration", "Manages adapters to deliver prescriptions to regional systems.")
    Component(Delivery_Status_Tracker, "Delivery Status Tracker", "Apache Camel / Spring Integration", "Publishes delivery status updates back to the core service.")
    Component(Error_Classification_Translation_Engine, "Error Classification & Translation Engine", "Apache Camel / Spring Integration", "Sends categorized failure notifications.")
}

Rel(Routing_Mediation_Engine, Adapter_Registry, "Transforms canonical models to regional formats", "Internal Method")
Rel(Adapter_Registry, US_Pharmacy_Systems_EU_National_Networks, "Delivers prescriptions", "HL7 FHIR, HTTPS/REST")
Rel(Delivery_Status_Tracker, Core_Telehealth_Service, "Publishes delivery status updates", "GCP Pub/Sub")
Rel(Error_Classification_Translation_Engine, Delivery_Status_Tracker, "Sends categorized failure notifications", "GCP Pub/Sub")
@enduml