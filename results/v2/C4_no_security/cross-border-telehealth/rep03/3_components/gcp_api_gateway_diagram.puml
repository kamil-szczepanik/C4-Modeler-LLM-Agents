@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the GCP API Gateway container

Container_Boundary(gcp_api_gateway, "GCP API Gateway") {
    Component(Cloud_Endpoints_Envoy_Router, "Cloud Endpoints Envoy Router", "Cloud Endpoints / Envoy", "Handles edge routing, Anycast geo-routing, and local JWT validation to minimize latency and enforce physical entry-point segregation.")
    Component(Authentication_and_Authorization_Handler, "Authentication and Authorization Handler", "OIDC, HTTPS, OAuth2/JWT", "Authenticates users via Regional Identity Providers and validates security tokens.")
    Component(Audit_Endpoint_Handler, "Audit Endpoint Handler", "mTLS, signed JWTs, HTTPS", "Manages secure access for Regional Health Authorities and Auditors to audit endpoints.")
}

Rel(Cloud_Endpoints_Envoy_Router, Authentication_and_Authorization_Handler, "Validates incoming tokens and authenticates users", "OIDC, HTTPS")
Rel(Cloud_Endpoints_Envoy_Router, Audit_Endpoint_Handler, "Enforces mTLS and signed JWT checks for compliance", "mTLS, HTTPS")

@enduml