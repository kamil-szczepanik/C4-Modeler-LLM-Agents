@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Clinician Portal container

Container_Boundary(clinician_portal, "Clinician Portal") {
    Component(clinician_ui, "Clinician UI", "React / TypeScript", "Low-latency user interface for licensed clinicians to manage consultations and prescriptions.")
    Component(clinician_backend, "Clinician Backend Layer", "Node.js / Express", "Backend component layer handling session management and prescription routing.")
}

Rel(clinician_ui, clinician_backend, "Communicates via HTTPS/REST for session and prescription operations.", "HTTPS/REST")

@enduml