@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(observability_stack, "Observability Stack") {
    Component(OpenTelemetry_Collector, "OpenTelemetry Collector", "OpenTelemetry", "Receives telemetry data from microservices and forwards metrics and traces.")
    Component(Grafana_Mimir, "Grafana Mimir", "Grafana Mimir", "Stores and queries metrics data.")
    Component(Grafana_Tempo, "Grafana Tempo", "Grafana Tempo", "Stores and queries distributed traces.")
    Component(Falco, "Falco", "Falco", "Streams kernel-level security events to the SIEM sink.")
    Component(Grafana_UI, "Grafana UI", "Grafana", "Provides end-to-end metrics, traces, and compliance reporting dashboards.")
}

Rel(OpenTelemetry_Collector, Grafana_Mimir, "Forwards metrics via HTTP/RemoteWrite", "HTTP/RemoteWrite")
Rel(OpenTelemetry_Collector, Grafana_Tempo, "Forwards traces via HTTP/RemoteWrite", "HTTP/RemoteWrite")
Rel(Grafana_UI, Grafana_Mimir, "Queries metrics", "HTTPS")
Rel(Grafana_UI, Grafana_Tempo, "Queries traces", "HTTPS")
@enduml