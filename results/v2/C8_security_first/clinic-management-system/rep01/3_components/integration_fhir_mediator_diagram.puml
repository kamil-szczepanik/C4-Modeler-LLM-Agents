@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(integration_fhir_mediator, "Integration & FHIR Mediator") {
    Component(Inbound_Gateway_Component, "Inbound Gateway Component", "Apache Camel K / Java", "Securely receives and authenticates inbound data exchanges from external clinical systems via HTTPS with mTLS and SMART-on-FHIR JWT tokens.")
    Component(Transformation_Engine_Component, "Transformation Engine Component", "Apache Camel / HAPI FHIR Java Library", "Performs standardized parsing and schema validation of HL7 FHIR R4 resources.")
    Component(Outbound_Dispatcher_Component, "Outbound Dispatcher Component", "Apache Camel K Route", "Dispatches and routes standardized data payloads and publishes domain events.")
    Component(Audit___Compliance_Logger_Component, "Audit & Compliance Logger Component", "Java / OpenTelemetry", "Ensures HIPAA/GDPR compliance by logging and streaming sanitized telemetry.")
    Component(Secret___Credential_Management_Store, "Secret & Credential Management Store", "HashiCorp Vault via CSI Secrets Store", "Secures retrieval of external API keys and client certificates.")
    Component(Event_Broker, "Event Broker", "Redpanda", "High-performance event broker supporting Kafka-backed Dead Letter Queues (DLQ).")
    Component(Observability_Stack, "Observability Stack", "OpenTelemetry, Grafana Mimir/Tempo", "Collects and visualizes telemetry and logs.")
}

Rel(Inbound_Gateway_Component, Transformation_Engine_Component, "Forwards payloads to", "internal gRPC/HTTP")
Rel(Outbound_Dispatcher_Component, Event_Broker, "Publishes domain events to", "Kafka protocol")
Rel(Audit___Compliance_Logger_Component, Observability_Stack, "Streams sanitized telemetry to", "OpenTelemetry Protocol (OTLP)")
Rel(Inbound_Gateway_Component, Secret___Credential_Management_Store, "Retrieves client certificates and API keys from", "")
@enduml