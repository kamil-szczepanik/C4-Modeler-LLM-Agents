@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient Intake Container container

Container_Boundary(patient_intake_container, "Patient Intake Container") {
    Component(Envoy_NGINX_API_Gateway, "Envoy / NGINX API Gateway", "API Gateway", "Routes incoming requests to the Intake API Router over mTLS.")
    Component(Intake_API_Router, "Intake API Router", "Python / FastAPI with Pydantic", "Routes intake requests and provides strict schema validation for intake payloads and FHIR compliance.")
    Component(Patient_Intake_Service, "Patient Intake Service", "Python business logic", "Manages patient admissions, demographic capture, and audit logging workflows.")
    Component(Data_Access_Repository, "Data Access Repository", "SQLAlchemy / asyncpg", "Handles asynchronous relational database persistence.")
    Component(Event_Publisher, "Event Publisher", "Redpanda Client", "Dispatches audit events and intake events.")
    Component(Primary_Database, "Primary Database", "PostgreSQL with Citus", "Stores patient records and relational data.")
    Component(Event_Broker, "Event Broker", "Redpanda", "Publishes and brokers intake and audit events.")
}

Rel(Envoy_NGINX_API_Gateway, Intake_API_Router, "Routes intake requests", "HTTP/2 / gRPC over mTLS")
Rel(Intake_API_Router, Patient_Intake_Service, "Invokes workflow", "In-memory / Python function call")
Rel(Patient_Intake_Service, Data_Access_Repository, "Persists patient records", "Async TCP with envelope encryption")
Rel(Patient_Intake_Service, Event_Publisher, "Dispatches audit events", "Async TCP")
Rel(Data_Access_Repository, Primary_Database, "Reads and writes data", "Encrypted internal TCP")
Rel(Event_Publisher, Event_Broker, "Publishes intake events", "Encrypted internal TCP")

@enduml