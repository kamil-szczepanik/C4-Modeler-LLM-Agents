@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Event Broker container

Container_Boundary(event_broker, "Event Broker") {
    Component(KafkaAPIFrontend, "Kafka API Frontend", "Redpanda (C++ thread-per-core)", "Handles high-performance streaming and client connections using the Kafka API protocol.")
    Component(StorageRaftConsensusEngine, "Storage & Raft Consensus Engine", "Raft Consensus Protocol with S3-compatible Tiered Storage", "Manages distributed consensus logs and long-term data retention across hybrid cloud infrastructure.")
    Component(SchemaRegistry, "Schema Registry", "Integrated Schema Registry", "Validates Apache Avro and JSON schemas for event data integrity.")
    Component(PartitionManager, "Partition Manager", "C++ Thread-per-Core Engine", "Manages stream partitions to ensure low-latency event processing for critical clinical workflows.")
    Component(TieredStorageEncryptionInterceptor, "Tiered Storage Encryption Interceptor", "AES-256 with AWS KMS/on-prem HSM", "Applies client-side envelope encryption and manages encryption-in-transit and at-rest for tiered storage.")
    Component(GDPRPurgeTombstoneController, "GDPR Purge & Tombstone Controller", "Custom Compliance Controller", "Ensures strict GDPR compliance by handling data purges and tombstone records for long-term retention.")
}

Rel(KafkaAPIFrontend, StorageRaftConsensusEngine, "Routes incoming event streams to the Raft consensus logs", "TCP/Kafka")
Rel(KafkaAPIFrontend, SchemaRegistry, "Validates event payloads against Apache Avro/JSON schemas", "Internal API")
Rel(StorageRaftConsensusEngine, TieredStorageEncryptionInterceptor, "Encrypts data before offloading to S3-compatible tiered storage for 10-year retention", "Internal")
Rel(GDPRPurgeTombstoneController, StorageRaftConsensusEngine, "Executes data purging and tombstone creation to satisfy GDPR mandates", "Internal")

@enduml