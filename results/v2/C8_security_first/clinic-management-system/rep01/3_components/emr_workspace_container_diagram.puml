@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the EMR Workspace Container container

Container_Boundary(emr_workspace_container, "EMR Workspace Container") {
    Component(grpc_api_handler, "gRPC API Handler", "Go / gRPC", "Routes incoming requests and handles gRPC communication for the EMR workspace.")
    Component(emr_business_logic_engine, "EMR Business Logic Engine", "Go", "Executes core business rules and workflow logic for electronic medical records.")
    Component(phi_crypto_middleware, "PHI Crypto Middleware", "Tink Crypto Library & Cloud KMS", "Applies application-layer AES-256 column-level encryption and envelope encryption for PHI data.")
    Component(distributed_l2_cache, "Distributed L2 Cache", "Redis Enterprise", "Caches hot session state supporting active-active geo-replication.")
    Component(audit_event_emitter, "Audit & Event Emitter", "Go / Redpanda Client", "Publishes EMR events and immutable audit logs to the event broker.")
}

System_Ext(cloud_kms_hsm, "Cloud KMS / HSM", "External Key Management System")

Rel(emr_business_logic_engine, distributed_l2_cache, "Reads/writes hot session state", "RESP over TLS")
Rel(phi_crypto_middleware, cloud_kms_hsm, "Fetches data encryption keys", "gRPC over mTLS")

@enduml