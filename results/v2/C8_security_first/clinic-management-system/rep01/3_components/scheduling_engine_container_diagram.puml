@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Scheduling Engine Container container

Container_Boundary(scheduling_engine_container, "Scheduling Engine Container") {
    Component(Booking API Controller, "Booking API Controller", "Java / Spring Boot", "Manages appointment bookings and routes incoming requests.")
    Component(Conflict Resolution Service, "Conflict Resolution Service", "Java / Spring Boot", "Resolves scheduling conflicts and consumes cancellation events for waitlist backfilling.")
    Component(Calendar & Slot Manager, "Calendar & Slot Manager", "Java / Spring Boot", "Manages clinician calendars and available slots.")
    Component(Resource Allocation Coordinator, "Resource Allocation Coordinator", "Java / Spring Boot", "Optimizes and coordinates resource allocation with atomic multi-resource locking.")
    Component(Notification Publisher, "Notification Publisher", "Java / Spring Boot", "Publishes encrypted domain events related to scheduling notifications.")
    Component(Envoy / NGINX API Gateway, "Envoy / NGINX API Gateway", "Envoy / NGINX", "Routes HTTP/2 and gRPC requests over mTLS.")
    ComponentDb(Primary Database, "Primary Database", "PostgreSQL with Citus", "Relational data storage supporting horizontal scaling and secure data persistence.")
    Component(Event Broker, "Event Broker", "Redpanda", "Event streaming platform enabling reliable, asynchronous domain event publishing.")
    Component(Observability Stack, "Observability Stack", "OpenTelemetry, Grafana Mimir/Tempo, Falco", "Ensures distributed tracing, custom metrics tracking, and compliance monitoring.")
}

Rel(Envoy / NGINX API Gateway, Booking API Controller, "Routes HTTP/2 and gRPC requests over mTLS", "HTTP/2 / gRPC / mTLS")
Rel(Booking API Controller, Primary Database, "Executes transactional reads and writes over encrypted internal TCP", "Encrypted TCP")
Rel(Notification Publisher, Event Broker, "Publishes encrypted domain events using Kafka/Redpanda Spring Boot starter over encrypted internal TCP", "Encrypted TCP")
Rel(Conflict Resolution Service, Event Broker, "Consumes cancellation events for waitlist backfilling over encrypted internal TCP", "Encrypted TCP")
Rel(Resource Allocation Coordinator, Primary Database, "Manages atomic multi-resource locking using database-level advisory locks over encrypted internal TCP", "Encrypted TCP")

@enduml