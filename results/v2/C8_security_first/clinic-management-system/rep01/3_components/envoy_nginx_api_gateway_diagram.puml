@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Envoy / NGINX API Gateway container

Container_Boundary(envoy_nginx_api_gateway, "Envoy / NGINX API Gateway") {
    Component(Listener_TLS_Termination_Component, "Listener & TLS Termination Component", "Envoy / TLS 1.3", "Terminates incoming HTTPS traffic and enforces forward-secrecy cipher suites.")
    Component(Authentication_Filter_Component, "Authentication Filter Component", "Envoy / OAuth 2.0 / OIDC", "Validates authentication tokens against the Identity Provider.")
    Component(Rate_Limiting_WAF_Filter_Component, "Rate Limiting & WAF Filter Component", "Envoy Filter", "Protects platform workflows against abuse and ensures strict compliance.")
    Component(Routing_Load_Balancing_Component, "Routing & Load Balancing Component", "Envoy Router / gRPC", "Routes validated traffic to internal containers over mTLS.")
    Component(Telemetry_Tracing_Export_Component, "Telemetry & Tracing Export Component", "OpenTelemetry / gRPC", "Exports telemetry and access logs to the Observability Stack.")
}

Rel(Listener_TLS_Termination_Component, Authentication_Filter_Component, "Passes decrypted requests for token validation", "HTTPS / mTLS")
Rel(Authentication_Filter_Component, Rate_Limiting_WAF_Filter_Component, "Forwards authenticated traffic for security policy enforcement")
Rel(Rate_Limiting_WAF_Filter_Component, Routing_Load_Balancing_Component, "Passes cleared traffic for internal routing")
Rel(Routing_Load_Balancing_Component, Telemetry_Tracing_Export_Component, "Triggers telemetry collection during request routing")

@enduml