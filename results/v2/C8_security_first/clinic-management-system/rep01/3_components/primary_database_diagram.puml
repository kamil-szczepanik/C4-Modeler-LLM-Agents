@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(primary_database, "Primary Database") {
    Component(Coordinator_Node, "Coordinator Node", "PostgreSQL with Citus", "Manages metadata, query routing, and distributed transactions.")
    Component(Worker_Nodes_Shard_Replicas, "Worker Nodes (Shard Replicas)", "Distributed PostgreSQL instances with synchronous replication", "Stores distributed shards with synchronous replication.")
    Component(Connection_Pooling_Proxy_PgBouncer, "Connection Pooling Proxy (PgBouncer)", "PgBouncer", "Handles connection spikes and query routing.")
    Component(Analytical_Read_Replicas, "Analytical Read Replicas", "Asynchronous PostgreSQL read replicas", "Handles read-only queries for billing and reporting.")
}

Rel(Connection_Pooling_Proxy_PgBouncer, Coordinator_Node, "Queries and transactions", "pgJDBC/libpq over mTLS")
Rel(Coordinator_Node, Worker_Nodes_Shard_Replicas, "Inter-node operations", "PostgreSQL wire protocol over TLS")
Rel(Coordinator_Node, Analytical_Read_Replicas, "Data replication", "PostgreSQL streaming protocol over TLS")

@enduml