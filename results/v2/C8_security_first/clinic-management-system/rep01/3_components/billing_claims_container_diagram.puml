@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(billing_and_claims_container, "Billing & Claims Container") {
    Component(api_controller, "API Controller", "Node.js / TypeScript", "Handles incoming routing and API requests for billing and claims.")
    Component(claims_and_invoicing_engine, "Claims & Invoicing Engine", "Node.js / TypeScript", "Manages the creation and processing of claims and invoices.")
    Component(denial_and_exception_handler, "Denial & Exception Handler", "Node.js / TypeScript", "Handles claim denials and execution exceptions.")
    Component(payment_and_clearinghouse_adapter, "Payment & Clearinghouse Adapter", "Node.js / TypeScript", "Integrates with external payment gateways and insurance clearinghouses.")
    Component(outbox_processor, "Outbox Processor", "Node.js / TypeScript", "Guarantees transactional integrity by publishing events reliably.")
    Component(fee_estimation_service, "Fee Estimation Service", "Node.js / TypeScript", "Provides real-time fee estimations for clinical workflows.")
    Component(audit_and_event_publisher, "Audit & Event Publisher", "Node.js / TypeScript", "Publishes audit logs and domain events to the event broker.")
    Component(data_access_layer, "Data Access Layer", "Node.js / TypeScript", "Interacts securely with the primary database for persistence.")
}

Rel(api_controller, claims_and_invoicing_engine, "Delegates billing workflows")
Rel(claims_and_invoicing_engine, outbox_processor, "Saves events for reliable publishing")
Rel(claims_and_invoicing_engine, data_access_layer, "Queries and updates financial records")
Rel(denial_and_exception_handler, outbox_processor, "Publishes denial events")
Rel(payment_and_clearinghouse_adapter, claims_and_invoicing_engine, "Updates payment statuses")
Rel(fee_estimation_service, data_access_layer, "Fetches pricing data")
Rel(outbox_processor, audit_and_event_publisher, "Dispatches domain events")
Rel(audit_and_event_publisher, data_access_layer, "Persists audit logs")
@enduml