@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Clinic Receptionist / Admin, "Clinic Receptionist / Admin", "Manages patient admissions, scheduling, and front-desk workflows.")
Person(Clinician (Doctor / Nurse), "Clinician (Doctor / Nurse)", "Accesses and updates electronic medical records (EMR) and clinical workflows.")
Person(Billing Specialist, "Billing Specialist", "Handles billing, payments, and financial interactions.")
Person(Patient, "Patient", "Interacts with the clinic for appointments, care, and billing.")
Person(Hospital / Clinic Administrator, "Hospital / Clinic Administrator", "Oversees system administration and clinic operations.")
Person(External Auditors / Compliance Officers, "External Auditors / Compliance Officers", "Reviews system logs and compliance data for regulatory standards.")

System(Clinic Management System, "Clinic Management System", "A hybrid cloud platform designed for medium-sized hospitals and clinics to manage patient admissions, electronic medical records (EMR), scheduling, and billing with high availability and strict regulatory compliance.")

System_Ext(External Lab & Imaging Systems, "External Lab & Imaging Systems", "Provides laboratory results and medical imaging data.")
System_Ext(Insurance Claim Processors / Payment Gateways, "Insurance Claim Processors / Payment Gateways", "Processes insurance claims and electronic payments.")
System_Ext(Identity Provider (IdP) with local on-premise cache proxy, "Identity Provider (IdP) with local on-premise cache proxy", "Handles authentication, authorization, and token caching.")

Rel(Clinic Receptionist / Admin, Clinic Management System, "Manages admissions and scheduling", "HTTPS (TLS 1.3 with MFA)")
Rel(Clinician (Doctor / Nurse), Clinic Management System, "Accesses and updates EMR and clinical workflows", "HTTPS (TLS 1.3 with MFA)")
Rel(Billing Specialist, Clinic Management System, "Manages billing and financial processes", "HTTPS (TLS 1.3 with MFA)")
Rel(Patient, Clinic Management System, "Views appointments and health records", "HTTPS (TLS 1.3 with MFA)")
Rel(Hospital / Clinic Administrator, Clinic Management System, "Administers platform operations", "HTTPS (TLS 1.3 with MFA)")
Rel(External Auditors / Compliance Officers, Clinic Management System, "Audits compliance and logs", "HTTPS (TLS 1.3 with MFA)")
Rel(Clinic Management System, External Lab & Imaging Systems, "Exchanges lab and imaging data", "HL7 FHIR REST APIs over HTTPS (mTLS) with payload-level digital signatures")
Rel(Clinic Management System, Insurance Claim Processors / Payment Gateways, "Submits insurance claims and processes payments", "Secure REST/SOAP APIs")
Rel(Clinic Management System, Identity Provider (IdP) with local on-premise cache proxy, "Authenticates users and validates tokens", "OAuth 2.0/OIDC")
@enduml