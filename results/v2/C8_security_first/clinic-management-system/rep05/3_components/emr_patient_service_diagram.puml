@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the EMR & Patient Service container

Container_Boundary(emr_patient_service, "EMR & Patient Service") {
    Component(api_router, "API Router & Auth Middleware", "TypeScript / Fastify", "Manages patient admissions, scheduling, routing, and authentication for clinics.")
    Component(patient_engine, "Patient & Scheduling Engine", "TypeScript", "Handles patient admission workflows and clinic scheduling logic.")
    Component(emr_core, "EMR Core & Audit Service", "TypeScript", "Manages electronic medical records and maintains audit trails for HIPAA and GDPR compliance.")
    Component(data_access, "Data Access Repository", "Knex.js / node-postgres", "Interfaces with relational storage and caching layers for data retrieval and persistence.")
    Component(cache_layer, "In-Memory Caching Layer", "Redis", "Caches clinic schedules and patient lookups for low-latency access.")
    Component(billing_service, "Billing & Claims Service", "Java Spring Boot", "Handles billing integration and claims workflows.")
    Component(postgresql, "PostgreSQL with CloudNativePG", "PostgreSQL / CloudNativePG", "Relational persistence with AES-256 encryption at rest.")
    Component(kafka, "Apache Kafka", "Apache Kafka", "Event broker for asynchronous messaging using SASL/SCRAM and TLS.")
}

Rel(emr_core, billing_service, "Billing integration and workflows", "gRPC over mTLS")
Rel(emr_core, kafka, "Publishes domain events (e.g., PatientAdmitted)", "TLS and SASL/SCRAM")
Rel(data_access, postgresql, "Reads and writes encrypted records", "TLS and AES-256")
Rel(data_access, cache_layer, "Caches clinic schedules and patient lookups", "TCP")

@enduml