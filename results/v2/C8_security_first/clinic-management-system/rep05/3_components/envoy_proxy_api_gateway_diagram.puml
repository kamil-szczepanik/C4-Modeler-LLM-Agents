@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(envoy_proxy_api_gateway, "Envoy Proxy API Gateway") {
    Component(Edge_Router, "Edge Router", "Envoy Proxy", "Handles edge routing, rate limiting, and TLS 1.3 termination for high performance and security.")
    Component(Authentication_Filter, "Authentication Filter", "OAuth2-Proxy / Keycloak", "Performs zero-trust token inspection and identity management via internal token validation.")
}

Rel(Edge_Router, Authentication_Filter, "Internal token validation", "Internal HTTP / mTLS")

@enduml