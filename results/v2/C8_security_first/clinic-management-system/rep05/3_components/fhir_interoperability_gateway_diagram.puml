@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(fhir_interoperability_gateway, "FHIR Interoperability Gateway") {
    Component(HAPI_FHIR_JPA_Server_Engine, "HAPI FHIR JPA Server Engine", "Java / Spring Boot, HAPI FHIR JPA Server", "Handles standards-compliant clinical endpoints and HL7 FHIR API requests.")
    Component(Kafka_Event_Producer, "Kafka Event Producer", "Apache Kafka Producer API", "Publishes clinical and operational events to Apache Kafka asynchronously.")
    Component(Data_Persistence_Manager, "Data Persistence Manager", "JDBC, HikariCP", "Manages data persistence connections to the PostgreSQL database with AES-256 encryption.")
    Component(Session_and_Token_Caching_Manager, "Session and Token Caching Manager", "Redis Protocol Client", "Handles distributed token caching and session state management via Redis.")
}

Rel(HAPI_FHIR_JPA_Server_Engine, Kafka_Event_Producer, "Publishes event messages", "Kafka Producer API")
Rel(HAPI_FHIR_JPA_Server_Engine, Data_Persistence_Manager, "Reads and writes clinical data", "JDBC over TLS")
Rel(HAPI_FHIR_JPA_Server_Engine, Session_and_Token_Caching_Manager, "Caches tokens and session state", "Redis Protocol")
@enduml