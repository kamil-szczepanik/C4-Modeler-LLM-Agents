@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("OAuth2-Proxy_Keycloak_Sidecar", "OAuth2-Proxy / Keycloak Sidecar") {
    Component("OAuth2-Proxy Authentication Handler", "OAuth2-Proxy Authentication Handler", "Go (OAuth2-Proxy)", "Lightweight, stateless authentication sidecar handling token validation, session management, and intercepting requests from the Envoy Proxy.")
    Component("Local JWKS Caching Module", "Local JWKS Caching Module", "In-Memory Go Cache", "Caches JSON Web Key Sets locally to validate tokens swiftly and minimize latency against the Enterprise IdP.")
}

Rel("OAuth2-Proxy Authentication Handler", "Local JWKS Caching Module", "Queries cached public keys for JWT validation", "In-memory")

@enduml