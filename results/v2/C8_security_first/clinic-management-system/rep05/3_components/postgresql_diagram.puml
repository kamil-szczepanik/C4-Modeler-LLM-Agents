@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL container

Container_Boundary(postgresql, "PostgreSQL") {
    Component(PgBouncer_Sidecar, "PgBouncer Sidecar", "PgBouncer", "Connection pooler optimizing throughput and preventing thread exhaustion.")
    Component(PostgreSQL_16_Engine, "PostgreSQL 16 Engine", "PostgreSQL 16 with RLS and pgaudit", "Core relational database managing clinical and billing data with row-level security and auditing.")
    Component(WAL_G_Sidecar, "WAL-G Sidecar", "WAL-G", "Backup manager for archiving encrypted WAL logs to object storage supporting 10-year retention.")
    Component(CloudNativePG_Operator, "CloudNativePG Operator", "CloudNativePG Kubernetes Controller", "Kubernetes controller managing replication, automated failover, and high availability.")
}

Rel(PgBouncer_Sidecar, PostgreSQL_16_Engine, "Pools and routes database connections over TCP with TLS 1.3", "TCP/TLS")
Rel(WAL_G_Sidecar, PostgreSQL_16_Engine, "Reads WAL logs for backup archiving", "Internal")
Rel(CloudNativePG_Operator, PostgreSQL_16_Engine, "Manages replication and failover", "Kubernetes API")

@enduml