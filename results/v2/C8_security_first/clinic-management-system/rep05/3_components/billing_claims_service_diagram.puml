@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing & Claims Service container

Container_Boundary("Billing & Claims Service", "Billing & Claims Service") {
    Component(Billing Controller, "Billing Controller", "Java Spring Boot REST/gRPC Controller", "Handles incoming billing and claims requests, routing them to the core service layer.")
    Component(Claims Processor Service, "Claims Processor Service", "Java Spring Boot Service with Resilience4j", "Manages business logic for insurance claims, applying circuit breaking for outbound calls.")
    Component(Tokenization & Security Manager, "Tokenization & Security Manager", "Java Spring Boot / Cryptographic Utility", "Performs field-level tokenization and enforces RBAC for HIPAA/GDPR compliance.")
    Component(Kafka Outbox Publisher, "Kafka Outbox Publisher", "Apache Kafka Client with Transactional Outbox", "Publishes asynchronous events to Apache Kafka for communication with external clearinghouses.")
}

Rel(Billing Controller, Claims Processor Service, "Delegates business logic execution")
Rel(Claims Processor Service, Tokenization & Security Manager, "Encrypts and tokenizes sensitive patient and billing data")
Rel(Claims Processor Service, Kafka Outbox Publisher, "Queues asynchronous insurance claim events")

@enduml