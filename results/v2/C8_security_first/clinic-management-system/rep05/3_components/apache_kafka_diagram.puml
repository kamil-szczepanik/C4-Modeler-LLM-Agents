@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(apache_kafka, "Apache Kafka") {
    Component(Kafka_Broker, "Kafka Broker", "Java/Scala with KRaft", "Handles distributed event streaming and message brokering using KRaft mode.")
    Component(Schema_Registry, "Schema Registry", "Confluent", "Provides Avro and Protobuf schema validation and data masking.")
    Component(Tiered_Storage_Manager, "Tiered Storage Manager", "Native plug-in API over TLS 1.3", "Offloads logs to AWS S3 for long-term data retention.")
    Component(Kafka_MirrorMaker_2_MM2_, "Kafka MirrorMaker 2 (MM2)", "Kafka Connect / MM2", "Manages asynchronous cross-site replication between on-prem-k8s and AWS.")
}

Rel(Kafka_Broker, Schema_Registry, "Validates Avro and Protobuf schemas and masks data via HTTPS.", "HTTPS")
Rel(Kafka_Broker, Tiered_Storage_Manager, "Offloads logs to AWS S3 using AWS IRSA over TLS 1.3.", "TLS 1.3")
Rel(Kafka_Broker, Kafka_MirrorMaker_2_MM2_, "Replicates event streams asynchronously across sites.", "Kafka Connect / MM2")
@enduml