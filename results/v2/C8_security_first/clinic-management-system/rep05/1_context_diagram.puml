@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(PatientConsumer, "Patient / Consumer", "End users who interact with the system via the Patient Portal to manage registrations and view records.")
Person(ClinicStaffReceptionist, "Clinic Staff / Receptionist", "Staff members who manage front-desk operations, appointments, and patient intake.")
Person(ClinicianDoctor, "Clinician / Doctor", "Medical professionals who access and update Electronic Medical Records (EMRs).")
Person(BillingSpecialistAdministrator, "Billing Specialist / Administrator", "Administrative users who handle financial transactions and insurance claims.")

System(ClinicManagementSystem, "Clinic Management System", "A hybrid, highly available platform that securely manages patient registrations, appointments, Electronic Medical Records (EMRs), and billing while ensuring strict HIPAA and GDPR compliance.")

System_Ext(PatientPortalInterface, "Patient Portal Interface", "External portal interface allowing patients to access services.")
System_Ext(ExternalLabImagingSystems, "External Lab & Imaging Systems", "External diagnostic systems providing lab results and medical imaging.")
System_Ext(InsuranceClaimClearinghouse, "Insurance Claim Clearinghouse", "External clearinghouse for processing insurance claims via secure EDI/HTTPS APIs.")
System_Ext(EnterpriseIdentityPoviderIdP, "Enterprise Identity Provider (IdP)", "Handles authentication and OAuth 2.0 / OIDC integrations with mandatory MFA.")
System_Ext(SMSEmailNotificationSystem, "SMS/Email Notification System", "External notification service for dispatching appointment reminders.")

Rel(PatientConsumer, ClinicManagementSystem, "Interacts securely to manage registrations and appointments", "HTTPS, OAuth 2.0 / OIDC")
Rel(ClinicStaffReceptionist, ClinicManagementSystem, "Manages clinical operations and patient intake", "HTTPS, OAuth 2.0 / OIDC")
Rel(ClinicianDoctor, ClinicManagementSystem, "Accesses and updates EMRs and clinical data", "HTTPS, OAuth 2.0 / OIDC")
Rel(BillingSpecialistAdministrator, ClinicManagementSystem, "Manages billing and insurance claims", "HTTPS, OAuth 2.0 / OIDC")
Rel(ClinicManagementSystem, ExternalLabImagingSystems, "Integrates for lab and imaging data exchange", "HL7 FHIR APIs over HTTPS with mTLS and signed JWT assertions")
Rel(ClinicManagementSystem, InsuranceClaimClearinghouse, "Submits and processes insurance claims", "Secure EDI / HTTPS APIs")
Rel(ClinicManagementSystem, SMSEmailNotificationSystem, "Dispatches appointment reminders and notifications", "HTTPS / REST webhooks")
Rel(ClinicManagementSystem, EnterpriseIdentityPoviderIdP, "Authenticates users via single sign-on and MFA", "OAuth 2.0 / OIDC")

@enduml