@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(message_broker, "Message Broker") {
    Component(Connection & Auth Manager, "Connection & Auth Manager", "NATS JetStream / Kafka", "Handles connection management and authentication for message broker clients.")
    Component(Routing & Delivery Engine, "Routing & Delivery Engine", "NATS JetStream / Kafka", "Routes and delivers message frames across the messaging infrastructure.")
    Component(Replication & Persistence Engine, "Replication & Persistence Engine", "NATS JetStream / Kafka", "Persists message streams and commits offsets using distributed consensus.")
}

System_Ext(Audit & Compliance Daemon, "Audit & Compliance Daemon", "Go")

Rel(Connection & Auth Manager, Routing & Delivery Engine, "Forwards authenticated client frames", "gRPC")
Rel(Routing & Delivery Engine, Replication & Persistence Engine, "Persists message streams and commits offsets", "Raft consensus protocol / JetStream API")
Rel(Routing & Delivery Engine, Audit & Compliance Daemon, "Streams real-time telemetry logs", "Syslog over TLS")
@enduml