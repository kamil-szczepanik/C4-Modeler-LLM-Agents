@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(EdgeListenerComponent, "Edge Listener Component", "Kong / Envoy (Golang/Lua/WASM plugins)", "Handles edge routing and initial request entry for incoming traffic.")
    Component(AuthPolicyEnforcementComponent, "Auth & Policy Enforcement Component", "Kong / Envoy (Golang/Lua/WASM plugins)", "Validates OAuth2/OIDC tokens and enforces security policies.")
    Component(TransformationPolicyComponent, "Transformation & Policy Component", "Kong / Envoy (Golang/Lua/WASM plugins)", "Transforms requests and applies policies such as Redis-backed Token Bucket rate limiting.")
    Component(TrafficManagementComponent, "Traffic Management Component", "Kong / Envoy (Golang/Lua/WASM plugins)", "Manages priority-based traffic management and routing behavior.")
    Component(UpstreamRouterComponent, "Upstream Router Component", "Kong / Envoy (Golang/Lua/WASM plugins)", "Routes requests to internal backend containers using gRPC over mTLS.")
}

Rel(EdgeListenerComponent, AuthPolicyEnforcementComponent, "Passes incoming requests for token validation")
Rel(AuthPolicyEnforcementComponent, TransformationPolicyComponent, "Forwards authenticated requests for transformation and rate limiting")
Rel(TransformationPolicyComponent, TrafficManagementComponent, "Passes processed requests for traffic prioritization")
Rel(TrafficManagementComponent, UpstreamRouterComponent, "Dispatches requests to the appropriate upstream container")

@enduml