@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the EMR Core Service container

Container_Boundary(emr_core_service, "EMR Core Service") {
    Component(ChartEncounterManager, "Chart & Encounter Manager", "Java 21 / .NET 8", "Manages patient charts, clinical encounters, and core medical records workflows.")
    Component(AuthorizationPolicyComponent, "Authorization & Policy Component", "Java 21 / .NET 8", "Handles access control, permissions, and security policies for clinical operations.")
}

Rel(ChartEncounterManager, AuthorizationPolicyComponent, "Validates clinical requests against security policies")

@enduml