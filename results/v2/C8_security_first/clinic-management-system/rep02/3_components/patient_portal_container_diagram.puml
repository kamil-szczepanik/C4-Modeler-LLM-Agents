@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient Portal Container container

Container_Boundary("Patient Portal Container", "Patient Portal Container") {
    Component("Patient Portal API Router", "Patient Portal API Router", "Node.js/NestJS", "Routes client requests and handles API routing for the patient portal.")
    Component("Patient Portal Service", "Patient Portal Service", "Go", "Coordinates resource checks and business logic for patient workflows.")
}

Rel("Patient Portal API Router", "Patient Portal Service", "Delegates request handling and coordination", "Internal IPC")

@enduml