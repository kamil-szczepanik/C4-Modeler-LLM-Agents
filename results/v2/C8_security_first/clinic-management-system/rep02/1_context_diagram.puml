@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "Individuals receiving care who interact with the system for scheduling and appointments.")
Person(Receptionists_Front_Desk_Staff, "Receptionists / Front Desk Staff", "Administrative staff managing patient admissions and front desk operations.")
Person(Clinicians_Doctors, "Clinicians / Doctors", "Medical professionals managing electronic medical records and patient care.")
Person(Billing_Specialists, "Billing Specialists", "Financial staff handling insurance billing and claims.")

System(Clinic_Management_System, "Clinic Management System", "A hybrid cloud platform designed for medium-sized hospitals and clinics to securely manage patient admissions, electronic medical records, appointment scheduling, and insurance billing.")

System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "External system handling authentication and identity management.")
System_Ext(Lab_Imaging_Systems, "Lab & Imaging Systems", "External clinical systems providing laboratory and imaging data.")
System_Ext(Insurance_Clearinghouse, "Insurance Clearinghouse", "External system for processing insurance claims and billing.")

Rel(Patients, Clinic_Management_System, "Accesses appointments and admissions", "HTTPS (TLS 1.3), Web/Mobile UI")
Rel(Receptionists_Front_Desk_Staff, Clinic_Management_System, "Manages patient front desk operations", "HTTPS (TLS 1.3), Web/Mobile UI")
Rel(Clinicians_Doctors, Clinic_Management_System, "Updates electronic medical records and manages care", "HTTPS (TLS 1.3), Web/Mobile UI")
Rel(Billing_Specialists, Clinic_Management_System, "Processes billing and claims", "HTTPS (TLS 1.3), Web/Mobile UI")

Rel(Clinic_Management_System, Identity_Provider_IdP, "Authenticates users", "OIDC / SAML over HTTPS")
Rel(Clinic_Management_System, Lab_Imaging_Systems, "Exchanges clinical data", "HL7 FHIR over mTLS")
Rel(Lab_Imaging_Systems, Clinic_Management_System, "Returns clinical data and results", "HL7 FHIR over mTLS")
Rel(Clinic_Management_System, Insurance_Clearinghouse, "Submits insurance claims", "REST over HTTPS with OAuth 2.0")

@enduml