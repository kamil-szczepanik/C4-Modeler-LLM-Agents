@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(interoperability_service, "Interoperability Service") {
    Component(API_Gateway, "API Gateway", ".NET Core YARP", "Handles inbound TLS termination, mTLS validation, rate limiting, and request routing.")
    Component(FHIR_Transformer_Engine, "FHIR Transformer Engine", "Apache Camel / .NET worker", "Performs asynchronous message translation and JSON schema validation.")
    Component(Integration_Queue, "Integration Queue", "RabbitMQ", "Buffers inbound and outbound payloads with envelope encryption (AES-256) and DLQ support.")
    Component(Outbound_Dispatcher, "Outbound Dispatcher", ".NET Core HttpClient", "Manages outbound notifications using Polly circuit breakers and exponential backoff.")
    Component(Audit_Compliance_Interceptor, "Audit & Compliance Interceptor", ".NET Middleware", "Captures metadata and invokes the Audit Logger Sidecar.")
}

System_Ext(External_Lab_Imaging_Systems, "External Lab & Imaging Systems", "Third-party diagnostic systems")

Rel(API_Gateway, FHIR_Transformer_Engine, "Forwards validated requests", "In-process / gRPC with mTLS metadata")
Rel(FHIR_Transformer_Engine, Integration_Queue, "Queues asynchronous payloads", "AMQP")
Rel(FHIR_Transformer_Engine, Outbound_Dispatcher, "Passes processed payloads", "In-process / gRPC")
Rel(Outbound_Dispatcher, External_Lab_Imaging_Systems, "Sends FHIR notifications", "HTTPS / mTLS")
Rel(API_Gateway, Audit_Compliance_Interceptor, "Logs ingress requests", "In-process middleware")

@enduml