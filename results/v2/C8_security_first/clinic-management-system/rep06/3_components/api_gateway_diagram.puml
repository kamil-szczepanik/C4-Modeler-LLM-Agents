@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(KongEnvoyRouter, "Kong / Envoy Router", "Kong / Envoy", "Handles incoming client requests, routing, and load balancing across internal services.")
    Component(WAF, "WAF", "Coraza", "Performs payload inspection and threat mitigation for inbound traffic.")
    Component(RateLimiter, "Rate Limiter", "Redis", "Implements token-bucket rate limiting for API requests.")
    Component(TelemetrySidecar, "Telemetry Sidecar", "Fluentbit", "Collects and pushes async batch telemetry and logs.")
}

Rel(KongEnvoyRouter, WAF, "Inspects requests")
Rel(KongEnvoyRouter, RateLimiter, "Checks rate limits")
Rel(KongEnvoyRouter, TelemetrySidecar, "Emits telemetry data")

@enduml