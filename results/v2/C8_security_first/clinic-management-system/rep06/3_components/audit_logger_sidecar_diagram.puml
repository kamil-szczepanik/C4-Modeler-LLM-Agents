@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(Audit_Logger_Sidecar, "Audit Logger Sidecar") {
    Component(Log_Ingestor_Component, "Log Ingestor Component", "Unix Domain Socket / Localhost", "Local Unix Domain Socket receiver for high-performance, non-blocking local inter-container communication from main application containers.")
    Component(Scrubbing___Hashing_Component, "Scrubbing & Hashing Component", "VRL (Vector Remap Language)", "PII/PHI redaction and SHA-256 Merkle tree framing module for real-time regex scrubbing and cryptographic tamper-evidence.")
    Component(Buffer___Batching_Component, "Buffer & Batching Component", "Ephemeral disk-backed buffer (emptyDir)", "Ephemeral disk-backed buffer ensuring zero latency impact on core clinical workflows through asynchronous, non-blocking buffering.")
    Component(Log_Exporter_Component, "Log Exporter Component", "TLS 1.3 over HTTPS", "TLS 1.3 streaming mechanism for secure log transmission to the Central SIEM.")
}

Rel(Log_Ingestor_Component, Scrubbing___Hashing_Component, "Passes raw logs for PII/PHI redaction and hashing", "In-memory")
Rel(Scrubbing___Hashing_Component, Buffer___Batching_Component, "Stores scrubbed and framed logs in ephemeral disk buffer", "Internal")
Rel(Buffer___Batching_Component, Log_Exporter_Component, "Batches and supplies logs for secure export", "Internal")
@enduml