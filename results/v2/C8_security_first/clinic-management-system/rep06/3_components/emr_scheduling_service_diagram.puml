@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the EMR & Scheduling Service container

Container_Boundary(emr_scheduling_service, "EMR & Scheduling Service") {
    Component(Appointment_Scheduler, "Appointment Scheduler", "Java / Spring Boot", "Manages clinic appointments and communicates with Redis for schedule locks.")
    Component(EMR_Management, "EMR Management", "Java / Spring Boot", "Manages electronic medical records and persists PHI to PostgreSQL.")
    Component(Audit_Dispatcher, "Audit Dispatcher", "Java / Spring Boot", "Dispatches audit logs to ensure compliance.")
    Component(Event_Publisher, "Event Publisher", "Java / Spring Boot", "Emits domain events to Apache Kafka.")
}

System_Ext(Redis, "Redis", "Distributed Redis Cache")
System_Ext(PostgreSQL, "PostgreSQL", "Encrypted PostgreSQL (Patroni)")
System_Ext(Interoperability_Service, "Interoperability Service", "Interoperability Service (.NET Core)")

Rel(Appointment_Scheduler, Redis, "Read/Write schedule locks", "Redis Protocol over TLS")
Rel(EMR_Management, PostgreSQL, "Persist PHI", "JDBC over TLS 1.3")
Rel(Event_Publisher, Interoperability_Service, "Emit domain events", "Apache Kafka / AMQP over TLS 1.3")

@enduml