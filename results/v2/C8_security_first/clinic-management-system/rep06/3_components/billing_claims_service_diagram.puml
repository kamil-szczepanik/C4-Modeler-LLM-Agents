@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(billing_claims_service, "Billing & Claims Service") {
    Component(BillingController, "Billing Controller", "Node.js / TypeScript", "Handles incoming billing requests and routes them appropriately.")
    Component(ClaimsProcessor, "Claims Processor", "Node.js / TypeScript", "Processes automated claims and appeals to insurance clearinghouses.")
    Component(PaymentReconciliationWorker, "Payment Reconciliation Worker", "Node.js / TypeScript", "Processes payment status updates via message broker.")
}

Rel(BillingController, ClaimsProcessor, "Invokes claims processing logic", "Internal function call")
Rel(ClaimsProcessor, PaymentReconciliationWorker, "Pushes payment status updates", "AMQP via RabbitMQ")
@enduml