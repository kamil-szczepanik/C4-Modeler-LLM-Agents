@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Receptionist_Front_Desk, "Receptionist / Front Desk", "Manages patient admissions and scheduling.")
Person(Clinician_Doctor, "Clinician / Doctor", "Accesses and updates Electronic Medical Records (EMRs).")
Person(Billing_Specialist, "Billing Specialist", "Handles billing and insurance claims.")
Person(Patient, "Patient", "Interacts with clinic services and receives care.")

System(Clinic_Management_System, "Clinic Management System", "Manages patient admissions, EMRs, scheduling, and billing for healthcare clinics via a hybrid cloud architecture.")

System_Ext(External_Lab_Imaging_Systems, "External Lab & Imaging Systems", "Provides diagnostic results and imaging data.")
System_Ext(Insurance_Clearinghouses, "Insurance Clearinghouses", "Processes automated billing claims.")
System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "Validates authentication and multi-factor authentication for users.")

Rel(Receptionist_Front_Desk, Clinic_Management_System, "Authenticate and access services via Edge WAF", "HTTPS, OAuth 2.0 / OIDC")
Rel(Clinician_Doctor, Clinic_Management_System, "Authenticate and access EMRs and scheduling", "HTTPS, OAuth 2.0 / OIDC")
Rel(Billing_Specialist, Clinic_Management_System, "Access billing services", "HTTPS, OAuth 2.0 / OIDC")
Rel(Patient, Clinic_Management_System, "Access clinic services", "HTTPS, OAuth 2.0 / OIDC")
Rel(Clinic_Management_System, External_Lab_Imaging_Systems, "Ingest diagnostic results", "HL7 FHIR REST APIs over TLS 1.3")
Rel(Clinic_Management_System, Insurance_Clearinghouses, "Submit automated billing claims", "HTTPS/REST APIs")
Rel(Clinic_Management_System, Identity_Provider_IdP, "Validate step-up Multi-Factor Authentication", "OAuth 2.0 / OIDC & MFA")
@enduml