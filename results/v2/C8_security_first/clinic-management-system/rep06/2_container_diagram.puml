@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Receptionist_Front_Desk, "Receptionist / Front Desk", "Manages patient admissions and scheduling.")
Person(Clinician_Doctor, "Clinician / Doctor", "Accesses and updates Electronic Medical Records (EMRs).")
Person(Billing_Specialist, "Billing Specialist", "Handles billing and insurance claims.")
Person(Patient, "Patient", "Interacts with clinic services and receives care.")

System_Ext(External_Lab_Imaging_Systems, "External Lab & Imaging Systems", "Provides diagnostic results and imaging data.")
System_Ext(Insurance_Clearinghouses, "Insurance Clearinghouses", "Processes automated billing claims.")
System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "Validates authentication and multi-factor authentication for users.")

System_Boundary(Clinic_Management_System, "Clinic Management System") {
    Container(API_Gateway, "API Gateway", "Kong / Envoy, TLS, mTLS, OIDC", "Handles TLS, mTLS, and OIDC validation, routing requests to internal services.")
    Container(EMR_Scheduling_Service, "EMR & Scheduling Service", "Java / Spring Boot, Encrypted PostgreSQL", "Manages patient admissions, electronic medical records, and scheduling.")
    Container(Billing_Claims_Service, "Billing & Claims Service", "Node.js / TypeScript, Redis, RabbitMQ", "Handles billing operations and claims processing.")
    Container(Interoperability_Service, "Interoperability Service", ".NET Core / Apache Camel", "Translates and handles HL7 FHIR messages for external lab and imaging systems.")
    Container(Audit_Logger_Sidecar, "Audit Logger Sidecar", "Lightweight container", "Streams immutable logs for security, compliance, and auditing.")
}

Rel(Receptionist_Front_Desk, API_Gateway, "Authenticate and request routing", "HTTPS / OAuth 2.0 / OIDC")
Rel(Clinician_Doctor, API_Gateway, "Authenticate and request routing", "HTTPS / OAuth 2.0 / OIDC")
Rel(Billing_Specialist, API_Gateway, "Authenticate and request routing", "HTTPS / OAuth 2.0 / OIDC")
Rel(Patient, API_Gateway, "Authenticate and request routing", "HTTPS / OAuth 2.0 / OIDC")
Rel(API_Gateway, EMR_Scheduling_Service, "Route requests via service mesh", "gRPC over mTLS")
Rel(API_Gateway, Billing_Claims_Service, "Route billing requests", "HTTPS")
Rel(EMR_Scheduling_Service, Identity_Provider_IdP, "Validate OIDC tokens", "OIDC")
Rel(Billing_Claims_Service, Insurance_Clearinghouses, "Submit automated billing claims", "REST / HL7 FHIR over HTTPS")
Rel(Interoperability_Service, External_Lab_Imaging_Systems, "Exchange lab and imaging data", "HL7 FHIR APIs over HTTPS")

@enduml