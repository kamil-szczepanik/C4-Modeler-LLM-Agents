@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(billing_and_claims_service, "Billing & Claims Service") {
    Component(ClaimSubmissionEngine, "Claim Submission Engine", "Java Spring Boot", "Submits insurance claims and processes billing logic.")
    Component(InvoiceAndLedgerController, "Invoice & Ledger Controller", "Java Spring Boot", "Manages invoices and ledger entries for patient billing.")
    Component(PaymentAndAdjudicationListener, "Payment & Adjudication Listener", "Java Spring Boot / Apache Kafka", "Consumes payment and claim status updates asynchronously.")
    ComponentDb(BillingDataRepository, "Billing Data Repository", "Spring Data JPA / PostgreSQL", "Handles data persistence for financial records.")
    Component(DLQRoutingAndFallbackHandler, "DLQ Routing & Fallback Handler", "Java Spring Boot / Resilience4j", "Routes failures to DLQ and manages fault tolerance.")
}

Rel(ClaimSubmissionEngine, BillingDataRepository, "Reads/writes financial records")
Rel(InvoiceAndLedgerController, BillingDataRepository, "Reads/writes financial records")
Rel(PaymentAndAdjudicationListener, BillingDataRepository, "Updates financial records upon event consumption")
Rel(ClaimSubmissionEngine, DLQRoutingAndFallbackHandler, "Routes processing failures")

@enduml