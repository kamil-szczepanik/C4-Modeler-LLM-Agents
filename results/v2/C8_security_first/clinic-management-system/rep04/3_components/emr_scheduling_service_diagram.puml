@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the EMR & Scheduling Service container

Container_Boundary(emr_scheduling_service, "EMR & Scheduling Service") {
    Component(Patient Management Component, "Patient Management Component", "Java Spring Boot 3.x", "Handles patient admissions and demographic records.")
    Component(Scheduling Engine Component, "Scheduling Engine Component", "Java Spring Boot 3.x with Redisson", "Manages appointment scheduling with distributed locking for clash-free scheduling.")
    Component(EMR Core Component, "EMR Core Component", "Java Spring Boot 3.x with Hibernate Envers", "Tracks EMR records and automated, immutable audit trails.")
    Component(Audit Log Interceptor, "Audit Log Interceptor", "Java Spring Boot 3.x", "Ensures strict security and regulatory compliance logging.")
}

Rel(Patient Management Component, EMR Core Component, "Coordinates patient data tracking", "In-process")
Rel(Scheduling Engine Component, Patient Management Component, "Schedules appointments for patients", "In-process")
Rel(EMR Core Component, Audit Log Interceptor, "Triggers audit logs for EMR changes", "In-process")

@enduml