@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Engine container

Container_Boundary(integration_engine, "Integration Engine") {
    Component(FHIR_Endpoint_API, "FHIR Endpoint API", "Java / HAPI FHIR JPA Server", "Exposes FHIR compliant APIs and persists normalized resources.")
    Component(Transformation_Mapping, "Transformation & Mapping", "Apache Camel", "Handles protocol translation and persists normalized resources.")
    Component(Outbound_Dispatcher, "Outbound Dispatcher", "Spring Integration", "Dispatches outbound payloads securely.")
    Component(Provenance_Audit_Interceptor, "Provenance & Audit Interceptor", "Java", "Monitors and logs data provenance and audit trails.")
    Component(Metrics_Exporter, "Metrics Exporter", "Micrometer / Prometheus", "Exports operational metrics for monitoring.")
}

System_Ext(External_Lab_Imaging_Systems, "External Lab & Imaging Systems", "External Lab & Imaging Systems")

Rel(Transformation_Mapping, FHIR_Endpoint_API, "Persists normalized resources", "JDBC / TLS")
Rel(Outbound_Dispatcher, External_Lab_Imaging_Systems, "Dispatches outbound payloads", "HTTPS / mTLS with HashiCorp Vault certificates")
@enduml