@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Tier container

System_Ext(emr_scheduling_service, "EMR & Scheduling Service", "External service interacting with the Data Tier")
System_Ext(billing_claims_service, "Billing & Claims Service", "External service interacting with the Data Tier")
System_Ext(event_broker_kafka, "Event Broker (Kafka)", "External event streaming platform")

Container_Boundary(data_tier, "Data Tier") {
    Component(primary_write_instance, "Primary Write Instance", "PostgreSQL Cluster", "Primary PostgreSQL instance handling write operations for patient records, scheduling, and billing.")
    Component(read_replica_instances, "Read Replica Instances", "PostgreSQL (Local Synchronous & Cross-Region Read Replicas)", "Provides read-only access to data with session consistency.")
    Component(pgbouncer_connection_pooler, "PgBouncer Connection Pooler", "PgBouncer", "Manages and pools database connections to handle high concurrency and prevent saturation.")
    Component(postgresql_audit_log_collector, "PostgreSQL Audit Log Collector", "pgAudit Extension", "Collects native, tamper-evident data access logs for comprehensive compliance auditing.")
    Component(cloudnativepg_operator, "CloudNativePG Operator", "CloudNativePG", "Kubernetes operator managing automated failover and health checks.")
    Component(worm_storage_siem, "WORM Storage / SIEM", "WORM Storage", "Stores immutable compliance logs meeting long-term retention requirements.")
}

Rel(emr_scheduling_service, primary_write_instance, "Writes transactional data", "TCP/SQL via mTLS")
Rel(emr_scheduling_service, read_replica_instances, "Reads data with session consistency", "TCP/SQL via mTLS")
Rel(billing_claims_service, primary_write_instance, "Writes financial data", "TCP/SQL via mTLS")
Rel(postgresql_audit_log_collector, event_broker_kafka, "Streams compliance audit events", "Async / PubSub")

@enduml