@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Event Broker container

Container_Boundary(event_broker, "Event Broker") {
    Component(Kafka_Broker_Core, "Kafka Broker Core", "Apache Kafka in KRaft mode", "Provides asynchronous, decoupled messaging and eliminates ZooKeeper overhead for lower latency.")
    Component(Schema_Registry, "Schema Registry", "Confluent Schema Registry", "Enforces strict Avro/Protobuf contracts to prevent schema drift and consumer breakage.")
    Component(Kafka_Connect, "Kafka Connect", "Kafka Connect with S3 Tiered Storage", "Streams events for long-term retention and offloads aged log segments to cloud storage.")
    Component(MirrorMaker_2, "MirrorMaker 2", "MirrorMaker 2", "Handles asynchronous cross-site replication between hybrid environments.")
}

Component(S3_Object_Storage, "S3 / Object Storage", "AWS S3", "Stores 10-year audit logs offloaded via Tiered Storage.")
Component(Billing_Claims_Service, "Billing & Claims Service", "Microservice", "Publishes billing events and validates event schemas.")
Component(EMR_Scheduling_Service, "EMR & Scheduling Service", "Microservice", "Publishes clinical events and validates EMR event schemas.")

Rel(Billing_Claims_Service, Schema_Registry, "Validates event schemas", "HTTP/REST")
Rel(Billing_Claims_Service, Kafka_Broker_Core, "Publishes billing events", "TCP / mTLS / SASL")
Rel(EMR_Scheduling_Service, Schema_Registry, "Validates EMR event schemas", "HTTP/REST")
Rel(EMR_Scheduling_Service, Kafka_Broker_Core, "Publishes clinical events", "TCP / mTLS / SASL")
Rel(Kafka_Broker_Core, Kafka_Connect, "Streams events for long-term retention", "TCP / mTLS")
Rel(Kafka_Connect, S3_Object_Storage, "Offloads aged log segments via Tiered Storage", "HTTPS / TLS 1.3")
Rel(MirrorMaker_2, Kafka_Broker_Core, "Replicates cross-site events between on-prem-k8s and eu-central-1", "TCP / mTLS")

@enduml