@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(EdgeTLSTerminationRouter, "Edge TLS Termination & Router", "Kong / Envoy / Istio proxy", "Handles perimeter routing and edge-terminated mTLS.")
    Component(AuthPolicyEnforcement, "Auth & Policy Enforcement", "OAuth2/OIDC + OPA", "Validates tokens and enforces security and compliance policies.")
    Component(RateLimitingTrafficShaping, "Rate Limiting & Traffic Shaping", "Redis", "Checks quotas and manages rate-limiting states.")
    Component(TelemetryAuditComponent, "Telemetry & Audit Component", "OpenTelemetry / Prometheus", "Handles hybrid-cloud telemetry and PHI-sanitized audit logging.")
    Component(CircuitBreakerResilienceComponent, "Circuit Breaker & Resilience Component", "Kong / Envoy / Istio", "Ensures resilience and fault tolerance for routed traffic.")
}

Rel(EdgeTLSTerminationRouter, AuthPolicyEnforcement, "Forwards requests for validation")
Rel(AuthPolicyEnforcement, RateLimitingTrafficShaping, "Checks quotas and token revocation blacklist")
@enduml