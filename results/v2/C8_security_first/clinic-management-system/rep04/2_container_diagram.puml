@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Patients, "Patients", "Patients interacting with the clinic system for appointments, records, and billing.")
Person(ClinicalStaff, "Clinical Staff", "Doctors and Nurses managing patient admissions and electronic medical records.")
Person(AdminBillingStaff, "Administrative & Billing Staff", "Staff managing hospital administration, scheduling, and billing operations.")
Person(HospitalIT, "Hospital IT / Compliance Officers", "Personnel overseeing system compliance, security, and infrastructure.")

System_Ext(IdentityProvider, "Identity Provider", "External IdP handling authentication and authorization.")
System_Ext(PaymentGateway, "Third-Party Payment Gateway", "External system processing financial transactions and billing.")
System_Ext(ExternalLab, "External Lab & Imaging Systems", "External clinical systems providing lab results and medical imaging.")

System_Boundary(ClinicSystem, "Clinic Management System") {
    Container(ApiGateway, "API Gateway", "Kong / Envoy / Istio", "Perimeter security, rate-limiting, routing, and mTLS internal traffic security.")
    Container(EmrService, "EMR & Scheduling Service", "Java Spring Boot / Node.js NestJS", "Microservice handling patient admissions, EMRs, and appointment scheduling.")
    Container(BillingService, "Billing & Claims Service", "Java Spring Boot", "Microservice handling financial transactions, billing, and insurance claims.")
    Container(IntegrationEngine, "Integration Engine", "HAPI FHIR", "Integration engine for standardized healthcare interoperability with external systems.")
    ContainerDb(DataTier, "Data Tier", "PostgreSQL", "Primary database with row-level security and asynchronous replication.")
    Container(EventBroker, "Event Broker", "Apache Kafka", "Event broker for decoupled, resilient asynchronous messaging.")
}

Rel(Patients, ApiGateway, "Accesses patient portal, appointments, and records", "HTTPS (TLS 1.3)")
Rel(ClinicalStaff, ApiGateway, "Manages patient admissions and EMRs", "HTTPS (TLS 1.3)")
Rel(AdminBillingStaff, ApiGateway, "Handles scheduling and billing operations", "HTTPS (TLS 1.3)")
Rel(HospitalIT, ApiGateway, "Monitors system compliance, security, and configuration", "HTTPS (TLS 1.3)")

Rel(ApiGateway, EmrService, "Routes client requests to EMR backend", "gRPC over mTLS")
Rel(ApiGateway, BillingService, "Routes client requests to Billing backend", "gRPC over mTLS")

Rel(EmrService, DataTier, "Reads and writes EMR and scheduling data", "TCP/SQL with read/write segregation")
Rel(BillingService, DataTier, "Reads and writes billing data", "TCP/SQL")

Rel(BillingService, PaymentGateway, "Processes payments and financial claims", "HTTPS")
Rel(BillingService, EventBroker, "Publishes asynchronous financial events", "Apache Kafka")

Rel(IntegrationEngine, ExternalLab, "Exchanges lab results and medical imaging", "HL7 FHIR APIs")
Rel(EmrService, IntegrationEngine, "Integrates clinical data and external results", "Internal API / HL7 FHIR")

@enduml