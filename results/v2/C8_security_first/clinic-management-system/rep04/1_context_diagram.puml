@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "Patients interacting with the clinic system for appointments, records, and billing.")
Person(Clinical_Staff, "Clinical Staff", "Doctors and Nurses managing patient admissions and electronic medical records.")
Person(Administrative_Billing_Staff, "Administrative & Billing Staff", "Staff managing hospital administration, scheduling, and billing operations.")
Person(Hospital_IT_Compliance_Officers, "Hospital IT / Compliance Officers", "Personnel overseeing system compliance, security, and infrastructure.")

System(Clinic_Management_System, "Clinic Management System", "A hybrid healthcare platform that manages patient admissions, electronic medical records, scheduling, and billing for medium-sized hospitals, ensuring HIPAA and GDPR compliance with high availability.")

System_Ext(Identity_Provider, "Identity Provider", "External IdP handling authentication and authorization.")
System_Ext(Third_Party_Payment_Gateway, "Third-Party Payment Gateway", "External system processing financial transactions and billing.")
System_Ext(External_Lab_Imaging_Systems, "External Lab & Imaging Systems", "External clinical systems providing lab results and medical imaging.")

Rel(Patients, Clinic_Management_System, "Interacts for appointments, medical records, and billing", "HTTPS / TLS 1.3 with mandatory MFA")
Rel(Clinical_Staff, Clinic_Management_System, "Manages patient admissions and electronic medical records", "HTTPS / TLS 1.3 with mandatory MFA")
Rel(Administrative_Billing_Staff, Clinic_Management_System, "Handles scheduling and billing operations", "HTTPS / TLS 1.3 with mandatory MFA")
Rel(Hospital_IT_Compliance_Officers, Clinic_Management_System, "Monitors system compliance and configuration", "HTTPS / TLS 1.3 with mandatory MFA")

Rel(Clinic_Management_System, Identity_Provider, "Authenticates users", "OIDC / SAML")
Rel(Clinic_Management_System, Third_Party_Payment_Gateway, "Processes payments and financial transactions", "HTTPS / REST")
Rel(Clinic_Management_System, External_Lab_Imaging_Systems, "Exchanges lab results and imaging data", "HL7 FHIR APIs (HTTPS / REST over mTLS)")

@enduml