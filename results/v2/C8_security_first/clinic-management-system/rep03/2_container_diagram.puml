@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Receptionists, "Receptionists", "Manages patient admissions and front-desk scheduling.")
Person(Clinicians, "Clinicians", "Doctors and nurses who access and update electronic medical records (EMR) and clinical workflows.")
Person(Billing Officers, "Billing Officers", "Manages patient billing, claims, and financial transactions.")
Person(Patients, "Patients", "End users who interact with the system for scheduling and personal health records.")

System_Ext(External Lab & Imaging Systems, "External Lab & Imaging Systems", "External systems providing laboratory results and medical imaging data.")
System_Ext(Third-Party Payment Gateway & Insurance Clearinghouses, "Third-Party Payment Gateway & Insurance Clearinghouses", "External financial and insurance systems for processing payments and claims.")
System_Ext(Identity Provider (IdP), "Identity Provider (IdP)", "Handles identity federation, authentication, and OAuth 2.0 / OIDC services.")

System_Boundary(Clinic Management System, "Clinic Management System") {
    Container(API Gateway, "API Gateway", "Kong / Nginx", "Edge routing, WAF, rate-limiting, and JWT validation.")
    Container(Patient-Facing UI, "Patient-Facing UI", "React / Next.js", "User interface for patients to access the portal and personal health records.")
    Container(Patient Portal, "Patient Portal", "Web", "Portal interface enabling patient interactions.")
    Container(Clinical Core Services, "Clinical Core Services", "Spring Boot / Java", "Manages core clinical records and EMR workflows.")
    Container(Interoperability Service, "Interoperability Service", "Apache Camel / Node.js", "Connects to external Lab & Imaging systems via HL7 FHIR REST APIs.")
    Container(Billing & Claims Service, "Billing & Claims Service", "Spring Boot / Java", "Manages patient billing, insurance claims, and financial workflows.")
}

Rel(Patients, API Gateway, "Accesses the system via HTTPS/TLS through the API Gateway validating JWTs", "HTTPS/TLS, JWT")
Rel(Receptionists, API Gateway, "Accesses the system via HTTPS/TLS through the API Gateway validating JWTs", "HTTPS/TLS, JWT")
Rel(Clinicians, API Gateway, "Accesses the system via HTTPS/TLS through the API Gateway validating JWTs", "HTTPS/TLS, JWT")
Rel(Billing Officers, API Gateway, "Accesses the system via HTTPS/TLS through the API Gateway validating JWTs", "HTTPS/TLS, JWT")
Rel(Patient-Facing UI, API Gateway, "Communicates with backend containers via OAuth2 authorization code flow with PKCE", "OAuth2, PKCE")
Rel(Clinical Core Services, Billing & Claims Service, "Communicates internally using gRPC over mTLS", "gRPC, mTLS")
Rel(Clinical Core Services, Interoperability Service, "Communicates internally using gRPC over mTLS", "gRPC, mTLS")
Rel(Billing & Claims Service, Interoperability Service, "Communicates internally using gRPC over mTLS", "gRPC, mTLS")
Rel(Interoperability Service, External Lab & Imaging Systems, "Connects to external Lab & Imaging systems using mTLS and SMART-on-FHIR scopes", "HL7 FHIR REST APIs, mTLS, SMART-on-FHIR")
Rel(Billing & Claims Service, Third-Party Payment Gateway & Insurance Clearinghouses, "Interacts asynchronously via message queues", "RabbitMQ / Kafka")

@enduml