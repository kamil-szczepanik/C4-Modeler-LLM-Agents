@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(EdgeRouter, "Edge Router & Reverse Proxy", "Kong Enterprise / Nginx core", "Handles edge routing and reverse proxying for incoming traffic.")
    Component(SecurityAuth, "Security & Auth Plugin Module", "Kong Plugin / JWT", "Performs JWT validation and enforces authentication.")
    Component(WafRateLimiting, "WAF & Rate Limiting Engine", "Kong WAF / Redis", "Provides web application firewall protection and distributed rate limiting.")
    Component(FhirMediator, "FHIR Mediator Route", "Kong Gateway Route", "Routes and mediates HL7 FHIR API traffic.")
    Component(PolicyEnforcement, "Policy Enforcement Hook", "Kong Enterprise", "Enforces security policies and compliance rules.")
    Component(TelemetryAudit, "Telemetry & Audit Forwarder", "OpenTelemetry / HTTPS", "Streams sanitized OpenTelemetry traces and tamper-evident audit logs.")
}

System_Ext(SiomObservability, "SIEM/Observability Platform", "External observability and security information event management system")

Rel(EdgeRouter, SecurityAuth, "Passes requests for JWT validation")
Rel(SecurityAuth, WafRateLimiting, "Forwards authenticated requests for rate limiting and WAF check")
Rel(WafRateLimiting, PolicyEnforcement, "Checks policies before routing")
Rel(PolicyEnforcement, FhirMediator, "Routes valid traffic to backend services")
Rel(TelemetryAudit, SiomObservability, "Streams telemetry and audit logs asynchronously", "OpenTelemetry, HTTPS")

@enduml