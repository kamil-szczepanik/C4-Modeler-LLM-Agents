@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(interoperability_service, "Interoperability Service") {
    Component(Route Orchestrator, "Route Orchestrator", "Apache Camel / Node.js", "Orchestrates enterprise integration patterns and routing for interoperability messages.")
    Component(FHIR Transformer & Validator, "FHIR Transformer & Validator", "Apache Camel / Node.js", "Transforms and validates clinical data to ensure adherence to HL7 FHIR standards.")
    Component(Outbound Security & Auth Agent, "Outbound Security & Auth Agent", "HashiCorp Vault / OAuth2", "Secures outbound requests and manages OAuth2 client credentials and runtime API keys.")
    Component(Resiliency & DLQ Handler, "Resiliency & DLQ Handler", "RabbitMQ / Kafka", "Powers the Dead-Letter Queue (DLQ) for resilient failure handling and message retries.")
    Component(Idempotency Store, "Idempotency Store", "Redis", "Provides fast-lookup caching ensuring request idempotency via unique accession numbers.")
    Component(Operational Metrics Exporter, "Operational Metrics Exporter", "OpenTelemetry & Prometheus", "Delivers distributed tracing, metrics scraping, and alerting for the service.")
}

System_Ext(Monitoring Stack, "Monitoring Stack", "External system for monitoring and metrics")

Rel(Route Orchestrator, Idempotency Store, "Cache lookup", "Redis RESP, TLS")
Rel(Operational Metrics Exporter, Monitoring Stack, "Metrics scraping", "Prometheus, HTTP")

@enduml