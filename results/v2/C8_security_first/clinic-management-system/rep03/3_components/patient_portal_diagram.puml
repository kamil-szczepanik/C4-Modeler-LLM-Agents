@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "End-users accessing self-service health management features.")
System_Ext(ExternalIdentityIdP, "External Identity Provider (IdP)", "Manages primary user authentication credentials.")
System_Ext(ClinicalCoreServices, "Clinical Core Services", "Downstream backend infrastructure handling core clinic operations.")

Container_Boundary(patient_portal, "Patient Portal") {
    Component(PatientFacingUI, "Patient-Facing UI", "Node.js / TypeScript", "End-user interface allowing patients to access self-service health management features.")
    Component(PatientAuthDelegator, "Patient Auth Delegator", "Node.js / TypeScript, OIDC/OAuth 2.1, httpOnly JWT", "Component handling OIDC/OAuth 2.1 authentication, adaptive MFA, and httpOnly JWT session management.")
    Component(AppointmentSchedulingFacade, "Appointment & Scheduling Facade", "Node.js / TypeScript, gRPC", "Component managing patient appointment rescheduling and real-time slot validation.")
    Component(RecordRetrievalComponent, "Record Retrieval Component", "Node.js / TypeScript, REST/JSON", "Component fetching EMR subsets with server-side tenant isolation and IDOR checks.")
    Component(NotificationDispatcher, "Notification Dispatcher", "Node.js / TypeScript, Socket.io, WebSockets", "Component pushing real-time appointment reminders and alerts.")
}

Rel(Patients, PatientFacingUI, "Interacts via TLS 1.3")
Rel(PatientAuthDelegator, ExternalIdentityIdP, "Communicates using OpenID Connect (OIDC) / OAuth 2.1")
Rel(AppointmentSchedulingFacade, ClinicalCoreServices, "Connects via gRPC over mTLS")
Rel(RecordRetrievalComponent, ClinicalCoreServices, "Queries EMR data via REST/JSON")
Rel(NotificationDispatcher, PatientFacingUI, "Pushes alerts via WebSockets (TLS 1.3)")

@enduml