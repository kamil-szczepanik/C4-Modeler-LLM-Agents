@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Clinical Core Services container

Container_Boundary(clinical_core_services, "Clinical Core Services") {
    Component(EMR_Engine, "EMR Engine", "Spring Boot / Java", "Manages electronic medical records, patient data storage, and sub-second clinical data access.")
    Component(Scheduling_Engine, "Scheduling Engine", "Spring Boot / Java", "Handles patient appointments, calendars, and resource scheduling for healthcare facilities.")
    Component(Authorization_Interceptor, "Authorization Interceptor", "Spring Boot / Java", "Enforces role-based and attribute-based access control (RBAC/ABAC) and security policies.")
    Component(Audit_Logger, "Audit Logger", "Spring Boot / Java", "Provides WORM (Write Once, Read Many) audit logging for regulatory compliance like HIPAA and GDPR.")
    Component(Event_Dispatcher, "Event Dispatcher", "Spring Boot / Java", "Dispatches domain events across services and integrates with external communication layers.")
}

Rel(Authorization_Interceptor, EMR_Engine, "Validates access before processing EMR read/write requests")
Rel(Authorization_Interceptor, Scheduling_Engine, "Validates access before scheduling operations")
Rel(EMR_Engine, Audit_Logger, "Logs access and modifications to medical records")
Rel(Scheduling_Engine, Audit_Logger, "Logs scheduling transactions and access events")
Rel(EMR_Engine, Event_Dispatcher, "Publishes EMR-related domain events")

@enduml