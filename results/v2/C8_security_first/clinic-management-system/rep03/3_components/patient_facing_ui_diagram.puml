@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient-Facing UI container

Container_Boundary(patient_facing_ui, "Patient-Facing UI") {
    Component(patient_facing_ui_container, "Patient-Facing UI Container", "React / Next.js", "Mobile-first responsive UI container providing WCAG 2.1 AA accessibility.")
    Component(next_js_bff_server, "Next.js BFF Server", "Node.js API Routes", "Backend-for-Frontend server handling API proxies, token abstraction, and encrypted HTTP-only cookies.")
    Component(client_side_spa_shell, "Client-Side SPA Shell", "React", "Client-side Single Page Application shell for patient interactions.")
    Component(appointment_emr_billing_viewer_and_self_service_onboarding_modules, "Appointment, EMR & Billing Viewer, and Self-Service Onboarding Modules", "React / Next.js", "Functional modules for viewing appointments, EMR, billing, and self-service onboarding.")
    Component(state_management_session_guard_utility, "State Management & Session Guard Utility", "JavaScript / TypeScript", "Manages application state and guards user sessions securely.")
}

Component(api_gateway, "API Gateway", "Kong / Nginx", "Proxies API requests and manages ingress traffic.")
Component(identity_provider, "Identity Provider", "OpenID Connect", "Handles user authentication and redirects for identity verification.")

Rel(client_side_spa_shell, next_js_bff_server, "Internal AJAX/Fetch", "HTTPS, REST/JSON")
Rel(next_js_bff_server, api_gateway, "Proxies API requests", "HTTPS, REST/JSON")
Rel(client_side_spa_shell, identity_provider, "Redirects for authentication", "OpenID Connect")

@enduml