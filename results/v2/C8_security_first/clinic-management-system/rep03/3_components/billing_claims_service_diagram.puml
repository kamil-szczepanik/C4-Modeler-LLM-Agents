@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Billing & Claims Service", "Billing & Claims Service") {
    Component("Claim Management Component", "Claim Management Component", "Spring Boot", "Manages claim creation, processing, and status tracking.")
    Component("Clearinghouse Adapter Component", "Clearinghouse Adapter Component", "Spring Boot", "Interfaces with third-party payment gateways and insurance clearinghouses.")
    Component("Inbound Notification Listener", "Inbound Notification Listener", "Spring Boot", "Listens for and processes inbound notifications and messages.")
    Component("Financial Ledger & Audit Component", "Financial Ledger & Audit Component", "Spring Boot", "Maintains financial ledgers and records audit trails for compliance.")
    Component("Billing Exception & DLQ Handler Component", "Billing Exception & DLQ Handler Component", "Spring Boot", "Handles billing exceptions and routes failed messages to a dead-letter queue.")
}

Rel("Claim Management Component", "Clearinghouse Adapter Component", "Sends processed claims for external submission", "")
Rel("Clearinghouse Adapter Component", "Billing Exception & DLQ Handler Component", "Routes failed submissions to exception handling", "")
Rel("Inbound Notification Listener", "Financial Ledger & Audit Component", "Updates ledger based on incoming notifications", "")

@enduml