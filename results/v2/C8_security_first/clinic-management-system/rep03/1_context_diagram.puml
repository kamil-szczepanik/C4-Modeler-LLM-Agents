@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Receptionists, "Receptionists", "Manages patient admissions and front-desk scheduling.")
Person(Clinicians, "Clinicians", "Doctors and nurses who access and update electronic medical records (EMR) and clinical workflows.")
Person(Billing Officers, "Billing Officers", "Manages patient billing, claims, and financial transactions.")
Person(Patients, "Patients", "End users who interact with the system for scheduling and personal health records.")

System(Clinic Management System, "Clinic Management System", "A hybrid cloud platform designed for medium-sized hospitals and clinics to securely manage patient admissions, electronic medical records (EMR), scheduling, and billing while ensuring high availability, strict compliance, and uninterrupted clinical workflows.")

System_Ext(External Lab & Imaging Systems, "External Lab & Imaging Systems", "External systems providing laboratory results and medical imaging data.")
System_Ext(Third-Party Payment Gateway & Insurance Clearinghouses, "Third-Party Payment Gateway & Insurance Clearinghouses", "External financial and insurance systems for processing payments and claims.")
System_Ext(Identity Provider (IdP), "Identity Provider (IdP)", "Handles identity federation, authentication, and OAuth 2.0 / OIDC services.")

Rel(Receptionists, Clinic Management System, "Interacts with the system via adaptive Multi-Factor Authentication", "HTTPS, OAuth 2.0, OpenID Connect")
Rel(Clinicians, Clinic Management System, "Accesses EMR and clinical workflows securely", "HTTPS, OAuth 2.0, OpenID Connect")
Rel(Billing Officers, Clinic Management System, "Manages billing and claims operations", "HTTPS, OAuth 2.0, OpenID Connect")
Rel(Patients, Clinic Management System, "Interacts for scheduling and personal records", "HTTPS, OAuth 2.0, OpenID Connect")
Rel(Clinic Management System, External Lab & Imaging Systems, "Integrates for lab and imaging data exchange", "HL7 FHIR REST APIs over HTTPS with mTLS")
Rel(Clinic Management System, Third-Party Payment Gateway & Insurance Clearinghouses, "Integrates for payment and insurance claims processing", "REST/SOAP APIs over TLS 1.3")
@enduml