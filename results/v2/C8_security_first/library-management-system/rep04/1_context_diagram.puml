@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Library_Patron, "Library Patron", "Library patron using the self-service portals and system features.")
Person(Library_Staff_Librarian, "Library Staff / Librarian", "Library staff managing item cataloging and circulation.")

System(Library_Management_System, "Library Management System", "Provides public and academic libraries with item cataloging, circulation management, and self-service portals, ensuring EU-only data residency while maintaining high performance and reliability.")

System_Ext(Payment_Gateway, "Payment Gateway", "External payment processing service.")
System_Ext(Notification_Provider, "Notification Provider", "External service for sending notifications.")
System_Ext(EU_Cloud_Infrastructure_Provider, "EU Cloud Infrastructure Provider", "Cloud infrastructure provider enforcing EU data residency.")
System_Ext(Audit_Log_Stream, "Audit Log Stream", "Centralized stream for audit logs.")

Rel(Library_Patron, Library_Management_System, "Accesses self-service portals", "HTTPS (TLS 1.3)")
Rel(Library_Staff_Librarian, Library_Management_System, "Manages cataloging and circulation", "HTTPS (TLS 1.3) with MFA")
Rel(Library_Management_System, Payment_Gateway, "Processes payments", "REST/TLS 1.3 with circuit breakers")
Rel(Library_Management_System, Notification_Provider, "Sends notifications", "SMTP/API with HMAC-verified webhooks")
Rel(Library_Management_System, Audit_Log_Stream, "Streams audit logs", "TLS 1.3")

@enduml