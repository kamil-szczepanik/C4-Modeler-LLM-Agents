@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification Worker container

Container_Boundary(notification_worker, "Notification Worker") {
    Component(Kafka_Consumer_Component, "Kafka Consumer Component", "Go, segmentio/kafka-go", "Uses segmentio/kafka-go for safe JSON event consumption from Apache Kafka.")
    Component(Preference_Template_Engine_Component, "Preference & Template Engine Component", "Go, text/template", "Uses Go text/template for channel opt-ins and PII sanitization.")
    Component(Dispatcher_Rate_Limiter_Component, "Dispatcher & Rate-Limiter Component", "Go, net/http, golang.org/x/time/rate", "Uses net/http and golang.org/x/time/rate for outbound API calls to notification providers.")
    Component(DLQ_Audit_Forwarder_Component, "DLQ & Audit Forwarder Component", "Go", "Routes failed messages to Dead-Letter Queue and emits delivery events.")
}

Rel(Kafka_Consumer_Component, Preference_Template_Engine_Component, "Passes consumed JSON events for sanitization and template processing.")
Rel(Preference_Template_Engine_Component, Dispatcher_Rate_Limiter_Component, "Forwards processed messages for outbound delivery.")
Rel(Dispatcher_Rate_Limiter_Component, DLQ_Audit_Forwarder_Component, "Reports delivery outcomes and failures.")
@enduml