@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Message Broker container

Container_Boundary(message_broker, "Message Broker") {
    Component(kafka_broker_nodes, "Kafka Broker Nodes", "Apache Kafka", "Handles distributed commit log architecture, at-least-once delivery, and configurable retention for asynchronous event-driven communication.")
    Component(kraft_controller_quorum, "KRaft Controller Quorum", "Apache Kafka KRaft", "Replaces ZooKeeper for cluster metadata coordination and streamlined Kubernetes deployment.")
    Component(schema_registry, "Schema Registry", "Confluent Schema Registry / Avro", "Enforces payload contracts and backward compatibility for event messages.")
}

Rel(kafka_broker_nodes, kraft_controller_quorum, "Coordinates cluster metadata", "KRaft Protocol")
Rel(kafka_broker_nodes, schema_registry, "Fetches and validates Avro schemas", "HTTPS")

@enduml