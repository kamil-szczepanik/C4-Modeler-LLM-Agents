@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the EU Kubernetes Cluster and HSM container

Container_Boundary(eu_k8s_cluster_and_hsm, "EU Kubernetes Cluster and EU Cloud Provider's HSM") {
    Component(Kubernetes_Control_Plane_and_Worker_Nodes, "Kubernetes Control Plane and Worker Nodes", "Kubernetes, Containerd, Bare-metal", "Orchestrates resilient microservices hosted in EU region for strict data residency compliance.")
    Component(Istio_Service_Mesh, "Istio Service Mesh", "Istio, Cilium, Sidecars", "Provides zero-trust mTLS and network policy enforcement for internal microservices communication.")
    Component(HSM_Crypto_Plugin_and_PKCS_11_Daemon, "HSM Crypto-Plugin and PKCS#11 Daemon", "PKCS#11, KMIP", "Cryptographic interface for secure envelope encryption and key wrapping.")
    Component(External_Secrets_Operator, "External Secrets Operator", "External Secrets Operator", "Manages secrets injection by connecting to the Cloud HSM using KMIP/PKCS#11 over TLS 1.3.")
    Component(SPIRE_Agent_and_Server_DaemonSet, "SPIRE Agent and Server DaemonSet", "SPIFFE/SPIRE", "Provisions workload identities to pods securely.")
    Component(OpenTelemetry_Collector, "OpenTelemetry Collector", "OpenTelemetry", "Gathers telemetry metrics and traces to monitor cryptographic latency and protect the search SLA.")
    Component(KEDA, "KEDA", "KEDA", "Handles event-driven autoscaling to maintain the < 800 ms search SLA under peak loads.")
    Component(EU_Cloud_Provider_s_Hardware_Security_Module_HSM_, "EU Cloud Provider's Hardware Security Module (HSM)", "Hardware Security Module (HSM)", "Secures cryptographic keys exclusively within EU data centers.")
}

Rel(Kubernetes_Control_Plane_and_Worker_Nodes, Istio_Service_Mesh, "Routes and secures microservices traffic using mTLS via gRPC", "gRPC / mTLS")
Rel(External_Secrets_Operator, EU_Cloud_Provider_s_Hardware_Security_Module_HSM_, "Connects to the Cloud HSM using KMIP/PKCS#11 over TLS 1.3", "TLS 1.3 / KMIP / PKCS#11")
Rel(SPIRE_Agent_and_Server_DaemonSet, Kubernetes_Control_Plane_and_Worker_Nodes, "Provisions workload identities to pods using SPIFFE/SPIRE protocols", "SPIFFE/SPIRE")
Rel(OpenTelemetry_Collector, KEDA, "Feeds telemetry metrics and traces to drive autoscaling", "Metrics / Traces")
Rel(OpenTelemetry_Collector, HSM_Crypto_Plugin_and_PKCS_11_Daemon, "Monitors cryptographic latency to protect the search SLA", "Telemetry")

@enduml