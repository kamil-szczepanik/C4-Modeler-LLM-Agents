@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(analytics_service, "Analytics Service") {
    Component(Ingestion_Worker, "Ingestion Worker", "Python / Faust or Celery", "Consumes event messages via Kafka Consumer API and bulk inserts events into ClickHouse storage.")
    Component(Query_API, "Query API", "Python / FastAPI", "Routes analytics queries, executes read queries against ClickHouse, and delegates export tasks.")
    Component(Aggregation_Engine, "Aggregation Engine", "ClickHouse Materialized Views", "Provides high-performance aggregations and transparent data encryption (TDE).")
    Component(Report_Generation_Worker, "Report Generation Worker", "Python / Celery", "Queries historical aggregates and handles background report generation tasks.")
}

Rel(Ingestion_Worker, Aggregation_Engine, "Bulk inserts events", "ClickHouse Native Protocol")
Rel(Query_API, Aggregation_Engine, "Executes read queries", "ClickHouse SQL over HTTP/Native")
Rel(Query_API, Report_Generation_Worker, "Delegates export tasks", "Redis / Message Broker queue")
Rel(Report_Generation_Worker, Aggregation_Engine, "Queries historical aggregates", "ClickHouse SQL over HTTP")

@enduml