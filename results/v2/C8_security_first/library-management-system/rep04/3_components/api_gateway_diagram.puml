@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(Edge_Router, "Edge Router", "Kong / NGINX", "Handles edge routing, WAF, and geo-blocking to enforce EU data residency.")
    Component(Auth_Filter, "Auth Filter", "OAuth 2.0 / OIDC", "Provides secure authentication and SSO for patrons and staff.")
    Component(Rate_Limiter, "Rate Limiter", "Kong / NGINX Plugin with Redis", "Manages rate-limiting counters for API requests.")
    Component(Telemetry_Exporter, "Telemetry Exporter", "Kong / NGINX Plugin", "Publishes telemetry metrics to the analytics service.")
    Component(Schema_Validator, "Schema Validator", "Kong / NGINX Plugin", "Validates incoming request schemas.")
}

Rel(Edge_Router, Auth_Filter, "Authenticates requests using OAuth 2.0 / OIDC")
Rel(Auth_Filter, Rate_Limiter, "Checks request rate limits")
Rel(Rate_Limiter, Schema_Validator, "Validates request payload schema")

@enduml