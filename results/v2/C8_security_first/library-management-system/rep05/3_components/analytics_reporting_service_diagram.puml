@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Analytics & Reporting Service container

Component(StaffManagementConsole, "Staff Management Console", "External System / Client", "Queries dashboards and requests reports.")

Container_Boundary(AnalyticsAndReportingService, "Analytics & Reporting Service") {
    Component(APIRouter, "API Router", "Python / FastAPI", "Handles operational reporting, dashboards, and GDPR-compliant data export requests.")
    Component(AggregationAndProcessingEngine, "Aggregation & Processing Engine", "Pandas", "In-memory data processing and aggregation for complex analytics.")
    Component(ExportGenerator, "Export Generator", "Python / Celery", "Generates encrypted PDF/CSV reports.")
    Component(SchedulerAndTaskDispatcher, "Scheduler & Task Dispatcher", "Celery / Redis", "Manages scheduled tasks and worker queues with distributed locking.")
    Component(NotificationAndDeliveryDispatcher, "Notification & Delivery Dispatcher", "Python", "Dispatches scheduled report alerts.")
    Component(DataAccessRepository, "Data Access Repository", "Python / SQL", "Executes queries against the PostgreSQL read-replica with read-only roles.")
}

Component(PostgreSQLReadReplica, "PostgreSQL (Read-Replica)", "PostgreSQL", "Relational database utilizing read-replicas to isolate analytics from transactions.")
Component(Redis, "Redis", "Redis", "Backing store for Celery worker queues and distributed locking (Redlock).")
Component(ObjectStorage, "Object Storage", "Cloud Object Storage", "Stores encrypted PDF/CSV reports with EU region-locked residency mandates.")
Component(NotificationEngine, "Notification Engine", "External System", "Receives dispatched scheduled report alerts.")

Rel(StaffManagementConsole, APIRouter, "Queries dashboards and requests reports", "HTTPS / REST over TLS 1.3")
Rel(APIRouter, DataAccessRepository, "Executes queries with read-only roles", "SQL over mTLS / TLS 1.3")
Rel(ExportGenerator, ObjectStorage, "Uploads encrypted PDF/CSV reports", "HTTPS / TLS 1.3")
Rel(NotificationAndDeliveryDispatcher, NotificationEngine, "Dispatches scheduled report alerts", "AMQP over TLS")

@enduml