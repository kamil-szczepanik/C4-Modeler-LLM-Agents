@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Staff Management Console container

Container_Boundary(staff_management_console, "Staff Management Console") {
    Component(console_router, "Console Router / UI Shell", "TypeScript / React, TanStack Query", "Single Page Application providing rapid dashboard rendering, role-based adaptability, and 15-minute inactivity timeout.")
    Component(auth_rbac_client, "Auth & RBAC Client", "TypeScript / React", "Manages OIDC/OAuth2 authentication, MFA, and role-based access control for Librarians and Administrators.")
    Component(catalogue_inventory_controller, "Catalogue & Inventory Controller", "Node.js / TypeScript BFF", "BFF microservice handling item management and schema validation via Zod.")
    Component(circulation_desk_interface, "Circulation Desk Interface", "Node.js / TypeScript BFF", "BFF microservice optimized for low-latency check-outs and graceful degradation.")
}

Component(eu_bound_api_gateway, "EU-bound API Gateway", "Kubernetes, Istio", "Routes traffic and validates short-lived JWTs, ensuring strict EU-only data residency.")
Component(search_catalogue_service, "Search & Catalogue Service", "Backend core service, gRPC", "Backend core service for searching and cataloging items.")
Component(circulation_loan_engine, "Circulation & Loan Engine", "Backend core service, gRPC", "Backend core engine optimized for low-latency check-outs and loans.")

Rel(eu_bound_api_gateway, console_router, "Routes traffic", "REST/HTTPS")
Rel(console_router, auth_rbac_client, "Verifies permissions", "In-memory")
Rel(console_router, catalogue_inventory_controller, "Communicates", "HTTP/JSON over HTTPS")
Rel(console_router, circulation_desk_interface, "Communicates", "HTTP/JSON over HTTPS")
Rel(catalogue_inventory_controller, search_catalogue_service, "Communicates internally", "gRPC, mTLS (TLS 1.3)")
Rel(circulation_desk_interface, circulation_loan_engine, "Communicates internally", "gRPC, mTLS (TLS 1.3)")

@enduml