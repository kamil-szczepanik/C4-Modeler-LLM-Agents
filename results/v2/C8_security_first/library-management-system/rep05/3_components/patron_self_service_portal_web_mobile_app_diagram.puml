@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patron Self-Service Portal (Web/Mobile App) container

Container_Boundary(patron_portal, "Patron Self-Service Portal (Web/Mobile App)") {
    Component(spa_mobile_client, "SPA/Mobile Client Router & UI Layer", "React / React Native", "Powers cross-platform web and mobile interfaces supporting WCAG 2.1 AA accessibility.")
    Component(auth_client, "Authentication Client", "OAuth 2.0/OIDC SDK with PKCE, biometric bridge", "Secures authentication and token handling in volatile memory.")
    Component(api_client_gateway, "API Client Gateway", "TypeScript/Axios with gRPC-web mapping", "Manages type-safe communication and low-latency API transit.")
    Component(local_secure_storage, "Local Secure Storage & Sync Manager", "Encrypted SQLite / IndexedDB", "Provides secure local caching for offline cryptographic library cards.")
}

Component_Ext(eu_bound_api_gateway, "EU-bound API Gateway", "Global CDN (EU-restricted)", "Enforces data residency and rapid static asset delivery.")
Component_Ext(cdn_edge_nodes, "CDN Edge Nodes", "CDN", "Delivers rapid static assets.")
Component_Ext(notification_engine, "Notification Engine", "Notification Engine Service", "Handles notifications for patrons.")

Rel(spa_mobile_client, auth_client, "Uses for OIDC flows", "HTTPS")
Rel(spa_mobile_client, api_client_gateway, "Uses for data retrieval", "gRPC, mTLS")
Rel(spa_mobile_client, local_secure_storage, "Uses for offline digital card rendering", "Local Encryption")
Rel(api_client_gateway, eu_bound_api_gateway, "Communicates with", "gRPC-Web/HTTPS, mTLS (TLS 1.3)")

@enduml