@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Circulation & Loan Engine container

Container_Boundary(circulation_loan_engine, "Circulation & Loan Engine") {
    Component(PatronSelfServicePortal, "Patron Self-Service Portal", "Web/Mobile App", "Allows patrons to manage their loans and self-service workflows.")
    Component(StaffManagementConsole, "Staff Management Console", "Web Application", "Allows staff to manage circulation workflows and overrides.")
    Component(LoanWorkflowController, "Loan Workflow Controller", "Python / FastAPI", "Controls the main loan workflows and routing.")
    Component(LoanPolicyEvaluator, "Loan Policy Evaluator", "Python", "Evaluates dynamic circulation and loan policies.")
    Component(FinePaymentProcessor, "Fine & Payment Processor", "Python", "Processes financial fines and communicates with payment gateways.")
    Component(ILLCoordinator, "ILL Coordinator", "Python", "Coordinates inter-library loan networks.")
    Component(NotificationTriggerComponent, "Notification Trigger Component", "Python", "Triggers notifications via the message broker.")
    Component(DataAccessRepository, "Data Access Repository", "SQLAlchemy ORM", "Handles data access and encrypted queries.")
    Component(PrimaryPostgreSQLDatabaseReadReplica, "Primary PostgreSQL Database & Read-Replica", "PostgreSQL with AES-256", "Provides relational persistence with encryption at rest.")
    Component(MessageBroker, "Message Broker", "RabbitMQ/Kafka", "Handles asynchronous messaging and audit event streaming.")
}

Component_Ext(PaymentGateway, "Payment Gateway", "External REST Service", "Processes secure payment transactions.")
Component_Ext(InterLibraryLoanNetworks, "Inter-Library Loan Networks", "External REST Service", "External networks for inter-library loans.")

Rel(PatronSelfServicePortal, LoanWorkflowController, "gRPC over mTLS (TLS 1.3)", "gRPC")
Rel(StaffManagementConsole, LoanWorkflowController, "gRPC over mTLS (TLS 1.3)", "gRPC")
Rel(FinePaymentProcessor, PaymentGateway, "REST/JSON over TLS 1.3", "HTTPS")
Rel(ILLCoordinator, InterLibraryLoanNetworks, "REST/JSON over TLS 1.3", "HTTPS")
Rel(NotificationTriggerComponent, MessageBroker, "Async event publishing", "Messaging")
Rel(DataAccessRepository, PrimaryPostgreSQLDatabaseReadReplica, "SQLAlchemy ORM with encrypted queries", "SQL")

@enduml