@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(search_catalogue_service, "Search & Catalogue Service") {
    Component(Search_Controller, "Search Controller", "Spring Boot Controller", "Handles incoming search requests from client interfaces.")
    Component(Search_Query_Engine, "Search Query Engine", "Java / Spring Boot", "Processes search queries and interacts with Elasticsearch using a circuit breaker.")
    Component(Catalogue_Synchronization_Worker, "Catalogue Synchronization Worker", "Java / Spring Boot Worker", "Consumes asynchronous events from the message broker to synchronize the catalogue.")
    Component(Catalogue_Repository, "Catalogue Repository", "Spring Data JDBC", "Manages data access and persistence operations against PostgreSQL.")
}

Rel(Search_Controller, Search_Query_Engine, "Delegates search requests", "")
Rel(Search_Query_Engine, Catalogue_Repository, "Fetches catalogue data", "")
Rel(Catalogue_Synchronization_Worker, Catalogue_Repository, "Updates catalogue records", "")

@enduml