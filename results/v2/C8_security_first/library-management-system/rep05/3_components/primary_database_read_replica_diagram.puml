@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Primary Database & Read-Replica", "Primary Database & Read-Replica") {
    Component(PgBouncer, "PgBouncer", "PgBouncer connection pooling sidecar (Ports 6432/6433)", "Routes write traffic to the primary and read traffic to the read-replica with connection pooling.")
    Component(PostgreSQLPrimary, "PostgreSQL Primary", "PostgreSQL, AES-256 encryption, Patroni, pgaudit", "Core transactional storage handling writes, executing loans, and maintaining GDPR-compliant audit logs.")
    Component(PostgreSQLReadReplica, "PostgreSQL Read-Replica", "PostgreSQL, Streaming Replication", "Read-only replica serving search, catalogue, and analytics queries to guarantee sub-800ms performance.")
}

Rel(PgBouncer, PostgreSQLPrimary, "Routes write traffic", "SQL over TLS 1.3 [Port 6432]")
Rel(PgBouncer, PostgreSQLReadReplica, "Routes read traffic", "SQL over TLS 1.3 [Port 6433]")
Rel(PostgreSQLPrimary, PostgreSQLReadReplica, "Streams replication", "Streaming Replication in asynchronous mode")

@startuml