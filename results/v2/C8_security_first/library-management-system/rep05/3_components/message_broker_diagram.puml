@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Message Broker container

Person(Circulation_Loan_Engine, "Circulation & Loan Engine", "External system container")
Person(Notification_Engine, "Notification Engine", "External system container")
Person(Analytics_Event_Router, "Analytics Event Router", "External system container")

Container_Boundary(message_broker, "Message Broker") {
    Component(Exchange_Routing_Engine, "Exchange & Routing Engine", "RabbitMQ / Kafka Broker", "Routes incoming domain events to appropriate consumers and manages message distribution.")
    Component(Persistent_Storage_Log_Manager, "Persistent Storage & Log Manager", "Cluster Disk Storage / Quorum Queues", "Ensures reliable, durable storage and logging for messages to guarantee at-least-once delivery.")
    Component(Connection_ACL_Manager, "Connection & ACL Manager", "SASL/SCRAM-SHA-512 / mTLS", "Handles secure client connections, authentication, and access control lists.")
    Component(DLQ_Retry_Manager, "DLQ & Retry Manager", "Dead Letter Queue & Retry Logic", "Routes unacknowledged or poisoned messages for later inspection and retry handling.")
    Component(Analytics_Event_Router_comp, "Analytics Event Router", "Event Streaming", "Streams anonymized domain events to the analytics and reporting service.")
}

Rel(Circulation_Loan_Engine, Exchange_Routing_Engine, "Publishes domain events", "AMQP/Kafka over TLS 1.3")
Rel(Exchange_Routing_Engine, Notification_Engine, "Consumes events asynchronously", "AMQP/Kafka")
Rel(Exchange_Routing_Engine, Analytics_Event_Router_comp, "Streams anonymized domain events", "AMQP/Kafka over TLS 1.3")
Rel(Notification_Engine, DLQ_Retry_Manager, "Routes unacknowledged or poisoned messages", "AMQP/Kafka")

@enduml