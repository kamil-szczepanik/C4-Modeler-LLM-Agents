@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(Patrons_Library_Staff, "Patrons & Library Staff", "End-users accessing self-service portals, circulation, and cataloguing tools.")

System_Ext(EU_bound_API_Gateway, "EU-bound API Gateway", "Perimeter element enforcing rate-limiting, TLS termination, and payload sanitization.")
System_Ext(Payment_Gateway, "Payment Gateway", "External system processing fines and fees.")
System_Ext(Digital_Content_Providers, "Digital Content Providers", "External system supplying e-books and digital media licenses.")
System_Ext(Inter_Library_Loan_Networks, "Inter-Library Loan Networks", "External system enabling resource sharing and partner catalogue exchange.")

System_Boundary(Library_Management_System, "Library Management System") {
    Container(Patron_Self_Service_Portal_Web_Mobile_App, "Patron Self-Service Portal (Web/Mobile App)", "Web/Mobile", "Enables 24/7 self-service access for patrons.")
    Container(Staff_Management_Console, "Staff Management Console", "Web", "Provides management and cataloguing tools for library staff.")
    Container(Search_Catalogue_Service, "Search & Catalogue Service", "Java / Spring Boot, Elasticsearch", "Powers sub-800ms item search and catalogue management.")
    Container(Circulation_Loan_Engine, "Circulation & Loan Engine", "Python (FastAPI / Pandas)", "Manages circulation workflows and connects to external payment and loan systems.")
    Container(Analytics_Reporting_Service, "Analytics & Reporting Service", "Python (FastAPI / Pandas)", "Handles reporting and queries PostgreSQL read-replicas.")
    Container(Notification_Engine, "Notification Engine", "Go", "Lightweight engine that consumes events asynchronously to send notifications.")
    ContainerDb(Primary_Database_Read_Replica, "Primary Database & Read-Replica", "PostgreSQL", "Stores core transactional data with AES-256 encryption at rest.")
    Container(Message_Broker, "Message Broker", "RabbitMQ/Kafka", "Facilitates asynchronous event-driven communication across services.")
}

Rel(Patrons_Library_Staff, EU_bound_API_Gateway, "Interacts via portals routed through the EU-bound API Gateway", "HTTPS/REST, OAuth2/OIDC with JWTs")
Rel(EU_bound_API_Gateway, Patron_Self_Service_Portal_Web_Mobile_App, "Routes traffic to portals", "REST/HTTPS")
Rel(EU_bound_API_Gateway, Staff_Management_Console, "Routes traffic to consoles", "REST/HTTPS")
Rel(Patron_Self_Service_Portal_Web_Mobile_App, Search_Catalogue_Service, "Communicates internally", "gRPC, mTLS (TLS 1.3)")
Rel(Staff_Management_Console, Search_Catalogue_Service, "Communicates internally", "gRPC, mTLS (TLS 1.3)")
Rel(Patron_Self_Service_Portal_Web_Mobile_App, Circulation_Loan_Engine, "Communicates internally", "gRPC, mTLS (TLS 1.3)")
Rel(Staff_Management_Console, Circulation_Loan_Engine, "Communicates internally", "gRPC, mTLS (TLS 1.3)")
Rel(Circulation_Loan_Engine, Payment_Gateway, "Processes transactions for fines and fees", "REST/JSON over TLS 1.3")
Rel(Circulation_Loan_Engine, Inter_Library_Loan_Networks, "Exchanges resource sharing requests", "REST/JSON over TLS 1.3")
Rel(Notification_Engine, Message_Broker, "Consumes events asynchronously", "AMQP/Kafka")
Rel(Analytics_Reporting_Service, Primary_Database_Read_Replica, "Queries read-replicas for reporting", "SQL over TLS 1.3")

@enduml