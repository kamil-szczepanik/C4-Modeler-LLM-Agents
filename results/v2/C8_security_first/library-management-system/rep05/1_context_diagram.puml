@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Library Management System

Person(Patrons_Library_Staff, "Patrons & Library Staff", "End-users accessing self-service portals, circulation, and cataloguing tools.")

System(Library_Management_System, "Library Management System", "Cloud-native platform providing self-service portals, circulation management, and cataloguing for public and academic libraries while ensuring strict EU data residency.")

System_Ext(EU_bound_API_Gateway, "EU-bound API Gateway", "Perimeter element enforcing rate-limiting, TLS termination, and payload sanitization.")
System_Ext(Payment_Gateway, "Payment Gateway", "External system processing fines and fees.")
System_Ext(Digital_Content_Providers, "Digital Content Providers", "External system supplying e-books and digital media licenses.")
System_Ext(Inter_Library_Loan_Networks, "Inter-Library Loan Networks", "External system enabling resource sharing and partner catalogue exchange.")

Rel(Patrons_Library_Staff, Library_Management_System, "Interacts via self-service portals, circulation, and cataloguing tools.", "HTTPS, TLS 1.3, OIDC/MFA")
Rel(Library_Management_System, Payment_Gateway, "Processes transactions for fines and fees.", "REST/JSON over TLS 1.3, mTLS, circuit breakers")
Rel(Library_Management_System, Digital_Content_Providers, "Syncs inventory and digital media licenses.", "REST/JSON over TLS 1.3, async caching")
Rel(Library_Management_System, Inter_Library_Loan_Networks, "Exchanges metadata and resource sharing requests.", "REST/JSON over TLS 1.3, mTLS, asynchronous webhooks")

@enduml