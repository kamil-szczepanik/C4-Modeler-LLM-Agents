@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(Elasticsearch, "Elasticsearch") {
    Component(Routing and Coordination Node, "Routing and Coordination Node", "Java / Netty", "Handles client requests, query distribution, security filtering, and cluster-state management.")
    Component(Data Nodes, "Data Nodes", "Lucene Engine", "Store index shards, doc-values, and execute distributed matching across EU availability zones.")
    Component(Inverted Index & Analyzer Pipeline, "Inverted Index & Analyzer Pipeline", "Elasticsearch Analyzer", "Implements custom tokenizers, stemmers, fuzzy matching, and domain-specific synonyms.")
    Component(Search Microservice, "Search Microservice", "Java / Spring Boot", "Acts as the sole intermediary between API gateways and Elasticsearch, issuing search/indexing queries over REST / JSON over TLS 1.3.")
}

Rel(Search Microservice, Routing and Coordination Node, "Issues search/indexing queries", "REST / JSON over TLS 1.3")
Rel(Routing and Coordination Node, Data Nodes, "Distributes search/index operations", "Transport Protocol over TLS 1.3 (mTLS)")

@enduml