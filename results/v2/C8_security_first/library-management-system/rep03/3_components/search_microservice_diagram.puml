@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Search Microservice container

Container_Boundary(search_microservice, "Search Microservice") {
    Component(SearchController, "Search Controller", "Spring MVC", "Handles incoming search requests from patrons and librarians.")
    Component(SearchQueryBuilderSanitizer, "Search Query Builder & Sanitizer", "Java / Spring", "Builds and sanitizes search queries to protect against injection and ensure safety.")
    Component(CatalogueSyncConsumer, "Catalogue Sync Consumer", "Spring AMQP", "Consumes messages for real-time catalogue synchronization.")
    Component(ElasticsearchClientAdapter, "Elasticsearch Client Adapter", "Java / Spring", "Adapts calls to the Elasticsearch backend for search and indexing.")
}

Component(ElasticsearchEUhosted, "Elasticsearch (EU-hosted)", "Elasticsearch", "Search engine backend ensuring fast full-text search capabilities under 800ms.")
Component(MessageBroker, "Message Broker", "RabbitMQ / Kafka", "Message broker for event-driven catalogue synchronization.")

Rel(SearchController, SearchQueryBuilderSanitizer, "In-memory Java Method Call")
Rel(SearchQueryBuilderSanitizer, ElasticsearchClientAdapter, "In-memory Java Method Call")
Rel(ElasticsearchClientAdapter, ElasticsearchEUhosted, "REST over TLS 1.3")
Rel(CatalogueSyncConsumer, MessageBroker, "AMQP over TLS 1.3")
Rel(CatalogueSyncConsumer, ElasticsearchClientAdapter, "In-memory Java Method Call")

@enduml