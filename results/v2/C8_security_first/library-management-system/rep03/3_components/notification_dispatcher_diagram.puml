@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Message_Broker, "Message Broker", "RabbitMQ / Kafka", "Message broker for asynchronous event consumption and status publishing.")
System_Ext(Database_Layer, "Database Layer", "PostgreSQL with EU-pinned JDBC", "Relational database with EU-pinned storage for patron preferences and masked PII logs.")
System_Ext(EU_Notification_Gateway, "EU Notification Gateway", "External System", "External system responsible for final delivery of outbound alerts.")
System_Ext(Patron_Self_Service_Portal, "Patron Self-Service Portal", "React / TypeScript SPA", "Portal for patrons to access notification history logs via downstream microservices.")

Container_Boundary(Notification_Dispatcher, "Notification Dispatcher") {
    Component(Message_Consumer_Component, "Message Consumer Component", "Node.js / TypeScript", "Consumes system events from the message broker for asynchronous processing.")
    Component(Preference_Router_Component, "Preference Router Component", "Node.js / TypeScript", "Retrieves patron preferences and PII from the database layer.")
    Component(Gateway_Adapter_Component, "Gateway Adapter Component", "Node.js / TypeScript", "Dispatches outbound alerts to the EU Notification Gateway.")
    Component(Retry___Fallback_Manager, "Retry & Fallback Manager", "Node.js / TypeScript", "Manages retries, circuit breakers, and dead-letter queues to ensure reliability.")
    Component(Event_Publisher_Component, "Event Publisher Component", "Node.js / TypeScript", "Publishes delivery status and failure events back to the message broker.")
}

Rel(Message_Broker, Message_Consumer_Component, "Delivers system events", "AMQP / Kafka Protocol with mTLS / SASL")
Rel(Preference_Router_Component, Database_Layer, "Retrieves patron preferences and PII", "PostgreSQL JDBC with TLS 1.3")
Rel(Gateway_Adapter_Component, EU_Notification_Gateway, "Dispatches outbound alerts", "HTTPS / REST with TLS 1.3, Certificate Pinning, Egress Filtering")
Rel(Event_Publisher_Component, Message_Broker, "Publishes delivery status and failure events", "AMQP / Kafka Protocol")
Rel(Patron_Self_Service_Portal, Message_Broker, "Accesses notification history logs via downstream microservices")

@enduml