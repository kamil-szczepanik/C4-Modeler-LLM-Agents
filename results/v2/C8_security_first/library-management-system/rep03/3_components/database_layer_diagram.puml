@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(database_layer, "Database Layer") {
    Component(PostgreSQL_Primary_Node, "PostgreSQL Primary Node", "PostgreSQL (AWS RDS/Aurora EU-Central)", "Persists transactional writes such as checkouts and fines with ACID compliance.")
    Component(PostgreSQL_Read_Only_Replica, "PostgreSQL Read-Only Replica", "PostgreSQL (AWS RDS/Aurora EU-Central)", "Executes reads and search hydrations to protect core transactional performance.")
    Component(PgBouncer_Connection_Pooler_Sidecar, "PgBouncer Connection Pooler Sidecar", "PgBouncer", "Manages and pools database connections to prevent connection exhaustion under peak patron load.")
    Component(Partitioned_Storage_Engine, "Partitioned Storage Engine", "PostgreSQL Partitioned Storage", "Optimizes catalogue and circulation data storage.")
}

Rel(PgBouncer_Connection_Pooler_Sidecar, PostgreSQL_Primary_Node, "Forwards client identity for auditing", "TLS 1.3")
Rel(PgBouncer_Connection_Pooler_Sidecar, PostgreSQL_Read_Only_Replica, "Forwards client identity for auditing", "TLS 1.3")
@enduml