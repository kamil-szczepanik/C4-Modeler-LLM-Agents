@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "Kong / Envoy", "API Gateway handling routing and security policies.")

Container_Boundary(librarian_management_portal, "Librarian Management Portal") {
    Component(auth_session_manager, "Authentication & Session Manager", "React, TypeScript, Zustand, Axios, OIDC/MFA", "Manages user sessions, JWT injection via Axios interceptors, and OIDC/MFA federation via Academic Identity Providers.")
    Component(cataloguing_inventory_ui, "Cataloguing & Inventory UI Module", "React, TypeScript, React Router, Design System", "Provides interfaces for managing catalogue entries and inventory management.")
    Component(circulation_desk_module, "Circulation Desk Module", "React, TypeScript, REST/JSON over HTTPS", "Handles circulation workflows with offline queueing fallback capabilities.")
    Component(audit_logging_service, "Audit Logging Service", "TypeScript, HTTPS", "Captures audit logs and security telemetry for compliance.")
    Component(accessibility_wrapper, "Accessibility Wrapper & Design System", "React, TypeScript, CSS", "Ensures compliance with accessibility standards and applies the UI design system.")
    Component(batch_processing_controller, "Batch Processing State Controller", "TypeScript, Zustand, REST/JSON over HTTPS", "Controls state for chunked batch uploads to the API Gateway.")
}

Rel(auth_session_manager, api_gateway, "Sends authenticated HTTPS requests with JWT headers", "HTTPS")
Rel(cataloguing_inventory_ui, api_gateway, "Sends cataloguing and inventory queries via HTTPS", "HTTPS")
Rel(circulation_desk_module, api_gateway, "Executes circulation operations via REST/JSON over HTTPS with offline queueing fallback", "REST/JSON over HTTPS")
Rel(batch_processing_controller, api_gateway, "Performs chunked uploads via REST/JSON over HTTPS", "REST/JSON over HTTPS")

@enduml