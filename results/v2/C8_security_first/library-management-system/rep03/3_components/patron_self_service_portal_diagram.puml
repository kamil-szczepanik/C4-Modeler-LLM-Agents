@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patron Self-Service Portal container

Container_Boundary(patron_portal, "Patron Self-Service Portal") {
    Component(auth_session_manager_component, "Auth & Session Manager Component", "TypeScript / OIDC Client", "Manages authentication and user sessions using OAuth 2.0 / OIDC and secure token storage.")
    Component(dashboard_notification_ui_component, "Dashboard & Notification UI Component", "React", "Provides the user dashboard and notification interface.")
    Component(catalogue_search_client_component, "Catalogue & Search Client Component", "React / Axios with Circuit Breaker", "Enables catalogue search capabilities for patrons with robust failure handling.")
    Component(checkout_payment_ui_component, "Checkout & Payment UI Component", "React with Payment Gateway iFrame SDK", "Handles secure checkouts and payment processing isolating PCI-DSS scope.")
}

System_Ext(external_identity_payment, "External Academic Identity Providers & Payment Gateway", "External identity providers and payment processing services.")
System_Ext(api_gateway, "API Gateway", "Kong / Envoy API Gateway routing internal requests.")

Rel(auth_session_manager_component, external_identity_payment, "Authenticates users via OAuth 2.0 / OIDC", "HTTPS")
Rel(catalogue_search_client_component, api_gateway, "Sends REST / JSON requests", "HTTPS [TLS 1.3]")
Rel(dashboard_notification_ui_component, api_gateway, "Sends GraphQL / REST requests", "HTTPS [TLS 1.3]")
Rel(checkout_payment_ui_component, external_identity_payment, "Processes payments via Tokenized iFrame SDK", "HTTPS")

@enduml