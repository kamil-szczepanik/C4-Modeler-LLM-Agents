@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(circulation_catalogue_microservice, "Circulation & Catalogue Microservice") {
    Component(rest_controllers, "REST Controllers", "Spring MVC & Spring Security", "Handles REST endpoints and method-level @PreAuthorize RBAC.")
    Component(service_layer, "Service Layer", "Java / Spring Boot", "Implements business logic for inventory and checkout operations.")
    Component(persistence_layer, "Persistence Layer", "Spring Data JPA & HikariCP", "Manages database persistence, optimistic locking, and secure connection pooling.")
    Component(event_publisher, "Event Publisher", "Spring Cloud Stream & Apache Kafka", "Publishes signed asynchronous events via AMQP / Kafka Protocol with HMAC payload signing.")
    Component(resilience_handler, "Resilience Handler", "Resilience4j", "Implements circuit breakers and rate limiters for fault tolerance.")
    Component(telemetry_manager, "Telemetry Manager", "OpenTelemetry", "Provides distributed tracing with agent-level PII scrubbing.")
}

Rel(rest_controllers, service_layer, "Invokes business logic")
Rel(service_layer, persistence_layer, "Persists data via JDBC over TLS 1.3")
Rel(service_layer, event_publisher, "Publishes signed asynchronous events")
Rel(service_layer, resilience_handler, "Applies circuit breakers and rate limiters")
Rel(service_layer, telemetry_manager, "Sends telemetry with PII scrubbing")

@enduml