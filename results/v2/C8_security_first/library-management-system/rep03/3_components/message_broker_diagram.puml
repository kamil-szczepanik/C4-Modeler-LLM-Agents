@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Message Broker container

Component(CirculationCatalogueMicroservice, "Circulation & Catalogue Microservice", "SASL_SSL / Kafka Protocol", "Producer of asynchronous circulation events.")
Component(NotificationDispatcher, "Notification Dispatcher", "Kafka Protocol", "Consumer of events for alerts and notifications.")

Container_Boundary(MessageBroker, "Message Broker") {
    Component(IngestionEngine, "Ingestion Engine", "TLS, mTLS, SASL/SCRAM", "Component handling TLS termination, mTLS authentication, and SASL/SCRAM authorization.")
    Component(EventLogManager, "Event Log Manager", "Apache Kafka", "Component managing append-only commit logs, 7-day retention, and consumer offsets.")
    Component(ReplicationController, "Replication Controller", "Kafka Replication", "Component synchronizing partition replicas across EU nodes.")
}

Rel(CirculationCatalogueMicroservice, IngestionEngine, "Publishes events using SASL_SSL", "Kafka Protocol")
Rel(IngestionEngine, EventLogManager, "Appends verified payloads to topic partitions", "Internal IPC")
Rel(EventLogManager, NotificationDispatcher, "Streams unacknowledged events and routes failures to DLQ", "Kafka Protocol")

@enduml