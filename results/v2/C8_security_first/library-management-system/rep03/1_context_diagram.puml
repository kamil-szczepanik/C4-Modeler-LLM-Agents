@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Library Management System

Person(Patrons, "Patrons", "Students, Researchers, and the Public who use web and mobile clients to search and borrow physical and digital items.")
Person(Librarians, "Librarians", "Library staff who manage circulation and catalogue items via web and mobile clients.")
Person(Library_Administrators, "Library Administrators", "Administrators who configure and oversee the library management system.")

System(Library_Management_System, "Library Management System", "A cloud-hosted EU solution designed to catalogue physical and digital items, manage circulation, and provide self-service portals with strict EU-only data residency and sub-800ms search response times.")

System_Ext(Academic_Identity_Providers, "Academic Identity Providers", "Shibboleth/SAML/OIDC providers used for user authentication and federation.")
System_Ext(Payment_Gateway, "Payment Gateway", "PCI-DSS compliant payment gateway for handling financial transactions.")
System_Ext(Digital_Content_Providers, "Digital Content Providers", "External providers supplying digital content items accessible through the system.")
System_Ext(EU_Notification_Gateway, "EU Notification Gateway", "Gateway handling asynchronous notifications and alerts.")

Rel(Patrons, Library_Management_System, "Interacts via Web and Mobile clients to catalogue, search, and manage circulation.", "HTTPS (TLS 1.3)")
Rel(Librarians, Library_Management_System, "Interacts via Web and Mobile clients to catalogue, search, and manage circulation.", "HTTPS (TLS 1.3)")
Rel(Library_Administrators, Library_Management_System, "Manages system configuration and administrative tasks.", "HTTPS (TLS 1.3)")
Rel(Library_Management_System, Academic_Identity_Providers, "Federates user authentication.", "OIDC and SAML over HTTPS")
Rel(Library_Management_System, Payment_Gateway, "Processes secure payments.", "REST/JSON over HTTPS with mTLS and OAuth2")
Rel(Library_Management_System, Digital_Content_Providers, "Retrieves and accesses digital content.", "REST/JSON over HTTPS with mTLS and OAuth2")
Rel(Library_Management_System, EU_Notification_Gateway, "Sends asynchronous notifications.", "Asynchronous webhooks and REST APIs over HTTPS (TLS 1.3)")

@enduml