@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(Patrons, "Patrons", "Students, Researchers, and the Public who use web and mobile clients to search and borrow physical and digital items.")
Person(Librarians, "Librarians", "Library staff who manage circulation and catalogue items via web and mobile clients.")
Person(Library_Administrators, "Library Administrators", "Administrators who configure and oversee the library management system.")

System_Ext(Academic_Identity_Providers, "Academic Identity Providers", "Shibboleth/SAML/OIDC providers used for user authentication and federation.")
System_Ext(Payment_Gateway, "Payment Gateway", "PCI-DSS compliant payment gateway for handling financial transactions.")
System_Ext(Digital_Content_Providers, "Digital Content Providers", "External providers supplying digital content items accessible through the system.")
System_Ext(EU_Notification_Gateway, "EU Notification Gateway", "Gateway handling asynchronous notifications and alerts.")

System_Boundary(Library_Management_System, "Library Management System") {
    Container(Patron_Self_Service_Portal, "Patron Self-Service Portal", "React/TypeScript SPA", "Web application container providing patron self-service capabilities.")
    Container(Librarian_Management_Portal, "Librarian Management Portal", "React/TypeScript SPA", "Web application container for librarian management tasks.")
    Container(API_Gateway, "API Gateway", "Kong / Envoy", "Manages ingress routing, rate limiting, and security enforcement.")
    Container(Search_Microservice, "Search Microservice", "Java / Spring Boot", "Microservice responsible for high-performance search capabilities.")
    Container(Circulation___Catalogue_Microservice, "Circulation & Catalogue Microservice", "Java / Spring Boot", "Microservice managing item circulation and cataloguing.")
    Container(Notification_Dispatcher, "Notification Dispatcher", "Node.js / TypeScript", "Dispatches system notifications asynchronously.")
    Container(Message_Broker, "Message Broker", "RabbitMQ / Kafka", "Asynchronous decoupling and event distribution.")
    ContainerDb(Database_Layer, "Database Layer", "PostgreSQL with EU-pinned TLS 1.3/JDBC", "Relational persistence compliant with EU-only data residency.")
    ContainerDb(Elasticsearch, "Elasticsearch", "Elasticsearch (EU-hosted)", "Provides sub-800ms search performance.")
}

Rel(Patrons, Patron_Self_Service_Portal, "Uses", "HTTPS (TLS 1.3)")
Rel(Librarians, Librarian_Management_Portal, "Uses", "HTTPS (TLS 1.3)")
Rel(Library_Administrators, API_Gateway, "Manages system configuration", "HTTPS (TLS 1.3)")
Rel(Patron_Self_Service_Portal, API_Gateway, "Communicates via HTTPS", "HTTPS")
Rel(Librarian_Management_Portal, API_Gateway, "Communicates via HTTPS", "HTTPS")
Rel(API_Gateway, Search_Microservice, "Routes ingress requests", "OAuth 2.0 / OIDC and mTLS")
Rel(API_Gateway, Circulation___Catalogue_Microservice, "Routes ingress requests", "OAuth 2.0 / OIDC and mTLS")
Rel(Search_Microservice, Circulation___Catalogue_Microservice, "Communicates between microservices", "gRPC over mTLS")
Rel(Circulation___Catalogue_Microservice, Message_Broker, "Publishes asynchronous events", "AMQP / Kafka Protocol")
Rel(Message_Broker, Notification_Dispatcher, "Delivers events", "AMQP / Kafka Protocol")
Rel(Notification_Dispatcher, EU_Notification_Gateway, "Calls notification gateway", "HTTPS/REST")
Rel(Search_Microservice, Elasticsearch, "Queries search index", "REST over TLS 1.3")
Rel(Circulation___Catalogue_Microservice, Database_Layer, "Persists and retrieves data", "JDBC over TLS 1.3")
Rel(Search_Microservice, Database_Layer, "Persists and retrieves data", "JDBC over TLS 1.3")
Rel(API_Gateway, Academic_Identity_Providers, "Federates authentication", "OIDC and SAML over HTTPS")
Rel(API_Gateway, Payment_Gateway, "Processes payments", "REST/JSON over HTTPS with mTLS and OAuth2")
Rel(API_Gateway, Digital_Content_Providers, "Retrieves digital content", "REST/JSON over HTTPS with mTLS and OAuth2")

@enduml