@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(LibraryPatrons, "Library Patrons", "Self-service users accessing the library system for cataloging and circulation services.")
Person(LibrariansCatalogers, "Librarians/Catalogers", "Inventory managers responsible for cataloging and managing library resources.")
Person(LibraryAdministrators, "Library Administrators", "System configurers responsible for managing system settings and security.")

System_Ext(EUPaymentGateway, "EU Payment Gateway", "External gateway handling payment transactions.")
System_Ext(NationalLibraryDatabase, "National Library Database", "External national database for library records and synchronization.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(PatronPortal, "Patron Portal", "Next.js", "Self-service portal for library patrons.")
    Container(LibrarianDashboard, "Librarian Dashboard", "React", "Dashboard for librarians and catalogers.")
    Container(APIGateway, "API Gateway", "Kong/Envoy", "API Gateway handling routing and entry to core services.")
    Container(SearchCatalogueService, "Search & Catalogue Service", "Elasticsearch/OpenSearch", "Service for searching and cataloging library items.")
    Container(CirculationService, "Circulation Service", "Node.js/Go", "Service managing circulation and loans.")
    Container(NotificationService, "Notification Service", "Node.js/Go", "Service handling notifications to users.")
    Container(IntegrationService, "Integration Service", "Python/Go", "Service integrating with external systems like payment gateways and national databases.")
    Container(MessageBroker, "Message Broker", "Kafka/RabbitMQ", "Message broker for asynchronous communication between services.")
    ContainerDb(PostgreSQLDatabase, "PostgreSQL Database", "PostgreSQL with Read Replicas", "Transactional storage for system data.")
    Container(IdentityProvider, "Identity Provider", "OAuth 2.0 / OIDC", "Handles authentication and authorization.")
    Container(HashiCorpVault, "HashiCorp Vault", "HashiCorp Vault", "Manages secrets and sensitive data.")
}

Rel(LibraryPatrons, PatronPortal, "Accesses self-service features", "HTTPS")
Rel(LibrariansCatalogers, LibrarianDashboard, "Manages catalog and circulation", "HTTPS")
Rel(LibraryAdministrators, LibrarianDashboard, "Configures system settings", "HTTPS")
Rel(PatronPortal, APIGateway, "Makes API requests", "HTTPS (REST/GraphQL) with OAuth 2.0 / OIDC tokens")
Rel(LibrarianDashboard, APIGateway, "Makes API requests", "HTTPS (REST/GraphQL) with OAuth 2.0 / OIDC tokens")
Rel(APIGateway, SearchCatalogueService, "Queries catalogue", "gRPC with mTLS")
Rel(CirculationService, MessageBroker, "Publishes and consumes messages", "AMQP")
Rel(NotificationService, MessageBroker, "Publishes and consumes messages", "AMQP")
Rel(IntegrationService, MessageBroker, "Publishes and consumes messages", "AMQP")
Rel(IntegrationService, EUPaymentGateway, "Processes payments", "REST with circuit breakers")
Rel(IntegrationService, NationalLibraryDatabase, "Synchronizes library records", "REST with circuit breakers")
Rel(CirculationService, PostgreSQLDatabase, "Reads and writes transactional data", "TLS 1.3 and mTLS")
Rel(SearchCatalogueService, PostgreSQLDatabase, "Reads and writes data", "TLS 1.3 and mTLS")

@enduml