@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(LibraryPatrons, "Library Patrons", "Self-service users accessing the library system for cataloging and circulation services.")
Person(LibrariansCatalogers, "Librarians/Catalogers", "Inventory managers responsible for cataloging and managing library resources.")
Person(LibraryAdministrators, "Library Administrators", "System configurers responsible for managing system settings and security.")

System(LibraryManagementSystem, "Library Management System", "Cloud-native platform providing cataloging, circulation, and self-service portals for public and academic libraries while adhering to strict EU data residency constraints.")

System_Ext(EUPaymentGateway, "EU Payment Gateway", "External gateway handling payment transactions.")
System_Ext(NationalLibraryDatabase, "National Library Database", "External national database for library records and synchronization.")

Rel(LibraryPatrons, LibraryManagementSystem, "Accesses self-service portals and circulation features", "HTTPS/TLS 1.3 (OAuth2/OIDC)")
Rel(LibrariansCatalogers, LibraryManagementSystem, "Manages inventory and cataloging", "HTTPS/TLS 1.3 (MFA/RBAC)")
Rel(LibraryAdministrators, LibraryManagementSystem, "Configures and manages system settings", "HTTPS/TLS 1.3 (MFA/RBAC)")
Rel(LibraryManagementSystem, EUPaymentGateway, "Processes payments", "HTTPS/REST with mTLS")
Rel(LibraryManagementSystem, NationalLibraryDatabase, "Queries and synchronizes library records", "SOAP/REST over HTTPS with mTLS")

@enduml