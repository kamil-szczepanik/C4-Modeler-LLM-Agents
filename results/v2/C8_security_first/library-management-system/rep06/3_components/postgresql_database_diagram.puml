@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL Database container

Container_Boundary(postgresql_database, "PostgreSQL Database") {
    Component(ConnectionPooler, "Connection Pooler", "PgBouncer", "Manages incoming database connections and terminates mTLS.")
    Component(PrimaryTransactionEngine, "Primary Transaction Engine", "PostgreSQL Primary, Row-Level Security, pgaudit", "Handles all write operations, enforcing Row-Level Security and pgaudit logging.")
    Component(ReadReplicaInstances, "Read Replica Instances", "PostgreSQL Replicas", "Offloads read-heavy operations and hosts the dedicated Reporting & Analytics Schema.")
    Component(HighAvailabilityStandby, "High-Availability Standby", "Streaming Replication, WAL-shipping", "Synchronizes state with the Primary Transaction Engine.")
    Component(ReportingAnalyticsSchema, "Reporting & Analytics Schema", "PostgreSQL Schema", "Serves isolated analytical queries for Library Administrators.")
}

Rel(ConnectionPooler, PrimaryTransactionEngine, "Proxies write operations via TCP with inner-node TLS 1.3", "TCP / TLS 1.3")
Rel(ConnectionPooler, ReadReplicaInstances, "Routes read-only reports via TCP with inner-node TLS 1.3", "TCP / TLS 1.3")
Rel(PrimaryTransactionEngine, HighAvailabilityStandby, "Synchronizes state via WAL-shipping (Streaming Replication)", "WAL-shipping")
Rel(ReadReplicaInstances, ReportingAnalyticsSchema, "Serves isolated analytical queries for Library Administrators", "SQL")
@enduml