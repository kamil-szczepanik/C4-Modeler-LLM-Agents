@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Envoy_Proxy_Router, "Envoy Proxy Router", "Envoy Proxy, xDS dynamic control planes", "Handles routing, ingress security, gRPC-web support, and low memory footprint traffic management.")
    Component(Rate_Limiting_Module, "Rate Limiting Module", "Envoy Proxy Rate Limit Service", "Enforces strict rate-limiting policies for incoming public and academic library requests.")
    Component(Security_Wasm_Filter, "Security & Wasm Filter", "WebAssembly (Wasm) filters, TLS 1.3", "Executes custom security checks, handles mTLS certificate rotation integration with HashiCorp Vault, and validates EU-only data residency constraints.")
}

Rel(Envoy_Proxy_Router, Rate_Limiting_Module, "Inspects incoming requests against rate-limiting rules")
Rel(Envoy_Proxy_Router, Security_Wasm_Filter, "Passes ingress traffic through Wasm filters for inspection and token handling")
Rel(Security_Wasm_Filter, Search_Catalogue_Service, "Routes queries via gRPC with mTLS", "gRPC / mTLS")
@enduml