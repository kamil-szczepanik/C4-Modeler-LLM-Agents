@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the HashiCorp Vault container

Container_Boundary(vault_container, "HashiCorp Vault") {
    Component(CoreHttpApiLayer, "Core/HTTP API Layer", "HashiCorp Vault Go-based API engine", "Handles secure REST/HTTPS requests, policy enforcement, and core secrets management operations.")
    Component(IntegratedRaftStorageBackend, "Integrated Raft Storage Backend", "Raft Consensus Algorithm Storage", "Persists encrypted data locally within the container ensuring strict EU data residency compliance.")
    Component(VaultAgentSidecar, "Vault Agent Sidecar", "HashiCorp Vault Agent", "Provides client-side caching, automated authentication, and transit security via Unix Domain Sockets or localhost TCP.")
}

Rel(VaultAgentSidecar, CoreHttpApiLayer, "Communicates via HTTPS (REST) over mTLS on Port 8200", "HTTPS / mTLS")
Rel(CoreHttpApiLayer, IntegratedRaftStorageBackend, "Persists encrypted data using Raft internal RPC over TLS", "Raft RPC / TLS")

@enduml