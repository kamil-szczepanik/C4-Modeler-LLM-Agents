@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Search & Catalogue Service container

System_Ext(api_gateway, "API Gateway", "External API Gateway routing requests")

Container_Boundary(search_catalogue_service, "Search & Catalogue Service") {
    Component(search_api_controller, "Search API Controller", "Go, Gin/gRPC", "Handles high-throughput, low-latency search query handling and offloads anonymized query metrics.")
    Component(catalog_management_engine, "Catalog Management Engine", "Python, FastAPI", "Efficiently handles complex metadata ingestion and synchronizes metadata updates.")
    Component(search_index_client, "Search Index Client", "OpenSearch wrapper with Facet Configuration Component", "Manages multi-format indexing, faceting, and relevance scoring.")
    Component(analytics_logging_collector, "Analytics & Logging Collector", "Async Worker", "Offloads and collects anonymized query metrics via message queues.")
    Component(opensearch_cluster, "OpenSearch Cluster", "Kubernetes StatefulSet with EU-localized Persistent Volumes", "Provides multi-format physical and digital asset discovery compliant with EU data residency.")
    Component(hashicorp_vault, "HashiCorp Vault", "HashiCorp Vault", "Provides secure, dynamic credential management and TDE encryption keys via sidecars.")
}

Rel(api_gateway, search_api_controller, "Queries catalogue via gRPC with mTLS", "gRPC / mTLS")
Rel(search_api_controller, search_index_client, "Executes search queries via OpenSearch REST API over TLS 1.3", "REST API / TLS 1.3")
Rel(catalog_management_engine, search_index_client, "Synchronizes metadata updates via OpenSearch Bulk API over TLS 1.3", "Bulk API / TLS 1.3")
Rel(search_api_controller, analytics_logging_collector, "Offloads anonymized query metrics via Kafka/RabbitMQ", "Kafka/RabbitMQ")
Rel(search_api_controller, hashicorp_vault, "Dynamic secret injection via HashiCorp Vault sidecars", "Sidecar / Vault API")
Rel(catalog_management_engine, hashicorp_vault, "Dynamic secret injection via HashiCorp Vault sidecars", "Sidecar / Vault API")
Rel(search_index_client, opensearch_cluster, "Reads and writes index data via REST API", "REST API")

@enduml