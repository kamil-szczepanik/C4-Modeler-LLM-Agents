@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Circulation_Service, "Circulation Service", "External system container")
System_Ext(Notification_Service, "Notification Service", "External system container")
System_Ext(Integration_Service, "Integration Service", "External system container")

Container_Boundary(message_broker, "Message Broker") {
    Component(Exchange_Routing_Engine, "Exchange Routing Engine", "RabbitMQ Exchange", "Provides flexible AMQP routing and topic ACLs for event distribution.")
    Component(Queue_Manager, "Queue Manager", "RabbitMQ Quorum Queues", "Manages mirrored quorum queues across EU zones for zero data loss.")
    Component(Consumer_Delivery_Manager, "Consumer Delivery Manager", "AMQP 0-9-1", "Handles event delivery and consumption for services like Circulation, Notification, and Integration.")
    Component(Dead_Letter_Routing_Policy_Engine, "Dead-Letter Routing & Policy Engine", "RabbitMQ Dead-Lettering", "Provides per-queue dead-lettering and failure management.")
    Component(Access_Control_TLS_Termination_Proxy, "Access Control & TLS Termination Proxy", "TLS 1.3 & mTLS", "Enforces strict transport security, service authentication, and fine-grained topic ACLs.")
}

Rel(Circulation_Service, Exchange_Routing_Engine, "Publishes/consumes events", "AMQP 0-9-1 via TLS 1.3")
Rel(Notification_Service, Consumer_Delivery_Manager, "Consumes events", "AMQP 0-9-1 via TLS 1.3")
Rel(Integration_Service, Exchange_Routing_Engine, "Publishes/consumes events", "AMQP 0-9-1 via TLS 1.3")

@enduml