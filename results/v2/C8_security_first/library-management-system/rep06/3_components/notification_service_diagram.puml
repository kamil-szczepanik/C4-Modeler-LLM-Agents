@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification Service container

Container_Boundary(notification_service, "Notification Service") {
    Component(Event_Consumer_Component, "Event Consumer Component", "Go", "Consumes domain events from the message broker.")
    Component(Preference_Template_Engine, "Preference & Template Engine", "Node.js/Go", "Queries preferences and opt-out flags from the database.")
    Component(Dispatch_Adapter_Component, "Dispatch Adapter Component", "Go", "Sends notifications to external providers and fetches secrets.")
    Component(Audit_Logging_Component, "Audit & Logging Component", "Go", "Records delivery timestamps.")
}

Component(Message_Broker, "Message Broker", "Kafka/RabbitMQ", "Provides asynchronous queuing and dead-letter queues.")
Component(PostgreSQL_Database, "PostgreSQL Database", "PostgreSQL", "Stores anonymized delivery logs and patron channel preferences.")
Component(HashiCorp_Vault, "HashiCorp Vault", "HashiCorp Vault", "Manages dynamic credentials with AppRole authentication.")
Component(External_EU_hosted_Email_SMS_Providers, "External EU-hosted Email/SMS Providers", "HTTPS/TLS 1.3", "Sends external notifications.")

Rel(Event_Consumer_Component, Message_Broker, "Consumes domain events", "AMQP/mTLS")
Rel(Preference_Template_Engine, PostgreSQL_Database, "Queries preferences and opt-out flags", "SQL/TLS")
Rel(Dispatch_Adapter_Component, HashiCorp_Vault, "Fetches provider secrets", "HTTPS/Token Auth with AppRole")
Rel(Dispatch_Adapter_Component, External_EU_hosted_Email_SMS_Providers, "Sends notifications", "HTTPS/TLS 1.3")
Rel(Dispatch_Adapter_Component, Audit_Logging_Component, "Records delivery timestamps", "In-memory/gRPC")

@enduml