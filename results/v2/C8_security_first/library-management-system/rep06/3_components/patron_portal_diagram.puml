@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Patron_Portal_Container", "Patron Portal") {
    Component("UIPresentationLayer", "UI Presentation Layer", "React / Tailwind CSS", "Powers server-rendered UI for performance and WCAG 2.1 AA accessibility.")
    Component("BFFRouteHandlerLayer", "BFF / Route Handler Layer", "Next.js Node.js runtime", "Isolates sensitive session tokens and handles proxied requests with OIDC tokens.")
    Component("PatronPortalContainer", "Patron Portal Container", "Next.js", "Secure self-service web interface enabling library patrons to catalogue items, manage accounts, and handle circulation tasks.")
}

Rel("UIPresentationLayer", "BFFRouteHandlerLayer", "Internal React Server Actions", "Direct IPC")
Rel("BFFRouteHandlerLayer", "PatronPortalContainer", "Serves application logic and handles routing", "")

@enduml