@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Librarian Dashboard container

Person(Librarians_Catalogers_and_Library_Administrators, "Librarians, Catalogers, and Library Administrators", "Library staff utilizing the dashboard")
System_Ext(API_Gateway, "API Gateway", "Kong/Envoy backend gateway")
System_Ext(EU_restricted_CDN_e_g__AWS_CloudFront, "EU-restricted CDN (e.g., AWS CloudFront)", "Serves static immutable assets")

Container_Boundary(Librarian_Dashboard, "Librarian Dashboard") {
    Component(Authentication_Wrapper, "Authentication Wrapper", "React Context / OIDC Client component", "Secures user sessions with in-memory token handling and OAuth 2.0 / OIDC.")
    Component(Catalog_Management_Module, "Catalog Management Module", "Lazy-loaded React component", "Provides tools for catalog management with rapid bundle optimization.")
    Component(Circulation___Overdue_Handler, "Circulation & Overdue Handler", "React component", "Manages circulation workflows and overdue item tracking.")
    Component(Analytics___Admin_Console, "Analytics & Admin Console", "React component", "Provides administrative analytics and configuration tools.")
    Component(API_Client_Layer, "API Client Layer", "Axios/Fetch wrapper component", "Handles API requests with centralized error handling and exponential backoff retry logic.")
    Component(State___Routing_Management, "State & Routing Management", "React Router & Zustand", "Manages local application state and role-based route guards.")
}

Rel(Librarians_Catalogers_and_Library_Administrators, Librarian_Dashboard, "Manages catalog, circulation, and configurations", "HTTPS")
Rel(Librarian_Dashboard, API_Gateway, "Makes API requests with short-lived tokens and idempotency headers", "HTTPS (REST/GraphQL)")
Rel(Librarian_Dashboard, EU_restricted_CDN_e_g__AWS_CloudFront, "Serves static immutable assets", "HTTPS")
@enduml