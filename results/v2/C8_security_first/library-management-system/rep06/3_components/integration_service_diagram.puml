@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(EU_Payment_Gateway, "EU Payment Gateway", "External payment processing service.")
System_Ext(National_Library_Database, "National Library Database", "External national library database.")
System_Ext(Message_Broker, "Message Broker", "Asynchronous message broker (Kafka/RabbitMQ).")
System_Ext(HashiCorp_Vault, "HashiCorp Vault", "Secrets management service.")
System_Ext(Redis, "Redis", "In-memory data store for transaction state.")

Container_Boundary(integration_service_boundary, "Integration Service") {
    Component(API_Client_Component, "API Client Component", "Go SDK", "Communicates securely with external services like the EU Payment Gateway and National Library Database using REST over TLS 1.3.")
    Component(Message_Consumer_Producer_Component, "Message Consumer/Producer Component", "Go", "Publishes and consumes asynchronous messages with the Message Broker using AMQP with mTLS.")
    Component(Synchronization_Orchestrator, "Synchronization Orchestrator", "Go", "Coordinates the synchronization of library records with external national databases while adhering to EU data residency rules.")
    Component(Idempotency_Manager_Component, "Idempotency Manager Component", "Go, Redis", "Powers transaction deduplication to prevent duplicate processing and handles asynchronous retry queues.")
    Component(Vault_Integration_Client, "Vault Integration Client", "Go, HashiCorp Vault", "Dynamically fetches runtime credentials using short-lived tokens, eliminating local credential storage.")
}

Rel(API_Client_Component, EU_Payment_Gateway, "Processes payments and webhooks", "REST over TLS 1.3 with circuit breakers")
Rel(API_Client_Component, National_Library_Database, "Synchronizes library records", "REST over TLS 1.3 with rate limiting")
Rel(Message_Consumer_Producer_Component, Message_Broker, "Publishes and consumes messages", "AMQP with mTLS")
Rel(Vault_Integration_Client, HashiCorp_Vault, "Dynamically fetches runtime credentials", "REST via short-lived tokens")
Rel(Idempotency_Manager_Component, Redis, "Stores transaction state to prevent duplicate transactions", "TCP")

@enduml