@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Component(Patron_Portal, "Patron Portal", "Web Frontend", "Client portal interacting with the Identity Provider.")
Component(Librarian_Dashboard, "Librarian Dashboard", "Web Frontend", "Staff dashboard interacting with the Identity Provider.")

System_Boundary(identity_provider_boundary, "Identity Provider") {
    Component(Authentication_Engine, "Authentication Engine", "Keycloak / Java/Quarkus", "Handles OIDC/OAuth2 protocols and PKCE.")
    Component(User_Management_RBAC_Service, "User Management & RBAC Service", "Keycloak / Java/Quarkus", "Manages profiles and maps roles to JWT claims.")
    Component(Session_Token_Management_Service, "Session & Token Management Service", "Keycloak / Java/Quarkus", "Manages active user sessions and token revocation.")
    Component(Adaptive_MFA_Policy_Engine, "Adaptive MFA & Policy Engine", "Keycloak / Java/Quarkus", "Evaluates risk signals for step-up authentication.")
    Component(Federation_JIT_Provisioning_Component, "Federation & JIT Provisioning Component", "Keycloak / Java/Quarkus", "Manages external IdPs (Google, Shibboleth SAML).")
    Component(UI_Localization_Component, "UI & Localization Component", "Keycloak / Java/Quarkus", "Renders multi-language login and consent pages.")
}

Component(HashiCorp_Vault, "HashiCorp Vault", "HashiCorp Vault", "Stores cryptographic key material.")
Component(PostgreSQL_Database, "PostgreSQL Database", "PostgreSQL", "Persists identity state.")
Component(Infinispan, "Infinispan", "Infinispan", "Distributed session clustering and replication across Keycloak replicas.")

Rel(Patron_Portal, Authentication_Engine, "HTTPS (OIDC Authorization Code Flow with PKCE)")
Rel(Librarian_Dashboard, Authentication_Engine, "HTTPS (OIDC Authorization Code Flow with PKCE)")
Rel(Session_Token_Management_Service, HashiCorp_Vault, "HTTPS/REST", "Transit Secrets Engine")
Rel(Authentication_Engine, PostgreSQL_Database, "JDBC", "TLS")
Rel(Session_Token_Management_Service, PostgreSQL_Database, "JDBC", "TLS")
Rel(Session_Token_Management_Service, Infinispan, "Inter-node session replication", "ENCRYPT_TCP")

@enduml