@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalogue DB and Circulation DB container

System_Ext(CatalogueService, "Catalogue Service", "External service interacting with the database")
System_Ext(CirculationLoanService, "Circulation & Loan Service", "External service interacting with the database")

Container_Boundary(CatalogueDBandCirculationDB, "Catalogue DB and Circulation DB") {
    Component(PostgreSQL, "PostgreSQL", "Relational database with AES-256 encrypted EU persistent volumes", "Primary and Replica instances providing relational storage for catalogue and circulation data.")
    Component(Patroni, "Patroni", "High-availability template for PostgreSQL", "Manages high availability and automated failover for PostgreSQL across availability zones.")
    Component(PgBouncer, "PgBouncer", "Connection pooling sidecar", "Manages persistent database connections and prevents saturation via connection pooling.")
    Component(FlywayLiquibase, "Flyway/Liquibase", "Migration runner container", "Executes CI/CD-driven, zero-downtime, backward-compatible schema changes.")
    Component(Prometheus, "Prometheus", "Observability and monitoring", "Scrapes metrics via Prometheus exporters from PostgreSQL and PgBouncer.")
}

Rel(CatalogueService, PostgreSQL, "Reads catalogue data", "TCP/Postgres wire protocol over mTLS and PgBouncer")
Rel(CirculationLoanService, PostgreSQL, "Reads/writes circulation data", "TCP/Postgres wire protocol over mTLS and PgBouncer")
Rel(Prometheus, PostgreSQL, "Scrapes metrics", "Prometheus exporters")
Rel(Prometheus, PgBouncer, "Scrapes metrics", "Prometheus exporters")

@enduml