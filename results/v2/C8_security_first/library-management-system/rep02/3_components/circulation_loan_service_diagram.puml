@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Component_Ext(envoyProxy, "Envoy Proxy", "Envoy", "Routes gRPC/Protobuf requests with mTLS and forwarded JWT claims.")
Component_Ext(circulationDb, "Circulation DB", "PostgreSQL", "Persistent storage for encrypted circulation data.")
Component_Ext(messageBroker, "Message Broker", "RabbitMQ", "Message broker supporting transactional outbox patterns.")
Component_Ext(paymentGateway, "Payment Gateway", "HTTPS/REST", "External gateway for processing fine settlements.")

Container_Boundary(circulationLoanService, "Circulation & Loan Service") {
    Component(loanApiController, "Loan API Controller", "Express.js", "Handling gRPC routing and Zod schema validation.")
    Component(circulationWorkflowEngine, "Circulation Workflow Engine", "Node.js service layer", "Managing transactional states, grace periods, and hold expiry.")
    Component(dataAccessLayer, "Data Access Layer", "Repository component", "Enforcing column-level encryption and least-privilege connection pooling.")
    Component(outboxPatternComponent, "Outbox Pattern Component", "Node.js", "Transactional outbox processor for reliable asynchronous messaging.")
    Component(eventPublisherSubscriber, "Event Publisher/Subscriber", "AMQP", "Publishing domain events over AMQP to the Message Broker.")
    Component(paymentClient, "Payment Client", "HTTPS with REST/JSON", "Encapsulating integration logic with the Payment Gateway over HTTPS with idempotency keys.")
}

Rel(envoyProxy, loanApiController, "Routes gRPC/Protobuf requests with mTLS and forwarded JWT claims", "gRPC/Protobuf")
Rel(dataAccessLayer, circulationDb, "Reads and writes encrypted circulation data", "gRPC/Protobuf")
Rel(eventPublisherSubscriber, messageBroker, "Publishes and consumes domain events", "AMQP")
Rel(paymentClient, paymentGateway, "Processes fine settlements", "HTTPS with REST/JSON")

@enduml