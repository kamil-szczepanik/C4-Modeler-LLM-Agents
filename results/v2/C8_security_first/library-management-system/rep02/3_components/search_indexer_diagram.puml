@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Library Staff & Administrators, "Library Staff & Administrators", "Authenticated users accessing monitoring dashboards.")
Container(Web Application Container, "Web Application Container", "HTTPS/JSON with JWT RBAC", "Web application interacting with administrative controls.")
Container_Ext(Message Broker, "Message Broker", "RabbitMQ", "Manages asynchronous ingestion queues with AMQP over TLS 1.3.")

System_Boundary(Search Indexer, "Search Indexer") {
    Component(Indexing Worker Component, "Indexing Worker Component", "Python / Celery", "Asynchronous worker handling payload sanitization and bulk-writes.")
    Component(Index Management API Component, "Index Management API Component", "Python FastAPI", "Exposes administrative health checks and re-index triggers.")
    Component(Elasticsearch Engine Component, "Elasticsearch Engine Component", "Elasticsearch v8", "Provides inverted indices with AES-256 encryption at rest.")
}

Rel(Message Broker, Indexing Worker Component, "Consumes catalogue events", "AMQP over TLS 1.3")
Rel(Indexing Worker Component, Elasticsearch Engine Component, "Bulk-writes and searches", "HTTP/REST over mTLS")
Rel(Index Management API Component, Elasticsearch Engine Component, "Bulk-writes and searches", "HTTP/REST over mTLS")
Rel(Web Application Container, Index Management API Component, "Exposes administrative controls", "HTTPS/JSON with JWT RBAC")
@enduml