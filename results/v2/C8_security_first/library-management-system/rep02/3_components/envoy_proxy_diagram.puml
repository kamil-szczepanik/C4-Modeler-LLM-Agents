@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(envoy_proxy, "Envoy Proxy") {
    Component(Listener Subsystem, "Listener Subsystem", "Envoy Core", "Accepts incoming network connections and handles initial connection setup.")
    Component(HTTP Connection Manager (HCM), "HTTP Connection Manager (HCM)", "Envoy HCM", "Manages HTTP-level routing, request transformations, and connection management.")
    Component(JWT Authentication Filter, "JWT Authentication Filter", "Envoy Auth Filter", "Validates JSON Web Tokens issued by the Enterprise Identity Provider at the edge.")
    Component(Rate Limit Filter, "Rate Limit Filter", "Envoy Filter", "Enforces token-bucket rate limiting to safeguard system performance.")
    Component(Cluster Manager, "Cluster Manager", "Envoy Cluster Manager", "Manages upstream clusters, load balancing, and routing via mTLS and gRPC/Protobuf.")
}

Rel(Listener Subsystem, HTTP Connection Manager (HCM), "Passes raw network traffic for HTTP processing")
Rel(HTTP Connection Manager (HCM), JWT Authentication Filter, "Inspects requests to validate security tokens")
Rel(HTTP Connection Manager (HCM), Rate Limit Filter, "Evaluates request traffic against rate limits")
Rel(HTTP Connection Manager (HCM), Cluster Manager, "Routes processed requests to downstream services")
@enduml