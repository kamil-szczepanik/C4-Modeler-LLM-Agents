@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Message Broker container

Container_Boundary(message_broker, "Message Broker") {
    Component(Exchange_Router, "Exchange Router", "RabbitMQ", "Routes asynchronous loan and payment events published by the Circulation & Loan Service.")
    Component(Persistence_Store, "Persistence Store", "Mnesia", "Provides durable persistence for message broker state.")
    Component(Dead_Letter_Retry_Manager, "Dead Letter & Retry Manager", "RabbitMQ", "Manages failed messages, retries, and dead-letter queues.")
    Component(Event_Fanout_Router, "Event Fanout Router", "RabbitMQ", "Forwards item check-in/out inventory updates to the Search Indexer.")
}

System_Ext(Search_Indexer, "Search Indexer", "Elasticsearch")

Rel(Exchange_Router, Event_Fanout_Router, "Routes and fans out events", "")
Rel(Event_Fanout_Router, Search_Indexer, "Forwards item check-in/out inventory updates", "AMQP over TLS 1.3")

@enduml