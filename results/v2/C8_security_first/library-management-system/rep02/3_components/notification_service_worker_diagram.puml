@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification Service Worker container

System_Ext(External_Notification_Service, "External Notification Service", "External System / HTTPS (REST/JSON) with TLS 1.3 and mTLS", "External system receiving dispatched notifications.")

Container_Boundary(Notification_Service_Worker, "Notification Service Worker") {
    Component(RabbitMQ_Message_Consumer, "RabbitMQ Message Consumer", "Python FastAPI / AMQP with TLS", "Internal component listening to the message broker over AMQP with TLS.")
    Component(Notification_Dispatcher_Engine, "Notification Dispatcher Engine", "Python FastAPI", "Internal component coordinating payload validation and routing.")
    Component(Preference___Localization_Filter, "Preference & Localization Filter", "Python FastAPI", "Internal component verifying patron notification preferences, localization, and quiet-hours.")
    Component(External_API_Client__Httpx_, "External API Client (Httpx)", "Python Httpx", "Internal component managing outbound HTTPS requests with circuit breakers and exponential backoff.")
    Component(Dead_Letter_Handler, "Dead-Letter Handler", "Python FastAPI / RabbitMQ DLQ", "Internal component routing permanently failed messages to RabbitMQ DLQ.")
}

Rel(RabbitMQ_Message_Consumer, Notification_Dispatcher_Engine, "Internal function call", "AMQP with TLS")
Rel(Notification_Dispatcher_Engine, Preference___Localization_Filter, "Internal async call")
Rel(Preference___Localization_Filter, External_API_Client__Httpx_, "Internal payload passing")
Rel(External_API_Client__Httpx_, External_Notification_Service, "Sends messages", "HTTPS (REST/JSON) with TLS 1.3 and mTLS")

@enduml