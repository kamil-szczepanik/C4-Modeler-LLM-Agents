@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(LibraryPatrons, "Library Patrons", "Students and public users who search for and borrow library items via self-service portals.")
Person(LibraryStaffandCataloguers, "Library Staff and Cataloguers", "Personnel responsible for managing inventory, cataloguing items, and assisting patrons.")
Person(LibraryAdministrators, "Library Administrators", "Personnel responsible for system administration and management.")

System(LibraryManagementSystem, "Library Management System", "A cloud-hosted solution for public and academic libraries to catalogue physical and digital items, manage circulation, and provide self-service portals with strict EU data residency.")

System_Ext(EnterpriseIdentityChef, "Enterprise Identity Provider", "Auth0/Keycloak EU used to federate user identity and enforce Role-Based Access Control.")
System_Ext(PaymentGateway, "Payment Gateway", "Stripe EU used for processing payments securely.")
System_Ext(NotificationService, "Notification Service", "SendGrid/Twilio EU used for asynchronous notification delivery.")

Rel(LibraryPatrons, EnterpriseIdentityChef, "Authenticate against the Enterprise IdP", "OIDC over HTTPS (TLS 1.3)")
Rel(LibraryStaffandCataloguers, EnterpriseIdentityChef, "Authenticate against the Enterprise IdP", "OIDC over HTTPS (TLS 1.3)")
Rel(LibraryPatrons, LibraryManagementSystem, "Interact with the LMS via self-service portal", "HTTPS")
Rel(LibraryStaffandCataloguers, LibraryManagementSystem, "Interact with the LMS for cataloguing and circulation", "HTTPS")
Rel(LibraryManagementSystem, PaymentGateway, "Connects synchronously to process payments", "HTTPS and mTLS")
Rel(LibraryManagementSystem, NotificationService, "Connects asynchronously to deliver notifications", "Message Queues")

@enduml