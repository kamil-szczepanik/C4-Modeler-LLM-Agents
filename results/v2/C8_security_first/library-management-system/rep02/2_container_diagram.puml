@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(Library Patrons, "Library Patrons", "Students and public users who search for and borrow library items via self-service portals.")
Person(Library Staff and Cataloguers, "Library Staff and Cataloguers", "Personnel responsible for managing inventory, cataloguing items, and assisting patrons.")
Person(Library Administrators, "Library Administrators", "Personnel responsible for system administration and management.")

System_Ext(Enterprise Identity Provider, "Enterprise Identity Provider", "Auth0/Keycloak EU used to federate user identity and enforce Role-Based Access Control.")
System_Ext(Payment Gateway, "Payment Gateway", "Stripe EU used for processing payments securely.")
System_Ext(Notification Service, "Notification Service", "SendGrid/Twilio EU used for asynchronous notification delivery.")

System_Boundary(Library Management System, "Library Management System") {
    Container(Envoy Proxy, "Envoy Proxy", "Envoy Proxy", "API Gateway handling external ingress, rate limiting, and TLS termination.")
    Container(Web Application Container, "Web Application Container", "React with NGINX", "Frontend self-service portals.")
    Container(Catalogue Service, "Catalogue Service", "Spring Boot (Java)", "Provides robust enterprise processing for item cataloguing.")
    Container(Circulation & Loan Service, "Circulation & Loan Service", "Node.js/Express", "Manages circulation and loan operations.")
    Container(Notification Service Worker, "Notification Service Worker", "Python FastAPI", "Handles asynchronous notification processing.")
    Container(Search Indexer, "Search Indexer", "Elasticsearch", "Provides sub-800ms catalogue search performance.")
    ContainerDb(Catalogue DB and Circulation DB, "Catalogue DB and Circulation DB", "PostgreSQL", "Relational databases with AES-256 encrypted EU persistent volumes.")
    Container(Message Broker, "Message Broker", "RabbitMQ", "Handles asynchronous messaging and circuit-breaking payment processing.")
}

Rel(Library Patrons, Web Application Container, "Accesses self-service portals", "HTTPS (REST/JSON)")
Rel(Library Staff and Cataloguers, Web Application Container, "Accesses cataloguing and circulation interfaces", "HTTPS (REST/JSON)")
Rel(Library Administrators, Web Application Container, "Accesses management interfaces", "HTTPS (REST/JSON)")
Rel(Web Application Container, Envoy Proxy, "Forwards web requests", "HTTPS (TLS 1.3)")
Rel(Envoy Proxy, Catalogue Service, "Routes cataloguing requests", "mTLS and gRPC/Protobuf")
Rel(Envoy Proxy, Circulation & Loan Service, "Routes circulation requests", "mTLS and gRPC/Protobuf")
Rel(Catalogue Service, Search Indexer, "Indexes and searches catalogue data", "gRPC/Protobuf")
Rel(Catalogue Service, Catalogue DB and Circulation DB, "Reads and writes catalogue data", "gRPC/Protobuf")
Rel(Circulation & Loan Service, Catalogue DB and Circulation DB, "Reads and writes circulation data", "gRPC/Protobuf")
Rel(Circulation & Loan Service, Message Broker, "Publishes and consumes asynchronous messages", "AMQP")
Rel(Circulation & Loan Service, Payment Gateway, "Processes payments", "HTTPS (REST/JSON)")
Rel(Notification Service Worker, Notification Service, "Sends notifications", "HTTPS (REST/JSON)")

@enduml