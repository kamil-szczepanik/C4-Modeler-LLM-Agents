@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Library Management System

Person(Library_Patrons, "Library Patrons", "End users who access self-service portals for library services.")
Person(Library_Staff_Cataloguers, "Library Staff/Cataloguers", "Staff members who manage catalogue and circulation services.")
Person(Library_Administrators, "Library Administrators", "Administrators who manage the Library Management System configuration and users.")

System(Library_Management_System, "Library Management System", "A cloud-native software solution providing catalogue management, circulation services, and self-service portals for public and academic libraries with EU-only data residency and sub-800ms search latency.")

System_Ext(External_Identity_Provider_IdP, "External Identity Provider (IdP)", "External system used for federated authentication via OIDC/OAuth 2.0.")
System_Ext(External_Payment_Gateway, "External Payment Gateway", "External system handling payment processing via REST APIs.")
System_Ext(External_Notification_Service, "External Notification Service", "External system handling notifications via REST APIs.")

Rel(Library_Patrons, Library_Management_System, "Uses via Web/Mobile Apps", "HTTPS (TLS 1.3)")
Rel(Library_Staff_Cataloguers, Library_Management_System, "Uses via Web/Mobile Apps", "HTTPS (TLS 1.3)")
Rel(Library_Administrators, Library_Management_System, "Uses via Web/Mobile Apps", "HTTPS (TLS 1.3)")
Rel(Library_Management_System, External_Identity_Provider_IdP, "Redirects for authentication", "OIDC / OAuth 2.0")
Rel(Library_Management_System, External_Payment_Gateway, "Integrates for payment processing", "Outbound HTTPS/REST APIs with mTLS")
Rel(Library_Management_System, External_Notification_Service, "Integrates for sending notifications", "Outbound HTTPS/REST APIs with mTLS")

@enduml