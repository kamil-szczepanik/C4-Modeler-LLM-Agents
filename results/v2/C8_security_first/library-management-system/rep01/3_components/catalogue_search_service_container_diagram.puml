@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(catalogue_search_service_container, "Catalogue & Search Service Container") {
    Component(grpc_api_handler, "gRPC API Handler", "Java/Spring", "Exposes endpoints, parses JWT claims for RBAC, and handles input sanitization.")
    Component(search_discovery_engine, "Search & Discovery Engine", "Elasticsearch client", "Handles DSL queries, facets, typo tolerance, and relevance.")
    Component(cataloguing_bulk_ingestion_worker, "Cataloguing & Bulk Ingestion Worker", "Java", "Processes write/update operations and schema validation.")
    Component(data_access_repository, "Data Access Repository", "Java/Spring Data", "Interfaces with storage engines.")
}

Rel(grpc_api_handler, search_discovery_engine, "In-process Java method calls", "")
Rel(grpc_api_handler, cataloguing_bulk_ingestion_worker, "In-process Java method calls", "")
Rel(cataloguing_bulk_ingestion_worker, data_access_repository, "Relational metadata persistence", "")

@enduml