@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification Dispatcher Container container

Container_Boundary(notification_dispatcher_container, "Notification Dispatcher Container") {
    Component(api_handler_component, "API Handler Component", "Go", "Handles incoming API requests and enqueues workflows into the Temporal workflow engine.")
    Component(notification_workflow_engine, "Notification Workflow Engine", "Temporal SDK", "Manages durable state, retry policies, and orchestration of multi-channel notification workflows.")
    Component(routing_preference_resolver_component, "Routing & Preference Resolver Component", "Go", "Fetches patron channel preferences and passes localized context to the template engine.")
    Component(template_engine_component, "Template Engine Component", "Go", "Renders notification payloads using localized context in-memory.")
    Component(external_connector_component, "External Connector Component", "Go", "Dispatches messages securely to external notification services using HTTPS/REST, mTLS, and OAuth2.")
}

System_Ext(external_notification_service, "External Notification Service", "External system responsible for delivering alerts to patrons and staff.")

Rel(api_handler_component, notification_workflow_engine, "Enqueues workflow", "Temporal SDK / internal RPC")
Rel(notification_workflow_engine, routing_preference_resolver_component, "Fetches channel preferences", "Internal gRPC")
Rel(routing_preference_resolver_component, template_engine_component, "Passes localized context", "In-memory")
Rel(notification_workflow_engine, template_engine_component, "Renders payload", "In-memory")
Rel(notification_workflow_engine, external_connector_component, "Dispatches message", "Internal channel")
Rel(external_connector_component, external_notification_service, "Sends alerts", "HTTPS / REST, mTLS, OAuth2")
@enduml