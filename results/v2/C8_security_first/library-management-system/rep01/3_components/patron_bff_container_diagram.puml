@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(patron_bff, "Patron BFF Container") {
    Component(graphql_rest_api_layer, "GraphQL/REST API Layer", "NestJS / TypeScript", "Exposes optimized endpoints for UI clients to aggregate data in a single round-trip, supporting the <800 ms search performance requirement.")
    Component(jwt_abac_middleware, "JWT/ABAC Middleware", "NestJS Guards and Interceptors", "Handles token validation, attribute-based access control, and request authentication.")
    Component(catalogue_client, "Catalogue Client", "gRPC over mTLS", "Queries the Catalogue & Search Service container for search discovery and catalogue data.")
    Component(circulation_client, "Circulation Client", "gRPC over mTLS", "Fetches active loans and holds from the Circulation & Loan Service container.")
    Component(notification_client, "Notification Client", "gRPC over mTLS", "Triggers asynchronous patron notices via the Notification Dispatcher container.")
    Component(session_manager, "Session Manager", "RESP over TLS, Redis", "Manages distributed patron session caching in the EU-hosted Redis instance.")
}

Rel(graphql_rest_api_layer, jwt_abac_middleware, "Validates requests using", "")
Rel(jwt_abac_middleware, session_manager, "Caches and validates session state in", "RESP over TLS, Redis")
Rel(graphql_rest_api_layer, catalogue_client, "Queries catalogue data via", "gRPC over mTLS")
Rel(graphql_rest_api_layer, circulation_client, "Fetches active loans via", "gRPC over mTLS")
Rel(graphql_rest_api_layer, notification_client, "Triggers notices via", "gRPC over mTLS")

@enduml