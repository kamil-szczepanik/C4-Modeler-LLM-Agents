@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL container

Container_Boundary(postgresql, "PostgreSQL") {
    Component(Postgresql_Primary_Standby, "PostgreSQL 16 Primary & Standby", "PostgreSQL 16", "Relational storage engine managing ACID-compliant circulation, loans, and structured catalogue metadata.")
    Component(PgBouncer, "PgBouncer", "PgBouncer", "Connection pooler managing client connections from Spring Boot microservices.")
    Component(Patroni_etcd, "Patroni / etcd", "Patroni / etcd", "Replication manager providing automated leader election and streaming replication.")
    Component(CloudNativePG_Operator, "CloudNativePG Operator", "CloudNativePG", "Kubernetes-based deployment manager for PostgreSQL.")
    Component(pgaudit_Extension, "pgaudit Extension", "pgaudit", "Module generating structured audit logs for patron PII access.")
}

System_Ext(Circulation_Loan_Service_Container, "Circulation & Loan Service Container", "External container")
System_Ext(Centralized_SIEM, "Centralized SIEM", "External SIEM system")

Rel(Circulation_Loan_Service_Container, PgBouncer, "Transactional queries and updates", "JDBC / TLS 1.3")
Rel(PgBouncer, Postgresql_Primary_Standby, "Backend database connections", "TLS 1.3")
Rel(Postgresql_Primary_Standby, Postgresql_Primary_Standby, "Asynchronous/Synchronous streaming replication", "TCP")
Rel(Postgresql_Primary_Standby, Centralized_SIEM, "Out-of-band audit log streaming", "Syslog / TLS")

@enduml