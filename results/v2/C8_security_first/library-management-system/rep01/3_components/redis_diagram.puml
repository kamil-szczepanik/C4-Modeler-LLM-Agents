@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Redis container

System_Ext(Circulation_Loan_Service_Container, "Circulation & Loan Service Container", "External service managing circulation and loans.")
System_Ext(Catalogue_Search_Service_Container, "Catalogue & Search Service Container", "External service handling catalogue searches.")

Container_Boundary(Redis, "Redis") {
    Component(Session_Cache_Component, "Session Cache Component", "Redis 7.x, RESP3, TLS 1.3", "Manages active session states securely for the Circulation & Loan Service.")
    Component(Search_Cache_Component, "Search Cache Component", "Redis 7.x, RESP3, TLS 1.3", "Optimizes catalogue search performance for the Catalogue & Search Service.")
    Component(Redis_Sentinel, "Redis Sentinel", "Redis Sentinel", "Provides high availability and failover for the Redis tier.")
    Component(redis_exporter, "redis_exporter", "Prometheus & redis_exporter", "Exports Redis Prometheus metrics to the monitoring infrastructure.")
}

Rel(Circulation_Loan_Service_Container, Session_Cache_Component, "Manages active session states via RESP3 over TLS 1.3")
Rel(Catalogue_Search_Service_Container, Search_Cache_Component, "Optimizes catalogue searches via RESP3 over TLS 1.3")
Rel(Redis_Sentinel, Session_Cache_Component, "Monitors and manages failover")
Rel(Redis_Sentinel, Search_Cache_Component, "Monitors and manages failover")
Rel(redis_exporter, Session_Cache_Component, "Scrapes cache metrics")
Rel(redis_exporter, Search_Cache_Component, "Scrapes cache metrics")
@enduml