@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway / Ingress container

Container_Boundary(api_gateway_ingress, "API Gateway / Ingress") {
    Component(Envoy_Proxy_Route_Manager, "Envoy Proxy Route Manager", "Envoy Proxy / Kubernetes Ingress Controller", "Handles traffic routing, TLS termination, and mTLS enforcement for incoming requests.")
    Component(Security_and_Authentication_Engine, "Security and Authentication Engine", "Envoy WAF and JWT Validation", "Validates JSON Web Tokens, applies Web Application Firewall rules, and enforces EU data residency constraints.")
    Component(Rate_Limiting_and_Policy_Module, "Rate Limiting and Policy Module", "Lua / WASM Rate-Limiting", "Enforces tiered rate-limiting and prioritization policies for patrons and staff.")
}

Rel(Envoy_Proxy_Route_Manager, Security_and_Authentication_Engine, "Passes incoming requests for JWT validation and WAF inspection", "Internal")
Rel(Security_and_Authentication_Engine, Rate_Limiting_and_Policy_Module, "Evaluates rate limits and priority rules", "Internal")

@enduml