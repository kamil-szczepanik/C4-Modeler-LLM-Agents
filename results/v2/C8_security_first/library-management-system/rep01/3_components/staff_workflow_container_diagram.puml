@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Staff Workflow Container container

System_Ext(Api_Gateway_Ingress, "API Gateway / Ingress", "External routing")
System_Ext(External_Identity_Provider_IdP, "External Identity Provider (IdP)", "Authentication service")
System_Ext(Catalogue_Search_Service_Container, "Catalogue & Search Service Container", "Catalogue microservice")
System_Ext(Circulation_Loan_Service_Container, "Circulation & Loan Service Container", "Circulation microservice")

Container_Boundary(Staff_Workflow_Container, "Staff Workflow Container") {
    Component(Workflow_Orchestrator_Component, "Workflow Orchestrator Component", "Spring MVC / REST Controllers", "Manages administrative operations and routes staff traffic.")
    Component(Audit_Logging_Interceptor_Component, "Audit Logging Interceptor Component", "Spring AOP", "Implements immutable audit logging for staff operations.")
    Component(Catalogue_Integration_Client, "Catalogue Integration Client", "gRPC Stub", "Queries and updates the catalogue.")
    Component(Batch_Job_Manager_Component, "Batch Job Manager Component", "Spring Batch", "Executes asynchronous bulk item processing and batch mutations.")
}

Rel(Api_Gateway_Ingress, Workflow_Orchestrator_Component, "Routes staff traffic", "HTTP / TLS 1.3")
Rel(Workflow_Orchestrator_Component, External_Identity_Provider_IdP, "Validates OAuth2/OIDC JWTs", "HTTPS")
Rel(Workflow_Orchestrator_Component, Batch_Job_Manager_Component, "Submits asynchronous jobs", "In-Process")
Rel(Catalogue_Integration_Client, Catalogue_Search_Service_Container, "Queries and updates catalogue", "gRPC over mTLS")
Rel(Batch_Job_Manager_Component, Circulation_Loan_Service_Container, "Executes batch mutations", "gRPC over mTLS")

@enduml