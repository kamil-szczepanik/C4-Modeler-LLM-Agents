@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(LibraryPatrons, "Library Patrons", "End users who access self-service portals for library services.")
Person(LibraryStaffCataloguers, "Library Staff/Cataloguers", "Staff members who manage catalogue and circulation services.")
Person(LibraryAdministrators, "Library Administrators", "Administrators who manage the Library Management System configuration and users.")

System_Ext(ExternalIdentityProvideIdP, "External Identity Provider (IdP)", "External system used for federated authentication.")
System_Ext(ExternalPaymentGateway, "External Payment Gateway", "External system handling payment processing.")
System_Ext(ExternalNotificationService, "External Notification Service", "External system handling notifications.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(APIGatewayIngress, "API Gateway / Ingress", "Traefik or Envoy", "Entry point for client traffic providing routing and TLS termination.")
    Container(PatronBFFContainer, "Patron BFF Container", "Node.js/Express or NestJS", "Backend-for-Frontend service for library patrons.")
    Container(StaffWorkflowContainer, "Staff Workflow Container", "Spring Boot or Python/Django", "Handles library staff workflows and management operations.")
    Container(CatalogueSearchServiceContainer, "Catalogue & Search Service Container", "Java / Elasticsearch", "Manages item cataloguing and provides sub-800ms search queries.")
    Container(CirculationLoanServiceContainer, "Circulation & Loan Service Container", "Spring Boot", "Manages circulation, loans, and related transactions.")
    Container(NotificationDispatcherContainer, "Notification Dispatcher Container", "Go / Temporal", "Dispatches notifications through external services.")
    ContainerDb(PostgreSQL, "PostgreSQL", "PostgreSQL", "Relational database tier for persistent data storage.")
    ContainerDb(Redis, "Redis", "Redis", "Cache tier for search caching and performance optimization.")
}

Rel(LibraryPatrons, APIGatewayIngress, "Accesses via REST/JSON with JWT validation", "REST / JSON over HTTPS")
Rel(LibraryStaffCataloguers, APIGatewayIngress, "Accesses staff workflows", "REST / JSON over HTTPS")
Rel(LibraryAdministrators, APIGatewayIngress, "Accesses system administration", "REST / JSON over HTTPS")
Rel(APIGatewayIngress, PatronBFFContainer, "Routes patron traffic", "HTTP")
Rel(APIGatewayIngress, StaffWorkflowContainer, "Routes staff traffic", "HTTP")
Rel(PatronBFFContainer, CatalogueSearchServiceContainer, "Queries catalogue and search", "gRPC over mTLS")
Rel(StaffWorkflowContainer, CatalogueSearchServiceContainer, "Queries catalogue and search", "gRPC over mTLS")
Rel(CirculationLoanServiceContainer, PostgreSQL, "Queries relational data", "JDBC")
Rel(NotificationDispatcherContainer, ExternalNotificationService, "Integrates to send notifications", "HTTPS / REST")

@enduml