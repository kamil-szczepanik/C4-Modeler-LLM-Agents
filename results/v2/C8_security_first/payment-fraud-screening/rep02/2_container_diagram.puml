@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Real-Time Payment Fraud Screening System

Person(FraudAnalystRiskManager, "Fraud Analyst & Risk Manager", "Evaluates suspicious transactions and manages fraud cases.")

System_Ext(PaymentGatewayAcquirer, "Payment Gateway / Acquirer", "Sends card-not-present payment authorizations for fraud screening.")
System_Ext(PaymentNetworkCardBrands, "Payment Network / Card Brands", "Interacts with the payment ecosystem and transaction flow.")
System_Ext(CoreLedger, "Core Ledger", "Receives immutable audit records for retention.")

System_Boundary(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System") {
    Container(AWSAPIGateway, "AWS API Gateway", "AWS API Gateway (Ingress/TLS Termination)", "Provides ingress and TLS termination for incoming requests.")
    Container(GoScoringEngine, "Go Scoring Engine", "Go (Golang), AWS ECS on Fargate", "High-performance scoring engine for real-time fraud detection.")
    Container(NodejsCaseManagement, "Node.js Case Management", "Node.js (TypeScript), AWS ECS on Fargate", "Provides rapid development framework for the case management API.")
    Container(AmazonSQSEventBridge, "Amazon SQS / EventBridge", "Amazon SQS / EventBridge", "Handles asynchronous audit stream.")
    Container(AmazonAuroraPostgreSQLServerlessv2, "Amazon Aurora PostgreSQL Serverless v2", "Amazon Aurora PostgreSQL Serverless v2", "Case state database.")
    Container(AWSQLDB, "AWS QLDB", "Amazon QLDB", "Cryptographic ledger ensuring tamper-evident audit retention.")
    Container(AWSCognitoAWSSecretsManager, "AWS Cognito & AWS Secrets Manager", "AWS Cognito, AWS Secrets Manager", "Handles authentication and secrets management.")
}

Rel(PaymentGatewayAcquirer, AWSAPIGateway, "Sends payment authorizations", "HTTPS (TLS 1.3)")
Rel(AWSAPIGateway, GoScoringEngine, "Routes scoring requests", "gRPC over mTLS")
Rel(GoScoringEngine, AmazonSQSEventBridge, "Publishes asynchronous audit stream", "AWS SDK")
Rel(AmazonSQSEventBridge, AWSQLDB, "Stores tamper-evident audit logs", "AWS SDK / API")
Rel(FraudAnalystRiskManager, NodejsCaseManagement, "Manages suspicious transactions and cases", "HTTPS (OAuth2/OIDC via AWS Cognito)")
Rel(NodejsCaseManagement, AmazonAuroraPostgreSQLServerlessv2, "Reads and writes case state", "TLS")

@enduml