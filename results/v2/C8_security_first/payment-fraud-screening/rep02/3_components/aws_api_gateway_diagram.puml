@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS API Gateway container

Container_Boundary(aws_api_gateway, "AWS API Gateway") {
    Component(Edge_Router__WAF_Integrator, "Edge Router & WAF Integrator", "AWS API Gateway Component", "Handles native edge routing and WAF integration for low latency and DDoS protection.")
    Component(Request_Validator__Sanitizer, "Request Validator & Sanitizer", "AWS API Gateway Component", "Validates and sanitizes incoming payment authorization requests.")
    Component(Upstream_Router, "Upstream Router", "AWS API Gateway Component", "Routes requests to internal services such as the Go Scoring Engine and Node.js Case Management.")
}

Rel(Edge_Router__WAF_Integrator, Request_Validator__Sanitizer, "Passes incoming traffic for validation")
Rel(Request_Validator__Sanitizer, Upstream_Router, "Passes sanitized requests for routing")
@enduml