@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(node_js_case_management, "Node.js Case Management") {
    Component(api_router_controller, "API Router / Controller", "Express/Fastify", "Handles incoming HTTPS requests from fraud analysts and routes them to internal services.")
    Component(case_workflow_service, "Case Workflow Service", "Node.js/TypeScript", "Manages the business logic and workflow states for case reviews.")
    Component(audit_compliance_logger, "Audit & Compliance Logger", "Node.js/TypeScript", "Collects audit data and emits events for compliance.")
    Component(data_access_repository, "Data Access Repository", "Prisma/TypeORM", "Handles reads and writes to the database with parameterization.")
    Component(decision_feedback_publisher, "Decision Feedback Publisher", "Node.js/TypeScript", "Dispatches decision feedback events upon case resolution.")
}

Rel(api_router_controller, case_workflow_service, "In-process function calls")
Rel(case_workflow_service, data_access_repository, "In-process calls")
Rel(case_workflow_service, audit_compliance_logger, "Asynchronous event emission")
Rel(case_workflow_service, decision_feedback_publisher, "In-process event dispatch upon resolution")

@enduml