@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Amazon SQS / EventBridge", "Amazon SQS / EventBridge") {
    Component(Amazon EventBridge Bus, "Amazon EventBridge Bus", "Amazon EventBridge (`fraud-events-bus`)", "Publishes scoring decisions and audit streams in real-time.")
    Component(Amazon SQS Queue, "Amazon SQS Queue", "Amazon SQS Queue (`audit-queue`)", "Queues audit streams for asynchronous processing with Dead-Letter Queue (DLQ) support.")
}

Rel(Amazon EventBridge Bus, Amazon SQS Queue, "Routes audit messages to the queue", "")

@enduml