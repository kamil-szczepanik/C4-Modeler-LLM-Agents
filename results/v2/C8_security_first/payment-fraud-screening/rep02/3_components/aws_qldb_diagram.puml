@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_qldb, "AWS QLDB") {
    Component(LedgerCore, "Ledger Core", "Amazon QLDB", "Provides native cryptographic immutability and tamper-evident audit trails for PCI-DSS compliance.")
    Component(AuditIngestionService, "Audit Ingestion Service", "AWS Lambda (Python)", "Consumes audit payloads asynchronously and writes tamper-evident audit logs using PartQL.")
    Component(VerificationExportWorker, "Verification & Export Worker", "AWS Lambda (Python)", "Executes cryptographic digest verifications and exports periodic cryptographic proofs to Amazon S3.")
}

Rel(AuditIngestionService, LedgerCore, "Writes tamper-evident audit logs using PartQL", "AWS SDK / HTTPS")
Rel(VerificationExportWorker, LedgerCore, "Executes cryptographic digest verifications", "AWS SDK / HTTPS")

@enduml