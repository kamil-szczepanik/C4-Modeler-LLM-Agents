@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Amazon Aurora PostgreSQL Serverless v2", "Amazon Aurora PostgreSQL Serverless v2") {
    Component(CaseStateRepository, "Case State Repository", "PostgreSQL", "Manages read and write operations for case state data with Row Level Security (RLS).")
    Component(AuditAndComplianceStorage, "Audit and Compliance Storage", "PostgreSQL Schema", "Maintains relational data structures supporting compliance requirements.")
}

Rel(CaseStateRepository, AuditAndComplianceStorage, "Persists transactional state updates", "PostgreSQL wire protocol over TLS 1.3 with IAM Auth")

@enduml