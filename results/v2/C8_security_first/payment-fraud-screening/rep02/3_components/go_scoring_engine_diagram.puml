@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(aws_api_gateway_nlb, "AWS API Gateway & NLB", "External gateway and network load balancer")
System_Ext(amazon_elasticache_redis_oss, "Amazon ElastiCache (Redis OSS)", "Shared feature state caching")
System_Ext(aws_kms, "AWS KMS", "Cryptographic signing for auditability")
System_Ext(amazon_sqs_eventbridge, "Amazon SQS / EventBridge", "Event publishing")

Container_Boundary(go_scoring_engine, "Go Scoring Engine") {
    Component(http_grpc_ingress_handler, "HTTP/gRPC Ingress Handler", "Go HTTP/gRPC Server", "Handles incoming payment authorizations and routes requests under strict latency constraints.")
    Component(feature_extractor_component, "Feature Extractor Component", "Go Feature Extraction Logic", "Extracts and aggregates features required for real-time fraud scoring.")
    Component(scoring_evaluation_core, "Scoring & Evaluation Core", "Go Evaluation Engine", "Processes payment authorizations to return approve, decline, or review decisions.")
    Component(rule_engine_hot_reloader_component, "Rule Engine Hot-Reloader Component", "Go Dynamic Loader", "Dynamically reloads fraud rules without restarting the engine.")
    Component(audit_signer_component, "Audit Signer Component", "Go Cryptographic Signer", "Provides cryptographic signing for tamper-evident auditability.")
    Component(memory_sanitizer_middleware, "Memory Sanitizer Middleware", "Go Memory Middleware", "Sanitizes memory to ensure compliance and security.")
}

Rel(aws_api_gateway_nlb, http_grpc_ingress_handler, "gRPC over mTLS", "gRPC/mTLS")
Rel(feature_extractor_component, amazon_elasticache_redis_oss, "TCP", "TCP")
Rel(audit_signer_component, aws_kms, "AWS SDK", "HTTPS")
Rel(http_grpc_ingress_handler, amazon_sqs_eventbridge, "AWS SDK", "HTTPS")
@enduml