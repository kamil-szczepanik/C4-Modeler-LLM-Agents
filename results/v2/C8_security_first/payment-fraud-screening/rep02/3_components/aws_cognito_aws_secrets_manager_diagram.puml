@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS Cognito & AWS Secrets Manager container

Container_Boundary(aws_cognito_secrets_manager, "AWS Cognito & AWS Secrets Manager") {
    Component(AWS_Cognito_User_Pool_Identity_Pool, "AWS Cognito User Pool & Identity Pool", "AWS Cognito", "Manages user authentication, federation, MFA, and 15-minute JWT generation without custom blocklist infrastructure.")
    Component(Secrets_Vault, "Secrets Vault", "AWS Secrets Manager", "Secures database credentials and keys with Terraform-managed rotation and in-memory SDK caching for low latency.")
}

System_Ext(AWS_KMS, "AWS KMS", "Key Management Service")

Rel(Secrets_Vault, AWS_KMS, "HTTPS for encrypted storage using Customer Managed Keys (CMKs)", "HTTPS")

@enduml