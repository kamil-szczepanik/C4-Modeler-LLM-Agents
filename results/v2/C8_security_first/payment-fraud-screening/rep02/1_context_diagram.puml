@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalyst, "Fraud Analyst & Risk Manager", "Evaluates suspicious transactions and manages fraud cases using the system.")

System_Ext(PaymentGateway, "Payment Gateway / Acquirer", "Sends card-not-present payment authorizations for fraud screening.")
System_Ext(PaymentNetwork, "Payment Network / Card Brands (Visa/Mastercard)", "Interacts with the payment ecosystem and transaction flow.")
System_Ext(CoreLedger, "Core Ledger / Compliance Archive", "Receives immutable audit records for 7-year retention.")

System(FraudScreeningSystem, "Real-Time Payment Fraud Screening System", "Evaluates card-not-present payment authorizations for fraud before approval and provides case management for suspicious transactions, delivering sub-50ms fraud decisions at 3,000 TPS while maintaining PCI-DSS Level 1 compliance and 7-year auditability.")

Rel(PaymentGateway, FraudScreeningSystem, "Evaluates payment authorizations for fraud", "gRPC/REST over mTLS")
Rel(FraudAnalyst, FraudScreeningSystem, "Manages suspicious transactions and cases", "HTTPS and OAuth 2.0 / OIDC")
Rel(FraudScreeningSystem, CoreLedger, "Stores tamper-evident 7-year audit retention data", "AWS S3 Object Lock / QLDB")

@enduml