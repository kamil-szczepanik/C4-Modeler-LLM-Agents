@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_sqs_audit_queue, "Amazon SQS (Audit Queue)") {
    Component(audit_events_queue, "audit-events-queue", "Amazon SQS", "Primary asynchronous buffer for audit payloads operating at 3000 TPS.")
    Component(audit_events_dlq, "audit-events-dlq", "Amazon SQS Dead Letter Queue", "Captures failed audit payload ingestion events for error analysis.")
}

Rel(audit_events_queue, audit_events_dlq, "Routes unprocessable messages after maximum retries")
@startuml