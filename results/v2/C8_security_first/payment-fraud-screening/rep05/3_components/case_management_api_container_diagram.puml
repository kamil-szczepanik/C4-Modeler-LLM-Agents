@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(FraudAnalystSPA, "Fraud Analyst SPA", "Single Page Application used by fraud analysts.")
System_Ext(AWSQLDB, "AWS QLDB", "Tamper-evident ledger storage.")
System_Ext(AmazonSQSAuditQueue, "Amazon SQS (Audit Queue)", "Asynchronous messaging for audit trails.")
System_Ext(AWSKMSAWSSeccretsManager, "AWS KMS & AWS Secrets Manager", "Secure secrets loading and data encryption.")

Container_Boundary(CaseManagementAPIContainer, "Case Management API Container") {
    Component(CaseControllerComponent, "Case Controller Component", "Node.js / TypeScript, Express/Fastify", "Handles REST/JSON endpoints for fraud analyst reviews and investigations.")
    Component(DataMaskingMiddlewareComponent, "Data Masking Middleware Component", "Node.js / TypeScript Middleware", "Enforces strict data masking to ensure PCI-DSS Level 1 compliance.")
    Component(AuditEventPublisherComponent, "Audit & Event Publisher Component", "Node.js / TypeScript, AWS SDK", "Publishes cryptographically signed audit trails and events.")
    Component(CaseRepositoryComponent, "Case Repository Component", "Node.js / TypeScript, AWS SDK", "Manages persistence and interaction with tamper-evident ledger storage.")
    Component(BatchActionWorkflowEngineComponent, "Batch Action & Workflow Engine Component", "Node.js / TypeScript", "Processes in-memory event emissions for batch actions and case workflows.")
}

Rel(FraudAnalystSPA, CaseControllerComponent, "REST/JSON over HTTPS via TLS 1.3", "HTTPS/JSON")
Rel(CaseControllerComponent, DataMaskingMiddlewareComponent, "Middleware intercept", "")
Rel(CaseControllerComponent, BatchActionWorkflowEngineComponent, "In-memory event emission", "")
Rel(CaseRepositoryComponent, AWSQLDB, "AWS SDK over TLS", "AWS SDK / TLS")
Rel(AuditEventPublisherComponent, AmazonSQSAuditQueue, "AWS SDK over TLS", "AWS SDK / TLS")
Rel(CaseManagementAPIContainer, AWSKMSAWSSeccretsManager, "AWS IAM / TLS", "AWS IAM / TLS")

@enduml