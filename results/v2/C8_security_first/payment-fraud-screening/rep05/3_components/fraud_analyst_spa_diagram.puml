@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Fraud Analyst SPA container

Container_Boundary(fraud_analyst_spa, "Fraud Analyst SPA") {
    Component(React_SPA_UI, "React SPA UI", "React SPA via AWS CloudFront & S3", "Provides the user interface for fraud analysts and risk managers to evaluate authorizations and manage cases.")
    Component(Authentication_Client, "Authentication Client", "OIDC/PKCE with AWS Cognito/Okta", "Handles secure user authentication and short-lived memory-only token management.")
}

System_Ext(Case_Management_API_Container, "Case Management API Container", "Node.js/Python microservice container")

Rel(React_SPA_UI, Authentication_Client, "Authenticates users", "OIDC/PKCE")
Rel(React_SPA_UI, Case_Management_API_Container, "Case workflows and batch actions", "REST/JSON over HTTPS")

@enduml