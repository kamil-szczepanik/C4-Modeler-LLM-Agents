@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_api_gateway_and_internal_network_load_balancer_nlb, "AWS API Gateway & Internal Network Load Balancer (NLB)") {
    Component(AWS_Network_Load_Balancer_NLB, "AWS Network Load Balancer (NLB)", "AWS NLB", "Ingests raw payment authorizations via TCP/TLS 1.3 and routes payloads to the scoring engine.")
    Component(AWS_API_Gateway_HTTP_API, "AWS API Gateway (HTTP API)", "AWS API Gateway", "Accepts management actions from the Fraud Analyst SPA and forwards authenticated HTTPS/REST traffic.")
}

Rel(AWS_Network_Load_Balancer_NLB, Scoring_Engine_Container, "Routes raw payloads using TCP over TLS 1.3 with mTLS", "TCP/TLS")
Rel(AWS_API_Gateway_HTTP_API, Case_Management_API_Container, "Forwards authenticated traffic via HTTPS/REST", "HTTPS/REST")
@enduml