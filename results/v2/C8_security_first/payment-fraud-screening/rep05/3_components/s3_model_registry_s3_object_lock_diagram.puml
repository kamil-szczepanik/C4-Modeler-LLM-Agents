@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("S3 Model Registry & S3 Object Lock", "S3 Model Registry & S3 Object Lock") {
    Component("ModelRepositoryBucket", "Model Repository Bucket", "Amazon S3", "Stores machine learning models and artifacts with versioning enabled.")
    Component("ObjectLockManager", "Object Lock Manager", "AWS S3 Object Lock (Compliance Mode)", "Enforces immutable 7-year retention to prevent tampering and ensure compliance.")
}

Rel("ModelRepositoryBucket", "ObjectLockManager", "Applies compliance-mode retention policies to stored model artifacts", "")

@enduml