@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component Diagram for AWS KMS & AWS Secrets Manager

Container_Boundary(aws_kms_secrets_manager, "AWS KMS & AWS Secrets Manager") {
    Component(kms_component, "Key Management Service (KMS) Component", "AWS KMS", "Manages customer-managed CMKs with annual rotation for envelope encryption.")
    Component(secrets_manager_component, "Secrets Manager Component", "AWS Secrets Manager", "Manages encrypted database credentials with 30-day automated rotation.")
}

System_Ext(scoring_engine_container, "Scoring Engine Container", "Requests Data Keys via local in-memory cache [AWS IAM, AWS PrivateLink, TLS 1.3]")
System_Ext(case_management_api_container, "Case Management API Container", "Fetches and temporarily caches database credentials [AWS IAM, AWS PrivateLink, TLS 1.3]")
System_Ext(aws_lambda, "AWS Lambda", "Executes automated secret rotation via native built-in templates")

Rel(scoring_engine_container, kms_component, "Requests Data Keys via local in-memory cache", "AWS IAM, AWS PrivateLink, TLS 1.3")
Rel(case_management_api_container, secrets_manager_component, "Fetches and temporarily caches database credentials", "AWS IAM, AWS PrivateLink, TLS 1.3")
Rel(secrets_manager_component, aws_lambda, "Triggers automated credential rotation", "AWS Internal")

@enduml