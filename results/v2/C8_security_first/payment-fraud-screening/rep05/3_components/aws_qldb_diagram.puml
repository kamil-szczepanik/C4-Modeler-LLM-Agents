@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS QLDB container

Container_Boundary(aws_qldb_container, "AWS QLDB") {
    Component(Immutable_Ledger, "Immutable Ledger", "AWS QLDB", "Provides tamper-evident compliance records and maintains auditable decision histories for 7-year regulatory compliance.")
    Component(Journal_S3_Export_Bucket, "Journal S3 Export Bucket", "AWS S3 with S3 Object Lock", "Stores long-term archival data using Compliance Mode for cost-effective 7-year data archiving.")
}

Rel(Immutable_Ledger, Journal_S3_Export_Bucket, "Exports historical journal blocks", "ExportJournalToS3 [S3 API]")

@enduml