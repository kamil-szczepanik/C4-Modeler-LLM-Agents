@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Real-Time Payment Fraud Screening System

Person(FraudAnalysts_RiskManagers, "Fraud Analysts & Risk Managers", "Users who interact with the system using case management tools for fraud analysis.")
System_Ext(PaymentGateway, "Payment Gateway", "Upstream system that submits card-not-present payment authorizations for fraud screening.")

System_Boundary(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System") {
    Container(AWSAPIGatewayInternalNetworkLoadBalancerNLB, "AWS API Gateway & Internal Network Load Balancer (NLB)", "AWS API Gateway / NLB", "Ingresses and routes traffic from the payment gateway to internal services.")
    Container(ScoringEngineContainer, "Scoring Engine Container", "Rust or Go", "Provides automated fraud scoring with <50ms P99 latency.")
    Container(CaseManagementAPIContainer, "Case Management API Container", "Node.js or Python", "Handles case management logic for fraud analysts.")
    Container(FraudAnalystSPA, "Fraud Analyst SPA", "Single Page Application", "Provides the user interface for fraud analysts to manage cases.")
    Container(S3ModelRegistryS3ObjectLock, "S3 Model Registry & S3 Object Lock", "AWS S3", "Stores fraud models and ensures 7-year tamper-evident retention.")
    Container(AmazonSQSAuditQueue, "Amazon SQS (Audit Queue)", "Amazon SQS", "Asynchronously buffers audit events for compliance logging.")
    Container(AWSQLDB, "AWS QLDB", "AWS QLDB", "Quantum Ledger Database persisting tamper-evident compliance records.")
    Container(AWSKMSAWSSecretsManager, "AWS KMS & AWS Secrets Manager", "AWS KMS / Secrets Manager", "Manages encryption keys and application secrets.")
}

Rel(PaymentGateway, AWSAPIGatewayInternalNetworkLoadBalancerNLB, "Interacts for payment authorization screening", "HTTPS/TLS 1.3")
Rel(AWSAPIGatewayInternalNetworkLoadBalancerNLB, ScoringEngineContainer, "Receives payloads and routes traffic", "gRPC")
Rel(FraudAnalystSPA, CaseManagementAPIContainer, "Communicates for case workflows and management", "REST/JSON over HTTPS")
Rel(FraudAnalysts_RiskManagers, FraudAnalystSPA, "Accesses user interface for fraud analysis", "HTTPS")
Rel(ScoringEngineContainer, AmazonSQSAuditQueue, "Pushes audit events asynchronously", "AWS SDK / SQS")
Rel(AmazonSQSAuditQueue, AWSQLDB, "Persists tamper-evident records via triggers", "SQS Triggers")
Rel(ScoringEngineContainer, S3ModelRegistryS3ObjectLock, "Retrieves fraud scoring models", "AWS S3 API")
Rel(CaseManagementAPIContainer, AWSKMSAWSSecretsManager, "Retrieves secrets and encryption configuration", "AWS IAM / TLS")
Rel(ScoringEngineContainer, AWSKMSAWSSecretsManager, "Retrieves secrets and encryption configuration", "AWS IAM / TLS")

@enduml