@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Fraud_Analysts_Risk_Managers, "Fraud Analysts & Risk Managers", "Users who interact with the system using case management tools for fraud analysis.")
System_Ext(Payment_Gateway, "Payment Gateway", "Upstream system that submits card-not-present payment authorizations for fraud screening.")
System_Ext(Identity_Provider_AWS_Cognito_Okta, "Identity Provider (AWS Cognito/Okta)", "Handles authentication and OAuth2/OIDC enforcement.")
System_Ext(AWS_ECS_Fargate, "AWS ECS Fargate", "Container orchestration platform for predictable low-latency scaling.")
System_Ext(AWS_QLDB_and_S3_Object_Lock, "AWS QLDB and S3 Object Lock", "Tamper-evident, append-only data stores for audit compliance.")
System_Ext(AWS_KMS, "AWS KMS", "Provides AES-256 encryption at rest.")

System(Real_Time_Payment_Fraud_Screening_System, "Real-Time Payment Fraud Screening System", "Screens card-not-present payment authorizations in the AWS eu-west-1 region, enabling automated fraud scoring and providing case management tools for fraud analysts.")

Rel(Payment_Gateway, Real_Time_Payment_Fraud_Screening_System, "Interacts for payment authorization screening", "mTLS and gRPC")
Rel(Fraud_Analysts_Risk_Managers, Real_Time_Payment_Fraud_Screening_System, "Accesses case management tools", "HTTPS, TLS 1.3, OAuth2/OIDC")
Rel(Real_Time_Payment_Fraud_Screening_System, Identity_Provider_AWS_Cognito_Okta, "Authenticates users and enforces security", "OAuth2/OIDC")
Rel(Real_Time_Payment_Fraud_Screening_System, AWS_ECS_Fargate, "Runs containerized workloads", "AWS ECS")
Rel(Real_Time_Payment_Fraud_Screening_System, AWS_QLDB_and_S3_Object_Lock, "Stores audit and transaction data", "AWS IAM and TLS")
Rel(Real_Time_Payment_Fraud_Screening_System, AWS_KMS, "Encrypts data at rest", "AWS IAM and TLS")

@enduml