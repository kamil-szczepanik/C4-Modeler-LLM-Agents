@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Merchant_Payment_Gateway, "Merchant / Payment Gateway", "Upstream client system sending payment authorizations.")
Person(Fraud_Analyst, "Fraud Analyst", "Internal user managing reviews and rules.")
System(Fraud_Screening_Engine, "Fraud Screening Engine", "Real-time payment fraud screening system for card-not-present transactions on AWS, ensuring strict PCI-DSS compliance.")
System_Ext(Card_Schemes_External_Enrichment_APIs, "Card Schemes / External Enrichment APIs", "External risk data sources fetching auxiliary risk signals.")
System_Ext(AWS_QLDB_S3_Object_Lock, "AWS QLDB / S3 Object Lock", "Tamper-evident audit archive for WORM-compliant storage.")

Rel(Merchant_Payment_Gateway, Fraud_Screening_Engine, "Sends payment authorizations", "HTTPS/JSON over TLS 1.3 / mTLS")
Rel(Fraud_Analyst, Fraud_Screening_Engine, "Accesses case management", "HTTPS with RBAC and MFA")
Rel(Fraud_Screening_Engine, Card_Schemes_External_Enrichment_APIs, "Fetches auxiliary risk signals", "HTTPS")
Rel(Fraud_Screening_Engine, AWS_QLDB_S3_Object_Lock, "Asynchronously writes audit logs and decision metadata", "AWS SDK / API")

@enduml