@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Real-Time Scoring Engine container

Container_Boundary(real_time_scoring_engine_container, "Real-Time Scoring Engine") {
    Component(api_gateway_tokenization_proxy, "API Gateway / Tokenization Proxy", "Envoy / AWS API Gateway", "Routes requests for scoring using gRPC over AWS VPC private subnets with mTLS.")
    Component(real_time_scoring_engine, "Real-Time Scoring Engine", "Go / AWS ECS on Fargate, Redis", "Evaluates card-not-present payment authorizations for fraud within strict latency constraints.")
    Component(rule_model_distribution_service, "Rule & Model Distribution Service", "Python / FastAPI + S3", "Delivers rules and models via S3 with cryptographic verification.")
    Component(event_broker, "Event Broker", "AWS MSK / Managed Kafka", "Publishes cryptographically signed scoring events using Kafka protocol over TLS with SASL/IAM.")
}

Component(fraud_analyst, "Fraud Analyst", "Human / Case Management Tools", "Reviews cases and manages fraud analysis workflows.")
Component(redis_cluster, "Redis Cluster", "Redis", "Provides high-throughput, in-memory state management for velocity checks.")

Rel(api_gateway_tokenization_proxy, real_time_scoring_engine, "Routes requests for scoring", "gRPC / mTLS")
Rel(real_time_scoring_engine, redis_cluster, "Fetches sliding-window velocity counters", "Redis RESP / TLS")
Rel(real_time_scoring_engine, event_broker, "Publishes cryptographically signed scoring events", "Kafka / TLS / SASL/IAM")
Rel(rule_model_distribution_service, real_time_scoring_engine, "Delivers rules and models", "S3 / HTTPS")

@enduml