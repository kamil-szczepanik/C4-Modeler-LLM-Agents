@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(Audit_Log_Sitter, "Audit Log Sitter") {
    Component(Kafka_Consumer_Component, "Kafka Consumer Component", "Rust, rdkafka", "Consumes real-time payment audit events from AWS MSK.")
    Component(Payload_Normalizer_Signer_Component, "Payload Normalizer & Signer Component", "Rust, AWS KMS", "Normalizes audit payloads and cryptographically signs them using AWS KMS.")
    Component(WORM_Storage_Batcher_Component, "WORM Storage Batcher Component", "Rust", "Batches normalized and signed payloads for persistent WORM storage.")
    Component(Resilience_DLQ_Router_Component, "Resilience & DLQ Router Component", "Rust, In-memory channel", "Handles failed or poisoned payloads and routes them to a Dead-Letter Queue.")
}

Rel(Kafka_Consumer_Component, Resilience_DLQ_Router_Component, "Passes failed/poisoned payloads", "In-memory channel")
Rel(Payload_Normalizer_Signer_Component, WORM_Storage_Batcher_Component, "Passes normalized signed payloads", "In-memory channel")

@enduml