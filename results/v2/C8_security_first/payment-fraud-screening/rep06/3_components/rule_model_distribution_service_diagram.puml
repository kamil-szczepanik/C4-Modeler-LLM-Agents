@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("RuleModelDistributionService", "Rule & Model Distribution Service") {
    Component("ModelIngestionAPI", "Model Ingestion API", "Python / FastAPI + Pydantic", "Handles model ingestion, validation, and dry-run execution for updates.")
    Component("DistributionPublisher", "Distribution Publisher", "AWS SQS", "Publishes update notifications and rule hashes to the scoring engines.")
    Component("ArtifactStorageClient", "Artifact Storage Client", "AWS S3", "Fetches and stores versioned rules and machine learning models securely.")
}

Rel("ModelIngestionAPI", "ArtifactStorageClient", "Saves validated models and rules", "HTTPS")
Rel("ModelIngestionAPI", "DistributionPublisher", "Triggers update notifications", "AWS SQS")

@enduml