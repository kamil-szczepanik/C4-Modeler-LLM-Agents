@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway / Tokenization Proxy container

Container_Boundary(api_gateway_tokenization_proxy_container, "API Gateway / Tokenization Proxy") {
    Component(Edge_Router_Component, "Edge Router Component", "Envoy Proxy", "Manages incoming traffic routing and TLS termination at the edge.")
    Component(Tokenization_Filter_Component, "Tokenization Filter Component", "Native Envoy C++/Lua configuration with Format-Preserving Encryption", "Performs low-latency stateless PAN tokenization without expensive HSM round-trips.")
    Component(Payload_Sanitizer_Component, "Payload Sanitizer Component", "Envoy Proxy filter", "Sanitizes and validates incoming payment authorization payloads.")
}

Rel(Edge_Router_Component, Payload_Sanitizer_Component, "Forwards traffic for payload validation")
Rel(Payload_Sanitizer_Component, Tokenization_Filter_Component, "Sends sanitized data for tokenization")

@enduml