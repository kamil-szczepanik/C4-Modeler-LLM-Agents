@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component Diagram for Case Management API Container

Container_Boundary(case_management_api, "Case Management API") {
    Component(Case Management Controller, "Case Management Controller", "Java 21 / Spring Boot 3.x", "Exposes HTTPS endpoints for Fraud Analysts and Compliance Auditors to access case management workflows, bulk actions, and metrics.")
    Component(Case Service, "Case Service", "Java 21 / Spring Boot 3.x", "Encapsulates business logic for case states, SLA tracking, and audit data management.")
    Component(Batch Processor, "Batch Processor", "Spring Batch", "Handles parallelized batch state transitions for bulk case operations.")
    Component(Event Consumer, "Event Consumer", "Java 21 / Spring Boot 3.x / Kafka Client", "Streams review events and case data from the Event Broker via mTLS.")
    Component(Persistence Repository, "Persistence Repository", "Spring Data JPA / JDBC", "Persists case states, SLA tracking, and audit data to AWS RDS PostgreSQL via TLS 1.3.")
    Component(Audit Dispatcher, "Audit Dispatcher", "Java 21 / Spring Boot 3.x", "Sends cryptographically signed action records to the Audit Log Sitter via TCP/TLS [mTLS].")
}

Rel(Case Management Controller, Case Service, "Invokes business logic and workflows")
Rel(Case Service, Batch Processor, "Triggers parallelized bulk actions")
Rel(Event Consumer, Case Service, "Updates case data from streamed events")
Rel(Case Service, Persistence Repository, "Persists case states and SLA data")
Rel(Case Service, Audit Dispatcher, "Dispatches action records for audit logging")

@enduml