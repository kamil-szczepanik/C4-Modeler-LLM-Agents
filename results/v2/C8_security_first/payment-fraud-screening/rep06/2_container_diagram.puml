@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Fraud Screening Engine

Person(MerchantPaymentGateway, "Merchant / Payment Gateway", "Upstream client system sending payment authorizations.")
Person(FraudAnalyst, "Fraud Analyst", "Internal user managing reviews and rules.")
Person(MerchantRiskManager, "Merchant Risk Manager", "Internal user managing risk configuration and rules.")
Person(ComplianceAuditor, "Compliance Auditor", "Internal user reviewing compliance and tamper-evident audit logs.")

System_Ext(CardSchemesExternalEnrichmentAPIs, "Card Schemes / External Enrichment APIs", "External risk data sources fetching auxiliary risk signals.")
System_Ext(AWSQLDBS3ObjectLock, "AWS QLDB / S3 Object Lock", "Tamper-evident audit archive for WORM-compliant storage.")

System_Boundary(FraudScreeningEngine, "Fraud Screening Engine") {
    Container(APIGatewayTokenizationProxy, "API Gateway / Tokenization Proxy", "Envoy / AWS API Gateway", "Handles incoming authorization requests and tokenization securely.")
    Container(RealTimeScoringEngine, "Real-Time Scoring Engine", "Go / AWS ECS on Fargate, Redis", "Executes real-time fraud scoring and risk evaluation within strict latency constraints.")
    Container(CaseManagementAPI, "Case Management API", "Node.js / Java Spring Boot", "Manages suspicious payment reviews, fraud analyst workflows, and case investigation data.")
    Container(AuditLogSitter, "Audit Log Sitter", "Rust", "Collects and securely routes audit logs to immutable storage.")
    Container(RuleModelDistributionService, "Rule & Model Distribution Service", "Python / FastAPI + S3", "Distributes fraud detection models and rule updates to scoring engines.")
    Container(EventBroker, "Event Broker", "AWS MSK / Managed Kafka or AWS SQS", "Decouples asynchronous events between system services.")
}

Rel(MerchantPaymentGateway, APIGatewayTokenizationProxy, "Sends payment authorizations", "HTTPS (TLS 1.3)")
Rel(APIGatewayTokenizationProxy, RealTimeScoringEngine, "Routes requests for scoring", "gRPC over AWS VPC private subnets with native TLS")
Rel(RealTimeScoringEngine, EventBroker, "Publishes scoring events and telemetry", "TCP/TLS")
Rel(EventBroker, AuditLogSitter, "Streams events for audit logging", "TCP/TLS")
Rel(EventBroker, CaseManagementAPI, "Streams events for case creation and review", "TCP/TLS")
Rel(FraudAnalyst, CaseManagementAPI, "Accesses case management workflows", "HTTPS (OAuth2/OIDC, MFA)")
Rel(ComplianceAuditor, CaseManagementAPI, "Accesses audit and compliance records", "HTTPS (OAuth2/OIDC, MFA)")

@enduml