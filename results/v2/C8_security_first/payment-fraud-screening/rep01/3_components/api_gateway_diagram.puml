@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Ingress_and_TLS_Termination_Controller, "Ingress and TLS Termination Controller", "AWS API Gateway (HTTP APIs)", "Manages ingress, TLS termination, and mTLS verification for external payment gateways.")
    Component(Path_Segregation_Router, "Path Segregation Router", "AWS API Gateway Routing Rules", "Routes authorization scoring requests to the scoring engine and analyst requests to the case management container.")
    Component(Audit_Logging_Publisher, "Audit Logging Publisher", "AWS API Gateway Native Integration", "Streams compressed access logs to Amazon Kinesis Data Firehose for auditability.")
}

Rel(Ingress_and_TLS_Termination_Controller, Path_Segregation_Router, "Forwards authenticated and terminated HTTP requests")
Rel(Path_Segregation_Router, Audit_Logging_Publisher, "Triggers log emission for all processed traffic")

@enduml