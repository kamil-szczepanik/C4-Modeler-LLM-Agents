@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon Athena & S3 Data Lake container

Container_Boundary(athena_s3_data_lake, "Amazon Athena & S3 Data Lake") {
    Component(AmazonKinesisDataFirehose, "Amazon Kinesis Data Firehose", "Amazon Kinesis Data Firehose", "Ingests transaction logs and batch-writes logs in Apache Parquet format.")
    ComponentDb(AmazonS3DataLakeStorage, "Amazon S3 Data Lake Storage", "Amazon S3 (Raw and Curated Zones with S3 Object Lock)", "Provides immutable storage for compliance auditing, risk reporting, and fraud trend analysis with 7-year retention.")
    Component(AWSGlueDataCatalog, "AWS Glue Data Catalog", "AWS Glue Data Catalog", "Maintains schema definitions for analytical datasets.")
    Component(AmazonAthenaQueryEngine, "Amazon Athena Query Engine", "Amazon Athena", "Executes serverless, pay-per-query SQL for compliance audits and trend queries.")
    Component(AWSLakeFormation, "AWS Lake Formation", "AWS Lake Formation", "Enforces column-level data masking and fine-grained access control for PCI-DSS compliance.")
}

Component(ScoringEngineCaseManagementContainers, "Scoring Engine & Case Management Containers", "Containerized Applications", "External callers that ingest transaction logs into the data lake.")
Component(RiskManagersBITools, "Risk Managers & BI Tools", "Client Applications / BI Tools", "Users and tools executing compliance audits and trend queries.")

Rel(ScoringEngineCaseManagementContainers, AmazonKinesisDataFirehose, "Ingests transaction logs", "HTTPS / AWS SDK")
Rel(AmazonKinesisDataFirehose, AmazonS3DataLakeStorage, "Batch-writes logs in Apache Parquet format", "S3 API")
Rel(AWSGlueDataCatalog, AmazonS3DataLakeStorage, "Maintains schema definitions", "Internal AWS API")
Rel(AmazonAthenaQueryEngine, AWSGlueDataCatalog, "Reads metadata for query execution", "Internal AWS API")
Rel(RiskManagersBITools, AmazonAthenaQueryEngine, "Executes compliance audits and trend queries", "JDBC/ODBC / HTTPS")

@enduml