@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component Diagram for Amazon SQS / EventBridge

Container(scoring_engine, "Scoring Engine Container", "Go, ONNX runtime, Amazon ECS on AWS Fargate", "Scoring Engine Container")
Container(case_management, "Case Management Container", "Next.js / Node.js, Amazon ECS on AWS Fargate", "Case Management Container")
System_Ext(s3_datalake, "Amazon Athena & S3 Data Lake", "Amazon S3 / Athena")

Container_Boundary(sqs_eventbridge, "Amazon SQS / EventBridge") {
    Component(amazon_sqs_case_queue, "Amazon SQS Case Queue", "Amazon SQS (Standard/FIFO)", "Handles asynchronous, point-to-point case queuing with Dead Letter Queues to guarantee at-least-once delivery.")
    Component(eventbridge_audit_bus, "EventBridge Audit Bus", "Amazon EventBridge (Custom Event Bus with Archive and Replay)", "Manages fan-out event distribution and immutable 7-year audit logging via Archive and Replay.")
}

Rel(scoring_engine, amazon_sqs_case_queue, "SendMessage", "AWS SDK / HTTPS")
Rel(amazon_sqs_case_queue, case_management, "ReceiveMessage", "AWS SDK / HTTPS")
Rel(scoring_engine, eventbridge_audit_bus, "PutEvents", "AWS SDK / HTTPS")
Rel(eventbridge_audit_bus, s3_datalake, "Firehose / S3 Target", "AWS Native / HTTPS")

@enduml