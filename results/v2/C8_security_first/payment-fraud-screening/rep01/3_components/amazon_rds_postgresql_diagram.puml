@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_rds_postgresql, "Amazon RDS PostgreSQL") {
    Component(Cases_DB_Schema, "Cases DB Schema", "PostgreSQL Database Schema", "Stores case management data and audit logs for fraud analyst review.")
    Component(Audit_Log_Schema, "Audit Log Schema", "PostgreSQL Database Schema with pgaudit & Trigger-Based RLS", "Maintains immutable audit records supporting PCI-DSS compliance.")
    Component(PgBouncer___RDS_Proxy, "PgBouncer / RDS Proxy", "AWS RDS Proxy / PgBouncer", "Provides connection pooling to handle high-concurrency connection spikes and prevent backend exhaustion.")
}

Rel(PgBouncer___RDS_Proxy, Cases_DB_Schema, "Routes and pools database connections for case management", "SQL / TLS 1.3")
Rel(PgBouncer___RDS_Proxy, Audit_Log_Schema, "Routes and pools database connections for audit logging", "SQL / TLS 1.3")

@enduml