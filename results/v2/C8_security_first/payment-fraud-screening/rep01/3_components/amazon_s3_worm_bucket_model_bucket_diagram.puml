@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon S3 WORM Bucket & Model Bucket container

Container_Boundary(s3_container, "Amazon S3 WORM Bucket & Model Bucket") {
    Component(worm_storage, "WORM Object Storage", "Amazon S3 with WORM Object Lock & Versioning", "Provides secure, immutable storage meeting the 7-year audit requirement.")
    Component(model_bucket, "Model Bucket Storage", "Amazon S3", "Stores ONNX machine learning models retrieved by the Scoring Engine.")
}

System_Ext(scoring_engine, "Scoring Engine Container", "Go, ONNX runtime, Amazon ECS on AWS Fargate")
System_Ext(athena_datalake, "Amazon Athena & S3 Data Lake", "Analytics platform")

Rel(scoring_engine, model_bucket, "Loads ONNX models", "HTTPS (TLS 1.3), AWS IAM SigV4, VPC Gateway Endpoints")
Rel(athena_datalake, worm_storage, "Executes SQL queries for analytics", "SQL queries, HTTPS")

@enduml