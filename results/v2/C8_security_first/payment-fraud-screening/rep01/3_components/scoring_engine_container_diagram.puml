@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(scoring_engine_container, "Scoring Engine Container") {
    Component(api_router_component, "API Router Component", "Go (net/http)", "Handles gRPC-over-HTTP/2 requests and timeouts.")
    Component(feature_enrichment_component, "Feature Enrichment Component", "Go interface", "Fetches velocity features via AWS ElastiCache (Redis cache.t4g.micro).")
    Component(model_execution_engine, "Model Execution Engine", "Go struct / ONNX Runtime (C-Bindings)", "Evaluates transactions using concurrent double-buffered models.")
    Component(fallback_circuit_breaker_component, "Fallback & Circuit Breaker Component", "Go context", "Enforces R-07 availability constraints.")
    Component(audit_telemetry_dispatcher, "Audit & Telemetry Dispatcher", "Go asynchronous routines", "Asynchronously flushes tamper-evident audit logs.")
}

Rel(api_router_component, feature_enrichment_component, "Invokes feature lookup via Go interface")
Rel(feature_enrichment_component, model_execution_engine, "Passes enriched feature vector via Go struct")
Rel(model_execution_engine, fallback_circuit_breaker_component, "Intercepts timeouts and errors via Go context")

@enduml