@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(case_management_container, "Case Management Container") {
    Component(Case_Management_Frontend, "Case Management Frontend", "Static SPA on Amazon S3 and Amazon CloudFront", "Provides the user interface for fraud analysts and risk managers to manage cases and review alerts.")
    Component(Case_Management_Backend, "Case Management Backend", "Node.js API on Amazon ECS on Amazon Fargate", "Processes analyst requests, manages business logic, and coordinates data persistence and notifications.")
}

Rel(Case_Management_Frontend, Case_Management_Backend, "Invokes REST API", "HTTPS")

@enduml