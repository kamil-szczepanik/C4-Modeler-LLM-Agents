@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Real-Time Payment Fraud Screening Platform

Person(FraudAnalystRiskManager, "Fraud Analyst & Risk Manager", "Internal users reviewing cases and monitoring fraud metrics.")

System(RealTimePaymentFraudScreeningPlatform, "Real-Time Payment Fraud Screening Platform", "Screens card-not-present payment authorizations for fraud at 3,000 TPS while enabling analysts to review suspicious transactions, ensuring sub-50ms latency, PCI-DSS compliance, and a 7-year tamper-evident audit trail within a €25k monthly AWS budget.")

System_Ext(PaymentGatewayAcquirer, "Payment Gateway / Acquirer", "Upstream actor submitting authorization requests.")
System_Ext(CorporateIdentityChefIdP, "Corporate Identity Provider (IdP)", "Authenticates analysts via OIDC/SAML.")
System_Ext(CardTokenizationProvider, "Card Tokenization Provider", "External vault for PCI-DSS scope reduction.")
System_Ext(NotificationGateway, "Notification Gateway", "External SMS/Email service (Amazon SES/Twilio) for alerts.")

Rel(PaymentGatewayAcquirer, RealTimePaymentFraudScreeningPlatform, "Sends Authorization Requests", "gRPC/HTTPS via AWS PrivateLink and NLB")
Rel(FraudAnalystRiskManager, RealTimePaymentFraudScreeningPlatform, "Reviews cases and tunes rules", "HTTPS via ALB")
Rel(RealTimePaymentFraudScreeningPlatform, CorporateIdentityChefIdP, "Authenticates users", "OIDC/SAML")
Rel(RealTimePaymentFraudScreeningPlatform, NotificationGateway, "Sends operational alerts", "HTTPS")

@enduml