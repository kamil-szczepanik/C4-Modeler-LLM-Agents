@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management Container (Python / FastAPI) container

System_Ext(AWS_Application_Load_Balancer_ALB, "AWS Application Load Balancer (ALB)", "External system")
System_Ext(Amazon_Aurora_Serverless_v2, "Amazon Aurora Serverless v2", "External database system")
System_Ext(Model_Registry_Feature_Store, "Model Registry / Feature Store", "External system")

Container_Boundary(case_management_container, "Case Management Container (Python / FastAPI)") {
    Component(API_Routing_Layer, "API / Routing Layer", "FastAPI Routers", "Routes incoming requests and exposes API endpoints for fraud analysts.")
    Component(Authentication_RBAC_Middleware, "Authentication / RBAC Middleware", "Python Middleware", "Validates requests, ensures secure access control, and enforces PCI-DSS compliance.")
    Component(Business_Logic_Case_Service, "Business Logic / Case Service", "Python / FastAPI", "Handles case management workflows, business logic, and orchestrates state changes.")
    Component(Data_Access_Layer, "Data Access Layer", "SQLAlchemy ORM with asyncpg", "Manages database interactions and state persistence with Amazon Aurora Serverless v2.")
    Component(Event_Publisher_Webhook_Component, "Event Publisher / Webhook Component", "Python", "Dispatches model feedback loops and integrates with external systems.")
    Component(Audit_Logger_Sidecar_Container, "Audit Logger Sidecar Container", "structlog and AWS FireLens / Sidecar", "Dispatches tamper-evident audit events and structured JSON telemetry.")
}

Rel(AWS_Application_Load_Balancer_ALB, API_Routing_Layer, "Routes analyst traffic", "HTTPS")
Rel(API_Routing_Layer, Authentication_RBAC_Middleware, "Validates requests", "In-process Function Call")
Rel(Business_Logic_Case_Service, Amazon_Aurora_Serverless_v2, "Persists state changes", "SQL/TLS")
Rel(Business_Logic_Case_Service, Audit_Logger_Sidecar_Container, "Dispatches audit events", "gRPC/Local IPC")
Rel(Business_Logic_Case_Service, Event_Publisher_Webhook_Component, "Dispatches model feedback", "In-process Function Call")
Rel(Event_Publisher_Webhook_Component, Model_Registry_Feature_Store, "Forwards feedback loops", "HTTPS/TLS")
@enduml