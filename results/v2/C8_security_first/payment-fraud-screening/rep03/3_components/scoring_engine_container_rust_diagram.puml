@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Scoring Engine Container (Rust)", "Scoring Engine Container (Rust)") {
    Component(API Router, "API Router", "Rust, Axum, Tokio", "Routes incoming real-time scoring requests and handles API communication.")
    Component(Feature Aggregator, "Feature Aggregator", "Rust, Tokio", "Performs feature store lookups to gather necessary transaction data.")
    Component(Scoring Engine Core, "Scoring Engine Core", "Rust", "Evaluates transactions against scoring models to assess fraud risk.")
    Component(Model Manager, "Model Manager", "Rust", "Manages and fetches secure zero-downtime model updates.")
    Component(Audit Dispatcher, "Audit Dispatcher", "Rust", "Sends audit logs securely to the audit logger sidecar.")
}

Rel(API Router, Feature Aggregator, "Requests aggregated features for transaction evaluation")
Rel(Feature Aggregator, Scoring Engine Core, "Provides features to")
Rel(Scoring Engine Core, Model Manager, "Uses scoring models managed by")
Rel(Scoring Engine Core, Audit Dispatcher, "Dispatches audit logs for compliance")
@enduml