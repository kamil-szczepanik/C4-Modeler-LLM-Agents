@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_alb_ingress_router, "AWS Application Load Balancer (ALB) / Ingress Router") {
    Component(Path_Based_Routing_Engine, "Path-Based Routing Engine", "AWS ALB Native Routing", "Routes high-throughput real-time payment authorization traffic and low-volume fraud analyst workflows based on URL path.")
    Component(TLS_Termination_mTLS_Validator, "TLS Termination & mTLS Validator", "AWS Certificate Manager (ACM)", "Enforces strict TLS termination and validates client certificates for PCI-DSS Level 1 compliance.")
    Component(Web_Application_Firewall, "Web Application Firewall", "AWS WAF v2", "Enforces rate-limiting, DDoS protection, and OWASP Top 10 rule enforcement.")
}

Rel(Path_Based_Routing_Engine, Scoring_Target_Group_Scoring_Engine_Container_Rust, "Routes real-time scoring requests", "gRPC over internal TLS")
Rel(Path_Based_Routing_Engine, Case_Management_Target_Group_Case_Management_Container_Python, "Routes analyst traffic", "HTTPS (HTTP/1.1)")
Rel(TLS_Termination_mTLS_Validator, Path_Based_Routing_Engine, "Passes decrypted and authenticated requests", "")
Rel(Web_Application_Firewall, Path_Based_Routing_Engine, "Filters incoming HTTP/HTTPS requests", "")

@enduml