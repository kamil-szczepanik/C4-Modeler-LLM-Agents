@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_aurora_serverless_v2, "Amazon Aurora Serverless v2") {
    Component(Relational Database Engine, "Relational Database Engine", "PostgreSQL", "Stores and manages relational case data, fraud rules, and system state with automated multi-AZ high availability.")
    Component(Connection Pool & Security Manager, "Connection Pool & Security Manager", "PostgreSQL Extension / IAM Auth Handler", "Handles secure connections, TLS 1.3 encryption, and IAM-based authentication coming through the AWS RDS Proxy.")
}

Rel(Connection Pool & Security Manager, Relational Database Engine, "Routes authenticated queries and manages connection state", "")

@enduml