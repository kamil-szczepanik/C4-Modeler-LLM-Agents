@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Audit_Logger_Sidecar_Container, "Audit Logger Sidecar Container", "External system container sending audit logs.")

Container_Boundary("Amazon S3 with Object Lock", "Amazon S3 with Object Lock") {
    Component(Audit_Log_Collector, "Audit Log Collector", "AWS SDK / S3 API Client", "Receives immutable audit logs from the Audit Logger Sidecar Container via secure HTTPS.")
    Component(Object_Lock_Enforcement_Engine, "Object Lock Enforcement Engine", "AWS S3 Compliance Mode", "Enforces write-once-read-many (WORM) policies for tamper-evident 7-year retention storage.")
}

Rel(Audit_Logger_Sidecar_Container, Audit_Log_Collector, "Sends audit logs", "HTTPS / AWS SigV4 via VPC Gateway Endpoint")
Rel(Audit_Log_Collector, Object_Lock_Enforcement_Engine, "Applies 7-year retention compliance rules", "")

@enduml