@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_elasticache_redis, "Amazon ElastiCache (Redis)") {
    Component(In_Memory_Feature_Store_Cache, "In-Memory Feature Store Cache", "Amazon ElastiCache (Redis OSS v7.0+, cache.r6g.xlarge)", "Provides low-latency in-memory data storage for real-time feature lookups during fraud scoring.")
}

System_Ext(Scoring_Engine_Container, "Scoring Engine Container", "Scoring Engine Container")

Rel(In_Memory_Feature_Store_Cache, Scoring_Engine_Container, "Returns cached feature data", "gRPC / TCP over TLS 1.3")

@enduml