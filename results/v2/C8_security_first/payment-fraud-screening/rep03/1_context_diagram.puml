@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Fraud_Operations_Analysts_Risk_Managers, "Fraud Operations Analysts & Risk Managers", "Human actors reviewing suspicious transactions, updating rules, and managing cases.")
System_Ext(Payment_Gateway_Merchant_Systems, "Payment Gateway / Merchant Systems", "External actors sending authorization requests.")
System_Ext(Model_Registry_Feature_Store, "Model Registry / Feature Store", "Repository supplying ML models and features.")
System(Real_Time_Payment_Fraud_Screening_System, "Real-Time Payment Fraud Screening System", "Evaluates card-not-present payment authorizations for fraud at 3,000 TPS, providing real-time approve/decline/review decisions and case management for analysts.")

Rel(Payment_Gateway_Merchant_Systems, Real_Time_Payment_Fraud_Screening_System, "Sends authorization requests", "gRPC / HTTPS with mTLS")
Rel(Fraud_Operations_Analysts_Risk_Managers, Real_Time_Payment_Fraud_Screening_System, "Reviews cases and updates rules/models", "HTTPS (TLS 1.3) with OAuth2/OIDC and MFA")
Rel(Real_Time_Payment_Fraud_Screening_System, Model_Registry_Feature_Store, "Fetches scoring models and features", "HTTPS")
@enduml