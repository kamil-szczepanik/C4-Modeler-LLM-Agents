@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Real-Time Payment Fraud Screening System

Person(FraudOperationsAnalystsRiskManagers, "Fraud Operations Analysts & Risk Managers", "Human actors reviewing suspicious transactions, updating rules, and managing cases.")
System_Ext(PaymentGatewayMerchantSystems, "Payment Gateway / Merchant Systems", "External actors sending authorization requests.")
System_Ext(ModelRegistryFeatureStore, "Model Registry / Feature Store", "Repository supplying ML models and features.")

System_Boundary(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System") {
    Container(AWSApplicationLoadBalancerALBIngressRouter, "AWS Application Load Balancer (ALB) / Ingress Router", "AWS ALB", "Routes incoming payment gateway and analyst traffic securely.")
    Container(ScoringEngineContainerRust, "Scoring Engine Container (Rust)", "Rust, Axum, Tokio", "Powers high-throughput, sub-50ms fraud score evaluations.")
    Container(CaseManagementContainerPythonFastAPI, "Case Management Container (Python / FastAPI)", "Python, FastAPI", "Provides secure case management and analyst workflow tools.")
    Container(AuditLoggerSidecarContainer, "Audit Logger Sidecar Container", "Container Sidecar", "Handles internal message passing and forwards audit logs.")
    ContainerDb(AmazonElastiCacheRedis, "Amazon ElastiCache (Redis)", "Amazon ElastiCache (Redis)", "Provides low-latency feature store lookups.")
    ContainerDb(AmazonAuroraServerlessv2, "Amazon Aurora Serverless v2", "Amazon Aurora Serverless v2, SQL/TLS", "Automatically scales relational database resources for analyst workflows.")
    ContainerDb(AmazonS3withObjectLock, "Amazon S3 with Object Lock", "Amazon S3 with Object Lock (Compliance Mode)", "Enforces tamper-evident, 7-year retention compliance audits.")
}

Rel(PaymentGatewayMerchantSystems, AWSApplicationLoadBalancerALBIngressRouter, "Sends authorization requests", "HTTPS (TLS 1.3, HMAC-SHA256, mTLS)")
Rel(FraudOperationsAnalystsRiskManagers, AWSApplicationLoadBalancerALBIngressRouter, "Accesses case management workflows", "HTTPS (OAuth 2.0 / OIDC, RBAC, MFA)")
Rel(AWSApplicationLoadBalancerALBIngressRouter, ScoringEngineContainerRust, "Routes real-time scoring requests", "HTTP/REST or gRPC")
Rel(AWSApplicationLoadBalancerALBIngressRouter, CaseManagementContainerPythonFastAPI, "Routes analyst traffic", "HTTPS")
Rel(ScoringEngineContainerRust, AmazonElastiCacheRedis, "Performs feature store lookups", "gRPC / TCP")
Rel(ScoringEngineContainerRust, AuditLoggerSidecarContainer, "Sends audit logs via internal message passing", "Internal Message Passing")
Rel(AuditLoggerSidecarContainer, AmazonS3withObjectLock, "Stores tamper-evident audit logs", "AWS SDK (HTTPS)")
Rel(CaseManagementContainerPythonFastAPI, AmazonAuroraServerlessv2, "Queries and updates case data", "SQL/TLS")

@enduml