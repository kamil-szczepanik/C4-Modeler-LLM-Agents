@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Real-Time Payment Fraud Screening

Person(FraudAnalysts, "Fraud Analysts & Risk Operations", "Analysts who perform manual case reviews and manage fraud operations.")
Person(ComplianceOfficer, "Compliance & Audit Officer", "Officers responsible for reviewing audit logs and ensuring PCI-DSS Level 1 compliance.")

System_Ext(PaymentGateway, "Payment Gateway / Core Processing Platform", "Sends payment authorization requests for real-time fraud evaluation.")
System_Ext(CardNetworks, "Card Networks / Tokenization Service", "Provides token resolution and verification services.")
System_Ext(IdentityProvider, "Corporate Identity Provider (OIDC/SAML)", "Handles authentication and identity federation for analysts and compliance officers.")
System_Ext(AWSKMS, "AWS KMS & Secrets Manager", "Provides key management, encryption, and cryptographic hashing services.")

System(FraudScreeningSystem, "Real-Time Payment Fraud Screening System", "Evaluates card-not-present payment authorizations for a mid-size payment processor to prevent fraud while enabling manual case reviews.")

Rel(PaymentGateway, FraudScreeningSystem, "Synchronous API requests for sub-50ms scoring", "HTTPS/mTLS (REST/gRPC)")
Rel(FraudAnalysts, FraudScreeningSystem, "Secure case reviews and operations", "HTTPS via OIDC/SAML")
Rel(ComplianceOfficer, FraudScreeningSystem, "Audit log access and compliance checks", "HTTPS via OIDC/SAML")
Rel(FraudScreeningSystem, CardNetworks, "Token resolution and verification", "HTTPS API")
Rel(FraudScreeningSystem, AWSKMS, "Encryption, key rotation, and data-key caching", "Internal AWS API")

@enduml