@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_qldb, "AWS QLDB") {
    Component(Ledger_Journal_Storage_Component, "Ledger Journal Storage Component", "AWS QLDB Journal", "Provides managed, cryptographically secure, append-only journal storage for R-06 auditability.")
    Component(Ion_Document_Storage_Component, "Ion Document Storage Component", "Amazon Ion", "Stores immutable document revisions securely within the ledger.")
    Component(QLDB_PartiQL_API_Component, "QLDB PartiQL API Component", "PartiQL API", "Exposes interfaces for writing and querying tamper-evident records securely.")
}

Rel(Ledger_Journal_Storage_Component, Ion_Document_Storage_Component, "Persists document revisions")
Rel(QLDB_PartiQL_API_Component, Ledger_Journal_Storage_Component, "Executes queries and transactions")
@enduml