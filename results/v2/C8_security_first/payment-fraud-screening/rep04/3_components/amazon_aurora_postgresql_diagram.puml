@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container(CaseManagementAPIContainer, "Case Management API Container", "Node.js with NestJS", "Handles analyst workflows.")

Container_Boundary(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL") {
    Component(PrimaryWriterDatabaseInstance, "Primary Writer Database Instance", "Amazon Aurora PostgreSQL db.r6g.xlarge", "Handles write operations for case states using pgx over TLS 1.3 with PgBouncer.")
    Component(ReadReplicaDatabaseInstance, "Read Replica Database Instance", "Amazon Aurora PostgreSQL db.r6g.xlarge", "Offloads audit and compliance queries using pgx over TLS 1.3.")
}

Rel(CaseManagementAPIContainer, PrimaryWriterDatabaseInstance, "Executes write operations for case states", "pgx over TLS 1.3 with PgBouncer")
Rel(CaseManagementAPIContainer, ReadReplicaDatabaseInstance, "Offloads audit and compliance queries", "pgx over TLS 1.3")
@enduml