@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(audit_compliance_ledger_container, "Audit & Compliance Ledger Container") {
    Component(ledger_ingestion_service, "Ledger Ingestion Service", "Go", "Consumes decision payloads from message queues and formats them for ledger ingestion.")
    Component(tamper_evident_journal_manager, "Tamper-Evident Journal Manager", "Go / AWS SDK", "Commits cryptographically verifiable audit records to AWS QLDB.")
    Component(compliance_api_controller, "Compliance API Controller", "Go / REST", "Provides endpoints for Compliance & Audit Officers to query decision histories and export reports.")
}

Rel(ledger_ingestion_service, tamper_evident_journal_manager, "Passes formatted records")
Rel(compliance_api_controller, tamper_evident_journal_manager, "Queries audit logs")
@enduml