@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(case_management_api_container, "Case Management API Container") {
    Component(Case Management API Controller, "Case Management API Controller", "Node.js with NestJS", "Handles HTTP requests from Fraud Analysts and provides case management endpoints with DTO validation.")
    Component(Case Workflow Service, "Case Workflow Service", "Node.js with NestJS", "Processes case lifecycles and forwards immutable audit trails to the Audit & Compliance Ledger Container.")
    Component(Audit Query Component, "Audit Query Component", "Node.js with NestJS", "Queries decision histories and audit records for compliance and reporting.")
}

System_Ext(Audit & Compliance Ledger Container, "Audit & Compliance Ledger Container", "Audit & Compliance Ledger Container")
System_Ext(AWS QLDB, "AWS QLDB", "AWS QLDB")
System_Ext(Amazon Aurora PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL")
System_Ext(Amazon SQS, "Amazon SQS", "Amazon SQS")

Rel(Case Management API Controller, Case Workflow Service, "Delegates workflow actions", "")
Rel(Case Workflow Service, Audit & Compliance Ledger Container, "Forwards immutable audit trails", "gRPC / TLS")
Rel(Audit Query Component, AWS QLDB, "Queries decision histories for compliance", "AWS SDK / TLS")
Rel(Case Management API Controller, Amazon Aurora PostgreSQL, "Reads/writes operational state and queries read replicas", "TLS / Prisma ORM")
Rel(Case Management API Controller, Amazon SQS, "Publishes bulk decision jobs", "AWS SDK / TLS")
@enduml