@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Scoring Engine Container container

Container_Boundary(scoring_engine_container, "Scoring Engine Container") {
    Component(API_Router_Component, "API Router Component", "Go gRPC Server", "Handles synchronous gRPC scoring requests, invoking model evaluation or falling back on timeout/error.")
    Component(Model_Evaluator_Component, "Model Evaluator Component", "Go In-Memory Evaluator", "Executes compiled fraud models in memory with atomic pointer-swapping.")
    Component(Model_Loader___Verifier_Component, "Model Loader & Verifier Component", "Go Background Worker", "Fetches, verifies, and prepares model artifacts, triggering atomic pointer swaps.")
    Component(Local_Heuristic_Fallback_Component, "Local Heuristic Fallback Component", "Go Rule-Based Engine", "Rule-based fallback engine invoked for timeouts or errors.")
}

Rel(API_Router_Component, Model_Evaluator_Component, "Invokes model evaluation", "In-memory function call")
Rel(API_Router_Component, Local_Heuristic_Fallback_Component, "Invokes fallback on timeout/error", "In-memory fallback")
Rel(Model_Loader___Verifier_Component, Model_Evaluator_Component, "Triggers atomic pointer swap", "In-memory pointer update")

@enduml