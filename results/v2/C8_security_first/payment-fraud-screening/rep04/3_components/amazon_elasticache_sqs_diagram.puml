@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Scoring_Engine_Container, "Scoring Engine Container", "External system container")
System_Ext(Audit_Compliance_Ledger_Container, "Audit & Compliance Ledger Container", "External system container")

Container_Boundary(Amazon_ElastiCache_SQS, "Amazon ElastiCache / SQS") {
    Component(Amazon_ElastiCache_Serverless, "Amazon ElastiCache Serverless", "Redis OSS", "Provides sub-millisecond feature store caching with automated scaling for low-latency feature lookups.")
    Component(Amazon_SQS_DLQ, "Amazon SQS & DLQ", "Standard/FIFO Queue & Dead-Letter Queue", "Decouples real-time ingestion from auditing while preventing data loss.")
}

Rel(Scoring_Engine_Container, Amazon_ElastiCache_Serverless, "Performs low-latency feature lookups", "RESP over TLS")
Rel(Scoring_Engine_Container, Amazon_SQS_DLQ, "Publishes asynchronous audit events", "AWS SDK / HTTPS")
Rel(Amazon_SQS_DLQ, Audit_Compliance_Ledger_Container, "Consumes audit events", "Queue Protocol")

@enduml