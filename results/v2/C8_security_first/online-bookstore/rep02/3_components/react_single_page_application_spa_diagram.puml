@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(spa_boundary, "React Single Page Application (SPA)") {
    Component(Routing_Shell_Component, "Routing & Shell Component", "React, React Router", "Manages application navigation and shell layout, loading other UI components dynamically in-memory.")
    Component(Catalogue_Search_UI_Component, "Catalogue & Search UI Component", "React, Zustand", "Provides secure catalogue browsing and search capabilities with client-side state management.")
    Component(Checkout_Cart_UI_Component, "Checkout & Cart UI Component", "React, React Hook Form", "Handles cart management and checkout forms.")
    Component(API_Client_Component, "API Client Component", "Axios / Fetch API", "Communicates via TypeScript interfaces and async calls to send API requests to backend services.")
    Component(Localization_Session_Context_Provider, "Localization & Session Context Provider", "React Context", "Manages localization (USD, EUR, GBP) and session context.")
    Component(Telemetry_Analytics_Wrapper, "Telemetry & Analytics Wrapper", "React", "Handles telemetry and analytics with centralized sanitization ensuring GDPR and CCPA compliance.")
}

Rel(Routing_Shell_Component, Catalogue_Search_UI_Component, "Loads dynamically in-memory")
Rel(Routing_Shell_Component, Checkout_Cart_UI_Component, "Loads dynamically in-memory")
Rel(Catalogue_Search_UI_Component, API_Client_Component, "Communicates via TypeScript interfaces and async calls", "Async/TypeScript")
Rel(Checkout_Cart_UI_Component, API_Client_Component, "Communicates via TypeScript interfaces and async calls", "Async/TypeScript")

@enduml