@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(order_checkout_service, "Order & Checkout Service") {
    Component(CartComponent, "Cart Component", "Redis-backed", "Manages secure shopping cart states and idempotency keys.")
    Component(CheckoutOrchestratorIdempotencyManager, "Checkout Orchestrator & Idempotency Manager", "Java 21, Spring Boot", "Orchestrates the checkout process and manages transaction idempotency.")
    Component(PaymentIntegrationComponent, "Payment Integration Component", "Java 21, Spring Boot", "Handles secure financial transactions and payment captures with external gateways.")
    Component(FulfillmentComponent, "Fulfillment Component", "Java 21, Spring Boot", "Processes fulfillment data and interfaces with third-party shipping APIs and queues.")
    Component(OrderRepository, "Order Repository", "Amazon Aurora PostgreSQL", "Persists orders and state via JDBC and AWS RDS Proxy.")
}

Rel(CheckoutOrchestratorIdempotencyManager, PaymentIntegrationComponent, "Processes financial transactions and payment captures", "HTTPS with TLS 1.3")
Rel(CheckoutOrchestratorIdempotencyManager, FulfillmentComponent, "Transmits fulfillment data for processing")
Rel(CheckoutOrchestratorIdempotencyManager, CartComponent, "Manages cart state and idempotency keys", "Redis Protocol")
Rel(CheckoutOrchestratorIdempotencyManager, OrderRepository, "Persists orders and state", "JDBC via AWS RDS Proxy")
Rel(FulfillmentComponent, OrderRepository, "Updates fulfillment status in database", "JDBC via AWS RDS Proxy")

@enduml