@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(recommendation_service, "Recommendation Service") {
    Component(api_router, "API Router / Controller", "FastAPI / Python", "FastAPI component handling gRPC requests, Pydantic input validation, and OAuth2/JWT scope checks.")
    Component(recommendation_engine, "Recommendation Engine", "Python, NumPy, Scikit-learn", "Core Python component utilizing collaborative filtering and popularity heuristics.")
    Component(model_cache_layer, "Model Cache Layer", "Amazon ElastiCache (Redis)", "Stores pre-computed vector embeddings and itemsets with sub-50ms read latency.")
    Component(data_ingestion_worker, "Data Ingestion Worker & Event Consumer", "Python Celery, Amazon SQS/Kafka", "Processes asynchronous clickstream events and triggers asynchronous feature updates.")
}

Rel(api_router, model_cache_layer, "Fetches cached recommendations", "Redis Protocol with TLS")
Rel(api_router, recommendation_engine, "Computes fallback and tail recommendations", "In-process Python call")
Rel(data_ingestion_worker, model_cache_layer, "Updates cached embeddings", "Redis Protocol")
Rel(api_router, data_ingestion_worker, "Triggers asynchronous feature updates", "In-process Celery task dispatch")

@enduml