@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Catalog & Search Service", "Catalog & Search Service") {
    Component(Search & Catalog API Router, "Search & Catalog API Router", "Express.js, TypeScript", "Routes catalogue and search requests and validates JWT claims.")
    Component(Catalog Business Logic, "Catalog Business Logic", "Node.js", "Handles core business logic, delegates requests, and executes sanitized queries.")
    Component(Elasticsearch Client, "Elasticsearch Client", "@elastic/elasticsearch", "Executes sanitized, typo-tolerant DSL queries against the search backend.")
    Component(Distributed Cache Client, "Distributed Cache Client", "ioredis", "Fetches cached multi-currency search payloads from the in-memory cache.")
}

Rel(Search & Catalog API Router, Catalog Business Logic, "Delegates HTTP/gRPC requests and validates JWT claims", "Internal Function Call")
Rel(Catalog Business Logic, Distributed Cache Client, "Fetches cached multi-currency search payloads", "TCP / Redis Protocol over TLS")
Rel(Catalog Business Logic, Elasticsearch Client, "Executes sanitized, typo-tolerant DSL queries", "Internal Function Call")
@enduml