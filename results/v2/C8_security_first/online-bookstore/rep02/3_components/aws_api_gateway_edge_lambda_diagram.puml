@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_api_gateway_edge_lambda, "AWS API Gateway & Edge Lambda") {
    Component(Edge_WAF, "Edge WAF", "AWS WAF", "Inspects and filters traffic for OWASP Top-10 threats, providing edge security, DDoS mitigation, and rate limiting.")
    Component(API_Routing_Validation_Layer, "API Routing & Validation Layer", "Amazon API Gateway - HTTP API", "Handles entry routing, API requests, and header injection.")
    Component(Edge_Processing_Function, "Edge Processing Function", "AWS Lambda@Edge", "Performs localized currency handling and request processing with minimal latency.")
}

Rel(Edge_WAF, API_Routing_Validation_Layer, "Inspects and filters traffic for")
Rel(API_Routing_Validation_Layer, Edge_Processing_Function, "Invokes for localized processing and header injection")

@enduml