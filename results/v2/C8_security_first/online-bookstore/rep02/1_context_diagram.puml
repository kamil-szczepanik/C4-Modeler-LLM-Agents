@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Shoppers_Customers, "Shoppers / Customers", "End-users browsing catalogues and executing checkouts.")
Person(Book_Publishers_Administrators, "Book Publishers / Administrators", "Internal actors managing inventory and content moderation.")
System(Online_Bookstore_System, "Online Bookstore System", "A globally distributed e-commerce platform built to provide fast, secure book purchasing, personalized recommendations, and reviews, handling high-scale retail operations while enforcing multi-region availability and data privacy compliance.")
System_Ext(Payment_Gateway, "Payment Gateway", "External system for processing financial transactions.")
System_Ext(Third_Party_Shipping_APIs, "Third-Party Shipping APIs", "External system managing logistics and fulfillment.")

Rel(Shoppers_Customers, Online_Bookstore_System, "Browse, cart, checkout, and review", "HTTPS (TLS 1.3)")
Rel(Book_Publishers_Administrators, Online_Bookstore_System, "Manage catalogue and moderation", "HTTPS with MFA")
Rel(Online_Bookstore_System, Payment_Gateway, "Process financial transactions", "REST/JSON APIs")
Rel(Online_Bookstore_System, Third_Party_Shipping_APIs, "Transmit fulfillment data with circuit breakers", "REST/JSON APIs")
@enduml