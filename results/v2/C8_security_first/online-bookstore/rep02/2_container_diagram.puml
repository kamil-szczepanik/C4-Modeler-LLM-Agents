@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore System

Person(Shoppers_Customers, "Shoppers / Customers", "End-users browsing catalogues and executing checkouts.")
Person(Book_Publishers_Administrators, "Book Publishers / Administrators", "Internal actors managing inventory and content moderation.")

System_Ext(Payment_Gateway, "Payment Gateway", "External system for processing financial transactions.")
System_Ext(Third_Party_Shipping_APIs, "Third-Party Shipping APIs", "External system managing logistics and fulfillment.")

System_Boundary(Online_Bookstore_System, "Online Bookstore System") {
    Container(React_Single_Page_Application_SPA, "React Single Page Application (SPA)", "React, Amazon S3, Amazon CloudFront", "Provides catalogue browsing, secure checkout, 5-star reviews, and recommendations interface.")
    Container(AWS_API_Gateway_Edge_Lambda, "AWS API Gateway & Edge Lambda", "AWS API Gateway, AWS Lambda", "Entry point for client requests, handling routing and edge security.")
    Container(Catalog_Search_Service, "Catalog & Search Service", "Node.js, Express, Elasticsearch", "Manages book catalogue browsing, search, and indexing.")
    Container(Order_Checkout_Service, "Order & Checkout Service", "Java, Spring Boot, Amazon Aurora PostgreSQL, Redis", "Handles secure checkout, orders, and cart caching.")
    Container(Recommendation_Service, "Recommendation Service", "Python, FastAPI", "Provides personalized book recommendations to shoppers.")
}

Rel(Shoppers_Customers, React_Single_Page_Application_SPA, "Browse catalogue, checkout, review, and view recommendations", "HTTPS")
Rel(Book_Publishers_Administrators, React_Single_Page_Application_SPA, "Manage inventory and content", "HTTPS")
Rel(React_Single_Page_Application_SPA, AWS_API_Gateway_Edge_Lambda, "Sends API requests", "HTTPS/JSON")
Rel(AWS_API_Gateway_Edge_Lambda, Catalog_Search_Service, "Routes catalogue and search requests", "gRPC over mTLS with JWT")
Rel(AWS_API_Gateway_Edge_Lambda, Order_Checkout_Service, "Routes order and checkout requests", "gRPC over mTLS with JWT")
Rel(AWS_API_Gateway_Edge_Lambda, Recommendation_Service, "Routes recommendation requests", "gRPC over mTLS with JWT")
Rel(Order_Checkout_Service, Payment_Gateway, "Processes financial transactions", "HTTPS")
Rel(Order_Checkout_Service, Third_Party_Shipping_APIs, "Transmits fulfillment data", "HTTPS")

@enduml