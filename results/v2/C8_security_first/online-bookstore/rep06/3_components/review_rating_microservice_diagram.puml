@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Review & Rating Microservice container

Container_Boundary(review_rating_microservice, "Review & Rating Microservice") {
    Component(Review_Controller, "Review Controller", "gRPC Server (HTTP/2, mTLS)", "Handles incoming gRPC requests for reviews and ratings from the API Gateway and downstream services.")
    Component(Review_Service, "Review Service", "AWS ECS Fargate Container", "Contains business logic for processing reviews, ratings, and coordinating asynchronous messaging.")
    Component(DynamoDB_Client, "DynamoDB Client", "AWS SDK (HTTPS)", "Interfaces with Amazon DynamoDB Global Tables and Amazon DAX for data persistence and caching.")
    Component(Messaging_Publisher, "Messaging Publisher", "AWS SDK (HTTPS)", "Publishes asynchronous events to Amazon SQS and SNS.")
}

Rel(Review_Controller, Review_Service, "Invokes business logic")
Rel(Review_Service, DynamoDB_Client, "Reads and writes review data", "AWS SDK (HTTPS)")
Rel(Review_Service, Messaging_Publisher, "Dispatches asynchronous events", "AWS SDK (HTTPS)")

@enduml