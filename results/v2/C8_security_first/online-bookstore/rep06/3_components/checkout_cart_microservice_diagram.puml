@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Checkout & Cart Microservice container

Container_Boundary(checkout_cart_microservice, "Checkout & Cart Microservice") {
    Component(Cart_Management_Component, "Cart Management Component", "Node.js/Express, PostgreSQL", "Handles shopping carts and cart persistence.")
    Component(Checkout_Orchestrator_Component, "Checkout Orchestrator Component", "Node.js/Express, PostgreSQL, Transaction Ledger", "Processes secure transactions and order fulfillment.")
    Component(Fulfillment_Payment_Publisher_Component, "Fulfillment & Payment Publisher Component", "Node.js/Express, AWS SDK", "Publishes payment and fulfillment events asynchronously.")
    Component(Amazon_SQS_Dead_Letter_Queues, "Amazon SQS & Dead Letter Queues", "Amazon SQS, DLQ", "Provides asynchronous message decoupling and resilience.")
    Component(External_Payment_Gateway_Third_Party_Shipping_APIs, "External Payment Gateway & Third-Party Shipping APIs", "REST/HTTPS", "Handles external payment processing and shipping.")
    Component(API_Gateway, "API Gateway", "gRPC, HTTPS with mTLS", "Routes incoming traffic to the internal components.")
    Component(PostgreSQL, "PostgreSQL", "PostgreSQL with Multi-AZ deployment", "Relational database providing ACID guarantees for order ledgers.")
}

Rel(API_Gateway, Cart_Management_Component, "gRPC and HTTPS with mTLS")
Rel(API_Gateway, Checkout_Orchestrator_Component, "gRPC and HTTPS with mTLS")
Rel(Checkout_Orchestrator_Component, PostgreSQL, "TLS and SQL with connection pooling via PgBouncer")
Rel(Fulfillment_Payment_Publisher_Component, Amazon_SQS_Dead_Letter_Queues, "AWS SDK and HTTPS with AWS KMS CMK encryption")
Rel(Fulfillment_Payment_Publisher_Component, External_Payment_Gateway_Third_Party_Shipping_APIs, "REST/HTTPS via SQS async queues")

@enduml