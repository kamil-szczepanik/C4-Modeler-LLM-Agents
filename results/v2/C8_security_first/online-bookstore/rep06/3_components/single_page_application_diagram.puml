@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(spa, "Single Page Application") {
    Component(Routing_Shell_Component, "Routing & Shell Component", "React & React Router", "Handles client-side navigation and lazy-loading feature modules.")
    Component(State_Management_Store, "State Management Store", "Zustand / React Context", "Centralized reactive state for cart items and user session footprint.")
    Component(API_Client_Layer, "API Client Layer", "JavaScript / TypeScript", "Encapsulates backend communication, error boundaries, and request interceptors.")
    Component(Persistence_Sync_Middleware, "Persistence & Sync Middleware", "IndexedDB", "Manages local caching and synchronizes offline cart/wishlist state.")
    Component(Telemetry_Analytics_Wrapper, "Telemetry & Analytics Wrapper", "JavaScript", "Asynchronously captures user interaction events and metrics.")
    Component(Feature_Modules, "Feature Modules", "React", "Decoupled domain views including Catalogue Browser, Cart & Checkout, Product Reviews, and Vendor Portal.")
}

System_Ext(API_Gateway_WAF, "API Gateway & WAF", "External API Gateway")

Rel(State_Management_Store, Persistence_Sync_Middleware, "Synchronizes in-memory state with IndexedDB", "Local Browser APIs")
Rel(Persistence_Sync_Middleware, State_Management_Store, "Restores offline cart/wishlist state", "Local Browser APIs")
Rel(API_Client_Layer, API_Gateway_WAF, "Sends API requests for data and transactions", "HTTPS / REST")
Rel(Routing_Shell_Component, Feature_Modules, "Lazy-loads and renders domain views", "React")

@enduml