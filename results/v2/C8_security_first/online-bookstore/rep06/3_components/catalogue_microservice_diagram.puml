@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalogue Microservice container

System_Ext(api_gateway, "API Gateway", "External API Gateway")

Container_Boundary(catalogue_microservice, "Catalogue Microservice") {
    Component(catalogue_api_controller, "Catalogue API Controller", "Node.js/Spring Boot", "Processes search and catalog queries to drive user engagement while ensuring strict regulatory compliance.")
    Component(search_indexing_engine, "Search & Indexing Engine", "Java/Python", "Handles fast, typo-tolerant search and indexing capabilities.")
    Component(inventory_management_service, "Inventory Management Service", "Spring Boot", "Manages book inventory, details, and relational persistence.")
    Component(event_synchronization_worker, "Event Synchronization Worker", "Node.js/Java", "Synchronizes events to balance search performance with near-real-time inventory accuracy.")
    Component(amazon_opensearch, "Amazon OpenSearch", "AWS OpenSearch Service", "Stores search indexes for fast, typo-tolerant search capabilities.")
    Component(postgresql, "PostgreSQL", "Amazon RDS PostgreSQL", "Provides relational persistence for structured inventory data.")
    Component(amazon_sqs, "Amazon SQS", "AWS SQS", "Provides reliable asynchronous event queuing.")
}

Rel(api_gateway, catalogue_api_controller, "gRPC/HTTPS")
Rel(catalogue_api_controller, search_indexing_engine, "HTTP/REST")
Rel(catalogue_api_controller, inventory_management_service, "In-process")
Rel(inventory_management_service, postgresql, "JDBC/TCP, TLS 1.3")
Rel(inventory_management_service, amazon_sqs, "HTTPS")
Rel(event_synchronization_worker, search_indexing_engine, "In-process")
Rel(search_indexing_engine, amazon_opensearch, "HTTPS")

@enduml