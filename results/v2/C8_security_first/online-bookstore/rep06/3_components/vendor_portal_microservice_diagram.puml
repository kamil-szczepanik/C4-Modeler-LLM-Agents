@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(vendor_portal_microservice, "Vendor Portal Microservice") {
    Component(API_Gateway_WAF, "API Gateway & WAF", "AWS API Gateway & WAF", "Entry point handling mutual TLS and JWT validation.")
    Component(Ingestion_Processing_Component, "Ingestion & Processing Component", "Node.js/Python stream worker pool", "Handles bulk uploads asynchronously.")
    Component(Catalog_Inventory_Management_Component, "Catalog & Inventory Management Component", "NestJS", "Handling CRUD operations via gRPC.")
    Component(Analytics_Query_Component, "Analytics Query Component", "Read-optimized service", "Serving real-time sales KPIs from materialized views.")
    Component(Async_Error_Publisher_Component, "Async Error Publisher Component", "AWS SDK module", "Generating S3 pre-signed error reports.")
    Component(Notification_Dispatcher_Component, "Notification Dispatcher Component", "Module with circuit breakers", "Handling low-stock alerts.")
    Component(Amazon_SQS_DLQ, "Amazon SQS & DLQ", "Amazon SQS", "Buffers bulk upload jobs and traps poison-pill messages.")
    Component(Amazon_S3, "Amazon S3", "AWS S3", "Stores temporary structured error reports with 7-day lifecycles.")
    Component(PostgreSQL, "PostgreSQL", "PostgreSQL", "Dedicated database with row-level security (RLS) and table partitioning.")
    Component(AWS_Secrets_Manager_KMS, "AWS Secrets Manager & KMS", "AWS Secrets Manager & KMS", "Manages encrypted secrets and data-at-rest encryption.")
}

Rel(API_Gateway_WAF, Ingestion_Processing_Component, "HTTPS [REST/Multipart]")
Rel(API_Gateway_WAF, Catalog_Inventory_Management_Component, "gRPC")
Rel(Ingestion_Processing_Component, Amazon_SQS_DLQ, "AWS SDK [Poll/Acknowledge]")
Rel(Ingestion_Processing_Component, Amazon_S3, "HTTPS [PutObject/Presigned URLs]")
Rel(Catalog_Inventory_Management_Component, PostgreSQL, "TLS 1.3 [SQL with RLS]")
Rel(Catalog_Inventory_Management_Component, Notification_Dispatcher_Component, "gRPC [Low-Stock Event]")
@enduml