@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_waf, "API Gateway & WAF") {
    Component(awsc, "AWS WAF Rule Engine", "AWS WAF & Shield Advanced", "Inspects incoming HTTPS requests for malicious traffic, bot protection, and OWASP vulnerabilities.")
    Component(apig, "API Gateway Router", "Amazon API Gateway", "Routes valid requests to downstream ECS Fargate microservices and injects context headers.")
    Component(smp, "Service Mesh Proxy", "AWS App Mesh (Envoy)", "Manages zero-trust mTLS and secure gRPC routing between the gateway and core microservices.")
}

Rel(awsc, apig, "Filters and forwards clean HTTPS requests", "TLS 1.3")
Rel(apig, smp, "Routes requests with context headers", "gRPC over mTLS")

@enduml