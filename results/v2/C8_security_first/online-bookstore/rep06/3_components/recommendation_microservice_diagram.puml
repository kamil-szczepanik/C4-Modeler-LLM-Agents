@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Recommendation Microservice container

Container_Boundary(recommendation_microservice, "Recommendation Microservice") {
    Component(RecommendationAPIController, "Recommendation API Controller", "Go", "Handles incoming recommendation requests and coordinates the workflow.")
    Component(ExperimentRouter, "Experiment Router", "Go", "Evaluates variant context and routes requests to the appropriate model variant.")
    Component(ScoringEngine, "Scoring Engine", "Python, NumPy", "Executes collaborative filtering algorithms for personalized scoring.")
    Component(CacheFallbackManager, "Cache & Fallback Manager", "Go, go-redis", "Manages user-state caching and fallback logic for high availability.")
    Component(ColdStartHandler, "Cold-Start Handler", "Go", "Handles recommendations for new users with limited historical data.")
    Component(AnalyticsPublisher, "Analytics Publisher", "Go, AWS Kinesis Producer", "Emits click-through and conversion metrics asynchronously.")
}

Rel(RecommendationAPIController, ExperimentRouter, "Evaluates variant context", "In-memory Go function call")
Rel(ExperimentRouter, ScoringEngine, "Invokes selected model variant", "gRPC over IPC")
Rel(RecommendationAPIController, CacheFallbackManager, "Fetches and updates user state", "TCP, Redis AUTH, TLS")
Rel(ScoringEngine, CacheFallbackManager, "Fetches and updates user state", "TCP, Redis AUTH, TLS")
Rel(RecommendationAPIController, AnalyticsPublisher, "Emits click-through and conversion metrics", "AWS SDK, HTTPS")
@enduml