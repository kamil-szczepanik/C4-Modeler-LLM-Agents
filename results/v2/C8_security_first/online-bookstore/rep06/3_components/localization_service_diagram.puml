@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Localization Service container

Container_Boundary("Localization Service", "Localization Service") {
    Component(Geo_Router_Component, "Geo-Router Component", "AWS Lambda@Edge (Node.js/JavaScript)", "Handles regional routing and geolocation-based user identification.")
    Component(Currency_Translation_Resolver_Component, "Currency & Translation Resolver Component", "AWS Lambda@Edge (Node.js/JavaScript)", "Manages multi-currency conversion and language localization logic.")
    Component(Cookie_Preference_Manager_Component, "Cookie & Preference Manager Component", "AWS Lambda@Edge (Node.js/JavaScript)", "Processes and manages user preference cookies and locale states.")
    Component(Origin_Request_Transformer_Component, "Origin Request Transformer Component", "AWS Lambda@Edge (Node.js/JavaScript)", "Injects custom headers like X-User-Currency and X-User-Locale into downstream requests.")
}

Rel(Geo_Router_Component, Cookie_Preference_Manager_Component, "Reads and updates user preferences and cookies")
Rel(Cookie_Preference_Manager_Component, Currency_Translation_Resolver_Component, "Provides resolved context for currency and translation")
Rel(Currency_Translation_Resolver_Component, Origin_Request_Transformer_Component, "Passes resolved locale and currency data for header injection")

@enduml