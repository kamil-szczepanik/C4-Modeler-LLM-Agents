@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Shoppers, "Shoppers", "End-users browsing catalogues, managing carts, and purchasing books.")
Person(Vendors_Admins, "Vendors & Admins", "Internal users managing inventory, catalogue listings, and order disputes.")

System(Online_Bookstore, "Online Bookstore", "Globally scaled e-commerce platform designed to support catalogue browsing, secure checkout, 5-star reviews, and personalized recommendations for 1 million monthly active users.")
System(Recommendation_Engine, "Recommendation Engine", "Internal subsystem handling real-time 'Customers also bought' suggestions.")

System_Ext(Payment_Gateway, "Payment Gateway", "External PCI-compliant payment processor (Stripe/PayPal).")
System_Ext(Third_Party_Shipping_APIs, "Third-Party Shipping APIs", "External fulfillment and tracking providers (FedEx/UPS).")
System_Ext(Notification_Service, "Notification Service", "External transactional email SaaS provider (AWS SES/SendGrid).")

Rel(Shoppers, Online_Bookstore, "Browse catalogues, search, and checkout", "HTTPS via AWS CloudFront and WAF")
Rel(Vendors_Admins, Online_Bookstore, "Access management console for inventory and order disputes", "HTTPS with enforced MFA")
Rel(Online_Bookstore, Payment_Gateway, "Secure tokenized checkout transactions", "REST/HTTPS")
Rel(Online_Bookstore, Third_Party_Shipping_APIs, "Fulfillment and tracking integration", "REST/HTTPS")
Rel(Online_Bookstore, Notification_Service, "Asynchronous transactional emails", "REST/HTTPS over TLS 1.3")
@enduml