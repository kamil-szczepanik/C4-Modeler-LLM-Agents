@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore

Person(Shoppers, "Shoppers", "End-users browsing catalogues, managing carts, and purchasing books.")
Person(VendorsAdmins, "Vendors & Admins", "Internal users managing inventory, catalogue listings, and order disputes.")

System_Ext(PaymentGateway, "Payment Gateway", "External PCI-compliant payment processor (Stripe/PayPal).")
System_Ext(ThirdPartyShippingAPIs, "Third-Party Shipping APIs", "External fulfillment and tracking providers (FedEx/UPS).")
System_Ext(NotificationService, "Notification Service", "External transactional email SaaS provider (AWS SES/SendGrid).")

System_Boundary(OnlineBookstore, "Online Bookstore") {
    Container(SinglePageApplication, "Single Page Application", "React, AWS S3, CloudFront", "Frontend interface for shoppers and vendors hosted at the edge.")
    Container(APIGatewayWAF, "API Gateway & WAF", "AWS API Gateway, AWS ALB, AWS WAF", "Entry point for all client requests providing security and routing.")
    Container(LocalizationService, "Localization Service", "AWS Lambda@Edge", "Edge service handling localization and regional routing.")
    Container(CatalogueMicroservice, "Catalogue Microservice", "AWS ECS Fargate, PostgreSQL, Amazon OpenSearch", "Manages book inventory, details, and search capabilities.")
    Container(CheckoutCartMicroservice, "Checkout & Cart Microservice", "AWS ECS Fargate, PostgreSQL, Amazon SQS", "Handles shopping carts, order processing, and payment/shipping queues.")
    Container(RecommendationMicroservice, "Recommendation Microservice", "AWS ECS Fargate, Redis", "Generates real-time personalized book recommendations.")
    Container(VendorPortalMicroservice, "Vendor Portal Microservice", "AWS ECS Fargate, PostgreSQL", "Provides vendors and admins management tools for inventory and listings.")
    Container(ReviewRatingMicroservice, "Review & Rating Microservice", "AWS ECS Fargate, Amazon DynamoDB", "Manages user reviews, ratings, and feedback.")
}

Rel(Shoppers, SinglePageApplication, "Browses catalogue, manages cart, and places orders", "HTTPS via AWS CloudFront")
Rel(VendorsAdmins, SinglePageApplication, "Accesses management portal for inventory and operations", "HTTPS via AWS CloudFront")
Rel(SinglePageApplication, APIGatewayWAF, "Sends API requests for data and transactions", "HTTPS / REST")
Rel(APIGatewayWAF, CatalogueMicroservice, "Routes catalogue and search queries", "gRPC and HTTPS")
Rel(APIGatewayWAF, CheckoutCartMicroservice, "Routes cart and checkout operations", "gRPC and HTTPS")
Rel(APIGatewayWAF, RecommendationMicroservice, "Requests personalized recommendations", "gRPC and HTTPS")
Rel(APIGatewayWAF, VendorPortalMicroservice, "Routes vendor management operations", "gRPC and HTTPS")
Rel(APIGatewayWAF, ReviewRatingMicroservice, "Routes review submissions and retrieval", "gRPC and HTTPS")
Rel(CheckoutCartMicroservice, PaymentGateway, "Processes secure tokenized transactions asynchronously", "Amazon SQS and REST/HTTPS")
Rel(CheckoutCartMicroservice, ThirdPartyShippingAPIs, "Dispatches order fulfillment data asynchronously", "Amazon SQS and REST/HTTPS")

@enduml