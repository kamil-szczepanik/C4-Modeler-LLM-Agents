@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon Aurora PostgreSQL container

Container_Boundary(amazon_aurora_postgresql, "Amazon Aurora PostgreSQL") {
    Component(aurora_serverless_v2_engine, "Aurora Serverless v2 Engine", "PostgreSQL 15 / AWS RDS", "Provides transactional data storage and automatically scales compute capacity for the online bookstore.")
    Component(aurora_distributed_storage, "Aurora Distributed Storage", "AWS Aurora Distributed Storage", "Handles 6-way replication across 3 Availability Zones ensuring high availability and durability.")
}

Rel(aurora_serverless_v2_engine, aurora_distributed_storage, "Replicates data securely across 3 AZs (6-way replication)", "Internal VPC connection")

@enduml