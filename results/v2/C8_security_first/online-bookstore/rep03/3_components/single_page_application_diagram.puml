@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Single Page Application container

Container_Boundary(spa_boundary, "Single Page Application") {
    Component(Routing_Shell_Component, "Routing & Shell Component", "React, TypeScript", "Provides the main application shell and dynamically loads feature bundles.")
    Component(Catalogue_Search_View, "Catalogue & Search View", "React, TypeScript", "Allows users to browse and search for books.")
    Component(Cart_Checkout_Flow, "Cart & Checkout Flow", "React, TypeScript", "Manages the shopping cart and secure checkout process.")
    Component(Review_Rating_Widget, "Review & Rating Widget", "React, TypeScript", "Displays and collects user reviews and ratings.")
    Component(State_Management_Store, "State Management Store", "Zustand / React Context", "Manages ephemeral client state for currency and cart counts without prop-drilling.")
    Component(API_Client, "API Client", "Axios / Fetch wrapper", "Centralized HTTP client managing CSRF headers, PII redaction, and circuit breakers.")
}

System_Ext(API_Gateway_Security, "API Gateway & Security", "External Container")

Rel(Routing_Shell_Component, Catalogue_Search_View, "Dynamically loads feature bundles", "In-Memory")
Rel(Routing_Shell_Component, Cart_Checkout_Flow, "Dynamically loads feature bundles", "In-Memory")
Rel(Routing_Shell_Component, Review_Rating_Widget, "Dynamically loads feature bundles", "In-Memory")
Rel(Catalogue_Search_View, State_Management_Store, "Reads and writes local UI state", "In-Memory")
Rel(Cart_Checkout_Flow, State_Management_Store, "Reads and writes local UI state", "In-Memory")
Rel(Review_Rating_Widget, State_Management_Store, "Reads and writes local UI state", "In-Memory")
Rel(Catalogue_Search_View, API_Client, "Synchronizes data and communicates", "In-Memory")
Rel(Cart_Checkout_Flow, API_Client, "Synchronizes data and communicates", "In-Memory")
Rel(Review_Rating_Widget, API_Client, "Synchronizes data and communicates", "In-Memory")
Rel(API_Client, API_Gateway_Security, "Sends REST API requests", "HTTPS/REST")

@enduml