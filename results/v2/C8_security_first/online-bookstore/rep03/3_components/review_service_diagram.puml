@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Review Service container

Container_Boundary(review_service, "Review Service") {
    Component(Review_Controller, "Review Controller", "Node.js/Express Component", "Handles incoming routing, gRPC traffic, and role-based JWT validation for review submissions.")
    Component(Moderation_Sanitization_Engine, "Moderation & Sanitization Engine", "Node.js Component", "Handles moderation workflows and sanitization of customer reviews and ratings.")
    Component(Review_Repository, "Review Repository", "TypeORM Component", "Manages data models and executes secure queries against Amazon Aurora PostgreSQL.")
    Component(Rating_Aggregator, "Rating Aggregator", "Background Worker Component", "Processes background operations and aggregates ratings for the review system.")
}

System_Ext(API_Gateway_Security, "API Gateway & Security", "External API Gateway")
System_Ext(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Relational database")
System_Ext(Notification_Service, "Notification Service", "Notification system")
System_Ext(Amazon_EventBridge, "Amazon EventBridge", "Serverless event bus")
System_Ext(Catalogue_Service, "Catalogue Service", "Catalogue microservice")

Rel(API_Gateway_Security, Review_Controller, "Routes gRPC traffic", "gRPC with mTLS")
Rel(Review_Repository, Amazon_Aurora_PostgreSQL, "Executes SQL queries", "TCP/5432 via VPC, TLS 1.3")
Rel(review_service, Notification_Service, "Publishes review prompt events", "Amazon SNS/SQS, JSON")
Rel(review_service, Amazon_EventBridge, "Publishes ReviewCreated and RatingUpdated domain events", "JSON via AWS SDK")
Rel(Amazon_EventBridge, Catalogue_Service, "Dispatches rating updates", "JSON over SQS/EventBridge")

@enduml