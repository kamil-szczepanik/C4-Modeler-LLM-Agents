@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon DynamoDB container

System_Ext(Catalogue_Shopping_Cart_Services, "Catalogue & Shopping Cart Services", "External caller services")
System_Ext(Recommendation_Engine, "Recommendation Engine", "External consumer of change data capture events")

Container_Boundary(Amazon_DynamoDB, "Amazon DynamoDB") {
    Component(Request_Router, "Request Router", "DynamoDB Frontend Fleet", "Handles request parsing, IAM SigV4 authorization, and partition key hashing.")
    Component(Storage_Engine, "Storage Engine", "Distributed B-tree/SSD storage", "Distributed B-tree/SSD storage partitions managed via AWS multi-AZ replication.")
    Component(Stream_Publisher_Component, "Stream Publisher Component", "DynamoDB Streams", "Captures item-level modifications for asynchronous change data capture.")
    Component(Global_Tables, "Global Tables", "Multi-region replication", "Multi-region replication across us-east-1, eu-west-1, and ap-southeast-1.")
}

Rel(Catalogue_Shopping_Cart_Services, Request_Router, "Invoke CRUD operations", "HTTPS / JSON over AWS PrivateLink VPC Endpoints")
Rel(Request_Router, Storage_Engine, "Route partition-hashed requests", "internal TCP/RPC over the AWS backbone")
Rel(Stream_Publisher_Component, Recommendation_Engine, "Push CDC change events securely", "AWS Lambda / Amazon DynamoDB Streams")

@enduml