@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_security, "API Gateway & Security") {
    Component(Perimeter_Defense_Filter, "Perimeter Defense Filter", "AWS WAF", "Protects the perimeter against common web exploits and OWASP Top-10 vulnerabilities.")
    Component(API_Gateway_Router, "API Gateway Router", "AWS API Gateway", "Routes client requests to backend ECS Fargate services and manages entry points.")
    Component(Authorizer, "Authorizer", "AWS Lambda Authorizer", "Performs JWT validation and RBAC enforcement for incoming requests.")
}

Rel(Perimeter_Defense_Filter, API_Gateway_Router, "Inspects and filters incoming HTTP/REST requests", "HTTP/REST")
Rel(API_Gateway_Router, Authorizer, "Invokes for token validation and access control", "AWS Lambda Invocation")

@enduml