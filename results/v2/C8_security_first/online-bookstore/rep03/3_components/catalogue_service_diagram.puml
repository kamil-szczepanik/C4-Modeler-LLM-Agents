@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(Catalogue_Service, "Catalogue Service") {
    Component(Catalogue_API_Controller, "Catalogue API Controller", "Node.js (NestJS) or Go (Gin)", "Handles high-throughput, non-blocking I/O incoming requests from the API Gateway.")
    Component(Search_and_Query_Engine, "Search and Query Engine", "Amazon ElastiCache Redis, Amazon DynamoDB", "Serves low-latency keyword searches and fast catalogue read models.")
}

Rel(Catalogue_API_Controller, Search_and_Query_Engine, "Queries fast catalogue read models and serves low-latency searches", "Internal VPC Connection")
@enduml