@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Shopping Cart & Checkout Service container

Container_Boundary(shopping_cart_checkout_service, "Shopping Cart & Checkout Service") {
    Component(Cart Management Component, "Cart Management Component", "Node.js/TypeScript", "Manages shopping cart operations and interacts with persistence and caching layers.")
    Component(Checkout Orchestrator Component, "Checkout Orchestrator Component", "Node.js/TypeScript", "Orchestrates transactional orders and queues asynchronous fulfillment tasks.")
    Component(Payment & Shipping Integration Component, "Payment & Shipping Integration Component", "Node.js/TypeScript", "Integrates with external payment gateways and shipping provider APIs to process payments and fulfillment.")
    Component(Currency & Tax Adapter Component, "Currency & Tax Adapter Component", "Node.js/TypeScript", "Fetches multi-currency and tax data by communicating with the Localization & Currency Service.")
}

System_Ext(Amazon DynamoDB & Amazon ElastiCache, "Amazon DynamoDB & Amazon ElastiCache", "Database and Caching")
System_Ext(Amazon Aurora PostgreSQL, "Amazon Aurora PostgreSQL", "Relational Database")
System_Ext(Amazon SQS, "Amazon SQS", "Message Queue")
System_Ext(Payment Gateway & Shipping Provider APIs, "Payment Gateway & Shipping Provider APIs", "External APIs")
System_Ext(Localization & Currency Service, "Localization & Currency Service", "Microservice")

Rel(Cart Management Component, Amazon DynamoDB & Amazon ElastiCache, "Persists and caches cart data", "Internal VPC Connection")
Rel(Checkout Orchestrator Component, Amazon Aurora PostgreSQL, "Stores transactional orders", "Internal VPC Connection")
Rel(Checkout Orchestrator Component, Amazon SQS, "Queues asynchronous fulfillment tasks", "Internal AWS API")
Rel(Payment & Shipping Integration Component, Payment Gateway & Shipping Provider APIs, "Processes payments and fulfillment", "HTTPS/REST via AWS NAT Gateway")
Rel(Currency & Tax Adapter Component, Localization & Currency Service, "Fetches multi-currency and tax data", "gRPC with mTLS")

@enduml