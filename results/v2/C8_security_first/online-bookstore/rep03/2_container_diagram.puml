@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore System

Person(Shopper_Reviewer, "Shopper / Reviewer", "External users browsing catalogues, managing carts, submitting reviews, and purchasing books.")
Person(Store_Administrator, "Store Administrator", "Internal users managing inventory, order disputes, and sales metrics.")

System_Ext(Payment_Gateway, "Payment Gateway", "Stripe or PayPal handling PCI-DSS compliant transactions.")
System_Ext(Shipping_Provider_APIs, "Shipping Provider APIs", "FedEx or UPS for order fulfillment.")
System_Ext(Recommendation_Engine, "Recommendation Engine", "AWS Personalize providing machine-learning personalization.")
System_Ext(Notification_Service, "Notification Service", "SendGrid or Twilio managing transactional emails, SMS, and MFA codes.")

System_Boundary(Online_Bookstore_System, "Online Bookstore System") {
    Container(Single_Page_Application, "Single Page Application", "React, TypeScript, Amazon CloudFront, Amazon S3", "Client-side user experience hosted on Amazon CloudFront and S3.")
    Container(API_Gateway_Security, "API Gateway & Security", "AWS API Gateway, AWS WAF", "Manages and secures incoming API traffic.")
    Container(Catalogue_Service, "Catalogue Service", "AWS ECS Fargate", "Manages book catalogues and product data.")
    Container(Shopping_Cart_Checkout_Service, "Shopping Cart & Checkout Service", "AWS ECS Fargate", "Manages user shopping carts and processes checkout and orders.")
    Container(Review_Service, "Review Service", "AWS ECS Fargate", "Handles user review submissions and ratings.")
    Container(Localization_Currency_Service, "Localization & Currency Service", "AWS ECS Fargate", "Manages multiple currencies and localization requirements.")
    ContainerDb(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Transactional database for checkout data.")
    ContainerDb(Amazon_DynamoDB, "Amazon DynamoDB", "Amazon DynamoDB", "Low-latency database for catalogue and cart reads.")
    ContainerDb(Amazon_ElastiCache, "Amazon ElastiCache", "Amazon ElastiCache (Redis)", "Caching layer for ultra-fast multi-currency exchange rate lookups.")
}

Rel(Shopper_Reviewer, Single_Page_Application, "Accesses static assets and interacts with the UI", "HTTPS")
Rel(Store_Administrator, Single_Page_Application, "Accesses admin features via the UI", "HTTPS")
Rel(Single_Page_Application, API_Gateway_Security, "Communicates via REST APIs", "HTTPS/REST")
Rel(API_Gateway_Security, Catalogue_Service, "Routes internal traffic", "gRPC with mTLS")
Rel(API_Gateway_Security, Shopping_Cart_Checkout_Service, "Routes internal traffic", "gRPC with mTLS")
Rel(API_Gateway_Security, Review_Service, "Routes internal traffic", "gRPC with mTLS")
Rel(API_Gateway_Security, Localization_Currency_Service, "Routes internal traffic", "gRPC with mTLS")
Rel(Shopping_Cart_Checkout_Service, Payment_Gateway, "Connects for secure payment processing", "HTTPS/REST through AWS NAT Gateway")
Rel(Shopping_Cart_Checkout_Service, Shipping_Provider_APIs, "Connects for order fulfillment", "HTTPS/REST through AWS NAT Gateway")
Rel(Catalogue_Service, Amazon_Aurora_PostgreSQL, "Queries transactional data", "Internal VPC Connection")
Rel(Shopping_Cart_Checkout_Service, Amazon_Aurora_PostgreSQL, "Queries transactional checkout data", "Internal VPC Connection")
Rel(Review_Service, Amazon_Aurora_PostgreSQL, "Queries review data", "Internal VPC Connection")
Rel(Catalogue_Service, Amazon_DynamoDB, "Queries low-latency catalogue reads", "Internal VPC Connection")
Rel(Shopping_Cart_Checkout_Service, Amazon_DynamoDB, "Queries cart reads", "Internal VPC Connection")
Rel(Localization_Currency_Service, Amazon_ElastiCache, "Performs multi-currency exchange rate lookups", "Internal VPC Connection")

@enduml