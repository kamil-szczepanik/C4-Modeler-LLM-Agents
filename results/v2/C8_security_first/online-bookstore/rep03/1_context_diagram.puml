@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(ShopperReviewer, "Shopper / Reviewer", "External users browsing catalogues, managing carts, submitting reviews, and purchasing books.")
Person(StoreAdministrator, "Store Administrator", "Internal users managing inventory, order disputes, and sales metrics.")

System(OnlineBookstoreSystem, "Online Bookstore System", "A scaled-down Amazon-style e-commerce site for physical and electronic books with recommendations, reviews, and multi-currency support, providing high availability and global scalability for 1 million monthly active users.")

System_Ext(PaymentGateway, "Payment Gateway", "Stripe or PayPal handling PCI-DSS compliant transactions.")
System_Ext(ShippingProviderAPIs, "Shipping Provider APIs", "FedEx or UPS for order fulfillment.")
System_Ext(RecommendationEngine, "Recommendation Engine", "AWS Personalize providing machine-learning personalization.")
System_Ext(NotificationService, "Notification Service", "SendGrid or Twilio managing transactional emails, SMS, and MFA codes.")

Rel(ShopperReviewer, OnlineBookstoreSystem, "Browsing, checkout, and reviews", "HTTPS (TLS 1.3)")
Rel(StoreAdministrator, OnlineBookstoreSystem, "Backend management", "HTTPS (TLS 1.3) with OAuth 2.0/OIDC and MFA")
Rel(OnlineBookstoreSystem, PaymentGateway, "Secure payments with tokenization", "Outbound HTTPS/REST")
Rel(OnlineBookstoreSystem, ShippingProviderAPIs, "Fulfillment data", "Outbound HTTPS with mutual TLS (mTLS)")
Rel(OnlineBookstoreSystem, RecommendationEngine, "Personalization payloads", "Outbound HTTPS/REST")
Rel(OnlineBookstoreSystem, NotificationService, "Customer alerts", "Outbound HTTPS/REST")
@enduml