@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Order & Checkout Service container

Container_Boundary(order_checkout_service, "Order & Checkout Service") {
    Component(Order_Controller, "Order Controller", "Java, Spring Boot", "Exposes REST and gRPC endpoints to handle incoming order placement and checkout requests.")
    Component(Checkout_Service, "Checkout Service", "Java, Spring Boot", "Encapsulates business logic for validating carts, calculating totals, and coordinating payments.")
    Component(Payment_Integration_Client, "Payment Integration Client", "Java, Spring Boot, HTTPS", "Communicates with the external Payment Gateway to process tokenized payments.")
    Component(Shipping_Integration_Client, "Shipping Integration Client", "Java, Spring Boot, HTTPS", "Coordinates fulfillment operations with external Shipping Provider APIs.")
    Component(Event_Publisher, "Event Publisher", "Java, Spring Boot, AWS SDK", "Publishes domain events to Amazon SQS and Amazon EventBridge.")
}

Rel(Order_Controller, Checkout_Service, "Delegates request processing", "Method Call")
Rel(Checkout_Service, Payment_Integration_Client, "Requests payment processing", "REST/JSON over HTTPS")
Rel(Checkout_Service, Shipping_Integration_Client, "Coordinates fulfillment", "REST/JSON over HTTPS")
Rel(Checkout_Service, Event_Publisher, "Publishes domain events", "AWS SDK / HTTPS")

@enduml