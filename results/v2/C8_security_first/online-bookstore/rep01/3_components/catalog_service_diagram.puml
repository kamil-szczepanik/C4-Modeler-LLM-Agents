@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog Service container

Component(EnvoyServiceMesh, "Envoy Service Mesh", "Envoy", "Routes incoming catalog requests [gRPC over mTLS / HTTPS over TLS].")
Component_Ext(CurrencyExchangeAPI, "Currency Exchange API", "REST/JSON", "External API that fetches live exchange rates.")
Component_Ext(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL", "PostgreSQL", "Queries catalog and faceted data [PostgreSQL Wire Protocol over TLS 1.3].")
Component_Ext(AmazonElastiCacheRedis, "Amazon ElastiCache (Redis)", "Redis", "Reads and writes cached rates [RESP over TLS].")
Component_Ext(AmazonEventBridge, "Amazon EventBridge", "AWS EventBridge", "Emits book view events [HTTPS over TLS with AWS KMS].")

Container_Boundary(CatalogService, "Catalog Service") {
    Component(CatalogController, "Catalog Controller", "Express Router", "Handles incoming HTTP/gRPC requests, input validation, and asynchronous event dispatch.")
    Component(SearchBrowseEngine, "Search & Browse Engine", "TypeScript", "Manages keyword search, input sanitization, SQL queries, and metadata faceting.")
    Component(CurrencyConversionClient, "Currency Conversion Client", "TypeScript / Opossum", "Integrates with the external Currency Exchange API using a circuit breaker and Amazon ElastiCache (Redis) for cached rates.")
    Component(EventPublisher, "Event Publisher", "AWS SDK", "Emits domain events using the AWS SDK.")
}

Rel(EnvoyServiceMesh, CatalogController, "Routes incoming catalog requests", "gRPC over mTLS / HTTPS over TLS")
Rel(CatalogController, SearchBrowseEngine, "Executes internal operations", "TypeScript")
Rel(CatalogController, EventPublisher, "Dispatches domain events", "TypeScript")
Rel(SearchBrowseEngine, AmazonAuroraPostgreSQL, "Queries catalog and faceted data", "PostgreSQL Wire Protocol over TLS 1.3")
Rel(CurrencyConversionClient, CurrencyExchangeAPI, "Fetches live exchange rates", "REST/JSON over HTTPS")
Rel(CurrencyConversionClient, AmazonElastiCacheRedis, "Reads and writes cached rates", "RESP over TLS")
Rel(EventPublisher, AmazonEventBridge, "Emits book view events", "HTTPS over TLS with AWS KMS")

@enduml