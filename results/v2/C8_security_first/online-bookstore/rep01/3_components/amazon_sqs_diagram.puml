@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_sqs, "Amazon SQS") {
    Component(Order_Checkout_Service, "Order & Checkout Service", "Java, Spring Boot, AWS ECS on Fargate", "Enqueues order payloads using AWS SDK / HTTPS.")
    Component(Queue_Manager_Engine, "Queue Manager Engine", "AWS SQS Managed", "Manages message queues for asynchronous decoupling and reliability.")
    Component(Access_Control_Encryption_Module, "Access Control & Encryption Module", "AWS IAM, AWS KMS", "Validates policy and decrypts/encrypts data, enforcing least-privilege access and encryption at rest.")
    Component(Dead_Letter_Queue_DLQ_Routing_Component, "Dead Letter Queue (DLQ) Routing Component", "Amazon SQS DLQ", "Offloads failed messages for error handling and analysis.")
    Component(Inventory_Fulfillment_Service, "Inventory & Fulfillment Service", "AWS ECS on Fargate", "Dispatches queued order events via SQS Long Polling.")
    Component(Observability_Monitoring, "Observability & Monitoring", "Amazon CloudWatch, AWS X-Ray, AWS CloudTrail", "Provides scalability metrics, queue depth monitoring, and distributed tracing.")
}

Rel(Order_Checkout_Service, Queue_Manager_Engine, "Enqueues order payloads", "AWS SDK / HTTPS")
Rel(Queue_Manager_Engine, Access_Control_Encryption_Module, "Validates policy and decrypts/encrypts", "Internal AWS API")
Rel(Queue_Manager_Engine, Dead_Letter_Queue_DLQ_Routing_Component, "Offloads failed messages", "Internal AWS API")
Rel(Queue_Manager_Engine, Inventory_Fulfillment_Service, "Dispatches queued order events", "AWS SDK / SQS Long Polling")
@enduml