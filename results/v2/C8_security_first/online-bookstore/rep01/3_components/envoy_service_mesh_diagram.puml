@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Envoy Service Mesh container

Container_Boundary(envoy_service_mesh, "Envoy Service Mesh") {
    Component(Envoy_Proxy_Edge_Router, "Envoy Proxy Edge Router", "Envoy, C++", "Handles edge ingress routing, TLS termination, and forwards authenticated traffic to internal services.")
    Component(SPIFFE_SPIRE_Workload_Attestation_Agent, "SPIFFE/SPIRE Workload Attestation Agent", "SPIFFE/SPIRE", "Provides automated workload identity and issues X.509 certificates for mTLS communication.")
    Component(Authorization_Policy_Enforcer, "Authorization Policy Enforcer", "Open Policy Agent (OPA), ext_authz", "Enforces strict RBAC and fine-grained access control policies for inter-service traffic.")
}

Rel(Envoy_Proxy_Edge_Router, Authorization_Policy_Enforcer, "Validates ingress and inter-service requests via ext_authz", "gRPC / mTLS")
Rel(Envoy_Proxy_Edge_Router, SPIFFE_SPIRE_Workload_Attestation_Agent, "Retrieves mTLS certificates for secure workload identification", "API / IPC")

@enduml