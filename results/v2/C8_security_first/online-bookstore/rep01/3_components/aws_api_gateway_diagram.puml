@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS API Gateway container

Container_Boundary(aws_api_gateway, "AWS API Gateway") {
    Component(Amazon_API_Gateway, "Amazon API Gateway", "Amazon API Gateway REST/HTTP APIs", "Handles incoming API requests from clients and manages routing.")
    Component(AWS_WAF, "AWS WAF", "AWS WAF", "Provides global rate-limiting and OWASP Top-10 rule sets for security.")
    Component(AWS_Lambda, "AWS Lambda", "AWS Lambda", "Executes token validation and RBAC checks.")
    Component(Amazon_CloudWatch, "Amazon CloudWatch", "Amazon CloudWatch", "Monitors API performance, logging, and metrics.")
    Component(AWS_X_Ray, "AWS X-Ray", "AWS X-Ray", "Provides active tracing and SLA tracking for requests.")
}

Rel(AWS_WAF, Amazon_API_Gateway, "Inspects and filters incoming traffic", "")
Rel(Amazon_API_Gateway, AWS_Lambda, "Invokes token verification", "AWS Lambda Invocation / HTTPS")
Rel(Amazon_API_Gateway, Amazon_CloudWatch, "Emits logs and metrics", "")
Rel(Amazon_API_Gateway, AWS_X_Ray, "Traces request lifecycle", "")

@enduml