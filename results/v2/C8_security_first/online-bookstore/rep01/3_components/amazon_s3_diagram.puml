@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_s3, "Amazon S3") {
    Component(bookstore_assets_prod, "bookstore-assets-prod", "Amazon S3 Bucket", "Stores static frontend assets delivered via Amazon CloudFront OAC.")
    Component(bookstore_digital_products_prod, "bookstore-digital-products-prod", "Amazon S3 Bucket", "Stores digital e-book downloads accessed via 15-minute Amazon S3 Presigned URLs.")
    Component(bookstore_backups_prod, "bookstore-backups-prod", "Amazon S3 Bucket", "Stores multi-region system backups and archived assets.")
}

Rel(bookstore_assets_prod, bookstore_digital_products_prod, "Replicates data", "Amazon S3 Cross-Region Replication (CRR)")
Rel(bookstore_digital_products_prod, bookstore_backups_prod, "Replicates data", "Amazon S3 Cross-Region Replication (CRR)")

@enduml