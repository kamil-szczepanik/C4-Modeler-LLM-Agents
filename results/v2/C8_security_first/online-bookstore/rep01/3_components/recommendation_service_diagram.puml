@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Recommendation Service container

Container_Boundary(recommendation_service, "Recommendation Service") {
    Component(api_controller, "API Controller", "FastAPI module", "Manages incoming gRPC/REST traffic from the Envoy Service Mesh.")
    Component(recommendation_engine, "Recommendation Engine", "Python module", "Processes suggestion algorithms and personalization.")
    Component(recommendation_formatter, "Recommendation Formatter / Explainer", "Python module", "Appends transparency context tags (e.g., 'Because you bought X').")
    Component(event_consumer, "Event Consumer", "Asynchronous background component", "Processes real-time events.")
    ComponentDb(elasticache, "Amazon ElastiCache (Redis)", "In-memory data store", "In-memory data store for pre-computed recommendation vectors and feature caching.")
    Component(messaging, "Amazon SQS & Amazon EventBridge", "Messaging infrastructure", "Messaging infrastructure for asynchronous event streaming.")
}

Rel(api_controller, recommendation_engine, "Executes in-process logic", "Python")
Rel(recommendation_engine, elasticache, "Reads/writes cached vectors", "RESP over TCP with TLS")
Rel(messaging, event_consumer, "Delivers domain events", "HTTPS/SQS API")
Rel(event_consumer, elasticache, "Updates feature cache", "RESP over TCP with TLS")

@enduml