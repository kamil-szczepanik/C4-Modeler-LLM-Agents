@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Single-Page Application container

Container_Boundary(spa_boundary, "Single-Page Application") {
    Component(Routing_Shell_Component, "Routing & Shell Component", "React Router", "Client-side routing and route-based code splitting.")
    Component(State_Management_Component, "State Management Component", "Redux Toolkit / React Query", "Client-side caching and state synchronization.")
    Component(API_Client_Component, "API Client Component", "Axios / Fetch wrapper", "Communicates with backend APIs and manages HTTP requests.")
    Component(Error_Boundary_Component, "Error Boundary Component", "React Error Boundary", "Catches JavaScript errors anywhere in their child component tree and displays fallback UI.")
    Component(Localization_Currency_Component, "Localization & Currency Component", "i18next", "Multi-currency and multi-language internationalization.")
}

Component_Ext(AWS_API_Gateway, "AWS API Gateway", "Amazon Web Services", "API Gateway for routing client requests to backend services.")
Component_Ext(Amazon_CloudFront, "Amazon CloudFront", "Amazon Web Services", "Global CDN for low-latency edge delivery and cache invalidation of SPA assets.")

Rel(Routing_Shell_Component, State_Management_Component, "Renders", "In-memory")
Rel(Routing_Shell_Component, API_Client_Component, "Renders", "In-memory")
Rel(Routing_Shell_Component, Error_Boundary_Component, "Renders", "In-memory")
Rel(Routing_Shell_Component, Localization_Currency_Component, "Renders", "In-memory")
Rel(API_Client_Component, AWS_API_Gateway, "Interacts with", "HTTPS (TLS 1.3)")
Rel(spa_boundary, Amazon_CloudFront, "Assets served globally via", "HTTPS (TLS 1.3)")

@enduml