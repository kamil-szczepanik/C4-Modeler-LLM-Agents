@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Customer Service container

Container_Boundary(customer_service, "Customer Service") {
    Component(Profile_Handler, "Profile Handler", "Go", "Managing user account details and communication preferences.")
    Component(Support_Ticket_Manager, "Support Ticket Manager", "Go", "Handling inquiry lifecycles and agent interactions.")
    Component(Data_Access_Repository, "Data Access Repository", "Go, pgx", "Utilizing pgx for database persistence.")
    Component(Cache_Manager, "Cache Manager", "Go", "Interfacing with Amazon ElastiCache (Redis).")
    Component(Event_Publisher, "Event Publisher", "Go", "Emitting domain events to Amazon EventBridge.")
}

System_Ext(Envoy_Service_Mesh, "Envoy Service Mesh", "Ingress and mesh proxy enforcing mTLS (SPIFFE/SPIRE).")
System_Ext(Notification_Service, "Notification Service", "External Service", "External service handling ticket updates and emails.")
System_Ext(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Primary relational database with AWS KMS encryption.")
System_Ext(Amazon_EventBridge, "Amazon EventBridge", "Amazon EventBridge", "AWS event bus for asynchronous domain events.")
System_Ext(Amazon_ElastiCache_Redis, "Amazon ElastiCache (Redis)", "Amazon ElastiCache (Redis)", "In-memory cache for read-heavy customer profile metadata.")

Rel(Envoy_Service_Mesh, Profile_Handler, "Routes validated external/internal requests", "gRPC/REST over mTLS")
Rel(Support_Ticket_Manager, Notification_Service, "Triggers ticket updates and emails", "REST over HTTPS")
Rel(Data_Access_Repository, Amazon_Aurora_PostgreSQL, "Persists and queries customer data", "PostgreSQL wire protocol over TLS 1.3 with IAM authentication")
Rel(Event_Publisher, Amazon_EventBridge, "Emits asynchronous domain events", "JSON over HTTPS")
Rel(Cache_Manager, Amazon_ElastiCache_Redis, "Caches read-heavy customer profile metadata", "Redis wire protocol over TLS")

@enduml