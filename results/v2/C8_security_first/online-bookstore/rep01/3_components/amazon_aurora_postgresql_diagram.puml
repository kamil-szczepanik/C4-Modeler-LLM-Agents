@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_aurora_postgresql, "Amazon Aurora PostgreSQL") {
    Component(Aurora_Writer_Node, "Aurora Writer Node", "AWS Aurora PostgreSQL Engine", "Handles database write operations and transactions for the order, checkout, and administrative services.")
    Component(Aurora_Reader_Nodes, "Aurora Reader Nodes", "AWS Aurora PostgreSQL Engine", "Provides read-replica capabilities for scalable read operations, serving the catalog and recommendation services.")
    Component(Aurora_Storage_Volume, "Aurora Storage Volume", "Distributed Shared Storage", "Multi-AZ distributed storage volume backing the Aurora cluster for fault-tolerant persistence.")
    Component(PgBouncer_Connection_Pooler, "PgBouncer Connection Pooler", "PgBouncer Sidecar", "Connection pooling sidecar managing incoming database connections and preventing connection exhaustion.")
}

Rel(PgBouncer_Connection_Pooler, Aurora_Writer_Node, "Routes write requests", "PostgreSQL Wire Protocol")
Rel(PgBouncer_Connection_Pooler, Aurora_Reader_Nodes, "Routes read requests", "PostgreSQL Wire Protocol")
Rel(Aurora_Writer_Node, Aurora_Storage_Volume, "Persists transaction data")
Rel(Aurora_Reader_Nodes, Aurora_Storage_Volume, "Reads replicated data")
@enduml