@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Admin & Support Service container

System_Ext(Envoy_Service_Mesh, "Envoy Service Mesh", "External service mesh routing inbound requests.")
System_Ext(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Database for transactional admin and support data.")
System_Ext(Catalog_Service, "Catalog Service", "External catalog service.")
System_Ext(Order___Checkout_Service, "Order & Checkout Service", "External order and checkout service.")
System_Ext(Amazon_CloudWatch, "Amazon CloudWatch", "Log storage and monitoring.")

Container_Boundary(Admin___Support_Service, "Admin & Support Service") {
    Component(GraphQL_Gateway___Schema_Engine, "GraphQL Gateway & Schema Engine", "Node.js, Apollo Server", "Provides flexible GraphQL querying to minimize round-trips for support agents while enforcing query complexity limits.")
    Component(Authorization___Context_Middleware, "Authorization & Context Middleware", "Node.js Middleware", "Handles strict RBAC/ABAC and security context enforcement.")
    Component(Admin_Core_Domain_Module, "Admin Core Domain Module", "Node.js", "Enables catalog moderation and regional pricing management.")
    Component(Support_Core_Domain_Module, "Support Core Domain Module", "Node.js", "Handles customer support capabilities and dispute resolution.")
    Component(Audit___Compliance_Logger, "Audit & Compliance Logger", "Node.js, AWS KMS", "Ships immutable audit logs ensuring strict compliance with GDPR and CCPA.")
}

Rel(Envoy_Service_Mesh, GraphQL_Gateway___Schema_Engine, "Routes inbound requests", "gRPC over mTLS")
Rel(Admin_Core_Domain_Module, Amazon_Aurora_PostgreSQL, "Executes transactional queries", "PostgreSQL over TLS with IAM Auth")
Rel(Support_Core_Domain_Module, Amazon_Aurora_PostgreSQL, "Executes transactional queries", "PostgreSQL over TLS with IAM Auth")
Rel(Admin_Core_Domain_Module, Catalog_Service, "Synchronous RPC", "gRPC over mTLS")
Rel(Support_Core_Domain_Module, Order___Checkout_Service, "Synchronous RPC", "gRPC over mTLS")
Rel(Audit___Compliance_Logger, Amazon_CloudWatch, "Ships immutable audit logs", "HTTPS with AWS KMS")

@enduml