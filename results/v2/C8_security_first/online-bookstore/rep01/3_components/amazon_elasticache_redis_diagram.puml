@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon ElastiCache (Redis) container

Component(Order_Checkout_Service, "Order & Checkout Service", "External Client", "Reads and writes cart state.")
Component(Catalog_Service, "Catalog Service", "External Client", "Queries and updates cached catalog data.")
Component(Recommendation_Service, "Recommendation Service", "External Client", "Fetches pre-computed recommendations.")

Container_Boundary(Amazon_ElastiCache_Redis, "Amazon ElastiCache (Redis)") {
    Component(Session_Cart_Store, "Session & Cart Store", "Amazon ElastiCache (Redis) with Redis 6+ RBAC and AOF Persistence", "Manages session state and shopping carts, utilizing AWS KMS for encryption-at-rest of temporary PII.")
    Component(Catalog_Cache_Manager, "Catalog Cache Manager", "Amazon ElastiCache (Redis) with Redis 6+ RBAC", "Queries and updates cached catalog data with keyspace isolation.")
    Component(Recommendation_Cache_Component, "Recommendation Cache Component", "Amazon ElastiCache (Redis) with Redis 6+ RBAC", "Fetches pre-computed recommendations with keyspace isolation.")
}

Rel(Order_Checkout_Service, Session_Cart_Store, "Reads and writes cart state", "Redis Protocol over TLS")
Rel(Catalog_Service, Catalog_Cache_Manager, "Queries and updates cached catalog data", "Redis Protocol over TLS")
Rel(Recommendation_Service, Recommendation_Cache_Component, "Fetches pre-computed recommendations", "Redis Protocol over TLS")

@enduml