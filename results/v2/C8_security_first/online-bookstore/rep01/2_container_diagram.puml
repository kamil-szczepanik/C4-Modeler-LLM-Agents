@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore

Person(Customer, "Customer", "Customer browsing, purchasing, and interacting with the bookstore.")
Person(BookAuthorPublisher, "Book Author / Publisher", "Provider of book inventory and publishing content.")
Person(CustomerSupportAgent, "Customer Support Agent", "Support staff handling customer inquiries and disputes.")
Person(ShippingPartner, "Shipping Partner", "Logistics personnel interacting with fulfillment data.")
Person(SiteAdministrator, "Site Administrator", "Administrator managing platform content and configurations.")

System_Ext(PaymentGateway, "Payment Gateway", "External payment processing service handling tokenized transactions.")
System_Ext(ShippingProviderAPIs, "Shipping Provider APIs", "External shipping services providing automated fulfillment.")
System_Ext(NotificationService, "Notification Service", "External service for sending transactional emails and alerts.")
System_Ext(CurrencyExchangeAPI, "Currency Exchange API", "External API providing real-time currency conversion.")

System_Boundary(OnlineBookstore, "Online Bookstore") {
    Container(SinglePageApplication, "Single-Page Application", "React, Amazon S3, Amazon CloudFront", "Frontend user interface hosted globally for low-latency delivery.")
    Container(AWSAPIGateway, "AWS API Gateway", "AWS API Gateway", "Ingress gateway securing and managing incoming API requests.")
    Container(EnvoyServiceMesh, "Envoy Service Mesh", "Envoy, SPIFFE/SPIRE", "Manages internal service communication via mTLS.")
    Container(CatalogService, "Catalog Service", "Node.js, Express, AWS ECS on Fargate", "Manages book catalog browsing and search.")
    Container(OrderCheckoutService, "Order & Checkout Service", "Java, Spring Boot, AWS ECS on Fargate", "Handles secure checkout and order processing.")
    Container(RecommendationService, "Recommendation Service", "Python, FastAPI, AWS ECS on Fargate", "Provides personalized book recommendations.")
    Container(CustomerService, "Customer Service", "Go, AWS ECS on Fargate", "Manages customer-related operations.")
    Container(AdminSupportService, "Admin & Support Service", "Node.js, GraphQL, AWS ECS on Fargate", "Provides backend support for administrative and support tasks.")
    ContainerDb(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL, AWS KMS", "Primary transactional database with multi-region replication.")
    ContainerDb(AmazonElastiCacheRedis, "Amazon ElastiCache (Redis)", "Amazon ElastiCache (Redis)", "Caches shopping cart state and improves performance.")
    Container(AmazonS3, "Amazon S3", "Amazon S3", "Object storage for application assets and backups.")
    Container(AmazonEventBridge, "Amazon EventBridge", "Amazon EventBridge, AWS KMS", "Event bus for asynchronous messaging.")
    Container(AmazonSQS, "Amazon SQS", "Amazon SQS, AWS KMS", "Message queue for asynchronous processing.")
}

Rel(Customer, SinglePageApplication, "Browses catalog, manages cart, and places orders", "HTTPS (TLS 1.3)")
Rel(SiteAdministrator, SinglePageApplication, "Manages platform configuration and content", "HTTPS (TLS 1.3)")
Rel(CustomerSupportAgent, SinglePageApplication, "Handles customer support inquiries", "HTTPS (TLS 1.3)")
Rel(SinglePageApplication, AWSAPIGateway, "Makes API requests", "HTTPS (TLS 1.3)")
Rel(AWSAPIGateway, EnvoyServiceMesh, "Routes ingress traffic to internal microservices", "gRPC over mTLS")
Rel(EnvoyServiceMesh, CatalogService, "Routes catalog requests", "gRPC over mTLS")
Rel(EnvoyServiceMesh, OrderCheckoutService, "Routes order and checkout requests", "gRPC over mTLS")
Rel(EnvoyServiceMesh, RecommendationService, "Routes recommendation requests", "gRPC over mTLS")
Rel(EnvoyServiceMesh, CustomerService, "Routes customer requests", "gRPC over mTLS")
Rel(EnvoyServiceMesh, AdminSupportService, "Routes admin and support requests", "gRPC over mTLS")
Rel(OrderCheckoutService, AmazonAuroraPostgreSQL, "Reads and writes order data", "PostgreSQL Wire Protocol over TLS")
Rel(CatalogService, AmazonAuroraPostgreSQL, "Reads and writes catalog data", "PostgreSQL Wire Protocol over TLS")
Rel(OrderCheckoutService, AmazonElastiCacheRedis, "Stores shopping cart state", "Redis Protocol over TLS")
Rel(OrderCheckoutService, AmazonSQS, "Publishes order events asynchronously", "AWS SDK / HTTPS")
Rel(OrderCheckoutService, AmazonEventBridge, "Publishes domain events", "AWS SDK / HTTPS")
Rel(OrderCheckoutService, PaymentGateway, "Processes tokenized payments", "REST/JSON over HTTPS")
Rel(OrderCheckoutService, ShippingProviderAPIs, "Coordinates fulfillment and tracking", "REST/JSON over HTTPS")
Rel(CustomerService, NotificationService, "Sends transactional emails and alerts", "REST/JSON over HTTPS")
Rel(CatalogService, CurrencyExchangeAPI, "Fetches multi-currency conversion rates", "REST/JSON over HTTPS")

@enduml