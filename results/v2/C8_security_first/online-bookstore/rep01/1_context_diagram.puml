@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Online Bookstore

Person(Customer, "Customer", "End user who browses, searches, and purchases books, leaves reviews, and manages their account.")
Person(AuthorPublisher, "Book Author / Publisher", "Provider of book inventory, metadata, and publishing content.")
Person(SupportAgent, "Customer Support Agent", "Support staff handling customer inquiries, order issues, and dispute resolutions.")
Person(ShippingPartner, "Shipping Partner", "Logistics personnel interacting with fulfillment and tracking data.")
Person(Admin, "Site Administrator / Content Manager", "Administrator managing platform content, configuration, and security controls.")

System(OnlineBookstore, "Online Bookstore", "A globally scaled e-commerce platform built on AWS to provide book purchasing, recommendations, and reviews, delivering a secure, multi-currency retail experience supporting 1 million monthly active users across multiple regions.")

System_Ext(PaymentGateway, "Payment Gateway", "External payment processing service handling tokenized transactions securely.")
System_Ext(ShippingProviderAPIs, "Shipping Provider APIs", "External shipping services providing automated fulfillment and logistics.")
System_Ext(NotificationService, "Notification Service", "External service for sending transactional emails and alerts.")
System_Ext(CurrencyExchangeAPI, "Currency Exchange API", "External API providing real-time multi-currency conversion rates.")

Rel(Customer, OnlineBookstore, "Browsing, search, and checkout", "HTTPS (TLS 1.3) with OAuth 2.0/OIDC and MFA")
Rel(Admin, OnlineBookstore, "Administrative access and content management", "HTTPS (TLS 1.3) restricted via RBAC and AWS IAM")
Rel(OnlineBookstore, PaymentGateway, "Tokenized transactions", "HTTPS/REST")
Rel(OnlineBookstore, ShippingProviderAPIs, "Automated fulfillment", "HTTPS/REST")
Rel(OnlineBookstore, NotificationService, "Transactional emails", "HTTPS/SMTP")
Rel(OnlineBookstore, CurrencyExchangeAPI, "Multi-currency conversion", "HTTPS/REST")

@enduml