@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Component(CatalogService, "Catalog Service", "Microservice", "Queries catalogue items.")
Component_Ext(AmazonKinesisDataStreams, "Amazon Kinesis Data Streams", "AWS Kinesis", "Exports search telemetry for merchandising analytics.")

Container_Boundary(AmazonOpenSearch, "Amazon OpenSearch") {
    Component(RESTAPIHandlerComponent, "REST API Handler Component", "HTTPS REST API with SigV4", "Receives secure HTTPS requests via SigV4.")
    Component(SearchEngineComponent, "Search Engine Component", "Apache Lucene Core", "Executes inverted-index searches and multi-language tokenization.")
    Component(IndexManagementComponent, "Index Management Component", "OpenSearch Index Manager", "Manages shard allocation, replica sync, and snapshots.")
    Component(DataStorageComponent, "Data Storage Component", "EBS gp3 block storage with AWS KMS", "Provides encrypted block storage for search indices.")
    Component(AsyncEventEmitterComponent, "Async Event Emitter Component", "In-memory queue", "Offloads search telemetry.")
}

Rel(CatalogService, RESTAPIHandlerComponent, "Queries catalogue items", "HTTPS/JSON, TLS 1.3, SigV4")
Rel(SearchEngineComponent, DataStorageComponent, "Reads and writes data", "POSIX block I/O")
Rel(SearchEngineComponent, AsyncEventEmitterComponent, "Offloads metrics", "In-memory queue")
Rel(AsyncEventEmitterComponent, AmazonKinesisDataStreams, "Exports search telemetry", "HTTPS/JSON")
@enduml