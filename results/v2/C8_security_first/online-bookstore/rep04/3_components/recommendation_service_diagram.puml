@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Recommendation Service container

Container_Boundary(recommendation_service, "Recommendation Service") {
    Component(api_router, "API Router Component", "Python, FastAPI", "Handles incoming HTTP requests from the API Gateway and routes validated requests.")
    Component(recommendation_orchestrator, "Recommendation Orchestrator Component", "Python", "Orchestrates recommendation logic and coordinates between the external engine client and analytics components.")
    Component(external_engine_client, "External Engine Client Component", "Python, Envoy", "Queries the third-party recommendation engine with circuit breakers and secure egress.")
    Component(analytics_feedback, "Recommendation Analytics & Feedback Component", "Python, Amazon SQS / AWS EventBridge", "Emits interaction events asynchronously for non-blocking analytics.")
}

Rel(api_router, recommendation_orchestrator, "Forwards validated requests", "Internal Python function call")
Rel(recommendation_orchestrator, external_engine_client, "Queries external engine", "Internal Python function call")
Rel(recommendation_orchestrator, analytics_feedback, "Emits interaction events", "JSON over Amazon SQS / AWS EventBridge")

@enduml