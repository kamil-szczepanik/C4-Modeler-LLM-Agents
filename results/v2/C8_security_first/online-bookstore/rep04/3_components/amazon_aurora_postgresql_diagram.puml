@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon Aurora PostgreSQL container

Container_Boundary(aurora_postgresql, "Amazon Aurora PostgreSQL") {
    Component(Primary_Writer_Database_Instance, "Primary Writer Database Instance", "PostgreSQL", "Handles write operations and primary data persistence for orders and transactions.")
    Component(Read_Replica_Database_Instances, "Read Replica Database Instances", "PostgreSQL", "Handles read-only queries for catalog browsing and product details across multiple regions.")
}

Rel(Order_Checkout_Service, Primary_Writer_Database_Instance, "Performs write operations", "PostgreSQL wire protocol via TLS 1.3")
Rel(Catalog_Service, Read_Replica_Database_Instances, "Performs read operations", "PostgreSQL wire protocol via TLS 1.3")

@enduml