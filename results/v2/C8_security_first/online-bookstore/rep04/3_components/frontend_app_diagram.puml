@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Frontend App container

System_Ext(Amazon_API_Gateway, "Amazon API Gateway", "Amazon API Gateway")

Container_Boundary(Frontend_App, "Frontend App") {
    Component(React_Router, "React Router", "react-router", "Manages single-page application routing and navigation.")
    Component(Localization_Module, "Localization Module", "react-i18next", "Handles multi-language support and localization headers.")
    Component(API_Client, "API Client", "axios", "Sends HTTPS/JSON requests to the Amazon API Gateway.")
    Component(UI_Components, "UI Components", "React SPA, Tailwind/CSS-in-JS", "Renders the user interface for shoppers and administrators.")
}

Rel(React_Router, UI_Components, "Renders views based on route", "")
Rel(UI_Components, Localization_Module, "Applies multi-currency and language formatting", "")
Rel(UI_Components, API_Client, "Triggers API requests", "")
Rel(API_Client, Amazon_API_Gateway, "Sends API requests and localization headers", "HTTPS/JSON")
@enduml