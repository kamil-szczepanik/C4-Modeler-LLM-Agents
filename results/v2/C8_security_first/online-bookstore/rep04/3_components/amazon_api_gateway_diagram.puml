@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_api_gateway, "Amazon API Gateway") {
    Component(Edge_Router, "Edge Router", "Amazon API Gateway Edge Router", "Acts as the single entry point, rate limiter, and edge router for incoming traffic.")
    Component(JWT_Authorizer, "JWT Authorizer", "Native JWT Authorizer", "Provides low-latency authentication and validates JWT tokens for incoming API requests.")
}

System_Ext(Catalog_Service, "Catalog Service", "Backend service for catalog browsing")
System_Ext(Order_Checkout_Service, "Order & Checkout Service", "Backend service for shopping carts and secure checkout")
System_Ext(Recommendation_Service, "Recommendation Service", "Backend service for recommendations")

Rel(Edge_Router, JWT_Authorizer, "Validates incoming request tokens", "HTTPS")
Rel(JWT_Authorizer, Catalog_Service, "Forwards requests with validated context headers", "gRPC/HTTPS via AWS App Mesh")
Rel(JWT_Authorizer, Order_Checkout_Service, "Forwards requests with validated context headers", "gRPC/HTTPS via AWS App Mesh")
Rel(JWT_Authorizer, Recommendation_Service, "Forwards requests with validated context headers", "gRPC/HTTPS via AWS App Mesh")
@enduml