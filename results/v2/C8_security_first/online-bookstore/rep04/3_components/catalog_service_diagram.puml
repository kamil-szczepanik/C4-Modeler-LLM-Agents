@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog Service container

Container_Boundary(catalog_service, "Catalog Service") {
    Component(CatalogAPIController, "Catalog API Controller", "Express.js / Node.js", "Manages book discovery, search, pricing, and inventory status requests.")
    Component(SearchQueryEngine, "Search & Query Engine", "TypeScript", "Processes search and query operations.")
    Component(PricingInventoryAdapter, "Pricing & Inventory Adapter", "TypeScript", "Handles pricing and inventory status integrations.")
    Component(CatalogCacheManager, "Catalog Cache Manager", "Redis / Amazon ElastiCache", "Caches frequent queries and pricing to meet performance goals.")
    Component(AmazonOpenSearch, "Amazon OpenSearch", "Amazon OpenSearch", "Delivers scalable keyword search and indexing.")
    Component(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Stores relational book metadata securely.")
}

System_Ext(OrderCheckoutService, "Order & Checkout Service", "External service interacting with the Pricing & Inventory Adapter.")

Rel(CatalogAPIController, SearchQueryEngine, "In-memory TypeScript function calls")
Rel(SearchQueryEngine, AmazonOpenSearch, "HTTPS with TLS and IAM authentication")
Rel(SearchQueryEngine, AmazonAuroraPostgreSQL, "TCP with TLS and IAM authentication")
Rel(CatalogAPIController, CatalogCacheManager, "RESP over TLS to Amazon ElastiCache")
Rel(PricingInventoryAdapter, OrderCheckoutService, "gRPC over mTLS")

@enduml