@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Online Bookstore System

Person(Shopper, "Shopper", "End-user browsing catalogues, managing carts, purchasing books, and leaving reviews.")
Person(Administrator, "Administrator", "Staff managing catalogue inventory, pricing, and content moderation.")

System(Online_Bookstore_System, "Online Bookstore System", "A globally distributed, Amazon-style e-commerce platform designed to support physical and electronic book sales, personalized recommendations, and reviews.")

System_Ext(Third_Party_Payment_Gateway, "Third-Party Payment Gateway", "External PCI-DSS compliant system for secure checkout and tokenized payments.")
System_Ext(Third_Party_Shipping_Provider, "Third-Party Shipping Provider", "External logistics service handling fulfillment dispatch and tracking.")
System_Ext(Third_Party_Currency_Exchange_Service, "Third-Party Currency Exchange Service", "External provider supplying real-time conversion rates for USD, EUR, and GBP.")
System_Ext(Third_Party_Recommendation_Engine, "Third-Party Recommendation Engine", "External service powering 'Customers also bought' cross-selling features.")

Rel(Shopper, Online_Bookstore_System, "Browsing, authentication, and purchasing", "HTTPS (TLS 1.2/1.3)")
Rel(Administrator, Online_Bookstore_System, "Inventory, pricing, and content management", "HTTPS (TLS 1.2/1.3)")
Rel(Online_Bookstore_System, Third_Party_Payment_Gateway, "Tokenized payment processing", "HTTPS/REST")
Rel(Online_Bookstore_System, Third_Party_Shipping_Provider, "Fulfillment and tracking", "HTTPS/REST/Webhooks")
Rel(Online_Bookstore_System, Third_Party_Currency_Exchange_Service, "FX rates acquisition", "HTTPS/REST")
Rel(Online_Bookstore_System, Third_Party_Recommendation_Engine, "Product recommendations", "HTTPS/REST")

@enduml