@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog & Search Service container

Container_Boundary("Catalog & Search Service", "Catalog & Search Service") {
    Component("API_Router_Controller", "API Router / Controller", "Go / Node.js / Python FastAPI", "Routes incoming requests and dispatches internal queries and business logic execution.")
    Component("Search_Engine_Component", "Search Engine Component", "Go / Node.js / Python FastAPI", "Indexes and retrieves search documents.")
    Component("Catalog_Management_Component", "Catalog Management Component", "Go / Node.js / Python FastAPI", "Manages product metadata and publishes inventory and pricing mutation events.")
    Component("Event_Consumer_Publisher_Component", "Event Consumer / Publisher Component", "Go / Node.js / Python FastAPI", "Publishes and consumes catalog update events asynchronously.")
}

System_Db(Amazon_Aurora_PostgreSQL_Global_Database, "Amazon Aurora PostgreSQL Global Database", "Persists product metadata")
System_Ext(AWS_OpenSearch_Service, "AWS OpenSearch Service", "Indexes and retrieves search documents")
System_Ext(Amazon_SNS, "Amazon SNS", "Publishes inventory and pricing mutation events")
System_Ext(Amazon_SQS, "Amazon SQS", "Ingests catalog update events via polling")

Rel(API_Router_Controller, Search_Engine_Component, "Internal query dispatch and business logic execution", "REST / gRPC")
Rel(API_Router_Controller, Catalog_Management_Component, "Internal query dispatch and business logic execution", "REST / gRPC")
Rel(Catalog_Management_Component, Amazon_Aurora_PostgreSQL_Global_Database, "Persists product metadata", "SQL over TLS")
Rel(Search_Engine_Component, AWS_OpenSearch_Service, "Indexes and retrieves search documents", "HTTP over TLS, AWS SigV4")
Rel(Catalog_Management_Component, Amazon_SNS, "Publishes inventory and pricing mutation events", "HTTPS")
Rel(Amazon_SQS, Event_Consumer_Publisher_Component, "Ingests catalog update events via polling", "SQS Polling")

@enduml