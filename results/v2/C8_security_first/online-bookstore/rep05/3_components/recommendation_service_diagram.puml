@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Recommendation Service container

Container_Boundary(recommendation_service, "Recommendation Service") {
    Component(APIHandler, "API Handler", "Python / FastAPI", "Handles incoming API requests and forwards validated recommendation requests.")
    Component(RecommendationEngine, "Recommendation Engine", "Python / FastAPI", "Processes recommendation logic and reads pre-computed recommendation vectors.")
    Component(CacheIngestionWorker, "Cache & Ingestion Worker", "Go", "Processes asynchronous clickstream and order events to update cached recommendation data.")
}

System_Ext(AmazonElastiCacheRedis, "Amazon ElastiCache (Redis)", "Low-latency vector caching layer")
System_Ext(AmazonSQS, "Amazon SQS", "Asynchronous messaging queue")
System_Ext(AmazonAuroraPostgreSQLGlobalDatabase, "Amazon Aurora PostgreSQL Global Database", "Relational database for transactional metadata")

Rel(APIHandler, RecommendationEngine, "Forwards validated recommendation requests", "gRPC")
Rel(RecommendationEngine, AmazonElastiCacheRedis, "Reads pre-computed recommendation vectors", "RESP over TLS, <10ms")
Rel(AmazonSQS, CacheIngestionWorker, "Delivers asynchronous clickstream and order events", "HTTPS/SQS SDK")
Rel(CacheIngestionWorker, AmazonElastiCacheRedis, "Updates cached recommendation data", "RESP over TLS")
Rel(recommendation_service, AmazonAuroraPostgreSQLGlobalDatabase, "Reads necessary transactional metadata", "SQL over TLS")

@enduml