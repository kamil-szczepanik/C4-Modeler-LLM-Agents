@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Single Page Application container

System_Ext(amazon_cloudfront_api_gateway_alb, "Amazon CloudFront / API Gateway / ALB", "Backend services")

Container_Boundary(single_page_application, "Single Page Application") {
    Component(routing_layout_component, "Routing & Layout Component", "React Router, Zustand / React Context", "Delegates view rendering and orchestrates navigation.")
    Component(catalogue_search_component, "Catalogue & Search Component", "React", "Provides secure catalogue browsing and search capabilities.")
    Component(cart_checkout_component, "Cart & Checkout Component", "React", "Manages multi-currency cart management and checkout.")
    Component(reviews_ratings_component, "Reviews & Ratings Component", "React", "Handles user reviews and ratings.")
    Component(recommendation_component, "Recommendation Component", "React", "Delivers personalized recommendations.")
    Component(api_client_module, "API Client Module", "Axios / Fetch", "Communicates with backend endpoints securely.")
}

Rel(single_page_application, amazon_cloudfront_api_gateway_alb, "Sends API requests and fetches data", "HTTPS (REST / GraphQL)")
Rel(routing_layout_component, catalogue_search_component, "Delegates view rendering and orchestrates navigation", "React props / Context")
Rel(routing_layout_component, cart_checkout_component, "Delegates view rendering and orchestrates navigation", "React props / Context")
Rel(routing_layout_component, reviews_ratings_component, "Delegates view rendering and orchestrates navigation", "React props / Context")
Rel(routing_layout_component, recommendation_component, "Delegates view rendering and orchestrates navigation", "React props / Context")
Rel(catalogue_search_component, api_client_module, "Communicates with backend endpoints securely", "In-memory function calls")
Rel(cart_checkout_component, api_client_module, "Communicates with backend endpoints securely", "In-memory function calls")
Rel(reviews_ratings_component, api_client_module, "Communicates with backend endpoints securely", "In-memory function calls")
Rel(recommendation_component, api_client_module, "Communicates with backend endpoints securely", "In-memory function calls")

@enduml