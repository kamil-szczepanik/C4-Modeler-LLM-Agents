@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Amazon Aurora PostgreSQL Global Database", "Amazon Aurora PostgreSQL Global Database") {
    Component("Primary Database Instance (Writer)", "Primary Database Instance (Writer)", "Amazon Aurora PostgreSQL-Compatible Edition", "Handles transactional writes and maintains data consistency in us-east-1.")
    Component("Cross-Region Read Replica Instance (EU)", "Cross-Region Read Replica Instance (EU)", "Amazon Aurora PostgreSQL-Compatible Edition", "Supports local read-only traffic and low-latency catalog browsing in eu-west-1.")
    Component("Cross-Region Read Replica Instance (AP)", "Cross-Region Read Replica Instance (AP)", "Amazon Aurora PostgreSQL-Compatible Edition", "Supports local read-only traffic and low-latency catalog browsing in ap-southeast-1.")
    Component("Global Database Proxy", "Global Database Proxy", "AWS RDS Proxy", "Manages connection pooling and backend routing across all active regions.")
}

Rel("Global Database Proxy", "Primary Database Instance (Writer)", "Manages connection pooling and backend routing", "Pooled PostgreSQL connections")
Rel("Global Database Proxy", "Cross-Region Read Replica Instance (EU)", "Manages connection pooling and backend routing", "Pooled PostgreSQL connections")
Rel("Global Database Proxy", "Cross-Region Read Replica Instance (AP)", "Manages connection pooling and backend routing", "Pooled PostgreSQL connections")
Rel("Primary Database Instance (Writer)", "Cross-Region Read Replica Instance (EU)", "Replicates storage data", "AWS proprietary high-speed backbone using default encryption")
Rel("Primary Database Instance (Writer)", "Cross-Region Read Replica Instance (AP)", "Replicates storage data", "AWS proprietary high-speed backbone using default encryption")
@enduml