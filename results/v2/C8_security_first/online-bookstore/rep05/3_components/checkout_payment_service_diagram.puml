@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Checkout & Payment Service container

System_Ext(ApiGateway, "Amazon CloudFront / API Gateway / ALB", "Routes incoming client requests")
System_Ext(Database, "Amazon Aurora PostgreSQL Global Database", "Global relational database")
System_Ext(PaymentGateway, "Stripe / PayPal", "External payment providers")
System_Ext(Shipping, "FedEx / UPS", "External shipping and fulfillment providers")
System_Ext(Messaging, "Amazon SQS / SNS", "Cloud messaging and notification service")

Container_Boundary(checkout_service, "Checkout & Payment Service") {
    Component(CartManager, "Cart Manager", "Go, Redis", "Manages shopping cart persistence and state using in-memory Redis.")
    Component(CheckoutOrchestrator, "Checkout Orchestrator", "Go", "Orchestrates the secure checkout and payment transaction workflow.")
    Component(PaymentGatewayAdapter, "Payment Gateway Adapter", "Go, HTTPS", "Adapts and communicates with external payment gateways like Stripe and PayPal.")
    Component(FulfillmentIntegrationComponent, "Fulfillment Integration Component", "Go, AWS SDK, AMQP", "Integrates with external shipping providers and message queues for order fulfillment.")
}

Rel(ApiGateway, CheckoutOrchestrator, "HTTPS, gRPC / mTLS", "Requests checkout")
Rel(CheckoutOrchestrator, CartManager, "Redis protocol / In-memory", "Manages cart state")
Rel(CheckoutOrchestrator, PaymentGatewayAdapter, "Internal Function Call", "Delegates payment processing")
Rel(CheckoutOrchestrator, FulfillmentIntegrationComponent, "Internal Function Call", "Delegates fulfillment")
Rel(CheckoutOrchestrator, Database, "SQL over TLS", "Persists transaction and order data")
Rel(PaymentGatewayAdapter, PaymentGateway, "HTTPS", "Processes payments")
Rel(FulfillmentIntegrationComponent, Shipping, "HTTPS", "Coordinates shipping")
Rel(FulfillmentIntegrationComponent, Messaging, "AWS SDK / AMQP", "Publishes fulfillment events")
@enduml