@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon SQS / SNS container

Container_Boundary(amazon_sqs_sns, "Amazon SQS / SNS") {
    Component(Order SNS Topic, "Order SNS Topic", "Amazon SNS", "Publishes order placement events from the Checkout & Payment Service.")
    Component(Shipping FIFO Queue, "Shipping FIFO Queue", "Amazon SQS FIFO", "Queues order shipping events asynchronously for processing.")
    Component(Dead-Letter FIFO Queue, "Dead-Letter FIFO Queue", "Amazon SQS FIFO", "Captures failed or unprocessable shipping messages for troubleshooting.")
}

Rel(Order SNS Topic, Shipping FIFO Queue, "AWS SNS-SQS Pub/Sub")
Rel(Shipping FIFO Queue, Dead-Letter FIFO Queue, "AWS SQS Redrive Policy")

@enduml