@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon CloudFront / API Gateway / ALB container

Container_Boundary(edge_container, "Amazon CloudFront / API Gateway / ALB") {
    Component(Route53, "Route 53 DNS & Geo-Resolver", "AWS Route 53", "Handles latency-based global DNS routing and geo-resolution for multi-currency localization.")
    Component(CDN, "CDN & Edge Caching", "AWS CloudFront with Origin Shield", "Provides global CDN with TLS 1.3 termination, Origin Shield, and regional caching policies.")
    Component(APIGateway, "API Gateway & Edge Auth", "AWS API Gateway, AWS Lambda Authorizer, AWS Cognito/Auth0", "Performs JWT validation, OAuth scope checking (checkout:write), and edge authentication.")
    Component(ALB, "Internal Application Load Balancer", "AWS ALB", "Distributes internal traffic to microservices using gRPC health checks and forwards authorized traffic.")
    Component(WAF, "Security & Traffic Controls", "AWS WAF, AWS Shield Advanced", "Handles OWASP Top-10 mitigation, rate-limiting, and bot control at the edge.")
}

Rel(CDN, APIGateway, "Routes validated and WAF-inspected traffic", "HTTPS")
Rel(APIGateway, ALB, "Forwards authorized traffic with injected user context", "HTTPS")

@enduml