@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers, "Customers", "Shoppers/Readers browsing the catalogue and purchasing books globally.")
Person(Store Administrators, "Store Administrators", "Administrators managing the online bookstore system with MFA.")
System(Online Bookstore System, "Online Bookstore System", "A cloud-native e-commerce platform built to serve 1 million active users globally with high availability and regulatory compliance, providing secure catalogue browsing, multi-currency checkout, AI-driven recommendations, and automated customer data management.")
System_Ext(Stripe / PayPal, "Stripe / PayPal", "Payment Gateway for processing secure multi-currency transactions.")
System_Ext(FedEx / UPS, "FedEx / UPS", "Shipping Provider APIs for managing order deliveries.")
System_Ext(AWS Cognito / Auth0, "AWS Cognito / Auth0", "Identity Provider for user authentication and authorization.")
System_Ext(AWS SES / SendGrid, "AWS SES / SendGrid", "Notification Service for sending transactional and system emails.")

Rel(Customers, Online Bookstore System, "Interacts via Web/Mobile for browsing and purchasing", "HTTPS (TLS 1.3)")
Rel(Store Administrators, Online Bookstore System, "Manages the system using administrative interfaces with MFA", "HTTPS (TLS 1.3, MFA)")
Rel(Online Bookstore System, Stripe / PayPal, "Processes payments and handles financial transactions securely", "HTTPS/REST (OAuth 2.0, Tokenization)")
Rel(Online Bookstore System, FedEx / UPS, "Calculates shipping rates and manages order fulfillment", "HTTPS/REST (API Key/HMAC)")
Rel(Online Bookstore System, AWS Cognito / Auth0, "Authenticates users and manages identity sessions", "HTTPS/REST (OIDC / OAuth 2.0)")
Rel(Online Bookstore System, AWS SES / SendGrid, "Dispatches notifications and emails to users", "HTTPS/REST")
@enduml