@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "EU and US mobile/web clients seeking video consultations and AI symptom checking.")
Person("Licensed Clinicians", "Licensed Clinicians", "Healthcare professionals conducting video consultations and issuing e-prescriptions.")

System_Ext("Local Pharmacies", "Local Pharmacies", "EU and US pharmacies receiving e-prescription orders.")
System_Ext("Identity Providers (IdP)", "Identity Providers (IdP)", "External identity providers handling user authentication via OAuth 2.0 / OIDC.")
System_Ext("AI Triage Engine", "AI Triage Engine", "AI engine providing symptom checks and logging immutable inference records.")

System("Cross-Border Telehealth Platform", "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for patients across the EU and US under a single provider while enforcing regional data residency and compliance.")

Rel(Patients, "Cross-Border Telehealth Platform", "Interacts with the platform for video consultations and AI symptom checking", "HTTPS, WebRTC (DTLS-SRTP)")
Rel("Licensed Clinicians", "Cross-Border Telehealth Platform", "Interacts with the platform to conduct consultations and manage patient care", "HTTPS, WebRTC (DTLS-SRTP)")
Rel("Cross-Border Telehealth Platform", "Local Pharmacies", "Connects to transmit e-prescriptions using national standards and HL7 FHIR APIs", "mTLS, payload-level digital signatures")
Rel("Cross-Border Telehealth Platform", "Identity Providers (IdP)", "Authenticates users via federated authentication", "OAuth 2.0 / OIDC")
Rel("Cross-Border Telehealth Platform", "AI Triage Engine", "Sends triage requests and logs immutable inference records", "Cloud Audit Logs")

@enduml