@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(consent_manager, "Consent Manager") {
    Component(ConsentAPI Router, "Consent API Router", "Go, Gin framework", "Routes incoming gRPC compliance and consent requests.")
    Component(OPA Engine, "OPA Engine", "Open Policy Agent", "Evaluates dynamic GDPR/HIPAA compliance rules in real-time.")
    Component(Fallback Policy Cache, "Fallback Policy Cache", "SQLite, In-Memory / Local Disk", "Powers the local fallback policy cache for unstable rural connections.")
    Component(Break-Glass Mediator, "Break-Glass Mediator", "Go, Gin framework", "Handles immutable emergency access justifications.")
}

System_Ext(Regional WORM Storage, "Regional WORM Storage", "GCP Storage with regional key rings")

Rel(Consent API Router, OPA Engine, "Evaluates compliance policies", "")
Rel(Consent API Router, Fallback Policy Cache, "Reads cached local consent states", "")
Rel(Break-Glass Mediator, Regional WORM Storage, "Persists immutable emergency access justifications via HTTPS", "HTTPS")
@enduml