@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(mediasoup_sfu, "Mediasoup SFU") {
    Component(Worker_Pool, "Worker Pool", "C++ / Node.js", "Manages underlying media workers, controls transport and producer/consumer creation.")
    Component(Room_and_Signaling_Manager, "Room & Signaling Manager", "Node.js", "Handles signaling and coordinates transport and producer/consumer creation.")
    Component(Simulcast_and_Adaptation_Controller, "Simulcast & Adaptation Controller", "C++", "Controls low-bandwidth adaptation and feeds bitrate and packet loss metrics.")
    Component(Telemetry_and_Stats_Exporter, "Telemetry & Stats Exporter", "Node.js / Prometheus", "Exports QoE telemetry, connection state changes, and performance stats.")
}

Rel(Room_and_Signaling_Manager, Worker_Pool, "Controls transport and producer/consumer creation", "IPC")
Rel(Simulcast_and_Adaptation_Controller, Telemetry_and_Stats_Exporter, "Feeds bitrate and packet loss metrics", "Internal IPC")

@enduml