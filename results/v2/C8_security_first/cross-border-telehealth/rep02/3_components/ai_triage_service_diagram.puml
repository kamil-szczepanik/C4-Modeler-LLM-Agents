@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Triage Service container

Container_Boundary("ai_triage_service", "AI Triage Service") {
    Component("API_Controller", "API Controller", "Node.js", "Handles incoming triage requests and routes them within the AI Triage Service.")
    Component("Consent_Policy_Enforcer", "Consent & Policy Enforcer", "OPA/Rego", "Verifies regional permissions and enforces consent policies.")
    Component("Inference_Orchestrator", "Inference Orchestrator", "Python/LangChain", "Queries symptoms and orchestrates AI triage inference.")
    Component("Audit_Cryptographic_Signer", "Audit & Cryptographic Signer", "Python/Tink", "Writes and cryptographically signs audit logs.")
    Component("Fallback_Circuit_Breaker_Manager", "Fallback & Circuit Breaker Manager", "Python", "Manages resilience and handles async timeouts for rural fallback.")
}

System_Ext("Regional_WORM_Storage", "Regional WORM Storage", "GCP Storage")

Rel("API_Controller", "Consent_Policy_Enforcer", "Validates request permissions", "OPA/Rego")
Rel("Consent_Policy_Enforcer", "Inference_Orchestrator", "Approves execution for symptom processing", "")
Rel("Inference_Orchestrator", "Audit_Cryptographic_Signer", "Sends inference events for signing", "")
Rel("Audit_Cryptographic_Signer", "Regional_WORM_Storage", "Writes signed logs", "HTTPS, GCP IAM")

@enduml