@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Regional WORM Storage container

Container_Boundary(regional_worm_storage, "Regional WORM Storage") {
    Component(Access_Control_Policy_Enforcer, "Access Control & Policy Enforcer", "GCP Storage / Policy Engine", "Handles read/write operation requests and rejects legacy ACLs entirely.")
    Component(Uniform_Access_Enforcer, "Uniform Access Enforcer", "GCP API", "Ensures uniform access enforcement by rejecting legacy ACLs entirely.")
    Component(Encryption_Key_Manager_Interface, "Encryption & Key Manager Interface", "Internal GCP API / Google Cloud KMS", "Applies regional CMEK for data at rest.")
    Component(Immutability_Retention_Engine, "Immutability & Retention Engine", "Internal GCP API / GCP Cloud Storage", "Applies WORM lock on write and triggers object purging post-retention expiration.")
    Component(Lifecycle_Disposal_Engine, "Lifecycle & Disposal Engine", "Internal API", "Triggers object purging post-retention expiration.")
}

Rel(Access_Control_Policy_Enforcer, Uniform_Access_Enforcer, "Rejects legacy ACLs entirely", "GCP API")
Rel(Access_Control_Policy_Enforcer, Encryption_Key_Manager_Interface, "Applies regional CMEK for data at rest", "Internal GCP API")
Rel(Access_Control_Policy_Enforcer, Immutability_Retention_Engine, "Applies WORM lock on write", "Internal GCP API")
Rel(Immutability_Retention_Engine, Lifecycle_Disposal_Engine, "Triggers object purging post-retention expiration", "Internal API")

@enduml