@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Istio Service Mesh & API Gateway container

Container_Boundary(istio_container, "Istio Service Mesh & API Gateway") {
    Component(EnvoyIngressProxy, "Envoy Ingress Proxy", "Envoy proxy", "Handles edge routing, TLS termination, geo-restrictions, and mTLS enforcement.")
    Component(ExtAuthzAuthorizationFilter, "Ext_Authz Authorization Filter", "Istio Extension", "Interfacing with the Consent Manager for request authorization.")
    Component(TrafficManagementRouter, "Traffic Management Router", "Istio Service Mesh", "Manages multi-region traffic routing and rate limiting.")
}

Rel(EnvoyIngressProxy, ExtAuthzAuthorizationFilter, "Delegates request authorization", "gRPC over mTLS")
Rel(EnvoyIngressProxy, TrafficManagementRouter, "Routes traffic to regional BFFs and services", "gRPC over mTLS")

@enduml