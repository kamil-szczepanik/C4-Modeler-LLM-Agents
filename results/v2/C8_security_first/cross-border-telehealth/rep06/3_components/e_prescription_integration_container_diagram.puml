@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the E-Prescription Integration Container container

Container_Boundary(e_prescription_integration_container, "E-Prescription Integration Container") {
    Component(Prescription_Router, "Prescription Router", "Node.js, Express", "Routes incoming e-prescription requests within the integration container.")
    Component(National_Gateway_Adapter, "National Gateway Adapter", "Node.js, Express", "Dispatches prescriptions to National e-Prescription Gateways and US Pharmacy Networks using HL7 FHIR and REST over mTLS.")
    Component(Prescription_State___Event_Manager, "Prescription State & Event Manager", "Node.js, Express", "Manages prescription states and persists audit logs to Cloud SQL and publishes lifecycle events to Cloud Pub/Sub.")
    Component(Prescription_Outbox___Retry_Processor, "Prescription Outbox & Retry Processor", "Node.js, Express, BullMQ", "Handles reliable messaging and transactional outbox queues for asynchronous event processing.")
}

Rel(Prescription_Router, National_Gateway_Adapter, "Forwards prescription payloads")
Rel(Prescription_Router, Prescription_State___Event_Manager, "Updates state and tracks lifecycle")
Rel(Prescription_State___Event_Manager, Prescription_Outbox___Retry_Processor, "Queues messages for reliable delivery")

@enduml