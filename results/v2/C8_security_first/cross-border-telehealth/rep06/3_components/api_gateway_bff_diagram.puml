@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_bff, "API Gateway & BFF") {
    Component(GeoEnforcementRoutingProxy, "Geo-Enforcement & Routing Proxy", "Envoy Proxy", "Handles edge termination, TLS 1.3, regional geo-routing, rate limiting, and connection resilience.")
    Component(ConsentAuthMiddleware, "Consent & Auth Middleware", "Go", "Validates user authentication tokens and manages user consent policies.")
    Component(BFFAggregatorTransformer, "BFF Aggregator & Transformer", "Go", "Aggregates and transforms requests, routing them to downstream microservices.")
    Component(TelemetryResilienceInterceptor, "Telemetry & Resilience Interceptor", "Go", "Monitors rural network latencies, applies payload compression, circuit breaking, and distributed tracing.")
}

Rel(GeoEnforcementRoutingProxy, ConsentAuthMiddleware, "Forwards incoming traffic for token validation", "")
Rel(ConsentAuthMiddleware, BFFAggregatorTransformer, "Passes authenticated and authorized requests", "")
Rel(BFFAggregatorTransformer, TelemetryResilienceInterceptor, "Intercepts requests for tracing and resilience", "")

@enduml