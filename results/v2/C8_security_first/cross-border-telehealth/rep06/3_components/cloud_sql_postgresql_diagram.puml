@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Cloud SQL (PostgreSQL) container

Container_Boundary(cloud_sql_postgresql, "Cloud SQL (PostgreSQL)") {
    Component(PgBouncerConnectionPooler, "PgBouncer Connection Pooler", "PgBouncer", "Manages and optimizes database connection pooling for incoming requests from backend containers.")
    Component(UserandConsentManagementEngine, "User and Consent Management Engine", "PostgreSQL 15+ Database Engine", "Stores and retrieves relational user profiles and consent management data securely with Row-Level Security.")
    Component(EPrescriptionDataStore, "E-Prescription Data Store", "PostgreSQL 15+ Database Engine", "Persists structured e-prescription data with strict data isolation.")
    Component(AISymptomLogsStore, "AI Symptom Logs Store", "PostgreSQL 15+ Database Engine", "Persists symptom logs and AI model version metadata.")
}

Rel(PgBouncerConnectionPooler, UserandConsentManagementEngine, "Routes pooled queries for user profiles and consent management", "PostgreSQL Protocol over TLS 1.3")
Rel(PgBouncerConnectionPooler, EPrescriptionDataStore, "Routes queries to persist structured e-prescription data", "PostgreSQL Protocol over TLS 1.3")
Rel(PgBouncerConnectionPooler, AISymptomLogsStore, "Routes queries to persist symptom logs and model metadata", "PostgreSQL Protocol over TLS 1.3")

@enduml