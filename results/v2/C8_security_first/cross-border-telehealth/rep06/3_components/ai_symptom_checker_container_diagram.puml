@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Symptom Checker Container container

Container_Boundary("AI_Symptom_Checker_Container", "AI Symptom Checker Container") {
    Component("API Router / Triage Controller", "API Router / Triage Controller", "Python, FastAPI", "Provides lightweight, high-performance API endpoints for rapid request handling of patient symptom inputs.")
    Component("Deterministic Validation Layer", "Deterministic Validation Layer", "Python", "Enforces clinical safety guardrails and validates input data prior to inference.")
    Component("Inference Engine", "Inference Engine", "PyTorch, ONNX Runtime", "Executes localized AI models efficiently for fast inference to deliver care-urgency recommendations.")
    Component("Traceability & Audit Interceptor", "Traceability & Audit Interceptor", "Python with Cryptographic HSM-Backed Keys", "Ensures secure, tamper-proof signing of audit logs for regulatory compliance and EU MDR traceability.")
    Component("Localized AI Model Registries", "Localized AI Model Registries", "Model Registry Storage", "Stores localized AI models ensuring strict regional data isolation.")
    Component("Cloud Storage (WORM enabled)", "Cloud Storage (WORM enabled)", "Cloud Storage APIs", "Provides WORM-enabled cloud storage for immutable audit logs.")
}

Rel("API Router / Triage Controller", "Deterministic Validation Layer", "In-process Python call")
Rel("Deterministic Validation Layer", "Inference Engine", "In-process Python call")
Rel("Inference Engine", "Localized AI Model Registries", "HTTPS / gRPC")
Rel("Inference Engine", "Traceability & Audit Interceptor", "In-process hook")
Rel("Traceability & Audit Interceptor", "Cloud Storage (WORM enabled)", "Cloud Storage APIs")

@enduml