@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_EU_US, "Patients (EU/US)", "Patients located in the EU and US utilizing video consultations, e-prescriptions, and the AI symptom checker.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Clinicians who conduct video consultations and issue e-prescriptions.")
Person(Compliance_Quality_Assurance_Auditors, "Compliance / Quality Assurance Auditors", "Auditors who review platform activities and compliance logs via read-only APIs.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and the US while ensuring strict regional data residency, regulatory compliance, and resilience for unstable rural connections.")

System_Ext(External_Pharmacy_Partner_Network, "External Pharmacy / Partner Network", "External network for fulfilling prescriptions.")
System_Ext(National_e_Prescription_Gateways_EU_US_Pharmacy_Networks_HL7_FHIR, "National e-Prescription Gateways (EU) & US Pharmacy Networks (HL7 FHIR)", "External national gateways and pharmacy networks for routing prescriptions.")
System_Ext(Third_Party_Video_Relay_TURN_Network, "Third-Party Video Relay / TURN Network", "External relay and TURN network for handling video consultation media streams.")
System_Ext(External_Identity_Providers_OAuth2_OIDC, "External Identity Providers (OAuth2/OIDC)", "Identity providers managing authentication and multi-factor authentication.")
System_Ext(Localized_AI_Model_Registries, "Localized AI Model Registries", "Registries containing AI model artifacts secured for EU MDR compliance.")

Rel(Patients_EU_US, Cross_Border_Telehealth_Platform, "Accesses telehealth services via global Anycast Load Balancing", "HTTPS / WSS (TLS 1.3)")
Rel(Licensed_Clinicians, Cross_Border_Telehealth_Platform, "Conducts consultations and manages patient care", "HTTPS / WSS (TLS 1.3)")
Rel(Compliance_Quality_Assurance_Auditors, Cross_Border_Telehealth_Platform, "Reviews audit and compliance data", "IAM-restricted Read-Only APIs (R-04, R-07)")
Rel(Cross_Border_Telehealth_Platform, National_e_Prescription_Gateways_EU_US_Pharmacy_Networks_HL7_FHIR, "Submits and manages e-prescriptions", "HTTPS / REST with mTLS and signed JWTs (R-02, R-08)")
Rel(Cross_Border_Telehealth_Platform, Third_Party_Video_Relay_TURN_Network, "Relays video consultation media streams", "WebRTC / SRTP over DTLS with ephemeral tokens (R-06)")
Rel(Cross_Border_Telehealth_Platform, External_Identity_Providers_OAuth2_OIDC, "Authenticates users and verifies clinician MFA", "OAuth2 / OIDC over HTTPS")
@enduml