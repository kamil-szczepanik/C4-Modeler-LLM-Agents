@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_EU_US, "Patients (EU/US)", "Patients located in the EU and US seeking secure video consultations, e-prescriptions, and AI symptom checking.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Licensed medical professionals providing consultations and prescriptions to patients.")
Person(Regulatory_Auditors, "Regulatory Auditors", "Auditors reviewing system compliance, audit logs, and data handling practices.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides secure video consultations, e-prescriptions, and an AI symptom checker for patients across the EU and US while ensuring strict data residency and regulatory compliance.")

System_Ext(EU_National_E_Prescription_Gateways, "EU National E-Prescription Gateways", "External national gateways for managing e-prescriptions across EU nations.")
System_Ext(US_Healthcare_Networks_Pharmacies, "US Healthcare Networks/Pharmacies", "External US healthcare networks and pharmacies for prescription fulfillment and health data exchange.")
System_Ext(Federated_Identity_Providers_IdP, "Federated Identity Providers (IdP)", "External identity providers handling federated authentication via OAuth 2.0 / OIDC.")
System_Ext(AI_Model_Providers, "AI Model Providers", "External providers powering the AI symptom checker.")
System_Ext(Regional_API_Gateways, "Regional API Gateways", "Regional API gateways managing application traffic and consent.")
System_Ext(WebRTC_SFU_Media_Nodes, "WebRTC/SFU Media Nodes", "Media nodes handling video consultations via WebRTC and DTLS-SRTP.")

Rel(Patients_EU_US, Cross_Border_Telehealth_Platform, "HTTPS / TLS 1.3 for application traffic, consent management, and video consultations", "HTTPS / TLS 1.3, WebRTC")
Rel(Licensed_Clinicians, Cross_Border_Telehealth_Platform, "HTTPS / TLS 1.3 for application traffic, consent management, and video consultations", "HTTPS / TLS 1.3, WebRTC")
Rel(Cross_Border_Telehealth_Platform, EU_National_E_Prescription_Gateways, "REST / SOAP APIs for national e-prescriptions", "REST / SOAP APIs")
Rel(Cross_Border_Telehealth_Platform, US_Healthcare_Networks_Pharmacies, "HL7 FHIR APIs over HTTPS", "HL7 FHIR APIs over HTTPS")
Rel(Cross_Border_Telehealth_Platform, Federated_Identity_Providers_IdP, "OAuth 2.0 / OIDC for federated authentication", "OAuth 2.0 / OIDC")

@enduml