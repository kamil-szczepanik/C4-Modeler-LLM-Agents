@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(EnvoyProxy, "Envoy Proxy", "Envoy Proxy", "Handles edge routing, TLS termination, WAF protection, and internal routing to microservices.")
    Component(WasmLuaAuthFilter, "Wasm/Lua Auth Filter", "Wasm / Lua", "Provides in-memory synchronous validation, edge authentication, JWT validation, and dynamic consent enforcement.")
    Component(RateLimiter, "Rate Limiter", "Redis", "Performs fast edge-based rate limiting and quota checks to protect downstream AI services.")
}

Rel(EnvoyProxy, WasmLuaAuthFilter, "In-memory synchronous validation", "Function Call")
Rel(EnvoyProxy, RateLimiter, "Quota checks", "gRPC / Local Loopback")

@enduml