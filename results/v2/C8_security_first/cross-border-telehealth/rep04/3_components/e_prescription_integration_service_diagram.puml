@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the E-Prescription Integration Service container

Container_Boundary(e_prescription_integration_service, "E-Prescription Integration Service") {
    Component(Prescription_Workflow_Coordinator, "Prescription Workflow Coordinator", "Java / Spring Boot", "Coordinates prescription workflows and manages core prescription logic.")
    Component(EU_Gateway_Adapter, "EU Gateway Adapter", "Apache Camel / Java", "Submits translated prescriptions to EU National E-Prescription Gateways via REST/SOAP APIs.")
    Component(US_Interoperability_Adapter, "US Interoperability Adapter", "HAPI FHIR / Java", "Exchanges prescription data with US Healthcare Networks using HL7 FHIR APIs over HTTPS.")
    Component(Event_DLQ_Handler, "Event & DLQ Handler", "Google Cloud Pub/Sub Client / Java", "Manages failed dispatches, failure events, and regional DLQs.")
    Component(Circuit_Breaker_Manager, "Circuit Breaker Manager", "Resilience4j / Java", "Handles external network circuit-breaking to maintain care continuity during gateway failures.")
}

Rel(Prescription_Workflow_Coordinator, EU_Gateway_Adapter, "Routes EU prescriptions for translation and submission")
Rel(Prescription_Workflow_Coordinator, US_Interoperability_Adapter, "Routes US prescriptions for FHIR formatting and exchange")
Rel(Prescription_Workflow_Coordinator, Event_DLQ_Handler, "Publishes failure events and failed dispatches")
Rel(US_Interoperability_Adapter, Circuit_Breaker_Manager, "Wraps external network calls with resilience policies")

@enduml