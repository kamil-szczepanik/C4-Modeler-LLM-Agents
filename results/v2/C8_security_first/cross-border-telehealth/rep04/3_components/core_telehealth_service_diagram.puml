@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Telehealth Service container

Container_Boundary(core_telehealth_service, "Core Telehealth Service") {
    Component(AppointmentOrchestratorComponent, "Appointment Orchestrator Component", "Temporal SDK", "Powers the appointment orchestrator for resilient, long-running workflow state management over unstable networks.")
    Component(JurisdictionConsentEngineComponent, "Jurisdiction & Consent Engine Component", "Go", "Validates jurisdictional rules and consents for cross-border compliance.")
    Component(AuditTraceabilityLoggerComponent, "Audit & Traceability Logger Component", "Go / OpenTelemetry", "Logs and traces operations for regional compliance and observability.")
    Component(NotificationDispatcherComponent, "Notification Dispatcher Component", "Go / Cloud Pub/Sub", "Triggers fallback alerts and notifications.")
    Component(TimezoneLocalizationEngineComponent, "Timezone & Localization Engine Component", "Go package", "Resolves schedules, timezones, and localization requirements.")
}

Rel(AppointmentOrchestratorComponent, JurisdictionConsentEngineComponent, "Validates rules", "In-memory / gRPC")
Rel(AppointmentOrchestratorComponent, NotificationDispatcherComponent, "Triggers fallback alerts", "gRPC / Cloud Pub/Sub")
Rel(AppointmentOrchestratorComponent, TimezoneLocalizationEngineComponent, "Resolves schedules", "In-memory Go package call")

@enduml