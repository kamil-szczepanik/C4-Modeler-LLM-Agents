@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Symptom Checker Service container

Container_Boundary(ai_symptom_checker_service, "AI Symptom Checker Service") {
    Component(Symptom_Router_API, "Symptom Router API", "FastAPI / Python", "Handles incoming client requests via gRPC over mTLS and routes symptom checking workloads.")
    Component(Inference_Coordinator, "Inference Coordinator", "Python", "Manages regional inference requests and communicates securely with Vertex AI endpoints.")
    Component(Audit_Logger, "Audit Logger", "Python / Google Cloud KMS", "Records compliance and audit logs utilizing WORM Object Lock Storage and CMEK protection.")
}

Rel(Symptom_Router_API, Inference_Coordinator, "Delegates inference tasks")
Rel(Inference_Coordinator, Audit_Logger, "Triggers audit logging for inference actions")

@enduml