@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(media_streaming_container, "Media Streaming Container") {
    Component(Signaling_Session_Manager_Component, "Signaling & Session Manager Component", "Node.js / WebSockets", "Manages media signaling, session state, and authenticated room commands.")
    Component(Adaptive_Bitrate_ABR_Controller_Component, "Adaptive Bitrate (ABR) Controller Component", "C++ / WebRTC ABR", "Monitors real-time network conditions and controls video bitrate and audio-first fallback.")
    Component(Media_Relay_Encryption_Engine_Component, "Media Relay & Encryption Engine Component", "Janus WebRTC SFU / BoringSSL / libsrtp", "Handles media transport and enforces mandatory DTLS-SRTP encryption with AES-256 ciphers.")
}

System_Ext(DevOps_Monitoring_Stack, "DevOps Monitoring Stack", "External system for monitoring telemetry and alerting.")
System_Ext(GKE_UDP_NodePorts, "GKE UDP NodePorts", "External network entry points for media transport.")
System_Ext(Regional_GCP_Cloud_Storage, "Regional GCP Cloud Storage", "External storage for optional clinical audit recordings.")

Rel(Adaptive_Bitrate_ABR_Controller_Component, DevOps_Monitoring_Stack, "Real-time RTT, packet loss, and bitrate metrics", "Prometheus / HTTP")
Rel(Media_Relay_Encryption_Engine_Component, GKE_UDP_NodePorts, "ICE/STUN/TURN media transport", "DTLS-SRTP / AES-256")
Rel(Media_Relay_Encryption_Engine_Component, Regional_GCP_Cloud_Storage, "Optional clinical audit recordings", "HTTPS / CMEK")
@enduml