@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients_Clinicians, "Patients & Clinicians", "End-users accessing the platform via web and mobile frontends for secure video consultations, e-prescriptions, and AI symptom checking.")

System_Ext(EU_National_EPrescription_Gateways, "EU National E-Prescription Gateways", "External national gateways for managing e-prescriptions across EU nations.")
System_Ext(US_Healthcare_Networks_Pharmacies, "US Healthcare Networks/Pharmacies", "External US healthcare networks and pharmacies for prescription fulfillment and health data exchange.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(API_Gateway, "API Gateway", "Envoy and Google Cloud Load Balancing", "Regional entry point acting as the reverse proxy and load balancer.")
    Container(Core_Telehealth_Service, "Core Telehealth Service", "Node.js / Go container", "Manages appointments, clinician jurisdictions, and patient consent profiles.")
    Container(EPrescription_Integration_Service, "E-Prescription Integration Service", "Java / Spring Boot container", "Handles HL7 FHIR and EU national standard translations.")
    Container(AI_Symptom_Checker_Service, "AI Symptom Checker Service", "Python / FastAPI container", "Manages inference and WORM audit logging.")
    Container(Media_Streaming_Container, "Media Streaming Container", "Janus WebRTC SFU", "Handles adaptive video transcoding and DTLS-SRTP encryption.")
}

Rel(Patients_Clinicians, API_Gateway, "Secure client-to-container communication for application traffic and video consultations", "HTTPS and WSS")
Rel(API_Gateway, Core_Telehealth_Service, "Internal routing and API requests", "gRPC over mTLS")
Rel(API_Gateway, EPrescription_Integration_Service, "Internal routing for e-prescriptions", "gRPC over mTLS")
Rel(API_Gateway, AI_Symptom_Checker_Service, "Internal routing for AI inference", "gRPC over mTLS")
Rel(API_Gateway, Media_Streaming_Container, "Media signaling and streaming", "WSS / WebRTC")
Rel(Core_Telehealth_Service, EPrescription_Integration_Service, "Coordinates prescription workflows", "gRPC over mTLS")
Rel(Core_Telehealth_Service, AI_Symptom_Checker_Service, "Requests symptom analysis", "gRPC over mTLS")
Rel(EPrescription_Integration_Service, EU_National_EPrescription_Gateways, "Translates and submits e-prescriptions to EU national gateways", "REST / SOAP APIs")
Rel(EPrescription_Integration_Service, US_Healthcare_Networks_Pharmacies, "Exchanges prescription data with US networks", "HL7 FHIR APIs over HTTPS")

@enduml