@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_and_Clinicians, "Patients and Clinicians", "EU and US users interacting with the platform for consultations and healthcare services.")
Person(Compliance_Officer, "Compliance Officer", "Auditor managing regional consent and AI traceability logs.")
System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides secure video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and the US while ensuring strict regional data residency and regulatory compliance.")
System_Ext(National_E_Prescription_Gateways_EU, "National E-Prescription Gateways (EU)", "External EU gateway systems for handling electronic prescriptions.")
System_Ext(US_Pharmacy_Networks, "US Pharmacy Networks", "External US pharmacy networks for prescription fulfillment.")
System_Ext(Identity_Providers_IdP, "Identity Providers (IdP)", "External identity providers used for user authentication.")

Rel(Patients_and_Clinicians, Cross_Border_Telehealth_Platform, "Interacts for video consultations and platform features", "HTTPS, WebSockets, WebRTC")
Rel(Compliance_Officer, Cross_Border_Telehealth_Platform, "Accesses audit logs and regional consent data", "HTTPS")
Rel(Cross_Border_Telehealth_Platform, National_E_Prescription_Gateways_EU, "Connects to process electronic prescriptions", "REST/SOAP over HTTPS")
Rel(Cross_Border_Telehealth_Platform, US_Pharmacy_Networks, "Connects to process prescriptions", "HL7 FHIR over HTTPS")
Rel(Cross_Border_Telehealth_Platform, Identity_Providers_IdP, "Authenticates users", "OAuth 2.0 / OIDC")
@enduml