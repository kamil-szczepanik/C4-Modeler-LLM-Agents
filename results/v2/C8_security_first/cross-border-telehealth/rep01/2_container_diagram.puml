@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "Patients in the EU and US utilizing secure video consultations, e-prescriptions, and the AI symptom checker.")
Person(Clinicians, "Clinicians", "Medical professionals conducting video consultations and managing patient treatments.")
Person(Compliance Officer, "Compliance Officer", "Officer overseeing regulatory compliance under GDPR and HIPAA.")

System_Ext(National E-Prescription Gateways (EU), "National E-Prescription Gateways (EU)", "External national e-prescription gateways for the EU.")
System_Ext(US Pharmacy Networks, "US Pharmacy Networks", "External US pharmacy networks for prescription fulfillment.")
System_Ext(Identity Providers (IdP), "Identity Providers (IdP)", "External identity providers used for user authentication.")

System_Boundary(Cross-Border Telehealth Platform, "Cross-Border Telehealth Platform") {
    Container(API Gateway / Ingress, "API Gateway / Ingress", "Envoy / GCP HTTPS Load Balancer", "Enforces regional entry, TLS 1.3, and routing in europe-west3 and us-central1.")
    Container(Video Consultation Service, "Video Consultation Service", "Mediasoup WebRTC SFU containers", "Handles adaptive bitrate video streaming for consultations.")
    Container(AI Symptom Checker Container, "AI Symptom Checker Container", "Python / FastAPI, PyTorch", "Inference engine for patient symptom checking.")
    Container(E-Prescription Integration Container, "E-Prescription Integration Container", "Node.js, FHIR protocol adapters", "Manages e-prescriptions and integrations with external gateways and networks.")
    Container(Patient Consent & Profile Container, "Patient Consent & Profile Container", "Go", "Microservice for consent management (R-04) and event-driven revocations.")
    ContainerDb(Data Tier, "Data Tier", "Cloud SQL PostgreSQL, Memorystore with CMEK", "Region-locked data storage ensuring strict data residency.")
    Container(Messaging & Observability, "Messaging & Observability", "Google Cloud Pub/Sub, OpenTelemetry, Cloud Audit Logs", "Handles event-driven messaging, telemetry, and audit logging.")
}

Rel(Patients, API Gateway / Ingress, "Accesses video consultations, e-prescriptions, and AI symptom checker", "HTTPS / TLS 1.3, OAuth 2.0 / OIDC, FIDO2/WebAuthn")
Rel(Clinicians, API Gateway / Ingress, "Accesses consultations and patient profiles", "HTTPS / TLS 1.3, OAuth 2.0 / OIDC, FIDO2/WebAuthn")
Rel(Compliance Officer, API Gateway / Ingress, "Audits compliance, logs, and consents", "HTTPS / TLS 1.3, OAuth 2.0 / OIDC")
Rel(API Gateway / Ingress, Video Consultation Service, "Routes video consultation traffic", "gRPC over mTLS")
Rel(API Gateway / Ingress, AI Symptom Checker Container, "Routes AI inference requests", "gRPC over mTLS")
Rel(API Gateway / Ingress, E-Prescription Integration Container, "Routes prescription requests", "gRPC over mTLS")
Rel(API Gateway / Ingress, Patient Consent & Profile Container, "Routes consent and profile management requests", "gRPC over mTLS")
Rel(Video Consultation Service, Data Tier, "Reads and writes session data", "SQL with CMEK over internal GCP network")
Rel(AI Symptom Checker Container, Data Tier, "Reads and writes symptom check logs", "SQL with CMEK over internal GCP network")
Rel(E-Prescription Integration Container, Data Tier, "Persists prescription records", "SQL with CMEK over internal GCP network")
Rel(Patient Consent & Profile Container, Data Tier, "Persists consent states and user profiles", "SQL with CMEK over internal GCP network")
Rel(E-Prescription Integration Container, National E-Prescription Gateways (EU), "Transmits electronic prescriptions", "Outbound mTLS with pinned IPs and client certificates")
Rel(E-Prescription Integration Container, US Pharmacy Networks, "Transmits prescription fulfillments", "Outbound mTLS with pinned IPs and client certificates")
Rel(API Gateway / Ingress, Identity Providers (IdP), "Authenticates users", "OAuth 2.0 / OIDC")
Rel(Patient Consent & Profile Container, Messaging & Observability, "Publishes event-driven revocation events", "Google Cloud Pub/Sub")
Rel(Messaging & Observability, Video Consultation Service, "Propagates revocation events and telemetry", "Google Cloud Pub/Sub, OpenTelemetry")
Rel(Messaging & Observability, AI Symptom Checker Container, "Propagates events and telemetry", "Google Cloud Pub/Sub, OpenTelemetry")
Rel(Messaging & Observability, E-Prescription Integration Container, "Propagates events and telemetry", "Google Cloud Pub/Sub, OpenTelemetry")
@enduml