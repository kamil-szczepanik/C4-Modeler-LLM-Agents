@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway / Ingress container

Container_Boundary(api_gateway_ingress, "API Gateway / Ingress") {
    Component(edge_router_and_waf, "Edge Router and WAF", "Envoy / GCP HTTPS Load Balancer with Cloud Armor WAF", "Handles ingress routing, rate-limiting, TLS termination, and Anycast IP routing protection.")
    Component(authentication_handler, "Authentication Handler", "OAuth 2.0 / OIDC, FIDO2/WebAuthn", "Authenticates users and validates token blacklists against Google Cloud Memorystore.")
    Component(service_mesh_proxy, "Service Mesh Proxy", "Istio gRPC xDS / SPIFFE", "Manages dynamic control plane configuration and secures internal microservice communication via mTLS.")
}

System_Ext(video_consultation_service, "Video Consultation Service", "Mediasoup WebRTC SFU")
System_Ext(ai_symptom_checker_container, "AI Symptom Checker Container", "Python / FastAPI, PyTorch")
System_Ext(e_prescription_integration_container, "E-Prescription Integration Container", "Node.js, FHIR protocol adapters")
System_Ext(patient_consent_profile_container, "Patient Consent & Profile Container", "Go")
System_Ext(google_cloud_memorystore_redis, "Google Cloud Memorystore (Redis)", "Redis")

Rel(edge_router_and_waf, authentication_handler, "Validates incoming user sessions and tokens", "OAuth 2.0 / OIDC")
Rel(authentication_handler, service_mesh_proxy, "Routes authorized traffic securely", "gRPC over mTLS with SPIFFE IDs")
Rel(service_mesh_proxy, video_consultation_service, "Routes video traffic", "gRPC over mTLS with SPIFFE IDs")
Rel(service_mesh_proxy, ai_symptom_checker_container, "Routes AI inference requests", "gRPC over mTLS with SPIFFE IDs")
Rel(service_mesh_proxy, e_prescription_integration_container, "Routes prescriptions", "gRPC over mTLS with SPIFFE IDs")
Rel(service_mesh_proxy, patient_consent_profile_container, "Routes consent management", "gRPC over mTLS with SPIFFE IDs")
Rel(authentication_handler, google_cloud_memorystore_redis, "Validates token blacklists", "RESP over TLS")

@enduml