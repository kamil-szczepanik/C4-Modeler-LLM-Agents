@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("E-Prescription Integration Container", "E-Prescription Integration Container") {
    Component("Prescription Router Component", "Prescription Router Component", "Node.js, TypeScript", "Routes and dispatches prescription payloads to regional adapters.")
    Component("EU National Gateway Adapter", "EU National Gateway Adapter", "Node.js, TypeScript, europe-west3", "Dispatches regional EU formats via outbound mTLS with pinned IPs and certificates.")
    Component("US Pharmacy Network Adapter", "US Pharmacy Network Adapter", "Node.js, TypeScript, us-central1, HL7 FHIR", "Transmits HL7 FHIR payloads via outbound mTLS to US pharmacy networks.")
    Component("Outbox Pattern / Reliability Component", "Outbox Pattern / Reliability Component", "Node.js, TypeScript, Google Cloud Pub/Sub", "Handles reliable message queuing for transactional outbox pattern and event publishing.")
}

Rel("Prescription Router Component", "EU National Gateway Adapter", "Dispatches regional EU formats via outbound mTLS with pinned IPs and certificates", "mTLS")
Rel("Prescription Router Component", "US Pharmacy Network Adapter", "Transmits HL7 FHIR payloads via outbound mTLS", "mTLS / HL7 FHIR")

@enduml