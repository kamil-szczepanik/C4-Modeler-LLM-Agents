@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(messaging_observability, "Messaging & Observability") {
    Component(Event Broker Component, "Event Broker Component", "Google Cloud Pub/Sub", "Manages regional event-driven messaging and Dead-Letter Queues with CMEK.")
    Component(Telemetry Collector Component, "Telemetry Collector Component", "OpenTelemetry Collector", "Handles distributed tracing, metrics, and telemetry data masking.")
    Component(Audit Logger Component, "Audit Logger Component", "Cloud Audit Logs", "Sinks immutable audit trails via HTTPS API to Cloud Storage or BigQuery.")
}

Rel(Telemetry Collector Component, Event Broker Component, "Publishes operational telemetry events")
Rel(Audit Logger Component, Event Broker Component, "Publishes security and audit events")
@enduml