@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(ai_symptom_checker_container, "AI Symptom Checker Container") {
    Component(Resilience_Fallback_Middleware, "Resilience & Fallback Middleware", "Python / FastAPI Middleware", "Provides circuit-breaking, high availability, and graceful fallback responses for unstable connections.")
    Component(Inference_API_Router, "Inference API Router", "FastAPI", "Routes inference requests received via gRPC over mTLS from the API Gateway.")
    Component(Clinical_NLP_Preprocessing_Engine, "Clinical NLP & Preprocessing Engine", "Python", "Processes and prepares clinical text data for symptom analysis.")
    Component(PyTorch_Inference_Core_Explainability_Module, "PyTorch Inference Core & Explainability Module", "PyTorch / Python", "Executes isolated neural network inference on GPU node pools and provides explainability.")
    Component(Asynchronous_Event_Publisher, "Asynchronous Event Publisher", "Google Cloud Pub/Sub Client", "Publishes asynchronous, guaranteed-delivery immutable audit logs to external messaging infrastructure.")
}

Rel(Resilience_Fallback_Middleware, Inference_API_Router, "Intercepts and manages request resilience and fallbacks")
Rel(Inference_API_Router, Clinical_NLP_Preprocessing_Engine, "Passes routed requests for text preprocessing")
Rel(Clinical_NLP_Preprocessing_Engine, PyTorch_Inference_Core_Explainability_Module, "Sends preprocessed data for model inference")
Rel(PyTorch_Inference_Core_Explainability_Module, Asynchronous_Event_Publisher, "Triggers audit log events for inference transactions")
@enduml