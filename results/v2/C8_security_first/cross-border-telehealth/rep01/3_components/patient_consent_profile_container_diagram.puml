@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(patient_consent_and_profile_container, "Patient Consent & Profile Container") {
    Component(Consent_Controller, "Consent Controller", "Go / Fiber", "Handles incoming HTTP/gRPC requests for consent management and profile operations.")
    Component(Revocation_Manager, "Revocation Manager", "Go Service", "Manages revocation events and updates regional token blocklists.")
    Component(Consent_Cryptography_Service, "Consent Cryptography Service", "Go / GCP Cloud KMS", "Signs JWT consent receipts using regional cryptographic keys.")
}

System_Ext(Data_Tier, "Data Tier", "Cloud SQL PostgreSQL, Memorystore with CMEK")
System_Ext(Messaging_Observability, "Messaging & Observability", "Google Cloud Pub/Sub, OpenTelemetry, Cloud Audit Logs")

Rel(Consent_Controller, Consent_Cryptography_Service, "Requests cryptographic signing for consent receipts", "")
Rel(Revocation_Manager, Data_Tier, "Persists consent revocation states", "")
Rel(Revocation_Manager, Messaging_Observability, "Publishes and consumes revocation events", "")

@enduml