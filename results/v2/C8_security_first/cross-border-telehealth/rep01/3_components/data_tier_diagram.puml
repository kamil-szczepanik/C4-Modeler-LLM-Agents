@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Tier container

Container_Boundary(data_tier, "Data Tier") {
    Component(cloud_sql_postgresql, "Cloud SQL PostgreSQL", "Google Cloud SQL, PostgreSQL, Row-Level Security, WORM tables", "Relational store utilizing Row-Level Security (RLS) and append-only WORM tables for auditability with CMEK.")
    Component(memorystore_redis, "Memorystore Redis", "Google Cloud Memorystore, Redis", "Low-latency cache with pub/sub for dynamic consent token validation.")
}

Rel(cloud_sql_postgresql, memorystore_redis, "Provides backing store and caching coordination for data access.", "")

@enduml