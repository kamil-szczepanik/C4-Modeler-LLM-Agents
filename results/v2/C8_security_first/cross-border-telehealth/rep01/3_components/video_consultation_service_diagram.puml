@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Video Consultation Service", "Video Consultation Service") {
    Component("Signaling_Room_Manager_Component", "Signaling & Room Manager Component", "Node.js", "Manages WebRTC signaling and rooms, forwarding WebSocket signaling from the API gateway and provisioning transport channels.")
    Component("SFU_Media_Worker_Component", "SFU Media Worker Component", "Mediasoup / C++ core", "Handles media routing and Selective Forwarding Unit (SFU) capabilities for video consultations.")
    Component("Bandwidth_Adaptability_Controller_Component", "Bandwidth Adaptability Controller Component", "Go", "Dynamically adjusts Simulcast and SVC layers based on network conditions for low-bandwidth resilience.")
}

Rel("Signaling_Room_Manager_Component", "SFU_Media_Worker_Component", "Provisions transport channels", "IPC")
Rel("Bandwidth_Adaptability_Controller_Component", "SFU_Media_Worker_Component", "Adjusts Simulcast/SVC layers dynamically", "In-memory API")

@enduml