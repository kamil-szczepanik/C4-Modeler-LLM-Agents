@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(patients, "Patients (EU & US)", "End users managing consent, participating in telehealth sessions, and using the AI symptom checker.")
Person(clinicians, "Licensed Clinicians", "Healthcare providers delivering remote care, reviewing symptoms, and issuing e-prescriptions.")
Person(compliance_officers, "Compliance Officers", "Internal stakeholders auditing platform safety, policy enforcement, and regulatory adherence.")

System_Ext(ai_diagnostic_service, "AI Diagnostic Service", "External service for advanced patient triage and urgency recommendations.")
System_Ext(eu_us_gateways, "EU National e-Prescription Gateways & US Pharmacy Networks", "External systems for localized prescription fulfillment.")

System_Boundary(telehealth_platform, "Cross-Border Telehealth Platform") {
    Container(frontend_apps, "Frontend Client Apps", "Flutter", "Cross-platform web and mobile support for patients, clinicians, and compliance officers.")
    Container(api_gateway, "API Gateway / BFF", "Envoy / gRPC-Web", "Routes client traffic to internal containers, protected by mTLS via Anthos Service Mesh.")
    Container(video_service, "Video Consultation Service", "WebRTC / SFU - Mediasoup", "Provides secure video consultations with adaptive streaming for low-bandwidth rural users.")
    Container(ai_checker, "AI Symptom Checker Container", "Python / FastAPI", "Hosts the AI symptom checking logic for patient triage.")
    Container(eprescription_service, "E-Prescription Integration Service", "Node.js / Express", "Securely connects to external EU Gateways and US Pharmacy Networks for e-prescriptions.")
    Container(consent_engine, "Consent & Policy Engine", "Opa / Go", "Validates data access against regional GDPR and HIPAA policies before granting access to data.")
    ContainerDb(data_layer, "Data Layer", "PostgreSQL / Cloud SQL", "Stores regionalized persistent data ensuring strict data residency.")
}

Rel(patients, frontend_apps, "Interacts via HTTPS and WebRTC", "HTTPS, WebRTC")
Rel(clinicians, frontend_apps, "Interacts via HTTPS and WebRTC", "HTTPS, WebRTC")
Rel(compliance_officers, frontend_apps, "Interacts via HTTPS", "HTTPS")

Rel(frontend_apps, api_gateway, "Communicates via gRPC-Web and HTTPS", "gRPC-Web, HTTPS")

Rel(api_gateway, video_service, "Routes video traffic and requests", "gRPC, mTLS")
Rel(api_gateway, ai_checker, "Routes AI symptom checking requests", "gRPC, mTLS")
Rel(api_gateway, eprescription_service, "Routes e-prescription requests", "gRPC, mTLS")
Rel(api_gateway, consent_engine, "Requests policy validation and consent enforcement", "gRPC, mTLS")

Rel(consent_engine, data_layer, "Validates data access against regional policies", "PostgreSQL protocol, mTLS")

Rel(ai_checker, ai_diagnostic_service, "Sends triage requests with audit logging", "gRPC")
Rel(eprescription_service, eu_us_gateways, "Securely connects for prescription fulfillment", "HTTPS / Mutual TLS")

@enduml