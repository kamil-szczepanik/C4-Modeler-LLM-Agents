@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(data_layer, "Data Layer") {
    Component(Google_Cloud_SQL_PostgreSQL, "Google Cloud SQL / PostgreSQL", "Google Cloud SQL / PostgreSQL with Row-Level Security", "Core transactional storage and fine-grained access control ensuring strict data residency.")
    Component(Cloud_Bigtable, "Cloud Bigtable", "Google Cloud Bigtable", "High-throughput, immutable storage for AI audit logs and consent history.")
    Component(Cloud_Memorystore_Redis, "Cloud Memorystore / Redis", "Google Cloud Memorystore (Redis)", "Transient session caching and offline sync buffering.")
    Component(Cloud_PubSub, "Cloud Pub/Sub", "Google Cloud Pub/Sub", "CDC event streaming and messaging dispatcher.")
    Component(Cloud_KMS, "Cloud KMS", "Google Cloud KMS & IAM", "Customer-managed encryption keys, envelope encryption, and dynamic short-lived database credentials.")
}

Rel(Consent_Policy_Engine, Google_Cloud_SQL_PostgreSQL, "Access validation", "PostgreSQL protocol, mTLS")
Rel(Microservices, Google_Cloud_SQL_PostgreSQL, "Data persistence", "PostgreSQL protocol, mTLS")
Rel(Google_Cloud_SQL_PostgreSQL, Cloud_PubSub, "CDC Event stream", "gRPC")
@enduml