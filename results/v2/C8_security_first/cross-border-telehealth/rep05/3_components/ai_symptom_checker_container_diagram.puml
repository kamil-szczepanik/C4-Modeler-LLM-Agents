@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(ai_symptom_checker_container, "AI Symptom Checker Container") {
    Component(Symptom Analysis API Handler, "Symptom Analysis API Handler", "Python / FastAPI", "Exposes endpoints to receive patient symptom inputs and coordinate the preliminary diagnostic triage.")
    Component(Policy Validation Middleware, "Policy Validation Middleware", "Opa / Go", "Validates consent and regional privacy policies before processing symptom data.")
    Component(Diagnostic Integration Service, "Diagnostic Integration Service", "gRPC Client", "Communicates securely with the external AI Diagnostic Service with regional isolation.")
    Component(Audit Log Writer, "Audit Log Writer", "Python I/O", "Writes append-only audit and compliance logs to the local secure volume.")
}

Rel(Symptom Analysis API Handler, Policy Validation Middleware, "Validates requests against")
Rel(Symptom Analysis API Handler, Diagnostic Integration Service, "Forwards sanitized payload via")
Rel(Symptom Analysis API Handler, Audit Log Writer, "Records interaction traces via")
@enduml