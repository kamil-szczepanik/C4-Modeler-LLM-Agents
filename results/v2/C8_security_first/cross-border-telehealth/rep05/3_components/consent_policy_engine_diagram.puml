@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Consent & Policy Engine", "Consent & Policy Engine") {
    Component(Policy Evaluation Service, "Policy Evaluation Service", "Go, OPA Embedded", "Evaluates context-aware policies and handles policy validation requests.")
    Component(Consent Management API, "Consent Management API", "Go, Gin", "Manages consent updates and interactions with the regional consent store.")
    Component(Bundle Signer & Publisher, "Bundle Signer & Publisher", "Go", "Distributes signed OPA policy bundles to client apps.")
}

Rel(Policy Evaluation Service, Consent Management API, "Queries consent states and policy data", "Go internal/gRPC")
Rel(Bundle Signer & Publisher, Policy Evaluation Service, "Publishes signed policy bundles", "Internal")

@enduml