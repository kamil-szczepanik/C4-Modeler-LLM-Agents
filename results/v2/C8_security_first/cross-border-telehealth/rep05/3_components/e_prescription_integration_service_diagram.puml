@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(eprescription_integration_service, "E-Prescription Integration Service") {
    Component(Prescription API Controller, "Prescription API Controller", "Node.js / Express", "Handles incoming e-prescription requests routed from the API Gateway.")
    Component(Regional Adapter Engine, "Regional Adapter Engine", "TypeScript", "Invokes translation and dispatch for secure fulfillment to regional networks.")
    Component(Async Status Poller / Webhook Receiver, "Async Status Poller / Webhook Receiver", "Node.js / Express", "Receives and polls fulfillment updates and publishes them to messaging queues.")
    Component(DLQ Management & Retry Worker, "DLQ Management & Retry Worker", "Node.js / Express", "Manages dead-letter queues and re-dispatches corrected payloads.")
    Component(Audit & Telemetry Middleware, "Audit & Telemetry Middleware", "TypeScript", "Emits immutable audit trails and telemetry data.")
}

Rel(Prescription API Controller, Regional Adapter Engine, "Invokes translation and dispatch", "In-process, TypeScript")
Rel(DLQ Management & Retry Worker, Regional Adapter Engine, "Re-dispatches corrected payloads", "In-process")

@enduml