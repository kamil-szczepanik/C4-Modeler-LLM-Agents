@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_bff, "API Gateway / BFF") {
    Component(EnvoyRouterGeoRoutingFilter, "Envoy Router & Geo-Routing Filter", "Envoy Proxy / Lua / Wasm", "Handles geo-routing, rate limiting, and request routing for incoming client traffic.")
    Component(gRPCWebHandler, "gRPC-Web Handler", "gRPC-Web / Envoy", "Translates gRPC-Web requests from client apps into backend gRPC calls.")
}

Rel(EnvoyRouterGeoRoutingFilter, gRPCWebHandler, "Forwards routed requests")

@enduml