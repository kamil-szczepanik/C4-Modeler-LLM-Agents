@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(video_consultation_service, "Video Consultation Service") {
    Component(SignalingComponent, "Signaling Component", "Node.js / WebSocket", "Handles room signaling and session initiation.")
    Component(SFUMediaRouter, "SFU Media Router", "C++ / Mediasoup", "High-throughput selective forwarding unit optimized for Simulcast/SVC adaptive streaming.")
    Component(SessionAuditLogger, "Session Audit Logger", "Go", "Asynchronous metadata emission for audit purposes.")
}

Rel(SignalingComponent, SFUMediaRouter, "Manages room media streams and participant connections", "")

@enduml