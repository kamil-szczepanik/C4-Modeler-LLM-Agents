@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients (EU & US)", "End users managing consent and participating in telehealth sessions.")
Person(Clinicians, "Licensed Clinicians", "Healthcare providers delivering remote care and issuing e-prescriptions.")
Person(ComplianceOfficers, "Compliance & Quality Assurance Officers", "Internal stakeholders auditing platform safety and regulatory adherence.")

System(TelehealthPlatform, "Cross-Border Telehealth Platform", "Provides secure video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and US, enforcing strict regional data residency while enabling compliant cross-border clinician access.")

System_Ext(AIDiagnosticService, "AI Diagnostic Service", "Containerized/external service for patient triage and urgency recommendations.")
System_Ext(PrescriptionGateways, "EU National e-Prescription Gateways & US Pharmacy Networks", "External systems for localized prescription fulfillment.")

Rel(Patients, TelehealthPlatform, "Accesses web UI/API and participates in video streaming", "HTTPS, WebRTC")
Rel(Clinicians, TelehealthPlatform, "Accesses platform to deliver remote care and issue e-prescriptions", "HTTPS, WebRTC")
Rel(ComplianceOfficers, TelehealthPlatform, "Audits platform safety and regulatory adherence", "HTTPS")
Rel(TelehealthPlatform, AIDiagnosticService, "Sends low-latency triage requests with WORM audit logging", "gRPC")
Rel(TelehealthPlatform, PrescriptionGateways, "Localized prescription fulfillment", "REST / HL7 FHIR with mTLS")

@enduml