@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients (EU & US)", "End users seeking secure video consultations and AI symptom checking.")
Person(Clinicians, "Licensed Clinicians", "Medical professionals providing consultations and e-prescriptions.")

System_Ext(EU_Networks, "National E-Prescription Networks (EU)", "EU national systems for processing digital prescriptions.")
System_Ext(US_Pharmacy, "US Pharmacy Systems", "US external pharmacy systems for medication fulfillment.")
System_Ext(Immutable_Storage, "Immutable Storage", "GCP Cloud Storage WORM storing cryptographically signed AI audit logs.")

System_Boundary(Platform_Boundary, "Cross-Border Telehealth Platform") {
    Container(Web_Client, "Web/Mobile Client Application", "Flutter / React", "Cross-platform client supporting degraded-mode video and low-bandwidth adaptation.")
    Container(API_Gateway, "Cloud Load Balancing & Envoy API Gateway", "Envoy & GCP Cloud Load Balancing", "Edge routing, zero-trust network architecture (ZTNA), and low-bandwidth optimization.")
    Container(Core_Telehealth, "Core Telehealth & Consent Container", "Go", "Manages core telehealth workflows, consent, and orchestration within regional GKE clusters.")
    Container(AI_Checker, "AI Symptom Checker Container", "Python / FastAPI", "Executes AI symptom checker inference, logging, and audit metrics.")
    Container(Prescription_Integration, "Prescription Integration Container", "Go", "Handles integration with external pharmacy systems and national networks via HL7 FHIR / EU standards.")
}

Rel(Patients, Web_Client, "Interacts with platform for video consultations and AI symptom checking", "HTTPS / WebRTC")
Rel(Clinicians, Web_Client, "Conducts consultations and manages e-prescriptions", "HTTPS / WebRTC")
Rel(Web_Client, API_Gateway, "Sends requests to backend services with low-bandwidth adaptation", "HTTPS / gRPC (<300 kbit/s)")
Rel(API_Gateway, Core_Telehealth, "Routes API requests to core telehealth logic", "gRPC")
Rel(Core_Telehealth, AI_Checker, "Forwards symptom check requests for inference", "gRPC")
Rel(AI_Checker, Immutable_Storage, "Writes cryptographically signed AI audit logs with local write-ahead buffering", "HTTPS")
Rel(Prescription_Integration, EU_Networks, "Transmits e-prescriptions for EU patients", "mTLS and HTTPS (HL7 FHIR / EU standards)")
Rel(Prescription_Integration, US_Pharmacy, "Transmits pharmacy requests for US patients", "mTLS and HTTPS (HL7 FHIR)")

@enduml