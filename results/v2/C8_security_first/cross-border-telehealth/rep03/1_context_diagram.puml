@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_EU_US, "Patients (EU & US)", "End users seeking secure video consultations and AI symptom checking.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Medical professionals providing consultations and e-prescriptions.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides secure video consultations, e-prescriptions, and an AI symptom checker for patients across the EU and US while guaranteeing strict regional data residency and compliance with GDPR, HIPAA, and EU MDR.")

System_Ext(National_E_Prescription_Networks_EU, "National E-Prescription Networks (EU)", "EU national systems for processing digital prescriptions.")
System_Ext(US_Pharmacy_Systems, "US Pharmacy Systems", "US external pharmacy systems for medication fulfillment.")
System_Ext(WebRTC_SFU_Media_Relay, "WebRTC SFU Media Relay", "Selective Forwarding Unit handling real-time video and audio consultations with bandwidth adaptation.")
System_Ext(Break_Glass_Identity_Provider_IdP, "Break-Glass Identity Provider (IdP)", "Handles secure clinician and patient access, MFA, and emergency authorization.")
System_Ext(Immutable_Storage, "Immutable Storage", "GCP Bucket Lock storing cryptographically signed AI audit logs.")

Rel(Patients_EU_US, Cross_Border_Telehealth_Platform, "Accesses telehealth services, video consultations, and AI symptom checker", "HTTPS / WebRTC (TLS 1.3)")
Rel(Licensed_Clinicians, Cross_Border_Telehealth_Platform, "Conducts consultations and manages e-prescriptions", "HTTPS / WebRTC (TLS 1.3)")
Rel(Cross_Border_Telehealth_Platform, National_E_Prescription_Networks_EU, "Transmits e-prescriptions for EU patients", "mTLS over REST/SOAP")
Rel(Cross_Border_Telehealth_Platform, US_Pharmacy_Systems, "Transmits pharmacy requests and patient data for US patients", "HL7 FHIR over HTTPS (OAuth 2.0)")
Rel(Cross_Border_Telehealth_Platform, Immutable_Storage, "Writes cryptographically signed AI audit logs", "GCP Bucket Lock")
@enduml