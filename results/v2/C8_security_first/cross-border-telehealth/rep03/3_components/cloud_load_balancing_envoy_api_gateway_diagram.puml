@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(cloud_load_balancing_envoy_api_gateway, "Cloud Load Balancing & Envoy API Gateway") {
    Component(GCP_External_HTTPS_Load_Balancer, "GCP External HTTP(S) Load Balancer", "GCP Cloud Load Balancing", "Sends client requests with low-bandwidth adaptation and routes ingress traffic.")
    Component(GCP_Cloud_Armor_Security_Policy, "GCP Cloud Armor Security Policy", "GCP Cloud Armor", "Evaluates security rules and provides DDoS mitigation for regional separation.")
    Component(Envoy_Edge_Proxy, "Envoy Edge Proxy", "Envoy Proxy (WASM/Lua filters)", "Handles traffic shaping, W3C trace injection, localization, Ext-Authz, and TLS 1.3 termination.")
}

Rel(GCP_External_HTTPS_Load_Balancer, GCP_Cloud_Armor_Security_Policy, "Evaluates security rules", "HTTPS")
Rel(GCP_Cloud_Armor_Security_Policy, Envoy_Edge_Proxy, "Forwards filtered traffic", "HTTPS")
@enduml