@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(core_telehealth_consent_container, "Core Telehealth & Consent Container") {
    Component(Consent_Management_Component, "Consent Management Component", "Go", "Manages patient consent and regulatory compliance requirements.")
    Component(Consultation_Workflow_Orchestrator, "Consultation Workflow Orchestrator", "Go", "Orchestrates the telehealth consultation workflows.")
    Component(Regional_Data_Router, "Regional Data Router", "Go", "Routes data to appropriate regional data stores ensuring compliance.")
    Component(Consent_Event_Bus, "Consent Event Bus", "Go / NATS", "Publishes and distributes consent-related events internally.")
}

System_Ext(Regional_Cloud_SQL, "Regional Cloud SQL", "Regional Database")

Rel(Consent_Management_Component, Consent_Event_Bus, "Publishes events to", "")
Rel(Consent_Event_Bus, Consultation_Workflow_Orchestrator, "Triggers workflows via", "")
Rel(Regional_Data_Router, Regional_Cloud_SQL, "SQL / TLS with regional CMEK", "SQL / TLS")
@enduml