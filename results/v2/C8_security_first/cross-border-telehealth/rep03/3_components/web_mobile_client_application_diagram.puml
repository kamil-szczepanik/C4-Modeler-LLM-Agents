@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(web_mobile_client_application, "Web/Mobile Client Application") {
    Component(CrossPlatformPresentationEngine, "Cross-Platform Presentation Engine", "Flutter / React Native", "Powers cross-platform client presentation and accessibility for patients and clinicians.")
    Component(MediaStreamingClient, "Media Streaming Client", "libwebrtc", "Handles adaptive media streaming for low-bandwidth connections (<300 kbit/s).")
    Component(LocalStorageManager, "Local Storage Manager", "SQLCipher & Platform Keychains", "Secures offline PHI storage and volatile tokens.")
}

Rel(CrossPlatformPresentationEngine, MediaStreamingClient, "Initiates video consultations and streams media", "SRTP / WebRTC")
Rel(CrossPlatformPresentationEngine, LocalStorageManager, "Stores encrypted PHI and tokens offline", "Local API")

@enduml