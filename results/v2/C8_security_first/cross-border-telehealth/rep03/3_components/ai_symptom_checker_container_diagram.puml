@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("AI Symptom Checker Container", "AI Symptom Checker Container") {
    Component(API_Router_Component, "API Router Component", "FastAPI, Python", "High-performance asynchronous API routing, payload validation, and gRPC ingestion.")
    Component(Inference_Engine_Component, "Inference Engine Component", "PyTorch / ONNX Runtime", "Localized symptom analysis model execution providing automated urgency recommendations.")
    Component(Audit___Traceability_Component, "Audit & Traceability Component", "Python, In-process queue", "Dispatches and manages audit payloads to ensure regulatory compliance under EU MDR and HIPAA.")
    Component(Fallback_Cache_Component, "Fallback Cache Component", "Redis / Local LRU", "Queries cached profiles for high availability and low-latency responses.")
    Component(Immutable_Storage, "Immutable Storage", "Regional GCP Cloud Storage, GCP Cloud KMS", "Stores cryptographically signed audit logs with region-locked encryption for data residency compliance.")
}

Rel(API_Router_Component, Inference_Engine_Component, "In-process [Python function call] via gRPC ingestion")
Rel(API_Router_Component, Fallback_Cache_Component, "Queries cached profiles [In-process LRU / Redis client]")
Rel(Inference_Engine_Component, Audit___Traceability_Component, "Dispatches audit payload [In-process queue]")
Rel(Audit___Traceability_Component, Immutable_Storage, "Writes cryptographically signed audit logs [HTTPS, regional GCP Cloud Storage]")

@enduml