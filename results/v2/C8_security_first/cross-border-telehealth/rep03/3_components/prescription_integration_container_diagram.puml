@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(prescription_integration_container, "Prescription Integration Container") {
    Component(Prescription Router, "Prescription Router", "Go", "Routes prescription requests to the correct regional destination (EU National E-Prescription Networks or US Pharmacy Systems).")
    Component(FHIR Transformer, "FHIR Transformer", "Go", "Translates internal prescription payloads into HL7 FHIR standards for EU and US interoperability.")
    Component(mTLS Transport Client, "mTLS Transport Client", "Go / mTLS / HTTPS", "Secures external network transport to external national networks and pharmacies using mutual TLS and HTTPS.")
    Component(Idempotency Manager, "Idempotency Manager", "Go / GCP Memorystore (Redis)", "Tracks idempotency keys via the Redis protocol to prevent duplicate prescription dispatches.")
    Component(Async Queue Publisher, "Async Queue Publisher", "Go / GCP Pub/Sub", "Manages asynchronous message queuing for retry handling during unstable network conditions.")
}

Rel(Prescription Router, FHIR Transformer, "Transforms payload formats")
Rel(FHIR Transformer, mTLS Transport Client, "Sends secured requests")
Rel(Prescription Router, Idempotency Manager, "Checks and records idempotency keys")
Rel(Prescription Router, Async Queue Publisher, "Offloads failed requests for retry")
@enduml