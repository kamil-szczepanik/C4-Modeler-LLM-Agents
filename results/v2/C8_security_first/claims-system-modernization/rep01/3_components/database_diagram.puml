@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database container

Person(Claims_Core_Services, "Claims Core Services", "Access Client")
Person(Integration_ACA_Worker, "Integration / Anti-Corruption Layer (ACA Worker)", "Access Client")
System_Ext(Azure_Monitor, "Azure Monitor", "Monitoring and diagnostics service")

Container_Boundary(Database, "Database") {
    Component(Claims_Relational_Tables, "Claims Relational Tables", "Azure SQL Database (Provisioned Tier), Entity Framework Core", "Stores relational claim data ensuring predictable performance and sub-2-second query response times.")
    Component(Transactional_Outbox_Table, "Transactional Outbox Table", "Azure SQL Database Table", "Implements the transactional outbox pattern to ensure reliable asynchronous messaging and zero lost or duplicated claims.")
    Component(Audit_and_Reconciliation_Log_Table, "Audit and Reconciliation Log Table", "Azure SQL Database Table", "Logs auditing and diagnostic data, streaming logs to Azure Monitor to support rapid 1-day rollbacks.")
}

Rel(Claims_Core_Services, Claims_Relational_Tables, "Reads and writes claim data", "T-SQL / TDS over Private Endpoint")
Rel(Integration_ACA_Worker, Transactional_Outbox_Table, "Synchronizes legacy data and updates outbox state", "T-SQL / TDS over Private Endpoint")
Rel(Claims_Relational_Tables, Azure_Monitor, "Streams auditing and diagnostic logs", "HTTPS / TLS")

@enduml