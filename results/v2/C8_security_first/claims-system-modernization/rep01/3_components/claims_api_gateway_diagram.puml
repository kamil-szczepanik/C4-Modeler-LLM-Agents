@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(claims_api_gateway, "Claims API Gateway") {
    Component(Edge Security Component, "Edge Security Component", "Azure API Management WAF & JWT Policy", "Handles edge security, WAF, and JWT validation.")
    Component(Authorization & Context Injection Component, "Authorization & Context Injection Component", "Azure API Management CBAC Policy", "Performs authorization and context injection using CBAC policies.")
    Component(Dynamic Routing & Transformation Component, "Dynamic Routing & Transformation Component", "Azure API Management Policy Engine", "Executes dynamic routing and request transformations.")
    Component(Resiliency Component, "Resiliency Component", "Azure API Management Circuit Breaker & Diagnostics", "Provides resiliency through circuit breakers and diagnostics.")
}

Rel(Edge Security Component, Authorization & Context Injection Component, "Passes authenticated requests")
Rel(Authorization & Context Injection Component, Dynamic Routing & Transformation Component, "Passes authorized context")
Rel(Dynamic Routing & Transformation Component, Resiliency Component, "Routes filtered traffic")

@enduml