@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Customer Portal container

Container_Boundary(customer_portal, "Customer Portal") {
    Component(CustomerPortalSPA, "Customer Portal SPA", "React, TypeScript, Azure Static Web Apps", "Hosts the Single Page Application for fast global distribution and CI/CD integration, enabling customers and brokers to interact with and manage claims.")
    Component(AzureBlobStorage, "Azure Blob Storage", "Azure Blob Storage", "Stores uploaded claim documents securely via presigned URLs to offload binary payloads from the API gateway.")
    Component(ClaimsApiGateway, "Claims API Gateway", "HTTPS / REST (TLS 1.3, OAuth 2.0 / OIDC)", "Receives API requests from the Customer Portal.")
}

Rel(CustomerPortalSPA, ClaimsApiGateway, "Sends API requests", "HTTPS / REST (TLS 1.3, OAuth 2.0 / OIDC)")
Rel(CustomerPortalSPA, AzureBlobStorage, "Uploads documents securely via presigned URLs", "HTTPS")

@enduml