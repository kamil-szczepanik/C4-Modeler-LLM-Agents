@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(adjuster_web_app, "Adjuster Web App") {
    Component(Claim Workspace Shell, "Claim Workspace Shell", "React, TypeScript", "Main application layout and container for claim processing.")
    Component(BFF Proxy Layer, "BFF Proxy Layer", "Azure Static Web Apps Managed Functions", "Backend-for-Frontend proxy layer for secure data fetching.")
    Component(Optimized Claim View & Form Engine, "Optimized Claim View & Form Engine", "React, Formik, Zod", "High-performance claim view and form validation engine.")
    Component(Local Draft Cache, "Local Draft Cache", "IndexedDB, Dexie.js, Web Crypto API", "Client-side storage and encryption for offline resilience and draft caching.")
    Component(Telemetry & RUM Collector, "Telemetry & RUM Collector", "OpenTelemetry, App Insights JS SDK", "Collects and reports performance metrics and real user monitoring data.")
    Component(Mainframe Latency Handler, "Mainframe Latency Handler", "React Hooks, RxJS", "Manages asynchronous status states and bridges slow legacy mainframe responses.")
}

Rel(Claim Workspace Shell, BFF Proxy Layer, "Fetches claims", "HTTPS / REST")
Rel(Optimized Claim View & Form Engine, Local Draft Cache, "Auto-saves drafts", "IndexedDB")
Rel(Claim Workspace Shell, Telemetry & RUM Collector, "Reports performance metrics", "OpenTelemetry SDK")
Rel(Optimized Claim View & Form Engine, Mainframe Latency Handler, "Manages async status states", "React State / RxJS")
@enduml