@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Messaging container

System_Ext(ClaimsCoreServices, "Claims Core Services", "External system interacting with the messaging container.")
System_Ext(IntegrationACAWorker, "Integration ACA Worker", "Azure Container Apps (Worker)")

Container_Boundary(Messaging, "Messaging") {
    Component(ClaimEventsTopic, "Claim Events Topic", "Azure Service Bus", "Publishes claim events to downstream subscribers (`topic/claims-events`).")
    Component(MainframeSyncQueue, "Mainframe Sync Queue", "Azure Service Bus", "Queues messages for synchronization with the legacy mainframe (`queue/mainframe-sync`).")
    Component(NotificationQueue, "Notification Queue", "Azure Service Bus", "Queues notification messages for processing (`queue/notifications`).")
    Component(SchemaValidationFilter, "Schema Validation Filter", "Azure Schema Registry", "Enforces payload validation to prevent poison pills from crashing legacy systems.")
    Component(DLQManager, "DLQ Manager", "Azure Functions", "Automates DLQ triage and operational alerting for failed synchronization attempts.")
}

Rel(ClaimsCoreServices, SchemaValidationFilter, "AMQP")
Rel(SchemaValidationFilter, ClaimEventsTopic, "AMQP")
Rel(SchemaValidationFilter, MainframeSyncQueue, "AMQP")
Rel(ClaimsCoreServices, ClaimEventsTopic, "AMQP")
Rel(MainframeSyncQueue, DLQManager, "AMQP")
Rel(IntegrationACAWorker, MainframeSyncQueue, "AMQP")

@enduml