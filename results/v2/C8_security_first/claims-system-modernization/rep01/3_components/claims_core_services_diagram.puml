@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Core Services container

Container_Boundary(claims_core_services, "Claims Core Services") {
    Component(ClaimDomainModel, "Claim Domain Model / Business Engine", ".NET 8, C#", "Core business logic and domain model for modern claims processing.")
    Component(MigrationRouter, "Migration Router & Feature Toggles Component", ".NET 8", "Routes claim types and manages feature toggles for gradual migration from the mainframe.")
    Component(IdempotencyProcessor, "Idempotency & Outbox Processor", ".NET 8, EF Core", "Ensures strict idempotency and manages transactional outbox messaging.")
    Component(EventSourcedStateStore, "Event-Sourced State Store Component", ".NET 8, Azure SQL", "Stores event-sourced state for claims data with auditability.")
    Component(ResilienceComponent, "Resilience & Circuit Breaker Component", ".NET 8, Polly", "Provides resilience, circuit breaking, and graceful degradation during mainframe latency.")
}

System_Ext(ClaimsApiGateway, "Claims API Gateway", "External API Gateway")
System_Ext(AcaWorker, "Integration / Anti-Corruption Layer (ACA Worker)", "Integration worker")
System_Ext(Messaging, "Messaging", "Azure Service Bus")

Rel(ClaimsApiGateway, ResilienceComponent, "HTTPS / JSON")
Rel(ResilienceComponent, ClaimDomainModel, "In-Process")
Rel(MigrationRouter, AcaWorker, "AMQP via Azure Service Bus")
Rel(ClaimDomainModel, EventSourcedStateStore, "T-SQL / TDS")
Rel(ClaimDomainModel, IdempotencyProcessor, "In-Process")
Rel(IdempotencyProcessor, Messaging, "AMQP")

@enduml