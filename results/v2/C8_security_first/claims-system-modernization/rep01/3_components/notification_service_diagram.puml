@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification Service container

System_Ext(Claims_API_Gateway, "Claims API Gateway", "External gateway routing requests")
System_Ext(External_Gateways, "External Gateways", "Twilio / SendGrid")
System_Ext(Azure_Service_Bus_with_DLQs, "Azure Service Bus with DLQs", "Azure Service Bus")
System_Ext(Azure_SQL_Database, "Azure SQL Database", "Azure SQL Database")

Container_Boundary(Notification_Service, "Notification Service") {
    Component(Notification_API_Controller, "Notification API Controller", "ASP.NET Core / C#", "Receives routed requests using validated JWTs or mTLS.")
    Component(Notification_Dispatcher_Worker, "Notification Dispatcher Worker", "ASP.NET Core Background Service", "Consumes outbound events from Azure Service Bus and invokes the Provider Adapter Layer.")
    Component(Template_Engine, "Template Engine", "Fluid / C#", "Renders multi-channel notification templates.")
    Component(Provider_Adapter_Layer, "Provider Adapter Layer", "C#", "Interfaces internally with the dispatcher and externally with third-party gateways.")
    Component(Notification_Repository, "Notification Repository", "Entity Framework Core", "Handles data persistence for audit logs and states.")
    Component(Preference_Manager_Component, "Preference Manager Component", "C#", "Manages customer, broker, and adjuster notification preferences.")
    Component(Audit_Telemetry_Component, "Audit & Telemetry Component", "OpenTelemetry / C#", "Centralizes distributed tracing and structured JSON logging.")
    Component(Azure_Key_Vault, "Azure Key Vault", "Azure Key Vault", "Manages external provider API secrets securely via managed identities.")
}

Rel(Claims_API_Gateway, Notification_API_Controller, "Routes requests", "HTTPS / JSON")
Rel(Notification_Dispatcher_Worker, Azure_Service_Bus_with_DLQs, "Consumes outbound events", "AMQP")
Rel(Notification_Dispatcher_Worker, Provider_Adapter_Layer, "Internal invocation", "C#")
Rel(Provider_Adapter_Layer, External_Gateways, "Outbound API calls", "HTTPS / TLS 1.3")
Rel(Notification_Repository, Azure_SQL_Database, "Persists audit logs and states", "T-SQL / TDS")

@enduml