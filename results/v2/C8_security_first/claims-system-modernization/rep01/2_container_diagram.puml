@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(Customers_and_Brokers, "Customers and Brokers", "External users submitting and managing insurance claims.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal staff reviewing, processing, and settling insurance claims.")

System_Ext(Legacy_Mainframe_System_COBOL_DB2, "Legacy Mainframe System (COBOL/DB2)", "30-year-old regional insurer backend containing historical and core legacy claims data.")
System_Ext(Active_Directory_Identity_Provider, "Active Directory / Identity Provider", "Provides identity management, OIDC, and OAuth 2.0 authentication.")

System_Boundary(Modern_Claims_Platform, "Modern Claims Platform") {
    Container(Customer_Portal, "Customer Portal", "React, TypeScript, Azure Static Web Apps", "Allows customers and brokers to interact with the system via a modern SPA.")
    Container(Adjuster_Web_App, "Adjuster Web App", "React, TypeScript, Azure Static Web Apps", "Allows claims adjusters to review, process, and settle claims via a modern SPA.")
    Container(Claims_API_Gateway, "Claims API Gateway", "Azure API Management", "Enforces security, federation, and routing for incoming client requests.")
    Container(Claims_Core_Services, "Claims Core Services", "Azure Container Apps", "Handles core business logic for claims processing.")
    Container(Notification_Service, "Notification Service", "Azure Container Apps", "Handles system notifications and alerts.")
    Container(Feature_Routing_Service, "Feature/Routing Service", "Azure Container Apps", "Handles routing and feature toggles during hybrid migration.")
    Container(Integration_Anti_Corruption_Layer_ACA_Worker, "Integration / Anti-Corruption Layer (ACA Worker)", "Azure Container Apps, Worker", "Isolates legacy mainframe latency and translates data structures for hybrid operations.")
    ContainerDb(Database, "Database", "Azure SQL Database", "Provides scalable relational data storage with transactional outbox pattern.")
    Container(Messaging, "Messaging", "Azure Service Bus with DLQs", "Handles asynchronous messaging and event distribution.")
}

Rel(Customers_and_Brokers, Customer_Portal, "Interacts with and manages insurance claims", "HTTPS / REST")
Rel(Claims_Adjusters, Adjuster_Web_App, "Reviews, processes, and settles claims", "HTTPS / REST")
Rel(Customer_Portal, Claims_API_Gateway, "Sends API requests", "HTTPS / REST (TLS 1.3, OAuth 2.0 / OIDC)")
Rel(Adjuster_Web_App, Claims_API_Gateway, "Sends API requests", "HTTPS / REST (TLS 1.3, OAuth 2.0 / OIDC)")
Rel(Claims_API_Gateway, Claims_Core_Services, "Routes API requests", "HTTPS / JSON")
Rel(Claims_API_Gateway, Notification_Service, "Routes API requests", "HTTPS / JSON")
Rel(Claims_API_Gateway, Feature_Routing_Service, "Routes API requests", "HTTPS / JSON")
Rel(Integration_Anti_Corruption_Layer_ACA_Worker, Legacy_Mainframe_System_COBOL_DB2, "Interfaces with legacy backend for hybrid operations", "mTLS over IPsec VPN / ExpressRoute")
Rel(Claims_Core_Services, Messaging, "Publishes and consumes asynchronous messages", "AMQP")
Rel(Claims_Core_Services, Database, "Reads and writes claim data", "T-SQL / TDS")

@enduml