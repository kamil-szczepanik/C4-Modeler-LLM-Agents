@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Modern Claims Platform

Person(CustomersBrokers, "Customers & Brokers", "External users submitting and managing insurance claims.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal staff reviewing, processing, and settling insurance claims.")

System_Ext(LegacyMainframeSystem, "Legacy Mainframe System", "COBOL and DB2 backend containing historical and core legacy data.")
System_Ext(CoreBankingPaymentGateway, "Core Banking / Payment Gateway", "External payment system for issuing claim settlements.")
System_Ext(ActiveDirectoryIdentityProvider, "Active Directory / Identity Provider", "Provides identity management, OIDC, and OAuth 2.0 authentication.")

System_Boundary(ModernClaimsPlatform_boundary, "Modern Claims Platform") {
    System(AzureKubernetesService, "Azure Kubernetes Service", "Hosts modern cloud-native microservices.")
    System(AzurePostgreSQL, "Azure PostgreSQL", "Provides scalable, managed relational data storage.")
    System(AzureAPIGateway, "Azure API Gateway", "Enforces security, federation, RBAC, and dynamic routing.")
}

Rel(CustomersBrokers, AzureAPIGateway, "Interacts with the modern claims platform to submit and track claims", "HTTPS / TLS 1.3")
Rel(ClaimsAdjusters, AzureAPIGateway, "Manages claims and ensures sub-2-second response times", "HTTPS / TLS 1.3")
Rel(AzureAPIGateway, ActiveDirectoryIdentityProvider, "Authenticates users and enforces federation", "OIDC / OAuth 2.0")
Rel(AzureKubernetesService, LegacyMainframeSystem, "Interfaces with legacy backend for hybrid operations", "TLS 1.3 with mTLS and Azure ExpressRoute")
Rel(AzureKubernetesService, CoreBankingPaymentGateway, "Processes payouts and financial transactions", "HTTPS / REST")
Rel(AzureAPIGateway, AzureKubernetesService, "Routes requests to microservices", "Internal HTTP")
Rel(AzureKubernetesService, AzurePostgreSQL, "Reads and writes claim data", "PostgreSQL Wire Protocol")

@enduml