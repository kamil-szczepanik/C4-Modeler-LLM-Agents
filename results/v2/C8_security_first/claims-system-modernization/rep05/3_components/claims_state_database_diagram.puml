@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container(ClaimsOrchestratorContainer, "Claims Orchestrator Container", "Container", "Orchestrates claims processing.")

Container_Boundary(ClaimsStateDatabase, "Claims State Database") {
    Component(TransactionalStoreComponent, "Transactional Store Component", "Azure SQL Database (PaaS)", "Manages ACID compliance and relational integrity.")
    Component(OutboxTableComponent, "Outbox Table Component", "Azure SQL Database (PaaS)", "Implements the Transactional Outbox pattern for zero data loss.")
    Component(AuditLogComponent, "Audit Log Component", "Azure SQL Database (PaaS)", "Captures immutable change history for compliance.")
    Component(VersionedStateSchemaComponent, "Versioned State Schema Component", "Azure SQL Database (PaaS)", "Tracks metadata like source system and version for 1-day rollbacks.")
    Component(ChangeDataCaptureComponent, "Change Data Capture (CDC) Component", "Azure SQL Database (PaaS)", "Streams state changes for downstream event publishing.")
}

Rel(ClaimsOrchestratorContainer, TransactionalStoreComponent, "Reads and writes claim aggregates", "T-SQL via TDS / Azure Managed Identity, Port 1433")
Rel(ClaimsOrchestratorContainer, OutboxTableComponent, "Writes transactional events atomically", "T-SQL")
Rel(ClaimsOrchestratorContainer, VersionedStateSchemaComponent, "Reads and updates claim aggregates", "T-SQL via TDS")

@enduml