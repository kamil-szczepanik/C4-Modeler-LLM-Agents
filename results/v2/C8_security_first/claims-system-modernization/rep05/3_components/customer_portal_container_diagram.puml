@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "Azure Front Door / Azure API Management", "Acts as an API gateway for edge caching, security termination, and routing.")
System_Ext(entra_id, "Microsoft Entra ID", "Microsoft Entra ID", "Provides enterprise Single Sign-On via OpenID Connect (OIDC).")
System_Ext(blob_storage, "Azure Blob Storage", "Azure Blob Storage", "Handles large file uploads using secure SAS tokens to prevent BFF memory exhaustion.")

Container_Boundary(customer_portal_container, "Customer Portal Container") {
    Component(claim_submission_ui_controller, "Claim Submission UI Controller", "Next.js / React", "Powers frontend SSR applications and BFF layer for optimized load performance and maintainability.")
    Component(auth_component, "Auth Component", "Next.js / React", "Validates OIDC tokens with Microsoft Entra ID.")
    Component(attachment_upload_component, "Attachment Upload Component", "Next.js / React", "Streams claim attachments via SAS tokens to Azure Blob Storage.")
}

Rel(claim_submission_ui_controller, api_gateway, "API requests with OIDC token validation", "HTTPS/REST")
Rel(auth_component, entra_id, "Validates OIDC tokens", "OpenID Connect")
Rel(attachment_upload_component, blob_storage, "Streams claim attachments via SAS tokens", "HTTPS")

@enduml