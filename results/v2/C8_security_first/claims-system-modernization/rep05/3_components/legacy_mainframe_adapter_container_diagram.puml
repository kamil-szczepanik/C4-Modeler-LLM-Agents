@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Legacy Mainframe Adapter Container container

Container_Boundary("Legacy Mainframe Adapter Container", "Legacy Mainframe Adapter Container") {
    Component("Mainframe Protocol Adapter", "Mainframe Protocol Adapter", "Azure Container Apps / Node.js or .NET Core", "Handles translation between modern API requests/messages and legacy CICS/MQ protocols.")
    Component("mTLS Security Handler", "mTLS Security Handler", "Azure Key Vault / TLS", "Manages secure mTLS connections and injects RACF/SAF mainframe credentials over Site-to-Site VPN / Azure ExpressRoute.")
    Component("State & Idempotency Manager", "State & Idempotency Manager", "Azure Cosmos DB Client", "Interacts with Azure Cosmos DB to track transaction state and ensure idempotency for legacy calls.")
}

Rel("Mainframe Protocol Adapter", "mTLS Security Handler", "Secures outgoing transactions using certificates", "")
Rel("Mainframe Protocol Adapter", "State & Idempotency Manager", "Persists transaction state and idempotency tracking", "")
@enduml