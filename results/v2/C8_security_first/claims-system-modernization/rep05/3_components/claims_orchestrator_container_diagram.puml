@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Orchestrator Container container

Component_Ext(api_gateway, "API Gateway", "API Gateway", "API Gateway")
Component_Ext(azure_service_bus, "Azure Service Bus", "Azure Service Bus", "Enterprise message broker ensuring reliable asynchronous communication")
Component_Ext(claims_state_database, "Claims State Database", "Azure SQL / Azure Cosmos DB", "Claims State Database (Azure SQL / Azure Cosmos DB)")
Component_Ext(azure_app_configuration, "Azure App Configuration", "Azure App Configuration", "Stores feature flags for rapid one-day claim type rollback")

Container_Boundary(claims_orchestrator_container, "Claims Orchestrator Container") {
    Component(api_controller_layer, "API / Controller Layer", ".NET Core / C#", "API / Controller Layer")
    Component(workflow_orchestrator, "Workflow Orchestrator", "MassTransit Saga Engine", "Workflow Orchestrator (Saga Engine using MassTransit)")
    Component(domain_service_rules_engine, "Domain Service & Rules Engine", ".NET Core / C#", "Domain Service & Rules Engine")
    Component(data_access_layer, "Data Access Layer", "Entity Framework Core & Transactional Outbox", "Data Access Layer (Entity Framework Core & Transactional Outbox)")
    Component(azure_container_apps, "Azure Container Apps", "Azure Container Apps", "Azure Container Apps hosting environment")
}

Rel(api_gateway, api_controller_layer, "Routes requests", "HTTPS/REST and gRPC")
Rel(workflow_orchestrator, domain_service_rules_engine, "Evaluates business rules", "In-memory C# calls")
Rel(data_access_layer, claims_state_database, "Persists transactional state", "Database Protocol")
Rel(workflow_orchestrator, azure_service_bus, "Publishes events and saga messages", "AMQP")
Rel(workflow_orchestrator, azure_app_configuration, "Fetches feature flags for routing", "HTTPS/REST")

@enduml