@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Edge Routing Engine, "Edge Routing Engine", "Azure API Management", "Acts as the entry point and trust boundary, performing edge routing, policy enforcement, and WAF protection.")
    Component(Authentication Validator, "Authentication Validator", "Microsoft Entra ID / OIDC", "Validates incoming OIDC tokens for single sign-on and security enforcement.")
    Component(Routing Rules Manager, "Routing Rules Manager", "Azure App Configuration", "Fetches externalized declarative routing rules for zero-downtime migrations.")
    Component(Reference Data Cache Client, "Reference Data Cache Client", "Azure Cache for Redis", "Reads and writes cached reference data to mitigate mainframe latency and achieve sub-2-second screen loads.")
}

System_Ext(Claims Orchestrator Container, "Claims Orchestrator Container", "Core backend container")
System_Ext(Legacy Mainframe Adapter Container, "Legacy Mainframe Adapter Container", "Legacy mainframe adapter container")

Rel(Edge Routing Engine, Authentication Validator, "Validates OIDC tokens from incoming API requests", "HTTPS/REST")
Rel(Edge Routing Engine, Routing Rules Manager, "Fetches dynamic routing rules", "HTTPS")
Rel(Edge Routing Engine, Reference Data Cache Client, "Reads/writes cached reference data", "TCP")
Rel(Edge Routing Engine, Claims Orchestrator Container, "Routes requests to core backend", "HTTPS/REST and gRPC")
Rel(Edge Routing Engine, Legacy Mainframe Adapter Container, "Routes unmigrated claim types", "HTTPS/REST")

@enduml