@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Adjuster Web App Container container

Container_Boundary("Adjuster Web App Container", "Adjuster Web App Container") {
    Component(ui_presentation_layer, "UI Presentation Layer", "Next.js / React 18", "Dynamic adjuster views and optimistic UI patterns for reviewing and processing claims.")
    Component(bff_api_route_handlers, "BFF API Route Handlers", "Next.js API Routes", "Handles session state and token-exchange proxying.")
    Component(client_side_cache_state_manager, "Client-Side Cache & State Manager", "TanStack Query (React Query) and IndexedDB", "Provides memory-only ephemeral caching and draft persistence.")
    Component(draft_persistence_manager, "Draft Persistence Manager", "TypeScript", "Manages saving and restoring draft state.")
}

Rel(ui_presentation_layer, bff_api_route_handlers, "Internal RPC", "HTTPS")
Rel(ui_presentation_layer, draft_persistence_manager, "Save/Restore draft state", "TypeScript Function Calls")
Rel(draft_persistence_manager, bff_api_route_handlers, "Sync draft state", "HTTPS/REST")

@enduml