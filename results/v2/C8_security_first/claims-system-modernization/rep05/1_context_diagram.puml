@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Modern Insurance Platform

Person(End_Customers_Brokers, "End Customers & Brokers", "Users who submit and manage online claims.")
Person(Claims_Adjusters, "Claims Adjusters", "Users who review and process insurance claims.")
Person(Operations_Migration_Team, "Operations & Migration Team", "Team responsible for managing the hybrid migration and system operations.")

System(Modern_Insurance_Platform, "Modern Insurance Platform", "Gradually replaces a 30-year-old on-premise mainframe claims system with a modern cloud-native platform in Azure, maintaining business continuity and data consistency during a three-year hybrid migration period.")

System_Ext(Legacy_Mainframe, "Legacy Mainframe", "On-premise COBOL/DB2 system handling legacy claims and strict nightly batch windows.")
System_Ext(Microsoft_Entra_ID, "Microsoft Entra ID", "Identity Provider for authentication and authorization using OIDC/OAuth 2.0.")
System_Ext(Notification_Service, "Notification Service", "Third-party SendGrid/Twilio service for sending out notifications.")

Rel(End_Customers_Brokers, Modern_Insurance_Platform, "Submit online claims", "HTTPS (REST/GraphQL)")
Rel(Claims_Adjusters, Modern_Insurance_Platform, "Authenticate and process claims", "HTTPS (OIDC/OAuth 2.0 via Entra ID)")
Rel(Modern_Insurance_Platform, Legacy_Mainframe, "Synchronize data and process claims via secure API Gateway and asynchronous messaging", "mTLS over hybrid VPN/ExpressRoute")
Rel(Legacy_Mainframe, Modern_Insurance_Platform, "Send legacy system updates and maintain data consistency", "mTLS over hybrid VPN/ExpressRoute")
Rel(Modern_Insurance_Platform, Notification_Service, "Trigger outbound notifications", "HTTPS (REST API) via event-driven messaging")

@enduml