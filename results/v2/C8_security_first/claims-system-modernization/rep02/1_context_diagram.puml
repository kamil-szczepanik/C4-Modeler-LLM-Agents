@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Policyholders_and_Brokers, "Policyholders and Brokers", "External users interacting with the cloud-based user experience.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal users utilizing high-performance adjuster screens.")
System(Modern_Claims_Platform, "Modern Claims Platform", "A hybrid architecture gradually modernizing a legacy insurance claims platform over three years, decoupling the new cloud-based user experience from the on-premises mainframe system of record.")
System_Ext(Legacy_Mainframe, "Legacy Mainframe", "On-premises COBOL/DB2 System of Record.")
System_Ext(Identity_Provider, "Identity Provider", "Azure Active Directory / Entra ID handling authentication with MFA and OAuth2/JWT tokens.")
System_Ext(Anti_Corruption_Layer, "Anti-Corruption Layer", "Azure Service Bus and Azure API Management insulating the mainframe and handling messaging.")

Rel(Policyholders_and_Brokers, Modern_Claims_Platform, "Accesses user experience and submits insurance claims", "HTTPS (REST/GraphQL) with OIDC/OAuth2")
Rel(Claims_Adjusters, Modern_Claims_Platform, "Uses high-performance adjuster screens to manage claims", "HTTPS (REST/GraphQL) with OIDC/OAuth2")
Rel(Modern_Claims_Platform, Legacy_Mainframe, "Synchronizes and processes data securely", "mTLS (TLS 1.3) over secure hybrid connection")
Rel(Modern_Claims_Platform, Anti_Corruption_Layer, "Routes requests and manages integration via Strangler Fig pattern", "Azure Service Bus and Azure API Management")
Rel(Modern_Claims_Platform, Identity_Provider, "Authenticates users and validates tokens", "Azure AD / Entra ID with OAuth2/JWT")

@enduml