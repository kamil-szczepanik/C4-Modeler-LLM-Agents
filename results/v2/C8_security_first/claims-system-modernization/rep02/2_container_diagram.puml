@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Modern Claims Platform

Person(PolicyholdersAndBrokers, "Policyholders and Brokers", "External users interacting with the cloud-based user experience to submit insurance claims.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal users utilizing high-performance adjuster screens to manage and process claims.")

System_Ext(OnPremisesCOBOLDB2Mainframe, "On-Premises COBOL/DB2 Mainframe", "On-premises System of Record maintaining core insurance data.")
System_Ext(AzureActiveDirectory, "Azure Active Directory", "Identity Provider handling authentication via OIDC/OAuth2 and Azure Managed Identities.")

System_Boundary(ModernClaimsPlatform, "Modern Claims Platform") {
    Container(CustomerPortal, "Customer Portal", "React SPA / Azure Container Apps", "Provides a responsive, modern frontend for customer claim submissions.")
    Container(AdjusterWorkspace, "Adjuster Workspace", "Node.js/Java / Azure Container Apps", "Delivers adjuster workspaces for managing and processing claims.")
    Container(AntiCorruptionLayer, "Anti-Corruption Layer", "ACA Integration Service", "Insulates the legacy mainframe and integrates communication services.")
    Container(MigrationAnalyticsContainer, "Migration Analytics Container", "Node.js/Python / Azure Container Apps", "Monitors and analyzes the step-by-step migration of claim types.")
    Container(AzureServiceBus, "Azure Service Bus", "Azure Service Bus", "Ensures asynchronous, guaranteed event delivery and message brokering.")
}

Rel(PolicyholdersAndBrokers, CustomerPortal, "Interacts with and submits claims", "HTTPS/TLS 1.3")
Rel(ClaimsAdjusters, AdjusterWorkspace, "Interacts with and manages claims", "HTTPS")
Rel(CustomerPortal, AzureServiceBus, "Publishes and subscribes to events", "AMQP")
Rel(AdjusterWorkspace, AzureServiceBus, "Publishes and subscribes to events", "AMQP")
Rel(AntiCorruptionLayer, AzureServiceBus, "Integrates messaging events", "AMQP")
Rel(AntiCorruptionLayer, OnPremisesCOBOLDB2Mainframe, "Integrates services securely", "Mutual TLS (mTLS) over Azure ExpressRoute")
Rel(CustomerPortal, AzureActiveDirectory, "Authenticates users", "OIDC/OAuth2")
Rel(AdjusterWorkspace, AzureActiveDirectory, "Authenticates users", "OIDC/OAuth2")

@enduml