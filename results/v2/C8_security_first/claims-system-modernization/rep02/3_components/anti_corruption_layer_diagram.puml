@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Anti-Corruption Layer container

System_Ext(AzureServiceBus, "Azure Service Bus", "Messaging broker using AMQP")
System_Ext(Mainframe, "On-Premises COBOL/DB2 Mainframe", "Legacy system of record accessed via CICS Transaction Gateway")

Container_Boundary(AntiCorruptionLayer, "Anti-Corruption Layer") {
    Component(RoutingMediator, "Routing Mediator", "Spring Cloud Gateway / .NET Yarp", "Handles dynamic traffic steering, routing, and circuit breaking for incoming requests.")
    Component(DomainTranslator, "Domain Translator", "Apache Camel / custom mapping engine", "Translates JSON payloads to COBOL copybooks and vice versa.")
    Component(OutboxProcessor, "Outbox Processor", "Azure Service Bus / Custom Processor", "Enforces transactional outbox patterns for reliable message publishing.")
    Component(DLQManagement, "DLQ Management", "Azure Service Bus / DLQ Handler", "Processes poisoned messages and manages dead-letter queues.")
    Component(TelemetryPublisher, "Telemetry Publisher", "OpenTelemetry & Azure Monitor", "Publishes centralized hybrid observability and business metric telemetry.")
}

Rel(RoutingMediator, DomainTranslator, "Forwards requests", "gRPC")
Rel(DomainTranslator, Mainframe, "Translates and sends requests", "Mutual TLS over Azure ExpressRoute / CICS Transaction Gateway")
Rel(DLQManagement, AzureServiceBus, "Processes poisoned messages", "AMQP")
@enduml