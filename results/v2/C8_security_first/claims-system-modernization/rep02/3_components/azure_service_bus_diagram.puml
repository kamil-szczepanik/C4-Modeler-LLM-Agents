@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component Diagram for the Azure Service Bus container

Container_Boundary(azure_service_bus, "Azure Service Bus") {
    Component(ClaimEventPublisher, "Claim Event Publisher", "AMQP 1.0 / Azure Service Bus Sessions", "Publishes claim submission events from the Customer Portal.")
    Component(ClaimProcessingManager, "Claim Processing Manager", "AMQP 1.0 / VNet Integration", "Handles publish and subscribe operations for claim processing events with the Adjuster Workspace.")
    Component(IntegrationQueueRelay, "Integration Queue Relay", "AMQP 1.0 / ExpressRoute", "Relays synchronous and asynchronous messaging events to the On-Premises Mainframe via the Anti-Corruption Layer.")
}

Rel(ClaimEventPublisher, ClaimProcessingManager, "Routes claim events for FIFO processing", "AMQP 1.0")
Rel(ClaimProcessingManager, IntegrationQueueRelay, "Forwards events to hybrid integration layer", "AMQP 1.0")

@enduml