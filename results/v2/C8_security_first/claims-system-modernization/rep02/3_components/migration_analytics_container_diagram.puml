@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(migration_analytics_container, "Migration Analytics Container") {
    Component(Reconciliation Engine Component, "Reconciliation Engine Component", "Node.js/TypeScript", "Performs automated data reconciliation and comparison against the legacy DB2 database.")
    Component(Metrics Aggregator Component, "Metrics Aggregator Component", "Python/Pandas", "Aggregates migration metrics and telemetry data.")
    Component(Discrepancy Triage Service Component, "Discrepancy Triage Service Component", "Node.js", "Triages data discrepancies identified during reconciliation.")
    Component(Analytics API & UI Component, "Analytics API & UI Component", "Express/React", "Provides executive visibility and user interfaces for monitoring the migration.")
}

System_Ext(Anti-Corruption Layer, "Anti-Corruption Layer", "Provides access to legacy DB2 and isolates legacy interactions.")
System_Ext(Azure Service Bus, "Azure Service Bus", "Message broker for event-driven architecture.")
System_Ext(Management Clients, "Management Clients", "End-users and dashboards accessing the migration analytics.")

Rel(Migration Analytics Container, Anti-Corruption Layer, "Communicates", "gRPC over mTLS")
Rel(Reconciliation Engine Component, Azure Service Bus, "Consumes events", "AMQP")
Rel(Analytics API & UI Component, Management Clients, "Serves traffic", "HTTPS/REST")
Rel(Reconciliation Engine Component, Anti-Corruption Layer, "Accesses legacy DB2 for data comparison", "gRPC / API")

@enduml