@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Adjuster Workspace container

Container_Boundary(adjuster_workspace, "Adjuster Workspace") {
    Component(React_Presentation_Component, "React Presentation Component", "React", "Renders dynamic claim forms and UI components for claims adjusters.")
    Component(Node_js_Express_BFF, "Node.js/Express BFF", "Node.js, Express", "Powers the Backend-For-Frontend layer for token handling, API orchestration, and request processing.")
}

Rel(React_Presentation_Component, Node_js_Express_BFF, "Sends API requests and interacts with", "HTTPS")

@enduml