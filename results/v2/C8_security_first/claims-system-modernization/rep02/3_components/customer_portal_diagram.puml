@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(azure_active_directory, "Azure Active Directory", "Identity Provider")
System_Ext(azure_api_gateway, "Azure API Gateway", "API Gateway")

Container_Boundary(customer_portal, "Customer Portal") {
    Component(claims_ui, "Claims UI", "React SPA / TypeScript", "Powers the Customer Portal frontend for high responsiveness and maintainability.")
    Component(auth_manager, "Auth Manager", "OIDC/OAuth2 with PKCE", "Centralizes single sign-on security and authenticates users via Azure Active Directory.")
    Component(api_client, "API Client", "HTTPS", "Routes requests and submits data to the Azure API Gateway.")
    Component(state_storage_components, "State & Storage Components", "Local Storage API", "Manages local state and storage internally within the portal.")
}

Rel(claims_ui, api_client, "Invokes API requests to submit online claims", "HTTPS/TLS 1.3")
Rel(auth_manager, azure_active_directory, "Authenticates users", "OIDC/OAuth2 with PKCE")
Rel(api_client, azure_api_gateway, "Routes requests and submits data", "HTTPS")
Rel(claims_ui, state_storage_components, "Reads and writes local state", "Local Storage API / TypeScript")

@enduml