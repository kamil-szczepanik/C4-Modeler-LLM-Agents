@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Claims Adjusters, "Claims Adjusters", "Users of the claims system")
System_Ext(Microsoft Entra ID, "Microsoft Entra ID", "Azure", "External system for authentication and identity management.")
System_Ext(API Gateway, "API Gateway", "Azure", "External system acting as the gateway for backend communication.")
System_Ext(Legacy Mainframe, "Legacy Mainframe", "Mainframe", "External system representing the 30-year-old regional insurer mainframe claims system.")

Container_Boundary(Claims Web Application, "Claims Web Application") {
    Component(Claims Web Application, "Claims Web Application", "React SPA / Azure App Service", "Unified hosting for React SPA and Node.js BFF to minimize operational complexity for cloud-novice teams.")
    Component(BFF Routing & Session Controller, "BFF Routing & Session Controller", "Node.js/Express", "Manages routing and session control.")
    Component(Claim Workspace UI, "Claim Workspace UI", "React/TypeScript", "Supports WCAG 2.1 AA accessibility and rapid adjuster workflows.")
    Component(Local State & Sync Manager, "Local State & Sync Manager", "IndexedDB / Workbox / Web Crypto API", "Client-side storage with encrypted payload caching to handle intermittent connectivity.")
    Component(Client-Side Validation & Mapping Engine, "Client-Side Validation & Mapping Engine", "TypeScript / Zod", "Performs client-side validation and mapping.")
    Component(Telemetry & Error Boundary Component, "Telemetry & Error Boundary Component", "React / OpenTelemetry Web", "Distributed tracing and proactive health monitoring across hybrid lag.")
}

Rel(Claims Adjusters, Claims Web Application, "HTTPS/REST")
Rel(Claim Workspace UI, BFF Routing & Session Controller, "HTTPS/REST")
Rel(BFF Routing & Session Controller, API Gateway, "HTTPS/REST")
Rel(Claim Workspace UI, Client-Side Validation & Mapping Engine, "In-memory TS")

@enduml