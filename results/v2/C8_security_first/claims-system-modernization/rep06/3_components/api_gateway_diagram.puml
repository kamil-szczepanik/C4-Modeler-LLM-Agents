@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Auth_WAF_Component, "Authentication & WAF Component", "APIM Policies", "Handles security, WAF protection, rate-limiting, and authentication for incoming traffic.")
    Component(Routing_Configuration_Loader, "Routing Configuration Loader", "Azure App Configuration", "Fetches and stores version-controlled routing rules to support rapid one-day fallback.")
    Component(Transformation_Caching_Component, "Transformation & Caching Component", "APIM Liquid Templates / Response Cache", "Transforms request and response payloads and caches frequent queries.")
    Component(Circuit_Breaker_Policy_Engine, "Circuit Breaker Policy Engine", "APIM native policies", "Manages fallback routing and failure handling between the Azure service and legacy mainframe.")
}

Rel(Routing_Configuration_Loader, Auth_WAF_Component, "Supplies routing rules", "HTTPS")
Rel(Auth_WAF_Component, Transformation_Caching_Component, "Passes authenticated requests for transformation", "")
Rel(Transformation_Caching_Component, Circuit_Breaker_Policy_Engine, "Routes processed requests through circuit breaker policies", "")

@enduml