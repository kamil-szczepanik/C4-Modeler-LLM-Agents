@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit & Reporting Dashboard container

System_Ext(Read_Model_DB, "Read-Model DB", "Azure Cosmos DB", "Stores denormalized read-models for low-latency reporting queries.")
System_Ext(Enterprise_Notification_System, "Enterprise Notification System", "External System", "Dispatches threshold alerts and manages notifications.")
System_Ext(Azure_Blob_Storage, "Azure Blob Storage", "Azure Blob Storage (WORM-enabled)", "Provides WORM-compliant immutable storage for audit logs and report exports.")
System_Ext(Identity_Provider_Entra_ID, "Identity Provider (Entra ID)", "Azure AD", "Handles Single Sign-On (SSO) and identity management.")

Container_Boundary(Audit_Reporting_Dashboard, "Audit & Reporting Dashboard") {
    Component(Dashboard_UI_Component, "Dashboard UI Component", "React / TypeScript", "Renders responsive adjuster and compliance user interfaces.")
    Component(Reporting_API_Component, "Reporting API Component", ".NET 8 Web API / Azure App Service", "Handles reporting logic, queries audit logs, and interfaces with the Read-Model DB and Enterprise Notification System.")
    Component(Audit_Trail_Logger_Component, "Audit Trail Logger Component", ".NET 8 / Azure Functions", "Logs audit trail information asynchronously.")
    Component(Alerting_Notification_Component, "Alerting & Notification Component", ".NET background worker / Azure Functions", "Dispatches threshold alerts and manages notifications.")
    Component(Export_Worker_Component, "Export Worker Component", ".NET 8 Isolated Worker / Azure Function", "Writes immutable reports and generates secure download links using Azure Blob Storage.")
}

Rel(Dashboard_UI_Component, Reporting_API_Component, "Queries audit logs and KPI metrics", "HTTPS / REST, JWT Bearer")
Rel(Reporting_API_Component, Read_Model_DB, "Reads denormalized audit and reporting views", "TCP / TLS")
Rel(Reporting_API_Component, Enterprise_Notification_System, "Dispatches threshold alerts", "HTTPS / REST")
Rel(Export_Worker_Component, Azure_Blob_Storage, "Writes immutable reports and generates SAS download links", "HTTPS, Azure SDK")
Rel(Audit_Reporting_Dashboard, Identity_Provider_Entra_ID, "Single Sign-On (SSO)", "OpenID Connect / OAuth 2.0")

@enduml