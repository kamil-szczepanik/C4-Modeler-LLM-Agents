@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Integration_Sync_Service_Read_Model_Sync_Worker", "Integration/Sync Service & Read-Model Sync Worker") {
    Component("Inbound Event Router", "Inbound Event Router", ".NET 8 Isolated Worker", "Consumes messages from Azure Service Bus and coordinates processing.")
    Component("Read-Model Projection Engine", "Read-Model Projection Engine", ".NET 8", "Builds and updates read-models for fast adjuster user experiences.")
    Component("Legacy Sync Bridge & Mainframe Adapter", "Legacy Sync Bridge & Mainframe Adapter", ".NET 8 / Azure Container Apps", "Handles bi-directional state synchronization with the on-premise mainframe via IPSec VPN / Azure ExpressRoute.")
}

Rel("Inbound Event Router", "Read-Model Projection Engine", "Forwards processed event data for projection updates", "")
Rel("Legacy Sync Bridge & Mainframe Adapter", "Inbound Event Router", "Sends synchronized legacy state updates", "")

@enduml