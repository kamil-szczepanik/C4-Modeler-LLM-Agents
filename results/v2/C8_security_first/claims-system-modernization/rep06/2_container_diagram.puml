@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Modern Claims Platform

Person(PolicyholdersAndBrokers, "Policyholders and Brokers", "Customers and brokers who submit and track online claims.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal staff who handle and process claims.")
System_Ext(LegacyMainframeSystem, "Legacy Mainframe System", "30-year-old on-premise COBOL / DB2 system of record.")
System_Ext(IdentityProvider, "Identity Provider", "Azure AD / Entra ID providing SSO authentication.")

System_Boundary(ModernClaimsPlatform, "Modern Claims Platform") {
    Container(ApiGateway, "API Gateway", "Azure Front Door / Azure API Management", "Provides dynamic routing and API management.")
    Container(ClaimsWebApplication, "Claims Web Application", "React / Azure App Service", "Fast adjuster UI rendering for claim handling.")
    Container(AuditAndReportingDashboard, "Audit & Reporting Dashboard", "React / Azure App Service", "Provides reporting and audit trails for claims.")
    Container(ClaimsCoreService, "Claims Core Service", "Node.js/TypeScript on Azure Container Apps", "Handles core business logic using CQRS and Event Sourcing.")
    Container(IntegrationSyncServiceReadModelSyncWorker, "Integration/Sync Service & Read-Model Sync Worker", "Azure Service Bus, Azure Functions / .NET", "Manages event streaming and hybrid data synchronization.")
}

Rel(PolicyholdersAndBrokers, ApiGateway, "Online claim submission", "HTTPS/REST")
Rel(ClaimsAdjusters, ClaimsWebApplication, "Claim handling and processing", "HTTPS/REST")
Rel(ApiGateway, ClaimsCoreService, "Dynamic routing of requests", "gRPC / HTTPS")
Rel(ClaimsCoreService, LegacyMainframeSystem, "Hybrid data sync", "MQ/AMQP and mTLS over IPsec VPN / Azure ExpressRoute")
Rel(ClaimsCoreService, IntegrationSyncServiceReadModelSyncWorker, "Event streaming", "AMQP (Azure Service Bus)")
Rel(ClaimsWebApplication, IdentityProvider, "Single Sign-On (SSO)", "OpenID Connect / OAuth 2.0")
Rel(AuditAndReportingDashboard, IdentityProvider, "Single Sign-On (SSO)", "OpenID Connect / OAuth 2.0")

@enduml