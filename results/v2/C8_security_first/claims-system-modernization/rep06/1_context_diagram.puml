@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Modern Claims Platform

Person(PolicyholdersAndBrokers, "Policyholders and Brokers", "Customers and brokers who submit and track online claims.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal staff who handle and process claims.")
System(ModernClaimsPlatform, "Modern Claims Platform", "Modernizes a regional insurer's claims platform by gradually migrating claim types from a 30-year-old legacy mainframe to a cloud-native architecture over a three-year period, ensuring seamless online submissions and business continuity.")
System_Ext(LegacyMainframeSystemOfRecord, "Legacy Mainframe System of Record", "30-year-old on-premise COBOL/DB2 system handling legacy claim types and dual-run sync.")
System_Ext(InsurerActiveDirectoryEntraID, "Insurer Active Directory / Entra ID", "Provides identity and access management for Single Sign-On.")
System_Ext(EnterpriseNotificationSystem, "Enterprise Notification System", "Sends claim status updates via HTTPS/SMTP.")

Rel(PolicyholdersAndBrokers, ModernClaimsPlatform, "Online claim submissions and status checking", "HTTPS (REST/GraphQL)")
Rel(ClaimsAdjusters, ModernClaimsPlatform, "Claim handling and processing", "HTTPS")
Rel(ModernClaimsPlatform, LegacyMainframeSystemOfRecord, "Claim type migration and dual-run sync", "Hybrid VPN, mTLS, and Azure Service Bus")
Rel(ModernClaimsPlatform, InsurerActiveDirectoryEntraID, "Single Sign-On authentication", "OIDC/OAuth 2.0")
Rel(ModernClaimsPlatform, EnterpriseNotificationSystem, "Send claim status updates", "HTTPS/SMTP")

@enduml