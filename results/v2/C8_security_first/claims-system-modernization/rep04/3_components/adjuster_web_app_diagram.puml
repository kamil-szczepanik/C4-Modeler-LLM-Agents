@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(ClaimsAdjuster, "Claims Adjuster", "Insurance claims adjuster processing claims.")
System_Ext(BackendForFrontend, "Backend-for-Frontend (BFF)", "Azure Container Apps handling data and workflows.")
System_Ext(AzureActiveDirectory, "Azure Active Directory / Entra ID", "Identity Provider for authentication and SSO.")
System_Ext(AzureAppInsights, "Azure Application Insights & Azure Monitor", "Observability platform for telemetry and traces.")

Container_Boundary(AdjusterWebApp, "Adjuster Web App") {
    Component(ReactSPAPresentationLayer, "React SPA Presentation Layer", "React / TypeScript", "Component architecture for high performance, maintainability, and sub-second UI rendering.")
    Component(AuthenticationClient, "Authentication Client", "OIDC / OAuth2", "Authenticates users via Azure Active Directory / Entra ID and manages the SSO lifecycle.")
    Component(TelemetryIntegration, "Telemetry Integration", "HTTPS", "Transmits distributed traces and client telemetry to Azure Application Insights and Azure Monitor.")
    Component(ConfigurationManager, "Configuration Manager", "Azure App Configuration", "Handles dynamic feature flagging for rapid rollback requirements.")
}

Rel(ClaimsAdjuster, ReactSPAPresentationLayer, "Reviews and processes claims", "HTTPS")
Rel(ReactSPAPresentationLayer, BackendForFrontend, "Requests claim data and workflows", "HTTPS / gRPC via Azure Managed Identities")
Rel(AuthenticationClient, AzureActiveDirectory, "Authenticates users and manages SSO/OIDC lifecycle", "OIDC / OAuth2")
Rel(TelemetryIntegration, AzureAppInsights, "Transmits distributed traces and client telemetry", "HTTPS")
Rel(ConfigurationManager, ReactSPAPresentationLayer, "Provides dynamic feature flags")
@enduml