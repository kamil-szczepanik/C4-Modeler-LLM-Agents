@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification Service container

Container_Boundary(notification_service, "Notification Service") {
    Component(api_controller, "API Controller / Event Consumer Component", "Node.js / TypeScript (Azure Container Apps)", "Handles incoming HTTP requests from the BFF and consumes events from Azure Service Bus.")
    Component(preference_manager, "Preference Manager Component", "Node.js / TypeScript (Azure Container Apps)", "Manages customer, broker, and adjuster communication preferences.")
    Component(template_engine, "Template Engine Component", "Node.js / TypeScript (Azure Container Apps)", "Generates multi-channel communication templates for Email, SMS, and Push.")
    Component(dispatch_adapter, "Dispatch Adapter Component", "Node.js / TypeScript with Opossum Circuit Breaker", "Dispatches notifications to external gateways with built-in circuit breaker resilience.")
    ComponentDb(state_repository, "Notification State Repository", "Azure Cosmos DB NoSQL", "Stores notification metadata and delivery status for auditability.")
}

Rel(api_controller, preference_manager, "Checks delivery preferences")
Rel(api_controller, template_engine, "Requests message rendering")
Rel(template_engine, dispatch_adapter, "Sends rendered payload for delivery")
Rel(dispatch_adapter, state_repository, "Persists delivery status and metadata")

@enduml