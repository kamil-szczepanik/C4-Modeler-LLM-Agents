@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claim Processing Core container

System_Ext(Azure_API_Management, "Azure API Management", "External API Management gateway")
System_Ext(Legacy_Mainframe, "Legacy Mainframe", "COBOL/DB2 legacy claims platform")

Container_Boundary(Claim_Processing_Core, "Claim Processing Core") {
    Component(Claim_Intake_Router, "Claim Intake Router", "Azure Functions", "Routes incoming claims and interfaces with Azure API Management.")
    Component(Workflow_Orchestrator, "Workflow Orchestrator", "Azure Durable Functions", "Serverless state orchestration ensuring idempotent claim processing and preventing duplicate payouts.")
    Component(Integration_Adapter, "Integration Adapter", "C# Class Library with Polly", "Handles integration with the legacy mainframe utilizing circuit breakers and retries to handle latency.")
    Component(Domain_Model_Engine, "Domain Model Engine", "DDD Class Library", "Contains the core domain models and business logic for claim processing.")
    Component(Azure_Service_Bus, "Azure Service Bus", "Azure Service Bus", "Asynchronous message broker handling ingestion spikes without impacting the batch window.")
    Component(Azure_Cosmos_DB, "Azure Cosmos DB", "Azure Cosmos DB", "Multi-model database providing state storage and WORM ledger mode for immutable audit events.")
    Component(Azure_Key_Vault, "Azure Key Vault", "Azure Key Vault", "Secures secrets and credentials using Managed Identities and HTTPS.")
    Component(Azure_Container_Apps, "Azure Container Apps", "Azure Container Apps", "Container hosting platform reducing day-2 operational overhead.")
}

Rel(Azure_API_Management, Claim_Intake_Router, "mTLS / HTTPS")
Rel(Claim_Intake_Router, Azure_Service_Bus, "AMQP")
Rel(Workflow_Orchestrator, Azure_Cosmos_DB, "HTTPS / TLS 1.3")
Rel(Integration_Adapter, Legacy_Mainframe, "mTLS via VPN/ExpressRoute")
Rel(Claim_Processing_Core, Azure_Key_Vault, "Managed Identities / HTTPS")

@enduml