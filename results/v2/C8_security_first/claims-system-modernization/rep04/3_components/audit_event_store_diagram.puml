@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(ComplianceOfficers, "Compliance Officers", "")
System_Ext(EventIngestionEngine, "Event Ingestion Engine", "Azure Functions / .NET 8")

Container_Boundary(AuditAndEventStore, "Audit & Event Store") {
    Component(OperationalEventStore, "Operational Event Store", "Azure Cosmos DB for NoSQL", "Partitioned operational data store ensuring sub-second event retrieval.")
    Component(AuditAndComplianceArchive, "Audit & Compliance Archive", "Azure SQL Ledger", "Cryptographically secure, tamper-evident audit trail meeting strict regulatory requirements.")
}

Rel(EventIngestionEngine, OperationalEventStore, "Writes to", "HTTPS/TCP over Private Endpoint")
Rel(EventIngestionEngine, AuditAndComplianceArchive, "Writes to", "T-SQL over Private Endpoint")
Rel(ComplianceOfficers, AuditAndComplianceArchive, "Query", "SQL over Private Endpoint")
@enduml