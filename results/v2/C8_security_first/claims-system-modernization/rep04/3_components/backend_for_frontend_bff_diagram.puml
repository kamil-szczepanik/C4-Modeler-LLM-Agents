@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(bff, "Backend-for-Frontend (BFF)") {
    Component(api_router, "API Router & Auth Middleware", "Node.js (Fastify) or Go (Gin)", "Validates JWT tokens, enforces RBAC, and routes incoming requests.")
    Component(aggregation_service, "Aggregation & Orchestration Service", "Node.js (Fastify) or Go (Gin)", "Orchestrates claim data requests and aggregates responses for the frontend.")
    Component(caching_layer, "Caching & Resilience Layer", "Azure Cache for Redis", "Implements caching and circuit-breaker fallbacks to ensure fast screen loads.")
    Component(feature_flag_engine, "Feature-Flag Evaluation Engine", "Azure App Configuration", "Evaluates claim-type migration state and enables rapid rollbacks.")
    Component(telemetry_middleware, "Telemetry & Correlation Middleware", "OpenTelemetry", "Provides distributed tracing and observability for cross-service calls.")
}

Rel(api_router, aggregation_service, "Forwards authenticated and authorized requests", "")
Rel(aggregation_service, caching_layer, "Reads/writes cached claim data using Cache-Aside pattern", "")
Rel(feature_flag_engine, aggregation_service, "Provides feature flag states for routing decisions", "")
Rel(aggregation_service, telemetry_middleware, "Propagates tracing context", "")

@enduml