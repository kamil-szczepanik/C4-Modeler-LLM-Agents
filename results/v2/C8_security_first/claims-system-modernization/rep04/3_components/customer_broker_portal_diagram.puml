@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Customer/Broker Portal container

Container_Boundary(customer_broker_portal, "Customer/Broker Portal") {
    Component(SPA_Frontend, "SPA Frontend", "TypeScript / React on Azure Static Web Apps", "Provides a modern, responsive, mobile-friendly web interface for online claim submissions, document uploads, and real-time status tracking.")
    Component(Portal_BFF, "Portal BFF", "Node.js / Express on Azure Container Apps", "Lightweight backend for handling API routing, session management, and forwarding domain commands.")
    Component(Document_Uploader, "Document Uploader", "Node.js component", "Handles direct secure binary streaming of claim attachments to cloud storage.")
    Component(Azure_API_Management, "Azure API Management", "API Gateway", "Acts as the API gateway managing secure access and routing.")
    Component(Azure_Blob_Storage, "Azure Blob Storage", "Azure Blob Storage", "Secure binary object storage for claim attachments using SAS tokens.")
    Component(Active_Directory___Entra_ID, "Active Directory / Entra ID", "OAuth 2.0 / OpenID Connect", "Manages user authentication and identity enforcement.")
}

Rel(SPA_Frontend, Portal_BFF, "Authenticated API calls", "HTTPS / REST, JSON")
Rel(Portal_BFF, Backend_for_Frontend__System_Container, "Forwards domain commands", "HTTPS / gRPC")
Rel(Document_Uploader, Azure_Blob_Storage, "Direct secure binary streaming", "HTTPS / SAS")
Rel(Active_Directory___Entra_ID, SPA_Frontend, "User authentication", "OAuth 2.0 / OpenID Connect")
@enduml