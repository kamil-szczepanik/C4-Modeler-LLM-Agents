@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Azure API Management (API Gateway)", "Azure API Management (API Gateway)") {
    Component(API_Proxy_and_Routing_Manager, "API Proxy and Routing Manager", "Azure API Management Policy", "Manages API proxying, path-based routing, and endpoint exposure for external and internal clients.")
    Component(Rate_Limiting_and_Throttling_Engine, "Rate Limiting and Throttling Engine", "Azure API Management Policy", "Enforces rate-limiting and traffic quotas to protect backend services, including the legacy mainframe.")
    Component(Payload_Transformation_Module, "Payload Transformation Module", "Azure API Management Policy (Liquid/XSLT)", "Transforms request and response payloads to bridge modern JSON interfaces with legacy formats.")
    Component(Security_and_Authentication_Validator, "Security and Authentication Validator", "OAuth 2.0 / OpenID Connect (Entra ID) & Mutual TLS (mTLS)", "Validates incoming OAuth 2.0 tokens from clients and secures hybrid connectivity to the legacy mainframe using mTLS.")
}

Rel(API_Proxy_and_Routing_Manager, Rate_Limiting_and_Throttling_Engine, "Passes incoming requests for validation and traffic control")
Rel(Rate_Limiting_and_Throttling_Engine, Payload_Transformation_Module, "Routes allowed requests for format adaptation")
Rel(Payload_Transformation_Module, Security_and_Authentication_Validator, "Applies security policies and mTLS certificates managed by Azure Key Vault")
@enduml