@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(data_synchronization_worker, "Data Synchronization Worker") {
    Component(Integration_Route_Processor, "Integration Route Processor", "Apache Camel", "Handles protocol translation and routing between modern cloud services and legacy systems.")
    Component(Mainframe_Sync_Client, "Mainframe Sync Client", "gRPC / Spring Boot", "Manages secure gRPC communication over ExpressRoute to interact with the legacy mainframe.")
    Component(Event_Publisher, "Event Publisher", "Azure Service Bus SDK", "Publishes synchronized claim updates and events to the Azure Service Bus.")
}

System_Ext(Legacy_Mainframe_System, "Legacy Mainframe System", "COBOL/DB2 on-prem")
System(Claim_Processing_Core, "Claim Processing Core", "Azure Container Apps / Azure Service Bus")

Rel(Integration_Route_Processor, Mainframe_Sync_Client, "Delegates legacy data extraction to")
Rel(Mainframe_Sync_Client, Legacy_Mainframe_System, "Syncs data via gRPC/mTLS over ExpressRoute", "gRPC/mTLS")
Rel(Integration_Route_Processor, Event_Publisher, "Triggers message publishing via")
Rel(Event_Publisher, Claim_Processing_Core, "Sends asynchronous messages via", "AMQP")
@enduml