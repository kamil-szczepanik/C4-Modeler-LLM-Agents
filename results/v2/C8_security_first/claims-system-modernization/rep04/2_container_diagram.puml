@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Modernized Insurance Claims Platform

Person(Customer_Policyholder, "Customer / Policyholder", "An end-user who submits claims and interacts with the insurance platform.")
Person(Broker, "Broker", "An intermediary who assists policyholders and manages claims.")
Person(Claims_Adjuster, "Claims Adjuster", "A professional who reviews and processes insurance claims using modern web applications requiring sub-2-second screen loads.")

System_Ext(Legacy_Mainframe_System_COBOL_DB2, "Legacy Mainframe System (COBOL/DB2)", "On-premises COBOL and DB2 database system acting as the system of record.")
System_Ext(Active_Directory___Entra_ID, "Active Directory / Entra ID", "Identity Provider used for Federated SSO and authentication.")

System_Boundary(Modernized_Insurance_Claims_Platform, "Modernized Insurance Claims Platform") {
    Container(Azure_API_Management__API_Gateway_, "Azure API Management (API Gateway)", "Azure API Management", "Ingress gateway enforcing WAF policies, rate-limiting, and hybrid decoupling.")
    Container(Customer_Broker_Portal, "Customer/Broker Portal", "Azure Container Apps", "Portal enabling online claims submission for customers and brokers.")
    Container(Adjuster_Web_App, "Adjuster Web App", "Azure Container Apps", "Web application used by claims adjusters for claims workflows.")
    Container(Backend_for_Frontend_BFF_, "Backend-for-Frontend (BFF)", "Azure Container Apps / Azure Cache for Redis", "BFF service optimizing data payloads and caching claim data for sub-2-second screen loads.")
    Container(Claim_Processing_Core, "Claim Processing Core", "Azure Container Apps / Azure Service Bus", "Core service processing insurance claims using asynchronous messaging.")
    Container(Notification_Service, "Notification Service", "Azure Container Apps", "Service responsible for handling system notifications.")
    Container(Data_Synchronization_Worker, "Data Synchronization Worker", "Azure Container Apps", "Worker handling batch and sync integration protocols with the legacy mainframe.")
    ContainerDb(Audit___Event_Store, "Audit & Event Store", "Azure Cosmos DB / Azure SQL", "Operational store and immutable audit trail.")
}

Rel(Customer_Policyholder, Azure_API_Management__API_Gateway_, "Submits claims and interacts with portal", "HTTPS via OAuth 2.0 / OpenID Connect (Azure AD)")
Rel(Broker, Azure_API_Management__API_Gateway_, "Manages claims and interacts with portal", "HTTPS via OAuth 2.0 / OpenID Connect (Azure AD)")
Rel(Claims_Adjuster, Adjuster_Web_App, "Reviews and processes insurance claims", "HTTPS")
Rel(Adjuster_Web_App, Backend_for_Frontend_BFF_, "Requests claim data and workflows", "HTTPS / gRPC via Azure Managed Identities")
Rel(Backend_for_Frontend_BFF_, Azure_API_Management__API_Gateway_, "Routes backend API requests", "HTTPS")
Rel(Azure_API_Management__API_Gateway_, Legacy_Mainframe_System_COBOL_DB2, "Bridges Azure and on-premise legacy system", "Mutual TLS (mTLS)")
Rel(Claim_Processing_Core, Azure_API_Management__API_Gateway_, "Sends asynchronous messages and processes core logic", "AMQP / HTTPS")
Rel(Data_Synchronization_Worker, Legacy_Mainframe_System_COBOL_DB2, "Synchronizes data across the hybrid boundary", "Batch/Sync integration protocols")
Rel(Active_Directory___Entra_ID, Customer_Broker_Portal, "Authenticates users", "OAuth 2.0 / OpenID Connect")

@enduml