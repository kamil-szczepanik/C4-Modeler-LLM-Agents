@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Modernized Insurance Claims Platform

Person(Customer___Policyholder, "Customer / Policyholder", "An end-user who submits claims and interacts with the insurance platform.")
Person(Broker, "Broker", "An intermediary who assists policyholders and manages claims.")
Person(Claims_Adjuster, "Claims Adjuster", "A professional who reviews and processes insurance claims using modern web applications requiring sub-2-second screen loads.")

System_Ext(Legacy_Mainframe_System, "Legacy Mainframe System", "On-premises COBOL and DB2 database system acting as the system of record.")
System_Ext(Active_Directory___Entra_ID, "Active Directory / Entra ID", "Identity Provider used for Federated SSO and authentication.")

System(Modern_Claims_Platform, "Modern Claims Platform", "Cloud-hosted web applications and APIs running on Azure Container Apps / App Service.")
System(Azure_API_Management__APIM__Gateway, "Azure API Management (APIM) Gateway", "Ingress gateway enforcing WAF policies, rate-limiting, and payload inspection.")

Rel(Customer___Policyholder, Azure_API_Management__APIM__Gateway, "Interacts with the system via web applications", "HTTPS / TLS 1.3")
Rel(Broker, Azure_API_Management__APIM__Gateway, "Interacts with the system via web applications", "HTTPS / TLS 1.3")
Rel(Claims_Adjuster, Azure_API_Management__APIM__Gateway, "Interacts with the system via web applications", "HTTPS / TLS 1.3")
Rel(Modern_Claims_Platform, Azure_API_Management__APIM__Gateway, "Routes internal API requests", "internal HTTPS/REST")
Rel(Modern_Claims_Platform, Legacy_Mainframe_System, "Asynchronous data processing and synchronization across the hybrid boundary", "Asynchronous Message Queues / Secure File Drops over Azure ExpressRoute or IPsec VPN (mTLS)")
Rel(Modern_Claims_Platform, Active_Directory___Entra_ID, "Authenticates users and provides federated SSO", "OAuth 2.0 / OpenID Connect")

@enduml