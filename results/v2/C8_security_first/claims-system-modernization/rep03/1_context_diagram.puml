@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Insurance Claims Modernization Platform

Person(Customers & Brokers, "Customers & Brokers", "External actors who submit online claims and interact with the platform.")
Person(Claims Adjusters, "Claims Adjusters", "Internal actors who process and manage insurance claims.")

System(Insurance Claims Modernization Platform, "Insurance Claims Modernization Platform", "A modern hybrid cloud platform on Azure gradually replacing a 30-year-old on-premise mainframe claims system while maintaining uninterrupted legacy processing, zero claim loss, and high availability.")

System_Ext(Legacy Mainframe System, "Legacy Mainframe System", "On-Premises COBOL/DB2 System of Record representing the 30-year-old claims system.")
System_Ext(Azure Active Directory / Entra ID, "Azure Active Directory / Entra ID", "Identity Provider for Single Sign-On and MFA.")
System_Ext(Azure API Gateway with Rate Limiter, "Azure API Gateway with Rate Limiter", "Hybrid Boundary Protector isolating mainframe dependencies and handling rate limiting.")

Rel(Customers & Brokers, Insurance Claims Modernization Platform, "Submit online claims and interact with the system", "HTTPS (TLS 1.3), REST/GraphQL, OAuth 2.0 / OIDC")
Rel(Claims Adjusters, Insurance Claims Modernization Platform, "Process and manage claims", "HTTPS (TLS 1.3), REST/GraphQL, OAuth 2.0 / OIDC")
Rel(Insurance Claims Modernization Platform, Azure Active Directory / Entra ID, "Authenticate users and manage Single Sign-On and MFA", "OIDC / Graph API")
Rel(Insurance Claims Modernization Platform, Legacy Mainframe System, "Sync claims data and process legacy transactions", "Azure ExpressRoute/VPN, mTLS, synchronous REST or asynchronous queues")

@enduml