@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(audit_reconciliation_service, "Audit & Reconciliation Service") {
    Component(ReconciliationEngine, "Reconciliation Engine", ".NET 8, Hangfire / .NET Hosted Services", "Scheduled background execution for reconciliation jobs comparing Azure SQL Database and Legacy Mainframe extracts.")
    Component(AuditLogger, "Audit Logger", ".NET 8", "Captures and records immutable audit logs into Azure SQL Database with SQL Ledger.")
    Component(DiscrepancyAPI, "Discrepancy API", ".NET 8, MediatR", "Exposes discrepancy data to the Finance Operations Dashboard via HTTPS using OAuth2 / OIDC and handles CQRS discrepancy resolution workflows.")
    Component(DiscrepancyManager, "Discrepancy Manager", ".NET 8, MediatR", "Manages discrepancy resolution workflows using the CQRS pattern.")
}

System_Ext(AzureSqlDatabase, "Azure SQL Database", "Stores relational data and audit logs")
System_Ext(LegacyMainframeSystem, "Legacy Mainframe System", "Legacy mainframe claims system")
System_Ext(FinanceOperationsDashboard, "Finance Operations Dashboard", "Dashboard for finance operations and compliance auditors")

Rel(ReconciliationEngine, AzureSqlDatabase, "Queries data for reconciliation", "HTTPS")
Rel(ReconciliationEngine, LegacyMainframeSystem, "Extracts data", "HTTPS")
Rel(AuditLogger, AzureSqlDatabase, "Stores tamper-resistant audit logs", "Entity Framework Core")
Rel(DiscrepancyAPI, DiscrepancyManager, "Invokes workflows", "MediatR")
Rel(DiscrepancyAPI, FinanceOperationsDashboard, "Sends discrepancy data", "HTTPS (OAuth2 / OIDC)")

@enduml