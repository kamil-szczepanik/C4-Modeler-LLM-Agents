@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(azure_service_bus, "Azure Service Bus") {
    Component(Claim Domain Topics, "Claim Domain Topics", "Azure Service Bus Topics (Standard/Premium Tier)", "Publishes domain events from the Claim Management API for decoupled asynchronous processing.")
    Component(Mainframe-Outbox Queue, "Mainframe-Outbox Queue", "Azure Service Bus Queue", "Buffers messages during batch windows to safely integrate with the legacy mainframe system.")
    Component(DLQ Subscriptions, "DLQ Subscriptions", "Azure Service Bus Dead-Letter Queue", "Consumes poisoned and failed messages for auditing, reconciliation, and analysis.")
}

Rel(Claim Management API, Claim Domain Topics, "Publishes domain events", "AMQP over TLS with User-Assigned Managed Identities")
Rel(Claim Router/ACL, Mainframe-Outbox Queue, "Buffers messages during batch windows", "AMQP over TLS")
Rel(Audit & Reconciliation Service, DLQ Subscriptions, "Consumes poisoned messages for analysis", "AMQP over TLS")
@enduml