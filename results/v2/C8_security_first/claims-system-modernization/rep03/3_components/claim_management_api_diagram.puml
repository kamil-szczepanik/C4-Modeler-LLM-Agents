@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claim Management API container

Container_Boundary(claim_management_api, "Claim Management API") {
    Component(api_controller_layer, "API Controller Layer", "ASP.NET Core Security & FluentValidation", "Handles incoming HTTP REST API requests, performs input validation, and secures endpoints.")
    Component(mediatr_domain_command_handlers, "MediatR Domain / Command Handlers", ".NET 8 / MediatR", "Implements business logic and orchestrates commands and queries in-process.")
    Component(internal_routing_service_anti_corruption_layer_acl, "Internal Routing Service & Anti-Corruption Layer (ACL)", "HTTP/REST with Polly", "Routes requests and isolates the legacy mainframe using Polly resilience policies.")
    Component(entity_framework_core, "Entity Framework Core", "EF Core with TDE", "Manages relational data persistence and interactions with the Azure SQL Database.")
}

System_Ext(azure_service_bus, "Azure Service Bus", "AMQP over TLS")
System_Ext(azure_key_vault, "Azure Key Vault", "Managed Identities over HTTPS")

Rel(api_controller_layer, mediatr_domain_command_handlers, "MediatR In-Process")
Rel(mediatr_domain_command_handlers, internal_routing_service_anti_corruption_layer_acl, "HTTP/REST with Polly resilience policies")
Rel(mediatr_domain_command_handlers, entity_framework_core, "Entity Framework Core with TDE")
Rel(mediatr_domain_command_handlers, azure_service_bus, "AMQP over TLS")
Rel(claim_management_api, azure_key_vault, "Managed Identities over HTTPS")

@enduml