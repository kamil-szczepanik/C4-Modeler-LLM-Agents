@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure App Configuration container

Container_Boundary(azure_app_configuration, "Azure App Configuration") {
    Component(Feature_Flag_Manager, "Feature Flag Manager", ".NET 8 Configuration SDK", "Manages centralized feature toggles to guarantee rapid one-day rollback capability for incremental claim-type migrations.")
    Component(Configuration_Store, "Configuration Store", "Azure App Configuration Service", "Provides centralized metadata and configuration management for microservices.")
}

Rel(Feature_Flag_Manager, Configuration_Store, "Reads and updates toggle states via", "")

@enduml