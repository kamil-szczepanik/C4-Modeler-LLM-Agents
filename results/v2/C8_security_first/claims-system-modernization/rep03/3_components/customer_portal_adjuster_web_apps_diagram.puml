@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Customer Portal & Adjuster Web Apps container

System_Ext(Azure_App_Configuration, "Azure App Configuration", "Configuration management service.")
System_Ext(Azure_Application_Insights, "Azure Application Insights", "Performance monitoring and telemetry service.")

Container_Boundary(Customer_Portal_and_Adjuster_Web_Apps, "Customer Portal & Adjuster Web Apps") {
    Component(Authentication_Handler_Component, "Authentication Handler Component", ".NET 8 / JavaScript", "Handles user authentication and security flows via OIDC / OAuth 2.0.")
    Component(Dynamic_Form_Engine_Component, "Dynamic Form Engine Component", "JavaScript / SPA", "Powers dynamic form rendering and fetches feature flags from Azure App Configuration.")
    Component(API_Client_and_Caching_Component, "API Client & Caching Component", "JavaScript", "Manages HTTP communications with the API Gateway and provides aggressive caching.")
    Component(Broker_Context_Manager_Component, "Broker Context Manager Component", "JavaScript", "Manages broker-specific contexts and states within the web application.")
    Component(Local_Persistence_Queue_Component, "Local Persistence Queue Component", "IndexedDB", "Provides local persistence queue for offline-resilient claim submissions.")
    Component(Telemetry_and_RUM_Component, "Telemetry & RUM Component", "JavaScript / Application Insights SDK", "Enables Real User Monitoring (RUM) and streams performance metrics to Azure Application Insights.")
}

Rel(Dynamic_Form_Engine_Component, Azure_App_Configuration, "Fetches feature flags", "HTTPS/TLS")
Rel(Telemetry_and_RUM_Component, Azure_Application_Insights, "Streams performance metrics", "HTTPS")

@enduml