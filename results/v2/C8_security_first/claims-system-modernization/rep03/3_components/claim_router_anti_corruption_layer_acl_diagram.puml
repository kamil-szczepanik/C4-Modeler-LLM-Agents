@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(acl_container, "Claim Router / Anti-Corruption Layer (ACL)") {
    Component(api_endpoint, "ASP.NET Core Minimal APIs / API Endpoint Component", "ASP.NET Core Minimal APIs", "API Endpoint Component")
    Component(routing_engine, "Routing Engine Component", ".NET 8 with Polly", "Routing Engine Component (.NET 8 with Polly)")
    Component(translation_mapper, "Translation / Mapper Component", "AutoMapper / strongly typed record mappings", "Translation / Mapper Component (AutoMapper / strongly typed record mappings)")
    Component(outbox_dispatcher, "Outbox Dispatcher Component", ".NET", "Outbox Dispatcher Component")
    Component(mainframe_adapter, "Mainframe Adapter Component", "mTLS over dedicated ExpressRoute / IPsec VPN tunnel", "Mainframe Adapter Component")
}

System_Ext(azure_container_apps, "Azure Container Apps", "Azure Container Apps hosting environment")
System_Ext(azure_app_config, "Azure App Configuration", "Azure App Configuration")
System_Ext(azure_service_bus, "Azure Service Bus", "Azure Service Bus messaging broker")
System_Ext(azure_key_vault, "Azure Key Vault", "Azure Key Vault")
System_Ext(azure_app_insights, "Azure App Insights / OpenTelemetry", "OpenTelemetry")

Rel(api_endpoint, routing_engine, "Forwards validated JSON/REST payloads via in-process method calls", "In-process")
Rel(routing_engine, mainframe_adapter, "Routes un-migrated legacy claims via mTLS over dedicated ExpressRoute / IPsec VPN tunnel", "mTLS")
Rel(routing_engine, azure_app_config, "Evaluates real-time feature flags via HTTPS REST APIs", "HTTPS")
Rel(translation_mapper, mainframe_adapter, "Translates modern JSON payloads into fixed-width COBOL copybooks", "In-process")
Rel(outbox_dispatcher, azure_service_bus, "Publishes reliable events using AMQP protocol", "AMQP")
Rel(acl_container, azure_key_vault, "Retrieves secrets and rotation policies using Managed Identities over HTTPS", "HTTPS / Managed Identities")
@enduml