@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container(ClaimManagementAPIAndAuditService, "Claim Management API & Audit Service", "Azure Container Apps, .NET 8", "Handles business logic and data processing.")

System_Boundary(AzureSQLDatabase, "Azure SQL Database") {
    Component(ClaimDataStore, "Claim Data Store", "Azure SQL Database / Temporal Tables", "Stores core claim information with built-in history tracking and audit capabilities.")
    Component(AuditAndTransactionLog, "Audit & Transaction Log", "Azure SQL Database / CDC", "Captures changes for reconciliation and auditing purposes across modern and legacy boundaries.")
}

Rel(ClaimManagementAPIAndAuditService, ClaimDataStore, "Reads and writes claim data", "Entity Framework Core [TDS]")
Rel(ClaimManagementAPIAndAuditService, AuditAndTransactionLog, "Logs data changes and audit trails", "Change Data Capture [TDS]")
@enduml