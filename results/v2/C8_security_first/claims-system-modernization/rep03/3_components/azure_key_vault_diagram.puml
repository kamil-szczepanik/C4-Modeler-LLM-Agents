@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Key Vault container

System_Ext(Claim_Management_API, "Claim Management API", "External system")
System_Ext(Claim_Router_ACL, "Claim Router (ACL)", "External system")
System_Ext(Audit_Service, "Audit Service", "External system")
System_Ext(Azure_SQL_Database, "Azure SQL Database", "External system")
System_Ext(Azure_Event_Grid, "Azure Event Grid", "External system")
System_Ext(Azure_Monitor, "Azure Monitor", "External system")

Container_Boundary(Azure_Key_Vault, "Azure Key Vault") {
    Component(Secrets_Management_Component, "Secrets Management Component", "Azure Key Vault Secrets", "Manages database connection strings and external API keys.")
    Component(Keys___Cryptographic_Component, "Keys / Cryptographic Component", "Azure Key Vault Keys (Premium Tier, HSM-backed)", "Manages Customer-Managed Keys for database encryption.")
    Component(Certificates_Management_Component, "Certificates Management Component", "Azure Key Vault Certificates", "Manages TLS certificates for the API Gateway.")
}

Rel(Claim_Management_API, Secrets_Management_Component, "Retrieves runtime secrets", "HTTPS via Private Endpoint")
Rel(Claim_Router_ACL, Secrets_Management_Component, "Retrieves runtime secrets", "HTTPS via Private Endpoint")
Rel(Audit_Service, Secrets_Management_Component, "Retrieves runtime secrets", "HTTPS via Private Endpoint")
Rel(Azure_SQL_Database, Keys___Cryptographic_Component, "Enforces Customer-Managed Keys for Transparent Data Encryption", "Azure Key Vault Integration")
Rel(Azure_Event_Grid, Azure_Key_Vault, "Triggers secret rotation workflows", "Event Grid webhook via Private Link")
Rel(Azure_Monitor, Azure_Key_Vault, "Collects diagnostic logs and access telemetry", "Diagnostic Settings API")

@enduml