@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "End-user browsing, purchasing, and reviewing physical and electronic books.")
System(Online_Bookstore, "Online Bookstore", "An Amazon-style e-commerce Online Bookstore system for browsing, purchasing, and reviewing physical and electronic books, built for global scale.")
System_Ext(AWS_CloudFront_AWS_WAF, "AWS CloudFront + AWS WAF", "CDN and Edge Security providing edge caching and OWASP Top-10 security mitigations.")
System_Ext(AWS_Route_53, "AWS Route 53", "DNS & Latency-Based Routing with health checks for automatic failover.")
System_Ext(Identity_Provider, "Identity Provider", "AWS Cognito or Auth0 handling centralized authentication supporting MFA via OIDC.")
System_Ext(Payment_Gateway, "Payment Gateway", "Stripe or PayPal processing secure tokenized transactions.")
System_Ext(Shipping_Provider_APIs, "Shipping Provider APIs", "FedEx or UPS calculating rates and fulfillment.")
System_Ext(Email___Notification_Service, "Email / Notification Service", "AWS SES or SendGrid dispatching transactional emails.")

Rel(Customer, AWS_CloudFront_AWS_WAF, "Routes web requests", "HTTPS")
Rel(AWS_Route_53, Online_Bookstore, "Directs latency-based traffic across regions (us-east-1, eu-west-1, ap-southeast-1)", "DNS")
Rel(Online_Bookstore, Identity_Provider, "Authenticates users", "OIDC/OAuth2/HTTPS")
Rel(Online_Bookstore, Payment_Gateway, "Processes secure tokenized transactions", "REST/TLS 1.3")
Rel(Online_Bookstore, Shipping_Provider_APIs, "Calculates rates and fulfillment", "REST/TLS")
Rel(Online_Bookstore, Email___Notification_Service, "Dispatches transactional emails", "SMTP/REST")
@enduml