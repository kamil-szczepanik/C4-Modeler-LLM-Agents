@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Single Page Application, "Single Page Application", "External client")
System_Ext(IdentityProvider, "Identity Provider", "External identity provider")
System_Ext(CatalogAndSearch, "Catalog & Search", "Backend microservice")
System_Ext(OrderAndCheckout, "Order & Checkout", "Backend microservice")
System_Ext(EngagementService, "Engagement Service", "Backend microservice")

Container_Boundary(api_gateway_alb, "API Gateway / ALB") {
    Component(Routing_SSL_Termination_Proxy, "Routing & SSL Termination Proxy", "AWS ALB", "Sends incoming web/API traffic and passes raw requests.")
    Component(API_Authentication_Authorization_Filter, "API Authentication & Authorization Filter", "AWS Lambda / API Gateway", "Validates JWT signatures.")
    Component(Rate_Limiting_Throttling_Module, "Rate Limiting & Throttling Module", "Amazon ElastiCache Redis", "Provides distributed rate limiting and throttling support.")
    Component(Request_Transformation_Masking_Filter, "Request Transformation & Masking Filter", "Custom Filter", "Forwards sanitized payloads.")
    Component(AWS_WAF, "AWS WAF", "AWS WAF with AWS Managed Rules", "Inspects and filters web traffic for OWASP Top-10 mitigations and bot protection.")
}

Rel(Single Page Application, Routing_SSL_Termination_Proxy, "Sends incoming web/API traffic", "HTTPS/TLS 1.3")
Rel(AWS_WAF, Routing_SSL_Termination_Proxy, "Inspects and filters web traffic", "HTTP/HTTPS")
Rel(API_Authentication_Authorization_Filter, IdentityProvider, "Validates JWT signatures", "HTTPS")
Rel(Routing_SSL_Termination_Proxy, Request_Transformation_Masking_Filter, "Passes raw requests", "Internal HTTP/2")
Rel(Request_Transformation_Masking_Filter, CatalogAndSearch, "Forwards sanitized payloads", "mTLS via AWS App Mesh")
Rel(Request_Transformation_Masking_Filter, OrderAndCheckout, "Forwards sanitized payloads", "mTLS via AWS App Mesh")
Rel(Request_Transformation_Masking_Filter, EngagementService, "Forwards sanitized payloads", "mTLS via AWS App Mesh")

@enduml