@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_opensearch, "Amazon OpenSearch") {
    Component(Search Indexing Engine, "Search Indexing Engine", "Apache Lucene", "Handles the ingestion, indexing, and structural organization of catalogue data.")
    Component(Query Processing API, "Query Processing API", "REST / HTTPS", "Processes low-latency search queries received from the Catalog & Search container.")
}

Rel(Query Processing API, Search Indexing Engine, "Executes searches against")

@enduml