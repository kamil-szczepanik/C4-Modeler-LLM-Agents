@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_aurora_postgresql, "Amazon Aurora PostgreSQL") {
    Component(AWS_RDS_Proxy, "AWS RDS Proxy", "AWS RDS Proxy", "Provides connection pooling and transaction management for database queries.")
    Component(Primary_Writer_Instance, "Primary Writer Instance", "PostgreSQL Engine", "Handles write operations and transactional updates for the database.")
    Component(Global_Read_Replicas, "Global Read Replicas", "PostgreSQL Engine", "Serves read traffic across global regions to ensure low-latency performance.")
    Component(Aurora_Distributed_Storage_Volume, "Aurora Distributed Storage Volume", "Amazon Aurora Storage", "Underlying distributed storage layer handling automated storage replication.")
}

Rel(AWS_RDS_Proxy, Primary_Writer_Instance, "Routes connection-pooled write queries via TCP", "TCP")
Rel(Primary_Writer_Instance, Global_Read_Replicas, "Replicates data via storage-level replication log stream", "Storage-level replication")

@enduml