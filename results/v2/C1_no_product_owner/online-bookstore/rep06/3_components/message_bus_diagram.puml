@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(message_bus, "Message Bus") {
    Component(Event_Publisher, "Event Publisher", "AWS SNS Topics", "Handles fan-out messaging and broadcast of domain events.")
    Component(Event_Queue, "Event Queue", "AWS SQS Queues", "Provides reliable, durable queuing with SQS Long Polling.")
    Component(Schema_Validator, "Schema Validator", "Application-level validation", "Enforces JSON schema contracts before publishing.")
    Component(Dead_Letter_Queues, "Dead-Letter Queues", "AWS SQS DLQ", "Isolates and stores failed messages.")
    Component(Monitoring_Security_Controls, "Monitoring & Security Controls", "AWS KMS, IAM least-privilege, AWS CloudWatch, AWS CloudTrail", "Secures and monitors message bus operations and compliance.")
}

Rel(Schema_Validator, Event_Publisher, "Forwards validated domain events", "AWS Internal")
Rel(Event_Publisher, Event_Queue, "Fans out messages", "AWS Internal")
@enduml