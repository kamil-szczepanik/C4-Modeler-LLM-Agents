@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Single Page Application container

Container_Boundary(single_page_application, "Single Page Application") {
    Component(router_shell, "Router / Shell", "React / TypeScript", "Component managing client-side routing, layout, and lazy loading.")
    Component(catalogue_search_view, "Catalogue & Search View", "React / TypeScript", "Components for browsing, filtering, and keyword search.")
    Component(cart_checkout_flow, "Cart & Checkout Flow", "React / TypeScript", "Components managing shopping cart state and secure checkout.")
    Component(reviews_ratings_widget, "Reviews & Ratings Widget", "React / TypeScript", "Components for displaying and submitting customer reviews.")
    Component(recommendation_widget, "Recommendation Widget", "React / TypeScript", "Components displaying 'Customers also bought' items.")
    Component(api_client, "API Client", "React / TypeScript", "Centralized HTTP/REST communication layer injecting correlation IDs and managing in-memory tokens.")
}

Rel(router_shell, catalogue_search_view, "Loads and renders")
Rel(router_shell, cart_checkout_flow, "Loads and renders")
Rel(router_shell, reviews_ratings_widget, "Loads and renders")
Rel(router_shell, recommendation_widget, "Loads and renders")
Rel(catalogue_search_view, api_client, "Sends API requests via")
Rel(cart_checkout_flow, api_client, "Sends API requests via")
Rel(reviews_ratings_widget, api_client, "Sends API requests via")
Rel(recommendation_widget, api_client, "Sends API requests via")

@enduml