@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog & Search container

Container_Boundary(catalog_and_search, "Catalog & Search") {
    Component(CatalogAPIController, "Catalog API Controller", "Node.js / Express", "Handles incoming HTTP browsing and filtering requests.")
    Component(SearchServiceEngine, "Search Service Engine", "Node.js / TypeScript", "Executes sanitized domain queries.")
    ComponentDb(CachingLayer, "Caching Layer", "Amazon ElastiCache / Redis", "Caches frequent queries and catalog metadata.")
    Component(CatalogSynchronizationConsumer, "Catalog Synchronization Consumer", "Node.js", "Processes asynchronous inventory and price updates.")
    Component(AmazonOpenSearch, "Amazon OpenSearch", "Managed Search Engine", "Indexes catalog data for search and fast filtering.")
    Component(AmazonSQSSNS, "Amazon SQS / SNS", "Message Bus", "Message bus for asynchronous event distribution.")
}

Rel(CatalogAPIController, CachingLayer, "Internal Redis protocol via TCP", "TCP")
Rel(CachingLayer, SearchServiceEngine, "Fallback on cache miss via internal function calls", "Internal")
Rel(CatalogAPIController, SearchServiceEngine, "Internal function calls / gRPC", "gRPC")
Rel(SearchServiceEngine, AmazonOpenSearch, "REST/HTTPS queries over TLS 1.3", "REST/HTTPS")
Rel(AmazonSQSSNS, CatalogSynchronizationConsumer, "AMQP/HTTPS event consumption with payload signing (HMAC)", "AMQP/HTTPS")
Rel(CatalogSynchronizationConsumer, CachingLayer, "Redis pub/sub for event-driven cache invalidation", "Redis Pub/Sub")

@enduml