@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon DynamoDB container

Container_Boundary(dynamodb_boundary, "Amazon DynamoDB") {
    Component(RequestRouterCoordinator, "Request Router & Coordinator", "AWS Distributed Request Router", "Routes and coordinates incoming low-latency cart and session operations.")
    Component(StorageNodeEngine, "Storage Node Engine", "B-tree / LSM-tree on AWS Nitro", "Provides scalable, low-latency persistence for cart and session data.")
    Component(ReplicationConsensusManager, "Replication & Consensus Manager", "AWS Multi-AZ Paxos Consensus", "Manages multi-region replication and consensus for high availability.")
    Component(DynamoDBStreamsProcessor, "DynamoDB Streams Processor", "DynamoDB Streams API", "Captures and processes change data events asynchronously.")
    Component(AWSPrivateLink, "AWS PrivateLink", "VPC Endpoints", "Provides zero-trust network isolation preventing public internet exposure.")
    Component(AWSKMS, "AWS KMS", "Customer Managed Keys", "Handles encryption at rest and across global table replicas for compliance.")
}

Component(OrderCheckout, "Order & Checkout", "AWS SDK", "External caller container executing low-latency cart operations.")
Component(MessageBus, "Message Bus", "AWS SDK / HTTPS", "External messaging infrastructure receiving CDC events.")

Rel(OrderCheckout, RequestRouterCoordinator, "Executes low-latency cart operations via AWS SDK", "HTTPS / TLS")
Rel(OrderCheckout, RequestRouterCoordinator, "Connects via VPC Endpoints", "AWS PrivateLink")
Rel(RequestRouterCoordinator, DynamoDBStreamsProcessor, "Triggers change events", "Internal AWS IPC / TCP")
Rel(DynamoDBStreamsProcessor, MessageBus, "Publishes CDC events", "HTTPS / AWS SDK")

@enduml