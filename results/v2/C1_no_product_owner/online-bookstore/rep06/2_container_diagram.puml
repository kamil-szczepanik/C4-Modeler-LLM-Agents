@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "End-user browsing, purchasing, and reviewing physical and electronic books.")
System_Ext(Payment_Gateway, "Payment Gateway", "Third-party system processing secure tokenized transactions.")
System_Ext(Shipping_Provider_APIs, "Shipping Provider APIs", "Third-party systems calculating rates and fulfillment.")

System_Boundary(Online_Bookstore, "Online Bookstore") {
    Container(Single_Page_Application, "Single Page Application", "React / TypeScript, AWS S3, CloudFront", "Frontend interface providing catalogue browsing, secure checkout, reviews, and recommendations.")
    Container(API_Gateway_ALB, "API Gateway / ALB", "AWS ALB / API Gateway", "Routes and manages incoming web and API traffic.")
    Container(Catalog_Search, "Catalog & Search", "Amazon ECS Fargate, Amazon OpenSearch", "Handles catalogue management and search capabilities.")
    Container(Order_Checkout, "Order & Checkout", "Amazon ECS Fargate, Amazon Aurora PostgreSQL, Amazon DynamoDB", "Manages orders, checkouts, carts, and sessions.")
    Container(Engagement_Service, "Engagement Service", "Amazon ECS Fargate", "Handles reviews, recommendations, and customer engagement features.")
    ContainerDb(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL, AWS RDS Proxy", "Multi-region transactional database.")
    ContainerDb(Amazon_DynamoDB, "Amazon DynamoDB", "Amazon DynamoDB", "Database storing carts and sessions.")
    ContainerDb(Amazon_OpenSearch, "Amazon OpenSearch", "Amazon OpenSearch", "Search engine for catalogue search.")
    Container(Message_Bus, "Message Bus", "Amazon SQS / SNS", "Handles asynchronous inter-service communication.")
}

Rel(Customer, Single_Page_Application, "Browses catalogue and interacts with the application", "HTTPS/TLS 1.3")
Rel(Single_Page_Application, API_Gateway_ALB, "Sends API requests", "HTTPS/TLS 1.3")
Rel(API_Gateway_ALB, Catalog_Search, "Routes search and catalog requests", "mTLS via AWS App Mesh / OAuth2.0/JWT")
Rel(API_Gateway_ALB, Order_Checkout, "Routes order and checkout requests", "mTLS via AWS App Mesh / OAuth2.0/JWT")
Rel(API_Gateway_ALB, Engagement_Service, "Routes engagement and review requests", "mTLS via AWS App Mesh / OAuth2.0/JWT")
Rel(Catalog_Search, Amazon_OpenSearch, "Queries and indexes catalog data", "TLS-encrypted TCP via AWS RDS Proxy")
Rel(Order_Checkout, Amazon_Aurora_PostgreSQL, "Reads and writes transactional order data", "TLS-encrypted TCP via AWS RDS Proxy")
Rel(Order_Checkout, Amazon_DynamoDB, "Reads and writes cart and session data", "TLS-encrypted TCP")
Rel(Order_Checkout, Payment_Gateway, "Processes secure payments", "HTTPS/REST")
Rel(Order_Checkout, Shipping_Provider_APIs, "Calculates shipping rates and fulfillment", "HTTPS/REST")
Rel(Catalog_Search, Message_Bus, "Publishes and subscribes to asynchronous events", "AMQP/HTTPS")
Rel(Order_Checkout, Message_Bus, "Publishes and subscribes to asynchronous events", "AMQP/HTTPS")
Rel(Engagement_Service, Message_Bus, "Publishes and subscribes to asynchronous events", "AMQP/HTTPS")
@enduml