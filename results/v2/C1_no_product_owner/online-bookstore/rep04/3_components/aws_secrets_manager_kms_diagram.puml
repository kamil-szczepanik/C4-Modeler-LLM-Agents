@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS Secrets Manager & KMS container

Component(Core E-Commerce Service, "Core E-Commerce Service", "Node.js, TypeScript, AWS ECS Fargate", "Core e-commerce service executing API calls, managing customer interactions, and utilizing AWS SDK client-side caching.")

Container_Boundary("AWS Secrets Manager & KMS", "AWS Secrets Manager & KMS") {
    Component(Secrets Engine Component, "Secrets Engine Component", "AWS Secrets Manager", "Manages automated database credential rotation, API keys, and fetches runtime DB credentials.")
    Component(Key Management Component, "Key Management Component", "AWS Key Management Service (KMS)", "Provides Customer Managed Keys (CMKs) for envelope encryption of PII at rest and encrypts/decrypts sensitive customer PII fields.")
    Component(IAM Policy Enforcement Component, "IAM Policy Enforcement Component", "AWS IAM & Resource-Based Policies", "Enforces strict IAM and resource-based policies for access control and compliance.")
    Component(VPC Endpoint Integration Component, "VPC Endpoint Integration Component", "AWS PrivateLink / Interface VPC Endpoints", "Routes API calls internally and forwards requests securely without public internet exposure.")
}

Rel(Core E-Commerce Service, VPC Endpoint Integration Component, "Routes API calls internally", "AWS PrivateLink / TLS 1.3")
Rel(VPC Endpoint Integration Component, Secrets Engine Component, "Forwards requests securely", "AWS internal network")
Rel(VPC Endpoint Integration Component, Key Management Component, "Forwards requests securely", "AWS internal network")
Rel(Core E-Commerce Service, Secrets Engine Component, "Fetches runtime DB credentials", "HTTPS/TLS via AWS SDK")
Rel(Core E-Commerce Service, Key Management Component, "Encrypts/decrypts sensitive customer PII fields", "AWS KMS API / TLS")

@enduml