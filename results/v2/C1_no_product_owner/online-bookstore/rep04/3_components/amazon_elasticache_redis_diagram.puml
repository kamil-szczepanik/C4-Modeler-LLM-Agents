@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Core_E_Commerce_Service, "Core E-Commerce Service", "Application Service", "Interacts with Redis modules for sessions, carts, and cache management.")
System_Ext(Amazon_S3, "Amazon S3", "AWS Storage Service", "Automated daily snapshots and AOF persistence")
System_Ext(Amazon_CloudWatch, "Amazon CloudWatch & AWS KMS", "AWS Management & Security Services", "Provides metrics monitoring, slow log analysis, and encryption.")

Container_Boundary(Amazon_ElastiCache_Redis, "Amazon ElastiCache Redis") {
    Component(Session_Store_Module, "Session Store Module", "Redis RESP over TLS, Redis ACLs", "Manages high-performance in-memory user sessions for fast page loads.")
    Component(Distributed_Shopping_Cart_Module, "Distributed Shopping Cart Module", "Redis RESP over TLS, Redis ACLs", "Handles shopping cart persistence and rapid item updates.")
    Component(Cache_Aside___Eviction_Management_Module, "Cache-Aside / Eviction Management Module", "Redis RESP over TLS, cache.m6g.xlarge", "Configures TTLs and invalidations to support global scaling and low-latency data access.")
}

Rel(Core_E_Commerce_Service, Session_Store_Module, "Read/Write user sessions via Redis RESP protocol over TLS")
Rel(Core_E_Commerce_Service, Distributed_Shopping_Cart_Module, "Read/Write cart items via Redis RESP protocol over TLS")
Rel(Core_E_Commerce_Service, Cache_Aside___Eviction_Management_Module, "Configure TTLs and invalidations via Redis RESP protocol over TLS")
Rel(Amazon_ElastiCache_Redis, Amazon_S3, "Automated daily snapshots and AOF persistence")
Rel(Amazon_ElastiCache_Redis, Amazon_CloudWatch, "Metrics monitoring (EngineCPUUtilization, DatabaseMemoryUsagePercentage, Slow Log)")

@enduml