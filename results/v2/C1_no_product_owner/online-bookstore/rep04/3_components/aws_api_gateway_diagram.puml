@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_api_gateway, "AWS API Gateway") {
    Component(REST_API_Endpoint, "REST API Endpoint", "AWS API Gateway", "Serves as the entry point for client requests, handling routing and edge security.")
    Component(AWS_Lambda_Authorizer, "AWS Lambda Authorizer", "AWS Lambda, Node.js", "Validates JWT tokens for incoming client requests.")
    Component(Request_Validator, "Request Validator", "AWS API Gateway native", "Schema-validates incoming JSON payloads to ensure structural integrity.")
    Component(Rate_Limiting_Module, "Rate Limiting Module", "AWS WAF / API Gateway Usage Plans", "Protects backend services by throttling excessive requests and mitigating abuse.")
}

Rel(REST_API_Endpoint, AWS_Lambda_Authorizer, "Validates JWT tokens", "In-memory invocation")
Rel(REST_API_Endpoint, Request_Validator, "Schema-validates JSON payloads", "Local execution")
Rel(REST_API_Endpoint, Rate_Limiting_Module, "Enforces rate limits and edge security", "AWS WAF integration")

@enduml