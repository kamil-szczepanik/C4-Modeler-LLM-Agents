@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Background Worker Service container

Container_Boundary(background_worker_service, "Background Worker Service") {
    Component(Queue_Consumer_Component, "Queue Consumer Component", "TypeScript, aws-sdk, sqs-consumer", "Polls asynchronous jobs from Amazon SQS")
    Component(Order_Processing_Engine, "Order Processing Engine", "TypeScript", "Executes transactional database writes and processes core orders")
    Component(Shipping_Integrator_Component, "Shipping Integrator Component", "TypeScript, axios", "Manages external API calls to shipping providers")
    Component(Task_Scheduler_Component, "Task Scheduler Component", "TypeScript, node-cron, AWS EventBridge", "Schedules and triggers periodic background tasks")
    Component(Outbox_Dispatcher_Component, "Outbox Dispatcher Component", "TypeScript", "Polls and clears outbox tables and publishes domain events")
}

Component(Amazon_SQS, "Amazon SQS", "AWS SQS", "Enables decoupled, asynchronous messaging with DLQs")
Component(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "PostgreSQL", "Transactional database for storing state and outbox tables")
Component(Shipping_Provider_APIs, "Shipping Provider APIs", "REST/JSON over HTTPS", "External APIs for managing shipments")
Component(Amazon_SNS, "Amazon SNS", "AWS SNS", "Publishes domain events securely")

Rel(Queue_Consumer_Component, Amazon_SQS, "Polls asynchronous jobs", "HTTPS / IAM")
Rel(Order_Processing_Engine, Amazon_Aurora_PostgreSQL, "Executes transactional database writes", "PostgreSQL Wire Protocol / TLS")
Rel(Shipping_Integrator_Component, Shipping_Provider_APIs, "Manages external API calls", "REST/JSON over HTTPS with mTLS")
Rel(Outbox_Dispatcher_Component, Amazon_SNS, "Publishes domain events", "HTTPS / IAM")
Rel(Outbox_Dispatcher_Component, Amazon_Aurora_PostgreSQL, "Polls and clears outbox tables", "PostgreSQL Wire Protocol / TLS")

@enduml