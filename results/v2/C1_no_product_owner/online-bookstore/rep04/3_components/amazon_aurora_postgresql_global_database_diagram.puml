@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_aurora_postgresql_global_database, "Amazon Aurora PostgreSQL Global Database") {
    Component(Primary_DB_Cluster, "Primary DB Cluster", "Amazon Aurora PostgreSQL", "Handles primary write operations, transactional consistency, and orchestrates cross-region replication.")
    Component(Secondary_DB_Clusters, "Secondary DB Clusters", "Amazon Aurora PostgreSQL", "Provides sub-10ms regional read operations across eu-west-1 and ap-southeast-1.")
    Component(Regional_Storage_Subsystem, "Regional Storage Subsystem", "Amazon Aurora Storage", "Persists encrypted transaction logs locally using region-bound AWS KMS CMKs.")
}

Rel(Primary_DB_Cluster, Secondary_DB_Clusters, "Replicates transactional data cross-region via dedicated AWS backbone infrastructure", "")
Rel(Primary_DB_Cluster, Regional_Storage_Subsystem, "Persists encrypted transaction logs locally", "")

@enduml