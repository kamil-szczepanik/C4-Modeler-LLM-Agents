@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon CloudFront & AWS S3 container

Container_Boundary(amazon_cloudfront_aws_s3, "Amazon CloudFront & AWS S3") {
    Component(Amazon_CloudFront, "Amazon CloudFront", "AWS CloudFront", "Global CDN and edge router providing SSL/TLS termination, global caching, and routing of static assets and API requests.")
    Component(AWS_S3_Bucket, "AWS S3 Bucket", "AWS S3", "Static asset storage with server-side encryption via AWS KMS and Block Public Access.")
    Component(CloudFront_Functions, "CloudFront Functions", "CloudFront Functions JavaScript", "Executes URL rewrites and header injections at edge runtime with sub-2ms transformations.")
    Component(AWS_WAF, "AWS WAF", "AWS WAF", "Inspects incoming client traffic for security threats and provides OWASP Top-10 mitigations.")
}

Rel(Amazon_CloudFront, CloudFront_Functions, "Executes URL rewrites and header injections")
Rel(Amazon_CloudFront, AWS_S3_Bucket, "Fetches uncached static assets using Origin Access Control (OAC)")
Rel(AWS_WAF, Amazon_CloudFront, "Inspects incoming client traffic for security threats")
@enduml