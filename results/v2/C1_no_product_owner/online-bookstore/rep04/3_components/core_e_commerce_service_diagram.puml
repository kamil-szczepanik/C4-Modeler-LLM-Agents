@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core E-Commerce Service container

System_Ext(Payment Gateway, "Payment Gateway", "External payment processor")
System_Ext(Amazon_SQS_SNS, "Amazon SQS / SNS", "Messaging and notification service")
System_Ext(Amazon_Aurora_PostgreSQL_Global_Database, "Amazon Aurora PostgreSQL Global Database", "Transactional data storage")
System_Ext(Amazon_ElastiCache_Redis, "Amazon ElastiCache Redis", "In-memory cache for session and cart state")

Container_Boundary(core_ecommerce_service, "Core E-Commerce Service") {
    Component(Checkout Orchestrator Component, "Checkout Orchestrator Component", "Node.js, TypeScript, AWS ECS Fargate", "Manages the checkout process and coordinates payment gateway integration.")
    Component(Fulfillment Coordinator Component, "Fulfillment Coordinator Component", "Node.js, TypeScript, AWS ECS Fargate", "Coordinates order fulfillment and communicates with messaging queues.")
    Component(Data Access Repository Component, "Data Access Repository Component", "Node.js, TypeScript, AWS ECS Fargate", "Handles data access and persistence operations for transactional data.")
}

Rel(Checkout Orchestrator Component, Payment Gateway, "Secure payment processing", "HTTPS")
Rel(Fulfillment Coordinator Component, Amazon_SQS_SNS, "Publishes asynchronous fulfillment events", "TLS / IAM")
Rel(Data Access Repository Component, Amazon_Aurora_PostgreSQL_Global_Database, "Transactional data persistence", "gRPC over mTLS")
Rel(Checkout Orchestrator Component, Amazon_ElastiCache_Redis, "Cart and session state management", "mTLS")
Rel(Checkout Orchestrator Component, Fulfillment Coordinator Component, "East-West communication", "gRPC over mTLS using AWS App Mesh")

@enduml