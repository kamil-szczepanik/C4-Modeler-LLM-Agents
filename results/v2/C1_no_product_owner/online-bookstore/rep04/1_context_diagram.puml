@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "End-user browsing, purchasing, and reviewing books.")

System(Online_Bookstore_System, "Online Bookstore System", "Core multi-region e-commerce platform built on AWS to sell physical and electronic books with recommendations and reviews, providing secure browsing, purchasing, and fulfillment.")

System_Ext(Payment_Gateway, "Payment Gateway", "Stripe or PayPal for secure PCI-DSS compliant checkout.")
System_Ext(Shipping_Provider_APIs, "Shipping Provider APIs", "FedEx or UPS for order fulfillment.")
System_Ext(Tax_Compliance_Service, "Tax & Compliance Service", "Avalara for regional tax calculation and GDPR/CCPA requests.")
System_Ext(Identity_Provider, "Identity Provider", "AWS Cognito or Auth0 for authentication and MFA.")
System_Ext(Notification_Service, "Notification Service", "AWS SES or SendGrid for transactional emails.")
System_Ext(CDN_Global_Traffic_Manager, "CDN / Global Traffic Manager", "AWS CloudFront and Route 53 for edge caching and geo-routing.")
System_Ext(APM_Monitoring_Provider, "APM & Monitoring Provider", "Datadog or AWS CloudWatch for distributed tracing and logs.")
System_Ext(Secrets_Manager, "Secrets Manager", "AWS Secrets Manager for credential storage and rotation.")

Rel(Customer, CDN_Global_Traffic_Manager, "Accesses platform via HTTPS", "HTTPS (TLS 1.3)")
Rel(Online_Bookstore_System, Payment_Gateway, "Processes transactions", "REST/HTTPS")
Rel(Online_Bookstore_System, Shipping_Provider_APIs, "Generates labels", "REST/JSON over HTTPS")
Rel(Online_Bookstore_System, Tax_Compliance_Service, "Validates taxes", "REST/HTTPS")
Rel(Online_Bookstore_System, Identity_Provider, "Authenticates users", "OAuth2/OIDC using short-lived JWTs")
Rel(Online_Bookstore_System, Notification_Service, "Dispatches emails", "SMTP/HTTPS")

@enduml