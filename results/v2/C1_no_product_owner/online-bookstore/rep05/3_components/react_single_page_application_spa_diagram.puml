@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the React Single-Page Application (SPA) container

System_Ext(AmazonCloudFront, "Amazon CloudFront", "Delivers static assets and enforces TLS 1.3")
System_Ext(AmazonAPIGateway, "Amazon API Gateway", "Manages backend API requests")

Container_Boundary(ReactSPA, "React Single-Page Application (SPA)") {
    Component(RouterComponent, "Router Component", "React Router", "Handles client-side routing and navigation between views.")
    Component(CatalogSearchModule, "Catalog & Search Module", "React", "Provides browsing and search functionalities for the bookstore catalog.")
    Component(CheckoutCartModule, "Checkout & Cart Module", "React", "Manages shopping cart state and checkout processes.")
    Component(RecommendationReviewModule, "Recommendation & Review Module", "React", "Displays product recommendations and user reviews.")
    Component(APIClientLayer, "API Client Layer", "Axios REST Client & Apollo GraphQL Client", "Sends REST and GraphQL queries with JWT injection to the backend.")
    Component(StateManagementStore, "State Management Store", "Zustand", "Manages client-side state for instant UI feedback without persisting PII locally.")
}

Rel(AmazonCloudFront, RouterComponent, "Delivers static assets [HTTPS]", "HTTPS")
Rel(APIClientLayer, AmazonAPIGateway, "Sends REST and GraphQL queries with JWT injection", "HTTPS/REST and GraphQL")

@enduml