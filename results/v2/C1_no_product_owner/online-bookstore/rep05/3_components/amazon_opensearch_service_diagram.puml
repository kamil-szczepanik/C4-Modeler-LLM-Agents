@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(CatalogService, "Catalog Service", "External system")
System_Ext(AmazonS3, "Amazon S3", "Stores disaster recovery snapshots and cold storage data")

Container_Boundary(AmazonOpenSearchService, "Amazon OpenSearch Service") {
    Component(OpenSearchRESTAPIRoutingLayer, "OpenSearch REST API / Routing Layer", "OpenSearch Core HTTP REST interface", "Handles incoming HTTP REST requests and routes payloads and queries.")
    Component(SearchQueryEngine, "Search & Query Engine", "Apache Lucene / OpenSearch Query DSL", "Powers full-text search, fuzzy matching, and executes review and keyword search queries.")
    Component(IndexingAnalysisPipeline, "Indexing & Analysis Pipeline", "OpenSearch Index Modules", "Manages inverted indices and processes data ingestion.")
    Component(ISMController, "Index State Management (ISM) Controller", "OpenSearch ISM Engine", "Automates index lifecycles and exports automated snapshots.")
    Component(DedicatedMasterNodes, "Dedicated Master Nodes", "OpenSearch Cluster Nodes", "Manages cluster state, routing, and high availability.")
}

Rel(CatalogService, OpenSearchRESTAPIRoutingLayer, "Submits payloads and queries", "HTTPS, TLS 1.3, AWS SigV4")
Rel(SearchQueryEngine, IndexingAnalysisPipeline, "Manages inverted indices", "Internal Transport, EBS")
Rel(ISMController, AmazonS3, "Exports automated snapshots", "HTTPS, AWS KMS")

@enduml