@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Component(CatalogService, "Catalog Service", "ECS Fargate client", "Queries and mutates item attributes.")

System_Boundary(AmazonDynamoDB, "Amazon DynamoDB") {
    Component(RequestRouterAPIFrontend, "Request Router / API Frontend", "AWS API Frontend / IAM SigV4", "Routes data read and write operations from clients.")
    Component(StorageNodeEnginePartitionStorage, "Storage Node Engine (Partition Storage)", "Distributed B-Tree Storage Engine, SSD", "Manages partition storage and executes data read/write operations.")
    Component(RequestRouterTransactionCoordinator, "Request Router / Transaction Coordinator", "Distributed Coordinator", "Coordinates transactions and request routing.")
    Component(ReplicationManagerPaxosGroupManager, "Replication Manager (Paxos Group Manager)", "Multi-Paxos Consensus", "Synchronizes partition state across replicas.")
}

Rel(CatalogService, RequestRouterAPIFrontend, "Queries and mutates item attributes", "HTTPS/TLS, IAM SigV4")
Rel(RequestRouterAPIFrontend, StorageNodeEnginePartitionStorage, "Routes data read/write operations", "Internal RPC")
Rel(StorageNodeEnginePartitionStorage, ReplicationManagerPaxosGroupManager, "Synchronizes partition state across replicas", "Multi-Paxos")

@enduml