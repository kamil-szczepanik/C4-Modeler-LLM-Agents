@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Order_Checkout_Service, "Order & Checkout Service", "External system component")
Person(Recommendation_Service, "Recommendation Service", "External system component")

Container_Boundary(Amazon_ElastiCache_Redis, "Amazon ElastiCache (Redis)") {
    Component(Session_Store_Engine, "Session Store Engine", "Redis Hash", "Managing user authentication tokens and preferences.")
    Component(Cart_Cache_Engine, "Cart Cache Engine", "Redis String/Hash", "Persisting transient shopping carts during checkout.")
    Component(Recommendation_Cache_Engine, "Recommendation Cache Engine", "Redis Sorted Sets (ZSET)", "Storing precomputed 'Customers also bought' data.")
}

Rel(Order_Checkout_Service, Session_Store_Engine, "Reads/writes user session data", "RESP protocol over TLS 1.3 [TCP 6379]")
Rel(Order_Checkout_Service, Cart_Cache_Engine, "Manages active shopping cart state", "RESP protocol over TLS 1.3 [TCP 6379]")
Rel(Recommendation_Service, Recommendation_Cache_Engine, "Queries cached recommendations", "RESP protocol over TLS 1.3 [TCP 6379]")

@enduml