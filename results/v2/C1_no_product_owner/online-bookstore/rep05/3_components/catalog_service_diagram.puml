@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog Service container

Container_Boundary(catalog_service, "Catalog Service") {
    Component(API_Controller, "API Controller", "Express Router", "Handles inbound gRPC/HTTP routing, payload validation, and request mapping.")
    Component(Catalog_Business_Logic_Domain_Core, "Catalog Business Logic / Domain Core", "Node.js", "Encapsulates rules for category management, book metadata, and inventory linking.")
    Component(Search_Indexing_Adapter, "Search & Indexing Adapter", "HTTPS/REST", "Interfaces with Amazon OpenSearch Service for keyword search and faceting.")
    Component(Data_Access_Repository, "Data Access Repository", "AWS SDK v3", "Interfaces with Amazon DynamoDB for CRUD operations.")
    Component(Cache_Aside_Repository_Wrapper, "Cache-Aside Repository Wrapper", "Amazon ElastiCache (Redis)", "Manages read-through/write-through caching strategy.")
    Component(Event_Publisher_Consumer, "Event Publisher/Consumer", "Amazon EventBridge, SNS, SQS", "Interacts with messaging services to broadcast catalog updates.")
}

System_Ext(Amazon_OpenSearch_Service, "Amazon OpenSearch Service", "External search and indexing engine.")
System_Ext(Amazon_DynamoDB, "Amazon DynamoDB", "NoSQL database for high-throughput CRUD operations.")
System_Ext(Amazon_ElastiCache_Redis, "Amazon ElastiCache (Redis)", "In-memory caching layer.")
System_Ext(Amazon_EventBridge_SQS_SNS, "Amazon EventBridge, SQS, SNS", "AWS messaging and event distribution services.")

Rel(API_Controller, Catalog_Business_Logic_Domain_Core, "Invokes core domain rules via dependency injection.")
Rel(Catalog_Business_Logic_Domain_Core, Data_Access_Repository, "Reads/writes catalog data")
Rel(Catalog_Business_Logic_Domain_Core, Cache_Aside_Repository_Wrapper, "Checks/updates cache")
Rel(Catalog_Business_Logic_Domain_Core, Search_Indexing_Adapter, "Queries search indexes")
Rel(Catalog_Business_Logic_Domain_Core, Event_Publisher_Consumer, "Dispatches domain events")

Rel(Search_Indexing_Adapter, Amazon_OpenSearch_Service, "Indexes and queries catalog data", "HTTPS/REST [TLS 1.3, IAM roles]")
Rel(Data_Access_Repository, Amazon_DynamoDB, "Executes high-throughput CRUD operations", "AWS SDK v3 [TLS, IAM roles, regional KMS CMKs]")
Rel(Cache_Aside_Repository_Wrapper, Amazon_ElastiCache_Redis, "Caches catalog data", "in-transit TLS, at-rest KMS CMKs, LRU eviction")
Rel(Event_Publisher_Consumer, Amazon_EventBridge_SQS_SNS, "Publishes and consumes domain events", "JSON over HTTPS")

@enduml