@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Order & Checkout Service container

Container_Boundary("Order & Checkout Service", "Order & Checkout Service") {
    Component("Cart Management Component", "Cart Management Component", "Spring Bean / Redis Client", "Manages shopping carts and session data.")
    Component("Checkout Orchestrator", "Checkout Orchestrator", "Spring State Machine / Saga pattern with Resilience4j", "Orchestrates secure, multi-step transactions and external fulfillment workflows.")
    Component("Order Processing Component", "Order Processing Component", "Spring Data JPA", "Manages data persistence for transactional orders.")
    Component("Event Publisher Component", "Event Publisher Component", "Spring Cloud Stream", "Emits asynchronous domain events.")
    Component("Amazon ElastiCache (Redis)", "Amazon ElastiCache (Redis)", "Amazon ElastiCache (Redis)", "Delivers low-latency shopping cart and session management.")
    Component("Amazon RDS (PostgreSQL)", "Amazon RDS (PostgreSQL)", "Amazon RDS (PostgreSQL)", "Ensures durable persistence for transactional orders and externalized state machine states.")
    Component("Stripe, Avalara, Shipping APIs", "Stripe, Avalara, Shipping APIs", "HTTPS / REST", "External systems for payments, tax calculations, and fulfillment.")
    Component("Amazon EventBridge / SQS", "Amazon EventBridge / SQS", "AWS SDK v2 over HTTPS", "Messaging infrastructure for asynchronous domain events.")
}

Rel("Cart Management Component", "Amazon ElastiCache (Redis)", "Reads/writes cart sessions", "Redis Protocol over TLS")
Rel("Checkout Orchestrator", "Amazon RDS (PostgreSQL)", "Persists workflow state", "JDBC over TLS")
Rel("Checkout Orchestrator", "Stripe, Avalara, Shipping APIs", "Executes payments, tax calculations, and fulfillment", "HTTPS / REST")
Rel("Order Processing Component", "Amazon RDS (PostgreSQL)", "Commits final order line items", "Spring Data JPA over TLS")
Rel("Event Publisher Component", "Amazon EventBridge / SQS", "Emits asynchronous OrderPlaced domain events", "AWS SDK v2 over HTTPS")

@enduml