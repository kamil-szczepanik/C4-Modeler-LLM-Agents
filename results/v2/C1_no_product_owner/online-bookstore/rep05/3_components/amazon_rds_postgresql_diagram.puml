@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon RDS (PostgreSQL) container

Container_Boundary(amazon_rds_postgresql, "Amazon RDS (PostgreSQL)") {
    Component(ConnectionPooler, "Connection Pooler", "PgBouncer", "Manages database connections to prevent connection exhaustion.")
    Component(RelationalStorageEngine, "Relational Storage Engine", "PostgreSQL 15", "ACID-compliant transactional data storage for catalogs, orders, and PII.")
    Component(BackupReplicationManager, "Backup & Replication Manager", "AWS Backup / Amazon S3", "Manages encrypted snapshot exports and replication across regions.")
}

Rel(ConnectionPooler, RelationalStorageEngine, "Internal TCP socket")
Rel(BackupReplicationManager, RelationalStorageEngine, "Encrypted snapshot exports [AWS KMS, TLS 1.3]")

@enduml