@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Amazon_API_Gateway, "Amazon API Gateway", "Routes recommendation requests via gRPC over TLS.", "AWS App Mesh")
System_Ext(SQS, "SQS", "Queues asynchronous purchase/browsing events.", "JSON over HTTPS")
System_Ext(Amazon_SageMaker, "Amazon SageMaker", "Provides machine learning inference predictions.", "AWS SageMaker")
System_Ext(Amazon_ElastiCache_Redis_, "Amazon ElastiCache (Redis)", "Provides sub-millisecond cached responses and static fallback data.", "Redis")

Container_Boundary(Recommendation_Service, "Recommendation Service") {
    Component(API_Controller, "API Controller", "Python FastAPI, gRPC", "Handles incoming gRPC routing and input sanitization.")
    Component(Recommendation_Engine, "Recommendation Engine", "Python", "Core component running collaborative filtering logic and fallback mechanisms.")
    Component(Model_Gateway, "Model Gateway", "Python, AWS SDK", "Abstraction layer managing interactions with Amazon SageMaker.")
    Component(Event_Consumer, "Event Consumer", "Celery", "Background worker to ingest asynchronous events.")
    Component(Cache___Storage_Adapter, "Cache & Storage Adapter", "Redis-py", "Interfaces with Amazon ElastiCache (Redis) for cached responses and static fallback data.")
}

Rel(Amazon_API_Gateway, API_Controller, "Routes recommendation requests via gRPC over TLS", "AWS App Mesh")
Rel(Event_Consumer, SQS, "Pulls asynchronous purchase/browsing events", "JSON over HTTPS")
Rel(Recommendation_Engine, Cache___Storage_Adapter, "Reads/writes recommendation caches", "RESP over TCP with TLS")
Rel(Model_Gateway, Amazon_SageMaker, "Fetches model inference predictions", "HTTPS / AWS SDK via SigV4")
Rel(Cache___Storage_Adapter, Amazon_ElastiCache_Redis_, "Interfaces with cache storage")
@enduml