@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "Amazon API Gateway") {
    Component(Edge_Request_Router, "Edge Request Router", "Amazon API Gateway", "Routes incoming HTTPS and REST requests from the React SPA to appropriate backend services.")
    Component(Auth_Authorizer, "Auth & Authorizer", "AWS Lambda", "Handles authentication and authorization for incoming client requests.")
    Component(Rate_Limiter, "Rate Limiter", "Amazon API Gateway", "Enforces rate limiting to protect backend services from excessive traffic.")
    Component(GraphQL_Proxy, "GraphQL Proxy", "AWS AppSync / Amazon API Gateway", "Proxies GraphQL requests from the client to the underlying microservices.")
}

Rel(Edge_Request_Router, Auth_Authorizer, "Validates request tokens")
Rel(Edge_Request_Router, Rate_Limiter, "Checks request quotas")
Rel(Edge_Request_Router, GraphQL_Proxy, "Forwards GraphQL queries")

@enduml