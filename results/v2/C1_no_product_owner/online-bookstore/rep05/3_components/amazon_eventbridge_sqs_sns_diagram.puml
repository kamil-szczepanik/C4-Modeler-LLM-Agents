@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_eventbridge_sqs_sns, "Amazon EventBridge, SQS, SNS") {
    Component(Amazon EventBridge, "Amazon EventBridge", "AWS EventBridge", "Routes domain events across microservices for asynchronous event-driven architecture.")
    Component(Amazon SNS, "Amazon SNS", "AWS SNS", "Publishes notifications and fan-out messages to downstream subscribers.")
    Component(Amazon SQS, "Amazon SQS", "AWS SQS", "Buffers and queues asynchronous tasks with DLQs and KMS encryption.")
}

Rel(Amazon EventBridge, Amazon SQS, "Forwards routed domain events to queues for decoupled consumption", "")
Rel(Amazon EventBridge, Amazon SNS, "Triggers topic notifications for system events", "")

@enduml