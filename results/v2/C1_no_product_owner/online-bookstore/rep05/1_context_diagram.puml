@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "Web or mobile user browsing, managing cart, checking out, and leaving reviews.")
Person(Admin/Operations, "Admin/Operations", "Operations personnel managing the bookstore system and administration tasks.")

System(Online Bookstore, "Online Bookstore", "A cloud-native, multi-region Online Bookstore system designed on AWS to deliver scalable book retail services, recommendations, and reviews with global availability and secure third-party integrations.")

System_Ext(Stripe, "Stripe", "Payment Gateway for secure payment processing.")
System_Ext(FedEx/UPS, "FedEx/UPS", "Shipping Provider API for fulfillment and tracking.")
System_Ext(Avalara, "Avalara", "Tax Calculation Service.")
System_Ext(Auth0/AWS Cognito, "Auth0/AWS Cognito", "Identity Provider for authentication tokens and offloaded identity management.")
System_Ext(SendGrid/AWS SES, "SendGrid/AWS SES", "Communication Provider for asynchronous transactional alerts.")
System_Ext(AWS Route 53, "AWS Route 53", "Global Traffic Manager for latency-based global traffic routing and health checks.")
System_Ext(AWS CloudWatch/Datadog, "AWS CloudWatch/Datadog", "Observability, SIEM telemetry, and GDPR/CCPA audit logging.")
System_Ext(AWS Secrets Manager, "AWS Secrets Manager", "Infrastructure service for least-privilege credential rotation.")

Rel(Customer, Online Bookstore, "Browsing, cart, checkout, and reviews", "HTTPS/TLS")
Rel(Admin/Operations, Online Bookstore, "System administration and management", "HTTPS/TLS")
Rel(Online Bookstore, Stripe, "Secure payment processing", "HTTPS/REST via TLS 1.3")
Rel(Online Bookstore, FedEx/UPS, "Fulfillment and tracking with circuit-breakers", "HTTPS/REST")
Rel(Online Bookstore, Auth0/AWS Cognito, "Authentication tokens and identity management", "HTTPS/OIDC")
Rel(Online Bookstore, SendGrid/AWS SES, "Transactional alerts", "Asynchronous HTTPS/REST")
Rel(AWS Route 53, Online Bookstore, "Latency-based global traffic routing across regions", "DNS / Global Traffic Management")

@enduml