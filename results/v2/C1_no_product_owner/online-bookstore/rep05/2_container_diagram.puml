@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore

Person(Customer, "Customer", "Customers purchasing physical and electronic books, reading reviews, and getting recommendations.")
Person(Admin_Operations, "Admin/Operations", "Operations personnel managing the bookstore system and administration tasks.")

System_Ext(AWS_CloudFront_S3, "AWS CloudFront & S3", "Content delivery network and storage for hosting the frontend application.")
System_Ext(AWS_Route_53, "AWS Route 53", "Global Traffic Manager for latency-based global traffic routing and health checks.")
System_Ext(AWS_Secrets_Manager_KMS, "AWS Secrets Manager & KMS", "Security services for credential management and encryption key storage.")

System_Boundary(Online_Bookstore, "Online Bookstore") {
    Container(React_Single_Page_Application_SPA_, "React Single-Page Application (SPA)", "React, hosted on AWS S3, distributed via Amazon CloudFront", "Provides the user interface for browsing, cart management, checkout, and reviews.")
    Container(Amazon_API_Gateway, "Amazon API Gateway", "Amazon API Gateway", "Ingress point handling HTTPS/REST and GraphQL requests from the frontend.")
    Container(Catalog_Service, "Catalog Service", "Node.js / Express, AWS ECS (Fargate)", "Manages book catalog data, categories, and inventory metadata.")
    Container(Order___Checkout_Service, "Order & Checkout Service", "Spring Boot, AWS ECS (Fargate)", "Handles orders, transactions, shopping carts, and checkout workflows.")
    Container(Recommendation_Service, "Recommendation Service", "Python FastAPI, AWS ECS (Fargate)", "Provides personalized book recommendations using Python.")
    ContainerDb(Amazon_RDS_PostgreSQL_, "Amazon RDS (PostgreSQL)", "Amazon RDS (PostgreSQL)", "Stores transactional and relational data.")
    ContainerDb(Amazon_DynamoDB, "Amazon DynamoDB", "Amazon DynamoDB", "NoSQL database for high-throughput catalog and search backing data.")
    ContainerDb(Amazon_ElastiCache_Redis_, "Amazon ElastiCache (Redis)", "Amazon ElastiCache (Redis)", "In-memory cache for user sessions and active shopping carts.")
    ContainerDb(Amazon_OpenSearch_Service, "Amazon OpenSearch Service", "Amazon OpenSearch Service", "Search engine for fast querying of books and reviews.")
    Container(Amazon_EventBridge__SQS__SNS, "Amazon EventBridge, SQS, SNS", "Amazon EventBridge, SQS, SNS", "Event bus and messaging queues for asynchronous inter-service communication.")
}

Rel(Customer, AWS_CloudFront_S3, "Accesses frontend SPA", "HTTPS")
Rel(Admin_Operations, AWS_CloudFront_S3, "Accesses administrative UI views", "HTTPS")
Rel(AWS_Route_53, AWS_CloudFront_S3, "Routes global traffic", "DNS")
Rel(React_Single_Page_Application_SPA_, Amazon_API_Gateway, "Sends API requests and queries", "HTTPS/REST and GraphQL")
Rel(Amazon_API_Gateway, Catalog_Service, "Routes catalog requests via service mesh", "gRPC over TLS via AWS App Mesh")
Rel(Amazon_API_Gateway, Order___Checkout_Service, "Routes order and checkout requests via service mesh", "gRPC over TLS via AWS App Mesh")
Rel(Amazon_API_Gateway, Recommendation_Service, "Routes recommendation requests via service mesh", "gRPC over TLS via AWS App Mesh")
Rel(Catalog_Service, Amazon_DynamoDB, "Reads and writes catalog data", "TLS, IAM roles, regional KMS CMKs")
Rel(Catalog_Service, Amazon_OpenSearch_Service, "Indexes catalog for searching", "TLS, IAM roles, regional KMS CMKs")
Rel(Order___Checkout_Service, Amazon_RDS_PostgreSQL_, "Persists transactional order data", "TLS, IAM roles, regional KMS CMKs")
Rel(Order___Checkout_Service, Amazon_ElastiCache_Redis_, "Manages sessions and active shopping carts", "TLS, IAM roles")
Rel(Catalog_Service, Amazon_EventBridge__SQS__SNS, "Publishes and consumes domain events", "JSON over HTTPS")
Rel(Order___Checkout_Service, Amazon_EventBridge__SQS__SNS, "Publishes order and checkout events", "JSON over HTTPS")
Rel(Recommendation_Service, Amazon_EventBridge__SQS__SNS, "Consumes events for recommendation updates", "JSON over HTTPS")
Rel(Catalog_Service, AWS_Secrets_Manager_KMS, "Fetches secrets and decrypts data", "HTTPS / AWS API")
Rel(Order___Checkout_Service, AWS_Secrets_Manager_KMS, "Fetches secrets and decrypts data", "HTTPS / AWS API")
Rel(Recommendation_Service, AWS_Secrets_Manager_KMS, "Fetches secrets and decrypts data", "HTTPS / AWS API")

@enduml