@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore System

Person(Customer, "Customer", "End-user browsing, purchasing, and reviewing books.")
Person(Administrator, "Administrator", "Manages catalogue, orders, and content moderation.")

System_Ext(Payment_Gateway, "Payment Gateway", "Stripe/PayPal for secure checkout and multi-currency support.")
System_Ext(Shipping_Provider, "Shipping Provider", "FedEx/UPS APIs for fulfillment and tracking.")
System_Ext(Email_Notification_Service, "Email/Notification Service", "SendGrid/AWS SES for transactional emails.")
System_Ext(Identity_Provider, "Identity Provider", "AWS Cognito for OIDC/OAuth 2.0 authentication.")

System_Boundary(Online_Bookstore_System, "Online Bookstore System") {
    Container(Single_Page_Application, "Single Page Application", "React/TypeScript, AWS S3, AWS CloudFront", "Frontend client application providing user interface for shopping and browsing.")
    Container(Amazon_Route_53, "Amazon Route 53", "AWS Route 53", "Latency-based global traffic management and DNS.")
    Container(AWS_API_Gateway, "AWS API Gateway", "AWS API Gateway", "API management and entry point for backend services.")
    Container(Catalog_Service, "Catalog Service", "Node.js, Amazon ECS Fargate", "Manages book catalog metadata.")
    Container(Order_Checkout_Service, "Order & Checkout Service", "Spring Boot, Amazon ECS Fargate", "Handles checkout workflows, orders, and multi-currency transactions.")
    Container(Recommendation_Service, "Recommendation Service", "Python/FastAPI, Amazon ECS Fargate", "Provides personalized book recommendations.")
    ContainerDb(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Relational database for ACID compliance and transactional data.")
    ContainerDb(Amazon_DocumentDB, "Amazon DocumentDB", "Amazon DocumentDB", "NoSQL database for flexible catalog metadata.")
    ContainerDb(Amazon_ElastiCache, "Amazon ElastiCache", "Amazon ElastiCache (Redis)", "Low-latency cache for fast recommendations.")
    Container(AWS_EventBridge_SQS, "AWS EventBridge / SQS", "AWS EventBridge, Amazon SQS", "Handles asynchronous event-driven messaging across services.")
    Container(AWS_Secrets_Manager_and_KMS, "AWS Secrets Manager and KMS", "AWS Secrets Manager, AWS KMS", "Manages secrets, tokens, and AES-256 encryption.")
}

Rel(Customer, Single_Page_Application, "Browses catalog, shops, and interacts with the store", "HTTPS/TLS 1.3 via AWS CloudFront")
Rel(Administrator, Single_Page_Application, "Administers catalog, orders, and moderation", "HTTPS/TLS 1.3 via AWS CloudFront")
Rel(Single_Page_Application, AWS_API_Gateway, "Sends REST and GraphQL requests", "HTTPS/JSON REST/GraphQL")
Rel(AWS_API_Gateway, Catalog_Service, "Routes catalog requests", "gRPC over mTLS (AWS ECS Service Connect)")
Rel(AWS_API_Gateway, Order_Checkout_Service, "Routes order and checkout requests", "gRPC over mTLS (AWS ECS Service Connect)")
Rel(AWS_API_Gateway, Recommendation_Service, "Routes recommendation requests", "gRPC over mTLS (AWS ECS Service Connect)")
Rel(Catalog_Service, Amazon_DocumentDB, "Reads and writes catalog metadata", "TCP/TLS")
Rel(Order_Checkout_Service, Amazon_Aurora_PostgreSQL, "Persists order and transaction data", "TCP/TLS")
Rel(Order_Checkout_Service, Payment_Gateway, "Executes tokenized payments", "HTTPS APIs")
Rel(Order_Checkout_Service, Shipping_Provider, "Manages fulfillment and tracking", "HTTPS APIs")
Rel(Recommendation_Service, Amazon_ElastiCache, "Fetches recommendation cache data", "TCP/TLS")
Rel(Catalog_Service, AWS_EventBridge_SQS, "Publishes asynchronous events", "HTTPS")
Rel(Order_Checkout_Service, AWS_EventBridge_SQS, "Publishes asynchronous events", "HTTPS")
Rel(Recommendation_Service, AWS_EventBridge_SQS, "Publishes asynchronous events", "HTTPS")

@enduml