@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon Aurora PostgreSQL container

Component(OrderCheckoutService, "Order & Checkout Service", "ECS Fargate Task", "Proxies transactional queries via TCP/TLS 1.3.")
Component(CatalogService, "Catalog Service", "ECS Fargate Task", "Proxies read queries to the replica via TCP/TLS 1.3.")

Container_Boundary(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL") {
    Component(AmazonRDSProxy, "Amazon RDS Proxy", "Amazon RDS Proxy", "Prevents connection spikes, routes pooled connections, and ensures sub-30-second failovers.")
    Component(DatabaseEngine, "Database Engine", "PostgreSQL 15+", "Provides relational core for ACID compliance and transactional data, utilizing PL/pgSQL extensions (pg_trgm, uuid-ossp) for fuzzy text searching and native UUID generation.")
    Component(AuroraStorageVolume, "Aurora Storage Volume", "AWS proprietary low-latency storage fabric", "Replicates and persists blocks securely with AWS KMS encryption.")
    Component(AuroraReadReplica, "Aurora Read Replica", "PostgreSQL 15+ Read Replica", "Handles read-heavy workloads and scales read capacity.")
}

Rel(OrderCheckoutService, AmazonRDSProxy, "Proxies transactional queries", "TCP/TLS 1.3")
Rel(CatalogService, AmazonRDSProxy, "Proxies read queries to replica", "TCP/TLS 1.3")
Rel(AmazonRDSProxy, DatabaseEngine, "Routes pooled connections", "TCP/TLS 1.3")
Rel(DatabaseEngine, AuroraStorageVolume, "Replicates and persists blocks", "AWS proprietary low-latency storage fabric")

@enduml