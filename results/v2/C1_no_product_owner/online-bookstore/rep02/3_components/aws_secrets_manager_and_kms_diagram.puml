@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_secrets_manager_and_kms, "AWS Secrets Manager and KMS") {
    Component(Secrets Engine Component, "Secrets Engine Component", "AWS Secrets Manager", "Manages dynamic database credentials and third-party API keys with automatic rotation.")
    Component(Key Management Component, "Key Management Component", "AWS Key Management Service (KMS)", "Secures Customer Master Keys (CMKs) with FIPS 140-2 Level 3 hardware security modules.")
    Component(Secrets Caching Wrapper, "Secrets Caching Wrapper", "AWS Secrets Manager Caching Library", "Provides local in-memory credential caching embedded in ECS Fargate services to prevent API throttling.")
    Component(KMS Crypto Client, "KMS Crypto Client", "AWS Encryption SDK", "Handles client-side envelope encryption and local data key caching.")
}

Component(Order & Checkout Service, "Order & Checkout Service", "Amazon ECS Fargate", "Handles order processing and secure checkout operations.")
Component(Catalog Service, "Catalog Service", "Amazon ECS Fargate", "Manages the product catalog operations.")

Rel(Order & Checkout Service, Secrets Engine Component, "Invokes via AWS SDK (HTTPS) through the Secrets Caching Wrapper", "HTTPS")
Rel(Catalog Service, Secrets Engine Component, "Invokes via AWS SDK (HTTPS) through the Secrets Caching Wrapper", "HTTPS")
Rel(Order & Checkout Service, Key Management Component, "Invokes via AWS SDK (HTTPS) using the KMS Crypto Client", "HTTPS")
Rel(Catalog Service, Key Management Component, "Invokes via AWS SDK (HTTPS) using the KMS Crypto Client", "HTTPS")
Rel(Secrets Engine Component, Secrets Engine Component, "Performs automatic secret rotation via AWS Lambda over HTTPS/TLS 1.3", "HTTPS/TLS 1.3")

@enduml