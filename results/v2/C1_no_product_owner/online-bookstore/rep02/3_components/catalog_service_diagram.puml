@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog Service container

Container_Boundary(catalog_service, "Catalog Service") {
    Component(CatalogAPIController, "Catalog API Controller", "Node.js/Express", "Handles incoming gRPC requests, schema validation, and JWT-based role authorization.")
    Component(SearchBrowseEngine, "Search & Browse Engine", "Node.js & Amazon OpenSearch", "Manages complex keyword searching, filtering, and query sanitization.")
    Component(CatalogDataRepository, "Catalog Data Repository", "Node.js ODM/Mongoose", "Manages book metadata CRUD operations against Amazon DocumentDB.")
    Component(CatalogSyncWorker, "Catalog Sync Worker", "Node.js background process", "Consumes asynchronous update events via Amazon SQS to synchronize search indices.")
}

Component_Ext(AWSAPIGateway, "AWS API Gateway", "AWS Gateway", "Routes catalog requests.")
Component_Ext(AmazonDocumentDB, "Amazon DocumentDB", "AWS NoSQL Database", "Persists catalog data.")
Component_Ext(AmazonSQS, "Amazon SQS", "AWS Messaging", "Publishes and holds domain events.")
Component_Ext(AmazonOpenSearchService, "Amazon OpenSearch Service", "AWS Search Engine", "Updates search indices for sub-2-second page load performance.")

Rel(AWSAPIGateway, CatalogAPIController, "Routes catalog requests", "gRPC over mTLS")
Rel(CatalogAPIController, CatalogDataRepository, "Executes metadata operations", "In-memory function calls")
Rel(CatalogDataRepository, AmazonDocumentDB, "Persists catalog data", "TCP/TLS")
Rel(CatalogDataRepository, AmazonSQS, "Publishes CatalogItemUpdated domain events", "HTTPS")
Rel(CatalogSyncWorker, AmazonSQS, "Polls and consumes update messages", "HTTPS")
Rel(CatalogSyncWorker, AmazonOpenSearchService, "Updates search indices", "HTTPS with AWS SigV4")

@enduml