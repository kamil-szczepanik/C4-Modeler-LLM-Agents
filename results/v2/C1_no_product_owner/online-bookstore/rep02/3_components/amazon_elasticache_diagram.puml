@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_elasticache, "Amazon ElastiCache") {
    Component(CacheRouterClusterManager, "Cache Router / Cluster Manager", "Redis Cluster-Mode Enabled", "Manages slot allocation and routes queries.")
    Component(InMemoryDatastore, "In-Memory Datastore", "Redis In-Memory Datastore", "Stores in-memory recommendation cache data for sub-millisecond retrieval.")
    Component(PersistenceReplicationEngine, "Persistence & Replication Engine", "AWS Multi-AZ Replication & Snapshot Engine", "Backs up data asynchronously via RDB/AOF snapshots and handles replication.")
}

Rel(CacheRouterClusterManager, InMemoryDatastore, "Manages slot allocation and routes queries", "Internal Redis Protocol")
Rel(InMemoryDatastore, PersistenceReplicationEngine, "Backs up data asynchronously via RDB/AOF snapshots", "Internal AWS Network")

@enduml