@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Order & Checkout Service container

Component(AWS_API_Gateway, "AWS API Gateway", "AWS", "Routes order requests via gRPC over mTLS and ECS Service Connect, validating inbound JWTs.")

Container_Boundary(Order_Checkout_Service, "Order & Checkout Service") {
    Component(Checkout_Orchestrator_Component, "Checkout Orchestrator Component", "Spring @Service", "Manages multi-step checkout workflows and distributed transaction sagas.")
    Component(Payment_Integration_Component, "Payment Integration Component", "Java / Spring", "Handles tokenized payment interactions with the external Payment Gateway.")
    Component(Fulfillment_Client_Component, "Fulfillment Client Component", "Java / Spring", "Integrates with third-party Shipping Provider APIs for label generation and tracking.")
    Component(Order_Repository_Component, "Order Repository Component", "Spring Data JPA", "Interfaces with data persistence using Spring Data JPA.")
    Component(Event_Publisher_Component, "Event Publisher Component", "Spring Cloud Stream and AWS SDK", "Dispatches asynchronous domain events.")
}

Component(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Relational database for ACID-compliant order data persistence.")
Component(AWS_EventBridge_SQS, "AWS EventBridge / SQS", "AWS", "Receives asynchronous domain events via HTTPS.")

Rel(AWS_API_Gateway, Checkout_Orchestrator_Component, "Routes order requests via gRPC over mTLS and ECS Service Connect, validating inbound JWTs.", "gRPC / mTLS")
Rel(Checkout_Orchestrator_Component, Payment_Integration_Component, "Invokes payment processing synchronously via direct Java method calls.", "Java Method Call")
Rel(Checkout_Orchestrator_Component, Fulfillment_Client_Component, "Invokes fulfillment operations synchronously via direct Java method calls.", "Java Method Call")
Rel(Order_Repository_Component, Amazon_Aurora_PostgreSQL, "Persists order and transaction data using TCP/TLS.", "TCP/TLS")
Rel(Event_Publisher_Component, AWS_EventBridge_SQS, "Publishes asynchronous domain events via HTTPS.", "HTTPS")

@enduml