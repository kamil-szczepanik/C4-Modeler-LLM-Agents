@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "External user resolving DNS.")
System_Ext(AWS_API_Gateway, "AWS API Gateway", "External API Gateway receiving directed traffic.")

Container_Boundary(Amazon_Route_53, "Amazon Route 53") {
    Component(DNS_Resolver_Engine, "DNS Resolver Engine", "Anycast DNS Infrastructure", "Resolves bookstore.com via HTTPS/UDP 53, providing low-latency routing.")
    Component(Traffic_Flow_Engine, "Traffic Flow Engine", "AWS Route 53 Traffic Flow", "Directs validated client traffic using HTTPS across us-east-1, eu-west-1, and ap-southeast-1.")
    Component(Health_Checking_Probe_Fleet, "Health Checking Probe Fleet", "Route 53 Health Checkers", "Performs multi-region health checks to ensure high availability and sub-second performance.")
    Component(Hosted_Zone_Management_Component, "Hosted Zone Management Component", "Route 53 Public Hosted Zone", "Supplies authoritative DNS records and routing policies.")
    Component(Change_Batch_Synchronization_Auditor, "Change Batch Synchronization Auditor", "AWS Config and Amazon EventBridge", "Provides automated drift detection and remediation.")
}

Rel(Customer, DNS_Resolver_Engine, "Resolves bookstore.com via HTTPS/UDP 53", "HTTPS/UDP 53")
Rel(Hosted_Zone_Management_Component, Traffic_Flow_Engine, "Supplies authoritative DNS records and routing policies", "")
Rel(Traffic_Flow_Engine, AWS_API_Gateway, "Directs validated client traffic using HTTPS across us-east-1, eu-west-1, and ap-southeast-1", "HTTPS")
@enduml