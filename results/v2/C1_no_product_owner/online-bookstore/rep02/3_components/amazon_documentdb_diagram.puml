@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon DocumentDB container

System_Ext(CatalogService, "Catalog Service", "Microservice connecting to the database.")
System_Ext(AWSKMS, "AWS KMS", "Provides customer-managed keys for encryption.")
System_Ext(AmazonCloudWatchLogs, "Amazon CloudWatch Logs", "Streams advanced audit logs and tracks metrics.")

Container_Boundary(AmazonDocumentDB, "Amazon DocumentDB") {
    Component(QueryRouterProtocolEngine, "Query Router & Protocol Engine", "TCP/TLS", "Handles incoming MongoDB wire protocol requests over TCP/TLS.")
    Component(StorageSubsystem, "Storage Subsystem", "Distributed SSD Storage", "Manages distributed SSD storage volumes across 3 Availability Zones.")
    Component(ReplicationManager, "Replication Manager", "AWS Multi-AZ Replication", "Synchronizes writes across primary and up to 15 replica instances.")
    Component(TransactionIndexManager, "Transaction & Index Manager", "B-tree Indexing / ACID Engine", "Handles document-level ACID transactions and maintains B-tree indexing.")
}

Rel(CatalogService, QueryRouterProtocolEngine, "Sends MongoDB wire protocol requests", "TCP/TLS")
Rel(AmazonDocumentDB, AWSKMS, "Uses customer-managed keys for storage-at-rest encryption", "")
Rel(AmazonDocumentDB, AmazonCloudWatchLogs, "Streams advanced audit logs", "")

@enduml