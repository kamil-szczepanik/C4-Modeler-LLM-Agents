@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(SinglePageApplication, "Single Page Application", "Client application")
System_Ext(CatalogService, "Catalog Service", "Backend microservice")
System_Ext(OrderCheckoutService, "Order & Checkout Services", "Backend microservices")
System_Ext(RecommendationService, "Recommendation Service", "Backend microservice")

Container_Boundary(AWSAPIGateway, "AWS API Gateway") {
    Component(AWSWAF, "AWS WAF", "AWS WAF", "Inspects incoming requests for OWASP Top-10 mitigations and provides edge security.")
    Component(JWTAuthorizerComponent, "JWT Authorizer Component", "Custom Lambda / Native JWT Authorizer", "Handles client authentication and token validation.")
    Component(RateLimiterThrottlingModule, "Rate Limiter & Throttling Module", "API Gateway Native Throttling", "Manages traffic management and rate limiting for clients.")
    Component(APIRouterTransformEngine, "API Router & Transform Engine", "AWS API Gateway Mapping Templates / Integration Request", "Handles client routing and transforms payloads before dispatching to backend microservices.")
    Component(EdgeObservabilityTracingAgent, "Edge Observability & Tracing Agent", "AWS X-Ray / OpenTelemetry", "Traces requests and provides edge observability.")
}

Rel(SinglePageApplication, AWSAPIGateway, "Sends HTTPS/JSON REST and GraphQL requests", "HTTPS/JSON REST/GraphQL")
Rel(AWSAPIGateway, AWSWAF, "Inspects incoming requests for OWASP Top-10 mitigations", "In-line Shield")
Rel(AWSAPIGateway, CatalogService, "Dispatches transformed payloads", "gRPC over mTLS via AWS ECS Service Connect")
Rel(AWSAPIGateway, OrderCheckoutService, "Dispatches transformed payloads", "gRPC over mTLS via AWS ECS Service Connect")
Rel(AWSAPIGateway, RecommendationService, "Dispatches transformed payloads", "gRPC over mTLS via AWS ECS Service Connect")

@enduml