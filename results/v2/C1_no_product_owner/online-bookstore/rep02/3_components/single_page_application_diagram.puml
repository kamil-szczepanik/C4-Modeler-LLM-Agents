@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(spa_boundary, "Single Page Application") {
    Component(React_Router_Redux_Toolkit, "React Router & Redux Toolkit", "React Router & Redux Toolkit", "Client-side navigation and global state management.")
    Component(Catalog_Search_Module, "Catalog & Search Module", "React & TypeScript", "Component views for browsing and keyword search.")
    Component(Checkout_Cart_Module, "Checkout & Cart Module", "React & TypeScript", "Secure checkout workflows and cart state management.")
    Component(Recommendations_Reviews_Module, "Recommendations & Reviews Module", "React & TypeScript", "UI widgets for 5-star ratings and recommendations.")
    Component(API_Client_Layer, "API Client Layer", "Axios & Apollo Client", "Axios and Apollo Client for REST and GraphQL requests.")
    Component(ErrorBoundary_Telemetry_Component, "ErrorBoundary & Telemetry Component", "React & TypeScript", "Graceful failure handling and performance monitoring.")
    Component(AWS_CloudFront_Amazon_S3, "AWS CloudFront & Amazon S3", "AWS CloudFront & Amazon S3", "Global content delivery and static hosting.")
    Component(AWS_WAF_CMP_Framework, "AWS WAF & CMP Framework", "AWS WAF & CMP Framework", "Edge security and GDPR/CCPA consent management.")
}

System_Ext(AWS_API_Gateway, "AWS API Gateway", "API Gateway for backend services")

Rel(Catalog_Search_Module, API_Client_Layer, "Sends requests", "HTTPS/JSON")
Rel(Checkout_Cart_Module, API_Client_Layer, "Sends requests", "HTTPS/JSON")
Rel(Recommendations_Reviews_Module, API_Client_Layer, "Sends requests", "HTTPS/JSON")
Rel(API_Client_Layer, AWS_API_Gateway, "Sends REST and GraphQL requests", "HTTPS/JSON")
Rel(AWS_CloudFront_Amazon_S3, React_Router_Redux_Toolkit, "Delivers static immutable assets", "Internal AWS Network")

@enduml