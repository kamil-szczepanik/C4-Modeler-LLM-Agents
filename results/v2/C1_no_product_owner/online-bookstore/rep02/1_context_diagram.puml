@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "End-user browsing, purchasing, and reviewing books.")
Person(Administrator, "Administrator", "Manages catalogue, orders, and content moderation.")
System(Online_Bookstore_System, "Online Bookstore System", "A scaled-down Amazon-style e-commerce platform for purchasing books, providing personalized recommendations, and managing customer reviews globally.")
System_Ext(Payment_Gateway, "Payment Gateway", "Stripe/PayPal for secure checkout and multi-currency support.")
System_Ext(Shipping_Provider, "Shipping Provider", "FedEx/UPS APIs for fulfillment and tracking.")
System_Ext(Email_Notification_Service, "Email/Notification Service", "SendGrid/AWS SES for transactional emails.")
System_Ext(Identity_Provider, "Identity Provider", "AWS Cognito for OIDC/OAuth 2.0 authentication.")

Rel(Customer, Online_Bookstore_System, "Interacts for browsing, purchasing, and reviewing books", "HTTPS (TLS 1.3) through AWS CloudFront/WAF edge")
Rel(Administrator, Online_Bookstore_System, "Manages catalogue, orders, and content moderation", "HTTPS (TLS 1.3) through AWS CloudFront/WAF edge")
Rel(Online_Bookstore_System, Identity_Provider, "Authenticates users and sessions", "OIDC/HTTPS")
Rel(Online_Bookstore_System, Payment_Gateway, "Executes tokenized payments", "HTTPS/REST")
Rel(Online_Bookstore_System, Shipping_Provider, "Manages fulfillment and tracking", "HTTPS/REST")
Rel(Online_Bookstore_System, Email_Notification_Service, "Sends transactional emails", "HTTPS/API")

@enduml