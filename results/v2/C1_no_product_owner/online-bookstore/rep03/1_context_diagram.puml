@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "End user who browses, purchases, and reviews physical and electronic books.")
Person(Admin_Support_Staff, "Admin / Support Staff", "Personnel responsible for managing bookstore operations, content, and customer support.")

System(Online_Bookstore_System, "Online Bookstore System", "An Amazon-style e-commerce online bookstore for physical and electronic books with reviews, recommendations, and multi-currency support, designed for high availability and global scalability.")

System_Ext(Payment_Gateway, "Payment Gateway", "External payment processor (Stripe) for handling transactions.")
System_Ext(Shipping_Provider_APIs, "Shipping Provider APIs", "External shipping services (FedEx, DHL) for order fulfillment and tracking.")
System_Ext(Tax_Compliance_Service, "Tax & Compliance Service", "External service (Avalara) for tax calculation and compliance.")
System_Ext(Identity_Access_Management, "Identity & Access Management", "External identity provider (Auth0 / AWS Cognito) for authentication and authorization.")
System_Ext(Notification_Service, "Notification Service", "External communication service (SendGrid / AWS SES) for sending notifications and emails.")

Rel(Customer, Online_Bookstore_System, "Browses books, manages account, and makes purchases", "HTTPS / TLS 1.3")
Rel(Admin_Support_Staff, Online_Bookstore_System, "Manages bookstore operations and support", "HTTPS / TLS 1.3")
Rel(Online_Bookstore_System, Payment_Gateway, "Processes customer payments", "TLS/REST")
Rel(Online_Bookstore_System, Shipping_Provider_APIs, "Coordinates order shipping and tracking", "TLS/REST")
Rel(Online_Bookstore_System, Tax_Compliance_Service, "Calculates taxes and verifies compliance", "HTTPS/REST")
Rel(Online_Bookstore_System, Identity_Access_Management, "Authenticates users and manages sessions", "OIDC/OAuth2 over TLS 1.3")
Rel(Online_Bookstore_System, Notification_Service, "Sends transactional emails and notifications", "TLS/SMTP")

@enduml