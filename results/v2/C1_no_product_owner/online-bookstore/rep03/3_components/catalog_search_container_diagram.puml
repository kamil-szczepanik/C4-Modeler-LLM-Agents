@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog & Search Container container

System_Ext(amazon_opensearch_service, "Amazon OpenSearch Service", "High-performance, full-text keyword and faceted search.")
System_Ext(amazon_aurora_postgresql, "Amazon Aurora PostgreSQL", "Reliable relational storage and read replicas for product metadata.")

Container_Boundary(catalog_search_container, "Catalog & Search Container") {
    Component(Search_Controller, "Search Controller", "Spring MVC Controller", "Handles search requests and routes them to internal services.")
    Component(Search_Service, "Search Service", "Spring Boot Service", "Performs keyword and faceted searches utilizing Amazon OpenSearch Service.")
    Component(Product_Query_Service, "Product Query Service", "Spring Boot Service", "Retrieves product metadata from read replicas in Amazon Aurora PostgreSQL.")
    Component(Search_Index_Client, "Search Index Client", "Java HTTP Client", "Client used to interact with search indexing endpoints.")
    Component(Catalog_Synchronization_Worker, "Catalog Synchronization Worker", "Spring Batch", "Keeps search indexes eventually consistent between Aurora PostgreSQL and OpenSearch.")
}

Rel(Search_Controller, Search_Service, "In-memory Java Method Calls", "Java Method Calls")
Rel(Search_Controller, Product_Query_Service, "In-memory Java Method Calls", "Java Method Calls")
Rel(Search_Service, amazon_opensearch_service, "Keyword and faceted searches", "HTTPS")
Rel(Product_Query_Service, amazon_aurora_postgresql, "Retrieves product metadata from read replicas", "JDBC/TLS")
Rel(Catalog_Synchronization_Worker, amazon_aurora_postgresql, "Reads product data for synchronization", "JDBC")
Rel(Catalog_Synchronization_Worker, amazon_opensearch_service, "Updates search indexes", "HTTPS")

@enduml