@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification Service Container container

Container_Boundary(notification_service_container, "Notification Service Container") {
    Component(Event_Consumer_Component, "Event Consumer Component", "Go, AWS SDK for Go", "Consumes asynchronous events from Amazon SQS and Amazon EventBridge.")
    Component(Notification_Dispatcher_Component, "Notification Dispatcher Component", "Go", "Orchestrates the dispatching of multi-channel notifications.")
    Component(Template_Engine_Component, "Template Engine Component", "Go, text/template", "Renders notification content using predefined templates.")
    Component(Third_Party_Provider_Adapter_Component, "Third-Party Provider Adapter Component", "Go, HTTP Client", "Adapts and sends final messages to external APIs.")
    Component(DLQ_Handler_Component, "DLQ Handler Component", "Go", "Handles poison-pill messages and forwards them to the dead-letter queue.")
    Component(Secrets_Manager_Client_Component, "Secrets Manager Client Component", "Go, AWS SDK for Go", "Retrieves API credentials and secrets securely.")
}

System_Ext(SendGrid_Twilio_APIs, "SendGrid & Twilio APIs", "External notification providers")

Rel(Event_Consumer_Component, Notification_Dispatcher_Component, "Forwards raw event payloads", "In-memory function call")
Rel(Event_Consumer_Component, DLQ_Handler_Component, "Forwards poison-pill messages", "In-memory function call")
Rel(Notification_Dispatcher_Component, Template_Engine_Component, "Requests rendered content", "In-memory function call")
Rel(Notification_Dispatcher_Component, Third_Party_Provider_Adapter_Component, "Dispatches final messages", "REST over HTTPS")
Rel(Third_Party_Provider_Adapter_Component, Secrets_Manager_Client_Component, "Retrieves API credentials", "In-memory cache lookup")
Rel(Third_Party_Provider_Adapter_Component, SendGrid_Twilio_APIs, "Sends notifications", "REST over HTTPS with mTLS")

@enduml