@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Order & Checkout Container container

Container_Boundary(order_checkout_container, "Order & Checkout Container") {
    Component(Cart_Management_Component, "Cart Management Component", "Node.js, Express, Amazon DynamoDB", "Manages shopping carts and session carts using a single-table design.")
    Component(Checkout_Orchestrator_Component, "Checkout Orchestrator Component", "Node.js, Express, Amazon DynamoDB", "Orchestrates transaction workflows and ensures idempotency.")
    Component(Order_Processing_Component, "Order Processing Component", "Node.js, Express, Amazon Aurora PostgreSQL", "Handles ACID-compliant transactional persistence for financial order records.")
    Component(Shipping_Integrator_Component, "Shipping Integrator Component", "Node.js, Express", "Fetches rates and generates labels from external shipping provider APIs.")
}

System_Ext(Amazon_EventBridge, "Amazon EventBridge", "Event bus for publishing system events.")
System_Ext(Shipping_Provider_APIs, "Shipping Provider APIs", "External shipping provider services.")

Rel(Cart_Management_Component, Checkout_Orchestrator_Component, "Validates JWT tokens and enforces Object-Level Authorization", "HTTPS/REST")
Rel(Checkout_Orchestrator_Component, Order_Processing_Component, "Initiates order creation", "Internal Function Call / TypeScript Interface")
Rel(Order_Processing_Component, Amazon_EventBridge, "Publishes `OrderPlaced` events", "AWS SDK")
Rel(Shipping_Integrator_Component, Shipping_Provider_APIs, "Fetches rates and generates labels", "REST/JSON")

@enduml