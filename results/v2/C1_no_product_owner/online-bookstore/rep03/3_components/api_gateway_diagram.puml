@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(SPA, "SPA", "Single Page Application")
System_Ext(Catalog_Order_Recommendations_Containers, "Catalog, Order & Recommendations Containers", "Backend microservices containers")

Container_Boundary(api_gateway, "API Gateway") {
    Component(Schema_Protocol_Translation, "Schema & Protocol Translation", "Perimeter filter / JSON/GraphQL parser", "Perimeter filter validating incoming JSON/GraphQL payloads against strict schemas.")
    Component(Rate_Limiting_Throttling, "Rate Limiting & Throttling", "Token bucket limiter / Amazon ElastiCache (Redis)", "Token bucket limiter backed by Amazon ElastiCache (Redis) Global Datastores.")
    Component(Authentication_Authorization_Filter, "Authentication & Authorization Filter", "Edge validator / JWT / IAM", "Edge validator integrating with external Identity & Access Management via JWTs.")
    Component(Routing_Dispatcher, "Routing & Dispatcher", "gRPC / VPC Load Balancers / Envoy", "Traffic forwarder using gRPC and internal VPC load balancers.")
}

Rel(SPA, Schema_Protocol_Translation, "Sends ingress traffic", "HTTPS, TLS 1.3")
Rel(Schema_Protocol_Translation, Rate_Limiting_Throttling, "Passes validated payloads", "In-memory")
Rel(Rate_Limiting_Throttling, Authentication_Authorization_Filter, "Passes rate-checked requests", "In-memory")
Rel(Authentication_Authorization_Filter, Routing_Dispatcher, "Passes authorized requests", "In-memory")
Rel(Routing_Dispatcher, Catalog_Order_Recommendations_Containers, "Forwards optimized traffic", "gRPC/HTTP2, mTLS")

@enduml