@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(API_Gateway, "API Gateway", "External System")

Container_Boundary(SPA, "SPA") {
    Component(Router___Navigation_Component, "Router / Navigation Component", "React Router", "Manages application navigation and view routing.")
    Component(State_Management_Store, "State Management Store", "Zustand", "Manages ephemeral client state.")
    Component(API_Client_Service, "API Client Service", "Axios, TanStack Query, Zod", "Handles API requests, data caching, synchronization, and input validation.")
    Component(Feature_Views, "Feature Views", "React, TypeScript", "Provides user interfaces for Catalog, Cart, Reviews, and Recommendations.")
    Component(Design_System, "Design System", "Tailwind CSS", "Provides styling and UI components.")
    Component(Security_Monitoring_Component, "Security Monitoring Component", "React, TypeScript", "Monitors client-side security and compliance.")
}

Rel(Router___Navigation_Component, Feature_Views, "Renders active views")
Rel(Feature_Views, State_Management_Store, "Reads and writes ephemeral state")
Rel(Feature_Views, API_Client_Service, "Requests data and actions")
Rel(API_Client_Service, API_Gateway, "Sends API requests for data and actions", "HTTPS/WSS")

@enduml