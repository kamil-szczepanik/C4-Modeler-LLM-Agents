@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Recommendations Container container

System_Ext(API_Gateway, "API Gateway", "External API Gateway routing requests.")

Container_Boundary(Recommendations_Container, "Recommendations Container") {
    Component(Recommendation_API_Router, "Recommendation API Router", "FastAPI, Pydantic", "FastAPI component handling REST endpoints and Pydantic input validation.")
    Component(Cache_Manager, "Cache Manager", "Python", "Orchestrates cache-aside logic for high-performance data retrieval.")
    Component(Scoring_Engine, "Scoring Engine", "Python, NumPy", "Python and NumPy component executing co-purchase algorithms.")
    Component(Recommendation_Repository, "Recommendation Repository", "SQLAlchemy, psycopg3", "SQLAlchemy-based data access layer.")
    Component(Amazon_ElastiCache_Redis, "Amazon ElastiCache (Redis)", "Redis", "In-memory cache for hot co-purchase lists.")
    Component(Amazon_Aurora_PostgreSQL_Read_Replica, "Amazon Aurora PostgreSQL Read Replica", "PostgreSQL", "Dedicated database read-replica for offline-computed associations.")
    Component(Amazon_ECS_AWS_Fargate, "Amazon ECS (AWS Fargate)", "AWS Fargate", "Serverless container deployment platform with auto-scaling.")
}

Rel(API_Gateway, Recommendation_API_Router, "Routes recommendation requests", "gRPC/REST over VPC internal load balancers")
Rel(Recommendation_API_Router, Cache_Manager, "Delegates validated requests", "In-memory / TCP")
Rel(Cache_Manager, Amazon_ElastiCache_Redis, "Reads and writes cached recommendation payloads", "TCP")
Rel(Cache_Manager, Scoring_Engine, "Executes fallback scoring on cache misses", "In-process")
Rel(Cache_Manager, Recommendation_Repository, "Populates cache on misses", "SQL via psycopg3")
Rel(Recommendation_Repository, Amazon_Aurora_PostgreSQL_Read_Replica, "Fetches pre-aggregated associations", "TLS 1.3")

@enduml