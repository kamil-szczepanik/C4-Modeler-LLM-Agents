@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore System

Person(Customer, "Customer", "End user who browses, purchases, and reviews books.")
Person(Admin, "Admin / Support Staff", "Personnel responsible for managing bookstore operations and support.")

System_Ext(PaymentGateway, "Payment Gateway", "External payment processor for handling transactions.")
System_Ext(ShippingProvider, "Shipping Provider APIs", "External shipping services for order fulfillment and tracking.")
System_Ext(TaxService, "Tax & Compliance Service", "External service for tax calculation and compliance.")
System_Ext(IdentityService, "Identity & Access Management", "External identity provider for authentication and authorization.")

System_Boundary(OnlineBookstoreSystem, "Online Bookstore System") {
    Container(SPA, "SPA", "React, TypeScript, Amazon CloudFront, Amazon S3", "Frontend application for catalog browsing, checkout, recommendations, and reviews.")
    Container(ApiGateway, "API Gateway", "Amazon API Gateway REST/GraphQL", "Entry point for frontend and client requests into the backend services.")
    Container(CatalogService, "Catalog & Search Container", "Spring Boot, Amazon OpenSearch Service, Amazon Aurora PostgreSQL", "Handles catalog browsing, book searching, and querying product data.")
    Container(OrderService, "Order & Checkout Container", "Node.js, Express, Amazon DynamoDB", "Manages shopping carts, order placement, and checkout processes.")
    Container(RecommendationService, "Recommendations Container", "Python, FastAPI", "Provides personalized book recommendations to users.")
    Container(NotificationService, "Notification Service Container", "Go, Amazon SQS, Amazon EventBridge", "Worker service for consuming events and sending notifications.")
}

Rel(Customer, SPA, "Browses bookstore, manages account, and makes purchases", "HTTPS / TLS 1.3")
Rel(Admin, SPA, "Manages bookstore operations and support", "HTTPS / TLS 1.3")
Rel(SPA, ApiGateway, "Sends API requests for data and actions", "HTTPS/WSS")
Rel(ApiGateway, CatalogService, "Routes catalog and search requests", "gRPC/REST over VPC internal load balancers")
Rel(ApiGateway, OrderService, "Routes order and checkout requests", "gRPC/REST over VPC internal load balancers")
Rel(ApiGateway, RecommendationService, "Routes recommendation requests", "gRPC/REST over VPC internal load balancers")
Rel(OrderService, NotificationService, "Publishes order events asynchronously", "HTTPS")
Rel(NotificationService, NotificationService, "Consumes asynchronous events for notifications", "Asynchronous event consumption")
Rel(CatalogService, CatalogService, "Queries product data from read replicas", "JDBC/TLS")

Rel(OnlineBookstoreSystem, PaymentGateway, "Processes customer payments", "TLS/REST")
Rel(OnlineBookstoreSystem, ShippingProvider, "Coordinates order shipping and tracking", "TLS/REST")
Rel(OnlineBookstoreSystem, TaxService, "Calculates taxes and verifies compliance", "HTTPS/REST")
Rel(OnlineBookstoreSystem, IdentityService, "Authenticates users and manages sessions", "OIDC/OAuth2 over TLS 1.3")

@enduml