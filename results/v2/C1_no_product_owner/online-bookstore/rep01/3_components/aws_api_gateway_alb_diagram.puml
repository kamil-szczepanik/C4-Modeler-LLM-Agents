@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_api_gateway_alb, "AWS API Gateway & ALB") {
    Component(Edge_Router_WAF, "Edge Router & WAF", "AWS WAF & Application Load Balancer", "Handles edge security, traffic sanitization, and OWASP protections.")
    Component(API_Management_Routing, "API Management & Routing", "Amazon API Gateway", "Manages API routing and forwards sanitized traffic.")
    Component(Request_Transformation_Caching, "Request Transformation & Caching", "AWS Lambda / API Gateway Caching", "Validates schemas and checks cache for API requests.")
    Component(Service_Mesh_Proxy, "Service Mesh Proxy", "AWS App Mesh (Envoy)", "Forwards backend calls securely using gRPC over mTLS.")
}

Rel(Edge_Router_WAF, API_Management_Routing, "Forwards sanitized traffic", "HTTPS")
Rel(API_Management_Routing, Request_Transformation_Caching, "Validates schemas and checks cache", "Internal API")
Rel(Request_Transformation_Caching, Service_Mesh_Proxy, "Forwards backend calls", "gRPC over mTLS")

@enduml