@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_elasticache, "Amazon ElastiCache") {
    Component(Cache_Router___Cluster_Manager, "Cache Router / Cluster Manager", "Redis Cluster", "Routes data across multi-AZ topology and manages Redis Shards.")
    Component(In_Memory_Recommendation_Store, "In-Memory Recommendation Store", "Redis Hash & Sorted Set", "Stores pre-computed collaborative filtering data and low-latency product recommendations.")
    Component(Session___Token_Cache, "Session & Token Cache", "Redis String / Key-Value Store", "Manages transient shopping cart states, user sessions, and checkout locks.")
}

Rel(Cache_Router___Cluster_Manager, In_Memory_Recommendation_Store, "Routes data across multi-AZ topology", "Redis Protocol")
Rel(Cache_Router___Cluster_Manager, Session___Token_Cache, "Routes data across multi-AZ topology", "Redis Protocol")
@enduml