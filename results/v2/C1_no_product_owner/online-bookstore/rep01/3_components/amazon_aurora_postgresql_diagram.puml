@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon Aurora PostgreSQL container

System_Ext(catalog_service, "Catalog Service", "Microservice")
System_Ext(order_service, "Order & Checkout Service", "Microservice")

Container_Boundary(aurora_postgresql, "Amazon Aurora PostgreSQL") {
    Component(rds_proxy, "AWS RDS Proxy", "AWS RDS Proxy", "Connection pooling proxy managing database traffic from microservices.")
    Component(writer, "Database Engine Instance - Writer", "PostgreSQL 15+", "PostgreSQL instance handling transactional writes.")
    Component(reader, "Database Engine Instance - Reader", "PostgreSQL 15+", "PostgreSQL instance handling read-only queries.")
    Component(storage, "Distributed Storage Volume", "Amazon Aurora Storage", "Replicates 6 copies across 3 Availability Zones.")
    Component(secrets_manager, "AWS Secrets Manager", "AWS Secrets Manager", "Secret management system for credential handling.")
    Component(cloudwatch, "Amazon CloudWatch", "Amazon CloudWatch", "Monitoring tool for performance metrics and auto-scaling alarms.")
}

Rel(catalog_service, rds_proxy, "Sends read-only catalog queries", "PostgreSQL Protocol over TCP/5432")
Rel(order_service, rds_proxy, "Sends ACID transaction queries", "PostgreSQL Protocol over TCP/5432")
Rel(rds_proxy, writer, "Multiplexes pooled connections", "PostgreSQL Protocol over TCP/5432")
Rel(rds_proxy, reader, "Multiplexes pooled connections", "PostgreSQL Protocol over TCP/5432")
Rel(writer, storage, "Performs block-level log replication", "AWS Proprietary Protocol")

@enduml