@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog Service container

Container_Boundary(catalog_service, "Catalog Service") {
    Component(API_Controller, "API Controller", "Go, net/http", "Validates inputs and routes gRPC/mTLS requests")
    Component(Catalog_Manager, "Catalog Manager", "Go", "Handles core business logic for book metadata and inventory")
    Component(Search_Indexer_Query_Engine, "Search Indexer / Query Engine", "Go", "Optimizes keyword search and indexing")
    Component(Cache_Manager_Component, "Cache Manager Component", "Go", "Manages hot book details and search caching")
    Component(Data_Access_Repository, "Data Access Repository", "Go, pgx", "Executes persistence operations via pgx driver")
}

ComponentDb(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Relational Database", "Stores persistent catalog data")
ComponentDb(Amazon_ElastiCache_Redis, "Amazon ElastiCache (Redis)", "In-memory Data Store", "Caches catalog data and search results globally")

Rel(API_Controller, Cache_Manager_Component, "Checks read-through cache", "In-memory")
Rel(Cache_Manager_Component, Data_Access_Repository, "Fallback on cache miss", "In-memory")
Rel(Catalog_Manager, Search_Indexer_Query_Engine, "Queries search indexes", "In-memory")
Rel(Data_Access_Repository, Amazon_Aurora_PostgreSQL, "SQL queries", "PostgreSQL Protocol, TLS 1.3")
Rel(catalog_service, Amazon_ElastiCache_Redis, "Reads/writes cached data", "Redis Protocol, TLS")

@enduml