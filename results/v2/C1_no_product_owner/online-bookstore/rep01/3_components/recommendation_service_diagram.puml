@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Recommendation Service container

Container_Boundary(recommendation_service, "Recommendation Service") {
    Component(api_router, "API Router", "FastAPI", "Component handling incoming gRPC/HTTP routing.")
    Component(model_loader, "Model Loader", "AWS SDK", "Component fetching artifacts from AWS S3 using AWS SDK.")
    Component(recommendation_engine, "Recommendation Engine", "NumPy, Pandas", "Core logic for collaborative filtering using NumPy and Pandas.")
    Component(cache_persistence_repository, "Cache & Persistence Repository", "Amazon ElastiCache (Redis)", "Stores pre-computed recommendations.")
    Component(event_consumer, "Event Consumer", "Python Background Worker, AWS SDK", "Background worker processing clickstream and purchase events from AWS SQS.")
}

System_Ext(s3_bucket, "AWS S3", "Secure object storage for heavy recommendation model artifacts.")
System_Ext(aws_sqs, "Amazon SQS", "Async event bus for processing user events.")

Rel(api_router, cache_persistence_repository, "Reads pre-computed lists", "Redis Protocol over TLS")
Rel(model_loader, s3_bucket, "Fetches model artifacts", "HTTPS / AWS SDK")
Rel(event_consumer, aws_sqs, "Consumes user events", "AWS SDK / HTTPS")

@enduml