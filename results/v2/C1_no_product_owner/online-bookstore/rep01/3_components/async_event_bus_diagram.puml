@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Async Event Bus container

Container_Boundary(async_event_bus, "Async Event Bus") {
    Component(Topic Router, "Topic Router", "AWS SNS", "Fan-out for domain events like OrderPlaced and InventoryUpdated.")
    Component(Queue Dispatcher, "Queue Dispatcher", "AWS SQS", "Durable point-to-point buffering for consuming services.")
    Component(Dead Letter Queue, "Dead Letter Queue", "AWS SQS DLQ", "Captures failed or poisoned messages after max retries.")
    Component(Event Schema Registry, "Event Schema Registry", "AWS EventBridge", "Validates and versions event JSON schemas.")
    Component(Idempotency Store, "Idempotency Store", "Amazon ElastiCache Redis", "Handles deduplication for at-least-once delivery.")
    Component(KMS, "KMS", "AWS KMS", "Provides encryption keys for data-at-rest protection.")
}

Rel(Topic Router, Queue Dispatcher, "Forwards messages to subscribed queues", "AWS SNS Subscription/JSON over HTTPS")
Rel(Topic Router, KMS, "Encrypts and decrypts payloads at rest", "AWS KMS API")
@enduml