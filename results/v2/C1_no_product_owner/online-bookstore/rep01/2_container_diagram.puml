@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore System

Person(Customer_Admin_Staff, "Customer & Admin Staff", "End-users and internal operators accessing the platform via Web/Mobile clients to browse, purchase, and manage books, reviews, and recommendations.")

System_Ext(Payment_Gateway, "Payment Gateway", "External Stripe/PayPal system for secure financial transactions.")
System_Ext(Shipping_Provider_APIs, "Shipping Provider APIs", "External FedEx/UPS systems for fulfillment and shipping label generation.")
System_Ext(Identity_Provider, "Identity Provider", "Auth0/AWS Cognito handling OAuth2/OIDC authentication and session management.")

System_Boundary(Online_Bookstore_System, "Online Bookstore System") {
    Container(Single_Page_Application, "Single Page Application", "React, TypeScript, AWS S3, CloudFront", "Provides the user interface for browsing books, managing cart, and viewing recommendations.")
    Container(AWS_API_Gateway_ALB, "AWS API Gateway & ALB", "AWS API Gateway, Application Load Balancer", "Routes and manages incoming HTTPS traffic from the frontend to core services.")
    Container(Catalog_Service, "Catalog Service", "Go, AWS ECS Fargate", "Manages book inventory, details, and search capabilities.")
    Container(Order_Checkout_Service, "Order & Checkout Service", "Node.js, AWS ECS Fargate", "Processes customer orders, payments, and fulfillment workflows.")
    Container(Recommendation_Service, "Recommendation Service", "Python FastAPI, AWS ECS Fargate", "Generates personalized book recommendations for users.")
    Container(Async_Event_Bus, "Async Event Bus", "AWS SQS, AWS SNS", "Handles decoupled asynchronous messaging between core microservices.")
    ContainerDb(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Relational database for storing core transactional and catalog data.")
    ContainerDb(Amazon_ElastiCache, "Amazon ElastiCache", "Amazon ElastiCache (Redis)", "In-memory data store for low-latency recommendations and caching.")
}

Rel(Customer_Admin_Staff, Single_Page_Application, "Accesses the platform", "HTTPS")
Rel(Single_Page_Application, AWS_API_Gateway_ALB, "Sends API requests", "HTTPS")
Rel(AWS_API_Gateway_ALB, Catalog_Service, "Routes requests via App Mesh sidecars", "gRPC over mTLS")
Rel(AWS_API_Gateway_ALB, Order_Checkout_Service, "Routes requests via App Mesh sidecars", "gRPC over mTLS")
Rel(AWS_API_Gateway_ALB, Recommendation_Service, "Routes requests via App Mesh sidecars", "gRPC over mTLS")
Rel(Order_Checkout_Service, Payment_Gateway, "Processes payments", "HTTPS/REST")
Rel(Order_Checkout_Service, Shipping_Provider_APIs, "Initiates fulfillment", "HTTPS/REST")
Rel(Catalog_Service, Async_Event_Bus, "Publishes and consumes events", "AWS SDK/HTTPS")
Rel(Order_Checkout_Service, Async_Event_Bus, "Publishes and consumes events", "AWS SDK/HTTPS")
Rel(Recommendation_Service, Async_Event_Bus, "Publishes and consumes events", "AWS SDK/HTTPS")
Rel(Catalog_Service, Amazon_Aurora_PostgreSQL, "Reads and writes catalog data", "PostgreSQL Protocol")
Rel(Order_Checkout_Service, Amazon_Aurora_PostgreSQL, "Reads and writes order data", "PostgreSQL Protocol")
Rel(Recommendation_Service, Amazon_ElastiCache, "Reads recommendation cache", "Redis Protocol")

@enduml