@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer_Admin_Staff, "Customer & Admin Staff", "End-users and internal operators accessing the platform via Web/Mobile clients to browse, purchase, and manage books, reviews, and recommendations.")
System(Online_Bookstore_System, "Online Bookstore System", "An Amazon-style global e-commerce platform for physical and electronic books with recommendations and reviews, delivering high availability and multi-region scalability across AWS.")
System_Ext(Payment_Gateway, "Payment Gateway", "External Stripe/PayPal system for secure financial transactions.")
System_Ext(Shipping_Provider_APIs, "Shipping Provider APIs", "External FedEx/UPS systems for fulfillment and shipping label generation.")
System_Ext(Identity_Provider, "Identity Provider", "Auth0/AWS Cognito handling OAuth2/OIDC authentication and session management.")

Rel(Customer_Admin_Staff, Online_Bookstore_System, "Browses, purchases, and reviews books via web and mobile clients.", "HTTPS and TLS 1.3")
Rel(Online_Bookstore_System, Payment_Gateway, "Processes secure transactions using idempotency keys.", "REST/JSON with mTLS")
Rel(Online_Bookstore_System, Shipping_Provider_APIs, "Generates shipping labels and handles fulfillment asynchronously.", "AWS SQS and REST/JSON APIs")
Rel(Online_Bookstore_System, Identity_Provider, "Authenticates user sessions.", "OAuth2/OIDC over HTTPS")
@enduml