@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers, "Customers", "External users submitting online claims.")
Person(Brokers, "Brokers", "External users assisting with claim submissions and management.")
Person(Claims Adjusters, "Claims Adjusters", "Internal users reviewing and processing adjuster workflows.")

System(Insurance Claims Modernization, "Insurance Claims Modernization", "A modern cloud-native platform in Azure West Europe gradually replacing a 30-year-old on-premises mainframe claims system using a hybrid architecture.")

System_Ext(Legacy Mainframe, "Legacy Mainframe", "On-premises COBOL/DB2 system acting as the system of record.")
System_Ext(Insurer’s Active Directory, "Insurer’s Active Directory", "Enterprise identity provider for single sign-on.")

Rel(Customers, Insurance Claims Modernization, "Submits online claims and interacts with the platform", "HTTPS (Web/API)")
Rel(Brokers, Insurance Claims Modernization, "Submits online claims and interacts with the platform", "HTTPS (Web/API)")
Rel(Claims Adjusters, Insurance Claims Modernization, "Performs adjuster workflows and authenticates", "HTTPS (Web/API with OAuth2/OIDC)")
Rel(Insurance Claims Modernization, Legacy Mainframe, "Bridges traffic and syncs claims data via gateway", "IBM MQ over ExpressRoute with mTLS")
Rel(Insurance Claims Modernization, Insurer’s Active Directory, "Authenticates users for single sign-on", "OIDC / OAuth2")

@enduml