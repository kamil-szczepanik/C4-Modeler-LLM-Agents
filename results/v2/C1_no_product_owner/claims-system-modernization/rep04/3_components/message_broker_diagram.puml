@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Message Broker container

System_Ext(Claims_Core_Service, "Claims Core Service", "External service that publishes domain events.")
System_Ext(Mainframe_Integration_Adapter, "Mainframe Integration Adapter", "External adapter for mainframe synchronization.")

Container_Boundary(Message_Broker, "Message Broker") {
    Component(Claim_Event_Topic, "Claim Event Topic", "Azure Service Bus Topic", "Pub-sub distribution of domain events for migrated claim types.")
    Component(Mainframe_Outbox_Queue, "Mainframe Outbox Queue", "Azure Service Bus Queue with Sessions", "Handles ordered transactions and sync commands using Session IDs.")
    Component(Dead_Letter_Handler, "Dead-Letter Handler", "Azure Service Bus DLQ with Azure Monitor", "Built-in Service Bus DLQ with automated alerting via PagerDuty for poisoned messages.")
    Component(Retry_Backoff_Policy_Engine, "Retry & Backoff Policy Engine", "Azure Service Bus Native Retry Policy", "Configured with an exponential backoff and a MaxDeliveryCount ceiling of 5 retries.")
}

Rel(Claims_Core_Service, Claim_Event_Topic, "Publishes domain events", "AMQP over TLS, Azure RBAC Managed Identity")
Rel(Mainframe_Integration_Adapter, Mainframe_Outbox_Queue, "Consumes ordered sync commands using Session IDs", "AMQP over TLS, Azure RBAC Managed Identity")
Rel(Mainframe_Integration_Adapter, Dead_Letter_Handler, "Inspects and re-queues poisoned messages", "AMQP over TLS")

@enduml