@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Core Service container

System_Ext(ClaimsAPI Gateway, "Claims API Gateway", "External gateway routing requests")

Container_Boundary(claims_core_service, "Claims Core Service") {
    Component(Integration Router, "Integration Router", "Java / Spring Boot", "Component managing feature-flagged routing for claim types.")
    Component(Claim Processing Engine, "Claim Processing Engine", "Java / Spring Boot, Spring Data JPA", "Component executing domain logic via Spring Data JPA.")
    Component(Asynchronous Event Handler, "Asynchronous Event Handler", "Java / Spring Boot, Spring Messaging", "Component processing domain events via Spring Messaging.")
    Component(Claim State Cache, "Claim State Cache", "Azure Cache for Redis", "In-memory cache for read-heavy operations.")
    Component(Database, "Database", "Azure SQL Database", "Relational datastore utilizing TDE with Customer-Managed Keys.")
    Component(Message Broker, "Message Broker", "Azure Service Bus", "Asynchronous message broker utilizing Managed Identities.")
}

Rel(ClaimsAPI Gateway, Integration Router, "REST / HTTPS / OIDC / OAuth2")
Rel(Integration Router, Claim Processing Engine, "In-process Java method calls")
Rel(Integration Router, Claim State Cache, "Redis / TCP")
Rel(Claim Processing Engine, Claim State Cache, "Redis / TCP")
Rel(Claim Processing Engine, Database, "JDBC / TDS / Managed Identities")
Rel(Asynchronous Event Handler, Message Broker, "AMQP / Managed Identities")

@enduml