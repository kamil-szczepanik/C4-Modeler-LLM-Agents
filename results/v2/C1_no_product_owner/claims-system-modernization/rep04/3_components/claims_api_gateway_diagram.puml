@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(claims_api_gateway, "Claims API Gateway") {
    Component(Routing_Policy_Engine, "Routing & Policy Engine", "APIM Policy XML / Policy Fragments", "Handles centralized routing, policy enforcement, and request transformation.")
    Component(Token_Validation_Claims_Enriched_Policy, "Token Validation & Claims Enriched Policy", "APIM Policy XML", "Validates security tokens and enriches requests with claims information.")
    Component(Dynamic_Migration_Router, "Dynamic Migration Router", "APIM Named Values & Policy Fragments", "Dynamically routes claim types between modern and legacy systems during the migration phase.")
}

Rel(Routing_Policy_Engine, Token_Validation_Claims_Enriched_Policy, "Validates incoming tokens")
Rel(Token_Validation_Claims_Enriched_Policy, Dynamic_Migration_Router, "Forwards validated requests for migration routing")

@enduml