@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Claims_Core_Service, "Claims Core Service", "Java/Spring Boot on Azure App Service", "External component interacting with the database.")
System_Ext(Mainframe_Integration_Adapter, "Mainframe Integration Adapter", "Azure App Service Worker", "External component interacting with the database.")

Container_Boundary(Database, "Database") {
    Component(MigratedClaims_Schema, "MigratedClaims Schema", "Azure SQL Database", "Stores incrementally migrated claims data from the legacy system.")
    Component(SyncBuffer_Schema, "SyncBuffer Schema", "Azure SQL Database", "Buffers synchronization data between the cloud platform and the mainframe.")
    Component(AuditLog_Schema, "AuditLog Schema", "Azure SQL Database", "Maintains immutable audit logs for security and compliance.")
}

Rel(Claims_Core_Service, MigratedClaims_Schema, "Reads and writes claim data", "TDS and Azure Managed Identity")
Rel(Mainframe_Integration_Adapter, SyncBuffer_Schema, "Synchronizes records", "TDS and Azure Managed Identity")
Rel(Claims_Core_Service, AuditLog_Schema, "Writes audit logs", "TDS and Azure Managed Identity")

@enduml