@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(main_integration_adapter, "Mainframe Integration Adapter") {
    Component(COBOL_Gateway_Client, "COBOL Gateway Client", "Java/Spring Integration TCP/IP adapter", "Connects securely to the legacy mainframe and retrieves credentials from Azure Key Vault.")
    Component(Message_Translator, "Message Translator", "Apache Camel", "Translates and routes messages for the integration adapter.")
    Component(Resilience_and_Queue_Manager, "Resilience & Queue Manager", "Resilience4j", "Manages resilience, strict retry policies, dead-lettering, and deduplication.")
    Component(Azure_App_Service_Worker, "Azure App Service Worker", "Hosting infrastructure", "Hosts the application infrastructure.")
    Component(Azure_Service_Bus, "Azure Service Bus", "Message Broker", "Provides asynchronous buffering to mitigate mainframe latency.")
}

System_Ext(Legacy_Mainframe, "Legacy Mainframe", "COBOL/DB2 System of Record")
System_Ext(Claims_Core_Service, "Claims Core Service", "External System")
System_Ext(Azure_Monitor, "Azure Monitor", "External System")
System_Ext(Azure_Key_Vault, "Azure Key Vault", "External System")

Rel(Claims_Core_Service, Message_Translator, "Inbound commands", "Azure Service Bus / AMQP")
Rel(COBOL_Gateway_Client, Legacy_Mainframe, "Socket communication", "TCP/IP over Site-to-Site VPN with mTLS")
Rel(Message_Translator, Azure_Monitor, "Audit logging", "HTTPS/TLS")
Rel(COBOL_Gateway_Client, Azure_Key_Vault, "Credential retrieval", "Managed Identities / REST API")

@enduml