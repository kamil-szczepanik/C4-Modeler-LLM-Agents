@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Adjuster Workspace container

Person(ClaimsAdjusters, "Claims Adjusters", "Users")
System_Ext(InsurerActiveDirectory, "Insurer’s Active Directory", "External System")
System_Ext(ClaimsBFF, "Claims BFF", "Node.js/Express on Azure App Service")

Container_Boundary(AdjusterWorkspace, "Adjuster Workspace") {
    Component(AuthenticationComponent, "Authentication Component", "MSAL.js", "Implements OIDC/OAuth2 authentication with secure in-memory token storage.")
    Component(ClaimManagementModule, "Claim Management Module", "React Router & Form Libraries", "Manages claims processing views and form interactions.")
    Component(LocalStateCachingComponent, "Local State & Caching Component", "TanStack Query", "Manages server-state caching and volatile in-memory data persistence.")
    Component(ApiClient, "API Client", "Axios", "Sends REST requests to the backend.")
}

Rel(ClaimsAdjusters, AuthenticationComponent, "Authenticates", "HTTPS/OIDC")
Rel(AuthenticationComponent, InsurerActiveDirectory, "Validates credentials", "HTTPS")
Rel(ClaimManagementModule, LocalStateCachingComponent, "Reads/writes cached claim data", "In-Memory")
Rel(LocalStateCachingComponent, ApiClient, "Requests fresh data on cache miss", "Async/Await")
Rel(ApiClient, ClaimsBFF, "Sends REST requests", "HTTPS/REST")

@enduml