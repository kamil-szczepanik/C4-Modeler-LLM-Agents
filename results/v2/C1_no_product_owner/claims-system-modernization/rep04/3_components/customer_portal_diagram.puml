@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Customer_Broker, "Customer / Broker", "End users including customers and brokers who interact with the system.")

System_Ext(Claims_API_Gateway, "Claims API Gateway", "Backend integration tier supporting legacy migration constraints.")
System_Ext(Azure_Monitor_Application_Insights, "Azure Monitor / Application Insights", "Receives sanitized traces and telemetry.")

Container_Boundary(Customer_Portal, "Customer Portal") {
    Component(Authentication_Component, "Authentication Component", "MSAL.js with PKCE and Azure Active Directory / Entra ID", "Handles user authentication using Authorization Code Flow with PKCE and in-memory token storage.")
    Component(Claim_Submission_Module, "Claim Submission Module", "React multi-step form", "Multi-step React form for online claims (R-01).")
    Component(Claim_Status_Tracker, "Claim Status Tracker", "React BFF integration", "Real-time status display via BFF.")
    Component(API_Client_Layer, "API Client Layer", "Axios", "Axios-based communication module.")
    Component(Telemetry_Component, "Telemetry Component", "Azure Application Insights React plugin", "Telemetry and error tracking tool with custom PII scrubbing interceptors.")
    Component(State_Routing_Core, "State & Routing Core", "React Router", "React Router for protected route guarding and navigation coordination.")
    Component(Error_Boundaries, "Error Boundaries", "React Error Boundary", "Top-level React crash fallback handlers.")
}

Rel(Customer_Broker, Authentication_Component, "Authenticates", "HTTPS")
Rel(State_Routing_Core, Claim_Submission_Module, "Coordinates navigation", "Internal React Context")
Rel(API_Client_Layer, Claims_API_Gateway, "Sends REST payloads", "HTTPS/REST")
Rel(Telemetry_Component, Azure_Monitor_Application_Insights, "Streams sanitized traces", "HTTPS")
@enduml