@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(claims_bff, "Claims BFF") {
    Component(RoutingAuth_Controller, "Routing & Auth Controller", "TypeScript / Node.js", "Handles incoming requests, routing, and authentication.")
    Component(ClaimAggregator_Service, "Claim Aggregator Service", "TypeScript / Node.js", "Aggregates claim data and coordinates service workflows.")
    Component(UIAdaptation_Layer, "UI Adaptation Layer", "TypeScript / Node.js", "Adapts data structures for UI consumption.")
    Component(FeatureFlag_Routing_Dispatcher, "Feature Flag & Routing Dispatcher", "TypeScript / Node.js", "Evaluates feature flags and dispatches requests to modern or legacy core services.")
}

Rel(RoutingAuth_Controller, ClaimAggregator_Service, "Invokes", "In-memory")
Rel(ClaimAggregator_Service, FeatureFlag_Routing_Dispatcher, "Evaluates", "In-memory")

@enduml