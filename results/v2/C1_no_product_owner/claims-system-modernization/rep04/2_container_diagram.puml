@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Insurance Claims Modernization

Person(CustomersAndBrokers, "Customers and Brokers", "External users submitting online claims and interacting with the platform.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal users reviewing and processing adjuster workflows.")

System_Ext(ActiveDirectory, "Insurer's Active Directory / Microsoft Entra ID", "Enterprise identity provider for single sign-on and authentication.")
System_Ext(LegacyMainframe, "Legacy Mainframe", "On-premises COBOL/DB2 system acting as the legacy system of record.")

System_Boundary(InsuranceClaimsModernization, "Insurance Claims Modernization") {
    Container(CustomerPortal, "Customer Portal", "React SPA on Azure Static Web Apps", "Hosts the React single-page application for customers.")
    Container(AdjusterWorkspace, "Adjuster Workspace", "React SPA on Azure Static Web Apps", "Hosts the React single-page application for adjusters.")
    Container(ClaimsAPIGateway, "Claims API Gateway", "Azure API Management", "Provides centralized routing, security enforcement, and token validation.")
    Container(ClaimsBFF, "Claims BFF", "Node.js/Express on Azure App Service", "Backend-for-frontend service supporting the client applications.")
    Container(ClaimsCoreService, "Claims Core Service", "Java/Spring Boot on Azure App Service", "Core business logic processing service for migrated claim types.")
    Container(MainframeIntegrationAdapter, "Mainframe Integration Adapter", "Azure App Service Worker", "Adapts and bridges traffic to the legacy mainframe.")
    Container(MessageBroker, "Message Broker", "Azure Service Bus", "Handles reliable, transactional asynchronous messaging between cloud and mainframe.")
    ContainerDb(Database, "Database", "Azure SQL Database", "Provides relational storage with AES-256 encryption-at-rest for migrated claim types.")
}

Rel(CustomersAndBrokers, CustomerPortal, "Interacts with and uses", "HTTPS")
Rel(ClaimsAdjusters, AdjusterWorkspace, "Interacts with and uses", "HTTPS")
Rel(CustomerPortal, ClaimsAPIGateway, "Sends requests to", "HTTPS/REST")
Rel(AdjusterWorkspace, ClaimsBFF, "Sends requests to", "HTTPS/REST")
Rel(ClaimsAPIGateway, ClaimsBFF, "Routes requests to", "HTTPS/OIDC/OAuth2")
Rel(ClaimsAPIGateway, ClaimsCoreService, "Routes requests to", "HTTPS/OIDC/OAuth2")
Rel(ClaimsBFF, Database, "Reads and writes data", "TDS/Managed Identities")
Rel(ClaimsCoreService, Database, "Reads and writes data", "TDS/Managed Identities")
Rel(MainframeIntegrationAdapter, LegacyMainframe, "Integrates with legacy system of record", "Site-to-Site VPN/ExpressRoute with mTLS")
Rel(ClaimsCoreService, MessageBroker, "Sends and receives asynchronous messages", "AMQP/Managed Identities")
Rel(MainframeIntegrationAdapter, MessageBroker, "Sends and receives asynchronous messages", "AMQP/Managed Identities")

@enduml