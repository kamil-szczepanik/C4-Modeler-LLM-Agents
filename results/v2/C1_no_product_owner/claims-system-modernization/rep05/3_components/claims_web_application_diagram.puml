@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway_bff, "API Gateway & BFF", "Azure Container Apps / Node.js or .NET", "API Gateway & Backend for Frontend")
System_Ext(azure_app_insights, "Azure Application Insights", "Azure Application Insights", "Cloud telemetry and monitoring")

Container_Boundary(claims_web_application, "Claims Web Application") {
    Component(claims_dashboard_component, "Claims Dashboard Component", "React & React Router", "Delivers fast client-side rendering, navigation, and overview of claims.")
    Component(claim_form_validation_component, "Claim Form & Validation Component", "React & Zustand", "Handles claim data entry, local state caching, and optimistic UI updates.")
    Component(api_client_service, "API Client Service", "Axios", "Handles asynchronous HTTP/JSON communication with the BFF.")
    Component(auth_rbac_routing_component, "Auth & RBAC Routing Component", "React Router & Azure Static Web Apps", "Validates session state and fetches permissions via HTTPS/JSON.")
    Component(telemetry_security, "Telemetry & Security", "Azure Application Insights Browser SDK", "Enables Real User Monitoring (RUM) and error tracking.")
}

Rel(claims_web_application, api_gateway_bff, "Communicates", "HTTPS/JSON")
Rel(claims_web_application, azure_app_insights, "Forwards telemetry", "OpenTelemetry headers")
Rel(auth_rbac_routing_component, api_gateway_bff, "Validates session state and fetches permissions", "HTTPS/JSON")

@enduml