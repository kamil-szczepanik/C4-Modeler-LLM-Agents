@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the New Claims Database container

System_Ext(api_gateway_bff, "API Gateway & BFF", "API Gateway and Backend for Frontend")
System_Ext(integration_acl, "Integration & Anti-Corruption Layer", "Integration and Anti-Corruption Layer")
System_Ext(azure_service_bus, "Azure Service Bus", "Cloud messaging service")

Container_Boundary(new_claims_database, "New Claims Database") {
    Component(claims_schema, "Claims Schema", "Relational Tables with Temporal Tables", "Stores relational claims data with temporal table capabilities.")
    Component(outbox_schema, "Outbox Schema", "Outbox Pattern Tables", "Implements the Outbox pattern for reliable message dispatch.")
    Component(sync_tracking_schema, "Sync Tracking Schema", "Relational Tables", "Tracks and reconciles migrated records using SQL bulk operations.")
    Component(read_model_projections, "Read Model Projections", "Dedicated Projection Tables", "Provides dedicated tables for optimized read model projections.")
    Component(azure_sql_database, "Azure SQL Database", "Serverless compute tier with Geo-Replication, TDE, and Always Encrypted", "Provides managed relational storage supporting the database schemas.")
}

Rel(api_gateway_bff, claims_schema, "Queries and mutates data", "ADO.NET and Entity Framework Core (TCP/1433 with TLS 1.2 and Azure AD authentication)")
Rel(integration_acl, sync_tracking_schema, "Reconciles migrated records", "SQL bulk operations")
Rel(outbox_schema, azure_service_bus, "Drained by Azure Functions", "managed identity polling")

@enduml