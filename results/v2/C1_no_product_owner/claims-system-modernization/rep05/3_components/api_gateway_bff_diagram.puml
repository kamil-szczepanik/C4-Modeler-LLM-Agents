@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway & BFF container

Container_Boundary(api_gateway_bff, "API Gateway & BFF") {
    Component(YARP API Router, "YARP API Router", "YARP (Yet Another Reverse Proxy)", "Manages cross-cutting routing, rate limiting, and JWT validation.")
    Component(Claims BFF Service, "Claims BFF Service", ".NET 8", "Provides high-throughput runtime performance for the BFF under strict latency constraints.")
    Component(Routing Dispatcher Component, "Routing Dispatcher Component", ".NET 8 / Polly", "Orchestrates routing and implements circuit breakers and fallback handlers.")
}

Rel(YARP API Router, Claims BFF Service, "Routes verified requests", "In-process / gRPC")
Rel(Claims BFF Service, Routing Dispatcher Component, "Orchestrates routing", "In-process")

@enduml