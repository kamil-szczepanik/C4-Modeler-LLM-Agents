@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Application Insights container

Container_Boundary(azure_application_insights, "Azure Application Insights") {
    Component(TelemetryIngestionEngine, "Telemetry Ingestion Engine", "Azure Application Insights", "Ingests telemetry and distributed traces via OpenTelemetry.")
    Component(LogAnalyticsWorkspaceStorage, "Log Analytics Workspace Storage", "Azure Log Analytics", "Stores telemetry data and supports rapid querying using KQL.")
    Component(ApplicationMapGenerator, "Application Map Generator", "Azure Application Insights", "Generates application maps from ingested telemetry streams.")
    Component(LiveMetricsStream, "Live Metrics Stream", "Azure Application Insights", "Provides in-memory telemetry broadcast for live metrics.")
    Component(AvailabilityAndAlertingSubcomponent, "Availability and Alerting Sub-component", "Azure Monitor Alerts", "Handles synthetic monitoring and alerting via KQL queries.")
    Component(DiagnosticExportArchiveSubcomponent, "Diagnostic Export & Archive Sub-component", "Azure Blob Storage, Azure Key Vault", "Manages long-term telemetry archiving with Customer-Managed Keys.")
}

Rel(TelemetryIngestionEngine, LogAnalyticsWorkspaceStorage, "Sends telemetry data", "Internal Azure Storage Protocol")
Rel(TelemetryIngestionEngine, ApplicationMapGenerator, "Feeds telemetry streams", "Internal Stream Processing")
Rel(TelemetryIngestionEngine, LiveMetricsStream, "Broadcasts metrics", "In-Memory Telemetry Broadcast")
Rel(AvailabilityAndAlertingSubcomponent, LogAnalyticsWorkspaceStorage, "Queries log data", "KQL Queries")
Rel(LogAnalyticsWorkspaceStorage, DiagnosticExportArchiveSubcomponent, "Exports diagnostic data", "Azure Storage SDK")

@enduml