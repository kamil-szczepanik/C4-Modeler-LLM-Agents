@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Key Vault container

System_Ext(api_gateway, "API Gateway & BFF", "Azure Container Apps / Node.js or .NET")
System_Ext(integration_layer, "Integration & Anti-Corruption Layer", "Azure Functions & Service Bus")
System_Ext(app_insights, "Azure Application Insights", "Log Analytics and Monitoring")

Container_Boundary(azure_key_vault, "Azure Key Vault") {
    Component(Secrets_Management_Component, "Secrets Management Component", "Azure Key Vault Secrets, HTTPS/REST", "Manages runtime secrets, database connection strings, and mainframe integration credentials.")
    Component(Certificates_Management_Component, "Certificates Management Component", "Azure Key Vault Certificates", "Handles TLS/SSL certificates and cryptographic assets.")
    Component(Access_Control_Policy_Enforcement_Component, "Access Control & Policy Enforcement Component", "Azure RBAC & Private Link", "Enforces granular least-privilege access control and eliminates public internet exposure.")
}

Rel(api_gateway, Secrets_Management_Component, "Retrieves runtime secrets and database connection strings via Private Endpoint", "HTTPS/REST, TLS 1.3, Managed Identities")
Rel(integration_layer, Secrets_Management_Component, "Retrieves mainframe integration credentials via Private Endpoint", "HTTPS/REST, TLS 1.3, Managed Identities")
Rel(api_gateway, Certificates_Management_Component, "Handles TLS/SSL certificates via Private Endpoint", "HTTPS/REST, TLS 1.3")
Rel(azure_key_vault, app_insights, "Routes diagnostic settings and access logs", "HTTPS")

@enduml