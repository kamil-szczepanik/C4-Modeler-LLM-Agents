@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Insurance Claims Modernization

Person(Customers, "Customers", "External users who submit online claims.")
Person(Brokers, "Brokers", "External users who submit and manage claims on behalf of customers.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal users who handle claims workflows.")

System_Ext(LegacyMainframe, "Legacy Mainframe", "On-premise legacy system of record (COBOL/DB2).")
System_Ext(ActiveDirectory, "Active Directory", "Identity Provider for authentication.")

System_Boundary(InsuranceClaimsModernization, "Insurance Claims Modernization") {
    Container(ClaimsWebApplication, "Claims Web Application", "Azure Static Web Apps / React", "Hosts the React-based frontend for fast UI delivery.")
    Container(APIGatewayBFF, "API Gateway & BFF", "Azure Container Apps / Node.js or .NET", "Hosts containerized services providing KEDA scaling and API coordination.")
    Container(IntegrationAntiCorruptionLayer, "Integration & Anti-Corruption Layer", "Azure Functions & Service Bus", "Powers the Anti-Corruption Layer with dead-letter queues and circuit-breakers.")
    ContainerDb(NewClaimsDatabase, "New Claims Database", "Azure SQL Database", "Stores migrated claim types with Transparent Data Encryption.")
    Container(AzureApplicationInsights, "Azure Application Insights", "Azure Application Insights", "Provides centralized distributed tracing and observability via OpenTelemetry.")
    Container(AzureKeyVault, "Azure Key Vault", "Azure Key Vault", "Manages runtime secrets using managed identities.")
}

Rel(Customers, ClaimsWebApplication, "Interacts with claims web application via HTTPS/JSON", "HTTPS/JSON")
Rel(Brokers, ClaimsWebApplication, "Interacts with claims web application via HTTPS/JSON", "HTTPS/JSON")
Rel(ClaimsAdjusters, ClaimsWebApplication, "Interacts with claims web application via HTTPS/JSON", "HTTPS/JSON")
Rel(ClaimsWebApplication, APIGatewayBFF, "Communicates with API Gateway & BFF via HTTPS/JSON", "HTTPS/JSON")
Rel(APIGatewayBFF, ActiveDirectory, "Authenticates users via Azure Active Directory", "OpenID Connect/OAuth2")
Rel(APIGatewayBFF, IntegrationAntiCorruptionLayer, "Communicates with Integration & ACL", "mTLS and HTTPS/JSON")
Rel(APIGatewayBFF, NewClaimsDatabase, "Communicates with New Claims Database", "mTLS and HTTPS/JSON")
Rel(IntegrationAntiCorruptionLayer, LegacyMainframe, "Connects to Legacy Mainframe via secure VPN/ExpressRoute", "Secure VPN/ExpressRoute with on-premise API Security Gateway")
Rel(ClaimsWebApplication, AzureApplicationInsights, "Forwards telemetry", "OpenTelemetry headers")
Rel(APIGatewayBFF, AzureApplicationInsights, "Forwards telemetry", "OpenTelemetry headers")
Rel(IntegrationAntiCorruptionLayer, AzureApplicationInsights, "Forwards telemetry", "OpenTelemetry headers")
Rel(APIGatewayBFF, AzureKeyVault, "Manages runtime secrets", "Managed Identities")

@enduml