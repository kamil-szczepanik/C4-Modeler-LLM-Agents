@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers, "Customers", "End users who submit online claims.")
Person(Brokers, "Brokers", "Intermediaries who submit and manage online claims on behalf of customers.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal staff who handle claims workflows.")

System(Insurance_Claims_Modernization, "Insurance Claims Modernization", "Gradually replaces a legacy 30-year-old mainframe claims platform with a modern, cloud-native hybrid architecture to enable online claim submissions and adjuster workflows while maintaining seamless integration with the on-premise system of record.")

System_Ext(Legacy_Mainframe, "Legacy Mainframe", "On-premise legacy system of record (COBOL/DB2).")
System_Ext(Active_Directory, "Active Directory", "On-premise identity provider for authentication.")

Rel(Customers, Insurance_Claims_Modernization, "Submit online claims", "HTTPS")
Rel(Brokers, Insurance_Claims_Modernization, "Submit online claims", "HTTPS")
Rel(Claims_Adjusters, Insurance_Claims_Modernization, "Perform claims handling workflows", "HTTPS")
Rel(Insurance_Claims_Modernization, Active_Directory, "Authenticate users for Single Sign-On (SSO) and MFA", "OIDC/SAML over HTTPS")
Rel(Insurance_Claims_Modernization, Legacy_Mainframe, "Sync claims data and route messages", "Asynchronous messaging/ETL via Azure API Management over secure VPN/ExpressRoute with mTLS")
Rel(Legacy_Mainframe, Insurance_Claims_Modernization, "Provide system of record data", "Asynchronous messaging/ETL via Azure API Management over secure VPN/ExpressRoute with mTLS")
@enduml