@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers_and_Brokers, "Customers and Brokers", "End users who submit claims online and interact with the regional insurer.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal staff who manage and process claims workflows.")

System(Modern_Claims_Platform, "Modern Claims Platform", "A hybrid cloud-native platform on Azure that modernizes a regional insurer's legacy mainframe claims system, enabling online claim submissions and adjuster workflows.")

System_Ext(Legacy_Mainframe, "Legacy Mainframe", "30-year-old on-premises COBOL/DB2 system serving as the system of record.")
System_Ext(Insurers_Active_Directory, "Insurer's Active Directory", "Identity management system satisfying single sign-on and MFA requirements.")
System_Ext(Core_Payment_Gateway, "Core Payment Gateway", "External system used for processing insurance payments.")

Rel(Customers_and_Brokers, Modern_Claims_Platform, "Submits online claims and interacts with the platform", "HTTPS (TLS 1.3)")
Rel(Claims_Adjusters, Modern_Claims_Platform, "Performs adjuster workflows and authentication", "HTTPS (TLS 1.3) and OIDC/OAuth2 SSO")
Rel(Modern_Claims_Platform, Insurers_Active_Directory, "Authenticates users and validates credentials", "OIDC/OAuth2")
Rel(Modern_Claims_Platform, Core_Payment_Gateway, "Processes financial transactions and payments", "REST/JSON over HTTPS")
Rel(Modern_Claims_Platform, Legacy_Mainframe, "Syncs claims data and bridges systems via Anti-Corruption Layer / Integration Gateway", "Azure ExpressRoute, mTLS over HTTPS/AMQP, Azure Service Bus")

@enduml