@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(adjuster_workspace, "Adjuster Workspace") {
    Component(Claims_UI_Router_View_Controller, "Claims UI Router & View Controller", "React, TypeScript", "Type-safe single-page application framework for UI components.")
    Component(BFF_Session_State_Manager, "BFF Session & State Manager", "Node.js, Express", "Lightweight backend runtime for BFF aggregation and fast I/O.")
    Component(Claims_Query_Aggregator, "Claims Query Aggregator", "Node.js", "Aggregates queries and performs parallel Cosmos DB reads.")
    Component(Command_Dispatcher, "Command Dispatcher", "Node.js", "Dispatches commands to the core API.")
    Component(Session_Cache_Client, "Session Cache Client", "Node.js ioredis", "Distributed session cache client ensuring stateless scaling.")
    Component(Azure_App_Service, "Azure App Service", "Azure App Service", "Managed PaaS hosting for containerized BFF deployment.")
    Component(Azure_Cache_for_Redis, "Azure Cache for Redis", "Azure Cache for Redis", "Distributed session cache ensuring stateless scaling.")
    Component(Azure_Cosmos_DB, "Azure Cosmos DB", "Azure Cosmos DB (SQL API)", "NoSQL database for fast data retrieval.")
    Component(Claims_Core_API, "Claims Core API", "AKS", "Backend claims core API service.")
    Component(Azure_Key_Vault, "Azure Key Vault", "Azure Key Vault", "Secure secrets management via CSI secret store drivers.")
}

Rel(Claims_UI_Router_View_Controller, BFF_Session_State_Manager, "HTTPS", "")
Rel(BFF_Session_State_Manager, Session_Cache_Client, "TCP/Redis Protocol with TLS", "")
Rel(Claims_Query_Aggregator, Azure_Cosmos_DB, "HTTPS/SQL API", "")
Rel(Command_Dispatcher, Claims_Core_API, "gRPC with TLS 1.3", "")
Rel(BFF_Session_State_Manager, Azure_Key_Vault, "HTTPS via CSI Secret Store Drivers", "")

@enduml