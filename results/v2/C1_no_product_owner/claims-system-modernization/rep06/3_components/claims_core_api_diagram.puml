@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Core API container

Container_Boundary(claims_core_api, "Claims Core API") {
    Component(ClaimSubmissionController, "Claim Submission Controller", "Spring gRPC / Spring Boot", "Handles incoming claim submission requests via gRPC and REST/HTTPS.")
    Component(ClaimManagementService, "Claim Management Service", "Spring Service / Domain Model", "Core domain service managing business logic and orchestrating workflow.")
    Component(MainframeAntiCorruptionLayer, "Mainframe Anti-Corruption Layer", "Spring Integration / WebClient", "Isolates brittle legacy mainframe dependencies and handles external communication.")
    Component(EventPublisher, "Event Publisher", "Spring Kafka", "Publishes domain events to Kafka for downstream consumers.")
    Component(ClaimReadModelUpdater, "Claim Read Model Updater", "Spring Data Cosmos / Kafka Consumer", "Consumes Kafka events and updates the read model asynchronously.")
}

Component(ClaimsReadModelCache, "Claims Read Model & Cache", "Azure Cosmos DB", "External database providing low-latency read models and asynchronous caching.")
Component(IntegrationSyncEngine, "Integration & Sync Engine", "Kafka native protocol over mTLS", "External engine handling integration and synchronization.")

Rel(ClaimSubmissionController, ClaimManagementService, "In-process Java Method Call")
Rel(ClaimManagementService, MainframeAntiCorruptionLayer, "In-process Java Method Call")
Rel(ClaimManagementService, EventPublisher, "In-process Java Method Call")
Rel(ClaimManagementService, ClaimReadModelUpdater, "In-process Application Event")
Rel(ClaimReadModelUpdater, ClaimsReadModelCache, "HTTPS/TCP")
Rel(EventPublisher, IntegrationSyncEngine, "Kafka native protocol over mTLS", "Kafka native protocol over mTLS")

@enduml