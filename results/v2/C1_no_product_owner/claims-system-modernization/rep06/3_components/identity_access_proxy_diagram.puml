@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Identity & Access Proxy container

Container_Boundary(identity_access_proxy, "Identity & Access Proxy") {
    Component(TokenValidatorComponent, "Token Validator Component", "APIM Policy, OAuth2, OIDC", "Validates OIDC tokens and caches validation states.")
    Component(ClaimsApiGatewayRouter, "Claims API Gateway Router", "APIM Policies, Backend Pools", "Routes secured requests over container networks.")
    Component(RateLimiterThrottlingPolicy, "Rate Limiter & Throttling Policy", "APIM Built-in Policy", "Enforces rate limiting and throttling policies.")
    Component(TokenExchangeClaimsTransformationComponent, "Token Exchange & Claims Transformation Component", "APIM Liquid Templates", "Passes verified identity context and transforms tokens.")
}

System_Ext(InsurersActiveDirectory, "Insurer's Active Directory", "External Active Directory for authentication federation.")
System_Ext(ClaimsCoreApi, "Claims Core API", "Core API processing insurance claims.")

Rel(TokenValidatorComponent, InsurersActiveDirectory, "Validates OIDC tokens and caches validation states", "HTTPS/OIDC")
Rel(TokenValidatorComponent, TokenExchangeClaimsTransformationComponent, "Passes verified identity context", "Internal")
Rel(TokenExchangeClaimsTransformationComponent, ClaimsApiGatewayRouter, "Forwards requests with transformed internal JWTs", "Internal")
Rel(ClaimsApiGatewayRouter, ClaimsCoreApi, "Routes secured requests over container networks", "HTTPS/mTLS")

@enduml