@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Security & Infrastructure Services container

Container_Boundary(sec_infra_services, "Security & Infrastructure Services") {
    Component(azure_key_vault, "Azure Key Vault", "Azure Key Vault, CSI Secret Store Driver", "Manages and injects runtime secrets securely without hardcoding using local CSI volume mounts.")
    Component(azure_monitor, "Azure Monitor", "Azure Monitor, OpenTelemetry", "Centralizes observability, metrics, and immutable audit logging via HTTPS.")
    Component(azure_expressroute, "Azure ExpressRoute", "Azure ExpressRoute, mTLS, TLS 1.3", "Provides secure, dedicated hybrid networking between on-premises infrastructure and Azure.")
}

Component(claims_core_api, "Claims Core API", "Spring Boot, Java, Azure Kubernetes Service", "Claims Core API")
Component(integration_sync_engine, "Integration & Sync Engine", "Azure Event Hubs", "Integration & Sync Engine")
Component(legacy_mainframe, "Legacy Mainframe", "On-premises", "Legacy Mainframe")

Rel(claims_core_api, azure_key_vault, "Reads secrets via local CSI volume mounts", "FileSystem")
Rel(integration_sync_engine, azure_key_vault, "Reads secrets via local CSI volume mounts", "FileSystem")
Rel(claims_core_api, azure_monitor, "Sends telemetry and audit logs", "HTTPS / OpenTelemetry")
Rel(integration_sync_engine, azure_monitor, "Sends telemetry and audit logs", "HTTPS / OpenTelemetry")
Rel(legacy_mainframe, azure_expressroute, "Communicates securely with Azure components", "mTLS, TLS 1.3")

@enduml