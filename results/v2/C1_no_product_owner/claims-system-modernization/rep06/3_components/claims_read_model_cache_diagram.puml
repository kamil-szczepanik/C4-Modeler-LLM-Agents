@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Read Model & Cache container

Container_Boundary("Claims Read Model & Cache", "Claims Read Model & Cache") {
    Component("Read Model Synchronizer", "Read Model Synchronizer", "Azure Function, Node.js/TypeScript", "Serverless compute for event processing with automatic scaling based on Event Hubs lag.")
    Component("Materialized View Store", "Materialized View Store", "Azure Cosmos DB, SQL API", "Low-latency materialized views of insurance claims ensuring sub-2-second adjuster screen loads.")
    Component("Integration & Sync Engine", "Integration & Sync Engine", "Azure Event Hubs", "Handles integration and synchronization events from the legacy mainframe system.")
    Component("Adjuster Workspace Backend", "Adjuster Workspace Backend", "Azure Managed Identities & RBAC / HTTPS", "Backend supporting the Adjuster Workspace accessing materialized views.")
}

Rel("Integration & Sync Engine", "Read Model Synchronizer", "AMQP", "")
Rel("Read Model Synchronizer", "Materialized View Store", "HTTPS / Cosmos SDK", "")
Rel("Adjuster Workspace Backend", "Materialized View Store", "HTTPS / Cosmos SDK", "")
@enduml