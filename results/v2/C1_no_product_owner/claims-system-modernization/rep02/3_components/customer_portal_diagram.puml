@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Customer Portal container

Container_Boundary(Customer_Portal, "Customer Portal") {
    Component(Authentication_Component, "Authentication Component", "MSAL.js / OpenID Connect", "Integrates SSO with Active Directory and provides Bearer tokens.")
    Component(Claim_Submission_UI_Component, "Claim Submission UI Component", "React Components", "Enables secure online claim submissions for customers and brokers.")
    Component(API_Client_Component, "API Client Component", "Axios/Fetch", "Handles API calls and submits claim data to the API Gateway.")
    Component(Telemetry___Error_Boundary_Component, "Telemetry & Error Boundary Component", "Application Insights React SDK", "Captures client-side exceptions and performance metrics, reporting errors and telemetry.")
}

System_Ext(API_Gateway, "API Gateway", "External API Gateway system")

Rel(Claim_Submission_UI_Component, API_Client_Component, "Invoke API calls", "In-memory / JS")
Rel(API_Client_Component, API_Gateway, "Submit claim data", "HTTPS/JSON")
Rel(Claim_Submission_UI_Component, Telemetry___Error_Boundary_Component, "Report errors/telemetry", "In-memory / JS")
Rel(Authentication_Component, API_Client_Component, "Provide Bearer token", "In-memory / JS")

@enduml