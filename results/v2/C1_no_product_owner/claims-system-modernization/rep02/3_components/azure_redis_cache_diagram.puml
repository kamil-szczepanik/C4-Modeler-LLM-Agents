@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Azure Redis Cache", "Azure Redis Cache") {
    Component("Redis Master-Replica Engine", "Redis Master-Replica Engine", "Redis Enterprise (Premium Tier P1)", "Provides master-replica high availability, VNet integration, and persistent memory caching to satisfy sub-second latency requirements.")
    Component("Session Cache Manager", "Session Cache Manager", "RESP Protocol / TLS", "Caches user session data and materialized claim views for fast retrieval by the Adjuster Backend Service.")
}

Rel("Session Cache Manager", "Redis Master-Replica Engine", "Persists cached data and replicates state")

@enduml