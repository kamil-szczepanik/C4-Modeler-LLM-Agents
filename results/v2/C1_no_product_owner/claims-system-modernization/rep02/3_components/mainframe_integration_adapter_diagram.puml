@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Mainframe Integration Adapter container

Container_Boundary(MainframeIntegrationAdapter, "Mainframe Integration Adapter") {
    Component(AdapterAPIController, "Adapter API Controller", "Spring Boot, REST", "Receives requests from the adjuster backend service and handles internal API routing.")
    Component(MainframeTranslationEngine, "Mainframe Translation Engine", "Java, Apache Camel", "Translates modern data models into legacy formats like fixed-width EBCDIC/COBOL copybooks.")
    Component(LegacyProtocolGateway, "Legacy Protocol Gateway", "TCP/IP with mTLS", "Provides secure legacy transport to the mainframe using TCP over mTLS via VPN/ExpressRoute.")
    Component(IntegrationQueueRouter, "Integration Queue Router", "Spring Integration / Azure Service Bus SDK", "Manages asynchronous event-driven dispatch and message routing.")
    Component(AzureKeyVault, "Azure Key Vault", "Azure Key Vault", "Provides dynamic certificate injection via Managed Identity.")
    Component(AzureMonitorMicrosoftSentinel, "Azure Monitor / Microsoft Sentinel", "Azure Monitor", "Handles telemetry and audit streaming over HTTPS.")
}

Rel(AdapterAPIController, IntegrationQueueRouter, "Asynchronous handover", "AMQP")
Rel(AdapterAPIController, MainframeTranslationEngine, "In-memory validation", "Java")
Rel(IntegrationQueueRouter, MainframeTranslationEngine, "Event-driven dispatch", "Internal")
Rel(MainframeTranslationEngine, LegacyProtocolGateway, "Internal routing", "Direct")
Rel(MainframeIntegrationAdapter, AzureKeyVault, "Dynamic certificate injection", "Managed Identity")
Rel(MainframeIntegrationAdapter, AzureMonitorMicrosoftSentinel, "Telemetry and audit streaming", "HTTPS")

@enduml