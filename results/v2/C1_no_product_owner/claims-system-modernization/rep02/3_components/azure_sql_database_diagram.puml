@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure SQL Database container

Container_Boundary(azure_sql_database, "Azure SQL Database") {
    Component(Claim_Entity_Store, "Claim Entity Store", "Relational Tables, Temporal Tables, Azure SQL Database", "Stores insurance claims data with relational tables and temporal tables for point-in-time auditing and rollbacks.")
    Component(Migration_Audit_Sync_Component, "Migration & Audit Sync Component", "SQL Stored Procedures, Change Data Capture", "Tracks data changes for migration synchronization and reconciliation, reading and writing audit logs and temporal history.")
}

Rel(Migration_Audit_Sync_Component, Claim_Entity_Store, "Reads/writes audit logs and temporal history", "Internal SQL")

@enduml