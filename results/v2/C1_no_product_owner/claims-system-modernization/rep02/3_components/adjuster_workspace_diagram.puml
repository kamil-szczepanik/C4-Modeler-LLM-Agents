@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(ClaimsAdjusters, "Claims Adjusters", "Users who manage claims securely.")

System_Boundary(AdjusterWorkspace, "Adjuster Workspace") {
    Component(WorkspaceUIShell, "Workspace UI Shell", "React, TypeScript", "Provides the user interface for claims adjusters to manage claims securely.")
    Component(ClaimProcessingController, "Claim Processing Controller", "Node.js, Express", "Handles REST API calls and coordinates claim data processing.")
    Component(DistributedCacheClient, "Distributed Cache Client", "Node.js Redis client", "Manages read/write operations for claim view models with TTL.")
    Component(CircuitBreakerFallbackManager, "Circuit Breaker / Fallback Manager", "Opossum", "Manages downstream mainframe latency spikes to guarantee UI responsiveness.")
    Component(AdjusterBackendService, "Adjuster Backend Service", "Java, Spring Boot, ACL", "Fetches and updates claim data bridging the hybrid architecture.")
}

System_Ext(AzureRedisCache, "Azure Redis Cache", "Azure Redis Cache", "Centralized external caching with TLS and managed identity for sub-2s claim screen rendering.")

Rel(ClaimsAdjusters, WorkspaceUIShell, "Interacts to manage claims", "HTTPS")
Rel(WorkspaceUIShell, ClaimProcessingController, "REST API calls", "HTTPS/JSON")
Rel(ClaimProcessingController, AdjusterBackendService, "Fetches/updates claim data", "REST/HTTPS/mTLS")
Rel(ClaimProcessingController, DistributedCacheClient, "Read/Write claim view models", "Redis Protocol/TLS")
Rel(DistributedCacheClient, AzureRedisCache, "External caching with TTL", "Redis Protocol/TLS")

@enduml