@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Key Vault container

System_Ext(Adjuster Backend Service, "Adjuster Backend Service", "External system interacting with the container")
System_Ext(Mainframe Integration Adapter, "Mainframe Integration Adapter", "External system interacting with the container")
System_Ext(SIEM, "SIEM", "External monitoring and log analysis system")

Container_Boundary(Azure Key Vault, "Azure Key Vault") {
    Component(Secrets Management Component, "Secrets Management Component", "Azure Key Vault Secrets", "Stores connection strings and API keys for the Adjuster Backend Service and Azure SQL Database.")
    Component(Certificates Management Component, "Certificates Management Component", "Azure Key Vault Certificates", "Manages non-exportable mTLS certificates for the Mainframe Integration Adapter.")
    Component(Access Policy / RBAC Engine, "Access Policy / RBAC Engine", "Azure RBAC & Managed Identities", "Enforces least-privilege access using Azure Managed Identities and Azure RBAC roles.")
    Component(Network Ingress Layer, "Network Ingress Layer", "Azure Private Endpoint", "Secures traffic via Azure Private Endpoint with public internet access disabled.")
    Component(Audit & Monitoring Module, "Audit & Monitoring Module", "Azure Diagnostics / SIEM", "Streams diagnostic logs to a SIEM and monitors throttling metrics.")
}

Rel(Adjuster Backend Service, Secrets Management Component, "Fetches DB credentials and API keys", "HTTPS over Private Link / Azure Managed Identity")
Rel(Mainframe Integration Adapter, Certificates Management Component, "Retrieves mTLS client certificates", "HTTPS over Private Link / Azure Managed Identity")
Rel(Azure Key Vault, SIEM, "Streams AuditEvent logs in real-time", "Azure Diagnostics")

@enduml