@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(adjuster_backend_service, "Adjuster Backend Service") {
    Component(Claims_Controller, "Claims Controller", "Spring MVC / REST API", "Handles and exposes adjuster operations via REST/HTTPS over TLS 1.3.")
    Component(Claims_Domain_Service, "Claims Domain Service", "Java / Spring Boot", "Contains business logic for processing claim data and managing domain operations.")
    Component(Mainframe_ACL_Adapter, "Mainframe ACL Adapter", "Legacy translation layer", "Acts as an Anti-Corruption Layer to bridge cloud-native components with the legacy mainframe system.")
    Component(Persistence_Repository, "Persistence Repository", "Spring Data JPA", "Persists and retrieves claim data from the persistent storage database.")
    Component(Messaging_Publisher, "Messaging Publisher", "Azure Service Bus integration", "Emits asynchronous domain events via AMQP to ensure zero claim loss.")
    Component(Cache_Manager_Component, "Cache Manager Component", "Azure Redis Cache interface", "Reads and writes transient claim views to reduce load times.")
}

Rel(Claims_Controller, Claims_Domain_Service, "Delegates request processing")
Rel(Claims_Domain_Service, Persistence_Repository, "Persists and retrieves claim data", "Spring Data JPA / TDS")
Rel(Claims_Domain_Service, Cache_Manager_Component, "Reads/writes transient claim views", "Redis Protocol")
Rel(Claims_Domain_Service, Messaging_Publisher, "Emits asynchronous domain events", "AMQP")
Rel(Mainframe_ACL_Adapter, Claims_Domain_Service, "Bridges legacy mainframe data to domain models")

@enduml