@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(Azure_API_Management_APIM, "Azure API Management (APIM)", "Azure API Management PaaS", "Fully managed PaaS API Gateway enforcing security, routing, JWT validation, rate limiting, and WAF.")
    Component(Identity_Provider, "Identity Provider", "OAuth2/OIDC", "Validates OAuth2/OIDC tokens for incoming requests.")
    Component(Adjuster_Backend_Service, "Adjuster Backend Service", "Azure Container Apps", "Internal Azure Container Apps handling business logic.")
    Component(Mainframe_Integration_Adapter, "Mainframe Integration Adapter", "Azure Container Apps", "Internal Azure Container Apps handling communication and routing unmigrated traffic to the legacy mainframe.")
}

Rel(Azure_API_Management_APIM, Identity_Provider, "Validates OAuth2/OIDC tokens", "OAuth2/OIDC")
Rel(Azure_API_Management_APIM, Adjuster_Backend_Service, "Forwards requests with injected user claims", "HTTPS/mTLS")
Rel(Azure_API_Management_APIM, Mainframe_Integration_Adapter, "Routes unmigrated traffic", "HTTPS/mTLS")

@enduml