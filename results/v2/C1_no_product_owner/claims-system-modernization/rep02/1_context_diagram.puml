@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers_and_Brokers, "Customers and Brokers", "Users who submit and manage online insurance claims.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal staff who interact with the new insurance platform web UI to process claims.")

System(Hybrid_Cloud_Insurance_Claims_Modernization_Platform, "Hybrid Cloud Insurance Claims Modernization Platform", "A hybrid cloud insurance claims modernization platform that gradually replaces a 30-year-old mainframe while ensuring continuous operations, enabling modern online submissions and adjuster workflows.")

System_Ext(Legacy_Mainframe, "Legacy Mainframe", "On-premises COBOL/DB2 system of record.")
System_Ext(Identity_Provider, "Identity Provider", "On-premises Active Directory / Entra ID providing OIDC/SAML authentication.")
System_Ext(Notification_Service, "Notification Service", "External SaaS used for sending notifications.")

Rel(Customers_and_Brokers, Hybrid_Cloud_Insurance_Claims_Modernization_Platform, "Online claim submissions", "HTTPS/REST")
Rel(Claims_Adjusters, Hybrid_Cloud_Insurance_Claims_Modernization_Platform, "Web UI interactions with anti-corruption layer", "HTTPS")
Rel(Hybrid_Cloud_Insurance_Claims_Modernization_Platform, Legacy_Mainframe, "Asynchronous messaging and data synchronization", "MQ Gateway with mTLS")
Rel(Hybrid_Cloud_Insurance_Claims_Modernization_Platform, Identity_Provider, "Authentication and token propagation", "OIDC/SAML, OAuth2/JWT")
Rel(Hybrid_Cloud_Insurance_Claims_Modernization_Platform, Notification_Service, "Sending notifications via dead-letter queues and circuit breakers", "HTTPS/API")

@enduml