@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(claims_core_container, "Claims Core Container") {
    Component(Claim_Intake_Controller, "Claim Intake Controller", "ASP.NET Core API", "Receives claim data and handles API requests.")
    Component(Claim_Workflow_Engine, "Claim Workflow Engine", "MassTransit / .NET", "Orchestrates claim processing and routes messages.")
    Component(Legacy_Anti_Corruption_Layer_ACL_Adapter, "Legacy Anti-Corruption Layer (ACL) Adapter", "IBM MQ", "Adapts and communicates with the legacy on-premise mainframe.")
    Component(Claim_Domain_Service, "Claim Domain Service", "C# / Domain-Driven Design", "Implements domain logic for claims using DDD.")
    Component(Data_Storage, "Data Storage", "Azure SQL Database", "Provides persistent transactional storage.")
}

Rel(Claim_Intake_Controller, Claim_Workflow_Engine, "Dispatches commands", "In-Memory / MediatR")
Rel(Claim_Workflow_Engine, Legacy_Anti_Corruption_Layer_ACL_Adapter, "Delegates unmigrated types", "AMQP / IBM MQ")
Rel(Claim_Workflow_Engine, Message_Broker, "Emits domain events", "AMQP")
Rel(Claim_Domain_Service, Data_Storage, "Reads/Writes domain state", "Entity Framework Core / TDS")
@enduml