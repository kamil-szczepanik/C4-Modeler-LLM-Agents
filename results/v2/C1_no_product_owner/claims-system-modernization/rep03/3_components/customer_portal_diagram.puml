@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(CustomersAndBrokers, "Customers & Brokers", "Users who submit insurance claims online.")

System_Boundary(CustomerPortalContainer, "Customer Portal") {
    Component(CustomerPortal, "Customer Portal", "React SPA / Azure Static Web Apps / CDN", "Provides a modern React-based web interface for customers and brokers to submit insurance claims online and serves static frontend assets.")
    Component(AuthenticationController, "Authentication Controller", "TypeScript / MSAL.js", "Authenticates users and acquires tokens using Auth Code Flow + PKCE and in-memory token management.")
    Component(ClaimSubmissionWizard, "Claim Submission Wizard", "React Component / Formik", "Guides users through claim submissions and submits claim payloads.")
    Component(DocumentUploaderComponent, "Document Uploader Component", "React", "Initiates file attachments and uploads binaries directly to storage.")
    Component(APIClientService, "API Client Service", "Axios / Fetch", "Handles HTTP/REST communication for submitting claim payloads.")
}

System_Ext(AzureStaticWebAppsCDN, "Azure Static Web Apps / CDN", "Azure Static Web Apps / CDN", "Serves static frontend assets.")
System_Ext(AzureActiveDirectory, "Azure Active Directory", "Azure Active Directory", "Authenticates users and acquires tokens.")
System_Ext(AzureBlobStorage, "Azure Blob Storage", "Azure Blob Storage", "Securely stores binary file attachments using pre-signed URLs.")

Rel(CustomersAndBrokers, CustomerPortal, "Interacts for online submissions", "HTTPS/REST")
Rel(AuthenticationController, AzureActiveDirectory, "Authenticates users and acquires tokens", "OpenID Connect / OAuth 2.0")
Rel(ClaimSubmissionWizard, APIClientService, "Submits claim payloads", "HTTPS/REST")
Rel(ClaimSubmissionWizard, DocumentUploaderComponent, "Initiates file attachments", "HTTPS")
Rel(DocumentUploaderComponent, AzureBlobStorage, "Uploads binaries directly", "HTTPS/PUT via Pre-signed URLs")
Rel(CustomerPortal, AzureStaticWebAppsCDN, "Serves static frontend assets", "HTTPS")

@enduml