@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(message_broker, "Message Broker") {
    Component(Outbound_Topic_Router, "Outbound Topic Router", "IBM MQ / AMQP", "Routes domain events and forwards legacy sync events between core services and integration layers.")
}

System_Ext(Azure_Monitor_Sentinel, "Azure Monitor / Sentinel", "Streams security audit logs [HTTPS]")
System_Ext(Integration_ACL_Container, "Integration & ACL Container", "Forwards legacy sync events [IBM MQ]")

Rel(Outbound_Topic_Router, Azure_Monitor_Sentinel, "Streams security audit logs", "HTTPS")
Rel(Outbound_Topic_Router, Integration_ACL_Container, "Forwards legacy sync events", "IBM MQ")

@enduml