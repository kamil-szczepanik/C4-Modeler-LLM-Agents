@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(integration_acl_container, "Integration & ACL Container") {
    Component(Mainframe_Adapter, "Mainframe Adapter", "IBM MQ with mTLS", "Adapts and secures communication between the cloud integration layer and the legacy mainframe.")
    Component(Anti_Corruption_Layer_ACL_, "Anti-Corruption Layer (ACL)", ".NET / C#", "Isolates legacy mainframe touchpoints and translates data models for the modern cloud platform.")
}

Rel(Mainframe_Adapter, Anti_Corruption_Layer_ACL_, "Translates and forwards messages")

@enduml