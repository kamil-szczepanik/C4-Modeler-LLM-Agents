@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(adjuster_read_database, "Adjuster Read Database") {
    Component(Cosmos_DB_SQL_API_Container, "Cosmos DB SQL API Container", "Azure Cosmos DB", "Azure Cosmos DB instance hosting the read model.")
    Component(Claims_Collection, "Claims Collection", "Azure Cosmos DB Container", "Cosmos DB Container partitioned by ClaimId for optimized query distribution.")
    Component(Audit_Collection, "Audit Collection", "Azure Cosmos DB Container", "Cosmos DB Container storing immutable change logs for tracing.")
    Component(Change_Feed_Processor, "Change Feed Processor", "Cosmos DB Change Feed", "Cosmos DB Change Feed for downstream auditing and triggers.")
    Component(Private_Endpoint, "Private Endpoint", "Azure Private Endpoint", "Azure Private Endpoint ensuring isolated network access.")
}

Rel(Read_Model_Projector, Claims_Collection, "Upserts denormalized documents", "Cosmos DB SDK / TCP")
Rel(API_Gateway, Claims_Collection, "Executes point-reads and queries", "Cosmos DB SDK / TCP")
Rel(Read_Model_Projector, Change_Feed_Processor, "Triggers event processing", "Cosmos DB Change Feed")
@enduml