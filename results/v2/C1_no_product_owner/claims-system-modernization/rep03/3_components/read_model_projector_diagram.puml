@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Read Model Projector container

Container_Boundary("Read Model Projector", "Read Model Projector") {
    Component(Event_Consumer_Component, "Event Consumer Component", "Azure Functions / .NET", "Pulls domain events with Checkpoint & Idempotency Filter.")
    Component(Projection_Handler_Component, "Projection Handler Component", ".NET Class Library", "Dispatches raw payloads and transforms read models.")
    Component(Database_Writer_Component, "Database Writer Component", ".NET / Cosmos DB SDK", "Persists state and secures private connectivity.")
}

Component(Message_Broker, "Message Broker", "IBM MQ", "Handles reliable enterprise messaging and event distribution.")
Component(Adjuster_Read_Database, "Adjuster Read Database", "Azure Cosmos DB", "Provides partitioned storage for adjuster screens.")

Rel(Message_Broker, Event_Consumer_Component, "Pulls domain events", "AMQP / IBM MQ")
Rel(Event_Consumer_Component, Projection_Handler_Component, "Dispatches raw payloads", "In-memory C# calls")
Rel(Projection_Handler_Component, Database_Writer_Component, "Sends transformed read models", "In-memory C# calls")
Rel(Database_Writer_Component, Adjuster_Read_Database, "Persists state and secures private connectivity", "HTTPS / Cosmos DB SDK over Private Endpoints")

@enduml