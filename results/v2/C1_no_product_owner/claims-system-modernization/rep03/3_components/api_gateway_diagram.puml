@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Authentication_Validator, "Authentication Validator", "Azure API Management Policy / OpenID Connect", "Validates JWT tokens against Azure Active Directory.")
    Component(Dynamic_Route_Orchestrator, "Dynamic Route Orchestrator", "Azure API Management Routing", "Routes frontend traffic to appropriate downstream containers.")
    Component(Rate_Limiter_Circuit_Breaker, "Rate Limiter & Circuit Breaker", "Azure API Management Policy", "Protects the fragile legacy mainframe and downstream services by enforcing rate limits and circuit breaker patterns.")
    Component(Claim_Type_Feature_Flag_Evaluator, "Claim-Type Feature Flag Evaluator", "Azure API Management Policy", "Evaluates claim-type feature flags to determine if requests should go to modern or legacy systems.")
}

Rel(Authentication_Validator, Dynamic_Route_Orchestrator, "Enforces security before routing", "HTTPS")
Rel(Dynamic_Route_Orchestrator, Rate_Limiter_Circuit_Breaker, "Checks limits and system health", "HTTPS")
Rel(Dynamic_Route_Orchestrator, Claim_Type_Feature_Flag_Evaluator, "Evaluates migration status for claims", "HTTPS")

@enduml