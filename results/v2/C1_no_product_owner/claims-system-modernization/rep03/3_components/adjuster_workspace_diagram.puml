@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Adjuster Workspace container

Container_Boundary(adjuster_workspace, "Adjuster Workspace") {
    Component(React_SPA_UI, "React SPA UI", "React", "Responsive user interface for claims adjusters to manage workflows and interact with the system.")
    Component(Authentication_Client, "Authentication Client", "OpenID Connect / OAuth 2.0 with PKCE", "Handles user authentication and security tokens via Azure Active Directory.")
    Component(API_Client, "API Client", "HTTPS/REST / TLS 1.3", "Routes state-changing intents and communicates with the API Gateway.")
    Component(Optimized_Read_Store_Client, "Optimized Read Store Client", "HTTPS", "Queries cached projections directly using ephemeral resource tokens.")
}

System_Ext(Azure_Cosmos_DB, "Azure Cosmos DB", "Provides low-latency storage for read projections to meet <2s load times.")

Rel(React_SPA_UI, Authentication_Client, "Authenticates users", "OpenID Connect / OAuth 2.0 with PKCE")
Rel(React_SPA_UI, API_Client, "Routes state-changing intents", "HTTPS/TLS 1.3")
Rel(Optimized_Read_Store_Client, Azure_Cosmos_DB, "Queries cached projections directly using ephemeral resource tokens", "HTTPS")

@enduml