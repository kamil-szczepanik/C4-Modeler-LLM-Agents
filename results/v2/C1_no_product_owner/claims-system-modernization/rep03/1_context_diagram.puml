@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers & Brokers, "Customers & Brokers", "External actors who submit online claims via the Web UI.")
Person(Claims Adjusters, "Claims Adjusters", "Internal actors who manage workflows using the platform.")

System(New Insurance Platform, "New Insurance Platform", "Modernizes a regional insurer's claims platform by gradually replacing a 30-year-old mainframe system with a cloud-native solution while maintaining hybrid operations.")

System_Ext(Legacy Mainframe, "Legacy Mainframe", "30-year-old COBOL/DB2 on-premises System of Record acting as the legacy backend.")
System_Ext(Azure Active Directory, "Azure Active Directory", "Enforces single sign-on (SSO) and hybrid identity management.")
System_Ext(Payment Gateway, "Payment Gateway", "External service handling financial transactions via REST/HTTPS.")
System_Ext(Notification Service, "Notification Service", "External service sending notifications via REST/HTTPS.")

Rel(Customers & Brokers, New Insurance Platform, "Interact for online submissions", "HTTPS / Web UI")
Rel(Claims Adjusters, New Insurance Platform, "Interact for internal workflows", "HTTPS")
Rel(New Insurance Platform, Legacy Mainframe, "Integrates via asynchronous messaging through Integration Gateway", "Asynchronous Messaging")
Rel(New Insurance Platform, Azure Active Directory, "Authenticates users via OpenID Connect / OAuth 2.1", "OpenID Connect / OAuth 2.1")
Rel(New Insurance Platform, Payment Gateway, "Communicates for processing payments", "REST/HTTPS APIs with mTLS")
Rel(New Insurance Platform, Notification Service, "Communicates for sending notifications", "REST/HTTPS APIs with mTLS")
@enduml