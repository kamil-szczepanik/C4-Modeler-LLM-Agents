@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Insurance Claims Modernization Platform

Person(Customers_and_Brokers, "Customers & Brokers", "External users submitting and checking claims.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal staff managing claims via a modern web application.")

System_Ext(Legacy_Mainframe_System, "Legacy Mainframe System", "On-premises COBOL/DB2 system of record.")
System_Ext(Active_Directory, "Active Directory", "Identity provider used for centralized single sign-on (SSO) and role-based access control.")

System_Boundary(Insurance_Claims_Modernization_Platform, "Insurance Claims Modernization Platform") {
    Container(Claims_Portal, "Claims Portal", "React on Azure App Service", "Web frontend ensuring <2s page load performance for users.")
    Container(Azure_API_Management, "Azure API Management", "Azure API Management (BFF)", "Acts as a Backend for Frontend (BFF) routing requests securely using OAuth 2.0 / OpenID Connect.")
    Container(Claims_Modernization_Core, "Claims Modernization Core", "Java Spring Boot on Azure Kubernetes Service", "Runs microservices for elastic scalability and blue/green deployments.")
    Container(Integration_and_Sync_Engine, "Integration & Sync Engine", "Azure Service Bus", "Manages asynchronous message queuing to decouple modern services from mainframe batch windows.")
    ContainerDb(State_Store, "State Store", "Azure SQL Database Managed Instance", "Provides transactional persistence and point-in-time recovery.")
}

Rel(Customers_and_Brokers, Claims_Portal, "Interacts with Claims Portal", "HTTPS / TLS 1.3")
Rel(Claims_Adjusters, Claims_Portal, "Interacts with Claims Portal", "HTTPS / TLS 1.3")
Rel(Claims_Portal, Azure_API_Management, "Routes requests through API Management", "OAuth 2.0 / OpenID Connect")
Rel(Azure_API_Management, Claims_Modernization_Core, "Forwards requests to core microservices", "HTTPS")
Rel(Claims_Modernization_Core, State_Store, "Communicates for transactional persistence", "TDS over TLS")
Rel(Claims_Modernization_Core, Integration_and_Sync_Engine, "Exchanges asynchronous messages", "Azure Service Bus")
Rel(Integration_and_Sync_Engine, Legacy_Mainframe_System, "Exchanges asynchronous messages with Legacy Mainframe", "IPsec VPN / ExpressRoute with mTLS")
Rel(Claims_Portal, Active_Directory, "Authenticates users", "OAuth 2.0 / OpenID Connect")

@enduml