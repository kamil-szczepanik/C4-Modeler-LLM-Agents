@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(CustomersAndBrokers, "Customers & Brokers", "External users submitting claims via HTTPS.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal staff managing claims via a modern web application.")
System(InsuranceClaimsModernizationPlatform, "Insurance Claims Modernization Platform", "A cloud-native system hosted in Azure that gradually replaces a 30-year-old mainframe claims system, maintaining hybrid operations while incrementally migrating claim types over a three-year period.")
System_Ext(LegacyMainframeSystem, "Legacy Mainframe System", "On-premises COBOL/DB2 system of record.")
System_Ext(ActiveDirectory, "Active Directory", "On-premises identity provider used for Single Sign-On.")

Rel(CustomersAndBrokers, InsuranceClaimsModernizationPlatform, "Submit claims", "HTTPS")
Rel(ClaimsAdjusters, InsuranceClaimsModernizationPlatform, "Manage claims via modern web application", "HTTPS")
Rel(InsuranceClaimsModernizationPlatform, LegacyMainframeSystem, "Interfaces for hybrid operations and asynchronous messaging", "Azure-to-On-Premises Hybrid Connection (VPN/ExpressRoute) using mTLS (TLS 1.3) and Azure Service Bus")
Rel(InsuranceClaimsModernizationPlatform, ActiveDirectory, "Federates for Single Sign-On", "OIDC/SAML")
@enduml