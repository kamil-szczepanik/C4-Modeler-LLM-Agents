@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(claims_modernization_core, "Claims Modernization Core") {
    Component(Claim_Ingestion_Component, "Claim Ingestion Component", "Spring MVC", "Handles incoming claim requests and validations.")
    Component(Migration_Router_Component, "Migration Router Component", "Spring Cloud Gateway / custom bean", "Routes claims to either modern processing or legacy integration based on migration rules.")
    Component(Legacy_Mainframe_Adapter_Component, "Legacy Mainframe Adapter Component", "Spring Integration / SOAP-over-HTTP with Resilience4j", "Adapts and communicates with the legacy mainframe system using SOAP over HTTP with resilience patterns.")
    Component(Claim_Management_Component, "Claim Management Component", "Spring Data JPA", "Manages modern claim data processing and persistence.")
    Component(Security_Policy_Component, "Security Policy Component", "RBAC/ABAC", "Enforces security policies and access controls.")
    Component(Outbox_Pattern_Component, "Outbox Pattern Component", "Outbox Pattern implementation", "Persists domain events transactionally before publishing.")
}

Rel(Claim_Ingestion_Component, Migration_Router_Component, "Forwards validated claims", "Internal Method Call")
Rel(Migration_Router_Component, Claim_Management_Component, "Processes modern claims", "Internal Method Call")
Rel(Migration_Router_Component, Legacy_Mainframe_Adapter_Component, "Routes to legacy", "Internal Method Call")
Rel(Claim_Management_Component, Outbox_Pattern_Component, "Persists domain events transactionally", "Internal Method Call")

@enduml