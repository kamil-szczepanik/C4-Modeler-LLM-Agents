@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Portal container

Container_Boundary(claims_portal, "Claims Portal") {
    Component(Frontend_UI, "Frontend UI", "React on Azure App Service", "Ensures responsive frontend performance and sub-2-second load times for customers, brokers, and claims adjusters.")
    Component(Authentication_Client, "Authentication Client", "OAuth 2.0 / OpenID Connect", "Handles secure user authentication and identity management via Active Directory.")
}

System_Ext(Azure_API_Management, "Azure API Management", "Manages secure API routing and acts as a backend-for-frontend layer")

Rel(Frontend_UI, Authentication_Client, "Authenticates users via", "OAuth 2.0 / OpenID Connect")
Rel(Frontend_UI, Azure_API_Management, "Sends API requests via", "OAuth 2.0 / OpenID Connect")

@enduml