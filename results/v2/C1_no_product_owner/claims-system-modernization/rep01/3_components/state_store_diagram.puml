@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(ClaimsModernizationCore, "Claims Modernization Core", "External core system interacting with the State Store.")
System_Ext(IntegrationSyncEngine, "Integration & Sync Engine", "External integration and sync engine.")

Container_Boundary(StateStore, "State Store") {
    Component(ClaimOperationalTable, "Claim Operational Table", "Azure SQL Relational Table", "Stores claim aggregates and operational data.")
    Component(SyncLedgerTable, "Sync Ledger Table", "Azure SQL Relational Table", "Maintains sync watermarks and ledger state.")
    Component(AuditFallbackLog, "Audit & Fallback Log", "Azure SQL Relational Table", "Records audit logs and fallback information.")
    Component(StoredProcedureGateway, "Stored Procedure Gateway", "Azure SQL Database mechanisms", "Provides database mechanisms for ACID compliance.")
    Component(TemporalTablesChangeTracking, "Temporal Tables / Change Tracking", "Native Azure SQL history retention", "Handles historical audits natively and supports rollbacks.")
    Component(ResourceGovernor, "Resource Governor", "Azure SQL Resource Governor", "CPU and memory throttling mechanism to isolate batch workloads.")
}

Rel(ClaimsModernizationCore, ClaimOperationalTable, "Read/Write claim aggregates", "ADO.NET / JDBC via TDS over TLS 1.3")
Rel(IntegrationSyncEngine, SyncLedgerTable, "Update sync watermarks", "ADO.NET / JDBC via TDS over TLS 1.3")
Rel(ClaimsModernizationCore, StateStore, "Authenticated via Azure AD Managed Identities", "Azure AD")

@enduml