@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration & Sync Engine container

Container_Boundary(integration_sync_engine, "Integration & Sync Engine") {
    Component(Sync_Orchestrator, "Sync Orchestrator", "Apache Camel on Azure Kubernetes Service", "Orchestrates synchronization workflows and message routing between services.")
    Component(Mainframe_Adapter, "Mainframe Adapter", "Apache Camel + IBM MQ Client on Azure Kubernetes Service", "Adapts and bridges modern message formats with legacy mainframe protocols.")
}

Rel(Sync_Orchestrator, Mainframe_Adapter, "gRPC/HTTP/2 over mTLS within Azure Kubernetes Service", "gRPC/HTTP/2")

@enduml