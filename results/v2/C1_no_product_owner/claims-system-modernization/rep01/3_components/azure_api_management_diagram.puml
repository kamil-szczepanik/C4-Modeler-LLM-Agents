@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure API Management container

Container_Boundary(azure_api_management, "Azure API Management") {
    Component(API_Gateway_BFF_Router, "API Gateway & BFF Router", "Azure API Management", "Acts as BFF and security gateway, routing requests using OAuth 2.0 / OpenID Connect and enforcing native XML policy fragments.")
    Component(Security_Policy_Enforcer, "Security Policy Enforcer", "Azure APIM XML Policy Fragments", "Applies native XML policies to avoid custom code, reducing operational overhead and enforcing mTLS.")
}

Rel(API_Gateway_BFF_Router, Security_Policy_Enforcer, "Applies security policies to", "")

@enduml