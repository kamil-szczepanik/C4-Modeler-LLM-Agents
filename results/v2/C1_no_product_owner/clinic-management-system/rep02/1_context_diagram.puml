@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patient, "Patient", "Interacts via Web/Mobile to manage appointments and view records.")
Person(ClinicianStaff, "Clinician/Staff", "Interacts via Secure Workstation to manage patient care, EMRs, and operations.")
System(ClinicManagementSystemCMS, "Clinic Management System (CMS)", "Manages patient admissions, EMRs, scheduling, and billing for healthcare providers.")
System_Ext(ExternalLabImagingSystems, "External Lab & Imaging Systems", "External systems providing laboratory and medical imaging data.")
System_Ext(PaymentGatewayInsuranceClearinghouse, "Payment Gateway / Insurance Clearinghouse", "External systems processing billing and insurance claims.")

Rel(Patient, ClinicManagementSystemCMS, "Interacts with CMS via web and mobile interfaces", "HTTPS (TLS 1.3, OIDC, MFA)")
Rel(ClinicianStaff, ClinicManagementSystemCMS, "Accesses CMS from secure workstations", "HTTPS (TLS 1.3, OIDC, MFA)")
Rel(ClinicManagementSystemCMS, ExternalLabImagingSystems, "Integrates for clinical data exchange", "HL7 FHIR RESTful APIs over mTLS")
Rel(ClinicManagementSystemCMS, PaymentGatewayInsuranceClearinghouse, "Processes payments and insurance claims", "HTTPS REST/SOAP APIs")
@enduml