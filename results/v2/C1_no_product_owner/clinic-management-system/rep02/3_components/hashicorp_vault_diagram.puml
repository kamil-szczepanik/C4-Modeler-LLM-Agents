@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the HashiCorp Vault container

System_Ext(emr_core_service, "EMR Core Service", "External EMR Core Service interacting with Vault")
System_Ext(vault_nodes, "Vault Nodes", "External Vault cluster nodes")
System_Ext(vault_nodes_raft, "Vault Nodes (Raft)", "External Vault Raft peer nodes")
System_Ext(worm_s3, "WORM-compliant S3 / MinIO", "External secure storage for audit logs")

Container_Boundary(hashicorp_vault, "HashiCorp Vault") {
    Component(Secrets_Engine_Component, "Secrets Engine Component", "HashiCorp Vault Engine", "Manages secrets and sensitive data storage.")
    Component(Auth_Method_Component, "Auth Method Component", "HashiCorp Vault Auth", "Handles authentication and identity verification.")
    Component(Audit_Device_Component, "Audit Device Component", "HashiCorp Vault Audit", "Maintains immutable audit logs of interactions.")
    Component(Transit_Secrets_Engine_Component, "Transit Secrets Engine Component", "HashiCorp Vault Transit", "Provides cryptographic operations as a service.")
    Component(Raft_Storage_Manager_Component, "Raft Storage Manager Component", "Integrated Raft Storage", "Manages distributed consensus and encrypted state replication.")
}

Rel(emr_core_service, Auth_Method_Component, "Authenticates via HTTPS/REST (JWT/Token) over mTLS", "HTTPS/REST / mTLS")
Rel(emr_core_service, Transit_Secrets_Engine_Component, "Requests cryptographic operations via mTLS/HTTPS", "mTLS/HTTPS")
Rel(vault_nodes, vault_nodes_raft, "Replicates encrypted state via mTLS gRPC/TCP", "mTLS gRPC/TCP")
Rel(Audit_Device_Component, worm_s3, "Streams immutable audit logs via HTTPS", "HTTPS")

@enduml