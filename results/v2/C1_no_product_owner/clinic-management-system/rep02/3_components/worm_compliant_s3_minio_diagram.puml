@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the WORM-compliant S3 / MinIO container

Component(EMR_Core_Service, "EMR Core Service", "S3 API over TLS 1.3", "External service that uploads and reads encrypted medical objects.")
Component_Ext(AWS_S3, "AWS S3", "External AWS S3 (eu-central-1)", "External storage destination for cross-site replication of immutable payloads.")
Component_Ext(HashiCorp_Vault, "HashiCorp Vault", "Vault Transit Secrets Engine API over HTTPS", "Provides dynamic KMS keys for encryption.")

Container_Boundary(WORM_compliant_S3_MinIO, "WORM-compliant S3 / MinIO") {
    Component(Object_Storage_Engine, "Object Storage Engine", "MinIO Server in Erasure Coding mode", "Provides secure, highly available, and immutable object storage for electronic medical records and medical imaging files.")
    Component(Object_Locking_Retention_Manager, "Object Locking & Retention Manager", "AWS-compatible Object Lock in COMPLIANCE mode", "Enforces immutable 10-year data retention to prevent deletion or tampering.")
    Component(IAM_Policy_Enforcer, "IAM & Policy Enforcer", "MinIO IAM / Open Policy Agent with HashiCorp Vault", "Manages identity, access policies, and integrates with Vault for security controls.")
    Component(Replication_Tiering_Controller, "Replication & Tiering Controller", "MinIO Replication & Lifecycle Engine", "Handles cross-site replication and lifecycle management for hybrid multi-site deployments.")
}

Rel(EMR_Core_Service, Object_Locking_Retention_Manager, "Uploads and reads encrypted medical objects", "S3 API over TLS 1.3")
Rel(Object_Storage_Engine, AWS_S3, "Replicates immutable payloads", "S3 API over TLS 1.3 (Cross-Site Replication)")
Rel(IAM_Policy_Enforcer, HashiCorp_Vault, "Fetches dynamic KMS keys", "Vault Transit Secrets Engine API over HTTPS")

@enduml