@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the EMR Core Service container

Container_Boundary(emr_core_service, "EMR Core Service") {
    Component(EMR Rest Controller Layer, "EMR Rest Controller Layer", "Spring MVC, gRPC, OAuth2/JWT", "Handles REST/gRPC endpoints, input validation, and OAuth2/JWT security context.")
    Component(Clinical Record Manager, "Clinical Record Manager", "Spring Service, Resilience4j", "Contains core domain logic, utilizing resilience4j circuit breakers and HashiCorp Vault.")
    Component(Audit Trail Engine, "Audit Trail Engine", "Spring AOP, Spring WebFlux", "Reactive outbox processor and cryptographic signing pipeline for audit trails.")
    Component(Data Access Repository, "Data Access Repository", "Spring Data JPA, Hibernate, PostgreSQL", "Data access interface utilizing PostgreSQL read-replicas.")
}

System_Ext(HashiCorp_Vault, "HashiCorp Vault", "Manages encryption keys and dynamic secrets for field-level PHI protection.")
System_Ext(Kafka_RabbitMQ, "Kafka/RabbitMQ", "Decouples services to guarantee non-blocking audit logging and high availability.")
System_Ext(WORM_compliant_S3_MinIO, "WORM-compliant S3 / MinIO", "Provides immutable object storage meeting the 10-year data retention mandate.")

Rel(EMR Rest Controller Layer, Clinical Record Manager, "In-process method calls", "Java/Spring Beans")
Rel(Clinical Record Manager, Data Access Repository, "Encrypted SQL queries", "Encrypted SQL")
Rel(Clinical Record Manager, HashiCorp_Vault, "Dynamic secret retrieval", "HTTPS/TLS 1.3 with Istio/SPIFFE workload identity")
Rel(Audit Trail Engine, Kafka_RabbitMQ, "Asynchronous event publishing", "TLS 1.3")
Rel(Audit Trail Engine, WORM_compliant_S3_MinIO, "Immutable audit log archival", "HTTPS/TLS 1.3")

@enduml