@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Istio container

Container_Boundary(istio, "Istio") {
    Component(istiod_control_plane, "Istiod (Control Plane)", "Go", "Manages configuration, cert issuance, and xDS policy pushes.")
    Component(istio_cni_plugin, "Istio CNI Plugin", "Kubernetes CNI", "Manages pod network redirection without privileged init containers.")
    Component(envoy_sidecar_proxies, "Envoy Sidecar Proxies", "Envoy C++", "Injected alongside microservices for traffic management and telemetry.")
    Component(east_west_gateway, "East-West Gateway", "Envoy Gateway", "Handles cross-network mTLS and service discovery between hybrid clusters.")
    Component(telemetry_provider, "Telemetry Provider", "Prometheus, OpenTelemetry Collector", "Aggregates metrics and distributed traces.")
}

Rel(istiod_control_plane, envoy_sidecar_proxies, "Configures via gRPC (xDS API)", "gRPC")
Rel(envoy_sidecar_proxies, envoy_sidecar_proxies, "Enforces mTLS between internal microservices via Mutual TLS over TCP", "Mutual TLS over TCP")
Rel(envoy_sidecar_proxies, east_west_gateway, "Route cross-cluster traffic through via mTLS over TCP", "mTLS over TCP")
Rel(envoy_sidecar_proxies, telemetry_provider, "Export metrics and traces via OTLP / gRPC (TLS encrypted)", "OTLP / gRPC")

@enduml