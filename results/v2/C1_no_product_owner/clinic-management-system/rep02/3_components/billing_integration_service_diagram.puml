@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(billing_integration_service, "Billing & Integration Service") {
    Component(api_router, "API Router", "Python / FastAPI", "Routes incoming REST/gRPC traffic.")
    Component(fhir_translation_engine, "FHIR Translation Engine", "Python, Pydantic & SQLAlchemy", "Validates and translates payloads to HL7 FHIR.")
    Component(payment_claims_processor, "Payment & Claims Processor", "Python / FastAPI", "Processes claims and payments asynchronously.")
    Component(integration_event_publisher, "Integration Event Publisher", "Python, Kafka / RabbitMQ / NATS client", "Publishes and consumes events using DLQs.")
    Component(billing_data_access_repository, "Billing Data Access Repository", "SQLAlchemy", "Manages database operations with the relational store.")
}

Rel(api_router, fhir_translation_engine, "Forwards requests for FHIR validation", "Pydantic")
Rel(fhir_translation_engine, payment_claims_processor, "Passes validated payloads for processing")
Rel(payment_claims_processor, integration_event_publisher, "Dispatches asynchronous events", "TLS 1.3")
Rel(payment_claims_processor, billing_data_access_repository, "Reads and writes relational data", "Encrypted SQL connections")
@enduml