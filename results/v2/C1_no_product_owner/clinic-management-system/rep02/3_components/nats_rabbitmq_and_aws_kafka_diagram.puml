@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(nats_rabbitmq_aws_kafka, "NATS / RabbitMQ and AWS Kafka") {
    Component(AWS_MSK, "AWS MSK", "Apache Kafka", "Cloud-based event broker handling high-throughput event streaming and cross-site data replication in AWS.")
    Component(Strimzi, "Strimzi", "Apache Kafka on Kubernetes", "On-premise event broker handling high-throughput event streaming in local Kubernetes clusters.")
    Component(Confluent_Schema_Registry, "Confluent Schema Registry", "Schema Registry", "Enforces strict Avro/Protobuf data governance and prevents breaking API changes.")
    Component(Kafka_MirrorMaker_2, "Kafka MirrorMaker 2", "MirrorMaker 2", "Handles cross-site data replication between on-premise Strimzi Kafka and AWS MSK.")
}

Rel(Strimzi, AWS_MSK, "Cross-site data replication", "Kafka MirrorMaker 2 over TLS 1.3 and IPsec/WireGuard")
Rel(AWS_MSK, Confluent_Schema_Registry, "Validates event schemas", "HTTPS over TLS 1.3")
Rel(Strimzi, Confluent_Schema_Registry, "Validates event schemas", "HTTPS over TLS 1.3")

@enduml