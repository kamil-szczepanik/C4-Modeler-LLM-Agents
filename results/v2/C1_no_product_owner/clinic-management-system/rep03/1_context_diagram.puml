@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patient, "Patient", "Interacts with the system for scheduling and managing healthcare appointments and records.")
Person(Clinician, "Clinician", "Accesses and manages electronic medical records and patient admissions.")
Person(Receptionist, "Receptionist", "Manages scheduling and patient admissions.")
Person(Billing Specialist, "Billing Specialist", "Handles billing and financial transactions.")

System(Clinic Management System, "Clinic Management System", "A hybrid cloud platform designed for medium-sized hospitals and clinics to securely manage patient admissions, electronic medical records, scheduling, and billing with high availability, stringent compliance, and robust interoperability.")

System_Ext(Third-Party Payment Gateway, "Third-Party Payment Gateway", "External service for processing payments.")
System_Ext(External Lab & Imaging Systems, "External Lab & Imaging Systems", "External systems providing laboratory and imaging results via HL7 FHIR.")
System_Ext(Insurance Clearinghouse, "Insurance Clearinghouse", "External service for verifying and processing insurance claims.")
System_Ext(Enterprise IdP, "Enterprise IdP", "External identity provider for authentication and user management.")

Rel(Patient, Clinic Management System, "Connects to manage healthcare records and scheduling", "HTTPS/REST, OAuth2/OIDC with MFA")
Rel(Clinician, Clinic Management System, "Accesses medical records and patient information", "HTTPS/REST, OAuth2/OIDC with MFA")
Rel(Receptionist, Clinic Management System, "Manages front-desk admissions and appointments", "HTTPS/REST, OAuth2/OIDC with MFA")
Rel(Billing Specialist, Clinic Management System, "Processes patient billing and payments", "HTTPS/REST, OAuth2/OIDC with MFA")
Rel(External Lab & Imaging Systems, Clinic Management System, "Integrates lab and imaging data", "HL7 FHIR over HTTPS")
Rel(Third-Party Payment Gateway, Clinic Management System, "Processes financial transactions", "REST/SFTP")
Rel(Insurance Clearinghouse, Clinic Management System, "Handles insurance claims processing", "REST/SFTP")

@enduml