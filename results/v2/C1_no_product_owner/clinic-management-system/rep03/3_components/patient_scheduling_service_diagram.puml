@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container(api_gateway, "API Gateway", "gRPC / mTLS", "Routes internal API requests via gRPC over mTLS using SPIFFE/SPIRE.")
ContainerDb(cockroachdb, "CockroachDB", "PostgreSQL wire protocol / TLS 1.3", "Provides distributed, highly available SQL data persistence.")
Container(rabbitmq, "RabbitMQ", "AMQP 0-9-1", "Asynchronous message broker for decoupled event-driven workflows.")
Container(hashicorp_vault, "HashiCorp Vault", "HTTPS / TLS 1.3", "Secures PHI via field-level encryption and manages credential lifecycle.")

Container_Boundary(patient_scheduling_service, "Patient & Scheduling Service") {
    Component(patient_registry_component, "Patient Registry Component", "Fastify / TypeScript", "Manages demographic capture and Zod input validation.")
    Component(scheduling_engine_component, "Scheduling Engine Component", "Fastify / TypeScript", "Handles temporal and spatial resource clash checks with in-memory indexing.")
    Component(secrets_encryption_component, "Secrets & Encryption Component", "Fastify Plugin", "Integrates HashiCorp Vault for field-level PHI encryption and automated key rotation.")
    Component(event_dispatcher_component, "Event Dispatcher Component", "Dedicated Wrapper", "Isolates RabbitMQ AMQP messaging from domain logic.")
    Component(audit_compliance_interceptor, "Audit & Compliance Interceptor", "Fastify Middleware", "Writes cryptographically hashed, immutable audit logs to a WORM sink.")
}

Rel(api_gateway, patient_scheduling_service, "Routes internal API requests", "gRPC over mTLS")
Rel(patient_registry_component, cockroachdb, "Reads and writes state", "PostgreSQL wire protocol / TLS 1.3")
Rel(scheduling_engine_component, cockroachdb, "Reads and writes state", "PostgreSQL wire protocol / TLS 1.3")
Rel(event_dispatcher_component, rabbitmq, "Publishes envelope-encrypted appointment events", "AMQP 0-9-1")
Rel(secrets_encryption_component, hashicorp_vault, "Fetches encryption keys and secrets", "HTTPS / TLS 1.3")

@enduml