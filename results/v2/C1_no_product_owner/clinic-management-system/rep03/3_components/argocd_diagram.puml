@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the ArgoCD container

System_Ext(on_prem_k8s_and_eu_central_1_clusters, "on-prem-k8s and eu-central-1 clusters", "Kubernetes clusters")
System_Ext(Enterprise_IdP, "Enterprise IdP", "Identity Provider")

Container_Boundary(ArgoCD, "ArgoCD") {
    Component(API_Server, "API Server", "Go", "Manages Web UI, CLI, webhook receivers, and OIDC/MFA authentication.")
    Component(Repository_Server, "Repository Server", "Go", "Clones Git repositories and renders Helm charts without caching unencrypted data.")
    Component(Application_Controller, "Application Controller", "Go", "Core reconciliation engine executing state synchronization with Kubernetes API servers.")
    Component(Redis_Cache, "Redis Cache", "Redis", "In-memory data store providing HA state caching and session management.")
    Component(HashiCorp_Vault, "HashiCorp Vault", "HashiCorp Vault", "Secure secret management and dynamic runtime decryption provider.")
}

Rel(API_Server, Repository_Server, "Commands", "Internal gRPC")
Rel(API_Server, Application_Controller, "Commands", "Internal gRPC")
Rel(API_Server, Redis_Cache, "Interacts", "TCP/TLS")
Rel(Application_Controller, Redis_Cache, "Interacts", "TCP/TLS")
Rel(Application_Controller, on_prem_k8s_and_eu_central_1_clusters, "Communicates", "HTTPS/Kubernetes API")
Rel(API_Server, Enterprise_IdP, "Delegates user authentication", "HTTPS/OIDC")
Rel(Repository_Server, HashiCorp_Vault, "Integrates", "runtime secret injection")
@enduml