@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(vault, "HashiCorp Vault") {
    Component(Secrets Engine, "Secrets Engine", "HashiCorp Vault KV/Database Secrets Engines", "Manages and provides dynamic credentials and data encryption.")
    Component(Auth Methods, "Auth Methods", "HashiCorp Vault AppRole, Kubernetes Auth", "Handles client authentication and mTLS token acquisition.")
    Component(Audit Log, "Audit Log", "HashiCorp Vault Audit Component", "Tracks and exports system audit logs for SIEM ingestion.")
    Component(Storage Backend Integration, "Storage Backend Integration", "HashiCorp Vault Raft storage, AWS KMS/HSM auto-unseal", "Manages persistent encrypted storage and disaster recovery snapshots.")
}

Rel(Auth Methods, Secrets Engine, "Grants access after authentication")
Rel(Audit Log, Storage Backend Integration, "Persists audit data")
@enduml