@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Component(emr_service, "EMR Service", "Container", "Application service handling electronic medical records.")
Component(billing_service, "Billing Service", "Container", "Application service handling financial claims and billing.")
Component(scheduling_service, "Scheduling Service", "Container", "Application service handling patient appointments and schedules.")
Component(opentelemetry_collector, "OpenTelemetry Collector", "OpenTelemetry", "Collects metrics and streams audit logs for compliance.")
Component(hashicorp_vault, "HashiCorp Vault", "HashiCorp Vault / PKI", "Provides automated certificate rotation and AES-256 key management.")

System_Boundary(cockroachdb, "CockroachDB") {
    Component(sql_layer, "SQL Layer", "Go", "Go-based parser, planner, and executor for distributed SQL.")
    Component(transaction_engine, "Transaction Engine", "MVCC & Raft consensus", "ACID transaction manager ensuring data consistency and consensus.")
    Component(storage_engine, "Storage Engine", "RocksDB", "Embedded key-value store managing local disk persistence.")
    Component(dist_sql, "Dist_SQL", "Distributed execution engine", "Distributed execution engine for parallelized queries.")
}

Rel(emr_service, sql_layer, "Connects via PostgreSQL wire protocol over TLS 1.3", "PostgreSQL wire protocol / TLS 1.3")
Rel(billing_service, sql_layer, "Connects via PostgreSQL wire protocol over TLS 1.3", "PostgreSQL wire protocol / TLS 1.3")
Rel(scheduling_service, sql_layer, "Connects via PostgreSQL wire protocol over TLS 1.3", "PostgreSQL wire protocol / TLS 1.3")
Rel(sql_layer, transaction_engine, "Executes ACID transactions using", "Internal")
Rel(transaction_engine, storage_engine, "Persists data using", "RocksDB API")
Rel(sql_layer, dist_sql, "Offloads parallelized queries to", "Internal")
Rel(opentelemetry_collector, sql_layer, "Scrapes metrics and audit logs from", "Telemetry API")
Rel(hashicorp_vault, sql_layer, "Integrates via PKI engine for automated certificate rotation and encryption", "PKI / mTLS")

@enduml