@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the RabbitMQ container

System_Ext(Billing_Claims_Service, "Billing & Claims Service", "External service publishing events")
System_Ext(Insurance_Clearinghouse, "Insurance Clearinghouse", "External clearinghouse receiving claims")
System_Ext(Forensic_Audit_Queue, "Forensic Audit Queue", "External audit queue for poison messages")

Container_Boundary(RabbitMQ, "RabbitMQ") {
    Component(RabbitMQ_Message_Broker, "RabbitMQ Message Broker", "RabbitMQ / Erlang", "Handles asynchronous messaging for patient admissions, electronic medical records, scheduling, and billing.")
    Component(RabbitMQ_Cluster_Operator_for_Kubernetes, "RabbitMQ Cluster Operator for Kubernetes", "Kubernetes Operator", "Manages the RabbitMQ deployment across a 3-node topology with anti-affinity rules for high availability.")
    Component(Direct_and_Topic_Exchanges, "Direct and Topic Exchanges", "RabbitMQ Exchanges (billing.direct, claims.topic, dlx.direct)", "Routes published events to appropriate queues based on routing keys and exchange types.")
    Component(Quorum_Queues_Dead_Letter_Component, "Quorum Queues & Dead-Letter Component", "Raft-based Quorum Queues", "Ensures zero message loss, high availability, and quarantines invalid or poison messages.")
    Component(RabbitMQ_Federation_Plugin, "RabbitMQ Federation Plugin", "RabbitMQ Federation", "Enables hybrid cloud federation for message distribution and high availability.")
    Component(TLS_Termination_mTLS_Component, "TLS Termination & mTLS Component", "TLS 1.3 & mTLS", "Enforces in-transit encryption to satisfy HIPAA and GDPR security mandates.")
    Component(HashiCorp_Vault_Secrets_Engine, "HashiCorp Vault Secrets Engine", "HashiCorp Vault", "Provides dynamic credential rotation and secret management for the messaging architecture.")
}

Rel(Billing_Claims_Service, Direct_and_Topic_Exchanges, "Publishes encrypted payload events", "AMQP 0-9-1 over TLS 1.3")
Rel(Quorum_Queues_Dead_Letter_Component, Insurance_Clearinghouse, "Forwards claims asynchronously via outbound connectors", "AMQP/HTTPS")
Rel(Direct_and_Topic_Exchanges, Quorum_Queues_Dead_Letter_Component, "Routes messages to", "AMQP")
Rel(Quorum_Queues_Dead_Letter_Component, Forensic_Audit_Queue, "Quarantines invalid or poison messages", "AMQP")

@enduml