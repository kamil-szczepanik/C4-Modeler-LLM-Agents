@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing & Claims Service container

Container_Boundary(billing_and_claims_service, "Billing & Claims Service") {
    Component(ClaimProcessingEngine, "Claim Processing Engine", "Java / Spring State Machine", "Manages insurance claim processing states and workflows.")
    Component(InvoiceAndLedgerManager, "Invoice & Ledger Manager", "Java / Spring Data JPA", "Manages financial transactions, invoices, and ledger records.")
    Component(ClearinghouseAdapter, "Clearinghouse Adapter", "Java / Spring Integration", "Handles secure integrations with external insurance clearinghouses.")
    Component(OutboxPublisherComponent, "Outbox Publisher Component", "Spring Integration / JDBC", "Publishes domain events reliably using the outbox pattern.")
    ComponentDb(CockroachDB, "CockroachDB", "CockroachDB", "Distributed SQL database for multi-region ACID guarantees.")
    Component(RabbitMQ, "RabbitMQ", "RabbitMQ", "Asynchronous message broker providing outbox durability and DLQs.")
    Component(HashiCorpVault, "HashiCorp Vault", "HashiCorp Vault", "Secret management for encryption keys and external credentials.")
}

System_Ext(InsuranceClearinghouse, "Insurance Clearinghouse", "External insurance clearinghouse for claims processing.")

Rel(ClaimProcessingEngine, ClearinghouseAdapter, "Direct Java method calls")
Rel(ClearinghouseAdapter, InsuranceClearinghouse, "SFTP / AS2 with TLS 1.3 / AES-256")
Rel(InvoiceAndLedgerManager, CockroachDB, "JDBC over TLS with ACID guarantees")
Rel(ClaimProcessingEngine, OutboxPublisherComponent, "Internal transactional method call")
Rel(OutboxPublisherComponent, RabbitMQ, "AMQP with cryptographically signed domain events")
Rel(InvoiceAndLedgerManager, HashiCorpVault, "HTTPS/REST via Spring Cloud Vault")

@enduml