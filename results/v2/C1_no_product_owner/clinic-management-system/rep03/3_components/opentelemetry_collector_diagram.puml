@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(OpenTelemetry_Collector, "OpenTelemetry Collector") {
    Component(OpenTelemetry_Receiver, "OpenTelemetry Receiver", "OpenTelemetry Protocol (OTLP)", "Receives metrics, traces, and logs from backend services via OTLP/gRPC with mTLS.")
    Component(PII_PHI_Redaction_Processor, "PII/PHI Redaction Processor", "Custom Filtering Processor", "Redacts personally identifiable information (PII) and protected health information (PHI) to ensure HIPAA/GDPR compliance.")
    Component(Telemetry_Exporter, "Telemetry Exporter", "OpenTelemetry Exporter", "Transmits unified metrics, traces, and logs to observability backends.")
}

Rel(OpenTelemetry_Receiver, PII_PHI_Redaction_Processor, "Passes raw telemetry data for redaction")
Rel(PII_PHI_Redaction_Processor, Telemetry_Exporter, "Sends sanitized telemetry data for export")
@enduml