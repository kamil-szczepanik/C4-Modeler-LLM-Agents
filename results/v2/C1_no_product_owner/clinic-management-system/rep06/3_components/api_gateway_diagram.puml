@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(TLS Termination & Edge Firewall, "TLS Termination & Edge Firewall", "Kong Edge Security Module", "Handles incoming TLS termination, edge firewall rules, and perimeter security.")
    Component(Auth Interceptor Plugin, "Auth Interceptor Plugin", "Kong OAuth2/OIDC Plugin with local JWKS caching", "Validates tokens and authenticates users at the edge.")
    Component(Routing & Load Balancer Engine, "Routing & Load Balancer Engine", "Kong Core Router", "Routes incoming API requests to downstream microservices and manages load balancing.")
    Component(Rate Limiting & Throttling Engine, "Rate Limiting & Throttling Engine", "Kong Rate Limiting Plugin with Redis Cluster", "Enforces rate limits and request throttling to protect backend services.")
    Component(Request Transformation Plugin, "Request Transformation Plugin", "Kong Transformation Plugin", "Modifies headers, injects propagated JWTs, and adapts requests before forwarding.")
}

Rel(TLS Termination & Edge Firewall, Auth Interceptor Plugin, "Passes decrypted traffic for authentication", "")
Rel(Auth Interceptor Plugin, Rate Limiting & Throttling Engine, "Enforces limits for authenticated requests", "")
Rel(Rate Limiting & Throttling Engine, Request Transformation Plugin, "Passes allowed requests for transformation", "")
Rel(Request Transformation Plugin, Routing & Load Balancer Engine, "Routes transformed requests to backend services", "")

@enduml