@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Component_Ext(api_gateway, "API Gateway", "Gateway", "External dependency routing billing and claims requests.")
Component_Ext(payment_gateway, "Payment Gateway", "External Gateway", "Processes tokenized patient payments.")
Component_Ext(insurance_payer_apis, "Insurance Payer APIs", "External API", "Submits claims and verifies insurance.")
Component_Ext(apache_kafka, "Apache Kafka", "Event Streaming", "Handles reliable event streaming with dead-letter queues and KEDA autoscaling.")

Container_Boundary(billing_and_claims_service, "Billing & Claims Service") {
    Component(billing_api_controller, "Billing API Controller", "FastAPI router", "Handling incoming requests and validating scoped JWT claims.")
    Component(claim_engine, "Claim Engine", "Python domain logic", "Processing insurance claim rules and formatting payloads.")
    Component(payment_processor_client, "Payment Processor Client", "Secure integration client", "Utilizing idempotency keys and tokenized vault storage.")
    Component(billing_data_access_layer_dal, "Billing Data Access Layer (DAL)", "SQLAlchemy ORM", "Enforcing AES-256 encryption, column-level encryption, and immutable audit logs.")
    Component(claims_event_publisher, "Claims Event Publisher", "Apache Kafka producer", "Broadcasting asynchronous billing status events.")
}

Rel(api_gateway, billing_api_controller, "Routes billing and claims requests", "gRPC / Istio mTLS")
Rel(payment_processor_client, payment_gateway, "Processes tokenized patient payments", "HTTPS / TLS 1.3")
Rel(claim_engine, insurance_payer_apis, "Submits claims and verifies insurance", "HTTPS / TLS 1.3 with certificate pinning")
Rel(claims_event_publisher, apache_kafka, "Emits asynchronous events", "Kafka / TLS")

@enduml