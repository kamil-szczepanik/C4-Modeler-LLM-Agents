@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Identity & Access Management Service container

Container_Boundary(iam_service, "Identity & Access Management Service") {
    Component(Authentication_Engine, "Authentication Engine", "Keycloak SPI", "Handles credential verification, WebAuthn/TOTP MFA, and session management.")
    Component(Federation_Broker, "Federation Broker", "Keycloak Broker Service", "Manages SAML/OIDC federation with Enterprise IdP.")
    Component(Token_Issuance_Service, "Token Issuance Service", "Keycloak JWT Provider", "Issues RS256-signed short-lived JWTs.")
    Component(Session_Revocation_Component, "Session & Revocation Component", "Infinispan Distributed Cache Grid", "Handles cross-region session replication and back-channel logout.")
    Component(Audit_Event_Dispatcher, "Audit Event Dispatcher", "Keycloak Event SPI", "Streams security events with a persistent Write-Ahead Log (WAL).")
    Component(IAM_Database_Repository, "IAM Database Repository", "Multi-region PostgreSQL cluster with AES-256 encryption", "Stores credentials and audit logs securely.")
}

Component(API_Gateway, "API Gateway", "API Gateway", "External API gateway validating tokens via JWKS.")

Rel(Authentication_Engine, IAM_Database_Repository, "Synchronous queries via JDBC over TLS", "JDBC/TLS")
Rel(Token_Issuance_Service, API_Gateway, "JWKS endpoint exposed over HTTPS for decentralized token validation", "HTTPS")
Rel(Authentication_Engine, Session_Revocation_Component, "In-memory cache replication via Infinispan TCP over mTLS", "TCP/mTLS")
Rel(Authentication_Engine, Audit_Event_Dispatcher, "Non-blocking event emission using local queues", "In-memory")
@enduml