@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient & Scheduling Service container

System_Ext(api_gateway, "API Gateway", "Istio", "External entry point routing requests to internal components using gRPC, mTLS, and JWT.")
System_Ext(external_state_store, "External State Store", "PostgreSQL / Redis Enterprise", "Centralized external state management for active-active deployments.")
System_Ext(message_broker, "Message Broker", "Apache Kafka", "Event-driven decoupling for downstream EMR and FHIR brokers.")

Container_Boundary(patient_scheduling_service, "Patient & Scheduling Service") {
    Component(patient_management_component, "Patient Management Component", "Go, Chi router", "Manages patient admissions and records within the Clinic Management System.")
    Component(scheduling_engine_component, "Scheduling Engine Component", "Go", "Handles appointment scheduling logic for the Clinic Management System.")
    Component(data_access_repository, "Data Access Repository", "Go pgx driver", "Interfaces with the database using native Go pgx over TLS 1.3.")
    Component(event_publisher_component, "Event Publisher Component", "Watermill Go library", "Publishes asynchronous domain events to the message broker.")
}

Rel(api_gateway, patient_management_component, "gRPC with Istio mTLS and JWT", "gRPC")
Rel(api_gateway, scheduling_engine_component, "gRPC with Istio mTLS and JWT", "gRPC")
Rel(scheduling_engine_component, external_state_store, "PostgreSQL Wire Protocol over TLS 1.3", "PostgreSQL Wire Protocol")
Rel(patient_management_component, data_access_repository, "Native Go pgx over TLS 1.3", "Go pgx")
Rel(event_publisher_component, message_broker, "Apache Kafka / AMQP over TLS 1.3 with client-side payload encryption", "Kafka / AMQP")

@enduml