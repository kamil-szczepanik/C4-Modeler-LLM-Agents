@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Doctor, "Doctor", "Medical professional who accesses and manages electronic medical records and patient schedules.")
Person(Receptionist, "Receptionist", "Front-desk staff who handles patient admissions and scheduling.")
Person(Patient, "Patient", "End user who interacts with the system for appointments and records.")
Person(BillingAdministrator, "Billing Administrator", "Staff member responsible for managing billing, payments, and insurance claims.")
Person(SystemAdministrator, "System Administrator", "IT professional responsible for managing and maintaining the hybrid cloud platform.")

System_Ext(ExternalLabImagingSystems, "External Lab / Imaging Systems", "Third-party diagnostic systems providing laboratory and imaging results.")
System_Ext(PaymentGateway, "Payment Gateway", "External service processing financial transactions and credit card payments.")
System_Ext(InsurancePayerAPIs, "Insurance Payer APIs", "External APIs used for insurance verification and claims processing.")
System_Ext(EnterpriseIdentityProviderss, "Enterprise Identity Provider (IdP)", "Centralized identity provider for authentication and user management.")

System_Boundary(ClinicManagementSystem, "Clinic Management System") {
    Container(APIGateway, "API Gateway", "Kong/NGINX", "Handles TLS termination, rate limiting, and routing.")
    Container(IdentityAccessManagementService, "Identity & Access Management Service", "Keycloak", "Manages OAuth2/OIDC, MFA, and integration with Enterprise IdP.")
    Container(PatientSchedulingService, "Patient & Scheduling Service", "Go / Java Spring Boot", "Manages patient admissions, appointments, and scheduling.")
    Container(EMRCoreService, "EMR Core Service", "Java Spring Boot", "Manages electronic medical records core business logic.")
    Container(BillingClaimsService, "Billing & Claims Service", "Node.js / Python", "Handles billing, payments, and insurance claims.")
    Container(FHIRInteroperabilityBroker, "FHIR Interoperability Broker", "Apache Camel / Azure Health Data Services", "Translates and brokers HL7 FHIR data to external systems.")
}

Rel(Doctor, APIGateway, "Accesses patient records and schedules", "HTTPS / JSON / OAuth2/OIDC with MFA")
Rel(Receptionist, APIGateway, "Handles patient admissions and scheduling", "HTTPS / JSON / OAuth2/OIDC with MFA")
Rel(Patient, APIGateway, "Accesses appointments and personal records", "HTTPS / JSON / OAuth2/OIDC with MFA")
Rel(BillingAdministrator, APIGateway, "Manages billing and financial data", "HTTPS / JSON / OAuth2/OIDC with MFA")
Rel(SystemAdministrator, APIGateway, "Manages platform infrastructure and system configuration", "HTTPS / JSON / OAuth2/OIDC with MFA")

Rel(APIGateway, IdentityAccessManagementService, "Authenticates users and validates tokens", "gRPC with Istio mTLS")
Rel(APIGateway, PatientSchedulingService, "Routes patient and scheduling requests", "gRPC with Istio mTLS and propagated JWTs")
Rel(APIGateway, EMRCoreService, "Routes electronic medical records requests", "gRPC with Istio mTLS and propagated JWTs")
Rel(APIGateway, BillingClaimsService, "Routes billing and claims requests", "gRPC with Istio mTLS and propagated JWTs")
Rel(APIGateway, FHIRInteroperabilityBroker, "Routes interoperability and data exchange requests", "gRPC with Istio mTLS and propagated JWTs")

Rel(IdentityAccessManagementService, EnterpriseIdentityProviderss, "Integrates for enterprise authentication", "OIDC / SAML over HTTPS")
Rel(FHIRInteroperabilityBroker, ExternalLabImagingSystems, "Exchanges lab and imaging data", "HL7 FHIR APIs over HTTPS")
Rel(BillingClaimsService, PaymentGateway, "Processes patient payments and transactions", "HTTPS / JSON")
Rel(BillingClaimsService, InsurancePayerAPIs, "Verifies insurance and submits claims", "HTTPS / JSON")

@enduml