@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Doctor, "Doctor", "Medical professional who accesses and manages electronic medical records and patient schedules.")
Person(Receptionist, "Receptionist", "Front-desk staff who handles patient admissions and scheduling.")
Person(Patient, "Patient", "End user who interacts with the system for appointments and records.")
Person(Billing Administrator, "Billing Administrator", "Staff member responsible for managing billing, payments, and insurance claims.")
Person(System Administrator, "System Administrator", "IT professional responsible for managing and maintaining the hybrid cloud platform.")

System(Clinic Management System, "Clinic Management System", "A hybrid cloud platform designed for medium-sized hospitals and clinics to manage patient admissions, electronic medical records, scheduling, and billing while ensuring HIPAA/GDPR compliance, 99.99% availability, and strict data retention over 10 years.")

System_Ext(External Lab / Imaging Systems, "External Lab / Imaging Systems", "Third-party diagnostic systems providing laboratory and imaging results.")
System_Ext(Payment Gateway, "Payment Gateway", "External service processing financial transactions and credit card payments.")
System_Ext(Insurance Payer APIs, "Insurance Payer APIs", "External APIs used for insurance verification and claims processing.")
System_Ext(Enterprise Identity Provider (IdP), "Enterprise Identity Provider (IdP)", "Centralized identity provider for authentication and user management.")

Rel(Doctor, Clinic Management System, "Manages electronic medical records and patient schedules with mandatory MFA", "HTTPS / WebSockets")
Rel(Receptionist, Clinic Management System, "Handles patient admissions and scheduling with mandatory MFA", "HTTPS / WebSockets")
Rel(Patient, Clinic Management System, "Accesses appointments and personal records with mandatory MFA", "HTTPS / WebSockets")
Rel(Billing Administrator, Clinic Management System, "Manages billing and financial data with mandatory MFA", "HTTPS / WebSockets")
Rel(System Administrator, Clinic Management System, "Manages platform infrastructure and system configuration with mandatory MFA", "HTTPS / WebSockets")
Rel(Clinic Management System, Enterprise Identity Provider (IdP), "Centralized authentication and authorization", "OIDC / SAML over HTTPS")
Rel(Clinic Management System, External Lab / Imaging Systems, "Exchanges lab and imaging data", "HTTPS / REST using HL7 FHIR protocols")
Rel(Clinic Management System, Payment Gateway, "Processes patient payments and transactions", "HTTPS / REST over TLS 1.3")
Rel(Clinic Management System, Insurance Payer APIs, "Verifies insurance and submits claims", "HTTPS / REST over TLS 1.3")
@enduml