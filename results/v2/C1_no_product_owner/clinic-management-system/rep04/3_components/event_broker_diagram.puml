@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Event Broker container

Container_Boundary(event_broker, "Event Broker") {
    Component(ApacheKafkaBrokerCluster, "Apache Kafka Broker Cluster", "Apache Kafka via Strimzi operator (KRaft)", "Handles asynchronous event messaging across microservices with high availability and durability.")
}

System_Ext(Microservices, "Microservices", "Patient & Scheduling, EMR, Billing, and Integration Microservices")

Rel(ApacheKafkaBrokerCluster, Microservices, "Publishes and consumes domain events", "Kafka Protocol (SASL/SCRAM over mTLS, TLS 1.3)")

@enduml