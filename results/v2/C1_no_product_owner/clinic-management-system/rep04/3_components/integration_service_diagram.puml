@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Service container

Container_Boundary(integration_service, "Integration Service") {
    Component(FHIR_Adapter_Component, "FHIR Adapter Component", "Spring Boot / Apache Camel", "Connects the system to external providers and standardizes clinical data streams.")
    Component(Outbox_Processor_Component, "Outbox Processor Component", "Spring Boot", "Processes and hands off encrypted domain events for publishing.")
    Component(Secure_Transport_Client_Component, "Secure Transport Client Component", "HttpClient / Netty", "Exchanges data securely with external systems.")
    Component(Payload_Sanitizer_Encryption_Component, "Payload Sanitizer & Encryption Component", "Spring Security / JOSE", "Sanitizes and encrypts clinical payloads to ensure regulatory compliance.")
}

Component(Event_Broker, "Event Broker", "Apache Kafka / RabbitMQ", "Provides reliable, asynchronous event streaming.")
Component(External_Lab_Imaging_Systems, "External Lab & Imaging Systems", "HL7 FHIR over HTTPS with mTLS", "External providers for lab and imaging data.")
Component(WORM_Audit_Log_Store, "WORM Audit Log Store", "HSM-backed KMS / Immutable Storage", "Ensures secure key management and immutable audit logs for compliance.")

Rel(FHIR_Adapter_Component, Secure_Transport_Client_Component, "Dispatches standardized payloads", "Internal Method Calls")
Rel(FHIR_Adapter_Component, Payload_Sanitizer_Encryption_Component, "Sanitizes and encrypts clinical payloads", "Internal Method Calls")
Rel(Payload_Sanitizer_Encryption_Component, Outbox_Processor_Component, "Hands off encrypted domain events", "Internal Method Calls")
Rel(Outbox_Processor_Component, Event_Broker, "Publishes domain events", "Kafka Protocol")
Rel(Secure_Transport_Client_Component, External_Lab_Imaging_Systems, "Exchanges data via HL7 FHIR over HTTPS with mTLS", "HL7 FHIR over HTTPS with mTLS")

@enduml