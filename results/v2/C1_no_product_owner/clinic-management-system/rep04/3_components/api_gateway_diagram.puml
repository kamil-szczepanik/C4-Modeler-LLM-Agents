@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(api_gateway_kong_nginx, "API Gateway (Kong / Nginx)", "Kong / Nginx on Kubernetes", "Manages inbound traffic, TLS termination, and routing.")
    Component(tls_termination_ingress_controller, "TLS Termination & Ingress Controller", "Nginx/Kong Ingress", "Enforces TLS 1.3 and WAF policies.")
    Component(authentication_authorization_plugin, "Authentication & Authorization Plugin", "Lua/Go with OIDC & Coraza/ModSecurity", "Validates JWTs, enforces RBAC, scope validation, and PHI masking.")
    Component(service_discovery_upstream, "Service Discovery & Upstream", "Envoy / Kong Upstream", "Handles gRPC routing with circuit breakers.")
}

Rel(api_gateway_kong_nginx, tls_termination_ingress_controller, "Passes inbound traffic for TLS termination", "")
Rel(tls_termination_ingress_controller, authentication_authorization_plugin, "Enforces security policies and validates tokens", "")
Rel(authentication_authorization_plugin, service_discovery_upstream, "Routes validated requests via upstream", "")

@enduml