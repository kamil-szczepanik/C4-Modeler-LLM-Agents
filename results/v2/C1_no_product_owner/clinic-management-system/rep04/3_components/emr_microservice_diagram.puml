@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the EMR Microservice container

Container_Boundary(emr_microservice, "EMR Microservice") {
    Component(EMRAPIController, "EMR API Controller", "Spring Boot / Express.js", "Manages electronic medical records and clinical workflows, handling incoming requests.")
    Component(ClinicalRecordEngine, "Clinical Record Engine", "Java / Node.js", "Core engine for processing clinical records and coordinating internal workflows.")
    Component(FHIRInteroperabilityAdapter, "FHIR Interoperability Adapter", "Java HAPI FHIR / Node.js", "Ensures interoperability through FHIR standards.")
    Component(AuditLoggerComponent, "Audit Logger Component", "Internal Component", "Captures and logs audit events securely.")
    Component(KMSCryptoInterceptor, "KMS Crypto Interceptor", "Local KMS SDK", "Performs cryptographic operations and handles encryption key management.")
    Component(ClinicalCachingLayer, "Clinical Caching Layer", "Redis", "Provides low-latency caching of encrypted clinical records.")
    Component(TelemetryCircuitBreakerSidecar, "Telemetry & Circuit Breaker Sidecar", "Istio", "Enforces strict mTLS, service mesh security, and telemetry.")
}

System_Ext(WORMAuditLogStore, "WORM Audit Log Store", "External storage for cryptographically signed audit logs.")
System_Ext(PostgreSQLDatabase, "PostgreSQL Database", "External database for persisting ciphertexts.")

Rel(EMRAPIController, ClinicalRecordEngine, "In-process method calls", "In-process")
Rel(ClinicalRecordEngine, FHIRInteroperabilityAdapter, "Internal eventing", "Kafka/AMQP")
Rel(AuditLoggerComponent, WORMAuditLogStore, "Cryptographically signed writes", "HTTPS/TLS 1.3")
Rel(ClinicalRecordEngine, KMSCryptoInterceptor, "Cryptographic operations", "Local KMS SDK")
Rel(ClinicalRecordEngine, ClinicalCachingLayer, "Record retrieval", "Redis Protocol over mTLS")
Rel(KMSCryptoInterceptor, PostgreSQLDatabase, "Persists ciphertexts", "AES-256")

@enduml