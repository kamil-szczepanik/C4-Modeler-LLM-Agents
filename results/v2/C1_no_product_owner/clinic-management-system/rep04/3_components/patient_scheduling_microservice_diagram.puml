@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(patient_scheduling_microservice, "Patient & Scheduling Microservice") {
    Component(PatientController, "PatientController", "Spring Boot / Java 21", "Handles patient and scheduling related HTTP/gRPC requests.")
    Component(SecurityEnforcer_AuthInterceptor, "SecurityEnforcer / AuthInterceptor", "In-memory", "Performs interception and authorization for incoming requests.")
    Component(SchedulingService, "SchedulingService", "Spring Boot / Java 21", "Manages scheduling business logic.")
    Component(AppointmentRepository, "AppointmentRepository", "JDBC / TLS", "Manages data access for appointments with AES-256 encryption.")
    Component(NotificationPublisher, "NotificationPublisher", "Kafka Producer API", "Asynchronously publishes notification events.")
    Component(EventPayloadMasker, "EventPayloadMasker", "In-memory", "Sanitizes payloads for security and compliance.")
}

Rel(PatientController, SecurityEnforcer_AuthInterceptor, "Interception / Authorization", "In-memory")
Rel(PatientController, SchedulingService, "Local method invocation", "")
Rel(SchedulingService, AppointmentRepository, "JDBC / TLS [AES-256 Encryption]", "JDBC / TLS")
Rel(SchedulingService, NotificationPublisher, "Asynchronous publish", "Kafka Producer API")
Rel(NotificationPublisher, EventPayloadMasker, "Sanitizes payload", "In-memory")

@enduml