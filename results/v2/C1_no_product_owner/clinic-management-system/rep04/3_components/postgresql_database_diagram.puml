@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(postgresql_database, "PostgreSQL Database") {
    Component(Primary_Database_Engine, "Primary Database Engine", "PostgreSQL v15+", "Core transactional engine for strong consistency and relational data integrity.")
    Component(Read_Replica_Instances, "Read Replica Instances", "PostgreSQL v15+ Read Replica", "Handles read queries to optimize P95 read performance.")
    Component(PgBouncer_Connection_Pooler, "PgBouncer Connection Pooler", "PgBouncer", "Connection pooling to prevent thread exhaustion under high concurrency.")
    Component(Patroni_CloudNativePG, "Patroni / CloudNativePG", "Patroni / CloudNativePG", "Consensus-based leader election and automated failover for 99.99% availability.")
    Component(pgBackRest_Backup_PITR_Agent, "pgBackRest Backup & PITR Agent", "pgBackRest", "Secure backups satisfying 10-year data retention and compliance mandates.")
    Component(postgres_exporter, "postgres-exporter", "postgres-exporter", "Observability exporter for database metrics.")
    Component(Vault_Agent_Sidecar, "Vault Agent / Sidecar", "HashiCorp Vault", "Supplies dynamic credentials via TLS 1.3 to eliminate hardcoded database credentials.")
    Component(pgaudit_Extension, "pgaudit Extension", "pgaudit & Row-Level Security", "Detailed audit logging and data masking for HIPAA and GDPR compliance.")
}

Rel(PgBouncer_Connection_Pooler, Primary_Database_Engine, "TCP/IP via Internal Mesh")
Rel(Primary_Database_Engine, Read_Replica_Instances, "Streaming Replication with mTLS / IPsec")
Rel(Primary_Database_Engine, pgBackRest_Backup_PITR_Agent, "Encrypted WAL streams to WORM Storage [AES-256]")
Rel(Vault_Agent_Sidecar, PgBouncer_Connection_Pooler, "Supplies dynamic credentials via TLS 1.3 [SCRAM-SHA-256]")
@enduml