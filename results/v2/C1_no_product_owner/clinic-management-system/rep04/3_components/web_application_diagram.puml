@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application container

Container_Boundary("Web Application", "Web Application") {
    Component("Patient Portal UI Module", "Patient Portal UI Module", "React / Next.js", "Provides the user interface for patients and clients to access their records and portal.")
    Component("Clinician Dashboard Module", "Clinician Dashboard Module", "React / Next.js", "Provides medical staff with tools to fetch EMR data and manage clinical workflows.")
    Component("Billing Console Module", "Billing Console Module", "React / Next.js", "Provides billing administrators with interfaces to manage financial records and transactions.")
    Component("Auth & Session Manager", "Auth & Session Manager", "TypeScript / OAuth2 / OIDC", "Manages user sessions, tokens, and authentication states securely.")
    Component("State Management & API Client Module", "State Management & API Client Module", "TypeScript / gRPC-Web / HTTPS", "Handles client-side state and communicates with backend services and the API Gateway.")
    Component("Client-Side Routing & RBAC Guard", "Client-Side Routing & RBAC Guard", "TypeScript / React Router", "Enforces role-based access control and handles navigation within the application.")
}

System_Ext(API_Gateway, "API Gateway", "API Gateway (Kong / Nginx on Kubernetes)")
System_Ext(Identity_Provider, "Identity Provider", "Identity Provider (IdP)")

Rel("Clinician Dashboard Module", API_Gateway, "Fetches EMR data", "gRPC-Web / HTTPS")
Rel("Auth & Session Manager", Identity_Provider, "Validates sessions", "OpenID Connect / HTTPS")
Rel("Web Application", API_Gateway, "Sends user requests", "HTTPS/TLS with OAuth2/OIDC and mutual TLS")

@enduml