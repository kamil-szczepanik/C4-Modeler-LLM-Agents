@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Istio Service Mesh container

System_Ext(api_gateway, "API Gateway", "External gateway routing traffic into the mesh.")
System_Ext(worm_audit_log_store, "WORM Audit Log Store", "External secure storage for audit logs.")

Container_Boundary(istio_service_mesh, "Istio Service Mesh") {
    Component(istiod_control_plane, "Istiod Control Plane", "Istio / Istiod, SPIFFE/SPIRE", "Replicated deployment managing xDS configuration, certificate authority duties, and SPIFFE/SPIRE workload identities.")
    Component(envoy_sidecar_proxies, "Envoy Sidecar Proxies", "Envoy Proxy, TLS 1.3", "Injected into microservice pods to handle traffic management, TLS 1.3 termination, and AuthorizationPolicies.")
    Component(istio_ingress_egress_gateways, "Istio Ingress/Egress Gateways", "Envoy Proxy", "Envoy-based gateways managing traffic crossing the service mesh boundary.")
    Component(telemetry_audit_exporter, "Telemetry & Audit Exporter", "Fluentbit / OTLP", "Sub-component streaming Envoy access logs and RBAC enforcement decisions to the WORM audit store.")
}

Rel(istiod_control_plane, envoy_sidecar_proxies, "Configures via xDS over gRPC", "gRPC / xDS")
Rel(istiod_control_plane, istio_ingress_egress_gateways, "Configures via xDS over gRPC", "gRPC / xDS")
Rel(envoy_sidecar_proxies, envoy_sidecar_proxies, "Enables inter-service communication via Mutual TLS (mTLS via TLS 1.3 over TCP)", "TLS 1.3 over TCP")
Rel(api_gateway, istio_ingress_egress_gateways, "Routes traffic into the mesh using HTTPS/gRPC", "HTTPS/gRPC")
Rel(telemetry_audit_exporter, worm_audit_log_store, "Streams audit logs asynchronously via OTLP over gRPC", "OTLP over gRPC")
@enduml