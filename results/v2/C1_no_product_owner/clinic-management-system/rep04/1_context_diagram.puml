@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(PatientClient, "Patient/Client", "End-user interacting via web/mobile portals for appointments and records.")
Person(ClinicianMedicalStaff, "Clinician/Medical Staff", "Medical professionals managing electronic medical records (EMR) and patient care.")
Person(BillingAdmin, "Billing Admin", "Administrative staff managing billing and insurance claims.")

System(ClinicManagementSystem, "Clinic Management System", "A hybrid cloud platform designed to manage patient admissions, electronic medical records (EMR), scheduling, and billing for medium-sized healthcare facilities.")

System_Ext(ExternalLabImagingSystems, "External Lab & Imaging Systems", "External systems providing laboratory and medical imaging data.")
System_Ext(PaymentGatewayInsuranceClearinghouse, "Payment Gateway / Insurance Clearinghouse", "External system for processing payments and submitting insurance claims.")
System_Ext(IdentityPoviderIdP, "Identity Provider (IdP)", "External identity provider handling user authentication via OIDC/SAML.")

Rel(PatientClient, ClinicManagementSystem, "Interact via Web/Mobile portal for appointments and records", "HTTPS")
Rel(ClinicianMedicalStaff, ClinicManagementSystem, "Access and manage EMR and clinical workflows", "HTTPS")
Rel(BillingAdmin, ClinicManagementSystem, "Manage billing interfaces and financial transactions", "HTTPS")
Rel(ClinicManagementSystem, IdentityPoviderIdP, "Authenticates users via OIDC/SAML with short-lived JWTs and MFA", "OIDC/SAML")
Rel(ClinicManagementSystem, ExternalLabImagingSystems, "Integrates clinical data exchange", "HL7 FHIR (REST/JSON over TLS)")
Rel(ClinicManagementSystem, PaymentGatewayInsuranceClearinghouse, "Submits payment claims", "Secure REST APIs")

@enduml