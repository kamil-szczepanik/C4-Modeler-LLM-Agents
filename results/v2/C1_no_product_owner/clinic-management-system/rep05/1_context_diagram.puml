@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Users, "Patients, Doctors, Nurses, and Administrative Staff", "Users who interact with the clinic management system for healthcare delivery, records, scheduling, and administration.")

System(CMS, "Clinic Management System (CMS)", "Orchestrates patient admissions, electronic medical records, scheduling, and billing for healthcare facilities within a hybrid cloud environment.")

System_Ext(LabSystems, "External Laboratory & Imaging Systems", "External clinical systems used for medical testing and imaging.")
System_Ext(PaymentGateway, "Payment Gateway and Insurance Clearinghouse", "External financial systems for processing payments and insurance claims.")
System_Ext(IdP, "Identity Provider (IdP)", "Provides authentication services with OIDC/SAML and Multi-Factor Authentication.")
System_Ext(SIEM, "SIEM & Audit Platform", "Platform for security information, event management, and auditing.")
System_Ext(KMS, "Enterprise KMS", "Key Management Service backed by HSM for data encryption.")
System_Ext(WAF, "Global Traffic Manager / WAF", "Edge routing, active-active traffic management, and DDoS protection.")

Rel(Users, CMS, "Accesses patient admissions, EMRs, scheduling, and billing", "HTTPS / Web / Mobile / Desktop Apps")
Rel(CMS, LabSystems, "Exchanges clinical data and medical imaging results", "HL7 FHIR over HTTPS")
Rel(CMS, PaymentGateway, "Processes billing, payments, and insurance claims", "Secure API over HTTPS")
Rel(CMS, IdP, "Authenticates users and performs Multi-Factor Authentication", "OIDC / SAML")
Rel(CMS, SIEM, "Sends logs and audit trails", "Encrypted Syslog / HTTPS")
Rel(CMS, KMS, "Manages encryption keys for data security", "PKCS#11 / Cloud KMS API over TLS 1.3")
Rel(WAF, CMS, "Routes external traffic and protects against threats", "Global Traffic Management / WAF")

@enduml