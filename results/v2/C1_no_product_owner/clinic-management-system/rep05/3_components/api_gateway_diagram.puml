@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary("API Gateway", "API Gateway") {
    Component("Edge Router & WAF", "Edge Router & WAF", "Global Traffic Manager / WAF", "Routes external traffic and enforces perimeter security with mTLS attestation.")
    Component("Envoy Proxy Engine", "Envoy Proxy Engine", "Envoy", "Provides gRPC-web support, native tracing, fine-grained rate-limiting, and ingress routing.")
    Component("Authentication Filter", "Authentication Filter", "Keycloak / OAuth2 / OIDC", "Validates JWT tokens and checks scope permissions for incoming requests.")
}

Rel("Edge Router & WAF", "Envoy Proxy Engine", "Routes external traffic via [HTTPS] with mTLS attestation", "HTTPS / mTLS")
Rel("Envoy Proxy Engine", "Authentication Filter", "Validates JWT tokens and validates scopes via [OAuth2/OIDC]", "OAuth2/OIDC")

@enduml