@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Identity & Access Management container

Container_Boundary("Identity & Access Management", "Identity & Access Management") {
  Component(AuthenticationEngine, "Authentication Engine", "Keycloak Auth SPI", "Manages MFA, credentials, and IdP federation.")
  Component(TokenService, "Token Service", "Keycloak Token Endpoint", "Issues short-lived signed JWTs with OIDC Backchannel Logout.")
  Component(AuthorizationRBACProvider, "Authorization & RBAC Provider", "Keycloak Authorization Services", "Evaluates clinical roles.")
  Component(SessionUserStoreCache, "Session & User Store Cache", "Embedded Infinispan", "Provides cross-site replication and JDBC-PING.")
  Component(AuditEventDispatcher, "Audit Event Dispatcher", "Keycloak Event Listener SPI", "Streams masked security events.")
}

Component_Ext(IdentityPoviderIdP, "Identity Provider (IdP)", "External IdP", "External identity provider for federation.")
Component_Ext(SIEMAuditPlatform, "SIEM & Audit Platform", "Kafka / Syslog over TLS", "External platform for receiving audit trails.")
Component_Ext(EnterpriseKMS, "Enterprise KMS", "KMS", "Provides envelope encryption for master keys, session data, and token signing.")
Component_Ext(ApiGateway, "API Gateway", "API Gateway", "External gateway for validating short-lived JWTs.")
Component_Ext(CoreServices, "Core Services", "Core Services", "Internal backend services verifying permissions and validating tokens.")

Rel(AuthenticationEngine, IdentityPoviderIdP, "Federates authentication via OIDC/SAML", "OIDC/SAML")
Rel(CoreServices, AuthorizationRBACProvider, "Verifies permissions via gRPC over mTLS", "gRPC over mTLS")
Rel(AuditEventDispatcher, SIEMAuditPlatform, "Streams audit trails via Syslog over TLS / Kafka", "Syslog over TLS / Kafka")
Rel(TokenService, ApiGateway, "Validates short-lived JWTs via OAuth2/OIDC", "OAuth2/OIDC")
Rel(TokenService, CoreServices, "Validates short-lived JWTs via OAuth2/OIDC", "OAuth2/OIDC")

@enduml