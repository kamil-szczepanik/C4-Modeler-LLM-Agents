@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Services container

Container_Boundary(core_services, "Core Services") {
    Component(Patient Registry Component, "Patient Registry Component", "Spring Boot Runtime", "Handles patient admissions and profile management.")
    Component(Scheduling Engine, "Scheduling Engine", "Spring Boot Runtime", "Manages appointments and doctor schedules.")
    Component(EMR Manager, "EMR Manager", "Spring Boot Runtime", "Manages electronic medical records.")
    Component(Billing Processor, "Billing Processor", "Spring Boot Runtime", "Handles financial transactions and billing operations.")
    Component(Event Dispatcher Component, "Event Dispatcher Component", "Spring Boot Runtime", "Dispatches asynchronous events across the system.")
}

Rel(Patient Registry Component, Event Dispatcher Component, "Publishes patient events", "Encrypted Message Broker Protocol")
Rel(Scheduling Engine, Event Dispatcher Component, "Publishes scheduling events", "Encrypted Message Broker Protocol")
Rel(EMR Manager, Event Dispatcher Component, "Publishes EMR events", "Encrypted Message Broker Protocol")
Rel(Billing Processor, Event Dispatcher Component, "Publishes billing events", "Encrypted Message Broker Protocol")

@enduml