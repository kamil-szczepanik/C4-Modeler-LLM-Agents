@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the FHIR Interoperability Engine container

Container_Boundary(fhir_interoperability_engine, "FHIR Interoperability Engine") {
    Component(ApiRouterValidatorComponent, "API Router & Validator Component", "Apache Camel", "Evaluates OAuth2/JWT claims and SMART scopes, validating incoming clinical data payloads.")
    Component(SecurityPolicyEnforcementComponent, "Security & Policy Enforcement Component", "Apache Camel Policy / Keycloak Adapter", "Enforces security policies, authentication, and authorization rules.")
    Component(TransformationEngineComponent, "Transformation Engine Component", "Apache Camel / HAPI FHIR JPA", "Passes and transforms raw payloads into standardized FHIR resources.")
    Component(FhirRepositoryAdapterComponent, "FHIR Repository Adapter Component", "HAPI FHIR JPA", "Persists and queries standardized FHIR resources.")
}

Rel(ApiRouterValidatorComponent, SecurityPolicyEnforcementComponent, "Evaluates OAuth2/JWT claims and SMART scopes", "In-memory Java filter")
Rel(ApiRouterValidatorComponent, TransformationEngineComponent, "Passes raw payloads for mapping", "Internal Java Method / Camel Direct")
Rel(TransformationEngineComponent, FhirRepositoryAdapterComponent, "Persists and queries standardized resources", "JPA / JDBC over TLS")

@enduml