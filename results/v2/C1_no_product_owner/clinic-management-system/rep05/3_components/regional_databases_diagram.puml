@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Component(CoreServices, "Core Services", "Node.js / Spring Boot", "External callers interacting with the database layer.")
Component_Ext(SIEM, "SIEM & Audit Platform", "Enterprise KMS & SIEM & Audit Platform", "External audit platform.")
Component_Ext(KMS, "Enterprise KMS", "Enterprise KMS & SIEM & Audit Platform", "External key management service.")

Container_Boundary(RegionalDatabases, "Regional Databases") {
    Component(DistributedSQLEngine, "Distributed SQL Engine", "CockroachDB v23+", "Handles multi-active regional nodes, automatic sharding, ACID guarantees, and geo-partitioning.")
    Component(ConnectionPooler, "Connection Pooler & Routing Proxy", "PgBouncer / built-in SQL proxy", "Manages client connections and routes SQL traffic.")
    Component(DatabaseEncryptionManager, "Database Encryption Manager", "Native KMS integration", "Manages AES-256 TDE and Column-Level Encryption (CLE) keys for PHI security.")
    Component(AuditLogExporter, "Audit Log Exporter", "Ring-buffer local spooling", "Asynchronously spools and streams audit logs to the SIEM platform.")
}

Rel(CoreServices, ConnectionPooler, "Encrypted SQL over TLS via mTLS, Port 26257", "Encrypted SQL over TLS via mTLS, Port 26257")
Rel(ConnectionPooler, DistributedSQLEngine, "Local loopback / internal mTLS", "Local loopback / internal mTLS")
Rel(AuditLogExporter, SIEM, "Async TLS streaming", "Async TLS streaming")
Rel(DatabaseEncryptionManager, KMS, "Envelope encryption / TDE keys", "Envelope encryption / TDE keys")

@enduml