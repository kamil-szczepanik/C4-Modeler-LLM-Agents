@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Core_Services, "Core Services", "External system representing core application services.")
System_Ext(Enterprise_KMS, "Enterprise KMS", "Enterprise Key Management Service.")
System_Ext(SIEM_Audit_Platform, "SIEM & Audit Platform", "Security Information and Event Management platform.")

Container_Boundary(Encrypted_Object_Storage, "Encrypted Object Storage") {
    Component(S3_API_Gateway_Layer, "S3 API Gateway Layer", "MinIO/Ceph, HTTPS, TLS 1.3", "Handles HTTPS/S3 requests and TLS 1.3.")
    Component(Key_Management_Envelope_Encryption_Engine, "Key Management & Envelope Encryption Engine", "AES-256-GCM, Enterprise KMS", "Manages per-object AES-256-GCM data encryption keys via Enterprise KMS.")
    Component(Replication_Erasure_Coding_Manager, "Replication & Erasure Coding Manager", "Reed-Solomon, Active-Active Replication", "Handles localized active-active replication, asynchronous geo-replication, Reed-Solomon erasure coding, and tiered storage.")
    Component(Audit_Logging_Interceptor, "Audit Logging Interceptor", "gRPC", "Captures metadata access events and streams them via gRPC.")
    Component(Policy_WORM_Enforcer, "Policy & WORM Enforcer", "Object Lock (WORM)", "Evaluates fine-grained access policies and enforces 10-year immutable WORM retention.")
}

Rel(Core_Services, S3_API_Gateway_Layer, "Uploads and downloads encrypted blobs", "HTTPS / S3 API")
Rel(S3_API_Gateway_Layer, Policy_WORM_Enforcer, "Validates request authorization and retention policies", "in-process gRPC")
Rel(Key_Management_Envelope_Encryption_Engine, Enterprise_KMS, "Fetches Key Encryption Keys", "gRPC / mTLS")
Rel(Audit_Logging_Interceptor, SIEM_Audit_Platform, "Emits access audit trails", "Syslog / Kafka")

@enduml