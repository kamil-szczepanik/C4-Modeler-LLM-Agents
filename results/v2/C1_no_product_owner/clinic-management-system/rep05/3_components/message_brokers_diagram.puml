@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Message Brokers container

Container_Boundary(message_brokers, "Message Brokers") {
    Component(Event_Ingestion_Routing_Engine, "Event Ingestion & Routing Engine", "Apache Kafka", "Provides high-throughput, fault-tolerant event streams for patient admissions, electronic medical records, scheduling, and billing.")
    Component(Lightweight_Edge_Broker, "Lightweight Edge Broker", "NATS", "Handles low-latency, real-time local messaging on-premises in on-prem-k8s.")
    Component(Cross_Site_Replication_Manager, "Cross-Site Replication Manager", "Kafka MirrorMaker 2 with TLS Tunnels", "Performs multi-master synchronization between on-prem-k8s and eu-central-1.")
    Component(Schema_Registry, "Schema Registry", "Confluent Schema Registry", "Enforces strict AVRO schema evolution and prevents breaking changes.")
    Component(Access_Control_Enforcer, "Access Control Enforcer", "Apache Kafka built-in ACLs integrated with Keycloak", "Enforces fine-grained, token-based authorization and topic-level ACLs.")
}

Rel(Event_Ingestion_Routing_Engine, Cross_Site_Replication_Manager, "Synchronizes partitioned topics", "Mutual TLS over IPSec")

@enduml