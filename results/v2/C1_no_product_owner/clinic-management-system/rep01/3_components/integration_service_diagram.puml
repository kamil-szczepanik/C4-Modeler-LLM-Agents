@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(External_Lab_Imaging_Systems, "External Lab & Imaging Systems", "External lab and imaging systems interacting via mTLS.")
System_Ext(Message_Broker_Container, "Message Broker Container", "Geo-local Apache Kafka clusters with MirrorMaker.")

Container_Boundary(Integration_Service, "Integration Service") {
    Component(FHIR_Translator, "FHIR Translator", "Apache Camel / Node.js", "Provides enterprise integration patterns for complex FHIR R4 mapping and translates clinical data.")
    Component(Message_Router, "Message Router", "Apache Camel / Node.js", "Routes and dispatches raw integration events to and from messaging infrastructure.")
    Component(mTLS_Client, "mTLS Client", "HashiCorp Vault / cert-manager / TLS", "Handles secure mutual TLS communication with external lab and imaging systems.")
}

Rel(Message_Router, FHIR_Translator, "Dispatches raw integration events", "Internal Direct Route with W3C Trace Context")
Rel(Integration_Service, External_Lab_Imaging_Systems, "Exchanges clinical data securely", "HTTPS / mTLS / HL7 FHIR REST API with Resilience4j Circuit Breaker")
Rel(Message_Router, Message_Broker_Container, "Consumes and publishes integration events", "Kafka Protocol / TCP with Kafka Topic ACLs")
@enduml