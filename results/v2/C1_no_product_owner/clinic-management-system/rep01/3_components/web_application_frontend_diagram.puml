@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway & Edge Router", "Kong/Envoy", "External API Gateway and Edge Router routing frontend requests.")

Container_Boundary(web_application_frontend, "Web Application Frontend") {
    Component(spa_router_and_views, "SPA Router and Views", "React SPA", "Manages client-side routing and renders views for patient admissions, EMR, scheduling, and billing.")
    Component(http_api_client, "HTTP API Client", "Axios / Fetch API", "Handles secure communication with the API Gateway using REST/JSON over HTTPS.")
    Component(web_server_container, "Web Server Container", "Nginx Container", "Serves the static React SPA files and manages client delivery and performance.")
}

Rel(spa_router_and_views, http_api_client, "Requests data and invokes backend operations")
Rel(http_api_client, api_gateway, "Routes frontend requests", "REST/JSON over HTTPS")

@enduml