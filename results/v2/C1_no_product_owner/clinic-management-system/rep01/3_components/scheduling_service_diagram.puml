@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Scheduling Service container

System_Ext(api_gateway, "API Gateway & Edge Router", "Forwards API requests via mTLS and Istio/Linkerd service mesh")
System_Ext(message_broker, "Message Broker Container", "Handles asynchronous messaging")

Container_Boundary(scheduling_service, "Scheduling Service") {
    Component(appointment_controller, "Appointment Controller", "Spring MVC REST Controller", "Handles incoming API requests for appointment management.")
    Component(security_interceptor, "Security Interceptor", "Spring Security filter", "Validates local JWT claims and enforces RBAC.")
    Component(audit_logging, "Audit Logging Component", "Regulatory audit trail recorder", "Records regulatory audit trails.")
    Component(scheduling_engine, "Scheduling Engine", "Core domain logic", "Manages core scheduling domain logic.")
    Component(resource_clash_checker, "Resource Clash Checker", "Availability and conflict detection", "Performs availability and conflict detection with strict resource clash checks.")
    Component(distributed_lock_manager, "Distributed Lock Manager", "Redisson-based concurrency control", "Provides cluster-aware locks via TLS-secured Redis for concurrency control.")
    Component(notification_publisher, "Notification Publisher", "Spring Kafka event emitter", "Publishes asynchronous domain events via TLS/mTLS and SCRAM-SHA-512.")
    Component(scheduling_repository, "Scheduling Repository", "Spring Data JPA data access layer", "Provides persistent data access for appointment records via TLS-secured JDBC.")
}

Rel(api_gateway, appointment_controller, "Forwards API requests", "mTLS / Service Mesh")
Rel(security_interceptor, appointment_controller, "Validates local JWT claims and enforces RBAC", "Spring Security")
Rel(scheduling_engine, distributed_lock_manager, "Acquires cluster-aware locks", "TLS-secured Redis")
Rel(resource_clash_checker, scheduling_repository, "Queries availability", "TLS-secured JDBC")
Rel(notification_publisher, message_broker, "Publishes domain events", "TLS/mTLS and SCRAM-SHA-512")

@enduml