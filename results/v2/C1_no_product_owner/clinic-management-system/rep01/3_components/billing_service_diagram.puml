@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing Service container

Container_Boundary(billing_service, "Billing Service") {
    Component(Billing_API_Controller, "Billing API Controller", "Spring MVC", "Handles billing operations and incoming API requests.")
    Component(Claim_Management_Engine, "Claim Management Engine", "Spring Service", "Core business logic for insurance claim submissions and financial processing.")
    Component(Insurance_Integration_Adapter, "Insurance Integration Adapter", "Apache Camel / Spring Integration", "Integrates with external insurance clearinghouses using enterprise integration patterns.")
    Component(Billing_Data_Repository, "Billing Data Repository", "Spring Data JPA / PostgreSQL", "Manages relational persistence and transactional outbox writes.")
}

System_Ext(External_Insurance_Clearinghouses, "External Insurance Clearinghouses", "HTTPS with mTLS, OAuth2, and egress proxy filtering", "External systems for processing insurance claims.")
System_Ext(Message_Broker_Container, "Message Broker Container", "Apache Kafka", "Event streaming container implementing the transactional outbox pattern.")

Rel(Billing_API_Controller, Claim_Management_Engine, "Local Java method invocations")
Rel(Claim_Management_Engine, Billing_Data_Repository, "TLS-secured JDBC for atomic outbox writes")
Rel(Claim_Management_Engine, Message_Broker_Container, "TLS/mTLS and SCRAM-SHA-512 event publishing")
Rel(Insurance_Integration_Adapter, External_Insurance_Clearinghouses, "HTTPS with mTLS, OAuth2, and egress proxy filtering")

@enduml