@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Message Broker Container container

System_Ext(Microservices, "Microservices", "External microservices producing and consuming events.")
System_Ext(ProducerServices, "Producer Services", "External services producing clinical events.")
System_Ext(RegulatoryAuditSystem, "Regulatory Audit System", "External system for storing immutable audit logs.")
System_Ext(BrokerNodeClusterOnPrem, "Broker Node Cluster (On-Prem)", "On-premises Kafka broker cluster.")
System_Ext(BrokerNodeClusterEUCloud, "Broker Node Cluster (EU Cloud)", "EU Cloud Kafka broker cluster.")

Container_Boundary(MessageBrokerContainer, "Message Broker Container") {
    Component(BrokerNodeCluster, "Broker Node Cluster", "Apache Kafka", "Distributed partition-based messaging for high-throughput event streaming with AES-256 encryption.")
    Component(SchemaRegistry, "Schema Registry", "Confluent Schema Registry", "Enforces Avro/Protobuf schema validation for clinical events.")
    Component(KafkaConnectCluster, "Kafka Connect Cluster", "Kafka Connect", "Manages reliable integration sinks and sources, streaming audit events.")
    Component(MirrorMaker2, "MirrorMaker 2", "Apache Kafka MirrorMaker 2", "Handles cross-region replication between on-prem-k8s and eu-central-1.")
    Component(StrimziOperator, "Strimzi Operator", "Strimzi Kubernetes Operator", "Manages Kubernetes-native Kafka deployment, automated rolling upgrades, and mTLS certificate rotation.")
}

Rel(Microservices, BrokerNodeCluster, "Produce and consume events", "TCP [TLS 1.3 / mTLS & SCRAM-SHA-512]")
Rel(ProducerServices, SchemaRegistry, "Validate event schemas prior to publishing", "HTTP/REST [mTLS]")
Rel(BrokerNodeCluster, KafkaConnectCluster, "Stream CDC and audit data", "Internal TCP")
Rel(KafkaConnectCluster, RegulatoryAuditSystem, "Export immutable audit logs", "HTTPS [TLS 1.3]")
Rel(BrokerNodeClusterOnPrem, MirrorMaker2, "Replicate cross-region topics", "encrypted TCP [mTLS]")
Rel(MirrorMaker2, BrokerNodeClusterEUCloud, "Replicate cross-region topics", "encrypted TCP [mTLS]")

@enduml