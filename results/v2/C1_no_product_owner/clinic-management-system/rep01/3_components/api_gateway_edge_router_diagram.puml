@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway & Edge Router container

Person(Web_Application_Frontend, "Web Application Frontend", "")
System_Ext(Identity_Provider, "Identity Provider", "")
System_Ext(External_Lab_Systems, "External Lab Systems", "")
System(Patient_Service, "Patient Service", "")
System(EMR_Service, "EMR Service", "")
System(Billing_Service, "Billing Service", "")
System_Ext(Regulatory_Audit_System, "Regulatory Audit System", "")

Container_Boundary(api_gateway_edge_router, "API Gateway & Edge Router") {
    Component(Edge_Router_TLS_Termination_Plugin, "Edge Router & TLS Termination Plugin", "Kong/Envoy Plugin", "Manages ingress, GeoDNS routing, and terminates TLS 1.3.")
    Component(JWT_OAuth2_Authentication_Filter, "JWT/OAuth2 Authentication Filter", "Kong/Envoy Plugin / OAuth2 / OIDC", "Enforces OIDC token introspection, MFA, and dynamic clinical role scopes.")
    Component(Rate_Limiting_Circuit_Breaker, "Rate Limiting & Circuit Breaker", "Kong/Envoy Plugin", "Protects downstream microservices from DDoS and cascading failures.")
    Component(Request_Routing_Transformation_Engine, "Request Routing & Transformation Engine", "Kong/Envoy Plugin", "Translates REST/JSON to gRPC/mTLS payloads with canary splitting.")
    Component(Interoperability_FHIR_Proxy_Component, "Interoperability & FHIR Proxy Component", "Kong/Envoy Plugin / HL7 FHIR", "Validates schemas and mitigates threats for HL7 FHIR payloads.")
}

Rel(Web_Application_Frontend, Edge_Router_TLS_Termination_Plugin, "Routes requests", "REST/JSON over HTTPS")
Rel(JWT_OAuth2_Authentication_Filter, Identity_Provider, "Validates tokens", "OIDC over HTTPS")
Rel(Interoperability_FHIR_Proxy_Component, External_Lab_Systems, "Receives clinical data", "HL7 FHIR over HTTPS")
Rel(Request_Routing_Transformation_Engine, Patient_Service, "Dispatches traffic", "gRPC over mTLS / Istio")
Rel(Request_Routing_Transformation_Engine, EMR_Service, "Dispatches traffic", "gRPC over mTLS / Istio")
Rel(Request_Routing_Transformation_Engine, Billing_Service, "Dispatches traffic", "gRPC over mTLS / Istio")
Rel(api_gateway_edge_router, Regulatory_Audit_System, "Streams audit logs", "Sidecar Log Shipper")

@enduml