@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Patient Service", "Patient Service") {
    Component("Patient API Controller", "Patient API Controller", "Spring MVC (@RestController)", "Exposes RESTful endpoints for registration, demographics, and JSR-303 input validation.")
    Component("Patient Security Filter", "Patient Security Filter", "Spring Security (@Component)", "Intercepts requests for OAuth2/JWT token validation and RBAC scoping.")
    Component("Patient Domain Manager", "Patient Domain Manager", "Spring Service (@Service)", "Enforces clinical rules and propagates security context for asynchronous events.")
    Component("Audit Interceptor", "Audit Interceptor", "Spring AOP (@Component)", "Captures immutable access and modification events for HIPAA/GDPR compliance.")
    Component("Audit Event Buffer", "Audit Event Buffer", "SQLite / Durable Volume (@Component)", "Provides a local encrypted SQLite file/durable volume buffer for audit resilience.")
    Component("Patient Repository", "Patient Repository", "Spring Data JPA / HikariCP (@Repository)", "Manages data access with HikariCP connection pooling and HSM-managed AES-256 column encryption.")
}

System_Ext("Message Broker Container", "Message Broker Container", "Apache Kafka")

Rel("Patient API Controller", "Patient Security Filter", "Intercepts requests", "Spring Security Filter Chain")
Rel("Patient API Controller", "Patient Domain Manager", "Delegates requests", "Java Method Call")
Rel("Patient Domain Manager", "Patient Repository", "Queries and persists entity data", "TLS-secured JDBC/JPA")
Rel("Patient Domain Manager", "Audit Interceptor", "Triggers audit logging events", "Spring AOP/Event")
Rel("Audit Interceptor", "Audit Event Buffer", "Writes to local durable fallback storage on broker failure", "Local File Buffer")
Rel("Audit Interceptor", "Message Broker Container", "Forwards audit events asynchronously", "TLS/mTLS and SCRAM-SHA-512 via Apache Kafka")
@enduml