@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(emr_service, "EMR Service") {
    Component(emr_api_controller, "EMR API Controller", "Spring MVC", "Exposes RESTful endpoints for clinical documentation and payload validation.")
    Component(clinical_record_manager, "Clinical Record Manager", "Spring Service", "Contains domain logic, ABAC authorization, and an encrypted local Caffeine cache using AES-256 envelope encryption with memory-locking (mlock).")
    Component(fhir_transformer, "FHIR Transformer", "HAPI FHIR Library", "Maps internal clinical models to HL7 FHIR standards.")
    Component(audit_trail_publisher, "Audit Trail Publisher", "Java / Write-Ahead Log", "Publishes cryptographically signed, non-repudiation audit events backed by a local durable write-ahead log (WAL).")
    Component(data_persistence_layer, "Data Persistence Layer", "PostgreSQL & TLS-secured JDBC", "Relational data storage utilizing TLS-secured connections and HSM column encryption for 10-year data retention.")
    Component(message_broker_container, "Message Broker Container", "Apache Kafka & MirrorMaker", "Geo-local Apache Kafka clusters using MirrorMaker, secured via TLS/mTLS and SCRAM-SHA-512.")
}

Rel(emr_api_controller, clinical_record_manager, "In-process method calls")
Rel(clinical_record_manager, fhir_transformer, "In-process domain-to-FHIR mapping", "Java objects")
Rel(clinical_record_manager, data_persistence_layer, "Queries and persists clinical records", "TLS-secured JDBC")
Rel(audit_trail_publisher, message_broker_container, "Publishes signed audit events", "TLS/mTLS and SCRAM-SHA-512")

@enduml