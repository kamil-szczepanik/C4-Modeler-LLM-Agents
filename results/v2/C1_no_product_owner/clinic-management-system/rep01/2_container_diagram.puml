@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(HospitalStaff, "Hospital Staff", "Doctors, nurses, and admins interacting with the system to manage clinic operations.")

System_Ext(PatientPortal, "Patient Portal", "External system or actor for patient self-service access.")
System_Ext(ExternalLabImagingSystems, "External Lab & Imaging Systems", "Third-party clinical systems for lab and imaging integration.")
System_Ext(InsuranceClearinghouses, "Insurance Clearinghouses", "External systems used for medical claim submissions.")
System_Ext(IdentityProviderIdP, "Identity Provider (IdP)", "Enterprise authentication system handling identity management.")
System_Ext(RegulatoryAuditSystem, "Regulatory Audit System", "External system responsible for compliance log ingestion.")

System_Boundary(ClinicManagementSystem, "Clinic Management System") {
    Container(APIGatewayEdgeRouter, "API Gateway & Edge Router", "Kong/Envoy", "Edge routing, TLS termination, and mTLS enforcement.")
    Container(WebApplicationFrontend, "Web Application Frontend", "React SPA, Nginx", "Frontend delivery for hospital staff.")
    Container(PatientService, "Patient Service", "Spring Boot, Kubernetes", "Manages patient admission and demographic data.")
    Container(SchedulingService, "Scheduling Service", "Spring Boot, Kubernetes", "Manages hospital staff and patient appointments.")
    Container(EMRService, "EMR Service", "Spring Boot, Kubernetes", "Manages electronic medical records.")
    Container(BillingService, "Billing Service", "Spring Boot, Kubernetes", "Manages billing and insurance processing.")
    Container(IntegrationService, "Integration Service", "Apache Camel/Node.js", "Integrates external lab and imaging systems.")
    ContainerDb(DataPersistenceLayer, "Data Persistence Layer", "PostgreSQL with AES-256 and HSM-managed column encryption", "Multi-region primary and replica data storage with 10-year retention support.")
    Container(MessageBrokerContainer, "Message Broker Container", "Geo-local Apache Kafka clusters with MirrorMaker", "Asynchronous event-driven communication via geo-local clusters.")
}

Rel(HospitalStaff, WebApplicationFrontend, "Accesses system functionality", "HTTPS")
Rel(WebApplicationFrontend, APIGatewayEdgeRouter, "Routes frontend requests", "REST/JSON over HTTPS")
Rel(APIGatewayEdgeRouter, PatientService, "Forwards API requests", "mTLS and service mesh (Istio/Linkerd)")
Rel(APIGatewayEdgeRouter, SchedulingService, "Forwards API requests", "mTLS and service mesh (Istio/Linkerd)")
Rel(APIGatewayEdgeRouter, EMRService, "Forwards API requests", "mTLS and service mesh (Istio/Linkerd)")
Rel(APIGatewayEdgeRouter, BillingService, "Forwards API requests", "mTLS and service mesh (Istio/Linkerd)")
Rel(PatientService, DataPersistenceLayer, "Persists patient data", "TLS-secured JDBC")
Rel(SchedulingService, DataPersistenceLayer, "Persists scheduling data", "TLS-secured JDBC")
Rel(EMRService, DataPersistenceLayer, "Persists EMR data", "TLS-secured JDBC")
Rel(BillingService, DataPersistenceLayer, "Persists billing data", "TLS-secured JDBC")
Rel(PatientService, MessageBrokerContainer, "Publishes and consumes events", "TLS/mTLS and SCRAM-SHA-512")
Rel(SchedulingService, MessageBrokerContainer, "Publishes and consumes events", "TLS/mTLS and SCRAM-SHA-512")
Rel(EMRService, MessageBrokerContainer, "Publishes and consumes events", "TLS/mTLS and SCRAM-SHA-512")
Rel(BillingService, MessageBrokerContainer, "Publishes and consumes events", "TLS/mTLS and SCRAM-SHA-512")
Rel(IntegrationService, ExternalLabImagingSystems, "Exchanges clinical data securely", "HL7 FHIR APIs")

@enduml