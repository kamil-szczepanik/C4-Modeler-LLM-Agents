@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(HospitalStaff, "Hospital Staff", "Doctors, nurses, and admins interacting with the system via HTTPS and MFA to manage clinic operations.")
System_Ext(PatientPortal, "Patient Portal", "External system or actor for patient self-service access.")
System(ClinicManagementSystem, "Clinic Management System", "A hybrid cloud platform designed to manage patient admissions, electronic medical records, appointments, and billing for medium-sized hospitals and clinics with strict HIPAA/GDPR compliance.")
System_Ext(ExternalLabImagingSystems, "External Lab & Imaging Systems", "Third-party clinical systems for lab and imaging integration.")
System_Ext(InsuranceClearinghouses, "Insurance Clearinghouses", "External systems used for medical claim submissions.")
System_Ext(IdentityProviderIdP, "Identity Provider (IdP)", "Enterprise authentication system (Azure AD / Keycloak) handling identity management.")
System_Ext(RegulatoryAuditSystem, "Regulatory Audit System", "External system responsible for compliance log ingestion.")

Rel(HospitalStaff, ClinicManagementSystem, "Accesses system functionality and manages patient data", "HTTPS (TLS 1.3), OIDC/SAML 2.0, OAuth2, MFA")
Rel(PatientPortal, ClinicManagementSystem, "Performs self-service patient actions", "HTTPS (TLS 1.3), OIDC/SAML 2.0, OAuth2")
Rel(ClinicManagementSystem, ExternalLabImagingSystems, "Exchanges clinical data securely", "HL7 FHIR REST APIs over mTLS")
Rel(ClinicManagementSystem, InsuranceClearinghouses, "Submits claims and billing information", "SFTP / HIPAA-compliant EDI (X12)")
Rel(ClinicManagementSystem, IdentityProviderIdP, "Authenticates users and validates tokens", "OIDC / SAML 2.0")
Rel(ClinicManagementSystem, RegulatoryAuditSystem, "Sends compliance audit logs and telemetry", "Cryptographically signed webhooks/syslog over TLS")

@enduml