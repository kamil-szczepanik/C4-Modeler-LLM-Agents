@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalyst, "Fraud Analyst", "Reviews cases and manages fraud investigations.")
System_Ext(PaymentGatewayCoreLedger, "Payment Gateway / Core Ledger", "Sends payment authorizations for real-time fraud evaluation.")
System_Ext(CardSchemesIdentityProviders, "Card Schemes / Identity Providers", "External services called via REST APIs for additional verification.")
System_Ext(ComplianceAuditor, "Compliance / Auditor", "Reviews tamper-evident audit logs for regulatory compliance.")

System(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System", "Evaluates card-not-present payment authorizations for fraud in under 50 milliseconds while providing case management for analysts, adhering to PCI-DSS Level 1 compliance.")

Rel(PaymentGatewayCoreLedger, RealTimePaymentFraudScreeningSystem, "Sends payment authorizations for screening", "gRPC over TLS 1.3 (mTLS)")
Rel(FraudAnalyst, RealTimePaymentFraudScreeningSystem, "Manages fraud cases and reviews alerts", "HTTPS (OIDC/SAML)")
Rel(RealTimePaymentFraudScreeningSystem, CardSchemesIdentityProviders, "Queries external APIs for enrichment", "HTTPS REST")
Rel(ComplianceAuditor, RealTimePaymentFraudScreeningSystem, "Accesses audit logs for compliance verification", "HTTPS / AWS IAM")

@enduml