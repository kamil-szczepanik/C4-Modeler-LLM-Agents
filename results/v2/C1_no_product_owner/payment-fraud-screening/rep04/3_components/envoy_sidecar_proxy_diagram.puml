@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(API_Gateway, "API Gateway", "External API Gateway")
System_Ext(Scoring_Engine, "Scoring Engine", "Scoring containers evaluating transactions")
System_Ext(Prometheus, "Prometheus", "Metrics collection and observability system")

Container_Boundary(Envoy_Sidecar_Proxy_container, "Envoy Sidecar Proxy") {
    Component(Listener___TLS_Termination_Component, "Listener & TLS Termination Component", "BoringSSL", "Handles incoming traffic using BoringSSL and manages mTLS termination.")
    Component(Routing___Load_Balancing_Component, "Routing & Load Balancing Component", "HTTP/2 & gRPC", "Forwards gRPC/HTTP2 traffic to scoring containers.")
    Component(Circuit_Breaker___Retry_Component, "Circuit Breaker & Retry Component", "Envoy C++", "Provides outlier detection, active health checks, and circuit breaking.")
    Component(Telemetry___Tracing_Component, "Telemetry & Tracing Component", "Prometheus", "Emits metrics and distributed trace headers, and exports metrics to Prometheus via /stats/prometheus.")
}

Rel(API_Gateway, Listener___TLS_Termination_Component, "Sends HTTPS traffic to", "HTTPS")
Rel(Listener___TLS_Termination_Component, Routing___Load_Balancing_Component, "Passes decrypted traffic to", "")
Rel(Routing___Load_Balancing_Component, Scoring_Engine, "Routes gRPC/HTTP2 traffic to", "gRPC / HTTP/2")
Rel(Circuit_Breaker___Retry_Component, Routing___Load_Balancing_Component, "Applies outlier detection and active health checks to", "")
Rel(Telemetry___Tracing_Component, Prometheus, "Exports metrics to via /stats/prometheus", "HTTP")

@enduml