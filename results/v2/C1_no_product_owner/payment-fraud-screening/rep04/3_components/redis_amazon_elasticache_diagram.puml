@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Redis / Amazon ElastiCache container

System_Ext(Scoring_Engine, "Scoring Engine", "Evaluates card-not-present authorizations and performs feature lookups.")
System_Ext(AWS_IAM_KMS, "AWS IAM / KMS", "Provides identity and encryption key management.")

Container_Boundary(redis_amazon_elasticache, "Redis / Amazon ElastiCache") {
    Component(In_Memory_Data_Store, "In-Memory Data Store", "Redis / Amazon ElastiCache", "Provides high-performance feature lookups and caching for the scoring engine over RESP via TLS 1.3 with AWS IAM Authentication.")
}

Rel(Scoring_Engine, In_Memory_Data_Store, "Executes feature lookups over RESP via TLS 1.3 with AWS IAM Authentication", "TCP/6379")
Rel(AWS_IAM_KMS, In_Memory_Data_Store, "Enforces identity and encryption policies over HTTPS/TLS", "TCP/443")

@enduml