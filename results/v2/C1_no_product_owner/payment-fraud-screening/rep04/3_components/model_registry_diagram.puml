@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Model Registry container

Container_Boundary(model_registry, "Model Registry") {
    Component(model_storage_manager, "Model Storage Manager", "Python, boto3, S3 Object Lock", "Applies Object Lock Compliance Mode and versioning to securely manage model artifacts.")
    Component(registry_rest_api, "Registry REST API", "FastAPI, AWS ECS Fargate", "Provides REST endpoints to serve model metadata and version pointers.")
    Component(mlflow_client_library, "MLflow Client Library", "Python, serverless logging", "Handles serverless logging and interaction with model metadata.")
    Component(amazon_s3, "Amazon S3", "KMS-encrypted model artifact repository, S3 Object Lock", "Immutable storage satisfying 7-year audit retention and artifact storage.")
}

Component(scoring_engine, "Scoring Engine", "Consumer of model artifacts", "Consumes model artifacts and fetches active model metadata.")

Rel(scoring_engine, registry_rest_api, "Fetches active model metadata and pointers", "gRPC over TLS 1.3")
Rel(registry_rest_api, amazon_s3, "Reads model artifacts and version pointers", "boto3 / HTTPS")
Rel(model_storage_manager, amazon_s3, "Applies Object Lock Compliance Mode and versioning", "boto3 / HTTPS")

@enduml