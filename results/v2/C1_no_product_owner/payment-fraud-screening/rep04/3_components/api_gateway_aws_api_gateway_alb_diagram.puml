@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Payment_Gateway, "Payment Gateway / Core Ledger", "Sends payment authorizations via HTTPS/REST (3,000 TPS)")

Container_Boundary(API_Gateway, "API Gateway (AWS API Gateway / ALB)") {
    Component(AWS_Application_Load_Balancer, "AWS Application Load Balancer", "AWS ALB / WAF", "Handles edge routing, L7 DDoS and injection protection, and TLS 1.3 termination.")
}

System_Ext(Envoy_Sidecar_Proxy, "Envoy Sidecar Proxy", "Zero-trust service mesh mTLS enforcement")

Rel(Payment_Gateway, AWS_Application_Load_Balancer, "Sends payment authorizations", "HTTPS/REST")
Rel(AWS_Application_Load_Balancer, Envoy_Sidecar_Proxy, "Forwards traffic", "TLS 1.3 and gRPC over HTTP/2")

@enduml