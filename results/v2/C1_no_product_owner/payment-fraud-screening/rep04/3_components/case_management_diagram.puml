@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalyst, "Fraud Analyst", "Fraud investigator reviewing suspicious payment authorizations.")
System_Ext(AmazonSQS, "Amazon SQS", "Cloud-based message queue for review-routed events.")
System_Ext(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL", "Relational database for case states and audit logs.")
System_Ext(AWSKMS, "AWS KMS", "Managed service for cryptographic operations and tamper-evident signatures.")

Container_Boundary(CaseManagement, "Case Management") {
    Component(CaseAPIController, "Case API Controller", "NestJS (Node.js/TypeScript)", "NestJS-based entry point handling HTTPS/REST requests from analysts.")
    Component(MaskingInterceptorComponent, "Masking Interceptor Component", "In-process middleware", "In-process middleware that sanitizes payloads and enforces R-05 data masking.")
    Component(CaseWorkflowEngine, "Case Workflow Engine", "NestJS / AWS SQS Consumer", "Manages review states and consumes asynchronous messages from Amazon SQS.")
    Component(AuditLoggerComponent, "Audit Logger Component", "AWS SDK / AWS KMS / Amazon Aurora PostgreSQL", "Generates tamper-evident cryptographic signatures using AWS KMS and persists data to Amazon Aurora PostgreSQL.")
}

Rel(FraudAnalyst, CaseAPIController, "Manages cases", "HTTPS/REST [JSON, OIDC/OAuth2, TLS 1.3]")
Rel(CaseAPIController, MaskingInterceptorComponent, "Sanitizes payloads", "In-process")
Rel(CaseWorkflowEngine, AmazonSQS, "Consumes review-routed events", "HTTPS/SQS Protocol")
Rel(CaseWorkflowEngine, AmazonAuroraPostgreSQL, "Persists case states and audit logs", "TLS/JDBC")
Rel(AuditLoggerComponent, AWSKMS, "Generates cryptographic signatures", "AWS SDK / TLS")

@enduml