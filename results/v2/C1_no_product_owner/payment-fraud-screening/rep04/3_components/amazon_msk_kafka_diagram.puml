@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon MSK / Kafka container

System_Boundary(amazon_msk_kafka, "Amazon MSK / Kafka") {
    Component(payment_authorizations_in, "payment-authorizations-in", "Apache Kafka Topic", "Kafka topic receiving incoming payment events for parallel scoring.")
    Component(fraud_decisions_out, "fraud-decisions-out", "Apache Kafka Topic", "Kafka topic publishing scored outcomes back to edge services.")
    Component(fraud_decisions_audit, "fraud-decisions-audit", "Apache Kafka Topic", "Kafka topic streaming transaction records for compliance and auditing.")
}

Component(scoring_engine_go, "Scoring Engine (Go)", "Go Service", "Real-time scoring engine for payment authorizations.")
Component(go_audit_consumer, "Go Audit Consumer", "Go Service", "Lightweight service streaming audit events from MSK to long-term storage.")

Rel(scoring_engine_go, payment_authorizations_in, "Produces and consumes payment events", "Kafka Protocol over TLS 1.3 with SASL/SCRAM")
Rel(payment_authorizations_in, scoring_engine_go, "Delivers events for parallel scoring", "Kafka Protocol")
Rel(scoring_engine_go, fraud_decisions_out, "Publishes scored outcomes", "Kafka Protocol over TLS 1.3 with SASL/SCRAM")
Rel(scoring_engine_go, fraud_decisions_audit, "Streams transaction records for compliance", "Kafka Protocol over TLS 1.3 with SASL/SCRAM")
Rel(fraud_decisions_audit, go_audit_consumer, "Streams audit events for long-term storage", "Kafka Protocol")

@enduml