@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalyst, "Fraud Analyst", "Fraud analyst responsible for investigating suspicious transactions and managing fraud cases using MFA and RBAC.")

System(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System", "Screens card-not-present payment authorizations and provides case management for fraud analysts, maintaining sub-50ms latency at 3,000 TPS with PCI-DSS Level 1 compliance.")

System_Ext(PaymentGatewayAcquirer, "Payment Gateway / Acquirer", "External payment gateway sending card-not-present payment authorizations for real-time scoring.")
System_Ext(CardNetworksTokenizationVault, "Card Networks & Tokenization Vault", "External vault used for token resolution.")
System_Ext(CoreBankingLedgerSystem, "Core-Banking / Ledger System", "External core-banking ledger system used for final transaction disposition.")
System_Ext(ModelTrainingEnvironment, "Model Training Environment", "External environment for training machine learning models and providing model artifacts.")

Rel(PaymentGatewayAcquirer, RealTimePaymentFraudScreeningSystem, "for real-time scoring", "gRPC over HTTP/2")
Rel(FraudAnalyst, RealTimePaymentFraudScreeningSystem, "for case management and investigations", "HTTPS with MFA and RBAC")
Rel(RealTimePaymentFraudScreeningSystem, CardNetworksTokenizationVault, "for token resolution", "mTLS / HTTPS")
Rel(RealTimePaymentFraudScreeningSystem, CoreBankingLedgerSystem, "for transaction disposition", "HTTPS / REST")
Rel(ModelTrainingEnvironment, RealTimePaymentFraudScreeningSystem, "for secure model artifact ingestion", "AWS Signer / KMS cryptographic verification")

@enduml