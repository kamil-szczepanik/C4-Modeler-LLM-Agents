@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway & Routing Layer container

Container_Boundary(api_gateway_boundary, "API Gateway & Routing Layer") {
    Component(AWS_ALB_WAF, "AWS ALB & AWS WAF", "AWS ALB & AWS WAF", "Handles edge termination, HTTPS mTLS, and WAF filtering for incoming authorization requests.")
    Component(Go_Routing_Tokenization_Proxy, "Go Routing & Tokenization Proxy", "Go", "Resolves PAN to tokens via the Tokenization Vault and forwards scrubbed payloads to the scoring service.")
}

Rel(AWS_ALB_WAF, Go_Routing_Tokenization_Proxy, "Routes authenticated and filtered HTTP requests", "HTTP")

@enduml