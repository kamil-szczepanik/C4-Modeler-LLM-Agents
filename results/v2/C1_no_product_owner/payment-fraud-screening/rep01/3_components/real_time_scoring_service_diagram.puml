@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Real-Time Scoring Service container

System_Ext(api_gateway, "API Gateway & Routing Layer", "External routing layer")
System_Ext(card_networks, "Card Networks & Tokenization Vault", "External tokenization vaults and card networks")
System_Ext(dynamodb, "Amazon DynamoDB", "NoSQL database for audit logs and decision payloads")
System_Ext(model_training, "Model Training Environment", "Source for signed model artifacts")

Container_Boundary(real_time_scoring_service, "Real-Time Scoring Service") {
    Component(api_handler_component, "API Handler Component", "Go (net/http + gRPC)", "Forwards low-latency evaluation requests and handles API routing.")
    Component(token_resolution_client_component, "Token Resolution Client Component", "Go (net/http)", "Fetches tokenized attributes from card networks and tokenization vaults.")
    Component(feature_store_cache_component, "Feature Store Cache Component", "Embedded Go LRU Cache / Redis Client", "Provides fast caching for feature store retrieval.")
    Component(scoring_engine_component, "Scoring Engine Component", "Go WebAssembly / ONNX runtime", "Executes lightweight machine learning models in-memory for fraud scoring.")
    Component(audit_event_dispatcher_component, "Audit & Event Dispatcher Component", "Go AWS SDK", "Writes immutable decision payloads and audit logs.")
    Component(circuit_breaker_fallback_component, "Circuit Breaker / Fallback Component", "Go (gobreaker)", "Provides resilience and fallback mechanisms during downstream failures.")
}

Rel(api_gateway, api_handler_component, "Forwards low-latency evaluation requests", "gRPC")
Rel(token_resolution_client_component, card_networks, "Fetches tokenized attributes", "mTLS / HTTPS")
Rel(audit_event_dispatcher_component, dynamodb, "Writes immutable decision payloads and audit logs", "AWS KMS / DynamoDB API")
Rel(scoring_engine_component, model_training, "Ingests signed model artifacts", "AWS Signer / KMS")

@enduml