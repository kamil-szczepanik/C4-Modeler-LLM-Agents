@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data & Audit Stores container

System_Ext(Real_Time_Scoring_Service, "Real-Time Scoring Service", "External system interacting with data and audit stores.")
System_Ext(Case_Management_Backend, "Case Management Backend", "External backend managing cases and analyst workflows.")

Container_Boundary(data_and_audit_stores, "Data & Audit Stores") {
    Component(Audit_Decision_Log_Store, "Audit & Decision Log Store", "Amazon DynamoDB with AWS KMS and DynamoDB Streams", "Appends immutable decision records and provides tamper-evident 7-year audit logging.")
    Component(Feature_Store, "Feature Store", "Amazon DynamoDB", "Provides secure, low-latency feature storage for real-time fraud screening.")
    Component(Case_Management_Database, "Case Management Database", "Amazon RDS PostgreSQL", "Handles relational case management data persistence for complex analyst workflows.")
    Component(Audit_Archival_Worker, "Audit Archival Worker", "AWS Lambda", "Processes change records from DynamoDB Streams with minimal operational overhead.")
    Component(Long_Term_Audit_Archive, "Long-Term Audit Archive", "Amazon S3 Glacier Flexible Retrieval with S3 Object Lock", "Stores tamper-evident 7-year audit archives meeting budget and compliance constraints.")
}

Rel(Real_Time_Scoring_Service, Feature_Store, "Read/write fraud features via DynamoDB SDK", "HTTPS/TLS 1.3")
Rel(Real_Time_Scoring_Service, Audit_Decision_Log_Store, "Appends immutable decision records via DynamoDB API", "HTTPS/TLS 1.3")
Rel(Case_Management_Backend, Case_Management_Database, "Relational data persistence", "PostgreSQL JDBC (TLS 1.3)")
Rel(Audit_Decision_Log_Store, Audit_Archival_Worker, "Streams change records", "DynamoDB Streams (Internal AWS Event Source)")
Rel(Audit_Archival_Worker, Long_Term_Audit_Archive, "Writes tamper-evident archives via S3 API", "HTTPS/TLS 1.3")

@enduml