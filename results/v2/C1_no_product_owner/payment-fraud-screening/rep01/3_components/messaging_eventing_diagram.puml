@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Messaging & Eventing container

Container_Boundary(messaging_and_eventing, "Messaging & Eventing") {
    Component(Audit_Event_Publisher, "Audit Event Publisher", "Lightweight Go client with asynchronous batching", "Publishes audit logs asynchronously to the Audit SNS Topic.")
    Component(Case_Queue, "Case Queue", "Amazon SQS FIFO Queue", "Ensures strict message ordering per account for review workflows, featuring content-based deduplication and a DLQ.")
    Component(Model_Event_Bus, "Model Event Bus", "Amazon EventBridge", "Broadcasts model hot-reloading signals to the scoring service.")
    Component(Audit_SNS_Topic, "Audit SNS Topic", "Amazon SNS", "Provides reliable fan-out pattern for audit logs with encryption.")
}

Rel(Audit_Event_Publisher, Audit_SNS_Topic, "Publishes audit logs", "HTTPS, AWS KMS CMK encryption")
Rel(Model_Event_Bus, Real_Time_Scoring_Service, "Broadcasts model hot-reloading signals", "HTTPS")
Rel(Real_Time_Scoring_Service, Case_Queue, "Sends review cases for suspicious transactions", "Amazon SQS FIFO API, HTTPS, AWS KMS CMK encryption")
Rel(Case_Queue, Case_Management_Backend, "Long-polling for review workflows", "AWS SDK, HTTPS")
@enduml