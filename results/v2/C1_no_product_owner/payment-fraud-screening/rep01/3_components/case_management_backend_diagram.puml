@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management Backend container

Container_Boundary(case_management_backend, "Case Management Backend") {
    Component(Workflow_Engine_Component, "Workflow Engine Component", "Spring State Machine", "Manages analyst review workflows and fraud cases using state machines.")
    Component(Analyst_Portal_API_Controller, "Analyst Portal API Controller", "Spring MVC/REST", "Provides REST endpoints for the analyst portal and invokes workflow operations.")
    Component(Case_Repository_Layer, "Case Repository Layer", "Spring Data JPA", "Handles data persistence and retrieval of case state via Amazon RDS PostgreSQL.")
    Component(Tokenization_Masking_Service_Client, "Tokenization & Masking Service Client", "Spring Cloud OpenFeign with Resilience4j", "Retrieves masked payload data for rendering case details and communicates with external vaults.")
}

System_Ext(Card_Networks_Tokenization_Vault, "Card Networks & Tokenization Vault", "External tokenization vault securely storing card data.")

Rel(Analyst_Portal_API_Controller, Workflow_Engine_Component, "Invokes", "direct method calls")
Rel(Analyst_Portal_API_Controller, Case_Repository_Layer, "Persists and retrieves state", "Amazon RDS PostgreSQL")
Rel(Workflow_Engine_Component, Case_Repository_Layer, "Persists state using optimistic locking", "Amazon RDS PostgreSQL")
Rel(Analyst_Portal_API_Controller, Tokenization_Masking_Service_Client, "Retrieves masked payload data", "for rendering case details")
Rel(Tokenization_Masking_Service_Client, Card_Networks_Tokenization_Vault, "Fetches tokenized card data", "mTLS and IAM authentication")

@enduml