@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon API / Application Load Balancer (ALB) container

Container_Boundary(alb_container, "Amazon Application Load Balancer (ALB)") {
    Component(HTTPS Listener and Edge Router, "HTTPS Listener and Edge Router", "AWS Application Load Balancer (ALB) Listener", "Accepts incoming payment authorization requests and analyst traffic via HTTPS.")
    Component(gRPC Routing and TLS Termination Module, "gRPC Routing and TLS Termination Module", "ALB gRPC Routing with mTLS", "Terminates perimeter TLS 1.3 encryption and routes internal traffic to backend services.")
}

Rel(HTTPS Listener and Edge Router, gRPC Routing and TLS Termination Module, "Forwards validated external requests for internal gRPC routing", "HTTPS / gRPC")

@enduml