@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon QLDB / S3 Object Lock buckets container

Container_Boundary(qlbd_s3_container, "Amazon QLDB / S3 Object Lock buckets") {
    Component(Fraud_Scoring_Engine, "Fraud Scoring Engine", "Go/Rust on Amazon ECS Fargate", "Screens card-not-present payment authorizations to detect fraud and appends decision journals.")
    Component(Case_Management_Service, "Case Management Service", "Node.js/Python on Amazon ECS Fargate", "Manages review cases and uploads case artifacts.")
    Component(Transaction_Ledger_Component, "Transaction Ledger Component", "Amazon QLDB", "Provides cryptographically verifiable immutability for decision journals.")
    Component(Evidence_Archive_Component, "Evidence Archive Component", "Amazon S3 with Object Lock", "Enforces Write-Once-Read-Many (WORM) compliance storage for 7 years.")
    Component(Audit_Export___Verification_Worker, "Audit Export & Verification Worker", "AWS Lambda", "Executes serverless audit verification, verifies hash chains, manages retention, and exports data.")
    Component(Infrastructure_Security___Storage, "Infrastructure Security & Storage", "AWS KMS, Amazon CloudWatch, Amazon SQS", "Secures data encryption, manages alerts, and provides supporting infrastructure services.")
}

Component(Amazon_CloudWatch___Amazon_SNS, "Amazon CloudWatch / Amazon SNS", "AWS", "External alerting and monitoring service.")

Rel(Fraud_Scoring_Engine, Transaction_Ledger_Component, "Appends decision journal", "AWS SDK / QLDB Driver over TLS 1.3")
Rel(Case_Management_Service, Evidence_Archive_Component, "Uploads case artifacts", "AWS SDK over HTTPS")
Rel(Audit_Export___Verification_Worker, Transaction_Ledger_Component, "Verifies hash chains", "AWS SDK / QLDB Driver")
Rel(Audit_Export___Verification_Worker, Evidence_Archive_Component, "Manages retention and exports", "AWS SDK / S3 API")
Rel(Audit_Export___Verification_Worker, Amazon_CloudWatch___Amazon_SNS, "Triggers alerts on verification failures", "AWS SDK / HTTPS")

@enduml