@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS KMS (Key Management Service) container

System_Ext(fraud_scoring_engine_and_case_management_service, "Fraud Scoring Engine and Case Management Service", "External application container")
System_Ext(aws_cloudtrail_and_s3_object_lock, "AWS CloudTrail & S3 Object Lock", "Audit logging service")

Container_Boundary(aws_kms, "AWS KMS (Key Management Service)") {
    Component(key_management_api_component, "Key Management API Component", "AWS SDK, HTTPS/TLS 1.3, SigV4", "Processes cryptographic requests from application containers via the AWS SDK.")
    Component(hardware_security_module_hsm_interface_component, "Hardware Security Module (HSM) Interface Component", "FIPS 140-2 Level 3 Hardware Security Modules", "Interfaces with FIPS 140-2 Level 3 validated dedicated HSMs for secure key storage and cryptographic operations.")
    Component(key_policy_access_control_component, "Key Policy & Access Control Component", "AWS IAM, SigV4, Resource-based policies, KMS Grant constraints", "Enforces IAM, SigV4 authentication, resource-based policies, and KMS Grant constraints.")
    Component(key_rotation_lifecycle_manager_component, "Key Rotation & Lifecycle Manager Component", "AWS KMS automated lifecycle controls", "Manages automated annual rotation of Customer Master Keys (CMKs) without downtime.")
}

Rel(fraud_scoring_engine_and_case_management_service, key_management_api_component, "Invokes via AWS SDK over HTTPS/TLS 1.3 with SigV4 authentication for envelope encryption and data key generation.", "HTTPS/TLS 1.3, SigV4")
Rel(aws_kms, aws_cloudtrail_and_s3_object_lock, "Exports tamper-evident audit logs via AWS CloudTrail for 7-year retention.", "AWS CloudTrail")

@enduml