@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(Amazon_DynamoDB_and_Amazon_Aurora_Serverless_v2, "Amazon DynamoDB and Amazon Aurora Serverless v2") {
    Component(Amazon_DynamoDB, "Amazon DynamoDB", "Key-Value Store (On-Demand)", "Delivers sub-10ms operational lookups for velocity and rules within budget.")
    Component(Amazon_Aurora_Serverless_v2, "Amazon Aurora Serverless v2", "Aurora PostgreSQL v15", "Provides relational persistence for case management with a non-zero ACU floor for P99 latency.")
    Component(Amazon_RDS_Proxy, "Amazon RDS Proxy", "PostgreSQL Protocol", "Manages and pools database connections to prevent connection exhaustion.")
}

Rel(Amazon_RDS_Proxy, Amazon_Aurora_Serverless_v2, "PostgreSQL Protocol", "PostgreSQL Protocol")

@enduml