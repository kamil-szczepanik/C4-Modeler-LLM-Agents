@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Amazon ElastiCache Serverless", "Amazon ElastiCache Serverless") {
    Component("Rule & Model Cache Manager", "Rule & Model Cache Manager", "Amazon ElastiCache Serverless (Redis)", "Provides sub-millisecond in-memory lookups for rules and models to meet strict latency goals.")
    Component("Data Replication & Sharding Engine", "Data Replication & Sharding Engine", "Amazon ElastiCache Serverless (Redis)", "Handles data replication and sharding for high availability and performance.")
    Component("Encryption & Auth Gateway", "Encryption & Auth Gateway", "Amazon ElastiCache Serverless (Redis)", "Secures in-memory reads/writes using RESP over TLS 1.3 with mTLS and Redis AUTH.")
}

Rel("Encryption & Auth Gateway", "Rule & Model Cache Manager", "Routes authenticated and encrypted read/write requests")
Rel("Rule & Model Cache Manager", "Data Replication & Sharding Engine", "Persists and synchronizes cached rule and model data across shards")

@enduml