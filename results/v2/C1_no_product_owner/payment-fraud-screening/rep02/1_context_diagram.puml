@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalysts, "Fraud Analysts", "Users reviewing suspicious transactions and updating rules.")

System(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System", "Screens card-not-present payment authorizations for fraud prior to approval and provides a case management interface for fraud analysts.")

System_Ext(PaymentGatewayAcquirerSystems, "Payment Gateway / Acquirer Systems", "External system initiating payment authorization requests.")
System_Ext(CardNetworksTokenizationVaults, "Card Networks / Tokenization Vaults", "External system providing token resolution and cardholder data.")
System_Ext(AuditComplianceArchive, "Audit / Compliance Archive", "External WORM storage retaining immutable decision logs for 7 years.")
System_Ext(IdentityProvideIdP, "Identity Provider (IdP)", "External system managing analyst credentials and multi-factor authentication.")

Rel(PaymentGatewayAcquirerSystems, RealTimePaymentFraudScreeningSystem, "Submits tokenized authorization requests", "REST/gRPC over TLS 1.3")
Rel(FraudAnalysts, RealTimePaymentFraudScreeningSystem, "Reviews cases and updates rules", "HTTPS")
Rel(FraudAnalysts, IdentityProvideIdP, "Authenticates using OIDC/OAuth 2.0 and FIDO2/WebAuthn MFA", "HTTPS")
Rel(RealTimePaymentFraudScreeningSystem, AuditComplianceArchive, "Stores tamper-evident decision logs", "AWS S3 Object Lock")

@enduml