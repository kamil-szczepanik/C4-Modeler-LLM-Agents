@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon S3 with Object Lock container

Container_Boundary(amazon_s3_with_object_lock, "Amazon S3 with Object Lock") {
    Component(Amazon_S3_Bucket, "Amazon S3 Bucket", "Amazon S3 Object Lock (Compliance Mode)", "Core storage configured with Object Lock for unalterable 7-year retention ensuring PCI-DSS Level 1 compliance.")
    Component(AWS_KMS, "AWS KMS", "AWS Key Management Service", "Manages customer-managed encryption keys (CMK) for server-side encryption-at-rest.")
    Component(Amazon_S3_Gateway_VPC_Endpoint, "Amazon S3 Gateway VPC Endpoint", "AWS VPC Gateway Endpoint", "Enforces private, zero-trust network routing from the Fraud Scoring Engine using HTTPS (TLS 1.3).")
    Component(S3_Lifecycle_Management_Engine, "S3 Lifecycle Management Engine", "Amazon S3 Lifecycle Policies", "Automatically transitions aged audit records to S3 Glacier Flexible Archive for cost optimization.")
    Component(Cross_Region_Replication_CRR_, "Cross-Region Replication (CRR)", "S3 Cross-Region Replication", "Replicates encrypted audit payloads to a secondary region (eu-central-1) for disaster recovery.")
}

Rel(Fraud_Scoring_Engine, Amazon_S3_Gateway_VPC_Endpoint, "Sends audit payloads via", "HTTPS (TLS 1.3)")
Rel(Amazon_S3_Gateway_VPC_Endpoint, Amazon_S3_Bucket, "Routes audit payloads to", "")
Rel(Amazon_S3_Bucket, AWS_KMS, "Uses for encryption-at-rest", "")
Rel(S3_Lifecycle_Management_Engine, Amazon_S3_Bucket, "Transitions aged audit objects from", "")
Rel(Amazon_S3_Bucket, Cross_Region_Replication_CRR_, "Replicates encrypted data to secondary region via", "")
@enduml