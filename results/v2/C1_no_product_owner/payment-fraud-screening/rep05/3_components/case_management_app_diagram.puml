@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalysts, "Fraud Analysts", "Views and updates case statuses")

Container_Boundary(CaseManagementApp, "Case Management App") {
    Component(APIControllerComponent, "API Controller Component", "Express.js", "Handles routing, OIDC/MFA authentication, rate limiting, and RBAC.")
    Component(CaseServiceComponent, "Case Service Component", "TypeScript", "Manages case workflows, business logic, and Prisma ORM interactions.")
    Component(UISPAComponent, "UI SPA Component", "React / Tailwind CSS", "Renders the analyst dashboard with masked card data.")
    Component(AuditComplianceComponent, "Audit & Compliance Component", "TypeScript", "Generates structured, immutable audit logs.")
    Component(TokenizationGatewayClient, "Tokenization Gateway Client", "TypeScript", "Communicates with external tokenization services via mTLS.")
    Component(AmazonRDSProxy, "Amazon RDS Proxy", "Amazon RDS Proxy", "Pools database connections and enforces TLS.")
    Component(AmazonRDSPostgreSQL, "Amazon RDS PostgreSQL", "Amazon RDS PostgreSQL", "Persists relational case data.")
    Component(AmazonCloudWatchLogsS3withObjectLock, "Amazon CloudWatch Logs & S3 with Object Lock", "AWS CloudWatch & S3", "Stores tamper-evident, KMS-encrypted audit trails.")
    Component(AWSECSFargateApplicationLoadBalancer, "AWS ECS Fargate & Application Load Balancer", "AWS ECS Fargate / ALB", "Runs containers with autoscaling, managed by a three-engineer team.")
}

Rel(FraudAnalysts, APIControllerComponent, "Views and updates case statuses", "HTTPS/TLS 1.3 with MFA")
Rel(APIControllerComponent, CaseServiceComponent, "Delegates business logic", "In-memory")
Rel(CaseServiceComponent, TokenizationGatewayClient, "Requests masked card data", "HTTPS/REST with mTLS")
Rel(CaseServiceComponent, AmazonRDSProxy, "Persists case data", "TCP/TLS")
Rel(CaseServiceComponent, AuditComplianceComponent, "Dispatches audit events", "In-memory")
Rel(AuditComplianceComponent, AmazonCloudWatchLogsS3withObjectLock, "Streams structured JSON logs", "AWS Firelens/HTTPS")
Rel(AmazonCloudWatchLogsS3withObjectLock, AmazonCloudWatchLogsS3withObjectLock, "Archives immutable logs", "Subscription Filter")

@enduml