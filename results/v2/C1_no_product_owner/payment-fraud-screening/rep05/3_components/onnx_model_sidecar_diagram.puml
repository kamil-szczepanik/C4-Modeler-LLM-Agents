@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the ONNX Model Sidecar container

System_Ext(fraud_scoring_engine, "Fraud Scoring Engine", "Go microservice on Amazon ECS Fargate")
System_Ext(amazon_s3, "Amazon S3 with Object Lock", "Tamper-evident 7-year retention storage for decisions and models")

Container_Boundary(onnx_model_sidecar, "ONNX Model Sidecar") {
    Component(model_inference_service, "Model Inference Service", "ONNX Runtime C++ API", "Executes fraud scoring models with high performance, avoiding garbage collection pauses to meet P99 < 50ms latency.")
    Component(model_hot_loader_component, "Model Hot-Loader Component", "HTTPS / TLS 1.3 Client", "Downloads .onnx models and signature manifests securely from Amazon S3.")
}

Rel(fraud_scoring_engine, model_inference_service, "Sends feature tensors for scoring", "Unix Domain Sockets (UDS) gRPC")
Rel(model_hot_loader_component, amazon_s3, "Downloads .onnx model and signature manifest", "HTTPS / TLS 1.3")

@enduml