@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon RDS PostgreSQL container

Person(CaseManagementApp, "Case Management App", "External application running in ECS Fargate")
System_Ext(AWSBackup, "AWS Backup", "AWS service for backup management")

Container_Boundary(AmazonRDSPostgreSQL, "Amazon RDS PostgreSQL") {
    Component(CaseManagementSchema, "Case Management Schema", "PostgreSQL 15 Relational Tables", "Relational tables storing analyst reviews, investigation notes, and case statuses.")
    Component(pgBouncerConnectionPooler, "pgBouncer Connection Pooler", "pgBouncer", "Manages database connections from ephemeral ECS Fargate tasks.")
    Component(pgauditExtension, "pgaudit Extension", "pgaudit", "Logs all DDL, DCL, and privileged DML statements for compliance.")
}

Rel(CaseManagementApp, pgBouncerConnectionPooler, "Reads and writes case data via TCP/SSL", "Port 5432")
Rel(pgBouncerConnectionPooler, CaseManagementSchema, "Routes queries to relational tables")
Rel(AmazonRDSPostgreSQL, AWSBackup, "Performs automated snapshots and WAL archiving", "AWS API")

@enduml