@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_api_gateway_alb_ingress, "AWS API Gateway / ALB (Ingress)") {
    Component(Application_Load_Balancer, "Application Load Balancer", "AWS Application Load Balancer", "Receives gRPC over mTLS 1.3 requests from the Payment Gateway and routes them to target groups.")
    Component(AWS_WAFv2, "AWS WAFv2", "AWS WAFv2", "Inspects request headers and payloads for security threats and WAF log scrubbing.")
}

Rel(Application_Load_Balancer, AWS_WAFv2, "Inspects request headers and payloads", "Internal AWS")

@enduml