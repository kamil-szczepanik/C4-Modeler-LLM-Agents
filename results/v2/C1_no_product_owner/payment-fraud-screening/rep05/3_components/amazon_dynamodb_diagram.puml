@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person_Ext(fraud_scoring_engine, "Fraud Scoring Engine", "External system")
Person_Ext(case_management_app, "Case Management App", "External system")
System_Ext(amazon_s3, "Amazon S3 (Object Lock)", "External system")

Container_Boundary(amazon_dynamodb, "Amazon DynamoDB") {
    Component(FeatureStore Table, "FeatureStore Table", "Amazon DynamoDB (Provisioned Capacity with Auto-Scaling)", "DynamoDB table optimized for low-latency point reads, serving as a low-latency feature store.")
    Component(AuditLogs Table, "AuditLogs Table", "Amazon DynamoDB (Append-only)", "DynamoDB table capturing append-only decision logs synced via DynamoDB Streams.")
}

Rel(fraud_scoring_engine, FeatureStore Table, "Executes single-digit millisecond GetItem and BatchGetItem calls", "AWS SDK over HTTPS / VPC Endpoint")
Rel(AuditLogs Table, amazon_s3, "Streams tamper-evident decision logs asynchronously", "DynamoDB Streams using AWS SDK")
Rel(case_management_app, FeatureStore Table, "Executes restricted Query operations", "AWS SDK governed by ABAC IAM policies")
Rel(case_management_app, AuditLogs Table, "Executes restricted Query operations", "AWS SDK governed by ABAC IAM policies")

@enduml