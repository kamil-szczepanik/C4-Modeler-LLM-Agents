@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon EventBridge container

System_Ext(FraudScoringEngine, "Fraud Scoring Engine", "External system")
System_Ext(CaseManagementApp, "Case Management App", "External system")
System_Ext(AmazonS3withObjectLock, "Amazon S3 with Object Lock", "External system")

Container_Boundary(AmazonEventBridge, "Amazon EventBridge") {
    Component(RuleEvaluationBus, "Rule Evaluation Bus", "Amazon EventBridge custom event bus", "Evaluates and routes payment decision events and review decisions.")
    Component(EventArchiveReplayComponent, "Event Archive & Replay Component", "EventBridge Archive", "Archives events and supports event replay functionality.")
    Component(DeadLetterQueueHandler, "Dead Letter Queue Handler", "SQS + EventBridge DLQ", "Handles failed event deliveries and dead-letter queue management.")
    Component(EventSchemaRegistry, "Event Schema Registry", "EventBridge Schema Registry", "Enforces payload validation using JSON Schema.")
}

Rel(FraudScoringEngine, RuleEvaluationBus, "Publishes payment decision events", "HTTPS / JSON [PutEvents]")
Rel(RuleEvaluationBus, CaseManagementApp, "Routes review decisions", "HTTPS / EventBridge Target")
Rel(RuleEvaluationBus, AmazonS3withObjectLock, "Forwards audit events", "Firehose / HTTPS")
Rel(RuleEvaluationBus, EventSchemaRegistry, "Enforces payload validation", "EventBridge API / JSON Schema")

@enduml