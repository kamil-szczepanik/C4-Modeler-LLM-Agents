@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalystsAndMLEngineers, "Fraud Analysts and ML Engineers", "Users who manage cases and monitor the fraud screening system.")
System_Ext(PaymentGatewayCoreProcessingSystem, "Payment Gateway / Core Processing System", "External system submitting payment authorizations for fraud screening.")
System_Ext(CardSchemesTokenizationService, "Card Schemes / Tokenization Service", "External system providing PAN tokenization.")
System(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System", "Screens card-not-present payment authorizations for fraud at 3,000 TPS while supporting analyst case management within a 25,000 EUR monthly budget, meeting PCI-DSS Level 1 compliance and 7-year audit retention.")

Rel(PaymentGatewayCoreProcessingSystem, RealTimePaymentFraudScreeningSystem, "Sends payment authorizations for fraud screening", "synchronous gRPC over TLS with mTLS and AWS IAM Signature v4")
Rel(FraudAnalystsAndMLEngineers, RealTimePaymentFraudScreeningSystem, "Accesses case management and system monitoring", "HTTPS with RBAC, IAM/OIDC, and mandatory MFA")
Rel(RealTimePaymentFraudScreeningSystem, CardSchemesTokenizationService, "Requests PAN tokenization", "secure API")
@enduml