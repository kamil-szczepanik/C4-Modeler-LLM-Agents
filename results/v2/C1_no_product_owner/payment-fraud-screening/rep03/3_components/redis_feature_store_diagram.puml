@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(redis_feature_store, "Redis Feature Store") {
    Component(Feature_Data_Engine, "Feature Data Engine", "In-Memory KV Store / Redis", "Handles low-latency feature lookups and in-memory feature retrieval.")
    Component(Rule_Model_Cache, "Rule & Model Cache", "Redis Core Engine / Strings/JSON", "Powers dynamic rule fetching and zero-downtime hot-reloading of scoring models.")
    Component(Replication_Persistence_Manager, "Replication & Persistence Manager", "Amazon ElastiCache Multi-AZ Redis", "Manages replication, persistence, and automated daily encrypted snapshots.")
    Component(Session_Rate_Limiting_Store, "Session & Rate-Limiting Store", "Redis Core Engine", "Updates sliding-window transaction velocity counters and manages analyst session states.")
    Component(Amazon_ElastiCache_Multi_AZ_Redis, "Amazon ElastiCache Multi-AZ Redis", "AWS ElastiCache Redis", "Delivers low-latency feature lookups and rule caching with high availability.")
}

Component(Fraud_Scoring_Engine, "Fraud Scoring Engine", "Scoring Engine Service", "Executes fraud screening logic by interfacing with feature stores, rule caches, and rate limiters.")
Component(Case_Management_API, "Case Management API", "API Service", "Manages analyst session states and secure reviews for suspicious transactions.")
Component(AWS_CloudWatch_AWS_Secrets_Manager, "AWS CloudWatch & AWS Secrets Manager", "AWS Management Services", "Monitors performance metrics, audit logs, and automates Redis AUTH token rotation.")
Component(Amazon_S3_Glacier, "Amazon S3 Glacier", "Cloud Storage", "Archives automated daily encrypted snapshots.")

Rel(Fraud_Scoring_Engine, Feature_Data_Engine, "In-memory feature retrieval", "TCP / RESP over TLS")
Rel(Fraud_Scoring_Engine, Rule_Model_Cache, "Dynamic rule fetching", "TCP / RESP over TLS")
Rel(Fraud_Scoring_Engine, Session_Rate_Limiting_Store, "Updates sliding-window transaction velocity counters", "TCP / RESP over TLS")
Rel(Case_Management_API, Session_Rate_Limiting_Store, "Manages analyst session states", "TCP / RESP over TLS")
Rel(Amazon_ElastiCache_Multi_AZ_Redis, Amazon_S3_Glacier, "Archives automated daily encrypted snapshots", "HTTPS")

@enduml