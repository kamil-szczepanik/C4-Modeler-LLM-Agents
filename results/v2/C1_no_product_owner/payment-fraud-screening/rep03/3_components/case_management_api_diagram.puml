@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(case_management_api, "Case Management API") {
    Component(HTTP_Router_Controller, "HTTP Router / Controller", "Express.js (Node.js/TypeScript)", "Handles ingress routing and request validation.")
    Component(Auth_RBAC_Middleware, "Auth & RBAC Middleware", "Node.js/TypeScript Middleware", "Validates JWTs from the IdP and enforces least-privilege roles.")
    Component(Case_Service, "Case Service", "Node.js/TypeScript", "Core business logic orchestrating case assignment and status transitions.")
    Component(Audit_Compliance_Logger, "Audit & Compliance Logger", "Node.js/TypeScript", "Generates HMAC-SHA256 signed, tamper-evident audit trails.")
}

Rel(HTTP_Router_Controller, Auth_RBAC_Middleware, "Passes incoming requests for authentication and authorization")
Rel(Auth_RBAC_Middleware, Case_Service, "Forwards validated requests to business logic")
Rel(Case_Service, Audit_Compliance_Logger, "Sends case transition events for audit logging")

@enduml