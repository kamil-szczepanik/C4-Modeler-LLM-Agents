@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS ALB (Ingress / API Gateway) container

Container_Boundary(aws_alb_container, "AWS ALB (Ingress / API Gateway)") {
    Component(PathBasedRoutingAndTLSController, "Path-Based Routing and TLS Controller", "AWS Application Load Balancer / AWS Certificate Manager (ACM)", "Terminates TLS 1.3, enforces strict path-based separation, and routes incoming traffic to meet the 50ms P99 latency SLA.")
    Component(WebApplicationFirewallWAFInspector, "Web Application Firewall (WAF) Inspector", "AWS WAF", "Inspects incoming HTTP/HTTPS analyst traffic using core OWASP rules while bypassing the gRPC payment path to preserve performance.")
    Component(PaymentGatewayIngressRouter, "Payment Gateway Ingress Router", "gRPC over mTLS", "Receives payment authorizations from the Payment Gateway / Acquirer and forwards screening requests directly to the Fraud Scoring Engine.")
    Component(CaseManagementIngressRouter, "Case Management Ingress Router", "HTTPS / OAuth 2.0 / OIDC", "Receives case management requests from Fraud Analysts and securely forwards them to the Case Management API.")
}

Rel(PaymentGatewayIngressRouter, Fraud Scoring Engine, "Forwards screening requests", "gRPC over mTLS")
Rel(CaseManagementIngressRouter, Case Management API, "Forwards case management requests", "HTTPS")
Rel(CaseManagementIngressRouter, WebApplicationFirewallWAFInspector, "Inspects incoming HTTP/HTTPS traffic", "Internal AWS API")
Rel(PathBasedRoutingAndTLSController, PaymentGatewayIngressRouter, "Routes payment authorization traffic", "")
Rel(PathBasedRoutingAndTLSController, CaseManagementIngressRouter, "Routes analyst workflow traffic", "")

@enduml