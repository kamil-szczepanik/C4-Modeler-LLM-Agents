@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Fraud Scoring Engine container

Container_Boundary(fraud_scoring_engine, "Fraud Scoring Engine") {
    Component(API_Handler_Component, "API Handler Component", "Go (Golang)", "Ingress validation, serialization, and PAN tokenization/sanitization gate.")
    Component(Feature_Aggregator_Component, "Feature Aggregator Component", "Go (Golang)", "Asynchronously fetches real-time velocity counters with Redis timeout fallback.")
    Component(Scoring_Executor_Component, "Scoring Executor Component", "Go (Golang), WebAssembly (WASM)", "Evaluates rules and executes local WASM models within strict latency bounds.")
    Component(Audit_Dispatcher_Component, "Audit Dispatcher Component", "Go (Golang)", "Signs audit payloads and pushes events asynchronously to SQS.")
    Component(In_Memory_Model_Cache_Component, "In-Memory Model Cache Component", "Go (Golang)", "Hot-swaps cryptographically verified WASM binaries atomically.")
}

Rel(API_Handler_Component, Feature_Aggregator_Component, "Passes sanitized payloads", "in-memory Go channels")
Rel(API_Handler_Component, Scoring_Executor_Component, "Passes sanitized payloads", "in-memory Go channels")
Rel(Scoring_Executor_Component, In_Memory_Model_Cache_Component, "Hot-swaps compiled WASM binaries", "atomic background tickers")

@enduml