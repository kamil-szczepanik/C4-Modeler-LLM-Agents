@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalyst, "Fraud Analyst", "Internal persona reviewing flagged transactions via case management.")

System_Ext(PaymentGatewayAcquirer, "Payment Gateway / Acquirer", "External source sending authorization requests.")
System_Ext(IdentityPoviderIdP, "Identity Provider (IdP)", "External OIDC service handling SSO and MFA.")
System_Ext(AuditSink, "Audit Sink", "Write-only Amazon S3 bucket with Object Lock for tamper-evident storage.")
System_Ext(SecretsManager, "Secrets Manager", "AWS Secrets Manager storing mTLS certificates and IdP secrets.")

System(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System", "Processes card-not-present payment authorizations in AWS to evaluate fraud risks and manage suspicious transaction reviews.")

Rel(PaymentGatewayAcquirer, RealTimePaymentFraudScreeningSystem, "Ingests traffic using gRPC over TLS 1.3 with mutual TLS (mTLS).", "gRPC over TLS 1.3 (mTLS)")
Rel(FraudAnalyst, RealTimePaymentFraudScreeningSystem, "Accesses case management interfaces via HTTPS using OpenID Connect (OIDC).", "HTTPS / OIDC")
Rel(RealTimePaymentFraudScreeningSystem, AuditSink, "Streams cryptographic audit logs via HTTPS/TLS with AWS KMS encryption.", "HTTPS / TLS / AWS KMS")

@enduml