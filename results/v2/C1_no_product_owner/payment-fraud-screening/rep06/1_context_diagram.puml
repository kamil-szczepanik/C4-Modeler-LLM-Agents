@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalystRiskEngineer, "Fraud Analyst & Risk Engineer", "Performs case management and review of flagged payment transactions.")
System(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System", "Evaluates card-not-present payment authorizations for fraud prior to approval and provides a case management interface for fraud analysts.")
System_Ext(PaymentGatewayAcquirer, "Payment Gateway / Acquirer", "Sends payment authorization requests for fraud evaluation.")
System_Ext(PaymentNetworkCardSchemes, "Payment Network / Card Schemes", "External payment card networks involved in transaction processing.")
System_Ext(AuditComplianceArchive, "Audit / Compliance Archive", "Tamper-evident 7-year log storage using AWS S3 Object Lock.")
System_Ext(ExternalNotificationAlertingService, "External Notification / Alerting Service", "Receives operational incident webhooks via PagerDuty.")

Rel(PaymentGatewayAcquirer, RealTimePaymentFraudScreeningSystem, "Real-time authorization requests", "gRPC / HTTPS with mTLS (TLS 1.3)")
Rel(FraudAnalystRiskEngineer, RealTimePaymentFraudScreeningSystem, "Case management and review", "HTTPS (OIDC / OAuth 2.0)")
Rel(RealTimePaymentFraudScreeningSystem, AuditComplianceArchive, "Tamper-evident 7-year log storage", "AWS S3 Object Lock (Compliance Mode)")
Rel(RealTimePaymentFraudScreeningSystem, ExternalNotificationAlertingService, "Operational incident webhooks", "HTTPS")

@enduml