@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_aurora_serverless_v2, "Amazon Aurora Serverless v2") {
    Component(fraud_scoring_data_store, "Fraud Scoring Data Store", "PostgreSQL, pgcrypto, Table Partitioning", "Handles write-heavy fraud scoring records and column-level encryption for audit compliance.")
    Component(case_management_data_store, "Case Management Data Store", "PostgreSQL", "Stores case data and audit histories accessed via read replica routing.")
}

Rel(fraud_scoring_data_store, case_management_data_store, "Replicates data for read operations and audit history queries", "Replication")

@enduml