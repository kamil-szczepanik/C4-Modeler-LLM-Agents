@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Go Fraud Scoring Engine container

Container_Boundary(go_fraud_scoring_engine, "Go Fraud Scoring Engine") {
    Component(api_handler_component, "API Handler Component", "Go / gRPC", "Screens card-not-present payment authorizations in real-time to detect fraud before approval.")
    Component(rule_engine_component, "Rule Engine Component", "Go / Embedded DSL", "Evaluates business rules against transaction data.")
    Component(velocity_counter_component, "Velocity Counter Component", "Go / Redis Client", "Evaluates sliding-window rate limits and tracks transaction velocity.")
    Component(model_scorer_component, "Model Scorer Component", "Go / ONNX Runtime C bindings", "Executes pre-compiled machine learning models efficiently in-memory.")
    Component(audit_logger_component, "Audit Logger Component", "Go / Async Batch Writer", "Provides audit trails for analysts and persists transaction records.")
    Component(config_model_synchronizer_component, "Config & Model Synchronizer Component", "Go / S3 Sync", "Fetches rules and ONNX models from storage.")
    Component(circuit_breaker_wrapper, "Circuit Breaker Wrapper", "Go / Memory", "Ensures resilience and fault tolerance in-memory.")
}

Component(amazon_elasticache_redis, "Amazon ElastiCache (Redis)", "Redis", "Enables real-time velocity checks and sliding-window rate limits.")
Component(amazon_aurora_serverless_v2, "Amazon Aurora Serverless v2", "Aurora Serverless v2", "Persists audit data and transaction records.")
Component(amazon_s3, "Amazon S3", "S3", "Stores rules and ONNX models.")

Rel(api_handler_component, rule_engine_component, "In-process function calls via Go channels/memory", "")
Rel(api_handler_component, model_scorer_component, "In-process function calls via Go channels/memory", "")
Rel(velocity_counter_component, amazon_elasticache_redis, "Evaluates sliding-window rate limits via TCP", "")
Rel(audit_logger_component, amazon_aurora_serverless_v2, "Persists audit data and transaction records via TLS", "")
Rel(config_model_synchronizer_component, amazon_s3, "Fetches rules and ONNX models via HTTPS with AWS SigV4", "")

@enduml