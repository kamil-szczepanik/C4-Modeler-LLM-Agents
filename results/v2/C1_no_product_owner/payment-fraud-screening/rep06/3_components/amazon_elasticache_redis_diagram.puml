@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon ElastiCache (Redis) container

Container_Boundary(elasticache_redis, "Amazon ElastiCache (Redis)") {
    Component(Velocity Counter Store, "Velocity Counter Store", "Redis HyperLogLog and Sorted Sets", "Tracks transaction velocities for fraud detection and counting.")
    Component(Feature Cache, "Feature Cache", "Redis In-Memory Key-Value Store", "Stores pre-computed risk scores for fast retrieval.")
    Component(Session State & Token Map, "Session State & Token Map", "Redis Transient Storage", "Manages transient risk session metadata and token mapping.")
}

System(Go Fraud Scoring Engine, "Go Fraud Scoring Engine", "External system interacting with the cache components")

Rel(Go Fraud Scoring Engine, Velocity Counter Store, "Increments and reads counters", "RESP protocol over TCP (TLS-encrypted)")
Rel(Go Fraud Scoring Engine, Feature Cache, "Fetches cached risk features", "RESP protocol over TCP (TLS-encrypted)")
Rel(Go Fraud Scoring Engine, Session State & Token Map, "Resolves risk session tokens", "RESP protocol over TCP (TLS-encrypted)")

@enduml