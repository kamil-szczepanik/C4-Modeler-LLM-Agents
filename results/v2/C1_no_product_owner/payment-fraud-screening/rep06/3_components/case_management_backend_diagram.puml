@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(CaseAnalyst, "Case Analyst", "Analyst reviewing flagged payment transactions")
System_Ext(AWSApiGateway, "AWS API Gateway", "External API Gateway handling incoming requests")
System_Ext(AmazonAuroraServerlessv2, "Amazon Aurora Serverless v2", "Relational database for case state persistence")
System_Ext(AmazonS3ObjectLock, "Amazon S3 (Object Lock)", "Immutable compliance storage for audit logs")
System_Ext(AWSSecretsManager, "AWS Secrets Manager", "Secure credential and secret storage")

Container_Boundary(CaseManagementBackend, "Case Management Backend") {
    Component(CaseAPIController, "Case API Controller", "AWS ECS Fargate, Go net/http", "Manages analyst reviews and case workflows for flagged payment transactions.")
    Component(WorkflowAssignmentService, "Workflow & Assignment Service", "Go business logic, AWS Cognito JWT/RBAC", "Handles business logic, authorization, and dispatches audit events.")
    Component(MaskingMiddleware, "Masking Middleware", "Go sanitization component", "Delegates serialization and sanitization to isolate card data before analyst interaction.")
    Component(AuditLoggingAdapter, "Audit Logging Adapter", "Go, crypto/SHA-256, AWS KMS", "Dispatches audit events and streams cryptographically signed audit bundles.")
    Component(PersistenceRepository, "Persistence Repository", "Go database/sql, pgx", "Interacts with relational database to persist case state.")
}

Rel(CaseAnalyst, AWSApiGateway, "Submits HTTPS requests", "HTTPS / TLS 1.3")
Rel(AWSApiGateway, CaseAPIController, "Forwards requests to the backend")
Rel(CaseAPIController, MaskingMiddleware, "Delegates serialization and sanitization", "In-memory")
Rel(MaskingMiddleware, CaseAnalyst, "Returns sanitized payloads", "HTTPS")
Rel(CaseAPIController, WorkflowAssignmentService, "Invokes business logic", "In-memory")
Rel(WorkflowAssignmentService, AuditLoggingAdapter, "Dispatches audit events", "In-memory")
Rel(AuditLoggingAdapter, AmazonS3ObjectLock, "Streams cryptographically signed audit bundles", "TLS / AWS SDK")
Rel(WorkflowAssignmentService, AmazonAuroraServerlessv2, "Persists case state", "TLS / PostgreSQL protocol")
Rel(CaseManagementBackend, AWSSecretsManager, "Fetches secrets at startup", "HTTPS / AWS SDK via IAM Task Role")

@enduml