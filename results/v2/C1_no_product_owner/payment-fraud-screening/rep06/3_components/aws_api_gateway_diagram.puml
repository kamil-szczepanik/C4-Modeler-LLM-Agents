@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("aws_api_gateway", "AWS API Gateway") {
    Component(mtls_endpoint_configuration, "mTLS Endpoint Configuration", "AWS API Gateway mTLS", "Provides secure ingress authentication for payment gateways and acquirers.")
    Component(aws_waf, "AWS WAF", "AWS Web Application Firewall", "Inspects ingress traffic for rate-limiting and security.")
    Component(request_validator, "Request Validator", "AWS API Gateway Validator", "Validates payment authorization request payloads before processing.")
}

Rel(mtls_endpoint_configuration, aws_waf, "Inspects traffic", "AWS Internal")
Rel(aws_waf, request_validator, "Passes validated traffic", "AWS Internal")

@enduml