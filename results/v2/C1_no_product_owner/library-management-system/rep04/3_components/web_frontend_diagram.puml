@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Frontend container

Container_Boundary(web_frontend, "Web Frontend") {
    Component(RoutingShellComponent, "Routing & Shell Component", "React Router, React", "Provides UI framework, client-side routing, and shell components for the application.")
    Component(CatalogComponent, "Catalog Component", "React, TanStack Query", "Handles cataloging interfaces and ensures search responses remain under 800 ms via client-side caching and pagination.")
    Component(CirculationComponent, "Circulation Component", "React", "Manages circulation and self-service portal workflows.")
    Component(ApiClientComponent, "API Client Component", "Axios", "Handles HTTP and WebSocket transport, injecting W3C Trace Context headers and managing HttpOnly cookies.")
    Component(AuthSessionComponent, "Auth & Session Component", "React", "Manages user sessions, authentication, and secure cookie management.")
}

Rel(RoutingShellComponent, CatalogComponent, "Renders")
Rel(RoutingShellComponent, CirculationComponent, "Renders")
Rel(CatalogComponent, ApiClientComponent, "Sends API requests")
Rel(CirculationComponent, ApiClientComponent, "Sends API requests")
Rel(AuthSessionComponent, ApiClientComponent, "Manages credentials/tokens for")

@enduml