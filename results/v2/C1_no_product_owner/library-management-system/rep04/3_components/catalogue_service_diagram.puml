@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalogue Service container

Container_Boundary(catalogue_service, "Catalogue Service") {
    Component(Catalogue Controller, "Catalogue Controller", "Spring Boot / Java 21", "Handles incoming gRPC requests from the API Gateway with mTLS and propagated JWTs.")
    Component(Catalogue Manager, "Catalogue Manager", "Spring Boot / Java 21", "Manages core business logic and dispatches domain events.")
    Component(Search Component, "Search Component", "Spring Boot / Java 21", "Handles high-performance search queries and consumes events from RabbitMQ.")
    Component(Repository Component, "Repository Component", "Spring Data JPA / Java 21", "Manages relational persistence with PostgreSQL using encrypted database protocols.")
    Component(Outbox Publisher Component, "Outbox Publisher Component", "Spring Boot / Java 21", "Publishes domain events asynchronously using the outbox pattern.")
}

System_Ext(RabbitMQ, "RabbitMQ", "Asynchronous messaging broker")
System_Ext(Elasticsearch, "Elasticsearch", "Indexing and search engine")
System_Ext(PostgreSQL, "PostgreSQL", "Relational database")
System_Ext(Identity Provider (IdP), "Identity Provider (IdP)", "Identity and access management")

Rel(Catalogue Controller, Catalogue Manager, "Delegates requests")
Rel(Catalogue Manager, Search Component, "In-memory Java method calls")
Rel(Catalogue Manager, Outbox Publisher Component, "In-memory domain event dispatch")
Rel(Outbox Publisher Component, RabbitMQ, "AMQP over TLS 1.3")
Rel(RabbitMQ, Search Component, "Event consumer listener over TLS 1.3")
Rel(Search Component, Elasticsearch, "Bolt/REST over TLS 1.3")
Rel(Repository Component, PostgreSQL, "Encrypted database protocols (AES-256)")
Rel(Catalogue Controller, Identity Provider (IdP), "TLS 1.3")

@enduml