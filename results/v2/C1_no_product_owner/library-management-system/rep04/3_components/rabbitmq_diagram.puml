@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the RabbitMQ container

Container_Boundary(rabbitmq, "RabbitMQ") {
    Component(amqp_adapter, "AMQP Protocol Adapter", "Erlang/RabbitMQ Core, AMQP 0-9-1, TLS", "Accepts incoming AMQP connections, secures communication via mTLS, and parses protocol frames.")
    Component(exchanges, "Exchanges Component", "Erlang/RabbitMQ Core", "Routes incoming messages from the protocol adapter to appropriate queues based on bindings and routing keys.")
    Component(queues, "Queues Component", "RabbitMQ Quorum Queues, Raft consensus", "Holds message payloads in persistent queues across three availability zones for zero data loss.")
    Component(dlx, "DLX & Routing Component", "Erlang/RabbitMQ Core", "Forwards failed, rejected, or expired messages to dead-letter queues.")
    Component(storage, "Persistent Storage Volume", "Containerized EU-bound persistent volumes", "Provides durable, EU-compliant disk storage for message persistence.")
    Component(alerting, "Alerting and Log Forwarding Component", "Erlang/RabbitMQ Core, Log forwarder", "Monitors broker health, collects operational metrics, and forwards logs for system observability.")
}

Rel(amqp_adapter, exchanges, "Routes messages", "Internal Erlang messaging")
Rel(exchanges, queues, "Routes messages to persistent queues", "Internal Erlang messaging")
Rel(queues, dlx, "Forwards failed/expired messages", "Internal Erlang messaging")
Rel(dlx, queues, "Routes to dead-letter queues", "Internal Erlang messaging")

@enduml