@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Circulation Service container

System_Ext(API_Gateway, "API Gateway", "gRPC with mTLS, JWT", "External system routing requests.")
System_Ext(PostgreSQL, "PostgreSQL", "Encrypted database protocols, AES-256", "Primary transactional data store.")
System_Ext(RabbitMQ, "RabbitMQ", "AMQP over TLS", "Message broker for asynchronous event distribution.")
System_Ext(Payment_Gateway, "Payment Gateway", "TLS 1.3", "Processes fees.")

Container_Boundary(Circulation_Service, "Circulation Service") {
    Component(Circulation_Controller, "Circulation Controller", "Java/gRPC", "Exposes gRPC endpoints.")
    Component(Borrowing_Engine, "Borrowing Engine", "Spring Service / Java 21", "Manages loan logic including the Loan Rule Engine using the Specification Pattern.")
    Component(Fine_Management_Component, "Fine Management Component", "Resilience4j", "Handles fee calculations with circuit breaking.")
    Component(Circulation_DAO, "Circulation DAO", "Spring Data JPA / Hibernate", "Manages persistence.")
    Component(Outbox_Pattern_Component, "Outbox Pattern Component", "Java", "Guarantees reliable messaging via local transactions.")
    Component(Event_Publisher, "Event Publisher", "Spring AMQP", "Publishes domain events.")
}

Rel(API_Gateway, Circulation_Controller, "Routes requests", "gRPC with mTLS, JWT")
Rel(Circulation_DAO, PostgreSQL, "Persists data", "Encrypted database protocols, AES-256")
Rel(Event_Publisher, RabbitMQ, "Publishes messages", "AMQP over TLS")
Rel(Fine_Management_Component, Payment_Gateway, "Processes fees", "TLS 1.3")

@enduml