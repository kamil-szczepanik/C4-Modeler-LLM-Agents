@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Catalogue_Service, "Catalogue Service", "External service that interacts with search")

Container_Boundary(Elasticsearch, "Elasticsearch") {
    Component(Search_API, "Search API", "Java/Lucene REST API", "Powers the search endpoint implementation.")
    Component(Security_Interceptor, "Security Interceptor", "Java", "Validates JWT and permissions.")
    Component(Query_Caching_Layer, "Query Caching Layer", "In-memory Java API", "Caches query results for performance optimization.")
    Component(Lucene_Index_Engine, "Lucene Index Engine", "Apache Lucene", "Provides core indexing and full-text retrieval.")
    Component(Cluster_Coordinator, "Cluster Coordinator", "Zen Discovery", "Manages cluster coordination and state.")
}

Rel(Catalogue_Service, Search_API, "Indexes and searches catalogue items", "HTTP/REST over TLS 1.3 with mTLS")
Rel(Search_API, Security_Interceptor, "Validates JWT and permissions", "In-memory")
Rel(Security_Interceptor, Query_Caching_Layer, "Checks cache after validation", "In-memory")
Rel(Query_Caching_Layer, Lucene_Index_Engine, "Executes uncached queries", "In-memory Java API")
Rel(Cluster_Coordinator, Cluster_Coordinator, "Manages node communication", "TLS 1.3")

@enduml