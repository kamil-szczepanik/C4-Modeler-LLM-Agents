@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL container

Container_Boundary(postgresql, "PostgreSQL") {
    Component(Relational Engine, "Relational Engine", "PostgreSQL 16, Kubernetes StatefulSets, CloudNativePG", "Core relational engine for ACID transactions, data storage, high availability, and automated failover.")
    Component(Storage Subspace, "Storage Subspace", "File I/O, AES-256, TDE", "Manages encrypted physical file storage while enforcing strict EU data residency constraints.")
    Component(Connection Pooler, "Connection Pooler", "PgBouncer", "Manages database connections to prevent thread exhaustion from microservices.")
    Component(Schema Partitioning Component, "Schema Partitioning Component", "Logical isolation", "Provides logical schema separation within the database.")
    Component(Audit Logging Component, "Audit Logging Component", "pgaudit, pgcrypto", "Handles compliance auditing and column-level encryption for GDPR.")
}

Component(Catalogue Service, "Catalogue Service", "Microservice", "External service querying the catalogue data.")
Component(Circulation Service, "Circulation Service", "Microservice", "External service managing circulation data.")

Rel(Catalogue Service, Connection Pooler, "SQL/TCP [TLS 1.3, mTLS, SCRAM-SHA-256]")
Rel(Circulation Service, Connection Pooler, "SQL/TCP [TLS 1.3, mTLS, SCRAM-SHA-256]")
Rel(Connection Pooler, Relational Engine, "Inter-process socket [TLS 1.3]")
Rel(Relational Engine, Storage Subspace, "File I/O [AES-256, TDE]")
Rel(Relational Engine, Schema Partitioning Component, "Logical isolation [Internal]")

@enduml