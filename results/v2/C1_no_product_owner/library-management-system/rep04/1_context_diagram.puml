@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Library Patron, "Library Patron", "External actor accessing self-service portals to search and borrow items.")
Person(Librarian, "Librarian", "External actor managing cataloguing, inventory, and circulation.")
System(Library Management System, "Library Management System", "A public and academic platform for cataloguing physical and digital items, managing circulation, and providing self-service portals, enforcing strict EU-only data residency and high-performance search requirements.")
System_Ext(Identity Provider (IdP), "Identity Provider (IdP)", "External system for SSO authentication using OAuth2/OIDC.")
System_Ext(Payment Gateway, "Payment Gateway", "External system for processing fines and fees via REST/HTTPS.")
System_Ext(Notification Provider, "Notification Provider", "External system for sending circulation alerts via SMTPS/HTTPS.")

Rel(Library Patron, Library Management System, "Accesses self-service portals and interacts with the system", "HTTPS, TLS 1.3")
Rel(Librarian, Library Management System, "Manages cataloguing and circulation through the platform", "HTTPS, TLS 1.3")
Rel(Library Management System, Identity Provider (IdP), "Authenticates users via delegated authentication", "OAuth2/OIDC, HTTPS")
Rel(Library Management System, Payment Gateway, "Processes fines and fees", "REST/HTTPS")
Rel(Library Management System, Notification Provider, "Sends circulation alerts to patrons and staff", "SMTPS/HTTPS")
@enduml