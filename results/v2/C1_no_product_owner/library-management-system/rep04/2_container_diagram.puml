@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(LibraryPatron, "Library Patron", "External actor accessing self-service portals to search and borrow items.")
Person(Librarian, "Librarian", "External actor managing cataloguing, inventory, and circulation.")

System_Ext(IdentityProvider, "Identity Provider (IdP)", "External system for SSO authentication using OAuth2/OIDC.")
System_Ext(PaymentGateway, "Payment Gateway", "External system for processing fines and fees.")
System_Ext(NotificationProvider, "Notification Provider", "External system for sending circulation alerts.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(WebFrontend, "Web Frontend", "React SPA, Nginx", "Provides cataloging, circulation, and self-service portals for users.")
    Container(ApiGateway, "API Gateway", "Spring Cloud Gateway", "Handles ingress routing, rate limiting, and OAuth2/OIDC validation.")
    Container(CatalogueService, "Catalogue Service", "Spring Boot, Java 21", "Manages catalog data and search capabilities.")
    Container(CirculationService, "Circulation Service", "Spring Boot, Java 21", "Manages borrowing, returns, and circulation workflows.")
    Container(NotificationService, "Notification Service", "Spring Boot, Java 21", "Handles internal notification processing and messaging.")
    ContainerDb(PostgreSQL, "PostgreSQL", "PostgreSQL", "Relational data store for structured catalogue and circulation data.")
    ContainerDb(Elasticsearch, "Elasticsearch", "Elasticsearch", "Dedicated search engine ensuring sub-800ms search responses.")
    Container(RabbitMQ, "RabbitMQ", "RabbitMQ", "Asynchronous message broker with dead-letter exchanges.")
}

Rel(LibraryPatron, WebFrontend, "Accesses self-service portals", "HTTPS/REST, WebSockets")
Rel(Librarian, WebFrontend, "Manages cataloging and circulation", "HTTPS/REST, WebSockets")
Rel(WebFrontend, ApiGateway, "Sends API requests", "HTTPS/REST")
Rel(ApiGateway, CatalogueService, "Routes catalogue requests", "gRPC with mTLS, propagated JWTs")
Rel(ApiGateway, CirculationService, "Routes circulation requests", "gRPC with mTLS, propagated JWTs")
Rel(ApiGateway, NotificationService, "Routes notification requests", "gRPC with mTLS, propagated JWTs")
Rel(CatalogueService, PostgreSQL, "Reads and writes catalogue data", "Encrypted database protocols (AES-256)")
Rel(CatalogueService, Elasticsearch, "Indexes and searches catalogue items", "Encrypted database protocols (AES-256)")
Rel(CirculationService, PostgreSQL, "Reads and writes circulation data", "Encrypted database protocols (AES-256)")
Rel(CirculationService, RabbitMQ, "Publishes asynchronous messages", "AMQP over TLS")
Rel(NotificationService, RabbitMQ, "Consumes messages for alerts", "AMQP over TLS")
Rel(CatalogueService, IdentityProvider, "Validates authentication and tokens", "TLS 1.3")
Rel(CirculationService, PaymentGateway, "Processes fines and fees", "TLS 1.3")
Rel(NotificationService, NotificationProvider, "Sends external notifications", "TLS 1.3")

@enduml