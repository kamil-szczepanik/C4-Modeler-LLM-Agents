@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(web_application, "Web Application") {
    Component(router_layout, "Router & Layout Component", "React Router", "Renders patron and staff views.")
    Component(auth_session, "Authentication & Session Manager", "OAuth2/OIDC, HttpOnly cookies", "Manages user authentication and session security.")
    Component(catalogue_search, "Catalogue & Search UI Module", "TanStack Query / React Query", "Handles high-performance catalog searches and client-side caching.")
    Component(circulation_portal, "Circulation & Self-Service Portal Module", "TanStack Query", "Manages circulation and self-service portal functionality.")
    Component(api_client, "API Client", "Axios / Fetch with Zod validation", "Sends validated payloads to the backend API Gateway.")
    Component(perf_monitoring, "Performance Monitoring and Real User Monitoring", "OpenTelemetry, AWS CloudWatch Synthetics", "Tracks Real User Monitoring and Core Web Vitals.")
    Component(cloudfront, "AWS CloudFront Frankfurt", "CDN edge", "Serves static assets and application ensuring EU-only data residency.")
}

System_Ext(api_gateway, "API Gateway", "Backend API Gateway")

Rel(cloudfront, router_layout, "Serves static assets and application", "HTTPS / TLS 1.3")
Rel(router_layout, catalogue_search, "Renders patron and staff views", "React Context/Props")
Rel(router_layout, circulation_portal, "Renders patron and staff views", "React Context/Props")
Rel(catalogue_search, api_client, "Sends validated payloads", "TypeScript function calls")
Rel(circulation_portal, api_client, "Sends validated payloads", "TypeScript function calls")
Rel(api_client, api_gateway, "Communicates with backend", "HTTPS / REST, Frankfurt endpoints")

@enduml