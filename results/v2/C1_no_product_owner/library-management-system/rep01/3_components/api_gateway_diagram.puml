@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Web_Application, "Web Application", "Client application")
System_Ext(Catalogue_Search_Service, "Catalogue & Search Service", "Microservice")
System_Ext(Circulation_User_Service, "Circulation & User Service", "Microservice")
System_Ext(Apache_Kafka_AWS_MSK, "Apache Kafka (AWS MSK)", "Message Broker")
System_Ext(AWS_CloudWatch_OpenTelemetry_Collector, "AWS CloudWatch / OpenTelemetry Collector", "Observability Backend")

Container_Boundary(api_gateway, "API Gateway") {
    Component(Routing_Engine, "Routing Engine", "Kong Core (Node.js)", "Path-based gRPC routing to downstream services.")
    Component(Authentication_Authorization_Filter, "Authentication & Authorization Filter", "Lua / Kong Plugin", "Stateless cryptographic JWT validation via cached JWKS.")
    Component(Rate_Limiting_Throttling_Module, "Rate Limiting & Throttling Module", "Redis-backed Kong Plugin", "Multi-AZ Redis instance enforcing traffic thresholds in AWS Frankfurt.")
    Component(Observability_Tracing_Agent, "Observability & Tracing Agent", "Kong OTel Plugin", "Injects W3C Trace Context headers.")
}

Rel(Web_Application, Routing_Engine, "Sends API requests", "HTTPS / REST")
Rel(Routing_Engine, Catalogue_Search_Service, "Routes search queries", "gRPC with mTLS")
Rel(Routing_Engine, Circulation_User_Service, "Routes user requests", "gRPC with mTLS")
Rel(Routing_Engine, Apache_Kafka_AWS_MSK, "Publishes audit logs and access metrics", "TCP / SASL_SSL")
Rel(Observability_Tracing_Agent, AWS_CloudWatch_OpenTelemetry_Collector, "Exports traces and metrics", "OTLP / gRPC")
@enduml