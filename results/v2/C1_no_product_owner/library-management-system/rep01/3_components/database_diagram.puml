@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database container

System_Ext(catalogue_service, "Catalogue & Search Service", "Java Spring Boot and Elasticsearch service")
System_Ext(circulation_service, "Circulation & User Service", "Go and Spring Boot service")

Container_Boundary(database, "Database") {
    Component(connection_pooler, "Connection Pooler", "PgBouncer", "Manages incoming TCP connections, routing transactional queries and preventing starvation to meet P99 latency <800ms.")
    Component(relational_store, "Relational Data Store", "PostgreSQL 15, AWS RDS (Frankfurt), AWS Secrets Manager, Terraform/OpenTofu, Flyway/Liquibase", "Securely stores and manages relational data for inventory and user transactions, ensuring ACID compliance and strict EU data residency.")
}

Rel(catalogue_service, connection_pooler, "Routes transactional queries", "TLS 1.3, PostgreSQL Wire Protocol")
Rel(circulation_service, connection_pooler, "Routes transactional queries", "TLS 1.3, PostgreSQL Wire Protocol")
Rel(connection_pooler, relational_store, "Forwards pooled queries", "Encrypted Local TCP, Unix Domain Sockets")

@enduml