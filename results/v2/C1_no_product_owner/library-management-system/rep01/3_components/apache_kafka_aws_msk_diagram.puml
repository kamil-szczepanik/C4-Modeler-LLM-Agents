@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(apache_kafka_aws_msk, "Apache Kafka (AWS MSK)") {
    Component(Zookeeper_KRaft_Metadata_Controller_Quorum, "Zookeeper / KRaft Metadata Controller Quorum", "Apache Zookeeper / KRaft", "Manages cluster metadata and broker coordination.")
    Component(Kafka_Broker_Nodes_Managed_MSK, "Kafka Broker Nodes (Managed MSK)", "AWS MSK", "Stateless/Stateful message storage nodes handling partition leaders across 3 Availability Zones.")
    Component(Schema_Registry, "Schema Registry", "AWS Glue / Managed", "Enforces Avro schema validation for domain events.")
}

Component(Catalogue__Search_Service, "Catalogue & Search Service", "Event Producer/Consumer", "Publishes and consumes event streams for library cataloging and search.")
Component(Circulation__User_Service, "Circulation & User Service", "Event Producer/Consumer", "Publishes and consumes event streams for library circulation and user management.")
Component(Notification_Worker_Service, "Notification Worker Service", "Event Consumer", "Consumes event streams to dispatch notifications.")

Rel(Catalogue__Search_Service, Kafka_Broker_Nodes_Managed_MSK, "Publishes and consumes event streams", "Apache Kafka Binary Protocol over TLS 1.3 [TCP Port 9094]")
Rel(Circulation__User_Service, Kafka_Broker_Nodes_Managed_MSK, "Publishes and consumes event streams", "Apache Kafka Binary Protocol over TLS 1.3 [TCP Port 9094]")
Rel(Notification_Worker_Service, Kafka_Broker_Nodes_Managed_MSK, "Publishes and consumes event streams", "Apache Kafka Binary Protocol over TLS 1.3 [TCP Port 9094]")
Rel(Kafka_Broker_Nodes_Managed_MSK, Schema_Registry, "Validates event schemas dynamically during serialization", "HTTPS/REST over TLS")
Rel(Kafka_Broker_Nodes_Managed_MSK, Zookeeper_KRaft_Metadata_Controller_Quorum, "Internal cluster state synchronization", "TCP")
@enduml