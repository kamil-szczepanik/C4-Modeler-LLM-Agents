@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Library Management System

Person(LibraryPatronsStaff, "Library Patrons & Staff", "Users who interact with the library catalog, circulation, and self-service portals.")
System(LibraryManagementSystem, "Library Management System", "Provides cataloging, circulation, and self-service portals for public and academic libraries, hosted exclusively within the EU for data residency compliance.")
System_Ext(ExternalPaymentGateway, "External Payment Gateway", "Handles payment processing securely, PCI-DSS scoped.")
System_Ext(DigitalRepositoryDRMProvider, "Digital Repository / DRM Provider", "Provides digital assets and DRM management asynchronously.")
System_Ext(ExternalNotificationService, "External Notification Service", "Sends notifications to users using mTLS and API keys.")
System_Ext(AWSCloudFrontFrankfurt, "AWS CloudFront Frankfurt", "CDN and edge service providing edge caching, WAF protection, and DDoS mitigation.")

Rel(LibraryPatronsStaff, AWSCloudFrontFrankfurt, "Accesses the system securely via edge", "HTTPS/TLS 1.3, OAuth 2.0/OIDC")
Rel(AWSCloudFrontFrankfurt, LibraryManagementSystem, "Forwards requests to the core system", "HTTPS/TLS 1.3")
Rel(LibraryManagementSystem, ExternalPaymentGateway, "Processes transactions", "REST/TLS, PCI-DSS scoped")
Rel(LibraryManagementSystem, DigitalRepositoryDRMProvider, "Retrieves digital assets", "Asynchronous REST/TLS")
Rel(LibraryManagementSystem, ExternalNotificationService, "Dispatches notifications", "mTLS and API keys")

@enduml