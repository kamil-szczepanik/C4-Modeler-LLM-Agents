@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(WAF_Input_Sanitization_Plugin, "WAF / Input Sanitization Plugin", "OWASP CRS", "Inspects incoming HTTPS/JSON traffic and performs input sanitization.")
    Component(Authentication_Filter_Interceptor, "Authentication Filter / Interceptor", "OAuth2/JWT Plugin", "Enforces perimeter security and validates tokens for incoming requests.")
    Component(Routing_Engine_Request_Transformation_Module, "Routing Engine & Request Transformation Module", "Kong / Spring Cloud Gateway", "Handles dynamic routing and request transformation, forwarding validated requests.")
    Component(Rate_Limiting_Throttling_Module, "Rate Limiting & Throttling Module", "Redis-backed", "Provides distributed rate-limiting with strict EU-only deployment compliance.")
}

Rel(WAF_Input_Sanitization_Plugin, Authentication_Filter_Interceptor, "Forwards sanitized payload")
Rel(Authentication_Filter_Interceptor, Routing_Engine_Request_Transformation_Module, "Forwards validated requests")
Rel(Routing_Engine_Request_Transformation_Module, Rate_Limiting_Throttling_Module, "Consults for rate limiting and throttling")

@enduml