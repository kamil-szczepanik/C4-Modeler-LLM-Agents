@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(web_app, "Web App") {
    Component(ui_router, "UI Router & State Management", "React Router, Zustand", "Handles client-side routing with role-based guards, state management, and in-memory JWT storage.")
    Component(catalogue_modules, "Catalogue & Circulation Modules", "React Components", "Components handling item browsing, search, checkouts, and renewals.")
    Component(api_client, "API Client", "Axios", "Client for Kong/Spring Cloud Gateway communication with interceptors and CSRF mitigation.")
    Component(telemetry, "Telemetry & Error Boundary Module", "Sentry SDK", "Captures performance metrics and sanitizes errors for Sentry.")
}

System_Ext(api_gateway, "API Gateway", "Kong / Spring Cloud Gateway")
System_Ext(sentry, "Sentry", "Error Tracking & Performance Monitoring")

Rel(ui_router, catalogue_modules, "Delegates views", "In-memory / React Props")
Rel(catalogue_modules, api_client, "Sends requests", "In-memory")
Rel(api_client, api_gateway, "Communicates with backend", "HTTPS/JSON")
Rel(telemetry, sentry, "Transmits sanitized telemetry", "HTTPS/JSON, EU region only")

@enduml