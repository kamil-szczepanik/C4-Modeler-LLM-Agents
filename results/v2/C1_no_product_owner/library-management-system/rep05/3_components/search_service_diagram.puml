@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "External system routing requests")
System_Ext(async_event_broker, "Async Event Broker", "External event broker")

Container_Boundary(search_service, "Search Service") {
    Component(search_api_controller, "Search API Controller", "Java, Spring Data Elasticsearch", "Routes and handles incoming search queries.")
    Component(query_builder_component, "Query Builder Component", "Java, Spring Data Elasticsearch", "Builds and processes DSL queries from validated DTOs.")
    Component(index_synchronizer_component, "Index Synchronizer Component", "Java, Spring Data Elasticsearch", "Consumes lifecycle events and synchronizes the search index.")
    Component(elasticsearch_client_wrapper, "Elasticsearch Client Wrapper", "Java, Spring Data Elasticsearch with Resilience4j", "Wraps Elasticsearch client calls with resilience and error handling.")
    ComponentDb(elasticsearch_cluster, "Elasticsearch Cluster", "EU-hosted, encrypted-at-rest with CMK", "Stores and indexes library items for high-performance search.")
}

Rel(api_gateway, search_api_controller, "Routes search queries via gRPC over mTLS", "gRPC / mTLS")
Rel(async_event_broker, index_synchronizer_component, "Consumes item lifecycle events via Apache Kafka consumer protocol", "Kafka")
Rel(search_api_controller, query_builder_component, "Passes validated DTOs via method calls", "Method Call")
Rel(query_builder_component, elasticsearch_client_wrapper, "Executes DSL queries via Java method calls", "Method Call")
Rel(index_synchronizer_component, elasticsearch_client_wrapper, "Executes bulk index operations via Java method calls", "Method Call")
Rel(elasticsearch_client_wrapper, elasticsearch_cluster, "Executes read and write operations", "TCP / HTTP")

@enduml