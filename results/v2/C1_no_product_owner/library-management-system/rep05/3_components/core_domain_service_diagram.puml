@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(core_domain_service, "Core Domain Service") {
    Component(catalog_management_component, "Catalog Management Component", "Java/Spring Boot", "Manages library items and cataloguing within the Core Domain Service.")
    Component(circulation_component, "Circulation Component", "Java/Spring Boot", "Manages the circulation and borrowing processes of library items.")
    Component(fine_fee_component, "Fine & Fee Component", "Java/Spring Boot", "Handles fines, fees, and integrates with payment gateways.")
    Component(patron_management_component, "Patron Management Component", "Java/Spring Boot", "Manages patron records and user-related domain logic.")
}

System_Ext(search_service, "Search Service", "Search engine container")

Rel(catalog_management_component, search_service, "Publishes change-data-capture (CDC) events", "Apache Kafka (AMQP/TLS 1.3)")

@enduml