@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Background Worker container

Container_Boundary(background_worker, "Background Worker") {
    Component(Task_Consumer, "Task Consumer", "Celery Worker", "Consumes asynchronous background tasks, processes batch operations, and orchestrates workflows.")
    Component(Task_Router, "Task Router", "Celery Router", "Dispatches incoming broker events based on task type.")
    Component(Data_Access_Layer, "Data Access Layer", "SQLAlchemy", "Reads/Writes task state and domain data enforcing EU-only data residency.")
    Component(External_Integration_Client, "External Integration Client", "HTTPX", "Triggers external notifications and syncs with external systems.")
}

Component(Async_Event_Broker, "Async Event Broker", "RabbitMQ / Kafka", "Queues and brokers asynchronous tasks and messages.")
Component(Primary_Database, "Primary Database", "PostgreSQL", "Stores task state and domain data.")
Component(External_Systems, "External Systems", "Notification Service, National Library Registry", "External systems for notifications and registry synchronization.")

Rel(Async_Event_Broker, Task_Consumer, "Consumes asynchronous background tasks", "Consumer subscription over mTLS with AMQP")
Rel(Task_Consumer, Task_Router, "Dispatches incoming broker events based on task type", "Internal Python routing")
Rel(Task_Consumer, Data_Access_Layer, "Reads/Writes task state and domain data", "SQLAlchemy")
Rel(Data_Access_Layer, Primary_Database, "Persists domain data and task state")
Rel(Task_Consumer, External_Integration_Client, "Triggers external notifications and syncs", "Async HTTP/REST over TLS 1.3")
Rel(External_Integration_Client, External_Systems, "Sends notifications and syncs registry data")
Rel(Task_Consumer, Async_Event_Broker, "Acknowledges task completion or routes poisoned messages to DLQ", "AMQP/mTLS")
@enduml