@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database container

Container_Boundary(Database, "Database") {
    Component(Primary_Database_Instance, "Primary Database Instance", "PostgreSQL 16", "Executes transactions and critical reads, providing ACID compliance and JSONB support.")
    Component(Read_Replica_Instances, "Read Replica Instances", "PostgreSQL 16 Standbys", "Executes catalog search and read-heavy queries.")
    Component(Connection_Pooler, "Connection Pooler", "PgBouncer", "Routes SQL queries and transactions and forwards pooled connections.")
    Component(Kubernetes_Operator, "Kubernetes Operator", "CloudNativePG", "Automates high-availability, failover, and EU region multi-AZ deployments.")
    Component(Secrets_Manager, "Secrets Manager", "HashiCorp Vault", "Manages short-lived dynamic database credentials and AES-256 TDE encryption keys.")
    Component(Monitoring_Tools, "Monitoring Tools", "Prometheus, Grafana, PagerDuty", "Provides monitoring and alerting for the database architecture.")
}

Rel(Connection_Pooler, Primary_Database_Instance, "Forwards pooled connections", "TCP/mTLS")
Rel(Connection_Pooler, Read_Replica_Instances, "Forwards pooled connections", "TCP/mTLS")

@enduml