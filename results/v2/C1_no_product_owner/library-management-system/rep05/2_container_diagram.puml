@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(Patron, "Patron", "End-user interacting via self-service portals to access library services.")
Person(LibrarianStaff, "Librarian / Staff", "Internal users managing inventory and circulation desk operations.")

System_Ext(AuthenticationProvider, "Authentication Provider", "External SaaS/IDP managing OIDC/OAuth2 federation, MFA for staff, and cryptographically signed JWTs.")
System_Ext(ExternalPaymentGateway, "External Payment Gateway", "Handles fines and fees processing via tokenization and secure iframes.")
System_Ext(NationalLibraryRegistry, "National Library Registry", "External authority for ISBN and metadata syncing with local fallback mechanisms.")
System_Ext(NotificationService, "Notification Service", "Manages transactional emails and SMS via REST/HTTPS.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(WebApp, "Web App", "React/TypeScript, Nginx", "Frontend UI delivery providing cataloguing, circulation, and self-service portals.")
    Container(APIGateway, "API Gateway", "Kong/Spring Cloud Gateway", "Single entry point providing routing, rate limiting, and JWT validation.")
    Container(CoreDomainService, "Core Domain Service", "Java/Spring Boot", "Handles core circulation, inventory, and cataloguing logic.")
    Container(SearchService, "Search Service", "Elasticsearch", "Fulfills high-performance search requirements (<800ms 99th-percentile).")
    ContainerDb(Database, "Database", "PostgreSQL", "Relational data storage with read replicas and automated failover.")
    Container(AsyncEventBroker, "Async Event Broker", "Apache Kafka/RabbitMQ", "Asynchronous event publishing and decoupling with Dead Letter Queues (DLQs).")
    Container(BackgroundWorker, "Background Worker", "Python/Celery or Node.js", "Processes background tasks and asynchronous worker workloads.")
}

Rel(Patron, WebApp, "Accesses self-service portals and catalogs", "HTTPS")
Rel(LibrarianStaff, WebApp, "Manages inventory and circulation desk operations", "HTTPS")
Rel(WebApp, APIGateway, "Sends API requests and page traffic", "HTTPS/JSON")
Rel(APIGateway, CoreDomainService, "Routes domain API requests", "gRPC/Internal REST over mTLS")
Rel(APIGateway, SearchService, "Routes search queries", "gRPC/Internal REST over mTLS")
Rel(CoreDomainService, Database, "Reads and writes relational data", "JDBC/TLS 1.3 with mTLS")
Rel(CoreDomainService, AsyncEventBroker, "Publishes domain events", "AMQP/Kafka Protocol + TLS 1.3")
Rel(AsyncEventBroker, SearchService, "Consumes events to update search indices", "Consumer subscription over mTLS")
Rel(AsyncEventBroker, BackgroundWorker, "Consumes asynchronous background tasks", "Consumer subscription over mTLS")
Rel(CoreDomainService, AuthenticationProvider, "Validates and exchanges authentication tokens", "OIDC/HTTPS")
Rel(CoreDomainService, ExternalPaymentGateway, "Processes fines and fees", "REST/HTTPS with mTLS and TLS 1.3")
Rel(CoreDomainService, NotificationService, "Triggers notifications", "REST/HTTPS with mTLS and TLS 1.3")
Rel(CoreDomainService, NationalLibraryRegistry, "Syncs metadata and ISBNs", "HTTPS")

@enduml