@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patron, "Patron", "End-user interacting via self-service portals to access library services.")
Person(Librarian_Staff, "Librarian / Staff", "Internal users managing inventory and circulation desk operations.")

System(Library_Management_System, "Library Management System", "Core software system for public and academic libraries handling cataloging, circulation, search, and self-service portals with strict EU-only data residency and sub-800ms 99th-percentile search performance.")

System_Ext(Authentication_Provider, "Authentication Provider", "External SaaS/IDP managing OIDC/OAuth2 federation, MFA for staff, and cryptographically signed JWTs.")
System_Ext(External_Payment_Gateway, "External Payment Gateway", "Handles fines and fees processing via tokenization and secure iframes.")
System_Ext(National_Library_Registry, "National Library Registry", "External authority for ISBN and metadata syncing with local fallback mechanisms.")
System_Ext(Notification_Service, "Notification Service", "Manages transactional emails and SMS via REST/HTTPS.")

Rel(Patron, Library_Management_System, "Uses self-service portals and catalogs", "HTTPS")
Rel(Librarian_Staff, Library_Management_System, "Manages inventory and circulation desk operations", "HTTPS")
Rel(Library_Management_System, Authentication_Provider, "Integrates for identity federation", "OIDC/HTTPS")
Rel(Library_Management_System, External_Payment_Gateway, "Processes fines and fees via tokenization and secure iframes", "REST/HTTPS with mTLS and TLS 1.3")
Rel(Library_Management_System, Notification_Service, "Manages transactional emails and SMS", "REST/HTTPS with mTLS and TLS 1.3")
Rel(Library_Management_System, National_Library_Registry, "Synchronizes ISBN and metadata with local fallback capabilities", "HTTPS")

@enduml