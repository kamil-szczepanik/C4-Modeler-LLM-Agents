@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-Process/master/C4_Process.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Component diagram for the Search Index container

System_Ext(Search_Service, "Search Service", "External search service")
System_Ext(Debezium_CDC, "Debezium CDC", "External change data capture service")
System_Ext(EU_Region_Immutable_Object_Storage, "EU-Region Immutable Object Storage", "External cloud storage for snapshots")

Container_Boundary(Search_Index, "Search Index") {
    Component(Primary_Data_Node, "Primary Data Node", "OpenSearch/Elasticsearch Core (Apache Lucene)", "Provides distributed, horizontally scalable search capabilities, low-latency index querying, and automated encrypted snapshots to EU-Region Immutable Object Storage.")
    Component(Query_Parsing_Caching_Component, "Query Parsing & Caching Component", "OpenSearch Query DSL & Node-level cache", "Parses queries and caches results to optimize read performance and fulfill the sub-800ms search SLA.")
    Component(Bulk_Ingestion_Buffer, "Bulk Ingestion Buffer", "OpenSearch Bulk API / Ingest Node", "Buffers and processes bulk ingestion streams via asynchronous batch updates.")
}

Rel(Search_Service, Query_Parsing_Caching_Component, "Submits search queries via REST over HTTP/2 with mTLS", "REST/HTTP/2, mTLS")
Rel(Debezium_CDC, Bulk_Ingestion_Buffer, "Streams asynchronous batch updates via REST/JSON over HTTP/2 with mTLS", "REST/JSON, HTTP/2, mTLS")
Rel(Primary_Data_Node, EU_Region_Immutable_Object_Storage, "Automated encrypted snapshots", "HTTPS")

@enduml