@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(LibraryStaffPatrons, "Library Staff / Patrons", "Accesses the library management system.")
System_Ext(IdentityProvider, "Identity Provider", "Handles authentication and issues OIDC tokens.")

Container_Boundary(WebApplication, "Web Application") {
    Component(RouterViewController, "Router/View Controller", "React Router, TypeScript", "Manages client-side routing and page views.")
    Component(CatalogComponent, "Catalog Component", "React, TypeScript", "UI modules for searching and viewing physical and digital items.")
    Component(CirculationComponent, "Circulation Component", "React, TypeScript", "UI modules for managing checkouts, returns, and renewals.")
    Component(AuthenticationClient, "Authentication Client", "OIDC Client, TypeScript", "Handles login flows and OIDC token validation.")
    Component(APIClient, "API Client", "TypeScript, HTTPS/REST", "Encapsulates communication with the API Gateway.")
    Component(StateManagementComponent, "State Management Component", "Zustand / React Context", "Manages transient application state in memory.")
}

Rel(LibraryStaffPatrons, RouterViewController, "Accesses", "HTTPS/REST")
Rel(CatalogComponent, StateManagementComponent, "Interacts", "Transient state")
Rel(CirculationComponent, StateManagementComponent, "Interacts", "Transient state")
Rel(CatalogComponent, APIClient, "Queries", "HTTPS/REST")
Rel(CirculationComponent, APIClient, "Queries", "HTTPS/REST")
Rel(AuthenticationClient, IdentityProvider, "Manages session tokens", "OAuth2/OIDC over HTTPS")
@enduml