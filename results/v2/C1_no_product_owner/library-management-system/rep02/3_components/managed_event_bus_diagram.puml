@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Managed Event Bus container

Container_Boundary(managed_event_bus, "Managed Event Bus") {
    Component(Event_Broker_Engine, "Event Broker Engine", "Apache Kafka via Strimzi operator on Kubernetes", "Handles asynchronous event streaming and change data capture for the Library Management System.")
    Component(Schema_Registry, "Schema Registry", "Confluent Schema Registry", "Enforces payload validation and backward compatibility using Avro/JSON.")
    Component(Kafka_Connect, "Kafka Connect", "Kafka Connect with Debezium", "Implements reliable change data capture for outbox pattern delivery.")
    Component(Topic_Management_Operator, "Topic Management Operator", "Topic Management Operator", "Provisions and configures topics and ACLs.")
}

Component(Consumers, "Consumers", "Notification Service, Search Service", "Consume domain events and catalogue mutation events for synchronization and alerts.")
Component(Producers, "Producers", "Core Domain Service, PostgreSQL Database", "Publish domain events and emit database transaction logs.")
Component(Core_Domain_Service, "Core Domain Service", "Microservice", "Core business logic service.")
Component(Notification_Service, "Notification Service", "Microservice", "Handles patron alerts and notifications.")
Component(Search_Service, "Search Service", "Microservice", "Handles catalogue search and synchronization.")

Rel(Core_Domain_Service, Event_Broker_Engine, "Publishes and consumes domain events", "TLS-encrypted TCP, SASL/OAuth2")
Rel(Core_Domain_Service, Kafka_Connect, "Emits database transaction logs", "JDBC/TLS")
Rel(Notification_Service, Event_Broker_Engine, "Consumes domain events for patron alerts", "TLS-encrypted TCP, SASL/OAuth2")
Rel(Search_Service, Event_Broker_Engine, "Consumes catalogue mutation events for synchronization", "TLS-encrypted TCP, SASL/OAuth2")
Rel(Topic_Management_Operator, Event_Broker_Engine, "Provisions and configures topics and ACLs", "Kubernetes API")

@enduml