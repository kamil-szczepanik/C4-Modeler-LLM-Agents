@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification Service container

Component(API Gateway, "API Gateway", "Gateway", "External API Gateway routing requests to the notification router.")
Component_Ext(Managed_Event_Bus, "Managed Event Bus", "Kafka", "Asynchronous event bus for delivering background processing messages.")
Component_Ext(External_Providers, "External Providers", "SendGrid and Twilio", "External email and SMS notification providers.")

Container_Boundary(Notification_Service, "Notification Service") {
    Component(Notification_Router_Component, "Notification Router Component", "TypeScript / gRPC", "Ingress handler for gRPC requests with token scope validation and payload sanitization.")
    Component(Delivery_Consumer_Component, "Delivery Consumer Component", "KafkaJS / TypeScript", "Consumes asynchronous messages from the Managed Event Bus.")
    Component(Template_Engine_Component, "Template Engine Component", "Handlebars / TypeScript", "Renders localized notification templates with ephemeral memory handling for PII.")
    Component(Dispatch_Adapter_Component, "Dispatch Adapter Component", "Node.js", "Manages external channel egress with W3C Trace Context propagation.")
    Component(Retry___Resilience_Policy_Engine_Component, "Retry & Resilience Policy Engine Component", "Opossum / TypeScript", "Implements circuit breaking and exponential backoff.")
}

Rel(API Gateway, Notification_Router_Component, "gRPC over mTLS with scope authorization", "gRPC over mTLS")
Rel(Managed_Event_Bus, Delivery_Consumer_Component, "Kafka Protocol (TCP/SSL)", "Kafka Protocol (TCP/SSL)")
Rel(Notification_Router_Component, Template_Engine_Component, "In-memory function call with string sanitization", "In-memory")
Rel(Delivery_Consumer_Component, Template_Engine_Component, "In-memory data passing (Async/Await)", "In-memory")
Rel(Template_Engine_Component, Dispatch_Adapter_Component, "In-memory data passing", "In-memory")
Rel(Dispatch_Adapter_Component, External_Providers, "HTTPS / TLS 1.3 with egress whitelisting", "HTTPS / TLS 1.3")

@enduml