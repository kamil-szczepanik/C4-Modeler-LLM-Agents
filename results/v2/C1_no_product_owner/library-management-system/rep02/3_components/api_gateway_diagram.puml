@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Ingress_Listener_TLS_Termination_Component, "Ingress Listener & TLS Termination Component", "Spring Cloud Gateway / Envoy", "Handles inbound HTTPS (TLS 1.3) and IP geolocation.")
    Component(Security_Authentication_Filter, "Security & Authentication Filter", "Spring Cloud Security", "Validates OAuth2/OIDC JWTs locally.")
    Component(Rate_Limiter_Component, "Rate Limiter Component", "Spring Cloud Gateway Filter / Redis", "Coordinates rate-limiting via Redis Cache.")
    Component(Routing_Resilience_Mediator, "Routing & Resilience Mediator", "Resilience4j", "Applies circuit breakers to prevent cascading failures.")
    Component(gRPC_Upstream_Client, "gRPC Upstream Client", "gRPC over mTLS", "Forwards requests downstream to internal services.")
}

Rel(Ingress_Listener_TLS_Termination_Component, Security_Authentication_Filter, "Passes decrypted requests for token validation", "Internal")
Rel(Security_Authentication_Filter, Rate_Limiter_Component, "Checks rate limits and JWT blacklists", "TCP/RESP")
Rel(Rate_Limiter_Component, Routing_Resilience_Mediator, "Routes validated requests", "Internal")
Rel(Routing_Resilience_Mediator, gRPC_Upstream_Client, "Dispatches requests to upstream handlers", "gRPC")
@enduml