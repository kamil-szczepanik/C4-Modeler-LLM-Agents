@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Domain Service container

Container_Boundary("Core Domain Service", "Core Domain Service") {
    Component("Domain Controller", "Domain Controller", "Java / Spring Boot", "Handles incoming HTTP and gRPC requests for domain operations.")
    Component("Domain Business Logic", "Domain Business Logic", "Java / Spring Boot", "Implements the core business and transactional logic for the library management system.")
    Component("Data Access Repository", "Data Access Repository", "JDBC / Spring Data JPA", "Manages reads and writes of transactional data to the PostgreSQL database.")
    Component("Event Publisher", "Event Publisher", "Kafka / EventBridge Client", "Publishes and consumes asynchronous domain events via the managed event bus.")
}

Rel("Domain Controller", "Domain Business Logic", "Delegates request processing", "Direct Method Invocation")
Rel("Domain Business Logic", "Data Access Repository", "Persists and retrieves transactional data", "JDBC / TLS")
Rel("Domain Business Logic", "Event Publisher", "Dispatches domain events", "TLS-encrypted TCP with SASL/OAuth2")

@enduml