@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL Database container

System_Ext(CoreDomainService, "Core Domain Service", "External service interacting with the database.")
System_Ext(ManagedEventBus, "Managed Event Bus", "Kafka / EventBridge for streaming change events.")

Container_Boundary(PostgreSQLDatabase, "PostgreSQL Database") {
    Component(RelationalDataStore, "Relational Data Store", "PostgreSQL 16 with pgcrypto, pgaudit, and PgBouncer", "Manages transactional data storage with strict transactional integrity, EU-only residency enforcement, AES-256 data-at-rest encryption, compliance logging, and connection pooling.")
    Component(CDCPublisher, "CDC Publisher", "Debezium PostgreSQL Connector via Kafka Connect", "Streams raw database change events for decoupled search synchronization by reading the WAL stream using the Logical Replication Protocol.")
    Component(BackupandComplianceAgent, "Backup and Compliance Agent", "pgBackRest", "Handles automated backups supporting EU-only data residency requirements.")
}

Rel(CoreDomainService, RelationalDataStore, "Executes SQL queries via JDBC with TLS 1.3 / mTLS", "JDBC / TLS 1.3")
Rel(CDCPublisher, RelationalDataStore, "Reads WAL stream using Logical Replication Protocol over TCP with mTLS", "TCP / mTLS")
Rel(CDCPublisher, ManagedEventBus, "Streams raw database change events via Kafka Protocol", "Kafka Protocol")

@enduml