@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(LibraryStaff, "Library Staff", "Person using the system for cataloging and circulation.")
Person(LibraryPatrons, "Library Patrons", "Person using the self-service portal for search and borrowing.")

System(LibraryManagementSystem, "Library Management System", "An enterprise platform enabling public and academic libraries to catalogue physical and digital items, manage circulation, and provide self-service portals, enforcing strict EU-only data residency and sub-800ms search performance.")

System_Ext(PaymentGateway, "Payment Gateway", "External system processing tokenized fines and fees over HTTPS/REST.")
System_Ext(NationalLibraryRegistry, "National Library Registry", "External system syncing bibliographic data via SOAP/REST.")
System_Ext(IdentityProvider, "Identity Provider", "External/internal system handling centralized OIDC/OAuth 2.0 authentication.")
System_Ext(EUCloudHostingProvider, "EU Cloud Hosting Provider", "Infrastructure boundary utilizing ISO 27001-certified EU data centers.")

Rel(LibraryStaff, LibraryManagementSystem, "Accesses Web UI for cataloging and circulation", "HTTPS, OAuth 2.0/OpenID Connect MFA")
Rel(LibraryPatrons, LibraryManagementSystem, "Accesses Mobile/Web App for search and borrowing", "HTTPS, OIDC")
Rel(LibraryManagementSystem, PaymentGateway, "Processes tokenized fines and fees", "HTTPS/REST")
Rel(LibraryManagementSystem, NationalLibraryRegistry, "Syncs bibliographic data", "SOAP/REST with mTLS")
Rel(LibraryManagementSystem, IdentityProvider, "Performs token validation and authentication", "HTTPS/OIDC")

@enduml