@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Domain Service container

System_Ext(PaymentGateway, "Payment Gateway", "External payment provider for processing transactions.")
System_Ext(PostgreSQLDatabase, "PostgreSQL Database", "Stores core relational data with AES-256 encryption.")
System_Ext(ManagedKafkaEventBus, "Managed Kafka Event Bus", "Handles event streaming and message distribution.")

Container_Boundary(CoreDomainService, "Core Domain Service") {
    Component(CatalogManager, "CatalogManager", "Spring Boot / Java", "Manages the cataloguing of physical and digital items within the library system.")
    Component(CatalogQueryFacade, "CatalogQueryFacade", "Spring Boot / Java, jOOQ", "Provides read-optimized queries for catalog and search operations.")
    Component(CirculationEngine, "CirculationEngine", "Spring Boot / Java, Resilience4j", "Manages circulation processes and coordinates payment transactions.")
    Component(DomainEventPublisher, "DomainEventPublisher", "Spring Boot / Java, Kafka", "Publishes domain events to the managed Kafka event bus.")
}

Rel(CirculationEngine, PaymentGateway, "Processes transactions", "REST/HTTPS, mTLS, Resilience4j")
Rel(CatalogQueryFacade, PostgreSQLDatabase, "Executes read-optimized queries", "jOOQ")
Rel(DomainEventPublisher, ManagedKafkaEventBus, "Publishes domain events", "Kafka protocol, payload encryption")

@enduml