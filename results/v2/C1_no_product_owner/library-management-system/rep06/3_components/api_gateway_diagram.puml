@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(routing_load_balancer, "Routing & Load Balancer", "Spring Cloud Gateway", "Routes incoming API requests and balances load across backend services.")
    Component(auth_filter, "Authentication & Authorization Filter", "Spring Security", "Validates OAuth2 tokens and enforces role-based access control.")
    Component(rate_limiting, "Rate Limiting & Throttling", "Spring Cloud Gateway & Redis", "Controls request rates and enforces traffic limits.")
    Component(caching_transformation, "Caching & Response Transformation", "Spring Cloud Gateway & Redis", "Evaluates cached responses and transforms payloads for efficient delivery.")
}

Rel(routing_load_balancer, caching_transformation, "Evaluates cached responses", "Redis RESP / TLS")

@enduml