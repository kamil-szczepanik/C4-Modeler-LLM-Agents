@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Web Application", "Web Application") {
    Component("Patron Portal Module", "Patron Portal Module", "React / TypeScript", "Component managing catalog browsing, reservations, and profiles.")
    Component("Staff Dashboard Module", "Staff Dashboard Module", "React / TypeScript", "Component managing circulation, cataloging, and admin workflows.")
    Component("API Client Layer", "API Client Layer", "Axios / TypeScript", "Component handling Axios HTTP communication, JWTs, and input sanitization.")
    Component("State Management Core", "State Management Core", "Zustand", "Component managing localized UI state and session context.")
}

Rel("Patron Portal Module", "API Client Layer", "Dispatches requests", "In-Memory Function Calls")
Rel("Staff Dashboard Module", "API Client Layer", "Dispatches requests", "In-Memory Function Calls")
@enduml