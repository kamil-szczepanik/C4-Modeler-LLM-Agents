@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(search_service, "Search Service") {
    Component(SearchRESTController, "Search REST Controller", "Java / Spring REST Controller", "Handles incoming HTTP/REST search requests from the API Gateway.")
    Component(QueryParserBuilder, "Query Parser & Builder", "Java In-memory", "Parses and constructs search queries.")
    Component(ResilienceCachingProxy, "Resilience & Caching Proxy", "Java In-memory / RESP", "Manages caching, resilience patterns, and secure communication.")
    Component(IndexingWorker, "Indexing Worker", "Java Kafka Consumer", "Consumes asynchronous events from Kafka to index catalogue items.")
    ComponentDb(OpenSearchIndex, "OpenSearch Index", "OpenSearch", "Underlying data store for scalable search queries and EU data residency compliance.")
    ComponentDb(RedisCache, "Redis Cache", "Redis", "Distributed cache to guarantee sub-800ms response SLAs under heavy load.")
}

System_Ext(APIGateway, "API Gateway", "External API Gateway routing requests.")
System_Ext(AsyncEventBus, "Async Event Bus", "Managed Kafka", "Asynchronous event bus for decoupled catalogue ingestion.")

Rel(APIGateway, SearchRESTController, "HTTP/REST")
Rel(AsyncEventBus, IndexingWorker, "Kafka Consumer Protocol")
Rel(SearchRESTController, QueryParserBuilder, "In-memory")
Rel(QueryParserBuilder, ResilienceCachingProxy, "In-memory / RESP")
Rel(ResilienceCachingProxy, OpenSearchIndex, "HTTPS / mTLS")
Rel(ResilienceCachingProxy, RedisCache, "RESP over TLS")

@enduml