@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(async_event_bus, "Async Event Bus") {
    Component(Topic_Manager, "Topic Manager", "Managed Kafka Topics", "Manages Kafka topics (item-events, circulation-events) for partitioned event publishing.")
    Component(Access_Control___Auth_Component, "Access Control & Auth Component", "Kafka ACLs, SASL/SCRAM-SHA-512 & mTLS", "Secures service authentication and data in transit.")
    Component(Schema_Registry, "Schema Registry", "Confluent Schema Registry with Avro", "Ensures safe contract evolution and payload-level PII encryption.")
    Component(Event_Router___Partition_Key_Strategist, "Event Router / Partition Key Strategist", "Kafka Partition Strategy", "Routes events using partition keys to ensure ordered event streams.")
    Component(Dead_Letter_Queue__DLQ___Poison_Pill_Handler, "Dead Letter Queue (DLQ) & Poison Pill Handler", "Kafka DLQ Pattern", "Handles malformed messages and operational integrity.")
}

Rel(Topic_Manager, Schema_Registry, "Validates event schemas", "HTTP/REST")
Rel(Topic_Manager, Event_Router___Partition_Key_Strategist, "Routes and partitions events", "Kafka protocol")
Rel(Topic_Manager, Dead_Letter_Queue__DLQ___Poison_Pill_Handler, "Redirects poison pill messages")
Rel(Access_Control___Auth_Component, Topic_Manager, "Secures access via Kafka ACLs")

@enduml