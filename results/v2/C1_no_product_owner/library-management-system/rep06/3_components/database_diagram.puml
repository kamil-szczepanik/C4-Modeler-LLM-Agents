@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database container

Container_Boundary(database, "Database") {
    Component(ConnectionPooler, "Connection Pooler", "PgBouncer", "Enterprise connection pooler to prevent backend worker exhaustion.")
    Component(RelationalTables, "Relational Tables", "PostgreSQL SQL / PostgreSQL RLS / pgcrypto", "ACID-compliant relational persistence with row-level security and column-level encryption for patron isolation.")
    Component(AuditLoggingModule, "Audit Logging Module", "pgAudit extension", "Database event tracking for EU regulatory compliance.")
}

Rel(ConnectionPooler, RelationalTables, "Forwards pooled connections", "PostgreSQL Native Protocol over TLS 1.3")
Rel(RelationalTables, AuditLoggingModule, "Captures security events", "Internal PostgreSQL Hook")

@enduml