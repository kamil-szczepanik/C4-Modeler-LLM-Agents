@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Library Patron, "Library Patron", "End-user accessing self-service portals to search and borrow items.")
Person(Librarian / Library Staff, "Librarian / Library Staff", "Administrative users managing inventory and circulation desk operations.")
System(Library Management System, "Library Management System", "Provides cataloging, circulation, and self-service portals for public and academic libraries within EU data residency constraints, ensuring high-performance search capabilities while securing external payment and digital content integrations.")
System_Ext(Payment Gateway, "Payment Gateway", "External system handling fines and fees.")
System_Ext(Digital Content Provider, "Digital Content Provider", "Third-party APIs for streaming and downloading digital assets.")

Rel(Library Patron, Library Management System, "Catalog search and loan management", "HTTPS (Web/Mobile)")
Rel(Librarian / Library Staff, Library Management System, "Inventory and circulation control", "HTTPS")
Rel(Library Management System, Payment Gateway, "Fine payments processing", "REST/HTTPS with mutual TLS (mTLS)")
Rel(Library Management System, Digital Content Provider, "Digital asset access", "REST/HTTPS with mutual TLS (mTLS)")
@enduml