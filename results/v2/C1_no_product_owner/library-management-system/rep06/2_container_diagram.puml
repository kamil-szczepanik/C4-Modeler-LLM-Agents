@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(Library_Patron, "Library Patron", "End-user accessing self-service portals to search and borrow items.")
Person(Librarian_Library_Staff, "Librarian / Library Staff", "Administrative users managing inventory and circulation desk operations.")

System_Ext(Payment_Gateway, "Payment Gateway", "External system handling fines and fees.")
System_Ext(Digital_Content_Provider, "Digital Content Provider", "Third-party APIs for streaming and downloading digital assets.")

System_Boundary(Library_Management_System, "Library Management System") {
    Container(Web_Application, "Web Application", "React / TypeScript, EU CDN", "Single-page application powering the user interface for patrons and staff.")
    Container(API_Gateway, "API Gateway", "NGINX / Spring Cloud Gateway", "Entry point managing and routing external requests with TLS 1.3 and mTLS.")
    Container(Core_Domain_Service, "Core Domain Service", "Spring Boot / Java", "Implements core cataloguing and circulation business logic.")
    Container(Search_Service, "Search Service", "Elasticsearch / OpenSearch", "Provides high-performance search capabilities with sub-800ms response times.")
    Container(Async_Event_Bus, "Async Event Bus", "Managed Kafka", "Decouples core transactions from search indexing asynchronously.")
    ContainerDb(Database, "Database", "PostgreSQL", "Managed EU-hosted transactional persistence with AES-256 encryption.")
}

Rel(Library_Patron, Web_Application, "Accesses portal features", "HTTPS")
Rel(Librarian_Library_Staff, Web_Application, "Manages inventory and circulation", "HTTPS")
Rel(Web_Application, API_Gateway, "Makes API requests", "HTTPS / TLS 1.3")
Rel(API_Gateway, Core_Domain_Service, "Routes requests", "gRPC/REST with mTLS")
Rel(Core_Domain_Service, Database, "Persists and retrieves transaction data", "JDBC (AES-256 encrypted)")
Rel(Core_Domain_Service, Async_Event_Bus, "Publishes domain events", "Kafka protocol")
Rel(Search_Service, Async_Event_Bus, "Consumes events for search indexing", "Kafka protocol")
Rel(Core_Domain_Service, Payment_Gateway, "Processes fine payments", "REST/HTTPS with mTLS")
Rel(Core_Domain_Service, Digital_Content_Provider, "Accesses digital assets", "REST/HTTPS with mTLS")

@enduml