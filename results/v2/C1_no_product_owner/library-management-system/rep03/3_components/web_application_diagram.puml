@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application container

Container_Boundary(web_application, "Web Application") {
    Component(Routing_Shell, "Routing & Shell", "React Router", "Orchestrates UI layouts and roles.")
    Component(State_Management, "State Management", "Zustand / React Query", "Manages server-state caching and UI state.")
    Component(API_Client_Layer, "API Client Layer", "Axios / Fetch", "Communicates with external APIs and services.")
    Component(Feature_Modules, "Feature Modules", "React 18, TypeScript", "Patron Portal & Staff Portal functionality.")
}

Rel(Routing_Shell, Feature_Modules, "Orchestrates UI layouts and roles", "")
Rel(Feature_Modules, State_Management, "Retrieves and caches data", "")
Rel(Feature_Modules, API_Client_Layer, "Retrieves and caches data", "")

@enduml