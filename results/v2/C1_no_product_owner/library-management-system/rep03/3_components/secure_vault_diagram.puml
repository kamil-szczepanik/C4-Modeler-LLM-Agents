@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Secure Vault container

Container_Boundary(secure_vault, "Secure Vault") {
    Component(Secrets_Engine, "Secrets Engine", "HashiCorp Vault KV & Database", "Manages static and dynamic secrets, including dynamic database credentials for PostgreSQL via encrypted connections.")
    Component(PKI_Engine, "PKI Engine", "HashiCorp Vault PKI Secrets Engine", "Handles PKI certificate generation.")
    Component(Transit_Encryption_Engine, "Transit Encryption Engine", "HashiCorp Vault Transit Engine", "Provides transit encryption for the system.")
    Component(Auth_Method_Seal_Manager, "Auth Method / Seal Manager", "AppRole, JWT/OIDC, Cloud Auto-Unseal", "Implements strict least-privilege authentication, short token TTLs, and automated zero-touch recovery.")
    Component(Audit_Logging_Telemetry_Engine, "Audit Logging & Telemetry Engine", "HashiCorp Vault Audit & Telemetry Devices", "Exports encrypted telemetry and metrics to the OpenTelemetry Collector and Prometheus/Grafana stack.")
    Component(Secret_Sidecar_Cache, "Secret Sidecar Cache", "Automated sidecar injector with circuit breaking", "Provides automated secret injection and caching with circuit breaking to prevent cascading failures.")
}

Component(Core_Domain_Microservice, "Core Domain Microservice", "Microservice", "External microservice communicating with Secure Vault via mTLS.")
Component(Database, "Database", "PostgreSQL", "Database storing system data with credentials managed dynamically.")
Component(Observability_Stack, "Observability Stack", "OpenTelemetry Collector and Prometheus/Grafana", "Receives encrypted telemetry and metrics export.")

Rel(Core_Domain_Microservice, Secret_Sidecar_Cache, "Communicates via mTLS (TLS 1.3) using Vault API and sidecar caching.", "mTLS / TLS 1.3")
Rel(Secret_Sidecar_Cache, Secrets_Engine, "Injects runtime secrets and retrieves configurations.", "Vault API")
Rel(Audit_Logging_Telemetry_Engine, Observability_Stack, "Exports encrypted telemetry and metrics.", "Encrypted Stream")
Rel(Secrets_Engine, Database, "Manages dynamic database credentials for PostgreSQL via encrypted connections.", "Encrypted Connection")

@enduml