@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database container

Person(Core Domain Microservice, "Core Domain Microservice", "External service interacting with the database")
System_Ext(Secure Vault, "Secure Vault", "External secret management system")
System_Ext(OpenTelemetry Collector, "OpenTelemetry Collector", "External observability collector")
System_Ext(EU-Only Object Storage Bucket, "EU-Only Object Storage Bucket", "External EU-only object storage for backups")

Container_Boundary(Database, "Database") {
    Component(Relational Storage Engine, "Relational Storage Engine", "PostgreSQL 15", "Provides secure, highly available, and EU-compliant relational data storage with ACID compliance, Row-Level Security (RLS), and pgcrypto.")
    Component(Connection Pool Manager, "Connection Pool Manager", "HikariCP", "Handles high-performance connection pooling to meet concurrency and performance targets.")
    Component(Read Replica Engine, "Read Replica Engine", "PostgreSQL 15", "Handles read scaling and query offloading.")
    Component(Secrets Management Agent, "Secrets Management Agent", "HashiCorp Vault Agent", "Manages dynamic credential generation, key management, and automated rotation.")
    Component(Security & Encryption Engine, "Security & Encryption Engine", "pgcrypto / mTLS", "Provides encrypted persistence and security controls like row-level security and mTLS.")
    Component(Automated Backup & PITR Engine, "Automated Backup & PITR Engine", "PostgreSQL PITR / Cloud Native Tools", "Handles automated backups and Point-In-Time Recovery to EU-only object storage.")
    Component(Replica Sync Monitor, "Replica Sync Monitor", "Custom Monitoring Script", "Monitors synchronization status between primary and read replicas.")
    Component(Audit & Replication Log, "Audit & Replication Log", "pgaudit", "Deployed for comprehensive security auditing and log management.")
}

Rel(Core Domain Microservice, Connection Pool Manager, "JDBC / TCP with TLS 1.3 and mTLS", "JDBC / TCP")
Rel(Connection Pool Manager, Relational Storage Engine, "Internal IPC", "Internal IPC")
Rel(Secure Vault, Secrets Management Agent, "HTTPS / REST", "HTTPS / REST")
Rel(Secrets Management Agent, Relational Storage Engine, "Internal IPC", "Internal IPC")
Rel(Security & Encryption Engine, OpenTelemetry Collector, "OTLP", "OTLP")
Rel(Automated Backup & PITR Engine, EU-Only Object Storage Bucket, "HTTPS", "HTTPS")

@enduml