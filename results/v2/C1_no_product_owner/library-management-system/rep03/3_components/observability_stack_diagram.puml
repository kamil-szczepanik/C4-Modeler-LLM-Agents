@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Observability Stack container

Container_Boundary(observability_stack, "Observability Stack") {
    Component(OpenTelemetry_Collector, "OpenTelemetry Collector", "OpenTelemetry Collector", "Ingests, filters, and forwards traces and metrics, ensuring strict EU data residency compliance.")
    Component(Prometheus, "Prometheus", "Prometheus TSDB", "Scrapes and stores high-performance time-series metrics.")
    Component(Grafana_Loki, "Grafana Loki", "Grafana Loki", "Aggregates structured logs for scalable, cost-effective log management.")
    Component(Grafana, "Grafana", "Grafana with OIDC-backed RBAC", "Visualizes metrics, traces, and logs for operator visualization.")
    Component(HashiCorp_Vault, "HashiCorp Vault", "HashiCorp Vault", "Manages encryption keys for data at rest.")
}

Rel(OpenTelemetry_Collector, Grafana_Loki, "Forwards structured logs", "OTLP/HTTP")
Rel(Grafana, Prometheus, "Queries metrics", "PromQL/TLS 1.3")
Rel(Grafana, Grafana_Loki, "Queries logs", "LogQL/TLS 1.3")

@enduml