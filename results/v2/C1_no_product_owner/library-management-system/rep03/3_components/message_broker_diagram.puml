@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Message Broker container

System_Ext(CoreDomainMicroservice, "Core Domain Microservice", "External producer of catalog events.")
System_Ext(AsyncWorker, "Async Worker", "External consumer of background jobs.")
System_Ext(SecureVault, "Secure Vault", "External secret management service.")
System_Ext(ObservabilityStack, "Observability Stack", "External monitoring and telemetry platform.")

Container_Boundary(MessageBroker, "Message Broker") {
    Component(ExchangeRouter, "Exchange Router", "RabbitMQ Core Exchange Engine", "Routes incoming catalog events and background jobs.")
    Component(QueueManager, "Queue Manager", "Erlang ETS / Mnesia with Quorum Queues", "Manages message durability and high availability using quorum queues.")
    Component(ConnectionSecurityHandler, "Connection & Security Handler", "RabbitMQ SSL/TLS Plugin with mTLS", "Handles secure connections and mutual TLS authentication.")
    Component(DeadLetterExchangeRetryComponent, "Dead Letter Exchange & Retry Component", "Quarantine queue mechanism", "Handles failed messages and retries via quarantine queues.")
    Component(ManagementTelemetryExporter, "Management & Telemetry Exporter", "RabbitMQ Prometheus Plugin", "Exposes system metrics for telemetry and monitoring.")
}

Rel(CoreDomainMicroservice, ExchangeRouter, "Publishes catalog events", "AMQPS over TLS / mTLS")
Rel(AsyncWorker, QueueManager, "Consumes background jobs", "AMQPS over TLS / mTLS")
Rel(QueueManager, SecureVault, "Fetches TLS credentials", "HTTPS")
Rel(ObservabilityStack, ManagementTelemetryExporter, "Scrapes metrics", "HTTP/S")

@enduml