@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(tls_termination, "TLS Termination", "Envoy Filter", "Terminates incoming HTTPS connections from the Web Application.")
    Component(waf, "WAF", "Envoy Security Filter", "Provides Web Application Firewall protection against malicious traffic.")
    Component(token_exchange, "Token Exchange", "Envoy Authentication Filter", "Handles token validation and claim injection for incoming requests.")
    Component(routing_engine, "Routing Engine", "Envoy Routing Filter", "Manages edge routing of requests to downstream microservices.")
    Component(rate_limiting, "Rate Limiting", "Envoy Rate Limit Filter", "Enforces traffic rate limits to ensure system stability and performance.")
    Component(telemetry, "Telemetry", "OpenTelemetry Filter", "Collects and propagates standardized telemetry data.")
}

Rel(tls_termination, waf, "Passes decrypted traffic for security inspection")
Rel(waf, token_exchange, "Forwards validated traffic for authentication and claim injection")
Rel(token_exchange, routing_engine, "Sends enriched requests with injected claims")
Rel(routing_engine, rate_limiting, "Checks request quotas before dispatching")

@enduml