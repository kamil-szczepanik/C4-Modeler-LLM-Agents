@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(LibraryPatron, "Library Patron", "Library user who searches for and borrows physical and digital items.")
Person(LibrarianStaff, "Librarian / Staff", "Library staff member who catalogues items and manages circulation.")

System(LibraryManagementSystem, "Library Management System", "Provides self-service portals and circulation management for public and academic libraries, cataloguing physical and digital items while strictly adhering to EU data residency mandates.")

System_Ext(PaymentGateway, "Payment Gateway", "External system that processes fines with tokenized payments.")
System_Ext(NotificationService, "Notification Service", "External service that sends due date reminders.")
System_Ext(DigitalContentProvider, "Digital Content Provider", "External provider that supplies e-books and digital media.")

Rel(LibraryPatron, LibraryManagementSystem, "Searches and borrows items", "HTTPS")
Rel(LibrarianStaff, LibraryManagementSystem, "Catalogues items and manages circulation", "HTTPS")
Rel(LibraryManagementSystem, PaymentGateway, "Processes fines with tokenized payments", "REST over TLS 1.3")
Rel(LibraryManagementSystem, NotificationService, "Sends due date reminders", "SMTP/REST")
Rel(LibraryManagementSystem, DigitalContentProvider, "Accesses e-books and digital media", "REST and OAuth2")

@enduml