@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(interoperability_adapter, "Interoperability Adapter") {
    Component(FHIR_Translation_Service, "FHIR Translation Service", "TypeScript/Fastify", "Translates internal domain models into external US HL7 FHIR interoperability standards.")
    Component(EU_E_Prescription_Adapter, "EU E-Prescription Adapter", "TypeScript", "Translates internal domain models into EU E-Prescription standards and interacts with national gateways.")
    Component(Egress_Policy_Enforcer, "Egress Policy Enforcer", "Rust/WebAssembly", "Powers high-performance deterministic payload inspection and enforces strict regional data residency and compliance.")
    Component(Resilience_Queue_Manager, "Resilience & Queue Manager", "Node.js/BullMQ", "Manages asynchronous retries and offloads failing egress messages.")
    Component(Data_Residency_Enforcer, "Data Residency Enforcer", "Rust/Node.js", "Ensures health data never crosses borders without explicit consent.")
}

System_Ext(GCP_Pub_Sub, "GCP Pub/Sub", "Regional DLQ Topics")

Rel(Egress_Policy_Enforcer, FHIR_Translation_Service, "Forwards sanitized payloads", "Internal")
Rel(Egress_Policy_Enforcer, EU_E_Prescription_Adapter, "Forwards sanitized payloads", "Internal")
Rel(Resilience_Queue_Manager, GCP_Pub_Sub, "Offloads failing egress messages", "gRPC/HTTPS")

@enduml