@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(GCP_External_HTTPS_Load_Balancer_TLS_Termination_Edge_Policy_Component, "GCP External HTTP(S) Load Balancer & TLS Termination Edge Policy Component", "GCP Cloud Load Balancing, WAF", "Handles global geo-routing, edge WAF protection, HTTPS/TLS 1.3, and WebSockets/WebRTC session handling.")
    Component(Auth_Consent_Enforcement_Component, "Auth & Consent Enforcement Component", "Envoy Ext-Authz, OAuth2, JWT", "Enforces authentication with token binding and validates purpose-limitation consent.")
    Component(Traffic_Routing_Mesh_Proxy_Component, "Traffic Routing & Mesh Proxy Component", "Envoy Sidecar/Gateway, GCP Service Mesh, SPIFFE/SPIRE", "Manages edge routing, circuit breaking, and strict mTLS for internal communication.")
}

System_Ext(Consent_Management_Service, "Consent Management Service", "External or dependent service for managing consent.")

Rel(GCP_External_HTTPS_Load_Balancer_TLS_Termination_Edge_Policy_Component, Auth_Consent_Enforcement_Component, "Forwards incoming client traffic for authentication and authorization check", "HTTPS/TLS")
Rel(Auth_Consent_Enforcement_Component, Traffic_Routing_Mesh_Proxy_Component, "Passes authorized traffic for internal routing", "gRPC")
Rel(Traffic_Routing_Mesh_Proxy_Component, Consent_Management_Service, "Validates purpose-limitation consent and forwards regional requests", "gRPC / strict mTLS")

@enduml