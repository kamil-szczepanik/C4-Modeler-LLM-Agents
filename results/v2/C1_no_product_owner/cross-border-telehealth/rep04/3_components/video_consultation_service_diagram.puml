@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component Diagram for the Video Consultation Service container

Container_Boundary(video_consultation_service, "Video Consultation Service") {
    Component(SignalingController, "Signaling Controller", "Node.js / WebSockets", "Manages low-latency session signaling and SDP exchanges.")
    Component(SFUMediaRouter, "SFU Media Router", "LiveKit Core / Go", "Powers the SFU media routing container for real-time video.")
    Component(AdaptiveQualityManager, "Adaptive Quality Manager", "Go", "Enforces bitrate limits and ensures reliable video consultations under degraded rural bandwidth constraints.")
    Component(SessionAuditLogger, "Session Audit Logger", "Go / gRPC", "Emits and persists signed session lifecycle events.")
}

Component_Ext(RegionalIAMServices, "Regional IAM Services", "Google Cloud IAM", "Validates JWT tokens securely.")
Component_Ext(DataStorage, "Data Storage", "SQL / Google Cloud Memorystore for Redis", "Persists signed audit logs and maintains decoupled, regional ephemeral room state.")

Rel(SignalingController, SFUMediaRouter, "Controls media streams", "gRPC")
Rel(AdaptiveQualityManager, SFUMediaRouter, "Enforces bitrate limits", "Internal API")
Rel(SignalingController, RegionalIAMServices, "Validates JWT tokens", "gRPC/mTLS")
Rel(SignalingController, SessionAuditLogger, "Emits session lifecycle events", "gRPC")
Rel(SessionAuditLogger, DataStorage, "Persists signed audit logs", "SQL")

@enduml