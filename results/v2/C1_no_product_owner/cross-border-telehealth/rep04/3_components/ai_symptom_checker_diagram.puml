@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Symptom Checker container

Container_Boundary(ai_symptom_checker, "AI Symptom Checker") {
    Component(Symptom API Controller, "Symptom API Controller", "Python / FastAPI", "Routes authenticated ingress requests and validates user consent.")
    Component(PHI Sanitization Middleware, "PHI Sanitization Middleware", "Python", "Sanitizes Protected Health Information before processing.")
    Component(Clinical NLP Pipeline, "Clinical NLP Pipeline", "spaCy / Hugging Face", "Performs tokenization and clinical natural language processing.")
    Component(Triage Inference Engine, "Triage Inference Engine", "PyTorch / Triton Inference Server", "Handles urgency classification and inference.")
    Component(Audit & Traceability Logger, "Audit & Traceability Logger", "Python", "Emits signed audit records via an in-memory queue.")
    Component(Istio Service Mesh Circuit Breaker, "Istio Service Mesh Circuit Breaker", "Istio", "Manages traffic and provides resilience for unstable connections.")
}

Rel(Symptom API Controller, PHI Sanitization Middleware, "Passes ingress request data for sanitization", "In-process")
Rel(PHI Sanitization Middleware, Clinical NLP Pipeline, "Forwards sanitized text for tokenization", "In-process")
Rel(Clinical NLP Pipeline, Triage Inference Engine, "Sends processed tokens for urgency classification", "Internal data flow")
Rel(Triage Inference Engine, Audit & Traceability Logger, "Emits signed audit records", "In-memory queue")
Rel(Symptom API Controller, Istio Service Mesh Circuit Breaker, "Manages network traffic and fault tolerance", "mTLS / Mesh")

@enduml