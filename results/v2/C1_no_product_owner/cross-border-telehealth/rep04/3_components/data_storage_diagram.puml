@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Storage container

System_Ext(VideoConsultationService, "Video Consultation Service", "External service interacting with the data storage.")
System_Ext(AISymptomChecker, "AI Symptom Checker", "External service interacting with the data storage.")
System_Ext(ConsentManagementService, "Consent Management Service", "External service interacting with the data storage.")
System_Ext(CloudAuditLogs, "Cloud Audit Logs", "External audit logging service.")

Container_Boundary(DataStorage, "Data Storage") {
    Component(RelationalDatabaseComponent, "Relational Database Component", "Cloud SQL PostgreSQL", "Stores transactional data, metadata, and audit logs with row-level security (RLS).")
    Component(ObjectStorageComponent, "Object Storage Component", "Google Cloud Storage", "Stores unstructured blobs and consultation recordings with regional bucket locks.")
    Component(AuditTraceabilityLedgerComponent, "Audit & Traceability Ledger Component", "Append-only ledgers and cryptographic hashing", "Guarantees medical accountability and tamper-proof traceability for AI symptom-checker outputs.")
    Component(DataAccessRouter, "DataAccess Router", "Internal Library/Sidecar", "Routes data access requests securely within the storage container.")
    Component(HL7FHIRMappingSchemalayer, "HL7/FHIR Mapping Schema layer", "Schema mapping layer", "Maps data to HL7/FHIR standards for interoperability.")
    Component(CustomerManagedEncryptionKeys, "Customer-Managed Encryption Keys", "CMEK", "Enforces data-at-rest encryption across regions.")
    Component(GoogleCloudIAMDatabaseAuthentication, "Google Cloud IAM Database Authentication", "IAM Authentication", "Eliminates static credentials using short-lived tokens.")
}

Rel(VideoConsultationService, RelationalDatabaseComponent, "Persists session data", "gRPC/SQL via mTLS/TLS 1.3")
Rel(AISymptomChecker, RelationalDatabaseComponent, "Persists symptom analysis logs and inputs", "gRPC/SQL via mTLS/TLS 1.3")
Rel(ConsentManagementService, RelationalDatabaseComponent, "Persists consent records", "gRPC/SQL via mTLS/TLS 1.3")
Rel(RelationalDatabaseComponent, CloudAuditLogs, "Streams audit and access logs", "Cloud Logging API")

@enduml