@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Regional GKE Clusters container

System_Ext(GCP_Secret_Manager, "GCP Secret Manager", "Stores PHI keys and secrets.")
System_Ext(API_Gateway, "API Gateway", "Internal API Gateway service.")
System_Ext(Global_Management_Plane, "Global Management Plane", "Drives declarative cluster state via GitOps.")

Container_Boundary(regional_gke_clusters, "Regional GKE Clusters") {
    Component(Ingress_Controller, "Ingress Controller", "Envoy / GKE Ingress", "Handles geo-routing and TLS 1.3 termination for incoming traffic.")
    Component(Service_Mesh_Control_Plane, "Service Mesh Control Plane", "Istio", "Manages mTLS and internal traffic isolation for zero-trust boundaries.")
    Component(External_Secrets_Operator, "External Secrets Operator", "External Secrets Operator / Workload Identity", "Manages PHI keys securely via GCP Secret Manager.")
    Component(Security_Observability_Agents, "Security & Observability Agents", "Falco, Argo Rollouts, Prometheus, Grafana, Cloud Logging", "Enforces security runtime policies, progressive delivery, and monitoring.")
}

Rel(External_Secrets_Operator, GCP_Secret_Manager, "Fetches secrets securely", "HTTPS/OIDC federation")
Rel(Ingress_Controller, API_Gateway, "Routes traffic internally", "HTTP/2 and gRPC via ClusterIP")
Rel(Global_Management_Plane, regional_gke_clusters, "Drives declarative cluster state", "GitOps (ArgoCD)")

@enduml