@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "Patients in the EU and US using mobile and web apps for video consultations, e-prescriptions, and the AI symptom checker.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Clinicians using mobile and web apps to conduct video consultations and manage patient care.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and US while enforcing strict regional data residency.")

System_Ext(EU_Telehealth_System, "EU Telehealth System", "Regional telehealth system deployed in europe-west3 for EU data residency.")
System_Ext(US_Telehealth_System, "US Telehealth System", "Regional telehealth system deployed in us-central1 for US data residency.")
System_Ext(Global_Management_Plane, "Global Management Plane", "Oversees metadata synchronization, AI versioning, and governance.")
System_Ext(National_E_Prescription_Gateways_EU, "National E-Prescription Gateways (EU)", "External gateways for transmitting e-prescriptions in the EU.")
System_Ext(HL7_FHIR_Interoperability_Services_US, "HL7 FHIR Interoperability Services (US)", "External interoperability services for US healthcare data exchange.")
System_Ext(Regional_IAM_Services, "Regional IAM Services", "Identity Providers utilizing OAuth2/OIDC for authentication.")
System_Ext(Local_EU_US_Pharmacies, "Local EU/US Pharmacies", "Pharmacies receiving prescriptions locally.")

Rel(Patients, Cross_Border_Telehealth_Platform, "Connects via mobile/web apps for APIs and video consultations", "HTTPS/WebRTC")
Rel(Licensed_Clinicians, Cross_Border_Telehealth_Platform, "Connects via mobile/web apps for consultations and prescriptions", "HTTPS/WebRTC")
Rel(Cross_Border_Telehealth_Platform, EU_Telehealth_System, "Routes EU traffic to region-locked infrastructure", "HTTPS")
Rel(Cross_Border_Telehealth_Platform, US_Telehealth_System, "Routes US traffic to region-locked infrastructure", "HTTPS")
Rel(Cross_Border_Telehealth_Platform, Global_Management_Plane, "Syncs metadata, AI versions, and governance", "mTLS / Scoped OAuth2")
Rel(EU_Telehealth_System, National_E_Prescription_Gateways_EU, "Transmits e-prescriptions via national gateways", "HTTPS/REST")
Rel(US_Telehealth_System, HL7_FHIR_Interoperability_Services_US, "Exchanges healthcare data using interoperability services", "HL7 FHIR / HTTPS")
Rel(Cross_Border_Telehealth_Platform, Regional_IAM_Services, "Validates tokens via regional identity providers", "OAuth2/OIDC")
Rel(EU_Telehealth_System, Local_EU_US_Pharmacies, "Sends prescriptions to local pharmacies", "HTTPS/REST")
Rel(US_Telehealth_System, Local_EU_US_Pharmacies, "Sends prescriptions to local pharmacies", "HTTPS/REST")

@enduml