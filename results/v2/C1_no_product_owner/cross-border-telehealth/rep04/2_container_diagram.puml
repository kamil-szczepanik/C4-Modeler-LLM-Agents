@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "Patients in the EU and US using mobile and web apps for video consultations, e-prescriptions, and the AI symptom checker.")
Person(Clinicians, "Licensed Clinicians", "Clinicians using mobile and web apps to conduct video consultations and manage patient care.")

System_Ext(National_Gateways, "National E-Prescription Gateways (EU) & HL7 FHIR Interoperability Services (US)", "External national gateways and interoperability services.")
System_Ext(Global_Management_Plane, "Global Management Plane", "Oversees metadata synchronization, AI versioning, and governance via Istio service mesh.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(API_Gateway, "API Gateway", "Cloud Endpoints / Envoy", "Routes incoming client traffic to appropriate backend services.")
    Container(Video_Consultation_Service, "Video Consultation Service", "WebRTC SFU via LiveKit", "Handles video consultations supporting degraded bandwidth under 300 kbit/s.")
    Container(AI_Symptom_Checker, "AI Symptom Checker", "Python / FastAPI", "Hosts AI symptom checker with model version logging.")
    Container(Interoperability_Adapter, "Interoperability Adapter", "Node.js", "Adapter for HL7 FHIR and EU e-prescriptions.")
    Container(Consent_Management_Service, "Consent Management Service", "Go / gRPC", "Manages granular data sharing and inline consent checks.")
    ContainerDb(Data_Storage, "Data Storage", "Cloud SQL PostgreSQL + Cloud Storage", "Region-locked persistence with CMEK encryption.")
    Container(Regional_GKE_Clusters, "Regional GKE Clusters", "GCP GKE (europe-west3, us-central1)", "Isolated regional clusters for data residency compliance.")
}

Rel(Patients, API_Gateway, "Connects for API requests and video consultations", "HTTPS/REST and WebSockets/WebRTC")
Rel(Clinicians, API_Gateway, "Connects for consultations and prescriptions", "HTTPS/REST and WebSockets/WebRTC")
Rel(API_Gateway, Video_Consultation_Service, "Routes video session requests", "HTTPS/gRPC")
Rel(API_Gateway, AI_Symptom_Checker, "Routes symptom check requests", "HTTPS/gRPC")
Rel(API_Gateway, Interoperability_Adapter, "Routes prescription and data exchange requests", "HTTPS/gRPC")
Rel(API_Gateway, Consent_Management_Service, "Validates consent", "gRPC")
Rel(Video_Consultation_Service, Data_Storage, "Persists session data", "gRPC/SQL")
Rel(AI_Symptom_Checker, Data_Storage, "Persists symptom analysis logs", "gRPC/SQL")
Rel(Consent_Management_Service, Data_Storage, "Persists consent records", "gRPC/SQL")
Rel(Interoperability_Adapter, National_Gateways, "Exchanges health data and prescriptions", "HTTPS/REST")
Rel(Global_Management_Plane, Regional_GKE_Clusters, "Manages global policies and synchronization", "Istio service mesh / mTLS")

@enduml