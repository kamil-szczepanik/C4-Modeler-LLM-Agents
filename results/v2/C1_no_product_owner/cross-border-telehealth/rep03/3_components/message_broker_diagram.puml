@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Message Broker container

System_Ext(Core_Telehealth_Service, "Core Telehealth Service", "Go / gRPC & REST service managing primary telehealth logic.")
System_Ext(Integration_Service, "Integration Service", "Java / Spring Boot service connecting to external pharmacy networks.")

Container_Boundary(Message_Broker, "Message Broker") {
    Component(Regional_Topics, "Regional Topics", "Google Cloud Pub/Sub (eu-events, us-events)", "Manages regional message partitioning for strict data residency and asynchronous event distribution.")
    Component(Schema_Registry, "Schema Registry", "Google Cloud Pub/Sub Schema Registry", "Validates message payloads to ensure data consistency across cross-border services.")
    Component(Dead_Letter_Queues, "Dead Letter Queues", "Google Cloud Pub/Sub DLQ", "Captures undelivered or failed messages like e-prescriptions for manual replay and inspection.")
}

Rel(Core_Telehealth_Service, Regional_Topics, "Publishes asynchronous events and e-prescription messages", "gRPC")
Rel(Regional_Topics, Integration_Service, "Delivers payloads via push/pull subscriptions", "HTTPS/gRPC")
Rel(Integration_Service, Dead_Letter_Queues, "Manages manual replay and inspection of failed e-prescriptions", "Cloud Pub/Sub API")
@enduml