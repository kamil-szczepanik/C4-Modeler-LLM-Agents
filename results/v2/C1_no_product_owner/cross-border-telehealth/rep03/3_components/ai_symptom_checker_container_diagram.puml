@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("AI Symptom Checker Container", "AI Symptom Checker Container") {
    Component("API_Router_Controller", "API Router / Controller", "FastAPI", "FastAPI component handling internal gRPC endpoints.")
    Component("Preprocessing_NLP_Component", "Preprocessing & NLP Component", "spaCy / Hugging Face", "Component for clinical entity extraction.")
    Component("Inference_Engine", "Inference Engine", "PyTorch", "Execution engine for care urgency prediction.")
    Component("Audit_Traceability_Logger", "Audit & Traceability Logger", "Python", "Component capturing inputs, predictions, and model versions.")
    Component("Model_Registry_Client", "Model Registry Client", "Python", "Component fetching version-pinned models from regional GCP Artifact Registry.")
}

Rel("API_Router_Controller", "Preprocessing_NLP_Component", "Sanitizes and extracts entities", "In-memory function calls")
Rel("Preprocessing_NLP_Component", "Inference_Engine", "Passes clinical tokens", "PyTorch tensors")
Rel("Inference_Engine", "Audit_Traceability_Logger", "Dispatches traceability events", "Asynchronous event dispatch")
Rel("Inference_Engine", "Model_Registry_Client", "Loads model weights", "Local cache read")

@enduml