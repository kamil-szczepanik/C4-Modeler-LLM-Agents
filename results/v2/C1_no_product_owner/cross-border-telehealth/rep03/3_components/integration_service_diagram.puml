@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Service container

Container_Boundary(integration_service, "Integration Service") {
    Component(Prescription_Router_Component, "Prescription Router Component", "Spring Integration", "Handles protocol routing and orchestration for e-prescriptions.")
    Component(EU_Gateway_Adapter_Component, "EU Gateway Adapter Component", "Spring WebClient", "Exchanges e-prescriptions with EU National e-Prescription Gateways.")
    Component(US_Pharmacy_Adapter_Component, "US Pharmacy Adapter Component", "Spring WebClient", "Exchanges e-prescriptions with US Pharmacy Networks.")
    Component(Data_Residency_Enforcer_Component, "Data Residency Enforcer Component", "Java / Spring Boot", "Enforces regional data residency for external communications.")
    Component(Audit_Logging_Component, "Audit Logging Component", "Java / Spring Boot with GCP KMS", "Handles cryptographic signing and audit logging.")
}

Rel(Prescription_Router_Component, EU_Gateway_Adapter_Component, "Routes EU-bound e-prescriptions")
Rel(Prescription_Router_Component, US_Pharmacy_Adapter_Component, "Routes US-bound e-prescriptions")
Rel(EU_Gateway_Adapter_Component, Data_Residency_Enforcer_Component, "Validates regional data compliance")
Rel(US_Pharmacy_Adapter_Component, Data_Residency_Enforcer_Component, "Validates regional data compliance")
Rel(Prescription_Router_Component, Audit_Logging_Component, "Logs prescription dispatch events")

@enduml