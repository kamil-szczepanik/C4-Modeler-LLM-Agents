@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(CloudStorage, "Cloud Storage", "Cloud Storage", "Stores encrypted session artifacts regionally [HTTPS/SRTP].")

Container_Boundary(video_consultation_service, "Video Consultation Service") {
    Component(SignalingComponent, "Signaling Component", "Node.js / WebSocket", "Manages peer connection negotiation and room states.")
    Component(MediaRoutingComponent, "Media Routing Component", "Mediasoup SFU / C++", "Handles real-time packet routing, simulcast, and bitrate scaling.")
    Component(BandwidthAdaptationComponent, "Bandwidth Adaptation Component", "Go", "Dynamically downscales streams for degraded mode (<300 kbit/s).")
    Component(ComplianceRecordingComponent, "Compliance Recording Component", "C++ / Python", "Encrypts and streams session audit logs.")
    Component(TelemetryCollectorComponent, "Telemetry Collector Component", "Node.js", "Gathers WebRTC stats and exposes Prometheus metrics.")
}

Rel(SignalingComponent, MediaRoutingComponent, "Controls SFU worker threads", "In-Process IPC")
Rel(BandwidthAdaptationComponent, MediaRoutingComponent, "Adjusts bitrates based on telemetry", "gRPC")
Rel(TelemetryCollectorComponent, BandwidthAdaptationComponent, "Feeds real-time network metrics", "In-Process IPC")
Rel(MediaRoutingComponent, CloudStorage, "Stores encrypted session artifacts regionally", "HTTPS/SRTP")

@enduml