@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Telehealth Service container

Container_Boundary(core_telehealth_service, "Core Telehealth Service") {
    Component(Consultation_Orchestrator, "Consultation Orchestrator", "Go (Golang)", "Manages session lifecycles and workflow coordination.")
    Component(EPrescription_Workflow_Engine, "E-Prescription Workflow Engine", "Go (Golang)", "Coordinates regional pharmacy routing.")
    Component(Consent__Privacy_Manager, "Consent & Privacy Manager", "Go (Golang)", "Evaluates granular patient consent policies.")
    Component(Audit__Traceability_Logger, "Audit & Traceability Logger", "Go (Golang)", "Captures immutable compliance and AI logs.")
}

System_Ext(Cloud_SQL_PostgreSQL, "Cloud SQL PostgreSQL", "Provides regional, isolated relational storage with regional connection pooling.")
System_Ext(Video_Consultation_Service, "Video Consultation Service", "External video consultation service")

Rel(Consultation_Orchestrator, Consent__Privacy_Manager, "Queries active consent", "Internal gRPC via mTLS")
Rel(EPrescription_Workflow_Engine, Audit__Traceability_Logger, "Emits compliance events", "In-memory channel / internal event bus")
Rel(core_telehealth_service, Cloud_SQL_PostgreSQL, "Persists operational state and PHI", "pgx driver over TLS")
Rel(core_telehealth_service, Video_Consultation_Service, "Manages video sessions", "WebRTC / gRPC")

@enduml