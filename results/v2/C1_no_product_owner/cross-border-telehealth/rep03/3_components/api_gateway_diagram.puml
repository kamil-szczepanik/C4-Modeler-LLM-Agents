@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(routing_controller, "Routing & Regional Affinity Controller", "Envoy Proxy / Google Cloud API Gateway", "Sends client requests, manages WebRTC signaling, and handles edge routing and localized multi-region deployment.")
    Component(auth_filter, "Authentication & Authorization Filter", "JWT with Token-Embedded Consent", "Enables local cryptographic authorization without synchronous database lookups.")
    Component(resilience_module, "Resilience & Rate Limiting Module", "Envoy Proxy / WAF", "Secures the platform with circuit breaking and rate limiting to preserve availability for unstable connections.")
    Component(validator, "Payload Inspection & Schema Validator", "Native Protobuf Schema Validator", "Passes ingress traffic for validation and minimizes CPU overhead for low-bandwidth connections.")
}

System_Ext(core_telehealth, "Core Telehealth Service", "Core Telehealth microservice")
System_Ext(external_systems, "External Systems", "Regional e-prescription gateways and pharmacy networks")

Rel(routing_controller, validator, "Passes ingress traffic for validation", "Internal gRPC")
Rel(validator, core_telehealth, "Forwards sanitized requests via service mesh", "gRPC over Istio mTLS")
Rel(routing_controller, external_systems, "Connects to regional e-prescription gateways and pharmacy networks", "HTTPS/REST")

@enduml