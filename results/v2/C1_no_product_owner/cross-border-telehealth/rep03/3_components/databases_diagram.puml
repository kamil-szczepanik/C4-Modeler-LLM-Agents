@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Databases container

Container_Boundary(databases, "Databases") {
    Component(EU Patient Database, "EU Patient Database", "Cloud SQL PostgreSQL - EU", "Regional structured data storage for EU patients ensuring GDPR data residency.")
    Component(US Patient Database, "US Patient Database", "Cloud SQL PostgreSQL - US", "Regional structured data storage for US patients ensuring HIPAA data residency.")
    Component(AI Audit Log Store, "AI Audit Log Store", "Cloud Storage - Audit", "Immutable bucket with Bucket Lock in compliance mode for MDR traceability.")
}

Rel(Core Telehealth Service, EU Patient Database, "PostgreSQL Wire Protocol / TLS 1.3")
Rel(Core Telehealth Service, US Patient Database, "PostgreSQL Wire Protocol / TLS 1.3")
Rel(AI Symptom Checker Container, AI Audit Log Store, "Cloud Storage API / HTTPS")
Rel(Shared Migration & Schema Manager, EU Patient Database, "PostgreSQL Wire Protocol / TLS 1.3")
Rel(Shared Migration & Schema Manager, US Patient Database, "PostgreSQL Wire Protocol / TLS 1.3")
@enduml