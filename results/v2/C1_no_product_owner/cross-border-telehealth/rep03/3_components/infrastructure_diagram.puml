@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Infrastructure container

Container_Boundary(infrastructure, "Infrastructure") {
    Component(Regional_GKE_Clusters, "Regional GKE Clusters", "Google Kubernetes Engine (europe-west3, us-central1)", "Orchestrates containerized workloads across regional boundaries.")
    Component(Istio_Service_Mesh, "Istio Service Mesh", "Istio (Ingress and Egress Gateways)", "Manages zero-trust service mesh networking, mTLS, and cross-border traffic governance.")
    Component(Google_Cloud_VPC_Service_Controls, "Google Cloud VPC Service Controls", "GCP VPC Service Controls", "Establishes hard network perimeters to prevent cross-region data exfiltration.")
    Component(External_Secrets_Operator, "External Secrets Operator", "External Secrets Operator & GCP Secret Manager", "Manages external secrets integration securely within the cluster.")
    Component(ArgoCD, "ArgoCD", "ArgoCD (Regional GitOps instances)", "Handles regional GitOps deployments and continuous delivery.")
    Component(Observability_Suite, "Observability Suite", "Prometheus & Google Cloud Operations Suite", "Provides monitoring, logging, and metrics collection.")
    Component(Cloud_KMS, "Cloud KMS", "Cloud KMS (Customer-Managed Encryption Keys)", "Provides region-isolated Customer-Managed Encryption Keys (CMEK) for data-at-rest.")
    Component(Cert_Manager, "Cert-Manager", "cert-manager & Private CA", "Automates short-lived X.509 certificate management for mesh security.")
    Component(GKE_Workload_Identity, "GKE Workload Identity", "GKE Workload Identity", "Manages secure IAM identities for Kubernetes workloads.")
    Component(Falco, "Falco", "Falco Runtime Security", "Delivers real-time kernel-level runtime threat detection within Kubernetes.")
}

System_Ext(api_gateway, "API Gateway", "External API Gateway")
System_Ext(external_consent_validator, "External Consent Validator", "External Consent Service")

Rel(api_gateway, Istio_Service_Mesh, "Routes external client traffic into regional GKE clusters", "HTTPS/REST/gRPC")
Rel(Istio_Service_Mesh, Regional_GKE_Clusters, "Secures internal container-to-container communication", "mTLS/gRPC")
Rel(Regional_GKE_Clusters, Cloud_KMS, "Performs region-locked cryptographic operations for data-at-rest encryption (BYOK) via VPC-SC", "Internal GCP APIs")
Rel(Istio_Service_Mesh, external_consent_validator, "Inspects and authorizes cross-region (EU-US) payloads using patient consent tokens", "mTLS/gRPC")

@enduml