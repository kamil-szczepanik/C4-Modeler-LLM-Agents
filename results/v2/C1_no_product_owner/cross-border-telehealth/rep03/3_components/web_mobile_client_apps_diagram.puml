@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(web_mobile_client_apps, "Web & Mobile Client Apps") {
    Component(ui_layer, "UI Layer", "Flutter / React Native", "Provides cross-platform UI consistency and native-like performance for patients and clinicians.")
    Component(local_state_storage_manager, "Local State & Storage Manager", "SQLite/Hive with AES-256 / iOS Keychain / Android Keystore", "Secures offline data cache and credentials for GDPR/HIPAA compliance.")
    Component(video_client_sdk_wrapper, "Video Client SDK Wrapper", "WebRTC (Adaptive Bitrate)", "Enables degraded-mode video streaming below 300 kbit/s for unstable rural connections.")
    Component(api_sync_client, "API & Sync Client", "HTTPS (TLS 1.3) with Certificate Pinning", "Handles secure communication and synchronization with the regional API gateway.")
    Component(region_aware_routing_localization_module, "Region-Aware Routing & Localization Module", "Localization Module", "Ensures compliance with regional data constraints and localization requirements across the EU and US.")
    Component(client_side_feature_flagging_kill_switch_sdk, "Client-Side Feature Flagging / Kill Switch SDK", "Cryptographically Signed Feature Flags", "Ensures secure, remote kill-switch capabilities for regulatory compliance.")
}

Rel(ui_layer, local_state_storage_manager, "Reads and writes encrypted local state and offline data")
Rel(ui_layer, video_client_sdk_wrapper, "Initiates and manages video consultations")
Rel(ui_layer, api_sync_client, "Requests data and synchronizes state")
Rel(api_sync_client, region_aware_routing_localization_module, "Routes requests based on region")
Rel(client_side_feature_flagging_kill_switch_sdk, ui_layer, "Enables or disables features dynamically")

@enduml