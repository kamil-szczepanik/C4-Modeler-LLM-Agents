@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "Patients interacting via Mobile/Web clients to receive video consultations, e-prescriptions, and use the AI symptom checker.")
Person(Clinicians, "Clinicians", "Clinicians interacting via Mobile/Web clients to provide secure video consultations and manage patient care.")

System_Ext(EU_National_e_Prescription_Gateways, "EU National e-Prescription Gateways", "External national gateways for e-prescriptions in the EU.")
System_Ext(US_Pharmacy_Networks, "US Pharmacy Networks", "External pharmacy networks in the US.")
System_Ext(Regional_Identity_Providers_IdPs, "Regional Identity Providers (IdPs)", "External regional identity providers for authentication.")

System_Boundary(platform_boundary, "Cross-Border Telehealth Platform") {
    System(EU_Telehealth_System, "EU Telehealth System", "Container deployment in GCP europe-west3 ensuring regional data isolation.")
    System(US_Telehealth_System, "US Telehealth System", "Container deployment in GCP us-central1 ensuring regional data isolation.")
}

Rel(Patients, EU_Telehealth_System, "Accesses data management and video consultations", "HTTPS (REST/GraphQL), WebRTC")
Rel(Patients, US_Telehealth_System, "Accesses data management and video consultations", "HTTPS (REST/GraphQL), WebRTC")
Rel(Clinicians, EU_Telehealth_System, "Accesses data management and video consultations", "HTTPS (REST/GraphQL), WebRTC")
Rel(Clinicians, US_Telehealth_System, "Accesses data management and video consultations", "HTTPS (REST/GraphQL), WebRTC")

Rel(EU_Telehealth_System, EU_National_e_Prescription_Gateways, "Exchanges e-prescriptions using national standards", "Secure mTLS APIs")
Rel(US_Telehealth_System, US_Pharmacy_Networks, "Exchanges e-prescriptions using HL7 FHIR", "Secure mTLS APIs")

Rel(EU_Telehealth_System, Regional_Identity_Providers_IdPs, "Authenticates users", "HTTPS")
Rel(US_Telehealth_System, Regional_Identity_Providers_IdPs, "Authenticates users", "HTTPS")

Rel(EU_Telehealth_System, US_Telehealth_System, "Asynchronous, cryptographically signed consent-based API handshakes for data portability", "HTTPS / APIs")
@enduml