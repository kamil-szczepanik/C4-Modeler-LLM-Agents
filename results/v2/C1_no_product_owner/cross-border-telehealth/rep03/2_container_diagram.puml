@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "Patients interacting via Mobile/Web clients to receive video consultations, e-prescriptions, and use the AI symptom checker.")
Person(Clinicians, "Clinicians", "Clinicians interacting via Mobile/Web clients to provide secure video consultations and manage patient care.")

System_Ext(EU_National_e_Prescription_Gateways, "EU National e-Prescription Gateways", "External national gateways for e-prescriptions in the EU.")
System_Ext(US_Pharmacy_Networks, "US Pharmacy Networks", "External pharmacy networks in the US.")
System_Ext(Regional_Identity_Providers_IdPs, "Regional Identity Providers (IdPs)", "External regional identity providers for authentication.")

Container(Web_Mobile_Client_Apps, "Web & Mobile Client Apps", "Flutter / React Native", "Client applications for patients and clinicians to access video consultations, e-prescriptions, and AI symptom checking.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(API_Gateway, "API Gateway", "Google Cloud API Gateway / Envoy", "Manages incoming client traffic, routing, and security enforcement.")
    Container(Core_Telehealth_Service, "Core Telehealth Service", "Go / gRPC & REST", "Handles core telehealth business logic, orchestration, and service coordination.")
    Container(Video_Consultation_Service, "Video Consultation Service", "Mediasoup SFU on GCE", "Handles real-time adaptive WebRTC video streaming for consultations.")
    Container(AI_Symptom_Checker_Container, "AI Symptom Checker Container", "Python / FastAPI + PyTorch", "Provides AI-driven symptom analysis for patients.")
    Container(Integration_Service, "Integration Service", "Java / Spring Boot", "Integrates with external EU gateways and US pharmacy networks.")
    ContainerDb(Databases, "Databases", "Cloud SQL PostgreSQL & Cloud Storage", "Persists regional data securely with CMEK encryption.")
    Container(Message_Broker, "Message Broker", "Google Cloud Pub/Sub", "Facilitates asynchronous messaging and resilience for e-prescriptions and regional data flows.")
    Container(Infrastructure, "Infrastructure", "Google Kubernetes Engine (GKE) & Istio Service Mesh", "Orchestrates zero-downtime containers and zero-trust mTLS networking.")
}

Rel(Patients, Web_Mobile_Client_Apps, "Interacts with the platform for consultations and symptom checking", "HTTPS (TLS 1.3) and WebRTC")
Rel(Clinicians, Web_Mobile_Client_Apps, "Interacts with the platform to provide care and consultations", "HTTPS (TLS 1.3) and WebRTC")
Rel(Web_Mobile_Client_Apps, API_Gateway, "Sends client requests and streams video", "HTTPS and WebRTC")
Rel(API_Gateway, Core_Telehealth_Service, "Routes API requests", "gRPC over mTLS (Istio service mesh)")
Rel(Core_Telehealth_Service, Video_Consultation_Service, "Initiates and manages video sessions", "WebRTC / gRPC")
Rel(Core_Telehealth_Service, AI_Symptom_Checker_Container, "Sends symptom data for AI analysis", "Internal gRPC")
Rel(Core_Telehealth_Service, Message_Broker, "Publishes asynchronous events and e-prescription messages", "Google Cloud Pub/Sub")
Rel(Core_Telehealth_Service, Databases, "Reads and writes encrypted patient data", "PostgreSQL protocol / Cloud Storage API")
Rel(Message_Broker, Integration_Service, "Consumes asynchronous messages for external integration", "Google Cloud Pub/Sub")
Rel(Integration_Service, EU_National_e_Prescription_Gateways, "Exchanges e-prescriptions", "REST/SOAP over mTLS")
Rel(Integration_Service, US_Pharmacy_Networks, "Exchanges e-prescriptions", "REST/SOAP over mTLS")
Rel(Web_Mobile_Client_Apps, Regional_Identity_Providers_IdPs, "Authenticates users", "HTTPS")

@enduml