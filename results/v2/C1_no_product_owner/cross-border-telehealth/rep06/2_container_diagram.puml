@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients_EU_US, "Patients (EU/US)", "Patients from the EU and US using mobile and web clients for video consultations and symptom checking.")
Person(Clinicians, "Clinicians", "Medical professionals conducting consultations and issuing e-prescriptions.")

System_Ext(EU_National_E_Prescription_Gateways, "EU National E-Prescription Gateways", "External EU gateways for managing e-prescriptions.")
System_Ext(US_Pharmacy_Systems, "US Pharmacy Systems", "External US systems for processing prescriptions and pharmacy workflows.")
System_Ext(National_Health_Registries, "National Health Registries", "External health registries for patient and medical record verification.")
System_Ext(External_Identity_Providers, "External Identity Providers", "Identity providers such as Login.gov and eIDAS for secure authentication.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(React_Web_Application, "React Web Application", "React", "Web client application for patients and clinicians.")
    Container(React_Native_Mobile_App, "React Native Mobile App", "React Native", "Mobile client application for patients and clinicians.")
    Container(GCP_Cloud_Endpoints_Envoy_API_Gateway, "GCP Cloud Endpoints / Envoy API Gateway", "GCP Cloud Endpoints / Envoy", "Entry point managing API routing, security, and traffic control.")
    Container(Core_Services_Container, "Core Services Container", "Node.js / NestJS", "Handles core business logic, consultations, and e-prescriptions.")
    Container(AI_Symptom_Checker_Container, "AI Symptom Checker Container", "Python / FastAPI", "Performs AI inference for symptom checking.")
    Container(Video_Media_Server, "Video Media Server", "LiveKit / WebRTC SFU", "Handles low-bandwidth real-time video consultations.")
    ContainerDb(Cloud_SQL_PostgreSQL_with_PgBouncer, "Cloud SQL (PostgreSQL with PgBouncer)", "PostgreSQL, PgBouncer, FHIR/national schemas", "Transactional database for storing patient and clinical data.")
    ContainerDb(BigQuery, "BigQuery", "GCP BigQuery", "Stores immutable, pseudonymized audit logs.")
}

Rel(Patients_EU_US, React_Web_Application, "Accesses telehealth platform features", "HTTPS (JSON/REST) and WSS (WebSockets/QUIC)")
Rel(Patients_EU_US, React_Native_Mobile_App, "Accesses telehealth platform features", "HTTPS (JSON/REST) and WSS (WebSockets/QUIC)")
Rel(Clinicians, React_Web_Application, "Conducts consultations and manages prescriptions", "HTTPS (JSON/REST) and WSS (WebSockets/QUIC)")
Rel(React_Web_Application, GCP_Cloud_Endpoints_Envoy_API_Gateway, "Sends metadata, consent, and media requests", "HTTPS (JSON/REST) and WSS (WebSockets/QUIC)")
Rel(React_Native_Mobile_App, GCP_Cloud_Endpoints_Envoy_API_Gateway, "Sends metadata, consent, and media requests", "HTTPS (JSON/REST) and WSS (WebSockets/QUIC)")
Rel(GCP_Cloud_Endpoints_Envoy_API_Gateway, Core_Services_Container, "Routes metadata and business logic requests", "gRPC over mTLS (Anthos Service Mesh)")
Rel(GCP_Cloud_Endpoints_Envoy_API_Gateway, AI_Symptom_Checker_Container, "Routes AI symptom check requests", "gRPC over mTLS (Anthos Service Mesh)")
Rel(GCP_Cloud_Endpoints_Envoy_API_Gateway, Video_Media_Server, "Routes video and media stream connections", "WebRTC / WSS")
Rel(Core_Services_Container, Cloud_SQL_PostgreSQL_with_PgBouncer, "Reads and writes transactional data", "SSL/TLS-encrypted PostgreSQL connections")
Rel(AI_Symptom_Checker_Container, BigQuery, "Emits pseudonymized audit payloads", "HTTPS / GCP BigQuery API")
Rel(Core_Services_Container, EU_National_E_Prescription_Gateways, "Transmits and processes e-prescriptions", "HTTPS/REST and HL7 FHIR with mTLS")
Rel(Core_Services_Container, US_Pharmacy_Systems, "Transmits and processes e-prescriptions", "HTTPS/REST and HL7 FHIR with mTLS")
Rel(Core_Services_Container, National_Health_Registries, "Queries health registries", "HTTPS/REST and HL7 FHIR with mTLS")
Rel(Core_Services_Container, External_Identity_Providers, "Federates user authentication", "OAuth 2.0 / OIDC")

@enduml