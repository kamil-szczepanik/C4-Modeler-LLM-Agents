@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_EU_US, "Patients (EU/US)", "Patients from the EU and US using mobile and web clients for video consultations and symptom checking.")
Person(Clinicians, "Clinicians", "Medical professionals conducting consultations and issuing e-prescriptions.")
System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "A cross-border telehealth platform providing video consultations, e-prescriptions, and an AI symptom checker for EU and US patients with strict regional data residency, GDPR/HIPAA compliance, and medical device traceability.")
System_Ext(EU_National_E_Prescription_Gateways, "EU National E-Prescription Gateways", "External EU gateways for managing e-prescriptions.")
System_Ext(US_Pharmacy_Systems, "US Pharmacy Systems", "External US systems for processing prescriptions and pharmacy workflows.")
System_Ext(National_Health_Registries, "National Health Registries", "External health registries for patient and medical record verification.")
System_Ext(External_Identity_Providers, "External Identity Providers", "Identity providers such as Login.gov and eIDAS for secure authentication.")

Rel(Patients_EU_US, Cross_Border_Telehealth_Platform, "Accesses video consultations, e-prescriptions, and AI symptom checker", "HTTPS (TLS 1.3) and WebRTC")
Rel(Clinicians, Cross_Border_Telehealth_Platform, "Conducts video consultations and issues e-prescriptions", "HTTPS (TLS 1.3) and WebRTC")
Rel(Cross_Border_Telehealth_Platform, EU_National_E_Prescription_Gateways, "Transmits and processes e-prescriptions", "HTTPS/REST and HL7 FHIR with mTLS")
Rel(Cross_Border_Telehealth_Platform, US_Pharmacy_Systems, "Transmits and processes e-prescriptions", "HTTPS/REST and HL7 FHIR with mTLS")
Rel(Cross_Border_Telehealth_Platform, National_Health_Registries, "Queries health registries", "HTTPS/REST and HL7 FHIR with mTLS")
Rel(Cross_Border_Telehealth_Platform, External_Identity_Providers, "Federates user authentication", "OAuth 2.0 / OIDC")

@enduml