@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Cloud SQL (PostgreSQL with PgBouncer) container

Container_Boundary(cloud_sql, "Cloud SQL (PostgreSQL with PgBouncer)") {
    Component(PgBouncer, "PgBouncer", "Connection Pooler", "Manages high-concurrency Node.js connections using transaction pooling.")
    Component(PostgreSQL_Database_Engine, "PostgreSQL Database Engine", "Google Cloud SQL for PostgreSQL 15+", "Core transactional RDBMS ensuring strict ACID guarantees and region isolation.")
    Component(Audit___Traceability_Subsystem, "Audit & Traceability Subsystem", "PostgreSQL native audit extensions (pgaudit)", "Satisfies HIPAA audit logging and EU MDR traceability.")
    Component(Regional_Schema_Partition_Manager, "Regional Schema Partition Manager", "PostgreSQL Schemas & RLS", "Enforces context-aware queries and region isolation via Row-Level Security.")
}

Rel(PgBouncer, PostgreSQL_Database_Engine, "Relays pooled queries", "TCP / Unix Domain Sockets")
Rel(Regional_Schema_Partition_Manager, PostgreSQL_Database_Engine, "Executes partitioned and isolation-enforced data operations", "")
Rel(Audit___Traceability_Subsystem, PostgreSQL_Database_Engine, "Captures audit logs and traceability data from database operations", "")

@enduml