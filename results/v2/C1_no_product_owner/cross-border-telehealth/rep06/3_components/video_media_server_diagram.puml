@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Video Media Server container

Person(ReactAppMobileApp, "React App / Mobile App", "Clients for video consultations")
System_Ext(GCPCloudStorage, "GCP Cloud Storage", "Encrypted recording streams [HTTPS / CMEK]")

Container_Boundary(VideoMediaServer, "Video Media Server") {
    Component(SFURouter, "SFU Router", "LiveKit Core / Go", "Core WebRTC SFU for real-time media routing and encrypted recording streams.")
    Component(ABRController, "ABR Controller", "Custom Go module", "Performs quality adjustments for media streams.")
    Component(MediaSignalingHandler, "Media Signaling Handler", "Node.js / LiveKit SDK", "Handles signaling, authentication, token validation, and session tickets.")
}

Rel(ReactAppMobileApp, MediaSignalingHandler, "Session negotiation", "WSS / TLS 1.3")
Rel(ReactAppMobileApp, SFURouter, "Media streaming", "WebRTC / DTLS-SRTP")
Rel(ABRController, SFURouter, "Quality adjustments", "Internal gRPC")
Rel(MediaSignalingHandler, SFURouter, "Token validation & session tickets", "In-memory")
Rel(SFURouter, GCPCloudStorage, "Encrypted recording streams", "HTTPS / CMEK")
@enduml