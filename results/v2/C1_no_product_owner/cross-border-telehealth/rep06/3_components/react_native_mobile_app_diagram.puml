@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the React Native Mobile App container

System_Ext(gateway, "GCP Cloud Endpoints / Envoy API Gateway", "API Gateway for backend services")
System_Ext(livekit, "Video Media Server (LiveKit SFU)", "SFU Media Server for video streaming")

Container_Boundary(mobile_app, "React Native Mobile App") {
    Component(ui_layer, "UI Layer", "React Navigation & Native UI", "Cross-platform client UI for patients and clinicians.")
    Component(state_engine, "State & Offline Sync Engine", "WatermelonDB / Redux Toolkit", "Manages offline data caching and synchronization over unstable connections.")
    Component(video_module, "Video Module", "LiveKit React Native Client", "Handles low-bandwidth WebRTC video streaming for consultations.")
    Component(secure_storage, "Secure Storage", "react-native-encrypted-storage", "Provides secure local client-side encryption of health tokens.")
    Component(biometric_auth, "Local Biometric & Auth Module", "react-native-biometrics", "Manages local biometric authentication and security.")
    Component(telemetry_agent, "Telemetry & Diagnostics Agent", "Sentry RN / OpenTelemetry", "Tracks edge-anonymized crash and WebRTC telemetry.")
    Component(rasp_module, "Anti-Tampering & RASP Module", "react-native-jailbreak-detection", "Ensures security against device tampering and jailbreaking.")
}

Rel(ui_layer, state_engine, "In-App Events")
Rel(ui_layer, biometric_auth, "In-App Events")
Rel(state_engine, gateway, "HTTPS (JSON/REST) and WSS (WebSockets/QUIC)")
Rel(video_module, livekit, "WebRTC/QUIC")
Rel(telemetry_agent, gateway, "HTTPS - Anonymized Telemetry")

@enduml