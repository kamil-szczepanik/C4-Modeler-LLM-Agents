@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the BigQuery container

Container_Boundary(BigQuery, "BigQuery") {
    Component(Log_Ingestion_Service, "Log Ingestion Service", "GCP BigQuery & BigQuery Storage Write API", "Streams audit trails via gRPC / BigQuery Storage Write API.")
    Component(Compliance_Analytics_View_Layer, "Compliance Analytics View Layer", "BigQuery SQL Views", "Provides query access to audit data for compliance users.")
    Component(Partition_Retention_Manager, "Partition & Retention Manager", "BigQuery Internal Storage Engine", "Manages automated partitioning, data retention, and streaming writes into regional datasets.")
}

Rel(Log_Ingestion_Service, Partition_Retention_Manager, "Writes streaming data", "")
Rel(Compliance_Analytics_View_Layer, Log_Ingestion_Service, "Queries audit data", "")

@enduml