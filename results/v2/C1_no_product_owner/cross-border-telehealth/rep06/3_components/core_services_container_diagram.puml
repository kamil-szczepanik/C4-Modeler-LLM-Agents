@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "GCP Cloud Endpoints / Envoy API Gateway", "External API Gateway")
System_Ext(secret_manager, "GCP Secret Manager", "GCP Secret Manager and Cloud KMS")

Container_Boundary(core_services_container, "Core Services Container") {
    Component(consultation_management, "Consultation Management Component", "TypeScript/NestJS Module", "Handles consultations for the Cross-Border Telehealth Platform.")
    Component(e_prescription, "E-Prescription Routing Component", "TypeScript/NestJS Module", "Handles e-prescriptions and regulatory compliance.")
    Component(consent_enforcement, "Consent Enforcement Component", "TypeScript/NestJS Module", "Enforces strict regional data isolation and consent controls required for GDPR and HIPAA compliance.")
    Component(audit_logging, "Audit Logging Component", "TypeScript/NestJS Module", "Handles asynchronous eventing, cryptographic audit logging, and zero log loss.")
    
    Component(infra_gcp, "GCP Cloud Run / Google Kubernetes Engine", "GCP", "Cloud infrastructure hosting the container.")
    Component(db_sql, "GCP Cloud SQL (PostgreSQL with PgBouncer)", "GCP Cloud SQL", "Relational database storage for persistent data.")
    Component(db_bigquery, "GCP BigQuery", "GCP BigQuery", "Data warehouse for audit logs and analytics.")
    Component(gcp_kms, "GCP Secret Manager and Cloud KMS", "GCP Secret Manager / KMS", "Runtime secret injection and application-layer envelope encryption for PHI.")
}

Rel(api_gateway, consent_enforcement, "gRPC over mTLS via Anthos Service Mesh")
Rel(consent_enforcement, db_sql, "SSL/TLS-encrypted PostgreSQL connections")
Rel(audit_logging, db_bigquery, "Asynchronous event stream with cryptographic signing")
Rel(core_services_container, secret_manager, "Runtime secret retrieval via IAM")

@enduml