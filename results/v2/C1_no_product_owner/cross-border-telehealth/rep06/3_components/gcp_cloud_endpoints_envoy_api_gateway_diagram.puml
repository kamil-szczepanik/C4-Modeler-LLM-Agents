@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Clients, "Clients", "External clients sending HTTPS and WSS requests")
System_Ext(CoreServicesContainer, "Core Services Container", "Handles core internal business logic")
System_Ext(AISymptomCheckerContainer, "AI Symptom Checker Container", "Processes AI symptom checks")

Container_Boundary(GCP_Cloud_Endpoints___Envoy_API_Gateway, "GCP Cloud Endpoints / Envoy API Gateway") {
    Component(Envoy_Proxy_Core, "Envoy Proxy Core", "Envoy / GCP Cloud Endpoints", "Handles edge API routing, security, and traffic control for HTTPS and WSS protocols.")
    Component(JWT_Auth_Validation_Filter, "JWT/Auth Validation Filter", "Envoy Filter / Auth Plugin", "Validates JSON Web Tokens and enforces authentication before request processing.")
    Component(Region_Routing_Module, "Region Routing Module", "Envoy Routing Module / Anthos Service Mesh", "Routes internal logic and AI checks to regional containers using gRPC over mTLS.")
    Component(Rate_Limiting___Throttling_Module, "Rate Limiting & Throttling Module", "Redis (Memorystore)", "Executes token bucket rate limiting to handle unstable rural connections.")
    Component(Telemetry___Audit_Interceptor, "Telemetry & Audit Interceptor", "OpenTelemetry & Fluent Bit", "Emits regional distributed tracing and immutable audit events without cross-border leaks.")
}

Rel(Clients, Envoy_Proxy_Core, "Sends requests", "HTTPS (JSON/REST) and WSS (WebSockets/QUIC)")
Rel(Envoy_Proxy_Core, Rate_Limiting___Throttling_Module, "Checks limits", "Local gRPC")
Rel(JWT_Auth_Validation_Filter, Telemetry___Audit_Interceptor, "Emits audit events", "Internal channel")
Rel(Region_Routing_Module, CoreServicesContainer, "Routes internal logic", "gRPC over mTLS via Anthos Service Mesh")
Rel(Region_Routing_Module, AISymptomCheckerContainer, "Routes AI checks", "gRPC over mTLS via Anthos Service Mesh")
@enduml