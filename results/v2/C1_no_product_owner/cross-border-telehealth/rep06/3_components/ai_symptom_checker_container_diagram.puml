@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Symptom Checker Container container

Container_Boundary(ai_symptom_checker_container, "AI Symptom Checker Container") {
    Component(API_Router, "API Router", "FastAPI / Pydantic", "Handles API endpoints, input validation, and schema sanitization.")
    Component(Model_Orchestrator, "Model Orchestrator", "Python", "Region-aware orchestrator managing model execution and data routing.")
    Component(Clinical_Rules_Engine, "Clinical Rules Engine", "Python / Pydantic", "Executes deterministic clinical validation rules.")
    Component(Traceability_Logger, "Traceability Logger", "Python", "Asynchronously emits audit events.")
    Component(GCP_Cloud_Storage, "GCP Cloud Storage", "GCP Cloud Storage", "Stores immutable, version-tagged model weights with cryptographic verification.")
    Component(GCP_BigQuery, "GCP BigQuery", "GCP BigQuery", "Securely stores pseudonymized, timestamped audit payloads for EU MDR traceability.")
}

Rel(API_Router, Model_Orchestrator, "Direct function calls", "")
Rel(Model_Orchestrator, Clinical_Rules_Engine, "In-memory data passing", "In-memory")
Rel(Clinical_Rules_Engine, API_Router, "In-memory data passing", "In-memory")
Rel(Model_Orchestrator, Traceability_Logger, "Asynchronous audit event emission", "In-memory / Async Queue")
Rel(Traceability_Logger, GCP_BigQuery, "Audit log export", "HTTPS / GCP BigQuery API")
Rel(Model_Orchestrator, GCP_Cloud_Storage, "Model weight retrieval with SHA-256 verification", "HTTPS")

@enduml