@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the React Web Application container

Person(Patients_and_Clinicians, "Patients and Clinicians", "Accesses the telehealth platform via HTTPS and WSS.")

System_Boundary(React_Web_Application, "React Web Application") {
    Component(Routing___State_Management, "Routing & State Management", "React Router / Redux Toolkit", "Manages routing, ephemeral session state in volatile memory, and delegates authorization checks.")
    Component(Authentication___Consent_Module, "Authentication & Consent Module", "OIDC/OAuth2 Client", "Handles authentication and consent management.")
    Component(Telehealth_Interface_Component, "Telehealth Interface Component", "WebRTC / LiveKit SDK", "Powers adaptive-bitrate video consultations for low-bandwidth connections.")
    Component(AI_Symptom_Checker_UI_Component, "AI Symptom Checker UI Component", "React / Tailwind", "Provides the user interface for AI symptom checks.")
    Component(API_Client___Localization_Layer, "API Client & Localization Layer", "Axios / i18next", "Routes all network traffic with injected regional context and handles localization.")
}

Container(GCP_Cloud_Endpoints___Envoy_API_Gateway, "GCP Cloud Endpoints / Envoy API Gateway", "GCP Cloud Endpoints / Envoy", "Gateway that receives metadata, consent, and WSS signaling via HTTPS/WSS.")
Container(GCP_Cloud_CDN___Regional_GCP_Buckets, "GCP Cloud CDN / Regional GCP Buckets", "GCP Cloud CDN / Google Cloud Storage", "Enforces regional asset isolation for data residency in europe-west3 and us-central1.")

Rel(Patients_and_Clinicians, Routing___State_Management, "Accesses telehealth platform", "HTTPS (JSON/REST) and WSS (WebSockets/QUIC)")
Rel(Routing___State_Management, Authentication___Consent_Module, "Delegates authorization checks", "Function Call")
Rel(Telehealth_Interface_Component, API_Client___Localization_Layer, "Routes all network traffic with injected regional context", "HTTPS")
Rel(AI_Symptom_Checker_UI_Component, API_Client___Localization_Layer, "Routes all network traffic with injected regional context", "HTTPS")
Rel(API_Client___Localization_Layer, GCP_Cloud_Endpoints___Envoy_API_Gateway, "Transmits metadata, consent, and WSS signaling", "HTTPS/WSS with TLS 1.3")

@enduml