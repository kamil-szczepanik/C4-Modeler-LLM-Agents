@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the US Healthcare Interoperability Service container

Container_Boundary(us_healthcare_interoperability_service, "US Healthcare Interoperability Service") {
    Component(fhir_api_router, "FHIR API Router", "Node.js / Express", "Routes incoming US healthcare interoperability requests.")
    Component(us_transformation_engine, "US Transformation Engine", "Node.js / Smart-on-FHIR SDK", "Transforms and handles US health interoperability logic using Smart-on-FHIR.")
    Component(hipaa_audit_compliance_logger, "HIPAA Audit & Compliance Logger", "Node.js", "Intercepts payloads for compliance logging to satisfy HIPAA regulations.")
    Component(us_e_prescription_dispatcher, "US E-Prescription Dispatcher", "Node.js / Axios", "Passes validated FHIR e-prescription bundles and dispatches them to external US pharmacies/EHRs.")
}

Rel(fhir_api_router, us_transformation_engine, "Internal method calls", "TypeScript")
Rel(us_transformation_engine, hipaa_audit_compliance_logger, "Intercepts payload for compliance logging", "Async/Await")
Rel(us_transformation_engine, us_e_prescription_dispatcher, "Passes validated FHIR e-prescription bundles", "Internal Event/Queue")

@enduml