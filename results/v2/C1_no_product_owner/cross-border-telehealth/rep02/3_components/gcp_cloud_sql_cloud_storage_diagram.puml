@startuml
!include https://raw.githack.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the GCP Cloud SQL & Cloud Storage container

Person_Ext(core_telehealth_backend, "Core Telehealth Backend", "Part of the application system")
Person_Ext(ai_symptom_checker_service, "AI Symptom Checker Service", "Part of the application system")
Person_Ext(interoperability_adapters, "Interoperability Adapters", "Part of the application system")

Container_Boundary(gcp_cloud_sql_cloud_storage, "GCP Cloud SQL & Cloud Storage") {
    Component(Regional_Cloud_SQL_Instances, "Regional Cloud SQL Instances", "PostgreSQL 15 with Row-Level Security", "Provides regional transactional persistence with Row-Level Security for multi-tenant data isolation.")
    Component(Regional_Cloud_Storage_WORM_Buckets, "Regional Cloud Storage WORM Buckets", "GCP Cloud Storage with COMPLIANCE mode bucket locks", "Stores immutable decision traces and audit logs with object versioning and strict regulatory audit trails.")
}

Rel(core_telehealth_backend, Regional_Cloud_SQL_Instances, "Read/write transactional data and logs", "TCP/PostgreSQL, TLS 1.3, IAM Auth")
Rel(ai_symptom_checker_service, Regional_Cloud_SQL_Instances, "Read/write transactional data and logs", "TCP/PostgreSQL, TLS 1.3, IAM Auth")
Rel(interoperability_adapters, Regional_Cloud_SQL_Instances, "Read/write transactional data and logs", "TCP/PostgreSQL, TLS 1.3, IAM Auth")
Rel(ai_symptom_checker_service, Regional_Cloud_Storage_WORM_Buckets, "Writes immutable decision traces and audit logs", "HTTPS/REST, CMEK")

@enduml