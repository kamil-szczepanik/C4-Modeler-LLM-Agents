@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web App & Mobile App container

Container_Boundary(web_mobile_app, "Web App & Mobile App") {
    Component(Client_UI_Layer, "Client UI Layer", "Flutter / React", "Provides cross-platform mobile and web interfaces for patients and clinicians.")
    Component(Offline_State_Manager, "Offline State Manager", "Local Storage Engine", "Manages local caching of data for offline availability.")
    Component(Security_Cryptography_Module, "Security & Cryptography Module", "Platform Crypto API", "Handles encryption and decryption of cached data.")
    Component(Client_Telemetry, "Client Telemetry", "Telemetry Logger", "Collects and batches client-side telemetry logs.")
}

System_Ext(GCP_API_Gateway, "GCP API Gateway", "API Gateway for routing client requests.")

Rel(Client_UI_Layer, Security_Cryptography_Module, "Requests data encryption/decryption")
Rel(Offline_State_Manager, Security_Cryptography_Module, "Encrypts/decrypts cached data", "Platform Crypto API")
Rel(Client_Telemetry, GCP_API_Gateway, "Flushes batched telemetry logs", "HTTPS")

@enduml