@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Telehealth Backend container

System_Ext(api_gateway, "GCP API Gateway", "External API Gateway")
System_Ext(ai_service, "AI Symptom Checker Service", "External AI service")
System_Ext(regional_gateways, "EU E-Prescriptions Adapter & US Interoperability Service", "External regional healthcare gateways")
System_Ext(db_storage, "GCP Cloud SQL & WORM Storage", "External database and storage")

Container_Boundary(core_telehealth_backend, "Core Telehealth Backend") {
    Component(consent_engine, "Consent & Policy Engine", "Go", "Handles ABAC/RBAC and regional tenant isolation.")
    Component(consultation_coordinator, "Consultation Coordinator", "Go", "Manages session states and workflows for consultations.")
    Component(resiliency_manager, "Resiliency & Fallback Manager", "Go, Protobuf", "Handles low-bandwidth modes and compact binary data serialization.")
    Component(audit_daemon, "Audit Logging Daemon", "Fluentbit, OTel sidecar container", "Performs tamper-resistant log shipping.")
}

Rel(api_gateway, core_telehealth_backend, "Routes validated client requests", "mTLS, Anthos Service Mesh (Istio)")
Rel(core_telehealth_backend, ai_service, "Sends analysis requests", "gRPC over mTLS")
Rel(core_telehealth_backend, regional_gateways, "Integrates with regional healthcare gateways", "gRPC over mTLS")
Rel(core_telehealth_backend, db_storage, "Persists transactional data and compliance logs", "CMEK encryption")

@enduml