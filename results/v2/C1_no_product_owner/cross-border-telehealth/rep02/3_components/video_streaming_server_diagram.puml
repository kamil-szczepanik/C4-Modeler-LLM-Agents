@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Video Streaming Server", "Video Streaming Server") {
    Component("SFU Core", "SFU Core", "WebRTC / Mediasoup SFU", "Handles media streams, routing, and distribution for video consultations.")
    Component("ABR Controller", "ABR Controller", "Internal API", "Performs bitrate throttling and downmixing based on network conditions.")
    Component("Signaling Handler", "Signaling Handler", "WebSocket / JSON", "Manages session setup and provisions credentials for media relay.")
    Component("TURN/STUN Relay Agent", "TURN/STUN Relay Agent", "Coturn / TURN over UDP/TCP", "Provides NAT traversal and relays media packets for rural patients with unstable connections.")
}

Rel("ABR Controller", "SFU Core", "Bitrate throttling and downmixing", "Internal API")
Rel("Signaling Handler", "TURN/STUN Relay Agent", "Provisions HMAC credentials", "REST API")

@enduml