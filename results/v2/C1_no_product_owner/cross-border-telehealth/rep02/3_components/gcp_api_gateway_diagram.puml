@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the GCP API Gateway container

Container_Boundary(GCP_API_Gateway, "GCP API Gateway") {
    Component(ESPv2_Gateway_Proxy, "ESPv2 Gateway Proxy", "Managed Google Cloud API Gateway / ESPv2", "Handles regional routing, protocol translation, schema validation, and ingress traffic management at regional edges (`europe-west3` and `us-central1`).")
    Component(Cloud_Armor_WAF, "Cloud Armor WAF", "Google Cloud Armor", "Provides Web Application Firewall (WAF) protection and threat mitigation at regional edges.")
}

Rel(ESPv2_Gateway_Proxy, Cloud_Armor_WAF, "Inspects incoming regional client traffic for threats", "")

@enduml