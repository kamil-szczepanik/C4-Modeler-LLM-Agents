@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the EU E-Prescriptions Adapter container

Component(Core_Telehealth_Backend, "Core Telehealth Backend", "Java / Spring Boot", "Submits canonical prescription DTOs.")
Component_Ext(National_e_Prescription_Gateways, "National e-Prescription Gateways", "Egress-filtered HTTPS / mTLS", "External national infrastructures processing electronic prescriptions.")
Component_Ext(GCP_Pub_Sub_Dead_Letter_Queue_DLQ, "GCP Pub/Sub Dead-Letter Queue (DLQ)", "GCP Pub/Sub / Cloud KMS", "Manages persistent asynchronous queuing for failed transmissions with Cloud KMS.")

Container_Boundary(EU_EPrescriptions_Adapter, "EU E-Prescriptions Adapter") {
    Component(Prescription_Transformation_Engine, "Prescription Transformation Engine", "Java / MapStruct", "Translates canonical prescription models to meet diverse national standards.")
    Component(Gateway_Resilience_ &_Routing_Module, "Gateway Resilience & Routing Module", "Spring Cloud OpenFeign / Resilience4j", "Handles dynamic routing and circuit breaking against unstable endpoints.")
    Component(Security_&_Cryptography_Interceptor, "Security & Cryptography Interceptor", "Spring Security / GCP Secret Manager", "Provides dynamic mTLS certificate injection and security enforcement.")
    Component(Audit_&_Compliance_Logger, "Audit & Compliance Logger", "Spring AOP / SLF4J", "Ensures strict GDPR compliance and regional data logging.")
}

Rel(Core_Telehealth_Backend, Prescription_Transformation_Engine, "Submits canonical prescription DTOs", "gRPC")
Rel(Prescription_Transformation_Engine, Gateway_Resilience_ &_Routing_Module, "Passes validated payloads", "In-memory")
Rel(Gateway_Resilience_ &_Routing_Module, National_e_Prescription_Gateways, "Dispatches prescriptions", "Egress-filtered HTTPS / mTLS")
Rel(Gateway_Resilience_ &_Routing_Module, GCP_Pub_Sub_Dead_Letter_Queue_DLQ, "Queues failed transmissions", "Encrypted Pub/Sub Protocol")
@enduml