@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_and_Licensed_Clinicians, "Patients and Licensed Clinicians", "External users who participate in video consultations, use the AI symptom checker, and manage e-prescriptions across the EU and US.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for patients across the EU and US while enforcing strict regional data residency and regulatory compliance.")

System_Ext(National_e_Prescription_Gateways_and_US_Pharmacies_EHRs, "National e-Prescription Gateways and US Pharmacies/EHRs", "External healthcare systems and networks used for fulfilling prescriptions and accessing electronic health records.")

System_Ext(Regional_Identity_Providers, "Regional Identity Providers", "eIDAS-compliant IdPs for the EU and OAuth/OIDC IdPs for the US handling user authentication.")

Rel(Patients_and_Licensed_Clinicians, Cross_Border_Telehealth_Platform, "Interact with regional GCP platforms via HTTPS and WebSockets for video consultations and symptom checking.", "HTTPS, WebSockets")
Rel(Cross_Border_Telehealth_Platform, National_e_Prescription_Gateways_and_US_Pharmacies_EHRs, "Communicate with prescription networks using secure REST and HL7 FHIR over TLS 1.3/mTLS.", "REST, HL7 FHIR, TLS 1.3, mTLS")
Rel(Cross_Border_Telehealth_Platform, Regional_Identity_Providers, "Authenticate users using regional identity providers (eIDAS, OAuth/OIDC).", "OAuth 2.0, OIDC, eIDAS")

@enduml