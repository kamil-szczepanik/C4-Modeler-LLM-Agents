@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(Patients_and_Licensed_Clinicians, "Patients and Licensed Clinicians", "External users who participate in video consultations, use the AI symptom checker, and manage e-prescriptions across the EU and US.")

System_Ext(National_e_Prescription_Gateways_and_US_Pharmacies_EHRs, "National e-Prescription Gateways and US Pharmacies/EHRs", "External healthcare systems and networks used for fulfilling prescriptions and accessing electronic health records.")

System_Ext(Regional_Identity_Providers, "Regional Identity Providers", "eIDAS-compliant IdPs for the EU and OAuth/OIDC IdPs for the US handling user authentication.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(Web_App_Mobile_App, "Web App & Mobile App", "Flutter / React", "Client applications providing user interfaces for video consultations, e-prescriptions, and the AI symptom checker.")
    Container(GCP_API_Gateway, "GCP API Gateway", "GCP API Gateway", "Edge routing and entry point for client traffic into the platform.")
    Container(Core_Telehealth_Backend, "Core Telehealth Backend", "Go / Spring Boot", "Core business logic, handling user consent validation and service coordination.")
    Container(AI_Symptom_Checker_Service, "AI Symptom Checker Service", "Python / FastAPI", "AI-powered service for checking patient symptoms.")
    Container(Video_Streaming_Server, "Video Streaming Server", "WebRTC / SFU (Mediasoup)", "Handles adaptive bitrate video streaming for consultations.")
    Container(EU_E_Prescriptions_Adapter, "EU E-Prescriptions Adapter", "Java / Spring Boot", "Integration adapter for national e-prescription gateways in the EU.")
    Container(US_Healthcare_Interoperability_Service, "US Healthcare Interoperability Service", "Node.js / FHIR SDK", "Integration service for US healthcare interoperability and HL7 FHIR endpoints.")
    ContainerDb(GCP_Cloud_SQL_Cloud_Storage, "GCP Cloud SQL & Cloud Storage", "PostgreSQL, WORM buckets, Cloud KMS, GCP Secret Manager", "Provides regional transactional persistence, encrypted storage, and secret management.")
}

Rel(Patients_and_Licensed_Clinicians, Web_App_Mobile_App, "Interact with the platform via client applications", "HTTPS, WebSockets")
Rel(Web_App_Mobile_App, GCP_API_Gateway, "Sends API requests and establishes real-time connections", "HTTPS, WebSockets")
Rel(Web_App_Mobile_App, Video_Streaming_Server, "Streams video consultations", "WebRTC")
Rel(GCP_API_Gateway, Core_Telehealth_Backend, "Routes validated requests to the core backend", "mTLS, Anthos Service Mesh (Istio)")
Rel(Core_Telehealth_Backend, AI_Symptom_Checker_Service, "Requests AI symptom analysis", "mTLS")
Rel(Core_Telehealth_Backend, EU_E_Prescriptions_Adapter, "Communicates for EU prescription processing", "mTLS")
Rel(Core_Telehealth_Backend, US_Healthcare_Interoperability_Service, "Communicates for US health interoperability", "mTLS")
Rel(EU_E_Prescriptions_Adapter, National_e_Prescription_Gateways_and_US_Pharmacies_EHRs, "Sends egress-filtered prescription requests to EU national gateways", "Egress-filtered HTTPS")
Rel(US_Healthcare_Interoperability_Service, National_e_Prescription_Gateways_and_US_Pharmacies_EHRs, "Sends egress-filtered HL7 FHIR requests to US endpoints", "Egress-filtered HTTPS, HL7 FHIR")
Rel(Core_Telehealth_Backend, GCP_Cloud_SQL_Cloud_Storage, "Persists transactional and compliance data with CMEK encryption", "PostgreSQL, Cloud KMS")

@enduml