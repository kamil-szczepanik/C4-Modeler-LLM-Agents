@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(PatientsEUUS, "Patients (EU/US)", "Patients located in the EU or US seeking video consultations, e-prescriptions, and AI symptom checking.")
Person(LicensedClinicians, "Licensed Clinicians", "Licensed medical professionals conducting video consultations and prescribing treatments.")

System_Ext(NationalePrescriptionGatewaysEUandPharmacySystemsUS, "National e-Prescription Gateways (EU) and Pharmacy Systems (US)", "External national gateways and pharmacy systems connected via HL7 FHIR.")
System_Ext(IdentityProvidersOAuth2OIDC, "Identity Providers (OAuth2/OIDC)", "External identity providers handling authentication with MFA.")

System_Boundary(CrossBorderTelehealthPlatform, "Cross-Border Telehealth Platform") {
    Container(APIGateway, "API Gateway", "Go, Envoy", "Handles external ingress, zero-trust mTLS service mesh routing, and OAuth2/OIDC authentication.")
    Container(ConsultationService, "Consultation Service", "Node.js, WebRTC", "Manages video consultations and coordinates with the SFU Media Relay.")
    Container(SFUMediaRelay, "SFU Media Relay", "Mediasoup, C++", "WebRTC SFU media relay for low-bandwidth video resilience (<300 kbit/s).")
    Container(ClinicalPrescriptionService, "Clinical & Prescription Service", "Java, Spring Boot", "Manages clinical data and interfaces with HL7 FHIR (US) and EU e-Prescription Gateways.")
    Container(AISymptomChecker, "AI Symptom Checker", "Python, FastAPI", "Provides local AI-powered symptom checking capabilities per region.")
    Container(ConsentPolicyEngine, "Consent & Policy Engine", "Go", "Enforces strict regional data residency, GDPR, and HIPAA compliance policies.")
    Container(RegionalMessageBroker, "Regional Message Broker", "GCP Pub/Sub", "Regionally isolated message brokering ensuring strict data residency.")
    ContainerDb(CloudSQL, "Cloud SQL", "PostgreSQL", "Isolated regional data storage with KMS encryption.")
}

Rel(PatientsEUUS, APIGateway, "Accesses video consultations, e-prescriptions, and AI symptom checker", "HTTPS (TLS 1.3), OAuth2/OIDC")
Rel(LicensedClinicians, APIGateway, "Conducts video consultations and manages patient care", "HTTPS (TLS 1.3), OAuth2/OIDC")
Rel(APIGateway, IdentityProvidersOAuth2OIDC, "Authenticates users", "OAuth2/OIDC")
Rel(APIGateway, ConsultationService, "Routes consultation requests", "gRPC over mTLS")
Rel(APIGateway, ClinicalPrescriptionService, "Routes clinical and prescription requests", "gRPC over mTLS")
Rel(APIGateway, AISymptomChecker, "Routes symptom check requests", "gRPC over mTLS")
Rel(APIGateway, ConsentPolicyEngine, "Validates access and consent policies", "gRPC over mTLS")
Rel(ConsultationService, SFUMediaRelay, "Relays video and audio streams", "WebRTC/UDP (DTLS-SRTP)")
Rel(ClinicalPrescriptionService, NationalePrescriptionGatewaysEUandPharmacySystemsUS, "Transmits prescriptions and health records", "REST/gRPC, HL7 FHIR")
Rel(ConsultationService, RegionalMessageBroker, "Publishes and consumes consultation events", "gRPC over mTLS")
Rel(ClinicalPrescriptionService, RegionalMessageBroker, "Publishes and consumes clinical events", "gRPC over mTLS")
Rel(ClinicalPrescriptionService, CloudSQL, "Reads and writes clinical data", "PostgreSQL Protocol / KMS")
Rel(ConsentPolicyEngine, CloudSQL, "Reads and writes consent records", "PostgreSQL Protocol / KMS")

@enduml