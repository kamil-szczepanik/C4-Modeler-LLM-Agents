@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients (EU/US)", "Patients located in the EU or US seeking video consultations, e-prescriptions, and AI symptom checking.")
Person(Clinicians, "Licensed Clinicians", "Licensed medical professionals conducting video consultations and prescribing treatments.")

System(Platform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and the US while strictly enforcing regional data residency and compliance.")

System_Ext(ControlPlane, "Global Control Plane", "Global control plane managing cross-border operations.")
System_Ext(Gateways, "National e-Prescription Gateways (EU) and Pharmacy Systems (US)", "External national gateways and pharmacy systems connected via HL7 FHIR.")
System_Ext(IdentityProviders, "Identity Providers (OAuth2/OIDC)", "External identity providers handling authentication with MFA.")
System_Ext(AIModelRegistry, "AI Model Registry", "Locally deployed AI model registry per region.")
System_Ext(AuditLogging, "Immutable Audit Logging Service", "Service providing cryptographically signed audit logs for compliance.")

Rel(Patients, Platform, "Accesses video consultations, e-prescriptions, and AI symptom checker", "HTTPS / WebRTC")
Rel(Clinicians, Platform, "Conducts video consultations and manages patient care", "HTTPS / WebRTC")
Rel(Platform, IdentityProviders, "Authenticates users with MFA", "OIDC / OAuth2")
Rel(Platform, Gateways, "Transmits prescriptions and health records", "HTTPS / HL7 FHIR")
Rel(Platform, ControlPlane, "Coordinates cross-border operations", "Mutual TLS (mTLS)")
Rel(Platform, AIModelRegistry, "Runs AI symptom checking locally per region", "Local API")
Rel(Platform, AuditLogging, "Records immutable audit trails", "Secure API")

@enduml