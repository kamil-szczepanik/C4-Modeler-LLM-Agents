@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Edge_Route_Router, "Edge Route Router", "Envoy Proxy", "Handles external edge routing and ingress traffic for the platform.")
    Component(Auth_Token_Translation_Filter, "Auth & Token Translation Filter", "Go, OAuth2/OIDC, JWT", "Authenticates users via OAuth2/OIDC and translates stateless short-lived tokens containing region and consent scopes.")
    Component(Consent_Enforcement_Interceptor, "Consent Enforcement Interceptor", "Go", "Enforces real-time consent revocation and regulatory checks on incoming requests.")
    Component(Telemetry_Audit_Sidecar, "Telemetry & Audit Sidecar", "OpenTelemetry Collector", "Captures distributed traces and request metadata with persistent disk buffering.")
}

Rel(Edge_Route_Router, Auth_Token_Translation_Filter, "Forwards incoming HTTPS requests for token validation", "HTTPS")
Rel(Auth_Token_Translation_Filter, Consent_Enforcement_Interceptor, "Passes authenticated context for consent verification", "In-process")
Rel(Consent_Enforcement_Interceptor, Telemetry_Audit_Sidecar, "Asynchronously forwards cryptographically verified access logs and telemetry", "gRPC / Async")

@enduml