@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Consultation Service container

System_Ext(api_gateway, "API Gateway", "External API Gateway routing incoming requests.")
System_Ext(consent_engine, "Consent & Policy Engine", "External service validating regional data sharing consent.")
System_Ext(client, "Client", "Client application handling video and audio transmission.")

Container_Boundary(consultation_service, "Consultation Service") {
    Component(session_controller, "Session Controller", "Node.js, TypeScript, NestJS", "Manages video consultations, WebRTC signaling, and session lifecycles.")
    Component(signaling_manager, "Signaling Manager", "Node.js", "Handles WebRTC signaling and exchanges SDP offers/answers.")
    Component(data_residency_enforcer, "Data Residency Enforcer", "Middleware", "Enforces regional data compliance across GCP regions.")
    Component(degraded_mode_monitor, "Degraded-Mode Monitor", "Component", "Ensures graceful degradation on low-bandwidth connections.")
    Component(consent_enforcer_interceptor, "Consent Enforcer Interceptor", "Component", "Validates secure patient consent.")
    Component(telemetry_adaptor, "Telemetry Adaptor", "OpenTelemetry SDK", "Enables distributed tracing and metric collection.")
    Component(sfu_media_relay, "SFU Media Relay", "Mediasoup, C++", "Manages room allocations and orchestrates media streams.")
    Component(regional_message_broker, "Regional Message Broker", "GCP Pub/Sub", "Publishes session state changes and metrics.")
}

Rel(api_gateway, session_controller, "Routes incoming consultation requests", "gRPC over mTLS")
Rel(session_controller, consent_engine, "Validates regional data sharing consent", "gRPC over mTLS")
Rel(session_controller, regional_message_broker, "Publishes session state changes and metrics", "gRPC over mTLS")
Rel(signaling_manager, sfu_media_relay, "Manages room allocations and orchestrates media streams", "gRPC")
Rel(signaling_manager, client, "Exchanges SDP offers/answers", "WebSockets with short-lived JWTs")

@enduml