@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Cloud SQL container

Container_Boundary(cloud_sql, "Cloud SQL") {
    Component(PgBouncer, "PgBouncer", "PostgreSQL Connection Pooler", "Manages and optimizes high concurrency database connection pooling.")
    Component(Primary_DB_Instance, "Primary DB Instance", "PostgreSQL 15", "Stores regional clinical records, prescriptions, and consent records with schema isolation and RLS.")
}

Rel(PgBouncer, Primary_DB_Instance, "Routes queries over local loopback", "PostgreSQL Protocol / TLS 1.3")

@enduml