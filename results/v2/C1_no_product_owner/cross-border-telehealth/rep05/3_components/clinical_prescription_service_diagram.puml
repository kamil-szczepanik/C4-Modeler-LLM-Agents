@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Clinical & Prescription Service container

System_Ext(NationalGateways, "National e-Prescription Gateways and US Pharmacy Systems", "REST/gRPC, HL7 FHIR over mTLS", "External systems for national e-prescriptions and pharmacy integration.")

Container_Boundary(ClinicalPrescriptionService, "Clinical & Prescription Service") {
    Component(ClinicalCoreComponent, "Clinical Core Component", "Java, Spring Boot", "Provides secure video consultations and core clinical service logic.")
    Component(PrescriptionWorkflowOrchestrator, "Prescription Workflow Orchestrator", "Java, Spring Boot / Temporal SDK", "Provides durable execution and resilient retries for prescription workflows.")
    Component(FHIRUSAdapterComponent, "FHIR US Adapter Component", "Java, Spring Boot / HAPI FHIR", "Facilitates standards-compliant HL7 FHIR data translation for US interoperability.")
    Component(EUePrescriptionAdapterComponent, "EU e-Prescription Adapter Component", "Java, Spring Boot", "Handles EU e-prescription adapter logic and transmissions.")
    Component(ConsentEnforcerComponent, "Consent Enforcer Component", "Java, Spring Boot / Interceptor", "Validates patient consent via in-process interceptors.")
    Component(CloudSQL, "Cloud SQL", "PostgreSQL with GCP CMEK", "Stores clinical data with region-isolated cryptographic boundaries.")
    Component(RegionalMessageBroker, "Regional Message Broker", "GCP Pub/Sub", "Handles regional messaging and event distribution.")
}

Rel(ClinicalCoreComponent, ConsentEnforcerComponent, "Validates patient consent", "In-process Java method call")
Rel(ClinicalCoreComponent, CloudSQL, "Reads and writes clinical data", "JDBC, PostgreSQL Protocol / KMS")
Rel(PrescriptionWorkflowOrchestrator, EUePrescriptionAdapterComponent, "Delegates external transmissions", "gRPC")
Rel(PrescriptionWorkflowOrchestrator, FHIRUSAdapterComponent, "Delegates external transmissions", "gRPC")
Rel(EUePrescriptionAdapterComponent, NationalGateways, "Transmits prescriptions", "REST/gRPC, HL7 FHIR over mTLS")
Rel(FHIRUSAdapterComponent, NationalGateways, "Transmits prescriptions", "REST/gRPC, HL7 FHIR over mTLS")

@enduml