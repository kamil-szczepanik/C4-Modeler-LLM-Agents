@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(sfu_media_relay, "SFU Media Relay") {
    Component(rtp_rtcp_packet_processor, "RTP/RTCP Packet Processor", "C++, Mediasoup", "Processes and routes RTP/RTCP packets for video and audio streams.")
    Component(simulcast_layer_manager, "Simulcast & Layer Manager", "C++, Mediasoup", "Manages simulcast layers to adapt video quality for low-bandwidth conditions.")
    Component(regional_egress_controller, "Regional Egress Controller", "C++, Mediasoup", "Enforces regional boundary drops and data residency policies.")
    Component(token_validation_signaling_agent, "Token Validation & Signaling Agent", "C++, Mediasoup", "Validates session tokens and handles WebRTC signaling.")
}

Rel(token_validation_signaling_agent, simulcast_layer_manager, "Passes authorized session context", "In-memory C++ API")
Rel(simulcast_layer_manager, rtp_rtcp_packet_processor, "Stream routing rules", "In-memory C++ API")
Rel(sfu_media_relay, regional_egress_controller, "Enforces regional boundary drops", "Internal C++ policy hook")
@enduml