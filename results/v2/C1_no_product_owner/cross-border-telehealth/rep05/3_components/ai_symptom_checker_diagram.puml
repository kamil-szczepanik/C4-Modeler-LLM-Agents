@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Symptom Checker container

System_Ext(API_Gateway, "API Gateway", "External API Gateway")
System_Ext(Regional_GCS_Buckets, "Regional GCS Buckets", "External GCS Buckets for model weights")
System_Ext(Immutable_Audit_Logging_Service, "Immutable Audit Logging Service", "External Audit Logging Service")

Container_Boundary(AI_Symptom_Checker, "AI Symptom Checker") {
    Component(API_Router, "API Router", "FastAPI / Python", "API Router / Controller Component handling high-throughput async gRPC execution.")
    Component(Clinical_NLP, "Clinical NLP", "spaCy / Hugging Face Transformers", "Clinical NLP / Feature Extraction Component for tokenization and feature extraction.")
    Component(Inference_Orchestrator, "Inference Orchestrator", "Python", "Inference Orchestrator Component managing AI model inference.")
    Component(Audit_Traceability_Component, "Audit & Traceability Component", "Python SDK, Cloud KMS", "Audit & Traceability Component for cryptographic signing, model integrity verification, and audit logging.")
    Component(Terminology_Mapping_Component, "Terminology Mapping Component", "Python", "Terminology Mapping Component for standardizing clinical terms.")
}

Rel(API_Gateway, API_Router, "Routes requests via gRPC over mTLS", "gRPC / mTLS")
Rel(Inference_Orchestrator, Regional_GCS_Buckets, "Fetches model weights via HTTPS", "HTTPS")
Rel(Audit_Traceability_Component, Immutable_Audit_Logging_Service, "Pushes signed audit logs via gRPC", "gRPC")

@enduml