@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(PatientsClinicians, "Patients & Clinicians", "End-users accessing the platform via Web/Mobile clients for video consultations and symptom checking.")

System(CrossBorderTelehealthPlatform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and US while enforcing strict regional data residency, HIPAA, GDPR, and EU MDR compliance.")

System_Ext(AISymptomCheckerEngine, "AI Symptom Checker Engine", "Versioned AI/ML model for care urgency recommendations.")
System_Ext(NationalPharmaciesEUSPharmacies, "National Pharmacies (EU) & US Pharmacies", "External fulfillment systems via interoperability gateways for e-prescriptions.")
System_Ext(IdentityProviders, "Identity Providers", "External OAuth2/OIDC services for authentication.")
System_Ext(GCPKMS, "GCP KMS", "Customer-Managed Encryption Keys (CMEK) with separate key rings per region.")

Rel(PatientsClinicians, CrossBorderTelehealthPlatform, "Accesses consultations and symptom checking", "HTTPS and WebRTC (with DTLS-SRTP)")
Rel(CrossBorderTelehealthPlatform, AISymptomCheckerEngine, "Requests care urgency recommendations", "HTTPS APIs with immutable version pinning and input/output logging")
Rel(CrossBorderTelehealthPlatform, NationalPharmaciesEUSPharmacies, "Fulfills e-prescriptions", "Secure APIs utilizing mTLS, HL7 FHIR (US), and national standards (EU)")
Rel(CrossBorderTelehealthPlatform, GCPKMS, "Manages encryption keys with separate key rings per region", "CMEK")
Rel(CrossBorderTelehealthPlatform, IdentityProviders, "Authenticates users", "OAuth2/OIDC")

@enduml