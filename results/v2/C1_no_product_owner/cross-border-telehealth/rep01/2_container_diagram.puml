@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients_Clinicians, "Patients & Clinicians", "End-users accessing the platform via Web/Mobile clients for video consultations and symptom checking.")

System_Ext(AI_Symptom_Checker_Engine, "AI Symptom Checker Engine", "Versioned AI/ML model for care urgency recommendations.")
System_Ext(National_Pharmacies_EU_US_Pharmacies, "National Pharmacies (EU) & US Pharmacies", "External fulfillment systems via interoperability gateways for e-prescriptions.")
System_Ext(Identity_Providers, "Identity Providers", "External OAuth2/OIDC services for authentication.")
System_Ext(GCP_KMS, "GCP KMS", "Customer-Managed Encryption Keys (CMEK) with separate key rings per region.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(Clients, "Clients", "Web/Mobile", "Patient and Clinician applications providing user interfaces.")
    Container(API_Gateway_BFF, "API Gateway / BFF", "Node.js, GraphQL", "Container handling client routing and requests via HTTPS and WebSockets.")
    Container(Consultation_Service, "Consultation Service", "Go", "Container managing WebRTC signaling for video calls.")
    Container(Prescription_Interoperability_Service, "Prescription & Interoperability Service", "Java, Spring Boot", "Container handling HL7 FHIR (US) and EU e-prescription standards.")
    Container(AI_Symptom_Orchestrator, "AI Symptom Orchestrator", "Python, FastAPI", "Container managing AI engine requests and immutable logging.")
    Container(Consent_Audit_Service, "Consent & Audit Service", "Java, Spring Boot", "Container managing user permissions and compliance audits.")
    ContainerDb(Data_Cache_Stores, "Data & Cache Stores", "Google Cloud SQL (PostgreSQL), Google Memorystore (Redis), Google Cloud Storage (GCS)", "Persistent storage and caching layers for regional data.")
    Container(Security_Infrastructure, "Security & Infrastructure", "Istio Service Mesh, GCP KMS, GCP Secret Manager, ArgoCD", "Infrastructure components ensuring zero-trust networking, encryption, and GitOps delivery.")
}

Rel(Patients_Clinicians, Clients, "Interacts with", "Web/Mobile UI")
Rel(Clients, API_Gateway_BFF, "Client-facing traffic and real-time communication", "HTTPS and WebSockets")
Rel(API_Gateway_BFF, Consultation_Service, "Internal routing", "gRPC over TLS via Istio Service Mesh (mTLS)")
Rel(API_Gateway_BFF, Prescription_Interoperability_Service, "Internal routing", "gRPC over TLS via Istio Service Mesh (mTLS)")
Rel(API_Gateway_BFF, AI_Symptom_Orchestrator, "Internal routing", "gRPC over TLS via Istio Service Mesh (mTLS)")
Rel(API_Gateway_BFF, Consent_Audit_Service, "Internal routing", "gRPC over TLS via Istio Service Mesh (mTLS)")
Rel(Consultation_Service, Data_Cache_Stores, "WebRTC session states and caching", "Internal TCP (Google Memorystore Redis)")
Rel(Consultation_Service, Data_Cache_Stores, "Regional data persistence", "Secure local drivers (Google Cloud SQL & GCS)")
Rel(Prescription_Interoperability_Service, Data_Cache_Stores, "Regional data persistence", "Secure local drivers (Google Cloud SQL & GCS)")
Rel(AI_Symptom_Orchestrator, Data_Cache_Stores, "Regional data persistence", "Secure local drivers (Google Cloud SQL & GCS)")
Rel(Consent_Audit_Service, Data_Cache_Stores, "Regional data persistence", "Secure local drivers (Google Cloud SQL & GCS)")
Rel(AI_Symptom_Orchestrator, AI_Symptom_Checker_Engine, "Requests care urgency recommendations", "HTTPS APIs")
Rel(Prescription_Interoperability_Service, National_Pharmacies_EU_US_Pharmacies, "Fulfills e-prescriptions", "Secure APIs utilizing mTLS, HL7 FHIR (US), and national standards (EU)")
Rel(API_Gateway_BFF, Identity_Providers, "Authenticates users", "OAuth2/OIDC")
Rel(Security_Infrastructure, GCP_KMS, "Manages encryption keys with separate key rings per region", "CMEK")

@enduml