@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Prescription & Interoperability Service container

Container_Boundary(presc_interop_service, "Prescription & Interoperability Service") {
    Component(Prescription_Domain_Controller, "Prescription Domain Controller", "Java, Spring Boot", "Manages prescription business logic and orchestrates consent validation and dispatch.")
    Component(FHIR_Adapter_Component, "FHIR Adapter Component", "Java / HAPI FHIR", "Adapts and fulfills US prescriptions using HL7 FHIR standards.")
    Component(EU_E_Prescription_Gateway_Component, "EU E-Prescription Gateway Component", "Java / Apache Camel", "Handles EU e-prescription protocols and integrates with national pharmacies.")
    Component(Circuit_Breaker_Resilience_Interceptor, "Circuit Breaker / Resilience Interceptor", "Resilience4j", "Provides fault tolerance and circuit breaking for external pharmacy invocations.")
    Component(Data_Access_Repository, "Data Access Repository", "Spring Data JPA", "Handles regional data persistence with strict data residency.")
    Component(Consent_Audit_Service, "Consent & Audit Service", "Java, Spring Boot", "Validates patient consent and records audit logs.")
    Component(Google_Cloud_SQL_and_Pub_Sub, "Google Cloud SQL and Pub/Sub", "Google Cloud SQL (PostgreSQL) and Google Cloud Pub/Sub", "Provides regional data persistence and dead-letter queues with CMEK encryption.")
    Component(Infrastructure_Security_Services, "Infrastructure & Security Services", "Istio Service Mesh, GCP KMS, GCP Secret Manager, ArgoCD", "Ensures zero-trust mTLS, cryptographic isolation, and deployment management.")
}

Component_Ext(US_Pharmacies, "US Pharmacies", "REST over TLS 1.3 / mTLS, HL7 FHIR", "External US pharmacy endpoints for prescription fulfillment.")
Component_Ext(National_Pharmacies_EU, "National Pharmacies (EU)", "Secure APIs over mTLS, national standards", "External EU national pharmacy endpoints for prescription fulfillment.")

Rel(Prescription_Domain_Controller, Consent_Audit_Service, "Validates patient consent", "gRPC over TLS")
Rel(Prescription_Domain_Controller, Circuit_Breaker_Resilience_Interceptor, "Triggers dispatch", "In-memory Java calls")
Rel(Circuit_Breaker_Resilience_Interceptor, FHIR_Adapter_Component, "Invokes external dispatch", "Java method calls")
Rel(Circuit_Breaker_Resilience_Interceptor, EU_E_Prescription_Gateway_Component, "Invokes external dispatch", "Java method calls")
Rel(FHIR_Adapter_Component, US_Pharmacies, "Fulfills US prescriptions", "REST over TLS 1.3 / mTLS, HL7 FHIR")
Rel(EU_E_Prescription_Gateway_Component, National_Pharmacies_EU, "Fulfills EU prescriptions", "Secure APIs over mTLS, national standards")
Rel(Prescription_Domain_Controller, Google_Cloud_SQL_and_Pub_Sub, "Regional data persistence and DLQ", "Secure local drivers and CMEK encryption")
Rel(Consent_Audit_Service, Google_Cloud_SQL_and_Pub_Sub, "Regional data persistence and DLQ", "Secure local drivers and CMEK encryption")

@enduml