@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Symptom Orchestrator container

System_Boundary(ai_symptom_orchestrator, "AI Symptom Orchestrator") {
    Component(api_router, "API Router Component", "Python, FastAPI", "Core framework handling incoming routing for the AI Symptom Orchestrator container.")
    Component(consent_proxy, "Consent Proxy & Policy Enforcer Component", "Python", "Enforces fail-closed consent policies and regional data residency compliance.")
    Component(model_adaptor, "Model Invocation & Adaptor Component", "Python, HTTPS APIs with mTLS", "Manages communication and certificate pinning with external AI services.")
    Component(audit_logger, "Audit & Traceability Logger Component with KMS Signing Interceptor", "Python, GCP KMS", "Handles cryptographic signing and asynchronous dispatch with disk-backed WAL buffer for EU MDR compliance.")
}

System_Ext(consent_audit_service, "Consent & Audit Service", "External Service")
System_Ext(ai_engine, "AI Symptom Checker Engine (External)", "External AI Service")
System_Ext(gcp_kms, "GCP KMS", "Google Cloud Key Management Service")
System_Ext(gcs, "Google Cloud Storage (GCS)", "Object Storage")

Rel(api_router, consent_proxy, "In-process function call", "")
Rel(consent_proxy, consent_audit_service, "Synchronous gRPC over TLS with Istio circuit breaker", "gRPC / TLS")
Rel(model_adaptor, ai_engine, "HTTPS APIs with mTLS and certificate pinning", "HTTPS / mTLS")
Rel(audit_logger, gcp_kms, "Envelope encryption over gRPC", "gRPC")
Rel(audit_logger, gcs, "Asynchronous dispatch with disk-backed WAL buffer", "Async / Disk WAL")

@enduml