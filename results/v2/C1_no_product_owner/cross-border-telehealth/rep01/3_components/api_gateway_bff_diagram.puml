@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_bff, "API Gateway / BFF") {
    Component(GraphQLSchemaCoordinatorComplexityAnalyzer, "GraphQL Schema Coordinator & Complexity Analyzer", "Node.js, GraphQL, AST-based parser", "Component managing unified graphs and AST-based query depth limits.")
    Component(AuthScopeMiddleware, "Auth & Scope Middleware", "Node.js, OAuth2/OIDC", "Component validating OAuth2/OIDC JWTs and patient consent scopes.")
    Component(RegionalRoutingIstioContextInjector, "Regional Routing & Istio Context Injector", "Node.js, Istio", "Component enforcing regional data residency and injecting security/trace headers.")
    Component(WebSocketConnectionManager, "WebSocket Connection Manager", "Node.js, WebSockets", "Component handling persistent duplex connections for real-time video signaling.")
}

Rel(GraphQLSchemaCoordinatorComplexityAnalyzer, AuthScopeMiddleware, "Internal request pipeline", "Internal Middleware")
Rel(AuthScopeMiddleware, RegionalRoutingIstioContextInjector, "Internal request pipeline", "Internal Middleware")

@enduml