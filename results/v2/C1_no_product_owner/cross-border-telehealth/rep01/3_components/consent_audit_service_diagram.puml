@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Consent & Audit Service container

Container_Boundary(consent_audit_service, "Consent & Audit Service") {
    Component(ConsentController, "Consent Controller", "Spring MVC", "Handling fine-grained REST/gRPC consent management endpoints.")
    Component(ComplianceEnforcementEngine, "Compliance Enforcement Engine", "Java domain logic / OPA policy bundles", "Evaluating cross-region data access.")
    Component(ConsentTokenIssuer, "Consent Token Issuer", "Nimbus JOSE+JWT", "Generating cryptographically signed, short-lived JWT consent assertions.")
    Component(AuditLogger, "Audit Logger", "Spring Cloud Stream listener", "Capturing immutable audit trails for AI recommendations and access requests.")
    Component(DataRetentionManager, "Data Retention Manager", "Spring Batch", "Enforcing jurisdictional data purging and residency policies.")
    Component(GoogleCloudSQLGCS, "Google Cloud SQL & GCS", "Google Cloud SQL (PostgreSQL) & GCS", "Regional data stores with secure local drivers.")
    Component(GoogleCloudSQL, "Google Cloud SQL", "Google Cloud SQL (PostgreSQL)", "Append-only audit logging via secure local drivers with INSERT-only database privileges.")
}

Component_Ext(ApiGatewayBff, "API Gateway / BFF", "gRPC over TLS", "External entry point receiving signed consent assertions.")

Rel(ConsentController, GoogleCloudSQLGCS, "Regional data access via Spring Data JPA using secure local drivers.", "Spring Data JPA")
Rel(ComplianceEnforcementEngine, GoogleCloudSQLGCS, "Regional data access via Spring Data JPA using secure local drivers.", "Spring Data JPA")
Rel(AuditLogger, GoogleCloudSQL, "Append-only audit logging via secure local drivers with INSERT-only database privileges.", "Secure local drivers")
Rel(ComplianceEnforcementEngine, ConsentTokenIssuer, "Internal handoff of validated consent state for token generation.", "Internal")
Rel(ConsentTokenIssuer, ApiGatewayBff, "Issues signed consent assertions via gRPC over TLS.", "gRPC over TLS")

@enduml