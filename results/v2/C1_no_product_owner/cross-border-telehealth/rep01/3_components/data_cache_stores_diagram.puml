@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data & Cache Stores container

System_Ext(Application_Services, "Application Services", "External application services container")
System_Ext(AI_Symptom_Orchestrator, "AI Symptom Orchestrator & Consultation Service", "External AI symptom orchestrator and consultation service container")

Container_Boundary(Data_Cache_Stores, "Data & Cache Stores") {
    Component(Regional_Relational_Database, "Regional Relational Database", "Google Cloud SQL - PostgreSQL 15, pgBouncer", "Stores structured clinical records, e-prescriptions, and consents with row-level security.")
    Component(Ephemeral_Session_Cache, "Ephemeral Session Cache", "Google Memorystore - Redis Cluster", "Handles real-time WebRTC session states and fast session tokens.")
    Component(Medical_Document_Store, "Medical Document Store", "Google Cloud Storage - GCS", "Immutable WORM storage for unstructured artifacts, AI audit logs, and recordings.")
}

Rel(Application_Services, Regional_Relational_Database, "Structured clinical records, e-prescriptions, and consents", "TCP over TLS 1.3 with IAM authentication and pgBouncer")
Rel(Application_Services, Ephemeral_Session_Cache, "Real-time WebRTC session states and fast session tokens", "Redis TCP protocol using AUTH and TLS")
Rel(AI_Symptom_Orchestrator, Medical_Document_Store, "Unstructured artifacts, AI audit logs, and recordings", "HTTPS (TLS 1.3) within VPC Service Controls")

@enduml