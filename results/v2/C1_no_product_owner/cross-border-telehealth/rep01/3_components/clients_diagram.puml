@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Clients container

Container_Boundary(clients, "Clients") {
    Component(Patient Web App, "Patient Web App", "React (TypeScript)", "Provides the web user interface for patients in the EU and US to access video consultations and e-prescriptions.")
    Component(Patient Mobile App, "Patient Mobile App", "Flutter (Dart)", "Provides the cross-platform mobile user interface for patients, ensuring offline-first capabilities.")
    Component(Clinician Portal, "Clinician Portal", "React (TypeScript)", "Provides the web interface for clinicians to manage consultations and patient records.")
    Component(Local State Manager, "Local State Manager", "SQLCipher / IndexedDB", "Manages encrypted local storage for offline-first capabilities and secure caching on client devices.")
    Component(WebRTC Media Engine, "WebRTC Media Engine", "Native WebRTC with DTLS-SRTP", "Handles low-bandwidth encrypted video and audio streams for telemedicine consultations.")
}

Rel(Patient Web App, WebRTC Media Engine, "Initiates audio and video streams via")
Rel(Patient Mobile App, WebRTC Media Engine, "Initiates audio and video streams via")
Rel(Clinician Portal, WebRTC Media Engine, "Initiates audio and video streams via")
Rel(Patient Web App, Local State Manager, "Reads and writes offline cache using")
Rel(Patient Mobile App, Local State Manager, "Reads and writes offline cache using")
Rel(Clinician Portal, Local State Manager, "Reads and writes offline cache using")

@enduml