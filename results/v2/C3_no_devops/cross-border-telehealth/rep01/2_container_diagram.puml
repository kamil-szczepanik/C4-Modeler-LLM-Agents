@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "Patients located in the EU and US who use the platform for video consultations and the AI symptom checker.")
Person(Caregivers, "Caregivers", "Caregivers assisting patients on the platform.")
Person(LicensedClinicians, "Licensed Clinicians", "Medical professionals who conduct secure video consultations and issue e-prescriptions.")
Person(RegulatoryComplianceAuditors, "Regulatory / Compliance Auditors", "External stakeholders accessing compliance reports.")

System_Ext(PharmaciesEUUS, "Pharmacies (EU & US)", "External partner systems receiving regional e-prescriptions.")
System_Ext(ExternalAIInferenceProviderLLMAPI, "External AI Inference Provider / LLM API", "Provides symptom-checker recommendations and AI triage.")
System_Ext(IdentityProvidersIDPs, "Identity Providers (IDPs)", "Regional Auth0 and GCP IAM services for authentication and MFA.")
System_Ext(BillingInsuranceProviders, "Billing & Insurance Providers", "External payment and claims systems.")

System_Boundary(CrossBorderTelehealthPlatform, "Cross-Border Telehealth Platform") {
    Container(APIGateway, "API Gateway", "Cloud Endpoints / Envoy", "Manages and routes incoming API requests with mTLS via Istio Service Mesh.")
    Container(WebMobileApps, "Web & Mobile Apps", "React / Flutter", "Provides user interfaces for patients, caregivers, and clinicians with offline-first capabilities.")
    Container(CoreTelehealthService, "Core Telehealth Service", "Go / Spring Boot", "Handles core telehealth business logic and coordinates services.")
    Container(VideoMediaServer, "Video Media Server", "WebRTC / LiveKit SFU", "Facilitates real-time secure video consultations.")
    Container(AIInferenceAuditService, "AI Inference & Audit Service", "Python / FastAPI", "Handles AI symptom checking and audit processing.")
    Container(PrescriptionIntegrationService, "Prescription Integration Service", "Node.js", "Manages integration with external pharmacies and e-prescription standards.")
    Container(AuditComplianceReportingService, "Audit & Compliance Reporting Service", "Python / BigQuery", "Generates compliance reports and immutable audit logs.")
    ContainerDb(RegionalDatabases, "Regional Databases", "Cloud Spanner / Cloud SQL", "Provides regional data persistence in europe-west3 and us-central1.")
}

Rel(Patients, WebMobileApps, "Access video consultations and AI symptom checker", "HTTPS / REST")
Rel(Caregivers, WebMobileApps, "Assist patients using the platform", "HTTPS / REST")
Rel(LicensedClinicians, WebMobileApps, "Conduct consultations and manage prescriptions", "HTTPS / REST")
Rel(WebMobileApps, APIGateway, "Send requests via API Gateway", "HTTPS / REST and gRPC over TLS")
Rel(APIGateway, CoreTelehealthService, "Route API requests", "mTLS via Istio Service Mesh")
Rel(CoreTelehealthService, RegionalDatabases, "Persist and retrieve data", "Secure TCP / PostgreSQL via internal VPC connectors")
Rel(PrescriptionIntegrationService, PharmaciesEUUS, "Transmit e-prescriptions", "Cloud Pub/Sub and national e-prescription standards / HL7 FHIR over HTTPS")
Rel(VideoMediaServer, Patients, "Stream video consultations", "WebRTC over UDP/TCP")
Rel(VideoMediaServer, LicensedClinicians, "Stream video consultations", "WebRTC over UDP/TCP")
Rel(AIInferenceAuditService, ExternalAIInferenceProviderLLMAPI, "Request AI symptom analysis", "HTTPS API")

@enduml