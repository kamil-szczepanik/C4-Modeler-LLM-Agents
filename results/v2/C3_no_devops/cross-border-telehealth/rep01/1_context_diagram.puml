@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_EU_US, "Patients (EU & US)", "Patients located in the EU and US who use the platform for video consultations and the AI symptom checker.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Medical professionals who conduct secure video consultations and issue e-prescriptions via the platform.")
System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides secure video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and the US using a dual-region GCP architecture.")
System_Ext(Pharmacies_EU_US, "Pharmacies (EU & US)", "External partner systems receiving regional e-prescriptions.")
System_Ext(External_AI_Inference_Provider_LLM_API, "External AI Inference Provider / LLM API", "Provides symptom-checker recommendations and AI triage.")
System_Ext(Identity_Providers_IDPs, "Identity Providers (IDPs)", "Regional Auth0 and GCP IAM services for authentication and MFA.")
System_Ext(Billing_Insurance_Providers, "Billing & Insurance Providers", "External payment and claims systems.")
System_Ext(Regulatory_Compliance_Auditors, "Regulatory / Compliance Auditors", "External stakeholders accessing compliance logs.")

Rel(Patients_EU_US, Cross_Border_Telehealth_Platform, "Conduct video consultations and use AI symptom checker", "HTTPS / WebSockets")
Rel(Licensed_Clinicians, Cross_Border_Telehealth_Platform, "Conduct video consultations and manage patient care", "HTTPS / WebSockets")
Rel(Cross_Border_Telehealth_Platform, Pharmacies_EU_US, "Transmit regional e-prescriptions", "HL7 FHIR (US) and national standards (EU)")
Rel(Cross_Border_Telehealth_Platform, External_AI_Inference_Provider_LLM_API, "Request symptom analysis and urgency recommendations", "Secure API calls")
Rel(Cross_Border_Telehealth_Platform, Billing_Insurance_Providers, "Process payments and claims", "Regional REST APIs with mTLS")
Rel(Regulatory_Compliance_Auditors, Cross_Border_Telehealth_Platform, "Access compliance logs for audit purposes", "Scoped OAuth tokens and mTLS")
@enduml