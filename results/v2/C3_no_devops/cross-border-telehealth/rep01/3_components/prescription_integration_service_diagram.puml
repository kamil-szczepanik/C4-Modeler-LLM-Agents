@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Prescription Integration Service container

System_Ext(Core_Telehealth_Service, "Core Telehealth Service", "External Container", "Dispatches prescription commands to the Prescription API Controller.")
System_Ext(Pharmacies_EU_US, "Pharmacies (EU & US)", "External Systems", "International pharmacies receiving prescription transmissions.")
System_Ext(Audit_Compliance_Reporting_Service, "Audit & Compliance Reporting Service", "BigQuery", "Receives immutable audit events for security tracking.")

Container_Boundary(Prescription_Integration_Service, "Prescription Integration Service") {
    Component(Prescription_API_Controller, "Prescription API Controller", "Node.js / Express", "Receives prescription commands via gRPC with OAuth 2.0 token propagation and mTLS.")
    Component(Translation_Mapping_Engine, "Translation & Mapping Engine", "Node.js", "Translates and maps e-prescriptions for international pharmacies.")
    Component(Outbound_Dispatcher_Adapter_Worker, "Outbound Dispatcher & Adapter Worker", "Node.js with BullMQ and opossum Circuit Breaker", "Transmits mapped payloads over HTTPS with mTLS and TLS 1.3, managing queueing, retries, and circuit-breaking.")
    Component(Status_Webhook_Handler, "Status Webhook Handler", "Node.js / Express", "Handles delivery state changes and publishes events using HMAC/cert-validated webhooks.")
    Component(Regional_Dead_Letter_Queue, "Regional Dead-Letter Queue", "Cloud SQL with Cloud KMS CMEK", "Persists failed payloads encrypted with Cloud KMS CMEK.")
    Component(Cloud_Pub_Sub, "Cloud Pub/Sub", "GCP Cloud Pub/Sub", "Enables asynchronous event streaming for status updates and failure logging.")
}

Rel(Core_Telehealth_Service, Prescription_API_Controller, "Dispatches prescription commands", "gRPC with OAuth 2.0 token propagation and mTLS")
Rel(Outbound_Dispatcher_Adapter_Worker, Pharmacies_EU_US, "Transmits mapped payloads", "HTTPS with mTLS and TLS 1.3")
Rel(Status_Webhook_Handler, Cloud_Pub_Sub, "Publishes delivery state change events", "HMAC/cert-validated webhooks")
Rel(Outbound_Dispatcher_Adapter_Worker, Regional_Dead_Letter_Queue, "Persists failed payloads", "Encrypted with Cloud KMS CMEK")
Rel(Outbound_Dispatcher_Adapter_Worker, Audit_Compliance_Reporting_Service, "Dispatches immutable audit events", "Security tracking")
@enduml