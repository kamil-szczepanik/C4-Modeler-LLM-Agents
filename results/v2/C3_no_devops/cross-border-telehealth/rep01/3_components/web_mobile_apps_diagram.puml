@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web & Mobile Apps container

System_Ext(API_Gateway, "API Gateway", "Cloud Endpoints / Envoy")
System_Ext(Video_Media_Server, "Video Media Server", "WebRTC / LiveKit SFU")

Container_Boundary(web_mobile_apps, "Web & Mobile Apps") {
    Component(Patient_Portal_UI, "Patient Portal UI", "React / Flutter", "Provides cross-platform user interfaces for patients and caregivers to manage appointments, access the AI symptom checker, and view e-prescriptions.")
    Component(Clinician_Portal_UI, "Clinician Portal UI", "React / Flutter", "Provides cross-platform user interfaces for licensed clinicians to conduct video consultations and issue e-prescriptions.")
    Component(Local_Storage_Manager, "Local Storage Manager", "SQLite / IndexedDB", "Manages offline-first capabilities and local storage for PHI with encryption at rest.")
}

Rel(Patient_Portal_UI, Local_Storage_Manager, "Reads and writes encrypted PHI for offline resilience")
Rel(Clinician_Portal_UI, Local_Storage_Manager, "Reads and writes encrypted PHI for offline resilience")
Rel(Patient_Portal_UI, API_Gateway, "Sends HTTPS / REST and gRPC over TLS requests")
Rel(Clinician_Portal_UI, API_Gateway, "Sends HTTPS / REST and gRPC over TLS requests")
Rel(Patient_Portal_UI, Video_Media_Server, "Establishes WebRTC connections with SRTP and DTLS-SRTP")
Rel(Clinician_Portal_UI, Video_Media_Server, "Establishes WebRTC connections with SRTP and DTLS-SRTP")

@enduml