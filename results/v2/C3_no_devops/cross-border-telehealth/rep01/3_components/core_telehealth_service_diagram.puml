@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Telehealth Service container

System_Ext(API_Gateway, "API Gateway", "Cloud Endpoints / Envoy")
System_Ext(Video_Media_Server, "Video Media Server", "LiveKit SFU")
System_Ext(External_Notification_Providers, "External Notification Providers", "Third-party notification services")
System_Ext(Regional_Databases, "Regional Databases", "Cloud Spanner / Cloud SQL across europe-west3 and us-central1")

Container_Boundary(core_telehealth_service, "Core Telehealth Service") {
    Component(Consent___Policy_Engine, "Consent & Policy Engine", "Embedded Open Policy Agent / OPA library", "Performs zero-latency, dynamic consent and policy evaluation.")
    Component(Session_Manager, "Session Manager", "Go component", "Manages session states and controls media streams and bandwidth thresholds.")
    Component(Appointment___Routing_Coordinator, "Appointment & Routing Coordinator", "Go component", "Coordinates appointments, routing, and triggers prescription alerts.")
    Component(Notification___Dispatcher_Component, "Notification & Dispatcher Component", "Go worker pools", "Dispatches alerts and prescription notifications via asynchronous channels.")
}

Rel(API_Gateway, Consent___Policy_Engine, "Validate incoming requests", "gRPC / mTLS")
Rel(Session_Manager, Video_Media_Server, "Control media streams and bandwidth thresholds", "gRPC")
Rel(Appointment___Routing_Coordinator, Notification___Dispatcher_Component, "Trigger prescription alerts", "Asynchronous Go channels / Cloud Pub/Sub")
Rel(Notification___Dispatcher_Component, External_Notification_Providers, "Deliver alerts", "HTTPS / REST")
Rel(core_telehealth_service, Regional_Databases, "Persist and retrieve data", "Secure TCP / PostgreSQL via internal VPC connectors using SPIFFE/SPIRE Workload Identities")

@enduml