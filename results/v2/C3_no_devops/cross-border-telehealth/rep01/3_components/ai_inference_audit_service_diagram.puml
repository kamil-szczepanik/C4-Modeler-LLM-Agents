@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Inference & Audit Service container

System_Ext(external_ai, "External AI Inference Provider / LLM API", "External service providing AI symptom analysis.")
System_Ext(regional_vault, "Regional Local Vault / Buffer", "Local storage for regional data residency.")

Container_Boundary(ai_service, "AI Inference & Audit Service") {
    Component(Inference_Orchestrator, "Inference Orchestrator", "Python / FastAPI", "Handles prompt construction, regional routing, and fallbacks.")
    Component(Model_Version_Metadata_Manager, "Model Version & Metadata Manager", "Python", "Tracks model identifiers, weight hashes, and prompts.")
    Component(Audit_Log_Formatter_Writer, "Audit Log Formatter & Writer", "Python", "Generates cryptographically signed audit payloads.")
    Component(Circuit_Breaker_Fallback_Policy_Engine, "Circuit Breaker & Fallback Policy Engine", "Python", "Manages latency thresholds and deterministic clinical fallbacks.")
}

Rel(Inference_Orchestrator, external_ai, "Request AI symptom analysis", "HTTPS REST with TLS 1.3/mTLS")
Rel(Audit_Log_Formatter_Writer, regional_vault, "Persist signed logs", "In-process / SQL")

@enduml