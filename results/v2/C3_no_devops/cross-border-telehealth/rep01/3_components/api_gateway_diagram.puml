@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Envoy_Lua_Wasm_Regional_Routing_Filter, "Envoy Lua/Wasm Regional Routing Filter", "Envoy / Lua / Wasm", "Handles regional routing logic for compliance with GDPR and HIPAA.")
    Component(JWT_Consent_Validation_Filter, "JWT & Consent Validation Filter", "Envoy Filter", "Validates JSON Web Tokens and user consent at the edge.")
    Component(Regional_Rate_Limiter, "Regional Rate Limiter", "Envoy / Cloud Memorystore Redis", "Enforces local rate-limiting using regional cache stores.")
    Component(Circuit_Breaker_Fallback_Filter, "Circuit Breaker & Fallback Filter", "Envoy Filter", "Maintains system availability for unstable connections.")
    Component(Access_Log_Exporter, "Access Log Exporter", "Fluent Bit / Cloud Logging API", "Streams sanitized, PHI-stripped access logs asynchronously.")
}

Rel(Envoy_Lua_Wasm_Regional_Routing_Filter, JWT_Consent_Validation_Filter, "Passes routed requests for validation [Internal]", "")
Rel(JWT_Consent_Validation_Filter, Regional_Rate_Limiter, "Checks rate limits", "RESP / TCP")
Rel(Regional_Rate_Limiter, Circuit_Breaker_Fallback_Filter, "Evaluates circuit state [Internal]", "")
Rel(Circuit_Breaker_Fallback_Filter, Access_Log_Exporter, "Triggers log export", "HTTPS")

@enduml