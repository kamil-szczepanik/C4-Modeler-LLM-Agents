@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Video Media Server container

System_Ext(Core_Telehealth_Service, "Core Telehealth Service", "Go / Spring Boot")
System_Ext(Regional_Databases, "Regional Databases", "Cloud Spanner / Cloud SQL")

Container_Boundary(Video_Media_Server, "Video Media Server") {
    Component(SFU_Core_Router, "SFU Core Router", "Go / LiveKit component", "Powers real-time media routing and low-latency handling.")
    Component(ABR_Controller, "Adaptive Bitrate (ABR) Controller", "Go component", "Manages subscription changes and bandwidth optimization for rural users.")
    Component(Room_and_Session_Manager, "Room & Session Manager", "Go component", "Validates session tokens and manages consultation sessions.")
    Component(Media_Compliance_Logger, "Media Compliance Logger", "Go component", "Writes anonymized session metadata to regional databases.")
}

Rel(ABR_Controller, SFU_Core_Router, "Command layer subscription changes", "Internal Go Channel")
Rel(Room_and_Session_Manager, Core_Telehealth_Service, "Validate session token", "gRPC")
Rel(Media_Compliance_Logger, Regional_Databases, "Write anonymized session metadata", "SQL over TLS")

@enduml