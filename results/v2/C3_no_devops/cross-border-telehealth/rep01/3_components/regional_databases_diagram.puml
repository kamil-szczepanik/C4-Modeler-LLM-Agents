@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Regional Databases container

Container_Boundary(regional_databases, "Regional Databases") {
    Component(EU_Regional_Database, "EU Regional Database", "Google Cloud SQL for PostgreSQL (europe-west3)", "Stores EU patient data, prescriptions, and audit logs while strictly enforcing regional data residency and isolation for GDPR compliance.")
    Component(US_Regional_Database, "US Regional Database", "Google Cloud SQL for PostgreSQL (us-central1)", "Stores US patient data, prescriptions, and audit logs while strictly enforcing regional data residency and isolation for HIPAA compliance.")
}

Rel(EU_Regional_Database, US_Regional_Database, "No direct runtime replication to maintain strict regional data isolation.", "")

@enduml