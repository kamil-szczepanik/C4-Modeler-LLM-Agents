@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit & Compliance Reporting Service container

Container_Boundary(audit_compliance_reporting_service, "Audit & Compliance Reporting Service") {
    Component(Audit_Event_Collector_Component, "Audit Event Collector Component", "Python / FastAPI", "Provides immutable audit logging and ingests telemetry from core services via mTLS and gRPC.")
    ComponentDb(Compliance_Data_Store_Component, "Compliance Data Store Component", "Google BigQuery", "Stores audit trails using partitioned datasets with WORM policies for tamper-proof storage and regional data residency.")
    Component(Report_Generation_Dashboard_API_Component, "Report Generation & Dashboard API Component", "Python / FastAPI", "Provides reporting and dashboard APIs accessed by auditors and operations via HTTPS/REST with OAuth2/OIDC.")
    Component(Compliance_Anomaly_Detection_Component, "Compliance Anomaly Detection Component", "Python / Cloud Functions", "Performs real-time anomaly detection to guarantee GDPR, HIPAA, and EU MDR compliance.")
}

Rel(Audit_Event_Collector_Component, Compliance_Data_Store_Component, "Persists audit events", "")
Rel(Report_Generation_Dashboard_API_Component, Compliance_Data_Store_Component, "Executes regional SQL queries with CMEK", "regional SQL")
Rel(Compliance_Anomaly_Detection_Component, Compliance_Data_Store_Component, "Analyzes compliance data", "")
@enduml