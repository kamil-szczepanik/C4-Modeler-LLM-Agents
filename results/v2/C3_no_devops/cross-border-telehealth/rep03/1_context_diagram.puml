@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_and_Licensed_Clinicians, "Patients and Licensed Clinicians", "Primary users who conduct video consultations, use the AI symptom checker, and manage e-prescriptions.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and US while ensuring strict medical and privacy compliance.")

System_Ext(Pharmacies_and_National_State_Health_Authorities, "Pharmacies and National/State Health Authorities", "External partners handling localized prescription fulfillment and health reporting.")
System_Ext(Regulatory_Authorities, "Regulatory Authorities", "Bodies enforcing EU MDR and US HHS compliance.")
System_Ext(Regional_Payment_Gateways, "Regional Payment Gateways", "Stripe and Adyen regional instances handling payment processing.")
System_Ext(EU_National_E_Prescription_Gateways_and_US_Pharmacy_Networks, "EU National E-Prescription Gateways and US Pharmacy Networks", "External networks for cross-border e-prescription interoperability.")
System_Ext(EU_US_Identity_Providers_and_AI_Inference_Provider, "EU/US Identity Providers and AI Inference Provider", "External identity services for federated authentication and AI providers for symptom checking.")

Rel(Patients_and_Licensed_Clinicians, Cross_Border_Telehealth_Platform, "Accesses consultations and platform features via low-bandwidth optimized connections", "HTTPS and WebSockets")
Rel(Cross_Border_Telehealth_Platform, EU_National_E_Prescription_Gateways_and_US_Pharmacy_Networks, "Transmits e-prescription data securely", "HTTPS / REST with mTLS")
Rel(Cross_Border_Telehealth_Platform, Regional_Payment_Gateways, "Processes payments regionally", "HTTPS / REST")
@enduml