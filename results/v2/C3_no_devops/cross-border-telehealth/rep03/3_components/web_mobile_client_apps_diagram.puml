@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web & Mobile Client Apps container

Container_Boundary(web_mobile_client_apps, "Web & Mobile Client Apps") {
    Component(AdaptiveMediaComponent, "Adaptive Media Component", "WebRTC, SRTP, DTLS", "Handles adaptive media streaming and connects to the WebRTC SFU Media Relay for video consultations.")
    Component(ConsentRoutingStateManager, "Consent & Routing State Manager", "Client-side state management", "Manages regional consent and routing states to enforce strict data residency for EU and US patients.")
    Component(SymptomCheckerUIAuditLogger, "Symptom Checker UI & Audit Logger", "Flutter / React Native UI", "Provides the user interface for the AI symptom checker and logs audit events securely.")
    Component(OfflineFirstStorageEngine, "Offline-First Storage Engine", "SQLCipher, iOS Keychain, Android Keystore", "Provides client-side encryption at rest, secure enclave storage, and low-bandwidth resilience for offline usage.")
}

System_Ext(WebRTCSFUMediaRelay, "WebRTC SFU Media Relay", "Scalable WebRTC media relay for video consultations.")
System_Ext(APIGateway, "API Gateway", "Google Cloud API Gateway / Apigee managing ingress requests.")

Rel(AdaptiveMediaComponent, WebRTCSFUMediaRelay, "Streams encrypted video consultations", "WebRTC, SRTP, DTLS")
Rel(ConsentRoutingStateManager, APIGateway, "Sends secure requests", "HTTPS, GraphQL over TLS 1.3")
Rel(SymptomCheckerUIAuditLogger, APIGateway, "Sends secure requests", "HTTPS, GraphQL over TLS 1.3")
Rel(OfflineFirstStorageEngine, APIGateway, "Syncs data securely", "HTTPS, GraphQL over TLS 1.3")

@enduml