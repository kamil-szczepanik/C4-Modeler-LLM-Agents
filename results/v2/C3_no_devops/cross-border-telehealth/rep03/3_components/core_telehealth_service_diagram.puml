@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Telehealth Service container

Container_Boundary(core_telehealth_service, "Core Telehealth Service") {
    Component(Consent_Policy_Enforcement_Engine, "Consent & Policy Enforcement Engine", "Java / Spring Security", "Enforces strict data residency, zero-trust security controls, and policy compliance for GDPR and HIPAA.")
    Component(Consultation_Session_Manager, "Consultation Session Manager", "Spring Boot / Java", "Manages secure, region-isolated clinical consultation sessions.")
    Component(Clinical_Core_Orchestrator, "Clinical Core Orchestrator", "Spring Boot / Java", "Orchestrates clinical consultations, e-prescriptions, and AI symptom checks.")
    Component(Event_Driven_Sync_Outbox_Dispatcher, "Event-Driven Sync & Outbox Dispatcher", "Spring Data JPA & Cloud Pub/Sub", "Implements the Transactional Outbox pattern for rural network resilience and asynchronous messaging.")
}

Rel(Consent_Policy_Enforcement_Engine, Clinical_Core_Orchestrator, "Validates security and access policies for")
Rel(Clinical_Core_Orchestrator, Consultation_Session_Manager, "Manages session lifecycle via")
Rel(Clinical_Core_Orchestrator, Event_Driven_Sync_Outbox_Dispatcher, "Dispatches asynchronous events through")

@enduml