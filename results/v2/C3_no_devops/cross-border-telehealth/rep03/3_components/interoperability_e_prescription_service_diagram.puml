@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(interop_service, "Interoperability & E-Prescription Service") {
    Component(FHIR_National_Standard_Transformer, "FHIR & National Standard Transformer", "TypeScript", "Transforms e-prescription data between FHIR and national standards.")
    Component(Gateway_Dispatcher_Circuit_Breaker, "Gateway Dispatcher & Circuit Breaker", "TypeScript / Resilience4js", "Exchanges e-prescription data with external networks and provides circuit breaking.")
    Component(Dispensation_Event_Poller_Webhook_Handler, "Dispensation Event Poller / Webhook Handler", "Node.js", "Handles dispensation event webhooks and publishes status updates to the core service.")
    Component(Compliance_Audit_Logger, "Compliance Audit Logger", "TypeScript", "Enforces compliance audit logging for HIPAA and GDPR accountability.")
}

System_Ext(EU_US_Networks, "EU/US Networks", "EU National E-Prescription Gateways and US Pharmacy Networks")
System(Core_Telehealth_Service, "Core Telehealth Service", "Spring Boot / Java")

Rel(Gateway_Dispatcher_Circuit_Breaker, EU_US_Networks, "Exchanges e-prescription data", "HTTPS / REST, HL7 FHIR and EU standards with TLS 1.3 & mTLS")
Rel(Dispensation_Event_Poller_Webhook_Handler, Core_Telehealth_Service, "Publishes status updates", "gRPC")
@enduml