@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(sfu_media_relay, "WebRTC SFU Media Relay") {
    Component(sfu_core_router, "SFU Core Router", "Go / LiveKit SDK", "High concurrency router handling WebRTC media streams.")
    Component(abr_controller, "Adaptive Bitrate (ABR) Controller", "Go", "Controls adaptive bitrate for video consultations.")
    Component(media_auth_validator, "Media Auth & Token Validator", "Go", "Issues and verifies session tokens for secure access.")
    Component(telemetry_exporter, "Telemetry & Audit Exporter", "Go", "Exports QoS metrics and anonymized session metadata.")
}

Rel(abr_controller, telemetry_exporter, "Publishes QoS metrics", "In-memory channel")

@enduml