@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Geo_Routing_Context_Filter, "Geo-Routing & Context Filter", "Google Cloud API Gateway / Apigee with Envoy", "Handles geo-routing, regional request distribution, and context filtering.")
    Component(OAuth2_JWT_Validator, "OAuth2/JWT Validator", "Google Cloud API Gateway / Apigee", "Validates OAuth2 tokens and JSON Web Tokens for incoming requests.")
    Component(Rate_Limiting_Resiliency_Component, "Rate Limiting & Resiliency Component", "Google Cloud API Gateway / Apigee", "Enforces rate limits and provides resiliency mechanisms for traffic management.")
    Component(Localization_Header_Injector_Component, "Localization & Header Injector Component", "Google Cloud API Gateway / Apigee", "Injects localization settings and custom headers into requests.")
    Component(Gateway_Audit_Telemetry_Component, "Gateway Audit & Telemetry Component", "Google Cloud API Gateway / Apigee", "Captures audit logs and telemetry data for gateway traffic.")
    Component(WAF_module, "WAF module", "Google Cloud Armor / WAF", "Provides Web Application Firewall protection against common web threats.")
}

System_Ext(Core_Telehealth_Service, "Core Telehealth Service", "Spring Boot / Java")
System_Ext(AI_Symptom_Checker_Service, "AI Symptom Checker Service", "FastAPI / Python")
System_Ext(Interoperability_E_Prescription_Service, "Interoperability & E-Prescription Service", "Node.js")

Rel(Geo_Routing_Context_Filter, Core_Telehealth_Service, "Routes requests regionally", "gRPC with mTLS via Istio")
Rel(Geo_Routing_Context_Filter, AI_Symptom_Checker_Service, "Routes symptom check requests", "gRPC with mTLS via Istio, with injected telemetry headers")
Rel(Localization_Header_Injector_Component, Interoperability_E_Prescription_Service, "Routes interoperability requests", "gRPC with mTLS via Istio")

@enduml