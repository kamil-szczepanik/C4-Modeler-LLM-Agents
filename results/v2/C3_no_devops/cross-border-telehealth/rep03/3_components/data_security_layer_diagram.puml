@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("data_security_layer", "Data & Security Layer") {
    Component("Cloud SQL PostgreSQL", "Cloud SQL PostgreSQL", "Cloud SQL with PostgreSQL", "Provides relational data storage with Row-Level Security (RLS) and encrypted connections.")
    Component("Cloud Storage", "Cloud Storage", "GCP Cloud Storage", "Object storage used in conjunction with WORM Bucket Lock for tamper-proof audit logs.")
    Component("GCP Cloud KMS", "GCP Cloud KMS", "GCP Cloud KMS & CMEK", "Manages AES-256 encryption at rest with automatic 90-day key rotation.")
    Component("GCP Service Mesh with Istio", "GCP Service Mesh with Istio", "Istio Service Mesh", "Enforces service-to-service mTLS authorization and secure communications.")
    Component("OPA Engine", "OPA Engine", "Open Policy Agent (OPA)", "Enforces real-time consent and authorization policies.")
    Component("WORM Bucket Lock", "WORM Bucket Lock", "Cloud Storage WORM", "Ensures tamper-proof audit logs for EU MDR traceability.")
    Component("Data Portability Exporter", "Data Portability Exporter", "GCP Data Portability Exporter", "Handles data export requests to ensure data portability compliance.")
}

Rel("GCP Service Mesh with Istio", "OPA Engine", "Queries for real-time consent and authorization decisions", "gRPC/mTLS")
Rel("Cloud SQL PostgreSQL", "GCP Cloud KMS", "Utilizes keys for encryption at rest", "Internal API")
Rel("WORM Bucket Lock", "Cloud Storage", "Applies compliance locks to audit log buckets", "Internal API")

@enduml