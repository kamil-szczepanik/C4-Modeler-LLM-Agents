@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Symptom Checker Service container

System_Ext(web_mobile_client_apps, "Web & Mobile Client Apps", "External client applications")
System_Ext(data_security_layer, "Data & Security Layer", "External data and security services")
System_Ext(external_ai_inference_provider, "External AI Inference Provider", "External AI inference providers")
System_Ext(cloud_sql_postgresql, "Cloud SQL (PostgreSQL)", "External database service")
System_Ext(core_telehealth_service, "Core Telehealth Service", "External telehealth service")

Container_Boundary(ai_symptom_checker_service, "AI Symptom Checker Service") {
    Component(symptom_analysis_api_controller, "Symptom Analysis API Controller", "FastAPI Router", "Handles incoming symptom analysis requests via gRPC.")
    Component(consent_resilience_middleware, "Consent & Resilience Middleware", "Python Middleware", "Validates consent tokens and ensures resilience under unstable network conditions.")
    Component(inference_orchestrator, "Inference Orchestrator", "Python Container", "Orchestrates regional routing to external AI inference providers.")
    Component(audit_traceability_logger, "Audit & Traceability Logger", "SQLAlchemy / GCP Cloud KMS (CMEK)", "Logs audit trails and ensures traceability for EU MDR compliance with encrypted storage.")
    Component(clinical_handoff_formatter, "Clinical Handoff Formatter", "Python / gRPC", "Formats and delivers clinical handoffs to licensed clinicians and core telehealth services.")
}

Rel(web_mobile_client_apps, symptom_analysis_api_controller, "Sends symptom analysis requests", "gRPC with mTLS over GCP Service Mesh")
Rel(consent_resilience_middleware, data_security_layer, "Validates consent tokens", "")
Rel(inference_orchestrator, external_ai_inference_provider, "Routes inference requests regionally", "europe-west3 / us-central1")
Rel(audit_traceability_logger, cloud_sql_postgresql, "Persists audit logs", "SQLAlchemy with CMEK encryption")
Rel(clinical_handoff_formatter, core_telehealth_service, "Transmits clinical handoffs", "gRPC")

@enduml