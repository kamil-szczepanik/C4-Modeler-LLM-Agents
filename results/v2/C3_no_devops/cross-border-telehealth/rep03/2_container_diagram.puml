@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "Patients in the EU and US using the platform for consultations and symptom checking.")
Person(LicensedClinicians, "Licensed Clinicians", "Medical professionals conducting video consultations and issuing e-prescriptions.")
Person(PharmacyStaff, "Pharmacy Staff", "Staff fulfilling e-prescriptions securely.")
Person(PlatformAdministratorsComplianceOfficers, "Platform Administrators / Compliance Officers", "Personnel overseeing regulatory compliance, security, and administration.")

System_Ext(EUNationalEPrescriptionGatewaysandUSPharmacyNetworks, "EU National E-Prescription Gateways and US Pharmacy Networks", "External systems for processing cross-border e-prescriptions.")

System_Boundary(CrossBorderTelehealthPlatform, "Cross-Border Telehealth Platform") {
    Container(WebMobileClientApps, "Web & Mobile Client Apps", "Flutter / React Native", "Mobile-first, low-bandwidth optimized client applications for patients and clinicians.")
    Container(APIGateway, "API Gateway", "Google Cloud API Gateway / Apigee", "Manages edge routing, security, and traffic to core microservices.")
    Container(CoreTelehealthService, "Core Telehealth Service", "Spring Boot / Java", "Handles core business logic for telehealth operations.")
    Container(AISymptomCheckerService, "AI Symptom Checker Service", "FastAPI / Python", "Provides AI-powered symptom analysis for users.")
    Container(InteroperabilityEPrescriptionService, "Interoperability & E-Prescription Service", "Node.js", "Translates payloads to HL7 FHIR and EU e-prescription standards.")
    Container(WebRTCSFUMediaRelay, "WebRTC SFU Media Relay", "LiveKit on GKE", "Handles real-time video and audio media streaming.")
    Container(DataSecurityLayer, "Data & Security Layer", "Cloud SQL (PostgreSQL), Cloud Storage, GCP Cloud KMS, GCP Service Mesh (Istio)", "Provides regional data storage, encryption, and secure service mesh networking.")
}

Rel(Patients, WebMobileClientApps, "Interacts with the platform for consultations and AI symptom checking", "HTTPS / WebSockets")
Rel(LicensedClinicians, WebMobileClientApps, "Conducts consultations and manages e-prescriptions", "HTTPS / WebSockets")
Rel(PharmacyStaff, WebMobileClientApps, "Accesses prescription data", "HTTPS")
Rel(PlatformAdministratorsComplianceOfficers, WebMobileClientApps, "Monitors platform compliance and administration", "HTTPS")

Rel(WebMobileClientApps, APIGateway, "Sends API requests and queries", "HTTPS and GraphQL over TLS 1.3")
Rel(APIGateway, CoreTelehealthService, "Routes requests internally", "gRPC with mTLS via GCP Service Mesh")
Rel(APIGateway, AISymptomCheckerService, "Routes symptom check requests", "gRPC with mTLS via GCP Service Mesh")
Rel(APIGateway, InteroperabilityEPrescriptionService, "Routes interoperability requests", "gRPC with mTLS via GCP Service Mesh")
Rel(WebMobileClientApps, WebRTCSFUMediaRelay, "Streams video consultations", "WebRTC, SRTP, DTLS")
Rel(CoreTelehealthService, DataSecurityLayer, "Persists and retrieves encrypted telehealth data", "Encrypted PostgreSQL connections via Cloud KMS")
Rel(InteroperabilityEPrescriptionService, EUNationalEPrescriptionGatewaysandUSPharmacyNetworks, "Exchanges e-prescription data", "HL7 FHIR (US) and EU e-prescription standards")

@enduml