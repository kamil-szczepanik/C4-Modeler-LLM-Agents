@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_EU_US, "Patients (EU & US)", "Patients located in the EU and US seeking video consultations, e-prescriptions, and AI symptom checking.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Licensed medical professionals providing video consultations and managing patient treatments.")
Person(Pharmacies_EU_US, "Pharmacies (EU & US)", "Regional pharmacies fulfilling e-prescriptions for patients.")
Person(Compliance_Regulatory_Officers, "Compliance & Regulatory Officers", "Officers responsible for overseeing regulatory traceability, GDPR, and HIPAA compliance.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Cross-Border Telehealth Platform providing video consultations, e-prescriptions, and an internal AI symptom checker for EU and US patients with strict regional data residency, GDPR/HIPAA compliance, and regulatory traceability across distributed GCP deployments.")

System_Ext(Internal_AI_Symptom_Checker_Engine, "Internal AI Symptom Checker Engine", "Internal AI engine operating natively within regional GCP clusters for symptom checking and audit logging.")
System_Ext(National_Identity_Providers, "National Identity Providers", "EU eID and US OAuth Providers handling user authentication.")
System_Ext(Third_Party_Payment_Gateways, "Third-Party Payment Gateways", "Stripe and regional processors handling secure payment transactions via tokenization.")
System_Ext(EU_National_EPrescription_Gateways_US_Pharmacy_Networks, "EU National E-Prescription Gateways & US Pharmacy Networks", "External gateways and networks for processing e-prescriptions using HL7 FHIR and national standards.")

Rel(Patients_EU_US, Cross_Border_Telehealth_Platform, "Interacts with regional Platform instances for video consultations and platform features", "HTTPS (REST/GraphQL), WebRTC")
Rel(Licensed_Clinicians, Cross_Border_Telehealth_Platform, "Interacts with regional Platform instances to conduct video consultations and manage care", "HTTPS (REST/GraphQL), WebRTC")
Rel(Cross_Border_Telehealth_Platform, EU_National_EPrescription_Gateways_US_Pharmacy_Networks, "Connects to transmit e-prescriptions and health data exchange", "HTTPS/REST (HL7 FHIR in US, national standards in EU)")
Rel(Cross_Border_Telehealth_Platform, National_Identity_Providers, "Authenticates users via OIDC with PKCE and MFA", "OpenID Connect (OIDC) over HTTPS")
Rel(Cross_Border_Telehealth_Platform, Third_Party_Payment_Gateways, "Integrates with payment processors using tokenization", "HTTPS/REST")
Rel(Cross_Border_Telehealth_Platform, Internal_AI_Symptom_Checker_Engine, "Executes symptom checking natively within regional GCP clusters with audit logging", "GCP Internal Network")

@enduml