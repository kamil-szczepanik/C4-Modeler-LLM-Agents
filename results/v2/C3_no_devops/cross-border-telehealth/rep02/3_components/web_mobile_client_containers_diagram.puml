@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web & Mobile Client Containers container

System_Ext(api_gateway, "API Gateway", "API Gateway for backend services")
System_Ext(video_streaming_gateway, "Video Streaming Gateway", "Video Streaming Gateway for WebRTC media")

Container_Boundary(web_mobile_client_containers, "Web & Mobile Client Containers") {
    Component(ui_presentation_routing_module, "UI Presentation & Routing Module", "Flutter / React Native", "Handles cross-platform UI presentation and navigation for patients and clinicians.")
    Component(offline_first_state_caching_manager, "Offline-First State & Caching Manager", "SQLCipher & Secure Enclaves", "Manages local at-rest encryption for cached PHI/PII on mobile devices and offline data persistence.")
    Component(api_sync_client, "API & Sync Client", "gRPC over mTLS", "Handles bandwidth-efficient offline queue synchronization with the API Gateway.")
    Component(webrtc_media_client, "WebRTC Media Client", "WebRTC", "Manages low-latency video streaming for degraded connections under 300 kbit/s.")
}

Rel(ui_presentation_routing_module, offline_first_state_caching_manager, "Persists and retrieves cached state and PHI/PII data")
Rel(ui_presentation_routing_module, api_sync_client, "Triggers API requests and offline queue synchronization")
Rel(ui_presentation_routing_module, webrtc_media_client, "Initiates video consultation media streams")
Rel(api_sync_client, api_gateway, "Sends HTTPS/gRPC requests via mTLS", "gRPC / mTLS")
Rel(webrtc_media_client, video_streaming_gateway, "Streams WebRTC media streams with SRTP/DTLS", "WebRTC / SRTP / DTLS")

@enduml