@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("API Gateway", "API Gateway") {
    Component("Claims-Driven Geo-Routing Filter", "Claims-Driven Geo-Routing Filter", "Envoy-based Cloud Endpoints / Apigee", "Routes client requests based on geographic claims and regional data residency constraints.")
    Component("Consent & Policy Enforcement Filter", "Consent & Policy Enforcement Filter", "Envoy-based Cloud Endpoints / Apigee", "Enforces consent validation and policy checks for cross-border health data access.")
    Component("Telemetry & Resilience Proxy", "Telemetry & Resilience Proxy", "Envoy-based Cloud Endpoints / Apigee", "Handles telemetry tracking and resilience proxying for downstream microservices.")
}

Rel("Claims-Driven Geo-Routing Filter", "Consent & Policy Enforcement Filter", "Internal gRPC")
Rel("Consent & Policy Enforcement Filter", "Telemetry & Resilience Proxy", "Internal gRPC")
@enduml