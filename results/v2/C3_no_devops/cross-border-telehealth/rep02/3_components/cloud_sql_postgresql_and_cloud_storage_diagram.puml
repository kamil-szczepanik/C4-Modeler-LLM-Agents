@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Cloud SQL (PostgreSQL) and Cloud Storage container

Container_Boundary(cloud_sql_storage, "Cloud SQL (PostgreSQL) and Cloud Storage") {
    Component(postgresql_audit_ledger, "PostgreSQL Audit Ledger", "Cloud SQL PostgreSQL + pgaudit", "Relational database with tamper-evident logging for system audits.")
    Component(object_versioning_retention_manager, "Object Versioning & Retention Manager", "Cloud Storage with Object Lock", "Immutable storage for AI model versions and session audits ensuring WORM compliance.")
    Component(partitioned_data_access_layer, "Partitioned Data Access Layer", "PostgreSQL Table Partitioning", "Manages partitioned data access for high availability and fast consent verification.")
    Component(pitr_snapshot_scheduler_and_automated_cross_zone_replication_manager, "PITR Snapshot Scheduler and Automated Cross-Zone Replication Manager", "Internal GCP APIs and Cloud Scheduler", "Manages automated backups, point-in-time recovery, and cross-zone replication.")
}

Rel(pitr_snapshot_scheduler_and_automated_cross_zone_replication_manager, postgresql_audit_ledger, "Triggers automated backups and PITR snapshots", "Internal GCP APIs")
Rel(pitr_snapshot_scheduler_and_automated_cross_zone_replication_manager, object_versioning_retention_manager, "Manages snapshots and replicated backups", "Internal GCP APIs")
Rel(partitioned_data_access_layer, postgresql_audit_ledger, "Queries and writes partitioned operational data", "SQL")
@enduml