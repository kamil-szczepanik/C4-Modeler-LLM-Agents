@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "External API Gateway")
System_Ext(cloud_storage, "Cloud Storage", "WORM Cloud Storage")
System_Ext(pub_sub, "Pub/Sub", "GCP Pub/Sub")

Container_Boundary(patient_consent_preference_service_container, "Patient Consent & Preference Service Container") {
    Component(consent_api_router, "Consent API Router", "Go, chi framework", "Handles incoming consent queries and updates via gRPC over mTLS with JWTs.")
    Component(consent_policy_engine, "Consent Policy Engine", "Go", "Evaluates and persists consent states, enforcing fine-grained, time-bound data access policies.")
    Component(audit_logger, "Audit Logger", "Go, Cryptographic Chaining", "Writes tamper-evident logs for GDPR and HIPAA compliance.")
    Component(postgresql_repository_layer, "PostgreSQL Repository Layer", "Go, pgx", "Manages data persistence and retrieval utilizing PostgreSQL wire protocol with CMEK.")
    Component(consent_expiry_background_worker, "Consent Expiry Background Worker", "Go", "Handles automated lifecycle management and expiry of patient privacy consents.")
}

Rel(api_gateway, consent_api_router, "Queries and updates consent", "gRPC over mTLS with JWTs")
Rel(consent_policy_engine, postgresql_repository_layer, "Persists and evaluates consent states", "PostgreSQL wire protocol with CMEK")
Rel(audit_logger, cloud_storage, "Writes tamper-evident logs", "Google Cloud Storage APIs")
Rel(consent_policy_engine, pub_sub, "Broadcasts state changes for cache invalidation", "GCP Pub/Sub")
@enduml