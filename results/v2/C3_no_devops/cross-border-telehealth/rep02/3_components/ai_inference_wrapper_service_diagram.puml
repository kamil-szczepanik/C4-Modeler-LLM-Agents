@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(ai_inference_wrapper_service, "AI Inference Wrapper Service") {
    Component(api_router_validation_component, "API Router & Validation Component", "FastAPI, Python", "Handles incoming API requests and performs payload validation.")
    Component(pseudonymization_redaction_component, "Pseudonymization & Redaction Component", "Python", "Sanitizes and pseudonymizes raw payloads to enforce data privacy and compliance.")
    Component(regional_ai_gateway_client, "Regional AI Gateway Client", "gRPC, Python", "Executes inference requests against the regional AI gateway.")
    Component(circuit_breaker_fallback_component, "Circuit Breaker & Fallback Component", "Python", "Ensures high availability by handling failures and executing fallback mechanisms.")
    Component(audit_traceability_logger, "Audit & Traceability Logger", "Python, TCP/mTLS", "Writes comprehensive audit logs to ensure complete traceability.")
    Component(gcp_cloud_sql_postgresql_and_cloud_storage, "GCP Cloud SQL (PostgreSQL) and Cloud Storage", "Cloud KMS, Cloud Storage, PostgreSQL", "Provides secure, encrypted storage with WORM policies for compliance and audit logs.")
}

Rel(api_router_validation_component, pseudonymization_redaction_component, "Passes raw payloads via in-memory Python calls")
Rel(pseudonymization_redaction_component, regional_ai_gateway_client, "Passes sanitized payloads via in-memory Python calls")
Rel(regional_ai_gateway_client, circuit_breaker_fallback_component, "Executes inference via gRPC")
Rel(audit_traceability_logger, gcp_cloud_sql_postgresql_and_cloud_storage, "Writes audit logs via TCP/mTLS with CMEK and WORM policies")

@enduml