@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(core_telehealth_backend, "Core Telehealth Backend") {
    Component(Transaction_Ingestion_Component, "Transaction Ingestion Component", "Go / gRPC", "Ingests transaction payloads securely with idempotency keys.")
    Component(Resilient_Sync_Orchestrator, "Resilient Sync Orchestrator", "Go / Temporal on GKE", "Manages offline-resilient transactions and workflow orchestration.")
    Component(Session_State_Manager, "Session & State Manager", "Go / Redis Memorystore", "Handles real-time session and state management.")
    Component(Clinical_Exception_Audit_Notifier, "Clinical Exception & Audit Notifier", "Go / GCP Pub/Sub", "Dispatches failure events and audit notifications via regional topics.")
}

Rel(Transaction_Ingestion_Component, Resilient_Sync_Orchestrator, "Passes idempotency-keyed payloads securely")
Rel(Resilient_Sync_Orchestrator, Clinical_Exception_Audit_Notifier, "Dispatches failure events via GCP Pub/Sub regional topics")

@enduml