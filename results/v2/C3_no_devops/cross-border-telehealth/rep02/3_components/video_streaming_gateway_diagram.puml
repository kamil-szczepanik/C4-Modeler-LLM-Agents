@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Core_Telehealth_Backend, "Core Telehealth Backend", "External container for telemetry data collection")

Container_Boundary(Video_Streaming_Gateway, "Video Streaming Gateway") {
    Component(SFU_Media_Router_Component, "SFU Media Router Component", "MediaSoup C++/Node.js", "Core SFU media routing for high-performance packet forwarding and WebRTC media transport.")
    Component(Adaptive_Bitrate___Transcoding_Controller_Component, "Adaptive Bitrate & Transcoding Controller Component", "Internal IPC / gRPC", "Handles dynamic media layer adjustments to maintain consultations in degraded network conditions.")
    Component(Signaling___Session_Manager_Component, "Signaling & Session Manager Component", "Node.js/Go", "Manages WSS signaling and real-time room orchestration using short-lived JWTs.")
    Component(Media_Telemetry_Exporter_Component, "Media Telemetry Exporter Component", "Prometheus scrape protocol", "Exports session quality metrics for real-time telemetry.")
}

Rel(Adaptive_Bitrate___Transcoding_Controller_Component, SFU_Media_Router_Component, "Dynamic media layer adjustments", "Internal IPC / gRPC")
Rel(Media_Telemetry_Exporter_Component, Core_Telehealth_Backend, "HTTP Prometheus scrape protocol for session quality metrics", "HTTP")
@enduml