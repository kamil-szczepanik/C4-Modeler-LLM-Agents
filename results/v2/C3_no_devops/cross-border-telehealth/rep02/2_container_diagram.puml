@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients_EU_US, "Patients (EU/US)", "Patients located in the EU and US seeking video consultations, e-prescriptions, and AI symptom checking.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Licensed medical professionals providing video consultations and managing patient treatments.")
Person(Pharmacies_EU_US, "Pharmacies (EU/US)", "Regional pharmacies fulfilling e-prescriptions for patients.")
Person(Compliance_Officers, "Compliance Officers", "Officers responsible for overseeing regulatory traceability, GDPR, and HIPAA compliance.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(Web_Mobile_Client_Containers, "Web & Mobile Client Containers", "Flutter / React Native with offline-first caching", "Client applications for web and mobile platforms used by patients and clinicians.")
    Container(API_Gateway, "API Gateway", "Cloud Endpoints / Apigee", "Manages, routes, and secures incoming traffic to the microservices.")
    Container(Core_Telehealth_Backend, "Core Telehealth Backend", "Node.js / Go in GKE", "Handles core business logic for video consultations, e-prescriptions, and platform operations.")
    Container(Patient_Consent_Preference_Service_Container, "Patient Consent & Preference Service Container", "Go in GKE", "Manages patient consent and preference data under strict regional isolation.")
    Container(Video_Streaming_Gateway, "Video Streaming Gateway", "WebRTC SFU / MediaSoup on GCE/GKE", "Handles real-time video streaming for consultations.")
    Container(AI_Inference_Wrapper_Service, "AI Inference Wrapper Service", "Python / FastAPI", "Provides AI symptom checker inference capabilities.")
    ContainerDb(Cloud_SQL_PostgreSQL_and_Cloud_Storage, "Cloud SQL (PostgreSQL) and Cloud Storage", "GCP Cloud SQL (PostgreSQL), Cloud Storage with Cloud KMS", "Regionally isolated relational databases and object storage with CMEK encryption.")
}

Rel(Patients_EU_US, Web_Mobile_Client_Containers, "Accesses telehealth services, video consultations, and AI symptom checker", "HTTPS, WebRTC")
Rel(Licensed_Clinicians, Web_Mobile_Client_Containers, "Manages consultations, patient treatments, and e-prescriptions", "HTTPS, WebRTC")
Rel(Web_Mobile_Client_Containers, API_Gateway, "Sends API requests and queries", "HTTPS/gRPC via mTLS")
Rel(Web_Mobile_Client_Containers, Video_Streaming_Gateway, "Streams live video consultations", "WebRTC media streams with SRTP/DTLS (E2EE)")
Rel(API_Gateway, Core_Telehealth_Backend, "Routes authenticated requests to core microservices", "gRPC over mTLS with cryptographically signed JWTs")
Rel(API_Gateway, Patient_Consent_Preference_Service_Container, "Queries and updates patient consent and preferences", "gRPC over mTLS with cryptographically signed JWTs")
Rel(API_Gateway, AI_Inference_Wrapper_Service, "Sends requests for AI symptom analysis", "gRPC over mTLS with cryptographically signed JWTs")
Rel(Core_Telehealth_Backend, Cloud_SQL_PostgreSQL_and_Cloud_Storage, "Reads and writes core application data and files securely", "Regional GCP Cloud SQL and Cloud Storage using CMEK via Cloud KMS")
Rel(Patient_Consent_Preference_Service_Container, Cloud_SQL_PostgreSQL_and_Cloud_Storage, "Persists patient consent and preference records securely", "Regional GCP Cloud SQL and Cloud Storage using CMEK via Cloud KMS")
Rel(AI_Inference_Wrapper_Service, Cloud_SQL_PostgreSQL_and_Cloud_Storage, "Accesses data and audit logs securely", "Regional GCP Cloud SQL and Cloud Storage using CMEK via Cloud KMS")

@enduml