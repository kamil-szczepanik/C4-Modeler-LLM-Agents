@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients and Licensed Clinicians, "Patients and Licensed Clinicians", "System users who conduct video consultations, manage e-prescriptions, and use the platform for telehealth services.")

System(Cross-Border Telehealth Platform, "Cross-Border Telehealth Platform", "Provides secure video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and US, enforcing strict regional data residency and compliance.")

System_Ext(Local Pharmacies and EU National E-Prescription Networks, "Local Pharmacies and EU National E-Prescription Networks", "External systems for processing and dispensing prescriptions across the EU and US.")

System_Ext(Third-party Video Provider, "Third-party Video Provider", "External system providing low-bandwidth WebRTC video consultations.")

System_Ext(AI Symptom Checker Model Registry, "AI Symptom Checker Model Registry", "External system hosting the AI symptom checker models.")

System_Ext(Identity Verification Services and Regional Payment Gateways, "Identity Verification Services and Regional Payment Gateways", "External services for user identity verification and processing payments.")

Rel(Patients and Licensed Clinicians, Cross-Border Telehealth Platform, "Interact with the Platform for video consultations, e-prescriptions, and symptom checking", "HTTPS and WebSockets (WebRTC)")
Rel(Cross-Border Telehealth Platform, Local Pharmacies and EU National E-Prescription Networks, "Communicates prescription data and interoperability standards", "HL7 FHIR over HTTPS, REST/SOAP over HTTPS")
Rel(Cross-Border Telehealth Platform, Third-party Video Provider, "Streams video consultations", "WebRTC")
Rel(Cross-Border Telehealth Platform, AI Symptom Checker Model Registry, "Accesses AI symptom checker models", "gRPC/HTTPS")
Rel(Cross-Border Telehealth Platform, Identity Verification Services and Regional Payment Gateways, "Verifies user identities and processes regional payments", "HTTPS/REST")

@enduml