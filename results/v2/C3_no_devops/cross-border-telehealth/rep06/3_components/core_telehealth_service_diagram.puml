@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Telehealth Service container

Component(RegionalAPI_Gateways, "Regional API Gateways", "Google Cloud Platform", "Routes API requests via gRPC over mTLS.")
Component_Ext(IdentityVerification_RegionalPaymentGateways, "Identity Verification & Regional Payment Gateways", "External Systems", "External gateways for identity and payments.")

Container_Boundary(CoreTelehealthService, "Core Telehealth Service") {
    Component(SessionConsentManager, "Session & Consent Manager", "Go", "Handles business logic, session management, and features a Consent Evaluation Engine for strict data residency enforcement.")
    Component(IntegrationAntiCorruptionLayer, "Integration Anti-Corruption Layer", "Go", "Manages integration boundaries and communicates with external Identity Verification and Regional Payment Gateways.")
    Component(EventDispatcher, "Event Dispatcher", "Go", "Publishes asynchronous domain events.")
    Component(IdempotentSyncCoordinator, "Idempotent Sync Coordinator", "Go", "Coordinates secure synchronization and offline resilience for cross-border telemedicine.")
    ComponentDb(CloudSQLforPostgreSQL, "Cloud SQL for PostgreSQL", "Cloud SQL for PostgreSQL", "Provides persistent regional relational data storage.")
    ComponentDb(MemorystoreforRedis, "Memorystore for Redis", "Memorystore for Redis", "Caches transient state for the core service.")
    Component(GoogleCloudPubSub, "Google Cloud Pub/Sub", "Google Cloud Pub/Sub", "Enables asynchronous, decoupled event-driven messaging.")
}

Rel(RegionalAPI_Gateways, SessionConsentManager, "Routes API requests via gRPC over mTLS", "gRPC / mTLS")
Rel(EventDispatcher, GoogleCloudPubSub, "Publishes asynchronous domain events", "Cloud Pub/Sub API")
Rel(SessionConsentManager, CloudSQLforPostgreSQL, "Reads/writes relational data", "PostgreSQL Protocol")
Rel(IdempotentSyncCoordinator, MemorystoreforRedis, "Caches transient state", "Redis Protocol")
Rel(IntegrationAntiCorruptionLayer, IdentityVerification_RegionalPaymentGateways, "Communicates with circuit breakers", "HTTPS / REST")

@enduml