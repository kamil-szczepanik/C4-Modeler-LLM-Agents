@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(CoreTelehealthService, "Core Telehealth Service", "External service interacting with the session cache")
System_Ext(RegionalAPIGateways, "Regional API Gateways", "External gateways interacting with the rate limiter")
System_Ext(CloudKMS, "Cloud KMS", "Provides encryption-at-rest keys")

Container_Boundary(MemorystoreForRedis, "Memorystore for Redis") {
    Component(SessionCacheStore, "Session Cache Store", "Google Cloud Memorystore for Redis (Redis OSS)", "Caches user tokens and WebRTC signaling state via RESP over TLS 1.3.")
    Component(RateLimiterTransientStore, "Rate Limiter & Transient Store", "Google Cloud Memorystore for Redis (Redis OSS)", "Evaluates sliding-window rate limits via RESP over TLS 1.3.")
}

Rel(CoreTelehealthService, SessionCacheStore, "Caches user tokens and WebRTC signaling state", "RESP over TLS 1.3")
Rel(RegionalAPIGateways, RateLimiterTransientStore, "Evaluates sliding-window rate limits", "RESP over TLS 1.3")
Rel(SessionCacheStore, CloudKMS, "Applies region-aligned encryption-at-rest keys within europe-west3 and us-central1", "API")
Rel(RateLimiterTransientStore, CloudKMS, "Applies region-aligned encryption-at-rest keys within europe-west3 and us-central1", "API")

@enduml