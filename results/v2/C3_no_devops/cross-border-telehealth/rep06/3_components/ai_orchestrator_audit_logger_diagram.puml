@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Orchestrator & Audit Logger container

System_Ext(RegionalAPIGateways, "Regional API Gateways", "Google Cloud API Gateway in europe-west3 and us-central1")
System_Ext(GoogleCloudPubSub, "Google Cloud Pub/Sub", "Asynchronous event streaming service")
System_Ext(AISymptomCheckerModelRegistry, "AI Symptom Checker Model Registry", "Model storage and registry")

Container_Boundary(AIOrchestratorAuditLogger, "AI Orchestrator & Audit Logger") {
    Component(AIGatewayRouter, "AI Gateway Router", "Python / FastAPI", "Routes AI symptom checks and audit requests.")
    Component(ModelExecutionEngine, "Model Execution Engine", "PyTorch / ONNX Runtime", "Executes localized regional AI symptom checker models efficiently.")
    Component(AuditLoggerInterceptor, "Audit Logger Interceptor", "Python / gRPC Interceptor", "Interprets and intercepts calls for audit logging.")
    Component(ImmutableLedgerWriter, "Immutable Ledger Writer", "Python / Google Cloud Storage & PostgreSQL Client", "Writes audit events to persistent storage securely.")
    Component(ClinicianFeedbackCollector, "Clinician Feedback Collector", "Python / FastAPI", "Collects doctor validation inputs.")
    Component(TelemetryMetricsPublisher, "Telemetry & Metrics Publisher", "OpenTelemetry SDK", "Publishes telemetry and metrics.")
}

Rel(RegionalAPIGateways, AIGatewayRouter, "Routes AI symptom checks", "gRPC over mTLS")
Rel(RegionalAPIGateways, ClinicianFeedbackCollector, "Routes doctor validation inputs", "gRPC over mTLS")
Rel(AIGatewayRouter, ModelExecutionEngine, "Invokes model execution for symptom checks", "gRPC / HTTPS")
Rel(AuditLoggerInterceptor, ImmutableLedgerWriter, "Passes audit events for persistence", "Internal")
Rel(AIOrchestratorAuditLogger, GoogleCloudPubSub, "Publishes signed audit events asynchronously", "Cloud Pub/Sub API over mTLS")
Rel(AIOrchestratorAuditLogger, AISymptomCheckerModelRegistry, "Accesses and loads models", "gRPC / HTTPS")

@enduml