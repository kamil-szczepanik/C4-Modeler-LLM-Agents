@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(RegionalAPI_Gateways, "Regional API Gateways", "Google Cloud API Gateways deployed in europe-west3 (EU) and us-central1 (US).")
System_Ext(SQLite_IndexedDB, "SQLite & IndexedDB", "Encrypted local storage for offline caching on mobile and web clients.")

Container_Boundary(Web_Application___Mobile_Apps, "Web Application & Mobile Apps") {
    Component(Consent___Profile, "Consent & Profile", "Flutter/React", "Manages user consent and profile information.")
    Component(Adaptive_Video_Streaming, "Adaptive Video Streaming", "WebRTC & VP8/H.264", "Provides adaptive, low-bandwidth video streaming with audio-only fallback.")
    Component(Triage___AI_Interface, "Triage & AI Interface", "Flutter/React", "Interfaces with the AI symptom checker and triage workflows.")
    Component(Offline_Cache_Manager, "Offline Cache Manager", "SQLite & IndexedDB", "Handles encrypted local storage for offline caching on mobile and web clients.")
    Component(Localization___Regulatory_Banner, "Localization & Regulatory Banner", "Flutter/React", "Displays localization elements and regulatory compliance banners.")
    Component(Routing___Regional_Affinity, "Routing & Regional Affinity", "Flutter/React", "Handles routing and regional affinity for cross-border operations.")
}

Rel(Consent___Profile, RegionalAPI_Gateways, "Sends client requests and syncs state", "HTTPS and WSS with SSL/TLS certificate pinning")
Rel(Adaptive_Video_Streaming, RegionalAPI_Gateways, "Sends client requests and syncs state", "HTTPS and WSS with SSL/TLS certificate pinning")
Rel(Triage___AI_Interface, RegionalAPI_Gateways, "Sends client requests and syncs state", "HTTPS and WSS with SSL/TLS certificate pinning")
Rel(Offline_Cache_Manager, SQLite_IndexedDB, "Reads and writes", "Encrypted local data")
Rel(Localization___Regulatory_Banner, RegionalAPI_Gateways, "Sends client requests and syncs state", "HTTPS and WSS with SSL/TLS certificate pinning")
Rel(Routing___Regional_Affinity, RegionalAPI_Gateways, "Sends client requests and syncs state", "HTTPS and WSS with SSL/TLS certificate pinning")

@enduml