@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Video Mediation Service", "Video Mediation Service") {
    Component("Session Signaling Controller", "Session Signaling Controller", "Go / WebSockets", "Initiates call setup, routes cryptographically signed JWTs, and persists ephemeral signaling state.")
    Component("Bandwidth Adaptation Engine", "Bandwidth Adaptation Engine", "Go", "Dynamically adjusts streams and prioritizes audio to guarantee continuous care under unstable network conditions.")
    Component("Telemetry & Audit Collector", "Telemetry & Audit Collector", "Go", "Streams scrubbed session quality metrics and compliance logs.")
    Component("Media Quality Policy Enforcer", "Media Quality Policy Enforcer", "Go", "Enforces media quality policies and dynamically adjusts video/audio streams.")
}

SystemDb_Ext("Memorystore for Redis", "Memorystore for Redis", "Regional caching for ephemeral session tokens and state management.")
System_Ext("Third-Party Video Provider", "Third-Party Video Provider", "External video infrastructure handling WebRTC media streams.")
System_Ext("Google Cloud Pub/Sub", "Google Cloud Pub/Sub", "Asynchronous telemetry and audit log streaming.")

Rel("Session Signaling Controller", "Memorystore for Redis", "Persists ephemeral signaling state and session tokens", "Redis Protocol")
Rel("Bandwidth Adaptation Engine", "Third-Party Video Provider", "Dynamically adjusts streams and prioritizes audio", "WebRTC / SRTP / DTLS")
Rel("Media Quality Policy Enforcer", "Third-Party Video Provider", "Enforces media quality policies on streams", "WebRTC / SRTP / DTLS")
Rel("Telemetry & Audit Collector", "Google Cloud Pub/Sub", "Streams scrubbed session quality metrics and compliance logs", "gRPC")

@enduml