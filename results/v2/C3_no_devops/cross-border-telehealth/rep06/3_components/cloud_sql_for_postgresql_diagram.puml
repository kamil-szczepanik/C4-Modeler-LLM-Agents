@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Cloud SQL for PostgreSQL container

Container_Boundary(cloud_sql_for_postgresql, "Cloud SQL for PostgreSQL") {
    Component(Core Data Schema, "Core Data Schema", "PostgreSQL Database Schema", "Stores core relational data for patients, clinicians, and telehealth workflows.")
    Component(Consent Ledger Schema, "Consent Ledger Schema", "PostgreSQL Database Schema", "Tracks regional user data consent and privacy compliance records.")
    Component(AI Audit Log Schema, "AI Audit Log Schema", "PostgreSQL Database Schema", "Stores audit logs and symptom-checker inputs generated by the AI Orchestrator.")
}

Rel(Core Data Schema, Consent Ledger Schema, "Maintains relational integrity with")
Rel(AI Audit Log Schema, Core Data Schema, "Relates audit tracking to")

@enduml