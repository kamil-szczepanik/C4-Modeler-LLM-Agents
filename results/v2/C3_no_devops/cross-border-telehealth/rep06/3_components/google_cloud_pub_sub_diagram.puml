@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Core Telehealth Service, "Core Telehealth Service", "Go / Spring Boot")
Person(E-Prescription Integrator, "E-Prescription Integrator", "Node.js")
Person(AI Orchestrator & Audit Logger, "AI Orchestrator & Audit Logger", "Python")

Container_Boundary(google_cloud_pub_sub, "Google Cloud Pub/Sub") {
    Component(Schema Validation Engine, "Schema Validation Engine", "Google Cloud Pub/Sub Schema Registry / Protocol Buffers", "Validates asynchronous event payloads to enforce structured, compliant data.")
    Component(EU Pub/Sub Instance, "EU Pub/Sub Instance", "Google Cloud Pub/Sub (europe-west3)", "Manages asynchronous messaging and enforces strict GDPR data residency for EU patients.")
    Component(US Pub/Sub Instance, "US Pub/Sub Instance", "Google Cloud Pub/Sub (us-central1)", "Manages asynchronous messaging and enforces HIPAA data residency for US patients.")
}

Rel(Core Telehealth Service, Schema Validation Engine, "Publishes asynchronous domain events", "Cloud Pub/Sub API / gRPC")
Rel(E-Prescription Integrator, Schema Validation Engine, "Publishes e-prescription events", "Cloud Pub/Sub API / gRPC")
Rel(AI Orchestrator & Audit Logger, Schema Validation Engine, "Publishes AI and audit events", "Cloud Pub/Sub API / gRPC")

@enduml