@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "Patients utilizing the platform for video consultations, e-prescriptions, and AI symptom checking.")
Person(LicensedClinicians, "Licensed Clinicians", "Healthcare professionals conducting consultations and managing patient treatments.")
Person(PlatformAdministrators, "Platform Administrators", "Administrators managing platform operations and settings.")
Person(PharmacyComplianceAuditors, "Pharmacy/Compliance Auditors", "Auditors reviewing system compliance and prescription flows.")

System_Ext(LocalPharmacies, "Local Pharmacies", "External systems for processing and dispensing prescriptions.")
System_Ext(EUNationalEPrescriptionNetworks, "EU National E-Prescription Networks", "External systems handling cross-border e-prescriptions within the EU.")
System_Ext(ThirdPartyVideoProvider, "Third-Party Video Provider", "External video provider supporting WebRTC video consultations.")
System_Ext(AISymptomCheckerModelRegistry, "AI Symptom Checker Model Registry", "External registry hosting the AI symptom checker models.")
System_Ext(IdentityVerification, "Identity Verification", "External services for verifying user identities.")
System_Ext(RegionalPaymentGateways, "Regional Payment Gateways", "External services for processing payments regionally.")

System_Boundary(CrossBorderTelehealthPlatform, "Cross-Border Telehealth Platform") {
    Container(WebAppMobileApps, "Web Application & Mobile Apps", "Flutter / React", "Client applications providing multi-platform access for users.")
    Container(RegionalAPIGateways, "Regional API Gateways", "Google Cloud API Gateway (europe-west3, us-central1)", "Gateways routing and handling regional API traffic and data residency enforcement.")
    Container(CoreTelehealthService, "Core Telehealth Service", "Go / Spring Boot", "Core backend service handling telehealth business logic.")
    Container(VideoMediationService, "Video Mediation Service", "Twilio / WebRTC", "Service managing real-time video and audio consultations.")
    Container(EPrescriptionIntegrator, "E-Prescription Integrator", "Node.js", "Service integrating with local pharmacies and national e-prescription networks.")
    Container(AIOrchestratorAuditLogger, "AI Orchestrator & Audit Logger", "Python", "Service orchestrating AI symptom checker models and maintaining immutable audit logs.")
    Container(GoogleCloudPubSub, "Google Cloud Pub/Sub", "Google Cloud Pub/Sub", "Messaging system for asynchronous event publishing across services.")
    ContainerDb(CloudSQLforPostgreSQL, "Cloud SQL for PostgreSQL", "PostgreSQL", "Relational database storing structured system and user data.")
    ContainerDb(MemorystoreforRedis, "Memorystore for Redis", "Redis", "In-memory data store for caching and state management.")
}

Rel(Patients, WebAppMobileApps, "Accesses telehealth services, video consultations, and AI symptom checker", "HTTPS and WSS")
Rel(LicensedClinicians, WebAppMobileApps, "Manages consultations, patients, and e-prescriptions", "HTTPS and WSS")
Rel(PlatformAdministrators, WebAppMobileApps, "Administers platform configurations and oversight", "HTTPS")
Rel(PharmacyComplianceAuditors, WebAppMobileApps, "Audits logs and compliance data", "HTTPS")

Rel(WebAppMobileApps, RegionalAPIGateways, "Sends client requests and receives data", "HTTPS and WSS")
Rel(RegionalAPIGateways, CoreTelehealthService, "Routes API requests", "gRPC over mTLS")
Rel(RegionalAPIGateways, VideoMediationService, "Mediates video sessions", "HTTPS / WebRTC")
Rel(RegionalAPIGateways, EPrescriptionIntegrator, "Routes prescription-related requests", "gRPC over mTLS")
Rel(RegionalAPIGateways, AIOrchestratorAuditLogger, "Routes AI symptom checks and audit requests", "gRPC over mTLS")

Rel(CoreTelehealthService, GoogleCloudPubSub, "Publishes asynchronous domain events", "Cloud Pub/Sub API")
Rel(EPrescriptionIntegrator, GoogleCloudPubSub, "Publishes e-prescription events", "Cloud Pub/Sub API")
Rel(AIOrchestratorAuditLogger, GoogleCloudPubSub, "Publishes AI and audit events", "Cloud Pub/Sub API")

Rel(CoreTelehealthService, CloudSQLforPostgreSQL, "Reads and writes relational data", "PostgreSQL Protocol")
Rel(CoreTelehealthService, MemorystoreforRedis, "Caches session and transient state data", "Redis Protocol")

Rel(VideoMediationService, ThirdPartyVideoProvider, "Streams video consultations", "WebRTC")
Rel(EPrescriptionIntegrator, LocalPharmacies, "Transmits prescription data", "HL7 FHIR / REST / SOAP over HTTPS")
Rel(EPrescriptionIntegrator, EUNationalEPrescriptionNetworks, "Interoperates with national e-prescription standards", "HL7 FHIR / REST / SOAP over HTTPS")
Rel(AIOrchestratorAuditLogger, AISymptomCheckerModelRegistry, "Accesses and loads AI symptom checker models", "gRPC / HTTPS")
Rel(CoreTelehealthService, IdentityVerification, "Verifies user identities during registration/login", "HTTPS / REST")
Rel(CoreTelehealthService, RegionalPaymentGateways, "Processes consultation and service payments", "HTTPS / REST")

@enduml