@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "Patients accessing secure video consultations, e-prescriptions, and the AI symptom checker.")
Person(Clinicians, "Licensed Clinicians", "Medical professionals conducting consultations.")
Person(Officers, "Compliance Officers", "Officers ensuring regulatory compliance.")

System_Ext(EUGateways, "EU National E-Prescription Gateways", "National gateways for e-prescriptions across the EU.")
System_Ext(USPharmacies, "US Pharmacy Networks", "Pharmacy networks in the US utilizing HL7 FHIR APIs.")
System_Ext(TURN, "TURN Infrastructure", "Infrastructure supporting video media streaming for telehealth sessions.")

System_Boundary(TelehealthSystem, "Cross-Border Telehealth Platform") {
    Container(ClientApps, "Client Apps", "Flutter / Web application", "Cross-platform client application for patients, clinicians, and compliance officers.")
    Container(ApiGateway, "API Gateway", "Google Cloud API Gateway / Envoy", "Manages and routes incoming client traffic to internal microservices securely.")
    Container(CoreService, "Core Telehealth Service", "Node.js / Go container", "Handles core telehealth business logic, consultations, and operations.")
    Container(AiService, "AI Symptom Checker Container", "Python / FastAPI", "Provides AI-driven symptom checking capabilities for patients.")
    Container(ConsentService, "Patient Consent Service", "Node.js / Go container", "Manages patient consent and regional regulatory data residency compliance.")
    Container(PharmacyGateway, "Pharmacy Integration Gateway", "Go / Apache Camel container", "Integrates with external e-prescription gateways and US pharmacy networks.")
    Container(VideoServer, "Video Media Server", "LiveKit / WebRTC SFU", "Handles real-time video streaming and WebRTC sessions for consultations.")
    ContainerDb(DataStorage, "Data Storage", "Google Cloud SQL (PostgreSQL with FHIR extensions)", "Regional isolated databases storing patient records and health data.")
}

Rel(Patients, ClientApps, "Accesses telehealth services, video consultations, and symptom checker", "HTTPS / WebSockets")
Rel(Clinicians, ClientApps, "Conducts video consultations and manages care", "HTTPS / WebSockets")
Rel(Officers, ClientApps, "Monitors compliance and consent management", "HTTPS / WebSockets")

Rel(ClientApps, ApiGateway, "Sends API requests and data", "HTTPS / WebSockets")
Rel(ClientApps, VideoServer, "Streams video during consultations", "WebRTC (SRTP with DTLS-SRTP)")

Rel(ApiGateway, CoreService, "Routes internal service requests", "gRPC (internal service-to-service with mTLS)")
Rel(ApiGateway, AiService, "Routes symptom check requests", "gRPC (internal service-to-service with mTLS)")
Rel(ApiGateway, ConsentService, "Routes consent and compliance queries", "gRPC (internal service-to-service with mTLS)")
Rel(ApiGateway, PharmacyGateway, "Routes e-prescription requests", "gRPC (internal service-to-service with mTLS)")

Rel(CoreService, DataStorage, "Reads and writes consultation data", "Encrypted SQL connections")
Rel(ConsentService, DataStorage, "Reads and writes consent records", "Encrypted SQL connections")

Rel(PharmacyGateway, EUGateways, "Submits e-prescriptions", "mTLS over HTTPS")
Rel(PharmacyGateway, USPharmacies, "Submits e-prescriptions", "mTLS over HTTPS")

Rel(VideoServer, TURN, "Relays video media over unstable connections", "WebRTC / TURN")

@enduml