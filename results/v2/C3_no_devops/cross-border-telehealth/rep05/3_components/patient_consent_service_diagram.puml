@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(patient_consent_service, "Patient Consent Service") {
    Component(ConsentAPIController, "Consent API Controller", "Go", "Manages granular, purpose-based data sharing consents for cross-border telehealth operations.")
    Component(ConsentEvaluationEngine, "Consent Evaluation Engine", "Go", "Evaluates policies for low-latency consent decisions.")
    Component(AuditLedgerWriter, "Audit & Ledger Writer", "Go", "Triggers async audit events and writes immutable logs for compliance.")
    Component(CacheInvalidationEventDispatcher, "Cache Invalidation & Event Dispatcher", "Go", "Publishes and subscribes to revocation events.")
    Component(LedgerStorageAdapter, "Ledger Storage Adapter", "Go", "Interfaces with storage to write immutable audit logs.")
    Component(RedisCache, "Redis Cache", "Redis (In-memory storage)", "Provides in-memory lookups to eliminate database round-trips.")
    Component(GCPPubSub, "GCP Pub/Sub", "GCP Pub/Sub", "Messaging service for distributed cache invalidation and revocation event broadcasting.")
    Component(GoogleCloudStorage, "Google Cloud Storage", "Google Cloud Storage (WORM Object Storage)", "Guarantees tamper-proof compliance audit logging.")
}

Rel(ConsentAPIController, ConsentEvaluationEngine, "Evaluates policies", "In-process Go function calls")
Rel(ConsentEvaluationEngine, RedisCache, "Reads/writes cached consent states", "RESP protocol over TLS")
Rel(RedisCache, ConsentEvaluationEngine, "Reads/writes cached consent states", "RESP protocol over TLS")
Rel(ConsentAPIController, AuditLedgerWriter, "Triggers async audit events", "Go channels")
Rel(AuditLedgerWriter, LedgerStorageAdapter, "Writes immutable logs", "HTTPS / Storage API")
Rel(CacheInvalidationEventDispatcher, GCPPubSub, "Publishes/subscribes to revocation events", "gRPC")
@enduml