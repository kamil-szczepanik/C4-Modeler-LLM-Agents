@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(pharmacy_integration_gateway, "Pharmacy Integration Gateway") {
    Component(Prescription_Orchestrator, "Prescription Orchestrator", "Go", "Orchestrates e-prescription workflows and manages internal routing using in-memory Go channels.")
    Component(Adapter_Engine, "Adapter Engine", "Go / Apache Camel", "Handles protocol mapping and submits e-prescriptions to external EU and US networks.")
    Component(Status_Audit_Publisher, "Status & Audit Publisher", "Go / Apache Camel", "Publishes event-driven status delivery acknowledgments to GCP Pub/Sub.")
    ComponentDb(Regional_State_Store, "Regional State Store", "Google Cloud Memorystore for Redis", "Reads and writes idempotency state with strict TTLs over TLS via internal VPC.")
}

Rel(Prescription_Orchestrator, Adapter_Engine, "Internal routing", "In-memory Go channels")
Rel(Prescription_Orchestrator, Regional_State_Store, "Read/Write idempotency state", "Redis Protocol over TLS via internal VPC")
Rel(Adapter_Engine, Status_Audit_Publisher, "Triggers status updates upon external prescription submission", "Internal event")
@enduml