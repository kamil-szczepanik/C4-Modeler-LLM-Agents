@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(PatientsClinicians, "Patients & Clinicians", "Users accessing telehealth services")
System_Ext(VideoMediaServer, "Video Media Server", "LiveKit WebRTC SFU for real-time video")
System_Ext(GoogleCloudAPIGateway, "Google Cloud API Gateway", "Secure entry point for backend APIs")

Container_Boundary(ClientApps, "Client Apps") {
    Component(OfflineSyncLocalStorage, "Offline Sync & Local Storage", "SQLite with SQLCipher", "Encrypts local data at rest using AES-256 bound to Secure Enclave/Keystore for offline caching on mobile devices.")
    Component(VideoAdaptation, "Video Adaptation", "LiveKit SDK", "WebRTC client library for dynamic bitrate scaling, real-time video streaming, and degraded-mode audio fallback.")
    Component(APIClientRegionRouter, "API Client & Region Router", "Flutter / Web", "Communicates securely with the API Gateway via HTTPS with SSL/Certificate Pinning and mTLS, ensuring regional routing.")
    Component(ConsentStateManagement, "Consent & State Management", "Bloc / Provider", "State management pattern for enforcing consent-gated local execution across the client application.")
    Component(LocalTelemetryAuditLogger, "Local Telemetry & Audit Logger", "Flutter / Web", "Logs local telemetry and audit events while ensuring strict regulatory compliance and tamper-evident tracking.")
}

Rel(PatientsClinicians, ClientApps, "Accesses telehealth services and consultations", "HTTPS / WebSockets")
Rel(OfflineSyncLocalStorage, OfflineSyncLocalStorage, "Encrypts local data at rest", "AES-256 bound to Secure Enclave/Keystore")
Rel(VideoAdaptation, VideoMediaServer, "Streams real-time video", "WebRTC (SRTP with DTLS-SRTP)")
Rel(APIClientRegionRouter, GoogleCloudAPIGateway, "Communicates securely", "HTTPS with SSL/Certificate Pinning and mTLS")

@enduml