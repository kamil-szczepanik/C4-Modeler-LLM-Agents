@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Storage container

Person(Core_Telehealth_Service, "Core Telehealth Service", "External service interacting with data storage")
Person(Patient_Consent_Service, "Patient Consent Service", "External service interacting with data storage")
Person(AI_Symptom_Checker_Container, "AI Symptom Checker Container", "External service interacting with data storage")

Container_Boundary(data_storage, "Data Storage") {
    Component(Google_Cloud_SQL_PostgreSQL_EU, "Google Cloud SQL PostgreSQL EU", "PostgreSQL with FHIR extensions", "Regional isolated database deployed in europe-west3 for EU data residency, clinical records, and consent data.")
    Component(Google_Cloud_SQL_PostgreSQL_US, "Google Cloud SQL PostgreSQL US", "PostgreSQL with FHIR extensions", "Regional isolated database deployed in us-central1 for US data residency, clinical records, and consent data.")
    Component(Google_Memorystore_for_Redis, "Google Memorystore for Redis", "Redis", "Regional caching tier providing low-latency session and consent state retrieval during consultations.")
    Component(GCP_Cloud_Storage, "GCP Cloud Storage", "Cloud Storage with Object Versioning", "Stores immutable WORM audit logs of inputs and model versions.")
}

Rel(Core_Telehealth_Service, Google_Cloud_SQL_PostgreSQL_EU, "Reads and writes clinical and consent data", "Cloud SQL Auth Proxy [Encrypted SQL]")
Rel(Patient_Consent_Service, Google_Cloud_SQL_PostgreSQL_EU, "Reads and writes clinical and consent data", "Cloud SQL Auth Proxy [Encrypted SQL]")
Rel(Core_Telehealth_Service, Google_Cloud_SQL_PostgreSQL_US, "Reads and writes clinical and consent data", "Cloud SQL Auth Proxy [Encrypted SQL]")
Rel(Patient_Consent_Service, Google_Cloud_SQL_PostgreSQL_US, "Reads and writes clinical and consent data", "Cloud SQL Auth Proxy [Encrypted SQL]")
Rel(Core_Telehealth_Service, Google_Memorystore_for_Redis, "Caches session and consent states", "RESP protocol, TLS")
Rel(Patient_Consent_Service, Google_Memorystore_for_Redis, "Caches session and consent states", "RESP protocol, TLS")
Rel(AI_Symptom_Checker_Container, GCP_Cloud_Storage, "Writes immutable audit logs of inputs and model versions", "gRPC / HTTPS")

@enduml