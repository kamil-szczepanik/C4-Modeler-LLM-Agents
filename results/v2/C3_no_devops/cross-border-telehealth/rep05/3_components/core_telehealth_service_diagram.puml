@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(core_telehealth_service, "Core Telehealth Service") {
    Component(Consultation_Manager, "Consultation Manager", "Go", "Manages video consultations and coordinates session flows.")
    Component(Prescription_Coordinator, "Prescription Coordinator", "Go", "Handles e-prescriptions and routes data to external pharmacy gateways.")
    Component(Consent_Verifier, "Consent Verifier", "Go", "Verifies patient consent against privacy regulations before treatment.")
    Component(Telemetry_Adaptation_Engine, "Telemetry & Adaptation Engine", "Go", "Monitors connection quality and adapts streaming for low-bandwidth environments.")
}

Rel(Consultation_Manager, Consent_Verifier, "Verifies patient consent via gRPC with mTLS", "gRPC / mTLS")
Rel(Consultation_Manager, Telemetry_Adaptation_Engine, "Tracks telemetry and network adaptation", "Internal")
Rel(Prescription_Coordinator, Consent_Verifier, "Validates consent before prescription generation", "gRPC / mTLS")

@enduml