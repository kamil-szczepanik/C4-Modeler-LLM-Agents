@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Video Media Server container

System_Ext(Core_Telehealth_Service, "Core Telehealth Service", "Core telehealth business logic and service.")
System_Ext(TURN_Infrastructure, "TURN Infrastructure", "Third-Party Video Relay")
System_Ext(Regional_Cloud_Storage, "Regional Cloud Storage", "GCP Cloud Storage with Cloud KMS CMEK")

Container_Boundary(Video_Media_Server, "Video Media Server") {
    Component(Media_Ingestion_Routing_Component, "Media Ingestion & Routing Component", "LiveKit SFU Router (Go/Rust)", "Powers real-time WebRTC media routing and simulcast handling for low-bandwidth optimization.")
    Component(ABR_Controller, "ABR Controller", "Adaptive Bitrate Control", "Triggers simulcast layer switching on bandwidth drops.")
    Component(Egress_Recording_Worker, "Egress Recording Worker", "Node.js/FFmpeg", "Powers secure media composition and writes encrypted media chunks.")
    Component(Session_Telemetry_Publisher, "Session Telemetry Publisher", "gRPC", "Forwards real-time session health stats to the core service.")
}

Rel(Media_Ingestion_Routing_Component, ABR_Controller, "Triggers simulcast layer switching on bandwidth drops", "Internal gRPC/Channels")
Rel(Session_Telemetry_Publisher, Core_Telehealth_Service, "Forwards real-time session health stats", "gRPC")
Rel(Media_Ingestion_Routing_Component, TURN_Infrastructure, "Relays media over unstable connections", "WebRTC / TURN-TLS")
Rel(Egress_Recording_Worker, Regional_Cloud_Storage, "Writes encrypted media chunks", "HTTPS/TLS 1.3")

@enduml