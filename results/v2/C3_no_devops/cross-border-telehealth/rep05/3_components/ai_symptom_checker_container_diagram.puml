@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("AI Symptom Checker Container", "AI Symptom Checker Container") {
    Component("API Router / Controller", "API Router / Controller", "Python / FastAPI", "Exposes endpoints and handles request routing for the symptom checker.")
    Component("Consent & Scope Validator", "Consent & Scope Validator", "Python / Middleware", "Middleware that validates patient consent and API scopes.")
    Component("Triage Engine", "Triage Engine", "Python/PyTorch or LangChain", "AI inference engine performing symptom-to-urgency assessments.")
    Component("Audit & Traceability Logger", "Audit & Traceability Logger", "Python / Asynchronous Logger", "Captures model inputs, versions, outputs, and clinician overrides.")
}

Rel("Consent & Scope Validator", "API Router / Controller", "Forwards validated requests", "Internal function call")
Rel("API Router / Controller", "Triage Engine", "Initiates urgency assessment", "In-memory function call")
Rel("Triage Engine", "Audit & Traceability Logger", "Captures model inputs, versions, and outputs", "Asynchronous event")

@enduml