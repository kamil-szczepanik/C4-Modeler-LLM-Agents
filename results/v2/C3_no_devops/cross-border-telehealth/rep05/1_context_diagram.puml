@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "Patients accessing secure video consultations, e-prescriptions, and the AI symptom checker via Web/Mobile Clients.")
Person(Licensed_Clinicians_and_Compliance_Officers, "Licensed Clinicians and Compliance Officers", "Medical professionals conducting consultations and officers ensuring regulatory compliance.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides secure video consultations, e-prescriptions, and an AI symptom checker for patients across the EU and US, ensuring strict regional data residency and regulatory compliance.")

System_Ext(EU_National_E_Prescription_Gateways, "EU National E-Prescription Gateways", "National gateways for e-prescriptions across the EU.")
System_Ext(US_Pharmacy_Networks, "US Pharmacy Networks", "Pharmacy networks in the US utilizing HL7 FHIR APIs.")
System_Ext(Third_Party_Video_Relay_TURN_Infrastructure, "Third-Party Video Relay/TURN Infrastructure", "Infrastructure supporting video media streaming for telehealth sessions.")

Rel(Patients, Cross_Border_Telehealth_Platform, "Interacts with the platform for consultations and symptom checking", "HTTPS/TLS 1.3")
Rel(Licensed_Clinicians_and_Compliance_Officers, Cross_Border_Telehealth_Platform, "Interacts with the platform to provide care and manage compliance", "HTTPS/TLS 1.3")
Rel(Cross_Border_Telehealth_Platform, EU_National_E_Prescription_Gateways, "Connects to EU national gateways for e-prescriptions", "SOAP/REST with mTLS")
Rel(Cross_Border_Telehealth_Platform, US_Pharmacy_Networks, "Connects to US pharmacy networks", "HL7 FHIR REST APIs with mTLS")
Rel(Cross_Border_Telehealth_Platform, Third_Party_Video_Relay_TURN_Infrastructure, "Streams video media during consultations", "WebRTC with DTLS-SRTP over UDP/TCP")

@enduml