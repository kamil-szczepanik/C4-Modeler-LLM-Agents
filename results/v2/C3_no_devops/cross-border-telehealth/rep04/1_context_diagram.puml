@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_EU_US, "Patients (EU/US)", "Utilize video care, e-prescriptions, and the AI symptom checker.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Conduct secure cross-border video consultations.")
Person(Local_Pharmacies, "Local Pharmacies", "Receive national-standard e-prescriptions.")
Person(Compliance_Regulatory_Officers_External_Regulatory_Auditors, "Compliance / Regulatory Officers & External Regulatory Auditors", "Access audit logs for accountability.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and US while ensuring strict cross-border regional data isolation and compliance with GDPR, HIPAA, and EU MDR.")

System_Ext(Third_Party_AI_Model_Provider, "Third-Party AI Model Provider", "External service for symptom checking via HTTPS/REST.")
System_Ext(National_EPrescription_Gateways_Pharmacy_Networks, "National E-Prescription Gateways / Pharmacy Networks", "External systems using mTLS APIs.")

Rel(Patients_EU_US, Cross_Border_Telehealth_Platform, "Use video care, e-prescriptions, and AI symptom checker", "HTTPS / WebRTC")
Rel(Licensed_Clinicians, Cross_Border_Telehealth_Platform, "Conduct secure cross-border video consultations", "HTTPS / WebRTC")
Rel(Cross_Border_Telehealth_Platform, Third_Party_AI_Model_Provider, "Sends pseudonymized payloads for AI symptom checking", "HTTPS/REST")
Rel(Cross_Border_Telehealth_Platform, National_EPrescription_Gateways_Pharmacy_Networks, "Sends national-standard e-prescriptions", "mTLS APIs using HL7 FHIR and national standards")
Rel(Compliance_Regulatory_Officers_External_Regulatory_Auditors, Cross_Border_Telehealth_Platform, "Access audit logs for accountability", "HTTPS/SFTP")

@enduml