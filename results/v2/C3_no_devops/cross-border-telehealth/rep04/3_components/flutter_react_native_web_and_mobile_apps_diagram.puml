@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Flutter/React Native Web and Mobile Apps container

Container_Boundary(flutter_container, "Flutter/React Native Web and Mobile Apps") {
    Component(Region_Compliance_Gateway_Client, "Region & Compliance Gateway Client", "Flutter / React Native Module", "Handles regional routing, data residency enforcement, and GDPR/HIPAA compliance validation on the client side.")
    Component(Offline_Resilience_Store, "Offline Resilience Store", "SQLite / MMKV with SQLCipher AES-256", "Secures local data caching backed by Android Keystore and iOS Keychain for low-bandwidth rural environments.")
    Component(WebRTC_Media_Client, "WebRTC Media Client", "WebRTC, SRTP, DTLS-SRTP", "Manages adaptive video streaming and real-time communication via ICE/TURN over UDP with TCP/TLS fallback.")
    Component(AI_MDR_Interaction_Module, "AI/MDR Interaction Module", "Flutter / React Native Module", "Interfaces with the AI symptom checker and supports EU MDR traceability requirements.")
    Component(State_Synchronizer_Component, "State Synchronizer Component", "Flutter / React Native Module", "Synchronizes local offline state with backend services when network connectivity is restored.")
}

System_Ext(Kong_API_Gateway_BFF, "Kong API Gateway/BFF", "API Gateway and Backend for Frontend")

Rel(Region_Compliance_Gateway_Client, Kong_API_Gateway_BFF, "Sends API requests and auth", "HTTPS / WebSockets with Certificate Pinning")
Rel(WebRTC_Media_Client, Kong_API_Gateway_BFF, "Streams adaptive video", "ICE/TURN over UDP with TCP/TLS fallback and SRTP/DTLS-SRTP")
Rel(State_Synchronizer_Component, Offline_Resilience_Store, "Reads and writes cached offline data securely", "SQLCipher AES-256")

@enduml