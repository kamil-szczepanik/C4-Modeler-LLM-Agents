@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Java Consent Management Service container

System_Ext(kong_api_gateway_bff, "Kong API Gateway/BFF", "External API Gateway")

Container_Boundary(java_consent_management_service, "Java Consent Management Service") {
    Component(consent_controller, "Consent Controller", "Spring MVC / gRPC", "Handles API requests and validates PASETO tokens and consents.")
    Component(consent_policy_engine, "Consent Policy Engine", "Spring Domain Logic", "Enforces granular, jurisdiction-aware consent policies.")
    Component(audit_cryptographic_proof_component, "Audit & Cryptographic Proof Component", "Spring Data JPA & Google Tink", "Generates tamper-evident audit trails and handles cryptographic operations.")
    Component(consent_rule_repository, "Consent Rule Repository", "Spring Cache / Redis", "Provides in-memory caching for sub-millisecond policy evaluations.")
    Component(gcp_cloud_sql_postgresql, "GCP Cloud SQL (PostgreSQL)", "PostgreSQL", "Stores encrypted audit metadata and consent records with row-level security.")
    Component(gcp_cloud_pub_sub, "GCP Cloud Pub/Sub", "Pub/Sub Protocol", "Broadcasts instant revocation events.")
    Component(gcp_cloud_kms, "GCP Cloud KMS", "Cloud KMS", "Manages cryptographic keys and token signing/verification.")
}

Rel(kong_api_gateway_bff, consent_controller, "Validates tokens and consents", "gRPC / Anthos Service Mesh (mTLS)")
Rel(consent_policy_engine, gcp_cloud_kms, "Signs and verifies cryptographic PASETO tokens", "gRPC / IAM")
Rel(consent_policy_engine, gcp_cloud_pub_sub, "Broadcasts instant revocation events", "gRPC / Pub/Sub Protocol")
Rel(audit_cryptographic_proof_component, gcp_cloud_sql_postgresql, "Stores encrypted audit metadata and consent records", "PostgreSQL Protocol with CMEK")

@enduml