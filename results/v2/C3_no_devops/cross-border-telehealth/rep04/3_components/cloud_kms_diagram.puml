@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Cloud KMS container

System_Ext(Spring Boot Core Telehealth Service, "Spring Boot Core Telehealth Service", "External telehealth service")
Person(Compliance / Regulatory Officers, "Compliance / Regulatory Officers", "Compliance and regulatory officers")

Container_Boundary(Cloud KMS, "Cloud KMS") {
    Component(Key Management Interface, "Key Management Interface", "REST/gRPC API", "Exposes endpoints for cryptographic operations like encryption and decryption.")
    Component(Regional Key Rings & CryptoKeys, "Regional Key Rings & CryptoKeys", "Cloud HSM / GCP Cryptographic Material (europe-west3-keyring, us-central1-keyring)", "Manages isolated regional cryptographic keys for EU and US data residency.")
    Component(IAM & Access Policy Enforcer, "IAM & Access Policy Enforcer", "GCP IAM", "Enforces the principle of least privilege and condition-based regional access policies.")
    Component(Audit Logging Emitter, "Audit Logging Emitter", "GCP Audit Logging", "Emits immutable audit logs to ensure regulatory compliance and accountability.")
    Component(Key Recovery & Rotation Manager, "Key Recovery & Rotation Manager", "Internal GCP control plane / MPA Console", "Handles emergency key restoration and scheduled rotation requests.")
}

Rel(Spring Boot Core Telehealth Service, Key Management Interface, "Encrypts/Decrypts PHI using CMEK", "gRPC/HTTPS")
Rel(Compliance / Regulatory Officers, Key Recovery & Rotation Manager, "Approves emergency key restoration or rotation requests", "GCP IAM/MPA Console/API")
Rel(Key Recovery & Rotation Manager, Regional Key Rings & CryptoKeys, "Rotates and restores cryptographic material", "Internal GCP control plane")
@enduml