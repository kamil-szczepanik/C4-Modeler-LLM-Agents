@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Node.js/Go Billing & Localization Container container

Container_Boundary(billing_container, "Node.js/Go Billing & Localization Container") {
    Component(api_router, "API Router / Handler Module", "Go", "High-throughput API routing and processing for billing and localization workflows.")
    Component(localization_engine, "Localization & Tax Engine", "Node.js", "Evaluates regional tax rules and manages localization workflows.")
    Component(payment_adapter, "Payment Gateway Integration Adapter", "Go", "Processes secure charges and executes cross-border multi-currency transactions.")
    Component(audit_exporter, "Billing Audit & Reconciliation Exporter", "Go", "Publishes transaction success/failure events and handles asynchronous event processing.")
}

Component(kong_gateway, "Kong API Gateway/BFF", "Kong API Gateway", "API Gateway and Backend for Frontend routing requests.")
ComponentDb(cloud_sql, "GCP Cloud SQL (PostgreSQL)", "GCP Cloud SQL (PostgreSQL)", "Region-pinned relational data persistence with CMEK encryption.")
Component(pub_sub, "GCP Cloud Pub/Sub", "GCP Cloud Pub/Sub", "Asynchronous event messaging for billing audit logs.")
Component(secret_manager, "GCP Secret Manager", "GCP Secret Manager", "Dynamic runtime injection of API keys and webhook secrets.")
Component(external_payments, "External Payment Providers", "Stripe, SEPA", "External systems for processing secure charges.")

Rel(kong_gateway, api_router, "Processes billing and localization workflows", "gRPC / Anthos Service Mesh (mTLS)")
Rel(localization_engine, payment_adapter, "Forwards calculated totals for transaction execution", "Internal Function Call / Channel")
Rel(payment_adapter, external_payments, "Processes secure charges", "HTTPS / REST with TLS 1.3")
Rel(payment_adapter, audit_exporter, "Publishes transaction success/failure events", "GCP Cloud Pub/Sub")
Rel(audit_exporter, cloud_sql, "Persists reconciled ledger data with CMEK", "PostgreSQL Protocol")

@enduml