@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(spring_boot_core_telehealth_service, "Spring Boot Core Telehealth Service") {
    Component(Telehealth_Controller, "Telehealth Controller", "Spring MVC / REST", "Exposes secure endpoints for telehealth consultations and video session management.")
    Component(Telehealth_Service, "Telehealth Service", "Java / Spring Boot", "Implements core enterprise workflows and business logic for telehealth operations.")
    Component(Security_Manager, "Security Manager", "Spring Security & OAuth2", "Enforces token-based authentication, role-based access control, and mTLS verification.")
}

Rel(Telehealth_Controller, Security_Manager, "Validates incoming requests via OAuth2")
Rel(Telehealth_Controller, Telehealth_Service, "Delegates business logic execution")
@enduml