@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the GCP Cloud SQL (PostgreSQL) container

Container_Boundary(cloud_sql_container, "GCP Cloud SQL (PostgreSQL)") {
    Component(EU_Regional_Database_Instance, "EU Regional Database Instance", "PostgreSQL v15+ with GCP Cloud SQL", "Stores isolated relational health, consent, e-prescription, and billing data for EU patients in compliance with GDPR.")
    Component(US_Regional_Database_Instance, "US Regional Database Instance", "PostgreSQL v15+ with GCP Cloud SQL", "Stores isolated relational health, consent, e-prescription, and billing data for US patients in compliance with HIPAA.")
    Component(PgBouncer_Connection_Pooler, "PgBouncer Connection Pooler", "PgBouncer", "Manages and optimizes ephemeral microservice connections to the regional PostgreSQL instances.")
    Component(Audit_Logging_Extension, "Audit Logging Extension", "PostgreSQL pgaudit Extension", "Provides detailed logging of DDL and DML operations for PHI/PII regulatory compliance.")
}

System_Ext(Spring_Boot_Core_Telehealth_Service, "Spring Boot Core Telehealth Service", "Core telehealth microservice")
System_Ext(FastAPI_AI_Symptom_Checker, "FastAPI AI Symptom Checker", "AI symptom checker service")
System_Ext(Node_js_E_Prescription_Service, "Node.js E-Prescription Service", "E-prescription management service")
System_Ext(Java_Consent_Management_Service, "Java Consent Management Service", "Consent management service")
System_Ext(Node_js_Go_Billing_Localization_Container, "Node.js/Go Billing & Localization Container", "Billing and localization service")

Rel(Spring_Boot_Core_Telehealth_Service, EU_Regional_Database_Instance, "Reads/writes relational health data", "PostgreSQL Protocol with CMEK, TLS 1.3")
Rel(Spring_Boot_Core_Telehealth_Service, US_Regional_Database_Instance, "Reads/writes relational health data", "PostgreSQL Protocol with CMEK, TLS 1.3")
Rel(FastAPI_AI_Symptom_Checker, EU_Regional_Database_Instance, "Persists AI recommendations and inputs", "PostgreSQL Protocol with TLS 1.3, CMEK")
Rel(FastAPI_AI_Symptom_Checker, US_Regional_Database_Instance, "Persists AI recommendations and inputs", "PostgreSQL Protocol with TLS 1.3, CMEK")
Rel(Node_js_E_Prescription_Service, EU_Regional_Database_Instance, "Persists e-prescription audit trails", "PostgreSQL Protocol with TLS 1.3, Cloud SQL IAM Auth")
Rel(Node_js_E_Prescription_Service, US_Regional_Database_Instance, "Persists e-prescription audit trails", "PostgreSQL Protocol with TLS 1.3, Cloud SQL IAM Auth")
Rel(Java_Consent_Management_Service, EU_Regional_Database_Instance, "Stores consent records and audit metadata", "PostgreSQL Protocol with CMEK")
Rel(Java_Consent_Management_Service, US_Regional_Database_Instance, "Stores consent records and audit metadata", "PostgreSQL Protocol with CMEK")
Rel(Node_js_Go_Billing_Localization_Container, EU_Regional_Database_Instance, "Persists billing and regional configs", "PostgreSQL Protocol with CMEK")
Rel(Node_js_Go_Billing_Localization_Container, US_Regional_Database_Instance, "Persists billing and regional configs", "PostgreSQL Protocol with CMEK")

@enduml