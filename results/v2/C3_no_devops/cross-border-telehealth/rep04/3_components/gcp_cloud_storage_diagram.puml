@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the GCP Cloud Storage container

Container_Boundary(gcp_cloud_storage, "GCP Cloud Storage") {
    Component(Object_Storage_Engine, "Object Storage Engine", "GCP Cloud Storage (Regional Buckets: telehealth-eu-bucket in europe-west3, telehealth-us-bucket in us-central1)", "Object storage for medical assets, utilizing regional bucket isolation for data residency.")
    Component(CMEK_Encryption_Manager, "CMEK Encryption Manager", "GCP Cloud KMS (Key Rings)", "Customer-Managed Encryption Keys (CMEK) for region-locked encryption and crypto-shredding.")
    Component(Lifecycle_Purging_Hook, "Lifecycle & Purging Hook", "GCS Lifecycle API", "Manages object lifecycle and data purging according to retention policies.")
    Component(Resilient_Upload_Download_Manager, "Resilient Upload/Download Manager", "GCS Resumable Uploads & Signed URLs", "Enables fault-tolerant media transfers for unstable rural connections.")
}

Rel(Resilient_Upload_Download_Manager, CMEK_Encryption_Manager, "Internal GCP IPC", "")
Rel(CMEK_Encryption_Manager, Object_Storage_Engine, "Internal GCP IPC", "")
Rel(Lifecycle_Purging_Hook, Object_Storage_Engine, "GCS Lifecycle API", "")

@enduml