@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(gcp_cloud_pub_sub, "GCP Cloud Pub/Sub") {
    Component(Regional Pub/Sub Topics & Subscriptions, "Regional Pub/Sub Topics & Subscriptions", "GCP Cloud Pub/Sub", "Asynchronous messaging backbone for decoupled, at-least-once event processing across regions.")
    Component(Cloud KMS Encryption Engine, "Cloud KMS Encryption Engine", "Cloud KMS", "Customer-Managed Encryption Keys (CMEK) and 90-day rotation for regional envelope encryption.")
    Component(Dead Letter Queues, "Dead Letter Queues", "GCP Cloud Pub/Sub DLQ", "Routes undeliverable events via internal GCP routing to ensure reliable delivery.")
    Component(Schema Registry, "Schema Registry", "GCP Pub/Sub Schema Registry", "Validates event payloads prior to publishing via gRPC, TLS 1.3.")
    Component(IAM Policy Enforcement Engine, "IAM Policy Enforcement Engine", "GCP IAM", "Role-based access control and strict regional service account segregation, authorizing subscriber pulls.")
}

Rel(Regional Pub/Sub Topics & Subscriptions, Dead Letter Queues, "Routes undeliverable events via internal GCP routing", "")
Rel(Regional Pub/Sub Topics & Subscriptions, IAM Policy Enforcement Engine, "Authorizes subscriber pulls via GCP IAM API", "")
@enduml