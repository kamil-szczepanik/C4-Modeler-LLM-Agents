@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Kong API Gateway/BFF container

Container_Boundary(kong_api_gateway_bff, "Kong API Gateway/BFF") {
    Component(Geo_Routing, "Geo-Routing", "Kong Plugin / Edge Routing", "Enforces strict regional data residency by routing EU and US requests to appropriate regional endpoints.")
    Component(JWT_OIDC_Interceptor, "JWT/OIDC Interceptor", "Kong Security Plugin / OAuth2/OIDC", "Validates incoming tokens, OAuth2 credentials, and DPoP headers from client applications.")
    Component(Payload_Compression, "Payload Compression", "Kong Optimization Plugin", "Optimizes payload sizes to ensure reliable telehealth access for rural patients with unstable connections.")
    Component(Header_Enrichment, "Header Enrichment", "Kong Transformation Plugin", "Injects and enriches request headers for downstream internal services.")
}

System(Spring_Boot_Core_Telehealth_Service, "Spring Boot Core Telehealth Service", "Core telehealth service implementation")
System(FastAPI_AI_Symptom_Checker, "FastAPI AI Symptom Checker", "AI symptom checker service")
System(Node_js_E_Prescription_Service, "Node.js E-Prescription Service", "E-prescription management service")
System(Java_Consent_Management_Service, "Java Consent Management Service", "Consent and token validation service")
System(Node_js_Go_Billing_Localization_Container, "Node.js/Go Billing & Localization Container", "Billing and localization service")

Rel(Geo_Routing, JWT_OIDC_Interceptor, "Passes routed requests for authentication", "HTTPS")
Rel(JWT_OIDC_Interceptor, Payload_Compression, "Forwards authenticated requests for optimization", "Internal")
Rel(Payload_Compression, Header_Enrichment, "Passes optimized payloads for header injection", "Internal")
Rel(Header_Enrichment, Spring_Boot_Core_Telehealth_Service, "Routes core telehealth requests", "gRPC / mTLS via Anthos Service Mesh")
Rel(Header_Enrichment, FastAPI_AI_Symptom_Checker, "Routes symptom check requests", "gRPC / mTLS via Anthos Service Mesh")
Rel(Header_Enrichment, Node_js_E_Prescription_Service, "Routes e-prescription requests", "gRPC / mTLS via Anthos Service Mesh")
Rel(Header_Enrichment, Java_Consent_Management_Service, "Validates consent and tokens", "gRPC / mTLS via Anthos Service Mesh")
Rel(Header_Enrichment, Node_js_Go_Billing_Localization_Container, "Forwards localized requests", "gRPC / mTLS via Anthos Service Mesh")

@enduml