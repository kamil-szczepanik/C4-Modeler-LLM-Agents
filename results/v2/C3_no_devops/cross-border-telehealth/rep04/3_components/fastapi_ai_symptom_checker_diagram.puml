@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(kong_api_gateway_bff, "Kong API Gateway/BFF", "External Gateway")
System_Ext(third_party_ai_model_provider, "Third-Party AI Model Provider", "External AI Service")
System_Ext(gcp_cloud_pub_sub, "GCP Cloud Pub/Sub", "External Messaging Service")

Container_Boundary(fastapi_ai_symptom_checker, "FastAPI AI Symptom Checker") {
    Component(api_router_controller, "API Router / Controller", "Python 3.11+, FastAPI, gRPC", "Handles incoming gRPC requests using protocol buffers.")
    Component(consent_region_enforcer_middleware, "Consent & Region Enforcer Middleware", "Python 3.11+, FastAPI Middleware", "Validates data residency headers and consent tokens.")
    Component(inference_orchestrator, "Inference Orchestrator", "Python 3.11+", "Manages calls to the Third-Party AI Model Provider and validates response integrity.")
    Component(audit_logger_component, "Audit Logger Component", "Python 3.11+, GCP Cloud KMS", "Asynchronously writes signed immutable audit trails to GCP Cloud Pub/Sub.")
    Component(guardrail_localization_interceptor, "Guardrail & Localization Interceptor", "Python 3.11+", "Appends localized clinical disclaimers and urgency-based calls-to-action.")
}

Rel(kong_api_gateway_bff, api_router_controller, "Routes symptom check requests via gRPC over mTLS using Anthos Service Mesh.", "gRPC / mTLS")
Rel(inference_orchestrator, third_party_ai_model_provider, "Transmits sanitized payloads over TLS 1.3 with payload encryption.", "TLS 1.3")
Rel(audit_logger_component, gcp_cloud_pub_sub, "Publishes cryptographically signed audit logs asynchronously.", "Async / PubSub")

@enduml