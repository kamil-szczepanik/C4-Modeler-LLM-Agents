@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients_EU_US, "Patients (EU/US)", "Utilize video care, e-prescriptions, and the AI symptom checker.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Conduct secure cross-border video consultations.")
Person(Local_Pharmacies, "Local Pharmacies", "Receive national-standard e-prescriptions.")
Person(Regulators, "Regulators", "Access audit logs and ensure compliance.")
Person(System_Administrators, "System Administrators", "Manage system infrastructure and operations.")
Person(Caregivers_Guardians, "Caregivers/Guardians", "Assist patients with platform access and care.")

System_Ext(National_EPrescription_Gateways_and_Pharmacy_Networks, "National E-Prescription Gateways and Pharmacy Networks", "External systems for e-prescription delivery using national standards.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(Flutter_React_Native_Web_and_Mobile_Apps, "Flutter/React Native Web and Mobile Apps", "Flutter / React Native", "Client applications for patients, clinicians, and administrators.")
    Container(Kong_API_Gateway_BFF, "Kong API Gateway/BFF", "Kong API Gateway", "Acts as the Backend-for-Frontend and API Gateway routing requests.")
    Container(Spring_Boot_Core_Telehealth_Service, "Spring Boot Core Telehealth Service", "Java, Spring Boot", "Handles core telehealth workflows, video consultations, and business logic.")
    Container(FastAPI_AI_Symptom_Checker, "FastAPI AI Symptom Checker", "Python, FastAPI", "Provides AI symptom checking capabilities.")
    Container(Node_js_E_Prescription_Service, "Node.js E-Prescription Service", "Node.js", "Manages e-prescription creation and routing.")
    Container(Java_Consent_Management_Service, "Java Consent Management Service", "Java", "Enforces privacy consents and signed PASETO/JWT token validation.")
    Container(Node_js_Go_Billing_Localization_Container, "Node.js/Go Billing & Localization Container", "Node.js / Go", "Handles billing, payments, and regional localization logic.")
    ContainerDb(GCP_Cloud_SQL_PostgreSQL, "GCP Cloud SQL (PostgreSQL)", "PostgreSQL, GCP Cloud SQL", "Relational database providing regional data storage.")
    Container(GCP_Cloud_Storage, "GCP Cloud Storage", "GCP Cloud Storage", "Object storage for unstructured medical and media data.")
    Container(GCP_Cloud_Pub_Sub, "GCP Cloud Pub/Sub", "GCP Cloud Pub/Sub", "Messaging backbone for cross-service asynchronous events.")
    Container(Cloud_KMS, "Cloud KMS", "GCP Cloud KMS", "Manages encryption keys with CMEK for data protection.")
}

Rel(Patients_EU_US, Flutter_React_Native_Web_and_Mobile_Apps, "Interacts with the telehealth platform via web and mobile apps", "HTTPS / WebSockets (TLS 1.3)")
Rel(Licensed_Clinicians, Flutter_React_Native_Web_and_Mobile_Apps, "Conducts consultations and manages patient care", "HTTPS / WebSockets (TLS 1.3)")
Rel(System_Administrators, Flutter_React_Native_Web_and_Mobile_Apps, "Manages platform configurations and infrastructure", "HTTPS / WebSockets (TLS 1.3)")
Rel(Caregivers_Guardians, Flutter_React_Native_Web_and_Mobile_Apps, "Supports patient access and interactions", "HTTPS / WebSockets (TLS 1.3)")

Rel(Flutter_React_Native_Web_and_Mobile_Apps, Kong_API_Gateway_BFF, "Sends API requests and handles authentication", "HTTPS / WebSockets with OAuth2/OIDC")

Rel(Kong_API_Gateway_BFF, Spring_Boot_Core_Telehealth_Service, "Routes core telehealth requests securely", "gRPC / Anthos Service Mesh (mTLS)")
Rel(Kong_API_Gateway_BFF, FastAPI_AI_Symptom_Checker, "Routes symptom check requests", "gRPC / Anthos Service Mesh (mTLS)")
Rel(Kong_API_Gateway_BFF, Node_js_E_Prescription_Service, "Routes e-prescription requests", "gRPC / Anthos Service Mesh (mTLS)")
Rel(Kong_API_Gateway_BFF, Java_Consent_Management_Service, "Validates consent and tokens", "gRPC / Anthos Service Mesh (mTLS)")
Rel(Kong_API_Gateway_BFF, Node_js_Go_Billing_Localization_Container, "Processes billing and localization workflows", "gRPC / Anthos Service Mesh (mTLS)")

Rel(Spring_Boot_Core_Telehealth_Service, GCP_Cloud_SQL_PostgreSQL, "Reads and writes relational health data", "PostgreSQL Protocol with CMEK")
Rel(Spring_Boot_Core_Telehealth_Service, GCP_Cloud_Storage, "Stores clinical documents and media", "HTTPS / GCP API with CMEK")
Rel(Spring_Boot_Core_Telehealth_Service, GCP_Cloud_Pub_Sub, "Publishes and consumes cross-service events", "GCP Pub/Sub API with payload encryption")
Rel(Spring_Boot_Core_Telehealth_Service, Cloud_KMS, "Encrypts and decrypts sensitive data fields using CMEK", "Cloud KMS API")

Rel(Node_js_E_Prescription_Service, National_EPrescription_Gateways_and_Pharmacy_Networks, "Transmits e-prescriptions externally", "HL7 FHIR and national standards over mTLS")
Rel(Node_js_E_Prescription_Service, GCP_Cloud_Pub_Sub, "Publishes prescription events", "GCP Pub/Sub API")

Rel(Java_Consent_Management_Service, GCP_Cloud_SQL_PostgreSQL, "Stores consent records and audit metadata", "PostgreSQL Protocol with CMEK")
Rel(Node_js_Go_Billing_Localization_Container, GCP_Cloud_SQL_PostgreSQL, "Persists billing and regional configurations", "PostgreSQL Protocol with CMEK")

@enduml