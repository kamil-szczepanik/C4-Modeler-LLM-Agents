@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalyst, "Fraud Analyst & Risk/Compliance Officer", "Internal users who access the secure case management interface for fraud review and compliance tasks.")
Person(Users, "Users", "Enterprise users authenticating via Identity Provider.")

System_Ext(PaymentProcessorSystems, "Payment Processor Systems", "External API Consumer sending card-not-present authorizations.")
System_Ext(IdentityProvider, "Identity Provider", "AWS IAM / OIDC providing Enterprise SSO and hardware-token MFA.")
System_Ext(ModelRegistry, "Model Registry / Feature Store", "AWS SageMaker / S3 with AWS Signer providing dynamic rule and model fetching.")
System_Ext(ImmutableAuditStorage, "Immutable Audit Storage", "AWS S3 Object Lock with AWS KMS CMK providing WORM-compliant decision logging.")

System(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System", "Processes card-not-present authorizations for a mid-size payment processor to detect fraud in real time while providing a secure case management interface for analysts.")

Rel(PaymentProcessorSystems, RealTimePaymentFraudScreeningSystem, "Synchronous authorization scoring at 3,000 TPS", "HTTPS / gRPC")
Rel(FraudAnalyst, RealTimePaymentFraudScreeningSystem, "Secure browser access for case management and review", "HTTPS")
Rel(RealTimePaymentFraudScreeningSystem, ModelRegistry, "Zero-downtime dynamic rule and model fetching", "HTTPS / S3 API")
Rel(RealTimePaymentFraudScreeningSystem, ImmutableAuditStorage, "WORM-compliant decision logging", "AWS SDK / S3 API")
Rel(Users, IdentityProvider, "Enterprise SSO and hardware-token MFA", "HTTPS / OpenID Connect")
@enduml