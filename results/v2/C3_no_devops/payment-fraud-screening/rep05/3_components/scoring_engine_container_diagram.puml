@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Scoring Engine Container container

Container_Boundary("Scoring Engine Container", "Scoring Engine Container") {
    Component("Wasm Execution Runtime", "Wasm Execution Runtime", "Rust, WebAssembly", "Executes cryptographically verified Wasm rules and scoring models with zero downtime.")
    Component("Feature Fetcher", "Feature Fetcher", "Rust, TLS-encrypted TCP", "Retrieves real-time transaction features from Amazon ElastiCache Redis.")
    Component("Audit Dispatcher", "Audit Dispatcher", "Rust, HTTPS/REST", "Asynchronously flushes signed decision and explainability payloads to immutable audit storage.")
}

Rel("Wasm Execution Runtime", "Feature Fetcher", "Requests transaction features", "TLS-encrypted TCP/Redis")
Rel("Wasm Execution Runtime", "Audit Dispatcher", "Sends signed decision payloads for async persistence", "HTTPS/REST")

@enduml