@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management Backend container

Person(CaseManagementUI, "Case Management UI", "Frontend Application", "Sends API requests for case operations.")
System_Ext(IdentityProvider, "Identity Provider", "External IAM Service", "Validates JWTs and enforces RBAC.")
System_Ext(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL", "Managed Relational Database with AES-256 encryption", "Reads and writes case state and search indexes.")
System_Ext(ImmutableAuditStorage, "Immutable Audit Storage", "Secure Storage Target", "Writes signed analyst action logs.")

Container_Boundary(CaseManagementBackend, "Case Management Backend") {
    Component(APIRouterController, "API Router / Controller", "NestJS Controller (TypeScript)", "Handles REST requests and JWT validation.")
    Component(CaseService, "Case Service", "NestJS Service (TypeScript)", "Implements case lifecycle logic, bulk actions, and SLA-based routing.")
    Component(SLAWorkerSchedulerComponent, "SLA Worker / Scheduler Component", "NestJS Scheduler (@nestjs/schedule)", "Manages background timers and auto-escalations.")
    Component(AuditLoggerComponent, "Audit Logger Component", "NestJS Component (TypeScript)", "Records cryptographically signed analyst actions.")
    Component(DataAccessLayer, "Data Access Layer", "ORM (TypeScript)", "Utilizes an ORM to manage relational data.")
}

Rel(CaseManagementUI, APIRouterController, "Sends API requests for case operations", "HTTPS/REST, TLS 1.3")
Rel(APIRouterController, IdentityProvider, "Validates JWTs and enforces RBAC", "HTTPS/REST")
Rel(CaseService, AmazonAuroraPostgreSQL, "Reads and writes case state and search indexes", "TCP/TLS, Port 5432")
Rel(AuditLoggerComponent, ImmutableAuditStorage, "Writes signed analyst action logs", "HTTPS/REST")

@enduml