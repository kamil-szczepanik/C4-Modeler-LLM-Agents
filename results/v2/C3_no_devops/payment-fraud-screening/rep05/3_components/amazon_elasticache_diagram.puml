@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon ElastiCache container

System_Ext(scoring_engine, "Scoring Engine Container", "Go/Rust service running on AWS ECS Fargate.")
System_Ext(model_registry, "Model Registry / Feature Store", "External system supplying scoring models and features.")
System_Ext(cloudwatch, "AWS CloudWatch & SNS", "Monitoring and alerting infrastructure.")

Container_Boundary(elasticache_boundary, "Amazon ElastiCache") {
    Component(in_memory_feature_store, "In-Memory Feature Store", "Redis OSS, cache.m6g.large, volatile-lru", "Stores features in-memory for sub-millisecond retrieval to meet P99 latency requirements and controls memory usage.")
    Component(security_module, "Security & Encryption Module", "TLS 1.3, Redis AUTH, AWS KMS", "Enforces data-in-transit security via TLS and Redis AUTH tokens, and encrypts data at rest using AWS KMS for PCI-DSS Level 1 compliance.")
    Component(telemetry_emitter, "Telemetry & Logging Emitter", "AWS CloudWatch", "Emits performance metrics and slow logs to monitor cluster health and operational performance.")
}

Rel(scoring_engine, in_memory_feature_store, "Performs feature lookups", "TCP/Redis with TLS 1.3 and Redis AUTH tokens")
Rel(model_registry, in_memory_feature_store, "Synchronizes features", "asynchronous worker over TCP/Redis")
Rel(in_memory_feature_store, cloudwatch, "Emits performance metrics and slow logs", "")
@enduml