@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Rule & Model Distribution Service container

System_Ext(Model Registry, "Model Registry", "External system storing models")
System_Ext(Amazon S3, "Amazon S3", "Object storage for signed artifacts")
System_Ext(Scoring Engine Container, "Scoring Engine Container", "Scoring engine container for fraud detection")

Container_Boundary(Rule_Model_Distribution_Service, "Rule & Model Distribution Service") {
    Component(Model Validation & Compilation Worker, "Model Validation & Compilation Worker", "Python/Pydantic", "Validates and compiles models due to strong typing and schema enforcement, and stores signed artifacts in Amazon S3.")
    Component(Distribution Coordinator, "Distribution Coordinator", "Go", "Triggers hot-reloading in the scoring engine container for high performance and low resource consumption.")
    Component(Distribution API, "Distribution API", "REST/JSON", "Receives publish requests from the Model Registry.")
}

Rel(Model Validation & Compilation Worker, Amazon S3, "Stores signed artifacts", "HTTPS/TLS")
Rel(Distribution Coordinator, Scoring Engine Container, "Triggers hot-reloading", "gRPC/AWS SQS")
Rel(Distribution API, Model Registry, "Receives publish requests", "REST/JSON")

@enduml