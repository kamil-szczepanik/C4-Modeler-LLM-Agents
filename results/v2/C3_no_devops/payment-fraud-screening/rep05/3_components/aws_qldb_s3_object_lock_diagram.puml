@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS QLDB / S3 Object Lock container

Person(RiskComplianceOfficersFraudAnalysts, "Risk & Compliance Officers / Fraud Analysts", "External User Persona", "Accesses audit logs and compliance reports for verification.")

Container_Boundary(AWSQLDBS3ObjectLock, "AWS QLDB / S3 Object Lock") {
    Component(AuditIngestionService, "Audit Ingestion Service", "AWS Lambda (Go)", "Receives batched decision logs, storing structured metadata in QLDB and raw payloads in S3.")
    Component(QLDBJournalLedger, "QLDB Journal Ledger", "Amazon QLDB", "Stores structured decision metadata, model versions, and cryptographic inclusion proofs.")
    Component(S3ComplianceVault, "S3 Compliance Vault", "Amazon S3 with Object Lock (Compliance Mode)", "Stores raw payload inputs with WORM enforcement and lifecycle rules.")
    Component(AWSKMS, "AWS KMS", "AWS KMS", "Manages Customer Managed Keys (CMKs) for data encryption at rest.")
}

Rel(AuditIngestionService, QLDBJournalLedger, "Stores structured journal entries", "QLDB Driver (DQL/PartiQL)")
Rel(AuditIngestionService, S3ComplianceVault, "Stores raw payloads", "AWS SDK (HTTPS) over AWS PrivateLink")
Rel(AuditIngestionService, AWSKMS, "Encrypts and decrypts data", "AWS SDK (HTTPS)")
Rel(RiskComplianceOfficersFraudAnalysts, QLDBJournalLedger, "Executes cryptographic verification", "AWS Console / AWS SDK (HTTPS)")
Rel(RiskComplianceOfficersFraudAnalysts, S3ComplianceVault, "Executes compliance audits", "AWS Console / AWS SDK (HTTPS)")

@enduml