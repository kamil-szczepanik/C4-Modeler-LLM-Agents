@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS API Gateway / Envoy container

Container_Boundary(aws_api_gateway_envoy, "AWS API Gateway / Envoy") {
    Component(Edge_Router_Ingestion_Handler, "Edge Router & Ingestion Handler", "AWS API Gateway / Envoy Proxy", "Handles high-throughput secure edge routing, TLS termination, and ingress traffic validation.")
    Component(Wasm_Tokenization_Engine, "Wasm Tokenization Engine", "WebAssembly (Wasm)", "Tokenizes sensitive payment card data and strips PII before internal routing for PCI-DSS compliance.")
}

System_Ext(Scoring_Engine_Container, "Scoring Engine Container", "Go/Rust on AWS ECS Fargate")

Rel(Edge_Router_Ingestion_Handler, Wasm_Tokenization_Engine, "Inspects and tokenizes incoming payment authorizations", "Wasm Filter")
Rel(Wasm_Tokenization_Engine, Scoring_Engine_Container, "Routes tokenized scoring requests", "gRPC over internal VPC mTLS")

@enduml