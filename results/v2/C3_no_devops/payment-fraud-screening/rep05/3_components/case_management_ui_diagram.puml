@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Fraud Analysts, "Fraud Analysts", "Accesses secure case management interface")
System_Ext(External Identity Provider, "External Identity Provider", "Handles authentication and identity services")
System_Ext(Case Management Backend, "Case Management Backend", "Provides backend services and REST APIs")

Container_Boundary(Case_Management_UI, "Case Management UI") {
    Component(Routing_Auth_Controller_Component, "Routing & Auth Controller Component", "React Router", "Handles client-side routing and OIDC/JWT session validation.")
    Component(Case_Workspace_Component, "Case Workspace Component", "React / TanStack Table", "Renders high-performance risk queues and case workspaces.")
    Component(Audit_Explainability_View_Component, "Audit & Explainability View Component", "D3.js / Tailwind CSS", "Visualizes model explainability data and feature attributions.")
    Component(Queue_Analytics_Filtering_Engine_Component, "Queue Analytics & Filtering Engine Component", "React Context / Zustand", "Manages client-side queue sorting, SLA timers, and risk prioritization state.")
}

Rel(Fraud Analysts, Routing_Auth_Controller_Component, "Accesses secure case management interface", "HTTPS")
Rel(Routing_Auth_Controller_Component, External Identity Provider, "Validates OIDC/JWT session tokens", "HTTPS")
Rel(Case_Workspace_Component, Case_Management_Backend, "Sends API requests for operations and data", "HTTPS/REST JSON")
Rel(Audit_Explainability_View_Component, Case_Management_Backend, "Sends API requests for operations and data", "HTTPS/REST JSON")
Rel(Case_Workspace_Component, Queue_Analytics_Filtering_Engine_Component, "Queries client-side risk queues", "In-memory")

@enduml