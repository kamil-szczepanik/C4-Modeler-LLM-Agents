@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management App container

Container_Boundary(case_management_app, "Case Management App") {
    Component(api_router_auth_middleware, "API Router & Auth Middleware", "Node.js / Express", "Routes incoming requests and handles authentication middleware.")
    Component(case_business_logic_component, "Case Business Logic Component", "Node.js", "Executes business logic for case management and fraud review workflows.")
    Component(analyst_spa_frontend, "Analyst SPA Frontend", "React", "Provides the analyst SPA frontend and productivity dashboard.")
}

System_Ext(amazon_aurora_postgresql, "Amazon Aurora PostgreSQL", "Persists case and transaction data [TLS/SQL]")
System_Ext(audit_ledger, "Audit Ledger", "Sends signed analyst actions [HTTPS / signed requests]")
System_Ext(amazon_sqs, "Amazon SQS", "Offloads asynchronous SLA checks and notifications [AWS SDK / TLS]")

Rel(analyst_spa_frontend, api_router_auth_middleware, "Transmits API requests", "HTTPS/REST")
Rel(api_router_auth_middleware, case_business_logic_component, "Forwards validated requests", "In-memory / REST")
Rel(case_business_logic_component, amazon_aurora_postgresql, "Persists case and transaction data", "TLS/SQL")
Rel(case_business_logic_component, audit_ledger, "Sends signed analyst actions", "HTTPS / signed requests")
Rel(case_business_logic_component, amazon_sqs, "Offloads asynchronous SLA checks and notifications", "AWS SDK / TLS")

@enduml