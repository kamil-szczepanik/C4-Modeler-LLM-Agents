@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_alb, "API Gateway / Application Load Balancer") {
    Component(alb_waf, "AWS Application Load Balancer (ALB) with AWS WAF and AWS Shield", "AWS ALB, AWS WAF, AWS Shield", "Provides low-latency, cost-effective edge routing, DDoS protection, and edge request sanitization.")
    Component(listener_tls, "Listener & TLS Terminator Component", "AWS ALB Listener, TLS 1.3", "Terminates TLS connections and handles incoming secure traffic.")
    Component(path_routing, "Path-Based Routing Router Component", "AWS ALB Routing Rules", "Routes traffic based on request paths to appropriate downstream services.")
    Component(auth_filter, "Authentication/Authorization Filter Component", "OAuth2 / OIDC, IdP Integration", "Authenticates and authorizes incoming requests.")
    Component(rate_limiting, "Rate Limiting & Throttling Filter Component", "AWS WAF Rate-based Rules", "Protects against overload and enforces rate limits.")
    Component(telemetry_injector, "Telemetry & Tracing Injector Component", "OpenTelemetry, AWS CloudWatch", "Injects tracing headers and streams access logs and metrics.")
    Component(edge_sanitization, "Edge Request Sanitization Component", "AWS WAF Schema Validation", "Ensures edge request sanitization and schema validation for PCI-DSS Level 1 compliance.")
}

Rel(listener_tls, path_routing, "Passes decrypted requests")
Rel(path_routing, auth_filter, "Forwards requests for validation")
Rel(auth_filter, rate_limiting, "Forwards authenticated requests")
Rel(rate_limiting, edge_sanitization, "Forwards throttled requests for inspection")
Rel(edge_sanitization, telemetry_injector, "Enriches requests with telemetry metadata")

@enduml