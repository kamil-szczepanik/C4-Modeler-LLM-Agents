@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon SQS container

System_Ext(Scoring_Engine, "Scoring Engine", "Rust, AWS ECS Fargate")
System_Ext(AWS_Lambda, "AWS Lambda", "AWS Lambda")

Container_Boundary(Amazon_SQS, "Amazon SQS") {
    Component(Amazon_SQS_FIFO_Queue, "Amazon SQS FIFO Queue", "Amazon SQS FIFO", "Decouples latency-critical scoring from audit logging with guaranteed per-transaction ordering for raw decision payloads.")
    Component(Amazon_SQS_Dead_Letter_Queue_DLQ, "Amazon SQS Dead-Letter Queue (DLQ)", "Amazon SQS", "Automatically routes unprocessable messages on failure from processing functions.")
}

Rel(Scoring_Engine, Amazon_SQS_FIFO_Queue, "Publishes raw decision payloads asynchronously", "HTTPS / SigV4, TLS 1.2+")
Rel(Amazon_SQS_FIFO_Queue, AWS_Lambda, "Batch invokes processing function", "AWS SDK / Event Source Mapping")
Rel(AWS_Lambda, Amazon_SQS_Dead_Letter_Queue_DLQ, "Automatically routes unprocessable messages on failure", "AWS SDK")

@enduml