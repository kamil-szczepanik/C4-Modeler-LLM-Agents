@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS Lambda container

Container_Boundary(aws_lambda, "AWS Lambda") {
    Component(Event_Consumer_Component, "Event Consumer Component", "AWS Lambda", "Triggers audit event processing via Event Source Mapping from Amazon SQS.")
    Component(Crypto_Signer_Component, "Crypto Signer Component", "AWS Lambda, AWS KMS, AWS Encryption SDK", "Requests cryptographic signatures and performs payload-level encryption ensuring no cleartext PAN data touches memory or logs.")
    Component(Ledger_Writer_Component, "Ledger Writer Component", "AWS Lambda", "Writes cryptographically signed audit logs to the Audit Ledger via HTTPS/TLS 1.3.")
    Component(Error_Handling___DLQ_Component, "Error Handling & DLQ Component", "AWS Lambda, Amazon SQS", "Forwards unprocessable poison messages using encrypted queues to Amazon SQS DLQ.")
}

Rel(Event_Consumer_Component, Crypto_Signer_Component, "Passes consumed audit events for encryption and signing")
Rel(Crypto_Signer_Component, Ledger_Writer_Component, "Sends signed and encrypted audit payloads")
Rel(Event_Consumer_Component, Error_Handling___DLQ_Component, "Forwards unprocessable messages on failure")
@enduml