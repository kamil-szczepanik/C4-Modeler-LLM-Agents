@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Scoring Engine container

System_Ext(api_gateway, "API Gateway / Application Load Balancer", "External API Gateway")
System_Ext(amazon_s3, "Amazon S3", "Object storage for Wasm modules and model weights")
System_Ext(amazon_sqs, "Amazon SQS", "Message queue for audit logs and metrics")
System_Ext(audit_ledger, "Audit Ledger", "Tamper-evident audit ledger system")

Container_Boundary(scoring_engine, "Scoring Engine") {
    Component(api_router, "API Router / HTTP Listener", "Rust", "Handles ingress payment authorization requests and exposes HTTP/gRPC endpoints.")
    Component(evaluator, "In-Memory Rule & Model Evaluator", "Rust, WebAssembly", "Evaluates transactions in real-time with sub-50ms latency using a memory-bounded Wasmtime sandbox.")
    Component(hot_reload, "Hot-Reload Coordinator", "Rust", "Fetches signed WebAssembly modules and model weights for dynamic updates.")
    Component(audit_dispatcher, "Audit Dispatcher", "Rust", "Publishes signed tamper-evident decision logs.")
    Component(telemetry, "Telemetry Emitter", "Rust", "Flushes aggregated decision metrics for system monitoring.")
}

Rel(api_gateway, api_router, "Ingress payment authorization requests", "Synchronous gRPC/REST, mTLS")
Rel(hot_reload, amazon_s3, "Fetches signed WebAssembly modules and model weights", "HTTPS, TLS 1.3")
Rel(audit_dispatcher, amazon_sqs, "Publishes signed tamper-evident decision logs", "Asynchronous JSON, HTTPS/TLS 1.3")
Rel(audit_dispatcher, audit_ledger, "Publishes signed tamper-evident decision logs", "Asynchronous JSON, HTTPS/TLS 1.3")
Rel(telemetry, amazon_sqs, "Flushes aggregated decision metrics", "Asynchronous event streaming")

@enduml