@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(model_rule_management_service, "Model & Rule Management Service") {
    Component(Rule_API_Router, "Rule API Router", "Python/FastAPI", "Exposes endpoints for fraud engineers and risk officers to manage and create rules and models.")
    Component(Rule_Management_Engine, "Rule Management Engine", "Python", "Validates, processes, and cryptographically signs rule bundles before distribution.")
    Component(Audit_Logger_Component, "Audit Logger Component", "Python", "Writes audit events to the external Audit Ledger to maintain tamper-evident compliance.")
}

Rel(Rule_API_Router, Rule_Management_Engine, "Routes rule and model payloads for processing")
Rel(Rule_Management_Engine, Audit_Logger_Component, "Triggers immutable audit logging for administrative actions")

@enduml