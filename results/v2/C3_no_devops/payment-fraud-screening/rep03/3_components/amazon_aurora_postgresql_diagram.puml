@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_aurora_postgresql, "Amazon Aurora PostgreSQL") {
    Component(aurora_postgresql_instance, "Aurora PostgreSQL Instance", "PostgreSQL 15+, Primary and Read Replica nodes", "System-of-record relational database deployed in AWS eu-west-1 for ACID compliance, multi-AZ high availability, and 7-year audit data storage.")
    Component(storage_volume, "Storage Volume", "Distributed, six-way replicated virtual volume", "Distributed storage across three Availability Zones ensuring data durability and high availability.")
}

Rel(aurora_postgresql_instance, storage_volume, "Persists relational data and audit logs to")

@enduml