@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Real-Time Payment Fraud Screening system

Person(FraudAnalysts, "Fraud Analysts", "Internal users reviewing flagged transactions via case management.")
Person(RiskComplianceOfficers, "Risk & Compliance Officers", "Internal users auditing tamper-evident decision logs.")
Person(FraudEngineers, "Fraud Engineers", "Internal users updating rules and models without downtime.")

System_Ext(PaymentGateway, "Payment Processor Systems / Payment Gateway", "External actor sending authorization requests.")
System_Ext(IdP, "Identity Provider (IdP)", "AWS IAM Identity Center handling SSO and MFA.")
System_Ext(NotificationService, "Notification Service", "Amazon SES for analyst review alerts.")
System_Ext(AuditLedger, "Audit Ledger", "AWS QLDB or WORM-configured S3 storing tamper-evident logs.")

System(RealTimePaymentFraudScreening, "Real-Time Payment Fraud Screening", "Screens card-not-present payment authorizations for fraud prior to approval and provides case management for analyst reviews.")

Rel(PaymentGateway, RealTimePaymentFraudScreening, "Sends authorization requests for fraud screening", "REST/gRPC over mTLS and TLS 1.3 via AWS API Gateway")
Rel(FraudAnalysts, RealTimePaymentFraudScreening, "Reviews flagged transactions via case management", "HTTPS via SSO/OIDC and RBAC")
Rel(RealTimePaymentFraudScreening, AuditLedger, "Writes tamper-evident decision logs for 7-year retention", "Encrypted write operations")
Rel(RealTimePaymentFraudScreening, IdP, "Authenticates users", "OIDC/SAML")

@enduml