@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Explainability Service container

Container_Boundary(explainability_service, "Explainability Service") {
    Component(Event_Consumer_Component, "Event Consumer Component", "Python, Celery/FastAPI background worker", "Consumes scoring events asynchronously from Amazon SQS.")
    Component(SHAP_Calculator_Component, "SHAP Calculator Component", "Python, shap library + ONNX Runtime", "Calculates feature attribution weights for fraud scoring events.")
    Component(Feature_Formatter_Component, "Feature Formatter Component", "Python", "Formats features into human-readable explanations and audit trails.")
    Component(Audit___Indexing_Dispatcher, "Audit & Indexing Dispatcher", "Python, AWS SDK", "Dispatches explanations to storage and updates metadata databases.")
}

Component(Amazon_SQS, "Amazon SQS", "AWS SQS", "Asynchronous message decoupling queue to protect P99 scoring latency.")
Component(Amazon_S3_Object_Lock, "Amazon S3 Object Lock", "AWS S3", "Tamper-evident audit retention storage in Compliance Mode.")
Component(Feature_Store___Metadata_DB, "Feature Store & Metadata DB", "PostgreSQL RDS", "Secure metadata storage and database access.")

Rel(Event_Consumer_Component, Amazon_SQS, "Consumes scoring events", "Pull via AWS SDK")
Rel(Audit___Indexing_Dispatcher, Amazon_S3_Object_Lock, "Writes tamper-readable explanations", "HTTPS / AWS SDK")
Rel(Audit___Indexing_Dispatcher, Feature_Store___Metadata_DB, "Updates explanation metadata", "SQL over psycopg2")

@enduml