@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway / Ingestion Service container

Container_Boundary(api_gateway_container, "API Gateway / Ingestion Service") {
    Component(Load_Balancer_Perimeter_Controller, "Load Balancer & Perimeter Controller", "AWS ALB, AWS WAF", "Enforces perimeter security, rate limiting, and distributes incoming HTTPS traffic with inbound mTLS.")
    Component(Ingestion_Router_API_Handler, "Ingestion Router & API Handler", "Go, Fiber/Chi Router", "Processes incoming payment authorization requests, handles routing, and executes high-concurrency request validation.")
    Component(Telemetry_Metrics_Publisher, "Telemetry & Metrics Publisher", "OpenTelemetry, AWS CloudWatch", "Emits telemetry metrics and traces for real-time monitoring and observability.")
}

Rel(Load_Balancer_Perimeter_Controller, Ingestion_Router_API_Handler, "Forwards verified HTTPS requests", "HTTPS / JSON, inbound mTLS")
Rel(Ingestion_Router_API_Handler, Telemetry_Metrics_Publisher, "Emits OpenTelemetry metrics and traces", "OTLP / HTTPS")
@enduml