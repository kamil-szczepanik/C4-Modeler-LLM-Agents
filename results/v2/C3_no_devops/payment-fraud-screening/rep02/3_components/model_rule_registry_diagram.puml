@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Model & Rule Registry container

Container_Boundary(model_and_rule_registry, "Model & Rule Registry") {
    Component(Registry_API_Service, "Registry API Service", "Python, FastAPI", "Exposes endpoints for Risk Managers to upload and approve rules via HTTPS/REST with MFA authentication.")
    Component(Registry_Core_Engine, "Registry Core Engine", "Python, FastAPI", "Executes validation and publishing workflows, interacts with storage, metadata catalogs, event dispatchers, and secrets management.")
    ComponentDb(Metadata_Catalog, "Metadata Catalog", "PostgreSQL, AWS RDS", "Manages version lineage, metadata catalogs, and active-state pointers.")
    Component(Artifact_Storage, "Artifact Storage", "Amazon S3 with Object Lock", "Provides immutable, tamper-evident artifact storage to meet auditability constraints.")
    Component(Event_Dispatcher, "Event Dispatcher", "Amazon SQS / EventBridge", "Publishes model release notifications.")
    Component(Supporting_Services, "Supporting Services", "AWS Cognito, AWS Secrets Manager, AWS KMS", "Handles multi-factor authentication, code-signing certificates, and artifact encryption at rest.")
}

Rel(Registry_API_Service, Registry_Core_Engine, "Invokes validation and publishing workflow via internal Python function calls", "")
Rel(Registry_Core_Engine, Artifact_Storage, "Writes immutable artifacts using S3 API", "")
Rel(Registry_Core_Engine, Metadata_Catalog, "Persists version lineage and active-state pointers via SQL/JDBC", "")
Rel(Registry_Core_Engine, Event_Dispatcher, "Publishes model release notifications via SQS API", "")
Rel(Registry_Core_Engine, Supporting_Services, "Retrieves code-signing certificates and secures data via AWS SDK", "")

@enduml