@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management Web App container

System_Ext(AWS_Cognito, "AWS Cognito", "Identity Provider")
System_Ext(Case_ Management_Backend, "Case Management Backend", "Node.js, Go")
System_Ext(Amazon_S3___CloudFront, "Amazon S3 / CloudFront", "Static Hosting & CDN")

Container_Boundary(Case_Management_Web_App, "Case Management Web App") {
    Component(Authentication___Session_Manager_Component, "Authentication & Session Manager Component", "TypeScript, AWS Amplify / Cognito SDK", "Handles OIDC token exchange, authentication, RBAC, and session management via HTTPS.")
    Component(Case_Queue___Review_Dashboard_Component, "Case Queue & Review Dashboard Component", "React, TanStack Table", "Provides high-throughput case feeds and review interface for fraud analysts and risk managers.")
    Component(Audit___Reporting_Portal_Component, "Audit & Reporting Portal Component", "React, Recharts", "Provides audit and reporting visualizations for compliance and risk tracking.")
    Component(API_Client_Layer, "API Client Layer", "Axios/Fetch Wrapper", "Implements centralized API interception and secure token injection for backend communication.")
}

Rel(Authentication___Session_Manager_Component, AWS_Cognito, "Handles OIDC token exchange and authentication via HTTPS", "HTTPS")
Rel(Case_Queue___Review_Dashboard_Component, API_Client_Layer, "Sends API requests through", "")
Rel(Audit___Reporting_Portal_Component, API_Client_Layer, "Sends API requests through", "")
Rel(API_Client_Layer, Case_ Management_Backend, "Sends API requests via HTTPS / REST using JWTs", "HTTPS / REST")
Rel(Case_Management_Web_App, Amazon_S3___CloudFront, "Hosted and delivered securely via HTTPS", "HTTPS")

@enduml