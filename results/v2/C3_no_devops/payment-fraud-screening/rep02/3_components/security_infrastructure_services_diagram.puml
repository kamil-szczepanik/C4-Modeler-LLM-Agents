@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Security & Infrastructure Services container

Person(FraudAnalysts, "Fraud Analysts", "HTTPS/TLS 1.3 [OIDC/OAuth2]", "External actors interacting with authentication.")
System_Ext(RealTimeScoringEngine, "Real-Time Scoring Engine", "AWS SDK / IAM Signed SQS", "External scoring engine interacting with the ingestion bus and secrets.")
System_Ext(CaseManagementBackend, "Case Management Backend", "Secure Local IPC", "Backend service consuming injected credentials.")
Person(EngineeringTeam, "Engineering Team", "Amazon EventBridge", "Receives anomaly alerts.")

Container_Boundary(SecurityAndInfrastructureServices, "Security & Infrastructure Services") {
    Component(AuthenticationAndIdentityComponent, "Authentication & Identity Component", "AWS Cognito", "Manages user access with mandatory MFA to protect analysts and satisfy PCI-DSS.")
    Component(SecretsAndVaultComponent, "Secrets & Vault Component", "AWS Secrets Manager", "Stores and rotates database/service credentials every 90 days via Lambda templates.")
    Component(AuditAndTamperEvidentStorageComponent, "Audit & Tamper-Evident Storage Component", "Amazon S3 Object Lock (Compliance Mode) and Glacier Flexible Archive", "Guarantees tamper-evident 7-year audit storage and reduces long-term storage costs.")
    Component(AsynchronousIngestionBus, "Asynchronous Ingestion Bus", "Amazon SQS with AWS KMS SSE", "Decouples the scoring engine to preserve the <50ms latency constraint and provides secure message transport.")
    Component(MonitoringAndAlerting, "Monitoring & Alerting", "AWS CloudTrail and Amazon EventBridge", "Triggers anomaly alerts and monitors system activities.")
}

Rel(FraudAnalysts, AuthenticationAndIdentityComponent, "Authenticates", "HTTPS/TLS 1.3 [OIDC/OAuth2]")
Rel(RealTimeScoringEngine, AsynchronousIngestionBus, "Publishes asynchronous audit logs", "HTTPS/TLS 1.3, IAM Signed SQS")
Rel(AsynchronousIngestionBus, AuditAndTamperEvidentStorageComponent, "Persists immutable transaction payloads", "AWS SDK")
Rel(SecretsAndVaultComponent, RealTimeScoringEngine, "Injects credentials", "Secure Local IPC")
Rel(SecretsAndVaultComponent, CaseManagementBackend, "Injects credentials", "Secure Local IPC")
Rel(MonitoringAndAlerting, EngineeringTeam, "Triggers anomaly alerts", "Amazon EventBridge")

@enduml