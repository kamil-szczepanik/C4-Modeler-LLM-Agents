@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalysts_RiskManagers, "Fraud Analysts & Risk Managers", "Users who access the secure case management interface to review fraud decisions and manage cases.")

System_Ext(PaymentGateway_CoreProcessingPlatform, "Payment Gateway / Core Processing Platform", "External system that sends authorization requests to the fraud screening system.")
System_Ext(CardNetworks_Issuers, "Card Networks & Issuers", "External systems that receive final routing decisions from the fraud screening system.")
System_Ext(Regulators_Audit_ComplianceSystem, "Regulators / Audit & Compliance System", "External systems and entities that benefit from tamper-evident, 7-year immutable audit retention.")

System(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System", "Evaluates card-not-present payment authorizations for fraud in under 50 milliseconds while providing a secure case management interface for analysts within a PCI-DSS Level 1 compliance framework.")

Rel(PaymentGateway_CoreProcessingPlatform, RealTimePaymentFraudScreeningSystem, "Sends authorization requests for fraud evaluation", "gRPC/REST over TLS 1.3")
Rel(FraudAnalysts_RiskManagers, RealTimePaymentFraudScreeningSystem, "Accesses Case Management UI to review and manage fraud cases", "HTTPS with OAuth2/OIDC IAM")
Rel(RealTimePaymentFraudScreeningSystem, CardNetworks_Issuers, "Routes authorization decisions", "TLS")
Rel(RealTimePaymentFraudScreeningSystem, Regulators_Audit_ComplianceSystem, "Streams immutable audit logs and analytics", "AWS S3 Object Lock, AWS KMS, AWS EventBridge/Kinesis")

@enduml