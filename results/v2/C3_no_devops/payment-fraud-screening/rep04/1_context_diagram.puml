@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Real-Time Payment Fraud Screening System

Person(FraudAnalystRiskManager, "Fraud Analyst & Risk Manager", "Accesses case management and rule update interfaces.")
Person(ComplianceAuditor, "Compliance / Auditor", "Queries audit logs for merchant support and compliance.")
System_Ext(PaymentProcessor, "Payment Processor", "Sends transaction authorizations via gRPC.")
System_Ext(IdentityProvider, "Identity Provider", "Manages user authentication via AWS Cognito (OIDC).")

System(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System", "Screens card-not-present payment authorizations for fraud within strict latency limits while providing case management for analysts, ensuring PCI-DSS Level 1 compliance and 7-year tamper-evident auditability.")

Rel(PaymentProcessor, RealTimePaymentFraudScreeningSystem, "Sends authorization requests", "gRPC over mTLS")
Rel(FraudAnalystRiskManager, RealTimePaymentFraudScreeningSystem, "Accesses case management, rule updates, and reporting", "HTTPS")
Rel(ComplianceAuditor, RealTimePaymentFraudScreeningSystem, "Queries audit logs", "HTTPS")
Rel(RealTimePaymentFraudScreeningSystem, IdentityProvider, "Authenticates users", "OIDC / AWS Cognito")

@enduml