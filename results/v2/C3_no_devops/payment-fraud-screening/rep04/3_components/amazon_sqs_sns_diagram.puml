@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_sqs_sns, "Amazon SQS / SNS") {
    Component(FraudEventTopic, "FraudEventTopic", "Amazon SNS", "Publishes authorization and decision events from the Scoring Engine.")
    Component(AuditLogQueue, "AuditLogQueue", "Amazon SQS", "Receives payloads from FraudEventTopic for audit logging via AWS PrivateLink.")
    Component(CaseRoutingQueue, "CaseRoutingQueue", "Amazon SQS", "Receives review tasks from FraudEventTopic to route to the Case Management Backend.")
    Component(Dead_Letter_Queues_DLQ, "Dead-Letter Queues (DLQ)", "Amazon SQS DLQ", "Prevents poison-pill message processing loops with a maximum receive count limit.")
}

Rel(FraudEventTopic, AuditLogQueue, "Pushes payloads to", "SQS protocol over AWS PrivateLink")
Rel(FraudEventTopic, CaseRoutingQueue, "Pushes payloads to", "SQS protocol over AWS PrivateLink")

@enduml