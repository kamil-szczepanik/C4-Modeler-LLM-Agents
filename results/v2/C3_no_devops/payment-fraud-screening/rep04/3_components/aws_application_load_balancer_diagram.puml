@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS Application Load Balancer container

Container_Boundary(aws_application_load_balancer, "AWS Application Load Balancer") {
    Component(ingress_router_and_tls_terminator, "Ingress Router and TLS Terminator", "AWS ALB Listener", "Terminates mTLS and HTTPS traffic from payment processors and fraud analysts, performing initial edge checks.")
    Component(scoring_traffic_router, "Scoring Traffic Router", "HTTP/2 Path-Based Router", "Routes payment authorization scoring traffic to the Scoring Engine via HTTP/2 on /v1/score.")
    Component(administrative_traffic_router, "Administrative Traffic Router", "HTTP/1.1 Path-Based Router", "Routes case management and rule update traffic to the Case Management Backend on /v1/cases/*.")
}

Rel(ingress_router_and_tls_terminator, scoring_traffic_router, "Forwards validated scoring requests", "")
Rel(ingress_router_and_tls_terminator, administrative_traffic_router, "Forwards validated administrative and case management requests", "")

@enduml