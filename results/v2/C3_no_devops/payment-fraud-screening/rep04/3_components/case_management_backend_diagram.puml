@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management Backend container

Person(FraudAnalyst, "Fraud Analyst", "External actor accessing review queues and case details")

Container_Boundary(CaseManagementBackend, "Case Management Backend") {
    Component(CaseAPIController, "Case API Controller", "Node.js / TypeScript, OIDC Token Validation, Data Masking Middleware", "Entry point handling HTTPS requests with OIDC token validation and Data Masking Middleware.")
    Component(CaseService, "Case Service", "Node.js / TypeScript", "Orchestrates business workflow logic, state transitions, and SLA/workload metrics.")
    Component(AuditExportService, "Audit & Export Service", "Node.js / TypeScript, AWS SDK", "Manages asynchronous report generation and publishing to Amazon SQS and Amazon S3.")
    Component(DataAccessRepository, "Data Access Repository", "Node.js / TypeScript, Parameterized Queries", "Interfaces with Amazon Aurora Serverless v2 PostgreSQL using parameterized queries.")
    Component(AmazonAuroraServerlessv2PostgreSQL, "Amazon Aurora Serverless v2 PostgreSQL", "PostgreSQL, Amazon Aurora Serverless v2", "Persistent storage for case metadata and operational records.")
    Component(AmazonS3AmazonSQS, "Amazon S3 & Amazon SQS", "AWS S3, Amazon SQS", "Staging storage for secure audit exports and asynchronous message queuing.")
}

Rel(FraudAnalyst, CaseAPIController, "Accesses review queues and case details", "HTTPS")
Rel(CaseAPIController, CaseService, "Invokes workflow operations internally", "")
Rel(AuditExportService, AmazonS3AmazonSQS, "Publishes asynchronous export jobs and stages exported audit reports", "AWS SDK / HTTPS")
Rel(DataAccessRepository, AmazonAuroraServerlessv2PostgreSQL, "Persists and retrieves encrypted case data", "TLS / TCP 5432")

@enduml