@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(auditor_query_service, "Auditor Query Service") {
    Component(api_controller, "API Controller", "Node.js / TypeScript container on AWS Fargate", "Receives secure queries from compliance officers and validates JWTs.")
    Component(query_translator, "Query Translator", "Stateless TypeScript component", "Translates audit queries into parameterized SQL.")
    Component(athena_client, "Athena Client", "AWS SDK", "Executes parameterized SQL queries against AWS Athena.")
}

Rel(api_controller, query_translator, "Invoke report generation", "In-process calls")
Rel(query_translator, athena_client, "Execute parameterized SQL", "AWS SDK / HTTPS")
@enduml