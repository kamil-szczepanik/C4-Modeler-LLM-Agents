@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person_Ext(Case Management Backend, "Case Management Backend", "External system")
Person_Ext(Auditor Query Service, "Auditor Query Service", "External system")
System_Ext(AWS KMS CMK, "AWS KMS (CMK)", "External system")

Container_Boundary(Amazon_Aurora_Serverless_v2_PostgreSQL, "Amazon Aurora Serverless v2 PostgreSQL") {
    Component(Connection Pooler, "Connection Pooler", "PgBouncer Sidecar", "PgBouncer Sidecar for traffic management, DoS mitigation, and resource efficiency.")
    Component(AWS IAM Database Authentication Plugin, "AWS IAM Database Authentication Plugin", "AWS IAM", "Provides zero static credentials and database authentication.")
    Component(PostgreSQL RLS Enforcement Component, "PostgreSQL RLS Enforcement Component", "PostgreSQL Row-Level Security", "Tenant and analyst isolation enforcement.")
    Component(Case Management Schema, "Case Management Schema", "Relational PostgreSQL tables", "Relational tables for analyst workflows via R-02.")
    Component(Audit Ledger Schema, "Audit Ledger Schema", "PostgreSQL tables with cryptographic extensions", "PostgreSQL tables with cryptographic extensions for R-06 ensuring 7-year tamper-evident auditability.")
    Component(AWS KMS Custom Managed Key, "AWS KMS Custom Managed Key", "AWS KMS", "Customer Managed Key (CMK) for encryption at rest for PCI-DSS Level 1 compliance.")
}

Rel(Case Management Backend, PostgreSQL RLS Enforcement Component, "Validates isolation via PostgreSQL wire protocol", "TLS")
Rel(Auditor Query Service, Audit Ledger Schema, "Reads immutable audit logs via PostgreSQL wire protocol", "TLS")
Rel(Amazon_Aurora_Serverless_v2_PostgreSQL, AWS KMS CMK, "Encrypts storage and backups", "AWS API")

@enduml