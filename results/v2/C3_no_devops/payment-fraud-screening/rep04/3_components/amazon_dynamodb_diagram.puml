@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_dynamodb, "Amazon DynamoDB") {
    Component(Feature_Store_Table, "Feature Store Table", "DynamoDB Table", "Stores low-latency risk profiles for real-time payment fraud screening.")
    Component(Case_State_Table, "Case State Table", "DynamoDB Table", "Manages investigation workflow states for analyst case reviews.")
    Component(Audit_Stream_Processor, "Audit Stream Processor", "DynamoDB Stream / AWS Lambda", "Asynchronously captures state changes for auditability without impacting transaction latency.")
}

Rel(Case_State_Table, Audit_Stream_Processor, "Publishes state changes", "DynamoDB Streams")

@startuml