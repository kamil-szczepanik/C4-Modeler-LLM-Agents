@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Rule & Model Distribution Service container

Container_Boundary(rule_model_distribution_service, "Rule & Model Distribution Service") {
    Component(AdminAPIController, "Admin API Controller", "Spring MVC", "Handles administrative API requests for rule and model distribution.")
    Component(BundleSignerValidator, "Bundle Signer & Validator", "AWS KMS / Ed25519", "Cryptographically signs and validates rule bundles without secret exfiltration.")
    Component(StorageSyncAgent, "Storage Sync Agent", "AWS SDK for Java", "Synchronizes rule bundles with storage and emits audit events.")
    Component(RuleSyntaxLinter, "Rule Syntax Linter", "JSON Schema Validator / ANTLR", "Performs static rule syntax validation protecting against DoS and injection.")
}

System_Ext(AmazonS3, "Amazon S3", "Object storage for rule bundles")
System_Ext(AmazonEventBridge, "Amazon EventBridge", "Event bus for audit events")

Rel(AdminAPIController, RuleSyntaxLinter, "In-process method call", "")
Rel(AdminAPIController, BundleSignerValidator, "In-process call utilizing AWS KMS", "HTTPS/AWS SDK")
Rel(StorageSyncAgent, AmazonS3, "HTTPS / AWS SDK for rule bundle distribution", "HTTPS / AWS SDK")
Rel(StorageSyncAgent, AmazonEventBridge, "HTTPS / AWS SDK for audit events", "HTTPS / AWS SDK")

@enduml