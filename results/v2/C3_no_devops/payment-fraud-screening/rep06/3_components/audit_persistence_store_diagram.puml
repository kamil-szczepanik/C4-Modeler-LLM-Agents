@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit & Persistence Store container

System_Ext(Scoring_Engine, "Scoring Engine", "External scoring engine component")
System_Ext(Case_Management_API, "Case Management API", "External case management API component")

Container_Boundary(audit_persistence_store, "Audit & Persistence Store") {
    Component(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL, PL/pgSQL, JDBC over TLS 1.3, mTLS, AWS IAM", "Primary relational database with cryptographic chaining for tamper-evident storage, supporting operational transaction states, case management, and native partitioning.")
    Component(Audit_Ledger_Writer, "Audit Ledger Writer", "PL/pgSQL, SHA-256", "Append-only component using SHA-256 cryptographic hashing to ensure tamper-evident audit logs.")
    Component(Data_Retention_Manager, "Data Retention Manager", "AWS SDK, VPC endpoints", "Automated monthly table partitioning and lifecycle policies targeting cold storage.")
    Component(Transaction_Case_Repository, "Transaction & Case Repository", "Amazon Aurora PostgreSQL", "Stores operational transaction states and case management data.")
    Component(Audit_Query_Retrieval_Gateway, "Audit Query & Retrieval Gateway", "Read-replica routing service, Amazon ElastiCache Redis, Batch hydration APIs", "Read-replica routing service with an internal Redis caching layer and batch hydration APIs.")
    Component(AWS_S3_Glacier_Flexible_Retrieval, "AWS S3 Glacier Flexible Retrieval", "AWS S3 Glacier, AWS S3 Object Lock, WORM immutability", "Cold storage tier featuring AWS S3 Object Lock for WORM immutability and 7-year retention.")
}

Rel(Scoring_Engine, Amazon_Aurora_PostgreSQL, "Connects via JDBC over TLS 1.3 with mutual TLS (mTLS) and AWS IAM database authentication.", "JDBC / TLS 1.3")
Rel(Case_Management_API, Amazon_Aurora_PostgreSQL, "Connects via JDBC over TLS 1.3 with mTLS and IAM database authentication, restricted by Row-Level Security (RLS).", "JDBC / TLS 1.3")
Rel(Data_Retention_Manager, AWS_S3_Glacier_Flexible_Retrieval, "Archives aged partitions via AWS SDK using VPC endpoints with WORM Object Lock.", "AWS SDK")
Rel(Audit_Query_Retrieval_Gateway, AWS_S3_Glacier_Flexible_Retrieval, "Fetches cold data asynchronously using pre-signed S3 URLs with 15-minute expiration windows.", "HTTPS / Pre-signed URLs")

@enduml