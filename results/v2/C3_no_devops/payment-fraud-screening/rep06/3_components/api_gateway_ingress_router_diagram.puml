@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_ingress_router, "API Gateway / Ingress Router") {
    Component(Payment_Ingress_Router, "Payment Ingress Router", "AWS Application Load Balancer", "Handles high-throughput B2B payment authorization requests via HTTPS/gRPC over TLS 1.3 and mTLS.")
    Component(Management_API_Gateway, "Management API Gateway", "Amazon API Gateway", "Routes management traffic, providing built-in AWS Cognito JWT validation and AWS WAF integration.")
}

Rel(Payment_Ingress_Router, Scoring_Engine, "Forwards payload requests", "gRPC over mTLS via VPC Endpoints")
Rel(Management_API_Gateway, Case_Management_API, "Routes case management operations", "HTTPS over mTLS")
@enduml