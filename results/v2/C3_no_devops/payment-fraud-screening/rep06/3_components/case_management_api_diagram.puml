@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(case_management_api, "Case Management API") {
    Component(Case Workflow Controller, "Case Workflow Controller", "Python / FastAPI", "Manages case states, review workflows, and orchestrates audit logging.")
    Component(Audit & Persistence Adapter, "Audit & Persistence Adapter", "SQLAlchemy", "Handles database interactions and provides persistence operations for case states and audit logs.")
}

Rel(Case Workflow Controller, Audit & Persistence Adapter, "Invokes for data persistence", "JDBC/TLS")

@enduml