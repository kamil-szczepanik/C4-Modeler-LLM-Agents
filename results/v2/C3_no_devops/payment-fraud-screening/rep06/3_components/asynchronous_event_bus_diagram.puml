@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(asynchronous_event_bus, "Asynchronous Event Bus") {
    Component(event_router, "Event Router", "Amazon EventBridge Bus", "Screens card-not-present payment authorizations for fraud prior to approval and routes events.")
    Component(event_archive, "Event Archive", "Amazon EventBridge Archive with Amazon S3 Object Lock", "Archives events and enforces tamper-evident 7-year audit retention to comply with PCI-DSS Level 1 constraints.")
    Component(dead_letter_queue_dlq, "Dead-Letter Queue (DLQ)", "Amazon SQS", "Guarantees zero data loss and at-least-once delivery for unroutable or failed events.")
    Component(rule_dispatcher, "Rule Dispatcher", "Amazon EventBridge Rule Subscriptions", "Dispatches events to appropriate downstream rule subscriptions.")
    Component(audit_persistence_store, "Audit & Persistence Store", "Amazon Aurora PostgreSQL", "Stores audit data and provides a 7-year tamper-evident audit trail.")
}

System_Ext(scoring_engine, "Scoring Engine", "External system publishing events.")
System_Ext(case_management_sqs_queue, "Case Management SQS Queue", "External queue receiving event push delivery.")

Rel(scoring_engine, event_router, "Asynchronous event publishing via HTTPS using AWS SDK v2 and AWS Signature Version 4 (PutEvents).")
Rel(event_router, case_management_sqs_queue, "Event push delivery via HTTPS using AWS KMS CMK encryption.")
Rel(event_router, event_archive, "Native SQS/S3 integration with Object Lock enabled for 7-year retention.")

@enduml