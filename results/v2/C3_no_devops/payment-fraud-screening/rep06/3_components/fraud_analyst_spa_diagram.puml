@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Fraud Analyst SPA container

Container_Boundary(fraud_analyst_spa, "Fraud Analyst SPA") {
    Component(Case Review Workspace Module, "Case Review Workspace Module", "React Component", "Fetches transaction context and explainability payloads from the Case Management API.")
    Component(Analytics Dashboard Module, "Analytics Dashboard Module", "React Component", "Fetches aggregated metrics and audit logs from the Case Management API and reporting services.")
    Component(Explainability Renderer, "Explainability Renderer", "React Sub-component / Chart.js / Tailwind CSS", "Renders lightweight visualization and explainability metrics for fraud analysts.")
}

System_Ext(Case Management API, "Case Management API", "Backend API for managing analyst workflows and queues.")

Rel(Case Review Workspace Module, Case Management API, "Fetching transaction context and explainability payloads", "HTTPS/REST via AWS Cognito")
Rel(Analytics Dashboard Module, Case Management API, "Fetching aggregated metrics and audit logs", "HTTPS/REST via AWS Cognito")

@enduml