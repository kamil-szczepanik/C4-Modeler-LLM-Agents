@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(feature_store, "Feature Store") {
    Component(Low_Latency_Read_Component, "Low-Latency Read Component", "Amazon ElastiCache Redis", "Provides sub-10ms key-value lookups for real-time feature retrieval within budget.")
    Component(Ingestion_Worker, "Ingestion Worker", "Python/FastAPI / Amazon ECS Fargate", "Lightweight processing for ingestion workers handling feature schemas and batch/streaming feature updates.")
    Component(State___Metadata_Registry, "State & Metadata Registry", "Amazon DynamoDB", "Serverless metadata registry for tracking feature definitions and provenance metadata securely.")
}

Rel(Ingestion_Worker, State___Metadata_Registry, "Stores feature definitions and provenance metadata", "")

@enduml