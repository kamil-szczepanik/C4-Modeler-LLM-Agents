@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Real-Time Payment Fraud Screening system

Person(FraudAnalysts, "Fraud Analysts & Risk Operations Managers", "Internal human users reviewing cases and managing rules.")
System_Ext(PaymentGateway, "Payment Gateway", "External payment gateway sending card-not-present payment authorization requests.")
System_Ext(AmazonS3, "Amazon S3", "External object storage hosting rule bundles and frontend assets.")

System_Boundary(RealTimePaymentFraudScreeningsystem, "Real-Time Payment Fraud Screening system") {
    Container(APIGatewayIngressRouter, "API Gateway / Ingress Router", "Amazon API Gateway / ALB", "Amazon API Gateway / ALB terminating TLS.")
    Container(ScoringEngine, "Scoring Engine", "Java/Spring Boot or Go / ECS Fargate", "Stateless container evaluating rules and ML models in-memory.")
    Container(CaseManagementAPI, "Case Management API", "Node.js or Python/FastAPI / ECS Fargate", "Container handling analyst workflows and review queues.")
    Container(FraudAnalystSPA, "Fraud Analyst SPA", "React / Amazon S3 / Amazon CloudFront", "React single-page application hosted in Amazon S3 / CloudFront.")
    Container(RuleModelDistributionService, "Rule & Model Distribution Service", "Java/Spring Boot or Go / ECS Fargate", "Container handling zero-downtime rule/model updates.")
    ContainerDb(AuditPersistenceStore, "Audit & Persistence Store", "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL with cryptographic chaining.")
    ContainerDb(FeatureStore, "Feature Store", "Amazon ElastiCache Redis", "Amazon ElastiCache Redis.")
    Container(AsynchronousEventBus, "Asynchronous Event Bus", "Amazon EventBridge / MSK Lite", "Amazon EventBridge / MSK Lite.")
}

Rel(PaymentGateway, APIGatewayIngressRouter, "Processing authorization requests", "HTTPS/gRPC over TLS 1.3")
Rel(APIGatewayIngressRouter, ScoringEngine, "Enforcing mTLS within private subnets", "gRPC/HTTP2 over TLS")
Rel(ScoringEngine, FeatureStore, "Accessing low-latency feature stores", "RESP protocol over private VPC")
Rel(ScoringEngine, AsynchronousEventBus, "Asynchronous decision streaming", "HTTPS via AWS SDK")
Rel(FraudAnalystSPA, CaseManagementAPI, "Managing analyst workflows and review queues", "HTTPS/REST with OAuth2/OIDC via AWS Cognito")
Rel(RuleModelDistributionService, AmazonS3, "Polling cryptographically signed rule bundles (Ed25519)", "HTTPS")

@enduml