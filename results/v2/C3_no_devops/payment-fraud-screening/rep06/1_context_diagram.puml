@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Payer_End_Customer, "Payer (End Customer)", "Initiates checkouts.")
Person(Merchant, "Merchant", "Receives transaction approvals.")
Person(Fraud_Analyst, "Fraud Analyst", "Reviews suspicious cases via Case Management UI.")
Person(Risk_Operations_Manager, "Risk Operations Manager", "Oversees audit logs and compliance.")

System_Ext(Payment_Gateway_Acquirer, "Payment Gateway / Acquirer", "External system sending authorization payloads.")
System_Ext(Card_Networks_Tokenization_Service, "Card Networks / Tokenization Service", "External system providing PAN tokenization.")
System_Ext(ML_Model_Rule_Provider, "ML Model / Rule Provider", "External service supplying fraud models.")

System(Fraud_Screening_System, "Fraud Screening System", "Screens card-not-present payment authorizations for fraud in real-time while providing a case management UI for analysts, delivering sub-50ms decisions and 7-year tamper-evident auditability.")

Rel(Payment_Gateway_Acquirer, Fraud_Screening_System, "Sends real-time authorization payloads for synchronous scoring", "HTTPS/gRPC")
Rel(Fraud_Screening_System, ML_Model_Rule_Provider, "Fetches updated risk models asynchronously for zero-downtime updates", "HTTPS/S3")

@enduml