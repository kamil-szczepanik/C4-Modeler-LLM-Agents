@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_api_gateway_nlb, "AWS API Gateway / NLB") {
    Component(AWS_Network_Load_Balancer, "AWS Network Load Balancer", "AWS NLB", "Forwards raw incoming traffic securely via TCP/TLS.")
    Component(AWS_WAF, "AWS WAF", "AWS WAF", "Inspects and filters incoming HTTP traffic for malicious requests.")
    Component(AWS_API_Gateway, "AWS API Gateway", "AWS API Gateway (HTTP API)", "Decapsulates requests and routes them to downstream internal services via VPC Link.")
}

Rel(AWS_Network_Load_Balancer, AWS_WAF, "Forwards traffic for security inspection")
Rel(AWS_WAF, AWS_API_Gateway, "Forwards filtered requests")

@enduml