@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit Logger container

System_Ext(Message_Queue, "Message Queue", "Amazon SQS", "Decoupled event ingestion secured via VPC Endpoint policies")
System_Ext(Tamper_Evident_Storage, "Tamper-Evident Storage", "Amazon S3", "Compliance Mode enforcement for tamper-evident 7-year audit retention")
System_Ext(AWS_KMS, "AWS KMS", "AWS KMS", "Cryptographic signing and encryption using customer-managed keys (CMK)")

Container_Boundary(Audit_Logger, "Audit Logger") {
    Component(Queue_Consumer_Component, "Queue Consumer Component", "Go", "Polls payloads from the Message Queue using AWS SDK over HTTPS.")
    Component(Canonical_Formatter_Component, "Canonical Formatter Component", "Go", "Normalizes data using in-memory Go structs.")
    Component(Storage_Writer_Component, "Storage Writer Component", "Go", "Writes audit logs with Object Lock and signs payloads for cryptographic non-repudiation.")
}

Rel(Queue_Consumer_Component, Message_Queue, "Polls payloads", "AWS SDK over HTTPS")
Rel(Queue_Consumer_Component, Canonical_Formatter_Component, "Normalizes data", "In-memory Go structs")
Rel(Canonical_Formatter_Component, Storage_Writer_Component, "Passes formatted payload", "In-memory function call")
Rel(Storage_Writer_Component, Tamper_Evident_Storage, "Writes audit logs with Object Lock", "HTTPS / S3 API")
Rel(Storage_Writer_Component, AWS_KMS, "Signs payloads for cryptographic non-repudiation", "AWS KMS API")

@enduml