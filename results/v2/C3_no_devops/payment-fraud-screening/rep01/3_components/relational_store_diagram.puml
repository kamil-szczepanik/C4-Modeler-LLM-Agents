@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(CaseManagementBackend, "Case Management Backend", "Java / Spring Boot with React UI")
System_Ext(AuditLogger, "Audit Logger", "AWS Lambda / Worker")

Container_Boundary(relational_store, "Relational Store") {
    Component(CaseRepositoryComponent, "Case Repository Component", "Amazon RDS for PostgreSQL", "Persists and retrieves case state for managed case reviews.")
    Component(AuditLedgerIndexComponent, "Audit Ledger Index Component", "Amazon RDS for PostgreSQL", "Indexes advanced audit logs for 7-year auditability.")
    Component(DatabaseMigrationManager, "Database Migration Manager", "Flyway / TCP/IP", "Executes schema migrations supporting rule and model evolution.")
}

Rel(CaseManagementBackend, CaseRepositoryComponent, "Persists and retrieves case state", "PostgreSQL wire protocol (TCP/IP) via TLS 1.3")
Rel(AuditLogger, AuditLedgerIndexComponent, "Streams advanced audit logs", "PostgreSQL wire protocol (TCP/IP) via TLS 1.3")
Rel(DatabaseMigrationManager, CaseRepositoryComponent, "Executes schema migrations", "Flyway / TCP/IP")

@enduml