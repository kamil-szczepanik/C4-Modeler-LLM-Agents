@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management Backend container

Person(React UI, "React UI", "React / AWS Cognito OAuth2/OIDC", "Frontend interface accessed via AWS Cognito for user authentication and authorization.")

System_Boundary(case_management_backend, "Case Management Backend") {
    Component(Case Query Controller, "Case Query Controller", "Java / Spring MVC", "Accesses API and dashboards, handling incoming HTTPS/REST requests.")
    Component(Case Domain Service, "Case Domain Service", "Java / Spring", "Invokes business logic and forwards immutable audit logs.")
    Component(Bulk Action Processor, "Bulk Action Processor", "Spring Batch / SQS Consumer", "Consumes bulk jobs asynchronously from the message queue.")
    Component(Data Access Repository, "Data Access Repository", "Spring Data JPA", "Handles data access and persistence operations for case states.")
    Component(Metrics Aggregator, "Metrics Aggregator", "Spring Boot / Redis cache", "Provides low-latency metric aggregation using in-memory caching.")
}

System_Ext(Relational Store, "Relational Store", "Amazon RDS for PostgreSQL")
System_Ext(Message Queue, "Message Queue", "Amazon SQS")
System_Ext(Tamper-Evident Storage, "Tamper-Evident Storage", "Amazon S3")

Rel(React UI, Case Query Controller, "Accesses API and dashboards", "HTTPS/REST")
Rel(Case Query Controller, Case Domain Service, "Invokes business logic", "Java Method Calls")
Rel(Case Domain Service, Relational Store, "Reads/writes case states", "PostgreSQL/JDBC, TLS 1.3")
Rel(Bulk Action Processor, Message Queue, "Consumes bulk jobs", "AWS SDK/SQS")
Rel(Case Domain Service, Tamper-Evident Storage, "Forwards immutable audit logs", "AWS SDK/HTTPS")

@enduml