@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Tamper-Evident Storage", "Tamper-Evident Storage") {
    Component("Audit Logger", "Audit Logger", "AWS Lambda / Worker", "Appends immutable decision logs to tamper-evident storage.")
    Component("Tamper-Evident Storage", "Tamper-Evident Storage", "Amazon S3 with Object Lock in Compliance Mode", "WORM storage guaranteeing 7-year tamper-evident retention.")
}

Rel("Audit Logger", "Tamper-Evident Storage", "Appends immutable decision logs", "HTTPS / S3 API via VPC Endpoint")

@enduml