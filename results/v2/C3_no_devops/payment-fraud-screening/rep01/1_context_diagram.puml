@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(internal_users, "Fraud Analyst, ML Engineer / Data Scientist, and Finance / Operations Manager", "Internal users who manage cases, monitor models, and oversee financial operations.")

System(fraud_screening_system, "Real-Time Payment Fraud Screening System", "Screens card-not-present payment authorizations for fraud within sub-50ms latency while supporting secure case management and 7-year tamper-evident audits.")

System_Ext(payment_gateway, "Payment Gateway / Core Processing Engine", "Processes payment authorizations and communicates transaction events.")
System_Ext(card_schemes, "Card Schemes / Identity Providers", "Provide external payment network data and identity services.")
System_Ext(archival_storage, "Archival Storage / Compliance Ledger", "Stores cryptographically signed event streams ensuring 7-year tamper-evident auditability.")

Rel(payment_gateway, fraud_screening_system, "Sends payment authorizations for fraud screening", "Synchronous gRPC over mTLS")
Rel(internal_users, fraud_screening_system, "Accesses case management and monitoring tools", "HTTPS via OIDC/OAuth2 with RBAC/MFA")
Rel(fraud_screening_system, archival_storage, "Streams event data for long-term compliance storage", "Asynchronous, cryptographically signed event streams (AWS Kinesis to S3 Object Lock)")

@enduml