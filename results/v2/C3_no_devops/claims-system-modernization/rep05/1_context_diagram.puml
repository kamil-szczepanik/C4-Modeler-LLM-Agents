@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Modern Claims Platform

Person(Customers, "Customers", "End users submitting claims online.")
Person(Brokers, "Brokers", "Intermediaries submitting and managing claims on behalf of customers.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal staff responsible for claim management.")
Person(MigrationOperationsManagers, "Migration Operations Managers", "Personnel overseeing the hybrid migration process.")

System(ModernClaimsPlatform, "Modern Claims Platform", "A hybrid system gradually replacing a 30-year-old COBOL/DB2 mainframe claims system with a modern Azure-hosted platform while maintaining uninterrupted legacy operations.")

System_Ext(LegacyMainframe, "Legacy Mainframe", "On-premises 30-year-old COBOL/DB2 mainframe claims system.")
System_Ext(AntiCorruptionLayer, "Anti-Corruption Layer (ACL)", "Integration layer isolating mainframe dependencies and decoupling the legacy system.")
System_Ext(ActiveDirectory, "Active Directory", "Identity provider for single sign-on.")
System_Ext(NotificationService, "Notification Service", "Service handling asynchronous notifications.")
System_Ext(PaymentGateway, "Payment Gateway", "External service handling secure payment transactions.")

Rel(Customers, ModernClaimsPlatform, "Online claim submission", "HTTPS/REST")
Rel(Brokers, ModernClaimsPlatform, "Online claim submission and management", "HTTPS/REST")
Rel(ClaimsAdjusters, ModernClaimsPlatform, "Claim management and processing", "HTTPS/REST")
Rel(ModernClaimsPlatform, ActiveDirectory, "Single sign-on authentication", "OAuth2/OIDC via Azure API Management")
Rel(ModernClaimsPlatform, LegacyMainframe, "Secure data and operation calls through the integration layer", "Secure API calls via ACL")
Rel(ModernClaimsPlatform, NotificationService, "Trigger asynchronous event-driven messaging", "Azure Service Bus")
Rel(ModernClaimsPlatform, PaymentGateway, "Process financial transactions", "Synchronous HTTPS/REST with idempotency keys")

@enduml