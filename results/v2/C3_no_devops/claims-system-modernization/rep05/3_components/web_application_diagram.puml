@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application container

Container_Boundary(web_application, "Web Application") {
    Component(Next_js_Frontend_UI, "Next.js Frontend UI", "React, Next.js, Server-Side Rendering", "Provides the user interface for customers, brokers, and adjusters with sub-2-second screen load requirements.")
    Component(Authentication_Manager, "Authentication Manager", "Microsoft Authentication Library (MSAL), NextAuth.js", "Secures authentication and integrates with Azure Active Directory using OIDC/OAuth2.")
    Component(State_Cache_Manager, "State & Cache Manager", "Zustand, React Query", "Manages client state and optimistic UI updates to mask backend mainframe latency.")
}

Rel(Next_js_Frontend_UI, Authentication_Manager, "Authenticates users via", "")
Rel(Next_js_Frontend_UI, State_Cache_Manager, "Delegates state management and optimistic updates to", "")

@enduml