@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(claims_processing_service, "Claims Processing Service") {
    Component(ClaimStateMachineAndOrchestrator, "Claim State Machine & Orchestrator", ".NET Core (C#), MassTransit", "Orchestrates claim lifecycles and manages distributed process workflows.")
    Component(IdempotencyAndDeduplicationFilter, "Idempotency & Deduplication Filter", ".NET Core (C#)", "Filters duplicate requests and ensures transactional consistency using deduplication hashes.")
    Component(PaymentAndNotificationIntegrator, "Payment & Notification Integrator", ".NET Core (C#)", "Integrates with external payment gateways and notification services.")
    Component(MainframeSyncAdapter, "Mainframe Sync Adapter", ".NET Core (C#), AMQP", "Synchronizes hybrid state with the legacy mainframe via the Anti-Corruption Layer.")
    Component(ClaimTypePolicyEngine, "Claim Type Policy Engine", ".NET Core (C#)", "Applies business rules and policies tailored to different claim types.")
}

Rel(ClaimStateMachineAndOrchestrator, ClaimTypePolicyEngine, "Evaluates policies for processing claims.", "")
Rel(ClaimStateMachineAndOrchestrator, IdempotencyAndDeduplicationFilter, "Checks incoming requests for deduplication.", "")
Rel(ClaimStateMachineAndOrchestrator, PaymentAndNotificationIntegrator, "Triggers payments and alerts.", "")
Rel(ClaimStateMachineAndOrchestrator, MainframeSyncAdapter, "Synchronizes unmigrated claim states.", "")
@enduml