@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Anti-Corruption Layer (ACL) container

System_Ext(mainframe, "COBOL/DB2 Mainframe", "Legacy mainframe system")
System_Ext(claims_processing, "Claims Processing Service", "Claims Processing Service")

Container_Boundary(acl_boundary, "Anti-Corruption Layer (ACL)") {
    Component(translation_engine, "Translation Engine", "[e.g., .NET Core / Custom Mapper]", "Translates modern domain models to legacy mainframe data structures and vice versa.")
    Component(reconciliation_worker, "Reconciliation Worker", "[e.g., .NET Core Background Service]", "Ensures data consistency between the cloud database and the legacy mainframe, guaranteeing zero claim loss.")
    Component(acl_admin_api, "ACL Admin & Audit API", "[e.g., .NET Core Web API]", "Provides endpoints for metrics and audit queries interacting with the ACL Data Store.")
    Component(metrics_aggregator, "Metrics Aggregator", "[e.g., .NET Core / Azure Service Bus Consumer]", "Aggregates metrics and streams events from the Claims Processing Service.")
    ComponentDb(acl_data_store, "ACL Data Store", "[e.g., Azure SQL / EF Core]", "Persistence store for metrics, audit logs, and reconciliation tracking.")
}

Rel(translation_engine, mainframe, "Legacy system integration", "IBM MQ / TCP via ExpressRoute with mTLS")
Rel(acl_admin_api, acl_data_store, "Metrics and audit queries", "EF Core / SQL")
Rel(claims_processing, metrics_aggregator, "Event streaming", "Azure Service Bus / Kafka Topic")

@enduml