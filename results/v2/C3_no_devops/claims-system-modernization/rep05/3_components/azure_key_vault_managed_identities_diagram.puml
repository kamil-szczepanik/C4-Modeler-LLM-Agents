@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Key Vault & Managed Identities container

Container_Boundary(azure_key_vault_managed_identities, "Azure Key Vault & Managed Identities") {
    Component(Azure_Key_Vault, "Azure Key Vault", "Azure Key Vault", "Secures cryptographic keys, database connection strings, and certificates without hardcoding.")
    Component(User_Assigned_Managed_Identities, "User-Assigned Managed Identities", "Azure IAM / Managed Identities", "Decouples service identity lifecycles from container lifecycles for secure, passwordless authentication.")
    Component(Azure_Private_Endpoints, "Azure Private Endpoints", "Azure Private Link", "Eliminates public internet exposure by routing secure traffic entirely within the Azure Virtual Network.")
    Component(Azure_RBAC_Engine, "Azure RBAC Engine", "Azure RBAC", "Enforces least-privilege access permissions specifically tailored per container microservice.")
    Component(Key_Rotation_Automated_Alerting_Engine, "Key Rotation & Automated Alerting Engine", "Azure Event Grid & Azure Functions", "Automates zero-touch key rotation and expiration alerting.")
}

System_Ext(Claims_API_Gateway, "Claims API Gateway & Claims Processing Service", ".NET Core on Azure Container Apps")
System_Ext(Log_Analytics_Workspace, "Log Analytics Workspace", "Azure Monitor")

Rel(Claims_API_Gateway, Azure_Key_Vault, "Connects via HTTPS (TLS 1.3 via Azure SDK) over Azure Private Endpoints", "HTTPS / TLS 1.3")
Rel(Claims_API_Gateway, User_Assigned_Managed_Identities, "Authenticates against Azure Key Vault via token exchange", "Token Exchange")
Rel(Azure_Key_Vault, Log_Analytics_Workspace, "Streams audit logs and metrics via Azure Monitor Diagnostic Settings", "Azure Monitor")
Rel(Key_Rotation_Automated_Alerting_Engine, Azure_Key_Vault, "Automates zero-touch key rotation and expiration alerting", "API")

@enduml