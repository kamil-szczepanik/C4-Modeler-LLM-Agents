@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(claims_api_gateway_bff, "Claims API Gateway / Backend-for-Frontend") {
    Component(api_router_orchestrator, "API Router & Orchestrator", "Yarp", "Reverse proxy for API routing and SSL termination.")
    Component(claim_type_routing_registry, "Claim Type Routing Registry", "Azure SQL Database", "Stores routing configuration for hybrid claim type migration.")
    Component(bff_aggregator_service, "BFF Aggregator Service", "HotChocolate GraphQL", "GraphQL implementation for optimized UI payloads and sub-2s UI performance.")
    Component(circuit_breaker_fallback_manager, "Circuit Breaker & Fallback Manager", "Polly", "Circuit breaker and fault tolerance framework for managing downstream failures.")
    Component(telemetry_interceptor, "Telemetry Interceptor", ".NET Core", "Captures telemetry and monitors request flow across services.")
}

Rel(api_router_orchestrator, claim_type_routing_registry, "Queries routing configuration", "SQL")
Rel(bff_aggregator_service, api_router_orchestrator, "Orchestrates API requests", "Internal")
Rel(circuit_breaker_fallback_manager, api_router_orchestrator, "Protects routing endpoints against failures", "Polly")

@enduml