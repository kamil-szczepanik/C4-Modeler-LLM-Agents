@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Operations BFF & Admin Portal container

Container_Boundary(ops_bff_admin_portal, "Operations BFF & Admin Portal") {
    Component(Admin Web Frontend, "Admin Web Frontend", "React / TypeScript SPA", "Admin web frontend interface for migration operations managers.")
    Component(Operations BFF, "Operations BFF", ".NET Core Web API", "Backend-for-Frontend handling operations routing and aggregation.")
    Component(Migration Control Service, "Migration Control Service", ".NET Core Component", "Component managing migration operations and controls.")
    Component(Reconciliation & Metrics Aggregator, "Reconciliation & Metrics Aggregator", ".NET Core Component", "Component tracking real-time consistency and metrics.")
}

Rel(Admin Web Frontend, Operations BFF, "HTTPS REST [JSON]", "HTTPS REST [JSON]")
Rel(Operations BFF, Reconciliation & Metrics Aggregator, "In-process gRPC / Direct Method Call", "In-process gRPC / Direct Method Call")

@enduml