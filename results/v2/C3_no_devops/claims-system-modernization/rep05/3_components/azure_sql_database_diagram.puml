@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure SQL Database container

Person(Claims Processing Service, "Claims Processing Service", "External or related service")
System_Ext(Azure Service Bus, "Azure Service Bus", "External messaging system")
System_Ext(Secondary Region Azure SQL, "Secondary Region Azure SQL", "Secondary database instance")

Container_Boundary(Azure SQL Database, "Azure SQL Database") {
    Component(Claims Schema, "Claims Schema", "SQL Server Engine", "Provides relational storage for migrated claim types ensuring rapid rollback capability.")
    Component(Temporal Audit Tables, "Temporal Audit Tables", "System-Versioned Temporal Tables", "Maintains historical audit data for claims.")
    Component(Change Feed Engine, "Change Feed Engine", "Change Data Capture", "Captures and streams entity deltas.")
    Component(Maintenance & Index Manager, "Maintenance & Index Manager", "Azure SQL Elastic Jobs", "Manages database maintenance and indexes.")
    Component(Geo-Replication Controller, "Geo-Replication Controller", "Azure SQL Active Geo-Replication", "Replicates encrypted storage blocks to the secondary region via Azure Backbone Network.")
}

Rel(Claims Processing Service, Claims Schema, "Reads/writes transactional claim data", "TDS over TLS 1.3")
Rel(Change Feed Engine, Azure Service Bus, "Streams entity deltas", "AMQP")
Rel(Geo-Replication Controller, Secondary Region Azure SQL, "Replicates encrypted storage blocks", "Azure Backbone Network")

@enduml