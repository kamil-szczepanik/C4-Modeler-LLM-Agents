@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(azure_service_bus_apache_kafka, "Azure Service Bus / Apache Kafka") {
    Component(ClaimEventsTopic, "Claim Events Topic", "Azure Service Bus Topic (Premium Tier)", "Publishes and routes asynchronous claim events ('claim-events') across the hybrid platform.")
    Component(ClaimsProcessingSubscription, "Claims Processing Subscription", "Azure Service Bus Subscription", "Subscribes ('claims-processing-sub') to claim-events for processing by the Claims Processing Service.")
    Component(AclSyncSubscription, "ACL Sync Subscription", "Azure Service Bus Subscription", "Subscribes ('acl-sync-sub') to claim-events for synchronization with the Anti-Corruption Layer.")
    Component(DeadLetterQueuesDlq, "Dead-Letter Queues (DLQ)", "Azure Service Bus DLQ", "Captures and stores failed or unprocessable messages for operational review and compliance.")
}

Rel(ClaimEventsTopic, ClaimsProcessingSubscription, "Routes asynchronous messages to", "")
Rel(ClaimEventsTopic, AclSyncSubscription, "Routes asynchronous messages to", "")
Rel(ClaimsProcessingSubscription, DeadLetterQueuesDlq, "Forwards failed messages to", "")
Rel(AclSyncSubscription, DeadLetterQueuesDlq, "Forwards failed messages to", "")
@enduml