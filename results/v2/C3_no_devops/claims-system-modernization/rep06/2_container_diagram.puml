@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Modern Claims Platform

Person(EndCustomers, "End Customers", "Insured individuals submitting and tracking claims.")
Person(Brokers, "Brokers", "Intermediaries assisting customers with claims processing.")
Person(ClaimsAdjusters, "Claims Adjusters", "Professionals reviewing, investigating, and settling claims.")
Person(BusinessOperationsManagers, "Business Operations Managers", "Managers overseeing claims operations, dashboards, and workflows.")
Person(MigrationAdmins, "Migration Admins", "Administrators managing the hybrid migration process.")

System_Ext(AzureEntraID, "Azure Entra ID", "Identity provider handling Single Sign-On and Role-Based Access Control.")
System_Ext(OnPremisesCOBOLDB2Mainframe, "On-Premises COBOL/DB2 Mainframe", "Legacy System of Record acting as the backend during the 3-year migration phase.")

System_Boundary(ModernClaimsPlatform, "Modern Claims Platform") {
    Container(AzureStaticWebApps, "Azure Static Web Apps", "Angular/React Single Page Application", "Hosts the SPA frontend for fast global delivery and user interactions.")
    Container(AzureAPIManagement, "Azure API Management", "Azure API Management (APIM)", "Enforces OIDC/OAuth2 authentication and dynamic routing for claim-type migration.")
    Container(AzureKubernetesService, "Azure Kubernetes Service", "Node.js/Java microservices", "Runs containerized microservices and backend-for-frontend (BFF) components.")
    Container(AzureServiceBus, "Azure Service Bus", "Azure Service Bus", "Provides reliable asynchronous messaging for the Anti-Corruption Layer (ACL).")
    ContainerDb(AzureSQLDatabase, "Azure SQL Database", "Azure SQL Database", "Stores modern claim types with encryption at rest.")
    Container(AnalyticsPlatform, "Analytics Platform", "Azure Event Hubs, Stream Analytics, Synapse Analytics, Power BI Embedded", "Ingests CDC streams and operational metrics for auditing and reporting.")
}

Rel(EndCustomers, AzureStaticWebApps, "Accesses UI and interacts with the platform", "HTTPS")
Rel(Brokers, AzureStaticWebApps, "Accesses UI and manages client claims", "HTTPS")
Rel(ClaimsAdjusters, AzureStaticWebApps, "Accesses UI to review and process claims", "HTTPS")
Rel(BusinessOperationsManagers, AzureStaticWebApps, "Accesses Dashboard Container and operational metrics", "HTTPS")
Rel(MigrationAdmins, AzureStaticWebApps, "Manages migration administration", "HTTPS")

Rel(AzureStaticWebApps, AzureAPIManagement, "Routes API requests", "HTTPS / REST APIs")
Rel(AzureAPIManagement, AzureKubernetesService, "Forwards requests to backend microservices", "HTTPS / REST APIs")
Rel(AzureKubernetesService, AzureSQLDatabase, "Reads and writes modern claim data", "TDS / SQL")
Rel(AzureKubernetesService, AzureServiceBus, "Publishes and consumes asynchronous messages via ACL", "AMQP")
Rel(AzureAPIManagement, AzureServiceBus, "Sends asynchronous integration messages", "AMQP")
Rel(AzureServiceBus, OnPremisesCOBOLDB2Mainframe, "Communicates with legacy system securely", "mTLS over IPsec VPN / ExpressRoute")
Rel(AzureAPIManagement, OnPremisesCOBOLDB2Mainframe, "Integrates with legacy backend", "mTLS over IPsec VPN / ExpressRoute")
Rel(AzureKubernetesService, AnalyticsPlatform, "Streams operational events and CDC data", "Internal event streaming")
Rel(AzureSQLDatabase, AnalyticsPlatform, "Feeds data for auditing and reporting", "Internal data streams")

@enduml