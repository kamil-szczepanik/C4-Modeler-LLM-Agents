@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(azure_sql_database, "Azure SQL Database") {
    Component(claim_transactional_store, "Claim Transactional Store", "Azure SQL Database", "Stores active claims and transactions, executing parameterized SQL queries via TDS / SQL over TLS 1.3.")
    Component(integration_staging_store, "Integration Staging Store", "Azure SQL Database", "Staging area that syncs delta changes asynchronously with the legacy mainframe via Change Data Capture (CDC).")
    Component(row_level_security, "Row-Level Security & Access Management", "Azure SQL Database Security", "Manages fine-grained data access and integrates with Microsoft Entra ID.")
    Component(temporal_tables, "Temporal Tables (System-Versioned)", "Azure SQL Database Feature", "Tracks historical changes automatically to satisfy strict auditability requirements.")
    Component(database_auditing, "Azure SQL Database-Level Auditing", "Azure Storage / Log Analytics", "Writes security and operational logs for auditing purposes.")
}

Rel(claim_transactional_store, row_level_security, "Enforces access control and authentication", "Microsoft Entra ID managed identities")
Rel(claim_transactional_store, temporal_tables, "Automatically records historical versioning", "System-Versioned")
Rel(claim_transactional_store, database_auditing, "Writes security logs", "TDS / Internal")
Rel(integration_staging_store, claim_transactional_store, "Provides delta changes via Change Data Capture (CDC)", "CDC")

@enduml