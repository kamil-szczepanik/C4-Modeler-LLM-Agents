@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure API Management container

System_Ext(Azure_Kubernetes_Service, "Azure Kubernetes Service", "Modern microservices platform")
System_Ext(On_Premises_COBOL_DB2_Mainframe, "On-Premises COBOL/DB2 Mainframe", "Legacy mainframe system")
System_Ext(Azure_Entra_ID, "Azure Entra ID", "Identity provider for OIDC/OAuth2 tokens")
System_Ext(Azure_Application_Insights, "Azure Application Insights", "Telemetry and metrics collection")

Container_Boundary(Azure_API_Management, "Azure API Management") {
    Component(API_Gateway_Component, "API Gateway Component", "Azure API Management Edge Proxy", "Performs edge proxy functions, JWT validation, and rate-limiting, and routes traffic between modern and legacy systems.")
    Component(Policy_Engine_Component, "Policy Engine Component", "Azure API Management Policy Engine", "Handles XML dynamic routing and correlation ID injection.")
}

Rel(API_Gateway_Component, Azure_Kubernetes_Service, "Forwards modernized claim requests", "HTTPS / REST")
Rel(API_Gateway_Component, On_Premises_COBOL_DB2_Mainframe, "Routes legacy traffic", "mTLS over ExpressRoute / IPsec VPN")
Rel(API_Gateway_Component, Azure_Entra_ID, "Validates OIDC/OAuth2 tokens", "HTTPS / REST")
Rel(Policy_Engine_Component, Azure_Application_Insights, "Streams sanitized telemetry and metrics", "HTTPS")

@enduml