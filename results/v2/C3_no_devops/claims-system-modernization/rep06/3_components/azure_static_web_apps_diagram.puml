@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Static Web Apps container

Container_Boundary(azure_static_web_apps, "Azure Static Web Apps") {
    Component(spa_router, "SPA Router & View Modules", "Angular/React", "Powers dynamic single-page application interfaces and role-based routing.")
    Component(auth_manager, "Auth & Session Manager", "Azure Entra ID / SWA Authentication", "Provides single sign-on (SSO) integration and manages user sessions.")
    Component(api_proxy, "API Proxy / Fallback", "HTTPS / REST", "Proxies requests from the frontend to backend APIs and fallback mechanisms.")
    Component(config_service, "Configuration & Feature Flag Service", "Client-side configuration", "Manages application configuration and feature flags for gradual migration.")
    Component(telemetry_client, "Telemetry Client", "Azure Application Insights", "Tracks real-user metrics (RUM) and performance for adjuster screens.")
}

System_Ext(azure_entra_id, "Azure Entra ID", "Provides identity and access management.")
System_Ext(azure_apim, "Azure API Management", "Manages and secures REST APIs.")
System_Ext(azure_app_insights, "Azure Application Insights", "Application performance management and telemetry.")

Rel(spa_router, auth_manager, "Validates sessions and tokens", "In-memory / HTTPS")
Rel(spa_router, api_proxy, "Sends API requests", "HTTPS")
Rel(auth_manager, azure_entra_id, "Authenticates users via OAuth / OIDC", "OAuth / OIDC")
Rel(api_proxy, azure_apim, "Forwards requests to REST APIs via HTTPS", "HTTPS / REST")
Rel(telemetry_client, azure_app_insights, "Sends telemetry data via HTTPS", "HTTPS")

@enduml