@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(aks_sql, "Azure Kubernetes Service / Azure SQL Database", "External Systems", "Source systems emitting CDC streams.")

Container_Boundary(analytics_platform, "Analytics Platform") {
    Component(azure_event_hubs, "Azure Event Hubs", "Azure Event Hubs", "Ingests real-time CDC streams using AMQP for high throughput.")
    Component(azure_stream_analytics, "Azure Stream Analytics", "Azure Stream Analytics", "Processes in-transit validation checks to satisfy R-04.")
    Component(azure_synapse_analytics, "Azure Synapse Analytics", "Azure Synapse Analytics (Dedicated SQL Pool)", "Stores historical claim metrics with Row-Level Security and dynamic data masking.")
    Component(power_bi_embedded, "Power BI Embedded", "Power BI Embedded", "Renders the Migration Executive Dashboard with Azure Entra ID SSO.")
    Component(azure_functions, "Azure Functions", "Azure Functions", "Executes serverless reconciliation logic without custom ETL infrastructure.")
}

Component(azure_key_vault, "Azure Key Vault", "Azure Key Vault and Log Analytics", "Secures secrets and provides logging capabilities.")

Rel(aks_sql, azure_event_hubs, "AMQP over TLS 1.3", "AMQP over TLS 1.3")
Rel(azure_event_hubs, azure_stream_analytics, "Stream data", "Internal")
Rel(azure_stream_analytics, azure_synapse_analytics, "Processed data", "Internal")
Rel(azure_functions, azure_synapse_analytics, "T-SQL via TDS/TLS 1.3", "T-SQL / TDS")
Rel(azure_synapse_analytics, power_bi_embedded, "Direct Query / HTTPS via TLS 1.3", "HTTPS")
Rel(analytics_platform, azure_key_vault, "Managed Identity / HTTPS", "HTTPS")
@enduml