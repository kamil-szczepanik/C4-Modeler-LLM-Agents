@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(azure_kubernetes_service, "Azure Kubernetes Service") {
    Component(api_gateway_bff, "API Gateway / BFF", "Node.js", "Handles UI composition and forwards requests from Azure API Management.")
    Component(claim_processing_domain_services, "Claim Processing Domain Services", "Java / Spring Boot", "Implements CQRS domain services for claim processing and interacts with data stores.")
    Component(mainframe_anti_corruption_layer_acl_adapter, "Mainframe Anti-Corruption Layer (ACL) Adapter", "Microservices / Custom Adapter", "Decouples legacy mainframe latency and handles asynchronous messaging.")
}

Rel(api_gateway_bff, claim_processing_domain_services, "Internal communication", "gRPC / HTTP/2")
Rel(claim_processing_domain_services, mainframe_anti_corruption_layer_acl_adapter, "Asynchronous messaging", "AMQP / AMQPS")
@enduml