@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Service Bus container

System_Ext(aks, "Azure Kubernetes Service", "Host for Node.js/Java microservices interacting with the bus")
System_Ext(apim, "Azure API Management", "API Gateway")
System_Ext(mainframe, "On-Premises COBOL/DB2 Mainframe", "Legacy insurance mainframe claims system")

Container_Boundary(azure_service_bus, "Azure Service Bus") {
    Component(claim_migration_topic, "Claim Migration Topic & Subscriptions", "Azure Service Bus Pub/Sub", "Pub/sub engine with session-based ordering for incremental claim-type routing.")
    Component(mainframe_sync_queue, "Mainframe Sync Queue", "Azure Service Bus Partitioned Queue", "Partitioned, transactional queue with duplicate detection for guaranteed consistency.")
    Component(dlq, "Dead-Letter Queue (DLQ)", "Azure Service Bus DLQ", "Automated capture mechanism for poisoned messages and batch window lockouts.")
}

Rel(aks, claim_migration_topic, "Publishes and consumes asynchronous messages", "AMQP 1.0 over TLS 1.3")
Rel(apim, claim_migration_topic, "Sends asynchronous integration messages", "AMQP 1.0")
Rel(mainframe_sync_queue, mainframe, "Communicates legacy synchronization", "mTLS over IPsec VPN / ExpressRoute")

@enduml