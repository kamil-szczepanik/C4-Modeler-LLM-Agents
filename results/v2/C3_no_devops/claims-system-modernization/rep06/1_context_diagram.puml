@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Modern Claims Platform

Person(EndCustomers, "End Customers", "Insured individuals submitting and tracking claims.")
Person(Brokers, "Brokers", "Intermediaries assisting customers with claims processing.")
Person(ClaimsAdjusters, "Claims Adjusters", "Professionals reviewing, investigating, and settling claims.")
Person(BusinessOperationsManagers, "Business Operations Managers", "Managers overseeing claims operations and workflows.")
Person(MigrationAdmins, "Migration Admins", "Administrators managing the hybrid migration process.")

System(ModernClaimsPlatform, "Modern Claims Platform", "A hybrid system modernizing a regional insurer's claims platform by gradually migrating claim types from a legacy mainframe to Azure while maintaining seamless coexistence.")

System_Ext(InsurerActiveDirectoryAzureEntraID, "Insurer Active Directory / Azure Entra ID", "Identity provider handling user authentication and single sign-on.")
System_Ext(LegacyPaymentGateway, "Legacy Payment Gateway", "External system responsible for executing claim payouts.")
System_Ext(LegacyMainframeOnPremises, "Legacy Mainframe (On-Premises)", "COBOL/DB2 System of Record acting as the backend system during the 3-year migration phase.")

Rel(EndCustomers, ModernClaimsPlatform, "Accesses and interacts with the claims platform", "HTTPS/TLS 1.3 with OAuth 2.0 / OIDC")
Rel(Brokers, ModernClaimsPlatform, "Manages and tracks client claims", "HTTPS/TLS 1.3 with OAuth 2.0 / OIDC")
Rel(ClaimsAdjusters, ModernClaimsPlatform, "Reviews and processes claims", "HTTPS/TLS 1.3 with OAuth 2.0 / OIDC")
Rel(BusinessOperationsManagers, ModernClaimsPlatform, "Monitors operations and reports", "HTTPS/TLS 1.3 with OAuth 2.0 / OIDC")
Rel(MigrationAdmins, ModernClaimsPlatform, "Configures and manages the migration", "HTTPS/TLS 1.3 with OAuth 2.0 / OIDC")
Rel(ModernClaimsPlatform, InsurerActiveDirectoryAzureEntraID, "Authenticates users via SSO", "OIDC")
Rel(ModernClaimsPlatform, LegacyMainframeOnPremises, "Communicates asynchronously and securely for data synchronization", "Azure Service Bus with encrypted payloads and mTLS")

@enduml