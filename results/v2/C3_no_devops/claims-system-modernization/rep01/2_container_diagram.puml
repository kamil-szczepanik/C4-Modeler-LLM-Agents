@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Hybrid Insurance Claims Modernization Platform

Person(End_Customers, "End Customers", "External end users submitting claims.")
Person(Brokers, "Brokers", "External partners interacting with the platform.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal users reviewing and managing claims.")
Person(Compliance_Audit_Officers, "Compliance/Audit Officers", "Internal users monitoring compliance and audit trails.")
Person(Migration_Support_Operations_Team, "Migration Support/Operations Team", "Internal team managing system operations and migration support.")

System_Ext(Legacy_Mainframe, "Legacy Mainframe", "On-premise COBOL/DB2 system of record.")
System_Ext(Corporate_Active_Directory, "Corporate Active Directory", "Entra ID used for authentication and authorization.")
System_Ext(Enterprise_Service_Bus, "Enterprise Service Bus", "ESB facilitating integration across networks.")
System_Ext(Audit_Compliance_System, "Audit & Compliance System", "External system for audit logs and compliance verification.")

System_Boundary(Hybrid_Insurance_Claims_Modernization_Platform, "Hybrid Insurance Claims Modernization Platform") {
    Container(Web_Application, "Web Application", "React / Node.js on Azure App Service", "Provides the user interface for customers, brokers, and adjusters.")
    Container(API_Gateway, "API Gateway", ".NET / YARP on Azure Container Apps", "Handles dynamic routing, feature flagging, and edge security.")
    Container(Claims_Core_Domain_Service, "Claims Core Domain Service", ".NET Core", "Implements business logic for claims processing.")
    ContainerDb(Read_Model_Caching_Store, "Read-Model & Caching Store", "Azure Cosmos DB / Redis", "Provides asynchronous read-models and caching for fast screen loads.")
    Container(Integration_Sync_Worker, "Integration & Sync Worker", "Azure Functions", "Delivers reliable asynchronous eventing and mainframe synchronization.")
    ContainerDb(Azure_SQL_Database, "Azure SQL Database", "Azure SQL", "Modern transactional data store for migrated claims.")
    Container(Azure_Key_Vault, "Azure Key Vault", "Azure Key Vault", "Manages secrets dynamically via managed identities.")
}

Rel(End_Customers, Web_Application, "Accesses via public internet", "HTTPS/JSON")
Rel(Brokers, Web_Application, "Accesses via public internet", "HTTPS/JSON")
Rel(Claims_Adjusters, Web_Application, "Accesses claims screens", "HTTPS/JSON")
Rel(Compliance_Audit_Officers, Web_Application, "Reviews audit data", "HTTPS/JSON")
Rel(Migration_Support_Operations_Team, Web_Application, "Monitors operations", "HTTPS/JSON")

Rel(Web_Application, Corporate_Active_Directory, "Authenticates users", "OpenID Connect / OAuth 2.0")
Rel(Web_Application, API_Gateway, "Forwards requests with token propagation", "HTTPS/JSON")
Rel(API_Gateway, Claims_Core_Domain_Service, "Routes requests to core services", "gRPC/REST with mTLS")
Rel(Claims_Core_Domain_Service, Azure_SQL_Database, "Reads and writes transactional data", "TCP/TLS")
Rel(Claims_Core_Domain_Service, Read_Model_Caching_Store, "Queries read-models and cache", "TCP/TLS")
Rel(Integration_Sync_Worker, Enterprise_Service_Bus, "Sends and receives asynchronous messages", "Azure Service Bus via IPsec VPN/ExpressRoute")
Rel(Enterprise_Service_Bus, Legacy_Mainframe, "Synchronizes legacy data", "COBOL/DB2 Messaging")
Rel(Claims_Core_Domain_Service, Azure_Key_Vault, "Retrieves secrets and keys", "Managed Identity / HTTPS")

@enduml