@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(End_Customers_Brokers, "End Customers & Brokers", "External users submitting online claims.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal users utilizing the web application for claims processing.")
Person(Compliance_Audit_Officers, "Compliance/Audit Officers", "Internal users reviewing audit and compliance logs.")

System(Hybrid_Insurance_Claims_Modernization_Platform, "Hybrid Insurance Claims Modernization Platform", "A hybrid insurance claims modernization platform that gradually migrates functionality from a legacy mainframe to Azure cloud services to maintain business continuity.")

System_Ext(Legacy_Mainframe, "Legacy Mainframe", "On-premise COBOL/DB2 system of record.")
System_Ext(Corporate_Active_Directory, "Corporate Active Directory", "Identity Provider for Single Sign-On.")
System_Ext(Integration_ESB_Layer, "Integration / ESB Layer", "On-premise secure gateway for hybrid communication.")
System_Ext(Audit_Compliance_System, "Audit & Compliance System", "Hybrid log aggregator with WORM storage for immutable compliance logs.")

Rel(End_Customers_Brokers, Hybrid_Insurance_Claims_Modernization_Platform, "Submit online claims", "HTTPS (REST/GraphQL)")
Rel(Claims_Adjusters, Hybrid_Insurance_Claims_Modernization_Platform, "Access the claims web application", "HTTPS")
Rel(Hybrid_Insurance_Claims_Modernization_Platform, Corporate_Active_Directory, "Authenticate users via Single Sign-On", "OIDC/OAuth2")
Rel(Hybrid_Insurance_Claims_Modernization_Platform, Integration_ESB_Layer, "Send and receive asynchronous messages securely", "AMQP/HTTPS over mTLS")
Rel(Integration_ESB_Layer, Legacy_Mainframe, "Process data via optimized batch/MQ protocols", "Batch/MQ protocols")
Rel(Hybrid_Insurance_Claims_Modernization_Platform, Audit_Compliance_System, "Stream audit events", "Syslog/Audit event streams")
Rel(Legacy_Mainframe, Audit_Compliance_System, "Stream audit events", "Syslog/Audit event streams")

@enduml