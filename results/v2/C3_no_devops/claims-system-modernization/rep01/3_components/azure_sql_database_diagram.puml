@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure SQL Database container

System_Ext(Claims_Core_Domain_Service, "Claims Core Domain Service", "External service interacting with the database.")
System_Ext(Integration_Sync_Worker, "Integration & Sync Worker", "External sync worker service.")
System_Ext(Azure_Key_Vault, "Azure Key Vault", "External key vault for encryption keys.")

Container_Boundary(Azure_SQL_Database, "Azure SQL Database") {
    Component(Schema_Domain_Partitioning_Engine, "Schema Domain Partitioning Engine", "Azure SQL Database Schemas", "Partitions the domain data to isolate legacy and modern claims structures.")
    Component(Temporal_Data_Tables, "Temporal Data Tables", "System-Versioned Temporal Tables", "Automates audit tracking natively without application-level overhead.")
    Component(Change_Data_Capture_CDC_Component, "Change Data Capture (CDC) Component", "Azure SQL CDC", "Exposes low-latency transaction logs for reliable data synchronization.")
    Component(Row_Level_Security_RLS_Policy_Engine, "Row-Level Security (RLS) Policy Engine", "Azure SQL RLS", "Enforces data jurisdiction boundaries directly at the database layer.")
    Component(Elastic_Pool_Management_Component, "Elastic Pool Management Component", "Azure SQL Elastic Pools", "Manages database resources dynamically across multi-tenant workloads.")
}

Rel(Claims_Core_Domain_Service, Row_Level_Security_RLS_Policy_Engine, "Queries transactional data", "Tabular Data Stream (TDS) over TLS 1.3 via Managed Identity")
Rel(Integration_Sync_Worker, Change_Data_Capture_CDC_Component, "Streams delta changes", "TDS over TLS 1.3 via Managed Identity")
Rel(Azure_SQL_Database, Azure_Key_Vault, "Retrieves customer-managed encryption keys", "HTTPS / REST")

@enduml