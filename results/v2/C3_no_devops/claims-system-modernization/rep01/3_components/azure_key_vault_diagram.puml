@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Key Vault container

System_Ext(Claims_Core_Domain_Service, "Claims Core Domain Service", "External service that consumes secrets and keys.")
System_Ext(Azure_Event_Grid, "Azure Event Grid", "Event routing service.")
System_Ext(Azure_Monitor, "Azure Monitor", "Monitoring and logging service.")
System_Ext(Audit_Compliance_System, "Audit & Compliance System", "External compliance and audit system.")

Container_Boundary(Azure_Key_Vault, "Azure Key Vault") {
    Component(Secrets_Management_Component, "Secrets Management Component", "Azure Key Vault Secrets", "Manages and provides access to database and API credentials securely.")
    Component(Key_Management_Component, "Key Management Component", "Azure Key Vault Premium HSM-backed", "Provides HSM-backed cryptographic keys for PII encryption at rest.")
    Component(Access_Control_Audit_Component, "Access Control & Audit Component", "Azure RBAC & Azure Monitor", "Enforces least-privilege access and monitors audit logs.")
    Component(Secret_Rotation_Component, "Secret Rotation Component", "Azure Event Grid & Azure Functions", "Automates zero-downtime secret rotation based on expiration events.")
}

Rel(Claims_Core_Domain_Service, Secrets_Management_Component, "Retrieves database and API credentials", "HTTPS / Managed Identity (TLS 1.3)")
Rel(Claims_Core_Domain_Service, Key_Management_Component, "Requests cryptographic keys for PII encryption at rest", "HTTPS / Managed Identity (TLS 1.3)")
Rel(Secrets_Management_Component, Azure_Event_Grid, "Emits secret expiration events")
Rel(Azure_Event_Grid, Secret_Rotation_Component, "Triggers automated credential rotation", "Managed Identity")
Rel(Azure_Monitor, Audit_Compliance_System, "Exports security and audit logs", "syslog / Event Hubs")

@enduml