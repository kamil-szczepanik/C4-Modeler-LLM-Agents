@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Read-Model & Caching Store container

Container_Boundary(read_model_caching_store, "Read-Model & Caching Store") {
    Component(Projection_Consumer_Component, "Projection Consumer Component", ".NET Background Service", "Consumes domain events from the integration worker for event processing.")
    Component(Query_API_Component, "Query API Component", ".NET Minimal API", "Exposes optimized query endpoints for the claims core domain service.")
    Component(Distributed_Cache_Component, "Distributed Cache Component", "Azure Redis Cache", "Handles ephemeral sessions and hot read-models with strict TTLs.")
    Component(Document_Store_Component, "Document Store Component", "Azure Cosmos DB - SQL API", "Persists schema-less JSON read models to handle mixed data structures.")
}

Rel(Projection_Consumer_Component, Document_Store_Component, "Persists projected events into the document store")
Rel(Query_API_Component, Distributed_Cache_Component, "Retrieves cached hot read-models")
Rel(Query_API_Component, Document_Store_Component, "Queries persistent read-models")

@enduml