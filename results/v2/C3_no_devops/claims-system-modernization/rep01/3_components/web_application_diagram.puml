@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application container

System_Ext(CorporateActiveDirectory, "Corporate Active Directory", "Authenticates users [OpenID Connect / OAuth 2.0]")
System_Ext(ApiGateway, "API Gateway", "Proxies domain requests with token propagation [HTTPS/JSON]")

Container_Boundary(WebApplication, "Web Application") {
    Component(ReactSPAAClient, "React SPA Client", "React & TypeScript", "Client-side user interface delivering high performance and responsiveness for end customers, brokers, and claims adjusters.")
    Component(NodeJSBFF, "Node.js BFF", "Node.js (Backend-for-Frontend)", "Manages secure session tokens, server-side validation, and proxies requests between the SPA and backend.")
}

Rel(ReactSPAAClient, NodeJSBFF, "Sends API requests and handles user interactions", "HTTPS/JSON")
Rel(NodeJSBFF, CorporateActiveDirectory, "Authenticates users", "OpenID Connect / OAuth 2.0")
Rel(NodeJSBFF, ApiGateway, "Proxies domain requests with token propagation", "HTTPS/JSON")

@enduml