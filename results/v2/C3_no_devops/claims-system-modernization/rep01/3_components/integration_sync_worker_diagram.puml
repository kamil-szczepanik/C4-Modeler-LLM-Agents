@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(SupportTeam, "Support Team", "Business Operations / Support Team")
System_Ext(EnterpriseServiceBus, "Enterprise Service Bus", "Enterprise Service Bus (ESB)")

Container_Boundary(IntegrationSyncWorker, "Integration & Sync Worker") {
    Component(MainframeAdapterComponent, "Mainframe Adapter Component", ".NET Isolated Worker (.NET)", "Handles legacy payload transmission and interfaces with the mainframe.")
    Component(SyncOrchestratorComponent, "Sync Orchestrator Component", ".NET Isolated Worker (.NET)", "Orchestrates transactional state and idempotency tracking.")
    Component(DeadLetterAuditHandlerComponent, "Dead-Letter & Audit Handler Component", ".NET Isolated Worker (.NET)", "Manages failed messages and audit logging.")
    Component(ReplayAPIControllerComponent, "Replay API Controller Component", ".NET Isolated Worker (.NET)", "Handles manual transaction recovery requests from the support team.")
    ComponentDb(StateDeduplicationStore, "State & Deduplication Store", "Azure SQL Database", "Tracks transactional state, outbox pattern, and idempotency deduplication.")
}

Rel(MainframeAdapterComponent, EnterpriseServiceBus, "Legacy payload transmission", "mTLS, IPsec encryption")
Rel(SupportTeam, ReplayAPIControllerComponent, "Manual transaction recovery", "HTTPS via TLS 1.3, Azure Entra ID token validation")
Rel(SyncOrchestratorComponent, StateDeduplicationStore, "Transactional state and idempotency tracking", "ADO.NET / Entity Framework Core")
@enduml