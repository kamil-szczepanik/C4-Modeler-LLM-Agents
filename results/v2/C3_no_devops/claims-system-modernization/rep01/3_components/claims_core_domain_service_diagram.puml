@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Ext(api_gateway, "API Gateway", "Azure Gateway", "Routes incoming validated JWT requests via gRPC/REST with mTLS.")
ContainerDb(azure_sql_database, "Azure SQL Database", "Azure SQL", "Stores transactional data using TCP/TLS 1.3 with TDE.")
Container_Ext(azure_key_vault, "Azure Key Vault", "Azure Key Vault", "Retrieves encryption keys and secrets via Managed Identity and HTTPS.")
Container_Ext(azure_monitor, "Azure Monitor", "Azure Monitor / OpenTelemetry", "Ships scrubbed operational metrics and audit logs via OpenTelemetry.")

Container_Boundary(claims_core_domain_service, "Claims Core Domain Service") {
    Component(claim_management_controller, "Claim Management Controller", "REST / gRPC (.NET 8)", "Exposes REST/gRPC endpoints secured via mTLS for handling write and read operations.")
    Component(claim_domain_model_engine, "Claim Domain Model & Engine", "C# / .NET 8 (Domain-Driven Design)", "Implements tactical Domain-Driven Design aggregates and value objects for insurance logic.")
    Component(claim_routing_policy_engine, "Claim Routing & Policy Engine", "C# / .NET 8", "Evaluates feature flags and rules per claim type to dynamically route execution paths.")
    Component(data_access_repository, "Data Access Repository", "Entity Framework Core (.NET 8)", "Abstracts persistence over Azure SQL Database using Entity Framework Core.")
    Component(telemetry_domain_event_dispatcher, "Telemetry & Domain Event Dispatcher", "OpenTelemetry / .NET ILogger", "Emits sanitized structured domain events and telemetry.")
}

Rel(api_gateway, claim_management_controller, "Routes incoming validated JWT requests via gRPC/REST with mTLS.", "gRPC/REST")
Rel(claim_management_controller, claim_domain_model_engine, "Delegates core insurance logic processing.", ".NET Method Call")
Rel(claim_management_controller, claim_routing_policy_engine, "Evaluates feature flags and dynamic routing rules.", ".NET Method Call")
Rel(claim_domain_model_engine, data_access_repository, "Persists and retrieves domain aggregates.", ".NET Method Call")
Rel(data_access_repository, azure_sql_database, "Reads and writes transactional data using TCP/TLS 1.3 with TDE.", "TCP/TLS 1.3")
Rel(claim_management_controller, azure_key_vault, "Retrieves encryption keys and secrets via Managed Identity and HTTPS.", "HTTPS")
Rel(telemetry_domain_event_dispatcher, azure_monitor, "Ships scrubbed operational metrics and audit logs via OpenTelemetry.", "OpenTelemetry")
@enduml