@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(OperationsMigrationManagers, "Operations/Migration Managers", "Manages routing rules and emergency rollbacks using HTTPS / Azure AD RBAC.")

System_Ext(AzureAPIManagement, "Azure API Management", "Exposes endpoints for evaluating claim destinations.")
System_Ext(AzureKeyVault, "Azure Key Vault", "Secure storage for salts and customer-managed keys.")
System_Ext(AzureMonitorSentinel, "Azure Monitor / Sentinel", "Provides monitoring and security logging.")

Container_Boundary(MigrationControlRoutingEngine, "Migration Control & Routing Engine") {
    Component(RoutingRulesEvaluator, "Routing Rules Evaluator", "Azure Function", "Evaluates claim destination and delegates canary and temporal cohorts.")
    Component(MigrationRegistryStore, "Migration Registry Store", "Azure Cosmos DB", "Stores active routing flags, schedules, and migration registry state.")
    Component(ControlPlaneAPI, "Control Plane API", "Azure Function", "Manages routing rules, feature flags, and emergency rollbacks.")
    Component(TrafficSplitterScheduler, "Traffic Splitter & Scheduler", "Azure Function", "Handles canary traffic splitting and temporal cohorts.")
}

Rel(OperationsMigrationManagers, ControlPlaneAPI, "Manages routing rules and emergency rollbacks", "HTTPS / Azure AD RBAC")
Rel(AzureAPIManagement, RoutingRulesEvaluator, "Evaluates claim destination", "REST / HTTPS")
Rel(RoutingRulesEvaluator, MigrationRegistryStore, "Reads active routing flags", "Cosmos DB SDK / TLS 1.3")
Rel(RoutingRulesEvaluator, TrafficSplitterScheduler, "Delegates canary and temporal cohorts", "Internal Function-to-Function / VNet Integration")
Rel(ControlPlaneAPI, MigrationRegistryStore, "Persists schedules and feature flags", "Cosmos DB SDK")

@enduml