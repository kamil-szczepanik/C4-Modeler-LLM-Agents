@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Key Vault container

Person(DevOps_Security_Engineers, "DevOps & Security Engineers", "Human Actor", "Personnel responsible for configuring, managing, and monitoring security policies and access controls within the Azure Key Vault system.")

System_Ext(Claims_Processing_Core, "Claims Processing Core", "External System")
System_Ext(Audit_Reconciliation_Ledger, "Audit & Reconciliation Ledger", "External System")
System_Ext(Customer_Portal, "Customer Portal", "External System")
System_Ext(Adjuster_Workspace, "Adjuster Workspace", "External System")
System_Ext(Azure_Monitor_Sentinel, "Azure Monitor / Sentinel", "External System")

Container_Boundary(Azure_Key_Vault, "Azure Key Vault") {
    Component(Secrets_Management_Component, "Secrets Management Component", "Azure Key Vault Secrets", "Provides secure secret management for the Insurance Claims Modernization platform, protecting sensitive customer PII and legacy mainframe hybrid integration.")
    Component(Keys_HSM_Management_Component, "Keys (HSM) Management Component", "Azure Key Vault Managed HSM", "Manages cryptographic keys backed by hardware security modules (HSMs).")
    Component(Certificates_Management_Component, "Certificates Management Component", "Azure Key Vault Certificates", "Automates and manages SSL/TLS certificates and lifecycle operations.")
    Component(Telemetry_Audit_Logging_Component, "Telemetry & Audit Logging Component", "Azure Monitor Diagnostic Settings", "Streams audit logs and telemetry for compliance, alerting, and operational safety.")
}

Rel(Claims_Processing_Core, Secrets_Management_Component, "HTTPS (REST API) using Azure Managed Identities")
Rel(Audit_Reconciliation_Ledger, Keys_HSM_Management_Component, "Azure RBAC for Customer-Managed Keys (CMK)")
Rel(Customer_Portal, Certificates_Management_Component, "TLS 1.3")
Rel(Adjuster_Workspace, Certificates_Management_Component, "TLS 1.3")
Rel(Telemetry_Audit_Logging_Component, Azure_Monitor_Sentinel, "HTTPS/AMQP")

@enduml