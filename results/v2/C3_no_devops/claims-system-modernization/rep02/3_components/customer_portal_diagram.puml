@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Customer Portal container

System_Ext(Azure_API_Management, "Azure API Management", "Secures and rate-limits backend API traffic.")

Container_Boundary(Customer_Portal, "Customer Portal") {
    Component(Claim_Submission_Controller, "Claim Submission Controller", "React Component", "Handles the online claims submission process for end customers and brokers.")
    Component(Status_Dashboard_View, "Status Dashboard View", "React Component", "Allows users to track claim statuses and view submission histories.")
    Component(Auth_Client_Module, "Auth Client Module", "MSAL.js", "Implements secure in-memory token handling via OAuth 2.0 Authorization Code Flow with PKCE.")
    Component(Feedback_Support_Widget, "Feedback & Support Widget", "React Component / Tailwind CSS", "Provides support and feedback mechanisms for users within the portal.")
}

Rel(Claim_Submission_Controller, Azure_API_Management, "Submits claims and synchronizes drafts", "HTTPS/REST (OAuth 2.0 / OpenID Connect with PKCE)")
Rel(Status_Dashboard_View, Azure_API_Management, "Fetches status updates", "HTTPS/REST (OAuth 2.0 / OpenID Connect with PKCE)")
Rel(Auth_Client_Module, Azure_API_Management, "Authenticates requests and manages tokens securely", "OAuth 2.0 / OpenID Connect")

@enduml