@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Adjuster Workspace container

Person(Claims_Adjusters, "Claims Adjusters & Customer Support Agents", "Users who process insurance claims and interact with the Adjuster Workspace.")

System_Ext(Azure_API_Management, "Azure API Management", "External API gateway routing calls to downstream microservices and legacy systems.")

Container_Boundary(Adjuster_Workspace, "Adjuster Workspace") {
    Component(Adjuster_UI, "Adjuster UI", "React SPA, Azure Static Web Apps", "Frontend framework providing a responsive UI rendering for claims adjusters and support agents.")
    Component(Adjuster_BFF_API_Gateway, "Adjuster BFF / API Gateway", "Node.js, Express", "Backend-for-Frontend (BFF) handling session management, aggregation, and security.")
    Component(Claim_View_Cache, "Claim View Cache", "Azure Redis Cache", "In-memory caching layer to meet strict performance targets by pre-fetching data.")
    Component(Integration_Client, "Integration Client", "gRPC / HTTP Client", "Client handling communication with external services and integration endpoints.")
}

Rel(Claims_Adjusters, Adjuster_UI, "HTTPS", "")
Rel(Adjuster_UI, Adjuster_BFF_API_Gateway, "HTTPS / REST", "")
Rel(Adjuster_BFF_API_Gateway, Claim_View_Cache, "Redis Protocol over TLS", "")
Rel(Adjuster_BFF_API_Gateway, Azure_API_Management, "HTTPS / gRPC with OAuth 2.0", "")
@enduml