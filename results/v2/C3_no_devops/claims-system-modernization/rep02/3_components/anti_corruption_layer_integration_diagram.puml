@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Anti-Corruption Layer & Integration container

Person(Operations_Migration_Managers, "Operations/Migration Managers", "Internal users who access failure metrics via Azure AD SSO and RBAC.")
System_Ext(Legacy_Mainframe_System, "Legacy Mainframe System", "The legacy mainframe system communicating via IBM MQ.")

Container_Boundary(Anti_Corruption_Layer_Integration, "Anti-Corruption Layer & Integration") {
    Component(Route_Mediator, "Route Mediator", "Apache Camel", "Handles content-based routing and domain event translation.")
    Component(Mainframe_Adapter, "Mainframe Adapter", "JCA/MQ Client", "Interfaces with the legacy mainframe system using IBM MQ over mTLS with circuit breakers.")
    Component(Dead_Letter_Audit_Handler, "Dead-Letter & Audit Handler", "Azure Functions & Azure SQL Ledger", "Manages dead-letter queues and provides tamper-resistant, immutable audit logging for compliance and consistency (R-04).")
}

Rel(Route_Mediator, Mainframe_Adapter, "Internal Reactive Streams / In-memory Queue")
Rel(Mainframe_Adapter, Legacy_Mainframe_System, "IBM MQ (AMQP/JMS) over mTLS with circuit breakers", "IBM MQ")
Rel(Route_Mediator, Dead_Letter_Audit_Handler, "Azure Service Bus Dead-Letter Queues and Azure Event Grid")
Rel(Operations_Migration_Managers, Dead_Letter_Audit_Handler, "Azure AD SSO (R-07) and RBAC for failure metrics")

@enduml