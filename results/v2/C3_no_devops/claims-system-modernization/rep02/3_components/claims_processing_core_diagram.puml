@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(claims_processing_core, "Claims Processing Core") {
    Component(Claim_Ingestion___Validation_Component, "Claim Ingestion & Validation Component", "Spring Boot container", "Handling payload validation against domain schemas.")
    Component(Workflow_Orchestrator, "Workflow Orchestrator", "Java / Spring Boot", "Manages multi-step claim lifecycles and idempotent processing.")
    Component(Claim_State_Service, "Claim State Service", "Spring Data JPA", "Managing domain aggregates and exposing transaction state markers.")
    Component(Legacy_Adapter_Component, "Legacy Adapter Component", "Apache Camel and Spring Integration", "Translating domain models and synchronizing with the Enterprise Service Bus.")
    Component(Audit___Reconciliation_Ledger, "Audit & Reconciliation Ledger", "Database / Transaction Log", "Records immutable state transition events and synchronization logs.")
}

Rel(Claim_Ingestion___Validation_Component, Workflow_Orchestrator, "Triggers process initiation", "gRPC with mTLS")
Rel(Workflow_Orchestrator, Claim_State_Service, "Persists and queries domain aggregates", "JPA / JDBC")
Rel(Claim_State_Service, Audit___Reconciliation_Ledger, "Emits immutable state transition events", "Database Write / Transaction Log")
Rel(Workflow_Orchestrator, Legacy_Adapter_Component, "Dispatches asynchronous synchronization payloads", "Azure Service Bus via AMQP with digital signatures")
@enduml