@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit & Reconciliation Ledger container

Person(ComplianceRiskOfficer, "Compliance & Risk Officer", "User persona reading reports and dashboards.")
Person(ReconciliationWorker, "Reconciliation Worker", "Reconciliation worker container.")
System_Ext(ClaimsProcessingCore, "Claims Processing Core", "Claims processing core container.")

Container_Boundary(audit_ledger, "Audit & Reconciliation Ledger") {
    Component(LedgerStorageEngine, "Ledger Storage Engine", "Azure SQL Ledger", "Tamper-evident tables with cryptographic hashing and append-only storage for immutable audit records.")
    Component(AuditQueryAPI, "Audit Query API", "Azure Function", "Provides endpoints for reading immutable audit reports and discrepancy dashboards.")
    Component(DiscrepancyNotificationService, "Discrepancy Notification Service", "Azure Event Grid / Functions", "Handles notifications regarding discrepancies found during data processing.")
    Component(ReconciliationDataProcessor, "Reconciliation Data Processor", "Azure Function", "Processes reconciliation output streams and logs records into the ledger storage.")
}

Rel(ReconciliationDataProcessor, LedgerStorageEngine, "Logs reconciliation records and audit data", "Database Connection with mTLS / Managed Identities")
Rel(ComplianceRiskOfficer, AuditQueryAPI, "Reads immutable audit reports and discrepancy dashboards", "HTTPS/REST with OAuth2/OIDC")
Rel(ReconciliationWorker, ReconciliationDataProcessor, "Sends reconciliation output streams", "HTTP/JSON or Azure Service Bus Queue with Managed Identities")
Rel(ClaimsProcessingCore, LedgerStorageEngine, "Writes audit logs", "Database Connection")

@enduml