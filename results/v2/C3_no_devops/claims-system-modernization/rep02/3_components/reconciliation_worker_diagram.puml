@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Reconciliation Worker container

Container_Boundary(reconciliation_worker_container, "Reconciliation Worker") {
    Component(Mainframe_Data_Extractor, "Mainframe Data Extractor", "C# / .NET Worker Service", "Streams raw records from the legacy mainframe system.")
    Component(Platform_State_Comparator, "Platform State Comparator", "C# / .NET Worker Service", "Compares platform and mainframe state snapshots.")
    Component(Fallback_Rule_Evaluator, "Fallback Rule Evaluator", "C# / .NET Worker Service", "Evaluates fallback rules and risk thresholds.")
    Component(Reconciliation_Worker, "Reconciliation Worker", "Azure Container Apps Background Jobs", "Pulls state snapshots from the legacy mainframe system and manages background reconciliation.")
}

System_Ext(Legacy_Mainframe_System, "Legacy Mainframe System", "Mainframe / SFTP / Flat File", "Legacy system providing state snapshots.")
System_Ext(Audit___Reconciliation_Ledger, "Audit & Reconciliation Ledger", "Azure SQL Ledger", "Logs state comparisons with cryptographic verification.")
System_Ext(Azure_App_Configuration, "Azure App Configuration", "HTTPS / Managed Identity", "Stores and provides risk thresholds.")
System_Ext(Discrepancy_Notifier, "Discrepancy Notifier", "Azure Service Bus", "Publishes enriched discrepancy alerts.")
System_Ext(Azure_Key_Vault, "Azure Key Vault", "HTTPS / Managed Identity", "Retrieves encryption keys and secrets.")

Rel(Reconciliation_Worker, Legacy_Mainframe_System, "Pulls state snapshots", "SFTP / Flat File / TLS 1.3")
Rel(Mainframe_Data_Extractor, Platform_State_Comparator, "Streams raw records", "In-Memory / Internal IPC")
Rel(Platform_State_Comparator, Audit___Reconciliation_Ledger, "Logs state comparisons", "Entity Framework Core / TDS over TLS")
Rel(Fallback_Rule_Evaluator, Azure_App_Configuration, "Fetches risk thresholds", "HTTPS / Managed Identity")
Rel(Fallback_Rule_Evaluator, Discrepancy_Notifier, "Publishes enriched alerts", "Azure Service Bus / AMQP")
Rel(Reconciliation_Worker, Azure_Key_Vault, "Retrieves encryption keys and secrets", "HTTPS / Managed Identity")

@enduml