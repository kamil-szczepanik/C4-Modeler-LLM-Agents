@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure API Management container

Container_Boundary(azure_api_management, "Azure API Management") {
    Component(API_Gateway, "API Gateway", "Azure API Management", "Central gateway for security, routing, and policy enforcement due to low team cloud experience.")
    Component(Security_Policy_Enforcer, "Security & Policy Enforcer", "Azure API Management Policies", "Handles OAuth 2.0 / OpenID Connect validation, rate limiting, and request filtering.")
    Component(Routing_Engine, "Routing Engine", "Azure API Management Routes", "Forwards requests securely using HTTPS and mTLS to downstream services and the migration control engine.")
}

Rel(API_Gateway, Security_Policy_Enforcer, "Enforces policies on incoming requests", "HTTPS")
Rel(Security_Policy_Enforcer, Routing_Engine, "Passes authenticated requests for routing", "Internal")
Rel(Routing_Engine, Migration_Control_Routing_Engine, "Routes claim submissions", "REST / HTTPS, mTLS")

@enduml