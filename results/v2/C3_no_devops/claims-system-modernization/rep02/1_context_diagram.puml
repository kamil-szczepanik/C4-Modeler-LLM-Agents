@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Insurance Claims Modernization Platform

Person(EndCustomers, "End Customers", "Policyholders who submit online self-service claims.")
Person(Brokers, "Brokers", "Partners who assist with claims and submit information on behalf of customers.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal staff who use the modern adjuster web application to review and process claims.")
Person(CustomerSupportAgents, "Customer Support Agents", "Support staff who assist users and manage claim inquiries.")
Person(OperationsMigrationManagers, "Operations/Migration Managers", "Managers overseeing the incremental claim type migration and system operations.")

System(ModernClaimsPlatform, "Modern Claims Platform", "Insurance claims modernization platform gradually replacing a 30-year-old on-premises COBOL/DB2 mainframe with a hybrid Azure cloud architecture, enabling online self-service claim submissions and a modern adjuster web application.")

System_Ext(LegacyMainframeSystem, "Legacy Mainframe System", "On-premises 30-year-old COBOL/DB2 mainframe acting as the system of record.")
System_Ext(EnterpriseServiceBusMessageQueue, "Enterprise Service Bus / Message Queue", "ESB/MQ facilitating asynchronous messaging between Azure and the legacy mainframe.")
System_Ext(AzureActiveDirectoryIdentityProvider, "Azure Active Directory / Identity Provider", "Provides Single Sign-On (SSO) and RBAC authorization.")
System_Ext(NotificationService, "Notification Service", "SendGrid / Azure Communication Services delivering secure external notifications.")
System_Ext(AzureMonitorSentinel, "Azure Monitor / Sentinel", "Provides monitoring and security oversight for the cloud platform.")

Rel(EndCustomers, ModernClaimsPlatform, "Uses for online self-service claim submissions", "HTTPS/TLS")
Rel(Brokers, ModernClaimsPlatform, "Uses for claim submissions and management", "HTTPS/TLS")
Rel(ClaimsAdjusters, ModernClaimsPlatform, "Uses the modern adjuster web application", "HTTPS/TLS")
Rel(CustomerSupportAgents, ModernClaimsPlatform, "Uses to assist users and manage claims", "HTTPS/TLS")
Rel(OperationsMigrationManagers, ModernClaimsPlatform, "Monitors and manages incremental claim type migration", "HTTPS/TLS")
Rel(ModernClaimsPlatform, EnterpriseServiceBusMessageQueue, "Syncs claims data asynchronously", "mTLS")
Rel(EnterpriseServiceBusMessageQueue, LegacyMainframeSystem, "Syncs claims data respecting batch windows", "Asynchronous Messaging")
Rel(ModernClaimsPlatform, NotificationService, "Sends secure external notifications", "HTTPS/TLS with API Key")
Rel(ModernClaimsPlatform, AzureActiveDirectoryIdentityProvider, "Authenticates users and authorizes access", "OpenID Connect / OAuth 2.0")
Rel(ModernClaimsPlatform, AzureMonitorSentinel, "Sends telemetry and security logs", "Azure Diagnostics")

@enduml