@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component Diagram for Adjuster Web Application

Container_Boundary(adjuster_web_app, "Adjuster Web Application") {
    Component(spa_ui, "SPA UI Components", "React SPA", "Provides a responsive user interface with local session storage draft auto-saving.")
    Component(auth_guard, "Auth Guard Component", "React SPA", "Enforces Single Sign-On and route protection within the client application.")
    Component(claim_mgmt, "Claim Management Controller", "ASP.NET Core BFF", "Implements server-side token management, FluentValidation, and API orchestration.")
    Component(read_model, "Read Model Projections Cache Service", "ASP.NET Core BFF", "Caches claims data to guarantee sub-2-second screen loads.")
    Component(mainframe_client, "Mainframe Anti-Corruption Client", "ASP.NET Core BFF", "Communicates with the Anti-Corruption Layer to bridge the modern microservices and the legacy mainframe.")
    Component(audit_trail, "Audit Trail Service", "ASP.NET Core BFF", "Handles auditing and tracking of adjuster actions within the application.")
}

Rel(spa_ui, claim_mgmt, "HTTPS / JSON", "API calls")
Rel(claim_mgmt, read_model, ".NET In-Memory / TCP over TLS", "Queries cache")
Rel(claim_mgmt, audit_trail, ".NET In-Memory", "Records audit logs")
Rel(audit_trail, mainframe_client, "gRPC / HTTPS", "Requests through ACL")
Rel(claim_mgmt, mainframe_client, "Orchestrates calls", "Internal BFF logic")

@enduml