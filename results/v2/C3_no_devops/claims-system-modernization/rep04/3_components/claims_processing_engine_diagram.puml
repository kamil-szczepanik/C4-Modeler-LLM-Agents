@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Claims Processing Engine", "Claims Processing Engine") {
    Component("Claim State Orchestrator", "Claim State Orchestrator", "ASP.NET Core / MediatR", "Orchestrates claim processing states, workflows, and in-memory dispatching for incoming claims.")
    Component("Migration Routing Component", "Migration Routing Component", "ASP.NET Core / Strangler Fig Router", "Routes claim types gradually between the modern platform and the legacy mainframe system.")
    Component("Reconciliation Worker", "Reconciliation Worker", "ASP.NET Core Background Service", "Ensures zero data loss and validates state synchronization between the modern database and legacy systems.")
}

Rel("Claim State Orchestrator", "Migration Routing Component", "Delegates claim-type specific routing paths", "")
Rel("Migration Routing Component", "Reconciliation Worker", "Sends transaction records for audit and parity checking", "")

@enduml