@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(AdjusterWebApplication, "Adjuster Web Application", "React SPA + ASP.NET Core Backend-for-Frontend (BFF)")
System_Ext(AntiCorruptionLayer, "Anti-Corruption Layer", "Azure Functions & Azure Service Bus")
System_Ext(ClaimsProcessingEngine, "Claims Processing Engine", "ASP.NET Core Microservices on Azure Kubernetes Service (AKS)")

Container_Boundary(AzureCacheForRedis, "Azure Cache for Redis") {
    Component(ClaimStateCache, "Claim State Cache", "Azure Cache for Redis Standard Tier", "Caches active claim states to meet sub-2s SLA and buffers slow mainframe responses.")
    Component(ReferenceDataCache, "Reference Data Cache", "Azure Cache for Redis Standard Tier", "Stores reference and lookup data refreshed using the cache-aside pattern.")
}

Rel(AdjusterWebApplication, ClaimStateCache, "Queries cached claims to meet sub-2s SLA", "TCP/Redis Protocol over TLS 1.2/1.3")
Rel(AntiCorruptionLayer, ClaimStateCache, "Invalidates/updates cache via Pub/Sub on mainframe changes", "TCP/Redis Protocol over TLS 1.2/1.3")
Rel(ClaimsProcessingEngine, ReferenceDataCache, "Refreshes lookup data using cache-aside pattern", "TCP/Redis Protocol over TLS 1.2/1.3")
@enduml