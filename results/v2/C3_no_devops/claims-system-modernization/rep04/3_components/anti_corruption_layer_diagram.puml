@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Anti-Corruption Layer container

System_Ext(ClaimsProcessingEngine, "Claims Processing Engine", "Modern microservice in the Claims Processing Engine.")
System_Ext(LegacyMainframe, "Legacy Mainframe", "30-year-old COBOL/DB2 mainframe system.")
System_Ext(AzureMonitor, "Azure Monitor", "Cloud monitoring and alerting service.")

Container_Boundary(AntiCorruptionLayer, "Anti-Corruption Layer") {
    Component(TranslationComponent, "Translation Component", "Azure Function, Mapster/AutoMapper", "Maps domain models to legacy COBOL schemas.")
    Component(BufferingRoutingComponent, "Buffering & Routing Component", "Azure Service Bus Topics/Queues", "Manages asynchronous ingestion and message routing.")
    Component(AuditReconciliationComponent, "Audit & Reconciliation Component", "Cosmos DB, Azure Function", "Captures immutable payloads and writes execution logs.")
    Component(ReconciliationAlertingComponent, "Reconciliation & Alerting Component", "Timer-triggered Azure Function, Azure Monitor API", "Executes discrepancy checks and emits operational alerts.")
}

Rel(ClaimsProcessingEngine, TranslationComponent, "Publishes and consumes events", "Azure Service Bus, AMQP")
Rel(TranslationComponent, LegacyMainframe, "Synchronizes data", "HTTPS/SOAP, SFTP, and mTLS")
Rel(TranslationComponent, AuditReconciliationComponent, "Writes execution logs", "Internal .NET SDK / Cosmos DB API")
Rel(ReconciliationAlertingComponent, AzureMonitor, "Emits operational alerts", "HTTPS / Azure Monitor API")

@enduml