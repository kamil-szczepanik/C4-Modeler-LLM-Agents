@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure API Management container

Container_Boundary(azure_api_management, "Azure API Management") {
    Component(Strangler_Fig_Router_Policy, "Strangler Fig Router Policy", "APIM Policy XML / Azure API Management Policy Engine", "Evaluates incoming requests against dynamic routing rules to direct traffic to either the modern Claims Processing Engine or the Legacy Mainframe.")
    Component(Routing_Configuration_Store, "Routing Configuration Store", "Azure App Configuration", "Stores live feature-flag routing rules for zero-downtime, dynamic routing and instant claim-type rollbacks.")
    Component(Gateway_Security_Enforcer, "Gateway Security Enforcer", "Azure Active Directory & Key Vault", "Validates OAuth 2.0 / OpenID Connect tokens, handles SSO integration, and manages mTLS certificates for secure routing.")
}

System_Ext(Claims_Processing_Engine, "Claims Processing Engine", "ASP.NET Core Microservices on AKS")
System_Ext(Legacy_Mainframe, "Legacy Mainframe", "COBOL/DB2 on-premise")

Rel(Strangler_Fig_Router_Policy, Routing_Configuration_Store, "Queries live routing rules", "HTTPS/REST")
Rel(Strangler_Fig_Router_Policy, Claims_Processing_Engine, "Routes migrated claims", "gRPC / HTTPS")
Rel(Strangler_Fig_Router_Policy, Legacy_Mainframe, "Proxies unmigrated claims", "site-to-site VPN/ExpressRoute with mTLS")
Rel(Gateway_Security_Enforcer, Strangler_Fig_Router_Policy, "Provides security validation and credentials", "HTTPS/OAuth 2.0")

@enduml