@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Active Directory & Key Vault container

Container_Boundary(azure_ad_key_vault, "Azure Active Directory & Key Vault") {
    Component(TokenService, "Token Service", "Azure Entra ID", "Centralizes single sign-on, identity federation, and validates JWT tokens using OpenID Connect.")
    Component(SecretsProvider, "Secrets Provider", "Azure Key Vault", "Secures runtime secrets and cryptographic keys using Private Endpoints.")
}

Rel(TokenService, SecretsProvider, "Authenticates identity and manages access control for secrets", "HTTPS")

@enduml