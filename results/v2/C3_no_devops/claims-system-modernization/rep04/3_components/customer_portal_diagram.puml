@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Customer Portal container

Container_Boundary("Customer_Portal", "Customer Portal") {
    Component("Claim_Submission_Wizard", "Claim Submission Wizard", "React & TypeScript, Zod & React Hook Form, TanStack Query, IndexedDB", "Submits claim payloads and ensures robust draft data integrity with offline-resilient persistence.")
    Component("Claim_Tracking_Dashboard", "Claim Tracking Dashboard", "React & TypeScript, TanStack Query", "Provides policyholders with an interface for online claim tracking.")
    Component("Broker_Portfolio_Manager", "Broker Portfolio Manager", "React & TypeScript, TanStack Query", "Fetches authorized client claims for brokers.")
    Component("Auth_Session_Manager", "Auth & Session Manager", "React & TypeScript, Azure Static Web Apps Built-in Auth", "Manages secure session cookies and acquires tokens via Azure Active Directory.")
}

System_Ext("Azure_Static_Web_Apps_Auth", "Azure Static Web Apps Auth", "External authentication system")
System_Ext("Azure_API_Management", "Azure API Management", "External API gateway")
System_Ext("Azure_Active_Directory", "Azure Active Directory", "External identity provider")

Rel("Auth_Session_Manager", "Azure_Static_Web_Apps_Auth", "Manages secure session cookies", "HTTPS")
Rel("Claim_Submission_Wizard", "Azure_API_Management", "Submits claim payloads", "HTTPS / REST")
Rel("Broker_Portfolio_Manager", "Azure_API_Management", "Fetches authorized client claims", "HTTPS / REST with JWT")
Rel("Auth_Session_Manager", "Azure_Active_Directory", "Acquires tokens", "OAuth 2.0 / OpenID Connect")

@enduml