@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers_Brokers, "Customers & Brokers", "External users submitting claims via web browser.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal staff handling claims via web application.")

System(New_Claims_Platform, "New Claims Platform", "Modernized Azure-hosted claims platform that gradually migrates claim types from a 30-year-old regional insurer's legacy mainframe while maintaining uninterrupted core operations.")

System_Ext(Legacy_Mainframe, "Legacy Mainframe", "On-premises IBM z/OS COBOL/DB2 system of record retained per 3-year migration constraint.")
System_Ext(Active_Directory, "Active Directory", "On-premises identity provider.")
System_Ext(Notification_Service, "Notification Service", "External SaaS (Twilio SendGrid/Azure Communication Services) for SMS and Email dispatch.")
System_Ext(Telemetry_Monitoring, "Telemetry & Monitoring", "Azure Application Insights/Azure Monitor for metrics and logs.")

Rel(Customers_Brokers, New_Claims_Platform, "Online claim submission (R-01)", "HTTPS")
Rel(Claims_Adjusters, New_Claims_Platform, "Claim management (<2s load time, R-02)", "HTTPS")
Rel(New_Claims_Platform, Legacy_Mainframe, "Claim data proxying", "TLS via VPN/ExpressRoute with mTLS")
Rel(New_Claims_Platform, Active_Directory, "Single sign-on via Azure AD Connect (R-07)", "OIDC/OAuth 2.0")
Rel(New_Claims_Platform, Notification_Service, "SMS/Email dispatch", "HTTPS REST API")
Rel(New_Claims_Platform, Telemetry_Monitoring, "Metrics and logs collection", "HTTPS/Native Diagnostics")

@enduml