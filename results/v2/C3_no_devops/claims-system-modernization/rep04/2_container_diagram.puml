@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Insurance Claims Modernization

Person(Customers_and_Brokers, "Customers & Brokers", "External users submitting claims via web browser.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal staff handling claims via web application.")
Person(Customer_Support_Agents, "Customer Support Agents", "Support staff assisting users with claims.")

System_Ext(Legacy_Mainframe, "Legacy Mainframe", "On-premises COBOL/DB2 system of record.")

System_Boundary(Insurance_Claims_Modernization, "Insurance Claims Modernization") {
    Container(Azure_API_Management, "Azure API Management", "Azure API Management (Strangler Fig Router)", "Manages routing and Strangler Fig pattern for incremental claim migration.")
    Container(Customer_Portal, "Customer Portal", "React SPA in Azure Static Web Apps", "Provides customer-facing claims submission interface.")
    Container(Adjuster_Web_Application, "Adjuster Web Application", "React SPA + ASP.NET Core BFF", "Provides adjuster-facing interface and backend-for-frontend service.")
    Container(Claims_Processing_Engine, "Claims Processing Engine", "ASP.NET Core Microservices on Azure Kubernetes Service", "Hosts scalable microservices for processing claims.")
    Container(Anti_Corruption_Layer, "Anti-Corruption Layer", "Azure Functions & Azure Service Bus", "Insulates against legacy schema changes and handles event-driven messaging.")
    ContainerDb(Azure_Cache_for_Redis, "Azure Cache for Redis", "Azure Cache for Redis", "Buffers slow mainframe responses to meet performance SLAs.")
    Container(Azure_Active_Directory_and_Key_Vault, "Azure Active Directory & Key Vault", "Azure Active Directory & Key Vault", "Centralizes single sign-on, RBAC, and secrets management.")
}

Rel(Customers_and_Brokers, Azure_API_Management, "Accesses portals and submits claims", "HTTPS/REST")
Rel(Claims_Adjusters, Azure_API_Management, "Accesses adjuster application", "HTTPS/REST")
Rel(Customer_Support_Agents, Azure_API_Management, "Accesses system interfaces", "HTTPS/REST")
Rel(Azure_API_Management, Customer_Portal, "Routes traffic", "HTTPS")
Rel(Azure_API_Management, Adjuster_Web_Application, "Routes traffic", "HTTPS")
Rel(Azure_API_Management, Legacy_Mainframe, "Proxies unmigrated requests", "site-to-site VPN/ExpressRoute with mTLS and TLS 1.3")
Rel(Adjuster_Web_Application, Azure_Cache_for_Redis, "Queries cached claims to serve requests within SLA", "TCP/Redis Protocol")
Rel(Claims_Processing_Engine, Anti_Corruption_Layer, "Publishes and consumes events", "Azure Service Bus topics")
Rel(Anti_Corruption_Layer, Legacy_Mainframe, "Synchronizes data via restricted protocols", "Restricted batch/interface protocols")
Rel(Customer_Portal, Azure_Active_Directory_and_Key_Vault, "Authenticates users", "OAuth 2.0 / OpenID Connect")
Rel(Adjuster_Web_Application, Azure_Active_Directory_and_Key_Vault, "Authenticates users and retrieves secrets", "OAuth 2.0 / OpenID Connect")

@enduml