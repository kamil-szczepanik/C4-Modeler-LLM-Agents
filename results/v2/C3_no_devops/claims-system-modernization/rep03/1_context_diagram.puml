@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Modern Claims Platform

Person(Customer, "Customer", "Policyholders who submit online claims via the web portal.")
Person(Broker, "Broker", "Insurance brokers who submit and assist with claims on behalf of customers.")
Person(Claims Adjuster, "Claims Adjuster", "Internal staff responsible for fast claim handling and processing.")
Person(Finance/Compliance Auditor, "Finance/Compliance Auditor", "Auditors who review audit logs and ensure compliance.")

System(Modern Claims Platform, "Modern Claims Platform", "A hybrid insurance claims modernization platform that gradually replaces a legacy COBOL/DB2 mainframe while maintaining data consistency, enabling online submissions, fast adjuster processing, and incremental claim type migration.")

System_Ext(Legacy Mainframe Claims System, "Legacy Mainframe Claims System", "On-premises COBOL/DB2 system acting as the enduring system of record.")
System_Ext(Identity Provider, "Identity Provider", "Insurer's Active Directory / Azure AD providing Single Sign-On and MFA.")

Rel(Customer, Modern Claims Platform, "Submits online claims", "HTTPS (Web/UI)")
Rel(Broker, Modern Claims Platform, "Submits and manages claims", "HTTPS (Web/UI)")
Rel(Claims Adjuster, Modern Claims Platform, "Handles claims with sub-2s response times", "HTTPS")
Rel(Finance/Compliance Auditor, Modern Claims Platform, "Reviews compliance and audit logs", "HTTPS")
Rel(Modern Claims Platform, Legacy Mainframe Claims System, "Synchronizes claims and data consistency asynchronously", "MQ/Kafka via Site-to-Site VPN / Azure ExpressRoute (mTLS)")
Rel(Modern Claims Platform, Identity Provider, "Authenticates users via SSO and MFA", "OIDC/OAuth 2.0")

@enduml