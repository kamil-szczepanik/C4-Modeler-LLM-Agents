@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration & Anti-Corruption Layer container

Container_Boundary(integration_layer, "Integration & Anti-Corruption Layer") {
    Component(Message_Router_Component, "Message Router Component", ".NET Core / Azure Service Bus Topics", "Publishes domain events and handles asynchronous messaging.")
    Component(Translation_Mapping_Component, "Translation & Mapping Component", ".NET Core", "Transforms payloads between modern and legacy schemas.")
    Component(Crypto_Proxy_Middleware, "Crypto-Proxy Middleware", ".NET Core", "Encrypts and decrypts sensitive payloads.")
    Component(Dead_Letter_Audit_Store_Component, "Dead Letter & Audit Store Component", "Azure Cosmos DB", "Provides immutable storage for auditability and dead-letter management.")
    Component(Replay_Reconciliation_Component, "Replay & Reconciliation Component", ".NET Core / Azure Functions", "Re-queues corrected messages and handles reconciliation.")
    Component(Mainframe_Adapter, "Mainframe Adapter", "Azure Container Apps / .NET Core", "Dispatches legacy messages to the mainframe.")
}

Rel(Message_Router_Component, Translation_Mapping_Component, "Transforms payloads", "In-memory / .NET")
Rel(Translation_Mapping_Component, Crypto_Proxy_Middleware, "Encrypts/decrypts sensitive payloads", "In-memory / .NET")
Rel(Translation_Mapping_Component, Mainframe_Adapter, "Dispatches legacy messages", "AMQP")
Rel(Replay_Reconciliation_Component, Message_Router_Component, "Re-queues corrected messages", "AMQP")

@enduml