@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Customer Portal & Adjuster Web App container

Container_Boundary(Customer_Portal_and_Adjuster_Web_App, "Customer Portal & Adjuster Web App") {
    Component(SPA_Shell_and_Routing_Engine, "SPA Shell & Routing Engine", "React / TypeScript", "Modernizes user interactions for customers, brokers, and claims adjusters while hiding legacy mainframe latencies, hosted in Azure Container Apps.")
    Component(Dynamic_Form_Engine, "Dynamic Form Engine", "React Hook Form / JSON Schema", "Enables dynamic, metadata-driven form rendering to support iterative claim type migration without frontend deployments.")
    Component(Optimistic_UI_and_Local_State_Cache, "Optimistic UI & Local State Cache", "TanStack Query", "Manages local state and caching to meet sub-2-second performance requirements despite mainframe lag.")
    Component(Telemetry_and_Error_Boundary_Handler, "Telemetry & Error Boundary Handler", "Azure Application Insights SDK", "Streams anonymized performance metrics and error logs via HTTPS.")
}

System_Ext(Azure_API_Management_Gateway, "Azure API Management Gateway", "External API Gateway")
System_Ext(Azure_Active_Directory, "Azure Active Directory", "Identity and Access Management")
System_Ext(Azure_Application_Insights, "Azure Application Insights", "Application Performance Monitoring")

Rel(SPA_Shell_and_Routing_Engine, Azure_API_Management_Gateway, "Routes client traffic", "HTTPS / TLS 1.3")
Rel(SPA_Shell_and_Routing_Engine, Azure_Active_Directory, "Authenticates users and manages sessions", "OpenID Connect / OIDC")
Rel(Telemetry_and_Error_Boundary_Handler, Azure_Application_Insights, "Streams anonymized performance metrics and error logs", "HTTPS")

@enduml