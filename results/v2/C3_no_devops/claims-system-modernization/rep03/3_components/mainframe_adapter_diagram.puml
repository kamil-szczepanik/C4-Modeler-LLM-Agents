@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Mainframe Adapter container

Container_Boundary(mainframe_adapter_container, "Mainframe Adapter") {
    Component(Request_Translator_Component, "Request Translator Component", ".NET Core", "Translates integration messages for mainframe processing.")
    Component(LU6_2_Protocol_Bridge_Component, "LU6.2 Protocol Bridge Component", "C#/.NET native sockets", "Invokes in-memory message mapping and transmits framed byte arrays.")
    Component(Outbox___State_Cache_Component, "Outbox & State Cache Component", "Entity Framework Core / Redis", "Implements transactional outbox pattern and state caching.")
    Component(Telemetry___Audit_Emitter_Component, "Telemetry & Audit Emitter Component", ".NET Core / OpenTelemetry", "Emits telemetry and audit logs for compliance.")
}

Rel(Request_Translator_Component, LU6_2_Protocol_Bridge_Component, "Invokes in-memory message mapping", "Direct")

@enduml