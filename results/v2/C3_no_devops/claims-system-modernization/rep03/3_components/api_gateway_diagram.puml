@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(azure_api_management, "Azure API Management", "Azure API Management", "Centralizes security, rate-limiting, routing, and exposes APIs to customers, brokers, and adjusters.")
}

System_Ext(claims_domain_services, "Claims Domain Services", "Claims Domain Services")
System_Ext(mainframe_adapter, "Mainframe Adapter", "Mainframe Adapter")

Rel(azure_api_management, claims_domain_services, "Routes traffic and invokes services", "gRPC over mTLS")
Rel(azure_api_management, mainframe_adapter, "Integrates with legacy system", "gRPC over mTLS")

@enduml