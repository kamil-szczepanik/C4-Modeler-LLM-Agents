@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(claims_domain_services, "Claims Domain Services") {
    Component(Claim Orchestrator, "Claim Orchestrator", ".NET Core / Mediator pattern", "Orchestrates claim processing workflows and coordinates domain logic execution.")
    Component(Claim Domain Model, "Claim Domain Model", ".NET Core", "Encapsulates the core business logic and rules for claims handling.")
    Component(Rollback Switch, "Rollback Switch", ".NET Core / Feature Flag pattern", "Controls the traffic routing and enables rapid one-day rollback capabilities to the mainframe.")
    Component(Claim Audit & Event Publisher, "Claim Audit & Event Publisher", ".NET Core / Outbox Pattern", "Handles audit logging and dispatches domain and integration events reliably.")
}

System_Ext(Integration & Anti-Corruption Layer, "Integration & Anti-Corruption Layer", "Azure Service Bus")
System_Ext(Mainframe Adapter, "Mainframe Adapter", "Legacy Integration")
System_Ext(Claims Audit Store, "Claims Audit Store", "Azure Cosmos DB")

Rel(Claim Orchestrator, Claim Domain Model, "In-memory domain method calls")
Rel(Claim Orchestrator, Integration & Anti-Corruption Layer, "Publishes domain events", "AMQP (Azure Service Bus)")
Rel(Rollback Switch, Mainframe Adapter, "Forwards unmigrated claim traffic", "gRPC with payload signing")
Rel(Claim Domain Model, Claim Audit & Event Publisher, "Raises domain events", "In-memory / MediatR")
Rel(Claim Audit & Event Publisher, Claims Audit Store, "Persists audit records", "HTTPS (Document API)")
Rel(Claim Audit & Event Publisher, Integration & Anti-Corruption Layer, "Dispatches integration events", "AMQP")
@enduml