@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "End-user shopping for physical and electronic books.")
Person(StoreAdministrator, "Store Administrator", "Back-office user managing inventory and support.")

System(OnlineBookstoreSystem, "Online Bookstore System", "Core AWS-hosted multi-region retail platform designed to deliver secure, multi-currency book purchasing, recommendations, and reviews for 1 million monthly active users.")

System_Ext(PaymentGateway, "Payment Gateway", "Stripe/PayPal handling secure PCI-DSS checkout.")
System_Ext(ThirdPartyShippingCarrierAPIs, "Third-Party Shipping/Carrier APIs", "FedEx/UPS managing physical fulfillment.")
System_Ext(TaxCalculationService, "Tax Calculation Service", "Avalara/TaxJar for multi-region tax compliance.")
System_Ext(RecommendationProvider, "Recommendation Provider", "AWS Personalize generating 'Customers also bought' data.")
System_Ext(IdentityProvider, "Identity Provider", "AWS SES/OAuth managing authentication and notifications.")

Rel(Customer, OnlineBookstoreSystem, "Interacts for shopping, purchasing, and reviews", "HTTPS (Web/Mobile) using TLS 1.3")
Rel(StoreAdministrator, OnlineBookstoreSystem, "Accesses for managing inventory and support", "HTTPS with OAuth 2.0 / OIDC and MFA")
Rel(OnlineBookstoreSystem, PaymentGateway, "Processes secure checkout and payments", "TLS 1.3 / REST")
Rel(OnlineBookstoreSystem, TaxCalculationService, "Calculates multi-region taxes", "TLS 1.3 / REST")
Rel(OnlineBookstoreSystem, ThirdPartyShippingCarrierAPIs, "Manages physical fulfillment and shipping", "HTTPS/REST webhooks using HMAC-SHA256 signing")
Rel(OnlineBookstoreSystem, RecommendationProvider, "Fetches ML recommendations", "Asynchronous gRPC/REST APIs")

@enduml