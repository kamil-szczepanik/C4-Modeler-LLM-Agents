@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS App Mesh & Security container

Container_Boundary(aws_app_mesh_security, "AWS App Mesh & Security") {
    Component(Envoy_Proxy_Sidecar, "Envoy Proxy Sidecar", "Envoy / AWS App Mesh", "Injected into every microservice pod to handle traffic routing, service discovery, and mTLS encryption.")
    Component(Secrets_Controller, "Secrets Controller", "AWS Secrets Manager and External Secrets Operator", "Secures and fetches runtime secrets for microservices.")
    Component(Key_Management_Daemon, "Key Management Daemon", "AWS KMS", "Manages data at rest with envelope encryption and strict IAM scoping.")
    Component(Mesh_Control_Plane, "Mesh Control Plane", "AWS App Mesh Controller and AWS IAM", "Manages mesh configurations, routing, and access policies.")
    Component(Telemetry_Audit_Router, "Telemetry & Audit Router", "AWS CloudWatch and AWS X-Ray", "Captures access logs, mTLS handshake metrics, and distributed traces for compliance audits.")
    Component(Certificate_Authority, "Certificate Authority", "AWS Certificate Manager (ACM) Private CA", "Automates 24-hour certificate rotation with local Envoy caching for high availability.")
}

System_Ext(Catalog_Checkout_Containers, "Catalog, Checkout, & other Containers", "External microservice containers")
System_Ext(Services, "Services", "Application services requiring secrets")

Rel(Catalog_Checkout_Containers, Envoy_Proxy_Sidecar, "Localhost loopback", "gRPC/HTTP")
Rel(Envoy_Proxy_Sidecar, Envoy_Proxy_Sidecar, "Cross-service communication", "Mutual TLS over TCP/Port 443")
Rel(Services, Secrets_Controller, "Fetch runtime secrets", "HTTPS/AWS SDK")
Rel(Envoy_Proxy_Sidecar, Mesh_Control_Plane, "Fetch dynamic routing and certificate updates", "gRPC with local caching fallback")
Rel(Envoy_Proxy_Sidecar, Telemetry_Audit_Router, "Export metrics and access logs", "OTLP/HTTPS")

@enduml