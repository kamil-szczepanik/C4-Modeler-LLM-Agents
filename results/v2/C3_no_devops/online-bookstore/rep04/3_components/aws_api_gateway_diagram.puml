@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(ReactSPA, "React SPA", "External client application")
System_Ext(BackendMicroservices, "Backend Microservices (Catalog, Checkout)", "Internal microservices managed via AWS App Mesh")

Container_Boundary(aws_api_gateway, "AWS API Gateway") {
    Component(WAFSecurityFilter, "WAF & Security Filter", "AWS WAF", "AWS WAF integrated with API Gateway for OWASP Top-10 mitigations.")
    Component(AuthorizerComponent, "Authorizer Component", "AWS Lambda", "AWS Lambda Authorizer for JWT validation and scope extraction.")
    Component(ThrottlingUsagePlanEngine, "Throttling & Usage Plan Engine", "API Gateway Usage Plans and API Keys", "Native API Gateway Usage Plans and API Keys for rate limiting.")
    Component(RequestRouter, "Request Router", "AWS API Gateway REST/HTTP APIs", "AWS API Gateway REST/HTTP APIs using proxy integration.")
    Component(TransformResponseMapper, "Transform & Response Mapper", "Velocity Template Language (VTL)", "Velocity Template Language (VTL) engine for payload formatting and PII masking.")
    Component(ObservabilityPublisher, "Observability Publisher", "Amazon CloudWatch and AWS X-Ray", "Amazon CloudWatch and AWS X-Ray for telemetry.")
}

Rel(ReactSPA, WAFSecurityFilter, "Inspects incoming requests", "HTTPS/JSON, TLS 1.3")
Rel(WAFSecurityFilter, AuthorizerComponent, "Validates security tokens", "Internal")
Rel(AuthorizerComponent, ThrottlingUsagePlanEngine, "Checks API quotas", "Internal")
Rel(ThrottlingUsagePlanEngine, RequestRouter, "Forwards authorized traffic", "Internal")
Rel(RequestRouter, TransformResponseMapper, "Formats error and success payloads", "JSON")
Rel(RequestRouter, ObservabilityPublisher, "Emits metrics, logs, and traces", "CloudWatch/X-Ray")
Rel(RequestRouter, BackendMicroservices, "Forwards signed requests via AWS App Mesh", "gRPC/HTTP with SigV4/mTLS")

@enduml