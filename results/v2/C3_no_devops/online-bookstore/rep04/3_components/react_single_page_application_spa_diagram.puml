@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(react_spa, "React Single Page Application (SPA)") {
    Component(Routing_Layout_Component, "Routing & Layout Component", "React, React Router", "Handles application routing, layout structure, and route-based code-splitting for sub-2-second page loads.")
    Component(Catalog_Search_Component, "Catalog & Search Component", "React", "Provides catalog browsing, searching, and product display interfaces for customers.")
    Component(Checkout_Cart_Component, "Checkout & Cart Component", "React, Zustand/Redux Toolkit", "Manages shopping cart state and guides customers through the secure checkout process.")
    Component(Admin_Dashboard_Component, "Admin Dashboard Component", "React", "Provides store administrators access to catalog and store management features via OAuth2/OIDC.")
    Component(API_Client, "API Client", "Axios/Fetch", "Handles secure HTTPS/JSON communication and requests to the AWS API Gateway.")
}

Rel(Routing_Layout_Component, Catalog_Search_Component, "Renders")
Rel(Routing_Layout_Component, Checkout_Cart_Component, "Renders")
Rel(Routing_Layout_Component, Admin_Dashboard_Component, "Renders")
Rel(Catalog_Search_Component, API_Client, "Sends API requests via")
Rel(Checkout_Cart_Component, API_Client, "Sends API requests via")
Rel(Admin_Dashboard_Component, API_Client, "Sends API requests via")
@enduml