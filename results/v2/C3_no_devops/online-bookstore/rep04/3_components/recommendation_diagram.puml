@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Recommendation container

System_Ext(aws_api_gateway, "AWS API Gateway", "External gateway routing requests")
System_Ext(amazon_sqs_kafka, "Amazon SQS/Kafka", "Asynchronous messaging system")

Container_Boundary(recommendation, "Recommendation") {
    Component(api_controller, "API Controller", "Python/FastAPI", "Routes recommendation requests and manages overall request flow.")
    Component(consent_preference_filter, "Consent & Preference Filter", "Python/FastAPI Middleware", "Validates user consent states and forwards compliant telemetry.")
    Component(inference_engine, "Inference Engine", "Python/PyTorch/Scikit-learn", "Executes collaborative filtering and real-time inference under 50ms.")
    Component(feedback_collector, "Feedback Collector", "Python/FastAPI, Amazon SQS/Kafka", "Ingests anonymized clickstream events for asynchronous processing.")
    Component(recommendation_cache_layer, "Recommendation Cache Layer", "Amazon ElastiCache Redis", "Retrieves pre-computed item associations for rapid retrieval.")
}

Rel(aws_api_gateway, api_controller, "Routes recommendation requests", "REST/gRPC [JWT, mTLS via AWS App Mesh]")
Rel(api_controller, consent_preference_filter, "Validates user consent states", "Internal function call")
Rel(consent_preference_filter, feedback_collector, "Forwards compliant telemetry", "Internal function call")
Rel(feedback_collector, amazon_sqs_kafka, "Ingests anonymized clickstream events", "TLS 1.3, AWS KMS")
Rel(inference_engine, recommendation_cache_layer, "Retrieves pre-computed item associations", "TLS, Redis AUTH")

@enduml