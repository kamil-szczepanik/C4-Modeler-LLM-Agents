@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Checkout & Order container

System_Ext(AWS_API_Gateway, "AWS API Gateway", "AWS API Gateway", "Routes cart actions via REST/JSON over HTTPS with JWT validation.")
System_Ext(Payment_Gateway, "Payment Gateway", "External third-party system", "External third-party system processing secure financial transactions.")
System_Ext(Tax_Calculation_Service, "Tax Calculation Service", "Internal microservice", "Internal microservice providing regional tax rules via gRPC.")

Container_Boundary(Checkout_Order, "Checkout & Order") {
    Component(Cart_Pricing_Engine, "Cart & Pricing Engine", "Node.js/Express", "Manages real-time cart state and multi-currency conversions (USD, EUR, GBP).")
    Component(Order_Orchestrator, "Order Orchestrator", "Node.js/Express", "Coordinates distributed transactions, saga patterns, and asynchronous fulfillment queues.")
    Component(Payment_Compliance_Manager, "Payment & Compliance Manager", "Node.js/Express", "Handles payment tokenization and automated GDPR/CCPA data masking routines.")
    Component(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Persists transactional ledgers, localized tax data, and order states with column-level PII encryption.")
    Component(AWS_SQS, "AWS SQS", "AWS SQS", "Decouples order confirmation from Third-Party Shipping API availability.")
}

Rel(AWS_API_Gateway, Cart_Pricing_Engine, "Routes cart actions", "REST/JSON over HTTPS")
Rel(Order_Orchestrator, Payment_Gateway, "Authorizes payments", "HTTPS/TLS 1.3")
Rel(Order_Orchestrator, Tax_Calculation_Service, "Queries regional tax rules", "gRPC over mTLS")
Rel(Order_Orchestrator, Amazon_Aurora_PostgreSQL, "Persists transactional data", "SQL over TLS")
Rel(Order_Orchestrator, AWS_SQS, "Queues fulfillment details", "AWS SDK with IAM Auth")
Rel(Order_Orchestrator, Payment_Compliance_Manager, "Enforce cryptographically secure idempotency keys", "Internal API")

@enduml