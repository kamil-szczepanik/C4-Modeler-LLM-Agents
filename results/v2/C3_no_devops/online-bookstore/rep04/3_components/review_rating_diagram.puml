@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Review & Rating container

System_Ext(aws_api_gateway, "AWS API Gateway", "Enforces rate limiting on review and voting endpoints.")
System_Ext(checkout_order_container, "Checkout & Order Container", "External microservice providing verified-purchase validation.")
System_Ext(amazon_dynamodb, "Amazon DynamoDB", "Stores review records and aggregated ratings using single-table design.")

Container_Boundary(review_rating, "Review & Rating") {
    Component(review_controller, "Review Controller", "FastAPI Router / Python", "Exposes RESTful endpoints and validates JWTs for user and admin contexts.")
    Component(review_service, "Review Service", "Python", "Encapsulates core business logic, including aggregate rating calculations.")
    Component(moderation_service, "Moderation Service", "Python", "Handles administrative flagging, filtering, and deletion of abusive content.")
    Component(helpfulness_service, "Helpfulness Service", "Python", "Manages idempotent user votes and tallies helpfulness scores.")
    Component(review_repository, "Review Repository", "Python / AWS SDK", "Interacts with the persistence layer.")
}

Rel(aws_api_gateway, review_controller, "Routes REST/gRPC requests with JWT", "HTTPS, TLS 1.3")
Rel(review_service, checkout_order_container, "Verifies customer purchases", "REST/gRPC over mTLS via AWS App Mesh")
Rel(review_service, amazon_dynamodb, "Persists and queries review data", "AWS SDK, HTTPS")
Rel(helpfulness_service, amazon_dynamodb, "Executes atomic conditional writes for votes", "AWS SDK, HTTPS")

@enduml