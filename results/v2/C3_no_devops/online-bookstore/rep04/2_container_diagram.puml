@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore System

Person(Customer, "Customer", "Casual Reader and Returning Bibliophile shopping for physical and electronic books.")
Person(StoreAdministrator, "Store Administrator", "Back-office user managing inventory and support.")

System_Ext(PaymentGateway, "Payment Gateway", "External payment processing system handling secure checkout.")
System_Ext(ThirdPartyShippingCarrierAPIs, "Third-Party Shipping/Carrier APIs", "External logistics system managing physical fulfillment and shipping.")
System_Ext(TaxCalculationService, "Tax Calculation Service", "External service for multi-region tax compliance.")
System_Ext(RecommendationProvider, "Recommendation Provider", "External ML recommendation provider.")
System_Ext(IdentityProvider, "Identity Provider", "External or AWS-managed identity provider for authentication.")

System_Boundary(OnlineBookstoreSystem, "Online Bookstore System") {
    Container(ReactSinglePageApplicationSPA, "React Single Page Application (SPA)", "React, AWS S3, CloudFront", "Frontend user interface hosted on AWS S3 & CloudFront.")
    Container(AWSPateway, "AWS API Gateway", "AWS API Gateway", "API routing, TLS termination, and OAuth2/OIDC token validation.")
    Container(CatalogSearch, "Catalog & Search", "Spring Boot, Amazon OpenSearch, Amazon DynamoDB", "Handles product catalog browsing and search.")
    Container(CheckoutOrder, "Checkout & Order", "Node.js/Express, Amazon Aurora PostgreSQL", "Manages secure checkout, orders, and transactional data.")
    Container(ReviewRating, "Review & Rating", "Python/FastAPI, Amazon DynamoDB", "Manages customer reviews and ratings.")
    Container(NotificationService, "Notification Service", "Node.js/Express, AWS SES, Amazon SNS, Amazon SQS", "Handles customer notifications and messaging.")
    Container(Recommendation, "Recommendation", "Python/FastAPI", "Provides product recommendations to customers.")
    Container(AWSAppMeshSecurity, "AWS App Mesh & Security", "AWS App Mesh, AWS Secrets Manager, AWS KMS", "Manages internal mTLS traffic routing and secrets/encryption.")
}

Rel(Customer, ReactSinglePageApplicationSPA, "Browses catalog, manages cart, places orders, and leaves reviews", "HTTPS/JSON, TLS 1.3")
Rel(StoreAdministrator, ReactSinglePageApplicationSPA, "Accesses admin features for catalog and store management", "HTTPS, OAuth2/OIDC")
Rel(ReactSinglePageApplicationSPA, AWSPateway, "Sends API requests for catalog, checkout, reviews, and recommendations", "HTTPS/JSON, TLS 1.3")
Rel(AWSPateway, CatalogSearch, "Routes catalog and search requests", "REST/gRPC with JWT")
Rel(AWSPateway, CheckoutOrder, "Routes checkout and order processing requests", "REST/gRPC with JWT")
Rel(AWSPateway, ReviewRating, "Routes review and rating requests", "REST/gRPC with JWT")
Rel(AWSPateway, Recommendation, "Routes recommendation requests", "REST/gRPC with JWT")
Rel(CheckoutOrder, PaymentGateway, "Processes secure payments", "HTTPS")
Rel(CheckoutOrder, NotificationService, "Triggers order notifications", "AWS SQS")
Rel(CheckoutOrder, ThirdPartyShippingCarrierAPIs, "Dispatches fulfillment details", "AWS SQS / HTTPS")
Rel(NotificationService, Customer, "Sends notifications and emails", "AWS SES / AWS SNS")
Rel(CatalogSearch, AWSAppMeshSecurity, "Secures internal microservice communication", "mTLS via AWS App Mesh")
Rel(CheckoutOrder, AWSAppMeshSecurity, "Secures internal microservice communication", "mTLS via AWS App Mesh")
Rel(ReviewRating, AWSAppMeshSecurity, "Secures internal microservice communication", "mTLS via AWS App Mesh")
Rel(NotificationService, AWSAppMeshSecurity, "Secures internal microservice communication", "mTLS via AWS App Mesh")
Rel(Recommendation, AWSAppMeshSecurity, "Secures internal microservice communication", "mTLS via AWS App Mesh")

@enduml