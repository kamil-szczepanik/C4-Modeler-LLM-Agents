@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(BookBuyerAndReviewer, "Book Buyer & Reviewer", "End user who browses, purchases, and reviews physical and electronic books.")
Person(StoreAdministrator, "Store Administrator", "Administrative user who manages the bookstore system.")
System(OnlineBookstoreSystem, "Online Bookstore System", "An Amazon-style multi-currency e-commerce platform hosted on AWS for physical and electronic book sales, designed for 1 million monthly active users globally with GDPR/CCPA and OWASP compliance.")
System_Ext(ExternalPaymentGateway, "External Payment Gateway", "External system processing multi-currency transactions.")
System_Ext(ThirdPartyShippingProviderAPI, "Third-Party Shipping Provider API", "External system handling physical book fulfillment and shipping tracking via webhooks.")
System_Ext(ExternalRecommendationService, "External Recommendation Service", "External service providing book recommendations to users.")

Rel(BookBuyerAndReviewer, OnlineBookstoreSystem, "Browses books, makes purchases, and leaves reviews", "HTTPS / TLS 1.3")
Rel(StoreAdministrator, OnlineBookstoreSystem, "Manages the bookstore operations with administrative privileges", "HTTPS / TLS 1.3 (with MFA)")
Rel(OnlineBookstoreSystem, ExternalPaymentGateway, "Processes multi-currency payments securely", "REST over TLS 1.3 / mTLS")
Rel(OnlineBookstoreSystem, ThirdPartyShippingProviderAPI, "Coordinates physical book shipping and receives status updates", "REST/Webhook over TLS 1.3 / mTLS with HMAC")
Rel(OnlineBookstoreSystem, ExternalRecommendationService, "Fetches personalized book recommendations", "gRPC/REST over TLS 1.3")
@enduml