@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore System

Person(Book_Buyer_Reviewer, "Book Buyer & Reviewer", "End user who browses, purchases, and reviews physical and electronic books.")
Person(Store_Administrator, "Store Administrator", "Administrative user who manages the bookstore system.")
Person(Marketing_Merchandising_Specialist, "Marketing/Merchandising Specialist", "Specialist managing marketing and merchandising strategies.")

System_Ext(External_Payment_Gateway, "External Payment Gateway", "External system processing multi-currency transactions.")
System_Ext(Third_Party_Shipping_Provider_API, "Third-Party Shipping Provider API", "External system handling physical book fulfillment and shipping tracking via webhooks.")
System_Ext(External_Recommendation_Service, "External Recommendation Service", "External service providing book recommendations to users.")

System_Boundary(online_bookstore_system, "Online Bookstore System") {
    Container(Single_Page_Application_SPA, "Single-Page Application (SPA)", "React / TypeScript on AWS S3 & CloudFront", "Frontend interface for book buyers and reviewers.")
    Container(Admin_Back_Office_App, "Admin / Back-Office App", "AWS / Web-based", "Back-office application for store administrators and marketing specialists.")
    Container(Amazon_API_Gateway, "Amazon API Gateway", "AWS API Gateway (REST/GraphQL)", "Entry point for client applications routing requests to backend services.")
    Container(Core_E_Commerce_API, "Core E-Commerce API", "Node.js (NestJS) on AWS ECS (Fargate)", "Handles core e-commerce business logic and orchestration.")
    Container(Recommendation_Service, "Recommendation Service", "Python (FastAPI) on AWS ECS (Fargate)", "Provides personalized book recommendations and processing.")
    ContainerDb(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL (Multi-AZ)", "Primary relational database for transactional data.")
    ContainerDb(Amazon_ElastiCache_Redis, "Amazon ElastiCache (Redis)", "Amazon ElastiCache (Redis)", "Caching layer for high-performance read operations and session data.")
    Container(Amazon_EventBridge, "Amazon EventBridge", "Amazon EventBridge", "Event bus for asynchronous event-driven integration.")
    Container(Amazon_SQS, "Amazon SQS", "Amazon SQS", "Message queue for decoupling and reliable integration.")
}

Rel(Book_Buyer_Reviewer, Single_Page_Application_SPA, "Browses books, makes purchases, and leaves reviews", "HTTPS")
Rel(Store_Administrator, Admin_Back_Office_App, "Manages store operations and catalog", "HTTPS")
Rel(Marketing_Merchandising_Specialist, Admin_Back_Office_App, "Manages marketing and merchandising campaigns", "HTTPS")
Rel(Single_Page_Application_SPA, Amazon_API_Gateway, "Makes API requests", "HTTPS (REST/GraphQL)")
Rel(Admin_Back_Office_App, Amazon_API_Gateway, "Makes administrative API requests", "HTTPS (REST/GraphQL)")
Rel(Amazon_API_Gateway, Core_E_Commerce_API, "Routes client requests securely", "mTLS")
Rel(Amazon_API_Gateway, Recommendation_Service, "Routes recommendation requests", "mTLS")
Rel(Core_E_Commerce_API, Amazon_Aurora_PostgreSQL, "Reads and writes transactional data", "TLS over TCP")
Rel(Core_E_Commerce_API, Amazon_ElastiCache_Redis, "Caches and retrieves frequently accessed data", "TLS over TCP")
Rel(Core_E_Commerce_API, Recommendation_Service, "Requests personalized recommendations", "gRPC")
Rel(Core_E_Commerce_API, Amazon_SQS, "Queues messages for third-party shipping fulfillment", "AWS SDK / API")
Rel(Amazon_SQS, Third_Party_Shipping_Provider_API, "Dispatches shipping fulfillment requests", "HTTPS")
Rel(Admin_Back_Office_App, Amazon_EventBridge, "Publishes administrative events", "AWS SDK / API")
Rel(Amazon_EventBridge, Core_E_Commerce_API, "Triggers event handlers", "Event Bus")
Rel(Amazon_EventBridge, Recommendation_Service, "Triggers event handlers", "Event Bus")

@enduml