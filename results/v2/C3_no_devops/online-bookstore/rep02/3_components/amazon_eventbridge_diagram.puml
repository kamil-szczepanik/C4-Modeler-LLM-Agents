@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_eventbridge, "Amazon EventBridge") {
    Component(Default_Bus, "Default Bus", "AWS EventBridge", "Handles default system and AWS service events.")
    Component(Custom_Event_Bus, "Custom Event Bus", "AWS EventBridge Custom Bus (bookstore.retail)", "Receives and routes custom domain events like OrderPlaced and ItemReviewed.")
    Component(Event_Rules___Routing, "Event Rules & Routing", "EventBridge Rule Engine", "Evaluates events and routes them to appropriate targets based on defined patterns.")
    Component(Target_Dispatcher, "Target Dispatcher", "EventBridge Target Dispatcher", "Dispatches matched events to downstream target services like SQS.")
    Component(Event_Archive, "Event Archive", "EventBridge Archive (bookstore-archive)", "Archives filtered events for compliance and historical tracking.")
}

Rel(Default_Bus, Event_Rules___Routing, "Routes events to", "")
Rel(Custom_Event_Bus, Event_Rules___Routing, "Routes custom domain events to", "")
Rel(Event_Rules___Routing, Target_Dispatcher, "Forwards matched events to", "")
Rel(Custom_Event_Bus, Event_Archive, "Archives filtered events via Native EventBridge Rule to", "")

@enduml