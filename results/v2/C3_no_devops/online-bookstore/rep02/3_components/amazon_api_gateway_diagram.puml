@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon API Gateway container

Container_Boundary(api_gateway, "Amazon API Gateway") {
    Component(WAFIntegrationComponent, "WAF Integration Component", "AWS WAF", "Inspects and filters incoming web traffic against OWASP Top-10 threats at the edge.")
    Component(EdgeRouterSSLTerminatingProxy, "Edge Router & SSL Terminating Proxy", "Amazon API Gateway Edge Router", "Terminates SSL/TLS connections and routes incoming requests.")
    Component(AuthorizerComponent, "Authorizer Component", "AWS Lambda Authorizers", "Validates JSON Web Tokens (JWT) and handles authentication and authorization.")
    Component(ThrottlingRateLimiter, "Throttling & Rate Limiter", "Amazon API Gateway Usage Plans", "Enforces rate limiting and throttling to protect backend services.")
    Component(APIRouterTransformer, "API Router & Transformer", "Amazon API Gateway VPC Links", "Routes and transforms validated requests to backend microservices over mTLS.")
    Component(AnalyticsMetricsComponent, "Analytics & Metrics Component", "Amazon CloudWatch & API Gateway Metrics", "Collects analytics and operational metrics for API usage.")
}

Rel(WAFIntegrationComponent, EdgeRouterSSLTerminatingProxy, "Forwards clean traffic", "HTTPS")
Rel(EdgeRouterSSLTerminatingProxy, AuthorizerComponent, "Authenticates requests", "")
Rel(AuthorizerComponent, ThrottlingRateLimiter, "Applies usage limits", "")
Rel(ThrottlingRateLimiter, APIRouterTransformer, "Passes controlled requests", "")
Rel(APIRouterTransformer, AnalyticsMetricsComponent, "Reports execution metrics", "")

@enduml