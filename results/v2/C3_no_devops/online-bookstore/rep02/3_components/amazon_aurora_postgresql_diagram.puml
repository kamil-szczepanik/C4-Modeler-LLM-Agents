@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_aurora_postgresql, "Amazon Aurora PostgreSQL") {
    Component(primary_write_instance_writer_node, "Primary Write Instance (Writer Node)", "Amazon Aurora PostgreSQL (Multi-AZ / Global Database)", "Handles core write transactions, ACID compliance, and data mutations.")
    Component(read_replica_instances_multi_az_global, "Read Replica Instances (Multi-AZ / Global)", "Amazon Aurora PostgreSQL Read Replicas", "Handles distributed read queries across regions for low-latency data access.")
    Component(database_encryption_audit_engine, "Database Encryption & Audit Engine", "AWS KMS, PostgreSQL pgaudit extension, IAM Database Authentication", "Enforces encryption-at-rest, short-lived IAM credentials, and high-privilege query compliance auditing.")
    Component(connection_pooler, "Connection Pooler", "PgBouncer / Aurora Proxy", "Manages client connections, routes traffic, and prevents thread exhaustion under high traffic.")
    Component(global_replication_manager, "Global Replication Manager", "AWS Dedicated Backbone Network", "Synchronizes cross-region data securely between primary and global read replicas.")
}

Rel(connection_pooler, primary_write_instance_writer_node, "Routes transactions", "PostgreSQL Wire Protocol over TLS 1.3")
Rel(connection_pooler, read_replica_instances_multi_az_global, "Routes read queries", "PostgreSQL Wire Protocol over TLS 1.3")
Rel(global_replication_manager, read_replica_instances_multi_az_global, "Synchronizes cross-region data", "AWS Dedicated Backbone Network with TLS")
Rel(database_encryption_audit_engine, primary_write_instance_writer_node, "Provides cryptographic keys, authentication tokens, and audit logging for security compliance", "")

@enduml