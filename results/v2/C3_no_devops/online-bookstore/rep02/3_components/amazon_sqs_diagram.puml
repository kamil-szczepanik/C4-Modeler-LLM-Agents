@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon SQS container

Container_Boundary(amazon_sqs, "Amazon SQS") {
    Component(Standard_FIFO_Queue_Engine, "Standard/FIFO Queue Engine", "AWS SQS Engine (Standard/FIFO)", "Decouples checkout from third-party shipping APIs by enqueuing shipping fulfillment orders securely.")
    Component(DLQ_Dead_Letter_Queue, "DLQ (Dead Letter Queue)", "AWS SQS DLQ", "Captures and isolates failed message deliveries for analysis and error handling.")
    Component(KMS_Encryption_Component, "KMS Encryption Component", "AWS KMS", "Secures PII data within messages for GDPR/CCPA compliance.")
}

Rel(Standard_FIFO_Queue_Engine, DLQ_Dead_Letter_Queue, "Routes failed messages", "AWS Internal")
Rel(Standard_FIFO_Queue_Engine, KMS_Encryption_Component, "Encrypts payload data", "AWS SDK")
@enduml