@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Core E_Commerce API, "Core E-Commerce API", "External client application")
System_Ext(Recommendation Service, "Recommendation Service", "External client application")

Container_Boundary(Amazon ElastiCache (Redis), "Amazon ElastiCache (Redis)") {
    Component(Session Store Component, "Session Store Component", "Redis Hashes", "Manages ephemeral user sessions and shopping carts.")
    Component(Product & Catalog Cache Component, "Product & Catalog Cache Component", "Cache-Aside pattern", "Caches serialized book details and hot categories.")
    Component(Recommendation Cache Component, "Recommendation Cache Component", "Redis", "Stores pre-computed recommendation lists generated by the Recommendation Service.")
}

Rel(Core E_Commerce API, Session Store Component, "Reads and writes session and cart data", "Redis RESP protocol over TLS/TCP")
Rel(Core E_Commerce API, Product & Catalog Cache Component, "Retrieves cached catalog data", "Redis RESP protocol over TLS/TCP")
Rel(Recommendation Service, Recommendation Cache Component, "Populates recommendation lists", "Redis RESP protocol over TLS/TCP")

@enduml