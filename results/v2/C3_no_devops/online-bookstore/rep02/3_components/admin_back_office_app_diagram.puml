@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Admin / Back-Office App container

Container_Boundary(admin_back_office_app, "Admin / Back-Office App") {
    Component(Catalog Management Component, "Catalog Management Component", "Angular / TypeScript", "Handles inventory CRUD operations")
    Component(Merchandising & Campaign Component, "Merchandising & Campaign Component", "Angular / TypeScript", "Manages promotions and recommendation overrides")
    Component(User Data & Compliance Component, "User Data & Compliance Component", "Angular / TypeScript", "Executes secure GDPR/CCPA data export and deletion workflows")
    Component(Audit Logging Service, "Audit Logging Service", "TypeScript / AWS SDK", "Captures administrative state changes")
    Component(Order & Exception Operations Component, "Order & Exception Operations Component", "Angular / TypeScript", "Powers the Reconciliation Dashboard")
    Component(Analytics & Reporting Component, "Analytics & Reporting Component", "Angular / TypeScript", "Renders promotion performance metrics")
}

System_Ext(Amazon EventBridge, "Amazon EventBridge", "Receives immutable audit logs via AWS SDK")

Rel(Audit Logging Service, Amazon EventBridge, "Publishes audit events", "AWS SDK / API")

@enduml