@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Single-Page Application (SPA) container

Container_Boundary(spa_container, "Single-Page Application (SPA)") {
    Component(Router_State_Management_Module, "Router & State Management Module", "Redux Toolkit / Zustand", "Manages application routing and global state across the SPA.")
    Component(Catalog_Search_View, "Catalog & Search View", "React / TypeScript", "Renders the book catalog, search interfaces, and item details.")
    Component(Checkout_Cart_Workflow, "Checkout & Cart Workflow", "React / TypeScript", "Handles shopping cart management and checkout flows for both guest and authenticated users.")
    Component(Review_Rating_Component, "Review & Rating Component", "React / TypeScript, DOMPurify", "Enables users to read, write, and submit book reviews with client-side input sanitization against XSS.")
    Component(API_Client, "API Client", "Axios / GraphQL client with interceptors", "Handles HTTP and GraphQL communication, authentication headers, and request/response interceptors with backend services.")
}

System_Ext(Amazon_API_Gateway, "Amazon API Gateway", "API Gateway")

Rel(Router_State_Management_Module, Catalog_Search_View, "Synchronizes application state and route parameters")
Rel(Catalog_Search_View, API_Client, "Fetches book catalog and search results", "HTTPS")
Rel(Checkout_Cart_Workflow, API_Client, "Submits cart data and checkout transactions", "HTTPS")
Rel(Review_Rating_Component, API_Client, "Sends sanitized book reviews and ratings", "HTTPS")
Rel(API_Client, Amazon_API_Gateway, "Communicates API requests and authentication flows", "HTTPS (REST/GraphQL)")

@enduml