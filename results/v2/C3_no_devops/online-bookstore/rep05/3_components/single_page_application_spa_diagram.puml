@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Single Page Application (SPA) container

Container_Boundary(spa_boundary, "Single Page Application (SPA)") {
    Component(Routing_View_Manager, "Routing & View Manager", "React Router", "Enables seamless client-side navigation for customers and administrators.")
    Component(State_Session_Store, "State & Session Store", "Redux Toolkit / React Context", "Manages cart, catalog cache, and multi-currency state (USD, EUR, GBP).")
    Component(API_Client, "API Client", "Axios/Fetch wrappers", "Communicates with API Gateway via HTTPS/REST using HttpOnly cookies.")
    Component(Localization_Engine, "Localization Engine", "React i18n / Custom JS", "Handles locale, formatting, and currency conversion.")
    Component(Telemetry_Event_Tracker, "Telemetry & Event Tracker", "Asynchronous JS / navigator.sendBeacon", "Streams clickstream and behavioral data asynchronously to analytics.")
}

System_Ext(api_gateway, "API Gateway / Envoy", "API Gateway")
System_Ext(analytics_container, "Analytics & Event Tracking Container", "Analytics Container")

Rel(Routing_View_Manager, State_Session_Store, "Reads and updates application state during navigation", "")
Rel(API_Client, api_gateway, "Sends API requests via HTTPS/REST", "HTTPS/REST")
Rel(Telemetry_Event_Tracker, analytics_container, "Streams behavioral data via navigator.sendBeacon to AWS Kinesis", "navigator.sendBeacon")

@enduml