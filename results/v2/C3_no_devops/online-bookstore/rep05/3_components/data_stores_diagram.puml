@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(data_stores, "Data Stores") {
    Component(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL", "PostgreSQL", "Multi-region ACID transactions for core bookstore entities.")
    Component(AmazonDynamoDB, "Amazon DynamoDB", "DynamoDB Global Tables", "Low-latency storage for user shopping carts.")
    Component(AWSOpenSearchService, "AWS OpenSearch Service", "OpenSearch", "Handles global catalog search and personalized recommendations.")
    Component(IdentityComplianceDB, "Identity & Compliance DB", "Database", "Stores user identity and compliance-related records.")
    Component(AWSLambdaDataDeletionWorker, "AWS Lambda Data Deletion Worker", "AWS Lambda", "Executes cryptographic erasure and data deletion for GDPR/CCPA compliance.")
}

Rel(AWSLambdaDataDeletionWorker, IdentityComplianceDB, "Deletes user data for compliance")
Rel(AWSLambdaDataDeletionWorker, AmazonAuroraPostgreSQL, "Purges personal data")
Rel(AWSLambdaDataDeletionWorker, AmazonDynamoDB, "Removes cart and session data")
@enduml