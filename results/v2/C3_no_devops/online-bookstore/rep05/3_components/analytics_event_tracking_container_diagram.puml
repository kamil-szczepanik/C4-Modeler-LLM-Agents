@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Analytics & Event Tracking Container

Person(CustomersAndBookstoreAdministrators, "Customers and Bookstore Administrators", "Users interacting with the system, including customers sending clickstream/search events and administrators querying dashboards.")

Container_Boundary(AnalyticsAndEventTrackingContainer, "Analytics & Event Tracking Container") {
    Component(SinglePageApplication, "Single Page Application", "Web Browser / Frontend", "Sends clickstream and search events.")
    Component(IngestionAPI, "Ingestion API", "Node.js / AWS API Gateway", "Receives real-time telemetry ingestion and forwards scrubbed events.")
    Component(StreamProcessor, "Stream Processor", "AWS Kinesis / Apache Flink", "Performs data masking and analytical processing for real-time telemetry.")
    Component(AsyncEventBus, "Async Event Bus", "Amazon EventBridge", "Publishes real-time user actions.")
    Component(DataFirehose, "Data Firehose", "AWS Kinesis Data Firehose", "Persists aggregated analytics to data stores.")
    Component(ReportingAndInsightsAPI, "Reporting & Insights API", "Node.js / AWS Lambda", "Executes analytical queries for administrative sales insights and dashboards.")
    Component(DataStores, "Data Stores", "AWS S3 / Snowflake", "High-performance data warehousing for historical analytics and data-at-rest storage.")
}

Rel(SinglePageApplication, IngestionAPI, "Sends clickstream and search events", "HTTPS / JSON")
Rel(IngestionAPI, StreamProcessor, "Forwards scrubbed events", "AWS Kinesis")
Rel(StreamProcessor, AsyncEventBus, "Publishes real-time user actions", "Amazon EventBridge")
Rel(DataFirehose, DataStores, "Persists aggregated analytics", "S3/Snowflake Bulk Load")
Rel(CustomersAndBookstoreAdministrators, ReportingAndInsightsAPI, "Queries dashboards", "HTTPS / JSON")
Rel(ReportingAndInsightsAPI, DataStores, "Executes analytical queries", "JDBC / Snowflake SQL")

@enduml