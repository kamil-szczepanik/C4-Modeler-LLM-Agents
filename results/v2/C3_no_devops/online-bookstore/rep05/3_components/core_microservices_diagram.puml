@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Microservices container

System_Ext(PaymentGateway, "Payment Gateway", "External payment provider")
System_Ext(AsyncEventBus, "Async Event Bus", "Amazon EventBridge, SNS, SQS")
System_Ext(DataStores, "Data Stores", "AWS RDS PostgreSQL, DynamoDB, Elasticsearch")

Container_Boundary(CoreMicroservices, "Core Microservices") {
    Component(CatalogService, "Catalog Service", "Go", "Manages the book catalog, product details, and inventory.")
    Component(CheckoutCartService, "Checkout & Cart Service", "Go", "Handles shopping cart state, order processing, and integration with payment gateways.")
    Component(RecommendationService, "Recommendation Service", "Python", "Provides personalized book recommendations to customers.")
    Component(ReviewRatingService, "Review & Rating Service", "Node.js", "Manages customer reviews, ratings, and feedback.")
    Component(ModerationWorker, "Moderation Worker", "Python", "Moderates user-submitted reviews and content asynchronously.")
}

Rel(CheckoutCartService, PaymentGateway, "Processes transactions", "HTTPS/JSON")
Rel(CheckoutCartService, AsyncEventBus, "Publishes and consumes domain events", "JSON over SNS/SQS")
Rel(CatalogService, AsyncEventBus, "Publishes and consumes domain events", "JSON over SNS/SQS")
Rel(RecommendationService, AsyncEventBus, "Publishes and consumes domain events", "JSON over SNS/SQS")
Rel(ReviewRatingService, AsyncEventBus, "Publishes and consumes domain events", "JSON over SNS/SQS")
Rel(ModerationWorker, AsyncEventBus, "Publishes and consumes domain events", "JSON over SNS/SQS")

Rel(CheckoutCartService, DataStores, "Reads and writes data", "PostgreSQL protocol, DynamoDB API")
Rel(CatalogService, DataStores, "Reads and writes data", "PostgreSQL protocol, Elasticsearch API")
Rel(RecommendationService, DataStores, "Reads and writes data", "DynamoDB API")
Rel(ReviewRatingService, DataStores, "Reads and writes data", "PostgreSQL protocol")
Rel(ModerationWorker, DataStores, "Reads and writes data", "PostgreSQL protocol")

@enduml