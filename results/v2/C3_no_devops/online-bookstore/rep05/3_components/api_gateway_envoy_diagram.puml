@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_envoy, "API Gateway / Envoy") {
    Component(AWSAPIGatewayEdgeRouter, "AWS API Gateway Edge Router", "AWS API Gateway", "Handles edge routing, ingress traffic entry, and initial request distribution.")
    Component(EnvoyProxyRouter, "Envoy Proxy Router", "Envoy Proxy", "Performs low-latency service mesh routing, mTLS enforcement, and downstream load balancing.")
    Component(RateLimiter, "Rate Limiter", "Envoy Rate Limiting Extension / AWS ElastiCache (Redis)", "Evaluates rate limits and tracks token buckets for incoming client requests.")
    Component(OWASPDefenseFilter, "OWASP Defense Filter", "AWS WAF / Custom Envoy Filter", "Blocks web exploits, SQL injections, and malicious bot traffic at the edge.")
}

Rel(AWSAPIGatewayEdgeRouter, OWASPDefenseFilter, "Inspects inbound requests for security threats", "HTTPS")
Rel(OWASPDefenseFilter, RateLimiter, "Checks request volume limits", "TCP")
Rel(RateLimiter, EnvoyProxyRouter, "Allows or rejects authenticated requests based on rate policies", "")
Rel(EnvoyProxyRouter, Core Microservices, "Routes authenticated requests", "gRPC over HTTP/2, mTLS")
@enduml