@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore Software System

Person(Customer, "Customer", "Shopper who browses, purchases, and reviews physical and electronic books.")
Person(BookstoreAdministrator, "Bookstore Administrator", "Administrator who manages the bookstore operations and catalog.")

System_Ext(PaymentGateway, "Payment Gateway", "External payment processor such as Stripe or PayPal.")
System_Ext(ThirdPartyShipping, "Third-Party Shipping", "External partner responsible for shipping logistics and tracking.")
System_Ext(TaxService, "Tax Service", "External service handling tax calculations.")

System_Boundary(OnlineBookstoreSoftwareSystem, "Online Bookstore Software System") {
    Container(SPA, "Single Page Application (SPA)", "React, AWS S3, CloudFront", "Global low-latency frontend delivery providing user interface for customers and administrators.")
    Container(APIGatewayEnvoy, "API Gateway / Envoy", "AWS API Gateway, Envoy", "Provides OWASP Top-10 defense, rate limiting, and JWT validation.")
    Container(CoreMicroservices, "Core Microservices", "Node.js / Go / Python, AWS ECS/Fargate, AWS App Mesh", "Scalable microservices execution handling catalog, checkout, and recommendation.")
    Container(AnalyticsEventTrackingContainer, "Analytics & Event Tracking Container", "AWS Kinesis, Firehose, S3/Snowflake", "Real-time telemetry ingestion with edge data masking.")
    Container(AsyncEventBus, "Async Event Bus", "Amazon EventBridge, SNS, SQS", "Handles asynchronous event distribution for fulfillment and system messaging.")
    ContainerDb(DataStores, "Data Stores", "AWS RDS PostgreSQL, DynamoDB, Identity & Compliance DB, Elasticsearch", "Transactional, high-throughput NoSQL, identity, and search data persistence.")
}

Rel(Customer, SPA, "Browses, purchases, and reviews books", "HTTPS / React & AWS CloudFront (<2s load time)")
Rel(BookstoreAdministrator, SPA, "Manages bookstore operations and catalog", "HTTPS / React & AWS CloudFront")
Rel(SPA, APIGatewayEnvoy, "Sends API requests", "HTTPS/REST")
Rel(APIGatewayEnvoy, CoreMicroservices, "Routes authenticated requests securely", "mTLS (AWS App Mesh)")
Rel(CoreMicroservices, PaymentGateway, "Processes payments via Checkout Service", "HTTPS/JSON")
Rel(CoreMicroservices, TaxService, "Calculates taxes via Checkout Service", "HTTPS/JSON")
Rel(CoreMicroservices, AsyncEventBus, "Publishes and consumes events", "AMQP/HTTPS")
Rel(CoreMicroservices, DataStores, "Reads and writes transactional and operational data", "PostgreSQL protocol / DynamoDB API / Elasticsearch API")
Rel(AnalyticsEventTrackingContainer, DataStores, "Persists masked telemetry and analytics data", "S3 / Snowflake ingestion")
Rel(AsyncEventBus, ThirdPartyShipping, "Triggers fulfillment and shipping processes", "HTTPS/REST")

@enduml