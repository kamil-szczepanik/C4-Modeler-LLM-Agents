@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "Shopper who browses, purchases, and reviews physical and electronic books.")
Person(Bookstore Administrator, "Bookstore Administrator", "Administrator who manages the bookstore operations and catalog.")

System(Online Bookstore Software System, "Online Bookstore Software System", "An Amazon-style global e-commerce platform for physical and electronic books with recommendations, reviews, and multi-currency support, deployed across three global AWS regions for high availability, sub-2-second performance, and GDPR/CCPA compliance.")

System_Ext(Third-Party Fulfillment Partner, "Third-Party Fulfillment Partner", "Partner responsible for fulfilling book orders and shipping.")
System_Ext(Payment Gateway, "Payment Gateway", "External payment processor such as Stripe or PayPal.")
System_Ext(Third-Party Shipping Provider APIs, "Third-Party Shipping Provider APIs", "External APIs used for shipping logistics and tracking.")
System_Ext(Identity Provider / Auth Service, "Identity Provider / Auth Service", "Authentication and identity service such as Auth0 or AWS Cognito.")
System_Ext(Tax & Compliance Service, "Tax & Compliance Service", "External service handling tax calculations and regulatory compliance.")

Rel(Customer, Online Bookstore Software System, "Uses the bookstore platform to browse, purchase, and review books", "HTTPS (TLS 1.3)")
Rel(Bookstore Administrator, Online Bookstore Software System, "Accesses bookstore management functions securely", "ZTNA-secured HTTPS sessions")
Rel(Third-Party Fulfillment Partner, Online Bookstore Software System, "Accesses fulfillment data and updates order status", "ZTNA-secured HTTPS sessions")
Rel(Online Bookstore Software System, Payment Gateway, "Processes payments and receives payment webhooks", "HTTPS/REST with HMAC SHA-256 webhooks")
Rel(Online Bookstore Software System, Third-Party Shipping Provider APIs, "Sends shipping requests and receives tracking webhooks", "HTTPS/REST with HMAC SHA-256 webhooks")
Rel(Online Bookstore Software System, Identity Provider / Auth Service, "Authenticates users and verifies sessions", "OIDC/OAuth2")
Rel(Online Bookstore Software System, Tax & Compliance Service, "Calculates taxes and checks compliance regulations", "HTTPS/REST using OAuth 2.0 client credentials and mTLS")

@enduml