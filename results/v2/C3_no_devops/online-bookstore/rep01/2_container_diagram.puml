@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore System

Person(Customers, "Customers", "End users who browse the catalog, manage carts, and execute secure checkouts.")
Person(Store Administrators, "Store Administrators", "Operators responsible for managing platform back-office operations and catalogs.")

System_Ext(Payment Gateway, "Payment Gateway", "External service handling secure financial transactions and payment processing.")
System_Ext(Third-Party Shipping APIs, "Third-Party Shipping APIs", "External services managing order fulfillment, tracking, and delivery logistics.")
System_Ext(AWS Cognito, "AWS Cognito", "Identity provider handling OAuth2/OIDC authentication and authorization.")
System_Ext(AWS SQS/SNS, "AWS SQS/SNS", "Message brokers supporting asynchronous event-driven communication.")

System_Boundary(Online Bookstore System, "Online Bookstore System") {
    Container(React SPA, "React SPA", "React, TypeScript, AWS S3, CloudFront, WAF", "Frontend and admin back-office application delivering high-performance catalog browsing and user interfaces.")
    Container(AWS API Gateway & CloudFront, "AWS API Gateway & CloudFront", "AWS API Gateway, AWS CloudFront, WAF, mTLS", "Ingress management and routing layer protecting and routing incoming traffic.")
    Container(Catalog & Search Container, "Catalog & Search Container", "Spring Boot, Amazon OpenSearch", "Handles product catalog management and high-performance search queries.")
    Container(Order & Checkout Container, "Order & Checkout Container", "Node.js, TypeScript", "Manages order placement, checkout workflows, and secure integrations with external payment and shipping services.")
    Container(Recommendation & Review Container, "Recommendation & Review Container", "Python FastAPI", "Generates personalized recommendations and handles product reviews.")
    Container(Customer Engagement & Notification Container, "Customer Engagement & Notification Container", "Node.js worker", "Processes asynchronous events to dispatch customer notifications and engagement messages.")
    ContainerDb(Amazon Aurora PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Relational database storing transactional data.")
    ContainerDb(Amazon DynamoDB, "Amazon DynamoDB", "Amazon DynamoDB", "NoSQL database storing session and cart data.")
    ContainerDb(Amazon ElastiCache Redis, "Amazon ElastiCache Redis", "Amazon ElastiCache Redis", "In-memory cache supporting fast catalog data retrieval.")
}

Rel(Customers, React SPA, "Browse catalog and manage checkouts via the web application", "HTTPS / TLS 1.3")
Rel(Store Administrators, React SPA, "Manage platform back-office operations", "HTTPS / TLS 1.3")
Rel(React SPA, AWS API Gateway & CloudFront, "Sends API requests to backend services", "HTTPS / TLS 1.3")
Rel(AWS API Gateway & CloudFront, Catalog & Search Container, "Routes synchronous catalog and search traffic", "REST / JSON over HTTP (VPC links, mTLS)")
Rel(AWS API Gateway & CloudFront, Order & Checkout Container, "Routes synchronous checkout traffic", "REST / JSON over HTTP (VPC links, mTLS)")
Rel(AWS API Gateway & CloudFront, Recommendation & Review Container, "Routes recommendation and review requests", "REST / JSON over HTTP (VPC links, mTLS)")
Rel(Catalog & Search Container, Amazon ElastiCache Redis, "Caches catalog data for high performance", "Redis Protocol")
Rel(Order & Checkout Container, Amazon Aurora PostgreSQL, "Persists transactional order data", "PostgreSQL Wire Protocol")
Rel(Order & Checkout Container, Amazon DynamoDB, "Stores session and shopping cart state", "DynamoDB API")
Rel(Order & Checkout Container, Payment Gateway, "Processes secure payments", "REST / JSON over HTTPS")
Rel(Order & Checkout Container, Third-Party Shipping APIs, "Initiates shipping and fulfillment", "REST / JSON over HTTPS")
Rel(Order & Checkout Container, AWS SQS/SNS, "Publishes order-placed domain events", "AWS SDK / TLS")
Rel(AWS SQS/SNS, Customer Engagement & Notification Container, "Triggers asynchronous notification workflows", "AWS SQS / SNS")

@enduml