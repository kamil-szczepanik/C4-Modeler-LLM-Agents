@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Order & Checkout Container container

Container_Boundary(order_checkout_container, "Order & Checkout Container") {
    Component(Cart_Management_Component, "Cart Management Component", "Node.js & TypeScript", "Manages shopping cart sessions and state.")
    Component(Checkout_Orchestrator_Component, "Checkout Orchestrator Component", "Node.js & TypeScript", "Orchestrates order placement, cart workflows, and coordinates payment and fulfillment.")
    Component(Payment_Integration_Component, "Payment Integration Component", "Node.js & TypeScript", "Handles secure integrations with payment services.")
    Component(Fulfillment_Tax_Component, "Fulfillment & Tax Component", "Node.js & TypeScript", "Manages shipping fulfillment and tax calculation services.")
    Component(Order_Event_Publisher_Component, "Order Event Publisher Component", "Node.js & TypeScript", "Dispatches domain events for notifications.")
    ComponentDb(Amazon_DynamoDB, "Amazon DynamoDB", "AWS DynamoDB", "Provides low-latency, scalable storage for shopping cart states.")
    ComponentDb(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Persists finalized orders transactionally and guarantees strict transactional integrity.")
}

Component(Payment_Gateway, "Payment Gateway", "REST / JSON over HTTPS / TLS 1.3", "External payment processing gateway.")
Component(Third_Party_Shipping_APIs, "Third-Party Shipping APIs", "REST / JSON over HTTPS / TLS 1.3", "External shipping and fulfillment APIs.")
Component(Tax_Calculation_Service, "Tax Calculation Service", "REST / JSON over HTTPS / TLS 1.3", "External service for calculating regional taxes.")
Component(Email_Notification_Service_via_AWS_SQS_SNS, "Email/Notification Service (via AWS SQS/SNS)", "AWS SQS/SNS", "Enables asynchronous, decoupled domain event publishing for notifications.")

Rel(Cart_Management_Component, Amazon_DynamoDB, "Reads and writes cart sessions", "DynamoDB API / TLS 1.3")
Rel(Checkout_Orchestrator_Component, Amazon_Aurora_PostgreSQL, "Persists finalized orders transactionally", "PostgreSQL Wire Protocol / TLS 1.3")
Rel(Checkout_Orchestrator_Component, Payment_Integration_Component, "Invokes idempotent payment processing", "Internal Async/Await")
Rel(Checkout_Orchestrator_Component, Fulfillment_Tax_Component, "Requests tax calculation and shipping fulfillment", "Internal Async/Await")
Rel(Payment_Integration_Component, Payment_Gateway, "Processes secure payments", "REST / JSON over HTTPS / TLS 1.3")
Rel(Fulfillment_Tax_Component, Third_Party_Shipping_APIs, "Initiates shipping and fulfillment", "REST / JSON over HTTPS / TLS 1.3")
Rel(Fulfillment_Tax_Component, Tax_Calculation_Service, "Calculates regional taxes", "REST / JSON over HTTPS / TLS 1.3")
Rel(Order_Event_Publisher_Component, Email_Notification_Service_via_AWS_SQS_SNS, "Dispatches `OrderPlaced` domain events", "AWS SDK / TLS 1.3")

@enduml