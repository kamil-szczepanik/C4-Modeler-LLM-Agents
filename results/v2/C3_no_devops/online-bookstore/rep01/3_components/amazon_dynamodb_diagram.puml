@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Amazon DynamoDB", "Amazon DynamoDB") {
    Component("ShoppingCarts Table", "ShoppingCarts Table", "AWS DynamoDB NoSQL Table", "Manages customer shopping carts with single-digit millisecond latency.")
    Component("UserSessions Table", "UserSessions Table", "AWS DynamoDB NoSQL Table", "Manages user sessions with serverless scaling and TTL enforcement for GDPR compliance.")
    Component("DynamoDB Global Tables", "DynamoDB Global Tables", "AWS DynamoDB Multi-Region Replication", "Provides multi-region replication across us-east-1, eu-west-1, and ap-southeast-1 to guarantee low latency.")
}

Rel("ShoppingCarts Table", "DynamoDB Global Tables", "Replicates cart data globally across regions", "HTTPS/DynamoDB API")
Rel("UserSessions Table", "DynamoDB Global Tables", "Replicates session data globally across regions", "HTTPS/DynamoDB API")

@enduml