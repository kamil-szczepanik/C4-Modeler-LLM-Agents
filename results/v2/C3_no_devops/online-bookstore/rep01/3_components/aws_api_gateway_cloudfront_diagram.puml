@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_api_gateway_cloudfront, "AWS API Gateway & CloudFront") {
    Component(Amazon_CloudFront, "Amazon CloudFront", "AWS CloudFront", "Caches and delivers static assets globally while routing dynamic traffic.")
    Component(AWS_WAF, "AWS WAF", "AWS WAF", "Provides edge security and mitigates OWASP Top-10 threats.")
    Component(Amazon_Route_53, "Amazon Route 53", "Amazon Route 53", "Handles global DNS routing.")
    Component(Amazon_API_Gateway, "Amazon API Gateway", "Amazon API Gateway Regional Endpoints", "Manages incoming REST API requests using usage plans and API keys, routing via VPC Links.")
}

Rel(Amazon_CloudFront, AWS_WAF, "Inspects requests for security threats", "HTTPS")
Rel(Amazon_CloudFront, Amazon_Route_53, "Resolves DNS queries", "DNS")
Rel(Amazon_CloudFront, Amazon_API_Gateway, "Routes dynamic traffic", "HTTPS")

@enduml