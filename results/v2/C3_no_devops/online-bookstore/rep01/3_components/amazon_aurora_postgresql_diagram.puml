@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_aurora_postgresql, "Amazon Aurora PostgreSQL") {
    Component(Primary_DB_Instance_Writer, "Primary DB Instance (Writer)", "Amazon Aurora PostgreSQL", "Accepts write-heavy transactions from the checkout container.")
    Component(Replica_DB_Instances_Readers, "Replica DB Instances (Readers)", "Amazon Aurora PostgreSQL", "Offloads read-only queries across Availability Zones.")
    Component(Aurora_Storage_Volume, "Aurora Storage Volume", "Distributed SSD Volume", "Distributed SSD volume spanning three AZs for fault tolerance.")
    Component(Aurora_Global_Database, "Aurora Global Database", "AWS Aurora Global Database", "Cross-region deployment across us-east-1, eu-west-1, and ap-southeast-1.")
    Component(Database_Migration_Manager, "Database Migration Manager", "Flyway / Liquibase", "Manages schema versioning and multi-currency decimal types.")
}

Rel(Primary_DB_Instance_Writer, Aurora_Storage_Volume, "Performs block-level replication across 3 AZs", "AWS Proprietary Protocol")
Rel(Aurora_Global_Database, Replica_DB_Instances_Readers, "Synchronizes data across cross-region clusters", "AWS KMS encrypted transit")
@enduml