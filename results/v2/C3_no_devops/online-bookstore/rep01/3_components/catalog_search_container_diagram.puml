@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Ext(aws_api_gateway_cloudfront, "AWS API Gateway & CloudFront", "AWS Gateway / CDN", "Entry point for client applications.")

ContainerDb(amazon_elasticache_redis, "Amazon ElastiCache Redis", "Redis", "Delivers sub-millisecond hot-item caching and rate-limiting storage.")
ContainerDb(amazon_aurora_postgresql, "Amazon Aurora PostgreSQL", "PostgreSQL", "Stores persistent catalog data securely with IAM authentication.")
ContainerDb(amazon_opensearch, "Amazon OpenSearch", "OpenSearch", "Enables scalable full-text search, facets, and fuzzy typo-tolerance.")

Container_Boundary(catalog_search_container, "Catalog & Search Container") {
    Component(search_controller, "Search Controller", "Spring MVC REST endpoints", "Provides REST endpoints for product browsing and search.")
    Component(admin_catalog_controller, "Admin Catalog Controller", "Spring MVC administrative endpoints", "Provides administrative endpoints with RBAC enforcement.")
    Component(catalog_service, "Catalog Service", "Spring Boot Business Logic", "Business logic for product retrieval and inventory mapping.")
    Component(search_indexer, "Search Indexer", "Spring Data / OpenSearch Client", "Handles full-text search and fuzzy matching.")
    Component(cache_manager, "Cache Manager", "Spring Cache with Lettuce", "Manages caching for Amazon ElastiCache Redis.")
    Component(audit_logging_aspect, "Audit Logging Aspect", "Spring AOP", "Tracks modifications for audit logging.")
}

Rel(aws_api_gateway_cloudfront, search_controller, "REST / JSON over HTTP via mTLS", "")
Rel(search_controller, catalog_service, "In-process Java method calls", "")
Rel(search_controller, search_indexer, "In-process Java method calls", "")
Rel(admin_catalog_controller, catalog_service, "In-process Java method calls with RBAC enforcement", "")
Rel(catalog_service, cache_manager, "Redis Protocol", "")
Rel(cache_manager, amazon_elasticache_redis, "Redis Protocol", "")
Rel(catalog_service, amazon_aurora_postgresql, "JDBC / TLS 1.3", "")
Rel(search_indexer, amazon_opensearch, "HTTPS / TLS 1.3", "")

@enduml