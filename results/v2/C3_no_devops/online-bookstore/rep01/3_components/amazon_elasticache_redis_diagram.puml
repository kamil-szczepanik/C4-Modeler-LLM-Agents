@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon ElastiCache Redis container

Container_Ext(Catalog_Search_Container, "Catalog & Search Container", "Spring Boot, Amazon OpenSearch", "Handles catalog browsing and search queries.")
Container_Ext(Order_Checkout_Container, "Order & Checkout Container", "Node.js, TypeScript", "Manages orders and checkout processes.")
System_Ext(AWS_SQS_SNS, "AWS SQS/SNS", "AWS Messaging", "Event-driven messaging service.")

Container_Boundary(Amazon_ElastiCache_Redis, "Amazon ElastiCache Redis") {
    Component(Catalog_Cache_Component, "Catalog Cache Component", "In-memory Data Store", "Stores serialized product details and search results in-memory.")
    Component(Session_Cart_State_Component, "Session & Cart State Component", "In-memory Hashes", "Manages ephemeral user cart states using in-memory hashes.")
    Component(Replication_Persistence_Manager, "Replication & Persistence Manager", "Multi-AZ Replication, AOF/RDB", "Handles multi-AZ replication groups, AOF/RDB snapshots, and automated failover.")
    Component(Cache_Invalidation_Pub_Sub_Worker, "Cache Invalidation & Pub/Sub Worker", "Redis Pub/Sub", "Processes invalidation events to safely prune stale keys via Redis Pub/Sub.")
}

Rel(Catalog_Search_Container, Catalog_Cache_Component, "Queries catalog data and issues invalidation commands", "Redis Protocol over TLS (TCP 6379)")
Rel(Order_Checkout_Container, Session_Cart_State_Component, "Manages session and cart states", "Redis Protocol over TLS (TCP 6379)")
Rel(AWS_SQS_SNS, Cache_Invalidation_Pub_Sub_Worker, "Triggers event-driven cache invalidation hooks", "")

@enduml