@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the React SPA container

Container_Boundary("React SPA", "React SPA") {
    Component(Router & View Controller, "Router & View Controller", "React Router, TypeScript", "Handles client-side routing, view rendering, and localized layout states for sub-2s loads.")
    Component(State & Cache Manager, "State & Cache Manager", "Zustand, TanStack Query", "Manages global UI state, multi-currency preferences, and efficient client-side API caching.")
    Component(API Client, "API Client", "Axios, TypeScript", "Sends secure HTTPS/TLS 1.3 requests with localized headers to the API Gateway.")
}

System_Ext(AWS API Gateway & CloudFront, "AWS API Gateway & CloudFront", "API Management & Edge Security")

Rel(Router & View Controller, State & Cache Manager, "Reads and updates application state")
Rel(State & Cache Manager, API Client, "Triggers data fetching and mutations")
Rel(API Client, AWS API Gateway & CloudFront, "Sends API requests", "HTTPS / TLS 1.3")

@enduml