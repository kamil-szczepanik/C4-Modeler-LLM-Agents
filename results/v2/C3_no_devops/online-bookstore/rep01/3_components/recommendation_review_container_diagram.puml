@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Recommendation & Review Container container

Component_Ext(aws_api_gateway, "AWS API Gateway", "AWS", "Routes requests to the Recommendation & Review Container.")
Component_Ext(order_checkout_container, "Order & Checkout Container", "Container", "Validates purchases made by customers.")
Component_Ext(external_recommendation_engine, "External Recommendation Engine", "External Service", "External system providing book suggestions.")

Container_Boundary(recommendation_review_container, "Recommendation & Review Container") {
    Component(review_controller_service, "Review Controller & Service", "Python FastAPI", "Handles customer reviews and publishes review events.")
    Component(recommendation_controller_service, "Recommendation Controller & Service", "Python FastAPI", "Provides personalized book suggestions by fetching from the external recommendation engine.")
    Component(helpfulness_service, "Helpfulness Service", "Python FastAPI", "Manages and persists vote tallies for reviews.")
    Component(order_verification_client, "Order Verification Client", "Python FastAPI", "Validates purchases with the Order & Checkout Container.")
    Component(async_event_publisher, "Async Event Publisher", "Celery / Python", "Asynchronous task queue for offloading review moderation events.")
    Component(aws_sqs, "AWS SQS", "AWS SQS", "Message broker for decoupled sentiment analysis and moderation.")
    Component(amazon_dynamodb, "Amazon DynamoDB", "Amazon DynamoDB", "High-concurrency NoSQL storage for review helpfulness votes.")
}

Rel(aws_api_gateway, review_controller_service, "Routes requests", "REST / JSON over HTTP, mTLS")
Rel(aws_api_gateway, recommendation_controller_service, "Routes requests", "REST / JSON over HTTP, mTLS")
Rel(review_controller_service, aws_sqs, "Publishes review events", "Async / AWS SQS SDK")
Rel(recommendation_controller_service, external_recommendation_engine, "Fetches suggestions", "gRPC / TLS")
Rel(helpfulness_service, amazon_dynamodb, "Persists vote tallies", "NoSQL / AWS SDK")
Rel(order_verification_client, order_checkout_container, "Validates purchases", "REST / JSON over HTTP, VPC")

@enduml