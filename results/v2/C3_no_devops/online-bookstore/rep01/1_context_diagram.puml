@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers, "Customers", "End users who browse, purchase books, and receive personalized recommendations.")
Person(Publishers, "Book Authors/Publishers", "Content creators and suppliers who manage their book listings and inventory.")
Person(Administrators, "Store Administrators", "System operators responsible for managing platform operations, compliance, and user roles.")

System(OnlineBookstoreSystem, "Online Bookstore System", "An Amazon-style global e-commerce platform designed to support scalable book purchasing, multi-currency transactions, and personalized recommendations.")

System_Ext(PaymentGateway, "Payment Gateway", "External service handling secure multi-currency financial transactions and payment processing.")
System_Ext(ShippingAPIs, "Third-Party Shipping APIs", "External services managing order fulfillment, tracking, and delivery logistics.")
System_Ext(TaxService, "Tax Calculation Service", "External service calculating applicable taxes based on regional compliance and customer location.")
System_Ext(EmailService, "Email/Notification Service", "External service dispatching transactional emails and customer notifications.")
System_Ext(RecommendationEngine, "Recommendation Engine", "External system generating personalized book recommendations for users.")
System_Ext(WAF, "Web Application Firewall (WAF)", "Security infrastructure protecting the system from web exploits and ensuring regulatory compliance.")
System_Ext(ApiGateway, "AWS API Gateway", "Infrastructure service managing incoming API requests and routing traffic securely.")
System_Ext(MessageBrokers, "AWS SQS/SNS", "TLS-encrypted message brokers supporting asynchronous event-driven communication.")

Rel(Customers, OnlineBookstoreSystem, "Interact with the platform via Web/Mobile Clients to browse and purchase books", "HTTPS (TLS 1.3)")
Rel(Publishers, OnlineBookstoreSystem, "Manage book listings and catalog data", "HTTPS (TLS 1.3)")
Rel(Administrators, OnlineBookstoreSystem, "Administer platform settings and oversee operations", "HTTPS (TLS 1.3)")

Rel(OnlineBookstoreSystem, PaymentGateway, "Process payments and multi-currency transactions", "REST/JSON over HTTPS")
Rel(OnlineBookstoreSystem, ShippingAPIs, "Initiate and track shipping logistics", "REST/JSON over HTTPS")
Rel(OnlineBookstoreSystem, TaxService, "Calculate region-specific transaction taxes", "REST/JSON over HTTPS")
Rel(OnlineBookstoreSystem, EmailService, "Send out notifications and transactional emails asynchronously", "AWS SQS/SNS (TLS 1.3)")
Rel(OnlineBookstoreSystem, RecommendationEngine, "Fetch and process personalized recommendations asynchronously", "AWS SQS/SNS (TLS 1.3)")

@enduml