@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore

Person(Customer, "Customer", "End-user who browses, purchases books, and interacts with reviews and recommendations via web apps.")
Person(Admin_Content_Manager, "Admin / Content Manager", "System administrator and content manager who manages the platform using secure authentication.")

System_Ext(Payment_Gateway, "Payment Gateway", "External service like Stripe or PayPal for processing payments.")
System_Ext(Shipping_Provider_APIs, "Shipping Provider APIs", "External logistics services like FedEx or UPS for managing shipments.")
System_Ext(Tax_Compliance_Service, "Tax & Compliance Service", "External service like Avalara for handling tax and compliance.")
System_Ext(Recommendation_Engine, "Recommendation Engine", "AWS Personalize service providing book recommendations.")

System_Boundary(Online_Bookstore, "Online Bookstore") {
    Container(SPA_Admin_Portal, "Single-Page Application (SPA) & Back-Office Admin Portal", "React, Amazon S3, Amazon CloudFront", "Provides customer-facing web application and back-office admin portal for sub-2s global page loads.")
    Container(API_Gateway, "API Gateway", "Amazon API Gateway", "Routes client traffic to core microservices via VPC Links with mTLS and handles REST/HTTPS requests with JWT authentication.")
    Container(Core_Microservices, "Core Microservices", "Spring Boot, Python/FastAPI, Amazon ECS Fargate", "Includes Catalog & Search, Checkout & Order, Recommendation, and Admin & Compliance services.")
    ContainerDb(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Stores relational and transactional data.")
    ContainerDb(Amazon_DynamoDB, "Amazon DynamoDB", "Amazon DynamoDB", "Stores low-latency cart states.")
}

Rel(Customer, SPA_Admin_Portal, "Accesses via HTTPS over CloudFront", "HTTPS")
Rel(Admin_Content_Manager, SPA_Admin_Portal, "Accesses admin portal via HTTPS over CloudFront", "HTTPS")
Rel(SPA_Admin_Portal, API_Gateway, "Communicates using REST/HTTPS and JWT authentication", "REST/HTTPS, JWT")
Rel(API_Gateway, Core_Microservices, "Routes traffic via VPC Links", "mTLS")
Rel(Core_Microservices, Amazon_Aurora_PostgreSQL, "Reads and writes relational data", "JDBC/TLS")
Rel(Core_Microservices, Amazon_DynamoDB, "Reads and writes low-latency cart states", "AWS SDK / TLS")
Rel(Core_Microservices, Payment_Gateway, "Processes customer payments", "REST/TLS")
Rel(Core_Microservices, Shipping_Provider_APIs, "Manages book shipping and delivery", "REST/TLS")
Rel(Core_Microservices, Tax_Compliance_Service, "Calculates taxes and ensures compliance", "REST/TLS")
Rel(Core_Microservices, Recommendation_Engine, "Retrieves book recommendations", "REST/TLS")

@enduml