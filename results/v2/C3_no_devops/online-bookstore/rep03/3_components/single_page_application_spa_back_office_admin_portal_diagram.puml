@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(API_Gateway, "API Gateway", "Amazon API Gateway")

Container_Boundary(spa_boundary, "Single-Page Application (SPA) & Back-Office Admin Portal") {
    Component(Storefront_Module, "Storefront Module", "React, Redux Toolkit, DOMPurify", "Manages component-based UI, shopping cart optimistic updates, localized multi-currency rendering, and sanitizes user-generated customer reviews against DOM-based XSS.")
    Component(Admin_Portal_Module, "Admin Portal Module", "React, React Router", "Provides administrative interfaces and routing for back-office management.")
    Component(Auth___Consent_Manager, "Auth & Consent Manager", "React Context, AWS Amplify, AWS Cognito", "Manages OIDC authentication, JWT sessions, and MFA enforcement.")
    Component(API_Client_Interceptor, "API Client Interceptor", "Axios", "Handles centralized communication and token management for API requests.")
}

Rel(Storefront_Module, API_Gateway, "Communicates via centralized Axios interceptor", "REST/HTTPS, JWT")
Rel(Admin_Portal_Module, API_Gateway, "Communicates via centralized Axios interceptor", "REST/HTTPS, JWT")
Rel(Auth___Consent_Manager, API_Gateway, "Authenticates and manages sessions", "OIDC/AWS Cognito")
@enduml