@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon DynamoDB container

System_Ext(CoreMicroservices, "Core Microservices", "External client microservices accessing the database layer.")
System_Ext(RecommendationEngine, "Recommendation Engine", "Consumes real-time activity events.")

Container_Boundary(AmazonDynamoDB, "Amazon DynamoDB") {
    Component(CartTable, "CartTable", "Amazon DynamoDB Table", "Shopping Cart Table managing user cart data with low-latency access.")
    Component(UserActivityTable, "UserActivityTable", "Amazon DynamoDB Table", "Session & History Table managing user sessions and browsing history.")
    Component(ActivityStream, "ActivityStream", "DynamoDB Streams", "Captures item-level changes in the DynamoDB tables for real-time event consumption.")
    Component(GlobalTablesReplicator, "Global Tables Replicator", "DynamoDB Global Tables", "Enables active-active multi-region replication across us-east-1, eu-west-1, and ap-southeast-1.")
    Component(DAX, "DAX", "DynamoDB Accelerator", "In-memory caching layer providing sub-millisecond read queries for user activity.")
}

Rel(CoreMicroservices, CartTable, "CRUD operations", "HTTPS/TLS 1.3")
Rel(CoreMicroservices, UserActivityTable, "CRUD operations", "HTTPS/TLS 1.3")
Rel(ActivityStream, CoreMicroservices, "Event consumption", "Amazon Kinesis Adapter / AWS Lambda")
Rel(ActivityStream, RecommendationEngine, "Event consumption", "Amazon Kinesis Adapter / AWS Lambda")
Rel(CartTable, GlobalTablesReplicator, "Active-active multi-region replication", "Proprietary Protocol")
Rel(UserActivityTable, GlobalTablesReplicator, "Active-active multi-region replication", "Proprietary Protocol")
Rel(CoreMicroservices, DAX, "In-memory read queries", "AWS DAX SDK (TLS 1.3)")

@enduml