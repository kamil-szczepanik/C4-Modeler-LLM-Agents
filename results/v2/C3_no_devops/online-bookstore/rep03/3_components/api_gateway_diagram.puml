@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(AWS_WAF, "AWS WAF", "AWS WAF", "Inspects traffic for OWASP Top-10 threats, SQL injection, and XSS protection at the edge.")
    Component(Authentication_Authorization_Component, "Authentication & Authorization Component", "AWS Lambda / IAM / JWT", "Validates JWTs and handles authentication and authorization for incoming requests.")
    Component(Rate_Limiting_Throttling_Component, "Rate Limiting & Throttling Component", "Amazon API Gateway Throttling", "Manages traffic rates and protects backend services from being overwhelmed.")
    Component(Geographic_Routing_Compliance_Component, "Geographic Routing & Compliance Component", "Amazon Route 53 / API Gateway Custom Authorizers", "Routes traffic across regional VPC Links ensuring compliance with GDPR and CCPA.")
    Component(Routing_Protocol_Translation_Component, "Routing & Protocol Translation Component", "Amazon API Gateway", "Routes traffic and handles protocol translation from HTTP/HTTPS to mTLS/gRPC.")
}

Rel(AWS_WAF, Authentication_Authorization_Component, "Inspects traffic for OWASP Top-10 threats [HTTPS]")
Rel(Authentication_Authorization_Component, Geographic_Routing_Compliance_Component, "Forwards authenticated requests with validated JWTs [Internal]")
Rel(Geographic_Routing_Compliance_Component, Routing_Protocol_Translation_Component, "Routes traffic across regional VPC Links [mTLS, gRPC]")

@enduml