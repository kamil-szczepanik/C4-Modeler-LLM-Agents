@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon Aurora PostgreSQL container

System_Ext(Core_Microservices, "Core Microservices", "External microservices making requests to the database.")
System_Ext(Amazon_CloudWatch, "Amazon CloudWatch", "Cloud monitoring and logging service.")
System_Ext(Amazon_S3, "Amazon S3", "Object storage for backups.")

Container_Boundary(amazon_aurora_postgresql, "Amazon Aurora PostgreSQL") {
    Component(Aurora_PostgreSQL_Cluster, "Aurora PostgreSQL Cluster", "Multi-AZ with Primary Writer and Read Replicas", "Serves as the primary relational database ensuring transactional integrity for shopping carts and secure checkouts, scaling up to 128TB across 3 AZs.")
    Component(Aurora_Global_Database, "Aurora Global Database", "Cross-region replication", "Provides scalable, highly available data storage across multiple global regions (us-east-1, eu-west-1, ap-southeast-1).")
    Component(PostgreSQL_Extension_Manager, "PostgreSQL Extension Manager", "pg_stat_statements, pgcrypto", "Manages database extensions for performance monitoring and cryptographic operations.")
    Component(IAM_Secrets_Manager_Integration, "IAM & Secrets Manager Integration", "AWS IAM & Secrets Manager", "Eliminates static credentials and secures database access.")
    Component(Private_Database_Subnets, "Private Database Subnets", "Isolated VPC deployment", "Enforces strict network isolation for GDPR and CCPA compliance.")
}

Rel(Core_Microservices, Aurora_PostgreSQL_Cluster, "Executes queries and transactions", "PostgreSQL wire protocol over TLS 1.3 via PgBouncer")
Rel(Core_Microservices, IAM_Secrets_Manager_Integration, "Authenticates and manages database credentials", "HTTPS/TLS 1.3")
Rel(Aurora_PostgreSQL_Cluster, Amazon_CloudWatch, "Streams audit logs for compliance monitoring", "AWS Internal API")
Rel(Aurora_PostgreSQL_Cluster, Amazon_S3, "Performs continuous backups and point-in-time recovery (PITR) with immutable storage", "AWS Internal API")

@enduml