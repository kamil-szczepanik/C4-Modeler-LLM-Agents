@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Microservices container

System_Boundary(core_microservices, "Core Microservices") {
    Component(Catalog_Search_Component, "Catalog & Search Component", "Spring Boot", "Handles product catalog and search functionalities for physical and electronic books.")
    Component(Checkout_Order_Component, "Checkout & Order Component", "Spring Boot", "Manages checkout processes, order placement, and cart states.")
    Component(Admin_Compliance_Component, "Admin & Compliance Component", "Python/FastAPI", "Handles back-office administration and ensures GDPR and CCPA compliance.")
    Component(Async_Notification_Service, "Async Notification Service", "Python/FastAPI", "Dispatches asynchronous notifications via Amazon SNS and Amazon SES.")
}

System_Ext(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Relational Database")
System_Ext(Amazon_DynamoDB, "Amazon DynamoDB", "NoSQL Database")
System_Ext(Amazon_EventBridge, "Amazon EventBridge", "Event Bus")
System_Ext(Payment_Gateway, "Payment Gateway", "External System")
System_Ext(Shipping_Provider_APIs, "Shipping Provider APIs", "External System")
System_Ext(Tax_Compliance_Service, "Tax & Compliance Service", "External System")
System_Ext(Recommendation_Engine, "Recommendation Engine", "External System")
System_Ext(Amazon_SNS, "Amazon SNS", "Notification Service")
System_Ext(Amazon_SES, "Amazon SES", "Email Service")

Rel(Checkout_Order_Component, Amazon_Aurora_PostgreSQL, "Reads/writes relational data", "JDBC/TLS")
Rel(Checkout_Order_Component, Amazon_DynamoDB, "Reads/writes cart states", "AWS SDK / TLS")
Rel(Catalog_Search_Component, Amazon_Aurora_PostgreSQL, "Reads relational data", "JDBC/TLS")
Rel(Catalog_Search_Component, Amazon_EventBridge, "Publishes/consumes domain events", "AWS SDK / TLS")
Rel(Checkout_Order_Component, Amazon_EventBridge, "Publishes/consumes domain events", "AWS SDK / TLS")
Rel(Admin_Compliance_Component, Amazon_EventBridge, "Publishes/consumes domain events", "AWS SDK / TLS")
Rel(Checkout_Order_Component, Payment_Gateway, "Processes transactions", "REST/TLS")
Rel(Checkout_Order_Component, Shipping_Provider_APIs, "Processes fulfillment", "REST/TLS")
Rel(Admin_Compliance_Component, Tax_Compliance_Service, "Processes compliance", "REST/TLS")
Rel(Catalog_Search_Component, Recommendation_Engine, "Processes recommendations", "REST/TLS")
Rel(Async_Notification_Service, Amazon_SNS, "Dispatches notifications", "AWS SDK/TLS")
Rel(Async_Notification_Service, Amazon_SES, "Dispatches notifications", "AWS SDK/TLS")

@enduml