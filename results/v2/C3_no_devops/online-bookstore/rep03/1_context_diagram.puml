@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "End-user who browses, purchases books, and interacts with reviews and recommendations via web or mobile apps.")
Person(Admin_Content_Manager, "Admin / Content Manager", "System administrator and content manager who manages the platform using secure authentication.")

System(Online_Bookstore, "Online Bookstore", "A scaled-down Amazon-style e-commerce platform for purchasing physical and electronic books with integrated reviews and recommendations, delivering high scalability, security, and multi-region availability on AWS.")

System_Ext(Payment_Gateway, "Payment Gateway", "External service like Stripe or PayPal for processing payments.")
System_Ext(Shipping_Provider_APIs, "Shipping Provider APIs", "External logistics services like FedEx or UPS for managing shipments.")
System_Ext(Tax_Compliance_Service, "Tax & Compliance Service", "External service like Avalara for handling tax and compliance.")
System_Ext(Recommendation_Engine, "Recommendation Engine", "AWS Personalize service providing book recommendations.")

Rel(Customer, Online_Bookstore, "Interacts via Web/Mobile App to browse and purchase books", "HTTPS / TLS 1.3")
Rel(Admin_Content_Manager, Online_Bookstore, "Manages the platform with secure session management", "HTTPS / TLS 1.3 with MFA and OAuth 2.0 / OIDC")
Rel(Online_Bookstore, Payment_Gateway, "Processes customer payments", "HTTPS/REST")
Rel(Online_Bookstore, Shipping_Provider_APIs, "Manages book shipping and delivery", "HTTPS/REST")
Rel(Online_Bookstore, Tax_Compliance_Service, "Calculates taxes and ensures compliance", "HTTPS/REST")
Rel(Online_Bookstore, Recommendation_Engine, "Retrieves book recommendations using pseudonymized IDs", "HTTPS/REST")

@enduml