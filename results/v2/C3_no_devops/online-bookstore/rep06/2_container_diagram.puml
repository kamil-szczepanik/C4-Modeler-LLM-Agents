@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "Book Buyer who browses, buys, reviews books, and authenticates.")
Person(Site_Administrator, "Site Administrator", "Content Moderator who manages the catalog and moderates platform content.")

System_Ext(Third_Party_Shipping_Partner, "Third-Party Shipping Partner", "External partner that handles physical order fulfillment and shipping.")
System_Ext(Payment_Gateway, "Payment Gateway", "Service used for processing financial transactions securely.")
System_Ext(Tax_Currency_Service, "Tax & Currency Service", "External service handling multi-currency conversion and tax calculations.")
System_Ext(Third_Party_Identity_Provider, "Third-Party Identity Provider", "OAuth 2.0 / OIDC provider used to streamline customer authentication.")
System_Ext(Notification_Service, "Notification Service", "Service that dispatches transactional emails and notifications.")

System_Boundary(Online_Bookstore, "Online Bookstore") {
    Container(Single_Page_App, "Single Page App", "React, TypeScript, AWS S3, AWS CloudFront", "Provides the responsive user interface for catalog browsing, secure checkout, reviews, and recommendations.")
    Container(API_Gateway, "API Gateway", "AWS API Gateway", "Routes incoming requests from the frontend to the backend microservices securely.")
    Container(Catalog_Search_Microservice, "Catalog & Search Microservice", "Spring Boot, Java, AWS ECS Fargate, AWS OpenSearch", "Handles book catalog management and sub-2-second keyword search.")
    Container(Order_Checkout_Microservice, "Order & Checkout Microservice", "Node.js, TypeScript, AWS ECS Fargate", "Processes customer orders, payments, and shipping integrations.")
    Container(Recommendation_Microservice, "Recommendation Microservice", "FastAPI, Python, AWS ECS Fargate", "Provides personalized book recommendations to customers.")
    Container(Content_Management_Moderation_Microservice, "Content Management & Moderation Microservice", "Node.js, TypeScript, AWS ECS Fargate", "Manages platform content and reviews moderation.")
    Container(Notification_Microservice, "Notification Microservice", "Node.js, TypeScript, AWS ECS Fargate", "Handles asynchronous notifications and messaging to users.")
    ContainerDb(Database, "Database", "AWS Aurora PostgreSQL, AWS DynamoDB, AWS KMS", "Primary persistent data stores with encryption at rest.")
}

Rel(Customer, Single_Page_App, "Browses, buys, reviews, and manages account", "HTTPS over TLS 1.3")
Rel(Site_Administrator, Single_Page_App, "Manages catalog and moderates content", "HTTPS over TLS 1.3")
Rel(Single_Page_App, API_Gateway, "Makes API requests", "HTTPS/JSON REST APIs")
Rel(API_Gateway, Catalog_Search_Microservice, "Routes search and catalog requests", "gRPC over mTLS via AWS App Mesh")
Rel(API_Gateway, Order_Checkout_Microservice, "Routes order and checkout requests", "gRPC over mTLS via AWS App Mesh")
Rel(API_Gateway, Recommendation_Microservice, "Routes recommendation requests", "gRPC over mTLS via AWS App Mesh")
Rel(API_Gateway, Content_Management_Moderation_Microservice, "Routes moderation requests", "gRPC over mTLS via AWS App Mesh")
Rel(API_Gateway, Notification_Microservice, "Routes notification requests", "gRPC over mTLS via AWS App Mesh")
Rel(Catalog_Search_Microservice, Database, "Reads and writes catalog data", "TCP with AWS KMS encryption at rest")
Rel(Order_Checkout_Microservice, Database, "Reads and writes order data", "TCP with AWS KMS encryption at rest")
Rel(Recommendation_Microservice, Database, "Reads recommendation data", "TCP with AWS KMS encryption at rest")
Rel(Content_Management_Moderation_Microservice, Database, "Reads and writes moderation data", "TCP with AWS KMS encryption at rest")
Rel(Order_Checkout_Microservice, Payment_Gateway, "Processes financial transactions", "HTTPS REST API")
Rel(Order_Checkout_Microservice, Third_Party_Shipping_Partner, "Sends fulfillment orders", "HTTPS API")
Rel(Notification_Microservice, Notification_Service, "Dispatches transactional emails", "HTTPS REST / AWS SQS")
Rel(Customer, Third_Party_Identity_Provider, "Authenticates identity", "OIDC / OAuth 2.0")

@enduml