@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "Book Buyer who browses, buys, reviews books, and authenticates via identity providers.")
Person(Site_Administrator, "Site Administrator", "Content Moderator who manages the catalog and moderates platform content.")

System(Online_Bookstore_System, "Online Bookstore System", "An Amazon-style global e-commerce platform for purchasing physical and electronic books, supporting multi-currency transactions, recommendations, and reviews.")

System_Ext(Third_Party_Shipping_Partner, "Third-Party Shipping Partner", "External partner that handles physical order fulfillment and shipping.")
System_Ext(Payment_Gateway, "Payment Gateway", "Stripe/PayPal service used for processing financial transactions securely.")
System_Ext(Tax_Currency_Service, "Tax & Currency Service", "External service handling multi-currency conversion and tax calculations.")
System_Ext(Third_Party_Identity_Provider, "Third-Party Identity Provider", "Google/Apple OAuth 2.0 / OIDC provider used to streamline customer authentication.")
System_Ext(Notification_Service, "Notification Service", "AWS SES / SendGrid service that dispatches transactional emails.")

Rel(Customer, Online_Bookstore_System, "Browses, buys, reviews", "HTTPS")
Rel(Site_Administrator, Online_Bookstore_System, "Manages catalog and moderates", "HTTPS")
Rel(Customer, Third_Party_Identity_Provider, "Authenticates", "OIDC / OAuth 2.0")
Rel(Online_Bookstore_System, Third_Party_Identity_Provider, "Validates tokens", "HTTPS")
Rel(Online_Bookstore_System, Payment_Gateway, "Processes transactions", "HTTPS / REST / TLS 1.3")
Rel(Online_Bookstore_System, Third_Party_Shipping_Partner, "Sends fulfillment orders", "HTTPS / REST")
Rel(Online_Bookstore_System, Notification_Service, "Dispatches transactional emails", "HTTPS / REST / AWS SQS")

@enduml