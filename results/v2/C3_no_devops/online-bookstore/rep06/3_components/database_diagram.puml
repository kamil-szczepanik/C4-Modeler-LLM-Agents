@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database container

Person(CatalogAndSearchMicroservice, "Catalog & Search Microservice", "External microservice")
Person(OrderAndCheckoutMicroservice, "Order & Checkout Microservice", "External microservice")
Person(RecommendationMicroservice, "Recommendation Microservice", "External microservice")
Person(ContentManagementAndModerationMicroservice, "Content Management & Moderation Microservice", "External microservice")

Container_Boundary(Database, "Database") {
    Component(AWSAuroraPostgreSQLPrimaryWriter, "AWS Aurora PostgreSQL Primary Writer", "AWS Aurora PostgreSQL Multi-AZ", "Handles relational transactional data for orders and content management with ACID compliance.")
    Component(AWSAuroraPostgreSQLReadReplicaCluster, "AWS Aurora PostgreSQL Read-Replica Cluster", "AWS Aurora PostgreSQL", "Serves read queries for catalog data and cart sessions.")
    Component(AWSDynamoDB, "AWS DynamoDB", "AWS DynamoDB", "Provides sub-10ms key-value storage supporting recommendations and cart sessions.")
    Component(AWSKMS, "AWS KMS", "AWS KMS", "Enforces encryption-at-rest, Column-Level Encryption, and cryptographic erasure.")
}

Rel(CatalogAndSearchMicroservice, AWSAuroraPostgreSQLReadReplicaCluster, "Reads catalog data", "PostgreSQL over TLS 1.3 with IAM Authentication")
Rel(OrderAndCheckoutMicroservice, AWSAuroraPostgreSQLPrimaryWriter, "Reads and writes order data", "PostgreSQL over TLS 1.3 with IAM Authentication")
Rel(RecommendationMicroservice, AWSDynamoDB, "Reads recommendations and cart data", "AWS SDK (HTTPS)")
Rel(RecommendationMicroservice, AWSAuroraPostgreSQLReadReplicaCluster, "Reads cart data", "PostgreSQL over TLS 1.3")
Rel(ContentManagementAndModerationMicroservice, AWSAuroraPostgreSQLPrimaryWriter, "Writes moderation data", "PostgreSQL over TLS 1.3 with IAM Authentication")
Rel(AWSAuroraPostgreSQLPrimaryWriter, AWSKMS, "Enforces encryption-at-rest and cryptographic erasure", "Internal AWS API")
Rel(AWSAuroraPostgreSQLReadReplicaCluster, AWSKMS, "Enforces encryption-at-rest and cryptographic erasure", "Internal AWS API")
Rel(AWSDynamoDB, AWSKMS, "Enforces encryption-at-rest and cryptographic erasure", "Internal AWS API")

@enduml