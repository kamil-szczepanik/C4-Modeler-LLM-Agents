@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification Microservice container

Container_Boundary(notification_microservice, "Notification Microservice") {
    Component(Event_Consumer_Message_Broker_Listener, "Event Consumer / Message Broker Listener", "Node.js, AWS SQS SDK", "Listens to message brokers and consumes asynchronous messaging events.")
    Component(Notification_Router_Template_Engine, "Notification Router & Template Engine", "Node.js, Handlebars", "Routes notifications and renders localized messages using templates.")
    Component(Channel_Adapters, "Channel Adapters", "Node.js, AWS SES, AWS SNS, FCM SDKs", "Dispatches notifications through external channels like SES, SNS, and FCM.")
    Component(Preference_Controller, "Preference Controller", "Express.js, TypeScript", "Manages user preferences and consent for GDPR/CCPA compliance.")
    Component(Notification_DB, "Notification DB", "AWS DynamoDB, AWS KMS", "Stores user consent and notification data securely with customer-managed keys.")
    Component(Campaign_Manager_Component, "Campaign Manager Component", "Express.js, TypeScript", "Handles admin broadcast requests and bulk payload batches.")
    Component(Webhook_Receiver_Component, "Webhook Receiver Component", "Express.js, TypeScript", "Receives engagement callbacks and webhooks from delivery services.")
}

System_Ext(AWS_SES_SNS_FCM, "AWS SES / SNS / FCM", "External notification and messaging delivery services.")

Rel(Event_Consumer_Message_Broker_Listener, Notification_Router_Template_Engine, "Dispatches messages", "Internal function call")
Rel(Campaign_Manager_Component, Notification_Router_Template_Engine, "Dispatches bulk payload batches", "Internal function call")
Rel(Preference_Controller, Notification_DB, "Reads and writes user consent", "TCP")
Rel(Channel_Adapters, AWS_SES_SNS_FCM, "Dispatches notifications", "HTTPS REST / AWS SQS")

@enduml