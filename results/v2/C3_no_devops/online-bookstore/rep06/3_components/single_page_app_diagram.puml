@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "Customer of the bookstore")
Person(SiteAdministrator, "Site Administrator", "Administrator of the bookstore")
System_Ext(API Gateway, "API Gateway", "AWS API Gateway", "Handles incoming requests from the SPA via HTTPS/JSON REST APIs.")

Container_Boundary(SinglePageApp_Boundary, "Single Page App") {
    Component(SinglePageApp, "Single Page App", "React, TypeScript, AWS S3, AWS CloudFront", "Provides a responsive user interface for catalog browsing, secure checkout, reviews, and recommendations.")
    Component(RoutingState, "Routing & State Manager", "React Router, Redux Toolkit / React Context", "Manages client-side navigation, global session state, and shopping cart persistence.")
    Component(CatalogSearch, "Catalog & Search UI Module", "React, TypeScript", "Displays catalog items and handles search functionality.")
    Component(CheckoutCart, "Checkout & Cart UI Module", "React, TypeScript, Payment Gateway SDK", "Handles user shopping cart and secure, tokenized checkout.")
    Component(RecommendationReview, "Recommendation & Review UI Module", "React, TypeScript", "Displays product recommendations and customer reviews.")
    Component(AnalyticsTelemetry, "Analytics & Telemetry Module", "React, TypeScript", "Collects and sanitizes telemetry and analytics data.")
    Component(ResilienceStorage, "Resilience & Storage Manager", "IndexedDB", "Provides local browser storage for offline cart persistence during degraded network conditions.")
}

Rel(Customer, SinglePageApp, "HTTPS over TLS 1.3")
Rel(SiteAdministrator, SinglePageApp, "HTTPS over TLS 1.3")
Rel(SinglePageApp, API Gateway, "HTTPS/JSON REST APIs")
Rel(RoutingState, SinglePageApp, "Internal runtime communication", "React props/context")
Rel(CatalogSearch, SinglePageApp, "Internal runtime communication", "React props/context")
Rel(CheckoutCart, SinglePageApp, "Internal runtime communication", "React props/context")
Rel(RecommendationReview, SinglePageApp, "Internal runtime communication", "React props/context")
Rel(AnalyticsTelemetry, SinglePageApp, "Internal runtime communication", "React props/context")
Rel(ResilienceStorage, SinglePageApp, "Internal runtime communication", "React props/context")

@enduml