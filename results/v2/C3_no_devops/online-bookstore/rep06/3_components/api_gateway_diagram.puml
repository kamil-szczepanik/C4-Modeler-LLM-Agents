@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Component(SinglePageApp, "Single Page App", "HTTPS/JSON REST APIs", "Client application sending secure traffic to the Edge Router.")
Component(ThirdPartyIdentityProvide, "Third-Party Identity Provider", "HTTPS", "Validates user tokens for the Authentication Authorizer.")
Component(BackendMicroservices, "Backend Microservices", "gRPC over mTLS", "Internal microservices receiving routed calls via App Mesh.")

Container_Boundary(api_gateway, "API Gateway") {
    Component(EdgeRouterSSLTermination, "Edge Router & SSL Termination", "AWS WAF & CloudFront", "Provides edge protection against OWASP Top-10 threats and global routing.")
    Component(AuthenticationAuthorizationAuth, "Authentication & Authorization Authorizer", "AWS Lambda Custom Authorizer", "Executes stateless custom authorization and token validation.")
    Component(RateLimitingThrottlingEngine, "Rate Limiting & Throttling Engine", "AWS API Gateway Usage Plans", "Throttles and limits incoming client requests.")
    Component(ServiceProxyProtocolTransla, "Service Proxy & Protocol Translator", "AWS API Gateway & AWS App Mesh", "Managed entry point for high scalability and routes internal calls with zero-trust mTLS.")
    Component(UsageAnalyticsLogging, "Usage & Analytics Logging", "AWS CloudWatch & Amazon Kinesis Data Firehose", "Asynchronously streams sanitized logs for analytics without impacting latency.")
}

Rel(SinglePageApp, EdgeRouterSSLTermination, "Sends secure client traffic", "HTTPS/JSON REST APIs")
Rel(AuthenticationAuthorizationAuth, ThirdPartyIdentityProvide, "Validates user tokens", "HTTPS")
Rel(ServiceProxyProtocolTransla, BackendMicroservices, "Routes internal calls with App Mesh", "gRPC over mTLS")
Rel(RateLimitingThrottlingEngine, UsageAnalyticsLogging, "Streams sanitized access telemetry", "CloudWatch Logs / Kinesis")

@enduml