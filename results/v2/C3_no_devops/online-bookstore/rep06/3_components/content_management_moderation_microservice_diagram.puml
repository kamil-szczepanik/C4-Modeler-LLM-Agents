@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Content Management & Moderation Microservice container

Container_Boundary(content_management_moderation_microservice, "Content Management & Moderation Microservice") {
    Component(Review_Rating_Controller, "Review & Rating Controller", "Node.js / TypeScript REST/gRPC", "Handles customer review submissions, updates, and GDPR erasure requests.")
    Component(Moderation_Workflow_Engine, "Moderation Workflow Engine", "Node.js / TypeScript", "Manages queue states and enforces RBAC/ABAC authorization for Site Administrators and Customers.")
    Component(Content_Sanitizer_Component, "Content Sanitizer Component", "DOMPurify", "Input validation layer mitigating XSS and injection vulnerabilities.")
    Component(Data_Access_Repository, "Data Access Repository", "AWS Aurora PostgreSQL with AWS KMS", "Interfaces with AWS Aurora PostgreSQL for secure multi-tenant storage.")
    Component(Notification_Dispatcher_Component, "Notification Dispatcher Component", "AWS EventBridge", "Asynchronous integration layer publishing moderation events.")
}

Component(API_Gateway, "API Gateway", "AWS App Mesh (mTLS / gRPC)", "External system routing moderation requests to controllers and engines.")
Component(Notification_Microservice, "Notification Microservice", "HTTPS / IAM", "External system receiving asynchronous moderation events.")

Rel(API_Gateway, Review_Rating_Controller, "Routes moderation requests via gRPC over mTLS.", "gRPC / mTLS")
Rel(API_Gateway, Moderation_Workflow_Engine, "Routes moderation requests via gRPC over mTLS.", "gRPC / mTLS")
Rel(Review_Rating_Controller, Data_Access_Repository, "Reads and writes data via secure TCP with AWS KMS encryption.", "Secure TCP")
Rel(Moderation_Workflow_Engine, Data_Access_Repository, "Reads and writes data via secure TCP with AWS KMS encryption.", "Secure TCP")
Rel(Notification_Dispatcher_Component, Notification_Microservice, "Publishes moderation events asynchronously via AWS EventBridge over HTTPS with IAM authentication.", "AWS EventBridge / HTTPS")

@enduml