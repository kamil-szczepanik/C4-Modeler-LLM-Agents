@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title System Context and Container Diagram for Clinic Management System

Person(Patients, "Patients", "Individuals receiving care who access the system via the Patient Portal to view records and manage appointments.")
Person(Clinical_Staff, "Clinical Staff", "Doctors, nurses, and medical professionals who use the system to manage patient admissions, clinical workflows, and EMRs.")
Person(Administrative_Staff, "Administrative Staff", "Personnel responsible for scheduling, billing, and clinic operations.")
Person(Compliance_Officers, "Compliance Officers", "Officers responsible for monitoring regulatory compliance and system audit logs.")

System_Ext(Lab_Imaging_Systems, "Lab & Imaging Systems", "External diagnostic systems that exchange clinical data using HL7 FHIR standards.")
System_Ext(Payment_Gateway_Insurance_Clearinghouse, "Payment Gateway & Insurance Clearinghouse", "External financial systems handling billing transactions and insurance processing.")
System_Ext(Regulatory_Auditing_System, "Regulatory & Auditing System", "External system for receiving audit logs and ensuring regulatory compliance.")

System_Boundary(Clinic_Management_System, "Clinic Management System") {
    Container(Edge_API_Gateway, "Edge API Gateway", "JWT (RS256/ES256), OAuth2, TLS 1.3", "Entry point handling edge-terminated authentication, token validation, and traffic routing.")
    Container(Patient_Portal, "Patient Portal", "HTTPS, Multi-Factor Authentication (MFA)", "Interface allowing patients to interact with the system.")
    Container(Clinic_Core_Services, "Clinic Core Services", "Kubernetes, Hybrid Cloud", "Core business logic handling admissions, scheduling, and overall clinic operations.")
    Container(EMR_Engine, "EMR Engine", "AES-256, WORM Storage", "Electronic Medical Records engine providing high-performance patient data storage and retrieval.")
    Container(Billing_Service, "Billing Service", "Secure API", "Service responsible for processing payments and financial transactions.")
}

Rel(Patients, Edge_API_Gateway, "Accesses patient portal and services via secure protocols", "HTTPS / TLS 1.3, Multi-Factor Authentication (MFA), JWT")
Rel(Clinical_Staff, Edge_API_Gateway, "Manages EMRs, admissions, and clinical workflows", "HTTPS / TLS 1.3, Multi-Factor Authentication (MFA), JWT")
Rel(Administrative_Staff, Edge_API_Gateway, "Handles administrative and billing tasks", "HTTPS / TLS 1.3, Multi-Factor Authentication (MFA), JWT")
Rel(Compliance_Officers, Edge_API_Gateway, "Monitors compliance and audit trails", "HTTPS / TLS 1.3, Multi-Factor Authentication (MFA), JWT")

Rel(Clinic_Management_System, Lab_Imaging_Systems, "Exchanges clinical interoperability data using standardized diagnostic protocols", "REST/JSON over HTTPS, HL7 FHIR, mTLS")
Rel(Clinic_Management_System, Payment_Gateway_Insurance_Clearinghouse, "Processes billing and insurance transactions securely", "Secure API / TLS 1.3")
Rel(Clinic_Management_System, Regulatory_Auditing_System, "Transmits immutable audit logs for regulatory compliance", "Encrypted SFTP / Signed HTTPS APIs")

@enduml