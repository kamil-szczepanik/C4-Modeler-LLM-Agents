@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Patients, "Patients", "Individuals receiving care who access the system via the Patient Portal.")
Person(Clinical_Staff, "Clinical Staff", "Doctors, nurses, and medical professionals managing patient admissions, clinical workflows, and EMRs.")
Person(Administrative_Staff, "Administrative Staff", "Personnel responsible for scheduling, billing, and clinic operations.")
Person(Compliance_Officers, "Compliance Officers", "Officers responsible for monitoring regulatory compliance and system audit logs.")

System_Ext(Lab___Imaging_Systems, "Lab & Imaging Systems", "External diagnostic systems that exchange clinical data.")
System_Ext(Payment_Gateway___Insurance_Clearinghouse, "Payment Gateway & Insurance Clearinghouse", "External financial systems handling billing transactions and insurance processing.")
System_Ext(Regulatory___Auditing_System, "Regulatory & Auditing System", "External system for receiving audit logs and ensuring regulatory compliance.")

System_Boundary(Clinic_Management_System, "Clinic Management System") {
    Container(API_Gateway___BFF, "API Gateway / BFF", "Kong / Envoy", "Handles ingress routing, TLS termination, MFA/JWT enforcement, and OAuth2/OIDC.")
    Container(Patient_Portal, "Patient Portal", "Node.js / TypeScript", "Self-service portal allowing patients to interact with the system via HTTPS/REST.")
    Container(EMR___Scheduling_Container, "EMR & Scheduling Container", "Java Spring Boot", "Handles core EMR business logic, resource clash checks, and audit trails.")
    Container(Billing___Claims_Container, "Billing & Claims Container", "Python / FastAPI", "Decouples billing and insurance claim submissions.")
    Container(Analytics___Reporting_Container, "Analytics & Reporting Container", "Apache Pinot / ClickHouse", "Optimizes 10-year retention and heavy reporting queries.")
    Container(Data___Messaging_Layer, "Data & Messaging Layer", "PostgreSQL, Redis, Apache Kafka, Debezium", "Provides relational storage (AES-256), distributed scheduling locks, event-driven messaging, and CDC.")
}

Rel(Patients, API_Gateway___BFF, "Accesses system via HTTPS/REST", "OAuth2/OIDC, mTLS, HTTPS/REST")
Rel(Clinical_Staff, API_Gateway___BFF, "Accesses system via HTTPS/REST", "OAuth2/OIDC, mTLS, HTTPS/REST")
Rel(Administrative_Staff, API_Gateway___BFF, "Accesses system via HTTPS/REST", "OAuth2/OIDC, mTLS, HTTPS/REST")
Rel(Compliance_Officers, API_Gateway___BFF, "Accesses system via HTTPS/REST", "OAuth2/OIDC, mTLS, HTTPS/REST")
Rel(Patient_Portal, API_Gateway___BFF, "Communicates with backend via API Gateway", "HTTPS/REST")
Rel(API_Gateway___BFF, Patient_Portal, "Routes traffic to Patient Portal", "HTTPS/REST")
Rel(API_Gateway___BFF, EMR___Scheduling_Container, "Routes requests to EMR services", "HTTPS/REST")
Rel(EMR___Scheduling_Container, Data___Messaging_Layer, "Connects to PostgreSQL and Redis", "gRPC/HTTPS, AES-256")
Rel(EMR___Scheduling_Container, Data___Messaging_Layer, "Communicates asynchronously via Apache Kafka events (Saga Pattern)", "Apache Kafka")
Rel(Billing___Claims_Container, Data___Messaging_Layer, "Communicates asynchronously via Apache Kafka events (Saga Pattern)", "Apache Kafka")
Rel(Analytics___Reporting_Container, Data___Messaging_Layer, "Communicates asynchronously via Apache Kafka events (Saga Pattern)", "Apache Kafka")
Rel(Analytics___Reporting_Container, Data___Messaging_Layer, "Ingests data from PostgreSQL via Debezium CDC", "Debezium CDC")
Rel(EMR___Scheduling_Container, Lab___Imaging_Systems, "Integrates with external systems via HL7 FHIR APIs", "HL7 FHIR APIs")
Rel(Billing___Claims_Container, Payment_Gateway___Insurance_Clearinghouse, "Submits billing and insurance claims", "HTTPS/REST")
Rel(EMR___Scheduling_Container, Regulatory___Auditing_System, "Sends audit logs for compliance", "HTTPS/REST")

@enduml