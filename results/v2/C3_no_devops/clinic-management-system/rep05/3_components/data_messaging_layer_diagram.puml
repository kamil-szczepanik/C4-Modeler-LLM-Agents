@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Data & Messaging Layer", "Data & Messaging Layer") {
    Component(PostgreSQL, "PostgreSQL", "PostgreSQL with TDE and Row-Level Security", "Provides relational storage with AES-256 TDE and Row-Level Security for strict compliance.")
    Component("Redis Cluster", "Redis Cluster", "Redis Cluster", "Manages transient sessions and resource clash locks using the Redlock algorithm.")
    Component("Apache Kafka", "Apache Kafka", "Apache Kafka", "Powers event-driven microservice choreography and Saga pattern rollbacks.")
    Component("Debezium Connect Workers", "Debezium Connect Workers", "Debezium", "Streams real-time database modifications from PostgreSQL WAL for analytics.")
    Component("Flyway/Liquibase", "Flyway/Liquibase", "Flyway / Liquibase", "Executes zero-downtime, backward-compatible database schema migrations.")
    Component("Kafka Schema Registry", "Kafka Schema Registry", "Kafka Schema Registry", "Enforces strict Avro/Protobuf schema evolution rules.")
}

Rel("Debezium Connect Workers", PostgreSQL, "Streams real-time database modifications from PostgreSQL WAL", "")
Rel("Apache Kafka", "Kafka Schema Registry", "Enforces strict Avro/Protobuf schema evolution rules", "")

@enduml