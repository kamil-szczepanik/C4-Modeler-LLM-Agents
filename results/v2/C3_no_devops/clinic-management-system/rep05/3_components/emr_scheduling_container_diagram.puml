@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the EMR & Scheduling Container container

Component(ApiGatewayBff, "API Gateway / BFF", "Kong / Envoy", "Routes requests to backend services.")
Component(PatientPortal, "Patient Portal", "Node.js / TypeScript", "Serves patient-facing interactions.")
Component(LabImagingSystems, "Lab & Imaging Systems", "External Systems", "External systems for labs and imaging integration.")

Container_Boundary(emr_scheduling_container, "EMR & Scheduling Container") {
    Component(EmrSchedulingContainer, "EMR & Scheduling Container", "Java Spring Boot", "Core runtime for EMR and scheduling ensuring high performance and robust business logic.")
    Component(PatientEmrManagementComponent, "Patient & EMR Management Component", "Spring Data JPA / Hibernate", "Manages patient and EMR data persistence and retrieval.")
    Component(SchedulingClashDetectionEngine, "Scheduling & Clash Detection Engine", "Java / Redis", "Handles scheduling and rapid resource clash detection.")
    Component(FhirInteroperabilityAdapter, "FHIR Interoperability Adapter", "HAPI FHIR / Spring WebClient", "Translates domain models to HL7 FHIR resources for interoperability.")
    Component(ClinicalWorkflowTelemetryComponent, "Clinical Workflow & Telemetry Component", "Micrometer / OpenTelemetry", "Captures performance traces and UX telemetry.")
    Component(DataMessagingLayer, "Data & Messaging Layer", "PostgreSQL, Redis, Apache Kafka, Debezium", "Provides data persistence, distributed locking, and messaging backbones.")
}

Rel(ApiGatewayBff, EmrSchedulingContainer, "Routes requests", "HTTPS/REST, mTLS")
Rel(SchedulingClashDetectionEngine, DataMessagingLayer, "Acquires distributed locks", "Redis Protocol / TLS")
Rel(PatientEmrManagementComponent, DataMessagingLayer, "Persists EMR records with audit logs", "JDBC / gRPC, AES-256")
Rel(EmrSchedulingContainer, LabImagingSystems, "Integrates for labs/imaging", "HL7 FHIR APIs")
Rel(ClinicalWorkflowTelemetryComponent, DataMessagingLayer, "Publishes sanitized telemetry", "Apache Kafka / TLS")

@enduml