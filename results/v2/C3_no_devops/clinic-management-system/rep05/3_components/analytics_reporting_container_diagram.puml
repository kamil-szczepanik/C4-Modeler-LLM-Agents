@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Analytics & Reporting Container

System_Ext(ApacheKafka, "Apache Kafka", "Streaming platform")
System_Ext(EmailGateway, "Email Gateway", "External email delivery service")
System_Ext(ApiGateway, "API Gateway", "API Gateway")

Container_Boundary(AnalyticsReportingContainer, "Analytics & Reporting Container") {
    Component(CDC_Ingestion_Worker, "CDC Ingestion Worker", "Python / Go", "High-throughput ingestion of Debezium CDC streams.")
    Component(Query_Aggregation_Service, "Query & Aggregation Service", "Node.js / Express or Java Spring Boot", "Executes analytical queries against columnar storage.")
    Component(Report_Generation_Engine, "Report Generation Engine", "Node.js", "Asynchronous processing for report generation and exporting.")
    Component(Reporting_API_BFF, "Reporting API / BFF", "Node.js", "Exposes endpoints for operational dashboards and compliance reports.")
    Component(Scheduler_Notification_Dispatcher, "Scheduler & Notification Dispatcher", "Node.js / BullMQ", "Robust queue management for time-zone-aware scheduled report dispatch and alerts.")
    ComponentDb(Analytics_Database, "Analytics Database", "ClickHouse / Apache Pinot", "Columnar store chosen for sub-second analytical queries and 10-year data retention.")
    Component(Object_Storage, "Object Storage", "S3-compatible", "Secure, ephemeral staging for generated CSV and PDF reports.")
}

Rel(CDC_Ingestion_Worker, ApacheKafka, "Consumes streaming data", "Kafka Protocol")
Rel(Query_Aggregation_Service, Analytics_Database, "Executes analytical queries", "Native TCP / HTTP")
Rel(Report_Generation_Engine, Object_Storage, "Persists temporary export payloads", "HTTPS / TLS")
Rel(Scheduler_Notification_Dispatcher, Report_Generation_Engine, "Triggers asynchronous generation", "BullMQ Redis")
Rel(Scheduler_Notification_Dispatcher, EmailGateway, "Dispatches alerts and notifications", "HTTPS / TLS")
Rel(Reporting_API_BFF, ApiGateway, "Exposes endpoints", "REST / gRPC")

@enduml