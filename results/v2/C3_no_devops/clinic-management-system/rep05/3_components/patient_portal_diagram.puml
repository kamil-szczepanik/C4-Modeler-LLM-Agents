@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient Portal container

Person(Patients, "Patients", "End-users accessing self-service features")
System_Ext(ApacheKafka, "Apache Kafka", "Event streaming platform")

Container_Boundary(PatientPortal, "Patient Portal") {
    Component(PatientPortalContainer, "Patient Portal Container", "Node.js / TypeScript", "Secure, self-service container enabling patients to manage appointments, view EMR, and settle bills.")
    Component(AuthenticationSessionComponent, "Authentication & Session Component", "Passport.js / Auth0 SDK", "Powers multi-factor authentication and OAuth2/OIDC session management.")
    Component(AppointmentSchedulingUIController, "Appointment & Scheduling UI/Controller", "Node.js / TypeScript", "Manages appointment and scheduling interactions for patients.")
    Component(PaymentOrchestrationComponent, "Payment Orchestration Component", "Stripe Elements / tokenized iFrames", "Isolates financial data handling via tokenized payment frames to minimize PCI-DSS scope.")
    Component(PatientDashboardEMRViewer, "Patient Dashboard & EMR Viewer", "Node.js / TypeScript", "Fetches and displays patient-scoped records.")
    Component(AuditLoggingInterceptor, "Audit Logging Interceptor", "Winston / Pino", "Captures structured audit logs for compliance tracking and emits events for PHI access attempts.")
    Component(APIGatewayBFF, "API Gateway / BFF", "Kong / Envoy", "Handles routing and API communication.")
}

Rel(Patients, PatientPortalContainer, "Accesses self-service features", "HTTPS/REST [TLS 1.3]")
Rel(PatientPortalContainer, APIGatewayBFF, "Communicates", "mTLS and HTTPS/REST with scoped OAuth2 access tokens")
Rel(AuthenticationSessionComponent, APIGatewayBFF, "Validates MFA status", "OpenID Connect (OIDC)")
Rel(PatientDashboardEMRViewer, APIGatewayBFF, "Fetches patient-scoped records", "HTTPS/REST with JWT propagation")
Rel(AuditLoggingInterceptor, ApacheKafka, "Emits audit events for PHI access attempts", "")

@enduml