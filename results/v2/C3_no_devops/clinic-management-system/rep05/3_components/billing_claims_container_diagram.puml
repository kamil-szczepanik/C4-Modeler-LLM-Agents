@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing & Claims Container container

System_Ext(PaymentGatewayInsuranceClearinghouse, "Payment Gateway & Insurance Clearinghouse", "External System")
System_Ext(DataMessagingLayer, "Data & Messaging Layer", "Apache Kafka, PostgreSQL")

Container_Boundary(BillingClaimsContainer, "Billing & Claims Container") {
    Component(ClaimProcessingEngine, "Claim Processing Engine", "Python / FastAPI", "Manages claim processing and internal updates via FastAPI/gRPC with mTLS.")
    Component(ClearinghouseIntegrationAdapter, "Clearinghouse Integration Adapter", "Python / httpx + WebSockets", "Handles integration with external payment gateways and insurance clearinghouses.")
    Component(AppealsRejectionWorkflowHandler, "Appeals & Rejection Workflow Handler", "Python / Celery", "Asynchronous task queue for automated rejection workflows and appeals.")
    Component(BillingLedgerService, "Billing & Ledger Service", "Python / FastAPI", "Handles billing services, APIs, and ledger updates.")
}

Rel(ClaimProcessingEngine, BillingLedgerService, "Internal updates", "FastAPI/gRPC with mTLS")
Rel(ClaimProcessingEngine, DataMessagingLayer, "Publishes ClaimStatusUpdated", "Apache Kafka")
Rel(ClearinghouseIntegrationAdapter, PaymentGatewayInsuranceClearinghouse, "Submits claims and ingests webhooks", "HTTPS/REST & HTTPS/Webhooks")
Rel(BillingLedgerService, DataMessagingLayer, "Publishes PatientBalanceCalculated", "Apache Kafka")

@enduml