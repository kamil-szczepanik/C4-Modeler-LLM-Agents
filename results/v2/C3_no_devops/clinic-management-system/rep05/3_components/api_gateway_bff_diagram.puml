@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway / BFF container

Container_Boundary(api_gateway_bff, "API Gateway / BFF") {
    Component(edge_router, "Edge Router & TLS Terminator", "Kong / Envoy", "Handles edge routing, TLS termination, and low-latency in-memory execution.")
    Component(auth_filter, "Auth & Policy Enforcement Filter", "Lua / Wasm", "Enforces strict HIPAA/GDPR compliance and policy enforcement at the edge.")
    Component(bff_routers, "Persona-Specific BFF Routers", "Node.js / TypeScript", "Provides persona-specific routing for patients, clinical staff, administrative staff, and compliance officers.")
}

Rel(edge_router, auth_filter, "In-Memory Plugin Call", "Lua/Wasm")
Rel(auth_filter, bff_routers, "Internal Request Headers")

@enduml