@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Interoperability & Analytics Gateway Container container

Container_Boundary("Interoperability & Analytics Gateway Container", "Interoperability & Analytics Gateway Container") {
    Component("FHIR API Facade Component", "FHIR API Facade Component", "HAPI FHIR JPA Server / Java", "Provides robust HL7 FHIR resource management and RESTful capabilities.")
    Component("HL7 v2 to FHIR Adapter Component", "HL7 v2 to FHIR Adapter Component", "Apache Camel", "Facilitates reliable translation of legacy HL7 v2 messaging formats to modern FHIR bundles.")
    Component("Audit & Compliance Interceptor Component", "Audit & Compliance Interceptor Component", "Custom Spring Boot Middleware", "Intercepts and persists immutable audit logs ensuring compliance.")
    Component("Break-Glass Authorization Component", "Break-Glass Authorization Component", "Open Policy Agent / Java", "Enables declarative evaluation of clinical break-glass emergency policies.")
}

System_Ext("Core Clinical & Billing Services", "Core Clinical & Billing Services", "Go / Java / Spring Boot, PostgreSQL, Kafka / RabbitMQ")

Rel("FHIR API Facade Component", "Break-Glass Authorization Component", "Validates emergency access override", "gRPC")
Rel("Break-Glass Authorization Component", "Audit & Compliance Interceptor Component", "Dispatches high-priority security alerts", "Kafka")
Rel("Audit & Compliance Interceptor Component", "Core Clinical & Billing Services", "Persists immutable audit logs", "Kafka")

@enduml