@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

System_Ext(IdentityProvider, "Identity Provider", "Validates authentication tokens.")
System_Ext(RedisCache, "Redis Cache", "Fast in-memory state store for rate limiting.")
System_Ext(CoreClinicalBillingServices, "Core Clinical & Billing Services", "Backend clinical and billing services.")
System_Ext(Kafka, "Kafka", "Asynchronous messaging backbone.")

Container_Boundary(api_gateway, "API Gateway") {
    Component(RoutingAndLoadBalancingRouter, "Routing & Load Balancing Router", "Kong / Envoy", "Routes incoming API requests and provides load balancing across backend services.")
    Component(AuthenticationAndAuthorizationFilter, "Authentication & Authorization Filter", "Kong / Envoy Plugin", "Validates tokens against the Identity Provider and enforces access control.")
    Component(RateLimitingAndThrottlingEngine, "Rate Limiting & Throttling Engine", "Kong / Envoy with Redis", "Checks quotas and throttles traffic using a fast in-memory state store.")
    Component(AuditAndTelemetryInterceptor, "Audit & Telemetry Interceptor", "Kong / Envoy Interceptor", "Intercepts requests for auditing and telemetry collection to ensure compliance.")
    Component(TelemetryAndMeteringPublisher, "Telemetry & Metering Publisher", "Kafka / RabbitMQ Publisher", "Publishes usage events and telemetry asynchronously.")
}

Rel(AuthenticationAndAuthorizationFilter, IdentityProvider, "Validates tokens", "HTTPS")
Rel(RateLimitingAndThrottlingEngine, RedisCache, "Checks quotas", "RESP / TCP")
Rel(RoutingAndLoadBalancingRouter, CoreClinicalBillingServices, "Routes traffic", "mTLS via Istio")
Rel(TelemetryAndMeteringPublisher, Kafka, "Publishes usage events", "Async / AMQP")

@enduml