@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient Portal (SPA) container

Container_Boundary(patient_portal, "Patient Portal (SPA)") {
    Component(patient_ui_router, "Patient UI Router", "React / TypeScript", "Manages client-side routing and view transitions for patient admissions, records, and billing.")
    Component(auth_manager, "Authentication & Session Manager", "React / TypeScript, httpOnly Cookies", "Handles user authentication state and secure token management via httpOnly cookies.")
    Component(api_client, "API Communication Client", "Fetch / WebSockets", "Communicates with the BFF Proxy Layer and API Gateway via HTTPS and WebSockets.")
}

System_Ext(bff_gateway, "BFF Proxy Layer / API Gateway", "External API Gateway and BFF layer")

Rel(patient_ui_router, auth_manager, "Verifies session state before rendering protected views")
Rel(patient_ui_router, api_client, "Triggers API requests for admissions, records, and billing")
Rel(api_client, bff_gateway, "Sends HTTPS API requests and WebSocket connections", "HTTPS / WebSockets")

@enduml