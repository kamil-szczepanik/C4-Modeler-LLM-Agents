@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Clinical & Billing Services container

System_Ext(Payment_Gateway_Insurance_Clearinghouse, "Payment Gateway / Insurance Clearinghouse", "External payment gateways and insurance systems.")
System_Ext(Kafka, "Kafka", "Event backbone for asynchronous microservice communication.")
System_Ext(S3_compatible_object_storage, "S3-compatible object storage", "Cold-tiering historical records using AWS KMS and WORM Object Lock.")

Container_Boundary(Core_Clinical_Billing_Services, "Core Clinical & Billing Services") {
    Component(Patient_Registry_Component, "Patient Registry Component", "Go / Java / Spring Boot", "Manages patient admissions and demographic records.")
    Component(Scheduling_Resource_Component, "Scheduling & Resource Component", "Go / Java / Spring Boot", "Handles appointments, resource clash checks using Redis, and scheduling workflows.")
    Component(EMR_Management_Component, "EMR Management Component", "Go / Java / Spring Boot", "Manages electronic medical records, cold-tiering via S3-compatible object storage with AWS KMS and WORM Object Lock.")
    Component(Billing_Claims_Component, "Billing & Claims Component", "Go / Java / Spring Boot", "Processes medical billing and integrates synchronously with external payment gateways and insurance clearinghouses.")
}

Rel(Billing_Claims_Component, Payment_Gateway_Insurance_Clearinghouse, "Integrates synchronously for pre-validation", "HTTPS/REST")
Rel(EMR_Management_Component, Kafka, "Publishes and consumes domain events", "JWE/envelope encryption")
Rel(Scheduling_Resource_Component, Kafka, "Publishes and consumes domain events", "JWE/envelope encryption")
Rel(EMR_Management_Component, S3_compatible_object_storage, "Cold-tiers historical records", "AWS KMS encryption and WORM Object Lock")

@enduml