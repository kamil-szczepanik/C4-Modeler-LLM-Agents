@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(staff_dashboard_spa, "Staff Dashboard (SPA)") {
    Component(Auth_RBAC_Module, "Auth & RBAC Module", "JavaScript / TypeScript", "Handles JWT evaluation and role-based views.")
    Component(EMR_View_Engine, "EMR View Engine", "JavaScript / TypeScript", "Implements local caching and virtualized rendering for medical records.")
    Component(Scheduling_Intake_Controller, "Scheduling & Intake Controller", "JavaScript / TypeScript", "Manages appointment grids and patient registration.")
    Component(Local_Session_State_Manager, "Local Session State Manager", "Volatile In-Memory RAM", "Volatile in-memory storage for unsaved form drafts.")
    Component(WebSocket_Reconnection_Manager, "WebSocket Reconnection Manager", "WebSockets (WSS)", "Handles network drops and state re-sync.")
    Component(API_Client_Layer, "API Client Layer", "HTTPS / TLS", "Communicates securely with backend systems.")
}

Rel(Scheduling_Intake_Controller, Local_Session_State_Manager, "Preserves ephemeral drafts", "In-Memory RAM")

@enduml