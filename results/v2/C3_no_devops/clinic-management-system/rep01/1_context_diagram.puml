@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Clinic Management System

Person(Patients_Consumers, "Patients / Consumers", "Individuals receiving care who interact with the system for admissions, appointments, and billing.")
Person(Clinic_Staff_Receptionists, "Clinic Staff / Receptionists", "Administrative staff managing patient admissions and scheduling appointments.")
Person(Healthcare_Providers_Doctors_Nurses, "Healthcare Providers (Doctors/Nurses)", "Medical professionals managing electronic medical records and clinical workflows.")
Person(Billing_Specialists, "Billing Specialists", "Financial staff handling patient billing, payments, and insurance claims.")
Person(System_Administrators_Compliance_Officers, "System Administrators / Compliance Officers", "Personnel overseeing system health, user access, and regulatory compliance.")

System(Clinic_Management_System, "Clinic Management System", "A hybrid-cloud healthcare platform designed to manage patient admissions, electronic medical records, appointment scheduling, and billing for medium-sized hospitals and clinics.")

System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "Manages secure enterprise authentication and multi-factor authentication.")
System_Ext(Lab_Imaging_Systems, "Lab & Imaging Systems", "External diagnostic and imaging services providing clinical data.")
System_Ext(Payment_Gateway_Insurance_Clearinghouse, "Payment Gateway / Insurance Clearinghouse", "External services processing payments and insurance claims.")
System_Ext(Public_Health_Authority_Regulatory_Registry, "Public Health Authority / Regulatory Registry", "External regulatory bodies receiving encrypted batch exports.")

Rel(Patients_Consumers, Clinic_Management_System, "Accesses patient portal and services", "HTTPS")
Rel(Clinic_Staff_Receptionists, Clinic_Management_System, "Manages admissions and scheduling", "HTTPS")
Rel(Healthcare_Providers_Doctors_Nurses, Clinic_Management_System, "Views and updates electronic medical records", "HTTPS")
Rel(Billing_Specialists, Clinic_Management_System, "Manages billing and financial workflows", "HTTPS")
Rel(System_Administrators_Compliance_Officers, Clinic_Management_System, "Configures and monitors system operations", "HTTPS")

Rel(Clinic_Management_System, Identity_Provider_IdP, "Authenticates users", "OIDC/SAML")
Rel(Clinic_Management_System, Lab_Imaging_Systems, "Exchanges clinical and diagnostic data", "HL7 FHIR over HTTPS")
Rel(Clinic_Management_System, Payment_Gateway_Insurance_Clearinghouse, "Processes payments and insurance claims", "HTTPS")
Rel(Clinic_Management_System, Public_Health_Authority_Regulatory_Registry, "Sends encrypted batch exports", "SFTP/HTTPS")

@enduml