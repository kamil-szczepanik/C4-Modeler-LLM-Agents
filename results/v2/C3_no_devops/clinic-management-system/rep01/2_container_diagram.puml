@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Patients, "Patients", "Individuals receiving care who interact with the patient portal.")
Person(Clinic_Staff_Receptionists, "Clinic Staff/Receptionists", "Administrative staff managing patient admissions and scheduling.")
Person(Healthcare_Providers, "Healthcare Providers", "Medical professionals managing electronic medical records.")
Person(Billing_Specialists, "Billing Specialists", "Financial staff handling patient billing and payments.")
Person(System_Administrators, "System Administrators", "Personnel overseeing system health and compliance.")

System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "Manages secure authentication via OAuth 2.0 / OIDC.")
System_Ext(Lab_Imaging_Systems, "Lab & Imaging Systems", "External diagnostic and imaging services.")
System_Ext(Payment_Gateway, "Payment Gateway", "External services processing payments.")
System_Ext(Regulatory_Registry, "Regulatory Registry", "External regulatory bodies receiving compliance data.")

System_Boundary(Clinic_Management_System, "Clinic Management System") {
    Container(Patient_Portal_SPA, "Patient Portal (SPA)", "Nginx, Single Page Application", "Frontend application allowing patients to access their portal.")
    Container(Staff_Dashboard_SPA, "Staff Dashboard (SPA)", "Nginx, Single Page Application", "Frontend dashboard for clinic staff and healthcare providers.")
    Container(API_Gateway, "API Gateway", "Kong / Envoy", "Routes incoming client traffic to internal containers securely.")
    Container(Core_Clinical_Billing_Services, "Core Clinical & Billing Services", "Go / Java / Spring Boot, PostgreSQL, Kafka / RabbitMQ", "Manages core clinical records, scheduling, and billing workflows.")
    Container(Interoperability_Analytics_Gateway_Container, "Interoperability & Analytics Gateway Container", "HAPI FHIR JPA Server, HL7 FHIR", "Facilitates data exchange with external systems and regulatory entities.")
}

Rel(Patients, Patient_Portal_SPA, "Interacts with portal for admissions, records, and billing", "HTTPS / WebSockets")
Rel(Clinic_Staff_Receptionists, Staff_Dashboard_SPA, "Manages schedules and patient admissions", "HTTPS / WebSockets")
Rel(Healthcare_Providers, Staff_Dashboard_SPA, "Views and updates electronic medical records", "HTTPS / WebSockets")
Rel(Billing_Specialists, Staff_Dashboard_SPA, "Manages billing operations", "HTTPS / WebSockets")
Rel(System_Administrators, Staff_Dashboard_SPA, "Monitors system and compliance", "HTTPS / WebSockets")

Rel(Patient_Portal_SPA, API_Gateway, "Sends API requests", "HTTPS")
Rel(Staff_Dashboard_SPA, API_Gateway, "Sends API requests", "HTTPS")

Rel(API_Gateway, Core_Clinical_Billing_Services, "Routes traffic via service mesh", "mTLS / Istio")
Rel(API_Gateway, Interoperability_Analytics_Gateway_Container, "Routes interoperability traffic via service mesh", "mTLS / Istio")

Rel(Interoperability_Analytics_Gateway_Container, Lab_Imaging_Systems, "Exchanges clinical data", "HL7 FHIR over HTTPS")
Rel(Core_Clinical_Billing_Services, Identity_Provider_IdP, "Authenticates users", "OAuth 2.0 / OIDC")
Rel(Core_Clinical_Billing_Services, Payment_Gateway, "Processes payments", "HTTPS")
Rel(Interoperability_Analytics_Gateway_Container, Regulatory_Registry, "Sends regulatory data", "HTTPS")

@enduml