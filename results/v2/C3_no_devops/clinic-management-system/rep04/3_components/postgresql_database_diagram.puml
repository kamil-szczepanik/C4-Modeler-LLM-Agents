@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL Database container

System_Ext(Core_EMR_Services, "Core/EMR Services", "External core and EMR services")
System_Ext(Billing_Specialist_Reporting, "Billing Specialist/Reporting", "External billing and reporting users/systems")
System_Ext(Audit_Compliance_Container, "Audit & Compliance Container", "External audit and compliance container")

Container_Boundary(postgresql_database, "PostgreSQL Database") {
    Component(StorageEngine, "PostgreSQL 16 Relational Storage Engine", "PostgreSQL 16", "Relational storage engine providing ACID compliance for core transactional workloads.")
    Component(HAController, "Patroni & Etcd Replication & HA Controller", "Patroni + Etcd", "High availability and synchronous streaming replication across hybrid environments.")
    Component(ConnectionPooler, "PgBouncer Connection Pooler", "PgBouncer", "Connection pooling to handle high concurrency and stabilize P95 latencies.")
    Component(PartitionManager, "pg_partman Partition Manager", "pg_partman", "Time-based automated partitioning for audit trails and EMR records.")
    Component(EncryptionModule, "pgcrypto Encryption Module", "pgcrypto", "AES-256 encryption at rest to meet security constraints.")
    Component(AuditLogging, "pgaudit Audit Logging", "pgaudit & Row-Level Security (RLS)", "Advanced auditing and granular data access controls for HIPAA/GDPR compliance.")
    Component(ReadReplicas, "Read-Only Reporting Replicas & Router", "PostgreSQL Replica", "Read-only reporting replicas and router for billing specialists and reporting workloads.")
}

Rel(Core_EMR_Services, ConnectionPooler, "SQL over TCP [TLS 1.3, mTLS]")
Rel(ConnectionPooler, StorageEngine, "Local Unix Domain Socket / TCP [Encrypted]")
Rel(Billing_Specialist_Reporting, ReadReplicas, "SQL over TCP [TLS 1.3]")
Rel(StorageEngine, Audit_Compliance_Container, "Audit Logs [Encrypted Stream]")

@enduml