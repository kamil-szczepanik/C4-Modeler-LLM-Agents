@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit & Compliance Container container

System_Ext(ObjectStorageCold, "Object Storage (Cold)", "MinIO / S3 with WORM compliance mode")

Container_Boundary(AuditComplianceContainer, "Audit & Compliance Container") {
    Component(AuditIngestionComponent, "Audit Ingestion Component", "Go / Spring Boot", "Persists streaming logs from Apache Kafka into the compliance storage.")
    Component(ComplianceStorageIndexingComponent, "Compliance Storage & Indexing Component", "ClickHouse Database", "Stores and indexes audit logs for high-throughput, searchable queries.")
    Component(AuditQueryReportingAPIComponent, "Audit Query & Reporting API Component", "Go / Node.js", "Executes analytical queries against compliance storage for reporting.")
    Component(RetentionArchivalManagerComponent, "Retention & Archival Manager Component", "Go", "Manages partition rotation and archives aged logs with SHA-256 hashes to cold object storage.")
}

Rel(AuditIngestionComponent, ComplianceStorageIndexingComponent, "Persists streaming logs", "ClickHouse Native Protocol, mTLS")
Rel(AuditQueryReportingAPIComponent, ComplianceStorageIndexingComponent, "Executes analytical queries", "SQL, mTLS")
Rel(RetentionArchivalManagerComponent, ComplianceStorageIndexingComponent, "Manages partition rotation", "SQL/Admin API")
Rel(RetentionArchivalManagerComponent, ObjectStorageCold, "Archives aged logs with SHA-256 hashes", "HTTPS/S3 API, AES-256")
@enduml