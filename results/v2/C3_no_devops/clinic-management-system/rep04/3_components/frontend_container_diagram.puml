@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Frontend Container container

Container_Boundary(frontend_container, "Frontend Container") {
    Component(routing_shell, "Routing & Shell Component", "React, TypeScript, Vite", "Manages application layout, navigation, and dynamically lazy-loads feature modules.")
    Component(auth_manager, "Authentication & Session Manager", "React, OIDC/OAuth2, Web Crypto API", "Handles user authentication, sessions, multi-factor authentication, and integrates with external IdP.")
    Component(feature_modules, "Clinical & Administrative Feature Modules", "React, TypeScript", "Provides specific workflows and UI for patients, clinic staff, clinicians, billing specialists, and system administrators.")
    Component(api_client, "API Client Service", "Axios/Fetch, TypeScript", "Sends API requests to the backend API Gateway and receives responses over HTTPS/WSS.")
    Component(local_persistence, "Local Persistence & Sync Service", "IndexedDB via Dexie.js, Web Crypto API", "Manages offline encrypted drafts and local data persistence securely.")
}

Rel(routing_shell, feature_modules, "Dynamically lazy-loads modules")
Rel(feature_modules, api_client, "Communicates with backend via API", "HTTPS/WSS")
Rel(feature_modules, local_persistence, "Manages offline encrypted drafts")
Rel(auth_manager, api_client, "Provides authentication tokens for requests")

@enduml