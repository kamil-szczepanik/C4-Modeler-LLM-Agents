@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification Container container

System_Ext(api_gateway, "API Gateway", "External system")
System_Ext(apache_kafka, "Apache Kafka", "External system")
System_Ext(postgresql_database, "PostgreSQL Database", "External system")
System_Ext(external_providers, "External Providers", "External system")
System_Ext(audit_compliance_container, "Audit & Compliance Container", "External system")

Container_Boundary(notification_container, "Notification Container") {
    Component(notification_router_component, "Notification Router Component", "Go", "Consumes inbound notification events from Apache Kafka.")
    Component(channel_dispatcher_components, "Channel Dispatcher Components", "Go, Twilio API, SMTP, Firebase/APNS", "Dispatches alerts to external SMS, email, and push providers.")
    Component(preference_consent_manager_component, "Preference & Consent Manager Component", "Go", "Manages user notification preferences and consent records.")
}

Rel(api_gateway, preference_consent_manager_component, "Routes user preference updates", "gRPC/HTTPS")
Rel(notification_router_component, apache_kafka, "Consumes inbound notification events", "Kafka protocol, TLS + SASL")
Rel(preference_consent_manager_component, postgresql_database, "Queries consent records", "SQL/TLS")
Rel(channel_dispatcher_components, external_providers, "Dispatches alerts", "HTTPS/SMTP, TLS 1.3")
Rel(notification_container, audit_compliance_container, "Streams audit events", "Kafka, TLS + SASL")

@enduml