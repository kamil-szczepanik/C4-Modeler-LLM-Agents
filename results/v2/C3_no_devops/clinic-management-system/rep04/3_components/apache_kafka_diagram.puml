@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Component(Core_Services_EMR_Service___Integration_Service, "Core Services, EMR Service, & Integration Service", "Producer/Consumer Microservices", "Produce and consume clinical, billing, and audit events.")
System_Ext(ClickHouse___Object_Storage, "ClickHouse / Object Storage", "External Storage")

Container_Boundary(Apache_Kafka, "Apache Kafka") {
    Component(KRaft_Controller_Quorum, "KRaft Controller Quorum", "Java / ZooKeeper-less metadata management", "Manages cluster metadata and consensus.")
    Component(Kafka_Brokers, "Kafka Brokers", "Java / Netty", "Handles client connections, partition log replication, and disk I/O.")
    Component(Kafka_Connect, "Kafka Connect", "Java Framework", "Offloads historical data to long-term storage.")
    Component(Kafka_Streams_Engine, "Kafka Streams Engine", "Java Kafka Streams API", "Handles stateful routing, retries, and dead-letter queues.")
}

Rel(Core_Services_EMR_Service___Integration_Service, Kafka_Brokers, "Produce and consume events", "TCP, TLS 1.3, SASL/SCRAM-SHA-512")
Rel(Kafka_Connect, ClickHouse___Object_Storage, "Exports historical audit and clinical event topics", "HTTP/JDBC")
Rel(KRaft_Controller_Quorum, Kafka_Brokers, "Manages cluster metadata and consensus", "")
@enduml