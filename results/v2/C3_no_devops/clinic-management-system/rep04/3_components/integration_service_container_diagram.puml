@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Service Container container

System_Ext(Lab_and_Imaging_Systems, "Lab & Imaging Systems", "External clinical systems")
System_Ext(Insurance_Clearinghouses, "Insurance Clearinghouses", "External insurance clearinghouse systems")
System_Ext(Audit_and_Compliance_Container, "Audit & Compliance Container", "Audit and compliance monitoring system")
System_Ext(System_Monitoring, "System Monitoring", "System telemetry and monitoring")

Container_Boundary(Integration_Service_Container, "Integration Service Container") {
    Component(FHIR_Gateway_Component, "FHIR Gateway Component", "HAPI FHIR library", "Handles HL7 FHIR API requests and standardization for healthcare interoperability.")
    Component(Adapter_and_Transformation_Engine, "Adapter & Transformation Engine", "Apache Camel / Go middleware", "Transforms and adapts data formats between internal models and external standards.")
    Component(Outbox_and_Retry_Dispatcher, "Outbox & Retry Dispatcher", "PostgreSQL outbox", "Ensures guaranteed delivery and manages message retries using a local outbox pattern.")
    Component(Clearinghouse_Adapter_Component, "Clearinghouse Adapter Component", "Go / Spring Boot", "Submits claims and adjudications to insurance clearinghouses using X12 EDI over mTLS.")
    Component(Integration_Metrics_Exporter, "Integration Metrics Exporter", "Prometheus / Micrometer", "Exports failure telemetry and metrics for system monitoring.")
}

Rel(FHIR_Gateway_Component, Lab_and_Imaging_Systems, "Exchanges clinical data", "REST/HTTPS, HL7 FHIR over mTLS")
Rel(Clearinghouse_Adapter_Component, Insurance_Clearinghouses, "Submits claims and adjudications", "REST/HTTPS over mTLS, X12 EDI")
Rel(Adapter_and_Transformation_Engine, Audit_and_Compliance_Container, "Streams audit events", "Kafka, TLS + SASL")
Rel(Integration_Metrics_Exporter, System_Monitoring, "Scrapes failure telemetry", "Prometheus, HTTP")

@enduml