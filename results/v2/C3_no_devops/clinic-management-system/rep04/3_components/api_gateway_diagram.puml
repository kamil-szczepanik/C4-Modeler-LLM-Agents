@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Routing___Protocol_Translation_Engine, "Routing & Protocol Translation Engine", "Kong / Envoy", "Handles API requests via HTTPS/WSS, edge routing, and protocol translation.")
    Component(Authentication___Authorization_Filter, "Authentication & Authorization Filter", "OAuth2/OIDC + Open Policy Agent", "Performs token validation and authorization checks via internal in-memory hook.")
    Component(Rate_Limiting_Module, "Rate Limiting Module", "Redis-backed Token Bucket", "Queries and enforces rate quotas via Redis RESP.")
    Component(Audit___Tracing_Interceptor, "Audit & Tracing Interceptor", "Envoy OpenTelemetry Plugin", "Streams logs and traces via Apache Kafka (TLS + SASL).")
}

Rel(Routing___Protocol_Translation_Engine, Authentication___Authorization_Filter, "Delegates token validation via [Internal In-Memory Hook]")
Rel(Authentication___Authorization_Filter, Rate_Limiting_Module, "Queries rate quotas via [Redis RESP]")
Rel(Audit___Tracing_Interceptor, Routing___Protocol_Translation_Engine, "Monitors and intercepts traffic for telemetry and auditing")
@enduml