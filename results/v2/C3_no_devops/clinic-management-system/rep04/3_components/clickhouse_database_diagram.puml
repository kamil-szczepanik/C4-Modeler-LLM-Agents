@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Ext(core_services, "Core Services Container", "Microservices", "Interacts with the database for application data access.")
Container_Ext(audit_compliance, "Audit & Compliance Container", "Security & Auditing", "Queries audit logs and compliance metrics.")
System_Ext(kafka, "Apache Kafka", "Message Broker", "Streams real-time data for operational analytics and auditing.")

Container_Boundary(clickhouse_db, "ClickHouse Database") {
    Component(Storage_Engine_MergeTree_Family, "Storage Engine (MergeTree Family)", "ReplacingMergeTree and ReplicatedMergeTree on NVMe storage", "Manages data storage and replication across nodes ensuring high availability and a 10-year data retention policy.")
    Component(Security_Encryption_Module, "Security & Encryption Module", "AES-256, Column-level masking, RLS, OIDC RBAC", "Enforces security policies, data encryption, row-level security, and role-based access control to satisfy HIPAA and GDPR.")
    Component(Ingestion_Materialization_Worker, "Ingestion & Materialization Worker", "Apache Kafka Stream Consumer", "Consumes streams from Apache Kafka for real-time operational analytics and auditing.")
    Component(Distributed_Query_Processor, "Distributed Query Processor", "Vectorized query engine", "Executes analytical queries for sub-second responses.")
    Component(Materialized_View_Aggregation_Engine, "Materialized View & Aggregation Engine", "ClickHouse Aggregation Engine", "Pre-aggregates patient throughput and billing metrics.")
}

Rel(core_services, Storage_Engine_MergeTree_Family, "Interacts", "HTTPS (Port 8443) using mTLS")
Rel(audit_compliance, Security_Encryption_Module, "Interacts", "ClickHouse Native Protocol / HTTPS (Port 9000/8443) using mTLS")
Rel(kafka, Ingestion_Materialization_Worker, "Streams data", "ClickHouse Native Protocol")

@enduml