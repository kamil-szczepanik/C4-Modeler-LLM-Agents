@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Services Container container

Container_Boundary(core_services_container, "Core Services Container") {
    Component(PatientManagementModule, "PatientManagementModule", "Spring Boot Java", "Captures patient demographics.")
    Component(SchedulingModule, "SchedulingModule", "Spring Boot Java", "Handles appointment scheduling and resource clash checks.")
    Component(BillingModule, "BillingModule", "Spring Boot Java", "Manages billing and insurance claim submission.")
    Component(Redis_Cache, "Redis Cache", "Redis", "In-memory cache for scheduling locks.")
    Component(PostgreSQL_Database, "PostgreSQL Database", "PostgreSQL", "Persistent state storage.")
}

Component(API_Gateway, "API Gateway", "Gateway", "Routes requests to the Core Services Container.")
Component(Integration_Service_Container, "Integration Service Container", "External System Integration", "Handles external system integrations.")
Component(Apache_Kafka, "Apache Kafka", "Kafka", "Streams audit events.")

Rel(API_Gateway, core_services_container, "Routes requests", "gRPC/REST over Istio mTLS")
Rel(core_services_container, Integration_Service_Container, "Copay & eligibility verification", "gRPC over Istio mTLS")
Rel(core_services_container, PostgreSQL_Database, "Reads and writes core data", "JDBC over TLS with HikariCP")
Rel(SchedulingModule, Redis_Cache, "Fast resource clash validation", "Redis Protocol over TLS with AUTH")
Rel(core_services_container, Apache_Kafka, "Streams audit events", "Kafka Producer API, TLS + SASL")

@enduml