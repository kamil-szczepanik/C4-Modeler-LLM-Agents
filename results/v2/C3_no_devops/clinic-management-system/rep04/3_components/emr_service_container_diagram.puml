@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("EMR_Service_Container", "EMR Service Container") {
    Component("EMR Management Component", "EMR Management Component", "Go", "Manages clinical data and business logic for electronic medical records.")
    Component("Access Control Enforcer Component", "Access Control Enforcer Component", "Go", "Enforces strict HIPAA/GDPR compliance and access control rules.")
    Component("Timeline Aggregator Component", "Timeline Aggregator Component", "Go", "Aggregates and retrieves patient history and timelines.")
}

System_Ext("PostgreSQL Database", "PostgreSQL Database", "Relational Database")
System_Ext("Encrypted Redis Cache", "Encrypted Redis Cache", "In-Memory Cache")

Rel("EMR Management Component", "PostgreSQL Database", "Persists clinical data", "Encrypted AES-256 connection")
Rel("Timeline Aggregator Component", "PostgreSQL Database", "Retrieves aggregated patient history", "Encrypted connection")
Rel("Timeline Aggregator Component", "Encrypted Redis Cache", "Retrieves cached patient history", "Encrypted connection")

@enduml