@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Patient, "Patient", "End user who interacts with the system for appointments and records.")
Person(Staff, "Clinic Staff/Receptionist", "User responsible for front-desk operations, patient admissions, and scheduling.")
Person(Clinician, "Clinician/Doctor", "Medical professional who accesses and updates electronic medical records.")
Person(Billing, "Billing Specialist", "User who manages medical billing and financial transactions.")
Person(Admin, "System Administrator", "Personnel responsible for managing and maintaining the system infrastructure.")

System_Ext(LabSystem, "Lab & Imaging Systems", "External diagnostic and imaging systems integration.")
System_Ext(Insurance, "Insurance Clearinghouses", "External network for insurance claims processing.")
System_Ext(IdP, "Identity Provider (IdP)", "External authentication and authorization service providing MFA.")
System_Ext(Payment, "Payment Gateway", "External financial service for secure payment processing.")

System_Boundary(cms_system, "Clinic Management System") {
    Container(Frontend, "Frontend Container", "React, TypeScript, CDN, Nginx", "Single Page Application served via CDN/Nginx for responsive user interfaces.")
    Container(Gateway, "API Gateway", "Kong / Envoy, Istio Service Mesh", "Handles incoming traffic, routing, and Istio mTLS enforcement.")
    Container(CoreServices, "Core Services Container", "Go, Spring Boot, Node.js", "Manages core business logic for patient admissions, scheduling, and billing.")
    Container(EMRService, "EMR Service Container", "Go, Spring Boot, Node.js", "Manages electronic medical records securely.")
    Container(IntegrationService, "Integration Service Container", "Go, Spring Boot, Node.js, HL7 FHIR APIs", "Integrates with external lab & imaging systems and clearinghouses.")
    Container(Notification, "Notification Container", "Go, Spring Boot, Node.js", "Handles system notifications and alerts.")
    Container(AuditCompliance, "Audit & Compliance Container", "Go, Spring Boot, Node.js, Kafka (TLS + SASL)", "Collects audit logs from all containers for compliance tracking.")
    
    ContainerDb(PostgreSQL, "PostgreSQL Database", "PostgreSQL, AES-256", "Relational database for persistent storage with encryption.")
    ContainerDb(ClickHouse, "ClickHouse Database", "ClickHouse", "Analytical database for fast querying and reporting.")
    ContainerDb(Kafka, "Apache Kafka", "Apache Kafka, RabbitMQ", "Asynchronous event streaming broker for decoupled architecture.")
}

Rel(Patient, Frontend, "Interacts with user interface", "HTTPS/WSS")
Rel(Staff, Frontend, "Manages patient admissions and scheduling", "HTTPS/WSS")
Rel(Clinician, Frontend, "Accesses clinical workflows and medical records", "HTTPS/WSS")
Rel(Billing, Frontend, "Manages billing and financial workflows", "HTTPS/WSS")
Rel(Admin, Frontend, "Monitors and configures platform", "HTTPS/WSS")

Rel(Frontend, Gateway, "Sends API requests", "HTTPS/WSS")
Rel(Gateway, CoreServices, "Routes requests", "gRPC/REST over Istio mTLS")
Rel(Gateway, EMRService, "Routes requests", "gRPC/REST over Istio mTLS")

Rel(IntegrationService, LabSystem, "Exchanges clinical data", "HL7 FHIR APIs")

Rel(CoreServices, AuditCompliance, "Streams audit events", "Kafka, TLS + SASL")
Rel(EMRService, AuditCompliance, "Streams audit events", "Kafka, TLS + SASL")
Rel(IntegrationService, AuditCompliance, "Streams audit events", "Kafka, TLS + SASL")
Rel(Notification, AuditCompliance, "Streams audit events", "Kafka, TLS + SASL")

Rel(CoreServices, PostgreSQL, "Reads and writes core data", "Encrypted connection (AES-256)")
Rel(EMRService, PostgreSQL, "Reads and writes EMR data", "Encrypted connection (AES-256)")

@enduml