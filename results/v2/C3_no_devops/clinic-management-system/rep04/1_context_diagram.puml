@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patient, "Patient", "End user who interacts with the system for appointments and records.")
Person(ClinicStaffReceptionist, "Clinic Staff/Receptionist", "User responsible for front-desk operations, patient admissions, and scheduling.")
Person(ClinicianDoctor, "Clinician/Doctor", "Medical professional who accesses and updates electronic medical records.")
Person(BillingSpecialist, "Billing Specialist", "User who manages medical billing and financial transactions.")
Person(SystemAdministrator, "System Administrator", "Personnel responsible for managing and maintaining the system infrastructure.")

System(ClinicManagementSystem, "Clinic Management System", "A hybrid cloud platform designed for medium-sized hospitals and clinics to manage patient admissions, electronic medical records, appointment scheduling, and medical billing with high availability and strict compliance.")

System_Ext(LabImagingSystems, "Lab & Imaging Systems", "External diagnostic and imaging systems integration.")
System_Ext(InsuranceClearinghouses, "Insurance Clearinghouses", "External network for insurance claims processing.")
System_Ext(IdentityProvideIdP, "Identity Provider (IdP)", "External authentication and authorization service providing MFA.")
System_Ext(PaymentGateway, "Payment Gateway", "External financial service for secure payment processing.")

Rel(Patient, ClinicManagementSystem, "Interacts via secure web & mobile client gateway", "HTTPS / TLS 1.3")
Rel(ClinicStaffReceptionist, ClinicManagementSystem, "Manages admissions and scheduling via secure gateway", "HTTPS / TLS 1.3")
Rel(ClinicianDoctor, ClinicManagementSystem, "Accesses medical records and clinical workflows", "HTTPS / TLS 1.3")
Rel(BillingSpecialist, ClinicManagementSystem, "Handles billing and financial records", "HTTPS / TLS 1.3")
Rel(SystemAdministrator, ClinicManagementSystem, "Monitors and configures platform infrastructure", "HTTPS / TLS 1.3")

Rel(ClinicManagementSystem, LabImagingSystems, "Exchanges clinical data and lab results", "HL7 FHIR over HTTPS (REST/JSON)")
Rel(ClinicManagementSystem, InsuranceClearinghouses, "Submits claims and billing information", "X12 EDI over HTTPS")
Rel(ClinicManagementSystem, IdentityProvideIdP, "Authenticates users and enforces multi-factor authentication", "OAuth2 / OIDC with MFA")
Rel(ClinicManagementSystem, PaymentGateway, "Processes payments securely with tokenization", "HTTPS (REST/JSON) with tokenization and HMAC")

@enduml