@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "Individuals receiving care who interact with the system via web or mobile clients.")
Person(Clinicians, "Clinicians", "Medical professionals who manage patient care and electronic medical records.")
Person(AdministrativeStaff, "Administrative Staff", "Staff members handling scheduling and clinic workflows.")
Person(BillingOfficers, "Billing Officers", "Personnel managing patient billing and financial transactions.")
Person(RegulatoryAuditors, "Regulatory Auditors", "Auditors reviewing compliance and system logs.")

System_Ext(EnterpriseIdentityProvider, "Enterprise Identity Provider", "Provides identity federation and authentication services.")
System_Ext(ExternalLabandImagingSystems, "External Lab and Imaging Systems", "External medical systems providing lab results and imaging data.")
System_Ext(PaymentGatewayandInsuranceClearinghouse, "Payment Gateway and Insurance Clearinghouse", "External systems processing payments and insurance claims.")
System_Ext(AuditArchive, "Audit Archive", "Storage with WORM controls for immutable data retention.")

System_Boundary(ClinicManagementSystem, "Clinic Management System") {
    Container(APIGateway, "API Gateway", "Kong / Nginx", "Centralized routing and mTLS/OAuth2 enforcement.")
    Container(FrontendContainer, "Frontend Container", "Next.js / Node.js", "Patient Portal BFF.")
    Container(ClinicalCoreContainer, "Clinical Core Container", "Node.js / Java Spring Boot", "Handles core clinical workflows and electronic medical records.")
    Container(SchedulingandResourceEngine, "Scheduling & Resource Engine", "Python / Go with Redis", "Real-time resource locking and clash checks.")
    Container(InteroperabilityService, "Interoperability Service", "Apache Camel / HAPI FHIR", "HL7 FHIR standard compliance and interoperability.")
    Container(BillingandClaimsWorker, "Billing & Claims Worker", ".NET Core with RabbitMQ", "Asynchronous billing and insurance claims processing.")
    Container(AnalyticsandReportingContainer, "Analytics & Reporting Container", "Apache Superset / Metabase, ClickHouse, PostgreSQL Replica", "Analytics backed by ClickHouse and Read-Only PostgreSQL Replica via Debezium CDC.")
}

Rel(Patients, APIGateway, "Interacts with platform via web/mobile clients", "HTTPS / REST, OAuth2/OIDC with MFA")
Rel(Clinicians, APIGateway, "Interacts with platform via web/mobile clients", "HTTPS / REST, OAuth2/OIDC with MFA")
Rel(AdministrativeStaff, APIGateway, "Interacts with platform via web/mobile clients", "HTTPS / REST, OAuth2/OIDC with MFA")
Rel(BillingOfficers, APIGateway, "Interacts with platform via web/mobile clients", "HTTPS / REST, OAuth2/OIDC with MFA")
Rel(RegulatoryAuditors, APIGateway, "Reviews compliance and system logs", "HTTPS / REST, OAuth2/OIDC with MFA")
Rel(FrontendContainer, APIGateway, "Routes requests through API gateway", "HTTPS / REST")
Rel(APIGateway, ClinicalCoreContainer, "Routes clinical requests", "mTLS / gRPC / REST")
Rel(APIGateway, SchedulingandResourceEngine, "Routes scheduling requests", "mTLS / gRPC / REST")
Rel(APIGateway, InteroperabilityService, "Routes interoperability requests", "mTLS / gRPC / REST")
Rel(ClinicalCoreContainer, AuditArchive, "Streams cryptographically signed audit logs", "Secure TCP")
Rel(BillingandClaimsWorker, PaymentGatewayandInsuranceClearinghouse, "Submits claims and processes payments", "HTTPS / REST with strict egress filtering")

@enduml