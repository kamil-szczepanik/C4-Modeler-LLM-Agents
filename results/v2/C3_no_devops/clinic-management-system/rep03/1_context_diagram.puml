@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "Individuals receiving care who interact with the system via web or mobile clients.")
Person(Clinicians, "Clinicians", "Medical professionals who manage patient care and electronic medical records.")
Person(Administrative_Staff, "Administrative Staff", "Staff members handling scheduling and clinic workflows.")
Person(Billing_Officers, "Billing Officers", "Personnel managing patient billing and financial transactions.")
Person(Regulatory_Auditors, "Regulatory Auditors", "Auditors reviewing compliance and system logs.")

System(Clinic_Management_System, "Clinic Management System", "A hybrid cloud platform that manages patient admissions, electronic medical records, scheduling, and billing for medium-sized clinics, ensuring HIPAA and GDPR compliance and 99.99% availability.")

System_Ext(Enterprise_Identity_Provider, "Enterprise Identity Provider", "Provides identity federation and authentication services.")
System_Ext(External_Lab_and_Imaging_Systems, "External Lab and Imaging Systems", "External medical systems providing lab results and imaging data.")
System_Ext(Payment_Gateway_and_Insurance_Clearinghouse, "Payment Gateway and Insurance Clearinghouse", "External systems processing payments and insurance claims.")
System_Ext(Audit_Archive, "Audit Archive", "AWS S3 Glacier storage with WORM controls for immutable 10-year data retention.")

Rel(Patients, Clinic_Management_System, "Interacts with the platform via Web/Mobile clients", "HTTPS")
Rel(Clinicians, Clinic_Management_System, "Interacts with the platform via Web/Mobile clients", "HTTPS")
Rel(Administrative_Staff, Clinic_Management_System, "Interacts with the platform via Web/Mobile clients", "HTTPS")
Rel(Billing_Officers, Clinic_Management_System, "Interacts with the platform via Web/Mobile clients", "HTTPS")
Rel(Regulatory_Auditors, Clinic_Management_System, "Interacts with the platform and reviews audit logs", "HTTPS")
Rel(Clinic_Management_System, Enterprise_Identity_Provider, "Authenticates users", "OIDC/SAML over HTTPS")
Rel(Clinic_Management_System, External_Lab_and_Imaging_Systems, "Integrates for lab and imaging data exchange", "HL7 FHIR APIs over mTLS/HTTPS")
Rel(Clinic_Management_System, Payment_Gateway_and_Insurance_Clearinghouse, "Submits claims and processes payments", "REST APIs over TLS 1.3")
Rel(Clinic_Management_System, Audit_Archive, "Streams logs for immutable data retention", "Encrypted TLS 1.3")
@enduml