@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing & Claims Worker container

Container_Boundary(billing_claims_worker, "Billing & Claims Worker") {
    Component(Claim Submission Queue Listener, "Claim Submission Queue Listener", ".NET Core / RabbitMQ Client", "Consumes pending claim payloads from RabbitMQ.")
    Component(Clearinghouse Integration Adapter, "Clearinghouse Integration Adapter", ".NET Core / HttpClient with Polly", "Submits claims and processes payments to external payment gateways and insurance clearinghouses.")
    Component(Reconciliation & State Manager, "Reconciliation & State Manager", ".NET Core / Entity Framework Core", "Parses clearinghouse responses and manages local claim states securely.")
    Component(Remediation Mapping Engine, "Remediation Mapping Engine", ".NET Core / Localized lookup cache", "Maps and handles error remediation using a localized lookup cache.")
    Component(Alert Dispatcher, "Alert Dispatcher", ".NET Core / SignalR & RabbitMQ Publisher", "Pushes enriched rejection alerts to the frontend.")
}

Component(RabbitMQ, "RabbitMQ", "RabbitMQ", "Message broker ensuring reliable, decoupled claim queueing.")
Component(Payment Gateway and Insurance Clearinghouse, "Payment Gateway and Insurance Clearinghouse", "External Service", "External clearinghouse and payment processing service.")
Component(API Gateway, "API Gateway", "API Gateway", "Gateway routing traffic to the frontend.")
Component(Audit Archive, "Audit Archive", "Secure Storage", "Secure archive for signed audit logs.")

Rel(Claim Submission Queue Listener, RabbitMQ, "Consumes pending claim payloads", "AMQP with mTLS")
Rel(Clearinghouse Integration Adapter, Payment Gateway and Insurance Clearinghouse, "Submits claims and processes payments", "HTTPS / REST with mTLS and strict egress filtering")
Rel(Reconciliation & State Manager, Remediation Mapping Engine, "Parses clearinghouse responses", "Direct C# Method Invocation")
Rel(Alert Dispatcher, API Gateway, "Pushes enriched rejection alerts to Frontend", "WSS / SignalR with JWT validation")
Rel(Reconciliation & State Manager, Audit Archive, "Emits signed audit logs", "Secure API / TLS")

@enduml