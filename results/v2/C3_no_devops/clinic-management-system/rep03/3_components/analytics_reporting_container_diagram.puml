@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Analytics & Reporting Container container

Container_Boundary(analytics_reporting_container, "Analytics & Reporting Container") {
    Component(dashboard_visualization_ui, "Dashboard & Visualization UI", "Apache Superset", "Provides dashboard and visualization interface for analytical insights.")
    Component(query_semantic_layer, "Query & Semantic Layer", "Superset SQL Lab", "Handles query and semantic layer processing for reports.")
    Component(analytical_data_store, "Analytical Data Store", "ClickHouse", "Stores sub-second time-series analytical data.")
    Component(cdc_ingestion_worker, "CDC Ingestion Worker", "Debezium + Kafka Connect", "Streams asynchronous transactional data from primary PostgreSQL.")
    Component(report_export_service, "Report Export Service", "Report Export Service", "Exports reports and streams immutable audit logs over TLS to audit archive.")
    Component(notification_scheduling_worker, "Notification & Scheduling Worker", "Celery / Node.js", "Manages notification and report scheduling workflows.")
}

Rel(dashboard_visualization_ui, query_semantic_layer, "Queries data via", "")
Rel(query_semantic_layer, analytical_data_store, "Retrieves analytical data from", "")
Rel(cdc_ingestion_worker, analytical_data_store, "Streams transactional data into", "")
Rel(report_export_service, dashboard_visualization_ui, "Exports generated reports from", "")

@enduml