@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(scheduling_resource_engine, "Scheduling & Resource Engine") {
    Component(api_controller, "API Controller", "Go", "Routes scheduling requests and handles entry point logic.")
    Component(resource_locking_coordinator, "Resource Locking Coordinator", "Go/Redis", "Coordinates atomic locking and state persistence for resource clash prevention.")
    Component(clinical_workflow_engine, "Clinical Workflow Engine", "Python", "Executes clinical workflows and rule evaluations.")
    Component(alternative_slot_recommender, "Alternative Slot Recommender", "Python", "Performs complex heuristic graph searches for alternative slot recommendations.")
    Component(telemetry_analytics_emitter, "Telemetry & Analytics Emitter", "Go", "Captures and publishes sanitized usage and slot metrics.")
}

Rel(api_controller, resource_locking_coordinator, "Internal communication", "gRPC")
Rel(alternative_slot_recommender, telemetry_analytics_emitter, "Captures slot metrics", "Asynchronous channels")
@enduml