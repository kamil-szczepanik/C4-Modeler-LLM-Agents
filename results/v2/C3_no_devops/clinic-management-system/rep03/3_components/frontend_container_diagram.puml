@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(frontend_container, "Frontend Container") {
    Component(bff_routing_middleware, "BFF Routing & Middleware", "Next.js / Node.js", "Powers the Frontend BFF for server-side rendering, routing, and sub-second EMR loads.")
    Component(ui_view_orchestration, "UI View Orchestration", "React / Tailwind, WCAG 2.1 AA", "Delivers role-tailored UI views with WCAG 2.1 AA accessibility.")
    Component(api_client_caching, "API Client & Caching", "TanStack Query / Redis", "Handles data fetching, state management, and SSR caching for high performance.")
    Component(session_emergency_override_manager, "Session & Emergency Override Manager", "Node.js", "Manages secure sessions, HTTP-only cookies, and emergency override capabilities for clinical staff.")
}

Rel(ui_view_orchestration, bff_routing_middleware, "Sends UI rendering requests and route navigation", "")
Rel(bff_routing_middleware, api_client_caching, "Fetches and caches clinical data via TanStack Query and Redis", "")
Rel(session_emergency_override_manager, bff_routing_middleware, "Validates session security, CSP headers, and access control", "")

@enduml