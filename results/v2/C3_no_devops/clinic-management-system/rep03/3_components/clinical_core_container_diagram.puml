@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Clinical Core Container container

Container_Boundary(clinical_core_container, "Clinical Core Container") {
    Component(PatientRegistryComponent, "Patient Registry Component", "Java Spring Boot", "Manages patient demographic data and executes similarity queries using pg_trgm.")
    Component(EMRManagementComponent, "EMR Management Component", "Java Spring Boot", "Manages electronic medical records and executes transactional reads/writes.")
    Component(ClinicalPersistenceFacade, "Clinical Persistence Facade", "Java Spring Boot", "Provides persistence access and facade patterns for the clinical core.")
    Component(CDSIntegrationComponent, "CDS Integration Component", "Java Spring Boot with Spring WebFlux & Resilience4j", "Handles asynchronous clinical decision support integrations and event hooks.")
    Component(SearchIndexingSubcomponent, "Search & Indexing Sub-component", "Java Spring Boot", "Supports search and indexing operations across clinical records.")
}

System_Ext(PostgreSQL, "PostgreSQL", "Relational database storing clinical records and patient data.")
System_Ext(AuditArchive, "Audit Archive", "External archive for compliance and audit logs.")

Rel(EMRManagementComponent, PostgreSQL, "Executes transactional reads/writes", "JDBC over SSL with HikariCP")
Rel(EMRManagementComponent, CDSIntegrationComponent, "Dispatches async event hooks", "In-process Spring Events")
Rel(PatientRegistryComponent, PostgreSQL, "Executes similarity queries using pg_trgm", "JDBC over SSL")
Rel(clinical_core_container, AuditArchive, "Streams cryptographically signed audit logs", "Secure TCP")

@enduml