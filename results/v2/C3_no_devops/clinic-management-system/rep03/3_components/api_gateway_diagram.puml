@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(Edge_Router___Reverse_Proxy, "Edge Router / Reverse Proxy", "Kong / Nginx", "Centralized API Gateway routing, WAF, and reverse proxy for high availability and load management.")
    Component(Authentication___Token_Relay_Plugin, "Authentication & Token Relay Plugin", "OAuth2/OIDC", "Handles authentication and token relay for incoming requests.")
    Component(Rate_Limiting___Throttling_Engine, "Rate Limiting & Throttling Engine", "Redis", "Distributed token bucket backing for persona-based rate limiting and throttling.")
    Component(Audit_Logging___Tracing_Interceptor, "Audit Logging & Tracing Interceptor", "Syslog / HTTPS", "Exports security and compliance logs to Audit Archive.")
    Component(Metrics_Exporter_Component, "Metrics Exporter Component", "Prometheus", "Asynchronous scraping of gateway operational metrics and error rates.")
}

System_Ext(Clinical_Core_Container, "Clinical Core Container", "Node.js / Java Spring Boot")
System_Ext(Scheduling___Resource_Engine, "Scheduling & Resource Engine", "Python / Go with Redis")
System_Ext(Interoperability_Service, "Interoperability Service", "Apache Camel / HAPI FHIR")
System_Ext(Audit_Archive, "Audit Archive", "External System")
System_Ext(Analytics___Reporting_Container, "Analytics & Reporting Container", "ClickHouse, PostgreSQL Replica")

Rel(Edge_Router___Reverse_Proxy, Authentication___Token_Relay_Plugin, "Passes authenticated requests", "HTTPS / REST, OAuth2/OIDC with MFA")
Rel(Authentication___Token_Relay_Plugin, Rate_Limiting___Throttling_Engine, "Checks rate limits", "TCP / RESP")
Rel(Edge_Router___Reverse_Proxy, Clinical_Core_Container, "Routes requests", "mTLS / gRPC / REST")
Rel(Edge_Router___Reverse_Proxy, Scheduling___Resource_Engine, "Routes requests", "mTLS / gRPC / REST")
Rel(Edge_Router___Reverse_Proxy, Interoperability_Service, "Routes requests", "mTLS / gRPC / REST")
Rel(Audit_Logging___Tracing_Interceptor, Audit_Archive, "Exports security and compliance logs", "HTTPS / Syslog")
Rel(Metrics_Exporter_Component, Analytics___Reporting_Container, "Scrapes operational metrics", "HTTP / Prometheus")

@enduml