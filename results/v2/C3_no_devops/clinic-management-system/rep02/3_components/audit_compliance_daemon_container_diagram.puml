@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit & Compliance Daemon Container container

Container_Boundary("Audit & Compliance Daemon Container", "Audit & Compliance Daemon Container") {
    Component(Audit Stream Consumer, "Audit Stream Consumer", "Go (Sarama Go Kafka client)", "Consumes raw access and modification events from Apache Kafka.")
    Component(Hash-Chain Ledger Engine, "Hash-Chain Ledger Engine", "Go (Merkle tree / SHA-256)", "Maintains tamper-evident cryptographic hash-chained audit logs.")
    Component(Compliance Query & Report API, "Compliance Query & Report API", "Go (gRPC/REST with mTLS, RBAC, JWT, and Nonce protection)", "Provides compliance and audit query capabilities with robust security controls.")
    Component(Cold Storage Sync Worker, "Cold Storage Sync Worker", "Go", "Synchronizes cryptographically chained audit logs to cold storage.")
    Component(Compliance Report Generator, "Compliance Report Generator", "Go", "Generates compliance reports with GDPR data minimization and break-glass justification logging.")
}

Rel(Audit Stream Consumer, Hash-Chain Ledger Engine, "Feeds raw events for cryptographic ledger processing [Internal]", "In-memory")
Rel(Hash-Chain Ledger Engine, Cold Storage Sync Worker, "Provides hashed logs for persistence [Internal]", "In-memory")
Rel(Compliance Report Generator, Compliance Query & Report API, "Supplies generated reports for querying [Internal]", "In-memory")

@enduml