@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Redis_Cluster", "Redis Cluster") {
    Component(Primary_Master_Nodes, "Primary Master Nodes", "In-memory Redis", "Handles caching scheduling states, locks, and distributed slot allocation for low-latency scheduling.")
    Component(Replica___Failover_Nodes, "Replica / Failover Nodes", "In-memory Redis", "Provides data replication and cluster heartbeat for high availability.")
    Component(TLS_Termination_Module, "TLS Termination Module", "Redis TLS Module", "Ensures secure transport and strict HIPAA/GDPR compliance via TLS v1.3 with mTLS.")
    Component(Policy___Eviction_Manager, "Policy & Eviction Manager", "Redis Policy Engine", "Manages memory limits, data eviction policies, and cluster caching lifecycles.")
}

Rel(Primary_Master_Nodes, Replica___Failover_Nodes, "Data replication and cluster heartbeat", "Redis Cluster Bus protocol over TLS")
Rel(Replica___Failover_Nodes, Primary_Master_Nodes, "Data replication and cluster heartbeat", "Redis Cluster Bus protocol over TLS")
Rel(TLS_Termination_Module, Primary_Master_Nodes, "Terminates incoming encrypted connections", "TLS v1.3 with mTLS")
@enduml