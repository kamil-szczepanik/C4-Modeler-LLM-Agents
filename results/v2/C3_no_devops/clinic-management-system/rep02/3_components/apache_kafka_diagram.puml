@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Apache Kafka container

Container_Boundary(apache_kafka, "Apache Kafka") {
    Component(Kafka_Brokers, "Kafka Brokers", "Apache Kafka Core / KRaft mode", "Event-driven backbone managing asynchronous audit streaming, billing, and patient registration.")
    Component(Schema_Registry, "Schema Registry", "Confluent Schema Registry", "Enforces Avro schemas for backward/forward data compatibility.")
    Component(Kafka_Connect, "Kafka Connect", "Confluent Kafka Connect", "Integrates directly with Cold Storage for compliance archiving.")
    Component(Kafka_Monitoring_Metrics_Exporter, "Kafka Monitoring & Metrics Exporter", "JMX Exporter / Prometheus Operator", "Enables real-time consumer lag monitoring and metric scraping.")
}

System_Ext(EMR_Backend_Container, "EMR Backend Container", "External system container")
System_Ext(Patient_Self_Service_Container, "Patient Self-Service Container", "External system container")
System_Ext(Billing_Container, "Billing Container", "External system container")
System_Ext(Cold_Storage, "Cold Storage", "External system")
System_Ext(Prometheus_Monitoring_Stack, "Prometheus/Monitoring Stack", "External system")

Rel(EMR_Backend_Container, Kafka_Brokers, "Streams immutable audit logs", "Binary Kafka Wire Protocol over TLS 1.3, mTLS, SASL/SCRAM")
Rel(Patient_Self_Service_Container, Kafka_Brokers, "Publishes patient registration and demographic events", "Binary Kafka Wire Protocol over TLS 1.3")
Rel(Billing_Container, Kafka_Brokers, "Decouples insurance claim submissions", "Binary Kafka Wire Protocol over TLS 1.3")
Rel(Kafka_Connect, Cold_Storage, "Sinks compliance logs for >= 10-year retention", "WORM storage policies")
Rel(Kafka_Monitoring_Metrics_Exporter, Prometheus_Monitoring_Stack, "Scrapes broker metrics and consumer lag", "HTTP over TLS")

@enduml