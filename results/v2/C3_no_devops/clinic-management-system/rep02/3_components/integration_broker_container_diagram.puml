@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(Integration_Broker_Container, "Integration Broker Container") {
    Component(Route_Orchestrator, "Route Orchestrator", "Apache Camel Context", "Orchestrates integration routes and message flow.")
    Component(Data_Transformer_Engine, "Data Transformer Engine", "Data Transformation Engine", "Transforms payloads between different message formats.")
    Component(DLQ_and_Retry_Manager, "DLQ & Retry Manager", "DLQ & Retry Manager", "Manages failed transactions and executes retry logic.")
    Component(Broker_Management_API, "Broker Management API", "Broker Management API", "Provides management and monitoring interfaces for the broker.")
}

Rel(Route_Orchestrator, Data_Transformer_Engine, "Transforms payloads", "In-memory Java method call")
Rel(Route_Orchestrator, DLQ_and_Retry_Manager, "Forwards failed transactions", "Kafka Producer / Internal Topic")
@enduml