@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Ingress_Controller, "Ingress Controller", "Kong / Nginx", "Routes incoming external traffic into the internal microservices network.")
    Component(Auth_Filter, "Auth Filter", "OAuth2 / OIDC / JWT / MFA", "Validates tokens, manages authentication, and enforces security policies.")
    Component(Rate_Limiter, "Rate Limiter", "Redis Protocol / TCP", "Prevents abuse by limiting the rate of incoming requests using the Redis cluster.")
    Component(WAF, "WAF", "Coraza / ModSecurity", "Web Application Firewall for payload sanitization and threat protection.")
    Component(Analytics_Forwarder, "Analytics Forwarder", "gRPC", "Streams sanitized events to the audit and compliance daemon.")
}

System_Ext(Redis_Cluster, "Redis Cluster", "In-memory session management and rate limiting")
System_Ext(Audit_Compliance_Daemon_Container, "Audit & Compliance Daemon Container", "Go")

Rel(Auth_Filter, Redis_Cluster, "Token validation and rate limiting", "TCP/Redis Protocol")
Rel(Analytics_Forwarder, Audit_Compliance_Daemon_Container, "Stream sanitized events", "gRPC")

@enduml