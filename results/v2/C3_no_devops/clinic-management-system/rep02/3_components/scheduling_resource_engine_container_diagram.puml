@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Scheduling & Resource Engine Container", "Scheduling & Resource Engine Container") {
    Component("Appointment API Controller", "Appointment API Controller", "Java Spring Boot", "Routes booking requests and handles appointment API endpoints.")
    Component("Resource Conflict Validator", "Resource Conflict Validator", "Java Spring Boot", "Validates resource availability and checks for scheduling conflicts.")
    Component("Distributed Lock Manager", "Distributed Lock Manager", "Redis Cluster with Redisson client", "Provides atomic locking and state caching for real-time race-condition prevention.")
    Component("Schedule Event Publisher", "Schedule Event Publisher", "Java Spring Boot / Apache Kafka", "Emits sanitized schedule events to the message broker.")
    Component("Resource Calendar Service", "Resource Calendar Service", "Java Spring Boot / JPA", "Manages resource calendars and queries availability.")
}

System_Ext(Redis_Cluster, "Redis Cluster", "Redis cluster storage for caching and distributed locks.")
System_Ext(Apache_Kafka, "Apache Kafka", "Message broker for asynchronous event publishing.")

Rel("Distributed Lock Manager", "Redis_Cluster", "Atomic locking & state caching", "Encrypted TLS / Redisson over TCP")
Rel("Resource Conflict Validator", "Resource Calendar Service", "Query availability", "Internal JPA/SQL over JDBC with TLS 1.3")
Rel("Schedule Event Publisher", "Apache_Kafka", "Emit sanitized schedule events", "TCP / SASL over TLS")

@enduml