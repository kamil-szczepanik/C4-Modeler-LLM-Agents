@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the EMR Database container

Container_Boundary(emr_database, "EMR Database") {
    Component(Relational_Storage_Engine, "Relational Storage Engine", "PostgreSQL Cluster with synchronous streaming replication, Row-Level Security (RLS), and declarative table partitioning", "Primary relational database providing multi-tenancy, fast archiving, and routing of reads and writes.")
    Component(Audit_Logging_Subsystem, "Audit Logging Subsystem", "PostgreSQL pgAudit", "Captures DDL and DML activity for comprehensive compliance logging.")
    Component(Connection_Pooler___Read_Scaler, "Connection Pooler & Read Scaler", "PgBouncer", "Handles high connection spikes, routes read-heavy diagnostic traffic to replicas, and directs writes to the primary PostgreSQL node.")
    Component(Encryption___Key_Manager_Integration, "Encryption & Key Manager Integration", "HashiCorp Vault with AES-256 TDE", "Provides secrets management, AES-256 Transparent Data Encryption (TDE) keys, and dynamic credentials.")
}

Component(EMR_Backend_Container, "EMR Backend Container", "Containerized Application", "Queries and updates patient records using TLS 1.3 mTLS and dynamic credentials.")
Component(Audit___Compliance_Daemon_Container, "Audit & Compliance Daemon Container", "Containerized Daemon", "Daemon container supporting compliance monitoring.")
Component(Cold_Storage, "Cold Storage", "Long-term Storage", "Exports WORM-protected audit logs for 10-year retention.")

Rel(EMR_Backend_Container, Connection_Pooler___Read_Scaler, "Queries and updates patient records via TLS 1.3 mTLS with dynamic credentials")
Rel(Connection_Pooler___Read_Scaler, Relational_Storage_Engine, "Routes read-only queries to replicas and writes to primary PostgreSQL node")
Rel(Relational_Storage_Engine, Audit_Logging_Subsystem, "Captures DDL/DML activity via pgAudit")
Rel(Audit_Logging_Subsystem, Cold_Storage, "Exports WORM-protected audit logs for 10-year retention")
Rel(EMR_Backend_Container, Encryption___Key_Manager_Integration, "Provisions dynamic, short-lived database credentials")
@enduml