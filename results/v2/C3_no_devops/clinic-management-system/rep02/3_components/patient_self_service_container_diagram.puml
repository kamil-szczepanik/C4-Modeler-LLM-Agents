@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Patient, "Patient", "Interacts with the web portal for registration, scheduling, and billing.")

System_Ext(API_Gateway, "API Gateway", "Routes and protects backend communications via internal mTLS.", "Kong / Nginx")
System_Ext(CDN_Edge_WAF, "CDN / Edge WAF", "Protects and routes static assets and SSR routes ensuring 99.99% high availability.", "AWS CloudFront / Cloudflare + Kubernetes")

Container_Boundary(Patient_Self_Service_Container, "Patient Self-Service Container") {
    Component(Routing_Session_Component, "Routing & Session Component", "Next.js Router / Custom Middleware", "Handles application routing and session state management.")
    Component(Authentication_Consent_Controller, "Authentication & Consent Controller", "JWT & TLS 1.3 / Security Middleware", "Manages secure session management, authentication, and zero PHI persistence at the edge.")
    Component(Appointment_Demographics_Client_Service, "Appointment & Demographics Client Service", "React / TanStack Query", "Handles form validation and in-memory form state caching with optimistic UI updates.")
    Component(Billing_Payment_Widget_Integration, "Billing & Payment Widget Integration", "JavaScript SDK / Embedded Widget", "Integrates billing and payment processing capabilities.")
}

Rel(Patient, Patient_Self_Service_Container, "Interacts via HTTPS (TLS 1.3)", "HTTPS")
Rel(Patient_Self_Service_Container, API_Gateway, "Communicates via internal mTLS over gRPC/REST", "gRPC/REST over mTLS")
Rel(CDN_Edge_WAF, Patient_Self_Service_Container, "Protects and routes static assets and SSR routes", "HTTPS")

@enduml