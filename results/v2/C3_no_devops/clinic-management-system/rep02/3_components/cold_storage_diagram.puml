@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Cold Storage container

System_Ext(emr_database, "EMR Database", "External EMR Database")

Container_Boundary(cold_storage, "Cold Storage") {
    Component(go_based_archival_worker_component, "Go-based Archival Worker Component", "Go", "Powers lightweight archival and background worker processes.")
    Component(retrieval_api_component, "Retrieval API Component", "Go / REST API", "Handles retrieval requests and enqueues hydration tasks.")
    Component(job_orchestration_component, "Job Orchestration Component", "AWS SQS / Redis", "Manages and orchestrates restoration and hydration jobs.")
    Component(data_transformation_component, "Data Transformation Component", "Parser Module", "Transforms and parses archived data.")
    Component(storage_engine, "Storage Engine", "AWS S3 Glacier Flexible Retrieval / Ceph Object Storage", "Ensures secure, cost-effective long-term data retention with WORM immutability.")
    Component(audit_compliance_daemon_container, "Audit & Compliance Daemon Container", "Containerized Daemon", "Delivers decrypted historical records and enforces compliance.")
}

Rel(emr_database, storage_engine, "Asynchronously streams partitioned Parquet files", "TLS 1.3")
Rel(retrieval_api_component, job_orchestration_component, "Enqueues hydration tasks", "Internal IPC / Redis")
Rel(job_orchestration_component, storage_engine, "Initiates restoration jobs", "AWS SDK / S3 API over TLS 1.3")
Rel(retrieval_api_component, audit_compliance_daemon_container, "Delivers decrypted historical records", "HTTPS / mTLS")

@enduml