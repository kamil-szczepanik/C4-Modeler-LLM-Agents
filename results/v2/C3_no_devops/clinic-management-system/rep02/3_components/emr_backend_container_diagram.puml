@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the EMR Backend Container container

Container_Boundary(emr_backend_container, "EMR Backend Container") {
    Component(EMR_REST_gRPC_Controller, "EMR REST/gRPC Controller", "Java Spring Boot 3", "Handles incoming REST and gRPC requests for EMR operations.")
    Component(Clinical_Record_Service, "Clinical Record Service", "Spring Data JPA", "Manages clinical records and provides optimistic locking for concurrent chart updates.")
    Component(Audit_Interceptor, "Audit Interceptor", "Java Spring Boot", "Intercepts requests and actions to maintain compliance and audit logs.")
    Component(Clinical_Summary_Aggregator, "Clinical Summary Aggregator", "Java Spring Boot", "Aggregates clinical summaries for high-performance retrieval.")
    Component(HashiCorp_Vault_Agent_Sidecar, "HashiCorp Vault Agent Sidecar", "HashiCorp Vault", "Secures dynamic secret injection and ephemeral tokens at container startup.")
}

SystemDb_Ext(EMR_Database, "EMR Database", "PostgreSQL with RLS", "Enforces row-level security for HIPAA/GDPR patient isolation.")
System_Ext(Redis_Cluster, "Redis Cluster", "Redis", "Delivers sub-second P95 load times for cached clinical summaries.")
System_Ext(HashiCorp_Vault, "HashiCorp Vault", "HashiCorp Vault", "Secures dynamic secret injection at container startup.")

Rel(EMR_REST_gRPC_Controller, Clinical_Record_Service, "In-process method calls")
Rel(Clinical_Record_Service, EMR_Database, "JDBC over TLS", "connection pooling")
Rel(Clinical_Summary_Aggregator, Redis_Cluster, "Redis protocol over TLS")
Rel(emr_backend_container, HashiCorp_Vault, "Ephemeral tokens via sidecar")
@enduml