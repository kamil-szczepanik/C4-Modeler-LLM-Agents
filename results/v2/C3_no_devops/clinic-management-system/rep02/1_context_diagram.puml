@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patient, "Patient", "An individual receiving care who uses the web or mobile UI to access their portal, schedule appointments, and view medical records.")
Person(ClinicalStaff, "Clinical Staff", "Doctors and nurses who interact with the system to manage electronic medical records (EMR), patient admissions, and clinical workflows.")
Person(AdministrativeStaff, "Administrative Staff", "Staff members responsible for managing scheduling, billing, and administrative operations within the clinic.")
Person(ComplianceOfficerAuditor, "Compliance Officer / Auditor", "Personnel responsible for monitoring system security, auditing access logs, and ensuring HIPAA/GDPR compliance.")

System(ClinicManagementSystem, "Clinic Management System", "A hybrid cloud platform designed to manage patient admissions, electronic medical records (EMR), scheduling, and billing for medium-sized healthcare facilities with strict HIPAA/GDPR compliance.")

System_Ext(PaymentGateway, "Payment Gateway", "External financial service used to process patient payments and billing transactions securely.")
System_Ext(InsuranceClearinghouse, "Insurance Clearinghouse", "External system used to verify insurance coverage and process insurance claims.")
System_Ext(ExternalLabImagingSystems, "External Lab / Imaging Systems", "External clinical systems used for diagnostic testing, lab results, and medical imaging.")
System_Ext(PharmacyManagementSystem, "Pharmacy Management System", "External system used for managing electronic prescriptions and pharmacy integration.")

Rel(Patient, ClinicManagementSystem, "Manages admissions, appointments, and records via web/mobile UI", "HTTPS / TLS 1.3, OAuth 2.0 / OIDC MFA")
Rel(ClinicalStaff, ClinicManagementSystem, "Accesses and updates electronic medical records and clinical workflows", "HTTPS / TLS 1.3, OAuth 2.0 / OIDC MFA")
Rel(AdministrativeStaff, ClinicManagementSystem, "Manages scheduling, billing, and administrative tasks", "HTTPS / TLS 1.3, OAuth 2.0 / OIDC MFA")
Rel(ComplianceOfficerAuditor, ClinicManagementSystem, "Monitors compliance, audit logs, and security controls", "HTTPS / TLS 1.3, OAuth 2.0 / OIDC MFA")
Rel(ClinicManagementSystem, PaymentGateway, "Processes billing and payment transactions", "HTTPS / REST over TLS")
Rel(ClinicManagementSystem, InsuranceClearinghouse, "Verifies insurance and submits claims", "HTTPS / EDI-X12 or REST")
Rel(ClinicManagementSystem, ExternalLabImagingSystems, "Exchanges clinical data and diagnostic results", "HTTPS / HL7 FHIR RESTful APIs (mTLS)")
Rel(ClinicManagementSystem, PharmacyManagementSystem, "Sends and receives electronic prescriptions", "HTTPS / HL7 FHIR RESTful APIs (mTLS)")
@enduml