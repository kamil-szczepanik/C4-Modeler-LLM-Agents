@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Clinic Management System

Person(Clinic_Receptionist_Patient_Registrar, "Clinic Receptionist / Patient Registrar", "Handles patient admissions, registration, and front-desk scheduling.")
Person(Physician_Clinician, "Physician / Clinician", "Accesses and updates electronic medical records and manages patient care.")
Person(Billing_Specialist, "Billing Specialist", "Manages billing, claims, and payment processing.")
Person(Clinic_Administrator, "Clinic Administrator", "Manages administrative settings, roles, and overall clinic operations.")
Person(Patient, "Patient", "Interacts with the clinic for appointments, records, and payments.")

System(Clinic_Management_System_CMS, "Clinic Management System (CMS)", "Core enterprise healthcare platform providing EMR, scheduling, and billing.")

System_Ext(Enterprise_Identity_Provider_IdP, "Enterprise Identity Provider (IdP)", "Provides authentication and Role-Based Access Control (RBAC).")
System_Ext(External_Lab_Imaging_Systems, "External Lab & Imaging Systems", "External systems for diagnostic laboratory and imaging data exchange.")
System_Ext(Payment_Gateway_Insurance_Clearinghouse, "Payment Gateway / Insurance Clearinghouse", "Handles real-time insurance claims and financial transactions.")
System_Ext(Audit_Archival_SIEM_System, "Audit Archival / SIEM System", "Receives encrypted audit logs and handles WORM-compliant data retention.")

Rel(Clinic_Receptionist_Patient_Registrar, Clinic_Management_System_CMS, "Performs patient admissions and scheduling", "HTTPS/REST over TLS 1.3 with Multi-Factor Authentication")
Rel(Physician_Clinician, Clinic_Management_System_CMS, "Accesses and updates electronic medical records", "HTTPS/REST over TLS 1.3 with Multi-Factor Authentication")
Rel(Billing_Specialist, Clinic_Management_System_CMS, "Processes billing and claims", "HTTPS/REST over TLS 1.3 with Multi-Factor Authentication")
Rel(Clinic_Administrator, Clinic_Management_System_CMS, "Manages system administration and access controls", "HTTPS/REST over TLS 1.3 with Multi-Factor Authentication")
Rel(Patient, Clinic_Management_System_CMS, "Views personal health records and appointment details", "HTTPS/REST over TLS 1.3 with Multi-Factor Authentication")

Rel(Clinic_Management_System_CMS, Enterprise_Identity_Provider_IdP, "Authenticates users and enforces RBAC", "OIDC/SAML")
Rel(Clinic_Management_System_CMS, External_Lab_Imaging_Systems, "Exchanges clinical data and lab results", "HL7 FHIR REST APIs over TLS 1.3")
Rel(Clinic_Management_System_CMS, Payment_Gateway_Insurance_Clearinghouse, "Submits real-time claims and processes financial transactions", "HTTPS/REST")
Rel(Clinic_Management_System_CMS, Audit_Archival_SIEM_System, "Sends audit logs for security monitoring and long-term retention", "Encrypted Syslog/HTTPS with HMAC-signed log packets")

@enduml