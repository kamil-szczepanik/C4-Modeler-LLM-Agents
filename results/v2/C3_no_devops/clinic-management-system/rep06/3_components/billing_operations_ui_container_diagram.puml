@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing Operations UI Container container

Container_Boundary("Billing Operations UI Container", "Billing Operations UI Container") {
    Component(SPA Frontend, "SPA Frontend", "React", "Frontend framework for dynamic billing dashboards and component-level RBAC.")
    Component(Web Server & Proxy, "Web Server & Proxy", "Nginx", "Web server delivering the SPA, terminating TLS 1.3, and injecting strict security headers.")
}

Rel(Web Server & Proxy, SPA Frontend, "Delivers and serves the Single Page Application", "HTTPS")

@enduml