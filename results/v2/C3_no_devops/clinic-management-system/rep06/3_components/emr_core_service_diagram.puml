@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Audit_Archival_SIEM_System, "Audit Archival / SIEM System", "External system for audit logs")

Container_Boundary(emr_core_service, "EMR Core Service") {
    Component(EMR_API_Controller, "EMR API Controller", "Spring WebFlux/gRPC, Spring Security", "Exposes secure endpoints for patient admissions, electronic medical records, and rapid data access.")
    Component(Clinical_Record_Manager, "Clinical Record Manager", "Spring Service", "Core component managing EMR business logic, optimization, and validation.")
    Component(Audit_Compliance_Interceptor, "Audit & Compliance Interceptor", "Spring AOP, non-blocking disruptor queue", "Utilizes a non-blocking disruptor queue for asynchronous audit logging to ensure strict regulatory compliance.")
    Component(Data_Access_Repository, "Data Access Repository", "Spring Data JPA, PostgreSQL", "Data access layer utilizing PostgreSQL with AES-256 storage and envelope encryption.")
    Component(Event_Publisher, "Event Publisher", "Spring AMQP", "Dispatches signed domain events to RabbitMQ.")
    Component(Caching_Proxy, "Caching Proxy", "Redis", "High-performance in-memory cache utilizing Redis with client-side field-level encryption.")
}

Rel(EMR_API_Controller, Clinical_Record_Manager, "In-process gRPC/Method call")
Rel(Clinical_Record_Manager, Caching_Proxy, "In-process Redis read-through")
Rel(Clinical_Record_Manager, Data_Access_Repository, "JPA/SQL with AES-256")
Rel(Clinical_Record_Manager, Audit_Compliance_Interceptor, "Method Interception via Spring AOP")
Rel(Audit_Compliance_Interceptor, Audit_Archival_SIEM_System, "Asynchronous Syslog/HTTPS")
Rel(Clinical_Record_Manager, Event_Publisher, "AMQP event dispatch")

@enduml