@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(patient_portal_bff, "Patient Portal BFF") {
    Component(GraphQL_API_Server, "GraphQL API Server", "Node.js, Apollo Server", "Powers the Patient Portal BFF for efficient, tailored data payloads and handles incoming client requests.")
    Component(Cache_Manager, "Cache Manager", "Redis", "Caches read-heavy static clinical data with AES-256 encryption at rest.")
}

System_Ext(Patient___Scheduling_Service, "Patient & Scheduling Service", "Go service for managing patient appointments and schedules.")
System_Ext(EMR_Core_Service, "EMR Core Service", "Spring Boot service for managing Electronic Medical Records.")

Rel(GraphQL_API_Server, Cache_Manager, "Reads and writes cached clinical data", "Redis Protocol")
Rel(GraphQL_API_Server, Patient___Scheduling_Service, "Fetches scheduling data", "gRPC over mTLS")
Rel(GraphQL_API_Server, EMR_Core_Service, "Fetches medical records", "gRPC over mTLS")

@enduml