@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

System_Ext(SIEM_System, "SIEM System", "External SIEM system")
System_Ext(Patient_Portal_BFF_Billing_Operations_UI, "Patient Portal BFF & Billing Operations UI", "Frontend applications")
System_Ext(Patient_Scheduling_EMR_Core_and_Billing_Services, "Patient & Scheduling, EMR Core, and Billing Services", "Backend microservices")

Container_Boundary(api_gateway, "API Gateway") {
    Component(Authentication_Authorization_Filter, "Authentication & Authorization Filter", "Kong Plugin / Node.js", "Validates JWT tokens and enforces access control policies for incoming requests.")
    Component(Rate_Limiting_Throttling_Engine, "Rate Limiting & Throttling Engine", "Kong / Redis", "Powers persona-based rate limiting and throttling quotas using Redis.")
    Component(Routing_Load_Balancing_Proxy, "Routing & Load Balancing Proxy", "Kong / Node.js", "Routes frontend traffic and proxies backend requests using gRPC over mTLS.")
    Component(Audit_Telemetry_Interceptor, "Audit & Telemetry Interceptor", "Kong Plugin", "Asynchronously emits access logs to the external SIEM system via HTTPS.")
    Component(Edge_WAF_Sanitization_Filter, "Edge WAF & Sanitization Filter", "Kong Security Plugin", "Provides edge security controls and input sanitization.")
    Component(Tenant_Usage_Metering_Component, "Tenant & Usage Metering Component", "Kong / Node.js", "Tracks usage metrics and multi-tenant activity.")
}

Rel(Authentication_Authorization_Filter, Routing_Load_Balancing_Proxy, "Allows authorized traffic to pass through for routing")
Rel(Rate_Limiting_Throttling_Engine, Routing_Load_Balancing_Proxy, "Enforces traffic throttling rules")
Rel(Edge_WAF_Sanitization_Filter, Authentication_Authorization_Filter, "Inspects and sanitizes incoming HTTP traffic first")
Rel(Audit_Telemetry_Interceptor, SIEM_System, "Asynchronously emits access logs", "HTTPS")
Rel(Routing_Load_Balancing_Proxy, Patient_Portal_BFF_Billing_Operations_UI, "Routes frontend traffic", "HTTPS")
Rel(Routing_Load_Balancing_Proxy, Patient_Scheduling_EMR_Core_and_Billing_Services, "Proxies backend requests", "gRPC over mTLS")

@enduml