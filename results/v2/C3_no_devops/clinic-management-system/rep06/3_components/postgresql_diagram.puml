@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(postgresql, "PostgreSQL") {
    Component(PrimaryEngine, "Primary Engine", "PostgreSQL 16", "Handles primary transactional data queries and updates.")
    Component(PgBouncer, "PgBouncer", "PgBouncer", "Manages connection pooling to maintain sub-second EMR load times.")
    Component(PatroniStandbyNodes, "Patroni Standby Nodes", "Patroni / PgBackRest", "Provides high-availability and standby nodes for replication.")
    Component(pgAudit, "pgAudit", "pgAudit", "Ensures security auditing for HIPAA and GDPR compliance.")
    Component(DebeziumCDCWorker, "Debezium CDC Worker", "Debezium", "Publishes row changes via CDC for asynchronous event streaming.")
}

Rel(PgBouncer, PrimaryEngine, "Routes queries and updates transactional data", "SQL over TLS / SCRAM-SHA-256")
Rel(PrimaryEngine, PatroniStandbyNodes, "Replicates transactional data", "TCP Binary Streaming")
Rel(PrimaryEngine, DebeziumCDCWorker, "Publishes row changes", "pgoutput / TCP")
Rel(PrimaryEngine, pgAudit, "Logs database activities and access for compliance")

@enduml