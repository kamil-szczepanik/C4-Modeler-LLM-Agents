@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the RabbitMQ container

System_Ext(emr_services, "EMR, Scheduling, & Billing Services", "External services that publish and consume asynchronous events.")
System_Ext(idp, "Enterprise Identity Provider (IdP)", "Authenticates users and validates access permissions.")
System_Ext(siem, "SIEM System", "Receives real-time audit logs for compliance monitoring.")

Container_Boundary(rabbitmq, "RabbitMQ") {
    Component(erlang_core, "Erlang/RabbitMQ Core", "Erlang/Ranch, AMQP 0-9-1", "Manages direct and topic exchanges, connection listening, and core message routing.")
    Component(quorum_queues, "RabbitMQ Quorum Queues", "Raft Consensus", "Provides durable, highly available queues guaranteeing zero data loss across nodes.")
    Component(auth_oauth2, "auth_backend_oauth2", "OAuth2 / LDAP", "Enforces role-based and attribute-based access control integrated with the Enterprise IdP.")
    Component(webhooks_shovel, "RabbitMQ Webhooks / Shovel plugin", "HTTPS", "Facilitates secure integration routes and forwards dead-lettered payloads.")
    Component(dlq_worker, "DLQ Notification Worker", "Python/FastAPI", "Processes dead-lettered payloads to generate business and administrative alerts.")
}

Rel(emr_services, erlang_core, "Publishes and consumes asynchronous events", "AMQP 0-9-1, TLS 1.3 / mTLS")
Rel(erlang_core, idp, "Validates access permissions", "auth_backend_oauth2")
Rel(webhooks_shovel, dlq_worker, "Forwards dead-lettered payloads", "HTTPS webhooks")
Rel(erlang_core, siem, "Forwards real-time audit logs", "TLS")

@enduml