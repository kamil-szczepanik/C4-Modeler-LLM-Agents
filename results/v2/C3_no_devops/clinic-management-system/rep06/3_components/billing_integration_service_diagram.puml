@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing & Integration Service container

System_Ext(PaymentGatewayInsuranceClearinghouse, "Payment Gateway / Insurance Clearinghouse", "External financial and insurance system.")
System_Ext(ExternalLabImagingSystems, "External Lab & Imaging Systems", "External clinical and imaging systems.")
System_Ext(RabbitMQ, "RabbitMQ", "Message broker for asynchronous event-driven messaging.")

Container_Boundary(BillingIntegrationService, "Billing & Integration Service") {
    Component(BillingAPIController, "Billing API Controller", "FastAPI / Python", "Handles high-throughput asynchronous API endpoints and invokes claim generation with user context.")
    Component(ClaimProcessingEngine, "Claim Processing Engine", "Python / SQLAlchemy", "Processes claims and orchestrates data persistence and audit logging.")
    Component(FHIRIntegrationAdapter, "FHIR Integration Adapter", "HL7 FHIR / Python", "Transmits diagnostic data to external clinical and imaging systems using HL7 FHIR APIs over mTLS.")
    Component(PaymentReconciliationWorker, "Payment & Reconciliation Worker", "Python / RabbitMQ", "Executes financial transactions and processes billing events asynchronously with DLQ fallback.")
    Component(BillingDataRepositoryLayer, "Billing Data Repository Layer", "SQLAlchemy ORM / PostgreSQL", "Manages secure database mapping, connection management, and AES-256 encrypted persistence.")
}

Rel(BillingAPIController, ClaimProcessingEngine, "Invokes claim generation with user context", "Python async call")
Rel(ClaimProcessingEngine, BillingDataRepositoryLayer, "Persists data and audit logs", "SQLAlchemy / AES-256")
Rel(PaymentReconciliationWorker, PaymentGatewayInsuranceClearinghouse, "Executes financial transactions", "HTTPS/REST with mTLS & OAuth2")
Rel(FHIRIntegrationAdapter, ExternalLabImagingSystems, "Transmits diagnostic data", "HL7 FHIR APIs over mTLS")
Rel(PaymentReconciliationWorker, RabbitMQ, "Processes billing events with DLQ fallback", "AMQP")

@enduml