@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(patrons, "Library Patrons (Students, Public)", "End users who access the library services for cataloguing, circulation, and self-service portals.")
Person(staff, "Librarians / Circulation Staff", "Staff members who manage circulation, cataloguing, and day-to-day library operations.")
Person(admins, "Library Administrators", "Administrators responsible for system configuration, management, and oversight.")

System_Ext(idp, "EU Identity Provider (IdP)", "Handles user authentication using OAuth2/OIDC token introspection.")
System_Ext(payment, "EU-compliant Payment Gateway", "Processes financial transactions securely within compliance guidelines.")
System_Ext(cloud, "EU Cloud Hosting Provider (Frankfurt)", "Provides regional cloud infrastructure ensuring EU data residency.")

System_Boundary(lms, "Library Management System") {
    Container(frontend, "Frontend Container", "React/TypeScript SPA", "Powers the interactive patron and staff self-service portal served via CDN.")
    Container(gateway, "API Gateway", "Nginx/Kong", "Acts as a secure, high-performance single entry point handling routing, rate limiting, and JWT/OAuth2 validation.")
    Container(catalogue, "Catalogue & Search Service", "Spring Boot / Java with Elasticsearch", "Delivers sub-second catalogue searches meeting performance requirements.")
    Container(circulation, "Circulation & Member Service", "Node.js / NestJS", "Secures transactional circulation data, loans, fines, and PII under strict EU residency.")
    Container(analytics, "Analytics & Reporting Container", "Python / FastAPI", "Isolates heavy administrative reporting queries via a read-optimized PostgreSQL replica.")
    Container(notification, "Notification Worker Container", "Go", "Handles asynchronous notifications and event-driven decoupled workflows.")
    Container(broker, "Message Broker", "Apache Kafka / RabbitMQ", "Enables asynchronous event-driven messaging between services.")
    ContainerDb(database, "Databases", "EU-hosted PostgreSQL with AES-256 encryption-at-rest", "Provides encrypted persistent storage for circulation, member data, and read replicas.")
}

Rel(patrons, frontend, "Accesses self-service portals", "HTTPS")
Rel(staff, frontend, "Accesses staff portal and circulation tools", "HTTPS")
Rel(admins, frontend, "Accesses administrative portal", "HTTPS")

Rel(frontend, gateway, "Sends API requests", "HTTPS/REST")

Rel(gateway, idp, "Validates and introspects tokens", "OAuth2/OIDC token introspection")
Rel(gateway, catalogue, "Routes search and catalogue requests", "gRPC over mTLS")
Rel(gateway, circulation, "Routes circulation and member requests", "gRPC over mTLS")
Rel(gateway, analytics, "Routes reporting and analytics requests", "gRPC over mTLS")

Rel(circulation, database, "Reads and writes transactional circulation data and PII", "TLS with AES-256 encryption-at-rest")
Rel(catalogue, database, "Accesses catalogue data", "Internal cluster protocol")
Rel(analytics, database, "Queries read-optimized PostgreSQL replica", "TLS")

Rel(circulation, broker, "Publishes and consumes circulation events", "TLS-secured gRPC/AMQP with SASL/SCRAM")
Rel(notification, broker, "Consumes async events for notifications", "TLS-secured gRPC/AMQP with SASL/SCRAM")

Rel(circulation, payment, "Processes fines and payments", "HTTPS/TLS 1.3")
Rel(circulation, cloud, "Runs within Frankfurt VPC infrastructure", "Cloud Infrastructure")

@enduml