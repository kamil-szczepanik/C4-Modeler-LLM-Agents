@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Databases container

Container_Boundary(Databases, "Databases") {
    Component(PostgreSQL_Primary_Node, "PostgreSQL Primary Node", "PostgreSQL 16", "Core transactional database for performance and ACID compliance, handling transactional reads/writes.")
    Component(PostgreSQL_Read_Replica, "PostgreSQL Read Replica", "PostgreSQL 16", "Read replica supporting high availability and sub-800ms search/query performance.")
    Component(Audit_Compliance_Logger, "Audit & Compliance Logger", "pgAudit", "Structured tamper-evident logging for GDPR compliance.")
    Component(Backup_PITR_Agent, "Backup & PITR Agent", "Barman / pgBackRest", "Continuous backup and Point-in-Time Recovery (PITR) agent.")
    Component(Data_Anonymization_Views, "Data Anonymization Views", "PostgreSQL Row-Level Security (RLS) & Secure Views", "Data isolation and anonymization views for de-identified reporting queries.")
}

Rel(Circulation_Member_Service, PostgreSQL_Primary_Node, "Transactional reads/writes", "TCP/IP via mTLS 1.3")
Rel(Analytics_Reporting_Container, Data_Anonymization_Views, "De-identified reporting queries", "TCP/IP via TLS 1.3")
Rel(PostgreSQL_Primary_Node, PostgreSQL_Read_Replica, "Asynchronous WAL streaming", "Internal streaming replication protocol via mTLS")
Rel(Backup_PITR_Agent, PostgreSQL_Primary_Node, "Continuous WAL archiving", "Filesystem / Storage API")
@enduml