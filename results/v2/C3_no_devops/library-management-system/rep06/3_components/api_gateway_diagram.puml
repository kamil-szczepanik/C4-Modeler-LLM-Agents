@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(jwt_validation_component, "JWT Validation Component", "Kong/Nginx Plugin with JWT", "Validates incoming tokens and checks revocation against the EU Identity Provider.")
    Component(waf_security_header_component, "WAF & Security Header Component", "Kong/Nginx WAF", "Provides Web Application Firewall protection, payload limiting, and security headers.")
    Component(redis_cache_component, "Redis Cache Component", "Redis RESP Plugin", "Checks token blacklist, rate limits, and persona-based quotas.")
}

System_Ext(eu_identity_provider_idp, "EU Identity Provider (IdP)", "External Identity Provider system for authentication.")
System_Ext(redis_cache, "Redis Cache", "External Redis Cache instance.")

Rel(jwt_validation_component, eu_identity_provider_idp, "Validates tokens and checks revocation", "OAuth2/OIDC")
Rel(redis_cache_component, redis_cache, "Checks token blacklist and rate limits", "RESP")

@enduml