@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Frontend Container container

System_Ext(API_Gateway, "API Gateway", "External system")
System_Ext(EU_Identity_Provider, "EU Identity Provider", "External system")

Container_Boundary(Frontend_Container, "Frontend Container") {
    Component(Routing_View_Layer, "Routing & View Layer", "React Router", "Manages client-side navigation and role-based UI hydration.")
    Component(State_Offline_Manager, "State & Offline Manager", "Zustand + IndexedDB", "Handles volatile session state and offline-resilient non-PII digital catalog caching.")
    Component(API_Communication_Layer, "API Communication Layer", "Axios with interceptors and Zod validation", "Provides strict runtime input validation mirrored from backend expectations and handles HTTP communications.")
    Component(Design_System_i18n_Component, "Design System & i18n Component", "Tailwind CSS / Radix UI + i18next", "Enforces WCAG 2.1 AA accessibility, responsive design, municipal white-labeling, and multi-language localization.")
}

Rel(Routing_View_Layer, State_Offline_Manager, "Reads and writes session state and cached catalog data")
Rel(Routing_View_Layer, Design_System_i18n_Component, "Renders localized accessible UI elements")
Rel(Routing_View_Layer, API_Communication_Layer, "Triggers data fetching and mutations")
Rel(API_Communication_Layer, API_Gateway, "Forwards REST API calls", "HTTPS")
Rel(API_Communication_Layer, EU_Identity_Provider, "Manages authentication flows and token exchange", "HTTPS")

@enduml