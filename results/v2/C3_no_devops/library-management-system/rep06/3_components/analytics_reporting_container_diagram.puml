@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Analytics & Reporting Container container

Container_Boundary(analytics_reporting_container, "Analytics & Reporting Container") {
    Component(Report_Orchestrator_Component, "Report Orchestrator Component", "FastAPI Router", "Routes reporting requests received from the API Gateway.")
    Component(Aggregation___Analytics_Engine_Component, "Aggregation & Analytics Engine Component", "Pandas / NumPy", "Performs efficient in-memory data processing for analytics and trend calculations.")
    Component(Data_Anonymization_Component, "Data Anonymization Component", "Python", "Passes and sanitizes raw query results to strictly isolate and protect patron PII.")
    Component(Export_Generation_Component, "Export Generation Component", "ReportLab / WeasyPrint", "Generates secure CSV and PDF exports.")
    Component(Alert_Evaluation_Component, "Alert Evaluation Component", "Python", "Evaluates and streams computed metrics for anomaly events.")
}

Rel(Report_Orchestrator_Component, Data_Anonymization_Component, "Passes raw query results", "In-memory")
Rel(Aggregation___Analytics_Engine_Component, Export_Generation_Component, "Passes processed data", "In-memory")
Rel(Aggregation___Analytics_Engine_Component, Alert_Evaluation_Component, "Streams computed metrics", "In-memory")

@enduml