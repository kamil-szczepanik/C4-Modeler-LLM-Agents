@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalogue & Search Service container

System_Ext(api_gateway, "API Gateway", "External system routing requests.")
System_Ext(elasticsearch_cluster, "Elasticsearch Cluster", "Elasticsearch", "Powers fast, facet-filtered, fuzzy-matched searches.")
System_Ext(postgresql_database, "PostgreSQL Database", "PostgreSQL", "Provides transactional relational storage for catalogue metadata.")
System_Ext(apache_kafka_message_broker, "Apache Kafka Message Broker", "Apache Kafka", "Enables decoupled, asynchronous event streaming.")

Container_Boundary(catalogue_and_search_service, "Catalogue & Search Service") {
    Component(search_controller, "Search Controller", "Spring MVC", "Processes search and catalogue requests.")
    Component(catalogue_manager, "Catalogue Manager", "Spring Data JPA", "Manages catalogue metadata persistence.")
    Component(index_synchronizer, "Index Synchronizer", "Spring Integration + Kafka Consumer", "Consumes item mutation events for index synchronization.")
    Component(analytics_publisher, "Analytics Publisher", "Spring Cloud Stream", "Dispatches asynchronous search telemetry and publishes anonymized search event streams.")
}

Rel(api_gateway, search_controller, "Routes search and catalogue requests", "gRPC over mTLS")
Rel(search_controller, elasticsearch_cluster, "Queries index", "Elasticsearch Native Transport / TCP")
Rel(catalogue_manager, postgresql_database, "Persists catalogue metadata", "JDBC over TLS")
Rel(apache_kafka_message_broker, index_synchronizer, "Consumes item mutation events", "Kafka protocol over TLS")
Rel(search_controller, analytics_publisher, "Dispatches asynchronous search telemetry", "In-process Spring ApplicationEvent")
Rel(analytics_publisher, apache_kafka_message_broker, "Publishes anonymized search event streams", "Kafka protocol over TLS")

@enduml