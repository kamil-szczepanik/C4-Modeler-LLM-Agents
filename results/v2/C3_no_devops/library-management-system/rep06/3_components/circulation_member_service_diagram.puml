@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Circulation & Member Service container

Container_Boundary(circulation_member_service, "Circulation & Member Service") {
    Component(Loan_Management_Controller_Service, "Loan Management Controller & Service", "TypeScript / NestJS", "Manages library loans, item check-outs, check-ins, and renewals.")
    Component(Fine_Payment_Processor_Component, "Fine & Payment Processor Component", "TypeScript / NestJS", "Calculates and processes fines, interacting with the external EU-compliant Payment Gateway using tokenized payments.")
    Component(Event_Publisher_Notification_Event_Dispatcher, "Event Publisher & Notification Event Dispatcher", "TypeScript / NestJS", "Publishes domain events to the message broker and dispatches notification alerts.")
    Component(Member_Profile_PII_Manager, "Member Profile & PII Manager", "TypeScript / NestJS", "Manages patron PII with application-level AES-256 encryption ensuring EU data residency and GDPR compliance.")
    Component(Dispute_Management_Handler, "Dispute Management Handler", "TypeScript / NestJS", "Handles patron disputes regarding fines, loans, and account status.")
}

System_Ext(EU_compliant_Payment_Gateway, "EU-compliant Payment Gateway", "External payment gateway for tokenized transactions.")
System_Ext(Notification_Worker_Container, "Notification Worker Container", "Worker container processing notification alerts.")
System_Ext(Database, "Database", "PostgreSQL database for transactional data and PII storage.")
System_Ext(Message_Broker, "Message Broker", "Message broker for emitting domain events.")

Rel(Fine_Payment_Processor_Component, EU_compliant_Payment_Gateway, "Processes tokenized payments", "HTTPS/TLS 1.3")
Rel(Event_Publisher_Notification_Event_Dispatcher, Notification_Worker_Container, "Triggers alerts", "gRPC/AMQP")
Rel(circulation_member_service, Database, "Reads/writes transactional data and PII", "SQL over TLS with AES-256")
Rel(circulation_member_service, Message_Broker, "Emits domain events", "AMQP/TLS with SASL/SCRAM")

@enduml