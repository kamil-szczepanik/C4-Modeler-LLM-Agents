@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(Message_Broker, "Message Broker") {
    Component(Kafka_Broker_Cluster, "Kafka Broker Cluster", "Apache Kafka", "High-throughput, fault-tolerant event streaming engine handling domain and historical events.")
    Component(Schema_Registry, "Schema Registry", "Confluent/Apicurio Schema Registry", "Enforces strict data contracts and blocks unmasked PII.")
    Component(DLQ_Manager, "DLQ Manager", "Dead Letter Queue Manager", "Manages failed message routing and error handling for the event pipeline.")
}

Rel(Kafka_Broker_Cluster, Schema_Registry, "Validates message schemas", "REST")
Rel(Kafka_Broker_Cluster, DLQ_Manager, "Routes poison pill messages", "Internal Routing")

@enduml