@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Library_Patrons_Students_Public, "Library Patrons (Students, Public)", "End users who access the library services for cataloguing, circulation, and self-service portals.")
Person(Librarians_Circulation_Staff, "Librarians / Circulation Staff", "Staff members who manage circulation, cataloguing, and day-to-day library operations.")
Person(Library_Administrators, "Library Administrators", "Administrators responsible for system configuration, management, and oversight.")

System(Library_Management_System, "Library Management System", "Provides cataloguing, circulation, and self-service portals for public and academic libraries, ensuring EU-only data residency and high-performance search requirements.")

System_Ext(EU_Identity_Provider_IdP, "EU Identity Provider (IdP)", "Handles user authentication using Keycloak and OAuth2/OIDC.")
System_Ext(EU_compliant_Payment_Gateway, "EU-compliant Payment Gateway", "Processes financial transactions securely within compliance guidelines.")
System_Ext(EU_Cloud_Hosting_Provider_Frankfurt, "EU Cloud Hosting Provider (Frankfurt)", "Provides regional cloud infrastructure (AWS or Azure Frankfurt Region) ensuring EU data residency.")

Rel(Library_Patrons_Students_Public, Library_Management_System, "Interact with the system for self-service portals and circulation", "HTTPS")
Rel(Librarians_Circulation_Staff, Library_Management_System, "Manage circulation and cataloguing via the system", "HTTPS")
Rel(Library_Administrators, Library_Management_System, "Administer and configure the system", "HTTPS")
Rel(Library_Management_System, EU_Identity_Provider_IdP, "Authenticates users and verifies identity", "HTTPS/OIDC")
Rel(Library_Management_System, EU_compliant_Payment_Gateway, "Processes payments and verifies financial webhooks using HMAC signatures", "HTTPS/REST")
Rel(Library_Management_System, EU_Cloud_Hosting_Provider_Frankfurt, "Runs on regional infrastructure to ensure EU data residency compliance", "Cloud Infrastructure (AWS/Azure Frankfurt)")
@enduml