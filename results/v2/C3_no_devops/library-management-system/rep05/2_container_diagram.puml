@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(Library_Patrons, "Library Patrons", "Students and public users accessing the system via self-service portals.")
Person(Librarians_Circulation_Staff, "Librarians / Circulation Staff", "Personnel managing inventory, loans, and daily operations.")
Person(Library_Administrators, "Library Administrators", "Users overseeing reporting and user management.")

System_Ext(Stripe_EU, "Stripe EU", "External payment processing system restricted to EU endpoints.")
System_Ext(Keycloak_Auth0_EU_tenant, "Keycloak/Auth0 EU tenant", "External identity and authentication provider (OAuth 2.0 / OIDC).")
System_Ext(SendGrid_EU, "SendGrid EU", "External notification and email delivery service restricted to EU endpoints.")

System_Boundary(Library_Management_System, "Library Management System") {
    Container(Web_Application, "Web Application", "React, TypeScript, Nginx", "Single Page Application (SPA) providing self-service portals and user interfaces.")
    Container(API_Gateway, "API Gateway", "Spring Cloud Gateway, Java", "Routes and secures incoming traffic to core services and search containers.")
    Container(Core_Services_Container, "Core Services Container", "Spring Boot, Java", "Contains core business logic for catalogue, circulation, and management.")
    Container(Search_Container, "Search Container", "Elasticsearch / OpenSearch", "Provides sub-second search performance for physical and digital items.")
    ContainerDb(PostgreSQL, "PostgreSQL", "PostgreSQL (AWS RDS EU)", "Stores persistent relational data for the library management system.")
    Container(Message_Broker, "Message Broker", "Apache Kafka / RabbitMQ", "Handles event-driven messaging and asynchronous data processing.")
}

Rel(Library_Patrons, Web_Application, "Accesses self-service portals", "HTTPS (REST/GraphQL, TLS 1.3)")
Rel(Librarians_Circulation_Staff, Web_Application, "Manages inventory, loans, and daily operations", "HTTPS (REST/GraphQL, TLS 1.3)")
Rel(Library_Administrators, Web_Application, "Oversees reporting and user management", "HTTPS (REST/GraphQL, TLS 1.3)")
Rel(Web_Application, API_Gateway, "Sends API requests", "HTTPS (REST/GraphQL, TLS 1.3)")
Rel(API_Gateway, Core_Services_Container, "Routes traffic to core business logic", "gRPC/HTTPS using mTLS")
Rel(API_Gateway, Search_Container, "Routes search queries", "gRPC/HTTPS using mTLS")
Rel(Core_Services_Container, PostgreSQL, "Reads and writes relational data", "TCP/gRPC with mTLS")
Rel(Core_Services_Container, Search_Container, "Indexes and queries search items", "TCP/gRPC with mTLS")
Rel(Core_Services_Container, Message_Broker, "Publishes and consumes events", "AMQP/Kafka with mTLS and SASL/SCRAM")
Rel(Core_Services_Container, Stripe_EU, "Processes payments", "HTTPS (REST)")
Rel(Core_Services_Container, SendGrid_EU, "Sends emails and notifications", "HTTPS (REST)")
Rel(Core_Services_Container, Keycloak_Auth0_EU_tenant, "Authenticates users and validates tokens", "OIDC/OAuth2")

@enduml