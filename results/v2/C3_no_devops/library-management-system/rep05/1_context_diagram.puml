@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Library Management System

Person(LibraryPatrons, "Library Patrons", "Students and public users accessing the system via self-service portals.")
Person(LibrariansCirculationStaff, "Librarians / Circulation Staff", "Personnel managing inventory, loans, and daily operations.")
Person(LibraryAdministrators, "Library Administrators", "Users overseeing reporting and user management.")

System(LibraryManagementSystem, "Library Management System", "Provides self-service portals and catalogue/circulation management for academic and public libraries, strictly enforcing EU-only data residency while delivering high-performance cataloguing and search capabilities.")

System_Ext(StripeEU, "Stripe EU", "External payment processing system restricted to EU endpoints.")
System_Ext(KeycloakAuth0EUtenant, "Keycloak/Auth0 EU tenant", "External identity and authentication provider (OAuth 2.0 / OIDC).")
System_Ext(SendGridEU, "SendGrid EU", "External notification and email delivery service restricted to EU endpoints.")

Rel(LibraryPatrons, LibraryManagementSystem, "Interact with the web/mobile app via self-service portals", "HTTPS (REST/GraphQL) over TLS 1.3")
Rel(LibrariansCirculationStaff, LibraryManagementSystem, "Manage inventory, loans, and daily operations", "HTTPS (REST/GraphQL) over TLS 1.3")
Rel(LibraryAdministrators, LibraryManagementSystem, "Oversee reporting and user management", "HTTPS (REST/GraphQL) over TLS 1.3")
Rel(LibraryManagementSystem, StripeEU, "Integrates for payment processing via EU endpoints", "HTTPS/REST")
Rel(LibraryManagementSystem, KeycloakAuth0EUtenant, "Integrates for authentication and token validation", "OAuth 2.0 / OIDC")
Rel(LibraryManagementSystem, SendGridEU, "Integrates for email and notification delivery via EU endpoints", "HTTPS/REST")

@enduml