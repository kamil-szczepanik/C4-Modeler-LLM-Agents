@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(SpringCloudGatewayRouter, "Spring Cloud Gateway Router", "Spring Cloud Gateway, Java", "Handles robust routing, edge security, and protocol translation.")
    Component(RateLimiterComponent, "Rate Limiter Component", "Redis Token Bucket", "Enforces rate limiting using low-latency in-memory data store.")
}

Rel(SpringCloudGatewayRouter, RateLimiterComponent, "Queries for rate limit enforcement", "in-memory RESP protocol over TLS")

@enduml