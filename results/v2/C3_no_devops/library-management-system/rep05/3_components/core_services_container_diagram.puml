@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Services Container container

Container_Boundary(core_services_container, "Core Services Container") {
    Component(catalogue_management, "Catalogue Management Component", "Spring Boot @Service, Java", "Provides item cataloging functionality and publishes item state changes.")
    Component(circulation, "Circulation Component", "Spring Boot @Service, Java", "Manages circulation processes and workflows for libraries.")
    Component(notification_payment_facade, "Notification & Payment Facade", "Spring Boot @Component, Java", "Handles external communications and payment processing.")
    Component(search_sync, "Search Synchronization Component", "Spring Boot @Service, Java", "Synchronizes and indexes item data into the search container.")
}

ContainerDb(postgresql, "PostgreSQL", "Database", "Relational database for data persistence")
System_Ext(message_broker, "Message Broker", "Messaging system for asynchronous events")
System_Ext(search_container, "Search Container", "Search engine for indexing and retrieval")
System_Ext(stripe_sendgrid, "Stripe EU & SendGrid EU", "External services", "Processes payments and notifications")

Rel(catalogue_management, postgresql, "Reads/writes relational data", "JDBC, mTLS")
Rel(circulation, postgresql, "Reads/writes relational data", "JDBC, mTLS")
Rel(catalogue_management, message_broker, "Publishes item state changes", "Kafka, AMQP")
Rel(search_sync, search_container, "Indexes item data", "TCP/gRPC with mTLS")
Rel(notification_payment_facade, stripe_sendgrid, "Processes payments and notifications", "HTTPS (REST)")

@enduml