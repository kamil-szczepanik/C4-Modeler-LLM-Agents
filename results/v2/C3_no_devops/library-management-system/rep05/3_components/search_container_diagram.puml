@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Search Container container

Container_Boundary(search_container, "Search Container") {
    Component(Internal_Search_Components, "Internal Search Components", "Spring Boot, Java", "Implements internal search components and API handlers.")
    Component(OpenSearch_Engine, "OpenSearch Engine", "OpenSearch, Elasticsearch", "Powers sub-second search performance (< 800ms) and faceted filtering.")
    Component(Analytics_Exporter, "Analytics Exporter", "REST, TCP, mTLS", "Polls aggregated anonymized metrics.")
}

Rel(Internal_Search_Components, OpenSearch_Engine, "Indexes and queries search items", "TCP/gRPC with mTLS")
Rel(Analytics_Exporter, OpenSearch_Engine, "Polls aggregated anonymized metrics", "REST/TCP using mTLS")

@enduml