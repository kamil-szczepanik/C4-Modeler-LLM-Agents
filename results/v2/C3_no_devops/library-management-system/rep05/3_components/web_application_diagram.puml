@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Library Patrons, Librarians, Administrators, "Library Users", "Accesses portals")
System_Ext(Keycloak/Auth0 EU tenant, "Keycloak/Auth0 EU tenant", "Identity Provider", "Authenticates users via OIDC")
System_Ext(API Gateway, "API Gateway", "API Gateway", "Backend entrypoint for REST/GraphQL requests")

Container_Boundary(Web Application, "Web Application") {
    Component(Routing & Auth Module, "Routing & Auth Module", "React Router, OIDC client", "Manages application routing and user authentication using OIDC.")
    Component(Catalogue & Search Component, "Catalogue & Search Component", "React, TanStack Query", "Handles catalogue views and server-state caching for search optimization.")
    Component(Circulation Portal Component, "Circulation Portal Component", "React", "Provides the circulation management interface for patrons and librarians.")
    Component(Localization & Accessibility Module, "Localization & Accessibility Module", "React-i18next, Aria components", "Provides multi-language support and ensures WCAG 2.1 AA compliance.")
    Component(API Client Service, "API Client Service", "Axios", "Facilitates communication with backend services via HTTP requests.")
    Component(Web Server, "Web Server", "Nginx", "Serves the single-page application and enforces security hardening via CSP and HSTS headers.")
}

Rel(Library Patrons, Librarians, Administrators, Web Application, "Accesses portals", "HTTPS, TLS 1.3")
Rel(Routing & Auth Module, Keycloak/Auth0 EU tenant, "Authenticates users", "OIDC")
Rel(API Client Service, API Gateway, "Sends REST/GraphQL API requests", "HTTPS, TLS 1.3")

@enduml