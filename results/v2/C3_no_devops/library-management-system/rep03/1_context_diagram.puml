@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Library_Patrons_Members, "Library Patrons (Members)", "Library members who interact with the self-service portals to borrow items and manage their accounts.")
Person(Librarians_Circulation_Staff, "Librarians / Circulation Staff", "Staff members who manage circulation, cataloguing, and patron assistance.")
Person(Library_Administrators, "Library Administrators", "Administrators responsible for managing system configuration, users, and overall library operations.")

System(Library_Management_System, "Library Management System", "Provides cataloguing, circulation, and self-service portals for public and academic libraries while ensuring strict EU data residency compliance and high-performance search.")

System_Ext(External_Identity_Provider_IdP, "External Identity Provider (IdP)", "External system used for authenticating users via OIDC.")
System_Ext(Third_Party_Payment_Gateway, "Third-Party Payment Gateway", "External service used for processing fines securely.")
System_Ext(Digital_Content_Repositories, "Digital Content Repositories", "External repositories used for fulfilling digital items.")

Rel(Library_Patrons_Members, Library_Management_System, "Interacts with the LMS via self-service portals", "HTTPS (TLS 1.3), OAuth 2.0 / OIDC")
Rel(Librarians_Circulation_Staff, Library_Management_System, "Interacts with the LMS for circulation and cataloguing", "HTTPS (TLS 1.3), OAuth 2.0 / OIDC")
Rel(Library_Administrators, Library_Management_System, "Interacts with the LMS for administrative tasks", "HTTPS (TLS 1.3), OAuth 2.0 / OIDC")
Rel(Library_Management_System, External_Identity_Provider_IdP, "Authenticates users", "OIDC over HTTPS")
Rel(Library_Management_System, Third_Party_Payment_Gateway, "Processes fines", "REST/HTTPS with mTLS")
Rel(Library_Management_System, Digital_Content_Repositories, "Fulfills digital items", "LTI/API")

@enduml