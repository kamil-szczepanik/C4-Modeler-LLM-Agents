@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL Database container

Container_Boundary(postgresql_database, "PostgreSQL Database") {
    Component(PgBouncer, "PgBouncer", "Connection Pooler", "Provides efficient connection pooling for database clients.")
    Component(Primary_Master, "Primary Master", "PostgreSQL", "Manages read-write transactions for circulation and catalogue data.")
    Component(Read_Replica, "Read Replica", "PostgreSQL", "Handles read-only queries to offload traffic from the primary master.")
    Component(pg_audit, "pg_audit", "PostgreSQL Extension", "Enforces detailed auditing and security logging for EU data compliance.")
}

Rel(PgBouncer, Primary_Master, "Routes read-write transactions", "TCP")
Rel(PgBouncer, Read_Replica, "Routes read-only queries", "TCP")
Rel(Primary_Master, pg_audit, "Audits transactions", "Internal")

@enduml