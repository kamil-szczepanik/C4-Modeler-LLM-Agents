@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Librarian Back-office container

System_Ext(External_Identity_Provider_IdP, "External Identity Provider (IdP)", "External Identity Provider")
System_Ext(API_Gateway, "API Gateway", "API Gateway (NGINX / Envoy)")

Container_Boundary(Librarian_Back_office, "Librarian Back-office") {
    Component(Circulation_Workspace_Component, "Circulation Workspace Component", "Next.js / React Component", "Handles circulation workflows, sends commands, and manages real-time alerts.")
    Component(Cataloguing_Management_Component, "Cataloguing Management Component", "Next.js / React Component", "Manages library asset cataloguing and uploads.")
    Component(Admin_Dashboard_Component, "Admin Dashboard Component", "Next.js / React Component", "Fetches analytics and administrative reports.")
    Component(Auth_Session_Handler_Component, "Auth Session Handler Component", "Next.js / Server Actions", "Manages OIDC authorization code flow and session storage securely.")
}

Rel(Auth_Session_Handler_Component, External_Identity_Provider_IdP, "Manages OIDC authorization code flow", "HTTPS")
Rel(Circulation_Workspace_Component, API_Gateway, "Sends commands and real-time alerts", "HTTPS/REST, WebSockets with token authentication")
Rel(Cataloguing_Management_Component, API_Gateway, "Uploads assets", "HTTPS/Multipart REST")
Rel(Admin_Dashboard_Component, API_Gateway, "Fetches analytics and reports", "HTTPS/REST")

@enduml