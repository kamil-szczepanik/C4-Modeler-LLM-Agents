@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patron Portal container

Container_Boundary(patron_portal, "Patron Portal") {
    Component(react_ui, "React.js UI SPA", "React.js", "Patron-facing views ensuring mobile responsiveness, interacting with UI via HTTPS and communicating with the BFF server.")
    Component(nodejs_bff, "Node.js BFF Server", "Node.js / Express", "Backend-for-Frontend server for secure session management, token storage using HTTP-only, SameSite Cookies, and proxying API requests.")
}

Rel(react_ui, nodejs_bff, "Communicates via SPA", "HTTPS")

@enduml