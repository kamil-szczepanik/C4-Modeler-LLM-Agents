@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalogue Service container

Container_Boundary(catalogue_service, "Catalogue Service") {
    Component(item_controller_service, "Item Controller & Service", "Java / Spring Boot, Spring Data JPA, JDBC", "Manages physical and digital item cataloguing, reading and writing catalogue data to the PostgreSQL Database with AES-256 encryption.")
    Component(search_indexing_engine, "Search & Indexing Engine", "Java / Spring Boot, Spring Data Elasticsearch", "Indexes search data and interacts with Elasticsearch to ensure high-performance search capabilities.")
    Component(facet_recommendation_service, "Facet & Recommendation Service", "Java / Spring Boot, Elasticsearch Aggregations API", "Powers faceted navigation and recommendations using Elasticsearch with AES-256 encryption.")
    Component(digital_content_adapter, "Digital Content Adapter", "Java / Spring Boot, Spring WebClient, Resilience4j", "Fulfills digital items using REST/LTI with circuit breakers for external digital content repositories.")
    Component(event_publisher, "Event Publisher", "Java / Spring Boot, Spring Cloud Stream", "Publishes domain events to the Event Broker over TLS.")
}

System_Ext(postgresql_database, "PostgreSQL Database", "Authoritative relational storage for item metadata secured with AES-256 encryption.")
System_Ext(elasticsearch, "Elasticsearch", "High-performance search and aggregation engine.")
System_Ext(event_broker, "Event Broker", "Message broker for domain events.")
System_Ext(digital_content_repositories, "Digital Content Repositories", "External systems providing digital items.")

Rel(item_controller_service, postgresql_database, "Reads and writes catalogue data", "Spring Data JPA, JDBC with AES-256 encryption")
Rel(search_indexing_engine, elasticsearch, "Indexes search data", "Spring Data Elasticsearch with AES-256 encryption")
Rel(facet_recommendation_service, elasticsearch, "Powers faceted navigation", "Elasticsearch Aggregations API with AES-256 encryption")
Rel(event_publisher, event_broker, "Publishes domain events", "Spring Cloud Stream over TLS")
Rel(digital_content_adapter, digital_content_repositories, "Fulfills digital items", "Spring WebClient over REST/LTI with Resilience4j circuit breakers")

@enduml