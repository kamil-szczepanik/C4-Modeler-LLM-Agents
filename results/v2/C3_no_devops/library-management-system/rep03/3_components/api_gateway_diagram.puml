@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(WAF_Filter, "WAF Filter", "ModSecurity", "Inspects incoming HTTP traffic for malicious patterns and protects backend services from web exploits.")
    Component(Authentication_Filter, "Authentication Filter", "Envoy Filter / JWT", "Performs JWT cryptographic verification and integrates with the External Identity Provider for user authentication.")
    Component(Rate_Limiting_Filter, "Rate Limiting Filter", "Envoy Rate Limiting", "Enforces rate limiting quotas utilizing the Distributed Cache (Redis).")
    Component(Route_Load_Balancing_Engine, "Route & Load Balancing Engine", "Envoy Engine", "Routes verified API requests to internal backend services like the Catalogue Service and Circulation Service.")
    Component(Fault_Translation_Transformation_Filter, "Fault Translation & Transformation Filter", "Envoy Filter", "Standardizes error codes, translates faults, and propagates user claims (User ID, Roles) in HTTP headers.")
}

Rel(WAF_Filter, Authentication_Filter, "Forwards inspected HTTP requests", "HTTPS")
Rel(Authentication_Filter, Rate_Limiting_Filter, "Checks request quotas against rate limits", "Redis")
Rel(Authentication_Filter, Route_Load_Balancing_Engine, "Passes authenticated requests with propagated claims", "")
Rel(Route_Load_Balancing_Engine, Fault_Translation_Transformation_Filter, "Applies fault handling and transforms outgoing/incoming payloads", "")

@enduml