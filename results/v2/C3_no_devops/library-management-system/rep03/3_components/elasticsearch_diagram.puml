@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Boundary(elasticsearch, "Elasticsearch") {
    Component(SearchEngineCore, "Search Engine Core", "Lucene", "Core search engine capability executing indexing and searching operations.")
    Component(InvertedIndexAndDocumentStore, "Inverted Index & Document Store", "Elasticsearch Storage", "Stores documents and maintains inverted indices for high-performance retrieval.")
    Component(RESTApiQueryDslInterface, "REST API / Query DSL Interface", "HTTP / JSON REST API", "Provides query DSL interface and REST endpoints for catalog and search operations.")
    Component(SearchAnalyticsAndLoggingEngine, "Search Analytics & Logging Engine", "Elasticsearch Analytics", "Collects and exports search analytics, metrics, and logs.")
}

System_Ext(CatalogueService, "Catalogue Service", "External service calling the Elasticsearch container")
System_Ext(EventBroker, "Event Broker", "External event broker receiving analytics and logs")

Rel(CatalogueService, RESTApiQueryDslInterface, "Executes search & indexing requests over HTTPS with mTLS (TLS 1.3)", "HTTPS / mTLS")
Rel(SearchAnalyticsAndLoggingEngine, EventBroker, "Exports metrics via Filebeat / OpenTelemetry over TLS 1.3 with mTLS", "TLS 1.3 / mTLS")

@enduml