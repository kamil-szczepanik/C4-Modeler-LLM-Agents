@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Event Broker container

Container_Boundary(event_broker, "Event Broker") {
    Component(SchemaRegistry, "Schema Registry", "Schema Registry / Avro", "Validates payload schemas on ingestion and enforces backward compatibility and security.")
    Component(KafkaStreamsPIITokenizationApp, "Kafka Streams PII Tokenization App", "Kafka Streams", "Performs real-time PII tokenization and data masking for GDPR compliance.")
    Component(TieredStorageManager, "Tiered Storage Manager", "S3-compatible storage", "Offloads historical segments to encrypted EU-hosted storage.")
}

Rel(KafkaTopics, SchemaRegistry, "Validates payload schemas on ingestion", "HTTPS")
Rel(KafkaStreams, Elasticsearch, "Streams masked projections", "Kafka Connect, TLS")
Rel(EventBroker, TieredStorageManager, "Offloads historical segments", "Encrypted storage")
@enduml