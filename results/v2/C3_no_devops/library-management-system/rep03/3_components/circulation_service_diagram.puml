@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Circulation Service container

System_Ext(api_gateway, "API Gateway", "API Gateway")
System_Ext(postgresql_database, "PostgreSQL Database", "PostgreSQL Database")
System_Ext(apache_kafka_event_broker, "Apache Kafka Event Broker", "Apache Kafka Event Broker")
System_Ext(third_party_payment_gateway, "Third-Party Payment Gateway", "Third-Party Payment Gateway")

Container_Boundary(circulation_service, "Circulation Service") {
    Component(CirculationAPIController, "Circulation API Controller", "Express.js", "Routes circulation requests received from the API Gateway.")
    Component(LoanManagementEngine, "Loan Management Engine", "TypeScript / Domain Services with BullMQ", "Handles strongly typed domain logic for loans and automated grace periods.")
    Component(FinePaymentManager, "Fine & Payment Manager", "Node.js Service with Payment Webhook Handler", "Processes fines and handles payment webhook interactions.")
    Component(EventPublisher, "Event Publisher", "KafkaJS Client", "Publishes check-out and reminder events to the event broker.")
    Component(DataAccessRepository, "DataAccess Repository", "Prisma ORM", "Persists circulation data ensuring secure data access and EU residency compliance.")
    Component(NotificationSchedulerComponent, "Notification Scheduler Component", "node-cron / BullMQ", "Manages background scheduling for automated notifications.")
}

Rel(api_gateway, CirculationAPIController, "Routes circulation requests", "mTLS via Istio Service Mesh")
Rel(DataAccessRepository, postgresql_database, "Persists circulation data", "AES-256 encryption, EU-hosted")
Rel(EventPublisher, apache_kafka_event_broker, "Publishes check-out and reminder events", "TLS-encrypted event streams")
Rel(FinePaymentManager, third_party_payment_gateway, "Processes fines", "REST/HTTPS with mTLS and HMAC webhook verification")

@enduml