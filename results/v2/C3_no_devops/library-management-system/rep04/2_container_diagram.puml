@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(Patron, "Library Patron", "A library user who accesses self-service portals to borrow and manage items.")
Person(Staff, "Librarian/Circulation Staff", "Staff members who manage circulation, cataloguing, and library operations.")
Person(Admin, "Library Administrator", "Administrators responsible for managing the system configuration and oversight.")

System_Ext(IdP, "Identity Provider (IdP)", "Handles authentication for users and staff.")
System_Ext(Payment, "Payment Gateway", "Processes fines and payments.")
System_Ext(Notification, "Notification Service", "Sends alerts and notifications.")
System_Ext(ILL, "Inter-Library Loan (ILL) Network", "Enables sharing and borrowing of items across external consortiums.")

System_Boundary(LMS, "Library Management System") {
    Container(APIGateway, "API Gateway", "Nginx/Kong", "Centralized ingress, routing, and OAuth 2.0 validation.")
    Container(PatronPortal, "Patron Portal", "React SPA", "Self-service patron portal frontend.")
    Container(StaffDashboard, "Staff Dashboard", "Angular SPA", "Staff dashboard frontend for circulation and operations.")
    Container(CoreService, "Core Circulation & Cataloguing Service", "Spring Boot", "Handles core circulation workflows and strict ACID transaction compliance.")
    Container(SearchService, "Search Service", "Elasticsearch", "Provides sub-800ms search response times.")
    Container(IntegrationService, "Integration Service", "Node.js", "Handles asynchronous external API payloads with external systems.")
    Container(NotificationWorker, "Notification Worker", "Python/Celery", "Asynchronous background task processing for notifications.")
    Container(ReportingService, "Reporting Service", "Python/FastAPI", "Generates reports and analytics.")
    
    ContainerDb(Postgres, "PostgreSQL", "PostgreSQL", "Primary relational database with column-level encryption.")
    ContainerDb(PostgresReplica, "PostgreSQL Read Replica", "PostgreSQL", "Read replica used for analytics and reporting.")
    ContainerDb(RabbitMQ, "RabbitMQ", "RabbitMQ", "Message broker for asynchronous background task processing.")
}

Rel(Patron, PatronPortal, "Accesses self-service portal", "HTTPS (TLS 1.3)")
Rel(Staff, StaffDashboard, "Accesses staff dashboard", "HTTPS (TLS 1.3)")
Rel(Admin, StaffDashboard, "Administers system via dashboard", "HTTPS (TLS 1.3)")

Rel(PatronPortal, APIGateway, "Makes API requests", "HTTPS (TLS 1.3)")
Rel(StaffDashboard, APIGateway, "Makes API requests", "HTTPS (TLS 1.3)")

Rel(APIGateway, CoreService, "Routes circulation requests", "gRPC/REST over TLS 1.3")
Rel(APIGateway, SearchService, "Routes search queries", "gRPC/REST over TLS 1.3")

Rel(CoreService, Postgres, "Persists transactional data", "JDBC (TLS 1.3)")
Rel(Postgres, PostgresReplica, "Asynchronous replication", "Asynchronous Replication")

Rel(IntegrationService, IdP, "Authenticates via IdP", "REST/Webhooks over mTLS")
Rel(IntegrationService, Payment, "Processes payments", "REST/Webhooks over mTLS")
Rel(IntegrationService, Notification, "Sends notifications", "REST/Webhooks over mTLS")
Rel(IntegrationService, ILL, "Manages inter-library loans", "REST/Webhooks over mTLS")

Rel(NotificationWorker, RabbitMQ, "Consumes background tasks", "AMQP over TLS 1.3")

Rel(StaffDashboard, ReportingService, "Requests reports and analytics", "REST/JSON over mTLS")
Rel(ReportingService, PostgresReplica, "Queries analytics data", "SQL over mTLS")

@enduml