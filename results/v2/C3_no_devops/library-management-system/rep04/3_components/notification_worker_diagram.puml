@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification Worker container

Container_Boundary(notification_worker, "Notification Worker") {
    Component(TaskConsumerComponent, "Task Consumer Component", "Python & Celery", "Celery Worker Core for asynchronous background task processing and consumer management.")
    Component(NotificationDispatcherComponent, "Notification Dispatcher Component", "Python, Pydantic, HashiCorp Vault", "Invokes processing logic, sanitizes payloads, and dispatches alerts using securely injected API keys.")
    Component(DeliveryAuditComponent, "Delivery Audit Component", "SQLAlchemy", "Persists delivery state and audit trails with least-privilege roles.")
}

Component(RabbitMQMessageBroker, "RabbitMQ Message Broker", "RabbitMQ", "External message broker supplying background tasks via AMQP.")
Component(PostgreSQLDatabase, "PostgreSQL Database", "PostgreSQL", "Persists audit trails securely.")
Component(ExternalNotificationServices, "External Notification Services", "Email/SMS gateways", "External gateways for dispatching alerts to patrons and staff.")

Rel(TaskConsumerComponent, RabbitMQMessageBroker, "Consumes background tasks", "AMQP over TLS 1.3 with mTLS/SASL-SCRAM")
Rel(TaskConsumerComponent, NotificationDispatcherComponent, "Invokes processing logic", "In-memory function call")
Rel(NotificationDispatcherComponent, DeliveryAuditComponent, "Persists delivery state", "SQL over TLS")
Rel(DeliveryAuditComponent, PostgreSQLDatabase, "Persists audit trails with least-privilege roles", "SQL over TLS 1.3")
Rel(NotificationDispatcherComponent, ExternalNotificationServices, "Dispatches alerts", "TLS 1.3 with certificate pinning")

@enduml