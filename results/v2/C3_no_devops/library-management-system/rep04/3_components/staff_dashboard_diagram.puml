@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(staff_dashboard, "Staff Dashboard") {
    Component(Staff_Dashboard, "Staff Dashboard", "Angular SPA Container", "Provides the user interface for library staff and administrators.")
    Component(Circulation_Module, "Circulation Module", "Angular Feature Module", "Handles checkouts, returns, and circulation operations.")
    Component(Catalogue___Inventory_Module, "Catalogue & Inventory Module", "Angular Component", "Manages book cataloguing, searching, and inventory status.")
    Component(Admin___Reporting_Module, "Admin & Reporting Module", "Angular Component", "Provides system administration and reporting capabilities.")
    Component(API_Client_Service, "API Client Service", "Angular Service", "Communicates with backend services via the API Gateway.")
}

Rel(Staff_Dashboard, Circulation_Module, "Loads", "")
Rel(Staff_Dashboard, Catalogue___Inventory_Module, "Loads", "")
Rel(Staff_Dashboard, Admin___Reporting_Module, "Loads", "")
Rel(Circulation_Module, API_Client_Service, "Uses", "")
Rel(Catalogue___Inventory_Module, API_Client_Service, "Uses", "")
Rel(Admin___Reporting_Module, API_Client_Service, "Uses", "")

@enduml