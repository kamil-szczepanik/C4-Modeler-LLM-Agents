@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Circulation & Cataloguing Service container

Container_Boundary(core_circulation_cataloguing_service, "Core Circulation & Cataloguing Service") {
    Component(Security_Context_Interceptor, "Security Context Interceptor", "Spring Boot Interceptor", "Delegates validated execution contexts and forwards authenticated requests.")
    Component(Circulation_Engine, "Circulation Engine", "Spring Boot Service", "Manages loans, fines, inventory check-outs, and applies pessimistic locking.")
    Component(Cataloguing_Manager, "Cataloguing Manager", "Spring Boot Service", "Manages library inventories and metadata.")
    Component(Transaction_Event_Publisher, "Transaction Event Publisher", "Spring AMQP", "Publishes signed domain events like ItemCheckedOut to the message broker.")
}

System_Ext(PostgreSQL, "PostgreSQL", "Persists transactional state and applies pessimistic locking")
System_Ext(RabbitMQ, "RabbitMQ", "Publishes signed domain events like ItemCheckedOut")

Rel(Security_Context_Interceptor, Circulation_Engine, "Delegates validated execution contexts", "In-process method calls")
Rel(Security_Context_Interceptor, Cataloguing_Manager, "Delegates validated execution contexts", "In-process method calls")
Rel(Circulation_Engine, PostgreSQL, "Persists transactional state and applies pessimistic locking", "JDBC over TLS 1.3")
Rel(Transaction_Event_Publisher, RabbitMQ, "Publishes signed domain events like ItemCheckedOut", "AMQP over TLS 1.3")

@enduml