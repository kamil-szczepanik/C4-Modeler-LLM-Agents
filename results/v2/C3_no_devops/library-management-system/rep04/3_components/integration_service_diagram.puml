@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(integration_service, "Integration Service") {
    Component(webhook_ingress, "Webhook Ingress & Reconciliation Controller", "Express.js", "Handles incoming webhooks and reconciliation requests from external systems.")
    Component(outbound_sync_worker, "Outbound Sync Worker", "BullMQ", "Manages asynchronous outbox message processing and synchronization queues.")
    Component(external_adapter_layer, "External Adapter Layer", "Axios with opossum", "Interfaces with external systems using circuit breakers for resilience.")
    Component(transaction_state_repository, "Transaction State Repository", "Prisma/Knex", "Persists transaction states and integration data.")
    Component(secrets_management, "Secrets Management", "HashiCorp Vault", "Secures and manages credentials, tokens, and encryption keys.")
}

Rel(webhook_ingress, transaction_state_repository, "Persists transaction state", "")
Rel(outbound_sync_worker, external_adapter_layer, "Triggers outbound calls using", "")
Rel(external_adapter_layer, secrets_management, "Retrieves credentials from", "")

@enduml