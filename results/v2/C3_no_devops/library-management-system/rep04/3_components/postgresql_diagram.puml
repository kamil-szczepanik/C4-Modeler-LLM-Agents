@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(postgresql, "PostgreSQL") {
    Component(PgBouncerConnectionPooler, "PgBouncer Connection Pooler", "PgBouncer, TLS 1.3", "Connection pooling with TLS 1.3 termination to mitigate handshake latency.")
    Component(PostgreSQL16PrimaryDatabase, "PostgreSQL 16 Primary Database", "PostgreSQL 16, Table Partitioning, Row-Level Security, pgaudit", "Primary database satisfying EU-only data residency, GDPR compliance, and auditability.")
    Component(PostgreSQLReadReplica, "PostgreSQL Read Replica", "PostgreSQL", "Read replica for executing aggregated analytical queries.")
    Component(EUResidentObjectStore, "EU-Resident Object Store", "Object Store", "Continuous Write-Ahead Log (WAL) archiving for Point-In-Time Recovery (PITR).")
}

Rel(PgBouncerConnectionPooler, PostgreSQL16PrimaryDatabase, "Routes transactional queries", "JDBC over mTLS / TLS 1.3")
Rel(PostgreSQL16PrimaryDatabase, PostgreSQLReadReplica, "Asynchronous replication", "Encrypted Replication Stream")
Rel(PostgreSQL16PrimaryDatabase, EUResidentObjectStore, "Continuous WAL archiving for PITR")

@enduml