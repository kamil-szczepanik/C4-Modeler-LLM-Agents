@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the RabbitMQ container

Person(Core Circulation Service, "Core Circulation Service", "Interacting microservice")
Person(Integration Service, "Integration Service", "Interacting microservice")
Person(Notification Worker, "Notification Worker", "Interacting microservice")

Container_Boundary(RabbitMQ, "RabbitMQ") {
    Component(Notification Queue, "Notification Queue", "Quorum Queue", "Reliable storage for background tasks and notifications ensuring zero data loss.")
    Component(Audit & Analytics Queue, "Audit & Analytics Queue", "Quorum Queue", "Durable queue implementation for guaranteed message persistence in EU-bound volumes.")
    Component(Exchange (Direct/Topic), "Exchange (Direct/Topic)", "Erlang-based Message Router", "Routes domain and integration events across the messaging infrastructure.")
    Component(Audit Topic Exchange, "Audit Topic Exchange", "Erlang-based Message Router", "Routes audit and analytics messages securely within the broker.")
    Component(Dead-Letter Exchange (DLX), "Dead-Letter Exchange (DLX)", "RabbitMQ Exchange", "Failed delivery capture component for handling undeliverable messages.")
}

Rel(Core Circulation Service, Exchange (Direct/Topic), "Publishes domain events", "AMQP 0-9-1 over TLS 1.3")
Rel(Integration Service, Exchange (Direct/Topic), "Publishes integration events", "AMQP 0-9-1 over TLS 1.3")
Rel(Notification Worker, Notification Queue, "Consumes background tasks", "AMQP over TLS 1.3")

@enduml