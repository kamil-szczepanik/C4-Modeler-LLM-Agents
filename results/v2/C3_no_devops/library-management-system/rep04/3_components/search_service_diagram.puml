@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("search_service", "Search Service") {
    Component("Search API Controller", "Search API Controller", "Spring Boot / REST", "Validates JWTs and maps requests to Search Profiles.")
    Component("Query Processor", "Query Processor", "Java Service", "Executes parameterized Elasticsearch Query DSL with Field-Level Security.")
    Component("Indexing Consumer", "Indexing Consumer", "RabbitMQ Consumer", "Consumes domain events via AMQPS with mTLS for item synchronization.")
}

System_Ext("Search Index", "Search Index", "Elasticsearch instance for catalogue discovery")
System_Ext("RabbitMQ", "RabbitMQ", "Event broker for domain events")

Rel("Search API Controller", "Query Processor", "Validates JWTs and maps requests to Search Profiles", "Internal")
Rel("Query Processor", "Search Index", "Executes parameterized Elasticsearch Query DSL with Field-Level Security", "Elasticsearch Query DSL")
Rel("Indexing Consumer", "RabbitMQ", "Consumes domain events via AMQPS with mTLS", "AMQPS")

@enduml