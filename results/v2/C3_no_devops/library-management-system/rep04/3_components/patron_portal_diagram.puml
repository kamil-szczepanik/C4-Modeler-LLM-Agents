@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patron Portal container

Person(LibraryPatron, "Library Patron", "Library member accessing self-service features.")
System_Ext(IdentityProvider, "Identity Provider", "Handles authentication and issues OIDC tokens.")
System_Ext(CoreCirculationService, "Core Circulation Service", "Manages loans and patron preferences.")
System_Ext(SearchService, "Search Service", "Provides item catalog search capabilities.")
System_Ext(PaymentGateway, "Payment Gateway", "Processes secure financial transactions.")

Container_Boundary(PatronPortal, "Patron Portal") {
    Component(AuthSessionManager, "Authentication & Session Manager", "React / HttpOnly Cookies", "Manages OIDC tokens and secures refresh tokens against XSS vulnerabilities.")
    Component(AccountLoanDashboard, "Account & Loan Dashboard", "React SPA / Material-UI / Radix UI", "Manages loans and preferences, providing a modern, mobile-responsive self-accessible frontend interface with WCAG 2.1 AA compliance.")
    Component(CatalogSearchInterface, "Catalog & Search Interface", "React SPA / GraphQL", "Queries the item catalog and ensures sub-800ms search responses.")
    Component(BillingPaymentWidget, "Billing & Payment Widget", "React SDK / Payment Gateway SDK", "Processes self-service fine settlements and maintains PCI-DSS compliance.")
}

Rel(LibraryPatron, AccountLoanDashboard, "Accesses self-service portal", "HTTPS (TLS 1.3)")
Rel(AuthSessionManager, IdentityProvider, "Manages OIDC tokens", "HTTPS/OIDC")
Rel(AccountLoanDashboard, CoreCirculationService, "Manages loans and preferences", "REST/JSON, HTTPS")
Rel(CatalogSearchInterface, SearchService, "Queries item catalog", "GraphQL/HTTPS")
Rel(BillingPaymentWidget, PaymentGateway, "Processes self-service fine settlements", "HTTPS/SDK")

@enduml