@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL Read Replica container

Container_Boundary(postgresql_read_replica, "PostgreSQL Read Replica") {
    Component(postgresql_engine, "PostgreSQL Engine (Read-Only)", "PostgreSQL 15+", "Provides native streaming replication and read-only database capabilities for analytical queries.")
    Component(streaming_replication_receiver, "Streaming Replication Receiver", "PostgreSQL Binary Streaming", "Receives asynchronous replication data via TCP with mTLS from the Primary PostgreSQL.")
    Component(connection_pooler, "Connection Pooler", "PgBouncer", "Manages analytical connection spikes and prevents connection exhaustion.")
    Component(wal_replayer, "Write-Ahead Log (WAL) Replayer", "PostgreSQL Process", "Applies incoming WAL segments to maintain the read-only database state.")
    Component(prometheus_exporter, "Prometheus PostgreSQL Exporter", "Prometheus Exporter", "Exposes database performance and replication lag metrics.")
}

Rel(streaming_replication_receiver, wal_replayer, "Feeds WAL data")
Rel(wal_replayer, postgresql_engine, "Updates database state")
Rel(connection_pooler, postgresql_engine, "Routes analytical queries")
Rel(prometheus_exporter, postgresql_engine, "Scrapes metrics")

@enduml