@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

System_Ext(Patron_Portal, "Patron Portal", "Client application")
System_Ext(Staff_Dashboard, "Staff Dashboard", "Client application")
System_Ext(Identity_Provider, "Identity Provider", "IdP")
System_Ext(Core_Circulation_Cataloguing_Service, "Core Circulation & Cataloguing Service", "Spring Boot")
System_Ext(Search_Service, "Search Service", "Elasticsearch")
System_Ext(Reporting_Service, "Reporting Service", "Python/FastAPI")

Container_Boundary(api_gateway_boundary, "API Gateway") {
    Component(API_Gateway, "API Gateway", "Kong configured with Redis", "Serves as the entry point for API requests from the Patron Portal and Staff Dashboard.")
    Component(Routing_Engine, "Routing Engine", "Lua/Kong Router", "Proxies requests to internal services securely.")
    Component(Authentication_Authorization_Plugin, "Authentication & Authorization Plugin", "OAuth2/JWT", "Validates JWT tokens against the Identity Provider.")
    Component(Rate_Limiting_Throttling_Module, "Rate Limiting & Throttling Module", "Redis-backed", "Protects availability and supports performance goals via rate-limiting.")
    Component(SSL_Termination_Module_with_WAF_OWASP_Core_Rule_Set, "SSL Termination Module with WAF / OWASP Core Rule Set", "OpenSSL/Nginx core", "Provides perimeter WAF protection and SSL termination.")
    Component(Analytics_Transformation_Plugin, "Analytics & Transformation Plugin", "Lua/Kong", "Publishes anonymized usage metrics to the Reporting Service.")
}

Rel(Patron_Portal, API_Gateway, "Makes API requests", "HTTPS (TLS 1.3)")
Rel(Staff_Dashboard, API_Gateway, "Makes API requests", "HTTPS (TLS 1.3)")
Rel(API_Gateway, Authentication_Authorization_Plugin, "Validates JWT tokens", "")
Rel(Routing_Engine, Core_Circulation_Cataloguing_Service, "Proxies requests", "gRPC over mTLS")
Rel(Routing_Engine, Search_Service, "Proxies search queries", "gRPC over mTLS")
Rel(Analytics_Transformation_Plugin, Reporting_Service, "Publishes anonymized usage metrics", "HTTP/REST over TLS 1.3")
Rel(API_Gateway, Identity_Provider, "Validates JWT tokens", "HTTPS")

@enduml