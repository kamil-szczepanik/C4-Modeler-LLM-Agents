@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Library_Patron_Member, "Library Patron (Member)", "A library user who accesses self-service portals to borrow and manage items.")
Person(Librarian_Circulation_Staff, "Librarian / Circulation Staff", "Staff members who manage circulation, cataloguing, and library operations with mandatory MFA.")
Person(Library_Administrator, "Library Administrator", "Administrators responsible for managing the system configuration and oversight.")

System(Library_Management_System, "Library Management System", "A cloud-native enterprise solution that enables public and academic libraries to catalogue physical and digital items, manage circulation, and provide self-service portals with EU-only data residency.")

System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "Handles authentication for users and staff using OIDC / OAuth2.")
System_Ext(Payment_Gateway, "Payment Gateway", "Processes fines and payments via HTTPS/REST.")
System_Ext(Notification_Service, "Notification Service", "Sends alerts and notifications to patrons via HTTPS/SMTP.")
System_Ext(Inter_Library_Loan_ILL_Network, "Inter-Library Loan (ILL) Network", "Enables sharing and borrowing of items across regional consortium APIs.")

Rel(Library_Patron_Member, Library_Management_System, "Accesses web/mobile client UI for self-service portal", "HTTPS via TLS 1.3")
Rel(Librarian_Circulation_Staff, Library_Management_System, "Manages circulation and cataloguing via web/mobile client UI", "HTTPS via TLS 1.3")
Rel(Library_Administrator, Library_Management_System, "Administers the system via web/mobile client UI", "HTTPS via TLS 1.3")
Rel(Library_Management_System, Identity_Provider_IdP, "Authenticates users and staff", "OIDC / OAuth2")
Rel(Library_Management_System, Payment_Gateway, "Processes patron fines", "HTTPS/REST")
Rel(Library_Management_System, Notification_Service, "Sends alerts and notifications to patrons", "HTTPS/SMTP")
Rel(Library_Management_System, Inter_Library_Loan_ILL_Network, "Connects with regional consortium APIs for loans", "HTTPS REST/SOAP with mTLS and OAuth2 client credentials")

@enduml