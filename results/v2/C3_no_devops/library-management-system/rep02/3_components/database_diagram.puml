@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database container

Container_Boundary("Database", "Database") {
    Component("Managed_SQL_Database", "Managed SQL Database", "PostgreSQL with automated table partitioning", "Stores library system data, user information, and catalog records with EU hosting and ACID compliance.")
    Component("Connection_Pooler", "Connection Pooler", "PgBouncer", "Manages database connections to prevent exhaustion under peak loads.")
    Component("Schema_Versioning", "Schema Versioning", "Flyway", "Handles database schema versioning integrated into the CI/CD pipeline.")
    Component("Compliance_Auditing", "Compliance Auditing", "pgaudit", "PostgreSQL extension for compliance auditing and PII tracking.")
}

Rel("Connection_Pooler", "Managed_SQL_Database", "Proxies and pools database connections")
Rel("Schema_Versioning", "Managed_SQL_Database", "Applies schema migrations")
Rel("Compliance_Auditing", "Managed_SQL_Database", "Monitors and logs database activity and PII access")

@enduml