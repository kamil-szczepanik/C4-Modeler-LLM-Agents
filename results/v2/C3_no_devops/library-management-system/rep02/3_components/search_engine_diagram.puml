@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Search Engine container

Container_Boundary(search_engine, "Search Engine") {
    Component(QueryRouterParserComponent, "Query Router & Parser Component", "Java/Spring", "Handles query routing, validation, and security enforcement.")
    Component(TextAnalysisPipelineComponent, "Text Analysis Pipeline Component", "OpenSearch Analysis Modules", "Processes text through analysis modules for localized discovery.")
    Component(SearchIndexComponent, "Search Index Component", "Apache Lucene", "Underlying storage and indexing engine for sub-800ms retrieval.")
    Component(AnalyticsEmitterComponent, "Analytics Emitter Component", "Java/Spring", "Emits telemetry events for analytics.")
}

Rel(QueryRouterParserComponent, TextAnalysisPipelineComponent, "In-memory tokenization")
Rel(TextAnalysisPipelineComponent, SearchIndexComponent, "Internal Lucene query execution")
@enduml