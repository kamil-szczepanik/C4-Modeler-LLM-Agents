@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Business Services container

Container_Boundary(core_business_services, "Core Business Services") {
    Component(SearchOrchestratorComponent, "Search Orchestrator Component", "Java / Spring WebFlux", "Reactive component for non-blocking search aggregation providing sub-second search performance.")
    Component(CirculationEngineComponent, "Circulation Engine Component", "Java / Spring Boot with Spring Data JPA", "Manages loans, fines, and transactional safety for library circulation.")
    Component(FulfillmentReservationComponent, "Fulfillment & Reservation Component", "Java / Spring Boot", "Manages waitlists and hold expirations for library items.")
    Component(IntegrationComponent, "Integration Component", "Spring Integration", "Handles asynchronous event streams and messaging.")
}

Rel(SearchOrchestratorComponent, CirculationEngineComponent, "Coordinates search queries and inventory data", "Internal / In-Memory")
Rel(CirculationEngineComponent, FulfillmentReservationComponent, "Updates hold and reservation statuses", "Internal / In-Memory")
Rel(IntegrationComponent, SearchOrchestratorComponent, "Streams asynchronous events for indexing", "Spring Integration")

@enduml