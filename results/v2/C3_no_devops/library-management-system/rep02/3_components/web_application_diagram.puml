@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application container

System_Ext(api_gateway, "API Gateway", "NGINX / Spring Cloud Gateway")

Container_Boundary(web_application, "Web Application") {
    Component(routing_component, "Routing & View Controller Component", "React Router", "Handles lazy-loaded view rendering and role-based UI structures.")
    Component(state_component, "State & Synchronization Manager Component", "Redux Toolkit + IndexedDB", "Manages local state and offline resilience with Web Crypto API encryption.")
    Component(api_client_component, "API Client Component", "Axios / Fetch + WebSockets", "Facilitates secure backend communication with OAuth 2.0 token injection.")
    Component(theme_component, "Theme & Localization Manager Component", "React/TypeScript", "Manages UI themes and internationalization.")
    Component(telemetry_component, "Telemetry Client Component", "React/TypeScript", "Collects and sends client-side telemetry and monitoring data.")
}

Rel(routing_component, state_component, "Reads and writes local application state")
Rel(routing_component, theme_component, "Applies themes and localized text")
Rel(state_component, api_client_component, "Synchronizes offline data with backend")
Rel(api_client_component, api_gateway, "Forwards user requests", "HTTPS / REST and WebSockets")

@enduml