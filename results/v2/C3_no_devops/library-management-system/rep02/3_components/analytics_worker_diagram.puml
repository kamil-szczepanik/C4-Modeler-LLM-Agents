@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Analytics Worker container

Container_Boundary(analytics_worker, "Analytics Worker") {
    Component(Event_Consumer_Component, "Event Consumer Component", "Python / Spring + Apache Kafka", "Streams business events and passes validated event payloads.")
    Component(Aggregation_Engine_Component, "Aggregation Engine Component", "Python / Spring", "Passes validated event payloads and transfers structured metric payloads.")
    Component(Analytics_Datastore_Writer_Component, "Analytics Datastore Writer Component", "Python / Spring", "Transfers structured metric payloads and persists aggregated reporting metrics to the database.")
}

Rel(Event_Consumer_Component, Aggregation_Engine_Component, "Passes validated event payloads", "In-memory")
Rel(Aggregation_Engine_Component, Analytics_Datastore_Writer_Component, "Transfers structured metric payloads", "In-memory / Method Call")

@enduml