@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(LibraryMemberPatron, "Library Member (Patron)", "End-user accessing the self-service portal.")
Person(LibrarianLibraryStaff, "Librarian / Library Staff", "Operational staff managing circulation and inventory.")
Person(LibraryAdministrator, "Library Administrator", "Management personnel handling configuration and reporting.")

System_Ext(PaymentGateway, "Payment Gateway", "External SaaS (Stripe EU / Adyen) for fines and fees.")
System_Ext(DigitalContentProviders, "Digital Content Providers", "External APIs for e-book and digital catalog syncing.")
System_Ext(NotificationSystem, "Notification System", "External communication provider (SendGrid EU) for automated alerts.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(WebApp, "Web Application", "React/TypeScript SPA with IndexedDB/Service Workers", "Provides cataloging, circulation management, and self-service portals.")
    Container(ApiGateway, "API Gateway", "NGINX / Spring Cloud Gateway, OAuth 2.0 / OpenID Connect with JWT", "Routes and secures incoming requests.")
    Container(CoreBusinessServices, "Core Business Services", "Java with Spring Boot", "Executes core business logic and circulation management.")
    Container(SearchEngine, "Search Engine", "Elasticsearch / OpenSearch cluster", "Provides high-performance search capabilities with <800ms response.")
    ContainerDb(Database, "Database", "PostgreSQL managed service (EU-hosted)", "Stores persistent application data ensuring EU data residency.")
    Container(AnalyticsWorker, "Analytics Worker", "Python/Spring + Apache Kafka/RabbitMQ", "Processes event streaming and analytics workloads.")
}

Rel(LibraryMemberPatron, WebApp, "Accesses self-service portal for browsing and account management", "HTTPS / REST and WebSockets")
Rel(LibrarianLibraryStaff, WebApp, "Manages circulation and inventory via web UI", "HTTPS / REST and WebSockets")
Rel(LibraryAdministrator, WebApp, "Handles system configuration and reporting via web UI", "HTTPS / REST and WebSockets")

Rel(WebApp, ApiGateway, "Sends user requests to backend services", "HTTPS / REST and WebSockets")

Rel(ApiGateway, CoreBusinessServices, "Forwards core API requests", "gRPC / internal REST with mTLS")
Rel(ApiGateway, SearchEngine, "Queries search index", "gRPC / internal REST with mTLS")

Rel(CoreBusinessServices, Database, "Reads and writes business data", "Secure PostgreSQL protocol")
Rel(CoreBusinessServices, AnalyticsWorker, "Streams business events", "Apache Kafka / RabbitMQ with mTLS")
Rel(CoreBusinessServices, PaymentGateway, "Processes fines and fees", "HTTPS/REST with tokenization")
Rel(CoreBusinessServices, DigitalContentProviders, "Syncs e-book and digital catalogs", "OAuth2 and mTLS over HTTPS")
Rel(CoreBusinessServices, NotificationSystem, "Sends automated alerts", "HTTPS/REST with mTLS")

@enduml