@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Library_Member_Patron, "Library Member (Patron)", "End-user accessing the self-service portal.")
Person(Librarian_Library_Staff, "Librarian / Library Staff", "Operational staff managing circulation and inventory.")
Person(Library_Administrator, "Library Administrator", "Management personnel handling configuration and reporting.")

System(Library_Management_System, "Library Management System", "A comprehensive platform for public and academic libraries to catalogue physical and digital items, manage circulation, and provide self-service portals, guaranteeing strict EU-only data residency and high-performance search capabilities.")

System_Ext(Payment_Gateway, "Payment Gateway", "External SaaS (Stripe EU / Adyen) for fines and fees.")
System_Ext(Digital_Content_Providers, "Digital Content Providers", "External APIs for e-book and digital catalog syncing.")
System_Ext(Notification_System, "Notification System", "External communication provider (SendGrid EU) for automated alerts.")

Rel(Library_Member_Patron, Library_Management_System, "Accesses self-service portal for browsing and account management", "HTTPS (TLS 1.3)")
Rel(Librarian_Library_Staff, Library_Management_System, "Manages circulation and inventory", "HTTPS (TLS 1.3)")
Rel(Library_Administrator, Library_Management_System, "Handles system configuration and reporting", "HTTPS (TLS 1.3)")
Rel(Library_Management_System, Payment_Gateway, "Processes fines and fees securely", "HTTPS/REST with tokenization")
Rel(Library_Management_System, Digital_Content_Providers, "Syncs e-book and digital catalogs", "OAuth2 and mTLS over HTTPS")
Rel(Library_Management_System, Notification_System, "Sends automated emails and SMS", "HTTPS/REST with mTLS")

@enduml