@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Business Service container

Container_Boundary("Core Business Service", "Core Business Service") {
    Component("Cataloging Component", "Cataloging Component", "Spring Data JPA", "Manages physical and digital item inventories.")
    Component("Circulation Component", "Circulation Component", "JDBC", "Handles lending, returns, and holds logic.")
    Component("Event Publisher Component", "Event Publisher Component", "Spring Events, RabbitMQ", "Decouples domain events.")
    Component("Policy Evaluation Component", "Policy Evaluation Component", "Java", "Evaluates variable institutional loan policies and rules.")
    Component("Catalog Indexer Component", "Catalog Indexer Component", "Elasticsearch client", "Pushes asynchronous inventory updates to Elasticsearch.")
}

System_Ext("Database (PostgreSQL)", "Database (PostgreSQL)", "Relational database")
System_Ext("Message Broker (RabbitMQ)", "Message Broker (RabbitMQ)", "Message broker")
System_Ext("Search Service (Elasticsearch)", "Search Service (Elasticsearch)", "Search and analytics engine")
System_Ext("Audit Logging Service", "Audit Logging Service", "Audit logging system")

Rel("Cataloging Component", "Database (PostgreSQL)", "Reads and writes data", "JDBC")
Rel("Circulation Component", "Database (PostgreSQL)", "Reads and writes data", "JDBC")
Rel("Event Publisher Component", "Message Broker (RabbitMQ)", "Publishes asynchronous events", "AMQP")
Rel("Catalog Indexer Component", "Search Service (Elasticsearch)", "Updates search indices", "AMQP")
Rel("Event Publisher Component", "Audit Logging Service", "Emits structured security events synchronously", "REST/HTTPS")

@enduml