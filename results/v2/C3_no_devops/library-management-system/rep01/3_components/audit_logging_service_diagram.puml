@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit Logging Service container

System_Ext(MessageBroker, "Message Broker", "External message broker system")
Person(ComplianceOfficers, "Compliance Officers", "Compliance officers querying and exporting audit logs")

Container_Boundary(AuditLoggingService, "Audit Logging Service") {
    Component(IngestAPIHandler, "Ingest API Handler", "Go (Fiber or Gin)", "Ingests audit log events via AMQP/JSON with mTLS.")
    Component(EventNormalizerEnricher, "Event Normalizer & Enricher", "Go", "Normalizes and enriches audit log events.")
    Component(LogIntegrityVerifier, "Log Integrity Verifier", "Go with SHA-256 Merkle Trees", "Verifies log integrity and tamper-evidence.")
    Component(WORMStorageAdapter, "WORM Storage Adapter", "Go, AWS S3 Object Lock API, SSE-KMS", "Interfaces with WORM storage to ensure immutability and EU data residency.")
    Component(QueryExportAPI, "Query & Export API", "Go, HTTPS with RBAC/MFA", "Provides query and export capabilities for compliance officers.")
}

Rel(MessageBroker, IngestAPIHandler, "Sends audit messages", "AMQP/JSON with mTLS")
Rel(IngestAPIHandler, EventNormalizerEnricher, "Passes raw events", "Go channels/interfaces")
Rel(EventNormalizerEnricher, WORMStorageAdapter, "Persists normalized logs", "AWS S3 Object Lock API")
Rel(LogIntegrityVerifier, WORMStorageAdapter, "Validates logs", "Go interfaces")
Rel(ComplianceOfficers, QueryExportAPI, "Queries and exports logs", "HTTPS with RBAC/MFA")

@enduml