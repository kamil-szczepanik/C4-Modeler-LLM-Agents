@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Frontend container

Container_Boundary(web_frontend, "Web Frontend") {
    Component(Role_BasedModules, "Role-Based Modules", "React / TypeScript", "Powers the frontend SPA with tailored interfaces for patrons, librarians, and administrators.")
    Component(StateCachingManager, "State Caching Manager", "TanStack Query", "Provides client-side state caching to meet sub-800ms search performance targets.")
    Component(ServiceWorker, "Service Worker", "JavaScript PWA", "Manages offline PWA caching for public static assets only.")
}

Rel(Role_BasedModules, StateCachingManager, "Queries and caches data")
Rel(Role_BasedModules, ServiceWorker, "Leverages offline caching")
@enduml