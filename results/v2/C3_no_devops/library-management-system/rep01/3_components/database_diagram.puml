@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database container

System_Ext(Core_Business_Service, "Core Business Service", "Spring Boot (Java) application interacting with the database.")
System_Ext(Audit_Logging_Service, "Audit Logging Service", "External service for immutable WORM storage.")

Container_Boundary(Database, "Database") {
    Component(Transactional_Data_Store, "Transactional Data Store", "PostgreSQL 15+ / Row-Level Security", "Internal component utilizing row-level security and cryptographic erasure for GDPR compliance.")
    Component(Audit_Schema, "Audit Schema", "PostgreSQL Schema", "Isolated schema for compliance interfacing with the Audit Logging Service.")
    Component(Primary_Database_Instance, "Primary Database Instance", "PostgreSQL 15+", "Dedicated PostgreSQL node handling write-heavy operations.")
    Component(Read_Replica_Cluster, "Read Replica Cluster", "PostgreSQL 15+ Read Replicas", "Scaled-out read-only nodes servicing non-critical analytical queries.")
}

Rel(Core_Business_Service, Primary_Database_Instance, "Writes data via JDBC", "TLS 1.3 with mTLS and SCRAM-SHA-256")
Rel(Core_Business_Service, Read_Replica_Cluster, "Reads data via JDBC", "TLS 1.3 with strict SELECT-only least-privilege accounts")
Rel(Primary_Database_Instance, Read_Replica_Cluster, "Replicates data streams", "TLS 1.3 with certificate validation")
Rel(Audit_Schema, Audit_Logging_Service, "Interfaces directly for immutable WORM storage", "")

@enduml