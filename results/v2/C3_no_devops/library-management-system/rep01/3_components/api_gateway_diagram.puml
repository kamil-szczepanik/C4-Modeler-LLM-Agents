@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(proxy_router, "Proxy Router", "Kong API Gateway", "Handles traffic routing and reverse proxying for incoming requests.")
    Component(auth_plugin, "Authentication & Authorization Plugin", "Lua/Go plugins", "Validates tokens and enforces security policies at the perimeter.")
    Component(rate_limiting_plugin, "Rate Limiting Plugin", "Kong API Gateway", "Protects backend services by limiting request rates.")
    Component(response_caching_plugin, "Response Caching Plugin", "Kong API Gateway", "Caches responses to optimize performance and meet SLAs.")
    Component(log_transport_plugin, "Log Transport Plugin", "Lua/Go plugins", "Emits access logs to the audit logging service.")
}

Rel(proxy_router, auth_plugin, "Passes incoming requests for token validation", "")
Rel(auth_plugin, rate_limiting_plugin, "Forwards authenticated requests for rate checking", "")
Rel(rate_limiting_plugin, response_caching_plugin, "Checks cache for response availability", "")
Rel(response_caching_plugin, log_transport_plugin, "Triggers log emission for handled requests", "")

@enduml