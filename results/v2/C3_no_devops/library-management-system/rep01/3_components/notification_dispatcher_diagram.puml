@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification Dispatcher container

Container_Boundary(notification_dispatcher, "Notification Dispatcher") {
    Component(Consumer Component, "Consumer Component", "Python/Celery worker", "Processing raw events.")
    Component(Routing & Preference Engine, "Routing & Preference Engine", "Python component", "Selecting delivery channels (Email, SMS, Push).")
    Component(Template Renderer, "Template Renderer", "Jinja2 component", "Merging localized templates and sanitizing PII.")
    Component(Channel Adapters, "Channel Adapters", "Python/Requests components", "Communicating with external services.")
    Component(PostgreSQL State Store, "PostgreSQL State Store", "Database", "Tracking notification state with AES-256 encryption.")
}

Component_Ext(Message Broker, "Message Broker", "RabbitMQ / AWS SQS", "Supplying event payloads.")
Component_Ext(External Notification Service, "External Notification Service", "Third-party gateway", "Delivering external notifications.")

Rel(Consumer Component, Message Broker, "Consumes raw event payloads", "AMQP")
Rel(Consumer Component, Message Broker, "Validates HMAC authentication tokens", "AMQP")
Rel(Channel Adapters, External Notification Service, "Sends rendered payloads and receives delivery receipts", "Outbound HTTPS via TLS 1.3/mTLS")
Rel(Routing & Preference Engine, PostgreSQL State Store, "Tracks notification states and delivery attempts", "SQL")

@enduml