@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "Kong/Nginx", "External API Gateway routing requests.")
System_Ext(message_broker, "Message Broker", "RabbitMQ / AMQP", "Handles asynchronous messaging and streaming.")

Container_Boundary(search_service, "Search Service") {
    Component(query_parsing_nlp_component, "Query Parsing & NLP Component", "Lucene Query Parser / ES Analysis Modules", "Parses search queries and implements fuzzy matching, NLP, and autocomplete.")
    Component(indexing_synchronization_component, "Indexing & Synchronization Component", "Elasticsearch Core", "Handles catalog updates and synchronizes real-time inventory and availability states.")
    Component(search_execution_engine, "Search Execution Engine", "Elasticsearch Core", "Delivers sub-800ms item discovery with faceted filtering.")
    Component(ranking_aggregation_component, "Ranking & Aggregation Component", "Elasticsearch Core", "Executes relevance ranking and aggregations for search results.")
    Component(analytics_publisher_component, "Analytics Publisher Component", "Go / AMQP", "Streams pseudonymized query analytics via AMQP.")
}

Rel(api_gateway, query_parsing_nlp_component, "Routes search queries", "internal REST/gRPC secured with mTLS")
Rel(message_broker, indexing_synchronization_component, "Streams catalog updates", "TLS-encrypted AMQP")
Rel(indexing_synchronization_component, ranking_aggregation_component, "Updates availability state", "internal Java API")
Rel(analytics_publisher_component, message_broker, "Streams pseudonymized query analytics", "AMQP")

@enduml