@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(message_broker, "Message Broker") {
    Component(Exchange, "Exchange", "Direct/Topic", "Routes published events to appropriate durable queues.")
    Component(DurableQueues, "Durable Queues", "RabbitMQ Queues", "Stores notification.queue and audit.queue messages persistently.")
    Component(DeadLetterExchangeQueue, "Dead Letter Exchange & Queue", "RabbitMQ DLX/DLQ", "Handles and stores poisoned messages from notification.dlq.")
    Component(ManagementAPIUI, "Management API/UI", "RabbitMQ Management", "Provides monitoring and management capabilities for the message broker.")
}

Rel(Exchange, DurableQueues, "Routes messages", "AMQP over TLS 1.3")
Rel(DurableQueues, DeadLetterExchangeQueue, "Forward poisoned messages", "AMQP")
@enduml