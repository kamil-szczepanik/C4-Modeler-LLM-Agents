@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Library Management System

Person(Library_Patrons, "Library Patrons", "Students and public users accessing self-service portals.")
Person(Librarians_Circulation_Staff, "Librarians / Circulation Staff", "Users managing inventory cataloguing and circulation.")
Person(Library_Administrators, "Library Administrators", "Users handling reporting, analytics, and compliance.")

System(Library_Management_System, "Library Management System", "A cloud-hosted SaaS Library Management System providing item cataloguing, circulation management, and self-service portals with EU-only data residency and sub-800ms search performance.")

System_Ext(Payment_Gateway, "Payment Gateway", "Stripe EU / SEPA for payment processing.")
System_Ext(Identity_Provider, "Identity Provider", "EU Shibboleth / OAuth2 for authentication and identity management.")
System_Ext(Notification_Service, "Notification Service", "SendGrid EU / Twilio for sending notifications.")

Rel(Library_Patrons, Library_Management_System, "Accesses self-service portals", "HTTPS (TLS 1.3)")
Rel(Librarians_Circulation_Staff, Library_Management_System, "Manages inventory cataloguing and circulation", "HTTPS (TLS 1.3)")
Rel(Library_Administrators, Library_Management_System, "Handles reporting, analytics, and compliance", "HTTPS (TLS 1.3)")

Rel(Library_Management_System, Payment_Gateway, "Processes payments", "HTTPS/REST (PCI-DSS compliant EU endpoints)")
Rel(Library_Management_System, Identity_Provider, "Authenticates users", "OIDC / SAML 2.0 over HTTPS")
Rel(Library_Management_System, Notification_Service, "Sends notifications to users", "HTTPS/REST API")

@enduml