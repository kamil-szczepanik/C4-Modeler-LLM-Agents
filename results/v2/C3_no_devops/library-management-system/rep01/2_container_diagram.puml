@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(LibraryPatrons, "Library Patrons", "Students and public users accessing self-service portals.")
Person(LibrariansCirculationStaff, "Librarians / Circulation Staff", "Users managing inventory cataloguing and circulation.")
Person(LibraryAdministrators, "Library Administrators", "Users handling reporting, analytics, and compliance.")

System_Ext(PaymentGateway, "Payment Gateway", "Stripe EU / SEPA for payment processing.")
System_Ext(IdentityProvider, "Identity Provider", "EU Shibboleth / OAuth2 for authentication and identity management.")
System_Ext(NotificationService, "Notification Service", "SendGrid EU / Twilio for sending notifications.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(WebFrontend, "Web Frontend", "React/TypeScript hosted on an EU-region CDN", "Provides the user interface for patrons, librarians, and administrators.")
    Container(ApiGateway, "API Gateway", "Kong or Nginx", "Handles reverse proxy, rate limiting, and request routing.")
    Container(CoreBusinessService, "Core Business Service", "Spring Boot (Java)", "Handles circulation and cataloging logic.")
    Container(SearchService, "Search Service", "Elasticsearch", "Provides optimized sub-800ms search capabilities.")
    ContainerDb(Database, "Database", "PostgreSQL with AES-256 encryption-at-rest", "Stores system data enforcing EU data residency.")
    Container(NotificationDispatcher, "Notification Dispatcher", "Python/Celery worker container", "Dispatches notifications asynchronously.")
    Container(AuditLoggingService, "Audit Logging Service", "Go-based microservice with WORM storage", "Handles compliance and append-only audit logging.")
    Container(MessageBroker, "Message Broker", "RabbitMQ / AWS SQS", "Facilitates asynchronous messaging between services.")
}

Rel(LibraryPatrons, WebFrontend, "Accesses self-service portals", "HTTPS (TLS 1.3)")
Rel(LibrariansCirculationStaff, WebFrontend, "Manages inventory cataloguing and circulation", "HTTPS (TLS 1.3)")
Rel(LibraryAdministrators, WebFrontend, "Handles reporting, analytics, and compliance", "HTTPS (TLS 1.3)")
Rel(WebFrontend, ApiGateway, "Sends API requests", "HTTPS/REST")
Rel(ApiGateway, CoreBusinessService, "Routes business requests", "Internal REST/gRPC secured via mTLS")
Rel(ApiGateway, SearchService, "Routes search queries", "Internal REST/gRPC secured via mTLS")
Rel(CoreBusinessService, Database, "Reads and writes data", "JDBC (PostgreSQL)")
Rel(CoreBusinessService, MessageBroker, "Publishes asynchronous events", "AMQP")
Rel(NotificationDispatcher, MessageBroker, "Consumes messages", "AMQP")
Rel(NotificationDispatcher, NotificationService, "Sends external notifications", "Outbound HTTPS")
Rel(CoreBusinessService, PaymentGateway, "Processes payments", "OAuth2/TLS 1.3 with webhook signature verification")
Rel(CoreBusinessService, IdentityProvider, "Authenticates users", "OAuth2/TLS 1.3")

@enduml