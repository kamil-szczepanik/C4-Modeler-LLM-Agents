@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Patients, "Patients", "End users who access the clinic management system for their medical records and appointments.")
Person(Receptionists, "Receptionists", "Staff members who manage patient admissions and scheduling.")
Person(Clinicians, "Clinicians", "Medical professionals who access and update electronic medical records.")
Person(BillingSpecialists, "Billing Specialists", "Personnel who manage financial transactions and billing processes.")
Person(HospitalAdministrators, "Hospital Administrators", "Management users who oversee system administration and operations.")

System_Ext(InsurancePayersClearinghouses, "Insurance Payers/Clearinghouses", "External financial systems connected via secure HTTPS with dead-letter queues.")
System_Ext(ExternalLabsandImagingSystems, "External Labs and Imaging Systems", "External medical diagnostic systems integrated via HL7 FHIR APIs.")

System_Boundary(ClinicManagementSystem, "Clinic Management System") {
    Container(PatientPortal, "Patient Portal", "HTTPS, OAuth2", "Web interface allowing patients to access medical records and appointments.")
    Container(APIGateway, "API Gateway", "Istio, WAF", "Routes traffic to internal containers using mTLS and handles ingress security.")
    Container(ClinicalCore, "Clinical Core", "EMR, Scheduling, Billing Reconciliation, Kubernetes", "Core backend managing electronic medical records, scheduling, and billing reconciliation.")
    Container(NotificationReminderContainer, "Notification & Reminder Container", "Hybrid Cloud", "Handles system notifications and patient reminders.")
}

Rel(Patients, PatientPortal, "Accesses patient portal", "HTTPS/OAuth2")
Rel(Receptionists, APIGateway, "Routes traffic for admissions and scheduling", "HTTPS, mTLS via Istio")
Rel(Clinicians, APIGateway, "Routes traffic for EMR and clinical workflows", "HTTPS, mTLS via Istio")
Rel(BillingSpecialists, APIGateway, "Routes traffic for billing and financial operations", "HTTPS, mTLS via Istio")
Rel(HospitalAdministrators, APIGateway, "Routes traffic for system administration", "HTTPS, mTLS via Istio")
Rel(APIGateway, PatientPortal, "Routes traffic", "mTLS via Istio")
Rel(APIGateway, ClinicalCore, "Routes traffic to internal clinical core services", "mTLS via Istio")
Rel(APIGateway, NotificationReminderContainer, "Routes notification traffic", "mTLS via Istio")
Rel(ClinicalCore, ExternalLabsandImagingSystems, "Communicates with labs and imaging systems", "HL7 FHIR APIs")
Rel(ClinicalCore, InsurancePayersClearinghouses, "Interfaces for billing reconciliation", "Secure HTTPS with dead-letter queues")

@enduml