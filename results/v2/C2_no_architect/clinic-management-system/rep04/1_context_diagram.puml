@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "End users who access the clinical IT environment for their medical records and appointments.")
Person(Receptionists, "Receptionists", "Staff members who manage patient admissions and scheduling using internal protocols.")
Person(Clinicians, "Clinicians", "Medical professionals who access and update electronic medical records using internal protocols.")
Person(Billing Specialists, "Billing Specialists", "Personnel who manage financial transactions and billing processes.")
Person(Hospital Administrators, "Hospital Administrators", "Management users who oversee system administration and operations.")

System_Ext(Insurance Payers/Clearinghouses, "Insurance Payers/Clearinghouses", "External systems connected via asynchronous queue-based buffering and Dead Letter Queues (DLQs) for billing and claims.")
System_Ext(External Labs and Imaging Systems, "External Labs and Imaging Systems", "External medical diagnostic systems integrated via HL7 FHIR APIs secured with Mutual TLS (mTLS).")

System(Clinical IT Environment, "Clinical IT Environment", "Manages patient admissions, electronic medical records (EMR), scheduling, and billing for clinical IT environments with a hybrid architecture ensuring HIPAA/GDPR compliance and 99.99% high availability.")

Rel(Patients, Clinical IT Environment, "Accesses system services via HTTPS", "HTTPS, OAuth 2.0 / OIDC, MFA")
Rel(Receptionists, Clinical IT Environment, "Manages patient admissions and scheduling", "HTTPS, REST/gRPC")
Rel(Clinicians, Clinical IT Environment, "Interacts with EMR and scheduling", "HTTPS, REST/gRPC")
Rel(Billing Specialists, Clinical IT Environment, "Manages financial billing operations", "HTTPS, OAuth 2.0 / OIDC")
Rel(Hospital Administrators, Clinical IT Environment, "Administers system configurations and oversight", "HTTPS, OAuth 2.0 / OIDC, ABAC")
Rel(External Labs and Imaging Systems, Clinical IT Environment, "Integrates lab and imaging data", "HL7 FHIR APIs, Mutual TLS (mTLS)")
Rel(Insurance Payers/Clearinghouses, Clinical IT Environment, "Processes insurance claims and payments", "Asynchronous Message Queues, DLQs")

@enduml