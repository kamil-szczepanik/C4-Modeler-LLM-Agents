@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient Portal container

Container_Boundary(patient_portal, "Patient Portal") {
    Component(React_SPA, "React SPA", "React, WCAG 2.1 AA, Multi-language support", "Powers the frontend UI enabling patients to manage appointments, view EMR, and handle billing.")
    Component(Edge_CDN, "Edge CDN", "Content Delivery Network", "Loads static UI assets for the Patient Portal.")
}

Rel(React_SPA, Edge_CDN, "Loads static UI assets", "HTTPS")

@enduml