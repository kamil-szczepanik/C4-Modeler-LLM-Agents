@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Clinical Core container

Container_Boundary(clinical_core, "Clinical Core") {
    Component(EMR, "EMR", "HL7 FHIR, Java/Spring", "Handles electronic medical records and clinical workflows.")
    Component(Scheduling, "Scheduling", "Java/Spring", "Manages patient appointments and scheduling.")
    Component(Billing_Reconciliation, "Billing Reconciliation", "Java/Spring, Dead-Letter Queues", "Processes billing reconciliation and communicates with insurance payers.")
}

Rel(EMR, Scheduling, "Coordinates patient appointments with medical records")
Rel(EMR, Billing_Reconciliation, "Triggers billing events for clinical services")
@enduml