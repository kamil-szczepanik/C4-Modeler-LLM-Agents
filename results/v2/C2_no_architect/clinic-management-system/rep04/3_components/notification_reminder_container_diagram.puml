@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification & Reminder Container container

Container_Boundary(notification_reminder_container, "Notification & Reminder Container") {
    Component(Notification_Dispatcher, "Notification Dispatcher", "Node.js / TLS 1.3 Client", "Dispatches external notifications securely via TLS 1.3 with client certificate pinning.")
    Component(Reminder_Scheduler, "Reminder Scheduler", "Python / Celery", "Manages and triggers scheduled patient appointment reminders and alerts.")
}

Rel(Reminder_Scheduler, Notification_Dispatcher, "Triggers message dispatch")

@enduml