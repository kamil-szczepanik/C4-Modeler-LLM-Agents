@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "Patients using the self-service portal for registration, demographic capture, and appointment scheduling.")
Person(Clinical_Staff_Doctors_Nurses, "Clinical Staff (Doctors/Nurses)", "Clinical staff accessing electronic medical records and clinical workflows.")
Person(Administrative_Billing_Staff, "Administrative & Billing Staff", "Staff managing billing, insurance, and administrative operations.")
Person(Clinic_Administrators_Compliance_Officers, "Clinic Administrators/Compliance Officers", "Administrators ensuring compliance, system configuration, and audit reviews.")

System(Clinic_Management_System, "Clinic Management System", "A hybrid cloud platform designed for medium-sized hospitals and clinics to manage patient admissions, electronic medical records (EMR), appointments, and billing with high availability and strict HIPAA/GDPR compliance.")

System_Ext(Lab_Imaging_Systems, "Lab/Imaging Systems", "External clinical systems exchanging medical data via HL7 FHIR APIs.")

Rel(Patients, Clinic_Management_System, "Registration, demographic capture, and appointment scheduling", "HTTPS / TLS 1.3")
Rel(Clinical_Staff_Doctors_Nurses, Clinic_Management_System, "Secure EMR access", "FIDO2/WebAuthn MFA and short-lived JWTs (OAuth2/OIDC)")
Rel(Administrative_Billing_Staff, Clinic_Management_System, "Billing and administrative access", "FIDO2/WebAuthn MFA and short-lived JWTs (OAuth2/OIDC)")
Rel(Clinic_Administrators_Compliance_Officers, Clinic_Management_System, "System administration and compliance monitoring", "FIDO2/WebAuthn MFA and short-lived JWTs (OAuth2/OIDC)")
Rel(Clinic_Management_System, Lab_Imaging_Systems, "Clinical data exchange", "HL7 FHIR APIs over mTLS")

@enduml