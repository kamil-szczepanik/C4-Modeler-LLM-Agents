@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient Portal container

Container_Boundary(patient_portal, "Patient Portal") {
    Component(patient_portal_ui, "Patient Portal UI", "React, WCAG 2.1 AA", "Web frontend interface for patients to access medical records, scheduling, and billing.")
    Component(patient_portal_bff, "Patient Portal BFF", "Node.js", "Backend-for-Frontend service managing client requests, authentication state, and session drafts.")
}

Rel(patient_portal_ui, patient_portal_bff, "Sends client requests and handles UI rendering", "HTTPS")

@enduml