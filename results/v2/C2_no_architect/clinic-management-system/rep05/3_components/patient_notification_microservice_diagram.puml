@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(patient_notification_microservice, "Patient Notification Microservice") {
    Component(Outbound_Dispatch_Logic_Templating, "Outbound Dispatch Logic & Templating", "Node.js", "Handles outbound dispatch logic and multi-channel templating for notifications.")
    Component(Webhook_Ingestion_Handler, "Webhook Ingestion Handler", "Node.js", "Ingests and processes inbound webhooks with HMAC signature verification.")
}

Rel(Outbound_Dispatch_Logic_Templating, Webhook_Ingestion_Handler, "Coordinates notification lifecycles and messaging events", "")

@enduml