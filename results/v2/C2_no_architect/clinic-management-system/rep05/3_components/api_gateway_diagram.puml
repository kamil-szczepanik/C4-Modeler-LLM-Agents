@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(Istio_Service_Mesh, "Istio Service Mesh", "Istio", "Provides geo-distributed multi-cluster routing, rate-limiting, and circuit breaking.")
    Component(Envoy_Proxy, "Envoy Proxy", "Envoy", "Enforces policies, perimeter security controls, and mTLS routing.")
}

Rel(Istio_Service_Mesh, Envoy_Proxy, "Routes and manages traffic policies", "")

@enduml