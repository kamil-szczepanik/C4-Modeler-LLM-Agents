@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("EMR & Billing Containers", "EMR & Billing Containers") {
    Component("EMR & Billing Controller", "EMR & Billing Controller", "Java, Spring Boot", "Handles incoming gRPC / HTTPS transactions from the API Gateway and exposes endpoints for patient admissions, electronic medical records, and billing.")
    Component("Clinical Transaction Service", "Clinical Transaction Service", "Java, Spring Boot", "Executes business logic for clinical workflows, ensuring ACID compliance and robust transactional integrity.")
    Component("HL7 FHIR Integration Service", "HL7 FHIR Integration Service", "Java, Spring Boot", "Integrates and exchanges clinical data with external Lab and Imaging Systems via HL7 FHIR APIs over mTLS.")
    Component("Data Access Layer", "Data Access Layer", "Java, Spring Boot, PostgreSQL, PgBouncer", "Manages persistent patient and billing records utilizing TLS connections, connection pooling, column-level encryption, and Row-Level Security.")
}

Rel("EMR & Billing Controller", "Clinical Transaction Service", "Delegates request processing and transaction workflows", "")
Rel("Clinical Transaction Service", "HL7 FHIR Integration Service", "Triggers external lab and imaging data exchanges", "")
Rel("Clinical Transaction Service", "Data Access Layer", "Persists and retrieves patient and billing records", "")
@enduml