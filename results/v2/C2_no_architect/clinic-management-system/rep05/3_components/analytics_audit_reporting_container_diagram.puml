@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Analytics & Audit Reporting Container

Container_Boundary("Analytics & Audit Reporting Container", "Analytics & Audit Reporting Container") {
    Component(API Handler, "API Handler", "Python, Envoy / Istio Service Mesh", "Receives audit and reporting requests routed via gRPC / HTTPS with mTLS from the API Gateway.")
    Component(Data Aggregator & Scrubber, "Data Aggregator & Scrubber", "Python, OpenTelemetry", "Performs PII/PHI scrubbing and aggregates data for compliance reporting and operational analytics.")
    Component(Task Scheduler & Worker Manager, "Task Scheduler & Worker Manager", "Celery, Celery Beat, Redis, KEDA", "Offloads heavy PDF/CSV export generation and dynamically scales worker pods based on queue depth.")
    Component(Compliance Audit Logger, "Compliance Audit Logger", "Python, WORM Storage", "Streams immutable audit logs directly to tamper-proof storage to satisfy HIPAA, GDPR, and retention mandates.")
    Component(Report Storage Manager, "Report Storage Manager", "Python, Encrypted Object Storage (S3/MinIO)", "Manages securely generated reports accessed via short-lived pre-signed URLs.")
}

Rel(API Handler, Data Aggregator & Scrubber, "Passes sanitized reporting and audit requests.", "gRPC / HTTPS")
Rel(Data Aggregator & Scrubber, Task Scheduler & Worker Manager, "Offloads resource-intensive data processing and export generation.", "Celery / Redis")
Rel(Task Scheduler & Worker Manager, Report Storage Manager, "Saves generated PDF and CSV exports to object storage.", "S3 API")
Rel(Compliance Audit Logger, Data Aggregator & Scrubber, "Receives processed telemetry and audit events for immutable logging.", "Internal API")

@enduml