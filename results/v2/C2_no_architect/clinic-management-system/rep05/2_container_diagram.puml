@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Patients, "Patients", "Patients using the self-service portal for registration, demographic capture, and appointment scheduling.")
Person(ClinicalStaff, "Clinical Staff (Doctors/Nurses)", "Clinical staff accessing electronic medical records and clinical workflows.")
Person(AdminBillingStaff, "Administrative & Billing Staff", "Staff managing billing, insurance, and administrative operations.")
Person(ClinicAdmins, "Clinic Administrators/Compliance Officers", "Administrators ensuring compliance, system configuration, and audit reviews.")

System_Ext(LabImagingSystems, "Lab and Imaging Systems", "External clinical systems exchanging medical data via HL7 FHIR APIs.")

System_Boundary(ClinicManagementSystem, "Clinic Management System") {
    Container(ApiGateway, "API Gateway", "Istio Service Mesh, Envoy", "Routes, secures, and throttles incoming traffic to the appropriate microservices using OAuth2/OIDC.")
    Container(PatientPortal, "Patient Portal", "React, Web", "Frontend application allowing patients to manage appointments, view records, and handle self-service tasks.")
    Container(EmrBillingContainers, "EMR & Billing Containers", "Java, Spring Boot, PostgreSQL, PgBouncer", "Manages electronic medical records, patient admissions, and billing workflows securely with AES-256 encryption.")
    Container(AnalyticsReportingContainer, "Analytics & Audit Reporting Container", "Python, OpenTelemetry, Datadog/Prometheus", "Handles heavy reporting, compliance logging, and payload scrubbing without impacting core EMR performance.")
    Container(PatientNotificationMicroservice, "Patient Notification Microservice", "Node.js", "Dispatches automated patient notifications, reminders, and alerts.")
}

Rel(Patients, ApiGateway, "Interacts via HTTPS for patient portal workflows", "HTTPS / OAuth2 / OIDC")
Rel(ClinicalStaff, ApiGateway, "Accesses clinical workflows and medical records", "HTTPS / OAuth2 / OIDC")
Rel(AdminBillingStaff, ApiGateway, "Manages billing and administrative tasks", "HTTPS / OAuth2 / OIDC")
Rel(ClinicAdmins, ApiGateway, "Performs system administration and compliance monitoring", "HTTPS / OAuth2 / OIDC")

Rel(ApiGateway, PatientPortal, "Routes requests to the patient portal frontend", "gRPC / HTTPS with mTLS")
Rel(ApiGateway, EmrBillingContainers, "Routes EMR and billing transactions", "gRPC / HTTPS with mTLS")
Rel(ApiGateway, AnalyticsReportingContainer, "Routes audit and reporting requests", "gRPC / HTTPS with mTLS")
Rel(ApiGateway, PatientNotificationMicroservice, "Triggers notification dispatch workflows", "gRPC / HTTPS with mTLS")

Rel(EmrBillingContainers, LabImagingSystems, "Integrates clinical data exchange", "HL7 FHIR APIs over mTLS")

@enduml