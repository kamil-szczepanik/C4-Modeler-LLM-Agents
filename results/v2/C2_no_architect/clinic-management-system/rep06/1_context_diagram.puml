@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Patient, "Patient", "Books appointments and views bills.")
Person(Clinician, "Clinician / Doctor", "Manages electronic medical records with sub-second latency.")
Person(Receptionist, "Receptionist / Admin", "Handles administrative tasks and patient admissions within the clinic.")
Person(BillingSpecialist, "Billing Specialist", "Submits insurance claims and manages billing.")
Person(ComplianceOfficer, "Compliance Officer", "Ensures strict HIPAA and GDPR compliance.")

System_Ext(InsuranceSystem, "Insurance / Payer System", "External system for processing insurance claims.")
System_Ext(LabSystems, "Lab & Imaging Systems", "External systems providing clinical laboratory and imaging data.")

System_Boundary(ClinicManagementSystem, "Clinic Management System") {
    Container(OnPremK8s, "On-Premises Kubernetes Cluster", "Kubernetes", "Local infrastructure for uninterrupted edge operations during network partitions.")
    Container(AWSCloud, "AWS Cloud (eu-central-1)", "AWS", "Cloud infrastructure providing scalability for high-availability database replication.")
    Container(IstioMesh, "Istio Service Mesh", "Istio", "Handles service-to-service authorization and edge termination.")
    ContainerDb(ActiveDatabases, "Active-Active Databases", "Database", "Database tier providing high availability and replication.")

    Container_Boundary(InternalComponents, "Internal Modules") {
        Component(PatientRegistrationModule, "Patient Registration Module", "", "Handles patient admissions and registration data.")
        Component(AppointmentScheduler, "Appointment Scheduler", "", "Manages scheduling for clinics and hospitals.")
        Component(EMREngine, "EMR Engine", "", "Manages electronic medical records with sub-second latency (R-07).")
        Component(BillingProcessor, "Billing & Claims Processor", "", "Processes billing and submits insurance claims.")
        Component(AuditLogService, "Audit Log Service", "", "Maintains WORM audit logs and compliance data.")
    }
}

Rel(Patient, ClinicManagementSystem, "Books appointments and views bills", "HTTPS/TLS 1.3")
Rel(Clinician, EMREngine, "Manages medical records with sub-second latency", "Internal API")
Rel(BillingSpecialist, BillingProcessor, "Submits insurance claims", "OAuth 2.0 and signed JWTs")
Rel(ClinicManagementSystem, InsuranceSystem, "Submits claims via asynchronous queues", "Asynchronous Queues / Circuit Breakers")
Rel(ClinicManagementSystem, LabSystems, "Integrates using HL7 FHIR APIs", "HL7 FHIR over mTLS")

@enduml