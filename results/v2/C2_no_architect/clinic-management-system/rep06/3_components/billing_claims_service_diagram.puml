@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Insurance_Payer_System, "Insurance / Payer System", "External system for insurance claims and eligibility checks.")
System_Ext(HashiCorp_Vault, "HashiCorp Vault", "External secret management system.")
System_Ext(Cold_Object_Storage, "Cold Object Storage", "External storage for archival and WORM policies.")

Container_Boundary(Billing_Claims_Service, "Billing / Claims Service") {
    Component(Claims_Processor_Component, "Claims Processor Component", "Java / Spring Boot", "Handles the business logic for processing billing requests, submitting insurance claims, and real-time eligibility checks.")
    Component(Vault_Integration_Client, "Vault Integration Client", "HashiCorp Vault SDK", "Fetches dynamic encryption keys via mTLS for AES-256 field-level encryption.")
    Component(Archive_Manager_Component, "Archive Manager Component", "AWS SDK", "Archives closed claims to cold object storage using immutable WORM policies.")
}

Rel(Claims_Processor_Component, Insurance_Payer_System, "Submits insurance claims and real-time eligibility checks", "Secure HTTPS with DLQ and TLS 1.3")
Rel(Vault_Integration_Client, HashiCorp_Vault, "Fetches dynamic encryption keys", "mTLS")
Rel(Archive_Manager_Component, Cold_Object_Storage, "Archives closed claims", "immutable WORM policies")
@enduml