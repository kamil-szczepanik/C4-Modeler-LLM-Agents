@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("on-prem-k8s cluster", "on-prem-k8s cluster") {
    Component("Web Frontend", "Web Frontend", "Web Technologies", "Provides the user interface for clinicians, receptionists, billing specialists, and compliance officers.")
    Component("Patient Portal / Mobile App", "Patient Portal / Mobile App", "Mobile and Web Technologies", "Allows patients to access their health records, appointments, and billing information.")
    Component("API Gateway", "API Gateway", "OAuth2/OIDC, ABAC", "Manages incoming traffic, handling authentication and authorization.")
    Component("EMR Service", "EMR Service", "gRPC/REST over mTLS, SPIFFE/SPIRE", "Manages electronic medical records and patient data securely.")
    Component("Billing / Claims Service", "Billing / Claims Service", "gRPC/REST over mTLS, SPIFFE/SPIRE", "Handles patient billing, invoicing, and insurance claims processing.")
    Component("OpenTelemetry sidecars", "OpenTelemetry sidecars", "OpenTelemetry, Prometheus, Grafana", "Collects and exports telemetry data for SLO-based observability.")
    Component("Audit Logging sidecars", "Audit Logging sidecars", "WORM Storage", "Captures and securely stores immutable audit logs for compliance.")
    Component("Dynamic Secrets Manager", "Dynamic Secrets Manager", "HashiCorp Vault, AES-256", "Manages and provides dynamic secrets and encryption keys.")
}

Rel("Web Frontend", "API Gateway", "Sends HTTPS requests for user interactions")
Rel("Patient Portal / Mobile App", "API Gateway", "Sends HTTPS requests for patient access")
Rel("API Gateway", "EMR Service", "Routes authenticated requests using OAuth2/OIDC")
Rel("API Gateway", "Billing / Claims Service", "Routes billing-related requests")
Rel("EMR Service", "Billing / Claims Service", "Communicates internally via gRPC/REST over mTLS with SPIFFE/SPIRE")
Rel("EMR Service", "Dynamic Secrets Manager", "Retrieves secrets and encryption keys")
Rel("Billing / Claims Service", "Dynamic Secrets Manager", "Retrieves secrets and encryption keys")
Rel("EMR Service", "OpenTelemetry sidecars", "Emits telemetry metrics and traces")
Rel("Billing / Claims Service", "OpenTelemetry sidecars", "Emits telemetry metrics and traces")
Rel("EMR Service", "Audit Logging sidecars", "Writes compliance audit logs")
Rel("Billing / Claims Service", "Audit Logging sidecars", "Writes compliance audit logs")
@enduml