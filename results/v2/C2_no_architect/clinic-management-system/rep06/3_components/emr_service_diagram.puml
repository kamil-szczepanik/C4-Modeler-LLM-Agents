@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the EMR Service container

Container_Boundary(emr_service, "EMR Service") {
    Component(Audit___Compliance_Tracker, "Audit & Compliance Tracker", "Microservice Internal Component", "Tracks audit trails and compliance metrics, writing asynchronous compliance logs to WORM storage.")
    Component(Read_Only_Offline_Cache_Component, "Read-Only Offline Cache Component", "Local Cache Component", "Provides local offline caching to ensure sub-second EMR performance during network interruptions.")
}

Rel(emr_service, Audit___Compliance_Tracker, "Writes asynchronous compliance logs", "Asynchronous")
Rel(emr_service, Read_Only_Offline_Cache_Component, "Retrieves cached patient and clinical data", "Internal")

@enduml