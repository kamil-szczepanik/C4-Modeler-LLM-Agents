@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Frontend container

Container_Boundary(web_frontend_boundary, "Web Frontend") {
    Component(web_frontend_bff_static_assets, "Web Frontend (BFF & Static Assets)", "Kubernetes-backed SSR/BFF with CDN caching", "Manages server-side rendering, BFF logic, and static assets delivery ensuring <1s P95 EMR rendering and WCAG 2.1 AA compliance.")
}

System_Ext(api_gateway, "API Gateway", "Handles incoming traffic, OAuth2/OIDC, and ABAC enforcement.")

Rel(web_frontend_bff_static_assets, api_gateway, "Routes requests", "HTTPS/TLS")

@enduml