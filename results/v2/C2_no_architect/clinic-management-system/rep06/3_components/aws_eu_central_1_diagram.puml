@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_eu_central_1, "AWS (eu-central-1)") {
    Component(Amazon_EKS, "Amazon EKS", "Kubernetes", "Pre-provisioned container compute fleets for stateless services supporting warm-standby disaster recovery.")
    Component(Amazon_Route_53, "Amazon Route 53", "AWS DNS", "Handles DNS traffic management and automated health-check failover between on-prem and AWS.")
    Component(AWS_KMS, "AWS KMS", "AWS Key Management Service", "Provides Customer-Managed Keys (CMKs) with annual rotation for data encryption using AES-256.")
    Component(AWS_CloudTrail_Amazon_GuardDuty, "AWS CloudTrail & Amazon GuardDuty", "AWS Security & Auditing", "Handles immutable audit logging and runtime threat detection.")
    Component(HashiCorp_Vault, "HashiCorp Vault", "HashiCorp Vault", "Acts as a dynamic secrets manager for ephemeral injection via mTLS sidecars.")
}

Rel(Amazon_Route_53, Amazon_EKS, "Automated health-check based traffic routing during failover events.", "DNS")
Rel(Amazon_EKS, AWS_KMS, "Performs cryptographic operations using AES-256 for data at rest.", "API")
Rel(AWS_CloudTrail_Amazon_GuardDuty, Amazon_EKS, "Synchronizes immutable security and access logs.", "API / Logs")
@enduml