@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(patient_portal_mobile_app, "Patient Portal / Mobile App") {
    Component(Self_Registration_Component, "Self-Registration Component", "React Native / Flutter", "Handles patient onboarding and profile creation.")
    Component(Appointment_Booking_Component, "Appointment Booking Component", "React Native / Flutter", "Manages scheduling and viewing of clinic appointments.")
    Component(EMR_Access_Component, "EMR Access Component", "React Native / Flutter with local SQLite (AES-256)", "Provides secure access to patient medical records and mobile data storage.")
}

System(API_Gateway, "API Gateway", "Entry point handling OAuth2/OIDC, ABAC, TLS termination, and request routing.")

Rel(Self_Registration_Component, API_Gateway, "Sends registration requests", "HTTPS/TLS")
Rel(Appointment_Booking_Component, API_Gateway, "Sends scheduling requests", "HTTPS/TLS")
Rel(EMR_Access_Component, API_Gateway, "Retrieves EMR data", "HTTPS/TLS with W3C Trace Context headers")

@enduml