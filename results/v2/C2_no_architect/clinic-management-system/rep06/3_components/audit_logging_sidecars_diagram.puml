@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit Logging sidecars container

Container_Boundary(audit_logging_sidecars_container, "Audit Logging sidecars") {
    Component(Audit Logging sidecars, "Audit Logging sidecars", "Logging / WORM", "Enforce immutable compliance, audit tracking, and zero-loss queuing while ingesting log streams locally via Unix domain sockets.")
}

Component(Fluentbit / Logstash Daemonsets, "Fluentbit / Logstash Daemonsets", "Asynchronous log ingestion and parsing pipelines", "Offload heavy payload processing and avoid application-side latency, streaming logs asynchronously using TLS.")
Component(AWS S3 Object Lock, "AWS S3 Object Lock", "Immutable external storage tier", "Immutable, WORM-compliant storage enforcing 10-year retention policies.")
Component(Compliance Officers, "Compliance Officers", "Internal users / HTTPS", "Review security dashboards and investigate audit trails over HTTPS.")
Component(Application Containers, "Application Containers", "Co-located EMR and billing microservices", "Communicate via local Unix domain sockets and stream logs locally.")
Component(SPIFFE/SPIRE, "SPIFFE/SPIRE", "Identity management framework", "Issues short-lived SVIDs for zero-trust, automated workload identity and mTLS authentication.")

Rel(Application Containers, Audit Logging sidecars, "Ingests log streams locally", "Unix domain sockets")
Rel(Audit Logging sidecars, Fluentbit / Logstash Daemonsets, "Streams logs asynchronously", "TLS")
Rel(Fluentbit / Logstash Daemonsets, AWS S3 Object Lock, "Forwards logs for permanent storage", "mTLS authenticated via SPIFFE/SPIRE SVIDs")
Rel(Compliance Officers, Audit Logging sidecars, "Accesses searchable compliance dashboards", "HTTPS")

@enduml