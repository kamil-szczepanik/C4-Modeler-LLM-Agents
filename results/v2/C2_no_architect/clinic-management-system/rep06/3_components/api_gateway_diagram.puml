@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(Ingress_Router, "Ingress Router", "Kubernetes Ingress / Envoy", "Manages ingress routing, TLS 1.3 termination, and entry point for web and mobile clients.")
    Component(Security_Enforcement_Module, "Security Enforcement Module", "OAuth2/OIDC & JWT", "Handles edge authentication, token validation, and security enforcement.")
    Component(Routing_Dispatcher, "Routing & Dispatcher", "gRPC / REST Client", "Forwards internal requests securely to downstream microservices using mTLS.")
    Component(Authorization_Evaluator, "Authorization Evaluator", "Open Policy Agent (OPA) Sidecar", "Evaluates Attribute-Based Access Control (ABAC) policies locally via OPA.")
}

System_Ext(EMR_Service, "EMR Service", "Core clinical microservice")
System_Ext(Billing_Claims_Service, "Billing / Claims Service", "Financial microservice")

Rel(Ingress_Router, Security_Enforcement_Module, "Passes incoming client requests for token validation")
Rel(Security_Enforcement_Module, Authorization_Evaluator, "Queries ABAC policies for request authorization")
Rel(Authorization_Evaluator, Routing_Dispatcher, "Approves request flow upon successful policy evaluation")
Rel(Routing_Dispatcher, EMR_Service, "Forwards clinical requests", "gRPC/REST over mTLS (SPIFFE/SPIRE)")
Rel(Routing_Dispatcher, Billing_Claims_Service, "Forwards billing requests", "gRPC/REST over mTLS (SPIFFE/SPIRE)")

@enduml