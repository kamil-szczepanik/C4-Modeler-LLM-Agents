@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(vault, "Dynamic Secrets Manager (HashiCorp Vault)") {
    Component(Distributed_Raft_Storage, "Distributed Raft Storage", "Multi-region Distributed Raft Storage", "Provides multi-region storage backend with encrypted inter-node traffic for high availability.")
    Component(Secrets_Engine, "Secrets Engine", "HashiCorp Vault Secrets Engine", "Generates dynamic, short-lived credentials to minimize leak blast radiuses for workloads.")
    Component(Auth_Method_Engine, "Auth Method Engine", "AppRole and Kubernetes Service Account JWT via mTLS", "Handles workload authentication using AppRole and Kubernetes Service Account JWT over mTLS (SPIFFE/SPIRE).")
    Component(Unseal_Integration, "Unseal Integration", "AWS KMS / On-prem HSM", "Connects to AWS KMS or On-prem HSM for automated cluster unsealing via encrypted transport channels.")
    Component(Telemetry_Exporter, "Telemetry Exporter", "OpenTelemetry", "Exports Vault telemetry metrics to the OpenTelemetry pipeline for availability monitoring.")
    Component(Audit_Logging_Sidecar, "Audit Logging Sidecar", "WORM audit sidecar", "Writes immutable audit logs for break-glass and access events.")
}

Rel(Auth_Method_Engine, Secrets_Engine, "Authenticates workloads to issue dynamic credentials")
Rel(Distributed_Raft_Storage, Secrets_Engine, "Persists encrypted backend data")
Rel(Unseal_Integration, Distributed_Raft_Storage, "Provides automated unsealing keys")
Rel(Telemetry_Exporter, OpenTelemetry_sidecars, "Exports metrics for availability monitoring")
Rel(Audit_Logging_Sidecar, Audit_Logging_sidecars, "Writes immutable audit events")
@enduml