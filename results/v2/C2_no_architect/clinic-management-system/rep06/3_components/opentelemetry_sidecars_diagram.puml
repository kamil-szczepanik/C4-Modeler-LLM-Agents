@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the OpenTelemetry sidecars container

Container_Boundary(otel_sidecars, "OpenTelemetry sidecars") {
    Component(OpenTelemetry_Collector, "OpenTelemetry Collector", "OpenTelemetry Collector, C++, Go", "Collects, processes, and exports distributed tracing telemetry and performance metrics without impacting core clinical workflows.")
    Component(mTLS_Handler, "mTLS Handler", "SPIFFE/SPIRE, gRPC", "Handles secure communication using mTLS transport and SPIFFE/SPIRE identities across hybrid boundaries.")
}

Rel(OpenTelemetry_Collector, mTLS_Handler, "Transmits OTLP telemetry securely over mTLS", "gRPC / mTLS")

@enduml