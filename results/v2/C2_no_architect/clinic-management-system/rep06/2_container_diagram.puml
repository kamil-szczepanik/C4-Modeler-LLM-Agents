@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Patient, "Patient", "Books appointments and views bills.")
Person(Clinician, "Clinician / Doctor", "Manages electronic medical records with sub-second latency.")
Person(Receptionist, "Receptionist / Admin", "Handles administrative tasks and patient admissions within the clinic.")
Person(BillingSpecialist, "Billing Specialist", "Submits insurance claims and manages billing.")
Person(ComplianceOfficer, "Compliance Officer", "Ensures strict HIPAA and GDPR compliance.")

System_Ext(InsuranceSystem, "Insurance / Payer System", "External system for processing insurance claims.")
System_Ext(LabSystems, "Lab & Imaging Systems", "External systems providing clinical laboratory and imaging data.")

System_Boundary(ClinicSystem, "Clinic Management System") {
    Container(WebFrontend, "Web Frontend", "Web / HTTPS", "Web interface for users accessing the platform.")
    Container(PatientPortal, "Patient Portal / Mobile App", "Mobile / HTTPS", "Mobile and portal interface for patients.")
    Container(APIGateway, "API Gateway", "OAuth2/OIDC & ABAC", "Manages ingress, authentication, and authorization with OAuth2/OIDC and ABAC.")
    Container(EMRService, "EMR Service", "gRPC/REST over mTLS, SPIFFE/SPIRE", "Manages electronic medical records and clinical interactions.")
    Container(BillingService, "Billing / Claims Service", "gRPC/REST over mTLS, SPIFFE/SPIRE", "Handles billing and insurance claims processing.")
    Container(OpenTelemetry, "OpenTelemetry sidecars", "OpenTelemetry", "Provides distributed tracing and performance monitoring.")
    Container(AuditLogging, "Audit Logging sidecars", "Logging / WORM", "Maintains immutable compliance and audit logs.")
    Container(Vault, "Dynamic Secrets Manager (HashiCorp Vault)", "HashiCorp Vault", "Manages dynamic secret management with short-lived credentials.")
    Container(OnPremK8s, "on-prem-k8s cluster", "Kubernetes", "On-premises Kubernetes orchestration cluster.")
    Container(AWSCloud, "AWS (eu-central-1)", "AWS Cloud", "Cloud infrastructure for active-active high availability and hybrid replication.")
}

Rel(Patient, WebFrontend, "Accesses system via browser", "HTTPS/TLS via API Gateway")
Rel(Patient, PatientPortal, "Accesses portal and mobile application", "HTTPS/TLS via API Gateway")
Rel(Clinician, WebFrontend, "Accesses EMR and clinical tools", "HTTPS/TLS via API Gateway")
Rel(Receptionist, WebFrontend, "Manages patient admissions and administration", "HTTPS/TLS via API Gateway")
Rel(BillingSpecialist, WebFrontend, "Manages billing and claims", "HTTPS/TLS via API Gateway")
Rel(ComplianceOfficer, WebFrontend, "Reviews compliance and audit logs", "HTTPS/TLS via API Gateway")

Rel(WebFrontend, APIGateway, "Routes requests through gateway", "HTTPS/TLS")
Rel(PatientPortal, APIGateway, "Routes requests through gateway", "HTTPS/TLS")

Rel(APIGateway, EMRService, "Forwards internal requests", "gRPC/REST over mTLS")
Rel(APIGateway, BillingService, "Forwards billing requests", "gRPC/REST over mTLS")

Rel(EMRService, LabSystems, "Integrates clinical data", "HL7 FHIR APIs")
Rel(BillingService, InsuranceSystem, "Submits claims with persistent encrypted queues", "Secure HTTPS with DLQ")

Rel(OnPremK8s, AWSCloud, "Cross-region replication and hybrid synchronization", "Anycast DNS and Traffic Managers")

@enduml