@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patient, "Patient", "End-user interacting with the frontend to manage appointments, view records, and handle billing.")
Person(Clinic_Receptionist_Staff, "Clinic Receptionist/Staff", "Administrative personnel managing patient admissions, check-ins, and front-desk scheduling.")
Person(Clinician_Doctor, "Clinician/Doctor", "Medical professional accessing and updating electronic medical records and patient schedules.")
Person(Billing_Specialist, "Billing Specialist", "Financial staff handling invoicing, payments, and insurance claims processing.")
Person(Compliance_IT_Administrator, "Compliance/IT Administrator", "System administrator managing security, access controls, infrastructure, and regulatory compliance.")

System_Ext(Insurance_Third_Party_Payer_Gateway, "Insurance/Third-Party Payer Gateway", "External financial gateway for processing insurance claims and third-party payments.")
System_Ext(External_Lab_Imaging_Systems, "External Lab & Imaging Systems", "External medical diagnosis systems providing lab results and imaging data.")

System(Clinic_Management_System, "Clinic Management System", "Streamlines patient admissions, electronic medical records, scheduling, and billing for medium-sized hospitals and clinics, ensuring high availability and strict regulatory compliance across a hybrid cloud infrastructure.")

Rel(Patient, Clinic_Management_System, "Accesses appointments, records, and billing via web/mobile interface", "HTTPS, TLS 1.3, OAuth2/OIDC tokens, MFA")
Rel(Clinic_Receptionist_Staff, Clinic_Management_System, "Manages patient admissions and scheduling", "HTTPS, TLS 1.3, OAuth2/OIDC tokens, MFA")
Rel(Clinician_Doctor, Clinic_Management_System, "Accesses and updates electronic medical records", "HTTPS, TLS 1.3, OAuth2/OIDC tokens, MFA")
Rel(Billing_Specialist, Clinic_Management_System, "Manages invoices, billing, and claims", "HTTPS, TLS 1.3, OAuth2/OIDC tokens, MFA")
Rel(Compliance_IT_Administrator, Clinic_Management_System, "Manages infrastructure, security policies, and system configuration", "HTTPS, TLS 1.3, OAuth2/OIDC tokens, MFA")
Rel(Clinic_Management_System, Insurance_Third_Party_Payer_Gateway, "Submits and processes insurance claims asynchronously", "mTLS, asynchronous message queues")
Rel(External_Lab_Imaging_Systems, Clinic_Management_System, "Sends lab results and medical imaging data", "HL7 FHIR APIs")

@enduml