@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Patient, "Patient", "End-user interacting to manage appointments, view records, and handle billing.")
Person(Clinic_Receptionist_Staff, "Clinic Receptionist/Staff", "Administrative personnel managing patient admissions, check-ins, and front-desk scheduling.")
Person(Clinician_Doctor, "Clinician/Doctor", "Medical professional accessing and updating electronic medical records and patient schedules.")
Person(Billing_Specialist, "Billing Specialist", "Financial staff handling invoicing, payments, and insurance claims processing.")
Person(Compliance_IT_Administrator, "Compliance/IT Administrator", "System administrator managing security, access controls, infrastructure, and regulatory compliance.")

System_Ext(Insurance_Third_Party_Payer_Gateway, "Insurance/Third-Party Payer Gateway", "External financial gateway for processing insurance claims and third-party payments.")
System_Ext(External_Lab_Imaging_Systems, "External Lab & Imaging Systems", "External medical diagnosis systems providing lab results and imaging data.")

System_Boundary(Clinic_Management_System, "Clinic Management System") {
    Container(API_Gateway, "API Gateway", "Kubernetes Ingress / Istio", "Entry point for all incoming traffic, handling routing, security validation, and rate limiting.")
    Container(Patient_Registration, "Patient Registration", "Spring Boot / Kubernetes", "Manages patient admissions and registration workflows.")
    Container(Appointment_Scheduling, "Appointment Scheduling", "Spring Boot / Kubernetes", "Handles booking, rescheduling, and management of clinical appointments.")
    Container(EMR_Service, "EMR Service", "Spring Boot / Kubernetes", "Manages Electronic Medical Records, clinical notes, and patient history.")
    Container(Billing_Insurance_Service, "Billing & Insurance Service", "Spring Boot / Kubernetes", "Handles invoicing, payments, and insurance claims integration.")
}

Rel(Patient, API_Gateway, "Interacts with the system via web or mobile interface", "HTTPS with MFA and ABAC")
Rel(Clinic_Receptionist_Staff, API_Gateway, "Manages patient admissions and scheduling", "HTTPS with MFA and ABAC")
Rel(Clinician_Doctor, API_Gateway, "Accesses and updates electronic medical records", "HTTPS with MFA and ABAC")
Rel(Billing_Specialist, API_Gateway, "Manages billing and claims processing", "HTTPS with MFA and ABAC")
Rel(Compliance_IT_Administrator, API_Gateway, "Manages security policies and infrastructure configurations", "HTTPS with MFA and ABAC")

Rel(API_Gateway, Patient_Registration, "Routes patient registration requests", "Istio mTLS")
Rel(API_Gateway, Appointment_Scheduling, "Routes scheduling requests", "Istio mTLS")
Rel(API_Gateway, EMR_Service, "Routes EMR requests", "Istio mTLS")
Rel(API_Gateway, Billing_Insurance_Service, "Routes billing requests", "Istio mTLS")

Rel(Billing_Insurance_Service, Insurance_Third_Party_Payer_Gateway, "Sends claims and billing information", "HL7 FHIR APIs and secure asynchronous retry queues")
Rel(EMR_Service, External_Lab_Imaging_Systems, "Exchanges clinical data and lab results", "HL7 FHIR APIs and secure asynchronous retry queues")

@enduml