@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(emr_service, "EMR Service") {
    Component(EMR_API_Controller, "EMR API Controller", "Spring Boot / REST", "Exposes clinical endpoints to handle patient electronic medical records requests securely.")
    Component(FHIR_Integration_Client, "FHIR Integration Client", "Spring Boot / HL7 FHIR", "Exchanges clinical data and lab results with external lab and imaging systems.")
    Component(Encryption_and_Audit_Service, "Encryption and Audit Service", "AES-256 / OpenTelemetry / FluentBit", "Enforces field-level encryption for PHI and handles asynchronous sidecar audit logging.")
}

Rel(EMR_API_Controller, Encryption_and_Audit_Service, "Enforces field-level encryption and logs requests")
Rel(EMR_API_Controller, FHIR_Integration_Client, "Delegates clinical data exchange")

@enduml