@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(Perimeter Router, "Perimeter Router", "Kubernetes Ingress / Istio", "Handles perimeter routing, TLS termination, and WAF.")
    Component(Token Exchange Service, "Token Exchange Service", "OAuth2/OIDC & JWT/PASETO", "Manages perimeter token exchange and fine-grained ABAC claims enforcement.")
}

Rel(Perimeter Router, Token Exchange Service, "Forwards requests for token validation and exchange", "HTTPS with MFA and ABAC")

@enduml