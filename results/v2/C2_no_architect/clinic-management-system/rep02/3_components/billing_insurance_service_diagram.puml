@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(billing_insurance_service, "Billing & Insurance Service") {
    Component(Billing_Controller, "Billing Controller", "Spring Boot / REST API", "Handles incoming HTTP requests for financial operations, claims submission, and patient self-service ledgers.")
    Component(Claims_Service, "Claims Service", "Spring Boot / Service Layer", "Manages insurance claims processing and asynchronous retries.")
    Component(Payment_Processor, "Payment Processor", "Spring Boot / Service Layer", "Tokenizes and processes payments securely via external payment gateways.")
    Component(Billing_Database_Repository, "Billing Database Repository", "Spring Data JPA / AES-256", "Handles transactional data queries and routes analytics to read replicas with encrypted storage.")
}

Rel(Billing_Controller, Claims_Service, "Delegates claims submission and status tracking requests", "Internal Method Invocation")
Rel(Billing_Controller, Payment_Processor, "Delegates payment tokenization and processing requests", "Internal Method Invocation")
Rel(Claims_Service, Billing_Database_Repository, "Persists and queries claim and ledger transactions", "JPA / JDBC")
Rel(Payment_Processor, Billing_Database_Repository, "Persists payment and tokenization records", "JPA / JDBC")
@enduml