@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient Registration container

Container_Boundary(patient_registration, "Patient Registration") {
    Component(Admission_Controller, "Admission Controller", "Spring Boot Controller", "Handles public and internal patient admission requests routed from the API Gateway.")
    Component(Notification_Dispatcher, "Notification Dispatcher", "Spring Boot Service", "Dispatches asynchronous OTP and notification messages to external messaging brokers.")
    Component(Session_and_Rate_Limiter, "Session and Rate Limiter", "Spring Boot Component", "Interacts with Redis to enforce rate-limiting and manage user sessions during registration.")
}

Rel(Admission_Controller, Session_and_Rate_Limiter, "Validates sessions and enforces rate-limiting")
Rel(Admission_Controller, Notification_Dispatcher, "Triggers asynchronous notifications")
@enduml