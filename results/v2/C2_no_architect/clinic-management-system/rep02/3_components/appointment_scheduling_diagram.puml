@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Appointment Scheduling container

Container_Boundary(appointment_scheduling, "Appointment Scheduling") {
    Component(Appointment_Controller, "Appointment Controller", "Spring Boot REST Controller", "Handles incoming appointment booking and scheduling requests from the API Gateway.")
    Component(Appointment_Service, "Appointment Service", "Spring Boot Service", "Contains business logic for appointment management and coordinates distributed locking.")
    Component(Event_Publisher, "Event Publisher", "Spring Kafka / AMQP Client", "Publishes asynchronous appointment events to the notification dispatcher.")
}

Rel(Appointment_Controller, Appointment_Service, "Delegates validated booking requests", "Java Method Invocation")
Rel(Appointment_Service, Event_Publisher, "Triggers async event publishing", "Kafka / AMQP")

@enduml