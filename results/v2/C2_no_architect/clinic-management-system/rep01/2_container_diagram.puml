@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Patients, "Patients", "Individuals receiving care who interact with the system via web or mobile frontends.")
Person(Receptionists, "Receptionists", "Staff members handling patient admissions and scheduling.")
Person(Clinicians, "Clinicians", "Medical professionals managing electronic medical records and patient care.")
Person(Billing Specialists, "Billing Specialists", "Personnel managing financial records and insurance claims.")
Person(Hospital Administrators, "Hospital Administrators", "Management overseeing overall system operations and compliance.")

System_Ext(Insurance Clearinghouses, "Insurance Clearinghouses", "External systems processing billing claims via secure REST APIs.")
System_Ext(External Labs/Imaging Vendors, "External Labs/Imaging Vendors", "External diagnostic systems integrating via HL7 FHIR protocols.")

System_Boundary(Clinic Management System, "Clinic Management System") {
    Container(WAF Container, "WAF Container", "Web Application Firewall", "Inspects and filters incoming HTTP/HTTPS traffic for security threats.")
    Container(API Gateway, "API Gateway", "Kubernetes Ingress / Gateway API", "Routes incoming requests and enforces security policies.")
    Container(Patient Portal Container, "Patient Portal Container", "Web / Mobile Frontend", "Provides interface for patients to access portals, scheduling, and records.")
    Container(EMR Container, "EMR Container", "Microservice / REST / gRPC", "Manages electronic medical records and clinical data storage.")
    Container(Scheduling Container, "Scheduling Container", "Microservice / REST / gRPC", "Handles appointment scheduling and resource allocation.")
    Container(Billing Container, "Billing Container", "Microservice / REST / gRPC", "Manages financial records, billing, and insurance claim integration.")
    Container(Notification Container, "Notification Container", "Microservice / REST / gRPC", "Sends notifications and alerts to users and external entities.")
    Container(Analytics & Reporting Container, "Analytics & Reporting Container", "Microservice / Data Processing", "Handles data analysis, reporting, and audit compliance logs.")
    ContainerDb(PostgreSQL Databases, "PostgreSQL Databases", "PostgreSQL with Patroni/etcd", "Active-passive clustered relational databases with field-level PHI encryption.")
    Container(Event Broker, "Event Broker", "Apache Kafka / RabbitMQ", "Asynchronous message broker for decoupled event-driven integration.")
    Container(Immutable Audit Storage Sink, "Immutable Audit Storage Sink", "Secure Storage", "Stores immutable audit logs for regulatory compliance.")
    Container(HashiCorp Vault, "HashiCorp Vault", "Secrets Management / AES-256", "Hardware-backed key management and secrets storage.")
}

Rel(Patients, WAF Container, "Accesses system via secure HTTPS requests", "HTTPS (TLS 1.3), OAuth2/OIDC, MFA")
Rel(Receptionists, WAF Container, "Accesses system via secure HTTPS requests", "HTTPS (TLS 1.3), OAuth2/OIDC, MFA")
Rel(Clinicians, WAF Container, "Accesses system via secure HTTPS requests", "HTTPS (TLS 1.3), OAuth2/OIDC, MFA")
Rel(Billing Specialists, WAF Container, "Accesses system via secure HTTPS requests", "HTTPS (TLS 1.3), OAuth2/OIDC, MFA")
Rel(Hospital Administrators, WAF Container, "Accesses system via secure HTTPS requests", "HTTPS (TLS 1.3), OAuth2/OIDC, MFA")

Rel(WAF Container, API Gateway, "Forwards filtered traffic to", "HTTPS")

Rel(API Gateway, Patient Portal Container, "Routes client requests to", "HTTPS, mTLS via SPIFFE/SPIRE")
Rel(API Gateway, EMR Container, "Routes client requests to", "HTTPS, mTLS via SPIFFE/SPIRE")
Rel(API Gateway, Scheduling Container, "Routes client requests to", "HTTPS, mTLS via SPIFFE/SPIRE")
Rel(API Gateway, Billing Container, "Routes client requests to", "HTTPS, mTLS via SPIFFE/SPIRE")
Rel(API Gateway, Analytics & Reporting Container, "Routes client requests to", "HTTPS, mTLS via SPIFFE/SPIRE")

Rel(EMR Container, Event Broker, "Publishes and consumes events asynchronously", "Apache Kafka / RabbitMQ")
Rel(Scheduling Container, Event Broker, "Publishes and consumes events asynchronously", "Apache Kafka / RabbitMQ")
Rel(Billing Container, Event Broker, "Publishes and consumes events asynchronously", "Apache Kafka / RabbitMQ")
Rel(Notification Container, Event Broker, "Consumes events to trigger notifications", "Apache Kafka / RabbitMQ")
Rel(Analytics & Reporting Container, Event Broker, "Consumes events for analytics processing", "Apache Kafka / RabbitMQ")

Rel(EMR Container, PostgreSQL Databases, "Reads and writes clinical data with field-level encryption", "Active-Passive Replication, SQL")
Rel(Scheduling Container, PostgreSQL Databases, "Reads and writes scheduling data", "Active-Passive Replication, SQL")
Rel(Billing Container, PostgreSQL Databases, "Reads and writes financial data", "Active-Passive Replication, SQL")

Rel(Billing Container, Insurance Clearinghouses, "Processes claims via secure APIs", "Secure HTTPS REST APIs")
Rel(EMR Container, External Labs/Imaging Vendors, "Exchanges lab results and imaging data", "HL7 FHIR protocols, HTTPS")

Rel(Analytics & Reporting Container, Immutable Audit Storage Sink, "Writes long-term compliance audit records", "Secure Storage Sink")

Rel(EMR Container, HashiCorp Vault, "Retrieves encryption keys and secrets", "AES-256 Key Management")
Rel(Billing Container, HashiCorp Vault, "Retrieves encryption keys and secrets", "AES-256 Key Management")

@enduml