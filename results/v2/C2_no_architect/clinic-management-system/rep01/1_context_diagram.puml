@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "Individuals receiving care who interact with the system via web or mobile frontends.")
Person(Receptionists, "Receptionists", "Staff members handling patient admissions and scheduling.")
Person(Clinicians, "Clinicians", "Medical professionals managing electronic medical records and patient care.")
Person(BillingSpecialists, "Billing Specialists", "Personnel managing financial records and insurance claims.")
Person(HospitalAdministrators, "Hospital Administrators", "Management overseeing overall system operations and compliance.")

System(ClinicManagementSystem, "Clinic Management System", "A hybrid cloud platform managing patient admissions, electronic medical records, scheduling, and billing for medium-sized hospitals with high availability, HIPAA/GDPR compliance, and sub-second EMR performance.")

System_Ext(InsuranceClearinghouses, "Insurance Clearinghouses", "External systems processing billing claims via secure REST APIs with OAuth 2.1 authentication.")
System_Ext(ExternalLabsImagingVendors, "External Labs/Imaging Vendors", "External diagnostic systems integrating via HL7 FHIR APIs over TLS 1.3.")

Rel(Patients, ClinicManagementSystem, "Interacts via web/mobile frontends for admissions, scheduling, and records", "HTTPS, TLS 1.3")
Rel(Receptionists, ClinicManagementSystem, "Interacts via web/mobile frontends for patient admissions and scheduling", "HTTPS, TLS 1.3")
Rel(Clinicians, ClinicManagementSystem, "Interacts via web/mobile frontends for EMR and clinical management", "HTTPS, TLS 1.3")
Rel(BillingSpecialists, ClinicManagementSystem, "Interacts via web/mobile frontends for billing and financial operations", "HTTPS, TLS 1.3")
Rel(HospitalAdministrators, ClinicManagementSystem, "Interacts via web/mobile frontends for administration and monitoring", "HTTPS, TLS 1.3")
Rel(InsuranceClearinghouses, ClinicManagementSystem, "Integrates for claim processing and billing workflows", "Secure REST APIs, OAuth 2.1")
Rel(ExternalLabsImagingVendors, ClinicManagementSystem, "Integrates for lab results and imaging data exchange", "HL7 FHIR APIs, TLS 1.3")
@enduml