@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient Portal Container container

Container_Boundary(patient_portal_container, "Patient Portal Container") {
    Component(Web_and_Mobile_Frontend, "Web and Mobile Frontend", "Web / Mobile Frontend", "Provides the user interface for patients to access admissions, records, and scheduling.")
    Component(Patient_Portal_Router, "Patient Portal Router", "REST and gRPC over mTLS", "Handles routing and communication between the frontend and the API Gateway.")
}

Rel(Web_and_Mobile_Frontend, Patient_Portal_Router, "Communicates using REST and gRPC over mTLS", "REST and gRPC over mTLS")

@enduml