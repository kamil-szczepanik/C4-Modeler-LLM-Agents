@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(waf_container, "WAF Container") {
    Component(Web_Application_Firewall_Engine, "Web Application Firewall Engine", "OWASP Core Rule Set & Reverse Proxy", "Perimeter security protecting against OWASP threats and enforcing strict HIPAA and GDPR compliance.")
    Component(In_Memory_Redaction_Engine, "In-Memory Redaction Engine", "Custom In-Memory Filter", "Masks Protected Health Information (PHI) and sensitive data dynamically in transit.")
}

Rel(Web_Application_Firewall_Engine, In_Memory_Redaction_Engine, "Inspects and sanitizes filtered traffic")

@enduml