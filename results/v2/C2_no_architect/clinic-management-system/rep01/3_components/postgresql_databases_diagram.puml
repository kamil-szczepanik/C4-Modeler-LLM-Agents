@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(postgresql_databases, "PostgreSQL Databases") {
    Component(patroni_etcd_clustering_engine, "Patroni/etcd Clustering Engine", "Patroni, etcd", "Provides high-availability active-passive clustering with automated failover for PostgreSQL.")
    Component(pgbouncer_connection_pooler, "PgBouncer Connection Pooler", "PgBouncer", "Manages and pools database connections to prevent starvation under heavy concurrent clinical usage.")
    Component(pgaudit_module, "pgaudit Module", "pgaudit", "Captures tamper-evident audit logs of DDL and DML operations on PHI tables.")
}

Rel(pgbouncer_connection_pooler, patroni_etcd_clustering_engine, "Routes pooled SQL queries", "SQL/TLS")
Rel(patroni_etcd_clustering_engine, pgaudit_module, "Generates audit logs", "Internal")

@enduml