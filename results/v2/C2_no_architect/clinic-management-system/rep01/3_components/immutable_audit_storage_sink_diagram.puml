@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(immutable_audit_storage_sink, "Immutable Audit Storage Sink") {
    Component(AuditIngestionEngine, "Audit Ingestion Engine", "Golang, S3 API", "Receives compliance and audit records securely via mTLS and ingests them into storage.")
    Component(WORMStorageController, "WORM Storage Controller", "AWS S3 Object Lock, MinIO", "Enforces 10-year Write-Once-Read-Many (WORM) retention policies on audit logs.")
    Component(ComplianceQueryAPI, "Compliance Query API", "REST, TLS", "Provides secure, read-only query capabilities for compliance officers using ephemeral credentials.")
}

Rel(AuditIngestionEngine, WORMStorageController, "Writes immutable compliance records to")
Rel(ComplianceQueryAPI, WORMStorageController, "Queries stored audit logs from")
@enduml