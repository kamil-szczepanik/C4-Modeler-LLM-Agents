@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Analytics & Reporting Container container

Container_Boundary("Analytics & Reporting Container", "Analytics & Reporting Container") {
    Component(Metrics_Ingestion_Service, "Metrics Ingestion Service", "Asynchronous Microservice Container", "Processes operational metrics and compliance reports securely.")
    Component(Data_Masking_Engine, "Data Masking Engine", "Data Processing Module", "Enforces strict data minimization and dynamic masking for HIPAA and GDPR compliance.")
}

Rel(Metrics_Ingestion_Service, Data_Masking_Engine, "Processes and masks operational data", "")

@enduml