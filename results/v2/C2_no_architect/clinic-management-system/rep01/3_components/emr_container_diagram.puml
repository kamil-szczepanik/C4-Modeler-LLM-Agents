@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(emr_container, "EMR Container") {
    Component(EMRServiceController, "EMR Service Controller", "REST / gRPC", "Manages incoming clinical record requests and routes them to core business logic.")
    Component(ClinicalDataManager, "Clinical Data Manager", "Go / Java", "Handles electronic medical records, clinical data processing, and enforcement of row-level security.")
    Component(FHIRInteroperabilityAdapter, "FHIR Interoperability Adapter", "HL7 FHIR over HTTPS", "Exchanges lab and imaging data securely with external vendors.")
}

Rel(EMRServiceController, ClinicalDataManager, "Delegates core business logic and clinical data operations", "")
Rel(ClinicalDataManager, FHIRInteroperabilityAdapter, "Sends and receives standardized healthcare data for external exchange", "")

@enduml