@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing Container container

System_Ext(EventBroker, "Event Broker", "Apache Kafka for asynchronous message processing and decoupled claim pipelines")
System_Ext(PostgreSQLDatabases, "PostgreSQL Databases", "Primary data store with Patroni/etcd for active-passive replication")
System_Ext(InsuranceClearinghouses, "Insurance Clearinghouses", "External third-party systems for claim processing")
System_Ext(HashiCorpVault, "HashiCorp Vault", "Secrets management and AES-256 key retrieval")
System_Ext(ImmutableAuditStorageSink, "Immutable Audit Storage Sink", "Tamper-evident storage for financial and security audit logs")

Container_Boundary(BillingContainer_boundary, "Billing Container") {
    Component(BillingContainer, "Billing Container", "Microservice", "Handles financial records, claim submission, and patient ledger queries.")
}

Rel(BillingContainer, EventBroker, "Publishes and consumes financial events asynchronously", "Apache Kafka")
Rel(BillingContainer, PostgreSQLDatabases, "Reads and writes financial data", "SQL with Active-Passive Replication")
Rel(BillingContainer, InsuranceClearinghouses, "Submits claims and tracks statuses", "HTTPS REST APIs with TLS 1.3")
Rel(BillingContainer, HashiCorpVault, "Retrieves AES-256 keys and rotates database credentials securely", "HTTPS")
Rel(BillingContainer, ImmutableAuditStorageSink, "Synchronously emits tamper-evident financial audit logs", "Secure Protocol")

@enduml