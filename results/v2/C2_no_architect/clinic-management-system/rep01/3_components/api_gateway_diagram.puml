@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Ingress_Router, "Ingress Router", "Kubernetes Ingress / Gateway API", "Routes client requests via HTTPS with mTLS and enforces OWASP top 10 guardrails.")
    Component(Auth_Validator, "Auth Validator", "OAuth2/OIDC & SPIFFE/SPIRE", "Performs token validation, OAuth2/OIDC validation, and persona-based rate limiting.")
    Component(Gateway_Cache_Client, "Gateway Cache Client", "Redis Client", "Performs local authorization caching and token validation.")
    Component(Secrets_Manager_Integration, "Secrets Manager Integration", "HashiCorp Vault & cert-manager", "Retrieves secrets and manages automated TLS lifecycles.")
}

Rel(Ingress_Router, Auth_Validator, "Delegates token validation and rate limiting")
Rel(Auth_Validator, Gateway_Cache_Client, "Performs local authorization caching")
Rel(Ingress_Router, Secrets_Manager_Integration, "Retrieves secrets and manages TLS")

@enduml