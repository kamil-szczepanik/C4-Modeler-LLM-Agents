@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(notification_container, "Notification Container") {
    Component(Notification_Dispatcher, "Notification Dispatcher", "Stateless Microservice / REST / gRPC", "Dispatches multi-channel alerts to third-party SMS, Email, and Push gateway APIs.")
    Component(Event_Consumer, "Event Consumer", "Apache Kafka / RabbitMQ Consumer", "Consumes clinical and operational events from the Event Broker.")
    Component(Audit_Logger, "Audit Logger", "Secure Protocol", "Emits delivery receipts to the Immutable Audit Storage Sink for 10-year retention.")
    Component(Secrets_Manager_Client, "Secrets Manager Client", "mTLS / API", "Dynamically fetches provider API keys and secrets from HashiCorp Vault.")
}

System_Ext(Third_party_SMS_Email_and_Push_Gateway_APIs, "Third-party SMS, Email, and Push Gateway APIs", "External API")
System_Ext(Immutable_Audit_Storage_Sink, "Immutable Audit Storage Sink", "External Storage")
System_Ext(HashiCorp_Vault, "HashiCorp Vault", "Secrets Management")

Rel(Event_Consumer, Notification_Dispatcher, "Passes consumed clinical and operational events for processing", "Apache Kafka / RabbitMQ")
Rel(Notification_Dispatcher, Third_party_SMS_Email_and_Push_Gateway_APIs, "Dispatches multi-channel alerts", "TLS 1.3, HTTPS")
Rel(Notification_Dispatcher, Audit_Logger, "Triggers emission of delivery receipts")
Rel(Audit_Logger, Immutable_Audit_Storage_Sink, "Emits delivery receipts for 10-year retention", "Secure Protocol")
Rel(Secrets_Manager_Client, HashiCorp_Vault, "Dynamically fetches provider API keys and secrets", "mTLS / API")

@enduml