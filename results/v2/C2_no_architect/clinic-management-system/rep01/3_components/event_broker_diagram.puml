@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Event Broker container

Container_Boundary(event_broker, "Event Broker") {
    Component(Message_Ingestion_Handler, "Message Ingestion Handler", "Apache Kafka / RabbitMQ", "Ingests asynchronous events from microservices via mTLS.")
    Component(Schema_Registry_Validator, "Schema Registry Validator", "Avro/JSON Schema Registry", "Validates incoming event payloads against defined schemas.")
    Component(Event_Routing_Engine, "Event Routing Engine", "Apache Kafka / RabbitMQ Core", "Routes and distributes asynchronous messages to appropriate consuming microservices.")
}

Rel(Message_Ingestion_Handler, Schema_Registry_Validator, "Validates message payloads")
Rel(Schema_Registry_Validator, Event_Routing_Engine, "Forwards validated events for routing")
@enduml