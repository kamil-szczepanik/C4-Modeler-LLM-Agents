@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Scheduling Container container

Container_Boundary(scheduling_container, "Scheduling Container") {
    Component(Scheduling_Controller, "Scheduling Controller", "gRPC and REST APIs", "Handles incoming routing requests from the API Gateway and routes HTTPS and mTLS requests.")
    Component(Reservation_Service, "Reservation Service", "Active-Active Consensus", "Executes atomic reservation locks and SQL reads/writes against the PostgreSQL Databases.")
    Component(Event_Publisher, "Event Publisher", "Apache Kafka / RabbitMQ", "Publishes and consumes asynchronous events with the Event Broker.")
}

Rel(Scheduling_Controller, Reservation_Service, "Invokes atomic reservation logic")
Rel(Reservation_Service, Event_Publisher, "Triggers asynchronous event publication")
@enduml