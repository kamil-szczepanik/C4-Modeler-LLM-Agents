@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(FrontDeskStaff, "Front Desk Staff", "Manages patient admissions and registration workflows.")
Person(Clinicians, "Clinicians", "Accesses and updates electronic medical records and patient workflows.")
Person(BillingOfficers, "Billing Officers", "Handles financial and billing operations.")
Person(Patients, "Patients", "Receives care and interacts with hospital services.")
Person(PatientPortalUsers, "Patient Portal Users", "Interacts with portal services for health records and scheduling.")

System_Ext(ExternalLabSystems, "External Lab Systems", "External laboratory systems for processing and retrieving test results.")
System_Ext(ExternalImagingSystems, "External Imaging Systems", "External imaging systems for storing and retrieving diagnostic scans.")

System_Boundary(ClinicManagementSystem, "Clinic Management System") {
    Container(IngressController, "Ingress Controller", "Kubernetes Ingress / Istio", "Manages incoming traffic with OAuth2/OIDC and MFA enforcement.")
    Container(PatientRegistrationContainer, "Patient Registration Container", "Microservice / Kubernetes", "Handles patient admission and onboarding.")
    Container(AppointmentSchedulingContainer, "Appointment Scheduling Container", "Microservice / Kubernetes", "Manages appointments and clinical schedules.")
    Container(EMRContainer, "EMR Container", "Microservice / Kubernetes", "Processes and stores electronic medical records with asynchronous audit trails.")
    Container(BillingAndInsuranceClaimContainer, "Billing & Insurance Claim Container", "Microservice / Kubernetes", "Processes financial transactions and insurance claims.")
    Container(HL7FHIRInteroperabilityEngine, "HL7 FHIR Interoperability Engine", "HL7 FHIR REST APIs", "Facilitates data exchange with external lab and imaging systems.")
    ContainerDb(PostgreSQLMySQLHybridDatabases, "PostgreSQL/MySQL Hybrid Databases", "PostgreSQL/MySQL (AES-256)", "Stores relational data securely with AES-256 encryption.")
    ContainerDb(WORMCompliantLogStorage, "WORM-Compliant Log Storage", "WORM Storage", "Stores immutable audit logs for compliance.")
}

Rel(FrontDeskStaff, IngressController, "Interacts for patient admissions and registration", "HTTPS (TLS 1.3)")
Rel(Clinicians, IngressController, "Interacts for clinical workflows and EMR access", "HTTPS (TLS 1.3)")
Rel(BillingOfficers, IngressController, "Interacts for billing and financial operations", "HTTPS (TLS 1.3)")
Rel(Patients, IngressController, "Interacts for care and hospital services", "HTTPS (TLS 1.3)")
Rel(PatientPortalUsers, IngressController, "Accesses portal services", "HTTPS (TLS 1.3)")

Rel(IngressController, PatientRegistrationContainer, "Routes authenticated traffic", "mTLS (Istio Service Mesh)")
Rel(IngressController, AppointmentSchedulingContainer, "Routes authenticated traffic", "mTLS (Istio Service Mesh)")
Rel(IngressController, EMRContainer, "Routes authenticated traffic", "mTLS (Istio Service Mesh)")
Rel(IngressController, BillingAndInsuranceClaimContainer, "Routes authenticated traffic", "mTLS (Istio Service Mesh)")

Rel(EMRContainer, PostgreSQLMySQLHybridDatabases, "Persists and retrieves encrypted medical records", "TCP/AES-256")
Rel(PatientRegistrationContainer, PostgreSQLMySQLHybridDatabases, "Persists patient registration data", "TCP/AES-256")

Rel(HL7FHIRInteroperabilityEngine, ExternalLabSystems, "Exchanges lab data", "HTTPS/HL7 FHIR REST APIs")
Rel(HL7FHIRInteroperabilityEngine, ExternalImagingSystems, "Exchanges imaging data", "HTTPS/HL7 FHIR REST APIs")

Rel(EMRContainer, WORMCompliantLogStorage, "Sends asynchronous audit logs", "gRPC/TLS")
Rel(PatientRegistrationContainer, WORMCompliantLogStorage, "Sends asynchronous audit logs", "gRPC/TLS")

@enduml