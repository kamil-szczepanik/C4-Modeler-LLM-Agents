@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Clinic Management System

Person(Front_Desk_Staff, "Front Desk Staff", "Manages patient admissions and registration workflows.")
Person(Clinicians, "Clinicians", "Accesses and updates electronic medical records and patient workflows.")
Person(Billing_Officers, "Billing Officers", "Handles financial and billing operations.")
Person(Patients, "Patients", "Receives care and interacts with hospital services.")
Person(Patient_Portal_Users, "Patient Portal Users", "Interacts with portal services for health records and scheduling.")

System(Clinic_Management_System, "Clinic Management System", "Manages patient admissions, electronic medical records, scheduling, and billing for medium-sized hospitals and clinics, delivering high availability, regulatory compliance, and sub-second clinical workflows.")

System_Ext(Lab_Systems, "Lab Systems", "External laboratory systems for processing and retrieving test results.")
System_Ext(Imaging_Systems, "Imaging Systems", "External imaging systems for storing and retrieving diagnostic scans.")

Rel(Front_Desk_Staff, Clinic_Management_System, "Interacts for patient admissions and registration", "TLS 1.3 and Multi-Factor Authentication (MFA)")
Rel(Clinicians, Clinic_Management_System, "Interacts for clinical workflows and EMR access", "TLS 1.3 and Multi-Factor Authentication (MFA)")
Rel(Billing_Officers, Clinic_Management_System, "Interacts for billing and financial operations", "TLS 1.3 and Multi-Factor Authentication (MFA)")
Rel(Patients, Clinic_Management_System, "Interacts for care and hospital services", "TLS 1.3 and Multi-Factor Authentication (MFA)")
Rel(Patient_Portal_Users, Clinic_Management_System, "Accesses portal services", "TLS 1.3 and Multi-Factor Authentication (MFA)")
Rel(Clinic_Management_System, Lab_Systems, "Integrates for lab data exchange", "HL7 FHIR APIs over encrypted protocols")
Rel(Clinic_Management_System, Imaging_Systems, "Integrates for imaging data exchange", "HL7 FHIR APIs over encrypted protocols")

@enduml