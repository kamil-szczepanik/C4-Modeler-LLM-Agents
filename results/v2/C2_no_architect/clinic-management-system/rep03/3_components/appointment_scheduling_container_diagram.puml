@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Appointment Scheduling Container container

Container_Boundary("Appointment Scheduling Container", "Appointment Scheduling Container") {
    Component(Appointment Controller, "Appointment Controller", "Spring REST Controller", "Handles incoming HTTP requests for appointment scheduling and routes authenticated traffic.")
    Component(Scheduling Service, "Scheduling Service", "Java / Spring Boot", "Contains business logic for scheduling appointments and performs distributed locking checks.")
    Component(Notification Dispatcher, "Notification Dispatcher", "Async Event Publisher", "Publishes asynchronous messages for SMS and email reminders to the message broker.")
}

System_Ext(Redis Redlock, "Redis Redlock", "Distributed locking service")
System_Ext(Kafka/RabbitMQ Message Broker, "Kafka/RabbitMQ Message Broker", "Message broker for asynchronous events")
System_Ext(WORM-Compliant Log Storage, "WORM-Compliant Log Storage", "Tamper-evident log storage")

Rel(Appointment Controller, Scheduling Service, "Invokes business logic for schedule creation and validation", "")
Rel(Scheduling Service, Redis Redlock, "Performs distributed locking for concurrent multi-resource clash checks", "")
Rel(Scheduling Service, Kafka/RabbitMQ Message Broker, "Asynchronously decouples SMS/email reminders", "")
Rel(Scheduling Service, WORM-Compliant Log Storage, "Streams audit logs asynchronously via Fluentbit sidecar", "")

@enduml