@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(ingress_controller, "Ingress Controller") {
    Component(api_gateway_router, "API Gateway Router", "Kubernetes Ingress / Istio Envoy", "Routes authenticated HTTPS traffic from users to internal clinical containers securely.")
    Component(tls_termination_and_security_policy_enforcer, "TLS Termination and Security Policy Enforcer", "TLS 1.3 / OAuth2 / OIDC", "Handles TLS 1.3 termination, edge token validation, and JWKS local caching.")
}

Rel(api_gateway_router, tls_termination_and_security_policy_enforcer, "Validates tokens and enforces security policies", "mTLS")

@enduml