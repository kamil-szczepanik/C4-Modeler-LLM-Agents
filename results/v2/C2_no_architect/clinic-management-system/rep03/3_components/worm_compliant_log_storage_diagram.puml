@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(worm_compliant_log_storage, "WORM-Compliant Log Storage") {
    Component(Metadata_Indexing_Layer, "Metadata Indexing Layer", "PostgreSQL/MySQL Hybrid Databases", "Indexes audit log metadata for efficient querying and reporting while maintaining immutability guarantees.")
    Component(Local_Buffering_Proxy, "Local-Buffering Proxy", "Edge-Buffering Proxy with TPM/HSM-backed edge encryption", "Buffers asynchronous audit logs locally during intermittent network disconnections before forwarding securely.")
}

Rel(Local_Buffering_Proxy, Metadata_Indexing_Layer, "Indexes incoming asynchronous audit logs", "gRPC/TLS with mTLS")

@enduml