@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("PostgreSQL/MySQL Hybrid Databases", "PostgreSQL/MySQL Hybrid Databases") {
    Component(PatroniOrchestratorReplicationManager, "Patroni/Orchestrator Replication Manager", "Patroni / Orchestrator", "Manages semi-synchronous replication and automated failover for the database instances.")
    Component(PgBouncerConnectionPooler, "PgBouncer Connection Pooler", "PgBouncer", "Handles connection pooling to optimize database performance and concurrency.")
    Component(AuditLogger, "Audit Logger", "pgaudit / Syslog", "Generates and streams database audit logs to WORM-compliant storage.")
}

Rel(PatroniOrchestratorReplicationManager, PgBouncerConnectionPooler, "Maintains high availability across database nodes serving connections")
Rel(PgBouncerConnectionPooler, AuditLogger, "Transmits database transaction and access records")

@enduml