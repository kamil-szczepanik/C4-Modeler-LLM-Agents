@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Billing & Insurance Claim Container", "Billing & Insurance Claim Container") {
    Component(Claim Validation Controller, "Claim Validation Controller", "Microservice REST API / OpenAPI", "Handles incoming HTTP requests, validates claim schemas, and enforces RBAC for billing officers.")
    Component(Claim Processing Service, "Claim Processing Service", "Business Logic Microservice", "Core logic for processing financial transactions, managing claim submissions, and integrating with external clearinghouses.")
    Component(Encryption Manager, "Encryption Manager", "HashiCorp Vault / AWS KMS", "Handles envelope encryption and AES-256 data protection at rest and message-level encryption.")
}

Rel(Claim Validation Controller, Claim Processing Service, "Delegates validated claims for processing")
Rel(Claim Processing Service, Encryption Manager, "Requests cryptographic operations for data and messages")
@enduml