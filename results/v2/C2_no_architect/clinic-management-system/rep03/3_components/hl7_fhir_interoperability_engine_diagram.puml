@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(hl7_fhir_interoperability_engine, "HL7 FHIR Interoperability Engine") {
    Component(FHIR_API_Router, "FHIR API Router", "Node.js / Express with SMART-on-FHIR", "Routes incoming HL7 FHIR REST API requests and validates OAuth 2.0 / SMART-on-FHIR tokens.")
    Component(mTLS_Communication_Handler, "mTLS Communication Handler", "Istio Service Mesh / Envoy Proxy", "Manages secure mutual TLS (mTLS) connections for exchanging diagnostic and imaging data with external systems.")
    Component(Data_Transformation_Service, "Data Transformation Service", "TypeScript / FHIR Validator Library", "Transforms internal data models into standardized HL7 FHIR resources for clinical interoperability.")
}

System_Ext(External_Lab_Systems, "External Lab Systems", "External lab systems for diagnostic data.")
System_Ext(External_Imaging_Systems, "External Imaging Systems", "External imaging systems for medical imaging data.")

Rel(FHIR_API_Router, Data_Transformation_Service, "Forwards validated payloads for mapping")
Rel(Data_Transformation_Service, mTLS_Communication_Handler, "Dispatches standardized FHIR resources")
Rel(mTLS_Communication_Handler, External_Lab_Systems, "Exchanges diagnostic data via HTTPS/HL7 FHIR REST APIs with mTLS")
Rel(mTLS_Communication_Handler, External_Imaging_Systems, "Exchanges imaging data via HTTPS/HL7 FHIR REST APIs with mTLS")

@enduml