@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the EMR Container container

Container_Boundary(emr_container, "EMR Container") {
    Component(EMR API Controller, "EMR API Controller", "Spring Boot / REST", "Exposes endpoints for electronic medical records management and patient history retrieval.")
    Component(EMR Business Logic Service, "EMR Business Logic Service", "Java / Microservice", "Handles core clinical logic, medical record validation, and data processing.")
    Component(Encryption & Persistence Module, "Encryption & Persistence Module", "Hibernate / AES-256", "Manages secure data encryption and communication with the hybrid databases.")
}

Rel(EMR API Controller, EMR Business Logic Service, "Delegates request processing")
Rel(EMR Business Logic Service, Encryption & Persistence Module, "Persists and retrieves encrypted medical records")

@enduml