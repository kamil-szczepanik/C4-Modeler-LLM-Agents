@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(LibraryPatronsMembers, "Library Patrons (Members)", "Access self-service portals to search catalogues and manage loans.")
Person(LibrariansLibraryStaff, "Librarians / Library Staff", "Utilize circulation and cataloguing tools for inventory management.")
Person(LibraryAdministrators, "Library Administrators", "Handle reporting and user management.")

System(LibraryManagementSystem, "Library Management System", "Provides cataloguing, circulation, and self-service portals for public and academic libraries while strictly adhering to EU-only data residency constraints for GDPR compliance.")

System_Ext(InterLibraryLoanILLPartners, "Inter-Library Loan (ILL) Partners", "External library systems for resource sharing.")
System_Ext(PaymentGatewaysNotificationServices, "Payment Gateways & Notification Services", "External SaaS for processing fines and alerts.")

Rel(LibraryPatronsMembers, LibraryManagementSystem, "Accesses self-service portals and searches catalogues", "HTTPS with TLS 1.3")
Rel(LibrariansLibraryStaff, LibraryManagementSystem, "Utilizes circulation and cataloguing tools for inventory management", "HTTPS with TLS 1.3")
Rel(LibraryAdministrators, LibraryManagementSystem, "Handles reporting and user management", "HTTPS with TLS 1.3")
Rel(LibraryManagementSystem, InterLibraryLoanILLPartners, "Integrates for resource sharing", "NCIP/ISO 18626 APIs using mTLS")
Rel(LibraryManagementSystem, PaymentGatewaysNotificationServices, "Communicates for processing fines and alerts", "Secure webhooks protected by mTLS")
@enduml