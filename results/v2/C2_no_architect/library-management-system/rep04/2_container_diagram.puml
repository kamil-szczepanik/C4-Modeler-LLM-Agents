@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(LibraryPatronsMembers, "Library Patrons (Members)", "Access self-service portals to search catalogues and manage loans.")
Person(Librarians, "Librarians", "Utilize circulation and cataloguing tools for inventory management.")
Person(LibraryAdministrators, "Library Administrators", "Handle reporting and user management.")

System_Ext(InterLibraryLoanILLPartners, "Inter-Library Loan (ILL) Partners", "External library systems for resource sharing.")
System_Ext(PaymentGatewayandNotificationService, "Payment Gateway and Notification Service", "External integration for processing fines and alerts.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(SelfServiceWebMobilePortal, "Self-Service Web/Mobile Portal", "Web/Mobile", "Allows patrons and staff to interact with the system.")
    Container(APIGateway, "API Gateway", "Kubernetes, OAuth2/OIDC, mTLS", "Routes traffic to backend containers and enforces security.")
    ContainerDb(CoreCirculationandTransactionalDatabase, "Core Circulation and Transactional Database", "Kubernetes, EU-region clusters", "Manages core circulation and transactional data.")
    Container(ReadoptimizedSearchIndex, "Read-optimized Search Index", "Elasticsearch, EU-hosted", "Provides high-performance search capabilities.")
    Container(AdminReportingContainer, "Admin/Reporting Container", "Kubernetes", "Handles reporting and administrative workloads.")
}

Rel(LibraryPatronsMembers, SelfServiceWebMobilePortal, "Interacts with the portal", "HTTPS (TLS 1.3)")
Rel(Librarians, SelfServiceWebMobilePortal, "Interacts with the portal", "HTTPS (TLS 1.3)")
Rel(LibraryAdministrators, AdminReportingContainer, "Accesses administrative and reporting tools", "HTTPS (TLS 1.3)")
Rel(SelfServiceWebMobilePortal, APIGateway, "Sends requests", "HTTPS (TLS 1.3), OAuth2/OIDC")
Rel(APIGateway, CoreCirculationandTransactionalDatabase, "Routes traffic to core services", "mTLS")
Rel(APIGateway, ReadoptimizedSearchIndex, "Routes search requests", "mTLS")
Rel(APIGateway, AdminReportingContainer, "Routes admin requests", "mTLS")
Rel(CoreCirculationandTransactionalDatabase, ReadoptimizedSearchIndex, "Queries search index for catalogue searches", "Internal Network")
Rel(APIGateway, PaymentGatewayandNotificationService, "Integrates with external services using egress boundary payload filtering", "HTTPS with Egress Filtering")
Rel(APIGateway, InterLibraryLoanILLPartners, "Integrates with external ILL partner systems", "HTTPS")

@enduml