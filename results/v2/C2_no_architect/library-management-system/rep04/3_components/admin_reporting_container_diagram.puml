@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Admin/Reporting Container", "Admin/Reporting Container") {
    Component("Administrative Workload Handler", "Administrative Workload Handler", "Kubernetes Container", "Handles administrative workloads and enforces strict EU data residency.")
    Component("Financial Auditing Engine", "Financial Auditing Engine", "Kubernetes Container", "Manages financial auditing processes and compliance data export.")
    Component("Data Analytics Processor", "Data Analytics Processor", "Asynchronous Workers / Elasticsearch", "Performs data analytics and manages read-optimized search index queries.")
}

Rel("Administrative Workload Handler", "Financial Auditing Engine", "Coordinates administrative data with financial audit logs")
Rel("Financial Auditing Engine", "Data Analytics Processor", "Feeds audited data to analytics and reporting pipelines")

@enduml