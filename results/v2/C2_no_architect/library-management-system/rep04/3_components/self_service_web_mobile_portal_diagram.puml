@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(self_service_web_mobile_portal, "Self-Service Web/Mobile Portal") {
    Component(Web_and_Mobile_Frontend_Assets, "Web and Mobile Frontend Assets", "EU-hosted CDN, HTML/JS, Subresource Integrity (SRI), Content Security Policy (CSP)", "Serves patrons and librarians with secure access, robust accessibility, and geo-pinned EU data residency.")
    Component(Authentication_Manager, "Authentication Manager", "OAuth2/OIDC with PKCE, HTTP-only Secure SameSite=Strict cookies, Secure Enclaves", "Handles secure authentication, token management, and session security.")
    Component(Observability_and_RUM_Agent, "Observability and RUM Agent", "Real User Monitoring (RUM)", "Tracks latency to meet the <800ms non-functional requirement.")
}

Rel(Web_and_Mobile_Frontend_Assets, Authentication_Manager, "Authenticates users via", "OAuth2/OIDC, PKCE, HTTP-only cookies")
Rel(Web_and_Mobile_Frontend_Assets, Observability_and_RUM_Agent, "Reports performance metrics for", "<800ms NFR tracking")

@enduml