@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Circulation and Transactional Database container

Container_Boundary(core_circulation_db, "Core Circulation and Transactional Database") {
    Component(Transaction_Manager, "Transaction Manager", "PostgreSQL with Raft/Patroni", "Handles core circulation transactions and ensures strong consistency.")
    Component(Change_Data_Capture_Publisher, "Change Data Capture Publisher", "Debezium", "Reads from the database write-ahead log (WAL) to publish domain events.")
}

Rel(Transaction_Manager, Change_Data_Capture_Publisher, "Publishes domain events via Write-Ahead Log", "Debezium, WAL, JWE")

@enduml