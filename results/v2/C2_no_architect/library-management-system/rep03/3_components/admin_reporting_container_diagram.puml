@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Admin & Reporting Container container

Person(Library_Administrators, "Library Administrators", "Primary persona interacting with administrative functions.")

System_Ext(API_Gateway_Container, "API Gateway Container", "Routes administrative requests.", "Kubernetes, OAuth2/OIDC, TLS 1.3")
System_Ext(In_Region_APM_and_Log_Aggregation_Pipeline, "In-Region APM and Log Aggregation Pipeline", "Receives streamed encrypted metrics via OpenTelemetry sidecars.", "External System")
System_Ext(Audit_and_Compliance_Trust_Zone, "Audit and Compliance Trust Zone", "Receives cryptographically signed audit logs.", "External System")
System_Ext(Ephemeral_Object_Storage, "Ephemeral Object Storage", "Stores generated export files using HTTPS with Customer-Managed Keys.", "AWS S3 / compatible object store")

Container_Boundary(Admin_Reporting_Container_Boundary, "Admin & Reporting Container") {
    Component(Admin_Reporting_Container, "Admin & Reporting Container", "Kubernetes, Microservice", "Manages administrative functions, reporting, and sensitive analytical workloads within the EU data residency boundary.")
    Component(Background_Worker_Queue, "Background Worker Queue", "Celery / Temporal workflows", "Manages asynchronous batch processing for resource-intensive reports and exports.")
}

Rel(API_Gateway_Container, Admin_Reporting_Container, "Routes administrative requests", "mTLS over internal Kubernetes network policies")
Rel(Admin_Reporting_Container, In_Region_APM_and_Log_Aggregation_Pipeline, "Streams encrypted metrics", "OpenTelemetry sidecars")
Rel(Admin_Reporting_Container, Audit_and_Compliance_Trust_Zone, "Streams cryptographically signed audit logs", "TLS 1.3")
Rel(Admin_Reporting_Container, Ephemeral_Object_Storage, "Streams generated export files", "HTTPS with Customer-Managed Keys")
@enduml