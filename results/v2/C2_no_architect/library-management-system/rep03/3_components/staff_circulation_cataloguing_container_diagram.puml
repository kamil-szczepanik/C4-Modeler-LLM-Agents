@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Staff Circulation & Cataloguing Container container

Container_Boundary(staff_circulation_cataloguing_container, "Staff Circulation & Cataloguing Container") {
    Component(Staff_Request_Controller, "Staff Request Controller", "Kubernetes Microservice REST Endpoint", "Handles and validates staff requests routed via mTLS from the API Gateway, validating signed JWTs for RBAC/ABAC permissions.")
    Component(Circulation_Cataloguing_Engine, "Circulation & Cataloguing Engine", "Business Logic Service", "Ensures secure, high-throughput item check-outs, returns, and catalog management meeting the 2-second transaction SLA via connection pooling and read replicas.")
    Component(Batch_Worker_Pods, "Batch Worker Pods", "Dedicated Batch Worker Pods", "Asynchronously decouples and processes bulk MARC/ONIX metadata ingestion.")
    Component(Telemetry_Sidecar, "Telemetry Sidecar", "OpenTelemetry Sidecar", "Streams encrypted metrics to the In-Region APM and Log Aggregation Pipeline.")
    Component(Audit_Event_Streamer, "Audit Event Streamer", "Compliance Logging Module", "Streams immutable audit events for check-outs, returns, and catalog modifications to the Audit and Compliance Trust Zone.")
}

Rel(Staff_Request_Controller, Circulation_Cataloguing_Engine, "Delegates verified staff circulation and cataloguing operations")
Rel(Circulation_Cataloguing_Engine, Batch_Worker_Pods, "Offloads bulk MARC/ONIX metadata ingestion asynchronously")
Rel(Circulation_Cataloguing_Engine, Telemetry_Sidecar, "Sends encrypted performance metrics")
Rel(Circulation_Cataloguing_Engine, Audit_Event_Streamer, "Forwards immutable audit trails for check-outs, returns, and modifications")

@enduml