@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("API Gateway Container", "API Gateway Container") {
    Component(Routing and Proxy Engine, "Routing and Proxy Engine", "Envoy / Istio", "Routes inbound traffic securely to backend containers using mTLS and Kubernetes network policies.")
    Component(Authentication and Authorization Handler, "Authentication and Authorization Handler", "OAuth2/OIDC, JWT, TLS 1.3", "Validates OAuth2/OIDC tokens, fetches JWKS from the external IdP, and performs local JWT validation.")
    Component(Rate Limiting and Circuit Breaker, "Rate Limiting and Circuit Breaker", "Envoy, Redis", "Enforces distributed rate-limiting tiers within the EU region and manages circuit breaking for resilience.")
    Component(Telemetry Collector, "Telemetry Collector", "OpenTelemetry, Asynchronous Sidecar", "Streams logs and metrics to the in-region APM and log aggregation pipeline.")
}

System_Ext(Patron Self-Service Portal Container, "Patron Self-Service Portal Container", "External Container")
System_Ext(Staff Circulation & Cataloguing Container, "Staff Circulation & Cataloguing Container", "External Container")
System_Ext(Admin & Reporting Container, "Admin & Reporting Container", "External Container")
System_Ext(Notification Service Container, "Notification Service Container", "External Container")
System_Ext(In-Region APM and Log Aggregation Pipeline, "In-Region APM and Log Aggregation Pipeline", "External System")
System_Ext(External Identity Provider (IdP), "External Identity Provider (IdP)", "External System")

Rel(Routing and Proxy Engine, Authentication and Authorization Handler, "Authenticates incoming requests using tokens")
Rel(Routing and Proxy Engine, Rate Limiting and Circuit Breaker, "Checks rate limits and enforces thresholds")
Rel(Routing and Proxy Engine, Patron Self-Service Portal Container, "Routes traffic securely via mTLS")
Rel(Routing and Proxy Engine, Staff Circulation & Cataloguing Container, "Routes traffic securely via mTLS")
Rel(Routing and Proxy Engine, Admin & Reporting Container, "Routes traffic securely via mTLS")
Rel(Routing and Proxy Engine, Notification Service Container, "Routes traffic securely via mTLS")
Rel(Routing and Proxy Engine, In-Region APM and Log Aggregation Pipeline, "Streams logs and OpenTelemetry metrics asynchronously")
Rel(Authentication and Authorization Handler, External Identity Provider (IdP), "Validates OAuth2/OIDC tokens and fetches JWKS")

@enduml