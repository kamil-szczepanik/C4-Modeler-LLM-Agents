@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(notification_service_container, "Notification Service Container") {
    Component(Notification_Controller, "Notification Controller", "Kubernetes Microservice API Endpoint", "Receives notification triggers from the API Gateway via mTLS and JWT claims.")
    Component(Notification_Dispatcher, "Notification Dispatcher", "Queue-driven Worker with SPIFFE/SPIRE", "Manages queue-driven horizontal autoscaling and sends external messages to the EU-Hosted Email/SMS Gateway.")
    Component(Audit_and_Compliance_Logger, "Audit and Compliance Logger", "OpenTelemetry / Encrypted Transport", "Emits tamper-evident audit logs and delivery statuses to the Audit and Compliance Trust Zone.")
    Component(Telemetry___PII_Scrubber, "Telemetry & PII Scrubber", "OpenTelemetry & W3C Trace Context", "Streams scrubbed metrics and traces with automated PII masking to the In-Region APM and Log Aggregation Pipeline.")
    Component(Dead_Letter_Queue_Manager, "Dead Letter Queue Manager", "Encrypted Persistent Volumes", "Manages the persistent Dead Letter Queue (DLQ) enforcing EU data residency for failed deliveries.")
}

Rel(Notification_Controller, Notification_Dispatcher, "Queues notification tasks for bulk processing", "Queue-driven HPA")
Rel(Notification_Dispatcher, Dead_Letter_Queue_Manager, "Persists failed messages", "Encrypted Persistent Volumes")
Rel(Notification_Dispatcher, Audit_and_Compliance_Logger, "Sends delivery statuses and audit records", "Encrypted network transport")
Rel(Notification_Dispatcher, Telemetry___PII_Scrubber, "Forwards metrics and traces for scrubbing", "OpenTelemetry")
@enduml