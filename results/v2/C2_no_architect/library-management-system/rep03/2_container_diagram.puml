@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(LibraryPatrons, "Library Patrons", "Patrons who use the self-service portal to access library services.")
Person(LibraryStaff, "Library Staff", "Staff members who manage circulation and cataloguing tools.")
Person(LibraryAdministrators, "Library Administrators", "Administrators who manage the system with advanced privileges and MFA.")

System_Ext(ExternalIdentityProvideIdP, "External Identity Provider (IdP)", "External system responsible for user authentication and identity management.")
System_Ext(EUCloudInfrastructureBoundary, "EU Cloud Infrastructure Boundary", "EU-hosted cloud providers ensuring EU-only data residency and compliance.")
System_Ext(InRegionAPMandLogAggregationPipeline, "In-Region APM and Log Aggregation Pipeline", "In-region telemetry and performance tracking.")
System_Ext(AuditandComplianceTrustZone, "Audit and Compliance Trust Zone", "Zone featuring compliance controls and automated retention limits.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(APIGatewayContainer, "API Gateway Container", "Kubernetes, OAuth2/OIDC, TLS 1.3", "Manages ingress authentication and routes traffic to internal microservices.")
    Container(PatronSelfServicePortalContainer, "Patron Self-Service Portal Container", "Kubernetes, Web Frontend", "Provides cataloguing and self-service portals for library patrons.")
    Container(StaffCirculationCataloguingContainer, "Staff Circulation & Cataloguing Container", "Kubernetes, Microservice", "Provides circulation and cataloguing tools for library staff.")
    Container(AdminReportingContainer, "Admin & Reporting Container", "Kubernetes, Microservice", "Manages administrative functions, reporting, and isolated sensitive operations.")
    Container(NotificationServiceContainer, "Notification Service Container", "Kubernetes, Microservice", "Handles system notifications and messaging for users.")
}

Rel(LibraryPatrons, APIGatewayContainer, "Communicates via HTTPS to access library services", "HTTPS (TLS 1.3)")
Rel(LibraryStaff, APIGatewayContainer, "Communicates via HTTPS to access staff tools", "HTTPS (TLS 1.3)")
Rel(LibraryAdministrators, APIGatewayContainer, "Communicates via HTTPS to manage administrative tasks", "HTTPS (TLS 1.3)")

Rel(APIGatewayContainer, ExternalIdentityProvideIdP, "Validates OAuth2/OIDC tokens", "OAuth2/OIDC")

Rel(APIGatewayContainer, PatronSelfServicePortalContainer, "Routes patron requests", "mTLS over internal Kubernetes network policies")
Rel(APIGatewayContainer, StaffCirculationCataloguingContainer, "Routes staff requests", "mTLS over internal Kubernetes network policies")
Rel(APIGatewayContainer, AdminReportingContainer, "Routes administrative requests", "mTLS over internal Kubernetes network policies")
Rel(APIGatewayContainer, NotificationServiceContainer, "Triggers notifications", "mTLS over internal Kubernetes network policies")

Rel(PatronSelfServicePortalContainer, InRegionAPMandLogAggregationPipeline, "Streams encrypted metrics via OpenTelemetry sidecars", "OpenTelemetry")
Rel(StaffCirculationCataloguingContainer, InRegionAPMandLogAggregationPipeline, "Streams encrypted metrics via OpenTelemetry sidecars", "OpenTelemetry")
Rel(AdminReportingContainer, InRegionAPMandLogAggregationPipeline, "Streams encrypted metrics via OpenTelemetry sidecars", "OpenTelemetry")
Rel(NotificationServiceContainer, InRegionAPMandLogAggregationPipeline, "Streams encrypted metrics via OpenTelemetry sidecars", "OpenTelemetry")

@enduml