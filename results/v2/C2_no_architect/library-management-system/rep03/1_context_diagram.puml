@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(LibraryPatrons, "Library Patrons", "Patrons who use the self-service portal to access library services.")
Person(LibraryStaff, "Library Staff", "Staff members who manage circulation and cataloguing tools.")
Person(LibraryAdministrators, "Library Administrators", "Administrators who manage the system with advanced privileges and MFA.")

System(LibraryManagementSystem, "Library Management System", "A solution for public and academic libraries to catalogue physical and digital items, manage circulation, and provide self-service portals with strict EU-only data residency and high-performance search capabilities.")

System_Ext(ExternalIdentityProvideIdP, "External Identity Provider (IdP)", "External system responsible for user authentication and identity management.")
System_Ext(EUCloudInfrastructureBoundary, "EU Cloud Infrastructure Boundary", "EU-hosted cloud providers (AWS Frankfurt/Ireland) ensuring EU-only data residency and compliance.")
System_Ext(InRegionAPMandLogAggregationPipeline, "In-Region APM and Log Aggregation Pipeline", "Prometheus/Grafana or EU-hosted ELK for in-region telemetry and performance tracking.")
System_Ext(AuditandComplianceTrustZone, "Audit and Compliance Trust Zone", "Zone featuring WORM storage controls and automated retention limits for compliance.")

Rel(LibraryPatrons, LibraryManagementSystem, "Accesses self-service portal for library functions", "HTTPS (TLS 1.3) and OAuth 2.0 / OIDC")
Rel(LibraryStaff, LibraryManagementSystem, "Uses circulation and cataloguing tools", "TLS 1.3 and OAuth 2.0 / OIDC with MFA")
Rel(LibraryAdministrators, LibraryManagementSystem, "Manages system settings and administrative tasks", "TLS 1.3 and OAuth 2.0 / OIDC with MFA")
Rel(LibraryManagementSystem, ExternalIdentityProvideIdP, "Authenticates users via identity protocols", "OAuth 2.0 / OIDC")
Rel(LibraryManagementSystem, InRegionAPMandLogAggregationPipeline, "Sends system telemetry via encrypted local pipelines", "Encrypted local pipelines")
Rel(LibraryManagementSystem, AuditandComplianceTrustZone, "Enforces audit logs and compliance controls", "WORM storage controls")
@enduml