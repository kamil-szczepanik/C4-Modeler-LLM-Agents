@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the User Analytics & Feedback Container container

Container_Boundary(user_analytics_feedback_container, "User Analytics & Feedback Container") {
    Component(fluentbit_sidecars, "Fluentbit sidecars", "Edge log collection", "Ingests telemetry via asynchronous message queues with schema validation.")
    Component(kafka_ingestion_consumers, "Kafka ingestion consumers", "Kafka", "Handles asynchronous telemetry ingestion.")
    Component(dead_letter_queue_dlq, "Dead Letter Queue (DLQ)", "Messaging Queue", "Manages failed message delivery and error handling.")
}

Rel(fluentbit_sidecars, kafka_ingestion_consumers, "Ingests telemetry via asynchronous message queues with schema validation.", "Asynchronous / Message Queue")
Rel(kafka_ingestion_consumers, dead_letter_queue_dlq, "Routes failed ingestion messages.", "Messaging")

@enduml