@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "API Gateway")

Container_Boundary(self_service_portal, "Self-Service Portal") {
    Component(web_ui_and_accessibility_layer, "Web UI and Accessibility Layer", "React with WCAG 2.1 AA accessibility standards and axe-core", "Provides the user interface for library patrons, librarians, and administrators with strict accessibility and client-side error boundaries.")
    Component(session_and_authentication_handler, "Session and Authentication Handler", "OAuth2/OIDC with PKCE, httpOnly/secure/SameSite=Strict cookies", "Manages user authentication, secure session cookies, and Content Security Policy (CSP) headers.")
    Component(api_proxy_client, "API Proxy Client", "HTTPS / TLS 1.3 with mTLS via SPIFFE/SPIRE", "Routes authenticated user actions and requests from the portal to the downstream API Gateway.")
}

Rel(web_ui_and_accessibility_layer, session_and_authentication_handler, "Validates session and authenticates user actions")
Rel(session_and_authentication_handler, api_proxy_client, "Passes authenticated requests")
Rel(api_proxy_client, api_gateway, "Routes requests securely", "mTLS via SPIFFE/SPIRE")
@enduml