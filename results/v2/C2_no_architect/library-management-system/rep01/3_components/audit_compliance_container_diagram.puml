@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit & Compliance Container container

Person(DPOs, "Data Protection Officers (DPOs) / Compliance Auditors", "Primary compliance stakeholders accessing audit logs and reports.")
Person(SysAdmins, "System Administrators", "Operations stakeholders responsible for security forensics and system oversight.")

System_Ext(API_Gateway, "API Gateway", "Entry point mediating traffic.")
System_Ext(EU_localized_HSM, "EU-localized HSM", "Provides cryptographic log signing and envelope encryption.")
System_Ext(WORM_Storage, "WORM Storage", "Write-Once-Read-Many Storage", "Immutable, long-term log retention storage.")
System_Ext(Centralized_Logging_SIEM_Service, "Centralized Logging & SIEM Service", "Receives security and tamper alerts.")

Container_Boundary(Audit_Compliance_Container_boundary, "Audit & Compliance Container") {
    Component(Audit_Compliance_Container, "Audit & Compliance Container", "Kubernetes Container", "Core container managing audit ingestion, storage, and reporting.")
    Component(LUKS, "LUKS", "Linux Unified Key Setup", "Encrypts local spillover disks for secure asynchronous log buffering during outages.")
    Component(Prometheus, "Prometheus", "Monitoring", "Collects metrics on HSM response times, log ingestion lag, and certificate rotation.")
    Component(Merkle_Tree_Structure, "Merkle Tree Structure", "Cryptographic Data Structure", "Cryptographically ensures log tamper-evidence prior to WORM storage streaming.")
}

Rel(API_Gateway, Audit_Compliance_Container, "Routes audit requests and compliance queries via mTLS using SPIFFE/SPIRE.", "mTLS and OAuth2/OIDC")
Rel(Audit_Compliance_Container, EU_localized_HSM, "Performs cryptographic log signing and envelope encryption via local cloud region connectivity.", "Hardware Security Module")
Rel(Audit_Compliance_Container, WORM_Storage, "Streams encrypted, Merkle-tree-structured audit logs for immutable retention.", "WORM")
Rel(Audit_Compliance_Container, Centralized_Logging_SIEM_Service, "Sends automated alerts for tampering, queue saturation, or disk exhaustion.", "External SIEM")

@enduml