@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(search_container, "Search Container") {
    Component(Search_Indexer, "Search Indexer", "Elasticsearch / OpenSearch", "Horizontally scalable search engine for low-latency search (<800 ms R-05 requirement) and asynchronous Change-Data-Capture (CDC) data ingestion.")
    Component(Search_API_Handler, "Search API Handler", "OpenSearch REST API / mTLS", "Receives routed search requests from the API Gateway via mTLS and enforces document-level access controls.")
    Component(Telemetry_Sidecar, "Telemetry Sidecar", "Fluentbit", "Asynchronous sidecar for routing user telemetry and piping metrics/audit logs without impacting disk I/O.")
}

Rel(Search_API_Handler, Search_Indexer, "Queries and retrieves catalog data")
Rel(Search_Indexer, Telemetry_Sidecar, "Pipes metrics, audit logs, and routes user telemetry")

@enduml