@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(OAuth2_OIDC_Token_Validator, "OAuth2/OIDC Token Validator", "JWT Processing Engine", "Handles OAuth2/OIDC token validation and JWT processing for incoming requests.")
    Component(WAF_Input_Sanitizer, "WAF Input Sanitizer", "Security Middleware", "Performs Web Application Firewall input sanitization and strict CORS/security header enforcement.")
    Component(OpenAPI_Validator_Rate_Limiter, "OpenAPI Validator & Rate Limiter", "API Governance Engine", "Validates requests against OpenAPI schemas and applies rate limiting to ensure high performance (<800ms p99 search response).")
    Component(mTLS_Routing_Engine, "mTLS Routing Engine", "SPIFFE/SPIRE Integration", "Routes requests securely using mTLS via SPIFFE/SPIRE with W3C Trace Context injection.")
}

System(Search_Container, "Search Container", "Search Engine", "Search Container")
System(Audit_Compliance_Container, "Audit & Compliance Container", "Compliance System", "Audit & Compliance Container")
System(User_Analytics_Feedback_Container, "User Analytics & Feedback Container", "Analytics System", "User Analytics & Feedback Container")

Rel(OAuth2_OIDC_Token_Validator, WAF_Input_Sanitizer, "Passes authenticated identity for sanitization", "")
Rel(WAF_Input_Sanitizer, OpenAPI_Validator_Rate_Limiter, "Passes sanitized payload for schema validation and rate checking", "")
Rel(OpenAPI_Validator_Rate_Limiter, mTLS_Routing_Engine, "Forwards validated requests for secure internal routing", "")
Rel(mTLS_Routing_Engine, Search_Container, "Routes search requests using mTLS via SPIFFE/SPIRE with W3C Trace Context injection", "mTLS / SPIFFE")
Rel(mTLS_Routing_Engine, Audit_Compliance_Container, "Routes audit requests using mTLS via SPIFFE/SPIRE", "mTLS / SPIFFE")
Rel(mTLS_Routing_Engine, User_Analytics_Feedback_Container, "Routes analytics requests using mTLS via SPIFFE/SPIRE", "mTLS / SPIFFE")

@enduml