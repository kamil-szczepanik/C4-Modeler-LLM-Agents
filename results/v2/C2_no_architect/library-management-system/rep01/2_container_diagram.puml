@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(LibraryPatrons, "Library Patrons", "Students and public users accessing self-service portals.")
Person(LibrariansCirculationStaff, "Librarians / Circulation Staff", "Internal users managing inventory and daily circulation.")
Person(LibraryAdministrators, "Library Administrators", "Internal users managing reporting and system access.")

System_Ext(NotificationGateway, "Notification Gateway", "External system for automated overdue and borrowing alerts.")
System_Ext(ExternalILSBookSupplierIntegration, "External ILS / Book Supplier Integration", "External system for automated catalog updates.")
System_Ext(ReportingAnalyticsSystem, "Reporting & Analytics System", "Engine for tracking circulation trends and ROI.")
System_Ext(CentralizedLoggingSIEMService, "Centralized Logging & SIEM Service", "Observability service for telemetry and security audits.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(SelfServicePortal, "Self-Service Portal", "Public Trust Zone / DMZ", "Provides portal interface for patrons and staff.")
    Container(APIGateway, "API Gateway", "OAuth2/OIDC, JWT", "Manages authentication, authorization, and routing.")
    Container(SearchContainer, "Search Container", "Elasticsearch / OpenSearch", "Horizontally scalable search engine for low-latency search.")
    Container(AuditComplianceContainer, "Audit & Compliance Container", "Kubernetes, EU-localized HSM", "Enforces strict EU data residency and GDPR compliance.")
    Container(UserAnalyticsFeedbackContainer, "User Analytics & Feedback Container", "Kafka / Fluentbit sidecars", "Ingests telemetry via asynchronous message queues.")
}

Rel(LibraryPatrons, SelfServicePortal, "Interact with the self-service portal.", "HTTPS / TLS 1.3")
Rel(LibrariansCirculationStaff, SelfServicePortal, "Interact with the self-service portal.", "HTTPS / TLS 1.3")
Rel(LibraryAdministrators, SelfServicePortal, "Interact with the self-service portal.", "HTTPS / TLS 1.3")
Rel(SelfServicePortal, APIGateway, "Routes requests to core containers.", "mTLS via SPIFFE/SPIRE")
Rel(APIGateway, SearchContainer, "Routes search requests.", "mTLS via SPIFFE/SPIRE")
Rel(APIGateway, AuditComplianceContainer, "Routes audit requests.", "mTLS via SPIFFE/SPIRE")
Rel(APIGateway, UserAnalyticsFeedbackContainer, "Routes analytics requests.", "mTLS via SPIFFE/SPIRE")
Rel(SearchContainer, SearchContainer, "Receives data via asynchronous Change-Data-Capture (CDC) pipelines.", "Asynchronous CDC")
Rel(UserAnalyticsFeedbackContainer, UserAnalyticsFeedbackContainer, "Ingests telemetry via asynchronous message queues.", "Kafka / Fluentbit sidecars")
Rel(LibraryManagementSystem, NotificationGateway, "Dispatches automated digital alerts.", "API")
Rel(LibraryManagementSystem, ExternalILSBookSupplierIntegration, "Connects for automated catalog updates.", "Mutual TLS (mTLS) with JWT/HMAC")
Rel(LibraryManagementSystem, ReportingAnalyticsSystem, "Streams asynchronous operational telemetry.", "Asynchronous Data Pipeline")
Rel(LibraryManagementSystem, CentralizedLoggingSIEMService, "Streams asynchronous security audit logs.", "Asynchronous Data Pipeline")

@enduml