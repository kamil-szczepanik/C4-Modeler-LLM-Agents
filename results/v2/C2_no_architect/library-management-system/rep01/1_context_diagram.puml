@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(LibraryPatrons, "Library Patrons", "Students and public users accessing self-service portals.")
Person(LibrariansCirculationStaff, "Librarians / Circulation Staff", "Internal users managing inventory and daily circulation.")
Person(LibraryAdministrators, "Library Administrators", "Internal users managing reporting and system access.")

System(LibraryManagementSystem, "Library Management System", "Provides cataloging, circulation management, and self-service portals for public and academic libraries, ensuring EU-only data residency and strict performance SLAs for patron searches.")

System_Ext(NotificationGateway, "Notification Gateway", "External system for automated overdue and borrowing alerts.")
System_Ext(ExternalILSBookSupplierIntegration, "External ILS / Book Supplier Integration", "External system for automated catalog updates.")
System_Ext(ReportingAnalyticsSystem, "Reporting & Analytics System", "Engine for tracking circulation trends and ROI.")
System_Ext(CentralizedLoggingSIEMService, "Centralized Logging & SIEM Service", "Observability service for telemetry and security audits.")

Rel(LibraryPatrons, LibraryManagementSystem, "Interact with self-service portals with rate-limiting and MFA.", "HTTPS over TLS 1.3")
Rel(LibrariansCirculationStaff, LibraryManagementSystem, "Authenticate to manage inventory and daily circulation.", "Enterprise SSO with RBAC")
Rel(LibraryAdministrators, LibraryManagementSystem, "Authenticate to manage reporting and system access.", "Enterprise SSO with RBAC")
Rel(LibraryManagementSystem, NotificationGateway, "Dispatches automated digital alerts.", "API")
Rel(LibraryManagementSystem, ExternalILSBookSupplierIntegration, "Connects for automated catalog updates with cryptographically signed payloads.", "Mutual TLS (mTLS) with JWT/HMAC")
Rel(LibraryManagementSystem, ReportingAnalyticsSystem, "Streams asynchronous, pseudonymized operational telemetry and audit logs.", "Asynchronous Data Pipeline")
Rel(LibraryManagementSystem, CentralizedLoggingSIEMService, "Streams asynchronous operational telemetry and security audit logs.", "Asynchronous Data Pipeline")

@enduml