@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Self-Service Portal Container container

Container_Boundary("Self-Service Portal Container", "Self-Service Portal Container") {
    Component("Discovery Controller", "Discovery Controller", "Kubernetes, Istio", "Handles patron-facing discovery and catalogue search requests.")
    Component("Account Workflow Manager", "Account Workflow Manager", "Kubernetes, Istio", "Manages autonomous account workflows and user sessions.")
    Component("Asset Delivery Handler", "Asset Delivery Handler", "CDN, HTTPS", "Delivers localized static assets to patrons.")
}

System_Ext("Distributed Cache (Redis)", "Distributed Cache (Redis)", "Distributed caching layer")
System_Ext("Read-Replica Data Store", "Read-Replica Data Store", "Catalogue data store")
System_Ext("Content Delivery Network (CDN)", "Content Delivery Network (CDN)", "Content Delivery Network")

Rel("Discovery Controller", "Distributed Cache (Redis)", "Offloads frequent catalogue queries", "In-cluster")
Rel("Discovery Controller", "Read-Replica Data Store", "Queries catalogue data", "TLS 1.3")
Rel("Asset Delivery Handler", "Content Delivery Network (CDN)", "Delivers localized static assets", "HTTPS")

@enduml