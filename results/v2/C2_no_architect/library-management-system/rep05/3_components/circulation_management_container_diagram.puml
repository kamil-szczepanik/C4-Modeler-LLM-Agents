@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Circulation Management Container container

Container_Boundary(circulation_management_container, "Circulation Management Container") {
    Component(circulation_logic_engine, "Circulation Logic Engine", "Kubernetes-hosted microservice / Java / Spring Boot", "Executes check-outs, returns, renewals, and loan policy enforcement ensuring high-performance and EU-compliant library operations.")
    Component(api_gateway, "API Gateway", "OAuth2/OIDC JWT / Istio mTLS", "Entry point issuing OAuth2/OIDC JWTs and routing external traffic securely.")
    Component(catalogue_database_read_replica, "Catalogue Database & Read-Replica", "Multi-zone replicated data store / TLS 1.3", "Stores and manages items and loans with connection pooling and circuit-breaking.")
    Component(message_broker, "Message Broker", "Kafka / RabbitMQ / TLS 1.3", "Publishes asynchronous domain events for circulation operations.")
    Component(cloud_kms_vault, "Cloud KMS / Vault", "AES-256 / Kubernetes Secrets", "Provides secret management and encryption key services for PII and data-at-rest.")
}

Rel(api_gateway, circulation_logic_engine, "Routes validated requests via Istio mTLS.")
Rel(circulation_logic_engine, catalogue_database_read_replica, "Executes queries and updates using TLS 1.3 with connection pooling and circuit-breaking.")
Rel(circulation_logic_engine, message_broker, "Publishes asynchronous domain events over TLS 1.3.")
@enduml