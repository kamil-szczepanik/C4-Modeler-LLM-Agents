@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Message Broker", "Message Broker") {
    Component(Event_Ingestion_Engine, "Event Ingestion Engine", "Kafka / RabbitMQ, Strimzi operator", "Handles incoming asynchronous events from the Circulation Management Container using TLS 1.3 and mTLS & SCRAM-SHA-512.")
    Component(Event_Streaming_Dispatcher, "Event Streaming Dispatcher", "Kafka / RabbitMQ, 3-broker cluster", "Streams events securely to the Analytics/Reporting Container with a replication factor of 2.")
    Component(Dead_Letter_Queue_DLQ_Handler, "Dead Letter Queue (DLQ) Handler", "Kafka / RabbitMQ DLQ", "Routes malformed or unprocessable events securely away from the main event stream.")
}

Rel(Event_Ingestion_Engine, Event_Streaming_Dispatcher, "Forwards validated asynchronous events")
Rel(Event_Ingestion_Engine, Dead_Letter_Queue_DLQ_Handler, "Routes malformed or unprocessable events")
@enduml