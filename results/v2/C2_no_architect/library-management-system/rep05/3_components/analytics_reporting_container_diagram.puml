@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Analytics/Reporting Container container

Container_Boundary(analytics_reporting_container, "Analytics/Reporting Container") {
    Component(Event_Ingestion_Engine, "Event Ingestion Engine", "Kubernetes, OpenTelemetry", "Ingests and processes asynchronous analytics events streamed from the message broker under EU data residency constraints.")
    Component(Aggregation_and_Reporting_Service, "Aggregation and Reporting Service", "OpenTelemetry, ClickHouse / PostgreSQL", "Processes batch workloads, isolates heavy reporting tasks, and protects real-time search performance.")
    Component(Dashboard_and_Export_Controller, "Dashboard and Export Controller", "HTTPS, JWT-based RBAC, mTLS", "Delivers customized dashboards, scheduled reports, and exports aggregated data via webhooks.")
}

Rel(Event_Ingestion_Engine, Aggregation_and_Reporting_Service, "Persists and processes events", "ClickHouse / PostgreSQL read-replica")
Rel(Aggregation_and_Reporting_Service, Dashboard_and_Export_Controller, "Supplies aggregated data and reports")
@enduml