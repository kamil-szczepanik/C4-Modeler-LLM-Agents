@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Library Management System

Person(LibraryPatrons, "Library Patrons", "Students and public citizens who use self-service portals.")
Person(LibrariansCirculationStaff, "Librarians / Circulation Staff", "Staff members managing library operations and circulation.")
Person(LibraryAdministrators, "Library Administrators", "Administrators managing the Library Management System.")

System(LibraryManagementSystem, "Library Management System", "Provides self-service portals and circulation management for academic and public libraries, ensuring strict EU-only data residency and high-performance search capabilities.")

System_Ext(CatalogueDatabase, "Catalogue Database", "Transactional and Read Replica database for catalogue data.")
System_Ext(ExternalInstitutionalBIToolsMunicipalDashboards, "External Institutional BI Tools / Municipal Dashboards", "External tools and dashboards for institutional analytics.")

Rel(LibraryPatrons, LibraryManagementSystem, "Accesses self-service portals", "HTTPS (TLS 1.3)")
Rel(LibrariansCirculationStaff, LibraryManagementSystem, "Manages circulation and library operations", "OAuth2/OIDC with MFA")
Rel(LibraryAdministrators, LibraryManagementSystem, "Administers the system", "OAuth2/OIDC with MFA")
Rel(LibraryManagementSystem, CatalogueDatabase, "Queries and updates catalogue data", "AES-256 encrypted connections")
Rel(LibraryManagementSystem, ExternalInstitutionalBIToolsMunicipalDashboards, "Pushes pseudonymized data for analytics", "mTLS API push")

@enduml