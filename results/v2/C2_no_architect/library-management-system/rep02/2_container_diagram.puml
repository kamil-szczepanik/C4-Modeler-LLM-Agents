@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(Library_Patrons, "Library Patrons", "Students and public members who use the self-service portals.")
Person(Librarians, "Librarians", "Staff members who manage circulation and day-to-day library operations via the staff dashboard.")
Person(Library_Administrators, "Library Administrators", "Administrators responsible for system configuration and management.")

System_Ext(External_Identity_Provider_SSO, "External Identity Provider (SSO)", "External authentication service providing SSO capabilities.")
System_Ext(External_Payment_Gateway, "External Payment Gateway", "External service processing financial transactions and payments.")
System_Ext(Interlibrary_Loan_ILL_Network, "Interlibrary Loan (ILL) Network", "External network connecting libraries for resource sharing.")
System_Ext(External_SMSEmail_Providers, "External SMS/Email Providers", "External communication services for sending notifications.")

System_Boundary(Library_Management_System, "Library Management System") {
    Container(Self_Service_Portal_Container, "Self-Service Portal Container", "Kubernetes, EU-hosted", "Provides cataloging, circulation management, and self-service portals for patrons.")
    Container(Staff_Dashboard_Container, "Staff Dashboard Container", "Kubernetes, EU-hosted", "Provides staff interfaces for managing circulation and operations.")
    Container(Notification_Container, "Notification Container", "Kubernetes, Kafka/SQS, EU-hosted", "Manages notification backpressure and dispatches alerts.")
    Container(Analytics_Reporting_Container, "Analytics/Reporting Container", "Kubernetes, EU-hosted", "Handles reporting and analytics processing within data residency boundaries.")
}

Rel(Library_Patrons, Self_Service_Portal_Container, "Accesses self-service portal features", "HTTPS (TLS 1.3)")
Rel(Librarians, Staff_Dashboard_Container, "Manages library operations", "HTTPS (TLS 1.3)")
Rel(Library_Administrators, Staff_Dashboard_Container, "Configures and administers the system", "HTTPS (TLS 1.3)")
Rel(Self_Service_Portal_Container, External_Payment_Gateway, "Processes payments for fines and services", "HTTPS")
Rel(Staff_Dashboard_Container, External_Payment_Gateway, "Processes administrative financial transactions", "HTTPS")
Rel(Self_Service_Portal_Container, Notification_Container, "Triggers notifications", "mTLS (Service Mesh / SPIFFE/SPIRE)")
Rel(Staff_Dashboard_Container, Notification_Container, "Triggers notifications", "mTLS (Service Mesh / SPIFFE/SPIRE)")
Rel(Self_Service_Portal_Container, Analytics_Reporting_Container, "Sends usage data for analytics", "mTLS (Service Mesh / SPIFFE/SPIRE)")
Rel(Notification_Container, External_SMSEmail_Providers, "Sends messages to patrons and staff", "Egress-controlled HTTPS")

@enduml