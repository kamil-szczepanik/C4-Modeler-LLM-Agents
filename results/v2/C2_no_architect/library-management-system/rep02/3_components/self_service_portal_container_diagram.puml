@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Self-Service Portal Container container

Container_Boundary(self_service_portal_container, "Self-Service Portal Container") {
    Component(CatalogSearchComponent, "Catalog Search Component", "Kubernetes, Envoy", "Provides high-performance catalog search capabilities with sub-800ms response times under heavy loads.")
    Component(CirculationManagementComponent, "Circulation Management Component", "Kubernetes", "Manages book lending, returns, and library patron account operations.")
    Component(SelfServicePortalFrontend, "Self-Service Portal Frontend", "HTTPS (TLS 1.3)", "Provides the web interface for library patrons to access cataloging and circulation features.")
}

Rel(SelfServicePortalFrontend, CatalogSearchComponent, "Executes catalog searches", "Internal API")
Rel(SelfServicePortalFrontend, CirculationManagementComponent, "Manages checkouts and accounts", "Internal API")
@enduml