@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification Container container

Container_Boundary(notification_container, "Notification Container") {
    Component(Notification_Dispatcher, "Notification Dispatcher", "Kubernetes / Asynchronous Consumer", "Asynchronously consumes messages, handles backpressure, and dispatches alerts to external providers.")
    Component(Preference_Manager, "Preference Manager", "Internal Preference Database / AES-256", "Manages multi-channel patron and staff preferences with EU-restricted, encrypted storage.")
    Component(Retry_and_DLQ_Handler, "Retry and DLQ Handler", "Apache Kafka / AWS SQS", "Manages retries and dead-letter queues to prevent cascading failures during dispatches.")
}

Rel(Notification_Dispatcher, Preference_Manager, "Queries multi-channel notification preferences", "Internal secure access")
Rel(Notification_Dispatcher, Retry_and_DLQ_Handler, "Routes failed deliveries for retry or dead-letter processing", "Kafka/SQS")

@enduml