@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Staff Dashboard Container container

Person(Librarians, "Librarians", "Manages library operations.")
Person("Library Administrators", "Library Administrators", "Configures and administers the system.")

System_Ext("External Payment Gateway", "External Payment Gateway", "Processes financial transactions with circuit breaker.")
System_Ext("Interlibrary Loan (ILL) Network", "Interlibrary Loan (ILL) Network", "Interlibrary loan network.")
System_Ext("WORM Storage Sink", "WORM Storage Sink", "Streams immutable audit logs.")

Container_Boundary(staff_dashboard_boundary, "Staff Dashboard Container") {
    Component(Staff_Dashboard_Container, "Staff Dashboard Container", "Kubernetes, EU-hosted", "Provides library staff and administrators secure, low-latency interfaces for circulation management, cataloging, and operational monitoring.")
    Component("Notification Container", "Notification Container", "Kubernetes, Kafka/SQS, EU-hosted", "Triggers notifications.")
    Component("Fluentbit Sidecar", "Fluentbit Sidecar", "Fluentbit", "Sidecar log shipping for immutable WORM audit trails.")
    Component("Kafka/SQS", "Kafka/SQS", "Kafka / SQS", "Message broker for asynchronous batch processing and decoupled queuing.")
}

Rel(Librarians, Staff_Dashboard_Container, "Manages library operations", "HTTPS (TLS 1.3)")
Rel(Library_Administrators, Staff_Dashboard_Container, "Configures and administers system", "HTTPS (TLS 1.3)")
Rel(Staff_Dashboard_Container, "External Payment Gateway", "Processes financial transactions with circuit breaker", "HTTPS, strict egress")
Rel(Staff_Dashboard_Container, "Notification Container", "Triggers notifications", "mTLS via SPIFFE/SPIRE")
Rel(Staff_Dashboard_Container, "Kafka/SQS", "Asynchronous batch processing", "TLS")
Rel("Fluentbit Sidecar", "WORM Storage Sink", "Streams immutable audit logs", "Encrypted TCP")

@enduml