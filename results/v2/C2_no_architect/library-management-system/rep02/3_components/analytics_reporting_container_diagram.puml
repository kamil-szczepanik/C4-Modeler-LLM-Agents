@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Analytics/Reporting Container container

Container_Boundary("Analytics/Reporting Container", "Analytics/Reporting Container") {
    Component("ETL Pipeline Engine", "ETL Pipeline Engine", "Apache Spark, dbt", "Executes scheduled off-peak ETL pipelines, data transformations, and pseudonymization for compliance audits.")
    Component("Reporting API Controller", "Reporting API Controller", "Kubernetes, OAuth2/OIDC", "Provides secure, anonymized data access and enforces Role-Based Access Control and Dynamic Row-Level Security.")
    Component("Export Generation Worker", "Export Generation Worker", "Apache Kafka / AWS SQS", "Decouples asynchronous export generation and message queuing for circulation insights.")
}

Rel("Reporting API Controller", "ETL Pipeline Engine", "Queries analytical data asynchronously", "")
Rel("Export Generation Worker", "Reporting API Controller", "Processes queued export tasks", "")

@enduml