@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(LibraryPatrons, "Library Patrons", "Students and public members who use the self-service portals.")
Person(LibrariansCirculationStaff, "Librarians / Circulation Staff", "Staff members who manage circulation and day-to-day library operations.")
Person(LibraryAdministrators, "Library Administrators", "Administrators responsible for system configuration and management.")

System(LibraryManagementSystem, "Library Management System", "Provides cataloguing, circulation, and self-service portals for public and academic libraries with strict EU-only data residency and high-performance search capabilities.")

System_Ext(ExternalIdentityProvidersso, "External Identity Provider (SSO)", "External authentication service providing SSO capabilities.")
System_Ext(ExternalPaymentGateway, "External Payment Gateway", "External service processing financial transactions and payments.")
System_Ext(InterlibraryLoanillNetwork, "Interlibrary Loan (ILL) Network", "External network connecting libraries for resource sharing.")

Rel(LibraryPatrons, LibraryManagementSystem, "Interact with self-service portals", "HTTPS, TLS 1.3, OAuth 2.0 / OpenID Connect")
Rel(LibrariansCirculationStaff, LibraryManagementSystem, "Manage circulation and system operations", "HTTPS, TLS 1.3, OAuth 2.0 / OpenID Connect")
Rel(LibraryAdministrators, LibraryManagementSystem, "Administer the system and configure settings", "HTTPS, TLS 1.3, OAuth 2.0 / OpenID Connect")
Rel(LibraryManagementSystem, ExternalIdentityProvidersso, "Authenticate users and manage sessions", "Automated secrets management within EU perimeter")
Rel(LibraryManagementSystem, ExternalPaymentGateway, "Process payments and financial transactions", "Automated secrets management within EU perimeter")
Rel(LibraryManagementSystem, InterlibraryLoanillNetwork, "Exchange interlibrary loans and resource sharing data", "Mutual TLS (mTLS), API signature validation, circuit breakers")

@enduml