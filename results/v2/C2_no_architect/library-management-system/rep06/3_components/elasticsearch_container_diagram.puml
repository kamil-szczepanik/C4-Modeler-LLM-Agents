@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Elasticsearch Container container

Container_Boundary(elasticsearch_container, "Elasticsearch Container") {
    Component(Search_Index_Engine, "Search Index Engine", "Elasticsearch 3-node cluster", "Provides sub-second search performance and index lifecycle management (ILM).")
    Component(Snapshot_Manager, "Snapshot Manager", "Elasticsearch Snapshot API", "Stores automated snapshots to EU-localized S3-compatible Object Storage.")
}

Rel(Search_Index_Engine, Snapshot_Manager, "Triggers automated snapshots", "HTTPS")

@enduml