@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL Database (Primary/Read Replica) container

Container_Boundary(postgresql_container, "PostgreSQL Database (Primary/Read Replica)") {
    Component(Primary Database, "Primary Database", "PostgreSQL", "Relational storage for transactional circulation and catalog data, serving writes.")
    Component(Read Replica, "Read Replica", "PostgreSQL", "Read-only replica serving account history and holds queries.")
    Component(Patroni, "Patroni", "Patroni", "Automated failover manager with synchronous replication.")
    Component(PgBouncer, "PgBouncer", "PgBouncer", "Connection pooler managing traffic spikes.")
    Component(pgaudit, "pgaudit", "pgaudit", "Extension for compliance-driven audit logging.")
}

Rel(Primary Database, Read Replica, "Synchronously replicates data to", "")
Rel(Patroni, Primary Database, "Manages failover and high availability for", "")
Rel(PgBouncer, Primary Database, "Routes connection traffic to", "")

@enduml