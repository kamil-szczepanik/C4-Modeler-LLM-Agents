@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(circ_cat_container, "Circulation & Cataloguing Container") {
    Component(Circulation_Controller, "Circulation Controller", "Java Microservice, Spring MVC", "Handles incoming routing traffic from the API Gateway and exposes REST endpoints for circulation and cataloguing.")
    Component(Business_Logic_Service, "Business Logic Service", "Java Microservice, Resilience4j", "Implements business logic, connection pooling via HikariCP, and circuit breakers for resilience.")
    Component(Data_Access_Component, "Data Access Component", "Java Microservice, SQL", "Manages read and write operations to the PostgreSQL Database for transactional data.")
    Component(Event_Publisher_Component, "Event Publisher Component", "Java Microservice, Kafka Protocol", "Publishes audit and sync events with encryption-in-transit and payload signing to the event streaming platform.")
}

Rel(Circulation_Controller, Business_Logic_Service, "Delegates requests", "Method Invocation")
Rel(Business_Logic_Service, Data_Access_Component, "Executes queries and transactions", "SQL")
Rel(Business_Logic_Service, Event_Publisher_Component, "Triggers domain events", "Method Invocation")

@enduml