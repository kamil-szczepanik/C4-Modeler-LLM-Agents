@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(reporting_analytics_container, "Reporting/Analytics Container") {
    Component(dashboard_controller, "Dashboard Controller", "Node.js / Express", "Delivers operational dashboards and strategic executive reports for library administrators and compliance officers.")
    Component(analytics_event_consumer, "Analytics Event Consumer", "Apache Kafka / Redpanda Consumer", "Processes event streams to provide business intelligence while maintaining strict EU data residency and privacy compliance.")
    Component(report_generation_worker, "Report Generation Worker", "Redis / Kafka Background Worker", "Backs asynchronous worker queues for heavy PDF/CSV report generation, driven by metric-based autoscaling via KEDA.")
    Component(data_archival_service, "Data Archival Service", "HTTPS/TLS 1.3 Client", "Archives raw event logs via automated data tiering to S3-compatible EU Object Storage.")
}

Rel(analytics_event_consumer, dashboard_controller, "Populates analytics data via event streams", "Internal API")
Rel(dashboard_controller, report_generation_worker, "Streams report generation and data export events", "Internal API")
Rel(dashboard_controller, clickhouse_olap_database, "Queries aggregated metrics", "TCP/SQL")
Rel(data_archival_service, eu_object_storage, "Archives raw event logs via automated data tiering", "HTTPS/TLS 1.3")
@enduml