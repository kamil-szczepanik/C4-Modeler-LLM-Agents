@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Kafka/Redpanda Event Streaming Container container

Container_Boundary(kafka_redpanda_event_streaming_container, "Kafka/Redpanda Event Streaming Container") {
    Component(Event Broker Core, "Event Broker Core", "Apache Kafka / Redpanda (C++ thread-per-core architecture)", "Handles high-throughput, low-latency operational and transactional event streaming.")
    Component(Topic Access Control Manager, "Topic Access Control Manager", "Topic-level ACLs", "Enforces security policies and access controls on event streams.")
}

Rel(Event Broker Core, Topic Access Control Manager, "Validates authorized access using")

@enduml