@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patron Portal container

Container_Boundary(patron_portal, "Patron Portal") {
    Component(Web_Frontend, "Web Frontend", "JavaScript / TypeScript", "Provides the self-service user interface for library patrons.")
    Component(Backend_Service, "Backend Service", "Node.js / Java", "Handles business logic, API orchestration, and routing.")
    Component(Search_Client, "Search Client", "REST/TCP Client", "Queries catalogue search data using CQRS pattern from Elasticsearch.")
    Component(Auth_Handler, "Auth Handler", "OAuth2/OIDC Client", "Authenticates users via short-lived signed JWTs and manages vendor token exchange.")
}

Rel(Web_Frontend, Backend_Service, "Sends user requests")
Rel(Backend_Service, Search_Client, "Executes catalogue queries", "REST/TCP")
Rel(Backend_Service, Auth_Handler, "Manages authentication and token exchange", "OAuth2/OIDC")

@enduml