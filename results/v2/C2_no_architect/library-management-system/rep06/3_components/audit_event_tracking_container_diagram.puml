@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit & Event Tracking Container container

Person(ComplianceOfficersAuditors, "Compliance Officers / Auditors", "Primary users requiring tamper-evident logs for GDPR and EU data residency.")
Person(LibraryAdministrators, "Library Administrators", "Users accessing usage insights for collection budgeting and staff allocation.")

System_Boundary(AuditEventTrackingContainer_boundary, "Audit & Event Tracking Container") {
    Component(AuditEventTrackingContainer, "Audit & Event Tracking Container", "Microservice", "Microservice consuming Kafka events, managing backpressure, and generating compliance reports.")
}

System_Ext(KafkaRedpandaEventStreamingContainer, "Kafka/Redpanda Event Streaming Container", "Apache Kafka / Redpanda", "Source of system events via Kafka Protocol.")
System_Ext(ReportingAnalyticsContainer, "Reporting/Analytics Container", "Internal API with mTLS", "Consumer of processed event data via Internal API and mTLS.")
System_Ext(WORMObjectStorage, "WORM Object Storage", "S3-compatible API with AES-256", "EU-region tiered storage for long-term historical logs.")

Rel(KafkaRedpandaEventStreamingContainer, AuditEventTrackingContainer, "Consumes events", "Kafka Protocol")
Rel(AuditEventTrackingContainer, ReportingAnalyticsContainer, "Populates analytics", "Internal API with mTLS")
Rel(AuditEventTrackingContainer, WORMObjectStorage, "Archives compressed Parquet files", "S3-compatible API with AES-256")

@enduml