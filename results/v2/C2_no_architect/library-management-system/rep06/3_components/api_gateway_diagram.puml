@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(istio_routing_handler, "Istio Service Mesh Routing Handler", "Kubernetes Gateway / Istio Service Mesh", "Handles centralized routing, traffic-splitting, and API versioning.")
    Component(mtls_security_enforcer, "mTLS and Security Enforcer", "Istio mTLS", "Enforces secure mTLS communication and perimeter security.")
    Component(oauth_auth_engine, "OAuth2/OIDC Authentication Engine", "OAuth2/OIDC with JWT", "Performs centralized authentication, token exchange, and claims enrichment.")
    Component(global_rate_limiter, "Global Rate Limiter", "Redis", "Acts as the backend for distributed global rate-limiting.")
}

Rel(istio_routing_handler, mtls_security_enforcer, "Secures routed traffic", "mTLS")
Rel(istio_routing_handler, oauth_auth_engine, "Validates tokens for incoming requests", "HTTPS/JWT")
Rel(istio_routing_handler, global_rate_limiter, "Checks rate limits for requests", "TCP")

@enduml