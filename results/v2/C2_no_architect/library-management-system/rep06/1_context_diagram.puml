@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(LibraryPatrons, "Library Patrons", "Library members who access self-service portals.")
Person(LibrariansCirculationStaff, "Librarians/Circulation Staff", "Staff members who manage circulation and library operations.")
Person(LibraryAdministrators, "Library Administrators", "Administrators who configure and manage the library management system.")

System(LibraryManagementSystem, "Library Management System", "Provides self-service portals and circulation management for public and academic libraries within an EU-only data residency constraint, cataloguing physical and digital items with a 99th-percentile search response under 800ms.")

System_Ext(EUhostedIdentityPrvIdP, "EU-hosted Identity Provider (IdP)", "Authenticates users via OpenID Connect (OIDC) with multi-factor authentication (MFA).")
System_Ext(CDNWAFEdgeServices, "CDN/WAF Edge Services", "Provides edge services, TLS 1.3 termination, and perimeter defense.")
System_Ext(DigitalContentVendorsThirdPartyEResourceProviders, "Digital Content Vendors / Third-Party E-Resource Providers", "External providers of digital content integrated via OAuth2 and mTLS.")

Rel(LibraryPatrons, CDNWAFEdgeServices, "Accesses portals", "TLS 1.3")
Rel(LibrariansCirculationStaff, CDNWAFEdgeServices, "Accesses portals", "TLS 1.3")
Rel(LibraryAdministrators, CDNWAFEdgeServices, "Accesses portals", "TLS 1.3")
Rel(CDNWAFEdgeServices, LibraryManagementSystem, "Forwards traffic", "mutual TLS (mTLS)")
Rel(LibraryManagementSystem, EUhostedIdentityPrvIdP, "Authenticates users", "OpenID Connect (OIDC)")
Rel(LibraryManagementSystem, DigitalContentVendorsThirdPartyEResourceProviders, "Integrates for e-resource access", "OAuth2 bearer tokens and mTLS")
@enduml