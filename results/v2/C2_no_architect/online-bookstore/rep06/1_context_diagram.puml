@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Book_Buyer, "Book Buyer", "Primary customer interacting via web/mobile frontends for catalogue browsing, checkout, and reviews.")
Person(Store_Administrator_and_Author_Publisher_Partner, "Store Administrator & Author/Publisher Partner", "Administrative users managing catalogues, permissions, and analytics.")

System(Global_E_Commerce_Book_Platform, "Global E-Commerce Book Platform", "An Amazon-style global e-commerce platform designed to sell physical and electronic books with integrated reviews, recommendations, and multi-currency support.")

System_Ext(Third_Party_Payment_Gateways, "Third-Party Payment Gateways", "External systems handling payment processing.")
System_Ext(Shipping_APIs, "Shipping APIs", "External systems handling order shipping and fulfillment.")
System_Ext(AWS_CloudFront_and_WAF, "AWS CloudFront & WAF", "Edge caching and security boundary.")

Rel(Book_Buyer, Global_E_Commerce_Book_Platform, "HTTPS for catalogue browsing, checkout, and reviews", "HTTPS (TLS 1.3)")
Rel(Store_Administrator_and_Author_Publisher_Partner, Global_E_Commerce_Book_Platform, "Manages catalogues, permissions, and analytics", "HTTPS")
Rel(Global_E_Commerce_Book_Platform, Third_Party_Payment_Gateways, "Processes payments with client-side tokenization", "HTTPS (TLS 1.2+)")
Rel(Global_E_Commerce_Book_Platform, Shipping_APIs, "Asynchronous messaging for shipping and fulfillment", "Amazon SQS and HTTPS")
@enduml