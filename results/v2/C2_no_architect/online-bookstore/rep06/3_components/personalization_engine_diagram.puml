@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(personalization_engine, "Personalization Engine") {
    Component(AWSCloudFrontWAF, "AWS CloudFront & WAF", "AWS Edge Security & Content Delivery", "Routes recommendation requests via HTTPS and enforces edge security.")
    Component(LambdaEdge, "Lambda@Edge", "AWS Lambda@Edge", "Enables low-latency localized inference at the edge and queries user vectors.")
    Component(ECSEKSServices, "ECS/EKS Services", "Amazon ECS/EKS", "Orchestrates containerized recommendation and inference workloads.")
    Component(AmazonElastiCacheRedis, "Amazon ElastiCache / Redis", "Amazon ElastiCache (Redis)", "Provides high-performance, low-latency in-memory caching for user profiles and trending fallbacks.")
    Component(AmazonKinesisSQS, "Amazon Kinesis / SQS", "Amazon Kinesis / SQS", "Decouples interaction tracking to handle high-frequency write spikes asynchronously.")
    Component(AWSAppMesh, "AWS App Mesh", "AWS App Mesh & mTLS", "Enforces zero-trust internal service-to-service communication.")
    Component(AmazonCloudWatchAWSXRay, "Amazon CloudWatch & AWS X-Ray", "Amazon CloudWatch & AWS X-Ray", "Publishes telemetry, KPI dashboards, and system metrics for observability and monitoring.")
}

Rel(AWSCloudFrontWAF, LambdaEdge, "Routes recommendation requests via HTTPS / mTLS over AWS App Mesh", "HTTPS / mTLS")
Rel(LambdaEdge, AmazonElastiCacheRedis, "Queries localized user vectors and cached trending best-sellers", "Redis Protocol")
Rel(ECSEKSServices, AmazonKinesisSQS, "Streams pseudonymized user interactions asynchronously", "Kinesis / SQS API")
Rel(ECSEKSServices, AmazonCloudWatchAWSXRay, "Publishes telemetry, KPI dashboards, and system metrics", "AWS API")

@enduml