@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification Container container

System_Ext(CheckoutPaymentContainer, "Checkout/Payment Container", "External system")
System_Ext(BookBuyerAuthorPublisherPartner, "Book Buyer & Author/Publisher Partner", "External User / Partner", "Recipients of dispatched asynchronous order updates, shipping notifications, and alerts.")
System_Ext(ThirdPartyShippingNotificationAPIs, "Third-Party Shipping & Notification APIs", "HTTPS / TLS 1.3", "External APIs for dispatching fulfillment updates and alerts.")

Container_Boundary(NotificationContainer, "Notification Container") {
    Component(NotificationWorkers, "Notification Workers", "Amazon ECS/EKS", "Orchestrates containerized notification workers with auto-scaling based on SQS queue depth.")
    Component(MessageConsumerDispatcher, "Message Consumer & Dispatcher", "AWS SQS / SNS", "Manages asynchronous message delivery with Dead Letter Queues (DLQ) for fault tolerance.")
    Component(ConsentPreferenceValidator, "Consent & Preference Validator", "Amazon ElastiCache / Redis", "Provides low-latency caching for real-time user preference and GDPR/CCPA consent validation.")
    Component(SecuritySecretsManager, "Security & Secrets Manager", "AWS KMS & AWS Secrets Manager", "Secures PII encryption at rest and dynamic provider API credentials.")
    Component(TracingModule, "Tracing Module", "AWS X-Ray / OpenTelemetry", "Enables distributed tracing across event pipelines.")
}

Rel(CheckoutPaymentContainer, MessageConsumerDispatcher, "Publishes cryptographically signed messages", "AWS SNS/SQS")
Rel(ConsentPreferenceValidator, NotificationWorkers, "Validates real-time user consent", "TCP/In-Memory")
Rel(NotificationWorkers, ThirdPartyShippingNotificationAPIs, "Dispatches fulfillment updates and alerts", "HTTPS / TLS 1.3")
Rel(NotificationWorkers, SecuritySecretsManager, "Fetches dynamic provider API credentials", "AWS API")
Rel(NotificationWorkers, BookBuyerAuthorPublisherPartner, "Sends order updates and alerts", "HTTPS")

@enduml