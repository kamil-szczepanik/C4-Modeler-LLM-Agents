@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Checkout/Payment container

Container_Boundary(checkout_payment, "Checkout/Payment") {
    Component(CartSessionManager, "Cart Session Manager", "Amazon ECS/EKS Container", "Manages shopping carts and session data.")
    Component(PaymentOrchestrator, "Payment Orchestrator", "Amazon ECS/EKS Container", "Handles payment orchestration, idempotency, and client-side tokenization with gateways.")
    Component(FulfillmentIntegrationService, "Fulfillment Integration Service", "Amazon ECS/EKS Container", "Interfaces with third-party shipping APIs to retrieve rates and dispatch orders.")
}

Rel(CartSessionManager, PaymentOrchestrator, "Passes cart and session details for transaction processing", "Internal REST/gRPC")
Rel(PaymentOrchestrator, FulfillmentIntegrationService, "Triggers order dispatch upon successful payment authorization", "Internal REST/gRPC")

@enduml