@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Localization/Currency container

Person(BookBuyer, "Book Buyer", "End-user interacting with the store and currency selectors.")
System_Ext(ExternalExchangeRateAPIs, "External Exchange Rate APIs", "Third-party services providing market exchange rates.")

System_Boundary(LocalizationCurrencySystem, "Localization/Currency") {
    Component(AWSCloudFrontWAF, "AWS CloudFront & WAF", "AWS Edge Service", "Edge service handling Geo-IP resolution via viewer headers and routing.")
    Component(AWSLambdaEdge, "AWS Lambda@Edge", "AWS Lambda", "Edge compute for initial request localization and header processing.")
    Component(LocalizationCurrencyContainer, "Localization/Currency Container", "Amazon ECS/EKS", "Core backend component managing currency logic, localized content support, and user-explicit preference overrides.")
    Component(AWSElastiCacheRedis, "AWS ElastiCache (Redis)", "Redis", "Distributed cache storing synced exchange rates globally via Global Datastores.")
    Component(AWSEventBridgeLambda, "AWS EventBridge & Lambda", "AWS EventBridge & Lambda", "Background worker pipeline for periodic exchange rate synchronization.")
    Component(AWSSecretsManager, "AWS Secrets Manager", "AWS Secrets Manager", "Secure storage for third-party exchange rate API keys.")
}

Rel(AWSCloudFrontWAF, LocalizationCurrencyContainer, "Routes requests", "HTTPS / mTLS over AWS App Mesh")
Rel(AWSEventBridgeLambda, ExternalExchangeRateAPIs, "Fetches market rates periodically", "HTTPS")
Rel(LocalizationCurrencyContainer, AWSElastiCacheRedis, "Reads cached exchange rates", "Redis protocol")
Rel(LocalizationCurrencyContainer, AWSSecretsManager, "Retrieves API credentials securely", "AWS SDK")

@enduml