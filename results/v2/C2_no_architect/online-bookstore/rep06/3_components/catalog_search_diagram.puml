@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog & Search container

Container_Boundary(catalog_search, "Catalog & Search") {
    Component(SearchController, "Search Controller", "Amazon ECS/EKS REST API", "Handles incoming catalog browsing and search requests routed from CloudFront & WAF.")
    Component(SearchEngineConnector, "Search Engine Connector", "Private VPC Networking, OpenSearch Client", "Executes catalog and keyword queries against OpenSearch on AWS.")
    Component(TelemetryEmitter, "Telemetry Emitter", "FluentBit, Amazon Kinesis Data Firehose", "Streams asynchronous search telemetry and PII-masked search analytics.")
}

Rel(SearchController, SearchEngineConnector, "Queries index", "Private VPC / OpenSearch Client")
Rel(SearchController, TelemetryEmitter, "Streams search telemetry", "FluentBit / Kinesis")

@enduml