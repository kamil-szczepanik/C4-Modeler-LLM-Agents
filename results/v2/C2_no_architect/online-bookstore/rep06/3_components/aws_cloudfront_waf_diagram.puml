@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_cloudfront_and_waf, "AWS CloudFront & WAF") {
    Component(cdn_edge_caching, "CDN Edge Caching", "AWS CloudFront", "Caches static assets and handles origin failover with Amazon S3.")
    Component(edge_security_and_ddos_mitigation, "Edge Security & DDoS Mitigation", "AWS WAF & AWS Shield Advanced", "Provides bot control and DDoS mitigation at the edge.")
    Component(request_routing_and_mtls_termination, "Request Routing & mTLS Termination", "AWS Certificate Manager & AWS App Mesh", "Terminates TLS 1.3 and routes requests securely to backend microservices via mTLS.")
}

Rel(cdn_edge_caching, edge_security_and_ddos_mitigation, "Inspects incoming requests")
Rel(edge_security_and_ddos_mitigation, request_routing_and_mtls_termination, "Forwards validated requests via mTLS over AWS App Mesh")

@enduml