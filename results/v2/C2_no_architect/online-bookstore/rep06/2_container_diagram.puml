@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Global E-Commerce Book Platform

Person(Book_Buyer, "Book Buyer", "Primary customer interacting via web/mobile frontends for catalogue browsing, checkout, and reviews.")
Person(Store_Administrator_Author_Publisher_Partner, "Store Administrator & Author/Publisher Partner", "Administrative users managing catalogues, permissions, and analytics.")

System_Ext(Third_Party_Payment_Gateways, "Third-Party Payment Gateways", "External systems handling payment processing.")
System_Ext(Third_Party_Shipping_APIs, "Third-Party Shipping APIs", "External systems handling order shipping and fulfillment.")

System_Boundary(Global_Ecommerce_Book_Platform, "Global E-Commerce Book Platform") {
    Container(AWS_CloudFront_WAF, "AWS CloudFront & WAF", "AWS CloudFront, AWS WAF", "Edge caching, CDN, and security boundary.")
    Container(Catalog_Search, "Catalog & Search", "Amazon ECS/EKS", "Handles product catalog and search operations.")
    Container(Personalization_Engine, "Personalization Engine", "Amazon ECS/EKS, AWS Lambda@Edge", "Provides personalized recommendations for users.")
    Container(Checkout_Payment, "Checkout/Payment", "Amazon ECS/EKS", "Manages secure checkout and payment processing.")
    Container(Localization_Currency, "Localization/Currency", "Amazon ECS/EKS", "Handles multi-currency support and localization.")
    Container(Notification_Container, "Notification Container", "Amazon ECS/EKS, AWS SQS/SNS", "Sends notifications and asynchronous messages.")
}

Rel(Book_Buyer, AWS_CloudFront_WAF, "Accesses the platform securely via edge", "HTTPS (TLS 1.3)")
Rel(Store_Administrator_Author_Publisher_Partner, AWS_CloudFront_WAF, "Manages catalogues and platform administration", "HTTPS")
Rel(AWS_CloudFront_WAF, Catalog_Search, "Routes requests to core services", "HTTPS / mTLS over AWS App Mesh")
Rel(AWS_CloudFront_WAF, Personalization_Engine, "Routes recommendation requests", "HTTPS / mTLS over AWS App Mesh")
Rel(AWS_CloudFront_WAF, Checkout_Payment, "Routes secure checkout requests", "HTTPS / mTLS over AWS App Mesh")
Rel(AWS_CloudFront_WAF, Localization_Currency, "Routes localization requests", "HTTPS / mTLS over AWS App Mesh")
Rel(Checkout_Payment, Third_Party_Payment_Gateways, "Processes secure transactions", "Secure REST APIs")
Rel(Checkout_Payment, Third_Party_Shipping_APIs, "Dispatches shipping and fulfillment orders", "HTTPS")
Rel(Notification_Container, Third_Party_Shipping_APIs, "Sends fulfillment and notification updates", "HTTPS")

@enduml