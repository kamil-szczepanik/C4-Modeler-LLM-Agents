@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Book_Buyer, "Book Buyer", "Primary user interacting with the online bookstore.")
System_Ext(Analytics_CDP_System, "Analytics & CDP System", "External system providing customer behavior and analytics data.")
System_Ext(AWS_Secrets_Manager_AWS_KMS, "AWS Secrets Manager & AWS KMS", "Secures runtime credentials and cryptographically verifies model artifacts.")
System_Ext(Amazon_S3, "Amazon S3", "Model artifact storage.")
System_Ext(Application_Load_Balancer, "Application Load Balancer", "Routes incoming HTTP/REST traffic to the Recommendations Container.")

Container_Boundary(Recommendations_Container_boundary, "Recommendations Container") {
    Component(Recommendations_Container, "Recommendations Container", "Amazon ECS on AWS Fargate", "Serverless microservice that generates real-time 'Customers also bought' suggestions.")
}

Rel(Application_Load_Balancer, Recommendations_Container, "HTTP/REST")
Rel(Recommendations_Container, Analytics_CDP_System, "HTTPS/REST")
Rel(Recommendations_Container, Amazon_S3, "HTTPS/TLS")
Rel(Recommendations_Container, AWS_Secrets_Manager_AWS_KMS, "AWS SDK/TLS")
@enduml