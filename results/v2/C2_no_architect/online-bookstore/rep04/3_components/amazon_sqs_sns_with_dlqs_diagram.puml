@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_sqs_sns_with_dlqs, "Amazon SQS/SNS with DLQs") {
    Component(Checkout_Event_Publisher, "Checkout Event Publisher", "Amazon SNS / SQS Topic & Queue", "Publishes and holds asynchronous checkout events using TLS 1.3 and Encrypted AWS KMS channels.")
    Component(Dead_Letter_Queue_DLQ_, "Dead-Letter Queue (DLQ)", "Amazon SQS DLQ", "Retains failed transactions for up to 14 days for auditing and redrive processing.")
}

Rel(Checkout_Event_Publisher, Dead_Letter_Queue_DLQ_, "Routes failed message deliveries to", "")

@enduml