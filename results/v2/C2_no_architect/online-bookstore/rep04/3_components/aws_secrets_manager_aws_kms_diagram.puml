@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_secrets_manager_and_aws_kms, "AWS Secrets Manager & AWS KMS") {
    Component(SecretsManagerService, "Secrets Manager Service", "AWS Secrets Manager", "Stores and manages runtime credentials securely for search and checkout containers.")
    Component(KeyManagementService, "Key Management Service", "AWS KMS", "Provides envelope encryption and manages multi-region keys for GDPR and CCPA compliance.")
}

Rel(SecretsManagerService, KeyManagementService, "Utilizes encryption keys for securing stored credentials", "HTTPS")

@enduml