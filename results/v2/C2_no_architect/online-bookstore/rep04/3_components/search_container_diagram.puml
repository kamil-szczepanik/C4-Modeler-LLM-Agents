@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(search_container, "Search Container") {
    Component(SearchController, "Search Controller", "Amazon ECS on AWS Fargate (Java/Spring Boot)", "Receives search requests from the Application Load Balancer, handles input validation, and coordinates cache checks and OpenSearch queries.")
    Component(CacheService, "Cache Service", "Amazon ElastiCache (Redis Client)", "Checks and populates the Redis caching layer for frequent search queries.")
    Component(SearchService, "Search Service", "Amazon OpenSearch Client", "Queries the managed AWS OpenSearch cluster for product catalogues and facets.")
    Component(TelemetryEmitter, "Telemetry Emitter", "AWS SDK / SQS & SNS Client", "Emits anonymous search telemetry and zero-result events asynchronously to the SQS/SNS pipeline.")
    Component(SecurityManager, "Security Manager", "AWS Secrets Manager & AWS KMS SDK", "Retrieves secrets and decrypts data securely for compliance and authentication.")
}

Rel(SearchController, CacheService, "Checks cache for frequent search queries", "Redis Protocol / TLS")
Rel(SearchController, SearchService, "Forwards cache-miss search requests and queries product catalogue", "HTTPS")
Rel(SearchService, TelemetryEmitter, "Triggers telemetry emission for zero-result and search events", "")
Rel(SearchController, SecurityManager, "Retrieves secrets and decrypts data", "HTTPS")
@enduml