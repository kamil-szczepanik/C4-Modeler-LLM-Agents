@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(alb, "Application Load Balancer (ALB)") {
    Component(tls_engine, "TLS Termination & Routing Engine", "AWS ALB", "Handles TLS termination using AWS ACM (TLS 1.3), performs header-based routing, and manages traffic flow.")
    Component(auth_offloader, "Authentication Offloader", "Amazon Cognito Integration", "Offloads JWT validation and handles OIDC/OAuth 2.0 identity verification.")
    Component(header_injector, "Header Injector", "ALB Native Middleware", "Forwards validated identity claims via injected headers such as X-User-ID and X-User-Roles to backend services.")
}

Rel(tls_engine, auth_offloader, "Delegates token validation", "OIDC/OAuth 2.0")
Rel(auth_offloader, header_injector, "Passes validated claims", "Internal")

@enduml