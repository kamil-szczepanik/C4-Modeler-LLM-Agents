@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Checkout Container container

Person(Book_Buyer, "Book Buyer", "Primary user executing secure, multi-currency transactions.")
System_Ext(External_Payment_Gateways___Shipping_Providers, "External Payment Gateways & Shipping Providers", "Third-party APIs processing financial transactions and physical fulfillment.")

Container_Boundary(Checkout_Container_boundary, "Checkout Container") {
    Component(Checkout_Container, "Checkout Container", "Amazon ECS on AWS Fargate", "Executes secure payment flows, localized tax calculations, and cart recovery event dispatching.")
}

Container(Application_Load_Balancer__ALB_, "Application Load Balancer (ALB)", "AWS ALB", "Routes incoming requests to the Checkout Container via mTLS.")
Container(Amazon_SQS_SNS_with_DLQs, "Amazon SQS/SNS with DLQs", "Amazon SQS / SNS", "Asynchronous messaging backbone for cart recovery and failed fulfillment retries.")
Container(AWS_Secrets_Manager___AWS_KMS, "AWS Secrets Manager & AWS KMS", "AWS Secrets Manager, AWS KMS", "Manages encryption keys and injects runtime secrets.")

Rel(Application_Load_Balancer__ALB_, Checkout_Container, "Routes encrypted checkout requests", "gRPC / mTLS over AWS App Mesh / ECS Service Connect")
Rel(Checkout_Container, External_Payment_Gateways___Shipping_Providers, "Transmits tokenized payment payloads and fulfillment data", "HTTPS / TLS 1.3 with circuit breakers")
Rel(Checkout_Container, Amazon_SQS_SNS_with_DLQs, "Dispatches asynchronous cart recovery and failed fulfillment events", "AWS SDK / HTTPS")
Rel(Checkout_Container, AWS_Secrets_Manager___AWS_KMS, "Retrieves runtime secrets and performs envelope encryption", "HTTPS")

@enduml