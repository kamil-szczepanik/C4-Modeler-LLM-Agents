@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Shopping Cart Container container

Container_Boundary(shopping_cart_container, "Shopping Cart Container") {
    Component(Shopping_Cart_Controller, "Shopping Cart Controller", "AWS Fargate / ECS / gRPC over TLS", "Manages ingress requests routed from the Application Load Balancer, handling cart operations and user interactions.")
    Component(Cart_Business_Logic___Merging_Service, "Cart Business Logic & Merging Service", "Node.js / Python Container Service", "Handles cart state business logic, guest-to-authenticated cart merging, and compliance rules for GDPR and CCPA.")
    Component(Redis_State_Persistence_Handler, "Redis State Persistence Handler", "Amazon ElastiCache (Redis) Client & Lua Scripts", "Executes atomic Redis Lua scripts for fast state persistence, retrieval, and multi-AZ replication.")
    Component(Event_Publisher, "Event Publisher", "Amazon SQS/SNS Client with AWS KMS", "Publishes pseudonymized asynchronous cart update and abandonment events to the event broker.")
}

Rel(Shopping_Cart_Controller, Cart_Business_Logic___Merging_Service, "Delegates validated ingress requests for processing", "gRPC over TLS")
Rel(Cart_Business_Logic___Merging_Service, Redis_State_Persistence_Handler, "Persists and merges cart state using atomic operations", "In-transit TLS")
Rel(Cart_Business_Logic___Merging_Service, Event_Publisher, "Triggers asynchronous cart and abandonment events", "Encrypted AWS KMS channels")

@enduml