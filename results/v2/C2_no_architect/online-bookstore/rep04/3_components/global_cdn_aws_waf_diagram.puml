@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Global CDN & AWS WAF container

Container_Boundary(global_cdn_waf, "Global CDN & AWS WAF") {
    Component(Amazon_CloudFront, "Amazon CloudFront", "AWS CloudFront", "Provides global content delivery and edge caching for the e-commerce platform.")
    Component(AWS_WAF, "AWS WAF", "AWS WAF with Bot Control", "Inspects and filters incoming web traffic to protect against common web exploits and bots.")
}

Rel(Amazon_CloudFront, AWS_WAF, "Routes incoming requests for security inspection", "HTTPS")

@enduml