@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(BookBuyer, "Book Buyer", "Customer who browses the catalogue and makes purchases.")
Person(SiteAdministrator, "Site Administrator", "Moderator who manages content and system administration.")

System_Ext(ExternalPaymentGatewaysShippingProvidersandBookPublishers, "External Payment Gateways, Shipping Providers, and Book Publishers", "External services for processing payments, managing shipments, and receiving publisher data.")

System_Boundary(OnlineBookstore, "Online Bookstore") {
    Container(GlobalCDNandAWSWAF, "Global CDN & AWS WAF", "AWS WAF / CloudFront", "Provides global content delivery and web application firewall protection.")
    Container(ApplicationLoadBalancerALB, "Application Load Balancer (ALB)", "AWS ALB", "Routes incoming traffic to backend ECS containers.")
    Container(SearchContainer, "Search Container", "Amazon ECS on AWS Fargate", "Supports scalable book discovery and search functionality.")
    Container(RecommendationsContainer, "Recommendations Container", "Amazon ECS on AWS Fargate", "Provides book recommendations to users.")
    Container(CheckoutContainer, "Checkout Container", "Amazon ECS on AWS Fargate", "Handles secure multi-currency checkout workflows.")
    Container(ShoppingCartContainer, "Shopping Cart Container", "Amazon ECS on AWS Fargate", "Manages user shopping cart items and state.")
    Container(AmazonCognito, "Amazon Cognito", "Amazon Cognito (OIDC / OAuth 2.0)", "Handles authentication and session management.")
    Container(AmazonSQSSNSwithDLQs, "Amazon SQS/SNS with DLQs", "Amazon SQS / SNS", "Handles asynchronous event messaging with Dead-Letter Queues.")
    Container(AWSSecretsManagerandAWSKMS, "AWS Secrets Manager & AWS KMS", "AWS Secrets Manager / AWS KMS", "Manages runtime credentials and encryption keys.")
}

Rel(BookBuyer, GlobalCDNandAWSWAF, "Accesses catalogue and system", "HTTPS")
Rel(SiteAdministrator, GlobalCDNandAWSWAF, "Accesses administration system", "HTTPS")
Rel(GlobalCDNandAWSWAF, ApplicationLoadBalancerALB, "Forwards verified traffic", "HTTPS")
Rel(ApplicationLoadBalancerALB, SearchContainer, "Routes search requests", "HTTP/REST")
Rel(ApplicationLoadBalancerALB, RecommendationsContainer, "Routes recommendation requests", "HTTP/REST")
Rel(ApplicationLoadBalancerALB, CheckoutContainer, "Routes checkout requests", "gRPC")
Rel(ApplicationLoadBalancerALB, ShoppingCartContainer, "Routes shopping cart requests", "gRPC")
Rel(CheckoutContainer, ExternalPaymentGatewaysShippingProvidersandBookPublishers, "Processes payments and shipping fulfillment", "HTTPS with circuit breakers")
Rel(SearchContainer, AWSSecretsManagerandAWSKMS, "Retrieves secrets and encryption keys", "HTTPS")
Rel(CheckoutContainer, AWSSecretsManagerandAWSKMS, "Retrieves secrets and encryption keys", "HTTPS")
Rel(ShoppingCartContainer, AmazonSQSSNSwithDLQs, "Publishes asynchronous events", "Encrypted AWS KMS channels")

@enduml