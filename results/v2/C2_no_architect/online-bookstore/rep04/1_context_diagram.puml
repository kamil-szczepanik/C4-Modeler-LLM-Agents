@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Book_Buyer, "Book Buyer", "Customer who browses the catalogue, makes purchases, leaves reviews, and receives recommendations.")
Person(Site_Administrator, "Site Administrator", "Moderator who manages content and system administration.")
System(Online_Bookstore, "Online Bookstore", "A scaled-down Amazon-style e-commerce system designed to provide scalable book browsing, secure checkout, recommendations, and reviews.")
System_Ext(Payment_Gateway___Shipping_Provider_API, "Payment Gateway & Shipping Provider API", "External APIs for processing payments and managing product shipments.")
System_Ext(Book_Publishers___Distributors, "Book Publishers & Distributors", "Suppliers who provide inventory feeds asynchronously.")
System_Ext(Analytics___CDP_System, "Analytics & CDP System", "System that receives pseudonymized telemetry with client-side consent gating.")
System_Ext(Global_CDN_WAF___AWS_Multi_Region_Infrastructure, "Global CDN/WAF & AWS Multi-Region Infrastructure", "Infrastructure providing global content delivery, web application firewalling, and multi-region deployment.")

Rel(Book_Buyer, Global_CDN_WAF___AWS_Multi_Region_Infrastructure, "Accesses catalogue and system via Global CDN/WAF", "HTTPS/TLS 1.3")
Rel(Online_Bookstore, Payment_Gateway___Shipping_Provider_API, "Integrates for payment processing and shipping fulfillment", "mTLS and asynchronous queuing")
Rel(Book_Publishers___Distributors, Online_Bookstore, "Supplies inventory feeds asynchronously", "Amazon EventBridge")
Rel(Online_Bookstore, Analytics___CDP_System, "Sends pseudonymized telemetry data", "Client-side consent gating / HTTPS")

@enduml