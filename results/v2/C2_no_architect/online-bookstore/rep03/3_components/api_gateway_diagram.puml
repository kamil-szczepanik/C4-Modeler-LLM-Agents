@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Ingress_Router, "Ingress Router", "Istio / AWS App Mesh Ingress", "Manages ingress routing, edge geo-routing, and incoming HTTPS requests.")
    Component(Rate_Limiter, "Rate Limiter", "Istio Service Mesh / AWS WAF Integration", "Enforces rate limiting and filters web traffic to protect downstream services.")
    Component(Authentication_Token_Verifier, "Authentication & Token Verifier", "AWS KMS / Istio Security", "Verifies and signs cryptographic JWS tokens for internal identity propagation.")
}

Rel(Ingress_Router, Rate_Limiter, "Forwards web traffic for inspection and rate limiting", "HTTPS")
Rel(Rate_Limiter, Authentication_Token_Verifier, "Delegates token verification for sanitized requests", "Internal AWS API")

@enduml