@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog Container container

Container_Boundary("Catalog Container", "Catalog Container") {
    Component(CatalogController, "Catalog Controller", "Amazon EKS / Microservices", "Handles incoming catalog and product metadata HTTP/HTTPS requests from the API Gateway.")
    Component(SearchQueryProcessor, "Search Query Processor", "AWS OpenSearch Integration", "Queries AWS OpenSearch for high-performance product metadata and pre-calculated regional pricing.")
    Component(RecommendationDataConsumer, "Recommendation Data Consumer", "Microservice Internal API", "Consumes and supplies catalog data for the Recommendation Engine Container via mTLS.")
}

Rel(CatalogController, SearchQueryProcessor, "Fetches product metadata and pricing")
Rel(RecommendationDataConsumer, CatalogController, "Retrieves catalog data via mTLS")

@enduml