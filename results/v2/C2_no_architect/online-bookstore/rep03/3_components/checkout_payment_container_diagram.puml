@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Checkout/Payment Container container

Container_Boundary(checkout_payment_container, "Checkout/Payment Container") {
    Component(PaymentController, "Payment Controller", "Spring Web / REST", "Handles incoming checkout and payment initiation requests from the API Gateway.")
    Component(TransactionEngine, "Transaction Engine", "Java / Microservice Component", "Processes secure transactions, ensures idempotency, and manages multi-currency logic.")
    Component(PaymentGatewayClient, "Payment Gateway Client", "HTTPS Client with Circuit Breakers", "Authorizes payments and communicates securely with external Third-Party Payment APIs.")
    Component(LocalizationIntegrationComponent, "Localization Integration Component", "gRPC / REST Client", "Retrieves localized pricing and tax calculations from the Currency Localization Container.")
    Component(SecretsManagerClient, "Secrets Manager Client", "AWS SDK with IRSA / IAM", "Fetches encrypted API credentials dynamically from AWS Secrets Manager.")
}

Rel(PaymentController, TransactionEngine, "Delegates checkout requests and transactional payloads")
Rel(TransactionEngine, PaymentGatewayClient, "Initiates payment authorization")
Rel(TransactionEngine, LocalizationIntegrationComponent, "Requests localized totals and taxes")
Rel(TransactionEngine, SecretsManagerClient, "Fetches runtime credentials securely")

@enduml