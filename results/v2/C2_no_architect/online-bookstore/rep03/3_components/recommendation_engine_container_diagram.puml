@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(recommendation_engine_container, "Recommendation Engine Container") {
    Component(Recommendation Engine Core, "Recommendation Engine Core", "Amazon EKS Microservice", "Core microservice that delivers personalized, privacy-compliant book recommendations.")
    Component(Redis Sidecar, "Redis Sidecar", "Redis", "Caches pre-computed recommendations and user affinity profiles for sub-200ms response times.")
    Component(Istio Service Mesh, "Istio Service Mesh", "Istio", "Manages mTLS, traffic routing, and circuit breaking for the container.")
}

Rel(Istio Service Mesh, Recommendation Engine Core, "Routes internal inference requests", "mTLS")
Rel(Recommendation Engine Core, Redis Sidecar, "Retrieves cached recommendations", "TCP / AES-256")

@enduml