@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Currency Localization Container container

Person(GlobalShopper, "Global Shopper", "End-user browsing catalogue and executing secure checkouts.")
Person(SiteAdministrator, "Site Administrator", "Manages exchange-rate overrides and operational configurations.")
System_Ext(APIGateway, "API Gateway", "Routes internal requests via mTLS.")
System_Ext(ThirdPartyFinancialAPIs, "Third-Party Financial APIs", "External providers supplying daily exchange rates.")

Container_Boundary(CurrencyLocalizationContainer_boundary, "Currency Localization Container") {
    Component(CurrencyLocalizationContainer, "Currency Localization Container", "Amazon EKS, Container", "Core microservice handling currency conversion logic, geo-IP fallback, and multi-currency pricing.")
    ComponentDb(RedisCache, "Redis Cache", "Redis, In-memory cache", "Low-latency store for cached exchange rates and geo-IP mapping data.")
    Component(AWSKMS, "AWS KMS", "AWS KMS", "Encryption service for securing data at rest.")
}

Rel(APIGateway, CurrencyLocalizationContainer, "Routes internal requests via mTLS", "Istio service mesh")
Rel(CurrencyLocalizationContainer, RedisCache, "Retrieves and caches exchange rates", "TCP")
Rel(CurrencyLocalizationContainer, ThirdPartyFinancialAPIs, "Fetches daily exchange rates", "TLS 1.3 with egress filtering")
Rel(SiteAdministrator, CurrencyLocalizationContainer, "Executes administrative overrides via secure portal", "HTTPS/JWT")

@enduml