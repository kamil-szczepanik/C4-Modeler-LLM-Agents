@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Support/Moderation Portals container

Person(CustomerSupportAgent, "Customer Support Agent", "Accesses portal via HTTPS with Zero-Trust VPN/MFA to manage user disputes, reviews, and GDPR/CCPA data requests.")
Person(ContentModerator, "Content Moderator", "Accesses portal via HTTPS with Zero-Trust VPN/MFA to moderate user content and reviews.")

System_Boundary(SupportModerationPortalsContainer_boundary, "Support/Moderation Portals") {
    Container(SupportModerationPortalsContainer, "Support/Moderation Portals Container", "Amazon EKS", "Provides isolated container deployment for internal support and moderation services.")
    Component(InternalApplicationLoadBalancer, "Internal Application Load Balancer", "AWS ALB", "Routes internal staff traffic securely to the portals.")
    Component(AWSIAMIdentityCenter, "AWS IAM Identity Center", "OIDC/SAML", "Delivers authentication and step-up MFA.")
    Component(AWSKMS, "AWS KMS", "AWS KMS", "Handles field-level encryption at rest for PII.")
    Component(AWSSystemsManagerSessionManager, "AWS Systems Manager Session Manager", "AWS SSM", "Enables ephemeral, JIT break-glass access.")
    Component(IstioServiceMesh, "Istio Service Mesh", "Istio", "Enforces zero-trust microsegmentation, mTLS communication, and regional data isolation.")
}

Rel(CustomerSupportAgent, InternalApplicationLoadBalancer, "Accesses portal via HTTPS with Zero-Trust VPN/MFA", "HTTPS")
Rel(ContentModerator, InternalApplicationLoadBalancer, "Accesses portal via HTTPS with Zero-Trust VPN/MFA", "HTTPS")
Rel(InternalApplicationLoadBalancer, SupportModerationPortalsContainer, "Routes internal staff traffic", "HTTP/HTTPS")
Rel(SupportModerationPortalsContainer, IstioServiceMesh, "Enforces mTLS and regional data isolation", "mTLS")

@enduml