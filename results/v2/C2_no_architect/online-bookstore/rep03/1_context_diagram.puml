@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Global E-Commerce Platform

Person(Customer_Shopper, "Customer (Shopper)", "End user who browses, purchases physical and electronic books, and leaves reviews.")
Person(Site_Administrator, "Site Administrator", "Internal user who manages workflows, administration, and platform operations.")

System(Global_E_Commerce_Platform, "Global E-Commerce Platform", "An Amazon-style global e-commerce platform for purchasing physical and electronic books, supporting multi-currency transactions, personalized recommendations, and reviews.")

System_Ext(Warehouse_Fulfillment_Partner, "Warehouse / Fulfillment Partner", "Third-party partner responsible for physical book shipping and fulfillment.")
System_Ext(Third_Party_Payment_APIs, "Third-Party Payment APIs", "External systems handling multi-currency financial transactions and payments.")
System_Ext(AWS_CloudFront, "AWS CloudFront", "CDN with Lambda@Edge providing global edge caching and performance.")
System_Ext(AWS_WAF, "AWS WAF", "Web Application Firewall protecting incoming customer traffic.")
System_Ext(AWS_ECS_EKS, "AWS ECS / EKS", "Microservices container platform deployed across multiple regions.")
System_Ext(AWS_KMS, "AWS KMS", "Key Management Service for data-at-rest encryption and compliance.")

Rel(Customer_Shopper, Global_E_Commerce_Platform, "Interacts via HTTPS through AWS CloudFront and AWS WAF", "HTTPS (TLS 1.3)")
Rel(Site_Administrator, Global_E_Commerce_Platform, "Accesses internal workflows via secure endpoints", "RBAC and MFA-secured HTTPS")
Rel(Global_E_Commerce_Platform, Warehouse_Fulfillment_Partner, "Connects asynchronously via encrypted AWS queues for shipping", "Encrypted AWS Queues / Third-Party APIs")
Rel(Global_E_Commerce_Platform, Third_Party_Payment_APIs, "Processes multi-currency transactions securely", "HTTPS / REST APIs")

@enduml