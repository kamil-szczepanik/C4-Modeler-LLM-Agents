@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Global E-Commerce Platform

Person(Customer_Shopper, "Customer (Shopper)", "End user who browses the catalogue and executes secure checkout.")
Person(Site_Administrator, "Site Administrator", "Internal user who manages site administration.")
Person(Content_Moderator, "Content Moderator", "Internal user who moderates content on the platform.")
Person(Customer_Support_Agent, "Customer Support Agent", "Internal user who handles customer support inquiries.")

System_Ext(Warehouse_Fulfillment_Partner, "Warehouse / Fulfillment Partner", "Third-party partner responsible for shipping and fulfillment.")
System_Ext(Third_Party_Payment_APIs, "Third-Party Payment APIs", "External systems handling financial transactions and payments.")
System_Ext(AWS_CloudFront, "AWS CloudFront", "CDN providing global edge caching and performance.")
System_Ext(AWS_WAF, "AWS WAF", "Web Application Firewall protecting incoming customer traffic.")

System_Boundary(Global_E_Commerce_Platform, "Global E-Commerce Platform") {
    Container(API_Gateway, "API Gateway", "Istio / AWS App Mesh", "Routes internal requests using mTLS via service mesh.")
    Container(Catalog_Container, "Catalog Container", "Amazon EKS / Microservices", "Manages the product and book catalog workloads.")
    Container(Recommendation_Engine_Container, "Recommendation Engine Container", "Amazon EKS / Microservices", "Provides personalized book recommendations to users.")
    Container(Checkout_Payment_Container, "Checkout/Payment Container", "Amazon EKS / Microservices", "Handles sensitive payment and checkout processes.")
    Container(Currency_Localization_Container, "Currency Localization Container", "Amazon EKS / Microservices", "Handles multi-currency conversions and localization.")
    Container(Support_Moderation_Portals, "Support/Moderation Portals", "Amazon EKS / Web Portals", "Provides interfaces for customer support and content moderation.")
}

Rel(Customer_Shopper, AWS_CloudFront, "Browses catalogue and executes secure checkout", "HTTPS")
Rel(AWS_CloudFront, API_Gateway, "Forwards regional traffic using HTTPS", "HTTPS")
Rel(API_Gateway, Catalog_Container, "Routes internal requests", "mTLS via service mesh")
Rel(API_Gateway, Recommendation_Engine_Container, "Routes internal requests", "mTLS via service mesh")
Rel(API_Gateway, Checkout_Payment_Container, "Routes internal requests", "mTLS via service mesh")
Rel(API_Gateway, Currency_Localization_Container, "Routes internal requests", "mTLS via service mesh")
Rel(API_Gateway, Support_Moderation_Portals, "Routes internal requests", "mTLS via service mesh")
Rel(Checkout_Payment_Container, Third_Party_Payment_APIs, "Integrates with payment APIs using circuit breakers", "HTTPS with circuit breakers")
Rel(Catalog_Container, Warehouse_Fulfillment_Partner, "Integrates with shipping partners", "HTTPS with circuit breakers")

@enduml