@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers, "Customers", "End-users browsing catalogues, managing carts, and purchasing books.")
Person(Authors_Publishers, "Authors/Publishers", "Secondary users accessing sales analytics and review feedback.")
Person(Store_Administrators, "Store Administrators", "Back-office staff managing catalogues, moderation, and fulfillment.")

System(Online_Bookstore_System, "Online Bookstore System", "A globally distributed, Amazon-style e-commerce platform designed to support physical and electronic book sales, personalized recommendations, and reviews while handling 1M MAU globally.")

System_Ext(Payment_Gateway, "Payment Gateway", "External payment processors like Stripe/PayPal for secure payment handling.")
System_Ext(Third_Party_Shipping_Provider_APIs, "Third-Party Shipping Provider APIs", "External shipping services for order fulfillment and tracking.")

Rel(Customers, Online_Bookstore_System, "Interacts via Edge/CDN and HTTPS/TLS 1.3 to browse, cart, and purchase.", "HTTPS / TLS 1.3")
Rel(Authors_Publishers, Online_Bookstore_System, "Accesses sales analytics and review feedback.", "HTTPS")
Rel(Store_Administrators, Online_Bookstore_System, "Manages catalogues, moderation, and fulfillment.", "HTTPS")
Rel(Online_Bookstore_System, Payment_Gateway, "Integrates via Tokenized Client-Side SDKs for payment processing.", "Tokenized Client-Side SDKs / TLS 1.3")
Rel(Online_Bookstore_System, Third_Party_Shipping_Provider_APIs, "Integrates for shipping and fulfillment operations.", "HTTPS")

@enduml