@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(catalogue_service, "Catalogue Service") {
    Component(catalogue_rest_and_grpc_api_controller, "Catalogue REST and gRPC API Controller", "Node.js / Express / gRPC", "Handles incoming REST and gRPC requests over mTLS from the Web Frontend for product browsing and search.")
    Component(administration_api_controller, "Administration API Controller", "Node.js / Express with OIDC/JWT, RBAC, and MFA", "Processes authenticated administrative requests for inventory updates and catalogue metadata changes.")
    Component(product_catalogue_manager, "Product Catalogue Manager", "TypeScript / Business Logic Layer", "Executes business logic for catalogue data management, pricing, and multi-currency support.")
    Component(inventory_transaction_service, "Inventory Transaction Service", "TypeScript / SQL Driver", "Manages transactional write operations for inventory and metadata changes directly against Amazon RDS.")
    Component(read_aside_caching_manager, "Read-Aside Caching Manager", "Node.js Redis Client with Circuit-Breaker", "Handles high-concurrency read queries using Amazon ElastiCache (Redis) with TLS 1.3 encryption and resilience patterns.")
    Component(search_query_resolver, "Search Query Resolver", "OpenSearch Client", "Interfaces with AWS OpenSearch to execute low-latency faceted keyword searches.")
    Component(event_publisher, "Event Publisher", "AWS EventBridge / Kafka SDK", "Emits real-time inventory change events to the event bus for asynchronous CQRS synchronization.")
}

Rel(catalogue_rest_and_grpc_api_controller, read_aside_caching_manager, "Retrieves cached product and catalogue data", "Node.js Redis Client")
Rel(catalogue_rest_and_grpc_api_controller, search_query_resolver, "Executes low-latency search and browsing queries", "OpenSearch Client")
Rel(administration_api_controller, product_catalogue_manager, "Passes validated administrative metadata and pricing changes", "In-Memory")
Rel(product_catalogue_manager, inventory_transaction_service, "Initiates transactional database writes", "TypeScript / SQL")
Rel(inventory_transaction_service, event_publisher, "Triggers event emission for state changes", "AWS SDK")
@enduml