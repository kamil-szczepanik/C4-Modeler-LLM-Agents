@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(recommendation_engine, "Recommendation Engine") {
    Component(Inference Service, "Inference Service", "AWS ECS/EKS Container", "Handles real-time gRPC inference for personalized book recommendations.")
    Component(Model Ingestion Module, "Model Ingestion Module", "AWS S3 and sigstore/Notation", "Ingests and verifies cryptographically signed model weights across multi-region buckets.")
    Component(Fallback and Cache Handler, "Fallback and Cache Handler", "Redis and Edge CDN", "Serves cached public trending fallback payloads to anonymous or unauthenticated users and provides circuit breaking.")
    Component(Compliance and Security Module, "Compliance and Security Module", "mTLS, JWT, AWS X-Ray, Automated TTL", "Enforces security, token validation, distributed tracing, and automated GDPR/CCPA data purges.")
}

Rel(Inference Service, Model Ingestion Module, "Fetches verified model weights")
Rel(Inference Service, Fallback and Cache Handler, "Falls back to cached payloads for unauthenticated users")
@enduml