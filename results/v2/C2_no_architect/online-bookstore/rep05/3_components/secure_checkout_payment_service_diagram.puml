@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(secure_checkout_payment_service, "Secure Checkout & Payment Service") {
    Component(Checkout_Controller, "Checkout Controller", "AWS ECS/EKS container REST/gRPC API", "Handles incoming checkout requests and route operations via mTLS and JWTs.")
    Component(Payment_Processor, "Payment Processor", "AWS ECS/EKS container HTTPS/TLS 1.3", "Processes secure tokenized payments with the External Payment Gateway.")
    Component(Order_Fulfillment_Manager, "Order & Fulfillment Manager", "AWS ECS/EKS container", "Coordinates order fulfillment with Third-Party Shipping Provider APIs via HMAC-verified webhooks.")
    Component(Messaging_Resiliency_Handler, "Messaging & Resiliency Handler", "AWS SQS Dead Letter Queues", "Manages asynchronous messaging, webhook/payment failures, and circuit-breaker handling.")
}

Rel(Checkout_Controller, Payment_Processor, "Delegates tokenized payment requests", "")
Rel(Payment_Processor, Messaging_Resiliency_Handler, "Sends failed payment transactions to Dead Letter Queues", "")
Rel(Order_Fulfillment_Manager, Messaging_Resiliency_Handler, "Handles asynchronous webhook failures and retry queues", "")
@enduml