@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Admin & Reporting Service container

Person(web_frontend, "Web Frontend SPA/SSR", "Web client used by operators and managers")

Container_Boundary(admin_reporting_service, "Admin & Reporting Service") {
    Component(api_container, "Admin & Reporting Service REST API Container", "AWS ECS / EKS Container, REST and gRPC", "Handles administrative and reporting queries, enforces JWT-based RBAC and Row-Level Security.")
    Component(worker_pool, "AWS ECS / EKS Worker Pool & Fargate Spot Tasks", "AWS ECS, EKS, Fargate Spot, AWS SQS", "Processes heavy asynchronous batch report generation without impacting synchronous APIs.")
    Component(redshift, "AWS Redshift / OLAP Data Warehouse & Read Replicas", "AWS Redshift, SQL over TLS 1.3", "Stores analytical data and decouples analytical queries from primary transactional databases.")
    Component(s3_buckets, "AWS S3 Report Export Buckets", "AWS S3, AWS SDK, SSE-KMS", "Persists scheduled and on-demand report exports securely.")
}

Rel(web_frontend, api_container, "Sends administrative and reporting queries using REST and gRPC over mTLS", "REST / gRPC / mTLS")
Rel(api_container, redshift, "Queries analytical data using SQL over TLS 1.3", "SQL / TLS 1.3")
Rel(api_container, s3_buckets, "Persists scheduled and on-demand report exports using AWS SDK with SSE-KMS", "AWS SDK / SSE-KMS")
Rel(api_container, worker_pool, "Queues asynchronous batch export jobs", "AWS SQS")

@enduml