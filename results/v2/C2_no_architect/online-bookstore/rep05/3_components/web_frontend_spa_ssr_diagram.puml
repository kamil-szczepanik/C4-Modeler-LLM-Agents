@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Frontend SPA/SSR container

Container_Boundary(web_frontend_spa_ssr, "Web Frontend SPA/SSR") {
    Component(router_controller, "Router & Controller", "React and Node.js", "Handles incoming HTTP requests, route matching, and hybrid rendering (SPA/SSR).")
    Component(catalogue_client, "Catalogue Client", "REST / gRPC over mTLS", "Communicates with the Catalogue Service to fetch product data and book listings.")
    Component(checkout_client, "Checkout Client", "REST / gRPC over mTLS", "Submits secure checkout requests and handles payment interactions.")
    Component(recommendation_client, "Recommendation Client", "REST / gRPC over mTLS", "Fetches personalized book recommendations for users.")
    Component(admin_client, "Admin Client", "REST / gRPC over mTLS", "Sends administrative and reporting queries to the backend.")
}

System_Ext(catalogue_service, "Catalogue Service", "Catalogue Service container")
System_Ext(secure_checkout_payment_service, "Secure Checkout & Payment Service", "Secure Checkout & Payment Service container")
System_Ext(recommendation_engine, "Recommendation Engine", "Recommendation Engine container")
System_Ext(admin_reporting_service, "Admin & Reporting Service", "Admin & Reporting Service container")

Rel(router_controller, catalogue_client, "Delegates product data requests")
Rel(router_controller, checkout_client, "Delegates checkout submissions")
Rel(router_controller, recommendation_client, "Delegates recommendation requests")
Rel(router_controller, admin_client, "Delegates administrative queries")

Rel(catalogue_client, catalogue_service, "Requests product data", "REST and gRPC over mTLS")
Rel(checkout_client, secure_checkout_payment_service, "Submits checkout requests", "REST and gRPC over mTLS")
Rel(recommendation_client, recommendation_engine, "Fetches recommendations", "REST and gRPC over mTLS")
Rel(admin_client, admin_reporting_service, "Sends administrative queries", "REST and gRPC over mTLS")

@enduml