@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore System

Person(CasualBrowsers, "Casual Browsers", "End-users browsing catalogues and viewing books.")
Person(IntentionalBuyers, "Intentional Buyers", "End-users managing carts and executing secure checkouts.")
Person(AuthorsPublishers, "Authors/Publishers", "Content creators and partners accessing reports and analytics.")
Person(StoreAdministrators, "Store Administrators", "Back-office staff managing catalogues, moderation, and store operations.")

System_Ext(PaymentGateway, "Payment Gateway", "External payment processor for handling secure transactions.")
System_Ext(ThirdPartyShippingProviderAPIs, "Third-Party Shipping Provider APIs", "External shipping services for order fulfillment and tracking.")

System_Boundary(OnlineBookstoreSystem, "Online Bookstore System") {
    Container(WebFrontendSPASSR, "Web Frontend SPA/SSR", "React / Node.js", "Single Page Application and Server-Side Rendered frontend serving users via Edge/CDN.")
    Container(CatalogueService, "Catalogue Service", "AWS ECS/EKS, REST, gRPC", "Handles product browsing, search, and catalogue data management.")
    Container(SecureCheckoutPaymentService, "Secure Checkout & Payment Service", "AWS ECS/EKS, REST, gRPC", "Manages shopping carts, orders, and secure payment integrations.")
    Container(RecommendationEngine, "Recommendation Engine", "AWS ECS/EKS, gRPC", "Provides personalized book recommendations to users.")
    Container(AdminReportingService, "Admin & Reporting Service", "AWS ECS/EKS, REST", "Provides administrative capabilities, analytics, and reporting for authors and store admins.")
}

Rel(CasualBrowsers, WebFrontendSPASSR, "Browses book catalogue and reviews.", "HTTPS (TLS 1.3)")
Rel(IntentionalBuyers, WebFrontendSPASSR, "Manages cart and performs secure checkouts.", "HTTPS (TLS 1.3)")
Rel(AuthorsPublishers, WebFrontendSPASSR, "Accesses analytics and reports.", "HTTPS (TLS 1.3)")
Rel(StoreAdministrators, WebFrontendSPASSR, "Manages store settings and catalogue data.", "HTTPS (TLS 1.3)")
Rel(WebFrontendSPASSR, CatalogueService, "Requests catalogue and product data.", "REST and gRPC over mTLS")
Rel(WebFrontendSPASSR, SecureCheckoutPaymentService, "Submits orders and checkout requests.", "REST and gRPC over mTLS")
Rel(WebFrontendSPASSR, RecommendationEngine, "Fetches personalized recommendations.", "REST and gRPC over mTLS")
Rel(WebFrontendSPASSR, AdminReportingService, "Sends administrative and reporting queries.", "REST and gRPC over mTLS")
Rel(SecureCheckoutPaymentService, PaymentGateway, "Processes secure payments.", "HTTPS / TLS 1.3 API integration")
Rel(SecureCheckoutPaymentService, ThirdPartyShippingProviderAPIs, "Coordinates order fulfillment and tracking.", "HTTPS REST API integrations")

@enduml