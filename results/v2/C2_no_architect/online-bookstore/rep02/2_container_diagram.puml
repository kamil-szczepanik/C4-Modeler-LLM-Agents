@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore Core System

Person(Customers, "Customers", "End users browsing catalogs, purchasing books, and writing reviews.")
Person(Catalog Administrators, "Catalog Administrators", "Administrators managing the bookstore catalog.")
Person(Registered Reviewers / Authors, "Registered Reviewers / Authors", "Users providing reviews and interacting with platform content.")

System_Ext(Amazon CloudFront, "Amazon CloudFront", "Content Delivery Network for edge caching and static asset delivery.")
System_Ext(Amazon Route 53, "Amazon Route 53", "Global Traffic Management and Anycast DNS service.")
System_Ext(Third-Party Payment Gateway, "Third-Party Payment Gateway", "External service handling secure payments.")
System_Ext(Shipping Provider, "Shipping Provider", "Third-party service handling order fulfillment and delivery.")
System_Ext(Recommendation Engine, "Recommendation Engine", "Engine providing personalized recommendations.")

System_Boundary(Online Bookstore Core System, "Online Bookstore Core System") {
    Container(API Gateway Container, "API Gateway Container", "AWS ECS / EKS", "Routes external traffic to internal microservices via App Mesh.")
    Container(Browse & Search Container, "Browse & Search Container", "AWS ECS / EKS", "Handles book catalog browsing and search functionality.")
    Container(Shopping Cart & Checkout Container, "Shopping Cart & Checkout Container", "AWS ECS / EKS", "Manages shopping carts, orders, and secure checkout flows.")
    Container(Reviews & Ratings Container, "Reviews & Ratings Container", "AWS ECS / EKS", "Manages customer reviews, ratings, and author interactions.")
    Container(Recommendations Container, "Recommendations Container", "AWS ECS / EKS", "Delivers personalized product recommendations to users.")
}

Rel(Customers, Amazon CloudFront, "Access platform via secure global routing and CDN", "HTTPS (TLS 1.3)")
Rel(Customers, Amazon Route 53, "Resolve domain and route traffic globally", "DNS")
Rel(Amazon CloudFront, API Gateway Container, "Forwards traffic to core services", "HTTPS")
Rel(API Gateway Container, Browse & Search Container, "Routes browse and search requests via service mesh", "mTLS (AWS App Mesh)")
Rel(API Gateway Container, Shopping Cart & Checkout Container, "Routes cart and checkout requests via service mesh", "mTLS (AWS App Mesh)")
Rel(API Gateway Container, Reviews & Ratings Container, "Routes review requests via service mesh", "mTLS (AWS App Mesh)")
Rel(API Gateway Container, Recommendations Container, "Routes recommendation requests via service mesh", "mTLS (AWS App Mesh)")
Rel(Shopping Cart & Checkout Container, Third-Party Payment Gateway, "Processes secure payments and tokenization", "HTTPS / TLS 1.3")
Rel(Shopping Cart & Checkout Container, Shipping Provider, "Coordinates order fulfillment", "HTTPS")
Rel(Recommendations Container, Recommendation Engine, "Fetches personalized recommendations", "HTTPS")

@enduml