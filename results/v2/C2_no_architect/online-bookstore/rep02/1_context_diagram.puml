@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Online Bookstore Core System

Person(Customers_Shoppers, "Customers (Shoppers)", "End users browsing catalogs, purchasing physical and electronic books, and writing reviews.")
Person(Catalog_Administrators, "Catalog Administrators", "Administrators managing the bookstore catalog and system configurations.")
Person(Registered_Reviewers_Authors, "Registered Reviewers / Authors", "Users who provide reviews and interact with the platform content.")

System(Online_Bookstore_Core_System, "Online Bookstore Core System", "An Amazon-style e-commerce platform for physical and electronic book sales, providing catalog browsing, secure checkout, reviews, and personalized recommendations.")

System_Ext(Amazon_CloudFront, "Amazon CloudFront", "Content Delivery Network (CDN) for edge caching and static asset delivery.")
System_Ext(Amazon_Route_53, "Amazon Route 53", "Global Traffic Management and Anycast DNS service.")
System_Ext(Third_Party_Payment_Gateway, "Third-Party Payment Gateway", "External service handling secure payments via tokenization.")
System_Ext(Shipping_Provider, "Shipping Provider", "Third-party service handling order fulfillment and delivery.")
System_Ext(Recommendation_Engine, "Recommendation Engine", "Third-party engine providing personalized recommendations using anonymized identifiers.")
System_Ext(AWS_CloudWatch_OpenTelemetry, "AWS CloudWatch / OpenTelemetry", "Observability platforms for cross-region monitoring and metrics.")
System_Ext(AWS_IAM_Identity_Center, "AWS IAM Identity Center", "Identity and access management service for administrative security.")

Rel(Customers_Shoppers, Amazon_CloudFront, "Interact via global traffic management and edge caching", "HTTPS (TLS 1.3)")
Rel(Catalog_Administrators, AWS_IAM_Identity_Center, "Access administrative functions via private VPC endpoints", "HTTPS")
Rel(Online_Bookstore_Core_System, Third_Party_Payment_Gateway, "Integrates for secure payments using tokenization", "Tokenized API")
Rel(Online_Bookstore_Core_System, Shipping_Provider, "Connects for order fulfillment and shipping", "Secure APIs")
Rel(Online_Bookstore_Core_System, Recommendation_Engine, "Exchanges anonymized identifiers via circuit breakers", "Secure API")

@enduml