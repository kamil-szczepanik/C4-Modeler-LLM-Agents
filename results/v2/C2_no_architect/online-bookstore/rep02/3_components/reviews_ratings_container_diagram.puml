@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Reviews & Ratings Container container

Container_Boundary(reviews_ratings_container, "Reviews & Ratings Container") {
    Component(Reviews_Ratings_Microservice, "Reviews & Ratings Microservice", "AWS ECS / EKS microservice", "Manages reviews, ratings, badges, and author responses, driving user-generated content, trust, and conversion rates.")
    Component(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL with Read Replicas and AWS KMS (AES-256)", "Provides data persistence for transactional reads/writes and isolated query workloads.")
    Component(Amazon_ElastiCache_Redis, "Amazon ElastiCache Redis", "Amazon ElastiCache Redis", "Caching layer for vote deduplication, caching top reviews, badges, and low-latency read caching.")
    Component(Amazon_SQS, "Amazon SQS", "Amazon SQS", "Messaging and queueing for asynchronous moderation and decoupled database writes.")
    Component(AWS_CloudWatch, "AWS CloudWatch", "AWS CloudWatch and OpenTelemetry", "Handles observability and auditing by streaming operational logs, metrics, and immutable audit trails.")
}

Rel(Reviews_Ratings_Microservice, Amazon_Aurora_PostgreSQL, "Executes transactional reads/writes via JDBC/TLS", "JDBC/TLS")
Rel(Reviews_Ratings_Microservice, Amazon_ElastiCache_Redis, "Handles write-through caching and vote deduplication via RESP protocol", "RESP")
Rel(Reviews_Ratings_Microservice, Amazon_SQS, "Offloads asynchronous moderation events and batch vote persistence", "SQS")
Rel(Reviews_Ratings_Microservice, AWS_CloudWatch, "Streams operational logs, metrics, and immutable audit trails", "OpenTelemetry")

@enduml