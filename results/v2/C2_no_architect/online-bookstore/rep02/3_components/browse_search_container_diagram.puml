@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Browse & Search Container", "Browse & Search Container") {
    Component(Search_Controller, "Search Controller", "AWS ECS / EKS Container Component", "Handles incoming catalog browse and search requests from the API Gateway.")
    Component(Catalog_Search_Service, "Catalog Search Service", "Business Logic Component", "Executes search queries, processes catalog metadata, and interacts with caching layers.")
}

Rel(Search_Controller, Catalog_Search_Service, "Forwards browse and search requests")

@enduml