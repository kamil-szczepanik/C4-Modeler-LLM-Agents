@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Recommendations Container container

Container_Boundary(recommendations_container_boundary, "Recommendations Container") {
    Component(Recommendations_Container_AWS_ECS_EKS, "Recommendations Container (AWS ECS / EKS)", "AWS ECS / EKS, Fluent Bit Sidecar, AWS App Mesh", "Delivers personalized book suggestions and curated bestsellers to active shoppers within the Online Bookstore platform.")
    ComponentDb(Amazon_ElastiCache_Redis, "Amazon ElastiCache (Redis)", "Amazon ElastiCache (Redis) with AWS KMS encryption", "Caches fallback lists and frequent recommendations for rapid delivery.")
    Component(Amazon_Kinesis_Data_Streams, "Amazon Kinesis Data Streams", "Amazon Kinesis Data Streams with AWS KMS encryption", "Ingests clickstream events and emits asynchronous telemetry.")
}

Component_Ext(API_Gateway_Container, "API Gateway Container", "mTLS (AWS App Mesh)", "Routes recommendation requests to the Recommendations Container.")
Component_Ext(External_Recommendation_Engine, "External Recommendation Engine", "HTTPS with Resilience4j circuit breakers", "External service providing personalized recommendations.")

Rel(API_Gateway_Container, Recommendations_Container_AWS_ECS_EKS, "Routes recommendation requests via service mesh", "mTLS (AWS App Mesh)")
Rel(Recommendations_Container_AWS_ECS_EKS, External_Recommendation_Engine, "Fetches personalized recommendations", "HTTPS with Resilience4j circuit breakers")
Rel(Recommendations_Container_AWS_ECS_EKS, Amazon_ElastiCache_Redis, "Caches fallback lists and frequent recommendations", "Encrypted in-transit and at-rest via AWS KMS")
Rel(Recommendations_Container_AWS_ECS_EKS, Amazon_Kinesis_Data_Streams, "Ingests clickstream events and emits asynchronous telemetry", "Encrypted via AWS KMS")

@enduml