@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(shopping_cart_checkout_container, "Shopping Cart & Checkout Container") {
    Component(Cart_Checkout_Controller, "Cart & Checkout Controller", "AWS ECS / EKS Container", "Manages carts, orders, and secure checkout flows.")
    Component(Currency_Promotion_Manager, "Currency & Promotion Manager", "AWS ECS / EKS Container", "Handles multi-currency conversion and promotional discounts.")
}

Rel(Cart_Checkout_Controller, Currency_Promotion_Manager, "Applies promotional discounts and currency conversion", "")

@enduml