@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_container, "API Gateway Container") {
    Component(api_router_and_dispatcher, "API Router and Dispatcher", "AWS API Gateway / Nginx", "Routes incoming user traffic and API requests to appropriate backend microservices.")
    Component(authentication_and_security_filter, "Authentication and Security Filter", "OAuth2 / JWT Validator", "Enforces security policies, validates tokens, and integrates with AWS IAM Identity Center.")
    Component(service_mesh_proxy_integration, "Service Mesh Proxy Integration", "AWS App Mesh Envoy Sidecar", "Manages mTLS encryption and distributed tracing for outgoing requests to backend containers.")
}

Rel(api_router_and_dispatcher, authentication_and_security_filter, "Validates request authentication")
Rel(api_router_and_dispatcher, service_mesh_proxy_integration, "Forwards routed requests via mTLS")

@enduml