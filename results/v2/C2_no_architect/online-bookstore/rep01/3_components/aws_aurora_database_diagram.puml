@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_aurora_database, "AWS Aurora Database") {
    Component(Compliance_Data_Access_Component, "Compliance Data Access Component", "SQL / AES-256", "Handles reading and writing of compliance data via encrypted SQL connection.")
    Component(Transactional_Order_Data_Component, "Transactional Order Data Component", "SQL / AES-256", "Persists transactional order data securely.")
    Component(Catalog_and_Book_Data_Component, "Catalog and Book Data Component", "SQL / AES-256", "Queries catalog and book information for users and search features.")
}

System(Localization_Compliance_Container, "Localization & Compliance Container", "Container")
System(Cart_Checkout_Container, "Cart & Checkout Container", "Container")
System(Catalog_Search_Container, "Catalog & Search Container", "Container")

Rel(Localization_Compliance_Container, Compliance_Data_Access_Component, "Reads and writes compliance data", "encrypted SQL connection (AES-256)")
Rel(Cart_Checkout_Container, Transactional_Order_Data_Component, "Persists transactional order data", "encrypted SQL connection (AES-256)")
Rel(Catalog_Search_Container, Catalog_and_Book_Data_Component, "Queries catalog and book data", "encrypted SQL connection (AES-256)")

@enduml