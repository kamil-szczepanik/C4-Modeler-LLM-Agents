@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(BookBuyer, "Book Buyer", "Primary user submitting shopping and checkout requests.")
System_Ext(APIGateway, "API Gateway", "Routes validated checkout traffic securely via mTLS.")
System_Ext(ThirdPartyPaymentGateway, "Third-Party Payment Gateway", "Processes tokenized payments.")
System_Ext(ThirdPartyShippingAPIs, "Third-Party Shipping APIs", "Handles fulfillment data with circuit breaker fallbacks.")
System_Ext(AmazonSQS, "Amazon SQS", "Publishes asynchronous order and abandoned cart events.")
System_Ext(AWSAuroraDatabase, "AWS Aurora Database", "Persists transactional data and PII with AES-256 encryption.")

Container_Boundary(CartCheckoutContainerBoundary, "Cart & Checkout Container") {
    Component(CartCheckoutContainer, "Cart & Checkout Container", "Amazon ECS/EKS", "Manages shopping cart sessions, secure payment processing, and order fulfillment.")
}

Rel(BookBuyer, APIGateway, "Submits shopping and checkout requests", "HTTPS / TLS 1.3")
Rel(APIGateway, CartCheckoutContainer, "Routes validated checkout traffic", "mTLS within AWS VPC")
Rel(CartCheckoutContainer, ThirdPartyPaymentGateway, "Processes tokenized payments", "HTTPS REST API")
Rel(CartCheckoutContainer, ThirdPartyShippingAPIs, "Sends fulfillment data with circuit breaker fallbacks", "HTTPS REST API with Resilience4j")
Rel(CartCheckoutContainer, AmazonSQS, "Publishes asynchronous order and abandoned cart events", "AWS SDK with payload encryption")
Rel(CartCheckoutContainer, AWSAuroraDatabase, "Persists transactional data and PII", "Encrypted SQL / AES-256")
@enduml