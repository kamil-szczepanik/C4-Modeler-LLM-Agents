@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Admin & Support Container container

Container_Boundary(admin_support_container, "Admin & Support Container") {
    Component(AdminSupportController, "Admin & Support Controller", "Node.js / Express", "Handles secure administration, catalogue moderation, and dispute resolution requests routed via mTLS.")
    Component(ComplianceProcessingService, "Compliance Processing Service", "Node.js Worker", "Manages GDPR/CCPA data processing and offloads deletion requests asynchronously.")
    Component(AuditLoggingService, "Audit Logging Service", "Node.js / AWS SDK", "Ships cryptographically signed immutable audit logs to storage.")
}

System_Ext(AmazonSQS, "Amazon SQS", "Asynchronous queue for GDPR/CCPA data processing")
System_Ext(AmazonS3ObjectLock, "Amazon S3 Object Lock", "Immutable audit logging storage")

Rel(AdminSupportController, ComplianceProcessingService, "Triggers asynchronous GDPR/CCPA deletion tasks")
Rel(ComplianceProcessingService, AmazonSQS, "Offloads asynchronous GDPR/CCPA deletion requests", "IAM")
Rel(AuditLoggingService, AmazonS3ObjectLock, "Ships cryptographically signed immutable audit logs", "HTTPS/TLS 1.3")
Rel(AdminSupportController, AuditLoggingService, "Sends audit events for operations")
@enduml