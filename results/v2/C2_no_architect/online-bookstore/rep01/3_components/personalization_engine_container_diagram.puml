@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Personalization Engine Container container

Container_Boundary(personalization_engine_container, "Personalization Engine Container") {
    Component(Personalization_Engine_Service, "Personalization Engine Service", "Amazon ECS/EKS", "Core recommendation service delivering real-time 'Customers also bought' recommendations and enforcing privacy compliance.")
    Component(Data_Ingestion_Handler, "Data Ingestion Handler", "Amazon SQS", "Ingests asynchronous user behavior telemetry.")
    Component(Cache_Profile_Manager, "Cache & Profile Manager", "Amazon ElastiCache", "Reads cached user affinity profiles and fallback bestsellers.")
    Component(Model_Loader_Verifier, "Model Loader & Verifier", "AWS KMS and S3", "Loads and cryptographically verifies ML models with AES-256 encryption.")
    Component(Traffic_Security_Manager, "Traffic & Security Manager", "AWS API Gateway / AWS App Mesh", "Manages incoming traffic via mTLS and circuit breakers.")
}

Rel(Traffic_Security_Manager, Personalization_Engine_Service, "Invokes recommendation endpoints via mTLS inside AWS VPC", "mTLS")
Rel(Personalization_Engine_Service, Cache_Profile_Manager, "Reads cached affinity profiles and fallback bestsellers via TCP", "TCP")
Rel(Personalization_Engine_Service, Data_Ingestion_Handler, "Ingests asynchronous user behavior telemetry via HTTPS/TLS 1.3", "HTTPS/TLS 1.3")
Rel(Personalization_Engine_Service, Model_Loader_Verifier, "Loads cryptographically verified ML models via HTTPS/TLS 1.3 with AWS KMS", "HTTPS/TLS 1.3")

@enduml