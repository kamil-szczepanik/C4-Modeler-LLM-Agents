@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog & Search Container container

Container_Boundary(catalog_search_container, "Catalog & Search Container") {
    Component(Search and Browse Controller, "Search and Browse Controller", "Amazon ECS/EKS, Spring Boot", "Handles incoming search, browse, and facet requests routed via the API Gateway.")
    Component(Inventory and Catalog Service, "Inventory and Catalog Service", "Amazon ECS/EKS, Java", "Manages book inventory, real-time availability, and multi-currency pricing logic.")
    Component(Telemetry Publisher, "Telemetry Publisher", "Amazon ECS/EKS, AWS SDK", "Publishes sanitized, anonymized search telemetry asynchronously for personalization.")
}

System_Ext(AWS Aurora Global Database, "AWS Aurora Global Database", "Multi-region persistent storage for catalog data.")
System_Ext(Amazon ElastiCache, "Amazon ElastiCache", "Write-through caching layer for real-time stock and catalog data.")
System_Ext(Amazon SQS, "Amazon SQS", "Asynchronous event queue for telemetry and personalization signals.")

Rel(Search and Browse Controller, Inventory and Catalog Service, "Delegates search and facet queries")
Rel(Inventory and Catalog Service, AWS Aurora Global Database, "Queries and updates catalog records using encrypted SQL (AES-256)")
Rel(Inventory and Catalog Service, Amazon ElastiCache, "Retrieves cached catalog data and manages real-time availability via Redis Pub/Sub")
Rel(Telemetry Publisher, Amazon SQS, "Publishes sanitized telemetry signals asynchronously")

@enduml