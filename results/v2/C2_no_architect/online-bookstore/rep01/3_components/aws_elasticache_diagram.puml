@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_elasticache, "AWS ElastiCache") {
    Component(Catalog_Caching_Component, "Catalog Caching Component", "Redis Cluster Mode Enabled", "Retrieves and serves cached catalog data for low-latency page loads.")
    Component(Recommendation_Namespace_Component, "Recommendation Namespace Component", "Redis Namespace", "Maintains isolated recommendation data for the personalization engine.")
    Component(Cart_Namespace_Component, "Cart Namespace Component", "Redis Namespace", "Maintains isolated session and cart namespaces for active users.")
}

Rel(Catalog_Caching_Component, Recommendation_Namespace_Component, "Isolates cache data using Redis namespaces", "")
Rel(Catalog_Caching_Component, Cart_Namespace_Component, "Isolates cache data using Redis namespaces", "")
@enduml