@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Localization & Compliance Container container

Container_Boundary(localization_compliance_container, "Localization & Compliance Container") {
    Component(Localization_Controller, "Localization Controller", "AWS ECS/EKS REST API Endpoint", "Routes regional localization and compliance requests, handling currency conversion and geo-lookup data.")
    Component(Compliance_Manager, "Compliance Manager", "AWS ECS/EKS Service Worker", "Ensures strict adherence to GDPR, CCPA, and multi-currency requirements across international markets.")
    Component(Data_Purge_Publisher, "Data Purge Publisher", "AWS SQS Client", "Publishes asynchronous GDPR/CCPA deletion requests securely.")
}

Rel(Localization_Controller, Compliance_Manager, "Validates and processes regional compliance and localization requests", "mTLS inside AWS VPC")
Rel(Compliance_Manager, Data_Purge_Publisher, "Sends asynchronous GDPR/CCPA deletion requests", "Encrypted TLS / AWS KMS")

@enduml