@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon SQS container

Container_Boundary(amazon_sqs, "Amazon SQS") {
    Component(Queue_Management_Interface, "Queue Management Interface", "AWS SDK with TLS 1.3", "Handles asynchronous fulfillment event queuing and message ingestion with 14-day maximum retention.")
    Component(Dead_Letter_Queue_Handler, "Dead-Letter Queue Handler", "AWS SQS DLQ", "Manages failed message routing and business continuity for unprocessable fulfillment events.")
    Component(Encryption_Service, "Encryption Service", "AWS KMS", "Provides Server-Side Encryption (SSE) using customer-managed keys for queue data protection.")
}

Rel(Queue_Management_Interface, Dead_Letter_Queue_Handler, "Routes failed messages upon processing exhaustion")
Rel(Queue_Management_Interface, Encryption_Service, "Encrypts and decrypts queue payloads using customer-managed keys")

@enduml