@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Edge_Termination_Component, "Edge Termination Component", "AWS API Gateway with TLS 1.3", "Manages secure edge routing, TLS 1.3 termination, and latency-based multi-region routing via Route 53.")
    Component(Security_WAF_Component, "Security & WAF Component", "AWS WAF", "Provides OWASP Top-10 mitigation and edge security for incoming global traffic.")
    Component(Authentication_Authorization_Component, "Authentication & Authorization Component", "JWT/OAuth2 Validator", "Validates JSON Web Tokens and OAuth2 credentials for incoming buyer, reviewer, administrator, and support requests.")
}

Container(Cart_Checkout_Container, "Cart & Checkout Container", "Amazon ECS/EKS", "Handles cart and checkout operations.")

Rel(Security_WAF_Component, Edge_Termination_Component, "Filters and inspects incoming traffic")
Rel(Edge_Termination_Component, Authentication_Authorization_Component, "Passes terminated requests for credential validation")
Rel(Authentication_Authorization_Component, Cart_Checkout_Container, "Routes validated traffic", "mTLS")

@enduml