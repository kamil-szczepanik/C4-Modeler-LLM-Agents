@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore Platform

Person(BookBuyer, "Book Buyer", "Customer who browses the catalogue, manages cart, and completes checkout.")
Person(BookReviewer, "Book Reviewer", "User who interacts with the platform to write and manage reviews.")
Person(StoreAdministrator, "Store Administrator", "User responsible for managing store operations and configurations.")
Person(SupportAgent, "Support Agent", "User who handles customer support inquiries and issues.")

System_Ext(ThirdPartyPaymentGateway, "Third-Party Payment Gateway", "Processes tokenized payments securely.")
System_Ext(ThirdPartyShippingAPIs, "Third-Party Shipping APIs", "Handles shipping and fulfillment operations.")

System_Boundary(OnlineBookstorePlatform, "Online Bookstore Platform") {
    Container(APIGateway, "API Gateway", "AWS API Gateway / TLS 1.3", "Routes validated REST/gRPC traffic with TLS 1.3 edge termination.")
    Container(CartCheckoutContainer, "Cart & Checkout Container", "Amazon ECS/EKS / Transactional Outbox", "Manages shopping cart and order checkout using the Transactional Outbox pattern.")
    Container(CatalogSearchContainer, "Catalog & Search Container", "Amazon ECS/EKS", "Manages book catalog, physical and electronic inventory, and search capabilities.")
    Container(PersonalizationEngineContainer, "Personalization Engine Container", "Amazon ECS/EKS", "Provides recommendations and personalized user experiences.")
    Container(LocalizationComplianceContainer, "Localization & Compliance Container", "Amazon ECS/EKS", "Ensures compliance with GDPR, CCPA, and regional localization requirements.")
    Container(AdminSupportContainer, "Admin & Support Container", "Amazon ECS/EKS", "Provides administrative tooling and customer support capabilities.")
    ContainerDb(AWSAuroraDatabase, "AWS Aurora Database", "AWS Aurora (Multi-Region)", "Multi-region relational database providing stateless container persistence.")
    ContainerDb(AWSElastiCache, "AWS ElastiCache", "Amazon ElastiCache", "Provides low-latency caching for fast retrieval.")
    Container(AmazonSQS, "Amazon SQS", "Amazon SQS", "Handles asynchronous event messaging and payload envelope encryption.")
}

Rel(BookBuyer, APIGateway, "Browses catalog, manages cart, and completes checkout", "HTTPS (TLS 1.3)")
Rel(BookReviewer, APIGateway, "Submits and manages reviews", "HTTPS (TLS 1.3)")
Rel(StoreAdministrator, APIGateway, "Manages store operations", "HTTPS (TLS 1.3)")
Rel(SupportAgent, APIGateway, "Handles customer support inquiries", "HTTPS (TLS 1.3)")

Rel(APIGateway, CartCheckoutContainer, "Routes checkout traffic", "mTLS inside AWS VPC")
Rel(APIGateway, CatalogSearchContainer, "Routes catalog and search requests", "mTLS inside AWS VPC")
Rel(APIGateway, PersonalizationEngineContainer, "Routes recommendation requests", "mTLS inside AWS VPC")
Rel(APIGateway, LocalizationComplianceContainer, "Routes compliance and localization requests", "mTLS inside AWS VPC")
Rel(APIGateway, AdminSupportContainer, "Routes administration and support requests", "mTLS inside AWS VPC")

Rel(CartCheckoutContainer, ThirdPartyPaymentGateway, "Processes tokenized payments", "HTTPS REST API (Tokenization)")
Rel(CartCheckoutContainer, ThirdPartyShippingAPIs, "Sends fulfillment and shipping data", "HTTPS REST API")
Rel(CartCheckoutContainer, AmazonSQS, "Queues asynchronous events", "AWS SDK (Payload envelope encryption)")

Rel(LocalizationComplianceContainer, AWSAuroraDatabase, "Reads and writes compliance data", "Encrypted SQL connection (AES-256)")
Rel(CartCheckoutContainer, AWSAuroraDatabase, "Persists transactional order data", "Encrypted SQL connection (AES-256)")
Rel(CatalogSearchContainer, AWSAuroraDatabase, "Queries catalog and book data", "Encrypted SQL connection (AES-256)")
Rel(CatalogSearchContainer, AWSElastiCache, "Retrieves cached catalog data", "Encrypted connection")

@enduml