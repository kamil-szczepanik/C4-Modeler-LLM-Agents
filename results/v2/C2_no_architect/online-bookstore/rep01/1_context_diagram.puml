@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore Platform

Person(BookBuyer, "Book Buyer", "Customer who browses the catalogue, manages cart, and completes checkout.")
Person(BookReviewer, "Book Reviewer", "User who interacts with the platform to write and manage reviews.")
Person(StoreAdministrator, "Store Administrator", "User responsible for managing store operations and configurations.")
Person(SupportAgent, "Support Agent", "User who handles customer support inquiries and issues.")

System_Ext(ThirdPartyPaymentGateway, "Third-Party Payment Gateway", "Processes tokenized payments securely.")
ThirdPartyPaymentGateway_tech = "Secure REST endpoints"
System_Ext(ThirdPartyShippingAPIs, "Third-Party Shipping APIs", "Handles shipping and fulfillment operations.")
ThirdPartyShippingAPIs_tech = "Secure REST endpoints"

System_Boundary(OnlineBookstorePlatform, "Online Bookstore Platform") {
    Container(AWSAPIGateway, "AWS API Gateway", "AWS API Gateway", "Routes validated REST/gRPC traffic across internal trust boundaries.")
    Container(WebFrontend, "Web Frontend", "AWS CloudFront / Web Frontend", "Delivers global content and user interface performance via CloudFront.")
    Container(BackendMicroservices, "Backend Microservices", "REST/gRPC", "Processes business logic, transactional data, and integrations.")
    Container(RecommendationsEngine, "Recommendations Engine", "Microservices", "Provides integrated book recommendations.")
    ContainerDb(PostgreSQLDatabase, "PostgreSQL Database", "PostgreSQL", "Stores persistent relational data with AES-256 encryption.")
    ContainerDb(RedisCache, "Redis Cache", "Redis", "Provides low-latency caching for transactional and shipping states.")
    Container(AWSSQSMessageQueue, "AWS SQS Message Queue", "AWS SQS", "Asynchronously queues shipping handoffs and event data.")
}

Rel(BookBuyer, AWSAPIGateway, "Browses catalogue, manages cart, and completes checkout", "HTTPS/TLS 1.3 using OAuth 2.0 / OIDC with JWTs")
Rel(AWSAPIGateway, BackendMicroservices, "Routes validated REST/gRPC traffic across internal trust boundaries", "REST/gRPC")
Rel(BackendMicroservices, PostgreSQLDatabase, "Reads and writes transactional data", "Encrypted connections")
Rel(BackendMicroservices, RedisCache, "Reads and writes cached shipping states", "Encrypted connections")
Rel(BackendMicroservices, AWSSQSMessageQueue, "Asynchronously queues shipping handoffs and event data", "AWS SQS")
Rel(BackendMicroservices, ThirdPartyPaymentGateway, "Processes tokenized payments", "Secure REST endpoints")
Rel(BackendMicroservices, ThirdPartyShippingAPIs, "Manages fulfillment and shipping operations", "Secure REST endpoints")

@enduml