@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Consent & Compliance Container container

Container_Boundary(consent_compliance_container, "Consent & Compliance Container") {
    Component(Istio Service Mesh, "Istio Service Mesh", "Istio", "Enforces mTLS and manages secure communication boundaries.")
    Component(OPA Sidecars, "OPA Sidecars", "Open Policy Agent (OPA)", "Enforces fine-grained access control and policy validation.")
    Component(Audit Logger, "Audit Logger", "Container Service", "Captures and formats compliance and audit logs for storage.")
}

Rel(Istio Service Mesh, OPA Sidecars, "Routes requests for policy validation via mTLS", "mTLS")
Rel(OPA Sidecars, Audit Logger, "Triggers immutable logging for authorized actions", "Internal")

@enduml