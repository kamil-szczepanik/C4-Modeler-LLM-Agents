@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient Portal Container (PWA) container

Container_Boundary("Patient Portal Container (PWA)", "Patient Portal Container (PWA)") {
    Component("Offline Storage Manager", "Offline Storage Manager", "IndexedDB with Web Crypto API", "Secures cached local health data and consent states using PIN or biometric-derived keys.")
    Component("Telehealth Interface", "Telehealth Interface", "Progressive Web App (PWA) / HTTPS", "Provides video consultations and user access for patients across the EU and US.")
    Component("AI Symptom Checker Client", "AI Symptom Checker Client", "HTTPS / OAuth2/OIDC", "Sends symptom checker inputs to external AI services with logged model versions.")
}

Rel("Telehealth Interface", "Offline Storage Manager", "Reads and writes encrypted local health data and consent states")
Rel("Telehealth Interface", "AI Symptom Checker Client", "Submits patient symptom inputs for processing")
@enduml