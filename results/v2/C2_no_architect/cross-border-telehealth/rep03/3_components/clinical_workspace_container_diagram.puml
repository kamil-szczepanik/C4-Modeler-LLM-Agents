@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Clinical Workspace Container container

Container_Boundary(clinical_workspace_container, "Clinical Workspace Container") {
    Component(Web_Interface_Video_Module, "Web Interface & Video Module", "GKE container web interface and LiveKit WebRTC SFU with UDP-optimized ingress", "Manages secure video consultations and real-time communication for clinicians.")
    Component(EPrescription_Controller, "E-Prescription Controller", "GKE container microservice", "Handles the creation and routing of e-prescriptions.")
    Component(AI_Symptom_Checker_Client, "AI Symptom Checker Client", "gRPC/REST over mTLS client", "Requests AI symptom-checker inferences from Vertex AI.")
}

System(Consent_Compliance_Container, "Consent & Compliance Container", "Microservice with WORM BigQuery")
System_Ext(Vertex_AI, "Vertex AI", "External AI inference system")
System_Ext(Google_Cloud_Pub_Sub, "Google Cloud Pub/Sub", "Regional event bus with dead-letter queues")
System_Ext(Local_Pharmacies, "Local Pharmacies", "External systems supporting HL7 FHIR and national EU standards")

Rel(Web_Interface_Video_Module, EPrescription_Controller, "Invokes e-prescription workflows")
Rel(EPrescription_Controller, Consent_Compliance_Container, "Enforces granular consent and immutable audit logging", "mTLS / Istio / OAuth2")
Rel(AI_Symptom_Checker_Client, Vertex_AI, "Requests AI symptom-checker inferences", "gRPC/REST over mTLS")
Rel(EPrescription_Controller, Google_Cloud_Pub_Sub, "Publishes async e-prescription events with regional message encryption", "Pub/Sub")
Rel(EPrescription_Controller, Local_Pharmacies, "Routes e-prescriptions using REST APIs with HL7 FHIR (US) and national e-prescription standards (EU)", "REST")

@enduml