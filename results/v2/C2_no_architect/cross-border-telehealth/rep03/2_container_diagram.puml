@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients (EU/US)", "End-users accessing care via a PWA container.")
Person(Clinicians, "Licensed Clinicians", "Healthcare providers using the Clinical Workspace container.")
Person(Admins, "Platform Administrators / Compliance Officers", "Users managing audits, credentials, and compliance.")

System_Ext(VertexAI, "Vertex AI", "External system providing AI symptom-checker recommendations.")
System_Ext(Pharmacies, "Local Pharmacies", "External regional systems receiving e-prescriptions.")

System_Boundary(TelehealthSystem, "Cross-Border Telehealth Platform") {
    Container(PWA, "Patient Portal Container (PWA)", "PWA container with regional Redis for sync", "Edge interface supporting offline resilience and async workflows.")
    Container(ClinicalWorkspace, "Clinical Workspace Container", "Web interface with LiveKit WebRTC SFU", "Interface managing video consultations and e-prescription routing.")
    Container(ConsentCompliance, "Consent & Compliance Container", "Microservice with Istio service mesh and WORM BigQuery", "Microservice enforcing granular consent and immutable AI audit logging.")
}

Rel(Patients, PWA, "Accesses telehealth platform and symptom checker", "HTTPS, WebRTC, OAuth2/OIDC via Identity-Aware Proxy (IAP)")
Rel(Clinicians, ClinicalWorkspace, "Manages video consultations and e-prescriptions", "HTTPS, WebRTC, OAuth2/OIDC via Identity-Aware Proxy (IAP)")
Rel(Admins, ConsentCompliance, "Manages audits, credentials, and compliance", "HTTPS, OAuth2 token validation at API Gateway")
Rel(PWA, ConsentCompliance, "Validates consent and logs activities", "mTLS inside GKE via Istio and OAuth2")
Rel(ClinicalWorkspace, ConsentCompliance, "Enforces granular consent and immutable audit logging", "mTLS inside GKE via Istio and OAuth2")
Rel(ClinicalWorkspace, VertexAI, "Requests AI symptom-checker inferences", "gRPC/REST over mTLS")
Rel(ClinicalWorkspace, Pharmacies, "Routes e-prescriptions", "REST APIs using HL7 FHIR (US) and national e-prescription standards (EU)")

@enduml