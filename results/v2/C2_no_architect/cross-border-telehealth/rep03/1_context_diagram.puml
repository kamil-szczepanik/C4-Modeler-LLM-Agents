@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_EU_and_US, "Patients (EU and US)", "Patients seeking video consultations, e-prescriptions, and AI symptom checking.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Clinicians conducting video consultations and issuing e-prescriptions.")
System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and US while strictly enforcing regional data residency and healthcare regulations.")
System_Ext(Local_Pharmacies, "Local Pharmacies", "Pharmacies receiving e-prescriptions via national standards (EU) and HL7 FHIR (US).")
System_Ext(Vertex_AI, "Vertex AI", "AI service used by the AI Symptom Checker.")

Rel(Patients_EU_and_US, Cross_Border_Telehealth_Platform, "Accesses video consultations, e-prescriptions, and AI symptom checker", "TLS 1.3 / mTLS")
Rel(Licensed_Clinicians, Cross_Border_Telehealth_Platform, "Conducts video consultations and manages e-prescriptions", "TLS 1.3 / mTLS")
Rel(Cross_Border_Telehealth_Platform, Local_Pharmacies, "Sends e-prescriptions", "Secure REST APIs (EU standards / HL7 FHIR US)")
Rel(Cross_Border_Telehealth_Platform, Vertex_AI, "Performs AI inference via LLM Security Gateway", "Secure API")
@enduml