@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "Patients in the EU and US seeking secure video consultations and symptom checking over low-bandwidth connections.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Medical professionals conducting consultations and issuing e-prescriptions.")
Person(Support_Staff, "Support Staff", "Personnel managing platform operations with JIT privileged access.")
Person(Compliance_Legal_Officers, "Compliance/Legal Officers", "Officers ensuring adherence to GDPR, HIPAA, and EU MDR regulations.")

System_Ext(Local_Pharmacy_Networks, "Local Pharmacy Networks", "External pharmacy systems receiving e-prescriptions.")
System_Ext(National_Health_Authorities, "National Health Authorities", "External regulatory and health authority systems.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides secure video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and US while ensuring strict regional data residency and regulatory compliance.")

Rel(Patients, Cross_Border_Telehealth_Platform, "Video consultations via WebRTC (SRTP/DTLS) with dynamic codec adaptation below 300 kbit/s", "WebRTC")
Rel(Licensed_Clinicians, Cross_Border_Telehealth_Platform, "E-prescriptions sent via national standards (EU) and HL7 FHIR (US) over mTLS APIs", "mTLS")
Rel(Support_Staff, Cross_Border_Telehealth_Platform, "Just-In-Time (JIT) privileged access governed by break-glass controls", "OAuth 2.0 / OIDC")

@enduml