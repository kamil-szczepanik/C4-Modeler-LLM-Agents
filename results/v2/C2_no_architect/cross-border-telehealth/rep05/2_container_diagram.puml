@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "Patients in the EU and US seeking secure video consultations and symptom checking over low-bandwidth connections.")
Person(LicensedClinicians, "Licensed Clinicians", "Medical professionals conducting consultations and issuing e-prescriptions.")
Person(SupportStaff, "Support Staff", "Personnel managing platform operations with JIT privileged access.")
Person(ComplianceLegalOfficers, "Compliance/Legal Officers", "Officers ensuring adherence to GDPR, HIPAA, and EU MDR regulations.")
Person(PharmacyPartners, "Pharmacy Partners", "Partners fulfilling e-prescriptions.")
Person(SystemAdministratorsMLEngineers, "System Administrators/ML Engineers", "Administrators and engineers managing platform infrastructure and machine learning models.")

System_Ext(LocalPharmacyNetworks, "Local Pharmacy Networks", "External pharmacy systems receiving e-prescriptions.")
System_Ext(NationalHealthAuthorities, "National Health Authorities", "External regulatory and health authority systems.")

System_Boundary(CrossBorderTelehealthPlatform, "Cross-Border Telehealth Platform") {
    Container(MultiregionWebMobileClients, "Multi-region Web/Mobile Clients", "Web / Mobile", "Client applications providing access for users across multiple regions.")
    Container(EdgeRoutingWebRTCSFUContainers, "Edge Routing & WebRTC SFU Containers", "WebRTC SFU / TLS 1.3", "Containers handling edge routing and WebRTC selective forwarding for video consultations.")
    Container(APIGateway, "API Gateway", "Istio Service Mesh (mTLS)", "Gateway handling routing and security for regional microservices.")
    Container(EPrescriptionRoutingContainer, "E-Prescription Routing Container", "GCP Pub/Sub / Cryptographic Digital Signatures", "Container routing e-prescriptions to national health authorities and pharmacy networks.")
    Container(AISymptomCheckerContainer, "AI Symptom Checker Container", "AI/ML Runtime", "Container providing AI-driven symptom analysis.")
    Container(ConsentManagementService, "Consent Management Service", "OAuth 2.0 / OIDC", "Service managing user consent and regulatory compliance.")
}

Rel(Patients, MultiregionWebMobileClients, "Interacts with the platform for video consultations and symptom checking", "HTTPS / WebRTC")
Rel(LicensedClinicians, MultiregionWebMobileClients, "Conducts consultations and issues e-prescriptions", "HTTPS")
Rel(SupportStaff, MultiregionWebMobileClients, "Manages platform operations", "HTTPS")
Rel(ComplianceLegalOfficers, MultiregionWebMobileClients, "Reviews compliance and audit logs", "HTTPS")
Rel(PharmacyPartners, MultiregionWebMobileClients, "Accesses prescription information", "HTTPS")
Rel(SystemAdministratorsMLEngineers, MultiregionWebMobileClients, "Manages system infrastructure and ML models", "HTTPS")

Rel(MultiregionWebMobileClients, EdgeRoutingWebRTCSFUContainers, "Connects for video streaming and consultations", "WebRTC / TLS 1.3")
Rel(EdgeRoutingWebRTCSFUContainers, APIGateway, "Forwards requests to backend microservices", "mTLS (Service Mesh)")
Rel(APIGateway, EPrescriptionRoutingContainer, "Routes e-prescription data", "mTLS")
Rel(APIGateway, AISymptomCheckerContainer, "Sends requests for symptom analysis", "mTLS")
Rel(APIGateway, ConsentManagementService, "Validates user consent and authentication", "OAuth 2.0 / OIDC")

Rel(EPrescriptionRoutingContainer, NationalHealthAuthorities, "Sends e-prescriptions securely via regional Pub/Sub queues", "Regional Pub/Sub / Cryptographic Signatures")
Rel(EPrescriptionRoutingContainer, LocalPharmacyNetworks, "Dispatches e-prescriptions to pharmacy networks", "Regional Pub/Sub / Cryptographic Signatures")
Rel(AISymptomCheckerContainer, MultiregionWebMobileClients, "Returns symptom check results", "mTLS")

@enduml