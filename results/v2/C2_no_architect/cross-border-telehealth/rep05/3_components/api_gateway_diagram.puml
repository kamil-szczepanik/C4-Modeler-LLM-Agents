@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway_boundary, "API Gateway") {
    Component(Regional_Istio_Ingress_Gateways, "Regional Istio Ingress Gateways", "Istio Ingress with SPIFFE/SPIRE", "Enforces strict data residency boundaries, geo-aware routing, circuit breaking, and mTLS in europe-west3 and us-central1.")
    Component(Edge_Routing_WebRTC_SFU_Containers, "Edge Routing & WebRTC SFU Containers", "WebRTC SFU / TLS 1.3", "Handles edge routing and video containers for secure consultations.")
    Component(Multi_region_Web_Mobile_Clients, "Multi-region Web/Mobile Clients", "Web / Mobile Clients", "End users including patients and licensed clinicians accessing the platform.")
    Component(Consent_Management_Service, "Consent Management Service", "OAuth 2.0 / OIDC", "Manages authentication, authorization, and consent.")
    Component(AI_Symptom_Checker_Container, "AI Symptom Checker Container", "AI/ML Runtime", "Processes AI-driven symptom checking requests with model version headers.")
    Component(E_Prescription_Routing_Container, "E-Prescription Routing Container", "GCP Pub/Sub & Cryptographic Digital Signatures", "Routes e-prescriptions securely via GCP Pub/Sub.")
}

Rel(Multi_region_Web_Mobile_Clients, Regional_Istio_Ingress_Gateways, "HTTPS, WRTC/TLS 1.3", "HTTPS, WRTC/TLS 1.3")
Rel(Regional_Istio_Ingress_Gateways, Consent_Management_Service, "OAuth 2.0 / OIDC", "OAuth 2.0 / OIDC")
Rel(Regional_Istio_Ingress_Gateways, AI_Symptom_Checker_Container, "mTLS with model version headers and request signing", "mTLS")
Rel(Regional_Istio_Ingress_Gateways, E_Prescription_Routing_Container, "mTLS via GCP Pub/Sub", "mTLS via GCP Pub/Sub")

@enduml