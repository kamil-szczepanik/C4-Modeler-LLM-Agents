@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Symptom Checker Container container

Container_Boundary(ai_symptom_checker_container, "AI Symptom Checker Container") {
    Component(Symptom_Analysis_API_Handler, "Symptom Analysis API Handler", "Python, FastAPI", "Receives and validates incoming symptom analysis requests from the API Gateway.")
    Component(ML_Inference_Engine, "ML Inference Engine", "Containerized ML Runtime, TensorFlow/PyTorch", "Processes patient symptoms to provide preliminary triage and recommendations.")
    Component(Session_State_Manager, "Session State Manager", "Regional Redis Cache Client", "Manages session state and ensures offline resilience using AES-256 encryption.")
    Component(Audit_Logger, "Audit Logger", "Fluentbit, GCP BigQuery Client", "Streams immutable audit logs and feedback securely into GCP BigQuery.")
}

Rel(Symptom_Analysis_API_Handler, ML_Inference_Engine, "Passes sanitized symptom data for evaluation", "Internal gRPC")
Rel(ML_Inference_Engine, Session_State_Manager, "Reads and writes session state data", "AES-256")
Rel(ML_Inference_Engine, Audit_Logger, "Streams execution logs and feedback", "Secure GCP VPC")

@enduml