@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(edge_routing_and_webrtc_sfu_containers, "Edge Routing & WebRTC SFU Containers") {
    Component(Envoy Edge Proxy, "Envoy Edge Proxy", "Envoy", "Handles geo-IP validation, adaptive bitrate control, and token-based authentication with regional claims.")
    Component(WebRTC SFU Media Forwarder, "WebRTC SFU Media Forwarder", "Mediasoup/Jitsi", "Manages real-time video streaming, signaling, and media forwarding for consultations over unstable connections.")
}

Rel(Envoy Edge Proxy, WebRTC SFU Media Forwarder, "Routes validated signaling and media traffic", "WebRTC, DTLS-SRTP, TLS 1.3")

@enduml