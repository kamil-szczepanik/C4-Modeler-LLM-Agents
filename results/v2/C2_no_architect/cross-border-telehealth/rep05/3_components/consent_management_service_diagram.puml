@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Consent Management Service container

Container_Boundary(consent_management_service, "Consent Management Service") {
    Component(Consent_Controller, "Consent Controller", "Istio Service Mesh / REST", "Enforces granular data-sharing consents and handles incoming API requests.")
    Component(Compliance_Engine, "Compliance Engine", "Python / Go", "Enforces regional compliance for GDPR and HIPAA requirements.")
    Component(Token_Validator, "Token Validator", "OAuth 2.0 / OIDC / JWT", "Validates short-lived (<60s) cryptographically signed tokens for instant consent revocation.")
    Component(Audit_Logger, "Audit Logger", "Encrypted gRPC", "Streams immutable audit logs and consent history to Cloud Storage WORM.")
}

Rel(Consent_Controller, Token_Validator, "Validates user authentication and token exchange", "mTLS / OAuth 2.0 / OIDC")
Rel(Consent_Controller, Compliance_Engine, "Checks regional compliance rules", "")
Rel(Compliance_Engine, Audit_Logger, "Streams immutable audit logs and consent history", "Encrypted gRPC")

@enduml