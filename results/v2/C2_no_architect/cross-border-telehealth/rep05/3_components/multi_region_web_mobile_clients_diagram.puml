@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Multi-region Web/Mobile Clients container

Container_Boundary(multi_region_web_mobile_clients, "Multi-region Web/Mobile Clients") {
    Component(web_and_mobile_applications, "Web and Mobile applications", "React / React Native with OAuth 2.0 PKCE, Android Keystore, iOS Secure Enclave, WebAuthn, TLS 1.3", "Serves as the primary user interface for patients, clinicians, and support staff, delivering secure video consultations, e-prescriptions, and AI symptom checking.")
}

System_Ext(edge_routing_webrtc_sfu_containers, "Edge Routing & WebRTC SFU Containers", "Handles edge routing and WebRTC Selective Forwarding Unit for video streams.")
System_Ext(ai_symptom_checker_container, "AI Symptom Checker Container", "Provides AI-driven symptom checking and urgency recommendations.")

Rel(web_and_mobile_applications, edge_routing_webrtc_sfu_containers, "Streams video and consultations", "WebRTC with TLS 1.3")
Rel(ai_symptom_checker_container, web_and_mobile_applications, "Returns urgency recommendations", "mTLS")

@enduml