@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the E-Prescription Routing Container container

Container_Boundary(e_prescription_routing_container, "E-Prescription Routing Container") {
    Component(Stateless Routing Workers, "Stateless Routing Workers", "GCP GKE / Horizontal Pod Autoscaling (HPA)", "Processes and dispatches digitally signed e-prescriptions with autoscaling based on queue depth.")
    Component(Messaging and Queue Manager, "Messaging and Queue Manager", "GCP Pub/Sub & DLQs", "Handles asynchronous queuing, retries, and dead-letter queue management for unstable legacy endpoints.")
    Component(Security and Key Manager, "Security and Key Manager", "GCP Cloud KMS & Cloud HSM", "Manages customer-managed encryption (CMEK) and hardware-backed signing keys for data protection and non-repudiation.")
    Component(Telemetry and Monitoring, "Telemetry and Monitoring", "OpenTelemetry & Prometheus", "Delivers distributed tracing and fine-grained metrics for queue lag and circuit breaker monitoring.")
}

Rel(Stateless Routing Workers, Messaging and Queue Manager, "Queues and dispatches payloads with cryptographic digital signatures", "GCP Pub/Sub / Cryptographic Digital Signatures")
Rel(Stateless Routing Workers, Security and Key Manager, "Manages CMEK encryption and clinician signing keys", "Internal GCP API")
Rel(Stateless Routing Workers, Telemetry and Monitoring, "Reports traces and fine-grained metrics", "OpenTelemetry & Prometheus")

@enduml