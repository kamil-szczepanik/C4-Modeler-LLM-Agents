@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "Patients in the EU and US using the platform for video consultations, e-prescriptions, and the AI symptom checker.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Licensed medical professionals providing video consultations and managing prescriptions.")
Person(Platform_Administrators, "Platform Administrators", "Administrators managing the platform operations and configurations.")
Person(Compliance_Auditors, "Compliance Auditors", "Auditors reviewing system compliance and WORM audit logs.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "A cross-border telehealth platform providing video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and US.")

System_Ext(External_Pharmacies, "External Pharmacies", "External pharmacies receiving e-prescriptions via regional message queues.")
System_Ext(National_Health_Authorities, "National Health Authorities", "National health authorities interacting with the platform via REST APIs.")
System_Ext(WORM_Audit_Logs, "WORM Audit Logs", "Write Once Read Many storage for immutable audit logs accessed by auditors.")

Rel(Patients, Cross_Border_Telehealth_Platform, "Accesses video consultations, e-prescriptions, and AI symptom checker via Web/Mobile apps", "HTTPS, TLS 1.3")
Rel(Licensed_Clinicians, Cross_Border_Telehealth_Platform, "Manages consultations and prescriptions via Web UI", "mTLS, OAuth2/OIDC, MFA")
Rel(Platform_Administrators, Cross_Border_Telehealth_Platform, "Manages platform infrastructure and operations", "OAuth2/OIDC, ABAC")
Rel(Compliance_Auditors, WORM_Audit_Logs, "Reads immutable audit logs via read-only encrypted tunnels with explicit consent verification", "Encrypted Tunnels, Explicit Consent verification")
Rel(Cross_Border_Telehealth_Platform, External_Pharmacies, "Delivers asynchronous e-prescriptions via regional message queues", "GCP Pub/Sub, mTLS, payload signatures")
Rel(Cross_Border_Telehealth_Platform, National_Health_Authorities, "Interoperates with health authorities for regulatory standards", "REST APIs, Circuit Breaker, mTLS, HL7 FHIR / EU national standards")

@enduml