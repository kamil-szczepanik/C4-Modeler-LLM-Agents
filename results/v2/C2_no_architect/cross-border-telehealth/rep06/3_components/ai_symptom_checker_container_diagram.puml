@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Symptom Checker Container container

Container_Boundary(ai_symptom_checker_container, "AI Symptom Checker Container") {
    Component(Symptom_Assessment_API_Handler, "Symptom Assessment API Handler", "Python, FastAPI", "Receives incoming symptom checking requests via Istio mTLS and validates input payloads.")
    Component(AI_Inference_Engine, "AI Inference Engine", "TensorRT, PyTorch, Regional GKE", "Executes region-locked, immutable AI model weights to generate diagnoses and confidence scores.")
    Component(Audit_and_Telemetry_Emitter, "Audit and Telemetry Emitter", "OpenTelemetry, Region-bound log sinks", "Captures and exports structured audit logs including inputs, model versions, and confidence scores for EU MDR compliance.")
}

Rel(Symptom_Assessment_API_Handler, AI_Inference_Engine, "Passes validated clinical inputs to the inference pipeline")
Rel(AI_Inference_Engine, Audit_and_Telemetry_Emitter, "Sends model version, inference outputs, and confidence scores for compliance logging")

@enduml