@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway Container container

Container_Boundary(api_gateway_container, "API Gateway Container") {
    Component(Istio_Service_Mesh_Enforcer, "Istio Service Mesh Enforcer", "Istio Service Mesh", "Enforces mTLS, regional data residency, traffic routing, circuit breaking, and liveness probes at the perimeter.")
    Component(Consent_Management_and_ABAC_Module, "Consent Management and ABAC Module", "Attribute-Based Access Control (ABAC)", "Manages user consent scopes and regional data residency constraints.")
    Component(OAuth2_OIDC_JWT_Authenticator, "OAuth2/OIDC JWT Authenticator", "OAuth2/OIDC with DPoP/MTLS", "Secures user authentication and token binding.")
    Component(Token_Blacklist_Validator, "Token Blacklist Validator", "Localized Redis Token Blacklist Cache", "Validates token blacklists and consent states with sub-second latency.")
}

Rel(Istio_Service_Mesh_Enforcer, Consent_Management_and_ABAC_Module, "Evaluates attributes and consent policies for incoming requests")
Rel(Istio_Service_Mesh_Enforcer, OAuth2_OIDC_JWT_Authenticator, "Validates JSON Web Tokens and secures authentication")
Rel(OAuth2_OIDC_JWT_Authenticator, Token_Blacklist_Validator, "Checks token revocation status against the localized cache")

@enduml