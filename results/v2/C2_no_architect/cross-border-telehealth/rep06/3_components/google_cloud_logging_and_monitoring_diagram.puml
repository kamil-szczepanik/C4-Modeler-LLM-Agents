@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(regional_gke_clusters, "Regional GKE Clusters", "Regional container workloads running in europe-west3 and us-central1.")
System_Ext(ai_symptom_checker_container, "AI Symptom Checker Container", "AI container generating structured logs and telemetry.")

Container_Boundary(google_cloud_logging_and_monitoring, "Google Cloud Logging and Monitoring") {
    Component(log_sink_and_audit_trail_manager, "Log Sink and Audit Trail Manager", "Google Cloud Logging, CMEK, WORM storage", "Enforces region-bound log sinks, CMEK encryption, and WORM immutability for regional audit trails.")
    Component(cloud_dlp_sanitizer, "Cloud DLP Sanitizer", "Cloud DLP API, Pub/Sub", "Asynchronously scans and sanitizes log streams to prevent PHI/PII leakage from operational metrics.")
    Component(telemetry_collector, "Telemetry Collector", "OpenTelemetry, Google Cloud Monitoring", "Receives immutable structured logs and OpenTelemetry traces from microservices and AI components.")
}

Rel(regional_gke_clusters, cloud_dlp_sanitizer, "Exports sanitized operational metrics and region-bound audit trails", "Cloud DLP, Pub/Sub, mTLS")
Rel(ai_symptom_checker_container, telemetry_collector, "Sends immutable structured logs and OpenTelemetry traces", "mTLS, OpenTelemetry")

@enduml