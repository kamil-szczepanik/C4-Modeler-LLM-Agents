@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the WebRTC SFU Media Servers container

Container_Boundary(web_rtc_sfu_media_servers, "WebRTC SFU Media Servers") {
    Component(sfu_media_controller, "SFU Media Controller", "WebRTC SFU Container", "Manages real-time video consultations, adaptive bitrate streaming, and audio-first fallback for unstable connections.")
    Component(turn_stun_credential_handler, "TURN/STUN Credential Handler", "JWT Authentication Module", "Validates short-lived TURN/STUN credentials issued by the API Gateway.")
    Component(telemetry_exporter, "Telemetry Exporter", "OpenTelemetry & WebRTC RTCStats", "Streams real-time telemetry and metrics to Google Cloud Monitoring while stripping PII.")
}

Rel(sfu_media_controller, turn_stun_credential_handler, "Verifies session access", "JWT")
Rel(sfu_media_controller, telemetry_exporter, "Streams real-time telemetry", "OpenTelemetry, WebRTC RTCStats")

@startuml