@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(gcp_cloud_armor_and_cloud_cdn, "GCP Cloud Armor and Cloud CDN") {
    Component(Cloud Armor Edge WAF, "Cloud Armor Edge WAF", "GCP Cloud Armor", "Provides edge WAF inspection, OWASP Top 10 rules, adaptive DDoS protection, and rate-limiting.")
    Component(Cloud CDN Cache, "Cloud CDN Cache", "Google Cloud CDN", "Caches static frontend assets and WebRTC client shell to support low-bandwidth users, strictly excluding PHI.")
}

System_Ext(API Gateway Container, "API Gateway Container", "Istio API Gateway Container")
System_Ext(Google Cloud Logging and Monitoring, "Google Cloud Logging and Monitoring", "Google Cloud Monitoring")

Rel(Cloud Armor Edge WAF, API Gateway Container, "Routes inspected traffic", "HTTPS, Istio mTLS")
Rel(Cloud Armor Edge WAF, Google Cloud Logging and Monitoring, "Streams security telemetry, WAF logs, and cache metrics", "OpenTelemetry, Google Cloud Logging API")

@enduml