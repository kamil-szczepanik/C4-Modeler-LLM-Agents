@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "Patients in the EU and US using the platform for video consultations, e-prescriptions, and the AI symptom checker.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Licensed medical professionals providing video consultations and managing prescriptions.")
Person(Platform_Administrators, "Platform Administrators", "Administrators managing the platform operations and configurations.")
Person(Compliance_Auditors, "Compliance Auditors", "Auditors reviewing system compliance and WORM audit logs.")

System_Ext(External_Pharmacies, "External Pharmacies", "External pharmacies receiving e-prescriptions via national standards and HL7 FHIR.")
System_Ext(National_Health_Authorities, "National Health Authorities", "National health authorities interacting with the platform via REST APIs.")
System_Ext(WORM_Audit_Logs, "WORM Audit Logs", "Write Once Read Many storage for immutable audit logs.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(Regional_GKE_Clusters, "Regional GKE Clusters", "Google Kubernetes Engine (GKE), Binary Authorization,europe-west3, us-central1", "Regional container orchestration ensuring data residency and isolation.")
    Container(API_Gateway_Container, "API Gateway Container", "Istio Service Mesh, Consent Management, ABAC, OAuth2/OIDC JWT", "Routes traffic and enforces consent, zero-trust networking, and authentication.")
    Container(WebRTC_SFU_Media_Servers, "WebRTC SFU Media Servers", "WebRTC", "Handles real-time video consultations for patients and clinicians.")
    Container(AI_Symptom_Checker_Container, "AI Symptom Checker Container", "Signed execution manifests, OpenTelemetry", "Provides AI symptom checking with traceable logs and signed execution.")
    Container(GCP_Cloud_Armor_and_Cloud_CDN, "GCP Cloud Armor and Cloud CDN", "GCP Cloud Armor, Cloud CDN", "Provides edge security, WAF inspection, and asset caching.")
    Container(Google_Cloud_Logging_and_Monitoring, "Google Cloud Logging and Monitoring", "Google Cloud Logging, Monitoring, OpenTelemetry", "Centralized regional telemetry and region-bound log sinks.")
}

Rel(Patients, GCP_Cloud_Armor_and_Cloud_CDN, "Accesses video consultations, e-prescriptions, and AI symptom checker via edge security", "HTTPS (TLS 1.3), WebRTC")
Rel(Licensed_Clinicians, GCP_Cloud_Armor_and_Cloud_CDN, "Interacts with the platform for consultations and prescriptions", "HTTPS (TLS 1.3), WebRTC")
Rel(Platform_Administrators, API_Gateway_Container, "Manages platform configuration and operations", "OAuth2/OIDC, ABAC")
Rel(Compliance_Auditors, WORM_Audit_Logs, "Reviews immutable audit logs", "Encrypted Tunnels")
Rel(GCP_Cloud_Armor_and_Cloud_CDN, API_Gateway_Container, "Routes inspected and cached traffic to the API Gateway", "HTTPS, Istio mTLS")
Rel(API_Gateway_Container, WebRTC_SFU_Media_Servers, "Connects authenticated users for video consultations", "WebRTC, Istio mTLS")
Rel(API_Gateway_Container, AI_Symptom_Checker_Container, "Routes symptom checking requests", "Istio mTLS")
Rel(AI_Symptom_Checker_Container, Google_Cloud_Logging_and_Monitoring, "Logs inputs and model versions using OpenTelemetry", "OpenTelemetry, Region-bound log sinks")
Rel(Regional_GKE_Clusters, External_Pharmacies, "Sends e-prescriptions via national standards and HL7 FHIR", "EU e-prescription standards, HL7 FHIR")
Rel(Regional_GKE_Clusters, National_Health_Authorities, "Interoperates with health authorities", "REST APIs, mTLS")
@enduml