@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Clinician Dashboard & Handoff Container container

Person(LicensedClinicians, "Licensed Clinicians", "Primary users who manage patient consultations, review AI symptom checker outputs, and dispatch e-prescriptions.")

Container_Boundary(ClinicianDashboardHandoffContainer_Boundary, "Clinician Dashboard & Handoff Container") {
    Component(RegionalGKEClusters, "Regional GKE Clusters", "Google Kubernetes Engine (europe-west3, us-central1)", "Orchestrates regional container deployments ensuring cross-border regulatory compliance.")
}

Container(PatientEngagementNotificationGatewayContainer, "Patient Engagement & Notification Gateway Container", "Container Service", "Handles patient communications and notifications.")
Container(LocalizationRegulatoryService, "Localization & Regulatory Service", "Microservice", "Verifies regional consent and data access for GDPR and HIPAA compliance.")
Container(AISymptomCheckerContainer, "AI Symptom Checker Container", "Container Service", "Provides AI urgency recommendations and clinical inputs.")
System_Ext(ExternalPharmacies, "External Pharmacies", "External EU & US Pharmacy Systems", "Receives national e-prescriptions.")

Rel(LicensedClinicians, RegionalGKEClusters, "Uses", "HTTPS")
Rel(RegionalGKEClusters, PatientEngagementNotificationGatewayContainer, "Dispatches e-prescriptions", "HTTPS/TLS")
Rel(RegionalGKEClusters, AISymptomCheckerContainer, "Retrieves AI urgency recommendations and inputs", "gRPC/mTLS")
Rel(RegionalGKEClusters, LocalizationRegulatoryService, "Verifies regional consent and data access", "HTTPS/mTLS")
Rel(RegionalGKEClusters, ExternalPharmacies, "Submits national e-prescriptions", "HTTPS/TLS")

@enduml