@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Symptom Checker Container container

Container_Boundary(ai_symptom_checker_container, "AI Symptom Checker Container") {
    Component(triage_controller, "Triage Controller", "gRPC / HTTPS", "Invokes triage functions via HTTPS/TLS and gRPC with JWT authentication.")
    Component(session_manager, "Session Manager", "Redis", "Persists ephemeral session state via encrypted connections.")
    Component(audit_logger, "Audit Logger", "gRPC", "Writes audit logs and inputs to Cloud Logging via gRPC.")
}

Rel(triage_controller, session_manager, "Persists ephemeral session state via encrypted connections", "Encrypted Connection")
Rel(triage_controller, audit_logger, "Sends audit logs and inputs", "gRPC")

@enduml