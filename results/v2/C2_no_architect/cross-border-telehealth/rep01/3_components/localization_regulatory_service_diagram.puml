@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Localization & Regulatory Service container

Container_Boundary(localization_regulatory_service, "Localization & Regulatory Service") {
    Component(Regional_Data_Residency_Enforcer, "Regional Data Residency Enforcer", "Google Cloud Platform (GCP), VPC Service Controls", "Enforces strict regional data isolation for EU and US patients to guarantee GDPR and HIPAA compliance.")
    Component(Granular_Consent_Manager, "Granular Consent Manager", "Kubernetes, Istio", "Manages patient consent and authorization workflows within the zero-trust service mesh.")
    Component(Audit_Traceability_Worker, "Audit Traceability Worker", "Cloud Pub/Sub, Cloud Run", "Handles asynchronous processing and compliance exports for audit logging.")
    Component(Crypto_Shredding_Manager, "Crypto-Shredding Manager", "Cloud KMS", "Performs envelope encryption and per-patient crypto-shredding.")
}

Rel(Regional_Data_Residency_Enforcer, Granular_Consent_Manager, "Validates consent against regional compliance rules", "mTLS via Istio")
Rel(Granular_Consent_Manager, Crypto_Shredding_Manager, "Manages encryption keys and patient data protection", "Cloud KMS")
Rel(Audit_Traceability_Worker, Audit_Traceability_Worker, "Publishes and processes compliance export events", "Cloud Pub/Sub & Cloud Run")

@enduml