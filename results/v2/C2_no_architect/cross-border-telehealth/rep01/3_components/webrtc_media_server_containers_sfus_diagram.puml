@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the WebRTC Media Server Containers (SFUs) container

Container_Boundary(sfu_container, "WebRTC Media Server Containers (SFUs)") {
    Component(sfu_core, "SFU Core Engine", "Jitsi/Mediasoup SFU", "Handles video streams, simulcast, and dynamic bitrate scaling for unstable connections (<300 kbit/s).")
    Component(security_handler, "Security & Encryption Handler", "DTLS-SRTP & JWT", "Secures media stream encryption and session authorization.")
    Component(telemetry_exporter, "Telemetry Exporter", "Prometheus & Grafana", "Provides real-time observability of WebRTC transport metrics.")
    Component(mesh_proxy, "Mesh Proxy", "Istio Service Mesh", "Enforces regional mTLS for inter-pod communication.")
}

Rel(sfu_core, security_handler, "Secures media streams using", "DTLS-SRTP")
Rel(sfu_core, telemetry_exporter, "Reports transport metrics to", "Prometheus")
Rel(sfu_core, mesh_proxy, "Communicates with internal microservices via", "mTLS")

@enduml