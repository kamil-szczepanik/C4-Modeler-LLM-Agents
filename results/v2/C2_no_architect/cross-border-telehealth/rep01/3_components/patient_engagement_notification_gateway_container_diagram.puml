@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(patient_engagement_notification_gateway_container, "Patient Engagement & Notification Gateway Container") {
    Component(Notification_Dispatch_Controller, "Notification & Dispatch Controller", "Google Kubernetes Engine (GKE)", "Core service handling notifications, e-prescription dispatches, and consent enforcement across regional deployments.")
    Component(Async_Queue_Retry_Manager, "Async Queue & Retry Manager", "GCP Pub/Sub", "Manages asynchronous message dispatches, retries, and failed message isolation via Dead Letter Queues (DLQs) for unstable connections.")
    Component(Security_Encryption_Manager, "Security & Encryption Manager", "GCP Cloud KMS & Secret Manager", "Provides regional customer-managed encryption keys and secure API credential storage to enforce GDPR and HIPAA data residency mandates.")
}

Rel(Notification_Dispatch_Controller, Async_Queue_Retry_Manager, "Publishes async delivery status feedback events and queues pending messages")
Rel(Notification_Dispatch_Controller, Security_Encryption_Manager, "Retrieves cryptographic keys and API credentials for secure, consent-validated message delivery")
@enduml