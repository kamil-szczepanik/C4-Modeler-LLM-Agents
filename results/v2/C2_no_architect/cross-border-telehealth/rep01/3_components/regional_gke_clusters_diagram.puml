@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Regional GKE Clusters container

Container_Boundary(regional_gke_clusters, "Regional GKE Clusters") {
    Component(IstioServiceMeshEnvoyGateways, "Istio Service Mesh & Envoy Gateways", "Istio, Envoy", "Enforces mandatory mTLS, authorization policies for all intra-cluster traffic, and optimizes ingress for unstable rural connections.")
    Component(LocalizationRegulatoryService, "Localization & Regulatory Service", "Microservice, SQL/TLS, CMEK", "Manages consent data and ensures adherence to regional data boundaries and regulatory compliance.")
    Component(WebRTCMediaServerContainersSFUs, "WebRTC Media Server Containers (SFUs)", "WebRTC Containers", "Handles video consultations and real-time media streaming for patients and clinicians.")
    Component(AISymptomCheckerContainer, "AI Symptom Checker Container", "Containerized AI Service", "Provides automated symptom checking functionality and generates MDR traceability logs.")
    Component(FluentBitGoogleCloudLogging, "Fluent Bit & Google Cloud Logging", "Fluent Bit, Google Cloud Logging", "Performs edge log-forwarding and PII stripping for regulatory compliance.")
}

Rel(IstioServiceMeshEnvoyGateways, WebRTCMediaServerContainersSFUs, "Routes secure ingress and enforces mTLS")
Rel(IstioServiceMeshEnvoyGateways, AISymptomCheckerContainer, "Routes traffic and enforces authorization policies")
Rel(IstioServiceMeshEnvoyGateways, LocalizationRegulatoryService, "Routes requests and enforces security policies")
Rel(WebRTCMediaServerContainersSFUs, FluentBitGoogleCloudLogging, "Forwards logs for monitoring and PII stripping")
Rel(AISymptomCheckerContainer, FluentBitGoogleCloudLogging, "Forwards AI audit logs for traceability")

@enduml