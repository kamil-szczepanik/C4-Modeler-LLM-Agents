@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients_EU_US, "Patients (EU & US)", "End-users managing consent, video calls, and AI triage.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Medical professionals conducting consultations and issuing e-prescriptions.")
Person(Compliance_QA_Officers, "Compliance & QA Officers", "Regulators monitoring EU MDR and HIPAA compliance.")

System_Ext(External_Pharmacies_EU_US, "External Pharmacies (EU & US)", "External systems receiving e-prescription fulfillments.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(Regional_GKE_Clusters, "Regional GKE Clusters", "Google Cloud Platform (europe-west3, us-central1), Kubernetes, Istio", "Regional cloud infrastructure enforcing strict data residency and container orchestration with mTLS.")
    Container(Localization_Regulatory_Service, "Localization & Regulatory Service", "Container, SQL/TLS, GCP VPC Service Controls, Cloud KMS", "Manages regional data residency, consent management, and regulatory compliance (GDPR/HIPAA).")
    Container(WebRTC_Media_Server_Containers_SFUs, "WebRTC Media Server Containers (SFUs)", "Jitsi/Mediasoup SFU, WebRTC", "Provides low-bandwidth WebRTC video streaming for video consultations.")
    Container(AI_Symptom_Checker_Container, "AI Symptom Checker Container", "Container, gRPC", "Provides AI symptom checking and sends audit logs to Cloud Logging.")
    Container(Clinician_Dashboard_Handoff_Container, "Clinician Dashboard & Handoff Container", "Container, HTTPS/TLS", "Provides clinician interface and handles e-prescription dispatch via the notification gateway.")
    Container(Patient_Engagement_Notification_Gateway_Container, "Patient Engagement & Notification Gateway Container", "Container, HTTPS/TLS", "Handles patient notifications and e-prescription dispatches.")
}

Rel(Patients_EU_US, WebRTC_Media_Server_Containers_SFUs, "Participates in video consultations", "WebRTC/mTLS")
Rel(AI_Symptom_Checker_Container, Regional_GKE_Clusters, "Sends audit logs", "gRPC")
Rel(Localization_Regulatory_Service, Regional_GKE_Clusters, "Manages consent data in regional databases", "SQL/TLS")
Rel(Clinician_Dashboard_Handoff_Container, Patient_Engagement_Notification_Gateway_Container, "Dispatches e-prescriptions", "HTTPS/TLS")

@enduml