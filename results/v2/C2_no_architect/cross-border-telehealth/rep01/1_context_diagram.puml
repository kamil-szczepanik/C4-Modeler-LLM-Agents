@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_EU_US, "Patients (EU & US)", "End-users managing consent, video calls, and AI triage.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Medical professionals conducting consultations and issuing e-prescriptions.")
Person(Compliance_QA_Officers, "Compliance & QA Officers", "Regulators monitoring EU MDR and HIPAA compliance.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "A cross-border telehealth platform providing video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and US, ensuring strict data residency, regulatory compliance, and low-bandwidth availability.")

System_Ext(Pharmacies_EU_US, "Pharmacies (EU & US)", "External systems receiving e-prescription fulfillments.")

Rel(Patients_EU_US, Cross_Border_Telehealth_Platform, "Manages consent, conducts video calls, and uses AI triage", "HTTPS / WebRTC")
Rel(Licensed_Clinicians, Cross_Border_Telehealth_Platform, "Conducts consultations and issues e-prescriptions", "HTTPS / WebRTC")
Rel(Compliance_QA_Officers, Cross_Border_Telehealth_Platform, "Monitors EU MDR and HIPAA compliance", "HTTPS")
Rel(Cross_Border_Telehealth_Platform, Pharmacies_EU_US, "Sends e-prescription fulfillments", "mTLS / OAuth 2.0 / HL7 FHIR")

@enduml