@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the WORM Cloud Storage container

Container_Boundary(worm_cloud_storage, "WORM Cloud Storage") {
    Component(cloud_pub_sub_buffer, "Cloud Pub/Sub buffer", "Google Cloud Pub/Sub", "Buffers incoming log streams before persisting them to immutable storage.")
    Component(worm_storage_bucket, "WORM Storage Bucket", "Google Cloud Storage (WORM) with Bucket Lock", "Provides hardware-enforced immutability in compliance mode for audit logs.")
}

Rel(cloud_pub_sub_buffer, worm_storage_bucket, "Flushes buffered audit logs to immutable storage", "HTTPS")

@enduml