@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Regional GKE Clusters container

System_Ext(GoogleSecretManager, "Google Secret Manager", "External secret storage")
System_Ext(ArgoCDSystem, "ArgoCD", "GitOps deployment system")
System_Ext(Pods, "Pods", "Kubernetes workload pods")

Container_Boundary(RegionalGKEClusters, "Regional GKE Clusters") {
    Component(IstioServiceMesh, "Istio Service Mesh", "Istio, Envoy, Calico", "Enforces zero-trust microsegmentation, Layer 3-7 security, and mTLS with SPIFFE IDs.")
    Component(ArgoCD, "ArgoCD", "ArgoCD, Binary Authorization, Cosign", "Drives GitOps-driven deployments and ensures container integrity.")
    Component(FalcoDaemonSet, "Falco DaemonSet", "Falco", "Provides real-time runtime security and container anomaly detection.")
    Component(CSISecretsStoreDriver, "CSI Secrets Store Driver", "Google Secret Manager CSI Driver", "Injects secrets into memory securely via gRPC/TLS.")
}

Rel(RegionalGKEClusters, GoogleSecretManager, "Injects secrets into memory via CSI Driver using gRPC/TLS", "gRPC/TLS")
Rel(RegionalGKEClusters, ArgoCDSystem, "Pulls declarative configurations via HTTPS/GitOps", "HTTPS/GitOps")
Rel(IstioServiceMesh, Pods, "Enforces zero-trust microsegmentation and mTLS with SPIFFE IDs", "mTLS")
@enduml