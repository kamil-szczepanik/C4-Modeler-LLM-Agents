@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Symptom Checker Container container

Container_Boundary(ai_symptom_checker_container, "AI Symptom Checker Container") {
    Component(Symptom_Analysis_Controller, "Symptom Analysis Controller", "Python, TensorFlow", "Orchestrates incoming AI symptom analysis requests and model inference.")
    Component(Audit_Logger, "Audit Logger", "Python, gRPC", "Sends immutable audit logs to WORM Cloud Storage.")
    Component(Async_Submission_Handler, "Async Submission Handler", "Python, Google Cloud Pub/Sub", "Handles failed asynchronous store-and-forward submissions via Dead Letter Queue.")
}

Rel(Symptom_Analysis_Controller, Audit_Logger, "Sends immutable audit logs", "gRPC/HTTPS")
Rel(Symptom_Analysis_Controller, Async_Submission_Handler, "Routes failed asynchronous submissions", "Encrypted TLS 1.3")

@enduml