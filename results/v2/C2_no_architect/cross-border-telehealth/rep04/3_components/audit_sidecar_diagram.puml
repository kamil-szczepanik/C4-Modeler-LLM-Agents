@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(audit_sidecar, "Audit Sidecar") {
    Component(Audit Log Collector, "Audit Log Collector", "Python / Go", "Receives clinical inputs and operational logs from the AI Symptom Checker container over secured localhost.")
    Component(Cryptographic Chaining Engine, "Cryptographic Chaining Engine", "Python Cryptography Library", "Applies cryptographic hashing to chain audit logs together sequentially for tamper-proof traceability.")
    Component(Storage Writer, "Storage Writer", "Google Cloud Storage Client Library", "Writes encrypted, hash-chained audit logs to regional WORM Cloud Storage via HTTPS using Cloud KMS for envelope encryption.")
}

Rel(Audit Log Collector, Cryptographic Chaining Engine, "Passes collected logs for cryptographic hashing and sequencing.")
Rel(Cryptographic Chaining Engine, Storage Writer, "Transfers hash-chained audit logs for secure persistence.")
@enduml