@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(webrtc_sfu, "WebRTC SFU") {
    Component(MediasoupSFUCore, "Mediasoup SFU Core", "Node.js / C++ Mediasoup library", "Handles selective forwarding unit (SFU) media routing, streaming, and real-time media mixing for video consultations.")
    Component(coturnNATTraversal, "coturn NAT Traversal", "coturn STUN/TURN server", "Provides NAT traversal and relay services for WebRTC media streams, supporting unstable rural connections.")
    Component(JWTAuthValidator, "JWT Auth Validator", "Node.js / WebRTC Signaling Handler", "Validates short-lived JSON Web Tokens (JWTs) issued by the API Gateway to authorize session access.")
    Component(PrometheusTelemetrySidecar, "Prometheus Telemetry Sidecar", "Prometheus Sidecar exporter", "Exports real-time WebRTC metrics and telemetry data to Grafana dashboards.")
}

Rel(JWTAuthValidator, MediasoupSFUCore, "Authorizes session access", "")
Rel(MediasoupSFUCore, coturnNATTraversal, "Relays media streams via", "")
Rel(PrometheusTelemetrySidecar, MediasoupSFUCore, "Monitors and scrapes metrics from", "")

@enduml