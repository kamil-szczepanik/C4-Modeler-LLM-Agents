@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_EU_US, "Patients (EU & US)", "Patients located in the EU and US seeking secure video consultations, e-prescriptions, and symptom checking.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Healthcare professionals conducting secure video consultations and issuing e-prescriptions.")
System_Ext(External_Pharmacies_EU_US, "External Pharmacies (EU/US)", "Pharmacies receiving encrypted FHIR and national e-prescription standards.")
Person(Compliance_Regulatory_Officers, "Compliance & Regulatory Officers", "Officers overseeing regulatory compliance under GDPR, HIPAA, and EU MDR.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides secure video consultations, e-prescriptions, and an AI symptom checker for patients across the EU and the US with strict regional data residency and regulatory compliance under GDPR, HIPAA, and EU MDR.")

System_Boundary(Cross_Border_Telehealth_Platform_boundary, "Cross-Border Telehealth Platform") {
    Container(Patient_Consent_Portal, "Patient Consent Portal", "HTTPS/TLS 1.3 (BeyondCorp Enterprise)", "Portal for managing patient consent using Zero Trust MFA.")
    Container(AI_Symptom_Checker_Container, "AI Symptom Checker Container", "gRPC/TLS 1.3", "Containerized AI symptom checker with cryptographically signed version logging.")
    Container(Video_Gateway_Containers, "Video Gateway Containers", "WebRTC (TLS 1.3, adaptive <300 kbit/s bandwidth degradation)", "Containers handling real-time video communication optimized for low-bandwidth connections.")
}

Rel(Patients_EU_US, Video_Gateway_Containers, "Connects for secure video consultations via WebRTC", "WebRTC (TLS 1.3, adaptive <300 kbit/s bandwidth degradation)")
Rel(Patients_EU_US, Patient_Consent_Portal, "Authenticates and manages consent via Zero Trust MFA", "HTTPS/TLS 1.3 (BeyondCorp Enterprise)")
Rel(Licensed_Clinicians, Patient_Consent_Portal, "Authenticates and manages consent via Zero Trust MFA", "HTTPS/TLS 1.3 (BeyondCorp Enterprise)")
Rel(AI_Symptom_Checker_Container, Cloud_Storage, "Logs cryptographically signed version data", "gRPC/TLS 1.3")
Rel(Cross_Border_Telehealth_Platform, External_Pharmacies_EU_US, "Transmits prescriptions securely", "mTLS and encrypted FHIR/national e-prescription standards")

@enduml