@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients_EU_US, "Patients (EU & US)", "Patients located in the EU and US seeking secure video consultations, e-prescriptions, and symptom checking.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Healthcare professionals conducting secure video consultations and issuing e-prescriptions.")
Person(Compliance_Officers, "Compliance Officers", "Officers overseeing regulatory compliance under GDPR and HIPAA.")
Person(Local_Pharmacy_Partners, "Local Pharmacy Partners", "Local pharmacy partners fulfilling regional prescriptions.")

System_Ext(External_Pharmacies_EU_US, "External Pharmacies (EU/US)", "External pharmacies receiving encrypted prescriptions via HL7 FHIR and national standards.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(API_Gateway, "API Gateway", "Istio Service Mesh / Envoy", "Manages incoming traffic, API routing, and security enforcement.")
    Container(Frontend_Container, "Frontend Container", "Web / Distroless Container", "Delivers user interfaces for patients and clinicians.")
    Container(WebRTC_SFU, "WebRTC SFU", "Mediasoup / coturn", "Handles real-time video consultations and media streaming.")
    Container(AI_Symptom_Checker_Container, "AI Symptom Checker Container", "Python / TensorFlow / Distroless", "Provides AI-driven symptom analysis with audit sidecar.")
    Container(Audit_Sidecar, "Audit Sidecar", "Sidecar Container", "Captures immutable audit logs for AI recommendations and transactions.")
    Container(Regional_GKE_Clusters, "Regional GKE Clusters", "Google Kubernetes Engine (GKE)", "Hosts regional workloads across europe-west3 and us-central1 ensuring data residency.")
    Container(Cloud_WAF, "Cloud WAF", "Google Cloud WAF", "Protects web applications against threats and attacks.")
    ContainerDb(WORM_Cloud_Storage, "WORM Cloud Storage", "Google Cloud Storage (WORM)", "Stores immutable audit logs securely.")
}

Rel(Patients_EU_US, API_Gateway, "Sends HTTPS requests and establishes WebRTC connections", "HTTPS/TLS 1.3, WebRTC (UDP/TCP)")
Rel(Licensed_Clinicians, API_Gateway, "Sends HTTPS requests and establishes WebRTC connections", "HTTPS/TLS 1.3, WebRTC (UDP/TCP)")
Rel(API_Gateway, Regional_GKE_Clusters, "Routes traffic to regional microservices via service mesh", "Istio Service Mesh (mTLS with SPIFFE IDs)")
Rel(AI_Symptom_Checker_Container, WORM_Cloud_Storage, "Sends immutable audit logs", "gRPC/HTTPS")
Rel(Regional_GKE_Clusters, External_Pharmacies_EU_US, "Transmits electronic prescriptions", "HL7 FHIR (US) and national standards (EU)")

@enduml