@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title System Container diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "Rural and urban patients accessing video consultations, e-prescriptions, and the AI symptom checker.")
Person(Clinicians, "Licensed Clinicians", "Medical professionals conducting consultations and issuing e-prescriptions.")
Person(Admins, "Platform Administrators", "Administrators managing the platform using FIDO2/WebAuthn hardware tokens.")
Person(Auditors, "Regional Health Authorities/Auditors", "External authorities auditing system compliance and immutable audit logs.")

System_Ext(Pharmacies, "Local Pharmacy Networks", "EU national standards and US HL7 FHIR endpoints for fulfilling e-prescriptions.")

System_Boundary(platform, "Cross-Border Telehealth Platform") {
    Container(Gateways, "Regional API Gateways", "HTTPS/TLS 1.3, mTLS", "GCP-hosted gateways handling ingress traffic for the EU and US regions.")
    Container(VideoService, "Video Consultation Service", "WebRTC, Cloud CDN/Media CDN", "Handles real-time video consultations with adaptive bitrate streaming.")
    Container(AIService, "AI Symptom Checker Service", "GCP", "Provides AI-driven symptom analysis for patients.")
    Container(ConsentEngine, "Consent Management Engine", "Scoped OAuth 2.0 / OpenID Connect", "Decentralized consent management enforcing regional data policies.")
    Container(AuditPipeline, "Immutable Audit Logging Pipeline", "GCP Cloud Logging, OpenTelemetry", "Maintains immutable audit trails for compliance and traceability.")
}

Rel(Patients, Gateways, "Accesses video consultations, AI symptom checker, and e-prescriptions", "HTTPS/TLS 1.3 and mTLS")
Rel(Clinicians, Gateways, "Conducts consultations and manages patient interactions", "HTTPS/TLS 1.3 and mTLS")
Rel(Gateways, Pharmacies, "Sends e-prescriptions to regional pharmacy endpoints", "REST/HL7 FHIR (US) and national e-prescription APIs (EU)")
Rel(VideoService, Patients, "Streams video consultations with adaptive bitrate", "WebRTC (<300 kbit/s connections)")
Rel(AuditPipeline, Auditors, "Provides compliance and audit data", "Dedicated read-only API gateways")

@enduml