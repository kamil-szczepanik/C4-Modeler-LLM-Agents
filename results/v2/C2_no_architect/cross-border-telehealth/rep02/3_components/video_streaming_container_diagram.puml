@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Video Streaming Container container

Container_Boundary(video_streaming_container, "Video Streaming Container") {
    Component(WebRTC_Media_Server, "WebRTC Media Server", "WebRTC over DTLS-SRTP, GCP GKE", "Streams real-time video with adaptive bitrate and end-to-end encryption supporting unstable connections.")
    Component(Session_Consent_Verifier, "Session Consent Verifier", "gRPC, Istio", "Verifies active session consent with the Consent & Identity Management Container.")
    Component(Telemetry_and_Monitoring_Agent, "Telemetry and Monitoring Agent", "Prometheus, Grafana", "Tracks telemetry for Quality of Experience (QoE) metrics and clinical reliability.")
}

Rel(WebRTC_Media_Server, Session_Consent_Verifier, "Verifies active session consent", "gRPC")
Rel(WebRTC_Media_Server, Telemetry_and_Monitoring_Agent, "Sends telemetry and QoE metrics", "")

@enduml