@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("AI Symptom Checker Container", "AI Symptom Checker Container") {
    Component(Triage Controller, "Triage Controller", "Python, FastAPI, Server-Sent Events/SSE", "Handles incoming sanitized requests from the API Gateway and streams triage results over unstable rural internet connections.")
    Component(AI Inference Engine, "AI Inference Engine", "Confidential VMs with AMD SEV-SNP, GCP Binary Authorization", "Executes symptom checking models in memory securely, protecting patient health data and verifying model weights cryptographically.")
    Component(Audit Logger, "Audit Logger", "HTTPS TLS 1.3, GCP Cloud Storage WORM APIs", "Persists immutable audit logs and versioned inputs to regional WORM storage buckets for compliance.")
}

Rel(Triage Controller, AI Inference Engine, "Invokes inference on sanitized inputs", "In-Memory Confidential Computing")
Rel(AI Inference Engine, Audit Logger, "Persists immutable audit logs and versioned inputs", "HTTPS TLS 1.3")
@enduml