@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway Container container

Container_Boundary(api_gateway_container, "API Gateway Container") {
    Component(Request_Router, "Request Router", "GCP GKE, Istio, WAF", "Inspects incoming HTTPS/WSS traffic, applies Web Application Firewall rules, and routes requests to appropriate backend containers.")
    Component(Policy_Enforcement_Engine, "Policy Enforcement Engine", "Open Policy Agent (OPA)", "Evaluates dynamic data residency, access control, and purpose-based consent rules at runtime.")
    Component(Security_TLS_Terminator, "Security & TLS Terminator", "Istio Service Mesh, TLS 1.3", "Terminates external TLS 1.3 connections and establishes secure mTLS tunnels for internal service-to-service communication.")
}

Rel(Request_Router, Policy_Enforcement_Engine, "Validates incoming request compliance", "OPA evaluation")
Rel(Request_Router, Security_TLS_Terminator, "Offloads cryptographic operations and establishes internal mTLS", "Istio Service Mesh (mTLS)")

@enduml