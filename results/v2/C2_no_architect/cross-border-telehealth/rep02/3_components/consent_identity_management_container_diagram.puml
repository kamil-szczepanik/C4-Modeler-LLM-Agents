@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Consent & Identity Management Container container

Container_Boundary("Consent & Identity Management Container", "Consent & Identity Management Container") {
    Component("Identity Verification & OAuth 2.0 Engine", "Identity Verification & OAuth 2.0 Engine", "OAuth 2.0 with FAPI Profiles & JWTs", "Handles secure authentication, issues FAPI-compliant JWTs, and verifies user identity for patients, clinicians, and administrators.")
    Component("Fine-Grained Consent Manager", "Fine-Grained Consent Manager", "Open Policy Agent (OPA) & Istio Service Mesh", "Manages fine-grained data sharing consent claims, enforcing zero-trust access policies across regional boundaries.")
    Component("Audit Log Emitter", "Audit Log Emitter", "Apache Kafka", "Asynchronously streams immutable, encrypted audit logs and consent events to Regional WORM Storage Buckets.")
}

System_Ext("Regional WORM Storage Buckets", "Regional WORM Storage Buckets", "Stores immutable, encrypted audit logs asynchronously.")

Rel("Identity Verification & OAuth 2.0 Engine", "Fine-Grained Consent Manager", "Validates user tokens and evaluates identity claims")
Rel("Fine-Grained Consent Manager", "Audit Log Emitter", "Publishes consent and access decisions")
Rel("Audit Log Emitter", "Regional WORM Storage Buckets", "Streams immutable audit logs asynchronously")

@enduml