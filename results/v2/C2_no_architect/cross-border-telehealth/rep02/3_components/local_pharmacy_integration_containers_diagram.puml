@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(local_pharmacy_integration_containers, "Local Pharmacy Integration Containers") {
    Component(Prescription Router, "Prescription Router", "Istio Service Mesh and Envoy", "Routes e-prescription requests to local pharmacy networks using mTLS.")
    Component(FHIR Adapter, "FHIR Adapter", "HL7 FHIR (US) and national EU standards", "Transforms payloads to meet local pharmacy network transmission standards.")
    Component(Event Publisher, "Event Publisher", "GCP Pub/Sub Client", "Publishes state-change events and manages retries via dead-letter queues.")
    Component(Audit Logger, "Audit Logger", "GCP Cloud Storage WORM Client", "Immutably logs transmission payloads and ACK/NACK responses.")
}

Rel(Prescription Router, FHIR Adapter, "Transforms e-prescription payloads")
Rel(FHIR Adapter, Event Publisher, "Publishes state-change events")
Rel(Event Publisher, Audit Logger, "Triggers immutable logging of transmission payloads")

@enduml