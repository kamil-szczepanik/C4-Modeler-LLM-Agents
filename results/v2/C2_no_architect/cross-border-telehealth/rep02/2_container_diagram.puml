@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "Patients accessing video consultations, e-prescriptions, and the AI symptom checker via Web/Mobile Clients.")
Person(LicensedClinicians, "Licensed Clinicians", "Medical professionals conducting consultations and issuing e-prescriptions via Web/Mobile Clients.")
System_Ext(LocalPharmacyNetworks, "Local Pharmacy Networks", "Local pharmacy networks integrating via HL7 FHIR and national EU e-prescription standards.")

System_Boundary(CrossBorderTelehealthPlatform, "Cross-Border Telehealth Platform") {
    Container(APIGatewayContainer, "API Gateway Container", "GCP GKE, OPA (Open Policy Agent), Istio", "Handles ingress traffic and dynamic, policy-based access control with OPA.")
    Container(ConsentIdentityManagementContainer, "Consent & Identity Management Container", "GCP GKE, Istio", "Manages consent and identity enforcement for EU and US patients.")
    Container(VideoStreamingContainer, "Video Streaming Container", "WebRTC, Prometheus/Grafana, GCP GKE", "Provides real-time video consultations supporting adaptive bitrate for degraded modes.")
    Container(AISymptomCheckerContainer, "AI Symptom Checker Container", "GCP GKE, Cloud KMS", "Provides AI-driven symptom analysis with cryptographically signed audit logging.")
    Container(LocalPharmacyIntegrationContainers, "Local Pharmacy Integration Containers", "GCP GKE, HL7 FHIR", "Integrates with local pharmacy networks using national EU e-prescription standards and HL7 FHIR.")
    ContainerDb(RegionalWORMStorageBuckets, "Regional WORM Storage Buckets", "GCP Cloud Storage WORM", "Stores cryptographically signed audit logs and AI outputs ensuring EU MDR traceability.")
}

Rel(Patients, APIGatewayContainer, "Accesses consultations, e-prescriptions, and AI symptom checker", "HTTPS/WSS")
Rel(LicensedClinicians, APIGatewayContainer, "Manages patient interactions and clinical workflows", "HTTPS/WSS")
Rel(APIGatewayContainer, ConsentIdentityManagementContainer, "Validates consent and identity via service mesh", "Istio Service Mesh (mTLS)")
Rel(APIGatewayContainer, VideoStreamingContainer, "Routes video consultation requests", "Istio Service Mesh (mTLS)")
Rel(APIGatewayContainer, AISymptomCheckerContainer, "Routes requests to the AI symptom checker", "Istio Service Mesh (mTLS)")
Rel(APIGatewayContainer, LocalPharmacyIntegrationContainers, "Routes e-prescription requests", "Istio Service Mesh (mTLS)")
Rel(VideoStreamingContainer, Patients, "Streams video consultations with adaptive bitrate", "WebRTC")
Rel(VideoStreamingContainer, LicensedClinicians, "Streams video consultations with adaptive bitrate", "WebRTC")
Rel(AISymptomCheckerContainer, RegionalWORMStorageBuckets, "Persists AI outputs and audit trails", "HTTPS (TLS 1.3)")
Rel(LocalPharmacyIntegrationContainers, LocalPharmacyNetworks, "Sends e-prescriptions to pharmacy networks", "HL7 FHIR and national EU e-prescription standards")

@enduml