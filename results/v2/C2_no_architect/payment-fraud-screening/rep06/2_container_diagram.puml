@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Real-Time Payment Fraud Screening Platform

Person(FraudAnalyst, "Fraud Analyst", "Internal user reviewing suspicious transactions via case management UI.")
Person(RiskManager, "Risk Manager / Data Scientist", "Internal user updating scoring models and rules with zero downtime.")
Person(MerchantSupport, "Merchant Support", "Internal user accessing read-only audit logs for dispute resolution.")

System_Ext(MerchantPaymentGatewaySystem, "Merchant / Payment Gateway System", "External system submitting payment authorization requests via REST API.")

System_Boundary(RealTimePaymentFraudScreeningPlatform, "Real-Time Payment Fraud Screening Platform") {
    Container(ScoringEngineContainer, "Scoring Engine Container", "AWS ECS on Fargate, gRPC, HTTPS, TLS 1.3", "Processes card-not-present payment authorizations in real-time, executing fraud scoring within the CDE private subnet.")
    Container(CaseManagementContainer, "Case Management Container", "AWS ECS on Fargate, REST, mTLS", "Provides analyst case management isolated in an external subnet.")
}

Rel(MerchantPaymentGatewaySystem, ScoringEngineContainer, "Submits payment authorization requests", "gRPC/HTTPS with TLS 1.3")
Rel(FraudAnalyst, CaseManagementContainer, "Reviews flagged transactions", "HTTPS (OAuth 2.0 / OIDC JWT)")
Rel(CaseManagementContainer, ScoringEngineContainer, "Queries and manages case details", "internal REST/mTLS APIs")

@enduml