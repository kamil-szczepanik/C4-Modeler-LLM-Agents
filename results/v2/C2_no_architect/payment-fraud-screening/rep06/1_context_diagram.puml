@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Real-Time Payment Fraud Screening Platform

Person(FraudAnalyst, "Fraud Analyst", "Internal user reviewing suspicious transactions via case management UI.")
Person(RiskManagerDataScientist, "Risk Manager / Data Scientist", "Internal user updating scoring models and rules with zero downtime.")
Person(MerchantSupport, "Merchant Support", "Internal user accessing read-only audit logs for dispute resolution.")

System_Ext(MerchantPaymentGatewaySystem, "Merchant / Payment Gateway System", "External system submitting payment authorization requests via REST API.")

System(RealTimePaymentFraudScreeningPlatform, "Real-Time Payment Fraud Screening Platform", "A real-time payment fraud screening platform that evaluates card-not-present payment authorizations within 50 milliseconds, providing automated scoring, case management, and immutable audit logs.")

Rel(MerchantPaymentGatewaySystem, RealTimePaymentFraudScreeningPlatform, "Submits authorization requests", "HTTPS, TLS 1.3, mTLS, API keys")
Rel(FraudAnalyst, RealTimePaymentFraudScreeningPlatform, "Reviews flagged transactions", "HTTPS, OIDC, MFA")
Rel(RiskManagerDataScientist, RealTimePaymentFraudScreeningPlatform, "Deploys updated models and rules with zero downtime", "CI/CD pipelines")
Rel(MerchantSupport, RealTimePaymentFraudScreeningPlatform, "Accesses read-only audit logs for dispute resolution", "HTTPS")

@enduml