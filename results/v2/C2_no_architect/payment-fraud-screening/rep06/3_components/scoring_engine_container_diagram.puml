@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(scoring_engine_container, "Scoring Engine Container") {
    Component(api_ingestion_handler, "API Ingestion Handler", "gRPC / HTTPS with TLS 1.3", "Receives real-time payment authorization requests from payment gateways with sub-50ms P99 latency.")
    Component(real_time_scoring_engine, "Real-Time Scoring Engine", "AWS ECS on Fargate", "Evaluates transactions against fraud detection models and manages cryptographic signing of decisions.")
    Component(audit_compliance_logger, "Audit & Compliance Logger", "AWS SDK / AWS S3 Object Lock", "Stores cryptographically signed decisions and immutable audit logs for 7-year tamper-evident compliance.")
}

Rel(api_ingestion_handler, real_time_scoring_engine, "Forwards payment authorization requests for real-time fraud scoring.", "gRPC")
Rel(real_time_scoring_engine, audit_compliance_logger, "Sends signed decisions and audit logs for WORM storage.", "AWS SDK")

@enduml