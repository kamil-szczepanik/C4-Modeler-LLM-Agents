@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management Container container

Person(FraudAnalyst, "Fraud Analyst", "Reviews flagged transactions via HTTPS (OAuth 2.0 / OIDC JWT).")

Container_Boundary(CaseManagementContainer, "Case Management Container") {
    Component(CaseMgmtCore, "Case Management Container", "Node.js / Express", "Manages user cases, interactions, and orchestration.")
}

Component_Ext(ScoringEngineContainer, "Scoring Engine Container", "AWS ECS on Fargate / internal REST APIs", "Evaluates and scores transactions for fraud.")
Component_Ext(AWSS3ObjectLockBucket, "AWS S3 Object Lock Bucket", "AWS S3 & Glacier", "Stores cryptographically signed audit logs with 7-year tamper-evident retention.")
Component_Ext(AWSKMS, "AWS KMS", "AWS KMS", "Handles cryptographic signing of audit event payloads for non-repudiation.")

Rel(FraudAnalyst, CaseManagementContainer, "Reviews flagged transactions via HTTPS", "OAuth 2.0 / OIDC JWT")
Rel(CaseManagementContainer, ScoringEngineContainer, "Queries and manages case details", "internal REST APIs (mTLS via AWS App Mesh)")
Rel(CaseManagementContainer, AWSS3ObjectLockBucket, "Streams cryptographically signed audit logs", "AWS IAM")
Rel(CaseManagementContainer, AWSKMS, "Signs audit event payloads", "AWS API")

@enduml