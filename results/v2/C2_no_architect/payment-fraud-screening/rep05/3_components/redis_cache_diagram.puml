@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(redis_cache, "Redis Cache") {
    Component(Redis_Master_Node, "Redis Master Node", "Amazon ElastiCache Redis OSS (cache.m6g.large)", "Handles write operations and primary caching for active fallback rulesets with TLS in transit.")
    Component(Redis_Replica_Node, "Redis Replica Node", "Amazon ElastiCache Redis OSS (cache.m6g.large)", "Provides multi-AZ read redundancy to ensure high availability and sub-50ms latency for scoring queries.")
}

Rel(Redis_Master_Node, Redis_Replica_Node, "Replicates fallback ruleset data asynchronously across availability zones")

@enduml