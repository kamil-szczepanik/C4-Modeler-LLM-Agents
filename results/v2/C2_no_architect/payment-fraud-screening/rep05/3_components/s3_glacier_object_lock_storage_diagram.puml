@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the S3 Glacier Object Lock Storage container

Container_Boundary(s3_glacier_object_lock_storage, "S3 Glacier Object Lock Storage") {
    Component(Object_Lock_Manager, "Object Lock Manager", "AWS S3 Glacier Flexible Archive with Object Lock and AWS KMS", "Manages WORM storage, cryptographic signing, and 7-year tamper-evident retention for audit logs.")
    Component(Firehose_Ingestion_Handler, "Firehose Ingestion Handler", "Amazon Kinesis Firehose", "Batches high-frequency logs from the Scoring Engine Container before writing to storage to reduce API costs.")
}

Rel(Firehose_Ingestion_Handler, Object_Lock_Manager, "Writes cryptographically signed audit logs", "TLS 1.3, AWS KMS")

@enduml