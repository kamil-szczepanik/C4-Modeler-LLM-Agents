@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(case_management_container, "Case Management Container") {
    Component(ReviewInterfaceController, "Review Interface Controller", "Node.js / React", "Provides the secure review interface and API backend for fraud analysts and managers to investigate suspicious transactions.")
    Component(AuditLogger, "Audit Logger", "AWS SDK / Python", "Generates and sends immutable audit trails and tamper-evident decision logs to storage.")
    Component(QueueManager, "Queue Manager", "Node.js", "Manages SLA-driven case queues and state synchronization.")
}

Rel(ReviewInterfaceController, QueueManager, "Updates and retrieves case queue data", "")
Rel(ReviewInterfaceController, AuditLogger, "Dispatches review decisions for immutable logging", "")

@enduml