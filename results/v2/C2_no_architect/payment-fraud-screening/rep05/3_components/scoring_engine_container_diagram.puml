@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Scoring Engine Container container

Container_Boundary(scoring_engine_container, "Scoring Engine Container") {
    Component(Scoring Controller, "Scoring Controller", "AWS ECS Fargate / REST API", "Receives real-time scoring requests from the API Gateway via mTLS.")
    Component(Fraud Evaluation Service, "Fraud Evaluation Service", "Python / Core Processing", "Evaluates card-not-present payment authorizations against fraud rules.")
    Component(Fallback Rule Manager, "Fallback Rule Manager", "Python / Redis Client", "Queries cached fallback ruleset during outages via isolated VPC subnet.")
    Component(Audit Logger, "Audit Logger", "AWS KMS / S3 SDK", "Writes cryptographically signed audit logs using AWS KMS envelope encryption.")
}

Rel(Scoring Controller, Fraud Evaluation Service, "Invokes fraud evaluation logic")
Rel(Fraud Evaluation Service, Fallback Rule Manager, "Queries cached fallback rules")
Rel(Fraud Evaluation Service, Audit Logger, "Sends audit logs for secure storage")

@enduml