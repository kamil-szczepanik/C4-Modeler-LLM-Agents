@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Cardholder, "Cardholder", "End customer initiating transactions.")
Person(FraudAnalyst, "Fraud Analyst", "Internal analyst who reviews suspicious payments via the Case Management UI without accessing raw PAN data.")
System_Ext(PaymentGateway, "Payment Gateway", "External client submitting payment authorizations.")
System(RealTimePaymentFraudScreeningPlatform, "Real-Time Payment Fraud Screening Platform", "A real-time payment fraud screening platform that evaluates card-not-present authorizations, manages fraud analyst reviews, and ensures PCI-DSS Level 1 compliance with 7-year tamper-evident auditability.")

Rel(Cardholder, PaymentGateway, "Initiates payment transactions", "HTTPS")
Rel(PaymentGateway, RealTimePaymentFraudScreeningPlatform, "Submits authorization requests via HTTPS", "HTTPS (TLS 1.3)")
Rel(FraudAnalyst, RealTimePaymentFraudScreeningPlatform, "Reviews suspicious payments via Case Management UI", "HTTPS, OIDC/OAuth2, Hardware-backed MFA")

@enduml