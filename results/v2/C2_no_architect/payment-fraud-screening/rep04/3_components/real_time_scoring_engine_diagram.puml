@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Real-Time Scoring Engine", "Real-Time Scoring Engine") {
    Component("Scoring Gateway Controller", "Scoring Gateway Controller", "AWS ECS Fargate, HTTPS/TLS 1.3", "Receives payment authorizations for fraud screening from the Payment Gateway.")
    Component("Fraud Evaluation Processor", "Fraud Evaluation Processor", "AWS ECS Fargate", "Evaluates transactions in real-time under 50 milliseconds.")
    Component("Tokenization Client", "Tokenization Client", "gRPC over mTLS", "Communicates with the Tokenization Proxy to tokenize payment data.")
    Component("Audit Dispatcher", "Audit Dispatcher", "Local IPC / Unix domain sockets", "Sends audit logs and attribution bitmasks to the Audit & Cryptographic Signer Sidecar.")
}

Rel("Scoring Gateway Controller", "Fraud Evaluation Processor", "Passes payment authorization data for evaluation")
Rel("Fraud Evaluation Processor", "Tokenization Client", "Requests tokenization of payment data", "gRPC over mTLS")
Rel("Fraud Evaluation Processor", "Audit Dispatcher", "Sends audit logs and attribution bitmasks", "Local IPC / Unix domain sockets")

@enduml