@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Tokenization Proxy container

Container_Boundary(tokenization_proxy, "Tokenization Proxy") {
    Component(Tokenization_Service, "Tokenization Service", "Go", "Handles low-latency gRPC requests and interfaces with cryptographic backends.")
    Component(Cryptographic_Manager, "Cryptographic Manager", "AWS SDK", "Performs format-preserving cryptographic tokenization via AWS KMS and AWS CloudHSM.")
}

Rel(Tokenization_Service, Cryptographic_Manager, "Invokes format-preserving tokenization", "AWS SDK / TLS")

@enduml