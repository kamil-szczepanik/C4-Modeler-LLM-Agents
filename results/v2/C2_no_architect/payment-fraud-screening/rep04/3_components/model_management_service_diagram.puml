@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Model Management Service container

Container_Boundary(model_management_service, "Model Management Service") {
    Component(Model_Promotion_Controller, "Model Promotion Controller", "AWS ECS Fargate Container / Python Flask", "Enables self-service model promotion and rollback for risk managers.")
    Component(Explainability_Previewer, "Explainability Previewer", "AWS ECS Fargate Container / Python", "Provides explainability previews for fraud scoring models.")
    Component(Performance_Dashboard_API, "Performance Dashboard API", "AWS ECS Fargate Container / AWS CloudWatch integration", "Serves metrics and performance dashboards to risk managers.")
}

System_Ext(Audit_Cryptographic_Signer_Sidecar, "Audit & Cryptographic Signer Sidecar", "AWS ECS Fargate Container")
System_Ext(AWS_S3, "AWS S3", "Object Storage")
System_Ext(AWS_CloudWatch, "AWS CloudWatch", "Metrics and monitoring")

Rel(Model_Promotion_Controller, Audit_Cryptographic_Signer_Sidecar, "Sends model promotion and rollback audit logs", "gRPC/Internal Network")
Rel(Model_Promotion_Controller, AWS_S3, "Stores model artifact storage and version manifests", "HTTPS")
Rel(Explainability_Previewer, AWS_S3, "Retrieves model artifacts for explainability previews", "HTTPS")
Rel(Performance_Dashboard_API, AWS_CloudWatch, "Queries metrics and performance data", "AWS API")

@enduml