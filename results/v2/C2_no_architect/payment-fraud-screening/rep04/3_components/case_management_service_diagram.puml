@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management Service container

Container_Boundary(case_management_service, "Case Management Service") {
    Component(Web_Interface, "Web Interface", "Secure Web Interface", "Provides a secure web UI for fraud analysts and risk managers to review suspicious payment authorizations and manage queues.")
    Component(Authentication_RBAC_Manager, "Authentication & RBAC Manager", "AWS Cognito (OIDC/OAuth2)", "Manages user authentication and role-based access control ensuring PCI-DSS compliant session security.")
    Component(Queue_Manager, "Queue Manager", "Amazon Redis", "Handles low-latency priority queue management using sorted sets without database locks.")
    Component(Audit_Trail_Storage_Manager, "Audit Trail Storage Manager", "Amazon S3 with Object Lock (S3 Glacier Instant Retrieval)", "Secures tamper-evident 7-year audit storage and case history using the AWS SDK.")
    Component(Observability_Agent, "Observability Agent", "AWS X-Ray", "Provides distributed tracing for system observability.")
}

Rel(Web_Interface, Authentication_RBAC_Manager, "Authenticates users via OIDC/OAuth2 over HTTPS.", "HTTPS")
Rel(Web_Interface, Queue_Manager, "Reads and writes priority queue states via TCP.", "TCP")
Rel(Web_Interface, Audit_Trail_Storage_Manager, "Stores audit trails and case history via AWS SDK.", "AWS SDK")
Rel(Web_Interface, Observability_Agent, "Sends distributed tracing data for monitoring.", "HTTPS")

@enduml