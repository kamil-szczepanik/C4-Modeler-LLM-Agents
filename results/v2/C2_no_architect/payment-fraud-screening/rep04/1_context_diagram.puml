@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalystsRiskManagers, "Fraud Analysts & Risk Managers", "Human actors reviewing suspicious payments and managing rules.")
System_Ext(PaymentGatewayShoppers, "Payment Gateway / Shoppers", "External systems and end-users sending transaction authorizations.")
System(RealTimePaymentFraudScreening, "Real-Time Payment Fraud Screening", "Evaluates card-not-present payment authorizations for fraud, providing sub-50ms decisions and case management for analysts with PCI-DSS Level 1 compliance.")

Rel(PaymentGatewayShoppers, RealTimePaymentFraudScreening, "Sends authorization requests", "REST API over TLS 1.3")
Rel(FraudAnalystsRiskManagers, RealTimePaymentFraudScreening, "Accesses case queues and manages rules", "HTTPS with strict RBAC")

@enduml