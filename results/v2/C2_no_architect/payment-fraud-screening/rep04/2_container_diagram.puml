@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Real-Time Payment Fraud Screening

Person(FraudAnalysts, "Fraud Analysts", "Human actors reviewing suspicious payments.")
Person(RiskManagers, "Risk Managers", "Human actors managing risk rules.")
Person(ComplianceOfficers, "Compliance Officers", "Human actors ensuring regulatory compliance.")
Person(ShoppersEndConsumers, "Shoppers/End-Consumers", "End-consumers initiating card-not-present transactions.")

System_Ext(PaymentGatewayShoppers, "Payment Gateway / Shoppers", "External system routing payment authorization requests.")
System_Ext(AmazonS3WORMBucket, "Amazon S3 WORM Bucket", "Stores immutable 7-year audit logs.")

System_Boundary(RealTimePaymentFraudScreening, "Real-Time Payment Fraud Screening") {
    Container(RealTimeScoringEngine, "Real-Time Scoring Engine", "AWS ECS Fargate, ECS Service Connect", "Screens authorizations in real-time with memory-cached models.")
    Container(CaseManagementService, "Case Management Service", "AWS ECS Fargate, AWS Cognito (OIDC/OAuth2)", "Manages queues and cases for suspicious payments.")
    Container(TokenizationProxy, "Tokenization Proxy", "AWS ECS Fargate", "Reduces PCI-DSS scope by tokenizing sensitive data.")
    Container(AuditCryptographicSignerSidecar, "Audit & Cryptographic Signer Sidecar", "AWS ECS Fargate, AWS CloudHSM, AWS KMS", "Ensures 7-year tamper-evident auditability.")
    Container(ModelManagementService, "Model Management Service", "AWS ECS Fargate", "Manages and updates fraud scoring models.")
}

Rel(PaymentGatewayShoppers, RealTimeScoringEngine, "Sends payment authorizations for fraud screening", "HTTPS/TLS 1.3")
Rel(RealTimeScoringEngine, TokenizationProxy, "Tokenizes sensitive payment data", "gRPC")
Rel(RealTimeScoringEngine, AuditCryptographicSignerSidecar, "Sends audit logs for tamper-evident signing", "IPC / Local gRPC")
Rel(FraudAnalysts, CaseManagementService, "Reviews suspicious payments and manages cases", "HTTPS (OIDC/OAuth2 via AWS Cognito)")
Rel(AuditCryptographicSignerSidecar, AmazonS3WORMBucket, "Stores immutable 7-year audit logs", "AWS SDK (HTTPS)")

@enduml