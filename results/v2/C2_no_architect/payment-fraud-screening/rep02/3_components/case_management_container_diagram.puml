@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Case Management Container", "Case Management Container") {
    Component(Case Router, "Case Router", "AWS ECS Fargate / Web Server", "Routes incoming case management traffic and handles HTTP requests.")
    Component(Case Data Handler, "Case Data Handler", "AWS ECS Fargate / Application Logic", "Processes and manages case data read and write operations.")
    Component(Audit Log Emitter, "Audit Log Emitter", "AWS SDK", "Emits signed audit logs to tamper-evident S3 storage.")
}

Rel(Case Router, Case Data Handler, "Forwards traffic and API requests", "Internal")
Rel(Case Data Handler, Audit Log Emitter, "Triggers emission of signed audit logs", "HTTPS")
@enduml