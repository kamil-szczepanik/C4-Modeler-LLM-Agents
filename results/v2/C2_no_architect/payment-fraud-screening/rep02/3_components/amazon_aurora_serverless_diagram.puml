@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon Aurora Serverless container

Container_Ext(scoring_container, "Scoring Container", "AWS ECS Fargate", "Container for real-time fraud scoring.")
Container_Ext(case_mgmt_container, "Case Management Container", "AWS ECS Fargate", "Container for analyst case management tools.")
System_Ext(amazon_cloudwatch, "Amazon CloudWatch", "AWS Service", "Streams audit logs and performance metrics.")
System_Ext(amazon_s3, "Amazon S3 with Object Lock", "AWS Service", "Exports backups and audit trails for long-term retention.")

Container_Boundary(aurora_serverless, "Amazon Aurora Serverless") {
    Component(transaction_context_processor, "Transaction Context Processor", "PostgreSQL Engine / SQL", "Processes queries from the Scoring Container to retrieve transaction context for real-time fraud screening.")
    Component(case_data_repository, "Case Data Repository", "PostgreSQL Engine / SQL", "Reads and writes case data for analysts using case management tools.")
    Component(audit_and_metrics_exporter, "Audit and Metrics Exporter", "CloudWatch and S3 Integration", "Streams audit logs and performance metrics to Amazon CloudWatch and exports backups and audit trails to Amazon S3 with Object Lock.")
}

Rel(scoring_container, transaction_context_processor, "Queries transaction context", "Internal TCP/TLS (Port 5432/3306)")
Rel(case_mgmt_container, case_data_repository, "Reads and writes case data", "Internal TCP/TLS (Port 5432/3306)")
Rel(audit_and_metrics_exporter, amazon_cloudwatch, "Streams audit logs and performance metrics")
Rel(audit_and_metrics_exporter, amazon_s3, "Exports backups and audit trails for long-term retention")

@enduml