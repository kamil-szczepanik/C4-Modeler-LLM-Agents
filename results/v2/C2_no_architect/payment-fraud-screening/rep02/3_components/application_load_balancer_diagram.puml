@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Application Load Balancer container

Container_Boundary(alb_boundary, "Application Load Balancer") {
    Component(AWS_WAF, "AWS WAF", "AWS WAF Managed Rules", "Inspects requests for volumetric and injection attacks using in-line filtering.")
    Component(Path_Based_Routing_Engine, "Path-Based Routing Engine", "AWS ALB Routing Rules", "Routes payment traffic and analyst UI traffic with priority rules and weighted target groups.")
    Component(TLS_Termination, "TLS Termination", "AWS ALB TLS 1.3", "Terminates incoming HTTPS / TLS 1.3 connections from Cardholders and Fraud Operations Analysts.")
}

Rel(AWS_WAF, Path_Based_Routing_Engine, "Forwards inspected requests", "In-line filtering")
Rel(Path_Based_Routing_Engine, Scoring_Container, "Routes payment traffic", "ECS Service Connect / mTLS")
Rel(Path_Based_Routing_Engine, Case_Management_Container, "Routes analyst UI traffic", "Internal TLS")
Rel(Path_Based_Routing_Engine, Amazon_S3_with_Object_Lock, "Streams access logs", "HTTPS / S3 API")
@enduml