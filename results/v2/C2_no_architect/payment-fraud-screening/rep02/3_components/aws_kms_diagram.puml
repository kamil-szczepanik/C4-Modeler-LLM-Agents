@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_kms, "AWS KMS") {
    Component(Key_Management_Service_API, "Key Management Service API", "AWS KMS API", "Provides endpoints for cryptographic operations including envelope encryption and key management.")
