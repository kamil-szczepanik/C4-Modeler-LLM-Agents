@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(s3_object_lock, "Amazon S3 with Object Lock") {
    Component(Object Storage Engine, "Object Storage Engine", "AWS S3 Service", "Stores decision logs and provides tamper-evident storage.")
    Component(Object Lock Manager, "Object Lock Manager", "AWS S3 Compliance Mode", "Enforces 7-year retention and prevents deletion or modification of audit logs.")
}

Rel(Object Storage Engine, Object Lock Manager, "Applies retention policies to stored logs", "")
@enduml