@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(scoring_container, "Scoring Container") {
    Component(Model_Caching_Engine, "Model Caching Engine", "Local Container Memory Caching", "Caches model weights locally to meet strict sub-50ms latency requirements.")
    Component(Fraud_Evaluation_Engine, "Fraud Evaluation Engine", "AWS ECS Fargate Container", "Evaluates card-not-present payment authorizations to detect fraud.")
}

Rel(Fraud_Evaluation_Engine, Model_Caching_Engine, "Retrieves model weights from", "In-memory")

@enduml