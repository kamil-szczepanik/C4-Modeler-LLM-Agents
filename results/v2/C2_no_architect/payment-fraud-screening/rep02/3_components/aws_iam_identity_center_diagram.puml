@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component Diagram for AWS IAM Identity Center

Container_Boundary(aws_iam_identity_center, "AWS IAM Identity Center") {
    Component(Authentication_Manager, "Authentication Manager", "AWS IAM Identity Center / SAML 2.0 / FIDO2", "Handles hardware-backed MFA and federated authentication for analysts, risk managers, team leads, and engineers.")
    Component(SCIM_Provisioning_Engine, "SCIM Provisioning Engine", "SCIM Protocol", "Synchronizes user identities and group memberships from the enterprise identity provider.")
    Component(Access_Control_Role_Mapper, "Access Control & Role Mapper", "AWS IAM / Terraform", "Enforces role-based access control and administrative guardrails via AWS Organizations SCPs.")
}

Rel(Authentication_Manager, SCIM_Provisioning_Engine, "Federates authentication and user synchronization", "SAML 2.0 / SCIM")
Rel(Authentication_Manager, Access_Control_Role_Mapper, "Maps authenticated users to specific AWS roles and permissions")

@enduml