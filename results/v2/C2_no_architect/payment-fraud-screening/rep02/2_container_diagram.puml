@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Real-Time Payment Fraud Screening

Person(Cardholder_End_Customer, "Cardholder / End Customer", "Sends payment authorizations for e-commerce transactions.")
Person(Fraud_Operations_Analyst, "Fraud Operations Analyst", "Accesses Case Management UI to review and manage fraud cases.")
Person(Risk_Manager_Quant, "Risk Manager / Quant", "Updates fraud models in the screening engine.")
Person(Fraud_Ops_Team_Lead_Administrator, "Fraud Ops Team Lead / Administrator", "Manages administrative settings and system operations.")

System_Boundary(real_time_payment_fraud_screening, "Real-Time Payment Fraud Screening") {
    Container(Application_Load_Balancer, "Application Load Balancer", "AWS ALB", "Routes incoming traffic to internal services and containers.")
    Container(Scoring_Container, "Scoring Container", "AWS ECS Fargate", "Performs real-time fraud scoring on card-not-present payment authorizations.")
    Container(Case_Management_Container, "Case Management Container", "AWS ECS Fargate", "Provides interface and backend for fraud analysts and operations teams.")
    ContainerDb(Amazon_Aurora_Serverless, "Amazon Aurora Serverless", "Amazon Aurora Serverless", "Relational database scaling dynamically for case management and transaction data.")
    Container(Amazon_S3_with_Object_Lock, "Amazon S3 with Object Lock", "Amazon S3, Object Lock", "Tamper-evident 7-year audit log storage satisfying regulatory compliance.")
    Container(AWS_KMS, "AWS KMS", "AWS KMS", "Customer-managed keys securing decision logs and data at rest.")
    Container(AWS_IAM_Identity_Center, "AWS IAM Identity Center", "AWS IAM Identity Center", "Provides hardware-backed MFA authentication for analysts and risk managers.")
}

Rel(Cardholder_End_Customer, Application_Load_Balancer, "Submits payment authorizations", "HTTPS/TLS 1.3")
Rel(Application_Load_Balancer, Scoring_Container, "Routes traffic to scoring container", "ECS service connect / mTLS")
Rel(Scoring_Container, Amazon_Aurora_Serverless, "Queries for transaction context", "Internal TCP/TLS")
Rel(Scoring_Container, Amazon_S3_with_Object_Lock, "Streams decision logs", "AWS SDK / AWS KMS")
Rel(Fraud_Operations_Analyst, AWS_IAM_Identity_Center, "Authenticates via MFA", "HTTPS")
Rel(Fraud_Operations_Analyst, Application_Load_Balancer, "Accesses Case Management Container", "HTTPS")
Rel(Application_Load_Balancer, Case_Management_Container, "Routes case management traffic", "Internal TLS")
Rel(Case_Management_Container, Amazon_Aurora_Serverless, "Reads and writes case data", "Internal TCP/TLS")

@enduml