@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Real-Time Payment Fraud Screening

Person(Cardholder_End_Customer, "Cardholder / End Customer", "Sends payment authorizations for e-commerce transactions.")
Person(Fraud_Operations_Analyst, "Fraud Operations Analyst", "Accesses Case Management UI to review and manage fraud cases.")
Person(Risk_Manager_Quant, "Risk Manager / Quant", "Updates fraud models in the screening engine.")
Person(Fraud_Ops_Team_Lead_Administrator, "Fraud Ops Team Lead / Administrator", "Manages administrative settings and system operations.")

System_Boundary(Real_Time_Payment_Fraud_Screening, "Real-Time Payment Fraud Screening") {
    Container(API_Gateway_AWS_API_Gateway_WAF, "API Gateway (AWS API Gateway + WAF)", "AWS API Gateway, AWS WAF", "Edge routing and DDoS/bot mitigation at 3,000 TPS.")
    Container(Fraud_Screening_Engine, "Fraud Screening Engine", "AWS ECS Fargate, ONNX Runtimes", "Containerized engine performing real-time fraud scoring using ONNX runtimes.")
    Container(Case_Management_Web_UI, "Case Management Web UI", "Web UI, OIDC, OAuth2", "Provides interface for fraud analysts and operations teams.")
    Container(Event_Streaming_AWS_Managed_Kafka_MSK, "Event Streaming (AWS Managed Kafka - MSK)", "AWS MSK", "Handles asynchronous event streams and messaging.")
    Container(Audit_Storage_AWS_S3_with_Object_Lock_and_KMS, "Audit Storage (AWS S3 with Object Lock and KMS)", "AWS S3, AWS KMS, Object Lock", "Tamper-evident 7-year audit logging for regulatory compliance.")
}

Rel(Cardholder_End_Customer, API_Gateway_AWS_API_Gateway_WAF, "Sends payment authorizations", "HTTPS/TLS 1.3")
Rel(API_Gateway_AWS_API_Gateway_WAF, Fraud_Screening_Engine, "Routes authorization payloads", "Internal TLS/AWS VPC")
Rel(Fraud_Screening_Engine, Audit_Storage_AWS_S3_with_Object_Lock_and_KMS, "Publishes decision audit logs", "AWS SDK")
Rel(Fraud_Operations_Analyst, Case_Management_Web_UI, "Accesses case management interface", "HTTPS with OIDC/OAuth2")
Rel(Risk_Manager_Quant, Fraud_Screening_Engine, "Updates fraud models", "Internal API")

@enduml