@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(serverless_tasks, "Serverless Tasks") {
    Component(model_and_rule_sync_function, "Model and Rule Sync Function", "AWS Lambda", "Executes asynchronous tasks to fetch fraud models from Amazon S3.")
    Component(audit_and_compliance_dispatch_function, "Audit and Compliance Dispatch Function", "AWS Lambda with DLQ", "Dispatches audit logs and compliance data asynchronously to AWS QLDB.")
}

System_Ext(model_artifacts_and_audit_logs_storage, "Model Artifacts and Audit Logs Storage", "Amazon S3")
System_Ext(ledger_database, "Ledger Database", "AWS QLDB")

Rel(model_and_rule_sync_function, model_artifacts_and_audit_logs_storage, "Fetches fraud models", "HTTPS/TLS 1.3")
Rel(audit_and_compliance_dispatch_function, ledger_database, "Sends audit logs with DLQ support", "HTTPS/TLS 1.3")
@enduml