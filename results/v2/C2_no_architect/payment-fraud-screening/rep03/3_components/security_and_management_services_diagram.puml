@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(security_and_management_services, "Security and Management Services") {
    Component(AWS_IAM, "AWS IAM", "AWS Identity and Access Management", "Manages fine-grained access control and permissions for users, services, and resources.")
    Component(AWS_Secrets_Manager, "AWS Secrets Manager", "AWS Secrets Manager", "Secures, manages, and rotates database credentials and API keys.")
    Component(AWS_KMS, "AWS KMS", "AWS Key Management Service", "Handles cryptographic operations with client-side key caching to encrypt/decrypt cardholder data and audit logs.")
    Component(AWS_CodePipeline, "AWS CodePipeline", "AWS CodePipeline", "Automates zero-downtime deployments and model updates.")
    Component(AWS_CloudWatch, "AWS CloudWatch", "Amazon CloudWatch", "Monitors system health and logs performance metrics using tail-based sampling.")
    Component(AWS_X_Ray, "AWS X-Ray", "AWS X-Ray", "Provides distributed tracing for microservices requests.")
    Component(Amazon_Inspector, "Amazon Inspector", "Amazon Inspector", "Performs automated vulnerability scanning during CI/CD pipelines.")
    Component(AWS_Signer, "AWS Signer", "AWS Signer", "Provides integrated artifact signing for secure deployments.")
}

Rel(AWS_CodePipeline, AWS_Signer, "Signs deployment artifacts")
Rel(AWS_CodePipeline, Amazon_Inspector, "Scans artifacts for vulnerabilities")
Rel(AWS_CloudWatch, AWS_X_Ray, "Aggregates telemetry and traces")
@enduml