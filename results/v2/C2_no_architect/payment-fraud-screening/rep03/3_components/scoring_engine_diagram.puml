@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Scoring Engine container

Container_Boundary(scoring_engine, "Scoring Engine") {
    Component(inference_controller, "Inference Controller", "AWS ECS Fargate on AWS Graviton2", "Receives inbound payment authorization requests and coordinates real-time fraud scoring.")
    Component(model_runner, "Model Runner", "Python, AWS ECS Fargate", "Executes ML models using downloaded cryptographically verified model artifacts.")
    Component(audit_logger, "Audit Logger", "AWS KMS, AWS QLDB, Amazon S3", "Persists tamper-evident decision logs, feature weights, and inputs into WORM storage.")
}

Rel(inference_controller, model_runner, "Dispatches transaction payloads for ML inference", "Internal VPC protocols")
Rel(model_runner, audit_logger, "Sends decision logs and feature weights for persistence", "AWS KMS Encryption")

@enduml