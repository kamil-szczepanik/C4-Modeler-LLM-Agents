@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_api_gateway_and_alb, "Amazon API Gateway and ALB") {
    Component(API_Gateway_Edge_Router, "API Gateway Edge Router", "Amazon API Gateway with VPC Link", "Handles low-latency edge routing, built-in rate limiting, and VPC Link integration.")
    Component(Security_Authorizer, "Security Authorizer", "AWS Lambda Authorizers", "Validates incoming requests using AWS WAF, ACM Private CA, and OAuth 2.0 / JWT.")
}

Rel(API_Gateway_Edge_Router, Security_Authorizer, "Authenticates requests using", "")

@enduml