@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Ledger Database container

Container_Boundary(ledger_database, "Ledger Database") {
    Component(Immutable_Ledger_Store, "Immutable Ledger Store", "AWS QLDB", "Persists immutable transaction decision logs and feature weights with cryptographic verification.")
    Component(Audit_Query_Interface, "Audit Query Interface", "PartiQL API", "Executes read-only audit queries for case management and compliance reporting.")
}

Rel(Audit_Query_Interface, Immutable_Ledger_Store, "Executes read-only audit queries", "IAM, PartiQL API")

@enduml