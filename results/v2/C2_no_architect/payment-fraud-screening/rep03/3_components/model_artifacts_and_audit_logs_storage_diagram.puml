@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Model Artifacts and Audit Logs Storage container

Person(ScoringEngine, "Scoring Engine", "External component representing the scoring service.")
Person(RiskManagersDataScientists, "Risk Managers / Data Scientists", "Users who deploy models and query historical logs.")

Container_Boundary(ModelArtifactsandAuditLogsStorage, "Model Artifacts and Audit Logs Storage") {
    Component(ModelArtifactsRepository, "Model Artifacts Repository", "Amazon S3 with Object Lock", "Stores cryptographically verified machine learning model artifacts with WORM compliance.")
    Component(AuditLogsStorage, "Audit Logs Storage", "Amazon S3 with Object Lock and AWS KMS", "Stores immutable decision logs and inputs for 7-year tamper-evident auditability.")
    Component(AnalyticsQueryEngine, "Analytics Query Engine", "Amazon Athena and Lake Formation", "Enables secure, read-only analytics queries over S3 audit and model data with column-level controls.")
}

Rel(ScoringEngine, ModelArtifactsRepository, "Downloads cryptographically verified ML model artifacts", "TLS 1.3")
Rel(ScoringEngine, AuditLogsStorage, "Persists decision logs and inputs into WORM storage via Amazon Kinesis Data Firehose", "AWS KMS Encryption")
Rel(RiskManagersDataScientists, ModelArtifactsRepository, "Deploys model artifacts", "AWS CodePipeline")
Rel(RiskManagersDataScientists, AnalyticsQueryEngine, "Queries historical logs", "Amazon Athena")

@enduml