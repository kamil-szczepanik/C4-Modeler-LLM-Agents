@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management UI & Backend container

Container_Boundary(case_management_ui_and_backend, "Case Management UI & Backend") {
    Component(Case_Management_UI_Backend, "Case Management UI & Backend", "AWS ECS Fargate, TLS 1.3, mTLS", "Supports fraud analysts, risk managers, and compliance officers in reviewing suspicious payment transactions while enforcing strict security controls.")
}

System_Ext(Amazon_QLDB, "Amazon QLDB", "Stores cryptographically signed audit logs")
System_Ext(AWS_Secrets_Manager, "AWS Secrets Manager", "Manages database secrets and OIDC keys")

Rel(Case_Management_UI_Backend, Amazon_QLDB, "Streams immutable audit trails and analyst actions")
Rel(Case_Management_UI_Backend, AWS_Secrets_Manager, "Injects database secrets and OIDC keys at runtime")

@enduml