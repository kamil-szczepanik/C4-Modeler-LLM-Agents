@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Real-Time Payment Fraud Screening System

Person(FraudAnalyst, "Fraud Analyst", "Internal user reviewing suspicious transactions via case management UI.")
Person(RiskManagerDataScientist, "Risk Manager / Data Scientist", "Internal user updating rules and models without downtime.")
Person(ComplianceAuditOfficer, "Compliance & Audit Officer", "Internal user auditing 7-year tamper-evident transaction logs.")

System_Ext(PaymentGatewayProcessingEngine, "Payment Gateway / Processing Engine", "External system submitting payment authorizations via mTLS.")

System_Boundary(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System") {
    Container(APIGatewayALB, "API Gateway / ALB", "AWS ALB / API Gateway", "Ingress point handling OAuth2/OIDC token validation and TLS 1.3.")
    Container(ScoringEngine, "Scoring Engine", "AWS ECS Fargate", "Core container evaluating transactions with cached heuristic fallback.")
    Container(CaseManagementUI, "Case Management UI", "Web UI", "Interface for fraud analysts with strict data masking.")
    Container(AuditLedgerStorage, "Audit & Ledger Storage", "AWS QLDB / Amazon S3 Glacier", "AWS QLDB and Amazon S3 Glacier for 7-year retention.")
}

Rel(PaymentGatewayProcessingEngine, APIGatewayALB, "Submits payment authorization requests", "mTLS and HTTPS (TLS 1.3)")
Rel(APIGatewayALB, ScoringEngine, "Routes authorization scoring requests", "Internal VPC protocols")
Rel(ScoringEngine, AuditLedgerStorage, "Writes cryptographically secured decision logs", "AWS KMS and Amazon QLDB")
Rel(FraudAnalyst, CaseManagementUI, "Accesses case management", "HTTPS with OIDC/SAML and hardware-token MFA")
Rel(RiskManagerDataScientist, ScoringEngine, "Updates fraud models and rules", "Secure administrative APIs")

@enduml