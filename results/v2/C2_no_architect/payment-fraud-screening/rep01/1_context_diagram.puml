@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Real-Time Payment Fraud Screening

Person(FraudAnalyst, "Fraud Analyst", "Reviews and manages suspicious payment cases routed by the system.")
System_Ext(ExternalPaymentGateway, "External Payment Gateway", "Sends payment authorizations for real-time fraud screening.")
System_Ext(GitHubActions, "GitHub Actions", "CI/CD deployment pipeline for automated blue/green deployments.")
System(RealTimePaymentFraudScreening, "Real-Time Payment Fraud Screening", "Screens card-not-present payment authorizations for fraud at 3,000 TPS while routing suspicious cases to analysts, providing sub-50ms fraud decisions and case management while maintaining PCI-DSS Level 1 compliance and 7-year tamper-evident auditability.")

Rel(ExternalPaymentGateway, RealTimePaymentFraudScreening, "Sends payment authorizations for screening", "HTTPS / mTLS")
Rel(FraudAnalyst, RealTimePaymentFraudScreening, "Manages and reviews suspicious cases", "HTTPS (OAuth2/OIDC, WebAuthn MFA)")
Rel(GitHubActions, RealTimePaymentFraudScreening, "Deploys container updates and models", "AWS API")

@enduml