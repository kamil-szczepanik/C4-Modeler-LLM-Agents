@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(External_Payment_Gateway, "External Payment Gateway", "Sends payment authorizations [HTTPS with mTLS, TLS 1.3]")
System_Ext(Scoring_Engine_Container, "Scoring Engine Container", "AWS ECS Fargate", "Receives routed scoring requests from the API Gateway.")

Container_Boundary(api_gateway_ingress_container, "API Gateway / Ingress Container") {
    Component(Ingress_Router, "Ingress Router", "AWS ECS Fargate / Envoy", "Terminates mTLS, validates TLS 1.3, and handles incoming payment authorizations from the External Payment Gateway.")
    Component(Auth_and_WAF_Filter, "Auth and WAF Filter", "AWS WAF / Custom Middleware", "Enforces edge security, request validation, and PCI-DSS Level 1 compliance checks.")
    Component(Routing_Controller, "Routing Controller", "Node.js / Go REST Handler", "Routes validated scoring requests over the internal VPC to the Scoring Engine Container.")
}

Rel(External_Payment_Gateway, Ingress_Router, "Sends payment authorizations", "HTTPS with mTLS, TLS 1.3")
Rel(Ingress_Router, Auth_and_WAF_Filter, "Forwards raw requests for security inspection")
Rel(Auth_and_WAF_Filter, Routing_Controller, "Passes sanitized requests for internal routing")
Rel(Routing_Controller, Scoring_Engine_Container, "Routes scoring requests", "REST over internal VPC")

@enduml