@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the QLDB / S3 Object Lock container

Container_Boundary(ql_s3_container, "QLDB / S3 Object Lock") {
    Component(s3_object_lock_storage, "S3 Object Lock Storage", "Amazon S3 with Object Lock (Compliance Mode)", "Immutable storage guaranteeing 7-year audit retention for tamper-evident decision logs.")
    Component(aws_kms_encryption_service, "AWS KMS Encryption Service", "AWS KMS", "Provides customer-managed key encryption with locked policies for data protection.")
}

System(scoring_engine_container, "Scoring Engine Container", "AWS ECS Fargate Container")

Rel(scoring_engine_container, s3_object_lock_storage, "Writes tamper-evident decision logs", "HTTPS/AWS SDK, TLS 1.3")

@enduml