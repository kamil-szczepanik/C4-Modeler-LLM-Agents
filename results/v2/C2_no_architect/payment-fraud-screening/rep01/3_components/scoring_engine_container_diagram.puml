@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(scoring_engine_container, "Scoring Engine Container") {
    Component(Fraud_Scoring_Controller, "Fraud Scoring Controller", "AWS ECS Fargate / Python REST API", "Receives incoming scoring requests from the API Gateway and coordinates the evaluation pipeline.")
    Component(Model_Inference_Client, "Model Inference Client", "AWS SDK", "Invokes the SageMaker Real-Time Endpoint over VPC interface endpoints to execute fraud scoring logic.")
    Component(Audit_Log_Dispatcher, "Audit Log Dispatcher", "AWS SDK with AWS KMS", "Offloads decision logs asynchronously to Amazon SQS with encryption to guarantee 7-year auditability.")
}

Rel(Fraud_Scoring_Controller, Model_Inference_Client, "Invokes model inference", "AWS SDK over VPC interface endpoints")
Rel(Fraud_Scoring_Controller, Audit_Log_Dispatcher, "Offloads audit logs asynchronously", "AWS SDK with AWS KMS encryption")

@enduml