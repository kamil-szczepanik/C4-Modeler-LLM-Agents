@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management Container container

Person(Fraud_Analyst, "Fraud Analyst", "Reviews suspicious transactions and audits scoring decisions securely.")

Container_Boundary(Case_Management_Container, "Case Management Container") {
    Component(Case_Management_Service, "Case Management Service", "AWS ECS Fargate Container", "Hosts containerized application with service auto-scaling, enforcing PCI-DSS Level 1 compliance and low-latency analyst workflows.")
    Component(Amazon_Aurora_Serverless, "Amazon Aurora Serverless", "Database Container", "Stores review cases and event-driven projections for query performance.")
    Component(Amazon_SQS, "Amazon SQS", "Message Queue Container", "Handles asynchronous dead-letter queues to prevent data loss during outages.")
    Component(Amazon_QLDB_S3_Object_Lock, "Amazon QLDB / S3 Object Lock", "Immutable Ledger System", "Writes cryptographically signed analyst actions and overrides for 7-year auditability.")
    Component(AWS_Secrets_Manager, "AWS Secrets Manager", "Security Service", "Secures database credentials and OIDC secrets with automated rotation.")
}

Rel(Fraud_Analyst, Case_Management_Service, "Accesses review cases and audit trails via HTTPS with OIDC/OAuth2 MFA", "HTTPS / OIDC")
Rel(Case_Management_Service, Amazon_Aurora_Serverless, "Reads and writes review cases and read-optimized audit projections using Database Protocol", "Database Protocol")
Rel(Case_Management_Service, Amazon_SQS, "Routes failed audit logs or feedback events to a Dead-Letter Queue using AWS SDK / SQS Protocol", "AWS SDK / SQS")
Rel(Case_Management_Service, Amazon_QLDB_S3_Object_Lock, "Writes cryptographically signed analyst actions and overrides using AWS SDK / HTTPS", "AWS SDK / HTTPS")
Rel(Case_Management_Service, AWS_Secrets_Manager, "Fetches database credentials and OIDC secrets using AWS SDK / HTTPS", "AWS SDK / HTTPS")

@enduml