@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("AWS_SageMaker_Serverless_Inference", "AWS SageMaker Serverless Inference") {
    Component(Model_Inference_Runtime, "Model Inference Runtime", "AWS ECS Fargate running ONNX", "Invokes high-performance, low-latency fraud scoring without cold-start penalties.")
}

System(Scoring_Engine_Container, "Scoring Engine Container", "AWS ECS Fargate")

Rel(Scoring_Engine_Container, Model_Inference_Runtime, "Invokes fraud scoring", "gRPC / Internal Network")

@enduml