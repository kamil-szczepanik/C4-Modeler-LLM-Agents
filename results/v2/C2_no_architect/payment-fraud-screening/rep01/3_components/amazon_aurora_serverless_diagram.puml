@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon Aurora Serverless container

Container_Boundary(aurora_serverless, "Amazon Aurora Serverless") {
    Component(Case_Data_Store, "Case Data Store", "Amazon Aurora Serverless (v2)", "Relational database configured with auto-pause disabled and 0.5–8 ACUs for reading and writing review cases.")
    Component(Audit_Log_Streamer, "Audit Log Streamer", "CloudWatch Agent / KMS", "Streams advanced audit logs to Amazon CloudWatch encrypted with customer-managed keys.")
}

Rel(Case_Data_Store, Audit_Log_Streamer, "Streams advanced audit logs", "CloudWatch Agent / KMS")

@enduml