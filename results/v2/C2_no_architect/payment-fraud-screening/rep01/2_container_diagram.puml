@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Real-Time Payment Fraud Screening

Person(FraudAnalyst, "Fraud Analyst", "Reviews and manages suspicious payment cases routed by the system.")
Person(RiskOperationsManager, "Risk Operations Manager", "Manages risk operations and analyst workflows.")
Person(FraudDataScientist, "Fraud Data Scientist", "Updates and manages fraud detection machine learning models.")

System_Ext(ExternalPaymentGateway, "External Payment Gateway", "Sends payment authorizations for real-time fraud screening.")

System_Boundary(RealTimePaymentFraudScreening, "Real-Time Payment Fraud Screening") {
    Container(ApiGatewayIngressContainer, "API Gateway / Ingress Container", "AWS ECS Fargate", "Routes incoming requests and handles ingress traffic.")
    Container(ScoringEngineContainer, "Scoring Engine Container", "AWS ECS Fargate", "Executes fraud scoring logic and interacts with the inference service and tamper-evident storage.")
    Container(CaseManagementContainer, "Case Management Container", "AWS ECS Fargate", "Manages analyst reviews and review cases.")
    Container(AwsSageMakerServerlessInference, "AWS SageMaker Serverless Inference", "AWS SageMaker", "Provides serverless machine learning model inference for fraud scoring.")
    ContainerDb(AmazonAuroraServerless, "Amazon Aurora Serverless", "Amazon Aurora", "Stores review cases and persistent application data.")
    ContainerDb(QldbS3ObjectLock, "QLDB / S3 Object Lock", "Amazon QLDB / Amazon S3", "Provides tamper-evident storage for audit logs.")
}

Rel(ExternalPaymentGateway, ApiGatewayIngressContainer, "Sends payment authorizations for real-time fraud screening", "HTTPS (TLS 1.3)")
Rel(ApiGatewayIngressContainer, ScoringEngineContainer, "Routes scoring requests", "REST over internal VPC")
Rel(ScoringEngineContainer, AwsSageMakerServerlessInference, "Invokes model inference", "AWS SDK")
Rel(ScoringEngineContainer, QldbS3ObjectLock, "Writes tamper-evident decision logs", "AWS SDK")
Rel(FraudAnalyst, CaseManagementContainer, "Accesses review cases", "HTTPS with OIDC/OAuth2 MFA")
Rel(CaseManagementContainer, AmazonAuroraServerless, "Reads and writes review cases", "Database Protocol")

@enduml