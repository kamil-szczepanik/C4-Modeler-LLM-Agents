@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(routing_container, "Routing Container") {
    Component(Routing_Service, "Routing Service", "Go", "Handles high-performance network routing of claims traffic and low memory footprint operations.")
    Component(mTLS_Enforcer, "mTLS Enforcer", "mTLS / Azure Key Vault", "Enforces strict bidirectional TLS with certificate pinning and secures private keys for hybrid bridging.")
    Component(GitOps_Sync_Agent, "GitOps Sync Agent", "ArgoCD / Git", "Synchronizes routing tables via GitOps configuration pipeline for rapid claim type rollbacks.")
}

Rel(Routing_Service, mTLS_Enforcer, "Secures traffic sent to the COBOL/DB2 Mainframe", "mTLS")
Rel(GitOps_Sync_Agent, Routing_Service, "Updates routing configuration", "Git")
@enduml