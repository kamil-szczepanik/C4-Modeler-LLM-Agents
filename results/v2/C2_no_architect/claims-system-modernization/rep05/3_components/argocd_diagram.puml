@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the ArgoCD container

System_Ext(AzureKeyVault, "Azure Key Vault", "Secret Management", "Secures runtime secrets, preventing plain-text storage in Git.")
System_Ext(RoutingContainer, "Routing Container", "Go / mTLS", "Synchronizes routing configurations and feature flags.")
System_Ext(AzureMonitor, "Azure Monitor", "Observability", "Collects audit logs and health metrics for operational visibility.")

Container_Boundary(ArgoCD, "ArgoCD") {
    Component(GitOpsReconciliationEngine, "GitOps Reconciliation Engine", "ArgoCD Core", "Standardizes container rollouts and enables 1-day rollbacks for cloud-inexperienced teams.")
    Component(ExternalSecretsOperator, "External Secrets Operator", "Kubernetes Operator", "Injects secrets securely at runtime from Azure Key Vault.")
    Component(ConfigurationSynchronizer, "Configuration Synchronizer", "In-cluster API", "Synchronizes routing configurations and feature flags to the Routing Container.")
}

Rel(GitOpsReconciliationEngine, AzureKeyVault, "Injects secrets securely at runtime", "External Secrets Operator")
Rel(GitOpsReconciliationEngine, RoutingContainer, "Synchronizes routing configurations and feature flags", "In-cluster API")
Rel(GitOpsReconciliationEngine, AzureMonitor, "Ships audit logs and application health metrics", "HTTPS")
@enduml