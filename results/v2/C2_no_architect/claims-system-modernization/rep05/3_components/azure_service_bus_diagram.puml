@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Service Bus container

System_Ext(BFF_Container, "Backend-For-Frontend (BFF) Container", "Node.js", "Message producer enforcing schema validation and envelope encryption.")
System_Ext(Message_Consumers_AKS, "Message Consumers (AKS)", "Kubernetes / KEDA", "Scaled via KEDA to process events asynchronously.")

Container_Boundary(Azure_Service_Bus, "Azure Service Bus") {
    Component(Azure_Service_Bus_Premium_Tier, "Azure Service Bus Premium Tier", "Azure Service Bus Premium", "Core messaging backbone handling asynchronous event publishing and queuing with 14-day message retention, VNet integration, and partitioned throughput.")
    Component(Azure_Private_Link_Endpoints, "Azure Private Link Endpoints", "Azure Private Link", "Secures hybrid connectivity by bypassing the public internet entirely.")
    Component(Azure_Key_Vault_Integration, "Azure Key Vault Integration", "Azure Key Vault", "Manages Customer-Managed Keys (CMK) for encryption at rest and securing payload data.")
}

Rel(BFF_Container, Azure_Service_Bus_Premium_Tier, "Publishes asynchronous claim events over AMQP with TLS 1.3 and Managed Identities", "AMQP / TLS 1.3")
Rel(Azure_Service_Bus_Premium_Tier, Message_Consumers_AKS, "Delivers queued events for downstream processing via secure Private Link endpoints", "Private Link")
Rel(Azure_Service_Bus_Premium_Tier, Azure_Key_Vault_Integration, "Secures payload data at rest using Customer-Managed Keys", "HTTPS / CMK")

@enduml