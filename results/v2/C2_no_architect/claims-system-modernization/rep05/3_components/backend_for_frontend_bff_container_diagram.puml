@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(bff_container, "Backend-For-Frontend (BFF) Container") {
    Component(API_Controller, "API Controller", "Node.js / REST / HTTPS", "Exchanges tokens and data via REST/HTTPS with OAuth2 Token Exchange and serves incoming traffic.")
    Component(Session_and_Cache_Manager, "Session and Cache Manager", "Azure Redis", "Handles encrypted caching layer for session and claim data.")
    Component(Configuration_Client, "Configuration Client", "Azure App Configuration", "Retrieves centralized feature flag management for incremental migration.")
    Component(Secret_Manager_Client, "Secret Manager Client", "Azure Key Vault / Managed Identities", "Retrieves secrets securely via Managed Identities and HTTPS.")
    Component(Messaging_Publisher, "Messaging Publisher", "Azure Service Bus (AMQP)", "Exchanges asynchronous events via AMQP messaging.")
    Component(Legacy_Integration_Client, "Legacy Integration Client", "Node.js / mTLS / OpenTelemetry", "Interacts across hybrid boundary with the COBOL/DB2 Mainframe using mTLS, circuit breakers, and OpenTelemetry.")
}

Rel(API_Controller, Session_and_Cache_Manager, "Caches session and claim data")
Rel(API_Controller, Configuration_Client, "Fetches feature flags")
Rel(API_Controller, Secret_Manager_Client, "Retrieves secrets securely")
Rel(API_Controller, Messaging_Publisher, "Publishes asynchronous events")
Rel(API_Controller, Legacy_Integration_Client, "Delegates legacy requests")
@enduml