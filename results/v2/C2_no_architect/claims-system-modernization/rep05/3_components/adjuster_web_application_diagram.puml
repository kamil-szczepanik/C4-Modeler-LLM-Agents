@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Adjuster Web Application container

Container_Boundary(adjuster_web_application, "Adjuster Web Application") {
    Component(Claims_UI_Router, "Claims UI Router", "React Router", "Manages client-side routing and navigation for multi-tab adjuster workflows.")
    Component(Claims_Dashboard_Component, "Claims Dashboard Component", "React / TypeScript", "Renders high-performance UI components for managing and viewing claims data.")
    Component(API_Client_Module, "API Client Module", "Axios / Fetch API", "Communicates securely with the Backend-For-Frontend container via HTTPS.")
}

Rel(Claims_UI_Router, Claims_Dashboard_Component, "Loads view")
Rel(Claims_Dashboard_Component, API_Client_Module, "Requests claims data")

@enduml