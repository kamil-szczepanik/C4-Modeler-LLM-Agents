@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Customer Portal container

Container_Boundary(customer_portal, "Customer Portal") {
    Component(Customer_Portal_SPA, "Customer Portal SPA", "React SPA / HTTPS / TLS 1.3 / Web Crypto API", "Renders the modern digital experience for customers and brokers, handling stateless rendering, local encryption, and direct communication with backend services.")
}

System_Ext(BFF_Container, "BFF Container", "Backend-for-Frontend service")
System_Ext(Azure_Blob_Storage, "Azure Blob Storage", "Document & Photo Storage")
System_Ext(Azure_Active_Directory_Entra_ID, "Azure Active Directory / Entra ID", "Identity Provider")

Rel(Customer_Portal_SPA, BFF_Container, "Communicates via REST APIs", "HTTPS/TLS 1.3")
Rel(Customer_Portal_SPA, Azure_Blob_Storage, "Uploads evidence directly", "HTTPS / SAS Tokens")
Rel(Customer_Portal_SPA, Azure_Active_Directory_Entra_ID, "Authenticates users", "OAuth2 / OIDC")

@enduml