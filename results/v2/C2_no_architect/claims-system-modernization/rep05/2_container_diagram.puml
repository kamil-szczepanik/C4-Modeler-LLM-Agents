@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Modern Claims Platform

Person(CustomersAndBrokers, "Customers and Brokers", "External users submitting claims online.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal users managing claims in the new web application.")
Person(BusinessOperationsComplianceOfficers, "Business Operations / Compliance Officers", "Internal users monitoring compliance and operations.")
Person(ITAdministrators, "IT Administrators", "Internal staff managing operational tooling, feature flags, and rollbacks.")

System_Ext(COBOLDB2Mainframe, "COBOL/DB2 Mainframe", "On-premises system of record claims mainframe.")
System_Ext(AzureActiveDirectoryEntraID, "Azure Active Directory / Entra ID", "Identity provider used for Single Sign-On (SSO) and RBAC.")
System_Ext(AzureKeyVault, "Azure Key Vault", "Secret management service using Managed Identities.")

System_Boundary(ModernClaimsPlatform, "Modern Claims Platform") {
    Container(CustomerPortal, "Customer Portal", "React / HTTPS", "Allows customers and brokers to submit claims online.")
    Container(AdjusterWebApplicaton, "Adjuster Web Application", "React / OAuth2 / OIDC", "High-performance web interface for adjusters.")
    Container(BackendForFrontendBFFContainer, "Backend-For-Frontend (BFF) Container", "Node.js / REST / HTTPS", "Serves the adjuster web application and provides caching layer.")
    Container(RoutingContainer, "Routing Container", "Go / mTLS", "Routes traffic and integrates with the on-premises mainframe.")
    Container(AzureServiceBus, "Azure Service Bus", "Azure Messaging", "Handles asynchronous event publishing and message queuing.")
    Container(ArgoCD, "ArgoCD", "GitOps", "Standardizes container rollouts and enables 1-day rollbacks.")
}

Rel(CustomersAndBrokers, CustomerPortal, "Accesses online claim submission", "HTTPS/TLS 1.3")
Rel(ClaimsAdjusters, AdjusterWebApplicaton, "Manages claims via web interface", "OAuth2/OIDC Single Sign-On")
Rel(AdjusterWebApplicaton, BackendForFrontendBFFContainer, "Communicates and exchanges tokens", "REST/HTTPS with OAuth2 Token Exchange (RFC 8693)")
Rel(BackendForFrontendBFFContainer, COBOLDB2Mainframe, "Interacts across hybrid boundary", "mTLS and circuit breakers")
Rel(RoutingContainer, COBOLDB2Mainframe, "Routes claims traffic to legacy system", "mTLS")
Rel(AdjusterWebApplicaton, AzureActiveDirectoryEntraID, "Authenticates users", "OAuth2/OIDC")
Rel(BackendForFrontendBFFContainer, AzureServiceBus, "Exchanges asynchronous events", "AMQP / Messaging")
Rel(ITAdministrators, ArgoCD, "Manages container rollouts and rollbacks", "GitOps")
Rel(BackendForFrontendBFFContainer, AzureKeyVault, "Retrieves secrets securely", "Managed Identities / HTTPS")

@enduml