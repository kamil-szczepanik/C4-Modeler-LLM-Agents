@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Modern Claims Platform

Person(Customers_and_Brokers, "Customers and Brokers", "External users submitting claims online.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal users managing claims in the new web application.")
Person(IT_Administrators, "IT Administrators", "Internal staff managing operational tooling, feature flags, and rollbacks.")

System(Modern_Claims_Platform, "Modern Claims Platform", "A hybrid cloud platform that gradually replaces a legacy COBOL/DB2 mainframe claims system, enabling online claim submissions and adjuster processing while maintaining the legacy mainframe as the system of record.")

System_Ext(Legacy_System, "Legacy System", "On-premise COBOL/DB2 mainframe claims system acting as the system of record.")
System_Ext(Azure_Active_Directory_Entra_ID, "Azure Active Directory (Entra ID)", "Identity provider used for single sign-on (SSO).")

Rel(Customers_and_Brokers, Modern_Claims_Platform, "Submit claims online", "HTTPS (REST API)")
Rel(Claims_Adjusters, Modern_Claims_Platform, "Manage claims in the web application", "HTTPS (OAuth 2.0 / OIDC)")
Rel(IT_Administrators, Modern_Claims_Platform, "Manage operational tooling, feature flags, and rollbacks", "Azure App Configuration / HTTPS")
Rel(Modern_Claims_Platform, Legacy_System, "Synchronize claims data and maintain system of record", "mTLS and asynchronous messaging")
Rel(Modern_Claims_Platform, Azure_Active_Directory_Entra_ID, "Authenticate users via SSO", "OAuth 2.0 / OIDC")

@enduml