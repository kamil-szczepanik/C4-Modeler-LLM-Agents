@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Hybrid Insurance Claims Modernization Platform

Person(Policyholders, "Policyholders", "External users who submit claims online.")
Person(Brokers, "Brokers", "External users who submit and manage claims on behalf of policyholders.")
Person(Claims Adjusters, "Claims Adjusters", "Internal users of the new web application handling claims.")
Person(Compliance and Audit Officers, "Compliance and Audit Officers", "Internal users monitoring immutable audit trails.")

System_Ext(COBOL/DB2 Mainframe, "COBOL/DB2 Mainframe", "On-premises legacy system of record.")
System_Ext(Azure Active Directory / Entra ID, "Azure Active Directory / Entra ID", "Identity and Access Management providing SSO.")

System_Boundary(Hybrid Insurance Claims Modernization Platform, "Hybrid Insurance Claims Modernization Platform") {
    Container(API Gateway, "API Gateway", "Azure API Gateway", "Entry point for incoming requests, routing traffic to internal services.")
    Container(Claims Web App, "Claims Web App", "Azure AKS, ASP.NET Core / React", "Web application providing the user interface for policyholders, brokers, and adjusters.")
    Container(Integration Service, "Integration Service", "Azure AKS, .NET", "Handles integration and communication with the legacy mainframe system.")
    Container(Claim Reconciliation Service, "Claim Reconciliation Service", "Azure AKS, .NET", "Performs audit data verification and state synchronization with the mainframe.")
    ContainerDb(Azure Redis, "Azure Redis", "Azure Cache for Redis", "In-memory caching for UI acceleration.")
    Container(Azure Service Bus, "Azure Service Bus", "Azure Service Bus", "Asynchronous message queueing for claim submissions.")
}

Rel(Policyholders, API Gateway, "Accesses the platform for claim submissions", "HTTPS / TLS 1.3 via OAuth2/OIDC Single Sign-On")
Rel(Brokers, API Gateway, "Accesses the platform for claim submissions", "HTTPS / TLS 1.3 via OAuth2/OIDC Single Sign-On")
Rel(Claims Adjusters, API Gateway, "Interacts with the claims system", "HTTPS / TLS 1.3 via OAuth2/OIDC Single Sign-On")
Rel(Compliance and Audit Officers, API Gateway, "Monitors audit data and logs", "HTTPS / TLS 1.3 via OAuth2/OIDC Single Sign-On")
Rel(API Gateway, Claims Web App, "Routes user traffic", "HTTPS")
Rel(Claims Web App, Azure Redis, "In-memory caching for UI acceleration", "TCP")
Rel(Claims Web App, Azure Service Bus, "Asynchronous message queueing for claim submissions", "AMQP")
Rel(Integration Service, COBOL/DB2 Mainframe, "Hybrid integration for data exchange", "mTLS (TLS 1.3) with certificate pinning")
Rel(Claim Reconciliation Service, COBOL/DB2 Mainframe, "Audit data verification and state synchronization", "mTLS")

@enduml