@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(integration_service, "Integration Service") {
    Component(Mainframe_Connector, "Mainframe Connector", ".NET / mTLS 1.3", "Handles hybrid data exchange and legacy queries with the COBOL/DB2 Mainframe using certificate pinning.")
    Component(Messaging_Publisher, "Messaging Publisher", ".NET / AMQP / Azure SDK", "Publishes messages and manages dead-letter queues via Azure Service Bus.")
    Component(Cache_Manager, "Cache Manager", ".NET / Redis Protocol over TLS", "Caches transit data using Azure Cache for Redis with customer-managed keys.")
    Component(Configuration_Client, "Configuration Client", ".NET / HTTPS", "Retrieves dynamic feature flags for claim type rollbacks from Azure App Configuration.")
    Component(Secrets_Manager, "Secrets Manager", ".NET / CSI secret drivers", "Retrieves mainframe client certificates and credentials from Azure Key Vault.")
    Component(Audit_Logger, "Audit Logger", ".NET / Syslog / Azure Diagnostics", "Forwards audit and authorization logs to Azure Sentinel.")
}

System_Ext(COBOL_DB2_Mainframe, "COBOL/DB2 Mainframe", "Legacy mainframe system of record.")
System_Ext(Azure_Service_Bus, "Azure Service Bus", "Provides reliable messaging and dead-letter queues.")
System_Ext(Azure_Cache_for_Redis, "Azure Cache for Redis", "Caches transit data with customer-managed keys.")
System_Ext(Azure_App_Configuration, "Azure App Configuration", "Enables runtime feature flags.")
System_Ext(Azure_Key_Vault, "Azure Key Vault", "Secures mainframe mTLS certificates and credentials.")
System_Ext(Azure_Sentinel, "Azure Sentinel", "Centralizes security and audit logging for compliance.")

Rel(Mainframe_Connector, COBOL_DB2_Mainframe, "Hybrid data exchange and legacy queries", "mTLS 1.3 with certificate pinning")
Rel(Messaging_Publisher, Azure_Service_Bus, "Publishes messages and dead-letter queues", "AMQP / Azure SDK")
Rel(Cache_Manager, Azure_Cache_for_Redis, "Caches transit data with customer-managed keys", "Redis Protocol over TLS")
Rel(Configuration_Client, Azure_App_Configuration, "Dynamic feature flags for claim type rollbacks", "HTTPS")
Rel(Secrets_Manager, Azure_Key_Vault, "Retrieves mainframe client certificates and credentials via CSI secret drivers", "HTTPS")
Rel(Audit_Logger, Azure_Sentinel, "Forwards audit and authorization logs", "Syslog / Azure Diagnostics")
@enduml