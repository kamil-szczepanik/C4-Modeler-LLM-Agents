@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Azure_Service_Bus", "Azure Service Bus") {
    Component(Claim_Submission_Topic, "Claim Submission Topic", "Azure Service Bus Topic", "Receives asynchronous claim submission messages from the Claims Web App and distributes them to subscriptions.")
    Component(Claim_Processing_Subscription, "Claim Processing Subscription", "Azure Service Bus Subscription", "Queues claim messages for consumption by backend integration and processing services.")
    Component(Dead_Letter_Queue_DLQ, "Dead-Letter Queue (DLQ)", "Azure Service Bus DLQ", "Captures malformed or failed claim messages for error governance and manual auditing.")
}

Rel(Claim_Submission_Topic, Claim_Processing_Subscription, "Routes messages to", "")
Rel(Claim_Processing_Subscription, Dead_Letter_Queue_DLQ, "Forwards failed messages to", "")
@enduml