@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Redis container

System_Ext(ClaimsWeb, "Claims Web App", "Container from external context")

Container_Boundary(AzureRedis, "Azure Redis") {
    Component(UI Acceleration Cache, "UI Acceleration Cache", "Azure Cache for Redis", "Caches reference data and supports UI acceleration to maintain sub-2-second response times.")
    Component(Session Management Store, "Session Management Store", "Azure Cache for Redis", "Manages secure user sessions for claims adjusters interacting with the Claims Web App.")
}

Rel(ClaimsWeb, UI Acceleration Cache, "Reads reference data and UI caches", "TLS 1.2 / TCP")
Rel(ClaimsWeb, Session Management Store, "Manages user sessions", "TLS 1.2 / TCP")

@enduml