@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Web App container

Container_Boundary(claims_web_app, "Claims Web App") {
    Component(React_Frontend, "React Frontend", "React, Azure Static Web Apps", "Responsive user interface enabling online claim submission and processing for policyholders, brokers, adjusters, and branch agents.")
    Component(ASP_NET_Core_API_Backend, "ASP.NET Core API Backend", "ASP.NET Core, Azure Container Apps", "Microservices runtime providing high-performance request handling, RBAC authorization, and hybrid integration.")
    Component(Azure_API_Gateway, "Azure API Gateway", "Azure API Gateway", "Routes validated traffic from the frontend to the backend securely.")
    Component(Azure_Cache_for_Redis, "Azure Cache for Redis", "Azure Cache for Redis", "In-memory cache for secure UI state and session management.")
    Component(Azure_Service_Bus, "Azure Service Bus", "Azure Service Bus", "Asynchronous message queueing for reliable claim event delivery.")
    Component(Azure_App_Configuration, "Azure App Configuration", "Azure App Configuration", "Centralized management of runtime feature flags for rapid mainframe fallback.")
    Component(Mainframe_Integration_Adapter, "Mainframe Integration Adapter", "Polly, HTTPS/MQ", "Handles resilient communication and synchronization with the on-premises COBOL/DB2 Mainframe.")
}

Rel(React_Frontend, Azure_API_Gateway, "Forwards API requests", "HTTPS, OpenID Connect/OAuth2")
Rel(Azure_API_Gateway, ASP_NET_Core_API_Backend, "Routes validated traffic", "HTTPS, mTLS")
Rel(ASP_NET_Core_API_Backend, Azure_Cache_for_Redis, "Caches UI state and session data", "TCP, TLS")
Rel(ASP_NET_Core_API_Backend, Azure_Service_Bus, "Queues asynchronous claim submissions", "AMQP")
Rel(ASP_NET_Core_API_Backend, Mainframe_Integration_Adapter, "Synchronizes legacy claims processing")
Rel(ASP_NET_Core_API_Backend, Azure_App_Configuration, "Fetches real-time feature flags and fallback states", "HTTPS")

@enduml