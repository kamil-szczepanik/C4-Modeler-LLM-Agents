@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claim Reconciliation Service container

System_Boundary(claim_reconciliation_service, "Claim Reconciliation Service") {
    Component(Reconciliation_Worker, "Reconciliation Worker", ".NET / Azure AKS", "Executes asynchronous state verification between the modern Azure platform and the legacy mainframe via read-replicas and CDC.")
    Component(Event_Publisher, "Event Publisher", ".NET / Azure Service Bus", "Publishes discrepancy events to Azure Service Bus using TLS 1.3.")
    Component(Audit_Trail_Generator, "Audit Trail Generator", ".NET / Azure Blob Storage", "Writes cryptographically signed, PII-masked audit trails to immutable WORM storage via HTTPS.")
}

System_Ext(COBOL_DB2_Mainframe, "COBOL/DB2 Mainframe", "On-premises System of Record")
System_Ext(Azure_Service_Bus, "Azure Service Bus", "Topics & Dead-Letter Queues")
System_Ext(Azure_Blob_Storage, "Azure Blob Storage", "Immutable WORM storage")

Rel(Reconciliation_Worker, COBOL_DB2_Mainframe, "Asynchronous state verification via read-replicas/CDC", "mTLS")
Rel(Event_Publisher, Azure_Service_Bus, "Publishes discrepancy events", "TLS 1.3")
Rel(Reconciliation_Worker, Audit_Trail_Generator, "Passes reconciliation results for secure logging", "")
Rel(Audit_Trail_Generator, Azure_Blob_Storage, "Writes cryptographically signed, PII-masked audit trails", "HTTPS")

@enduml