@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Hybrid Insurance Claims Modernization Platform

Person(Policyholders_and_Brokers, "Policyholders and Brokers", "External users who submit claims online.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal users of the new web application handling claims.")
Person(Compliance_and_Audit_Officers, "Compliance and Audit Officers", "Internal users monitoring immutable audit trails.")

System(Hybrid_Insurance_Claims_Modernization_Platform, "Hybrid Insurance Claims Modernization Platform", "A hybrid insurance claims modernization platform that gradually migrates claim types from a legacy mainframe to Azure while maintaining business continuity, data consistency, and a responsive web interface.")

System_Ext(COBOL_DB2_Mainframe, "COBOL/DB2 Mainframe", "On-premises legacy system of record.")
System_Ext(Azure_Active_Directory___Entra_ID, "Azure Active Directory / Entra ID", "Identity and Access Management providing SSO.")

Rel(Policyholders_and_Brokers, Hybrid_Insurance_Claims_Modernization_Platform, "Submit claims online", "HTTPS (TLS 1.3, OpenID Connect/OAuth2)")
Rel(Claims_Adjusters, Hybrid_Insurance_Claims_Modernization_Platform, "Interact with the adjuster web application for sub-second UI responses", "HTTPS")
Rel(Compliance_and_Audit_Officers, Hybrid_Insurance_Claims_Modernization_Platform, "Monitor immutable audit trails", "HTTPS")
Rel(Hybrid_Insurance_Claims_Modernization_Platform, COBOL_DB2_Mainframe, "Communicates asynchronously for data synchronization and processing", "Azure Service Bus, Azure ExpressRoute / IPsec VPN (mTLS)")
Rel(Hybrid_Insurance_Claims_Modernization_Platform, Azure_Active_Directory___Entra_ID, "Federates for Single Sign-On and user authentication", "OAuth2 / OpenID Connect")
@enduml