@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Application Insights container

Container_Boundary(azure_application_insights, "Azure Application Insights") {
    Component(Central_Telemetry_Collector, "Central Telemetry Collector", "Azure Application Insights SDK", "Collects telemetry, handles distributed tracing, and powers business SLA dashboarding for the hybrid insurance claims platform.")
    Component(Telemetry_Export_Archiver, "Telemetry Export Archiver", "Azure Application Insights Export API", "Exports long-term immutable telemetry data to storage for insurance compliance.")
}

Rel(Central_Telemetry_Collector, Telemetry_Export_Archiver, "Exports telemetry archive", "HTTPS")

@enduml