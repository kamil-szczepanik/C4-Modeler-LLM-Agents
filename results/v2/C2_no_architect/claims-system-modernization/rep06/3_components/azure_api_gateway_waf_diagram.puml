@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(azure_api_gateway_and_waf, "Azure API Gateway & WAF") {
    Component(Web_Application_Firewall, "Web Application Firewall", "Azure WAF", "Inspects incoming HTTPS traffic, enforces rate-limiting, and prevents OWASP Top 10 attacks for hybrid entries.")
    Component(API_Routing_Engine, "API Routing Engine", "Azure API Gateway", "Handles edge routing, reverse proxy capabilities, and forwards requests to backend microservices via mTLS.")
    Component(Token_Validation_Validator, "Token Validation Validator", "OAuth 2.0 / OIDC Middleware", "Validates single sign-on tokens against Entra ID for authenticated policyholders, brokers, and adjusters.")
}

Rel(Web_Application_Firewall, API_Routing_Engine, "Forwards inspected and filtered traffic", "HTTPS")
Rel(API_Routing_Engine, Token_Validation_Validator, "Delegates token validation", "OAuth 2.0, OIDC")

@enduml