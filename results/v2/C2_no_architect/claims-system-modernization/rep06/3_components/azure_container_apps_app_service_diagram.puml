@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Container Apps / App Service container

Container_Boundary(azure_container_apps_app_service, "Azure Container Apps / App Service") {
    Component(ClaimManagementController, "Claim Management Controller", "ASP.NET Core API", "Handles online claim submission and adjuster interaction via HTTPS.")
    Component(MigrationRollbackRouter, "Migration & Rollback Router", "Microservice Traffic Router", "Manages traffic splitting, gradual migration, and instant rollbacks.")
    Component(LegacyIntegrationAdapter, "Legacy Integration Adapter", "gRPC / REST Client", "Interfaces with the COBOL/DB2 Mainframe via hybrid VPN and mTLS for fallback processing.")
    Component(AutoscalingCoordinator, "Autoscaling Coordinator", "KEDA Scaler", "Maintains minimum replicas on Azure Container Apps to prevent cold starts.")
}

Rel(ClaimManagementController, MigrationRollbackRouter, "Forwards requests for processing", "HTTPS")
Rel(MigrationRollbackRouter, LegacyIntegrationAdapter, "Routes legacy claims and fallback requests", "mTLS, Hybrid VPN")

@enduml