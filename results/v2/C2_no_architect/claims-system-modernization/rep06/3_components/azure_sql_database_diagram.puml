@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure SQL Database container

System_Boundary(azure_sql_database_container, "Azure SQL Database") {
    Component(Azure_SQL_Database, "Azure SQL Database", "Hyperscale/Serverless tiers", "Primary operational data store for the hybrid system, providing automatic scaling, built-in HA/DR, and data persistence.")
}

System_Ext(Azure_Key_Vault, "Azure Key Vault", "Secures Customer-Managed Keys (CMK) for data encryption at rest.")
System_Ext(Azure_Blob_Storage, "Azure Blob Storage", "External storage for historical data.")

Rel(Azure_SQL_Database, Azure_Key_Vault, "Transparent Data Encryption key retrieval", "HTTPS")
Rel(Azure_SQL_Database, Azure_Blob_Storage, "Historical claim data offloading", "HTTPS")

@enduml