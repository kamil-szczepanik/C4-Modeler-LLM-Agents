@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(azure_key_vault, "Azure Key Vault") {
    Component(SecretsManagementEngine, "Secrets Management Engine", "Azure Key Vault (Standard/Premium SKU)", "Centralized secret, certificate, and key management with soft-delete and purge protection enabled.")
    Component(AccessControlAuthenticationManager, "Access Control & Authentication Manager", "Managed Identities, Azure RBAC, & PIM", "Enforces least-privilege access (*Key Vault Secrets User*) and passwordless authentication eliminating hardcoded credentials.")
    Component(NetworkIsolationPrivateLinkService, "Network Isolation & Private Link Service", "Azure Private Endpoints & Virtual Network", "Secures hybrid integration points by disabling public access to the Key Vault via network isolation.")
    Component(TelemetrySecurityMonitoring, "Telemetry & Security Monitoring", "Application Insights & Azure Defender for Key Vault", "Emits diagnostic logs, metric alerts, security telemetry, and monitors access patterns for anomaly detection.")
}

Rel(SecretsManagementEngine, AccessControlAuthenticationManager, "Authenticates requests using Managed Identities and Azure RBAC rules")
Rel(SecretsManagementEngine, NetworkIsolationPrivateLinkService, "Routes inbound and outbound traffic securely through Private Endpoints")
Rel(SecretsManagementEngine, TelemetrySecurityMonitoring, "Emits diagnostic logs, metric alerts, and security telemetry to Application Insights and Defender")
Rel(AccessControlAuthenticationManager, NetworkIsolationPrivateLinkService, "Applies least-privilege policies over private network connections")

@enduml