Container_Boundary(azure_active_directory___entra_id, "Azure Active Directory / Entra ID") {
    Component(Authentication_Identity_Provider_Service, "Authentication & Identity Provider Service", "Azure Active Directory / Entra ID, External ID, OAuth 2.0, OIDC", "Handles Single Sign-On (SSO) and user segmentation for internal staff, external brokers, and policyholders.")
