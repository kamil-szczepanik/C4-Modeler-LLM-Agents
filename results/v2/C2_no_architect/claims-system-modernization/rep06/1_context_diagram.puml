@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Hybrid Insurance Claims Modernization Platform

Person(Policyholders, "Policyholders", "Customers who submit online claims and interact with the platform.")
Person(InsuranceBrokers, "Insurance Brokers", "Brokers who assist with claims and interact with the platform.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal staff who process claims and access the web application.")
Person(OperationsManagers, "Operations Managers", "Internal managers who oversee operations and access the web application.")

System_Ext(COBOLDB2Mainframe, "COBOL/DB2 Mainframe", "System of Record running on-premise for legacy insurance data and batch processing.")
System_Ext(OnPremiseActiveDirectoryEntraID, "On-Premise Active Directory / Entra ID", "Directory service used for authentication and identity management.")

System_Boundary(HybridInsuranceClaimsModernizationPlatform, "Hybrid Insurance Claims Modernization Platform") {
    Container(AzureAPIGatewayWAF, "Azure API Gateway / WAF", "Azure API Gateway, WAF", "Secures and routes incoming HTTPS/TLS 1.3 traffic from users.")
    Container(AzureAppService, "Azure App Service", "Azure App Service", "Hosts the web application for claims processing using Managed PaaS.")
    ContainerDb(ManagedRedisCache, "Managed Redis Cache", "Managed Redis Cache", "Provides fast data caching to support performance requirements.")
    ContainerDb(AzureSQLDatabase, "Azure SQL Database", "Azure SQL Database", "Stores relational operational data in the cloud.")
    
    Component(AzureApplicationInsights, "Azure Application Insights", "Azure Application Insights, OpenTelemetry", "Provides distributed tracing and hybrid error tracking.")
    Component(AzureKeyVault, "Azure Key Vault", "Azure Key Vault", "Manages secrets, keys, and certificates securely.")
}

Rel(Policyholders, AzureAPIGatewayWAF, "Online claim submission and web application interaction", "HTTPS / TLS 1.3")
Rel(InsuranceBrokers, AzureAPIGatewayWAF, "Online claim submission and web application interaction", "HTTPS / TLS 1.3")
Rel(ClaimsAdjusters, AzureAppService, "Authenticates via OpenID Connect/OAuth 2.0 and accesses the web application", "HTTPS, OpenID Connect / OAuth 2.0")
Rel(OperationsManagers, AzureAppService, "Authenticates via OpenID Connect/OAuth 2.0 and accesses the web application", "HTTPS, OpenID Connect / OAuth 2.0")
Rel(AzureAppService, ManagedRedisCache, "Data retrieval and caching for fast UI performance", "TCP")
Rel(AzureAppService, AzureSQLDatabase, "Relational data persistence and retrieval", "T-SQL / HTTPS")
Rel(AzureAppService, COBOLDB2Mainframe, "Hybrid claim synchronization and batch processing during the 23:00-05:00 window", "mTLS, TLS 1.3")
Rel(AzureAppService, AzureKeyVault, "Retrieves secrets and keys securely", "HTTPS")
Rel(AzureAppService, AzureApplicationInsights, "Sends telemetry, metrics, and error logs", "HTTPS / OpenTelemetry")

@enduml