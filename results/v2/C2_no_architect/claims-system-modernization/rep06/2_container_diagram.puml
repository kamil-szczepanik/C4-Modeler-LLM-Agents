@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Hybrid Insurance Claims Modernization Platform

Person(Policyholders, "Policyholders", "External users submitting online claims.")
Person(InsuranceBrokers, "Insurance Brokers", "External users submitting claims on behalf of policyholders.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal users handling claims via the web application.")
Person(OperationsManagers, "Operations Managers", "Users monitoring claim migration and rollbacks.")

System_Ext(COBOLDB2Mainframe, "COBOL/DB2 Mainframe", "On-premise legacy system of record for hybrid fallback processing.")

System_Boundary(HybridInsuranceClaimsModernizationPlatform, "Hybrid Insurance Claims Modernization Platform") {
    Container(AzureAPIGatewayWAF, "Azure API Gateway & WAF", "Azure Web Application Firewall, API Gateway", "Provides Web Application Firewall and ingress routing for incoming requests.")
    Container(AzureContainerAppsAppService, "Azure Container Apps / App Service", "Azure Container Apps, App Service", "Hosts the adjuster and portal containers.")
    ContainerDb(AzureSQLDatabase, "Azure SQL Database", "Azure SQL Database", "Modern platform database with automated snapshots.")
    Container(AzureActiveDirectoryEntraID, "Azure Active Directory / Entra ID", "Azure AD, Entra ID, OAuth 2.0, OIDC", "Handles Identity and Access Management.")
    Container(AzureApplicationInsights, "Azure Application Insights", "Azure Application Insights", "Provides distributed tracing with PII masking.")
    Container(AzureKeyVault, "Azure Key Vault", "Azure Key Vault", "Manages secrets securely using Managed Identities.")
}

Rel(Policyholders, AzureAPIGatewayWAF, "Online claim submission", "HTTPS (TLS 1.3)")
Rel(InsuranceBrokers, AzureAPIGatewayWAF, "Online claim submission", "HTTPS (TLS 1.3)")
Rel(ClaimsAdjusters, AzureContainerAppsAppService, "Claim management and interaction", "HTTPS, OAuth 2.0, OIDC")
Rel(OperationsManagers, AzureContainerAppsAppService, "Monitoring claim migration and rollbacks", "HTTPS, OAuth 2.0, OIDC")
Rel(AzureAPIGatewayWAF, AzureSQLDatabase, "Data persistence", "TLS")
Rel(AzureContainerAppsAppService, COBOLDB2Mainframe, "Legacy claim fallback processing", "Hybrid VPN, mTLS")
Rel(AzureApplicationInsights, AzureContainerAppsAppService, "Distributed tracing telemetry", "HTTPS")
Rel(AzureKeyVault, AzureContainerAppsAppService, "Secret management", "Managed Identities")

@enduml