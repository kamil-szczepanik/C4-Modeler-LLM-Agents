@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "Submits claims online.")
Person(Broker, "Broker", "Submits claims on behalf of customers.")
Person("Claims Adjuster", "Claims Adjuster", "Accesses adjuster screens to manage and process claims.")
Person("Business Operations Manager", "Business Operations Manager", "Manages business operations via the dashboard.")

System("Hybrid Cloud Claims System", "Hybrid Cloud Claims System", "Modern hybrid cloud platform replacing a 30-year-old COBOL/DB2 mainframe claims system, enabling online claim submission and adjuster workflows while maintaining legacy operations.")

System_Ext("COBOL/DB2 Mainframe System of Record", "COBOL/DB2 Mainframe System of Record", "Legacy on-premise system maintaining core records and nightly batch processing.")

Rel(Customer, "Hybrid Cloud Claims System", "Submit claims", "HTTPS/TLS 1.3")
Rel(Broker, "Hybrid Cloud Claims System", "Submit claims", "HTTPS/TLS 1.3")
Rel("Claims Adjuster", "Hybrid Cloud Claims System", "Access adjuster screens and workflows", "HTTPS, OpenID Connect, OAuth 2.0")
Rel("Business Operations Manager", "Hybrid Cloud Claims System", "Access business operations dashboard", "HTTPS")
Rel("Hybrid Cloud Claims System", "COBOL/DB2 Mainframe System of Record", "Route traffic securely and execute legacy operations", "mTLS, HMAC")

@enduml