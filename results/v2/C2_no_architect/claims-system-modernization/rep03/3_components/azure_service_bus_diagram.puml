@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Service Bus container

System_Ext(Modern_Web_Application, "Modern Web Application", "React, ASP.NET Core", "Modern Web Application")
System_Ext(Data_Sync_Reconciliation_Jobs, "Data Sync & Reconciliation Jobs", "Azure Container Instances / Functions", "Data Sync & Reconciliation Jobs")
System_Ext(Azure_Key_Vault, "Azure Key Vault", "Azure Key Vault", "Azure Key Vault")

Container_Boundary(Azure_Service_Bus, "Azure Service Bus") {
    Component(Claim_Message_Queue, "Claim Message Queue", "Azure Service Bus (Premium Tier)", "Publishes asynchronous claim messages and isolates the mainframe backend.")
    Component(Batch_Reconciliation_Queue, "Batch Reconciliation Queue", "Azure Service Bus (Premium Tier)", "Triggers batch reconciliation queues for data sync.")
}

Rel(Modern_Web_Application, Claim_Message_Queue, "Publishes asynchronous claim messages", "AMQP / Azure Service Bus Protocol")
Rel(Claim_Message_Queue, Data_Sync_Reconciliation_Jobs, "Triggers batch reconciliation queues", "AMQP")
Rel(Claim_Message_Queue, Azure_Key_Vault, "Encrypts messages at rest using Customer-Managed Keys", "HTTPS / REST")
@enduml