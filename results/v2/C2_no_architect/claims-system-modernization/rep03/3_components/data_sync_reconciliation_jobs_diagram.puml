@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Sync & Reconciliation Jobs container

Container_Boundary(data_sync_reconciliation_jobs_container, "Data Sync & Reconciliation Jobs") {
    Component(data_sync_reconciliation_jobs, "Data Sync & Reconciliation Jobs", "Azure Container Apps (Jobs)", "Synchronizes data and reconciles state between the modern Azure platform and the legacy on-premise mainframe, guaranteeing zero data loss or duplication.")
    Component(cobol_db2_mainframe_system_of_record, "COBOL/DB2 Mainframe System of Record", "COBOL / DB2", "Legacy on-premise system of record for insurance claims processing.")
    Component(azure_service_bus_dead_letter_queues_dlq, "Azure Service Bus & Dead-Letter Queues (DLQ)", "Azure Service Bus (AMQP)", "Enables reliable asynchronous messaging and dead-letter queueing for failed events.")
    Component(azure_key_vault_managed_identities, "Azure Key Vault & Managed Identities", "Azure Key Vault & Managed Identities (HTTPS)", "Secures credentials and retrieves database credentials dynamically without hardcoding secrets.")
    Component(azure_monitor_azure_sentinel, "Azure Monitor & Azure Sentinel", "Azure Monitor (HTTPS)", "Streams drift metrics and reconciliation logs.")
}

Rel(azure_service_bus_dead_letter_queues_dlq, data_sync_reconciliation_jobs, "Triggers sync and processing queues", "AMQP")
Rel(data_sync_reconciliation_jobs, cobol_db2_mainframe_system_of_record, "Syncs data and reconciles state across hybrid boundary", "mTLS with certificate pinning")
Rel(data_sync_reconciliation_jobs, azure_key_vault_managed_identities, "Retrieves database credentials dynamically", "HTTPS / Managed Identity")
Rel(data_sync_reconciliation_jobs, azure_monitor_azure_sentinel, "Streams drift metrics and reconciliation logs", "HTTPS")

@enduml