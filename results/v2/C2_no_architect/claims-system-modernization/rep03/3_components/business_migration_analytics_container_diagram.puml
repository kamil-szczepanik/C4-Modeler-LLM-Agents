@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Business/Migration Analytics Container", "Business/Migration Analytics Container") {
    Component(DashboardUI_Service, "Dashboard UI Service", "Python, Azure Analytics", "Serves migration dashboards and financial risk reports to Business Operations Managers and Migration Leads.")
    Component(MigrationTelemetry_IngestionEngine, "Migration Telemetry Ingestion Engine", "Python", "Ingests event streams from Azure Service Bus to process migration telemetry without direct mainframe polling.")
    Component(DryRunSimulation_AnalyticsProcessor, "Dry-Run Simulation & Analytics Processor", "Python", "Processes data for migration velocity, zero-loss reconciliation, rollback readiness, and dry-run simulation results.")
}

Rel(DashboardUI_Service, MigrationTelemetry_IngestionEngine, "Queries processed migration metrics")
Rel(MigrationTelemetry_IngestionEngine, DryRunSimulation_AnalyticsProcessor, "Passes ingested event streams for analysis")

@enduml