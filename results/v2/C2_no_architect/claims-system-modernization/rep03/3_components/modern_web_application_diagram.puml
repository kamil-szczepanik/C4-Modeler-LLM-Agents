@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Modern_Web_Application", "Modern Web Application") {
    Component(Claim_Submission_and_Management_Controller, "Claim Submission and Management Controller", "ASP.NET Core Controller", "Handles HTTP requests from customers and brokers for submitting and managing claims.")
    Component(Adjuster_Dashboard_Controller, "Adjuster Dashboard Controller", "ASP.NET Core Controller", "Serves the React frontend UI and handles API calls for claims adjusters.")
    Component(Legacy_Integration_Service, "Legacy Integration Service", "ASP.NET Core Service", "Manages REST and Batch API communication with the COBOL/DB2 mainframe system.")
    Component(Caching_Manager, "Caching Manager", "Azure Cache for Redis Client", "Manages low-latency caching to meet sub-2-second load times.")
    Component(Messaging_Dispatcher, "Messaging Dispatcher", "Azure Service Bus Client", "Publishes and consumes asynchronous messages for reliable hybrid integration.")
}

Rel(Claim_Submission_and_Management_Controller, Legacy_Integration_Service, "Delegates mainframe operations")
Rel(Adjuster_Dashboard_Controller, Caching_Manager, "Retrieves cached UI data")
Rel(Legacy_Integration_Service, Messaging_Dispatcher, "Sends asynchronous hybrid integration events")

@enduml