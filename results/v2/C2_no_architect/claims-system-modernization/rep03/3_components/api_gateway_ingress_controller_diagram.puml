@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_boundary, "API Gateway / Ingress Controller") {
    Component(Traffic_Splitter_and_Router, "Traffic Splitter and Router", "Azure Application Gateway / NGINX", "Handles dynamic traffic splitting between the modern cloud application and the legacy mainframe system.")
    Component(Circuit_Breaker, "Circuit Breaker", "NGINX / Envoy", "Protects downstream services and manages failures during legacy mainframe communications.")
    Component(Edge_JWT_Validator, "Edge JWT Validator", "Azure Active Directory SSO / OAuth2", "Validates JSON Web Tokens at the edge and enforces security policies.")
}

Rel(Edge_JWT_Validator, Traffic_Splitter_and_Router, "Authenticates incoming requests before routing")
Rel(Traffic_Splitter_and_Router, Circuit_Breaker, "Routes filtered traffic through")

@enduml