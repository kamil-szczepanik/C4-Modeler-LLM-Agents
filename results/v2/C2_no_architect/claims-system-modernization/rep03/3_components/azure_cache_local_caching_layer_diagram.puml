@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Cache / Local Caching Layer container

Container_Boundary(azure_cache_container, "Azure Cache / Local Caching Layer") {
    Component(redis_client, "Redis Cache Client", "StackExchange.Redis", "Manages TCP connections, serialization, and communication with Azure Cache for Redis.")
    Component(cache_manager, "Cache Manager", "C# / .NET Memory Management", "Encapsulates caching logic, expiration policies, and fallback strategies for claims data.")
}

Rel(cache_manager, redis_client, "Invokes read and write operations", "Function Call")

@enduml