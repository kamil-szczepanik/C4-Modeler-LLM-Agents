@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Insurance Claims Modernization system

Person(Customer, "Customer", "Submits claims online.")
Person(Broker, "Broker", "Submits claims on behalf of customers.")
Person(Claims_Adjuster, "Claims Adjuster", "Accesses adjuster screens to manage and process claims.")
Person(Business_Operations_Manager, "Business Operations Manager", "Manages business operations and views analytics.")
Person(Migration_Administrator, "Migration Administrator", "Administers incremental claim-type migrations.")

System_Ext(COBOL_DB2_Mainframe_System_of_Record, "COBOL/DB2 Mainframe System of Record", "Legacy on-premises system of record.")

System_Boundary(Insurance_Claims_Modernization_system, "Insurance Claims Modernization system") {
    Container(Modern_Web_Application, "Modern Web Application", "React, ASP.NET Core", "Customer/broker portal and adjuster UI for online claim submissions and workflows.")
    Container(API_Gateway___Ingress_Controller, "API Gateway / Ingress Controller", "Azure Application Gateway / NGINX", "Routes external traffic to internal containerized services.")
    Container(Azure_Service_Bus, "Azure Service Bus", "Azure Service Bus", "Asynchronous message broker for buffering and isolating mainframe latency.")
    Container(Azure_Cache___Local_Caching_Layer, "Azure Cache / Local Caching Layer", "Azure Cache for Redis", "Provides performance isolation and fast data retrieval.")
    Container(Business_Migration_Analytics_Container, "Business/Migration Analytics Container", "Python, Azure Analytics", "Handles business and migration analytics.")
    Container(Data_Sync___Reconciliation_Jobs, "Data Sync & Reconciliation Jobs", "Azure Container Instances / Functions", "Synchronizes data and reconciles state with the legacy mainframe.")
}

Rel(Customer, API_Gateway___Ingress_Controller, "Submits claims and interacts with portal", "HTTPS/OAuth2")
Rel(Broker, API_Gateway___Ingress_Controller, "Submits claims on behalf of customers", "HTTPS/OAuth2")
Rel(Claims_Adjuster, API_Gateway___Ingress_Controller, "Interacts with adjuster UI", "HTTPS, RBAC, Azure AD SSO")
Rel(Business_Operations_Manager, API_Gateway___Ingress_Controller, "Accesses business dashboards", "HTTPS")
Rel(Migration_Administrator, API_Gateway___Ingress_Controller, "Manages migrations", "HTTPS")
Rel(API_Gateway___Ingress_Controller, Modern_Web_Application, "Forwards HTTP requests", "HTTP/REST")
Rel(Modern_Web_Application, Azure_Service_Bus, "Publishes asynchronous messages", "AMQP / Azure Service Bus Protocol")
Rel(Modern_Web_Application, Azure_Cache___Local_Caching_Layer, "Reads and writes cached data", "TCP / Redis Protocol")
Rel(Data_Sync___Reconciliation_Jobs, COBOL_DB2_Mainframe_System_of_Record, "Syncs data across hybrid trust boundary", "mTLS with certificate pinning")
Rel(Azure_Service_Bus, Data_Sync___Reconciliation_Jobs, "Triggers sync and processing queues", "AMQP")

@enduml