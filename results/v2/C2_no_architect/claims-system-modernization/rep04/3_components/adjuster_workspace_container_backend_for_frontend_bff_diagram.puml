@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Adjuster Workspace Container & Backend-For-Frontend (BFF) container

Container_Boundary(bff_boundary, "Adjuster Workspace Container & Backend-For-Frontend (BFF)") {
    Component(WorkspaceUIController, "Workspace UI Controller", "Node.js / Express / OpenID Connect", "Enforces OIDC Single Sign-On, RBAC at the BFF boundary, and serves the web interface for claims adjusters.")
    Component(ClaimStateCachingService, "Claim State & Caching Service", "Node.js Service Module", "Reads cached claim states and session data from Azure Cache for Redis to meet sub-2-second screen load requirements.")
    Component(IntegrationRoutingService, "Integration Routing Service", "Node.js Service Module", "Routes microservice requests to the Azure API Gateway / Integration Container over internal Azure VNets.")
    Component(AuditTelemetryLogger, "Audit & Telemetry Logger", "Node.js SDK / Azure Monitor", "Streams tamper-evident audit logs to WORM-enabled Azure Storage and sends distributed tracing data to Application Insights.")
    Component(SecretsManagementClient, "Secrets Management Client", "Azure Managed Identities SDK", "Retrieves secrets and credentials securely from Azure Key Vault.")
}

System_Ext(AzureCacheForRedis, "Azure Cache for Redis", "PaaS", "Reads/Writes session data and claim states")
System_Ext(AzureApiGateway, "Azure API Gateway / Integration Container", "Azure Container Apps", "Routes microservice requests")
System_Ext(AzureKeyVault, "Azure Key Vault", "Azure PaaS", "Retrieves secrets and credentials")
System_Ext(AzureStorage, "Azure Storage", "WORM-enabled Azure Storage", "Streams tamper-evident audit logs")

Rel(WorkspaceUIController, ClaimStateCachingService, "Queries cached claim states", "Redis Protocol over TLS")
Rel(WorkspaceUIController, IntegrationRoutingService, "Dispatches backend API requests", "Internal Azure VNets")
Rel(ClaimStateCachingService, AzureCacheForRedis, "Reads/Writes session data and claim states", "Redis Protocol over TLS")
Rel(IntegrationRoutingService, AzureApiGateway, "Routes microservice requests", "Internal Azure VNets")
Rel(SecretsManagementClient, AzureKeyVault, "Retrieves secrets and credentials", "Azure Managed Identities")
Rel(AuditTelemetryLogger, AzureStorage, "Streams tamper-evident audit logs", "HTTPS/TLS 1.3")

@enduml