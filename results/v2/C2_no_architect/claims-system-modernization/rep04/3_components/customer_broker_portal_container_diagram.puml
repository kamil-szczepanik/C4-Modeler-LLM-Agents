@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Customer & Broker Portal Container container

Container_Boundary("Customer & Broker Portal Container", "Customer & Broker Portal Container") {
    Component("Portal UI & API Controller", "Portal UI & API Controller", "Azure Container Apps (ACA)", "Handles incoming HTTPS requests from end customers and brokers for claim submissions and draft management.")
    Component("Draft & Session Manager", "Draft & Session Manager", "Azure Cache for Redis", "Manages temporary claim drafts and session tokens using secure, isolated ephemeral storage.")
    Component("Async Queue Publisher", "Async Queue Publisher", "Azure Service Bus & AMQP", "Asynchronously queues claim submissions to decouple portal submissions from legacy mainframe latency.")
    Component("Integration Gateway Connector", "Integration Gateway Connector", "Internal Azure VNets", "Routes requests from the portal to internal microservices via the Azure API Gateway / Integration Container.")
    Component("Secrets Management Client", "Secrets Management Client", "Azure Key Vault & Azure Managed Identities", "Retrieves cryptographic secrets securely for authentication and service connections.")
}

Rel("Portal UI & API Controller", "Draft & Session Manager", "Store temporary claim drafts and session tokens", "TLS 1.3 / VNet Integration")
Rel("Portal UI & API Controller", "Async Queue Publisher", "Asynchronously queue claim submissions", "AMQP / Azure Managed Identities")
Rel("Portal UI & API Controller", "Integration Gateway Connector", "Route requests to internal microservices", "Internal Azure VNets")
Rel("Portal UI & API Controller", "Secrets Management Client", "Retrieve cryptographic secrets", "Azure Managed Identities")

@enduml