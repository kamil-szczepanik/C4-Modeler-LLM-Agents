@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Adjuster_Workspace_Container_BFF, "Adjuster Workspace Container & BFF", "Backend-for-Frontend component for the Adjuster Workspace.")

Container_Boundary(Azure_Cache_for_Redis, "Azure Cache for Redis") {
    Component(Redis_Session_Store, "Redis Session Store", "Azure Cache for Redis (Premium Tier)", "Offloads session states and reference data to achieve sub-2s screen loads while protecting the mainframe.")
    Component(Redis_Data_Cache, "Redis Data Cache", "Azure Cache for Redis (Premium Tier)", "Caches read-heavy claims data to minimize direct calls to the legacy mainframe.")
}

Rel(Adjuster_Workspace_Container_BFF, Redis_Data_Cache, "Queries for read-heavy caching and session state", "Redis Protocol")
@enduml