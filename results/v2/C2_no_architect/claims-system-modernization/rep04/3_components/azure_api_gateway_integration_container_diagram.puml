@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(azure_api_gateway_integration_container, "Azure API Gateway / Integration Container") {
    Component(StranglerFigRouter, "Strangler Fig Router", "Azure API Gateway Policy / Routing Engine", "Routes traffic between the modern cloud environment and the legacy mainframe, executing the strangler fig pattern for gradual claim migration.")
    Component(AntiCorruptionLayerACL, "Anti-Corruption Layer (ACL)", "Integration Container / Middleware", "Translates modern domain models and requests into legacy-compatible formats for the on-premises mainframe.")
    Component(SecurityandAuthenticationEnforcer, "Security and Authentication Enforcer", "OAuth 2.0 / OIDC / mTLS", "Enforces OAuth 2.0 / OIDC authentication for incoming requests and secures outgoing traffic to the mainframe using mTLS and TLS 1.3.")
}

Rel(StranglerFigRouter, AntiCorruptionLayerACL, "Forwards legacy-bound traffic for model translation")
Rel(SecurityandAuthenticationEnforcer, StranglerFigRouter, "Authenticates and authorizes incoming requests before routing")

@enduml