@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(azure_key_vault, "Azure Key Vault") {
    Component(Secrets Management Engine, "Secrets Management Engine", "Azure Key Vault Service", "Stores and manages sensitive configuration, connection strings, and API keys.")
    Component(Cryptographic Keys Manager, "Cryptographic Keys Manager", "Azure Key Vault HSM", "Manages encryption keys used for data protection across the Hybrid Insurance Claims Modernization Platform.")
    Component(Access Control and Audit Service, "Access Control and Audit Service", "Azure RBAC & Azure Monitor", "Handles authentication, authorization, and logging for all secret and key retrieval requests.")
}

Rel(Secrets Management Engine, Cryptographic Keys Manager, "Utilizes keys for envelope encryption of secrets", "")
Rel(Access Control and Audit Service, Secrets Management Engine, "Validates permissions before granting access", "")

@enduml