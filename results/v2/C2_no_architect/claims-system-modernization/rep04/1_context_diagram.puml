@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(End_Customers_Brokers, "End Customers & Brokers", "Users submitting claims online.")
Person(Claims_Adjusters, "Claims Adjusters", "Users managing claims via the new web application.")
Person(Operations_Finance_Teams, "Operations & Finance Teams", "Users monitoring regulatory compliance and consistency.")
System(Hybrid_Insurance_Claims_Modernization_Platform, "Hybrid Insurance Claims Modernization Platform", "A hybrid insurance claims modernization platform that gradually replaces a legacy COBOL/DB2 mainframe with a modern Azure-hosted application while ensuring zero data loss and maintaining the legacy system of record.")
System_Ext(On_Premises_COBOL_DB2_Mainframe, "On-Premises COBOL/DB2 Mainframe", "System of record during the 3-year migration.")

Rel(End_Customers_Brokers, Hybrid_Insurance_Claims_Modernization_Platform, "Submit claims online", "HTTPS/TLS 1.3")
Rel(Claims_Adjusters, Hybrid_Insurance_Claims_Modernization_Platform, "Manage claims via the new web application", "HTTPS/TLS 1.3")
Rel(Operations_Finance_Teams, Hybrid_Insurance_Claims_Modernization_Platform, "Monitor regulatory compliance and consistency", "HTTPS")
Rel(Hybrid_Insurance_Claims_Modernization_Platform, On_Premises_COBOL_DB2_Mainframe, "Process legacy claims and integrate with system of record", "mTLS over hybrid VPN/ExpressRoute")

@enduml