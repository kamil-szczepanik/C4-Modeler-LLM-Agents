@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Hybrid Insurance Claims Modernization Platform

Person(End_Customers_Brokers, "End Customers & Brokers", "Users submitting claims online.")
Person(Claims_Adjusters, "Claims Adjusters", "Users managing claims via the new web application.")
Person(Operations_Finance_Teams, "Operations & Finance Teams", "Users monitoring regulatory compliance and consistency.")

System_Ext(On_Premises_COBOL_DB2_Mainframe, "On-Premises COBOL/DB2 Mainframe", "System of record during the 3-year migration.")

System_Boundary(Hybrid_Insurance_Claims_Modernization_Platform, "Hybrid Insurance Claims Modernization Platform") {
    Container(Azure_API_Gateway_Integration_Container, "Azure API Gateway / Integration Container", "Azure API Gateway", "Anti-Corruption Layer that manages hybrid routing, OAuth 2.0 / OIDC authentication, and the strangler fig pattern.")
    Container(Customer_Broker_Portal_Container, "Customer & Broker Portal Container", "Azure Container Apps (ACA) / Managed Kubernetes (AKS)", "Provides online claim submissions for end customers and brokers.")
    Container(Adjuster_Workspace_Container_Backend_For_Frontend_BFF, "Adjuster Workspace Container & Backend-For-Frontend (BFF)", "Azure Container Apps (ACA) / Managed Kubernetes (AKS)", "Fast adjuster workflows and backend-for-frontend supporting adjuster screens.")
    ContainerDb(Azure_Cache_for_Redis, "Azure Cache for Redis", "Azure Cache for Redis (PaaS)", "Offloads session state and read-heavy caching to meet low-latency requirements.")
    Container(Azure_Key_Vault, "Azure Key Vault", "Azure Key Vault", "Secures secrets and configuration data accessed via Azure Managed Identities.")
}

Rel(End_Customers_Brokers, Customer_Broker_Portal_Container, "Submit claims online", "HTTPS/TLS 1.3")
Rel(Claims_Adjusters, Adjuster_Workspace_Container_Backend_For_Frontend_BFF, "Manage claims via adjuster workspace", "HTTPS/TLS 1.3")
Rel(Operations_Finance_Teams, Azure_API_Gateway_Integration_Container, "Monitor regulatory compliance and system operations", "HTTPS")
Rel(Customer_Broker_Portal_Container, Azure_API_Gateway_Integration_Container, "Routes requests to internal microservices", "Internal Azure Virtual Networks (VNets)")
Rel(Adjuster_Workspace_Container_Backend_For_Frontend_BFF, Azure_API_Gateway_Integration_Container, "Routes requests to internal microservices", "Internal Azure Virtual Networks (VNets)")
Rel(Adjuster_Workspace_Container_Backend_For_Frontend_BFF, Azure_Cache_for_Redis, "Queries for read-heavy caching and session state", "Redis Protocol")
Rel(Azure_API_Gateway_Integration_Container, On_Premises_COBOL_DB2_Mainframe, "Integrates with legacy system of record", "mTLS and TLS 1.3")
Rel(Customer_Broker_Portal_Container, Azure_Key_Vault, "Authenticates and retrieves secrets", "Azure Managed Identities")
Rel(Adjuster_Workspace_Container_Backend_For_Frontend_BFF, Azure_Key_Vault, "Authenticates and retrieves secrets", "Azure Managed Identities")

@enduml