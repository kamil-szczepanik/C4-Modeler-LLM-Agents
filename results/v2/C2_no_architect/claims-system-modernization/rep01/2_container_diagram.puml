@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Modern Azure-Hosted Claims Platform

Person(Customers, "Customers", "External users who submit insurance claims online.")
Person(Brokers, "Brokers", "External intermediaries who submit and manage claims on behalf of customers.")
Person(Claims Adjusters, "Claims Adjusters", "Internal users who execute rapid adjuster workflows.")
Person(Business Operations Managers, "Business Operations Managers", "Personnel responsible for managing business operations via the operations portal.")
Person(System Administrators, "System Administrators", "Personnel responsible for system administration and monitoring.")

System_Ext(On-Premises COBOL/DB2 Mainframe System of Record, "On-Premises COBOL/DB2 Mainframe System of Record", "Legacy on-premises mainframe system handling core operations and historical records.")
System_Ext(Azure Active Directory (Entra ID), "Azure Active Directory (Entra ID)", "Identity and Access Management system providing authentication and role-based access control.")

System_Boundary(Modern Azure-Hosted Claims Platform, "Modern Azure-Hosted Claims Platform") {
    Container(Customer/Broker Web App, "Customer/Broker Web App", "Azure Container Apps", "Web application allowing customers and brokers to submit claims online.")
    Container(Claims Adjuster Web App, "Claims Adjuster Web App", "Azure Container Apps", "Web application enabling claims adjusters to perform rapid claims processing.")
    Container(API Gateway, "API Gateway", "Azure Container Apps", "Entry point managing and routing incoming API requests.")
    Container(Integration/Messaging Container, "Integration/Messaging Container", "Azure Service Bus", "Asynchronously synchronizes data between Azure and the legacy mainframe.")
    Container(Operations Portal Container, "Operations Portal Container", "Azure Container Apps", "Provides management and operational insights for business managers.")
    Container(Audit & Reconciliation Container, "Audit & Reconciliation Container", "Azure Container Apps", "Continuously verifies state consistency against the DB2 mainframe.")
    ContainerDb(Azure SQL, "Azure SQL", "Azure SQL Database with TDE and column-level PII encryption", "Managed relational storage for application data.")
}

Rel(Customers, Customer/Broker Web App, "Accesses for online claim submission", "HTTPS / OpenID Connect / OAuth2")
Rel(Brokers, Customer/Broker Web App, "Accesses for online claim submission and management", "HTTPS / OpenID Connect / OAuth2")
Rel(Customers, API Gateway, "Sends API requests", "HTTPS / OpenID Connect / OAuth2")
Rel(Brokers, API Gateway, "Sends API requests", "HTTPS / OpenID Connect / OAuth2")
Rel(Claims Adjusters, Claims Adjuster Web App, "Interacts for claims workflows with identity delegated to Azure AD", "HTTPS")
Rel(Business Operations Managers, Operations Portal Container, "Accesses for business operations management", "HTTPS")
Rel(System Administrators, Operations Portal Container, "Accesses for system administration", "HTTPS")
Rel(Customer/Broker Web App, API Gateway, "Routes requests through", "mTLS / Azure Entra Managed Identities")
Rel(Claims Adjuster Web App, API Gateway, "Routes requests through", "mTLS / Azure Entra Managed Identities")
Rel(API Gateway, Azure SQL, "Reads and writes relational data", "TDS / Encrypted Connection")
Rel(Customer/Broker Web App, Integration/Messaging Container, "Publishes asynchronous messages", "Azure Service Bus Protocol")
Rel(Claims Adjuster Web App, Integration/Messaging Container, "Publishes asynchronous messages", "Azure Service Bus Protocol")
Rel(Integration/Messaging Container, On-Premises COBOL/DB2 Mainframe System of Record, "Synchronizes data asynchronously", "Azure ExpressRoute with IPSec encryption")
Rel(Audit & Reconciliation Container, On-Premises COBOL/DB2 Mainframe System of Record, "Continuously verifies state consistency", "Azure ExpressRoute with IPSec encryption")
Rel(Audit & Reconciliation Container, Azure SQL, "Verifies state consistency against database", "Encrypted Connection")
Rel(Claims Adjuster Web App, Azure Active Directory (Entra ID), "Authenticates users", "OAuth 2.0 / OIDC")
Rel(Customer/Broker Web App, Azure Active Directory (Entra ID), "Authenticates users", "OAuth 2.0 / OIDC")

@enduml