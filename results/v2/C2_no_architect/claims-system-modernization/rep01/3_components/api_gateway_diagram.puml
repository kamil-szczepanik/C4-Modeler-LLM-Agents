@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Traffic_Router, "Traffic Router", "Azure Container Apps Native Traffic Splitting", "Dynamically routes claims traffic between Azure Microservices and the legacy on-premises mainframe based on migration status.")
    Component(Security_Validation_Engine, "Security & Validation Engine", "OpenAPI / JSON Schema Validation & Azure WAF Integration", "Enforces payload sanitization, WAF rules, and mitigates OWASP Top 10 threats at the gateway layer.")
    Component(Authentication_Handler, "Authentication Handler", "Azure Active Directory / Entra ID & JWT", "Validates JWT tokens and handles Single Sign-On (SSO) and mTLS with Managed Identities for internal users.")
}

Rel(Security_Validation_Engine, Traffic_Router, "Forwards sanitized and authenticated traffic", "")
Rel(Authentication_Handler, Traffic_Router, "Provides validated security context for routing", "")

@enduml