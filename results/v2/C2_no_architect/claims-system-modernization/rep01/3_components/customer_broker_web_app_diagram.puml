@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Customer/Broker Web App container

Container_Boundary(web_app, "Customer/Broker Web App") {
    Component(Claim Submission Controller, "Claim Submission Controller", "Azure Container Apps / Web Framework", "Handles incoming HTTP requests from customers and brokers for submitting and tracking claims.")
    Component(Photo Upload Handler, "Photo Upload Handler", "Azure Container Apps / SAS Token Generator", "Manages direct photo uploads to Azure Blob Storage using SAS tokens.")
    Component(Draft Claims Manager, "Draft Claims Manager", "Azure Container Apps / Entity Framework", "Persists and retrieves draft claims using Azure SQL Database.")
    Component(Messaging Publisher, "Messaging Publisher", "Azure Service Bus SDK", "Publishes asynchronous messages to the Integration/Messaging Container.")
}

System_Ext(api_gateway, "API Gateway", "Routes requests [mTLS / Azure Entra Managed Identities]")
System_Ext(azure_blob, "Azure Blob Storage", "Uploads accident photos [HTTPS / SAS Tokens]")
System_Ext(azure_sql, "Azure SQL Database", "Persists draft claims [TDS / TLS 1.3]")
System_Ext(messaging_container, "Integration/Messaging Container", "Publishes async messages [Azure Service Bus Protocol]")
System_Ext(entra_id, "Azure Active Directory (Entra ID)", "Authenticates users [OAuth 2.0 / OIDC]")

Rel(Claim Submission Controller, api_gateway, "Routes requests", "mTLS / Azure Entra Managed Identities")
Rel(Photo Upload Handler, azure_blob, "Uploads accident photos", "HTTPS / SAS Tokens")
Rel(Draft Claims Manager, azure_sql, "Persists draft claims", "TDS / TLS 1.3")
Rel(Messaging Publisher, messaging_container, "Publishes async messages", "Azure Service Bus Protocol")
Rel(Claim Submission Controller, entra_id, "Authenticates users", "OAuth 2.0 / OIDC")
@enduml