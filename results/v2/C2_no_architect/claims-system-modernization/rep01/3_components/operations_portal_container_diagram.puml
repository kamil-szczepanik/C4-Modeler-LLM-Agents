@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Operations Portal Container container

Container_Boundary(operations_portal_container, "Operations Portal Container") {
    Component(migration_dashboard_ui, "Migration Dashboard UI", "Azure Container Apps (Frontend)", "Provides management oversight, migration dashboards, and SLA metrics to Business Operations Managers.")
    Component(administration_rollback_controller, "Administration & Rollback Controller", "Azure Container Apps (Backend)", "Executes emergency rollbacks and manages system configurations for System Administrators.")
    Component(telemetry_audit_service, "Telemetry & Audit Service", "Azure Container Apps (Background Service)", "Forwards telemetry, traces, and anonymized audit logs to Azure Application Insights.")
}

System_Ext(azure_sql_database, "Azure SQL Database", "Stores in-flight claim data and audit logs.")
System_Ext(on_premises_cobol_db2_mainframe, "On-Premises COBOL/DB2 Mainframe", "Legacy system of record.")
System_Ext(azure_application_insights_azure_monitor, "Azure Application Insights & Azure Monitor", "Observability platform.")

Rel(migration_dashboard_ui, azure_sql_database, "Queries in-flight claim data and audit logs", "TDS over TLS 1.3 using Azure Managed Identities")
Rel(administration_rollback_controller, on_premises_cobol_db2_mainframe, "Fetches legacy system metrics and batch status", "secure VPN/ExpressRoute with circuit breakers")
Rel(telemetry_audit_service, azure_application_insights_azure_monitor, "Forwards telemetry, traces, and anonymized audit logs", "HTTPS")

@enduml