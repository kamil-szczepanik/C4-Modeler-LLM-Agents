@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit & Reconciliation Container container

Container_Boundary(audit_reconciliation_container, "Audit & Reconciliation Container") {
    Component(Transaction_Log_Reader, "Transaction Log Reader", "Azure Container Apps Jobs", "Continuously reads transaction logs from the on-premises COBOL/DB2 mainframe to ensure state consistency.")
    Component(State_Comparator, "State Comparator", "Azure Container Apps Jobs", "Queries Azure SQL and compares state against mainframe transaction logs.")
    Component(Exception_Handler, "Exception Handler", "Azure Container Apps Jobs", "Processes drift alerts and handles manual exception-resolution workflows triggered by the Operations Portal.")
    Component(Audit_Logger, "Audit Logger", "Azure Storage with WORM & Azure Diagnostics", "Ships audit logs, drift alerts, and WORM immutability data to Azure Monitor and Sentinel.")
}

Rel(Transaction_Log_Reader, State_Comparator, "Passes extracted transaction state for comparison")
Rel(State_Comparator, Exception_Handler, "Triggers reconciliation exceptions upon state drift")
Rel(Transaction_Log_Reader, Audit_Logger, "Sends logs and drift data")
Rel(State_Comparator, Audit_Logger, "Sends comparison and audit results")

@enduml