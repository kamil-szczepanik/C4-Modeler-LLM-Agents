@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Adjuster Web App container

Container_Boundary(claims_adjuster_web_app, "Claims Adjuster Web App") {
    Component(ClaimsAdjusterUIController, "Claims Adjuster UI Controller", "Azure Container Apps / Modern Web Frontend", "Provides a modern interface for claims handlers to process policies and access adjuster workflows.")
    Component(AuthenticationAuthorizationManager, "Authentication & Authorization Manager", "Azure Active Directory (Entra ID) / JWT / RBAC", "Validates OIDC / OAuth 2.0 authentication tokens and handles fine-grained application-level authorization based on adjuster permissions.")
    Component(ClaimsProcessingRouter, "Claims Processing Router", "HTTPS / mTLS / Azure Entra Managed Identities", "Routes claims processing requests securely to the API Gateway.")
    Component(EventPublisher, "Event Publisher", "Azure Service Bus Protocol", "Publishes asynchronous claim events to the Integration/Messaging Container.")
    Component(AuditLogger, "Audit Logger", "HTTPS / TLS 1.3 / OpenTelemetry", "Streams tamper-evident audit logs and handles distributed tracing via Azure Application Insights.")
}

Rel(ClaimsAdjusterUIController, AuthenticationAuthorizationManager, "Validates authentication tokens and verifies permissions", "HTTPS / OAuth 2.0")
Rel(ClaimsAdjusterUIController, ClaimsProcessingRouter, "Routes claims processing requests", "mTLS / Azure Entra Managed Identities")
Rel(ClaimsAdjusterUIController, EventPublisher, "Publishes asynchronous claim events", "Azure Service Bus Protocol")
Rel(ClaimsAdjusterUIController, AuditLogger, "Streams tamper-evident audit logs", "HTTPS / TLS 1.3")

@enduml