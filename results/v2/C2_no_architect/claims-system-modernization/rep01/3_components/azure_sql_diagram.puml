@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure SQL container

Container_Boundary(azure_sql, "Azure SQL") {
    Component(Relational_Storage_Engine, "Relational Storage Engine", "Azure SQL Database Engine", "Manages core transactional storage with Transparent Data Encryption (TDE).")
    Component(PII_Encryption_Service, "PII Encryption Service", "Always Encrypted with Column-Level Encryption", "Protects sensitive customer and claim data using Customer-Managed Keys in Azure Key Vault.")
    Component(Dynamic_Data_Masking_Engine, "Dynamic Data Masking Engine", "SQL Dynamic Data Masking", "Obfuscates sensitive data for unauthorized or non-privileged users in real time.")
    Component(Readable_Secondary_Replica, "Readable Secondary Replica", "Azure SQL Secondary Replica", "Isolates analytical workloads and operations metrics reporting from transactional processing.")
}

Rel(Relational_Storage_Engine, PII_Encryption_Service, "Applies column-level PII encryption and decryption")
Rel(Relational_Storage_Engine, Dynamic_Data_Masking_Engine, "Applies data masking rules to result sets")
Rel(Relational_Storage_Engine, Readable_Secondary_Replica, "Replicates transactional data for analytics")

@enduml