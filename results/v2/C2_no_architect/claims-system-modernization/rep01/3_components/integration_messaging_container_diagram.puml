@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Integration/Messaging Container", "Integration/Messaging Container") {
    Component("Message Publisher", "Message Publisher", "Azure Service Bus SDK", "Publishes asynchronous claim messages received from the API Gateway to the message queue.")
    Component("Message Consumer & Router", "Message Consumer & Router", "Azure Container Apps Background Service", "Consumes messages from Azure Service Bus, handling retries, dead-letter queues, and exponential backoff.")
    Component("Mainframe Sync Adapter", "Mainframe Sync Adapter", "Custom .NET Core Worker Service over Azure ExpressRoute", "Synchronizes processed claim data securely with the on-premises COBOL/DB2 mainframe system of record.")
}

Rel("Message Publisher", "Message Consumer & Router", "Queues and dispatches asynchronous messages", "Azure Service Bus Protocol")
Rel("Message Consumer & Router", "Mainframe Sync Adapter", "Triggers data synchronization for mainframe processing", "Internal Messaging")

@enduml