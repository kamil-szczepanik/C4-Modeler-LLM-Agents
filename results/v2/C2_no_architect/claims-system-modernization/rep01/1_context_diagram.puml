@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(CustomersAndBrokers, "Customers and Brokers", "External users who interact with the platform for online claim submission.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal users who use the platform for rapid adjuster workflows.")
Person(BusinessOperationsManagersAndSystemAdministrators, "Business Operations Managers and System Administrators", "Personnel responsible for managing business operations and system administration.")

System(ModernAzureHostedClaimsPlatform, "Modern Azure-Hosted Claims Platform", "Gradually replaces a 30-year-old COBOL/DB2 mainframe claims system with a modern Azure-hosted platform while maintaining uninterrupted processing, enabling online claim submission, rapid adjuster workflows, and incremental claim-type migration.")

System_Ext(OnPremisesCOBOLDB2MainframeSystemofRecord, "On-Premises COBOL/DB2 Mainframe System of Record", "Legacy 30-year-old mainframe system handling core processing and historical records.")
System_Ext(AzureADEntraID, "Azure AD (Entra ID)", "Identity and Access Management system providing authentication and role-based access control.")

Rel(CustomersAndBrokers, ModernAzureHostedClaimsPlatform, "Interact with the Azure Web Application for online claim submission", "HTTPS / TLS 1.3")
Rel(ClaimsAdjusters, ModernAzureHostedClaimsPlatform, "Use the Azure Web Application for claims processing", "OIDC / OAuth 2.0 / HTTPS")
Rel(ModernAzureHostedClaimsPlatform, OnPremisesCOBOLDB2MainframeSystemofRecord, "Communicates via integration patterns for data synchronization and processing", "mTLS / Asynchronous Outbox / Hybrid Network")
Rel(ModernAzureHostedClaimsPlatform, AzureADEntraID, "Authenticates users and validates access tokens", "OAuth 2.0 / OIDC")

@enduml