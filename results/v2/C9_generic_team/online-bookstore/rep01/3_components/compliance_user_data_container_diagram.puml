@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(compliance_user_data_container, "Compliance/User Data Container") {
    Component(UserDataRepository, "User Data Repository", "AWS RDS / Aurora", "Segregated database storing sensitive consumer information with multi-region replication and database-per-service isolation.")
    Component(CryptographicErasureEngine, "Cryptographic Erasure Engine", "AWS KMS", "Manages cryptographic keys and executes cryptographic erasure to meet GDPR and CCPA mandates.")
}

Rel(CryptographicErasureEngine, UserDataRepository, "Provides cryptographic keys and encryption-at-rest for sensitive records", "HTTPS")

@enduml