@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Order & Checkout Service container

Container_Boundary(order_checkout_service, "Order & Checkout Service") {
    Component(api_layer, "API Layer", "Java/Spring Boot or Node.js", "Exposes REST/gRPC endpoints for routing order and checkout requests from the API Gateway.")
    Component(application_layer, "Application Layer (Saga Orchestrators)", "Java/Spring Boot or Node.js with Orchestration-based Saga Pattern", "Orchestrates distributed transactions across microservices and external providers.")
    Component(domain_layer, "Domain Layer (Checkout State Machines)", "Java/Spring Boot or Node.js", "Manages checkout state transitions and domain logic.")
    Component(infrastructure_layer, "Infrastructure Layer (Persistence, External API Adapters)", "Database-per-Service, TLS, HTTPS, gRPC adapters", "Handles data persistence and communication with external systems like Payment Gateway, Shipping Providers, and Tax Calculation Service.")
    Component(idempotency_ledger, "Idempotency Ledger (Redis/ElastiCache)", "Amazon ElastiCache (Redis)", "Ensures idempotency to eliminate double-charges and guarantee transaction safety.")
    Component(message_outbox, "Message Outbox", "Outbox Pattern with AWS SQS/SNS", "Reliably publishes domain events to the asynchronous message broker.")
    Component(health_probes, "Health/Readiness Probes", "HTTP Probes (/health/readiness, /health/liveness)", "Monitors the health and readiness of the container.")
}

System_Ext(compliance_user_data, "Compliance/User Data Container", "Stores compliance and user data.")
System_Ext(payment_gateway, "Payment Gateway", "Processes secure payments.")
System_Ext(shipping_providers, "Shipping Providers", "Arranges fulfillment.")
System_Ext(tax_calc_service, "Tax Calculation Service", "Calculates taxes.")
System_Ext(async_message_broker, "Asynchronous Message Broker", "AWS SQS/SNS")
System_Ext(notification_service, "Notification Service", "Triggers notifications.")
System_Ext(siem_provider, "SIEM Provider", "Exports structured JSON logs.")

Rel(api_layer, application_layer, "Delegates requests to")
Rel(application_layer, domain_layer, "Drives")
Rel(application_layer, idempotency_ledger, "Checks and records idempotency state via")
Rel(application_layer, message_outbox, "Writes events to")
Rel(infrastructure_layer, compliance_user_data, "Accesses order database via Database-per-Service (TCP)", "TCP")
Rel(infrastructure_layer, payment_gateway, "Processes secure payments via TLS and AWS SQS/SNS", "TLS / AWS SQS/SNS")
Rel(infrastructure_layer, shipping_providers, "Arranges fulfillment via TLS and AWS SQS/SNS", "TLS / AWS SQS/SNS")
Rel(infrastructure_layer, tax_calc_service, "Calculates taxes via gRPC/HTTPS", "gRPC / HTTPS")
Rel(message_outbox, async_message_broker, "Publishes events to")
Rel(application_layer, notification_service, "Triggers notifications via asynchronous messaging (AMQP/HTTPS)", "AMQP / HTTPS")
Rel(infrastructure_layer, siem_provider, "Exports structured JSON logs via HTTPS", "HTTPS")

@enduml