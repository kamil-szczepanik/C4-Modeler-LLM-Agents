@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Configuration/Secrets Management Container container

Container_Boundary(config_secrets_management_container, "Configuration/Secrets Management Container") {
    Component(AWS_Secrets_Manager_and_Parameter_Store, "AWS Secrets Manager and Parameter Store", "AWS Secrets Manager & Parameter Store", "Centralized secrets and configuration backend providing managed storage, encryption at rest, and automated rotation for credentials.")
    Component(Microservices_Container_Application_Layer, "Microservices Container Application Layer", "Catalog, Order, Recommendation, and Review Services", "Consumes configuration and runtime secrets for the online bookstore microservices architecture.")
    Component(In_Memory_Fallback_Cache_and_Sanitization_Middleware, "In-Memory Fallback Cache and Sanitization Middleware", "In-Memory Fallback Caches with TTL", "Maintains resilience against transient outages and sanitizes data to meet uptime and security requirements.")
    Component(CI_CD_Pipeline_Configuration_Bundler, "CI/CD Pipeline Configuration Bundler", "Version Control Repository with Cryptographically Signed Manifests", "Ensures build-phase immutability and environmental reproducibility.")
}

Rel(Microservices_Container_Application_Layer, AWS_Secrets_Manager_and_Parameter_Store, "Fetches credentials and runtime secrets", "HTTPS over AWS IAM")
Rel(Microservices_Container_Application_Layer, In_Memory_Fallback_Cache_and_Sanitization_Middleware, "Communicates via HTTP/REST for health check endpoints and utilizes fallback caching", "HTTP/REST")
Rel(AWS_Secrets_Manager_and_Parameter_Store, CI_CD_Pipeline_Configuration_Bundler, "Streams audit logs and secret access attempts to AWS CloudTrail/CloudWatch", "")

@enduml