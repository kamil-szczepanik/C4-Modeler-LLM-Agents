@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Distributed Caching Container container

System_Ext(catalog_service, "Catalog Service", "Microservice interacting with cache")
System_Ext(recommendation_service, "Recommendation Service", "Microservice interacting with cache")

Container_Boundary(distributed_caching_container, "Distributed Caching Container") {
    Component(amazon_elasticache, "Amazon ElastiCache", "Redis, Global Datasets", "Provides low-latency, in-memory caching with multi-region replication.")
    Component(redlock_mechanism, "Redlock Mechanism", "Distributed Lock Algorithm", "Prevents cache stampede issues during high-demand expiration events.")
}

Rel(catalog_service, amazon_elasticache, "Reads cached catalog data", "Redis Protocol / TCP")
Rel(recommendation_service, amazon_elasticache, "Reads cached recommendations", "Redis Protocol / TCP")
Rel(redlock_mechanism, amazon_elasticache, "Manages distributed locks for cache expiration events", "")
@enduml