@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Single Page Application (SPA) / Mobile Client container

Container_Boundary(spa_mobile_client, "Single Page Application (SPA) / Mobile Client") {
    Component(User_Interface_View, "User Interface View", "React, Angular, or Mobile Native", "Provides the visual interface for browsing catalogues, checking out, writing reviews, and viewing recommendations.")
    Component(State_Management_Offline_Storage, "State Management & Offline Storage", "Redux Persist / React Query", "Manages application state and provides offline caching capabilities for the client application.")
}

Rel(User_Interface_View, State_Management_Offline_Storage, "Reads and writes local state and cached data")

@enduml