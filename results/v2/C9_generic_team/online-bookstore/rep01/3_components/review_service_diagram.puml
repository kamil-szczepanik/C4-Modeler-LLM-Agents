@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(review_service, "Review Service") {
    Component(Moderation_Pipeline, "Moderation Pipeline", "Java/Spring Boot or Node.js", "Internal component handling automated moderation and content filtering for customer reviews.")
    Component(Data_Retention_Anonymization_Worker, "Data Retention & Anonymization Worker", "Java/Spring Boot or Node.js", "Internal worker ensuring GDPR/CCPA compliance by anonymizing and managing user data retention.")
    Component(Transactional_Outbox_Pattern, "Transactional Outbox Pattern", "Java/Spring Boot or Node.js", "Internal component ensuring reliable event publishing to the message broker.")
    Component(Bulkhead_Thread_Pools, "Bulkhead Thread Pools", "Java/Spring Boot or Node.js", "Internal component isolating failure domains and managing resource pools.")
    Component(Health_Check_Probes, "Health Check Probes", "Java/Spring Boot or Node.js", "Internal component monitoring container health and service liveness/readiness.")
    Component(Rate_Limiting_Input_Sanitization_Middleware, "Rate Limiting / Input Sanitization Middleware", "Java/Spring Boot or Node.js", "Internal middleware protecting the service from malicious payloads and volumetric traffic.")
}

System_Ext(Compliance_User_Data_Container, "Compliance/User Data Container", "Segregated Isolated Database-per-Service")

Rel(Moderation_Pipeline, Transactional_Outbox_Pattern, "Queues events for publishing")
Rel(Data_Retention_Anonymization_Worker, Compliance_User_Data_Container, "Anonymizes user records")
Rel(Rate_Limiting_Input_Sanitization_Middleware, Bulkhead_Thread_Pools, "Forwards sanitized requests")
@enduml