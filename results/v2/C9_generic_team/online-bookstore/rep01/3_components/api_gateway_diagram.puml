@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Edge_Router_and_Reverse_Proxy, "Edge Router and Reverse Proxy", "AWS API Gateway / Reverse Proxy", "Centralizes edge routing, HTTPS termination, and traffic distribution across multi-region deployments.")
    Component(Authentication_and_Security_Filter, "Authentication and Security Filter", "OAuth2 / JWT / AWS WAF", "Handles user authentication, rate limiting, and request validation at the edge.")
    Component(Circuit_Breaker_and_Load_Balancer, "Circuit Breaker and Load Balancer", "Spring Cloud Circuit Breaker / Resilience4j", "Ensures fault tolerance and graceful degradation when routing traffic to backend microservices.")
}

Rel(Edge_Router_and_Reverse_Proxy, Authentication_and_Security_Filter, "Passes incoming requests for security inspection and token validation")
Rel(Authentication_and_Security_Filter, Circuit_Breaker_and_Load_Balancer, "Forwards validated requests for backend routing")

@enduml