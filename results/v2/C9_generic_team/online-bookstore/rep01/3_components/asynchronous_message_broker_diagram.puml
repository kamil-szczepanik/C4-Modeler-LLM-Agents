@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(asynchronous_message_broker, "Asynchronous Message Broker") {
    Component(Event_Publisher, "Event Publisher", "AWS SNS", "Publishes asynchronous domain events from microservices to the messaging infrastructure.")
    Component(Event_Consumer, "Event Consumer", "AWS SQS", "Queues and delivers asynchronous messages to subscribed microservices for processing.")
    Component(Event_Archive, "Event Archive", "AWS Kinesis / SQS Archive", "Stores historical events for event replay, auditing, and compliance purposes.")
}

Rel(Event_Publisher, Event_Consumer, "Routes published events to appropriate message queues")
Rel(Event_Consumer, Event_Archive, "Persists processed event streams for replay and analytics")

@enduml