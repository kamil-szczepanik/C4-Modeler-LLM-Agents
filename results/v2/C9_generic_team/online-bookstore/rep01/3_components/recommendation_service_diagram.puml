@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Recommendation Service container

Container_Boundary(recommendation_service, "Recommendation Service") {
    Component(Recommendation_API_Controller, "Recommendation API Controller", "Python / FastAPI", "Handles incoming real-time recommendation requests from the API Gateway with strict <200ms timeouts.")
    Component(ML_Inference_Engine, "ML Inference Engine", "Python / Machine Learning Library", "Processes user preferences and item data to generate personalized book recommendations.")
    Component(Event_Consumer, "Event Consumer", "Python / Boto3", "Consumes platform events idempotently from the Asynchronous Message Broker for model training inputs.")
    Component(Cache_Manager, "Cache Manager", "Python / Redis Client", "Reads pre-computed fallback items and interacts with the Distributed Caching Container via TCP.")
    Component(Data_Access_Layer, "Data Access Layer", "Python / Database Connector", "Accesses pseudonymized user preference data securely from the Compliance/User Data Container.")
    Component(Telemetry___Logging_Client, "Telemetry & Logging Client", "Python / HTTPS Client", "Exports structured JSON logs and model telemetry to the SIEM Provider.")
}

System_Ext(SIEM_Provider, "SIEM Provider", "External SIEM system for logs and telemetry.")

Rel(Recommendation_API_Controller, ML_Inference_Engine, "Delegates recommendation requests", "Internal Function Call")
Rel(ML_Inference_Engine, Cache_Manager, "Fetches pre-computed fallbacks", "Redis Protocol / TCP")
Rel(ML_Inference_Engine, Data_Access_Layer, "Queries pseudonymized user preference data", "Database-per-Service (TCP)")
Rel(Event_Consumer, ML_Inference_Engine, "Feeds asynchronous event data for model training", "Internal Message Queue")
Rel(Telemetry___Logging_Client, SIEM_Provider, "Exports structured JSON logs and model telemetry", "HTTPS")

@enduml