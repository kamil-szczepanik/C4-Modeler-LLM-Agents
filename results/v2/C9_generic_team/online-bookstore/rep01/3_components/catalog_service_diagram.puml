@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Catalog_Service", "Catalog Service") {
    Component("Catalog Controller", "Catalog Controller", "Java/Spring Boot REST Controller", "Exposes REST and gRPC endpoints with OpenAPI validation for catalog and search requests.")
    Component("Search Index Manager", "Search Index Manager", "Java/Spring Boot Service", "Queries the read-optimized search index implementing CQRS for fast keyword searches.")
    Component("Cache Manager", "Cache Manager", "Java/Spring Boot Service with HikariCP", "Manages distributed caching using the Cache-Aside pattern for low latency data retrieval.")
    Component("Database Repository", "Database Repository", "Java/Spring Boot Data / Flyway", "Accesses the primary relational database using a database-per-service pattern with automated migrations.")
    Component("Event Publisher", "Event Publisher", "AWS SQS/SNS Client", "Publishes and consumes asynchronous cache invalidation and catalog events ensuring idempotency.")
    Component("Telemetry Logger", "Telemetry Logger", "OpenTelemetry", "Exports structured JSON logs and distributed tracing data.")
}

Rel("Catalog Controller", "Search Index Manager", "Delegates search requests", "TCP/HTTPS")
Rel("Catalog Controller", "Cache Manager", "Reads and writes cached data", "Redis Protocol / TCP")
Rel("Catalog Controller", "Database Repository", "Accesses primary relational data", "Database-per-Service (TCP)")
Rel("Search Index Manager", "Telemetry Logger", "Exports structured search execution logs", "HTTPS")
Rel("Cache Manager", "Event Publisher", "Triggers cache invalidation events", "AWS SQS/SNS")
Rel("Database Repository", "Telemetry Logger", "Exports structured database access logs", "HTTPS")

@enduml