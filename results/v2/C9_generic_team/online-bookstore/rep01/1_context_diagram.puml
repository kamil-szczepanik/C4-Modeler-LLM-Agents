@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "Browses and purchases physical and electronic books via web or mobile interfaces.")
Person(Store Administrator, "Store Administrator", "Manages store operations, catalog, and administrative tasks.")

System(Online Bookstore Platform, "Online Bookstore Platform", "A globally distributed e-commerce platform designed to sell physical and electronic books with integrated recommendations, reviews, and multi-currency support for 1 million monthly active users worldwide.")

System_Ext(Payment Gateway, "Payment Gateway", "Handles secure checkout and multi-currency transactions.")
System_Ext(Shipping Providers, "Shipping Providers", "Provides APIs for order fulfillment and delivery tracking.")
System_Ext(Tax Calculation Service, "Tax Calculation Service", "Calculates regional taxes for compliance.")
System_Ext(Notification Service, "Notification Service", "Sends transactional emails and notifications.")
System_Ext(SIEM Provider, "SIEM Provider", "Monitors security events and telemetry.")
System_Ext(Compliance/Archival Store, "Compliance/Archival Store", "Stores immutable audit logs for regulatory compliance.")
System_Ext(Global Content Delivery Network (CDN) and WAF, "Global Content Delivery Network (CDN) and WAF", "Provides edge security, DDoS protection, and content delivery.")

Rel(Customer, Global Content Delivery Network (CDN) and WAF, "Accesses the platform securely via browser or mobile", "HTTPS via TLS 1.3")
Rel(Store Administrator, Global Content Delivery Network (CDN) and WAF, "Accesses administrative tools securely", "HTTPS via TLS 1.3")
Rel(Global Content Delivery Network (CDN) and WAF, Online Bookstore Platform, "Forwards filtered traffic to the core platform", "HTTPS")
Rel(Online Bookstore Platform, Payment Gateway, "Processes secure checkout and multi-currency transactions", "REST/JSON over HTTPS")
Rel(Online Bookstore Platform, Shipping Providers, "Manages order fulfillment", "REST/JSON APIs")
Rel(Online Bookstore Platform, Tax Calculation Service, "Performs regional tax calculations", "gRPC/HTTPS")
Rel(Online Bookstore Platform, Notification Service, "Triggers transactional emails and alerts", "Asynchronous event messaging (AMQP/HTTPS)")
Rel(Online Bookstore Platform, SIEM Provider, "Sends security and audit telemetry", "HTTPS")
Rel(Online Bookstore Platform, Compliance/Archival Store, "Archives immutable audit logs for GDPR and CCPA", "HTTPS")

@enduml