@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore Platform

Person(Customer, "Customer", "Browses and purchases physical and electronic books via web or mobile interfaces.")
Person(StoreAdministrator, "Store Administrator", "Manages store operations, catalog, and administrative tasks.")

System_Ext(GlobalCDN, "Global Content Delivery Network (CDN) and WAF", "Provides edge security, DDoS protection, and content delivery.")
System_Ext(PaymentGateway, "Payment Gateway", "Handles secure checkout and multi-currency transactions.")
System_Ext(ShippingProviders, "Shipping Providers", "Provides APIs for order fulfillment and delivery tracking.")
System_Ext(TaxCalculationService, "Tax Calculation Service", "Calculates regional taxes for compliance.")
System_Ext(NotificationService, "Notification Service", "Sends transactional emails and notifications.")
System_Ext(SIEMProvider, "SIEM Provider", "Monitors security events and telemetry.")
System_Ext(ComplianceArchivalStore, "Compliance/Archival Store", "Stores immutable audit logs for regulatory compliance.")

System_Boundary(OnlineBookstorePlatform, "Online Bookstore Platform") {
    Container(SPA, "Single Page Application (SPA) / Mobile Client", "React, Angular, or Mobile Native", "Provides the user interface for customers and administrators.")
    Container(APIGateway, "API Gateway", "AWS API Gateway / Reverse Proxy", "Handles rate limiting, WAF integration, and routing.")
    Container(CatalogService, "Catalog Service", "Microservice (Java/Spring Boot or Node.js)", "Manages the book catalog for physical and electronic sales.")
    Container(OrderCheckoutService, "Order & Checkout Service", "Microservice (Java/Spring Boot or Node.js)", "Handles cart management, checkout, and payment/shipping integration.")
    Container(RecommendationService, "Recommendation Service", "Microservice (Python / Machine Learning)", "Provides personalized book recommendations to users.")
    Container(ReviewService, "Review Service", "Microservice (Java/Spring Boot or Node.js)", "Manages customer reviews and ratings.")
    Container(MessageBroker, "Asynchronous Message Broker", "AWS SQS/SNS", "Decouples microservices and handles asynchronous messaging.")
    Container(DistributedCaching, "Distributed Caching Container", "Amazon ElastiCache", "Provides regional low-latency reads.")
    Container(UserDataContainer, "Compliance/User Data Container", "Segregated Isolated Data Stores", "Stores user and sensitive data following the Database-per-Service pattern.")
    Container(SecretsManager, "Configuration/Secrets Management Container", "AWS Secrets Manager / Parameter Store", "Manages centralized credentials and configuration.")
}

Rel(Customer, GlobalCDN, "Accesses the platform securely via browser or mobile", "HTTPS via TLS 1.3")
Rel(StoreAdministrator, GlobalCDN, "Accesses administrative tools securely", "HTTPS via TLS 1.3")
Rel(GlobalCDN, SPA, "Serves client assets", "HTTPS")
Rel(SPA, APIGateway, "Interacts with backend services", "HTTPS using OpenAPI/Swagger specifications")

Rel(APIGateway, CatalogService, "Routes catalog requests", "REST/gRPC")
Rel(APIGateway, OrderCheckoutService, "Routes order and checkout requests", "REST/gRPC")
Rel(APIGateway, RecommendationService, "Routes recommendation requests", "REST/gRPC")
Rel(APIGateway, ReviewService, "Routes review requests", "REST/gRPC")

Rel(OrderCheckoutService, PaymentGateway, "Processes secure payments", "TLS and AWS SQS/SNS")
Rel(OrderCheckoutService, ShippingProviders, "Arranges order fulfillment", "TLS and AWS SQS/SNS")
Rel(OrderCheckoutService, TaxCalculationService, "Calculates taxes", "gRPC/HTTPS")
Rel(OrderCheckoutService, NotificationService, "Triggers notifications", "Asynchronous event messaging (AMQP/HTTPS)")

Rel(OrderCheckoutService, MessageBroker, "Publishes and consumes asynchronous events", "AWS SQS/SNS")
Rel(CatalogService, MessageBroker, "Publishes catalog events", "AWS SQS/SNS")
Rel(RecommendationService, MessageBroker, "Consumes platform events", "AWS SQS/SNS")
Rel(ReviewService, MessageBroker, "Publishes review events", "AWS SQS/SNS")

Rel(CatalogService, DistributedCaching, "Reads cached catalog data", "Redis Protocol / TCP")
Rel(RecommendationService, DistributedCaching, "Reads cached recommendations", "Redis Protocol / TCP")

Rel(CatalogService, UserDataContainer, "Accesses catalog database", "Database-per-Service (TCP)")
Rel(OrderCheckoutService, UserDataContainer, "Accesses order database", "Database-per-Service (TCP)")
Rel(RecommendationService, UserDataContainer, "Accesses recommendation database", "Database-per-Service (TCP)")
Rel(ReviewService, UserDataContainer, "Accesses review database", "Database-per-Service (TCP)")

Rel(APIGateway, SIEMProvider, "Exports structured JSON logs", "HTTPS")
Rel(CatalogService, SIEMProvider, "Exports structured JSON logs", "HTTPS")
Rel(OrderCheckoutService, SIEMProvider, "Exports structured JSON logs", "HTTPS")
Rel(RecommendationService, SIEMProvider, "Exports structured JSON logs", "HTTPS")
Rel(ReviewService, SIEMProvider, "Exports structured JSON logs", "HTTPS")

Rel(SIEMProvider, ComplianceArchivalStore, "Archives audit logs for GDPR/CCPA compliance", "HTTPS")

@enduml