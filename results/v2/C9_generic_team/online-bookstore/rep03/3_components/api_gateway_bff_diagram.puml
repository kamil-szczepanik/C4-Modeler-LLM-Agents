@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_bff, "API Gateway / BFF") {
    Component(Routing_and_Rate_Limiting_Router, "Routing and Rate Limiting Router", "AWS API Gateway", "Handles native routing, request dispatching, and rate limiting to enforce the uptime SLA.")
    Component(Request_Aggregator, "Request Aggregator", "AWS Lambda / Node.js", "Aggregates responses from multiple downstream core domain services for the frontend SPA.")
}

Rel(Routing_and_Rate_Limiting_Router, Request_Aggregator, "Forwards inspected traffic")

@enduml