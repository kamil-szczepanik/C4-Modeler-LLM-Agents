@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Background Workers container

Container_Boundary(background_workers, "Background Workers") {
    Component(Task_Execution_Engine, "Task Execution Engine", "AWS ECS / AWS Lambda", "Executes background tasks and worker pools for scalability, managing asynchronous tasks and GDPR compliance routines.")
    Component(Message_Consumer, "Message Consumer", "AWS SQS / SNS", "Consumes queued asynchronous messages with Dead Letter Queues and utilizes the claim-check pattern with Amazon S3 for large payloads.")
    Component(Integration_Gateway, "Integration Gateway", "HTTPS Client", "Integrates with third-party shipping providers and notification SaaS securely.")
    Component(State_and_Rate_Management, "State and Rate Management", "Amazon ElastiCache (Redis) & Amazon RDS", "Manages distributed rate limiting, centralized job status tracking, and persists job state.")
}

Rel(Message_Consumer, Task_Execution_Engine, "Triggers asynchronous jobs", "AMQP/HTTPS")
Rel(Task_Execution_Engine, Integration_Gateway, "Integrates with third-party shipping APIs", "HTTPS")
Rel(Task_Execution_Engine, State_and_Rate_Management, "Stores job status and handles state management", "TCP")

@enduml