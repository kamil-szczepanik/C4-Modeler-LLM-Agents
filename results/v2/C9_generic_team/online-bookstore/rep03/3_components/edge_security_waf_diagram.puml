@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(edge_security_waf, "Edge Security & WAF") {
    Component(Web_Application_Firewall_WAF, "Web Application Firewall (WAF)", "AWS WAF", "Protects frontend requests, mitigates attacks at the edge using AWS Managed Rules for OWASP Top 10.")
    Component(Edge_Request_Inspector, "Edge Request Inspector", "AWS CloudFront / WAF Rules", "Validates incoming traffic headers and payloads before forwarding to the API Gateway.")
}

System(API_Gateway_BFF, "API Gateway / BFF", "AWS API Gateway")

Rel(Web_Application_Firewall_WAF, Edge_Request_Inspector, "Inspects and filters requests", "")
Rel(Edge_Request_Inspector, API_Gateway_BFF, "Forwards validated traffic", "HTTPS")
@enduml