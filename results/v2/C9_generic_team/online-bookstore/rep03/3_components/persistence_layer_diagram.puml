@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Persistence Layer container

Container_Boundary(persistence_layer, "Persistence Layer") {
    Component(AmazonRDS, "Amazon RDS", "Relational Database Service", "Primary transactional database for orders, users, and inventory, providing ACID compliance and high-availability multi-region scaling.")
    Component(AmazonOpenSearch, "Amazon OpenSearch", "Search Engine", "Handles catalogue search, product recommendations, and sub-second keyword search capabilities.")
    Component(AmazonRDSReadReplicas, "Amazon RDS Read Replicas", "Relational Database Read Replicas", "Offloads read queries for reviews and browsing to protect the primary transactional database.")
    Component(AmazonS3Glacier, "Amazon S3 Glacier", "Cold Storage Archive", "Archives cold transactional data for long-term storage and GDPR data retention compliance.")
    Component(AWSKMS, "AWS KMS", "Key Management Service", "Provides encryption at rest and in transit.")
    Component(DebeziumAWSDMS, "Debezium / AWS DMS", "Change Data Capture (CDC)", "Synchronizes relational data asynchronously to search indexes without impacting checkout latency.")
}

Component(CoreDomainServices, "Core Domain Services", "HikariCP / gRPC / HTTPS", "External services interacting with the persistence layer for data operations.")

Rel(CoreDomainServices, AmazonRDS, "Reads/writes transactional data", "HikariCP / gRPC")
Rel(CoreDomainServices, AmazonOpenSearch, "Queries search indexes and recommendations", "TCP")
Rel(AmazonRDS, AmazonOpenSearch, "Synchronizes data asynchronously via Change Data Capture", "TCP")
Rel(CoreDomainServices, AmazonS3Glacier, "Archives cold transactional data", "HTTPS")

@enduml