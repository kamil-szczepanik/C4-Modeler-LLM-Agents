@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Storefront Frontend (SPA) container

Container_Boundary(storefront_frontend_spa, "Storefront Frontend (SPA)") {
    Component(Catalog Browser Component, "Catalog Browser Component", "React, React Query", "Handles catalog browsing, searching, and product listing displays.")
    Component(Shopping Cart Component, "Shopping Cart Component", "React, RTK Query", "Manages shopping cart items, local state, and synchronization.")
    Component(Secure Checkout Component, "Secure Checkout Component", "React", "Manages the secure checkout user flow and payment UI interactions.")
    Component(Reviews and Recommendations Component, "Reviews and Recommendations Component", "React", "Displays product reviews and personalized recommendations to users.")
}

Rel(Catalog Browser Component, Shopping Cart Component, "Adds selected products", "")
Rel(Shopping Cart Component, Secure Checkout Component, "Proceeds to checkout with cart items", "")

@enduml