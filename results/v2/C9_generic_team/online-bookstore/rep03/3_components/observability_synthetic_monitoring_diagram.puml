@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Observability & Synthetic Monitoring container

Container_Boundary(obs_monitoring, "Observability & Synthetic Monitoring") {
    Component(Obs_Synthetic_Monitoring_Container, "Observability & Synthetic Monitoring Container", "AWS CloudWatch, AWS X-Ray", "Native AWS monitoring, distributed tracing, and metric ingestion supporting multi-region observability.")
    Component(Automated_Synthetic_Canaries__Out_of_Band_Probes, "Automated Synthetic Canaries & Out-of-Band Probes", "Automated Test Scripts", "Executes periodic automated test scripts across us-east-1, eu-west-1, and ap-southeast-1 to validate regional user journeys.")
}

Component(Core_Domain_Services, "Core Domain Services", "ECS / EKS, gRPC / REST", "Emits structured JSON logs and RED metrics to AWS CloudWatch via APM SDK wrappers.")
Component(Operations_Personnel__On_Call_Engineering_Team, "Operations Personnel & On-Call Engineering Team", "Human / Alert Receiver", "Receives dispatched alerts based on SLO burn rates from AWS CloudWatch composite alarms.")

Rel(Core_Domain_Services, Obs_Synthetic_Monitoring_Container, "Emit structured JSON logs and RED metrics via APM SDK wrappers", "gRPC / REST")
Rel(Automated_Synthetic_Canaries__Out_of_Band_Probes, Obs_Synthetic_Monitoring_Container, "Validate regional user journeys and send monitoring data", "Automated Test Scripts")
Rel(Obs_Synthetic_Monitoring_Container, Operations_Personnel__On_Call_Engineering_Team, "Dispatches alerts based on SLO burn rates", "Alert / Notification")

@enduml