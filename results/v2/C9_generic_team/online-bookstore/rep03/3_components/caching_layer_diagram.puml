@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Caching Layer container

Container_Boundary(caching_layer, "Caching Layer") {
    Component(Redis Cache Engine, "Redis Cache Engine", "Amazon ElastiCache (Redis)", "Handles in-memory caching using Cache-Aside pattern, volatile-lru eviction, and Redlock distributed locking with multi-AZ replication.")
    Component(Cache Invalidation Worker, "Cache Invalidation Worker", "AWS Lambda / ECS", "Listens to asynchronous messages to invalidate or refresh stale cache entries using Stale-While-Revalidate.")
}

Rel(Cache Invalidation Worker, Redis Cache Engine, "Evicts and updates keys via TCP", "TCP")

@enduml