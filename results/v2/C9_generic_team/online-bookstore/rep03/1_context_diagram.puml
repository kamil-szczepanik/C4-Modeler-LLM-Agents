@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers, "Customers", "End-users who browse, purchase, and review physical and electronic books.")
Person(Content Moderators, "Content Moderators", "Personnel responsible for monitoring and moderating user-generated content and reviews.")
Person(Operations Personnel, "Operations Personnel", "Staff members managing the day-to-day operations and infrastructure of the platform.")
Person(Customer Support Agents, "Customer Support Agents", "Agents who assist customers with inquiries, issues, and order management.")

System(Online Bookstore, "Online Bookstore", "A global e-commerce platform built to sell physical and electronic books with integrated recommendations and reviews, providing a scalable, secure, and multi-currency shopping experience across multiple regions.")

System_Ext(Payment Gateways, "Payment Gateways", "External services responsible for processing secure financial transactions.")
System_Ext(Shipping Providers, "Shipping Providers", "External logistics services used for fulfilling and tracking physical book deliveries.")
System_Ext(Identity Providers, "Identity Providers", "External OAuth2/OIDC providers (Google/Apple) for user authentication.")
System_Ext(Notification SaaS, "Notification SaaS", "External service used for dispatching transactional messages and notifications.")
System_Ext(Currency Exchange Rate Provider, "Currency Exchange Rate Provider", "External provider supplying up-to-date currency exchange rates for multi-currency support.")
System_Ext(Tax Calculation Service, "Tax Calculation Service", "External services (Avalara/TaxJar) used to calculate applicable taxes.")
System_Ext(SIEM / Compliance Logging SaaS, "SIEM / Compliance Logging SaaS", "External SaaS for streaming security, compliance, and audit logs.")
System_Ext(Customer Support Helpdesk SaaS, "Customer Support Helpdesk SaaS", "External SaaS platform utilized by support agents to manage customer queries.")
System_Ext(CDN & Geo-DNS, "CDN & Geo-DNS", "Edge delivery network for routing and low-latency global page loads.")

Rel(Customers, CDN & Geo-DNS, "Accesses the platform securely via global routing and edge delivery", "HTTPS")
Rel(CDN & Geo-DNS, Online Bookstore, "Forwards user traffic to the core system", "HTTPS")
Rel(Online Bookstore, Payment Gateways, "Processes payments securely", "REST APIs over TLS 1.3")
Rel(Online Bookstore, Currency Exchange Rate Provider, "Fetches current exchange rates for multi-currency transactions", "REST APIs over TLS 1.3")
Rel(Online Bookstore, Tax Calculation Service, "Calculates region-specific taxes for orders", "HTTPS APIs")
Rel(Online Bookstore, Shipping Providers, "Coordinates order fulfillment and shipping", "HTTPS APIs")
Rel(Online Bookstore, Identity Providers, "Authenticates users via federation", "OAuth2 / OIDC")
Rel(Online Bookstore, Notification SaaS, "Dispatches transactional emails and notifications", "API")
Rel(Online Bookstore, SIEM / Compliance Logging SaaS, "Streams security and audit logs", "Secure Syslog / HTTPS")

@enduml