@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore

Person(Customers, "Customers", "End-users who browse, purchase, and review physical and electronic books.")

System_Ext(PaymentGateways, "Payment Gateways", "External services responsible for processing secure financial transactions.")
System_Ext(ShippingProviders, "Shipping Providers", "External logistics services used for fulfilling and tracking physical book deliveries.")

System_Boundary(OnlineBookstore, "Online Bookstore") {
    Container(StorefrontFrontendSPA, "Storefront Frontend (SPA)", "AWS S3, Amazon CloudFront", "Hosted via AWS S3 and distributed globally via Amazon CloudFront to provide catalogue browsing, reviews, and secure checkout.")
    Container(EdgeSecurityWAF, "Edge Security & WAF", "AWS WAF", "Integrated with CloudFront and API Gateway to provide edge security.")
    Container(APIGatewayBFF, "API Gateway / BFF", "AWS API Gateway", "Handles routing, rate limiting, and protocol translation.")
    Container(CoreDomainServices, "Core Domain Services", "AWS ECS / EKS, gRPC, REST", "Catalog/Search, Checkout/Cart, Recommendations, and User Management containers handling backend business logic.")
    ContainerDb(CachingLayer, "Caching Layer", "Amazon ElastiCache (Redis)", "Caches currency rates, search results, and recommendations.")
    Container(AsynchronousMessageBroker, "Asynchronous Message Broker", "AWS SQS/SNS with Dead Letter Queue (DLQ)", "Handles fault-tolerant asynchronous event-driven processing.")
    Container(BackgroundWorkers, "Background Workers", "AWS ECS / Lambda", "Handles shipping integrations, audits, and GDPR anonymization.")
    ContainerDb(PersistenceLayer, "Persistence Layer", "Amazon RDS, Amazon OpenSearch", "Stores transactional data and provides catalogue search capabilities.")
    Container(ObservabilitySyntheticMonitoring, "Observability & Synthetic Monitoring", "AWS CloudWatch, X-Ray", "Provides monitoring and regional synthetic probes.")
}

Rel(Customers, StorefrontFrontendSPA, "Accesses the SPA storefront", "HTTPS")
Rel(StorefrontFrontendSPA, EdgeSecurityWAF, "Protects frontend requests", "AWS WAF")
Rel(StorefrontFrontendSPA, APIGatewayBFF, "Routes frontend API requests", "HTTPS")
Rel(APIGatewayBFF, CoreDomainServices, "Invokes backend business logic", "gRPC/REST")
Rel(CoreDomainServices, CachingLayer, "Retrieves cached catalogue and rate data", "TCP")
Rel(CoreDomainServices, PersistenceLayer, "Reads and writes transactional and search data", "TCP")
Rel(CoreDomainServices, AsynchronousMessageBroker, "Publishes asynchronous events for orders and shipping", "AMQP/HTTPS")
Rel(AsynchronousMessageBroker, BackgroundWorkers, "Triggers background tasks", "AMQP/HTTPS")
Rel(BackgroundWorkers, ShippingProviders, "Integrates with third-party shipping", "HTTPS")

@enduml