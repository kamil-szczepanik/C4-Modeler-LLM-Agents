@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore System

Person(Customers, "Customers", "End-users accessing the web and mobile interfaces to browse, purchase, review, and receive recommendations.")

System_Ext(PaymentGateways, "Payment Gateways", "External processors for secure financial transactions.")
System_Ext(ThirdPartyShippingAPIs, "Third-Party Shipping APIs", "External logistics providers for physical book fulfillment.")
System_Ext(ForexCurrencyRateAPI, "Forex/Currency Rate API", "External service providing real-time exchange rates for USD, EUR, and GBP.")
System_Ext(NotificationService, "Notification Service", "External email and SMS providers for alerts and receipts.")

System_Boundary(OnlineBookstoreSystem, "Online Bookstore System") {
    Container(AWSCloudFrontS3, "AWS CloudFront & S3", "AWS CloudFront, Amazon S3", "CDN and storage for static web and mobile assets.")
    Container(APIGatewayBFF, "API Gateway & BFF", "AWS API Gateway", "Handles client routing, rate limiting, and request aggregation.")
    Container(CatalogContainer, "Catalog Container", "Docker, Amazon ECS/EKS", "Manages book listings, search, and inventory.")
    Container(CheckoutContainer, "Checkout Container", "Docker, Amazon ECS/EKS", "Manages cart processing, payments, and order fulfillment integration.")
    Container(RecommendationsContainer, "Recommendations Container", "Docker, Amazon ECS/EKS", "Provides personalized book recommendations to users.")
    Container(ReviewsContainer, "Reviews Container", "Docker, Amazon ECS/EKS", "Handles user reviews and ratings for books.")
    Container(ComplianceWorkers, "Compliance Workers", "Docker, Amazon ECS/EKS", "Handles GDPR/CCPA data anonymization and compliance tasks.")
    ContainerDb(AmazonAuroraRDS, "Amazon Aurora/RDS", "Amazon Aurora/RDS", "Database-per-service storage for core containers.")
    ContainerDb(AmazonElastiCache, "Amazon ElastiCache", "Amazon ElastiCache (Redis)", "Caching and distributed session management.")
    Container(AWSSQSSNS, "AWS SQS/SNS", "AWS SQS, AWS SNS, DLQ", "Decoupled asynchronous event-driven messaging backbone.")
}

Rel(Customers, AWSCloudFrontS3, "Fetch static assets", "HTTPS")
Rel(Customers, APIGatewayBFF, "Interact with backend services via storefront", "HTTPS/REST")
Rel(APIGatewayBFF, AmazonElastiCache, "Queries for session state and catalog caching", "Redis Protocol")
Rel(APIGatewayBFF, CatalogContainer, "Routes catalog requests", "HTTPS/REST")
Rel(APIGatewayBFF, CheckoutContainer, "Routes checkout requests", "HTTPS/REST")
Rel(APIGatewayBFF, RecommendationsContainer, "Routes recommendation requests", "HTTPS/REST")
Rel(APIGatewayBFF, ReviewsContainer, "Routes review requests", "HTTPS/REST")
Rel(CatalogContainer, AWSSQSSNS, "Communicates asynchronously using events", "AMQP/JSON")
Rel(CheckoutContainer, AWSSQSSNS, "Communicates asynchronously using events", "AMQP/JSON")
Rel(RecommendationsContainer, AWSSQSSNS, "Communicates asynchronously using events", "AMQP/JSON")
Rel(ReviewsContainer, AWSSQSSNS, "Communicates asynchronously using events", "AMQP/JSON")
Rel(ComplianceWorkers, AWSSQSSNS, "Communicates asynchronously using events", "AMQP/JSON")
Rel(CheckoutContainer, PaymentGateways, "Integrates for secure payment processing", "HTTPS/REST")
Rel(CheckoutContainer, ThirdPartyShippingAPIs, "Integrates for fulfillment", "HTTPS/REST")
Rel(ComplianceWorkers, AmazonAuroraRDS, "Interacts for GDPR/CCPA data anonymization", "Database Protocol")

@enduml