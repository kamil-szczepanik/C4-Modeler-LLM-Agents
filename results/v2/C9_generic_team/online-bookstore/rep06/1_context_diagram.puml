@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers, "Customers", "End-users accessing the web and mobile interfaces to browse, purchase, review, and receive recommendations.")

System(Online Bookstore System, "Online Bookstore System", "Core retail platform handling catalog, cart, checkout, reviews, and recommendations for physical and electronic books.")

System_Ext(Payment Gateways, "Payment Gateways", "External processors for secure financial transactions.")
System_Ext(Third-Party Shipping APIs, "Third-Party Shipping APIs", "External logistics providers for physical book fulfillment.")
System_Ext(Forex/Currency Rate API, "Forex/Currency Rate API", "External service providing real-time exchange rates for USD, EUR, and GBP.")
System_Ext(Notification Service, "Notification Service", "External email and SMS providers for alerts and receipts.")

Rel(Customers, Online Bookstore System, "Catalog browsing, cart management, and secure checkout", "HTTPS via TLS 1.3")
Rel(Online Bookstore System, Payment Gateways, "Processing multi-currency transactions", "REST/JSON over TLS 1.3")
Rel(Online Bookstore System, Third-Party Shipping APIs, "Order fulfillment and tracking", "REST/JSON over TLS 1.3")
Rel(Online Bookstore System, Forex/Currency Rate API, "Real-time currency conversion", "REST/JSON over TLS 1.3")
Rel(Online Bookstore System, Notification Service, "Order confirmations and password resets", "Asynchronous messaging and API calls")

@enduml