@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS CloudFront & S3 container

Container_Boundary("AWS CloudFront & S3", "AWS CloudFront & S3") {
    Component(AWS CloudFront, "AWS CloudFront", "AWS CloudFront CDN", "Content Delivery Network at the edge for global static asset delivery.")
    Component(Amazon S3 Primary, "Amazon S3 Primary", "Amazon S3", "Primary object storage bucket for static assets and SPAs.")
    Component(Amazon S3 Replication Bucket, "Amazon S3 Replication Bucket", "Amazon S3", "Replicated object storage bucket providing high availability.")
    Component(AWS WAF, "AWS WAF", "AWS WAF", "Web Application Firewall integrated at the edge for traffic inspection and filtering.")
    Component(CloudFront Functions, "CloudFront Functions", "AWS CloudFront Edge Compute", "Lightweight edge compute for dynamic configuration and CSP nonces.")
    Component(CloudWatch Synthetics, "CloudWatch Synthetics", "AWS CloudWatch", "Global monitoring canaries.")
}

Rel(AWS WAF, AWS CloudFront, "Inspects and filters inbound traffic at the edge", "HTTPS")
Rel(AWS CloudFront, Amazon S3 Primary, "Origin fetch via Origin Access Control (OAC) using SigV4", "HTTPS")
Rel(Amazon S3 Primary, Amazon S3 Replication Bucket, "Cross-Region Replication (CRR) via HTTPS", "HTTPS")

@enduml