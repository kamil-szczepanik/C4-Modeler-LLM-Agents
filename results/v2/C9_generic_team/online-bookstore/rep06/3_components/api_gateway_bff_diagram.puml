@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_bff, "API Gateway & BFF") {
    Component(RequestRouter, "Request Router", "Node.js / Express", "Routes incoming storefront requests to appropriate backend microservices.")
    Component(RequestAggregator, "Request Aggregator", "Node.js", "Aggregates responses from multiple microservices to optimize client payloads.")
    Component(RateLimiterSecurityFilter, "Rate Limiter & Security Filter", "AWS WAF / API Gateway Native", "Enforces rate limiting and mitigates OWASP Top-10 vulnerabilities at the edge.")
    Component(SessionManager, "Session Manager", "Redis Client", "Interacts with Amazon ElastiCache to query and manage user session states.")
}

Rel(RequestRouter, RequestAggregator, "Forwards routed requests for aggregation")
Rel(RequestRouter, SessionManager, "Validates session state")
Rel(RateLimiterSecurityFilter, RequestRouter, "Passes sanitized and validated requests")

@enduml