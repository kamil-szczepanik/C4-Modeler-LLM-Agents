@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon Aurora/RDS container

Container_Boundary(amazon_aurora_rds, "Amazon Aurora/RDS") {
    Component(AmazonAuroraWriterInstance, "Amazon Aurora Writer Instance", "Amazon Aurora PostgreSQL", "Handles all transactional write operations including checkout and orders.")
    Component(AmazonAuroraReadReplicas, "Amazon Aurora Read Replicas", "Amazon Aurora PostgreSQL", "Scales read-heavy operations such as catalog browsing, reviews, and recommendations.")
    Component(AWSRDSProxy, "AWS RDS Proxy", "AWS RDS Proxy", "Manages and pools database connections from ECS/EKS containers to prevent connection exhaustion.")
    Component(ComplianceWorkers, "Compliance Workers", "PostgreSQL pgaudit Extension / Terraform", "Executes GDPR/CCPA data anonymization, logical soft deletes, partitioning, and cryptographic shredding.")
    Component(AmazonCloudWatch, "Amazon CloudWatch", "Amazon CloudWatch", "Monitors database telemetry, connection pool saturation, replication lag, and publishes audit logs.")
}

Rel(AWSRDSProxy, AmazonAuroraWriterInstance, "Forwards transactions and queries", "PostgreSQL Wire Protocol")
Rel(AWSRDSProxy, AmazonAuroraReadReplicas, "Forwards queries", "PostgreSQL Wire Protocol")
Rel(ComplianceWorkers, AmazonAuroraWriterInstance, "Executes data anonymization, partitioning, and cryptographic shredding", "Database Protocol")
Rel(AmazonAuroraWriterInstance, AmazonCloudWatch, "Publishes audit logs, slow-query metrics, and telemetry", "AWS API")
Rel(AmazonAuroraReadReplicas, AmazonCloudWatch, "Publishes telemetry and metrics", "AWS API")

@enduml