@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Catalog_Container", "Catalog Container") {
    Component("Search_Module", "Search Module", "Java / Internal Package", "Manages keyword searches and retrieval of catalog items.")
    Component("Inventory_Module", "Inventory Module", "Java / Internal Package", "Manages inventory metadata and stock levels.")
    Component("Metadata_Package", "Metadata Package", "Java / Internal Package", "Handles book listings and associated metadata.")
}

System_Ext("Amazon_ElastiCache_Redis", "Amazon ElastiCache (Redis)", "In-memory caching layer for low-latency searches and rate limiting")
System_Ext("Amazon_Aurora_RDS", "Amazon Aurora/RDS", "Relational database with connection pooling for inventory and metadata storage")

Rel("Search_Module", "Amazon_ElastiCache_Redis", "Fetches and caches search results and exchange rates", "Redis Protocol")
Rel("Search_Module", "Amazon_Aurora_RDS", "Queries primary database and Read Replicas", "SQL/TCP")
Rel("Inventory_Module", "Amazon_Aurora_RDS", "Queries primary database and Read Replicas", "SQL/TCP")
Rel("Metadata_Package", "Amazon_Aurora_RDS", "Queries primary database and Read Replicas", "SQL/TCP")
Rel("Metadata_Package", "Amazon_ElastiCache_Redis", "Fetches and caches search results and exchange rates", "Redis Protocol")
@enduml