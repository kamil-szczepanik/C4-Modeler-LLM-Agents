@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(recommendations_container, "Recommendations Container") {
    Component(RecommendationAPI_Router, "Recommendation API Router", "Amazon ECS / REST", "Routes incoming recommendation requests from the API Gateway and BFF.")
    Component(RecommendationScoring_Engine, "Recommendation Scoring Engine", "Amazon ECS / Docker", "Core logic for generating personalized book recommendations.")
    Component(BackgroundPrecomputation_Worker, "Background Pre-computation Worker", "Amazon ECS Worker", "Performs periodic scoring updates and processes background tasks.")
    Component(CacheandRateLimiter_Client, "Cache and Rate Limiter Client", "Redis Protocol", "Interacts with Amazon ElastiCache to read cached scores and enforce rate limits.")
    Component(EventIngestion_Handler, "Event Ingestion Handler", "AWS SNS/SQS", "Ingests purchase events and GDPR compliance triggers.")
}

Rel(RecommendationAPI_Router, RecommendationScoring_Engine, "Delegates recommendation generation", "HTTPS/REST")
Rel(RecommendationScoring_Engine, CacheandRateLimiter_Client, "Reads cached scores and checks rate limits", "TCP/Redis Protocol")
Rel(BackgroundPrecomputation_Worker, CacheandRateLimiter_Client, "Updates pre-computed recommendation matrices", "TCP/Redis Protocol")
Rel(EventIngestion_Handler, BackgroundPrecomputation_Worker, "Passes purchase and compliance events", "AMQP/SQS")
@enduml