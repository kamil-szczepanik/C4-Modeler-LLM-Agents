@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_elasticache, "Amazon ElastiCache") {
    Component(Session_State_Manager, "Session State Manager", "Redis In-Memory Data Store", "Manages user session state and user metadata for fast retrieval across the BFF and API Gateway.")
    Component(Catalog_Cache_Manager, "Catalog Cache Manager", "Redis In-Memory Data Store utilizing Cache-Aside pattern, LRU eviction, and Lazy Freeing", "Caches frequently accessed book catalog data to reduce read load on Amazon Aurora/RDS and ensure low-latency responses.")
}

Rel(Session_State_Manager, Catalog_Cache_Manager, "Shares memory resources and caching eviction policies within the ElastiCache cluster.", "Redis Protocol")

@enduml