@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Reviews Container container

Container_Boundary("Reviews Container", "Reviews Container") {
    Component("Reviews API Controller", "Reviews API Controller", "Docker, Amazon ECS/EKS", "Manages customer ratings, 5-star reviews, and routes review and rating queries.")
    Component("Compliance Workflow Manager", "Compliance Workflow Manager", "Docker, Amazon ECS/EKS", "Triggers GDPR/CCPA data redaction workflows and asynchronous compliance processing.")
    Component("Caching Manager", "Caching Manager", "Amazon ElastiCache (Redis)", "Caches aggregated ratings, serves fallbacks, and maintains fast page loads.")
    Component("Event Publisher", "Event Publisher", "AWS SNS & AWS SQS", "Publishes and distributes new review events for asynchronous processing.")
}

Rel("Reviews API Controller", "Caching Manager", "Caches and retrieves aggregated ratings", "Redis Protocol/TCP")
Rel("Reviews API Controller", "Event Publisher", "Publishes new review events", "AWS SDK/HTTPS")
Rel("Event Publisher", "Compliance Workflow Manager", "Triggers compliance and redaction workflows", "AWS Protocol")

@enduml