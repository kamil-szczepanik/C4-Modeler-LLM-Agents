@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Compliance Workers container

Container_Boundary("Compliance Workers", "Compliance Workers") {
    Component(ComplianceRequestConsumer, "Compliance Request Consumer", "Docker / Amazon ECS/EKS", "Consumes compliance requests asynchronously from Amazon SQS and handles message retry backoff and DLQ routing.")
    Component(StateMachineOrchestrator, "State Machine Orchestrator", "AWS Step Functions / Local State Tracking", "Manages multi-step compliance request state machines (Pending, Processing, Completed, Failed).")
    Component(DataAnonymizerandExporter, "Data Anonymizer and Exporter", "Docker / Isolated Database Connection Pool", "Executes isolated batch data anonymization, exports, and deletions using a bulkhead pattern to protect core performance.")
    Component(AuditLogEmitter, "Audit Log Emitter", "HTTPS / S3 API", "Emits immutable compliance audit logs to Amazon S3.")
}

Rel(ComplianceRequestConsumer, StateMachineOrchestrator, "Triggers state transitions for incoming compliance requests")
Rel(StateMachineOrchestrator, DataAnonymizerandExporter, "Orchestrates batch data anonymization and deletions")
Rel(DataAnonymizerandExporter, AuditLogEmitter, "Sends execution results to generate immutable audit logs", "HTTPS / S3 API")

@enduml