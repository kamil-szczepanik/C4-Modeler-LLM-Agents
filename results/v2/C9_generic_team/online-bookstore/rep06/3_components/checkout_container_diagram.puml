@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Checkout Container container

Container_Boundary(checkout_container, "Checkout Container") {
    Component(cart_order_state_manager, "Cart/Order State Manager", "Domain Model & Application Service", "Manages cart processing and core domain models")
    Component(payment_gateway_adapter, "Payment Gateway Adapter", "Anti-Corruption Layer (ACL) / HTTPS", "Integrates with external payment providers via an Anti-Corruption Layer (ACL)")
    Component(fulfillment_integrator, "Fulfillment Integrator", "Integration Service / HTTPS", "Interfaces with third-party shipping APIs for order delivery")
    Component(saga_orchestrator, "Saga Orchestrator", "Workflow Engine", "Manages distributed transactions and compensation workflows")
    Component(outbox_publisher_dlq, "Outbox Publisher & DLQ", "AWS SQS/SNS & Event Publisher", "Handles reliable event publishing using AWS SQS/SNS and dead-letter queues")
}

Component(api_gateway_bff, "API Gateway & BFF", "HTTPS/REST", "External system routing incoming checkout and cart requests")
Component(payment_gateways, "Payment Gateways", "HTTPS/REST with Idempotency Keys", "External payment provider")
Component(third_party_shipping_apis, "Third-Party Shipping APIs", "HTTPS/REST", "External shipping provider")
Component(amazon_aurora_rds, "Amazon Aurora/RDS", "TCP/PostgreSQL Protocol", "Relational database for ACID compliance during order processing and event persistence")
Component(aws_sqs_sns, "AWS SQS/SNS", "AWS SDK/HTTPS", "Asynchronous messaging infrastructure for outbox event delivery")

Rel(api_gateway_bff, cart_order_state_manager, "Routes incoming checkout and cart requests", "HTTPS/REST")
Rel(saga_orchestrator, payment_gateway_adapter, "Coordinates payment transactions")
Rel(saga_orchestrator, fulfillment_integrator, "Coordinates order fulfillment")
Rel(payment_gateway_adapter, payment_gateways, "Processes secure payments", "HTTPS/REST with Idempotency Keys")
Rel(fulfillment_integrator, third_party_shipping_apis, "Coordinates order fulfillment", "HTTPS/REST")
Rel(cart_order_state_manager, amazon_aurora_rds, "Persists transactional state", "TCP/PostgreSQL Protocol")
Rel(outbox_publisher_dlq, amazon_aurora_rds, "Persists outbox events", "TCP/PostgreSQL Protocol")
Rel(outbox_publisher_dlq, aws_sqs_sns, "Publishes asynchronous order and fulfillment events", "AWS SDK/HTTPS")

@enduml