@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_sqs_sns, "AWS SQS/SNS") {
    Component(Amazon_SNS_Topics, "Amazon SNS Topics", "AWS SNS", "Publishes asynchronous events and broadcasts messages to multiple subscribers.")
    Component(Amazon_SQS_Queues, "Amazon SQS Queues", "AWS SQS", "Buffers and manages queues for asynchronous task processing across microservices.")
    Component(Dead_Letter_Queues, "Dead Letter Queues", "AWS SQS DLQ", "Captures and stores failed or poisoned messages for troubleshooting and reprocessing.")
}

Rel(Amazon_SNS_Topics, Amazon_SQS_Queues, "Fans out messages to queues", "HTTPS")
Rel(Amazon_SQS_Queues, Dead_Letter_Queues, "Forwards failed messages after max retry attempts", "HTTPS")
@enduml