@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application/API Gateway container

Container_Boundary(web_application_api_gateway, "Web Application/API Gateway") {
    Component(Envoy Proxy Router, "Envoy Proxy Router", "Envoy Proxy", "Routes incoming traffic to appropriate backend containers via gRPC/REST over TLS.")
    Component(Security & Authentication Filter, "Security & Authentication Filter", "JWT Validation / Envoy Filter", "Authenticates users via HTTPS with the Identity Provider and enforces OWASP compliance.")
    Component(Secrets and Credentials Manager, "Secrets and Credentials Manager", "AWS Secrets Manager", "Retrieves credentials securely for internal services.")
}

Rel(Envoy Proxy Router, Security & Authentication Filter, "Validates incoming user requests", "")
Rel(Security & Authentication Filter, Secrets and Credentials Manager, "Retrieves required credentials", "")

@enduml