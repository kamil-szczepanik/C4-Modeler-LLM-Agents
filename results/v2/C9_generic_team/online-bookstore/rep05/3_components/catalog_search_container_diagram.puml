@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(catalog_search_container, "Catalog & Search Container") {
    Component(Search_and_Browse_API_Controller, "Search and Browse API Controller", "Web Application/API Gateway, gRPC/REST over TLS", "Routes search and browse requests from the Web Application/API Gateway.")
    Component(Search_Service_Engine, "Search Service Engine", "AWS ECS/EKS, Protocol Buffers / gRPC", "Core logic for product discovery, keyword queries, and catalog browsing.")
    Component(Query_Caching_Manager, "Query Caching Manager", "AWS ElastiCache / Redis, TCP", "Caches high-frequency queries and exchange rates using in-memory read-through caching.")
    Component(Product_Index_Adapter, "Product Index Adapter", "AWS OpenSearch / Dedicated Data Store, TCP", "Queries the dedicated product index for sub-100ms keyword queries.")
    Component(Background_Indexing_Worker, "Background Indexing Worker", "Background Worker / Job Processing Container, AWS ECS/EKS", "Handles asynchronous background job processing and catalog synchronization.")
}

Rel(Search_and_Browse_API_Controller, Search_Service_Engine, "Delegates search and browse requests", "gRPC")
Rel(Search_Service_Engine, Query_Caching_Manager, "Checks and stores high-frequency queries and exchange rates", "TCP")
Rel(Search_Service_Engine, Product_Index_Adapter, "Queries product index for search results", "TCP")
Rel(Background_Indexing_Worker, Product_Index_Adapter, "Updates and maintains the product index", "TCP")

@enduml