@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(recommendation_container, "Recommendation Container") {
    Component(recommendation_controller, "Recommendation Controller", "AWS ECS/EKS, gRPC/REST", "Handles incoming recommendation requests from the Web Application/API Gateway.")
    Component(recommendation_service, "Recommendation Service", "Clean Architecture, CQRS", "Core business logic implementing CQRS pattern for processing recommendations.")
    Component(event_handler, "Event Handler", "AWS SQS/SNS", "Ingests asynchronous domain events from background workers.")
    Component(data_repository, "Data Repository", "Automatic retries, exponential backoff, jitter", "Manages read and write operations to the dedicated data store.")
    Component(cache_manager, "Cache Manager", "Redis/ElastiCache", "Pre-computes and caches recommendations to reduce latency.")
}

Rel(recommendation_controller, recommendation_service, "Delegates request processing")
Rel(event_handler, recommendation_service, "Forwards ingested domain events")
Rel(recommendation_service, data_repository, "Reads and writes recommendation data")
Rel(recommendation_service, cache_manager, "Serves pre-computed recommendations")
@enduml