@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Checkout & Order Container container

Container_Boundary("Checkout_Order_Container", "Checkout & Order Container") {
    Component(Checkout_Order_Container, "Checkout & Order Container", "AWS ECS/EKS", "Microservice responsible for secure financial transactions, order processing, and third-party logistics integrations.")
    ComponentDb(Dedicated_Data_Store, "Dedicated Data Store", "PostgreSQL", "ACID-compliant relational database ensuring strict consistency for financial transactions and order states.")
    Component(Background_Worker_Job_Processing_Container, "Background Worker / Job Processing Container", "AWS SQS/SNS with Dead Letter Queue", "Handles asynchronous messaging and decoupled background job processing.")
}

Component_Ext(Web_Application_API_Gateway, "Web Application / API Gateway", "Envoy Proxy", "Routes checkout and order requests to the container.")
Component_Ext(External_Payment_Gateway, "External Payment Gateway", "HTTPS", "External service that authorizes and processes financial transactions.")
Component_Ext(Tax_Calculation_Service, "Tax Calculation Service", "HTTPS", "External service that computes regional taxes.")
Component_Ext(Third_Party_Shipping_Provider, "Third-Party Shipping Provider", "HTTPS", "External service that initiates fulfillment and shipping.")
Component_Ext(Currency_Exchange_Rate_Service, "Currency Exchange Rate Service", "HTTPS", "External service that fetches conversion rates.")

Rel(Web_Application_API_Gateway, Checkout_Order_Container, "Routes checkout and order requests", "gRPC/REST over TLS")
Rel(Checkout_Order_Container, Dedicated_Data_Store, "Reads and writes order states and financial transactions", "SQL")
Rel(Checkout_Order_Container, External_Payment_Gateway, "Authorizes and processes financial transactions", "HTTPS")
Rel(Checkout_Order_Container, Tax_Calculation_Service, "Computes regional taxes", "HTTPS")
Rel(Checkout_Order_Container, Third_Party_Shipping_Provider, "Initiates fulfillment and shipping", "HTTPS")
Rel(Checkout_Order_Container, Currency_Exchange_Rate_Service, "Fetches conversion rates", "HTTPS")
Rel(Checkout_Order_Container, Background_Worker_Job_Processing_Container, "Publishes asynchronous tasks and events", "AWS SQS/SNS")
@enduml