@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Customer & Reviews Container container

Container_Boundary("Customer & Reviews Container", "Customer & Reviews Container") {
    Component(Customer_Profile_Domain, "Customer Profile Domain", "Microservice Component", "Manages strict PII and account settings.")
    Component(Reviews_Domain, "Reviews Domain", "Microservice Component", "Manages public book reviews and 5-star ratings.")
    Component(Background_Worker_Container, "Background Worker Container", "AWS ECS/EKS Container", "Executes data retention, anonymization, and Saga workflows.")
    Component(API_Gateway, "API Gateway", "AWS API Gateway", "Enforces rate limiting, Content Security Policy (CSP), and request routing.")
}

Rel(API_Gateway, Customer_Profile_Domain, "Manages customer profile and review interactions", "gRPC/REST over TLS")
Rel(API_Gateway, Reviews_Domain, "Manages customer profile and review interactions", "gRPC/REST over TLS")
Rel(Customer_Profile_Domain, Background_Worker_Container, "Publishes asynchronous events", "AWS SQS/SNS")
Rel(Reviews_Domain, Background_Worker_Container, "Publishes asynchronous events", "AWS SQS/SNS")

@enduml