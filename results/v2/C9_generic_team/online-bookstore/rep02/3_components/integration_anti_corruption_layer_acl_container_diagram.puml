@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration / Anti-Corruption Layer (ACL) Container container

System_Ext(Shipping_Providers, "Shipping Providers", "External shipping and fulfillment provider.")
System_Ext(FX_Rate_Provider, "FX Rate Provider", "External foreign exchange rate provider.")
System_Ext(Tax_Calculation_Service, "Tax Calculation Service", "External tax calculation service.")

Container_Boundary(acl_container_boundary, "Integration / Anti-Corruption Layer (ACL) Container") {
    Component(Shipping_Integration_Adapter, "Shipping Integration Adapter", "Java / Resilience4j", "Manages fulfillment and communication with external Shipping Providers with circuit breakers and bulkhead isolation.")
    Component(FX_Rate_Adapter, "FX Rate Adapter", "Java / Resilience4j", "Handles requests to the Foreign Exchange (FX) Rate Provider with token-bucket rate limiting.")
    Component(Tax_Calculation_Adapter, "Tax Calculation Adapter", "Java / Resilience4j", "Communicates with the Tax Calculation Service to compute accurate tax rates.")
}

Rel(Shipping_Integration_Adapter, Shipping_Providers, "Manages fulfillment", "HTTPS APIs with Resilience4j circuit breakers")
Rel(FX_Rate_Adapter, FX_Rate_Provider, "Fetches exchange rates", "HTTPS APIs with token-bucket rate limiting")
Rel(Tax_Calculation_Adapter, Tax_Calculation_Service, "Calculates taxes", "HTTPS APIs with bulkhead isolation")

@enduml