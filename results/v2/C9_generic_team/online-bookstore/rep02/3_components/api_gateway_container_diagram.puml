@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway Container container

Container_Boundary(api_gateway_container, "API Gateway Container") {
    Component(Router__Routing_Controller, "Router & Routing Controller", "AWS API Gateway", "Handles perimeter security, routing, and internal traffic distribution to core domain containers.")
    Component(Rate_Limiter__Idempotency_Validator, "Rate Limiter & Idempotency Validator", "AWS API Gateway / Redis", "Performs distributed rate limiting and idempotency tracking using the caching layer.")
    Component(Security__TLS_Termination_Filter, "Security & TLS Termination Filter", "AWS API Gateway (TLS/JWT)", "Handles TLS termination, JWT validation, and perimeter security checks.")
}

Rel(Security__TLS_Termination_Filter, Router__Routing_Controller, "Forwards validated and secure client requests")
Rel(Router__Routing_Controller, Rate_Limiter__Idempotency_Validator, "Validates rate limits and idempotency via Redis")

@enduml