@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Async Worker / Event Broker Container container

System_Ext(ThirdPartyShippingServices, "Third-Party Shipping Services", "External shipping provider services.")
System_Ext(AmazonS3, "Amazon S3", "Out-of-band storage for large event payloads via S3 URIs.")

Container_Boundary(AsyncWorkerEventBrokerContainer, "Async Worker / Event Broker Container") {
    Component(EventPublisher, "Event Publisher", "AWS MSK / Amazon EventBridge, CloudEvents, W3C Trace Context", "Publishes standardized event messages using CloudEvents and W3C Trace Context headers to the event broker.")
    Component(PayloadOffloader, "Payload Offloader", "Amazon S3", "Handles out-of-band storage for large event payloads via S3 URIs.")
    Component(ShippingIntegrationWorker, "Shipping Integration Worker", "HTTPS, Circuit Breaker, Token-Bucket Rate Limiting", "Processes async jobs to communicate with Third-Party Shipping Services using resilience patterns.")
}

Rel(EventPublisher, PayloadOffloader, "Stores large event payloads via S3 URIs")
Rel(PayloadOffloader, AmazonS3, "Persists large objects", "HTTPS / S3 API")
Rel(ShippingIntegrationWorker, ThirdPartyShippingServices, "Communicates via HTTPS with circuit breakers and token-bucket rate limiting", "HTTPS")

@enduml