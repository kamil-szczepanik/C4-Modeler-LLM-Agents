@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Domain Containers container

Container_Boundary(core_domain_containers, "Core Domain Containers") {
    Component(Catalogue_Component, "Catalogue Component", "Microservice Component / OpenAPI / Protobuf", "Manages product catalogue data and handles domain-specific requests.")
    Component(Cart_Checkout_Component, "Cart/Checkout Component", "Microservice Component / OpenAPI / Protobuf", "Handles shopping cart state, checkout processes, and related user actions.")
    Component(Recommendations_Component, "Recommendations Component", "Microservice Component / OpenAPI / Protobuf", "Generates personalized product recommendations for users.")
    Component(Reviews_Component, "Reviews Component", "Microservice Component / OpenAPI / Protobuf", "Manages customer reviews, ratings, and feedback.")
}

Rel(Catalogue_Component, Cart_Checkout_Component, "Provides product details for checkout", "Internal REST / gRPC")

@enduml