@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(background_job_scheduler_container, "Background Job Scheduler Container") {
    Component(Scheduler_Worker, "Scheduler Worker", "Cron worker / Scheduler", "Manages asynchronous batch tasks securely and reliably, coordinating with external systems and internal caching.")
    Component(Distributed_Lock_Manager, "Distributed Lock Manager", "Redis", "Provides distributed locking and session management to prevent duplicate job execution.")
    Component(Job_Definition_Provider, "Job Definition Provider", "AWS Systems Manager Parameter Store", "Stores externalized job definitions and dynamic cron expressions.")
}

Rel(Scheduler_Worker, Distributed_Lock_Manager, "Acquires distributed locks via TCP to prevent duplicate job execution", "TCP")
Rel(Scheduler_Worker, Job_Definition_Provider, "Retrieves externalized job definitions and dynamic cron expressions", "AWS SDK / HTTPS")

@enduml