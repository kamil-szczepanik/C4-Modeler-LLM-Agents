@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Frontend Container", "Frontend Container") {
    Component(spa, "Single Page Application (SPA)", "TypeScript / Client-Side Rendering", "Handles user interactions, browsing, purchasing, and reviewing books on the client side with end-to-end type safety.")
    Component(ssr, "Server-Side Rendering (SSR) Engine", "TypeScript / Node.js", "Renders initial pages on the server to ensure fast load times and optimized Core Web Vitals tracking.")
    Component(cdn, "Content Delivery Network (CDN) Integration", "CDN Edge Caching / CSP / SRI", "Delivers static and dynamic assets securely with OWASP Top-10 mitigation and aggressive edge caching.")
}

Rel(spa, ssr, "Hydrates and exchanges application state", "HTTPS")
Rel(ssr, cdn, "Serves cached assets and pages", "HTTPS")
@enduml