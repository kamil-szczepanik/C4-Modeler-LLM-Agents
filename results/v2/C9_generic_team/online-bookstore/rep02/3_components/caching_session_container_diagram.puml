@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Caching/Session Container

Container_Boundary(caching_session_container, "Caching/Session Container") {
    Component(RedisCacheEngine, "Redis Cache Engine", "Redis", "Handles high-frequency reads, writes, and secure customer sessions with in-memory performance and low-latency session/cache handling.")
    Component(CentralizedClientWrapper, "Centralized Client Wrapper", "Custom Client Wrapper", "Encapsulates connection pooling, circuit breakers, and 50KB payload limits for secure and resilient communication.")
    Component(SecurityAndConfigManager, "Security and Config Manager", "TLS & AUTH Tokens / AWS Secrets Manager", "Fetches and rotates authentication tokens and enforces TLS encryption for secure transit and compliance.")
}

System_Ext(AWSSecretsManager, "AWS Secrets Manager", "External secrets management service.")

Rel(CentralizedClientWrapper, RedisCacheEngine, "Executes high-frequency read and write operations via In-memory protocol with TLS encryption.", "In-memory / TLS")
Rel(SecurityAndConfigManager, RedisCacheEngine, "Provides authentication tokens and enforces secure transit.", "TLS & Auth")
Rel(SecurityAndConfigManager, AWSSecretsManager, "Fetches and rotates authentication tokens.", "HTTPS")

@enduml