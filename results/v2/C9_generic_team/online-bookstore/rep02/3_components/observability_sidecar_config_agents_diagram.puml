@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Observability Sidecar & Config Agents", "Observability Sidecar & Config Agents") {
    Component(Telemetry Collector, "Telemetry Collector", "OpenTelemetry Sidecar", "Handles standardized telemetry collection and exports metrics and traces.")
    Component(Configuration Agent, "Configuration Agent", "AWS Systems Manager Parameter Store Agent", "Retrieves and manages dynamic configuration updates for core containers.")
    Component(Secrets Manager Agent, "Secrets Manager Agent", "AWS Secrets Manager Agent", "Securely injects secrets and credentials into the core containers.")
}

Rel(Telemetry Collector, Configuration Agent, "Shares shared container runtime resources", "")
Rel(Configuration Agent, Secrets Manager Agent, "Coordinates secret and configuration synchronization", "")

@enduml