@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers, "Customers", "End users browsing, purchasing, and reviewing physical and electronic books.")

System(Online_Bookstore, "Online Bookstore", "A multi-region e-commerce platform built on AWS to sell physical and electronic books with recommendations and reviews, providing a scalable, secure, and globally performant shopping experience meeting strict compliance and availability standards.")

System_Ext(Third_party_Payment_Gateway, "Third-party Payment Gateway", "Handles secure checkout transactions.")
System_Ext(Shipping_Providers, "Shipping Providers", "Manages logistics and fulfillment.")
System_Ext(Identity_Compliance_Services, "Identity/Compliance Services", "Provides identity and compliance support.")
System_Ext(Notification_Services, "Notification Services", "Handles system notifications.")
System_Ext(Foreign_Exchange_FX_Rate_Provider, "Foreign Exchange (FX) Rate Provider", "Provides multi-currency conversion (USD, EUR, GBP).")
System_Ext(Tax_Calculation_Service, "Tax Calculation Service", "Calculates real-time taxes.")
System_Ext(Anti_Fraud_Risk_Assessment_Service, "Anti-Fraud / Risk Assessment Service", "Performs fraud and risk assessments.")
System_Ext(Book_Distributors_Inventory_Suppliers, "Book Distributors / Inventory Suppliers", "Manages real-time stock synchronization.")
System_Ext(Observability_Audit_Logging_Provider, "Observability/Audit Logging Provider", "Centralized SIEM and audit logging.")
System_Ext(CI_CD_Deployment_and_Configuration_Management, "CI/CD Deployment and Configuration Management", "Handles deployment and configuration management pipelines.")

Rel(Customers, Online_Bookstore, "Browsing, purchasing, and reviewing books", "HTTPS / WebSockets via AWS CloudFront CDN")
Rel(Online_Bookstore, Third_party_Payment_Gateway, "Secure checkout transactions", "HTTPS / REST API")
Rel(Online_Bookstore, Shipping_Providers, "Logistics and fulfillment", "HTTPS / REST API")
Rel(Online_Bookstore, Tax_Calculation_Service, "Real-time tax calculation", "HTTPS / REST API")
Rel(Online_Bookstore, Foreign_Exchange_FX_Rate_Provider, "Multi-currency conversion (USD, EUR, GBP)", "HTTPS / REST API")
Rel(Online_Bookstore, Book_Distributors_Inventory_Suppliers, "Real-time stock synchronization", "HTTPS / REST API")

@enduml