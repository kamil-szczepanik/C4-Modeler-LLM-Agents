@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore

Person(Customers, "Customers", "End-users browsing, purchasing, and reviewing books.")

System_Ext(Payment_Gateway, "Payment Gateway", "Handles secure checkout transactions.")
System_Ext(Shipping_Providers, "Shipping Providers", "Manages logistics and fulfillment.")
System_Ext(Identity_Compliance, "Identity/Compliance", "Provides identity and compliance support.")
System_Ext(FX_Provider, "FX Provider", "Provides multi-currency conversion.")
System_Ext(Tax_Service, "Tax Service", "Calculates real-time taxes.")
System_Ext(Anti_Fraud, "Anti-Fraud", "Performs fraud and risk assessments.")
System_Ext(Book_Distributors, "Book Distributors", "Manages real-time stock synchronization and inventory.")
System_Ext(Observability_Provider, "Observability Provider", "Centralized SIEM and audit logging.")
System_Ext(CICD, "CI/CD", "Handles deployment and configuration management pipelines.")

System_Boundary(Online_Bookstore, "Online Bookstore") {
    Container(API_Gateway_Container, "API Gateway Container", "AWS API Gateway / Reverse Proxy", "Handles rate limiting, TLS termination, and request routing.")
    Container(Frontend_Container, "Frontend Container", "SPA/SSR backed by CDN", "Delivers user interfaces via CDN.")
    Container(Core_Domain_Containers, "Core Domain Containers", "Microservices / REST / gRPC", "Includes Catalogue, Cart/Checkout, Recommendations, and Reviews services.")
    Container(Integration_ACL_Container, "Integration / Anti-Corruption Layer (ACL) Container", "Microservice / REST", "Encapsulates third-party APIs (FX, Tax, Shipping).")
    Container(Async_Worker_Event_Broker_Container, "Async Worker / Event Broker Container", "Event broker utilizing CloudEvents", "Manages asynchronous messaging and background processing.")
    ContainerDb(Caching_Session_Container, "Caching/Session Container", "Redis", "Handles high-frequency reads and user sessions.")
    Container(Background_Job_Scheduler_Container, "Background Job Scheduler Container", "Scheduler / Cron worker", "Executes periodic batch tasks.")
    Container(Observability_Sidecar_Config_Agents, "Observability Sidecar & Config Agents", "AWS Systems Manager Parameter Store / Secrets Manager agents", "Standardize telemetry and runtime secret injection.")
}

Rel(Customers, Frontend_Container, "Browsing, purchasing, and reviewing books", "HTTPS over TLS")
Rel(Frontend_Container, API_Gateway_Container, "API requests and routing", "HTTPS / REST")
Rel(API_Gateway_Container, Core_Domain_Containers, "Routes requests to microservices", "Internal REST / gRPC")
Rel(Core_Domain_Containers, Caching_Session_Container, "Reads and writes high-frequency data and sessions", "In-memory protocol (Redis)")
Rel(Core_Domain_Containers, Async_Worker_Event_Broker_Container, "Publishes and subscribes to asynchronous events", "Publish/Subscribe messaging (CloudEvents)")
Rel(Core_Domain_Containers, Integration_ACL_Container, "Requests third-party integrations", "Internal REST")
Rel(Integration_ACL_Container, Shipping_Providers, "Manages logistics and fulfillment", "HTTPS APIs")
Rel(Integration_ACL_Container, FX_Provider, "Retrieves currency exchange rates", "HTTPS APIs")
Rel(Integration_ACL_Container, Tax_Service, "Calculates taxes", "HTTPS APIs")

@enduml