@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers, "Customers", "End-users browsing catalogues, purchasing books, and leaving reviews.")
Person(Administrators_Content_Moderators, "Administrators/Content Moderators", "Internal operators managing catalogue data and moderating reviews.")
System(Online_Bookstore, "Online Bookstore", "A multi-region e-commerce platform built on AWS to sell physical and electronic books with integrated reviews and recommendations, providing a scalable, secure, and globally available shopping experience supporting high concurrency and multi-currency transactions.")
System_Ext(Payment_Gateway_Provider, "Payment Gateway Provider", "Stripe/PayPal for secure checkout and PCI-DSS compliance.")
System_Ext(Third_Party_Shipping_APIs, "Third-Party Shipping APIs", "External fulfillment services.")
System_Ext(Identity_Consent_Management_Provider, "Identity/Consent Management Provider", "GDPR & CCPA compliance tracking.")
System_Ext(Notification_Services, "Notification Services", "Email/SMS for alerts and password resets.")
System_Ext(Currency_Exchange_Rate_Provider, "Currency Exchange Rate Provider", "Dynamic rates for USD, EUR, and GBP.")
System_Ext(Monitoring_and_Observability_Provider, "Monitoring and Observability Provider", "APM and log aggregation SaaS.")

Rel(Customers, Online_Bookstore, "Interacts with the platform to browse catalogues, purchase books, and leave reviews", "HTTPS, REST/GraphQL")
Rel(Administrators_Content_Moderators, Online_Bookstore, "Manages the platform, catalogue data, and moderates reviews via secure administrative interfaces", "HTTPS")
Rel(Online_Bookstore, Payment_Gateway_Provider, "Integrates for secure checkout and payment processing", "HTTPS/TLS 1.3")
Rel(Online_Bookstore, Third_Party_Shipping_APIs, "Connects for fulfillment tracking", "HTTPS")
Rel(Online_Bookstore, Currency_Exchange_Rate_Provider, "Synchronizes multi-currency rates", "REST over HTTPS")
@enduml