@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore

Person(Customers, "Customers", "End-users browsing catalogues, purchasing books, and leaving reviews.")
Person(Administrators_Content_Moderators, "Administrators/Content Moderators", "Internal operators managing catalogue data and moderating reviews.")

System_Ext(Payment_Gateway, "Payment Gateway", "External system for secure checkout and payment processing.")
System_Ext(Third_Party_Shipping_APIs, "Third-Party Shipping APIs", "External fulfillment and shipping services.")
System_Ext(Identity_Consent_Management, "Identity/Consent Management", "External provider for GDPR and CCPA compliance tracking.")
System_Ext(Currency_Exchange, "Currency Exchange", "External provider for dynamic multi-currency rates.")
System_Ext(Monitoring_Provider, "Monitoring Provider", "SaaS provider for APM and log aggregation.")

System_Boundary(Online_Bookstore, "Online Bookstore") {
    Container(Single_Page_Application___Server_Side_Rendered_Frontend, "Single Page Application / Server-Side Rendered Frontend", "AWS S3 / CloudFront", "Edge/Client-Side container delivering the user interface.")
    Container(API_Gateway, "API Gateway", "AWS API Gateway", "Entry point handling TLS termination, rate limiting, and JWT validation.")
    Container(Catalog___Search, "Catalog & Search", "Docker / AWS ECS/EKS, OpenSearch", "Backend container for book catalog and search capabilities.")
    Container(Checkout___Order, "Checkout & Order", "Docker / AWS ECS/EKS, PostgreSQL", "Backend container for processing checkout and order transactions.")
    Container(Recommendations, "Recommendations", "Docker / AWS ECS/EKS", "Backend container providing personalized book recommendations.")
    Container(User___Reviews, "User & Reviews", "Docker / AWS ECS/EKS", "Backend container managing user accounts and book reviews.")
    Container(Async_Event_Bus, "Async Event Bus", "AWS EventBridge / Kafka", "Infrastructure container for asynchronous pub/sub messaging.")
    Container(Configuration___Secrets_Management, "Configuration & Secrets Management", "AWS Secrets Manager", "Infrastructure container managing configuration and credentials.")
    Container(Observability_Telemetry, "Observability/Telemetry", "OpenTelemetry sidecars", "Infrastructure containers for distributed tracing and monitoring.")
    ContainerDb(PostgreSQL_Database, "PostgreSQL Database", "PostgreSQL", "Data tier for ACID-compliant checkout transactions.")
    ContainerDb(OpenSearch_Database, "OpenSearch Database", "OpenSearch", "Data tier for catalog indexing and search.")
    ContainerDb(Redis_Cache, "Redis Cache", "Redis", "Data tier for cart and currency session caching.")
}

Rel(Customers, Single_Page_Application___Server_Side_Rendered_Frontend, "Accesses the platform UI", "HTTPS / TLS")
Rel(Administrators_Content_Moderators, Single_Page_Application___Server_Side_Rendered_Frontend, "Accesses administrative interfaces", "HTTPS / TLS")
Rel(Single_Page_Application___Server_Side_Rendered_Frontend, API_Gateway, "Sends API requests", "HTTPS / TLS")
Rel(API_Gateway, Catalog___Search, "Routes catalog requests", "Internal TLS / REST / gRPC")
Rel(API_Gateway, Checkout___Order, "Routes checkout requests", "Internal TLS / REST / gRPC")
Rel(API_Gateway, Recommendations, "Routes recommendation requests", "Internal TLS / REST / gRPC")
Rel(API_Gateway, User___Reviews, "Routes user and review requests", "Internal TLS / REST / gRPC")
Rel(Catalog___Search, Async_Event_Bus, "Publishes and consumes catalog events", "Asynchronous pub/sub messaging")
Rel(Checkout___Order, Async_Event_Bus, "Publishes and consumes order events", "Asynchronous pub/sub messaging")
Rel(Recommendations, Async_Event_Bus, "Publishes and consumes recommendation events", "Asynchronous pub/sub messaging")
Rel(User___Reviews, Async_Event_Bus, "Publishes and consumes user and review events", "Asynchronous pub/sub messaging")
Rel(Checkout___Order, PostgreSQL_Database, "Reads and writes transactional order data", "Native database protocols (SQL drivers)")
Rel(Catalog___Search, OpenSearch_Database, "Indexes and searches catalog data", "Native database protocols (NoSQL drivers)")
Rel(Checkout___Order, Redis_Cache, "Caches cart and currency data", "Redis drivers")
Rel(Catalog___Search, Payment_Gateway, "Interacts with external payment services", "HTTPS / REST APIs with centralized secrets")
Rel(Checkout___Order, Payment_Gateway, "Processes payments", "HTTPS / REST APIs with centralized secrets")
Rel(Checkout___Order, Third_Party_Shipping_APIs, "Sends fulfillment requests", "HTTPS / REST APIs with centralized secrets")
Rel(User___Reviews, Identity_Consent_Management, "Validates consent and identity compliance", "HTTPS / REST APIs with centralized secrets")
Rel(Checkout___Order, Currency_Exchange, "Fetches dynamic currency exchange rates", "HTTPS / REST APIs with centralized secrets")
Rel(Observability_Telemetry, Monitoring_Provider, "Exports telemetry and trace data", "HTTPS / REST APIs with centralized secrets")

@enduml