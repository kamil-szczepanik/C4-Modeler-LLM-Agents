@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(opensearch_database, "OpenSearch Database") {
    Component(Search_Indexing_Engine, "Search Indexing Engine", "OpenSearch Core", "Handles sub-2-second keyword catalog searches and data indexing.")
    Component(Backup_and_Snapshot_Manager, "Backup and Snapshot Manager", "AWS S3 / OpenSearch Snapshot API", "Manages snapshot backups of the search indexes to AWS S3.")
}

Rel(Search_Indexing_Engine, Backup_and_Snapshot_Manager, "Persists index backups", "OpenSearch Snapshot API")

@enduml