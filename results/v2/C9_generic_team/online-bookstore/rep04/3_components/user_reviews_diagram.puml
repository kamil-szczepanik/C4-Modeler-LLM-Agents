@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(user_and_reviews_container, "User & Reviews") {
    Component(UserAndReviewsController, "User & Reviews Controller", "Docker / AWS ECS/EKS", "Handles incoming user and review requests from the API Gateway.")
    Component(UserAndReviewsService, "User & Reviews Service", "Docker / AWS ECS/EKS", "Contains business logic for managing user profiles, reviews, and communicating with databases and event bus.")
}

Rel(UserAndReviewsController, UserAndReviewsService, "Delegates request handling and business logic execution")
@enduml