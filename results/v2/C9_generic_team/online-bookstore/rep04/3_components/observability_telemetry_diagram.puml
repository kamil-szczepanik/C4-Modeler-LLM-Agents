@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Observability/Telemetry container

Container_Boundary(observability_telemetry, "Observability/Telemetry") {
    Component(otel_sidecars, "OpenTelemetry Sidecars & Collectors", "OpenTelemetry (OTel), In-memory bounded queues with drop policies, W3C Trace Context", "Infrastructure containers deployed alongside microservices for telemetry capture, PII scrubbing, and non-blocking asynchronous export.")
    Component(config_plane, "Telemetry Configuration Management Plane", "AWS Systems Manager Parameter Store, AWS SDK / HTTPS", "Centralized repository for fetching dynamic sampling and configuration rules.")
    Component(observability_provider, "Monitoring and Observability Provider", "HTTPS / REST APIs", "External destination for exported traces, metrics, and logs.")
    Component(cicd_validation, "CI/CD Telemetry Validation", "Automated pipelines with mock collectors and schema validation", "Automated pipelines that validate telemetry schemas and configuration before deployment.")
}

Rel(otel_sidecars, observability_provider, "Export telemetry data", "HTTPS / REST APIs")
Rel(otel_sidecars, config_plane, "Fetch dynamic sampling and configuration rules", "AWS SDK / HTTPS")

@enduml