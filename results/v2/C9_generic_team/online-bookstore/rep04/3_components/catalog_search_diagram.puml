@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog & Search container

Container_Boundary("Catalog & Search", "Catalog & Search") {
    Component(Catalog_Search_Controller, "Catalog & Search Controller", "AWS ECS/EKS container using Hexagonal Architecture", "Handles incoming catalog and search requests routed from the API Gateway.")
    Component(Catalog_Search_Service, "Catalog & Search Service", "Hexagonal Architecture Business Logic", "Implements business rules for catalog management, search queries, and orchestrates caching and event publishing.")
}

Rel(Catalog_Search_Controller, Catalog_Search_Service, "Invokes business logic and operations", "")

@enduml