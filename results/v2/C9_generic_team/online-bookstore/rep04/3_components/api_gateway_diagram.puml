@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("API Gateway", "API Gateway") {
    Component("Router and Proxy", "Router and Proxy", "AWS API Gateway", "Routes incoming API requests to appropriate backend microservices across global regions.")
    Component("Security and Rate Limiting", "Security and Rate Limiting", "AWS API Gateway", "Handles JWT validation, rate limiting, and circuit breaking for incoming traffic.")
}

System_Ext("Catalog & Search", "Catalog & Search", "Backend microservice for catalog browsing and search.")
System_Ext("Checkout & Order", "Checkout & Order", "Backend microservice for secure checkout and orders.")
System_Ext("Recommendations", "Recommendations", "Backend microservice for personalized recommendations.")
System_Ext("User & Reviews", "User & Reviews", "Backend microservice for user accounts and reviews.")

Rel("Router and Proxy", "Catalog & Search", "Routes catalog requests", "Internal TLS / REST / gRPC")
Rel("Router and Proxy", "Checkout & Order", "Routes checkout requests", "Internal TLS / REST / gRPC")
Rel("Router and Proxy", "Recommendations", "Routes recommendation requests", "Internal TLS / REST / gRPC")
Rel("Router and Proxy", "User & Reviews", "Routes user and review requests", "Internal TLS / REST / gRPC")

@enduml