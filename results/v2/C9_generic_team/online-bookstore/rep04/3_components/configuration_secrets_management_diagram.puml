@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Configuration & Secrets Management", "Configuration & Secrets Management") {
    Component(Provider_Interface_Adapter, "Provider Interface Adapter", "Adapter Pattern", "Internal interface that microservices utilize to securely retrieve configuration and secrets.")
    Component(Parameter_Store_Integration, "Parameter Store Integration", "AWS Systems Manager Parameter Store", "Manages hierarchical, non-sensitive operational configurations with standard throughput.")
    Component(Secrets_Manager_Integration, "Secrets Manager Integration", "AWS Secrets Manager & AWS Lambda", "Handles sensitive credentials with automatic rotation driven by AWS Lambda.")
    Component(Schema_Validation_Engine, "Schema Validation Engine", "Pydantic / JSON Schema", "Enforces strict startup schema validation with a fail-fast mechanism.")
}

Rel(Provider_Interface_Adapter, Parameter_Store_Integration, "Retrieves operational configurations")
Rel(Provider_Interface_Adapter, Secrets_Manager_Integration, "Retrieves sensitive credentials")
Rel(Provider_Interface_Adapter, Schema_Validation_Engine, "Validates retrieved configurations and secrets on startup")
@enduml