@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(redis_cache, "Redis Cache") {
    Component(Session_Management_Component, "Session Management Component", "AWS ElastiCache Redis / Redis Data Structures", "Handles high-throughput cart and currency session operations for customers.")
    Component(Caching_Engine_Component, "Caching Engine Component", "Redis In-Memory Data Store", "Provides multi-AZ replication, automatic failover, and fast data retrieval for transient session data.")
}

Rel(Session_Management_Component, Caching_Engine_Component, "Reads and writes session and cart data", "Redis drivers with connection pooling")

@enduml