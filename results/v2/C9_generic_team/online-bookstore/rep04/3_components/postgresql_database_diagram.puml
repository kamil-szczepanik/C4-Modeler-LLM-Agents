@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(checkout_order_container, "Checkout & Order Container", "External Container")
System_Ext(application_microservices, "Application Microservices", "External Container")

Container_Boundary(postgresql_database, "PostgreSQL Database") {
    Component(PgBouncer, "PgBouncer", "PgBouncer", "Manages transactional SQL connections and connection pooling layer for 1 million MAU.")
    Component(Flyway_Liquibase, "Flyway / Liquibase", "Flyway / Liquibase", "Handles deterministic, version-controlled schema migrations across multi-region AWS environments.")
    Component(AWS_KMS, "AWS KMS", "AWS KMS", "Provides encryption at rest for database backups.")
    Component(Regional_Read_Replicas, "Regional Read-Replicas", "PostgreSQL streaming replication protocol", "Offloads read-heavy queries through asynchronous data replication.")
    Component(OpenTelemetry, "OpenTelemetry", "OpenTelemetry / PostgreSQL stats exporters", "Scrapes database health, metrics, slow queries, and health status.")
}

Rel(checkout_order_container, PgBouncer, "Manages transactional SQL connections", "Native database protocols (TCP/IP)")
Rel(application_microservices, PgBouncer, "Executes least-privilege, parameterized queries", "SQL drivers")
Rel(PgBouncer, postgresql_database, "Routes queries to primary database", "Internal SQL")
Rel(postgresql_database, Regional_Read_Replicas, "Asynchronous data replication", "PostgreSQL streaming replication protocol")
Rel(OpenTelemetry, postgresql_database, "Scrapes performance metrics, slow queries, and health status", "OpenTelemetry protocol (OTLP) / PostgreSQL stats exporters")
@enduml