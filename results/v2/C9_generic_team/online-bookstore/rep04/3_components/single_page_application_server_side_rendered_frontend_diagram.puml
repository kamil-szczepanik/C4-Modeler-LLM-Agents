@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("frontend_boundary", "Single Page Application / Server-Side Rendered Frontend") {
    Component("Router Component", "Router Component", "JavaScript / TypeScript", "Handles client-side routing and page transitions within the Single Page Application.")
    Component("UI View Components", "UI View Components", "React / Vue.js / HTML5", "Renders the user interface for browsing catalogs, managing user profiles, and viewing recommendations.")
    Component("API Client Component", "API Client Component", "Fetch API / Axios", "Manages secure HTTP/HTTPS communication, JWT/OAuth tokens, and requests sent to the API Gateway.")
}

System_Ext("API Gateway", "API Gateway", "AWS API Gateway")

Rel("Router Component", "UI View Components", "Loads and displays")
Rel("UI View Components", "API Client Component", "Triggers API requests via")
Rel("API Client Component", "API Gateway", "Sends HTTPS API requests using JWT/OAuth", "HTTPS / REST")

@enduml