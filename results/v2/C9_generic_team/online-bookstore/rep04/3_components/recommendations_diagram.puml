@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Recommendations container

Container_Boundary(Recommendations, "Recommendations") {
    Component(RecommendationController, "Recommendation Controller", "REST / gRPC", "Handles incoming recommendation requests routed from the API Gateway via Internal TLS.")
    Component(RecommendationService, "Recommendation Service", "Business Logic / Microservice Component", "Core logic for processing and generating book recommendations.")
    Component(EventPublisherConsumer, "Event Publisher/Consumer", "Async Event Bus (AWS EventBridge / Kafka)", "Publishes and consumes recommendation events via asynchronous pub/sub messaging.")
    Component(CacheManager, "Cache Manager", "Redis Client", "Fetches pre-computed recommendation payloads and tracks idempotent event processing via low-latency key-value lookups.")
    Component(RepositoryAdapter, "Repository Adapter", "Repository Pattern Abstraction", "Queries backup data stores when cache misses occur.")
}

Rel(RecommendationController, RecommendationService, "Delegates incoming recommendation requests")
Rel(RecommendationService, EventPublisherConsumer, "Publishes and consumes recommendation events")
Rel(RecommendationService, CacheManager, "Fetches pre-computed payloads and checks idempotency")
Rel(CacheManager, RepositoryAdapter, "Queries fallback data stores on cache misses via Repository pattern")

@enduml