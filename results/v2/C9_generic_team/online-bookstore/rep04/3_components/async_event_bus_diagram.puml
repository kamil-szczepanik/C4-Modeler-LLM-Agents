@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Async Event Bus", "Async Event Bus") {
    Component("Event Publisher", "Event Publisher", "AWS EventBridge / Kafka Producer", "Publishes domain events generated by core services to the event bus with JSON Schema validation.")
    Component("Event Consumer", "Event Consumer", "Kafka Consumer / EventBridge Rule Target", "Consumes asynchronous domain events and routes them to respective downstream services.")
    Component("Dead Letter Queue Handler", "Dead Letter Queue Handler", "AWS SQS DLQ", "Captures and stores failed or unprocessable event messages for later analysis and retry.")
}

Rel("Event Publisher", "Event Consumer", "Transmits domain events asynchronously", "Pub/Sub")
Rel("Event Consumer", "Dead Letter Queue Handler", "Routes failed message processing attempts", "HTTPS / AWS API")

@enduml