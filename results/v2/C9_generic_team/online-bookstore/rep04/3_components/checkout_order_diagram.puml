@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Checkout & Order container

Container_Boundary(checkout_order, "Checkout & Order") {
    Component(Checkout_API_Controller, "Checkout API Controller", "Docker / AWS ECS/EKS, REST / gRPC", "Routes checkout requests and handles incoming API traffic from the API Gateway.")
    Component(Order_Processing_Service, "Order Processing Service", "Docker / AWS ECS/EKS", "Orchestrates core checkout workflows, transactional messaging, and outbox patterns.")
    Component(Payment_Integration_Service, "Payment Integration Service", "HTTPS / REST APIs", "Processes payments securely interacting with external payment gateway providers.")
    Component(Shipping_Integration_Service, "Shipping Integration Service", "HTTPS / REST APIs", "Sends fulfillment requests to third-party shipping APIs.")
}

Rel(Checkout_API_Controller, Order_Processing_Service, "Delegates business logic and transaction processing", "Internal TLS / REST / gRPC")
Rel(Order_Processing_Service, Payment_Integration_Service, "Initiates payment transactions", "HTTPS / REST")
Rel(Order_Processing_Service, Shipping_Integration_Service, "Requests order fulfillment", "HTTPS / REST")

@enduml