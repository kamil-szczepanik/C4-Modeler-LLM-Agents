@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(LibraryUsersAndAdministrators, "Library Users and Administrators", "Users and administrators who interact with the system via self-service portals.")

System_Ext(ExternalIdentityProviders, "External Identity Providers", "External systems handling authentication using OAuth2/SAML.")
System_Ext(ThirdPartyHardwareInterfaces, "Third-Party Hardware Interfaces", "Barcode and RFID scanners and automated return sorting equipment.")
System_Ext(HighVolumePublisherFeeds, "High-Volume Publisher Feeds", "Feeds providing digital catalog data asynchronously.")
System_Ext(InterLibraryLoanNetworks, "Inter-Library Loan Networks", "External networks synchronizing state via bi-directional APIs.")
System_Ext(NotificationAndCommunicationGateways, "Notification and Communication Gateways", "EU-compliant SMS and email gateways.")
System_Ext(EUHostedObservabilityInfrastructure, "EU-Hosted Observability Infrastructure", "SIEM and APM tools for EU-compliant observability.")
System_Ext(ArchivalAndBackupStorageService, "Archival and Backup Storage Service", "Storage service for archives and backups.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(ClientSideApplicationContainer, "Client-Side Application Container", "Single Page App / Mobile App", "Provides self-service portals and user interfaces for library users and administrators.")
    Container(APIGatewayContainer, "API Gateway Container", "Reverse Proxy / API Gateway", "Routes synchronous internal calls and manages incoming client requests.")
    Container(CoreCatalogCirculationServiceContainer, "Core Catalog/Circulation Service Container", "Microservice", "Manages physical and digital item cataloging and circulation logic.")
    Container(SearchEngineContainer, "Search Engine Container", "Dedicated Indexing Engine", "Provides high-performance search capabilities ensuring 99th-percentile search response < 800 ms.")
    ContainerDb(CachingContainer, "Caching Container", "Redis", "Handles read-heavy library catalog browsing and reduces database load.")
    Container(MessageBrokerContainer, "Message Broker Container", "Message Broker", "Handles asynchronous event-driven workflows with publisher feeds and notification gateways.")
    Container(BackgroundWorkerContainer, "Background Worker Container", "Background Worker", "Processes asynchronous jobs independently from the Message Broker.")
    Container(ConfigurationandSecretsManagementContainer, "Configuration and Secrets Management Container", "Dynamic Runtime Injection", "Manages runtime injection for database connection strings and keys.")
    Container(TelemetrySidecarAgentContainer, "Telemetry Sidecar/Agent Container", "Sidecar Agent", "Exports sanitized operational metrics and logs exclusively to EU-Hosted Observability Infrastructure.")
}

Rel(LibraryUsersAndAdministrators, ClientSideApplicationContainer, "Interacts with via self-service portals", "HTTPS/TLS")
Rel(ClientSideApplicationContainer, APIGatewayContainer, "Connects via HTTPS/TLS termination", "HTTPS/TLS")
Rel(APIGatewayContainer, CoreCatalogCirculationServiceContainer, "Routes synchronous internal calls", "HTTP/gRPC")
Rel(APIGatewayContainer, SearchEngineContainer, "Routes search queries", "HTTP/gRPC")
Rel(CoreCatalogCirculationServiceContainer, CachingContainer, "Interacts for read-heavy query optimization", "Redis Protocol")
Rel(SearchEngineContainer, CachingContainer, "Interacts for query optimization", "Redis Protocol")
Rel(HighVolumePublisherFeeds, MessageBrokerContainer, "Ingests digital catalog data asynchronously", "Asynchronous Messaging")
Rel(MessageBrokerContainer, BackgroundWorkerContainer, "Triggers asynchronous job processing", "Message Queue")
Rel(MessageBrokerContainer, NotificationAndCommunicationGateways, "Dispatches asynchronous notifications", "Webhooks/SMTP")
Rel(TelemetrySidecarAgentContainer, EUHostedObservabilityInfrastructure, "Exports sanitized operational metrics and logs", "TLS Syslog/HTTPS")
Rel(ClientSideApplicationContainer, ExternalIdentityProviders, "Authenticates users", "OAuth2/SAML")
Rel(ThirdPartyHardwareInterfaces, APIGatewayContainer, "Connects for hardware integration", "Local Drivers/HTTP")
Rel(InterLibraryLoanNetworks, APIGatewayContainer, "Synchronizes state via bi-directional APIs", "Bi-directional APIs")
Rel(CoreCatalogCirculationServiceContainer, ArchivalAndBackupStorageService, "Offloads backups and archives", "Secure Storage Protocol")

@enduml