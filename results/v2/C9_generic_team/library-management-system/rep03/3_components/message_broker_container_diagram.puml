@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(message_broker_container, "Message Broker Container") {
    Component(Event_Broker_Core, "Event Broker Core", "Message Broker with Schema Registry (Avro/JSON Schema)", "Manages event-driven workflows, topic routing, and protocol validation.")
    Component(Dead_Letter_Queue_DLQ_Manager, "Dead Letter Queue (DLQ) Manager", "Message Broker DLQ Mechanism", "Captures and stores failed message deliveries for analysis and error handling.")
    Component(Trace_Propagation_Engine, "Trace Propagation Engine", "W3C Trace Context", "Propagates distributed tracing headers across asynchronous message flows.")
}

Rel(Event_Broker_Core, Dead_Letter_Queue_DLQ_Manager, "Routes unprocessable messages")
Rel(Event_Broker_Core, Trace_Propagation_Engine, "Injects and extracts trace contexts")

@enduml