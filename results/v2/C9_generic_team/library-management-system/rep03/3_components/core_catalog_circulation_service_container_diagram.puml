@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Catalog/Circulation Service Container container

Container_Boundary(core_catalog_circulation_service_container, "Core Catalog/Circulation Service Container") {
    Component(Domain_Models, "Domain Models", "Domain-Driven Design (DDD) Layers", "Encapsulates the business logic, entities, and value objects for library cataloging and circulation.")
    Component(Application_Services, "Application Services", "DDD Application Services", "Orchestrates use cases, coordinating domain models and infrastructure adapters.")
    Component(Infrastructure_Adapters, "Infrastructure Adapters", "Repository Pattern, Flyway/Liquibase, OpenAPI/Protobuf", "Manages persistence, database migrations on container startup, and external communication contracts.")
}

Rel(Application_Services, Domain_Models, "Executes business logic and workflows")
Rel(Application_Services, Infrastructure_Adapters, "Persists state and handles external messaging/caching")

@enduml