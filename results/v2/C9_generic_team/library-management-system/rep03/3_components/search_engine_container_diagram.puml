@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Search Engine Container container

Container_Boundary(search_engine_container, "Search Engine Container") {
    Component(search_indexer_and_query_processor, "Search Indexer and Query Processor", "Dedicated Indexing Engine with ILM and Alias Swapping", "Handles real-time search queries, processes asynchronous catalogue update events, and manages zero-downtime schema migrations.")
    Component(cache_manager, "Cache Manager", "Redis Client", "Interacts with the Caching Container to optimize queries and cache facets.")
    Component(telemetry_exporter, "Telemetry Exporter", "W3C Trace Context / Telemetry Agent", "Exports scrubbed query telemetry and W3C Trace Context to the EU-Hosted Observability Infrastructure.")
}

Rel(search_indexer_and_query_processor, cache_manager, "Optimizes queries and caches facets", "Redis Protocol")
Rel(search_indexer_and_query_processor, telemetry_exporter, "Exports scrubbed query telemetry and W3C Trace Context", "W3C Trace Context")

@enduml