@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Background Worker Container", "Background Worker Container") {
    Component(Asynchronous Job Processor, "Asynchronous Job Processor", "Idempotent Consumer Pattern & Dead Letter Queue (DLQ)", "Processes asynchronous workloads independently, preventing data corruption and quarantining persistently failing jobs.")
    Component(Telemetry Exporter, "Telemetry Exporter", "W3C Trace Context & Structured JSON Logging", "Exports runtime metrics and W3C trace context headers to the EU-Hosted Observability Infrastructure.")
    Component(External Communication Manager, "External Communication Manager", "Circuit Breaker & Backpressure", "Communicates with external systems utilizing rate-limiting, circuit breaker patterns, and backpressure to prevent cascading failures.")
    Component(Lifecycle Manager, "Lifecycle Manager", "Graceful Shutdown & Cancellation Tokens", "Intercepts SIGTERM signals and enforces hard timeouts to preserve task state during shutdowns.")
}

Rel(Asynchronous Job Processor, Telemetry Exporter, "Forwards trace context and structured logs")
Rel(Asynchronous Job Processor, External Communication Manager, "Invokes external systems via resilient patterns")

@enduml