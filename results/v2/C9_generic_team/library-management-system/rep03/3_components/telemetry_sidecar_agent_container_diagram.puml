@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Telemetry Sidecar/Agent Container container

Container_Boundary(telemetry_sidecar_agent_container, "Telemetry Sidecar/Agent Container") {
    Component(Telemetry_Agent, "Telemetry Agent", "OpenTelemetry (OTel)", "Standardized semantic conventions, structured JSON logging, and handling asynchronous batching via local disk buffering.")
    Component(Sanitization_and_Circuit_Breaker_Module, "Sanitization and Circuit Breaker Module", "Custom Go/Java Module with Circuit Breaker & Adaptive Sampling", "Performs PII sanitization, protects against resource exhaustion, and manages high-load log volumes.")
    Component(Lifecycle_Handler, "Lifecycle Handler", "Signal Handlers", "Intercepts SIGTERM for graceful shutdowns and buffer flushing.")
}

System_Ext(EU_Hosted_Observability_Infrastructure, "EU-Hosted Observability Infrastructure", "External observability platform.")
System_Ext(Configuration_and_Secrets_Management_Container, "Configuration and Secrets Management Container", "External configuration and secrets manager.")

Rel(Telemetry_Agent, EU_Hosted_Observability_Infrastructure, "Exports sanitized operational metrics and logs", "TLS Syslog/HTTPS with Gzip/Zstd compression")
Rel(Telemetry_Agent, Configuration_and_Secrets_Management_Container, "Reads runtime configuration and environment variables", "")
@enduml