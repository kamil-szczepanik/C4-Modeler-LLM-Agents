@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(config_secrets_container, "Configuration and Secrets Management Container") {
    Component(Configuration_Provider_Interface, "Configuration Provider Interface", "Standardized Configuration Provider Interface (Adapter Pattern)", "Decouples application code from the underlying secrets backend and handles dynamic runtime injection.")
    Component(Secrets_Management_Engine, "Secrets Management Engine", "HTTPS with X-Config-Version headers", "Manages secure access to secrets, ensuring immutable configuration versioning and compliance with EU data residency.")
}

Rel(Configuration_Provider_Interface, Secrets_Management_Engine, "Delegates configuration and secret retrieval", "HTTPS / X-Config-Version")

@enduml