@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Caching Container container

Container_Boundary("Caching Container", "Caching Container") {
    Component(InMemoryDataStore, "In-Memory Data Store", "Redis", "Provides low-latency, in-memory data storage, atomic operations, and automated eviction (allkeys-lru) with TTLs.")
    Component(CacheManagementandInvalidationController, "Cache Management and Invalidation Controller", "Redis Protocol", "Handles write invalidations, query optimizations, and distributed rate-limiting enforcement for incoming container requests.")
    Component(TelemetryForwarder, "Telemetry Forwarder", "Protocol Buffers / Compressed JSON", "Forwards telemetry, traces, and memory alerts to the EU-Hosted Observability Infrastructure.")
}

Rel(CacheManagementandInvalidationController, InMemoryDataStore, "Manages data storage, query optimization, and rate limiting using", "Redis Protocol")
Rel(CacheManagementandInvalidationController, TelemetryForwarder, "Feeds metrics and memory alerts to", "Internal")

@enduml