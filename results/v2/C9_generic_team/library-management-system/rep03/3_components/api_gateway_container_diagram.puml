@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_container, "API Gateway Container") {
    Component(Reverse_Proxy_and_Routing_Engine, "Reverse Proxy and Routing Engine", "Modular, plugin-based/middleware architecture", "Handles declarative routing, reverse proxy duties, and internal routing to the Core Catalog and Search Engine via gRPC.")
    Component(Edge_Validation_and_Contracts_Middleware, "Edge Validation and Contracts Middleware", "OpenAPI/Swagger", "Performs strict API schema validation at the gateway edge.")
    Component(Resilience_and_Caching_Middleware, "Resilience and Caching Middleware", "Redis", "Manages stale-while-revalidate fallback caching, rate limiting, and circuit breaking.")
    Component(Error_Handling_and_Tracing_Middleware, "Error Handling and Tracing Middleware", "RFC 7807 Problem Details and W3C Trace Context", "Handles standardized error formats and W3C Trace Context propagation for distributed tracing.")
    Component(Observability_and_Compliance_Middleware, "Observability and Compliance Middleware", "Prometheus format metrics and PII-redacted access logging", "Exposes metrics and routes PII-redacted access logs to EU-hosted observability infrastructure.")
}

Rel(Reverse_Proxy_and_Routing_Engine, Edge_Validation_and_Contracts_Middleware, "Validates incoming request schemas against OpenAPI/Swagger specs", "OpenAPI/Swagger")
Rel(Reverse_Proxy_and_Routing_Engine, Resilience_and_Caching_Middleware, "Applies rate limiting and checks Redis cache for stale-while-revalidate fallback", "Redis")
Rel(Reverse_Proxy_and_Routing_Engine, Error_Handling_and_Tracing_Middleware, "Propagates W3C Trace Context and formats errors using RFC 7807", "W3C / RFC 7807")
Rel(Reverse_Proxy_and_Routing_Engine, Observability_and_Compliance_Middleware, "Exposes Prometheus metrics and records PII-redacted access logs", "Prometheus / PII-redacted logs")

@enduml