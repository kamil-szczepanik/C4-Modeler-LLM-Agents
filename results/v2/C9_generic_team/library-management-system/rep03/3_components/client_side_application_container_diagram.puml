@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Client-Side Application Container container

Container_Boundary(client_side_application_container, "Client-Side Application Container") {
    Component(Self_Service_UI_Portal, "Self-Service UI Portal", "Single Page App / Mobile App", "Provides performant, secure, and resilient user interfaces for library users and administrators.")
    Component(Local_State_Caching_Module, "Local State Caching Module", "IndexedDB / SQLite", "Provides local state caching for offline-first resilience.")
    Component(API_Client_SDK, "API Client SDK", "OpenAPI", "Typed API client SDKs ensuring type safety across boundaries.")
    Component(Accessibility_Testing_Module, "Accessibility Testing Module", "axe-core", "Integrates automated accessibility testing for WCAG compliance.")
    Component(Security_Policy_Enforcement, "Security Policy Enforcement", "Strict Content Security Policy (CSP)", "Mitigates cross-site scripting (XSS) vulnerabilities.")
    Component(Dependency_Audit_Module, "Dependency Audit Module", "Software Composition Analysis (SCA)", "Audits third-party dependencies in the build pipeline.")
}

Rel(Self_Service_UI_Portal, Local_State_Caching_Module, "Caches state locally for offline-first resilience", "IndexedDB/SQLite")
Rel(Self_Service_UI_Portal, API_Client_SDK, "Invokes backend APIs with type safety", "OpenAPI")
Rel(Self_Service_UI_Portal, Accessibility_Testing_Module, "Validates UI components for accessibility compliance", "axe-core")
Rel(Self_Service_UI_Portal, Security_Policy_Enforcement, "Enforces security policies to mitigate XSS", "CSP")
Rel(Self_Service_UI_Portal, Dependency_Audit_Module, "Build-time auditing of third-party dependencies", "SCA")

@enduml