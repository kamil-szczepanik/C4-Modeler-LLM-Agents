@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(LibraryUsersAndAdministrators, "Library Users and Administrators", "Users and administrators who interact with the system via self-service portals.")

System(LibraryManagementSystem, "Library Management System", "Provides cataloging, circulation, and self-service portal capabilities for public and academic libraries while ensuring strict EU-only data residency and high-performance search responses.")

System_Ext(ExternalIdentityProviders, "External Identity Providers", "External systems handling authentication using OAuth2/SAML.")
System_Ext(ThirdPartyHardwareInterfaces, "Third-Party Hardware Interfaces", "Barcode and RFID scanners and automated return sorting equipment.")
System_Ext(HighVolumePublisherFeeds, "High-Volume Publisher Feeds", "Feeds providing digital catalog data asynchronously.")
System_Ext(InterLibraryLoanNetworks, "Inter-Library Loan Networks", "External networks synchronizing state via bi-directional APIs.")
System_Ext(NotificationAndCommunicationGateways, "Notification and Communication Gateways", "EU-compliant SMS and email gateways.")
System_Ext(EUHostedObservabilityInfrastructure, "EU-Hosted Observability Infrastructure", "SIEM and APM tools for EU-compliant observability.")
System_Ext(ArchivalAndBackupStorageService, "Archival and Backup Storage Service", "Storage service for archives and backups.")
System_Ext(ClientUpdateAndDistributionChannels, "Client Update and Distribution Channels", "CDNs and App stores for client updates and distribution.")
System_Ext(ExternalConfigurationAndFeatureFlagManagementService, "External Configuration and Feature Flag Management Service", "Service for external configuration and feature flag management.")

Rel(LibraryUsersAndAdministrators, LibraryManagementSystem, "Interact via self-service portals", "HTTPS/TLS")
Rel(LibraryManagementSystem, ExternalIdentityProviders, "Authenticates users", "OAuth2/SAML")
Rel(ThirdPartyHardwareInterfaces, LibraryManagementSystem, "Connects via local software drivers for barcode and RFID scanning", "Local Drivers")
Rel(HighVolumePublisherFeeds, LibraryManagementSystem, "Ingests digital catalog data asynchronously", "Asynchronous APIs")
Rel(InterLibraryLoanNetworks, LibraryManagementSystem, "Synchronizes state via bi-directional APIs", "Bi-directional APIs")
Rel(LibraryManagementSystem, NotificationAndCommunicationGateways, "Dispatches messages via secure webhooks and SMTP", "Secure Webhooks/SMTP")
Rel(LibraryManagementSystem, EUHostedObservabilityInfrastructure, "Ingests logs and metrics", "TLS Syslog/HTTPS")

@enduml