@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

TITLE System Context diagram for Library Management System

Person(Patrons_and_Library_Staff, "Patrons and Library Staff", "Human users who interact with the system to catalogue items, manage circulation, and use self-service portals.")
System(Library_Management_System, "Library Management System", "A solution for public and academic libraries to catalogue items and manage circulation, providing self-service portals while enforcing strict EU-only data residency.")
System_Ext(External_Identity_Providers_SSOOAuth, "External Identity Providers (SSO/OAuth)", "External systems providing authentication services via OIDC/OAuth.")
System_Ext(Payment_Gateways, "Payment Gateways", "External systems used for processing fees.")
System_Ext(External_ArchivalReporting_System, "External Archival/Reporting System", "External systems that receive compliance data exports via secure batch transfers.")

Rel(Patrons_and_Library_Staff, Library_Management_System, "Interact via API Gateway and self-service portals", "HTTPS")
Rel(Library_Management_System, External_Identity_Providers_SSOOAuth, "Authenticates users via federation", "OIDC / OAuth 2.0")
Rel(Library_Management_System, Payment_Gateways, "Processes fees", "HTTPS")
Rel(Library_Management_System, External_ArchivalReporting_System, "Exports compliance data", "Secure Batch Transfers")
@enduml