@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(search_engine_container, "Search Engine Container") {
    Component(Search_Indexer, "Search Indexer", "Elasticsearch / OpenSearch Indexing Engine", "Consumes catalog events to synchronize and build the search index.")
    Component(Query_Processor, "Query Processor", "Elasticsearch / OpenSearch Query API", "Executes versioned repository search queries to guarantee sub-800ms search performance.")
}

Rel(Search_Indexer, Query_Processor, "Updates index data for searching", "Internal")

@enduml