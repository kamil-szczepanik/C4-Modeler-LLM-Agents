@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Centralized Observability Container container

Container_Boundary(Centralized_Observability_Container, "Centralized Observability Container") {
    Component(OpenTelemetry_Collector, "OpenTelemetry Collector", "OpenTelemetry (OTel)", "Ingests metrics, logs, and traces asynchronously from upstream containers using OTel protocols with EU-only data residency and PII scrubbing.")
    Component(Observability_Platform_Backend, "Observability Platform Backend", "Observability Platform", "Processes and stores telemetry data, managing sliding-window retention and supporting dashboards and alert rules managed via Infrastructure-as-Code.")
}

Rel(OpenTelemetry_Collector, Observability_Platform_Backend, "Forwards ingested metrics, logs, and traces for processing and storage")
@enduml