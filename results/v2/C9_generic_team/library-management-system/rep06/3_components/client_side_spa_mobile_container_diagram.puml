@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Client-Side SPA/Mobile Container

Container_Boundary(client_side_container, "Client-Side SPA/Mobile Container") {
    Component(Patron Portal UI Component, "Patron Portal UI Component", "Web/Mobile Technologies, TypeScript", "Provides self-service portals and interfaces for patrons to browse catalogues and manage accounts.")
    Component(Staff App UI Component, "Staff App UI Component", "Web/Mobile Technologies, TypeScript", "Provides administrative and circulation management interfaces for library staff.")
    Component(State Management & Auth Component, "State Management & Auth Component", "OAuth 2.0 / OIDC, In-Memory Storage", "Handles token-based authentication and secure state management with in-memory storage for XSS mitigation.")
}

System(API Gateway Container, "API Gateway Container", "NGINX / Kong")

Rel(Patron Portal UI Component, API Gateway Container, "Sends API requests with correlation IDs", "HTTPS (REST/GraphQL)")
Rel(Staff App UI Component, API Gateway Container, "Sends API requests with correlation IDs", "HTTPS (REST/GraphQL)")

@enduml