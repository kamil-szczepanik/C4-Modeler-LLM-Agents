@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Background Workers Container container

System_Ext(Asynchronous_Message_Broker_Container, "Asynchronous Message Broker Container", "RabbitMQ or Kafka for event distribution, Dead Letter Queues (DLQ), and payload versioning")
System_Ext(Data_Access_Layer_Persistence_Container, "Data Access Layer / Persistence Container", "PostgreSQL")
System_Ext(Configuration_Secrets_Management_Container, "Configuration & Secrets Management Container", "HashiCorp Vault")
System_Ext(Centralized_Observability_Container, "Centralized Observability Container", "Observability Platform")

Container_Boundary(Background_Workers_Container, "Background Workers Container") {
    Component(Background_Worker_Runtime, "Background Worker Runtime", "Stateless worker architecture supporting graceful shutdowns, concurrency limits, and backpressure", "Asynchronously processes decoupled system tasks, job states, and domain data.")
}

Rel(Asynchronous_Message_Broker_Container, Background_Worker_Runtime, "Consumes asynchronous events via subscription", "Event Subscription")
Rel(Background_Worker_Runtime, Data_Access_Layer_Persistence_Container, "Reads and persists job states and domain data", "SQL / TCP")
Rel(Background_Worker_Runtime, Configuration_Secrets_Management_Container, "Fetches dynamic secrets and configuration", "HTTPS")
Rel(Background_Worker_Runtime, Centralized_Observability_Container, "Emits structured logs, traces, and metrics", "OTLP / HTTPS")
@enduml