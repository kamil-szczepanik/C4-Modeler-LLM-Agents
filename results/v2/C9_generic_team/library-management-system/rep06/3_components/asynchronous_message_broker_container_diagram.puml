@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(asynchronous_message_broker_container, "Asynchronous Message Broker Container") {
    Component(Message_Broker_Core, "Message Broker Core", "RabbitMQ / Kafka", "Handles asynchronous message brokering for decoupled event-driven processing and high throughput.")
    Component(Schema_Registry, "Schema Registry", "Avro / JSON Schema", "Manages schema contracts for domain event versioning and compatibility.")
    Component(Broker_Security_Manager, "Broker Security Manager", "HashiCorp Vault", "Manages configuration and secrets for secure broker access.")
}

Rel(Message_Broker_Core, Schema_Registry, "Validates event schemas", "Avro / JSON Schema")
Rel(Message_Broker_Core, Broker_Security_Manager, "Retrieves access credentials", "TLS encryption")

@enduml