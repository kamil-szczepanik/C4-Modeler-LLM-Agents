@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Access Layer / Persistence Container container

Container_Boundary(persistence_container, "Data Access Layer / Persistence Container") {
    Component(PostgreSQL_Database, "PostgreSQL Database", "PostgreSQL", "Provides secure, EU-resilient relational data persistence with ACID compliance.")
    Component(PgBouncer, "PgBouncer", "PgBouncer", "Manages connection routing and pooling to handle connection spikes.")
    Component(PostgreSQL_Read_Replicas, "PostgreSQL Read Replicas", "PostgreSQL", "Provides asynchronous replication for read-heavy queries.")
    Component(HashiCorp_Vault, "HashiCorp Vault", "HashiCorp Vault", "Handles envelope encryption key management.")
    Component(Flyway_Liquibase, "Flyway / Liquibase", "Flyway / Liquibase", "Automates version-controlled schema migrations.")
    Component(pgaudit, "pgaudit", "pgaudit", "Provides comprehensive audit logging for sensitive patron data.")
}

Rel(PgBouncer, PostgreSQL_Database, "Routes pooled connections to")
Rel(PostgreSQL_Database, PostgreSQL_Read_Replicas, "Replicates data asynchronously to")
Rel(PostgreSQL_Database, HashiCorp_Vault, "Retrieves envelope encryption keys from")

@enduml