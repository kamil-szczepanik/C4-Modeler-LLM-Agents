@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_container, "API Gateway Container") {
    Component(Perimeter Security & TLS Termination Component, "Perimeter Security & TLS Termination Component", "NGINX / Kong", "Manages perimeter security, TLS termination, and JWT validation.")
    Component(Routing & Resilience Component, "Routing & Resilience Component", "NGINX / Kong", "Handles request routing, fail-open rate limiting, and token-based residency claims.")
    Component(Rate-Limit State Cache Component, "Rate-Limit State Cache Component", "Redis", "Maintains partitioned rate-limit state caching to support performance.")
}

Rel(Perimeter Security & TLS Termination Component, Routing & Resilience Component, "Passes authenticated and validated requests")
Rel(Routing & Resilience Component, Rate-Limit State Cache Component, "Checks and updates rate-limit states")
@enduml