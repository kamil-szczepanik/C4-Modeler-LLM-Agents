@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Configuration & Secrets Management Container container

Container_Boundary(config_secrets_container, "Configuration & Secrets Management Container") {
    Component(Secrets_Management_Engine, "Secrets Management Engine", "HashiCorp Vault", "Secures sensitive credentials and handles dynamic secret generation strictly within EU infrastructure.")
    Component(Configuration_Validation_Service, "Configuration Validation Service", "JSON Schema / Pydantic", "Validates configuration payloads during container pre-flight checks to ensure system stability.")
}

Rel(Configuration_Validation_Service, Secrets_Management_Engine, "Retrieves configuration parameters and validated secrets", "Vault API/Sidecar Agents")

@enduml