@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Business Logic / Circulation API Container container

Container_Boundary(core_business_logic_circulation_api_container, "Core Business Logic / Circulation API Container") {
    Component(Loan Aggregate Component, "Loan Aggregate Component", "Domain-Driven Design / Microservice / API Runtime", "Manages core domain operations for loans and circulation logic adhering to strict EU data residency constraints.")
    Component(Patron Aggregate Component, "Patron Aggregate Component", "Domain-Driven Design / Microservice / API Runtime", "Manages patron domain data and behaviors within the core business logic.")
    Component(Item Aggregate Component, "Item Aggregate Component", "Domain-Driven Design / Microservice / API Runtime", "Manages item cataloging and inventory domain logic.")
    Component(API Controller / Endpoint Component, "API Controller / Endpoint Component", "OpenAPI / Protobuf / gRPC / HTTP", "Exposes contract-first APIs and routes verified requests for domain execution.")
    Component(Data Access Repository Component, "Data Access Repository Component", "Repository Pattern / Dependency Injection / TLS", "Decouples core domain logic from persistence and reads/writes relational data securely.")
    Component(Event Publisher Component, "Event Publisher Component", "AMQP / Kafka Protocol", "Publishes explicit domain events to the asynchronous message broker.")
}

Rel(API Controller / Endpoint Component, Loan Aggregate Component, "Routes verified API requests to loan domain logic")
Rel(API Controller / Endpoint Component, Patron Aggregate Component, "Routes verified API requests to patron domain logic")
Rel(API Controller / Endpoint Component, Item Aggregate Component, "Routes verified API requests to item domain logic")
Rel(Loan Aggregate Component, Data Access Repository Component, "Reads and writes relational data over TLS", "TLS")
Rel(Patron Aggregate Component, Data Access Repository Component, "Reads and writes relational data over TLS", "TLS")
Rel(Item Aggregate Component, Data Access Repository Component, "Reads and writes relational data over TLS", "TLS")
Rel(Loan Aggregate Component, Event Publisher Component, "Publishes domain events")

@enduml