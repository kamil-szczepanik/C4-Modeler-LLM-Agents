@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(Patrons_and_Library_Staff, "Patrons and Library Staff", "Human users who interact with the system to catalogue items, manage circulation, and use self-service portals.")

System_Ext(External_Identity_Providers_SSOOAuth, "External Identity Providers (SSO/OAuth)", "External systems providing authentication services via OIDC/OAuth.")
System_Ext(Payment_Gateways, "Payment Gateways", "External systems used for processing fees.")
System_Ext(External_ArchivalReporting_System, "External Archival/Reporting System", "External systems that receive compliance data exports via secure batch transfers.")

System_Boundary(Library_Management_System, "Library Management System") {
    Container(Client_Side_SPAMobile_Container, "Client-Side SPA/Mobile Container", "Web/Mobile Technologies", "Self-service portals and staff apps used by patrons and library staff.")
    Container(API_Gateway_Container, "API Gateway Container", "NGINX / Kong", "Handles rate limiting, TLS termination, and JWT validation.")
    Container(Core_Business_Logic__Circulation_API_Container, "Core Business Logic / Circulation API Container", "Microservice / API Runtime", "Handles core business logic and circulation management.")
    Container(Search_Engine_Container, "Search Engine Container", "Elasticsearch / OpenSearch", "Provides sub-800ms search performance for catalog items.")
    ContainerDb(Data_Access_Layer__Persistence_Container, "Data Access Layer / Persistence Container", "PostgreSQL", "Stores relational data, deployed exclusively within EU regions for data residency.")
    Container(Asynchronous_Message_Broker_Container, "Asynchronous Message Broker Container", "RabbitMQ / Kafka", "Handles decoupled event-driven processing.")
    Container(Background_Workers_Container, "Background Workers Container", "Background Worker Runtime", "Processes asynchronous background tasks via event subscription.")
    Container(Configuration__Secrets_Management_Container, "Configuration & Secrets Management Container", "HashiCorp Vault", "Manages secure credentials and configuration.")
    Container(Centralized_Observability_Container, "Centralized Observability Container", "Observability Platform", "Monitors system health, logs, and metrics.")
}

Rel(Patrons_and_Library_Staff, Client_Side_SPAMobile_Container, "Interacts with self-service portals and staff apps", "HTTPS")
Rel(Client_Side_SPAMobile_Container, API_Gateway_Container, "Sends API requests", "HTTPS (REST/GraphQL)")
Rel(API_Gateway_Container, Core_Business_Logic__Circulation_API_Container, "Routes verified API requests", "internal gRPC/HTTP")
Rel(Core_Business_Logic__Circulation_API_Container, Search_Engine_Container, "Queries and indexes catalog data for fast search", "REST/gRPC")
Rel(Core_Business_Logic__Circulation_API_Container, Data_Access_Layer__Persistence_Container, "Reads and writes relational data", "TLS")
Rel(Core_Business_Logic__Circulation_API_Container, Asynchronous_Message_Broker_Container, "Publishes domain events", "AMQP/Kafka Protocol")
Rel(Asynchronous_Message_Broker_Container, Background_Workers_Container, "Consumes events via subscription", "Event Subscription")
Rel(External_Identity_Providers_SSOOAuth, API_Gateway_Container, "Authenticates users", "OAuth2/OIDC")
Rel(Payment_Gateways, API_Gateway_Container, "Sends payment notifications", "HTTPS Webhooks")

@enduml