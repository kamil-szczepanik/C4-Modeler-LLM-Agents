@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Library Management System

Person(Library_Patrons_and_Staff, "Library Patrons and Staff", "Users who interact with the system for cataloguing, circulation, and self-service capabilities.")

System_Ext(Self_Service_Portals_and_Kiosks, "Self-Service Portals and Kiosks", "Interfaces used by patrons and staff to access library services.")
System_Ext(API_Gateway, "API Gateway", "Manages and routes traffic to core domain services with enforced geo-routing.")
System(Library_Management_System, "Library Management System", "Provides item cataloguing, circulation management, and self-service portals for public and academic libraries with strict EU data residency compliance and high-performance search capabilities.")
System_Ext(Core_Domain_Services, "Core Domain Services", "Core business logic services managing cataloguing and circulation.")
System_Ext(Dedicated_Search_Tier, "Dedicated Search Tier", "High-performance search tier achieving < 800ms p99 latency.")
System_Ext(Primary_Transactional_Datastore, "Primary Transactional Datastore", "Stores transactional data securely within the EU.")
System_Ext(EU_certified_Secrets_Management_Vault, "EU-certified Secrets Management Vault", "Secures storage and rotation of credentials, API keys, and certificates.")

Rel(Library_Patrons_and_Staff, Self_Service_Portals_and_Kiosks, "accesses portals via HTTPS", "HTTPS")
Rel(Self_Service_Portals_and_Kiosks, API_Gateway, "communicates using OpenAPI-defined REST contracts", "OpenAPI/REST")
Rel(API_Gateway, Core_Domain_Services, "routes traffic with enforced geo-routing", "HTTPS")
Rel(Core_Domain_Services, Dedicated_Search_Tier, "queries for catalogue searches achieving < 800ms p99 latency", "Network Protocol")
Rel(Core_Domain_Services, Primary_Transactional_Datastore, "persists transactional data strictly within the EU", "Database Protocol")

@enduml