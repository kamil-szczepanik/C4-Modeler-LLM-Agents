@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(Patrons_and_Staff, "Library Patrons and Staff", "Users who interact with the system for cataloguing, circulation, and self-service capabilities.")

System_Ext(Secrets_Vault, "EU-certified Secrets Management Vault", "Secures storage and rotation of credentials, API keys, and certificates.")

System_Boundary(Library_Management_System, "Library Management System") {
    Container(Portals_and_Kiosks, "Self-Service Portals and Kiosks", "Web/Mobile UI", "Interfaces used by patrons and staff to access library services.")
    Container(API_Gateway, "API Gateway", "API Gateway / HTTP/REST", "Manages and routes traffic to internal services with enforced geo-routing.")
    Container(BFF_Container, "API Composition / BFF Container", "HTTP/REST, OpenAPI", "Orchestrates client requests and payload shaping for front-end portals.")
    Container(Core_Domain_Services, "Core Domain Services", "Microservices / gRPC / REST", "Core business logic services managing cataloguing and circulation.")
    Container(Search_Tier, "Dedicated Search Tier", "Search Infrastructure", "High-performance search tier achieving < 800ms p99 latency.")
    ContainerDb(Primary_Datastore, "Primary Transactional Datastore", "Relational Database / SQL", "Stores transactional data securely within the EU.")
    ContainerDb(Caching_Layer, "Caching Layer (Redis)", "Redis / In-memory", "In-memory read acceleration of item availability and patron accounts.")
    Container(Event_Bus, "Asynchronous Event Bus (Message Broker)", "AMQP / Kafka", "Ensures decoupled, EU-compliant event-driven synchronization.")
    Container(Observability, "Observability & Logging Container", "Centralized metrics, tracing, log aggregation", "Monitors system health with PII masking.")
    Container(Migration_Backup, "Data Migration and Backup Container", "Backup & Migration tooling", "Manages data migration and backups within EU residency rules.")
    Container(Config_Container, "Configuration & Feature Management Container", "Feature flags & Configuration service", "Manages dynamic configuration and feature flags.")
    Container(Background_Worker, "Background Worker / Job Scheduling Container", "Job Scheduler / Worker", "Executes scheduled tasks against core domain services and primary datastore.")
}

Rel(Patrons_and_Staff, Portals_and_Kiosks, "accesses portals via HTTPS", "HTTPS")
Rel(Portals_and_Kiosks, API_Gateway, "communicates using HTTPS/REST", "HTTPS/REST")
Rel(API_Gateway, BFF_Container, "routes client traffic to BFF", "HTTP/REST")
Rel(BFF_Container, Core_Domain_Services, "interacts with core services", "gRPC/REST")
Rel(Core_Domain_Services, Caching_Layer, "queries caching layer", "TCP/SQL")
Rel(Core_Domain_Services, Primary_Datastore, "queries primary transactional datastore", "TCP/SQL")
Rel(Core_Domain_Services, Event_Bus, "publishes updates to event bus", "AMQP/Kafka")
Rel(Event_Bus, Search_Tier, "consumes events to update search indices", "Message Broker Protocol")
Rel(Background_Worker, Core_Domain_Services, "executes scheduled tasks", "Internal Protocol")
Rel(Background_Worker, Primary_Datastore, "executes scheduled data maintenance", "TCP/SQL")

@enduml