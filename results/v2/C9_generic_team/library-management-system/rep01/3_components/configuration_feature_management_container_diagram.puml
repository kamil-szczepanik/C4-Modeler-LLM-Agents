@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Configuration & Feature Management Container", "Configuration & Feature Management Container") {
    Component(ConfigurationManagementService, "Configuration Management Service", "Java / Spring Boot", "Handles configuration-as-code updates via GitOps pull-request workflows and serves read-only APIs.")
    Component(FeatureFlagEngine, "Feature Flag Engine", "JSON Schema / Protocol Buffers", "Manages feature flags and feature toggle evaluations with schema-per-version contracts for type safety.")
    Component(AuditEventEmitter, "Audit Event Emitter", "JSON / AMQP", "Emits structured audit events to the Observability & Logging Container for configuration changes.")
    Component(CacheInvalidationPublisher, "Cache Invalidation Publisher", "Redis Pub/Sub", "Publishes invalidation events via the Asynchronous Event Bus when configurations are updated.")
}

Rel(ConfigurationManagementService, AuditEventEmitter, "Emits structured audit events for configuration changes to", "JSON / AMQP")
Rel(ConfigurationManagementService, CacheInvalidationPublisher, "Publishes invalidation events via", "Redis Pub/Sub")
Rel(FeatureFlagEngine, CacheInvalidationPublisher, "Triggers cache invalidation upon feature state changes via", "Redis Pub/Sub")

@enduml