@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Primary Transactional Datastore container

Container_Boundary(primary_transactional_datastore, "Primary Transactional Datastore") {
    Component(Relational_Database_Engine, "Relational Database Engine", "Relational Database / SQL", "Ensures ACID compliance for circulation workflows and stores primary transactional data.")
    Component(Data_Storage_and_Indexing_Engine, "Data Storage and Indexing Engine", "SQL Storage Engine", "Manages persistent storage, transactions, and localized indexing for the transactional datastore.")
}

Rel(Relational_Database_Engine, Data_Storage_and_Indexing_Engine, "Persists and retrieves transactional data", "TCP/SQL")

@enduml