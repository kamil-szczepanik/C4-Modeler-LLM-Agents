@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Migration and Backup Container container

System_Ext(PrimaryTransactionaldatastore, "Primary Transactional Datastore", "Relational Database / SQL")
System_Ext(EUcertifiedSecretsManagementVault, "EU-certified Secrets Management Vault", "Secrets Management Vault")
System_Ext(ObservabilityLoggingContainer, "Observability & Logging Container", "Observability & Logging")

Container_Boundary(DataMigrationandBackupContainer, "Data Migration and Backup Container") {
    Component(MigrationandBackupWorkflowEngine, "Migration and Backup Workflow Engine", "YAML/JSON Manifest Processor", "Manages standardized migration and backup workflow manifests and automated validation.")
    Component(IntegrityandComplianceValidator, "Integrity and Compliance Validator", "Cryptographic checksums (SHA-256)", "Ensures payload integrity verification and strict compliance with EU-only data residency requirements.")
    Component(ResourceThrottlingandRateLimiter, "Resource Throttling and Rate-Limiter", "Container orchestration cgroups", "Applies hardware-level CPU and memory resource capping to protect core system performance under 800ms response targets.")
    Component(CredentialsManager, "Credentials Manager", "REST/TLS", "Integrates with EU-certified Secrets Management Vault for ephemeral credentials.")
}

Rel(MigrationandBackupWorkflowEngine, PrimaryTransactionaldatastore, "Communicates via SQL / JDBC with strict rate-limiting and throttling", "SQL / JDBC")
Rel(CredentialsManager, EUcertifiedSecretsManagementVault, "Interacts via REST/TLS for ephemeral credentials", "REST/TLS")
Rel(MigrationandBackupWorkflowEngine, ObservabilityLoggingContainer, "Emits logs via syslog / HTTPS", "syslog / HTTPS")

@enduml