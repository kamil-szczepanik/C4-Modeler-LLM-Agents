@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Composition / BFF Container container

Container_Boundary(api_composition_bff_container, "API Composition / BFF Container") {
    Component(request_router_and_orchestrator, "Request Router and Orchestrator", "Node.js / Vert.x / Go (Non-blocking I/O)", "Orchestrates client requests, handles payload shaping, and routes client traffic from the API Gateway.")
    Component(schema_validation_and_contract_enforcer, "Schema Validation and Contract Enforcer", "OpenAPI / Schema validation", "Enforces strict contracts and automated testing for incoming and outgoing payloads.")
    Component(fault_tolerance_manager, "Fault Tolerance Manager", "Circuit Breakers & RFC 7807", "Prevents cascading failures during heavy loads and standardizes error-handling and fault-normalization payloads.")
    Component(telemetry_instrumenter, "Telemetry Instrumenter", "OpenTelemetry", "Instruments distributed tracing across requests for monitoring and observability.")
}

Rel(request_router_and_orchestrator, schema_validation_and_contract_enforcer, "Validates request and response payloads", "OpenAPI")
Rel(request_router_and_orchestrator, fault_tolerance_manager, "Applies circuit breaker protection and fault normalization", "RFC 7807")
Rel(request_router_and_orchestrator, telemetry_instrumenter, "Sends tracing data for requests", "OpenTelemetry")

@enduml