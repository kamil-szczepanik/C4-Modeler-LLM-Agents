@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Observability & Logging Container container

Container_Boundary(observability_logging_container, "Observability & Logging Container") {
    Component(Telemetry_Processing_Service, "Telemetry Processing Service", "OpenTelemetry", "Processes centralized metrics, tracing, and log aggregation.")
    Component(Schema_Validation_Engine, "Schema Validation Engine", "JSON / Centralized Schema Registry", "Validates incoming telemetry against standardized schemas.")
    Component(Compliance_and_Archival_Manager, "Compliance and Archival Manager", "Active Storage & Cold Storage", "Manages compliance monitoring, PII masking, and cold storage archival.")
    Component(Application_Sidecars, "Application Sidecars", "Fluentd or Vector", "Provides asynchronous buffering, local disk spooling, and non-blocking log emission.")
    Component(Core_Domain_Services, "Core Domain Services", "JSON & OpenTelemetry", "Upstream producers of metrics, traces, and structured JSON logs.")
    Component(Observability_Dashboards, "Observability Dashboards", "Query Timeout & Resource Throttling Mechanisms", "Protected interfaces for operators to query and analyze system telemetry.")
}

Rel(Core_Domain_Services, Application_Sidecars, "Emits structured JSON logs and OpenTelemetry traces via local I/O.", "local I/O")
Rel(Application_Sidecars, Telemetry_Processing_Service, "Forwards telemetry over TLS 1.3 with asynchronous buffering.", "TLS 1.3")
Rel(Telemetry_Processing_Service, Schema_Validation_Engine, "Sends telemetry data for schema validation.", "")
Rel(Telemetry_Processing_Service, Compliance_and_Archival_Manager, "Routes data for compliance monitoring and archival storage.", "")
Rel(Observability_Dashboards, Telemetry_Processing_Service, "Queries telemetry data protected by query timeout and resource throttling.", "")

@enduml