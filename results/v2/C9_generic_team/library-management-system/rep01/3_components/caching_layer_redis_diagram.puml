@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Caching Layer (Redis) container

Container_Boundary(caching_layer_redis, "Caching Layer (Redis)") {
    Component(RedisInMemoryStore, "Redis In-Memory Store", "Redis", "In-memory data store for low-latency read acceleration and fast search response times.")
    Component(CacheManagementInterface, "Cache Management Interface", "RESP (REdis Serialization Protocol)", "Handles RESP over TCP communication with TLS for queries from Core Domain Services.")
    Component(SecretsAndCertificateHandler, "Secrets and Certificate Handler", "EU-certified Secrets Management Vault Integration", "Retrieves runtime TLS certificates and credentials enforcing EU data residency.")
}

Rel(CacheManagementInterface, RedisInMemoryStore, "Reads and writes cached data using RESP over TCP", "RESP")
Rel(SecretsAndCertificateHandler, RedisInMemoryStore, "Injects runtime TLS certificates and credentials", "TLS")

@enduml