@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(dedicated_search_tier, "Dedicated Search Tier") {
    Component(Search_Index_Service, "Search Index Service", "Search Infrastructure Engine with Versioned Indices", "Manages versioned search indices and executes low-latency search queries while guaranteeing a 99th-percentile response time under 800 ms.")
    Component(Idempotent_Event_Consumer, "Idempotent Event Consumer", "Message Broker Consumer Handler", "Consumes catalog events asynchronously from the event bus with idempotent handlers to update search indices.")
    Component(Resilience_Handler, "Resilience Handler", "Circuit Breaker and Bulkhead Engine", "Provides thread pool isolation, load shedding, and graceful degradation for search requests and event processing.")
    Component(Backup_and_Snapshot_Manager, "Backup and Snapshot Manager", "S3 API Client and HTTPS", "Manages strictly localized index backups and snapshots, transferring them securely to EU-certified object storage.")
}

Rel(Resilience_Handler, Search_Index_Service, "Protects search execution with circuit breakers and bulkhead patterns", "In-process")
Rel(Idempotent_Event_Consumer, Search_Index_Service, "Applies catalog updates to indices", "In-process")
Rel(Backup_and_Snapshot_Manager, Search_Index_Service, "Reads index data for backups", "In-process")

@enduml