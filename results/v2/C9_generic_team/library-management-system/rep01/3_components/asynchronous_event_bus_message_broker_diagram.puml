@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Asynchronous Event Bus (Message Broker) container

System_Ext(CoreDomainServices, "Core Domain Services", "External core domain services publishing events.")
System_Ext(DedicatedSearchTier, "Dedicated Search Tier", "Consumes events to maintain search indexes.")

Container_Boundary(AsynchronousEventBusMessageBroker, "Asynchronous Event Bus (Message Broker)") {
    Component(MessageBrokerCore, "Message Broker Core", "AMQP / Kafka", "Handles asynchronous message distribution, decoupling core domain services from the search tier while ensuring EU-compliant event-driven synchronization.")
    Component(SchemaRegistry, "Schema Registry", "Avro / JSON Schema", "Enforces standardized message payload compatibility across publishers and consumers.")
    Component(TransactionalOutboxProcessor, "Transactional Outbox Processor", "HTTP / gRPC", "Utilizes the transactional outbox pattern to reliably capture and publish updates from core domain services.")
    Component(SecurityandTraceabilityManager, "Security and Traceability Manager", "TLS mTLS and W3C Trace Context headers", "Enforces topic-level authorization, secure transport, and enables distributed tracing across asynchronous message boundaries.")
}

Rel(CoreDomainServices, MessageBrokerCore, "publishes updates", "AMQP/Kafka")
Rel(MessageBrokerCore, DedicatedSearchTier, "consumes events", "Message Broker Protocol")
Rel(CoreDomainServices, TransactionalOutboxProcessor, "utilizes transactional outbox pattern", "HTTP/gRPC")
@enduml