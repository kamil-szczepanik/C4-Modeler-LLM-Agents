@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(RoutingAndSecurityRouter, "Routing and Security Router", "HTTP/REST, TLS termination, OAuth2/JWT token introspection", "Serves as the single secure entry point enforcing routing, security, and performance constraints.")
    Component(CachingManager, "Caching Manager", "Redis, In-memory / TCP", "Handles caching and idempotency for mutating request protection.")
    Component(ObservabilityCollector, "Observability Collector", "W3C Trace Context, Prometheus-compatible /metrics endpoint", "Manages centralized metrics and tracing.")
    Component(ConfigurationManager, "Configuration Manager", "Dynamic declarative routing", "Manages dynamic declarative routing configurations.")
}

Rel(RoutingAndSecurityRouter, CachingManager, "Checks and stores cache data", "In-memory / TCP")
Rel(RoutingAndSecurityRouter, ObservabilityCollector, "Sends centralized metrics and tracing data", "W3C Trace Context")

@enduml