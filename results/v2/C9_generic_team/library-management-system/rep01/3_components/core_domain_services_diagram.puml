@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Domain Services container

Container_Boundary(core_domain_services, "Core Domain Services") {
    Component(Cataloguing_Controller, "Cataloguing Controller", "gRPC / REST", "Handles incoming requests related to cataloguing items within the library management system.")
    Component(Circulation_Controller, "Circulation Controller", "gRPC / REST", "Manages library circulation operations and user interactions.")
    Component(Domain_Service_Logic, "Domain Service Logic", "Hexagonal Architecture / Domain-Driven Design", "Encapsulates the core business rules and isolates domain logic from infrastructure.")
}

Rel(Cataloguing_Controller, Domain_Service_Logic, "Delegates cataloguing commands and queries")
Rel(Circulation_Controller, Domain_Service_Logic, "Delegates circulation operations")

@enduml