@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Background Worker / Job Scheduling Container container

Container_Boundary(background_worker___job_scheduling_container, "Background Worker / Job Scheduling Container") {
    Component(Job_Scheduler, "Job Scheduler", "Kubernetes CronJobs / Container Orchestration", "Executes scheduled tasks and batch data maintenance while enforcing EU-only data residency.")
    Component(Distributed_Lock_Manager, "Distributed Lock Manager", "Redis Caching Layer", "Acquires distributed locks to prevent duplicate concurrent execution of time-sensitive cron jobs.")
    Component(Event_Publisher___Consumer, "Event Publisher / Consumer", "Asynchronous Event Bus (Message Broker)", "Publishes and consumes scheduled job events using AMQP/Kafka with Dead Letter Queue (DLQ) processing.")
    Component(Data_Maintenance_Handler, "Data Maintenance Handler", "Relational Database / SQL", "Executes scheduled data maintenance and catalog/circulation processing against the primary transactional datastore.")
}

Rel(Job_Scheduler, Event_Publisher___Consumer, "Publishes/consumes scheduled job events", "AMQP/Kafka")
Rel(Job_Scheduler, Distributed_Lock_Manager, "Acquires distributed locks", "TCP/Redis Protocol")
Rel(Job_Scheduler, Data_Maintenance_Handler, "Executes scheduled data maintenance", "TCP/SQL")

@enduml