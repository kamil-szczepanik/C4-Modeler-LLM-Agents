@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(self_service_portals_and_kiosks, "Self-Service Portals and Kiosks") {
    Component(Web_and_Mobile_UI_Frontend, "Web and Mobile UI Frontend", "Modular component-driven design system", "Provides catalogue management, circulation, and self-service interfaces for library patrons and staff.")
    Component(Resilience_Handler, "Resilience Handler", "Circuit Breaker and Retry pattern with exponential backoff", "Handles transient network failures between clients and upstream services.")
    Component(Security_and_Storage_Manager, "Security and Storage Manager", "Strict CSP headers, XSS sanitization, zero-trust short-lived tokens, and encrypted IndexedDB", "Manages local storage, sanitization, and secure token handling on constrained kiosk hardware.")
    Component(Compliance_and_Telemetry_Redactor, "Compliance and Telemetry Redactor", "Client-side PII redaction", "Ensures EU-only data residency requirements by redacting telemetry before export.")
}

Rel(Web_and_Mobile_UI_Frontend, Resilience_Handler, "Routes network calls through")
Rel(Resilience_Handler, Security_and_Storage_Manager, "Validates and secures requests using")
Rel(Security_and_Storage_Manager, Compliance_and_Telemetry_Redactor, "Passes telemetry to")

@enduml