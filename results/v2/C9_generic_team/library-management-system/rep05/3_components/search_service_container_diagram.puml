@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(search_service_container, "Search Service Container") {
    Component(Search_Controller, "Search Controller", "HTTP REST API Framework", "Receives and validates incoming search queries from the Web App Container.")
    Component(Indexing_Consumer, "Indexing Consumer", "Message Consumer / Event Handler", "Consumes asynchronous events from the Message Broker Container for real-time indexing.")
    Component(Search_Engine_Core, "Search Engine Core", "Elasticsearch / OpenSearch", "Delivers fast, scalable search functionality ensuring 99th-percentile responses under 800ms.")
    Component(Cache_Manager, "Cache Manager", "Redis Client", "Interacts with the Distributed Cache Container to cache frequent catalogue lookups.")
    Component(Backup_Service, "Backup Service", "HTTPS Storage Client", "Stores automated index snapshots to EU-Hosted Backup and Archival Storage.")
}

Rel(Search_Controller, Search_Engine_Core, "Executes search queries", "HTTP")
Rel(Indexing_Consumer, Search_Engine_Core, "Indexes incoming event payloads", "Asynchronous Message Stream")
Rel(Search_Controller, Cache_Manager, "Checks and stores frequent catalogue lookups", "TCP")
Rel(Search_Engine_Core, Backup_Service, "Triggers automated index snapshots", "HTTPS")
@enduml