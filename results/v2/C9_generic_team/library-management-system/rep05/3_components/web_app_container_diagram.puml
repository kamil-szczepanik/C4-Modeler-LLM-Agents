@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web App Container container

System_Ext(SearchServiceContainer, "Search Service Container", "External System", "Search service")
System_Ext(DistributedCacheContainer, "Distributed Cache Container", "External System", "Distributed cache")
System_Ext(EnterpriseLoggingandMonitoringService, "Enterprise Logging and Monitoring Service", "External System", "Logging and monitoring service")

Container_Boundary(Web_App_Container, "Web App Container") {
    Component(WebApplicationFramework, "Web Application Framework", "Web Application Framework with SSR and Hydration", "Provides server-side rendering with hydration to balance SEO for catalogues with UI interactivity.")
}

Rel(WebApplicationFramework, SearchServiceContainer, "Serves search queries", "HTTP")
Rel(WebApplicationFramework, DistributedCacheContainer, "Manages sessions and caches catalogue queries", "Redis Protocol")
Rel(WebApplicationFramework, EnterpriseLoggingandMonitoringService, "Sends structured JSON logs and metrics", "HTTPS")

@enduml