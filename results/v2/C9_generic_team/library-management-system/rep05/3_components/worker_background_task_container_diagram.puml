@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(worker_container, "Worker / Background Task Container") {
    Component(JobConsumerComponent, "Job Consumer Component", "AMQP / Kafka Consumer", "Consumes background jobs using AMQP / Kafka protocols, powering priority queue partitioning, exponential backoffs, and Dead-Letter Queues (DLQs).")
    Component(StateManagementComponent, "State Management Component", "Redis Protocol Client", "Manages distributed locks, rate limiting, and stores idempotent state checkpoints using Redis.")
    Component(LegacySyncComponent, "Legacy Sync Component", "Scheduled Batch Protocols with Circuit Breakers", "Syncs data with external legacy ILS and campus ERP systems while protecting fragile legacy systems using circuit breakers.")
    Component(PayloadValidationComponent, "Payload Validation Component", "Protocol Buffers / JSON Schema", "Enforces structured payload versioning and backward-compatible data contracts.")
    Component(AutoscalingControllerComponent, "Autoscaling Controller Component", "Horizontal Pod Autoscaling (HPA)", "Dynamically scales workers based on queue depth and CPU metrics to preserve search performance SLAs.")
}

Rel(JobConsumerComponent, PayloadValidationComponent, "Validates incoming job payloads using", "")
Rel(JobConsumerComponent, StateManagementComponent, "Checks and updates execution state using", "")
Rel(JobConsumerComponent, LegacySyncComponent, "Triggers batched synchronization operations via", "")
Rel(AutoscalingControllerComponent, JobConsumerComponent, "Scales workers based on metrics from", "")
@enduml