@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Observability Sidecars container

Container_Boundary(observability_sidecars, "Observability Sidecars") {
    Component(OpenTelemetry_Collector_Agent, "OpenTelemetry Collector Agent", "OpenTelemetry Collector", "Acts as a standard sidecar pattern for local telemetry buffering, scrubbing, and dynamic pipeline reloading.")
    Component(Prometheus_Endpoint, "Prometheus Endpoint", "Prometheus", "Exposes Prometheus-compatible endpoints for internal metrics monitoring such as drop counters, queue depth, and export latency.")
    Component(Spooling_Buffer_Manager, "Spooling Buffer Manager", "Bounded local disk storage", "Handles backpressure management and data spooling during downstream outages.")
}

Rel(OpenTelemetry_Collector_Agent, Spooling_Buffer_Manager, "Routes invalid or unprocessable payloads to secure local storage via a dead-letter queue (DLQ) strategy", "DLQ")
Rel(Prometheus_Endpoint, OpenTelemetry_Collector_Agent, "Monitors internal metrics and operational health", "HTTP")

@enduml