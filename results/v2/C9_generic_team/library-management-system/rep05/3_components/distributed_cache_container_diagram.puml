@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Core Transactional Service Container, "Core Transactional Service Container", "External client container")
System_Ext(Enterprise Logging and Monitoring Service, "Enterprise Logging and Monitoring Service", "External monitoring system")

Container_Boundary(Distributed Cache, "Distributed Cache Container") {
    Component(Redis Cache Engine, "Redis Cache Engine", "Redis, AOF/RDB Persistence, Redis Protocol with TLS", "High-throughput, low-latency caching engine providing sub-800ms search performance and EU data residency compliance.")
    Component(Cache Management and Resilience Module, "Cache Management and Resilience Module", "Resilience4j / Polly, Protocol Buffers / Compressed JSON", "Handles connection pooling, circuit breaking, cache stampede prevention, and efficient payload serialization.")
    Component(Telemetry and Testing Adapter, "Telemetry and Testing Adapter", "Testcontainers", "Exports telemetry and metrics to the monitoring service and supports automated integration testing of caching logic.")
}

Rel(Core Transactional Service Container, Redis Cache Engine, "Caches and retrieves fast data", "Redis Protocol with TLS")
Rel(Redis Cache Engine, Enterprise Logging and Monitoring Service, "Exports telemetry and metrics", "")

@enduml