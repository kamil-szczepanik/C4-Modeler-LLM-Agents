@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Transactional Service Container container

Container_Boundary(core_transactional_service_container, "Core Transactional Service Container") {
    Component(circulation_and_cataloguing_module, "Circulation and Cataloguing Module", "Domain-Driven Design (DDD)", "Handles core business logic and modular monolith boundaries for circulation and cataloguing.")
    Component(transactional_outbox_processor, "Transactional Outbox Processor", "Transactional Outbox Pattern", "Ensures reliable event publishing without dual-write inconsistencies.")
    Component(concurrency_control_manager, "Concurrency Control Manager", "Optimistic Concurrency Control", "Handles high-contention item checkouts via version columns.")
}

Rel(circulation_and_cataloguing_module, transactional_outbox_processor, "Persists events for reliable publishing")
Rel(circulation_and_cataloguing_module, concurrency_control_manager, "Manages checkout consistency and versions")

@enduml