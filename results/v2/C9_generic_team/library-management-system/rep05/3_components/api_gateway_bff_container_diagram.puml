@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway / BFF Container container

System_Ext(Core_Transactional_Service_Container, "Core Transactional Service Container", "Core transactional service container")
System_Ext(Search_Service_Container, "Search Service Container", "Search service container")
System_Ext(Distributed_Cache_Container_Redis, "Distributed Cache Container (Redis)", "Distributed cache container (Redis)")

Container_Boundary(API_Gateway___BFF_Container, "API Gateway / BFF Container") {
    Component(Routing_Engine, "Routing Engine", "Custom routing engine with declarative configuration", "Handles client requests, route optimization, and traffic management.")
    Component(Authentication_Validator, "Authentication Validator", "OAuth2/OIDC integrated", "Secures traffic and validates authentication tokens for incoming requests.")
    Component(Session_Manager, "Session Manager", "Redis client", "Offloads session state and caching to the distributed cache.")
}

Rel(Routing_Engine, Core_Transactional_Service_Container, "Routes requests", "Internal REST/gRPC")
Rel(Routing_Engine, Search_Service_Container, "Routes search queries", "Internal REST/gRPC")
Rel(Session_Manager, Distributed_Cache_Container_Redis, "Offloads session state and caching", "TCP")

@enduml