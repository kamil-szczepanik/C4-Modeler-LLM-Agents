@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Message Broker Container container

Container_Boundary(message_broker_container, "Message Broker Container") {
    Component(Event_Publisher_Receiver, "Event Publisher Receiver", "RabbitMQ / Kafka", "Receives and decouples write operations from the Core Transactional Service.")
    Component(Event_Stream_Dispatcher, "Event Stream Dispatcher", "Asynchronous Message Stream", "Consumes and streams events to the Search Service Container for indexing.")
}

Rel(Event_Publisher_Receiver, Event_Stream_Dispatcher, "Routes and dispatches events for search indexing", "Asynchronous Message Stream")

@enduml