@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(Patrons, "Patrons", "Self-service portal users who interact with the system via HTTPS.")
Person(Staff, "Staff", "Library staff who interact with the system via HTTPS.")
Person(Librarians, "Librarians", "Librarians managing cataloging and circulation.")
Person(System_Administrators, "System Administrators", "Personnel responsible for managing and operating the system.")

System_Ext(External_Legacy_ILS, "External Legacy ILS", "Legacy Integrated Library System that syncs with workers.")
System_Ext(Identity_Providers, "Identity Providers", "External identity services for authentication.")
System_Ext(Payment_Gateways, "Payment Gateways", "External services for processing payments.")
System_Ext(WAF, "WAF", "Web Application Firewall providing protection.")

System_Boundary(Library_Management_System, "Library Management System") {
    Container(API_Gateway_BFF_Container, "API Gateway / BFF Container", "API Gateway / BFF", "Routes requests and acts as a backend-for-frontend.")
    Container(Web_App_Container, "Web App Container", "Web Application Framework", "Provides cataloging, circulation, and self-service portals.")
    Container(Core_Transactional_Service_Container, "Core Transactional Service Container", "Microservice / REST / gRPC", "Handles core business transactions and logic.")
    Container(Search_Service_Container, "Search Service Container", "Elasticsearch / OpenSearch", "Provides fast search functionality meeting sub-800ms requirements.")
    Container(Message_Broker_Container, "Message Broker Container", "RabbitMQ / Kafka", "Decouples writes and maintains indexing consistency asynchronously.")
    Container(Distributed_Cache_Container, "Distributed Cache Container", "Redis", "Maintains stateless application tiers and fast data access.")
    Container(Worker_Background_Task_Container, "Worker / Background Task Container", "Worker / Background Processor", "Handles background processing and syncing tasks.")
    Container(Observability_Sidecars, "Observability Sidecars", "Observability Sidecar", "Provides monitoring and telemetry for containers.")
}

Rel(Patrons, API_Gateway_BFF_Container, "Communicate via HTTPS", "HTTPS")
Rel(Staff, API_Gateway_BFF_Container, "Communicate via HTTPS", "HTTPS")
Rel(Librarians, API_Gateway_BFF_Container, "Communicate via HTTPS", "HTTPS")
Rel(System_Administrators, API_Gateway_BFF_Container, "Communicate via HTTPS", "HTTPS")

Rel(WAF, API_Gateway_BFF_Container, "Inspects and filters traffic", "HTTPS")
Rel(API_Gateway_BFF_Container, Web_App_Container, "Routes requests", "Internal REST/gRPC")
Rel(API_Gateway_BFF_Container, Core_Transactional_Service_Container, "Routes requests", "Internal REST/gRPC")
Rel(API_Gateway_BFF_Container, Identity_Providers, "Authenticates users", "OAuth2/OIDC")
Rel(API_Gateway_BFF_Container, Payment_Gateways, "Processes transactions", "HTTPS")

Rel(Core_Transactional_Service_Container, Message_Broker_Container, "Publishes events", "AMQP/Kafka protocol")
Rel(Core_Transactional_Service_Container, Distributed_Cache_Container, "Caches and retrieves fast data", "Redis Protocol")

Rel(Message_Broker_Container, Search_Service_Container, "Consumes events for indexing", "Asynchronous Message Stream")

Rel(Web_App_Container, Search_Service_Container, "Serves search queries", "HTTP")

Rel(Worker_Background_Task_Container, External_Legacy_ILS, "Syncs with legacy systems", "Scheduled Batch Protocols")

@enduml