@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patrons, "Patrons", "Self-service portal users who interact with the system via HTTPS through Edge/WAF.")
Person(Staff_and_Librarians, "Staff and Librarians", "Users who access core domain services via HTTPS.")
Person(System_Administrator_Operations, "System Administrator / Operations", "Personnel responsible for managing and operating the system.")

System(Library_Management_System, "Library Management System", "A solution for public and academic libraries to catalogue items, manage circulation, and provide self-service portals, adhering strictly to EU-only data residency constraints.")

System_Ext(Legacy_ILS_Campus_ERP_Systems, "Legacy ILS / Campus ERP Systems", "Legacy systems that sync with the core software system via REST/SOAP APIs.")
System_Ext(Identity_Providers_and_Payment_Gateways, "Identity Providers and Payment Gateways", "External services that integrate with the system via OAuth2/OIDC for identity federation.")
System_Ext(Edge_WAF, "Edge / WAF", "Web Application Firewall providing DDoS protection and latency optimization.")
System_Ext(Enterprise_Logging_and_Monitoring_Service, "Enterprise Logging and Monitoring Service", "Service used for system logging and monitoring.")
System_Ext(EU_Hosted_Backup_and_Archival_Storage, "EU-Hosted Backup and Archival Storage", "EU-hosted infrastructure for backup and archival storage.")
System_Ext(Network_Time_Protocol_NTP_service, "Network Time Protocol (NTP) service", "Service used for time synchronization across the system.")

Rel(Patrons, Library_Management_System, "Interact with the self-service portal", "HTTPS via Edge/WAF")
Rel(Staff_and_Librarians, Library_Management_System, "Access core domain services", "HTTPS")
Rel(Library_Management_System, Legacy_ILS_Campus_ERP_Systems, "Syncs data with legacy and campus systems", "REST/SOAP APIs")
Rel(Library_Management_System, Identity_Providers_and_Payment_Gateways, "Integrates for identity federation", "OAuth2/OIDC")
Rel(Library_Management_System, EU_Hosted_Backup_and_Archival_Storage, "Communicates with backup storage for data retention", "Encrypted transport protocols")

@enduml