@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(Client_User_Agent, "Client / User Agent", "Library patrons and staff accessing the self-service portals, catalog, and management features.")

System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "OAuth2/OIDC compliant service enforcing EU residency for authentication.")
System_Ext(Notification_Messaging_Service, "Notification / Messaging Service", "Service handling asynchronous webhooks and HTTPS for patron alerts.")
System_Ext(Monitoring_and_Telemetry_Aggregator, "Monitoring and Telemetry Aggregator", "EU-hosted APM and telemetry sink preventing PII export.")
System_Ext(Disaster_Recovery_Backup_Target, "Disaster Recovery / Backup Target", "Encrypted scheduled replication and region-locked backups.")

System_Boundary(Library_Management_System, "Library Management System") {
    Container(Web_Frontend, "Web Frontend", "React / HTML / JavaScript", "Web-based user interface for clients to access portals and catalog.")
    Container(Mobile_App, "Mobile App", "Native / Cross-Platform Mobile", "Mobile application for clients to access catalog and circulation features.")
    Container(API_Gateway_Container, "API Gateway Container", "OCI-compliant Container, Envoy / NGINX", "Entry point for client traffic, routing requests to core microservices.")
    Container(Data_Routing_Compliance_Proxy, "Data Routing / Compliance Proxy", "OCI-compliant Container", "Ensures strict EU data residency compliance and proxying.")
    Container(Catalog_Management, "Catalog Management", "OCI-compliant Container, Spring Boot", "Handles item cataloging and metadata management.")
    Container(Circulation, "Circulation", "OCI-compliant Container, Spring Boot", "Manages lending, returns, and circulation workflows.")
    Container(User_Portals, "User Portals", "OCI-compliant Container, Spring Boot", "Provides self-service portal backend features for users.")
    Container(Elasticsearch_OpenSearch_Search_Container, "Elasticsearch / OpenSearch Search Container", "Elasticsearch / OpenSearch", "Decouples search queries to meet high-performance search requirements.")
    Container(Redis_Distributed_Cache_Container, "Redis Distributed Cache Container", "Redis", "Absorbs read spikes as a distributed cache and manages stateless session data.")
    Container(Isolated_Microservice_Databases, "Isolated Microservice Databases", "Relational/NoSQL Database", "Explicit database isolation ensuring compliance with EU data residency.")
    Container(Asynchronous_Message_Broker_Container, "Asynchronous Message Broker Container", "RabbitMQ / Kafka", "Handles asynchronous event publishing and consumption between microservices.")
    Container(Centralized_Configuration_Store, "Centralized Configuration Store", "Consul / Spring Cloud Config", "Centralizes configuration to maintain immutable image builds.")
    Container(Log_Metrics_Collector_Agent, "Log/Metrics Collector Agent", "OTel Collector / Fluentd", "Forwards structured JSON logs and metrics to monitoring.")
}

Rel(Client_User_Agent, Web_Frontend, "Interacts with", "HTTPS/REST")
Rel(Client_User_Agent, Mobile_App, "Interacts with", "HTTPS/REST")
Rel(Web_Frontend, API_Gateway_Container, "Sends requests to", "HTTPS/REST")
Rel(Mobile_App, API_Gateway_Container, "Sends requests to", "HTTPS/REST")
Rel(API_Gateway_Container, Catalog_Management, "Routes traffic to", "gRPC/REST")
Rel(API_Gateway_Container, Circulation, "Routes traffic to", "gRPC/REST")
Rel(API_Gateway_Container, User_Portals, "Routes traffic to", "gRPC/REST")
Rel(Catalog_Management, Redis_Distributed_Cache_Container, "Queries cache", "TCP")
Rel(Circulation, Redis_Distributed_Cache_Container, "Queries cache", "TCP")
Rel(User_Portals, Redis_Distributed_Cache_Container, "Queries cache", "TCP")
Rel(Catalog_Management, Elasticsearch_OpenSearch_Search_Container, "Queries search index", "TCP")
Rel(Circulation, Elasticsearch_OpenSearch_Search_Container, "Queries search index", "TCP")
Rel(Catalog_Management, Isolated_Microservice_Databases, "Reads and writes data", "SQL/TCP")
Rel(Circulation, Isolated_Microservice_Databases, "Reads and writes data", "SQL/TCP")
Rel(User_Portals, Isolated_Microservice_Databases, "Reads and writes data", "SQL/TCP")
Rel(Catalog_Management, Asynchronous_Message_Broker_Container, "Publishes/consumes events", "AMQP/TCP")
Rel(Circulation, Asynchronous_Message_Broker_Container, "Publishes/consumes events", "AMQP/TCP")
Rel(User_Portals, Asynchronous_Message_Broker_Container, "Publishes/consumes events", "AMQP/TCP")
Rel(Log_Metrics_Collector_Agent, Monitoring_and_Telemetry_Aggregator, "Forwards structured JSON logs", "TLS")

@enduml