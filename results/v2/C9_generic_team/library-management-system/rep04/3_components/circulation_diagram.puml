@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Circulation container

Container_Boundary(Circulation, "Circulation") {
    Component(CirculationComponent, "Circulation Component", "OCI-compliant Container, Spring Boot", "Handles high-concurrency lending, returns, and inventory state transitions using robust distributed systems patterns.")
    Component(IsolatedMicroserviceDatabase, "Isolated Microservice Database", "Relational/NoSQL Database", "Stores transactional data securely with isolated microservice boundary.")
    Component(AsynchronousMessageBrokerContainer, "Asynchronous Message Broker Container", "RabbitMQ / Kafka", "Publishes domain events via AMQP/TCP using the Transactional Outbox Pattern.")
    Component(RedisDistributedCacheContainer, "Redis Distributed Cache Container", "Redis", "Queries cached session data via TCP with strict TTLs and PII scrubbing.")
}

Component(ApiGatewayContainer, "API Gateway Container", "Envoy / NGINX", "Routes traffic using gRPC/REST with correlation ID propagation.")
Component(NotificationMessagingService, "Notification / Messaging Service", "Messaging Service", "Triggers external notifications protected by Resilience4j circuit breakers.")

Rel(ApiGatewayContainer, CirculationComponent, "Routes traffic", "gRPC/REST with correlation ID propagation")
Rel(CirculationComponent, IsolatedMicroserviceDatabase, "Reads and writes transactional data", "SQL/TCP with Optimistic Locking")
Rel(CirculationComponent, AsynchronousMessageBrokerContainer, "Publishes domain events (ItemLent, ItemReturned)", "AMQP/TCP using Transactional Outbox Pattern")
Rel(CirculationComponent, RedisDistributedCacheContainer, "Queries cached session data", "TCP with strict TTLs and PII scrubbing")
Rel(CirculationComponent, NotificationMessagingService, "Triggers external notifications", "Protected by Resilience4j circuit breakers")

@enduml