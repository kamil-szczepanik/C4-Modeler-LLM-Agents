@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway Container container

Person(Web Frontend, "Web Frontend", "React, HTML, JavaScript")
Person(Mobile App, "Mobile App", "Native / Cross-Platform")

System_Ext(Catalog Management, "Catalog Management", "Spring Boot microservice")
System_Ext(Circulation, "Circulation", "Spring Boot microservice")
System_Ext(User Portals, "User Portals", "Spring Boot microservice")
System_Ext(Redis Distributed Cache, "Redis Distributed Cache", "Redis Distributed Cache")

Container_Boundary("API Gateway Container", "API Gateway Container") {
    Component(Routing and Proxy Module, "Routing and Proxy Module", "Envoy / NGINX (OCI-compliant)", "Securely routes, validates, and optimizes client traffic from the Web Frontend and Mobile App to core microservices.")
    Component(Security and TLS Termination Module, "Security and TLS Termination Module", "Envoy / NGINX", "Handles TLS termination, IP whitelisting, and enforces strict request size and payload limits at the edge.")
    Component(Rate Limiting and Caching Module, "Rate Limiting and Caching Module", "Redis Distributed Cache (RESP/TCP)", "Implements token bucket algorithms and manages distributed state for rate limiting and traffic management.")
    Component(Validation and Error Handling Module, "Validation and Error Handling Module", "OpenAPI / JSON Schema, RFC 7807", "Ensures standardized payloads and handles error structures using Problem Details.")
    Component(Observability and Telemetry Agent, "Observability and Telemetry Agent", "W3C Trace Context, OTel Collector", "Captures and propagates distributed tracing and telemetry data for inbound and outbound traffic.")
}

Rel(Web Frontend, Routing and Proxy Module, "Sends client traffic", "HTTPS/REST")
Rel(Mobile App, Routing and Proxy Module, "Sends client traffic", "HTTPS/REST")
Rel(Security and TLS Termination Module, Routing and Proxy Module, "Terminates TLS and enforces security policies")
Rel(Routing and Proxy Module, Rate Limiting and Caching Module, "Queries token bucket and distributed state", "RESP/TCP")
Rel(Routing and Proxy Module, Validation and Error Handling Module, "Validates incoming payloads")
Rel(Routing and Proxy Module, Catalog Management, "Routes requests", "gRPC/REST")
Rel(Routing and Proxy Module, Circulation, "Routes requests", "gRPC/REST")
Rel(Routing and Proxy Module, User Portals, "Routes requests", "gRPC/REST")
Rel(Routing and Proxy Module, Redis Distributed Cache, "Communicates for caching", "RESP/TCP")

@enduml