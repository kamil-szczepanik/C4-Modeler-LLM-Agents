@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Log/Metrics Collector Agent container

Container_Boundary(log_metrics_collector_agent_boundary, "Log/Metrics Collector Agent") {
    Component(Log/Metrics_Collector_Agent, "Log/Metrics Collector Agent", "OTel Collector / Fluentd", "Collects logs and metrics, executes PII sanitization at the source, and provides local disk-backed buffering.")
}

System_Ext(Monitoring_and_Telemetry_Aggregator, "Monitoring and Telemetry Aggregator", "Aggregates telemetry data.")
System_Ext(Centralized_Configuration_Store, "Centralized Configuration Store", "Stores externalized parsing and sanitization rules.")

Rel(Log/Metrics_Collector_Agent, Monitoring_and_Telemetry_Aggregator, "Forwards structured JSON logs and metrics via TLS", "TLS")
Rel(Log/Metrics_Collector_Agent, Centralized_Configuration_Store, "Fetches externalized parsing and sanitization rules via API/RPC", "API/RPC")

@enduml