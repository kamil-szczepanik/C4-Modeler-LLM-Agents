@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Frontend container

Container_Boundary(web_frontend, "Web Frontend") {
    Component(Core_UI_Framework, "Core UI Framework", "React / HTML / JavaScript (Storybook, Custom Hooks)", "Core UI framework providing component-driven development and data-fetching abstraction.")
    Component(Runtime_Reverse_Proxy, "Runtime Reverse-Proxy", "NGINX", "Hosts local static assets, polyfills, and fonts with enforced Content Security Policies.")
    Component(Testing_and_Compliance_Suite, "Testing and Compliance Suite", "Jest, React Testing Library, Playwright, Cypress, axe-core", "Handles unit, integration, E2E smoke testing, and automated accessibility (a11y) testing for WCAG compliance.")
}

Rel(Core_UI_Framework, Runtime_Reverse_Proxy, "Serves static assets and routes traffic through")

@enduml