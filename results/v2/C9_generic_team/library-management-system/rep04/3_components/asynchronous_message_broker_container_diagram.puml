@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Asynchronous Message Broker Container container

System_Ext(CatalogManagement, "Catalog Management", "Spring Boot Microservice")
System_Ext(Circulation, "Circulation", "Spring Boot Microservice")
System_Ext(UserPortals, "User Portals", "Spring Boot Microservice")
System_Ext(LogMetricsCollectorAgent, "Log/Metrics Collector Agent", "Supporting Infrastructure")

Container_Boundary(AsynchronousMessageBrokerContainer, "Asynchronous Message Broker Container") {
    Component(MessageBroker, "Message Broker", "RabbitMQ / Kafka", "Handles asynchronous event streaming with multi-node clustering for high availability and strict EU-only data residency.")
    Component(SchemaRegistry, "Schema Registry", "Schema Registry / AsyncAPI", "Enforces strict message payload governance to prevent silent integration failures.")
    Component(MetricsExporter, "Metrics Exporter", "Prometheus", "Collects broker metrics including consumer lag, queue depth, and throughput.")
}

Rel(CatalogManagement, MessageBroker, "Publishes/consumes events", "AMQP/TCP")
Rel(Circulation, MessageBroker, "Publishes/consumes events", "AMQP/TCP")
Rel(UserPortals, MessageBroker, "Publishes/consumes events", "AMQP/TCP")
Rel(MessageBroker, LogMetricsCollectorAgent, "Exports Prometheus-compatible metrics", "HTTP/TCP")

@enduml