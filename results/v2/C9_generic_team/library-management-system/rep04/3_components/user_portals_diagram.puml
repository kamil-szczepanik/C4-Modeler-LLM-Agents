@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(user_portals, "User Portals") {
    Component(RepositoryLayer, "Repository Layer", "Spring Boot", "Implements data persistence and retrieval patterns for EU-hosted data.")
    Component(ServiceLayer, "Service Layer", "Spring Boot", "Contains core business logic, orchestrating calls to cache, database, and message broker.")
    Component(ExceptionHandler, "Exception Handler", "RFC 7807", "Provides standardized Problem Details for global exception handling and error mapping.")
    Component(HealthProbe, "Health Probe", "Spring Boot Actuator", "Provides liveness, readiness, and startup probes for OCI container orchestration.")
}

Rel(ServiceLayer, RepositoryLayer, "Queries and updates data")
Rel(ServiceLayer, ExceptionHandler, "Maps errors to RFC 7807 problem details")

@enduml