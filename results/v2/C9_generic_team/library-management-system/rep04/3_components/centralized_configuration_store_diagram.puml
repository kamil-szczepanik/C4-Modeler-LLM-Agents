@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(CentralizedConfigurationStore, "Centralized Configuration Store") {
    Component(ConfigurationServer, "Configuration Server", "Spring Cloud Config", "Serves immutable configurations to client containers and maintains centralized configuration state.")
    Component(KeyValueStoreBackend, "Key-Value Store Backend", "Consul", "Provides the underlying data store for configuration management and supports immutable image builds and data residency requirements.")
}

Rel(ConfigurationServer, KeyValueStoreBackend, "Fetches and persists configuration data", "TCP")

@enduml