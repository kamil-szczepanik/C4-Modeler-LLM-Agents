@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(isolated_microservice_databases, "Isolated Microservice Databases") {
    Component(Catalog_Management_Database, "Catalog Management Database", "Relational/NoSQL Database", "Stores catalog and bibliographic data with strict EU-only data residency.")
    Component(Circulation_Database, "Circulation Database", "Relational/NoSQL Database", "Stores circulation, checkout, and patron transaction records.")
    Component(User_Portals_Database, "User Portals Database", "Relational/NoSQL Database", "Stores user profiles, preferences, and portal session data.")
}

Rel(Catalog_Management_Database, Circulation_Database, "Synchronizes bibliographic state")

@enduml