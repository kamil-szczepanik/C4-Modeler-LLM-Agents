@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Routing / Compliance Proxy container

Container_Boundary(data_routing_compliance_proxy_container, "Data Routing / Compliance Proxy") {
    Component(Data_Routing__Compliance_Proxy, "Data Routing / Compliance Proxy", "OCI-compliant Container", "Manages ingress traffic for the Library Management System, enforcing strict EU-only data residency and protecting performance SLAs.")
    Component(Redis_Distributed_Cache_Container, "Redis Distributed Cache Container", "Redis", "Enables low-latency compliance rule lookups and distributed rate limiting.")
    Component(RabbitMQ___Kafka_Asynchronous_Message_Broker_Container, "RabbitMQ / Kafka Asynchronous Message Broker Container", "RabbitMQ / Kafka", "Supports asynchronous dead-letter queue integration for non-blocking compliance auditing.")
    Component(Consul___Spring_Cloud_Config_Centralized_Configuration_Store, "Consul / Spring Cloud Config Centralized Configuration Store", "Consul / Spring Cloud Config", "Facilitates dynamic, zero-downtime updates to routing tables and geo-IP lists.")
    Component(Monitoring_and_Telemetry_Aggregator, "Monitoring and Telemetry Aggregator", "Telemetry Tools", "Aggregates monitoring and telemetry data.")
    Component(Catalog_Management, "Catalog Management", "Downstream Service", "Handles catalog management downstream services.")
    Component(Circulation, "Circulation", "Downstream Service", "Handles circulation downstream services.")
}

Rel(Client_Portals, Data_Routing__Compliance_Proxy, "Routes requests via HTTPS/REST", "HTTPS/REST")
Rel(Data_Routing__Compliance_Proxy, Redis_Distributed_Cache_Container, "Performs lookups and rate limiting via RESP (REdis Serialization Protocol)", "RESP")
Rel(Data_Routing__Compliance_Proxy, RabbitMQ___Kafka_Asynchronous_Message_Broker_Container, "Sends compliance auditing messages via AMQP/Kafka Protocol", "AMQP/Kafka")
Rel(Data_Routing__Compliance_Proxy, Consul___Spring_Cloud_Config_Centralized_Configuration_Store, "Fetches configuration updates via HTTP/gRPC", "HTTP/gRPC")

@enduml