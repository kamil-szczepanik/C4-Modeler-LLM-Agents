@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog Management container

System_Ext(API_Gateway, "API Gateway", "Envoy/NGINX proxy handling ingress traffic.")
System_Ext(Redis_Distributed_Cache_Container, "Redis Distributed Cache Container", "Redis", "Cache-Aside pattern for low-latency queries")
System_Ext(Elasticsearch_OpenSearch_Search_Container, "Elasticsearch / OpenSearch Search Container", "Elasticsearch / OpenSearch", "High-performance item catalog search")
System_Ext(Isolated_Microservice Databases, "Isolated Microservice Databases", "Database", "Persists core catalog data with automated schema versioning")
System_Ext(Asynchronous_Message_Broker_Container, "Asynchronous Message Broker Container", "RabbitMQ / Kafka", "Asynchronous event-driven decoupling for writes")

Container_Boundary(Catalog_Management_boundary, "Catalog Management") {
    Component(Catalog_Management, "Catalog Management", "Spring Boot", "Handles cataloging operations, enterprise patterns, data access, and messaging abstractions.")
}

Rel(API_Gateway, Catalog_Management, "Routes traffic", "gRPC/REST")
Rel(Catalog_Management, Redis_Distributed_Cache_Container, "Queries cache", "TCP")
Rel(Catalog_Management, Elasticsearch_OpenSearch_Search_Container, "Queries search index", "TCP")
Rel(Catalog_Management, Isolated_Microservice Databases, "Reads and writes data", "SQL/TCP")
Rel(Catalog_Management, Asynchronous_Message_Broker_Container, "Publishes/consumes events", "AMQP/TCP")

@enduml