@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Redis Distributed Cache Container container

System_Ext(catalog_service, "Catalog Management Service (Spring Boot)", "Microservice querying cache")
System_Ext(circulation_service, "Circulation Service (Spring Boot)", "Microservice querying cache")
System_Ext(user_portals_service, "User Portals Service (Spring Boot)", "Microservice querying cache")
System_Ext(message_broker, "Asynchronous Message Broker Container (RabbitMQ / Kafka)", "Event broker for cache-busting and invalidation messaging")

Container_Boundary(redis_container, "Redis Distributed Cache Container") {
    Component(distributed_cache_store, "Distributed Cache Store", "Redis", "Absorbs read spikes and manages session data to meet <800ms search latency while enforcing EU data residency.")
    Component(session_manager, "Session Manager", "Redis Session Engine", "Isolates and manages user session data securely within EU constraints.")
    Component(cache_invalidation_listener, "Cache Invalidation Listener", "Redis Pub/Sub Subscriber", "Listens for event-driven cache-busting and invalidation messages from the message broker.")
}

Rel(catalog_service, distributed_cache_store, "Queries cache", "TCP")
Rel(circulation_service, distributed_cache_store, "Queries cache", "TCP")
Rel(user_portals_service, distributed_cache_store, "Queries cache", "TCP")
Rel(message_broker, cache_invalidation_listener, "Pub/sub cache invalidation events", "TCP")

@enduml