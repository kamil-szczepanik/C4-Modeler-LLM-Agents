@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Mobile App container

Person(Client_User_Agent, "Client / User Agent", "Native / Cross-Platform Mobile UI", "Serves as the client interface for users to access search and circulation features.")

Container_Boundary(Mobile_App_Container, "Mobile App") {
    Component(Mobile_App, "Mobile App", "Native / Cross-Platform Mobile", "Container boundary representation for the mobile application.")
    Component(Local_Storage_Manager, "Local Storage Manager", "SQLite / Secure Key-Value Stores, Android Keystore / iOS Keychain", "Provides localized caching for offline support and secures tokens and credentials.")
    Component(Background_Sync_Manager, "Background Sync Manager", "WorkManager / BackgroundTasks", "Manages resource-aware background synchronization.")
}

System(API_Gateway_Container, "API Gateway Container", "Envoy / NGINX", "Handles incoming requests from the mobile app.")
System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "OAuth2 / OIDC", "Authenticates mobile app users and secures tokens.")
System_Ext(Monitoring_and_Telemetry_Aggregator, "Monitoring and Telemetry Aggregator", "OpenTelemetry / APM", "Aggregates logs and metrics from the mobile application.")

Rel(Client_User_Agent, Mobile_App, "Interacts", "HTTPS/REST")
Rel(Mobile_App, API_Gateway_Container, "Sends requests", "HTTPS/REST")
Rel(Identity_Provider_IdP, Mobile_App, "Authenticates", "OAuth2/OIDC")
Rel(Mobile_App, Monitoring_and_Telemetry_Aggregator, "Forwards telemetry", "OpenTelemetry/APM")
Rel(Mobile_App, Local_Storage_Manager, "Caches data and secures tokens", "Internal")
Rel(Mobile_App, Background_Sync_Manager, "Triggers background sync", "Internal")

@enduml