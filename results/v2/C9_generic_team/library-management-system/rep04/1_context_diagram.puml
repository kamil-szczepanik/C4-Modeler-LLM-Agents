@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(ClientUserAgent, "Client / User Agent", "Library patrons and staff accessing the self-service portals, catalog, and management features.")
System(LibraryManagementSystem, "Library Management System", "A solution for public and academic libraries to catalogue items, manage circulation, and provide self-service portals with strict EU-only data residency and high-performance search.")
System_Ext(IdentityProviderIdP, "Identity Provider (IdP)", "OAuth2/OIDC compliant service enforcing EU residency for authentication.")
System_Ext(NotificationMessagingService, "Notification / Messaging Service", "Service handling asynchronous webhooks and HTTPS for patron alerts.")
System_Ext(MonitoringandTelemetryAggregator, "Monitoring and Telemetry Aggregator", "EU-hosted APM and telemetry sink preventing PII export.")
System_Ext(DisasterRecoveryBackupTarget, "Disaster Recovery / Backup Target", "Encrypted scheduled replication and region-locked backups.")

Rel(ClientUserAgent, LibraryManagementSystem, "Accesses portals, catalog, and circulation features", "HTTPS/TLS")
Rel(LibraryManagementSystem, IdentityProviderIdP, "Authenticates users", "OAuth2/OIDC")
Rel(LibraryManagementSystem, NotificationMessagingService, "Sends patron alerts", "Asynchronous webhooks/HTTPS")
Rel(LibraryManagementSystem, MonitoringandTelemetryAggregator, "Sends telemetry data", "Localized syslog/OTLP")
Rel(LibraryManagementSystem, DisasterRecoveryBackupTarget, "Replicates data for backups", "Encrypted scheduled replication")

@enduml