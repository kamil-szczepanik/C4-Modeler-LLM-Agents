@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Self-Service Patrons, "Self-Service Patrons", "Patrons who interact with the system for searching and self-service portals.")
Person(Library Staff, "Library Staff", "Staff members who interact with the system for administrative catalogue management and circulation.")

System(Library Management System, "Library Management System", "A solution for public and academic libraries to catalogue physical and digital items, manage circulation, and provide self-service portals with strict EU-only data residency.")

System_Ext(External Notification Systems, "External Notification Systems", "EU-compliant email/SMS gateways.")
System_Ext(Third-Party Digital Content Providers, "Third-Party Digital Content Providers", "Providers of digital content integrated with the library system.")
System_Ext(Time Synchronization/Scheduling Service, "Time Synchronization/Scheduling Service", "Service for time synchronization and scheduling.")
System_Ext(Centralized Audit and Logging System, "Centralized Audit and Logging System", "System for streaming logs and telemetry.")
System_Ext(Identity and Access Management (IAM) Provider, "Identity and Access Management (IAM) Provider", "Provider utilizing OAuth2/OIDC for authentication and RBAC.")
System_Ext(External Data Migration/Import System, "External Data Migration/Import System", "System for external data migration and importing.")
System_Ext(Archival and Long-Term Data Retention System, "Archival and Long-Term Data Retention System", "Storage solutions for statutory record retention.")
System_Ext(Disaster Recovery and Backup Storage, "Disaster Recovery and Backup Storage", "EU-certified cloud storage for backups and disaster recovery.")

Rel(Self-Service Patrons, Library Management System, "Interacts for searching and self-service portals", "HTTPS/REST")
Rel(Library Staff, Library Management System, "Interacts for administrative catalogue management and circulation", "HTTPS/REST")
Rel(Library Management System, External Notification Systems, "Integrates for sending notifications", "SMTP/SMPP")
Rel(Library Management System, Third-Party Digital Content Providers, "Communicates with digital content providers", "HTTPS/REST")
Rel(Library Management System, Identity and Access Management (IAM) Provider, "Authenticates users and enforces role-based access control", "OAuth2/OIDC")
Rel(Library Management System, Centralized Audit and Logging System, "Streams logs and telemetry", "TLS")

@enduml