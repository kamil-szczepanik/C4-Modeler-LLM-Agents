@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(Self-Service Patrons, "Self-Service Patrons", "Patrons who interact with the system for searching and self-service portals.")
Person(Library Staff, "Library Staff", "Staff members who interact with the system for administrative catalogue management and circulation.")

System_Ext(Identity_and_Access_Management__IAM__Provider, "Identity and Access Management (IAM) Provider", "Provider utilizing OAuth2/OIDC for authentication and RBAC.")
System_Ext(External_Notification_Systems, "External Notification Systems", "EU-compliant email/SMS gateways.")
System_Ext(Third_Party_Digital_Content_Providers, "Third-Party Digital Content Providers", "Providers of digital content integrated with the library system.")
System_Ext(Centralized_Audit_and_Logging_System, "Centralized Audit and Logging System", "System for streaming logs and telemetry.")

System_Boundary(Library_Management_System, "Library Management System") {
    Container(Web_Application__SPA_, "Web Application (SPA)", "Frontend SPA served via CDN", "Provides public and academic libraries with item cataloging, circulation management, and self-service portals.")
    Container(API_Gateway, "API Gateway", "API Gateway with TLS termination and IAM token validation", "Routes requests from the web application to core business services.")
    Container(Core_Business_Services, "Core Business Services", "Decoupled microservices architecture", "Handles Catalogue, Circulation, and User Management business logic.")
    Container(Search_Engine_Container, "Search Engine Container", "Elasticsearch/OpenSearch", "Provides fast search capabilities isolated within the EU.")
    ContainerDb(Database_Container, "Database Container", "PostgreSQL", "Regional PostgreSQL instance with encryption at rest for stateful data.")
    Container(Async_Event_Broker_Container, "Async Event Broker Container", "Apache Kafka or RabbitMQ", "Handles asynchronous messaging and event streaming.")
    Container(Shared_Caching_Container, "Shared Caching Container", "Redis", "Deployed regionally in front of the database to improve performance.")
    Container_Boundary(File_Storage_Container_b, "File Storage") {
        Container(File_Storage_Container, "File Storage Container", "S3/HTTPS Compatible Storage", "Stores file assets securely with EU data residency.")
    }
    Container(Worker___Background_Job_Processing_Container, "Worker / Background Job Processing Container", "Background Worker Service", "Processes background jobs and asynchronous tasks.")
    Container(Configuration_Management_Container_Service, "Configuration Management Container/Service", "Configuration Service", "Manages system-wide configurations.")
}

Rel(Self-Service Patrons, Web_Application__SPA_, "Interacts for searching and self-service portals", "HTTPS/TLS")
Rel(Library Staff, Web_Application__SPA_, "Interacts for administrative catalogue management and circulation", "HTTPS/TLS")
Rel(Web_Application__SPA_, API_Gateway, "Sends user requests", "HTTPS/TLS")
Rel(API_Gateway, Core_Business_Services, "Routes validated requests", "gRPC/REST")
Rel(Core_Business_Services, Database_Container, "Reads and writes relational data", "PostgreSQL protocol")
Rel(Core_Business_Services, Search_Engine_Container, "Queries search index", "HTTP/REST")
Rel(Core_Business_Services, Async_Event_Broker_Container, "Publishes and consumes asynchronous events", "AMQP/Kafka protocol")
Rel(Core_Business_Services, Shared_Caching_Container, "Retrieves and stores cached data", "Redis protocol")
Rel(Core_Business_Services, File_Storage_Container, "Uploads and retrieves files", "S3/HTTPS")
Rel(Core_Business_Services, Worker___Background_Job_Processing_Container, "Offloads background tasks", "Internal API / Messaging")
Rel(Core_Business_Services, Configuration_Management_Container_Service, "Fetches runtime configurations", "Internal API")
Rel(API_Gateway, Identity_and_Access_Management__IAM__Provider, "Validates IAM tokens", "OAuth2/OIDC")
Rel(Core_Business_Services, External_Notification_Systems, "Sends notifications", "SMTP/SMPP")
Rel(Core_Business_Services, Third_Party_Digital_Content_Providers, "Integrates with digital content", "HTTPS/REST")
Rel(Core_Business_Services, Centralized_Audit_and_Logging_System, "Streams logs and telemetry", "TLS")

@enduml