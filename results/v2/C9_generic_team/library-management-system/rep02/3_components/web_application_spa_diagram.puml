@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application (SPA) container

System_Ext(api_gateway, "API Gateway", "Entry point with TLS termination and IAM token validation")

Container_Boundary(web_app_spa, "Web Application (SPA)") {
    Component(frontend_ui_router_and_views, "Frontend UI Router and Views", "React", "Manages single-page application routing, view rendering, and screen navigation for patrons and staff.")
    Component(client_side_state_and_cache_manager, "Client-Side State and Cache Manager", "React Query / RTK Query", "Handles client-side state management, data fetching, and search caching.")
    Component(api_communication_client, "API Communication Client", "HTTPS/TLS Client", "Communicates securely with the API Gateway to send user requests and retrieve data.")
}

Rel(frontend_ui_router_and_views, client_side_state_and_cache_manager, "Fetches and caches data")
Rel(client_side_state_and_cache_manager, api_communication_client, "Sends requests via")
Rel(api_communication_client, api_gateway, "Sends user requests and retrieves data", "HTTPS/TLS")

@enduml