@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(search_engine_container, "Search Engine Container") {
    Component(search_api_endpoint, "Search API Endpoint", "HTTP/REST Handler", "Receives search queries from Core Business Services.")
    Component(index_ingestion_consumer, "Index Ingestion Consumer", "Event Listener", "Consumes asynchronous update events from the Async Event Broker Container to update the search index.")
    Component(search_index_engine, "Search Index Engine", "Elasticsearch / OpenSearch", "Delivers high-performance item discovery and sub-800ms 99th-percentile search capabilities.")
}

Rel(index_ingestion_consumer, search_index_engine, "Ingests asynchronous updates", "HTTP/REST")

@enduml