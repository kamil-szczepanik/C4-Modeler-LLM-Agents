@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Worker / Background Job Processing Container

Container_Boundary(worker_container, "Worker / Background Job Processing Container") {
    Component(Job_Consumer_Component, "Job Consumer Component", "Background Worker Service / Async Listener", "Consumes asynchronous tasks and events from the event broker for long-running processes.")
    Component(Task_Processor_Component, "Task Processor Component", "Business Logic Handler", "Executes background workflows, maintaining data integrity, error handling, and stateful job tracking.")
    Component(Notification_Dispatcher_Component, "Notification Dispatcher Component", "HTTPS Client", "Sends notifications and interacts with external third-party notification systems.")
}

System_Ext(Database_Container, "Database Container", "PostgreSQL database for persistence and stateful job tracking.")
System_Ext(External_Notification_Systems, "External Notification Systems & Third-Party Digital Content Providers", "External services for sending outbound alerts and notifications.")

Rel(Job_Consumer_Component, Task_Processor_Component, "Triggers and passes payloads for background execution")
Rel(Task_Processor_Component, Database_Container, "Persists stateful job tracking and updates data", "SQL / TCP")
Rel(Notification_Dispatcher_Component, External_Notification_Systems, "Sends outbound alerts and notifications", "HTTPS")

@enduml