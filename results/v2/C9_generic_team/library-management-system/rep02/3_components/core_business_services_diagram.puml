@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Business Services container

Container_Boundary(core_business_services, "Core Business Services") {
    Component(CatalogueDomainService, "Catalogue Domain Service", "Decoupled microservices architecture", "Manages catalogue items, physical and digital inventory, and integrates with search engines.")
    Component(CirculationDomainService, "Circulation Domain Service", "Decoupled microservices architecture", "Handles item checkouts, returns, renewals, and fine management.")
    Component(UserManagementDomainService, "User Management Domain Service", "Decoupled microservices architecture", "Manages patron and staff profiles, authentication context, and role-based access.")
}

System_Ext(SearchEngineContainer, "Search Engine Container", "Elasticsearch/OpenSearch")
System_Ext(DatabaseContainer, "Database Container", "PostgreSQL")
System_Ext(AsyncEventBrokerContainer, "Async Event Broker Container", "Apache Kafka or RabbitMQ")

Rel(CatalogueDomainService, SearchEngineContainer, "Queries search index", "HTTP/REST")
Rel(CirculationDomainService, DatabaseContainer, "Reads and writes domain data", "PostgreSQL protocol")
Rel(UserManagementDomainService, AsyncEventBrokerContainer, "Publishes and consumes asynchronous events", "AMQP/Kafka protocol")

@enduml