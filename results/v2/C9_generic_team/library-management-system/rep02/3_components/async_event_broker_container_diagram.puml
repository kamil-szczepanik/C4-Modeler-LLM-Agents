@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(async_event_broker_container, "Async Event Broker Container") {
    Component(Event_Publisher, "Event Publisher", "Apache Kafka / RabbitMQ Client", "Publishes asynchronous events with Avro/JSON Schema governance and IAM-backed ACLs.")
    Component(Event_Consumer, "Event Consumer", "Apache Kafka / RabbitMQ Client", "Consumes asynchronous events and handles consumer idempotency deduplication.")
}

Rel(Event_Publisher, Event_Consumer, "Transmits asynchronous messages via AMQP/Kafka protocol", "AMQP/Kafka")
@enduml