@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("File Storage Container", "File Storage Container") {
    Component(Storage_Handler, "Storage Handler", "S3/HTTPS Compatible Storage API", "Manages secure asset persistence and enforces EU-only data residency policies for uploaded files.")
    Component(Pre_signed_URL_Generator, "Pre-signed URL Generator", "HTTPS Service", "Generates secure pre-signed URLs allowing clients to upload and retrieve files directly.")
}

Rel(Storage_Handler, Pre_signed_URL_Generator, "Provides secure file storage access")

@enduml