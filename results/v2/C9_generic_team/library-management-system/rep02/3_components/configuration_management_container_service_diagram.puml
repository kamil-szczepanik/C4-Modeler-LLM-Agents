@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Configuration Management Container/Service container

Container_Boundary(config_management_container, "Configuration Management Container/Service") {
    Component(Configuration_Service, "Configuration Service", "Configuration Provider Pattern, JSON Schema Validation, Envelope Encryption", "Manages runtime configurations, enforces strict payload validation, secures sensitive values, and exports daily backups.")
}

Component(Core_Business_Services, "Core Business Services", "Decoupled microservices", "Fetches runtime configurations from the Configuration Service.")
Component(Async_Event_Broker_Container, "Async Event Broker Container", "Apache Kafka or RabbitMQ", "Receives configuration change events to enable push-based hot reloading.")
Component(Centralized_Audit_and_Logging_System, "Centralized Audit and Logging System", "Syslog/HTTPS", "Receives change events and audit logs from the Configuration Service.")
Component(Disaster_Recovery_and_Backup_Storage, "Disaster Recovery and Backup Storage", "S3/HTTPS", "Stores daily configuration backups.")

Rel(Core_Business_Services, Configuration_Service, "Fetches runtime configurations", "Internal API")
Rel(Configuration_Service, Async_Event_Broker_Container, "Publishes configuration change events", "AMQP/Kafka Protocol")
Rel(Configuration_Service, Centralized_Audit_and_Logging_System, "Publishes change events and audit logs", "Syslog/HTTPS")
Rel(Configuration_Service, Disaster_Recovery_and_Backup_Storage, "Exports daily configuration backups", "S3/HTTPS")

@enduml