@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database Container container

Container_Boundary(database_container, "Database Container") {
    Component(Regional_PostgreSQL_instance, "Regional PostgreSQL instance", "PostgreSQL", "Provides ACID transactional integrity for circulation, encryption at rest, and ensures compliance with EU-only data residency.")
    Component(PgBouncer, "PgBouncer", "PgBouncer", "Manages traffic spikes and connection limits for the database.")
    Component(Flyway_or_Liquibase, "Flyway or Liquibase", "Flyway / Liquibase", "Automates safe schema evolution.")
    Component(Monitoring_and_Telemetry, "Monitoring and Telemetry", "Prometheus, postgres_exporter, pg_audit", "Exposes metrics for monitoring infrastructure and tracks database auditing.")
    Component(Disaster_Recovery_and_Backup_Storage, "Disaster Recovery and Backup Storage", "Storage container with WAL archiving", "Handles automated PITR and backup storage.")
}

Rel(PgBouncer, Regional_PostgreSQL_instance, "Manages and routes database connections to", "")
Rel(Flyway_or_Liquibase, Regional_PostgreSQL_instance, "Applies safe schema migrations to", "")
Rel(Monitoring_and_Telemetry, Regional_PostgreSQL_instance, "Scrapes metrics and audits", "")

@enduml