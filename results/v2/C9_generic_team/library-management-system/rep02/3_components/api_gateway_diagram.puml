@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Edge_Router, "Edge Router", "Custom edge router with integrated TLS termination", "Handles routing, TLS termination, and forwards incoming user requests.")
    Component(Security_Manager, "Security Manager", "OAuth2/OIDC validation module", "Validates IAM tokens and handles security checks.")
    Component(Caching_Manager, "Caching Manager", "Redis Client", "Manages caching of frequent search queries and serves fallback responses.")
    Component(Resiliency_and_Rate_Limiting_Controller, "Resiliency and Rate Limiting Controller", "Circuit Breaker and Rate Limiting patterns", "Enforces rate limits and provides circuit breaker patterns for backend protection.")
}

Rel(Edge_Router, Security_Manager, "Delegates token validation")
Rel(Edge_Router, Resiliency_and_Rate_Limiting_Controller, "Applies rate limiting and circuit breaking")
Rel(Edge_Router, Caching_Manager, "Checks and stores cached query responses")

@enduml