@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Shared Caching Container container

Container_Boundary(shared_caching_container, "Shared Caching Container") {
    Component(Cache_Manager, "Cache Manager", "Redis In-Memory Engine", "Manages in-memory data access and eviction policies to support sub-800ms search performance.")
    Component(Session_Store, "Session Store", "Redis KV Store", "Stores active patron and staff session states for the self-service portals.")
}

Rel(Cache_Manager, Session_Store, "Persists and retrieves cached data entries", "Redis protocol")

@enduml