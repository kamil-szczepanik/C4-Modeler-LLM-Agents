@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Regional Insurer Claims Platform

Person(CustomersAndBrokers, "Customers and Brokers", "External users who submit online claims.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal staff who handle and process claims.")

System_Ext(OnPremiseCOBOLDB2MainframeSystemOfRecord, "On-Premise COBOL/DB2 Mainframe (System of Record)", "Legacy system of record handling core mainframe logic and database storage.")
System_Ext(OnPremiseActiveDirectory, "On-Premise Active Directory", "Directory service used for authentication and SSO.")

System_Boundary(RegionalInsurerClaimsPlatform, "Regional Insurer Claims Platform") {
    Container(AzureWebApp, "Azure Web Application", "Azure Container", "Containerized web application providing the UI for customers, brokers, and adjusters.")
    Container(AzureAntiCorruptionLayerACL, "Azure Anti-Corruption Layer (ACL)", "Azure Container, JSON Schema, Avro Schema Registry", "Containerized ACL that communicates with the on-premise mainframe and prevents contract violations.")
    ContainerDb(AzureDatabasewithSnapshotStateVersioning, "Azure Database with Snapshot State Versioning", "Azure Database", "Azure database utilizing snapshot state versioning for historical auditability and rollbacks.")
    Container(AzureObservabilityContainer, "Azure Observability Container", "Azure Container", "Container dedicated to monitoring and observability of the Azure environment.")
}

Rel(CustomersAndBrokers, AzureWebApp, "Online claim submission", "HTTPS/REST")
Rel(ClaimsAdjusters, AzureWebApp, "Claim handling and processing", "HTTPS/REST")
Rel(AzureAntiCorruptionLayerACL, OnPremiseCOBOLDB2MainframeSystemOfRecord, "Communicates with on-premise mainframe for hybrid message delivery and synchronization", "Secure VPN/ExpressRoute, synchronous REST/MQ APIs")
Rel(AzureWebApp, OnPremiseActiveDirectory, "Authenticates users via SSO", "OAuth2/OpenID Connect (SSO)")

@enduml