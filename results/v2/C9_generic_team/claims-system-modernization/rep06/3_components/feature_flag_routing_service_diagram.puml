@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(feature_flag_routing_service, "Feature Flag / Routing Service") {
    Component(Routing_Controller, "Routing Controller", "Azure App Configuration & Routing Client SDK", "Manages incremental claim type migration routing rules, feature flags, and handles HTTP/REST queries from BFF and Claim Management Core.")
    Component(Consistent_Hashing_Engine, "Consistent Hashing Engine", "Deterministic Algorithm", "Applies deterministic consistent hashing based on claim IDs to guarantee repeatable routing decisions between the legacy mainframe and Azure platform.")
    Component(Circuit_Breaker_Manager, "Circuit Breaker Manager", "Routing Client SDK Resilience Pattern", "Enforces fallback-to-safe-default behavior targeting the mainframe during outages to ensure reliable hybrid routing.")
    Component(Cache_Invalidation_Publisher, "Cache Invalidation Publisher", "Azure Service Bus", "Publishes and handles cache invalidation events to enable near-instantaneous emergency rollbacks.")
    Component(Telemetry_Emitter, "Telemetry Emitter", "Azure Application Insights", "Emits metrics, audit logs, and distributed traces for telemetry, canary evaluation, and monitoring.")
}

Rel(Routing_Controller, Consistent_Hashing_Engine, "Evaluates routing state using", "")
Rel(Routing_Controller, Circuit_Breaker_Manager, "Protects routing calls with", "")
Rel(Routing_Controller, Cache_Invalidation_Publisher, "Triggers event distribution via", "")
Rel(Routing_Controller, Telemetry_Emitter, "Sends metrics and logs to", "")

@enduml