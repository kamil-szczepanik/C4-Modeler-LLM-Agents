@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Cache / Read Model Store container

Container_Boundary(cache_read_model_store, "Cache / Read Model Store") {
    Component(Read_Model_Database_Engine, "Read Model Database Engine", "Managed Cloud Database", "Stores denormalized read models to deliver fast read performance for adjuster screens and decouples read models from mainframe latency.")
    Component(In_Memory_Cache_Layer, "In-Memory Cache Layer", "Managed Cloud Cache", "Caches frequent claim queries to reduce latency for the Backend-for-Frontend (BFF).")
}

Rel(Data_Synchronization_ETL_Service, Read_Model_Database_Engine, "Database Replication")
Rel(Backend_for_Frontend_BFF, In_Memory_Cache_Layer, "TCP/Redis Protocol")

@enduml