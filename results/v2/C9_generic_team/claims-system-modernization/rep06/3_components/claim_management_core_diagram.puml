@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claim Management Core container

Container_Boundary(claim_management_core_boundary, "Claim Management Core") {
    Component(Claim_Management_Core, "Claim Management Core", "Azure App Service", "Central processing container handling modern insurance claims.")
    Component(Modular_Domain_Packages, "Modular Domain Packages", "Auto, Property Bounded Contexts", "Internal bounded contexts for domain-specific logic.")
    Component(Outbox_Table_Dispatcher, "Outbox Table & Dispatcher", "Outbox Pattern & Polly", "Reliability mechanism ensuring zero-data-loss event publishing.")
    Component(Azure_Service_Bus, "Azure Service Bus", "Azure Service Bus (AMQP)", "Asynchronous message broker for domain events.")
    Component(ACL_Gateway_Interface, "ACL Gateway Interface", "Anti-Corruption Layer (ACL)", "Boundary mapping and legacy protocol translation via secure adapters.")
    Component(Cache_Read_Model_Store, "Cache / Read Model Store", "TCP/SQL", "Optimized storage for fast queries supporting CQRS read models.")
}

System_Ext(BFF, "BFF", "Backend for Frontend application")

Rel(BFF, Claim_Management_Core, "Sends HTTPS/REST requests", "HTTPS/REST")
Rel(Claim_Management_Core, Azure_Service_Bus, "Publishes domain events via AMQP", "AMQP")
Rel(Claim_Management_Core, Cache_Read_Model_Store, "Updates and queries read models via TCP/SQL", "TCP/SQL")
Rel(Claim_Management_Core, ACL_Gateway_Interface, "Translates legacy protocols via secure adapters", "Internal")

@enduml