@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Synchronization / ETL Service container

System_Ext(OnPremise_COBOL_DB2_Mainframe_System_of_Record, "On-Premise COBOL/DB2 Mainframe (System of Record)", "System of Record")
System_Ext(Cache_Read_Model_Store, "Cache / Read Model Store", "Managed Cloud Database / Cache")
System_Ext(Azure_Service_Bus, "Azure Service Bus", "Message Broker & DLQ")
System_Ext(Azure_Application_Insights, "Azure Application Insights", "Observability")
System_Ext(Azure_App_Configuration, "Azure App Configuration", "Centralized Configuration Store")

Container_Boundary(Data_Synchronization_ETL_Service, "Data Synchronization / ETL Service") {
    Component(Mainframe_Extraction_Adapter, "Mainframe Extraction Adapter", "Modular Adapter / Azure App Service", "Extracts batch data and state from the On-Premise COBOL/DB2 Mainframe via Secure Mainframe Protocols.")
    Component(Data_Transformation_Engine, "Data Transformation Engine", "Azure Compute / ETL", "Transforms state between the on-premise mainframe and cloud read models during incremental claim migrations.")
    Component(Read_Model_Upsert_Manager, "Read Model Upsert Manager", "Azure Compute / ETL", "Upserts transformed data and read models to the Cache / Read Model Store via Database Replication.")
    Component(Resilient_Message_Handler, "Resilient Message Handler", "Azure Service Bus Client", "Routes failed messages to Dead-Letter Queues (DLQs) using AMQP to handle transient failures.")
    Component(Telemetry_and_Monitoring_Publisher, "Telemetry and Monitoring Publisher", "Azure Application Insights SDK", "Publishes telemetry, lag metrics, and error rates via HTTPS.")
    Component(Configuration_Manager, "Configuration Manager", "Azure App Configuration Client", "Fetches centralized pipeline parameters, batch sizes, and feature toggles to enable rapid operational adjustments.")
}

Rel(Mainframe_Extraction_Adapter, Data_Transformation_Engine, "Passes extracted batch data for transformation", "Internal Data Flow")
Rel(Data_Transformation_Engine, Read_Model_Upsert_Manager, "Sends transformed records for synchronization", "Internal Data Flow")
Rel(Read_Model_Upsert_Manager, Cache_Read_Model_Store, "Upserts transformed data and read models via Database Replication", "Database Replication")
Rel(Mainframe_Extraction_Adapter, OnPremise_COBOL_DB2_Mainframe_System_of_Record, "Extracts batch data and state via Secure Mainframe Protocols / ETL", "ETL / Secure Protocols")
Rel(Resilient_Message_Handler, Azure_Service_Bus, "Routes failed messages to Dead-Letter Queues (DLQs) using AMQP", "AMQP")
Rel(Telemetry_and_Monitoring_Publisher, Azure_Application_Insights, "Publishes telemetry, lag metrics, and error rates via HTTPS", "HTTPS")

@enduml