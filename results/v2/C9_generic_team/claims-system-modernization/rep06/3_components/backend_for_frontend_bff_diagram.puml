@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Backend-for-Frontend (BFF) container

Container_Boundary(bff, "Backend-for-Frontend (BFF)") {
    Component(Web API Controller, "Web API Controller", "ASP.NET Core / C#", "Exposes RESTful endpoints for the Web Application SPA and handles incoming HTTP requests.")
    Component(Configuration Client, "Configuration Client", "Azure App Configuration SDK", "Fetches and manages externalized configuration, timeouts, and feature flags.")
    Component(Resilience & Caching Manager, "Resilience & Caching Manager", "Response Caching & Polly Circuit Breaker", "Mitigates mainframe latency, caches responses, and prevents cascading failures.")
    Component(Security & Middleware Handler, "Security & Middleware Handler", "Correlation IDs & PII Masking Middleware", "Ensures distributed tracing across the hybrid boundary and scrubs sensitive data for compliance.")
    Component(Telemetry Exporter, "Telemetry Exporter", "Azure Application Insights SDK", "Exports telemetry and distributed traces via HTTPS.")
}

Rel(Web API Controller, Resilience & Caching Manager, "Routes requests through caching and circuit breakers")
Rel(Web API Controller, Security & Middleware Handler, "Passes requests through security and correlation ID middleware")
Rel(Resilience & Caching Manager, Configuration Client, "Reads operational endpoints and timeouts")
Rel(Web API Controller, Telemetry Exporter, "Sends telemetry data")

@enduml