@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Message Broker (Azure Service Bus) container

Container_Boundary("Message Broker (Azure Service Bus)", "Message Broker (Azure Service Bus)") {
    Component(ClaimEventPublisher, "Claim Event Publisher", "Azure Service Bus Client", "Publishes claim processing events from the Claim Management Core into the message broker.")
    Component(AntiCorruptionEventConsumer, "Anti-Corruption Event Consumer", "Azure Service Bus Client", "Subscribes to modern claim events and forwards them to the Anti-Corruption Layer for legacy mainframe translation.")
    Component(OutboxPatternHandler, "Outbox Pattern Handler", "Azure Service Bus Outbox Processor", "Ensures reliable, exactly-once message publishing and delivery across hybrid boundaries.")
    Component(DeadLetterQueueManager, "Dead-Letter Queue Manager", "Azure Service Bus DLQ", "Manages and isolates failed messages to guarantee message processing integrity and facilitate debugging.")
}

Rel(ClaimEventPublisher, OutboxPatternHandler, "Routes outgoing messages through")
Rel(OutboxPatternHandler, AntiCorruptionEventConsumer, "Delivers asynchronous events via")
Rel(AntiCorruptionEventConsumer, DeadLetterQueueManager, "Fails over malformed or unprocessable messages to")

@enduml