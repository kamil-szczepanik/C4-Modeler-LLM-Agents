@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application (SPA) container

System_Ext(Backend_for_Frontend_BFF, "Backend-for-Frontend (BFF)", "Backend-for-Frontend service")
System_Ext(On_Premise_Active_Directory, "On-Premise Active Directory", "On-Premise Active Directory service")
System_Ext(Azure_Application_Insights, "Azure Application Insights", "Azure Application Insights service")

Container_Boundary(Web_Application_SPA, "Web Application (SPA)") {
    Component(UI_Presentation_Layer, "UI Presentation Layer", "TypeScript, Single Page Application (SPA)", "Provides the user interface for customers, brokers, and claims adjusters with optimistic UI updates and feature-flagged routing.")
    Component(API_Client, "API Client", "OpenAPI, TypeScript", "Generates type-safe API clients to eliminate schema drift between the frontend and the BFF.")
    Component(Authentication_Client, "Authentication Client", "HTTPS, Active Directory SSO", "Handles single sign-on authentication for users against the on-premise Active Directory.")
    Component(Telemetry_and_Testing_Agent, "Telemetry and Testing Agent", "Playwright, Azure Application Insights", "Executes automated end-to-end smoke tests and provides real-time client-side telemetry and performance monitoring.")
}

Rel(UI_Presentation_Layer, API_Client, "Uses type-safe API client to communicate", "")
Rel(API_Client, Backend_for_Frontend_BFF, "Communicates via HTTPS/REST", "HTTPS/REST")
Rel(UI_Presentation_Layer, Authentication_Client, "Authenticates via SSO [HTTPS]", "HTTPS")
Rel(Authentication_Client, On_Premise_Active_Directory, "Validates credentials", "")
Rel(UI_Presentation_Layer, Azure_Application_Insights, "Sends real-time telemetry and performance metrics", "")

@enduml