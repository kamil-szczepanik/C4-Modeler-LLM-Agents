@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Anti_Corruption_Layer_ACL", "Anti-Corruption Layer (ACL)") {
    Component(Mainframe_Adapter, "Mainframe Adapter", "Azure App Service / Secure Mainframe Protocols", "Communicates directly with the On-Premise COBOL/DB2 Mainframe to exchange data securely.")
    Component(Message_Publisher, "Message Publisher", "Azure Service Bus SDK", "Publishes and subscribes events to the Azure Service Bus using the Outbox pattern.")
    Component(Domain_Translator, "Domain Translator", "Clean Architecture / Ports & Adapters", "Translates legacy mainframe data models into modern cloud-native domain models.")
}

Rel(Domain_Translator, Mainframe_Adapter, "Exchanges legacy data", "")
Rel(Domain_Translator, Message_Publisher, "Publishes events", "")
@enduml