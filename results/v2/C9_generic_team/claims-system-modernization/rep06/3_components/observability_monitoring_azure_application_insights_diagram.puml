@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(observability_monitoring_azure_application_insights, "Observability / Monitoring (Azure Application Insights)") {
    Component(Distributed_Tracing_Collector, "Distributed Tracing Collector", "Azure Application Insights / W3C Trace Context", "Collects and aggregates end-to-end distributed traces injected via HTTP headers across hybrid boundaries.")
    Component(Structured_Logging_Engine, "Structured Logging Engine", "Azure Application Insights Logging", "Captures and indexes structured log streams emitted by backend containers.")
    Component(Telemetry_Alerting_Service, "Telemetry Alerting Service", "Azure Application Insights Alerts", "Provides automated alerting and operational monitoring based on telemetry data.")
    Component(Kusto_Query_Interface, "Kusto Query Interface", "Kusto Query Language (KQL)", "Processes version-controlled query templates for rapid operational triage and monitoring.")
}

Rel(Structured_Logging_Engine, Kusto_Query_Interface, "Provides queryable log data for", "")
Rel(Distributed_Tracing_Collector, Telemetry_Alerting_Service, "Triggers alerts based on trace anomalies and failures for", "")

@enduml