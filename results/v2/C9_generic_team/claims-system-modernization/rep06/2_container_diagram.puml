@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Regional Insurer Claims Platform

Person(CustomersAndBrokers, "Customers and Brokers", "External users who submit online claims.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal staff who handle and process claims.")

System_Ext(OnPremiseCOBOLDB2MainframeSystemOfRecord, "On-Premise COBOL/DB2 Mainframe (System of Record)", "Legacy system of record handling core mainframe logic and database storage.")
System_Ext(OnPremiseActiveDirectory, "On-Premise Active Directory", "Directory service used for authentication and SSO.")

System_Boundary(RegionalInsurerClaimsPlatform, "Regional Insurer Claims Platform") {
    Container(WebApplicationSPA, "Web Application (SPA)", "Azure App Service / SPA", "Provides the user interface for customers, brokers, and adjusters.")
    Container(BackendForFrontendBFF, "Backend-for-Frontend (BFF)", "Azure App Service", "Serves as an orchestration layer tailored for the web application.")
    Container(ClaimManagementCore, "Claim Management Core", "Azure App Service", "Handles the core claim processing and business logic.")
    Container(AntiCorruptionLayerACL, "Anti-Corruption Layer (ACL)", "Azure App Service / Secure Mainframe Protocols", "Translates and protects modern cloud services from legacy mainframe schemas.")
    Container(DataSynchronizationETLService, "Data Synchronization / ETL Service", "Azure Service / ETL", "Replicates state between the mainframe and the read model store.")
    Container(FeatureFlagRoutingService, "Feature Flag / Routing Service", "Azure App Service", "Manages incremental rollout and hybrid routing logic.")
    ContainerDb(MessageBrokerAzureServiceBus, "Message Broker (Azure Service Bus)", "Azure Service Bus", "Manages asynchronous messaging to isolate hybrid network latency.")
    ContainerDb(CacheReadModelStore, "Cache / Read Model Store", "Managed Cloud Database / Cache", "Provides fast read access and cached state for the platform.")
    Container(ObservabilityMonitoringAzureApplicationInsights, "Observability / Monitoring (Azure Application Insights)", "Azure Application Insights", "Provides centralized observability across cloud and on-premise boundaries.")
}

Rel(CustomersAndBrokers, WebApplicationSPA, "Interact with web application", "HTTPS/REST (SSO via Active Directory)")
Rel(ClaimsAdjusters, WebApplicationSPA, "Interact with web application", "HTTPS/REST (SSO via Active Directory)")
Rel(WebApplicationSPA, BackendForFrontendBFF, "Communicates with BFF", "HTTPS/REST")
Rel(BackendForFrontendBFF, ClaimManagementCore, "Communicates with Claim Management Core", "HTTPS/REST")
Rel(BackendForFrontendBFF, AntiCorruptionLayerACL, "Communicates with Anti-Corruption Layer", "HTTPS/REST")
Rel(AntiCorruptionLayerACL, OnPremiseCOBOLDB2MainframeSystemOfRecord, "Exchanges data with legacy mainframe", "Secure mainframe protocols")
Rel(ClaimManagementCore, MessageBrokerAzureServiceBus, "Publishes and subscribes events", "Azure Service Bus")
Rel(AntiCorruptionLayerACL, MessageBrokerAzureServiceBus, "Publishes and subscribes events", "Azure Service Bus")
Rel(DataSynchronizationETLService, OnPremiseCOBOLDB2MainframeSystemOfRecord, "Replicates state with mainframe", "ETL / Secure Protocols")
Rel(DataSynchronizationETLService, CacheReadModelStore, "Replicates state with read model store", "Database Replication")
Rel(WebApplicationSPA, OnPremiseActiveDirectory, "Authenticates via SSO", "HTTPS")

@enduml