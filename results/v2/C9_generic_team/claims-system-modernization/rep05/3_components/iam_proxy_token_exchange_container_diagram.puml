@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the IAM Proxy / Token Exchange Container container

Container_Boundary("IAM Proxy / Token Exchange Container", "IAM Proxy / Token Exchange Container") {
    Component(AuthModule, "Authentication and Token Exchange Module", "Azure App Service Authentication (Easy Auth) / RFC 8693", "Authenticates users against Active Directory and standardizes token exchange using SAML/OAuth2/OIDC without custom protocol translation.")
    Component(SessionManager, "Session and Cache Manager", "Redis", "Caches session states and token validations to accelerate validation checks and support adjuster screen performance.")
    Component(TelemetryReporter, "Security Telemetry Reporter", "Azure Application Insights / W3C Trace Context", "Reports security events and propagates correlation IDs across the hybrid boundary for end-to-end observability.")
    Component(ConfigLoader, "Configuration and Secrets Loader", "Azure Key Vault", "Dynamically supplies immutable configuration, issuer mappings, and secrets at startup to prevent configuration drift.")
}

Rel(AuthModule, SessionManager, "Caches session states and token validations using", "Redis")
Rel(AuthModule, TelemetryReporter, "Reports security events using", "Azure Application Insights / W3C Trace Context")
Rel(ConfigLoader, AuthModule, "Supplies immutable configuration, issuer mappings, and secrets to", "Azure Key Vault")
@enduml