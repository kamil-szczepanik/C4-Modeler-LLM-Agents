@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("api_gateway_container", "API Gateway Container") {
    Component("Edge Security & Rate Limiting Component", "Edge Security & Rate Limiting Component", "Azure API Management", "Handles edge security, rate limiting, and declarative resilience policies.")
    Component("Routing & Feature Flag Evaluator", "Routing & Feature Flag Evaluator", "In-memory SDK with local Redis cache", "Evaluates rules and routes traffic based on feature flags.")
    Component("Error Formatting Component", "Error Formatting Component", "RFC 7807 (Problem Details)", "Provides standardized error formatting for API responses.")
}

Rel("Edge Security & Rate Limiting Component", "Routing & Feature Flag Evaluator", "Evaluates rules", "In-memory SDK with local Redis cache")
Rel("Edge Security & Rate Limiting Component", "Error Formatting Component", "Formats standard errors", "RFC 7807")

@enduml