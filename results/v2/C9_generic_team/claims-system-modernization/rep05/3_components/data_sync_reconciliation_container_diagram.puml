@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Data_Sync_Reconciliation_Container", "Data Sync / Reconciliation Container") {
    Component("Sync_Orchestrator", "Sync Orchestrator", "Azure Container Apps / .NET Worker", "Orchestrates background data synchronization workflows between the modern platform and the legacy mainframe.")
    Component("DB2_Connector", "DB2 Connector", "IBM DB2 Driver / ADO.NET", "Establishes secure connections to read and write data directly from the COBOL/DB2 Mainframe data store.")
    Component("Reconciliation_Engine", "Reconciliation Engine", "Azure Container Apps / C#", "Compares state between the modern modular monolith data store and the mainframe to ensure consistency.")
}

Rel("Sync_Orchestrator", "DB2_Connector", "Uses to query and update mainframe data", "")
Rel("Sync_Orchestrator", "Reconciliation_Engine", "Triggers consistency checks", "")
@enduml