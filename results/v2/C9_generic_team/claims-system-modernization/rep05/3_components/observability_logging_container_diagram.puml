@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Observability & Logging Container container

Container_Boundary(observability_logging_container, "Observability & Logging Container") {
    Component(OpenTelemetryCollectorSidecar, "OpenTelemetry Collector Sidecar", "OpenTelemetry Collector", "Collects telemetry, traces, and structured JSON logs from application containers.")
    Component(CentralizedAuditLogSink, "Centralized Audit Log Sink", "Azure Managed Storage / Secure API", "Receives and stores security and data mutation events.")
    Component(AzureApplicationInsights, "Azure Application Insights", "Azure Application Insights (Managed SaaS)", "Centralized managed SaaS telemetry platform for distributed tracing and monitoring.")
}

Rel(OpenTelemetryCollectorSidecar, AzureApplicationInsights, "Forwards aggregated traces, metrics, and logs", "HTTPS")
Rel(CentralizedAuditLogSink, AzureApplicationInsights, "Integrates audit records and security events for monitoring", "Secure API")

@enduml