@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Modular Monolith Container container

Container_Boundary("Modular Monolith Container", "Modular Monolith Container") {
    Component("Claims Domain Module", "Claims Domain Module", "C# / .NET Core Domain Model", "Encapsulates the core business logic and rules for insurance claims processing using Hexagonal/Clean Architecture.")
    Component("Policy Domain Module", "Policy Domain Module", "C# / .NET Core Domain Model", "Encapsulates policy validation and management domain logic.")
    Component("Application Services", "Application Services", "C# / .NET Core Application Layer", "Orchestrates use cases, handling transactions, outbox/inbox patterns, and coordinating domain modules.")
    Component("Infrastructure Adapters", "Infrastructure Adapters", "C# / .NET Core Infrastructure", "Implements outbound ports for communicating with the Anti-Corruption Layer (ACL), Asynchronous Messaging & Caching Layer, and databases.")
}

System_Ext("Anti-Corruption Layer (ACL) Container", "Anti-Corruption Layer (ACL) Container", "Azure Container Apps")
System_Ext("Asynchronous Messaging & Caching Layer", "Asynchronous Messaging & Caching Layer", "Azure Service Bus and Redis")

Rel("Application Services", "Claims Domain Module", "Executes business use cases", "")
Rel("Application Services", "Policy Domain Module", "Validates policy rules", "")
Rel("Application Services", "Infrastructure Adapters", "Invokes external calls and persistence operations", "")
Rel("Infrastructure Adapters", "Anti-Corruption Layer (ACL) Container", "Communicates with legacy system", "Internal REST/gRPC")
Rel("Infrastructure Adapters", "Asynchronous Messaging & Caching Layer", "Publishes/consumes async messages and caches data", "AMQP and Redis Protocol")

@enduml