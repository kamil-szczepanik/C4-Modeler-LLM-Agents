@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Routing / Feature Flag Container", "Routing / Feature Flag Container") {
    Component(Routing Engine, "Routing Engine", "Azure Container Apps, REST/gRPC", "Manages dynamic request routing and traffic splitting between the legacy mainframe and modern platform.")
    Component(Feature Flag Evaluation Engine, "Feature Flag Evaluation Engine", "OpenFeature standard", "Evaluates feature flags using an open specification to support gradual migration and rapid rollbacks.")
    Component(Local Cache Manager, "Local Cache Manager", "In-memory LRU cache, Redis", "Caches evaluated flags locally to achieve sub-millisecond evaluation latencies.")
    Component(Configuration Sync Component, "Configuration Sync Component", "Azure App Configuration", "Fetches and synchronizes dynamic routing rules and migration flags.")
    Component(Telemetry Emitter, "Telemetry Emitter", "OpenTelemetry, Azure Application Insights", "Emits asynchronous audit logs, evaluation latency metrics, and telemetry.")
}

System_Ext(Redis, "Redis", "External Redis cache instance")
System_Ext(Azure App Configuration, "Azure App Configuration", "External configuration store")
System_Ext(Observability & Logging Container, "Observability & Logging Container", "External observability platform")
System_Ext(Modular Monolith Container, "Modular Monolith Container", "External modular monolith container")

Rel(Routing Engine, Feature Flag Evaluation Engine, "Queries feature flags to determine traffic destination", "")
Rel(Feature Flag Evaluation Engine, Local Cache Manager, "Checks local cache for flag evaluations", "")
Rel(Local Cache Manager, Redis, "Backs local in-memory flag cache", "")
Rel(Configuration Sync Component, Azure App Configuration, "Fetches dynamic routing rules", "")
Rel(Telemetry Emitter, Observability & Logging Container, "Emits asynchronous audit logs and telemetry via OpenTelemetry", "")
Rel(Routing Engine, Modular Monolith Container, "Routes live traffic via internal REST/gRPC", "")
@enduml