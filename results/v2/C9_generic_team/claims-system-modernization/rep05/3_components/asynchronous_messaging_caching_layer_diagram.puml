@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Asynchronous Messaging & Caching Layer container

Container_Boundary(asynchronous_messaging_caching_layer, "Asynchronous Messaging & Caching Layer") {
    Component(Azure_Service_Bus, "Azure Service Bus", "Azure Cloud Service", "Handles asynchronous messaging, event publishing, dead-letter queues, and at-least-once delivery guarantees.")
    Component(Azure_Cache_for_Redis, "Azure Cache for Redis", "Azure Cloud Service", "Provides high-performance caching for read-heavy reference data using the Redis Protocol via Cache-Aside pattern.")
    Component(Azure_Blob_Storage, "Azure Blob Storage", "Azure Cloud Service", "Stores large binary files via the Claim Check pattern to keep message payloads small.")
    Component(Modular_Monolith, "Modular Monolith", ".NET Core / Containerized Runtime", "Core business logic container processing claims, consuming messages, and implementing the Transactional Outbox Pattern.")
    Component(Azure_Application_Insights, "Azure Application Insights", "Azure Cloud Service", "Collects telemetry, metrics, and distributed tracing for dead-letter queues and message processing states.")
}

Rel(Modular_Monolith, Azure_Service_Bus, "Publishes and consumes domain events", "AMQP with W3C trace context headers")
Rel(Modular_Monolith, Azure_Cache_for_Redis, "Reads and writes cached reference data", "Redis Protocol via Cache-Aside pattern")
Rel(Modular_Monolith, Azure_Blob_Storage, "Offloads and retrieves large binary documents", "HTTPS via Claim Check pattern")
Rel(Azure_Service_Bus, Azure_Application_Insights, "Emits telemetry", "Diagnostics / Metrics")
@enduml