@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Configuration & Secrets Management Container container

Container_Boundary(config_secrets_container, "Configuration & Secrets Management Container") {
    Component(Secrets_Management_Agent, "Secrets Management Agent", "Azure Key Vault SDK & Managed Identities", "Retrieves centralized secrets and configuration settings with strict naming conventions and immutable post-boot values.")
}

System_Ext(Azure_Key_Vault, "Azure Key Vault", "Centralized secret management")

Rel(Secrets_Management_Agent, Azure_Key_Vault, "Retrieves secrets securely via HTTPS using Managed Identities", "HTTPS")

@enduml