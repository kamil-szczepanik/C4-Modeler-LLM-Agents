@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Adjuster_BFF_Container", "Adjuster BFF Container") {
    Component(Adjuster_UI_Controller, "Adjuster UI Controller", "Azure App Service / Container Apps", "Handles incoming HTTPS requests from claims adjusters and serves adjuster workflows.")
    Component(API_Integration_Client, "API Integration Client", "Internal HTTPS/REST", "Communicates with the downstream API Gateway Container for data retrieval and submission.")
    Component(Telemetry_Integration_Agent, "Telemetry Integration Agent", "Telemetry SDK", "Collects and forwards telemetry data to the Observability & Logging Container.")
}

Rel(Adjuster_UI_Controller, API_Integration_Client, "Delegates downstream API calls")
Rel(Telemetry_Integration_Agent, Adjuster_UI_Controller, "Monitors and collects telemetry")
@enduml