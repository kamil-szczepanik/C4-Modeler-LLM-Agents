@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Anti-Corruption Layer (ACL) Container container

Container_Boundary(acl_container, "Anti-Corruption Layer (ACL) Container") {
    Component(Legacy_Adapter_Component, "Legacy Adapter Component", "Azure Container Apps / Adapter Pattern", "Translates modern domain models to legacy COBOL/DB2 formats and prevents legacy breaking changes.")
    Component(Outbox_Pattern_Component, "Outbox Pattern Component", "Azure Container Apps / Outbox Pattern", "Ensures reliable, zero data loss message dispatching to the asynchronous messaging layer.")
    Component(Circuit_Breaker_Component, "Circuit Breaker Component", "Azure Container Apps / Circuit Breaker Pattern", "Protects the modern domain from mainframe latency gaps and instability.")
}

Rel(Legacy_Adapter_Component, Outbox_Pattern_Component, "Triggers buffered dispatch")
Rel(Legacy_Adapter_Component, Circuit_Breaker_Component, "Guards calls to")

@enduml