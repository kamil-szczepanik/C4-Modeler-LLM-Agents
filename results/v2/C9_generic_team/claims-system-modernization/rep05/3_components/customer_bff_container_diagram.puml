@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Customer BFF Container container

Container_Boundary(customer_bff_container, "Customer BFF Container") {
    Component(claim_submission_controller, "Claim Submission Controller", "ASP.NET Core Controller / OpenAPI", "Handles online claim submissions from customers and brokers.")
    Component(routing_and_feature_flag_client, "Routing and Feature Flag Client", "HTTP Client", "Performs dynamic routing checks via the Routing / Feature Flag Container.")
    Component(configuration_and_secrets_client, "Configuration and Secrets Client", "Azure SDK", "Retrieves secrets and configuration from Azure Key Vault.")
}

Rel(claim_submission_controller, routing_and_feature_flag_client, "Triggers dynamic routing checks", "Internal REST")
Rel(claim_submission_controller, configuration_and_secrets_client, "Retrieves secrets", "Azure SDK / HTTPS")

@enduml