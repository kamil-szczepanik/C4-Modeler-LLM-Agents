@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Hybrid Insurance Claims Modernization Platform

Person(CustomersAndBrokers, "Customers and Brokers", "External users submitting claims online.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal users managing claims.")

System_Ext(COBOLDB2Mainframe, "COBOL/DB2 Mainframe", "Legacy on-premise system of record.")
System_Ext(ActiveDirectory, "Active Directory", "Insurer's identity provider for SSO.")

System_Boundary(HybridInsuranceClaimsModernizationPlatform, "Hybrid Insurance Claims Modernization Platform") {
    Container(APIGatewayContainer, "API Gateway Container", "Azure Container Apps / API Management", "Manages and routes incoming client traffic.")
    Container(CustomerBFFContainer, "Customer BFF Container", "Azure App Service / Container Apps", "Backend-For-Frontend tailored for customer and broker experiences.")
    Container(AdjusterBFFContainer, "Adjuster BFF Container", "Azure App Service / Container Apps", "Backend-For-Frontend tailored for claims adjuster workflows.")
    Container(ModularMonolithContainer, "Modular Monolith Container", "Azure App Service / Container Apps", "Core business logic container hosted in Azure.")
    Container(AntiCorruptionLayerACLContainer, "Anti-Corruption Layer (ACL) Container", "Azure Container Apps", "Translates and manages integration with the legacy mainframe.")
    Container(RoutingFeatureFlagContainer, "Routing / Feature Flag Container", "Container Apps", "Handles dynamic request routing and feature flag evaluations.")
    Container(DataSyncReconciliationContainer, "Data Sync / Reconciliation Container", "Azure Container Apps", "Ensures continuous synchronization with the legacy system of record.")
    Container(AsynchronousMessagingCachingLayer, "Asynchronous Messaging & Caching Layer", "Azure Service Bus and Redis", "Handles asynchronous messaging and performance caching.")
    Container(IAMProxyTokenExchangeContainer, "IAM Proxy / Token Exchange Container", "Container Apps", "Handles authentication and token exchange.")
    Container(ObservabilityLoggingContainer, "Observability & Logging Container", "Azure Application Insights", "Collects centralized telemetry and distributed tracing.")
    Container(ConfigurationSecretsManagementContainer, "Configuration & Secrets Management Container", "Azure Key Vault", "Manages centralized configuration and secrets.")
}

Rel(CustomersAndBrokers, CustomerBFFContainer, "Interacts for online submissions", "HTTPS (TLS 1.3)")
Rel(ClaimsAdjusters, AdjusterBFFContainer, "Interacts for adjuster workflows", "HTTPS (TLS 1.3)")
Rel(CustomerBFFContainer, APIGatewayContainer, "Communicates via internal APIs", "Internal HTTPS/REST")
Rel(AdjusterBFFContainer, APIGatewayContainer, "Communicates via internal APIs", "Internal HTTPS/REST")
Rel(APIGatewayContainer, RoutingFeatureFlagContainer, "Routes traffic", "Internal REST/gRPC")
Rel(RoutingFeatureFlagContainer, ModularMonolithContainer, "Forwards routed traffic", "Internal REST/gRPC")
Rel(ModularMonolithContainer, AntiCorruptionLayerACLContainer, "Communicates with legacy system", "Internal REST/gRPC")
Rel(AntiCorruptionLayerACLContainer, COBOLDB2Mainframe, "Secure communication with system of record", "Secure VPN/TLS")
Rel(ModularMonolithContainer, AsynchronousMessagingCachingLayer, "Utilizes for async processing and caching", "AMQP and Redis Protocol")
Rel(IAMProxyTokenExchangeContainer, ActiveDirectory, "Integrates for authentication", "SAML/OAuth2/OIDC")
Rel(ObservabilityLoggingContainer, APIGatewayContainer, "Collects telemetry", "Telemetry SDK")
Rel(ObservabilityLoggingContainer, CustomerBFFContainer, "Collects telemetry", "Telemetry SDK")
Rel(ObservabilityLoggingContainer, AdjusterBFFContainer, "Collects telemetry", "Telemetry SDK")
Rel(ObservabilityLoggingContainer, ModularMonolithContainer, "Collects telemetry", "Telemetry SDK")

@enduml