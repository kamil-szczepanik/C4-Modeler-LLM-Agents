@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(CustomersAndBrokers, "Customers and Brokers", "External users submitting claims online.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal users managing claims via the modern web application.")

System_Ext(COBOLDB2Mainframe, "COBOL/DB2 Mainframe", "On-premise system of record.")

System_Boundary(HybridInsuranceClaimsModernizationPlatform, "Hybrid Insurance Claims Modernization Platform") {
    Container(ModernWebApplication, "Modern Web Application", "Azure App Service", "Azure App Service container hosting adjuster screens.")
    Container(AntiCorruptionLayerACL, "Anti-Corruption Layer (ACL)", "Microservice Container", "Microservice container managing dynamic routing, feature flags, and contract mapping.")
    Container(AzureServiceBus, "Azure Service Bus", "Azure Service Bus", "Message broker handling asynchronous communication.")
}

Rel(CustomersAndBrokers, ModernWebApplication, "Submitting claims online", "HTTPS (REST)")
Rel(ClaimsAdjusters, ModernWebApplication, "Managing claims via the modern web application", "HTTPS (REST, SSO via Active Directory)")
Rel(ModernWebApplication, AzureServiceBus, "Handling asynchronous communication", "AMQP/HTTPS")
Rel(AntiCorruptionLayerACL, COBOLDB2Mainframe, "Managing dynamic routing and contract mapping", "MQ/TCP with Circuit Breakers")

@enduml