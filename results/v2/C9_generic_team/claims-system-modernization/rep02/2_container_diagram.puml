@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Insurance Claims Modernization

Person(Customers, "Customers", "Submit claims online.")
Person(Brokers, "Brokers", "Submit claims online.")
Person(ClaimsAdjusters, "Claims Adjusters", "Interact with the claims application.")

System_Ext(COBOLDB2Mainframe, "COBOL/DB2 Mainframe", "On-premises legacy System of Record.")
System_Ext(CorporateActiveDirectory, "Corporate Active Directory", "On-premises identity and authentication provider.")

System_Boundary(InsuranceClaimsModernization, "Insurance Claims Modernization") {
    Container(APIGatewayAntiCorruptionLayerACL, "API Gateway / Anti-Corruption Layer (ACL)", "Custom microservices on Azure", "Decouples modern Azure components from rigid mainframe contracts and handles claim submissions.")
    Container(EventBroker, "Event Broker", "Azure Service Bus", "Enables reliable asynchronous messaging and strangler migration support.")
    Container(CachingStateStore, "Caching / State Store", "Azure Redis Cache", "Meets sub-2-second UI performance targets by providing low-latency read models.")
    Container(DataSynchronizationReconciliation, "Data Synchronization / Reconciliation", "Azure Functions / WebJobs", "Handles asynchronous reconciliation and data consistency.")
    Container(BackendforFrontendBFF, "Backend-for-Frontend (BFF)", "Azure web applications", "Supports the adjuster web application and internal orchestration.")
    Container(CentralizedLoggingMonitoring, "Centralized Logging & Monitoring", "Azure Monitoring", "Provides operational visibility across containers.")
    Container(IAMTokenService, "IAM / Token Service", "Azure Identity services", "Integrated with corporate Active Directory for SSO.")
    Container(ConfigurationSecretManagement, "Configuration & Secret Management", "Azure Key Vault and App Configuration", "Handles secure credentials and feature-flags.")
    Container(WorkerBackgroundProcessing, "Worker / Background Processing", "Azure Functions / WebJobs", "Executes asynchronous background processing tasks.")
}

Rel(Customers, APIGatewayAntiCorruptionLayerACL, "Submit claims online", "HTTPS / REST")
Rel(Brokers, APIGatewayAntiCorruptionLayerACL, "Submit claims online", "HTTPS / REST")
Rel(ClaimsAdjusters, BackendforFrontendBFF, "Interact with the adjuster web application", "HTTPS / REST")
Rel(BackendforFrontendBFF, APIGatewayAntiCorruptionLayerACL, "Internal orchestration and data retrieval", "HTTPS / gRPC")
Rel(APIGatewayAntiCorruptionLayerACL, COBOLDB2Mainframe, "System of record updates", "Batch / Legacy protocols")
Rel(BackendforFrontendBFF, EventBroker, "Asynchronous event-driven migration", "AMQP / MQTT")
Rel(BackendforFrontendBFF, CachingStateStore, "Low-latency read models", "TCP / Redis Protocol")
Rel(IAMTokenService, CorporateActiveDirectory, "Single Sign-On authentication", "OIDC / SAML")

@enduml