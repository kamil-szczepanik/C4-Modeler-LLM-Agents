@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers, "Customers", "Submit claims online.")
Person(Brokers, "Brokers", "Submit claims online.")
Person(Claims Adjusters, "Claims Adjusters", "Interact with the claims application.")

System(Insurance Claims Modernization, "Insurance Claims Modernization", "A modern Azure-hosted platform that gradually replaces a 30-year-old COBOL/DB2 mainframe while maintaining continuous legacy operations.")

System_Ext(COBOL/DB2 Mainframe, "COBOL/DB2 Mainframe", "On-premises legacy System of Record.")
System_Ext(Active Directory, "Active Directory", "On-premises identity and authentication provider.")

Rel(Customers, Insurance Claims Modernization, "Submit claims online", "HTTPS")
Rel(Brokers, Insurance Claims Modernization, "Submit claims online", "HTTPS")
Rel(Claims Adjusters, Insurance Claims Modernization, "Interact with the web application via Single Sign-On", "HTTPS, SSO")
Rel(Insurance Claims Modernization, COBOL/DB2 Mainframe, "Communicates using synchronous APIs and asynchronous batch files", "Synchronous APIs, SFTP")
Rel(Insurance Claims Modernization, Active Directory, "Authenticates users", "SSO / Active Directory")

@enduml