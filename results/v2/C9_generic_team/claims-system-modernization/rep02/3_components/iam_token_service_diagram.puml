@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the IAM / Token Service container

Container_Boundary(iam_token_service, "IAM / Token Service") {
    Component(Auth_Token_Controller, "Authentication & Token Controller", "Azure Identity services / OAuth 2.0 / OIDC", "Handles incoming authentication requests and issues tokens for the Backend-for-Frontend (BFF).")
    Component(Directory_Sync_Service, "Directory Synchronization Service", "Azure AD / Entra ID Connect", "Synchronizes user identities and performs Single Sign-On with Corporate Active Directory.")
}

Rel(Auth_Token_Controller, Directory_Sync_Service, "Validates credentials and retrieves user profiles", "OIDC / SAML / LDAP")

@enduml