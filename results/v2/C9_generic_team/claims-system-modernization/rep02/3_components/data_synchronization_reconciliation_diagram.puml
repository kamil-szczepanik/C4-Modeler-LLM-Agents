@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Synchronization / Reconciliation container

Container_Boundary(data_sync_container, "Data Synchronization / Reconciliation") {
    Component(azure_functions_and_webjobs, "Azure Functions and WebJobs", "Azure Functions / WebJobs", "Serverless execution for reconciliation, background processing, and data synchronization using the Adapter Pattern and Idempotent Upsert Pattern.")
    Component(azure_service_bus, "Azure Service Bus", "Azure Service Bus", "Managed event broker providing reliable messaging, Dead Letter Queues, and routing for asynchronous synchronization events.")
    Component(azure_redis_cache, "Azure Redis Cache", "Azure Redis Cache", "Low-latency caching layer to store claim state and checksums for rapid comparison using the Idempotent Upsert Pattern.")
    Component(azure_blob_storage, "Azure Blob Storage", "Azure Blob Storage", "Claim Check payload repository used to offload heavy payloads via the Claim Check Pattern.")
    Component(azure_app_configuration_and_key_vault, "Azure App Configuration and Key Vault", "Azure App Configuration & Key Vault", "Externalized JSON/YAML mapping schemas and secrets management to support configuration-driven field transformations without code deployments.")
}

Component(on_premises_cobol_db2_mainframe, "On-Premises COBOL/DB2 Mainframe", "COBOL / DB2", "System of Record maintaining the legacy insurance claims data.")

Rel(azure_functions_and_webjobs, on_premises_cobol_db2_mainframe, "Synchronizes data via secure extraction files using the Adapter Pattern", "")
Rel(azure_functions_and_webjobs, azure_redis_cache, "Reads and writes state and cache data using the Idempotent Upsert Pattern", "")
Rel(azure_functions_and_webjobs, azure_blob_storage, "Offloads heavy payloads using the Claim Check Pattern", "")
Rel(azure_functions_and_webjobs, azure_service_bus, "Routes asynchronous synchronization events and Dead Letter Queue messages", "")

@enduml