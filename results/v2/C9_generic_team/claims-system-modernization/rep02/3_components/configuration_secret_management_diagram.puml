@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Configuration & Secret Management container

System_Ext(Microservices, "Microservices", "External microservices fetching configurations and secrets.")
System_Ext(Configuration_stores_and_microservices, "Configuration stores and microservices", "Sources of telemetry and logs.")

Container_Boundary(Configuration___Secret_Management, "Configuration & Secret Management") {
    Component(Azure_Key_Vault, "Azure Key Vault", "Azure Key Vault", "Manages secure credentials, secrets, and automated lifecycle/rotation policies to protect hybrid boundaries.")
    Component(Azure_App_Configuration, "Azure App Configuration", "Azure App Configuration", "Stores dynamic feature flags and environment settings using labels for canary testing and rapid rollbacks.")
    Component(Azure_Bicep, "Azure Bicep", "Azure Bicep", "Enforces repeatable, version-controlled Infrastructure-as-Code provisioning.")
    Component(Azure_Policy, "Azure Policy", "Azure Policy", "Provides compliance and drift detection.")
    Component(Azure_Monitor, "Azure Monitor", "Azure Monitor and Out-of-the-Box Dashboards", "Tracks telemetry, fetch latency, cache hit ratios, and authentication failures.")
    Component(CI_CD_Pipelines_with_JSON_Schema_Validation, "CI/CD Pipelines with JSON Schema Validation", "CI/CD Pipelines / JSON Schema", "Prevents malformed configurations during CI/CD deployments and deploys infrastructure.")
    Component(Centralized_Configuration_Abstraction_Layer, "Centralized Configuration Abstraction Layer", "Unified client interface", "Provides a unified client interface for microservices.")
}

Rel(Microservices, Azure_Key_Vault, "Fetches secrets using Azure SDKs", "HTTPS/TLS 1.3")
Rel(Microservices, Azure_App_Configuration, "Fetches configuration parameters using Azure SDKs", "HTTPS/TLS 1.3")
Rel(Azure_Policy, Azure_Key_Vault, "Audits settings", "Azure Bicep templates")
Rel(Azure_Policy, Azure_App_Configuration, "Audits settings", "Azure Bicep templates")
Rel(Configuration_stores_and_microservices, Azure_Monitor, "Ingests telemetry, metrics, and logs", "Azure Diagnostics")
Rel(CI_CD_Pipelines_with_JSON_Schema_Validation, Azure_App_Configuration, "Deploys infrastructure and configuration settings", "Azure Resource Manager REST APIs")
Rel(CI_CD_Pipelines_with_JSON_Schema_Validation, Azure_Key_Vault, "Deploys infrastructure and configuration settings", "Azure Resource Manager REST APIs")

@enduml