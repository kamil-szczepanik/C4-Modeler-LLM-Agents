@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Centralized Logging & Monitoring container

System_Ext(microservices_acl, "Microservices & ACL", "External systems representing microservices and the anti-corruption layer.")
System_Ext(legacy_mainframe, "Legacy COBOL/DB2 Mainframe", "Legacy mainframe system.")
System_Ext(on_call_channels, "On-Call Notification Channels", "External notification endpoints.")

Container_Boundary(centralized_logging_monitoring, "Centralized Logging & Monitoring") {
    Component(azure_monitor, "Azure Monitor", "Managed PaaS (Application Insights)", "Provides operational visibility, metrics, logs, and alerts with managed PaaS capabilities to minimize operational overhead.")
    Component(api_gateway_acl, "API Gateway / Anti-Corruption Layer (ACL)", "API Gateway with Log-Scrubbing Middleware", "Performs log-scrubbing and acts as an entry point with injected correlation IDs for legacy mainframe integration.")
    Component(azure_app_config_key_vault, "Azure App Configuration and Azure Key Vault", "Azure PaaS", "Enables dynamic log-level toggling across the architecture.")
    Component(ci_cd_linter, "CI/CD Log Schema Validation Linter", "CI/CD Pipeline Tool", "Enforces JSON structured logging and schema validation to ensure maintainability and consistent log parsing.")
    Component(azure_blob_storage, "Azure Blob Storage", "Azure Blob Storage", "Provides cold archival for compliance audit trails via automated scheduled exports.")
}

Rel(microservices_acl, azure_monitor, "Transmits telemetry", "HTTPS / OpenTelemetry (W3C Trace Context headers)")
Rel(api_gateway_acl, legacy_mainframe, "Communicates with", "Synchronous Protocol / Batch (Injected correlation IDs)")
Rel(azure_monitor, on_call_channels, "Sends actionable alerts", "HTTPS / Webhooks")
Rel(azure_monitor, azure_blob_storage, "Exports logs", "Automated Scheduled Export")

@enduml