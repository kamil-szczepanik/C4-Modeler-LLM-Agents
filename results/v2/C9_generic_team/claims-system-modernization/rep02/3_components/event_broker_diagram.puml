@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Event_Broker", "Event Broker") {
    Component("Message Ingestion Handler", "Message Ingestion Handler", "Azure Service Bus Topic Listener", "Receives asynchronous event messages from the API Gateway and BFF applications for the strangler migration.")
    Component("Claim Check Offloader", "Claim Check Offloader", "Azure Service Bus Middleware", "Offloads large payloads to Azure Blob Storage to bypass broker size limits.")
    Component("Dead-Letter Monitor", "Dead-Letter Monitor", "Azure Service Bus Dead-Letter Queue", "Monitors and captures failed messages and poisoned events to enforce reliability patterns and data consistency.")
}

Rel("Message Ingestion Handler", "Claim Check Offloader", "Routes large payloads for external storage via Claim Check pattern", "")
Rel("Message Ingestion Handler", "Dead-Letter Monitor", "Forwards failed or invalid messages", "")

@enduml