@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(caching_state_store, "Caching / State Store") {
    Component(Cache_Aside_Read_Manager, "Cache-Aside Read Manager", "Azure Redis Cache / Node.js", "Manages low-latency read models, ephemeral session state, and cache population to meet sub-2-second UI performance targets.")
    Component(Idempotency_Stampede_Prevention_Module, "Idempotency & Stampede Prevention Module", "Azure Redis Cache / Lua Scripting", "Prevents cache stampedes and guarantees operation idempotency during concurrent claim submissions.")
}

Rel(Cache_Aside_Read_Manager, Idempotency_Stampede_Prevention_Module, "Validates concurrent requests and state consistency", "Redis Protocol")

@enduml