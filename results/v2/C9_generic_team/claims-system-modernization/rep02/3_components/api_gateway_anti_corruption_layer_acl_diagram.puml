@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_acl, "API Gateway / Anti-Corruption Layer (ACL)") {
    Component(REST_API_Router, "REST API Router", "Custom microservices on Azure", "Handles incoming HTTPS/REST traffic from customers and brokers submitting claims online.")
    Component(Transformation_Engine, "Transformation Engine", "Custom microservices on Azure", "Decouples modern domain models from rigid legacy mainframe contracts using an adapter pattern.")
    Component(Cache_Manager, "Cache Manager", "Azure Redis Cache", "Executes read-through and write-behind caching to meet sub-second response SLAs.")
    Component(Message_Publisher, "Message Publisher", "Azure Service Bus", "Dispatches asynchronous event messaging and queueing for background processing.")
}

Rel(REST_API_Router, Transformation_Engine, "Routes requests for contract translation and validation", "")
Rel(Transformation_Engine, Cache_Manager, "Reads and writes cached claim data via TCP/Redis Protocol", "TCP / Redis Protocol")
Rel(Transformation_Engine, Message_Publisher, "Sends asynchronous events via AMQP/HTTPS", "AMQP / HTTPS")

@enduml