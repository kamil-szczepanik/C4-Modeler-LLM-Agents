@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(bff, "Backend-for-Frontend (BFF)") {
    Component(Adjuster_Web_Application_Handler, "Adjuster Web Application Handler", "Azure Web Applications / Node.js", "Orchestrates interactions for the adjuster web application and exposes endpoints for client consumption.")
    Component(Orchestration___Data_Retrieval_Handler, "Orchestration & Data Retrieval Handler", "Azure Web Applications / REST / gRPC", "Manages internal orchestration and data retrieval interacting with the API Gateway and ACL.")
    Component(Caching___State_Manager, "Caching & State Manager", "Azure Redis Cache / TCP", "Externalizes session state and caches pre-aggregated read models for low-latency responses.")
    Component(Event_Driven_Migration_Publisher, "Event-Driven Migration Publisher", "Azure Service Bus / AMQP", "Handles asynchronous event-driven migration tasks and messaging.")
}

Rel(Adjuster_Web_Application_Handler, Orchestration___Data_Retrieval_Handler, "Delegates requests for internal orchestration and data retrieval", "HTTPS / gRPC")
Rel(Orchestration___Data_Retrieval_Handler, Caching___State_Manager, "Reads and writes low-latency read models and session state", "TCP / Redis Protocol")
Rel(Orchestration___Data_Retrieval_Handler, Event_Driven_Migration_Publisher, "Dispatches asynchronous events for migration", "AMQP / MQTT")

@enduml