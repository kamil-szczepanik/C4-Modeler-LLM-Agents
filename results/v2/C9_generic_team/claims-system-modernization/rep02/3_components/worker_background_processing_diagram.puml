@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Worker / Background Processing container

Container_Boundary(worker_boundary, "Worker / Background Processing") {
    Component(Azure_Functions_Orchestrator, "Azure Functions Orchestrator", "Azure Functions / Durable Functions", "Orchestrates serverless background processing and handles state management.")
    Component(WebJobs_Message_Processor, "WebJobs Message Processor", "Azure WebJobs", "Processes asynchronous tasks and messages from the event broker.")
}

Rel(Azure_Functions_Orchestrator, WebJobs_Message_Processor, "Coordinates asynchronous execution flows and background tasks.", "")

@enduml