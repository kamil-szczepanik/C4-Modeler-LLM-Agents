@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Service Bus container

System_Boundary(azure_service_bus, "Azure Service Bus") {
    Component(amqp_message_publisher, "AMQP Message Publisher", "AMQP / Azure Service Bus SDK", "Publishes asynchronous events from the Azure Modular Monolith Platform to Azure Service Bus.")
    Component(message_broker, "Message Broker", "Azure Service Bus", "Acts as the asynchronous messaging backbone providing guaranteed message delivery and decoupling.")
    Component(claim_check_handler, "Claim-Check Payload Handler", "Azure Blob Storage / HTTPS", "Handles large claim attachments offloaded by the Azure Modular Monolith Platform to stay within Service Bus limits.")
    Component(telemetry_collector, "Telemetry and Tracing Collector", "Azure Application Insights", "Collects distributed trace headers and telemetry with correlation IDs across cloud and mainframe boundaries.")
}

Rel(amqp_message_publisher, message_broker, "Publishes asynchronous events using AMQP protocol", "AMQP")
Rel(azure_modular_monolith, claim_check_handler, "Offloads large claim attachments over HTTPS", "HTTPS")
Rel(telemetry_collector, message_broker, "Collects distributed trace headers and telemetry", "Telemetry / API")

@enduml