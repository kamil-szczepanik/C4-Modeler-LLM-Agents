@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure SQL Database container

System_Ext(azure_app_service, "Azure App Service", "Container executing application logic and communicating with the database.")
System_Ext(cicd_pipeline, "CI/CD Pipeline", "Automated deployment and testing runner (Azure DevOps / GitHub Actions).")

Container_Boundary(azure_sql_database, "Azure SQL Database") {
    Component(claim_data_store, "Claim Data Store", "Azure SQL Database, Temporal Tables", "Securely stores relational claims data with strict per-module schema separation and temporal auditing.")
    Component(schema_migration_engine, "Schema Migration Engine", "FluentMigrator / Entity Framework Core Migrations", "Applies isolated schema migrations and automated updates for modular database deployments.")
}

Rel(schema_migration_engine, claim_data_store, "Applies isolated schema migrations", "SQL via Azure Bicep / Terraform")
Rel(azure_app_service, claim_data_store, "Reads and writes claim data", "Tabular Data Stream over TLS")
Rel(cicd_pipeline, schema_migration_engine, "Triggers and executes migrations", "API / CLI")

@enduml