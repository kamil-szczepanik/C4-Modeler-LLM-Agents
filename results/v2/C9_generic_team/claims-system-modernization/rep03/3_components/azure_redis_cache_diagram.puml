@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(azure_redis_cache, "Azure Redis Cache") {
    Component(Cache_Manager, "Cache Manager", "Redis Protocol", "Manages transient read models and cache-aside operations to ensure sub-2-second UI response times.")
    Component(Cache_Invalidation_Service, "Cache Invalidation Service", "AMQP Listener", "Handles cache eviction and invalidation messages received from the Azure Service Bus.")
}

Rel(Cache_Manager, Cache_Invalidation_Service, "Triggers invalidation routines on domain events")

@enduml