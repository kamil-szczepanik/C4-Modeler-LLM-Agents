@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(azure_app_service, "Azure App Service") {
    Component(Azure Modular Monolith Platform, "Azure Modular Monolith Platform", "Azure App Service (Premium V3 Tier)", "Hosts the core claims management workflows and business logic.")
    Component(Anti-Corruption Layer (ACL), "Anti-Corruption Layer (ACL)", "Azure App Service", "Translates and adapts messages between the cloud platform and the legacy mainframe.")
}

Rel(Azure Modular Monolith Platform, Anti-Corruption Layer (ACL), "Delegates hybrid communication")

@enduml