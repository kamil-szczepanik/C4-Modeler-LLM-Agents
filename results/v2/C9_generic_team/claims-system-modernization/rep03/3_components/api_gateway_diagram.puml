@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(Azure_API_Management_APIM, "Azure API Management (APIM)", "Azure API Management, OpenAPI 3.0, JSON Schema", "Serves as the entry-point API Gateway, enforcing out-of-the-box routing, rate limiting, policy enforcement, and payload validation.")
}

System_Ext(Microsoft_Entra_ID, "Microsoft Entra ID", "Identity Provider")
System_Ext(Azure_App_Service, "Azure App Service", "Upstream System / Modular Monolith")
System_Ext(On_Premises_COBOL_DB2_Mainframe, "On-Premises COBOL/DB2 Mainframe", "Legacy System")
System_Ext(Azure_Application_Insights, "Azure Application Insights", "Observability")

Rel(Azure_API_Management_APIM, Microsoft_Entra_ID, "Authenticates requests", "OpenID Connect / OAuth 2.0")
Rel(Azure_API_Management_APIM, Azure_App_Service, "Forwards validated requests", "HTTPS / W3C Trace Context")
Rel(Azure_API_Management_APIM, On_Premises_COBOL_DB2_Mainframe, "Routes fallback/legacy claim types", "ExpressRoute / HTTPS")
Rel(Azure_API_Management_APIM, Azure_Application_Insights, "Exports sanitized telemetry", "HTTPS")

@enduml