@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Application Insights container

Container_Boundary("Azure Application Insights", "Azure Application Insights") {
    Component("Telemetry_Collector", "Telemetry Collector", "Application Insights SDK", "Collects telemetry, logs, and trace data from the Azure App Service.")
    Component("Distributed_Tracer", "Distributed Tracer", "OpenTelemetry / Application Insights", "Ensures distributed tracing and observability across the hybrid cloud-mainframe boundary.")
}

Rel(Telemetry_Collector, Distributed_Tracer, "Forwards collected logs and metrics for analysis", "HTTPS")

@enduml