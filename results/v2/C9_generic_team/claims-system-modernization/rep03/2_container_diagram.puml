@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Insurance Claims Modernization system

Person(CustomersAndBrokers, "Customers and Brokers", "Submit online claims and interact with the insurance system.")
Person(ClaimsAdjusters, "Claims Adjusters", "Process claims and manage workflows.")

System_Ext(COBOLDB2OnPremisesMainframeSystemofRecord, "COBOL/DB2 On-Premises Mainframe System of Record", "Legacy 30-year-old mainframe system holding core records and data.")
System_Ext(MicrosoftEntraIDAzureAD, "Microsoft Entra ID (Azure AD)", "Provides enterprise identity and authentication services.")

System_Boundary(AzureModularMonolithPlatform, "Azure Modular Monolith Platform") {
    Container(APIGateway, "API Gateway", "Azure API Gateway", "Routes incoming requests and handles initial entry for online claim submissions.")
    Container(AzureAppService, "Azure App Service", "Azure App Service (PaaS)", "Hosting the Azure Modular Monolith Platform and Anti-Corruption Layer (ACL).")
    ContainerDb(AzureSQLDatabase, "Azure SQL Database", "Azure SQL Database", "Stores relational claims data with strict per-module schema separation.")
    Container(AzureServiceBus, "Azure Service Bus", "Azure Service Bus", "Enables asynchronous decoupling and communication with the on-premises mainframe.")
    Container(AzureRedisCache, "Azure Redis Cache", "Azure Redis Cache", "Caches read models to ensure sub-2-second UI responses.")
    Container(AzureApplicationInsights, "Azure Application Insights", "Azure Application Insights", "Provides distributed tracing across hybrid boundaries for observability.")
}

Rel(CustomersAndBrokers, APIGateway, "Submit online claims", "HTTPS")
Rel(ClaimsAdjusters, AzureAppService, "Interact for claims management and workflows", "HTTPS")
Rel(APIGateway, MicrosoftEntraIDAzureAD, "Authenticates users", "OpenID Connect/OAuth 2.0")
Rel(APIGateway, AzureAppService, "Forwards authenticated claim submission requests", "HTTPS")
Rel(AzureAppService, COBOLDB2OnPremisesMainframeSystemofRecord, "Communicates asynchronously via Anti-Corruption Layer", "Azure Service Bus")
Rel(AzureAppService, AzureSQLDatabase, "Reads and writes claim data", "Tabular Data Stream")
Rel(AzureAppService, AzureRedisCache, "Caches and retrieves read models", "Redis Protocol")
Rel(AzureAppService, AzureApplicationInsights, "Sends telemetry and trace data", "HTTPS")

@enduml