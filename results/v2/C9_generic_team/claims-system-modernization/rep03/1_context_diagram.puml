@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers_and_Brokers, "Customers and Brokers", "Submit claims to the insurance system.")
Person(Claims_Adjusters, "Claims Adjusters", "Interact with the claims application to process claims.")

System(Azure_Modular_Monolith_Platform, "Azure Modular Monolith Platform", "Modernizes a 30-year-old regional insurance mainframe claims system using a hybrid cloud approach, gradually migrating claim types to an Azure-hosted platform while ensuring business continuity.")

System_Ext(COBOL_DB2_On_Premises_Mainframe_System_of_Record, "COBOL/DB2 On-Premises Mainframe System of Record", "Legacy 30-year-old mainframe system holding core records and data.")
System_Ext(Azure_Active_Directory, "Azure Active Directory", "Provides enterprise identity and single sign-on capabilities.")

Rel(Customers_and_Brokers, Azure_Modular_Monolith_Platform, "Submit claims", "HTTPS/REST APIs")
Rel(Claims_Adjusters, Azure_Modular_Monolith_Platform, "Interact with the claims web application", "HTTPS")
Rel(Azure_Modular_Monolith_Platform, COBOL_DB2_On_Premises_Mainframe_System_of_Record, "Routes traffic and synchronizes data via facade and ACL", "HTTPS/MQ")
Rel(Azure_Modular_Monolith_Platform, Azure_Active_Directory, "Authenticates users", "OpenID Connect/OAuth2")

@enduml