@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Azure Claims Modernization Platform

Person(CustomersAndBrokers, "Customers and Brokers", "Users who submit claims online via the modern platform.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal users who interact with and process claims via a web application.")

System_Ext(OnPremisesCOBOLDB2Mainframe, "On-Premises COBOL/DB2 Mainframe", "System of record containing legacy claims data and processing logic.")
System_Ext(ActiveDirectory, "Active Directory", "Identity Provider used for Single Sign-On (SSO) integration.")

System_Boundary(AzureClaimsModernizationPlatform, "Azure Claims Modernization Platform") {
    Container(BackendForFrontendBFF, "Backend-for-Frontend (BFF)", "Azure Container Apps", "Handles incoming requests from web interfaces and communicates with internal services.")
    Container(ModularMonolith, "Modular Monolith", "Azure Container Apps", "Core business logic container maintaining clean internal boundaries.")
    Container(AntiCorruptionLayerACL, "Anti-Corruption Layer (ACL)", "Azure Container Apps", "Isolates legacy schemas and communicates with the on-premises mainframe.")
    Container(AzureServiceBus, "Azure Service Bus", "Azure Service Bus", "Message broker providing asynchronous messaging and zero data loss.")
    ContainerDb(AzureCosmosDBRedis, "Azure Cosmos DB / Redis", "Azure Cosmos DB, Redis", "State store and transactional outbox cache.")
    Container(AzureKeyVault, "Azure Key Vault", "Azure Key Vault", "Centralized secrets management.")
}

Rel(CustomersAndBrokers, BackendForFrontendBFF, "Submit claims online", "HTTPS/REST")
Rel(ClaimsAdjusters, BackendForFrontendBFF, "Claim handling and processing", "HTTPS/REST")
Rel(BackendForFrontendBFF, ModularMonolith, "Communicates for application logic", "Internal HTTPS/REST")
Rel(ModularMonolith, AzureCosmosDBRedis, "Transactional outbox persistence and state management", "TCP/TLS")
Rel(AntiCorruptionLayerACL, OnPremisesCOBOLDB2Mainframe, "Integrates with legacy system of record", "Legacy protocols over secure VPN/ExpressRoute")
Rel(BackendForFrontendBFF, AzureKeyVault, "Retrieves secrets securely", "HTTPS")
Rel(ModularMonolith, AzureKeyVault, "Retrieves secrets securely", "HTTPS")
Rel(AntiCorruptionLayerACL, AzureKeyVault, "Retrieves secrets securely", "HTTPS")

@enduml