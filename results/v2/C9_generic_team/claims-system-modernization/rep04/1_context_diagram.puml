@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(CustomersAndBrokers, "Customers and Brokers", "Users who submit claims online via the modern platform.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal users who interact with and process claims via a web application.")

System(AzureClaimsModernizationPlatform, "Azure Claims Modernization Platform", "A modern Azure-hosted platform gradually replacing a 30-year-old COBOL/DB2 mainframe claims system using a Strangler Fig migration pattern to maintain continuous claim processing.")

System_Ext(OnPremisesCOBOLDB2Mainframe, "On-Premises COBOL/DB2 Mainframe", "System of record containing legacy claims data and processing logic.")
System_Ext(ActiveDirectory, "Active Directory", "Identity Provider used for Single Sign-On (SSO) integration.")

Rel(CustomersAndBrokers, AzureClaimsModernizationPlatform, "Submit claims online", "HTTPS")
Rel(ClaimsAdjusters, AzureClaimsModernizationPlatform, "Interact with and process claims", "HTTPS, Azure Active Directory SSO")
Rel(AzureClaimsModernizationPlatform, OnPremisesCOBOLDB2Mainframe, "Communicates asynchronously and routes traffic dynamically via integration gateway", "Asynchronous Messaging, Anti-Corruption Layer")
Rel(AzureClaimsModernizationPlatform, ActiveDirectory, "Authenticates users via SSO", "OIDC / OAuth")

@enduml