@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Modular Monolith", "Modular Monolith") {
    Component(Claims Processing Module, "Claims Processing Module", "C# / .NET Core", "Encapsulates core business logic and rules for online claims and adjuster workflows.")
    Component(Data Access Layer, "Data Access Layer", "Entity Framework Core / TCP/TLS", "Persists state to Azure Cosmos DB and caches read models via Redis.")
    Component(Integration Outbox Service, "Integration Outbox Service", ".NET Core / AMQP", "Publishes claim events asynchronously to Azure Service Bus for synchronization with the ACL.")
    Component(Secret Management Client, "Secret Management Client", "Azure SDK for .NET / HTTPS", "Retrieves secrets securely from Azure Key Vault.")
}

Rel(Claims Processing Module, Data Access Layer, "Persists state and caches read models via", "TCP/TLS")
Rel(Claims Processing Module, Integration Outbox Service, "Dispatches domain events to", "AMQP")
Rel(Claims Processing Module, Secret Management Client, "Requests runtime secrets from", "HTTPS")
@enduml