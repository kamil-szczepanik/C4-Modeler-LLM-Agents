@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(acl, "Anti-Corruption Layer (ACL)") {
    Component(TransactionalOutboxAndDeDuplicationEngine, "Transactional Outbox & De-duplication Engine", "Redis, .NET / C#", "Manages reliable messaging and idempotency via Redis.")
    Component(DataTransformationAndMappingLayer, "Data Transformation & Mapping Layer", ".NET / C#, Pact", "Translates legacy COBOL copybooks into modern domain events and enforces payload validation.")
    Component(ResilienceAndRoutingManager, "Resilience & Routing Manager", ".NET / C#, Polly", "Implements Circuit Breakers, Feature Flags, and declarative routing rules.")
    Component(MonitoringAndDiagnostics, "Monitoring & Diagnostics", "Azure Monitor, OpenTelemetry", "Handles distributed tracing, health check probes, and Dead Letter Queue (DLQ) operations.")
}

Rel(ResilienceAndRoutingManager, DataTransformationAndMappingLayer, "Routes processed requests to transformation", "")
Rel(DataTransformationAndMappingLayer, TransactionalOutboxAndDeDuplicationEngine, "Saves outbox state and checks idempotency", "")

@enduml