@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Key Vault container

System_Ext(BFF, "Backend-for-Frontend (BFF)", "Azure Container App handling client routing")
System_Ext(Monolith, "Modular Monolith", "Azure Container App containing core business logic")
System_Ext(ACL, "Anti-Corruption Layer (ACL)", "Azure Container App integrating with the mainframe")

Container_Boundary(azure_key_vault, "Azure Key Vault") {
    Component(SecretsManagementEngine, "Secrets Management Engine", "Azure Key Vault Service", "Centralized, secure storage for database connection strings and API credentials.")
    Component(AccessControlAndIdentityValidator, "Access Control and Identity Validator", "Azure Managed Identities", "Authenticates and authorizes callers securely, eliminating hardcoded credentials.")
    Component(AuditAndDiagnosticsLogger, "Audit and Diagnostics Logger", "Azure Monitor", "Provides diagnostic logging and auditing for access tracking and compliance.")
}

Rel(BFF, SecretsManagementEngine, "Retrieves secrets securely", "HTTPS via Managed Identity")
Rel(Monolith, SecretsManagementEngine, "Retrieves secrets securely", "HTTPS via Managed Identity")
Rel(ACL, SecretsManagementEngine, "Retrieves secrets securely", "HTTPS via Managed Identity")

@enduml