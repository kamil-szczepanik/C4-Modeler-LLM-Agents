@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Backend-for-Frontend (BFF) container

Container_Boundary(bff, "Backend-for-Frontend (BFF)") {
    Component(api_gateway, "API Gateway Controller", "Azure Container Apps / OpenAPI/Swagger", "Standardizes API contracts, schema validation at the BFF boundary, and routes incoming requests from customers, brokers, and claims adjusters.")
    Component(session_cache, "Session and Cache Manager", "Azure Redis Cache", "Manages session state and aggressive caching to meet sub-2s response requirements.")
    Component(security_retriever, "Security and Secret Retriever", "Azure Key Vault / Active Directory", "Handles secure secret retrieval and integrates with Active Directory for identity provision.")
    Component(tracing_agent, "Tracing and Telemetry Agent", "W3C Trace Context headers", "Enables distributed tracing across the hybrid Azure and on-prem boundary.")
}

Rel(api_gateway, session_cache, "Caches session state and query results", "In-Memory/TCP")
Rel(api_gateway, security_retriever, "Secure secret retrieval", "HTTPS")
Rel(api_gateway, tracing_agent, "Injects and propagates W3C Trace Context headers", "HTTP Headers")

@enduml