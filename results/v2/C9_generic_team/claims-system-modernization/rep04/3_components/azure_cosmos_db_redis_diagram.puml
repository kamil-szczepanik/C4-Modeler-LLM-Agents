@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Cosmos DB / Redis container

Container_Boundary(azure_cosmos_redis, "Azure Cosmos DB / Redis") {
    Component(Azure_Cosmos_DB_NoSQL_Store, "Azure Cosmos DB NoSQL Store", "Azure Cosmos DB (NoSQL)", "Primary NoSQL state store and transactional outbox persistence layer with strong session consistency.")
    Component(Azure_Redis_Cache_Layer, "Azure Redis Cache Layer", "Azure Redis Cache", "Distributed cache and locking mechanism utilizing a Cache-Aside strategy for rapid adjuster screen loads.")
}

Rel(Azure_Cosmos_DB_NoSQL_Store, Azure_Redis_Cache_Layer, "Supports data consistency and state management alongside", "")

@enduml