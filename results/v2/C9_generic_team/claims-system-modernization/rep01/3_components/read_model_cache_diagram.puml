@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Read-Model Cache container

System_Ext(Adjuster Web Application, "Adjuster Web Application", "External system interacting with the read-model cache.")

Container_Boundary(read_model_cache, "Read-Model Cache") {
    Component(Azure Redis Cache, "Azure Redis Cache", "Azure Redis Cache", "Provides low-latency in-memory data storage to meet the sub-2s performance requirement (R-05).")
    Component(Repository Abstraction Layer, "Repository Abstraction Layer", ".NET Core", "Encapsulates cache logic and connection management to improve maintainability for a team with limited cloud experience.")
    Component(Data Synchronization Worker, "Data Synchronization Worker", ".NET Background Worker", "Updates claim states asynchronously with Optimistic Concurrency Control.")
    Component(Azure App Configuration, "Azure App Configuration", "Azure App Configuration", "Externalizes cache timeouts, TTL policies, and retry limits for dynamic runtime tuning.")
    Component(Application Insights, "Application Insights", "Azure Monitor / Application Insights", "Tracks hit/miss ratios, latency, and cache metrics via Telemetry API.")
}

Rel(Repository Abstraction Layer, Azure Redis Cache, "Read and write claim states securely", "TCP / Redis Protocol")
Rel(Data Synchronization Worker, Azure Redis Cache, "Update claim states asynchronously with Optimistic Concurrency Control", "Redis MULTI/EXEC")
Rel(Adjuster Web Application, Repository Abstraction Layer, "Serve low-latency claim reads under 2s with Cache-Aside pattern", "Internal API")
Rel(Application Insights, Azure Redis Cache, "Track hit/miss ratios, latency, and cache metrics", "Telemetry API")

@enduml