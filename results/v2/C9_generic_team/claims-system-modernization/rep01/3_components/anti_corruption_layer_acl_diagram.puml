@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(acl, "Anti-Corruption Layer (ACL)") {
    Component(ClaimTranslationComponent, "Claim Translation Component", ".NET Core / Modular Monolith", "Translates modern claim data models into legacy-compatible formats for the mainframe.")
    Component(LegacyDispatcherComponent, "Legacy Dispatcher Component", ".NET Core with Polly", "Dispatches claim data to the on-premises COBOL/DB2 mainframe using circuit breaker and resilience patterns.")
}

Rel(ClaimTranslationComponent, LegacyDispatcherComponent, "Passes translated claim payloads")

@startuml