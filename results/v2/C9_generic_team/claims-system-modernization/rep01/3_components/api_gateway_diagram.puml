@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(Edge Routing and Rate Limiting Component, "Edge Routing and Rate Limiting Component", "Azure API Gateway", "Handles edge routing, rate limiting, circuit breaking, and response caching for incoming traffic.")
    Component(Security and Validation Component, "Security and Validation Component", "Azure API Gateway / JWT / OAuth2", "Performs JWT/OAuth2 validation, request aggregation, and error transformation.")
    Component(Routing Control Component, "Routing Control Component", "Azure App Configuration", "Dynamically toggles claim-type routing for rapid rollback via feature flag management.")
}

Rel(Edge Routing and Rate Limiting Component, Security and Validation Component, "Validates and secures incoming requests")
Rel(Security and Validation Component, Routing Control Component, "Checks feature flags for claim-type routing")

@enduml