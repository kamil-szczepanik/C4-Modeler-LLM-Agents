@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database Migration & Schema Versioning Module container

Container_Boundary(db_migration_module, "Database Migration & Schema Versioning Module") {
    Component(Schema_Versioning_Runner, "Schema Versioning Runner", "Flyway", "Executes pure SQL declarative scripts for transparent, reproducible schema evolution.")
}

System_Ext(Target_Relational_Database, "Target Relational Database", "Stores the application and claim data.")

Rel(Schema_Versioning_Runner, Target_Relational_Database, "Executes schema versioning via JDBC", "JDBC")

@enduml