@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Synchronization Worker container

System_Ext(Azure_Service_Bus, "Azure Service Bus", "Messaging broker for asynchronous communication.")
System_Ext(Read_Model_Cache, "Read-Model Cache", "Azure Cache / In-Memory Database providing fast read access for adjusters.")

Container_Boundary(Data_Synchronization_Worker_boundary, "Data Synchronization Worker") {
    Component(Data_Synchronization_Worker, "Data Synchronization Worker", ".NET Background Worker", "Executes asynchronous state updates, consuming and processing synchronization messages from the Azure Service Bus and updating the Read-Model Cache.")
}

Rel(Data_Synchronization_Worker, Azure_Service_Bus, "Consume and process synchronization messages", "AMQP")
Rel(Data_Synchronization_Worker, Read_Model_Cache, "Update claim states", "TCP/Redis Protocol")

@enduml