@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(feature_flag_management_module, "Feature Flag Management Module") {
    Component(Feature_Flag_Management_Module, "Feature Flag Management Module", "Azure App Configuration", "Dynamically controls claim-type routing between the legacy mainframe and the modern Azure platform.")
    Component(API_Gateway_and_Anti_Corruption_Layer_ACL, "API Gateway and Anti-Corruption Layer (ACL)", ".NET Core / Modular Monolith", "Routes claims and handles anti-corruption layer translation.")
    Component(Centralized_Observability_Audit_Logging_Module, "Centralized Observability & Audit Logging Module", "Azure Monitor / Application Insights", "Emits telemetry and audit logs.")
    Component(GitOps_Pipeline_and_Version_Controlled_Configuration_Repositories, "GitOps Pipeline and Version-Controlled Configuration Repositories", "Version-Controlled JSON/YAML", "Manages flags as code to prevent manual human error.")
    Component(Feature_Flag_Facade_Wrapper, "Feature Flag Facade / Wrapper", "Custom Abstraction & In-memory Caching", "Provides local caching with a 30-second TTL to ensure sub-2-second response times and circuit breaker fail-safe defaults.")
}

Rel(Feature_Flag_Management_Module, API_Gateway_and_Anti_Corruption_Layer_ACL, "Dynamically toggles claim-type routing", "REST API / Azure SDK")
Rel(Feature_Flag_Management_Module, Centralized_Observability_Audit_Logging_Module, "Emits telemetry and audit logs", "Azure Monitor")
@enduml