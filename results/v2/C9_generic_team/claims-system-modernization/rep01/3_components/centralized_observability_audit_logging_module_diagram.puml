@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Centralized Observability & Audit Logging Module container

Container_Boundary(observability_module, "Centralized Observability & Audit Logging Module") {
    Component(Telemetry_Collector, "Telemetry Collector", "Azure Monitor / Application Insights (W3C Trace Context, HTTPS)", "Receives and aggregates structured JSON logs and telemetry streams from all .NET Core modules.")
    Component(Audit_Trail_Manager, "Audit Trail Manager", "Azure Log Analytics", "Maintains compliance-ready audit trails and structured logs for system access and claim modifications.")
}

Rel(Telemetry_Collector, Audit_Trail_Manager, "Forwards structured telemetry and logs to", "")

@enduml