@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claim Ingestion & Validation Module container

Container_Boundary(claim_ingestion_container, "Claim Ingestion & Validation Module") {
    Component(Claim_Ingestion_Validation_Module, "Claim Ingestion & Validation Module", ".NET Core / Modular Monolith", "Acts as the entry point, ensuring secure, idempotent, and validated processing of online claims.")
}

System_Ext(Azure_Blob_Storage, "Azure Blob Storage", "Stores large claim attachments via Claim Check Pattern")
System_Ext(Anti_Corruption_Layer_ACL, "Anti-Corruption Layer (ACL)", ".NET Core / Modular Monolith", "Receives validated claim payloads")
System_Ext(Azure_Monitor_Application_Insights, "Azure Monitor / Application Insights", "Application Performance Monitoring", "Collects structured telemetry")

Rel(Claim_Ingestion_Validation_Module, Azure_Blob_Storage, "Store large claim attachments via Claim Check Pattern", "HTTPS")
Rel(Claim_Ingestion_Validation_Module, Anti_Corruption_Layer_ACL, "Forward validated claim payloads", "Azure Service Bus")
Rel(Claim_Ingestion_Validation_Module, Azure_Monitor_Application_Insights, "Emit structured telemetry", "HTTPS")

@enduml