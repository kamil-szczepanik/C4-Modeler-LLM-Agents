@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(CustomersAndBrokers, "Customers and Brokers", "Submit online claims and interact with the platform.")
Person(ClaimsAdjusters, "Claims Adjusters", "Handle claims through the modern platform.")
System(HybridInsuranceClaimsModernizationPlatform, "Hybrid Insurance Claims Modernization Platform", "Gradually replaces a legacy mainframe claims system with a modern cloud platform while ensuring uninterrupted legacy processing.")
System_Ext(OnPremisesCOBOLDB2Mainframe, "On-Premises COBOL/DB2 Mainframe", "System of record for legacy insurance claims processing.")
System_Ext(AzureServiceBus, "Azure Service Bus", "Provides idempotent, reliable messaging for claims ingestion and state synchronization.")
System_Ext(AzureKeyVault, "Azure Key Vault", "Centralizes secret and configuration management using Managed Identity.")

Rel(CustomersAndBrokers, HybridInsuranceClaimsModernizationPlatform, "Interact for online claim submission", "HTTPS")
Rel(ClaimsAdjusters, HybridInsuranceClaimsModernizationPlatform, "Interact for claim handling", "HTTPS")
Rel(HybridInsuranceClaimsModernizationPlatform, OnPremisesCOBOLDB2Mainframe, "Integrates via Centralized API Gateway", "REST/JSON")
Rel(HybridInsuranceClaimsModernizationPlatform, AzureKeyVault, "Securely retrieves secrets", "Managed Identity")
Rel(HybridInsuranceClaimsModernizationPlatform, AzureServiceBus, "Asynchronous events flow for claims ingestion and state synchronization", "AMQP / Messaging")

@enduml