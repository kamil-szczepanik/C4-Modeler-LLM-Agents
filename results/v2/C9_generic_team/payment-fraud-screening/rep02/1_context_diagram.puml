@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalyst, "Fraud Analyst", "Reviews cases and manages fraud analysis via the Case Management UI.")
System_Ext(PaymentGatewayAcquirer, "Payment Gateway / Acquirer", "Sends synchronous authorization requests for card-not-present payments.")
System(RealTimePaymentFraudScreening, "Real-Time Payment Fraud Screening", "Screens card-not-present payment authorizations for fraud, providing sub-50ms decisions and case management for human analysts under strict PCI-DSS Level 1 compliance.")

Rel(PaymentGatewayAcquirer, RealTimePaymentFraudScreening, "Sends synchronous authorization requests", "HTTPS/JSON")
Rel(FraudAnalyst, RealTimePaymentFraudScreening, "Accesses Case Management UI asynchronously", "TLS")
@enduml