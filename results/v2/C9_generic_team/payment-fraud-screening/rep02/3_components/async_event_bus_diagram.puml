@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("async_event_bus", "Async Event Bus") {
    Component(EventPublisher, "Event Publisher", "AWS SDK", "Publishes transaction scoring events from the scoring engine to the event bus.")
    Component(EventRouter, "Event Router", "AWS EventBridge", "Routes incoming scoring events to appropriate downstream queues and targets.")
    Component(EventQueue, "Event Queue", "AWS SQS", "Queues suspicious case events and decision audit logs for asynchronous processing.")
}

Rel(EventPublisher, EventRouter, "Publishes scoring events", "AWS SDK over SQS/EventBridge")
Rel(EventRouter, EventQueue, "Dispatches events to queues", "AWS SQS/SNS")
@enduml