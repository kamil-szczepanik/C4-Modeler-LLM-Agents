@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the High-Performance Scoring Engine container

Container_Boundary(scoring_engine, "High-Performance Scoring Engine") {
    Component(api_gateway, "API Gateway / Ingestion Container", "Envoy proxy / AWS API Gateway", "Routes authorization requests via gRPC over internal VPC.")
    Component(feature_store, "Feature Store", "Redis with local in-memory LRU cache", "Fetches transaction features using Redis Protocol with strict 15ms timeout budget.")
    Component(async_event_bus, "Async Event Bus", "AWS SQS / EventBridge", "Publishes transaction decisions and audit events using AWS SDK / JSON over SQS.")
    Component(audit_storage, "Audit & Compliance Storage", "AWS S3 with Object Lock and Parquet format", "Persists immutable input snapshots and model versions using AWS SDK / HTTPS.")
    Component(model_registry, "Model & Rule Registry Container", "Containerized Registry", "Provides hot-reloadable models for transaction evaluation.")
}

Rel(api_gateway, scoring_engine, "Routes authorization requests", "gRPC over internal VPC")
Rel(scoring_engine, feature_store, "Fetches transaction features", "Redis Protocol with strict 15ms timeout budget")
Rel(scoring_engine, async_event_bus, "Publishes transaction decisions and audit events", "AWS SDK / JSON over SQS")
Rel(scoring_engine, audit_storage, "Persists immutable input snapshots and model versions", "AWS SDK / HTTPS")

@enduml