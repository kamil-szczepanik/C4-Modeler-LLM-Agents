@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("API Gateway / Ingestion Container", "API Gateway / Ingestion Container") {
    Component("AWS_API_Gateway_Envoy_proxy", "AWS API Gateway & Envoy proxy", "AWS API Gateway & Envoy proxy", "Serves as the secure edge proxy handling external ingress, request validation, edge routing, circuit breaking, and low-latency gRPC connection pooling.")
    Component("Protocol_Buffers_Serializer", "Protocol Buffers Serializer", "Protocol Buffers", "Minimizes serialization overhead for validated payloads to meet the 50 ms P99 latency target.")
    Component("W3C_Trace_Context_AWS_X_Ray", "W3C Trace Context & AWS X-Ray", "W3C Trace Context & AWS X-Ray", "Enables distributed tracing for compliance and auditability.")
    Component("Idempotency_Token_Cache", "Idempotency & Token Cache", "Redis (Native Envoy Integration)", "Handles sliding-window idempotency checks and request deduplication.")
}

Rel("AWS_API_Gateway_Envoy_proxy", "Protocol_Buffers_Serializer", "Serializes validated payloads", "Protocol Buffers")
Rel("AWS_API_Gateway_Envoy_proxy", "Idempotency_Token_Cache", "Performs deduplication and idempotency checks", "Internal TCP")
Rel("AWS_API_Gateway_Envoy_proxy", "W3C_Trace_Context_AWS_X_Ray", "Propagates trace context for distributed tracing", "")
@enduml