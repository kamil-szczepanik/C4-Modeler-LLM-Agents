@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Feature_Store", "Feature Store") {
    Component(In_Memory_Feature_Cache, "In-Memory Feature Cache", "AWS ElastiCache for Redis", "Provides sub-millisecond operational feature retrieval using batch pipelining and an L1 cache.")
    Component(Cold_Historical_Feature_Storage, "Cold Historical Feature Storage", "Amazon S3 / DynamoDB", "Provides fallback lookup for historical features and supports 7-year audit requirements.")
    Component(Snapshot_Publisher, "Snapshot Publisher", "AWS SDK / JSON over TLS", "Publishes immutable point-in-time feature snapshots to the async event bus.")
}

Rel(In_Memory_Feature_Cache, Snapshot_Publisher, "Publishes immutable point-in-time feature snapshots", "AWS SDK / JSON over TLS")
Rel(In_Memory_Feature_Cache, Cold_Historical_Feature_Storage, "Fallback lookup for historical features", "HTTPS")

@enduml