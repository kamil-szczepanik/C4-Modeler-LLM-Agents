@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(case_management_web_application, "Case Management Web Application") {
    Component(Backend_for_Frontend_API, "Backend-for-Frontend API", "AWS ECS on Fargate, OpenAPI", "Provides a secure interface, strict data masking, schema validation, and contract testing.")
    Component(Stateless_Session_Manager, "Stateless Session Manager", "Redis", "Manages stateless session storage for horizontal scaling.")
    Component(Audit_Logger, "Audit Logger", "S3 API, HTTPS", "Writes immutable audit logs of analyst actions for compliance.")
}

Rel(Backend_for_Frontend_API, Stateless_Session_Manager, "Manages sessions using")
Rel(Backend_for_Frontend_API, Audit_Logger, "Writes immutable audit logs to")
@enduml