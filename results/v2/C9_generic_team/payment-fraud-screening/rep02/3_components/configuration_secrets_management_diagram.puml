@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(config_secrets_mgmt, "Configuration & Secrets Management") {
    Component(AWS_Systems_Manager_Parameter_Store, "AWS Systems Manager Parameter Store", "AWS SSM Parameter Store", "Stores non-sensitive application configurations and feature flags.")
    Component(AWS_Secrets_Manager, "AWS Secrets Manager", "AWS Secrets Manager", "Manages sensitive credentials and API keys with native AWS Lambda rotation.")
    Component(High_Performance_Scoring_Engine, "High-Performance Scoring Engine", "AWS ECS on Fargate", "Consumes and caches configurations locally in-memory to maintain sub-50ms latency.")
    Component(Git_Ops_Infrastructure_as_Code_Pipeline, "Git-Ops / Infrastructure-as-Code Pipeline", "GitHub / GitLab CI", "Acts as the single source of truth and enforces CI/CD schema validation.")
    Component(Amazon_CloudWatch, "Amazon CloudWatch", "Amazon CloudWatch Metrics & Alarms", "Monitors cache age, fallback activation, and schema validation failure metrics.")
}

Rel(High_Performance_Scoring_Engine, AWS_Systems_Manager_Parameter_Store, "Polls configurations", "HTTPS over AWS PrivateLink")
Rel(High_Performance_Scoring_Engine, AWS_Secrets_Manager, "Polls credentials", "HTTPS over AWS PrivateLink")
Rel(Git_Ops_Infrastructure_as_Code_Pipeline, AWS_Systems_Manager_Parameter_Store, "Pushes validated configurations", "AWS SDK / API")
Rel(High_Performance_Scoring_Engine, Amazon_CloudWatch, "Emits operational telemetry", "AWS SDK")
@enduml