@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Model & Rule Registry Container container

Container_Boundary(model_rule_registry_container, "Model & Rule Registry Container") {
    Component(Model_Rule_Registry_API, "Model & Rule Registry API", "OpenAPI/Swagger", "Defines the API contract and handles incoming requests for publishing versioned model and rule artifacts.")
    Component(Artifact_Publisher, "Artifact Publisher", "AWS ECS on Fargate", "Publishes versioned model and rule artifacts to AWS S3 and updates configuration pointers in AWS Parameter Store.")
}

Rel(Model_Rule_Registry_API, Artifact_Publisher, "Invokes artifact storage and configuration updates", "")

@enduml