@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit & Compliance Storage container

Container_Boundary(audit_compliance_storage, "Audit & Compliance Storage") {
    Component(Audit_Event_Ingestion_Consumer, "Audit Event Ingestion Consumer", "AWS Lambda / ECS Worker", "Consumes immutable audit logs and scoring decisions from the Async Event Bus.")
    Component(Data_Transformation_Parquet_Writer, "Data Transformation & Parquet Writer", "Python / Apache Arrow", "Transforms raw audit events into Parquet format for optimized storage and querying.")
    Component(Object_Lock_Enforcement_Manager, "Object Lock Enforcement Manager", "AWS S3 Object Lock (Compliance Mode)", "Enforces 7-year tamper-evident retention policies on stored compliance data.")
    Component(Query_Analytics_Interface, "Query & Analytics Interface", "Amazon Athena with Partition Projection", "Provides cost-controlled serverless querying capabilities over compliance storage.")
}

Rel(Audit_Event_Ingestion_Consumer, Data_Transformation_Parquet_Writer, "Passes raw event payloads for formatting", "Internal")
Rel(Data_Transformation_Parquet_Writer, Object_Lock_Enforcement_Manager, "Writes structured Parquet files with compliance retention locks", "AWS S3 API")
Rel(Query_Analytics_Interface, Object_Lock_Enforcement_Manager, "Queries immutable audit records for regulatory review", "SQL")

@enduml