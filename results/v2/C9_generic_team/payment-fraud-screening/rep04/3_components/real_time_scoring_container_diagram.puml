@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Real-Time Scoring Container container

Container_Boundary(real_time_scoring_container, "Real-Time Scoring Container") {
    Component(Model Evaluation Engine, "Model Evaluation Engine", "In-memory C++ / Python runtime", "Evaluates card-not-present payment authorizations against memory-resident models with sub-50ms latency.")
    Component(Hot-Reload Manager, "Hot-Reload Manager", "HTTPS client", "Fetches and hot-reloads machine learning models from Amazon S3 achieving zero-downtime model updates.")
    Component(Event Dispatcher, "Event Dispatcher", "AWS SDK", "Dispatches decision events asynchronously to AWS SQS / Kinesis and handles tamper-evident audit logging.")
    Component(Resilience & Telemetry Manager, "Resilience & Telemetry Manager", "Circuit Breaker / Prometheus metrics", "Provides circuit breaking, graceful fallback mechanisms, and Prometheus-compatible histograms for local metrics scraping.")
}

System_Ext(Amazon S3, "Amazon S3", "Storage for machine learning models")
System_Ext(AWS SQS / Kinesis, "AWS SQS / Kinesis", "Message queue / event stream for asynchronous decision events")

Rel(Model Evaluation Engine, Event Dispatcher, "Dispatches decision events asynchronously", "AWS SDK")
Rel(Hot-Reload Manager, Amazon S3, "Hot-reloads machine learning models", "HTTPS")
Rel(Event Dispatcher, AWS SQS / Kinesis, "Sends asynchronous decision events", "AWS SDK")

@enduml