@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon S3 container

System_Ext(RealTimeScoringContainer, "Real-Time Scoring Container", "External consumer container")
System_Ext(AuditLoggingContainer, "Audit Logging Container", "External consumer container")

Container_Boundary(AmazonS3, "Amazon S3") {
    Component(ModelArtifactsStore, "Model Artifacts Store", "Content-Addressable Storage with SSE-KMS", "Stores versioned model tar.gz artifacts for the Real-Time Scoring Container.")
    Component(TamperEvidentAuditLogStore, "Tamper-Evident Audit Log Store", "Object Lock WORM Storage with Glacier Lifecycle", "Maintains tamper-evident audit records in compliance mode with automated lifecycle tiering for 7-year retention.")
}

Rel(RealTimeScoringContainer, ModelArtifactsStore, "Asynchronously downloads model artifacts via local caching sidecars", "")
Rel(AuditLoggingContainer, TamperEvidentAuditLogStore, "Writes tamper-evident audit logs via AWS VPC Gateway Endpoints with Object Lock enabled", "")

@enduml