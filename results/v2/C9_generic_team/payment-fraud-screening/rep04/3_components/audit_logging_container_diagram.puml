@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit Logging Container container

System_Ext(AWS_Kinesis_Data_Firehose, "AWS Kinesis Data Firehose", "Managed ingestion service buffering data to S3.")

Container_Boundary(Audit_Logging_Container, "Audit Logging Container") {
    Component(Validation_Proxy, "Validation Proxy", "Lightweight validation proxy using JSON Schema and SHA-256", "Validates incoming decision events and generates cryptographic checksums to ensure audit integrity.")
    Component(Embedded_Append_Only_Log, "Embedded Append-Only Log", "Local memory-mapped file buffering", "Provides local buffering during transient network partitions to preserve availability and prevent log loss.")
    Component(Firehose_Dispatcher, "Firehose Dispatcher", "AWS Kinesis Data Firehose Client", "Pushes validated and cryptographically hashed audit batches to AWS Kinesis Data Firehose.")
}

Rel(Validation_Proxy, Embedded_Append_Only_Log, "Buffers unwritten audit logs locally during network partitions")
Rel(Validation_Proxy, Firehose_Dispatcher, "Dispatches validated audit batches")
Rel(Firehose_Dispatcher, AWS_Kinesis_Data_Firehose, "Pushes cryptographically hashed audit batches via AWS API")
@enduml