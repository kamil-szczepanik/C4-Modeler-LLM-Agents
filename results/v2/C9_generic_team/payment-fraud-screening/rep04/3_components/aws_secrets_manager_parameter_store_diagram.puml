@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_secrets_manager_parameter_store, "AWS Secrets Manager / Parameter Store") {
    Component(Secrets_Retrieval_Engine, "Secrets Retrieval Engine", "AWS SDK / KMS", "Fetches and decrypts database credentials, API keys, and configuration parameters securely at runtime.")
    Component(Caching_and_Rotation_Controller, "Caching and Rotation Controller", "AWS Lambda / IAM", "Manages local in-memory caching of secrets and automates periodic credential rotation to enhance security.")
}

Rel(Secrets_Retrieval_Engine, Caching_and_Rotation_Controller, "Populates and updates cached secrets", "")

@enduml