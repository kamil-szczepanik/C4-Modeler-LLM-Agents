@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Boundary(aws_sqs_kinesis, "AWS SQS / Kinesis") {
    Component(AWS_SQS_FIFO, "AWS SQS FIFO", "AWS SQS FIFO with S3 payload referencing", "Guarantees strict ordering, exact-once processing, and bypasses 256 KB message limits for decision events.")
}

Rel(Real-Time Scoring Container, AWS_SQS_FIFO, "Asynchronously dispatches decision events using SendMessage")
Rel(AWS_SQS_FIFO, Audit Logging Container, "Delivers decision events using ReceiveMessage and DeleteMessage")
@enduml