@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(case_management_container, "Case Management Container") {
    Component(Case_Workflow_Controller, "Case Workflow Controller", "Finite State Machine & REST API", "Manages analyst case workflows, state transitions, and standardized error handling using RFC 7807.")
    Component(Case_Service_Layer, "Case Service Layer", "Service Layer Pattern", "Implements business logic for reviewing flagged transactions and processing fraud analyst decisions.")
    Component(Case_Repository, "Case Repository", "Repository Pattern & Optimistic Concurrency Control", "Handles data access operations and persists case states and transactional integrity.")
}

Rel(Case_Workflow_Controller, Case_Service_Layer, "Delegates workflow requests and business operations", "Invokes")
Rel(Case_Service_Layer, Case_Repository, "Persists and retrieves case states", "TCP/SQL")

@enduml