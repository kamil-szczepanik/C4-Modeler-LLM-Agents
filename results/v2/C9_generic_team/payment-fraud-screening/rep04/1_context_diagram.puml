@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalysts, "Fraud Analysts", "Review flagged transactions via the Case Management UI.")
System_Ext(PaymentGateway, "Payment Gateway", "Integrates via REST APIs to submit payment authorizations for screening.")
System(RealTimePaymentFraudScreeningPlatform, "Real-Time Payment Fraud Screening Platform", "A real-time payment fraud screening platform that evaluates 3,000 card-not-present authorizations per second with automated risk scoring, case management, and a secure 7-year tamper-evident audit trail.")

Rel(PaymentGateway, RealTimePaymentFraudScreeningPlatform, "Invokes authorization screening", "HTTPS/REST")
Rel(FraudAnalysts, RealTimePaymentFraudScreeningPlatform, "Accesses Case Management UI to review flagged transactions", "HTTPS")

@enduml