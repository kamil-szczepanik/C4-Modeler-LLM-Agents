@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Real-Time Payment Fraud Screening

Person(FraudAnalysts, "Fraud Analysts", "Review cases and manage fraud workflows using the case management interface.")
System_Ext(ExternalPaymentGateway, "External Payment Gateway", "Sends payment authorizations for fraud screening.")

System_Boundary(RealTimePaymentFraudScreening, "Real-Time Payment Fraud Screening") {
    Container(AWSAPIGateway, "AWS API Gateway", "AWS API Gateway", "Handles ingress validation, rate limiting, and circuit breaking.")
    Container(AWSECSonFargateScoringEngine, "AWS ECS on Fargate Scoring Engine", "AWS ECS on Fargate", "Stateless scoring engine that evaluates transactions in real-time.")
    ContainerDb(AmazonAuroraServerless, "Amazon Aurora Serverless", "Amazon Aurora Serverless", "Provides elastic relational case management storage.")
    Container(AmazonS3AuditStore, "Amazon S3 Audit Store", "Amazon S3 with Object Lock and Glacier Vault Lock", "Provides cost-effective, tamper-evident 7-year audit retention with Object Lock and Glacier.")
    Container(AWSSNSandPagerDuty, "AWS SNS and PagerDuty", "AWS SNS / PagerDuty", "Handles operational alerts.")
}

Rel(ExternalPaymentGateway, AWSAPIGateway, "Sends payment authorizations for fraud screening", "HTTPS/HTTP/2 using gRPC/JSON payloads")
Rel(AWSAPIGateway, AWSECSonFargateScoringEngine, "Forwards transactions for real-time scoring", "HTTPS")
Rel(AWSECSonFargateScoringEngine, AmazonAuroraServerless, "Reads and writes case management data", "TLS")
Rel(AWSECSonFargateScoringEngine, AmazonS3AuditStore, "Writes tamper-evident cryptographic audit logs", "AWS SDK / HTTPS")
Rel(AWSECSonFargateScoringEngine, AWSSNSandPagerDuty, "Sends operational alerts", "AWS SNS")
Rel(FraudAnalysts, AmazonAuroraServerless, "Accesses case management data via the interface", "HTTPS")

@enduml