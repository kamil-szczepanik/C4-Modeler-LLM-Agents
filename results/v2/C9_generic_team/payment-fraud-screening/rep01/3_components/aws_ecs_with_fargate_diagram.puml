@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Boundary(aws_ecs_with_fargate, "AWS ECS with Fargate") {
    Component(api_gateway_ingestion_service, "API Gateway / Ingestion Service", "Rust / Go / Java", "Handles incoming REST/OpenAPI authorization traffic.")
    Component(scoring_engine, "Scoring Engine", "Rust / Go / Java", "Evaluates transactions using embedded ML models and rules.")
    Component(case_management_admin_ui, "Case Management & Admin UI", "Web UI", "Web interface for fraud analysts to review flagged transactions.")
    Component(amazon_s3_with_object_lock, "Amazon S3 with Object Lock", "AWS S3", "Persists immutable decision inputs and model versions via AWS SDK.")
    Component(amazon_sqs, "Amazon SQS", "AWS SQS", "Provides message queuing for asynchronous processing.")
}

Rel(api_gateway_ingestion_service, scoring_engine, "Delegates transaction payloads via gRPC/Protobuf.", "gRPC/Protobuf")
Rel(scoring_engine, amazon_s3_with_object_lock, "Persists immutable decision inputs and model versions via AWS SDK.", "AWS SDK")
@enduml