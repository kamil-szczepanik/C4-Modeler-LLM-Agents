@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(scoring_engine, "Scoring Engine") {
    Component(ML_Runtime_Evaluator, "ML Runtime Evaluator", "Rust or Go, Embedded ML Runtimes, Memory-Mapped Files", "Evaluates fraud risk via embedded machine learning models using zero-downtime model weight hot-reloading.")
    Component(Telemetry_Circuit_Breaker_Manager, "Telemetry & Circuit Breaker Manager", "Prometheus", "Powers real-time telemetry, latency histograms, and circuit breaker health metrics.")
}

Rel(ML_Runtime_Evaluator, Telemetry_Circuit_Breaker_Manager, "Reports health and latency metrics", "Prometheus")

@enduml