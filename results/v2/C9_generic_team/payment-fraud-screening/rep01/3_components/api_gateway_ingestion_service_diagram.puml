@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("api_gateway_ingestion_service", "API Gateway / Ingestion Service") {
    Component(Edge_Router_Validator, "Edge Router & Validator", "Go, OpenAPI", "Performs strict, declarative schema validation on incoming payment authorization requests and handles edge routing.")
    Component(Ingestion_Handler, "Ingestion Handler", "Go, gRPC / Protobuf", "Processes authorized requests and forwards scoring payloads to the Scoring Engine with sub-50ms P99 latency.")
}

Rel(Edge_Router_Validator, Ingestion_Handler, "Forwards validated authorization requests", "Internal")

@enduml