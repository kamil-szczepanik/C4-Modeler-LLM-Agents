@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management & Admin UI container

Container_Boundary(case_management_admin_ui, "Case Management & Admin UI") {
    Component(Single_Page_Application__SPA__Frontend, "Single Page Application (SPA) Frontend", "React or Vue, Ant Design or MUI, AWS CloudFront, Amazon S3", "Provides the secure web user interface for fraud analysts to review suspicious payment authorizations, manage cases, and update fraud rules.")
    Component(Backend_For_Frontend__BFF__Container, "Backend-For-Frontend (BFF) Container", "AWS Fargate (ECS), AWS SDK", "Securely handles session management, API aggregation, and communicates with downstream services.")
    Component(AWS_Cognito, "AWS Cognito", "Managed Identity Provider (OIDC/HTTPS)", "Authenticates users and manages sessions for secure Role-Based Access Control (RBAC).")
    Component(Amazon_CloudWatch, "Amazon CloudWatch", "AWS SDK", "Emits structured logs and distributed traces for monitoring and auditability.")
}

Rel(Single_Page_Application__SPA__Frontend, Backend_For_Frontend__BFF__Container, "Communicates via API calls", "HTTPS/REST")
Rel(Backend_For_Frontend__BFF__Container, AWS_Cognito, "Authenticates users and manages sessions", "OIDC/HTTPS")
Rel(Backend_For_Frontend__BFF__Container, Downstream_Services, "Fetches and updates case data", "HTTPS/REST")
Rel(Single_Page_Application__SPA__Frontend, Amazon_CloudWatch, "Emits structured logs and distributed traces", "AWS SDK")
Rel(Backend_For_Frontend__BFF__Container, Amazon_CloudWatch, "Emits structured logs and distributed traces", "AWS SDK")
@enduml