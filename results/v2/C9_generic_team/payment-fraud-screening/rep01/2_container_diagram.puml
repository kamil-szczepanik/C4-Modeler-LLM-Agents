@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Real-Time Payment Fraud Screening

Person(FraudAnalysts, "Fraud Analysts", "System users who interact with the case management interface.")
System_Ext(ExternalPaymentGateway, "External Payment Gateway", "External system that sends card-not-present payment authorization requests.")

System_Boundary(RealTimePaymentFraudScreening, "Real-Time Payment Fraud Screening") {
    Container(APIGatewayIngestionService, "API Gateway / Ingestion Service", "Rust, Go, or Java with OpenAPI", "Ingests and screens payment authorizations securely.")
    Container(ScoringEngine, "Scoring Engine", "Rust, Go, or Java with embedded ML runtimes and Protobuf", "Processes scoring payloads and evaluates fraud risk in real-time.")
    Container(CaseManagementAdminUI, "Case Management & Admin UI", "Web UI", "Provides a case management interface for fraud analysts.")
    ContainerDb(AmazonS3withObjectLock, "Amazon S3 with Object Lock", "Amazon S3 with Object Lock", "Provides WORM storage for tamper-evident audit logs.")
    Container(AmazonSQS, "Amazon SQS", "Amazon SQS", "Handles asynchronous failure events as a dead-letter queue.")
    Container(AWSECSwithFargate, "AWS ECS with Fargate", "AWS ECS with Fargate", "Provides container orchestration to maintain low operational overhead.")
}

Rel(ExternalPaymentGateway, APIGatewayIngestionService, "Sends authorization requests", "HTTPS/REST")
Rel(APIGatewayIngestionService, ScoringEngine, "Forwards scoring payloads", "gRPC/Protobuf")
Rel(ScoringEngine, AmazonS3withObjectLock, "Writes tamper-evident audit logs", "AWS SDK")
Rel(FraudAnalysts, CaseManagementAdminUI, "Interacts with the interface", "HTTPS/REST")
Rel(ScoringEngine, AmazonSQS, "Delegates asynchronous failure events", "AWS SDK / Message Queue")

@enduml