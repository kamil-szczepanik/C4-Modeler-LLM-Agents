@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Audit_Compliance_Container", "Audit & Compliance Container") {
    Component("Audit_Consumer_Component", "Audit Consumer Component", "AWS ECS with Fargate / AWS SDK", "Consumes decision payloads and audit events asynchronously from Amazon SQS / SNS.")
    Component("Compliance_Logger_Component", "Compliance Logger Component", "AWS ECS with Fargate / AWS SDK", "Processes and formats audit records for tamper-evident compliance storage.")
}

Rel("Audit_Consumer_Component", "Compliance_Logger_Component", "Passes decision payloads for compliance logging")

@enduml