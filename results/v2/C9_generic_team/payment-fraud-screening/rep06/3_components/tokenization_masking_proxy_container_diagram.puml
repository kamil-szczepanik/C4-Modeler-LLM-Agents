@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(tokenization_masking_proxy_container, "Tokenization/Masking Proxy Container") {
    Component(Proxy Ingress Handler, "Proxy Ingress Handler", "AWS ECS with Fargate, TLS 1.3", "Receives incoming payment authorization requests and forwards them for PAN scrubbing.")
    Component(PAN Scrubber and Tokenizer, "PAN Scrubber and Tokenizer", "AWS ECS with Fargate", "Performs vault-backed tokenization and envelope encryption using AWS KMS, ensuring PCI-DSS compliance.")
    Component(Token Cache Client, "Token Cache Client", "Amazon ElastiCache (Redis)", "Minimizes latency via in-memory caching for recurring token lookups.")
    Component(Secrets and Config Injector, "Secrets and Config Injector", "AWS Secrets Manager", "Secures runtime configuration injection directly into task definitions.")
    Component(Tracing Agent, "Tracing Agent", "AWS X-Ray", "Provides distributed tracing across requests.")
}

Rel(Proxy Ingress Handler, PAN Scrubber and Tokenizer, "Forwards scrubbed transaction data", "")
Rel(PAN Scrubber and Tokenizer, Token Cache Client, "Performs token lookups and caching", "")
Rel(PAN Scrubber and Tokenizer, Secrets and Config Injector, "Injects secure runtime configuration", "")
Rel(Proxy Ingress Handler, Tracing Agent, "Reports distributed traces", "")
@enduml