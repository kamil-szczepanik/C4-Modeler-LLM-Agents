@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management Container container

Container_Boundary(case_management_container, "Case Management Container") {
    Component(Case_Review_Controller, "Case Review Controller", "OpenAPI, RESTful APIs, HTTPS/TLS 1.3", "Handles interaction with Fraud Analysts for review tasks and suspicious payment reviews, enforcing strict schema validation and RFC 7807 Problem Details.")
    Component(Case_Ingestion_Service, "Case Ingestion Service", "AWS SDK, SQS Protocol", "Ingests asynchronous case creation events from Amazon SQS.")
    Component(Case_Domain_Service, "Case Domain Service", "Hexagonal Architecture, Java / Python", "Core business logic implementing hexagonal architecture, managing case resolution, idempotency keys, and explicit domain event logging.")
    Component(Persistence_Adapter, "Persistence Adapter", "SQL, Logical CQRS, Optimistic Concurrency Control (OCC)", "Persists case and review data to Amazon Aurora via logical CQRS.")
    Component(Rule_Integration_Adapter, "Rule Integration Adapter", "Internal API", "Interfaces with the Model & Rule Registry Service Container to supply rules and models.")
    Component(Audit_Dispatcher_Adapter, "Audit Dispatcher Adapter", "Internal API", "Forwards domain event logs for state transitions to the Audit & Compliance Container.")
}

Rel(Case_Review_Controller, Case_Domain_Service, "Delegates review task operations")
Rel(Case_Ingestion_Service, Case_Domain_Service, "Triggers case creation events")
Rel(Case_Domain_Service, Persistence_Adapter, "Saves and retrieves case state via logical CQRS")
Rel(Case_Domain_Service, Rule_Integration_Adapter, "Fetches rules and models")
Rel(Case_Domain_Service, Audit_Dispatcher_Adapter, "Publishes domain event logs")

@enduml