@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component Diagram for Amazon ElastiCache (Redis)

Container_Ext(scoring_engine, "Real-Time Scoring Engine Container", "AWS ECS with Fargate", "Queries cached feature vectors")
System_Ext(aurora, "Amazon Aurora", "Primary Database", "Fallback data source on cache misses")

Container_Boundary(elasticache_boundary, "Amazon ElastiCache (Redis)") {
    Component(redis_store, "Redis In-Memory Data Store", "Amazon ElastiCache (Redis) Cluster (Multi-AZ)", "Provides high-performance, in-memory caching for feature vectors and rule states to achieve sub-50ms latency.")
    Component(security_manager, "Encryption & Security Manager", "AWS KMS", "Encrypts cached data at rest to ensure compliance with PCI-DSS.")
    Component(telemetry_agent, "Telemetry & Monitoring Agent", "Amazon CloudWatch / SNS", "Provides automated telemetry and alerting for the operations team.")
}

Rel(scoring_engine, redis_store, "Queries cached feature vectors", "Redis Protocol over TLS 1.3")
Rel(redis_store, aurora, "Acts as a fallback data source on cache misses")
Rel(redis_store, security_manager, "Uses for encrypting data at rest")

@enduml