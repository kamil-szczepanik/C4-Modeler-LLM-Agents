@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(real_time_scoring_engine_container, "Real-Time Scoring Engine Container", "AWS ECS with Fargate")
System_Ext(audit_compliance_container, "Audit & Compliance Container", "AWS ECS with Fargate")

Container_Boundary(amazon_sqs_sns, "Amazon SQS / SNS") {
    Component(sqs_fifo_queues, "SQS FIFO Queues", "Amazon SQS FIFO", "Decouples the asynchronous audit trail from the synchronous payment path using FIFO queues, DLQs, and KMS encryption.")
    Component(sns_topics, "SNS Topics", "Amazon SNS", "Publishes scoring decisions asynchronously using AWS SDK to downstream compliance consumers.")
}

Rel(real_time_scoring_engine_container, sqs_fifo_queues, "Publishes scoring decisions asynchronously using AWS SDK", "")
Rel(sqs_fifo_queues, audit_compliance_container, "Supplies decoupled audit messages via SQS Consumer", "")
@enduml