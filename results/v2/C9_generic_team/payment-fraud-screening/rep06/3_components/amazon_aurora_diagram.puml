@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Amazon Aurora", "Amazon Aurora") {
    Component("Case Management Data Store", "Case Management Data Store", "Amazon Aurora Serverless v2", "Relational database cluster storing case management and review data with read-write segregation.")
    Component("Aurora Read Replica", "Aurora Read Replica", "Amazon Aurora Read Replica", "Provides automated scaling and read-only query handling for the database cluster.")
}

Rel("Case Management Data Store", "Aurora Read Replica", "Replicates case data", "SQL")
@enduml