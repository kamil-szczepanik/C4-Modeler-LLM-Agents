@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("API Gateway / Payment Gateway Integration Container", "API Gateway / Payment Gateway Integration Container") {
    Component(Request_Router, "Request Router", "AWS ECS with Fargate", "Receives incoming authorization requests and routes them for processing.")
    Component(Proxy_Coordinator, "Proxy Coordinator", "AWS ECS with Fargate", "Coordinates PAN scrubbing and tokenization requests.")
    Component(Scoring_Invoker, "Scoring Invoker", "AWS ECS with Fargate", "Queries real-time fraud scores for transactions.")
}

Rel(Request_Router, Proxy_Coordinator, "Forwards requests for PAN scrubbing", "Internal API")
Rel(Request_Router, Scoring_Invoker, "Queries fraud scores", "gRPC/REST")
@enduml