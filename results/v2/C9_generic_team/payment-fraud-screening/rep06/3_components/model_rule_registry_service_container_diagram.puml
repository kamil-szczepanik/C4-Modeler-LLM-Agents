@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(model_and_rule_registry_service_container, "Model & Rule Registry Service Container") {
    Component(Model and Rule API Controller, "Model and Rule API Controller", "AWS ECS / Fargate, REST/gRPC", "Receives requests to register, update, and query fraud detection models and rules.")
    Component(Registry Orchestrator Service, "Registry Orchestrator Service", "Python / Node.js", "Manages the business logic for publishing immutable models and rules to downstream engines.")
    Component(Publisher Service, "Publisher Service", "Amazon SNS / SQS", "Broadcasts immutable models and rules asynchronously to the scoring and case management engines.")
}

Rel(Model and Rule API Controller, Registry Orchestrator Service, "Forwards registration and query requests")
Rel(Registry Orchestrator Service, Publisher Service, "Triggers broadcast of immutable models and rules")
@enduml