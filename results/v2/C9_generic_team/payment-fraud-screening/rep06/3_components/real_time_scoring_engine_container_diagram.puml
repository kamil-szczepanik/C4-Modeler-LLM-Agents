@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Real-Time Scoring Engine Container container

System_Ext(Tokenization_Masking_Proxy_Container, "Tokenization/Masking Proxy Container", "External system")
System_Ext(Amazon_ElastiCache_Redis, "Amazon ElastiCache (Redis)", "External system")
System_Ext(Amazon_SQS_SNS, "Amazon SQS / SNS", "External system")
System_Ext(Model_Rule_Registry_Service_Container, "Model & Rule Registry Service Container", "External system")

Container_Boundary(Real_Time_Scoring_Engine_Container, "Real-Time Scoring Engine Container") {
    Component(Transaction_Evaluation_Engine, "Transaction Evaluation Engine", "Rust / Go", "Evaluates transactions concurrently against scoring models and rules to screen payment authorizations for fraud within strict latency SLAs.")
    Component(Cache_Query_Component, "Cache Query Component", "Redis Protocol", "Queries local in-memory cache for fast transaction evaluation.")
    Component(Decision_Publisher, "Decision Publisher", "AWS SDK", "Publishes scoring decisions asynchronously.")
}

Rel(Tokenization_Masking_Proxy_Container, Transaction_Evaluation_Engine, "Forwards scrubbed transaction data", "gRPC / Protocol Buffers")
Rel(Transaction_Evaluation_Engine, Amazon_ElastiCache_Redis, "Queries local cache for fast transaction evaluation", "Redis Protocol")
Rel(Transaction_Evaluation_Engine, Amazon_SQS_SNS, "Publishes scoring decisions asynchronously", "AWS SDK")
Rel(Model_Rule_Registry_Service_Container, Transaction_Evaluation_Engine, "Supplies immutable scoring models and rules", "gRPC")

@enduml