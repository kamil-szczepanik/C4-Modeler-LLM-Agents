@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Amazon S3 Object Lock", "Amazon S3 Object Lock") {
    Component("WORM Storage Engine", "WORM Storage Engine", "Amazon S3 Object Lock (Compliance Mode)", "Provides immutable, Write-Once-Read-Many (WORM) storage for tamper-evident audit logs enforcing a 7-year retention mandate.")
    Component("Lifecycle and Archival Manager", "Lifecycle and Archival Manager", "Amazon S3 Glacier Lifecycle Policies", "Automatically transitions audit logs to Glacier Flexible Archive to meet the monthly budget constraint.")
}

Rel("Audit & Compliance Container", "WORM Storage Engine", "Writes tamper-evident audit logs with client-side SHA-256 hashes and schema versions", "AWS SDK")
Rel("WORM Storage Engine", "Lifecycle and Archival Manager", "Transitions older log data for long-term retention", "")

@enduml