@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon SQS Message Bus container

System_Ext(Modular_Monolith_Core_Scoring_Engine, "Modular Monolith Core Scoring Engine", "Core scoring engine container")
System_Ext(Case_Management_Service, "Case Management Service", "Case management service container")

Container_Boundary(Amazon_SQS_Message_Bus, "Amazon SQS Message Bus") {
    Component(Review_Case_Queue, "Review Case Queue", "Amazon SQS", "Provides transient decoupling, load-leveling, and asynchronous routing of review cases using SQS Long Polling and the S3 Claims Check pattern.")
}

Rel(Modular_Monolith_Core_Scoring_Engine, Review_Case_Queue, "Asynchronously routes review cases using Amazon SQS API", "Amazon SQS API")
Rel(Review_Case_Queue, Case_Management_Service, "Triggers asynchronous case processing via SQS Long Polling", "SQS Long Polling")

@enduml