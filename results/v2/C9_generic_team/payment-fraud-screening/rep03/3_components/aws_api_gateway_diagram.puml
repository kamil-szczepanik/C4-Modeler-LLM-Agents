@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS API Gateway container

Container_Boundary(aws_api_gateway, "AWS API Gateway") {
    Component(External_Ingress_Manager, "External Ingress Manager", "AWS API Gateway", "Manages external ingress, rate-limiting, and payload size restriction to protect downstream services within budget.")
}

System_Ext(Payment_Gateway, "Payment Gateway", "Sends payment authorization requests")
Container(Tokenization_Proxy_Container, "Tokenization Proxy Container", "Container", "Proxies and tokenizes payment data")

Rel(Payment_Gateway, External_Ingress_Manager, "Sends payment authorization requests", "HTTPS/TLS 1.3")
Rel(External_Ingress_Manager, Tokenization_Proxy_Container, "Forwards payment data", "gRPC/Protobuf")

@enduml