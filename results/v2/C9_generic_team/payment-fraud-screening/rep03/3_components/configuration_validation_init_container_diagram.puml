@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(config_validation_init_container, "Configuration Validation Init Container") {
    Component(Configuration_Parser, "Configuration Parser", "Python / Pydantic", "Parses and loads configuration files from the shared volume on startup.")
    Component(Schema_Validator, "Schema Validator", "JSON Schema / Pydantic", "Validates read-only mounted configurations against shared schemas to ensure structural and semantic correctness.")
    Component(Volume_Release_Controller, "Volume Release Controller", "Container Init Script", "Releases the shared volume marker to the Modular Monolith Core Scoring Engine upon successful validation.")
}

Rel(Configuration_Parser, Schema_Validator, "Passes raw configuration data for validation.")
Rel(Schema_Validator, Volume_Release_Controller, "Signals successful validation to release the shared volume marker.")
@enduml