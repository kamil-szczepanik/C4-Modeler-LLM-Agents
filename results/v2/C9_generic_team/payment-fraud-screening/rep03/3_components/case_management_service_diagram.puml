@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("case_management_service", "Case Management Service") {
    Component("Case Review Controller", "Case Review Controller", "AWS ECS Fargate / Modular Monolith", "Handles secure HTTPS/TLS 1.3 requests from Fraud Analysts reviewing suspicious payments and managing fraud cases.")
    Component("Async Event Consumer", "Async Event Consumer", "Amazon SQS SDK", "Consumes case review triggers and asynchronous events from the Amazon SQS Message Bus via polling.")
    Component("Projection Repository", "Projection Repository", "PostgreSQL Client / AWS RDS Aurora Serverless v2", "Queries and updates read-optimized case projections using the PostgreSQL protocol over TCP.")
    Component("Event Sourcing Appender", "Event Sourcing Appender", "AWS SDK / HTTPS", "Appends immutable domain events and event snapshots to AWS S3 Object Lock for 7-year tamper-evident auditability.")
    Component("Telemetry Collector", "Telemetry Collector", "AWS Distro for OpenTelemetry Sidecar", "Delivers automated synthetic health checks, metrics, and tracing for the Case Management Service.")
}

Rel("Case Review Controller", "Projection Repository", "Queries and updates read-optimized case projections", "PostgreSQL Protocol / TCP")
Rel("Async Event Consumer", "Event Sourcing Appender", "Triggers immutable event persistence upon processing async events", "Internal")
Rel("Event Sourcing Appender", "Projection Repository", "Synchronizes event state with read projections", "Internal")
Rel("Telemetry Collector", "Case Review Controller", "Monitors and traces runtime operations", "OpenTelemetry")

@enduml