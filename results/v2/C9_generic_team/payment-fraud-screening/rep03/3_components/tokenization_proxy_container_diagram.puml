@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Tokenization Proxy Container container

System_Ext(Modular_Monolith_Core_Scoring_Engine, "Modular Monolith Core Scoring Engine", "AWS ECS Fargate", "Receives tokenized payment data over the Internal VPC Network.")

Container_Boundary(Tokenization_Proxy_Container, "Tokenization Proxy Container") {
    Component(gRPC_Ingress_Receiver, "gRPC Ingress Receiver", "gRPC / Protobuf", "Receives forwarded payment data requests from the AWS API Gateway.")
    Component(Tokenization_Engine, "Tokenization Engine", "Containerized Microservice", "Tokenizes sensitive payment information to ensure PCI-DSS Level 1 compliance.")
    Component(Internal_VPC_Forwarder, "Internal VPC Forwarder", "TCP / Internal Network", "Sends tokenized payment data over the Internal VPC Network to the Modular Monolith Core Scoring Engine.")
}

Rel(gRPC_Ingress_Receiver, Tokenization_Engine, "Passes raw payment data for tokenization")
Rel(Tokenization_Engine, Internal_VPC_Forwarder, "Forwards tokenized data")
Rel(Internal_VPC_Forwarder, Modular_Monolith_Core_Scoring_Engine, "Sends tokenized payment data over Internal VPC Network")

@enduml