@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the OpenTelemetry Sidecar Container container

System_Ext(Monitoring_Backend, "Monitoring Backend", "External monitoring and observability backend.")
System_Ext(Modular_Monolith_Core_Scoring_Engine, "Modular Monolith Core Scoring Engine", "AWS ECS Fargate application core.")
System_Ext(AWS_SSM_Parameter_Store, "AWS SSM Parameter Store", "Centralized configuration management store.")

Container_Boundary(OpenTelemetry_Sidecar_Container, "OpenTelemetry Sidecar Container") {
    Component(OpenTelemetry_Collector, "OpenTelemetry Collector", "AWS Distro for OpenTelemetry (ADOT)", "Lightweight, stateless telemetry collection engine that gathers, processes, and exports metrics and traces.")
}

Rel(OpenTelemetry_Collector, Monitoring_Backend, "Exports telemetry and metrics", "OTLP over gRPC/HTTP with Gzip compression")
Rel(Modular_Monolith_Core_Scoring_Engine, OpenTelemetry_Collector, "Sends telemetry and queries queue health", "HTTP/gRPC over localhost")
Rel(OpenTelemetry_Collector, AWS_SSM_Parameter_Store, "Retrieves centralized collector configurations", "AWS API")

@enduml