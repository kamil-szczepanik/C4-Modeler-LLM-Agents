@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_s3_glacier, "AWS S3 Glacier") {
    Component(Lifecycle_Policy_Manager, "Lifecycle Policy Manager", "AWS S3 Lifecycle Configuration", "Transitions older audit payloads from S3 Object Lock into S3 Glacier storage tiers.")
    Component(Restore_Job_Handler, "Restore Job Handler", "AWS S3 Asynchronous Restore API", "Retrieves archived audit payloads via asynchronous restore jobs when requested by the Case Management Service.")
}

Rel(Lifecycle_Policy_Manager, Restore_Job_Handler, "Transitions and manages data lifecycle states", "")

@enduml