@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_s3_object_lock, "AWS S3 Object Lock") {
    Component(Object_Lock_Manager, "Object Lock Manager", "AWS S3 Native Service", "Enforces immutable, tamper-evident 7-year audit retention for PCI-DSS compliance.")
    Component(Lifecycle_Transition_Engine, "Lifecycle Transition Engine", "S3 Lifecycle Policies", "Transitions older audit logs to AWS S3 Glacier to reduce storage costs.")
}

Rel(Object_Lock_Manager, Lifecycle_Transition_Engine, "Triggers automated lifecycle movement", "S3 Lifecycle")

@enduml