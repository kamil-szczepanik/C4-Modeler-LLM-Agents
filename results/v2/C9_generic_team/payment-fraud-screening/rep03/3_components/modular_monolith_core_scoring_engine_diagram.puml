@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Modular Monolith Core Scoring Engine container

Container_Boundary(core_scoring_engine, "Modular Monolith Core Scoring Engine") {
    Component(fail_fast_validation_pipeline, "Fail-Fast Validation Pipeline", "Java", "Performs immediate validation checks on incoming payment data to quickly reject malformed requests.")
    Component(rule_evaluation_module, "Rule-Evaluation Module", "Java, Strategy Pattern, Atomic References", "Evaluates transactions against fraud rules with zero-downtime hot-swapping capability in memory.")
    Component(ml_scoring_module, "ML-Scoring Module", "Java, Atomic References", "Scores transactions using machine learning models with zero-downtime hot-swapping capability in memory.")
}

Rel(fail_fast_validation_pipeline, rule_evaluation_module, "Passes validated payment data for rule evaluation")
Rel(rule_evaluation_module, ml_scoring_module, "Passes data for ML-based fraud scoring")
@enduml