@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Fraud Analysts, "Fraud Analysts", "Internal users performing case reviews.")
System_Ext(Payment Gateway, "Payment Gateway", "External source of authorization requests.")
System_Ext(ML Training Environment, "ML Training Environment", "External system for model updates.")
System(Real-Time Fraud Detection System, "Real-Time Fraud Detection System", "Screens card-not-present payment authorizations for fraud in real-time and provides case management for fraud analysts.")

Rel(Payment Gateway, Real-Time Fraud Detection System, "Sends payment authorization requests for fraud screening", "HTTPS/TLS 1.3")
Rel(Fraud Analysts, Real-Time Fraud Detection System, "Performs case reviews and manages fraud cases", "HTTPS/TLS 1.3")

@enduml