@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Card-Not-Present Payment Fraud Screening Platform

System_Ext(Payment_Gateway_Acquirer, "Payment Gateway / Acquirer", "External entity submitting authorization requests.")

System_Boundary(fraud_platform, "Card-Not-Present Payment Fraud Screening Platform") {
    Container(Fallback_Proxy_Container, "Fallback Proxy Container", "Container Proxy", "Manages circuit breaking and fail-open policies.")
    Container(Scoring_Engine_Container, "Scoring Engine Container", "AWS ECS on Fargate, Protocol Buffers", "Stateless AWS ECS on Fargate service for real-time fraud evaluation.")
    Container(Case_Management_Admin_Container, "Case Management & Admin Container", "AWS ECS on Fargate", "Handles analyst workflows and rule updates.")
    ContainerDb(Amazon_S3, "Amazon S3", "AWS S3 with Object Lock", "Object storage with Object Lock for immutable audit logs and versioned model bundles.")
    ContainerDb(Amazon_Aurora_Serverless, "Amazon Aurora Serverless", "Amazon Aurora Serverless, TLS", "Persistence layer for case data and audit trails.")
    Container(AWS_Systems_Manager_Parameter_Store, "AWS Systems Manager Parameter Store", "AWS Systems Manager", "Centralized configuration and secrets management.")
}

Rel(Payment_Gateway_Acquirer, Fallback_Proxy_Container, "Submits authorization requests", "HTTPS/REST")
Rel(Fallback_Proxy_Container, Scoring_Engine_Container, "Invokes fraud evaluation", "gRPC / HTTP")
Rel(Scoring_Engine_Container, Amazon_S3, "Loads model bundles and writes tamper-evident audit records", "HTTPS / TLS")
Rel(Scoring_Engine_Container, AWS_Systems_Manager_Parameter_Store, "Reads configuration", "AWS API")
Rel(Case_Management_Admin_Container, AWS_Systems_Manager_Parameter_Store, "Reads configuration", "AWS API")
Rel(Case_Management_Admin_Container, Amazon_Aurora_Serverless, "Reads and writes audit data and cases", "TLS")

@enduml