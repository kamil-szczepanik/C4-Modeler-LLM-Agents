@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container(scoring_engine, "Scoring Engine Container", "AWS ECS on Fargate, Protocol Buffers", "Evaluates card-not-present payment authorizations.")

Container_Boundary(amazon_s3, "Amazon S3") {
    Component(Model_Bundle_Storage, "Model Bundle Storage", "AWS S3 Bucket with VPC Gateway Endpoints", "Stores machine learning model bundles loaded by the Scoring Engine Container.")
    Component(Audit_Record_Store, "Audit Record Store", "AWS S3 with Object Lock and SSE-KMS", "Provides tamper-evident WORM storage for immutable 7-year audit records.")
}

Rel(scoring_engine, Model_Bundle_Storage, "Loads model bundles", "HTTPS / TLS")
Rel(scoring_engine, Audit_Record_Store, "Writes tamper-evident audit records", "HTTPS / TLS")

@enduml