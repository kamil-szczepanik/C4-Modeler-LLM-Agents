@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Fallback Proxy Container container

Container_Boundary("Fallback Proxy Container", "Fallback Proxy Container") {
    Component("Ingress Handler", "Ingress Handler", "Envoy", "Manages ingress and HTTPS/REST requests from Cardholder / Merchant.")
    Component("Circuit Breaker & Fail-Open Policy Manager", "Circuit Breaker & Fail-Open Policy Manager", "Envoy", "Ensures resilience and handles fallback behaviors during downstream failures.")
    Component("Local Blocklist Heuristics", "Local Blocklist Heuristics", "Envoy Lua / ExtAuthz", "Evaluates local blocklist rules at the edge for rapid threat mitigation.")
    Component("Data Masking Engine", "Data Masking Engine", "Envoy", "Masks sensitive payload data before logging or forwarding.")
}

Rel("Ingress Handler", "Circuit Breaker & Fail-Open Policy Manager", "Routes requests through", "")
Rel("Circuit Breaker & Fail-Open Policy Manager", "Local Blocklist Heuristics", "Checks rules via", "")
Rel("Local Blocklist Heuristics", "Data Masking Engine", "Sends sanitized data to", "")

@enduml