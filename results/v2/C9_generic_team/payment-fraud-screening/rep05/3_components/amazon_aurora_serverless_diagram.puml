@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_aurora_serverless, "Amazon Aurora Serverless") {
    Component(Relational Database Engine, "Relational Database Engine", "Amazon Aurora Serverless v2", "Provides relational storage for case management with strictly bounded ACUs to respect budget constraints.")
    Component(Change Data Capture (CDC) Publisher, "Change Data Capture (CDC) Publisher", "AWS Database Migration Service", "Streams change data capture audit logs asynchronously from the database.")
}

Rel(Relational Database Engine, Change Data Capture (CDC) Publisher, "Streams change data capture audit logs asynchronously", "TLS/HTTPS")

@enduml