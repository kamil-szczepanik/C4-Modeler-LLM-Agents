@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS Systems Manager Parameter Store container

Container_Boundary(aws_systems_manager_parameter_store, "AWS Systems Manager Parameter Store") {
    Component(Configuration_and_Secrets_Manager, "Configuration and Secrets Manager", "AWS Systems Manager / AWS KMS", "Centralizes runtime configuration and secrets management using SecureString parameters.")
}

System_Ext(Scoring_Engine_Container, "Scoring Engine Container", "AWS ECS on Fargate")
System_Ext(Case_Management_and_Admin_Container, "Case Management & Admin Container", "AWS ECS on Fargate")

Rel(Configuration_and_Secrets_Manager, Scoring_Engine_Container, "Provides runtime configuration and secrets", "AWS API")
Rel(Configuration_and_Secrets_Manager, Case_Management_and_Admin_Container, "Provides and receives configuration and secrets updates", "AWS API")

@enduml