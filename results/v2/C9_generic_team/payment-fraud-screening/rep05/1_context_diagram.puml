@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Card-Not-Present Fraud Screening System

Person(FraudAnalysts, "Fraud Analysts", "Fraud analysts who access the case management system to review suspicious payments.")
Person(CardholderMerchant, "Cardholder / Merchant", "End users and merchants initiating card-not-present transactions.")

System_Ext(PaymentGatewayAcquirer, "Payment Gateway / Acquirer", "External payment gateway or acquirer invoking fraud screening for authorizations.")
System_Ext(FallbackProxy, "Fallback Proxy", "Proxy ensuring fail-open resilience during system outages.")

System_Boundary(CardNotPresentFraudScreeningSystem, "Card-Not-Present Fraud Screening System") {
    Container(FraudScreeningEngine, "Fraud Screening Engine", "AWS Fargate / Lambda", "Stateless scoring engine providing real-time fraud checks.")
    Container(CaseManagementSystem, "Case Management System", "Web App / HTTPS", "System for fraud analysts to manage suspicious payment cases.")
    Container(ContentAddressableModelRegistry, "Content-Addressable Model Registry", "Amazon S3", "Registry storing immutable model weights for zero-downtime updates.")
    ContainerDb(AuditTrailStore, "Audit Trail Store", "Amazon DynamoDB & S3 Glacier Vault Lock", "Tiered tamper-evident audit storage ensuring 7-year compliance.")
}

Rel(PaymentGatewayAcquirer, FraudScreeningEngine, "Invokes fraud screening for payment authorizations with strict timeout", "HTTPS REST API")
Rel(FraudAnalysts, CaseManagementSystem, "Accesses case management system to investigate suspicious payments", "HTTPS")
Rel(FraudScreeningEngine, ContentAddressableModelRegistry, "Retrieves model weights", "Internal AWS Network")
Rel(FraudScreeningEngine, AuditTrailStore, "Writes tamper-evident audit logs", "AWS SDK / Internal Network")

@enduml