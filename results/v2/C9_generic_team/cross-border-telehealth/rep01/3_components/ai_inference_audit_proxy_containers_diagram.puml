@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Inference & Audit Proxy Containers container

Container_Boundary(ai_inference_audit_proxy_containers, "AI Inference & Audit Proxy Containers") {
    Component(grpc_request_router, "gRPC Request Router", "Python / gRPC", "Routes incoming gRPC and REST requests from the API Gateway to internal handlers.")
    Component(ai_symptom_checker_client, "AI Symptom Checker Client", "Python / gRPC / Protocol Buffers", "Communicates with the AI Symptom Checker Service using strict schema validation.")
    Component(audit_logging_buffer, "Audit Logging Buffer", "Python / Local Queue", "Asynchronously flushes local audit logs to the Regional Audit and Compliance Logging Subsystem.")
}

Rel(grpc_request_router, ai_symptom_checker_client, "Invokes symptom analysis", "gRPC / REST")
Rel(grpc_request_router, audit_logging_buffer, "Queues audit events", "Asynchronous / Local Queue Flush")

@enduml