@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Configuration and Secrets Management Sidecars container

Container_Boundary(config_sidecars, "Configuration and Secrets Management Sidecars") {
    Component(gcp_secret_manager_client, "GCP Secret Manager Client", "gRPC/HTTPS Client", "Communicates with GCP Secret Manager to securely retrieve configuration and secrets.")
    Component(unix_domain_socket_publisher, "Unix Domain Socket Publisher", "Local Loopback Unix Domain Socket", "Delivers configuration securely to Core Application Containers without plain-text environment variables.")
    Component(kms_encryption_manager, "KMS Encryption Manager", "GCP Cloud KMS API", "Interfaces with GCP Cloud KMS for ciphertext encryption and decryption of locally cached files.")
    Component(telemetry_exporter, "Telemetry Exporter", "Prometheus / OpenTelemetry", "Emits sync status, cache rates, and decryption health metrics to Observability Exporter Sidecars.")
}

System_Ext(stateless_core_app, "Stateless Core Application Containers", "Core application containers receiving secure local configuration.")
System_Ext(observability_sidecars, "Observability & Telemetry Exporter Sidecars", "Sidecars responsible for exporting Prometheus metrics and tracking sync status.")

Rel(gcp_secret_manager_client, unix_domain_socket_publisher, "Forwards retrieved configuration", "")
Rel(gcp_secret_manager_client, kms_encryption_manager, "Requests decryption of cached secrets", "")
Rel(unix_domain_socket_publisher, stateless_core_app, "Transmits configurations securely", "Local Unix Domain Socket")
Rel(telemetry_exporter, observability_sidecars, "Emits Prometheus metrics for sync status tracking", "Prometheus / OpenTelemetry")

@enduml