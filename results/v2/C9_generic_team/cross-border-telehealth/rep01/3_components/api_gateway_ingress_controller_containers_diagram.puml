@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_boundary, "API Gateway / Ingress Controller Containers") {
    Component(Ingress_Router_TLS_Termination, "Ingress Router & TLS Termination", "Google Cloud Platform Ingress / Envoy", "Manages ingress routing, mTLS connections from global traffic, and TLS termination.")
    Component(Rate_Limiting_Schema_Validation_Middleware, "Rate Limiting & Schema Validation Middleware", "Envoy Proxy", "Enforces token-bucket rate limiting and validates incoming request schemas, standardizing error responses using RFC 7807.")
}

Rel(Ingress_Router_TLS_Termination, Rate_Limiting_Schema_Validation_Middleware, "Routes validated ingress requests to", "")

@enduml