@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Consent Enforcement Middleware/Proxy Containers container

Container_Boundary(consent_middleware, "Consent Enforcement Middleware/Proxy Containers") {
    Component(EnvoyIngressRouter, "Envoy Ingress Router", "Envoy Proxy", "Handles incoming ingress traffic routing and inspects W3C Trace Context headers (traceparent).")
    Component(ExtAuthzFilter, "ExtAuthz Filter", "Envoy ExtAuthz Filter", "Enforces strict default-deny privacy controls and intercepts requests to validate JWT tokens and enforce consent.")
    Component(MetadataEnrichmentAgent, "Metadata Enrichment Agent", "Custom Middleware", "Enriches requests with metadata headers like X-Consent-Purpose and X-Data-Residency-Region before forwarding.")
}

Rel(EnvoyIngressRouter, ExtAuthzFilter, "Routes incoming client requests for authorization", "HTTPS / gRPC")
Rel(ExtAuthzFilter, MetadataEnrichmentAgent, "Passes validated and authorized requests for header enrichment", "")
@enduml