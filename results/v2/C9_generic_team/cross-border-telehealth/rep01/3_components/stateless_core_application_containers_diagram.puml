@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(stateless_core, "Stateless Core Application Containers") {
    Component(patient_and_clinician_interface_controller, "Patient and Clinician Interface Controller", "Containerized Microservices on GCP / REST", "Handles incoming requests from patients and clinicians for secure video consultations and e-prescriptions.")
    Component(consultation_and_prescription_service, "Consultation and Prescription Service", "Containerized Microservices on GCP / gRPC", "Core business logic service managing video consultation orchestration and e-prescription workflows.")
    Component(ai_symptom_checker_orchestrator, "AI Symptom Checker Orchestrator", "Containerized Microservices on GCP / Python / gRPC", "Coordinates symptom checking logic and interfaces with the AI inference proxy.")
}

Rel(patient_and_clinician_interface_controller, consultation_and_prescription_service, "Routes consultation and prescription requests", "REST / gRPC")
Rel(consultation_and_prescription_service, ai_symptom_checker_orchestrator, "Delegates symptom analysis requests", "gRPC")

@enduml