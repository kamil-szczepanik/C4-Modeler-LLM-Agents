@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Observability & Telemetry Exporter Sidecars with PII/PHI Stripping container

Container_Boundary(observability_container, "Observability & Telemetry Exporter Sidecars with PII/PHI Stripping") {
    Component(Telemetry_Collector_Agent, "Telemetry Collector Agent", "OpenTelemetry (OTel) Collector framework", "Collects logs, traces, and metrics from application and proxy containers.")
    Component(PII_PHI_Stripping_Filter, "PII/PHI Stripping Filter", "Custom Exporter / Sanitization Module", "Inspects telemetry payloads to strip personally identifiable information (PII) and protected health information (PHI).")
    Component(Local_File_Buffer, "Local File Buffer", "Local Storage / File Buffer", "Temporarily buffers sanitized telemetry data locally during unstable network conditions.")
}

System_Ext(regional_backends, "Regional OpenTelemetry backends in europe-west3 and us-central1", "Receives sanitized telemetry data")

Rel(Telemetry_Collector_Agent, PII_PHI_Stripping_Filter, "Passes raw telemetry for sanitization")
Rel(PII_PHI_Stripping_Filter, Local_File_Buffer, "Buffers sanitized telemetry locally")
Rel(Local_File_Buffer, regional_backends, "Exports sanitized logs and metrics")

@enduml