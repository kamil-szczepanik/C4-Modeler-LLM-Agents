@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the FHIR Translation Adapter Container (US) and National E-Prescription Adapter Container (EU) container

System_Ext(external_gateways, "National E-Prescription Gateways and Pharmacy Networks", "External national e-prescription gateways and pharmacy networks.")

Container_Boundary(adapter_container, "FHIR Translation Adapter Container (US) and National E-Prescription Adapter Container (EU)") {
    Component(us_fhir_module, "US FHIR Translation Module", "Python / gRPC & REST, HL7 FHIR", "Handles data translation and interoperability for US patients using HL7 FHIR standards.")
    Component(eu_eprescription_module, "EU National E-Prescription Module", "Python / gRPC & REST, National APIs", "Handles e-prescription integration and interoperability for EU patients using National APIs.")
}

Rel(us_fhir_module, external_gateways, "Sends translated FHIR data", "REST / HL7 FHIR")
Rel(eu_eprescription_module, external_gateways, "Transmits e-prescriptions", "National APIs")

@enduml