@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Video Streaming Gateway Containers with Local Storage/Caching Agents container

Container_Boundary(video_streaming_gateway, "Video Streaming Gateway Containers with Local Storage/Caching Agents") {
    Component(WebRTC_Streaming_Router, "WebRTC Streaming Router", "WebRTC & TURN/STUN", "Manages real-time video consultation streams and handles unstable network conditions down to 300 kbit/s.")
    Component(Store_and_Forward_Cache_Agent, "Store-and-Forward Cache Agent", "GCP Persistent Disk Encryption", "Temporarily caches encrypted video and consultation chunks locally to ensure resilience during connection drops.")
}

Rel(WebRTC_Streaming_Router, Store_and_Forward_Cache_Agent, "Flushes encrypted chunks for resilient store-and-forward persistence", "HTTPS / GCP Persistent Disk")

@enduml