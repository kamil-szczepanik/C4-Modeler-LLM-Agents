@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_and_Clinicians, "Patients and Clinicians", "Client applications users who participate in video consultations, use the AI symptom checker, and manage e-prescriptions.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides secure video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and US while enforcing strict regional data isolation to comply with GDPR and HIPAA mandates.")

System_Ext(Global_Traffic_Director_API_Gateway, "Global Traffic Director / API Gateway", "Routes global client traffic to the appropriate regional stack.")
System_Ext(AI_Symptom_Checker_Service, "AI Symptom Checker Service", "Provides automated symptom checking capabilities for patients.")
System_Ext(Regional_Audit_and_Compliance_Logging_Subsystem, "Regional Audit and Compliance Logging Subsystem", "Handles regional audit and compliance logging to meet GDPR and HIPAA requirements.")
System_Ext(External_Identity_and_Consent_Provider, "External Identity and Consent Provider", "Manages user identity and consent verification.")
System_Ext(National_E_Prescription_Gateways_and_Pharmacy_Networks, "National E-Prescription Gateways and Pharmacy Networks", "External networks for processing e-prescriptions via national and HL7 FHIR standards.")
System_Ext(External_Notification_and_Messaging_Service, "External Notification and Messaging Service", "Sends external notifications and messages to users.")
System_Ext(External_Payment_Gateways_and_Billing_Systems, "External Payment Gateways and Billing Systems", "Processes financial transactions and billing.")

Rel(Patients_and_Clinicians, Global_Traffic_Director_API_Gateway, "Interact with the Global Traffic Director", "HTTPS and WebSockets")
Rel(Global_Traffic_Director_API_Gateway, Cross_Border_Telehealth_Platform, "Routes regional traffic to regional stacks", "mTLS")
Rel(Cross_Border_Telehealth_Platform, National_E_Prescription_Gateways_and_Pharmacy_Networks, "Communicate with prescription gateways", "HL7 FHIR (US) and national standards (EU)")
Rel(Cross_Border_Telehealth_Platform, External_Identity_and_Consent_Provider, "Integrate for identity and consent", "OpenID Connect (OIDC)")
Rel(Cross_Border_Telehealth_Platform, External_Payment_Gateways_and_Billing_Systems, "Process payments and billing", "REST APIs over HTTPS")

@enduml