@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "Patients in the EU and US seeking video consultations, e-prescriptions, and symptom checks.")
Person(Licensed Clinicians, "Licensed Clinicians", "Licensed medical professionals providing video consultations and issuing prescriptions.")

System(Cross-Border Telehealth Platform, "Cross-Border Telehealth Platform", "A cross-border telehealth platform providing video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and the US, ensuring GDPR and HIPAA compliance.")

System_Ext(Regional Pharmacies, "Regional Pharmacies", "Pharmacies receiving e-prescriptions across EU and US regions.")
System_Ext(National Standards APIs, "National Standards APIs", "External national APIs for e-prescription and healthcare standards compliance.")
System_Ext(AI Symptom Checker, "AI Symptom Checker", "AI-powered symptom checker with immutable audit logging and asynchronous gRPC integration.")

Rel(Patients, Cross-Border Telehealth Platform, "Interact with regional telehealth platforms for video consultations and symptom checking", "HTTPS, WebRTC")
Rel(Licensed Clinicians, Cross-Border Telehealth Platform, "Conduct video consultations and manage patient care", "HTTPS, WebRTC")
Rel(Cross-Border Telehealth Platform, Regional Pharmacies, "Send e-prescriptions via Anti-Corruption Layer", "HL7 FHIR, National E-Prescription Standards")
Rel(Cross-Border Telehealth Platform, National Standards APIs, "Integrate with national standards for interoperability", "OpenAPI, AsyncAPI")
Rel(Cross-Border Telehealth Platform, AI Symptom Checker, "Integrate core platform with AI service, logging inputs and model versions", "gRPC")

@enduml