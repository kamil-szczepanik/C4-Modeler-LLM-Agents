@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "Patients in the EU and US seeking video consultations, e-prescriptions, and symptom checks.")
Person(LicensedClinicians, "Licensed Clinicians", "Licensed medical professionals providing video consultations and issuing prescriptions.")

System_Ext(RegionalPharmacies, "Regional Pharmacies", "Pharmacies receiving e-prescriptions across EU and US regions.")
System_Ext(NationalStandards_APIs, "National Standards APIs", "External national APIs for e-prescription and healthcare standards compliance.")
System_Ext(AISymptomChecker, "AI Symptom Checker", "AI-powered symptom checker with immutable audit logging and asynchronous gRPC integration.")

System_Boundary(CrossBorderTelehealthPlatform, "Cross-Border Telehealth Platform") {
    Container(APIGateway, "API Gateway", "Google Cloud Platform, HTTPS/WSS", "Provides client routing, authentication, and TLS termination for incoming requests.")
    Container(MediaGatewayEdgeProxy, "Media Gateway / Edge Proxy", "WebRTC, Dedicated Edge Proxy", "Manages WebRTC video consultations with adaptive bitrate handling for unstable connections.")
    Container(AISymptomCheckerContainer, "AI Symptom Checker Container", "gRPC", "Integrates and processes symptom checking logic for patients.")
    Container(EPrescriptionService, "E-Prescription Service", "Managed Regional Databases (Cloud SQL / Spanner)", "Handles e-prescription generation and management workflows.")
    Container(InteroperabilityAdapter, "Interoperability Adapter", "HL7 FHIR, National Standards", "Integrates with regional pharmacies and external APIs.")
    Container(ConsentEnforcementProxy, "Consent Enforcement Proxy", "gRPC, REST", "Intercepts cross-region requests between europe-west3 and us-central1 to validate explicit user consent tokens.")
    Container(AuditLogging, "Audit Logging", "Structured JSON Logs, Regional Storage", "Collects regional structured JSON logs for security and compliance.")
    Container(ObservabilityTracing, "Observability / Tracing", "OpenTelemetry", "Collects distributed traces and OpenTelemetry metrics regionally.")
    Container(ConfigurationFeatureFlagService, "Configuration & Feature Flag Service", "Google Cloud Platform", "Manages system configuration and feature flags dynamically.")
    Container(DataMigrationArchivalWorker, "Data Migration / Archival Worker", "Managed Regional Databases", "Executes background data migration and archival tasks within regional boundaries.")
}

Rel(Patients, APIGateway, "Interacts for client routing, authentication, and TLS termination", "HTTPS/WSS")
Rel(LicensedClinicians, APIGateway, "Interacts for client routing, authentication, and TLS termination", "HTTPS/WSS")
Rel(Patients, MediaGatewayEdgeProxy, "Manages real-time video consultations", "WebRTC")
Rel(LicensedClinicians, MediaGatewayEdgeProxy, "Manages real-time video consultations", "WebRTC")
Rel(ConsentEnforcementProxy, APIGateway, "Intercepts cross-region requests to validate explicit user consent tokens", "gRPC/REST")
Rel(InteroperabilityAdapter, RegionalPharmacies, "Integrates with regional pharmacies using HL7 FHIR and national standards", "HL7 FHIR")
Rel(InteroperabilityAdapter, NationalStandards_APIs, "Integrates with national standards APIs", "REST/gRPC")
Rel(APIGateway, AISymptomChecker, "Integrates with AI Symptom Checker service", "gRPC")
Rel(AuditLogging, APIGateway, "Collects regional structured JSON logs", "OpenTelemetry / JSON")
Rel(ObservabilityTracing, APIGateway, "Collects OpenTelemetry metrics and distributed traces", "OpenTelemetry")

@enduml