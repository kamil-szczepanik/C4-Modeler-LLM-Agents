@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Configuration & Feature Flag Service", "Configuration & Feature Flag Service") {
    Component("Regional Caches", "Regional Caches", "Localized Caching Layer", "Localized caching layer within each regional cluster (europe-west3 and us-central1) that syncs via a push-pull hybrid mechanism with circuit breakers.")
    Component("Typed SDK Wrappers", "Typed SDK Wrappers", "Strongly Typed Client Libraries", "Strongly typed client libraries used across application code to evaluate feature flags via local memory lookups with <50ms latency.")
    Component("CI/CD Pipeline", "CI/CD Pipeline", "GitOps & Cryptographic Signatures", "Enforces GitOps workflows, automated contract testing, static analysis, and cryptographic signing for build-time payload integrity.")
}

System_Ext("Audit Logging", "Audit Logging", "Immutable Audit Events Service")

Rel("Typed SDK Wrappers", "Regional Caches", "Evaluates feature flags via local memory lookups with <50ms latency")
Rel("Regional Caches", "CI/CD Pipeline", "Syncs configuration and feature flags via a push-pull hybrid mechanism with circuit breakers")
Rel("Configuration & Feature Flag Service", "Audit Logging", "Emits immutable audit events via Structured JSON Logs")

@enduml