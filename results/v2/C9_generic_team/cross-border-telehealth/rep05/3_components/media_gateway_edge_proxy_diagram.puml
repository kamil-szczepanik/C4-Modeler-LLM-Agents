@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(media_gateway, "Media Gateway / Edge Proxy") {
    Component(webrtc_signaling_router, "WebRTC Signaling Router", "Janus", "Manages session establishment, NAT traversal, and peer connection signaling for video consultations.")
    Component(turn_stun_relay_handler, "TURN/STUN Relay Handler", "Coturn", "Handles media relay and NAT traversal fallback over UDP, TCP, and TLS for unstable or rural networks.")
    Component(adaptive_bitrate_congestion_controller, "Adaptive Bitrate & Congestion Controller", "Google Congestion Control (GCC)", "Adjusts video stream quality and bandwidth dynamically based on real-time network conditions.")
    Component(session_metadata_offloader, "Session Metadata Offloader", "Redis Client", "Communicates with the Regional Distributed Cache to persist and retrieve session states.")
}

Rel(webrtc_signaling_router, turn_stun_relay_handler, "Delegates media transport and NAT traversal", "UDP/TCP/TLS")
Rel(turn_stun_relay_handler, adaptive_bitrate_congestion_controller, "Feeds network metrics for bandwidth adaptation", "GCC")
Rel(webrtc_signaling_router, session_metadata_offloader, "Offloads session metadata", "Redis Protocol")

@enduml