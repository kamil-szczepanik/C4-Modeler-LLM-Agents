@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(eprescription_service, "E-Prescription Service") {
    Component(PrescriptionController, "Prescription Controller", "gRPC and REST", "Handles incoming e-prescription requests from users and external adapters.")
    Component(PrescriptionBusinessLogic, "Prescription Business Logic", "Java / Spring Boot", "Processes prescription validation, regional compliance rules, and transactional workflows.")
    Component(RegionalDatabaseAccessLayer, "Regional Database Access Layer", "Cloud SQL / Spanner Driver", "Manages isolated, jurisdiction-compliant data persistence for regional storage.")
}

Rel(PrescriptionController, PrescriptionBusinessLogic, "Delegates requests to")
Rel(PrescriptionBusinessLogic, RegionalDatabaseAccessLayer, "Persists prescription records using")

@enduml