@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Interoperability Adapter container

System_Ext(RegionalPharmacies, "Regional Pharmacies", "External regional pharmacies for e-prescription delivery.")
System_Ext(NationalStandardsAPIs, "National Standards APIs", "External national standards APIs for reference data and transactions.")
System_Ext(ConfigurationFeatureFlagService, "Configuration & Feature Flag Service", "External service providing routing configurations and feature flags.")

Container_Boundary(InteroperabilityAdapter, "Interoperability Adapter") {
    Component(AdapterPluginsStrategyPattern, "Adapter Plugins & Strategy Pattern", "Package-per-Country structure", "Encapsulates country-specific formatting for EU standards and US HL7 FHIR.")
    Component(OutboxWorkerDLQ, "Outbox Worker & DLQ", "Managed Cloud SQL / Spanner", "Persists asynchronous messaging queues for resilient e-prescription delivery.")
    Component(ConfigurationFeatureFlagServiceClient, "Configuration & Feature Flag Service Client", "gRPC/HTTPS", "Dynamically loads country-specific routing and feature flags with hot-reloading.")
    Component(OpenTelemetryTracer, "OpenTelemetry Tracer", "OpenTelemetry", "Handles distributed tracing and correlation ID propagation across adapter boundaries.")
    Component(SchemaValidator, "Schema Validator", "Pact & OpenAPI", "Performs contract-first development and schema validation gates.")
}

Rel(AdapterPluginsStrategyPattern, RegionalPharmacies, "Sends e-prescriptions via HL7 FHIR [US] and national e-prescription standards [EU]", "HL7 FHIR / REST")
Rel(AdapterPluginsStrategyPattern, NationalStandardsAPIs, "Fetches reference data and submits transactions", "REST/gRPC")
Rel(OutboxWorkerDLQ, RegionalPharmacies, "Delivers asynchronous e-prescription messages reliably", "Async / Messaging")
Rel(ConfigurationFeatureFlagServiceClient, ConfigurationFeatureFlagService, "Dynamically loads country-specific routing and feature flags", "gRPC/HTTPS")

@enduml