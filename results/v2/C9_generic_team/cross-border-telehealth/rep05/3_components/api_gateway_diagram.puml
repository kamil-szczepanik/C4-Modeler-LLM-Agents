@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Geographic_Router, "Geographic Router", "Google Cloud Platform / Edge Proxy", "Handles geographic routing, TLS termination, and directs incoming traffic to the appropriate regional infrastructure.")
    Component(Auth_Validation_Handler, "Auth & Validation Handler", "Stateless JWT, HTTPS/WSS, HTTP/2", "Performs client authentication, validates explicit user consent tokens via the Consent Enforcement Proxy, and processes idempotency keys.")
    Component(AI_Dispatcher, "AI Dispatcher", "gRPC", "Forwards symptom checker requests to the AI Symptom Checker Container for urgency recommendations.")
    Component(Data_Access_Router, "Data Access Router", "SQL over internal VPC", "Processes e-prescriptions and health records locally within regional databases (europe-west3 and us-central1).")
    Component(Audit_Emitter, "Audit Emitter", "OpenTelemetry, Structured JSON", "Emits regional structured access logs for audit logging and observability.")
}

System_Ext(Consent_Enforcement_Proxy, "Consent Enforcement Proxy", "External service for validating user consent tokens.")

Rel(Geographic_Router, Auth_Validation_Handler, "Routes authenticated client requests for validation", "HTTPS/WSS, HTTP/2")
Rel(Auth_Validation_Handler, Consent_Enforcement_Proxy, "Validates explicit user consent tokens for cross-region requests", "gRPC/REST")
Rel(Auth_Validation_Handler, AI_Dispatcher, "Forwards validated requests for urgency recommendations", "gRPC")
Rel(Auth_Validation_Handler, Data_Access_Router, "Routes requests to regional databases locally", "SQL over internal VPC")
Rel(Auth_Validation_Handler, Audit_Emitter, "Triggers emission of regional structured access logs", "OpenTelemetry / JSON")

@enduml