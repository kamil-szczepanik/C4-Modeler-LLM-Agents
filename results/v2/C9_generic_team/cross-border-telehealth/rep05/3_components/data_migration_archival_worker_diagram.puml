@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(data_migration_archival_worker, "Data Migration / Archival Worker") {
    Component(Migration_Coordinator, "Migration Coordinator", "Python, Cloud Pub/Sub Client", "Orchestrates data migration and archival tasks triggered by regional events.")
    Component(Archival_Processor, "Archival Processor", "Python, Cloud Storage API", "Processes and securely transfers historical patient and clinical data to regional cold storage while enforcing residency rules.")
    Component(Compliance_Validator, "Compliance Validator", "Python, OpenTelemetry", "Validates data payloads against GDPR and HIPAA compliance rules prior to archival.")
}

Rel(Migration_Coordinator, Archival_Processor, "Triggers data packaging and transfer")
Rel(Migration_Coordinator, Compliance_Validator, "Validates residency and privacy compliance")

@enduml