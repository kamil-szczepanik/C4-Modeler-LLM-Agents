@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Consent Enforcement Proxy container

Container_Boundary(consent_enforcement_proxy, "Consent Enforcement Proxy") {
    Component(Consent_Enforcement_Proxy_Sidecar, "Consent Enforcement Proxy Sidecar", "gRPC, REST, Sidecar Proxy", "Intercepts cross-region requests between europe-west3 and us-central1, validates tokens via local Redis cache and Bloom filter revocation checks.")
    Component(Open_Policy_Agent_OPA_Policy_Engine, "Open Policy Agent (OPA) Policy Engine", "In-memory, Rego", "Evaluates declarative Rego policies locally to enforce purpose-based consent and compliance rules.")
    Component(Policy_Bundle_Manager, "Policy Bundle Manager", "HTTPS, Google Cloud Storage", "Pulls cryptographically signed policy bundles from regional Google Cloud Storage buckets.")
    Component(Token_Validation_and_Revocation_Check, "Token Validation and Revocation Check", "Distributed Redis Cache, Bloom Filters, TCP", "Validates cryptographically signed JSON Web Tokens (JWTs) and checks real-time revocation status.")
}

Rel(Consent_Enforcement_Proxy_Sidecar, Open_Policy_Agent_OPA_Policy_Engine, "Evaluates declarative Rego policies locally", "In-memory")
Rel(Consent_Enforcement_Proxy_Sidecar, Policy_Bundle_Manager, "Pulls cryptographically signed policy bundles", "HTTPS")
Rel(Consent_Enforcement_Proxy_Sidecar, Token_Validation_and_Revocation_Check, "Validates tokens via local Redis cache and Bloom filter revocation checks", "TCP")
@enduml