@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Observability / Tracing container

System_Ext(api_gateway, "API Gateway", "API Gateway handling incoming requests")

Container_Boundary(observability_tracing, "Observability / Tracing") {
    Component(otel_collector, "OpenTelemetry Collector", "OpenTelemetry (OTel)", "Vendor-neutral telemetry collector with regional configuration, attribute scrubbing, and tail-based sampling for GDPR/HIPAA compliance.")
}

Rel(otel_collector, api_gateway, "Collects metrics and traces", "OpenTelemetry")

@enduml