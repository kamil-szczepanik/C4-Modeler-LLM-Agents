@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Symptom Checker Container container

Container_Boundary(ai_symptom_checker_container, "AI Symptom Checker Container") {
    Component(SymptomAnalysisController, "Symptom Analysis Controller", "gRPC", "Handles incoming gRPC requests from the API Gateway to process patient symptoms.")
    Component(CacheManager, "Cache Manager", "Redis Protocol", "Interacts with the Distributed Cache to retrieve and store session and lookup data.")
    Component(AuditEventEmitter, "Audit Event Emitter", "Structured JSON Logs, OpenTelemetry", "Sends structured JSON audit logs and telemetry data to the Audit Logging Service for compliance.")
}

Rel(SymptomAnalysisController, CacheManager, "Queries and updates session state", "Redis Protocol")
Rel(SymptomAnalysisController, AuditEventEmitter, "Emits telemetry and structured JSON audit logs", "Structured JSON Logs, OpenTelemetry")

@enduml