@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Inference Service container

System_Ext(api_gateway_workers, "API Gateway / Workers", "API Gateway / Workers", "Invokes symptom checks and streams telemetry.")
System_Ext(ai_model_registry, "AI Model Registry", "External Storage", "Stores versioned, cryptographically verified model artifacts.")
System_Ext(telemetry_audit_collector, "Telemetry/Audit Collector", "Collector Service", "Receives immutable audit logs and traces.")

Container_Boundary(inference_service_container, "Inference Service") {
    Component(inference_service, "Inference Service", "Python, gRPC, Protocol Buffers", "Executes the AI symptom checker, ensuring strong typing and high-performance serialization.")
    Component(middleware_audit_interceptor, "Middleware Audit Interceptor", "Middleware", "Captures inputs, model versions, and outputs for R-07 compliance.")
    Component(local_ephemeral_buffer_dlq, "Local Ephemeral Buffer / DLQ", "Local Ephemeral Storage", "Provides local caching and DLQ fallback for audit payloads during telemetry outages.")
}

Rel(api_gateway_workers, inference_service, "Invokes symptom checks and streams telemetry", "gRPC, TLS")
Rel(inference_service, ai_model_registry, "Fetches versioned model artifacts", "gRPC")
Rel(inference_service, telemetry_audit_collector, "Dispatches immutable audit logs and traces", "gRPC/HTTPS")

@enduml