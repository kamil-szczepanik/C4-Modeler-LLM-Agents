@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(cryptographic_vault, "Cryptographic Vault") {
    Component(Key_Management_Interface, "Key Management Interface", "Provider-Agnostic Key Management Interface (Wrapper Pattern)", "Interfaces with GCP Cloud KMS and HSM using a wrapper pattern for provider-agnostic key management.")
    Component(Envelope_Encryption_Service, "Envelope Encryption Service", "Python / Cryptographic Libraries", "Handles requests for Data Encryption Keys (DEKs) using envelope encryption principles.")
    Component(Vault_gRPC_Handler, "Vault gRPC Handler", "gRPC with Protocol Buffers", "Provides low-latency, type-safe API communication for calling microservices interacting with the vault.")
}

System_Ext(Cryptographic_Vault_Container_GCP_Cloud_KMS_HSM, "Cryptographic Vault Container (GCP Cloud KMS / HSM)", "GCP Cloud KMS / Hardware Security Module")

Rel(Vault_gRPC_Handler, Key_Management_Interface, "Uses to interact with hardware-backed key isolation", "gRPC")
Rel(Vault_gRPC_Handler, Envelope_Encryption_Service, "Requests Data Encryption Keys (DEKs)", "gRPC")
Rel(Key_Management_Interface, Cryptographic_Vault_Container_GCP_Cloud_KMS_HSM, "Interacts with hardware security modules", "HTTPS/API")

@enduml