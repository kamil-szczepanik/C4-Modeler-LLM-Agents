@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Asynchronous Task Worker container

Container(AsynchronousTaskWorker, "Asynchronous Task Worker", "Container", "Asynchronous Task Worker container")

Container_Boundary(c1, "Asynchronous Task Worker") {
    Component(RegionIsolatedTaskQueues, "Region-Isolated Task Queues", "Redis / Regional Database Constraints", "Queues tasks locally within GCP regions to maintain data residency and handle rural network retry resilience using idempotency keys.")
    Component(RegionalDatabases, "Regional Databases", "GCP Cloud Infrastructure (europe-west3, us-central1)", "Stores transient data locally, enforcing strict regional data residency compliance for EU and US health data.")
    Component(CryptographicVault, "Cryptographic Vault", "GCP Cloud Infrastructure / TLS", "Secures and encrypts sensitive health data and credentials.")
    Component(DeadLetterQueueDLQ, "Dead-Letter Queue (DLQ)", "Redis / Protocol Buffers", "Captures and routes failed tasks using exponential backoff.")
    Component(ExternalRegionalEPrescriptionGatewaysandAIModelRegistry, "External Regional E-Prescription Gateways and AI Model Registry", "REST / HL7 FHIR with Circuit Breakers", "External gateways for e-prescriptions and AI model integrations.")
}

Rel(AsynchronousTaskWorker, RegionIsolatedTaskQueues, "Processes jobs from Region-Isolated Task Queues via Background Worker Framework")
Rel(AsynchronousTaskWorker, RegionalDatabases, "Reads/writes transient data to Regional Databases using TLS")
Rel(AsynchronousTaskWorker, CryptographicVault, "Reads/writes cryptographic keys and data using TLS")
Rel(AsynchronousTaskWorker, ExternalRegionalEPrescriptionGatewaysandAIModelRegistry, "Integrates via REST/HL7 FHIR with Circuit Breakers")
Rel(AsynchronousTaskWorker, DeadLetterQueueDLQ, "Routes failed tasks to Dead-Letter Queue (DLQ) with Exponential Backoff")

@enduml