@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(acl, "Anti-Corruption Layer (ACL)") {
    Component(Pluggable_Regional_Adapter, "Pluggable Regional Adapter", "Pluggable Regional Modules", "Manages diverging EU (National Standards) and US (HL7 FHIR) formats.")
    Component(Fault_Tolerance_Handler, "Fault Tolerance Handler", "Circuit Breaker & Idempotency Keys", "Prevents cascading failures and duplicate pharmacy submissions over unstable links.")
    Component(Observability_Agent, "Observability Agent", "Distributed Tracing & Correlation IDs", "Ensures end-to-end observability across regional boundaries.")
}

Rel(Pluggable_Regional_Adapter, Fault_Tolerance_Handler, "Routes requests through")
Rel(Fault_Tolerance_Handler, Observability_Agent, "Tracks transactions via")

@enduml