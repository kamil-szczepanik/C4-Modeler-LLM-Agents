@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Regional Databases container

Container_Boundary(regional_databases, "Regional Databases") {
    Component(Database_Level_Audit_Triggers, "Database-Level Audit Triggers", "Database Triggers / SQL", "Generates tamper-resistant, immutable audit logs for regulatory accountability.")
    Component(GCP_Managed_Database_Instances, "GCP Managed Database Instances", "GCP Managed Database (europe-west3 and us-central1)", "Ensures strict regional data isolation for GDPR and HIPAA compliance.")
}

Rel(Database_Level_Audit_Triggers, GCP_Managed_Database_Instances, "Writes tamper-resistant audit logs upon data modifications", "Internal SQL")

@enduml