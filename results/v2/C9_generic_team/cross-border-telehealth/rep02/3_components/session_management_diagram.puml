@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Session Management container

Container_Boundary(session_management, "Session Management") {
    Component(SessionManagementComponent, "Session Management Component", "GCP Regional Services", "Governs secure, region-isolated user consultations across GCP boundaries and maintains fault-tolerant session lifecycles using Stateless JWTs, Explicit State Pattern, and Bulkhead Pattern.")
    Component(RegionalDistributedCache, "Regional Distributed Cache", "Redis", "Enables instant session revocation and consent-driven logouts.")
    Component(CloudKMS, "Cloud KMS", "Hardware Security Module", "Enforces strict cryptographic data residency separation between EU and US regions using region-bound signing keys.")
    Component(TelemetryAuditCollector, "Telemetry & Audit Collector", "gRPC", "Collects telemetry and audit logs.")
    Component(APIGateway, "API Gateway", "HTTPS, WebSockets", "Entry point for client traffic.")
}

Rel(APIGateway, SessionManagementComponent, "HTTPS, WebSockets", "HTTPS, WebSockets")
Rel(SessionManagementComponent, RegionalDistributedCache, "TCP", "TCP")
Rel(SessionManagementComponent, CloudKMS, "gRPC", "gRPC")
Rel(SessionManagementComponent, TelemetryAuditCollector, "gRPC", "gRPC")

@enduml