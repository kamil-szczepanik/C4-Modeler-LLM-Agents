@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Offline Sync/Queue Container container

Container_Boundary(offline_sync_queue_container, "Offline Sync/Queue Container") {
    Component(Local_Storage, "Local Storage", "Client-side encrypted local storage", "Persists queue data and client-side records locally with SHA-256 checksums.")
    Component(Custom_Queue_Manager, "Custom Queue Manager", "Custom Queue Management logic with persistent DLQ, exponential backoff, and idempotency keys", "Manages outbound synchronization, conflict resolution, and deterministic sequencing for unstable network conditions.")
}

Rel(Custom_Queue_Manager, Local_Storage, "Reads and writes queued payloads and checksums")

@enduml