@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Localization Router container

Container_Boundary(data_localization_router, "Data Localization Router") {
    Component(Geo_DNS_Router, "Geo-DNS Router", "Geo-DNS and TLS SNI Parsing", "Routes incoming patient and clinician requests to the appropriate regional infrastructure based on geographic origin.")
    Component(Stateless_Interceptor_Middleware, "Stateless Interceptor Middleware", "Stateless Middleware", "Intercepts requests at the edge to enforce fail-closed security and data residency policies.")
    Component(Data_Residency_Enforcer, "Data Residency Enforcer", "Policy Routing Engine", "Ensures data persistence is strictly directed to GCP-managed regional databases ineurope-west3 and us-central1.")
}

Rel(Geo_DNS_Router, Stateless_Interceptor_Middleware, "Passes parsed requests for security and policy inspection")
Rel(Stateless_Interceptor_Middleware, Data_Residency_Enforcer, "Enforces routing rules to regional databases and external services")

@enduml