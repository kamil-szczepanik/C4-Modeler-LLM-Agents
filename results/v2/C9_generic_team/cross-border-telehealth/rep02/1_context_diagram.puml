@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "Patients in the EU and US seeking video consultations, e-prescriptions, and AI symptom checks.")
Person(Clinicians, "Licensed Clinicians", "Medical professionals providing remote consultations and issuing e-prescriptions.")
System(Platform, "Cross-Border Telehealth Platform", "A cross-border telehealth platform providing video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and US, enforcing strict regional data residency while ensuring compliance with GDPR, HIPAA, and EU MDR.")

System_Ext(EdgeMedia, "Edge / Adaptive Media Relay", "External system handling real-time video streaming and adaptive media relay.")
System_Ext(Pharmacies, "EU/US Pharmacies & National E-Prescription Gateways", "External systems for processing and fulfilling electronic prescriptions.")
System_Ext(AIModelRegistry, "AI Model Registry", "External system providing version-tracked recommendations for the AI symptom checker.")
System_Ext(IdP, "Consent & Identity Provider Boundary / External IdP & Federation Service", "External system managing localized token issuance and consent.")
System_Ext(Notifications, "External Notification & Messaging Gateway", "External system handling asynchronous alerts via SMTP, SMPP, and APNS.")
System_Ext(Telemetry, "Telemetry/Audit Collector & Global Clock / NTP", "External system for collecting immutable audit logs and time synchronization.")
System_Ext(Payment, "External Payment and Billing Gateways", "External system providing PCI-DSS compliant billing and payment processing.")

Rel(Patients, Platform, "Accesses video consultations, e-prescriptions, and AI symptom checker", "HTTPS (REST/GraphQL) and WebRTC")
Rel(Clinicians, Platform, "Conducts consultations and manages patient care", "HTTPS (REST/GraphQL) and WebRTC")
Rel(Platform, EdgeMedia, "Streams throttled video consultations", "WebRTC/RTP")
Rel(Platform, Pharmacies, "Sends e-prescriptions", "HL7 FHIR (US) and national e-prescription standards (EU)")
Rel(Platform, AIModelRegistry, "Fetches version-tracked AI recommendations", "gRPC")
Rel(Platform, IdP, "Authenticates users and manages consent", "OAuth2/OIDC")
Rel(Platform, Notifications, "Sends asynchronous alerts", "SMTP/SMPP/APNS")
Rel(Platform, Telemetry, "Sends immutable audit logs", "TLS")
Rel(Platform, Payment, "Processes billing", "REST/HTTPS")

@enduml