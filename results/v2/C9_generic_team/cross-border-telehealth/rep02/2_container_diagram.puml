@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "Patients in the EU and US seeking video consultations, e-prescriptions, and AI symptom checks.")
Person(Clinicians, "Licensed Clinicians", "Medical professionals providing remote consultations and issuing e-prescriptions.")

System_Ext(Pharmacies, "EU/US Pharmacies", "External systems for processing and fulfilling electronic prescriptions.")
System_Ext(AI_Model_Registry, "AI Model Registry", "External system providing version-tracked recommendations for the AI symptom checker.")
System_Ext(External_IdP, "External IdP", "External system managing authentication and identity federation.")
System_Ext(Payment_Gateways, "Payment Gateways", "External system providing billing and payment processing.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(Offline_Sync_Queue_Container, "Offline Sync/Queue Container", "Local Storage, Custom Queue Manager", "Client-side container handling offline synchronization and queues for unstable rural connections.")
    Container(API_Gateway, "API Gateway", "HTTPS, WebSockets", "Entry point for clients routing requests to regional core containers.")
    Container(Data_Localization_Router, "Data Localization Router", "GCP Cloud Infrastructure", "Routes data to regional clusters ensuring strict regional data residency.")
    Container(Session_Management, "Session Management", "GCP Regional Services", "Manages active user consultation sessions.")
    Container(Anti_Corruption_Layer_ACL, "Anti-Corruption Layer (ACL)", "REST, HL7 FHIR, National Standards", "Translates external protocols and standards like HL7 FHIR and national e-prescription formats.")
    Container(Inference_Service, "Inference Service", "Python, gRPC", "MDR-compliant AI symptom checker providing isolated inference and immutable audit logging.")
    Container(Asynchronous_Task_Worker, "Asynchronous Task Worker", "Background Worker Framework", "Handles background and deferred tasks for resilience in unstable environments.")
    Container(Cryptographic_Vault, "Cryptographic Vault", "Cloud KMS / Hardware Security Module", "Stores and manages encryption keys to guarantee GDPR and HIPAA compliance.")
    ContainerDb(Regional_Databases, "Regional Databases", "TLS, GCP Managed Database", "Isolated regional data persistence layers in europe-west3 and us-central1.")
}

Rel(Patients, API_Gateway, "Accesses video consultations and data", "HTTPS/WebSockets")
Rel(Clinicians, API_Gateway, "Accesses video consultations and data", "HTTPS/WebSockets")
Rel(Inference_Service, AI_Model_Registry, "Fetches model versioning", "gRPC")
Rel(Anti_Corruption_Layer_ACL, Pharmacies, "Sends e-prescriptions and health data", "REST/HL7 FHIR")
Rel(Anti_Corruption_Layer_ACL, Payment_Gateways, "Processes transactions", "REST")
Rel(Data_Localization_Router, Regional_Databases, "Persists localized data securely", "TLS")

@enduml