@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_region_router, "API Gateway / Region Router") {
    Component(Geo_DNS_and_Anycast_IP_Router, "Geo-DNS and Anycast IP Router", "Geo-DNS / Anycast IP", "Directs global traffic to regional perimeters at the network edge.")
    Component(Authorization_Middleware, "Authorization Middleware", "Internal API Gateway Middleware", "Enforces authorization checks in coordination with the Consent Management Container.")
    Component(Region_Router, "Region Router", "gRPC and REST over mTLS", "Routes traffic to regional boundaries based on patient and clinician location.")
}

Rel(Geo_DNS_and_Anycast_IP_Router, Region_Router, "Forwards global incoming traffic")
Rel(Region_Router, Authorization_Middleware, "Invokes authorization checks via internal APIs")

@enduml