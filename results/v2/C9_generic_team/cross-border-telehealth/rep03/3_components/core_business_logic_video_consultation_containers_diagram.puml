@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Business Logic & Video Consultation Containers container

Container_Boundary(core_business_logic_video_consultation_containers, "Core Business Logic & Video Consultation Containers") {
    Component(WebRTC_Media_Containers, "WebRTC Media Containers", "WebRTC / UDP", "Streams video consultations supporting degraded network conditions.")
    Component(Core_Business_Logic_Container, "Core Business Logic Container", "Hexagonal Architecture / Anti-Corruption Layers", "Manages domain logic, AI symptom checker, and core business workflows.")
    Component(FHIR_E_Prescription_Adapter_Containers, "FHIR/E-Prescription Adapter Containers", "gRPC / REST", "Requests prescriptions and external data, isolating domain logic from external regional standards.")
    Component(Traceability_Logging_Container, "Traceability Logging Container", "OpenTelemetry", "Collects distributed audit logs and AI recommendation traceability.")
    Component(GCP_Pub_Sub_Event_Bus, "GCP Pub/Sub Event Bus", "GCP Pub/Sub (gRPC/HTTPS)", "Publishes asynchronous events utilizing the Claim Check Pattern for heavy payloads.")
    Component(GCP_Memorystore_Regional_Caches, "GCP Memorystore Regional Caches", "Redis Protocol", "Stores temporary sync payloads.")
    Component(GCP_Secret_Manager, "GCP Secret Manager", "GCP Secret Manager", "Enforces strict regional data residency boundaries for secrets.")
}

Rel(WebRTC_Media_Containers, Patients_Clinicians, "Streams video consultations", "WebRTC/UDP")
Rel(Core_Business_Logic_Container, GCP_Pub_Sub_Event_Bus, "Publishes asynchronous events", "gRPC/HTTPS")
Rel(Core_Business_Logic_Container, GCP_Memorystore_Regional_Caches, "Stores temporary sync payloads", "Redis Protocol")
Rel(Core_Business_Logic_Container, FHIR_E_Prescription_Adapter_Containers, "Requests prescriptions and external data", "gRPC/REST")
Rel(Traceability_Logging_Container, Core_Business_Logic_Container, "Collects distributed audit logs", "OpenTelemetry")

@enduml