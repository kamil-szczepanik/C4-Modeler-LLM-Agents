@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Component(ApiGatewayRegionRouter, "API Gateway / Region Router", "Gateway / Router", "Forwards requests for authorization evaluation.")

Container_Boundary(ConsentManagementContainer, "Consent Management Container") {
    Component(PolicyEvaluationMiddleware, "Policy evaluation middleware", "Internal REST/gRPC", "Evaluates authorization requests forwarded from the API Gateway/Region Router.")
    Component(OpenPolicyAgentOPAEvaluationCore, "Open Policy Agent (OPA) Evaluation Core", "Open Policy Agent (OPA)", "Evaluates dynamic, versioned access control and privacy policies.")
    Component(GCPMemorystoreRegionalCachingLayer, "GCP Memorystore (Regional caching layer)", "GCP Memorystore / Redis", "Provides low-latency regional caching for active consent tokens.")
    Component(GCPPubSubPushBasedPolicyDistributionBus, "GCP Pub/Sub (Push-based policy distribution bus)", "GCP Pub/Sub", "Distributes compiled OPA policy bundles via push subscription.")
    Component(OpenTelemetryCollectorSidecars, "OpenTelemetry Collector Sidecars", "OpenTelemetry", "Emits structured audit logs asynchronously via local socket for distributed tracing.")
}

Rel(ApiGatewayRegionRouter, PolicyEvaluationMiddleware, "Forwards requests for authorization evaluation", "Internal REST/gRPC")
Rel(PolicyEvaluationMiddleware, GCPMemorystoreRegionalCachingLayer, "Reads cached active consent tokens", "Redis protocol")
Rel(GCPPubSubPushBasedPolicyDistributionBus, PolicyEvaluationMiddleware, "Distributes compiled OPA policy bundles", "Push subscription")
Rel(PolicyEvaluationMiddleware, OpenTelemetryCollectorSidecars, "Emits structured audit logs asynchronously", "Local socket")

@enduml