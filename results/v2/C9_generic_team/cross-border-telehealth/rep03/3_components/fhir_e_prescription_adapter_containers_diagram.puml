@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the FHIR/E-Prescription Adapter Containers container

Container_Boundary(fhirdb, "FHIR/E-Prescription Adapter Containers") {
    Component(US_HL7_FHIR_Adapter, "US HL7 FHIR Adapter", "Containerized Service / REST / FHIR", "Exchanges clinical data with US HL7 FHIR Providers using Anti-Corruption Layer patterns.")
    Component(EU_EPrescription_Gateway_Adapter, "EU E-Prescription Gateway Adapter", "Containerized Service / National Protocols", "Routes e-prescriptions to EU National E-Prescription Gateways with strict regional routing.")
    Component(Pharmacy_Network_Coordinator, "Pharmacy Network Coordinator", "Containerized Service / REST / HTTPS", "Coordinates fulfillment with Regional Pharmacy Networks, protected by circuit breakers and bulkheads.")
}

Rel(US_HL7_FHIR_Adapter, EU_EPrescription_Gateway_Adapter, "Coordinates cross-border clinical data mapping", "Internal gRPC")
Rel(EU_EPrescription_Gateway_Adapter, Pharmacy_Network_Coordinator, "Dispatches fulfillment requests", "Internal API")

@enduml