@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Traceability Logging Container container

Container_Boundary(traceability_logging_container, "Traceability Logging Container") {
    Component(OpenTelemetry_Collector_Sidecar, "OpenTelemetry Collector Sidecar", "OpenTelemetry Collector", "Decouples telemetry emission, enforces schema validation, buffering, and tail-based sampling for AI traceability.")
    Component(Telemetry_Storage_Exporter, "Telemetry Storage Exporter", "GCP Cloud Storage Exporter", "Transmits buffered telemetry data to region-isolated immutable storage sinks.")
}

Rel(OpenTelemetry_Collector_Sidecar, Telemetry_Storage_Exporter, "Forwards buffered and sampled telemetry", "")

@enduml