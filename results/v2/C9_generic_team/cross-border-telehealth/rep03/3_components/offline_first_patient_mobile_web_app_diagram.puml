@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(patient_app, "Offline-First Patient Mobile/Web App") {
    Component(LocalDatabaseStorage, "Local Database Storage", "SQLite (mobile) and IndexedDB (web)", "Resilient local-first persistence for offline periods storing local state and mutation queues.")
    Component(TransactionalOutbox, "Transactional Outbox", "State Machine Architecture", "Manages state transitions and queues mutations with idempotency keys during offline states.")
    Component(CryptographicEnvelopeManager, "Cryptographic Envelope Manager", "Android Keystore and iOS Keychain", "Handles client-side cryptographic envelope encryption for data-at-rest protection.")
    Component(ClientSidePIIRedactor, "Client-Side PII Redactor", "Client-side processing logic", "Redacts personally identifiable information on the client side prior to transmission.")
    Component(NetworkResilienceManager, "Network Resilience Manager", "Service Workers, Circuit Breakers, Token Bucket Rate Limiting", "Implements stale-while-revalidate strategies, rate limiting, and network fault tolerance.")
}

Rel(TransactionalOutbox, LocalDatabaseStorage, "Reads and writes queued mutations and state locally")
Rel(CryptographicEnvelopeManager, LocalDatabaseStorage, "Encrypts data stored within local persistence layers")
Rel(ClientSidePIIRedactor, TransactionalOutbox, "Sanitizes clinical payloads prior to outbox queuing")
Rel(NetworkResilienceManager, TransactionalOutbox, "Controls the synchronization flow of queued mutations over network boundaries")

@enduml