@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Regional Caches container

Container_Boundary(regional_caches, "Regional Caches") {
    Component(MemorystoreInstance, "Memorystore Instance", "GCP Memorystore", "Provides low-latency regional caching supporting the Cache-Aside pattern, TTLs, and Redlock distributed locks.")
    Component(CacheManagementService, "Cache Management Service", "Python, Redis Client", "Manages cache invalidation, TTL enforcement, and coordinates with core business logic.")
}

Rel(CacheManagementService, MemorystoreInstance, "Reads and writes cached data using Cache-Aside pattern", "Redis Protocol")

@enduml