@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(Event_Driven_Integration_Bus, "Event-Driven Integration Bus") {
    Component(Regional_Pub_Sub_Topics, "Regional Pub/Sub Topics", "GCP Pub/Sub with Regional Topics", "Manages regional message distribution, dead-letter queues, and flow control for asynchronous event-driven communication.")
    Component(Schema_Validator, "Schema Validator", "Protocol Buffers / JSON Schema", "Enforces strict message schema validation at publisher boundaries.")
    Component(Claim_Check_Handler, "Claim Check Handler", "GCP Cloud Storage", "Offloads and retrieves large payloads using the Claim Check pattern to maintain optimal event bus performance.")
}

Rel(Regional_Pub_Sub_Topics, Schema_Validator, "Validates messages against strict schemas", "")
Rel(Regional_Pub_Sub_Topics, Claim_Check_Handler, "Offloads large payloads", "")
@enduml