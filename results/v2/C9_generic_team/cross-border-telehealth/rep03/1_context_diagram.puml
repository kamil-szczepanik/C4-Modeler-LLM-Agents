@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients and Licensed Clinicians, "Patients and Licensed Clinicians", "End-users utilizing video consultations, e-prescriptions, and the AI symptom checker across EU and US regions.")

System(Cross-Border Telehealth Platform, "Cross-Border Telehealth Platform", "Cross-Border Telehealth Platform providing video consultations, e-prescriptions, and an AI symptom checker for EU and US patients with strict regional data residency and compliance via isolated GCP deployments.")

System_Ext(US HL7 FHIR Providers, "US HL7 FHIR Providers", "External US-based healthcare systems using HL7 FHIR protocols.")
System_Ext(EU National E-Prescription Gateways, "EU National E-Prescription Gateways", "External EU-based national gateways for managing e-prescriptions.")
System_Ext(Regional Pharmacy Networks, "Regional Pharmacy Networks", "External regional pharmacy networks for fulfilling prescriptions.")

Rel(Patients and Licensed Clinicians, Cross-Border Telehealth Platform, "Accesses video consultations, e-prescriptions, and AI symptom checker", "HTTPS/WebRTC (Adaptive streaming)")
Rel(Cross-Border Telehealth Platform, US HL7 FHIR Providers, "Interoperability and data exchange for US patients", "REST/FHIR")
Rel(Cross-Border Telehealth Platform, EU National E-Prescription Gateways, "Interoperability and e-prescription routing for EU patients", "National Protocols")
Rel(Cross-Border Telehealth Platform, Regional Pharmacy Networks, "Prescription fulfillment and coordination", "REST/HTTPS")

@enduml