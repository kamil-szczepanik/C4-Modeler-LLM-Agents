@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Dedicated Consent Evaluation Service container

Container_Boundary(ded_consent_eval_service_container, "Dedicated Consent Evaluation Service") {
    Component(Dedicated_Consent_Evaluation_Service, "Dedicated Consent Evaluation Service", "Open Policy Agent (OPA) / Rego, Protocol Buffers", "Core policy engine that provides real-time, policy-driven data privacy enforcement and evaluates patient consent.")
}

Component(Region_Isolated_API_Gateways_and_Backend_Services, "Region-Isolated API Gateways and Backend Services", "Internal REST/gRPC API, W3C Trace Context", "Clients invoking the consent service for validating patient consent prior to data access.")
Component(GCP_Pub_Sub, "GCP Pub/Sub", "GCP Pub/Sub Protocol", "Asynchronous messaging bus for cache invalidation events across europe-west3 and us-central1.")
Component(Distributed_Cache_Redis, "Distributed Cache (Redis)", "TCP/Redis Protocol", "In-memory caching layer for low-latency consent evaluations with short TTLs.")

Rel(Region_Isolated_API_Gateways_and_Backend_Services, Dedicated_Consent_Evaluation_Service, "Validates patient consent", "Internal REST/gRPC API, W3C Trace Context")
Rel(Dedicated_Consent_Evaluation_Service, GCP_Pub_Sub, "Publishes and consumes cache invalidation events", "GCP Pub/Sub Protocol")
Rel(Dedicated_Consent_Evaluation_Service, Distributed_Cache_Redis, "Reads and writes cached consent states", "TCP/Redis Protocol")

@enduml