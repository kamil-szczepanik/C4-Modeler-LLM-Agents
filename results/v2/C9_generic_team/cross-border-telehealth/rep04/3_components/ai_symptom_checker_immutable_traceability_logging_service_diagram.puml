@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(ai_symptom_container, "AI Symptom Checker & Immutable Traceability Logging Service") {
    Component(AI_Symptom_Checker_Engine, "AI Symptom Checker Engine", "Python, OpenTelemetry", "Performs real-time AI inference and symptom analysis for EU and US patients.")
    Component(Immutable_Traceability_Logging_Service, "Immutable Traceability Logging Service", "Python, SHA-256 Cryptographic Hashing, Write-Ahead Append-Only Logs", "Ensures tamper-evident EU MDR accountability and traceability logging.")
    Component(CQRS_Circuit_Breaker_Manager, "CQRS & Circuit Breaker Manager", "Python, Circuit Breaker Pattern", "Decouples real-time AI inference from logging writes to ensure availability during connection drops.")
}

Rel(AI_Symptom_Checker_Engine, CQRS_Circuit_Breaker_Manager, "Routes inference and logging requests", "gRPC/Internal API")
Rel(CQRS_Circuit_Breaker_Manager, Immutable_Traceability_Logging_Service, "Writes append-only tamper-evident logs", "Internal API")

@enduml