@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Interoperability Adapter Containers container

Container_Boundary(interoperability_adapter_containers, "Interoperability Adapter Containers") {
    Component(ACL_and_Circuit_Breaker, "Anti-Corruption Layer (ACL) and Circuit Breaker", "Java / Spring Boot", "Isolates internal domain models from external third-party variations and prevents cascading failures.")
    Component(Pluggable_Strategy_Engine, "Pluggable Strategy Engine", "Design Pattern / Strategy Interface", "Modularizes diverse EU national e-prescription standards and US HL7 FHIR requirements.")
    Component(Transactional_Outbox_and_Idempotency_Handler, "Transactional Outbox and Idempotency Handler", "Database Outbox / Redis Idempotency Keys", "Guarantees reliable message dispatch without duplicate prescriptions.")
    Component(Bulkhead_Isolation_Manager, "Bulkhead Isolation Manager", "Resilience4j / Thread Pool Isolation", "Isolates resource and connection pools per external partner to contain blast radiuses.")
}

Rel(Anti_Corruption_Layer_ACL_and_Circuit_Breaker, Pluggable_Strategy_Engine, "Transforms domain models for regional standards", "")
Rel(Pluggable_Strategy_Engine, Bulkhead_Isolation_Manager, "Routes external partner requests through isolated pools", "")
Rel(Transactional_Outbox_and_Idempotency_Handler, Anti_Corruption_Layer_ACL_and_Circuit_Breaker, "Dispatches reliable messages to ACL", "")

@enduml