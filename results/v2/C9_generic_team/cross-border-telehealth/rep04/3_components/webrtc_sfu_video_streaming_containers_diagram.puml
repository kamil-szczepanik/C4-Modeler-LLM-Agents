@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the WebRTC SFU Video Streaming Containers container

Container_Boundary(sfu_container, "WebRTC SFU Video Streaming Containers") {
    Component(SFU_Media_Forwarder, "SFU Media Forwarder", "WebRTC SFU", "Powers selective forwarding unit video streaming for low-latency multi-party consultations.")
    Component(OpenTelemetry_Observability_Sidecar_Agent, "OpenTelemetry Observability Sidecar Agent", "OpenTelemetry", "Captures real-time container metrics, packet loss, jitter, and bitrate metrics for automated scaling and health checks.")
    Component(Session_Token_Handler, "Session Token Handler", "Redis / GCP Secret Manager", "Manages low-latency distributed caching for stateless SFU session tokenization, resumption, and secret injection.")
}

Rel(SFU_Media_Forwarder, Session_Token_Handler, "Stores and retrieves stateless session handover tokens", "TCP")
Rel(OpenTelemetry_Observability_Sidecar_Agent, SFU_Media_Forwarder, "Captures real-time packet loss, jitter, and bitrate metrics")

@enduml