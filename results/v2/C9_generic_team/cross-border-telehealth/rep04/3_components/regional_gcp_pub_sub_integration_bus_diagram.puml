@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(regional_gcp_pub_sub_integration_bus, "Regional GCP Pub/Sub Integration Bus") {
    Component(Regional_Topic_Segregator, "Regional Topic Segregator", "GCP Pub/Sub Topics", "Enforces strict regional topic segregation and regional CMEK scoping to satisfy GDPR and HIPAA.")
    Component(Schema_Validation_Registry, "Schema Validation Registry", "Protocol Buffers & GCP Schema Validation", "Enforces strict schema registry and backward-compatible event evolution across message boundaries.")
    Component(Trace_Context_Propagation_Agent, "Trace Context Propagation Agent", "OpenTelemetry & W3C Traceparent", "Maintains unbroken distributed tracing across asynchronous message boundaries.")
}

Rel(Regional_Topic_Segregator, Schema_Validation_Registry, "Validates message payloads against schemas", "Protocol Buffers")
Rel(Schema_Validation_Registry, Trace_Context_Propagation_Agent, "Injects W3C trace context into validated events", "OpenTelemetry")

@enduml