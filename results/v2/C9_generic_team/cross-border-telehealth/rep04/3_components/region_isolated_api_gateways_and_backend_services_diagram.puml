@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Patients_and_Licensed_Clinicians, "Patients and Licensed Clinicians", "External users interacting with the platform.")

Container_Boundary(Region_Isolated_API_Gateways_and_Backend_Services, "Region-Isolated API Gateways and Backend Services") {
    Component(Envoy_Proxy, "Envoy Proxy", "Envoy / OpenAPI / Protobuf", "Edge routing, circuit breaking, rate limiting, and schema validation for incoming HTTPS requests.")
    Component(Backend_Services, "Backend Services", "gRPC / REST", "Core business logic processing video consultations, e-prescriptions, and routing requests with schema validation.")
    Component(Regional_Memorystore_for_Redis, "Regional Memorystore for Redis", "GCP Memorystore (Redis)", "Low-latency, region-isolated storage tracking idempotency keys and rate limits via internal TCP.")
    Component(Cloud_SQL_Auth_Proxy, "Cloud SQL Auth Proxy", "Cloud SQL Auth Proxy", "Securely connects backend services to regional databases via TCP.")
    Component(GCP_Pub_Sub_Integration_Bus, "GCP Pub/Sub Integration Bus", "GCP Pub/Sub", "Publishes and distributes platform events across regional services.")
    Component(OpenTelemetry_Observability_Agents, "OpenTelemetry Observability Agents", "OpenTelemetry", "Handles distributed tracing and compliance logging.")
}

Rel(Patients_and_Licensed_Clinicians, Envoy_Proxy, "Interacts", "HTTPS")
Rel(Envoy_Proxy, Backend_Services, "Routes requests with schema validation", "gRPC/REST")
Rel(Backend_Services, Regional_Memorystore_for_Redis, "Tracks idempotency keys and rate limits", "internal TCP")
Rel(Backend_Services, Cloud_SQL_Auth_Proxy, "Connects to regional databases", "TCP")
Rel(Backend_Services, GCP_Pub_Sub_Integration_Bus, "Publishes events", "GCP Pub/Sub")

@enduml