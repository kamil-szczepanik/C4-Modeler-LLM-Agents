@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Cloud SQL Auth Proxy & OpenTelemetry Observability Agents container

Person_Ext(Region_Isolated_Backend_Services, "Region-Isolated Backend Services", "Backend services running in regional deployments.")
System_Ext(GCP_Cloud_SQL, "GCP Cloud SQL (europe-west3, us-central1)", "Managed relational databases.")
System_Ext(Regional_Observability_Backend, "Regional Observability Backend", "Centralized telemetry and monitoring platform.")

Container_Boundary(Cloud_SQL_Auth_Proxy___OpenTelemetry_Observability_Agents, "Cloud SQL Auth Proxy & OpenTelemetry Observability Agents") {
    Component(Cloud_SQL_Auth_Proxy_Sidecar, "Cloud SQL Auth Proxy Sidecar", "GCP Cloud SQL Auth Proxy", "Enforces secure, region-isolated database tunnels with connection pooling for HIPAA and GDPR compliance, connecting securely via mutual TLS.")
    Component(OpenTelemetry_Collector_Sidecar, "OpenTelemetry Collector Sidecar", "OpenTelemetry", "Collects distributed traces and metrics with disk-backed file storage buffering to prevent data loss during network partitions.")
    Component(GCP_Secret_Manager_Integration, "GCP Secret Manager Integration", "GCP Secret Manager", "Automates secure database credential rotation without application downtime.")
    Component(Local_Buffering_Storage_Extension, "Local Buffering Storage Extension", "Local disk-backed buffering file storage", "Provides local disk-backed buffering to ensure asynchronous batch processing and prevent data loss during network partitions.")
}

Rel(Region_Isolated_Backend_Services, Cloud_SQL_Auth_Proxy_Sidecar, "Connects securely via mutual TLS (mTLS) and configured connection pooling limits.", "mTLS")
Rel(OpenTelemetry_Collector_Sidecar, Regional_Observability_Backend, "Exports sanitized telemetry using asynchronous batch processing and disk-backed buffering.", "HTTPS/gRPC")
Rel(Cloud_SQL_Auth_Proxy_Sidecar, GCP_Cloud_SQL, "Establishes secure regional database tunnels with exponential backoff retry policies.", "Encrypted TCP")
Rel(OpenTelemetry_Collector_Sidecar, Local_Buffering_Storage_Extension, "Utilizes disk-backed file storage extensions for buffering telemetry data.", "File I/O")
Rel(Cloud_SQL_Auth_Proxy_Sidecar, GCP_Secret_Manager_Integration, "Retrieves credentials for secure database authentication and rotation.", "API")

@enduml