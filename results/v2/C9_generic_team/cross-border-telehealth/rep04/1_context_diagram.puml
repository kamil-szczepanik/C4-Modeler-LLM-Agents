@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_EU_and_US, "Patients (EU and US)", "Patients located in the EU and US seeking video consultations, e-prescriptions, and AI symptom checking.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Medical professionals providing video consultations and care to patients.")

System(Multi_Region_Cross_Border_Telehealth_Platform, "Multi-Region Cross-Border Telehealth Platform", "A multi-region cross-border telehealth platform deployed on GCP providing video consultations, e-prescriptions, and an AI symptom checker for EU and US patients while enforcing strict regional data residency and high availability for rural connections.")

System_Ext(Third_Party_Pharmacies, "Third-Party Pharmacies", "External pharmacy systems for fulfilling prescriptions.")
System_Ext(National_E_Prescription_Endpoints, "National E-Prescription Endpoints", "External national endpoints for e-prescription integration in the EU and US.")

Rel(Patients_EU_and_US, Multi_Region_Cross_Border_Telehealth_Platform, "Interacts for video consultations, e-prescriptions, and AI symptom checking", "HTTPS, WebRTC")
Rel(Licensed_Clinicians, Multi_Region_Cross_Border_Telehealth_Platform, "Interacts to conduct video consultations and manage patient care", "HTTPS, WebRTC")
Rel(Multi_Region_Cross_Border_Telehealth_Platform, Third_Party_Pharmacies, "Sends prescription and fulfillment details", "HL7 FHIR / National Protocols")
Rel(Multi_Region_Cross_Border_Telehealth_Platform, National_E_Prescription_Endpoints, "Integrates with national e-prescription systems via Anti-Corruption Layers", "HL7 FHIR, National Protocols")
@enduml