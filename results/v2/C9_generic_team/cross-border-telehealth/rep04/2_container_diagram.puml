@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Multi-Region Cross-Border Telehealth Platform

Person(Patients, "Patients (EU and US)", "Patients located in the EU and US seeking video consultations, e-prescriptions, and AI symptom checking.")
Person(Clinicians, "Licensed Clinicians", "Medical professionals providing video consultations and care to patients.")

System_Ext(Pharmacies, "Third-Party Pharmacies", "External pharmacy systems for fulfilling prescriptions.")
System_Ext(NationalEndpoints, "National E-Prescription Endpoints", "External national endpoints for e-prescription integration in the EU and US.")

System_Boundary(TelehealthPlatform, "Multi-Region Cross-Border Telehealth Platform") {
    Container(ApiGateways, "Region-Isolated API Gateways and Backend Services", "GCP, Envoy Proxy, REST/gRPC", "Handles region-isolated routing, rate limiting, circuit breaking, and backend business logic for europe-west3 and us-central1.")
    Container(WebRtcSfu, "WebRTC SFU Video Streaming Containers", "WebRTC SFU, Adaptive Bitrate Streaming", "Enables resilient, low-latency adaptive bitrate video streaming for unstable connections.")
    Container(AiLoggingService, "AI Symptom Checker & Immutable Traceability Logging Service", "Python, OpenTelemetry", "Provides AI-driven symptom checking and immutable audit logs for EU MDR traceability and telemetry.")
    Container(InteropAdapters, "Interoperability Adapter Containers", "HL7 FHIR, EU e-prescription standards", "Adapters integrating core systems with third-party pharmacies and national endpoints using HL7 FHIR and EU standards.")
    Container(PubSubBus, "Regional GCP Pub/Sub Integration Bus", "GCP Pub/Sub", "Asynchronous messaging bus for decoupled third-party integrations and event distribution.")
    Container(ConsentService, "Dedicated Consent Evaluation Service", "Microservice, Policy Engine", "Evaluates and enforces data privacy consent for EU and US patients.")
    Container(SqlAuthProxy, "Cloud SQL Auth Proxy & OpenTelemetry Observability Agents", "GCP Cloud SQL Auth Proxy, OpenTelemetry", "Manages secure database connections and collects distributed tracing and metrics.")
}

Rel(Patients, ApiGateways, "Interacts for API calls and video consultation access", "HTTPS")
Rel(Patients, WebRtcSfu, "Streams video consultations", "WebRTC")
Rel(Clinicians, ApiGateways, "Interacts for clinical workflows and management", "HTTPS")
Rel(Clinicians, WebRtcSfu, "Streams video consultations", "WebRTC")

Rel(ApiGateways, AiLoggingService, "Sends requests for symptom checking and logs audit events", "gRPC/Internal API")
Rel(ApiGateways, ConsentService, "Validates patient consent", "Internal API")
Rel(ApiGateways, PubSubBus, "Publishes e-prescription events", "GCP Pub/Sub")
Rel(PubSubBus, InteropAdapters, "Triggers adapter processing for prescription dispatch", "GCP Pub/Sub")
Rel(InteropAdapters, Pharmacies, "Sends prescription and fulfillment details", "HL7 FHIR / National Protocols")
Rel(InteropAdapters, NationalEndpoints, "Integrates with national e-prescription systems", "HL7 FHIR, EU Standards")
Rel(ApiGateways, SqlAuthProxy, "Connects to regional database and exports telemetry", "Cloud SQL Auth Proxy, OpenTelemetry")

@enduml