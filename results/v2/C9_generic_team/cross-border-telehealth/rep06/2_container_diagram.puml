@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients_and_Licensed_Clinicians, "Patients and Licensed Clinicians", "Users who interact with the platform for video consultations, e-prescriptions, and AI symptom checking.")
System_Ext(External_Health_Integrations_Pharmacies, "External Health Integrations & Pharmacies", "External health systems, pharmacies, and national EU/US e-prescription standards.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(API_Gateway_Edge_Proxy_Container, "API Gateway / Edge Proxy Container", "GCP Cloud Load Balancing / Envoy", "Manages incoming traffic, routing requests securely to internal containers.")
    Container(Integration_Translation_Container, "Integration & Translation Container", "Node.js / GCP Cloud Run", "Communicates with external pharmacies and health systems via HL7 FHIR and national EU e-prescription standards.")
    ContainerDb(State_Session_Management_Container, "State & Session Management Container", "Redis / GCP Memorystore", "Utilizes regional Redis instances for session persistence and degraded-mode reconnections.")
    Container(Config_Feature_Management_Container, "Config & Feature Management Container", "GCP Cloud Config / Custom Service", "Manages configuration and feature flags for the platform.")
    Container(Audit_Traceability_Logging_Container, "Audit & Traceability Logging Container", "GCP Pub/Sub / Cloud Logging", "Receives asynchronous events from an Inter-Container Event Bus using GCP Pub/Sub for traceability.")
    Container(Identity_Access_Management_IAM_Container, "Identity & Access Management (IAM) Container", "OAuth2 / OpenID Connect / JWTs", "Handles stateless authorization and purpose-based consent management.")
    Container(Health_Resilience_Monitoring_Container, "Health & Resilience Monitoring Container", "GCP Cloud Monitoring / Prometheus", "Monitors health and resilience across regional GCP deployments.")
    Container(Secrets_Certificate_Management_Container, "Secrets & Certificate Management Container", "GCP Secret Manager", "Manages secrets and certificates securely across regions.")
    ContainerDb(Data_Persistence_Container, "Data Persistence Container", "Cloud SQL / Spanner (GCP)", "Enforces strict regional data partitioning via managed databases in GCP.")
}

Rel(Patients_and_Licensed_Clinicians, API_Gateway_Edge_Proxy_Container, "Interact with the platform for video consultations, prescriptions, and symptom checks", "HTTPS and WebRTC (adaptive bandwidth protocols)")
Rel(API_Gateway_Edge_Proxy_Container, Integration_Translation_Container, "Routes requests to internal containers", "gRPC over mTLS")
Rel(API_Gateway_Edge_Proxy_Container, State_Session_Management_Container, "Manages user sessions", "gRPC over mTLS")
Rel(API_Gateway_Edge_Proxy_Container, Config_Feature_Management_Container, "Fetches configurations and feature flags", "gRPC over mTLS")
Rel(API_Gateway_Edge_Proxy_Container, Audit_Traceability_Logging_Container, "Sends asynchronous logging events", "GCP Pub/Sub")
Rel(API_Gateway_Edge_Proxy_Container, Identity_Access_Management_IAM_Container, "Authenticates and authorizes requests", "gRPC over mTLS, JWT")
Rel(API_Gateway_Edge_Proxy_Container, Health_Resilience_Monitoring_Container, "Reports health and telemetry", "gRPC over mTLS")
Rel(API_Gateway_Edge_Proxy_Container, Secrets_Certificate_Management_Container, "Retrieves secrets and certificates", "gRPC over mTLS")
Rel(API_Gateway_Edge_Proxy_Container, Data_Persistence_Container, "Queries and persists data", "gRPC over mTLS")
Rel(Integration_Translation_Container, External_Health_Integrations_Pharmacies, "Communicates with external pharmacies and health systems", "HL7 FHIR, EU national e-prescription standards")

@enduml