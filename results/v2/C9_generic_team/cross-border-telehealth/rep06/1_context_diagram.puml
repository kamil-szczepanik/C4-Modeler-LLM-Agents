@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients and Licensed Clinicians, "Patients and Licensed Clinicians", "Users who interact with the platform for video consultations, e-prescriptions, and AI symptom checking.")

System(Cross-Border Telehealth Platform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for patients across the EU and US, enforcing strict regional data residency, regulatory compliance, and resilience.")

System_Ext(External Health Integrations, "External Health Integrations", "External health systems including HL7 FHIR for US and national e-prescription standards for EU.")

Rel(Patients and Licensed Clinicians, Cross-Border Telehealth Platform, "Interact with the platform for video consultations, prescriptions, and symptom checks", "HTTPS/TLS 1.3, WebRTC (RTP/SRTP)")
Rel(Cross-Border Telehealth Platform, External Health Integrations, "Integrates with external health systems for US (HL7 FHIR) and EU national standards via regional adapters", "HL7 FHIR, EU National APIs, Regional Adapters")

@enduml