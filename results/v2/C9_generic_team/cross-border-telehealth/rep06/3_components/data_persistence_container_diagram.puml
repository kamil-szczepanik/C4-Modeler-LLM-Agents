@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(data_persistence_container, "Data Persistence Container") {
    Component(Database_Router, "Database Router", "Cloud SQL / Cloud Spanner with Database Router pattern", "Routes queries and handles table partitioning for regional data isolation.")
    Component(Schema_Migration_Manager, "Schema Migration Manager", "Flyway / Liquibase", "Enforces expand-and-contract zero-downtime automated schema migrations.")
    Component(Encryption_Manager, "Encryption Manager", "GCP Cloud KMS", "Handles regionally segregated customer-managed encryption keys for data at rest.")
}

Rel(Database_Router, Encryption_Manager, "Encrypts data at rest with regionally segregated keys", "Internal GCP APIs")
Rel(Schema_Migration_Manager, Database_Router, "Performs automated zero-downtime schema migrations")
@enduml