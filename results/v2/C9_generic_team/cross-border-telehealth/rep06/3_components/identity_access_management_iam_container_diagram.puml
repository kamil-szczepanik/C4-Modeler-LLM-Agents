@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(iam_container, "Identity & Access Management (IAM) Container") {
    Component(AuthConfig, "Authentication and Authorization Controller", "OAuth2 / OpenID Connect / JWTs", "Handles incoming authentication requests, issues short-lived (15-minute) tokens, and validates API requests.")
    Component(ConsentManager, "Consent and State Manager", "PostgreSQL Protocol / SQL", "Queries and manages regional user consent and user states.")
    Component(AuditEventEmitter, "Audit Event Emitter", "gRPC", "Emits asynchronous security audit events to logging and traceability streams.")
}

System_Ext(ApiGateway, "API Gateway / Edge Proxy Container", "GCP Cloud Load Balancing / Envoy")
System_Ext(SecretsManager, "Secrets & Certificate Management Container", "GCP Secret Manager")
System_Ext(AuditLogging, "Audit & Traceability Logging Container", "GCP Pub/Sub / Cloud Logging")
System_Ext(DataPersistence, "Data Persistence Container", "Cloud SQL / Spanner (GCP)")

Rel(AuthConfig, ApiGateway, "Authenticates and authorizes requests", "gRPC over mTLS, JWT")
Rel(AuthConfig, SecretsManager, "Retrieves signing keys and environment variables", "HTTPS")
Rel(AuditEventEmitter, AuditLogging, "Emits asynchronous security audit events", "gRPC")
Rel(ConsentManager, DataPersistence, "Queries regional consent and user states", "PostgreSQL Protocol / SQL")

@enduml