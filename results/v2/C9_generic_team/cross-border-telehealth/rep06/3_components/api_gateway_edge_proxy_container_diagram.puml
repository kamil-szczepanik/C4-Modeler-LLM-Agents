@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_edge_proxy_container, "API Gateway / Edge Proxy Container") {
    Component(Edge_Router, "Edge Router", "GCP Cloud Load Balancing / Envoy", "Handles edge routing, HTTP/3, SNI inspection, and geo-based traffic steering to enforce data residency.")
    Component(Traffic_Steering_Engine, "Traffic Steering Engine", "Envoy Proxy", "Manages geo-based traffic routing and ensures regional data boundaries.")
}

Rel(Edge_Router, Traffic_Steering_Engine, "Directs incoming requests for traffic steering and geo-validation")

@enduml