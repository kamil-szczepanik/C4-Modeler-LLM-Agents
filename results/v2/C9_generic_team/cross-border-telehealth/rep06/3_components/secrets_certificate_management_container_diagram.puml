@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Secrets & Certificate Management Container container

System_Ext(api_gateway, "API Gateway / Edge Proxy Container", "External container interacting with the secrets service.")
System_Ext(audit_logging, "Audit & Traceability Logging Container", "External container for audit and compliance logging.")
System_Ext(monitoring, "Health & Resilience Monitoring Container", "External container for telemetry and monitoring.")

Container_Boundary(secrets_container, "Secrets & Certificate Management Container") {
    Component(secrets_mgr, "Secrets & Certificate Management Container", "GCP Secret Manager, Terraform, JSON Schema, GCP IAM Conditions", "Provides secure storage, rotation, and lifecycle management for cryptographic materials, certificates, and sensitive credentials across regions.")
}

Rel(api_gateway, secrets_mgr, "Retrieves secrets and certificates", "gRPC over mTLS")
Rel(secrets_mgr, audit_logging, "Emits structured audit logs", "gRPC / GCP Pub/Sub")
Rel(secrets_mgr, monitoring, "Emits telemetry, metrics, and expiration alerts", "Prometheus / GCP Cloud Monitoring")

@enduml