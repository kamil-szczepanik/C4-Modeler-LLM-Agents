@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(health_resilience_monitoring_container, "Health & Resilience Monitoring Container") {
    Component(Telemetry Ingestion Component, "Telemetry Ingestion Component", "Prometheus / OpenTelemetry (OTel)", "Receives regional telemetry collection and inbound telemetry reporting using standardized schemas.")
    Component(Health & Metrics Engine, "Health & Metrics Engine", "GCP Cloud Monitoring / Prometheus", "Evaluates health, resilience, and telemetry with isolated instances per region to satisfy GDPR and HIPAA.")
    Component(Event Publisher Component, "Event Publisher Component", "GCP Pub/Sub", "Exports resilience events and decouples observability from control-plane logic via event-driven webhooks.")
    Component(Configuration Client Component, "Configuration Client Component", "REST/gRPC", "Fetches operational configuration parameters from the Config & Feature Management Container.")
}

Rel(Telemetry Ingestion Component, Health & Metrics Engine, "Passes normalized telemetry for processing")
Rel(Health & Metrics Engine, Event Publisher Component, "Exports resilience events", "GCP Pub/Sub")
Rel(Configuration Client Component, Health & Metrics Engine, "Applies operational configuration parameters")

@enduml