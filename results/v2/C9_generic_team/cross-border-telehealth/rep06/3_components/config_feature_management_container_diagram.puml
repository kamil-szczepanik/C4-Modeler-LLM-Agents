@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(config_feature_management_container, "Config & Feature Management Container") {
    Component(Configuration_Evaluation_Engine, "Configuration Evaluation Engine", "GCP Cloud Config / Custom Service with Client-Side SDK", "Evaluates rules and configuration payloads validated via JSON Schema.")
    Component(Feature_Flag_Controller, "Feature Flag Controller", "GCP Cloud Config / Custom Service with Client-Side SDK", "Manages and syncs feature flags and caches via gRPC over mTLS.")
}

Rel(Configuration_Evaluation_Engine, Feature_Flag_Controller, "Evaluates and serves configuration flags", "gRPC over mTLS")

@enduml