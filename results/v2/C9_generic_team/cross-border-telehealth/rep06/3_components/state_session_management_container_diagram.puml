@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(state_session_management_container, "State & Session Management Container") {
    Component(Session_Handler, "Session Handler", "Node.js / Redis Protocol", "Manages active user session states and token validation for consultations.")
    Component(Heartbeat_Lease_Manager, "Heartbeat Lease Manager", "Node.js", "Maintains high availability for unstable connections via heartbeat leases and bulkhead patterns.")
}

Rel(Session_Handler, Heartbeat_Lease_Manager, "Coordinates session liveness and lease renewals", "")

@enduml