@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(audit_container, "Audit & Traceability Logging Container") {
    Component(LogPublisher, "Log Publisher", "GCP Pub/Sub", "Publishes asynchronous audit and traceability logs with at-least-once delivery.")
    Component(LogProcessor, "Log Processor", "GCP Cloud Logging", "Processes and ingests region-isolated logging streams for compliance.")
    Component(LogArchiver, "Log Archiver", "GCP Cloud Storage", "Archives tamper-evident logs to WORM storage with Bucket Lock.")
}

Rel(LogPublisher, LogProcessor, "Streams log events", "HTTPS")
Rel(LogProcessor, LogArchiver, "Persists tamper-evident logs to WORM storage", "HTTPS")

@enduml