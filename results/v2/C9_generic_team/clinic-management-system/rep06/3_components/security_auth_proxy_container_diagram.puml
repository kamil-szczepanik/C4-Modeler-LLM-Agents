@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Security/Auth Proxy Container container

Container_Boundary(Security_Auth_Proxy_Container, "Security/Auth Proxy Container") {
    Component(OAuth2_OIDC_Reverse_Proxy, "OAuth2 / OIDC Reverse Proxy", "Envoy", "Validates requests, authenticates sessions, enforces mTLS, rate-limiting, and request schema validation.")
    Component(Token_Validator_Component, "Token Validator Component", "OAuth2 / OpenID Connect with JWKS", "Stateless authentication using locally validated short-lived JWTs to minimize IdP bottlenecks.")
}

Rel(OAuth2_OIDC_Reverse_Proxy, Token_Validator_Component, "Validates incoming tokens and authenticates sessions", "OAuth2 / OIDC")

@enduml