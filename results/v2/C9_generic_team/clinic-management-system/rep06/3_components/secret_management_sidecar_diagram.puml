@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Secret Management Sidecar container

Container_Boundary(secret_management_sidecar, "Secret Management Sidecar") {
    Component(Vault_Agent, "Vault Agent", "HashiCorp Vault Agent / tmpfs", "Handles secure authentication with HashiCorp Vault, dynamic secret retrieval, and local tmpfs caching for high-performance credential rotation.")
    Component(Secret_Management_Service, "Secret Management Service", "Sidecar Process / Local Loopback", "Exposes local loopback interface endpoints to supply AES-256 encryption keys and credentials securely to domain services.")
}

Rel(Vault_Agent, Secret_Management_Service, "Populates templates and syncs secrets via", "Local loopback interface localhost:8200 / Vault Agent templates")

@enduml