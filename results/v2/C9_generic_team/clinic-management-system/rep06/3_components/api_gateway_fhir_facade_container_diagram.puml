@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("API Gateway / FHIR Facade Container", "API Gateway / FHIR Facade Container") {
    Component("API Gateway Handler", "API Gateway Handler", "Custom FHIR Facade", "Manages incoming HTTPS/TLS 1.3 requests from patients, staff, and external systems, routing them appropriately.")
    Component("FHIR Facade Router", "FHIR Facade Router", "Apache Camel", "Handles payload transformation, routing, and translation between custom payloads and HL7 FHIR standards.")
    Component("Auth Validator", "Auth Validator", "OAuth2 / OpenID Connect Client", "Communicates with the Security/Auth Proxy Container to validate incoming requests and user sessions.")
}

Rel("API Gateway Handler", "Auth Validator", "Validates requests via OAuth2 / OpenID Connect", "")
Rel("API Gateway Handler", "FHIR Facade Router", "Forwards requests for routing and payload transformation", "")
Rel("FHIR Facade Router", "Domain Services Containers", "Route traffic via gRPC / REST over TLS (mTLS)", "gRPC / REST over TLS (mTLS)")
Rel("FHIR Facade Router", "External Labs / Imaging Systems", "Communicate via HTTPS, HL7 FHIR APIs", "HTTPS, HL7 FHIR")

@enduml