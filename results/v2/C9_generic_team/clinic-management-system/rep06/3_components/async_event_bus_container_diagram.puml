@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(Async_Event_Bus_Container, "Async Event Bus Container") {
    Component(Event_Publisher, "Event Publisher", "Kafka / RabbitMQ Producer Client", "Publishes asynchronous events from domain services with AES-256 encryption.")
    Component(Event_Broker_Core, "Event Broker Core", "Apache Kafka / RabbitMQ", "Handles high throughput, message routing, and cross-site mirroring for disaster recovery.")
    Component(Event_Consumer, "Event Consumer", "Kafka / RabbitMQ Consumer Client", "Consumes asynchronous events for downstream domain processing and auditing.")
}

Rel(Event_Publisher, Event_Broker_Core, "Sends encrypted event messages over TLS", "TLS")
Rel(Event_Broker_Core, Event_Consumer, "Delivers queued asynchronous events", "")
@enduml