@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Domain Services Containers container

Container_Boundary(domain_services_containers, "Domain Services Containers") {
    Component(PatientEMRMicroservice, "Patient/EMR Microservice", "Microservices / Java / Go", "Handles patient admissions and electronic medical records (EMR) within a DDD bounded context.")
    Component(SchedulingMicroservice, "Scheduling Microservice", "Microservices / Java / Go", "Manages clinical staff and patient scheduling.")
    Component(BillingMicroservice, "Billing Microservice", "Microservices / Java / Go", "Handles billing administration and financial transactions.")
}

System_Ext(AsyncEventBusContainer, "Async Event Bus Container", "Asynchronous messaging system")
System_Ext(SecretManagementSidecar, "Secret Management Sidecar", "Secret management system")
System_Ext(ExternalLabsImagingSystems, "External Labs / Imaging Systems", "External clinical systems")

Rel(PatientEMRMicroservice, AsyncEventBusContainer, "Publish/consume asynchronous events", "Kafka / RabbitMQ")
Rel(SchedulingMicroservice, AsyncEventBusContainer, "Publish/consume asynchronous events", "Kafka / RabbitMQ")
Rel(BillingMicroservice, AsyncEventBusContainer, "Publish/consume asynchronous events", "Kafka / RabbitMQ")
Rel(PatientEMRMicroservice, SecretManagementSidecar, "Retrieve keys and secrets", "HashiCorp Vault API")
Rel(SchedulingMicroservice, SecretManagementSidecar, "Retrieve keys and secrets", "HashiCorp Vault API")
Rel(BillingMicroservice, SecretManagementSidecar, "Retrieve keys and secrets", "HashiCorp Vault API")
Rel(PatientEMRMicroservice, ExternalLabsImagingSystems, "Interoperate via HL7 FHIR APIs", "HL7 FHIR")

@enduml