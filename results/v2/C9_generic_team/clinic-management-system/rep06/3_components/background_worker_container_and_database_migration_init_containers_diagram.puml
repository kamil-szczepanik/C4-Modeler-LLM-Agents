@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(background_worker_container_and_database_migration_init_containers, "Background Worker Container and Database Migration Init-Containers") {
    Component(Background_Worker_Service, "Background Worker Service", "Kubernetes Jobs", "Processes asynchronous tasks and background jobs reliably.")
    Component(Database_Migration_Init_Container, "Database Migration Init-Container", "Kubernetes Init-Containers", "Handles schema updates and database migrations prior to service startup.")
}

Rel(Background_Worker_Service, Database_Migration_Init_Container, "Depends on schema state initialized by", "")

@enduml