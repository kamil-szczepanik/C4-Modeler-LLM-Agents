@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Observability Stack container

Container_Boundary(observability_stack, "Observability Stack") {
    Component(Prometheus, "Prometheus", "Prometheus", "Collects and stores metrics from all system containers and microservices.")
    Component(Grafana, "Grafana", "Grafana", "Provides dashboards and visualization for metrics, logs, and traces.")
    Component(OpenTelemetry_Collectors, "OpenTelemetry Collectors", "OpenTelemetry Protocol (OTLP)", "Collects telemetry data with local buffering collectors from all containers.")
}

Rel(OpenTelemetry_Collectors, Prometheus, "Forwards metrics data")
Rel(Prometheus, Grafana, "Feeds metrics for visualization")
Rel(OpenTelemetry_Collectors, Grafana, "Feeds trace and telemetry data for visualization")

@enduml