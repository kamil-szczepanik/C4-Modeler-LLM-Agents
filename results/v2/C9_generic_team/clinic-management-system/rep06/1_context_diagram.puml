@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "End users who access the system for admissions, scheduling, and personal records.")
Person(Clinical_Staff, "Clinical Staff", "Healthcare professionals who manage patient EMRs, appointments, and clinical workflows.")
Person(Billing_Administrators, "Billing Administrators", "Administrative staff responsible for managing billing, invoices, and financial operations.")

System_Ext(External_Labs, "External Labs", "External laboratory systems that exchange clinical data.")
System_Ext(Imaging_Systems, "Imaging Systems", "External diagnostic imaging systems that integrate with the platform.")
System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "External OAuth2/OIDC service for multi-factor authentication and session management.")

System(Clinic_Management_System, "Clinic Management System", "A hybrid cloud platform that handles patient admissions, electronic medical records, scheduling, and billing for medium-sized clinics, providing highly available, secure, and interoperable clinical IT operations compliant with HIPAA and GDPR mandates.")

Rel(Patients, Clinic_Management_System, "Authenticate and access clinical functions and scheduling", "HTTPS/TLS 1.3, Multi-factor Authentication")
Rel(Clinical_Staff, Clinic_Management_System, "Authenticate and manage patient EMRs, admissions, and schedules", "HTTPS/TLS 1.3, Multi-factor Authentication")
Rel(Billing_Administrators, Clinic_Management_System, "Authenticate and manage billing and financial operations", "HTTPS/TLS 1.3, Multi-factor Authentication")
Rel(External_Labs, Clinic_Management_System, "Exchange clinical data using HL7 FHIR APIs", "HTTPS, HL7 FHIR")
Rel(Imaging_Systems, Clinic_Management_System, "Integrate and exchange medical imaging data", "HTTPS, HL7 FHIR")
Rel(Clinic_Management_System, Identity_Provider_IdP, "Authenticate users and manage sessions", "OAuth2/OIDC, HTTPS/TLS 1.3")

@enduml