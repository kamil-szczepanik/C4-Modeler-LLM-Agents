@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(PatientsCliniciansandAdministrativeStaff, "Patients, Clinicians, and Administrative Staff", "Users who interact with the system to manage patient admissions, electronic medical records, scheduling, and billing.")

System(ClinicManagementSystem, "Clinic Management System", "A hybrid cloud platform designed for medium-sized hospitals and clinics to handle patient admissions, electronic medical records, scheduling, and billing while ensuring high availability, strict regulatory compliance, and seamless interoperability.")

System_Ext(ExternalIdentityProvidersIdPs, "External Identity Providers (IdPs)", "Provides Multi-Factor Authentication and OpenID Connect (OIDC) authentication for system users.")

System_Ext(ThirdPartyBillingGateways, "Third-Party Billing Gateways", "External systems used to process financial transactions and billing.")

System_Ext(HL7FHIRCompliantLabImagingSystems, "HL7 FHIR-Compliant Lab/Imaging Systems", "External clinical systems integrated via HL7 FHIR REST APIs for lab and imaging data.")

Rel(PatientsCliniciansandAdministrativeStaff, ClinicManagementSystem, "Access the system via HTTPS/TLS through the API Gateway", "HTTPS/TLS")
Rel(ClinicManagementSystem, ExternalIdentityProvidersIdPs, "Authenticate users via OpenID Connect (OIDC)", "OpenID Connect")
Rel(ClinicManagementSystem, ThirdPartyBillingGateways, "Process billing and financial transactions", "REST APIs")
Rel(ClinicManagementSystem, HL7FHIRCompliantLabImagingSystems, "Integrate lab and imaging data", "HL7 FHIR REST APIs")

@enduml