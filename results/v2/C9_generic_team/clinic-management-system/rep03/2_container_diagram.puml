@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(Users, "Patients, Clinicians, and Administrative Staff", "Users who interact with the system to manage patient admissions, electronic medical records, scheduling, and billing.")

System_Ext(IdPs, "External Identity Providers (IdPs)", "Provides Multi-Factor Authentication and OpenID Connect (OIDC) authentication for system users.")
System_Ext(BillingGateway, "Third-Party Billing Gateways", "External systems used to process financial transactions and billing.")
System_Ext(LabSystem, "HL7 FHIR-Compliant Lab/Imaging Systems", "External clinical systems integrated via HL7 FHIR REST APIs for lab and imaging data.")

System_Boundary(ClinicManagementSystem, "Clinic Management System") {
    Container(ApiGateway, "API Gateway Container", "Kubernetes Ingress / Custom Proxy", "Unified routing and multi-factor authentication (MFA) enforcement.")
    Container(DomainContainers, "Domain Containers", "Microservices / Kubernetes", "EMR, Scheduling, and Billing microservices.")
    Container(IntegrationService, "Integration Service Container", "Asynchronous Worker", "Asynchronous HL7 FHIR traffic handler.")
    Container(EventBus, "Event Bus / Message Broker Container", "Apache Kafka or RabbitMQ", "Asynchronous messaging and event-driven communication.")
    ContainerDb(CachingContainer, "Caching Container", "Redis Enterprise", "Demographic and schedule data caching for sub-second retrieval.")
    Container(FileStorage, "File/Document Storage Container", "Object Storage with WORM support", "Storage for clinical imaging and PDFs with strict retention policies.")
    Container(ArchivalContainer, "Data Archival & Purging Container", "Background Worker", "10-year data retention management and automated archival.")
    Container(ObservabilityContainer, "Observability & Configuration Container", "Prometheus, Fluentbit, Secret Manager", "Centralized logging, distributed tracing, and secrets management.")
}

Rel(Users, ApiGateway, "Secure user access and MFA enforcement", "HTTPS/MFA")
Rel(ApiGateway, DomainContainers, "Internal microservice routing", "gRPC/REST")
Rel(DomainContainers, EventBus, "Decoupled event publishing", "AMQP/Kafka")
Rel(IntegrationService, LabSystem, "Lab and imaging data exchange", "HL7 FHIR REST/JSON")
Rel(DomainContainers, CachingContainer, "Sub-second data retrieval", "Redis Protocol")
Rel(ApiGateway, IdPs, "Authenticate users", "OpenID Connect")
Rel(DomainContainers, BillingGateway, "Process financial transactions", "REST APIs")
@enduml