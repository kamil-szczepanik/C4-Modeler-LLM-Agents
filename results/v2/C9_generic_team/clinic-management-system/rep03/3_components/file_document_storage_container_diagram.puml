@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the File/Document Storage Container container

Container_Boundary(file_document_storage_container, "File/Document Storage Container") {
    Component(Storage_Abstraction_Layer, "Storage Abstraction Layer", "S3 API / Storage Abstraction", "Handles secure and standardized interactions with underlying object storage services.")
    Component(WORM_Enforcement_Engine, "WORM Enforcement Engine", "Object Storage WORM Policy Manager", "Ensures immutable storage configurations to meet strict 10-year data retention and compliance mandates.")
}

Rel(Storage_Abstraction_Layer, WORM_Enforcement_Engine, "Enforces immutable retention policies")

@enduml