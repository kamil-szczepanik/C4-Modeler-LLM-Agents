@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway_container, "API Gateway Container") {
    Component(Ingress_Proxy_Routing_Component, "Ingress Proxy & Routing Component", "Kubernetes Ingress / Custom Proxy", "Handles secure user access, HTTPS/MFS enforcement, and internal microservice routing via gRPC/REST.")
    Component(Authentication_Token_Validation_Component, "Authentication & Token Validation Component", "OAuth2 / JWT & W3C Trace Context", "Performs token introspection and JWT validation via HTTPS with External Identity Providers (IdPs).")
    Component(Rate_Limiting_Session_Management_Component, "Rate Limiting & Session Management Component", "Redis Enterprise", "Manages session persistence, distributed rate limiting, and idempotency tracking via TCP.")
}

Rel(Ingress_Proxy_Routing_Component, Authentication_Token_Validation_Component, "Validates incoming tokens and enforces security")
Rel(Ingress_Proxy_Routing_Component, Rate_Limiting_Session_Management_Component, "Tracks session persistence and distributed rate limiting via TCP")

@enduml