@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(domain_containers, "Domain Containers") {
    Component(EMR_Service, "EMR Service", "Microservice / gRPC / REST", "Manages electronic medical records, patient admissions, and clinical data.")
    Component(Scheduling_Service, "Scheduling Service", "Microservice / gRPC / REST", "Handles appointments, practitioner schedules, and resource allocation.")
    Component(Billing_Service, "Billing Service", "Microservice / gRPC / REST", "Processes financial operations, invoices, and third-party billing integrations.")
}

Rel(EMR_Service, Scheduling_Service, "Coordinates patient appointments and medical history access", "gRPC/REST")
Rel(Scheduling_Service, Billing_Service, "Triggers billing workflows upon appointment completion", "gRPC/REST")

@enduml