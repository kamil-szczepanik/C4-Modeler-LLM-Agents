@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(IntegrationServiceContainer, "Integration Service Container") {
    Component(HL7FHIRWorker, "HL7 FHIR Worker", "Asynchronous Worker / Streaming JSON Parsers", "Processes HL7 FHIR traffic and external system interactions with memory-efficient payload parsing.")
    Component(CircuitBreakerDLQHandler, "Circuit Breaker & DLQ Handler", "Circuit Breaker & Dead-Letter Queue (DLQ)", "Handles errors and external communication failures with PII/PHI sanitization.")
    Component(TransactionalOutboxDispatcher, "Transactional Outbox Dispatcher", "Transactional Outbox Pattern", "Ensures atomic state changes and message dispatches to prevent split-brain issues.")
}

Rel(HL7FHIRWorker, CircuitBreakerDLQHandler, "Routes failed external calls and sanitizes errors via [Circuit Breaker/DLQ]")
Rel(TransactionalOutboxDispatcher, HL7FHIRWorker, "Dispatches atomic state changes and messages via [AMQP/TCP or Kafka Protocol]")

@enduml