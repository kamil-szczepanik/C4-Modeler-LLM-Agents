@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Caching Container container

Container_Boundary(caching_container, "Caching Container") {
    Component(RedisEnterpriseCacheEngine, "Redis Enterprise Cache Engine", "Redis Enterprise", "Handles sub-second demographic and schedule caching with cache-aside pattern, TTL policies, and connection multiplexing.")
}

System(DomainContainers, "Domain Containers", "Microservices handling core clinical domains")

Rel(DomainContainers, RedisEnterpriseCacheEngine, "Sub-second data retrieval", "Redis Protocol over TLS")

@enduml