@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(data_archival_purging_container, "Data Archival & Purging Container") {
    Component(Archival_Extractor_Worker, "Archival Extractor Worker", "Background Worker / Go or Python", "Extracts historical data from primary databases based on the strict 10-year data retention mandate.")
    Component(Checksum_Validator, "Checksum Validator", "SHA-256 Hashing Library", "Validates extracted historical data integrity via SHA-256 checksums before transfer.")
    Component(WORM_Storage_Client, "WORM Storage Client", "Object Storage SDK / HTTPS", "Transfers validated historical data to File/Document Storage Container with WORM support.")
}

Rel(Archival_Extractor_Worker, Checksum_Validator, "Sends extracted historical data for integrity validation")
Rel(Checksum_Validator, WORM_Storage_Client, "Transfers validated data for immutable storage")
@enduml