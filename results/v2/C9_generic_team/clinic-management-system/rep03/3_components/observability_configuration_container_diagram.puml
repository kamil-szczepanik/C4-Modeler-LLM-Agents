@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(observability_config_container, "Observability & Configuration Container") {
    Component(Prometheus__OpenTelemetry, "Prometheus & OpenTelemetry", "Prometheus & OpenTelemetry", "Standardized metric scraping, distributed tracing, and health probe monitoring.")
    Component(Fluentbit, "Fluentbit", "Fluentbit", "Edge log aggregation featuring automated PII/PHI payload masking and disk-backed local buffering.")
    Component(Secret_Manager, "Secret Manager", "Dedicated sidecar/initialization plane", "Decoupled secret management plane ensuring isolated and secure credential handling.")
    Component(Configuration_Agent, "Configuration Agent", "JSON Schema / Protocol Buffers", "Manages hot-reloaded configurations with immutable, tamper-resistant version tagging.")
    Component(Local_Disk_Buffers__EmptyDir_, "Local Disk Buffers (EmptyDir)", "Kubernetes EmptyDir", "Temporary storage for fault-tolerant telemetry backpressure during network partitions.")
}

Rel(Prometheus__OpenTelemetry, Local_Disk_Buffers__EmptyDir_, "Buffers telemetry data locally", "")
Rel(Fluentbit, Local_Disk_Buffers__EmptyDir_, "Buffers scrubbed logs locally", "")
Rel(Configuration_Agent, Secret_Manager, "Coordinates configuration and secure secrets", "")
@enduml