@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Clinic Management System

Person(Patients, "Patients", "Patients interacting with the clinic system for admissions, scheduling, and personal records.")
Person(Practitioners, "Practitioners", "Medical practitioners managing EMRs, patient schedules, and treatments.")
Person(Administrators, "Administrators", "System and clinic administrators managing operations, users, and configurations.")

System_Ext("Insurance Providers", "Insurance Providers", "External systems for processing billing, claims, and insurance verification.")
System_Ext("External Labs/Imaging", "External Labs/Imaging", "External medical laboratories and imaging centers integrating via HL7 FHIR APIs.")
System_Ext("IAM", "Identity & Access Management (IAM)", "Manages authentication, credentials, and access control.")
System_Ext("Centralized Audit Logging Service", "Centralized Audit Logging Service", "Records audit logs for regulatory compliance and security tracking.")
System_Ext("External Notification Providers", "External Notification Providers", "Sends notifications and alerts to users.")
System_Ext("Air-gapped DR Storage Targets", "Air-gapped DR Storage Targets", "Provides isolated disaster recovery storage for backups.")
System_Ext("Configuration and Secret Management Services", "Configuration and Secret Management Services", "Stores and retrieves credentials and system secrets securely.")

System(ClinicManagementSystem, "Clinic Management System", "A hybrid-cloud platform designed for medium-sized hospitals and clinics to manage patient admissions, EMRs, scheduling, and billing with high availability and strict regulatory compliance.")

Rel(Patients, ClinicManagementSystem, "interact with clinic management via MFA and HTTPS", "HTTPS/TLS, MFA")
Rel(Practitioners, ClinicManagementSystem, "interact with clinic management via MFA and HTTPS", "HTTPS/TLS, MFA")
Rel(External Labs/Imaging, ClinicManagementSystem, "integrate via HL7 FHIR APIs through the API Gateway", "HL7 FHIR APIs")
Rel(ClinicManagementSystem, Configuration and Secret Management Services, "offloads credential and secret retrieval", "API")

@enduml