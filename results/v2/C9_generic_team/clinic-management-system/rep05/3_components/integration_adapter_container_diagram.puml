@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration / Adapter Container container

Container_Boundary(integration_adapter_container, "Integration / Adapter Container") {
    Component(HL7_FHIR_REST_Adapter, "HL7 FHIR REST Adapter", "HL7 FHIR over REST", "Interfaces with external labs, imaging systems, and insurance providers using standardized clinical interoperability protocols.")
    Component(Schema_Translation_Engine, "Schema Translation Engine", "JSONata / Liquid Templates", "Applies declarative mapping rules for schema translations between external payloads and internal domain models.")
    Component(Outbox_Event_Publisher, "Outbox Event Publisher", "Transactional Outbox Pattern", "Publishes domain events to the asynchronous message broker using reliable transactional outbox patterns.")
    Component(Audit_Emission_Component, "Audit Emission Component", "W3C Trace Context", "Emits distributed traces and logs to the centralized audit logging service.")
}

Rel(HL7_FHIR_REST_Adapter, Schema_Translation_Engine, "[Transforms external payload]")
Rel(Schema_Translation_Engine, Outbox_Event_Publisher, "[Publishes domain events]")
Rel(HL7_FHIR_REST_Adapter, Audit_Emission_Component, "[Emits traces and logs]")
@enduml