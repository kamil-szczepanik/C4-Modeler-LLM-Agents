@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component Diagram for Session & State Management Container

Container_Boundary(session_state_management_container, "Session & State Management Container") {
    Component(Distributed_Locking_Manager, "Distributed Locking Manager", "Redis Enterprise", "Provides high-availability distributed locking for clinical workflows.")
    Component(Session_Management_Service, "Session Management Service", "Redis Enterprise", "Manages user and system sessions across hybrid-cloud operations.")
    Component(Rate_Limiter, "Rate Limiter", "Redis Enterprise", "Handles rate limiting and protects upstream core domain services.")
    Component(Active_Active_Replication_Engine, "Active-Active Replication Engine", "Redis Enterprise", "Replicates state between on-prem Kubernetes and eu-central-1.")
}

Rel(Session_Management_Service, Distributed_Locking_Manager, "Coordinates distributed locks for concurrent operations", "TCP / Lettuce/ioredis")
Rel(Active_Active_Replication_Engine, Session_Management_Service, "Synchronizes state across multi-region deployments", "Active-Active Replication Protocol")

@enduml