@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(asynchronous_message_broker, "Asynchronous Message Broker") {
    Component(Event Publisher, "Event Publisher", "Apache Kafka Producer (TLS 1.3, SASL/SCRAM)", "Emits domain events from Core Domain Containers to the message broker ensuring causal consistency by PatientID.")
    Component(Event Consumer, "Event Consumer", "Apache Kafka Consumer (Manual Offset Commits)", "Consumes asynchronous tasks and events for the Background Worker Container.")
    Component(Schema Registry, "Schema Registry", "Confluent Schema Registry (Avro/Protobuf)", "Ensures event contract governance and backward compatibility for event-driven messaging.")
}

Rel(Event Publisher, Schema Registry, "Validates event schemas via", "")
Rel(Schema Registry, Event Consumer, "Provides event contracts to", "")
@enduml