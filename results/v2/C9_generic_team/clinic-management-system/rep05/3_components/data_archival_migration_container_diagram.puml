@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(data_archival_migration_container, "Data Archival & Migration Container") {
    Component(Archival_Controller, "Archival Controller", "Containerized Microservice / Python / Go", "Triggers and manages asynchronous data offloading workflows for long-term 10-year retention.")
    Component(Migration_Processor, "Migration Processor", "Apache Parquet / Avro / Schema Registry", "Executes batch processing, serialization, and write-verify-delete lifecycles for EMR records.")
    Component(Cryptographic_Verification_Service, "Cryptographic Verification Service", "TLS 1.3 / SHA-256 / Cryptographic Manifests", "Ensures data integrity during storage transfer by verifying checksums and manifest authenticity.")
}

System_Ext(DR_Storage_Targets, "DR Storage Targets", "Air-gapped DR storage targets for long-term retention.")

Rel(Archival_Controller, Migration_Processor, "Triggers batch offloading and data serialization workflows")
Rel(Migration_Processor, Cryptographic_Verification_Service, "Generates cryptographic checksums and validates transfers")
Rel(Cryptographic_Verification_Service, DR_Storage_Targets, "Transfers encrypted data using TLS 1.3 with SHA-256 checksums", "TLS 1.3 / SHA-256")

@enduml