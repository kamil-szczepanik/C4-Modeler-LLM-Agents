@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Domain Containers container

Container_Boundary(core_domain_containers, "Core Domain Containers") {
    Component(Registration_Component, "Registration Component", "Microservice / Spring Boot", "Manages patient admissions, registration data, and related domain logic.")
    Component(Scheduling_Component, "Scheduling Component", "Microservice / Spring Boot", "Handles appointments and practitioner scheduling for clinic staff.")
    Component(EMR_Component, "EMR Component", "Microservice / Spring Boot", "Manages electronic medical records ensuring rapid data access and HIPAA/GDPR compliance.")
    Component(Billing_Component, "Billing Component", "Microservice / Spring Boot", "Processes patient billing, invoices, and financial records.")
}

Rel(Registration_Component, Scheduling_Component, "Triggers schedule setup for newly registered patients")
Rel(Scheduling_Component, EMR_Component, "Links appointments with electronic medical records")
Rel(EMR_Component, Billing_Component, "Forwards clinical service details for invoice generation")

@enduml