@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("ReadModel___Query_Container", "Read-Model / Query Container") {
    Component(Query_Controller, "Query Controller", "CQRS Pattern / REST API", "Handles incoming read requests and routes queries for EMR workflows.")
    Component(Query_Service, "Query Service", "Business Logic Layer", "Implements business logic for retrieving and processing read-model data.")
    Component(Cache_Manager, "Cache Manager", "Redis / TCP", "Implements the cache-aside pattern for low-latency data retrieval.")
    Component(Event_Synchronization_Handler, "Event Synchronization Handler", "AMQP / Kafka", "Synchronizes event streams from the message broker to update read models.")
}

Rel(Query_Controller, Query_Service, "Delegates query execution")
Rel(Query_Service, Cache_Manager, "Retrieves cached state via cache-aside pattern")
Rel(Event_Synchronization_Handler, Query_Service, "Updates read models from event streams")

@enduml