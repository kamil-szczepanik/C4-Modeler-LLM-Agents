@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Hospital_Staff_and_Patients, "Hospital Staff and Patients", "Users accessing the clinic management system")
System_Ext(API_Gateway, "API Gateway", "External API gateway handling backend routing and security")
System_Ext(OpenTelemetry_Container, "OpenTelemetry Container", "External observability and monitoring platform")

Container_Boundary(Frontend_Container, "Frontend Container") {
    Component(Frontend_Container_Single_Page_Application, "Frontend Container (Single Page Application)", "Next.js / Single Page Application", "Decoupled architecture for rapid UI rendering and modular component design, delivering high-performance access to clinical workflows while strictly enforcing HIPAA and GDPR compliance.")
    Component(Nginx_Reverse_Proxy, "Nginx Reverse Proxy", "Nginx & Kubernetes", "Reverse proxy and container orchestration ensuring high availability (99.99%) and health probes.")
    Component(Content_Delivery_Network_CDN, "Content Delivery Network (CDN)", "CDN", "Delivers static assets and optimizes content delivery globally.")
    Component(OpenTelemetry_SDK, "OpenTelemetry SDK", "OpenTelemetry SDK", "Client-side observability and real-user monitoring integration for streaming sanitized telemetry logs and RUM metrics.")
    Component(API_Client_Abstraction_Layer, "API Client Abstraction Layer", "AbortController / TypeScript", "Handles API requests, client-side request deduplication, and race-condition handling.")
    Component(Component_Library, "Component Library", "WCAG 2.1 AA Compliance", "Accessible user interface components for hospital staff and patients.")
}

Rel(Hospital_Staff_and_Patients, Frontend_Container_Single_Page_Application, "Accesses UI via HTTPS/TLS", "HTTPS/TLS")
Rel(Frontend_Container_Single_Page_Application, API_Gateway, "Sends API requests via HTTPS with JWT/MFA validation", "HTTPS, JWT/MFA")
Rel(Frontend_Container_Single_Page_Application, OpenTelemetry_Container, "Streams sanitized telemetry logs and RUM metrics", "OpenTelemetry, gRPC/HTTPS")
@enduml