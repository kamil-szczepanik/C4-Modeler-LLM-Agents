@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(shared_config_sidecar, "Shared Configuration & Secret Management Sidecar") {
    Component(ConfigurationManagerComponent, "Configuration Manager Component", "Local Loopback / Sidecar Service", "Manages shared runtime configurations for Core Domain Containers over local loopback.")
    Component(SecretManagementComponent, "Secret Management Component", "Encrypted Vault / Local Loopback", "Handles secure secret retrieval and encryption keys for Core Domain Containers.")
}

System(CoreDomainContainers, "Core Domain Containers", "Handles core clinic management domain logic")

Rel(ConfigurationManagerComponent, CoreDomainContainers, "Provides dynamic configuration over local loopback", "Local Loopback")
Rel(SecretManagementComponent, CoreDomainContainers, "Provides secure secrets over local loopback", "Local Loopback")

@enduml