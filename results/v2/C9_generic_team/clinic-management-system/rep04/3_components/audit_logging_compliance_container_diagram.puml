@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit Logging & Compliance Container container

Container_Boundary("Audit Logging & Compliance Container", "Audit Logging & Compliance Container") {
    Component("Audit Event Receiver", "Audit Event Receiver", "Node.js / Express API", "Receives security and compliance audit events from the Asynchronous Event Bus and core services.")
    Component("Compliance Validation Engine", "Compliance Validation Engine", "Python / HIPAA-GDPR Policy Engine", "Validates incoming events against strict HIPAA and GDPR regulations and ensures 10-year retention rules.")
    Component("WORM Storage Writer", "WORM Storage Writer", "AWS S3 SDK with Object Lock", "Writes tamper-resistant audit logs directly to Write-Once-Read-Many (WORM) storage for compliance mandates.")
}

Rel("Audit Event Receiver", "Compliance Validation Engine", "Forwards collected audit events for policy checking")
Rel("Compliance Validation Engine", "WORM Storage Writer", "Sends validated logs for immutable storage")
@enduml