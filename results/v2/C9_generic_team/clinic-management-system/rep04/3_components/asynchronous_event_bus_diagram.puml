@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Asynchronous Event Bus container

Container_Boundary("Asynchronous Event Bus", "Asynchronous Event Bus") {
    Component("Centralized Schema Registry", "Centralized Schema Registry", "Avro / JSON Schema Registry", "Enforces strict backward and forward compatibility to prevent schema drift across services.")
    Component("Message Broker", "Message Broker", "Kafka/RabbitMQ", "Handles asynchronous, decoupled event-driven workflows and high availability with TLS and Envelope Encryption.")
    Component("Dead Letter Queues (DLQ)", "Dead Letter Queues (DLQ)", "AMQP/Kafka", "Routes malformed or failed messages for later inspection and error handling.")
}

Rel("Message Broker", "Dead Letter Queues (DLQ)", "Route malformed or failed messages", "AMQP/Kafka")
Rel("Centralized Schema Registry", "Message Broker", "Provides schema validation for events published across", "AMQP/Kafka with TLS and Envelope Encryption")

@enduml