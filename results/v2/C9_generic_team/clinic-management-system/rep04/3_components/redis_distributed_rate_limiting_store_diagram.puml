@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Redis Distributed Rate Limiting Store container

Container_Boundary(redis_store, "Redis Distributed Rate Limiting Store") {
    Component(Rate_Limiting_Engine, "Rate Limiting Engine", "Lua Scripts", "Executes atomically within Redis for Token Bucket and Sliding Window algorithms to enforce low-latency rate limits.")
    Component(Caching_Store, "Caching Store", "Redis In-Memory Store", "Provides low-latency ephemeral caching and offloads ephemeral state from transactional databases.")
    Component(Metrics_Exporter, "Metrics Exporter", "OpenTelemetry / Redis Metrics", "Exposes Redis performance metrics such as evicted_keys and used_memory_rss for scraping via HTTP/gRPC.")
}

Rel(Rate_Limiting_Engine, Caching_Store, "Reads and writes rate limit state atomically using", "RESP")
Rel(Metrics_Exporter, Caching_Store, "Scrapes telemetry and performance metrics from", "HTTP/gRPC")

@enduml