@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Archival Worker container

Container_Boundary(data_archival_worker_container, "Data Archival Worker") {
    Component(Data_Archival_Worker, "Data Archival Worker", "Kubernetes CronJob / Persistent Worker Pool", "Batch processor utilizing chunk-based processing, idempotency keys, and resource throttling to secure and offload historical clinical data.")
    Component(Cold_Storage, "Cold Storage", "AWS Glacier (or on-prem equivalent) via AES-256", "Secure long-term storage destination for 10-year data retention.")
    Component(Dead_Letter_Queue_DLQ, "Dead Letter Queue (DLQ)", "Queue / Message Broker", "Error handling queue for failed archival batches.")
    Component(Audit_Logging_Container, "Audit Logging Container", "AMQP/Kafka", "Destination for cryptographic checksums, compliance traces, and structured audit events.")
    Component(Observability_Container, "Observability Container", "Prometheus", "Exporter tracking batch processing duration, throughput, and DLQ depth.")
    Component(Secret_Management_Sidecar, "Secret Management Sidecar", "Kubernetes sidecar / Local IPC / Volume mounts", "Supplies configuration and encryption credentials.")
}

Rel(Data_Archival_Worker, Cold_Storage, "Streams encrypted, compressed payloads", "HTTPS/TLS and AES-256")
Rel(Data_Archival_Worker, Audit_Logging_Container, "Emits structured events and correlation IDs", "AMQP/Kafka")
Rel(Data_Archival_Worker, Observability_Container, "Exposes metrics", "Prometheus scraping")
Rel(Data_Archival_Worker, Secret_Management_Sidecar, "Fetches keys and configs", "local IPC/Volume mounts")

@enduml