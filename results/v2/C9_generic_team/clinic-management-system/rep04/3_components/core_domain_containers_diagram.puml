@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Domain Containers container

Container_Boundary(core_domain_containers, "Core Domain Containers") {
    Component(Patient Admission Controller, "Patient Admission Controller", "gRPC/REST, Kubernetes", "Handles patient admission workflows and requests.")
    Component(EMR Service, "EMR Service", "gRPC/REST, Kubernetes", "Manages electronic medical records with <1s load times.")
    Component(Scheduling Service, "Scheduling Service", "gRPC/REST, Kubernetes", "Manages appointments and resource scheduling.")
    Component(Billing Service, "Billing Service", "gRPC/REST, Kubernetes", "Processes billing and financial transactions.")
}

Rel(Patient Admission Controller, EMR Service, "Routes admission data", "gRPC")
Rel(EMR Service, Scheduling Service, "Coordinates appointments", "gRPC")
Rel(Scheduling Service, Billing Service, "Triggers billing events", "gRPC")

@enduml