@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Request_Router, "Request Router", "Reverse Proxy / API Gateway Engine", "Routes incoming requests from the Frontend Container to the Core Domain Containers using internal gRPC/REST.")
    Component(Authentication_Authorization_Module, "Authentication & Authorization Module", "JWT & MFA Validator", "Validates JWT tokens and multi-factor authentication for all incoming HTTPS requests.")
    Component(Rate_Limiting_Module, "Rate Limiting Module", "Redis Rate Limiter Client", "Enforces edge throttling using the Redis Distributed Rate Limiting Store.")
}

Rel(Request_Router, Authentication_Authorization_Module, "Delegates request validation")
Rel(Request_Router, Rate_Limiting_Module, "Checks rate limits")
@enduml