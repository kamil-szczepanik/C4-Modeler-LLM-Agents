@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(database_migration_container, "Database Migration Container") {
    Component(Migration_Execution_Engine, "Migration Execution Engine", "Kubernetes Job / Helm Hooks", "Executes declarative, version-locked database schema updates during deployments using least-privilege credentials.")
    Component(Distributed_Lock_Manager, "Distributed Lock Manager", "Distributed Advisory Locks", "Enforces single-instance migration execution in multi-replica Kubernetes environments.")
    Component(Pre_deployment_Validation_Worker, "Pre-deployment Validation Worker", "Init Containers", "Manages explicit dependency ordering to ensure migrations finish before core application traffic routes.")
}

Rel(Migration_Execution_Engine, Distributed_Lock_Manager, "Acquires locks via", "")
Rel(Pre_deployment_Validation_Worker, Migration_Execution_Engine, "Blocks application startup until completion of", "")

@enduml