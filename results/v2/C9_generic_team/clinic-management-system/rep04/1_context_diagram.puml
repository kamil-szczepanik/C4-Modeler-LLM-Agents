@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Hospital_Staff_and_Patients, "Hospital Staff and Patients", "Users who interact with the system for admissions, electronic medical records, scheduling, and billing.")
System(Clinic_Management_System, "Clinic Management System", "A hybrid cloud platform designed to manage patient admissions, electronic medical records (EMR), scheduling, and billing for medium-sized hospitals and clinics while enforcing strict healthcare compliance and interoperability standards.")
System_Ext(External_Lab_and_Imaging_Systems, "External Lab and Imaging Systems", "External systems that integrate via HL7 FHIR APIs through the Anti-Corruption Layer.")

Rel(Hospital_Staff_and_Patients, Clinic_Management_System, "Interact with the system for clinical operations via HTTPS/TLS using OAuth2/MFA", "HTTPS/TLS, OAuth2/MFA")
Rel(External_Lab_and_Imaging_Systems, Clinic_Management_System, "Integrate via HL7 FHIR APIs through the Anti-Corruption Layer", "HL7 FHIR APIs")

@enduml