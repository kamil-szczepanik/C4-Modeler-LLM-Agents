@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Hospital_Staff_and_Patients, "Hospital Staff and Patients", "Users who interact with the system for admissions, electronic medical records, scheduling, and billing.")
System_Ext(External_Lab_and_Imaging_Systems, "External Lab and Imaging Systems", "External systems that integrate via HL7 FHIR protocols over HTTPS.")

System_Boundary(Clinic_Management_System, "Clinic Management System") {
    Container(Frontend_Container, "Frontend Container", "HTTPS/TLS", "Provides the user interface for hospital staff and patients.")
    Container(API_Gateway, "API Gateway", "HTTPS, JWT/MFA", "Manages incoming requests, routing, and authentication validation.")
    Container(Core_Domain_Containers, "Core Domain Containers", "gRPC/REST, Kubernetes", "Manages core domain logic including Patient Registration, EMR, Scheduling, and Billing.")
    Container(Integration___FHIR_Adapter_Container, "Integration / FHIR Adapter Container", "HL7 FHIR, HTTPS", "Connects the system to external lab and imaging systems.")
    Container(Asynchronous_Event_Bus, "Asynchronous Event Bus", "Kafka/RabbitMQ, AMQP", "Handles asynchronous, decoupled event-driven workflows across containers.")
    Container(Audit_Logging___Compliance_Container, "Audit Logging & Compliance Container", "AES-256", "Ensures HIPAA/GDPR compliance and tracks audit logs.")
    Container(Observability_Container, "Observability Container", "OpenTelemetry", "Provides end-to-end distributed tracing and metrics collection.")
    Container(Shared_Configuration___Secret_Management_Sidecar, "Shared Configuration & Secret Management Sidecar", "Kubernetes Sidecar", "Manages shared configurations and secrets securely.")
    Container(Database_Migration_Container, "Database Migration Container", "Kubernetes Job", "Handles database migrations during deployments.")
    Container(Data_Archival_Worker, "Data Archival Worker", "Background Worker", "Manages long-term data archival tasks.")
    Container(Redis_Distributed_Rate_Limiting_Store, "Redis Distributed Rate Limiting Store", "Redis", "Provides distributed rate limiting and low-latency caching.")
}

Rel(Hospital_Staff_and_Patients, Frontend_Container, "Interact with the frontend via HTTPS/TLS", "HTTPS/TLS")
Rel(Frontend_Container, API_Gateway, "Communicates and sends API requests via HTTPS with JWT/MFA validation", "HTTPS, JWT/MFA")
Rel(API_Gateway, Core_Domain_Containers, "Routes requests to core domain services", "internal gRPC/REST")
Rel(Core_Domain_Containers, Asynchronous_Event_Bus, "Publish and consume events", "AMQP/Kafka")
Rel(Integration___FHIR_Adapter_Container, External_Lab_and_Imaging_Systems, "Connects and exchanges health data", "HL7 FHIR protocols over HTTPS")

@enduml