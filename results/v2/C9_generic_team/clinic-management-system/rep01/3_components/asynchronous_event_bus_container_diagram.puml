@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Asynchronous Event Bus Container container

Container_Boundary(asynchronous_event_bus_container, "Asynchronous Event Bus Container") {
    Component(Event_Broker_Core, "Event Broker Core", "Apache Kafka / RabbitMQ", "Handles durable, decoupled asynchronous event-driven communication for core clinical microservices.")
    Component(Schema_Registry, "Schema Registry", "Avro / JSON Schema Registry", "Manages schema and payload structures for event-driven messaging.")
    Component(Claims_Check_Store, "Claims Check Store", "Object Storage / Distributed Cache", "Handles offloading and retrieval of large medical imaging payloads using the Claims Check pattern.")
}

Rel(Event_Broker_Core, Schema_Registry, "Validates event payload schemas via")
Rel(Event_Broker_Core, Claims_Check_Store, "References large medical imaging payloads via")
@enduml