@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Domain Containers container

Container_Boundary(core_domain_containers, "Core Domain Containers") {
    Component(Patient_Registration_Component, "Patient Registration Component", "Microservice / Kubernetes Pod", "Manages patient admissions and registration data.")
    Component(Appointment_Scheduling_Component, "Appointment Scheduling Component", "Microservice / Kubernetes Pod", "Handles scheduling for patient appointments.")
    Component(EMR_Component, "EMR Component", "Microservice / Kubernetes Pod", "Manages electronic medical records ensuring high availability and sub-second response times.")
    Component(Billing_Component, "Billing Component", "Microservice / Kubernetes Pod", "Handles billing and financial transactions for healthcare facilities.")
}

Rel(Patient_Registration_Component, Appointment_Scheduling_Component, "Coordinates patient details for scheduling", "HTTPS")
Rel(Appointment_Scheduling_Component, EMR_Component, "Links appointments with electronic medical records", "HTTPS")
Rel(EMR_Component, Billing_Component, "Triggers billing events based on medical services", "Async")

@enduml