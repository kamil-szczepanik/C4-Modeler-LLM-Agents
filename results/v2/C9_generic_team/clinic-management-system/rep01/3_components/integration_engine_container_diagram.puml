@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Integration Engine Container", "Integration Engine Container") {
    Component("HL7 FHIR Translator", "HL7 FHIR Translator", "Java / Spring Boot with Stateless Integration Engine", "Translates and processes clinical data formats into standard HL7 FHIR APIs for external lab and imaging systems.")
    Component("Translation Event Router", "Translation Event Router", "Kafka Client / Resilience4j", "Routes translation events to the event bus and handles fault tolerance with circuit breaking.")
    Component("Cache Lookup Manager", "Cache Lookup Manager", "Redis Client", "Performs distributed caching lookups for stateless translation processes.")
}

Rel("HL7 FHIR Translator", "Translation Event Router", "Sends translation events and manages Dead Letter Queues", "Kafka Protocol")
Rel("HL7 FHIR Translator", "Cache Lookup Manager", "Performs translation lookups", "Redis")
@enduml