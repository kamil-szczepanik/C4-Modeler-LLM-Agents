@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Shared Observability & Telemetry Container", "Shared Observability & Telemetry Container") {
    Component("Prometheus", "Prometheus", "Prometheus", "Collects metrics and time-series data from all containers.")
    Component("Fluentbit", "Fluentbit", "Fluentbit", "Gathers, scrubs, and forwards audit logs and telemetry data.")
    Component("OpenTelemetry", "OpenTelemetry", "OpenTelemetry", "Provides distributed tracing across microservices.")
}

Rel("OpenTelemetry", "Prometheus", "Sends distributed tracing metrics")
Rel("Fluentbit", "Prometheus", "Forwards structured log data")

@enduml