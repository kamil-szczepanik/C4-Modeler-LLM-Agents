@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Access & Governance Container Layer container

Container_Boundary("Data Access & Governance Container Layer", "Data Access & Governance Container Layer") {
    Component(Storage_Management_Layer, "Storage Management Layer", "PostgreSQL / Distributed SQL with AES-256", "Executes storage queries and manages data persistence with strict adherence to HIPAA, GDPR, and 10-year retention rules using AES-256 encryption.")
    Component(Audit_Trail_Manager, "Audit Trail Manager", "Security Governance Service", "Maintains automated audit trails for all data access and mutations to satisfy regulatory compliance.")
}

Rel(Storage_Management_Layer, Audit_Trail_Manager, "Logs data access and mutation queries", "Internal API")

@enduml