@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway / Reverse Proxy Container container

Container_Boundary(api_gateway, "API Gateway / Reverse Proxy Container") {
    Component(Edge_Routing_TLS_Termination_Component, "Edge Routing & TLS Termination Component", "Reverse Proxy / Ingress Controller", "Handles incoming HTTPS traffic, performs TLS termination, and routes validated requests to appropriate downstream microservices.")
    Component(Schema_Validation_Security_Component, "Schema Validation & Security Component", "API Gateway Middleware", "Enforces input schema validation, rate limiting, user context propagation, and circuit breaking.")
    Component(Error_Standardization_Component, "Error Standardization Component", "RFC 7807 Middleware", "Standardizes API error responses according to RFC 7807 for consistent client handling.")
}

Rel(Edge_Routing_TLS_Termination_Component, Schema_Validation_Security_Component, "Routes terminated HTTPS traffic for validation and security checks", "HTTPS")
Rel(Schema_Validation_Security_Component, Error_Standardization_Component, "Delegates error formatting when validation or circuit breaking fails", "Internal API Call")

@enduml