@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(config_secrets_sidecar, "Configuration and Secrets Management Sidecar") {
    Component(Secrets Management Engine, "Secrets Management Engine", "HashiCorp Vault / Kubernetes Secrets", "Secure backend for encrypted configuration and credential management.")
    Component(Local Configuration Parser, "Local Configuration Parser", "JSON Schema", "Typed validation contracts for local configuration parsing.")
    Component(IPC Handler, "IPC Handler", "Unix Domain Sockets", "Handles secure intra-pod communication between sidecar and core containers.")
}

Rel(Local Configuration Parser, Secrets Management Engine, "Interacts with upstream secrets using HTTPS", "HTTPS")
Rel(IPC Handler, Local Configuration Parser, "Provides validated configuration over restricted local loopback", "Unix Domain Sockets")
@enduml