@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Clinic Management System

Person(Users, "Patients, Practitioners, and Billing Staff", "System users who interface with the platform to manage administration, clinical workflows, and billing.")
System_Ext(ExternalLabs, "External Lab and Imaging Systems", "External healthcare systems that integrate via HL7 FHIR APIs to exchange clinical data.")

System_Boundary(ClinicSystem, "Clinic Management System") {
    System(ApiGateway, "API Gateway / Edge Routing", "Unified ingress boundary handling incoming HTTPS and MFA traffic.")
    System(Iam, "Centralized Identity and Access Management", "IdP and Zero-Trust Policy Enforcement boundary for unified multi-factor auth, RBAC, and secure key rotation.")
    System(EventBus, "Asynchronous Event Bus", "Durable messaging backbone for decoupled, asynchronous inter-subsystem communication.")
    System(CoreClinical, "Core Clinical Subsystems", "Patient Registration, Scheduling, EMR, and Billing subsystems.")
    System(Telemetry, "Telemetry and Observability Plane", "Unified logging, metrics, and tracing plane ingesting data from all components.")
    System(ConfigSecrets, "Configuration and Secret Management Boundary", "Cryptographic key and config store implementing AES-256 for data at rest.")
}

Rel(Users, ApiGateway, "Interface with the system via HTTPS and Multi-Factor Authentication (MFA)", "HTTPS, MFA")
Rel(ExternalLabs, ApiGateway, "Integrate into the system for clinical data exchange", "HL7 FHIR over TLS")
Rel(ApiGateway, Iam, "Enforces zero-trust access policies across all API Gateway routes", "Zero-Trust Policies, IdP")
Rel(CoreClinical, EventBus, "Communicate asynchronously across the hybrid boundary using durable message queues", "Distributed Event Bus")
Rel(Telemetry, CoreClinical, "Ingests logs, traces, and metrics from on-premise Kubernetes and AWS components", "Kubernetes Telemetry")

@enduml