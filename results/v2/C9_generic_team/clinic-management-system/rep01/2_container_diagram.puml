@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Users, "Patients, Practitioners, and Billing Staff", "System users who interface with the platform to manage administration, clinical workflows, and billing.")
System_Ext(ExternalSystems, "External Lab and Imaging Systems", "External healthcare systems that integrate via HL7 FHIR APIs to exchange clinical data.")

System_Boundary(ClinicManagementSystem, "Clinic Management System") {
    Container(ApiGateway, "API Gateway / Reverse Proxy Container", "Reverse Proxy / API Gateway", "Unified ingress boundary handling incoming HTTPS and MFA traffic.")
    Container(CoreDomains, "Core Domain Containers", "Microservices / Kubernetes", "Handles Patient Registration, Scheduling, EMR, and Billing subsystems.")
    Container(IntegrationEngine, "Integration Engine Container", "HL7 FHIR translator", "Translates and connects core domains to external lab and imaging systems using HL7 FHIR APIs.")
    Container(DataAccess, "Data Access & Governance Container Layer", "Storage Management Layer with AES-256", "Exclusive storage query router ensuring data security and compliance.")
    Container(EventBus, "Asynchronous Event Bus Container", "Kafka / RabbitMQ", "Durable messaging backbone for decoupled, asynchronous inter-subsystem communication using AsyncAPI event payloads.")
    Container(Observability, "Shared Observability & Telemetry Container", "Prometheus, Fluentbit, OpenTelemetry", "Distributed tracing, metrics, and immutable audit logs.")
    Container(ConfigSecrets, "Configuration and Secrets Management Container / Sidecar", "Vault / Kubernetes Secrets", "Cryptographic key and config store implementing secure secret management.")
}

Rel(Users, ApiGateway, "Access the system via HTTPS/MFA", "HTTPS, MFA")
Rel(ApiGateway, CoreDomains, "Routes ingress traffic to core domain services", "HTTPS")
Rel(CoreDomains, EventBus, "Communicate asynchronously using event payloads", "AsyncAPI, Kafka / RabbitMQ")
Rel(IntegrationEngine, ExternalSystems, "Connects to external systems for clinical data exchange", "HL7 FHIR APIs")
Rel(CoreDomains, DataAccess, "Route storage queries exclusively through the governance layer", "AES-256 Encryption")

@enduml