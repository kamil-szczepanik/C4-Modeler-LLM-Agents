@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the HashiCorp Vault container

Container_Boundary(vault_container, "HashiCorp Vault") {
    Component(vault_server, "Vault Server", "HashiCorp Vault / Go", "Centralized secrets management server providing dynamic database credentials, encryption services, and authentication methods.")
    Component(vault_agent_sidecar, "Vault Agent Sidecar", "Vault Agent / Kubernetes Sidecar", "Local caching and template rendering agent using tmpfs volumes to securely fetch and cache encrypted configurations and secrets.")
    Component(vault_policy_and_mount_manager, "Vault Policy and Mount Manager", "Terraform", "Declarative configuration management tool for defining and provisioning Vault policies, secret engines, and authentication mounts.")
}

Rel(vault_agent_sidecar, vault_server, "Authenticates and fetches secrets via Kubernetes Auth Method and HTTPS", "HTTPS / Vault Agent API")
Rel(vault_policy_and_mount_manager, vault_server, "Configures policies and mounts declaratively", "Terraform / API")

@enduml