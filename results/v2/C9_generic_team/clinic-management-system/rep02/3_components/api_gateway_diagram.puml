@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(Kubernetes_Ingress, "Kubernetes Ingress", "Kubernetes Ingress / Reverse Proxy", "Manages external access to services, enforcing HTTPS, routing, and compliance.")
}

System_Ext(Patient_EMR_Service, "Patient/EMR Service", "Domain service for patient and EMR management")
System_Ext(Scheduling_Service, "Scheduling Service", "Domain service for scheduling")
System_Ext(Billing_Service, "Billing Service", "Domain service for billing")

Rel(Kubernetes_Ingress, Patient_EMR_Service, "Routes internal domain requests", "gRPC / REST via mTLS")
Rel(Kubernetes_Ingress, Scheduling_Service, "Routes internal domain requests", "gRPC / REST via mTLS")
Rel(Kubernetes_Ingress, Billing_Service, "Routes internal domain requests", "gRPC / REST via mTLS")

@enduml