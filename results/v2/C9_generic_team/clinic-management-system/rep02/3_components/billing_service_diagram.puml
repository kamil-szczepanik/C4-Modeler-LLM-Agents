@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(billing_service, "Billing Service") {
    Component(BillingController, "Billing Controller", "REST / gRPC API", "Handles incoming billing requests and routes them from the API Gateway.")
    Component(BillingProcessingService, "Billing Processing Service", "Microservice Business Logic, Java / Go", "Implements domain logic, transactional outbox pattern, CQRS, and financial data consistency.")
    Component(InsuranceIntegrationAdapter, "Insurance Integration Adapter", "HTTPS / HL7 FHIR APIs", "Submits insurance claims to third-party insurance gateways.")
    Component(SecretsManagementClient, "Secrets Management Client", "HTTPS / Vault API", "Retrieves encrypted configurations and secrets from HashiCorp Vault.")
}

Rel(BillingController, BillingProcessingService, "Delegates business logic execution", "Internal")
Rel(BillingProcessingService, InsuranceIntegrationAdapter, "Submits claims", "HTTPS / HL7 FHIR APIs")
Rel(BillingProcessingService, SecretsManagementClient, "Fetches encrypted secrets", "Vault API")

@enduml