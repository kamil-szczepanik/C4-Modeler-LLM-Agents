@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component Diagram for Observability & Security Sidecars

Container_Boundary(observability_security_sidecars, "Observability & Security Sidecars") {
    Component(OpenTelemetry_Collector_Sidecar, "OpenTelemetry Collector Sidecar", "OpenTelemetry", "Collects traces and metrics asynchronously via local Unix domain sockets.")
    Component(Envoy_Proxy_Sidecar, "Envoy Proxy Sidecar", "Envoy", "Handles internal microservice communication via gRPC and REST with mTLS.")
    Component(Falco_Trivy_DaemonSets, "Falco & Trivy DaemonSets", "Falco & Trivy", "Performs node-level runtime security and vulnerability scanning.")
}

Rel(OpenTelemetry_Collector_Sidecar, Envoy_Proxy_Sidecar, "Monitors and intercepts telemetry data from proxy operations.")
Rel(Envoy_Proxy_Sidecar, Falco_Trivy_DaemonSets, "Coordinates with node security agents for secure traffic routing.")

@enduml