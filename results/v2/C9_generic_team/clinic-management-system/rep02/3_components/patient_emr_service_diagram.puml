@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(patient_emr_service, "Patient/EMR Service") {
    Component(EMR Controller, "EMR Controller", "Kubernetes Microservice Component / REST & gRPC API", "Handles incoming routing requests from the API Gateway and exposes endpoints for patient admissions and EMR operations.")
    Component(EMR Business Logic Handler, "EMR Business Logic Handler", "Golang / Java Microservice Logic", "Executes core clinical workflows, manages patient data, and applies PII/PHI masking.")
    Component(Cache Manager, "Cache Manager", "Redis Client", "Interfaces with the Distributed Cache (Redis) to cache data for low latency and <1s P95 screen load performance.")
    Component(Event Publisher, "Event Publisher", "Kafka / RabbitMQ Client", "Publishes asynchronous events to the Message Broker.")
    Component(External Integration Client, "External Integration Client", "HTTPS / HL7 FHIR APIs with Circuit Breakers", "Connects securely to third-party Lab/Imaging Systems and Insurance Gateways.")
    Component(Secret Manager Client, "Secret Manager Client", "HashiCorp Vault API / HTTPS", "Retrieves secrets and handles fail-fast startup validation.")
}

Rel(EMR Controller, EMR Business Logic Handler, "Delegates requests")
Rel(EMR Business Logic Handler, Cache Manager, "Caches data for low latency", "Redis Protocol")
Rel(EMR Business Logic Handler, Event Publisher, "Asynchronous event publishing", "Kafka / RabbitMQ")
Rel(EMR Business Logic Handler, External Integration Client, "Connects via circuit breakers", "HTTPS / HL7 FHIR APIs")
Rel(EMR Business Logic Handler, Secret Manager Client, "Retrieves secrets", "HTTPS / Vault API")

@enduml