@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(message_broker, "Message Broker") {
    Component(Event_Producer, "Event Producer", "Kafka Producer / RabbitMQ Publisher", "Publishes asynchronous HL7 FHIR payloads and insurance claims from the Patient/EMR and Billing services using TLS 1.3 and SASL/SCRAM ACLs.")
    Component(Event_Consumer, "Event Consumer", "Kafka Consumer / RabbitMQ Subscriber", "Consumes asynchronous events and payloads across services with `patient_id` partitioning.")
    Component(Schema_Registry, "Schema Registry", "Apache Kafka Schema Registry", "Enforces structural validation and serialization schemas for event payloads.")
    Component(Dead_Letter_Queues_DLQs, "Dead Letter Queues (DLQs)", "Kafka / RabbitMQ DLQ Mechanism", "Captures and stores failed or unprocessable event messages for auditing and error handling.")
}

Rel(Event_Producer, Schema_Registry, "Validates event schemas via", "")
Rel(Event_Producer, Event_Consumer, "Streams asynchronous events to", "")
Rel(Event_Consumer, Dead_Letter_Queues_DLQs, "Routes failed messages to", "")
@enduml