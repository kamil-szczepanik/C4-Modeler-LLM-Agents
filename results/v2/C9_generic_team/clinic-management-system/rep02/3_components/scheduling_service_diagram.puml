@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Scheduling Service container

Container_Boundary(scheduling_service, "Scheduling Service") {
    Component(Scheduling_Controller, "Scheduling Controller", "gRPC / REST API", "Handles incoming appointment and availability requests routed from the API Gateway.")
    Component(Scheduling_Domain_Service, "Scheduling Domain Service", "Business Logic / CQRS Pattern", "Executes core clinical workflows, resource clash checks, and orchestrates transactional writes using Optimistic Concurrency Control.")
    Component(Outbox_Processor, "Outbox Processor", "Transactional Outbox Pattern", "Guarantees at-least-once asynchronous event delivery without dual-write inconsistencies.")
    Component(Cache_Repository, "Cache Repository", "Redis Protocol", "Interacts with the Distributed Cache to cache scheduling data and read models for high-throughput read operations.")
    Component(Event_Publisher, "Event Publisher", "Kafka / AMQP", "Publishes asynchronous domain events to the Message Broker for downstream consumers like Billing and EMR services.")
    Component(Secrets_Manager_Client, "Secrets Manager Client", "HTTPS / Vault API", "Retrieves encrypted configurations and secrets dynamically from HashiCorp Vault.")
}

Rel(Scheduling_Controller, Scheduling_Domain_Service, "Delegates appointment and availability requests")
Rel(Scheduling_Domain_Service, Cache_Repository, "Reads and writes cached scheduling data and read models")
Rel(Scheduling_Domain_Service, Outbox_Processor, "Stores domain events transactionally for reliable publishing")
Rel(Outbox_Processor, Event_Publisher, "Dispatches domain events")
Rel(Scheduling_Domain_Service, Secrets_Manager_Client, "Fetches encrypted runtime configurations and secrets")

@enduml