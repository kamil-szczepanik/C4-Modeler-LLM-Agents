@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Distributed Cache container

System_Ext(PatientEMRService, "Patient/EMR Service", "External microservice accessing clinical data cache.")
System_Ext(SchedulingService, "Scheduling Service", "External microservice accessing resource lock manager.")
System_Ext(BillingService, "Billing Service", "External microservice accessing transaction idempotency store.")

Container_Boundary(DistributedCache, "Distributed Cache") {
    Component(ClinicalDataCacheManager, "Clinical Data Cache Manager", "Redis Protocol with TLS encryption", "Caches clinical data for low latency and sub-second EMR access.")
    Component(ResourceLockManager, "Resource Lock Manager", "Redis Protocol with TLS encryption", "Manages resource locks and scheduling data caching.")
    Component(TransactionIdempotencyStore, "Transaction Idempotency Store", "Redis Protocol", "Stores idempotency keys for billing transaction safety.")
}

Rel(PatientEMRService, ClinicalDataCacheManager, "Caches clinical data for low latency", "Redis Protocol with TLS encryption")
Rel(SchedulingService, ResourceLockManager, "Manages resource locks and caching", "Redis Protocol with TLS encryption")
Rel(BillingService, TransactionIdempotencyStore, "Stores idempotency keys for transaction safety", "Redis Protocol")

@enduml