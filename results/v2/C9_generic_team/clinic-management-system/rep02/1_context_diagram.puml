@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Clinic Management System

Person(Patients, "Patients", "Patients accessing the system for admissions, scheduling, and medical records via Multi-Factor Authentication (MFA).")
Person(Doctors, "Doctors", "Medical doctors accessing electronic medical records and scheduling tools via Multi-Factor Authentication (MFA).")
Person("Billing Staff", "Billing Staff", "Billing staff managing patient billing and insurance claims via Multi-Factor Authentication (MFA).")

System("Clinic Management System", "Clinic Management System", "A hybrid clinical IT platform that manages patient admissions, electronic medical records (EMR), scheduling, and billing while ensuring HIPAA and GDPR compliance, 99.99% uptime, and long-term data retention.")

System_Ext("Third-party Insurance Gateways", "Third-party Insurance Gateways", "External systems used to submit billing claims asynchronously.")
System_Ext("Lab/Imaging Systems", "Lab/Imaging Systems", "External systems that exchange medical data using HL7 FHIR standards.")
System_Ext("External Identity Providers", "External Identity Providers", "External identity providers used for authentication and access control.")

Rel(Patients, "Clinic Management System", "Access applications via HTTPS/TLS with enforced MFA", "HTTPS/TLS, MFA")
Rel(Doctors, "Clinic Management System", "Access applications via HTTPS/TLS with enforced MFA", "HTTPS/TLS, MFA")
Rel("Billing Staff", "Clinic Management System", "Access applications via HTTPS/TLS with enforced MFA", "HTTPS/TLS, MFA")
Rel("Clinic Management System", "Lab/Imaging Systems", "Exchange medical data via HL7 FHIR APIs over HTTPS", "HL7 FHIR, HTTPS")
Rel("Clinic Management System", "Third-party Insurance Gateways", "Submit billing claims asynchronously using REST/SOAP with backpressure and circuit breakers", "REST/SOAP")
Rel("Clinic Management System", "External Identity Providers", "Authenticate users and manage access control", "HTTPS/OAuth/OIDC")

@enduml