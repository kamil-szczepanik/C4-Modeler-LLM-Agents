@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Patients, "Patients", "Individuals receiving care, managing appointments, and viewing their medical records.")
Person(Clinicians, "Clinicians", "Medical professionals responsible for patient diagnosis, treatment, and EMR management.")
Person(AdministrativeStaff, "Administrative Staff", "Staff members handling patient admissions and scheduling.")
Person(BillingOfficers, "Billing Officers", "Personnel managing patient billing and insurance claims.")
Person(Auditors, "Auditors", "Personnel ensuring regulatory compliance and reviewing audit logs.")

System_Ext(ExternalInsuranceClearinghouses, "External Insurance Clearinghouses", "External systems used for real-time claim adjudication.")
System_Ext(ExternalLabsImaging, "External Labs/Imaging", "External systems providing lab results and medical imaging data.")

System_Boundary(ClinicManagementSystem, "Clinic Management System") {
    Container(WebApplication, "Web Application", "React / TypeScript", "Responsive web interface for patients, clinicians, and staff.")
    Container(APIGateway, "API Gateway", "NGINX / Envoy", "Edge ingress handling rate limiting, routing, and JWT validation.")
    Container(EMRService, "EMR Service", "Node.js / Go", "Manages electronic medical records and clinical workflows.")
    Container(BillingClaimsService, "Billing & Claims Service", "Java / Spring Boot", "Handles patient billing and insurance claims.")
    Container(SchedulingService, "Scheduling Service", "Node.js / Go", "Manages patient admissions and appointment scheduling.")
    Container(NotificationService, "Notification Service", "Python / FastAPI", "Handles system notifications and alerts.")
    Container(IntegrationService, "Integration Service", "Java / Spring Boot", "Connects via HL7 FHIR APIs to external lab systems and clearinghouses.")
    
    ContainerDb(PostgreSQL, "PostgreSQL", "PostgreSQL with AES-256", "Persistent relational data storage for core services.")
    ContainerDb(Redis, "Redis", "Redis", "Caching layer for scheduling and real-time data.")
    ContainerDb(RabbitMQ, "RabbitMQ", "RabbitMQ Message Broker", "Asynchronous messaging backbone for microservices.")
    Container(HashiCorpVault, "HashiCorp Vault", "HashiCorp Vault", "Secrets management and secure credential storage.")
}

Rel(Patients, WebApplication, "Accesses appointments and records", "HTTPS")
Rel(Clinicians, WebApplication, "Manages EMR and clinical workflows", "HTTPS")
Rel(AdministrativeStaff, WebApplication, "Manages admissions and scheduling", "HTTPS")
Rel(BillingOfficers, WebApplication, "Manages billing and claims", "HTTPS")
Rel(Auditors, WebApplication, "Reviews compliance and logs", "HTTPS")

Rel(WebApplication, APIGateway, "Sends client requests", "HTTPS")

Rel(APIGateway, EMRService, "Routes EMR requests", "REST / JSON over HTTPS")
Rel(APIGateway, BillingClaimsService, "Routes billing requests", "REST / JSON over HTTPS")
Rel(APIGateway, SchedulingService, "Routes scheduling requests", "REST / JSON over HTTPS")
Rel(APIGateway, NotificationService, "Routes notification requests", "REST / JSON over HTTPS")
Rel(APIGateway, IntegrationService, "Routes integration requests", "REST / JSON over HTTPS")

Rel(EMRService, RabbitMQ, "Publishes and consumes clinical events", "AMQP")
Rel(BillingClaimsService, RabbitMQ, "Publishes and consumes billing events", "AMQP")
Rel(SchedulingService, RabbitMQ, "Publishes and consumes scheduling events", "AMQP")
Rel(NotificationService, RabbitMQ, "Consumes notification events", "AMQP")

Rel(EMRService, PostgreSQL, "Reads and writes EMR data", "SQL / TLS")
Rel(BillingClaimsService, PostgreSQL, "Reads and writes billing data", "SQL / TLS")
Rel(SchedulingService, PostgreSQL, "Reads and writes scheduling data", "SQL / TLS")

Rel(SchedulingService, Redis, "Caches scheduling data", "Redis Protocol")

Rel(IntegrationService, ExternalLabsImaging, "Exchanges lab and imaging data", "HL7 FHIR over mTLS")
Rel(IntegrationService, ExternalInsuranceClearinghouses, "Performs real-time claim adjudication", "HL7 FHIR over mTLS")

Rel(EMRService, HashiCorpVault, "Fetches secrets", "API / TLS")
Rel(BillingClaimsService, HashiCorpVault, "Fetches secrets", "API / TLS")
Rel(SchedulingService, HashiCorpVault, "Fetches secrets", "API / TLS")
Rel(NotificationService, HashiCorpVault, "Fetches secrets", "API / TLS")
Rel(IntegrationService, HashiCorpVault, "Fetches secrets", "API / TLS")

@enduml