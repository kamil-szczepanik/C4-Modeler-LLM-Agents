@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "Individuals receiving care, managing appointments, and viewing their medical records.")
Person(Clinicians_Doctors, "Clinicians/Doctors", "Medical professionals responsible for patient diagnosis, treatment, and electronic medical records (EMR).")
Person(Administrative_Staff, "Administrative Staff", "Staff members handling patient admissions and scheduling.")
Person(Billing_Officers, "Billing Officers", "Personnel managing patient billing and insurance claims.")
Person(Compliance_Officers_Auditors, "Compliance Officers/Auditors", "Personnel ensuring regulatory compliance and reviewing immutable audit logs.")

System(Clinic_Management_System, "Clinic Management System", "A hybrid cloud platform designed for medium-sized hospitals and clinics to manage patient admissions, electronic medical records (EMR), scheduling, and billing with 99.99% high availability and strict HIPAA/GDPR compliance.")

System_Ext(External_Insurance_Clearinghouse_System, "External Insurance/Clearinghouse System", "External system used for real-time claim adjudication.")
System_Ext(External_Laboratory_Imaging_System, "External Laboratory & Imaging System", "External systems providing lab results and medical imaging data.")

Rel(Patients, Clinic_Management_System, "Accesses medical records and scheduling", "HTTPS/TLS 1.3 with OAuth 2.0/OIDC step-up MFA")
Rel(Clinicians_Doctors, Clinic_Management_System, "Manages EMR, patient admissions, and scheduling", "HTTPS/TLS 1.3 with OAuth 2.0/OIDC step-up MFA and RBAC/ABAC")
Rel(Administrative_Staff, Clinic_Management_System, "Manages patient admissions and scheduling", "HTTPS/TLS 1.3 with OAuth 2.0/OIDC step-up MFA and RBAC/ABAC")
Rel(Billing_Officers, Clinic_Management_System, "Handles financial operations and billing", "HTTPS/TLS 1.3 with OAuth 2.0/OIDC step-up MFA and RBAC/ABAC")
Rel(Compliance_Officers_Auditors, Clinic_Management_System, "Reviews audit logs and ensures compliance", "HTTPS/TLS 1.3 with OAuth 2.0/OIDC step-up MFA and RBAC/ABAC")
Rel(Clinic_Management_System, External_Insurance_Clearinghouse_System, "Real-time claim adjudication", "HTTPS / REST (HL7 FHIR)")
Rel(Clinic_Management_System, External_Laboratory_Imaging_System, "Exchanges lab and imaging data", "HL7 FHIR over mutual TLS (mTLS)")
@enduml