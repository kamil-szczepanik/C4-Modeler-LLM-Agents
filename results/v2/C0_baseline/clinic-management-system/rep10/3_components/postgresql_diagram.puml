@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL container

System_Ext(emr_service, "EMR Service", "Node.js / Go")
System_Ext(billing_service, "Billing & Claims Service", "Java / Spring Boot")
System_Ext(scheduling_service, "Scheduling Service", "Node.js / Go")

Container_Boundary(postgresql_container, "PostgreSQL") {
    Component(postgresql_engine, "PostgreSQL Engine", "PostgreSQL 15+ / Patroni / PgBouncer", "Core relational database handling current partition tables and transaction processing with high availability.")
    Component(postgresql_archive, "PostgreSQL Archive", "PostgreSQL 15+ / Foreign Data Wrapper", "Stores historical data accessed via read-only foreign tables (FDW) to meet data retention mandates.")
    Component(security_and_audit_extensions, "Security and Audit Extensions", "pgaudit / pgcrypto / CloudNativePG", "Provides immutable audit trails, column-level encryption for HIPAA/GDPR compliance, and automated backups/PITR.")
}

Rel(emr_service, postgresql_engine, "Reads/writes current partition tables via PgBouncer", "SQL / mTLS")
Rel(emr_service, postgresql_archive, "Reads historical data via read-only foreign tables (FDW)", "SQL / mTLS")
Rel(billing_service, postgresql_engine, "Reads and writes billing data via PgBouncer", "SQL / mTLS")
Rel(scheduling_service, postgresql_engine, "Reads and writes scheduling data via PgBouncer", "SQL / mTLS")

@enduml