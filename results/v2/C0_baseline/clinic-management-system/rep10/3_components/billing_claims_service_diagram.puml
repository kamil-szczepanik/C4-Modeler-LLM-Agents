@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing & Claims Service container

Container_Boundary(billing_and_claims_service, "Billing & Claims Service") {
    Component(Claim Generation Component, "Claim Generation Component", "Spring MVC / Domain Model", "Manages patient financial transactions and generates insurance claims.")
    Component(Claim Tracking Component, "Claim Tracking Component", "Spring Data JPA", "Tracks insurance claim lifecycles and queries status updates.")
    Component(Audit Trail Component, "Audit Trail Component", "Spring AOP / JDBC with Transactional Outbox", "Writes immutable audit logs ensuring compliance and traceability.")
    Component(Patient Payment Portal Component, "Patient Payment Portal Component", "Spring MVC / REST", "Handles patient payment transactions and statement reviews.")
    Component(PostgreSQL Database, "PostgreSQL Database", "PostgreSQL (AES-256 encrypted at rest)", "Persists billing records, PHI, audit logs, and payment transactions.")
    Component(RabbitMQ Message Broker, "RabbitMQ Message Broker", "AMQP", "Publishes claim status update events and payment success events.")
    Component(HashiCorp Vault, "HashiCorp Vault", "AppRole authentication", "Fetches secrets and API keys securely.")
    Component(Redis, "Redis", "RESP / TLS", "Validates idempotency keys for patient payment operations.")
}

Rel(Claim Generation Component, PostgreSQL Database, "Persists billing records and PHI", "JDBC / TLS")
Rel(Claim Tracking Component, RabbitMQ Message Broker, "Publishes claim status update events", "AMQP")
Rel(Audit Trail Component, PostgreSQL Database, "Writes immutable audit logs via Transactional Outbox", "JDBC / TLS")
Rel(Patient Payment Portal Component, PostgreSQL Database, "Reads statements and records payment transactions", "JDBC / TLS")
Rel(Patient Payment Portal Component, RabbitMQ Message Broker, "Publishes payment success events", "AMQP")
Rel(Patient Payment Portal Component, Redis, "Validates idempotency keys", "RESP / TLS")
Rel(billing_and_claims_service, HashiCorp Vault, "Fetches secrets and API keys", "API / TLS")

@enduml