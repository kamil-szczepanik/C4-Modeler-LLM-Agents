@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Edge_Ingress_Router, "Edge Ingress Router", "Envoy Proxy", "Handles edge ingress and routes incoming client requests from the Web Application.")
    Component(WAF_Protection_Module, "WAF Protection Module", "Envoy Proxy WAF Module", "Provides security filtering and web application firewall protection for low latency and security.")
    Component(Local_JWT_Validation_Module, "Local JWT Validation Module", "Envoy Proxy / HashiCorp Vault", "Validates local JWT tokens using public keys distributed by HashiCorp Vault.")
}

Rel(Edge_Ingress_Router, WAF_Protection_Module, "Inspects requests")
Rel(WAF_Protection_Module, Local_JWT_Validation_Module, "Authenticates requests")
@enduml