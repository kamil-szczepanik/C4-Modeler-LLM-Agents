@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(rabbitmq, "RabbitMQ") {
    Component(Exchange_Router, "Exchange Router", "RabbitMQ Exchange", "Routes published events from microservices to the appropriate downstream queues.")
    Component(Quorum_Queues, "Quorum Queues", "RabbitMQ Quorum Queue", "Provides reliable at-least-once messaging for asynchronous event-driven integration.")
    Component(Dead_Letter_Exchange, "Dead Letter Exchange", "RabbitMQ DLX", "Receives and forwards failed messages upon consumer rejection for audit and review.")
}

Rel(Exchange_Router, Quorum_Queues, "Routes messages", "AMQP")
Rel(Quorum_Queues, Dead_Letter_Exchange, "Forwards failed messages on consumer rejection", "AMQP")

@enduml