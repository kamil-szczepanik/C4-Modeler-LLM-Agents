@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(vault_container, "HashiCorp Vault") {
    Component(Auth_Method, "Auth Method", "Kubernetes JWT/AppRole & mTLS", "Handles authentication for users and services connecting to Vault.")
    Component(HTTP_API_Request_Router, "HTTP API / Request Router", "Vault HTTP API", "Routes incoming requests to the appropriate backend and engine.")
    Component(Secrets_Engine, "Secrets Engine", "Dynamic DB & KV", "Manages dynamic database credentials and key-value secrets storage.")
    Component(Transit_Secrets_Engine, "Transit Secrets Engine", "Vault Transit", "Provides encryption as a service for data protection.")
    Component(Audit_Device, "Audit Device", "Vault Audit", "Logs all requests and responses for security and compliance.")
    Component(Built_in_Raft_Storage_Backend, "Built-in Raft Storage Backend", "Raft Consensus Storage", "Provides highly available storage for Vault's data backend.")
}

Rel(HTTP_API_Request_Router, Secrets_Engine, "Forwards secret retrieval requests")
Rel(HTTP_API_Request_Router, Transit_Secrets_Engine, "Forwards encryption and decryption requests")
Rel(HTTP_API_Request_Router, Audit_Device, "Streams interaction logs")
Rel(Auth_Method, HTTP_API_Request_Router, "Authenticates incoming requests")
Rel(Secrets_Engine, Built_in_Raft_Storage_Backend, "Persists and retrieves secret data")
@enduml