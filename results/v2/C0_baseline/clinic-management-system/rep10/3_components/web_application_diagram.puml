@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application container

Container_Boundary(web_application, "Web Application") {
    Component(Persona-based UI Composition Engine, "Persona-based UI Composition Engine", "React / TypeScript SPA", "Renders high-performance dynamic interfaces for patients, clinicians, staff, billing officers, and auditors.")
    Component(EMR Rendering Module, "EMR Rendering Module", "React / TypeScript SPA", "Handles high-performance EMR rendering ensuring sub-second P95 load times.")
    Component(Session and Auth Handler, "Session and Auth Handler", "TypeScript", "Manages secure session handling using HttpOnly, SameSite=Strict cookies without client-side token exposure.")
}

Rel(Persona-based UI Composition Engine, Session and Auth Handler, "Uses for authentication state and secure session management")
Rel(EMR Rendering Module, Persona-based UI Composition Engine, "Feeds rendered clinical workflows into the main UI")

@enduml