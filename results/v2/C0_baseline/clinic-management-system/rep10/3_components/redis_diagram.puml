@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Redis container

System_Ext(Scheduling_Service, "Scheduling Service", "External service that interacts with the cache.")
System_Ext(PostgreSQL_Database, "PostgreSQL Database", "Persistent storage for caching misses.")

Container_Boundary(Redis, "Redis") {
    Component(In_Memory_Data_Store_Component, "In-Memory Data Store Component", "Redis Enterprise / OSS (Redis Protocol)", "Manages ephemeral caching for high-performance appointment booking and resource locks.")
    Component(TLS_Termination_Encryption_Proxy_Component, "TLS Termination & Encryption Proxy Component", "Redis Stunnel / Envoy sidecar", "Enforces mTLS and AES-256 encryption in transit.")
}

Rel(Scheduling_Service, In_Memory_Data_Store_Component, "Checks and acquires resource locks", "Redis Protocol over TLS, TCP 6379")
Rel(In_Memory_Data_Store_Component, PostgreSQL_Database, "Cache-aside fallback for persistent scheduling misses", "SQL/TCP")
@enduml