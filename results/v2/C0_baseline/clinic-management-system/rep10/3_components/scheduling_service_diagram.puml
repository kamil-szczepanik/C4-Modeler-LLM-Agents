@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Scheduling Service container

Container_Boundary(scheduling_service, "Scheduling Service") {
    Component(API_Controller, "API Controller", "Go HTTP Server", "Handles incoming REST requests over HTTPS from the API Gateway.")
    Component(Clash_Service, "Clash Service", "Go Business Logic", "Executes sub-millisecond clash evaluation to prevent appointment race conditions and double-bookings.")
    Component(Broker_Client, "Broker Client", "Go AMQP Client", "Publishes audit and domain events asynchronously to RabbitMQ.")
}

Rel(API_Controller, Clash_Service, "Delegates appointment booking and clash evaluation", "")
Rel(Clash_Service, Broker_Client, "Triggers domain events upon scheduling actions", "")

@enduml