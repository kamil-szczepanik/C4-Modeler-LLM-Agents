@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System (CMS)

Person(Patient, "Patient", "End user receiving care, accessing personal health records, scheduling, and billing via web or mobile.")
Person(Clinician, "Clinician (Doctor/Nurse)", "Medical staff managing patient EMRs, admissions, and clinical workflows.")
Person(Receptionist, "Receptionist/Front Desk", "Staff handling patient check-ins, scheduling, and front desk operations.")
Person(BillingSpecialist, "Billing Specialist", "Staff managing financial transactions, billing, and insurance claims.")
Person(HospitalAdministrator, "Hospital Administrator", "Management staff overseeing system administration and hospital operations.")

System_Ext(IdP, "Identity Provider (IdP)", "External identity management system handling authentication and MFA.")
System_Ext(LabSystems, "External Lab & Imaging Systems", "External diagnostic systems for lab results and medical imaging.")
System_Ext(PaymentGateway, "Payment Gateway / Insurance Clearinghouse", "External financial systems for processing payments and insurance claims.")

System_Boundary(cms, "Clinic Management System (CMS)") {
    Container(FrontendSPAs, "Frontend SPAs", "React, Nginx", "Delivers responsive static UI containers for clinical and administrative workflows.")
    Container(EnvoyGateway, "Envoy API Gateway", "Envoy", "Manages ingress routing, rate limiting, circuit breaking, and strict mTLS service mesh security.")
    Container(DomainMicroservices, "Domain Microservices", "Spring Boot, Kubernetes, Istio", "Powers core domain microservices including Patient Registry, Scheduling, EMR, and Billing.")
    Container(IntegrationService, "Integration Service", "Node.js", "Integrates internal core services with external lab and imaging systems.")
    ContainerDb(DataTier, "Decoupled Data Tier", "AWS RDS PostgreSQL, On-premise clusters, WORM Storage", "Ensures secure, encrypted relational data storage and 10-year audit retention.")
}

Rel(Patient, FrontendSPAs, "Accesses patient portal and scheduling", "HTTPS (TLS 1.3)")
Rel(Clinician, FrontendSPAs, "Manages EMRs, admissions, and clinical workflows", "HTTPS (TLS 1.3)")
Rel(Receptionist, FrontendSPAs, "Manages patient admissions and scheduling", "HTTPS (TLS 1.3)")
Rel(BillingSpecialist, FrontendSPAs, "Processes billing and financial records", "HTTPS (TLS 1.3)")
Rel(HospitalAdministrator, FrontendSPAs, "Oversees system administration", "HTTPS (TLS 1.3)")

Rel(FrontendSPAs, EnvoyGateway, "Routes requests from client applications", "HTTPS / REST / JSON")
Rel(EnvoyGateway, DomainMicroservices, "Routes internal API traffic to microservices", "gRPC over mTLS (Istio)")
Rel(DomainMicroservices, DataTier, "Reads and writes relational data securely", "Encrypted database drivers (AES-256)")
Rel(IntegrationService, LabSystems, "Exchanges diagnostic data and lab results", "HL7 FHIR APIs")
Rel(DomainMicroservices, IdP, "Authenticates and authorizes users", "OAuth2/OIDC")

@enduml