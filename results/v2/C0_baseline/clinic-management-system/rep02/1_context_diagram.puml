@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patient, "Patient", "End user receiving care, accessing personal health records, scheduling, and billing via web or mobile.")
Person(Clinician, "Clinician (Doctor/Nurse)", "Medical staff managing patient EMRs, admissions, and clinical workflows.")
Person(Receptionist, "Receptionist/Front Desk", "Staff handling patient check-ins, scheduling, and front desk operations.")
Person(BillingSpecialist, "Billing Specialist", "Staff managing financial transactions, billing, and insurance claims.")
Person(HospitalAdministrator, "Hospital Administrator", "Management staff overseeing system administration and hospital operations.")

System(CMS, "Clinic Management System (CMS)", "Manages patient admissions, EMRs, scheduling, and billing for medium-sized hospitals and clinics with 99.99% availability and strict HIPAA/GDPR compliance.")

System_Ext(ExternalLab, "External Lab & Imaging Systems", "External diagnostic systems for lab results and medical imaging.")
System_Ext(PaymentGateway, "Payment Gateway / Insurance Clearinghouse", "External financial systems for processing payments and insurance claims.")
System_Ext(IdP, "Identity Provider (IdP)", "External identity management system handling authentication and MFA.")

Rel(Patient, CMS, "Accesses patient portal and scheduling", "HTTPS (Web/Mobile) through WAF")
Rel(Clinician, CMS, "Manages EMRs, admissions, and clinical workflows", "HTTPS (Web/Mobile) through WAF")
Rel(Receptionist, CMS, "Manages patient admissions and scheduling", "HTTPS (Web/Mobile) through WAF")
Rel(BillingSpecialist, CMS, "Processes billing and financial records", "HTTPS (Web/Mobile) through WAF")
Rel(HospitalAdministrator, CMS, "Oversees system administration", "HTTPS (Web/Mobile) through WAF")

Rel(CMS, IdP, "Authenticates users with OIDC/SAML 2.0 and MFA", "OIDC / SAML 2.0, TLS 1.3")
Rel(CMS, ExternalLab, "Integrates lab and imaging data", "HL7 FHIR APIs, TLS 1.3, mTLS")
Rel(CMS, PaymentGateway, "Processes payments and insurance claims", "REST, TLS 1.3, mTLS")
@enduml