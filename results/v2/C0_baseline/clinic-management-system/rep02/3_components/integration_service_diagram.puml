@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(integration_service, "Integration Service") {
    Component(FHIR Adapter, "FHIR Adapter", "NestJS, TypeScript", "Interfaces with external lab and imaging systems using HL7 FHIR with mTLS and OAuth2.")
    Component(Outbox Message Relay, "Outbox Message Relay", "BullMQ, Redis", "Executes the reliable outbox pattern and dispatches events asynchronously.")
    Component(Audit Logger, "Audit Logger", "Winston, OpenTelemetry", "Handles secure audit logging for compliance and monitoring.")
    Component(DLQ Alert Dispatcher, "DLQ Alert Dispatcher", "NestJS Event Emitter", "Dispatches alerts for dead-letter queue messages.")
}

Rel(Outbox Message Relay, FHIR Adapter, "Internal Function Call / Event Dispatch")
Rel(Outbox Message Relay, DLQ Alert Dispatcher, "Internal Event [Pub/Sub]")
Rel(DLQ Alert Dispatcher, Internal Notification Service, "REST/gRPC [Internal API]")

@enduml