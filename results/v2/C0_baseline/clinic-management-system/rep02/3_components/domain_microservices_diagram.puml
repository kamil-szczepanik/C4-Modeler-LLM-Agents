@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(domain_microservices, "Domain Microservices") {
    Component(PatientRegistryComponent, "Patient Registry Component", "Spring Boot, JPA", "Manages patient admissions and records.")
    Component(SchedulingEngine, "Scheduling Engine", "Spring Boot, Redis", "Handles scheduling and real-time resource clash checks using distributed locking.")
    Component(EMRCoreComponent, "EMR Core Component", "Spring Boot", "Manages electronic medical records and writes audit logs.")
    Component(BillingComponent, "Billing Component", "Spring Boot", "Manages billing for healthcare providers.")
    Component(EventBusPublisher, "Event Bus Publisher", "Spring Cloud Stream, Apache Kafka", "Publishes payload-encrypted events for asynchronous event messaging.")
    Component(AuthorizationPolicyEnforcementComponent, "Authorization & Policy Enforcement Component", "OPA sidecar, Spring Security", "Enforces strict security compliance and least-privilege RBAC/ABAC policies.")
}

Rel(PatientRegistryComponent, EventBusPublisher, "Publishes domain events", "Async/Kafka")
Rel(SchedulingEngine, EventBusPublisher, "Publishes scheduling events", "Async/Kafka")
Rel(EMRCoreComponent, EventBusPublisher, "Publishes EMR update events", "Async/Kafka")
Rel(BillingComponent, EventBusPublisher, "Publishes billing events", "Async/Kafka")
@enduml