@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Frontend SPAs container

System_Ext(Envoy_API_Gateway, "Envoy API Gateway", "External API Gateway")

Container_Boundary(Frontend_SPAs, "Frontend SPAs") {
    Component(Role_Based_UI_Modules, "Role-Based UI Modules", "React, Redux Toolkit", "Provides lazy-loaded, role-tailored feature bundles to meet performance requirements for patients, clinicians, and administrative staff.")
    Component(API_Client_Layer, "API Client Layer", "Axios, in-memory OIDC state", "Secures authentication tokens without vulnerable browser storage and communicates with backend services.")
    Component(Telemetry_Monitoring_Module, "Telemetry & Monitoring Module", "OpenTelemetry, RUM", "Captures Real User Monitoring data and tracks P95 load times.")
    Component(Nginx_Web_Server, "Nginx Web Server", "Nginx", "Serves immutable static assets with strict Content Security Policy headers and TLS 1.3 encryption.")
}

Rel(Role_Based_UI_Modules, API_Client_Layer, "Fetches data and authenticates via", "")
Rel(API_Client_Layer, Envoy_API_Gateway, "Authenticates and fetches data", "HTTPS / REST & GraphQL / JSON")
Rel(Role_Based_UI_Modules, Telemetry_Monitoring_Module, "Sends telemetry and performance metrics to", "")
Rel(Nginx_Web_Server, Role_Based_UI_Modules, "Serves static assets for", "")

@enduml