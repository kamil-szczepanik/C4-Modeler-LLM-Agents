@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(decoupled_data_tier, "Decoupled Data Tier") {
    Component(Primary Operational Database, "Primary Operational Database", "AWS RDS PostgreSQL & On-premise PostgreSQL", "Primary transactional storage for sub-second EMR performance.")
    Component(Reporting & Analytics Read Replica, "Reporting & Analytics Read Replica", "PostgreSQL Read Replica", "Offloads read-only queries for reporting and analytics.")
    Component(Audit & Archive Manager, "Audit & Archive Manager", "Apache Kafka & Debezium", "Streams change logs via CDC for audit streaming without operational locking.")
    Component(WORM Storage Vault, "WORM Storage Vault", "AWS S3 Object Lock / MinIO", "Immutable WORM storage satisfying greater than or equal to 10-year retention.")
}

Rel(Primary Operational Database, Audit & Archive Manager, "Streams change logs via Debezium CDC (TCP/IP)", "TCP/IP")
Rel(Audit & Archive Manager, WORM Storage Vault, "Writes immutable object archives via HTTPS", "HTTPS")

@enduml