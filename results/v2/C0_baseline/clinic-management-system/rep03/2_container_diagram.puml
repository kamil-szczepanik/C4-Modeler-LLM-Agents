@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(FrontDeskStaff, "Front Desk Staff", "Manages patient admissions, scheduling, and front-desk workflows.")
Person(Clinicians, "Clinicians", "Accesses and updates electronic medical records (EMR) and patient care details.")
Person(BillingOfficers, "Billing Officers", "Handles patient billing and financial transactions.")
Person(Patients, "Patients", "Interacts with the system for scheduling, medical records, and billing.")
Person(RegulatoryAuditors, "Regulatory Auditors", "Audits system logs and compliance data for regulatory standards.")

System_Ext(IdentityProvider, "Identity Provider", "Handles multi-factor authentication and identity federation via OIDC/SAML.")
System_Ext(ExternalLabImagingSystems, "External Lab & Imaging Systems", "External systems providing laboratory and imaging data via HL7 FHIR.")
System_Ext(ThirdPartyPaymentGatewayInsuranceClearinghouse, "Third-Party Payment Gateway & Insurance Clearinghouse", "Handles financial transactions and insurance claims.")
System_Ext(CentralizedSIEMObservabilityPlatform, "Centralized SIEM & Observability Platform", "Receives telemetry and audit logs with PHI masking.")
System_Ext(GlobalTrafficManagerAnycastDNS, "Global Traffic Manager / Anycast DNS", "Provides traffic routing and DDoS mitigation using DNSSEC.")
System_Ext(DistributedNetworkInterconnectSDWAN, "Distributed Network Interconnect / SD-WAN", "Manages hybrid boundary networking and secure connectivity.")

System_Boundary(ClinicManagementSystem, "Clinic Management System") {
    Container(ReactSinglePageApplicationSPAReactNativeMobileClient, "React Single-Page Application (SPA) / React Native Mobile Client", "React, React Native, CDN", "Client-side frontend for web and mobile users delivering optimized rendering.")
    Container(EnvoyAPIGatewayEdgeProxy, "Envoy API Gateway / Edge Proxy", "Envoy", "Edge layer routing incoming traffic, handling TLS 1.3 and OAuth2/OIDC validation.")
    Container(EMRSchedulingService, "EMR & Scheduling Service", "Node.js / Java", "Core service managing patient admissions, electronic medical records, and scheduling.")
    Container(BillingClaimsService, "Billing & Claims Service", "Java / Spring Boot", "Core service managing patient billing, financial transactions, and insurance claims.")
    Container(FHIRInteroperabilityService, "FHIR Interoperability Service", "HAPI FHIR, Java", "Core service managing FHIR-based interoperability and asynchronous message exchanges.")
    ContainerDb(RegionlocalPostgreSQLdatabases, "Region-local PostgreSQL databases", "PostgreSQL", "Regional operational storage for patient and system data.")
    Container(LocalizedApacheKafkaRabbitMQmessagebrokers, "Localized Apache Kafka/RabbitMQ message brokers", "Apache Kafka / RabbitMQ", "Message brokers for asynchronous, decoupled data exchanges.")
    Container(AWSS3onpremobjectstorageWORM, "AWS S3 / on-prem object storage (WORM)", "AWS S3 / WORM Object Storage", "Object storage enforcing WORM policies for 10-year audit retention.")
    Container(HashiCorpVault, "HashiCorp Vault", "HashiCorp Vault", "Secrets management system for dynamic secret retrieval.")
}

Rel(FrontDeskStaff, ReactSinglePageApplicationSPAReactNativeMobileClient, "Interacts with admissions and scheduling features", "HTTPS")
Rel(Clinicians, ReactSinglePageApplicationSPAReactNativeMobileClient, "Accesses EMR and patient care details", "HTTPS")
Rel(BillingOfficers, ReactSinglePageApplicationSPAReactNativeMobileClient, "Manages patient billing", "HTTPS")
Rel(Patients, ReactSinglePageApplicationSPAReactNativeMobileClient, "Interacts via portal for appointments and records", "HTTPS")
Rel(RegulatoryAuditors, ReactSinglePageApplicationSPAReactNativeMobileClient, "Reviews audit logs and compliance data", "HTTPS")
Rel(GlobalTrafficManagerAnycastDNS, EnvoyAPIGatewayEdgeProxy, "Routes external traffic to edge", "DNS / HTTPS")
Rel(ReactSinglePageApplicationSPAReactNativeMobileClient, EnvoyAPIGatewayEdgeProxy, "Sends API requests with OAuth2/OIDC validation", "HTTPS / TLS 1.3")
Rel(EnvoyAPIGatewayEdgeProxy, EMRSchedulingService, "Routes internal requests securely", "Internal mTLS via Istio/Linkerd")
Rel(EnvoyAPIGatewayEdgeProxy, BillingClaimsService, "Routes billing requests securely", "Internal mTLS via Istio/Linkerd")
Rel(EnvoyAPIGatewayEdgeProxy, FHIRInteroperabilityService, "Routes interoperability requests securely", "Internal mTLS via Istio/Linkerd")
Rel(EMRSchedulingService, RegionlocalPostgreSQLdatabases, "Reads and writes operational data", "Encrypted TCP")
Rel(BillingClaimsService, RegionlocalPostgreSQLdatabases, "Reads and writes billing data", "Encrypted TCP")
Rel(FHIRInteroperabilityService, LocalizedApacheKafkaRabbitMQmessagebrokers, "Communicates asynchronously using W3C Trace Context headers", "Kafka/AMQP protocol")
Rel(EMRSchedulingService, LocalizedApacheKafkaRabbitMQmessagebrokers, "Publishes and consumes events asynchronously", "Kafka/AMQP protocol")
Rel(BillingClaimsService, LocalizedApacheKafkaRabbitMQmessagebrokers, "Publishes and consumes billing events asynchronously", "Kafka/AMQP protocol")
Rel(EMRSchedulingService, AWSS3onpremobjectstorageWORM, "Archives immutable audit and compliance records", "HTTPS / S3 API")
Rel(BillingClaimsService, AWSS3onpremobjectstorageWORM, "Archives billing records", "HTTPS / S3 API")
Rel(EMRSchedulingService, HashiCorpVault, "Retrieves secrets dynamically", "HTTPS / Vault API")
Rel(BillingClaimsService, HashiCorpVault, "Retrieves secrets dynamically", "HTTPS / Vault API")
Rel(FHIRInteroperabilityService, HashiCorpVault, "Retrieves secrets dynamically", "HTTPS / Vault API")
Rel(EnvoyAPIGatewayEdgeProxy, HashiCorpVault, "Retrieves secrets dynamically", "HTTPS / Vault API")
Rel(ClinicManagementSystem, IdentityProvider, "Validates and federates user identities", "OIDC/SAML")
Rel(FHIRInteroperabilityService, ExternalLabImagingSystems, "Exchanges lab and imaging data", "HL7 FHIR over HTTPS")
Rel(BillingClaimsService, ThirdPartyPaymentGatewayInsuranceClearinghouse, "Processes payments and claims", "REST over HTTPS")
Rel(EMRSchedulingService, CentralizedSIEMObservabilityPlatform, "Streams telemetry and audit logs with PHI masking", "Secure syslog/OTLP")
Rel(BillingClaimsService, CentralizedSIEMObservabilityPlatform, "Streams telemetry and audit logs with PHI masking", "Secure syslog/OTLP")
Rel(DistributedNetworkInterconnectSDWAN, EnvoyAPIGatewayEdgeProxy, "Connects multi-region infrastructure securely", "mTLS with SPIFFE/SPIRE")

@enduml