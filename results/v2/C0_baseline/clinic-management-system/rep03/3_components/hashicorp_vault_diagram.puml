@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Ext(envoy_gateway, "Envoy API Gateway", "Envoy", "External gateway or callers to the Vault container.")
System_Ext(siem_platform, "Centralized SIEM & Observability Platform", "SIEM", "Receives streamed audit logs.")
System_Ext(aws_s3, "AWS S3 / WORM Object Storage", "Object Storage", "Stores encrypted Raft daily snapshots.")

Container_Boundary(hashicorp_vault, "HashiCorp Vault") {
    Component(http_api, "HTTP API / Core Engine", "HTTP API / Core Engine", "Handles core request processing and API interactions for Vault.")
    Component(auth_engine, "Authentication Engine", "Auth Engine", "Manages authentication methods such as AppRole and Kubernetes Auth.")
    Component(secret_engines, "Secret Engines", "Secret Engines", "Secures and manages dynamic credentials, secrets, and token leases.")
    Component(transit_engine, "Transit Secrets Engine", "Transit Secrets Engine", "Provides encryption-as-a-service and envelope encryption for applications.")
    Component(audit_subsystem, "Audit Device Subsystem", "Audit Subsystem", "Logs all requests and responses to Vault and streams audit logs to the SIEM.")
    Component(replication_manager, "Replication Manager", "Replication Manager", "Manages regional enterprise performance replication for high availability.")
}

Rel(envoy_gateway, http_api, "Authenticates and communicates", "AppRole / Kubernetes Auth [mTLS / HTTPS]")
Rel(audit_subsystem, siem_platform, "Streams audit logs", "Syslog / TLS")
Rel(http_api, aws_s3, "Ships encrypted Raft daily snapshots", "HTTPS")

@enduml