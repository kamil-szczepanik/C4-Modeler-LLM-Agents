@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Localized Apache Kafka/RabbitMQ message brokers container

System_Ext(EMR_Scheduling_Service, "EMR & Scheduling Service", "Internal container")
System_Ext(Billing_Claims_Service, "Billing & Claims Service", "Internal container")
System_Ext(FHIR_Interoperability_Service, "FHIR Interoperability Service", "Internal container")
System_Ext(Centralized_SIEM_Observability_Platform, "Centralized SIEM & Observability Platform", "External System")

Container_Boundary(message_brokers_container, "Localized Apache Kafka/RabbitMQ message brokers") {
    Component(Event_Streaming_Core, "Event Streaming Core", "Apache Kafka", "Publishes and consumes domain events for EMR and scheduling services.")
    Component(Task_Routing_Broker, "Task & Routing Broker", "RabbitMQ", "Dispatches task commands for billing and claims services.")
    Component(Broker_Encryption_Access_Manager, "Broker Encryption & Access Manager", "HashiCorp Vault / TLS 1.3 / SCRAM-SHA-512", "Manages encryption, certificate rotation, and access control for message brokers.")
    Component(Local_Edge_Buffer_Component, "Local Edge Buffer Component", "Kafka/AMQP Buffer", "Provides local edge buffering to ensure zero data loss during network partitions.")
    Component(Dead_Letter_Quarantine_Router, "Dead-Letter & Quarantine Router", "Kafka/AMQP DLQ", "Routes undeliverable or erroneous messages for isolation and analysis.")
}

Rel(EMR_Scheduling_Service, Event_Streaming_Core, "Publishes/consumes domain events", "TCP / Kafka Protocol, TLS 1.3")
Rel(Billing_Claims_Service, Task_Routing_Broker, "Dispatches task commands", "AMQP 0-9-1, TLS 1.3")
Rel(Event_Streaming_Core, Centralized_SIEM_Observability_Platform, "Streams audit logs and metrics", "OTLP / HTTPS, TLS 1.3")
Rel(FHIR_Interoperability_Service, Event_Streaming_Core, "Exchanges clinical data", "Kafka/AMQP protocol")

@enduml