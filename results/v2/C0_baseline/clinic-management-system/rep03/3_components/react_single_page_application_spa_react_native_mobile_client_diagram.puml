@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the React Single-Page Application (SPA) / React Native Mobile Client container

Container_Boundary("React Single-Page Application (SPA) / React Native Mobile Client", "React Single-Page Application (SPA) / React Native Mobile Client") {
    Component("Web UI Router and State Manager", "Web UI Router and State Manager", "React & React Native", "Manages client-side routing, navigation, and application state for web and mobile interfaces.")
    Component("Authentication Client", "Authentication Client", "OAuth2/OIDC SDK", "Handles user authentication, token management, and secure session handling with the API Gateway.")
    Component("API Integration Client", "API Integration Client", "HTTPS / REST / GraphQL Client", "Communicates securely with the Envoy API Gateway over HTTPS using TLS 1.3.")
}

System_Ext("Envoy API Gateway / Edge Proxy", "Envoy API Gateway / Edge Proxy", "API Gateway / Edge Proxy")

Rel("Web UI Router and State Manager", "Authentication Client", "Authenticates users via", "")
Rel("Web UI Router and State Manager", "API Integration Client", "Sends API requests through", "")
Rel("API Integration Client", "Envoy API Gateway / Edge Proxy", "Makes HTTPS requests to", "HTTPS / TLS 1.3")

@enduml