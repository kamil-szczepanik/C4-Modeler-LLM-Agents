@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Envoy API Gateway / Edge Proxy", "Envoy API Gateway / Edge Proxy") {
    Component("Listener & TLS Termination Component", "Listener & TLS Termination Component", "C++", "Handles TLS 1.3 termination and WAF filtering for incoming traffic.")
    Component("Auth & Authorization Filter", "Auth & Authorization Filter", "Lua / External", "Validates OAuth2/OIDC JWTs, scopes, and enforces persona-based rate limits.")
    Component("Routing & Load Balancing Engine", "Routing & Load Balancing Engine", "Envoy Proxy Core", "Manages circuit breaking and mTLS to backend services.")
    Component("Telemetry & Audit Emitter", "Telemetry & Audit Emitter", "OpenTelemetry / gRPC", "Streams PII-sanitized OpenTelemetry logs to the centralized SIEM.")
}

Rel("Listener & TLS Termination Component", "Auth & Authorization Filter", "Passes authenticated requests for token and policy validation", "")
Rel("Auth & Authorization Filter", "Routing & Load Balancing Engine", "Forwards authorized requests for upstream routing", "")
Rel("Routing & Load Balancing Engine", "Telemetry & Audit Emitter", "Emits request metrics and sanitized audit logs", "")
@enduml