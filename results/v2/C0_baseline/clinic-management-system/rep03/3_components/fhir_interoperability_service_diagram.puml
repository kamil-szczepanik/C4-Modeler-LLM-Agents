@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(fhir_interoperability_service, "FHIR Interoperability Service") {
    Component(fhir_api_controller, "FHIR API Controller", "HAPI FHIR REST Framework, Java", "Handles incoming FHIR API requests and provides validation for payloads.")
    Component(transformation_engine, "Transformation Engine", "Apache Camel, Java", "Transforms validated payloads and performs atomic outbox writes.")
    Component(async_event_dispatcher, "Async Event Dispatcher", "Spring Cloud Stream / Kafka Client", "Publishes outbox events to message brokers.")
}

Rel(fhir_api_controller, transformation_engine, "Validated FHIR payload", "Java interface")

@enduml