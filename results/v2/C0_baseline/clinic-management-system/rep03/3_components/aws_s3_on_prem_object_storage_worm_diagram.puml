@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_s3_on_prem_object_storage_worm, "AWS S3 / on-prem object storage (WORM)") {
    Component(Object_Storage_Engine, "Object Storage Engine", "AWS S3 / MinIO", "Enforces 10-year immutable WORM retention and stores encrypted payloads securely.")
    Component(Storage_Tiering_Scheduler, "Storage Tiering Scheduler", "S3 Lifecycle API", "Enforces lifecycle transitions and automated archival policies.")
}

System_Ext(Centralized_SIEM, "Centralized SIEM", "Centralized SIEM & Observability Platform")

Rel(Storage_Tiering_Scheduler, Object_Storage_Engine, "Enforces lifecycle transitions", "S3 Lifecycle API")
Rel(Object_Storage_Engine, Centralized_SIEM, "Streams audit logs", "Syslog / HTTPS")

@enduml