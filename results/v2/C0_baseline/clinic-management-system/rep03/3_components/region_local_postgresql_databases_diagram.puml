@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(region_local_postgresql_databases, "Region-local PostgreSQL databases") {
    Component(Primary_Database_Engine, "Primary Database Engine", "PostgreSQL, CNPG operator, Amazon RDS", "Stores operational data, EMR records, and billing details with Row-Level Security (RLS) and automated failover.")
    Component(PgBouncer_Connection_Pooler, "PgBouncer Connection Pooler", "PgBouncer", "Manages high connection concurrency from microservices to the PostgreSQL database.")
    Component(Audit_Logging_Engine, "Audit Logging Engine", "pgaudit", "Generates and forwards audit logs to the centralized SIEM.")
}

Rel(PgBouncer_Connection_Pooler, Primary_Database_Engine, "Routes and pools database connections", "")
Rel(Primary_Database_Engine, Audit_Logging_Engine, "Generates audit events", "")
@enduml