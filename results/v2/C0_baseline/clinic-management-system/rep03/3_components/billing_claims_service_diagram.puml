@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(billing_claims_service, "Billing & Claims Service") {
    Component(ClaimSubmissionController, "Claim Submission Controller", "Spring WebMVC", "Handles incoming claim submission requests and routes validation to third-party gateways.")
    Component(ClearinghouseAdapter, "Clearinghouse Adapter", "Spring Cloud OpenFeign", "Adapts communication with external clearinghouses and fetches dynamic API keys.")
    Component(BillingEventPublisher, "Billing Event Publisher", "Apache Kafka", "Publishes financial events for billing and ledger lifecycles.")
    Component(WORMArchivalService, "WORM Archival Service", "Spring Batch / AWS S3", "Archives records for long-term compliant data retention.")
    Component(BillingAuditLedgerComponent, "Billing Audit & Ledger Component", "Spring Data JDBC / Axon Framework", "Persists audit trails and manages ledger transactions.")
    Component(EnvoyApiGateway, "Envoy API Gateway", "Istio/Linkerd", "Routes requests via internal mTLS to the claim submission controller.")
}

System_Ext(RegionlocalPostgresqldatabases, "Region-local PostgreSQL databases", "PostgreSQL", "Relational storage with table partitioning and encryption at rest.")
System_Ext(ThirdPartyPaymentGatewayInsuranceClearinghouse, "Third-Party Payment Gateway & Insurance Clearinghouse", "External REST Service", "External payment gateway and insurance clearinghouse system.")
System_Ext(HashiCorpVault, "HashiCorp Vault", "HashiCorp Vault", "Provides dynamic secrets and cryptographic key management.")
System_Ext(AWSS3ObjectStorage, "AWS S3 / Object Storage", "AWS S3", "Object storage used for compliant long-term data retention.")

Rel(EnvoyApiGateway, ClaimSubmissionController, "Routes requests via internal mTLS", "Istio/Linkerd")
Rel(ClaimSubmissionController, ThirdPartyPaymentGatewayInsuranceClearinghouse, "Synchronous validation", "REST over HTTPS")
Rel(BillingEventPublisher, AWSS3ObjectStorage, "Publishes financial events", "Kafka Protocol with mTLS")
Rel(WORMArchivalService, AWSS3ObjectStorage, "Archives records", "HTTPS / S3 API with Object Lock")
Rel(ClearinghouseAdapter, HashiCorpVault, "Fetches dynamic API keys", "HTTPS / Vault API")
Rel(BillingAuditLedgerComponent, RegionlocalPostgresqldatabases, "Persists audit trails", "Encrypted TCP / TLS 1.3")

@enduml