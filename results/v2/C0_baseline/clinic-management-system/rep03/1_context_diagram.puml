@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FrontDeskStaff, "Front Desk Staff", "Manages patient admissions, scheduling, and front-desk workflows.")
Person(Clinicians, "Clinicians", "Accesses and updates electronic medical records (EMR) and patient care details.")
Person(BillingOfficers, "Billing Officers", "Handles patient billing and financial transactions.")
Person(Patients, "Patients", "Interacts with the system for scheduling, medical records, and billing.")
Person(RegulatoryAuditors, "Regulatory Auditors", "Audits system logs and compliance data for regulatory standards.")

System(ClinicManagementSystem, "Clinic Management System", "Manages patient admissions, electronic medical records (EMR), scheduling, and billing for medium-sized hospitals and clinics using a hybrid architecture.")

System_Ext(IdentityProvider, "Identity Provider", "Handles multi-factor authentication and identity federation via OIDC/SAML.")
System_Ext(ExternalLabImagingSystems, "External Lab & Imaging Systems", "External systems providing laboratory and imaging data via HL7 FHIR.")
System_Ext(ThirdPartyPaymentGatewayInsuranceClearinghouse, "Third-Party Payment Gateway & Insurance Clearinghouse", "Handles financial transactions and insurance claims.")
System_Ext(CentralizedSIEMObservabilityPlatform, "Centralized SIEM & Observability Platform", "Receives telemetry and audit logs with PHI masking.")
System_Ext(GlobalTrafficManagerAnycastDNS, "Global Traffic Manager / Anycast DNS", "Provides traffic routing and DDoS mitigation using DNSSEC.")
System_Ext(DistributedNetworkInterconnectSDWAN, "Distributed Network Interconnect / SD-WAN", "Manages hybrid boundary networking and secure connectivity.")

Rel(FrontDeskStaff, ClinicManagementSystem, "Interacts with the system for admissions and scheduling", "HTTPS and OIDC")
Rel(Clinicians, ClinicManagementSystem, "Interacts with the system for EMR management", "HTTPS and OIDC")
Rel(BillingOfficers, ClinicManagementSystem, "Interacts with the system for billing", "HTTPS and OIDC")
Rel(Patients, ClinicManagementSystem, "Interacts with the system for patient portal features", "HTTPS and OIDC")
Rel(RegulatoryAuditors, ClinicManagementSystem, "Audits system compliance and logs", "HTTPS and OIDC")
Rel(ClinicManagementSystem, IdentityProvider, "Authenticates users and federates identities", "OIDC/SAML")
Rel(ClinicManagementSystem, ExternalLabImagingSystems, "Integrates with lab and imaging data", "HL7 FHIR over HTTPS")
Rel(ClinicManagementSystem, ThirdPartyPaymentGatewayInsuranceClearinghouse, "Processes payments and insurance claims", "REST over HTTPS")
Rel(ClinicManagementSystem, CentralizedSIEMObservabilityPlatform, "Streams telemetry and audit logs with PHI masking", "Secure syslog/OTLP")
Rel(GlobalTrafficManagerAnycastDNS, ClinicManagementSystem, "Routes traffic and provides DDoS mitigation", "DNSSEC / Anycast DNS")
Rel(DistributedNetworkInterconnectSDWAN, ClinicManagementSystem, "Connects services across the hybrid boundary", "mTLS with SPIFFE/SPIRE")
@enduml