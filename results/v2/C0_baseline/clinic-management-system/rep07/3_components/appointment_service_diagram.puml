@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(appointment_service, "Appointment Service") {
    Component(appointment_api_controller, "Appointment API Controller", "Node.js / Go", "Handles incoming API requests for appointments and invokes core domain logic.")
    Component(scheduling_engine, "Scheduling Engine", "Node.js / Go", "Executes core domain logic, resource clash checks, and atomic writes.")
    Component(waitlist_manager, "Waitlist Manager", "Node.js / Go", "Manages waitlists and handles slot-freed events.")
    Component(notification_publisher, "Notification Publisher", "Node.js / Go", "Publishes domain events and analytics tags to messaging infrastructure.")
}

Rel(appointment_api_controller, scheduling_engine, "Invokes core domain logic", "In-Process")
Rel(scheduling_engine, notification_publisher, "Publishes domain events and analytics tags", "Kafka Producer")
Rel(notification_publisher, waitlist_manager, "Triggers slot-freed events", "In-Process / Event Handler")

@enduml