@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Compliance_IT_Auditor, "Compliance/IT Auditor", "Primary human user role enforcing regulatory oversight.")

System_Boundary(Audit_Compliance_Container, "Audit & Compliance Container") {
    Component(Event_Ingestion_Engine, "Event Ingestion Engine", "Go", "Go-based Kafka consumer for raw security and access events.")
    Component(Log_Integrity___Hash_Chain_Service, "Log Integrity & Hash Chain Service", "Go", "Go component implementing cryptographic hash-chains for tamper-evident logs.")
    Component(Anomaly_Detection___Alert_Engine, "Anomaly Detection & Alert Engine", "Go", "Go stream-processing component evaluating real-time threat thresholds.")
    Component(Compliance_Storage_Repository, "Compliance Storage Repository", "PostgreSQL / S3 Glacier Vault Lock", "PostgreSQL paired with S3 Glacier Vault Lock using WORM controls.")
    Component(Audit_Reporting_API, "Audit Reporting API", "Node.js / Go", "Node.js/Go REST/gRPC service for generating cryptographically signed compliance reports.")
    Component(Apache_Kafka, "Apache Kafka", "Apache Kafka", "Scalable, fault-tolerant event streaming platform.")
}

Rel(Event_Ingestion_Engine, Apache_Kafka, "Consumes from", "Kafka Protocol over mTLS with SASL/SCRAM")
Rel(Event_Ingestion_Engine, Anomaly_Detection___Alert_Engine, "Feeds", "Internal IPC / Go Channels")
Rel(Log_Integrity___Hash_Chain_Service, Compliance_Storage_Repository, "Persists to", "SQL / S3 API with AES-256 and Field-Level Encryption")
Rel(Audit_Reporting_API, Compliance_IT_Auditor, "Serves", "HTTPS / REST with RBAC, ABAC, and KMS Digital Signatures")

@enduml