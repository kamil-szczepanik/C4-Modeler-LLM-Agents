@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL container

Container_Boundary(postgresql_container, "PostgreSQL") {
    Component(StorageEngine, "Relational Storage Engine (PostgreSQL 16)", "PostgreSQL 16", "Core persistence engine with table partitioning for ACID compliance.")
    Component(PgBouncer, "PgBouncer", "PgBouncer", "Connection pooling for managing high concurrency and preventing exhaustion.")
    Component(PgAudit, "pg_audit extension", "pg_audit", "Provides immutable audit logs for compliance.")
    Component(VaultPgcrypto, "Vault + pgcrypto", "Vault, pgcrypto", "Handles AES-256 envelope encryption at rest.")
    Component(RedisCache, "Redis 7 caching layer", "Redis 7", "Provides low-latency EMR retrieval (<1s P95).")
    Component(RLSEngine, "Row-Level Security Policies Engine", "PostgreSQL RLS", "Enforces strict data access control and HIPAA/GDPR compliance.")
}

Rel(PgBouncer, StorageEngine, "Routes TCP/PostgreSQL Wire Protocol (TLS 1.3) traffic", "TCP / TLS 1.3")
Rel(StorageEngine, PgAudit, "Generates immutable audit logs", "Internal")
Rel(StorageEngine, VaultPgcrypto, "Applies envelope encryption at rest", "Internal")
Rel(StorageEngine, RLSEngine, "Evaluates access policies", "Internal")

@enduml