@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Apache_Kafka, "Apache Kafka", "Streaming platform", "Forwards asynchronous access logs [Apache Kafka Protocol]")

Container_Boundary(api_gateway, "API Gateway") {
    Component(TLS_Termination___Edge_Firewall, "TLS Termination & Edge Firewall", "NGINX / Kong", "Handles edge routing, TLS 1.3 termination, and edge firewall protection.")
    Component(Authentication___Authorization_Filter, "Authentication & Authorization Filter", "NGINX / Kong Plugin", "Enforces zero-trust JWT/OAuth2 scopes and validates identity.")
    Component(Rate_Limiting___Traffic_Shaping_Engine, "Rate Limiting & Traffic Shaping Engine", "NGINX / Kong", "Protects backend services by limiting request rates and shaping traffic.")
    Component(Reverse_Proxy___Load_Balancer, "Reverse Proxy & Load Balancer", "NGINX / Kong", "Routes validated requests to backend services securely.")
    Component(Telemetry___Audit_Interceptor, "Telemetry & Audit Interceptor", "NGINX / Kong", "Captures access logs and forwards telemetry data asynchronously.")
    Component(API_Version_Router, "API Version Router", "NGINX / Kong", "Directs incoming requests to the correct API version endpoints.")
    Component(Tenant_Resolution_Filter, "Tenant Resolution Filter", "NGINX / Kong", "Identifies and resolves multi-tenant contexts for incoming requests.")
}

Rel(TLS_Termination___Edge_Firewall, Authentication___Authorization_Filter, "Passes decrypted traffic for authorization", "")
Rel(Authentication___Authorization_Filter, Rate_Limiting___Traffic_Shaping_Engine, "Forwards authenticated requests", "")
Rel(Rate_Limiting___Traffic_Shaping_Engine, API_Version_Router, "Passes rate-limited requests", "")
Rel(API_Version_Router, Tenant_Resolution_Filter, "Resolves tenant context", "")
Rel(Tenant_Resolution_Filter, Reverse_Proxy___Load_Balancer, "Dispatches validated requests to backend containers", "")
Rel(Authentication___Authorization_Filter, Telemetry___Audit_Interceptor, "Triggers security and access events", "")
Rel(Telemetry___Audit_Interceptor, Apache_Kafka, "Forwards asynchronous access logs", "Apache Kafka Protocol")

@enduml