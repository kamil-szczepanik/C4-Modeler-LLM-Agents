@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the EMR Service container

Container_Boundary(emr_service, "EMR Service") {
    Component(emr_api_controller, "EMR API Controller", "Go", "Handles incoming API requests for the EMR service.")
    Component(access_policy_enforcer, "Access Policy Enforcer", "Go", "Evaluates ABAC rules in-process for request authorization.")
    Component(clinical_record_manager, "Clinical Record Manager", "Go", "Manages clinical record business logic and data processing.")
    Component(audit_trail_interceptor, "Audit Trail Interceptor", "Go", "Intercepts requests and actions to generate audit trails for compliance.")
    Component(data_access_layer, "Data Access Layer", "Go", "Executes SQL and Redis queries for data persistence and caching.")
    Component(local_emergency_cache, "Local Emergency Cache", "Redis / In-Memory", "Provides fast local caching for emergency access to EMR records.")
}

Rel(emr_api_controller, access_policy_enforcer, "Evaluates ABAC rules in-process", "in-process")
Rel(access_policy_enforcer, clinical_record_manager, "Forwards validated requests in-process", "in-process")
Rel(clinical_record_manager, data_access_layer, "Executes SQL / Redis queries", "in-process")
@enduml