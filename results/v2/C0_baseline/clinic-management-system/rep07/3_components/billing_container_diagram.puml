@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing Container container

System_Ext(API_Gateway, "API Gateway", "External API Gateway routing incoming traffic.")
System_Ext(External_Payment_Gateway_Insurance_Clearinghouse, "External Payment Gateway / Insurance Clearinghouse", "External system handling financial transactions and claims.")

Container_Boundary(Billing_Container, "Billing Container") {
    Component(Billing_Specialist, "Billing Specialist", "User Persona", "User persona initiating claim submissions and managing financial records.")
    Component(Billing_API_Controller, "Billing API Controller", "Node.js/Go", "Node.js/Go component handling incoming REST/gRPC requests via mTLS.")
    Component(Claim_Validation_Engine, "Claim Validation Engine", "Node.js/Go", "Node.js/Go component executing real-time business rule validation against cached schemas.")
    Component(Payment_Claims_Service, "Payment & Claims Service", "Node.js/Go", "Node.js/Go component managing secure outbound integrations.")
    Component(Remittance_Ingestion_Worker, "Remittance Ingestion Worker", "Node.js/Go", "Node.js/Go background worker processing asynchronous ERA/835 payloads.")
    Component(Billing_Data_Access_Layer, "Billing Data Access Layer", "Node.js/Go", "Node.js/Go component interacting with PostgreSQL and Redis.")
    Component(Apache_Kafka, "Apache Kafka", "Event Broker", "Event broker utilized for the Outbox Pattern and Dead Letter Queue (DLQ).")
}

Rel(API_Gateway, Billing_API_Controller, "Routes billing requests", "HTTPS / gRPC with mTLS")
Rel(Billing_API_Controller, Claim_Validation_Engine, "Internal function call", "")
Rel(Claim_Validation_Engine, Payment_Claims_Service, "Validated claim payload", "Internal via Apache Kafka")
Rel(Payment_Claims_Service, External_Payment_Gateway_Insurance_Clearinghouse, "Submits claims and processes payments", "TLS 1.3 with mTLS")
Rel(External_Payment_Gateway_Insurance_Clearinghouse, Remittance_Ingestion_Worker, "Delivers ERA/835 payloads", "HTTPS / SFTP over TLS 1.3")
Rel(Remittance_Ingestion_Worker, Billing_Data_Access_Layer, "Reconciles and updates patient ledger", "SQL over TLS")

@enduml