@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(apache_kafka, "Apache Kafka") {
    Component(Kafka_Brokers, "Kafka Brokers", "Apache Kafka", "Handles event streaming and message transport across microservices.")
    Component(KRaft_Quorum, "KRaft Quorum", "Apache Kafka KRaft", "Manages metadata and consensus without relying on ZooKeeper.")
    Component(Schema_Registry, "Schema Registry", "Confluent Schema Registry", "Enforces data governance using Avro and Protobuf schemas.")
    Component(Kafka_Connect_Sink, "Kafka Connect Sink", "Kafka Connect", "Streams encrypted data from Kafka to S3/MinIO Object Storage via HTTPS.")
}

Rel(Kafka_Brokers, Schema_Registry, "Streams data to and validates against", "Avro/Protobuf")
Rel(Kafka_Brokers, Kafka_Connect_Sink, "Sends event data to", "Kafka protocol")

@enduml