@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(hl7_fhir_interoperability_service, "HL7 FHIR Interoperability Service") {
    Component(FHIR API Router, "FHIR API Router", "Python / FastAPI", "Routes incoming RESTful API requests and enforces mTLS security policies.")
    Component(Pydantic Schema Validator, "Pydantic Schema Validator", "Pydantic", "Performs strict runtime data validation against HL7 FHIR resource schemas.")
    Component(External Lab Integration Client, "External Lab Integration Client", "Python HTTP Client / mTLS", "Handles outbound communication with External Lab & Imaging Systems using HL7 FHIR APIs.")
}

Rel(FHIR API Router, Pydantic Schema Validator, "Validates incoming request payloads")
Rel(FHIR API Router, External Lab Integration Client, "Dispatches authenticated FHIR requests")
@enduml