@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patient, "Patient", "Uses the system for self-service scheduling and billing.")
Person(Clinician_Doctor, "Clinician/Doctor", "Manages patient admissions and electronic medical records.")
Person(Receptionist_Admin, "Receptionist/Admin", "Manages scheduling, admissions, and administrative tasks.")
Person(Billing_Specialist, "Billing Specialist", "Manages claims, payments, and billing processes.")
Person(Compliance_IT_Auditor, "Compliance/IT Auditor", "Monitors strict HIPAA/GDPR compliance and system security.")

System(Clinic_Management_System, "Clinic Management System", "A hybrid-cloud platform designed for medium-sized hospitals and clinics to manage patient admissions, electronic medical records, scheduling, and billing while ensuring high availability and compliance.")

System_Ext(Patient_Portal_App, "Patient Portal App", "Client application for patient self-service scheduling and billing.")
System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "Handles authentication, MFA, and SSO using OIDC/SAML 2.0.")
System_Ext(External_Lab_Imaging_Systems, "External Lab & Imaging Systems", "External medical systems interacting via HL7 FHIR over mTLS.")
System_Ext(Payment_Gateway___Insurance_Clearinghouse, "Payment Gateway / Insurance Clearinghouse", "Processes payments and insurance claims asynchronously.")

Rel(Patient, Clinic_Management_System, "Interacts via Web/Mobile UI", "HTTPS / TLS 1.3")
Rel(Clinician_Doctor, Clinic_Management_System, "Interacts via Web/Mobile UI", "HTTPS / TLS 1.3")
Rel(Receptionist_Admin, Clinic_Management_System, "Interacts via Web/Mobile UI", "HTTPS / TLS 1.3")
Rel(Billing_Specialist, Clinic_Management_System, "Interacts via Web/Mobile UI", "HTTPS / TLS 1.3")
Rel(Compliance_IT_Auditor, Clinic_Management_System, "Interacts via Web/Mobile UI", "HTTPS / TLS 1.3")
Rel(Patient_Portal_App, Clinic_Management_System, "Requests self-service scheduling and billing", "HTTPS REST/GraphQL")
Rel(Clinic_Management_System, Identity_Provider_IdP, "Performs authentication, MFA, and SSO", "OIDC / SAML 2.0 with OAuth2")
Rel(Clinic_Management_System, External_Lab_Imaging_Systems, "Exchanges clinical data", "HL7 FHIR over mTLS")
Rel(External_Lab_Imaging_Systems, Clinic_Management_System, "Exchanges clinical data", "HL7 FHIR over mTLS")
Rel(Clinic_Management_System, Payment_Gateway___Insurance_Clearinghouse, "Processes claims and billing asynchronously", "Asynchronous REST APIs via Kafka/RabbitMQ")
@enduml