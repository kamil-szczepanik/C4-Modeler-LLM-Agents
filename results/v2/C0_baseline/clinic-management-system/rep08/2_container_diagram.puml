@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management Systems

Person(Patients, "Patients", "Interacts with the patient portal for scheduling and health records.")
Person(Clinicians, "Clinicians", "Manages patient admissions and EMRs.")
Person(Administrative_Staff, "Administrative Staff", "Manages scheduling and billing workflows.")
Person(Compliance_Officers_Auditors, "Compliance Officers / Auditors", "Monitors system audit trails and enforces security compliance.")

System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "Handles user authentication.")
System_Ext(External_Lab_Imaging_Systems, "External Lab & Imaging Systems", "Provides diagnostic data exchange.")
System_Ext(Payment_Gateway_Insurance_Clearinghouse, "Payment Gateway / Insurance Clearinghouse", "Processes insurance claims and payment transactions.")
System_Ext(SIEM_Immutable_Cold_Storage, "SIEM & Immutable Cold Storage", "Receives audit logs and compliance data.")

System_Boundary(Clinic_Management_System, "Clinic Management System") {
    Container(API_Gateway_Reverse_Proxy, "API Gateway / Reverse Proxy", "Envoy/NGINX", "Manages incoming traffic and routing to internal services.")
    Container(Patient_Portal_App, "Patient Portal App", "React/Node.js", "Provides patient-facing interface for portal and scheduling.")
    Container(Clinical_Core_Service, "Clinical Core Service", "Go/Spring Boot with Redis/RocksDB edge cache", "Manages EMRs, patient admissions, and clinical workflows with offline edge cache.")
    Container(Interoperability_Engine, "Interoperability Engine", "HAPI FHIR/Apache Camel", "Handles healthcare data integration and HL7 FHIR messaging.")
    Container(Billing_Claims_Service, "Billing & Claims Service", "Spring Boot", "Manages billing and insurance claims processing.")
    Container(Sync_Orchestrator, "Sync Orchestrator", "Custom Go/Java", "Maintains offline capabilities and synchronizes data during network partitions.")
}

Rel(Patients, Patient_Portal_App, "Accesses portal and clinical records", "HTTPS / TLS 1.3")
Rel(Patient_Portal_App, API_Gateway_Reverse_Proxy, "Sends API requests", "HTTPS / TLS 1.3")
Rel(API_Gateway_Reverse_Proxy, Clinical_Core_Service, "Routes internal traffic securely", "gRPC over mTLS (Istio service mesh)")
Rel(API_Gateway_Reverse_Proxy, Billing_Claims_Service, "Routes billing traffic", "gRPC over mTLS (Istio service mesh)")
Rel(Clinical_Core_Service, External_Lab_Imaging_Systems, "Exchanges diagnostic data", "HL7 FHIR APIs")
Rel(Billing_Claims_Service, Payment_Gateway_Insurance_Clearinghouse, "Sends payment transactions and claims", "Asynchronous messaging via RabbitMQ")
Rel(Clinical_Core_Service, SIEM_Immutable_Cold_Storage, "Streams encrypted audit logs", "Encrypted audit log streaming")
Rel(Billing_Claims_Service, SIEM_Immutable_Cold_Storage, "Streams encrypted audit logs", "Encrypted audit log streaming")
Rel(Interoperability_Engine, SIEM_Immutable_Cold_Storage, "Streams encrypted audit logs", "Encrypted audit log streaming")

@enduml