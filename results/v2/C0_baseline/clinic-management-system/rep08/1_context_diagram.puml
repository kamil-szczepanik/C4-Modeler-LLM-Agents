@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patient, "Patient", "Interacts with the system for scheduling, portals, and accessing medical records.")
Person(Clinician, "Clinician", "Accesses electronic medical records, manages patient admissions, and executes clinical workflows.")
Person("Administrative Staff", "Administrative Staff", "Manages scheduling, billing, and general clinic operations.")
Person("Compliance Officer / Auditor", "Compliance Officer / Auditor", "Monitors system audit trails, enforces regulatory compliance, and reviews security logs.")

System("Clinic Management System", "Clinic Management System", "A hybrid cloud platform designed to manage patient admissions, electronic medical records, scheduling, and billing for medium-sized hospitals and clinics, delivering high-availability clinical workflows while strictly enforcing healthcare data security and regulatory compliance.")

System_Ext("Identity Provider (IdP)", "Identity Provider (IdP)", "Handles user authentication and enforces RBAC/ABAC policies.")
System_Ext("External Lab & Imaging Systems", "External Lab & Imaging Systems", "Provides diagnostic data exchange for medical tests and imaging.")
System_Ext("Payment Gateway / Insurance Clearinghouse", "Payment Gateway / Insurance Clearinghouse", "Processes insurance claims and payment transactions.")
System_Ext("SIEM & Immutable Cold Storage", "SIEM & Immutable Cold Storage", "Stores audit trails and logs for HIPAA/GDPR compliance.")

Rel(Patient, "Clinic Management System", "Accesses portals and manages appointments via Multi-Factor Authentication", "HTTPS/TLS 1.3, OIDC/SAML 2.0")
Rel(Clinician, "Clinic Management System", "Manages clinical workflows and electronic medical records", "HTTPS/TLS 1.3, OIDC/SAML 2.0")
Rel("Administrative Staff", "Clinic Management System", "Handles billing, admissions, and scheduling", "HTTPS/TLS 1.3, OIDC/SAML 2.0")
Rel("Compliance Officer / Auditor", "Clinic Management System", "Monitors compliance and reviews audit logs", "HTTPS/TLS 1.3, OIDC/SAML 2.0")

Rel("Clinic Management System", "Identity Provider (IdP)", "Authenticates users and enforces RBAC/ABAC", "OIDC/SAML 2.0")
Rel("Clinic Management System", "External Lab & Imaging Systems", "Exchanges diagnostic data", "HL7 FHIR (REST/JSON)")
Rel("Clinic Management System", "Payment Gateway / Insurance Clearinghouse", "Submits insurance claims and processes payments", "HTTPS/REST")
Rel("Clinic Management System", "SIEM & Immutable Cold Storage", "Sends audit trails for HIPAA/GDPR compliance", "Syslog/TLS, Cloud-native object storage APIs")

@enduml