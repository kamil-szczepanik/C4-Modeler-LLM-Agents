@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Clinical Core Service container

System_Ext(SIEM_and_Immutable_Cold_Storage, "SIEM & Immutable Cold Storage", "External system for storing audit events")
System_Ext(External_Lab_and_Imaging_Systems, "External Lab & Imaging Systems", "External diagnostic systems")

Container_Boundary(Clinical_Core_Service, "Clinical Core Service") {
    Component(EMR_Management_Component, "EMR Management Component", "Go / Spring Boot, PostgreSQL, RocksDB", "Manages electronic medical records, executes local DB queries, and pulls diagnostic payloads.")
    Component(Clinical_Workflow_Engine, "Clinical Workflow Engine", "Go / Spring Boot, Temporal", "Handles clinical workflows, execution of commands, and state consistency.")
    Component(Edge_Cache_and_Sync_Component, "Edge Cache & Sync Component", "Redis, RocksDB, Vector Clocks", "Provides edge caching and performs asynchronous eventual-consistency sync.")
    Component(Audit_Interceptor, "Audit Interceptor", "Go / Spring Boot", "Intercepts operations and streams signed, tamper-evident audit events.")
}

Rel(Clinical_Workflow_Engine, EMR_Management_Component, "Executes local DB queries", "JDBC over SSL")
Rel(Edge_Cache_and_Sync_Component, EMR_Management_Component, "Performs asynchronous eventual-consistency sync", "gRPC")
Rel(Audit_Interceptor, SIEM_and_Immutable_Cold_Storage, "Streams signed, tamper-evident audit events", "TLS syslog / gRPC stream")
Rel(EMR_Management_Component, External_Lab_and_Imaging_Systems, "Pulls diagnostic payloads", "HL7 FHIR REST over HTTPS")

@enduml