@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(billing_and_claims_service, "Billing & Claims Service") {
    Component(Claim Management Component, "Claim Management Component", "Spring MVC/Data with Drools Rules Engine", "Automates insurance claim submissions and high-speed automated claim scrubbing.")
    Component(Payment Processing Component, "Payment Processing Component", "Spring Integration with Tokenization Vault", "Handles payment processing and submits transactions securely.")
    Component(Billing Engine / Ledger Component, "Billing Engine / Ledger Component", "PostgreSQL with AES-256 and TDE", "Manages financial ledger data and itemized statements with strict auditing.")
    Component(Audit & Retention Publisher, "Audit & Retention Publisher", "Java / Spring Boot", "Streams cryptographically signed audit logs to SIEM and immutable cold storage.")
}

System_Ext(RabbitMQ Message Broker, "RabbitMQ Message Broker", "External message broker system")
System_Ext(Payment Gateway / Insurance Clearinghouse, "Payment Gateway / Insurance Clearinghouse", "External payment gateway system")
System_Ext(PostgreSQL, "PostgreSQL", "External database system")
System_Ext(SIEM & Immutable Cold Storage, "SIEM & Immutable Cold Storage", "External audit and storage system")

Rel(Claim Management Component, RabbitMQ Message Broker, "Publishes scrubbed insurance claims", "AMQP with message-level envelope encryption")
Rel(Payment Processing Component, Payment Gateway / Insurance Clearinghouse, "Submits transactions", "Asynchronous messaging via RabbitMQ")
Rel(Billing Engine / Ledger Component, PostgreSQL, "Persists ledger data and itemized statements", "JDBC with column-level AES-256")
Rel(Audit & Retention Publisher, SIEM & Immutable Cold Storage, "Streams cryptographically signed audit logs", "TLS 1.3")

@enduml