@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Patient Portal App", "Patient Portal App") {
    Component("Presentation Controller", "Presentation Controller", "React SPA Component", "Powers the WCAG 2.1 AA accessible, mobile-responsive client-side SPA.")
    Component("BFF Router", "BFF Router", "Node.js/Express Component", "Implements the Backend-for-Frontend (BFF) pattern for secure aggregation and routing.")
    Component("Auth & Session Manager", "Auth & Session Manager", "Node.js/Passport.js Component", "Handles multi-factor authentication and token exchange.")
    Component("Appointment & Profile Client", "Appointment & Profile Client", "Node.js Component", "Manages appointment and profile operations.")
    Component("Telemetry & Audit Interceptor", "Telemetry & Audit Interceptor", "Node.js Middleware Component", "Facilitates distributed tracing and HIPAA/GDPR-compliant audit logging.")
}

Rel("Presentation Controller", "BFF Router", "HTTPS / TLS 1.3")
Rel("BFF Router", "Auth & Session Manager", "Internal Function Call")
Rel("BFF Router", "Appointment & Profile Client", "Internal Function Call")
Rel("Appointment & Profile Client", "API Gateway / Reverse Proxy", "gRPC over TLS 1.3")
Rel("Telemetry & Audit Interceptor", "SIEM / Logging Sidecar", "Syslog / OTLP")

@enduml