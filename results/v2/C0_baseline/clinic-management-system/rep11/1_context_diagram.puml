@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "Individuals receiving care at the clinic who interact with the system for scheduling and admissions.")
Person(Clinicians, "Clinicians", "Medical professionals who manage patient EMRs and clinical workflows.")
Person(Receptionists, "Receptionists", "Front-desk staff who handle patient scheduling and intake.")
Person(Billing Specialists, "Billing Specialists", "Administrative staff responsible for processing payments and managing billing.")
Person(Hospital Administrators, "Hospital Administrators", "Management personnel overseeing clinic operations and reporting.")

System(Clinic Management System, "Clinic Management System", "Core software system that manages patient admissions, EMRs, scheduling, and billing for medium-sized clinics in a hybrid cloud environment.")

System_Ext(External Lab & Imaging Systems, "External Lab & Imaging Systems", "Third-party systems providing laboratory results and medical imaging data.")
System_Ext(Payment Gateway / Insurance Clearinghouse, "Payment Gateway / Insurance Clearinghouse", "External financial services processing payments and insurance claims.")
System_Ext(Identity Provider (IdP), "Identity Provider (IdP)", "External or integrated identity service providing authentication and MFA.")

Rel(Patients, Clinic Management System, "Accesses scheduling and admissions", "HTTPS (TLS 1.3)")
Rel(Clinicians, Clinic Management System, "Manages patient EMRs and clinic workflows", "HTTPS (TLS 1.3)")
Rel(Receptionists, Clinic Management System, "Handles patient scheduling and intake", "HTTPS (TLS 1.3)")
Rel(Billing Specialists, Clinic Management System, "Manages billing and financial records", "HTTPS (TLS 1.3)")
Rel(Hospital Administrators, Clinic Management System, "Oversees clinic operations and reporting", "HTTPS (TLS 1.3)")
Rel(Clinic Management System, External Lab & Imaging Systems, "Exchanges lab and imaging data", "HL7 FHIR REST APIs over mTLS")
Rel(Clinic Management System, Payment Gateway / Insurance Clearinghouse, "Processes payments and insurance claims", "HTTPS / TLS 1.3")
Rel(Clinic Management System, Identity Provider (IdP), "Authenticates users and validates tokens", "OIDC / OAuth 2.0 with MFA")

@enduml