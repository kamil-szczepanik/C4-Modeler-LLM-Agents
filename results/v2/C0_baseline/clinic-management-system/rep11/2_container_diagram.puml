@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Patients, "Patients", "Individuals receiving care at the clinic who interact with the system for scheduling and admissions.")
Person(Clinicians, "Clinicians", "Medical professionals who manage patient EMRs and clinical workflows.")
Person(Receptionists, "Receptionists", "Front-desk staff who handle patient scheduling and intake.")
Person(Billing_Specialists, "Billing Specialists", "Administrative staff responsible for processing payments and managing billing.")
Person(Hospital_Administrators, "Hospital Administrators", "Management personnel overseeing clinic operations and reporting.")

System_Ext(External_Lab___Imaging_Systems, "External Lab & Imaging Systems", "Third-party systems providing laboratory results and medical imaging data.")
System_Ext(Payment_Gateway___Insurance_Clearinghouse, "Payment Gateway / Insurance Clearinghouse", "External financial services processing payments and insurance claims.")
System_Ext(Identity_Provider__IdP_, "Identity Provider (IdP)", "External or integrated identity service providing authentication and MFA.")

System_Boundary(Clinic_Management_System, "Clinic Management System") {
    Container(API_Gateway, "API Gateway", "Nginx / Envoy", "Handles TLS termination, routing, and OAuth2 validation.")
    Container(Patient_Web_Mobile_App, "Patient Web/Mobile App", "React / Flutter", "Client application for patients to manage scheduling and admissions.")
    Container(Clinical_Workstation_App, "Clinical Workstation App", "Angular / Electron", "Client application for clinicians, receptionists, and administrators.")
    Container(Core_Services_Container, "Core Services Container", "Java / Spring Boot", "Manages core clinical workflows, patient admissions, EMRs, and billing.")
    Container(Integration_Service, "Integration Service", "Node.js / Apache Camel", "Handles integration and HL7 FHIR communication with external health systems.")
    Container(Notification_Container, "Notification Container", "Python / Celery", "Manages asynchronous notification workflows and event consumption.")
    Container(Reporting___Analytics_Container, "Reporting & Analytics Container", "Analytics Platform", "Processes OLAP data for clinic reporting and analytics.")
    ContainerDb(PostgreSQL, "PostgreSQL", "PostgreSQL (OLTP with AES-256)", "Primary relational database for transactional operational data.")
    ContainerDb(ClickHouse, "ClickHouse", "ClickHouse (OLAP)", "Analytical database for reporting and analytics.")
    ContainerDb(Redis, "Redis", "Redis", "In-memory data store used for scheduling locks and caching.")
    Container(Apache_Kafka, "Apache Kafka", "Apache Kafka", "Message broker for asynchronous event-driven microservices decoupling.")
}

Rel(Patients, Patient_Web_Mobile_App, "Interacts with scheduling, admissions, and EMR features", "HTTPS/JSON")
Rel(Clinicians, Clinical_Workstation_App, "Manages patient EMRs and clinical workflows", "HTTPS/JSON")
Rel(Receptionists, Clinical_Workstation_App, "Handles patient scheduling and intake", "HTTPS/JSON")
Rel(Billing_Specialists, Clinical_Workstation_App, "Manages billing and financial records", "HTTPS/JSON")
Rel(Hospital_Administrators, Clinical_Workstation_App, "Oversees clinic operations and reporting", "HTTPS/JSON")

Rel(Patient_Web_Mobile_App, API_Gateway, "Sends client requests", "HTTPS/JSON and gRPC")
Rel(Clinical_Workstation_App, API_Gateway, "Sends client requests", "HTTPS/JSON and gRPC")

Rel(API_Gateway, Core_Services_Container, "Routes authenticated requests", "mTLS via Istio service mesh")
Rel(API_Gateway, Identity_Provider__IdP_, "Validates OAuth2 tokens and authentication", "OIDC / OAuth2")

Rel(Core_Services_Container, PostgreSQL, "Reads and writes transactional data", "JDBC / SQL")
Rel(Core_Services_Container, Redis, "Manages scheduling locks and caching", "Redis Protocol")
Rel(Core_Services_Container, Apache_Kafka, "Publishes asynchronous domain events", "Kafka Protocol")

Rel(Integration_Service, External_Lab___Imaging_Systems, "Exchanges clinical data", "HL7 FHIR APIs over HTTPS")
Rel(Integration_Service, Payment_Gateway___Insurance_Clearinghouse, "Processes insurance claims and payments", "HTTPS")

Rel(Notification_Container, Apache_Kafka, "Consumes asynchronous notification events", "Kafka Protocol")
Rel(Reporting___Analytics_Container, Apache_Kafka, "Consumes analytics events", "Kafka Protocol")
Rel(Reporting___Analytics_Container, ClickHouse, "Queries and stores analytics data", "TCP / SQL")

@enduml