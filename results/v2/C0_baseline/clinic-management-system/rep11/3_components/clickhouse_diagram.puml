@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(ClickHouse, "ClickHouse") {
    Component(ClickHouse OLAP Engine, "ClickHouse OLAP Engine", "ClickHouse with AggregatingMergeTree", "Columnar database engine executing sub-second analytical queries on sanitized event streams.")
    Component(ClickHouse Keeper, "ClickHouse Keeper", "ClickHouse Keeper", "Replicated consensus module managing cluster coordination without WAN bottlenecks.")
}

Rel(ClickHouse Keeper, ClickHouse OLAP Engine, "Manages cluster coordination and consensus", "")

@enduml