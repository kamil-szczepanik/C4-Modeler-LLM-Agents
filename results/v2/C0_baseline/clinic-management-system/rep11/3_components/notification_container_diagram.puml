@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Notification Container", "Notification Container") {
    Component("Event Consumer", "Event Consumer", "Python / Celery", "Consumes asynchronous events from Apache Kafka.")
    Component("Template Sanitizer", "Template Sanitizer", "Python", "Sanitizes message templates for notification generation.")
    Component("Dispatch Engine", "Dispatch Engine", "Python", "Manages the dispatch of notifications to various channel adapters.")
    Component("Channel Adapters", "Channel Adapters", "Python / Twilio / SendGrid / Firebase", "Adapters for delivering messages via SMS, Email, and Push.")
    Component("Delivery Status Webhook Receiver", "Delivery Status Webhook Receiver", "Python", "Receives status callbacks from channel adapters.")
    Component("Event Producer", "Event Producer", "Python / Celery", "Publishes anonymized telemetry and events.")
}

System_Ext("Apache Kafka", "Apache Kafka", "Event streaming platform.")

Rel("Notification Container", "Apache Kafka", "Consumes async events and publishes anonymized telemetry", "Kafka Protocol with mTLS / SASL/SCRAM")
Rel("Dispatch Engine", "Channel Adapters", "Message delivery", "HTTPS")
Rel("Channel Adapters", "Delivery Status Webhook Receiver", "Status callbacks", "HTTPS")

@enduml