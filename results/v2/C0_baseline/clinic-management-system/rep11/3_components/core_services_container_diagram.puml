@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(core_services_container, "Core Services Container") {
    Component(patient_management, "Patient Management", "Java / Spring Boot", "Manages patient admissions and demographic records.")
    Component(scheduling, "Scheduling", "Java / Spring Boot", "Handles appointments and manages scheduling locks.")
    Component(emr_core, "EMR Core", "Java / Spring Boot", "Manages electronic medical records workflows.")
    Component(billing, "Billing", "Java / Spring Boot", "Handles billing and insurance claims processing.")
}

System_Ext(redis, "Redis", "Caching and state management")
System_Ext(postgresql, "PostgreSQL", "Relational database for transactional clinical data")
System_Ext(apache_kafka, "Apache Kafka", "Event streaming platform")

Rel(scheduling, redis, "Manages scheduling locks, caching, and state", "Redis Protocol with AES-256")
Rel(patient_management, postgresql, "Reads and writes transactional clinical data", "JDBC / SQL")
Rel(scheduling, postgresql, "Reads and writes transactional clinical data", "JDBC / SQL")
Rel(emr_core, postgresql, "Reads and writes transactional clinical data", "JDBC / SQL")
Rel(billing, postgresql, "Reads and writes transactional clinical data", "JDBC / SQL")
Rel(billing, apache_kafka, "Publishes asynchronous domain events and insurance claims", "Kafka Protocol")
Rel(patient_management, apache_kafka, "Publishes asynchronous domain events", "Kafka Protocol")

@enduml