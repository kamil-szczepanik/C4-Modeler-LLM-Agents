@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Service container

System_Ext(External_Lab_Imaging_Systems, "External Lab & Imaging Systems", "External system")
System_Ext(Payment_Gateway_Insurance_Clearinghouse, "Payment Gateway / Insurance Clearinghouse", "External system")
System_Ext(Apache_Kafka, "Apache Kafka", "Messaging system")
System_Ext(PostgreSQL, "PostgreSQL", "Database")

Container_Boundary(Integration_Service, "Integration Service") {
    Component(FHIR_Ingress_Egress, "FHIR Ingress/Egress", "Node.js / Apache Camel", "Exchanges clinical data using HL7 FHIR APIs over HTTPS with mTLS.")
    Component(Claims_Translation, "Claims Translation", "Node.js / Apache Camel", "Submits insurance claims and processes payments via HTTPS with OAuth 2.0.")
    Component(Dead_Letter_Audit_Publisher, "Dead Letter & Audit Publisher", "Node.js / Apache Camel", "Publishes asynchronous domain events, audit logs, and alerts using JSON to Apache Kafka.")
    Component(Retry_Backoff_Orchestrator, "Retry & Backoff Orchestrator", "Node.js / Apache Camel", "Persists retry states and durable transactional data using AES-256 encryption to PostgreSQL.")
}

Rel(FHIR_Ingress_Egress, External_Lab_Imaging_Systems, "Exchanges clinical data using HL7 FHIR APIs over HTTPS with mTLS", "HTTPS/mTLS")
Rel(Claims_Translation, Payment_Gateway_Insurance_Clearinghouse, "Submits insurance claims and processes payments via HTTPS with OAuth 2.0", "HTTPS/OAuth 2.0")
Rel(Dead_Letter_Audit_Publisher, Apache_Kafka, "Publishes asynchronous domain events, audit logs, and alerts using JSON", "JSON")
Rel(Retry_Backoff_Orchestrator, PostgreSQL, "Persists retry states and durable transactional data using AES-256 encryption", "TCP/AES-256")

@enduml