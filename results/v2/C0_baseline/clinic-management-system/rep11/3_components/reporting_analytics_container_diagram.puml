@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Hospital Administrators & Billing Specialists, "Hospital Administrators & Billing Specialists", "Users who access reports and operational dashboards.")

System_Boundary(Reporting & Analytics Container, "Reporting & Analytics Container") {
    Component(Report Query Engine, "Report Query Engine", "Apache Superset / Python", "Powers real-time operational dashboards and the ad-hoc query semantic layer.")
    Component(Batch ETL Worker, "Batch ETL Worker", "Apache Spark / Python", "Handles heavy, scheduled historical aggregation jobs for long-term trends.")
    Component(Data Anonymization & Governance Proxy, "Data Anonymization & Governance Proxy", "Python", "Enforces secure, HIPAA/GDPR-compliant data filtering and masking.")
    Component(Ad-Hoc Query Planner, "Ad-Hoc Query Planner", "Python", "Plans and optimizes ad-hoc analytical queries.")
    ComponentDb(ClickHouse OLAP Database, "ClickHouse OLAP Database", "ClickHouse", "Stores high-volume OLAP data for fast analytics queries.")
    Component(Apache Kafka, "Apache Kafka", "Apache Kafka", "Streaming platform for ingestion and event processing.")
    ComponentDb(Redis, "Redis", "Redis", "Caches policy-filtered query payloads securely with AES-256 encryption.")
}

Rel(Hospital Administrators & Billing Specialists, Report Query Engine, "Accesses reports and dashboards", "HTTPS")
Rel(Report Query Engine, Data Anonymization & Governance Proxy, "Routes queries through governance proxy", "gRPC")
Rel(Report Query Engine, ClickHouse OLAP Database, "Queries data", "TCP / SQL")
Rel(Batch ETL Worker, Apache Kafka, "Consumes data", "Kafka Protocol")

@enduml