@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "Nginx / Envoy", "External API Gateway routing requests to core services.")

Container_Boundary(clinical_workstation_app, "Clinical Workstation App") {
    Component(workspace_shell_component, "Workspace Shell Component", "Angular / Electron", "Provides the desktop application frame and dynamic UI composition.")
    Component(emr_scheduling_module_components, "EMR & Scheduling Module Components", "Angular", "Handles patient records, scheduling, and billing workflows.")
    Component(local_persistence_store, "Local Persistence Store", "IndexedDB / SQLite", "Provides local persistence for offline resilience and EMR caching.")
    Component(sync_engine_component, "Sync Engine Component", "Electron IPC / TypeScript", "Manages offline queue, state, and synchronization with the cloud backend.")
    Component(conflict_resolution_manager_component, "Conflict Resolution Manager Component", "TypeScript", "Resolves synchronization conflicts during data reconciliation.")
    Component(ipc_security_bridge_component, "IPC Security Bridge Component", "Electron IPC", "Secures inter-process communication between the UI and local store.")
}

Rel(sync_engine_component, local_persistence_store, "Manages offline queue and state", "SQLite/IndexedDB IPC")
Rel(workspace_shell_component, api_gateway, "Sends requests and syncs data", "gRPC-Web / HTTPS")
@enduml