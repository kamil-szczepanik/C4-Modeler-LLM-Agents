@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Core_Services_Container, "Core Services Container", "Java / Spring Boot", "Core business logic and EMR processing.")

Container_Boundary(Redis, "Redis") {
    Component(Redis_Master_Replica_Cluster, "Redis Master/Replica Cluster", "In-memory data store, Redis Operator, volatile-lru", "Manages caching, ephemeral data, and distributed scheduling locks with high availability.")
}

Rel(Core_Services_Container, Redis_Master_Replica_Cluster, "Manages scheduling locks and transient caching", "Redis Protocol over mTLS with TLS")

@enduml