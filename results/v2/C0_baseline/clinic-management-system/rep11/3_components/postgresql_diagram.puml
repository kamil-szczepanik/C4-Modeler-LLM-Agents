@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL container

Container_Boundary(postgresql, "PostgreSQL") {
    Component(ConnectionPooler, "Connection Pooler", "PgBouncer", "Optimizes throughput and routes transactional queries to maintain low latency.")
    Component(PostgreSQLPrimaryInstance, "PostgreSQL Primary Instance", "PostgreSQL 16 on Kubernetes", "Handles core transactional queries and operational data integrity.")
    Component(PostgreSQLStandbyInstances, "PostgreSQL Standby Instances", "Streaming Replication, Patroni on Kubernetes", "Provides high availability and synchronous data replication for zero data loss.")
    Component(AuditExtensionModule, "Audit Extension Module", "pg_audit", "Implements tamper-proof audit trails to satisfy security mandates.")
    Component(EncryptionManager, "Encryption Manager", "pgcrypto / Transparent Data Encryption", "Provides AES-256 encryption at rest.")
    Component(DataMaskingPurgingComponent, "Data Masking & Purging Component", "PostgreSQL RLS & PL/pgSQL functions", "Executes GDPR compliance queries and manages data retention.")
    Component(ArchivingService, "Archiving Service", "pgBackRest with cold object storage", "Manages continuous WAL archiving and automated backups for the 10-year retention policy.")
}

Rel(ConnectionPooler, PostgreSQLPrimaryInstance, "Forwards operational queries", "TCP")
Rel(PostgreSQLPrimaryInstance, PostgreSQLStandbyInstances, "Synchronous data replication", "TCP")
Rel(PostgreSQLPrimaryInstance, ArchivingService, "Continuous WAL archiving", "TCP / Object Storage API")

@enduml