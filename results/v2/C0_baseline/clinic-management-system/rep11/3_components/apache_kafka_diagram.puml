@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(apache_kafka, "Apache Kafka") {
    Component(Kafka Broker Cluster, "Kafka Broker Cluster", "Java/Scala", "Manages asynchronous event-driven microservices decoupling with acks=all and MirrorMaker 2.")
    Component(Schema Registry, "Schema Registry", "Java/Confluent", "Validates event schemas prior to publishing.")
    Component(Kafka Connect, "Kafka Connect", "Java", "Streams raw events to persistent sinks and offloads sanitized historical data.")
}

Rel(Schema Registry, Kafka Broker Cluster, "Provides schema validation for events", "HTTP/REST over TLS 1.3")
Rel(Kafka Broker Cluster, Kafka Connect, "Streams raw events to persistent sinks", "Kafka Protocol")
@enduml