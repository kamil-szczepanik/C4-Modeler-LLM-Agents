@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

System_Ext(idp, "Identity Provider (IdP)", "External Identity Provider")
System_Ext(core_services, "Core Services Container", "Backend core services container")
System_Ext(integration_service, "Integration Service", "Integration service container")

Container_Boundary(api_gateway, "API Gateway") {
    Component(edge_router, "Edge Router & TLS Terminator", "Envoy Proxy", "Edge container handling TLS termination and routing.")
    Component(auth_filter, "Auth & Token Introspection Filter", "Envoy Proxy Plugin", "Validates opaque tokens and performs OAuth2 validation.")
    Component(rate_limiter, "Rate Limiting & Throttling Engine", "Envoy with Redis", "Handles distributed rate-limiting and session state caching.")
    Component(schema_validator, "API Schema Validation & Sanitization Filter", "Envoy WebAssembly (Wasm)/Lua", "Performs high-performance routing and lightweight schema validation.")
}

Rel(auth_filter, idp, "Validates opaque tokens", "HTTPS/OIDC")
Rel(edge_router, core_services, "Forwards validated requests", "gRPC/mTLS via Istio")
Rel(edge_router, integration_service, "Routes FHIR requests", "gRPC/mTLS")

@enduml