@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient Web/Mobile App container

System_Ext(IdentityProvider, "Identity Provider", "External identity provider for user authentication and session management.", "OIDC")
Container(NotificationContainer, "Notification Container", "APNs / FCM", "Sends push alerts and notifications.")
Container(APIGateway, "API Gateway", "HTTPS/JSON and gRPC", "Proxies business requests from the client layer.")

Container_Boundary(PatientWebMobileApp, "Patient Web/Mobile App") {
    Component(AuthClientModule, "Auth Client Module", "OAuth2/OIDC, Biometrics, Platform-Native Secure Enclaves / Keychain, Play Integrity / App Attest", "Handles OAuth2/OIDC token exchange, multi-factor authentication, biometrics, and device integrity checks.")
    Component(SchedulingIntakeUI, "Scheduling & Intake UI", "React / Flutter, WCAG 2.1 AA", "Manages client-side state for patient registration and appointment booking under WCAG 2.1 AA standards.")
    Component(APIClientLayer, "API Client Layer", "HTTPS/JSON and gRPC, TLS 1.3, Encrypted Local Storage", "Manages secure communication with certificate pinning and encrypted local storage.")
    Component(PushNotificationHandler, "Push Notification Handler", "APNs / FCM", "Manages device registration tokens and receives push payloads (APNs/FCM).")
}

Rel(AuthClientModule, IdentityProvider, "Authenticates users and manages sessions via [HTTPS/OIDC].", "HTTPS/OIDC")
Rel(PushNotificationHandler, NotificationContainer, "Receives push alerts via [APNs/FCM].", "APNs/FCM")
Rel(SchedulingIntakeUI, APIClientLayer, "Sends domain actions locally.", "Local")
Rel(APIClientLayer, APIGateway, "Proxies business requests via [HTTPS/JSON and gRPC] with TLS 1.3.", "HTTPS/JSON and gRPC, TLS 1.3")

@enduml