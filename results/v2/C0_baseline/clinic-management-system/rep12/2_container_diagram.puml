@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Patients, "Patients", "Interacts with the system for scheduling and managing healthcare services.")
Person(Receptionists, "Receptionists", "Manages patient admissions, scheduling, and front-desk operations.")
Person(Clinicians, "Clinicians", "Accesses and updates Electronic Medical Records (EMRs) and clinical data.")
Person(Billing Specialists, "Billing Specialists", "Handles billing, payments, and insurance claims processing.")
Person(Clinic Administrators, "Clinic Administrators", "Manages administrative operations and system oversight.")

System_Ext(External Lab & Imaging Systems, "External Lab & Imaging Systems", "Provides diagnostic results and medical imaging data via interoperability standards.")
System_Ext(Payment Gateways, "Payment Gateways", "Processes secure financial transactions and credit card payments.")
System_Ext(Insurance Clearinghouses, "Insurance Clearinghouses", "Handles healthcare insurance claims processing.")
System_Ext(Identity Provider, "Identity Provider", "Handles Multi-Factor Authentication (MFA) and session management using OIDC/SAML 2.0.")

System_Boundary(Clinic_Management_System, "Clinic Management System") {
    Container(React SPA & Patient Portal BFF, "React SPA & Patient Portal BFF", "React & Node.js/NestJS", "Responsive client interfaces and backend-for-frontend for web client interactions.")
    Container(Kong API Gateway, "Kong API Gateway", "Kong", "API routing, rate limiting, and zero-trust security enforcement.")
    Container(Istio Service Mesh, "Istio Service Mesh", "Istio", "Enforces zero-trust mTLS encryption across hybrid clusters.")
    Container(Spring Boot Core Services, "Spring Boot Core Services", "Spring Boot (Java)", "Handles core business logic for patient admissions, EMRs, scheduling, and billing.")
    Container(Apache Camel Integration Service, "Apache Camel Integration Service", "Apache Camel", "Connects to external Lab, Imaging, and Payment systems using HL7 FHIR and HTTPS.")
    Container(Go Audit Logging Container, "Go Audit Logging Container", "Go", "High-throughput write-optimized audit logging for compliance.")
    Container(Apache Superset Reporting Container, "Apache Superset Reporting Container", "Apache Superset", "Executes analytics and reporting workloads.")
    ContainerDb(PostgreSQL, "PostgreSQL", "PostgreSQL (Primary & Read-Replica)", "ACID-compliant transactional persistence and read-replicas for CQRS.")
    Container(Redis, "Redis", "Redis", "Distributed caching layer for high-performance data access.")
    Container(HashiCorp Vault, "HashiCorp Vault", "HashiCorp Vault", "Centralized secret management.")
}

Rel(Patients, React SPA & Patient Portal BFF, "Interacts with portal for scheduling and EMR access", "HTTPS/REST")
Rel(Receptionists, React SPA & Patient Portal BFF, "Manages admissions and scheduling", "HTTPS/REST")
Rel(Clinicians, React SPA & Patient Portal BFF, "Accesses and updates EMRs and clinical data", "HTTPS/REST")
Rel(Billing Specialists, React SPA & Patient Portal BFF, "Handles billing and financial transactions", "HTTPS/REST")
Rel(Clinic Administrators, React SPA & Patient Portal BFF, "Accesses system management interfaces", "HTTPS/REST")

Rel(React SPA & Patient Portal BFF, Kong API Gateway, "Sends client requests through API gateway", "HTTPS")
Rel(Kong API Gateway, Istio Service Mesh, "Routes and validates traffic using JWT, enforcing mTLS", "mTLS")
Rel(Kong API Gateway, Identity Provider, "Authenticates and authorizes users", "OIDC / SAML 2.0")

Rel(Istio Service Mesh, Spring Boot Core Services, "Routes secured traffic to core business logic", "gRPC/HTTP")
Rel(Istio Service Mesh, Apache Camel Integration Service, "Routes integration traffic", "gRPC/HTTP")
Rel(Istio Service Mesh, Go Audit Logging Container, "Sends audit events", "gRPC/HTTP")
Rel(Istio Service Mesh, Apache Superset Reporting Container, "Accesses reporting and analytics data", "HTTP")

Rel(Spring Boot Core Services, PostgreSQL, "Reads and writes transactional data", "JDBC")
Rel(Spring Boot Core Services, Redis, "Caches and retrieves session/data cache", "TCP")
Rel(Spring Boot Core Services, HashiCorp Vault, "Retrieves secrets and configuration", "HTTPS")

Rel(Apache Superset Reporting Container, PostgreSQL, "Queries data from read-replicas for analytics", "JDBC")

Rel(Apache Camel Integration Service, External Lab & Imaging Systems, "Exchanges diagnostic results and medical imaging", "HL7 FHIR over HTTPS")
Rel(Apache Camel Integration Service, Payment Gateways, "Processes payment transactions", "HTTPS")
Rel(Apache Camel Integration Service, Insurance Clearinghouses, "Handles claims processing", "HTTPS")

@enduml