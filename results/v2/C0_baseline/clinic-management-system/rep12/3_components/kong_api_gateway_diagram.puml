@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Kong API Gateway container

Container_Boundary(kong_api_gateway, "Kong API Gateway") {
    Component(Proxy_Router, "Proxy Router", "Kong Core / NGINX", "Centralized perimeter routing, SSL termination, and client request handling.")
    Component(Auth_Plugin, "Auth Plugin", "Kong Plugin / OIDC / SAML 2.0", "Authenticates and authorizes users in conjunction with the Identity Provider.")
    Component(Transform_and_Masking_Plugin, "Transform and Masking Plugin", "Kong Plugin", "Transforms payloads and masks sensitive HIPAA/GDPR data.")
    Component(Rate_Limiting, "Rate Limiting", "Kong Plugin / Redis", "Enforces distributed API rate-limiting backed by Redis Cluster.")
    Component(Analytics_Exporter, "Analytics Exporter", "Kong Plugin", "Exports metrics, telemetry, and structured audit logs.")
}

Rel(Proxy_Router, Auth_Plugin, "Delegates incoming requests for authentication and authorization", "OIDC / SAML 2.0")
Rel(Proxy_Router, Transform_and_Masking_Plugin, "Passes payloads for data transformation and masking")
Rel(Proxy_Router, Rate_Limiting, "Queries rate-limiting status", "RESP over TLS")
Rel(Analytics_Exporter, Go_Audit_Logging_Container, "Streams structured audit logs", "gRPC")
Rel(Proxy_Router, Istio_Service_Mesh, "Routes and validates outbound traffic", "mTLS")
@enduml