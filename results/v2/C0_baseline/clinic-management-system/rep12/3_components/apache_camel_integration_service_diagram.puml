@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Apache Camel Integration Service container

System_Ext(Istio_Service_Mesh, "Istio Service Mesh", "Service mesh and distributed tracing for observability and mTLS enforcement.")
System_Ext(External_Lab_Imaging_Systems, "External Lab & Imaging Systems", "External systems for diagnostic results and medical imaging.")
System_Ext(Third_Party_Payment_Gateways, "Third-Party Payment Gateways", "External payment processing services.")
System_Ext(Insurance_Clearinghouses, "Insurance Clearinghouses", "External claims processing services.")

Container_Boundary(Apache_Camel_Integration_Service, "Apache Camel Integration Service") {
    Component(FHIR_Ingestion_Route_Component, "FHIR Ingestion Route Component", "Apache Camel / Spring DSL", "Ingests and routes HL7 FHIR messages from external lab and imaging systems.")
    Component(EIP_Mediator_Component, "EIP Mediator Component", "Apache Camel", "Applies Enterprise Integration Patterns for message routing, transformation, and protocol bridging.")
    Component(Dead_Letter_Resilience_Handler_Component, "Dead-Letter & Resilience Handler Component", "Apache Camel Circuit Breaker / Kafka", "Handles failures, providing resilience via circuit breakers and Kafka-backed dead-letter queues.")
    Component(Payment_Clearinghouse_Adapter_Component, "Payment & Clearinghouse Adapter Component", "Apache Camel", "Adapts and communicates with third-party payment gateways and insurance clearinghouses.")
    Component(Idempotency_Deduplication_Engine, "Idempotency & Deduplication Engine", "Apache Camel Idempotent Consumer", "Checks and records message execution IDs to ensure message processing idempotency.")
    Component(Redis_Container, "Redis Container", "Redis", "Transient data store for high-performance message idempotency tracking.")
    Component(Apache_Superset_Reporting_Container, "Apache Superset Reporting Container", "Apache Superset", "Publishes real-time transaction metrics.")
    Component(Go_Audit_Logging_Container, "Go Audit Logging Container", "Go", "Emits tamper-evident audit events.")
    Component(HashiCorp_Vault, "HashiCorp Vault", "HashiCorp Vault", "Dynamic secrets management for OAuth2 credentials and client certificates.")
}

Rel(Istio_Service_Mesh, FHIR_Ingestion_Route_Component, "Routes integration traffic", "gRPC/HTTP")
Rel(FHIR_Ingestion_Route_Component, External_Lab_Imaging_Systems, "Exchanges diagnostic results and medical imaging", "HL7 FHIR over HTTPS, mTLS")
Rel(Payment_Clearinghouse_Adapter_Component, Third_Party_Payment_Gateways, "Processes payment transactions", "HTTPS, OAuth2")
Rel(Payment_Clearinghouse_Adapter_Component, Insurance_Clearinghouses, "Handles claims processing", "HTTPS, OAuth2")
Rel(Idempotency_Deduplication_Engine, Redis_Container, "Checks and records message execution IDs for idempotency", "Redis TCP/RESP")
Rel(EIP_Mediator_Component, Go_Audit_Logging_Container, "Emits tamper-evident audit events", "gRPC")
Rel(EIP_Mediator_Component, Apache_Superset_Reporting_Container, "Publishes real-time transaction metrics", "Prometheus/OpenTelemetry")

@enduml