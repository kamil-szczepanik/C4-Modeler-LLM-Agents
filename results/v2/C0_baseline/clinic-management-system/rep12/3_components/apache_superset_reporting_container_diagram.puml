@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(apache_superset_reporting_container, "Apache Superset Reporting Container") {
    Component(superset_web_server_ui, "Superset Web Server & UI", "Python/Flask", "Provides secure business intelligence and analytical reporting UI for hospital administrators and clinical operations managers.")
    Component(superset_celery_worker, "Superset Celery Worker", "Python/Celery", "Handles asynchronous task management and executes sanitized analytical queries.")
    Component(superset_metadata_db_connector, "Superset Metadata DB Connector", "SQLAlchemy", "Manages database connections and schema abstraction.")
    Component(semantic_layer_rls_engine, "Semantic Layer & RLS Engine", "Python/SQLAlchemy", "Applies data models, embedded Row-Level Security, and security filters enforcing HIPAA and GDPR compliance.")
    Component(postgresql_read_replica, "PostgreSQL Read-Replica", "PostgreSQL", "Stores and provides access to operational read-replica data.")
    Component(redis, "Redis", "Redis", "Manages broker and cache operations for ephemeral caching and message brokering.")
    Component(hashicorp_vault, "HashiCorp Vault", "HashiCorp Vault", "Provides dynamic runtime injection of secrets to avoid plain-text storage.")
    Component(go_audit_logging_container, "Go Audit Logging Container", "Go", "Receives forwarded dashboard data export events for compliance and tracking.")
}

Rel(superset_web_server_ui, semantic_layer_rls_engine, "Applies data models and security filters", "In-process Python Method Call")
Rel(superset_web_server_ui, redis, "Manages broker/cache operations", "Redis/TLS")
Rel(superset_celery_worker, redis, "Manages broker/cache operations", "Redis/TLS")
Rel(superset_celery_worker, postgresql_read_replica, "Executes sanitized analytical queries", "JDBC/TLS")
Rel(semantic_layer_rls_engine, go_audit_logging_container, "Forwards dashboard data export events", "HTTPS")

@enduml