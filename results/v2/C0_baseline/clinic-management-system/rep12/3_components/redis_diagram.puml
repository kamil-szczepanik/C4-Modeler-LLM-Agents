@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Redis container

Container(spring_boot_core_services, "Spring Boot Core Services", "Spring Boot", "Core application services.")
Container(go_audit_logging_container, "Go Audit Logging Container", "Go", "Handles audit logging.")

Container_Boundary(redis, "Redis") {
    Component(session_rate_limiting_engine, "Session & Rate-Limiting Engine", "Redis Core", "Manages user authentication tokens and API throttling.")
    Component(distributed_lock_manager, "Distributed Lock Manager", "Redlock Algorithm", "Executes atomic operations to prevent appointment resource clashes.")
    Component(data_caching_module, "Data Caching Module", "Redis Caching", "Retrieves non-PHI reference datasets and provides state management for high performance.")
}

Rel(spring_boot_core_services, session_rate_limiting_engine, "Manages user authentication tokens and API throttling", "RESP3 over TLS via Istio mTLS")
Rel(spring_boot_core_services, distributed_lock_manager, "Executes atomic operations to prevent appointment resource clashes", "RESP3 over TLS via Istio mTLS")
Rel(spring_boot_core_services, data_caching_module, "Retrieves non-PHI reference datasets", "RESP3 over TLS via Istio mTLS")
Rel(session_rate_limiting_engine, go_audit_logging_container, "Ships security events and audit logs", "Syslog over TCP/TLS")

@enduml