@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the HashiCorp Vault container

System_Ext(SpringBootCoreServices, "Spring Boot Core Services", "External service interacting with Vault components")
System_Ext(VaultOnPremK8s, "Vault (on-prem-k8s)", "External Vault cluster for replication")

Container_Boundary(HashiCorpVault, "HashiCorp Vault") {
    Component(TransitSecretsEngineComponent, "Transit Secrets Engine Component", "HashiCorp Vault Transit Engine", "Encryption-as-a-service for EMR data at rest.")
    Component(DatabaseSecretsEngineComponent, "Database Secrets Engine Component", "HashiCorp Vault Database Engine", "Manages dynamic PostgreSQL credentials.")
    Component(KubernetesAuthMethodComponent, "Kubernetes Auth Method Component", "HashiCorp Vault Kubernetes Auth", "Validates service accounts and issues short-lived tokens.")
    Component(EnterpriseReplicationComponent, "Enterprise Replication Component", "HashiCorp Vault Enterprise Replication", "Asynchronous state replication across clusters.")
    Component(ConsulStorageBackendRaftConsensusComponent, "Consul Storage Backend / Raft Consensus Component", "Raft Consensus / Consul Storage", "Local storage and high availability.")
}

Rel(SpringBootCoreServices, KubernetesAuthMethodComponent, "Authenticates via JWT", "HTTPS")
Rel(SpringBootCoreServices, TransitSecretsEngineComponent, "Encrypts/decrypts PHI data", "HTTPS/REST")
Rel(SpringBootCoreServices, DatabaseSecretsEngineComponent, "Fetches short-lived DB credentials", "HTTPS/REST")
Rel(EnterpriseReplicationComponent, VaultOnPremK8s, "Replicates state asynchronously", "TLS/TCP 8201")

@enduml