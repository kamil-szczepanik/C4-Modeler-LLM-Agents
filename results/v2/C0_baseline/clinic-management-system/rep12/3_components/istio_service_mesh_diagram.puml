@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(istio_service_mesh, "Istio Service Mesh") {
    Component(istio_ingress_gateway, "Istio Ingress Gateway", "Istio, Envoy Proxy", "Routes external traffic and forwards ingress traffic securely via mTLS.")
    Component(envoy_proxy, "Envoy Proxy", "Envoy Proxy", "Handles low-latency traffic interception and sidecar security.")
    Component(istiod, "Istiod", "Istiod", "Manages automated certificate authority issuance via HashiCorp Vault and distributes xDS configuration.")
}

Rel(istio_ingress_gateway, envoy_proxy, "Forwards ingress traffic", "mTLS")
Rel(istiod, envoy_proxy, "Distributes X.509 certs and xDS configuration", "gRPC")

@enduml