@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Spring Boot Core Services container

Container_Boundary(spring_boot_core_services, "Spring Boot Core Services") {
    Component(PatientManagement, "Patient Management", "Spring Boot, Java", "Handles patient admissions and profile data.")
    Component(SchedulingEngine, "Scheduling Engine", "Spring Boot, Java", "Manages appointment scheduling utilizing Redis for distributed locking.")
    Component(EMRCore, "EMR Core", "Spring Boot, Java", "Manages Electronic Medical Records with sub-second latency requirements.")
    Component(BillingClaims, "Billing & Claims", "Spring Boot, Java", "Handles billing processing and claims management.")
    Component(SecurityMaskingInterceptor, "Security/Masking Interceptor", "Spring Boot, Java", "Enforces stringent security and data masking protocols for HIPAA and GDPR compliance.")
    Component(EventDrivenAuditComponent, "Event-Driven Audit Component", "Spring Boot, Java", "Processes asynchronous event processing for auditing operations.")
    Component(DataAccessEncryptionInterceptor, "Data-Access Encryption Interceptor", "Spring Data JPA, Hibernate, Java", "Handles transactional persistence and data encryption using custom JPA AttributeConverters.")
}

Rel(PatientManagement, DataAccessEncryptionInterceptor, "Persists and retrieves encrypted patient data")
Rel(SchedulingEngine, DataAccessEncryptionInterceptor, "Persists appointment data")
Rel(EMRCore, DataAccessEncryptionInterceptor, "Persists EMR records securely")
Rel(BillingClaims, DataAccessEncryptionInterceptor, "Persists billing transactions")

@enduml