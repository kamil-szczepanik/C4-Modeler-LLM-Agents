@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patient, "Patient", "Interacts with the system for scheduling and managing healthcare services.")
Person(Receptionist_Administrative_Staff, "Receptionist / Administrative Staff", "Manages patient admissions, scheduling, and front-desk operations.")
Person(Clinician_Doctor, "Clinician / Doctor", "Accesses and updates Electronic Medical Records (EMRs) and clinical data.")
Person(Billing_Specialist, "Billing Specialist", "Handles billing, payments, and insurance claims processing.")

System(Clinic_Management_System, "Clinic Management System", "Manages patient admissions, EMRs, scheduling, and billing for healthcare providers on a secure, highly available hybrid cloud platform ensuring strict HIPAA and GDPR compliance.")

System_Ext(External_Lab_Imaging_Systems, "External Lab & Imaging Systems", "Provides diagnostic results and medical imaging data via interoperability standards.")
System_Ext(Third_Party_Payment_Gateway_Insurance_Clearinghouses, "Third-Party Payment Gateway & Insurance Clearinghouses", "Processes payments and handles healthcare insurance claims.")
System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "Handles Multi-Factor Authentication (MFA) and session management using OIDC/SAML 2.0.")

Rel(Patient, Clinic_Management_System, "Accesses user interface and web client for interactions", "HTTPS / TLS 1.3")
Rel(Receptionist_Administrative_Staff, Clinic_Management_System, "Manages admissions and scheduling via web client", "HTTPS / TLS 1.3")
Rel(Clinician_Doctor, Clinic_Management_System, "Accesses EMRs and patient care data", "HTTPS / TLS 1.3")
Rel(Billing_Specialist, Clinic_Management_System, "Manages financial transactions and billing", "HTTPS / TLS 1.3")
Rel(Clinic_Management_System, Identity_Provider_IdP, "Authenticates users via MFA and manages sessions", "OpenID Connect (OIDC) / SAML 2.0")
Rel(Clinic_Management_System, External_Lab_Imaging_Systems, "Retrieves diagnostic results and medical imaging", "HL7 FHIR over HTTPS (REST/JSON)")
Rel(Clinic_Management_System, Third_Party_Payment_Gateway_Insurance_Clearinghouses, "Processes billing and claims", "Secure HTTPS API")

@enduml