@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Patient, "Patient", "End-user interacting with the portal for healthcare services.")

System_Ext(API Gateway, "API Gateway", "Routing requests between services.")
System_Ext(Enterprise IdP, "Enterprise IdP", "External identity provider for authentication.")

Container_Boundary("Patient Portal Container", "Patient Portal Container") {
    Component(Portal UI Component, "Portal UI Component", "React and Tailwind CSS", "Interface ensuring WCAG 2.1 AA accessibility.")
    Component(Patient BFF Component, "Patient BFF Component", "Next.js API Routes and Node.js server runtime", "Manages sessions and data aggregation.")
    Component(Session & Token Manager Component, "Session & Token Manager Component", "OAuth2/OIDC", "Handles OAuth2/OIDC token exchange and multi-factor authentication.")
    Component(Client-Side State & Cache Component, "Client-Side State & Cache Component", "React Query and React Context", "Managing localized UI state and non-sensitive cache.")
}

Rel(Patient, Portal UI Component, "Interacts with portal for health records and scheduling", "HTTPS / TLS")
Rel(Portal UI Component, Patient BFF Component, "Internal API calls", "HTTPS")
Rel(Patient BFF Component, API Gateway, "Proxies backend requests", "HTTPS / REST / GraphQL, TLS")
Rel(Patient BFF Component, Enterprise IdP, "Exchanges and validates tokens", "OAuth2/OIDC via HTTPS")
Rel(Portal UI Component, Client-Side State & Cache Component, "Manages local data flow", "In-Memory")

@enduml