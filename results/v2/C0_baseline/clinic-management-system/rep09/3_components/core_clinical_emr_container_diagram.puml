@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Clinical & EMR Container container

Container_Boundary(core_clinical_emr_container, "Core Clinical & EMR Container") {
    Component(Admission_Demographics_Component, "Admission & Demographics Component", "Spring Boot 3 / Java 21", "Manages patient admissions and demographic information.")
    Component(EMR_Clinical_Core_Component, "EMR Clinical Core Component", "Spring Boot 3 / Java 21", "Handles electronic medical records and core clinical workflows.")
    Component(Audit_Trail_Manager, "Audit Trail Manager", "Spring Boot 3 / Java 21", "Manages tamper-proof audit trails and asynchronous event publishing.")
    Component(Data_Access_Layer_Encryption_Engine, "Data Access Layer / Encryption Engine", "Hibernate with custom types, AES-256", "Handles database transactions and field-level encryption at rest.")
    Component(Redis_L2_Cache_Layer, "Redis L2 Cache Layer", "Redis, TCP/RESP over mTLS", "Accelerates active EMR reads while maintaining encrypted PHI.")
    Component(Audit_Sidecar_Container, "Audit Sidecar Container", "Container Sidecar, gRPC", "Receives batched cryptographic logs from the Audit Trail Manager.")
}

System_Ext(External_PostgreSQL, "External PostgreSQL", "PostgreSQL, mTLS and IAM authentication", "External database for persistent storage.")

Rel(Admission_Demographics_Component, Data_Access_Layer_Encryption_Engine, "In-process method calls", "Java")
Rel(EMR_Clinical_Core_Component, Data_Access_Layer_Encryption_Engine, "In-process method calls", "Java")
Rel(EMR_Clinical_Core_Component, Redis_L2_Cache_Layer, "Read/Write active clinical data", "TCP/RESP over mTLS")
Rel(EMR_Clinical_Core_Component, Audit_Trail_Manager, "Async event publishing", "Spring Application Events")
Rel(Audit_Trail_Manager, Audit_Sidecar_Container, "Push batched cryptographic logs", "gRPC")
Rel(core_clinical_emr_container, External_PostgreSQL, "Database transactions", "mTLS and IAM authentication")

@enduml