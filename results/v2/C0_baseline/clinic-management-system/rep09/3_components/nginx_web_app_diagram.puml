@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Nginx Web App container

Container_Boundary(nginx_web_app, "Nginx Web App") {
    Component(Nginx_Reverse_Proxy_Static_File_Server, "Nginx Reverse Proxy & Static File Server", "Nginx Alpine", "Provides a minimal attack surface, low resource footprint, robust static caching, and reverse proxy capabilities.")
    Component(Single_Page_Application_SPA_Runtime, "Single Page Application (SPA) Runtime", "React / TypeScript", "Provides a dynamic, type-safe Single Page Application runtime for staff workflows.")
    Component(Client_Side_Router_State_Manager_Component, "Client-Side Router / State Manager Component", "TypeScript", "Manages client-side routing and application state for clinical and administrative workflows.")
    Component(Kubernetes_Ingress_Controller, "Kubernetes Ingress Controller", "Kubernetes Ingress", "Routes external traffic using mTLS to the Nginx Web App.")
    Component(Kubernetes_Deployment_HPA, "Kubernetes Deployment & HPA", "Kubernetes & HPA", "Guarantees 99.99% availability with a minimum of 3 replicas across hybrid targets.")
}

Rel(Kubernetes_Ingress_Controller, Nginx_Reverse_Proxy_Static_File_Server, "Routes external traffic using mTLS", "")
Rel(Nginx_Reverse_Proxy_Static_File_Server, Single_Page_Application_SPA_Runtime, "Serves static HTML/JS/CSS assets via local disk read", "")
Rel(Single_Page_Application_SPA_Runtime, Client_Side_Router_State_Manager_Component, "Manages navigation and state", "")
Rel(Single_Page_Application_SPA_Runtime, API_Gateway, "Forwards authenticated API calls via HTTPS / REST / JSON over TLS", "HTTPS / REST / JSON")

@enduml