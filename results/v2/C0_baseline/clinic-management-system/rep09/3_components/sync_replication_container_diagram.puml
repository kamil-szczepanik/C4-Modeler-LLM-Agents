@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Sync/Replication Container container

System_Boundary(sync_replication_container, "Sync/Replication Container") {
    Component(TransactionalOutboxPoller, "Transactional Outbox Poller", "Go / Java", "Polls transactional outbox for database changes.")
    Component(PayloadEncryptionInterceptor, "Payload Encryption Interceptor", "Go / Java", "Encrypts payloads using HashiCorp Vault REST/TLS 1.3.")
    Component(ConflictResolutionEngine, "Conflict Resolution Engine", "Go / Java", "Resolves synchronization conflicts and communicates with the audit sidecar.")
    Component(QuarantineAuditManager, "Quarantine & Audit Manager", "Go / Java", "Manages quarantine and audit processes for hybrid replication.")
}

System_Ext(HashiCorpVault, "HashiCorp Vault", "Envelope encryption (AES-256) and DEK management")
System_Ext(AuditSidecar, "Audit Sidecar", "OpenTelemetry, HashiCorp Vault")

Rel(TransactionalOutboxPoller, PayloadEncryptionInterceptor, "Passes outbox messages for encryption")
Rel(PayloadEncryptionInterceptor, HashiCorpVault, "REST / TLS 1.3", "REST / TLS 1.3 for DEK management")
Rel(ConflictResolutionEngine, AuditSidecar, "gRPC over localhost", "gRPC over localhost")

@enduml