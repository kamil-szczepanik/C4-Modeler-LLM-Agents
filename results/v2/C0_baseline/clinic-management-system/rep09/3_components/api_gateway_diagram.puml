@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway_boundary, "API Gateway") {
    Component(api_gateway, "API Gateway", "Kong Enterprise / Envoy Proxy", "High-performance edge routing and security enforcement.")
    Component(auth_filter, "Authentication & Token Validation Filter", "Kong / Envoy Plugin", "Validates tokens against the Enterprise IdP.")
    Component(rate_limiter, "Rate Limiting & Throttling Engine", "Kong / Envoy Plugin", "Manages rate limits using a distributed token-bucket store.")
    Component(circuit_breaker, "Circuit Breaker & Routing Proxy", "Envoy Proxy", "Routes service requests and implements resilience patterns.")
    Component(audit_interceptor, "Consent & Audit Logging Interceptor", "Envoy WASM / OpenTelemetry", "Streams asynchronous audit logs without impacting performance.")
}

Component(idp, "Enterprise Identity Provider (IdP)", "OIDC / OAuth2", "Provides authentication and token validation services.")
Component(redis, "Redis Distributed Token-Bucket Store", "Redis", "Stores and manages distributed, low-latency rate counters.")
Component(audit_sidecar, "Audit Sidecar Container", "OpenTelemetry Collector / Sidecar", "Receives asynchronous audit logs from the audit interceptor.")
Component(core_emr, "Core Clinical & EMR Container", "Container", "Core clinical and EMR backend services.")

Rel(auth_filter, idp, "Validates tokens", "HTTPS / OIDC via TLS")
Rel(rate_limiter, redis, "Reads/writes rate counters", "RESP over TLS")
Rel(api_gateway, core_emr, "Routes service requests", "gRPC over mTLS")
Rel(audit_interceptor, audit_sidecar, "Streams asynchronous audit logs", "gRPC")

@enduml