@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(hl7_fhir_interoperability_container, "HL7 FHIR Interoperability Container") {
    Component(FHIR_API_Router, "FHIR API Router", "Node.js (Express/NestJS)", "Routes incoming FHIR API requests to appropriate internal handlers.")
    Component(SMART_on_FHIR_Authorizer, "SMART-on-FHIR Authorizer", "OAuth2 / SMART-on-FHIR Middleware", "Authorizes requests using SMART-on-FHIR and OAuth2 protocols.")
    Component(FHIR_Validation___Transformation_Engine, "FHIR Validation & Transformation Engine", "Node.js / Apache Camel", "Validates and transforms FHIR payloads to ensure standard compliance.")
    Component(Outbox_Event_Publisher, "Outbox Event Publisher", "Apache Kafka Client", "Publishes domain events via an outbox pattern for reliable messaging.")
    Component(External_TLS_Client_Connector, "External TLS Client Connector", "Node.js TLS/HTTPS Client", "Handles outbound secure connections to external systems.")
    Component(Circuit_Breaker_Proxy, "Circuit Breaker Proxy", "Resilience4j", "Protects outbound calls to external labs and imaging systems using circuit breaking.")
    Component(PHI_Sanitization_Middleware, "PHI Sanitization Middleware", "Node.js Middleware", "Sanitizes protected health information (PHI) to maintain security compliance.")
}

Rel(FHIR_API_Router, SMART_on_FHIR_Authorizer, "In-memory middleware", "")
Rel(FHIR_Validation___Transformation_Engine, Outbox_Event_Publisher, "Internal message queue", "")
Rel(External_TLS_Client_Connector, Circuit_Breaker_Proxy, "In-memory invocation", "")
@enduml