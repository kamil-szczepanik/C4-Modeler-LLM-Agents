@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing & Claims Container container

Container_Boundary("Billing & Claims Container", "Billing & Claims Container") {
    Component("Billing API Controller", "Billing API Controller", "Spring Boot / Java 17", "Manages financial transactions, claim validation, and insurance submissions.")
    Component("Claim Validation Engine", "Claim Validation Engine", "Java 17", "Validates incoming claims against compliance and business rules.")
    Component("Claim Processing Service", "Claim Processing Service", "Spring Boot / Java 17", "Processes insurance claims and coordinates external gateway submissions.")
    Component("Patient Invoice Generator", "Patient Invoice Generator", "Spring Boot / Java 17", "Generates patient invoices based on billing records.")
    Component("Billing Data Access Layer", "Billing Data Access Layer", "PostgreSQL", "Persists billing data using JDBC with TLS and AES-256 column-level encryption.")
    Component("Audit Sidecar Container", "Audit Sidecar Container", "HashiCorp Vault / OpenTelemetry", "Emits immutable logs, provides distributed tracing, and retrieves secrets.")
}

Component("API Gateway", "API Gateway", "API Gateway / Istio/Linkerd", "Routes external billing requests into the container.")
Component("Insurance Claim Gateways", "Insurance Claim Gateways", "External Network", "External insurance networks for claim submissions.")
Component("PostgreSQL", "PostgreSQL", "PostgreSQL Database", "Provides secure, persistent relational storage for financial records.")

Rel("API Gateway", "Billing API Controller", "Routes billing requests via gRPC over mTLS (Istio/Linkerd)", "gRPC / mTLS")
Rel("Claim Processing Service", "Insurance Claim Gateways", "Submits claims via mTLS with certificate pinning, OAuth2, and JWE envelope encryption", "mTLS / OAuth2 / JWE")
Rel("Claim Processing Service", "Audit Sidecar Container", "Emits immutable logs and retrieves secrets via gRPC", "gRPC")
Rel("Billing Data Access Layer", "PostgreSQL", "Persists billing data using JDBC / TLS with AES-256 column-level encryption", "JDBC / TLS")

@enduml