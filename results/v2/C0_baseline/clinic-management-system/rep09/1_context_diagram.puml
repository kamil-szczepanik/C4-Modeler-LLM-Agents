@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patient, "Patient", "End user of the healthcare facility who interacts with the system for admissions, scheduling, and viewing medical records.")
Person(Clinician_Doctor, "Clinician/Doctor", "Medical professional who accesses and updates electronic medical records and manages patient care.")
Person(Receptionist_Admin, "Receptionist/Admin", "Administrative staff responsible for patient admissions, scheduling, and front-desk clinic operations.")
Person(Billing_Specialist, "Billing Specialist", "Staff member responsible for managing billing, invoices, and insurance claims.")
Person(Compliance_Officer, "Compliance Officer", "Officer responsible for monitoring system audit logs, security, and ensuring HIPAA and GDPR compliance.")

System(Clinic_Management_System, "Clinic Management System", "A hybrid cloud platform designed to manage patient admissions, electronic medical records, scheduling, and billing for medium-sized healthcare facilities, ensuring high availability, strict regulatory compliance, and seamless interoperability.")

System_Ext(Enterprise_Identity_Provider_IdP, "Enterprise Identity Provider (IdP)", "External identity provider used for enterprise single sign-on via OIDC/SAML.")
System_Ext(External_Labs_Imaging_Systems, "External Labs & Imaging Systems", "External clinical systems integrated for exchanging medical lab and imaging data.")
System_Ext(Insurance_Claim_Gateways, "Insurance Claim Gateways", "External gateways used for processing and submitting insurance claims.")

Rel(Patient, Clinic_Management_System, "Interacts with via Web/Mobile for admissions, scheduling, and records", "HTTPS")
Rel(Clinician_Doctor, Clinic_Management_System, "Manages electronic medical records and patient care", "HTTPS")
Rel(Receptionist_Admin, Clinic_Management_System, "Manages patient admissions and scheduling", "HTTPS")
Rel(Billing_Specialist, Clinic_Management_System, "Manages billing and financial processes", "HTTPS")
Rel(Compliance_Officer, Clinic_Management_System, "Monitors system compliance and audit logs", "HTTPS")
Rel(Clinic_Management_System, Enterprise_Identity_Provider_IdP, "Authenticates users via enterprise SSO", "OIDC/SAML")
Rel(Clinic_Management_System, External_Labs_Imaging_Systems, "Exchanges standardized healthcare data", "HL7 FHIR / REST over TLS with mTLS")
Rel(Clinic_Management_System, Insurance_Claim_Gateways, "Communicates for insurance claim processing", "HTTPS/REST with asynchronous queuing and circuit breakers")

@enduml