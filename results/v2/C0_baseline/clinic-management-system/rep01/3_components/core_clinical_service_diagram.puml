@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Clinical Service container

Container_Boundary(core_clinical_service, "Core Clinical Service") {
    Component(EMR_Management_Component, "EMR Management Component", "Java Spring Boot", "Manages electronic medical records, reads/writes encrypted session views, and persists data.")
    Component(Clinical_Workflow_Decision_Component, "Clinical Workflow & Decision Component", "Java Spring Boot", "Handles clinical workflows, decision support, and persists operational data.")
    Component(Audit_Compliance_Component, "Audit & Compliance Component", "Java Spring Boot", "Publishes audit events asynchronously to enforce compliance.")
    Component(Clinical_Session_Cache_Component, "Clinical Session Cache Component", "Spring Data Redis (AES-GCM)", "Caches decrypted EMR view models with in-memory encryption and short TTLs.")
}

System_Ext(Data_Storage_Layer, "Data Storage Layer", "PostgreSQL with WORM storage")
System_Ext(Apache_Kafka, "Apache Kafka", "Messaging & Streaming")
System_Ext(Integration_Interoperability_Service, "Integration / Interoperability Service", "Apache Camel")

Rel(EMR_Management_Component, Data_Storage_Layer, "Persists data", "TLS-encrypted SQL")
Rel(Clinical_Workflow_Decision_Component, Data_Storage_Layer, "Persists data", "TLS-encrypted SQL")
Rel(Audit_Compliance_Component, Apache_Kafka, "Publishes audit events asynchronously", "TCP")
Rel(EMR_Management_Component, Clinical_Session_Cache_Component, "Reads/writes encrypted session views", "In-Memory TLS")
Rel(core_clinical_service, Integration_Interoperability_Service, "Exchanges interoperability data", "gRPC with mTLS")

@enduml