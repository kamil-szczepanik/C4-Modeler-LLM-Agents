@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient Portal container

System_Ext(external_idp, "External Identity Provider (IdP)", "External Identity Provider for authentication.")
System_Ext(api_gateway, "API Gateway / Reverse Proxy", "Kong / NGINX Ingress API Gateway.")
System_Ext(hashicorp_vault, "HashiCorp Vault", "Secure runtime secret management.")

Container_Boundary(patient_portal_container, "Patient Portal") {
    Component(patient_auth_controller, "Patient Authentication Controller", "NextAuth.js, TypeScript", "Utilized for secure multi-factor authentication, token management, and integration with external Identity Providers.")
    Component(registration_profile_manager, "Registration & Profile Manager", "React Component, TypeScript", "Empowers patients with self-service registration and profile management.")
    Component(appointment_self_service_ui, "Appointment Self-Service UI", "React Component, TypeScript", "Provides the user interface for appointment self-service scheduling.")
    Component(localization_preference_module, "Localization & Preference Module", "React Component, TypeScript", "Manages user localization and preference settings.")
    Component(bff_api_router, "BFF API Router", "Next.js API Routes, TypeScript", "Backend-for-Frontend API router handling secure communication with backend services.")
}

Rel(patient_auth_controller, external_idp, "HTTPS/OIDC", "")
Rel(bff_api_router, api_gateway, "HTTPS/REST via Istio mTLS", "")
Rel(registration_profile_manager, bff_api_router, "Internal TypeScript Calls", "")
Rel(appointment_self_service_ui, bff_api_router, "Internal TypeScript Calls", "")
Rel(localization_preference_module, bff_api_router, "Internal TypeScript Calls", "")
Rel(patient_auth_controller, hashicorp_vault, "Encrypted API", "")

@enduml