@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing & Scheduling Service container

Container_Boundary(billing_scheduling_service, "Billing & Scheduling Service") {
    Component(Scheduling_Engine_Component, "Scheduling Engine Component", "Node.js / TypeScript", "Handles appointment scheduling, rescheduling, and waitlist management.")
    Component(Rescheduling_Waitlist_Sub_component, "Rescheduling & Waitlist Sub-component", "Node.js / TypeScript", "Sub-component managing appointment changes and patient waitlists.")
    Component(Billing_Estimation_Engine_Component, "Billing & Estimation Engine Component", "Node.js / TypeScript", "Processes billing logic and cost estimations.")
    Component(Notification_Dispatcher_Component, "Notification Dispatcher Component", "Node.js / TypeScript", "Dispatches notifications to the patient portal and external systems.")
}

System_Ext(Patient_Portal, "Patient Portal", "External patient-facing portal.")

Rel(Scheduling_Engine_Component, Billing_Estimation_Engine_Component, "In-process TypeScript function calls", "Function Call")
Rel(Notification_Dispatcher_Component, Patient_Portal, "Server-Sent Events / WebSocket via API Gateway", "SSE / WebSocket")

@enduml