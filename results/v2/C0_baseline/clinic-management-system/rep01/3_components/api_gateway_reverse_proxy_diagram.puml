@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway / Reverse Proxy") {
    Component(waf_security_inspector, "WAF & Security Inspector", "OWASP WAF module", "Inspects inbound traffic for threats and vulnerabilities.")
    Component(oidc_jwt_validation_engine, "OIDC/JWT Validation Engine", "OAuth2/OIDC", "Validates JSON Web Tokens and handles authentication.")
    Component(rate_limiting_tenant_throttling, "Rate Limiting & Tenant Throttling", "Kong / NGINX with Redis", "Controls request rates and enforces tenant throttling.")
    Component(routing_upstream_load_balancer, "Routing & Upstream Load Balancer", "Kong / NGINX Ingress", "Routes requests to appropriate upstream microservices and balances load.")
    Component(telemetry_trace_injector, "Telemetry & Trace Injector", "OpenTelemetry", "Injects telemetry and trace headers for observability.")
}

Rel(waf_security_inspector, oidc_jwt_validation_engine, "Forwards inspected requests")
Rel(oidc_jwt_validation_engine, rate_limiting_tenant_throttling, "Passes authenticated requests")
Rel(rate_limiting_tenant_throttling, routing_upstream_load_balancer, "Forwards throttled requests")
Rel(routing_upstream_load_balancer, telemetry_trace_injector, "Passes routed requests for trace injection")

@enduml