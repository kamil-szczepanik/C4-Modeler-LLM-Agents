@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Storage Layer container

Container_Boundary(data_storage_layer, "Data Storage Layer") {
    Component(Relational_Database, "Relational Database", "PostgreSQL v15+ with CloudNativePG", "Stores clinical, billing, and schedule data with automated failover.")
    Component(Connection_Pooler, "Connection Pooler", "PgBouncer", "Manages connection pooling for high-throughput concurrency.")
    Component(Object_Storage, "Object Storage", "AWS S3 WORM Storage (Object Lock)", "Ensures 10-year retention for compliance audit logs.")
    Component(Secret_Management, "Secret Management", "HashiCorp Vault", "Provides dynamic secret management and AES-256 envelope encryption at rest.")
}

System_Ext(Core_Clinical_Service, "Core Clinical Service", "External Core Clinical Service")
System_Ext(Billing_Scheduling_Service, "Billing & Scheduling Service", "External Billing & Scheduling Service")
System_Ext(Services, "Services", "External Services")

Rel(Core_Clinical_Service, Relational_Database, "Reads and writes clinical data via TLS-encrypted SQL", "TLS / SQL")
Rel(Billing_Scheduling_Service, Relational_Database, "Reads and writes billing and schedule data via TLS-encrypted SQL", "TLS / SQL")
Rel(Services, Connection_Pooler, "Connects securely via Istio mTLS and PgBouncer connection pooler", "Istio mTLS")

@enduml