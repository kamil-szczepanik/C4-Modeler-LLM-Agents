@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Messaging & Observability Infrastructure container

Container_Boundary(messaging_observability_infrastructure, "Messaging & Observability Infrastructure") {
    Component(Event_Broker_Component, "Event Broker Component", "Apache Kafka (KRaft mode)", "Asynchronous event streaming ensuring zero data loss and high availability.")
    Component(Service_Mesh, "Service Mesh", "Istio Envoy sidecars", "Enforcing zero-trust networking and strict mTLS communication.")
    Component(Secrets_Management_Component, "Secrets Management Component", "HashiCorp Vault", "Dynamic secrets and encryption keys management.")
    Component(Telemetry_Collector_Monitoring, "Telemetry Collector & Monitoring", "OpenTelemetry Collector, Prometheus, and Grafana", "Service mesh telemetry, system metrics collection, and monitoring.")
    Component(GitOps_Engine, "GitOps Engine", "ArgoCD", "Declarative deployments and cluster synchronization.")
}

Rel(Service_Mesh, Event_Broker_Component, "Istio mTLS (strict mode) securing service communication.", "Istio mTLS")
Rel(Secrets_Management_Component, Event_Broker_Component, "Provides AES-256 keys and encryption for Kafka application-layer envelope encryption.", "HTTPS / REST")
Rel(Telemetry_Collector_Monitoring, Service_Mesh, "Collects metrics and traces routed through OpenTelemetry scrubbing filters.", "OTLP/gRPC")
Rel(GitOps_Engine, Service_Mesh, "HTTPS via Kubernetes API for cluster synchronization and deployments.", "HTTPS")

@enduml