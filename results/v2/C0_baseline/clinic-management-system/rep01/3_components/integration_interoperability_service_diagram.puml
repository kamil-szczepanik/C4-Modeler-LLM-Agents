@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration / Interoperability Service container

System_Ext(lab_imaging, "Lab & Imaging Systems", "External lab and imaging systems.")
System_Ext(messaging_obs, "Messaging & Observability Infrastructure", "Apache Kafka, Prometheus, Grafana, OpenTelemetry, Istio, HashiCorp Vault, ArgoCD")
System_Ext(worm_storage, "WORM Audit Storage", "Immutable compliance auditing storage.")

Container_Boundary(integration_service, "Integration / Interoperability Service") {
    Component(fhir_router, "FHIR Ingress/Egress Router", "Apache Camel / Spring Boot", "Routes HL7 FHIR REST over HTTPS requests to external lab and imaging systems.")
    Component(data_transform, "Data Transformation Engine", "Apache Camel", "Executes HL7 FHIR data transformations and streams cryptographic audit metadata.")
    Component(dlq_manager, "DLQ Manager", "Apache Camel", "Streams failure events to the messaging and observability infrastructure.")
    Component(audit_interceptor, "Audit Interceptor", "Spring Boot", "Intercepts requests and messages for compliance auditing.")
    Component(consent_policy, "Consent & Policy Enforcement", "Open Policy Agent", "Validates consent scopes and enforces zero-trust policies.")
}

Rel(fhir_router, lab_imaging, "External data exchange", "HL7 FHIR REST over HTTPS")
Rel(fhir_router, consent_policy, "Validates consent scopes", "gRPC")
Rel(dlq_manager, messaging_obs, "Streams failure events", "Apache Kafka")
Rel(data_transform, worm_storage, "Streams cryptographic audit metadata", "gRPC/TLS")

@enduml