@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Patients, "Patients", "Receive care and interact with the system via secure self-service portals.")
Person(Receptionists, "Receptionists", "Manage patient admissions and scheduling.")
Person(Clinicians, "Clinicians", "Access and update electronic medical records (EMR) and clinical workflows.")
Person(Billing_Specialists, "Billing Specialists", "Manage patient billing and payment processing.")
Person(Clinic_Administrators, "Clinic Administrators", "Oversee clinic operations and management.")
Person(Compliance_Auditors, "Compliance Auditors", "Audit compliance with HIPAA and GDPR regulations.")

System_Ext(Lab___Imaging_Systems, "Lab & Imaging Systems", "External diagnostic systems providing lab results and medical imaging.")
System_Ext(Insurance_Payment_Gateways, "Insurance Payment Gateways", "External payment systems for processing insurance claims.")
System_Ext(Identity_Provider__IdP_, "Identity Provider (IdP)", "Handles authentication and identity management via OAuth2/OIDC.")

System_Boundary(Clinic_Management_System, "Clinic Management System") {
    Container(API_Gateway___Reverse_Proxy, "API Gateway / Reverse Proxy", "Kong / NGINX Ingress", "Routes incoming traffic and handles reverse proxying for the system.")
    Container(Patient_Portal, "Patient Portal", "Next.js (TypeScript)", "Provides isolated patient self-service functionalities.")
    Container(Core_Clinical_Service, "Core Clinical Service", "Java (Spring Boot)", "Manages robust, high-performance clinical logic and EMR.")
    Container(Billing___Scheduling_Service, "Billing & Scheduling Service", "Node.js / TypeScript", "Handles patient scheduling, billing operations, and messaging.")
    Container(Integration___Interoperability_Service, "Integration / Interoperability Service", "Apache Camel / Spring Boot", "Performs HL7 FHIR data transformation and external system integration.")
    ContainerDb(Data_Storage_Layer, "Data Storage Layer", "PostgreSQL (AES-256 at rest) with WORM audit storage", "Stores relational clinical data with primary-replica replication and immutable audit trails.")
    Container(Messaging___Observability_Infrastructure, "Messaging & Observability Infrastructure", "Apache Kafka, Prometheus, Grafana, OpenTelemetry, Istio, HashiCorp Vault, ArgoCD", "Provides asynchronous messaging, service mesh, secrets management, GitOps, and monitoring.")
}

Rel(Patients, API_Gateway___Reverse_Proxy, "Accesses patient portal and services", "HTTPS/REST via OAuth2/OIDC")
Rel(Receptionists, API_Gateway___Reverse_Proxy, "Accesses administrative and scheduling workflows", "HTTPS/REST via OAuth2/OIDC")
Rel(Clinicians, API_Gateway___Reverse_Proxy, "Accesses clinical workflows and EMR", "HTTPS/REST via OAuth2/OIDC")
Rel(Billing_Specialists, API_Gateway___Reverse_Proxy, "Accesses billing operations", "HTTPS/REST via OAuth2/OIDC")
Rel(Clinic_Administrators, API_Gateway___Reverse_Proxy, "Oversees operations and compliance", "HTTPS/REST via OAuth2/OIDC")
Rel(Compliance_Auditors, API_Gateway___Reverse_Proxy, "Reviews compliance and audit logs", "HTTPS/REST via OAuth2/OIDC")

Rel(API_Gateway___Reverse_Proxy, Patient_Portal, "Reverse proxy routing to frontend", "HTTP")
Rel(API_Gateway___Reverse_Proxy, Core_Clinical_Service, "Reverse proxy routing to core clinical logic", "HTTP")
Rel(API_Gateway___Reverse_Proxy, Billing___Scheduling_Service, "Reverse proxy routing to billing and scheduling", "HTTP")

Rel(Core_Clinical_Service, Integration___Interoperability_Service, "Exchanges interoperability data", "gRPC with mTLS via Istio")
Rel(Billing___Scheduling_Service, Integration___Interoperability_Service, "Exchanges interoperability data", "gRPC with mTLS via Istio")
Rel(Integration___Interoperability_Service, Core_Clinical_Service, "Exchanges interoperability data", "gRPC with mTLS via Istio")
Rel(Integration___Interoperability_Service, Billing___Scheduling_Service, "Exchanges interoperability data", "gRPC with mTLS via Istio")

Rel(Billing___Scheduling_Service, Insurance_Payment_Gateways, "Submits insurance claims asynchronously", "Asynchronous messaging via Apache Kafka")
Rel(Integration___Interoperability_Service, Lab___Imaging_Systems, "Integrates diagnostic and imaging data", "HL7 FHIR APIs")

Rel(Core_Clinical_Service, Data_Storage_Layer, "Reads and writes clinical data", "TLS-encrypted SQL")
Rel(Billing___Scheduling_Service, Data_Storage_Layer, "Reads and writes billing and schedule data", "TLS-encrypted SQL")
@enduml