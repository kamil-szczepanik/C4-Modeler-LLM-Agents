@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_Consumers, "Patients / Consumers", "Receive care and interact with the system via secure web portals.")
Person(Receptionists_Front_Desk, "Receptionists / Front Desk", "Manage patient registration and scheduling.")
Person(Clinicians_Doctors, "Clinicians / Doctors", "Access and update electronic medical records (EMR) and clinical data.")
Person(Billing_Specialists, "Billing Specialists", "Manage patient billing and submit insurance claims.")
Person(Clinic_Administrators, "Clinic Administrators", "Oversee clinic operations and management.")
Person(Compliance_Auditors_Data_Protection_Officers_DPOs, "Compliance Auditors / Data Protection Officers (DPOs)", "Audit compliance with HIPAA and GDPR regulations.")

System(Clinic_Management_System, "Clinic Management System", "Manages patient registration, scheduling, electronic medical records (EMR), and billing for medium-sized hospitals and clinics across a hybrid cloud architecture.")

System_Ext(Lab_Imaging_Systems, "Lab & Imaging Systems", "External diagnostic systems providing lab results and medical imaging.")
System_Ext(Insurance_Payment_Gateways, "Insurance Payment Gateways", "External payment systems for processing insurance claims.")
System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "Handles multi-factor authentication and identity management.")
System_Ext(AWS_Cloud_Infrastructure, "AWS Cloud Infrastructure", "Cloud environment in eu-central-1 for data replication, compliance log archiving, and WORM storage.")

Rel(Patients_Consumers, Clinic_Management_System, "Interacts via secure web portals for healthcare services", "HTTPS / Secure Web Portals")
Rel(Receptionists_Front_Desk, Clinic_Management_System, "Performs patient registration and scheduling", "HTTPS / Secure Web Portals")
Rel(Clinicians_Doctors, Clinic_Management_System, "Manages patient EMR and clinical workflows", "HTTPS / Secure Web Portals")
Rel(Billing_Specialists, Clinic_Management_System, "Manages billing operations", "HTTPS / Secure Web Portals")
Rel(Clinic_Administrators, Clinic_Management_System, "Manages administrative clinic operations", "HTTPS / Secure Web Portals")
Rel(Compliance_Auditors_Data_Protection_Officers_DPOs, Clinic_Management_System, "Reviews audit logs and verifies regulatory compliance", "HTTPS / Secure Web Portals")
Rel(Clinic_Management_System, Identity_Provider_IdP, "Authenticates users via multi-factor authentication", "OIDC / SAML 2.0")
Rel(Clinic_Management_System, Lab_Imaging_Systems, "Integrates clinical diagnostic data", "HL7 FHIR REST APIs over TLS 1.3")
Rel(Clinic_Management_System, Insurance_Payment_Gateways, "Submits insurance claims", "HTTPS / REST using OAuth 2.0")
Rel(Clinic_Management_System, AWS_Cloud_Infrastructure, "Replicates data and archives compliance logs", "mTLS and S3 APIs")
@enduml