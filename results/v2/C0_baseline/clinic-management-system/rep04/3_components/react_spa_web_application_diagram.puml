@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the React SPA Web Application container

Container_Boundary(react_spa_web_application, "React SPA Web Application") {
    Component(routing_shell_component, "Routing & Shell Component", "React Router, Tailwind CSS", "Dynamic role-based UI segregation for clinic staff, clinicians, and billing specialists.")
    Component(state_management_offline_persistence, "State Management & Offline Persistence", "Redux Toolkit, encrypted IndexedDB, Web Crypto API", "Local data caching and secure offline storage providing offline resilience.")
    Component(api_client_interceptor_module, "API Client & Interceptor Module", "Axios, OpenTelemetry", "Secure communication with real-user monitoring and tracing.")
    Component(emr_scheduling_view_modules, "EMR & Scheduling View Modules", "TanStack Table", "Optimized interfaces guaranteeing sub-second P95 render times for EMR workflows.")
    Component(sync_conflict_resolution_manager, "Sync & Conflict Resolution Manager", "Background Queue Manager, Exponential Backoff and Jitter", "Manages offline queue synchronization and provides a recovery dashboard.")
    Component(kong_envoy_api_gateway, "Kong/Envoy API Gateway", "Kong/Envoy", "External API gateway handling REST/JSON over HTTPS with TLS 1.3.")
    Component(nginx_containers, "Nginx Containers", "Nginx", "Static asset delivery and container serving for client-side rendering.")
    Component(global_cdn_aws_cloudfront_on_prem, "Global CDN (AWS CloudFront / On-Prem)", "AWS CloudFront / On-Prem Proxies", "Global CDN strategy for low-latency static asset delivery.")
}

Rel(sync_conflict_resolution_manager, api_client_interceptor_module, "Internal dispatch of queued payloads", "In-memory")
Rel(api_client_interceptor_module, kong_envoy_api_gateway, "REST/JSON over HTTPS", "TLS 1.3")
Rel(nginx_containers, global_cdn_aws_cloudfront_on_prem, "Static asset delivery", "HTTPS/TLS 1.3, Cache-Control")

@enduml