@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(apache_kafka_event_stream, "Apache Kafka Event Stream") {
    Component(ApacheKafkaEventBroker, "Apache Kafka Event Broker", "Apache Kafka (KRaft mode)", "Manages event streaming without ZooKeeper to meet high availability and process Clinical and Financial Events.")
    Component(StrimziOperator, "Strimzi Operator", "Strimzi Kubernetes Operator", "Automates Kafka lifecycle, MM2, and cert-manager integration on Kubernetes.")
    Component(ConfluentSchemaRegistry, "Confluent Schema Registry", "Confluent Schema Registry", "Enforces Avro/Protobuf schemas for data integrity and HIPAA compliance.")
    Component(KafkaConnect, "Kafka Connect", "Kafka Connect", "Handles reliable CDC and sinks audit/billing data to PostgreSQL and WORM storage.")
    Component(MirrorMaker2, "MirrorMaker 2", "MirrorMaker 2", "Manages asynchronous cross-site replication between on-prem-k8s and eu-central-1.")
    Component(TieredStorageManager, "Tiered Storage Manager", "Tiered Storage", "Offloads historical data to WORM object storage to meet retention mandates without local disk exhaustion.")
}

Rel(ApacheKafkaEventBroker, ConfluentSchemaRegistry, "Validates Avro/Protobuf event payloads [HTTP/REST]", "HTTP/REST")
Rel(ApacheKafkaEventBroker, TieredStorageManager, "Offloads historical data via Tiered Storage Manager [HTTPS / S3 API]", "HTTPS / S3 API")
Rel(MirrorMaker2, ApacheKafkaEventBroker, "Replicates topics securely across clusters [Kafka Protocol over mTLS]", "Kafka Protocol over mTLS")
Rel(KafkaConnect, ApacheKafkaEventBroker, "Executes CDC and sinks audit/billing data [Kafka Protocol / S3 API]", "Kafka Protocol / S3 API")

@enduml