@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Services container

Container_Boundary(core_services, "Core Services") {
    Component(patient_registry, "Patient Registry Component", "Spring Data JPA, Java & Spring Boot", "Manages demographic capture using Spring Data JPA.")
    Component(scheduling_engine, "Scheduling Engine Component", "Redis Enterprise, Java & Spring Boot", "Handles resource clash checks leveraging Redis Enterprise for real-time slot locking.")
    Component(emr_manager, "EMR Manager Component", "PostgreSQL clusters, WORM object storage, Java & Spring Boot", "Manages clinical records with an immutable audit trail using PostgreSQL clusters and WORM object storage.")
    Component(event_publisher, "Event Publisher Component", "Apache Kafka, Java & Spring Boot", "Emits domain and audit events asynchronously via Apache Kafka.")
    Component(resilience4j, "Resilience4j Circuit Breaker", "Resilience4j", "Protects system availability and performance.")
    Component(local_buffer, "Encrypted Local Disk Buffer", "AES-256 local disk", "Stores audit logs locally prior to Kafka dispatch.")
}

System_Ext(postgresql, "PostgreSQL", "Relational database")
system_ext(redis, "Redis Enterprise", "In-memory data store")
System_Ext(worm_storage, "WORM Object Storage", "Immutable object storage")
System_Ext(kafka, "Apache Kafka", "Event streaming platform")

Rel(patient_registry, postgresql, "Reads and writes relational data using encrypted JDBC", "encrypted JDBC")
Rel(scheduling_engine, redis, "Caches sessions, authorization scopes, and scheduling locks", "encrypted cache protocols")
Rel(emr_manager, postgresql, "Stores clinical record data", "encrypted JDBC")
Rel(emr_manager, worm_storage, "Persists long-term data for 10-year retention", "Secure Object Storage API")
Rel(event_publisher, kafka, "Publishes domain and audit events using Kafka Protocol with SASL/SCRAM", "Kafka Protocol with SASL/SCRAM")
Rel(local_buffer, event_publisher, "Buffers audit logs prior to Kafka dispatch", "Local IPC")

@enduml