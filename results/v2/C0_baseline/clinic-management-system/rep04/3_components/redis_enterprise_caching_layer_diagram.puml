@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(redis_enterprise_caching_layer, "Redis Enterprise caching layer") {
    Component(ActiveActiveCRDTSyncEngine, "Active-Active CRDT Sync Engine", "Redis Enterprise CRDTs", "Synchronizes session and reference data across multi-region active-active deployments to ensure sub-second response times.")
    Component(InMemoryDataStore, "In-Memory Data Store", "Redis Enterprise Memory Store", "Provides low-latency read and write access for session data and reference information over mTLS.")
}

Rel(ActiveActiveCRDTSyncEngine, InMemoryDataStore, "Replicates and synchronizes data states")
@enduml