@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL clusters container

System_Ext(core_services, "Core Services", "External system representing core application services.")

Container_Boundary(postgresql_clusters, "PostgreSQL clusters") {
    Component(Primary_Database_Instance, "Primary Database Instance", "PostgreSQL Engine", "Primary relational database engine chosen for ACID compliance and structured clinical data storage.")
    Component(Read_Replica_Instances, "Read Replica Instances", "PostgreSQL Read Replicas", "Read replica instances handling read-only queries for clinical data.")
    Component(High_Availability_Manager, "High Availability Manager", "Patroni / etcd", "HA management for automated leader election and zero data loss failovers.")
    Component(Backup_Archival_Agent, "Backup & Archival Agent", "Barman / pgBackRest", "Backup agents for continuous WAL streaming to WORM object storage.")
    Component(Connection_Pooler, "Connection Pooler", "PgBouncer", "Connection pooler for handling high concurrency during peak clinical hours.")
    Component(Audit_Log_Collector, "Audit Log Collector", "pgAudit", "Extension for capturing security-relevant DDL/DML events for HIPAA compliance.")
}

Rel(core_services, Connection_Pooler, "SQL / TLS 1.3", "Network")
Rel(core_services, Read_Replica_Instances, "SQL / TLS 1.3 (Read-only)", "Network")
Rel(Connection_Pooler, Primary_Database_Instance, "Internal TCP", "Internal")
Rel(Primary_Database_Instance, Backup_Archival_Agent, "WAL streaming", "Internal")
Rel(Primary_Database_Instance, Audit_Log_Collector, "Internal Hook", "Internal")

@enduml