@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the WORM object storage container

System_Ext(Core_Services, "Core Services", "External system representing core services of the application.")
System_Ext(AWS_S3_eu_central_1, "AWS S3 in eu-central-1", "External AWS S3 region for replication and tier-transitions.")
System_Ext(On_Prem_HSM, "On-Prem HSM", "External On-Premise Hardware Security Module for key management.")

Container_Boundary(worm_object_storage, "WORM object storage") {
    Component(Object_Gateway_API, "Object Gateway API", "MinIO / AWS S3 API", "Exposes S3-compatible REST API endpoints for data ingestion and retrieval.")
    Component(Immutability_Enforcement_Engine, "Immutability Enforcement Engine", "AWS S3 Object Lock (Compliance Mode)", "Enforces unalterable 10-year data retention policies and prevents premature deletion.")
    Component(Replication_Tiering_Controller, "Replication & Tiering Controller", "Terraform / Crossplane, Prometheus", "Manages asynchronous hybrid replication, automated cold tiering, and metric scraping.")
    Component(Cryptographic_Envelope_Key_Manager_Integration_Module, "Cryptographic Envelope & Key Manager Integration Module", "AES-256-GCM, On-Prem HSM", "Handles envelope encryption and integrates with the on-premise HSM for zero-knowledge storage.")
}

Rel(Core_Services, Object_Gateway_API, "Persists encrypted EMR objects and metadata", "HTTPS, TLS 1.3, S3 REST Protocol, mTLS, STS tokens")
Rel(Replication_Tiering_Controller, AWS_S3_eu_central_1, "Asynchronously replicates and tier-transitions EMR blobs", "AWS S3 API")
Rel(Cryptographic_Envelope_Key_Manager_Integration_Module, On_Prem_HSM, "Wraps and manages object encryption keys", "PKCS#11 / Secure Key Management API")

@enduml