@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Kong/Envoy API Gateway container

Container_Boundary(kong_envoy_api_gateway, "Kong/Envoy API Gateway") {
    Component(Routing_Upstream_Matcher, "Routing & Upstream Matcher", "Envoy Router with Coraza/ModSecurity WAF", "Handles request routing, upstream matching, and OWASP Top 10 mitigation via WAF.")
    Component(Authentication_Authorization_Filter, "Authentication & Authorization Filter", "Kong Auth Plugin / Envoy WASM/Lua", "Validates incoming tokens and performs authentication and authorization checks.")
    Component(Rate_Limiting_Throttling_Engine, "Rate Limiting & Throttling Engine", "Kong Rate Limiting", "Enforces rate limits and request throttling using Redis Enterprise.")
    Component(Audit_Telemetry_Logger, "Audit & Telemetry Logger", "Kong Logging / Envoy Access Log Service", "Logs access events and telemetry data, publishing them to Apache Kafka.")
}

Rel(Routing_Upstream_Matcher, Authentication_Authorization_Filter, "Passes authenticated requests for routing and upstream dispatch", "")
Rel(Authentication_Authorization_Filter, Rate_Limiting_Throttling_Engine, "Triggers rate limit checks for authorized traffic", "")
Rel(Routing_Upstream_Matcher, Audit_Telemetry_Logger, "Emits access logs and telemetry spans", "")

@enduml