@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient Portal BFF container

System_Ext(ApacheKafka, "Apache Kafka", "Event Stream", "Publishes asynchronous event publishing for notifications and audit logging.")
System_Ext(CoreServices, "Core Services", "Java, Spring Boot", "Handles backend business logic.")

Container_Boundary(PatientPortalBFF, "Patient Portal BFF") {
    Component(APIRouter, "API Router", "Node.js / TypeScript / Fastify", "Routes patient requests and publishes compliance audit logs to Apache Kafka via Async TCP.")
    Component(SessionandRateLimitManager, "Session and Rate Limit Manager", "Redis Enterprise", "Caches session state and manages distributed rate limits over TLS 1.3.")
}

Rel(APIRouter, ApacheKafka, "Publishes compliance audit logs", "Async TCP")
Rel(APIRouter, SessionandRateLimitManager, "Caches session state and rate limits", "TLS 1.3")
Rel(APIRouter, CoreServices, "Queries business logic", "gRPC over mTLS")

@enduml