@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(apache_camel_mulesoft_integration_engine, "Apache Camel/MuleSoft Integration Engine") {
    Component(FHIR Transformer, "FHIR Transformer", "Apache Camel / MuleSoft", "Transforms clinical data into HL7 FHIR standards for interoperability.")
    Component(Routing Router, "Routing Router", "Apache Camel / MuleSoft", "Routes integration messages between core services and external systems.")
    Component(DLQ Handler, "DLQ Handler", "Apache Camel / MuleSoft and Apache Kafka", "Handles dead-letter queue payloads with encryption for compliance.")
    Component(Audit Interceptor, "Audit Interceptor", "Apache Camel / MuleSoft", "Intercepts and logs requests to maintain the 10-year data retention audit trail.")
}

Rel(Routing Router, FHIR Transformer, "Routes payloads for")
Rel(FHIR Transformer, Audit Interceptor, "Sends audit logs to")
Rel(DLQ Handler, Audit Interceptor, "Reports failed messages to")

@enduml