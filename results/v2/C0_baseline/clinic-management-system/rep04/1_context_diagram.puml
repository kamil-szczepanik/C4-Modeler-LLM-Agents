@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Clinic Management System

Person(Patient, "Patient", "End user accessing the platform for scheduling and personal medical data.")
Person(ClinicStaffReceptionist, "Clinic Staff/Receptionist", "Administrative staff managing patient admissions and scheduling.")
Person(ClinicianDoctor, "Clinician/Doctor", "Medical professional managing EMRs and patient care.")
Person(BillingSpecialist, "Billing Specialist", "Staff member handling invoices, payments, and financial processing.")
Person(HospitalAdministrator, "Hospital Administrator", "System manager overseeing platform operations, compliance, and user roles.")

System_Ext(IdentityProviderIdP, "Identity Provider (IdP)", "External authentication service providing OIDC / SAML 2.0 and MFA.")
System_Ext(ExternalLabImagingSystems, "External Lab & Imaging Systems", "External systems for clinical diagnostics and imaging data exchange.")
System_Ext(ExternalPaymentGatewayInsuranceClearinghouse, "External Payment Gateway & Insurance Clearinghouse", "External systems handling payment processing and insurance claims.")

System_Boundary(ClinicManagementSystem, "Clinic Management System") {
    Container(APIGatewayEdgeProxy, "API Gateway / Edge Proxy", "OpenTelemetry / API Gateway", "Edge proxy handling incoming traffic, routing, and audit tracking.")
    Container(ClinicManagementSystemCore, "Clinic Management System Core", "Kubernetes, Docker, Microservices", "Core hybrid cloud microservices deployed across on-premise Kubernetes and AWS eu-central-1.")
}

Rel(Patient, APIGatewayEdgeProxy, "Accesses web and mobile interfaces for scheduling and EMR review", "HTTPS / TLS 1.3 with OIDC / SAML 2.0 and MFA")
Rel(ClinicStaffReceptionist, APIGatewayEdgeProxy, "Manages patient admissions and appointments", "HTTPS / TLS 1.3 with OIDC / SAML 2.0 and MFA")
Rel(ClinicianDoctor, APIGatewayEdgeProxy, "Views and updates Electronic Medical Records (EMRs)", "HTTPS / TLS 1.3 with OIDC / SAML 2.0 and MFA")
Rel(BillingSpecialist, APIGatewayEdgeProxy, "Processes patient billing and insurance claims", "HTTPS / TLS 1.3 with OIDC / SAML 2.0 and MFA")
Rel(HospitalAdministrator, APIGatewayEdgeProxy, "Monitors system performance and manages administrative settings", "HTTPS / TLS 1.3 with OIDC / SAML 2.0 and MFA")

Rel(APIGatewayEdgeProxy, ClinicManagementSystemCore, "Routes client requests to backend containerized microservices", "HTTPS / TLS 1.3")

Rel(ClinicManagementSystemCore, ExternalLabImagingSystems, "Exchanges standardized clinical data", "HL7 FHIR over HTTPS with Mutual TLS (mTLS)")
Rel(ClinicManagementSystemCore, ExternalPaymentGatewayInsuranceClearinghouse, "Processes financial transactions and insurance verification", "REST over TLS 1.3 with mTLS")
Rel(ClinicManagementSystemCore, IdentityProviderIdP, "Authenticates users via OIDC and SAML 2.0", "OIDC / SAML 2.0 over HTTPS")

@enduml