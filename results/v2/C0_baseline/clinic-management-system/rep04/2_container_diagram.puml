@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Patient, "Patient", "End user accessing the platform for scheduling and personal medical data.")
Person(ClinicStaffReceptionist, "Clinic Staff/Receptionist", "Administrative staff managing patient admissions and scheduling.")
Person(ClinicianDoctor, "Clinician/Doctor", "Medical professional managing EMRs and patient care.")
Person(BillingSpecialist, "Billing Specialist", "Staff member handling invoices, payments, and financial processing.")
Person(HospitalAdministrator, "Hospital Administrator", "System manager overseeing platform operations, compliance, and user roles.")

System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "External authentication service providing OIDC / SAML 2.0 and MFA.")
System_Ext(External_Lab__Imaging_Systems, "External Lab & Imaging Systems", "External systems for clinical diagnostics and imaging data exchange.")
System_Ext(External_Payment_Gateway__Insurance_Clearinghouse, "External Payment Gateway & Insurance Clearinghouse", "External systems handling payment processing and insurance claims.")

System_Boundary(Clinic_Management_System, "Clinic Management System") {
    Container(KongEnvoy_API_Gateway, "Kong/Envoy API Gateway", "Kong/Envoy", "Edge proxy handling incoming traffic, routing, and audit tracking.")
    Container(React_SPA_Web_Application, "React SPA Web Application", "React, Nginx", "Frontend web application served via Nginx containers for clinic staff UI.")
    Container(Patient_Portal_BFF, "Patient Portal BFF", "Node.js / Spring Boot", "Backend-for-Frontend service for the patient portal.")
    Container(Core_Services, "Core Services", "Java, Spring Boot", "Modular core services managing patient admissions, EMRs, and scheduling.")
    Container(Billing_Service, "Billing Service", "Java / Node.js", "Service responsible for billing, invoices, and financial transactions.")
    Container(Apache_CamelMuleSoft_Integration_Engine, "Apache Camel/MuleSoft Integration Engine", "Apache Camel, MuleSoft", "Integration engine for HL7 FHIR translation and external connectivity.")
    Container(Apache_Kafka_Event_Stream, "Apache Kafka Event Stream", "Apache Kafka", "Event stream for local event-driven telemetry.")
    ContainerDb(PostgreSQL_clusters, "PostgreSQL clusters", "PostgreSQL", "Relational database with AES-256 encryption at rest for ACID compliance.")
    ContainerDb(Redis_Enterprise_caching_layer, "Redis Enterprise caching layer", "Redis Enterprise", "Caching layer for low-latency session and reference data caching.")
    ContainerDb(WORM_object_storage, "WORM object storage", "Object Storage", "Secure storage ensuring 10-year data retention policy.")
}

Rel(Patient, KongEnvoy_API_Gateway, "Accesses patient portal via web interface", "HTTPS/TLS 1.3")
Rel(ClinicStaffReceptionist, KongEnvoy_API_Gateway, "Interacts with clinic staff UI", "HTTPS/TLS 1.3")
Rel(ClinicianDoctor, KongEnvoy_API_Gateway, "Manages EMRs and patient care", "HTTPS/TLS 1.3")
Rel(BillingSpecialist, KongEnvoy_API_Gateway, "Processes billing and claims", "HTTPS/TLS 1.3")
Rel(HospitalAdministrator, KongEnvoy_API_Gateway, "Oversees platform operations and compliance", "HTTPS/TLS 1.3")

Rel(KongEnvoy_API_Gateway, Patient_Portal_BFF, "Routes patient requests", "HTTPS/TLS 1.3")
Rel(KongEnvoy_API_Gateway, React_SPA_Web_Application, "Serves clinic staff frontend", "HTTPS/TLS 1.3")
Rel(KongEnvoy_API_Gateway, Core_Services, "Communicates with core services", "gRPC/REST over mTLS (Istio)")
Rel(KongEnvoy_API_Gateway, Billing_Service, "Communicates with billing service", "gRPC/REST over mTLS (Istio)")
Rel(KongEnvoy_API_Gateway, Identity_Provider_IdP, "Authenticates users", "OAuth2 / OIDC")

Rel(Patient_Portal_BFF, Core_Services, "Queries core business logic", "gRPC/REST over mTLS")

Rel(Core_Services, PostgreSQL_clusters, "Reads and writes relational data", "Encrypted database protocols")
Rel(Core_Services, Redis_Enterprise_caching_layer, "Caches session and reference data", "Encrypted cache protocols")
Rel(Core_Services, Apache_Kafka_Event_Stream, "Publishes and consumes events", "Kafka Protocol")
Rel(Core_Services, Apache_CamelMuleSoft_Integration_Engine, "Sends and receives integration messages", "Internal Messaging / API")
Rel(Core_Services, WORM_object_storage, "Persists long-term data for 10-year retention", "Secure Object Storage API")

Rel(Billing_Service, PostgreSQL_clusters, "Stores financial records", "Encrypted database protocols")
Rel(Billing_Service, External_Payment_Gateway__Insurance_Clearinghouse, "Processes payments and insurance verification", "HTTPS")

Rel(Apache_CamelMuleSoft_Integration_Engine, External_Lab__Imaging_Systems, "Exchanges clinical data", "HL7 FHIR APIs over TLS")

@enduml