@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patient, "Patient", "Patients accessing the platform for scheduling, admissions, and viewing EMR or billing details.")
Person(Receptionist, "Receptionist / Front Desk", "Front desk staff managing patient check-ins, admissions, and basic scheduling.")
Person(Clinician, "Clinician / Doctor", "Medical professionals managing patient health records, examinations, and clinical notes.")
Person(BillingSpecialist, "Billing Specialist", "Staff members handling insurance claims, invoices, and payment processing.")

System(ClinicManagementSystem, "Clinic Management System", "A hybrid cloud platform designed for medium-sized clinics and hospitals to manage patient admissions, EMRs, scheduling, and billing while ensuring HIPAA/GDPR compliance, 99.99% availability, and local-first sub-second performance.")

System_Ext(IdP, "Identity Provider (IdP)", "Manages authentication and IAM via OAuth2/OIDC.")
System_Ext(LabImagingSystems, "External Lab & Imaging Systems", "External systems providing medical lab results and imaging data.")
System_Ext(InsuranceClearinghouses, "Insurance Clearinghouses", "External networks for transmitting medical insurance claims.")
System_Ext(PaymentGateway, "Payment Gateway / Merchant Services", "External service provider for processing patient co-pays and payments.")
System_Ext(SecureHybridGateway, "Secure Hybrid Gateway/VPN Interconnect", "Secures communication between on-premise infrastructure and AWS cloud.")
System_Ext(SIEM, "SIEM / Observability System", "Centralized system for OpenTelemetry metrics, logs, and HIPAA-compliant audit trails.")
System_Ext(CentralizedVault, "Centralized Vault", "Secret management system (HashiCorp Vault / AWS Secrets Manager) for dynamic secrets.")

Rel(Patient, ClinicManagementSystem, "Accessed for scheduling and viewing records", "HTTPS, OAuth2/OIDC, MFA")
Rel(Receptionist, ClinicManagementSystem, "Manages admissions, scheduling, and front-desk workflows", "HTTPS, OAuth2/OIDC, MFA")
Rel(Clinician, ClinicManagementSystem, "Accesses and updates EMRs and patient clinical data", "HTTPS, OAuth2/OIDC, MFA")
Rel(BillingSpecialist, ClinicManagementSystem, "Manages patient billing, invoices, and insurance claims", "HTTPS, OAuth2/OIDC, MFA")

Rel(ClinicManagementSystem, IdP, "Authenticates users and manages IAM", "OAuth2/OIDC")
Rel(ClinicManagementSystem, LabImagingSystems, "Integrates lab orders and imaging results", "HL7 FHIR APIs over HTTPS/REST")
Rel(ClinicManagementSystem, InsuranceClearinghouses, "Transmits insurance claims", "EDI/HTTPS")
Rel(ClinicManagementSystem, PaymentGateway, "Processes patient co-pays and transactions", "HTTPS/REST")
Rel(ClinicManagementSystem, SecureHybridGateway, "Communicates across hybrid infrastructure securely", "mTLS/IPsec")
Rel(ClinicManagementSystem, SIEM, "Sends telemetry data and audit logs for compliance", "OpenTelemetry, Structured JSON Logging")
Rel(ClinicManagementSystem, CentralizedVault, "Fetches dynamic secrets and configuration credentials", "Secure API, TLS 1.3")

@enduml