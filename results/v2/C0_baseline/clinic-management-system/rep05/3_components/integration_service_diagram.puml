@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(integration_service, "Integration Service") {
    Component(route_orchestrator, "Route Orchestrator", "Apache Camel", "Enterprise integration patterns and workflow orchestration for the Integration Service.")
    Component(fhir_transformer, "FHIR Transformer", "HAPI FHIR", "Standardized HL7 FHIR resource transformation.")
    Component(data_anonymization_interceptor, "Data Anonymization Interceptor", "Custom Interceptor", "Anonymizes data payloads to ensure HIPAA/GDPR compliance.")
    Component(vault_client, "Vault Client", "Spring Cloud Vault", "Handles dynamic secrets and X.509 certs via AppRole tokens.")
    Component(dead_letter_channel, "Dead Letter Channel", "Kafka", "Encrypted Dead Letter Queue for reliability and message retry handling.")
    Component(payload_cryptography_processor, "Payload Cryptography Processor", "Java Cryptography / JWE", "Handles payload-level JWE/AES-256 encryption.")
}

Rel(route_orchestrator, fhir_transformer, "Transforms messages to FHIR format")
Rel(route_orchestrator, data_anonymization_interceptor, "Passes payload through anonymization")
Rel(route_orchestrator, payload_cryptography_processor, "Encrypts/decrypts payloads")
Rel(vault_client, route_orchestrator, "Provides dynamic secrets and certs")
Rel(route_orchestrator, dead_letter_channel, "Routes failed messages")

@enduml