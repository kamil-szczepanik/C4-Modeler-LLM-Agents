@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data & Infrastructure Tier container

System_Ext(CoreServices, "Core Services", "External core services interacting with the data tier")
System_Ext(HybridK8s, "Hybrid Kubernetes Clusters", "Target deployment environments")

Container_Boundary(DataInfrastructureTier, "Data & Infrastructure Tier") {
    Component(PostgreSQLwithCitus, "PostgreSQL with Citus", "PostgreSQL with Citus, JDBC/TCP, TLS 1.3, AES-256", "Sharded relational storage chosen for horizontal scalability and AES-256 at-rest encryption, persisting operational data with Row-Level Security.")
    Component(RedisEnterprise, "Redis Enterprise", "Redis Enterprise, RESP, TLS 1.3", "Distributed active-active cache selected to guarantee sub-second EMR screen loads and check schedules.")
    Component(ApacheKafka, "Apache Kafka", "Apache Kafka, TCP, Payload-level encryption", "Event broker utilized for reliable, decoupled asynchronous messaging and integration.")
    Component(IstioArgoCD, "Istio & ArgoCD", "Istio, ArgoCD, Kubernetes, mTLS", "Service mesh and GitOps tooling chosen for mTLS and declarative hybrid cluster management.")
    Component(BackupPITRManager, "Backup & PITR Manager", "Velero/Barman, HTTPS, TLS 1.3, WORM locks", "Performs WAL archiving and snapshots to fulfill 10-year retention and PITR mandates.")
    Component(CentralizedVault, "Centralized Vault", "HashiCorp Vault, AES-256", "Provides automated credentials, envelope encryption keys, and ephemeral access tokens.")
    Component(EncryptedObjectStorageS3MinIO, "Encrypted Object Storage (S3/MinIO)", "S3/MinIO, HTTPS/TLS 1.3, WORM", "Object storage stack for long-term retention and backup data.")
}

Rel(CoreServices, PostgreSQLwithCitus, "Persists operational data", "JDBC/TCP, TLS 1.3, RLS")
Rel(CoreServices, RedisEnterprise, "Caches data and checks schedules", "RESP, TLS 1.3")
Rel(CoreServices, ApacheKafka, "Publishes asynchronous messages", "TCP, Payload-level encryption")
Rel(IstioArgoCD, HybridK8s, "Manages mTLS service-to-service encryption and declarative deployments", "Kubernetes / mTLS")
Rel(BackupPITRManager, EncryptedObjectStorageS3MinIO, "Performs WAL archiving and snapshots", "HTTPS/TLS 1.3, WORM locks")
Rel(CentralizedVault, DataInfrastructureTier, "Provides automated credentials, envelope encryption keys (AES-256), and ephemeral access tokens", "Secure API")

@enduml