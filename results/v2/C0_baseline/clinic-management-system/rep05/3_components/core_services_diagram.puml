@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(core_services, "Core Services") {
    Component(Patient_Administration_Component, "Patient Administration Component", "Spring Boot / Java", "Manages patient admissions, demographics, and profile data.")
    Component(Scheduling_Engine, "Scheduling Engine", "Spring Boot / Java, Temporal Java SDK, Redis", "Handles appointments, multi-resource scheduling sagas, and low-latency scheduling clash checks using distributed locking.")
    Component(EMR_Manager, "EMR Manager", "Spring Boot / Java, Spring Data JPA, PostgreSQL with Citus", "Manages electronic medical records, clinical documentation, and long-term data retention.")
    Component(Workflow_Orchestrator, "Workflow Orchestrator", "Temporal Java SDK", "Implements complex multi-resource scheduling sagas and clinical workflow orchestrations.")
}

System_Ext(Redis, "Redis", "Distributed cache and locking store")
System_Ext(PostgreSQL_Citus, "PostgreSQL (Citus)", "Distributed relational database")
System_Ext(Kafka_RabbitMQ, "Kafka/RabbitMQ", "Message broker for event streaming")
System_Ext(Centralized_Vault, "Centralized Vault", "Secrets management service")

Rel(Scheduling_Engine, Redis, "Utilizes Redlock algorithm over TLS for distributed resource locking", "TLS")
Rel(EMR_Manager, PostgreSQL_Citus, "Connects via JDBC / Spring Data JPA with HikariCP over TLS", "JDBC / TLS")
Rel(core_services, Kafka_RabbitMQ, "Publishes asynchronous domain mutation events using Spring Cloud Stream with payload-level envelope encryption", "Spring Cloud Stream")
Rel(core_services, Centralized_Vault, "Fetches dynamic secrets via AppRole tokens and Spring Cloud Vault", "Spring Cloud Vault / AppRole")

@enduml