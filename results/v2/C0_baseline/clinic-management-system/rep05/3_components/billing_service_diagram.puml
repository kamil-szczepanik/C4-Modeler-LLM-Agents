@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(billing_service, "Billing Service") {
    Component(Claim_Management_Component, "Claim Management Component", "Node.js module", "Automates insurance claims and validates them against clearinghouses.")
    Component(Payment_Processing_Component, "Payment Processing Component", "Node.js module", "Processes patient credit card and digital wallet transactions.")
    Component(Ledger_Invoicing_Component, "Ledger & Invoicing Component", "Node.js module", "Persists financial ledgers and manages patient billing records.")
    Component(Billing_Event_Handler_Component, "Billing Event Handler Component", "Node.js / Kafka Consumer", "Handles event-driven messaging and Dead Letter Queues (DLQ).")
    Component(Patient_Billing_Portal_API_Component, "Patient Billing Portal API Component", "Express router", "Exposes lightweight API routing for the billing portal.")
}

System_Ext(Core_Services, "Core Services", "External core services system")
System_Ext(Payment_Gateway, "Payment Gateway", "External payment gateway")
System_Ext(Insurance_Clearinghouses, "Insurance Clearinghouses", "External insurance clearinghouses")
System_Ext(Centralized_Vault, "Centralized Vault", "External secrets vault")
System_Ext(SIEM_Observability_System, "SIEM / Observability System", "External SIEM and observability platform")

Rel(Billing_Event_Handler_Component, Core_Services, "Consumes asynchronous event streams", "Kafka")
Rel(Payment_Processing_Component, Payment_Gateway, "Processes patient credit card and digital wallet transactions", "HTTPS / TLS 1.3")
Rel(Claim_Management_Component, Insurance_Clearinghouses, "Transmits and validates insurance claims", "HTTPS / TLS 1.3")
Rel(Ledger_Invoicing_Component, Centralized_Vault, "Fetches dynamic runtime secrets", "AppRole tokens")
Rel(Patient_Billing_Portal_API_Component, SIEM_Observability_System, "Sends tracing telemetry", "W3C Trace Context / OpenTelemetry")

@enduml