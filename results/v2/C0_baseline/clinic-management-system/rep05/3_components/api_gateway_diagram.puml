@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(TLS_Termination_Module, "TLS Termination Module", "NGINX / Kong Module", "Terminates TLS 1.3 connections from clients.")
    Component(Auth_JWT_Validation_Filter, "Auth & JWT Validation Filter", "OAuth2 / JWT Filter", "Validates OAuth2 tokens and enforces authentication.")
    Component(Rate_Limiting_Middleware, "Rate Limiting Middleware", "Redis-backed Middleware", "Enforces rate limiting using Redis for distributed control.")
    Component(Dynamic_Router_Load_Balancer, "Dynamic Router & Load Balancer", "Kong / NGINX Router", "Routes requests dynamically and balances load across backend services.")
    Component(Telemetry_Exporter, "Telemetry Exporter", "OpenTelemetry / Prometheus Exporter", "Exports telemetry and observability data.")
    Component(Async_Audit_Compliance_Logger, "Async Audit & Compliance Logger", "Asynchronous Logger", "Dispatches redacted access events asynchronously via an in-memory channel.")
}

Rel(Auth_JWT_Validation_Filter, Async_Audit_Compliance_Logger, "Dispatches redacted access events asynchronously", "in-memory channel")

@enduml