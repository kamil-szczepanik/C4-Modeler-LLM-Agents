@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application container

System_Ext(IdentityProvider, "Identity Provider", "External Identity Provider handling authentication.")
System_Ext(NGINXAPIGatewayCDN, "NGINX API Gateway / CDN", "External API gateway and CDN.")

Container_Boundary(Web_Application, "Web Application") {
    Component(ReactSPARouterandViews, "React SPA Router and Views", "React, TypeScript", "Handles client-side routing and renders user interfaces for patient admissions, EMR, scheduling, and billing.")
    Component(AuthenticationClient, "Authentication Client", "OIDC / PKCE Library", "Manages user login and token exchange with the Identity Provider.")
    Component(APIClient, "API Client", "Fetch / Axios over HTTPS", "Communicates with the NGINX API Gateway to send and retrieve data via JSON REST.")
}

Rel(ReactSPARouterandViews, AuthenticationClient, "Triggers authentication and token management")
Rel(ReactSPARouterandViews, APIClient, "Requests business data and operations")
Rel(AuthenticationClient, IdentityProvider, "Authenticates via OIDC with PKCE over HTTPS", "HTTPS")
Rel(APIClient, NGINXAPIGatewayCDN, "Sends HTTPS / JSON REST requests via TLS 1.3", "TLS 1.3 / HTTPS")

@enduml