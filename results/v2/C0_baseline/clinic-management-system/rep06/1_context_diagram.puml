@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Clinic Management System

Person(Front-Desk_Receptionist, "Front-Desk Receptionist", "Manages front-desk patient admissions and scheduling.")
Person(Clinician_Doctor, "Clinician/Doctor", "Accesses and updates EMRs and provides clinical care.")
Person(Billing_Specialist, "Billing Specialist", "Handles billing and insurance claims.")
Person(Patient, "Patient", "Interacts with the clinic for healthcare services and scheduling.")
Person(Hospital_Administrator, "Hospital Administrator", "Oversees hospital operations and management.")
Person(Compliance_Officer, "Compliance Officer", "Ensures adherence to HIPAA, GDPR, and security regulations.")

System_Ext(External_Lab___Imaging_Systems, "External Lab & Imaging Systems", "External systems providing lab results and medical imaging.")
System_Ext(Third_Party_Payment___Insurance_Gateway, "Third-Party Payment & Insurance Gateway", "External gateway for processing payments and insurance claims.")
System_Ext(Identity_Provider__IdP_, "Identity Provider (IdP)", "Handles authentication, MFA, and identity management.")

System_Boundary(Clinic_Management_System, "Clinic Management System") {
    Container(API_Gateway___Edge_Proxy, "API Gateway / Edge Proxy", "Edge Proxy", "Edge proxy for TLS termination, JWT validation, rate limiting, and edge caching.")
    Container(Centralized_KMS, "Centralized KMS", "KMS", "Manages encryption keys for data protection and compliance.")
    Container(Hybrid_Kubernetes_Clusters, "Hybrid Kubernetes Clusters", "Kubernetes", "Core software system hosted on hybrid Kubernetes for active-active high availability.")
}

Rel(Front-Desk_Receptionist, API_Gateway___Edge_Proxy, "Accesses clinical operations and patient admissions", "HTTPS / TLS 1.3 with OAuth 2.0 / OpenID Connect MFA")
Rel(Clinician_Doctor, API_Gateway___Edge_Proxy, "Accesses EMRs and clinical tools", "HTTPS / TLS 1.3 with OAuth 2.0 / OpenID Connect MFA")
Rel(Billing_Specialist, API_Gateway___Edge_Proxy, "Processes billing operations", "HTTPS / TLS 1.3 with OAuth 2.0 / OpenID Connect MFA")
Rel(Patient, API_Gateway___Edge_Proxy, "Interacts with clinic services", "HTTPS / TLS 1.3 with OAuth 2.0 / OpenID Connect MFA")
Rel(Hospital_Administrator, API_Gateway___Edge_Proxy, "Manages administrative tasks", "HTTPS / TLS 1.3 with OAuth 2.0 / OpenID Connect MFA")
Rel(Compliance_Officer, API_Gateway___Edge_Proxy, "Reviews audit logs and compliance metrics", "HTTPS / TLS 1.3 with OAuth 2.0 / OpenID Connect MFA")
Rel(Hybrid_Kubernetes_Clusters, External_Lab___Imaging_Systems, "Exchanges lab and imaging data", "HL7 FHIR REST APIs over HTTPS")
Rel(Hybrid_Kubernetes_Clusters, Third_Party_Payment___Insurance_Gateway, "Processes transactions and claims", "Secure REST/SOAP APIs")

@enduml