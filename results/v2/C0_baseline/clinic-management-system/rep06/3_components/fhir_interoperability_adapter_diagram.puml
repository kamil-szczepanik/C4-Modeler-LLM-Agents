@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the FHIR Interoperability Adapter container

System_Ext(External_Lab_Imaging_Systems, "External Lab & Imaging Systems", "External systems")
System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "External identity provider")
System_Ext(Message_Broker_Kafka, "Message Broker (Kafka)", "Message broker")
System_Ext(Audit_Compliance_Service, "Audit & Compliance Service", "Compliance service")

Container_Boundary(FHIR_Interoperability_Adapter, "FHIR Interoperability Adapter") {
    Component(FHIR_REST_Facade, "FHIR REST Facade", "Java Spring Boot / HAPI FHIR", "Exchanges lab/imaging data via HL7 FHIR API over mTLS and exposes REST endpoints.")
    Component(Security_Auth_Enforcer, "Security & Auth Enforcer", "In-process Java / OAuth 2.0 / OIDC", "Validates credentials and handles token introspection & JWT verification.")
    Component(Transformation_Engine, "Transformation Engine", "Java", "Transforms FHIR payloads and invokes outbound dispatching or message publishing.")
    Component(Outbound_Dispatcher, "Outbound Dispatcher", "Java", "Dispatches transformed messages externally or internally.")
    Component(Audit_Logger_Interceptor, "Audit Logger Interceptor", "Java / gRPC over mTLS", "Intercepts operations and emits audit trails to the compliance service.")
}

Rel(External_Lab_Imaging_Systems, FHIR_REST_Facade, "Exchanges lab/imaging data", "HL7 FHIR API over mTLS")
Rel(FHIR_REST_Facade, Security_Auth_Enforcer, "Validates credentials", "In-process Java")
Rel(Security_Auth_Enforcer, Identity_Provider_IdP, "Token introspection & JWT verification", "OAuth 2.0 / OIDC")
Rel(FHIR_REST_Facade, Transformation_Engine, "Direct method calls", "Java")
Rel(Transformation_Engine, Message_Broker_Kafka, "Publishes clinical events asynchronously", "Kafka Protocol")
Rel(FHIR_Interoperability_Adapter, Audit_Compliance_Service, "Emits audit trails", "gRPC over mTLS")

@enduml