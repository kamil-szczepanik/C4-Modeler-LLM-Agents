@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit & Compliance Service container

Person(ComplianceOfficer, "Compliance Officer", "Compliance officer")
System_Ext(AsynchronousBuffer, "Asynchronous Buffer", "NATS JetStream")
System_Ext(AWSS3ObjectLock, "AWS S3 Object Lock", "AWS S3 Object Lock")
System_Ext(AuditDataRepository, "Audit Data Repository", "PostgreSQL")

Container_Boundary(AuditComplianceService, "Audit & Compliance Service") {
    Component(EventIngestionController, "Event Ingestion Controller", "Go gRPC Server", "Streams and processes audit events from the asynchronous buffer.")
    Component(ComplianceReportingEngine, "Compliance Reporting Engine", "Go Native Package", "Provides secure reporting tools for compliance officers.")
    Component(RetentionPolicyEnforcer, "Retention Policy Enforcer", "Go Worker", "Applies WORM policies and manages data retention.")
    Component(DSARQueryProcessor, "DSAR Query Processor", "Go Native Package", "Processes data subject access requests and queries metadata.")
    Component(ReportScheduler, "Report Scheduler", "Go Cron/Worker", "Schedules compliance report generation.")
}

Rel(AsynchronousBuffer, EventIngestionController, "Streams audit events", "gRPC")
Rel(RetentionPolicyEnforcer, AWSS3ObjectLock, "Applies WORM policies", "HTTPS, IAM")
Rel(ComplianceOfficer, ComplianceReportingEngine, "Accesses reports", "HTTPS, JWT/RBAC")
Rel(ComplianceOfficer, DSARQueryProcessor, "Accesses queries", "HTTPS, JWT/RBAC")
Rel(DSARQueryProcessor, AuditDataRepository, "Queries metadata", "SQL over TLS")

@enduml