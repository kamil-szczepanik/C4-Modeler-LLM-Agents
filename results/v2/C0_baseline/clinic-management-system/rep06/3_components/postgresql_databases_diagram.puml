@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL databases container

Container_Boundary(postgresql_databases, "PostgreSQL databases") {
    Component(ConnectionPooler, "Connection Pooler", "PgBouncer", "Manages high connection concurrency and prevents resource starvation.")
    Component(PostgreSQLPrimaryInstance, "PostgreSQL Primary Instance", "AWS RDS / On-Prem StatefulSet", "Primary relational database handling write operations and maintaining enterprise data integrity for patient admissions, EMR, scheduling, and billing.")
    Component(ReadReplicaCluster, "Read Replica Cluster", "PostgreSQL Streaming Replication", "Cluster of read-only replicas scaling read workloads and supporting high-performance clinical workflows.")
    Component(EncryptionandBackupDaemon, "Encryption and Backup Daemon", "pgaudit, pgcrypto, WAL streaming", "Enforces deep audit logging, column-level encryption for HIPAA/GDPR compliance, and WAL streaming for immutable archival.")
    Component(MigrationEngine, "Migration Engine", "Flyway / Liquibase", "Ensures idempotent schema updates via CI/CD pipelines across Core Clinical, Scheduling, and Billing schemas.")
}

Rel(ConnectionPooler, PostgreSQLPrimaryInstance, "TCP/SSL connection pooling", "TCP/SSL")
Rel(ConnectionPooler, ReadReplicaCluster, "TCP/SSL connection pooling", "TCP/SSL")
Rel(EncryptionandBackupDaemon, PostgreSQLPrimaryInstance, "WAL streaming for immutable archival", "WAL streaming")
Rel(MigrationEngine, PostgreSQLPrimaryInstance, "Schema migrations and updates", "SQL")
@enduml