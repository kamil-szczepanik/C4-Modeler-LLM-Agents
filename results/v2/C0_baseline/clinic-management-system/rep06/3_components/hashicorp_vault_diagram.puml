@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(vault_container, "HashiCorp Vault") {
    Component(TransitSecretsEngine, "Transit Secrets Engine", "HashiCorp Vault Engine", "Provides cryptographic services for data encryption and decryption (AES-256) used by core services.")
    Component(DatabaseSecretsEngines, "Database Secrets Engines", "HashiCorp Vault Engine", "Generates dynamic credentials for PostgreSQL databases on-demand.")
    Component(SecretsManagementAPI, "Secrets Management API", "HTTPS (REST/gRPC)", "Handles secure secret retrieval and authentication requests from core services via Kubernetes Service Accounts (JWT/AppRole) and mTLS.")
}

Rel(SecretsManagementAPI, TransitSecretsEngine, "Invokes cryptographic operations")
Rel(SecretsManagementAPI, DatabaseSecretsEngines, "Requests dynamic database credentials")

@enduml