@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing & Claims Service container

Container_Boundary(billing_and_claims_service, "Billing & Claims Service") {
    Component(Claim_Scrubbing_Component, "Claim Scrubbing Component", "Drools / Spring Component", "Local rules engine for offline claim scrubbing and error prevention.")
    Component(Claim_Management_Component, "Claim Management Component", "Spring MVC/Data", "Manages claims processing, data access, and interactions with external payment gateways.")
    Component(Payment_Processing_Component, "Payment Processing Component", "Java Spring Boot", "Processes payments and financial transactions.")
    Component(Dispute_Management_Component, "Dispute Management Component", "Spring REST", "Handles billing disputes and logs actions to audit services.")
    Component(Billing_Archive_Component, "Billing Archive Component", "Java Spring Boot", "Manages encrypted long-term retention of billing data.")
}

Component_Ext(Third_Party_Payment___Insurance_Gateway, "Third-Party Payment & Insurance Gateway", "External Gateway", "Handles real-time eligibility and submissions via REST/JSON, mTLS, and Async Message Broker.")
Component_Ext(AWS_S3_Object_Lock, "AWS S3 Object Lock", "WORM Storage / AWS SDK", "Provides immutable 10-year data retention with encryption.")
Component_Ext(HashiCorp_Vault, "HashiCorp Vault", "Secret Management", "Handles secret management for envelope encryption and PHI data protection.")
Component_Ext(Patient_Portal_Frontend, "Patient Portal Frontend", "React", "Frontend interface allowing patients to submit billing disputes.")
Component_Ext(Audit___Compliance_Service, "Audit & Compliance Service", "Microservice", "Logs compliance and dispute actions securely.")

Rel(Claim_Scrubbing_Component, Claim_Management_Component, "Passes validated claims", "In-memory Java Method Call")
Rel(Claim_Management_Component, Third_Party_Payment___Insurance_Gateway, "Real-time eligibility & submission", "REST/JSON, mTLS, Async Message Broker")
Rel(Dispute_Management_Component, Audit___Compliance_Service, "Logs dispute actions", "gRPC, mTLS")
Rel(Patient_Portal_Frontend, Dispute_Management_Component, "Submits billing disputes", "REST/JSON, OAuth2, mTLS")
Rel(Billing_Archive_Component, AWS_S3_Object_Lock, "Encrypted long-term retention", "HTTPS, AWS SDK")

@enduml