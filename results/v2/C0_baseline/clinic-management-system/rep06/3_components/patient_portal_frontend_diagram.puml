@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient Portal Frontend container

System_Ext(api_gateway, "API Gateway", "API Gateway (Kong/NGINX) routing incoming requests.")

Container_Boundary(patient_portal_frontend, "Patient Portal Frontend") {
    Component(auth_session_mgr, "Authentication & Session Manager", "React, TypeScript, React Query", "Manages user authentication, session state, and secure token storage for patients accessing the portal.")
    Component(appointment_sched_mod, "Appointment & Scheduling Module", "React, TypeScript, Tailwind CSS", "Provides the user interface for patients to view, book, and manage clinic appointments.")
    Component(demographics_profile_form, "Demographics & Profile Form", "React, TypeScript, Tailwind CSS", "Allows patients to view and update their personal demographics and profile information.")
    Component(accessibility_loc_mod, "Accessibility & Localization Module", "React, TypeScript", "Ensures compliance with accessibility standards and supports multi-language localization.")
    Component(api_client_layer, "API Client Layer", "TypeScript, React Query, HTTPS/REST", "Handles HTTP/REST communication and data fetching with the API Gateway.")
}

Rel(appointment_sched_mod, api_client_layer, "Uses to send scheduling requests")
Rel(demographics_profile_form, api_client_layer, "Uses to update patient profile data")
Rel(auth_session_mgr, api_client_layer, "Uses for authentication and token validation requests")
Rel(api_client_layer, api_gateway, "Makes API requests", "HTTPS/REST")

@enduml