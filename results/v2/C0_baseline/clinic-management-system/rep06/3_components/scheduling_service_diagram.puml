@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Scheduling Service container

Container_Boundary(scheduling_service, "Scheduling Service") {
    Component(Appointment_API_Controller, "Appointment API Controller", "Node.js (Fastify) or Python (FastAPI)", "Exposes REST/GraphQL endpoints for appointment management.")
    Component(Clash_Detection_Engine, "Clash Detection Engine", "Node.js / Python with Redis and PostgreSQL OCC", "Persists appointments, checks availability, and manages distributed locks to prevent race conditions.")
    Component(Notification_Dispatcher, "Notification Dispatcher", "Node.js / Python", "Sends SMS and email reminders via the External Notification Gateway.")
    Component(Event_Publisher_Component, "Event Publisher Component", "Apache Kafka / RabbitMQ Client", "Streams asynchronous lifecycle and audit events.")
}

Rel(Appointment_API_Controller, Clash_Detection_Engine, "Delegates appointment scheduling and validation requests", "In-process / Internal")
Rel(Clash_Detection_Engine, Notification_Dispatcher, "Triggers notifications upon successful scheduling", "In-process / Internal")
Rel(Clash_Detection_Engine, Event_Publisher_Component, "Publishes appointment lifecycle events", "In-process / Internal")

@enduml