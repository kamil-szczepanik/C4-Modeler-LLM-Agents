@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Edge_TLS_Termination___WAF_Proxy, "Edge TLS Termination & WAF Proxy", "Kong/NGINX/Envoy Proxy", "Handles edge TLS termination, web application firewall (WAF) protection, and edge PHI scrubbing.")
    Component(Authentication___JWT_Validation_Filter, "Authentication & JWT Validation Filter", "Kong/NGINX/Envoy Plugin", "Validates incoming JSON Web Tokens and handles token introspection with the Identity Provider.")
    Component(Routing___Rate_Limiting_Engine, "Routing & Rate-Limiting Engine", "Kong/NGINX/Envoy Engine", "Executes routing rules, tenant-aware rate limiting, and traffic direction to upstream microservices.")
    Component(API_Developer_Portal___Consumer_Registry, "API Developer Portal & Consumer Registry", "Kong/NGINX/Envoy Portal", "Manages API consumers, developer documentation, and credential registries.")
    Component(Dynamic_Service_Discovery___Upstream_Resolver, "Dynamic Service Discovery & Upstream Resolver", "Kong/NGINX/Envoy Resolver", "Resolves upstream microservice endpoints dynamically for secure mTLS routing.")
}

Rel(Edge_TLS_Termination___WAF_Proxy, Authentication___JWT_Validation_Filter, "Passes decrypted requests for token validation", "")
Rel(Authentication___JWT_Validation_Filter, Routing___Rate_Limiting_Engine, "Passes authenticated requests for rate limiting and routing", "")
Rel(Routing___Rate_Limiting_Engine, Dynamic_Service_Discovery___Upstream_Resolver, "Queries for upstream service locations", "")

@enduml