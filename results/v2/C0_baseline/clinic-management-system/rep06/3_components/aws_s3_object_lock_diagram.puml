@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS S3 Object Lock container

Container_Boundary(aws_s3_object_lock, "AWS S3 Object Lock") {
    Component(BucketPolicyManager, "Bucket Policy Manager", "AWS S3 / Bucket Policy Engine", "Manages and enforces access policies, retention parameters, and compliance rules for immutable WORM storage.")
    Component(RetentionModeEngine, "Retention Mode Engine", "Java / AWS SDK", "Enforces Compliance and Governance retention modes to prevent accidental or malicious deletion or modification of clinical and audit records.")
    Component(LegalHoldController, "Legal Hold Controller", "Java / AWS SDK", "Applies and removes legal holds on medical records and audit trails independently of retention periods.")
    Component(LifecycleTransitionManager, "Lifecycle Transition Manager", "AWS S3 Lifecycle / AWS SDK", "Automates the transition of immutable objects from standard storage to AWS S3 Glacier Flexible/Deep Archive for long-term retention.")
}

Rel(BucketPolicyManager, RetentionModeEngine, "Enforces retention configurations based on bucket compliance policies.", "")
Rel(RetentionModeEngine, LegalHoldController, "Coordinates protection states with legal hold requirements.", "")
Rel(RetentionModeEngine, LifecycleTransitionManager, "Triggers archival transitions respecting active retention and hold states.", "")

@enduml