@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(StaffUsers, "Hospital Staff", "Front-Desk Receptionist, Clinician, Billing Specialist, Administrator, Compliance Officer")
System_Ext(ApiGateway, "API Gateway", "API Gateway handling core backend services")
System_Ext(AuditService, "Audit & Compliance Service", "Receives workflow audit events")

Container_Boundary(StaffWebApp, "Staff Web Application") {
    Component(AuthContext, "Authentication & RBAC Context Provider", "React Context / JavaScript / TypeScript", "Manages session state, JWT tokens, and enforces role-based module rendering.")
    Component(PatientModule, "Patient & Admissions Module", "React UI Components", "UI components for demographic capture and patient check-in.")
    Component(SchedulingWorkspace, "Scheduling Workspace", "React / Interactive Calendar", "Interactive calendar and resource-allocation grid communicating with backend scheduling services.")
    Component(EmrWorkspace, "EMR Clinical Workspace", "React / High-Performance Data Grid", "High-performance data grid optimized for sub-second rendering of medical histories.")
    Component(BillingDashboard, "Billing & Admin Dashboard", "React UI Views", "Views for invoicing, payment operations, and compliance reporting.")
    Component(ApiClientLayer, "API Client Layer", "Axios / Fetch Interceptors", "Handles HTTPS/REST calls, client caching, and audit event transmission.")
    Component(SessionGuard, "Session & Inactivity Guard", "React Component", "Managing 15-minute idle timeouts and memory state purging.")
    Component(AuditInterceptor, "Audit & Telemetry Interceptor", "JavaScript / TypeScript", "Captures critical workflow events and emits audit data.")
}

Rel(StaffUsers, StaffWebApp, "Accesses clinical tools, admissions, and dashboards", "HTTPS/REST")
Rel(ApiClientLayer, ApiGateway, "Sends API requests and retrieves core data", "HTTPS/REST over TLS 1.3")
Rel(AuditInterceptor, AuditService, "Transmits workflow audit events", "HTTPS/REST")

@enduml