@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Clinical & EMR Service container

System_Ext(API_Gateway, "API Gateway", "Gateway", "Routes incoming EMR REST requests.")
System_Ext(Audit_Compliance_Service, "Audit & Compliance Service", "Go/Spring Boot", "External service receiving audit logs.")
System_Ext(HashiCorp_Vault, "HashiCorp Vault", "HashiCorp Vault", "Provides dynamic secret injection, ephemeral credentials, and key management.")

Container_Boundary(core_clinical_emr_service, "Core Clinical & EMR Service") {
    Component(EMR_Orchestrator_Component, "EMR Orchestrator Component", "Java/Spring MVC", "Manages REST requests and clinical workflow coordination.")
    Component(CDR_Access_Component, "CDR Access Component", "Spring Data JPA", "Interacts with PostgreSQL via PgBouncer for data persistence.")
    Component(Audit_Interceptor_Component, "Audit Interceptor Component", "AspectJ / Spring AOP", "Emits asynchronous gRPC audit events.")
    Component(Security_Enforcement_Component, "Security Enforcement Component", "Spring Security", "Handles ABAC/RBAC and dynamic HashiCorp Vault tokenization.")
    Component(PostgreSQL_Databases, "PostgreSQL Databases", "PostgreSQL", "Primary datastore featuring column-level encryption and active-passive replication.")
}

Rel(API_Gateway, EMR_Orchestrator_Component, "Routes incoming EMR REST requests", "OAuth2/OIDC, mTLS")
Rel(CDR_Access_Component, PostgreSQL_Databases, "Executes optimized queries and reads", "PostgreSQL Protocol, mTLS")
Rel(Audit_Interceptor_Component, Audit_Compliance_Service, "Emits cryptographic audit events", "gRPC, mTLS")
Rel(Security_Enforcement_Component, HashiCorp_Vault, "Retrieves dynamic, short-lived database credentials and encryption keys", "HTTPS/REST, mTLS")

@enduml