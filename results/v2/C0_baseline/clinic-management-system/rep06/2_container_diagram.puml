@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Patient, "Patient", "Interacts via the patient portal for appointments and records.")
Person(FrontDeskReceptionist, "Front-Desk Receptionist", "Manages patient admissions and front-desk scheduling.")
Person(ClinicianDoctor, "Clinician/Doctor", "Accesses and updates electronic medical records and clinical workflows.")
Person(BillingSpecialist, "Billing Specialist", "Handles billing and insurance claims.")
Person(HospitalAdministrator, "Hospital Administrator", "Oversees hospital operations and management.")
Person(ComplianceOfficer, "Compliance Officer", "Ensures compliance and reviews audit logs.")

System_Ext(ExternalLabImagingSystems, "External Lab & Imaging Systems", "External systems providing lab results and medical imaging.")
System_Ext(ThirdPartyPaymentInsuranceGateway, "Third-Party Payment & Insurance Gateway", "External gateway for processing payments and insurance claims.")
System_Ext(IdentityPoviderIdP, "Identity Provider (IdP)", "Handles authentication and access control.")

System_Boundary(ClinicManagementSystem, "Clinic Management System") {
    Container(APIGateway, "API Gateway", "Kong/NGINX (Envoy)", "Edge proxy for routing, rate limiting, and security enforcement.")
    Container(PatientPortalFrontend, "Patient Portal Frontend", "React", "Single page application for patient interactions.")
    Container(StaffWebApplication, "Staff Web Application", "React", "Web application for staff and clinicians.")
    Container(CoreClinicalEMRService, "Core Clinical & EMR Service", "Java Spring Boot", "Manages electronic medical records and core clinical workflows.")
    Container(SchedulingService, "Scheduling Service", "Node.js/Python", "Handles appointments and scheduling.")
    Container(BillingClaimsService, "Billing & Claims Service", "Java Spring Boot", "Manages billing operations and insurance claims.")
    Container(FHIRInteroperabilityAdapter, "FHIR Interoperability Adapter", "HAPI FHIR", "Adapts data for HL7 FHIR interoperability.")
    Container(AuditComplianceService, "Audit & Compliance Service", "Go/Spring Boot", "Logs audit trails and enforces compliance requirements.")
    ContainerDb(PostgreSQLdatabases, "PostgreSQL databases", "PostgreSQL", "Persistent relational storage with encryption at rest.")
    Container(AWSS3ObjectLock, "AWS S3 Object Lock", "AWS S3", "WORM storage for audit compliance.")
    Container(HashiCorpVault, "HashiCorp Vault", "HashiCorp Vault", "Secrets management and encryption key storage.")
}

Rel(Patient, PatientPortalFrontend, "Accesses patient portal", "HTTPS/REST")
Rel(FrontDeskReceptionist, StaffWebApplication, "Manages admissions and scheduling", "HTTPS/REST")
Rel(ClinicianDoctor, StaffWebApplication, "Accesses EMRs and clinical tools", "HTTPS/REST")
Rel(BillingSpecialist, StaffWebApplication, "Manages billing operations", "HTTPS/REST")
Rel(HospitalAdministrator, StaffWebApplication, "Views administrative dashboards", "HTTPS/REST")
Rel(ComplianceOfficer, StaffWebApplication, "Reviews compliance reports", "HTTPS/REST")
Rel(PatientPortalFrontend, APIGateway, "Makes API requests", "HTTPS/REST")
Rel(StaffWebApplication, APIGateway, "Makes API requests", "HTTPS/REST")
Rel(APIGateway, CoreClinicalEMRService, "Routes EMR requests", "OAuth2/OIDC, mTLS")
Rel(APIGateway, SchedulingService, "Routes scheduling requests", "OAuth2/OIDC, mTLS")
Rel(APIGateway, BillingClaimsService, "Routes billing requests", "OAuth2/OIDC, mTLS")
Rel(CoreClinicalEMRService, AuditComplianceService, "Sends audit events", "gRPC, mTLS")
Rel(BillingClaimsService, AuditComplianceService, "Sends audit events", "gRPC, mTLS")
Rel(FHIRInteroperabilityAdapter, ExternalLabImagingSystems, "Exchanges lab and imaging data", "HL7 FHIR API")
Rel(BillingClaimsService, ThirdPartyPaymentInsuranceGateway, "Processes payments and claims", "mTLS, Async Messaging")

@enduml