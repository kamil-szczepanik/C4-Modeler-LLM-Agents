@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "Patients across the EU and US seeking video consultations, e-prescriptions, and AI symptom checks.")
Person(Clinicians, "Licensed Clinicians", "Licensed medical professionals delivering cross-border care to patients.")

System_Ext(National_E_Prescription_Gateways_EU_Surescripts_Pharmacy_Networks_US, "National E-Prescription Gateways (EU) & Surescripts/Pharmacy Networks (US)", "External gateways and pharmacy networks for dispatching e-prescriptions.")
System_Ext(Regional_Identity_Providers_IDP, "Regional Identity Providers (IDP)", "External regional IDPs handling authentication and identity.")
System_Ext(External_Payment_Gateways_Stripe_Insurance_APIs, "External Payment Gateways (Stripe / Insurance APIs)", "External systems handling payments and insurance integrations.")
System_Ext(Global_TURN_STUN_Edge_Relays, "Global TURN/STUN Edge Relays", "Edge relays supporting WebRTC video consultations.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(React_Flutter_Web_and_Mobile_Apps, "React / Flutter Web and Mobile Apps", "React, Flutter", "Frontend web and mobile application frameworks providing user interfaces for patients and clinicians.")
    Container(Google_Cloud_API_Gateway_Region_Router, "Google Cloud API Gateway / Region Router", "Google Cloud API Gateway", "Routes incoming traffic to regional VPCs using geo-routing.")
    Container(Go_Spring_Boot_Core_Telehealth_Backends, "Go / Spring Boot Core Telehealth Backends", "Go, Spring Boot", "Core microservices for high-performance backend logic and handling medical workflows in EU/US regional VPCs.")
    Container(LiveKit_WebRTC_SFU_Video_Media_Servers, "LiveKit / WebRTC SFU Video Media Servers", "LiveKit, WebRTC SFU", "Video streaming servers supporting degraded-mode (<300 kbit/s) video consultations.")
    Container(Python_FastAPI_TensorFlow_AI_Symptom_Checker_Container, "Python / FastAPI + TensorFlow AI Symptom Checker Container", "Python, FastAPI, TensorFlow", "AI Symptom Checker implementation for processing patient symptoms.")
    Container(Open_Policy_Agent_OPA_Consent_Management_Container, "Open Policy Agent (OPA) Consent Management Container", "Open Policy Agent (OPA)", "Real-time authorization and consent evaluation for regional privacy mandates.")
    Container(E_Prescription_Integration_Service, "E-Prescription Integration Service", "REST, HL7 FHIR", "Integrates with national EU standards and US Surescripts networks to dispatch e-prescriptions.")
    ContainerDb(Google_Cloud_SQL_Cloud_Storage, "Google Cloud SQL & Cloud Storage", "Google Cloud SQL, Google Cloud Storage, Cloud KMS", "Regional databases and object storage with CMEK encryption for immutable AI audit logging and patient data.")
}

Rel(Patients, React_Flutter_Web_and_Mobile_Apps, "Accesses video consultations, e-prescriptions, and AI symptom checker", "HTTPS and WebSockets")
Rel(Clinicians, React_Flutter_Web_and_Mobile_Apps, "Delivers care and manages patient consultations", "HTTPS and WebSockets")
Rel(React_Flutter_Web_and_Mobile_Apps, Google_Cloud_API_Gateway_Region_Router, "Sends API requests and traffic", "HTTPS")
Rel(Google_Cloud_API_Gateway_Region_Router, Go_Spring_Boot_Core_Telehealth_Backends, "Routes incoming traffic to regional backends", "gRPC over Istio mTLS mesh")
Rel(Go_Spring_Boot_Core_Telehealth_Backends, Google_Cloud_SQL_Cloud_Storage, "Queries regional databases and logs data", "SQL / HTTPS")
Rel(Go_Spring_Boot_Core_Telehealth_Backends, Open_Policy_Agent_OPA_Consent_Management_Container, "Enforces rules and evaluates authorization", "gRPC over Istio mTLS mesh")
Rel(Go_Spring_Boot_Core_Telehealth_Backends, Python_FastAPI_TensorFlow_AI_Symptom_Checker_Container, "Requests AI symptom analysis", "gRPC over Istio mTLS mesh")
Rel(Go_Spring_Boot_Core_Telehealth_Backends, E_Prescription_Integration_Service, "Triggers e-prescription dispatch", "gRPC over Istio mTLS mesh")
Rel(Go_Spring_Boot_Core_Telehealth_Backends, LiveKit_WebRTC_SFU_Video_Media_Servers, "Initiates video session streams", "WebRTC")
Rel(Python_FastAPI_TensorFlow_AI_Symptom_Checker_Container, Google_Cloud_SQL_Cloud_Storage, "Logs inputs and model versions with CMEK", "HTTPS")
Rel(E_Prescription_Integration_Service, National_E_Prescription_Gateways_EU_Surescripts_Pharmacy_Networks_US, "Dispatches e-prescriptions and integrates with pharmacies", "REST and HL7 FHIR")
Rel(Go_Spring_Boot_Core_Telehealth_Backends, Regional_Identity_Providers_IDP, "Authenticates users", "OIDC and OAuth2")
Rel(Go_Spring_Boot_Core_Telehealth_Backends, External_Payment_Gateways_Stripe_Insurance_APIs, "Processes payments and insurance claims", "HTTPS and REST")
Rel(LiveKit_WebRTC_SFU_Video_Media_Servers, Global_TURN_STUN_Edge_Relays, "Relays video traffic through edge nodes", "STUN/TURN")

@enduml