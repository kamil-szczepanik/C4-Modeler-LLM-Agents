@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "Patients across the EU and US seeking video consultations, e-prescriptions, and AI symptom checks.")
Person(LicensedClinicians, "Licensed Clinicians", "Licensed medical professionals delivering cross-border care to patients.")

System(CrossBorderTelehealthPlatform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for patients across the EU and US while enforcing strict regional data residency.")

System_Ext(NationalEPrescriptionGatewaysEUSurescriptsPharmacyNetworksUS, "National E-Prescription Gateways (EU) & Surescripts/Pharmacy Networks (US)", "External gateways and pharmacy networks for dispatching e-prescriptions.")
System_Ext(RegionalIdentityProvidersIDP, "Regional Identity Providers (IDP)", "External regional IDPs handling authentication and identity.")
System_Ext(ExternalPaymentGatewaysStripeInsuranceAPIs, "External Payment Gateways (Stripe / Insurance APIs)", "External systems handling payments and insurance integrations.")
System_Ext(GlobalTURNSTUNEdgeRelays, "Global TURN/STUN Edge Relays", "Edge relays supporting WebRTC video consultations.")

Rel(Patients, CrossBorderTelehealthPlatform, "Accesses video consultations, e-prescriptions, and AI symptom checker", "HTTPS and WebRTC")
Rel(LicensedClinicians, CrossBorderTelehealthPlatform, "Delivers care and manages patient consultations", "HTTPS and WebRTC")
Rel(CrossBorderTelehealthPlatform, NationalEPrescriptionGatewaysEUSurescriptsPharmacyNetworksUS, "Dispatches e-prescriptions and integrates with pharmacies", "REST and HL7 FHIR over mTLS")
Rel(CrossBorderTelehealthPlatform, RegionalIdentityProvidersIDP, "Authenticates users via regional identity providers", "OIDC and OAuth2")
Rel(CrossBorderTelehealthPlatform, ExternalPaymentGatewaysStripeInsuranceAPIs, "Processes payments and insurance claims", "HTTPS and REST")
@enduml