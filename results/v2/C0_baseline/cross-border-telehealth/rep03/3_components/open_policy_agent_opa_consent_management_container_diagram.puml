@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(opa_container, "Open Policy Agent (OPA) Consent Management Container") {
    Component(opa_engine, "OPA Policy Engine", "Open Policy Agent (OPA)", "Evaluates real-time authorization and consent policies for telehealth workflows.")
    Component(opa_bundle_manager, "OPA Bundle Manager", "HTTPS Client", "Fetches policy bundles and configurations from Google Cloud Storage.")
    Component(consent_evaluator_api, "Consent Evaluator API", "gRPC Server", "Provides local loopback gRPC endpoints for core telehealth backends.")
}

System_Ext(google_cloud_sql, "Google Cloud SQL", "Stores persistent relational data for the platform.")
System_Ext(google_cloud_storage, "Google Cloud Storage", "Stores policy bundles and static assets.")

Rel(consent_evaluator_api, opa_engine, "Evaluates requests against consent rules", "gRPC")
Rel(opa_engine, google_cloud_sql, "Executes read-only SQL queries via Istio mTLS", "SQL/mTLS")
Rel(opa_bundle_manager, google_cloud_storage, "Downloads policy bundles via HTTPS over Istio mTLS", "HTTPS/mTLS")

@enduml