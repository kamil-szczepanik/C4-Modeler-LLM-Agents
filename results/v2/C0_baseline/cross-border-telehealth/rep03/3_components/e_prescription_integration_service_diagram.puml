@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(e_prescription_integration_service, "E-Prescription Integration Service") {
    Component(Prescription Orchestrator Component, "Prescription Orchestrator Component", "Go", "Orchestrates prescription dispatch workflows to EU national gateways and US Surescripts networks.")
    Component(US FHIR Adapter Component, "US FHIR Adapter Component", "Go", "Adapts and translates prescription data for US Surescripts networks using HL7 FHIR over HTTPS/REST.")
    Component(EU National Gateway Adapter Component, "EU National Gateway Adapter Component", "Go", "Adapts and dispatches prescriptions to EU national e-prescription gateways via mutual TLS and REST.")
    Component(Audit & Compliance Logger Component, "Audit & Compliance Logger Component", "Go", "Logs compliance and audit events to ensure adherence to regional data residency regulations.")
    Component(Event Dispatcher Component, "Event Dispatcher Component", "Go", "Handles resilient asynchronous message processing and event dispatching via Google Cloud Pub/Sub.")
    Component(Circuit Breaker & Retry Middleware, "Circuit Breaker & Retry Middleware", "Go", "Provides resilience and fault tolerance across unstable cross-border networks.")
}

Rel(Prescription Orchestrator Component, US FHIR Adapter Component, "Dispatches US prescriptions", "Internal Go interfaces")
Rel(Prescription Orchestrator Component, EU National Gateway Adapter Component, "Dispatches EU prescriptions", "Internal Go interfaces")
Rel(US FHIR Adapter Component, Circuit Breaker & Retry Middleware, "Uses middleware for network calls", "Go interfaces")
Rel(EU National Gateway Adapter Component, Circuit Breaker & Retry Middleware, "Uses middleware for network calls", "Go interfaces")
Rel(Event Dispatcher Component, Audit & Compliance Logger Component, "Publishes asynchronous events", "Google Cloud Pub/Sub")
@enduml