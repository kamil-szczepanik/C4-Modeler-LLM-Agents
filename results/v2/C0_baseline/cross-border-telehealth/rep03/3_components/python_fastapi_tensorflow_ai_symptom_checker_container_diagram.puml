@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(python_fastapi_tensorflow_ai_symptom_checker_container, "Python / FastAPI + TensorFlow AI Symptom Checker Container") {
    Component(AI_Symptom_Checker_API, "AI Symptom Checker API", "Python / FastAPI", "Exposes endpoints for low-latency, localized AI symptom triage via gRPC.")
    Component(TensorFlow_Inference_Engine, "TensorFlow Inference Engine", "TensorFlow Serving", "Evaluates patient symptoms using localized machine learning models.")
    Component(Audit_Event_Publisher, "Audit Event Publisher", "Python Client Library", "Emits asynchronous audit events to Google Cloud Pub/Sub.")
}

Rel(AI_Symptom_Checker_API, TensorFlow_Inference_Engine, "Requests symptom inference", "gRPC")
Rel(AI_Symptom_Checker_API, Audit_Event_Publisher, "Triggers compliance logging", "gRPC / HTTPS")

@enduml