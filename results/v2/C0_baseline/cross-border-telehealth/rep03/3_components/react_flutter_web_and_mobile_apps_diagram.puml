@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the React / Flutter Web and Mobile Apps container

Container_Boundary(react_flutter_container, "React / Flutter Web and Mobile Apps") {
    Component(Cross_Platform_UI_Module, "Cross-Platform UI Module", "React & Flutter", "Frontend web and mobile application framework for cross-platform user interfaces.")
    Component(Local_Storage_Encryption_Manager, "Local Storage Encryption Manager", "SQLCipher & Web Crypto API", "Provides encrypted local storage for protecting PHI on client devices.")
    Component(WebRTC_Media_Client_Wrapper, "WebRTC Media Client Wrapper", "LiveKit Client SDK", "Manages adaptive bitrate video streaming for WebRTC consultations.")
    Component(Authentication_Client, "Authentication Client", "OAuth 2.0 with PKCE & JWT", "Handles secure authentication and short-lived session management.")
}

Rel(Cross_Platform_UI_Module, Local_Storage_Encryption_Manager, "Stores and retrieves PHI securely using", "SQLCipher & Web Crypto API")
Rel(Cross_Platform_UI_Module, WebRTC_Media_Client_Wrapper, "Initiates video streams via", "LiveKit Client SDK")
Rel(Cross_Platform_UI_Module, Authentication_Client, "Authenticates users via", "OAuth 2.0 with PKCE & JWT")

@enduml