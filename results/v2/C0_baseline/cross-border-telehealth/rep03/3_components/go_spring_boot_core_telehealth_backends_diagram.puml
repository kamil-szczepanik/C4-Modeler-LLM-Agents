@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Go / Spring Boot Core Telehealth Backends container

Container_Boundary(core_telehealth_backends, "Go / Spring Boot Core Telehealth Backends") {
    Component(Go Consultation & API Gateway Pod, "Go Consultation & API Gateway Pod", "Go", "Powers high-concurrency API routing and real-time consultation workflow orchestration.")
    Component(Spring Boot Integration & Transformation Pod, "Spring Boot Integration & Transformation Pod", "Spring Boot", "Powers complex HL7 FHIR and national e-prescription format transformations.")
}

Rel(Go Consultation & API Gateway Pod, Spring Boot Integration & Transformation Pod, "Mediates clinical workflows", "gRPC over Istio mTLS mesh")

@enduml