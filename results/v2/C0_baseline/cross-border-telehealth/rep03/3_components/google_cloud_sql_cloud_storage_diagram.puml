@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("google_cloud_sql_cloud_storage", "Google Cloud SQL & Cloud Storage") {
    Component("PostgreSQL_15_Cloud_SQL_Instance", "PostgreSQL 15 Cloud SQL Instance", "PostgreSQL 15", "Provides Row-Level Security (RLS) for multi-tenant data isolation and schema mapping per jurisdiction.")
    Component("Google_Cloud_Storage", "Google Cloud Storage", "Google Cloud Storage (Standard Tier)", "Stores binary artifacts and export packages with automatic lifecycle management and 24-hour purge rules.")
    Component("Cloud_KMS_Cloud_HSM", "Cloud KMS & Cloud HSM", "Google Cloud KMS / Cloud HSM", "Secures regional data via CMEK and enables cryptographic erasure.")
    Component("PostgreSQL_Soft_Delete_Tombstone_Manager", "PostgreSQL Soft-Delete & Tombstone Manager", "PostgreSQL / SQL", "Handles soft-delete records and tombstone management for database rows.")
}

Rel("PostgreSQL_15_Cloud_SQL_Instance", "Cloud_KMS_Cloud_HSM", "Secures regional data via CMEK and cryptographic keys", "Encryption / TLS 1.3")
Rel("Google_Cloud_Storage", "Cloud_KMS_Cloud_HSM", "Encrypts binary payloads and export packages with CMEK", "Encryption / TLS 1.3")
Rel("PostgreSQL_Soft_Delete_Tombstone_Manager", "PostgreSQL_15_Cloud_SQL_Instance", "Manages soft-deletes and tombstones for compliance", "SQL")

@enduml