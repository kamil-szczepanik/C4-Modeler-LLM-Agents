@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Google Cloud API Gateway / Region Router", "Google Cloud API Gateway / Region Router") {
    Component(Envoy Ingress Mesh, "Envoy Ingress Mesh", "Envoy / Istio", "Manages edge routing, mTLS, traffic management, and resilience features across regions.")
    Component(Region Router, "Region Router", "Envoy / Istio Ingress Mesh", "Enforces strict regional data residency by directing EU and US traffic to appropriate backend clusters.")
}

Rel(Envoy Ingress Mesh, Region Router, "Forwards validated external traffic", "mTLS")

@enduml