@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(sfu_container, "LiveKit / WebRTC SFU Video Media Servers") {
    Component(livekit_sfu_core, "LiveKit SFU Core", "Go / LiveKit SFU", "Powers real-time video sessions with Simulcast support for degraded-mode operations and handles media and signaling streaming.")
    Component(sfu_webhook_handler, "SFU Webhook Handler", "Go / HTTPS", "Handles session lifecycle events and quality telemetry, communicating with core telehealth backends.")
    Component(adaptive_bitrate_engine, "Adaptive Bitrate Engine", "Go", "Ensures reliable consultations and low-bandwidth resilience for rural connectivity.")
    Component(sfu_telemetry_aggregator, "SFU Telemetry Aggregator", "Go", "Aggregates quality telemetry and metrics from video sessions.")
}

System_Ext(global_turn_stun_edge_relays, "Global TURN/STUN Edge Relays", "External TURN/STUN edge relays for media routing.")
System_Ext(core_telehealth_backends, "Go / Spring Boot Core Telehealth Backends", "Core telehealth backend services.")

Rel(livekit_sfu_core, global_turn_stun_edge_relays, "Media relay through edge nodes", "STUN/TURN")
Rel(sfu_webhook_handler, core_telehealth_backends, "Sends session lifecycle events and quality telemetry", "HTTPS POST, HMAC-SHA256, mTLS")
@enduml