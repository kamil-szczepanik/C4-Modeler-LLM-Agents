@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients_EU_US, "Patients (EU/US)", "Patients located in the EU and US accessing telehealth services, video consultations, e-prescriptions, and the AI symptom checker.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Licensed medical professionals providing video consultations and managing patient care.")

System_Ext(Vertex_AI, "Vertex AI", "Cloud-hosted AI model provider for the AI symptom checker.")
System_Ext(National_ePrescription_Gateways_and_Pharmacy_Networks, "National e-Prescription Gateways and Pharmacy Networks", "External systems for processing and transmitting e-prescriptions.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(Regional_API_Gateway___BFF, "Regional API Gateway / BFF", "Node.js, GraphQL", "Acts as the backend-for-frontend and entry point for client requests, routing traffic regionally.")
    Container(Consent___Policy_Engine, "Consent & Policy Engine", ".NET", "Enforces strict regional data residency, consent management, and regulatory compliance.")
    Container(Video_Session_Service, "Video Session Service", "Go", "Manages real-time video consultations for patients and clinicians.")
    Container(AI_Orchestration_Service, "AI Orchestration Service", "Python, FastAPI", "Orchestrates AI symptom checker requests and interfaces with Vertex AI.")
    Container(FHIR___Prescription_Integration_Service, "FHIR & Prescription Integration Service", ".NET", "Integrates with healthcare systems using FHIR standards and handles e-prescriptions.")
    ContainerDb(Regional_WORM_Storage, "Regional WORM Storage", "GCP Cloud Storage, Cloud KMS", "Provides Write-Once-Read-Many storage with regional key segregation for compliance and audit logging.")
}

Rel(Patients_EU_US, Regional_API_Gateway___BFF, "Accesses telehealth platform services via GraphQL", "HTTPS, GraphQL")
Rel(Licensed_Clinicians, Regional_API_Gateway___BFF, "Accesses telehealth platform services via GraphQL", "HTTPS, GraphQL")
Rel(Regional_API_Gateway___BFF, Consent___Policy_Engine, "Verifies user consent and policies", "gRPC, mTLS, Istio Service Mesh")
Rel(Regional_API_Gateway___BFF, Video_Session_Service, "Initiates and manages video sessions", "gRPC, mTLS, Istio Service Mesh")
Rel(Regional_API_Gateway___BFF, AI_Orchestration_Service, "Sends AI symptom checker requests", "gRPC, mTLS, Istio Service Mesh")
Rel(Regional_API_Gateway___BFF, FHIR___Prescription_Integration_Service, "Processes e-prescriptions and health records", "gRPC, mTLS, Istio Service Mesh")
Rel(AI_Orchestration_Service, Vertex_AI, "Sends requests for AI model inference", "HTTPS, gRPC, VPC Service Controls")
Rel(FHIR___Prescription_Integration_Service, National_ePrescription_Gateways_and_Pharmacy_Networks, "Transmits electronic prescriptions", "REST/FHIR, mTLS")
Rel(Consent___Policy_Engine, Regional_WORM_Storage, "Stores compliance and policy records securely", "TLS 1.3, Cloud KMS")
Rel(Video_Session_Service, Regional_WORM_Storage, "Stores session logs securely", "TLS 1.3, Cloud KMS")
Rel(AI_Orchestration_Service, Regional_WORM_Storage, "Stores audit logs securely", "TLS 1.3, Cloud KMS")
Rel(FHIR___Prescription_Integration_Service, Regional_WORM_Storage, "Stores prescription data securely", "TLS 1.3, Cloud KMS")

@enduml