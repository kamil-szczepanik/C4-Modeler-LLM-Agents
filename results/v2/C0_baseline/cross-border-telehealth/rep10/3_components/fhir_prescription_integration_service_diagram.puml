@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(fhiring_container, "FHIR & Prescription Integration Service") {
    Component(PrescriptionOrchestrator, "Prescription Orchestrator", ".NET Core", "Orchestrates the workflow for processing cross-border e-prescriptions.")
    Component(FHIRAdapter, "FHIR Adapter", ".NET Core", "Adapts and standardizes data formats to the FHIR standard.")
    Component(EUGatewayAdapter, "EU Gateway Adapter", ".NET Core", "Interfaces with National e-Prescription Gateways in the EU.")
    Component(ValidationMappingValidator, "Validation & Mapping Validator", ".NET Core", "Validates and maps payload data for regulatory compliance.")
    Component(MassTransitNotificationEventConsumer, "MassTransit & Notification Event Consumer", "MassTransit / .NET Core", "Consumes asynchronous events and ensures reliable message processing.")
}

Rel(PrescriptionOrchestrator, MassTransitNotificationEventConsumer, "Communicates via", "In-Process Bus")

@enduml