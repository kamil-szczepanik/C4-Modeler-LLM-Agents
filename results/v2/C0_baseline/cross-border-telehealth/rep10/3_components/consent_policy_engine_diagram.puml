@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Consent & Policy Engine container

Container_Boundary(consent_policy_engine, "Consent & Policy Engine") {
    Component(Consent_Policy_Engine, "Consent & Policy Engine", ".NET 8 / ASP.NET Core", "Enforces strict regional data residency, purpose-based consent, and evaluates local policy caches.")
}

System_Ext(Regional_WORM_Storage, "Regional WORM Storage", "Compliance and policy storage")
System_Ext(Regional_Memorystore_Redis, "Regional Memorystore (Redis)", "Local policy caches and Pub/Sub revocations")

Rel(Consent_Policy_Engine, Regional_WORM_Storage, "Stores compliance and policy records securely", "TLS 1.3, Cloud KMS")
Rel(Consent_Policy_Engine, Regional_Memorystore_Redis, "Evaluates local policy caches and handles real-time Pub/Sub revocations", "TCP, TLS")

@enduml