@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(regional_api_gateway_bff, "Regional API Gateway / BFF") {
    Component(Routing_Geo_Enforcement_Middleware, "Routing & Geo-Enforcement Middleware", "Node.js", "Enforces strict regional data residency and geo-compliance for incoming requests.")
    Component(GraphQL_Resolvers, "GraphQL Resolvers", "Node.js, GraphQL", "Handles flexible data fetching and client requests for low-bandwidth rural clients.")
    Component(Audit_Telemetry_Interceptor, "Audit & Telemetry Interceptor", "Node.js", "Captures audit logs and telemetry data, forwarding them to monitoring services.")
    Component(Client_Context_Policy_Injector, "Client Context & Policy Injector", "Node.js", "Injects necessary client context and policy constraints into downstream service calls.")
}

Rel(Routing_Geo_Enforcement_Middleware, GraphQL_Resolvers, "Routes validated requests to", "")
Rel(GraphQL_Resolvers, Audit_Telemetry_Interceptor, "Triggers telemetry tracking via", "")
Rel(Client_Context_Policy_Injector, GraphQL_Resolvers, "Applies context to", "")

@enduml