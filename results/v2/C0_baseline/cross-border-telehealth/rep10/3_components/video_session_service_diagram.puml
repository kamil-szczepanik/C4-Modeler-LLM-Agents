@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Video Session Service container

System_Ext(ThirdPartyVideoInfrastructure, "Third-Party Video Infrastructure", "External video infrastructure.")
System_Ext(RegionalWORMStorage, "Regional WORM Storage", "GCP Cloud Storage, Cloud KMS")

Container_Boundary(VideoSessionService, "Video Session Service") {
    Component(SessionCoordinatorComponent, "Session Coordinator Component", "Go", "Orchestrates media routing state.")
    Component(SFUMediaProxyComponent, "SFU Media Proxy Component", "Go, Pion WebRTC", "Relays encrypted streams and handles media proxying.")
    Component(QualityTelemetryLoggerComponent, "Quality Telemetry Logger Component", "Go", "Persists cryptographically signed audit logs.")
}

Rel(SessionCoordinatorComponent, SFUMediaProxyComponent, "Orchestrates media routing state", "gRPC")
Rel(SFUMediaProxyComponent, ThirdPartyVideoInfrastructure, "Relays encrypted streams", "WebRTC, SRTP, DTLS")
Rel(QualityTelemetryLoggerComponent, RegionalWORMStorage, "Persists cryptographically signed audit logs", "gRPC, TLS 1.3, Cloud KMS")

@enduml