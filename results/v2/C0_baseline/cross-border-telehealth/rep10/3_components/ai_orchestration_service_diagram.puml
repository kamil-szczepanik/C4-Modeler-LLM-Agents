@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(RegionalAPIGatewayBFF, "Regional API Gateway / BFF", "Istio Service Mesh / gRPC", "Forwards requests to the API Router.")
System_Ext(VertexAI, "Vertex AI", "GCP Vertex AI", "Managed machine learning backend for symptom inference.")

Container_Boundary(AIOrchestrationService, "AI Orchestration Service") {
    Component(APIRouterValidator, "API Router & Validator", "FastAPI and Pydantic", "Validating payloads and enforcing JWT consent scopes.")
    Component(PromptContextAssembler, "Prompt & Context Assembler", "Python", "Prepares localized prompts and strips PII/PHI.")
    Component(InferenceClient, "Inference Client", "gRPC/mTLS", "Interacts with GCP Vertex AI.")
    Component(AuditLogger, "Audit Logger", "Python / OpenTelemetry", "Captures immutable inputs, model versions, and outputs.")
    Component(ResilienceHandler, "Resilience Handler", "Python", "Implements circuit breaking and fallback urgency recommendations.")
    Component(RegionalWORMStorage, "Regional WORM Storage", "GCP Cloud Storage with Cloud KMS", "Secured via Cloud KMS and object retention policies.")
}

Rel(RegionalAPIGatewayBFF, APIRouterValidator, "Forwards requests", "gRPC, mTLS, and Istio Service Mesh")
Rel(InferenceClient, VertexAI, "Executes remote model calls", "gRPC/HTTPS within VPC Service Controls")
Rel(AuditLogger, RegionalWORMStorage, "Asynchronously flushes immutable logs", "HTTPS using Cloud KMS")

@enduml