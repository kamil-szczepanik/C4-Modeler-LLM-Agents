@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Consent_Policy_Engine, "Consent & Policy Engine", "External service")
Person(Video_Session_Service, "Video Session Service", "External service")
Person(AI_Orchestration_Service, "AI Orchestration Service", "External service")
Person(FHIR_Prescription_Integration_Service, "FHIR & Prescription Integration Service", "External service")
Person(Compliance_Auditors, "Compliance Auditors", "Compliance Auditors / Officers")
System_Ext(GCP_Cloud_Storage, "GCP Cloud Storage", "GCP Cloud Storage (europe-west3, us-central1) with Bucket Lock in compliance mode")

Container_Boundary(regional_worm_storage, "Regional WORM Storage") {
    Component(Retention_Policy_Manager, "Retention Policy Manager", "Go", "Applies immutable lock and storage tiering.")
    Component(Audit_Query_API, "Audit Query API", "Go, gRPC", "Queries immutable logs for compliance audits.")
    Component(Encryption_Key_Manager, "Encryption & Key Manager", "GCP Cloud KMS", "Manages regionally isolated customer-managed encryption keys for data residency.")
    Component(Audit_Export_Bundle_Generator, "Audit Export Bundle Generator", "Go", "Requests and generates regulatory packages.")
}

Rel(Consent_Policy_Engine, regional_worm_storage, "Stores compliance records securely", "TLS 1.3, Cloud KMS")
Rel(Video_Session_Service, regional_worm_storage, "Stores session logs securely", "TLS 1.3, Cloud KMS")
Rel(AI_Orchestration_Service, regional_worm_storage, "Stores audit logs securely", "TLS 1.3, Cloud KMS")
Rel(FHIR_Prescription_Integration_Service, regional_worm_storage, "Stores prescription data securely", "TLS 1.3, Cloud KMS")
Rel(Compliance_Auditors, Audit_Query_API, "Queries immutable logs", "gRPC over TLS 1.3, mTLS with ABAC")
Rel(Compliance_Auditors, Audit_Export_Bundle_Generator, "Requests regulatory packages", "gRPC over TLS 1.3")
Rel(Retention_Policy_Manager, GCP_Cloud_Storage, "Applies immutable lock and storage tiering", "Cloud Storage API")

@enduml