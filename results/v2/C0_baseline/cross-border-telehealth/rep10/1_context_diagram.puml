@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_EU_US, "Patients (EU / US)", "Patients located in the EU and US accessing telehealth services, video consultations, e-prescriptions, and the AI symptom checker.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Licensed medical professionals providing video consultations and managing patient care.")
Person(Local_Pharmacies, "Local Pharmacies", "Pharmacies receiving electronic prescriptions.")
Person(Compliance_Auditors_Officers, "Compliance Auditors / Officers", "Officers responsible for auditing platform logs and ensuring regulatory compliance.")

System_Ext(Third_Party_Video_Infrastructure, "Third-Party Video Infrastructure", "Third-party WebRTC SFU / Twilio / Agora infrastructure for video consultations.")
System_Ext(National_e_Prescription_Gateways_EU_and_US_Pharmacy_Networks, "National e-Prescription Gateways (EU) and US Pharmacy Networks", "External gateways and networks (NCPDP / HL7 FHIR) for processing e-prescriptions.")
System_Ext(Third_Party_AI_LLM_ML_Provider_Vertex_AI, "Third-Party AI LLM/ML Provider / Vertex AI", "AI provider used for the symptom checker functionality.")
System_Ext(Federated_Identity_Provider_and_Patient_Consent_Dashboard, "Federated Identity Provider and Patient Consent Dashboard", "Manages federated identity and patient consent token management.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "A cross-border telehealth platform providing video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and US, ensuring strict regional data residency, regulatory compliance, and high availability.")

Rel(Patients_EU_US, Cross_Border_Telehealth_Platform, "Accesses telehealth platform for video consultations, e-prescriptions, and AI symptom checker", "HTTPS, WSS, TLS 1.3")
Rel(Licensed_Clinicians, Cross_Border_Telehealth_Platform, "Conducts video consultations and manages patient care", "HTTPS, WSS, TLS 1.3")
Rel(Cross_Border_Telehealth_Platform, Third_Party_Video_Infrastructure, "Establishes video streams for consultations", "WebRTC, DTLS")
Rel(Cross_Border_Telehealth_Platform, National_e_Prescription_Gateways_EU_and_US_Pharmacy_Networks, "Sends and manages e-prescriptions", "REST/FHIR, mTLS")
Rel(Cross_Border_Telehealth_Platform, Third_Party_AI_LLM_ML_Provider_Vertex_AI, "Processes AI symptom checker requests", "gRPC, HTTPS")
Rel(Cross_Border_Telehealth_Platform, Federated_Identity_Provider_and_Patient_Consent_Dashboard, "Authenticates users and verifies consent tokens", "OAuth2/OIDC, FIDO2/WebAuthn MFA")

@enduml