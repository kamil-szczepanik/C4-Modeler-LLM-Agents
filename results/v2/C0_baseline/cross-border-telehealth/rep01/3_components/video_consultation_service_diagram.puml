@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Patients_Clinicians, "Patients/Clinicians", "Users accessing the video consultation platform.")
ContainerDb(Data_Audit_Tier, "Data & Audit Tier", "Cloud SQL, Cloud Spanner, WORM Cloud Storage, Redis", "Persists session metadata and audit logs.")

Container_Boundary(Video_Consultation_Service, "Video Consultation Service") {
    Component(Signaling___Session_Manager, "Signaling & Session Manager", "Node.js / Go & Redis", "Handles signaling state management, short-lived session token caching, and session initialization.")
    Component(Media_Relay___SFU_Controller, "Media Relay & SFU Controller", "WebRTC SFU (Janus/Mediasoup) & DTLS-SRTP", "Powers adaptive bitrate video streaming for low-bandwidth connections with encrypted media paths.")
    Component(Localization___UI_Gateway, "Localization & UI Gateway", "React/Next.js", "Provides localized waiting rooms and video UI access for patients and clinicians.")
    Component(Media_Quality___Audit_Logger, "Media Quality & Audit Logger", "Async / Cloud Pub/Sub", "Emits real-time stream quality metrics and audit logs.")
}

Rel(Signaling___Session_Manager, Media_Relay___SFU_Controller, "Allocates media paths", "Internal API")
Rel(Media_Relay___SFU_Controller, Media_Quality___Audit_Logger, "Emits real-time stream quality metrics", "Async / Cloud Pub/Sub")
Rel(Signaling___Session_Manager, Data_Audit_Tier, "Persists session metadata locally per region", "gRPC / SQL")
Rel(Patients_Clinicians, Localization___UI_Gateway, "Accesses localized waiting rooms and video UI", "HTTPS / WebSockets")

@enduml