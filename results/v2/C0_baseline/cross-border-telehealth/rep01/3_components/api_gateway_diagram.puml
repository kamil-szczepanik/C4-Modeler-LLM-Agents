@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Geo_Routing_Router, "Geo-Routing Router", "Envoy Proxy / Apigee", "Handles Anycast DNS based geo-routing and traffic direction for EU and US patients.")
    Component(TLS_Terminator, "TLS Terminator", "Envoy Proxy", "Terminates HTTPS and WSS connections using TLS 1.3 at the network edge.")
    Component(Consent_and_Policy_Validator, "Consent and Policy Validator", "Open Policy Agent (OPA)", "Evaluates dynamic patient consent policies and regulatory compliance (GDPR/HIPAA).")
    Component(Schema_Checker, "Schema Checker", "Envoy Proxy / Apigee", "Validates incoming request payloads and API schemas before forwarding.")
}

Rel(Geo_Routing_Router, TLS_Terminator, "Routes incoming connections to")
Rel(TLS_Terminator, Schema_Checker, "Passes decrypted traffic to")
Rel(Schema_Checker, Consent_and_Policy_Validator, "Queries policies for")
@enduml