@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Interoperability Adapter container

Container_Boundary(interoperability_adapter, "Interoperability Adapter") {
    Component(FHIR_Translation_Facade, "FHIR Translation Facade", "GKE microservice / Apache Camel", "Handles payload transformations and schema versioning for health data.")
    Component(EU_National_Gateway_Driver, "EU National Gateway Driver", "GKE microservice", "Communicates with EU National Systems via asynchronous Cloud Pub/Sub and synchronous HTTPS.")
    Component(Transformation_Pipeline_Engine, "Transformation Pipeline Engine", "Apache Camel", "Executes message routing, schema versioning, and payload transformations.")
    Component(Audit_Traceability_Logger, "Audit & Traceability Logger", "gRPC / WORM Cloud Storage", "Forwards encrypted audit logs via gRPC to Cloud Spanner and WORM Cloud Storage.")
    Component(Clinical_Error_Telemetry_Handler, "Clinical Error & Telemetry Handler", "Prometheus / GKE", "Monitors transformation latency, payload error rates, and business-level e-prescription SLAs.")
}

Rel(FHIR_Translation_Facade, Transformation_Pipeline_Engine, "Passes payload for schema versioning and transformation", "")
Rel(EU_National_Gateway_Driver, Transformation_Pipeline_Engine, "Routes national system payloads", "")
Rel(Transformation_Pipeline_Engine, Audit_Traceability_Logger, "Sends audit logs and traceability events", "")
Rel(Clinical_Error_Telemetry_Handler, Transformation_Pipeline_Engine, "Monitors latency and error rates", "")

@enduml