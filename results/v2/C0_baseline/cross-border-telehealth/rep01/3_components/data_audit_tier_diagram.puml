@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(ComplianceOfficer, "Compliance Officer", "Queries immutable access and AI traceability logs")
System_Ext(RegionalApplicationServices, "Regional Application Services", "Regional Application Services on GKE")
System_Ext(AISymptomChecker, "AI Symptom Checker", "AI Symptom Checker via Vertex AI endpoints")
System_Ext(PolicyConsentEngine, "Policy & Consent Engine", "Policy & Consent Engine via Open Policy Agent")

Container_Boundary(DataAndAuditTier, "Data & Audit Tier") {
    Component(CloudSQLforPostgreSQL, "Cloud SQL for PostgreSQL", "PostgreSQL / TLS 1.3", "Provides ACID compliance, row-level security for tenant data isolation, and stores access grants and transactional data.")
    Component(CloudStorageWORM, "Cloud Storage WORM", "Cloud Storage WORM", "Stores immutable audit logs and traceability data ensuring regulatory compliance.")
    Component(BigQuery, "BigQuery", "Google BigQuery", "Queries immutable access and AI traceability logs for compliance auditing.")
}

Rel(RegionalApplicationServices, CloudSQLforPostgreSQL, "Read/write transactions", "PostgreSQL Wire Protocol / TLS 1.3")
Rel(AISymptomChecker, CloudStorageWORM, "Stream immutable logs", "Cloud Pub/Sub")
Rel(AISymptomChecker, BigQuery, "Stream immutable logs", "Cloud Pub/Sub")
Rel(PolicyConsentEngine, CloudSQLforPostgreSQL, "Validates and logs access grants", "gRPC")
Rel(ComplianceOfficer, CloudStorageWORM, "Queries immutable access and AI traceability logs", "Cloud Identity-Aware Proxy (IAP) over HTTPS")
Rel(ComplianceOfficer, BigQuery, "Queries immutable access and AI traceability logs", "Cloud Identity-Aware Proxy (IAP) over HTTPS")

@enduml