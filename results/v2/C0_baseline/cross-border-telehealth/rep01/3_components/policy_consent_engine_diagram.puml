@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Policy & Consent Engine container

Container_Boundary(policy_consent_engine, "Policy & Consent Engine") {
    Component(Open Policy Agent (OPA), "Open Policy Agent (OPA)", "Open Policy Agent", "Performs local policy evaluation for regional GKE services via gRPC.")
    Component(Consent Sync Worker, "Consent Sync Worker", "GCP Pub/Sub Worker", "Handles asynchronous cross-region consent propagation.")
    Component(Consent Audit Transformer, "Consent Audit Transformer", "Audit Processing Service", "Queries regional logs for human-readable audit trails and sends them to BigQuery.")
}

System_Ext(GCP Pub/Sub, "GCP Pub/Sub", "Event streaming and messaging system for regional topics.")
System_Ext(BigQuery, "BigQuery", "Data warehouse for regional log queries and audit trails.")

Rel(Consent Sync Worker, GCP Pub/Sub, "Propagates cross-region consent asynchronously.", "GCP Pub/Sub")
Rel(Consent Audit Transformer, BigQuery, "Sends regional log queries for human-readable audit trails.", "HTTPS")
@enduml