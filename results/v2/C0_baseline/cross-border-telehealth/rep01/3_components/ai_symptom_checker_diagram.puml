@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Symptom Checker container

Container_Boundary(ai_symptom_checker, "AI Symptom Checker") {
    Component(SymptomIntakeAPIController, "Symptom Intake API Controller", "Python, FastAPI", "Handles symptom intake requests and interfaces with regional application services.")
    Component(InferenceOrchestrator, "Inference Orchestrator", "Python", "Orchestrates triage and executes AI model inference via Vertex AI Endpoints.")
    Component(ExplainabilitySanitizationEngine, "Explainability & Sanitization Engine", "Python", "Processes and sanitizes model outputs while providing explainability.")
    Component(AuditTraceabilityLogger, "Audit & Traceability Logger", "Go", "Streams and persists audit data for regulatory compliance and traceability.")
}

Rel(SymptomIntakeAPIController, InferenceOrchestrator, "Invokes triage", "In-memory / gRPC")
Rel(InferenceOrchestrator, ExplainabilitySanitizationEngine, "Processes outputs", "In-memory")
Rel(ExplainabilitySanitizationEngine, AuditTraceabilityLogger, "Streams logs", "Cloud Pub/Sub")

@enduml