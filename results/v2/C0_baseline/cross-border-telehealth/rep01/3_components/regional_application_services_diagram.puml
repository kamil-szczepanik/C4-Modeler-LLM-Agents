@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(regional_application_services, "Regional Application Services") {
    Component(Consultation_Orchestrator_Microservice, "Consultation Orchestrator Microservice", "Spring Boot", "Manages video sessions and adaptive bitrate streaming.")
    Component(Prescription_Manager_Microservice, "Prescription Manager Microservice", "Spring Boot", "Translates clinical orders to regional standards.")
    Component(Consent_Context_Enforcer_Microservice, "Consent & Context Enforcer Microservice", "Spring Boot with OPA sidecar", "Validates local authorization and consent policies.")
}

Rel(Consultation_Orchestrator_Microservice, Video_Consultation_Service, "Manages video sessions and adaptive bitrate streaming", "WebRTC / gRPC")
Rel(Prescription_Manager_Microservice, Interoperability_Adapter, "Translates clinical orders to regional standards", "gRPC")
Rel(Consent_Context_Enforcer_Microservice, Local_OPA_Sidecar, "Validates local authorization and consent policies", "Local OPA evaluation")

@enduml