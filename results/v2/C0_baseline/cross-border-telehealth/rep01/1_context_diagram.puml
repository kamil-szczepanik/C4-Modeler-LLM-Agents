@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_Clinicians, "Patients & Clinicians", "Users who access the platform via PWA and native mobile apps for video consultations, e-prescriptions, and AI symptom checking.")
System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "A cross-border telehealth platform providing video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and the US while enforcing GDPR/HIPAA compliance.")
System_Ext(External_Pharmacy_Networks, "External Pharmacy Networks", "National EU e-prescription gateways and US pharmacy systems interacting via HL7 FHIR and national standards.")
System_Ext(National_Health_Systems_Insurance_Providers, "National Health Systems & Insurance Providers", "External systems for claims and health registry reporting using REST APIs and mutual TLS.")
System_Ext(Identity_Providers, "Identity Providers", "Regional IAM services handling OIDC/OAuth2 authentication and multi-factor authentication.")

Rel(Patients_Clinicians, Cross_Border_Telehealth_Platform, "Accesses video consultations, e-prescriptions, and symptom checks with low-bandwidth adaptive streaming and offline synchronization", "HTTPS / WebRTC")
Rel(Cross_Border_Telehealth_Platform, External_Pharmacy_Networks, "Sends e-prescriptions and prescription data", "HL7 FHIR (US) and national standards (EU) via REST / TLS")
Rel(Cross_Border_Telehealth_Platform, National_Health_Systems_Insurance_Providers, "Reports claims and health registry data", "REST APIs and mutual TLS (mTLS)")
Rel(Cross_Border_Telehealth_Platform, Identity_Providers, "Authenticates users and inspects tokens", "OAuth2 / OIDC")
@enduml