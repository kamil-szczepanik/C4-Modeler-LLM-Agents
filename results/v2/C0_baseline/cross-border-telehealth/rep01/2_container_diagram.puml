@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Urban_Patients, "Urban Patients", "Patients in urban areas accessing high-bandwidth video consultations and platform features.")
Person(Rural_Patients, "Rural Patients", "Patients in rural areas requiring high availability and adaptive bitrate streaming for consultations.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Healthcare professionals conducting video consultations and issuing e-prescriptions.")
Person(Pharmacists, "Pharmacists", "Pharmacy staff receiving and processing e-prescriptions.")
Person(Compliance_Officers, "Compliance Officers", "Officers monitoring adherence to HIPAA and GDPR regulations.")

System_Ext(External_Pharmacy_Networks, "External Pharmacy Networks", "National EU e-prescription gateways and US pharmacy systems interacting via HL7 FHIR.")

System_Boundary(cross_border_telehealth_platform, "Cross-Border Telehealth Platform") {
    Container(API_Gateway, "API Gateway", "Cloud Endpoints / Apigee", "Handles TLS termination, JWT validation, and request routing.")
    Container(Regional_Application_Services, "Regional Application Services", "Google Kubernetes Engine (GKE)", "Regional container execution clusters in europe-west3 and us-central1.")
    Container(Video_Consultation_Service, "Video Consultation Service", "Twilio / WebRTC Media Server", "Provides adaptive bitrate streaming for video consultations.")
    Container(AI_Symptom_Checker, "AI Symptom Checker", "Vertex AI endpoints", "Isolated inference container for AI-based symptom checking.")
    Container(Policy_Consent_Engine, "Policy & Consent Engine", "Open Policy Agent (OPA)", "Deployed locally on regional GKE clusters for localized authorization.")
    Container(Interoperability_Adapter, "Interoperability Adapter", "GKE microservice", "Handles integration with external health systems and pharmacies.")
    ContainerDb(Data_Audit_Tier, "Data & Audit Tier", "Cloud SQL / Cloud Spanner / WORM Cloud Storage", "Region-isolated databases and WORM storage buckets for audit logs.")
}

Rel(Urban_Patients, API_Gateway, "Accesses video consultations, e-prescriptions, and AI symptom checking", "HTTPS and WSS via TLS 1.3")
Rel(Rural_Patients, API_Gateway, "Accesses video consultations and platform services with adaptive streaming", "HTTPS and WSS via TLS 1.3")
Rel(Licensed_Clinicians, API_Gateway, "Manages consultations and issues e-prescriptions", "HTTPS and WSS via TLS 1.3")
Rel(Pharmacists, API_Gateway, "Retrieves and processes e-prescriptions", "HTTPS and WSS via TLS 1.3")
Rel(Compliance_Officers, API_Gateway, "Reviews audit logs and policy compliance", "HTTPS and WSS via TLS 1.3")

Rel(API_Gateway, Regional_Application_Services, "Routes validated requests to regional GKE clusters", "gRPC over Istio mTLS")
Rel(Regional_Application_Services, Video_Consultation_Service, "Initiates and manages video sessions", "WebRTC / Adaptive Bitrate Streaming")
Rel(Regional_Application_Services, AI_Symptom_Checker, "Sends inference requests to isolated endpoints", "gRPC / REST")
Rel(Regional_Application_Services, Policy_Consent_Engine, "Validates local authorization policies", "Local OPA evaluation")
Rel(Regional_Application_Services, Data_Audit_Tier, "Persists patient and operational data with strict regional isolation", "Region-isolated SQL / Spanner connections")

Rel(Interoperability_Adapter, External_Pharmacy_Networks, "Exchanges e-prescription and health data", "OAuth 2.0 mTLS and SMART on FHIR")
Rel(AI_Symptom_Checker, Data_Audit_Tier, "Streams asynchronous event and audit logs", "Asynchronous event streams to WORM Storage and BigQuery")

@enduml