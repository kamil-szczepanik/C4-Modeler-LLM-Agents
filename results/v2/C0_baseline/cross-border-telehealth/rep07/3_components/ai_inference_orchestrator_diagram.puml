@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Inference Orchestrator container

System_Ext(ConsentManagementService, "Consent Management Service", "External system")
System_Ext(AISymptomCheckerEngine, "AI Symptom Checker Engine", "External system")
System_Ext(RegionalCloudSpanner, "Regional Cloud Spanner", "External database")
System_Ext(RegionalBigQuery, "Regional BigQuery", "External data warehouse")

Container_Boundary(AIInferenceOrchestrator, "AI Inference Orchestrator") {
    Component(APIHandlerComponent, "API Handler Component", "Python / FastAPI", "Handles incoming API requests and delegates to internal validation and processing components.")
    Component(ConsentValidatorComponent, "Consent Validator Component", "Python / FastAPI, gRPC", "Performs internal verification of incoming requests against patient consent policies.")
    Component(PayloadSanitizerEncryptionComponent, "Payload Sanitizer/Encryption Component", "Python / Pydantic", "Enforces strict payload validation and sanitization across internal components.")
    Component(InferenceRouterComponent, "Inference Router Component", "Python / FastAPI", "Routes symptom check logic requests to the AI Symptom Checker Engine securely.")
    Component(AuditLoggingComponent, "Audit Logging Component", "Python / Google Cloud Client Libraries", "Manages synchronous transactional audit writes and asynchronous analytical syncs.")
}

Rel(APIHandlerComponent, ConsentValidatorComponent, "Internal verification", "In-memory / gRPC")
Rel(APIHandlerComponent, ConsentManagementService, "Verifies patient consent", "gRPC over mTLS")
Rel(InferenceRouterComponent, AISymptomCheckerEngine, "Queries symptom check logic", "HTTPS / gRPC with mTLS and certificate pinning")
Rel(AuditLoggingComponent, RegionalCloudSpanner, "Synchronous transactional audit write", "Google Cloud Client Libraries")
Rel(AuditLoggingComponent, RegionalBigQuery, "Asynchronous batch sync for analytics", "Google Cloud Client Libraries")

@enduml