@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(GlobalExternalHTTPSSLoadBalancers, "Global External HTTP(S) Load Balancers") {
    Component(AnycastIPFrontend, "Anycast IP Frontend", "HTTP/2, gRPC, TLS 1.3", "Terminates TLS 1.3 globally and handles incoming requests from web and mobile applications.")
    Component(CloudArmorSecurityPolicyEngine, "Cloud Armor Security Policy Engine", "Google Cloud Armor", "Mitigates DDoS attacks and enforces WAF and geo-access rules.")
    Component(URLMapRedirectComponent, "URL Map & Redirect Component", "GCP Global External HTTP(S) Load Balancer Routing", "Executes geo-routing policies and directs traffic to appropriate regional destinations or edge services.")
    Component(RegionSelectionEdgeService, "Region-Selection Edge Service", "Cloud Storage, Cloud CDN", "Routes ambiguous or unrouted requests to static edge assets and provides graceful edge fallbacks.")
}

Rel(AnycastIPFrontend, CloudArmorSecurityPolicyEngine, "Inspects incoming requests for security policies", "HTTPS / gRPC")
Rel(CloudArmorSecurityPolicyEngine, URLMapRedirectComponent, "Passes validated traffic for routing decisions", "")
Rel(URLMapRedirectComponent, RegionSelectionEdgeService, "Routes ambiguous or unrouted requests to static edge assets", "HTTPS")

@enduml