@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Media Relay / SFU Container container

Container_Boundary("Media Relay / SFU Container", "Media Relay / SFU Container") {
    Component("Signaling_and_Room_Manager", "Signaling and Room Manager", "LiveKit / Go", "Handles WebRTC signaling, client connections, and room state management for video consultations.")
    Component("Media_Forwarding_Engine", "Media Forwarding Engine", "LiveKit / SFU", "Selective Forwarding Unit (SFU) that routes video and audio streams between participants with adaptive bitrate streaming.")
    Component("Encryption_and_Security_Handler", "Encryption and Security Handler", "DTLS 1.3 / SRTP", "Enforces end-to-end encryption for all real-time media streams.")
}

Rel("Signaling_and_Room_Manager", "Media_Forwarding_Engine", "Coordinates track publication and subscription", "")
Rel("Media_Forwarding_Engine", "Encryption_and_Security_Handler", "Encrypts and decrypts real-time media packets", "")

@enduml