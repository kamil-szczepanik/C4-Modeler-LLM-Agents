@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Native Mobile Apps container

Container_Boundary(native_mobile_apps, "Native Mobile Apps") {
    Component(Presentation_Layer, "Presentation Layer", "Dart / Flutter UI", "Multi-platform user interface for video consultations, e-prescriptions, and AI symptom checker.")
    Component(Local_Secure_Storage_Component, "Local Secure Storage Component", "SQLCipher / Flutter Secure Storage", "Hardware-backed encryption for secure offline PHI/PII caching.")
    Component(API_Sync_Client, "API & Sync Client", "Dio / gRPC Dart", "Syncs payloads and requests with regional gateways.")
    Component(WebRTC_Media_Module, "WebRTC Media Module", "Flutter WebRTC plugin", "Handles real-time video consultations with adaptive bandwidth degradation.")
}

System_Ext(Regional_API_Gateways, "Regional API Gateways", "Regional gateways for API requests and compliance.")
System_Ext(Regional_TURN_STUN_Relays, "Regional TURN/STUN Relays", "Relays for establishing video streams.")

Rel(Presentation_Layer, Local_Secure_Storage_Component, "Reads/writes encrypted cache", "SQLCipher API")
Rel(API_Sync_Client, Regional_API_Gateways, "Syncs payloads and requests", "gRPC / HTTPS with TLS 1.3")
Rel(WebRTC_Media_Module, Regional_TURN_STUN_Relays, "Establishes video streams", "ICE / STUN / TURN over UDP/TCP")

@enduml