@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Applications container

System_Ext(Global External HTTP(S) Load Balancer, "Global External HTTP(S) Load Balancer", "Global External HTTP(S) Load Balancer with GCP Cloud CDN")
System_Ext(Regional API Gateways, "Regional API Gateways", "Kong / GCP API Gateway")
System_Ext(Media Relay / SFU Container, "Media Relay / SFU Container", "LiveKit / Mediasoup")

Container_Boundary(Web Applications, "Web Applications") {
    Component(Flutter Web / HTML5 / CSS UI, "Flutter Web / HTML5 / CSS UI", "Flutter Web / HTML5 / CSS", "Cross-platform web UI supporting responsive layouts and WCAG 2.1 AA accessibility.")
    Component(Local State Encryption Manager, "Local State Encryption Manager", "Web Crypto API (AES-GCM)", "Encrypts local state and consent tokens in IndexedDB for shared rural devices.")
    Component(WebRTC Video Client, "WebRTC Video Client", "WebRTC APIs", "Enables low-latency video consultations down to <300 kbit/s with adaptive bitrate streaming.")
}

Rel(Flutter Web / HTML5 / CSS UI, Global External HTTP(S) Load Balancer, "HTTPS (TLS 1.3) with strict CSP and SRI headers", "HTTPS")
Rel(Flutter Web / HTML5 / CSS UI, Regional API Gateways, "REST/GraphQL over HTTPS (TLS 1.3)", "HTTPS")
Rel(WebRTC Video Client, Media Relay / SFU Container, "WebRTC (UDP/TCP with DTLS/SRTP)", "WebRTC")

@enduml