@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(prescription_interoperability_service, "Prescription & Interoperability Service") {
    Component(Prescription_API_Controller, "Prescription API Controller", "Java/Spring Boot", "Forwards prescription requests, validates tokens, and processes incoming calls.")
    Component(FHIR_National_Mapping_Engine, "FHIR & National Mapping Engine", "Java with HAPI FHIR", "Validates payloads and standardizes US and international healthcare interoperability data structures.")
    Component(Pharmacy_Integration_Client, "Pharmacy Integration Client", "Java Spring WebClient", "Transmits e-prescriptions to local pharmacies and manages integration payloads.")
    Component(Prescription_Outbox_Retry_Processor, "Prescription Outbox & Retry Processor", "Java/Spring Boot, Resilience4j, Spring Cloud Stream", "Implements circuit breakers, retry logic, and forwards failed delivery events.")
}

Rel(Prescription_API_Controller, FHIR_National_Mapping_Engine, "Validates payload and passes data", "In-memory")
Rel(FHIR_National_Mapping_Engine, Pharmacy_Integration_Client, "Passes serialized payloads", "In-memory")
Rel(Pharmacy_Integration_Client, Prescription_Outbox_Retry_Processor, "Forwards failed delivery events", "In-memory / Event")

@enduml