@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(consultation_service, "Consultation Service") {
    Component(Signaling_Controller, "Signaling Controller", "Go on GKE", "Forwards API requests, validates tokens, and relays SDP offers/answers and ICE candidates.")
    Component(Session_Quality_Monitor, "Session Quality Monitor", "Go on GKE", "Monitors session quality and persists connection telemetry and audit logs.")
    Component(Consultation_Workflow_Manager, "Consultation Workflow Manager", "Go on GKE", "Manages consultation workflows and validates patient data-sharing consent prior to session initialization.")
}

System_Ext(Media_Relay_SFU_Container, "Media Relay / SFU Container", "LiveKit / Mediasoup")
System_Ext(Consent_Management_Service, "Consent Management Service", "Go / Node.js")
System_Ext(Regional_Cloud_Spanner, "Regional Cloud Spanner", "GCP")

Rel(Signaling_Controller, Media_Relay_SFU_Container, "Relays SDP offers/answers and ICE candidates", "gRPC")
Rel(Consultation_Workflow_Manager, Consent_Management_Service, "Validates patient data-sharing consent prior to session initialization", "gRPC over mTLS")
Rel(Session_Quality_Monitor, Regional_Cloud_Spanner, "Persists connection telemetry and audit logs", "Go Cloud Spanner Client")

@enduml