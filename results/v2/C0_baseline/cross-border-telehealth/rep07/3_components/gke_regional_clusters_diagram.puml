@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the GKE Regional Clusters container

Container_Boundary(gke_regional_clusters, "GKE Regional Clusters") {
    Component(Kubernetes_Control_Plane, "Kubernetes Control Plane", "Regional Managed Kubernetes", "Manages cluster state and scheduling for regional workloads.")
    Component(Istio_Service_Mesh, "Istio Service Mesh", "Istio with SPIFFE/SPIRE", "Enforces zero-trust service-to-service communication and mTLS identity verification.")
    Component(Cilium_CNI, "Cilium CNI", "Cilium Datapath V2 with eBPF", "Provides high-performance pod networking and kernel-level network security enforcement.")
    Component(Cluster_Ingress_Controller, "Cluster Ingress Controller", "Nginx / GCP Gateway API", "Handles incoming HTTP/HTTPS traffic from Regional API Gateways.")
    Component(Node_Pools, "Node Pools", "Standard VMs and Spot VMs", "Runs clinical workloads on standard VMs and non-clinical workloads on reserved Spot VMs.")
    Component(ArgoCD, "ArgoCD", "Multi-Region GitOps", "Manages isolated regional continuous delivery and deployments.")
    Component(Admission_Control, "Admission Control", "OPA/Gatekeeper or Kyverno", "Validates and enforces security policies during resource deployment.")
    Component(Falco, "Falco", "Runtime Threat Detection", "Provides kernel-level runtime threat detection across regional workloads.")
}

Rel(Cluster_Ingress_Controller, Kubernetes_Control_Plane, "Receives ingress traffic and coordinates with", "HTTP/HTTPS")
Rel(Istio_Service_Mesh, Kubernetes_Control_Plane, "Secures microservice traffic managed by", "gRPC / HTTP/2 over mTLS")
Rel(Cilium_CNI, Kubernetes_Control_Plane, "Enforces pod networking and policies for", "eBPF")
Rel(ArgoCD, Kubernetes_Control_Plane, "Deploys and synchronizes applications to", "GitOps")
Rel(Admission_Control, Kubernetes_Control_Plane, "Inspects and filters requests to", "API")
Rel(Falco, Node_Pools, "Monitors runtime security on", "Kernel-level")

@enduml