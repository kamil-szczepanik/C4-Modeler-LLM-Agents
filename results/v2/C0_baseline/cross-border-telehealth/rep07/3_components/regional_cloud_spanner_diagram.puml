@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Regional Cloud Spanner container

System_Ext(Consultation_Service, "Consultation Service", "External service interacting with the container")
System_Ext(Consent_Management_Service, "Consent Management Service", "External service interacting with the container")
System_Ext(Prescription_Interoperability_Service, "Prescription & Interoperability Service", "External service interacting with the container")
System_Ext(Microservices_PubSub, "Microservices / Pub/Sub", "Downstream integration for asynchronous change streams")

Container_Boundary(regional_cloud_spanner, "Regional Cloud Spanner") {
    Component(Transactional_Data_Store, "Transactional Data Store", "Spanner SQL tables with row-level security", "Stores transactional telehealth data with row-level security and strict regional isolation.")
    Component(Audit_Log_Table, "Audit Log Table", "Append-only table", "Persists immutable consent tokens and audit logs for compliance tracking.")
    Component(Spanner_Data_Access_Layer, "Spanner Data Access Layer", "Google Cloud Spanner Native Go/Java Client Libraries", "Provides low-latency transactional read/writes via gRPC over TLS 1.3.")
    Component(Change_Streams_Processor, "Change Streams Processor", "Spanner Change Streams with Pub/Sub", "Captures and streams real-time, row-level data changes asynchronously for downstream integration.")
}

Rel(Consultation_Service, Spanner_Data_Access_Layer, "Reads and writes transactional data", "gRPC over TLS 1.3")
Rel(Consent_Management_Service, Spanner_Data_Access_Layer, "Persists consent tokens and immutable audit logs", "gRPC over TLS 1.3")
Rel(Prescription_Interoperability_Service, Spanner_Data_Access_Layer, "Stores and reads prescription records", "gRPC over TLS 1.3")
Rel(Spanner_Data_Access_Layer, Transactional_Data_Store, "Executes queries and transactions")
Rel(Spanner_Data_Access_Layer, Audit_Log_Table, "Appends audit logs and consent records")
Rel(Transactional_Data_Store, Change_Streams_Processor, "Captures row-level data changes asynchronously")
Rel(Change_Streams_Processor, Microservices_PubSub, "Streams asynchronous data changes", "gRPC and HTTPS")

@enduml