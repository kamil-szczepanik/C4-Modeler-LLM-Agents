@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(consent_management_service, "Consent Management Service") {
    Component(ConsentAPIController, "Consent API Controller", "Go / Node.js", "Receives forwarded consent requests from the Regional API Gateways via gRPC over mTLS.")
    Component(ConsentPolicyEngine, "Consent Policy Engine", "Go / Node.js", "Evaluates consent rules and triggers policy decisions.")
    Component(ConsentAuditLogger, "Consent Audit Logger", "Go / Node.js", "Emits compliance audit trails asynchronously.")
    Component(ConsentEventDispatcher, "Consent Event Dispatcher", "Go / Node.js", "Triggers revocation events internally.")
    Component(TemplateResolutionSubcomponent, "Template Resolution Sub-component", "Go / Node.js", "Resolves templates required for consent management processes.")
    Component(RegionalCloudSpanner, "Regional Cloud Spanner", "GCP Cloud Spanner", "Persists consent tokens enforcing strict regional data residency.")
    Component(RegionalPubSub, "Regional Pub/Sub", "Regional Pub/Sub", "Publishes token invalidation events for event-driven revocation.")
}

Rel(ConsentAPIController, ConsentPolicyEngine, "Evaluates consent rules", "In-process function call")
Rel(ConsentPolicyEngine, ConsentAuditLogger, "Emits compliance audit trails", "Async channel / gRPC")
Rel(ConsentPolicyEngine, RegionalCloudSpanner, "Persists consent tokens", "Cloud Spanner Go Client / gRPC over mTLS")
Rel(ConsentPolicyEngine, ConsentEventDispatcher, "Triggers revocation events", "In-process")
Rel(ConsentEventDispatcher, RegionalPubSub, "Publishes token invalidation events", "Pub/Sub API")
@enduml