@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Regional BigQuery container

Person(Compliance_Officers, "Compliance Officers", "Queries regional datasets for compliance reporting")
System_Ext(AI_Inference_Orchestrator, "AI Inference Orchestrator", "External system orchestrating AI inference")
System_Ext(Clinical_Analytics_BI_Tool, "Clinical Analytics & BI Tool", "External clinical analytics and BI tool")

Container_Boundary(Regional_BigQuery, "Regional BigQuery") {
    Component(EU_Audit_Dataset, "EU Audit Dataset", "GCP BigQuery Dataset (europe-west3)", "Stores EU regional health data audit logs enforcing strict data residency.")
    Component(US_Audit_Dataset, "US Audit Dataset", "GCP BigQuery Dataset (us-central1)", "Stores US regional health data audit logs enforcing strict data residency.")
    Component(Regional_Storage___Analytics_Engine, "Regional Storage & Analytics Engine", "GCP BigQuery", "Provides native single-region datasets to strictly enforce data residency requirements.")
    Component(Audit_Dataset_Management___Schema_Enforcement_Component, "Audit Dataset Management & Schema Enforcement Component", "Terraform", "Manages partitioned table schemas with autodetect = false to prevent schema corruption from AI log updates.")
    Component(Access___Masking_Policy_Enforcer_Component, "Access & Masking Policy Enforcer Component", "BigQuery Row-Level Security and Dynamic Data Masking", "Restricts data visibility and masks PHI/PII for authorized compliance officers.")
}

Rel(AI_Inference_Orchestrator, Regional_Storage___Analytics_Engine, "Streams audit logs and inputs", "BigQuery Write API / gRPC over VPC")
Rel(Clinical_Analytics_BI_Tool, Access___Masking_Policy_Enforcer_Component, "Queries anonymized/masked views", "BigQuery SQL / JDBC")
Rel(Compliance_Officers, Access___Masking_Policy_Enforcer_Component, "Queries regional datasets for compliance reporting", "BigQuery SQL / JDBC over GCP IAM")

@enduml