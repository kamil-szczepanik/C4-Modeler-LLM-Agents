@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Client_Apps, "Client Apps", "External client applications accessing the telehealth platform.")
System_Ext(Consultation_Service, "Consultation Service", "External service for consultation management.")

Container_Boundary(regional_turn_stun_relays, "Regional TURN/STUN Relays") {
    Component(STUN_TURN_Allocation_Engine, "STUN/TURN Allocation Engine", "Coturn / GCP Managed Service", "Handles media packet forwarding and UDP/TCP port allocation, relaying encrypted media streams via DTLS-SRTP.")
    Component(Bandwidth_Adaptation___Congestion_Controller, "Bandwidth Adaptation & Congestion Controller", "WebRTC GCC / Simulcast/SVC Controller", "Manages dynamic bandwidth adaptation below 300 kbit/s to throttle and prioritize audio streams.")
    Component(Session_Auth___Quota_Validator, "Session Auth & Quota Validator", "Go with SPIFFE/SPIRE mTLS", "Authenticates relay sessions and validates tokens and session quotas.")
    Component(Regional_GCP_Compute_Engine_MIGs, "Regional GCP Compute Engine MIGs", "GCP Managed Instance Groups", "Ensures scalable and resilient regional deployments across GCP regional VPC networks.")
}

Rel(Client_Apps, Session_Auth___Quota_Validator, "Authenticate relay sessions", "HTTPS/REST")
Rel(Client_Apps, STUN_TURN_Allocation_Engine, "Relay encrypted media streams", "DTLS-SRTP over UDP/TCP")
Rel(Bandwidth_Adaptation___Congestion_Controller, STUN_TURN_Allocation_Engine, "Throttle and prioritize audio streams", "Internal IPC")
Rel(Session_Auth___Quota_Validator, Consultation_Service, "Validate tokens and session quotas", "gRPC via mTLS")

@enduml