@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_EU_US, "Patients (EU / US)", "Patients located in the EU and the US seeking video consultations, AI symptom checks, and e-prescriptions.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Medical professionals providing video consultations and issuing e-prescriptions to patients.")
Person(Platform_Administrator_Compliance_Officer, "Platform Administrator / Compliance Officer", "Personnel responsible for managing the platform, auditing, and ensuring regulatory compliance.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and the US while enforcing strict regional data residency.")

System_Ext(Local_Pharmacies_EU_US, "Local Pharmacies (EU / US)", "Regional pharmacy networks receiving and fulfilling e-prescriptions.")
System_Ext(AI_Symptom_Checker_Engine, "AI Symptom Checker Engine", "Engine providing real-time urgency assessment for patient symptoms.")
System_Ext(Notification_Gateway, "Notification Gateway", "Gateway handling asynchronous alerts for low-bandwidth patients.")
System_Ext(EU_Pharmacy_Networks_US_Pharmacy_Networks, "EU Pharmacy Networks & US Pharmacy Networks", "Standardized pharmacy networks using HL7 FHIR and NCPDP for prescription integration.")
System_Ext(Identity_Providers, "Identity Providers", "Authentication systems including EU eIDAS and US OAuth Providers.")

Rel(Patients_EU_US, Cross_Border_Telehealth_Platform, "Accesses video consultations, AI checks, and manages consent", "HTTPS / WebRTC")
Rel(Licensed_Clinicians, Cross_Border_Telehealth_Platform, "Conducts video consultations and manages patient care", "HTTPS / WebRTC")
Rel(Platform_Administrator_Compliance_Officer, Cross_Border_Telehealth_Platform, "Monitors and manages platform administration and compliance", "HTTPS")
Rel(Cross_Border_Telehealth_Platform, Local_Pharmacies_EU_US, "Dispatches e-prescriptions", "Secure REST / HL7 FHIR over mTLS")
Rel(Cross_Border_Telehealth_Platform, AI_Symptom_Checker_Engine, "Performs real-time urgency assessment", "HTTPS / gRPC")
Rel(Cross_Border_Telehealth_Platform, Notification_Gateway, "Sends asynchronous low-bandwidth patient alerts", "Asynchronous Pub/Sub")
Rel(Cross_Border_Telehealth_Platform, EU_Pharmacy_Networks_US_Pharmacy_Networks, "Integrates e-prescription data", "HL7 FHIR / NCPDP")
Rel(Cross_Border_Telehealth_Platform, Identity_Providers, "Authenticates users via eIDAS and OAuth", "OAuth / eIDAS Protocols")

@enduml