@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "EU and US patients using video consultations.")
Person(Licensed Clinicians, "Licensed Clinicians", "Clinicians conducting consultations.")
Container(Core Services Container, "Core Services Container", "gRPC with mTLS", "Backend core services container.")
System(Google Cloud Pub/Sub, "Google Cloud Pub/Sub", "Asynchronous telemetry and event publishing.")

Container_Boundary(sfu_video_container, "SFU Video Container") {
    Component(WebRTC Media Router, "WebRTC Media Router", "LiveKit Server / Go", "Manages secure, real-time WebRTC video consultations with adaptive streaming.")
    Component(Adaptive Bitrate Controller, "Adaptive Bitrate Controller", "LiveKit Egress/Ingress SDK / Go", "Handles adaptive streaming and publishes degradation metrics.")
    Component(Session Signaling Handler, "Session Signaling Handler", "WebSockets / gRPC", "Handles session signaling for real-time video consultations.")
    Component(TURN/STUN Relay Service, "TURN/STUN Relay Service", "Coturn", "Provides regional NAT and firewall traversal.")
}

Rel(Patients, WebRTC Media Router, "Connects via WebRTC (UDP/TCP) using SRTP", "WebRTC / SRTP")
Rel(Licensed Clinicians, WebRTC Media Router, "Connects via WebRTC (UDP/TCP) using SRTP", "WebRTC / SRTP")
Rel(Session Signaling Handler, Core Services Container, "Communicates via gRPC with mTLS", "gRPC with mTLS")
Rel(Adaptive Bitrate Controller, Google Cloud Pub/Sub, "Publishes degradation metrics over TLS", "Google Cloud Pub/Sub over TLS")
@enduml