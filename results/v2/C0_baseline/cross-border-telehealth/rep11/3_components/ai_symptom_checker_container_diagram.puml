@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Symptom Checker Container container

Container_Boundary("ai_symptom_checker_container", "AI Symptom Checker Container") {
    Component("Input Sanitization & Validation Engine", "Input Sanitization & Validation Engine", "Pydantic / FastAPI", "Validates raw payloads, performs input sanitization, and provides adversarial input defense.")
    Component("Inference Engine", "Inference Engine", "PyTorch", "Executes the local symptom-checking model and passes sanitized features into raw recommendations.")
    Component("Disclaimer & Localization Formatter", "Disclaimer & Localization Formatter", "Python / FastAPI", "Applies disclaimers and localization formatting to raw recommendations.")
    Component("Audit & Telemetry Logger", "Audit & Telemetry Logger", "MLflow Tracking Client", "Triggers telemetry records and persists immutable logs via SQL/REST with CMEK.")
}

Rel("Input Sanitization & Validation Engine", "Inference Engine", "Passes sanitized features", "In-process")
Rel("Inference Engine", "Disclaimer & Localization Formatter", "Passes raw recommendation", "In-process")
Rel("Disclaimer & Localization Formatter", "Audit & Telemetry Logger", "Triggers telemetry record", "Async Queue")

@enduml