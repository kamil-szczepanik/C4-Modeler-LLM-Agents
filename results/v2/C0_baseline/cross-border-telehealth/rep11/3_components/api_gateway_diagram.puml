@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(EUAPI, "EU API Gateway", "Envoy / GCP Cloud Endpoints (europe-west3)", "Enforces regional data residency, TLS 1.3 termination, rate limiting, and circuit breaking for EU traffic.")
    Component(USAPI, "US API Gateway", "Envoy / GCP Cloud Endpoints (us-central1)", "Enforces regional data residency, TLS 1.3 termination, rate limiting, and circuit breaking for US traffic.")
}

System_Ext(RegionalMemorystore, "Regional Memorystore", "Redis cache")
System_Ext(CoreServicesContainer, "Core Services Container", "Core business services")
System_Ext(AISymptomCheckerContainer, "AI Symptom Checker Container", "AI symptom checker service")
System_Ext(IAMConsentService, "IAM & Consent Service", "IAM & Consent Service")

Rel(EUAPI, RegionalMemorystore, "Checks request deduplication", "Redis Protocol with connection pooling")
Rel(USAPI, RegionalMemorystore, "Checks request deduplication", "Redis Protocol with connection pooling")

Rel(EUAPI, CoreServicesContainer, "Routes valid requests", "gRPC with mTLS via Istio")
Rel(USAPI, CoreServicesContainer, "Routes valid requests", "gRPC with mTLS via Istio")

Rel(EUAPI, AISymptomCheckerContainer, "Routes valid requests", "gRPC with mTLS via Istio")
Rel(USAPI, AISymptomCheckerContainer, "Routes valid requests", "gRPC with mTLS via Istio")

Rel(EUAPI, IAMConsentService, "Validates OAuth2/OIDC tokens embedding consent scopes", "HTTPS")
Rel(USAPI, IAMConsentService, "Validates OAuth2/OIDC tokens embedding consent scopes", "HTTPS")

@enduml