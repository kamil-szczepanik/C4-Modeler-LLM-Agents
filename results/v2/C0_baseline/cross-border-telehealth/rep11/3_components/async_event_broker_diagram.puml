@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Async Event Broker", "Async Event Broker") {
    Component("Ingest Router", "Ingest Router", "Google Cloud Pub/Sub", "Ingests domain events published by core services via gRPC with mTLS.")
    Component("Regional Topic Manager", "Regional Topic Manager", "Google Cloud Pub/Sub", "Routes validated payloads across regional topics and dispatches downstream tasks.")
    Component("DLQ Manager", "DLQ Manager", "Google Cloud Pub/Sub Subscription Rules", "Offloads poison-pill messages to ensure system reliability and resilience.")
}

Rel("Ingest Router", "Regional Topic Manager", "Routes validated payloads", "Internal GCP Pub/Sub API")
Rel("Regional Topic Manager", "DLQ Manager", "Offloads poison-pill messages", "Pub/Sub subscription rules")

@enduml