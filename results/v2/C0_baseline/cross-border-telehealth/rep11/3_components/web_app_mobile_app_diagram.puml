@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("web_and_mobile_app", "Web App & Mobile App") {
    Component("Consent_Routing_Controller_Component", "Consent & Routing Controller Component", "React / Flutter Router & State Management", "Manages user consent and regional routing for EU and US compliance.")
    Component("Resilient_Video_Client_Component", "Resilient Video Client Component", "WebRTC", "Handles real-time video consultations and adaptive bitrate streaming.")
    Component("Offline_First_Symptom_Module_Component", "Offline-First Symptom Module Component", "SQLCipher / IndexedDB", "Provides client-side encrypted local caching for offline-first symptom checking.")
    Component("API_SFU_Client_Component", "API & SFU Client Component", "HTTPS/TLS 1.3 & WebRTC", "Communicates with the API Gateway and SFU Video Container.")
    Component("Localization_a11y_Provider_Component", "Localization & a11y Provider Component", "React Context / Flutter Localization", "Ensures accessibility and multi-language support for international users.")
}

System_Ext(SFU_Video_Container, "SFU Video Container", "SFU Video Container")
System_Ext(API_Gateway, "API Gateway", "API Gateway")

Rel(Resilient_Video_Client_Component, SFU_Video_Container, "WebRTC signaling and media streaming with adaptive bitrate", "WebRTC")
Rel(Consent_Routing_Controller_Component, API_Gateway, "HTTPS/TLS 1.3 with regional routing headers, app version hashes, and encrypted payloads", "HTTPS/TLS 1.3")

@enduml