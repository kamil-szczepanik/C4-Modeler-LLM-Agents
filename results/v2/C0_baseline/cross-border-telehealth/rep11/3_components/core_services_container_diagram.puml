@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(core_services_container, "Core Services Container") {
    Component(Patient Management & Consent Component, "Patient Management & Consent Component", "Spring Boot / Java", "Handles patient profiles, onboarding, and strict consent tracking for GDPR and HIPAA compliance.")
    Component(E-Prescription Routing Component, "E-Prescription Routing Component", "Spring Boot / Java", "Routes electronic prescriptions securely to regional fulfillment partners.")
    Component(Clinical Documentation Component, "Clinical Documentation Component", "Spring Boot / Java", "Manages immutable clinical notes and consultation records.")
    Component(Interoperability & Translation Component, "Interoperability & Translation Component", "Spring Boot / Java", "Translates data formats and securely communicates with external pharmacies.")
    Component(Data Storage, "Data Storage", "Cloud SQL PostgreSQL with CMEK", "Stores encrypted relational data with region-locked constraints.")
    Component(Async Event Broker, "Async Event Broker", "Google Cloud Pub/Sub with DLQ", "Manages reliable asynchronous messaging and dead-letter queues.")
}

System_Ext(External Pharmacies, "External Pharmacies", "HTTPS REST/SOAP with mTLS", "External systems receiving transmitted prescriptions.")

Rel(Patient Management & Consent Component, Data Storage, "Reads and writes encrypted relational data using CMEK")
Rel(E-Prescription Routing Component, Async Event Broker, "Publishes asynchronous prescription events via AMQP/Pub/Sub")
Rel(Interoperability & Translation Component, External Pharmacies, "Transmits prescriptions via outbound HTTPS REST/SOAP with mTLS and circuit breaking")
@enduml