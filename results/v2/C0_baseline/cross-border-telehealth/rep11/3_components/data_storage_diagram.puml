@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(data_storage, "Data Storage") {
    Component(Relational Database Instance, "Relational Database Instance", "Cloud SQL PostgreSQL", "Persists structured healthcare data and enforces patient consent via row-level security.")
    Component(Object Storage Bucket, "Object Storage Bucket", "Google Cloud Storage", "Persists unstructured audit logs, model artifacts, and telemetry.")
    Component(Key Management Service, "Key Management Service", "Cloud KMS / CMEK", "Manages localized Customer-Managed Encryption Keys for cryptographic data isolation.")
    Component(Data Access Proxy, "Data Access Proxy", "Envoy / PostgREST", "Evaluates patient consent and executes queries via PostgreSQL row-level security.")
    Component(Change Data Capture, "Change Data Capture", "Google Cloud Datastream", "Publishes transactional deltas for offline delta-sync payloads.")
}

System_Ext(Google Cloud Pub/Sub, "Google Cloud Pub/Sub", "External message broker for transactional deltas.")

Rel(Data Access Proxy, Relational Database Instance, "Evaluates patient consent and executes queries", "PostgreSQL RLS")
Rel(Change Data Capture, Google Cloud Pub/Sub, "Publishes transactional deltas", "Pub/Sub")

@enduml