@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients_EU_and_US, "Patients (EU and US)", "Patients seeking secure video consultations, e-prescriptions, and AI symptom checks.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Medical professionals providing consultations and prescriptions across borders.")
Person(Platform_Administrators_Compliance_Officers, "Platform Administrators / Compliance Officers", "Personnel overseeing platform security, compliance, and auditing.")

System_Ext(External_Pharmacies, "External Pharmacies", "EU national e-prescription networks and US pharmacy systems.")
System_Ext(Regional_Payment_Gateways, "Regional Payment Gateways", "Stripe and regional processors handling transactions.")
System_Ext(Health_Authorities_Auditors, "Health Authorities & Auditors", "FDA, EMA, and national ministries auditing the platform.")
System_Ext(Identity_Providers, "Identity Providers", "eIDAS for EU and OAuth2/OIDC for US federated authentication and access control.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(Web_App_Mobile_App, "Web App & Mobile App", "React / Flutter", "Cross-platform client applications providing user interfaces for patients and clinicians with degraded video handling.")
    Container(API_Gateway, "API Gateway", "Cloud Endpoints / Envoy", "Entry point managing external and internal routing and ingress traffic.")
    Container(Identity_Access_Management_IAM_Consent_Service, "Identity & Access Management (IAM) / Consent Service", "OAuth2 / OIDC / Google Secret Manager", "Manages user authentication, authorization, and consent-driven access.")
    Container(Core_Services_Container, "Core Services Container", "Spring Boot / Java", "Handles core business logic, e-prescriptions, and platform operations.")
    Container(AI_Symptom_Checker_Container, "AI Symptom Checker Container", "Python / FastAPI / PyTorch / MLflow", "Provides AI-driven symptom checking and traceability.")
    Container(SFU_Video_Container, "SFU Video Container", "LiveKit / Janus", "Manages real-time WebRTC video consultations.")
    Container(Async_Event_Broker, "Async Event Broker", "Google Cloud Pub/Sub", "Handles asynchronous messaging and event distribution with Dead Letter Queues.")
    ContainerDb(Data_Storage, "Data Storage", "Cloud SQL PostgreSQL / Cloud Storage / CMEK", "Persists structured data and files with regional data isolation and CMEK encryption.")
}

Rel(Patients_EU_and_US, Web_App_Mobile_App, "Accesses video consultations, e-prescriptions, and AI symptom checker", "HTTPS/JSON and WebRTC (Video)")
Rel(Licensed_Clinicians, Web_App_Mobile_App, "Conducts video consultations and manages patient care", "HTTPS/JSON and WebRTC (Video)")
Rel(Platform_Administrators_Compliance_Officers, Web_App_Mobile_App, "Manages compliance and platform configurations", "HTTPS/TLS 1.3")
Rel(Web_App_Mobile_App, API_Gateway, "Sends API requests and route traffic", "HTTPS/TLS 1.3")
Rel(API_Gateway, Core_Services_Container, "Routes requests to core business logic", "gRPC with mTLS (Istio/Anthos)")
Rel(API_Gateway, AI_Symptom_Checker_Container, "Routes requests for AI symptom analysis", "gRPC with mTLS (Istio/Anthos)")
Rel(API_Gateway, Identity_Access_Management_IAM_Consent_Service, "Authenticates users and validates consent", "gRPC with mTLS (Istio/Anthos)")
Rel(Core_Services_Container, Async_Event_Broker, "Publishes and consumes asynchronous events", "AMQP/Pub/Sub protocols")
Rel(Core_Services_Container, Data_Storage, "Reads and writes transactional data", "Secure database connections with CMEK encryption")
Rel(AI_Symptom_Checker_Container, Data_Storage, "Logs model artifacts and telemetry", "Secure database connections with CMEK encryption")
Rel(Async_Event_Broker, External_Pharmacies, "Sends e-prescriptions and messaging", "Encrypted HTTPS")
Rel(Core_Services_Container, Regional_Payment_Gateways, "Processes billing and transactions", "HTTPS REST API")
Rel(Identity_Access_Management_IAM_Consent_Service, Identity_Providers, "Federates authentication", "OAuth2 / OIDC / eIDAS")
Rel(Health_Authorities_Auditors, API_Gateway, "Performs audit logging and compliance checks", "HTTPS via zero-trust audit proxies")

@enduml