@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Cross-Border Telehealth Platform

Person(Patients_EU_and_US, "Patients (EU and US)", "Patients seeking secure video consultations, e-prescriptions, and AI symptom checks.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Medical professionals providing consultations and prescriptions across borders.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides secure video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and US, enforcing strict regional data residency and compliance using Google Cloud Platform.")

System_Ext(External_Pharmacies, "External Pharmacies", "EU national e-prescription networks and US pharmacy systems.")
System_Ext(Regional_Payment_Gateways, "Regional Payment Gateways", "Stripe and regional processors handling transactions.")
System_Ext(Health_Authorities_and_Auditors, "Health Authorities & Auditors", "FDA, EMA, and national ministries auditing the platform.")
System_Ext(Identity_Providers, "Identity Providers", "eIDAS for EU and OAuth2/OIDC for US federated authentication and access control.")

Rel(Patients_EU_and_US, Cross_Border_Telehealth_Platform, "Accesses consultations, e-prescriptions, and AI symptom checker", "HTTPS, WebRTC (SRTP/DTLS-SRTP)")
Rel(Licensed_Clinicians, Cross_Border_Telehealth_Platform, "Conducts video consultations and manages patient care", "HTTPS, WebRTC (SRTP/DTLS-SRTP)")
Rel(Cross_Border_Telehealth_Platform, External_Pharmacies, "Sends and manages e-prescriptions", "REST, HL7 FHIR")
Rel(Cross_Border_Telehealth_Platform, Regional_Payment_Gateways, "Processes payments for services", "HTTPS REST API")
Rel(Health_Authorities_and_Auditors, Cross_Border_Telehealth_Platform, "Performs zero-trust read-only audits", "HTTPS via zero-trust audit proxies")
Rel(Identity_Providers, Cross_Border_Telehealth_Platform, "Authenticates users and manages consent-driven access", "OAuth2 / OIDC / eIDAS")

@enduml