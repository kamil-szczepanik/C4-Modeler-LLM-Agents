@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "End users who access video consultations, e-prescriptions, and the AI symptom checker.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Medical professionals who conduct video consultations and issue e-prescriptions to patients.")
Person(Pharmacies, "Pharmacies", "Entities that receive and fulfill e-prescriptions across regional networks.")
Person(Compliance_Officers_Auditors, "Compliance Officers/Auditors", "Personnel responsible for ensuring regulatory compliance, auditing logs, and maintaining data residency standards.")

System_Ext(EU_National_E_Prescription_Gateways, "EU National E-Prescription Gateways", "External national gateways for managing e-prescriptions within the EU.")
System_Ext(US_Pharmacy_Networks, "US Pharmacy Networks", "External networks used to process prescriptions in the United States.")
System_Ext(External_Identity_Providers, "External Identity Providers", "Identity verification systems such as eIDAS and Login.gov.")
System_Ext(Regional_Payment_Gateways, "Regional Payment Gateways", "Payment processors such as Stripe EU/US for handling regional transactions.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(Web_Mobile_Client_Applications, "Web/Mobile Client Applications", "Flutter / React Native", "Cross-platform client applications providing user interfaces for video consultations, e-prescriptions, and the AI symptom checker.")
    Container(Cloud_Load_Balancing_API_Gateway, "Cloud Load Balancing / API Gateway", "OAuth2/OIDC, TLS 1.3", "Manages external client-to-gateway traffic, handling authentication and routing.")
    Container(Video_Consultation_Service, "Video Consultation Service", "LiveKit WebRTC SFU on GKE", "Provides real-time video consultations with dynamic codec step-down for low-bandwidth resilience.")
    Container(AI_Symptom_Checker, "AI Symptom Checker", "Python / FastAPI on Cloud Run", "Provides serverless scaling for AI-powered patient symptom analysis.")
    Container(Consent_Management_Service, "Consent Management Service", "Spring Boot on GKE", "Handles patient consent and regulatory compliance tracking.")
    Container(Patient_Onboarding_Identity, "Patient Onboarding & Identity", "GKE / Cloud Run", "Manages user registration, profile creation, and identity verification.")
    Container(Billing_Regional_Monetization, "Billing & Regional Monetization", "GKE / Cloud Run", "Handles regional transactions and integration with payment gateways.")
    Container(Core_Telehealth_E_Prescription, "Core Telehealth & E-Prescription", "Spring Boot on GKE", "Manages core telehealth workflows and e-prescription processing.")
    Container(Notification_Messaging, "Notification & Messaging", "Node.js on Cloud Run", "Sends asynchronous push alerts and SMS notifications.")
    Container(Cloud_Pub_Sub, "Cloud Pub/Sub", "Google Cloud Pub/Sub", "Buffers asynchronous push alerts and messaging.")
    Container(Cloud_Logging_BigQuery, "Cloud Logging & BigQuery", "Google Cloud Logging, BigQuery", "Collects system logs and provides audit traceability and analytics.")
    Container(Security_Secret_Management, "Security & Secret Management", "Google Cloud KMS (CMEK), Google Secret Manager", "Provides region-separated envelope encryption and secret management.")
}

Rel(Patients, Web_Mobile_Client_Applications, "Accesses telehealth platform features via client applications", "Flutter, React Native")
Rel(Licensed_Clinicians, Web_Mobile_Client_Applications, "Conducts consultations and manages prescriptions via client applications", "Flutter, React Native")
Rel(Web_Mobile_Client_Applications, Cloud_Load_Balancing_API_Gateway, "Sends external client-to-gateway traffic", "HTTPS, WebSockets (WSS)")
Rel(Cloud_Load_Balancing_API_Gateway, Video_Consultation_Service, "Routes real-time video session traffic", "gRPC over mTLS")
Rel(Cloud_Load_Balancing_API_Gateway, AI_Symptom_Checker, "Routes symptom checking requests", "gRPC over mTLS")
Rel(Cloud_Load_Balancing_API_Gateway, Core_Telehealth_E_Prescription, "Routes core telehealth requests", "gRPC over mTLS")
Rel(Cloud_Load_Balancing_API_Gateway, Patient_Onboarding_Identity, "Routes authentication and identity requests", "gRPC over mTLS")
Rel(Cloud_Load_Balancing_API_Gateway, Billing_Regional_Monetization, "Routes payment and billing requests", "gRPC over mTLS")
Rel(Core_Telehealth_E_Prescription, EU_National_E_Prescription_Gateways, "Exchanges prescription data with EU national gateways", "REST, HL7 FHIR over HTTPS")
Rel(Core_Telehealth_E_Prescription, US_Pharmacy_Networks, "Exchanges prescription data with US pharmacy networks", "REST, HL7 FHIR over HTTPS")
Rel(Patient_Onboarding_Identity, External_Identity_Providers, "Authenticates users via external identity systems", "OIDC, SAML")
Rel(Billing_Regional_Monetization, Regional_Payment_Gateways, "Processes regional payment transactions", "HTTPS")
Rel(Notification_Messaging, Web_Mobile_Client_Applications, "Delivers asynchronous push alerts and SMS notifications", "Cloud Pub/Sub, WebSockets, APNS/FCM")
Rel(Core_Telehealth_E_Prescription, Cloud_Pub_Sub, "Publishes messaging events for async processing", "Google Cloud Pub/Sub")
Rel(Video_Consultation_Service, Security_Secret_Management, "Encrypts data using region-separated envelope encryption and secrets", "Google Cloud KMS (CMEK), Secret Manager")
Rel(Core_Telehealth_E_Prescription, Cloud_Logging_BigQuery, "Sends audit logs and telemetry data", "Google Cloud Logging, BigQuery")

@enduml