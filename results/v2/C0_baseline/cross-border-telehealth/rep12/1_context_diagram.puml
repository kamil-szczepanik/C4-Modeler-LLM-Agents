@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "End users who access video consultations, e-prescriptions, and the AI symptom checker.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Medical professionals who conduct video consultations and issue e-prescriptions to patients.")
Person(Pharmacies, "Pharmacies", "Entities that receive and fulfill e-prescriptions across regional networks.")
Person(Compliance_Officers_Auditors, "Compliance Officers/Auditors", "Personnel responsible for ensuring regulatory compliance, auditing logs, and maintaining data residency standards.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for patients across the EU and US while ensuring regional data residency, regulatory compliance, and high availability over unstable connections.")

System_Ext(EU_National_E_Prescription_Gateways, "EU National E-Prescription Gateways", "External national gateways for managing e-prescriptions within the EU.")
System_Ext(US_Pharmacy_Networks, "US Pharmacy Networks", "External networks used to process prescriptions in the United States.")
System_Ext(External_Identity_Providers, "External Identity Providers", "Identity verification systems such as eIDAS and Login.gov.")
System_Ext(Regional_Payment_Gateways, "Regional Payment Gateways", "Payment processors such as Stripe EU/US for handling regional transactions.")

Rel(Patients, Cross_Border_Telehealth_Platform, "Interact with regional services via HTTPS and WebSockets for consultations and symptom checking", "HTTPS, WebSockets")
Rel(Licensed_Clinicians, Cross_Border_Telehealth_Platform, "Interact with regional services for patient video consultations and e-prescriptions", "HTTPS, WebSockets")
Rel(Cross_Border_Telehealth_Platform, EU_National_E_Prescription_Gateways, "Communicate with EU E-Prescription Gateways for prescription processing", "REST, SOAP, HL7 FHIR over HTTPS")
Rel(Cross_Border_Telehealth_Platform, US_Pharmacy_Networks, "Interface with US Pharmacy Networks for prescription fulfillment", "REST, SOAP, HL7 FHIR over HTTPS")
Rel(Cross_Border_Telehealth_Platform, External_Identity_Providers, "Authenticate users using external identity providers", "OIDC, SAML")
Rel(Cross_Border_Telehealth_Platform, Regional_Payment_Gateways, "Process payments through regional gateways", "HTTPS")

@enduml