@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("AI Symptom Checker", "AI Symptom Checker") {
    Component(APIRouter, "API Router", "Python / FastAPI", "Routes incoming API requests to the appropriate handlers within the AI Symptom Checker.")
    Component(TriageOrchestrator, "Triage Orchestrator", "Python / FastAPI", "Orchestrates the symptom checking and triage workflow logic.")
    Component(LLMInferenceAdapter, "LLM/Inference Adapter", "Vertex AI", "Adapts and interfaces with the LLM for regional AI symptom analysis with traceable model versions.")
    Component(AuditTraceabilityLogger, "Audit & Traceability Logger", "Python / FastAPI", "Logs audit and traceability data asynchronously via Google Cloud Pub/Sub.")
    Component(LocalizationTerminologyAdapter, "Localization & Terminology Adapter", "Python / FastAPI", "Handles localization and medical terminology mapping for EU and US patients.")
    Component(ClinicalHandoffDispatcher, "Clinical Handoff Dispatcher", "Python / FastAPI", "Dispatches clinical handoffs for urgent consultations via Google Cloud Pub/Sub.")
}

Rel(TriageOrchestrator, LLMInferenceAdapter, "In-Memory", "In-Memory")
Rel(TriageOrchestrator, AuditTraceabilityLogger, "Async via Google Cloud Pub/Sub", "Google Cloud Pub/Sub")
Rel(ClinicalHandoffDispatcher, GoogleCloudPubSub, "gRPC", "gRPC")

@enduml