@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(web_mobile_client_applications, "Web/Mobile Client Applications") {
    Component(api_client_routing_module, "API Client & Routing Module", "Flutter & React Native HTTP/WebSocket Client", "Handles communication with the API Gateway, managing secure HTTPS requests and WebSocket connections.")
    Component(webrtc_video_module, "WebRTC Video Module", "LiveKit Client SDK", "Manages real-time video consultations, dynamic bitrate adaptation, and direct connection to the LiveKit SFU.")
    Component(offline_caching_module, "Offline Caching Module", "WatermelonDB / Hive", "Provides local offline-first data caching to support rural patients with unstable connections.")
    Component(notification_messaging_handler, "Notification & Messaging Handler", "APNS, FCM, and WebSockets Client", "Receives and handles push notifications and real-time messaging updates from backend services.")
}

Rel(api_client_routing_module, cloud_load_balancing_api_gateway, "Sends API requests and establishes WebSockets", "HTTPS, WSS")
Rel(webrtc_video_module, livekit_webrtc_sfu_on_google_kubernetes_engine_gke, "Streams live video consultations", "WebRTC")
Rel(notification_messaging_handler, web_mobile_client_applications, "Delivers push notifications and messages", "APNS, FCM, WebSockets")
@enduml