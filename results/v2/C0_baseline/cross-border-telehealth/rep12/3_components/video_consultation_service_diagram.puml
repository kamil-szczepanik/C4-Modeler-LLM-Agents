@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Video Consultation Service container

Container_Boundary(video_consultation_service, "Video Consultation Service") {
    Component(SFU_Media_Router, "SFU Media Router", "LiveKit Core", "Streams real-time media and powers real-time video with dynamic codec step-down for low-bandwidth resilience.")
    Component(Session_Signaling_Controller, "Session Signaling Controller", "Go", "Manages session signaling and publishes emergency escalation alerts.")
    Component(Clinical_Integration_Hook, "Clinical Integration Hook", "Go", "Handles clinical integration hooks and interoperability.")
    Component(Network_Diagnostics_Agent, "Network Diagnostics Agent", "Go", "Monitors and diagnoses network conditions for low-bandwidth resilience.")
    Component(Post_Call_Telemetry_Handler, "Post-Call Telemetry Handler", "Go", "Handles post-call telemetry, session ratings, and QoS metrics.")
}

Rel(SFU_Media_Router, Session_Signaling_Controller, "Coordinates media sessions with signaling", "gRPC")
Rel(Session_Signaling_Controller, Clinical_Integration_Hook, "Triggers clinical hooks during sessions", "Internal API")
Rel(Network_Diagnostics_Agent, SFU_Media_Router, "Provides network diagnostics for codec adjustments", "Internal API")
Rel(Post_Call_Telemetry_Handler, Session_Signaling_Controller, "Collects session metrics upon call completion", "Internal API")

@enduml