@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Cloud Load Balancing / API Gateway container

Container_Boundary(cloud_load_balancing_api_gateway, "Cloud Load Balancing / API Gateway") {
    Component(Global External HTTP(S) Load Balancer, "Global External HTTP(S) Load Balancer", "GCP Anycast IP, Cloud Armor", "Sends geo-routed client traffic and provides edge security.")
    Component(API Gateway, "API Gateway", "Envoy-based", "Forwards inspected HTTP/HTTPS and WSS traffic and coordinates with rate limiting.")
    Component(Distributed Rate Limiting & Quota Service, "Distributed Rate Limiting & Quota Service", "Cloud Memorystore for Redis", "Evaluates traffic quotas and retry legitimacy.")
    Component(mTLS Termination & Upstream Router, "mTLS Termination & Upstream Router", "Anthos Service Mesh, Envoy Proxy", "Hands off validated, rate-limited requests and routes backend requests.")
}

Rel(Global External HTTP(S) Load Balancer, API Gateway, "Forwards inspected HTTP/HTTPS and WSS traffic", "Internal HTTPS")
Rel(API Gateway, Distributed Rate Limiting & Quota Service, "Evaluates traffic quotas and retry legitimacy", "gRPC")
Rel(API Gateway, mTLS Termination & Upstream Router, "Hands off validated, rate-limited requests", "gRPC")
@enduml