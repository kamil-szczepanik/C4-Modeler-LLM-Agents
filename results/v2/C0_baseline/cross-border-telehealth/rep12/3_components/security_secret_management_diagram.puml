@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Security & Secret Management container

System_Boundary(security_secret_management, "Security & Secret Management") {
    Component(RegionalKMSAdapter, "Regional KMS Adapter", "Cloud KMS with CMEK", "Handles regional key pinning and encryption operations to satisfy strict EU/US data residency mandates.")
    Component(SecretManagementService, "Secret Management Service", "Google Secret Manager", "Stores and manages sensitive credentials and configuration secrets securely.")
    Component(AuditComplianceLogger, "Audit & Compliance Logger", "Cloud Audit Logs / Google BigQuery", "Records audit trails and compliance events for GDPR, HIPAA, and MDR.")
    Component(EphemeralCredentialBrokerCircuitBreakerSidecar, "Ephemeral Credential Broker & Circuit Breaker Sidecar", "SPIFFE/SPIRE with mTLS", "Provides local gRPC credential brokering, short-lived tokens, and circuit breaking for high availability.")
}

System_Ext(CoreTelehealthEPrescription, "Core Telehealth & E-Prescription", "External calling service")
System_Ext(GoogleBigQuery, "Google BigQuery", "Data Warehouse")

Rel(CoreTelehealthEPrescription, EphemeralCredentialBrokerCircuitBreakerSidecar, "Local gRPC via mTLS (SPIFFE/SPIRE)", "gRPC/mTLS")
Rel(EphemeralCredentialBrokerCircuitBreakerSidecar, RegionalKMSAdapter, "HTTPS / gRPC with Workload Identity", "HTTPS/gRPC")
Rel(EphemeralCredentialBrokerCircuitBreakerSidecar, SecretManagementService, "HTTPS / gRPC with Workload Identity", "HTTPS/gRPC")
Rel(AuditComplianceLogger, GoogleBigQuery, "Cloud Pub/Sub / Streaming Inserts", "Pub/Sub")

@enduml