@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification & Messaging container

Container_Boundary(notification_messaging, "Notification & Messaging") {
    Component(Notification_Orchestrator, "Notification Orchestrator", "Node.js on Cloud Run", "Orchestrates asynchronous alerts and manages the notification workflow.")
    Component(Consent_Enforcer, "Consent Enforcer", "Node.js on Cloud Run", "Validates recipient communication preferences and ensures regulatory compliance.")
    Component(Channel_Adapters, "Channel Adapters", "Node.js on Cloud Run", "Dispatches outbound alerts to external messaging gateways.")
    Component(Token_Signer_Deep_Link_Generator, "Token Signer / Deep Link Generator", "Node.js on Cloud Run", "Generates secure tokens and deep links for notifications.")
    Component(Google_Cloud_PubSub, "Google Cloud Pub/Sub", "Google Cloud Pub/Sub", "Asynchronous messaging with regional topics for data residency.")
    Component(Google_Cloud_Memorystore_Redis, "Google Cloud Memorystore (Redis)", "Google Cloud Memorystore (Redis)", "Enforces idempotent delivery and prevents duplicate alerts on unstable networks.")
    Component(Google_Cloud_KMS_CMEK, "Google Cloud KMS / CMEK", "Google Cloud KMS", "Provides encryption at rest via customer-managed encryption keys.")
    Component(Google_Secret_Manager, "Google Secret Manager", "Google Secret Manager", "Manages cryptographic keys and application secrets.")
}

Component_Ext(Firebase_Cloud_Messaging_FCM__Apple_Push_Notification_service_APNs, "Firebase Cloud Messaging (FCM) / Apple Push Notification service (APNs)", "FCM / APNs", "Multi-channel mobile push delivery.")
Component_Ext(Twilio_SMS_Gateway, "Twilio SMS Gateway", "Twilio", "SMS fallback and text message distribution.")
Component_Ext(Consent_Management_Service, "Consent Management Service", "External Service", "Manages user consent and preferences.")
Component_Ext(BigQuery, "BigQuery", "Google Cloud BigQuery", "Stores delivery metrics and audit logs.")

Rel(Google_Cloud_PubSub, Notification_Orchestrator, "Consumes regional events via gRPC")
Rel(Notification_Orchestrator, Google_Cloud_Memorystore_Redis, "Enforces idempotent delivery using Redis")
Rel(Consent_Enforcer, Consent_Management_Service, "Validates recipient communication preferences via HTTPS/REST")
Rel(Channel_Adapters, Firebase_Cloud_Messaging_FCM__Apple_Push_Notification_service_APNs, "Dispatches outbound alerts using HTTPS/REST with TLS 1.3 and mTLS")
Rel(Channel_Adapters, Twilio_SMS_Gateway, "Dispatches outbound alerts using HTTPS/REST with TLS 1.3 and mTLS")
Rel(notification_messaging, BigQuery, "Emits delivery metrics and audit logs")

@enduml