@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Cloud Logging & BigQuery container

Container_Boundary(cloud_logging_bigquery, "Cloud Logging & BigQuery") {
    Component(LogIngestionRoutingEngine, "Log Ingestion & Routing Engine", "Google Cloud Logging Sinks, Cloud Pub/Sub", "Ingests and routes structured logs and telemetry from GKE & Cloud Run Services, enforcing regional data residency.")
    Component(AuditComplianceDataStore, "Audit & Compliance Data Store", "BigQuery Partitioned Datasets, Cloud KMS", "Stores region-segregated, pseudonymized logs with WORM retention policies and customer-managed encryption keys.")
    Component(AnalyticsBIExporter, "Analytics & BI Exporter", "BigQuery Authorized Views, Column-Level Masking", "Exposes anonymized metrics and aggregated KPIs while protecting sensitive patient data.")
    Component(ClinicalInsightsDashboard, "Clinical Insights Dashboard", "Looker Studio Enterprise", "Feeds aggregated KPIs and clinical metrics for quality monitoring via secure authenticated connections.")
    Component(SecurityInfrastructure, "Security & Infrastructure", "Cloud KMS, Cloud Monitoring", "Provides cryptographic isolation and operational monitoring for regulatory compliance.")
}

Rel(LogIngestionRoutingEngine, AuditComplianceDataStore, "Stores region-segregated, pseudonymized logs", "BigQuery SQL, Google Cloud Pub/Sub")
Rel(AuditComplianceDataStore, AnalyticsBIExporter, "Exposes anonymized metrics", "BigQuery Authorized Views, Column-Level Masking")
Rel(AnalyticsBIExporter, ClinicalInsightsDashboard, "Feeds aggregated KPIs and clinical metrics", "HTTPS, OAuth2/OIDC")

@enduml