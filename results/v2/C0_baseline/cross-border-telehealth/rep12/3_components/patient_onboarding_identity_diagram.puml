@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(patient_onboarding_identity, "Patient Onboarding & Identity") {
    Component(Edge_Registration_API, "Edge Registration API", "Cloud Run / Node.js or Go", "Handles lightweight edge routing and forwards authenticated onboarding requests.")
    Component(Identity_Core_Engine, "Identity Core Engine", "GKE / Spring Boot", "Processes core identity microservices logic, identity workflows, and delegates to regional data stores.")
    Component(Data_Residency_Router_Regional_Data_Store_Gateway, "Data Residency Router & Regional Data Store Gateway", "GKE / Regional Gateway", "Enforces geo-partitioning and routes data to ensure compliance with data residency mandates.")
}

Rel(Edge_Registration_API, Identity_Core_Engine, "Delegates processing of identity workflows", "Internal gRPC over mTLS")
Rel(Identity_Core_Engine, Data_Residency_Router_Regional_Data_Store_Gateway, "Enforces geo-partitioning and stores profile data", "gRPC over mTLS")

@enduml