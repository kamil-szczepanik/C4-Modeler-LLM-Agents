@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Consent Management Service container

Container_Boundary(consent_management_service, "Consent Management Service") {
    Component(ConsentRESTController, "Consent REST Controller", "Spring Boot & Spring Security (OAuth2/JWT)", "Handles HTTPS/REST requests from patients and mobile clients for consent management.")
    Component(ConsentPolicyEngine, "Consent Policy Engine", "Spring Boot", "Performs granular policy evaluation, instant revocation, and includes the Break-Glass Protocol.")
    Component(AuditComplianceLogger, "Audit & Compliance Logger", "Spring Boot with Metadata Enricher", "Generates cryptographic audit logs and pushes compliance events.")
    Component(ConsentPersistenceAdapter, "Consent Persistence Adapter", "JPA / Hibernate", "Manages data persistence and retrieval against regional PostgreSQL instances.")
    Component(GoogleCloudPubSub, "Google Cloud Pub/Sub", "Google Cloud Pub/Sub", "Asynchronous event messaging for cache invalidation and audit logging.")
    Component(RegionalPostgreSQLInstances, "Regional PostgreSQL Instances", "PostgreSQL", "Stores consent records and ensures strict regional data isolation.")
    Component(RedisCache, "Redis Cache", "Redis / Spring Cache", "Provides low-latency local read-through caching for policy evaluation.")
}

Rel(PatientsAndMobileClients, ConsentRESTController, "Invoke via HTTPS/REST (OAuth2/JWT)", "")
Rel(CoreTelehealth, ConsentPolicyEngine, "Communicates via gRPC with mTLS (Istio service mesh)", "")
Rel(ConsentPolicyEngine, ConsentPersistenceAdapter, "Uses JPA/Hibernate", "")
Rel(ConsentPersistenceAdapter, RegionalPostgreSQLInstances, "Queries regional data", "")
Rel(ConsentPolicyEngine, RedisCache, "Interacts via Spring Cache for low-latency reads", "")
Rel(AuditComplianceLogger, GoogleCloudPubSub, "Pushes events", "")
Rel(AuditComplianceLogger, BigQuery, "Pushes audit logs", "")
@enduml