@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Cloud Pub/Sub container

Container_Boundary(cloud_pub_sub, "Cloud Pub/Sub") {
    Component(EU_Pub_Sub_Regional_Topic, "EU Pub/Sub Regional Topic", "Google Cloud Pub/Sub", "Manages regional asynchronous messaging and triage audit events for the EU boundary.")
    Component(US_Pub_Sub_Regional_Topics, "US Pub/Sub Regional Topics", "Google Cloud Pub/Sub", "Manages regional asynchronous messaging and event distribution within the US boundary.")
    Component(Dead_Letter_Queues_DLQs, "Dead-Letter Queues (DLQs)", "Google Cloud Pub/Sub DLQ", "Captures unprocessable messages after maximum delivery attempts for error handling and review.")
}

System(AI_Symptom_Checker, "AI Symptom Checker", "Python / FastAPI on Cloud Run")
System(Core_Telehealth_E_Prescription, "Core Telehealth & E-Prescription", "Spring Boot on GKE")
System_Ext(Cloud_Logging_BigQuery, "Cloud Logging & BigQuery", "Google Cloud Audit Logs")

Rel(AI_Symptom_Checker, EU_Pub_Sub_Regional_Topic, "Publishes triage audit events with model version metadata", "gRPC/HTTPS")
Rel(Core_Telehealth_E_Prescription, EU_Pub_Sub_Regional_Topic, "Publishes asynchronous messaging events [EU]", "gRPC/HTTPS")
Rel(Core_Telehealth_E_Prescription, US_Pub_Sub_Regional_Topics, "Publishes asynchronous messaging events [US]", "gRPC/HTTPS")
Rel(EU_Pub_Sub_Regional_Topic, Dead_Letter_Queues_DLQs, "Forwards unprocessable messages after max delivery attempts", "gRPC")
Rel(EU_Pub_Sub_Regional_Topic, Cloud_Logging_BigQuery, "Exports message delivery and audit logs for compliance tracking", "Google Cloud Audit Logs")
Rel(US_Pub_Sub_Regional_Topics, Cloud_Logging_BigQuery, "Exports message delivery and audit logs for compliance tracking", "Google Cloud Audit Logs")

@enduml