@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients_EU_US, "Patients (EU & US)", "Patients in the EU and US seeking video consultations, e-prescriptions, and AI symptom checking.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Licensed medical professionals providing video consultations and issuing e-prescriptions.")
Person(Platform_Administrators, "Platform Administrators", "Administrators managing platform infrastructure and configurations.")
Person(Support_Agents, "Support Agents", "Support agents assisting users with platform issues.")
System_Ext(Pharmacy_Partners_EU_US, "Pharmacy Partners (EU & US)", "EU National E-Prescription Gateways and US Pharmacy Networks handling prescription fulfillment.")
Person(Regulatory_Officers, "Regulatory Officers", "Officers ensuring adherence to GDPR, HIPAA, and regional healthcare regulations.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(Web_Mobile_Client, "Web / Mobile Client", "React / React Native", "Client application used by patients and clinicians to access telehealth services.")
    Container(API_Gateway, "API Gateway", "Envoy / Cloud Endpoints", "Edge and routing service handling ingress traffic and local TURN/STUN relays.")
    Container(Core_Telehealth_Service, "Core Telehealth Service", "Node.js / NestJS", "Handles core telehealth business logic and consultations.")
    Container(AI_Symptom_Service, "AI Symptom Service", "Python / FastAPI", "Provides isolated AI symptom checking and triage recommendations.")
    Container(Localization_Service, "Localization Service", "Node.js / NestJS", "Manages regional localization and compliance adaptations.")
    Container(Billing_Payment_Container, "Billing / Payment Container", "Node.js / NestJS", "Handles payment processing and financial transactions.")
    ContainerDb(Google_Cloud_SQL_PostgreSQL, "Google Cloud SQL (PostgreSQL)", "PostgreSQL with CMEK", "Regional database storing localized PHI.")
    Container(Cloud_Storage_WORM_buckets, "Cloud Storage WORM buckets", "GCP Cloud Storage WORM", "Storage for immutable AI audit logs ensuring EU MDR traceability.")
}

Rel(Patients_EU_US, Web_Mobile_Client, "Access telehealth services, video consultations, and AI symptom checker.", "HTTPS (TLS 1.3) and WSS")
Rel(Licensed_Clinicians, Web_Mobile_Client, "Conduct video consultations and manage e-prescriptions.", "HTTPS (TLS 1.3) and WSS")
Rel(Platform_Administrators, API_Gateway, "Manage and configure platform routing and services.", "HTTPS")
Rel(Support_Agents, API_Gateway, "Access support tools and logs.", "HTTPS")
Rel(Regulatory_Officers, Cloud_Storage_WORM_buckets, "Audit immutable logs for regulatory compliance.", "Secure Access")
Rel(Web_Mobile_Client, API_Gateway, "Sends client requests and streams media via local TURN/STUN.", "HTTPS (TLS 1.3) and WSS")
Rel(API_Gateway, Core_Telehealth_Service, "Routes internal backend requests.", "gRPC over mTLS")
Rel(API_Gateway, AI_Symptom_Service, "Routes AI symptom check requests.", "gRPC over mTLS")
Rel(API_Gateway, Localization_Service, "Routes localization requests.", "gRPC over mTLS")
Rel(API_Gateway, Billing_Payment_Container, "Routes billing requests.", "gRPC over mTLS")
Rel(Core_Telehealth_Service, Google_Cloud_SQL_PostgreSQL, "Persists core application data and PHI.", "TCP/TLS")
Rel(AI_Symptom_Service, Cloud_Storage_WORM_buckets, "Direct write of immutable audit payloads.", "HTTPS / Cloud Storage API")
Rel(Core_Telehealth_Service, Pharmacy_Partners_EU_US, "Sends e-prescriptions to regional partners.", "REST / HL7 FHIR over mTLS")

@enduml