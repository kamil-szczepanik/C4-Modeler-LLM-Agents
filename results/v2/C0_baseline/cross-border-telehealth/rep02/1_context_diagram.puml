@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients (EU & US)", "Patients in the EU and US seeking video consultations, e-prescriptions, and AI symptom checking.")
Person(Clinicians, "Licensed Clinicians", "Licensed medical professionals providing video consultations and issuing e-prescriptions.")

System(Platform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and the US with strict data residency, regulatory compliance, and low-bandwidth resilience.")

System_Ext(Pharmacy, "Pharmacy Partners (EU & US)", "EU National E-Prescription Gateways and US Pharmacy Networks handling prescription fulfillment.")
System_Ext(Compliance, "Compliance / Regulatory Officers", "Officers ensuring adherence to GDPR, HIPAA, and regional healthcare regulations.")
System_Ext(SFU, "Third-Party WebRTC SFU", "External SFU handling video/media streams with active-active edge routing and circuit-breaker patterns.")
System_Ext(AI_Service, "AI Model Registry / Inference Service", "External service providing triage recommendations via secure HTTPS/REST.")

Rel(Patients, Platform, "Interact via regional platform containers for consultations, prescriptions, and symptom checks.", "HTTPS (TLS 1.3) and WebRTC (E2EE)")
Rel(Clinicians, Platform, "Interact via regional platform containers to consult patients and manage prescriptions.", "HTTPS (TLS 1.3) and WebRTC (E2EE)")
Rel(Platform, Pharmacy, "Connect to national e-prescription gateways and pharmacy networks.", "REST/HL7 FHIR over mTLS")
Rel(Platform, SFU, "Integrate using active-active edge routing for low-bandwidth resilience.", "WebRTC")
Rel(Platform, AI_Service, "Interface with AI inference services for triage recommendations.", "HTTPS/REST")

@enduml