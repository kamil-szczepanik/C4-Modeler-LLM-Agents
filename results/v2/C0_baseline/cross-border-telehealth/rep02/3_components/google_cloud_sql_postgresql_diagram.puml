@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(google_cloud_sql_postgresql, "Google Cloud SQL (PostgreSQL)") {
    Component(PostgreSQL_RDBMS_Engine, "PostgreSQL RDBMS Engine", "PostgreSQL with Row-Level Security (RLS)", "Enforces regional data residency and patient consent constraints directly at the data layer using Row-Level Security.")
    Component(PgBouncer_Connection_Pooler, "PgBouncer Connection Pooler", "PgBouncer", "Handles connection pooling configured in session mode to securely maintain session state for RLS.")
    Component(CMEK_Module, "CMEK Module", "Google Cloud KMS", "Manages regional Customer-Managed Encryption Keys for data-at-rest encryption.")
    Component(Audit_Activity_Logging_Daemon, "Audit & Activity Logging Daemon", "pgAudit with Google Cloud Logging / BigQuery", "Streams detailed audit trails for traceability to ensure compliance with EU MDR and HIPAA.")
}

Rel(PgBouncer_Connection_Pooler, PostgreSQL_RDBMS_Engine, "Forwards pooled queries maintaining session state for RLS", "TCP/TLS")
Rel(PostgreSQL_RDBMS_Engine, CMEK_Module, "Manages regional encryption keys using CMEK", "HTTPS")
Rel(Audit_Activity_Logging_Daemon, PostgreSQL_RDBMS_Engine, "Captures and streams audit logs from the database engine", "")
@enduml