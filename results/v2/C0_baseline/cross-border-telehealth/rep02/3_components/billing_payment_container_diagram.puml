@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Billing / Payment Container", "Billing / Payment Container") {
    Component("Billing API Controller", "Billing API Controller", "Node.js / NestJS", "Manages multi-currency transactions, regional tax calculations, and secure payment processing.")
    Component("Payment Orchestrator Service", "Payment Orchestrator Service", "Node.js / NestJS", "Orchestrates payment workflows across external gateways and recovery services.")
    Component("Ledger & Invoice Engine", "Ledger & Invoice Engine", "Node.js / NestJS", "Manages ledgers and generates invoices for billing operations.")
    Component("PCI-DSS Tokenization Adapter", "PCI-DSS Tokenization Adapter", "Node.js / NestJS", "Handles secure tokenization to maintain strict PCI-DSS scope separation.")
    Component("Tax & Currency Engine", "Tax & Currency Engine", "Node.js / NestJS", "Calculates regional taxes and handles multi-currency transactions.")
    Component("Checkout Recovery Service", "Checkout Recovery Service", "Node.js / NestJS", "Recovers abandoned or failed checkouts via internal events.")
}

Rel("Billing API Controller", "Tax & Currency Engine", "Internal Function Call")
Rel("Payment Orchestrator Service", "Checkout Recovery Service", "Internal Event")

@enduml