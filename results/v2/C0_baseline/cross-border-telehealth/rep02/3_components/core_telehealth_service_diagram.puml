@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Telehealth Service container

Container_Boundary(core_telehealth_service, "Core Telehealth Service") {
    Component(Consultation_Orchestrator, "Consultation Orchestrator", "Node.js / NestJS", "Manages video and audio streaming sessions via the Third-Party WebRTC SFU.")
    Component(Consent_Policy_Enforcement, "Consent & Policy Enforcement", "Node.js / NestJS with OPA Sidecar", "Validates consent records, evaluates zero-trust policies, and queries PHI securely.")
    Component(Prescription_Dispatcher, "Prescription Dispatcher", "Node.js / NestJS", "Dispatches regional e-prescriptions to Pharmacy Partners in the EU and US.")
    Component(Telemetry_Metrics_Adapter, "Telemetry & Metrics Adapter", "OpenTelemetry", "Captures structured audit logs and metrics without leaking PHI.")
}

System_Ext(Third_Party_WebRTC_SFU, "Third-Party WebRTC SFU", "Handles video and audio streaming.")
System_Ext(Google_Cloud_SQL_PostgreSQL, "Google Cloud SQL (PostgreSQL)", "Stores encrypted PHI and consent records.")
System_Ext(Pharmacy_Partners_EU_US, "Pharmacy Partners (EU & US)", "External pharmacy systems for e-prescriptions.")

Rel(Consultation_Orchestrator, Third_Party_WebRTC_SFU, "Manages video and audio streaming sessions", "WebRTC / SRTP")
Rel(Consent_Policy_Enforcement, Google_Cloud_SQL_PostgreSQL, "Validates consent records and queries PHI", "TCP/TLS 1.3")
Rel(Prescription_Dispatcher, Pharmacy_Partners_EU_US, "Dispatches regional e-prescriptions", "REST / HL7 FHIR over mTLS")

@enduml