@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(ai_symptom_service, "AI Symptom Service") {
    Component(triage_orchestrator, "Triage Orchestrator Component", "Python / FastAPI", "Orchestrates the symptom check workflow and coordinates internal inference and explanation steps.")
    Component(inference_adapter, "Inference Adapter", "gRPC client", "Executes symptom evaluation via gRPC against the AI Model Registry / Inference Service.")
    Component(explanation_generator, "Explanation Generator", "Python / FastAPI", "Generates clinical explanations for the AI symptom evaluation results.")
    Component(de_identification_middleware, "De-identification Middleware", "Python middleware", "Ensures local de-identification of patient data for regulatory compliance before logging or processing.")
    Component(fluentbit_sidecar, "Fluentbit sidecar container", "Fluentbit", "Offloads audit payloads via local ephemeral volumes with LUKS encryption.")
}

Rel(triage_orchestrator, inference_adapter, "Executes symptom evaluation", "gRPC")
Rel(triage_orchestrator, explanation_generator, "Requests evaluation explanations", "Internal")
Rel(triage_orchestrator, de_identification_middleware, "Sanitizes data payloads", "Internal")
Rel(triage_orchestrator, fluentbit_sidecar, "Offloads audit payloads via local ephemeral volumes with LUKS encryption", "Local Volume")
@enduml