@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Component(API_Gateway, "API Gateway", "Gateway", "Routes localization requests via gRPC over mTLS.")
System_Ext(GCP_Cloud_Storage_WORM, "GCP Cloud Storage WORM", "External Storage", "Immutable, versioned storage for compliance bundles.")

Container_Boundary(Localization_Service, "Localization Service") {
    Component(Localization_Controller, "Localization Controller", "NestJS Controller", "Manages regional i18n, medical glossaries, and compliance disclaimers, handling incoming gRPC routes.")
    Component(Translation_Engine, "Translation Engine", "Component", "Resolves localized strings and manages medical glossaries.")
    Component(Regional_Policy_Provider, "Regional Policy Provider", "Component", "Fetches compliance text and regional policies under strict data residency mandates.")
    Component(Localization_Cache, "Localization Cache", "Google Memorystore Redis", "Isolated regional caching to enforce data residency.")
    Component(Bundle_Loader_Verifier, "Bundle Loader & Verifier", "Component", "Downloads and verifies signed compliance bundles.")
}

Rel(API_Gateway, Localization_Controller, "Routes localization requests", "gRPC over mTLS")
Rel(Localization_Controller, Translation_Engine, "Resolves localized strings", "In-process / Function call")
Rel(Localization_Controller, Regional_Policy_Provider, "Fetches compliance text", "In-process")
Rel(Translation_Engine, Localization_Cache, "Reads cached bundles", "Redis Protocol over TLS")
Rel(Regional_Policy_Provider, Localization_Cache, "Reads cached bundles", "Redis Protocol over TLS")
Rel(Bundle_Loader_Verifier, GCP_Cloud_Storage_WORM, "Downloads signed bundles", "HTTPS / GCP SDK")

@enduml