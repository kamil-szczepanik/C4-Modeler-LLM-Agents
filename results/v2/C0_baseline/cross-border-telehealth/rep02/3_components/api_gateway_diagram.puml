@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(WAF, "WAF", "Envoy / Cloud Endpoints", "Web Application Firewall for edge security and filtering.")
    Component(Geo_Router, "Geo-Router", "Envoy Routing", "Routes client requests based on geographic location to enforce data residency.")
    Component(xDS_Client, "xDS Client", "Envoy gRPC Client", "Fetches dynamic routing updates from the Control Plane.")
}

Rel(WAF, Geo_Router, "Forwards inspected client traffic")
Rel(Geo_Router, xDS_Client, "Uses configuration for dynamic routing")
@enduml