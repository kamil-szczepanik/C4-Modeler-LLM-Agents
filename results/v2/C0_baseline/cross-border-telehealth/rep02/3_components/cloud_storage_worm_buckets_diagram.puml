@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(cloud_storage_worm_buckets, "Cloud Storage WORM buckets") {
    Component(Immutable_Audit_Storage_Interface, "Immutable Audit Storage Interface", "GCP Cloud Storage API with Compliance Mode", "Enforces Write-Once-Read-Many (WORM) immutability guarantees for compliance audit payloads.")
    Component(CMEK_Key_Management_Component, "CMEK Key Management Component", "Cloud KMS", "Manages regional Customer-Managed Encryption Keys (CMEK) for data at rest protection.")
}

Rel(Immutable_Audit_Storage_Interface, CMEK_Key_Management_Component, "Secures stored payloads using regional encryption keys", "HTTPS / Cloud KMS API")
@enduml