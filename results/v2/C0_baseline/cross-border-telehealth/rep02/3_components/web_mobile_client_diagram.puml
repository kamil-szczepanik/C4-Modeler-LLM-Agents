@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Patients_Clinicians, "Patients & Clinicians", "Access telehealth services, video consultations, and consent management")
System_Ext(API_Gateway, "API Gateway", "Envoy / Cloud Endpoints")
System_Ext(API_Gateway_SFU, "API Gateway & SFU", "Selective Forwarding Unit for video streams")

Container_Boundary(Web_Mobile_Client_container, "Web / Mobile Client") {
    Component(UIPresentationLayer, "UI Presentation Layer", "React / React Native", "Sends synchronous application requests and handles presentation.")
    Component(WebRTC_Media_Client, "WebRTC Media Client", "WebRTC with Insertable Streams API", "Streams video consultations and handles adaptive bitrate fallback with end-to-end encryption.")
    Component(Telemetry_Audit_Logger, "Telemetry & Audit Logger", "React / React Native", "Transmits scrubbed audit logs and regional usage telemetry.")
    Component(Local_State_Storage_Manager, "Local State & Storage Manager", "Platform-Native Secure Enclaves & SQLite", "Secure token storage and encrypted local state management for offline caching.")
    Component(Web_Mobile_Client, "Web / Mobile Client", "React / React Native", "Unified multi-platform client framework minimizing development overhead across regions.")
}

Rel(Patients_Clinicians, Web_Mobile_Client, "Access telehealth services, video consultations, and consent management", "HTTPS (TLS 1.3) and WSS")
Rel(UIPresentationLayer, API_Gateway, "Sends synchronous application requests", "HTTPS (TLS 1.3)")
Rel(WebRTC_Media_Client, API_Gateway_SFU, "Streams video consultations and handles adaptive bitrate fallback", "WSS and WebRTC with Insertable Streams E2EE")
Rel(Telemetry_Audit_Logger, API_Gateway, "Transmits scrubbed audit logs and regional usage telemetry", "HTTPS (TLS 1.3)")

@enduml