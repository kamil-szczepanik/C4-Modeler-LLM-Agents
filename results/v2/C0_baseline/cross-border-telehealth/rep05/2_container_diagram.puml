@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients_EU_US, "Patients (EU/US)", "Patients accessing video consultations, e-prescriptions, and AI symptom checker.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Clinicians conducting consultations and issuing treatments.")
Person(Pharmacies_Compliance_Officers_AI_Safety_Monitors, "Pharmacies & Compliance Officers / AI Safety Monitors", "Entities handling fulfillment and regulatory audits.")
Person(Platform_Administrators, "Platform Administrators", "Administrators managing the platform infrastructure.")

System_Ext(Regional_Identity_Providers, "Regional Identity Providers", "External identity providers handling authentication.")
System_Ext(Regional_Pharmacy_Networks, "Regional Pharmacy Networks", "External pharmacy networks for prescription fulfillment.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(Web_Mobile_Client_Apps, "Web & Mobile Client Apps", "Flutter / React Native", "Client applications enabling offline-first caching and user interactions.")
    Container(API_Gateway, "API Gateway", "GCP Cloud Endpoints / Envoy", "Routes requests using geo-DNS and validates tokens.")
    Container(Core_Telehealth_Service, "Core Telehealth Service", "Go / gRPC", "Handles core telehealth business logic and consultations.")
    Container(AI_Symptom_Checker_Service, "AI Symptom Checker Service", "Python / FastAPI on Cloud Run", "Provides AI-driven symptom checking capabilities.")
    Container(Video_Session_Manager, "Video Session Manager", "Node.js", "Manages real-time video sessions.")
    Container(E_Prescription_Integrator, "E-Prescription Integrator", "Java / Spring Boot", "Integrates with regional pharmacy networks for e-prescriptions.")
    ContainerDb(Regional_Data_Storage_Audit_Layer, "Regional Data Storage & Audit Layer", "Cloud SQL, BigQuery", "Persists transactional data and immutable audit logs.")
}

Rel(Patients_EU_US, Web_Mobile_Client_Apps, "Interacts with client applications", "HTTPS, WebSockets")
Rel(Licensed_Clinicians, Web_Mobile_Client_Apps, "Interacts with client applications", "HTTPS, WebSockets")
Rel(Web_Mobile_Client_Apps, API_Gateway, "Communicates with API gateway", "HTTPS/gRPC")
Rel(API_Gateway, Regional_Identity_Providers, "Validates authentication tokens", "OAuth 2.0 / OIDC, HTTPS")
Rel(API_Gateway, Core_Telehealth_Service, "Routes requests", "geo-DNS, gRPC")
Rel(API_Gateway, AI_Symptom_Checker_Service, "Routes requests", "geo-DNS, gRPC")
Rel(API_Gateway, Video_Session_Manager, "Routes requests", "geo-DNS, gRPC")
Rel(API_Gateway, E_Prescription_Integrator, "Routes requests", "geo-DNS, gRPC")
Rel(Core_Telehealth_Service, Regional_Data_Storage_Audit_Layer, "Persists transactional data and audit logs", "VPC Service Controls")
Rel(AI_Symptom_Checker_Service, Regional_Data_Storage_Audit_Layer, "Persists audit logs and data", "VPC Service Controls")
Rel(Video_Session_Manager, Regional_Data_Storage_Audit_Layer, "Persists session data and logs", "VPC Service Controls")
Rel(E_Prescription_Integrator, Regional_Data_Storage_Audit_Layer, "Persists prescription audit logs", "VPC Service Controls")
Rel(Core_Telehealth_Service, AI_Symptom_Checker_Service, "Communicates internally", "mTLS-secured gRPC")
Rel(Core_Telehealth_Service, E_Prescription_Integrator, "Communicates internally", "mTLS-secured gRPC")
Rel(E_Prescription_Integrator, Regional_Pharmacy_Networks, "Connects to pharmacy networks", "HL7 FHIR, national EU formats")

@enduml