@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients (EU/US)", "External actors accessing video consultations, e-prescriptions, and the AI symptom checker.")
Person(Clinicians, "Licensed Clinicians", "External actors conducting consultations and issuing treatments.")
Person(PharmaciesCompliance, "Pharmacies & Compliance Officers", "External actors handling fulfillment and regulatory audits.")

System(CrossBorderTelehealthPlatform, "Cross-Border Telehealth Platform", "Provides secure video consultations, e-prescriptions, and an AI symptom checker for patients across the EU and US, bridging fragmented regional healthcare markets.")

System_Ext(RegionalPharmacyNetworks, "Regional Pharmacy Networks", "External systems for processing prescription fulfillment.")
System_Ext(ThirdPartyVideoInfrastructure, "Third-Party Video Infrastructure", "External video infrastructure providing video consultation capabilities.")
System_Ext(RegionalIdentityProviders, "Regional Identity Providers", "External identity providers handling authentication via OAuth 2.0 / OIDC.")

Rel(Patients, CrossBorderTelehealthPlatform, "Accesses video consultations, e-prescriptions, and AI symptom checker", "TLS 1.3 over HTTPS, WebRTC, short-lived JWTs")
Rel(Clinicians, CrossBorderTelehealthPlatform, "Conducts consultations and issues treatments", "TLS 1.3 over HTTPS, WebRTC, short-lived JWTs")
Rel(PharmaciesCompliance, CrossBorderTelehealthPlatform, "Handles fulfillment and regulatory audits", "HTTPS, mTLS")
Rel(CrossBorderTelehealthPlatform, RegionalPharmacyNetworks, "Sends prescription fulfillment details", "mTLS, HL7 FHIR over HTTPS")
Rel(CrossBorderTelehealthPlatform, ThirdPartyVideoInfrastructure, "Streams video consultations", "WebRTC, HTTPS")
Rel(CrossBorderTelehealthPlatform, RegionalIdentityProviders, "Authenticates users via OAuth 2.0 / OIDC with step-up MFA", "OAuth 2.0 / OIDC, HTTPS")

@enduml