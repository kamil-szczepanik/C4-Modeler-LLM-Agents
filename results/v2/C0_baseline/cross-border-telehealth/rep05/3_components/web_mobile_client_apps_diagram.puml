@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component Diagram for Web & Mobile Client Apps

System_Ext(api_gateway, "API Gateway", "GCP Cloud Endpoints / Envoy", "External API Gateway handling routing to regional services")
System_Ext(regional_identity_providers, "Regional Identity Providers", "OAuth 2.0 / OpenID Connect", "External Identity Providers for authentication")

Container_Boundary(web_mobile_client_apps, "Web & Mobile Client Apps") {
    Component(ui_layer_state_manager, "UI Layer & State Manager", "Flutter / React Native", "Handles cross-platform mobile and web client deployment and user interface state.")
    Component(offline_local_store, "Offline Local Store", "SQLite / WatermelonDB with SQLCipher", "Provides encrypted offline-first data caching for intermittent connectivity and rural network conditions.")
    Component(api_client_sync_engine, "API Client & Sync Engine", "gRPC-Web / REST with OpenAPI", "Ensures low-overhead synchronization over constrained networks.")
    Component(local_consent_session_manager, "Local Consent & Session Manager", "iOS Keychain / Android Keystore with Secure Enclave", "Secures token storage and local consent/session management.")
    Component(local_telemetry_audit_wrapper, "Local Telemetry & Audit Wrapper", "Secure Hardware-backed Cryptographic Signer", "Handles local telemetry and hardware-backed cryptographic audit signing.")
}

Rel(ui_layer_state_manager, offline_local_store, "Communicates via in-memory method calls to read and cache data", "In-memory")
Rel(ui_layer_state_manager, api_client_sync_engine, "Communicates via in-memory method calls to trigger network synchronization", "In-memory")
Rel(api_client_sync_engine, api_gateway, "Communicates via HTTPS / gRPC-Web", "JSON/Protobuf over HTTP/2")
Rel(local_consent_session_manager, regional_identity_providers, "Authenticates", "OAuth 2.0 with PKCE")

@enduml