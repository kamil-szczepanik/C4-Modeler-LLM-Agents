@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(Envoy_Proxy_Router, "Envoy Proxy Router", "Envoy Proxy / GCP Cloud Endpoints", "Handles geo-routing, TLS termination, traffic shaping, and proxies requests to backend microservices.")
    Component(WASM___Lua_Consent_Filter, "WASM / Lua Consent Filter", "WASM / Lua", "Custom Envoy filters used for consent metadata extraction and context handling.")
}

System_Ext(Core_Telehealth_Service, "Core Telehealth Service", "Go / gRPC")
System_Ext(AI_Symptom_Checker_Service, "AI Symptom Checker Service", "Python / FastAPI on Cloud Run")
System_Ext(Video_Session_Manager, "Video Session Manager", "Node.js")
System_Ext(E_Prescription_Integrator, "E-Prescription Integrator", "Java / Spring Boot")
System_Ext(Regional_Identity_Providers, "Regional Identity Providers", "OAuth 2.0 / OIDC, HTTPS")

Rel(Envoy_Proxy_Router, WASM___Lua_Consent_Filter, "Extracts consent metadata using", "WASM / Lua")
Rel(Envoy_Proxy_Router, Core_Telehealth_Service, "Routes requests using", "internal gRPC over HTTP/2, mTLS via SPIFFE/SPIRE")
Rel(Envoy_Proxy_Router, AI_Symptom_Checker_Service, "Proxies requests with", "W3C Trace Context and gRPC")
Rel(Envoy_Proxy_Router, Video_Session_Manager, "Routes control plane traffic using", "gRPC")
Rel(Envoy_Proxy_Router, E_Prescription_Integrator, "Routes prescription requests using", "gRPC")
Rel(Envoy_Proxy_Router, Regional_Identity_Providers, "Validates authentication tokens via", "OAuth 2.0 / OIDC, HTTPS")

@enduml