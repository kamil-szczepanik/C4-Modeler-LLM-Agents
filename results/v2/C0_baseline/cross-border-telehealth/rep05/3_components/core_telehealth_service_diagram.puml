@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component Diagram for the Core Telehealth Service container

Container_Boundary(core_telehealth_service, "Core Telehealth Service") {
    Component(Telehealth API Handler, "Telehealth API Handler", "Go / gRPC", "Handles incoming gRPC requests routed from the API Gateway and exposes core endpoints.")
    Component(Consent & Policy Engine, "Consent & Policy Engine", "Go / Open Policy Agent (OPA)", "Enforces granular consent and regional compliance policies for every transaction.")
    Component(Session & Prescription Orchestrator, "Session & Prescription Orchestrator", "Go / gRPC", "Coordinates interactions with the Video Session Manager and E-Prescription Integrator.")
}

System_Ext(AI Symptom Checker Service, "AI Symptom Checker Service", "Python / FastAPI on Cloud Run")
System_Ext(E-Prescription Integrator, "E-Prescription Integrator", "Java / Spring Boot")
System_Ext(Regional Data Storage & Audit Layer, "Regional Data Storage & Audit Layer", "Cloud SQL, BigQuery")

Rel(Telehealth API Handler, Consent & Policy Engine, "Evaluates requests against access and data residency policies")
Rel(Telehealth API Handler, Session & Prescription Orchestrator, "Delegates session coordination and prescription workflows")
Rel(Session & Prescription Orchestrator, AI Symptom Checker Service, "Communicates internally via mTLS-secured gRPC", "gRPC / mTLS")
Rel(Session & Prescription Orchestrator, E-Prescription Integrator, "Communicates internally via mTLS-secured gRPC", "gRPC / mTLS")
Rel(Session & Prescription Orchestrator, Regional Data Storage & Audit Layer, "Persists transactional data and audit logs within VPC Service Controls")

@enduml