@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the E-Prescription Integrator container

Container_Boundary(e_prescription_integrator, "E-Prescription Integrator") {
    Component(Prescription_Dispatcher_Controller, "Prescription Dispatcher Controller", "Java / Spring Boot", "Handles incoming gRPC requests for regional prescription dispatch from the Core Telehealth Service.")
    Component(Enterprise_Message_Router, "Enterprise Message Router", "Java / Spring Integration", "Routes and transforms prescription payloads for international pharmacy networks using HL7 FHIR and national EU formats.")
    Component(Pharmacy_Circuit_Breaker_Service, "Pharmacy Circuit Breaker Service", "Resilience4j", "Provides fault tolerance, circuit breakers, bulkheads, and rate-limiting for unstable regional pharmacy endpoints.")
    Component(Security_And_Token_Validator, "Security & Token Validator", "Spring Security / OAuth2 / JWT", "Validates OAuth2/JWT tokens and manages mTLS certificates via GCP Secret Manager for secure communication.")
    Component(Audit_Log_And_Storage_Connector, "Audit Log & Storage Connector", "Java / Spring Data JDBC", "Persists immutable audit logs to the Regional Data Storage & Audit Layer using VPC Service Controls.")
    Component(DLQ_Error_Buffer, "DLQ Error Buffer", "GCP Pub/Sub", "Buffers failed prescription transmission payloads using AES-256 encryption.")
}

Rel(Prescription_Dispatcher_Controller, Enterprise_Message_Router, "Passes validated prescription payload", "Java method invocation")
Rel(Enterprise_Message_Router, Pharmacy_Circuit_Breaker_Service, "Invokes external dispatch through resilience wrapper", "mTLS")
Rel(Security_And_Token_Validator, Prescription_Dispatcher_Controller, "Validates incoming tokens", "OAuth2/JWT")
Rel(Enterprise_Message_Router, Audit_Log_And_Storage_Connector, "Sends transaction audit trails", "VPC Service Controls")
Rel(Pharmacy_Circuit_Breaker_Service, DLQ_Error_Buffer, "Forwards failed payloads on persistent errors", "AES-256 encrypted")

@enduml