@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(ComplianceOfficers, "Compliance Officers", "External role querying audit trails.")
System_Ext(CoreTelehealthService, "Core Telehealth Service", "External service persisting patient records, consents, and session states.")
System_Ext(AISymptomCheckerService, "AI Symptom Checker Service", "External service appending immutable AI recommendation logs.")
System_Ext(EPrescriptionIntegrator, "E-Prescription Integrator", "External service persisting prescription audit logs.")

Container_Boundary(RegionalDataStorageAuditLayer, "Regional Data Storage & Audit Layer") {
    Component(TransactionalDatabase, "Transactional Database", "Cloud SQL for PostgreSQL", "Enforces Row-Level Security and JSONB indexing for regional transactional data and FHIR resources.")
    Component(AuditTraceabilityEngine, "Audit & Traceability Engine", "BigQuery", "Partitioned and clustered for high-performance compliance reporting and immutable AI audit trails.")
    Component(DataSyncResidencyEnforcer, "Data Sync & Residency Enforcer", "Cloud Dataflow / Pub/Sub", "Manages asynchronous regional data replication and strict residency enforcement.")
    Component(DataAccessLayer, "Data Access Layer", "gRPC API", "Provides secure internal gRPC read API for querying audit trails and patient data.")
}

Rel(CoreTelehealthService, TransactionalDatabase, "Persists patient records, consents, and session states", "gRPC/JDBC over VPC Service Controls")
Rel(AISymptomCheckerService, AuditTraceabilityEngine, "Appends immutable AI recommendation logs", "BigQuery Storage Write API over VPC Service Controls")
Rel(EPrescriptionIntegrator, TransactionalDatabase, "Persists prescription audit logs", "gRPC/JDBC over VPC Service Controls")
Rel(ComplianceOfficers, DataAccessLayer, "Queries audit trails and patient data", "secure internal gRPC read API")

@enduml