@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(video_session_manager, "Video Session Manager") {
    Component(Signaling_Server_Component, "Signaling Server Component", "Node.js / WebSockets", "Powers real-time session signaling, receives session control commands, and coordinates stream routing.")
    Component(Media_Gateway_Controller, "Media Gateway Controller", "C++ / WebRTC SFU / Mediasoup", "Implements WebRTC SFU for adaptive bitrate control and media stream management.")
    Component(Session_Audit_Logger_Component, "Session Audit Logger Component", "Node.js", "Logs session activities and persists metrics to the regional data storage layer.")
    Component(Session_State_Coordinator, "Session State Coordinator", "Memorystore for Redis", "Manages room states, tokens, and regional state caching for the 60-second reconnection grace window.")
    Component(Regional_Data_Storage_Audit_Layer, "Regional Data Storage & Audit Layer", "Cloud SQL, BigQuery", "Enforces strict regional data residency and persists session metrics and audit data.")
    Component(API_Gateway, "API Gateway", "Google Cloud", "Routes external session control commands to the signaling server.")
}

Rel(Signaling_Server_Component, Media_Gateway_Controller, "Coordinates stream routing", "In-Process / IPC")
Rel(Signaling_Server_Component, API_Gateway, "Receives session control commands", "gRPC")
Rel(Session_Audit_Logger_Component, Regional_Data_Storage_Audit_Layer, "Persists session metrics", "gRPC over VPC")
Rel(Signaling_Server_Component, Session_State_Coordinator, "Manages room states and tokens", "Redis Protocol / VPC")
Rel(Media_Gateway_Controller, Session_State_Coordinator, "Updates media states", "Redis Protocol / VPC")

@enduml