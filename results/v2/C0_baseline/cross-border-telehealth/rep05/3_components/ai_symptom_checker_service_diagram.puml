@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(ai_symptom_checker_service, "AI Symptom Checker Service") {
    Component(Intake_Normalization_Component, "Intake & Normalization Component", "Python / FastAPI on Cloud Run", "Handles initial intake of patient symptoms and normalizes data for processing.")
    Component(Inference_Explainability_Engine, "Inference & Explainability Engine", "Vertex AI", "Performs ML inference and provides explainability for symptom checks.")
    Component(Audit_Traceability_Component, "Audit & Traceability Component", "Python / FastAPI on Cloud Run", "Manages audit logging and traceability for medical safety and compliance.")
    Component(Handoff_Formatter_Component, "Handoff Formatter Component", "Python / FastAPI on Cloud Run", "Formats session data and symptom check results for clinician handoff.")
}

Rel(Intake_Normalization_Component, Inference_Explainability_Engine, "Sends normalized patient data for ML inference", "gRPC")
Rel(Inference_Explainability_Engine, Audit_Traceability_Component, "Records inference decisions for compliance and tracking", "")
Rel(Audit_Traceability_Component, Handoff_Formatter_Component, "Passes audited and formatted data for final clinician handoff", "")

@enduml