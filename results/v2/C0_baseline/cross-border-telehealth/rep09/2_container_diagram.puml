@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "Patients accessing secure video consultations, e-prescriptions, and the AI symptom checker.")
Person(LicensedClinicians, "Licensed Clinicians", "Licensed medical professionals providing telehealth consultations and issuing e-prescriptions.")
Person(ComplianceOfficersAuditors, "Compliance Officers / Auditors", "Personnel responsible for monitoring compliance, regional data residency, and audit trails.")

System_Ext(NationalEPrescriptionGatewaysEUandUSPharmacyNetworks, "National E-Prescription Gateways (EU) and US Pharmacy Networks", "External national and regional prescription networks.")

System_Boundary(CrossBorderTelehealthPlatform, "Cross-Border Telehealth Platform") {
    Container(RegionalIngress, "Regional Ingress", "Cloud Load Balancing & Envoy", "Manages regional traffic ingress and secure routing.")
    Container(WebMobileFrontend, "Web/Mobile Frontend", "Flutter", "Enables offline-first client state for low-bandwidth rural connections.")
    Container(TelehealthService, "Telehealth Service", "Go / WebRTC", "Manages low-latency media streams with global regional TURN relays.")
    Container(PrescriptionRecordService, "Prescription & Record Service", "Java / Spring Boot", "Abstracts fragmented EU and US e-prescription standards.")
    Container(AIOrchestratorAuditService, "AI Orchestrator & Audit Service", "Python / FastAPI", "Orchestrates AI symptom checker with immutable audit logging.")
    Container(ConsentIdentityService, "Consent & Identity Service", "Keycloak / PostgreSQL", "Manages identity, OAuth2/OIDC, and per-purpose GDPR/HIPAA consent.")
}

Rel(Patients, RegionalIngress, "Accesses video consultations, e-prescriptions, and AI symptom checker", "HTTPS / WSS")
Rel(LicensedClinicians, RegionalIngress, "Conducts secure video consultations and manages prescriptions", "HTTPS / WSS")
Rel(ComplianceOfficersAuditors, RegionalIngress, "Accesses audit logs and compliance controls", "HTTPS")
Rel(WebMobileFrontend, TelehealthService, "Streams video consultations", "WebRTC / UDP")
Rel(WebMobileFrontend, ConsentIdentityService, "Authenticates users and manages consent", "OAuth2/OIDC / HTTPS")
Rel(PrescriptionRecordService, NationalEPrescriptionGatewaysEUandUSPharmacyNetworks, "Sends prescription payloads", "HL7 FHIR / national standards")
Rel(AIOrchestratorAuditService, RegionalIngress, "Communicates internally via secure routing", "gRPC with mTLS")
Rel(TelehealthService, ConsentIdentityService, "Validates identity and authorization", "gRPC with mTLS")
Rel(PrescriptionRecordService, ConsentIdentityService, "Validates prescription access consent", "gRPC with mTLS")

@enduml