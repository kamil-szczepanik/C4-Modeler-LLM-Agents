@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "Patients in the EU and US accessing secure video consultations and the AI symptom checker.")
Person("Licensed Clinicians", "Licensed Clinicians", "Licensed medical professionals providing telehealth consultations and e-prescriptions.")

System("Cross-Border Telehealth Platform", "Cross-Border Telehealth Platform", "Provides secure video consultations, e-prescriptions, and an AI symptom checker for patients across the EU and US while enforcing strict regional data residency.")

System_Ext("National E-Prescription Gateways (EU) and US Pharmacy Networks", "National E-Prescription Gateways (EU) and US Pharmacy Networks", "External networks and gateways for processing national and regional e-prescriptions.")
System_Ext("AI Symptom Checker Engine", "AI Symptom Checker Engine", "Engine providing AI-driven symptom analysis with immutable audit traceability.")
System_Ext("Compliance / Regulatory Authorities and Medical Licensing Board Services", "Compliance / Regulatory Authorities and Medical Licensing Board Services", "External authorities and licensing boards ensuring regulatory compliance, medical licensing validation, and audit export.")

Rel(Patients, "Cross-Border Telehealth Platform", "Accesses video consultations, e-prescriptions, and AI symptom checker", "HTTPS/WebRTC (<300 kbit/s optimized)")
Rel("Licensed Clinicians", "Cross-Border Telehealth Platform", "Conducts secure video consultations and manages prescriptions", "HTTPS/WebRTC")
Rel("Cross-Border Telehealth Platform", "National E-Prescription Gateways (EU) and US Pharmacy Networks", "Sends e-prescription payloads", "mTLS with REST/FHIR")
Rel("Cross-Border Telehealth Platform", "AI Symptom Checker Engine", "Processes symptom check requests", "HTTPS/REST")
Rel("Cross-Border Telehealth Platform", "Compliance / Regulatory Authorities and Medical Licensing Board Services", "Validates medical licensing and exports secure audit logs", "OAuth2/mTLS and REST/HTTPS")

@enduml