@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(consent_identity_service, "Consent & Identity Service") {
    Component(Authentication_Engine, "Authentication Engine", "Keycloak", "Handles user authentication, OAuth2/OIDC protocols, and issues short-lived tokens.")
    Component(Consent_Management_Module, "Consent Management Module", "Keycloak Custom SPI", "Manages purpose-based GDPR and HIPAA consent records.")
    Component(Identity_Database, "Identity Database", "PostgreSQL (Cloud SQL)", "Persists user identity profiles, credentials, and consent data.")
    Component(Token_Cache, "Token Cache", "Redis (Memorystore)", "Provides low-latency token caching and revocation checks.")
}

Rel(Authentication_Engine, Identity_Database, "Queries and updates user and consent data", "JDBC / SQL")
Rel(Authentication_Engine, Token_Cache, "Checks token validity and revocation status", "Redis Protocol")
Rel(Consent_Management_Module, Identity_Database, "Stores and retrieves consent preferences", "JDBC / SQL")
@enduml