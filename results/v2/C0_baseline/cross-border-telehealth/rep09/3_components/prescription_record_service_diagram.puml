@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Prescription & Record Service container

Container_Boundary(prescription_and_record_service, "Prescription & Record Service") {
    Component(Prescription_API_Controller, "Prescription API Controller", "Spring MVC", "Responsible for processing, translating, and securely dispatching e-prescriptions.")
    Component(FHIR_National_Adapter_Engine, "FHIR / National Adapter Engine", "Spring Integration / Camel", "Bridges fragmented national e-prescription standards across the EU and US.")
    Component(Audit_Compliance_Logger, "Audit & Compliance Logger", "Spring AOP", "Strictly enforces data residency and patient consent mandates.")
    Component(Prescription_State_Idempotency_Manager, "Prescription State & Idempotency Manager", "Spring Data JPA / Redis", "Manages prescription state and ensures idempotency tokens are checked and stored.")
    Component(Consent_Identity_Service, "Consent & Identity Service", "Keycloak / PostgreSQL", "Supporting service for validating patient consent and OAuth 2.0 JWT tokens.")
    Component(Regional_Pub_Sub, "Regional Pub/Sub", "GCP", "Publishes asynchronous prescription payloads for decoupled dispatch.")
}

System_Ext(External_Gateways, "External Gateways", "National E-Prescription Gateways (EU) and US Pharmacy Networks")

Rel(Prescription_API_Controller, Consent_Identity_Service, "Validates patient consent and OAuth 2.0 JWT tokens", "gRPC with mTLS")
Rel(Prescription_API_Controller, Prescription_State_Idempotency_Manager, "Checks and stores idempotency tokens", "JDBC and Redis")
Rel(FHIR_National_Adapter_Engine, Regional_Pub_Sub, "Publishes asynchronous prescription payloads for decoupled dispatch", "Async")
Rel(FHIR_National_Adapter_Engine, External_Gateways, "Sends HL7 FHIR and national standard payloads", "outbound HTTPS/TLS 1.3 with mutual authentication")

@enduml