@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web/Mobile Frontend container

Container_Boundary(web_mobile_frontend, "Web/Mobile Frontend") {
    Component(Routing_State_Component, "Routing & State Component", "Hive/SQLite", "Manages local state and offline-first data persistence using SQLite/Hive with AES-256 encrypted via device hardware keystores.")
    Component(Video_Consultation_Component, "Video Consultation Component", "WebRTC / Flutter", "Handles video and audio consultation streaming supporting adaptive bitrate scaling.")
    Component(Consent_Triage_UI_Component, "Consent & Triage UI Component", "Flutter", "Provides user interfaces for managing granular consents and AI symptom check triage.")
    Component(Region_Aware_API_Client, "Region-Aware API Client", "Flutter / HTTPS", "Executes dynamic regional API pinning and communicates with backend services via Regional Ingress.")
}

System_Ext(Telehealth_Service, "Telehealth Service", "Handles video and audio consultation streaming")
System_Ext(AI_Orchestrator_Audit_Service, "AI Orchestrator & Audit Service", "Performs AI symptom check triage and logging")
System_Ext(Regional_Ingress, "Regional Ingress", "Cloud Load Balancing & Envoy")
System_Ext(Consent_Identity_Service, "Consent & Identity Service", "Keycloak/PostgreSQL")

Rel(Routing_State_Component, Region_Aware_API_Client, "Provides locally cached data and state sync", "Internal API")
Rel(Video_Consultation_Component, Telehealth_Service, "Streams video and audio consultations", "WebRTC / UDP")
Rel(Consent_Triage_UI_Component, AI_Orchestrator_Audit_Service, "Requests symptom check triage and recommendations", "HTTPS/REST")
Rel(Region_Aware_API_Client, Regional_Ingress, "Routes all API, WebSocket, and WebRTC traffic", "HTTPS, WebSockets, WebRTC / TLS 1.3")
Rel(Consent_Triage_UI_Component, Consent_Identity_Service, "Authenticates users and manages granular consents", "OAuth2/OIDC")

@enduml