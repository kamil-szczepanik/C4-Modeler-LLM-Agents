@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(regional_ingress, "Regional Ingress") {
    Component(GCP_Cloud_Armor, "GCP Cloud Armor", "Google Cloud Platform", "Provides edge-level DDoS defense, adaptive rate limiting, and geo-detection.")
    Component(Global_External_HTTPS_Load_Balancer, "Global External HTTP(S) Load Balancer", "GCP Load Balancing", "Forwards incoming TCP/HTTPS streams via internal VPC to the edge proxy.")
    Component(Envoy_Edge_Proxy, "Envoy Edge Proxy", "Envoy", "Handles TLS 1.3 termination, WebSocket upgrades, and traffic routing.")
    Component(Envoy_WASM_Route_Policy_Enforcer, "Envoy WASM Route & Policy Enforcer", "WASM Extension", "Invokes in-process synchronous inspection, custom policy enforcement, JWT validation, and geo-pinning.")
}

Rel(Global_External_HTTPS_Load_Balancer, Envoy_Edge_Proxy, "Forwards TCP/HTTPS streams via internal VPC", "TCP/HTTPS")
Rel(Envoy_Edge_Proxy, Envoy_WASM_Route_Policy_Enforcer, "Invokes in-process synchronous inspection", "In-process")
Rel(Envoy_WASM_Route_Policy_Enforcer, Downstream_Containers, "Routes verified traffic via gRPC and mTLS (SPIFFE/SPIRE)", "gRPC / mTLS")

@enduml