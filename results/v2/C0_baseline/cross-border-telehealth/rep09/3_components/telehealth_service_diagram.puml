@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Consent_and_Identity_Service, "Consent & Identity Service", "Keycloak / PostgreSQL")
System_Ext(Prescription_and_Record_Service, "Prescription & Record Service", "Java / Spring Boot")
System_Ext(Regional_TURN_Relays, "Regional TURN Relays", "Regional TURN infrastructure")

Container_Boundary(Telehealth_Service, "Telehealth Service") {
    Component(Signaling_Component, "Signaling Component", "Go / WebRTC", "Handles signaling and session establishment for video consultations.")
    Component(Media_Gateway, "Media Gateway", "SFU / Pion", "Manages media streams and relaying for video consultations.")
    Component(Bandwidth_Adaptation_Engine, "Bandwidth Adaptation Engine", "Go", "Adapts media bandwidth to maintain performance on unstable rural connections.")
    Component(Session_Audit_Logger, "Session Audit Logger", "Go", "Logs audit and compliance data for telehealth sessions.")
    Component(Session_Lifecycle_Manager, "Session Lifecycle Manager", "Go", "Manages the lifecycle of telehealth sessions, triggering metadata and feedback logs.")
}

Rel(Signaling_Component, Consent_and_Identity_Service, "Validates short-lived session tokens", "gRPC / mTLS")
Rel(Session_Lifecycle_Manager, Prescription_and_Record_Service, "Logs completed session metadata and feedback triggers", "gRPC")
Rel(Telehealth_Service, Regional_TURN_Relays, "Relays media streams under strict data residency constraints", "TLS/DTLS/SRTP")

@enduml