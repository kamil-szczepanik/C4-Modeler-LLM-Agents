@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients_and_Clinicians_EU_and_US, "Patients and Clinicians (EU & US)", "Patients and clinicians accessing video consultations, e-prescriptions, and AI symptom checker.")
System_Ext(Pharmacies_and_Platform_Administrators, "Pharmacies and Platform Administrators", "External systems and administrative roles interacting with the platform.")
System_Ext(National_E_Prescription_Gateways_EU_and_US_Pharmacy_Systems, "National E-Prescription Gateways (EU) & US Pharmacy Systems", "External systems for processing e-prescriptions using national formats and HL7 FHIR.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(Client_Applications, "Client Applications", "Flutter / Web", "Client applications providing user interfaces for patients and clinicians.")
    Container(API_Gateway, "API Gateway", "Envoy / Google Cloud Endpoints", "Routes and manages incoming client requests to internal microservices.")
    Container(Core_Telehealth_Service, "Core Telehealth Service", "Go", "Handles core telehealth business logic and backend services.")
    Container(AI_Inference_Service, "AI Inference Service", "Python / FastAPI", "Provides AI symptom checking and processes regional model artifacts.")
    Container(Interoperability_Service, "Interoperability Service", "Java / Spring Boot", "Handles integration with national e-prescription gateways and pharmacy systems.")
    Container(Containerized_SFUs, "Containerized SFUs", "mediasoup", "Manages real-time video streams for consultations with low-bandwidth resilience.")
    Container(Google_Kubernetes_Engine_GKE, "Google Kubernetes Engine (GKE)", "GCP (europe-west3, us-central1), Istio", "Orchestration platform and service mesh enforcing mTLS and secure regional workloads.")
    ContainerDb(PostgreSQL_Databases, "PostgreSQL Databases", "PostgreSQL with CMEK", "Stores relational data securely with Customer-Managed Encryption Keys.")
}

Rel(Patients_and_Clinicians_EU_and_US, Client_Applications, "Accesses telehealth platform capabilities", "HTTPS / WebRTC")
Rel(Client_Applications, API_Gateway, "Sends requests to the backend", "gRPC and HTTPS")
Rel(API_Gateway, Core_Telehealth_Service, "Routes core business requests", "gRPC over Istio mTLS mesh")
Rel(API_Gateway, AI_Inference_Service, "Routes AI symptom check requests", "gRPC over Istio mTLS mesh")
Rel(API_Gateway, Interoperability_Service, "Routes interoperability and prescription requests", "gRPC over Istio mTLS mesh")
Rel(API_Gateway, Containerized_SFUs, "Routes video stream control and media handling", "gRPC over Istio mTLS mesh")
Rel(Interoperability_Service, National_E_Prescription_Gateways_EU_and_US_Pharmacy_Systems, "Transmits and retrieves prescription data", "National formats and HL7 FHIR")
Rel(AI_Inference_Service, PostgreSQL_Databases, "Persists and retrieves data securely", "CMEK encrypted connection")
Rel(Core_Telehealth_Service, PostgreSQL_Databases, "Persists and retrieves data securely", "CMEK encrypted connection")

@enduml