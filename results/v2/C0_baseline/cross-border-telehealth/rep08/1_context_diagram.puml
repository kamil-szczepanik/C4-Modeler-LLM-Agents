@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_EU_US, "Patients (EU & US)", "Patients using Mobile/Web Clients to access video consultations, e-prescriptions, and the AI symptom checker.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Clinicians using the Clinician Portal to conduct video consultations and manage patient care.")
System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "Provides video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and US while ensuring strict data residency, regulatory compliance, and high availability.")
System_Ext(National_E_Prescription_Gateways_EU_US_Pharmacy_Systems, "National E-Prescription Gateways (EU) & US Pharmacy Systems", "External systems for processing e-prescriptions via HL7 FHIR.")
System_Ext(Identity_Providers_EU_eIDAS_US_OAuth2, "Identity Providers (EU eIDAS / US OAuth2)", "External identity providers for authentication using OIDC.")
System_Ext(EU_US_Regulatory_Auditing_Bodies, "EU/US Regulatory & Auditing Bodies", "Bodies receiving secure export data for regulatory and auditing purposes.")

Rel(Patients_EU_US, Cross_Border_Telehealth_Platform, "Accesses video consultations, e-prescriptions, and AI symptom checker", "HTTPS / WebRTC (TLS 1.3) with regional Anycast edge routing")
Rel(Licensed_Clinicians, Cross_Border_Telehealth_Platform, "Manages patient consultations and clinical workflows via Clinician Portal", "HTTPS / WebRTC (TLS 1.3) with regional Anycast edge routing")
Rel(Cross_Border_Telehealth_Platform, National_E_Prescription_Gateways_EU_US_Pharmacy_Systems, "Transmits and retrieves e-prescription data", "REST / HL7 FHIR over mutual TLS (mTLS)")
Rel(Cross_Border_Telehealth_Platform, Identity_Providers_EU_eIDAS_US_OAuth2, "Authenticates users", "OIDC over HTTPS")
Rel(Cross_Border_Telehealth_Platform, EU_US_Regulatory_Auditing_Bodies, "Exports audit logs and compliance data", "Secure export API (HTTPS/SFTP) with regional data-residency filters")
@enduml