@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(interoperability_service, "Interoperability Service") {
    Component(FHIR_Translation_Engine, "FHIR Translation Engine", "Java / Spring Boot", "Translates regional health data formats into standard FHIR representations.")
    Component(EU_Gateway_Adapter_Module, "EU Gateway Adapter Module", "Java / Spring Boot", "Adapts payloads for integration with external National E-Prescription Gateways in the EU.")
    Component(Consent_Policy_Enforcement_Interceptor, "Consent & Policy Enforcement Interceptor", "Java / Spring Boot", "Validates consent and enforces regional data access policies.")
    Component(Async_Dispatch_DLQ_Manager, "Async Dispatch & DLQ Manager", "Java / Spring Boot, Resilience4j", "Manages asynchronous dispatch and persistent dead-letter queues for unrecoverable payloads.")
}

Rel(Consent_Policy_Enforcement_Interceptor, FHIR_Translation_Engine, "Dispatches validated payloads", "Spring Application Events")
Rel(Consent_Policy_Enforcement_Interceptor, EU_Gateway_Adapter_Module, "Dispatches validated payloads", "Spring Application Events")

@enduml