@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(Envoy_Proxy, "Envoy Proxy", "Envoy / Google Cloud Endpoints", "Handles TLS termination, global routing, rate limiting, and resilience at the gateway edge.")
    Component(Routing_Manager, "Routing Manager", "Envoy Route Configuration", "Directs incoming gRPC and HTTPS traffic to appropriate backend microservices over the Istio mesh.")
}

System_Ext(Core_Telehealth_Service, "Core Telehealth Service", "Go service handling core telehealth workflows.")
System_Ext(AI_Inference_Service, "AI Inference Service", "Python / FastAPI service handling AI symptom checks.")
System_Ext(Interoperability_Service, "Interoperability Service", "Java / Spring Boot service handling interoperability.")
System_Ext(Containerized_SFUs, "Containerized SFUs", "mediasoup SFUs for video consultations.")

Rel(Envoy_Proxy, Routing_Manager, "Forwards verified requests", "")
Rel(Routing_Manager, Core_Telehealth_Service, "Routes gRPC requests", "gRPC over Istio mTLS")
Rel(Routing_Manager, AI_Inference_Service, "Routes gRPC requests", "gRPC over Istio mTLS")
Rel(Routing_Manager, Interoperability_Service, "Routes gRPC requests", "gRPC over Istio mTLS")
Rel(Routing_Manager, Containerized_SFUs, "Routes gRPC requests", "gRPC over Istio mTLS")

@enduml