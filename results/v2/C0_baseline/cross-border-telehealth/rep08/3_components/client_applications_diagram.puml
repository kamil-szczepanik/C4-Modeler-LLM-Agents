@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Client Applications container

System_Ext(api_gateway, "API Gateway", "Envoy / Google Cloud Endpoints")
System_Ext(sfus, "Containerized SFUs (mediasoup)", "mediasoup SFU")

Container_Boundary(client_applications, "Client Applications") {
    Component(ui_layer, "UI Layer", "Flutter / Web", "Handles user presentation, captures inputs, and displays platform capabilities for patients and clinicians.")
    Component(local_state, "Local State & Storage Manager", "Hive / SQLite with SQLCipher", "Secures cached PHI and consent preferences at rest using device-derived encryption keys.")
    Component(network_sync, "Network & Sync Engine", "gRPC-Web / HTTPS with Certificate Pinning", "Communicates with dynamic region endpoints and manages data synchronization.")
    Component(webrtc_sdk, "WebRTC Client SDK", "ICE / DTLS / SRTP", "Streams real-time video and audio for low-latency consultations.")
    Component(localization, "Localization & Accessibility Engine", "Flutter Localization", "Supports multilingual capabilities and accessibility features across regions.")
}

Rel(ui_layer, api_gateway, "Sends structured API requests", "gRPC-Web / HTTPS")
Rel(network_sync, api_gateway, "Communicates with dynamic region endpoints", "gRPC-Web / HTTPS with Certificate Pinning")
Rel(webrtc_sdk, sfus, "Streams video and audio", "ICE / DTLS / SRTP")
Rel(ui_layer, local_state, "Reads and writes cached data", "Encrypted Local I/O")
@enduml