@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL Databases container

Person(Core Telehealth Service, "Core Telehealth Service", "External service")
Person(AI Inference Service, "AI Inference Service", "External service")

Container_Boundary(PostgreSQL Databases, "PostgreSQL Databases") {
    Component(Cloud SQL Auth Proxy, "Cloud SQL Auth Proxy", "Sidecar proxy", "Secures database transport without static passwords using mTLS.")
    Component(PgBouncer, "PgBouncer", "Connection pooler", "Manages and optimizes database connections.")
    Component(Cloud SQL for PostgreSQL, "Cloud SQL for PostgreSQL", "Relational storage engine", "Managed relational database ensuring enterprise availability and point-in-time recovery, region-isolated in europe-west3 and us-central1.")
    Component(Schemas, "Schemas", "PostgreSQL Schemas (core_domain, consent_ledger, ai_audit)", "Organizes data for core domain, consent tracking, and AI audit logging.")
}

Rel(Core Telehealth Service, Cloud SQL Auth Proxy, "Persists and retrieves patient and consultation data", "TCP port 5432 using TLS 1.3")
Rel(AI Inference Service, Cloud SQL Auth Proxy, "Stores symptom checker inputs, outputs, and model versions", "TCP port 5432 using TLS 1.3")
Rel(Cloud SQL Auth Proxy, PgBouncer, "Forwards connections", "")
Rel(PgBouncer, Cloud SQL for PostgreSQL, "Routes queries", "")
Rel(Cloud SQL for PostgreSQL, Schemas, "Contains", "")

@enduml