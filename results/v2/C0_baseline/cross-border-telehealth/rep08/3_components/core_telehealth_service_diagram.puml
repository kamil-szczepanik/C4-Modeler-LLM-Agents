@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Telehealth Service container

Container_Boundary(core_telehealth_service, "Core Telehealth Service") {
    Component(Consultation & Scheduling Component, "Consultation & Scheduling Component", "Go", "Manages video consultation sessions and appointment scheduling workflows.")
    Component(Consent & Audit Engine, "Consent & Audit Engine", "Go", "Handles patient consent tracking and rigorous audit logging for compliance.")
    Component(Data Residency Proxy, "Data Residency Proxy", "Go", "Enforces strict regional data residency rules for EU and US patient data.")
    Component(Prescription & Interoperability Orchestrator, "Prescription & Interoperability Orchestrator", "Go", "Orchestrates e-prescriptions and coordinates data exchange with external interoperability systems.")
}

System_Ext(Interoperability_Service, "Interoperability Service", "Java / Spring Boot service for interoperability.")
System_Ext(Regional_PostgreSQL_Databases, "Regional PostgreSQL Databases", "PostgreSQL with CMEK and Field-Level Encryption.")

Rel(Prescription & Interoperability Orchestrator, Interoperability_Service, "Sends prescription data", "gRPC over Istio mTLS")
Rel(Consultation & Scheduling Component, Regional_PostgreSQL_Databases, "Persists and retrieves encrypted data", "CMEK and FLE encrypted connections")
Rel(Consent & Audit Engine, Regional_PostgreSQL_Databases, "Persists and retrieves encrypted data", "CMEK and FLE encrypted connections")
Rel(Data Residency Proxy, Regional_PostgreSQL_Databases, "Persists and retrieves encrypted data", "CMEK and FLE encrypted connections")
Rel(Prescription & Interoperability Orchestrator, Regional_PostgreSQL_Databases, "Persists and retrieves encrypted data", "CMEK and FLE encrypted connections")

@enduml