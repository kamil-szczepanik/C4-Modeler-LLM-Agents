@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Containerized SFUs container

Container_Boundary(containerized_sfus, "Containerized SFUs") {
    Component(Signaling_Room_Manager, "Signaling & Room Manager", "Node.js / TypeScript", "Manages signaling, room management, and worker lifecycle control via WebSockets and local IPC.")
    Component(Media_Router_Worker_Bandwidth_Adaptation_Engine, "Media Router Worker & Bandwidth Adaptation Engine", "C++ / mediasoup", "High-performance WebRTC media routing and simulcast/SVC stream adaptation for bandwidth resilience.")
}

Rel(Signaling_Room_Manager, Media_Router_Worker_Bandwidth_Adaptation_Engine, "Communicates via local Unix sockets for inter-process communication (IPC)", "Unix Socket")

@enduml