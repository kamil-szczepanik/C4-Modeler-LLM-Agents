@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(gke, "Google Kubernetes Engine (GKE)") {
    Component(Ingress_Controller__API_Gateway, "Ingress Controller & API Gateway", "Envoy / Istio Ingress", "Manages incoming external client traffic via HTTPS/WSS and routes to internal services.")
    Component(Workload_Pods, "Workload Pods", "Go, Python, Java", "Executes core telehealth business logic, e-prescriptions, and media handling.")
    Component(Policy___Admission_Controller, "Policy & Admission Controller", "OPA Gatekeeper / Kubernetes ValidatingWebhook", "Programmatically enforces regional data residency and compliance constraints.")
    Component(Autoscalers, "Autoscalers", "Cluster Autoscaler & Kubernetes HPA", "Ensures automated scaling and high availability for continuous service.")
    Component(Runtime_Security_Component, "Runtime Security Component", "Falco DaemonSet", "Provides runtime kernel monitoring for security enforcement.")
    Component(OpenTelemetry_Collectors, "OpenTelemetry Collectors", "OpenTelemetry DaemonSet", "Collects and streams telemetry data to cloud logging.")
    Component(Secret_Store_CSI_Driver, "Secret Store CSI Driver", "Google Secret Manager / HashiCorp Vault", "Secures and injects sensitive configuration and credentials.")
}

Rel(Ingress_Controller__API_Gateway, Workload_Pods, "Routes external client traffic", "gRPC/mTLS over Istio service mesh")
Rel(Workload_Pods, Secret_Store_CSI_Driver, "Retrieves secrets and keys securely", "")
Rel(OpenTelemetry_Collectors, Workload_Pods, "Streams telemetry from workloads", "")
@enduml