@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Inference Service container

Container_Boundary(ai_inference_service_boundary, "AI Inference Service") {
    Component(ai_inference_engine, "AI Inference Engine", "Python / FastAPI / ONNX Runtime / PyTorch", "Executes localized model inference for the AI symptom checker.")
    Component(safety_guardrail_controller, "Safety Guardrail Controller", "spaCy / Regex", "Performs synchronous safety guardrail checks and keyword filtering on inputs.")
}

Rel(safety_guardrail_controller, ai_inference_engine, "Passes filtered and validated inputs for model execution")

@enduml