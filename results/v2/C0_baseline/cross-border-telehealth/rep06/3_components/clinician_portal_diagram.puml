@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Clinician Portal container

Container_Boundary(clinician_portal, "Clinician Portal") {
    Component(Clinician UI Router, "Clinician UI Router", "React Router", "Manages client-side routing and navigation for clinician workflows.")
    Component(Authentication & Session Module, "Authentication & Session Module", "OAuth2/OIDC, HttpOnly Cookies", "Handles secure clinician login, token management, and session enforcement for HIPAA and GDPR compliance.")
    Component(Video Consultation Controller, "Video Consultation Controller", "React, WebRTC (SRTP/DTLS)", "Interfaces with LiveKit/WebRTC media relays to establish and manage video consultation streams.")
    Component(API Integration Client, "API Integration Client", "Axios / HTTPS", "Communicates securely with the API Gateway to manage clinician requests, workflows, and patient data.")
}

System_Ext(LiveKit/WebRTC Media Relays, "LiveKit/WebRTC Media Relays", "External media relay system for video consultations")
System_Ext(API Gateway, "API Gateway", "External API Gateway (Envoy / Kong)")

Rel(Clinician UI Router, Authentication & Session Module, "Validates session state and permissions", "OAuth2/OIDC")
Rel(Clinician UI Router, Video Consultation Controller, "Loads video consultation interface", "")
Rel(Clinician UI Router, API Integration Client, "Triggers data fetching and workflow submissions", "")
Rel(Authentication & Session Module, API Integration Client, "Injects auth tokens into API requests", "")
Rel(Video Consultation Controller, LiveKit/WebRTC Media Relays, "Establishes video consultation streams", "SRTP/DTLS via TURN/STEF")
Rel(API Integration Client, API Gateway, "Manages clinician workflows and requests", "HTTPS/WSS via OAuth2/OIDC, mTLS")

@enduml