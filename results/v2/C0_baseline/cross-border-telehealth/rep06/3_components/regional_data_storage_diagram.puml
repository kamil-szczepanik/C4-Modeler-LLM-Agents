@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(regional_data_storage, "Regional Data Storage") {
    Component(Transaction_Database, "Transaction Database", "Cloud Spanner / Cloud SQL PostgreSQL", "Regional transaction databases ensuring ACID compliance and data residency.")
    Component(Sync_Conflict_Resolution_Engine, "Sync & Conflict Resolution Engine", "Python / Go on GKE", "Synchronizes offline payloads and persists synchronized records.")
    Component(Audit_WORM_Ledger, "Audit & WORM Ledger", "Cloud Storage with Object Retention / BigQuery", "WORM ledger storage providing immutable, tamper-proof audit logs.")
    Component(Key_Management_Module, "Key Management Module", "Cloud KMS", "Regional Customer-Managed Encryption Keys (CMEK) ensuring cryptographic data isolation between EU and US.")
    Component(Data_Access_Proxy, "Data Access Proxy", "Go / Envoy", "High-performance proxy enforcing tenant-isolated, row-level secured queries.")
}

Rel(Data_Access_Proxy, Transaction_Database, "Executes tenant-isolated, row-level secured queries", "SQL")
Rel(Data_Access_Proxy, Audit_WORM_Ledger, "Asynchronously streams read/write access logs", "Pub/Sub / gRPC")
Rel(Sync_Conflict_Resolution_Engine, Transaction_Database, "Persists synchronized records", "SQL")

@enduml