@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Interoperability & E-Prescription Adapter container

Container_Boundary(interoperability_eprescription_adapter, "Interoperability & E-Prescription Adapter") {
    Component(FHIRTranslationEngine, "FHIR Translation Engine", "Python / Go", "Translates and standardizes medical data formats into HL7 FHIR for seamless cross-border interoperability.")
    Component(EUGatewayTranslator, "EU Gateway Translator", "Python / Go", "Adapts and formats prescription payloads specifically for EU National E-Prescription Gateways.")
    Component(RegionalRoutingDispatcher, "Regional Routing Dispatcher", "Python / Go", "Validates and routes regional transactions while ensuring strict data residency compliance.")
    Component(OutboxRetryDispatcher, "Outbox & Retry Dispatcher", "Python / Go, Cloud Pub/Sub", "Manages asynchronous outbox queuing and reliable payload delivery to external pharmacy networks.")
    Component(SecureDLQHandler, "Secure DLQ Handler", "Python / Go", "Handles failed message deliveries and ensures zero prescription loss via Dead-Letter Queues.")
    Component(mTLSPolicyEnforcementProxy, "mTLS & Policy Enforcement Proxy", "Envoy Sidecar", "Enforces mutual TLS (mTLS) and validates OIDC clinician license claims for secure communication.")
}

System_Ext(RegionalDataStorage, "Regional Data Storage", "Regional databases and storage systems")
System_Ext(EUNationalEPrescriptionGatewaysUSPharmacyNetworks, "EU National E-Prescription Gateways & US Pharmacy Networks", "External pharmacy and gateway networks")

Rel(RegionalRoutingDispatcher, RegionalDataStorage, "Validates and logs transaction audits", "SQL / TLS")
Rel(OutboxRetryDispatcher, EUNationalEPrescriptionGatewaysUSPharmacyNetworks, "Delivers payloads", "HTTPS / mTLS")
Rel(FHIRTranslationEngine, EUGatewayTranslator, "Transmits translated medical data payloads", "")

@enduml