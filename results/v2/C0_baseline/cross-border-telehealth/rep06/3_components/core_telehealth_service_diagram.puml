@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Telehealth Service container

Container_Boundary(core_telehealth_service, "Core Telehealth Service") {
    Component(SessionOrchestrator, "Session Orchestrator", "Go", "Manages telehealth sessions, coordinates video consultation streams, and handles session lifecycle.")
    Component(ConsentInterceptor, "Consent Interceptor", "Go / gRPC", "Validates real-time patient consent tokens by communicating with the Consent & Privacy Management Container.")
    Component(AuditLogger, "Audit Logger", "Go", "Records audit logs for compliance, security tracking, and regulatory requirements (GDPR, HIPAA).")
    Component(ABACPolicyEngine, "ABAC Policy Engine", "Open Policy Agent (OPA)", "Queries and evaluates access rights and consent scopes using attribute-based access control.")
    Component(GracefulStateManager, "Graceful State Manager", "Go / Redis", "Manages transient session states and provides resilience during degraded connectivity.")
}

System_Ext(LiveKitWebRTCMediaRelays, "LiveKit/WebRTC Media Relays", "TURN / STEF")
System_Ext(ConsentPrivacyManagementContainer, "Consent & Privacy Management Container", "Container")
System_Ext(RegionalDataStorage, "Regional Data Storage", "Cloud SQL / Cloud Spanner / Cloud KMS / Redis")

Rel(SessionOrchestrator, LiveKitWebRTCMediaRelays, "Manages video consultation streams", "SRTP / DTLS")
Rel(ConsentInterceptor, ConsentPrivacyManagementContainer, "Validates real-time patient consent tokens", "gRPC / mTLS")
Rel(SessionOrchestrator, ABACPolicyEngine, "Queries access rights and consent scopes", "In-memory Go function call / Open Policy Agent")
Rel(SessionOrchestrator, RegionalDataStorage, "Reads and writes regionally-scoped patient data and session states", "SQL / Redis / Cloud KMS")
Rel(GracefulStateManager, RegionalDataStorage, "Persists and synchronizes transient session states", "Redis")

@enduml