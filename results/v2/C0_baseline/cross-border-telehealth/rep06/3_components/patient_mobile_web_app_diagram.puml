@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient Mobile/Web App container

Container_Boundary(patient_app, "Patient Mobile/Web App") {
    Component(UI_Presentation_Layer, "UI Presentation Layer", "Flutter / React", "Renders the cross-platform user interface for patients across the EU and US.")
    Component(State___Local_Persistence_Manager, "State & Local Persistence Manager", "SQLite / Secure Local Storage", "Manages encrypted local data storage and offline queuing for rural areas.")
    Component(API_Client___Auth_Module, "API Client & Auth Module", "Dio / Axios with OIDC/OAuth2", "Handles secure token exchange, authentication, and API requests.")
    Component(WebRTC_Media_Client, "WebRTC Media Client", "LiveKit SDK", "Manages low-bandwidth video streaming with audio-only fallback modes.")
    Component(Localization___Accessibility_Engine, "Localization & Accessibility Engine", "i18next / Flutter Localization", "Provides localized and accessible UI components.")
    Component(Post_Consultation___E_Prescription_Viewer, "Post-Consultation & E-Prescription Viewer", "Cross-platform UI Component", "Displays cached consultation summaries and prescription metadata.")
}

Rel(UI_Presentation_Layer, Localization___Accessibility_Engine, "Renders localized, accessible UI components", "In-memory")
Rel(State___Local_Persistence_Manager, Post_Consultation___E_Prescription_Viewer, "Supplies cached summaries and prescription metadata", "In-memory")

@enduml