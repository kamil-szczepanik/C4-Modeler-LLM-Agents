@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Consent_Privacy_Management_Container", "Consent & Privacy Management Container") {
    Component(Consent_API_Controller, "Consent API Controller", "Python / Go", "Exposes endpoints for managing consent and privacy calls.")
    Component(Policy_Decision_Engine_OPA_, "Policy Decision Engine (OPA)", "Open Policy Agent (OPA)", "Evaluates real-time access requests against stored consent rules for low-latency decisioning.")
    Component(Cryptographic_Token_Service, "Cryptographic Token Service", "Python / Go, Cloud KMS", "Secures regional JWT token signing, KMS rotation, and key management.")
    Component(Audit___Ledger_Logger, "Audit & Ledger Logger", "Python / Go", "Logs consent and privacy operations for auditing purposes.")
    Component(Revocation_Publisher, "Revocation Publisher", "Redis Memorystore, Pub/Sub", "Publishes revocation events using Redis Pub/Sub for real-time invalidation.")
}

Rel(Consent_API_Controller, Policy_Decision_Engine_OPA_, "Evaluates access requests via gRPC / mTLS", "")
Rel(Consent_API_Controller, Cryptographic_Token_Service, "Requests token signing and key operations", "")
Rel(Consent_API_Controller, Audit___Ledger_Logger, "Sends audit logs", "")
Rel(Consent_API_Controller, Revocation_Publisher, "Publishes revocation events via Redis Pub/Sub", "")
@enduml