@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Regional_API_Gateway, "Regional API Gateway", "Envoy", "Enables edge routing, WASM/Lua filters, and compression across europe-west3 and us-central1.")
    Component(WAF_Inspection, "WAF Inspection", "Google Cloud Armor", "Inspects incoming HTTPS traffic for security threats at the edge.")
    Component(Rate_Limiting_Store, "Rate Limiting Store", "Redis", "Distributed cache supporting rate limiting and quota controls.")
    Component(OpenTelemetry_Collectors, "OpenTelemetry Collectors", "OpenTelemetry", "Collects distributed traces and audit logs asynchronously.")
}

Rel(Regional_API_Gateway, WAF_Inspection, "Inspects traffic", "HTTPS")
Rel(Regional_API_Gateway, Rate_Limiting_Store, "Queries rate limits and quotas")
Rel(Regional_API_Gateway, OpenTelemetry_Collectors, "Sends telemetry and audit logs", "OTLP / gRPC, Async")

@enduml