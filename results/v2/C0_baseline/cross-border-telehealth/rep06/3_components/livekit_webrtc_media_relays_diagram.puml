@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the LiveKit/WebRTC Media Relays container

Container_Boundary(media_relays, "LiveKit/WebRTC Media Relays") {
    Component(TURN_STUN_Server, "TURN/STUN Server", "Coturn", "Provides NAT traversal and connection establishment for patients and clinicians.")
    Component(SFU_Media_Router, "SFU Media Router", "LiveKit (Go)", "Routes adaptive sub-300 kbit/s video streams for real-time telehealth consultations.")
    Component(Telemetry_Stats_Exporter, "Telemetry & Stats Exporter", "Prometheus exporter", "Emits network metrics and stream statistics for monitoring session quality.")
}

Rel(SFU_Media_Router, Telemetry_Stats_Exporter, "Emits network metrics", "Internal IPC / Prometheus scrape")

@enduml