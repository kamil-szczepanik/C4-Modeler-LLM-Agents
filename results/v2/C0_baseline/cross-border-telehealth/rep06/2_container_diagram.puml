@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients_EU_US, "Patients (EU & US)", "Access video consultations, manage consent, and use AI symptom checking.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Deliver care and review patient histories.")
Person(Pharmacy_Partners_and_Platform_Administrators_Compliance_Officers, "Pharmacy Partners and Platform Administrators / Compliance Officers", "Manage platform operations, pharmacy fulfillment, and regulatory compliance.")

System_Ext(EU_National_EPrescription_Gateways_US_Pharmacy_Networks, "EU National E-Prescription Gateways & US Pharmacy Networks", "External prescription fulfillment networks.")
System_Ext(AI_Inference_Service, "AI Inference Service", "External AI system providing urgency recommendations.")

System_Boundary(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform") {
    Container(Patient_MobileWeb_App, "Patient Mobile/Web App", "Flutter / React", "Client application for patients to access video consultations, e-prescriptions, and AI symptom checking.")
    Container(Clinician_Portal, "Clinician Portal", "React", "Portal for licensed clinicians to deliver care and review patient histories.")
    Container(API_Gateway, "API Gateway", "Envoy / Kong", "Manages incoming traffic, routing, and security policies.")
    Container(Core_Telehealth_Service, "Core Telehealth Service", "Python / Go on GKE", "Handles core business logic for telehealth consultations.")
    Container(Interoperability_EPrescription_Adapter, "Interoperability & E-Prescription Adapter", "Python / Go on GKE", "Connects with EU National E-Prescription Gateways and US Pharmacy Networks.")
    Container(Consent_Privacy_Management_Container, "Consent & Privacy Management Container", "Python / Go on GKE", "Manages patient privacy, regulatory compliance, and cryptographic consent tokens.")
    Container(AI_Orchestrator_Audit_Service, "AI Orchestrator & Audit Service", "Python / Go on GKE", "Orchestrates AI symptom checking requests, PII prompt sanitization, and immutable audit logging.")
    Container(LiveKitWebRTC_Media_Relays, "LiveKit/WebRTC Media Relays", "TURN / STEF (SRTP/DTLS)", "Provides adaptive sub-300 kbit/s video streaming for telehealth consultations.")
    ContainerDb(Regional_Data_Storage, "Regional Data Storage", "Cloud SQL (PostgreSQL), Cloud Spanner, Cloud KMS", "Provides regionally-scoped data storage with Customer-Managed Encryption Keys (CMEK) and WORM/BigQuery storage for audit logs.")
}

Rel(Patients_EU_US, Patient_MobileWeb_App, "Accesses telehealth services, video consultations, and AI symptom checker", "HTTPS/WSS")
Rel(Licensed_Clinicians, Clinician_Portal, "Accesses patient health records and conducts consultations", "HTTPS/WSS")
Rel(Patient_MobileWeb_App, API_Gateway, "Sends API requests and streams media", "HTTPS/WSS (OAuth2/OIDC, mTLS)")
Rel(Clinician_Portal, API_Gateway, "Sends API requests and manages clinician workflows", "HTTPS/WSS (OAuth2/OIDC, mTLS)")
Rel(API_Gateway, Core_Telehealth_Service, "Routes core telehealth API calls", "gRPC / mTLS (Istio Mesh)")
Rel(API_Gateway, Interoperability_EPrescription_Adapter, "Routes e-prescription and interoperability requests", "gRPC / mTLS (Istio Mesh)")
Rel(API_Gateway, Consent_Privacy_Management_Container, "Routes consent and privacy management calls", "gRPC / mTLS (Istio Mesh)")
Rel(API_Gateway, AI_Orchestrator_Audit_Service, "Routes AI symptom checking and audit requests", "gRPC / mTLS (Istio Mesh)")
Rel(Interoperability_EPrescription_Adapter, EU_National_EPrescription_Gateways_US_Pharmacy_Networks, "Fulfills prescriptions and interoperability workflows", "REST/HL7 FHIR over HTTPS/mTLS")
Rel(AI_Orchestrator_Audit_Service, AI_Inference_Service, "Sends sanitized prompts for urgency recommendations", "gRPC with local PII prompt sanitization")
Rel(Patient_MobileWeb_App, LiveKitWebRTC_Media_Relays, "Establishes video streams for consultations", "SRTP/DTLS (TURN/STEF)")
Rel(Clinician_Portal, LiveKitWebRTC_Media_Relays, "Establishes video streams for consultations", "SRTP/DTLS (TURN/STEF)")
Rel(Core_Telehealth_Service, Regional_Data_Storage, "Reads and writes regionally-scoped patient data", "SQL / Cloud KMS")
Rel(Consent_Privacy_Management_Container, Regional_Data_Storage, "Manages consent records and cryptographic keys", "SQL / Cloud KMS")
Rel(AI_Orchestrator_Audit_Service, Regional_Data_Storage, "Writes immutable audit logs", "WORM storage / BigQuery")

@enduml