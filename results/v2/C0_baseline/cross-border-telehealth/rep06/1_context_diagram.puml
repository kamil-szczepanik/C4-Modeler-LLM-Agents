@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients (EU & US)", "Access video consultations and manage consent.")
Person(Clinicians, "Licensed Clinicians", "Deliver care and review patient histories.")
System(Platform, "Cross-Border Telehealth Platform", "Provides secure video consultations, e-prescriptions, and an AI symptom checker for patients across the EU and US while enforcing strict regional data residency, regulatory compliance, and high availability.")
System_Ext(Pharmacies, "EU National E-Prescription Gateways & US Pharmacy Networks", "External prescription fulfillment systems.")
System_Ext(AIService, "AI Inference Service", "External system providing urgency recommendations.")

Rel(Patients, Platform, "Access video consultations and manage consent", "HTTPS and WebRTC (TLS 1.3 / DTLS-SRTP)")
Rel(Clinicians, Platform, "Deliver care and review patient histories", "HTTPS and WebRTC (TLS 1.3 / DTLS-SRTP)")
Rel(Platform, Pharmacies, "Fulfill prescriptions", "REST/FHIR and national standards over HTTPS/mTLS")
Rel(Platform, AIService, "Get urgency recommendations", "gRPC over TLS 1.3 with sidecar interception")

@enduml