@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "Patients in the EU and US seeking video consultations, e-prescriptions, and AI symptom checking.")
Person(Licensed_Clinicians, "Licensed Clinicians", "Medical professionals providing consultations and prescriptions.")
Person(Compliance___Audit_Officers, "Compliance & Audit Officers", "Officers responsible for reviewing audit logs and regulatory compliance.")

System(Cross_Border_Telehealth_Platform, "Cross-Border Telehealth Platform", "A cross-border telehealth platform providing video consultations, e-prescriptions, and an AI symptom checker for patients in the EU and US.")

System_Ext(Global_Identity_Provider__IdP_, "Global Identity Provider (IdP)", "Provides authentication and MFA services via OIDC/OAuth 2.0.")
System_Ext(Third_Party_National_E_Prescription_Gateways__EU_, "Third-Party National E-Prescription Gateways (EU)", "External national gateways for handling e-prescriptions in the EU.")
System_Ext(Pharmacy_Networks__US_, "Pharmacy Networks (US)", "External pharmacy networks for processing prescriptions in the US.")
System_Ext(Video_Relay_Codec_Service, "Video Relay/Codec Service", "Service supporting low-bandwidth video consultations and WebRTC.")
System_Ext(Clinician_Accreditation_Validator, "Clinician Accreditation Validator", "Service used to validate the credentials and accreditation of clinicians.")

Rel(Patients, Cross_Border_Telehealth_Platform, "Accesses video consultations and AI symptom checker via web or mobile.", "HTTPS / WebRTC")
Rel(Licensed_Clinicians, Cross_Border_Telehealth_Platform, "Conducts consultations and manages patient prescriptions.", "HTTPS / WebRTC")
Rel(Compliance___Audit_Officers, Cross_Border_Telehealth_Platform, "Accesses restricted regional systems for audit log review.", "Restricted HTTPS")
Rel(Cross_Border_Telehealth_Platform, Global_Identity_Provider__IdP_, "Authenticates users via OIDC/OAuth 2.0 with MFA.", "OIDC/OAuth 2.0 over HTTPS")
Rel(Cross_Border_Telehealth_Platform, Third_Party_National_E_Prescription_Gateways__EU_, "Transmits e-prescriptions for EU patients.", "mTLS REST / HL7 FHIR")
Rel(Cross_Border_Telehealth_Platform, Pharmacy_Networks__US_, "Transmits prescriptions for US patients.", "mTLS REST / HL7 FHIR")
@enduml