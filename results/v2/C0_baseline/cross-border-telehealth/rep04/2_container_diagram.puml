@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "Patients (EU and US) seeking video consultations, e-prescriptions, and AI symptom checking.")
Person(LicensedClinicians, "Licensed Clinicians", "Medical professionals providing video consultations and managing patient prescriptions.")

System_Ext(GlobalIdentityProviderIdP, "Global Identity Provider (IdP)", "External system providing authentication services via OIDC/OAuth 2.0.")
System_Ext(EUEPrescriptionGateways, "EU E-Prescription Gateways", "External national gateways for handling e-prescriptions in the EU.")
System_Ext(USPharmacyNetworks, "US Pharmacy Networks", "External pharmacy networks for processing prescriptions in the US.")
System_Ext(VideoRelayService, "Video Relay Service", "External service supporting video consultations.")

System_Boundary(CrossBorderTelehealthPlatform, "Cross-Border Telehealth Platform") {
    Container(WebMobileFrontendApp, "Web/Mobile Frontend App", "React / Flutter", "Frontend application accessed by patients and clinicians.")
    Container(APIGatewayCoreBackend, "API Gateway / Core Backend", "Go / Node.js", "Routes requests and handles core backend logic, securing regional data residency.")
    Container(AISymptomChecker, "AI Symptom Checker", "Python / FastAPI", "Provides AI-driven symptom checking with GCP Cloud HSM cryptographic output signing.")
    Container(InteroperabilityAdapter, "Interoperability Adapter", "Plugin architecture, REST / SOAP, HL7 FHIR", "Interfaces with external EU E-Prescription Gateways and US Pharmacy Networks.")
    Container(VideoSessionManager, "Video Session Manager", "WebRTC SFU", "Manages real-time video sessions for consultations.")
}

Rel(Patients, WebMobileFrontendApp, "Accesses video consultations, e-prescriptions, and AI symptom checker.", "HTTPS")
Rel(LicensedClinicians, WebMobileFrontendApp, "Conducts consultations and manages prescriptions.", "HTTPS")
Rel(WebMobileFrontendApp, APIGatewayCoreBackend, "Sends API requests and calls core services.", "HTTPS / gRPC")
Rel(WebMobileFrontendApp, VideoSessionManager, "Streams video consultations.", "WebRTC")
Rel(APIGatewayCoreBackend, AISymptomChecker, "Requests AI symptom analysis.", "mTLS / Internal API")
Rel(APIGatewayCoreBackend, InteroperabilityAdapter, "Triggers e-prescription routing.", "mTLS / Internal API")
Rel(InteroperabilityAdapter, EUEPrescriptionGateways, "Transmits EU e-prescriptions.", "REST / SOAP / HL7 FHIR")
Rel(InteroperabilityAdapter, USPharmacyNetworks, "Transmits US prescriptions.", "REST / SOAP / HL7 FHIR")
Rel(APIGatewayCoreBackend, GlobalIdentityProviderIdP, "Authenticates users.", "OAuth 2.0 / OIDC")
Rel(VideoSessionManager, VideoRelayService, "Relays video session data.", "WebRTC")

@enduml