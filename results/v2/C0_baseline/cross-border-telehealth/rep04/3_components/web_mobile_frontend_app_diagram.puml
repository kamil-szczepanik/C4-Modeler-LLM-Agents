@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web/Mobile Frontend App container

Container_Boundary(web_mobile_frontend_app, "Web/Mobile Frontend App") {
    Component(Routing_Shell_Component, "Routing & Shell Component", "React / Flutter", "Builds a responsive Progressive Web App and mobile interface supporting low-bandwidth conditions.")
    Component(Consent_Privacy_Manager_Component, "Consent & Privacy Manager Component", "React / Flutter", "Manages privacy preferences and ensures strict GDPR and HIPAA compliance.")
    Component(AI_Symptom_Checker_UI_Component, "AI Symptom Checker UI Component", "React / Flutter", "Provides the user interface for the AI symptom checker.")
    Component(Video_Streaming_Interface_Component, "Video Streaming Interface Component", "WebRTC SDKs", "Enables video streaming with adaptive bitrate controls for connections under 300 kbit/s.")
    Component(API_Client_Local_Storage_Adapter, "API Client & Local Storage Adapter", "AES-GCM / Secure Hardware", "Encrypts cached patient health data bound to device Keychain/Keystore and handles communication.")
}

System_Ext(Video_Session_Manager, "Video Session Manager", "External video session management service")
System_Ext(API_Gateway_Core_Backend, "API Gateway / Core Backend", "External core backend API gateway")

Rel(Routing_Shell_Component, Consent_Privacy_Manager_Component, "Manages UI state", "In-Memory")
Rel(Consent_Privacy_Manager_Component, API_Client_Local_Storage_Adapter, "Syncs consent states", "HTTPS/REST")
Rel(AI_Symptom_Checker_UI_Component, API_Client_Local_Storage_Adapter, "Sends symptom payloads", "HTTPS/gRPC")
Rel(Video_Streaming_Interface_Component, Video_Session_Manager, "Establishes media streams", "WebRTC")
Rel(API_Client_Local_Storage_Adapter, API_Gateway_Core_Backend, "Sends API requests", "HTTPS/gRPC")

@enduml