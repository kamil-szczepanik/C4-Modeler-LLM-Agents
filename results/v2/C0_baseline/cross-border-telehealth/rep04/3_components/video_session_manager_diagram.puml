@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Video Session Manager container

Container_Boundary(video_session_manager, "Video Session Manager") {
    Component(SFU_Media_Router, "SFU Media Router", "Mediasoup / C++ & Node.js", "High-performance WebRTC packet forwarding with simulcast and adaptive bitrate support.")
    Component(Session_Signaling_Controller, "Session Signaling Controller", "Go", "Low-latency signaling control and session management.")
    Component(Session_Audit_Metadata_Logger, "Session Audit & Metadata Logger", "Go", "Audit logging and telemetry persistence for compliance and metadata.")
    Component(Session_State_Cache, "Session State Cache", "Redis / GCP Memorystore", "In-memory ephemeral session caching with automated 60-second TTL.")
}

Component(Web_Mobile_Frontend_App, "Web/Mobile Frontend App", "React / Flutter", "Frontend interface handling user WebRTC streaming and WebSocket signaling.")
System_Ext(Regional_GCP_Databases, "Regional GCP Databases", "SQL", "Regional databases for telemetry and metadata persistence.")

Rel(Web_Mobile_Frontend_App, Session_Signaling_Controller, "WebSocket signaling and authentication", "WSS over TLS 1.3, JSON")
Rel(Web_Mobile_Frontend_App, SFU_Media_Router, "Video/audio streaming and adaptive bitrate controls", "WebRTC, UDP/SRTP, DTLS-SRTP")
Rel(Session_Signaling_Controller, Session_State_Cache, "Ephemeral session and reconnection state management", "TCP, Redis Protocol")
Rel(SFU_Media_Router, Session_State_Cache, "Transport state verification for ICE restarts", "TCP, Redis Protocol")
Rel(Session_Audit_Metadata_Logger, Regional_GCP_Databases, "Telemetry and metadata persistence", "TCP, SQL")

@enduml