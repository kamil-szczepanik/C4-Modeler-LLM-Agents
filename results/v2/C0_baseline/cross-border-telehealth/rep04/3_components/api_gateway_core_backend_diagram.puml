@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway / Core Backend container

Container_Boundary(api_gateway_core_backend, "API Gateway / Core Backend") {
    Component(API_Gateway_Router, "API Gateway Router", "Go / Node.js", "Routes incoming API requests, enforces regional data isolation, and handles consent management at the gateway layer.")
    Component(Idempotency_Retry_Coordinator, "Idempotency & Retry Coordinator", "Go / Node.js with Regional Redis Cache", "Manages safe transaction retries without cross-border data leaks.")
}

Rel(API_Gateway_Router, Idempotency_Retry_Coordinator, "Delegates request tracking and transaction retry logic", "Internal")

@enduml