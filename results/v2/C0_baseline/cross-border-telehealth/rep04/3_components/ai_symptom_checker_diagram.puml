@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Symptom Checker container

Container_Boundary(ai_symptom_checker, "AI Symptom Checker") {
    Component(Triage_API_Controller, "Triage API Controller", "Python / FastAPI", "Requests AI symptom analysis, manages routing, and coordinates inference, fallback, and auditing.")
    Component(Inference_Engine, "Inference Engine", "Python / PyTorch or ONNX Runtime", "Executes the clinical model for symptom analysis.")
    Component(Clinical_Fallback_Engine, "Clinical Fallback Engine", "Python / Rule-based Logic", "Invokes fallback procedures on model failure or timeout.")
    Component(Audit_Cryptographic_Signer, "Audit & Cryptographic Signer", "Python / GCP KMS / Cloud HSM Client", "Offloads and cryptographically signs event logs using GCP Cloud HSM / KMS.")
}

Rel(Triage_API_Controller, Inference_Engine, "Executes clinical model", "In-memory / gRPC")
Rel(Triage_API_Controller, Clinical_Fallback_Engine, "Invokes fallback on model failure/timeout", "In-memory")
Rel(Triage_API_Controller, Audit_Cryptographic_Signer, "Offloads event logs", "Async Message Queue")

@enduml