@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(EndCustomersAndBrokers, "End Customers & Brokers", "External users submitting claims online.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal users processing claims via the new web application.")
Person(MigrationOperationsLead, "Migration Operations Lead", "Specialized user monitoring incremental cutovers and rollbacks.")

System(InsuranceClaimsModernizationPlatform, "Insurance Claims Modernization Platform", "Cloud-native target system hosted in Azure West Europe that gradually replaces a legacy mainframe claims system by migrating claim types incrementally.")

System_Ext(LegacyMainframeSystem, "Legacy Mainframe System", "On-premises COBOL/DB2 system of record.")
System_Ext(CorporateActiveDirectory, "Corporate Active Directory", "On-premises identity provider.")
System_Ext(ThirdPartyPaymentGateway, "Third-Party Payment Gateway", "External system handling outbound payouts.")

Rel(EndCustomersAndBrokers, InsuranceClaimsModernizationPlatform, "Online claim submission", "HTTPS/REST")
Rel(ClaimsAdjusters, InsuranceClaimsModernizationPlatform, "Web UI access", "HTTPS")
Rel(InsuranceClaimsModernizationPlatform, LegacyMainframeSystem, "Dual-run synchronization", "MQ/Batch/API with mTLS")
Rel(LegacyMainframeSystem, InsuranceClaimsModernizationPlatform, "Dual-run synchronization", "MQ/Batch/API with mTLS")
Rel(InsuranceClaimsModernizationPlatform, CorporateActiveDirectory, "Single Sign-On authentication", "OIDC/SAML")
Rel(InsuranceClaimsModernizationPlatform, ThirdPartyPaymentGateway, "Outbound payouts", "HTTPS/REST with OAuth 2.0")
@enduml