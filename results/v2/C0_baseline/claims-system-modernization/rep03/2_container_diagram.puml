@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Insurance Claims Modernization System

Person(EndCustomersAndBrokers, "End Customers & Brokers", "External users submitting and managing claims 24/7.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal users reviewing and processing high-performance adjuster workflows.")

System_Ext(LegacyMainframeSystem, "Legacy Mainframe System", "On-premises COBOL/DB2 system of record.")
System_Ext(CorporateActiveDirectory, "Corporate Active Directory", "External IDP providing identity services.")

System_Boundary(InsuranceClaimsModernizationSystem, "Insurance Claims Modernization System") {
    Container(CustomerPortal, "Customer Portal", "React / TypeScript SPA, Azure Static Web Apps", "Enables 24/7 digital claim submissions for customers and brokers.")
    Container(AdjusterWebApplication, "Adjuster Web Application", "React / TypeScript SPA", "Provides high-performance workflows for claims adjusters.")
    Container(ClaimsAPIGatewayBFF, "Claims API Gateway / BFF", "Node.js or .NET Core, Azure Container Apps", "Backend-for-Frontend handling routing, security, and client requests.")
    Container(IntegrationSyncService, "Integration & Sync Service", "Azure Container Apps worker, Azure Service Bus", "Synchronizes data and handles messaging with the legacy mainframe system.")
    ContainerDb(AuditEventStore, "Audit & Event Store", "Azure Cosmos DB", "Maintains append-only immutability for audit trails.")
    ContainerDb(OperationalDatastore, "Operational Datastore", "Azure SQL Database / PostgreSQL on Azure", "Stores operational sync-state data.")
}

Rel(EndCustomersAndBrokers, CustomerPortal, "Interacts with", "HTTPS (REST)")
Rel(ClaimsAdjusters, AdjusterWebApplication, "Interacts with", "HTTPS (REST)")
Rel(CustomerPortal, ClaimsAPIGatewayBFF, "Communicates with", "HTTPS/JSON")
Rel(AdjusterWebApplication, ClaimsAPIGatewayBFF, "Communicates with", "HTTPS/JSON")
Rel(ClaimsAPIGatewayBFF, IntegrationSyncService, "Communicates with", "HTTPS/JSON and Azure Service Bus")
Rel(IntegrationSyncService, LegacyMainframeSystem, "Synchronizes data with", "IPsec VPN or Azure ExpressRoute (mTLS / TLS 1.3)")
Rel(CorporateActiveDirectory, ClaimsAPIGatewayBFF, "Authenticates users against", "OpenID Connect (OIDC) / OAuth2")

@enduml