@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Operational Datastore container

System_Ext(integration_sync_service, "Integration & Sync Service", "External service interacting with the datastore.")
System_Ext(claims_api_gateway, "Claims API Gateway / BFF", "External API Gateway and Backend For Frontend.")
System_Ext(audit_event_store, "Audit & Event Store", "External audit and event storage system.")

Container_Boundary(operational_datastore, "Operational Datastore") {
    Component(claims_registry_table, "Claims Registry Table", "PostgreSQL / Azure SQL", "Relational tables for core state tracking and data persistence.")
    Component(operational_read_model_cache, "Operational Read-Model Cache", "Denormalized tables", "Optimized cache providing low-latency reads for UI performance.")
    Component(sync_state_ledger, "Sync-State Ledger", "Transactional tables", "Transactional ledger ensuring zero data loss and exact claim routing during migration.")
    Component(audit_logging_subsystem, "Audit Logging Subsystem", "PostgreSQL pgaudit / Azure SQL Ledger / Temporal Tables", "Enforces immutable compliance audit logs and secure state tracking.")
}

Rel(integration_sync_service, sync_state_ledger, "Syncs state", "ADO.NET / pgsql over TLS via Azure Private Endpoints")
Rel(integration_sync_service, claims_registry_table, "Updates claims", "ADO.NET / pgsql over TLS via Azure Private Endpoints")
Rel(claims_api_gateway, operational_read_model_cache, "Queries data", "SQL queries via Azure Private Endpoints")
Rel(claims_registry_table, audit_event_store, "Replicates data", "PostgreSQL logical replication / Azure SQL Change Data Capture over TLS")

@enduml