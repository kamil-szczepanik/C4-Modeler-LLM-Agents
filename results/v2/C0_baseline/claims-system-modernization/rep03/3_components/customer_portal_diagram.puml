@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Customer Portal container

Container_Boundary("Customer Portal", "Customer Portal") {
    Component("Claim Submission Wizard Component", "Claim Submission Wizard Component", "React, TypeScript, Dexie.js / IndexedDB, Web Crypto API", "Multi-step form that handles claim submissions, local draft storage, and offline resilience.")
    Component("Status Tracker View Component", "Status Tracker View Component", "React, TypeScript, WebSocket / SSE", "Provides real-time tracking updates for submitted claims.")
    Component("Auth Integration Module", "Auth Integration Module", "MSAL.js, OpenID Connect", "Manages OpenID Connect token management and secure SSO.")
}

System_Ext("Claims API Gateway / BFF", "Claims API Gateway / BFF", "External System")
System_Ext("Azure Storage Blob", "Azure Storage Blob", "External System")
System_Ext("Corporate Active Directory", "Corporate Active Directory", "External System")

Rel("Claim Submission Wizard Component", "Claims API Gateway / BFF", "Communicates via", "HTTPS/JSON")
Rel("Claim Submission Wizard Component", "Azure Storage Blob", "Uploads media via", "HTTPS with SAS tokens")
Rel("Auth Integration Module", "Corporate Active Directory", "Authenticates via", "OIDC")

@enduml