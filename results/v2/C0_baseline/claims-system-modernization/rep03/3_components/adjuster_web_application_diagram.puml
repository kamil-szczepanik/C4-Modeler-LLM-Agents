@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Adjuster Web Application container

Container_Boundary(adjuster_web_application, "Adjuster Web Application") {
    Component(ClaimWorkspaceShell, "Claim Workspace Shell", "React SPA, Azure Static Web Apps", "Main layout and container for the adjuster UI workspace.")
    Component(TriageQueueManager, "Triage & Queue Manager", "React SPA, TypeScript", "Manages claim queues, sorting, and triage workflows for adjusters.")
    Component(DynamicFormEngine, "Dynamic Form Engine", "React SPA, TypeScript", "Renders dynamic forms for claim data entry and review.")
    Component(BFFClientAdapter, "BFF Client Adapter", "React SPA, React Query", "Handles communication and client-side caching with the Claims API Gateway / BFF.")
}

Rel(ClaimWorkspaceShell, TriageQueueManager, "Loads and renders")
Rel(ClaimWorkspaceShell, DynamicFormEngine, "Embeds and controls")
Rel(TriageQueueManager, BFFClientAdapter, "Fetches queue data via")
Rel(DynamicFormEngine, BFFClientAdapter, "Submits and retrieves form data via")
@enduml