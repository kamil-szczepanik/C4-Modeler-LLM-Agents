@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit & Event Store container

Container_Boundary("Audit & Event Store", "Audit & Event Store") {
    Component("Audit_Event_Store", "Audit & Event Store", "Azure Cosmos DB", "Azure Cosmos DB container maintaining append-only immutability, native change feed, and TTL policies partitioned by ClaimID.")
    Component("Immutability_Partition_Manager", "Immutability & Partition Manager", "Azure Cosmos DB native change feed and TTL policies", "Manages data immutability, time-to-live policies, and partition strategies keyed by ClaimID.")
}

Rel("Immutability_Partition_Manager", "Audit_Event_Store", "Enforces append-only immutability and TTL policies", "Cosmos DB API")

@enduml