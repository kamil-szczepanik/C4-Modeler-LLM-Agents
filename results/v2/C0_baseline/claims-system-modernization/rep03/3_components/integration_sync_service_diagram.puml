@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration & Sync Service container

Container_Boundary(integration_sync_service_boundary, "Integration & Sync Service") {
    Component(Sync Orchestrator Component, "Sync Orchestrator Component", ".NET 8", "Orchestrates the synchronization workflow and coordinates between adapters and validators.")
    Component(Mainframe Adapter Component, "Mainframe Adapter Component", ".NET 8 with Polly", "Interfaces with the legacy mainframe system using resilience patterns like circuit breakers and rate-limiting.")
    Component(Reconciliation & DLQ Manager Component, "Reconciliation & DLQ Manager Component", ".NET 8 / Azure Functions", "Inspects and replays failed messages, and manages reconciliation states.")
    Component(Business Rule Validator Component, "Business Rule Validator Component", ".NET 8", "Validates business rules for incoming and outgoing claim data.")
    Component(Messaging Consumer/Publisher Component, "Messaging Consumer/Publisher Component", "Azure Service Bus SDK", "Handles asynchronous messaging operations, enqueuing and deconstructing events.")
}

System_Ext(Audit & Event Store, "Audit & Event Store", "Azure Cosmos DB")
System_Ext(Legacy Mainframe System, "Legacy Mainframe System", "COBOL/DB2 on-prem")

Rel(Sync Orchestrator Component, Mainframe Adapter Component, "Internal", "In-Process / C# interface calls")
Rel(Sync Orchestrator Component, Business Rule Validator Component, "Internal", "In-Process / C#")
Rel(Sync Orchestrator Component, Messaging Consumer/Publisher Component, "Enqueues/Deconstructs events", "Azure Service Bus SDK")
Rel(Reconciliation & DLQ Manager Component, Messaging Consumer/Publisher Component, "Inspects and replays failed messages", "AMQP")
Rel(Reconciliation & DLQ Manager Component, Audit & Event Store, "Reads/Writes reconciliation states", "TCP / Cosmos DB SDK")
Rel(Mainframe Adapter Component, Legacy Mainframe System, "Synchronizes data", "IPsec VPN or Azure ExpressRoute using mTLS / TLS 1.3")

@enduml