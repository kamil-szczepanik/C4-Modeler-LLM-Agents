@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Claims_API_Gateway_BFF", "Claims API Gateway / BFF") {
    Component(Claim_Routing_Proxy_Controller, "Claim Routing & Proxy Controller", ".NET 8 / YARP", "Handles dynamic claim-type routing and rate-limiting policies for incoming traffic from the frontends.")
    Component(Authentication_Middleware, "Authentication Middleware", ".NET 8 / OpenID Connect", "Authenticates users via integration with Corporate Active Directory using OpenID Connect and OAuth2.")
    Component(Resilience_Integration_Handler, "Resilience & Integration Handler", ".NET 8 / Polly", "Manages circuit breaking, timeouts, and fallback resilience patterns when communicating with downstream services and the legacy mainframe.")
}

Rel(Claim_Routing_Proxy_Controller, Resilience_Integration_Handler, "Delegates requests for legacy mainframe or sync service", "")
Rel(Authentication_Middleware, Claim_Routing_Proxy_Controller, "Secures incoming requests", "")

@enduml