@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(PolicyholdersAndBrokers, "Policyholders and Brokers", "External users submitting claims online via mobile/web UI.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal users managing claims via a high-performance web application.")
System(NewClaimsPlatform, "New Claims Platform", "Cloud-native containerized application modernizing a 30-year-old COBOL/DB2 mainframe claims platform by gradually migrating claim types to a cloud-native Azure architecture.")
System_Ext(APIGatewayIntegrationLayer, "API Gateway / Integration Layer", "Hybrid routing and abstraction barrier managing legacy decoupling.")
System_Ext(LegacyMainframe, "Legacy Mainframe", "On-premises COBOL/DB2 system remaining the system of record.")
System_Ext(InsurerActiveDirectoryMicrosoftEntraID, "Insurer Active Directory / Microsoft Entra ID", "Identity provider managing authentication and SSO.")

Rel(PolicyholdersAndBrokers, NewClaimsPlatform, "Interact with the New Claims Platform online", "HTTPS")
Rel(ClaimsAdjusters, NewClaimsPlatform, "Manage claims via high-performance web application", "HTTPS")
Rel(NewClaimsPlatform, APIGatewayIntegrationLayer, "Communicates with the API Gateway for hybrid routing", "REST over HTTPS")
Rel(APIGatewayIntegrationLayer, LegacyMainframe, "Interfaces with the legacy system of record", "native TCP/SNA/DB2 protocols via mTLS")
Rel(NewClaimsPlatform, InsurerActiveDirectoryMicrosoftEntraID, "Integrates for federated single sign-on", "OIDC/OAuth2")

@enduml