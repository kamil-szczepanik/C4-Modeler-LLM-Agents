@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Migration Operations Dashboard container

Container_Boundary(migration_operations_dashboard, "Migration Operations Dashboard") {
    Component(Dashboard_UI, "Dashboard UI", "React SPA", "Provides real-time visibility, reconciliation alerts, and kill-switch controls for the migration transition.")
    Component(Dashboard_API_Controller, "Dashboard API Controller", ".NET Core Web API", "Exposes endpoints for the UI and invokes backend domain logic via MediatR.")
    Component(Reconciliation_Engine, "Reconciliation Engine", ".NET Core Component", "Queries the PostgreSQL Read-Cache and Legacy Mainframe to compare data and generate reconciliation metrics.")
    Component(Kill_Switch_Orchestrator, "Kill-Switch Orchestrator", ".NET Core Component", "Manages kill-switch controls and publishes operational commands.")
    Component(Reconciliation_Report_Generator, "Reconciliation Report Generator", ".NET Core Component", "Generates reconciliation reports and manages file storage.")
    Component(Discrepancy_Translation_Service, "Discrepancy Translation Service", ".NET Core Component", "Translates and processes discrepancy data between systems.")
}

System_Ext(PostgreSQL_Read_Cache, "PostgreSQL Read-Cache", "Database for read operations")
System_Ext(Anti_Corruption_Layer_ACL, "Anti-Corruption Layer (ACL)", "Translates legacy mainframe data")
System_Ext(Azure_Service_Bus, "Azure Service Bus", "Messaging backbone")
System_Ext(Azure_Blob_Storage, "Azure Blob Storage", "File and report storage")

Rel(Dashboard_UI, Dashboard_API_Controller, "Interacts via HTTPS/REST and SignalR")
Rel(Dashboard_API_Controller, Reconciliation_Engine, "Invokes via MediatR domain events")
Rel(Reconciliation_Engine, PostgreSQL_Read_Cache, "Queries via EF Core")
Rel(Reconciliation_Engine, Anti_Corruption_Layer_ACL, "Queries Legacy Mainframe data via")
Rel(Kill_Switch_Orchestrator, Azure_Service_Bus, "Publishes domain events to")
Rel(Reconciliation_Report_Generator, Azure_Blob_Storage, "Stores and retrieves files in")

@enduml