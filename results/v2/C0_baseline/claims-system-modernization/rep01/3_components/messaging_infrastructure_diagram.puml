@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Messaging & Infrastructure container

System_Boundary(messaging_infrastructure, "Messaging & Infrastructure") {
    Component(Message_Broker_Interface, "Message Broker Interface", "Azure Service Bus (AMQP 1.0)", "Provides reliable asynchronous messaging and Dead-Letter Queues to ensure zero claim loss during migration.")
    Component(Container_Runtime_Host, "Container Runtime Host", "Azure Container Apps with KEDA", "Hosts microservices and provides event-driven scaling.")
    Component(Secret_And_Config_Store, "Secret & Config Store", "Azure Key Vault", "Handles credentials, connection strings, and automated secret rotation.")
    Component(Audit_And_Telemetry_Forwarder, "Audit & Telemetry Forwarder", "Azure Monitor and OpenTelemetry", "Emits and forwards traces and audit logs.")
    Component(Storage_Sink, "Storage Sink", "Azure Blob Storage with WORM policies", "Stores immutable audit logs to satisfy insurance compliance standards.")
}

Component(Claims_Processing_Service, "Claims Processing Service", "External/Internal Service", "External claims processing service.")

Rel(Claims_Processing_Service, Message_Broker_Interface, "Publishes and consumes claim events", "AMQP 1.0")
Rel(Container_Runtime_Host, Audit_And_Telemetry_Forwarder, "Emits traces and audit logs", "HTTPS")
Rel(Container_Runtime_Host, Message_Broker_Interface, "Authenticates via Microsoft Entra ID Managed Identities", "mTLS / Private Endpoints")
Rel(Container_Runtime_Host, Secret_And_Config_Store, "Authenticates via Microsoft Entra ID Managed Identities", "mTLS / Private Endpoints")

@enduml