@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(claims_processing_service, "Claims Processing Service") {
    Component(Claim Orchestrator Component, "Claim Orchestrator Component", ".NET Core", "Orchestrates claim processing workflows and coordinates business transactions.")
    Component(Claim Domain Model Component, "Claim Domain Model Component", ".NET Core", "Encapsulates the core business logic and domain rules for claims.")
    Component(Exception Handler Component, "Exception Handler Component", ".NET Core", "Handles exceptions, failures, and manages dead-letter routing.")
    Component(Integration Client Component, "Integration Client Component", ".NET Core with Polly", "Manages communication with external systems and the Anti-Corruption Layer.")
}

Rel(Claim Orchestrator Component, Claim Domain Model Component, "Executes business logic")
Rel(Claim Orchestrator Component, Exception Handler Component, "Delegates error handling")
Rel(Claim Orchestrator Component, Integration Client Component, "Dispatches external calls and messaging")

@enduml