@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("AntiCorruptionLayer", "Anti-Corruption Layer (ACL)") {
    Component(ServiceBusMessageListener, "Service Bus Message Listener", ".NET Core / Azure Service Bus SDK", "Listens for claim migration and processing events from the Azure Service Bus.")
    Component(JsonToCobolMapper, "JSON-to-COBOL Mapper", ".NET Core Library", "Translates modern JSON payloads into mainframe-compatible COBOL structures.")
    Component(ReplayCoordinator, "Replay Coordinator", ".NET Core API Controller", "Manages claim replays and coordinates with the Migration Operations Dashboard via REST over HTTPS with Entra ID JWT validation.")
    Component(GrpcMainframeClient, "gRPC Mainframe Client", "gRPC / .NET Core", "Communicates securely with the Legacy Mainframe using gRPC over mTLS, utilizing secrets from Azure Key Vault.")
}

Rel(ServiceBusMessageListener, JsonToCobolMapper, "Forwards incoming messages for translation")
Rel(JsonToCobolMapper, GrpcMainframeClient, "Passes mapped COBOL data for legacy processing")
Rel(ReplayCoordinator, JsonToCobolMapper, "Triggers data mapping for claim replays")
@enduml