@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(ClaimsAdjusters, "Claims Adjusters", "Insurance claims adjusters managing claims")

System_Ext(MicrosoftEntraID, "Microsoft Entra ID", "Identity provider for authentication and token validation")
System_Ext(PostgreSQLReadCache, "PostgreSQL Read-Cache", "Optimized read cache for high-performance view models")
System_Ext(AzureServiceBus, "Azure Service Bus", "Messaging infrastructure for asynchronous commands")

Container_Boundary(AdjusterWebApplication, "Adjuster Web Application") {
    Component(AuthSessionComponent, "Auth & Session Component", "ASP.NET Core / Microsoft Entra ID", "Authenticates users and manages sessions via OpenID Connect and OAuth 2.0.")
    Component(ClaimPresentationTriageComponent, "Claim Presentation & Triage Component", "ASP.NET Core BFF", "Queries optimized view models from the PostgreSQL Read-Cache to deliver sub-2-second screen loads.")
    Component(CommandWorkflowComponent, "Command & Workflow Component", "ASP.NET Core / Azure Service Bus", "Dispatches asynchronous commands to the messaging infrastructure.")
    Component(TelemetryComponent, "Telemetry Component", "OpenTelemetry & Prometheus", "Provides hybrid observability and telemetry tracking.")
}

Rel(ClaimsAdjusters, AuthSessionComponent, "Authenticates and exchanges tokens", "HTTPS / OIDC")
Rel(AuthSessionComponent, MicrosoftEntraID, "Validates credentials and tokens", "HTTPS / OIDC")
Rel(ClaimPresentationTriageComponent, PostgreSQLReadCache, "Queries optimized view models", "TCP / TLS")
Rel(CommandWorkflowComponent, AzureServiceBus, "Dispatches asynchronous commands", "AMQP / TLS")
Rel(TelemetryComponent, AdjusterWebApplication, "Monitors and tracks application telemetry", "Internal")

@enduml