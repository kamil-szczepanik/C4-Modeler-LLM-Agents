@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL Read-Cache container

Container_Boundary("PostgreSQL Read-Cache", "PostgreSQL Read-Cache") {
    Component("CacheStorageEngine", "Cache Storage Engine", "Azure Database for PostgreSQL Flexible Server", "Managed database instance that caches mainframe data for modern adjusters to ensure sub-2-second response times.")
    Component("SyncConsumerComponent", "Sync Consumer Component", ".NET worker hosted in Azure Container Apps", "Ingests delta change events from the messaging broker and writes updates to the cache storage engine via connection pooling.")
    Component("AuditVersioningManager", "Audit & Versioning Manager", ".NET Library / Service Layer", "Manages audit trails and versioning for data synchronization and compliance.")
}

Rel(SyncConsumerComponent, CacheStorageEngine, "Writes updates via connection pooling", "TCP / TLS 1.3")
Rel(CacheStorageEngine, AuditVersioningManager, "Invokes audit and versioning checks for data modifications", "")

@enduml