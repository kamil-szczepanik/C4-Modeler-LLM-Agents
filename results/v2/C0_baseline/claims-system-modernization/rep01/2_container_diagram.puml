@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for New Claims Platform

Person(PolicyholdersAndBrokers, "Policyholders and Brokers", "External users submitting claims online via mobile/web UI.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal users managing claims via a high-performance web application.")

System_Ext(APIGatewayOnPremiseMainframe, "API Gateway / On-Premise Mainframe", "On-premises COBOL/DB2 system remaining the system of record with API gateway routing.")
System_Ext(MicrosoftEntraID, "Microsoft Entra ID", "Identity provider enforcing Single Sign-On (SSO) and RBAC/ABAC security controls.")

System_Boundary(NewClaimsPlatform, "New Claims Platform") {
    Container(CustomerPortal, "Customer Portal", "React SPA hosted in Azure Static Web Apps", "Allows policyholders and brokers to interact with the claims platform.")
    Container(AdjusterWebA, "Adjuster Web Application", "Node.js / ASP.NET Core BFF", "Backend-for-Frontend application supporting claims adjusters.")
    Container(PostgreSQLReadCache, "PostgreSQL Read-Cache", "PostgreSQL", "Delivers sub-2s read-model caching to decouple from mainframe latency.")
    Container(ClaimsProcessingService, "Claims Processing Service", ".NET Core microservices", "Handling core domain logic and claims modernization.")
    Container(AntiCorruptionLayerACL, "Anti-Corruption Layer (ACL)", "Integration service", "Translates modern events to legacy formats for mainframe integration.")
    Container(MigrationOperationsDashboard, "Migration Operations Dashboard", "React SPA and .NET Core API", "Used for business reconciliation and migration monitoring.")
    Container(MessagingInfrastructure, "Messaging & Infrastructure", "Azure Service Bus, Azure Container Apps, Azure Key Vault", "Provides asynchronous messaging, container hosting, and secret management.")
}

Rel(PolicyholdersAndBrokers, CustomerPortal, "Accesses portal to submit and manage claims", "HTTPS (TLS 1.3)")
Rel(ClaimsAdjusters, AdjusterWebA, "Manages claims and views operational data", "HTTPS (TLS 1.3) with OpenID Connect / OAuth 2.0")
Rel(AdjusterWebA, PostgreSQLReadCache, "Reads and caches claims data for low latency", "TCP / TLS")
Rel(ClaimsProcessingService, MessagingInfrastructure, "Publishes and consumes asynchronous messages", "AMQP / HTTPS")
Rel(AntiCorruptionLayerACL, APIGatewayOnPremiseMainframe, "Translates and communicates with legacy system of record", "gRPC over mTLS and secure IP whitelisting")
Rel(ClaimsAdjusters, MicrosoftEntraID, "Authenticates via SSO", "OpenID Connect / OAuth 2.0")

@enduml