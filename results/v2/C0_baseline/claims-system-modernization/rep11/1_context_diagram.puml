@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title System Context / Container diagram for Insurance Claims Modernization Platform

Person(Customers, "Customers", "End users who submit online claims.")
Person(Brokers, "Brokers", "Intermediaries who submit and manage claims on behalf of customers.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal staff who access web applications to review and process claims.")
Person(Underwriters, "Underwriters", "Internal staff reviewing claim risk and policy implications.")
Person(Finance_Operations, "Finance Operations", "Internal staff managing financial payouts and reconciliations.")

System_Ext(Legacy_Mainframe_System, "Legacy Mainframe System", "On-premises 30-year-old COBOL/DB2 mainframe acting as the system of record.")
System_Ext(Active_Directory_Azure_AD, "Active Directory / Azure AD", "Identity provider handling SSO authentication.")
System_Ext(Third_Party_Payment_Gateway, "Third-Party Payment Gateway", "External service processing financial transactions and payouts.")
System_Ext(Business_Analytics_System, "Business Analytics System", "System receiving anonymized data exports for analytics.")

System_Boundary(Insurance_Claims_Modernization_Platform, "Insurance Claims Modernization Platform") {
    Container(Azure_API_Gateway, "Azure API Gateway", "Azure PaaS / API Gateway", "Entry point featuring caching and circuit breakers.")
    Container(Claims_Web_Application, "Claims Web Application", "Modern Web Application Framework", "Web application used by customers, brokers, and adjusters.")
    Container(Abstraction_Layer_Gateway_Message_Queue, "Abstraction-Layer Gateway / Message Queue", "Enterprise Message Queue", "Asynchronous messaging abstraction to isolate legacy mainframe interface changes.")
    Container(Azure_Database, "Azure Database", "Azure Database / PaaS", "Cloud database supporting the modernization platform.")
}

Rel(Customers, Claims_Web_Application, "Interact for online claim submission", "HTTPS (TLS 1.3)")
Rel(Brokers, Claims_Web_Application, "Interact for online claim submission", "HTTPS (TLS 1.3)")
Rel(Claims_Adjusters, Claims_Web_Application, "Access web applications with SSO authentication", "HTTPS, Active Directory SSO")
Rel(Claims_Web_Application, Azure_API_Gateway, "Routes requests", "HTTPS")
Rel(Azure_API_Gateway, Azure_Database, "Reads/Writes data", "TLS")
Rel(Insurance_Claims_Modernization_Platform, Legacy_Mainframe_System, "Communicates via asynchronous messaging through an abstraction-layer gateway", "Asynchronous Messaging")
Rel(Insurance_Claims_Modernization_Platform, Third_Party_Payment_Gateway, "Integrates for payment processing", "REST / HTTPS, OAuth 2.0")
Rel(Insurance_Claims_Modernization_Platform, Business_Analytics_System, "Exports anonymized data via secure batch file drops", "Secure Batch File Drops")

@enduml