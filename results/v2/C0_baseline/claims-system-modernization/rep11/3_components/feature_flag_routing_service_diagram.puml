@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Feature Flag / Routing Service container

Person(Business_Operations_Managers, "Business Operations Managers", "Manages routing rules and views telemetry")
Container(Claims_API_BFF, "Claims API (BFF)", "Node.js / TypeScript", "Backend-for-Frontend supporting claims processing")
System_Ext(Legacy_Mainframe_System, "Legacy Mainframe System", "30-year-old COBOL/DB2 mainframe")

Container_Boundary(Feature_Flag_Routing_Service, "Feature Flag / Routing Service") {
    Component(Routing_Evaluation_Engine, "Routing Evaluation Engine", "Azure App Configuration / Node.js", "Fetches dynamic claim-type routing rules and feature flags with atomic snapshot swaps for instant rollbacks.")
    Component(Configuration_Management_UI, "Configuration Management UI", "Node.js / TypeScript", "Allows Business Operations Managers to manage routing rules and view telemetry.")
    Component(Metrics_Aggregator, "Metrics Aggregator", "Azure Monitor / Node.js", "Collects and aggregates system metrics and telemetry data.")
    Component(Circuit_Breaker, "Circuit Breaker", "Node.js", "Monitors downstream health and handles fallback mechanisms to the legacy mainframe system.")
}

Rel(Business_Operations_Managers, Configuration_Management_UI, "Manage routing rules and view telemetry", "HTTPS")
Rel(Claims_API_BFF, Routing_Evaluation_Engine, "Fetches dynamic claim-type routing rules and feature flags", "HTTPS / TLS 1.3")
Rel(Configuration_Management_UI, Routing_Evaluation_Engine, "Updates routing rules and configurations", "HTTPS")
Rel(Routing_Evaluation_Engine, Circuit_Breaker, "Evaluates request routing and checks service health", "")
Rel(Routing_Evaluation_Engine, Legacy_Mainframe_System, "Fallback and legacy claim processing", "APIs / DB2")
Rel(Metrics_Aggregator, Configuration_Management_UI, "Provides telemetry data", "HTTPS")

@enduml