@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(WebAdjusterPortals, "Web / Adjuster Portals", "React SPA", "External modern portals interacting with the Claims API.")
System_Ext(AzureCosmosDB, "Azure Cosmos DB", "Azure Cosmos DB", "Database used for caching and data storage via TCP/TLS.")

Container_Boundary(ClaimsAPIBFF, "Claims API (BFF)") {
    Component(RoutingMediator, "Routing Mediator", "Node.js / TypeScript", "Routes requests between React portals and legacy mainframe systems.")
    Component(AggregatorViewModelBuilder, "Aggregator / ViewModel Builder", "Node.js / TypeScript", "Aggregates data and builds view models for frontend portals.")
    Component(AuthenticationMiddleware, "Authentication Middleware", "OIDC / Azure AD", "Handles secure authentication and validation against Azure AD.")
    Component(SessionTokenManager, "Session & Token Manager", "HTTPS / HttpOnly Cookies", "Manages user sessions and secure tokens using HttpOnly cookies.")
    Component(PayloadSchemaValidator, "Payload Schema Validator", "Zod", "Performs strict inbound payload sanitization and schema validation.")
    Component(OutboundResiliencePolicyEngine, "Outbound Resilience Policy Engine", "Opossum", "Applies circuit breaker patterns and resilience policies for outbound mainframe requests.")
    Component(FallbackGracefulDegradationHandler, "Fallback & Graceful Degradation Handler", "Node.js / TypeScript", "Handles fallbacks and graceful degradation utilizing Cosmos DB cache.")
    Component(LifecycleHealthManagementComponent, "Lifecycle & Health Management Component", "Node.js / TypeScript", "Manages container lifecycle and health checks within Azure Kubernetes Service.")
    Component(AzureApplicationInsights, "Azure Application Insights", "Azure Application Insights", "Provides native telemetry and distributed tracing monitoring.")
}

Rel(WebAdjusterPortals, SessionTokenManager, "Sends requests", "HTTPS / HttpOnly Cookies")
Rel(SessionTokenManager, AuthenticationMiddleware, "Validates sessions", "OIDC / Azure AD")
Rel(RoutingMediator, OutboundResiliencePolicyEngine, "Invokes outbound calls", "Internal API / HTTPS")
Rel(AggregatorViewModelBuilder, FallbackGracefulDegradationHandler, "Retrieves cached data", "TCP/TLS")
Rel(ClaimsAPIBFF, AzureCosmosDB, "Persists and retrieves data", "TCP/TLS")

@enduml