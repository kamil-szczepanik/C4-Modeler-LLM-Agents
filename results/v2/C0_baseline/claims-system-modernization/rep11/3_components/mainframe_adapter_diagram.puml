@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Mainframe Adapter container

Container_Boundary(mainframe_adapter, "Mainframe Adapter") {
    Component(api_routing_and_middleware, "API Routing and Middleware", "Node.js, Express.js", "Implements routing, simulation modes, and circuit breaker resiliency patterns for incoming BFF requests.")
    Component(feature_flag_manager, "Feature Flag Manager", "Azure App Configuration", "Provides real-time feature toggling for instant claim type rollbacks during the transition.")
    Component(mainframe_integration_client, "Mainframe Integration Client", "Node.js/TypeScript, mTLS, ExpressRoute", "Communicates with the on-premise legacy COBOL/DB2 mainframe securely via mutually authenticated TLS.")
    Component(event_publisher, "Event Publisher", "Azure Service Bus, AMQP/HTTPS", "Offloads shadow traffic and asynchronous events to the Azure Service Bus.")
    Component(audit_logger, "Audit Logger", "Azure Blob Storage, HTTPS", "Streams immutable audit logs for transactions and state changes.")
    Component(secrets_manager_client, "Secrets Manager Client", "Azure Key Vault, Managed Identities", "Retrieves secrets securely for authenticating with external and internal services.")
}

Rel(api_routing_and_middleware, feature_flag_manager, "Checks real-time feature toggles for claim type routing", "REST")
Rel(api_routing_and_middleware, mainframe_integration_client, "Forwards requests to legacy system", "gRPC/REST via Azure AD JWT/OAuth2")
Rel(mainframe_integration_client, event_publisher, "Offloads shadow traffic and events", "AMQP/HTTPS")
Rel(api_routing_and_middleware, secrets_manager_client, "Retrieves required secrets", "Managed Identities")
Rel(api_routing_and_middleware, audit_logger, "Streams immutable audit logs", "HTTPS")

@enduml