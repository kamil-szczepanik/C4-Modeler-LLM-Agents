@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Dispute & Exception Dashboard container

Container_Boundary("Dispute & Exception Dashboard", "Dispute & Exception Dashboard") {
    Component("Exception_Table___Filter_Component", "Exception Table & Filter Component", "TanStack Table", "Renders complex exception tables and enables filtering of data synchronization errors.")
    Component("Resolution___Audit_Form_Component", "Resolution & Audit Form Component", "React / Formik + Zod", "Provides robust client-side input validation and form handling for resolving exceptions.")
    Component("Metrics___SLA_Visualization_Component", "Metrics & SLA Visualization Component", "Recharts", "Visualizes real-time SLA metrics and operational data for monitoring.")
}

System_Ext("Claims_API_BFF", "Claims API (BFF)", "Backend for Frontend service")

Rel(Exception_Table___Filter_Component, Claims_API_BFF, "Fetches exception and synchronization error data", "REST over HTTPS")
Rel(Resolution___Audit_Form_Component, Claims_API_BFF, "Submits audit-logged resolutions", "REST over HTTPS with OAuth 2.0")
Rel(Metrics___SLA_Visualization_Component, Claims_API_BFF, "Retrieves metrics and SLA data", "REST over HTTPS")

@enduml