@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Portal (SPA) container

Container_Boundary(web_portal_spa, "Web Portal (SPA)") {
    Component(Dynamic_Form_Renderer, "Dynamic Form Renderer", "React / TypeScript", "Renders dynamic claims forms and user interfaces for customers and brokers.")
    Component(Authentication_Client, "Authentication Client", "React / TypeScript / OIDC", "Manages user authentication sessions and integrates with Azure AD.")
    Component(API_Client, "API Client", "Axios / Fetch API", "Communicates securely with the Claims API (BFF) over REST and HTTPS.")
}

Rel(Dynamic_Form_Renderer, API_Client, "Sends user input and claims data")
Rel(Authentication_Client, API_Client, "Attaches OAuth 2.0 / OIDC tokens")

@enduml