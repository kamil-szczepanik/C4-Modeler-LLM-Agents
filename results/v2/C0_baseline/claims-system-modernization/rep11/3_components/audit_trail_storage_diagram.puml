@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit Trail Storage container

Person(Compliance Officers and External Auditors, "Compliance Officers and External Auditors", "Perform auditing activities using read-only access.")

Container_Boundary(Audit Trail Storage, "Audit Trail Storage") {
    Component(Audit Trail Storage Container, "Audit Trail Storage Container", "Azure Blob Storage (Immutable WORM storage with 7+ year Time-Based Retention)", "Stores immutable audit logs to ensure non-repudiation, regulatory compliance, and prevent data loss or tampering during migration.")
    Component(Event Ingestion Route, "Event Ingestion Route", "Azure Event Grid and Azure Service Bus", "Serverless ingestion pipeline (AMQP / Managed Azure Integration) that minimizes custom code for the team.")
    Component(Security & Access Management, "Security & Access Management", "Azure Key Vault and Azure AD RBAC", "Provides encryption-at-rest using Customer-Managed Keys (CMK) and strict least-privilege access control with network isolation.")
}

Rel(Claims API and Mainframe Adapter, Event Ingestion Route, "Publishes business audit events", "AMQP")
Rel(Event Ingestion Route, Audit Trail Storage Container, "Writes immutable audit logs", "HTTPS / Blob REST API")
Rel(Compliance Officers and External Auditors, Audit Trail Storage Container, "Read-only access for auditing", "Azure AD RBAC / HTTPS")

@enduml