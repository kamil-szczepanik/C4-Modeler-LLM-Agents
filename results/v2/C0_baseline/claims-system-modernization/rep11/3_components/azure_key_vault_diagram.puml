@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(claims_api, "Claims API", "External container interacting with the Key Vault")
System_Ext(mainframe_adapter, "Mainframe Adapter", "External container interacting with the Key Vault")
System_Ext(log_analytics, "Log Analytics", "External monitoring and log analytics service")

Container_Boundary(azure_key_vault, "Azure Key Vault") {
    Component(secrets_engine, "Secrets Engine", "Azure Key Vault Secret Management", "Stores connection strings and API keys for the Claims API and Mainframe Adapter.")
    Component(certificates_engine, "Certificates Engine", "Azure Key Vault Certificate Management", "Manages TLS/SSL certificates for secure ingress.")
    Component(access_policy_rbac_enforcer, "Access Policy & RBAC Enforcer", "Azure RBAC & Managed Identities", "Restricts access using Azure RBAC and Managed Identities with the principle of least privilege.")
    Component(private_endpoint_connector, "Private Endpoint Connector", "Azure Private Link", "Isolates network traffic within the AKS Virtual Network.")
    Component(diagnostic_log_forwarder, "Diagnostic Log Forwarder", "Azure Monitor / Log Analytics", "Streams audit events and telemetry to Azure Monitor / Log Analytics.")
}

Rel(claims_api, secrets_engine, "Reads database secrets", "HTTPS via Private Endpoint / TLS 1.3")
Rel(mainframe_adapter, secrets_engine, "Reads integration credentials", "HTTPS via Private Endpoint / TLS 1.3")
Rel(azure_key_vault, log_analytics, "Emits audit and access logs", "Internal Azure Diagnostics")

@enduml