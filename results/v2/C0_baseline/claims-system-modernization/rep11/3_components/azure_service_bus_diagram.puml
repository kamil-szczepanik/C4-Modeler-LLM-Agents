@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Service Bus container

Container_Boundary(azure_service_bus, "Azure Service Bus") {
    Component(ClaimSubmissionTopic, "Claim Submission Topic", "Azure Service Bus Topic (Premium Tier)", "Enterprise messaging topic that receives published claim events from the Claims API.")
    Component(MainframeSyncQueue, "Mainframe Sync Queue", "Azure Service Bus Queue (Premium Tier)", "Queues synchronization payloads forwarded from the claim submission topic for consumption by the mainframe adapter.")
    Component(AuditArchiveSubscription, "Audit Archive Subscription", "Azure Service Bus Subscription", "Fans out event copies from the claim submission topic for archiving.")
}

Rel(ClaimSubmissionTopic, MainframeSyncQueue, "Forwards messages via subscriptions", "AMQP")
Rel(ClaimSubmissionTopic, AuditArchiveSubscription, "Fans out event copies", "AMQP")

@enduml