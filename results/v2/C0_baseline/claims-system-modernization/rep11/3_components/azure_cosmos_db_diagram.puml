@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Azure Cosmos DB", "Azure Cosmos DB") {
    Component("Claim Read-Model Store", "Claim Read-Model Store", "Azure Cosmos DB (SQL API)", "Low-latency read-model caching for claims data.")
    Component("Change Feed Processor", "Change Feed Processor", "Azure Cosmos DB Change Feed", "Processes changes and synchronizes data across systems.")
    Component("Reconciliation State Store", "Reconciliation State Store", "Azure Cosmos DB", "Maintains state for data reconciliation between cloud and legacy systems.")
}

Rel("Change Feed Processor", "Claim Read-Model Store", "Updates and synchronizes", "")
Rel("Reconciliation State Store", "Change Feed Processor", "Provides state for", "")

@enduml