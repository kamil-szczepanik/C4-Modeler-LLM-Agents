@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(adjuster_portal_spa, "Adjuster Portal (SPA)") {
    Component(RoutingShellComponent, "Routing & Shell Component", "React Router / TypeScript", "Component managing OIDC navigation and Azure AD SSO.")
    Component(FeatureToggleContext, "Feature Toggle Context", "React Context / TypeScript", "Dynamic module consuming routing and feature metadata from the BFF.")
    Component(ClaimsManagementModule, "Claims Management Module", "React Query / Zustand", "Reactive forms handling optimistic UI updates and local caching.")
    Component(ApiClientLayer, "API Client Layer", "REST / JSON Module", "Communication module injecting correlation IDs for OAuth 2.0 / OIDC bearer tokens.")
    Component(ErrorBoundaryComponent, "Error Boundary Component", "React Error Boundary", "Global component capturing API timeouts and mainframe degradation events.")
}

Rel(RoutingShellComponent, FeatureToggleContext, "Consumes routing and feature metadata", "")
Rel(ClaimsManagementModule, ApiClientLayer, "Sends API requests", "")
Rel(ErrorBoundaryComponent, ClaimsManagementModule, "Monitors and catches runtime errors", "")

@enduml