@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Hybrid Insurance Claims Modernization Platform

Person(Customer_Broker, "Customer/Broker", "External users submitting claims online.")
Person(Claim_Adjuster, "Claim Adjuster", "Internal users managing claims via the new workspace.")

System_Ext(Legacy_Mainframe, "Legacy Mainframe", "30-year-old COBOL/DB2 on-premises system of record.")
System_Ext(Azure_Service_Bus, "Azure Service Bus", "Asynchronous message broker guaranteeing reliable processing and consistency.")
System_Ext(Azure_Key_Vault, "Azure Key Vault", "Secure storage for secrets and certificates.")
System_Ext(Application_Insights, "Application Insights", "Monitoring and telemetry service.")

System_Boundary(hybrid_platform, "Hybrid Insurance Claims Modernization Platform") {
    Container(Customer_Portal, "Customer Portal", "React Single Page Application / Azure Static Web Apps", "Frontend interface for customers and brokers to submit claims.")
    Container(Adjuster_Workspace, "Adjuster Workspace", ".NET Core web application / Azure Container Apps", "Internal workspace for claim adjusters to manage workflows.")
    Container(Claim_Routing___Feature_Service, "Claim Routing & Feature Service", ".NET Core API / Azure Container Apps", "Lightweight API managing claim type migration via feature flags.")
    Container(Claims_Integration_Service, "Claims Integration Service", ".NET Core worker/API / Azure Container Apps", "Handles data synchronization with the legacy mainframe.")
    ContainerDb(Audit___Compliance_Data_Store, "Audit & Compliance Data Store", "Azure Cosmos DB / Azure Functions", "Unified audit trails and compliance data management.")
}

Rel(Customer_Broker, Customer_Portal, "Submits and views claims", "HTTPS over Internet")
Rel(Claim_Adjuster, Adjuster_Workspace, "Manages claim workflows", "HTTPS (OAuth 2.0 / OpenID Connect via Microsoft Entra ID)")
Rel(Adjuster_Workspace, Claim_Routing___Feature_Service, "Routes claims and checks feature flags", "gRPC over internal VNet")
Rel(Claim_Routing___Feature_Service, Azure_Service_Bus, "Sends asynchronous messages for mainframe synchronization", "Azure Service Bus")
Rel(Azure_Service_Bus, Claims_Integration_Service, "Delivers asynchronous messages", "Azure Service Bus")
Rel(Claims_Integration_Service, Legacy_Mainframe, "Synchronizes data with legacy system", "Secure FTP / MQ over ExpressRoute/IPSec VPN with mTLS")
Rel(Claims_Integration_Service, Audit___Compliance_Data_Store, "Records audit logs and compliance data", "HTTPS / Azure Functions")

@enduml