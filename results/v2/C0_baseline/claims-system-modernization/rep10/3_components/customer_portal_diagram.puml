@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Customer Portal container

System_Ext(Azure_Active_Directory, "Azure Active Directory", "External Identity Provider")
System_Ext(Claim_Routing___Feature_Service, "Claim Routing & Feature Service", "Backend API in Azure Container Apps")
System_Ext(Azure_Blob_Storage, "Azure Blob Storage", "Object storage for attachments with server-side malware scanning")

Container_Boundary(Customer_Portal, "Customer Portal") {
    Component(Authentication_Wrapper, "Authentication Wrapper", "MSAL.js", "Component handling OIDC/OAuth2 SSO and secure Azure AD integration.")
    Component(Claim_Submission_Form, "Claim Submission Form", "React component", "React component managing multi-step claim wizards.")
    Component(Document_Uploader, "Document Uploader", "React component", "React component interacting with Azure Blob Storage for attachments.")
    Component(Claim_Tracker_View, "Claim Tracker View", "React component", "React component using HTTP Polling to check claim status.")
}

Rel(Authentication_Wrapper, Azure_Active_Directory, "Authenticates users", "OIDC over HTTPS")
Rel(Claim_Submission_Form, Claim_Routing___Feature_Service, "Submits claim data", "HTTP/REST over HTTPS")
Rel(Document_Uploader, Azure_Blob_Storage, "Uploads attachments", "HTTPS PUT via short-lived SAS tokens")
Rel(Claim_Tracker_View, Claim_Routing___Feature_Service, "Polls claim status", "HTTP Polling over HTTPS")

@enduml