@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Integration Service container

System_Ext(AzureServiceBus, "Azure Service Bus", "External messaging system")
System_Ext(LegacyMainframe, "Legacy Mainframe", "Legacy COBOL/DB2 mainframe")
System_Ext(AdjusterWorkspace, "Adjuster Workspace", "Client application for adjusters")

Container_Boundary(ClaimsIntegrationService, "Claims Integration Service") {
    Component(RoutingTranslationComponent, "Routing & Translation Component", ".NET Core / JSON-based Rules", "Handles dynamic claim routing rules and translation.")
    Component(MainframeAdapterComponent, "Mainframe Adapter Component", ".NET Core / MQ Client with Polly Circuit Breaker", "Interfaces with the legacy mainframe via MQ client and Polly circuit breaker.")
    Component(SynchronizationStateWorker, "Synchronization & State Worker", ".NET Core Background Service", "Processes asynchronous claim messages and manages state.")
    Component(IntegrationAPIController, "Integration API Controller", ".NET Core Minimal API", "Serves synchronization health and routing status to the Adjuster Workspace.")
    Component(StateOutboxStore, "State & Outbox Store", "Azure Database for PostgreSQL - Flexible Server", "Persists transactional outbox data using Entity Framework Core with TDE.")
    Component(ConfigurationStore, "Configuration Store", "Azure App Configuration", "Stores dynamic routing rules securely with zero-code fallback triggers.")
    Component(SecretManagement, "Secret Management", "Azure Key Vault with Managed Identities", "Manages secrets securely using managed identities.")
}

Rel(AzureServiceBus, SynchronizationStateWorker, "Receives asynchronous claim messages", "AMQP")
Rel(SynchronizationStateWorker, StateOutboxStore, "Persists transactional outbox data", "Entity Framework Core with TDE")
Rel(MainframeAdapterComponent, LegacyMainframe, "Synchronizes data", "Secure FTP / MQ over ExpressRoute/IPSec VPN with mTLS")
Rel(IntegrationAPIController, AdjusterWorkspace, "Serves synchronization health and routing status", "HTTPS / REST with Azure AD RBAC")
Rel(RoutingTranslationComponent, ConfigurationStore, "Retrieves dynamic claim routing rules", "HTTPS with Azure RBAC")

@enduml