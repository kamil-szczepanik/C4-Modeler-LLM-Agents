@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Adjuster Workspace container

Person(ClaimAdjusters, "Claim Adjusters", "")

Container_Boundary(AdjusterWorkspace, "Adjuster Workspace") {
    Component(WorkspaceUIController, "Workspace UI Controller", ".NET Core / Azure Container Apps", "Manages claim workflows and user interactions.")
    Component(ClaimPresentationService, "Claim Presentation Service", ".NET Core / Azure Container Apps", "Validates JWT claims and processes claim presentation logic.")
    Component(DynamicWorkflowEngine, "Dynamic Workflow Engine", ".NET Core / Azure Container Apps", "Orchestrates dynamic claim workflows and emits audit events.")
}

System_Ext(AzureRedisCache, "Azure Redis Cache", "")
System_Ext(ClaimRoutingFeatureService, "Claim Routing & Feature Service", "")
System_Ext(AuditComplianceDataStore, "Audit & Compliance Data Store", "")

Rel(ClaimAdjusters, WorkspaceUIController, "Manages claim workflows", "HTTPS via TLS 1.3, OAuth 2.0 / OpenID Connect")
Rel(WorkspaceUIController, ClaimPresentationService, "Validates JWT claims", "In-process / Internal invocation")
Rel(ClaimPresentationService, AzureRedisCache, "Fetches UI metadata", "Encrypted gRPC")
Rel(ClaimPresentationService, ClaimRoutingFeatureService, "Requests raw claim data and feature flags", "gRPC over VNet with mTLS")
Rel(DynamicWorkflowEngine, AuditComplianceDataStore, "Emits audit events", "Asynchronous via Azure Service Bus")

@enduml