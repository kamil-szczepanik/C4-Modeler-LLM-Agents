@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(ComplianceAuditOfficers, "Compliance & Audit Officers", "Queries audit reports via HTTPS and Azure Front Door.")
System_Ext(ClaimsIntegrationService, "Claims Integration Service", "Sends audit events via POST /api/audit.")

Container_Boundary(AuditComplianceDataStore, "Audit & Compliance Data Store") {
    Component(AuditIngestionFunction, "Audit Ingestion Function", "Azure Function / .NET Core", "Ingests audit events and writes immutable records to the audit data store.")
    Component(ComplianceIndexingQueryAPI, "Compliance Indexing & Query API", "Azure Function / .NET Core", "Queries compliance data and audit reports for compliance and audit officers.")
    Component(AuditExportRetentionWorker, "Audit Export & Retention Worker", "Azure Function / .NET Core", "Reads expired logs via change feed and archives immutable snapshots to blob storage.")
    Component(AuditDataStore, "Audit Data Store", "Azure Cosmos DB - SQL API", "Stores immutable audit events utilizing time-to-live and change feeds.")
    Component(AzureBlobStorage, "Azure Blob Storage", "Azure Blob Storage", "Provides cost-effective cold storage with immutable time-based retention policies for long-term archiving.")
}

Rel(ClaimsIntegrationService, AuditIngestionFunction, "POST /api/audit via HTTPS/JSON", "HTTPS/JSON")
Rel(AuditIngestionFunction, AuditDataStore, "Writes immutable audit events via Cosmos DB SDK / TCP", "Cosmos DB SDK / TCP")
Rel(ComplianceAuditOfficers, ComplianceIndexingQueryAPI, "Queries audit reports via HTTPS / Azure Front Door", "HTTPS / Azure Front Door")
Rel(AuditExportRetentionWorker, AuditDataStore, "Reads expired logs via Cosmos DB Change Feed / TCP", "Cosmos DB Change Feed / TCP")
Rel(AuditExportRetentionWorker, AzureBlobStorage, "Archives immutable snapshots via HTTPS / Azure Blob SDK", "HTTPS / Azure Blob SDK")
Rel(ComplianceIndexingQueryAPI, AuditDataStore, "Queries hot compliance data via Cosmos DB SQL API / TCP", "Cosmos DB SQL API / TCP")

@enduml