@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claim Routing & Feature Service container

Container_Boundary(claim_routing_and_feature_service, "Claim Routing & Feature Service") {
    Component(Routing_Engine_Component, "Routing Engine Component", ".NET Core / MediatR", "Orchestrates hybrid cloud claim processing and routes claims based on feature flags.")
    Component(Feature_Flag_Manager_Component, "Feature Flag Manager Component", ".NET Core / Microsoft Feature Management", "Manages the gradual migration of claim types using dynamic feature flags.")
    Component(Context___Auth_Validator_Component, "Context & Auth Validator Component", ".NET Core Middleware", "Validates context and authentication for incoming requests.")
    Component(Telemetry_Publisher_Component, "Telemetry Publisher Component", ".NET Core / Azure Monitor & Event Hubs", "Exports distributed traces, metrics, and security audit logs.")
}

System_Ext(Azure_App_Configuration, "Azure App Configuration", "External System")
System_Ext(Claims_Integration_Service, "Claims Integration Service", "External System")
System_Ext(Azure_Monitor, "Azure Monitor", "External System")

Rel(Feature_Flag_Manager_Component, Azure_App_Configuration, "Fetches feature states", "HTTPS via Managed Identity")
Rel(Routing_Engine_Component, Claims_Integration_Service, "Sends asynchronous messages for mainframe synchronization", "AMQP via Azure Service Bus")
Rel(Telemetry_Publisher_Component, Azure_Monitor, "Exports distributed traces, metrics, and security audit logs", "OpenTelemetry / OTLP")

@enduml