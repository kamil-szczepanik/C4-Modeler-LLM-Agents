@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(CustomersAndBrokers, "Customers and Brokers", "External users submitting claims online.")
Person(ClaimAdjusters, "Claim Adjusters", "Internal users managing claims via the new web application.")
Person(ComplianceAndAuditOfficers, "Compliance & Audit Officers", "Internal users accessing read-only audit trails.")

System(HybridInsuranceClaimsModernizationPlatform, "Hybrid Insurance Claims Modernization Platform", "A hybrid insurance claims modernization platform that gradually replaces a 30-year-old COBOL/DB2 mainframe while maintaining continuous legacy processing, providing modern cloud capabilities for customers, brokers, and adjusters.")

System_Ext(LegacyMainframe, "Legacy Mainframe", "On-premise 30-year-old COBOL/DB2 system acting as the system of record.")
System_Ext(AzureServiceBus, "Azure Service Bus", "Managed message broker in Azure acting as a decoupled integration buffer.")
System_Ext(ActiveDirectory, "Active Directory", "On-premise enterprise identity provider.")

Rel(CustomersAndBrokers, HybridInsuranceClaimsModernizationPlatform, "Submit claims online", "HTTPS (Web/Mobile UI)")
Rel(ClaimAdjusters, HybridInsuranceClaimsModernizationPlatform, "Manage claims via the new web application", "HTTPS (Web/Mobile UI)")
Rel(ComplianceAndAuditOfficers, HybridInsuranceClaimsModernizationPlatform, "Access read-only audit trails", "HTTPS (Web/Mobile UI)")
Rel(HybridInsuranceClaimsModernizationPlatform, AzureServiceBus, "Asynchronous claims synchronization", "AMQP / HTTPS")
Rel(HybridInsuranceClaimsModernizationPlatform, LegacyMainframe, "Asynchronous messaging / ETL via integration buffer", "Asynchronous messaging / ETL")
Rel(LegacyMainframe, HybridInsuranceClaimsModernizationPlatform, "Legacy system synchronization", "Asynchronous messaging / ETL")
Rel(HybridInsuranceClaimsModernizationPlatform, ActiveDirectory, "Authentication and authorization via Azure AD Connect with Hybrid Conditional Access", "OAuth2 / OpenID Connect")

@enduml