@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Claims Service container

System_Ext(MainframeAntiCorruptionLayer, "Mainframe Anti-Corruption Layer", "External system")
System_Ext(AzureKeyVaultActiveDirectory, "Azure Key Vault & Active Directory", "External system")

Container_Boundary(CoreClaimsService, "Core Claims Service") {
    Component(ClaimOrchestratorComponent, "Claim Orchestrator Component", "Java / Spring Boot", "Orchestrates online submissions, adjuster workflows, and incremental claim type migrations.")
    Component(ClaimDomainModelComponent, "Claim Domain Model Component", "Java / DDD", "Encapsulates the core business logic and domain rules for claims.")
    Component(ACLPublisherComponent, "ACL Publisher Component", "Apache Kafka Client", "Publishes asynchronous events to the Mainframe Anti-Corruption Layer.")
    Component(ValidationPolicyEngineComponent, "Validation & Policy Engine Component", "Spring Validation / Drools", "Executes validation rules and policy checks for claims.")
    Component(SLAMetricsTelemetryComponent, "SLA & Metrics Telemetry Component", "Micrometer / OpenTelemetry", "Captures distributed traces and business metrics without leaking PII.")
}

Rel(ClaimOrchestratorComponent, ClaimDomainModelComponent, "Executes direct in-process method calls", "In-Memory")
Rel(ClaimOrchestratorComponent, ValidationPolicyEngineComponent, "Executes direct in-process method calls", "In-Memory")
Rel(ClaimOrchestratorComponent, ACLPublisherComponent, "Publishes asynchronous events", "Apache Kafka / Azure Event Hubs")
Rel(CoreClaimsService, MainframeAntiCorruptionLayer, "Publishes asynchronous events", "Apache Kafka / Azure Event Hubs")
Rel(CoreClaimsService, AzureKeyVaultActiveDirectory, "Retrieves secrets and validates tokens", "Managed Identities / OAuth2 / HTTPS")
@enduml