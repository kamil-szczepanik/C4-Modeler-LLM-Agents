@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(main_mainframe_acl, "Mainframe Anti-Corruption Layer (ACL)") {
    Component(Mainframe_Anti_Corruption_Layer_Azure_Event_Hubs_Kafka, "Mainframe Anti-Corruption Layer (Azure Event Hubs / Kafka)", "Azure Event Hubs (Kafka)", "Asynchronously decouples the modern platform from the legacy mainframe.")
    Component(Ingress_Event_Router_Kafka_Connect_Azure_Functions, "Ingress Event Router (Kafka Connect / Azure Functions)", "Kafka Connect / Azure Functions", "Minimizes custom integration code for teams with low cloud experience.")
    Component(Schema_State_Registry_Confluent_Schema_Registry, "Schema & State Registry (Confluent Schema Registry)", "Confluent Schema Registry", "Enforces data contracts to limit mainframe changes to max one per quarter.")
    Component(Protocol_Adapter_Apache_Camel, "Protocol Adapter (Apache Camel)", "Apache Camel", "Provides enterprise integration patterns, circuit breaking, and retry logic.")
}

Rel(Mainframe_Anti_Corruption_Layer_Azure_Event_Hubs_Kafka, Ingress_Event_Router_Kafka_Connect_Azure_Functions, "Routes events through the ingress router", "")
Rel(Ingress_Event_Router_Kafka_Connect_Azure_Functions, Schema_State_Registry_Confluent_Schema_Registry, "Validates payloads via Confluent Schema Registry", "")
Rel(Schema_State_Registry_Confluent_Schema_Registry, Protocol_Adapter_Apache_Camel, "Dispatches validated transformation payloads", "")

@enduml