@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Operational Observability & Dead-Letter Container

Container_Boundary(operational_observability_dead_letter_container, "Operational Observability & Dead-Letter Container") {
    Component(Dead_Letter_Consumer_Component, "Dead-Letter Consumer Component", ".NET 8 Worker", "Consumes failed messages from Azure Service Bus / Event Hubs DLQs via AMQP.")
    Component(Re_drive_Engine_Component, "Re-drive Engine Component", ".NET 8 Minimal API", "Manages and re-drives failed message delivery.")
    Component(Metrics_Tracing_Collector, "Metrics & Tracing Collector", "OpenTelemetry / Azure Monitor exporter", "Exports telemetry to Azure Monitor over HTTPS for centralized system health and distributed tracing.")
    Component(Operations_API_Component, "Operations API Component", ".NET 8 Minimal API", "Exposes secure HTTPS endpoints for the Claims API Gateway and Operations Managers.")
    Component(Payload_Normalization_Enrichment_Component, "Payload Normalization & Enrichment Component", ".NET 8", "Stores enriched payloads in Azure Blob Storage with HTTPS.")
}

System_Ext(Azure_Service_Bus_Event_Hubs_DLQs, "Azure Service Bus / Event Hubs DLQs", "External messaging and dead-letter queues.")
System_Ext(Claims_API_Gateway, "Claims API Gateway", "External API gateway routing requests.")
System_Ext(Azure_Blob_Storage, "Azure Blob Storage", "External cloud storage for enriched payloads.")
System_Ext(Azure_Monitor, "Azure Monitor", "External telemetry and monitoring service.")

Rel(Dead_Letter_Consumer_Component, Azure_Service_Bus_Event_Hubs_DLQs, "Consumes failed messages", "AMQP")
Rel(Operations_API_Component, Claims_API_Gateway, "Exposes secure endpoints for", "HTTPS")
Rel(Payload_Normalization_Enrichment_Component, Azure_Blob_Storage, "Stores enriched payloads", "HTTPS")
Rel(Metrics_Tracing_Collector, Azure_Monitor, "Exports telemetry", "HTTPS")

@startuml