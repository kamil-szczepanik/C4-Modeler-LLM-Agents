@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Frontend (SPA) container

Container_Boundary(web_frontend_spa, "Web Frontend (SPA)") {
    Component(React_SPA_UI, "React SPA UI", "React, Azure Static Web Apps", "Renders user interfaces for end customers, brokers, claims adjusters, and migration product owners.")
    Component(Authentication_Manager, "Authentication Manager", "MSAL.react, OIDC/OAuth2, PKCE", "Implements authentication and Azure AD integration via Authorization Code Flow with PKCE.")
    Component(State_Caching_Manager, "State Caching Manager", "TanStack Query", "Provides local state caching to meet sub-2s performance requirements despite slow mainframe responses.")
    Component(Offline_Draft_Storage, "Offline Draft Storage", "IndexedDB, Web Crypto API (AES-GCM)", "Secures offline claim drafts locally on the client.")
    Component(Telemetry_Monitoring, "Telemetry & Monitoring", "Azure Application Insights", "Tracks client-side performance and telemetry with automated PII scrubbing.")
}

Rel(React_SPA_UI, Authentication_Manager, "Authenticates users and handles tokens", "OIDC/OAuth2")
Rel(React_SPA_UI, State_Caching_Manager, "Caches API responses and local state", "TanStack Query")
Rel(React_SPA_UI, Offline_Draft_Storage, "Persists encrypted claim drafts locally", "IndexedDB / AES-GCM")
Rel(React_SPA_UI, Telemetry_Monitoring, "Sends telemetry and performance metrics", "HTTPS")

@enduml