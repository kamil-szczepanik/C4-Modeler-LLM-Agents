@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(EndCustomersAndBrokers, "End Customers & Brokers", "External users who interact with the system to submit and manage insurance claims.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal users responsible for reviewing, processing, and handling insurance claims.")
Person(OperationsManagersAndMigrationAuditors, "Operations Managers & Migration Auditors", "Users who monitor system performance, audit migrations, and ensure compliance.")

System(NewInsuranceClaimsPlatform, "New Insurance Claims Platform", "Modern cloud-native claims platform gradually migrating claim types from a 30-year-old mainframe to a hybrid Azure environment.")

System_Ext(LegacyMainframe, "Legacy Mainframe", "30-year-old legacy system of record running COBOL and DB2.")
System_Ext(IdentityProvider, "Identity Provider", "On-premises Active Directory and Azure Entra ID providing authentication services.")
System_Ext(CentralizedAuditSink, "Centralized Audit Sink", "Azure Application Insights and Azure Immutable Blob Storage for compliance and audit logging.")

Rel(EndCustomersAndBrokers, NewInsuranceClaimsPlatform, "Interact with the web application to submit and track claims", "HTTPS / REST")
Rel(ClaimsAdjusters, NewInsuranceClaimsPlatform, "Process and manage claims through the new UI", "HTTPS / REST")
Rel(OperationsManagersAndMigrationAuditors, NewInsuranceClaimsPlatform, "Monitor migration metrics and audit logs", "HTTPS / REST")
Rel(NewInsuranceClaimsPlatform, LegacyMainframe, "Communicates asynchronously across hybrid boundaries", "Azure Service Bus / Enterprise API Gateway")
Rel(NewInsuranceClaimsPlatform, IdentityProvider, "Authenticates users and validates tokens", "OpenID Connect / OAuth 2.0 / mTLS")
Rel(NewInsuranceClaimsPlatform, CentralizedAuditSink, "Logs claim state transitions using WORM policies", "Azure Immutable Blob Storage")
@enduml