@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(CustomersPolicyholders, "Customers (Policyholders)", "External users submitting claims online.")
Person(Brokers, "Brokers", "External partners submitting and tracking claims.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal users processing claims via the web application.")

System(InsuranceClaimsModernizationPlatform, "Insurance Claims Modernization Platform", "A modern Azure-hosted platform gradually replacing a legacy mainframe while maintaining continuous operations, zero data loss, and rapid rollbacks.")

System_Ext(LegacyMainframe, "Legacy Mainframe", "On-premises COBOL/DB2 system of record.")
System_Ext(IdentityProvider, "Identity Provider", "Active Directory / Microsoft Entra ID for authentication.")

Rel(CustomersPolicyholders, InsuranceClaimsModernizationPlatform, "Submits claims online", "HTTPS / TLS 1.3 via Azure Front Door and Web UI")
Rel(Brokers, InsuranceClaimsModernizationPlatform, "Submits and tracks claims", "HTTPS / TLS 1.3 via Azure Front Door and Web UI")
Rel(ClaimsAdjusters, InsuranceClaimsModernizationPlatform, "Processes claims via web application", "HTTPS / TLS 1.3 via Azure Front Door and Web UI")
Rel(InsuranceClaimsModernizationPlatform, IdentityProvider, "Authenticates users and provides Single Sign-On (SSO)", "OIDC / OAuth 2.0")
Rel(InsuranceClaimsModernizationPlatform, LegacyMainframe, "Synchronizes and migrates claim data via Anti-Corruption Layer", "Azure ExpressRoute and mutual TLS (mTLS)")

@enduml