@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Frontend SPA container

Container_Boundary(frontend_spa, "Frontend SPA") {
    Component(routing_shell, "Routing & Shell Component", "React / TypeScript", "Provides layout, navigation, and shell structure for the application.")
    Component(claim_submission, "Claim Submission Module", "React / TypeScript / TanStack Query", "Allows customers and brokers to submit and track insurance claims.")
    Component(adjuster_workbench, "Adjuster Workbench Module", "React / TypeScript / TanStack Query", "Provides tools for claims adjusters and support agents to process claims.")
    Component(feature_flag, "Feature Flag & Migration Service", "TypeScript", "Manages incremental claim type migration and feature toggles.")
    Component(auth_client, "Auth Client Module", "MSAL.js", "Handles OIDC / OAuth2 SSO authentication with the Identity Provider.")
    Component(api_client, "API Client Service", "TypeScript / HTTPS / WebSockets", "Communicates with the API Gateway for REST requests and real-time updates.")
}

Rel(routing_shell, claim_submission, "Renders")
Rel(routing_shell, adjuster_workbench, "Renders")
Rel(claim_submission, api_client, "Sends API requests via")
Rel(adjuster_workbench, api_client, "Sends API requests via")
Rel(routing_shell, auth_client, "Authenticates via")
Rel(feature_flag, claim_submission, "Controls availability of")

@enduml