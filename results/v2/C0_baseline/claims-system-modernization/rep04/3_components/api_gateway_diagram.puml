@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(APIManagementGateway, "API Management Gateway", "Azure API Management", "Managed API gateway for policy routing, rate limiting, OAuth2 JWT validation, and TLS termination, routing modern traffic to the backend service and legacy traffic to the mainframe integration adapter while streaming telemetry to application insights.")
}

System_Ext(BackendService, "Backend Service", "Modular Monolith .NET Core")
System_Ext(MainframeIntegrationAdapter, "Mainframe Integration Adapter", "Azure Functions")
System_Ext(AzureApplicationInsights, "Azure Application Insights", "Application Performance Monitoring")

Rel(APIManagementGateway, BackendService, "Routes modern traffic via HTTPS over mTLS/VNet")
Rel(APIManagementGateway, MainframeIntegrationAdapter, "Routes legacy traffic via HTTPS over mTLS/VNet")
Rel(APIManagementGateway, AzureApplicationInsights, "Streams telemetry via HTTPS")

@enduml