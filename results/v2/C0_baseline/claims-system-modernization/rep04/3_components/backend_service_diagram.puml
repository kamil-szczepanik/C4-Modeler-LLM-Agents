@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Backend Service container

Container_Boundary(backend_service, "Backend Service") {
    Component(Claim_Management_Module, "Claim Management Module", ".NET Class Library", "Enforces strict module boundaries and transactional outbox pattern for insurance claims.")
    Component(Anti_Corruption_Layer_ACL_Component, "Anti-Corruption Layer (ACL) Component", ".NET Component", "Translates and isolates legacy mainframe data models.")
    Component(Feature_Flag_Routing_Engine, "Feature Flag & Routing Engine", ".NET Component", "Manages feature rollouts and routes migrated claim types.")
    Component(Caching_Read_Model_Store, "Caching / Read-Model Store", ".NET Component / Caching", "Isolates legacy mainframe latency through caching and fast read-models.")
    Component(Audit_Outbox_Component, "Audit & Outbox Component", ".NET Component", "Handles distributed tracing, audit logs, and transactional outbox pattern for zero data loss.")
}

Rel(Claim_Management_Module, Anti_Corruption_Layer_ACL_Component, "Translates legacy data structures via")
Rel(Claim_Management_Module, Audit_Outbox_Component, "Publishes domain events using")
Rel(Feature_Flag_Routing_Engine, Claim_Management_Module, "Routes requests to")
Rel(Claim_Management_Module, Caching_Read_Model_Store, "Reads and writes optimized models via")

@enduml