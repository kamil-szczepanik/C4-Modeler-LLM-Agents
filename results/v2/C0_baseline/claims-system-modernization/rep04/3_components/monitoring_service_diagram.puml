@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Monitoring Service container

System_Ext(BackendService, "Backend Service", "External backend services")
System_Ext(MainframeIntegrationAdapter, "Mainframe Integration Adapter", "External mainframe integration adapter")

Container_Boundary(MonitoringService, "Monitoring Service") {
    Component(TelemetryCollectorComponent, "Telemetry Collector Component", "Application Insights SDK / OpenTelemetry", "Gathers application traces and metrics from backend services via HTTPS.")
    Component(TelemetryProcessorComponent, "Telemetry Processor Component", "Application Insights Telemetry Initializer", "Passes raw telemetry for sanitization in-memory.")
    Component(LogAnalyticsWorkspace, "Log Analytics Workspace", "Azure Log Analytics", "Persists sanitized logs and metrics via Azure Internal Storage API.")
    Component(AlertActionGroups, "Alert Action Groups", "Azure Monitor Action Groups", "Evaluates KQL rules to trigger notifications via Azure Event Grid.")
    Component(MainframeIntegrationWebtest, "Mainframe Integration Webtest", "Azure Application Insights Availability Tests", "Periodically pings integration path via HTTPS.")
}

Rel(BackendService, TelemetryCollectorComponent, "Forwards application traces and metrics", "HTTPS / OpenTelemetry")
Rel(TelemetryCollectorComponent, TelemetryProcessorComponent, "Passes raw telemetry for sanitization", "in-memory")
Rel(TelemetryProcessorComponent, LogAnalyticsWorkspace, "Persists sanitized logs and metrics", "Azure Internal Storage API")
Rel(LogAnalyticsWorkspace, AlertActionGroups, "Evaluates KQL rules to trigger notifications", "Azure Event Grid")
Rel(MainframeIntegrationWebtest, MainframeIntegrationAdapter, "Periodically pings integration path", "HTTPS")

@enduml