@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(backend_service, "Backend Service / Integration Adapter", "External caller/consumer from the modular monolith or integration adapter.")

Container_Boundary(secrets_management, "Secrets Management") {
    Component(azure_key_vault, "Azure Key Vault", "Azure Key Vault", "Centralizes secure credential management and stores active secret versions.")
    Component(azure_app_configuration_sdk, "Azure App Configuration SDK", "Azure App Configuration", "Handles configuration refresh and webhook-driven cache invalidation to prevent stale connection pooling.")
    Component(secret_rotator_function, "Secret Rotator Function", "Azure Functions (.NET / C#)", "Executes automated, zero-downtime credential rotation for Azure SQL Database and external APIs.")
}

Rel(backend_service, azure_key_vault, "Retrieves active secret versions via Private Endpoint using Managed Identity", "Azure SDK / Managed Identity")
Rel(backend_service, azure_app_configuration_sdk, "Polls or receives webhooks for secret version changes", "HTTPS/TLS")
Rel(secret_rotator_function, azure_key_vault, "Updates and rotates credentials", "HTTPS/TLS")

@enduml