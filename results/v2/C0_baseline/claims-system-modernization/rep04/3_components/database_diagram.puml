@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database container

System_Ext(BackendService, "Backend Service", "External backend service interacting with the database.")
System_Ext(MainframeIntegrationAdapter, "Mainframe Integration Adapter", "Legacy adapter for bulk data staging.")
System_Ext(AzureKeyVault, "Azure Key Vault", "Secures Customer-Managed Keys (CMK) for Transparent Data Encryption (TDE).")

Container_Boundary(Database, "Database") {
    Component(ClaimOperationalStore, "Claim Operational Store", "Azure SQL Tables", "Provides relational storage and transactional consistency for the legacy insurance claims system.")
    Component(AuditHistoryEngine, "Audit & History Engine", "System-Versioned Temporal Tables", "Tracks history and changes for claims data to support data consistency and targeted rollbacks.")
    Component(IntegrationStagingStore, "Integration Staging Store", "Azure SQL", "Handles bulk inserts and data staging from mainframe integration adapters.")
    Component(ArchivalPurgingComponent, "Archival & Purging Component", "Azure SQL Elastic Jobs", "Manages data archival and purging according to phased migration and lifecycle policies.")
}

Rel(BackendService, ClaimOperationalStore, "T-SQL / ADO.NET", "Encrypted VNet connection")
Rel(BackendService, AuditHistoryEngine, "T-SQL / ADO.NET", "Encrypted VNet connection")
Rel(MainframeIntegrationAdapter, IntegrationStagingStore, "Bulk Insert / T-SQL", "VNet Peering")
Rel(ClaimOperationalStore, AzureKeyVault, "Managed Identity / HTTPS", "Key Vault REST API")
@enduml