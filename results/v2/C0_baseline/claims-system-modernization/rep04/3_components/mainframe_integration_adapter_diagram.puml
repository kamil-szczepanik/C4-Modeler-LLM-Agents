@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("MainframeIntegrationAdapter", "Mainframe Integration Adapter") {
    Component("Adapter_API_Controller", "Adapter API Controller", "Azure Container Apps / App Service", "Receives internal routing requests from the backend service and exposes endpoints for integration.")
    Component("Polly_Resilience_Pipeline", "Polly Resilience Pipeline", "Polly", "Handles circuit breaking, retries, and exponential backoff for unstable legacy connections.")
    Component("Mainframe_Communication_Client", "Mainframe Communication Client", "mTLS / TLS 1.3", "Manages secure mTLS communication over Site-to-Site VPN/ExpressRoute with the legacy mainframe.")
    Component("Database_Integration_Manager", "Database Integration Manager", "T-SQL / VNet", "Manages database interactions and persistence with the Azure SQL Database.")
    Component("Queue_Publisher", "Queue Publisher", "Azure Service Bus Queue (AMQP)", "Buffers traffic and publishes messages to prevent data loss during mainframe unresponsiveness.")
    Component("Secrets_and_Identity_Manager", "Secrets and Identity Manager", "Azure Key Vault / Managed Identity", "Secures mTLS certificates and credentials securely via Managed Identities.")
}

Rel("Adapter_API_Controller", "Polly_Resilience_Pipeline", "Passes outgoing legacy requests through")
Rel("Polly_Resilience_Pipeline", "Mainframe_Communication_Client", "Invokes secure calls to")
Rel("Adapter_API_Controller", "Database_Integration_Manager", "Reads and writes data via")
Rel("Adapter_API_Controller", "Queue_Publisher", "Buffers offline requests via")
Rel("Mainframe_Communication_Client", "Secrets_and_Identity_Manager", "Retrieves mTLS certificates from")

@enduml