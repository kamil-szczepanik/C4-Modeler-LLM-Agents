@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Insurance Claims Modernization Platform

Person(Customers, "Customers", "Policyholders submitting claims online.")
Person(Brokers, "Brokers", "External partners submitting and tracking claims.")
Person("Claims Adjusters", "Claims Adjusters", "Internal users processing claims via the web application.")
Person("Customer Support Agents", "Customer Support Agents", "Support agents assisting with claims and inquiries.")
Person("Migration Product Managers", "Migration Product Managers", "Managers overseeing the transition and feature flag routing.")

System_Ext("Legacy Mainframe", "Legacy Mainframe", "On-premises COBOL/DB2 system of record.")
System_Ext("Identity Provider", "Identity Provider", "Azure Active Directory providing OIDC/OAuth2 authentication.")

System_Boundary("InsuranceClaimsModernizationPlatform", "Insurance Claims Modernization Platform") {
    Container("FrontendSPA", "Frontend SPA", "React / TypeScript, Azure Static Web Apps", "Single Page Application providing online claim submissions and adjuster processing interfaces.")
    Container("APIGateway", "API Gateway", ".NET Core / Envoy, CQRS", "Backend-for-Frontend (BFF) routing and handling API requests.")
    Container("BackendService", "Backend Service", "Modular Monolith .NET Core, Azure App Service", "Core business logic service running on PaaS containers.")
    Container("MainframeIntegrationAdapter", "Mainframe Integration Adapter", "Azure Functions, Polly", "Integration layer handling mainframe protocol translation and retry logic.")
    ContainerDb("Database", "Database", "Azure SQL Database", "Relational storage with temporal tables and feature-flag routing.")
    Container("SecretsManagement", "Secrets Management", "Azure Key Vault", "Centralized management for secrets, connection strings, and certificates.")
    Container("MonitoringService", "Monitoring Service", "Azure Application Insights", "Distributed tracing and monitoring for latency tracking.")
}

Rel(Customers, FrontendSPA, "Submits claims online", "HTTPS over TLS 1.3")
Rel(Brokers, FrontendSPA, "Submits and tracks claims", "HTTPS over TLS 1.3")
Rel("Claims Adjusters", FrontendSPA, "Processes claims", "HTTPS over TLS 1.3")
Rel("Customer Support Agents", FrontendSPA, "Assists with claims", "HTTPS over TLS 1.3")
Rel("Migration Product Managers", FrontendSPA, "Manages migration and feature flags", "HTTPS over TLS 1.3")

Rel(FrontendSPA, APIGateway, "Sends API requests", "HTTPS/REST with OAuth2 JWT validation")
Rel(APIGateway, BackendService, "Routes requests to business logic", "HTTPS and internal VNet routing")
Rel(BackendService, Database, "Reads and writes claim data", "T-SQL / Internal VNet")
Rel(BackendService, MainframeIntegrationAdapter, "Triggers data synchronization and coexistence tasks", "Internal VNet routing")
Rel(MainframeIntegrationAdapter, "Legacy Mainframe", "Integrates with legacy system", "Secured site-to-site VPN/ExpressRoute with TLS 1.3")
Rel(FrontendSPA, "Identity Provider", "Authenticates users", "OIDC / OAuth2 SSO")
Rel(BackendService, SecretsManagement, "Retrieves secrets and connection strings", "Azure SDK / Managed Identity")
Rel(BackendService, MonitoringService, "Sends telemetry and traces", "Application Insights SDK")

@enduml