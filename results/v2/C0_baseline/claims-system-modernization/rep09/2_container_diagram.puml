@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(Customers_Brokers, "Customers & Brokers", "External users submitting and tracking claims online.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal users managing claims via the new web application.")

System_Ext(Azure_API_Management_APIM_, "Azure API Management (APIM)", "Secure gateway managing traffic and enforcing mTLS with the on-premise mainframe.")
System_Ext(Legacy_Mainframe, "Legacy Mainframe", "On-premise COBOL/DB2 system of record.")

System_Boundary(Modern_Claims_Platform, "Modern Claims Platform") {
    Container(Customer_Portal, "Customer Portal", "React, Azure Static Web Apps", "Frontend application allowing external users to submit and track claims online.")
    Container(Adjuster_Workspace, "Adjuster Workspace", "React, Azure Static Web Apps", "Frontend application enabling internal adjusters to manage claims.")
    Container(Backend_APIs, "Backend APIs", ".NET, Azure Container Apps", "Unified serverless container runtime hosting core backend APIs.")
    Container(Migration_Sync_Engine, "Migration & Sync Engine", ".NET, Azure Container Apps", "Engine managing data synchronization and gradual migration with the legacy mainframe.")
    Container(Integration_Workers, "Integration Workers", ".NET, Azure Container Apps", "Background workers handling asynchronous event processing.")
    Container(Azure_Service_Bus, "Azure Service Bus", "Azure Service Bus", "Messaging backbone supporting asynchronous CQRS and reliable event streaming.")
    ContainerDb(Azure_SQL_Database, "Azure SQL Database", "SQL Server, Entity Framework Core", "Modern datastore for modern claim types utilizing Transparent Data Encryption (TDE).")
}

Rel(Customers_Brokers, Azure_API_Management_APIM_, "Interact with the Customer Portal via HTTPS/JSON routed through APIM", "HTTPS/JSON")
Rel(Claims_Adjusters, Azure_API_Management_APIM_, "Interact with the Adjuster Workspace via HTTPS/JSON routed through APIM", "HTTPS/JSON")
Rel(Azure_API_Management_APIM_, Customer_Portal, "Routes external traffic to", "HTTPS")
Rel(Azure_API_Management_APIM_, Adjuster_Workspace, "Routes external traffic to", "HTTPS")
Rel(Customer_Portal, Backend_APIs, "Calls backend APIs for data and operations", "HTTPS/JSON")
Rel(Adjuster_Workspace, Backend_APIs, "Calls backend APIs for data and operations", "HTTPS/JSON")
Rel(Backend_APIs, Azure_SQL_Database, "Reads and writes modern claim types", "Entity Framework Core")
Rel(Backend_APIs, Azure_Service_Bus, "Publishes and consumes asynchronous messages", "AMQP")
Rel(Integration_Workers, Azure_Service_Bus, "Processes asynchronous messages", "AMQP")
Rel(Migration_Sync_Engine, Azure_Service_Bus, "Publishes and consumes sync events", "AMQP")
Rel(Migration_Sync_Engine, Azure_API_Management_APIM_, "Connects to the legacy system via APIM", "mTLS and IP whitelisting")
Rel(Azure_API_Management_APIM_, Legacy_Mainframe, "Enforces mTLS and manages traffic to the on-premise system of record", "mTLS / HTTPS")

@enduml