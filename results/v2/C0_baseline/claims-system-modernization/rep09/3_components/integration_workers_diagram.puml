@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Workers container

Container_Boundary(integration_workers, "Integration Workers") {
    Component(Message_Router_Component, "Message Router Component", ".NET / MassTransit", "Consumes and publishes asynchronous messages and evaluates claim type routing rules.")
    Component(Mainframe_Sync_Adaptor_Component, "Mainframe Sync Adaptor Component", ".NET / Polly", "Synchronizes legacy payloads, enforces rate-limiting, and retrieves mTLS certificates and credentials.")
    Component(Audit___Reconciliation_Component, "Audit & Reconciliation Component", ".NET / EF Core", "Writes cryptographically hashed, append-only audit logs to Azure SQL Database.")
    Component(Claim_State_Evaluator_Component, "Claim State Evaluator Component", ".NET", "Evaluates claim type routing rules in-process.")
    Component(Telemetry_Publisher_Component, "Telemetry Publisher Component", ".NET / OpenTelemetry", "Exports worker lag, metrics, and structured logs to Azure Application Insights.")
}

System_Ext(Azure_Service_Bus, "Azure Service Bus", "Azure Messaging", "Facilitates asynchronous messaging for the message router.")
System_Ext(Azure_SQL_Database, "Azure SQL Database", "Azure SQL", "Stores cryptographically hashed, append-only audit logs.")
System_Ext(Azure_Key_Vault, "Azure Key Vault", "Azure Security", "Provides secure secret management via Managed Identities.")
System_Ext(Azure_Application_Insights, "Azure Application Insights", "Azure Monitoring", "Collects telemetry, metrics, and structured logs.")
System_Ext(Legacy_Mainframe, "Legacy Mainframe", "Mainframe", "System of record for legacy insurance data.")

Rel(Message_Router_Component, Azure_Service_Bus, "Consumes and publishes asynchronous messages", "AMQP")
Rel(Message_Router_Component, Claim_State_Evaluator_Component, "Evaluates claim type routing rules", "In-process")
Rel(Mainframe_Sync_Adaptor_Component, Legacy_Mainframe, "Synchronizes legacy payloads and enforces rate-limiting", "mTLS/HTTPS")
Rel(Mainframe_Sync_Adaptor_Component, Azure_Key_Vault, "Retrieves mTLS certificates and credentials", "Managed Identity")
Rel(Audit___Reconciliation_Component, Azure_SQL_Database, "Writes cryptographically hashed, append-only audit logs", "EF Core/T-SQL")
Rel(Telemetry_Publisher_Component, Azure_Application_Insights, "Exports worker lag, metrics, and structured logs", "OpenTelemetry")
@enduml