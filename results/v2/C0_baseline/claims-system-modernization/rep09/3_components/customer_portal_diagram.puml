@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Customer Portal container

System_Ext(azure_ad, "Azure AD", "Azure Active Directory")
System_Ext(backend_apis, "Backend APIs", ".NET, Azure Container Apps")
System_Ext(azure_blob_storage, "Azure Blob Storage", "Secure binary file storage")

Container_Boundary(customer_portal, "Customer Portal") {
    Component(auth_client, "Customer Portal (Authentication Client)", "MSAL.js", "Client-side authentication and role-aware session management via Azure AD.")
    Component(submission_controller, "Customer Portal (Claim Submission Controller)", "React & React Hook Form with Zod", "Frontend UI and multi-step claim validation for submitting claim payloads.")
    Component(upload_manager, "Customer Portal (Document Upload Manager)", "React", "Uploads binaries via server-brokered SAS tokens to Azure Blob Storage.")
    Component(tracker_dashboard, "Customer Portal (Claim Tracker Dashboard)", "React", "Fetches claim status via polling.")
}

Rel(auth_client, azure_ad, "Authenticates users", "OIDC/OAuth2 via HTTPS")
Rel(submission_controller, backend_apis, "Submits claim payloads", "HTTPS/JSON")
Rel(upload_manager, azure_blob_storage, "Uploads binaries via server-brokered SAS tokens", "HTTPS")
Rel(tracker_dashboard, backend_apis, "Fetches claim status via polling", "HTTPS/JSON")

@enduml