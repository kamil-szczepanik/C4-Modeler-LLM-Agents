@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure SQL Database container

System_Ext(Backend_APIs, "Backend APIs", "External system accessing the database")
System_Ext(Migration_Sync_Engine, "Migration & Sync Engine", "External system accessing the database")
System_Ext(Integration_Workers, "Integration Workers", "External system accessing the database")

Container_Boundary(Azure_SQL_Database, "Azure SQL Database") {
    Component(Claims_Core_Module, "Claims Core Module", "Relational tables with Temporal Tables", "Handles core claim types, domain logic, and provides auditability via built-in temporal features.")
    Component(Sync_Integration_Module, "Sync & Integration Module", "Idempotency and outbox pattern tables", "Manages sync states and mirrored data to bridge the modern Azure environment with the legacy mainframe.")
    Component(Performance_Views, "Performance Views", "Indexed views", "Provides optimized data access to ensure sub-2-second adjuster screen loads.")
}

Rel(Backend_APIs, Claims_Core_Module, "Reads and writes modern claim types", "Entity Framework Core / T-SQL")
Rel(Migration_Sync_Engine, Sync_Integration_Module, "Reads/Writes sync states and mirrored data", "T-SQL / EF Core")
Rel(Integration_Workers, Claims_Core_Module, "Updates claim processing status", "EF Core / T-SQL")

@enduml