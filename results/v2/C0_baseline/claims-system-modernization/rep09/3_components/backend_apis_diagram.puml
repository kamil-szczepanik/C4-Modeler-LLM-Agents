@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Backend APIs container

Container_Boundary(backend_apis, "Backend APIs") {
    Component(ClaimRoutingComponent, "Claim Routing Component", ".NET / MediatR / Azure App Configuration", "Routes claims and handles dynamic feature flags for gradual migration.")
    Component(ReadModelCachingComponent, "Read Model & Caching Component", ".NET / Redis / Azure SQL", "Provides high-performance caching and relational persistence for sub-2s response times.")
    Component(CommandProcessingComponent, "Command Processing Component", ".NET / FluentValidation", "Processes commands and ensures data validation.")
    Component(APIGatewayControllerLayer, "API Gateway Controller Layer", ".NET / ASP.NET Core", "Core application framework for unified backend APIs.")
    Component(MainframeACLClient, "Mainframe Anti-Corruption Layer (ACL) Client", ".NET / Polly", "Manages integration with the legacy mainframe using resilience policies.")
}

System_Ext(AzureServiceBus, "Azure Service Bus", "Asynchronous message broker ensuring consistency")
System_Ext(AzureSQLDatabase, "Azure SQL Database", "Relational database service")

Rel(ClaimRoutingComponent, ReadModelCachingComponent, "In-Process / MediatR", "In-Process")
Rel(ClaimRoutingComponent, CommandProcessingComponent, "In-Process / MediatR", "In-Process")
Rel(CommandProcessingComponent, AzureServiceBus, "AMQP", "AMQP")
Rel(backend_apis, AzureSQLDatabase, "Entity Framework Core / Managed Identity", "HTTPS")

@enduml