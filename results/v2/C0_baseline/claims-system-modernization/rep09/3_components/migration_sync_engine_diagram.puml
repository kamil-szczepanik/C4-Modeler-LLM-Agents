@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Migration & Sync Engine container

Container_Boundary(migration_sync_engine, "Migration & Sync Engine") {
    Component(SyncCoordinator, "Sync Coordinator", ".NET, MassTransit, Microsoft.FeatureManagement, Entity Framework Core", "Manages data synchronization and robust messaging patterns with outbox pattern for zero-loss transactions.")
    Component(TransformationAdapter, "Transformation Adapter", "AutoMapper, Polly", "Handles schema transformations and provides resilient circuit breakers for fragile mainframe calls.")
    Component(ReconciliationWorker, "Reconciliation Worker", ".NET background service", "Performs reconciliation processes to ensure consistency between systems.")
    Component(RoutingPolicyEngine, "Routing & Policy Engine", "Azure App Configuration", "Enables dynamic runtime claim-type routing and rapid rollbacks.")
    Component(MigrationOperatorDashboard, "Migration Operator Dashboard", "React, Azure Static Web Apps", "Exposes sync metrics and rollback controls to operations teams.")
}

Rel(SyncCoordinator, TransformationAdapter, "Sends payloads for transformation")
Rel(TransformationAdapter, ReconciliationWorker, "Provides processed data for consistency checks")
Rel(RoutingPolicyEngine, SyncCoordinator, "Supplies dynamic routing policies and feature flags")
Rel(MigrationOperatorDashboard, SyncCoordinator, "Exposes sync metrics and triggers rollback controls")

@enduml