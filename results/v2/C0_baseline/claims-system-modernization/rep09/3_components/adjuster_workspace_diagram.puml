@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Adjuster Workspace container

System_Ext(azure_apim, "Azure API Management (APIM)", "Routes external traffic securely")
System_Ext(backend_apis, "Backend APIs", "Handles data operations")
System_Ext(external_idp, "External Identity Provider", "Azure Active Directory")

Container_Boundary(adjuster_workspace, "Adjuster Workspace") {
    Component(claim_management_module, "Claim Management Module", "React / Redux", "Core UI component managing state, keyboard-first navigation, and optimistic UI updates.")
    Component(hybrid_data_adapter, "Hybrid Data Adapter", "TypeScript / Data Abstraction Layer", "Data abstraction layer handling mixed data sourcing from Azure SQL and the Legacy Mainframe.")
    Component(auth_integration_client, "Auth Integration Client", "MSAL.js", "Authentication component enforcing Azure Active Directory single sign-on (R-07).")
    Component(offline_sync_manager, "Offline Sync Manager", "IndexedDB / TypeScript", "Component intercepting mutations during network drops, utilizing IndexedDB for local caching and auto-syncing.")
    Component(audit_banner_component, "Audit Banner Component", "React", "Persistent UI element indicating whether an active claim resides in Azure or the Legacy Mainframe.")
    Component(react_error_boundaries, "React Error Boundaries", "React", "Operational wrapper catching client-side rendering and IndexedDB errors.")
}

Rel(azure_apim, claim_management_module, "Routes external traffic securely", "HTTPS")
Rel(claim_management_module, hybrid_data_adapter, "Fetches and mutates claim records", "TypeScript")
Rel(hybrid_data_adapter, backend_apis, "Communicates for data operations via APIM", "HTTPS/JSON")
Rel(auth_integration_client, external_idp, "Validates tokens via Azure Active Directory", "OpenID Connect")
Rel(claim_management_module, offline_sync_manager, "Delegates offline mutations during network disconnection", "TypeScript")
Rel(claim_management_module, audit_banner_component, "Renders truth-status metadata", "React Props")

@enduml