@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers_and_Brokers, "Customers & Brokers", "External users submitting claims online.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal users handling claims via the modern web application.")
Person(Migration_Operators, "Migration Operators", "Risk and operations staff managing data consistency and rollbacks.")

System(Modern_Claims_Platform, "Modern Claims Platform", "A modern cloud-native platform gradually replacing a 30-year-old COBOL/DB2 mainframe claims system in a hybrid environment, ensuring business continuity, data consistency, and single sign-on.")

System_Ext(Legacy_Mainframe, "Legacy Mainframe", "On-premise COBOL/DB2 system of record.")
System_Ext(External_Identity_Provider, "External Identity Provider", "On-premises Active Directory managing single sign-on and identity federation.")
System_Ext(Azure_API_Management_APIM, "Azure API Management (APIM)", "Gateway acting as the single secure entry point, centralizing ingress, mTLS enforcement, OAuth2 token validation, and rate-limiting.")
System_Ext(Azure_Service_Bus, "Azure Service Bus", "Asynchronous integration broker handling reliable messaging and dead-letter queuing to respect the mainframe batch window.")
System_Ext(Azure_Application_Insights, "Azure Application Insights", "Provides centralized logging and distributed tracing for operational observability.")

Rel(Customers_and_Brokers, Azure_API_Management_APIM, "Submit claims online", "HTTPS")
Rel(Claims_Adjusters, Azure_API_Management_APIM, "Handle claims via the modern web application", "HTTPS")
Rel(Migration_Operators, Modern_Claims_Platform, "Manage data consistency and rollbacks", "HTTPS")
Rel(Azure_API_Management_APIM, Modern_Claims_Platform, "Integrates with the modern claims platform", "REST/gRPC")
Rel(Modern_Claims_Platform, Legacy_Mainframe, "Connects via asynchronous messaging", "Azure Service Bus over TLS 1.3 and mTLS")
Rel(Modern_Claims_Platform, External_Identity_Provider, "Authenticates users against Active Directory", "OIDC/SAML")

@enduml