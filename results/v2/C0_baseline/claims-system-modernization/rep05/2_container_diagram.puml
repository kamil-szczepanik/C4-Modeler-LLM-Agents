@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Insurance Claims Modernization Platform

Person(PolicyholderBroker, "Policyholder / Broker", "Users who submit online claims.")
Person(ClaimsAdjuster, "Claims Adjuster", "Internal users who handle claims via the new web application.")

System_Ext(LegacyMainframe, "Legacy Mainframe (COBOL/DB2)", "On-premise 30-year-old system acting as the system of record.")
System_Ext(ActiveDirectory, "Active Directory / Entra ID", "Corporate identity provider for Single Sign-On.")

System_Boundary(InsuranceClaimsModernizationPlatform, "Insurance Claims Modernization Platform") {
    Container(AzureAPIManagement, "Azure API Management / Migration Router", "Azure API Management", "Single entry point and dynamic claim-type routing.")
    Container(AzureStaticWebApps, "Azure Static Web Apps / React Claims Web App", "React / Azure Static Web Apps", "Modern, responsive frontend for claims submission and handling.")
    Container(AzureContainerAppsAdjusterBackend, "Azure Container Apps (Adjuster Backend)", "Azure Container Apps", "Scalable hosting for backend microservices.")
    Container(AzureContainerAppsMainframeIntegrationAdapter, "Azure Container Apps (Mainframe Integration Adapter)", "Azure Container Apps", "Adapter to connect securely to the legacy mainframe.")
    Container(MigrationControlService, "Azure App Service & Azure Cosmos DB (Migration Control Service)", "Azure App Service & Azure Cosmos DB", "Manages routing rules and audit reconciliation tracking.")
    Container(AzureServiceBusAzureFunctions, "Azure Service Bus & Azure Functions (Integration & Sync Service)", "Azure Service Bus & Azure Functions", "Event-driven asynchronous synchronization.")
    Container(AzureKeyVault, "Azure Key Vault", "Azure Key Vault", "Secure secrets management.")
}

Rel(PolicyholderBroker, AzureAPIManagement, "Accesses Claims Web App via HTTPS", "HTTPS")
Rel(ClaimsAdjuster, AzureStaticWebApps, "Interacts with Claims Web App using OAuth 2.0 / OIDC", "REST/GraphQL / OAuth 2.0 / OIDC")
Rel(AzureAPIManagement, AzureContainerAppsMainframeIntegrationAdapter, "Dynamically routes traffic", "HTTPS")
Rel(AzureAPIManagement, AzureContainerAppsAdjusterBackend, "Dynamically routes traffic", "HTTPS")
Rel(AzureContainerAppsMainframeIntegrationAdapter, LegacyMainframe, "Connects securely with IP whitelisting", "TLS 1.3 with mTLS")
Rel(AzureServiceBusAzureFunctions, AzureContainerAppsAdjusterBackend, "Communicates asynchronously", "Azure Service Bus")
Rel(MigrationControlService, AzureCosmosDB, "Manages routing rules stored in database", "Cosmos DB SDK")
@enduml