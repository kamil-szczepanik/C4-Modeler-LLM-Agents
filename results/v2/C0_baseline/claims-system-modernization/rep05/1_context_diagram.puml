@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Policyholder_Broker, "Policyholder / Broker", "Users who submit online claims.")
Person(Claims_Adjuster, "Claims Adjuster", "Internal users who handle claims via the new web application.")

System(Insurance_Claims_Modernization_Platform, "Insurance Claims Modernization Platform", "A modern cloud-native platform on Microsoft Azure West Europe replacing a legacy COBOL/DB2 mainframe claims system using a hybrid architecture and Strangler Fig pattern.")

System_Ext(Legacy_Mainframe, "Legacy Mainframe", "On-premise COBOL/DB2 system acting as the system of record.")
System_Ext(Active_Directory_Entra_ID, "Active Directory / Entra ID", "Corporate identity provider for Single Sign-On.")
System_Ext(Notification_Service, "Notification Service", "Third-party email and SMS gateway.")
System_Ext(Payment_Gateway, "Payment Gateway", "Enterprise financial system for payouts.")

Rel(Policyholder_Broker, Insurance_Claims_Modernization_Platform, "Submit online claims.", "HTTPS/TLS")
Rel(Claims_Adjuster, Insurance_Claims_Modernization_Platform, "Handle claims via the new web application.", "HTTPS/TLS")
Rel(Insurance_Claims_Modernization_Platform, Legacy_Mainframe, "Asynchronous messaging/ETL during batch window.", "mTLS")
Rel(Legacy_Mainframe, Insurance_Claims_Modernization_Platform, "Asynchronous messaging/ETL during batch window.", "mTLS")
Rel(Insurance_Claims_Modernization_Platform, Active_Directory_Entra_ID, "Single Sign-On authentication.", "OIDC/OAuth 2.0")
Rel(Insurance_Claims_Modernization_Platform, Notification_Service, "Customer updates via API Management.", "HTTPS/REST")
Rel(Insurance_Claims_Modernization_Platform, Payment_Gateway, "Disbursement tracking via API Management.", "HTTPS/REST")

@enduml