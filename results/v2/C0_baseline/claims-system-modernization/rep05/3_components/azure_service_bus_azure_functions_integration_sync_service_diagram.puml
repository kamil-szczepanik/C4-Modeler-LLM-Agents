@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Service Bus & Azure Functions container

Container_Boundary(azure_service_bus_and_azure_functions, "Azure Service Bus & Azure Functions") {
    Component(ClaimEventTopic, "Claim Event Topic", "Azure Service Bus Topic", "Managed pub/sub messaging topic for claim lifecycle event routing using AMQP.")
    Component(SyncOrchestratorFunction, "Sync Orchestrator Function", "Azure Functions (C# isolated worker)", "Serverless event processing component handling asynchronous synchronization and integration.")
    Component(DeadLetterManagerFunction, "Dead-Letter Manager Function", "Azure Functions", "Handles dead-letter queues and robust error handling for failed messages.")
    Component(SyncMetricsAuditPublisherFunction, "Sync Metrics & Audit Publisher Function", "Azure Functions", "Publishes telemetry, W3C distributed tracing, and operational audit logs.")
}

System_Ext(AzureCosmosDBAndMainframeIntegrationAdapter, "Azure Cosmos DB & Mainframe Integration Adapter", "External system container")
System_Ext(ApplicationInsights, "Application Insights", "External system or container for telemetry")

Rel(ClaimEventTopic, SyncOrchestratorFunction, "Pub/sub claim lifecycle event routing using AMQP", "AMQP")
Rel(SyncOrchestratorFunction, AzureCosmosDBAndMainframeIntegrationAdapter, "State synchronization and event processing via HTTP/Service Bus", "HTTP/Service Bus")
Rel(SyncOrchestratorFunction, ApplicationInsights, "Telemetry, distributed W3C tracing, and operational audit publishing", "HTTPS")
Rel(DeadLetterManagerFunction, ApplicationInsights, "Telemetry, distributed W3C tracing, and operational audit publishing", "HTTPS")
Rel(SyncMetricsAuditPublisherFunction, ApplicationInsights, "Telemetry, distributed W3C tracing, and operational audit publishing", "HTTPS")

@enduml