@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Static Web Apps / React Claims Web App container

Container_Boundary(react_claims_web_app, "Azure Static Web Apps / React Claims Web App") {
    Component(React_Claims_Single_Page_App, "React Claims Single Page App", "React & TypeScript", "Responsive frontend interface providing claim management capabilities for adjusters and brokers.")
    Component(MSAL_js_Authentication_Module, "MSAL.js Authentication Module", "MSAL.js & Azure AD", "Handles secure single sign-on authentication and enforces strict token memory-only storage.")
}

Rel(MSAL_js_Authentication_Module, React_Claims_Single_Page_App, "Provides authentication tokens", "")

@enduml