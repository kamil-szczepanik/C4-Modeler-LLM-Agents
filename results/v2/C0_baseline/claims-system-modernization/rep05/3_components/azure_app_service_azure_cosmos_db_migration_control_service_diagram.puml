@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(migration_control_service, "Azure App Service & Azure Cosmos DB (Migration Control Service)") {
    Component(Migration_API_Controller, "Migration API Controller", ".NET 8 / REST", "Exposes REST endpoints for routing rules.")
    Component(Reconciliation_Engine, "Reconciliation Engine", ".NET 8", "Compares Cosmos DB state with DB2 audit logs.")
    Component(Control_Dashboard_Backend, "Control Dashboard Backend", ".NET 8", "Serves APIs for live monitoring and rollbacks.")
    Component(State_Store, "State Store", "Azure Cosmos DB", "Stores routing tables and migration state.")
    Component(Audit_Compliance_Logger, "Audit & Compliance Logger", ".NET 8", "Captures rule modifications with user context.")
    Component(Alert_Dispatcher, "Alert Dispatcher", ".NET 8", "Translates sync drifts into operational incidents.")
}

System_Ext(Migration_Router_Integration_Service, "Migration Router & Integration Service", "External migration router and integration service")
System_Ext(Azure_Entra_ID, "Azure Entra ID", "Identity and access management")
System_Ext(Azure_Key_Vault, "Azure Key Vault", "Secret and key management")

Rel(Migration_Router_Integration_Service, Migration_API_Controller, "HTTPS (REST) via Private Endpoints", "HTTPS")
Rel(Reconciliation_Engine, State_Store, "Cosmos DB Change Feed over TLS 1.3", "TLS 1.3")
Rel(Control_Dashboard_Backend, Azure_Entra_ID, "HTTPS (OAuth 2.0 / OIDC) for RBAC", "HTTPS")
Rel(migration_control_service, Azure_Key_Vault, "HTTPS for secret/key retrieval", "HTTPS")

@enduml