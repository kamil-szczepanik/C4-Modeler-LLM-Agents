@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Key Vault container

System_Ext(Adjuster_Backend_Mainframe_Integration_Adapter, "Adjuster Backend & Mainframe Integration Adapter", "External system container interacting with Azure Key Vault.")
System_Ext(On_premises_legacy_mainframe, "On-premises legacy mainframe", "Legacy mainframe system accessing Azure Key Vault via private networking.")
System_Ext(Azure_Entra_ID, "Azure Entra ID", "External identity provider for validation.")
System_Ext(Azure_Monitor, "Azure Monitor", "External monitoring and logging service.")

Container_Boundary(Azure_Key_Vault, "Azure Key Vault") {
    Component(Secrets_Engine_Component, "Secrets Engine Component", "Azure Key Vault (Premium Tier, HSM-backed)", "Manages secrets, credentials, and cryptographic keys ensuring data consistency and regulatory compliance.")
    Component(Access_Control_Component, "Access Control Component", "Azure Entra ID & Azure RBAC", "Handles identity validation and enforces least-privilege access.")
    Component(Audit___Diagnostics_Component, "Audit & Diagnostics Component", "Azure Monitor", "Streams diagnostic logs and secret lifecycle events.")
}

Rel(Adjuster_Backend_Mainframe_Integration_Adapter, Secrets_Engine_Component, "Interacts via Azure REST API over HTTPS (TLS 1.3)", "Azure Managed Identities and Azure RBAC")
Rel(On_premises_legacy_mainframe, Secrets_Engine_Component, "Accesses exclusively", "Azure Private Link (ExpressRoute/VPN)")
Rel(Secrets_Engine_Component, Audit___Diagnostics_Component, "Streams diagnostic logs and secret lifecycle events", "HTTPS")
Rel(Access_Control_Component, Azure_Entra_ID, "Integrates for identity validation", "API")
@enduml