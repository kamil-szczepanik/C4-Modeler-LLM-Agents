@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Container Apps (Adjuster Backend) container

Container_Boundary("Azure_Container_Apps_Adjuster_Backend", "Azure Container Apps (Adjuster Backend)") {
    Component("Claim_Management_Component", "Claim Management Component", "ASP.NET Core Minimal APIs / Entity Framework Core", "Implements adjuster business logic and handles core domain events.")
    Component("Read_Side_Query_Component", "Read-Side Query Component", "CQRS Pattern / ASP.NET Core", "Queries local projections to guarantee sub-2-second responses.")
    Component("Integration_Adapter_Component", "Integration Adapter Component", "MassTransit / .NET", "Dispatches domain events and syncs claim data with the legacy mainframe.")
    Component("Security___Context_Middleware", "Security & Context Middleware", "ASP.NET Core Middleware / Azure Entra ID / JWT", "Enforces single sign-on, role-based access control, and passes authenticated context.")
}

Rel("Security___Context_Middleware", "Claim_Management_Component", "Passes authenticated context", "In-Process")
Rel("Claim_Management_Component", "Integration_Adapter_Component", "Dispatches domain events", "In-Process")

@enduml