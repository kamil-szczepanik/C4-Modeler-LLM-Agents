@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(azure_container_apps_mainframe_integration_adapter, "Azure Container Apps (Mainframe Integration Adapter)") {
    Component(MainframeAdapterAPIRouter, "Mainframe Adapter API Router", "Azure Container Apps / ASP.NET Core", "Receives dynamically routed traffic from Azure API Management and handles request processing.")
    Component(TransformationMappingEngine, "Transformation & Mapping Engine", ".NET Core", "Transforms modern requests into legacy mainframe formats and maps responses.")
    Component(MainframeSecureConnector, "Mainframe Secure Connector", "TLS 1.3 with mTLS", "Establishes secure, authenticated connections to the legacy mainframe.")
    Component(MappingAuditPublisher, "Mapping Audit Publisher", ".NET Async Client", "Forwards validation errors and audit events asynchronously.")
}

System_Ext(AzureServiceBus, "Azure Service Bus", "Async Event Messaging")

Rel(MainframeAdapterAPIRouter, TransformationMappingEngine, "Delegates payload transformation", "In-memory")
Rel(TransformationMappingEngine, MainframeSecureConnector, "Sends formatted requests", "TLS 1.3 with mTLS")
Rel(TransformationMappingEngine, MappingAuditPublisher, "Forwards validation errors", "In-memory / Async")
Rel(MappingAuditPublisher, AzureServiceBus, "Publishes audit events", "AMQP")

@enduml