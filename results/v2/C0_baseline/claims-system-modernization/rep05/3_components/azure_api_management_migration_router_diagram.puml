@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure API Management / Migration Router container

Container_Boundary(migration_router, "Azure API Management / Migration Router") {
    Component(api_gateway_proxy, "API Gateway / Proxy", "Azure API Management", "Acts as the edge gateway, routing inbound traffic from policyholders, brokers, and adjusters.")
    Component(migration_policy_engine, "Migration Policy Engine", "Azure API Management Policy / .NET", "Evaluates dynamic routing flags to split traffic between the legacy mainframe and the new cloud platform.")
    Component(analytics_monitoring_publisher, "Analytics & Monitoring Publisher", "Azure Monitor / Application Insights", "Publishes analytics and telemetry data regarding traffic splitting and API performance.")
}

Rel(api_gateway_proxy, migration_policy_engine, "Evaluates migration and routing rules for incoming requests", "Internal")
Rel(migration_policy_engine, analytics_monitoring_publisher, "Sends metrics and routing decisions for logging and analytics", "Telemetry")

@enduml