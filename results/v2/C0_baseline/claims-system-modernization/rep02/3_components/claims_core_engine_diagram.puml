@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Core Engine container

System_Ext(Microsoft_Entra_ID, "Microsoft Entra ID", "Identity provider")
System_Ext(Azure_SQL_Database, "Azure SQL Database", "Relational storage providing transactional guarantees")
System_Ext(Legacy_Mainframe, "Legacy Mainframe", "Legacy system of record")
System_Ext(Azure_Service_Bus_Topics, "Azure Service Bus Topics", "Asynchronous event streaming for domain audit events")

Container_Boundary(claims_core_engine, "Claims Core Engine") {
    Component(Claim_Processing_Service, "Claim Processing Service", "Spring MVC/WebFlux", "Replaces legacy workflows using microservices and processes claims incrementally.")
    Component(Anti_Corruption_Layer_ACL_Component, "Anti-Corruption Layer (ACL) Component", "Java / Spring Boot, Resilience4j", "Safely bridges modern cloud components with the legacy mainframe, transmitting tokenized payloads.")
    Component(Parameterized_Business_Rules, "Parameterized Business Rules", "Azure SQL", "Manages parameterized business rules and stateless transactions.")
    Component(Event_Publisher_Component, "Event Publisher Component", "Spring Cloud Stream", "Publishes fine-grained domain audit events.")
}

Rel(Claim_Processing_Service, Microsoft_Entra_ID, "Validates OAuth2/OIDC JWT tokens", "HTTPS")
Rel(Claim_Processing_Service, Azure_SQL_Database, "Manages stateless transactions and parameterized rules", "TDS over TLS 1.3")
Rel(Anti_Corruption_Layer_ACL_Component, Legacy_Mainframe, "Transmits tokenized payloads", "Azure ExpressRoute with IPsec VPN, mTLS")
Rel(Event_Publisher_Component, Azure_Service_Bus_Topics, "Publishes fine-grained domain audit events", "AMQP over TLS")

@enduml