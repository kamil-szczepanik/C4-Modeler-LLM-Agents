@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure SQL Database container

Container_Boundary(azure_sql_database, "Azure SQL Database") {
    Component(ClaimsReadModelStore, "Claims Read-Model Store", "Relational tables with isolated schemas by claim type", "CQRS read-model storage providing sub-2s adjuster views and isolated schemas by claim type.")
    Component(AzureSQLDatabaseServerless, "Azure SQL Database Serverless", "Azure SQL Database Serverless with geo-replication", "Cost-effective scaling and high availability engine supporting the read-model store.")
}

System_Ext(ClaimsCoreEngine, "Claims Core Engine", "External system writing projector updates")
System_Ext(AdjusterWorkspace, "Adjuster Workspace", "External UI executing low-latency read queries")
System_Ext(AzureKeyVault, "Azure Key Vault", "External service managing encryption keys")

Rel(ClaimsCoreEngine, ClaimsReadModelStore, "Writes projector updates", "JDBC / TLS 1.3 over Private Endpoint")
Rel(AdjusterWorkspace, ClaimsReadModelStore, "Executes low-latency read queries", "ADO.NET / TLS 1.3 over Private Endpoint")
Rel(azure_sql_database, AzureKeyVault, "Manages encryption keys", "HTTPS / REST over Private Endpoint")

@enduml