@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Claims_Core_Engine, "Claims Core Engine", "Java / Spring Boot")
System_Ext(Routing_Integration_Service, "Routing & Integration Service", "Azure Functions")

Container_Boundary(Azure_Service_Bus_Topics, "Azure Service Bus Topics") {
    Component(Topic_Router, "Topic Router", "Azure Service Bus Topics", "Publishes and routes claim events with Session IDs for data consistency and duplicate detection.")
    Component(Subscription_Filters, "Subscription Filters", "Azure Service Bus Subscriptions", "Dispatches events using peek-lock mode to downstream services.")
    Component(Dead_Letter_Manager, "Dead-Letter Manager", "Azure Service Bus Dead-Letter Queue", "Handles message failures and alerts on issues.")
}

Rel(Claims_Core_Engine, Topic_Router, "Publishes claim events with Session IDs", "AMQP over TLS")
Rel(Subscription_Filters, Routing_Integration_Service, "Dispatches events using peek-lock mode", "AMQP over TLS")
Rel(Dead_Letter_Manager, Claims_Core_Engine, "Alerts on message failures", "AMQP over TLS")

@enduml