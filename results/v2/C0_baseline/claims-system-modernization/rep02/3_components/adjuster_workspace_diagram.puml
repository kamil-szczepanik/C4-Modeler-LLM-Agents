@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Adjuster Workspace container

Container_Boundary(adjuster_workspace, "Adjuster Workspace") {
    Component(Claim Submission UI, "Claim Submission UI", "Angular", "Provides responsive user interfaces for online claim submissions and adjuster workflows.")
    Component(API Client Service, "API Client Service", "TypeScript / REST/HTTPS", "Routes all reads, commands, and document previews to the API management gateway.")
    Component(Authentication Client, "Authentication Client", "OIDC / PKCE", "Authenticates users via Microsoft Entra ID using Authorization Code Flow with PKCE.")
}

System_Ext(Azure API Management, "Azure API Management", "API gateway")
System_Ext(Microsoft Entra ID, "Microsoft Entra ID", "Identity provider")

Rel(Claim Submission UI, API Client Service, "Invokes REST/HTTPS requests", "")
Rel(API Client Service, Azure API Management, "Routes reads, commands, and document previews via REST/HTTPS (TLS 1.3)", "REST/HTTPS (TLS 1.3)")
Rel(Claim Submission UI, Authentication Client, "Triggers user authentication", "")
Rel(Authentication Client, Microsoft Entra ID, "Authenticates users via OIDC", "OIDC")

@enduml