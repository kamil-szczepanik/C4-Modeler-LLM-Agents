@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure API Management container

System_Boundary(azure_api_management, "Azure API Management") {
    Component(Azure_APIM_Gateway_Core, "Azure APIM Gateway Core", "Azure API Management (Premium Tier)", "Handles incoming HTTPS/TLS traffic and rate limiting.")
    Component(APIM_Policy_Fragment_Engine, "APIM Policy Fragment Engine", "Azure API Management Policy Engine", "Validates JWT/OIDC tokens and enforces security policies.")
    Component(APIM_Path_based_Routing, "APIM Path-based Routing", "Azure API Management Routing", "Maps endpoints and delegates routing.")
    Component(APIM_Managed_Developer_Portal, "APIM Managed Developer Portal", "Azure APIM Developer Portal", "Exposes OpenAPI specs to developers.")
}

System_Ext(Microsoft_Entra_ID, "Microsoft Entra ID", "Identity provider for Single Sign-On (SSO)")
System_Ext(Routing_Integration_Service, "Routing & Integration Service", "Azure Functions: Handles dynamic claim-type routing")

Rel(Azure_APIM_Gateway_Core, APIM_Policy_Fragment_Engine, "Evaluates security policies", "Internal")
Rel(APIM_Policy_Fragment_Engine, Microsoft_Entra_ID, "Token validation", "OIDC / HTTPS")
Rel(Azure_APIM_Gateway_Core, Routing_Integration_Service, "Delegates dynamic claim-type routing", "HTTP/HTTPS")

@enduml