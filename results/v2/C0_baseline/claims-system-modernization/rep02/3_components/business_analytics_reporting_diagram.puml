@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Business Analytics & Reporting container

Container_Boundary(bar_container, "Business Analytics & Reporting") {
    Component(etl_worker, "ETL Ingestion Worker", "Azure Functions / Python", "Executes lightweight event ingestion and mainframe batch extraction workers.")
    Component(transform_comp, "Transform & Load Component", "Azure Data Factory", "Manages declarative data pipelines to ensure processing finishes within the 23:00-05:00 batch window.")
    Component(dw_store, "Data Warehouse Store", "Azure SQL Database", "Provides relational storage and star schema for unified reporting with minimal cloud learning curve.")
    Component(semantic_model, "Semantic & Reporting Model", "Power BI Embedded", "Delivers role-based executive dashboards with Entra ID pass-through RLS.")
}

Rel(etl_worker, dw_store, "Writes to Azure SQL Staging Schema", "T-SQL")
Rel(transform_comp, dw_store, "Updates Data Warehouse Store", "T-SQL Stored Procedures")
Rel(semantic_model, dw_store, "Queries Data Warehouse Store with Row-Level Security", "T-SQL")

@enduml