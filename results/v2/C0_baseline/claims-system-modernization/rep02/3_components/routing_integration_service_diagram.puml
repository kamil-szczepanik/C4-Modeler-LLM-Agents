@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Routing & Integration Service container

System_Ext(azure_service_bus_topics, "Azure Service Bus Topics", "Azure Service Bus Topics", "Decouples routing from downstream processing and provides retry/dead-letter capabilities.")
System_Ext(legacy_mainframe, "Legacy Mainframe", "Legacy Mainframe (COBOL/DB2)", "System of record for unmigrated claims.")
System_Ext(azure_key_vault, "Azure Key Vault", "Azure Key Vault", "Secures certificates and rotating credentials for mainframe integration.")

Container_Boundary(routing_and_integration_service, "Routing & Integration Service") {
    Component(router_dispatcher, "Router Dispatcher", ".NET isolated worker", "Orchestrates claim routing and queries routing rules from configuration.")
    Component(configuration_cache, "Configuration Cache", "Azure App Configuration", "Stores claim-type routing toggles for instant runtime switching.")
    Component(legacy_adapter, "Legacy Adapter", "HTTP Client", "Forwards unmigrated claims to the legacy mainframe via secure tunnel.")
    Component(audit_logger_component, "Audit Logger Component", ".NET Background Service", "Performs background logging and auditing for routing operations.")
}

Rel(router_dispatcher, configuration_cache, "Queries routing rules", "Azure App Configuration SDK")
Rel(router_dispatcher, azure_service_bus_topics, "Publishes claim events", "AMQP / TLS 1.3")
Rel(legacy_adapter, legacy_mainframe, "Forwards unmigrated claims", "Mutual TLS (mTLS) / Secure Hybrid Tunnel / VPN")
Rel(legacy_adapter, azure_key_vault, "Retrieves rotating credentials and certificates", "Managed Identity / REST")

@enduml