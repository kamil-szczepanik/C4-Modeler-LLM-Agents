@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Insurance Claims Modernization Platform

Person(CustomersBrokers, "Customers / Brokers", "External users submitting claims online via web interfaces.")
Person(ClaimsAdjusters, "Claims Adjusters", "Internal staff processing claims in the new web application.")

System(InsuranceClaimsModernizationPlatform, "Insurance Claims Modernization Platform", "Hybrid solution that gradually replaces a legacy mainframe system while ensuring uninterrupted operations, secure digital claim submissions, and high-performance adjuster workflows.")

System_Ext(LegacyMainframe, "Legacy Mainframe", "30-year-old COBOL/DB2 system of record (IBM z/OS).")
System_Ext(ActiveDirectoryMicrosoftEntraID, "Active Directory / Microsoft Entra ID", "Identity provider for Single Sign-On and federated authentication.")
System_Ext(PaymentGateway, "Payment Gateway", "External system handling claim payouts.")

Rel(CustomersBrokers, InsuranceClaimsModernizationPlatform, "Submit claims", "HTTPS / TLS 1.3, OIDC/OAuth 2.0")
Rel(ClaimsAdjusters, InsuranceClaimsModernizationPlatform, "Process claims", "HTTPS / TLS 1.3, OIDC/OAuth 2.0")
Rel(InsuranceClaimsModernizationPlatform, LegacyMainframe, "Synchronize claims and process transactions", "SFTP / MQ via On-Premises Gateway")
Rel(InsuranceClaimsModernizationPlatform, ActiveDirectoryMicrosoftEntraID, "Federated authentication", "SAML/OIDC")
Rel(InsuranceClaimsModernizationPlatform, PaymentGateway, "Process payouts", "REST / HTTPS API")

@enduml