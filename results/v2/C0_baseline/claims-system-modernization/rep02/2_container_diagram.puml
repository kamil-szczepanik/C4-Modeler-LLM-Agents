@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Insurance Claims Modernization Platform

Person(Customers_Brokers, "Customers / Brokers", "External users submitting and managing claims via the customer portal.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal staff processing claims in the adjuster workspace.")
Person(Migration_Product_Managers, "Migration Product Managers", "Users overseeing the gradual migration of claims from legacy to cloud.")
Person(Customer_Support_Agents, "Customer Support Agents", "Support staff assisting users with platform operations.")

System_Ext(Legacy_Mainframe, "Legacy Mainframe", "On-premise COBOL/DB2 system of record.")
System_Ext(Microsoft_Entra_ID, "Microsoft Entra ID", "Identity provider for Single Sign-On and OIDC token validation.")

System_Boundary(Insurance_Claims_Modernization_Platform, "Insurance Claims Modernization Platform") {
    Container(Azure_API_Management, "Azure API Management", "Azure API Management", "API Gateway and OIDC validation for secure tenant entry.")
    Container(Customer_Portal, "Customer Portal", "React / Azure Static Web Apps", "Frontend interface for customers and brokers.")
    Container(Adjuster_Workspace, "Adjuster Workspace", "Angular / Azure App Service", "Frontend interface for claims adjusters and support agents.")
    Container(Claims_Core_Engine, "Claims Core Engine", "Java / Spring Boot / Azure Container Apps", "Microservice handling core claim processing logic.")
    Container(Routing_Integration_Service, "Routing & Integration Service", "Azure Functions", "Evaluates claim types and routes integrations.")
    Container(Business_Analytics_Reporting, "Business Analytics & Reporting", "Azure SQL / Power BI", "Storage and reporting for business analytics.")
    ContainerDb(Azure_SQL_Database, "Azure SQL Database", "Azure SQL Database", "CQRS read-model storage ensuring sub-2 second adjuster screen loads.")
    ContainerDb(Azure_Service_Bus_Topics, "Azure Service Bus Topics", "Azure Service Bus Topics", "Reliable asynchronous messaging with session IDs for data consistency.")
}

Rel(Customers_Brokers, Azure_API_Management, "Submits claims via API gateway", "HTTPS / TLS")
Rel(Claims_Adjusters, Azure_API_Management, "Accesses adjuster workspace via API gateway", "HTTPS / TLS")
Rel(Customer_Support_Agents, Azure_API_Management, "Accesses support tools via API gateway", "HTTPS / TLS")
Rel(Migration_Product_Managers, Azure_API_Management, "Monitors migration workflows via portal", "HTTPS / TLS")
Rel(Azure_API_Management, Customer_Portal, "Routes traffic to portal", "HTTPS")
Rel(Azure_API_Management, Adjuster_Workspace, "Routes traffic to workspace", "HTTPS")
Rel(Azure_API_Management, Microsoft_Entra_ID, "Validates OIDC tokens", "OIDC / OAuth 2.0")
Rel(Adjuster_Workspace, Azure_SQL_Database, "Queries data for sub-2s reads", "ADO.NET / TLS")
Rel(Claims_Core_Engine, Azure_Service_Bus_Topics, "Publishes claim events", "AMQP over TLS")
Rel(Routing_Integration_Service, Claims_Core_Engine, "Evaluates and routes claim types", "Internal API")
Rel(Claims_Core_Engine, Legacy_Mainframe, "Connects to legacy mainframe via hybrid connection", "Azure ExpressRoute with IPsec VPN")

@enduml