@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Processing Service container

Container_Boundary(claims_processing_service, "Claims Processing Service") {
    Component(Claims_Routing_Controller, "Claims Routing Controller", "Spring Boot, Spring MVC", "Receives routed requests from Azure API Management and exposes endpoints for claim-type processing.")
    Component(Claim_Processing_Service, "Claim Processing Service", "Java, Spring Boot", "Implements business logic for claim-type processing and orchestrates outbox pattern transactions.")
    Component(Outbox_Data_Repository, "Outbox Data Repository", "Spring Data JPA, Azure SQL Database", "Handles ACID-compliant transaction persistence and local outbox table support.")
    Component(Event_Publisher, "Event Publisher", "Azure Service Bus SDK, AMQP", "Publishes asynchronous events to Azure Service Bus.")
    Component(Resilience_Adapter, "Resilience Adapter", "Resilience4j", "Implements circuit breakers and caching adapters to mitigate mainframe latency.")
    Component(Secret_Manager_Client, "Secret Manager Client", "Azure Key Vault SDK, Managed Identity", "Retrieves secrets and credentials securely from Azure Key Vault.")
}

Rel(Claims_Routing_Controller, Claim_Processing_Service, "Delegates claim requests", "In-memory")
Rel(Claim_Processing_Service, Outbox_Data_Repository, "Persists claims and outbox messages", "TDS")
Rel(Claim_Processing_Service, Event_Publisher, "Sends asynchronous domain events", "AMQP")
Rel(Claim_Processing_Service, Resilience_Adapter, "Wraps external calls with circuit breakers", "In-memory")
Rel(Claim_Processing_Service, Secret_Manager_Client, "Fetches secrets and credentials", "HTTPS / Managed Identity")

@enduml