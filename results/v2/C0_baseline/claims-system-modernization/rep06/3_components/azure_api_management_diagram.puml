@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure API Management container

Container_Boundary(Azure_API_Management, "Azure API Management") {
    Component(API_Gateway, "API Gateway", "Azure API Management (Internal VNet mode)", "Acts as the single secure entry point, handling routing, rate limiting, and dynamic claim-type routing.")
    Component(Security_Validator, "Security Validator", "OAuth 2.0 / OpenID Connect & mTLS", "Validates JWT tokens via Azure Active Directory (Entra ID) and secures service-to-service communication.")
    Component(Telemetry_Publisher, "Telemetry Publisher", "HTTPS", "Publishes telemetry and metrics to Azure Application Insights.")
}

Rel(API_Gateway, Security_Validator, "Validates incoming JWT tokens and secures routing via mTLS", "OAuth 2.0 / mTLS")
Rel(API_Gateway, Telemetry_Publisher, "Publishes metrics and telemetry", "HTTPS")

@enduml