@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(azure_sql_database, "Azure SQL Database") {
    Component(Claim_Operational_Store, "Claim Operational Store", "Azure SQL Database", "Internal database schema handling CRUD operations and high-frequency lookups for claims.")
    Component(Migration_State___Routing_Registry, "Migration State & Routing Registry", "Azure SQL Database", "Internal database schema tracking the hybrid migration state and routing of claim types.")
    Component(Audit___Reconciliation_Log, "Audit & Reconciliation Log", "Azure SQL Database", "Internal database schema storing audit trails and reconciliation logs for compliance.")
}

Rel(Claim_Operational_Store, Migration_State___Routing_Registry, "Maintains relational integrity and routing metadata")
Rel(Migration_State___Routing_Registry, Audit___Reconciliation_Log, "Logs migration state transitions and reconciliation events")
@enduml