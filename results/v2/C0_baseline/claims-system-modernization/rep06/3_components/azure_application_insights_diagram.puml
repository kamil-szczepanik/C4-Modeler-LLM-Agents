@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(azure_application_insights, "Azure Application Insights") {
    Component(sdk_agents, "Application Insights SDK / Auto-collection agents", "Application Insights SDK, Auto-collection agents", "Collects and transmits telemetry data from the Claims Processing Service and Migration Dashboard.")
    Component(log_analytics, "Log Analytics Workspace", "Azure Log Analytics, Kusto Query Language", "Stores and indexes telemetry, logs, and trace data for querying and analysis.")
    Component(alert_rules, "Application Insights Alert Rules", "Azure Monitor alerts, Webhook/Action Groups", "Monitors telemetry metrics and triggers alerts based on predefined thresholds.")
    Component(workbooks, "Application Insights Workbooks", "Azure Workbooks, JSON/KQL", "Provides visual dashboards and interactive reports for system operators.")
    Component(metrics_explorer, "Application Insights Metrics Explorer", "Azure Monitor, Time-series DB", "Analyzes time-series metrics for performance and health monitoring.")
}

Rel(sdk_agents, log_analytics, "Sends telemetry data to", "HTTPS")
Rel(log_analytics, workbooks, "Supplies data for queries and visualization in", "KQL")
Rel(metrics_explorer, log_analytics, "Queries time-series data from", "Kusto")
Rel(alert_rules, log_analytics, "Evaluates metrics and logs stored in", "Internal")

@enduml