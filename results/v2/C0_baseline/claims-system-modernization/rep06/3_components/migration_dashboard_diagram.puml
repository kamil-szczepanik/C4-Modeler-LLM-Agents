@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Migration Dashboard container

Container_Boundary(migration_dashboard, "Migration Dashboard") {
    Component(MigrationDashboardUI, "Migration Dashboard UI", "React", "Frontend UI framework for the Migration Dashboard providing user interaction, leveraging team familiarity and component reusability.")
    Component(MigrationDashboardBackend, "Migration Dashboard Backend", "Node.js", "Backend runtime for handling API requests, RBAC middleware, and reconciliation aggregation.")
    Component(RollbackControllerComponent, "Rollback Controller Component", "Node.js / Azure Container Apps", "Triggers feature flag switches to handle rapid rollbacks.")
    Component(ReconciliationViewerComponentDataAggregator, "Reconciliation Viewer Component & Data Aggregator", "Node.js / Azure Container Apps", "Queries reconciliation metrics and audit logs from the database.")
    Component(RBACAuthorizationMiddleware, "RBAC & Authorization Middleware", "Node.js Middleware", "Enforces security, access control, and safety-critical governance.")
    Component(AuditLoggingService, "Audit Logging Service", "Node.js / Azure Container Apps", "Provides immutable audit logging to satisfy strict compliance constraints.")
}

Rel(MigrationDashboardUI, MigrationDashboardBackend, "Sends API requests", "HTTPS")
Rel(MigrationDashboardBackend, RBACAuthorizationMiddleware, "Validates permissions via", "Node.js Middleware")
Rel(MigrationDashboardBackend, RollbackControllerComponent, "Invokes feature flag switches", "HTTP/REST")
Rel(MigrationDashboardBackend, ReconciliationViewerComponentDataAggregator, "Aggregates reconciliation metrics", "Internal API")
Rel(MigrationDashboardBackend, AuditLoggingService, "Records audit events", "Internal API")

@enduml