@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Service Bus container

Container_Boundary(azure_service_bus, "Azure Service Bus") {
    Component(Service_Bus_Premium_Messaging_Engine, "Service Bus Premium Messaging Engine", "Azure Service Bus Premium Tier, AMQP 1.0, TLS 1.3", "Provides dedicated resources, geo-disaster recovery, and native AMQP 1.0 messaging backbone supporting asynchronous event publishing, queuing, and handling batch processing buffers.")
    Component(Private_Endpoint_Network_Perimeter, "Private Endpoint Network Perimeter", "Azure Private Endpoints", "Restricts network perimeter security by prohibiting public internet access to the message broker.")
    Component(Access_Control_and_Identity_Manager, "Access Control and Identity Manager", "Azure RBAC, Managed Identities, Azure Active Directory (Entra ID)", "Enforces least-privilege access across services, replacing SAS keys for secure interactions.")
}

Rel(Private_Endpoint_Network_Perimeter, Service_Bus_Premium_Messaging_Engine, "Secures network access", "Private IP, TLS 1.3")
Rel(Access_Control_and_Identity_Manager, Service_Bus_Premium_Messaging_Engine, "Authenticates and authorizes access", "Azure RBAC, Managed Identities")
@enduml