@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Key Vault container

System_Ext(ClaimsProcessingService, "Claims Processing Service", "External system interacting with the key vault.")
System_Ext(MigrationDashboard, "Migration Dashboard", "External system interacting with the access control component.")
System_Ext(AzureSqlDatabase, "Azure SQL Database", "External database performing TDE operations.")

Container_Boundary(AzureKeyVault, "Azure Key Vault") {
    Component(SecretsManagementComponent, "Secrets Management Component", "Azure Key Vault SDK / REST API", "Manages and retrieves sensitive financial data and connection strings securely.")
    Component(KeysManagementComponent, "Keys Management Component", "Azure Key Vault Managed HSM / TDE", "Performs Transparent Data Encryption (TDE) operations using Customer-Managed Keys (CMK).")
    Component(AccessControlComponent, "Access Control Component", "Azure Active Directory (Entra ID) Managed Identities", "Handles credential-free authentication and zero-trust access control.")
    Component(CachingEventListenerComponent, "Caching & Event Listener Component", "In-memory short-TTL cache (5-15 minutes)", "Caches secrets temporarily to balance performance and security against transient outages.")
}

Rel(ClaimsProcessingService, SecretsManagementComponent, "Retrieves connection strings", "Azure SDK over HTTPS (REST) via Azure Private Endpoint")
Rel(AzureSqlDatabase, KeysManagementComponent, "Performs Transparent Data Encryption (TDE) operations", "Azure internal secure channel")
Rel(ClaimsProcessingService, AccessControlComponent, "Authenticates", "Azure Active Directory (Entra ID) Managed Identities")
Rel(MigrationDashboard, AccessControlComponent, "Authenticates", "Azure Active Directory (Entra ID) Managed Identities")

@enduml