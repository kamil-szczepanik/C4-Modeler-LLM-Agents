@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Logic Apps / Functions container

System_Ext(On_premise_COBOL_DB2_Legacy_Mainframe, "On-premise COBOL/DB2 Legacy Mainframe", "On-premise legacy mainframe system.")
System_Ext(Azure_Service_Bus, "Azure Service Bus", "Manages asynchronous message queuing.")
System_Ext(Azure_Key Vault, "Azure Key Vault", "Secures connection strings and encryption keys.")

Container_Boundary(Azure_Logic_Apps_Functions, "Azure Logic Apps / Functions") {
    Component(Inbound_Integration_Workflow, "Inbound Integration Workflow", "Azure Logic Apps", "Handles inbound integration workflows for processing claims.")
    Component(Mainframe_Sync_Function, "Mainframe Sync Function", "C# .NET 8 Isolated Worker", "Communicates with the on-premise legacy mainframe.")
    Component(Operations_Telemetry_Forwarder, "Operations Telemetry Forwarder", "Azure Functions", "Forwards operations telemetry data.")
    Component(Exception_Triage_Orchestrator, "Exception Triage Orchestrator", "Azure Logic Apps", "Orchestrates exception triage processes.")
    Component(Replay_Audit_API, "Replay & Audit API", "C# .NET 8 Isolated Worker", "Connects to Azure Service Bus to securely push deduplicated messages.")
}

Rel(Mainframe_Sync_Function, On_premise_COBOL_DB2_Legacy_Mainframe, "Communicates using HTTPS/TCP/SNA with mTLS.", "HTTPS/TCP/SNA")
Rel(Replay_Audit_API, Azure_Service_Bus, "Securly pushes deduplicated messages using AMQP.", "AMQP")
Rel(Azure_Logic_Apps_Functions, Azure_Key Vault, "Securely retrieves secrets via Managed Identities.", "HTTPS")

@enduml