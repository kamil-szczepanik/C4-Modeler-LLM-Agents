@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(azure_active_directory_entra_id, "Azure Active Directory (Entra ID)") {
    Component(Token_Service_STS, "Token Service (STS)", "OAuth 2.0 / OpenID Connect (OIDC)", "Issues and validates security tokens, and provides public JWKS endpoints.")
    Component(Directory_Graph_API_Component, "Directory & Graph API Component", "Microsoft Graph API", "Manages directory data and user identity information.")
    Component(B2C_External_Identity_Federation_Gateway, "B2C / External Identity Federation Gateway", "Azure AD B2C", "Handles external identity federation for customers and brokers.")
    Component(Audit_Reporting_Component, "Audit & Reporting Component", "Azure Monitor / Log Analytics", "Monitors sign-in and audit telemetry.")
}

Rel(Token_Service_STS, Claims_Processing_Service, "Provides JWT tokens and public JWKS endpoints", "HTTPS")
Rel(Token_Service_STS, Azure_API_Management, "Provides OIDC metadata and JWKS for edge token validation", "HTTPS")
Rel(Audit_Reporting_Component, Azure_Application_Insights, "Ingests telemetry using Azure Diagnostic Settings", "HTTPS")

@enduml