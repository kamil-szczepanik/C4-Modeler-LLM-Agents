@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "End users who interact with the platform for online claim submission.")
Person(Broker, "Broker", "Intermediaries who interact with the platform for online claim submission.")
Person(Claims_Adjuster, "Claims Adjuster", "Internal staff who interact with the platform for claim handling.")
System(Hybrid_Insurance_Claims_Modernization_Platform, "Hybrid Insurance Claims Modernization Platform", "A hybrid insurance claims modernization platform that gradually replaces a legacy COBOL/DB2 mainframe while maintaining continuous claim processing by coupling a cloud-hosted web interface with asynchronous integration patterns.")
System_Ext(On_premise_COBOL_DB2_Legacy_Mainframe, "On-premise COBOL/DB2 Legacy Mainframe", "The existing system of record processing legacy insurance data.")

Rel(Customer, Hybrid_Insurance_Claims_Modernization_Platform, "Interacts for online claim submission", "HTTPS")
Rel(Broker, Hybrid_Insurance_Claims_Modernization_Platform, "Interacts for online claim submission", "HTTPS")
Rel(Claims_Adjuster, Hybrid_Insurance_Claims_Modernization_Platform, "Interacts for claim handling", "HTTPS")
Rel(Hybrid_Insurance_Claims_Modernization_Platform, On_premise_COBOL_DB2_Legacy_Mainframe, "Synchronous queries and asynchronous claim state updates", "REST/HTTPS and AMQP/HTTPS via Azure API Management and Azure Service Bus")
@enduml