@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Hybrid Insurance Claims Modernization Platform

Person(Customer, "Customer", "End users who interact with the platform for online claim submission.")
Person(Broker, "Broker", "Intermediaries who interact with the platform for online claim submission.")
Person(ClaimsAdjuster, "Claims Adjuster", "Internal staff who interact with the platform for claim handling.")
Person(BusinessOperationsMigrationManager, "Business Operations / Migration Manager", "Internal staff who manage migration tasks and operations via the migration dashboard.")

System_Ext(OnpremiseCOBOLDB2LegacyMainframe, "On-premise COBOL/DB2 Legacy Mainframe", "The existing on-premise system of record processing legacy insurance data.")

System_Boundary(HybridInsuranceClaimsModernizationPlatform, "Hybrid Insurance Claims Modernization Platform") {
    Container(AzureAPIManagement, "Azure API Management", "Azure API Management", "Gateways and routing layer for dynamic claim-type routing and feature-flag routing.")
    Container(ClaimsProcessingService, "Claims Processing Service", "Java, Spring Boot, Azure Container Apps", "Backend service for processing claims workloads.")
    Container(MigrationDashboard, "Migration Dashboard", "React, Node.js, Azure Container Apps", "Web application for business operations and migration management.")
    Container(AzureServiceBus, "Azure Service Bus", "Azure Service Bus", "Asynchronous event publishing, messaging, and queuing around the strict nightly batch window.")
    Container(AzureLogicAppsFunctions, "Azure Logic Apps / Functions", "Azure Logic Apps, Azure Functions", "Integration and workflow automation supporting hybrid messaging.")
    ContainerDb(AzureSQLDatabase, "Azure SQL Database", "Azure SQL Database, TDS", "ACID-compliant transaction persistence storage for claims.")
    Container(AzureKeyVault, "Azure Key Vault", "Azure Key Vault", "Secret retrieval and management using Managed Identity.")
    Container(AzureActiveDirectoryEntraID, "Azure Active Directory (Entra ID)", "Azure Active Directory (Entra ID), OAuth 2.0, OpenID Connect", "Identity and access management providing SSO and authentication.")
    Container(AzureApplicationInsights, "Azure Application Insights", "Azure Application Insights", "Security and observability monitoring for the platform.")
}

Rel(Customer, AzureAPIManagement, "Online claim submission via HTTPS / REST", "HTTPS / REST")
Rel(Broker, AzureAPIManagement, "Online claim submission via HTTPS / REST", "HTTPS / REST")
Rel(ClaimsAdjuster, AzureAPIManagement, "Web application access for claim handling via OAuth 2.0 / OpenID Connect", "HTTPS / OAuth 2.0")
Rel(BusinessOperationsMigrationManager, AzureAPIManagement, "Web application access for migration management via OAuth 2.0 / OpenID Connect", "HTTPS / OAuth 2.0")
Rel(AzureAPIManagement, ClaimsProcessingService, "Dynamic claim-type routing via internal VNet", "HTTPS / VNet")
Rel(AzureAPIManagement, MigrationDashboard, "Routes traffic to the migration dashboard via internal VNet", "HTTPS / VNet")
Rel(ClaimsProcessingService, AzureSQLDatabase, "ACID-compliant transaction persistence", "TDS")
Rel(ClaimsProcessingService, AzureServiceBus, "Asynchronous event publishing and queuing", "AMQP / Messaging")
Rel(AzureServiceBus, OnpremiseCOBOLDB2LegacyMainframe, "Hybrid integration bridge via TLS 1.3 / mTLS and Site-to-Site VPN / ExpressRoute", "TLS 1.3 / mTLS, VPN / ExpressRoute")
Rel(ClaimsProcessingService, AzureKeyVault, "Managed Identity secret retrieval", "HTTPS")
Rel(MigrationDashboard, AzureKeyVault, "Managed Identity secret retrieval", "HTTPS")

@enduml