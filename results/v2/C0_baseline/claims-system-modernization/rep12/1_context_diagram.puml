@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Insurance Claims Modernization Platform

Person(End_Customers_Brokers, "End Customers & Brokers", "External users who submit and manage insurance claims.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal users who review, process, and manage insurance claims.")

System(Insurance_Claims_Modernization_Platform, "Insurance Claims Modernization Platform", "A modern Azure-hosted web application that gradually replaces a 30-year-old COBOL/DB2 mainframe, enabling incremental claim-type migration while the legacy system maintains the system of record.")

System_Ext(Legacy_Mainframe, "Legacy Mainframe", "30-year-old z/OS, DB2, and CICS system acting as the system of record.")
System_Ext(Corporate_Active_Directory, "Corporate Active Directory", "Microsoft Entra ID / AD providing centralized IAM for SSO and RBAC.")
System_Ext(Notification_Service, "Notification Service", "SendGrid / Azure Communication Services for handling notifications.")
System_Ext(Payment_Gateway, "Payment Gateway", "Regional Banking API for processing financial transactions.")

Rel(End_Customers_Brokers, Insurance_Claims_Modernization_Platform, "Submit and manage claims", "HTTPS")
Rel(Claims_Adjusters, Insurance_Claims_Modernization_Platform, "Review and process claims", "HTTPS")
Rel(Insurance_Claims_Modernization_Platform, Legacy_Mainframe, "Synchronize claims data and maintain system of record", "Asynchronous messaging / ETL via secure gateway with mTLS")
Rel(Insurance_Claims_Modernization_Platform, Corporate_Active_Directory, "Authenticate users and authorize roles", "OIDC/SAML")
Rel(Insurance_Claims_Modernization_Platform, Notification_Service, "Send notifications to users", "HTTPS")
Rel(Insurance_Claims_Modernization_Platform, Payment_Gateway, "Process claim payments", "REST/JSON over mTLS with payload signatures")

@enduml