@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Configuration & Feature Store container

Container_Boundary(config_feature_store, "Configuration & Feature Store") {
    Component(Configuration_SDK_Caching_Module, "Configuration SDK Caching Module", "Azure App Configuration SDK with native caching", "Provides sub-millisecond flag evaluations and local SDK caching with jittered polling.")
    Component(Managed_Identity_Authentication_Module, "Managed Identity Authentication Module", "Azure Managed Identities", "Handles secure authentication between services and the configuration store over HTTPS.")
}

Rel(Configuration_SDK_Caching_Module, Managed_Identity_Authentication_Module, "Authenticates requests using", "HTTPS")

@enduml