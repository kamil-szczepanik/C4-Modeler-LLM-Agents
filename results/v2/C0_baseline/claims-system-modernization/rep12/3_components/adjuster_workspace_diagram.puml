@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Corporate Active Directory, "Corporate Active Directory", "Azure AD / Entra ID")
System_Ext(Claim Read Model Database, "Claim Read Model Database", "Azure Cosmos DB", "Delivers low-latency NoSQL reads to guarantee sub-2s screen loads")

Container_Boundary(Adjuster_Workspace, "Adjuster Workspace") {
    Component(Adjuster UI, "Adjuster UI", "React", "Provides the user interface for claims adjusters to review and manage claim data.")
    Component(Adjuster API Backend, "Adjuster API Backend", ".NET Core API", "Orchestrates adjuster workflows and validates Single Sign-On against Corporate Active Directory.")
}

Rel(Adjuster UI, Adjuster API Backend, "Routes adjuster traffic", "Internal HTTPS")
Rel(Adjuster API Backend, Corporate Active Directory, "Validates Single Sign-On", "OIDC / OAuth2 / TLS 1.3")
Rel(Adjuster API Backend, Claim Read Model Database, "Reads claim data", "TCP / Cosmos DB Direct Mode")
@enduml