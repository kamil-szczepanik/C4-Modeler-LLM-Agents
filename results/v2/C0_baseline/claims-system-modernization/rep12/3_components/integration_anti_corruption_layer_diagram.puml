@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Integration & Anti-Corruption Layer", "Integration & Anti-Corruption Layer") {
    Component("Translation Engine", "Translation Engine", ".NET Core / FluentValidation", "Validates and translates modern claims data formats into legacy-compatible payloads.")
    Component("Outbox Processor", "Outbox Processor", "MassTransit / Entity Framework Core / Azure SQL Serverless", "Implements the Transactional Outbox pattern to ensure reliable message delivery and prevent lost claims.")
    Component("Async Sync Worker", "Async Sync Worker", "MassTransit / Polly", "Handles asynchronous synchronization workflows with retry policies and resilience.")
    Component("Routing & Feature Router", "Routing & Feature Router", "Azure App Configuration", "Manages dynamic feature flags and routing for gradual claim-type migration and rollbacks.")
}

Rel("Translation Engine", "Outbox Processor", "Passes validated and translated payloads for reliable outbox persistence.")
Rel("Outbox Processor", "Async Sync Worker", "Dispatches asynchronous messages for synchronization.")
Rel("Routing & Feature Router", "Translation Engine", "Provides feature flags and routing rules to guide translation and processing.")

@enduml