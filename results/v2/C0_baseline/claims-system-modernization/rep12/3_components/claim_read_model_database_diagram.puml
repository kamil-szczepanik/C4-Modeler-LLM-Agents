@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(claim_read_model_database, "Claim Read Model Database") {
    Component(ClaimReadModelDatabase, "Claim Read Model Database", "Azure Cosmos DB", "Azure Cosmos DB container storing denormalized low-latency views.")
    Component(ClaimDocumentStore, "Claim Document Store", "Cosmos DB Core/SQL API", "Cosmos DB Core/SQL API component for JSON claim models.")
    Component(ChangeFeedProcessor, "Change Feed Processor", "Cosmos DB SDK", "Asynchronous event synchronization component.")
    Component(SchemaVersionRouter, "Schema Version Router", "Lightweight routing component", "Lightweight routing component for backward compatibility.")
}

Component(IntegrationAntiCorruptionLayer, "Integration & Anti-Corruption Layer", ".NET Core / MassTransit", ".NET Core / MassTransit service bridging mainframe and cloud.")
Component(AdjusterWorkspace, "Adjuster Workspace", "React / .NET Core", "React / .NET Core web application for claims processing.")

Rel(IntegrationAntiCorruptionLayer, ClaimDocumentStore, "Writes projected claim models", "TCP/HTTPS")
Rel(ChangeFeedProcessor, ClaimDocumentStore, "Manages state synchronization", "Cosmos DB SDK")
Rel(AdjusterWorkspace, SchemaVersionRouter, "Requests claim read models", "HTTPS/REST")
Rel(SchemaVersionRouter, ClaimDocumentStore, "Retrieves versioned documents", "TCP/Cosmos DB SDK")

@enduml