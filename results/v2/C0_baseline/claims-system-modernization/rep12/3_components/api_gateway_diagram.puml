@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Azure_API_Management, "Azure API Management", "Azure API Management / NGINX", "Provides dynamic path-based routing, WAF integration, and rate limiting.")
    Component(Authentication_SSO_Handler, "Authentication & SSO Handler", "OIDC/OAuth2", "Validates SSO and authentication against Corporate Active Directory.")
    Component(Routing_Configuration_Engine, "Routing & Configuration Engine", "Internal HTTPS/REST, Redis", "Fetches active routing rules from the Configuration & Feature Store, cached locally.")
    Component(Secrets_Management_Client, "Secrets Management Client", "Azure Managed Identity / HTTPS", "Retrieves certificates and OAuth secrets from Azure Key Vault.")
}

Rel(Azure_API_Management, Authentication_SSO_Handler, "Validates SSO and authentication", "OIDC/OAuth2")
Rel(Azure_API_Management, Routing_Configuration_Engine, "Fetches active routing rules", "Internal HTTPS/REST, cached locally")
Rel(Azure_API_Management, Secrets_Management_Client, "Retrieves certificates and OAuth secrets", "Azure Managed Identity / HTTPS")

@enduml