@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Claims Domain Services container

System_Ext(api_gateway, "API Gateway", "External API Gateway")
System_Ext(azure_cache_for_redis, "Azure Cache for Redis", "External Cache")
System_Ext(azure_app_configuration, "Azure App Configuration", "External Configuration Store")
System_Ext(azure_sql_database, "Azure SQL Database", "External Database")
System_Ext(azure_service_bus, "Azure Service Bus", "External Message Broker")
System_Ext(azure_monitor, "Azure Monitor", "External Monitoring Service")

Container_Boundary(claims_domain_services, "Claims Domain Services") {
    Component(claim_processing_controller, "Claim Processing Controller", ".NET 8 Web API", "Invokes domain logic via gRPC over mTLS in Azure VNet.")
    Component(idempotency_filter_middleware, "Idempotency Filter & Middleware", "Azure Cache for Redis", "Validates idempotency keys.")
    Component(feature_flag_evaluator, "Feature Flag Evaluator", "Azure App Configuration", "Reads feature flags and routing rules using Managed Identities.")
    Component(claim_domain_model_handlers, "Claim Domain Model & Handlers", ".NET 8", "Core runtime for high-performance microservices and domain logic.")
    Component(data_access_repository, "Data Access Repository", "Azure SQL Database, Entity Framework Core", "Persists claim data securely with TLS 1.3 and Entra ID Authentication.")
    Component(audit_telemetry_interceptor, "Audit & Telemetry Interceptor", "Azure Application Insights", "Writes tamper-evident audit logs.")
    Component(integration_publisher, "Integration Publisher", "Azure Service Bus", "Publishes encrypted claim events via AMQP.")
}

Rel(api_gateway, claim_processing_controller, "Invokes domain logic via gRPC over mTLS in Azure VNet")
Rel(idempotency_filter_middleware, azure_cache_for_redis, "Validates idempotency keys", "TCP/TLS")
Rel(feature_flag_evaluator, azure_app_configuration, "Reads feature flags and routing rules", "HTTPS / Managed Identities")
Rel(data_access_repository, azure_sql_database, "Persists claim data securely", "TLS 1.3 / Entra ID Authentication")
Rel(integration_publisher, azure_service_bus, "Publishes encrypted claim events", "AMQP / Managed Identities")
Rel(audit_telemetry_interceptor, azure_monitor, "Writes tamper-evident audit logs", "HTTPS")

@enduml