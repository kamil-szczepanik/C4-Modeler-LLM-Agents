@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Customer Portal container

Person(Customers_and_Brokers, "Customers and Brokers", "Accesses portal to submit and track claims.")

System_Ext(Corporate_Active_Directory_Azure_Entra_ID, "Corporate Active Directory & Azure Entra ID", "Handles user authentication and Single Sign-On.")
System_Ext(Azure_Application_Insights, "Azure Application Insights", "Sends client-side telemetry and monitors performance/errors.")
System_Ext(Azure_Web_Application_Fireswall_WAF, "Azure Web Application Firewall (WAF)", "Inspects and filters incoming traffic for edge protection against bots and web attacks.")

Container_Boundary(Customer_Portal_Container, "Customer Portal") {
    Component(Customer_Portal, "Customer Portal", "React, TypeScript, Azure CDN", "Delivers secure online claim submissions and self-service tracking for customers and brokers.")
    Component(API_Gateway_Backend_for_Frontend, "API Gateway / Backend-for-Frontend", ".NET 8 Web API", "Isolates complex legacy mainframe dependencies and handles API requests.")
}

Rel(Customers_and_Brokers, Customer_Portal, "Accesses portal to submit and track claims", "HTTPS / Azure CDN")
Rel(Customer_Portal, API_Gateway_Backend_for_Frontend, "Makes API requests", "HTTPS / REST")
Rel(Customer_Portal, Corporate_Active_Directory_Azure_Entra_ID, "Authenticates via Single Sign-On", "OAuth 2.0 / OIDC / MSAL.js")
Rel(Customer_Portal, Azure_Application_Insights, "Sends client-side telemetry", "HTTPS")
Rel(Azure_Web_Application_Fireswall_WAF, Customer_Portal, "Inspects and filters incoming traffic", "HTTPS")

@enduml