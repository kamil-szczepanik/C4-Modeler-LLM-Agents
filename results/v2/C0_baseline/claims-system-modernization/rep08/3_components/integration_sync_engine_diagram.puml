@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration & Sync Engine container

Container_Boundary(integration_sync_engine, "Integration & Sync Engine") {
    Component(Sync_Orchestrator_Function, "Sync Orchestrator Function", "Azure Functions - Durable Functions", "Serverless event orchestration and stateful saga management for hybrid data replication.")
    Component(Mainframe_Adapter_Component, "Mainframe Adapter Component", "C# class library with Polly circuit breaker", "Interfaces with the legacy mainframe, providing resilience and circuit-breaking for legacy timeouts.")
    Component(Reconciliation_Worker, "Reconciliation Worker", "Azure Functions - Timer Trigger", "Periodically reconciles data consistency between the mainframe and Azure cloud platform.")
    Component(Change_Data_Capture_CDC_Consumer, "Change Data Capture (CDC) Consumer", "Azure Functions", "Consumes change data capture events to maintain data synchronization.")
    Component(Feature_Flag_Router_Component, "Feature Flag Router Component", "C# middleware", "Evaluates migration streams via in-memory caching and managed identities for incremental claim migrations.")
    Component(Enterprise_Integration_Bus, "Enterprise Integration Bus", "Enterprise Integration Bus (EIB) / Azure Service Bus", "Asynchronous message brokering and AMQP/HTTPS communication backbone.")
    Component(Azure_App_Configuration, "Azure App Configuration", "Azure App Configuration & Managed Identities", "Provides dynamic feature flag routing and credential-less authentication.")
    Component(Azure_Key_Vault, "Azure Key Vault", "Azure Key Vault", "Secures and supplies secrets using Azure Managed Identities.")
}

Rel(integration_sync_engine, Enterprise_Integration_Bus, "Replicates hybrid data via AMQP and HTTPS/mTLS", "AMQP / HTTPS")
Rel(Sync_Orchestrator_Function, Azure_Key_Vault, "Retrieves secrets using Azure Managed Identities", "Managed Identity")
Rel(Feature_Flag_Router_Component, Azure_App_Configuration, "Evaluates migration streams via in-memory caching and managed identities", "HTTPS")
Rel(Mainframe_Adapter_Component, Enterprise_Integration_Bus, "Transmits cryptographically signed payloads using TLS 1.3", "TLS 1.3")

@enduml