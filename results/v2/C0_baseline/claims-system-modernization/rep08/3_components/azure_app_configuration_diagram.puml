@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure App Configuration container

Person_Ext(Claims Domain Services, "Claims Domain Services", "External system")
Person_Ext(Integration & Sync Engine, "Integration & Sync Engine", "External system")
System_Ext(Azure Key Vault, "Azure Key Vault", "External system")
System_Ext(Azure Event Grid, "Azure Event Grid", "External system")

Container_Boundary("Azure App Configuration", "Azure App Configuration") {
    Component(Key-Value Store, "Key-Value Store", "Azure App Configuration Service", "Persists environment-specific settings and routing endpoints.")
    Component(Feature Management Engine, "Feature Management Engine", "Azure App Configuration Service", "Evaluates percentage-based rollouts and claim-type filters for gradual migration (R-03).")
    Component(Configuration Refresh Handler, "Configuration Refresh Handler", "Microsoft.Extensions.Configuration.AzureAppConfiguration (.NET 8)", "Exposes push-notification endpoints to invalidate downstream service caches.")
    Component(Local Snapshot Cache & Fallback Provider, "Local Snapshot Cache & Fallback Provider", "Ephemeral Storage JSON Snapshots", "Persists read-only JSON backups in ephemeral storage for resilience.")
}

Rel(Claims Domain Services, Key-Value Store, "Reads configuration and feature flags via HTTPS (TLS 1.3) using Microsoft Entra ID Managed Identities and Azure Private Link", "HTTPS / TLS 1.3")
Rel(Integration & Sync Engine, Feature Management Engine, "Reads feature flags and routing rules via HTTPS (TLS 1.3) using Managed Identities and Azure Private Link", "HTTPS / TLS 1.3")
Rel(Configuration Refresh Handler, Azure Key Vault, "Resolves sensitive connection strings and secrets via Key Vault references", "")
Rel(Configuration Refresh Handler, Azure Event Grid, "Publishes push-notification events for cache invalidation", "")

@enduml