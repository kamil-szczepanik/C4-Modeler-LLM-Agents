@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Adjuster Workspace container

System_Ext(ApiGateway, "API Gateway / Backend-for-Frontend", "HTTPS / REST", "External API gateway for backend services.")

Container_Boundary(AdjusterWorkspace, "Adjuster Workspace") {
    Component(WorkspaceShellAndRouter, "Workspace Shell & Router", "React & TypeScript", "Core frontend shell and router for the Adjuster Workspace.")
    Component(UnifiedClaimDashboard, "Unified Claim Dashboard", "React & TypeScript", "Displays a unified view of claims for adjusters.")
    Component(ClaimDetailView, "Claim Detail View", "React & TypeScript", "Detailed view for processing hybrid insurance claims.")
    Component(IntegrationClient, "Integration Client", "TypeScript", "Client for integrating with backend and legacy systems.")
    Component(AuditAndTelemetryInterceptor, "Audit & Telemetry Interceptor", "Application Insights / OpenTelemetry", "Wraps write operations for auditing and telemetry tracking.")
    Component(FeatureFlagProvider, "Feature Flag Provider", "Azure App Configuration", "Consumes dynamic configuration and feature flags.")
}

Rel(WorkspaceShellAndRouter, UnifiedClaimDashboard, "Renders components", "In-memory")
Rel(WorkspaceShellAndRouter, ClaimDetailView, "Renders components", "In-memory")
Rel(IntegrationClient, AuditAndTelemetryInterceptor, "Wraps write operations", "HTTPS")
Rel(WorkspaceShellAndRouter, FeatureFlagProvider, "Consumes dynamic configuration", "In-memory")
Rel(AdjusterWorkspace, ApiGateway, "Makes API requests", "HTTPS / REST")

@enduml