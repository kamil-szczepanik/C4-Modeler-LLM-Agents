@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway / Backend-for-Frontend container

System_Ext(Corporate_Active_Directory__Azure_Entra_ID, "Corporate Active Directory & Azure Entra ID", "External system for authentication and token validation.")
System_Ext(Azure_App_Configuration, "Azure App Configuration", "External service for feature flags and routing configuration.")
System_Ext(Claims_Domain_Services, "Claims Domain Services", "Internal domain services hosted on Azure Container Apps.")
System_Ext(Azure_Redis_Cache, "Azure Redis Cache", "Distributed cache for encrypted response data.")
System_Ext(Azure_Key_Vault, "Azure Key Vault", "Secrets management using Azure Managed Identities.")

Container_Boundary(api_gateway_bff, "API Gateway / Backend-for-Frontend") {
    Component(Routing___Feature_Flag_Router_Component, "Routing & Feature Flag Router Component", "Azure App Configuration", "Fetches feature flags and handles routing with local memory fallback.")
    Component(Aggregator___Composition_Service_Component, "Aggregator / Composition Service Component", ".NET 8 Web API", "Composes and aggregates data from multiple domain services for the BFF.")
    Component(Authentication___Token_Exchange_Middleware_Component, "Authentication & Token Exchange Middleware Component", "OpenID Connect / OAuth2", "Validates tokens against Corporate Active Directory & Azure Entra ID.")
    Component(Resilience___Telemetry_Component, "Resilience & Telemetry Component", "Polly & OpenTelemetry", "Implements circuit breakers, resilience policies, and distributed tracing.")
}

Rel(Authentication___Token_Exchange_Middleware_Component, Corporate_Active_Directory__Azure_Entra_ID, "Validates tokens", "OpenID Connect / OAuth2")
Rel(Routing___Feature_Flag_Router_Component, Azure_App_Configuration, "Fetches feature flags", "HTTPS with local memory fallback")
Rel(Aggregator___Composition_Service_Component, Claims_Domain_Services, "Invokes domain services", "gRPC with strict mTLS")
Rel(api_gateway_bff, Azure_Redis_Cache, "Reads and writes encrypted response data", "TLS with field-level encryption")
Rel(api_gateway_bff, Azure_Key_Vault, "Retrieves secrets using Azure Managed Identities", "HTTPS")

@enduml