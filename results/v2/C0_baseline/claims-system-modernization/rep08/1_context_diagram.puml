@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers_and_Brokers, "Customers and Brokers", "External users submitting claims online.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal users handling claims via a web application.")
System(Hybrid_Insurance_Claims_Modernization_Platform, "Hybrid Insurance Claims Modernization Platform", "A hybrid insurance claims modernization platform that gradually replaces a 30-year-old COBOL/DB2 mainframe while maintaining continuous core operations, enabling online claim submissions and adjuster workflows in Azure.")
System_Ext(Legacy_Mainframe, "Legacy Mainframe", "On-premise COBOL/DB2 system of record.")
System_Ext(Enterprise_Integration_Bus, "Enterprise Integration Bus", "Decoupling and buffering layer for hybrid data exchange.")
System_Ext(Corporate_Active_Directory___Azure_Entra_ID, "Corporate Active Directory & Azure Entra ID", "Identity providers for single sign-on.")
System_Ext(Notification_Service, "Notification Service", "External provider (SendGrid/Twilio/SMTP) for customer alerts.")
System_Ext(Azure_Key_Vault, "Azure Key Vault", "Centralized secret and certificate management.")

Rel(Customers_and_Brokers, Hybrid_Insurance_Claims_Modernization_Platform, "Submits claims online", "HTTPS via TLS 1.3 / OAuth 2.0 / OpenID Connect")
Rel(Claims_Adjusters, Hybrid_Insurance_Claims_Modernization_Platform, "Handles claims via web application", "HTTPS via TLS 1.3 / OAuth 2.0 / OpenID Connect")
Rel(Hybrid_Insurance_Claims_Modernization_Platform, Enterprise_Integration_Bus, "Asynchronous messaging and data exchange", "Secure asynchronous messaging / APIs")
Rel(Enterprise_Integration_Bus, Legacy_Mainframe, "Syncs legacy data securely", "Encrypted queues with mTLS and rate-limiting")
Rel(Hybrid_Insurance_Claims_Modernization_Platform, Notification_Service, "Sends automated alerts to customers", "HTTPS")
Rel(Customers_and_Brokers, Corporate_Active_Directory___Azure_Entra_ID, "Authenticates via SSO", "Azure AD Connect")
Rel(Claims_Adjusters, Corporate_Active_Directory___Azure_Entra_ID, "Authenticates via SSO", "Azure AD Connect")

@enduml