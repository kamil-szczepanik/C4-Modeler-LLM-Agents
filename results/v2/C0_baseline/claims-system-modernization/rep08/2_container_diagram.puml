@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Hybrid Insurance Claims Modernization Platform

Person(Customers_and_Brokers, "Customers and Brokers", "External users submitting claims online.")
Person(Claims_Adjusters, "Claims Adjusters", "Internal users handling claims via the workspace.")
Person(Migration_Operations_Manager, "Migration Operations Manager", "Manager overseeing the parallel processing and migration operations.")

System_Ext(Legacy_Mainframe, "Legacy Mainframe", "On-premise COBOL/DB2 system of record.")
System_Ext(Enterprise_Integration_Bus, "Enterprise Integration Bus", "Decoupling and buffering layer for hybrid data exchange.")
System_Ext(Corporate_Active_Directory_Azure_Entra_ID, "Corporate Active Directory & Azure Entra ID", "Identity provider for single sign-on and managed security.")
System_Ext(Azure_Key_Vault, "Azure Key Vault", "Centralized secret and certificate management.")

System_Boundary(Hybrid_Insurance_Claims_Modernization_Platform, "Hybrid Insurance Claims Modernization Platform") {
    Container(Customer_Portal, "Customer Portal", "React, TypeScript, Azure CDN", "Web application allowing customers and brokers to submit and track claims.")
    Container(Adjuster_Workspace, "Adjuster Workspace", "React, TypeScript", "Web application used by claims adjusters to process and manage claims.")
    Container(API_Gateway_Backend_for_Frontend, "API Gateway / Backend-for-Frontend", ".NET 8 Web API", "Handles routing, composition, and backend-for-frontend logic for the client portals.")
    Container(Claims_Domain_Services, "Claims Domain Services", ".NET 8, Azure Container Apps", "Microservices implementing core claims business logic and domain processing.")
    Container(Integration_Sync_Engine, "Integration & Sync Engine", "Azure Functions, Azure Service Bus", "Handles asynchronous event processing and data synchronization with legacy systems.")
    Container(Azure_App_Configuration, "Azure App Configuration", "Azure App Configuration", "Centralized configuration and feature flagging management.")
}

Rel(Customers_and_Brokers, Customer_Portal, "Accesses portal to submit and view claims", "HTTPS / Azure CDN")
Rel(Claims_Adjusters, Adjuster_Workspace, "Uses workspace to manage and process claims", "HTTPS")
Rel(Customer_Portal, API_Gateway_Backend_for_Frontend, "Makes API requests", "HTTPS / REST")
Rel(Adjuster_Workspace, API_Gateway_Backend_for_Frontend, "Makes API requests", "HTTPS / REST")
Rel(API_Gateway_Backend_for_Frontend, Claims_Domain_Services, "Invokes domain services", "gRPC / HTTPS")
Rel(Integration_Sync_Engine, Enterprise_Integration_Bus, "Synchronizes data with legacy systems securely", "mTLS")
Rel(Enterprise_Integration_Bus, Legacy_Mainframe, "Exchanges data with COBOL/DB2 system of record", "Secure asynchronous messaging / APIs")
Rel(Claims_Domain_Services, Azure_Key_Vault, "Retrieves secrets and certificates", "Managed Identities")
Rel(Claims_Domain_Services, Azure_App_Configuration, "Reads configuration and feature flags", "Managed Identities")
Rel(Integration_Sync_Engine, Azure_Key_Vault, "Retrieves secrets and certificates", "Managed Identities")
Rel(Integration_Sync_Engine, Azure_App_Configuration, "Reads configuration and feature flags", "Managed Identities")
Rel(Customers_and_Brokers, Corporate_Active_Directory_Azure_Entra_ID, "Authenticates via SSO", "OAuth 2.0 / OpenID Connect")
Rel(Claims_Adjusters, Corporate_Active_Directory_Azure_Entra_ID, "Authenticates via SSO", "OAuth 2.0 / OpenID Connect")

@enduml