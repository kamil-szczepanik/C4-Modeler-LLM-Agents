@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "Shopper who browses, searches, and checks out products.")
Person(StoreAdministrator, "Store Administrator", "Content Manager who manages inventory and catalog.")

System_Ext(ExternalPaymentGateway, "External Payment Gateway", "Stripe/PayPal service used to process and authorize payments.")
System_Ext(ExternalShippingProvider, "External Shipping Provider", "FedEx/UPS APIs used to dispatch physical orders.")
System_Ext(ExternalIdentityProvider, "External Identity Provider", "Auth0/AWS Cognito service used for authentication and validating sessions.")
System_Ext(ExternalNotificationService, "External Notification Service", "AWS SES used to trigger transactional emails.")

System_Boundary(OnlineBookstoreSystem, "Online Bookstore System") {
    Container(Storefront, "Storefront", "React SPA, Amazon S3, Amazon CloudFront CDN", "Provides the user interface for multi-currency browsing and real-time checkout.")
    Container(APIGateway, "API Gateway", "AWS API Gateway, RBAC, JWT validation", "Routes requests securely to internal backend microservices.")
    Container(CatalogSearchService, "Catalog & Search Service", "Node.js, Amazon OpenSearch", "Handles product catalog and real-time search functionality.")
    Container(OrderCheckoutService, "Order & Checkout Service", "Spring Boot, isolated private VPC", "Processes real-time orders and integrates with fulfillment providers.")
    Container(RecommendationService, "Recommendation Service", "Python, FastAPI, Amazon DynamoDB", "Generates automated product recommendations.")
    Container(CustomerPrivacyService, "Customer Privacy Service", "Node.js, Amazon DynamoDB", "Ensures strict GDPR and CCPA compliance for user data.")
    Container(PricingCurrencyService, "Pricing & Currency Service", "Go, Redis cache", "Manages multi-currency pricing and fast retrieval.")
}

Rel(Customer, Storefront, "Interacts via HTTPS/TLS 1.3", "HTTPS")
Rel(StoreAdministrator, Storefront, "Manages content and catalog", "HTTPS")
Rel(Storefront, APIGateway, "Communicates via HTTPS/REST", "HTTPS/REST")
Rel(APIGateway, CatalogSearchService, "Routes search requests via mTLS", "mTLS")
Rel(APIGateway, OrderCheckoutService, "Routes checkout requests via mTLS", "mTLS")
Rel(APIGateway, RecommendationService, "Routes recommendation requests via mTLS", "mTLS")
Rel(APIGateway, CustomerPrivacyService, "Routes privacy requests via mTLS", "mTLS")
Rel(APIGateway, PricingCurrencyService, "Routes pricing requests via mTLS", "mTLS")
Rel(OrderCheckoutService, ExternalPaymentGateway, "Integrates for payment processing", "HTTPS/REST")
Rel(OrderCheckoutService, ExternalShippingProvider, "Integrates for order fulfillment", "HTTPS/REST")
Rel(APIGateway, ExternalIdentityProvider, "Validates JWT tokens", "HTTPS")
Rel(OrderCheckoutService, ExternalNotificationService, "Triggers transactional emails", "HTTPS")

@enduml