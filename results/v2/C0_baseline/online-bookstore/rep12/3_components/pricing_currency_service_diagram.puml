@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(pricing_currency_service, "Pricing & Currency Service") {
    Component(Pricing_Controller, "Pricing Controller", "Go, Fiber", "Handles incoming routing and request management via gRPC.")
    Component(Currency_Conversion_Engine, "Currency Conversion Engine", "Go", "Provides real-time multi-currency conversion calculations.")
    Component(Rule_Evaluation_Engine, "Rule Evaluation Engine", "Go", "Evaluates promotional pricing and business rules.")
    Component(Rate_Syncer_Worker, "Rate Syncer Worker", "Go", "Background worker responsible for syncing and updating currency rates.")
    Component(Pricing_Repository, "Pricing Repository", "Go, Amazon Aurora PostgreSQL", "Persists pricing data and immutable audit logs.")
    Component(Rate_Cache_Manager, "Rate Cache Manager", "Go, Redis", "Delivers sub-millisecond caching for pre-computed price matrices.")
}

System_Ext(API_Gateway, "API Gateway", "External API Gateway")
System_Ext(Amazon_Aurora, "Amazon Aurora", "Amazon Aurora PostgreSQL Database")
System_Ext(AWS_Secrets_Manager, "AWS Secrets Manager", "AWS Secrets Manager")

Rel(API_Gateway, Pricing_Controller, "Routes requests", "gRPC over mTLS")
Rel(Pricing_Controller, Rule_Evaluation_Engine, "Passes context", "gRPC metadata")
Rel(Currency_Conversion_Engine, Rate_Cache_Manager, "Queries rates", "in-memory Redis TLS")
Rel(Pricing_Repository, Amazon_Aurora, "Persists audit logs", "PostgreSQL wire protocol")
Rel(Rate_Syncer_Worker, AWS_Secrets_Manager, "Retrieves credentials", "HTTPS")

@enduml