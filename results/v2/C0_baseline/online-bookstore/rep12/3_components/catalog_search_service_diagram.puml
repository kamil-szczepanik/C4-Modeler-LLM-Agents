@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog & Search Service container

Container_Boundary(catalog_search_service, "Catalog & Search Service") {
    Component(Search API Controller, "Search API Controller", "Node.js", "Handles incoming HTTP/2 over mTLS requests from the API Gateway for catalog search and retrieval.")
    Component(Search Engine Client, "Search Engine Client", "Node.js, gRPC/Async", "Communicates via in-process calls with the Search API Controller and connects to Amazon OpenSearch.")
    Component(Pricing Aggregator Client, "Pricing Aggregator Client", "Node.js", "Performs in-process calls to aggregate pricing data and communicates with the Pricing & Currency Service.")
}

System_Ext(Amazon OpenSearch, "Amazon OpenSearch", "Search engine external system")
System_Ext(Pricing & Currency Service, "Pricing & Currency Service", "External pricing service")

Rel(Search API Controller, Search Engine Client, "In-process calls (gRPC/Async)", "")
Rel(Search Engine Client, Amazon OpenSearch, "HTTPS [TLS 1.3]", "")
Rel(Search API Controller, Pricing Aggregator Client, "In-process calls", "")
Rel(Pricing Aggregator Client, Pricing & Currency Service, "HTTP/2 [mTLS] within internal VPC", "")

@enduml