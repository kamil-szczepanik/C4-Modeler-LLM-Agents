@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("OrderCheckoutService", "Order & Checkout Service") {
    Component(CheckoutOrchestrator, "Checkout Orchestrator", "Spring Boot", "Orchestrates secure, multi-currency retail transactions and order fulfillment workflows.")
    Component(PaymentIntegrationAdapter, "Payment Integration Adapter", "Spring Cloud OpenFeign / HTTPS", "Communicates with the external payment gateway to process payments synchronously while ensuring zero cardholder data storage.")
    Component(FulfillmentAdapter, "Fulfillment Adapter", "AWS SDK / HTTPS", "Queues fulfillment handoffs asynchronously to external shipping providers.")
    Component(OrderManagementAPI, "Order Management API", "Spring Boot", "Provides interfaces for managing order state, logs, and retrieval.")
    ComponentDb(OrderRepository, "Order Repository", "Spring Data JPA / PostgreSQL", "Persists transactional state and audit logs into Amazon RDS PostgreSQL.")
    Component(IdempotencyTokenManager, "Idempotency & Token Manager", "AWS ElastiCache Redis", "Backs distributed idempotency checks and manages tokenization for PCI-DSS compliance.")
}

Rel(CheckoutOrchestrator, IdempotencyTokenManager, "Validates idempotency", "Local Method Call")
Rel(CheckoutOrchestrator, PaymentIntegrationAdapter, "Processes payments synchronously", "Spring Cloud OpenFeign / HTTPS")
Rel(FulfillmentAdapter, OrderManagementAPI, "Queues fulfillment handoffs asynchronously", "AWS SDK / HTTPS")
Rel(OrderManagementAPI, OrderRepository, "Persists state and logs", "Spring Data JPA / PostgreSQL")
@enduml