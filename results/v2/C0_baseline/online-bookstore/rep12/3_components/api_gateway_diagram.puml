@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

System_Ext(ExternalIdentityProvider, "External Identity Provider", "Validates JWT tokens")
System_Ext(CatalogSearchService, "Catalog & Search Service", "Backend microservice for catalog and search")
System_Ext(OrderCheckoutService, "Order & Checkout Service", "Backend microservice for orders and checkout")
System_Ext(RecommendationService, "Recommendation Service", "Backend microservice for recommendations")
System_Ext(CustomerPrivacyService, "Customer Privacy Service", "Backend microservice for customer privacy")
System_Ext(PricingCurrencyService, "Pricing & Currency Service", "Backend microservice for pricing and currency")

Container_Boundary(ApiGateway_boundary, "API Gateway") {
    Component(RoutingProxyComponent, "Routing & Proxy Component", "AWS API Gateway", "Routes incoming requests to appropriate backend microservices.")
    Component(AuthenticationAuthorizationComponent, "Authentication & Authorization Component", "AWS API Gateway, AWS Lambda", "Validates JWT tokens via External Identity Provider and handles authentication.")
    Component(RateLimitingThrottlingComponent, "Rate Limiting & Throttling Component", "AWS API Gateway, AWS WAF", "Enforces rate limits and protects against malicious traffic and OWASP Top-10 threats.")
    Component(TransformationErrorHandlingComponent, "Transformation & Error Handling Component", "AWS API Gateway, AWS Lambda", "Transforms requests and responses and provides centralized error handling.")
}

Rel(RoutingProxyComponent, CatalogSearchService, "Routes search requests", "mTLS")
Rel(RoutingProxyComponent, OrderCheckoutService, "Routes checkout requests", "mTLS")
Rel(RoutingProxyComponent, RecommendationService, "Routes recommendation requests", "mTLS")
Rel(RoutingProxyComponent, CustomerPrivacyService, "Routes privacy requests", "mTLS")
Rel(RoutingProxyComponent, PricingCurrencyService, "Routes pricing requests", "mTLS")
Rel(AuthenticationAuthorizationComponent, ExternalIdentityProvider, "Validates JWT tokens", "HTTPS")

@enduml