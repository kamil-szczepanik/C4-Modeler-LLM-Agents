@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Customer Privacy Service container

System_Ext(api_gateway, "API Gateway", "External system")
System_Ext(redis, "Redis", "External system")
System_Ext(amazon_s3, "Amazon S3", "External system")
System_Ext(amazon_dynamodb, "Amazon DynamoDB", "External system")
System_Ext(external_notification_service, "External Notification Service", "External system")

Container_Boundary(customer_privacy_service, "Customer Privacy Service") {
    Component(privacy_api_controller, "Privacy API Controller", "Node.js / Express", "Handles REST endpoints and RBAC/ABAC authorization for privacy features.")
    Component(gdpr_ccpa_workflow_engine, "GDPR/CCPA Workflow Engine", "Node.js / BullMQ", "Orchestrates asynchronous tasks, workflows, and dead-letter queues.")
    Component(data_exporter_worker, "Data Exporter Worker", "Node.js", "Packages PII into encrypted ZIP archives.")
    Component(audit_retention_logger, "Audit & Retention Logger", "Node.js", "Writes compliance trails and audit logs.")
}

Rel(api_gateway, privacy_api_controller, "Routes requests", "mTLS")
Rel(privacy_api_controller, gdpr_ccpa_workflow_engine, "Enqueues jobs", "Redis/BullMQ")
Rel(gdpr_ccpa_workflow_engine, redis, "Manages async queues", "TCP with TLS")
Rel(data_exporter_worker, amazon_s3, "Uploads encrypted archives", "AWS SDK / HTTPS")
Rel(audit_retention_logger, amazon_dynamodb, "Persists audit trails", "AWS SDK / HTTPS")
Rel(gdpr_ccpa_workflow_engine, external_notification_service, "Dispatches alerts", "HTTPS / REST")
@enduml