@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Storefront container

Container_Boundary(Storefront, "Storefront") {
    Component(Catalog UI Module, "Catalog UI Module", "React 18 with TypeScript and Tailwind CSS", "Provides the user interface for browsing and searching the product catalog.")
    Component(Checkout & Cart Module, "Checkout & Cart Module", "React 18 with TypeScript and Redux/Context", "Manages shopping cart state, multi-currency cart handling, and secure checkout workflows.")
    Component(Authentication & Session Manager, "Authentication & Session Manager", "React 18 with OAuth 2.0/PKCE", "Handles user authentication sessions and integrates with the external identity provider.")
    Component(Promotional Banner & Campaign Module, "Promotional Banner & Campaign Module", "React 18 with Tailwind CSS", "Displays promotional banners and campaign modules to users.")
    Component(Abandoned Cart Recovery Trigger, "Abandoned Cart Recovery Trigger", "React 18", "Triggers mechanisms for abandoned cart recovery.")
    Component(Localization & Currency Module, "Localization & Currency Module", "React 18", "Manages localization settings and fetches multi-currency rates via the API gateway.")
    Component(Review & Rating UI Module, "Review & Rating UI Module", "React 18 with Tailwind CSS", "Renders user reviews and ratings interfaces.")
}

System_Ext(External Identity Provider, "External Identity Provider", "External Identity Provider")
System_Ext(Pricing & Currency Service, "Pricing & Currency Service", "Pricing & Currency Service")
System_Ext(API Gateway, "API Gateway", "API Gateway")

Rel(Authentication & Session Manager, External Identity Provider, "Authenticates users via OAuth 2.0 with PKCE [HTTPS]", "HTTPS")
Rel(Localization & Currency Module, Pricing & Currency Service, "Fetches multi-currency rates via API Gateway [HTTPS/REST]", "HTTPS/REST")
Rel(Storefront, API Gateway, "Communicates UI actions and data requests via HTTPS/REST [HTTPS/REST]", "HTTPS/REST")

@enduml