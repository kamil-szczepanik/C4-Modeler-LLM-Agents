@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Online Bookstore System

Person(Customer, "Customer", "Shopper who browses, searches, and checks out products.")
Person(StoreAdministrator, "Store Administrator", "Administrator who manages inventory and orders.")

System(OnlineBookstoreSystem, "Online Bookstore System", "An Amazon-style online bookstore designed to handle 1M MAU across three global AWS regions, providing scalable catalog browsing, secure multi-currency checkout, and fulfillment.")

System_Ext(ExternalPaymentGateway, "External Payment Gateway", "Stripe/PayPal service used to process and authorize payments.")
System_Ext(ExternalShippingProvider, "External Shipping Provider", "FedEx/UPS APIs used to dispatch physical orders.")
System_Ext(ExternalIdentityProvider, "External Identity Provider", "Auth0/AWS Cognito service used for authentication and validating sessions.")
System_Ext(ExternalNotificationService, "External Notification Service", "AWS SES used to trigger transactional emails.")

Rel(Customer, OnlineBookstoreSystem, "Browses, searches, and checks out", "HTTPS (Web/Mobile)")
Rel(StoreAdministrator, OnlineBookstoreSystem, "Manages inventory and orders", "HTTPS")
Rel(OnlineBookstoreSystem, ExternalPaymentGateway, "Authorizes payments", "REST/TLS")
Rel(OnlineBookstoreSystem, ExternalShippingProvider, "Dispatches physical orders", "REST/TLS")
Rel(OnlineBookstoreSystem, ExternalIdentityProvider, "Validates sessions", "OIDC/OAuth2 over HTTPS")
Rel(OnlineBookstoreSystem, ExternalNotificationService, "Triggers transactional emails", "REST API/TLS")

@enduml