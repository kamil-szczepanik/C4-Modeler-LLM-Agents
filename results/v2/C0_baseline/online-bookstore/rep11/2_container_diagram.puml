@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore Software System

Person(Customer_Shopper, "Customer (Shopper)", "End user browsing books, making purchases, and leaving reviews.")
Person(Reviewer, "Reviewer", "Community member participating in reviews and discussions.")
Person(Store_Administrator, "Store Administrator", "Staff member managing content, moderation, and store operations.")

System_Ext(Payment_Gateway, "Payment Gateway", "External payment processing service.")
System_Ext(Shipping_Provider_APIs, "Shipping Provider APIs", "External shipping and logistics providers.")
System_Ext(Identity_Notification_Service, "Identity & Notification Service", "External identity and notification service powered by AWS SES.")

System_Boundary(Online_Bookstore_Software_System, "Online Bookstore Software System") {
    Container(Single_Page_Application_SPA, "Single Page Application (SPA)", "React / TypeScript, Amazon S3, Amazon CloudFront", "Frontend client application providing physical and electronic book sales, personalized recommendations, and reviews.")
    Container(API_Gateway_Load_Balancer, "API Gateway / Load Balancer", "Amazon API Gateway / Application Load Balancer", "Edge and routing service for incoming client traffic.")
    Container(Catalogue_Search_Service, "Catalogue & Search Service", "AWS ECS / Fargate, Amazon OpenSearch", "Manages book catalogue and handles search queries.")
    Container(Checkout_Cart_Service, "Checkout & Cart Service", "AWS ECS / Fargate, Amazon SQS / SNS", "Handles shopping cart operations and secure checkout processing.")
    Container(Recommendation_Service, "Recommendation Service", "AWS ECS / Fargate, Amazon ElastiCache (Redis), Amazon Kinesis", "Provides personalized book recommendations using streaming event capture and caching.")
    Container(Review_Service, "Review Service", "AWS ECS / Fargate", "Manages customer reviews and ratings.")
    ContainerDb(Database, "Database", "Amazon RDS (PostgreSQL with read replicas)", "Persistent storage for core transactional data with regional data residency.")
}

Rel(Customer_Shopper, Single_Page_Application_SPA, "Browses books, manages cart, and makes purchases", "HTTPS / JSON")
Rel(Reviewer, Single_Page_Application_SPA, "Writes and reads reviews", "HTTPS / JSON")
Rel(Store_Administrator, Single_Page_Application_SPA, "Administers store operations and content", "HTTPS / JSON")

Rel(Single_Page_Application_SPA, API_Gateway_Load_Balancer, "Sends API requests", "HTTPS / JSON")

Rel(API_Gateway_Load_Balancer, Catalogue_Search_Service, "Routes catalogue and search queries", "HTTPS / REST")
Rel(API_Gateway_Load_Balancer, Checkout_Cart_Service, "Routes cart and checkout requests", "HTTPS / REST")
Rel(API_Gateway_Load_Balancer, Recommendation_Service, "Fetches recommendations", "HTTPS / REST")
Rel(API_Gateway_Load_Balancer, Review_Service, "Routes review operations", "HTTPS / REST")

Rel(Checkout_Cart_Service, Database, "Reads and writes transactional data", "PostgreSQL protocol")
Rel(Catalogue_Search_Service, Database, "Reads catalogue data", "PostgreSQL protocol")
Rel(Review_Service, Database, "Reads and writes reviews", "PostgreSQL protocol")

Rel(Recommendation_Service, Database, "Performs sub-50ms recommendation lookups", "Redis protocol")

Rel(Checkout_Cart_Service, Payment_Gateway, "Processes payments", "HTTPS / REST via Outbox Pattern")
Rel(Checkout_Cart_Service, Shipping_Provider_APIs, "Dispatches shipping orders", "Amazon SQS / SNS")
Rel(Checkout_Cart_Service, Identity_Notification_Service, "Triggers notifications", "HTTPS / REST")

@enduml