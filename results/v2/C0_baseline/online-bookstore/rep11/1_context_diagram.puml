@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer (Shopper)", "End user browsing books, making purchases, and leaving reviews.")
Person(Reviewer, "Registered Reviewer / Community Member", "Community member participating in reviews and discussions.")
Person(Admin, "Store Administrator / Content Moderator", "Staff member managing content, moderation, and store operations.")

System(BookstoreSystem, "Online Bookstore Software System", "Cloud-native, Amazon-style online bookstore offering physical and electronic books, reviews, and recommendations, designed for global scale, high availability, strict security, and GDPR/CCPA compliance.")

System_Ext(PaymentGateway, "Payment Gateway", "External payment processing service such as Stripe or PayPal.")
System_Ext(ShippingAPI, "Shipping Provider APIs", "External shipping and logistics providers like FedEx and UPS.")
System_Ext(NotificationService, "Identity & Notification Service", "External identity and notification service powered by AWS SES.")

Rel(Customer, BookstoreSystem, "Browses, purchases, and interacts with the bookstore", "HTTPS (TLS 1.3)")
Rel(Reviewer, BookstoreSystem, "Writes reviews and participates in community features", "HTTPS (TLS 1.3)")
Rel(Admin, BookstoreSystem, "Administers content and moderates the platform", "HTTPS (TLS 1.3)")

Rel(BookstoreSystem, PaymentGateway, "Processes payments securely", "HTTPS/REST with mTLS")
Rel(BookstoreSystem, ShippingAPI, "Handles shipping and logistics asynchronously", "HTTPS/REST via AWS SQS async queuing")
Rel(BookstoreSystem, NotificationService, "Sends user notifications and manages identities", "HTTPS/SMTP")

@enduml