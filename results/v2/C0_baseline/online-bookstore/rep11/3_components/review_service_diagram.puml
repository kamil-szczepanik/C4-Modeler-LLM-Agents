@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Review Service", "Review Service") {
    Component("Review Service API Controller", "Review Service API Controller", "Spring Boot / Java", "Handles incoming HTTP requests for customer reviews and moderation.")
    Component("Review Processing Service", "Review Processing Service", "Java / Spring", "Business logic processing for reviews, ratings, and content moderation workflows.")
    Component("Review Data Repository", "Review Data Repository", "JDBC / Spring Data JPA", "Manages persistence and retrieval of review data from Amazon RDS PostgreSQL.")
}

System_Ext("Amazon SQS / SNS", "Amazon SQS / SNS", "Messaging infrastructure")

Rel("Review Service API Controller", "Review Processing Service", "Delegates business logic to", "")
Rel("Review Processing Service", "Review Data Repository", "Persists review data via", "JDBC / Spring Data JPA")
Rel("Review Processing Service", "Amazon SQS / SNS", "Publishes asynchronous review events using", "AWS SQS/SNS protocol")

@enduml