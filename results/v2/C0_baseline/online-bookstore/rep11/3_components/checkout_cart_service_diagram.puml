@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Checkout & Cart Service container

System_Ext(api_gateway, "API Gateway", "External API Gateway routing requests")
System_Ext(payment_gateway, "Payment Gateway", "External payment processor")
System_Ext(shipping_identity, "Shipping Provider APIs & Identity Service", "External shipping and identity services")

Container_Boundary(checkout_cart_service, "Checkout & Cart Service") {
    Component(Cart_Management_Component, "Cart Management Component", "Node.js / Express", "Manages shopping cart operations and interacts with cache for cart state.")
    Component(Checkout_Orchestrator_Component, "Checkout Orchestrator Component", "Node.js / TypeScript", "Coordinates transactional checkout processing and workflow.")
    Component(Payment_Integration_Component, "Payment Integration Component", "Node.js / TypeScript", "Processes secure payments ensuring PCI compliance.")
    Component(Order_Fulfillment_Component, "Order Fulfillment Component", "Node.js / TypeScript", "Dispatches orders and publishes events via messaging.")
    Component(Currency__Pricing_Sub_module, "Currency & Pricing Sub-module", "Node.js / TypeScript", "Handles multi-currency pricing calculations.")
    Component(Amazon_ECS___Fargate, "Amazon ECS / Fargate", "AWS ECS / Fargate", "Container orchestration providing elastic scalability.")
    Component(Amazon_ElastiCache__Redis_, "Amazon ElastiCache (Redis)", "Redis", "Low-latency in-memory data store for ephemeral cart management.")
    Component(Amazon_RDS__PostgreSQL_, "Amazon RDS (PostgreSQL)", "PostgreSQL", "Relational database utilizing the Outbox Pattern for transactional processing.")
    Component(Amazon_SQS___SNS, "Amazon SQS / SNS", "AWS SQS / SNS", "Message queuing and notification service for dispatches and events.")
    Component(AWS_Secrets_Manager___AWS_WAF, "AWS Secrets Manager & AWS WAF", "AWS Secrets Manager / WAF", "Secures credentials and protects endpoints against attacks.")
}

Rel(api_gateway, checkout_cart_service, "Routes cart and checkout requests", "HTTPS / REST over TLS 1.3")
Rel(Cart_Management_Component, Amazon_ElastiCache__Redis_, "Retrieves and persists cart state", "Redis Protocol")
Rel(Payment_Integration_Component, payment_gateway, "Processes secure payments", "HTTPS / REST via Outbox Pattern")
Rel(Order_Fulfillment_Component, shipping_identity, "Dispatches orders and events", "Amazon SQS / SNS")
Rel(checkout_cart_service, Amazon_RDS__PostgreSQL_, "Reads and writes transactional data and outbox events", "PostgreSQL Protocol")

@enduml