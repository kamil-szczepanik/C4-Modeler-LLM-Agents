@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(spa_boundary, "Single Page Application (SPA)") {
    Component(routing_shell, "Routing & Shell Component", "React Router", "Handles client-side routing and overall application layout shell.")
    Component(catalog_search, "Catalog & Search Module", "React, TypeScript", "Provides catalog browsing and search capabilities.")
    Component(cart_checkout, "Cart & Checkout State Machine", "Redux Toolkit", "Manages complex cart workflows and checkout state predictably.")
    Component(recommendation_reviews, "Recommendation & Review Widgets", "React, TypeScript, DOMPurify", "Displays product recommendations and sanitized user reviews.")
    Component(api_client, "API Client & Interceptor Module", "Axios", "Centralized HTTP client with interceptors for auth and tracing.")
}

Rel(routing_shell, catalog_search, "Renders")
Rel(routing_shell, cart_checkout, "Renders")
Rel(routing_shell, recommendation_reviews, "Renders")
Rel(catalog_search, api_client, "Fetches catalog data via")
Rel(cart_checkout, api_client, "Submits cart/checkout via")
Rel(recommendation_reviews, api_client, "Fetches recommendations and reviews via")
@enduml