@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("API Gateway / Load Balancer", "API Gateway / Load Balancer") {
    Component(Amazon_API_Gateway, "Amazon API Gateway", "AWS API Gateway", "Manages API routing, JWT validation via cached JWKS, and rate-limiting.")
    Component(Application_Load_Balancer, "Application Load Balancer", "AWS ALB", "Distributes incoming dynamic API traffic across backend microservices.")
    Component(AWS_WAF_and_Shield, "AWS WAF and Shield", "AWS WAF / AWS Shield", "Provides automated OWASP Top-10 mitigations, rate-based rules, and DDoS protection.")
}

Rel(Amazon_API_Gateway, Application_Load_Balancer, "Routes and balances validated API requests", "HTTPS")
Rel(AWS_WAF_and_Shield, Amazon_API_Gateway, "Inspects and filters incoming traffic for security threats", "HTTPS")
@enduml