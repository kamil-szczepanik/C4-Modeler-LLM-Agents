@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Ext(checkout_cart_service, "Checkout & Cart Service", "Microservice", "Handles shopping cart and checkout processes.")
Container_Ext(catalogue_search_service, "Catalogue & Search Service", "Microservice", "Handles product searching and catalog browsing.")

System_Boundary(database, "Database") {
    Component(core_transaction_engine, "Core Transaction Engine", "Amazon RDS PostgreSQL", "Executes ACID writes, user data management, and transactional processing.")
    Component(catalog_jsonb_store, "Catalog & JSONB Store", "PostgreSQL JSONB", "Manages multi-currency catalogs and flexible product metadata storage.")
    Component(cdc_publisher, "CDC Publisher", "AWS DMS / Debezium", "Facilitates low-latency change data capture using PostgreSQL Logical Decoding.")
    Component(amazon_kinesis, "Amazon Kinesis", "Amazon Kinesis", "Streams transaction events asynchronously for recommendations.")
    Component(aws_secrets_manager, "AWS Secrets Manager", "AWS Secrets Manager", "Secures database credentials with automatic rotation.")
    Component(amazon_cloudwatch, "Amazon CloudWatch", "Amazon CloudWatch", "Routes audit logs and performance metrics.")
}

Rel(checkout_cart_service, core_transaction_engine, "Executes ACID writes", "PostgreSQL protocol, TLS 1.3, IAM Auth")
Rel(catalogue_search_service, catalog_jsonb_store, "Queries product details", "PostgreSQL protocol, TLS 1.3")
Rel(core_transaction_engine, amazon_kinesis, "Streams transaction events for recommendations", "CDC / PostgreSQL Logical Decoding")
Rel(core_transaction_engine, amazon_cloudwatch, "Routes audit logs and performance metrics", "AWS API")

@enduml