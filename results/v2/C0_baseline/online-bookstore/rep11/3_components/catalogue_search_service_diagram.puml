@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(catalogue_search_service, "Catalogue & Search Service") {
    Component(Search API Controller, "Search API Controller", "Node.js / Express", "Routes search queries via HTTPS / REST and delegates query processing.")
    Component(Search Query Engine, "Search Query Engine", "Node.js", "Processes search queries and interacts with OpenSearch and fallback handlers.")
    Component(Database Fallback Handler, "Database Fallback Handler", "Node.js", "Triggers fallback on circuit breaker trip and retrieves cached search payloads.")
    Component(Catalogue Sync Worker, "Catalogue Sync Worker", "Node.js", "Synchronizes catalogue index via asynchronous events.")
}

System_Ext(api_gateway, "Amazon API Gateway / Application Load Balancer", "Routes external requests to the services.")
System_Ext(opensearch, "Amazon OpenSearch", "Primary search engine for fast keyword lookup and faceted aggregations.")
System_Ext(elasticache, "Amazon ElastiCache (Redis)", "Caching layer for fast fallback responses during outages.")

Rel(api_gateway, Search API Controller, "Routes search queries", "HTTPS / REST")
Rel(Search API Controller, Search Query Engine, "Delegates query processing", "in-memory function call")
Rel(Search Query Engine, opensearch, "Executes search and aggregations", "HTTP / REST with AWS SigV4")
Rel(Search Query Engine, Database Fallback Handler, "Triggers fallback on circuit breaker trip", "internal function call")
Rel(Database Fallback Handler, elasticache, "Retrieves cached search payloads", "Redis protocol")
Rel(Catalogue Sync Worker, opensearch, "Synchronizes catalogue index", "asynchronous events")

@enduml