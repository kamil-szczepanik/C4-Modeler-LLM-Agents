@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Recommendation Service container

System_Ext(ApiGateway, "API Gateway", "Routes external traffic to internal containers")
System_Ext(AmazonElastiCacheRedis, "Amazon ElastiCache (Redis)", "Provides sub-50ms cache lookups and multi-region Global Datastores.")
System_Ext(AmazonKinesis, "Amazon Kinesis", "Ingests real-time shopper clickstream events.")
System_Ext(AmazonRDSPostgreSQL, "Amazon RDS (PostgreSQL)", "Stores promotional overrides and audit logs securely.")

Container_Boundary(RecommendationService, "Recommendation Service") {
    Component(RecommendationAPIContainer, "Recommendation API Container", "Node.js / Express", "Powers the lightweight Recommendation API for high-throughput reads.")
    Component(BackgroundWorkerContainer, "Background Worker Container", "Python / FastAPI", "Implements the background worker for scoring, ranking, and merchandising logic.")
}

Rel(ApiGateway, RecommendationAPIContainer, "Fetches recommendations", "HTTPS / REST")
Rel(RecommendationAPIContainer, AmazonElastiCacheRedis, "Reads pre-computed or fallback lists", "Redis protocol, <50ms")
Rel(BackgroundWorkerContainer, AmazonKinesis, "Consumes clickstream events", "TCP")
Rel(BackgroundWorkerContainer, AmazonRDSPostgreSQL, "Manages promotional rules and audit logs", "TCP / SQL")
Rel(BackgroundWorkerContainer, AmazonElastiCacheRedis, "Writes merged recommendation payloads", "Redis protocol")

@enduml