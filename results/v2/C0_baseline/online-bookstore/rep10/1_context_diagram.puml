@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(CustomerShopper, "Customer (Shopper)", "End users browsing the catalog, making secure purchases, and leaving reviews.")
Person(BookAuthorPublisher, "Book Author/Publisher", "Stakeholders managing book listings and metadata.")
Person(StoreAdministrator, "Store Administrator", "Operations personnel managing the bookstore system and configurations.")

System(OnlineBookstore, "Online Bookstore", "A multi-region e-commerce platform providing catalog browsing, secure checkout, reviews, and personalized book recommendations.")

System_Ext(PaymentGateway, "Payment Gateway", "External system processing secure financial transactions.")
System_Ext(ThirdPartyShippingAPI, "Third-Party Shipping API", "External system handling order fulfillment and shipping logistics.")
System_Ext(TaxComplianceService, "Tax & Compliance Service", "External system calculating regional taxes and ensuring compliance.")
System_Ext(EdgeRoutingCDNLayer, "Edge Routing & CDN Layer", "AWS CloudFront and Route 53 providing global content delivery and Anycast DNS.")

Rel(CustomerShopper, EdgeRoutingCDNLayer, "Accesses catalog, checkout, and recommendations", "HTTPS (TLS 1.3)")
Rel(BookAuthorPublisher, EdgeRoutingCDNLayer, "Manages catalog content and publishing details", "HTTPS (TLS 1.3)")
Rel(StoreAdministrator, EdgeRoutingCDNLayer, "Administers the bookstore platform", "HTTPS (TLS 1.3)")
Rel(EdgeRoutingCDNLayer, OnlineBookstore, "Routes global traffic to the core system", "HTTPS")
Rel(OnlineBookstore, PaymentGateway, "Processes customer payments", "HTTPS/REST webhooks")
Rel(OnlineBookstore, ThirdPartyShippingAPI, "Coordinates order fulfillment and shipping", "HTTPS/REST webhooks")
Rel(OnlineBookstore, TaxComplianceService, "Calculates taxes and ensures regulatory compliance", "gRPC/HTTPS")

@enduml