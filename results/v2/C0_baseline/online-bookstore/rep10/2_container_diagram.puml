@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore

Person(Shopper, "Shopper", "External human user interacting with the platform for browsing, cart management, checkout, and reviews.")
Person(AuthorPublisher, "Author/Publisher", "External human user interacting with the platform.")
Person(Administrator, "Administrator", "External human user administering the platform.")

System_Ext(PaymentGateway, "Payment Gateway", "External system processing secure financial transactions.")
System_Ext(ThirdPartyShippingAPI, "Third-Party Shipping API", "External system handling order fulfillment and shipping logistics.")
System_Ext(TaxComplianceService, "Tax & Compliance Service", "External system calculating regional taxes and ensuring compliance.")

System_Boundary(OnlineBookstore, "Online Bookstore") {
    Container(SPA, "Single Page Application (SPA)", "React / TypeScript, Amazon S3, Amazon CloudFront", "Frontend frontend hosted globally for catalogue browsing, cart management, checkout, reviews, and recommendations.")
    Container(APIGateway, "API Gateway", "AWS API Gateway", "Single secure entry point providing rate limiting and JWT validation.")
    Container(CatalogSearchContainer, "Catalog & Search Container", "Spring Boot, Java, Amazon ECS Fargate", "Service handling catalog searches and browse functionality.")
    Container(CheckoutOrderContainer, "Checkout & Order Container", "Spring Boot, Java, Amazon ECS Fargate", "Service managing checkout and order processes.")
    Container(RecommendationService, "Recommendation Service", "Python, FastAPI, Amazon ECS Fargate", "Service providing personalized book recommendations.")
    Container(ShippingPaymentIntegrationWorker, "Shipping & Payment Integration Worker", "AWS Lambda, Amazon SQS", "Background workers for asynchronous shipping and payment processing.")
    ContainerDb(DataStores, "Data Stores", "Amazon Aurora PostgreSQL, Amazon DynamoDB, AWS KMS", "Persists transactional data and recommendations securely.")
}

Rel(Shopper, SPA, "Accesses frontend application", "HTTPS/REST")
Rel(AuthorPublisher, SPA, "Accesses platform interface", "HTTPS/REST")
Rel(Administrator, SPA, "Accesses management interface", "HTTPS/REST")
Rel(SPA, APIGateway, "Communicates via REST and gRPC", "HTTPS/REST and gRPC")
Rel(APIGateway, CatalogSearchContainer, "Routes synchronously", "REST")
Rel(APIGateway, CheckoutOrderContainer, "Routes synchronously", "REST")
Rel(APIGateway, RecommendationService, "Routes synchronously", "gRPC")
Rel(CheckoutOrderContainer, ShippingPaymentIntegrationWorker, "Communicates asynchronously for background processing", "AWS SQS")
Rel(CheckoutOrderContainer, TaxComplianceService, "Calls for tax calculation and compliance", "HTTPS over AWS PrivateLink")
Rel(CatalogSearchContainer, DataStores, "Persists state", "AWS KMS encryption")
Rel(CheckoutOrderContainer, DataStores, "Persists state", "AWS KMS encryption")
Rel(RecommendationService, DataStores, "Persists state", "AWS KMS encryption")
Rel(ShippingPaymentIntegrationWorker, PaymentGateway, "Integrates for payment processing", "HTTPS")
Rel(ShippingPaymentIntegrationWorker, ThirdPartyShippingAPI, "Integrates for shipping logistics", "HTTPS")

@enduml