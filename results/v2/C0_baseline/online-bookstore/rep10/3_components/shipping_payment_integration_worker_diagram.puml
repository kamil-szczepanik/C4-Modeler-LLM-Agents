@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Shipping & Payment Integration Worker container

Container_Ext(CheckoutOrderContainer, "Checkout & Order Container", "Container", "Sends asynchronous orders")
System_Ext(PaymentGateway, "Payment Gateway", "External payment gateway")
System_Ext(ThirdPartyShippingAPI, "Third-Party Shipping API", "External shipping API")
System_Ext(AmazonEventBridge, "Amazon EventBridge", "Event bus for publishing sanitized audit logs")
System_Ext(AWSSecretsManager, "AWS Secrets Manager", "Dynamic credential management with automatic rotation")

Container_Boundary(ShippingPaymentIntegrationWorker, "Shipping & Payment Integration Worker") {
    Component(SQSEventConsumer, "SQS Event Consumer", "AWS Lambda Handler, Python/Java", "Processes asynchronous orders via serverless infrastructure.")
    Component(IdempotencyManager, "Idempotency Manager", "Amazon DynamoDB Global Tables with 7-day TTL", "Manages idempotency for order processing.")
    Component(PaymentProcessorClient, "Payment Processor Client", "HTTP Client", "Communicates with external payment gateways.")
    Component(FulfillmentIntegrator, "Fulfillment Integrator", "HTTP Client", "Integrates with third-party shipping APIs.")
    Component(DLQHandler, "DLQ Handler", "Amazon SQS Dead-Letter Queue", "Handles failed messages and retries.")
    Component(AuditEventEmitter, "Audit Event Emitter", "Amazon EventBridge", "Emits audit events for logging and compliance.")
    Component(SecretsCurrencyContextInjector, "Secrets & Currency Context Injector", "AWS Lambda Powertools", "Injects secrets and currency context securely.")
}

Rel(CheckoutOrderContainer, SQSEventConsumer, "AWS SQS")
Rel(PaymentProcessorClient, PaymentGateway, "HTTPS")
Rel(FulfillmentIntegrator, ThirdPartyShippingAPI, "HTTPS")
Rel(AuditEventEmitter, AmazonEventBridge, "AWS SDK")
Rel(SecretsCurrencyContextInjector, AWSSecretsManager, "HTTPS/AWS SDK")

@enduml