@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(WAF_and_Edge_Security_Router, "WAF and Edge Security Router", "AWS WAF, Amazon CloudFront, Amazon Route 53", "Inspects incoming traffic for OWASP Top-10 vulnerabilities, applies rate-limiting, and routes DNS queries globally.")
    Component(API_Routing_and_Validation_Engine, "API Routing and Validation Engine", "AWS API Gateway", "Validates JWT tokens, enforces request schemas, and routes requests to downstream microservices.")
    Component(Asynchronous_Integration_Dispatcher, "Asynchronous Integration Dispatcher", "AWS Lambda, Amazon SQS", "Handles asynchronous calls to third-party payment, shipping, and tax APIs via message queues.")
}

Rel(WAF_and_Edge_Security_Router, API_Routing_and_Validation_Engine, "Forwards filtered HTTPS requests", "HTTPS")
Rel(API_Routing_and_Validation_Engine, Asynchronous_Integration_Dispatcher, "Offloads third-party API traffic using", "SQS/Lambda")

@enduml