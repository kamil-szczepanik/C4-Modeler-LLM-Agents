@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Stores container

Container_Boundary(data_stores, "Data Stores") {
    Component(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL (Multi-AZ / Multi-Region)", "Handles ACID transactional data, orders, and reviews with Multi-AZ and Multi-Region capabilities.")
    Component(Amazon_DynamoDB, "Amazon DynamoDB", "Amazon DynamoDB (Global Tables)", "Provides ultra-low latency storage for shopping carts, sessions, and recommendation vectors using Global Tables.")
    Component(Amazon_RDS_Proxy, "Amazon RDS Proxy", "Amazon RDS Proxy", "Manages and pools database connections to prevent connection exhaustion during traffic surges.")
    Component(AWS_Secrets_Manager, "AWS Secrets Manager", "AWS Secrets Manager", "Manages and retrieves database credentials and system secrets securely.")
    Component(AWS_KMS_CloudTrail, "AWS KMS & CloudTrail", "AWS KMS / Amazon CloudTrail", "Handles encryption at rest/transit, Customer Managed Key (CMK) management, and audit logging.")
}

Rel(Amazon_Aurora_PostgreSQL, AWS_KMS_CloudTrail, "API Calls for Encryption/Decryption and CMK Management")
Rel(Amazon_DynamoDB, AWS_KMS_CloudTrail, "API Calls for Encryption/Decryption and CMK Management")
Rel(Amazon_RDS_Proxy, Amazon_Aurora_PostgreSQL, "Proxies TLS 1.3 / SQL connections via IAM Database Authentication")

@enduml