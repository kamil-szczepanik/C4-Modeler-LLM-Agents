@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog & Search Container container

System_Ext(API_Gateway, "API Gateway", "External API Gateway routing requests.")
System_Ext(Recommendation_Service_Container, "Recommendation Service Container", "External recommendation service.")

Container_Boundary(Catalog_Search_Container, "Catalog & Search Container") {
    Component(Search_API_Controller, "Search API Controller", "Spring MVC", "Handles book discovery, faceted filtering, and search functionality.")
    Component(Catalog_Query_Service, "Catalog Query Service", "Spring Data / Domain Logic", "Executes core search and query domain logic.")
    Component(Product_Detail_Repository, "Product Detail Repository", "Spring Data JPA", "Queries canonical book metadata from the database.")
    Component(Cache_Manager_Component, "Cache Manager Component", "Spring Data Redis", "Manages distributed caching for low-latency query results.")
    Component(Recommendation_Integration_Client, "Recommendation Integration Client", "Spring Cloud OpenFeign", "Fetches personalized recommendations from external services.")
    Component(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Primary data store for catalog persistence.")
    Component(Amazon_ElastiCache_Redis, "Amazon ElastiCache (Redis)", "Amazon ElastiCache (Redis)", "Distributed caching layer for low-latency multi-currency query results.")
}

Rel(API_Gateway, Search_API_Controller, "Routes search requests", "REST over HTTPS, AWS SigV4")
Rel(Search_API_Controller, Catalog_Query_Service, "Delegates search and query logic", "In-process")
Rel(Catalog_Query_Service, Product_Detail_Repository, "Requests canonical book metadata", "In-process")
Rel(Catalog_Query_Service, Cache_Manager_Component, "Reads/writes query results", "In-memory / Redis protocol over TLS")
Rel(Cache_Manager_Component, Amazon_ElastiCache_Redis, "Stores/retrieves cached data", "Redis protocol over TLS")
Rel(Product_Detail_Repository, Amazon_Aurora_PostgreSQL, "Queries canonical book metadata", "JDBC over TLS 1.3")
Rel(Recommendation_Integration_Client, Recommendation_Service_Container, "Fetches personalized recommendations", "REST over HTTPS, OAuth2 / SigV4")
Rel(Catalog_Query_Service, Recommendation_Integration_Client, "Requests personalized recommendations", "In-process")
@enduml