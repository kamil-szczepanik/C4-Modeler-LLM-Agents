@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Checkout & Order Container container

Component(API_Gateway, "API Gateway", "AWS API Gateway", "Routes synchronous HTTP/REST requests to the Checkout Orchestrator Component.")
Component(Tax_Compliance_Service, "Tax & Compliance Service", "External Service", "External compliance service called via HTTPS over AWS PrivateLink.")
Component(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Persists data via TLS 1.3 with AWS KMS encryption.")

Container_Boundary(Checkout_Order_Container, "Checkout & Order Container") {
    Component(Checkout_Orchestrator_Component, "Checkout Orchestrator Component", "Spring Boot (Java) / Amazon ECS Fargate", "Coordinates REST transaction flows from the API Gateway.")
    Component(Order_Management_Component, "Order Management Component", "Spring Boot (Java) / Amazon Aurora PostgreSQL / AWS KMS", "Manages order state persistence using Amazon Aurora PostgreSQL with AWS KMS encryption.")
    Component(Tax_Currency_Engine_Component, "Tax & Currency Engine Component", "Spring Boot (Java) / AWS PrivateLink", "Integrates synchronously with the Tax & Compliance Service via AWS PrivateLink.")
    Component(Event_Dispatcher_Component, "Event Dispatcher Component", "Spring Boot (Java) / Amazon SQS / Amazon EventBridge", "Asynchronously handles audit, compliance, and business telemetry publishing.")
    Component(Shipping_Payment_Integration_Worker, "Shipping & Payment Integration Worker", "Spring Boot (Java) / Amazon SQS", "Processes background payment and shipping workflows via AWS SQS.")
    Component(Analytics_Sink, "Analytics Sink", "Amazon EventBridge / Kinesis Data Streams", "Receives decoupled funnel metrics via Amazon EventBridge or Kinesis Data Streams.")
}

Rel(API_Gateway, Checkout_Orchestrator_Component, "Routes synchronous HTTP/REST requests.")
Rel(Tax_Currency_Engine_Component, Tax_Compliance_Service, "Calls via HTTPS over AWS PrivateLink.")
Rel(Order_Management_Component, Amazon_Aurora_PostgreSQL, "Persists data via TLS 1.3 with AWS KMS encryption.")
Rel(Event_Dispatcher_Component, Shipping_Payment_Integration_Worker, "Publishes asynchronous events via Amazon SQS.")
Rel(Event_Dispatcher_Component, Analytics_Sink, "Emits operational telemetry via Amazon EventBridge / Kinesis Data Streams.")

@enduml