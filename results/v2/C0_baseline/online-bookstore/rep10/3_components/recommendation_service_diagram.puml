@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(API_Gateway, "API Gateway", "gRPC, mTLS", "Routes incoming traffic synchronously via gRPC (mTLS).")
System_Ext(Event_Bus, "Event Bus", "AMQP, Kafka", "Ingests real-time clickstream events via AMQP/Kafka protocol.")
System_Ext(Data_Stores, "Data Stores", "Amazon DynamoDB, Amazon S3", "Amazon DynamoDB global tables and Amazon S3 for model weights.")

Container_Boundary(Recommendation_Service, "Recommendation Service") {
    Component(API_Router_Controller, "API Router / Controller", "FastAPI, Pydantic", "FastAPI component handling incoming gRPC requests and Pydantic input validation.")
    Component(Recommendation_Engine, "Recommendation Engine", "Python", "Python-based algorithmic component executing collaborative filtering and matrix calculations.")
    Component(Event_Consumer, "Event Consumer", "Kafka, SQS", "Asynchronous Kafka/SQS client ingesting real-time clickstream and cart events.")
    Component(Data_Access_Repository, "Data Access Repository", "SQLAlchemy, Asyncpg", "SQLAlchemy/Asyncpg interface to regional data stores.")
    Component(Inventory_Pricing_Filter_Interceptor, "Inventory & Pricing Filter Interceptor", "Python Middleware", "Middleware filtering out-of-stock items and multi-currency pricing flags (USD, EUR, GBP).")
}

Rel(API_Gateway, API_Router_Controller, "Routes incoming traffic", "gRPC (mTLS)")
Rel(Event_Bus, Event_Consumer, "Ingests real-time clickstream events", "AMQP/Kafka")
Rel(API_Router_Controller, Recommendation_Engine, "Executes in-process method calls", "Python")
Rel(Recommendation_Engine, Inventory_Pricing_Filter_Interceptor, "Passes raw candidate lists", "Python")
Rel(Inventory_Pricing_Filter_Interceptor, Data_Access_Repository, "Fetches localized stock status", "TCP/TLS")
Rel(Recommendation_Engine, Data_Access_Repository, "Queries embeddings and historical interactions", "TCP/TLS")
Rel(Data_Access_Repository, Data_Stores, "Reads/Writes data", "TCP/TLS")
@enduml