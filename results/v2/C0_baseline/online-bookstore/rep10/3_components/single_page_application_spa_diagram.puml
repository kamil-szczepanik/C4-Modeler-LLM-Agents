@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(aws_api_gateway, "AWS API Gateway", "Secure entry point for all backend microservices")

Container_Boundary(spa, "Single Page Application (SPA)") {
    Component(router_auth, "Router & Auth Guard Component", "React Router", "Role-based route protection and navigation management.")
    Component(catalog_search, "Catalog & Search Component", "Redux Toolkit", "Browsing and keyword search functionality for books (R-01).")
    Component(cart_checkout, "Cart & Checkout Component", "React / Redux", "Manages shopping cart state and secure checkout (R-02).")
    Component(recommendation_review, "Recommendation & Review Component", "React", "Displays 5-star ratings and recommendations (R-03, R-04).")
    Component(admin_dashboard, "Admin & Publisher Dashboard Component", "React Lazy-loaded Chunk", "Back-office interface chunk for administrators and publishers.")
    Component(localization_provider, "Localization & Currency Provider Component", "React Context API / formatjs", "Multi-currency handling (USD, EUR, GBP) and internationalization formatting.")
}

Rel(router_auth, admin_dashboard, "Lazy loads", "")
Rel(catalog_search, aws_api_gateway, "Fetches data and mutates state", "HTTPS/REST")
Rel(cart_checkout, aws_api_gateway, "Fetches data and mutates state", "HTTPS/REST")
Rel(recommendation_review, aws_api_gateway, "Fetches data and mutates state", "HTTPS/REST")

@enduml