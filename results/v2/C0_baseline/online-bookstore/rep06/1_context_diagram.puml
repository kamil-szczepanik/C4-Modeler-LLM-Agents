@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Online Bookstore Web/Mobile Application

Person(Book Buyers, "Book Buyers", "End users who purchase physical and electronic books, read reviews, and receive personalized recommendations.")
Person(Registered Reviewers, "Registered Reviewers", "Users who leave reviews and interact with the book catalog.")
Person(Store Administrators, "Store Administrators", "Administrators who manage the bookstore system.")

System_Ext(Payment Gateway, "Payment Gateway", "External payment processing service such as Stripe or PayPal.")
System_Ext(Shipping Providers, "Shipping Providers", "External fulfillment and delivery partners such as UPS, FedEx, or DHL.")
System_Ext(Tax & Compliance Service, "Tax & Compliance Service", "Services for tax and compliance management such as Avalara or OneTrust.")
System_Ext(Identity Provider, "Identity Provider", "Managed identity and authentication service such as AWS Cognito or Auth0.")
System_Ext(CDN / Edge WAF, "CDN / Edge WAF", "Content delivery network and web application firewall such as Cloudflare or AWS CloudFront.")
System_Ext(Marketing & Email Service, "Marketing & Email Service", "Communication and marketing platform such as SendGrid or Klaviyo.")
System_Ext(Observability & APM, "Observability & APM", "Monitoring and telemetry platform such as Datadog or CloudWatch.")

System(Online Bookstore Web/Mobile Application, "Online Bookstore Web/Mobile Application", "A global, cloud-native e-commerce platform delivering physical and electronic book sales, reviews, and personalized recommendations to 1 million monthly active users.")

Rel(Book Buyers, CDN / Edge WAF, "Sends web and mobile traffic", "HTTPS, TLS 1.3")
Rel(Registered Reviewers, CDN / Edge WAF, "Sends web and mobile traffic", "HTTPS, TLS 1.3")
Rel(Store Administrators, CDN / Edge WAF, "Sends administrative traffic with MFA", "HTTPS, TLS 1.3")
Rel(CDN / Edge WAF, Online Bookstore Web/Mobile Application, "Routes traffic via reverse proxy and DNS routing", "Reverse proxy / DNS routing")
Rel(Online Bookstore Web/Mobile Application, Payment Gateway, "Processes payments", "HTTPS / REST API")
Rel(Online Bookstore Web/Mobile Application, Shipping Providers, "Dispatches shipping orders", "Asynchronous event-driven queues / HTTPS REST API")
Rel(Online Bookstore Web/Mobile Application, Tax & Compliance Service, "Calculates taxes and ensures compliance", "HTTPS / REST API")
Rel(Online Bookstore Web/Mobile Application, Identity Provider, "Authenticates users and administrators", "HTTPS / OIDC / OAuth2")
Rel(Online Bookstore Web/Mobile Application, Marketing & Email Service, "Sends marketing communications and webhooks", "HTTPS / REST API & Webhooks")
Rel(Online Bookstore Web/Mobile Application, Observability & APM, "Sends metrics, logs, and traces", "HTTPS / OTLP")

@enduml