@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Order & Checkout Service container

Container_Boundary(order_checkout_service, "Order & Checkout Service") {
    Component(Checkout Orchestrator Component, "Checkout Orchestrator Component", "Spring Boot / Spring State Machine", "Manages distributed transaction sagas and idempotent API calls.")
    Component(Order Management API Component, "Order Management API Component", "Spring MVC / REST", "Exposes secure endpoints for Customer Support Agent refunds and cancellations.")
    Component(Order Persistence Component, "Order Persistence Component", "Spring Data JPA / AWS RDS PostgreSQL", "Manages relational data and provides strict ACID compliance.")
    Component(Event Publisher Component, "Event Publisher Component", "Spring Cloud Stream / AWS SDK", "Dispatches asynchronous events to AWS EventBridge.")
}

Component(Payment Gateway, "Payment Gateway", "External Systems / HTTPS", "Handles payment processing integration.")
Component(Third-Party Shipping APIs, "Third-Party Shipping APIs", "External Systems / HTTPS", "Handles fulfillment and shipping logistics.")
Component(Tax & Compliance Service, "Tax & Compliance Service", "External Systems / HTTPS", "Calculates taxes and ensures regulatory compliance.")
Component(AWS Secrets Manager, "AWS Secrets Manager", "AWS Secrets Manager / KMS", "Ensures zero hardcoded secrets and envelope encryption.")
Component(AWS EventBridge, "AWS EventBridge", "AWS EventBridge / SQS", "Decouples domain event publishing with dead-letter queue support.")

Rel(Checkout Orchestrator Component, Payment Gateway, "HTTPS / REST API", "HTTPS")
Rel(Checkout Orchestrator Component, Third-Party Shipping APIs, "HTTPS / REST API", "HTTPS")
Rel(Checkout Orchestrator Component, Tax & Compliance Service, "HTTPS / REST API", "HTTPS")
Rel(Checkout Orchestrator Component, Order Persistence Component, "JPA/JDBC over TLS", "TLS")
Rel(Order Management API Component, Order Persistence Component, "JPA/JDBC over TLS", "TLS")
Rel(Checkout Orchestrator Component, Event Publisher Component, "In-process Spring Events", "In-process")
Rel(Order Management API Component, Event Publisher Component, "In-process Spring Events", "In-process")
Rel(Event Publisher Component, AWS EventBridge, "HTTPS / AWS SDK", "HTTPS")

@enduml