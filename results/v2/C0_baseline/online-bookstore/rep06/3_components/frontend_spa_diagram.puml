@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Frontend SPA container

System_Ext(api_gateway, "API Gateway", "AWS API Gateway", "Routes validated API traffic to backend microservices")

Container_Boundary(frontend_spa, "Frontend SPA") {
    Component(catalog_search_ui, "Catalog & Search UI Component", "Next.js, React", "Provides the user interface for browsing books, searching the catalog, and viewing product details.")
    Component(cart_checkout_ui, "Cart & Checkout UI Component", "Next.js, React", "Manages the shopping cart interactions and secure checkout workflows.")
    Component(social_proof_ui, "Social Proof & Recommendation UI Component", "Next.js, React", "Renders user reviews, ratings, and personalized book recommendations.")
    Component(auth_session_handler, "Auth & Session Handler Component", "NextAuth.js, React", "Handles user authentication, session management, and secure cookie handling.")
    Component(localization_consent_manager, "Localization & Consent Manager Component", "React, Polyglot frontend modules", "Manages multi-currency display, regional localization settings, and GDPR/CCPA consent compliance.")
}

Rel(catalog_search_ui, api_gateway, "Sends catalog and search API requests", "HTTPS, REST, GraphQL")
Rel(cart_checkout_ui, api_gateway, "Sends cart and checkout actions", "HTTPS, REST, GraphQL")
Rel(social_proof_ui, api_gateway, "Fetches reviews and recommendation data", "HTTPS, REST, GraphQL")
Rel(auth_session_handler, api_gateway, "Authenticates users and manages sessions", "HTTPS, REST, GraphQL")
Rel(localization_consent_manager, api_gateway, "Synchronizes localization and consent preferences", "HTTPS, REST, GraphQL")

@enduml