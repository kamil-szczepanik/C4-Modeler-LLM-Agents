@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Search Index container

Container_Boundary(search_index, "Search Index") {
    Component(Query_Processor, "Query Processor", "AWS OpenSearch / Lucene Analysis Pipeline", "Handles incoming search requests, typo-tolerance, analysis pipelines, and input sanitization.")
    Component(Indexing_Engine, "Indexing Engine", "AWS OpenSearch Bulk API", "Consumes catalogue mutation events for near-real-time index updates.")
    Component(Cluster_State_Storage, "Cluster State & Storage", "AWS OpenSearch, EBS NVMe, AWS S3", "Manages primary-replica shards, EBS NVMe storage, and backup tiers across availability zones.")
}

Container(Catalog_Search_Service, "Catalog & Search Service", "External Container", "External container generating search queries.")
System_Ext(Event_Bus, "Event Bus", "AWS SQS / EventBridge", "External messaging service delivering catalogue mutation events.")
System_Ext(AWS_S3, "AWS S3", "AWS S3", "Cloud storage for Cross-Region Snapshots.")

Rel(Catalog_Search_Service, Query_Processor, "HTTP/REST", "TLS 1.3, AWS IAM SigV4")
Rel(Event_Bus, Indexing_Engine, "HTTP/REST", "TLS 1.3, AWS IAM SigV4 via OpenSearch Bulk API")
Rel(Cluster_State_Storage, AWS_S3, "HTTPS", "TLS 1.3 for Cross-Region Snapshots")

@enduml