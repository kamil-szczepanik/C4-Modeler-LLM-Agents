@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Event Bus / Messaging container

Person(order_checkout_service, "Order & Checkout Service", "External Service")
Person(catalog_search_service, "Catalog & Search Service", "External Service")
Person(recommendation_service, "Recommendation Service", "External Service")

Container_Boundary(event_bus_messaging, "Event Bus / Messaging") {
    Component(Event_Router, "Event Router", "AWS EventBridge", "Central event bus using JSON-based rules for core event routing and schema validation.")
    Component(Notification_Dispatcher, "Notification Dispatcher", "AWS SNS", "Pub/sub topic for broadcast notifications.")
    Component(Order_Queue, "Order Queue", "AWS SQS", "Durable, at-least-once processing queue with Dead Letter Queues (DLQs).")
    Component(Analytics_Stream, "Analytics Stream", "AWS Kinesis", "High-throughput clickstream and review event ingestion.")
    Component(EventBridge_Schema_Registry, "EventBridge Schema Registry", "AWS EventBridge Schema Registry", "JSON schema validation and contract enforcement.")
}

Rel(order_checkout_service, Event_Router, "Publishes OrderPlaced", "HTTPS / AWS SDK")
Rel(Event_Router, Order_Queue, "Routes OrderPlaced for downstream fulfillment", "AWS Native")
Rel(Event_Router, Notification_Dispatcher, "Broadcasts async triggers for emails", "AWS Native")
Rel(catalog_search_service, Event_Router, "Publishes ItemViewed and ReviewSubmitted", "HTTPS / AWS SDK")
Rel(Event_Router, recommendation_service, "Streams engagement data asynchronously", "AWS SQS / Kinesis")

@enduml