@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "External API Gateway")
System_Ext(event_bus, "Event Bus", "External Event Bus")

Container_Boundary(catalog_search_service, "Catalog & Search Service") {
    Component(Search_Browse_Router, "Search & Browse Router", "Node.js/Go", "Handles gRPC input validation and sanitization.")
    Component(OpenSearch_Query_Builder, "OpenSearch Query Builder", "Node.js/Go", "Translates domain queries into AWS OpenSearch DSL.")
    Component(Ingestion_Indexing_Worker, "Ingestion & Indexing Worker", "Node.js/Go", "Consumes event bus updates for bulk index synchronization.")
    Component(AWS_OpenSearch, "AWS OpenSearch", "AWS OpenSearch", "Managed search index storing denormalized documents with localized pricing.")
    Component(AWS_RDS_PostgreSQL, "AWS RDS PostgreSQL", "AWS RDS PostgreSQL", "Primary relational database for catalogue persistence.")
    Component(AWS_EventBridge_SQS, "AWS EventBridge / SQS", "AWS EventBridge / SQS", "Messaging infrastructure with Dead Letter Queues for sync events.")
    Component(AWS_Secrets_Manager, "AWS Secrets Manager", "AWS Secrets Manager", "Secure injection of database and search credentials.")
}

Rel(api_gateway, Search_Browse_Router, "Routes catalogue queries via gRPC over HTTP/2 with mTLS.", "gRPC/HTTP/2")
Rel(Search_Browse_Router, OpenSearch_Query_Builder, "Delegates parsed queries via in-memory function calls.", "In-Memory")
Rel(OpenSearch_Query_Builder, AWS_OpenSearch, "Executes search queries via HTTPS/TCP.", "HTTPS/TCP")
Rel(Ingestion_Indexing_Worker, AWS_OpenSearch, "Bulk updates index documents via HTTPS/TCP.", "HTTPS/TCP")
Rel(event_bus, Ingestion_Indexing_Worker, "Consumes catalogue change events via HTTPS.", "HTTPS")

@enduml