@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "External API Gateway")

Container_Boundary(recommendation_service, "Recommendation Service") {
    Component(api_router, "API Router", "FastAPI", "Routes incoming gRPC over HTTP/2 requests with mTLS.")
    Component(recommendation_engine, "Recommendation Engine", "Python, PyTorch/Scikit-learn runtime", "Executes collaborative filtering and recommendation models.")
    Component(feature_store_client, "Feature Store Client", "Python", "Interacts with feature stores for model inputs.")
    Component(cache_manager, "Cache Manager", "Python", "Manages data retrieval and caching.")
    Component(experimentation_telemetry_client, "Experimentation & Telemetry Client", "Python", "Publishes pseudonymized interaction events asynchronously.")
    Component(aws_elasticache_redis, "AWS ElastiCache (Redis)", "Redis", "Caches recommendation outputs and user context for sub-200ms response times.")
    Component(aws_rds_postgresql, "AWS RDS PostgreSQL", "PostgreSQL", "Stores historical purchase graphs.")
    Component(aws_eventbridge_sqs, "AWS EventBridge / SQS", "AWS EventBridge / SQS", "Handles asynchronous event publishing.")
}

Rel(api_gateway, api_router, "Routes gRPC over HTTP/2 requests with mTLS", "gRPC / HTTP/2")
Rel(cache_manager, aws_elasticache_redis, "Retrieves cached recommendation data via Encrypted TCP", "Encrypted TCP")
Rel(recommendation_engine, aws_rds_postgresql, "Reads historical purchase graphs via SQL over TLS", "SQL over TLS")
Rel(experimentation_telemetry_client, aws_eventbridge_sqs, "Publishes pseudonymized interaction events asynchronously", "Async Events")

@enduml