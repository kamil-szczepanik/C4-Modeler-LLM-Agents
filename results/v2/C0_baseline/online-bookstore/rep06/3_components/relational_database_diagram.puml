@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(relational_database, "Relational Database") {
    Component(PgBouncer_Connection_Pooler, "PgBouncer Connection Pooler", "PgBouncer", "Handles and optimizes database connection pooling to support high scaling requirements.")
    Component(PostgreSQL_Primary_Instance, "PostgreSQL Primary Instance", "AWS RDS PostgreSQL (Multi-AZ)", "Manages ACID-compliant persistent queries and transactions for financial orders and multi-currency data.")
    Component(PostgreSQL_Read_Replicas, "PostgreSQL Read Replicas", "AWS RDS PostgreSQL Read Replicas", "Provides scalable read operations to guarantee high availability and performance.")
}

Rel(PgBouncer_Connection_Pooler, PostgreSQL_Primary_Instance, "Routes pooled write and transaction traffic", "TCP/TLS 1.3")
Rel(PgBouncer_Connection_Pooler, PostgreSQL_Read_Replicas, "Routes pooled read traffic", "TCP/TLS 1.3")

@enduml