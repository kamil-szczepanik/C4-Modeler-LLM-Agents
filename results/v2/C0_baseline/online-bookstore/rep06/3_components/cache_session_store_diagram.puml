@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Cache & Session Store container

Container_Ext(api_gateway, "API Gateway", "AWS API Gateway", "Routes and manages incoming API requests.")
Container_Ext(order_checkout_service, "Order & Checkout Service", "ECS Fargate, Java/Spring Boot", "Handles order placement and checkout flows.")
Container_Ext(catalog_search_service, "Catalog & Search Service", "ECS Fargate, Node.js/Go", "Manages product catalog and search functionality.")
Container_Ext(pricing_localization_service, "Pricing & Localization Service", "ECS Fargate, Polyglot backend", "Manages pricing, currency conversion, and localization.")

Container_Boundary(cache_session_store, "Cache & Session Store") {
    Component(session_manager_component, "Session Manager Component", "AWS ElastiCache (Redis)", "Manages user sessions and authentication states.")
    Component(catalog_pricing_cache_component, "Catalog & Pricing Cache Component", "AWS ElastiCache (Redis)", "Caches product details and pricing information for fast retrieval.")
    Component(rate_limiter_throttle_component, "Rate Limiter & Throttle Component", "AWS ElastiCache (Redis)", "Tracks and enforces rate limits and request throttling.")
}

Rel(order_checkout_service, session_manager_component, "Encrypted TCP via Redis Protocol")
Rel(catalog_search_service, catalog_pricing_cache_component, "Read/Write product details", "Encrypted TCP via Redis Protocol")
Rel(pricing_localization_service, catalog_pricing_cache_component, "Read exchange rates", "Encrypted TCP")
Rel(api_gateway, rate_limiter_throttle_component, "Check rate limits", "Encrypted TCP")
@enduml