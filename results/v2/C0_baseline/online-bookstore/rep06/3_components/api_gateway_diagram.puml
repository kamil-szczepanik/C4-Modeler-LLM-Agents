@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(edge_router, "Edge Router & WAF Integration", "AWS WAF & CloudFront", "Enforces OWASP Top-10 mitigations, SSL termination, and schema validation.")
    Component(auth_filter, "Authentication & Authorization Filter", "AWS API Gateway", "Validates incoming tokens and secures client interactions.")
    Component(rate_limiter, "Rate Limiting & Throttling Engine", "AWS API Gateway / ElastiCache (Redis)", "Manages traffic rates and synchronizes distributed rate limits.")
    Component(routing_proxy, "Service-Discovery & Routing Proxy", "AWS API Gateway / ECS Fargate", "Routes internal traffic to downstream microservices.")
}

System_Ext(elasticache, "AWS ElastiCache (Redis)", "Powers distributed rate limiting and JWT revocation lookups.")

Rel(edge_router, auth_filter, "Forwards incoming HTTPS/REST/GraphQL requests", "HTTPS/REST/GraphQL")
Rel(auth_filter, rate_limiter, "Passes requests through in-memory pipeline", "In-memory")
Rel(rate_limiter, routing_proxy, "Passes verified and throttled requests for internal routing", "Internal")
Rel(auth_filter, elasticache, "Validates token blacklists", "TCP")
Rel(rate_limiter, elasticache, "Synchronizes distributed rate limits", "TCP")

@enduml