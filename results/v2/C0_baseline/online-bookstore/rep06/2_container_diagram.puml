@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore Web/Mobile Application

Person(BookBuyers, "Book Buyers", "End users who purchase physical and electronic books, read reviews, and receive personalized recommendations.")
Person(RegisteredReviewers, "Registered Reviewers", "Users who leave reviews and interact with the book catalog.")
Person(StoreAdministrators, "Store Administrators", "Administrators who manage the bookstore system.")

System_Ext(PaymentGateway, "Payment Gateway", "External payment processing service.")
System_Ext(ShippingAPIs, "Shipping APIs", "External fulfillment and delivery partners.")
System_Ext(TaxComplianceService, "Tax & Compliance Service", "Services for tax and compliance management.")
System_Ext(IdentityProvider, "Identity Provider", "Managed identity and authentication service.")

System_Boundary(OnlineBookstore, "Online Bookstore Web/Mobile Application") {
    Container(FrontendSPA, "Frontend SPA", "React, Next.js, AWS S3, CloudFront CDN", "High-performance single-page application delivering catalogue browsing, reviews, and secure checkout UI.")
    Container(APIGateway, "API Gateway", "AWS API Gateway", "Handles routing, rate-limiting, and JWT validation.")
    Container(CatalogSearchService, "Catalog & Search Service", "ECS Fargate, Node.js/Go", "Manages book catalogue and high-speed search operations.")
    Container(OrderCheckoutService, "Order & Checkout Service", "ECS Fargate, Java/Spring Boot", "Handles ACID-compliant order processing and secure checkout.")
    Container(RecommendationService, "Recommendation Service", "ECS Fargate, Python/FastAPI", "Generates personalized user recommendations.")
    Container(PricingLocalizationService, "Pricing & Localization Service", "ECS Fargate, Polyglot backend", "Manages multi-region pricing and localization.")
    
    ContainerDb(RelationalDatabase, "Relational Database", "AWS RDS PostgreSQL", "ACID-compliant relational storage with strict isolation for GDPR/CCPA.")
    ContainerDb(SearchIndex, "Search Index", "AWS OpenSearch", "High-speed catalogue search engine.")
    ContainerDb(CacheSessionStore, "Cache & Session Store", "AWS ElastiCache (Redis)", "High-speed session and rate caching.")
    Container(EventBusMessaging, "Event Bus / Messaging", "AWS EventBridge, SNS, SQS", "Event-driven messaging backbone for asynchronous operations.")
}

Rel(BookBuyers, FrontendSPA, "Interacts with the online bookstore via browser/client", "HTTPS, REST, GraphQL")
Rel(RegisteredReviewers, FrontendSPA, "Browses catalogue and writes reviews", "HTTPS, REST, GraphQL")
Rel(StoreAdministrators, FrontendSPA, "Manages store settings and administration", "HTTPS, REST, GraphQL")

Rel(FrontendSPA, APIGateway, "Sends API requests for catalogue, checkout, and user actions", "HTTPS, REST, GraphQL")

Rel(APIGateway, CatalogSearchService, "Routes catalogue and search queries", "gRPC over HTTP/2, mTLS")
Rel(APIGateway, OrderCheckoutService, "Routes checkout and order actions", "gRPC over HTTP/2, mTLS")
Rel(APIGateway, RecommendationService, "Routes recommendation requests", "gRPC over HTTP/2, mTLS")
Rel(APIGateway, PricingLocalizationService, "Routes pricing and localization requests", "gRPC over HTTP/2, mTLS")
Rel(APIGateway, IdentityProvider, "Validates JWT tokens and authenticates users", "HTTPS / OIDC / OAuth2")

Rel(CatalogSearchService, RelationalDatabase, "Reads and writes catalogue relational data", "TCP/TLS")
Rel(CatalogSearchService, SearchIndex, "Queries search index", "TCP/TLS")
Rel(CatalogSearchService, EventBusMessaging, "Publishes catalogue update events", "HTTPS")

Rel(OrderCheckoutService, RelationalDatabase, "Persists transactional order data", "TCP/TLS")
Rel(OrderCheckoutService, CacheSessionStore, "Manages sessions and rate limits", "Encrypted TCP")
Rel(OrderCheckoutService, EventBusMessaging, "Publishes order and checkout events", "HTTPS")
Rel(OrderCheckoutService, PaymentGateway, "Processes secure payments", "HTTPS / REST API")
Rel(OrderCheckoutService, ShippingAPIs, "Dispatches shipping orders", "HTTPS / REST API")
Rel(OrderCheckoutService, TaxComplianceService, "Calculates taxes and compliance rules", "HTTPS / REST API")

Rel(RecommendationService, CacheSessionStore, "Retrieves cached recommendation data", "Encrypted TCP")

Rel(PricingLocalizationService, RelationalDatabase, "Queries pricing and localization records", "TCP/TLS")

@enduml