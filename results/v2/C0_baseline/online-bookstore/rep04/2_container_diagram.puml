@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore System

Person(BookBuyer, "Book Buyer", "End-user interacting via Web/Mobile clients to browse, purchase, and review books.")
Person(RegisteredReviewer, "Registered Reviewer", "User contributing reviews and 5-star ratings.")
Person(StoreAdministrator, "Store Administrator", "Manages catalog integrity, pricing, and content moderation.")

System_Ext(StripePayPal, "Stripe/PayPal", "External payment gateway for secure checkout and PCI-DSS offloading.")
System_Ext(FedExUPS, "FedEx/UPS", "External shipping APIs for rate calculation and fulfillment.")
System_Ext(Auth0Cognito, "Auth0/Cognito", "External Identity Provider handling authentication, MFA, and GDPR consent.")
System_Ext(AWSSES, "AWS SES", "External notification service for transactional emails.")
System_Ext(CurrencyExchangeRateService, "Currency Exchange Rate Service", "External provider for daily multi-currency conversion rates.")

System_Boundary(OnlineBookstoreSystem, "Online Bookstore System") {
    Container(ReactTypeScriptSPA, "React / TypeScript SPA", "React, TypeScript, AWS S3, AWS CloudFront", "Single Page Application hosted on AWS S3 & CloudFront for fast, responsive client-side rendering.")
    Container(AWSApiGateway, "AWS API Gateway", "AWS API Gateway", "API & Routing Container handling requests from the frontend.")
    Container(OrderCheckoutService, "Order & Checkout Service", "Node.js", "Backend service managing orders and checkout processes.")
    Container(CatalogSearchService, "Catalog & Search Service", "Java Spring Boot, Elasticsearch", "Backend service handling rapid keyword queries and catalog management.")
    Container(RecommendationsService, "Recommendations Service", "Python FastAPI", "Backend service providing personalized book recommendations.")
    Container(ReviewService, "Review Service", "Node.js", "Backend service managing user reviews and ratings.")
    ContainerDb(AmazonRDSPostgreSQL, "Amazon RDS PostgreSQL", "Amazon RDS PostgreSQL", "Relational database for structured data storage with multi-region durability.")
    ContainerDb(AmazonDynamoDB, "Amazon DynamoDB", "Amazon DynamoDB", "NoSQL database with Global Tables for multi-region durability.")
    ContainerDb(AmazonElastiCacheRedis, "Amazon ElastiCache (Redis)", "Amazon ElastiCache (Redis)", "Caching layer for sub-millisecond cart persistence.")
    Container(AWSEventBridge, "AWS EventBridge", "AWS EventBridge", "Event bus for asynchronous event-driven communication between microservices.")
}

Rel(BookBuyer, ReactTypeScriptSPA, "Browses books, manages cart, and initiates checkout", "HTTPS")
Rel(RegisteredReviewer, ReactTypeScriptSPA, "Submits reviews and ratings", "HTTPS")
Rel(StoreAdministrator, ReactTypeScriptSPA, "Manages catalog, pricing, and content moderation", "HTTPS")

Rel(ReactTypeScriptSPA, AWSApiGateway, "Sends API requests", "HTTPS / JSON")

Rel(AWSApiGateway, OrderCheckoutService, "Routes checkout and order requests", "mTLS / REST and gRPC")
Rel(AWSApiGateway, CatalogSearchService, "Routes catalog and search queries", "mTLS / REST and gRPC")
Rel(AWSApiGateway, RecommendationsService, "Routes recommendation requests", "mTLS / REST and gRPC")
Rel(AWSApiGateway, ReviewService, "Routes review-related requests", "mTLS / REST and gRPC")

Rel(OrderCheckoutService, StripePayPal, "Processes payments", "HTTPS / REST")
Rel(OrderCheckoutService, FedExUPS, "Calculates shipping rates and fulfillment", "HTTPS / REST")

Rel(OrderCheckoutService, AWSEventBridge, "Publishes order events asynchronously", "Asynchronous event publishing")
Rel(CatalogSearchService, AWSEventBridge, "Publishes catalog events asynchronously", "Asynchronous event publishing")
Rel(RecommendationsService, AWSEventBridge, "Publishes recommendation events asynchronously", "Asynchronous event publishing")
Rel(ReviewService, AWSEventBridge, "Publishes review events asynchronously", "Asynchronous event publishing")

Rel(OrderCheckoutService, AmazonRDSPostgreSQL, "Reads and writes relational data", "Encrypted TCP")
Rel(CatalogSearchService, AmazonRDSPostgreSQL, "Reads and writes catalog data", "Encrypted TCP")
Rel(OrderCheckoutService, AmazonDynamoDB, "Reads and writes NoSQL data", "Encrypted TCP")
Rel(OrderCheckoutService, AmazonElastiCacheRedis, "Persists cart data and caches information", "Encrypted TCP")
Rel(CatalogSearchService, AmazonElastiCacheRedis, "Caches search and catalog data", "Encrypted TCP")

@enduml