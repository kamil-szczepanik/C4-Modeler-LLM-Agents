@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Order & Checkout Service container

Container_Boundary(order_checkout_service, "Order & Checkout Service") {
    Component(CartControllerManager, "Cart Controller & Manager", "Node.js, Express, Redis", "Handling cart lifecycle and Redis persistence.")
    Component(CheckoutOrchestrator, "Checkout Orchestrator", "Node.js", "Manages transactions, idempotency, data masking, and orchestration.")
    Component(PaymentFulfillmentClient, "Payment & Fulfillment Client", "Node.js, Stripe, PayPal, FedEx, UPS, Circuit Breakers", "Integrates with payment gateways and shipping providers using circuit breakers.")
    Component(OrderEventPublisher, "Order Event Publisher", "Node.js, AWS SDK", "Emits domain events to the event bus.")
    Component(NotificationAdapter, "Notification Adapter", "Node.js", "Triggers notifications for order lifecycle events.")
    Component(AmazonRDSPostgreSQL, "Amazon RDS PostgreSQL", "PostgreSQL, PgBouncer, gRPC/TLS 1.3", "Persists transactional state with ACID compliance.")
    Component(AmazonElastiCacheRedis, "Amazon ElastiCache (Redis)", "Redis, Encrypted TCP", "Caches cart data with low latency.")
    Component(AWSEventBridge, "AWS EventBridge", "AWS EventBridge, JSON over HTTPS", "Enables asynchronous, decoupled event-driven workflows and notifications.")
}

Rel(CheckoutOrchestrator, CartControllerManager, "Manages cart lifecycle", "In-memory function call")
Rel(CheckoutOrchestrator, PaymentFulfillmentClient, "Executes transactions", "Async/Await REST via HTTPS")
Rel(PaymentFulfillmentClient, StripePayPal, "Processes payments", "HTTPS / REST with TLS 1.3")
Rel(PaymentFulfillmentClient, FedExUPS, "Calculates shipping", "HTTPS / REST with TLS 1.3")
Rel(CheckoutOrchestrator, AmazonRDSPostgreSQL, "Persists transactional state", "Encrypted TCP with gRPC/TLS 1.3 and PgBouncer")
Rel(CartControllerManager, AmazonElastiCacheRedis, "Caches cart data", "Encrypted TCP")
Rel(OrderEventPublisher, AWSEventBridge, "Publishes domain events", "JSON over AWS SDK / HTTPS")

@enduml