@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_rds_postgresql, "Amazon RDS PostgreSQL") {
    Component(PostgreSQL_Relational_Engine, "PostgreSQL Relational Engine", "PostgreSQL Relational Engine (v15+)", "Provides ACID-compliant transactional storage for orders and payments.")
    Component(PgBouncer_Connection_Pooler, "PgBouncer Connection Pooler", "PgBouncer", "Manages connection pooling to prevent exhaustion under high traffic.")
    Component(AWS_Backup___PITR_Manager, "AWS Backup & PITR Manager", "AWS Backup & PITR Manager", "Synchronizes encrypted snapshots across regions using AWS internal backbone and KMS.")
    Component(Cross_Region_Read_Replicas, "Cross-Region Read Replicas", "PostgreSQL Read Replica", "Provides read-only replicas across regions for performance and high availability.")
    Component(PostgreSQL_Row_Level_Security__RLS__Policies, "PostgreSQL Row-Level Security (RLS) Policies", "PostgreSQL RLS", "Enforces fine-grained access control for data residency and compliance.")
    Component(pgaudit_Extension, "pgaudit Extension", "pgaudit", "Provides detailed audit logging for security and compliance.")
}

Rel(PgBouncer_Connection_Pooler, PostgreSQL_Relational_Engine, "Multiplexed backend connections", "TCP, UNIX domain socket")
Rel(AWS_Backup___PITR_Manager, Cross_Region_Read_Replicas, "Synchronizes encrypted snapshots", "AWS internal backbone, KMS")
@enduml