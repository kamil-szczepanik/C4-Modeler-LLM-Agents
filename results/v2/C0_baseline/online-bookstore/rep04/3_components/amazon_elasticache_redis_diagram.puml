@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon ElastiCache (Redis) container

System_Ext(Order_Checkout_Service, "Order & Checkout Service", "Node.js", "Persists cart data via Encrypted TCP with strict Redis ACLs.")
System_Ext(Catalog_Search_Service, "Catalog & Search Service", "Java Spring Boot, Elasticsearch", "Caches search and catalog data via Encrypted TCP.")
System_Ext(Recommendations_Service, "Recommendations Service", "Python FastAPI", "Reads and writes pre-computed recommendations via Encrypted TCP.")
System_Ext(AWS_EventBridge, "AWS EventBridge", "AWS EventBridge", "Triggers cache eviction via Redis PUBLISH.")

Container_Boundary(Amazon_ElastiCache_Redis, "Amazon ElastiCache (Redis)") {
    Component(Session_Cart_Engine, "Session & Cart Engine", "In-memory Hashes/Strings (Redis)", "Ensures sub-millisecond cart persistence and active user shopping cart management.")
    Component(Catalog_Query_Cache, "Catalog Query Cache", "String/JSON cache with TTL (Redis)", "Caches search and catalog data as well as pre-computed recommendations.")
    Component(PubSub_Notification_Manager, "Pub/Sub Notification Manager", "Redis Pub/Sub", "Manages cache eviction and invalidation triggered by external events.")
}

Rel(Order_Checkout_Service, Session_Cart_Engine, "Persists cart data via Encrypted TCP (RESP over TLS) with strict Redis ACLs", "Encrypted TCP")
Rel(Catalog_Search_Service, Catalog_Query_Cache, "Caches search and catalog data via Encrypted TCP", "Encrypted TCP")
Rel(Recommendations_Service, Catalog_Query_Cache, "Reads/writes pre-computed recommendations via Encrypted TCP (RESP over TLS)", "Encrypted TCP")
Rel(AWS_EventBridge, PubSub_Notification_Manager, "Triggers cache eviction via Redis PUBLISH", "Redis PUBLISH")

@enduml