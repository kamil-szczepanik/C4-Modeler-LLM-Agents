@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(spa_boundary, "React / TypeScript SPA") {
    Component(Routing_Layout_Component, "Routing & Layout Component", "React Router", "Handles client-side routing and application layout structure.")
    Component(Catalog_Search_Feature_Module, "Catalog & Search Feature Module", "React, Zustand", "Manages book catalog browsing, filtering, and search functionality.")
    Component(Cart_Checkout_Feature_Module, "Cart & Checkout Feature Module", "React, React Hook Form", "Manages shopping cart state, user forms, and checkout processing.")
    Component(Social_Proof_Recommendations_Module, "Social Proof & Recommendations Module", "React Query", "Fetches and caches product recommendations and social proof data.")
    Component(Admin_Management_Module, "Admin Management Module", "React, Lazy-Loaded", "Provides administrative management tools and is lazily loaded.")
    Component(API_Client_Wrapper, "API Client Wrapper", "Axios", "Handles HTTP communication, interceptors, and secure API requests.")
}

Rel(Catalog_Search_Feature_Module, API_Client_Wrapper, "Invokes", "TypeScript / Function Calls")
Rel(Cart_Checkout_Feature_Module, API_Client_Wrapper, "Invokes", "TypeScript / Function Calls")
Rel(Social_Proof_Recommendations_Module, API_Client_Wrapper, "Invokes", "TypeScript / Function Calls")
Rel(Admin_Management_Module, API_Client_Wrapper, "Invokes", "TypeScript / Function Calls")

@enduml