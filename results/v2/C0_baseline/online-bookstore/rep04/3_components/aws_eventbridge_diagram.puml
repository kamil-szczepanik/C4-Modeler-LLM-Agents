@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS EventBridge container

Container_Boundary(aws_eventbridge, "AWS EventBridge") {
    Component(CustomEventBuses, "Custom Event Buses", "AWS EventBridge Custom Buses", "Domain-isolated event buses preventing cascading failures for decoupled microservice communication.")
    Component(EventRules, "Event Rules", "AWS EventBridge Rules", "Internal event routing rules to match and direct events to appropriate targets.")
    Component(TargetDispatchers, "Target Dispatchers", "AWS Lambda / EventBridge Targets", "Dispatchers responsible for forwarding routed events to downstream buffers and queues.")
}

Rel(CustomEventBuses, EventRules, "Routes published events based on defined rule patterns", "")
Rel(EventRules, TargetDispatchers, "Triggers dispatchers to forward matched events", "")

@enduml