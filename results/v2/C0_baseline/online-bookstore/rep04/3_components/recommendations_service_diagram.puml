@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(BookBuyer, "Book Buyer", "Primary end-user consuming personalized recommendations.")
System_Ext(AWSAPIGateway, "AWS API Gateway", "Routes incoming recommendation requests.")
System_Ext(AmazonDynamoDB, "Amazon DynamoDB", "NoSQL database for low-latency, high-throughput retrieval.")
System_Ext(AmazonElastiCacheRedis, "Amazon ElastiCache (Redis)", "Caching hot recommendation items.")
System_Ext(AWSEventBridge, "AWS EventBridge", "Decoupled, asynchronous event ingestion and telemetry publishing.")

Container_Boundary(RecommendationsService, "Recommendations Service") {
    Component(APIControllerComponent, "API Controller Component", "Python FastAPI Router", "Handling incoming REST/gRPC traffic.")
    Component(ExperimentationVariantRouterComponent, "Experimentation & Variant Router Component", "Python", "Manages A/B testing and algorithm variants.")
    Component(RecommendationEngineComponent, "Recommendation Engine Component", "Python", "Executes collaborative filtering and item-to-item similarity logic.")
    Component(EventIngestionConsumerComponent, "Event Ingestion Consumer Component", "Python", "Subscribes to events for dynamic updates.")
    Component(TelemetryPublisherComponent, "Telemetry Publisher Component", "Python", "Emits impression and click-through metrics.")
}

Rel(BookBuyer, AWSAPIGateway, "Requests personalized recommendations")
Rel(AWSAPIGateway, APIControllerComponent, "Routes incoming recommendation requests", "mTLS / REST and gRPC")
Rel(APIControllerComponent, ExperimentationVariantRouterComponent, "Delegates user context", "Internal Python method calls")
Rel(ExperimentationVariantRouterComponent, RecommendationEngineComponent, "Routes requests to specific algorithm handlers", "Python")
Rel(RecommendationEngineComponent, AmazonDynamoDB, "Reads cached recommendations", "HTTPS / TCP, Sub-10ms query latency")
Rel(RecommendationEngineComponent, AmazonElastiCacheRedis, "Reads cached recommendations", "HTTPS / TCP, Sub-10ms query latency")
Rel(AWSEventBridge, EventIngestionConsumerComponent, "Publishes asynchronous clickstream and order events", "Asynchronous event subscription")
Rel(TelemetryPublisherComponent, AWSEventBridge, "Publishes sanitized impression and click metrics", "Asynchronous event publishing")

@enduml