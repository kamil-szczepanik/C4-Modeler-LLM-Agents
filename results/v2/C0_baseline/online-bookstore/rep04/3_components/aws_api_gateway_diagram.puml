@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_api_gateway, "AWS API Gateway") {
    Component(Edge Request Router, "Edge Request Router", "AWS API Gateway HTTP/REST APIs", "Manages geo-routing, rate limiting, and HTTP/REST traffic.")
    Component(Security & Validation Filter, "Security & Validation Filter", "AWS WAF", "Mitigates OWASP Top-10 vulnerabilities and provides DDoS protection.")
    Component(Token Authorizer, "Token Authorizer", "AWS Lambda Authorizer with Auth0/AWS Cognito", "Executes lightweight JWT token authorization.")
    Component(API Response Cache, "API Response Cache", "API Gateway Managed Cache", "Caches API responses to ensure fast page loads.")
    Component(Telemetry & Metering Filter, "Telemetry & Metering Filter", "Amazon CloudWatch & AWS X-Ray", "Handles distributed tracing, telemetry, and metrics monitoring.")
}

Rel(Security & Validation Filter, Edge Request Router, "Internal Routing", "")
Rel(Edge Request Router, Token Authorizer, "gRPC / Lambda Invocation", "")
Rel(Edge Request Router, API Response Cache, "Internal Cache Read/Write", "")
Rel(Edge Request Router, Telemetry & Metering Filter, "Async / CloudWatch API", "")
@enduml