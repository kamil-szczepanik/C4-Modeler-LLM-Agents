@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Review Service", "Review Service") {
    Component("Review Controller", "Review Controller", "Express.js", "Handles incoming HTTP requests related to reviews via REST and gRPC.")
    Component("Review Business Logic Component", "Review Business Logic Component", "Node.js", "Contains core business logic for processing and validating reviews.")
    Component("Data Access Layer & ElastiCache Read-Aside", "Data Access Layer & ElastiCache Read-Aside", "Prisma ORM + Redis", "Manages persistence in PostgreSQL and caches rating summaries using Redis.")
    Component("Event Publisher Component", "Event Publisher Component", "AWS SDK v3", "Publishes asynchronous events like ReviewCreated and GDPR anonymization to AWS EventBridge.")
}

Rel("Review Controller", "Review Business Logic Component", "Delegates request processing")
Rel("Review Business Logic Component", "Data Access Layer & ElastiCache Read-Aside", "Queries and persists data")
Rel("Review Business Logic Component", "Event Publisher Component", "Triggers domain events")

@enduml