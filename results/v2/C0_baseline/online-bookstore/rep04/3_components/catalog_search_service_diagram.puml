@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog & Search Service container

Container_Boundary(catalog_search_service, "Catalog & Search Service") {
    Component(SearchController, "Search Controller & Faceted Query Engine", "Java Spring Boot", "Handles faceted search and catalog queries, communicating with Elasticsearch.")
    Component(CatalogManagement, "Catalog Management Component", "Java Spring Boot", "Manages catalog state and persists data to Amazon RDS PostgreSQL.")
    Component(EventPublisher, "Event Publisher Component", "Java Spring Boot", "Publishes ProductUpdated and StockChanged events to AWS EventBridge.")
    Component(CacheAsideManager, "Cache-Aside Manager", "Java Spring Boot / Redis", "Manages query TTLs and caching via Amazon ElastiCache.")
    Component(LocalizationResolver, "Localization & Currency Resolver Component", "Java Spring Boot", "Resolves localization and currency data.")
    Component(BulkIndexSync, "Bulk Index Synchronization Component", "Java Spring Boot", "Reads bulk catalog updates from PostgreSQL Read Replicas and bulk upserts to Elasticsearch.")
}

System_Ext(Elasticsearch, "Elasticsearch", "High-performance keyword and faceted search engine.")
System_Ext(PostgreSQL, "Amazon RDS PostgreSQL", "Authoritative relational data store.")
System_Ext(Redis, "Amazon ElastiCache (Redis)", "Caches search results and powers distributed rate limiting.")
System_Ext(EventBridge, "AWS EventBridge", "Handles asynchronous event publishing.")
System_Ext(PostgreSQLReadReplicas, "Amazon RDS PostgreSQL Read Replicas", "Read replicas for scaling relational reads.")

Rel(SearchController, Elasticsearch, "Executes DSL queries", "Transport over TCP")
Rel(CatalogManagement, PostgreSQL, "Persists catalog state", "JDBC / Encrypted TCP")
Rel(CacheAsideManager, Redis, "Manages query TTLs", "RESP over TCP")
Rel(EventPublisher, EventBridge, "Publishes ProductUpdated and StockChanged events", "Asynchronous event publishing")
Rel(BulkIndexSync, PostgreSQLReadReplicas, "Reads bulk catalog updates", "JDBC / Encrypted TCP")
Rel(BulkIndexSync, Elasticsearch, "Bulk upserts documents", "REST/HTTPs")

@enduml