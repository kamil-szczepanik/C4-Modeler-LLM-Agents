@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container(OrderCheckoutService, "Order & Checkout Service", "Node.js container", "Executes order processing and checkout flows.")

System_Boundary(AmazonDynamoDB, "Amazon DynamoDB") {
    Component(RequestRouterRequestCoordinator, "Request Router / Request Coordinator", "Component", "Routes operations using AWS internal protocols.")
    Component(StorageNodesPartitionEngine, "Storage Nodes / Partition Engine", "Component", "Manages data storage and partitions.")
    Component(ReplicationManagerGlobalTablesEngine, "Replication Manager / Global Tables Engine", "Component", "Synchronizes cross-region data via AWS internal private backbone network.")
}

System_Ext(GlobalTables, "Global Tables", "External Global Tables")

Rel(OrderCheckoutService, RequestRouterRequestCoordinator, "Executes low-latency queries and atomic transactions", "AWS SDK / HTTPS with SigV4 Auth")
Rel(RequestRouterRequestCoordinator, StorageNodesPartitionEngine, "Routes operations", "AWS internal protocols")
Rel(ReplicationManagerGlobalTablesEngine, GlobalTables, "Synchronizes cross-region data", "AWS internal private backbone network")

@enduml