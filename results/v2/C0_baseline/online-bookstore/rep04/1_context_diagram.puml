@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(BookBuyerCustomer, "Book Buyer / Customer", "End-user interacting via Web/Mobile clients over HTTPS to browse and purchase books.")
Person(RegisteredReviewer, "Registered Reviewer", "User contributing reviews and 5-star ratings.")
Person(StoreAdministratorContentManager, "Store Administrator / Content Manager", "Manages catalog integrity, pricing, and content moderation.")

System(OnlineBookstoreSystem, "Online Bookstore System", "An Amazon-style global online bookstore system providing catalog browsing, secure checkout, reviews, and personalized recommendations with GDPR/CCPA compliance.")

System_Ext(StripePayPal, "Stripe / PayPal", "External payment gateway for secure checkout and PCI-DSS offloading.")
System_Ext(FedExUPS, "FedEx / UPS", "External shipping APIs for rate calculation and fulfillment.")
System_Ext(Auth0AWSCognito, "Auth0 / AWS Cognito", "External Identity Provider handling authentication, MFA, and GDPR consent.")
System_Ext(AWSSES, "AWS SES", "External notification service for transactional emails.")
System_Ext(CurrencyExchangeRateService, "Currency Exchange Rate Service", "External provider for daily multi-currency conversion rates.")

Rel(BookBuyerCustomer, OnlineBookstoreSystem, "Interacts via Web/Mobile clients for catalog browsing, checkout, and reviews", "HTTPS, TLS 1.3, AWS Route 53 Geo-DNS")
Rel(RegisteredReviewer, OnlineBookstoreSystem, "Contributes reviews and ratings", "HTTPS")
Rel(StoreAdministratorContentManager, OnlineBookstoreSystem, "Manages catalog, pricing, and moderation", "HTTPS")

Rel(OnlineBookstoreSystem, StripePayPal, "Secure payment processing", "REST/HTTPS")
Rel(OnlineBookstoreSystem, FedExUPS, "Rate calculation and fulfillment", "REST/HTTPS with circuit breakers")
Rel(OnlineBookstoreSystem, Auth0AWSCognito, "Identity management, authentication, and MFA", "Scoped OAuth2/JWT tokens and mTLS")
Rel(OnlineBookstoreSystem, AWSSES, "Sends transactional emails", "HTTPS/SMTP")
Rel(OnlineBookstoreSystem, CurrencyExchangeRateService, "Retrieves daily multi-currency conversion rates", "REST/HTTPS with Redis caching")

@enduml