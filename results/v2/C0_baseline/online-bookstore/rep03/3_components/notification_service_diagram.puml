@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification Service container

System_Ext(AmazonSQS, "Amazon SQS", "External messaging queue")
System_Ext(SendGridTwilio, "SendGrid/Twilio", "External communication providers")
System_Ext(SegmentSnowflake, "Segment/Snowflake", "External analytics and data platforms")

Container_Boundary(notification_service, "Notification Service") {
    Component(EventConsumerComponent, "Event Consumer Component", "Node.js with AWS SQS SDK", "Consumes asynchronous notification events.")
    Component(PreferenceEngineComponent, "Preference Engine Component", "Node.js with Memory Cache and Amazon Aurora PostgreSQL", "Evaluates user consent and communication settings.")
    Component(DispatcherRouterComponent, "Dispatcher Router Component", "Node.js", "Routes allowed messages.")
    Component(TemplateEngineComponent, "Template Engine Component", "Node.js with Handlebars and MJML", "Renders localized message templates.")
    Component(ProviderIntegrationAdapters, "Provider Integration Adapters", "Node.js with Axios", "Sends formatted payloads to external providers.")
    Component(WebhookReceiverComponent, "Webhook Receiver Component", "Node.js with Express and Amazon ElastiCache Redis", "Receives delivery status and engagement webhooks.")
}

Rel(AmazonSQS, EventConsumerComponent, "Consumes asynchronous notification events", "AMQP / Event Stream")
Rel(EventConsumerComponent, PreferenceEngineComponent, "Evaluates user consent and communication settings", "In-memory call")
Rel(PreferenceEngineComponent, DispatcherRouterComponent, "Routes allowed messages", "In-memory call")
Rel(DispatcherRouterComponent, TemplateEngineComponent, "Renders localized message templates", "In-memory call")
Rel(TemplateEngineComponent, ProviderIntegrationAdapters, "Sends formatted payloads", "In-memory call")
Rel(ProviderIntegrationAdapters, SendGridTwilio, "Dispatches emails and SMS", "REST / HTTPS")
Rel(SendGridTwilio, WebhookReceiverComponent, "Sends delivery status and engagement webhooks", "REST / HTTPS via Amazon API Gateway")
Rel(WebhookReceiverComponent, SegmentSnowflake, "Streams engagement analytics", "SDK / HTTPS")

@enduml