@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon ElastiCache (Redis) container

Container_Boundary(elasticache_redis, "Amazon ElastiCache (Redis)") {
    Component(InMemoryDataStoreEngine, "In-Memory Data Store Engine", "Redis OSS / Valkey", "Executes high-throughput key-value operations and data structures for session management, fast catalog caching, shopping cart persistence, and distributed locking.")
    Component(ReplicationManager, "Replication Manager", "AWS ElastiCache Multi-AZ", "Manages multi-AZ replication with automatic failover to guarantee high availability and uptime requirements.")
    Component(ClusterNodeManager, "Cluster Node Manager", "AWS ElastiCache", "Manages cluster nodes, scaling, and private subnet isolation.")
    Component(SessionStoreDataStructure, "Session Store Data Structure", "Redis Hash maps (`user:session:<id>`)", "Stores user session data for fast retrieval by the Node.js BFF.")
    Component(CartandDistributedLockStoreDataStructure, "Cart and Distributed Lock Store Data Structure", "Redis Strings/Keys (`cart:<id>`, `lock:item:<id>`)", "Handles shopping cart persistence and distributed locking for the Checkout Service.")
}

System_Ext(NodejsBFF, "Node.js BFF", "External client interacting with session and cache.")
System_Ext(CheckoutService, "Checkout Service", "External service interacting with cart and distributed locks.")

Rel(NodejsBFF, InMemoryDataStoreEngine, "Reads and writes session data and cache", "RESP v3 over TLS 1.3 [TLS-encrypted connection / Port 6379]")
Rel(CheckoutService, InMemoryDataStoreEngine, "Manages distributed locking and shopping cart persistence", "RESP v3 over TLS 1.3 [TCP / Port 6379]")

@enduml