@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Amazon EventBridge / SQS", "Amazon EventBridge / SQS") {
    Component("Event Bus", "Event Bus", "Amazon EventBridge", "Central JSON-based router for publishing and filtering domain events.")
    Component("Order Processing Queue", "Order Processing Queue", "Amazon SQS", "Decouples checkout services from downstream fulfillment and buffers order payloads.")
    Component("Notification Queue", "Notification Queue", "Amazon SQS", "Queues alerts and messages for customer notifications.")
    Component("Dead-Letter Queue", "Dead-Letter Queue", "Amazon SQS", "Captures poisoned or failed messages for administrative debugging.")
}

Rel("Event Bus", "Order Processing Queue", "Routes filtered domain events via EventBridge Rule targets", "AWS SQS API")

@enduml