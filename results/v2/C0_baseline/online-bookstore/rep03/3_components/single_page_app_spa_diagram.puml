@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(CustomersShoppersGuestShoppers, "Customers (Shoppers) & Guest Shoppers", "End users browsing catalogs, managing carts, and purchasing books.")

System_Ext(AmazonAPIGateway, "Amazon API Gateway", "Backend API gateway for client-to-backend communication.")
System_Ext(Auth0, "Auth0", "Identity provider for user authentication.")

Container_Boundary(SinglePageAppSPA, "Single Page App (SPA)") {
    Component(CatalogSearchModule, "Catalog & Search Module", "React, Redux Toolkit", "Component handling keyword searches and local caching.")
    Component(CartMultiCurrencyStateManager, "Cart & Multi-Currency State Manager", "React Context, Zustand", "Component managing local cart state and currency display (USD, EUR, GBP).")
    Component(CheckoutAuthClient, "Checkout & Auth Client", "React Router, Auth0 SDK", "Component handling authentication and checkout handoffs.")
    Component(RecommendationReviewWidget, "Recommendation & Review Widget", "React", "Component rendering asynchronous product recommendations and 5-star ratings.")
    Component(PromotionsDiscountClient, "Promotions & Discount Client", "Zustand", "Component managing coupon codes and promotional banners.")
    Component(ConsentPrivacyModule, "Consent & Privacy Module", "React", "Component gating tracking initialization for GDPR and CCPA compliance.")
}

Rel(CustomersShoppersGuestShoppers, SinglePageAppSPA, "Browses store, manages cart, and views recommendations", "HTTPS")
Rel(SinglePageAppSPA, AmazonAPIGateway, "Client-to-backend communication", "HTTPS / REST")
Rel(CheckoutAuthClient, Auth0, "User authentication", "OAuth 2.0 / OIDC")

@enduml