@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Node.js BFF container

Container_Boundary(node_js_bff, "Node.js BFF") {
    Component(API_Router, "API Router", "Express.js", "Routes incoming client requests and enforces mTLS and TLS 1.3.")
    Component(GraphQL_Federation___Aggregator, "GraphQL Federation / Aggregator", "Apollo Server, GraphQL", "Aggregates downstream microservice data to minimize client payload sizes.")
    Component(Session___State_Manager, "Session & State Manager", "Node.js, Amazon ElastiCache Redis", "Manages user session and cart data via TLS-encrypted connections.")
    Component(Event_Dispatcher, "Event Dispatcher", "Node.js SDK", "Publishes domain events to Amazon EventBridge and SQS.")
}

System_Ext(Checkout_Service, "Checkout Service", "Downstream microservice for checkout processing")
System_Ext(Recommendations_Service, "Recommendations Service", "Downstream microservice for recommendations")
System_Ext(Notification_Service, "Notification Service", "Downstream microservice for notifications")
System_Ext(Amazon_EventBridge___SQS, "Amazon EventBridge / SQS", "AWS Event and Queue messaging service")

Rel(API_Router, GraphQL_Federation___Aggregator, "Internal routing", "HTTP/2")
Rel(GraphQL_Federation___Aggregator, Session___State_Manager, "Fetches session/cart data", "TCP+TLS")
Rel(GraphQL_Federation___Aggregator, Checkout_Service, "Federated queries with circuit breakers", "gRPC or HTTP/2")
Rel(GraphQL_Federation___Aggregator, Recommendations_Service, "Federated queries with circuit breakers", "gRPC or HTTP/2")
Rel(GraphQL_Federation___Aggregator, Notification_Service, "Federated queries with circuit breakers", "gRPC or HTTP/2")
Rel(Event_Dispatcher, Amazon_EventBridge___SQS, "Publishes domain events", "HTTPS")

@enduml