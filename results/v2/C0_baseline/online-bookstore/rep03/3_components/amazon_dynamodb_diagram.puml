@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon DynamoDB container

Person(RecommendationsService, "Recommendations Service", "Python, FastAPI, AWS ECS Fargate")

System_Boundary(AmazonDynamoDB, "Amazon DynamoDB") {
    Component(ItemCoOccurrenceTable, "ItemCoOccurrence Table", "Amazon DynamoDB Global Table", "Global table for adjacency lists supporting multi-region data synchronization.")
    Component(UserAffinityProfilesTable, "UserAffinityProfiles Table", "Amazon DynamoDB Regional Table", "Regional table storing user interaction weights for personalized recommendations.")
}

Rel(RecommendationsService, ItemCoOccurrenceTable, "Reads/writes recommendation data", "AWS SDK (HTTPS/TLS 1.3) over VPC Endpoints")
Rel(RecommendationsService, UserAffinityProfilesTable, "Reads/writes recommendation data", "AWS SDK (HTTPS/TLS 1.3) over VPC Endpoints")

@enduml