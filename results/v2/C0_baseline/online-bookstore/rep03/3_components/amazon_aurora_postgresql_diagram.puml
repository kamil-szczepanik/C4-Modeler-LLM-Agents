@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_aurora_postgresql, "Amazon Aurora (PostgreSQL)") {
    Component(Order_Management_Schema, "Order Management Schema", "PostgreSQL Logical Schema", "Isolates and manages order data ensuring zero-loss financial transactions.")
    Component(Inventory_Catalog_Schema, "Inventory Catalog Schema", "PostgreSQL Logical Schema", "Manages secure inventory data and catalog information.")
    Component(User_Identity_Schema, "User Identity Schema", "PostgreSQL Logical Schema", "Isolates user identity and authentication data.")
    Component(Primary_Writer, "Primary Writer", "Amazon Aurora PostgreSQL Writer", "Handles primary write traffic and receives automated CI/CD schema migrations.")
    Component(Read_Replicas, "Read Replicas", "Amazon Aurora PostgreSQL Read Replicas", "Handles regional read-heavy queries and inventory checks.")
}

Rel(Order_Management_Schema, Primary_Writer, "Persists transactional order data")
Rel(Inventory_Catalog_Schema, Primary_Writer, "Persists inventory updates")
Rel(User_Identity_Schema, Primary_Writer, "Persists user identity records")
Rel(Primary_Writer, Read_Replicas, "Replicates data for read-heavy operations")

@enduml