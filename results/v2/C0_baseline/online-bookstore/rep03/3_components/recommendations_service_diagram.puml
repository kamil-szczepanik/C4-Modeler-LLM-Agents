@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Recommendations Service container

Container_Boundary(recommendations_service, "Recommendations Service") {
    Component(RecommendationAPIController, "Recommendation API Controller", "FastAPI", "FastAPI service handling real-time recommendation requests.")
    Component(RulesMerchandisingEngine, "Rules & Merchandising Engine", "FastAPI component", "Component managing business overrides and fallback lists.")
    Component(AsyncBatchInferenceWorker, "Async Batch Inference Worker", "AWS SageMaker / ECS task", "Handles offline machine learning workloads.")
    Component(DataAccessPrivacyLayer, "Data Access & Privacy Layer", "Boto3", "Boto3-based component interacting with storage and event queues.")
    Component(AmazonDynamoDB, "Amazon DynamoDB", "Amazon DynamoDB Global Tables", "Multi-region database utilizing Global Tables with AWS KMS encryption.")
    Component(AmazonSQSEventBridge, "Amazon SQS / EventBridge", "AWS Messaging", "Messaging backbone for user activity and GDPR purge events.")
}

Rel(RecommendationAPIController, AmazonDynamoDB, "Reads pre-computed vectors via TLS [<10ms]")
Rel(RecommendationAPIController, RulesMerchandisingEngine, "In-process function calls")
Rel(AsyncBatchInferenceWorker, AmazonSQSEventBridge, "Consumes user activity streams via AMQP")
Rel(DataAccessPrivacyLayer, AmazonDynamoDB, "Performs TLS-encrypted writes and GDPR purges")

@enduml