@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers, "Customers (Shoppers)", "End users browsing books, managing carts, and completing checkouts via web and mobile interfaces.")
Person(Authors, "Book Authors/Publishers", "Stakeholders who provide content and manage book listings within the ecosystem.")
Person(Admins, "Store Administrators", "System managers accessing the platform to oversee operations using strict security protocols.")

System(BookstoreSystem, "Online Bookstore System", "Global e-commerce platform designed to sell physical and electronic books with recommendations, reviews, and high-scale secure retail operations.")

System_Ext(StripePayPal, "Stripe/PayPal", "External payment gateway handling secure checkout and financial transactions.")
System_Ext(FedExDHL, "FedEx/DHL", "External shipping providers handling physical book delivery.")
System_Ext(Auth0Cognito, "Auth0/AWS Cognito", "Identity provider managing authentication and user identity.")
System_Ext(SendGridTwilio, "SendGrid/Twilio", "Notification provider sending alerts and messages to users.")
System_Ext(SegmentSnowflake, "Segment/Snowflake", "Analytics and BI tools processing event streams for business intelligence.")

Rel(Customers, BookstoreSystem, "Browse, manage cart, and checkout", "HTTPS (Web/Mobile)")
Rel(Admins, BookstoreSystem, "Access system for administration and management", "HTTPS with mTLS and hardware-backed MFA")
Rel(BookstoreSystem, StripePayPal, "Process checkout and payments", "HTTPS/REST APIs")
Rel(BookstoreSystem, FedExDHL, "Coordinate shipping and fulfillment", "REST/Webhooks with HMAC signature verification")
Rel(BookstoreSystem, SendGridTwilio, "Send notifications to users", "REST/Webhooks with HMAC signature verification")
Rel(BookstoreSystem, SegmentSnowflake, "Push event data for analytics", "Kinesis/Kafka")

@enduml