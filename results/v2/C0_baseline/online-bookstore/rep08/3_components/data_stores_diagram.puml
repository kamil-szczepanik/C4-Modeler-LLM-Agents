@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Stores container

System_Ext(catalog_search, "Catalog & Search Service", "External service interacting with the data stores")
System_Ext(checkout_order, "Checkout & Order Service", "External service interacting with the data stores")
System_Ext(recommendation_svc, "Recommendation Service", "External service interacting with the data stores")
System_Ext(user_privacy, "User Privacy & Compliance Service", "External service interacting with the data stores")
System_Ext(global_regions, "Global Regions", "Other AWS regions for global replication")

Container_Boundary(data_stores, "Data Stores") {
    Component(catalog_transaction_db, "Catalog & Transaction DB", "Amazon Aurora PostgreSQL (Multi-AZ, Global Database)", "Stores catalog and ACID-compliant transactional data with multi-currency support and global read replicas.")
    Component(compliance_audit_store, "Compliance & Audit Store", "Amazon DynamoDB with DynamoDB Streams", "Manages compliance and right-to-be-forgotten data, rapid compliance data handling, and TTL-based purging.")
    Component(recommendation_cache, "Recommendation Cache", "Amazon ElastiCache for Redis (Global Datastore)", "Provides pre-computed recommendations for sub-millisecond retrieval.")
    Component(security_governance, "Security & Governance", "AWS KMS, AWS Secrets Manager, IAM, AWS Organizations", "Handles encryption at rest, secrets management, passwordless database authentication, and SCPs.")
}

Rel(catalog_search, catalog_transaction_db, "Reads/writes catalog data", "JDBC over TLS")
Rel(checkout_order, catalog_transaction_db, "Persists ACID-compliant transactional data", "JDBC over TLS")
Rel(recommendation_svc, recommendation_cache, "Retrieves pre-computed recommendations", "RESP protocol")
Rel(user_privacy, compliance_audit_store, "Manages compliance and right-to-be-forgotten data", "AWS SDK over HTTPS")
Rel(global_regions, catalog_transaction_db, "Replicates data globally", "Encrypted inter-region transit and VPC peering")
Rel(global_regions, recommendation_cache, "Replicates data globally", "Encrypted inter-region transit and VPC peering")

@enduml