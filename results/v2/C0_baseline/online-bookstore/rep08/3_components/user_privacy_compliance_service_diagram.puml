@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the User Privacy & Compliance Service container

Container_Boundary(user_privacy_compliance_service, "User Privacy & Compliance Service") {
    Component(Compliance_API_Controller, "Compliance API Controller", "Python, FastAPI", "Exposes endpoints to handle privacy requests, data access, and account deletion.")
    Component(Data_Extraction_Engine, "Data Extraction Engine", "Python", "Gathers user data across data stores and generates encrypted exports.")
    Component(Anonymization___Purging_Worker, "Anonymization & Purging Worker", "Python", "Executes purging and anonymization of user records in transactional and NoSQL databases.")
    Component(Compliance_Event_Publisher___Notification_Dispatcher, "Compliance Event Publisher / Notification Dispatcher", "Python, AWS SES", "Publishes domain events for asynchronous workflows and dispatches notifications.")
}

System_Ext(Amazon_S3, "Amazon S3", "Stores encrypted data exports and static assets.")
System_Ext(Amazon_Aurora_PostgreSQL___DynamoDB, "Amazon Aurora PostgreSQL & DynamoDB", "Transactional and NoSQL databases.")
System_Ext(Amazon_SQS, "Amazon SQS", "Message queue for asynchronous workflows.")

Rel(Compliance_API_Controller, Data_Extraction_Engine, "Triggers data extraction for export requests", "Internal")
Rel(Compliance_API_Controller, Anonymization___Purging_Worker, "Triggers user data anonymization and deletion", "Internal")
Rel(Data_Extraction_Engine, Amazon_S3, "Stores encrypted data exports with 15-minute presigned URLs", "HTTPS, AWS KMS")
Rel(Anonymization___Purging_Worker, Amazon_Aurora_PostgreSQL___DynamoDB, "Executes purging and anonymization", "SSL/TLS")
Rel(Compliance_Event_Publisher___Notification_Dispatcher, Amazon_SQS, "Publishes domain events for asynchronous workflows", "AMQP/SQS Protocol")

@enduml