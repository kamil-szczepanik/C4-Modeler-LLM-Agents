@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog & Search Service container

Container_Boundary(catalog_and_search_service, "Catalog & Search Service") {
    Component(SearchController, "Search Controller", "Spring MVC", "Routes search requests via mTLS and AWS IAM.")
    Component(SearchIndexerSyncWorker, "Search Indexer / Sync Worker", "Spring Cloud Stream, Elasticsearch Java Client", "Performs near-real-time index updates using AWS SigV4 over HTTPS.")
    Component(CatalogManagementService, "Catalog Management Service", "Spring Data JPA", "Persists source-of-truth data using IAM Database Authentication and publishes mutation events.")
    Component(CurrencyConversionProcessor, "Currency Conversion Processor", "Spring Boot", "Handles multi-currency pricing conversions.")
    Component(CatalogEventPublisher, "Catalog Event Publisher", "Spring Cloud Stream", "Publishes catalog and inventory mutation events.")
    Component(AmazonOpenSearchService, "Amazon OpenSearch Service", "Amazon OpenSearch", "Executes search and aggregation queries over HTTPS with TLS 1.3.")
    Component(AmazonAuroraPostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Persists source-of-truth data providing ACID compliance.")
    Component(AmazonSQS, "Amazon SQS", "Amazon SQS (with Dead Letter Queues)", "Decouples write operations from search indexing and holds mutation events.")
}

Rel(SearchController, AmazonOpenSearchService, "Executes search and aggregation queries over HTTPS with TLS 1.3", "HTTPS / TLS 1.3")
Rel(CatalogManagementService, AmazonAuroraPostgreSQL, "Persists source-of-truth data using IAM Database Authentication", "IAM Auth / JDBC")
Rel(CatalogManagementService, AmazonSQS, "Publishes catalog and inventory mutation events via AWS SDK", "AWS SDK")
Rel(SearchIndexerSyncWorker, AmazonOpenSearchService, "Performs near-real-time index updates using AWS SigV4 over HTTPS", "HTTPS / AWS SigV4")

@enduml