@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "External API Gateway")
System_Ext(amazon_aurora_postgresql, "Amazon Aurora PostgreSQL", "External Database")
System_Ext(amazon_sqs, "Amazon SQS", "External Queue")

Container_Boundary(recommendation_service, "Recommendation Service") {
    Component(RecommendationEngine, "RecommendationEngine", "FastAPI / Python", "FastAPI core component handling collaborative filtering and input validation.")
    Component(CacheManager, "CacheManager", "Amazon ElastiCache (Redis)", "Manages low-latency retrieval using Amazon ElastiCache (Redis).")
    Component(FallbackManager, "FallbackManager", "Amazon Aurora PostgreSQL", "Implements circuit breakers to query Amazon Aurora PostgreSQL for genre-specific best-sellers during cache failures.")
    Component(ABTestRouter, "ABTestRouter", "Python", "Evaluates request headers to assign algorithm variants and campaign IDs.")
    Component(EventPublisher, "EventPublisher", "AWS SDK (Boto3) / Amazon SQS", "Asynchronously logs pseudonymized impression and click events to Amazon SQS via AWS SDK (Boto3).")
}

Rel(api_gateway, RecommendationEngine, "Routes recommendation requests", "REST/gRPC using mTLS")
Rel(RecommendationEngine, CacheManager, "Reads and writes recommendation data", "Redis Protocol with TLS")
Rel(FallbackManager, amazon_aurora_postgresql, "Queries fallback best-sellers", "PostgreSQL Protocol over TLS 1.3")
Rel(EventPublisher, amazon_sqs, "Publishes pseudonymized events", "HTTPS and AWS KMS encryption with IAM least privilege")

@enduml