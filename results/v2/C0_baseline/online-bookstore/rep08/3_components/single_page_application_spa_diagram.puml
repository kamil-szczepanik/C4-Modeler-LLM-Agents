@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Single Page Application (SPA) container

System_Ext(identity_provider, "Identity Provider (IdP)", "External authentication provider")
System_Ext(api_gateway, "Amazon API Gateway", "External API gateway")

Container_Boundary(spa_container, "Single Page Application (SPA)") {
    Component(catalog_search, "Catalog & Search UI Component", "React, TypeScript", "Handles product browsing and keyword search interfaces.")
    Component(checkout_cart, "Checkout & Cart UI Component", "React, TypeScript", "Manages shopping cart state and secure checkout workflows.")
    Component(recommendation_review, "Recommendation & Review UI Component", "React, TypeScript", "Displays ratings, reviews, and product recommendations.")
    Component(admin_management, "Admin Management UI Component", "React, TypeScript, Lazily-loaded", "Provides store administration interfaces for authorized users.")
    Component(api_client_auth, "API Client & Auth Component", "Axios, OpenID Connect SDK", "Manages secure communication, API requests, and authentication flows.")
}

Rel(catalog_search, api_client_auth, "Internal modular calls", "")
Rel(checkout_cart, api_client_auth, "Internal modular calls", "")
Rel(recommendation_review, api_client_auth, "Internal modular calls", "")
Rel(admin_management, api_client_auth, "Internal modular calls", "")
Rel(api_client_auth, identity_provider, "Authenticates", "OAuth 2.0 / PKCE")
Rel(api_client_auth, api_gateway, "Sends API requests", "HTTPS/TLS 1.3")

@enduml