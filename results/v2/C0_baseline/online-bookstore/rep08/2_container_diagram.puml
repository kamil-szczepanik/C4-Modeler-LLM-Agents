@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore

Person(Customer, "Customer", "End-users interacting via web/mobile interfaces to browse, shop, and checkout.")
Person(Store Administrator, "Store Administrator", "Back-office staff managing inventory, catalog, and fulfillment.")

System_Ext(Third-Party Payment Gateway, "Third-Party Payment Gateway", "External financial transaction processor.")
System_Ext(Shipping Provider, "Shipping Provider", "External physical logistics and fulfillment partner.")
System_Ext(Identity Provider (IdP), "Identity Provider (IdP)", "External authentication service.")

System_Boundary(Online Bookstore, "Online Bookstore") {
    Container(Single Page Application (SPA), "Single Page Application (SPA)", "React, TypeScript, Amazon CloudFront, Amazon S3", "Frontend interface for high-performance client rendering.")
    Container(API Gateway, "API Gateway", "Amazon API Gateway", "Provides entry routing, rate limiting, and JWT validation.")
    Container(Catalog & Search Service, "Catalog & Search Service", "AWS ECS Fargate, Spring Boot, Elasticsearch", "Handles catalog management and fast keyword search.")
    Container(Checkout & Order Service, "Checkout & Order Service", "AWS ECS Fargate, Node.js, Express", "Manages orders, checkout workflows, and integrations with external payment and shipping.")
    Container(Recommendation Service, "Recommendation Service", "AWS ECS Fargate, FastAPI, Redis", "Provides personalized recommendations with low-latency caching.")
    Container(User Privacy & Compliance Service, "User Privacy & Compliance Service", "AWS ECS Fargate", "Manages isolated user privacy workflows and compliance data.")
    ContainerDb(Data Stores, "Data Stores", "Amazon Aurora PostgreSQL, Amazon DynamoDB", "Persists transactional, session, and compliance data.")
    Container(Messaging Service, "Messaging Service", "Amazon SQS", "Handles asynchronous event handling and data export requests.")
}

Rel(Customer, Single Page Application (SPA), "Interacts with web/mobile interfaces", "HTTPS/TLS")
Rel(Store Administrator, Single Page Application (SPA), "Manages store via web/mobile interfaces", "HTTPS/TLS")
Rel(Single Page Application (SPA), API Gateway, "Sends client API requests", "HTTPS/TLS")
Rel(API Gateway, Catalog & Search Service, "Routes catalog and search requests", "mTLS and AWS IAM")
Rel(API Gateway, Checkout & Order Service, "Routes checkout and order requests", "mTLS and AWS IAM")
Rel(API Gateway, Recommendation Service, "Routes recommendation requests", "mTLS and AWS IAM")
Rel(API Gateway, User Privacy & Compliance Service, "Routes user privacy and compliance requests", "mTLS and AWS IAM")
Rel(Catalog & Search Service, Data Stores, "Reads and writes catalog data", "PostgreSQL / Elasticsearch")
Rel(Checkout & Order Service, Data Stores, "Reads and writes transactional data", "Amazon Aurora PostgreSQL")
Rel(Recommendation Service, Data Stores, "Caches and retrieves recommendations", "Redis")
Rel(User Privacy & Compliance Service, Data Stores, "Reads and writes privacy and compliance data", "Amazon DynamoDB")
Rel(Checkout & Order Service, Messaging Service, "Sends asynchronous events and data export requests", "Amazon SQS")
Rel(Checkout & Order Service, Third-Party Payment Gateway, "Processes payments", "TLS-secured HTTPS")
Rel(Checkout & Order Service, Shipping Provider, "Manages shipping and fulfillment", "TLS-secured HTTPS")
Rel(API Gateway, Identity Provider (IdP), "Validates authentication and tokens", "HTTPS / OIDC / OAuth 2.0")

@enduml