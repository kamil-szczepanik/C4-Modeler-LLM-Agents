@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer", "End-user shopping, browsing, reviewing, and checking out.")
Person(Administrator, "Store Administrator", "Internal user managing inventory, catalogue, and fulfillment.")
System(OnlineBookstore, "Online Bookstore", "A cloud-native, multi-region e-commerce platform designed to provide a secure, high-performance shopping experience for physical and electronic books.")
System_Ext(PaymentGateway, "Payment Gateway", "External financial transaction processor (e.g., Stripe/PayPal).")
System_Ext(ShippingProvider, "Shipping Provider", "External physical logistics partner (e.g., FedEx/UPS).")
System_Ext(IdentityPovider, "Identity Provider (IdP)", "External authentication service (e.g., Auth0/AWS Cognito).")

Rel(Customer, OnlineBookstore, "Shopping, browsing, reviewing, and checking out", "HTTPS via AWS CloudFront CDN, TLS 1.3, OAuth 2.0 / OIDC")
Rel(Administrator, OnlineBookstore, "Managing inventory, catalogue, and fulfillment", "HTTPS via AWS CloudFront CDN, TLS 1.3, OAuth 2.0 / OIDC")
Rel(OnlineBookstore, PaymentGateway, "Processing financial transactions", "HTTPS / REST API via TLS 1.3 with mTLS and HMAC webhook verification")
Rel(OnlineBookstore, ShippingProvider, "Managing physical logistics and fulfillment", "HTTPS / REST API via TLS 1.3 with circuit breakers")
Rel(OnlineBookstore, IdentityPovider, "Authenticating users and managing identities", "OIDC / OAuth 2.0 over HTTPS")

@enduml