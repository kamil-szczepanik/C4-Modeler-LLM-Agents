@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore System

Person(Customer_Shopper, "Customer (Shopper)", "Shoppers who browse, purchase physical and electronic books, and interact with the store.")
Person(Book_Reviewer, "Book Reviewer", "Users who provide reviews and feedback on books.")
Person(Store_Administrator, "Store Administrator", "Administrators who manage retail operations and store configurations.")

System_Ext(Payment_Gateway, "Payment Gateway", "External payment processor like Stripe or PayPal for PCI-DSS secure checkout.")
System_Ext(Third_Party_Shipping_Provider, "Third-Party Shipping Provider", "External logistics provider like FedEx or UPS for fulfillment and shipping.")
System_Ext(Tax_Compliance_Service, "Tax & Compliance Service", "External service like Avalara for tax calculations and compliance.")
System_Ext(Email_Notification_Service, "Email/Notification Service", "External notification service like AWS SES or SendGrid for asynchronous emails.")

System_Boundary(Online_Bookstore_System, "Online Bookstore System") {
    Container(Single_Page_Application_SPA, "Single-Page Application (SPA)", "React, hosted on Amazon S3 / CloudFront", "Customer-facing web application for browsing books, reading reviews, and purchasing.")
    Container(Admin_Back_Office_App, "Admin Back-Office App", "React", "Back-office application for store administrators to manage retail operations.")
    Container(API_Gateway, "API Gateway", "Amazon API Gateway", "Entry point for frontend applications, routing requests to backend services.")
    Container(Core_Services, "Core Services", "Node.js/NestJS, Amazon ECS (Fargate)", "Microservices handling core business logic, orders, and user data.")
    Container(Recommendation_Engine, "Recommendation Engine", "Python/FastAPI, Amazon ECS (Fargate)", "Engine providing personalized book recommendations.")
    Container(Notification_Worker, "Notification Worker", "Node.js/Python, Amazon ECS (Fargate)", "Worker processing and dispatching notifications asynchronously.")
    Container(Analytics_Ingestion_Container, "Analytics Ingestion Container", "Amazon ECS (Fargate)", "Container for collecting and ingesting telemetry and analytics data.")
    ContainerDb(Aurora_PostgreSQL, "Aurora PostgreSQL", "Amazon Aurora PostgreSQL (Multi-AZ)", "Relational database for transactional data storage.")
    ContainerDb(Amazon_DynamoDB, "Amazon DynamoDB", "Amazon DynamoDB", "NoSQL database for recommendation data and flexible storage.")
    Container(Amazon_S3, "Amazon S3", "Amazon S3", "Object storage for static assets, backups, and e-book files.")
    Container(Amazon_EventBridge, "Amazon EventBridge", "Amazon EventBridge", "Event bus for asynchronous event publishing and decoupling.")
    Container(Amazon_SQS, "Amazon SQS", "Amazon SQS", "Message queue for asynchronous task distribution.")
}

Rel(Customer_Shopper, Single_Page_Application_SPA, "Browses books and manages cart", "HTTPS/JSON via Amazon CloudFront")
Rel(Book_Reviewer, Single_Page_Application_SPA, "Submits book reviews", "HTTPS/JSON via Amazon CloudFront")
Rel(Store_Administrator, Admin_Back_Office_App, "Manages store operations", "HTTPS/JSON")
Rel(Single_Page_Application_SPA, API_Gateway, "Sends API requests", "HTTPS/JSON via Amazon CloudFront")
Rel(Admin_Back_Office_App, API_Gateway, "Sends administrative API requests", "HTTPS/gRPC with mTLS")
Rel(API_Gateway, Core_Services, "Routes backend requests", "HTTPS/gRPC with mTLS via AWS Service Connect")
Rel(API_Gateway, Admin_Back_Office_App, "Routes admin requests", "HTTPS/gRPC with mTLS via AWS Service Connect")
Rel(API_Gateway, Recommendation_Engine, "Requests recommendations", "HTTPS/gRPC with mTLS via AWS Service Connect")
Rel(Core_Services, Aurora_PostgreSQL, "Reads and writes transactional data", "TCP/TLS")
Rel(Core_Services, Amazon_EventBridge, "Publishes asynchronous events", "Async Event Publishing (JSON)")
Rel(Amazon_EventBridge, Notification_Worker, "Triggers notification tasks", "HTTPS/SQS")
Rel(Amazon_EventBridge, Third_Party_Shipping_Provider, "Triggers shipping fulfillment events", "HTTPS/SQS")
Rel(Customer_Shopper, Payment_Gateway, "Completes checkout payment", "REST/TLS")
Rel(Core_Services, Tax_Compliance_Service, "Calculates taxes", "REST/TLS")
Rel(Notification_Worker, Email_Notification_Service, "Sends notifications", "REST/TLS")

@enduml