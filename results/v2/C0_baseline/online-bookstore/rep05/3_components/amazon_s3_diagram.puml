@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_s3, "Amazon S3") {
    Component(Frontend_Bucket, "Frontend Bucket", "Amazon S3", "Stores static assets for the React Single-Page Application (SPA).")
    Component(E_Book_Asset_Bucket, "E-Book Asset Bucket", "Amazon S3", "Stores electronic book assets accessed securely via pre-signed URLs.")
    Component(Backup_Analytics_Bucket, "Backup & Analytics Bucket", "Amazon S3", "Stores operational logs, backups, and analytics data written by the Analytics Ingestion Container.")
}

System_Ext(Amazon_CloudFront, "Amazon CloudFront", "Content Delivery Network")
System_Ext(Core_Services, "Core Services", "Node.js/NestJS, Amazon ECS (Fargate)")
System_Ext(Analytics_Ingestion_Container, "Analytics Ingestion Container", "Amazon ECS (Fargate)")

Rel(Frontend_Bucket, Amazon_CloudFront, "Distributes static assets globally", "")
Rel(Core_Services, E_Book_Asset_Bucket, "Interacts via AWS SDK (HTTPS) using pre-signed URLs", "AWS SDK (HTTPS)")
Rel(Analytics_Ingestion_Container, Backup_Analytics_Bucket, "Writes operational logs via AWS internal APIs", "AWS internal APIs")

@enduml