@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Routing_and_WAF_Controller, "Routing and WAF Controller", "Amazon API Gateway", "Handles single entry point routing, native response caching, API schema validation, and WAF protection.")
    Component(Authentication_and_Authorization_Handler, "Authentication and Authorization Handler", "Amazon Cognito & AWS WAF", "Validates JSON Web Tokens (JWT) and secures endpoints against OWASP Top-10 rules.")
}

Rel(Routing_and_WAF_Controller, Authentication_and_Authorization_Handler, "Validates incoming requests using", "")

@enduml