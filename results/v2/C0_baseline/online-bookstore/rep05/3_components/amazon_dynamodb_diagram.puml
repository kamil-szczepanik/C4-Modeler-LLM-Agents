@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon DynamoDB container

System_Ext(Core_Services, "Core Services", "ECS Fargate container")
System_Ext(Recommendation_Engine, "Recommendation Engine", "ECS Fargate container")
System_Ext(Amazon_EventBridge, "Amazon EventBridge", "Event bus service")
System_Ext(AWS_CloudWatch, "AWS CloudWatch", "Monitoring and management service")

Container_Boundary(Amazon_DynamoDB, "Amazon DynamoDB") {
    Component(ShoppingCarts_Table, "ShoppingCarts Table", "DynamoDB NoSQL Table", "Stores user cart items with CustomerID partition key, ItemID sort key, and TTL.")
    Component(Recommendations_Table, "Recommendations Table", "DynamoDB NoSQL Table", "Stores book associations with BookID partition key and RecommendedBookID sort key.")
}

Rel(Core_Services, ShoppingCarts_Table, "Queries and manages user cart items", "HTTPS/TCP:443, BatchGetItem/Query")
Rel(Recommendation_Engine, Recommendations_Table, "Performs asynchronous writes to update book associations", "HTTPS/TCP")
Rel(ShoppingCarts_Table, Amazon_EventBridge, "Streams change-data-capture events", "DynamoDB Streams")
Rel(Recommendations_Table, Amazon_EventBridge, "Streams change-data-capture events", "DynamoDB Streams")
Rel(ShoppingCarts_Table, AWS_CloudWatch, "Sends operational metrics and Contributor Insights telemetry", "Native AWS integration")
Rel(Recommendations_Table, AWS_CloudWatch, "Sends operational metrics and Contributor Insights telemetry", "Native AWS integration")

@enduml