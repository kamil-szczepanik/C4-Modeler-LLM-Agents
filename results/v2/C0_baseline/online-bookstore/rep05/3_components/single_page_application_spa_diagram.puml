@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(spa, "Single-Page Application (SPA)") {
    Component(Catalog Browser Component, "Catalog Browser Component", "React", "Allows customers to browse the secure multi-currency book catalog.")
    Component(Checkout Controller Component, "Checkout Controller Component", "React", "Manages the book checkout and payment process for shoppers.")
    Component(Recommendation UI Component, "Recommendation UI Component", "React", "Displays personalized book recommendations and reviews to customers.")
}

Rel(Catalog Browser Component, Checkout Controller Component, "Passes selected book items for purchase")
Rel(Checkout Controller Component, Recommendation UI Component, "Triggers updated recommendation fetch based on purchase history")

@enduml