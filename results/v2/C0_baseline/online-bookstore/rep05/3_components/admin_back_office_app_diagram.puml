@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(admin_back_office_app, "Admin Back-Office App") {
    Component(Catalog Management Module, "Catalog Management Module", "React / Redux Toolkit Component", "Enables store administrators to manage the retail catalog efficiently.")
    Component(Order Fulfillment Dashboard, "Order Fulfillment Dashboard", "React / TanStack Table Component", "Provides capabilities for order fulfillment and tracking.")
    Component(Authentication & RBAC Guard, "Authentication & RBAC Guard", "React Context / JWT Component", "Secures the application with strict RBAC and token security.")
    Component(Bulk Operations Orchestrator, "Bulk Operations Orchestrator", "React Hook Form / Web Workers Component", "Offloads heavy CSV/JSON batch parsing to prevent UI thread starvation.")
    Component(Audit & Telemetry Interceptor, "Audit & Telemetry Interceptor", "Axios Interceptors Component", "Automates correlation ID injection and failure telemetry capture for compliance auditing.")
}

Rel(Catalog Management Module, Authentication & RBAC Guard, "Secured by")
Rel(Order Fulfillment Dashboard, Authentication & RBAC Guard, "Secured by")
Rel(Bulk Operations Orchestrator, Catalog Management Module, "Sends batch data to")
Rel(Catalog Management Module, Audit & Telemetry Interceptor, "Sends API requests via")
Rel(Order Fulfillment Dashboard, Audit & Telemetry Interceptor, "Sends API requests via")
@enduml