@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_eventbridge, "Amazon EventBridge") {
    Component(Bookstore_Domain_Bus, "Bookstore Domain Bus", "AWS EventBridge Custom Bus", "Publishes asynchronous domain events such as OrderPlaced and InventoryUpdated.")
    Component(Schema_Registry___Validation, "Schema Registry & Validation", "AWS EventBridge Schema Registry", "Validates asynchronous events for consistency across decoupled services.")
}

Rel(Bookstore_Domain_Bus, Schema_Registry___Validation, "Validates event payloads against registered schemas", "HTTPS")

@enduml