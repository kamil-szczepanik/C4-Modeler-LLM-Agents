@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aurora_postgresql, "Aurora PostgreSQL") {
    Component(storage_engine, "PostgreSQL Storage Engine", "PostgreSQL Storage Engine", "Handles physical data storage and retrieval for transactional data.")
    Component(query_engine, "Aurora Query Processing Engine", "Aurora Query Processing Engine", "Processes and optimizes incoming SQL queries and manages transactions.")
    Component(replication_agent, "Aurora Replication Agent", "Aurora Replication Agent", "Manages data replication across Multi-AZ deployment and read replicas.")
    Component(cdc_publisher, "Logical Replication / CDC Publisher", "PostgreSQL Logical Decoding", "Streams change events asynchronously for analytics ingestion without impacting primary performance.")
}

Rel(query_engine, storage_engine, "Reads and writes transactional data", "")
Rel(replication_agent, storage_engine, "Replicates storage data across Multi-AZ and read replicas", "")
Rel(cdc_publisher, storage_engine, "Decodes WAL changes from storage", "")

@enduml