@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(recommendation_engine, "Recommendation Engine") {
    Component(API_Controller, "API Controller", "FastAPI Router, Pydantic", "Validates inputs and handles incoming API requests.")
    Component(Privacy_Filter_Middleware, "Privacy Filter Middleware", "Python", "Scrubs PII and verifies GDPR/CCPA consent flags.")
    Component(Experimentation_Router, "Experimentation Router", "Python", "Evaluates A/B testing variant weights.")
    Component(Recommendation_Logic_Service, "Recommendation Logic Service", "scikit-learn, pandas", "Executes collaborative filtering for personalized suggestions.")
    Component(Model___Feature_Store_Client, "Model & Feature Store Client", "Python", "Fetches cached features with a fallback circuit breaker.")
    Component(Amazon_ElastiCache, "Amazon ElastiCache", "Redis", "In-memory cache providing low-latency feature storage.")
}

Rel(API_Controller, Privacy_Filter_Middleware, "In-process call", "")
Rel(Privacy_Filter_Middleware, Experimentation_Router, "In-process call", "")
Rel(Experimentation_Router, Recommendation_Logic_Service, "In-process call", "")
Rel(Recommendation_Logic_Service, Model___Feature_Store_Client, "In-process call", "")
Rel(Model___Feature_Store_Client, Amazon_ElastiCache, "TCP/Redis with TLS and RedisAUTH", "")

@enduml