@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Services container

Container_Boundary(core_services_boundary, "Core Services") {
    Component(Catalog__Search_Component, "Catalog & Search Component", "Node.js / NestJS", "Handles product discovery and catalog queries via NestJS modules.")
    Component(Cart__Checkout_Component, "Cart & Checkout Component", "Node.js / NestJS", "Manages shopping carts, multi-currency conversion, and payment orchestration.")
    Component(User__Compliance_Component, "User & Compliance Component", "Node.js / NestJS", "Enforces GDPR/CCPA data access, audit logging, and profile management.")
    Component(Inventory_Reservation_Component, "Inventory Reservation Component", "Node.js / NestJS", "Manages decoupled, eventual consistency inventory locks via Amazon SQS.")
    Component(Outbox_Dispatcher_Component, "Outbox Dispatcher Component", "Node.js / NestJS", "Publishes reliable transactional events from the database outbox table.")
}

ComponentDb(Aurora_PostgreSQL, "Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "Relational database providing transactional integrity and global replication.")
Component(Tax__Compliance_Service, "Tax & Compliance Service", "External REST Service", "Calculates taxes and validates payments.")
Component(Amazon_EventBridge, "Amazon EventBridge", "AWS EventBridge", "Publishes asynchronous domain events.")
Component(Amazon_SQS, "Amazon SQS", "AWS SQS", "Processes asynchronous inventory locks.")

Rel(core_services_boundary, Aurora_PostgreSQL, "Reads and writes transactional data", "TCP/TLS with IAM DB Auth")
Rel(Cart__Checkout_Component, Tax__Compliance_Service, "Calculates taxes and validates payments", "REST/TLS with circuit breakers")
Rel(Outbox_Dispatcher_Component, Amazon_EventBridge, "Publishes asynchronous domain events", "Async Event Publishing (JSON)")
Rel(Inventory_Reservation_Component, Amazon_SQS, "Processes asynchronous inventory locks", "AMQP/HTTPS")

@enduml