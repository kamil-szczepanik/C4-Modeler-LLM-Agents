@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customer, "Customer (Shopper)", "Shoppers who browse, purchase physical and electronic books, and interact with the store.")
Person(Reviewer, "Book Reviewer", "Users who provide reviews and feedback on books.")
Person(Admin, "Store Administrator", "Administrators who manage retail operations and store configurations.")

System(BookstoreSystem, "Online Bookstore System", "A secure, multi-region e-commerce platform designed to sell physical and electronic books with integrated reviews, recommendations, and GDPR/CCPA compliance.")

System_Ext(PaymentGateway, "Payment Gateway", "External payment processor like Stripe or PayPal for PCI-DSS secure checkout.")
System_Ext(ShippingProvider, "Third-Party Shipping Provider", "External logistics provider like FedEx or UPS for fulfillment and shipping.")
System_Ext(TaxService, "Tax & Compliance Service", "External service like Avalara for tax calculations and compliance.")
System_Ext(NotificationService, "Email/Notification Service", "External notification service like AWS SES or SendGrid for asynchronous emails.")

Rel(Customer, BookstoreSystem, "Interacts with the online bookstore to browse and purchase books", "HTTPS over TLS 1.3")
Rel(Reviewer, BookstoreSystem, "Submits and reads book reviews", "HTTPS over TLS 1.3")
Rel(Admin, BookstoreSystem, "Manages store operations and administrative tasks", "HTTPS over TLS 1.3")
Rel(BookstoreSystem, PaymentGateway, "Processes secure checkouts and payments", "REST/TLS")
Rel(BookstoreSystem, ShippingProvider, "Coordinates order fulfillment and shipping", "REST/TLS APIs with circuit breakers")
Rel(BookstoreSystem, TaxService, "Calculates taxes and ensures compliance", "REST/TLS APIs with circuit breakers")
Rel(BookstoreSystem, NotificationService, "Sends asynchronous notifications and emails", "AWS SQS")

@enduml