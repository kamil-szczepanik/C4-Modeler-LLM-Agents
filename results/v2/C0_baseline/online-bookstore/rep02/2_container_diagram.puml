@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore

Person(Customers, "Customers", "Shoppers browsing catalogues and executing secure checkouts.")
Person(AuthorsPublishers, "Book Authors / Publishers", "Stakeholders tracking sales performance and customer reviews.")
Person(StoreAdministrators, "Store Administrators", "Staff managing catalogue integrity, pricing, and moderation.")

System_Ext(IdentityProvider, "Identity Provider", "External authentication service managing OAuth 2.0/OIDC and privacy consents.")
System_Ext(PaymentGateway, "Payment Gateway", "External system processing multi-currency transactions.")
System_Ext(ShippingProvider, "Shipping Provider", "External partner managing physical order fulfillment.")
System_Ext(RecommendationEngine, "Recommendation Engine", "External SaaS machine learning service for personalized suggestions.")
System_Ext(NotificationService, "Notification Service", "External SaaS handling transactional emails and alerts.")

System_Boundary(OnlineBookstore, "Online Bookstore") {
    Container(SPA, "Single Page Application (SPA)", "React, TypeScript, Amazon CloudFront, Amazon S3", "Client-side user interface delivering high-performance catalogue browsing and checkout.")
    Container(APIGateway, "API Gateway", "Amazon API Gateway, AWS App Mesh", "Routes client traffic, enforces mTLS, and handles security and routing.")
    Container(CatalogueSearchService, "Catalogue & Search Service", "Go, Amazon OpenSearch", "Handles high-throughput catalogue browsing and search capabilities.")
    Container(OrderCheckoutService, "Order & Checkout Service", "Node.js / Java (Spring Boot), Amazon Aurora (PostgreSQL)", "Manages orders, secure checkout processes, and transactional data.")
    Container(RecommendationService, "Recommendation Service", "Python (FastAPI), Amazon DynamoDB", "Provides personalized book recommendations.")
    Container(ReviewModerationService, "Review & Moderation Service", "Node.js", "Manages compliance-heavy customer reviews and moderation workflows.")
    Container(MessagingBus, "Messaging Bus", "Amazon SQS / SNS", "Decouples microservices using asynchronous event-driven messaging.")
    
    ContainerDb(AmazonOpenSearch, "Amazon OpenSearch", "OpenSearch", "Reads and writes catalogue search data")
    ContainerDb(AmazonAurora, "Amazon Aurora (PostgreSQL)", "PostgreSQL", "Reads and writes transactional order data")
    ContainerDb(AmazonDynamoDB, "Amazon DynamoDB", "NoSQL", "Reads and writes recommendation data")
}

Rel(Customers, SPA, "Interacts with the online store", "HTTPS (TLS 1.3)")
Rel(AuthorsPublishers, SPA, "Views sales and reviews", "HTTPS (TLS 1.3)")
Rel(StoreAdministrators, SPA, "Manages catalogue and moderation", "HTTPS (TLS 1.3)")

Rel(SPA, APIGateway, "Routes all client traffic", "HTTPS (TLS 1.3)")

Rel(APIGateway, CatalogueSearchService, "Routes search and browse requests", "REST/GraphQL via mTLS")
Rel(APIGateway, OrderCheckoutService, "Routes checkout and order requests", "REST/GraphQL via mTLS")
Rel(APIGateway, RecommendationService, "Routes recommendation requests", "REST/GraphQL via mTLS")
Rel(APIGateway, ReviewModerationService, "Routes review requests", "REST/GraphQL via mTLS")
Rel(APIGateway, IdentityProvider, "Authenticates users", "OAuth 2.0 / OIDC over HTTPS")

Rel(CatalogueSearchService, AmazonOpenSearch, "Reads and writes catalogue search data", "Dedicated database driver")
Rel(OrderCheckoutService, AmazonAurora, "Reads and writes transactional order data", "Dedicated database driver")
Rel(RecommendationService, AmazonDynamoDB, "Reads and writes recommendation data", "Dedicated database driver")

Rel(OrderCheckoutService, MessagingBus, "Publishes and consumes asynchronous checkout events", "Amazon SQS/SNS")
Rel(CatalogueSearchService, MessagingBus, "Publishes and consumes catalogue events", "Amazon SQS/SNS")
Rel(ReviewModerationService, MessagingBus, "Publishes and consumes moderation events", "Amazon SQS/SNS")

Rel(OrderCheckoutService, PaymentGateway, "Integrates securely for payment processing", "REST/JSON over HTTPS")
Rel(OrderCheckoutService, ShippingProvider, "Integrates securely for order fulfillment", "REST/SOAP over HTTPS")

Rel(RecommendationService, RecommendationEngine, "Fetches machine learning suggestions", "REST/JSON over HTTPS")
Rel(MessagingBus, NotificationService, "Dispatches transactional alerts", "AWS SQS and REST/JSON over HTTPS")

@enduml