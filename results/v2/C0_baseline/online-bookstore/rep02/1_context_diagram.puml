@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Online Bookstore

Person(Customers, "Customers", "Shoppers browsing catalogues and executing secure checkouts.")
Person("Book Authors / Publishers", "Book Authors / Publishers", "Stakeholders tracking sales performance and customer reviews.")
Person("Store Administrators", "Store Administrators", "Staff managing catalogue integrity, pricing, and moderation.")

System("Online Bookstore", "Online Bookstore", "Core AWS-hosted microservices application handling physical and electronic book sales, search, secure checkout, reviews, and personalized recommendations.")

System_Ext("Identity Provider", "Identity Provider", "External authentication service managing OAuth 2.0/OIDC and privacy consents.")
System_Ext("Payment Gateway", "Payment Gateway", "External system processing multi-currency transactions (USD, EUR, GBP).")
System_Ext("Shipping Provider", "Shipping Provider", "External partner managing physical order fulfillment.")
System_Ext("Recommendation Engine", "Recommendation Engine", "External SaaS machine learning service for personalized suggestions.")
System_Ext("Notification Service", "Notification Service", "External SaaS handling transactional emails and alerts.")

Rel(Customers, "Online Bookstore", "Browsing, cart management, and checkout", "HTTPS (TLS 1.3)")
Rel("Book Authors / Publishers", "Online Bookstore", "Tracking sales performance and customer reviews", "HTTPS")
Rel("Store Administrators", "Online Bookstore", "Managing catalogue integrity, pricing, and moderation", "HTTPS")

Rel("Online Bookstore", "Identity Provider", "Authentication and RBAC", "OAuth 2.0 / OIDC over HTTPS")
Rel("Online Bookstore", "Payment Gateway", "Payment processing with tokenized flows", "REST/JSON over HTTPS")
Rel("Online Bookstore", "Shipping Provider", "Fulfillment tracking", "REST/SOAP over HTTPS")
Rel("Online Bookstore", "Recommendation Engine", "Real-time suggestions with pseudonymous IDs", "REST/JSON over HTTPS")
Rel("Online Bookstore", "Notification Service", "Dispatching alerts and transactional emails", "AWS SQS and REST/JSON over HTTPS")

@enduml