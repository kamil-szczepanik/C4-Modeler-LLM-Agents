@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Single Page Application (SPA) container

System_Ext(api_gateway, "API Gateway", "API Gateway")

Container_Boundary(spa_boundary, "Single Page Application (SPA)") {
    Component(routing_shell, "Routing & Shell Component", "React Router, TypeScript", "Manages client-side navigation, layout shells, and UX-level role-based access control (RBAC).")
    Component(catalogue_search, "Catalogue & Search Module", "React, TypeScript, Local State Caching", "Handles browsing and instant filtering with local state caching.")
    Component(cart_checkout, "Cart & Checkout Module", "React, TypeScript", "Manages session cart state and purchase flows.")
    Component(localization_context, "Localization & Personalization Context", "React Context, TypeScript", "Manages currency formatting (USD, EUR, GBP) and user locale state.")
    Component(api_client, "API Client Layer", "Axios/Fetch, OpenAPI", "Communicates securely with the backend using OpenAPI generated types.")
    Component(infrastructure, "Infrastructure", "Amazon S3, Amazon CloudFront, AWS WAF", "Provides static hosting, content delivery, and edge security.")
}

Rel(routing_shell, catalogue_search, "Renders and navigates to")
Rel(routing_shell, cart_checkout, "Renders and navigates to")
Rel(catalogue_search, api_client, "Fetches catalogue and search data via")
Rel(cart_checkout, api_client, "Submits purchase flows and cart state via")
Rel(localization_context, routing_shell, "Provides locale and currency state to")
Rel(api_client, api_gateway, "Routes all client traffic securely via HTTPS (TLS 1.3) with JWT bearer tokens or secure cookies")
Rel(infrastructure, spa_boundary, "Enforces security policies, DDoS protection, CSP headers, and hosts static assets")

@enduml