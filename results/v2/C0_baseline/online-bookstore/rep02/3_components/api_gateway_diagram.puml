@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person_Ext(SinglePageApplication, "Single Page Application", "Client application")
System_Ext(IdentityProvider, "Identity Provider", "OAuth 2.0 / OIDC Identity Provider")
System_Ext(BackendMicroservices, "Backend Microservices", "Catalogue, Order, Recommendation, Review services")

Container_Boundary(ApiGateway, "API Gateway") {
    Component(RoutingEdgeComponent, "Routing & Edge Component", "Amazon API Gateway, Amazon CloudFront, AWS WAF", "Routes, secures, and optimizes client traffic, managing edge routing, rate limiting, request validation, and global content delivery.")
    Component(AuthenticationAuthorizationFilter, "Authentication & Authorization Filter", "AWS Lambda Authorizer", "Executes token authorization and header enrichment to validate security credentials.")
    Component(ServiceMeshProxy, "Service Mesh Proxy", "AWS App Mesh / Envoy sidecar", "Manages service-to-service communication and enforces internal routing and mTLS.")
    Component(ClientContextLocalizationComponent, "Client Context & Localization Component", "Integrated within API Gateway", "Provides localized multi-currency context propagation and context handling.")
}

Rel(SinglePageApplication, RoutingEdgeComponent, "Routes client traffic", "HTTPS (TLS 1.3)")
Rel(RoutingEdgeComponent, AuthenticationAuthorizationFilter, "Validates tokens", "HTTPS/JSON")
Rel(RoutingEdgeComponent, ServiceMeshProxy, "Forwards internal requests", "HTTP/2 or gRPC")
Rel(ServiceMeshProxy, BackendMicroservices, "Enforces east-west traffic", "mTLS via gRPC")
Rel(AuthenticationAuthorizationFilter, IdentityProvider, "Authenticates users", "OAuth 2.0 / OIDC over HTTPS")

@enduml