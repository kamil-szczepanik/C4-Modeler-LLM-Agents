@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Messaging Bus container

Container_Ext(order_checkout_service, "Order & Checkout Service", "Microservice", "Publishes checkout domain events")
Container_Ext(catalogue_search_service, "Catalogue & Search Service", "Microservice", "Publishes catalogue events")
Container_Ext(review_moderation_service, "Review & Moderation Service", "Microservice", "Publishes moderation events")
Container_Ext(notification_service, "Notification Service", "Microservice", "Receives transactional alerts")

Container_Boundary(messaging_bus, "Messaging Bus") {
    Component(event_publisher_sns_topics, "Event Publisher / SNS Topics", "AWS SNS", "Publishes checkout, catalogue, and moderation domain events using JSON over HTTPS.")
    Component(subscription_queues_sqs_buffers, "Subscription Queues / SQS Buffers", "AWS SQS", "Buffers asynchronous events and dispatches transactional alerts to the Notification Service.")
    Component(payload_sanitizer_middleware, "Payload Sanitizer Middleware", "Claims-Check pattern", "Handles payload sanitization and optimization to ensure GDPR and CCPA compliance.")
    Component(schema_registry_validation_middleware, "Schema Registry & Validation Middleware", "AWS Glue Schema Registry", "Enforces strict contract versioning using JSON Schema.")
    Component(dlq_routing_lambda_redrive_component, "DLQ Routing & Lambda Redrive Component", "AWS Lambda", "Powers automated redrive and error handling for dead-letter queues.")
}

Rel(order_checkout_service, event_publisher_sns_topics, "Publishes checkout domain events", "JSON over HTTPS")
Rel(catalogue_search_service, event_publisher_sns_topics, "Publishes catalogue events", "JSON over HTTPS")
Rel(review_moderation_service, event_publisher_sns_topics, "Publishes moderation events", "JSON over HTTPS")
Rel(subscription_queues_sqs_buffers, notification_service, "Dispatches transactional alerts", "REST/JSON over HTTPS")

@enduml