@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(recommendation_service, "Recommendation Service") {
    Component(RecommendationController, "Recommendation Controller", "Python, FastAPI", "Routes REST/GraphQL requests.")
    Component(RecommendationAggregator, "Recommendation Aggregator", "Python, FastAPI", "Delegates logic, reads/writes vectors, persists history, and fetches ML suggestions.")
    Component(UserPreferenceCache, "User Preference Cache", "AWS ElastiCache Redis", "Reads/writes vectors for user preferences.")
}

System_Ext(AmazonDynamoDB, "Amazon DynamoDB", "Persists history [AWS SDK / HTTPS]")
System_Ext(RecommendationEngine, "Recommendation Engine", "Fetches ML suggestions [HTTPS]")

Rel(RecommendationController, RecommendationAggregator, "Delegates logic", "In-process calls")
Rel(RecommendationAggregator, UserPreferenceCache, "Reads/writes vectors", "Redis TCP via TLS")
Rel(RecommendationAggregator, AmazonDynamoDB, "Persists history", "AWS SDK / HTTPS")
Rel(RecommendationAggregator, RecommendationEngine, "Fetches ML suggestions", "HTTPS")

@startuml