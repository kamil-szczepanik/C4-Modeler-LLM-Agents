@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalogue & Search Service container

Container_Boundary(catalogue_and_search_service, "Catalogue & Search Service") {
    Component(Search_API_Controller, "Search API Controller", "Go", "Exposes search endpoints, processes client requests, and interacts with the query normalizer and OpenSearch.")
    Component(Indexing_Worker, "Indexing Worker", "Go", "Updates document indices in Amazon OpenSearch and handles pricing synchronization events.")
    Component(Query_Normalizer_Spellcheck_Component, "Query Normalizer & Spellcheck Component", "Go", "Parses raw search terms and provides spellchecking capabilities.")
    Component(Pricing_Currency_Sync_Handler, "Pricing & Currency Sync Handler", "Go", "Handles pricing and currency synchronization events for catalogue items.")
}

System_Ext(Amazon_OpenSearch, "Amazon OpenSearch", "Search and indexing engine")
System_Ext(Amazon_SQS_SNS, "Amazon SQS/SNS", "Messaging bus")

Rel(Search_API_Controller, Amazon_OpenSearch, "Executes search queries", "HTTPS")
Rel(Indexing_Worker, Amazon_OpenSearch, "Updates document indices", "HTTPS")
Rel(Search_API_Controller, Query_Normalizer_Spellcheck_Component, "Parses raw terms", "In-process Go call")
Rel(Indexing_Worker, Pricing_Currency_Sync_Handler, "Routes pricing events", "In-process Go call")
Rel(catalogue_and_search_service, Amazon_SQS_SNS, "Publishes and consumes events", "HTTPS")

@enduml