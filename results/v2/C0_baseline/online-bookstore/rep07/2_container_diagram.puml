@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore

Person(Shopper, "Shopper", "Browses the product catalog and purchases items.")
Person(RegisteredCustomer, "Registered Customer", "Manages account, writes reviews, and makes purchases.")
Person(SiteAdministrator, "Site Administrator", "Manages site content, administration, and moderation.")
Person(BusinessAnalyst, "Business Analyst", "Analyzes business metrics and data.")

System_Ext(ExternalPaymentGateway, "External Payment Gateway", "Handles secure payment processing.")
System_Ext(ThirdPartyShippingAPIs, "Third-Party Shipping APIs", "Manages fulfillment and shipping logistics.")

System_Boundary(OnlineBookstore, "Online Bookstore") {
    Container(SPA, "Single Page Application (SPA)", "React, TypeScript, Amazon CloudFront, S3", "Provides catalog browsing, secure checkout, reviews, and recommendations for users.")
    Container(ApiGateway, "API Gateway", "AWS API Gateway", "Routes requests from the SPA to internal containers using secure protocols.")
    Container(CatalogSearchContainer, "Catalog & Search Container", "Go, gRPC, Amazon OpenSearch, Aurora PostgreSQL", "Handles product catalog browsing, search functionality, and related data storage.")
    Container(OrderCheckoutContainer, "Order & Checkout Container", "Node.js, Spring Boot, Aurora PostgreSQL", "Manages secure checkout, orders, and isolated transactional data.")
    Container(RecommendationEngine, "Recommendation Engine", "Python, FastAPI", "Generates product recommendations by asynchronously consuming order events.")
    Container(CustomerReviewsRatingsContainer, "Customer Reviews & Ratings Container", "Python, FastAPI, Amazon DynamoDB", "Manages customer reviews and ratings.")
}

Rel(Shopper, SPA, "Browses catalog and interacts with UI", "HTTPS / JSON")
Rel(RegisteredCustomer, SPA, "Manages account, writes reviews, and checkouts", "HTTPS / JSON")
Rel(SiteAdministrator, SPA, "Administers platform features", "HTTPS / JSON")
Rel(BusinessAnalyst, SPA, "Views analytics and business reports", "HTTPS / JSON")

Rel(SPA, ApiGateway, "Sends client requests", "HTTPS / JSON")

Rel(ApiGateway, CatalogSearchContainer, "Routes catalog and search requests", "gRPC over mTLS")
Rel(ApiGateway, OrderCheckoutContainer, "Routes order and checkout requests", "gRPC over mTLS")
Rel(ApiGateway, RecommendationEngine, "Routes recommendation queries", "gRPC over mTLS")
Rel(ApiGateway, CustomerReviewsRatingsContainer, "Routes review and rating requests", "gRPC over mTLS")

Rel(OrderCheckoutContainer, ExternalPaymentGateway, "Processes payments", "HTTPS / REST")
Rel(OrderCheckoutContainer, ThirdPartyShippingAPIs, "Coordinates fulfillment and shipping", "HTTPS / REST")
Rel(OrderCheckoutContainer, RecommendationEngine, "Emits order events asynchronously", "Event Stream")

@enduml