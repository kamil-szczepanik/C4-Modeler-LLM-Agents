@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(CustomerShopper, "Customer (Shopper)", "Browses and purchases physical and electronic books.")
Person(RegisteredCustomerReviewer, "Registered Customer/Reviewer", "Manages account, writes reviews, and interacts with the platform.")
Person(SiteAdministratorContentModerator, "Site Administrator/Content Moderator", "Manages site content, moderation, and administrative tasks.")

System(OnlineBookstore, "Online Bookstore", "A globally distributed e-commerce platform built to handle physical and electronic book sales, recommendations, and reviews with high scalability, strict security compliance, and multi-currency support.")

System_Ext(PaymentGateway, "Payment Gateway", "Handles payment processing (Stripe/PayPal).")
System_Ext(ThirdPartyShippingAPIs, "Third-Party Shipping APIs", "Manages fulfillment and shipping logistics (FedEx/UPS).")
System_Ext(IdentityProvider, "Identity Provider", "Handles authentication and identity services (Auth0/AWS Cognito).")
System_Ext(NotificationService, "Notification Service", "Sends notifications and alerts to users.")
System_Ext(SupplierFeedsERP, "Supplier Feeds/ERP", "Provides inventory and supplier batch data.")

Rel(CustomerShopper, OnlineBookstore, "Browses and purchases books via CDN/Edge", "HTTPS / TLS 1.3")
Rel(RegisteredCustomerReviewer, OnlineBookstore, "Manages account, writes reviews, and authenticates", "OAuth2 / OIDC over HTTPS")
Rel(SiteAdministratorContentModerator, OnlineBookstore, "Moderates content and manages site operations", "HTTPS")
Rel(OnlineBookstore, PaymentGateway, "Processes transactions", "HTTPS / REST")
Rel(OnlineBookstore, ThirdPartyShippingAPIs, "Coordinates shipping and fulfillment", "HTTPS / REST")
Rel(OnlineBookstore, IdentityProvider, "Authenticates users", "OAuth2 / OIDC over HTTPS")
Rel(OnlineBookstore, NotificationService, "Triggers user notifications", "HTTPS / REST Webhooks")
Rel(SupplierFeedsERP, OnlineBookstore, "Provides inventory and product updates", "Secure SFTP / S3 Batch Drops")

@enduml