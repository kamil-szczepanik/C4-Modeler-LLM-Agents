@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Order & Checkout Container container

Component("API Gateway", "API Gateway", "External Gateway", "Entry point routing requests to the checkout controller via gRPC over mTLS.")
Component("AWS EventBridge / Kafka", "AWS EventBridge / Kafka", "Asynchronous Messaging", "Message broker for asynchronous event distribution with DLQ.")

Container_Boundary("Order & Checkout Container", "Order & Checkout Container") {
    Component("Checkout Controller", "Checkout Controller", "Java 21 / Spring Boot", "Manages secure transactions and handles incoming checkout requests.")
    Component("Cart & Pricing Engine", "Cart & Pricing Engine", "Java 21 / Spring Boot", "Calculates multi-currency pricing and manages cart state.")
    Component("Order Orchestrator", "Order Orchestrator", "Java 21 / Spring Boot", "Coordinates the checkout workflow and distributed transactions.")
    Component("Payment Gateway Client", "Payment Gateway Client", "Java 21 / Spring Boot / HTTPS", "Integrates with external payment gateways for secure transaction processing.")
    Component("Shipping & Fulfillment Client", "Shipping & Fulfillment Client", "Java 21 / Spring Boot / HTTPS", "Communicates with fulfillment services to handle shipping.")
    Component("Event Publisher", "Event Publisher", "Java 21 / Spring Boot", "Publishes asynchronous domain events using the Transactional Outbox pattern.")
    Component("Order Repository", "Order Repository", "JDBC / JPA / Aurora PostgreSQL", "Provides persistence and transactional data integrity for orders.")
}

Rel("API Gateway", "Checkout Controller", "gRPC over mTLS", "gRPC over mTLS")
Rel("Checkout Controller", "Cart & Pricing Engine", "In-process Java method calls", "In-process")
Rel("Checkout Controller", "Order Orchestrator", "In-process Java method calls", "In-process")
Rel("Order Orchestrator", "Payment Gateway Client", "HTTPS / REST with Resilience4j Circuit Breakers", "HTTPS / REST")
Rel("Order Orchestrator", "Shipping & Fulfillment Client", "HTTPS / REST with Resilience4j Circuit Breakers", "HTTPS / REST")
Rel("Order Orchestrator", "Order Repository", "JDBC / JPA over TLS 1.3", "JDBC / JPA")
Rel("Event Publisher", "Order Repository", "JDBC / JPA over TLS 1.3", "JDBC / JPA")
Rel("Event Publisher", "AWS EventBridge / Kafka", "HTTPS", "HTTPS")

@enduml