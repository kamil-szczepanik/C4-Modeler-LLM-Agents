@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Recommendation Engine container

System_Ext(api_gateway, "API Gateway", "External API Gateway")
System_Ext(order_checkout, "Order & Checkout Container", "External Order and Checkout system")
System_Ext(local_stock_cache, "Local Stock Cache", "External Local Stock Cache")

Container_Boundary(rec_engine, "Recommendation Engine") {
    Component(api_router, "API Router", "Python FastAPI", "Exposes gRPC endpoints for recommendation queries with Pydantic schema validation.")
    Component(inference_pipeline, "Inference Pipeline", "Python PyTorch", "Computes personalized matrix factorization models with signed artifact integrity.")
    Component(event_consumer, "Event Consumer", "Python Kafka Consumer", "Ingests anonymized order events via Amazon MSK.")
    Component(fallback_caching_manager, "Fallback & Caching Manager", "Redis", "Caches global trending sets and handles fallback states.")
    Component(business_rules_filter, "Business Rules & Merchandising Filter", "Python", "Evaluates local stock state replicas and suppression rules.")
}

Rel(api_gateway, api_router, "Routes recommendation queries", "gRPC over mTLS")
Rel(order_checkout, event_consumer, "Emits asynchronous order events", "Amazon MSK")
Rel(api_router, business_rules_filter, "Evaluates candidate lists", "In-process calls")
Rel(business_rules_filter, fallback_caching_manager, "Queries fallback and trending data", "Redis protocol")
Rel(business_rules_filter, local_stock_cache, "Validates item availability", "Asynchronously replicated state")
@enduml