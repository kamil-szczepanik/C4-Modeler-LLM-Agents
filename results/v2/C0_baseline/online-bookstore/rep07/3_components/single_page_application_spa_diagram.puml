@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Shopper_Registered_Customer_Admin, "Shopper / Registered Customer / Admin", "Browser", "Users who interact with the UI.")
System_Ext(API_Gateway, "API Gateway", "AWS API Gateway", "Receives client requests and API calls from the SPA.")

Container_Boundary(Single_Page_Application_SPA, "Single Page Application (SPA)") {
    Component(Routing_Shell_Component, "Routing & Shell Component", "React Router, Zustand", "Manages application routing, shell layout, and decoupled global state management including local cart persistence.")
    Component(Catalog_Search_Component, "Catalog & Search Component", "React & TypeScript", "Delivers catalog browsing and search capabilities.")
    Component(Checkout_Cart_Component, "Checkout & Cart Component", "React & TypeScript", "Handles secure checkout and cart management with resilient handling.")
    Component(Recommendation_Reviews_Component, "Recommendation & Reviews Component", "React & TypeScript", "Displays product recommendations and user reviews.")
    Component(Admin_Analytics_Dashboard_Component, "Admin & Analytics Dashboard Component", "React & TypeScript", "Provides administrative views and analytics dashboards.")
    Component(API_Client_Layer, "API Client Layer", "Axios/Fetch with OpenAPI SDK", "Executes remote operations and communicates with backend services.")
}

Rel(Shopper_Registered_Customer_Admin, Routing_Shell_Component, "Interacts with UI", "HTTPS / JSON")
Rel(API_Client_Layer, API_Gateway, "Sends client requests and API calls", "HTTPS / JSON")
Rel(Routing_Shell_Component, Catalog_Search_Component, "Renders views", "In-memory")
Rel(Routing_Shell_Component, Checkout_Cart_Component, "Renders views", "In-memory")
Rel(Routing_Shell_Component, Recommendation_Reviews_Component, "Renders views", "In-memory")
Rel(Routing_Shell_Component, Admin_Analytics_Dashboard_Component, "Renders views", "In-memory")
Rel(Catalog_Search_Component, API_Client_Layer, "Executes remote operations", "HTTPS / JSON")
Rel(Checkout_Cart_Component, API_Client_Layer, "Executes remote operations", "HTTPS / JSON")
Rel(Recommendation_Reviews_Component, API_Client_Layer, "Executes remote operations", "HTTPS / JSON")
Rel(Admin_Analytics_Dashboard_Component, API_Client_Layer, "Executes remote operations", "HTTPS / JSON")
@enduml