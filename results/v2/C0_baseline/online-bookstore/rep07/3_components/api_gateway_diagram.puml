@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Edge_Router_Reverse_Proxy, "Edge Router / Reverse Proxy", "Amazon CloudFront", "Handles TLS 1.3 termination, caching, and OpenAPI schema validation.")
    Component(Auth_Policy_Enforcer, "Auth & Policy Enforcer", "AWS API Gateway Custom Authorizer", "Validates JWT tokens, manages rate limiting, and enforces OWASP Top-10 security controls (R-08).")
    Component(Request_Transformer_Geo_Resolver, "Request Transformer / Geo-Resolver", "AWS Lambda / Edge Lambda", "Extracts client geo-location and injects multi-currency headers (USD, EUR, GBP).")
    Component(Resiliency_Fallback_Orchestrator, "Resiliency & Fallback Orchestrator", "AWS API Gateway / Lambda", "Handling circuit breaking, timeouts, and fallback payloads.")
}

System_Ext(Catalog_Search_Container, "Catalog & Search Container", "Backend Container")
System_Ext(Order_Checkout_Container, "Order & Checkout Container", "Backend Container")
System_Ext(Recommendation_Engine, "Recommendation Engine", "Backend Container")
System_Ext(Customer_Reviews_Ratings_Container, "Customer Reviews & Ratings Container", "Backend Container")
System_Ext(External_Systems, "External Systems", "Payment gateways and third-party shipping APIs")

Rel(Edge_Router_Reverse_Proxy, Auth_Policy_Enforcer, "Forwards validated traffic for security and token validation.")
Rel(Auth_Policy_Enforcer, Request_Transformer_Geo_Resolver, "Passes authenticated requests for context enhancement.")
Rel(Request_Transformer_Geo_Resolver, Resiliency_Fallback_Orchestrator, "Routes enriched requests through resiliency wrappers.")
Rel(Resiliency_Fallback_Orchestrator, Catalog_Search_Container, "Routes catalogue and search requests", "gRPC over mTLS")
Rel(Resiliency_Fallback_Orchestrator, Order_Checkout_Container, "Routes order and checkout requests", "gRPC over mTLS")
Rel(Resiliency_Fallback_Orchestrator, Recommendation_Engine, "Routes recommendation queries", "gRPC over mTLS")
Rel(Resiliency_Fallback_Orchestrator, Customer_Reviews_Ratings_Container, "Routes review and rating requests", "gRPC over mTLS")
Rel(Resiliency_Fallback_Orchestrator, External_Systems, "Integrates with payment gateways and third-party shipping APIs", "secure REST/HTTPS")

@enduml