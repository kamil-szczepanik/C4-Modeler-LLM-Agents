@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore Software System

Person(Book_Buyer___Registered_Reviewer, "Book Buyer / Registered Reviewer", "Web/Mobile users purchasing books and leaving reviews.")
Person(Store_Administrator, "Store Administrator", "Admin portal users managing bookstore operations.")

System_Ext(Payment_Gateway_Provider, "Payment Gateway Provider", "External SaaS handling payment processing.")
System_Ext(Shipping_Provider_ অবশেষে, "Shipping Provider APIs", "External logistics managing order fulfillment and shipping.")
System_Ext(Identity_Provider___Notification_Service, "Identity Provider / Notification Service", "Third-party SaaS handling identity and notifications.")
System_Ext(Recommendation_Engine, "Recommendation Engine", "External SaaS/ML service providing book recommendations.")
System_Ext(Tax___Localization_API, "Tax & Localization API", "External service providing tax calculations and localization data.")

System_Boundary(Online_Bookstore_Software_System, "Online Bookstore Software System") {
    Container(Single_Page_Application__SPA_, "Single Page Application (SPA)", "React / TypeScript, AWS S3 & CloudFront", "Frontend client application for browsing, searching, and managing purchases.")
    Container(API_Gateway, "API Gateway", "AWS API Gateway", "Entry point for routing, JWT validation, and rate limiting.")
    Container(Catalogue_Service, "Catalogue Service", "Node.js (Express), Amazon OpenSearch", "Handles product catalogue browsing and fast keyword searches.")
    Container(Order___Checkout_Service, "Order & Checkout Service", "Java (Spring Boot), Amazon Aurora PostgreSQL", "Manages secure, transactional orders and checkout processes.")
    Container(Recommendation___Review_Service, "Recommendation & Review Service", "Python (FastAPI), Amazon SQS/SNS", "Handles asynchronous event publishing for recommendations and reviews.")
    ContainerDb(Amazon_OpenSearch, "Amazon OpenSearch", "OpenSearch", "Provides fast keyword lookups and search capabilities.")
    ContainerDb(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "PostgreSQL", "Stores transactional order and checkout data securely.")
    ContainerDb(Amazon_SQS_SNS, "Amazon SQS/SNS", "AWS SQS / SNS", "Manages asynchronous event messaging.")
}

Rel(Book_Buyer___Registered_Reviewer, Single_Page_Application__SPA_, "Browses bookstore, places orders, and leaves reviews", "HTTPS/JSON via AWS CloudFront/S3")
Rel(Store_Administrator, Single_Page_Application__SPA_, "Manages store operations via admin interface", "HTTPS/JSON via AWS CloudFront/S3")
Rel(Single_Page_Application__SPA_, API_Gateway, "Sends API requests for catalogue, orders, and recommendations", "HTTPS / REST")
Rel(API_Gateway, Catalogue_Service, "Routes catalogue and search queries", "mTLS and gRPC")
Rel(API_Gateway, Order___Checkout_Service, "Routes order and checkout transactions", "mTLS and gRPC")
Rel(API_Gateway, Recommendation___Review_Service, "Routes recommendation and review requests", "mTLS and gRPC")
Rel(Catalogue_Service, Amazon_OpenSearch, "Performs fast keyword lookups and queries", "Internal query protocol")
Rel(Order___Checkout_Service, Amazon_Aurora_PostgreSQL, "Executes transactional database queries", "Transactional database queries")
Rel(Order___Checkout_Service, Payment_Gateway_Provider, "Processes secure payments", "Outbound HTTPS")
Rel(Order___Checkout_Service, Shipping_Provider_ অবশেষে, "Dispatches shipping orders", "Outbound HTTPS")
Rel(Recommendation___Review_Service, Amazon_SQS_SNS, "Publishes and consumes asynchronous events", "Asynchronous event publishing")

@enduml