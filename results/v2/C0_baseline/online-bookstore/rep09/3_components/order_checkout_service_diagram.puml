@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Order & Checkout Service container

Container_Boundary(order_checkout_service_boundary, "Order & Checkout Service") {
    Component(Checkout Orchestrator Component, "Checkout Orchestrator Component", "Java Spring Boot, Spring State Machine", "Orchestrates the order fulfillment and checkout workflow using the Saga pattern.")
    Component(Payment Integration Component, "Payment Integration Component", "Java Spring Boot, Resilience4j", "Interfaces with the external Payment Gateway Provider using outbound HTTPS with mTLS.")
    Component(Fulfillment Client Component, "Fulfillment Client Component", "Java Spring Boot", "Dispatches shipping orders to external Shipping Provider APIs via outbound HTTPS with mTLS.")
    Component(Order Repository Component, "Order Repository Component", "Java Spring Boot, JDBC", "Executes transactional queries against Amazon Aurora PostgreSQL with AWS KMS encryption.")
    Component(Notification Publisher Component, "Notification Publisher Component", "Java Spring Boot, Amazon SNS/SQS", "Triggers order confirmation emails and publishes encrypted payloads to the Identity Provider / Notification Service.")
}

Rel(Checkout Orchestrator Component, Payment Integration Component, "Delegates payment processing requests", "Outbound HTTPS with mTLS and Resilience4j circuit breakers")
Rel(Checkout Orchestrator Component, Fulfillment Client Component, "Delegates shipping and dispatch requests", "Outbound HTTPS with mTLS")
Rel(Checkout Orchestrator Component, Order Repository Component, "Persists transactional order data", "JDBC with AWS KMS encryption")
Rel(Checkout Orchestrator Component, Notification Publisher Component, "Triggers order confirmation notifications", "Amazon SNS/SQS with encrypted payloads")

@enduml