@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(Auth_Filter, "Authentication & Authorization Filter", "AWS API Gateway Custom Authorizer", "Component validating JWTs and scopes")
    Component(Rate_Limiting, "Rate Limiting & Throttling Engine", "AWS WAF / API Gateway Throttling", "Component enforcing tiered WAF policies")
    Component(Routing, "Routing & Protocol Translationer", "AWS API Gateway REST to gRPC Mappings", "Component converting REST to gRPC")
    Component(Context_Injector, "Context & Localization Injector", "AWS Lambda / API Gateway Request Transformer", "Component adding currency and geo-context")
}

System_Ext(Catalogue_Service, "Catalogue Service", "Node.js (Express) with Amazon OpenSearch")
System_Ext(Order_Service, "Order & Checkout Service", "Java (Spring Boot) with Amazon Aurora PostgreSQL")
System_Ext(Recommendation_Service, "Recommendation & Review Service", "Python (FastAPI) with Amazon SQS/SNS")

Rel(Rate_Limiting, Auth_Filter, "Enforces policies at the edge")
Rel(Auth_Filter, Routing, "Validates requests before routing", "HTTPS / gRPC")
Rel(Context_Injector, Routing, "Enriches payload with geo and currency data")
Rel(Routing, Catalogue_Service, "Routes search and browse queries", "mTLS / gRPC")
Rel(Routing, Order_Service, "Routes transactions", "mTLS / gRPC")
Rel(Routing, Recommendation_Service, "Routes recommendations", "mTLS / gRPC")

@enduml