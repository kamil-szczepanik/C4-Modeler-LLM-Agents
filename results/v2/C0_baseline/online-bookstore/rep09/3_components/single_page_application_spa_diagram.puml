@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(spa, "Single Page Application (SPA)") {
    Component(Router and View Controller, "Router and View Controller", "React Router", "Handles client-side routing and view rendering.")
    Component(State and Localization Store, "State and Localization Store", "Zustand + i18next", "Manages lightweight client state, themes, and multi-currency preferences.")
    Component(API Client Layer, "API Client Layer", "Axios/Fetch with Interceptors", "Sends REST API requests for catalogue, orders, and recommendations.")
    Component(Consent and Compliance Manager, "Consent and Compliance Manager", "React / TypeScript", "Ensures GDPR and CCPA privacy compliance.")
    Component(Auth and Session Interceptor, "Auth and Session Interceptor", "HttpOnly Cookies / TypeScript", "Secures session management against XSS exfiltration.")
}

Rel(Router and View Controller, State and Localization Store, "Reads and updates UI state and localization preferences")
Rel(Router and View Controller, Consent and Compliance Manager, "Renders privacy and consent controls")
Rel(API Client Layer, Auth and Session Interceptor, "Attaches session credentials to requests")
Rel(Router and View Controller, API Client Layer, "Triggers data fetching for catalogue, orders, and recommendations")

@enduml