@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Recommendation & Review Service container

System_Ext(CatalogueService, "Catalogue Service", "External service providing catalogue data.")
System_Ext(ExternalNotificationService, "External Notification Service", "External service for sending emails and notifications.")

Container_Boundary(RecommendationReviewService, "Recommendation & Review Service") {
    Component(ReviewAPIController, "Review API Controller", "Python FastAPI", "Handles incoming review submissions and routes processing tasks.")
    Component(RecommendationAPIController, "Recommendation API Controller", "Python FastAPI", "Handles requests for personalized book recommendations.")
    Component(ModerationPipelineComponent, "Moderation Pipeline Component", "Python / AWS SQS", "Offloads and processes review moderation asynchronously.")
    Component(ReviewAggregatorComponent, "Review Aggregator Component", "Python", "Updates rating caches and aggregates product ratings.")
    Component(NotificationDispatcherComponent, "Notification Dispatcher Component", "Python", "Triggers external review emails and notifications.")
}

Rel(ReviewAPIController, ModerationPipelineComponent, "Offloads moderation", "Amazon SQS")
Rel(ReviewAPIController, ReviewAggregatorComponent, "Updates rating cache", "local method call")
Rel(CatalogueService, ReviewAggregatorComponent, "Fetches product ratings", "mTLS and gRPC")
Rel(NotificationDispatcherComponent, ExternalNotificationService, "Triggers review emails", "REST/HTTPS")

@enduml