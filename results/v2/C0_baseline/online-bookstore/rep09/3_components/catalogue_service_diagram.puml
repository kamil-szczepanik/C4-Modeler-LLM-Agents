@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container(api_gateway, "API Gateway", "API Gateway", "Routes incoming requests")
System_Ext(tax_localization_api, "Tax & Localization API", "External API", "Fetches real-time FX rates.")

Container_Boundary(catalogue_service, "Catalogue Service") {
    Component(search_filter_component, "Search & Filter Component", "Node.js / Express", "Manages product browsing, fast keyword searches, and filters.")
    Component(pricing_localization_component, "Pricing & Localization Component", "Node.js / Express", "Manages multi-currency pricing, localized shopping experiences, and FX rates.")
    Component(amazon_opensearch, "Amazon OpenSearch", "Amazon OpenSearch", "Performs fast keyword lookups and DSL query execution.")
    Component(amazon_elasticache_redis, "Amazon ElastiCache (Redis)", "Amazon ElastiCache (Redis)", "Provides low-latency caching for multi-currency pricing.")
}

Rel(api_gateway, search_filter_component, "Routes catalogue and search requests", "mTLS, gRPC")
Rel(search_filter_component, amazon_opensearch, "Performs fast keyword lookups and queries", "Internal query protocol")
Rel(search_filter_component, pricing_localization_component, "Injects localized pricing into payloads", "In-memory / Function call")
Rel(pricing_localization_component, amazon_elasticache_redis, "Reads cached FX rates", "TCP")
Rel(pricing_localization_component, tax_localization_api, "Fetches real-time FX rates", "HTTPS / REST, asynchronous background sync")

@enduml