@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Book_Buyer_Registered_Reviewer, "Book Buyer / Registered Reviewer", "Web/Mobile users purchasing books and leaving reviews.")
Person(Store_Administrator, "Store Administrator", "Admin portal users managing bookstore operations.")
System(Online_Bookstore_Software_System, "Online Bookstore Software System", "An Amazon-style online bookstore providing physical and electronic book sales, recommendations, and reviews. Designed for global scale, regulatory compliance, and high availability.")
System_Ext(Payment_Gateway_Provider, "Payment Gateway Provider", "External SaaS handling payment processing.")
System_Ext(Shipping_Provider_APIs, "Shipping Provider APIs", "External logistics managing order fulfillment and shipping.")
System_Ext(Identity_Provider_Notification_Service, "Identity Provider / Notification Service", "Third-party SaaS handling identity and notifications.")
System_Ext(Recommendation_Engine, "Recommendation Engine", "External SaaS/ML service providing book recommendations.")
System_Ext(Tax_Localization_API, "Tax & Localization API", "External service providing tax calculations and localization data.")

Rel(Book_Buyer_Registered_Reviewer, Online_Bookstore_Software_System, "Interacts with the web/mobile store for browsing, purchasing, and reviewing", "HTTPS, TLS 1.3, mTLS perimeter, OAuth2/OIDC")
Rel(Store_Administrator, Online_Bookstore_Software_System, "Manages the store via the admin portal", "HTTPS, TLS 1.3, mTLS perimeter, OAuth2/OIDC")
Rel(Online_Bookstore_Software_System, Payment_Gateway_Provider, "Processes payments securely", "REST API via secure iframe/redirect")
Rel(Online_Bookstore_Software_System, Shipping_Provider_APIs, "Dispatches shipping orders asynchronously", "REST/SOAP APIs via AWS SQS")
Rel(Online_Bookstore_Software_System, Identity_Provider_Notification_Service, "Authenticates users and sends notifications", "HTTPS / OAuth2/OIDC")
Rel(Online_Bookstore_Software_System, Recommendation_Engine, "Retrieves book recommendations using pseudonymized data", "gRPC/REST over HTTPS with JWT")
Rel(Online_Bookstore_Software_System, Tax_Localization_API, "Calculates taxes and localization with cached fallbacks", "REST over HTTPS with signed audit logs")
@enduml