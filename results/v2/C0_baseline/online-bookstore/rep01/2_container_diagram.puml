@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore System

Person(BookBuyer, "Book Buyer", "End user who browses, purchases books, and receives AI-driven recommendations.")
Person(SiteAdministrator, "Site Administrator", "User responsible for managing the bookstore platform and system settings.")
Person(CustomerSupportRepresentative, "Customer Support Representative", "User responsible for assisting book buyers with orders and support inquiries.")
Person(ContentProviderPublisher, "Content Provider/Publisher", "User responsible for supplying catalog data and digital book assets.")

System_Ext(PaymentGateway, "Payment Gateway", "External service for tokenized, PCI-DSS compliant checkout.")
System_Ext(ThirdPartyShippingAPI, "Third-Party Shipping API", "External service for handling order dispatch and shipping.")
System_Ext(TaxCalculationService, "Tax Calculation Service", "External service for real-time multi-currency tax calculations.")
System_Ext(MarketingEmailServiceProvider, "Marketing/Email Service Provider", "External service for handling email marketing triggers.")
System_Ext(RecommendationEngineMLService, "Recommendation Engine/ML Service", "External machine learning service for personalized recommendations.")

System_Boundary(OnlineBookstoreSystem, "Online Bookstore System") {
    Container(SinglePageApplicationSPA, "Single Page Application (SPA)", "React, AWS S3, CloudFront", "Provides the frontend user interface for catalog browsing, checkout, and account management.")
    Container(APIGateway, "API Gateway", "Node.js / Reverse Proxy with JWT validation and rate-limiting", "Routes client requests securely to internal backend containers with mTLS.")
    Container(CatalogSearchContainer, "Catalog & Search Container", "Spring Boot, Amazon OpenSearch, PostgreSQL", "Handles book catalog management, metadata, and high-performance keyword search.")
    Container(OrderCheckoutContainer, "Order & Checkout Container", "Node.js/Express, PostgreSQL", "Processes shopping carts, secure payments, and order fulfillment workflows.")
    Container(RecommendationContainer, "Recommendation Container", "Python/FastAPI", "Generates personalized book recommendations for users.")
    Container(LocalizationContainer, "Localization Container", "Node.js/Express", "Manages multi-language, multi-currency, and regional localization settings.")
    Container(AnalyticsEventIngestionContainer, "Analytics & Event Ingestion Container", "Go, AWS Kinesis Firehose, Amazon SQS/SNS", "Ingests high-throughput asynchronous telemetry, event streams, and scrubs PII data.")
}

Rel(BookBuyer, SinglePageApplicationSPA, "Accesses book browsing, checkout, and recommendations", "HTTPS via AWS CloudFront and Route 53 latency-based routing")
Rel(SiteAdministrator, SinglePageApplicationSPA, "Manages platform configuration and administration", "HTTPS via AWS CloudFront")
Rel(CustomerSupportRepresentative, SinglePageApplicationSPA, "Assists buyers with support inquiries and order statuses", "HTTPS via AWS CloudFront")
Rel(ContentProviderPublisher, APIGateway, "Uploads and updates catalog and content assets", "HTTPS with JWT validation")
Rel(SinglePageApplicationSPA, APIGateway, "Sends API requests with JWT validation and rate-limiting", "HTTPS")
Rel(APIGateway, CatalogSearchContainer, "Routes catalog and search requests", "gRPC over mTLS via AWS App Mesh")
Rel(APIGateway, OrderCheckoutContainer, "Routes order and payment transactions", "gRPC over mTLS via AWS App Mesh")
Rel(APIGateway, RecommendationContainer, "Requests personalized recommendations", "gRPC over mTLS via AWS App Mesh")
Rel(APIGateway, LocalizationContainer, "Requests localization and currency data", "gRPC over mTLS via AWS App Mesh")
Rel(APIGateway, AnalyticsEventIngestionContainer, "Forwards telemetry and events", "gRPC over mTLS via AWS App Mesh")
Rel(OrderCheckoutContainer, PaymentGateway, "Processes secure cardholder data and transactions", "HTTPS with strict in-memory ephemeral processing")
Rel(OrderCheckoutContainer, ThirdPartyShippingAPI, "Dispatches shipping requests", "HTTPS/REST")
Rel(OrderCheckoutContainer, TaxCalculationService, "Calculates real-time order taxes", "HTTPS/REST")
Rel(AnalyticsEventIngestionContainer, MarketingEmailServiceProvider, "Triggers marketing emails and event notifications", "Amazon SQS/SNS")
Rel(AnalyticsEventIngestionContainer, AnalyticsEventIngestionContainer, "Streams high-throughput asynchronous telemetry with PII scrubbing", "AWS Kinesis Firehose")

@enduml