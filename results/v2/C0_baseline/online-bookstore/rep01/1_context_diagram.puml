@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Book_Buyer, "Book Buyer", "End user who browses, purchases books, and receives AI-driven recommendations.")
Person(Site_Administrator, "Site Administrator", "User responsible for managing the bookstore platform and system settings.")
Person(Customer_Support_Representative, "Customer Support Representative", "User responsible for assisting book buyers with orders and support inquiries.")

System(Online_Bookstore_System, "Online Bookstore System", "An Amazon-style e-commerce online bookstore built on AWS to serve 1M MAU across three global regions, enabling secure book browsing, purchasing, and AI-driven recommendations.")

System_Ext(Payment_Gateway, "Payment Gateway", "External service (Stripe/PayPal) for tokenized, PCI-DSS compliant checkout.")
System_Ext(Third_Party_Shipping_API, "Third-Party Shipping API", "External service (FedEx/UPS) for handling order dispatch and shipping.")
System_Ext(Tax_Calculation_Service, "Tax Calculation Service", "External service (Avalara) for real-time multi-currency tax calculations.")
System_Ext(Marketing_Email_Service_Provider, "Marketing/Email Service Provider", "External service (SendGrid/Klaviyo) for handling email marketing triggers.")

Rel(Book_Buyer, Online_Bookstore_System, "Accesses book browsing, purchasing, and recommendations via secure authentication", "HTTPS (TLS 1.3), AWS Cognito OAuth2/OIDC")
Rel(Site_Administrator, Online_Bookstore_System, "Manages platform configuration and administrative tasks", "HTTPS (TLS 1.3), AWS Cognito OAuth2/OIDC")
Rel(Customer_Support_Representative, Online_Bookstore_System, "Handles customer support tickets and order inquiries", "HTTPS (TLS 1.3), AWS Cognito OAuth2/OIDC")
Rel(Online_Bookstore_System, Payment_Gateway, "Processes tokenized checkout transactions", "HTTPS/REST")
Rel(Online_Bookstore_System, Third_Party_Shipping_API, "Dispatches order fulfillment requests asynchronously", "AWS SQS/EventBridge")
Rel(Online_Bookstore_System, Tax_Calculation_Service, "Calculates real-time multi-currency taxes during checkout", "HTTPS/REST")
Rel(Online_Bookstore_System, Marketing_Email_Service_Provider, "Triggers marketing emails and notifications", "AWS SQS/EventBridge")

@enduml