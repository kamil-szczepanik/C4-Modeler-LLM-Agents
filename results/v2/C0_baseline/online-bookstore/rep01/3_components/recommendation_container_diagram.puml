@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Recommendation Container container

Container_Boundary(recommendation_container, "Recommendation Container") {
    Component(Recommendation API Router, "Recommendation API Router", "FastAPI, Pydantic", "FastAPI component handling incoming gRPC/REST requests and Pydantic validation.")
    Component(Personalization Engine, "Personalization Engine", "Python", "Computes collaborative filtering and Customers also bought logic.")
    Component(Cold-Start & Fallback Engine, "Cold-Start & Fallback Engine", "Python", "Serves trending books for new users or GDPR/CCPA opt-outs.")
    Component(Data Access Layer, "Data Access Layer", "boto3, AWS SDK", "Interfaces with storage using boto3.")
    Component(Telemetry Event Emitter, "Telemetry Event Emitter", "Python, AWS SQS/SNS", "Asynchronously dispatches impression and click events.")
}

System_Ext(AWS SQS_SNS, "AWS SQS/SNS", "Messaging service with Dead-Letter Queues for telemetry events.")

Rel(Recommendation API Router, Personalization Engine, "Delegates requests based on user history and privacy flags")
Rel(Recommendation API Router, Cold-Start & Fallback Engine, "Delegates requests for new users or opted-out users")
Rel(Personalization Engine, Data Access Layer, "Reads recommendation data via AWS SDK")
Rel(Cold-Start & Fallback Engine, Data Access Layer, "Reads trending books data via AWS SDK")
Rel(Telemetry Event Emitter, AWS SQS_SNS, "Dispatches events asynchronously via AWS SQS/SNS")

@enduml