@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Single Page Application (SPA) container

Container_Boundary(spa_boundary, "Single Page Application (SPA)") {
    Component(Catalog_and_Search_Module, "Catalog & Search Module", "React Component", "Provides browsing and search capabilities for physical and electronic books.")
    Component(Checkout_and_Cart_Module, "Checkout & Cart Module", "React Component", "Manages the shopping cart and checkout process.")
    Component(Localization_Context_Provider, "Localization Context Provider", "React Component", "Provides multi-currency and regional localization context across the application.")
    Component(Compliance_and_Consent_Banner, "Compliance & Consent Banner", "React Component", "Displays GDPR/CCPA compliance and consent banners.")
    Component(Analytics_and_Event_Ingestion_Client, "Analytics & Event Ingestion Client", "React Component", "Dispatches telemetry and funnel events asynchronously.")
}

System_Ext(API_Gateway, "API Gateway", "API Gateway")
System_Ext(Localization_Container, "Localization Container", "Localization Container")
System_Ext(Analytics_and_Event_Ingestion_Container, "Analytics & Event Ingestion Container", "Analytics & Event Ingestion Container")

Rel(Catalog_and_Search_Module, API_Gateway, "Fetches book data", "HTTPS / REST")
Rel(Localization_Context_Provider, Localization_Container, "Fetches currency rates and dictionaries", "HTTPS / REST")
Rel(Analytics_and_Event_Ingestion_Client, Analytics_and_Event_Ingestion_Container, "Dispatches telemetry and funnel events asynchronously", "HTTPS / REST")

@enduml