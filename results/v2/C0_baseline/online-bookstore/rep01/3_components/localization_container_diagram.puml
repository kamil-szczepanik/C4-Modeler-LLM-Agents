@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(localization_container, "Localization Container") {
    Component(Locale_Router_Middleware, "Locale Router & Middleware", "Express.js", "Routes localization requests and handles middleware processing.")
    Component(Translation_Service_Component, "Translation Service Component", "i18next", "Performs sub-millisecond multi-language string resolution.")
    Component(Currency_Conversion_Engine, "Currency Conversion Engine", "Node.js / Axios", "Handles multi-currency conversions and fetches exchange rates.")
    Component(Geo_Resolution_Adapter, "Geo-Resolution Adapter", "Node.js", "Resolves user geographic data for regional shipping and tax rules.")
}

Rel(Locale_Router_Middleware, Translation_Service_Component, "Internal component function calls", "")
Rel(Locale_Router_Middleware, Geo_Resolution_Adapter, "Internal component function calls", "")

@enduml