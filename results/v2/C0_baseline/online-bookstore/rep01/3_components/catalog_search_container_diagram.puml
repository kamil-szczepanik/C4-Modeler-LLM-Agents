@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog & Search Container container

System_Ext(api_gateway, "API Gateway", "External API Gateway routing inbound requests.")
System_Ext(amazon_opensearch, "Amazon OpenSearch", "External search cluster.")
System_Ext(postgresql, "PostgreSQL", "External relational database.")
System_Ext(aws_msk_kafka, "AWS MSK / Kafka", "External event streaming platform.")

Container_Boundary(catalog_and_search_container, "Catalog & Search Container") {
    Component(catalog_api_controller, "Catalog API Controller", "Spring MVC", "Exposing endpoints for browsing and metadata retrieval.")
    Component(search_engine_service, "Search Engine Service", "Spring Data / Amazon OpenSearch", "Handling fuzzy matching and auto-complete via Amazon OpenSearch.")
    Component(product_metadata_repository, "Product Metadata Repository", "Spring Data JPA / PostgreSQL", "Managing book details and inventory via PostgreSQL.")
    Component(review_and_rating_aggregator, "Review & Rating Aggregator", "Spring Service", "Aggregating customer ratings.")
    Component(catalog_management_service, "Catalog Management Service", "Spring Service", "Processing admin-initiated updates.")
    Component(sync_and_resilience_pipeline, "Sync & Resilience Pipeline", "Debezium with AWS MSK (Kafka)", "Asynchronous Change Data Capture for decoupled data synchronization.")
}

Rel(api_gateway, catalog_api_controller, "Routes inbound requests", "gRPC over mTLS via AWS App Mesh")
Rel(search_engine_service, amazon_opensearch, "Queries indices", "HTTPS / REST")
Rel(product_metadata_repository, postgresql, "Reads/Writes transactional data", "JDBC / TCP")
Rel(catalog_management_service, aws_msk_kafka, "Publishes catalog change events", "TCP")

@enduml