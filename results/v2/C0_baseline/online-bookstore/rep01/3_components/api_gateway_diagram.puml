@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(Edge_Router___TLS_Termination, "Edge Router & TLS Termination", "AWS API Gateway / Envoy", "Offloads TLS termination and routes incoming global latency-based traffic.")
    Component(Auth___Token_Validator, "Auth & Token Validator", "Amazon Cognito / OAuth 2.0 / JWT", "Validates JWT tokens and OAuth 2.0 credentials for incoming requests.")
    Component(Request_Transformer, "Request Transformer", "AWS API Gateway", "Performs JSON schema validation and transforms incoming requests.")
    Component(Traffic_Policy___Throttling_Component, "Traffic Policy & Throttling Component", "AWS WAF / API Gateway", "Enforces rate-limiting and OWASP Top-10 mitigations.")
    Component(Internal_Routing___mTLS_Dispatcher, "Internal Routing & mTLS Dispatcher", "AWS App Mesh / Envoy", "Dispatches internal requests securely to backend containers using gRPC over mTLS.")
    Component(Service_Mesh_Proxy, "Service Mesh Proxy", "AWS App Mesh", "Manages service-to-service communication and security policies.")
}

Rel(Edge_Router___TLS_Termination, Auth___Token_Validator, "Forwards authenticated traffic", "HTTPS")
Rel(Auth___Token_Validator, Request_Transformer, "Passes validated tokens for", "Internal")
Rel(Request_Transformer, Traffic_Policy___Throttling_Component, "Applies traffic and security policies to", "Internal")
Rel(Traffic_Policy___Throttling_Component, Internal_Routing___mTLS_Dispatcher, "Routes approved traffic to", "Internal")
Rel(Internal_Routing___mTLS_Dispatcher, Service_Mesh_Proxy, "Dispatches via", "gRPC over mTLS")

@enduml