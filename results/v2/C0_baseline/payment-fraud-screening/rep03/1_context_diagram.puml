@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalystRiskManager, "Fraud Analyst / Risk Manager", "Performs case reviews and updates fraud rules.")

System_Ext(PaymentGatewayProcessingEngine, "Payment Gateway / Processing Engine", "External actor that submits authorization requests.")
System_Ext(IdentityProvider, "Identity Provider", "Manages OIDC/OAuth2 authentication and MFA.")
System_Ext(PaymentCardNetworkTokenizationVault, "Payment Card Network / Tokenization Vault", "Provides tokenized card data.")
System_Ext(SecureAuditArchive, "Secure Audit Archive", "Cold storage for tamper-evident retention.")

System(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System", "Core scoring and case management platform that evaluates card-not-present transactions for fraud, and provides case management for analysts.")

Rel(PaymentGatewayProcessingEngine, RealTimePaymentFraudScreeningSystem, "Submits card-not-present authorizations for sub-50ms scoring", "gRPC over TLS (mTLS)")
Rel(FraudAnalystRiskManager, RealTimePaymentFraudScreeningSystem, "Interacts for case management and rule updates", "HTTPS (Web UI) / OIDC/OAuth2")
Rel(RealTimePaymentFraudScreeningSystem, PaymentCardNetworkTokenizationVault, "Resolves payment tokens to enforce PCI-DSS scope reduction", "mTLS/HTTPS")
Rel(RealTimePaymentFraudScreeningSystem, SecureAuditArchive, "Writes decisions, model versions, and inputs", "AWS SDK/S3 API using S3 Object Lock")
Rel(FraudAnalystRiskManager, IdentityProvider, "Authenticates with mandatory MFA", "OIDC/OAuth2 over HTTPS")

@enduml