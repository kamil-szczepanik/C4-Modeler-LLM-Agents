@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Store container

System_Ext(FraudScoringEngine, "Fraud Scoring Engine", "External system")
System_Ext(CaseManagementService, "Case Management Service", "External system")
System_Ext(ExternalStorage, "External Storage", "Amazon S3 Glacier Vault")

Container_Boundary(DataStore, "Data Store") {
    Component(FeatureStore, "Feature Store", "Amazon ElastiCache Serverless Redis", "High-velocity transaction features providing sub-millisecond reads for the Fraud Scoring Engine.")
    Component(OperationalAuditDatabase, "Operational & Audit Database", "AWS Aurora PostgreSQL Multi-AZ", "Relational storage for compliance, transaction history, and case management analyst reviews.")
    Component(AuditArchiveExporter, "Audit Archive Exporter", "AWS Lambda with Amazon EventBridge", "Automated serverless component for scheduling and transferring immutable audit logs.")
    Component(SecurityControls, "Security Controls", "AWS KMS Customer-Managed Keys (CMKs) and AWS Security Groups", "Enforces column-level encryption and AES-256 data protection.")
}

Rel(FraudScoringEngine, FeatureStore, "Fetches real-time transaction features", "RESP / TLS 1.3")
Rel(CaseManagementService, OperationalAuditDatabase, "Persists analyst reviews", "PostgreSQL Wire Protocol / TLS 1.3")
Rel(AuditArchiveExporter, ExternalStorage, "Transfers immutable audit logs", "HTTPS / TLS 1.3")

@enduml