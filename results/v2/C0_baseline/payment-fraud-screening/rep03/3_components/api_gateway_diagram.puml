@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(AWS_Regional_ALB_with_AWS_WAF, "AWS Regional ALB with AWS WAF", "AWS ALB & AWS WAF", "Managed edge security and rate limiting to prevent card-testing attacks.")
    Component(Envoy_Proxy_Sidecar, "Envoy Proxy Sidecar", "Envoy Proxy", "Routes sanitized requests via internal VPC Link and forwards payloads via gRPC.")
}

Rel(AWS_Regional_ALB_with_AWS_WAF, Envoy_Proxy_Sidecar, "Routes sanitized requests via internal VPC Link", "VPC Link")

@enduml