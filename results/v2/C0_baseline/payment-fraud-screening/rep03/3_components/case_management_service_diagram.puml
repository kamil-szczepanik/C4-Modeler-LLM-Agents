@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(case_management_service, "Case Management Service") {
    Component(Case_API_Controller, "Case API Controller", "Node.js, Express", "Handles HTTP requests from fraud analysts and risk managers, enforcing OAuth2/OIDC authentication and strict JSON schema validation.")
    Component(Case_Business_Logic_Orchestration_Service, "Case Business Logic & Orchestration Service", "Node.js, TypeScript", "Orchestrates case management workflows, bulk overrides, and rule feedback processing, including the Bulk Operation Processor.")
    Component(Card_Masking_Tokenizer_Integration_Client, "Card Masking / Tokenizer Integration Client", "Node.js, TypeScript", "Integrates with payment card networks and tokenization vaults via HTTPS to ingest tokenized references without exposing raw PAN data.")
    Component(Audit_Immutable_Ledger_Publisher, "Audit & Immutable Ledger Publisher", "Node.js, TypeScript", "Publishes signed audit logs via gRPC/HTTPS to ensure 7-year operational auditability and compliance.")
    Component(Rule_Feedback_Publisher, "Rule Feedback Publisher", "Node.js, TypeScript", "Submits rule adjustment flags and feedback via gRPC/HTTPS to the Fraud Scoring Engine.")
}

Rel(Case_API_Controller, Case_Business_Logic_Orchestration_Service, "Invokes internal business logic and case management workflows via TypeScript", "")
Rel(Case_Business_Logic_Orchestration_Service, Card_Masking_Tokenizer_Integration_Client, "Requests tokenized references and masking validation via secure API calls", "")
Rel(Case_Business_Logic_Orchestration_Service, Audit_Immutable_Ledger_Publisher, "Triggers audit event publishing for system operations", "")
Rel(Case_Business_Logic_Orchestration_Service, Rule_Feedback_Publisher, "Sends analyst feedback and rule adjustments", "")
@enduml