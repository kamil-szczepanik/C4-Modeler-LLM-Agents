@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit & Compliance Ledger container

Container_Boundary(audit_compliance_ledger_container, "Audit & Compliance Ledger") {
    Component(LedgerIngetionComponent, "Ledger Ingestion Component", "Rust", "Ingests decision payloads sent from the Fraud Scoring Engine.")
    Component(CryptographicSealerComponent, "Cryptographic Sealer Component", "Rust", "Builds Merkle trees and interacts with AWS KMS to sign Merkle root hashes.")
    Component(StorageExportComponent, "Storage & Export Component", "Rust", "Persists metadata and Merkle blocks to AWS Aurora PostgreSQL and writes daily Merkle roots to Amazon S3.")
    Component(ComplianceQueryExportComponent, "Compliance Query & Export Component", "Rust", "Handles queries and exports audit bundles for Compliance Officers and Regulators.")
}

Rel(LedgerIngetionComponent, CryptographicSealerComponent, "Passes payloads for cryptographic batching and sealing")
Rel(CryptographicSealerComponent, StorageExportComponent, "Sends sealed Merkle blocks and metadata")
Rel(ComplianceQueryExportComponent, StorageExportComponent, "Queries stored ledger data for audit bundles")

@enduml