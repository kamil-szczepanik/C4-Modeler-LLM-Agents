@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(fraud_scoring_engine, "Fraud Scoring Engine") {
    Component(Scoring_API_Controller, "Scoring API Controller", "Java / Quarkus", "Receives incoming gRPC scoring requests from the API Gateway.")
    Component(Feature_Lookup_Module, "Feature Lookup Module", "Java / Quarkus", "Performs feature lookups against Amazon Redis.")
    Component(Inference_Execution_Engine, "Inference Execution Engine", "ONNX Runtime", "Executes machine learning models locally without network hops.")
    Component(Audit_Dispatcher, "Audit Dispatcher", "Java / Quarkus gRPC Client", "Emits signed audit payloads to the Audit & Compliance Ledger.")
    Component(Event_Publisher, "Event Publisher", "Java / Quarkus Event Stream Client", "Feeds review decisions and risk factor summaries to the Case Management Service.")
}

Rel(Scoring_API_Controller, Feature_Lookup_Module, "Fetches user and transaction features", "")
Rel(Feature_Lookup_Module, Inference_Execution_Engine, "Supplies feature data for prediction", "")
Rel(Inference_Execution_Engine, Audit_Dispatcher, "Passes scoring results for audit logging", "")
Rel(Inference_Execution_Engine, Event_Publisher, "Sends final decisions and risk summaries", "")

@enduml