@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(analytics_export_stream, "Analytics Export Stream") {
    Component(LocalAnonymizerSidecar, "Local Anonymizer Sidecar", "Rust / Go", "Performs zero-allocation PII scrubbing and anonymization of metrics and schema payloads.")
    Component(AWSKinesisFirehoseClient, "AWS Kinesis Firehose Client", "Rust / Go with AWS SDK", "Batch uploads anonymized metrics and payloads securely to the data lake.")
}

Rel(LocalAnonymizerSidecar, AWSKinesisFirehoseClient, "Passes scrubbed and anonymized payloads")
@enduml