@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalystRiskOfficer, "Fraud Analyst & Risk Officer", "Internal actors who manage cases and review suspicious transactions.")
System_Ext(PaymentGatewayCoreProcessingPlatform, "Payment Gateway / Core Processing Platform", "Upstream external system that submits payment authorization requests.")
System_Ext(IdentityPoviderIdP, "Identity Provider (IdP)", "External authentication provider for user authentication.")
System_Ext(SIEMComplianceArchive, "SIEM / Compliance Archive", "External storage sink for compliance and audit logs.")
System(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System", "Screens card-not-present payment authorizations for a mid-size payment processor and provides case management for suspicious payments.")

Rel(PaymentGatewayCoreProcessingPlatform, RealTimePaymentFraudScreeningSystem, "Submits authorization requests", "gRPC over mTLS")
Rel(FraudAnalystRiskOfficer, RealTimePaymentFraudScreeningSystem, "Manages cases and reviews transactions", "HTTPS over TLS 1.3 / AWS WAF")
Rel(IdentityPoviderIdP, RealTimePaymentFraudScreeningSystem, "Authenticates users", "OIDC / OAuth2")
Rel(RealTimePaymentFraudScreeningSystem, SIEMComplianceArchive, "Exports compliance and audit logs asynchronously", "AWS EventBridge / Kinesis")

@enduml