@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("real_time_scoring_engine", "Real-Time Scoring Engine") {
    Component(ScoringOrchestrator, "Scoring Orchestrator", "Go", "Coordinates feature fetch, model execution, rule evaluation, and audit telemetry.")
    Component(FeatureAssembler, "Feature Assembler", "Go", "Retrieves features needed for transaction scoring.")
    Component(InferenceExecutor, "Inference Executor", "ONNX Runtime / CGO", "Executes the machine learning model for fraud scoring.")
    Component(ModelHotLoader, "Model Hot-Loader", "Go", "Dynamically loads and updates machine learning models without downtime.")
    Component(RuleEvaluator, "Rule Evaluator", "Go", "Evaluates business overrides and rules.")
    Component(AuditTelemetryEmitter, "Audit Telemetry Emitter", "Go", "Enqueues and publishes audit logs and telemetry events.")
}

Rel(ScoringOrchestrator, FeatureAssembler, "Coordinates feature fetch", "In-memory Go function call")
Rel(ScoringOrchestrator, InferenceExecutor, "Executes model", "In-memory CGO/ONNX")
Rel(ScoringOrchestrator, RuleEvaluator, "Evaluates overrides", "In-memory")
Rel(ScoringOrchestrator, AuditTelemetryEmitter, "Enqueues audit log", "Local channel / ring buffer")

@enduml