@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(redis_elasticache, "Redis (ElastiCache)") {
    Component(Feature_Cache, "Feature Cache", "Redis Hash and String Data Structures", "Caches low-latency features and behavioral data using volatile-lru eviction policy.")
    Component(Snapshot_Exporter, "Snapshot Exporter", "AWS ElastiCache RDB Export", "Exports automated daily RDB snapshots to AWS S3.")
}

Rel(Feature_Cache, Snapshot_Exporter, "Triggers automated daily backups", "")

@enduml