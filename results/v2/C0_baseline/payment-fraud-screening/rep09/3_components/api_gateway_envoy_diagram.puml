@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway (Envoy)") {
    Component(mtls_termination_and_routing, "mTLS Termination and Routing", "Envoy C++", "Handles mTLS termination, local rate limiting, and circuit breaking for incoming traffic.")
    Component(grpc_proxy, "gRPC Proxy", "Envoy HTTP/2", "Forwards scoring requests to the Real-Time Scoring Engine via gRPC/HTTP2.")
    Component(https_proxy, "HTTPS Proxy", "Envoy HTTPS", "Routes administrative and analyst traffic to the Case Management Backend.")
}

Rel(mtls_termination_and_routing, grpc_proxy, "Forwards payment scoring requests", "gRPC/HTTP2")
Rel(mtls_termination_and_routing, https_proxy, "Forwards analyst traffic", "HTTPS")
@enduml