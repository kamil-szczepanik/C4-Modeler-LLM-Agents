@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit Log Worker container

Container_Boundary(audit_log_worker, "Audit Log Worker") {
    Component(SQS Message Consumer, "SQS Message Consumer", "Go, AWS SDK", "Polls Amazon SQS for asynchronous decision and audit events.")
    Component(Log Canonicalizer and Hash Chainer, "Log Canonicalizer and Hash Chainer", "Go, AWS KMS", "Canonically formats audit logs and applies cryptographic SHA-256 hash chaining using AWS KMS for tamper-evident verification.")
    Component(Database Persistence Worker, "Database Persistence Worker", "Go, PostgreSQL Wire Protocol", "Persists canonicalized, hash-chained logs into append-only partitioned tables in AWS Aurora PostgreSQL.")
    Component(SIEM Exporter and Spooler, "SIEM Exporter and Spooler", "Go, HTTPS, Local Disk", "Batches audit logs, provides local disk spooling for reliability, and forwards logs to the SIEM / Compliance Archive.")
}

Rel(SQS Message Consumer, Log Canonicalizer and Hash Chainer, "Passes raw asynchronous audit and decision events for processing", "In-memory")
Rel(Log Canonicalizer and Hash Chainer, Database Persistence Worker, "Sends processed, hash-chained logs for database insertion", "In-memory")
Rel(Database Persistence Worker, SIEM Exporter and Spooler, "Triggers batched export of audit logs", "In-memory")
@enduml