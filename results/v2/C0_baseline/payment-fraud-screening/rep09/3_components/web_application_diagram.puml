@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application container

Container_Boundary(web_application, "Web Application") {
    Component(Case_Triage_Dashboard, "Case Triage Dashboard", "React SPA, Tailwind CSS", "Frontend interface for human users managing cases.")
    Component(Rule_Authoring_Studio, "Rule Authoring Studio", "React SPA, Tailwind CSS", "Frontend interface for managing rules.")
    Component(Audit_Compliance_Viewer, "Audit & Compliance Viewer", "React SPA, Tailwind CSS", "Frontend interface for viewing audit logs and compliance data.")
}

System_Ext(API_Gateway_Envoy, "API Gateway (Envoy)", "Entry point handling routing, security enforcement, and token management.")

Rel(Case_Triage_Dashboard, API_Gateway_Envoy, "Sends API requests", "REST/GraphQL over HTTPS")
Rel(Rule_Authoring_Studio, API_Gateway_Envoy, "Sends API requests", "REST/GraphQL over HTTPS")
Rel(Audit_Compliance_Viewer, API_Gateway_Envoy, "Sends API requests", "REST/GraphQL over HTTPS")

@enduml