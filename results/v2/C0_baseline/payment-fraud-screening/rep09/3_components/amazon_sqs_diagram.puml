@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon SQS container

Container_Boundary(amazon_sqs, "Amazon SQS") {
    Component(fraud_audit_events_queue, "fraud-audit-events-queue", "Amazon SQS Standard Queue", "Decouples scoring from audit logging to protect P99 latency and buffer audit events.")
    Component(fraud_audit_events_dlq, "fraud-audit-events-dlq", "Amazon SQS Dead Letter Queue", "Captures and stores undeliverable or failed audit events for troubleshooting and compliance.")
}

Rel(fraud_audit_events_queue, fraud_audit_events_dlq, "Routes permanently failed messages after max retries")

@enduml