@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Real-Time Payment Fraud Screening

Person(Fraud_Analysts___Risk_Managers, "Fraud Analysts & Risk Managers", "Internal users reviewing suspicious payments and updating models.")
System_Ext(Payment_Gateway___Merchants, "Payment Gateway / Merchants", "External API clients submitting authorization requests.")
System_Ext(Identity_Provider, "Identity Provider", "AWS Cognito / Okta providing OIDC/OAuth2 authentication.")
System_Ext(BI___Analytics_Tool, "BI / Analytics Tool", "Amazon QuickSight for aggregated metric reporting via isolated data pipelines.")
System(Real_Time_Payment_Fraud_Screening, "Real-Time Payment Fraud Screening", "Real-Time Payment Fraud Screening system providing instant sub-50ms risk scoring for card-not-present transactions and case management for fraud analysts, ensuring PCI-DSS Level 1 compliance and 7-year tamper-evident auditability.")

Rel(Payment_Gateway___Merchants, Real_Time_Payment_Fraud_Screening, "Submits real-time scoring requests for card-not-present transactions", "Synchronous gRPC/REST over mTLS")
Rel(Fraud_Analysts___Risk_Managers, Real_Time_Payment_Fraud_Screening, "Reviews suspicious payments and manages cases", "HTTPS (TLS 1.3) with MFA and RBAC/ABAC")
Rel(Real_Time_Payment_Fraud_Screening, Identity_Provider, "Authenticates users via OIDC/OAuth2", "HTTPS / OIDC")
Rel(Real_Time_Payment_Fraud_Screening, BI___Analytics_Tool, "Sends pseudonymized data for aggregated metric reporting", "Asynchronous data pipeline (AWS DMS / S3 triggers)")
@enduml