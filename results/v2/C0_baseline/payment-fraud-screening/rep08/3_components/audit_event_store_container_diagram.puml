@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Audit_Event_Store_Container", "Audit & Event Store Container") {
    Component(Audit_Event_Ingestion_Service, "Audit Event Ingestion Service", "Node.js / AWS SDK", "Processes audit events from the Messaging Backbone and records them.")
    Component(Audit_Query_API, "Audit Query API", "Node.js / REST API", "Exposes endpoints for compliance officers and external auditors to query historical decisions and export reports.")
    Component(Audit_Storage_Manager, "Audit Storage Manager", "Amazon DynamoDB & Amazon S3 with Object Lock", "Manages 7-year tamper-evident immutable storage and real-time event capture.")
}

Rel(Audit_Event_Ingestion_Service, Audit_Storage_Manager, "Writes audit logs and events", "AWS SDK (DynamoDB API)")
Rel(Audit_Query_API, Audit_Storage_Manager, "Queries historical decisions and exports reports", "REST API / HTTPS")
@enduml