@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Messaging Backbone container

Container_Ext(Scoring Engine Container, "Scoring Engine Container", "Go / Rust on AWS Fargate Spot", "Scoring engine processing authorization requests.")
Container_Ext(Case Management Container, "Case Management Container", "Node.js / React SPA backend", "Manages fraud analyst reviews.")

Container_Boundary(messaging_backbone, "Messaging Backbone") {
    Component(SNS Audit Topic, "SNS Audit Topic", "Amazon SNS", "Publishes asynchronous audit events from the scoring engine.")
    Component(SQS Review Queue, "SQS Review Queue", "Amazon SQS", "Routes suspicious payments for review to the case management container.")
}

Rel(Scoring Engine Container, SNS Audit Topic, "Publishes audit events asynchronously", "HTTPS (SNS)")
Rel(Scoring Engine Container, SQS Review Queue, "Routes suspicious payments for review", "HTTPS (SQS)")
Rel(Case Management Container, SQS Review Queue, "Consumes and processes review cases", "HTTPS (SQS)")

@enduml