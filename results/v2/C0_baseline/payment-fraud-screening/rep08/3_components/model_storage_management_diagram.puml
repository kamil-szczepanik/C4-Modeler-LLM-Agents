@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Model Storage & Management container

Container_Boundary(model_storage_management, "Model Storage & Management") {
    Component(Model Registry, "Model Registry", "Amazon S3 with Object Lock in Compliance Mode", "Stores immutable model binaries ensuring write-once immutability for 7-year audit compliance.")
    Component(Model Metadata Store, "Model Metadata Store", "Amazon DynamoDB", "Maintains atomic state tracking and model metadata for zero-downtime model promotion.")
    Component(Model Validation Function, "Model Validation Function", "AWS Lambda", "Automates schema validation, baseline checks, and updates deployment states.")
    Component(Model Sync Agent, "Model Sync Agent", "Background thread within Scoring Engine", "Polls active model pointers and fetches immutable model binaries into local memory.")
    Component(Security & Secrets, "Security & Secrets", "AWS Secrets Manager & AWS KMS Customer Managed Keys", "Encrypts model artifacts and metadata with strict IAM role bindings.")
}

Rel(Model Validation Function, Model Registry, "Validates and stores binaries", "HTTPS via AWS PrivateLink")
Rel(Model Validation Function, Model Metadata Store, "Updates deployment state", "HTTPS via AWS PrivateLink")
Rel(Model Sync Agent, Model Metadata Store, "Polls active model pointers", "HTTPS via AWS PrivateLink")
Rel(Model Sync Agent, Model Registry, "Fetches immutable model binaries into local memory", "HTTPS via VPC Gateway Endpoints")
@enduml