@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway & Routing Layer container

Person(Payment_Gateway_Merchants, "Payment Gateway / Merchants", "External payment gateways and merchants submitting payment authorizations.")
System_Ext(Scoring_Engine_Container, "Scoring Engine Container", "Go or Rust on AWS Fargate Spot")

Container_Boundary(api_gateway_routing_layer, "API Gateway & Routing Layer") {
    Component(AWS_WAF_Edge_Terminator, "AWS WAF / Edge Terminator", "AWS WAF", "Provides edge termination and security filtering for incoming traffic.")
    Component(API_Gateway_Authorizer, "API Gateway Authorizer", "AWS API Gateway", "Validates incoming payment authorization requests and integrates with AWS WAF.")
    Component(Routing_Circuit_Breaker_Proxy, "Routing & Circuit Breaker Proxy", "AWS API Gateway Routing Proxy", "Routes validated requests to backend scoring engines and implements circuit breaking.")
}

Rel(Payment_Gateway_Merchants, API_Gateway_Authorizer, "Submits payment authorizations", "HTTPS (REST/JSON)")
Rel(API_Gateway_Authorizer, Routing_Circuit_Breaker_Proxy, "Transmits validated requests", "Internal TLS / HTTP/2")
Rel(Routing_Circuit_Breaker_Proxy, Scoring_Engine_Container, "Routes scoring requests", "gRPC with mTLS")

@enduml