@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management Container container

Person(Fraud Analysts & Risk Managers, "Fraud Analysts & Risk Managers", "Reviews cases and manages fraud workflow")
System_Ext(Aurora Serverless v2 (PostgreSQL), "Aurora Serverless v2 (PostgreSQL)", "Encrypted state persistence")
System_Ext(Messaging Backbone, "Messaging Backbone", "Publishes case resolution events")
System_Ext(Audit & Event Store Container, "Audit & Event Store Container", "Emits signed state-change audit logs")

Container_Boundary("Case Management Container", "Case Management Container") {
    Component(Case API Service, "Case API Service", "Node.js/Express", "Exposes case management APIs and handles fraud workflow integration.")
    Component(Case Workflow Controller, "Case Workflow Controller", "Node.js", "Manages case states and workflow transitions.")
    Component(Data Access Repository, "Data Access Repository", "TypeScript/Prisma", "Provides type-safe database access and persists relational case histories.")
    Component(Masking & Tokenization Service, "Masking & Tokenization Service", "Node.js utility", "Strips and masks sensitive PAN data to maintain compliance.")
}

Rel(Fraud Analysts & Risk Managers, Case API Service, "Reviews cases and manages fraud workflow", "HTTPS (OAuth2/OIDC, JSON)")
Rel(Case API Service, Masking & Tokenization Service, "Strips/masks sensitive PAN data", "In-process function call")
Rel(Case API Service, Data Access Repository, "Reads/writes case state", "Prisma Client over TCP/TLS 1.3")
Rel(Data Access Repository, Aurora Serverless v2 (PostgreSQL), "Encrypted state persistence", "TCP/TLS (Prisma, pgcrypto)")
Rel(Case Workflow Controller, Messaging Backbone, "Publishes case resolution events", "AWS SDK (SNS/SQS)")
Rel(Case Workflow Controller, Audit & Event Store Container, "Emits signed state-change audit logs", "AWS SDK (DynamoDB API)")
@enduml