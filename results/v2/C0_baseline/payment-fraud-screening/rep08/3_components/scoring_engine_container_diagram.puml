@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Scoring Engine Container container

Container_Boundary(scoring_engine_container, "Scoring Engine Container") {
    Component(Inbound_API_Handler, "Inbound API Handler", "Go or Rust", "Handles incoming routing requests and API validation.")
    Component(Feature_Assembler, "Feature Assembler", "Go or Rust", "Performs profile lookups and assembles features for scoring.")
    Component(Execution_Core, "Execution Core", "Wasmtime (WebAssembly)", "Executes compiled scoring models securely within a metered runtime sandbox.")
    Component(Audit_Publisher, "Audit Publisher", "Go or Rust", "Dispatches signed audit payloads via non-blocking channels and SQS.")
}

Rel(Inbound_API_Handler, Feature_Assembler, "Forwards requests to assemble required features", "In-memory")
Rel(Feature_Assembler, Execution_Core, "Provides assembled features to scoring models", "In-memory")
Rel(Execution_Core, Audit_Publisher, "Triggers audit event generation upon scoring completion", "In-memory")

@enduml