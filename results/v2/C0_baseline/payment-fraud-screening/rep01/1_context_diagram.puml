@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalyst, "Fraud Analyst", "Human persona managing suspicious payments and reviewing flagged cases.")
System_Ext(MerchantPaymentGateway, "Merchant / Payment Gateway", "External system submitting payment authorizations.")
System_Ext(AWSKMSS3ObjectLock, "AWS KMS / S3 Object Lock", "Infrastructure providing WORM storage and encryption.")
System_Ext(IdentityPoviderIdP, "Identity Provider (IdP)", "External system managing OIDC/SAML authentication.")
System(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System", "Evaluates card-not-present payment authorizations for fraud at 3,000 TPS while supporting analyst reviews, ensuring strict PCI-DSS Level 1 compliance and 7-year tamper-evident auditability within a €25k monthly AWS budget.")

Rel(MerchantPaymentGateway, RealTimePaymentFraudScreeningSystem, "Submits auth requests", "gRPC over TLS 1.3 (<50ms P99)")
Rel(FraudAnalyst, RealTimePaymentFraudScreeningSystem, "Reviews flagged cases", "HTTPS/TLS with OIDC/SAML MFA")
Rel(RealTimePaymentFraudScreeningSystem, AWSKMSS3ObjectLock, "Persists tamper-evident decisions", "AWS SDK and IAM via AWS KMS")
@enduml