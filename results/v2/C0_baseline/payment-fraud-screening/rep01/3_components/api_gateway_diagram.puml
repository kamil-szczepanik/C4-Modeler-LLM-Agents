@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(aws_api_gateway_http_apis, "AWS API Gateway (HTTP APIs)", "AWS API Gateway", "Edge routing, schema validation, and rate limiting within budget, handling inbound payment authorizations.")
    Component(aws_waf, "AWS WAF", "AWS WAF", "Inspects inbound traffic for threats and provides edge protection against DDoS and injection attacks.")
    Component(edge_tokenizer_lambda_component, "Edge Tokenizer Lambda Component", "AWS Lambda (Go)", "High-performance edge tokenization for inbound payloads.")
}

Rel(aws_api_gateway_http_apis, aws_waf, "Inspects inbound traffic for threats", "AWS WAF Integration")
Rel(aws_api_gateway_http_apis, edge_tokenizer_lambda_component, "Processes and tokenizes inbound payment authorizations")
@enduml