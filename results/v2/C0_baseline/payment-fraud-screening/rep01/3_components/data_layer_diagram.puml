@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Data Layer container

System_Ext(ScoringEngine, "Scoring Engine", "External component providing scoring logic.")
System_Ext(CaseManagement, "Case Management", "External component managing analyst cases.")

Container_Boundary(DataLayer, "Data Layer") {
    Component(TransactionalStore, "Transactional Store", "Amazon Aurora Serverless v2 PostgreSQL", "Manages ACID-compliant relational data, analyst cases, and reviews.")
    Component(FeatureStore, "Feature Store", "Amazon ElastiCache Serverless (Redis)", "Provides sub-5ms real-time velocity features for the scoring engine.")
    Component(AuditIngestionQueue, "Audit Ingestion Queue", "Amazon SQS with Dead Letter Queue (DLQ)", "Decouples synchronous scoring from database writes for decision audit payloads.")
    Component(ComplianceStorage, "Compliance Storage", "Amazon S3 Object Lock", "Streams audit logs for tamper-evident 7-year retention.")
}

Rel(ScoringEngine, FeatureStore, "Reads velocity features", "RESP, <5ms")
Rel(ScoringEngine, AuditIngestionQueue, "Enqueues decision audit payloads", "AWS SDK, HTTP/S")
Rel(CaseManagement, TransactionalStore, "Reads and writes analyst cases and reviews", "PostgreSQL Wire Protocol, TLS 1.3")
Rel(TransactionalStore, ComplianceStorage, "Streams audit logs for tamper-evident 7-year retention", "HTTPS")

@enduml