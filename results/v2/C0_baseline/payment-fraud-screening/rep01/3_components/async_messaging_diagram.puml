@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Async Messaging container

Container_Boundary(async_messaging, "Async Messaging") {
    Component(SQS_FIFO_Queue, "SQS FIFO Queue", "Amazon SQS FIFO", "High-throughput message queue with message group IDs for ordered, exactly-once audit event processing.")
    Component(Dead_Letter_Queue, "Dead-Letter Queue", "Amazon SQS DLQ", "Captures unprocessable messages for failure analysis and isolation.")
    Component(VPC_Interface_Endpoint, "VPC Interface Endpoint", "AWS VPC Interface Endpoint", "Secures internal communication with the messaging service.")
}

Rel(SQS_FIFO_Queue, Dead_Letter_Queue, "Forwards failed messages")
Rel(VPC_Interface_Endpoint, SQS_FIFO_Queue, "Routes private network traffic")
@enduml