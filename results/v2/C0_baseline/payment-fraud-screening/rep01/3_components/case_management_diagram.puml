@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(case_management, "Case Management") {
    Component(Analyst_SPA, "Analyst SPA", "React hosted in S3 and served via Amazon CloudFront", "Lightweight frontend SPA for rapid analyst workflows.")
    Component(API_Router_Auth_Component, "API Router & Auth Component", "Express.js", "Manages cases, submits overrides, and injects secrets at startup.")
    Component(Case_Workflow_Engine_with_Prioritization_Queue, "Case Workflow Engine with Prioritization Queue", "Node.js", "Processes state transitions and prioritizes queues.")
    Component(Audit_Logger_Component_with_AWS_KMS_integration, "Audit Logger Component with AWS KMS integration", "Node.js", "Triggers audit events for analyst actions and generates cryptographic signatures.")
}

Rel(Analyst_SPA, API_Router_Auth_Component, "Manages cases and submits overrides", "HTTPS/REST with OAuth2/OIDC JWT")
Rel(API_Router_Auth_Component, Case_Workflow_Engine_with_Prioritization_Queue, "Processes state transitions and prioritizes queues", "In-memory function calls")
Rel(Case_Workflow_Engine_with_Prioritization_Queue, Audit_Logger_Component_with_AWS_KMS_integration, "Triggers audit events for analyst actions", "In-memory function calls")

@enduml