@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Observability container

Container_Boundary(observability, "Observability") {
    Component(AWS X-Ray, "AWS X-Ray", "AWS X-Ray SDK", "Delivers distributed tracing and telemetry data for system operations.")
    Component(Amazon CloudWatch, "Amazon CloudWatch", "CloudWatch Agent", "Collects infrastructure metrics and logs, powering the Fraud Operations View.")
    Component(Amazon SNS, "Amazon SNS", "AWS SNS", "Sends notifications and alerts regarding system status and security events.")
    Component(S3 Object Lock, "S3 Object Lock", "AWS S3 API / WORM Storage", "Exports and securely stores tamper-evident audit logs for 7-year retention.")
}

Rel(AWS X-Ray, Amazon CloudWatch, "Sends traces and sanitized telemetry")
Rel(Amazon CloudWatch, Amazon SNS, "Triggers alerts based on metrics and logs")
Rel(Amazon CloudWatch, S3 Object Lock, "Exports audit logs for tamper-evident 7-year storage", "AWS S3 API / TLS 1.3")

@enduml