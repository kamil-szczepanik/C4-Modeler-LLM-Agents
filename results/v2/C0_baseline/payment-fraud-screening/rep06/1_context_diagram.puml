@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

System(FraudScreeningEngine, "Fraud Screening Engine", "Processes real-time card-not-present payment authorizations in AWS for fraud screening, provides an analyst review interface, delivers sub-50ms fraud decisions while maintaining PCI-DSS Level 1 compliance and 7-year tamper-evident auditability.")

System_Ext(PaymentGatewayAcquirer, "Payment Gateway / Acquirer", "External system sending transaction requests.")
System_Ext(TokenizationVault, "Tokenization Vault", "External system resolving card tokens for secure data handling.")
System_Ext(IdentityPoviderIdP, "Identity Provider (IdP)", "External system managing OIDC/SAML authentication and MFA.")
System_Ext(WORMComplianceStorage, "WORM Compliance Storage", "External AWS S3 storage for 7-year audit logs.")

Rel(PaymentGatewayAcquirer, FraudScreeningEngine, "Sends real-time payment events", "HTTPS/gRPC with mTLS")
Rel(FraudScreeningEngine, TokenizationVault, "Resolves tokens", "HTTPS REST API")
Rel(FraudScreeningEngine, IdentityPoviderIdP, "Authenticates analysts", "OIDC/SAML")
Rel(FraudScreeningEngine, WORMComplianceStorage, "Sends cryptographically signed decision logs", "AWS S3 APIs")

@enduml