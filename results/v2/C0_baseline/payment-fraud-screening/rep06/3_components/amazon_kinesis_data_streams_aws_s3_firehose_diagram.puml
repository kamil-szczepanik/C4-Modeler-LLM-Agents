@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Amazon Kinesis Data Streams & AWS S3 Firehose", "Amazon Kinesis Data Streams & AWS S3 Firehose") {
    Component("Kinesis Data Stream", "Kinesis Data Stream", "Amazon Kinesis Data Streams", "Ingests and buffers real-time audit logs streamed from the Fraud Screening Engine.")
    Component("S3 Firehose Delivery Stream", "S3 Firehose Delivery Stream", "AWS S3 Firehose", "Buffers and forwards audit records from the data stream to persistent WORM storage.")
}

Rel("Kinesis Data Stream", "S3 Firehose Delivery Stream", "Buffers and forwards records", "AWS internal protocol")

@enduml