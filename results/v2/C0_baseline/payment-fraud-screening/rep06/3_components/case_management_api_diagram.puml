@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(case_management_api, "Case Management API") {
    Component(case_controller, "Case Controller", "Node.js / TypeScript", "Handles incoming HTTP requests from Fraud Analysts and manages alert reviews.")
    Component(case_workflow_service, "Case Workflow Service", "Node.js / TypeScript", "Implements business logic for managing case states and workflows.")
    Component(note_tagging_service, "Note & Tagging Service", "Node.js / TypeScript", "Manages analyst tags and case annotations, emitting events asynchronously.")
    Component(audit_compliance_logger, "Audit & Compliance Logger", "Node.js / TypeScript", "Prepares cryptographically signed audit payloads for compliance storage.")
    Component(data_access_repository, "Data Access Repository", "Node.js / TypeScript / AWS SDK", "Persists and retrieves active cases and data from Amazon DynamoDB.")
}

Rel(case_controller, case_workflow_service, "Delegates case management operations")
Rel(case_workflow_service, note_tagging_service, "Updates tags and annotations")
Rel(case_workflow_service, data_access_repository, "Persists and retrieves case state")
Rel(note_tagging_service, audit_compliance_logger, "Sends audit events for logging")
@enduml