@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS API Gateway / ALB container

Container_Boundary(aws_api_gateway_alb, "AWS API Gateway / ALB") {
    Component(Perimeter Security & mTLS Terminator, "Perimeter Security & mTLS Terminator", "AWS WAF v2 & ALB", "Handles perimeter security, mTLS termination, and JWT validation for low latency.")
    Component(Routing and Dispatcher, "Routing and Dispatcher", "AWS API Gateway", "Routes pre-tokenized authorization requests from the payment gateway to backend containers.")
}

Rel(Perimeter Security & mTLS Terminator, Routing and Dispatcher, "Forwards validated requests")

@enduml