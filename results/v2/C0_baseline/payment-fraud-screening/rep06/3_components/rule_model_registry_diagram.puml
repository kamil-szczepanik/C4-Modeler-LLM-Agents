@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(rule_model_registry, "Rule & Model Registry") {
    Component(Registry_API, "Registry API", "AWS Lambda / Python FastAPI", "Administrative REST interface for model uploads, schema validation, and RBAC.")
    Component(Amazon_S3, "Amazon S3", "Amazon S3", "Immutable binary artifact storage for models and rules (.onnx / .json).")
    Component(Amazon_DynamoDB, "Amazon DynamoDB", "Amazon DynamoDB", "Stores version tags, access controls, and audit logs with KMS encryption.")
}

Rel(Registry_API, Amazon_S3, "Persists immutable binary model files and rule definitions via AWS SDK.", "AWS SDK")
Rel(Registry_API, Amazon_DynamoDB, "Reads and writes version tags, access controls, and audit logs via AWS SDK.", "AWS SDK")

@enduml