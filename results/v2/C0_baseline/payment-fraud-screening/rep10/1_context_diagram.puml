@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Real-Time Payment Fraud Screening

Person(Manual_Analyst, "Manual Analyst", "Reviews flagged payment cases and handles manual fraud investigations.")

System(Real_Time_Payment_Fraud_Screening, "Real-Time Payment Fraud Screening", "Evaluates card-not-present payment authorizations for fraud at scale while enabling manual analyst reviews, ensuring low-latency decisions, strict PCI-DSS compliance, and tamper-evident auditing.")

System_Ext(Payment_Gateway_Acquirer_Systems, "Payment Gateway / Acquirer Systems", "Sends payment authorization requests to be evaluated for fraud.")
System_Ext(Third_Party_Fraud_Intelligence_Feeds, "Third-Party Fraud Intelligence Feeds", "Provides external fraud intelligence data used by the scoring engine.")
System_Ext(Case_Management_SaaS, "Case Management SaaS", "Manages manual review workflows and cases for analysts.")
System_Ext(Identity_Provider_AWS_Cognito_Okta, "Identity Provider (AWS Cognito / Okta)", "Handles user authentication and identity management.")
System_Ext(Decision_Audit_Store_AWS_S3_Object_Lock_AWS_KMS, "Decision Audit Store (AWS S3 Object Lock & AWS KMS)", "Provides tamper-evident, write-once-read-many storage for audit logs.")

Rel(Payment_Gateway_Acquirer_Systems, Real_Time_Payment_Fraud_Screening, "Sends payment authorizations for real-time fraud evaluation", "gRPC/HTTPS")
Rel(Real_Time_Payment_Fraud_Screening, Third_Party_Fraud_Intelligence_Feeds, "Queries external threat intelligence", "HTTPS")
Rel(Real_Time_Payment_Fraud_Screening, Case_Management_SaaS, "Sends fraud cases for manual review", "secure REST APIs/Webhooks")
Rel(Real_Time_Payment_Fraud_Screening, Decision_Audit_Store_AWS_S3_Object_Lock_AWS_KMS, "Streams cryptographically signed decision logs asynchronously", "AWS KMS signing / Asynchronous log streaming")
Rel(Manual_Analyst, Case_Management_SaaS, "Reviews and manages fraud cases", "HTTPS")

@enduml