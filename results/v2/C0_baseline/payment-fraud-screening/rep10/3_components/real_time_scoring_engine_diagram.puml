@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(real_time_scoring_engine, "Real-Time Scoring Engine") {
    Component(Rule_Evaluation_Component, "Rule Evaluation Component", "Go + expr-lang/expr", "Lightweight evaluation engine for fast in-memory fraud rule execution.")
    Component(ML_Inference_Component, "ML Inference Component", "ONNX Runtime C++ bindings wrapped in Go", "Optimized machine learning inference engine for fast model execution.")
    Component(Decision_Orchestrator_Component, "Decision Orchestrator Component", "Go", "Orchestrates rule evaluation and ML inference to produce the final payment screening decision.")
    Component(Rule_Compiler_Validator_Component, "Rule Compiler & Validator Component", "Go", "Validates and compiles rules before hot-reloading.")
}

Rel(Decision_Orchestrator_Component, Rule_Evaluation_Component, "Evaluates transaction payloads against fraud rules")
Rel(Decision_Orchestrator_Component, ML_Inference_Component, "Invokes model inference for risk scoring")
Rel(Rule_Compiler_Validator_Component, Rule_Evaluation_Component, "Provides compiled and validated rules")

@enduml