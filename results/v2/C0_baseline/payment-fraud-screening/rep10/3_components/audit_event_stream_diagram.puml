@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Audit_Event_Stream", "Audit & Event Stream") {
    Component(Event_Ingestion_Router, "Event Ingestion Router", "Amazon EventBridge", "Component routing schema-validated events with Dead Letter Queues to minimize operational overhead.")
    Component(Buffer_Batcher, "Buffer & Batcher", "Amazon Kinesis Data Firehose", "Component aggregating and compressing high-throughput events into Parquet batches.")
}

Rel(Event_Ingestion_Router, Buffer_Batcher, "Forwards filtered events via Kinesis Firehose direct integration over HTTPS.", "HTTPS")

@enduml