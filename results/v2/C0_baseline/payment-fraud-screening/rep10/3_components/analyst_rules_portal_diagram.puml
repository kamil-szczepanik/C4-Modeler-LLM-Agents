@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Manual_Analyst, "Manual Analyst", "Accesses the portal to review cases.")
Person(Merchant_Risk_Manager, "Merchant Risk Manager", "Accesses the portal to configure fraud rules and run simulations.")
System_Ext(Case_Management_Backend, "Case Management Backend", "Handles case data and management operations.")
System_Ext(Identity_Provider, "Identity Provider", "Handles authentication and identity management using OIDC/OAuth2.")

Container_Boundary(analyst_rules_portal, "Analyst & Rules Portal") {
    Component(SPA_Frontend_Core, "SPA Frontend Core", "React, TypeScript, AWS S3, CloudFront", "Lightweight SPA framework providing a secure React-based interface for analysts and risk managers.")
    Component(Case_Review_UI_Module, "Case Review UI Module", "React", "Module for analysts and risk managers to review suspicious payment cases.")
    Component(Rule_Authoring_Simulation_Module, "Rule Authoring & Simulation Module", "React, AWS SDK", "Module for configuring fraud rules and triggering simulations.")
    Component(Simulation_Results_Visualizer, "Simulation Results Visualizer", "Recharts, Chart.js", "Minimal bundle-size charting library for rendering simulation impact metrics.")
    Component(AWS_WAF_Amazon_SQS, "AWS WAF & Amazon SQS", "AWS WAF, Amazon SQS", "Edge security protecting authentication endpoints and asynchronous queue to decouple heavy rule-backtesting jobs.")
}

Rel(Manual_Analyst, SPA_Frontend_Core, "Accesses via HTTPS", "OIDC/OAuth2")
Rel(Merchant_Risk_Manager, SPA_Frontend_Core, "Accesses via HTTPS", "OIDC/OAuth2")
Rel(Rule_Authoring_Simulation_Module, AWS_WAF_Amazon_SQS, "Sends simulation jobs via JSON", "AWS SDK")
Rel(SPA_Frontend_Core, Case_Management_Backend, "Communicates via", "REST/HTTPS")
Rel(SPA_Frontend_Core, Identity_Provider, "Authenticates via", "OIDC/OAuth2 [PKCE flow]")
@enduml