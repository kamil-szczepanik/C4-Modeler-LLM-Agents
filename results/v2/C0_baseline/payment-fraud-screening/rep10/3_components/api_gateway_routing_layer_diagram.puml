@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway & Routing Layer container

System_Boundary(api_gateway_container, "API Gateway & Routing Layer") {
    Component(AWS ALB + AWS WAF, "AWS ALB + AWS WAF", "AWS ALB, AWS WAF, TLS 1.3", "Edge routing, TLS 1.3 termination, rate-limiting, DDoS protection, and PCI-DSS PAN masking.")
}

System_Ext(RealTime_Scoring_Engine, "Real-Time Scoring Engine", "AWS ECS Fargate")

Rel(AWS ALB + AWS WAF, RealTime_Scoring_Engine, "Routes authorization payloads for scoring", "gRPC / HTTP2 over AWS VPC private links")

@enduml