@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Real-Time Payment Fraud Screening Engine

Person(FraudAnalystsAndRiskManagers, "Fraud Analysts & Risk Managers", "Users who perform case management review and analyze fraud alerts.")

System_Ext(AmazonS3WithObjectLock, "Amazon S3 with Object Lock", "Storage service used for cost-effective, 7-year tamper-evident audit log storage.")
System_Ext(AWSKMS, "AWS KMS", "AWS Key Management Service for data encryption and envelope encryption.")
System_Ext(AWSSecretsManager, "AWS Secrets Manager", "Service used to securely store and retrieve runtime credentials.")

System_Boundary(RealTimePaymentFraudScreeningEngine, "Real-Time Payment Fraud Screening Engine") {
    Container(AmazonAPIGateway, "Amazon API Gateway", "Amazon API Gateway", "Provides ingress and WAF protection for incoming traffic.")
    Container(RealTimeScoringEngine, "Real-Time Scoring Engine", "Go microservice on AWS ECS EC2", "Processes card-not-present transactions for real-time fraud scoring.")
    Container(CaseManagementSystemFrontend, "Case Management System Frontend", "React SPA on S3 + CloudFront", "Provides the user interface for case management review capabilities.")
    Container(CaseManagementSystemAPI, "Case Management System API", "Node.js / Express API on ECS", "Provides backend APIs for case management operations.")
    Container(ComplianceReportingWorker, "Compliance Reporting Worker", "AWS Lambda", "Executes scheduled compliance reporting tasks.")
    ContainerDb(AmazonDynamoDB, "Amazon DynamoDB", "Amazon DynamoDB", "Stores feature data and case information for low-latency lookups.")
    Container(AmazonSQSKinesis, "Amazon SQS / Kinesis", "Amazon SQS / Amazon Kinesis", "Handles asynchronous event publishing and message buffering.")
    Container(AmazonCloudWatch, "Amazon CloudWatch", "Amazon CloudWatch", "Provides security monitoring, logging, and observability.")
}

Rel(FraudAnalystsAndRiskManagers, AmazonAPIGateway, "Accesses case management and review capabilities", "HTTPS / TLS 1.3")
Rel(AmazonAPIGateway, RealTimeScoringEngine, "Forwards payment transactions for fraud scoring", "Internal gRPC over mTLS")
Rel(RealTimeScoringEngine, AmazonDynamoDB, "Performs feature lookups and case data retrievals", "AWS SDK over TLS 1.3")
Rel(RealTimeScoringEngine, AmazonSQSKinesis, "Publishes asynchronous events", "AWS SDK over TLS 1.3")
Rel(ComplianceReportingWorker, AmazonS3WithObjectLock, "Stores tamper-evident audit logs", "HTTPS via AWS SDK")
Rel(RealTimeScoringEngine, AWSKMS, "Requests data encryption keys", "AWS SDK")
Rel(RealTimeScoringEngine, AWSSecretsManager, "Retrieves runtime credentials", "AWS SDK")
Rel(RealTimeScoringEngine, AmazonCloudWatch, "Sends logs and metrics", "AWS SDK")

@enduml