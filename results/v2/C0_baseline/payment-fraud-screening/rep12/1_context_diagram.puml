@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalystsAndRiskManagers, "Fraud Analysts and Risk Managers", "Users who perform case management and review fraud alerts.")
System_Ext(PaymentProcessorSystemsAcquirer, "Payment Processor Systems / Acquirer", "External systems that send payment authorizations for fraud evaluation.")
System_Ext(AWSKMS, "AWS KMS", "AWS Key Management Service for data encryption and envelope encryption.")
System_Ext(AmazonS3WithObjectLock, "Amazon S3 with Object Lock", "Storage service used for cost-effective, 7-year tamper-evident audit log storage.")

System(RealTimePaymentFraudScreeningEngine, "Real-Time Payment Fraud Screening Engine", "A real-time payment fraud screening engine that evaluates payment authorizations and provides case management for fraud analysts to prevent fraudulent transactions while maintaining strict latency and compliance standards.")

Rel(PaymentProcessorSystemsAcquirer, RealTimePaymentFraudScreeningEngine, "Sends payment authorizations for fraud screening", "gRPC over mTLS")
Rel(FraudAnalystsAndRiskManagers, RealTimePaymentFraudScreeningEngine, "Accesses case management and reviews alerts", "HTTPS over TLS 1.3")
Rel(RealTimePaymentFraudScreeningEngine, AWSKMS, "Requests data encryption keys for data-at-rest protection", "AWS SDK")
Rel(RealTimePaymentFraudScreeningEngine, AmazonS3WithObjectLock, "Stores tamper-evident audit logs", "AWS SDK")

@enduml