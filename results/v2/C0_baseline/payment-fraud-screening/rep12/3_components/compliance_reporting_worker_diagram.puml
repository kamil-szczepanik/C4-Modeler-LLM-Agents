@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Compliance Reporting Worker container

System_Ext(AmazonS3, "Amazon S3", "Storage", "Reads daily Parquet audit files")
System_Ext(AWSKMS, "AWS KMS", "Security", "Generates asymmetric cryptographic signatures (ECC_NIST_P256)")
System_Ext(AmazonS3ObjectLock, "Amazon S3 with Object Lock", "Storage", "Stores signed daily compliance digests with 7-year retention tags")
System_Ext(AmazonCloudWatch, "Amazon CloudWatch", "Management & Governance", "Emits operational metrics and logs")

Container_Boundary(ComplianceReportingWorkerContainer, "Compliance Reporting Worker") {
    Component(ComplianceReportingWorker, "Compliance Reporting Worker", "AWS Lambda in Python 3.11", "Serverless execution for generating daily Parquet audit files and compliance digests.")
}

Rel(ComplianceReportingWorker, AmazonS3, "Reads daily Parquet audit files", "AWS SDK / S3 GetObject")
Rel(ComplianceReportingWorker, AWSKMS, "Generates asymmetric cryptographic signatures (ECC_NIST_P256)", "AWS KMS Sign API")
Rel(ComplianceReportingWorker, AmazonS3ObjectLock, "Stores signed daily compliance digests with 7-year retention tags", "HTTPS / PutObject")
Rel(ComplianceReportingWorker, AmazonCloudWatch, "Emits operational metrics and logs", "AWS SDK / HTTPS")

@enduml