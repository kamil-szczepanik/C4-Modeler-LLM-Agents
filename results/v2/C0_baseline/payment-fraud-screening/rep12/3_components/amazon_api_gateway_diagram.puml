@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon API Gateway container

Container_Boundary(api_gateway, "Amazon API Gateway") {
    Component(HTTP_API_Router, "HTTP API Router", "Amazon API Gateway HTTP APIs", "Routes incoming payment authorization requests and analyst case management traffic with low latency.")
    Component(VPC_Link_Integration, "VPC Link Integration", "AWS PrivateLink / VPC Link", "Secures internal transit and proxies traffic to ECS containers via gRPC and HTTPS.")
}

Rel(HTTP_API_Router, VPC_Link_Integration, "Proxies payment transactions and analyst requests internally", "Internal transit / gRPC / HTTPS")

@enduml