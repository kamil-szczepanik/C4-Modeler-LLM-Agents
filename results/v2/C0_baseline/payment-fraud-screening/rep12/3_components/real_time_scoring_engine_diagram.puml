@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Real-Time Scoring Engine container

Container_Boundary(real_time_scoring_engine, "Real-Time Scoring Engine") {
    Component(API_Handler_Component, "API Handler Component", "Go (Gin)", "Receives forwarded payment transactions from Amazon API Gateway via internal gRPC over mTLS.")
    Component(Feature_Evaluator_Component, "Feature Evaluator Component", "Go Goroutines", "Performs feature lookups by querying Amazon DynamoDB.")
    Component(Rules_Engine_Core, "Rules Engine Core", "Go / WebAssembly (Wasm)", "Evaluates business rules and scoring models with secure sandboxing and hot-reloading.")
    Component(Audit_Logger_Component, "Audit Logger Component", "Go SDK", "Publishes signed decision payloads to Amazon SQS / Amazon Kinesis.")
    Component(Shadow_Evaluator_Component, "Shadow Evaluator Component", "Go Goroutines", "Runs shadow evaluations concurrently for model validation and testing.")
    Component(Model_Registry_Loader, "Model Registry Loader", "Go SDK", "Polls Amazon S3 for WebAssembly (Wasm) models.")
}

System_Ext(Amazon_API_Gateway, "Amazon API Gateway", "External API Gateway")
System_Ext(Amazon_DynamoDB, "Amazon DynamoDB", "NoSQL Database")
System_Ext(Amazon_SQS_Amazon_Kinesis, "Amazon SQS / Amazon Kinesis", "Messaging / Streaming Service")
System_Ext(Amazon_S3, "Amazon S3", "Object Storage")
System_Ext(AWS_KMS_Secrets_Manager, "AWS KMS & Secrets Manager", "Key Management and Secrets")
System_Ext(Amazon_CloudWatch, "Amazon CloudWatch", "Logging and Metrics")

Rel(Amazon_API_Gateway, API_Handler_Component, "Forwards payment transactions", "Internal gRPC over mTLS")
Rel(API_Handler_Component, Rules_Engine_Core, "Passes incoming transactions for real-time scoring", "")
Rel(Feature_Evaluator_Component, Amazon_DynamoDB, "Performs feature lookups", "AWS SDK over TLS 1.3")
Rel(Audit_Logger_Component, Amazon_SQS_Amazon_Kinesis, "Publishes signed decision payloads", "AWS SDK over TLS 1.3")
Rel(Model_Registry_Loader, Amazon_S3, "Polls for Wasm models", "AWS SDK over TLS 1.3")
Rel(real_time_scoring_engine, AWS_KMS_Secrets_Manager, "Requests keys and credentials", "AWS SDK over TLS 1.3")
Rel(real_time_scoring_engine, Amazon_CloudWatch, "Sends metrics and logs", "AWS SDK over TLS 1.3")

@enduml