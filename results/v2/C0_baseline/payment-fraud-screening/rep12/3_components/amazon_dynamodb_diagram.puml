@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_dynamodb, "Amazon DynamoDB") {
    Component(Hot_Feature_Table, "Hot Feature Table", "DynamoDB Table, NoSQL", "Provides single-digit millisecond latency for hot feature attributes.")
    Component(Case_Management_Table, "Case Management Table", "DynamoDB Table, NoSQL", "Stores and manages active case states and historical audit records.")
}

System_Ext(Compliance_Reporting_Worker, "Compliance Reporting Worker", "AWS Lambda")

Rel(Hot_Feature_Table, Compliance_Reporting_Worker, "Triggers archival of closed cases via DynamoDB Streams", "DynamoDB Streams")

@enduml