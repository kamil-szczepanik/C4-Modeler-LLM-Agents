@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Case Management System API, "Case Management System API", "Backend Services", "Amazon API Gateway / Case Management System API")

Container_Boundary("Case Management System Frontend", "Case Management System Frontend") {
    Component(Case Queue Component, "Case Queue Component", "React Component", "Displays and manages the queue of flagged cases for fraud analysts and risk managers.")
    Component(Transaction Details Component, "Transaction Details Component", "React Component", "Renders transaction details with strict data masking to ensure PCI-DSS compliance.")
    Component(Rule Management Component, "Rule Management Component", "React Component", "Enables zero-downtime rule updates for risk management.")
    Component(Audit Log Viewer Component, "Audit Log Viewer Component", "React Component", "Provides visibility into system and user audit logs.")
}

Rel(Case Queue Component, Case Management System API, "Fetches and updates case data using HTTPS / JSON REST API via React Query", "HTTPS / JSON")
Rel(Transaction Details Component, Case Management System API, "Retrieves transaction details using HTTPS / JSON REST API via React Query", "HTTPS / JSON")
Rel(Rule Management Component, Case Management System API, "Submits rule updates using HTTPS / JSON REST API via React Query", "HTTPS / JSON")
Rel(Audit Log Viewer Component, Case Management System API, "Retrieves audit logs using HTTPS / JSON REST API via React Query", "HTTPS / JSON")
@enduml