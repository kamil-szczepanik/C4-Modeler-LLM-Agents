@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_sqs_kinesis, "Amazon SQS / Kinesis") {
    Component(Standard_Queues, "Standard Queues", "Amazon SQS Standard", "Handles high-throughput asynchronous case and audit events from the Real-Time Scoring Engine.")
    Component(FIFO_Queues, "FIFO Queues", "Amazon SQS FIFO", "Ensures strict audit sequencing for compliance and reporting workflows.")
    Component(Dead_Letter_Queues, "Dead-Letter Queues", "Amazon SQS DLQ", "Captures failed messages for robust fail-open resilience and troubleshooting.")
}

System_Ext(Real_Time_Scoring_Engine, "Real-Time Scoring Engine", "Go microservice on AWS ECS EC2")
System_Ext(Compliance_Reporting_Worker, "Compliance Reporting Worker", "AWS Lambda")

Rel(Real_Time_Scoring_Engine, Standard_Queues, "Publishes asynchronous case and audit events", "AWS SDK over TLS 1.3")
Rel(Standard_Queues, FIFO_Queues, "Routes ordered events for compliance tracking", "")
Rel(FIFO_Queues, Compliance_Reporting_Worker, "Invokes processing", "AWS Lambda event source mapping")
Rel(Standard_Queues, Dead_Letter_Queues, "Offloads unprocessed or failed messages", "")
@enduml