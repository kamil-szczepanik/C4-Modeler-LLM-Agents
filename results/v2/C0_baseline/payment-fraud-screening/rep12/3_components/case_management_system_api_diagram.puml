@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management System API container

Container_Boundary(case_management_system_api, "Case Management System API") {
    Component(Case_Controller_Router, "Case Controller / Router", "Node.js, Express, TypeScript", "Express-based routing layer handling HTTP requests and JWT authentication.")
    Component(Masking_Security_Interceptor, "Masking & Security Interceptor", "Node.js Middleware", "Middleware layer stripping PANs and validating RBAC scopes.")
    Component(Case_Service, "Case Service", "TypeScript, Node.js", "Core domain logic managing case states, analyst assignments, and aggregated DTO payloads.")
    Component(Audit_Compliance_Logger, "Audit & Compliance Logger", "Node.js, AWS SDK", "Component dispatching batched audit payloads asynchronously.")
    Component(Data_Access_Layer, "Data Access Layer", "TypeScript, AWS SDK", "Interfacing with Amazon DynamoDB for persistence using AWS KMS.")
    Component(Amazon_SQS, "Amazon SQS", "AWS SQS", "Decouples audit logging and guarantees tamper-evident delivery.")
    Component(Amazon_DynamoDB, "Amazon DynamoDB", "Amazon DynamoDB", "Low-latency scalable persistence of case data.")
}

Rel(Case_Controller_Router, Case_Service, "Invokes", "internal TypeScript interfaces")
Rel(Audit_Compliance_Logger, Amazon_SQS, "Dispatches payloads asynchronously", "AWS SDK")
Rel(Data_Access_Layer, Amazon_DynamoDB, "Reads and writes encrypted data", "AWS KMS")

@enduml