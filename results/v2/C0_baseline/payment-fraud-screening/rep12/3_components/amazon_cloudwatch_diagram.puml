@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_cloudwatch, "Amazon CloudWatch") {
    Component(Log_Groups, "Log Groups", "AWS CloudWatch Logs", "Collects and stores redacted logs from the scoring engine and case management API.")
    Component(Metric_Filters, "Metric Filters", "CloudWatch Metric Filters", "Extracts EMF metrics from log streams for monitoring.")
    Component(Alarms, "Alarms", "CloudWatch Alarms", "Evaluates operational and business thresholds to trigger alerts.")
    Component(Logs_Insights, "Logs Insights", "CloudWatch Logs Insights", "Provides query capabilities for analyzing log data.")
    Component(Synthetics, "Synthetics", "CloudWatch Synthetics", "Monitors availability and performance via canary scripts.")
}

Rel(Log_Groups, Metric_Filters, "Feeds log data for metric extraction", "")
Rel(Metric_Filters, Alarms, "Provides metric data for threshold evaluation", "")

@enduml