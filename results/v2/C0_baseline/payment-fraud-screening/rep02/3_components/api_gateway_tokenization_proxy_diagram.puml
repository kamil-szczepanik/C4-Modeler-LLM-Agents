@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway & Tokenization Proxy container

Container_Boundary(api_gateway_boundary, "API Gateway & Tokenization Proxy") {
    Component(api_gateway, "API Gateway & Tokenization Proxy", "Java, Spring Cloud Gateway, Netty", "Screens card-not-present payment authorizations for fraud prior to approval, handles routing, tokenization, and payload encryption.")
}

System_Ext(fraud_scoring_engine, "Fraud Scoring Engine", "Java / Spring Boot")
System_Ext(case_management_ui, "Case Management & Rule UI", "Node.js / TypeScript")
System_Ext(aws_kms, "AWS KMS", "AWS Key Management Service")

Rel(api_gateway, fraud_scoring_engine, "Fraud evaluation requests", "gRPC over internal VPC security groups with mTLS")
Rel(api_gateway, case_management_ui, "Routing requests", "HTTPS / REST")
Rel(api_gateway, aws_kms, "Tokenization and payload encryption", "HTTPS / AWS SDK")

@enduml