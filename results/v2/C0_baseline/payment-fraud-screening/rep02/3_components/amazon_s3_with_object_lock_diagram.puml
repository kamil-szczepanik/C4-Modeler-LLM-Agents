@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Amazon S3 with Object Lock", "Amazon S3 with Object Lock") {
    Component(Audit_Log_Storage_Component, "Audit Log Storage Component", "Amazon S3 with Object Lock", "Stores tamper-evident audit logs and rule distributions with 7-year retention in Compliance Mode.")
    Component(Lifecycle_Tiering_Component, "Lifecycle Tiering Component", "Amazon S3 Glacier Flexible Retrieval", "Handles lifecycle tiering for cost optimization of historical audit data.")
}

Rel(Audit_Log_Storage_Component, Lifecycle_Tiering_Component, "Transitions older audit logs for cost optimization", "S3 Lifecycle")

@enduml