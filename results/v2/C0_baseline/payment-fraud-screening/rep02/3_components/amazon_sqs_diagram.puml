@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon SQS container

Container_Boundary(amazon_sqs, "Amazon SQS") {
    Component(Rule_Updates_Queue, "Rule Updates Queue", "Amazon SQS Standard Queue", "Asynchronously handles rule update notifications dispatched by the Case Management & Rule UI.")
    Component(Audit_Logging_Queue, "Audit Logging Queue", "Amazon SQS Standard Queue with DLQ", "Decouples high-throughput audit logging from the critical payment path.")
}

System_Ext(Fraud_Scoring_Engine, "Fraud Scoring Engine", "Java / Spring Boot")

Rel(Rule_Updates_Queue, Fraud_Scoring_Engine, "Delivers rule update notifications", "AWS SDK / HTTPS")

@enduml