@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon DynamoDB container

System_Ext(FraudScoringEngine, "Fraud Scoring Engine", "Java / Spring Boot")
System_Ext(CaseManagementUI, "Case Management & Rule UI", "Node.js / TypeScript")
System_Ext(AmazonS3, "Amazon S3 with Object Lock", "Amazon S3")

Container_Boundary(AmazonDynamoDB, "Amazon DynamoDB") {
    Component(AWSDynamoDBTables, "AWS DynamoDB Tables", "Amazon DynamoDB", "Stores rule metadata and active case states for the system.")
    Component(AWSDynamoDBStreams, "AWS DynamoDB Streams", "DynamoDB Streams", "Emits change data capture events for asynchronous audit logging.")
    Component(AWSPrivateLinkInterfaceEndpoint, "AWS PrivateLink Interface Endpoint", "DynamoDB VPC Endpoint", "Enforces TLS 1.3 data-in-transit security for secure database access.")
    Component(AWSKMSCMK, "AWS KMS CMK", "AWS KMS Customer Managed Keys", "Provides cryptographic data protection at rest for cardholder data.")
}

Rel(FraudScoringEngine, AWSPrivateLinkInterfaceEndpoint, "Reads and writes rule metadata", "HTTPS / TLS 1.3, AWS SDK")
Rel(CaseManagementUI, AWSPrivateLinkInterfaceEndpoint, "Reads and writes active case states", "HTTPS / TLS 1.3, AWS SDK")
Rel(AWSDynamoDBStreams, AmazonS3, "Emits change data capture events for asynchronous audit logging", "HTTPS")

@enduml