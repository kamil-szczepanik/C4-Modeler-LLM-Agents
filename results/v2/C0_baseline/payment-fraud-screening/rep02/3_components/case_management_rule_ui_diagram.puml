@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management & Rule UI container

Container_Boundary(case_management_and_rule_ui, "Case Management & Rule UI") {
    Component(api_router_bff, "API Router / BFF", "Node.js, Express, tRPC", "Handles user authentication via OIDC and routes requests for analyst reviews and rule management.")
    Component(case_management_service_component, "Case Management Service Component", "Node.js with TypeScript", "Manages active case states and interacts with data storage.")
    Component(rule_authoring_validation_engine, "Rule Authoring & Validation Engine", "Node.js with TypeScript", "Enables risk managers to update and validate fraud rules without downtime.")
    Component(audit_dispatcher_component, "Audit Dispatcher Component", "Node.js with TypeScript", "Dispatches sanitized audit events for compliance tracking.")
    Component(serverless_sandbox_audit_lambda_functions, "Serverless Sandbox & Audit Lambda Functions", "AWS Lambda", "Executes rule sandboxing and asynchronous audit log persistence.")
}

System_Ext(amazon_dynamodb, "Amazon DynamoDB", "Active case state storage")
System_Ext(amazon_sqs, "Amazon SQS", "Message queue for rules and audit logs")
System_Ext(amazon_s3_with_object_lock, "Amazon S3 with Object Lock", "Immutable audit log storage")

Rel(api_router_bff, case_management_service_component, "Invokes case operations", "HTTPS / tRPC")
Rel(api_router_bff, rule_authoring_validation_engine, "Invokes rule authoring and validation", "HTTPS / tRPC")
Rel(case_management_service_component, amazon_dynamodb, "Reads and writes active case states", "AWS SDK / TCP")
Rel(rule_authoring_validation_engine, amazon_sqs, "Publishes validated rules", "AWS SDK")
Rel(audit_dispatcher_component, amazon_sqs, "Forwards sanitized audit events", "AWS SDK")
Rel(amazon_sqs, serverless_sandbox_audit_lambda_functions, "Asynchronous log processing", "AWS Lambda Event Source")
Rel(serverless_sandbox_audit_lambda_functions, amazon_s3_with_object_lock, "Writes immutable audit logs", "HTTPS")

@enduml