@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalysts, "Fraud Analysts and Risk Operations Managers", "Users who interact with the case management UI and provide feedback loops for fraud screening.")

System(RealTimeFraudScreeningSystem, "Real-Time Fraud Screening System", "Screens card-not-present payment authorizations in AWS eu-west-1 for PCI-DSS Level 1 compliance, delivering sub-50ms fraud decisions and a case management UI for fraud analysts.")

System_Ext(PaymentGateway, "Payment Gateway / Acquirer", "External system that sends payment authorization requests for fraud screening.")
System_Ext(CardSchemes, "Card Schemes / Tokenization Service", "External system providing tokenized card data.")
System_Ext(IdentityProvider, "Identity Provider", "External system handling OAuth2 / OIDC authentication for strict RBAC and MFA.")
System_Ext(AuditArchive, "Audit / Compliance Archive", "External system providing tamper-evident logs and cryptographic storage for compliance.")

Rel(PaymentGateway, RealTimeFraudScreeningSystem, "Authorization screening requests", "gRPC/HTTPS")
Rel(RealTimeFraudScreeningSystem, CardSchemes, "Tokenized card data retrieval", "HTTPS")
Rel(FraudAnalysts, RealTimeFraudScreeningSystem, "Case management & feedback loop", "HTTPS/OIDC")
Rel(RealTimeFraudScreeningSystem, AuditArchive, "Tamper-evident logs and 7-year retention", "AWS KMS / S3 Object Lock")

@enduml