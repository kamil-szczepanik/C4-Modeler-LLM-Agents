@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalyst, "Fraud Analyst", "Analyst responsible for case management and reviewing flagged fraud transactions.")
Person(RiskComplianceOfficer, "Risk / Compliance Officer", "Officer responsible for overseeing risk policies, compliance retention, and audit trails.")
System_Ext(MerchantPaymentGateway, "Merchant / Payment Gateway", "Sends payment authorizations for real-time fraud screening.")
System_Ext(TokenizationProvider, "Tokenization Provider", "Provides secure token resolution via HTTPS API.")
System_Ext(AuditArchiveAWSS3ObjectLock, "Audit Archive (AWS S3 Object Lock)", "Tamper-evident long-term storage enforcing 7-year compliance retention.")

System(RealTimeFraudScreeningSystem, "Real-Time Fraud Screening System", "A real-time card-not-present fraud screening system processing payment authorizations with sub-50ms latency, automated scoring, analyst case management, and tamper-evident 7-year audit logging.")

Rel(MerchantPaymentGateway, RealTimeFraudScreeningSystem, "Sends payment authorizations for scoring", "HTTPS / gRPC with mutual TLS (mTLS)")
Rel(FraudAnalyst, RealTimeFraudScreeningSystem, "Performs case management", "HTTPS with OIDC/MFA")
Rel(RealTimeFraudScreeningSystem, TokenizationProvider, "Resolves secure tokens", "HTTPS API")
Rel(RealTimeFraudScreeningSystem, AuditArchiveAWSS3ObjectLock, "Stores immutable decision trail", "AWS SDK / S3 API")

@enduml