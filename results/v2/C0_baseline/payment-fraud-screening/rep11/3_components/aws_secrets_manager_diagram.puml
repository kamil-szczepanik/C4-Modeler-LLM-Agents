@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_secrets_manager, "AWS Secrets Manager") {
    Component(SecretsManagementService, "Secrets Management Service", "AWS Secrets Manager Service", "Secures external partner keys, database credentials, and tokenization secrets with IAM ABAC least-privilege.")
    Component(RotationLambdaHandler, "Rotation Lambda Handler", "AWS Lambda, Python", "Automates secret rotation using AWSCURRENT and AWSPREVIOUS staging labels.")
}

Rel(RotationLambdaHandler, SecretsManagementService, "Updates credentials using staging labels", "HTTPS/TLS")

@startuml