@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management & Reporting Frontend container

Container_Boundary(case_management_frontend, "Case Management & Reporting Frontend") {
    Component(Case Management UI Router, "Case Management UI Router", "React Router", "Manages client-side navigation and route protection for fraud analysts.")
    Component(Fraud Dashboard Views, "Fraud Dashboard Views", "React SPA, Amazon CloudFront, Amazon S3", "Renders real-time alerts, transaction details, and case management interfaces.")
}

Rel(Case Management UI Router, Fraud Dashboard Views, "Renders views based on route", "In-memory")

@enduml