@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon Athena container

Container_Boundary(amazon_athena, "Amazon Athena") {
    Component(Query_Engine, "Query Engine", "Amazon Athena", "Executes serverless analytics queries for historical audit logs.")
    Component(Data_Catalog, "Data Catalog", "AWS Glue Data Catalog", "Maintains metadata schemas for audit logs and compliance data.")
    Component(Query_Result_Cache, "Query Result Cache", "S3 Query Result Cache", "Caches historical query results to optimize performance and reduce costs.")
    Component(Saved_Queries_Templates, "Saved Queries & Templates", "Athena Saved Queries", "Stores predefined compliance and audit reporting templates.")
}

Rel(Query_Engine, Data_Catalog, "Retrieves metadata schemas", "AWS SDK")
Rel(Query_Engine, Query_Result_Cache, "Reads and writes cached results", "S3 API")
Rel(Query_Engine, Saved_Queries_Templates, "Executes predefined templates", "Athena API")

@enduml