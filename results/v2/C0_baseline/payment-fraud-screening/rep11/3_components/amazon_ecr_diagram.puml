@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Amazon_ECR", "Amazon ECR") {
    Component(Registry_Repository_Store, "Registry Repository Store", "AWS ECR, AES-256, AWS KMS", "AWS ECR repository storing Docker image layers encrypted with AES-256 via AWS KMS customer-managed keys.")
    Component(Vulnerability_Scanning_Engine, "Vulnerability Scanning Engine", "Amazon Inspector", "Amazon Inspector integration scanning images upon push to enforce security gates.")
    Component(Lifecycle_Immutability_Manager, "Lifecycle & Immutability Manager", "AWS ECR Lifecycle Policies", "Enforces image immutability tags and retention policies to prune old artifacts.")
}

Rel(Registry_Repository_Store, Vulnerability_Scanning_Engine, "Triggers image vulnerability scanning upon push")
Rel(Lifecycle_Immutability_Manager, Registry_Repository_Store, "Enforces tag immutability and retention policies")

@enduml