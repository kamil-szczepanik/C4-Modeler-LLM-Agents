@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Amazon ElastiCache for Redis container

System_Ext(FraudScreeningEngine, "Fraud Screening Engine", "External system querying feature vectors.")
System_Ext(AmazonCloudWatch, "Amazon CloudWatch", "Logging and metrics service.")
System_Ext(AWSSecretsManager, "AWS Secrets Manager", "Secret management service.")

Container_Boundary(AmazonElastiCacheforRedis, "Amazon ElastiCache for Redis") {
    Component(InMemoryDataStoreEngine, "In-Memory Data Store Engine", "Redis OSS v7.x", "High-throughput, in-memory data store providing sub-50ms feature lookups for card-not-present transaction evaluations.")
    Component(MultiAZNodeGroup, "Multi-AZ Node Group", "1 Primary, 1 Read Replica in eu-west-1", "Provides managed Multi-AZ high availability and fault tolerance.")
    Component(CustomParameterGroup, "Custom Parameter Group", "Hardened configuration", "Enforces security and operational configurations for PCI-DSS compliance.")
}

Rel(FraudScreeningEngine, InMemoryDataStoreEngine, "Queries and updates feature vectors", "RESP over TLS (TCP/6379)")
Rel(InMemoryDataStoreEngine, AmazonCloudWatch, "Streams slow queries and connection logs", "AWS API")
Rel(AWSSecretsManager, InMemoryDataStoreEngine, "Provides Redis AUTH authentication tokens", "secure API")
@enduml