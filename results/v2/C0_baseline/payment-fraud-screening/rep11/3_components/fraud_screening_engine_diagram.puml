@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(fraud_screening_engine, "Fraud Screening Engine") {
    Component(api_routing_and_auth_handler, "API Routing and Auth Handler", "Go / Rust, AWS API Gateway Integration", "Handles incoming mTLS requests from API Gateway, authenticates payloads, and routes them to the scoring pipeline.")
    Component(feature_retrieval_component, "Feature Retrieval Component", "Go / Rust, Amazon ElastiCache Client", "Queries and updates cached features from Redis to support sub-50ms P99 feature retrieval.")
    Component(scoring_engine_worker, "Scoring Engine Worker", "Go / Rust, AWS Fargate", "Executes high-throughput, low-latency fraud evaluation rules and algorithms against transaction payloads.")
    Component(event_publisher, "Event Publisher", "Go / Rust, AWS SDK for SQS", "Publishes decision and audit events asynchronously to Amazon SQS.")
}

Rel(api_routing_and_auth_handler, scoring_engine_worker, "Passes validated transaction authorization payload", "")
Rel(scoring_engine_worker, feature_retrieval_component, "Queries and updates cached features", "Redis Protocol")
Rel(scoring_engine_worker, event_publisher, "Sends final transaction decisions and audit events", "AWS SDK / SQS API")
@enduml