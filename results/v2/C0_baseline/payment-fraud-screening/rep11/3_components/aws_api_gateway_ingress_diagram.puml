@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_api_gateway_ingress, "AWS API Gateway / Ingress") {
    Component(Amazon_API_Gateway, "Amazon API Gateway", "Amazon API Gateway", "HTTP API configuration for low latency routing and traffic management.")
    Component(AWS_WAF, "AWS WAF", "AWS WAF", "Enforces OWASP Top 10 rules and provides DDoS mitigation.")
    Component(AWS_ACM_Private_CA, "AWS ACM Private CA", "AWS ACM Private CA", "Native mTLS termination at the edge without Lambda compute overhead.")
}

Rel(AWS_WAF, Amazon_API_Gateway, "Filters requests", "Internal AWS routing")
Rel(AWS_ACM_Private_CA, Amazon_API_Gateway, "Terminates mTLS", "HTTPS / TLS 1.3")

@enduml