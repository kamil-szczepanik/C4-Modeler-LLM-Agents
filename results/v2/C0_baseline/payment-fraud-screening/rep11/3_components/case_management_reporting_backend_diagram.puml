@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management & Reporting Backend container

Container_Boundary(case_management_reporting_backend, "Case Management & Reporting Backend") {
    Component(Case_API_Controller, "Case API Controller", "FastAPI Router", "Handles incoming HTTP requests for fraud analyst case reviews and compliance workflows.")
    Component(Case_Service_Business_Logic_Layer, "Case Service & Business Logic Layer", "Python", "Implements business logic for case management, coordinating data access and external API calls.")
    Component(Case_Repository, "Case Repository", "SQLAlchemy ORM", "Manages database interactions and operations for cases within PostgreSQL.")
    Component(Compliance_Audit_Service, "Compliance & Audit Service", "Python", "Executes historical compliance queries and manages audit reporting requirements.")
    Component(Tokenization_Gateway_Client, "Tokenization Gateway Client", "HTTPS/REST", "Retrieves masked card data securely from the tokenization gateway.")
    Component(Amazon_RDS_PostgreSQL, "Amazon RDS PostgreSQL", "Provisioned Instance", "Stores persistent case data with AWS KMS encryption.")
    Component(Amazon_ElastiCache_for_Redis, "Amazon ElastiCache for Redis", "RESP Protocol", "Caches frequent report data to reduce query costs and latency.")
    Component(Amazon_Athena, "Amazon Athena", "AWS SDK / Athena API", "Runs asynchronous, batch-oriented compliance reports for 7-year audit data.")
}

Rel(Case_API_Controller, Case_Service_Business_Logic_Layer, "Internal function calls", "Python")
Rel(Case_Service_Business_Logic_Layer, Case_Repository, "Database queries and updates", "SQLAlchemy / PostgreSQL Protocol")
Rel(Case_Service_Business_Logic_Layer, Tokenization_Gateway_Client, "Retrieves masked card data", "HTTPS/REST")
Rel(Compliance_Audit_Service, Amazon_Athena, "Executes historical compliance queries", "AWS SDK / Athena API")
Rel(Compliance_Audit_Service, Amazon_ElastiCache_for_Redis, "Caches frequent report data", "RESP Protocol")

@enduml