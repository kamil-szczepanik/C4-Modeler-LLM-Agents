@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalyst, "Fraud Analyst & Risk/Compliance Officer", "Reviews flagged suspicious transactions and ensures compliance with regulatory standards.")
System_Ext(PaymentGateway, "Payment Gateway / Merchants", "API Client that sends card-not-present payment authorization requests.")
System_Ext(CardTokenizationVault, "Card Tokenization Vault", "External service interfaced for tokenized data validation.")
System_Ext(IdentityProvider, "Identity Provider", "AWS IAM / Cognito service handling authentication and Role-Based Access Control.")
System_Ext(ImmutableAuditSink, "Immutable Audit Sink", "AWS S3 Object Lock storage for WORM compliance and secure record retention.")
System_Ext(AmazonCloudWatchRoute53, "Amazon CloudWatch & Route 53", "Provides real-time health metrics, heartbeats, and boundary monitoring.")

System(RealTimePaymentFraudScreeningSystem, "Real-Time Payment Fraud Screening System", "Evaluates card-not-present payment authorizations to approve, decline, or flag suspicious transactions while managing analyst reviews.")

Rel(PaymentGateway, RealTimePaymentFraudScreeningSystem, "Sends authorization requests", "gRPC and HTTPS using TLS 1.3 with mTLS")
Rel(RealTimePaymentFraudScreeningSystem, CardTokenizationVault, "Validates tokenized data", "outbound HTTPS APIs")
Rel(RealTimePaymentFraudScreeningSystem, ImmutableAuditSink, "Ingests decision inputs, model versions, and explanations into WORM storage", "AWS KMS CMK encryption")
Rel(RealTimePaymentFraudScreeningSystem, AmazonCloudWatchRoute53, "Emits real-time health metrics and heartbeats for boundary monitoring", "AWS telemetry")
Rel(FraudAnalyst, RealTimePaymentFraudScreeningSystem, "Manages analyst reviews and compliance", "AWS IAM / Cognito")

@enduml