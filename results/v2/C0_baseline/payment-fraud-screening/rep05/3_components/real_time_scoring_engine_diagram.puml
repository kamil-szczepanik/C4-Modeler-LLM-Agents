@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(real_time_scoring_engine, "Real-Time Scoring Engine") {
    Component(HTTP_Request_Handler, "HTTP Request Handler", "Go (net/http)", "Receives authorization scoring requests via HTTPS/REST with mTLS from Amazon API Gateway.")
    Component(Fraud_Scoring_Orchestrator, "Fraud Scoring Orchestrator", "Go", "Evaluates transactions against real-time constraints, delivering sub-50ms P99 latency.")
    Component(Model_Inference_Engine, "Model Inference Engine", "ONNX Runtime", "Executes cryptographically signed models retrieved from the Model Registry.")
}

Rel(HTTP_Request_Handler, Fraud_Scoring_Orchestrator, "Forwards incoming authorization requests for evaluation")
Rel(Fraud_Scoring_Orchestrator, Model_Inference_Engine, "Invokes model scoring using loaded machine learning models")

@startuml