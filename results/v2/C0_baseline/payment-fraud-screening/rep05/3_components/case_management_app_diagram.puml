@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management App container

Container_Boundary(case_management_app, "Case Management App") {
    Component(API_Controller_Component, "API Controller Component", "Express.js / Fastify, Node.js, TypeScript", "Routes authenticated API requests from Amazon API Gateway.")
    Component(Case_Service_Component, "Case Service Component", "Node.js, TypeScript", "Manages business logic and case management workflows.")
    Component(Audit_Client_Component, "Audit Client Component", "AWS SDK, Node.js, TypeScript", "Emits cryptographically signed case resolution events to the immutable audit sink.")
    Component(Data_Repository_Component, "Data Repository Component", "TypeORM / Prisma, Node.js, TypeScript", "Reads and writes relational case state.")
    Component(Dashboard_Metrics_Component, "Dashboard & Metrics Component", "Node.js, TypeScript", "Provides operational metrics and dashboard capabilities for fraud analysts.")
}

System_Ext(Amazon_Aurora_PostgreSQL_Serverless_v2, "Amazon Aurora PostgreSQL Serverless v2", "Persists case data")
System_Ext(Immutable_Audit_Sink_Amazon_S3_with_Object_Lock, "Immutable Audit Sink (Amazon S3 with Object Lock)", "Stores immutable audit logs")
System_Ext(Identity_Provider, "Identity Provider", "Validates OIDC/OAuth2 tokens and RBAC claims")

Rel(API_Controller_Component, Case_Service_Component, "Delegates requests", "HTTP / JSON")
Rel(Case_Service_Component, Data_Repository_Component, "Reads and writes relational case state", "TypeORM / Prisma")
Rel(Case_Service_Component, Audit_Client_Component, "Triggers audit events upon case resolution", "Function Call")
Rel(Data_Repository_Component, Amazon_Aurora_PostgreSQL_Serverless_v2, "Persists case data", "IAM DB Auth / TLS")
Rel(Audit_Client_Component, Immutable_Audit_Sink_Amazon_S3_with_Object_Lock, "Emits cryptographically signed case resolution events", "AWS SDK / HTTPS")
Rel(API_Controller_Component, Identity_Provider, "Validates OIDC/OAuth2 tokens and RBAC claims", "HTTPS")

@enduml