@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Real_Time_Scoring_Engine, "Real-Time Scoring Engine", "Application Engine", "Reads features via RESP over TCP.")
System_Ext(AWS_Secrets_Manager, "AWS Secrets Manager", "AWS SDK (HTTPS)", "Fetches authentication tokens securely.")

Container_Boundary(Feature_Store_Cache, "Feature Store & Cache") {
    Component(Feature_Retrieval_API_Client_Layer, "Feature Retrieval API / Client Layer", "API Client Layer", "Provides sub-millisecond feature lookups for the Real-Time Payment Fraud Screening system.")
    Component(In_Memory_Cache_Store, "In-Memory Cache & Store", "Amazon ElastiCache Redis (Standard Tier)", "Maintains aggregated user and card behavioral data to ensure high-performance fraud scoring.")
    Component(Feature_Ingestion_Worker, "Feature Ingestion Worker", "Worker Process", "Writes feature updates asynchronously to the cache.")
    Component(Amazon_ElastiCache_Redis_Standard_Tier, "Amazon ElastiCache Redis (Standard Tier)", "Redis", "Chosen for sub-millisecond latency and high throughput.")
}

Rel(Real_Time_Scoring_Engine, Feature_Retrieval_API_Client_Layer, "Reads features via RESP over TCP (with TLS 1.3)", "RESP / TCP")
Rel(Feature_Ingestion_Worker, In_Memory_Cache_Store, "Writes feature updates asynchronously via Redis commands over TLS", "Redis Commands / TLS")
Rel(Feature_Store_Cache, AWS_Secrets_Manager, "Fetches authentication tokens via AWS SDK (HTTPS)", "HTTPS")
@enduml