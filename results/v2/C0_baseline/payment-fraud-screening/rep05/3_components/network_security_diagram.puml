@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(network_security, "Network & Security") {
    Component(AWS_WAF_API_Gateway, "AWS WAF & API Gateway", "Amazon API Gateway, AWS WAF", "Handles edge routing, request filtering for high-throughput traffic, and securing entry points.")
    Component(AWS_KMS_Secrets_Manager, "AWS KMS & Secrets Manager", "AWS KMS, AWS Secrets Manager", "Manages encryption, key segregation, and automated credential rotation for PCI-DSS compliance.")
    Component(AWS_VPC_Security_Groups, "AWS VPC Security Groups", "AWS VPC Security Groups", "Enforces micro-segmentation ensuring strict network isolation.")
}

Rel(AWS_WAF_API_Gateway, AWS_VPC_Security_Groups, "Filters and routes traffic through secured network boundaries", "")
Rel(AWS_KMS_Secrets_Manager, AWS_VPC_Security_Groups, "Secures data access across isolated network segments via AWS IAM", "")
@enduml