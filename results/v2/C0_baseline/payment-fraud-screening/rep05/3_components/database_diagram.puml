@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database container

Container_Boundary(database_container, "Database") {
    Component(PgBouncer Connection Pooler, "PgBouncer Connection Pooler", "PgBouncer", "Manages and optimizes database connections to support cost-efficient scalability and high concurrency.")
    Component(Relational Storage Engine, "Relational Storage Engine", "Amazon Aurora PostgreSQL Serverless v2", "Stores relational case data, dynamic rules, and model metadata with strict schema boundaries.")
}

Rel(PgBouncer Connection Pooler, Relational Storage Engine, "Forwards pooled SQL queries over TLS 1.3", "TCP/5432")

@enduml