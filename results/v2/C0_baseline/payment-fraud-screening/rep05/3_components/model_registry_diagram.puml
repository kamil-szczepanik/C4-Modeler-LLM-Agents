@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Data Scientist, "Data Scientist", "ML Engineer registering models")
Person(Risk Officer, "Risk Officer", "Compliance Officer approving models")
System_Ext(Real-Time Scoring Engine, "Real-Time Scoring Engine", "Evaluates authorizations")
System_Ext(Amazon EventBridge, "Amazon EventBridge", "Event bus for system notifications")

Container_Boundary(Model Registry, "Model Registry") {
    Component(Model Governance API, "Model Governance API", "HTTPS REST API", "Handles model registration requests and triggers state transition events.")
    Component(Amazon SageMaker Model Registry, "Amazon SageMaker Model Registry", "AWS Managed Service", "Manages model lifecycle and versioning under IAM/ABAC governance.")
    Component(Artifact Cryptographic Signer, "Artifact Cryptographic Signer", "AWS Lambda & AWS KMS", "Automates cryptographic signing of model artifacts stored in Amazon S3.")
    Component(Model Event Dispatcher, "Model Event Dispatcher", "Amazon SNS & Amazon EventBridge", "Pub/sub messaging for distributing model updates with zero downtime.")
    Component(Object Lock Storage, "Amazon S3 with Object Lock", "Amazon S3 with Object Lock", "Enforces secure, 7-year tamper-evident retention for model artifacts.")
}

Rel(Data Scientist, Model Governance API, "Registers models via HTTPS", "HTTPS")
Rel(Risk Officer, Amazon SageMaker Model Registry, "Approves models via IAM/ABAC", "IAM/ABAC")
Rel(Model Governance API, Amazon EventBridge, "Triggers on state transition", "Events")
Rel(Artifact Cryptographic Signer, Object Lock Storage, "Uses AWS KMS to sign artifacts stored in S3", "AWS KMS / S3 API")
Rel(Model Event Dispatcher, Real-Time Scoring Engine, "Notifies via authenticated HTTPS", "Authenticated HTTPS")

@enduml