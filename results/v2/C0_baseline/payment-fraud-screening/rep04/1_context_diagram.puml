@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Real-Time Payment Fraud Screening

Person(Shopper_Cardholder, "Shopper / Cardholder", "End user initiating card-not-present payment authorizations.")
Person(Merchant, "Merchant", "Business entity processing payments whose revenue is protected by the screening system.")
Person(Fraud_Analyst, "Fraud Analyst", "User reviewing fraud cases and managing manual decisions.")
Person(Risk_Compliance_Officer, "Risk / Compliance Officer", "User overseeing compliance mandates, risk policies, and audits.")

System(Real_Time_Payment_Fraud_Screening, "Real-Time Payment Fraud Screening", "A cloud-native system that screens card-not-present payment authorizations for fraud and manages analyst review cases to protect merchant revenue while enforcing security mandates.")

System_Ext(Payment_Gateway_Acquirer, "Payment Gateway / Acquirer", "External system routing payment authorization requests.")
System_Ext(Card_Networks_Identity_Providers, "Card Networks / Identity Providers", "External entities providing card payment rails and identity verification.")
System_Ext(Compliance_Audit_Archival_Storage, "Compliance & Audit Archival Storage", "External storage system for immutable log streaming and 7-year retention.")
System_Ext(Identity_Provider_IdP, "Identity Provider / IdP", "External service handling authentication for analysts and officers.")
System_Ext(Notification_Alerting_Service, "Notification / Alerting Service", "External service handling operational alerts.")

Rel(Payment_Gateway_Acquirer, Real_Time_Payment_Fraud_Screening, "Sends authorization requests and receives synchronous decisions", "REST/gRPC with mTLS")
Rel(Real_Time_Payment_Fraud_Screening, Compliance_Audit_Archival_Storage, "Streams immutable logs for audit compliance", "TLS")
Rel(Fraud_Analyst, Real_Time_Payment_Fraud_Screening, "Reviews cases and manages screening workflows via IdP authentication", "HTTPS/OIDC/SAML")
Rel(Risk_Compliance_Officer, Real_Time_Payment_Fraud_Screening, "Monitors compliance and risk rules via IdP authentication", "HTTPS/OIDC/SAML")
Rel(Real_Time_Payment_Fraud_Screening, Notification_Alerting_Service, "Sends operational alerts", "HTTPS/SMTP")

@enduml