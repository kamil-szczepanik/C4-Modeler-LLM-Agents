@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(aws_api_gateway, "AWS API Gateway") {
    Component(HTTP_Route_Resolver, "HTTP Route Resolver", "AWS API Gateway (HTTP API v2)", "Receives screening payloads via REST/JSON over HTTPS and handles low-overhead HTTP/2 ingress.")
    Component(Native_JWT_Authorizer, "Native JWT Authorizer", "AWS API Gateway Native JWT Authorizer", "Validates bearer tokens at the edge without custom compute overhead.")
    Component(VPC_Link_Integration, "VPC Link Integration", "AWS API Gateway VPC Link", "Forwards sanitized payloads via gRPC over HTTP/2 to internal services.")
}

Rel(HTTP_Route_Resolver, Native_JWT_Authorizer, "Validates bearer tokens", "Internal Evaluation")
Rel(HTTP_Route_Resolver, VPC_Link_Integration, "Forwards sanitized payloads", "gRPC over HTTP/2")
@enduml