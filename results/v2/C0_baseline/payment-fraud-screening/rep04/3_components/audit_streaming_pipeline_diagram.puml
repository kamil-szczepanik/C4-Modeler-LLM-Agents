@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(audit_streaming_pipeline, "Audit & Streaming Pipeline") {
    Component(Amazon Kinesis Data Streams, "Amazon Kinesis Data Streams", "Amazon Kinesis Data Streams", "Ingests real-time pre-redacted audit events.")
    Component(Amazon Kinesis Firehose, "Amazon Kinesis Firehose", "Amazon Kinesis Firehose", "Batches and streams audit logs to persistent storage.")
    Component(AWS Lambda, "AWS Lambda", "AWS Lambda", "Processes and routes audit events within the streaming pipeline.")
}

Rel(Amazon Kinesis Data Streams, Amazon Kinesis Firehose, "Batches and forwards stream data", "")
Rel(Amazon Kinesis Firehose, AWS Lambda, "Invokes processing functions or handles error routing", "")

@enduml