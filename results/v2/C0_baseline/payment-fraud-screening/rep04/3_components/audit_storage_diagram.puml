@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(RiskComplianceOfficer, "Risk / Compliance Officer", "Queries historical audit logs.")

Container_Boundary(AuditStorage, "Audit Storage") {
    Component(S3BucketDataPartition, "S3 Bucket (Data Partition)", "Amazon S3", "Data partition storing immutable audit records for 7-year retention.")
    Component(S3ObjectLockPolicyEngine, "S3 Object Lock Policy Engine", "Amazon S3 Object Lock (Compliance Mode)", "Ensures tamper-evident retention for R-06 compliance.")
    Component(AWSGlueDataCatalog, "AWS Glue Data Catalog", "AWS Glue", "Catalogs partitioned audit logs for querying.")
    Component(AthenaQueryInterface, "Athena Query Interface", "Amazon Athena", "Enables serverless SQL querying over partitioned audit logs.")
    Component(S3GlacierFlexibleRetrieval, "S3 Glacier Flexible Retrieval", "Amazon S3 Glacier", "Optimizes long-term storage costs to fit the monthly budget.")
}

Rel(RiskComplianceOfficer, AthenaQueryInterface, "Queries historical audit logs", "HTTPS/Console, SQL")
Rel(AthenaQueryInterface, S3BucketDataPartition, "Scans immutable audit records", "AWS internal storage APIs")

@enduml