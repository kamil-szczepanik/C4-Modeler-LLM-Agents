@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Real-Time Payment Fraud Screening

Person(ShopperCardholder, "Shopper / Cardholder", "End user initiating card-not-present payment authorizations.")
Person(Merchant, "Merchant", "Business entity processing payments whose revenue is protected by the screening system.")
Person(FraudAnalyst, "Fraud Analyst", "User reviewing fraud cases and managing manual decisions.")
System_Ext(ExternalIdP, "External IdP", "OAuth2/OIDC service for analyst authentication.")

System_Boundary(RealTimePaymentFraudScreening, "Real-Time Payment Fraud Screening") {
    Container(AWSApiGateway, "AWS API Gateway", "Low-overhead HTTP/2 ingress, AWS API Gateway", "Ingress and edge tokenization boundary for PAN data.")
    Container(ScoringEngine, "Scoring Engine", "Rust (Tokio), Amazon ECS Fargate", "Real-time payment fraud screening engine providing sub-50ms latency scoring.")
    Container(CaseManagementApp, "Case Management App", "Node.js/Python, Amazon ECS Fargate", "Backend application for managing review cases.")
    ContainerDb(FeatureStoreCache, "Feature Store & Cache", "Amazon ElastiCache Redis, Amazon DynamoDB", "In-memory caching and data storage for low-latency feature lookups.")
    Container(AuditStreamingPipeline, "Audit & Streaming Pipeline", "Amazon Kinesis Data Streams, Amazon Kinesis Firehose", "Streaming pipeline for tamper-evident audit logs.")
    ContainerDb(AuditStorage, "Audit Storage", "Amazon S3 with Object Lock in Compliance Mode", "Tamper-evident 7-year compliance audit log storage.")
}

Rel(ShopperCardholder, AWSApiGateway, "Sends payment transactions for fraud screening", "REST/JSON over HTTPS (TLS 1.3)")
Rel(Merchant, AWSApiGateway, "Sends card-not-present transactions for screening", "REST/JSON over HTTPS (TLS 1.3)")
Rel(FraudAnalyst, CaseManagementApp, "Reviews cases and manages screening workflows", "HTTPS")
Rel(FraudAnalyst, ExternalIdP, "Authenticates for analyst access", "OAuth2/OIDC over HTTPS")
Rel(AWSApiGateway, ScoringEngine, "Routes screening requests", "Internal ALB / gRPC")
Rel(ScoringEngine, FeatureStoreCache, "Performs low-latency feature lookups", "TCP/TLS")
Rel(CaseManagementApp, AuditStreamingPipeline, "Streams review and case events", "HTTPS")
Rel(AuditStreamingPipeline, AuditStorage, "Persists immutable logs", "AWS internal storage APIs")

@enduml