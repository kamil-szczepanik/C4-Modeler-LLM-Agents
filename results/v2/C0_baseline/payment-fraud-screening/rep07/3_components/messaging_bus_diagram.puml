@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(messaging_bus, "Messaging Bus") {
    Component(SQS_Standard_Queue, "SQS Standard Queue", "Amazon SQS Standard", "Handles high-throughput, at-least-once delivery of scoring decisions and telemetry events.")
    Component(SQS_FIFO_Queue, "SQS FIFO Queue", "Amazon SQS FIFO", "Ensures guaranteed ordering for audit and analyst override events.")
    Component(Dead_Letter_Queues, "Dead-Letter Queues", "Amazon SQS DLQ", "Captures and isolates failed message processing attempts for error analysis.")
}

Rel(SQS_Standard_Queue, SQS_FIFO_Queue, "Routes ordered processing events")
Rel(SQS_FIFO_Queue, Dead_Letter_Queues, "Forwards unprocessable messages")
@enduml