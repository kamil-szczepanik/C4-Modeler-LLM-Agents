@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(postgresql_database, "PostgreSQL Database") {
    Component(Case_Repository_Component, "Case Repository Component", "PostgreSQL / Primary RDS Instance", "Manages CRUD operations and state transitions for investigator reviews.")
    Component(Audit_Compliance_Log_Component, "Audit & Compliance Log Component", "PostgreSQL Partitioned Tables / pgaudit", "Handles append-only decision logs and analyst override histories using partitioned tables.")
    Component(Database_Security_Manager, "Database Security Manager", "AWS KMS / PostgreSQL Row-Level Security", "Enforces AWS KMS-backed encryption and PostgreSQL Row-Level Security (RLS).")
    Component(Primary_RDS_Instance, "Primary RDS Instance", "Amazon RDS PostgreSQL", "Handles transactional case state updates.")
    Component(Read_Replica, "Read Replica", "Amazon RDS PostgreSQL Read Replica", "Dedicated to analyst reporting, audit queries, and read-heavy analytics.")
    Component(PgBouncer, "PgBouncer", "PgBouncer", "Connection pooler hosted alongside the Case Management Backend.")
}

System_Ext(Audit_Storage, "Audit Storage", "External Audit Storage")

Rel(Case_Repository_Component, Primary_RDS_Instance, "Executes transactional writes and state updates", "PostgreSQL Protocol / TLS 1.3")
Rel(Audit_Compliance_Log_Component, Read_Replica, "Routes read-heavy analytics and case history queries", "PostgreSQL Protocol / TLS 1.3")
Rel(Primary_RDS_Instance, Audit_Storage, "Streams audit logs using pgaudit", "AWS API / HTTPS")

@enduml