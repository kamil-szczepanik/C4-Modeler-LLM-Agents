@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(audit_storage, "Audit Storage") {
    Component(Audit_Writer, "Audit Writer", "Go, AWS Lambda", "Persists immutable decision records to Amazon S3.")
    Component(Audit_Query_API, "Audit Query API", "Go, AWS Lambda", "Queries indexed decision metadata from Amazon DynamoDB.")
    Component(Report_Generator, "Report Generator", "Go, AWS Lambda", "Generates signed export packages and stages them in Amazon S3.")
}

System_Ext(Amazon_S3, "Amazon S3", "External storage system for immutable decision records.")
System_Ext(Amazon_DynamoDB, "Amazon DynamoDB", "External database for indexed decision metadata.")
System_Ext(Amazon_S3_Staging, "Amazon S3 (Staging)", "External staging storage for signed export packages.")

Rel(Audit_Writer, Amazon_S3, "Persists immutable decision records", "HTTPS / AWS SDK")
Rel(Audit_Query_API, Amazon_DynamoDB, "Queries indexed decision metadata", "HTTPS")
Rel(Report_Generator, Amazon_S3_Staging, "Generates signed export packages", "HTTPS / AWS SDK")
@enduml