@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS API Gateway / ALB container

Container_Boundary(aws_api_gateway_alb, "AWS API Gateway / ALB") {
    Component(PaymentIngressALB, "Payment Ingress ALB", "AWS ALB", "Handles high-throughput payment ingestion for sub-50ms latency.")
    Component(ManagementAPIGateway, "Management API Gateway", "AWS API Gateway", "Manages case management APIs and IdP integrations.")
}

Rel(PaymentIngressALB, RealTimeScoringEngine, "Forwards scoring requests using local circuit breaker", "mTLS")
Rel(ManagementAPIGateway, CaseManagementBackend, "Routes administrative and review APIs", "HTTPS")

@enduml