@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management UI container

System_Ext(case_management_backend, "Case Management Backend", "Upstream API service communicating via HTTPS")

Container_Boundary(case_management_ui, "Case Management UI") {
    Component(auth_router_component, "Auth & Router Component", "React Router, oidc-client-ts", "Manages PKCE authentication and role-based access control (RBAC).")
    Component(case_queue_investigation_component, "Case Queue & Investigation Component", "React, TanStack Query", "Handles masked card data and review queues for fraud analysts.")
    Component(rule_management_audit_component, "Rule Management & Audit Component", "React, Formik, Zod, Recharts", "Handles rule staging and metrics visualization for risk managers.")
}

Rel(auth_router_component, case_queue_investigation_component, "Provides authentication state and route protection")
Rel(auth_router_component, rule_management_audit_component, "Provides authentication state and route protection")
Rel(case_queue_investigation_component, case_management_backend, "Submits API requests", "HTTPS/REST, OAuth2/OIDC")
Rel(rule_management_audit_component, case_management_backend, "Submits API requests", "HTTPS/REST, OAuth2/OIDC")

@enduml