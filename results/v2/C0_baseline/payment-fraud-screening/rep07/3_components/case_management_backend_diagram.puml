@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Case Management Backend container

Container_Boundary(case_management_backend, "Case Management Backend") {
    Component(api_router_controller, "API Router / Controller", "TypeScript, Express/Fastify", "Handles incoming HTTP requests, invokes business logic, and sanitizes payloads.")
    Component(case_workflow_service, "Case Workflow Service", "TypeScript", "Executes core case management business logic and workflow state transitions.")
    Component(audit_compliance_logger, "Audit & Compliance Logger", "TypeScript", "Triggers immutable logging and writes cryptographically signed audit logs.")
    Component(messaging_consumer_publisher, "Messaging Consumer/Publisher", "TypeScript", "Consumes and publishes messages to the messaging bus.")
    Component(masking_sanitization_middleware, "Masking & Sanitization Middleware", "TypeScript", "Sanitizes payloads to enforce security and compliance.")
    Component(postgresql_database, "PostgreSQL Database", "Amazon RDS PostgreSQL", "Persists transactional case data securely with encryption at rest.")
    Component(audit_storage, "Audit Storage", "Amazon S3 with Object Lock", "Stores tamper-evident, cryptographically signed audit logs for 7-year regulatory compliance.")
    Component(messaging_bus, "Messaging Bus", "Amazon SQS / EventBridge", "Handles asynchronous messaging and event distribution.")
}

Rel(api_router_controller, case_workflow_service, "Invokes business logic", "Internal Function Call")
Rel(api_router_controller, masking_sanitization_middleware, "Sanitizes payloads", "Internal Function Call")
Rel(case_workflow_service, audit_compliance_logger, "Triggers immutable logging", "Internal Function Call")
Rel(case_workflow_service, postgresql_database, "Persists case state", "TypeORM/Prisma via PostgreSQL Protocol")
Rel(audit_compliance_logger, audit_storage, "Writes cryptographically signed audit logs", "HTTPS/S3 API")

@enduml