@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Real-Time Payment Fraud Screening System

Person(Payers, "Payers", "End users initiating card-not-present payments.")
Person(Fraud Analysts, "Fraud Analysts", "Professionals managing and reviewing flagged fraud cases.")
Person(Risk Managers/Quants, "Risk Managers/Quants", "Personnel overseeing risk strategies and fraud rules.")

System_Ext(Payment Gateway/Acquirer, "Payment Gateway/Acquirer", "External system submitting payment authorizations for screening.")
System_Ext(Core Banking/Card Network Systems, "Core Banking/Card Network Systems", "External financial systems interacting with transaction data.")
System_Ext(Identity Provider (IdP), "Identity Provider (IdP)", "External system providing authentication and RBAC.")

System(Real-Time Payment Fraud Screening System, "Real-Time Payment Fraud Screening System", "Evaluates card-not-present payment authorizations for fraud, providing sub-50ms decisions and case management for analysts while ensuring compliance, auditability, and high availability.")

Rel(Payers, Real-Time Payment Fraud Screening System, "Initiates transactions evaluated for fraud", "HTTPS")
Rel(Fraud Analysts, Real-Time Payment Fraud Screening System, "Manages and investigates fraud cases", "HTTPS")
Rel(Risk Managers/Quants, Real-Time Payment Fraud Screening System, "Configures risk parameters and monitors system metrics", "HTTPS")
Rel(Payment Gateway/Acquirer, Real-Time Payment Fraud Screening System, "Sends real-time transaction screening requests", "HTTPS/gRPC via mTLS (TLS 1.3)")
Rel(Fraud Analysts, Identity Provider (IdP), "Authenticates via OAuth2/OIDC for RBAC", "HTTPS")
Rel(Real-Time Payment Fraud Screening System, Audit and Storage Service, "Stores tamper-evident logs", "AWS KMS and Amazon S3 Object Lock")

@enduml