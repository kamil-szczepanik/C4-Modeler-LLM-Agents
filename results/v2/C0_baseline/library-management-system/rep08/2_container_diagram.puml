@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(LibraryMemberPatron, "Library Member (Patron)", "Patron using self-service portals and library services.")
Person(LibrarianStaff, "Librarian/Staff", "Staff managing circulation and library operations.")
Person(LibraryAdministrator, "Library Administrator", "Administrator managing the system.")

System_Ext(EUIdentityProvider, "EU Identity Provider", "External provider handling authentication.")
System_Ext(EUPaymentGateway, "EU Payment Gateway", "External gateway handling financial transactions.")
System_Ext(EUhostedLogTelemetryAggregator, "EU-hosted Log & Telemetry Aggregator", "Aggregator collecting Prometheus metrics and sanitized JSON logs.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(APIGateway, "API Gateway", "NGINX / Envoy", "Handles edge routing and TLS termination.")
    Container(PatronWebApp, "Patron Web App", "React / TypeScript, NGINX", "Provides self-service portals for patrons.")
    Container(CatalogSearchService, "Catalog & Search Service", "Kotlin / Spring Boot", "Manages cataloging and high-performance search workloads.")
    Container(CirculationPaymentsService, "Circulation & Payments Service", "Java 17 / Spring Boot", "Manages circulation and processes payments.")
    Container(AdminReportingService, "Admin & Reporting Service", "Python / FastAPI", "Manages administrative tasks and reporting workloads.")
    ContainerDb(PostgreSQL, "PostgreSQL", "PostgreSQL (EU-hosted)", "Stores transactional data.")
    ContainerDb(Elasticsearch, "Elasticsearch", "Elasticsearch", "Provides search indexing and capabilities.")
}

Rel(LibraryMemberPatron, APIGateway, "Accesses portals and services", "HTTPS (TLS 1.3)")
Rel(LibrarianStaff, APIGateway, "Accesses circulation and library operations", "HTTPS (TLS 1.3)")
Rel(LibraryAdministrator, APIGateway, "Accesses administrative functions", "HTTPS (TLS 1.3)")
Rel(PatronWebApp, APIGateway, "Communicates with internal microservices", "gRPC over a private network")
Rel(APIGateway, CatalogSearchService, "Routes catalog and search requests", "gRPC / mTLS (Istio)")
Rel(APIGateway, CirculationPaymentsService, "Routes circulation and payment requests", "gRPC / mTLS (Istio)")
Rel(APIGateway, AdminReportingService, "Routes admin and reporting requests", "gRPC / mTLS (Istio)")
Rel(CirculationPaymentsService, EUPaymentGateway, "Connects to process payments", "HTTPS/REST")
Rel(CatalogSearchService, Elasticsearch, "Queries search index", "Database Protocol")
Rel(CirculationPaymentsService, PostgreSQL, "Reads and writes transactional data", "Database Protocol")
Rel(AdminReportingService, PostgreSQL, "Reads transactional data for reports", "Database Protocol")
Rel(CatalogSearchService, EUhostedLogTelemetryAggregator, "Ships Prometheus metrics and sanitized JSON logs", "TLS")
Rel(CirculationPaymentsService, EUhostedLogTelemetryAggregator, "Ships Prometheus metrics and sanitized JSON logs", "TLS")
Rel(AdminReportingService, EUhostedLogTelemetryAggregator, "Ships Prometheus metrics and sanitized JSON logs", "TLS")

@enduml