@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(LibraryMemberPatron, "Library Member (Patron)", "Patron using self-service portals and library services.")
Person(LibrarianStaff, "Librarian / Staff", "Staff managing circulation and library operations with mandatory MFA.")
Person(LibraryAdministrator, "Library Administrator", "Administrator managing the system with mandatory MFA.")

System(LibraryManagementSystem, "Library Management System", "Provides cataloging, circulation management, and self-service portals with high performance and strict EU-only data residency compliance.")

System_Ext(EUIdentityProvider, "EU Identity Provider", "SaaS provider handling authentication via OAuth2/OIDC.")
System_Ext(EUPaymentGateway, "EU Payment Gateway", "External payment gateway handling financial transactions via REST / HTTPS.")
System_Ext(EUhostedLogTelemetryAggregator, "EU-hosted Log & Telemetry Aggregator", "Aggregator collecting logs and telemetry data via Syslog / TLS.")

Rel(LibraryMemberPatron, LibraryManagementSystem, "Accesses portals and services", "HTTPS (TLS 1.3)")
Rel(LibrarianStaff, LibraryManagementSystem, "Manages circulation and library operations", "HTTPS (TLS 1.3)")
Rel(LibraryAdministrator, LibraryManagementSystem, "Performs system administration", "HTTPS (TLS 1.3)")
Rel(LibraryManagementSystem, EUIdentityProvider, "Authenticates users", "OIDC / HTTPS")
Rel(LibraryManagementSystem, EUPaymentGateway, "Processes payments", "REST / HTTPS with asynchronous queueing")
Rel(LibraryManagementSystem, EUhostedLogTelemetryAggregator, "Sends logs and telemetry", "Syslog / TLS")
@enduml