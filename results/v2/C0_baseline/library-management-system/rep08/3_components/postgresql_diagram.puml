@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(postgresql, "PostgreSQL") {
    Component(Primary Database, "Primary Database", "PostgreSQL 15+", "Primary transactional datastore for ACID compliance and structured catalog/user data.")
    Component(Read Replica, "Read Replica", "PostgreSQL 15+ Read Replica", "Handles heavy reporting queries isolated from write-heavy transactional workloads.")
    Component(PgBouncer, "PgBouncer", "PgBouncer", "Connection pooling to prevent worker exhaustion.")
    Component(pgaudit Extension, "pgaudit Extension", "pgaudit", "In-process auditing extension for GDPR compliance.")
    Component(CloudNativePG Operator, "CloudNativePG Operator", "CloudNativePG Kubernetes Operator", "Provides high availability, automated failover (<30s RTO), and multi-AZ EU deployment.")
}

Rel(PgBouncer, Primary Database, "Routes transactional queries via mTLS and native Postgres wire protocol", "TCP/5432")
Rel(PgBouncer, Read Replica, "Routes read-only reporting queries via mTLS", "TCP/5432")
Rel(CloudNativePG Operator, Primary Database, "Manages lifecycle, automated failover, and high availability", "")
Rel(pgaudit Extension, Primary Database, "Audits database activities for GDPR compliance", "")
Rel(Primary Database, Read Replica, "Replicates transactional data", "")

@enduml