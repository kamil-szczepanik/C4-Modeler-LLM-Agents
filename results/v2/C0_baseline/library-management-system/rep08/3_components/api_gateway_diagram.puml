@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(edge_tls_terminator_router_component, "Edge TLS Terminator & Router Component", "Envoy Proxy", "Serves as the secure, high-performance edge entry point handling TLS 1.3 termination and routing.")
    Component(jwt_authentication_rbac_filter_component, "JWT Authentication & RBAC Filter Component", "Envoy native envoy.filters.http.jwt_authn", "Validates JSON Web Tokens from the EU Identity Provider and enforces Role-Based Access Control.")
    Component(request_validation_versioning_filter_component, "Request Validation & Versioning Filter Component", "Envoy Filter", "Validates incoming request structures and handles API versioning.")
    Component(rate_limiting_filter_component, "Rate Limiting Filter Component", "Envoy Filter & Redis Cluster", "Evaluates traffic quotas using a token bucket algorithm backed by an EU-hosted Redis Cluster to protect SLAs.")
}

Rel(edge_tls_terminator_router_component, jwt_authentication_rbac_filter_component, "Forwards requests", "In-memory")
Rel(jwt_authentication_rbac_filter_component, request_validation_versioning_filter_component, "Passes validated claims", "In-memory")
Rel(request_validation_versioning_filter_component, rate_limiting_filter_component, "Evaluates quotas", "gRPC")

@enduml