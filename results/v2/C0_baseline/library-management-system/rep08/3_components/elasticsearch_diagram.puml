@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(Elasticsearch, "Elasticsearch") {
    Component(REST_API_Transport_Layer, "REST API / Transport Layer", "HTTP/2 over TLS, Port 9200", "Handles incoming REST requests and JSON payloads from the Catalog & Search Service.")
    Component(Query_DSL_Search_Engine, "Query DSL & Search Engine", "Elasticsearch Query DSL", "Processes search queries, executes optimized querying, and handles replica routing to meet strict latency requirements.")
    Component(Index_Storage_Engine, "Index & Storage Engine", "Lucene", "Underlying storage and indexing engine providing high-performance search capabilities.")
    Component(Index_Lifecycle_Management_ILM_Engine, "Index Lifecycle Management (ILM) Engine", "Elasticsearch ILM", "Manages index tiering and lifecycle policies to support performance and data retention.")
    Component(Cluster_Coordination_Node_Management, "Cluster Coordination & Node Management", "Elasticsearch 8.x Cluster", "Manages multi-zone deployment across 3 availability zones in an EU cloud region.")
}

Rel(REST_API_Transport_Layer, Query_DSL_Search_Engine, "Forwards requests for query parsing and execution")
Rel(Query_DSL_Search_Engine, Index_Storage_Engine, "Retrieves and indexes search data")
Rel(Index_Lifecycle_Management_ILM_Engine, Index_Storage_Engine, "Applies lifecycle and tiering policies to indices")
Rel(Cluster_Coordination_Node_Management, REST_API_Transport_Layer, "Manages node health and routing across the cluster")
@enduml