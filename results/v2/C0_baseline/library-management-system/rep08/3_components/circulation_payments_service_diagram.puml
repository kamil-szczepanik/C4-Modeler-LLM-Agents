@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(circulation_payments_service, "Circulation & Payments Service") {
    Component(CirculationRESTControllerComponent, "Circulation REST Controller Component", "Java 17 / Spring Boot", "Handles incoming HTTP/REST requests related to circulation and payments.")
    Component(CirculationEngineComponent, "Circulation Engine Component", "Java 17 / Spring Boot", "Manages library item borrowing, returns, holds, and business logic.")
    Component(PaymentProcessingComponent, "Payment Processing Component", "Java 17 / Spring Boot / Resilience4j", "Processes fine payments and interacts with external payment gateways.")
    Component(TransactionalOutboxPublisherComponent, "Transactional Outbox Publisher Component", "Java 17 / Spring Boot / Spring Data JPA", "Publishes domain events to Kafka using the Transactional Outbox Pattern.")
}

System_Ext(EUPaymentGateway, "EU Payment Gateway", "External payment gateway for processing fine payments.")
System_Ext(PostgreSQL, "PostgreSQL", "Relational database for persisting transactional state.")
System_Ext(ApacheKafka, "Apache Kafka", "Event streaming platform for publishing domain events.")
System_Ext(EUHostedLogTelemetryAggregator, "EU-hosted Log & Telemetry Aggregator", "Aggregates Prometheus metrics and sanitized JSON logs.")

Rel(CirculationRESTControllerComponent, CirculationEngineComponent, "Invokes methods", "In-process / Java Method Calls")
Rel(CirculationRESTControllerComponent, PaymentProcessingComponent, "Invokes methods", "In-process / Java Method Calls")
Rel(PaymentProcessingComponent, EUPaymentGateway, "Processes transactions", "HTTPS/REST")
Rel(CirculationEngineComponent, PostgreSQL, "Persists transactional state", "JDBC")
Rel(PaymentProcessingComponent, PostgreSQL, "Persists transactional state", "JDBC")
Rel(TransactionalOutboxPublisherComponent, ApacheKafka, "Publishes domain events", "Kafka Protocol / TLS")
Rel(circulation_payments_service, EUHostedLogTelemetryAggregator, "Ships Prometheus metrics and sanitized JSON logs", "TLS")

@enduml