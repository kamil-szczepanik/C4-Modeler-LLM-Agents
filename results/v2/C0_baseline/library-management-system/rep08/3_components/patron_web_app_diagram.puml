@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patron Web App container

Container_Boundary(patron_web_app, "Patron Web App") {
    Component(search_discovery_ui, "Search & Discovery UI", "React", "Enables library members to execute searches and discover items.")
    Component(account_circulation_manager, "Account & Circulation Manager", "React", "Allows users to manage circulation and account details, processing fines and payments.")
    Component(localization_accessibility_engine, "Localization & Accessibility Engine", "React", "Ensures compliance with public library accessibility and localization mandates.")
    Component(bff_security_session_manager, "BFF Security & Session Manager", "Node.js", "Manages secure server-side session state and HttpOnly cookies to mitigate XSS risks.")
}

Component(api_gateway, "API Gateway", "NGINX / Envoy", "Routes requests between the BFF and backend services securely.")
Component(eu_identity_provider, "EU Identity Provider", "External", "Authenticates users via OIDC/OAuth 2.0 authorization code flow with PKCE.")
Component(eu_payment_gateway, "EU Payment Gateway", "External", "Processes fines and payments securely.")

Rel(patron_web_app, api_gateway, "Communicates via gRPC over a private network", "gRPC")
Rel(patron_web_app, eu_identity_provider, "Authenticates users via OIDC/OAuth 2.0 authorization code flow with PKCE", "HTTPS")
Rel(account_circulation_manager, eu_payment_gateway, "Processes fines and payments securely via the API Gateway", "HTTPS")

@enduml