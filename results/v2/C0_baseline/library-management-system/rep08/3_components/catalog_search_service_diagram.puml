@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog & Search Service container

Container_Boundary(catalog_and_search_service, "Catalog & Search Service") {
    Component(SearchController, "Search Controller", "Kotlin / Spring Boot (@RestController)", "Handles incoming search and catalog requests via gRPC / mTLS.")
    Component(CatalogManagementController, "Catalog Management Controller", "Kotlin / Spring Boot (@RestController)", "Handles item record mutations via JDBC.")
    Component(SearchService, "Search Service", "Kotlin / Spring Boot (@Service)", "Executes in-process validation, query handling, typo tolerance, and scoring.")
    Component(CatalogDataSynchronizer, "Catalog Data Synchronizer", "Kotlin / Spring Boot (@Component)", "Asynchronously indexes data via CDC.")
    Component(ElasticsearchClient, "Elasticsearch Client", "Kotlin / Spring Boot (RestHighLevelClient / ElasticsearchRestTemplate)", "Executes in-process query building and aggregation against Elasticsearch.")
}

System_Ext(PostgreSQL, "PostgreSQL", "Relational datastore for persistent catalog mutation storage")
System_Ext(EU_hosted_Log_Telemetry_Aggregator, "EU-hosted Log & Telemetry Aggregator", "Telemetry aggregator")

Rel(SearchController, SearchService, "In-process validation and query handling")
Rel(SearchService, ElasticsearchClient, "In-process query building and aggregation")
Rel(CatalogManagementController, PostgreSQL, "Mutates item records via JDBC", "JDBC")
Rel(CatalogDataSynchronizer, ElasticsearchClient, "Asynchronously indexes data via CDC")
Rel(catalog_and_search_service, EU_hosted_Log_Telemetry_Aggregator, "Ships Prometheus metrics and sanitized JSON logs via TLS", "TLS")

@enduml