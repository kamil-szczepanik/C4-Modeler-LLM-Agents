@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Library Management System

Person(LibraryPatrons, "Library Patrons", "Students and public citizens who use the self-service portals for catalog searches and library services.")
Person(LibrariansandCirculationStaff, "Librarians and Circulation Staff", "Staff members who manage circulation, cataloging, and day-to-day library operations.")
Person(LibraryAdministrators, "Library Administrators", "Administrators responsible for managing the system and configuration.")

System(LibraryManagementSystem, "Library Management System", "Provides cataloging, circulation, and self-service portals for public and academic libraries with strict EU-only data residency and high-performance search capabilities.")

System_Ext(ExternalNotificationService, "External Notification Service", "EU-hosted service for sending notifications to patrons and staff.")
System_Ext(ExternalPaymentGateway, "External Payment Gateway", "EU-compliant gateway for processing library payments and financial records.")
System_Ext(ExternalIdentityPrvIdP, "External Identity Provider (IdP)", "Handles centralized authentication and OIDC/OAuth 2.0 token issuance.")
System_Ext(InterlibraryLoanILLNetwork, "Interlibrary Loan (ILL) Network", "External network used for cross-library catalog searches and loans.")
System_Ext(ObservabilityPlatformSIEM, "Observability Platform & SIEM", "Collects security events, logs, and telemetry data.")

Rel(LibraryPatrons, LibraryManagementSystem, "Interact with self-service portals and catalogs via Web/Mobile Clients", "HTTPS, OIDC/OAuth 2.0")
Rel(LibrariansandCirculationStaff, LibraryManagementSystem, "Manage circulation and system operations", "HTTPS, OIDC/OAuth 2.0")
Rel(LibraryAdministrators, LibraryManagementSystem, "Administer system settings and users", "HTTPS, OIDC/OAuth 2.0")
Rel(LibraryManagementSystem, ExternalNotificationService, "Send notifications to users", "REST/JSON over TLS 1.3")
Rel(LibraryManagementSystem, ExternalPaymentGateway, "Process payments and financial records", "REST/JSON over TLS 1.3")
Rel(LibraryManagementSystem, ExternalIdentityPrvIdP, "Authenticate users and issue RBAC tokens", "OpenID Connect (OIDC) / OAuth 2.0")
Rel(LibraryManagementSystem, InterlibraryLoanILLNetwork, "Perform cross-library catalog searches", "HTTPS/REST")
Rel(LibraryManagementSystem, ObservabilityPlatformSIEM, "Stream security events and telemetry", "TLS 1.3 / mTLS")

@enduml