@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration/Messaging Container container

Container_Boundary(integration_messaging_container, "Integration/Messaging Container") {
    Component(circulation_events, "circulation.events", "Apache Kafka Topic", "Handles asynchronous circulation events for the library system.")
    Component(catalog_events, "catalog.events", "Apache Kafka Topic", "Handles asynchronous catalog update events.")
    Component(circulation_dlq, "circulation.dlq", "Apache Kafka Dead-Letter Queue", "Captures failed circulation events for manual resolution and troubleshooting.")
}

System_Ext(staff_management_api, "Staff Management API", "External system producing domain events.")
System_Ext(notification_dispatcher, "Notification Dispatcher", "External system consuming notification events.")
System_Ext(search_engine, "Search Engine", "External system consuming catalogue updates.")

Rel(staff_management_api, circulation_events, "Produces domain events", "Kafka TCP binary protocol, mTLS, SASL/SCRAM-512")
Rel(staff_management_api, catalog_events, "Produces domain events", "Kafka TCP binary protocol, mTLS, SASL/SCRAM-512")
Rel(circulation_events, notification_dispatcher, "Consumes notification events", "Kafka Consumer Group, TCP, mTLS")
Rel(catalog_events, search_engine, "Feeds catalogue updates", "Kafka Connect Sink connector, TCP")
Rel(circulation_dlq, staff_management_api, "Exposes manual resolution interface", "HTTP REST")

@enduml