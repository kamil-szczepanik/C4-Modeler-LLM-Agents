@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(notification_dispatcher, "Notification Dispatcher") {
    Component(EventConsumerWorker, "Event Consumer Worker", "Go, segmentio/kafka-go", "Consumes events via Kafka Protocol with SASL/SCRAM-512 & mTLS.")
    Component(NotificationRouterTemplateEngine, "Notification Router & Template Engine", "Go, in-process logic", "Routes payloads via in-process Go function calls.")
    Component(DLQHandlerRetryInterceptor, "DLQ Handler / Retry Interceptor", "Go middleware", "Routes poisoned messages to Kafka DLQ Topic with PII sanitization.")
    Component(DispatchClient, "Dispatch Client", "Go, net/http with gofeature/gobreaker", "Dispatches alerts via REST/JSON over TLS 1.3 with certificate pinning.")
    Component(TelemetryExporter, "Telemetry Exporter", "Go, OpenTelemetry Go SDK", "Streams metrics via OpenTelemetry (OTel) / Prometheus over TLS.")
    Component(ConfigurationSecretsManagerClient, "Configuration & Secrets Manager Client", "Go", "Manages configuration and secrets for the worker service.")
}

Component(IntegrationMessagingContainer, "Integration/Messaging Container", "Managed Apache Kafka, EU-hosted", "External messaging container for event-driven messaging.")
Component(ExternalNotificationService, "External Notification Service", "External Service", "Receives dispatched alerts and notifications.")
Component(ObservabilityPlatformSIEM, "Observability Platform & SIEM", "OpenTelemetry / Prometheus", "Collects telemetry and security information.")

Rel(IntegrationMessagingContainer, EventConsumerWorker, "Consumes events", "Kafka Protocol with SASL/SCRAM-512 & mTLS")
Rel(EventConsumerWorker, NotificationRouterTemplateEngine, "Passes events", "in-process Go function calls")
Rel(NotificationRouterTemplateEngine, DispatchClient, "Routes payload", "in-process calls")
Rel(DispatchClient, ExternalNotificationService, "Dispatches alerts", "REST/JSON over TLS 1.3 with certificate pinning")
Rel(DLQHandlerRetryInterceptor, IntegrationMessagingContainer, "Routes poisoned messages", "Kafka DLQ Topic with PII sanitization")
Rel(TelemetryExporter, ObservabilityPlatformSIEM, "Streams metrics", "OpenTelemetry (OTel) / Prometheus over TLS")
@enduml