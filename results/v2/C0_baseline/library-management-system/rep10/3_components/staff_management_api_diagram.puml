@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(staff_management_api, "Staff Management API") {
    Component(Circulation_Controller_Service, "Circulation Controller & Service", "Java / Spring Boot", "Handles loans, fines, and fast-path check-outs.")
    Component(Catalog_Management_Service, "Catalog Management Service", "Java / Spring Boot", "Manages physical and digital item cataloging and bulk imports.")
    Component(Payment_ILL_Client_Adapters, "Payment & ILL Client Adapters", "Java / Spring Boot, Resilience4j", "Encapsulates outbound traffic to external systems and implements circuit breakers.")
    Component(Data_Masking_Component, "Data Masking Component", "Java / Spring Boot", "Strips or pseudonymizes patron PII for cross-border transit.")
    Component(Bulk_Processing_Asynchronous_Worker_Component, "Bulk Processing & Asynchronous Worker Component", "Java / Spring Boot, Managed Apache Kafka", "Offloads heavy tasks to messaging brokers.")
}

Component_Ext(API_Gateway, "API Gateway", "gRPC over mTLS", "External system routing staff traffic to the Staff Management API.")
Component_Ext(Managed_PostgreSQL, "Managed PostgreSQL", "PostgreSQL Protocol, Spring Data JPA", "Stores transactional data with AES-256 encryption hosted exclusively in the EU.")
Component_Ext(Managed_Apache_Kafka, "Managed Apache Kafka", "AMQP/Kafka protocols", "Enables asynchronous decoupling for high-throughput bulk catalog operations.")
Component_Ext(External_Payment_Gateway, "External Payment Gateway", "REST/JSON over TLS 1.3", "Processes library payments.")
Component_Ext(External_Identity_Provider_IdP, "External Identity Provider (IdP)", "OpenID Connect (OIDC) / OAuth 2.0", "Authenticates staff.")
Component_Ext(Interlibrary_Loan_ILL_Network, "Interlibrary Loan (ILL) Network", "HTTPS/REST", "Performs cross-border searches.")
Component_Ext(Observability_Platform_SIEM, "Observability Platform & SIEM", "OpenTelemetry / Prometheus over TLS", "Streams metrics and traces.")

Rel(API_Gateway, Circulation_Controller_Service, "Routes staff traffic", "gRPC over mTLS")
Rel(Circulation_Controller_Service, Managed_PostgreSQL, "Reads and writes transactional data", "PostgreSQL Protocol / Spring Data JPA")
Rel(Catalog_Management_Service, Managed_Apache_Kafka, "Publishes asynchronous events", "AMQP/Kafka protocols")
Rel(Payment_ILL_Client_Adapters, External_Payment_Gateway, "Processes library payments", "REST/JSON over TLS 1.3")
Rel(Circulation_Controller_Service, External_Identity_Provider_IdP, "Authenticates staff", "OpenID Connect / OAuth 2.0")
Rel(Payment_ILL_Client_Adapters, Interlibrary_Loan_ILL_Network, "Performs cross-border searches", "HTTPS/REST")
Rel(Bulk_Processing_Asynchronous_Worker_Component, Observability_Platform_SIEM, "Streams metrics and traces", "OpenTelemetry / Prometheus")
Rel(Data_Masking_Component, Payment_ILL_Client_Adapters, "Strips or pseudonymizes patron PII", "Internal")

@enduml