@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patron Web App & API container

Container_Ext(api_gateway, "API Gateway", "Kong/Envoy", "Routes traffic via gRPC over mTLS.")
Container(patron_web_app_api, "Patron Web App & API", "Next.js SSR/React", "Provides secure, self-service cataloging, circulation, and account management for library patrons.")
ContainerDb(database, "Database", "Managed PostgreSQL, EU-hosted, AES-256 encrypted", "Provides encrypted, EU-resident persistence.")
Container(search_engine, "Search Engine", "Managed OpenSearch/Elasticsearch, EU-hosted", "Queries catalog data to meet high-performance search requirements.")
Container(integration_messaging_container, "Integration/Messaging Container", "Managed Apache Kafka / Amazon MQ, EU-hosted", "Handles asynchronous messaging and event streaming.")
System_Ext(external_payment_gateway, "External Payment Gateway", "External Service", "Processes payments securely.")
System_Ext(external_identity_provider_idp, "External Identity Provider (IdP)", "OIDC / OAuth 2.0", "Handles user authentication.")

Container_Boundary(patron_web_app_api_boundary, "Patron Web App & API") {
    Component(patron_ui_component, "Patron UI Component", "Next.js SSR/React", "Powers SSR and frontend UI components for optimal performance and frictionless user experiences.")
    Component(patron_api_controller, "Patron API Controller", "Node.js/Express", "Handles backend API logic, request validation, and orchestrates requests.")
    Component(patron_profile_preferences_component, "Patron Profile & Preferences Component", "TypeScript/React Hook Form", "Manages patron profiles and preferences with type safety.")
    Component(payment_client, "Payment Client", "TypeScript SDK/HTTPS", "Isolates payment processing to reduce PCI-DSS security scope and communicate with the external payment gateway.")
    Component(notification_event_publisher, "Notification Event Publisher", "Node.js Kafka Client", "Streams asynchronous notification events to decouple tasks from real-time patron actions.")
    Component(database_client, "Database Client", "Prisma/TypeORM", "Manages secure database queries ensuring data residency compliance.")
}

Rel(api_gateway, patron_web_app_api, "Routes traffic via gRPC over mTLS", "gRPC / mTLS")
Rel(patron_ui_component, patron_api_controller, "Internal HTTP/RPC", "HTTP/RPC")
Rel(patron_profile_preferences_component, patron_api_controller, "Internal HTTP/RPC", "HTTP/RPC")
Rel(patron_api_controller, payment_client, "Delegates payment processing", "Internal")
Rel(payment_client, external_payment_gateway, "Processes payments via HTTPS/REST", "HTTPS/REST")
Rel(patron_api_controller, notification_event_publisher, "Publishes notification events", "Internal")
Rel(notification_event_publisher, integration_messaging_container, "Streams events via Kafka Protocol over TLS", "Kafka Protocol / TLS")
Rel(patron_api_controller, database_client, "Executes data queries", "Internal")
Rel(database_client, database, "Reads/writes data via PostgreSQL Protocol over TLS 1.3", "PostgreSQL Protocol / TLS 1.3")
Rel(patron_web_app_api, search_engine, "Queries catalog via HTTPS/REST", "HTTPS/REST")
Rel(patron_web_app_api, external_identity_provider_idp, "Authenticates via OIDC / OAuth 2.0", "OIDC / OAuth 2.0")

@enduml