@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Search Engine container

System_Ext(PatronWebAppAPIStaffManagementAPI, "Patron Web App & API / Staff Management API", "Upstream clients querying the search engine.")
System_Ext(IntegrationMessagingContainer, "Integration/Messaging Container", "Streams catalogue updates.")
System_Ext(ObservabilityPlatformSIEM, "Observability Platform & SIEM", "Receives scrubbed query logs, audit trails, and performance metrics.")

Container_Boundary(SearchEngine, "Search Engine") {
    Component(QueryParserRouter, "Query Parser & Router", "Java/Spring", "Translates REST queries, enforces RBAC, Document-Level Security (DLS), OAuth2/JWT validation, and query sanitization.")
    Component(IndexManagementService, "Index Management Service", "Java", "Handles bulk indexing, schema updates, zero-downtime index aliasing, and Synonym/Linguistic Analysis pipelines.")
    Component(SearchStorageNode, "Search Storage Node", "Managed OpenSearch Cluster, EU-hosted", "Core index store with AES-256 encryption at rest and automated EU-only geo-redundant snapshots.")
}

Rel(PatronWebAppAPIStaffManagementAPI, QueryParserRouter, "Queries catalogue", "HTTPS/REST with mTLS and OAuth2/JWT")
Rel(IntegrationMessagingContainer, IndexManagementService, "Consumes catalogue update events", "Kafka Protocol")
Rel(QueryParserRouter, SearchStorageNode, "Executes search DSL", "Transport Protocol over TLS 1.3")
Rel(QueryParserRouter, ObservabilityPlatformSIEM, "Forwards audit logs and slow-query metrics", "HTTPS/Syslog")

@enduml