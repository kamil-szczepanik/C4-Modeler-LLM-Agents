@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(Database, "Database") {
    Component(Connection_Pooler_Component, "Connection Pooler Component", "PgBouncer", "Manages queries and connection management.")
    Component(PostgreSQL_Database_Engine_Component, "PostgreSQL Database Engine Component", "Managed PostgreSQL, AES-256 encrypted, Logical schemas (patron_data, inventory, transactions)", "Relational storage handling data persistence and proxies authenticated traffic.")
    Component(Audit_Logging___Security_Component, "Audit Logging & Security Component", "PostgreSQL pgcrypto", "Handles pgcrypto encryption and telemetry.")
}

System_Ext(Observability_Platform___SIEM, "Observability Platform & SIEM", "Captures logs, metrics, and audit events.")

Rel(Connection_Pooler_Component, PostgreSQL_Database_Engine_Component, "Proxies authenticated traffic", "TCP/IP")
Rel(PostgreSQL_Database_Engine_Component, Observability_Platform___SIEM, "Forwards audit logs and metrics", "Syslog/TLS")
@enduml