@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Asynchronous Processing Worker container

Container_Boundary(asynchronous_processing_worker, "Asynchronous Processing Worker") {
    Component(Message Consumer Component, "Message Consumer Component", "MassTransit [.NET]", "Pulls asynchronous jobs from the message broker and handles message consumption, retry policies, and dead-letter queue handling.")
    Component(Workflow Orchestrator Component, "Workflow Orchestrator Component", "C# domain logic", "Invokes task handlers and orchestrates backend business logic.")
    Component(Notification Dispatcher Component, "Notification Dispatcher Component", "HttpClient with Polly", "Triggers patron alerts and forwards outbound requests with resilience patterns.")
    Component(Audit Logging Interceptor Component, "Audit Logging Interceptor Component", "Serilog with structured enrichment", "Dispatches domain events for structured logging and PII-sanitized audit trails.")
}

Component(Message Broker, "Message Broker", "RabbitMQ / Redis", "Provides message queueing and brokering services.")
Component(Integration Gateway, "Integration Gateway", "Kong / Envoy", "Proxies and secures outbound requests.")
Component(EU Notification Service, "EU Notification Service", "External Service", "Receives patron notifications while adhering to EU-only data residency constraints.")
Component(Central Logging & Monitoring SIEM, "Central Logging & Monitoring SIEM", "SIEM", "Collects structured audit payloads and centralized logs.")

Rel(Message Consumer Component, Message Broker, "Pulls asynchronous jobs", "AMQP/TCP with payload encryption and SCRAM-SHA-512/mTLS")
Rel(Message Consumer Component, Workflow Orchestrator Component, "Invokes task handlers", "In-Memory")
Rel(Workflow Orchestrator Component, Notification Dispatcher Component, "Triggers patron alerts", "In-Memory")
Rel(Notification Dispatcher Component, Integration Gateway, "Forwards outbound requests", "HTTPS/REST with mTLS and Polly circuit breaker")
Rel(Workflow Orchestrator Component, Audit Logging Interceptor Component, "Dispatches domain events", "In-Memory Event Bus")
Rel(Audit Logging Interceptor Component, Central Logging & Monitoring SIEM, "Ships structured audit payloads", "OTLP/gRPC over TLS 1.3")
Rel(Integration Gateway, EU Notification Service, "Routes notification payloads to the external service", "HTTPS")

@enduml