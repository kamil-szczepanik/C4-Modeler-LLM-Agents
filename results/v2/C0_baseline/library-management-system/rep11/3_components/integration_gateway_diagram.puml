@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(integration_gateway, "Integration Gateway") {
    Component(api_router_component, "API Router Component", "Kong/Envoy Core", "Routes, secures, and manages all ingress and egress traffic for public and academic library portals.")
    Component(authentication_authorization_plugin_component, "Authentication & Authorization Plugin Component", "Kong/Envoy Plugin", "Validates OAuth2/OIDC tokens and handles authentication and authorization for incoming requests.")
    Component(data_residency_enforcement_plugin, "Data Residency Enforcement Plugin", "Kong/Envoy Plugin", "Enforces strict EU data residency constraints on all data traffic.")
    Component(transformation_header_injection_component, "Transformation & Header Injection Component", "Kong/Envoy Plugin", "Transforms payloads and injects required headers for downstream and upstream communication.")
    Component(circuit_breaker_resilience_component, "Circuit Breaker & Resilience Component", "Kong/Envoy Plugin", "Protects backend search performance and downstream services from cascading failures.")
}

Rel(api_router_component, authentication_authorization_plugin_component, "Delegates request validation")
Rel(api_router_component, data_residency_enforcement_plugin, "Checks data residency compliance")
Rel(api_router_component, transformation_header_injection_component, "Transforms and enriches requests")
Rel(api_router_component, circuit_breaker_resilience_component, "Applies resilience patterns to outbound calls")

@enduml