@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database container

System_Ext(catalog_api, "Catalog API & Search Service", "External system interacting with the database")
System_Ext(librarian_workbench, "Librarian Workbench", "External system interacting with the database")

Container_Boundary(database_container, "Database") {
    Component(Primary_Database_Instance, "Primary Database Instance", "PostgreSQL, GIN indexes, pgAudit, pg_stat_statements", "Handles relational data, full-text search, compliance logging, and performance monitoring.")
    Component(Read_Replica, "Read Replica", "Asynchronous PostgreSQL replica", "Executes institutional reporting queries and receives streamed WAL data for asynchronous replication.")
    Component(Core_Domain_Schema, "Core Domain Schema", "PostgreSQL Schema", "Stores core relational data and GIN indices for catalogue circulation and searches.")
    Component(Audit_Log_Schema, "Audit Log Schema", "PostgreSQL Schema", "Stores immutable override transactions for compliance.")
    Component(Archival_Schema, "Archival Schema", "PostgreSQL Schema", "Handles long-term data archival.")
    Component(PgBouncer, "PgBouncer", "PgBouncer Connection Pooler", "Manages connection pooling to prevent resource exhaustion.")
    Component(Cloud_Native_PG_operator, "Cloud Native PG operator", "Cloud Native PG", "Manages automated multi-AZ high availability and failover.")
}

Rel(catalog_api, Core_Domain_Schema, "Queries/updates relational data and GIN indices", "TCP/SSL via Npgsql")
Rel(librarian_workbench, Audit_Log_Schema, "Writes immutable override transactions", "TCP/SSL")
Rel(librarian_workbench, Read_Replica, "Executes institutional reporting queries", "TCP/SSL")
Rel(Primary_Database_Instance, Read_Replica, "Streams WAL data for asynchronous replication", "TCP/SSL via mTLS")

@enduml