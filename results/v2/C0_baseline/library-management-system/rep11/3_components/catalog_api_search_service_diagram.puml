@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog API & Search Service container

Container_Boundary(catalog_api_search_service, "Catalog API & Search Service") {
    Component(Search_Controller, "Search Controller", ".NET Core", "Handles cataloging physical and digital items and routes search requests.")
    Component(Search_Engine_Client, "Search Engine Client", ".NET Core", "Executes search queries against the OpenSearch engine.")
    Component(Catalogue_Repository, "Catalogue Repository", ".NET Core", "Mutates operational catalog data.")
    Component(Ranking_Personalization_Service, "Ranking & Personalization Service", ".NET Core", "Provides high-performance search ranking and personalization.")
    Component(OpenSearch_Engine, "OpenSearch Engine", "OpenSearch (EU Cloud Region)", "Dedicated search engine for faceted search and typo-tolerance.")
    Component(Redis_Cache_Layer, "Redis Cache Layer", "Redis", "In-memory cache for auto-complete and popular queries.")
    Component(Asynchronous_Processing_Worker, "Asynchronous Processing Worker", ".NET Core Worker Service", "Synchronizes data to the search engine using the outbox event pattern.")
}

Rel(Search_Controller, Redis_Cache_Layer, "Checks cached auto-complete/queries", "RESP over TLS")
Rel(Search_Controller, Search_Engine_Client, "Executes search queries", "Internal RPC")
Rel(Search_Engine_Client, OpenSearch_Engine, "Queries catalog indexes", "HTTPS / TLS 1.3")
Rel(Catalogue_Repository, PostgreSQL, "Mutates operational data", "Encrypted SQL")
Rel(Asynchronous_Processing_Worker, OpenSearch_Engine, "Synchronizes data", "Outbox Event Pattern")

@enduml