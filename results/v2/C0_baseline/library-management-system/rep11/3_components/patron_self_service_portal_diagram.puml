@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patron Self-Service Portal container

Container_Boundary(patron_self_service_portal, "Patron Self-Service Portal") {
    Component(Catalogue_Search_Component, "Catalogue Search Component", "React / TypeScript SPA", "Provides a highly responsive search experience meeting the <800ms performance requirement for cataloguing items.")
    Component(Account_Loan_Management_Component, "Account & Loan Management Component", "React / TypeScript SPA", "Enables EU library patrons to manage active loans and view account details.")
    Component(Fine_Payment_Component, "Fine Payment Component", "React / TypeScript SPA & Client-side SDK", "Handles fine settlement via direct client-side SDK tokenization to isolate PCI-DSS scope.")
    Component(Session_State_Coordinator, "Session State Coordinator", "OIDC/OAuth2 Client", "Coordinates session state and authentication via OIDC/OAuth2 with HttpOnly, SameSite=Strict cookies.")
    Component(ErrorBoundary_Wrapper, "ErrorBoundary Wrapper", "React / TypeScript SPA", "Catches runtime errors within the portal and ensures robust error handling.")
}

System_Ext(EU_Payment_Gateway, "EU Payment Gateway", "External EU Payment Gateway")
System_Ext(EU_Identity_Provider, "EU Identity Provider", "External EU Identity Provider")
System_Ext(Integration_Gateway, "Integration Gateway", "Kong / Envoy API Gateway")
System_Ext(Central_Logging_Monitoring_SIEM, "Central Logging & Monitoring SIEM", "SIEM for structured JSON logs and metrics")

Rel(Fine_Payment_Component, EU_Payment_Gateway, "Direct client-side SDK tokenization for payments")
Rel(Session_State_Coordinator, EU_Identity_Provider, "Authentication via OIDC/OAuth2 with HttpOnly, SameSite=Strict cookies")
Rel(patron_self_service_portal, Integration_Gateway, "API requests and payment tokens", "HTTPS / REST over TLS 1.3")
Rel(patron_self_service_portal, Central_Logging_Monitoring_SIEM, "Structured JSON logs and metrics", "OpenTelemetry")

@enduml