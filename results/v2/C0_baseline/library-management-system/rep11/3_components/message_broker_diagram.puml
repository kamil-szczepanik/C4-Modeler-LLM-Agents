@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Message Broker container

System_Ext(CatalogAPI, "Catalog API & Search Service", "External System")
System_Ext(AsyncWorker, "Asynchronous Processing Worker", "External System")
System_Ext(LibrarianWorkbench, "Librarian Workbench", "External System")
System_Ext(SIEM, "Central Logging & Monitoring SIEM", "External System")

Container_Boundary(MessageBroker_Boundary, "Message Broker") {
    Component(MessageBrokerContainer, "Message Broker Container", "RabbitMQ 3-node quorum queue cluster, Kubernetes StatefulSets", "Provides asynchronous message processing via a secure, EU-resident message broker to ensure scalable, non-blocking user journeys.")
    Component(ExchangeRouter, "Exchange Router", "AMQP", "Routes incoming messages using AMQP.")
    Component(QueueManager, "Queue Manager", "RabbitMQ, Durable Queues, DLQ, AES-256 Storage Classes", "Manages durable queues, Dead Letter Queues (DLQ), and persistent storage.")
    Component(TelemetryExporter, "Telemetry Exporter", "OpenTelemetry over HTTPS", "Strips PII and pushes metrics/logs via OpenTelemetry.")
    Component(ManagementAPI, "Management API / Exporter", "HTTPS, OAuth2/JWT RBAC", "Exposes queue metadata to the Librarian Workbench.")
}

Rel(CatalogAPI, ExchangeRouter, "Publishes asynchronous events", "AMQP/TLS with mTLS and SCRAM-SHA-512")
Rel(ExchangeRouter, QueueManager, "Routes messages to durable queues", "AMQP over TLS")
Rel(QueueManager, AsyncWorker, "Dispatches tasks", "AMQP/TLS")
Rel(LibrarianWorkbench, ManagementAPI, "Inspects queue status and triggers DLQ replays", "HTTPS/mTLS with OAuth2/JWT RBAC")
Rel(TelemetryExporter, SIEM, "Pushes metrics and structured logs", "OpenTelemetry over HTTPS with PII sanitization")

@enduml