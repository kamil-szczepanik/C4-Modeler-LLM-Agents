@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(librarian_workbench, "Librarian Workbench") {
    Component(Inventory_Management_Module, "Inventory Management Module", ".NET Core / C#", "Manages library inventory and cataloging functions.")
    Component(Payment___Fee_Module, "Payment & Fee Module", ".NET Core / C#", "Handles library fees, fines, and payment processing.")
    Component(Audit___Compliance_Module, "Audit & Compliance Module", ".NET Core / C#", "Enforces audit trails and EU-only data residency compliance.")
    Component(Notification___Messaging_Module, "Notification & Messaging Module", ".NET Core / C#", "Manages messaging and notifications for librarians and patrons.")
    Component(ASP_NET_Core_Razor_Pages___Blazor_UI_Layer, "ASP.NET Core Razor Pages / Blazor UI Layer", "ASP.NET Core Razor Pages / Blazor", "Provides the user interface for the Librarian Workbench.")
}

Rel(ASP_NET_Core_Razor_Pages___Blazor_UI_Layer, Inventory_Management_Module, "Invokes inventory operations", "")
Rel(ASP_NET_Core_Razor_Pages___Blazor_UI_Layer, Payment___Fee_Module, "Processes payments and fees", "")
Rel(ASP_NET_Core_Razor_Pages___Blazor_UI_Layer, Audit___Compliance_Module, "Triggers audit checks", "")
Rel(ASP_NET_Core_Razor_Pages___Blazor_UI_Layer, Notification___Messaging_Module, "Sends notifications", "")
@enduml