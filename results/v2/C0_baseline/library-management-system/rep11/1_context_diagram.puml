@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Library Patrons, "Library Patrons", "Members of the library accessing the self-service portal to browse, borrow, and manage items.")
Person(Librarians, "Librarians", "Circulation staff managing day-to-day library operations, loans, and inventory.")
Person(Library Administrators, "Library Administrators", "Administrators managing system configurations, users, and overall library policies.")

System(Library Management System, "Library Management System", "A comprehensive platform designed for public and academic libraries to catalogue physical and digital items, manage circulation, and provide self-service portals with strict EU data residency and high-performance search capabilities.")

System_Ext(EU Identity Provider, "EU Identity Provider", "Keycloak or Auth0 handling authentication via OIDC/OAuth2.")
System_Ext(EU Payment Gateway, "EU Payment Gateway", "Stripe EU or regional APIs handling secure financial transactions via REST API with mTLS.")
System_Ext(EU Notification Service, "EU Notification Service", "Service providing asynchronous notifications over HTTPS with mTLS.")
System_Ext(EU Cloud Region Provider, "EU Cloud Region Provider", "AWS Frankfurt/Ireland or OVHcloud providing EU-compliant cloud infrastructure and storage encryption (AES-256).")
System_Ext(Central Logging & Monitoring SIEM, "Central Logging & Monitoring SIEM", "System for non-blocking audit logging and infrastructure telemetry.")
System_Ext(Web Application Firewall (WAF), "Web Application Firewall (WAF)", "Security layer protecting incoming web traffic using TLS 1.3.")

Rel(Library Patrons, Library Management System, "Accesses self-service portal and circulation features", "HTTPS (TLS 1.3) via WAF")
Rel(Librarians, Library Management System, "Manages circulation and library items", "HTTPS (TLS 1.3) via WAF")
Rel(Library Administrators, Library Management System, "Configures and administers the platform", "HTTPS (TLS 1.3) via WAF")
Rel(Library Management System, EU Identity Provider, "Authenticates users", "OIDC/OAuth2 over HTTPS")
Rel(Library Management System, EU Payment Gateway, "Processes membership and overdue fees", "REST API over HTTPS with mTLS")
Rel(Library Management System, EU Notification Service, "Sends automated alerts and notifications", "Asynchronous REST API over HTTPS with mTLS")
Rel(Library Management System, EU Cloud Region Provider, "Hosts data and ensures EU data residency compliance", "AWS / OVHcloud infrastructure with AES-256")
Rel(Library Management System, Central Logging & Monitoring SIEM, "Sends audit logs and infrastructure telemetry", "Non-blocking event-driven logging")
@enduml