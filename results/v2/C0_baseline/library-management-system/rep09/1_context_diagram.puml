@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(LibraryPatrons, "Library Patrons", "Patrons who use the self-service portals to access digital and physical library items.")
Person(LibrariansCirculationStaff, "Librarians/Circulation Staff", "Staff members who manage daily circulation workflows and patron assistance.")
Person(LibraryAdministrators, "Library Administrators", "Administrators responsible for overseeing the library management system configuration and reports.")

System(LibraryManagementSystem, "Library Management System", "A comprehensive platform designed for public and academic libraries to catalogue physical and digital items, manage circulation, and provide self-service portals.")

System_Ext(EUIdentityRoleIdP, "EU Identity Provider (IdP)", "Handles user authentication and Multi-Factor Authentication (MFA).")
System_Ext(EUPaymentGateway, "EU Payment Gateway", "Processes financial transactions and payments securely (e.g., Adyen EU or Stripe EU).")
System_Ext(EUNotificationService, "EU Notification Service", "Handles notifications and communications via HTTPS/SMTP.")
System_Ext(EUCloudInfrastructure, "EU Cloud Infrastructure", "AWS Frankfurt/Ireland or OVHcloud providing hardware-level data residency.")
System_Ext(CentralizedLogMetricsAggregator, "Centralized Log & Metrics Aggregator", "Datadog EU or Grafana Cloud EU for observability and distributed tracing.")
System_Ext(APIGateway, "API Gateway", "Manages perimeter access, routing, and rate-limiting.")

Rel(LibraryPatrons, LibraryManagementSystem, "Interacts via self-service portal", "HTTPS/TLS 1.3")
Rel(LibrariansCirculationStaff, LibraryManagementSystem, "Manages circulation workflows", "HTTPS/TLS 1.3")
Rel(LibraryAdministrators, LibraryManagementSystem, "Administers system configurations", "HTTPS/TLS 1.3")
Rel(LibraryManagementSystem, EUIdentityRoleIdP, "Authenticates users", "OIDC/OAuth2 over HTTPS")
Rel(LibraryManagementSystem, EUPaymentGateway, "Processes payments", "REST/HTTPS")
Rel(LibraryManagementSystem, EUNotificationService, "Sends notifications", "HTTPS/SMTP")
@enduml