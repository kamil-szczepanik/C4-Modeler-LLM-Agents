@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(LibraryPatrons, "Library Patrons", "Patrons who use the self-service portals to access digital and physical library items.")
Person(LibrariansCirculationStaff, "Librarians/Circulation Staff", "Staff members who manage daily circulation workflows and patron assistance.")
Person(LibraryAdministrators, "Library Administrators", "Administrators responsible for overseeing the library management system configuration and reports.")

System_Ext(EUIdentityProvidesIdP, "EU Identity Provider (IdP)", "Handles user authentication and Multi-Factor Authentication (MFA).")
System_Ext(EUPaymentGateway, "EU Payment Gateway", "Processes financial transactions and payments securely.")
System_Ext(EUNotificationService, "EU Notification Service", "Handles notifications and communications via HTTPS/SMTP.")
System_Ext(EUCloudInfrastructure, "EU Cloud Infrastructure", "Provides hardware-level data residency and Kubernetes deployment environment.")
System_Ext(CentralizedLogMetricsAggregator, "Centralized Log & Metrics Aggregator", "For observability and distributed tracing.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(APIGateway, "API Gateway", "Nginx / Kong", "Manages perimeter access, routing, and mTLS enforcement.")
    Container(WebAppAdminPortal, "Web App / Admin Portal", "React, Node.js SSR", "Provides responsive web applications and admin portals.")
    Container(CoreServicesContainer, "Core Services Container", "Java / Spring Boot", "Handles core business logic and service orchestration.")
    Container(SearchContainer, "Search Container", "Elasticsearch", "Provides sub-second catalog discovery and search capabilities.")
    ContainerDb(DatabaseContainer, "Database Container", "PostgreSQL", "Stores relational data persistence strictly within EU regions.")
    Container(AsyncWorkerContainer, "Async Worker Container", "Python / Celery or Java", "Handles asynchronous task processing and event consumption.")
}

Rel(LibraryPatrons, WebAppAdminPortal, "Accesses self-service portals via HTTPS", "HTTPS/TLS 1.3")
Rel(LibrariansCirculationStaff, WebAppAdminPortal, "Manages circulation workflows via HTTPS", "HTTPS/TLS 1.3")
Rel(LibraryAdministrators, WebAppAdminPortal, "Administers system configurations via HTTPS", "HTTPS/TLS 1.3")
Rel(APIGateway, WebAppAdminPortal, "Routes traffic to Web App", "mTLS via gRPC/HTTPS")
Rel(APIGateway, CoreServicesContainer, "Routes traffic to Core Services", "mTLS via gRPC/HTTPS")
Rel(CoreServicesContainer, DatabaseContainer, "Queries relational data synchronously", "Database Protocol")
Rel(CoreServicesContainer, SearchContainer, "Queries catalog search index synchronously", "HTTP/REST")
Rel(CoreServicesContainer, AsyncWorkerContainer, "Publishes checkout and notification events asynchronously", "Message Broker / Queue")
Rel(CoreServicesContainer, EUIdentityProvidesIdP, "Authenticates users and validates tokens", "OIDC/OAuth2 over HTTPS")
Rel(CoreServicesContainer, EUPaymentGateway, "Processes financial transactions", "REST/HTTPS")
Rel(AsyncWorkerContainer, EUNotificationService, "Sends asynchronous notifications", "HTTPS/SMTP")
Rel(CoreServicesContainer, CentralizedLogMetricsAggregator, "Sends logs and metrics for observability", "HTTPS")

@enduml