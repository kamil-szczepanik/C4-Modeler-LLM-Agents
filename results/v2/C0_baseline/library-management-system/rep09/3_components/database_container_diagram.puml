@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(database_container, "Database Container") {
    Component(Connection Pooler, "Connection Pooler", "PgBouncer", "Manages client connections in transaction pooling mode to handle peak traffic.")
    Component(Relational Storage Engine, "Relational Storage Engine", "PostgreSQL Primary", "Provides robust ACID guarantees for circulation management and relational data persistence.")
    Component(Read-Replica Instance, "Read-Replica Instance", "PostgreSQL Read-Only Engine", "Routes analytical and reporting queries.")
    Component(Audit Logging Extension, "Audit Logging Extension", "pg_audit", "Captures DDL and DML operations synchronously for GDPR compliance and audit reporting.")
    Component(Replication Manager, "Replication Manager", "Patroni / PostgreSQL Streaming Replication", "Manages high availability, automated failover, and streaming replication across EU availability zones.")
}

Rel(Relational Storage Engine, Read-Replica Instance, "Streaming replication over TCP within EU availability zones")
Rel(Relational Storage Engine, Audit Logging Extension, "Internal hooks capturing DDL and DML operations")

@enduml