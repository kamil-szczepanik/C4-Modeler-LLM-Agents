@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Services Container container

System_Ext(eu_identity_provider, "EU Identity Provider", "Authenticates users and validates tokens [OIDC/OAuth2 over HTTPS]")
System_Ext(eu_payment_gateway, "EU Payment Gateway", "Sends payment requests [REST/HTTPS]")

Container_Boundary(core_services_container, "Core Services Container") {
    Component(api_controller, "API Controller", "Spring MVC / REST", "Exposes RESTful endpoints for library patrons, circulation staff, and administrators.")
    Component(auth_security_module, "Authentication & Security Module", "Spring Security & OAuth2", "Validates JWTs, handles OIDC/OAuth2 integration with the EU Identity Provider, and enforces RBAC.")
    Component(catalog_circulation_service, "Catalog & Circulation Service", "Java / Spring Boot", "Manages business logic for item cataloging, patron accounts, and loan circulation.")
    Component(payment_integration_client, "Payment Integration Client", "Spring Cloud OpenFeign & Resilience4j", "Processes financial transactions via the EU Payment Gateway with circuit breaker protection.")
    Component(data_access_repository, "Data Access Repository", "Spring Data JPA / Hibernate", "Handles relational data persistence and queries against the Database Container using parameterized queries.")
    Component(search_indexer_client, "Search Indexer Client", "HTTP/REST Client", "Executes catalog search queries against the Search Container to meet sub-800ms performance requirements.")
    Component(event_publisher, "Event Publisher", "Message Broker / Queue Client", "Publishes asynchronous events to the Async Worker Container.")
}

Rel(api_controller, auth_security_module, "Delegates request authentication and token validation", "")
Rel(api_controller, catalog_circulation_service, "Invokes business logic for operations", "")
Rel(catalog_circulation_service, data_access_repository, "Queries relational data", "JDBC")
Rel(catalog_circulation_service, search_indexer_client, "Queries catalog search index", "HTTP/REST")
Rel(catalog_circulation_service, event_publisher, "Publishes asynchronous events", "")
Rel(catalog_circulation_service, payment_integration_client, "Processes financial transactions", "REST/HTTPS")
Rel(auth_security_module, eu_identity_provider, "Authenticates users and validates tokens", "OIDC/OAuth2 over HTTPS")
Rel(payment_integration_client, eu_payment_gateway, "Sends payment requests", "REST/HTTPS")

@enduml