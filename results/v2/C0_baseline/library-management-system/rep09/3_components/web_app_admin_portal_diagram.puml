@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web App / Admin Portal container

System_Ext(API_Gateway, "API Gateway", "External API Gateway")
System_Ext(Centralized_Log___Metrics_Aggregator, "Centralized Log & Metrics Aggregator", "External Log and Metrics Aggregator")

Container_Boundary(web_app_admin_portal, "Web App / Admin Portal") {
    Component(SSR_Router___Auth_Middleware, "SSR Router & Auth Middleware", "Node.js SSR", "Handles server-side rendering, session routing, and security enforcement.")
    Component(Patron_Search_Component, "Patron Search Component", "React", "Provides dynamic search interface for patrons.")
    Component(Dashboard___Circulation_View, "Dashboard & Circulation View", "React", "Provides role-based UI components for staff and administrators.")
    Component(State___API_Client, "State & API Client", "React Query / Axios", "Manages client-side caching to meet sub-800ms search performance.")
}

Rel(SSR_Router___Auth_Middleware, API_Gateway, "Forwards authenticated requests via HTTPS/REST [TLS 1.3]", "HTTPS/REST")
Rel(SSR_Router___Auth_Middleware, Centralized_Log___Metrics_Aggregator, "Streams anonymized telemetry via HTTPS/OTLP", "HTTPS/OTLP")
Rel(Patron_Search_Component, State___API_Client, "Manages local data state via React state management", "React state management")
Rel(Dashboard___Circulation_View, State___API_Client, "Manages local data state via React state management", "React state management")

@enduml