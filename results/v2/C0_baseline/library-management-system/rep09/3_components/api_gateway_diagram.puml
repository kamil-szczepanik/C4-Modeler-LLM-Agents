@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Person(ExternalClients, "External Clients", "External users or systems interacting with the library management system.")
System_Ext(Redis, "Redis", "In-memory datastore for low-latency search result caching and rate-limiting.")
System_Ext(CoreServicesContainer, "Core Services Container", "Backend microservices handling core business logic.")
System_Ext(CentralizedLogMetricsAggregator, "Centralized Log & Metrics Aggregator", "Aggregates access, security audit, and trace-context logs.")

Container_Boundary(ApiGateway_Boundary, "API Gateway") {
    Component(RoutingDispatcherComponent, "Routing & Dispatcher Component", "Nginx core, Lua scripts, gRPC/HTTPS", "Handles TLS termination, internal mTLS, and gRPC/HTTPS dispatch.")
    Component(AuthenticationAuthorizationFilter, "Authentication & Authorization Filter", "Kong Plugin, OIDC", "Validates OIDC tokens from the EU Identity Provider.")
    Component(ClaimsTransformationComponent, "Claims Transformation Component", "Lua scripts", "Strips bearer tokens and injects signed internal headers.")
    Component(RateLimitingCachingComponent, "Rate Limiting & Caching Component", "Redis, Kong Plugin", "Redis-backed engine enforcing tiered limits and search caching.")
    Component(WAFThreatProtectionPlugin, "WAF & Threat Protection Plugin", "Kong Plugin", "Mitigates OWASP Top 10 injection risks.")
    Component(FluentbitSidecar, "Fluentbit Sidecar", "Fluentbit", "Streams logs asynchronously to the Centralized Log & Metrics Aggregator.")
}

Rel(ExternalClients, RoutingDispatcherComponent, "Sends encrypted traffic", "TLS 1.3")
Rel(RateLimitingCachingComponent, Redis, "Stores and retrieves search results", "Low-latency access")
Rel(RoutingDispatcherComponent, CoreServicesContainer, "Forwards requests with cryptographically signed claims", "mTLS via gRPC/HTTPS")
Rel(FluentbitSidecar, CentralizedLogMetricsAggregator, "Streams access, security audit, and W3C trace-context logs", "TLS via Fluentbit")

@enduml