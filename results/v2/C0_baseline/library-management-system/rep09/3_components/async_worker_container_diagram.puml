@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Async Worker Container container

Container_Boundary(async_worker_container, "Async Worker Container") {
    Component(Task_Dispatcher___Consumer, "Task Dispatcher / Consumer", "Python, Celery with Redis/RabbitMQ client", "Consumes background tasks and routes them internally.")
    Component(Notification_Handler_Component, "Notification Handler Component", "Python", "Dispatches alerts and reminders to external notification services.")
    Component(Circulation_Processor_Component, "Circulation Processor Component", "Python", "Manages background loan and inventory states via database connection pooling.")
    Component(DLQ_Publisher_Component, "DLQ Publisher Component", "Python, Celery retry hooks", "Emits failure events for librarian review via the message broker.")
    Component(Message_Broker, "Message Broker", "RabbitMQ / Redis", "Handles reliable event publishing and consumer queue management.")
    Component(Centralized_Log___Metrics_Aggregator, "Centralized Log & Metrics Aggregator", "Prometheus, OpenTelemetry", "Provides distributed tracing, task execution latency tracking, and metric aggregation.")
}

System_Ext(EU_Notification_Service, "EU Notification Service", "External notification service")
System_Ext(Database_Container, "Database Container", "Database for loan and inventory states")
System_Ext(Core_Services_Container, "Core Services Container", "Core system services")

Rel(Task_Dispatcher___Consumer, Notification_Handler_Component, "Routes tasks internally", "In-memory")
Rel(Task_Dispatcher___Consumer, Circulation_Processor_Component, "Routes tasks internally", "In-memory")
Rel(Notification_Handler_Component, EU_Notification_Service, "Dispatches alerts and reminders", "HTTPS")
Rel(Circulation_Processor_Component, Database_Container, "Manages background loan and inventory states", "TCP/Postgres, PgBouncer")
Rel(DLQ_Publisher_Component, Core_Services_Container, "Emits failure events for librarian review", "AMQP")

@enduml