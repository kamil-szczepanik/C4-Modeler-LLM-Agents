@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Search Container container

System_Ext(CoreServicesContainer, "Core Services Container", "External system boundary")
System_Ext(CentralizedLogMetricsAggregator, "Centralized Log & Metrics Aggregator", "External system boundary")

Container_Boundary(SearchContainer, "Search Container") {
    Component(SearchAPIController, "Search API Controller", "Java / Spring Boot", "Handles incoming synchronous search queries and routes them to the index engine.")
    Component(IndexQueryEngineElasticsearchCore, "Index & Query Engine (Elasticsearch Core)", "Elasticsearch 8.x, Lucene indices", "Multi-node cluster for distributed inverted-index lookups, faceted search, and zero-downtime aliasing.")
    Component(CatalogIndexerComponent, "Catalog Indexer Component", "Java / Spring Boot", "Manages indexes and handles bulk updates for catalogue discovery.")
    Component(SearchAnalyticsPublisher, "Search Analytics Publisher", "Java / Spring Boot", "Streams anonymized telemetry to centralized logging and metrics aggregators.")
}

Rel(CoreServicesContainer, SearchAPIController, "Synchronous queries", "HTTP/REST, mTLS")
Rel(SearchAPIController, IndexQueryEngineElasticsearchCore, "Executes queries", "Internal HTTP")
Rel(CatalogIndexerComponent, IndexQueryEngineElasticsearchCore, "Manages indexes and bulk updates", "Internal HTTP")
Rel(SearchAnalyticsPublisher, CentralizedLogMetricsAggregator, "Streams anonymized telemetry", "HTTPS")

@enduml