@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(Users, "Library Patrons, Librarians, and Administrators", "Users who interact with the system via self-service portals and management interfaces.")

System_Ext(IdP, "External Identity Provider (IdP)", "External service handling authentication and identity management.")
System_Ext(PaymentGateway, "Payment Gateway", "External service processing payments for fines, fees, and services.")
System_Ext(NotificationService, "Notification Service", "External service handling email and message notifications to patrons and staff.")

System_Boundary(LMS, "Library Management System") {
    Container(WebApp, "Web App / SPA", "React/TypeScript, CDN", "Provides patron and librarian portals for catalog browsing, circulation, and self-service.")
    Container(ApiGateway, "API Gateway", "Envoy/Kong", "Routes incoming traffic, enforces OAuth2/OIDC, and applies cross-cutting security policies.")
    Container(CoreServices, "Core Services Container", "Java/Spring Boot", "Modular monolith implementing core library logic and role-based access control (RBAC).")
    Container(SearchContainer, "Search Container", "Elasticsearch", "Provides low-latency queries for catalog and items meeting the sub-800ms SLA.")
    Container(AuditContainer, "Audit Container", "Go", "Consumes security and audit events to ensure compliance and tracking.")
    Container(MessageBroker, "Message Broker", "Apache Kafka/RabbitMQ", "Handles asynchronous events and message distribution across services.")
    ContainerDb(Database, "Database", "PostgreSQL", "Persists transactional library data with EU hosting and encryption at rest.")
}

Rel(Users, WebApp, "Accesses portal interfaces and management tools", "HTTPS")
Rel(WebApp, ApiGateway, "Communicates with backend APIs", "HTTPS")
Rel(ApiGateway, CoreServices, "Routes traffic and API requests", "gRPC/REST over mTLS")
Rel(CoreServices, SearchContainer, "Queries item and catalog data", "mTLS")
Rel(CoreServices, Database, "Reads and writes transactional data", "mTLS")
Rel(CoreServices, MessageBroker, "Publishes asynchronous events", "mTLS")
Rel(AuditContainer, MessageBroker, "Consumes security events", "mTLS")
Rel(CoreServices, IdP, "Authenticates users and validates sessions", "OIDC/OAuth2 over HTTPS")
Rel(CoreServices, PaymentGateway, "Processes financial transactions", "HTTPS/REST")
Rel(CoreServices, NotificationService, "Dispatches notifications and alerts", "HTTPS/SMTP")

@enduml