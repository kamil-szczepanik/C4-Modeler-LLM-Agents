@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Library_Patrons_Librarians_and_Administrators, "Library Patrons, Librarians, and Administrators", "Users who interact with the system via self-service portals and management interfaces.")

System(Library_Management_System, "Library Management System", "Provides self-service portals and circulation management for public and academic libraries while meeting strict EU data residency requirements and high-performance search capabilities.")

System_Ext(External_Identity_Provider_IdP, "External Identity Provider (IdP)", "External service handling authentication and identity management.")
System_Ext(Payment_Gateway, "Payment Gateway", "External service processing payments for fines, fees, and services.")
System_Ext(Notification_Service, "Notification Service", "External service handling email and message notifications to patrons and staff.")

Rel(Library_Patrons_Librarians_and_Administrators, Library_Management_System, "Accesses self-service portals and circulation management", "HTTPS (Web/Mobile Client)")
Rel(Library_Management_System, External_Identity_Provider_IdP, "Authenticates users and manages sessions", "OIDC/OAuth2 over HTTPS")
Rel(Library_Management_System, Payment_Gateway, "Processes financial transactions", "HTTPS/REST")
Rel(Library_Management_System, Notification_Service, "Sends notifications and alerts", "SMTP/HTTPS")

@enduml