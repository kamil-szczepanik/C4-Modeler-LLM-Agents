@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web App / SPA container

System_Ext(ExternalIdentity, "External Identity Provider", "OIDC/OAuth2 Identity Provider")
System_Ext(ApiGateway, "API Gateway", "Envoy / Kong API Gateway")

Container_Boundary(web_app_spa, "Web App / SPA") {
    Component(RoutingAuthenticationModule, "Routing & Authentication Module", "React Router, OIDC client", "Handles application routing and authenticates users via OIDC/OAuth2 protocols.")
    Component(CatalogDiscoveryComponent, "Catalog Discovery Component", "React, TanStack Query", "Provides catalog search and discovery capabilities with optimized caching.")
    Component(SelfServiceCirculationComponent, "Self-Service Circulation Component", "React", "Enables library patrons to self-manage checkouts, returns, and renewals.")
    Component(LibrarianManagementDashboard, "Librarian Management Dashboard", "React", "Delivers administrative and circulation management interfaces for library staff.")
    Component(StateCachingLayer, "State & Caching Layer", "TanStack Query / Zustand", "Manages in-memory state, caching, and offline resilience.")
}

Rel(RoutingAuthenticationModule, ExternalIdentity, "OIDC/OAuth2 authentication", "HTTPS")
Rel(CatalogDiscoveryComponent, StateCachingLayer, "In-memory state management", "Direct Function Call")
Rel(SelfServiceCirculationComponent, StateCachingLayer, "In-memory state management", "Direct Function Call")
Rel(LibrarianManagementDashboard, StateCachingLayer, "In-memory state management", "Direct Function Call")
Rel(StateCachingLayer, ApiGateway, "REST/JSON and WebSockets", "HTTPS")

@enduml