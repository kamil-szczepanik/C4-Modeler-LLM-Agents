@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit Container container

System_Ext(Message_Broker, "Message Broker", "Apache Kafka/RabbitMQ", "Enables decoupled, reliable event ingestion with dead-letter queue support.")
ContainerDb(Audit_Database, "Audit Database", "PostgreSQL with Row-Level Security", "Provides immutable WORM persistence and Row-Level Security for EU compliance.")
System_Ext(SIEM_Log_Forwarder, "SIEM / Log Forwarder", "Filebeat / Syslog", "External SIEM tools for compliance reporting.")
System_Ext(Admin_Dashboard, "Admin Dashboard", "Web Application", "Admin dashboard for monitoring and metrics.")

Container_Boundary(Audit_Container, "Audit Container") {
    Component(Event_Consumer, "Event Consumer", "Go, Kafka Protocol", "Consumes security events from the message broker via mTLS and SASL/SCRAM.")
    Component(WORM_Storage_Manager, "WORM Storage Manager", "Go, TCP/SQL, TLS 1.3", "Persists append-only WORM records to the Audit Database.")
    Component(Log_Forwarder, "Log Forwarder", "Go, Syslog/HTTPS", "Forwards audit logs to the SIEM / Log Forwarder for compliance reporting.")
    Component(Metrics_Exporter, "Metrics Exporter", "Go, HTTP, Prometheus", "Exposes Prometheus health metrics for ingestion uptime and monitoring.")
}

Rel(Message_Broker, Event_Consumer, "Consumes security events via mTLS and SASL/SCRAM", "Kafka Protocol")
Rel(Event_Consumer, WORM_Storage_Manager, "Passes processed security events for persistence", "Internal")
Rel(WORM_Storage_Manager, Audit_Database, "Persists append-only WORM records via TLS 1.3", "TCP/SQL")
Rel(Log_Forwarder, SIEM_Log_Forwarder, "Forwards audit logs for compliance reporting", "Syslog/HTTPS")
Rel(Metrics_Exporter, Admin_Dashboard, "Exposes Prometheus health metrics for ingestion uptime", "HTTP")
@enduml