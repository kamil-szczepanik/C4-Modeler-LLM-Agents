@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

System_Ext(external_identity_provider, "External Identity Provider (IdP)", "Identity Provider")
System_Ext(core_services_container, "Core Services Container", "Core Services")
System_Ext(audit_container, "Audit Container", "Audit")

Container_Boundary(api_gateway, "API Gateway") {
    Component(authentication_filter, "Authentication Filter", "Envoy Filter (envoy.filters.http.oauth2)", "Manages security and validates OAuth2/OIDC tokens with the external Identity Provider.")
    Component(rate_limiting_filter, "Rate Limiting Filter", "Redis token-bucket", "Protects against abuse by tracking and limiting request rates.")
    Component(request_transformation_filter, "Request Transformation Filter", "Envoy HTTP Filter", "Modifies incoming requests and injects trusted identity headers.")
    Component(w3c_trace_injector, "W3C Trace Injector", "Envoy Tracing Extension", "Injects W3C Trace Context for distributed tracing across services.")
    Component(routing_upstream_cluster_manager, "Routing & Upstream Cluster Manager", "Envoy Cluster Manager with Circuit Breaker", "Manages routing to core services and ensures high availability via circuit breaking.")
    Component(openapi_schema_validation_filter, "OpenAPI Schema Validation Filter", "Envoy Validation Filter", "Enforces OpenAPI schema validation on incoming API requests.")
}

Rel(authentication_filter, external_identity_provider, "Validates OAuth2/OIDC tokens", "HTTPS")
Rel(routing_upstream_cluster_manager, core_services_container, "Routes traffic, API requests, and injects trusted identity headers", "gRPC/REST over mTLS")
Rel(routing_upstream_cluster_manager, audit_container, "Emits Prometheus metrics and structured access logs", "gRPC")

@enduml