@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Search Container container

Container_Ext(CoreServicesContainer, "Core Services Container", "Software System / Container", "Queries item and catalog data via HTTP/JSON over mTLS.")
System_Ext(MessageBroker, "Message Broker", "Apache Kafka", "Distributes asynchronous catalog update and analytics events.")
System_Ext(AuditContainer, "Audit Container", "Go", "Receives security and authentication telemetry.")

Container_Boundary(SearchContainer, "Search Container") {
    Component(SearchAPIHandler, "Search API Handler", "Java / Spring MVC", "Exposes REST endpoints with built-in RBAC, input sanitization, and query analytics.")
    Component(IndexingService, "Indexing Service", "Java", "Consumes catalog updates from the message broker to synchronize search indices.")
    Component(ElasticsearchCluster, "Elasticsearch Cluster", "Elasticsearch", "Core distributed data store providing multi-lingual, fuzzy search and inverted index capabilities.")
}

Rel(CoreServicesContainer, SearchAPIHandler, "Queries item and catalog data via HTTP/JSON over mTLS (TLS 1.3)", "HTTP/JSON / mTLS")
Rel(MessageBroker, IndexingService, "Feeds catalog update events using the Kafka Consumer Protocol", "Kafka Consumer Protocol")
Rel(SearchAPIHandler, MessageBroker, "Dispatches asynchronous zero-result search analytics events", "Async Events")
Rel(SearchAPIHandler, AuditContainer, "Forwards failed authentication and unauthorized query attempts", "Telemetry")
Rel(IndexingService, ElasticsearchCluster, "Synchronizes search indices", "Transport / TCP")
Rel(SearchAPIHandler, ElasticsearchCluster, "Queries search index data", "REST / Transport")

@enduml