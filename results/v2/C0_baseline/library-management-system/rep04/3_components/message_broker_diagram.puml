@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(message_broker, "Message Broker") {
    Component(Kafka_Broker_KRaft_Mode, "Kafka Broker (KRaft Mode)", "Apache Kafka", "Handles asynchronous events, persistent append-only commit logs, strict ordering, and decentralized metadata management without ZooKeeper across three EU availability zones.")
    Component(Retry_Topics_and_DLQ_Handler, "Retry Topics and DLQ Handler", "Apache Kafka Topics / Spring Kafka", "Manages retry messages and Dead Letter Queues (DLQ) to guarantee at-least-once delivery and resilience.")
}

Rel(Kafka_Broker_KRaft_Mode, Retry_Topics_and_DLQ_Handler, "Routes failed message payloads", "mTLS, TCP")

@enduml