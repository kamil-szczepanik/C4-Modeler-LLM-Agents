@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(LibraryPatrons, "Library Patrons", "Patrons who use the self-service portal for cataloguing, circulation, and account management.")
Person(LibraryStaff, "Library Staff", "Staff members who use the dashboard for administrative and circulation tasks.")

System_Ext(ThirdPartyIdentityProvider, "Third-Party Identity Provider", "External authentication provider handling OAuth2/OIDC and JWTs.")
System_Ext(DigitalContentProviders, "Digital Content Providers", "External systems providing access to digital media and resources.")
System_Ext(InterlibraryLoanNetwork, "Interlibrary Loan Network", "External network for borrowing items across different library systems.")
System_Ext(PaymentGateway, "Payment Gateway", "External service for processing user payments and fines.")
System_Ext(NotificationService, "Notification Service", "External service for delivering alerts and messages to patrons.")
System_Ext(CentralizedObservabilitySIEMPlatform, "Centralized Observability & SIEM Platform", "Platform for centralized logging, monitoring, and security information management.")
System_Ext(BackupDisasterRecoveryStorage, "Backup & Disaster Recovery Storage", "EU-resident object storage used for backups and disaster recovery.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(PatronPortal, "Patron Portal", "React / TypeScript SPA", "Web application providing self-service capabilities for library patrons.")
    Container(StaffDashboard, "Staff Dashboard", "React / TypeScript SPA", "Web application enabling library staff to manage circulation, cataloguing, and system administration.")
    Container(APIGateway, "API Gateway", "Nginx / Envoy", "Entry point managing and routing incoming traffic from frontends.")
    Container(CoreBusinessService, "Core Business Service", "Java / Spring Boot", "Handles primary business logic, cataloguing, and circulation workflows.")
    Container(SearchService, "Search Service", "Elasticsearch / OpenSearch", "Provides sub-800ms search responses for library catalogues.")
    Container(IntegrationService, "Integration Service", "Node.js / TypeScript", "Manages integrations with external systems like payment gateways and content providers.")
    Container(NotificationAuditService, "Notification & Audit Service", "Python / FastAPI", "Processes domain events for auditing, logging, and dispatching notifications.")
    ContainerDb(RelationalDB, "Relational DB", "PostgreSQL", "Primary transactional data store hosted exclusively in EU regions.")
    Container(MessageBroker, "Message Broker", "Kafka / RabbitMQ", "Handles asynchronous messaging and event streaming between services.")
    Container(SecretsManager, "Secrets Manager", "HashiCorp Vault", "Secures and manages sensitive credentials and configuration data.")
}

Rel(LibraryPatrons, PatronPortal, "Interacts with via web browser", "HTTPS (TLS 1.3)")
Rel(LibraryStaff, StaffDashboard, "Interacts with via web browser", "HTTPS (TLS 1.3)")
Rel(PatronPortal, APIGateway, "Sends API requests", "HTTPS (TLS 1.3)")
Rel(StaffDashboard, APIGateway, "Sends API requests", "HTTPS (TLS 1.3)")
Rel(APIGateway, CoreBusinessService, "Routes traffic via service mesh", "gRPC/REST over mTLS (Istio)")
Rel(CoreBusinessService, RelationalDB, "Reads and writes transactional data", "SQL / JDBC")
Rel(CoreBusinessService, SearchService, "Syncs data asynchronously", "AMQP/Kafka")
Rel(CoreBusinessService, MessageBroker, "Publishes domain events", "Kafka / AMQP")
Rel(IntegrationService, MessageBroker, "Consumes domain events", "Kafka / RabbitMQ")
Rel(NotificationAuditService, MessageBroker, "Consumes domain events", "Kafka / RabbitMQ")
Rel(IntegrationService, PaymentGateway, "Processes transactions", "TLS 1.3")
Rel(IntegrationService, DigitalContentProviders, "Retrieves digital content metadata", "TLS 1.3")
Rel(APIGateway, ThirdPartyIdentityProvider, "Validates authentication and tokens", "OAuth2/OIDC with JWTs")
Rel(CoreBusinessService, SecretsManager, "Retrieves secrets and keys", "HashiCorp Vault API")
Rel(IntegrationService, SecretsManager, "Retrieves secrets and keys", "HashiCorp Vault API")

@enduml