@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification & Audit Service container

Container_Boundary(notification_audit_service, "Notification & Audit Service") {
    Component(Event Consumer Component, "Event Consumer Component", "Python / FastAPI Background Worker", "Consumes domain events from the message broker via mTLS.")
    Component(Audit Processor Component, "Audit Processor Component", "Python / FastAPI", "Handles compliance and generates tamper-evident audit logs.")
    Component(Notification Dispatcher Component, "Notification Dispatcher Component", "Python / FastAPI", "Multi-channel gateway for dispatching alerts.")
    Component(Preference Repository Access Component, "Preference Repository Access Component", "Python / FastAPI", "Queries user settings and notification preferences.")
}

Component_Ext(Message Broker, "Message Broker", "Kafka / RabbitMQ", "External message broker for domain events.")
Component_Ext(Centralized Observability & SIEM Platform, "Centralized Observability & SIEM Platform", "SIEM / TLS Syslog", "External platform for centralized audit log forwarding.")
Component_Ext(Payment Gateway and Notification Service, "Payment Gateway and Notification Service", "HTTPS / REST (TLS 1.3)", "External service for dispatching alerts.")
Component_Ext(Relational DB, "Relational DB", "PostgreSQL", "Stores user preferences.")
Component_Ext(HashiCorp Vault, "HashiCorp Vault", "Vault", "Dynamic secret injection and encryption key management.")

Rel(Event Consumer Component, Message Broker, "Consumes domain events [Kafka / RabbitMQ] via mTLS", "Kafka / RabbitMQ via mTLS")
Rel(Audit Processor Component, Centralized Observability & SIEM Platform, "Forwards audit logs via TLS/Syslog", "TLS/Syslog")
Rel(Notification Dispatcher Component, Payment Gateway and Notification Service, "Dispatches alerts via HTTPS/REST (TLS 1.3)", "HTTPS/REST (TLS 1.3)")
Rel(Preference Repository Access Component, Relational DB, "Queries user preferences via JDBC/SQL over mTLS", "JDBC/SQL over mTLS")

@enduml