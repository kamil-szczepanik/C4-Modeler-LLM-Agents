@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(LibraryPatrons, "Library Patrons", "Public and academic library patrons")
System_Ext(APIGateway, "API Gateway", "Manages API requests and security tokens")
System_Ext(CentralizedObservabilitySIEMPlatform, "Centralized Observability & SIEM Platform", "Collects performance and error metrics")

Container_Boundary(PatronPortal, "Patron Portal") {
    Component(SearchDiscoveryComponent, "Search & Discovery Component", "React / TypeScript", "Enables public and academic library patrons to autonomously discover items.")
    Component(AccountFinesComponent, "Account & Fines Component", "React / TypeScript", "Enables patrons to manage accounts and view fines.")
    Component(DigitalContentReaderComponent, "Digital Content Reader Component", "React / TypeScript", "Provides access to digital content for patrons.")
    Component(AccessibilityLocalizationLayer, "Accessibility & Localization Layer", "React Context", "Ensures WCAG 2.1 AA compliance to meet universal public and academic accessibility mandates.")
    Component(APIClientService, "API Client Service", "Axios / TypeScript with RUM telemetry", "Centralizes communication, error handling, and RUM telemetry integration.")
    Component(HealthCheckFeatureFlagService, "Health Check & Feature Flag Service", "React / TypeScript", "Polls lightweight dependency status endpoints.")
    Component(CDNDeployment, "CDN Deployment", "AWS S3 + CloudFront", "Delivers static assets globally with strict cache-control and automated invalidation.")
}

Rel(LibraryPatrons, PatronPortal, "Interacts via web browser", "HTTPS (TLS 1.3)")
Rel(PatronPortal, APIGateway, "Sends API requests and receives HTTP-only cookies", "HTTPS (TLS 1.3)")
Rel(APIClientService, CentralizedObservabilitySIEMPlatform, "Sends scrubbed performance and error metrics", "HTTPS (TLS 1.3)")
Rel(HealthCheckFeatureFlagService, APIGateway, "Polls lightweight dependency status endpoints", "HTTPS (TLS 1.3)")
@enduml