@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Service container

System_Ext(Message_Broker, "Message Broker", "External message broker for domain events and DLQ.")
System_Ext(Payment_Gateway, "Payment Gateway", "External payment processing gateway.")
System_Ext(Digital_Content_Providers, "Digital Content Providers", "External digital content and license providers.")
System_Ext(Secrets_Manager, "Secrets Manager", "Secure credential and token storage.")
System_Ext(Centralized_Observability_SIEM_Platform, "Centralized Observability & SIEM Platform", "Platform for metrics, logs, and security monitoring.")

Container_Boundary(Integration_Service, "Integration Service") {
    Component(Event_Consumer_Component, "Event Consumer Component", "Node.js / TypeScript / Kafka.js", "Consumes domain events from the message broker.")
    Component(Payment_Adapter_Component, "Payment Adapter Component", "Node.js / TypeScript / Axios / Opossum", "Processes transactions, handles callbacks, and fetches API keys securely.")
    Component(Content_Provider_Adapter_Component, "Content Provider Adapter Component", "Node.js / TypeScript / Axios", "Retrieves metadata and licenses from digital content providers.")
    Component(Retry_DLQ_Manager_Component, "Retry & DLQ Manager Component", "Node.js / TypeScript / Kafka.js", "Manages failed messages, publishes to DLQ, and triggers alerts.")
    Component(Notification_Dispatcher_Component, "Notification Dispatcher Component", "Node.js / TypeScript / Axios", "Dispatches notifications and triggers alerts on persistent failures.")
    Component(Observability_Exporter_Component, "Observability Exporter Component", "Node.js / TypeScript / prom-client", "Ships anonymized metrics and logs to the centralized observability platform.")
}

Rel(Event_Consumer_Component, Message_Broker, "Consumes domain events", "Kafka Protocol")
Rel(Payment_Adapter_Component, Payment_Gateway, "Processes transactions and handles callbacks", "TLS 1.3 / HMAC-SHA256")
Rel(Content_Provider_Adapter_Component, Digital_Content_Providers, "Retrieves metadata and licenses", "TLS 1.3")
Rel(Payment_Adapter_Component, Secrets_Manager, "Fetches API keys and manages tokens", "HashiCorp Vault API / mTLS")
Rel(Retry_DLQ_Manager_Component, Message_Broker, "Publishes failed messages to DLQ", "Kafka Protocol")
Rel(Retry_DLQ_Manager_Component, Notification_Dispatcher_Component, "Triggers alerts on persistent failure", "Internal Async Call")
Rel(Observability_Exporter_Component, Centralized_Observability_SIEM_Platform, "Ships anonymized metrics and logs", "HTTPS / TLS 1.3")

@enduml