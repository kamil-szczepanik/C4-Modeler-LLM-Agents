@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Component(API_Gateway, "API Gateway", "Nginx / Envoy", "Entry point routing HTTP/2 REST traffic to the Search API Controller.")
Component(Message_Broker, "Message Broker", "Kafka", "Asynchronous event ingestion backbone for inventory indexing.")
Component(Secrets_Manager, "Secrets Manager", "HashiCorp Vault", "Dynamic runtime injection of mTLS certificates and credentials.")

Container_Boundary(search_service, "Search Service") {
    Component(Search_API_Controller, "Search API Controller", "Java / Spring WebFlux", "Asynchronous non-blocking control for low-latency queries, handling HTTP/2 REST requests.")
    Component(Indexing_Consumer, "Indexing Consumer", "Java / Spring Kafka", "Consumes Kafka events for near-real-time inventory indexing and performs partial document updates.")
    Component(Query_Builder_Ranking_Engine, "Query Builder & Ranking Engine", "Java", "Builds complex search queries and handles ranking for catalogue discovery.")
    Component(Search_Data_Store, "Search Data Store", "OpenSearch", "Distributed EU-hosted search cluster meeting the sub-800ms performance SLA.")
}

Rel(API_Gateway, Search_API_Controller, "HTTP/2 REST")
Rel(Search_API_Controller, Search_Data_Store, "HTTP/JSON with Connection Pooling")
Rel(Message_Broker, Indexing_Consumer, "Kafka Events")
Rel(Indexing_Consumer, Search_Data_Store, "Partial Document Updates")
Rel(Search_API_Controller, Secrets_Manager, "mTLS / Runtime Secret Injection via HashiCorp Vault")

@enduml