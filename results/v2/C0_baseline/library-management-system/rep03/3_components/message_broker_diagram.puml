@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Message Broker container

System_Ext(CoreBusinessService, "Core Business Service", "External system")
System_Ext(IntegrationService, "Integration Service", "External system")
System_Ext(NotificationAuditService, "Notification & Audit Service", "External system")

Container_Boundary(MessageBroker, "Message Broker") {
    Component(ApacheKafka, "Apache Kafka", "Apache Kafka, Strimzi Kubernetes Operator", "Distributed event streaming platform serving as the core event router and broker.")
    Component(SchemaRegistry, "Schema Registry", "Confluent Schema Registry / Apicurio", "Manages and validates event schemas across the system.")
    Component(DeadLetterQueueTopics, "Dead-Letter Queue Topics", "Apache Kafka DLQ Topics", "Routes and isolates failed consumption events for later inspection and replay.")
    Component(EventReplayandAdministrationTooling, "Event Replay and Administration Tooling", "Kafka-UI / Custom Admin CLI", "Enables event replay and administrative operations from the DLQ.")
    Component(SecretsManagerIntegration, "Secrets Manager Integration", "HashiCorp Vault", "Provides centralized secret management for mTLS certificates, RBAC, and encryption keys.")
}

Rel(CoreBusinessService, ApacheKafka, "Publishes raw domain events", "gRPC / Kafka Protocol")
Rel(IntegrationService, DeadLetterQueueTopics, "Routes failed consumption events", "Kafka Protocol")
Rel(EventReplayandAdministrationTooling, ApacheKafka, "Re-publishes corrected events from DLQ", "Kafka Protocol")
Rel(NotificationAuditService, ApacheKafka, "Consumes sanitized events", "Kafka Consumer API")

@enduml