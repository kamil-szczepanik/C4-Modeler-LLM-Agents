@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Boundary(relational_db, "Relational DB") {
    Component(Transactional_Engine, "Transactional Engine", "PostgreSQL core", "Ensures ACID compliance and zero-tolerance for double-booked loans.")
    Component(Audit_Compliance_Schema, "Audit & Compliance Schema", "pgAudit", "Database extension for logging administrative actions to satisfy GDPR tracking mandates.")
    Component(Replication_High_Availability_Module, "Replication & High Availability Module", "Patroni / Streaming Replication (etcd/Consul)", "Manages automated high availability and sub-30-second failover restricted to EU regions.")
    Component(Connection_Pooling_Proxy, "Connection Pooling Proxy", "PgBouncer", "Connection pooling proxy configured in transaction mode to handle peak portal traffic.")
}

System_Ext(Backup_Disaster_Recovery_Storage, "Backup & Disaster Recovery Storage", "")
System_Ext(Centralized_Observability_SIEM_Platform, "Centralized Observability & SIEM Platform", "")

Rel(Connection_Pooling_Proxy, Transactional_Engine, "Forwards pooled queries", "TCP / internal encryption")
Rel(relational_db, Backup_Disaster_Recovery_Storage, "Streams write-ahead logs (WAL) for point-in-time recovery", "Encrypted SSH/S3 API")
Rel(relational_db, Centralized_Observability_SIEM_Platform, "Exports metrics (postgres_exporter, pgbouncer_exporter), slow-query logs, and audit logs", "HTTPS/TLS")

@enduml