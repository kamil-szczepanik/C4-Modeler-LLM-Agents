@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(core_business_service, "Core Business Service") {
    Component(api_controller_layer, "API Controller Layer", "Java / Spring Boot", "Handles incoming HTTP/gRPC requests routed from the API Gateway.")
    Component(cataloguing_inventory_component, "Cataloguing & Inventory Component", "Java / Spring Boot, Spring Data JPA", "Manages library items, cataloguing data, and real-time inventory validation.")
    Component(circulation_loan_engine_component, "Circulation & Loan Engine Component", "Java / Spring Boot", "Manages patron checkouts, returns, renewals, and loan policies.")
    Component(event_publisher_component, "Event Publisher Component", "Kafka / AMQP", "Publishes domain events asynchronously to the message broker.")
    Component(vault_integration_component, "Vault Integration Component", "HashiCorp Vault API", "Retrieves dynamic secrets and credentials securely.")
}

System_Ext(secrets_manager, "Secrets Manager", "HashiCorp Vault")

Rel(api_controller_layer, cataloguing_inventory_component, "Invokes catalog operations")
Rel(api_controller_layer, circulation_loan_engine_component, "Invokes loan and circulation logic")
Rel(cataloguing_inventory_component, event_publisher_component, "Triggers inventory synchronization events")
Rel(circulation_loan_engine_component, event_publisher_component, "Publishes circulation events")
Rel(vault_integration_component, secrets_manager, "Retrieves dynamic secrets", "HashiCorp Vault API")

@enduml