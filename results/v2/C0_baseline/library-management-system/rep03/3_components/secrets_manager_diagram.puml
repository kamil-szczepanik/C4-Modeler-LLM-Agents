@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(SysAdmins, "System Administrators / DevOps Engineers", "Internal operators managing security, policies, and compliance.")
System_Ext(CoreService, "Core Business Service / Integration Service", "External services consuming secrets and authenticating via AppRole/mTLS.")
System_Ext(SIEM, "Centralized Observability & SIEM Platform", "Receives streamed audit trails and security events.")
System_Ext(BackupStorage, "Backup & Disaster Recovery Storage", "Stores encrypted snapshots and Shamir's Secret Sharing data.")

Container_Boundary(SecretsManager, "Secrets Manager") {
    Component(SecretsEngine, "Secrets Engine Component", "HashiCorp Vault KV/Transit Secrets Engine", "Encrypted credential storage and envelope encryption.")
    Component(AccessControl, "Access Control & Authentication Component", "HashiCorp Vault AppRole, OIDC with MFA, RBAC", "Zero-trust authorization, automated service authentication, and administrator Single Sign-On.")
    Component(AuditLogging, "Audit Logging Component", "Vault Audit Device", "Streaming security and failure events.")
    Component(SecretRotation, "Secret Rotation Component", "Vault Automated Rotation / Consul Template", "Lifecycle management and automated rotation of credentials.")
    Component(BackupDR, "Backup & Disaster Recovery Component", "Encrypted snapshotting with Shamir's Secret Sharing", "Break-glass procedures and encrypted snapshot generation.")
}

Rel(SysAdmins, AccessControl, "Manages policies, reviews audit logs, and authenticates", "HTTPS / Vault CLI/UI with OIDC/MFA")
Rel(CoreService, AccessControl, "Authenticates using short-lived tokens", "Vault AppRole / mTLS")
Rel(CoreService, SecretsEngine, "Fetches operational credentials", "Vault REST API over TLS 1.3")
Rel(AuditLogging, SIEM, "Streams audit trails and failure events", "Syslog/HTTPS via TLS 1.3")
Rel(BackupDR, BackupStorage, "Periodically pushes encrypted snapshots", "Regional EU endpoints")

@enduml