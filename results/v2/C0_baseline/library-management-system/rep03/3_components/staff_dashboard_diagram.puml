@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Staff Dashboard container

System_Ext(api_gateway, "API Gateway", "API Gateway")
System_Ext(s3_cloudfront, "S3 + CloudFront", "S3 + CloudFront")

Container_Boundary(staff_dashboard, "Staff Dashboard") {
    Component(Auth_Session, "Authentication & Session Component", "React Context / OIDC Client", "Manages user authentication, session state, and secure token lifecycle.")
    Component(Circulation_Workspace, "Circulation Workspace", "React Module with IndexedDB and Web Crypto API", "Handles circulation tasks with client-side offline buffering and encrypted local storage for PII.")
    Component(Cataloguing_Module, "Cataloguing & Inventory Module", "React Module", "Provides interface for heavy cataloguing and inventory workflows.")
    Component(Admin_Panel, "Administration & Audit Panel", "React Module with Chart.js reporting widget", "Enables system administration and displays operational reporting visualizations.")
    Component(API_Client, "API Client Layer", "Axios / Fetch + TypeScript Interceptors", "Manages outgoing API requests and injects OIDC tokens.")
    Component(Hotkey_Manager, "Quick Actions Hotkey Manager", "Global React Context", "Manages global keyboard shortcuts for rapid staff navigation.")
}

Rel(staff_dashboard, api_gateway, "Sends API requests and OIDC tokens", "HTTPS (TLS 1.3)")
Rel(staff_dashboard, s3_cloudfront, "Fetches static assets and content delivery", "HTTPS (TLS 1.3)")
Rel(Auth_Session, API_Client, "Provides OIDC tokens for requests")
Rel(Circulation_Workspace, API_Client, "Sends circulation data requests")
Rel(Cataloguing_Module, API_Client, "Sends cataloguing data requests")
Rel(Admin_Panel, API_Client, "Sends administrative and audit requests")

@enduml