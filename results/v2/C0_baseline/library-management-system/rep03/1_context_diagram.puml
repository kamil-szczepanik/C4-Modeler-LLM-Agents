@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Library_Patrons_and_Library_Staff, "Library Patrons and Library Staff", "Primary users who interact with the system via web and mobile UI for circulation and cataloguing.")

System(Library_Management_System, "Library Management System", "A cloud-native platform designed for public and academic libraries to catalogue physical and digital items, manage circulation, and provide self-service portals with strict EU data residency compliance.")

System_Ext(Third_Party_Identity_Providers, "Third-Party Identity Providers", "External authentication providers supporting eIDAS and SAML/OIDC.")
System_Ext(Digital_Content_Providers_Vendors_and_Interlibrary_Loan_ILL_Network, "Digital Content Providers/Vendors and Interlibrary Loan (ILL) Network", "External networks and vendors providing digital content and interlibrary loan services.")
System_Ext(Payment_Gateway_and_Notification_Service, "Payment Gateway and Notification Service", "External services handling payments and sending notifications and alerts.")
System_Ext(Centralized_Observability_SIEM_Platform, "Centralized Observability & SIEM Platform", "Platform for centralized logging, monitoring, and security information event management.")
System_Ext(Backup_Disaster_Recovery_Storage, "Backup & Disaster Recovery Storage", "EU-resident object storage used for backup and disaster recovery.")

Rel(Library_Patrons_and_Library_Staff, Library_Management_System, "Interact with the system for self-service portals and management", "HTTPS (TLS 1.3)")
Rel(Library_Management_System, Third_Party_Identity_Providers, "Authenticate users securely", "OAuth 2.0 / OIDC and MFA")
Rel(Library_Management_System, Digital_Content_Providers_Vendors_and_Interlibrary_Loan_ILL_Network, "Integrate for digital content and interlibrary loans", "REST/GraphQL over HTTPS with mTLS and OAuth 2.0")
Rel(Library_Management_System, Payment_Gateway_and_Notification_Service, "Process payments and send alerts", "REST/GraphQL / HTTPS / Webhooks")
Rel(Library_Management_System, Centralized_Observability_SIEM_Platform, "Forward logs and telemetry data", "HTTPS")
Rel(Library_Management_System, Backup_Disaster_Recovery_Storage, "Store backups and disaster recovery data", "Encrypted EU-resident object storage")

@enduml