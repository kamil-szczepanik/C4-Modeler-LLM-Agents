@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Circulation Management container

Container_Boundary(circulation_management, "Circulation Management") {
    Component(Checkout_Engine_Component, "Checkout Engine Component", "Spring Boot / Java", "Handles self-service checkout workflows and business logic.")
    Component(Patron_Account_Manager_Component, "Patron Account Manager Component", "Spring Boot / Java", "Manages patron accounts and staff management console requests.")
    Component(Circulation_Data_Access_Component, "Circulation Data Access Component", "JPA / PostgreSQL 15", "Provides relational state storage with required EU-region data residency enforcement.")
    Component(Event_Publisher_Component, "Event Publisher Component", "Spring Cloud Stream / Kafka", "Enables decoupled asynchronous messaging and audit event publishing.")
}

System_Ext(Kafka, "Kafka", "External Apache Kafka message broker")

Rel(Checkout_Engine_Component, Circulation_Data_Access_Component, "Accesses via internal package-private boundaries")
Rel(Patron_Account_Manager_Component, Circulation_Data_Access_Component, "Accesses via internal package-private boundaries")
Rel(Event_Publisher_Component, Kafka, "Publishes asynchronous audit and notifications via TCP", "TCP")

@enduml