@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(catalogue_service, "Catalogue Service", "External service providing catalogue data and events.")
System_Ext(audit_logging_container, "Audit Logging Container", "External container for audit and metrics logging.")

Container_Boundary(search_engine, "Search Engine") {
    Component(query_processor, "Query Processor", "Java / Elasticsearch DSL", "Handles incoming search requests with linguistic analysis and facets.")
    Component(index_manager, "Index Manager", "Elasticsearch", "Manages index lifecycles, mappings, and bulk ingestion.")
    Component(data_synchronizer, "Data Synchronizer", "Kafka", "Consumes CDC events from the Catalogue Service for eventual consistency.")
    Component(analytics_aggregator, "Analytics Aggregator", "Elasticsearch Transform API", "Produces anonymized query metrics and zero-result logs.")
    Component(elasticsearch_cluster, "Elasticsearch Cluster", "Elasticsearch", "Core storage and search engine deployed within EU-region availability zones.")
}

Rel(catalogue_service, query_processor, "Queries catalogue items", "gRPC/TCP with mTLS")
Rel(catalogue_service, data_synchronizer, "Publishes catalogue changes", "Kafka topics with TLS 1.3")
Rel(analytics_aggregator, audit_logging_container, "Publishes aggregated trending metrics", "Kafka")
@enduml