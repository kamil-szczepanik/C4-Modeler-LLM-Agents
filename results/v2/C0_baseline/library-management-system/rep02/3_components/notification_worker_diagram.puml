@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification Worker container

System_Ext(Message_Broker_Kafka_RabbitMQ, "Message Broker (Kafka/RabbitMQ)", "Message broker for zero message loss and queuing")
System_Ext(EU_Notification_Service_External, "EU Notification Service (External)", "External notification service ensuring EU data residency")

Container_Boundary(notification_worker, "Notification Worker") {
    Component(Consumer___Event_Listener, "Consumer / Event Listener", "Go", "Consumes events from the Message Broker.")
    Component(Template_Engine, "Template Engine", "Go", "Processes and templates alert payloads.")
    Component(Dispatch_Router, "Dispatch Router", "Go", "Forwards messages and delegates dispatch with fallback.")
    Component(Provider_Adapters, "Provider Adapters", "Go", "Sends external alerts to the EU Notification Service.")
}

Rel(Consumer___Event_Listener, Message_Broker_Kafka_RabbitMQ, "Consumes events", "AMQP/Kafka via mTLS")
Rel(Consumer___Event_Listener, Template_Engine, "Passes payloads", "Go structs")
Rel(Template_Engine, Dispatch_Router, "Forwards messages", "Go structs")
Rel(Dispatch_Router, Provider_Adapters, "Delegates dispatch with fallback", "Go interfaces")
Rel(Provider_Adapters, EU_Notification_Service_External, "Sends external alerts", "HTTPS/REST with TLS 1.3")

@enduml