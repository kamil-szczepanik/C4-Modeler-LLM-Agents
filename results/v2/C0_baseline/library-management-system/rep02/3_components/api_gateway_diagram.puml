@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(routing_engine, "Routing and Proxy Engine", "Kong/Envoy", "Routes incoming requests from the Self-Service Portal and Staff Management Console to backend services using gRPC/HTTP2.")
    Component(auth_middleware, "Authentication and Authorization Middleware", "Kong/Envoy Plugin with Redis", "Validates OIDC tokens against the EU Identity Provider, fetches and caches JWKS using local Redis, and handles rate limiting.")
    Component(observability_agent, "Observability and Security Agent", "OpenTelemetry, WAF, Kafka/Fluentbit", "Handles distributed tracing, Prometheus metrics for latency tracking, WAF protection, and PII-scrubbed audit logging.")
}

System_Ext(catalogue_service, "Catalogue Service", "Backend service for catalogue operations")
System_Ext(search_engine, "Search Engine", "ElasticSearch cluster for high-performance search")
System_Ext(eu_idp, "EU Identity Provider", "External OIDC Identity Provider")

Rel(routing_engine, auth_middleware, "Validates tokens and enforces rate limits", "HTTPS/gRPC")
Rel(routing_engine, catalogue_service, "Routes traffic", "gRPC/HTTP2")
Rel(routing_engine, search_engine, "Routes traffic", "gRPC/HTTP2")
Rel(auth_middleware, eu_idp, "Validates OIDC tokens and fetches JWKS", "HTTPS")

@enduml