@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Staff Management Console container

System_Ext(api_gateway, "API Gateway", "Kong/Envoy", "Routes incoming requests to appropriate downstream microservices.")

Container_Boundary(staff_management_console, "Staff Management Console") {
    Component(dashboard_router_state_manager, "Dashboard Router & State Manager", "React Router / Redux Toolkit", "Manages application routing and global state for library staff workflows.")
    Component(cataloguing_circulation_module, "Cataloguing & Circulation Module", "React Components", "Handles cataloging and circulation workflows securely and efficiently.")
    Component(audit_action_interceptor, "Audit Action Interceptor", "TypeScript Axios Middleware", "Intercepts actions for auditing purposes.")
    Component(search_query_client, "Search Query Client", "TanStack React Query", "Optimizes search rendering to meet performance targets.")
    Component(auth_session_guardian_module, "Auth & Session Guardian Module", "React Context / Axios Interceptor / HttpOnly, SameSite=Strict Cookies", "Manages authentication, session security, and silent token refresh.")
    Component(bulk_operations_orchestrator, "Bulk Operations Orchestrator", "React State Machine", "Orchestrates bulk operations workflows.")
}

Rel(auth_session_guardian_module, api_gateway, "Performs silent token refresh", "HTTPS/REST")
Rel(cataloguing_circulation_module, api_gateway, "Streams batched payloads", "HTTPS/REST")
Rel(staff_management_console, api_gateway, "Routes requests", "HTTPS/REST")

@enduml