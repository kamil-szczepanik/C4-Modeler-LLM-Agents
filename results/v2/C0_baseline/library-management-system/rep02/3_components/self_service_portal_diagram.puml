@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(LibraryPatronsandAnonymousVisitors, "Library Patrons and Anonymous Visitors", "Patrons and visitors accessing the library system.")

System_Ext(APIGateway, "API Gateway", "Routes requests and handles OAuth2/PKCE and fine settlements.")
System_Ext(EUIdentityProviderEUPaymentGateway, "EU Identity Provider & EU Payment Gateway", "Handles OAuth2/PKCE and fine settlements.")

Container_Boundary(SelfServicePortal, "Self-Service Portal") {
    Component(RoutingLayoutCoreComponent, "Routing & Layout Core Component", "React Router", "Manages shared application state, global navigation, and WCAG 2.1 AA accessibility compliance.")
    Component(CatalogueExplorerComponent, "Catalogue Explorer Component", "React", "Enables patrons to catalogue and explore items.")
    Component(PatronDashboardComponent, "Patron Dashboard Component", "React", "Enables patrons to manage loans.")
    Component(AccountFinesManagerComponent, "Account & Fines Manager Component", "React", "Enables patrons to settle fines and manage account details.")
    Component(StateAPIClientModule, "State & API Client Module", "Axios/Fetch", "Handles requests using HttpOnly cookies and JSON REST.")
}

Rel(LibraryPatronsandAnonymousVisitors, RoutingLayoutCoreComponent, "Accesses unified SPA via HTTPS [TLS 1.3]", "HTTPS [TLS 1.3]")
Rel(RoutingLayoutCoreComponent, CatalogueExplorerComponent, "Dynamically renders components [HTTPS]", "HTTPS")
Rel(RoutingLayoutCoreComponent, PatronDashboardComponent, "Dynamically renders components [HTTPS]", "HTTPS")
Rel(RoutingLayoutCoreComponent, AccountFinesManagerComponent, "Dynamically renders components [HTTPS]", "HTTPS")
Rel(StateAPIClientModule, APIGateway, "Routes requests using HttpOnly cookies [HTTPS/JSON REST]", "HTTPS/JSON REST")
Rel(APIGateway, EUIdentityProviderEUPaymentGateway, "Handles OAuth2/PKCE and fine settlements [HTTPS]", "HTTPS")

@enduml