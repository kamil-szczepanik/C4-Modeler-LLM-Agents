@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalogue Service container

Component(API_Gateway, "API Gateway", "Gateway", "External entry point routing requests to the API controller.")
Component_Ext(Search_Engine, "Search Engine", "ElasticSearch", "Provides high-performance discovery to meet the <800ms SLA.")
Component_Ext(Audit_Logging_Kafka, "Audit Logging/Kafka", "Apache Kafka", "Decouples write operations from indexing and telemetry.")

Container_Boundary(catalogue_service, "Catalogue Service") {
    Component(Catalogue_API_Controller, "Catalogue API Controller", "Java / Spring Boot", "Manages physical and digital library item inventories and metadata via REST/JSON.")
    Component(Item_Domain_Model_Business_Logic_Component, "Item Domain Model & Business Logic Component", "Java", "Encapsulates item domain model and business logic.")
    Component(Data_Access_Repository, "Data Access Repository", "PostgreSQL with JPA", "Ensures ACID compliance for transactional inventory updates.")
    Component(Search_Synchronizer_Component, "Search Synchronizer Component", "Java", "Synchronizes data with the search engine and publishes asynchronous events.")
    Component(Usage_Analytics_Telemetry_Hook, "Usage Analytics & Telemetry Hook", "Java", "Publishes asynchronous telemetry and analytics events.")
    Component(Cache_Layer, "Cache Layer", "Redis", "Caches frequently accessed metadata with strict memory encryption and TTLs.")
}

Rel(API_Gateway, Catalogue_API_Controller, "REST/JSON over HTTPS with JWT validation", "HTTPS")
Rel(Catalogue_API_Controller, Item_Domain_Model_Business_Logic_Component, "Direct Java method invocation", "")
Rel(Item_Domain_Model_Business_Logic_Component, Data_Access_Repository, "JDBC/JPA over mTLS", "mTLS")
Rel(Item_Domain_Model_Business_Logic_Component, Cache_Layer, "Encrypted caching with strict TTLs", "")
Rel(Search_Synchronizer_Component, Search_Engine, "gRPC/TCP", "gRPC/TCP")
Rel(Search_Synchronizer_Component, Audit_Logging_Kafka, "Asynchronous event publishing", "Async")
Rel(Usage_Analytics_Telemetry_Hook, Audit_Logging_Kafka, "Asynchronous event publishing", "Async")

@enduml