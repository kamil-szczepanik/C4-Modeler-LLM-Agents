@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(LibraryPatrons, "Library Patrons", "Library users who access the system via self-service portals.")
Person(LibrariansCirculationStaff, "Librarians/Circulation Staff", "Staff members who manage circulation and library operations.")
Person(LibraryAdministrators, "Library Administrators", "Administrators who configure and manage the library management system.")

System_Ext(EUIdentityProvider, "EU Identity Provider", "External provider handling authentication via OAuth2/OIDC.")
System_Ext(EUPaymentGateway, "EU Payment Gateway", "External payment service for handling transactions.")
System_Ext(EUNotificationService, "EU Notification Service", "External service for sending notifications.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(APIGateway, "API Gateway", "Kong/Envoy", "Centralized OAuth 2.0 / OIDC JWT validation and routing.")
    Container(SelfServicePortal, "Self-Service Portal", "React/Nginx", "Frontend SPA for public library patrons.")
    Container(StaffManagementConsole, "Staff Management Console", "React/Nginx", "Frontend SPA for librarians and staff.")
    Container(CirculationManagement, "Circulation Management", "Backend Service", "Manages book and resource checkouts, returns, and patron accounts.")
    Container(CatalogueService, "Catalogue Service", "Backend Service", "Manages the inventory of physical and digital library items.")
    Container(SearchEngine, "Search Engine", "ElasticSearch", "Provides sub-800ms search capabilities for the catalogue.")
    Container(AuditLogging, "Audit Logging", "Kafka/Fluentbit", "Handles asynchronous event-driven audit logging.")
    Container(NotificationWorker, "Notification Worker", "Go", "Processes and sends notifications asynchronously.")
}

Rel(LibraryPatrons, SelfServicePortal, "Accesses via HTTPS/JSON REST through the API Gateway", "HTTPS")
Rel(LibrariansCirculationStaff, StaffManagementConsole, "Accesses via HTTPS/REST through the API Gateway", "HTTPS")
Rel(SelfServicePortal, APIGateway, "Routes requests to backend containers", "HTTPS/JSON REST")
Rel(StaffManagementConsole, APIGateway, "Routes requests to backend containers", "HTTPS/REST")
Rel(CatalogueService, SearchEngine, "Queries catalogue items", "gRPC/TCP")
Rel(NotificationWorker, EUNotificationService, "Sends external notifications", "HTTPS")

@enduml