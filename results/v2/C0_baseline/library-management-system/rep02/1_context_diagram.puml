@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(LibraryPatrons, "Library Patrons", "Library users who access the system via self-service portals.")
Person(LibrariansCirculationStaff, "Librarians/Circulation Staff", "Staff members who manage circulation, cataloguing, and library operations.")
Person(LibraryAdministrators, "Library Administrators", "Administrators who configure and manage the library management system.")

System(LibraryManagementSystem, "Library Management System", "Provides cataloguing, circulation management, and self-service portals for public and academic libraries within an EU-only data residency boundary.")

System_Ext(EUIdentityVendor, "EU Identity Provider", "External provider handling authentication via OAuth2/OIDC.")
System_Ext(EUPaymentGateway, "EU Payment Gateway", "External payment service for handling transactions.")
System_Ext(EUNotificationService, "EU Notification Service", "External service for sending notifications.")

Rel(LibraryPatrons, LibraryManagementSystem, "Interacts with Web and Mobile Clients", "HTTPS")
Rel(LibrariansCirculationStaff, LibraryManagementSystem, "Interacts with Web and Mobile Clients", "HTTPS")
Rel(LibraryAdministrators, LibraryManagementSystem, "Interacts with Web and Mobile Clients", "HTTPS")

Rel(LibraryManagementSystem, EUIdentityVendor, "Integrates for secure role-based access control", "OAuth2/OIDC")
Rel(LibraryManagementSystem, EUPaymentGateway, "Integrates for payment processing", "REST and mTLS")
Rel(LibraryManagementSystem, EUNotificationService, "Integrates for sending notifications", "REST and mTLS")
@enduml