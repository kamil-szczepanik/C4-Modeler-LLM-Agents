@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(Library_Patrons, "Library Patrons", "End-users accessing self-service search and borrowing portals.")
Person(Librarians_Circulation_Staff, "Librarians / Circulation Staff", "Users managing daily cataloguing and circulation.")
Person(Library_Administrators, "Library Administrators", "Users handling reporting, analytics, and system inventory.")

System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "External system for authentication and MFA.")
System_Ext(Payment_Gateway, "Payment Gateway", "External system for processing fines and fees.")
System_Ext(EU_Cloud_CDN_Provider, "EU Cloud/CDN Provider", "Edge infrastructure for content delivery and latency reduction.")

System_Boundary(Library_Management_System, "Library Management System") {
    Container(Web_Application_SPA, "Web Application (SPA)", "React / TypeScript", "Frontend single-page application providing user interfaces for patrons, staff, and administrators.")
    Container(API_Gateway_Nginx_Kong, "API Gateway (Nginx / Kong)", "Nginx / Kong", "Handles routing, rate limiting, and JWT validation.")
    Container(Catalogue_Search_Service, "Catalogue & Search Service", "Spring Boot / Node.js with OpenSearch", "Provides high-performance search and cataloging capabilities.")
    Container(Circulation_Service, "Circulation Service", "Spring Boot", "Manages circulation workflows and borrowing operations.")
    Container(Notification_Service, "Notification Service", "Python / Celery with Sendinblue/Brevo EU", "Handles asynchronous email and SMS notifications.")
    Container(Analytics_Reporting_Service, "Analytics & Reporting Service", "Spring Boot / ClickHouse", "Processes and provides system analytics and reporting.")
    Container(Event_Broker, "Event Broker", "Apache Kafka / AWS EventBridge EU", "Enables asynchronous messaging and event-driven workflows across services.")
    Container(OpenTelemetry_Collector_Audit_Logging_Service, "OpenTelemetry Collector & Audit Logging Service", "OpenTelemetry", "Collects telemetry data and provides audit logging.")
    ContainerDb(Managed_Databases, "Managed Databases", "PostgreSQL Multi-AZ, Read Replica / ClickHouse", "Stores relational data and search indexes securely within EU managed cloud services.")
}

Rel(Library_Patrons, Web_Application_SPA, "Interacts with self-service portals", "HTTPS (TLS 1.3)")
Rel(Librarians_Circulation_Staff, Web_Application_SPA, "Manages circulation and cataloging", "HTTPS (TLS 1.3)")
Rel(Library_Administrators, Web_Application_SPA, "Accesses analytics and reports", "HTTPS (TLS 1.3)")
Rel(Web_Application_SPA, API_Gateway_Nginx_Kong, "Sends client requests", "HTTPS (TLS 1.3)")
Rel(API_Gateway_Nginx_Kong, Catalogue_Search_Service, "Routes search and catalog queries", "gRPC and internal REST")
Rel(API_Gateway_Nginx_Kong, Circulation_Service, "Routes circulation requests", "gRPC and internal REST")
Rel(API_Gateway_Nginx_Kong, Analytics_Reporting_Service, "Routes reporting requests", "gRPC and internal REST")
Rel(Catalogue_Search_Service, Managed_Databases, "Queries and persists catalogue data and search indexes", "private VPC")
Rel(Circulation_Service, Managed_Databases, "Queries and persists circulation data", "private VPC")
Rel(Catalogue_Search_Service, Event_Broker, "Publishes and consumes asynchronous events", "Kafka / EventBridge protocol")
Rel(Circulation_Service, Event_Broker, "Publishes and consumes asynchronous events", "Kafka / EventBridge protocol")
Rel(Notification_Service, Event_Broker, "Consumes notification events", "Kafka / EventBridge protocol")
Rel(Notification_Service, EU_Cloud_CDN_Provider, "Sends EU-compliant emails and SMS", "Sendinblue/Brevo EU API")
Rel(API_Gateway_Nginx_Kong, Identity_Provider_IdP, "Validates user authentication and MFA", "OAuth 2.0 / OIDC")
Rel(Circulation_Service, Payment_Gateway, "Processes fines and fees", "REST APIs over TLS 1.3")

@enduml