@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalogue & Search Service container

System_Boundary(catalogue_search_service, "Catalogue & Search Service") {
    Component(Search Controller & Query Optimizer, "Search Controller & Query Optimizer", "Spring Boot, Project Reactor", "Handles search requests and optimizes queries for high-performance patron searches.")
    Component(Catalog Management Component, "Catalog Management Component", "Spring Boot", "Manages catalog assets, metadata, and circulation records.")
    Component(OpenSearch Indexing & Sync Engine, "OpenSearch Indexing & Sync Engine", "OpenSearch Engine", "Synchronizes domain events asynchronously for search index updates.")
    Component(Data Access Repository, "Data Access Repository", "Spring Data JPA, PostgreSQL", "Interacts with managed databases via private VPC for transactional and search data.")
    Component(Event Publisher Component, "Event Publisher Component", "Apache Kafka, Resilience4j", "Publishes catalog changes and telemetry using Kafka with fault-tolerant circuit breaking.")
}

System_Ext(Event Broker (Apache Kafka), "Event Broker (Apache Kafka)", "Asynchronous event broker for telemetry and data synchronization")

Rel(Search Controller & Query Optimizer, Data Access Repository, "Queries transactional data and search indexes via private VPC", "")
Rel(Catalog Management Component, Data Access Repository, "Persists and retrieves catalog metadata", "")
Rel(OpenSearch Indexing & Sync Engine, Data Access Repository, "Updates search indexes", "")
Rel(Event Publisher Component, Event Broker (Apache Kafka), "Publishes catalog changes and telemetry using Kafka protocol", "")
Rel(OpenSearch Indexing & Sync Engine, Event Broker (Apache Kafka), "Consumes domain events for asynchronous index synchronization", "")

@enduml