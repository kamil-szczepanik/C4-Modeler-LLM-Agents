@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Managed Databases container

Person(circulation_service, "Circulation Service", "External container")
Person(catalogue_search_service, "Catalogue & Search Service", "External container")
Person(analytics_reporting_service, "Analytics & Reporting Service", "External container")

Container_Boundary(managed_databases, "Managed Databases") {
    Component(postgresql_primary_node, "PostgreSQL Primary Node", "AWS RDS / Cloud SQL EU-Central, PostgreSQL Multi-AZ", "Provides secure, highly available data persistence for transactional data with EU-only data residency, automated backups, and CMEK encryption.")
    Component(postgresql_read_replica, "PostgreSQL Read Replica", "PostgreSQL", "Handles read-only queries to separate read traffic from the primary node.")
    Component(clickhouse_cluster, "ClickHouse Cluster", "ClickHouse", "Delivers dedicated, isolated columnar performance for administrative analytics and reporting.")
    Component(pgbouncer_connection_pooling_proxies, "PgBouncer Connection Pooling Proxies", "PgBouncer", "Provides connection pooling to prevent thread exhaustion during traffic spikes.")
    Component(customer_managed_encryption_keys_cmek, "Customer-Managed Encryption Keys (CMEK)", "EU-region KMS", "Enforces robust security and encryption for data persistence.")
}

Rel(circulation_service, pgbouncer_connection_pooling_proxies, "Transactions", "TCP/6432, TLS")
Rel(catalogue_search_service, pgbouncer_connection_pooling_proxies, "Read-only queries", "TCP/6432, TLS")
Rel(analytics_reporting_service, clickhouse_cluster, "Columnar data ingestion/queries", "TCP/9000, TLS")
Rel(pgbouncer_connection_pooling_proxies, postgresql_primary_node, "Routes writes", "TCP")
Rel(pgbouncer_connection_pooling_proxies, postgresql_read_replica, "Routes reads", "TCP")
Rel(postgresql_primary_node, customer_managed_encryption_keys_cmek, "Uses for encryption", "API")
Rel(postgresql_read_replica, customer_managed_encryption_keys_cmek, "Uses for encryption", "API")
@enduml