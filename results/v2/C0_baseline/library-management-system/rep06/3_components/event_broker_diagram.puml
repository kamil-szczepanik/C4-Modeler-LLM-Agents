@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Event Broker", "Event Broker") {
    Component("Kafka Brokers", "Kafka Brokers", "Apache Kafka", "Handles ingestion and storage of asynchronous events for high throughput and zero message loss.")
    Component("Schema Registry", "Schema Registry", "Confluent Schema Registry", "Validates event schemas for catalogue and circulation services.")
    Component("Access Control & Auth Manager", "Access Control & Auth Manager", "SASL/SCRAM / mTLS", "Manages access control and authentication within the event broker.")
    Component("OpenTelemetry Interceptor", "OpenTelemetry Interceptor", "OpenTelemetry", "Intercepts event streams to capture traces and metrics.")
    Component("DLQ Manager", "DLQ Manager", "Kafka DLQ", "Manages dead-letter queues for handling failed message processing.")
    Component("Metrics Exporter", "Metrics Exporter", "Prometheus Exporter", "Exports metrics from the event broker to observability tools.")
    Component("MirrorMaker2 Replication Controller", "MirrorMaker2 Replication Controller", "Kafka MirrorMaker2", "Handles cross-cluster replication and synchronization.")
}

Rel("Kafka Brokers", "OpenTelemetry Interceptor", "Passes event telemetry data", "")
Rel("Schema Registry", "Kafka Brokers", "Validates event schemas during ingestion", "")

@enduml