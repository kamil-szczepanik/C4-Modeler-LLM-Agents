@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(web_application_spa, "Web Application (SPA)") {
    Component(Authentication_Session_Manager, "Authentication & Session Manager", "react-oidc-context", "In-memory token management using Authorization Code Flow with PKCE.")
    Component(Role_Based_UI_Router, "Role-Based UI Router", "React Router", "Manages persona-specific routing for patrons, librarians, and administrators.")
    Component(API_Client_Layer, "API Client Layer", "TanStack Query / Axios", "Client-side data fetching and caching to meet sub-800ms search targets.")
    Component(Localization_Accessibility_Engine, "Localization & Accessibility Engine", "react-i18next", "Provides multi-language support and ensures WCAG 2.1 AA accessibility compliance.")
    Component(Offline_State_Persistence_Manager, "Offline & State Persistence Manager", "IndexedDB with Zustand", "Secure, non-PII offline state caching for patchy Wi-Fi degradation.")
}

Rel(Role_Based_UI_Router, Authentication_Session_Manager, "Validates user session and roles")
Rel(API_Client_Layer, Authentication_Session_Manager, "Injects access tokens into API requests")
Rel(Offline_State_Persistence_Manager, API_Client_Layer, "Syncs cached state with server responses")

@enduml