@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Notification Service container

System_Ext(Event_Broker, "Event Broker", "Apache Kafka / AWS EventBridge EU", "Publishes and routes notification events to consumers.")
System_Ext(Sendinblue_Brevo_EU, "Sendinblue/Brevo EU", "External Service", "External messaging provider ensuring strict EU-only data residency.")
System_Ext(OpenTelemetry_Collector, "OpenTelemetry Collector", "Observability Collector", "Collects structured logs and traces.")

Container_Boundary(Notification_Service, "Notification Service") {
    Component(Notification_Consumer, "Notification Consumer", "Python / Celery Worker", "Consumes notification events and handles asynchronous task orchestration for high throughput.")
    Component(Preference_Manager, "Preference Manager", "Python / FastAPI or Django", "Manages patron preferences and communication settings.")
    Component(Dispatch_Adapter, "Dispatch Adapter", "Sendinblue/Brevo EU API Client", "Sends outbound notifications ensuring strict EU-only data residency.")
    Component(Template_Engine, "Template Engine", "Jinja2", "Sandboxed template engine for localized, multi-language rendering and unsubscribe headers.")
    Component(Audit__Metrics_Publisher, "Audit & Metrics Publisher", "OpenTelemetry SDK", "Emits structured logs and traces for audit logging and delivery tracking.")
    Component(Redis, "Redis", "Redis", "State store and deduplication cache for caching and idempotency tracking with encryption at rest for PII protection.")
}

Rel(Event_Broker, Notification_Consumer, "Consumes notification events", "Kafka/AMQP protocol")
Rel(Notification_Consumer, Template_Engine, "Renders localized messages", "Internal Function Call")
Rel(Template_Engine, Dispatch_Adapter, "Sends formatted payload", "Internal Function Call")
Rel(Dispatch_Adapter, Sendinblue_Brevo_EU, "Sends outbound notifications", "HTTPS API, TLS 1.3")
Rel(Audit__Metrics_Publisher, OpenTelemetry_Collector, "Emits structured logs and traces", "OTLP over gRPC")

@enduml