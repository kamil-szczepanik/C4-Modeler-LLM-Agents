@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway (Nginx / Kong) container

System_Ext(Web_Application_SPA, "Web Application (SPA)", "Client application")
System_Ext(Identity_Provider_IdP, "Identity Provider (IdP)", "External IdP")
System_Ext(Catalogue_Search_Service, "Catalogue & Search Service", "Microservice")
System_Ext(Circulation_Service, "Circulation Service", "Microservice")

Container_Boundary(api_gateway_boundary, "API Gateway (Nginx / Kong)") {
    Component(SSL_TLS_Termination_Routing_Engine, "SSL/TLS Termination & Routing Engine", "Nginx core", "Handles ingress traffic and internal gRPC/mTLS dispatch.")
    Component(Auth_Security_Plugin, "Auth & Security Plugin", "OAuth 2.0 / OIDC / JWT", "Validates JWTs, enforces RBAC, and interacts with the Identity Provider (IdP).")
    Component(Rate_Limiting_Throttling_Filter, "Rate Limiting & Throttling Filter", "Kong / Nginx module", "Protects backend services and enforces request quotas.")
    Component(Telemetry_Audit_Interceptor, "Telemetry & Audit Interceptor", "OpenTelemetry", "Injects W3C Trace Context headers to the OpenTelemetry Collector.")
    ComponentDb(Redis_Cache, "Redis Cache", "Redis (Local/Cluster)", "Caches JWT tokens and session data via RESP over TLS.")
}

Rel(Web_Application_SPA, SSL_TLS_Termination_Routing_Engine, "Client requests via HTTPS [TLS 1.3]", "HTTPS")
Rel(Auth_Security_Plugin, Identity_Provider_IdP, "Token validation and introspection via HTTPS/OIDC", "HTTPS/OIDC")
Rel(SSL_TLS_Termination_Routing_Engine, Catalogue_Search_Service, "Internal routing via gRPC over mTLS", "gRPC / mTLS")
Rel(SSL_TLS_Termination_Routing_Engine, Circulation_Service, "Internal routing via gRPC over mTLS", "gRPC / mTLS")
Rel(Auth_Security_Plugin, Redis_Cache, "Token and session verification via RESP over TLS", "RESP over TLS")

@enduml