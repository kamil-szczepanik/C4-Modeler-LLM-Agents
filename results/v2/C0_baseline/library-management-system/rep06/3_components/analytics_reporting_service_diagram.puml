@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Analytics & Reporting Service container

Container_Boundary(analytics_reporting_service, "Analytics & Reporting Service") {
    Component(AnalyticsRESTController, "Analytics REST Controller", "Spring MVC", "Routes reporting requests received from the API Gateway.")
    Component(DashboardWidgetProvider, "Dashboard Widget Provider", "Spring MVC / REST", "Provides real-time operational widgets for administrators and librarians.")
    Component(ReportQueryEngine, "Report Query Engine", "Spring Data JPA / ClickHouse JDBC", "Executes compliant batch reports and analytical queries against ClickHouse.")
    Component(DataAnonymizationModule, "Data Anonymization Module", "Java", "Enforces strict GDPR data anonymization.")
    Component(ExportScheduler, "Export Scheduler", "Spring Scheduler / Apache POI & OpenCSV", "Handles asynchronous generation of CSV and PDF report exports.")
    Component(QueryCachingLayer, "Query Caching Layer", "Spring Cache / Caffeine", "Checks and stores aggregated metrics to protect the ClickHouse database from high-volume dashboard polling.")
    ComponentDb(ManagedDatabases, "Managed Databases", "ClickHouse", "High-performance columnar database for analytics and reporting.")
}

Rel(AnalyticsRESTController, ReportQueryEngine, "Delegates queries", "In-process")
Rel(AnalyticsRESTController, DashboardWidgetProvider, "Delegates queries", "In-process")
Rel(DashboardWidgetProvider, QueryCachingLayer, "Checks/stores aggregated metrics", "In-process")
Rel(QueryCachingLayer, ReportQueryEngine, "Fallback for cache misses", "In-process")
Rel(ReportQueryEngine, ManagedDatabases, "Executes analytical queries", "TCP / Native Protocol, TLS")

@enduml