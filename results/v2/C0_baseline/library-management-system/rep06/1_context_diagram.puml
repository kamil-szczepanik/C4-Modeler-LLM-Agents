@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(LibraryPatrons, "Library Patrons", "End-users accessing self-service search and borrowing portals.")
Person(LibrariansCirculationStaff, "Librarians / Circulation Staff", "Users managing daily cataloguing and circulation.")
Person(LibraryAdministrators, "Library Administrators", "Users handling reporting, analytics, and system inventory.")

System(LibraryManagementSystem, "Library Management System", "A comprehensive platform for public and academic libraries to catalogue physical and digital items, manage circulation, and provide self-service portals with strict EU-only data residency and sub-second search performance.")

System_Ext(IdentityPoviderIdP, "Identity Provider (IdP)", "External system for authentication and MFA.")
System_Ext(PaymentGateway, "Payment Gateway", "External system for processing fines and fees.")
System_Ext(EUCloudCDNProvider, "EU Cloud/CDN Provider", "Edge infrastructure for content delivery and latency reduction.")

Rel(LibraryPatrons, LibraryManagementSystem, "Accesses self-service search and borrowing portals", "HTTPS over Web/Mobile UI")
Rel(LibrariansCirculationStaff, LibraryManagementSystem, "Manages daily cataloguing and circulation", "HTTPS over Web/Mobile UI")
Rel(LibraryAdministrators, LibraryManagementSystem, "Handles reporting, analytics, and system inventory", "HTTPS over Web/Mobile UI")
Rel(LibraryManagementSystem, IdentityPoviderIdP, "Authenticates users and handles MFA", "OAuth 2.0 / OpenID Connect over TLS 1.3")
Rel(LibraryManagementSystem, PaymentGateway, "Processes fines and fees", "REST APIs over TLS 1.3")
@enduml