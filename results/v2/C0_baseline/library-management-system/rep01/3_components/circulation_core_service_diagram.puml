@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Circulation & Core Service container

Container_Boundary(circulation_core_service, "Circulation & Core Service") {
    Component(CirculationEngineComponent, "Circulation Engine Component", "Java, Spring Boot", "Manages checkouts, renewals, and holds.")
    Component(FineFeeManagerComponent, "Fine & Fee Manager Component", "Java, Spring Boot", "Handles financial ledgers and payment integrations.")
    Component(PatronAccountCoordinatorComponent, "Patron Account Coordinator Component", "Java, Spring Boot", "Manages circulation blocks and account states.")
}

ComponentDb(PostgreSQLEUInstance, "PostgreSQL (EU Instance)", "Relational Database", "EU-hosted relational database with primary-replica streaming.")
Component(PaymentGateway, "Payment Gateway", "External System", "External system for processing fines and fees.")
Component(NotificationDispatcher, "Notification Dispatcher", "Python, FastAPI", "Notification Dispatcher service via RabbitMQ/Kafka.")
Component(AuditLoggingContainer, "Audit Logging Container", "Node.js", "Container for immutable audit trails.")

Rel(CirculationEngineComponent, PostgreSQLEUInstance, "Persists transactional loan states via JDBC over TLS 1.3 (strict ACID).", "JDBC / TLS 1.3")
Rel(FineFeeManagerComponent, PaymentGateway, "Processes financial settlements via REST over mTLS (TLS 1.3).", "REST / mTLS")
Rel(FineFeeManagerComponent, NotificationDispatcher, "Publishes asynchronous outbox events via AMQP/Kafka over TLS.", "AMQP/Kafka / TLS")
Rel(PatronAccountCoordinatorComponent, AuditLoggingContainer, "Dispatches immutable audit trails via gRPC over mTLS.", "gRPC / mTLS")

@enduml