@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "External API Gateway routing incoming traffic.")
System_Ext(observability_platform, "Observability Platform", "Collects metrics and traces.")

Container_Boundary(catalog_and_search_service, "Catalog & Search Service") {
    Component(search_api_controller, "Search API Controller", "Go", "Exposes endpoints for multi-faceted search and discovery workflows.")
    Component(indexing_worker, "Indexing Worker", "Go", "Consumes catalog change events to update Elasticsearch indices.")
    Component(event_consumer_worker, "Event Consumer Worker", "Go", "Processes inventory events from the message broker.")
    Component(local_availability_cache_component, "Local Availability Cache Component", "Go/BigCache", "Stores real-time branch availability in-memory.")
    Component(elasticsearch_cluster, "Elasticsearch Cluster", "Elasticsearch", "Backs multi-faceted queries and catalogue metadata storage.")
}

Rel(api_gateway, search_api_controller, "Routes incoming queries", "gRPC over mTLS")
Rel(search_api_controller, elasticsearch_cluster, "Executes search queries", "HTTP/REST over TCP")
Rel(search_api_controller, local_availability_cache_component, "Performs local status lookups", "In-memory lookup, <5ms")
Rel(event_consumer_worker, local_availability_cache_component, "Updates inventory states", "In-memory write")
Rel(indexing_worker, elasticsearch_cluster, "Syncs metadata", "HTTP with HMAC/mTLS")
Rel(catalog_and_search_service, observability_platform, "Streams Prometheus metrics and traces", "OTLP over TLS")

@enduml