@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Frontend Container container

System_Ext(External_Identity_Provider, "External Identity Provider", "")
System_Ext(API_Gateway, "API Gateway", "")
System_Ext(EU_CDN, "EU CDN", "")

Container_Boundary(Frontend_Container, "Frontend Container") {
    Component(Routing_Auth_Module, "Routing & Auth Module", "React Router, OIDC Client", "Handles navigation and authentication using Authorization Code Flow with PKCE.")
    Component(Catalog_UI_Component, "Catalog UI Component", "React, TypeScript", "Renders item searches and filtering.")
    Component(Circulation_UI_Component, "Circulation UI Component", "React, TypeScript", "Manages self-service checkouts, renewals, and admin workflows.")
    Component(API_Client_Service, "API Client Service", "Axios/Fetch wrapper", "Dispatches backend requests and injects correlation IDs and observability hooks.")
}

Rel(Routing_Auth_Module, External_Identity_Provider, "Authenticates users", "Authorization Code Flow with PKCE, OIDC")
Rel(Catalog_UI_Component, API_Client_Service, "Dispatches UI actions", "Internal TypeScript calls")
Rel(Circulation_UI_Component, API_Client_Service, "Dispatches UI actions", "Internal TypeScript calls")
Rel(API_Client_Service, API_Gateway, "Sends backend requests", "HTTPS / REST APIs")
Rel(Frontend_Container, EU_CDN, "Serves static assets", "HTTPS, Subresource Integrity (SRI)")

@enduml