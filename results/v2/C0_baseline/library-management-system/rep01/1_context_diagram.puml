@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Library Management System

Person(LibraryPatrons, "Library Patrons", "End-users accessing self-service portals.")
Person(Librarians, "Librarians", "Internal users managing inventory and circulation.")
Person(LibraryAdministrators, "Library Administrators", "Internal users handling system reporting and oversight.")

System(LibraryManagementSystem, "Library Management System", "A cloud-native platform for public and academic libraries to catalogue physical and digital items, manage circulation, and provide self-service portals while enforcing strict EU data residency.")

System_Ext(ExternalIdentityProvider, "External Identity Provider", "EU-hosted IdP for authentication.")
System_Ext(PaymentGateway, "Payment Gateway", "EU region payment processor for fees and fines.")
System_Ext(NotificationService, "Notification Service", "EU instance for loan reminders and notices.")
System_Ext(ObservabilityPlatform, "Observability Platform", "EU-hosted telemetry and monitoring system.")

Rel(LibraryPatrons, LibraryManagementSystem, "Interacts with self-service portals", "HTTPS (TLS 1.3)")
Rel(Librarians, LibraryManagementSystem, "Manages inventory and circulation", "HTTPS (TLS 1.3)")
Rel(LibraryAdministrators, LibraryManagementSystem, "Handles system reporting and oversight", "HTTPS (TLS 1.3)")
Rel(LibraryManagementSystem, ExternalIdentityProvider, "Authenticates users", "OpenID Connect (OIDC)")
Rel(LibraryManagementSystem, PaymentGateway, "Integrates for processing fees and fines", "REST over mTLS (TLS 1.3)")
Rel(LibraryManagementSystem, NotificationService, "Integrates for loan reminders and notices", "REST over mTLS (TLS 1.3)")
Rel(LibraryManagementSystem, ObservabilityPlatform, "Forwards telemetry and monitoring data", "OpenTelemetry Protocol (OTLP) over TLS")

@enduml