@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(LibraryPatrons, "Library Patrons", "End-users accessing self-service portals.")
Person(Librarians, "Librarians", "Internal users managing inventory and circulation.")
Person(LibraryAdministrators, "Library Administrators", "Internal users handling system reporting and oversight.")

System_Ext(IdentityProvider, "Identity Provider", "External EU-hosted Identity Provider for authentication.")
System_Ext(PaymentGateway, "Payment Gateway", "External payment processor for fees and fines.")
System_Ext(NotificationService, "Notification Service", "External notification service for notices.")
System_Ext(ObservabilityPlatform, "Observability Platform", "External observability platform for metrics and traces.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(FrontendContainer, "Frontend Container", "React, TypeScript, EU CDN", "Single Page Application hosted on an EU CDN for responsive self-service and administrative UIs.")
    Container(APIGateway, "API Gateway", "Nginx, Kong", "Reverse proxy managing ingress, rate-limiting, and JWT validation.")
    Container(CatalogSearchService, "Catalog & Search Service", "Node.js, Go, Elasticsearch", "Core container handling catalogue and high-performance search.")
    Container(CirculationCoreService, "Circulation & Core Service", "Java, Spring Boot, PostgreSQL", "Core container handling circulation workflows and transactional integrity.")
    Container(NotificationDispatcher, "Notification Dispatcher", "Python, FastAPI, RabbitMQ/Kafka", "Core container for asynchronous message distribution and dispatching.")
    Container(AuditLoggingContainer, "Audit Logging Container", "Node.js", "Core container handling audit logging and compliance.")
}

Rel(LibraryPatrons, FrontendContainer, "Accesses self-service portal", "HTTPS over TLS 1.3")
Rel(Librarians, FrontendContainer, "Accesses management UI", "HTTPS over TLS 1.3")
Rel(LibraryAdministrators, FrontendContainer, "Accesses administrative UI", "HTTPS over TLS 1.3")
Rel(FrontendContainer, APIGateway, "Sends requests to backend services", "HTTPS / REST APIs")
Rel(APIGateway, CatalogSearchService, "Routes search and catalog queries", "gRPC over mTLS")
Rel(APIGateway, CirculationCoreService, "Routes circulation and transactional operations", "gRPC over mTLS")
Rel(APIGateway, NotificationDispatcher, "Routes notification tasks", "gRPC over mTLS")
Rel(APIGateway, AuditLoggingContainer, "Routes audit logs", "gRPC over mTLS")
Rel(NotificationDispatcher, NotificationService, "Dispatches notifications asynchronously", "TLS-secured AMQP/MQTT")
Rel(CatalogSearchService, IdentityProvider, "Authenticates via IdP", "OIDC / HTTPS")
Rel(CirculationCoreService, PaymentGateway, "Processes fees and fines", "REST over mTLS (TLS 1.3)")
Rel(CatalogSearchService, ObservabilityPlatform, "Streams metrics and traces", "OpenTelemetry Protocol (OTLP) over TLS")
Rel(CirculationCoreService, ObservabilityPlatform, "Streams metrics and traces", "OpenTelemetry Protocol (OTLP) over TLS")
Rel(NotificationDispatcher, ObservabilityPlatform, "Streams metrics and traces", "OpenTelemetry Protocol (OTLP) over TLS")
Rel(AuditLoggingContainer, ObservabilityPlatform, "Streams metrics and traces", "OpenTelemetry Protocol (OTLP) over TLS")

@enduml