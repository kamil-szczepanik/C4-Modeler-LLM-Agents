@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(LibraryPatrons, "Library Patrons", "Public or academic library users who access the system via the patron portal.")
Person(LibraryStaff, "Library Staff", "Circulation staff and administrators who manage the system via the staff portal.")

System_Ext(PaymentGateway, "Payment Gateway", "External system used to charge fees.")
System_Ext(IdentityProviderSSO, "Identity Provider / SSO", "External system used for authentication and federated academic SSO.")
System_Ext(NotificationService, "Notification Service", "External system used to send alerts.")
System_Ext(LoggingAPM, "Logging & APM", "External system used for observability and monitoring.")

System_Boundary(LibraryManagementSystem, "Library Management System") {
    Container(PatronWebApp, "Patron Web Application", "React / TypeScript", "Frontend web application for library patrons served via CDN.")
    Container(StaffAdminPortal, "Staff Administration Portal", "Angular / TypeScript", "Frontend web application for library staff and administrators.")
    Container(ApiGateway, "API Gateway", "Nginx / Spring Cloud Gateway", "Single reverse proxy enforcing TLS 1.3 and JWT authentication.")
    Container(CoreDomainServices, "Core Domain Services", "Node.js / NestJS", "Modular monolith core domain services.")
    Container(SearchEngine, "Search Engine", "Elasticsearch", "Dedicated search engine ensuring sub-800ms P99 response times.")
    ContainerDb(RelationalDatabase, "Relational Database", "PostgreSQL", "Relational database for transactional consistency with AES-256 encryption.")
    Container(AsyncEventBus, "Async Event Bus", "RabbitMQ / Apache Kafka", "Async event bus for decoupled event-driven architecture.")
    Container(NotificationWorker, "Notification Worker", "Node.js / NestJS", "Background worker handling notifications.")
}

Rel(LibraryPatrons, PatronWebApp, "Accesses self-service portal", "HTTPS")
Rel(LibraryStaff, StaffAdminPortal, "Accesses administration portal", "HTTPS")
Rel(PatronWebApp, ApiGateway, "Sends API requests", "HTTPS/REST")
Rel(StaffAdminPortal, ApiGateway, "Sends API requests", "HTTPS")
Rel(ApiGateway, CoreDomainServices, "Routes requests", "mTLS")
Rel(CoreDomainServices, RelationalDatabase, "Reads and writes transactional data", "mTLS")
Rel(CoreDomainServices, SearchEngine, "Performs search queries", "mTLS")
Rel(CoreDomainServices, AsyncEventBus, "Publishes domain events", "mTLS")
Rel(NotificationWorker, NotificationService, "Sends notifications", "HTTPS/API Keys")
Rel(CoreDomainServices, IdentityProviderSSO, "Authenticates users", "SAML/OIDC")
Rel(CoreDomainServices, PaymentGateway, "Processes fee payments", "HTTPS/REST")
Rel(CoreDomainServices, LoggingAPM, "Sends telemetry and logs", "HTTPS")

@enduml