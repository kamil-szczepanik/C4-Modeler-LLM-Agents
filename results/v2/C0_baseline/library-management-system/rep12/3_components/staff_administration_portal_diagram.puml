@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(FrontlineLibrariansLibraryAdministrators, "Frontline Librarians & Library Administrators", "Primary users accessing the system with role-based access control.")

System_Ext(IdentityProviderSSO, "Identity Provider / SSO", "Manages authentication and issues tokens.")
System_Ext(APIGateway, "API Gateway", "Entry point for backend integration communicating via HTTPS/REST and WebSockets.")

Container_Boundary(StaffAdministrationPortal, "Staff Administration Portal") {
    Component(CirculationManagementModule, "Circulation Management Module", "Angular / TypeScript, IndexedDB with Web Crypto API (AES-GCM)", "Handles check-ins, check-outs, and patron account updates with offline resilience.")
    Component(AdministrationReportingModule, "Administration & Reporting Module", "Angular / TypeScript", "Manages library operations reporting and administrative tasks.")
    Component(CoreStateAuthService, "Core State & Auth Service", "Angular / TypeScript, OAuth2/OIDC", "Manages application state, route guards, and OIDC/OAuth2 authentication.")
    Component(ClientSideCachingOfflineFallbackService, "Client-Side Caching & Offline Fallback Service", "IndexedDB / Web Crypto API", "Provides encrypted offline caching for circulation workflows.")
}

Rel(FrontlineLibrariansLibraryAdministrators, CirculationManagementModule, "Accesses", "HTTPS")
Rel(FrontlineLibrariansLibraryAdministrators, AdministrationReportingModule, "Accesses", "HTTPS")
Rel(CirculationManagementModule, APIGateway, "Communicates", "HTTPS/REST and WebSockets with circuit breakers and IndexedDB fallback")
Rel(AdministrationReportingModule, APIGateway, "Communicates", "HTTPS/REST")
Rel(CoreStateAuthService, IdentityProviderSSO, "Authenticates", "OIDC/OAuth2 over HTTPS")
Rel(CirculationManagementModule, ClientSideCachingOfflineFallbackService, "Uses", "Encrypted offline caching")
@enduml