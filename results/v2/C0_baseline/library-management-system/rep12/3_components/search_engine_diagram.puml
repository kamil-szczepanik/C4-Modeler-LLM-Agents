@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Search Engine container

System_Ext(Core_Domain_Services, "Core Domain Services", "External core domain services and API gateway.")
System_Ext(Async_Event_Bus, "Async Event Bus", "External asynchronous message broker.")
System_Ext(Logging_APM_System, "Logging & APM System", "External logging, telemetry, and monitoring system.")

Container_Boundary(Search_Engine, "Search Engine") {
    Component(Query_Processing_Component, "Query Processing Component", "Elasticsearch Analysis & Query DSL, Synonym Token Filter, Aggregation Engine", "Provides instant, secure catalogue discovery, faceted navigation, and processes search queries with promotional boosting rules.")
    Component(Indexing_Synchronization_Component, "Indexing & Synchronization Component", "AMQP/Kafka Consumer", "Consumes asynchronous catalogue updates to keep the search index synchronized.")
    Component(Search_Analytics_Logging_Component, "Search Analytics & Logging Component", "HTTPS/TLS", "Flushes search telemetry, zero-result events, and audit logs.")
}

Rel(Core_Domain_Services, Query_Processing_Component, "Delivers search queries, faceted results, and promotional boosting rules", "mTLS/REST")
Rel(Async_Event_Bus, Indexing_Synchronization_Component, "Consumes asynchronous catalogue updates", "SASL/SCRAM over TLS")
Rel(Search_Analytics_Logging_Component, Logging_APM_System, "Flushes search telemetry, zero-result events, and audit logs", "HTTPS/TLS")

@enduml