@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(core_domain_services, "Core Domain Services", "External system container interacting with the database.")

Container_Boundary(relational_database, "Relational Database") {
    Component(postgres_primary_storage_engine, "PostgreSQL 16 Primary Storage Engine", "PostgreSQL 16", "Handles ACID-compliant circulation states and financial audit logs via WAL.")
    Component(read_only_replica, "Read-Only Replica", "PostgreSQL 16", "Offloads administrative reporting queries from library staff.")
    Component(patroni_and_etcd, "Patroni and etcd", "Patroni / etcd", "Manages high availability, multi-zone clustering, and automated failover.")
    Component(pgbouncer, "PgBouncer", "PgBouncer", "Provides connection pooling at the container boundary.")
    Component(barman_pgbackrest, "Barman / pgBackRest", "pgBackRest", "Executes continuous WAL archiving for Point-in-Time Recovery (PITR).")
    Component(pgaudit, "pgaudit", "pgaudit", "Extension for logging DDL, DML, and privileged actions.")
}

Rel(core_domain_services, postgres_primary_storage_engine, "Executes transactional writes and critical reads", "PostgreSQL Protocol over mTLS")
Rel(core_domain_services, read_only_replica, "Executes non-blocking analytical reads and reporting queries", "PostgreSQL Protocol over mTLS")
Rel(postgres_primary_storage_engine, read_only_replica, "Streams replication data", "encrypted mTLS connections")

@enduml