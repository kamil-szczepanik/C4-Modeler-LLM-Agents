@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patron Web Application container

System_Ext(api_gateway, "API Gateway", "API Gateway")
System_Ext(identity_provider, "Identity Provider", "Identity Provider")

Container_Boundary(patron_web_app, "Patron Web Application") {
    Component(Search_Discovery_Component, "Search & Discovery Component", "React / TypeScript", "Queries catalogue and handles high-frequency search rendering.")
    Component(Account_Circulation_Component, "Account & Circulation Component", "React / TypeScript", "Manages loans, holds, and state-heavy circulation logic.")
    Component(Authentication_Boundary_Component, "Authentication Boundary Component", "React / TypeScript / OIDC Client", "Authenticates patrons and ensures robust in-memory token security.")
    Component(Digital_Checkout_Reader_Component, "Digital Checkout & Reader Component", "React / TypeScript / PDF.js", "Streams and renders digital media securely within volatile browser memory.")
    Component(Notification_Feedback_Component, "Notification & Feedback Component", "React / TypeScript", "Receives live alerts and real-time patron notifications.")
}

Rel(Search_Discovery_Component, api_gateway, "Queries catalogue", "HTTPS / REST")
Rel(Account_Circulation_Component, api_gateway, "Manages loans and holds", "HTTPS / REST")
Rel(Digital_Checkout_Reader_Component, api_gateway, "Streams digital assets", "HTTPS / REST")
Rel(Notification_Feedback_Component, api_gateway, "Receives live alerts", "WebSocket / WSS")
Rel(Authentication_Boundary_Component, identity_provider, "Authenticates patrons", "HTTPS / OIDC")

@enduml