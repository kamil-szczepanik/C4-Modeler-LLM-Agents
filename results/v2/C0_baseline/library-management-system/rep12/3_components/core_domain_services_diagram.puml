@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(core_domain_services, "Core Domain Services") {
    Component(Catalog Component, "Catalog Component", "Node.js / NestJS, TypeScript", "Manages cataloging items and inventory within the modular monolith.")
    Component(Circulation Component, "Circulation Component", "Node.js / NestJS, TypeScript", "Handles item checkout, checkin, renewals, and patron circulation rules.")
    Component(Billing Component, "Billing Component", "Node.js / NestJS, TypeScript, Opossum Circuit Breaker", "Processes fee payments and communicates with the external Payment Gateway.")
    Component(Search Integration Component, "Search Integration Component", "Node.js / NestJS, TypeScript, Elasticsearch", "Interfaces with the Search Engine to meet high-performance search queries.")
    Component(Audit & Compliance Component, "Audit & Compliance Component", "Node.js / NestJS, TypeScript", "Ensures strict EU-only data residency and handles telemetry, logs, and audit trails.")
}

System_Ext(Relational Database, "Relational Database", "Stores transactional data")
System_Ext(Payment Gateway, "Payment Gateway", "Processes fee payments")
System_Ext(Search Engine, "Search Engine", "Provides high-performance search queries")
System_Ext(Async Event Bus, "Async Event Bus", "Publishes and distributes domain events")
System_Ext(Logging & APM, "Logging & APM", "Collects telemetry, logs, and audit trails")
System_Ext(Identity Provider / SSO, "Identity Provider / SSO", "Handles user authentication")

Rel(Catalog Component, Relational Database, "Reads/writes catalog data", "mTLS / PgBouncer")
Rel(Circulation Component, Relational Database, "Reads/writes circulation data", "mTLS / PgBouncer")
Rel(Billing Component, Payment Gateway, "Processes fee payments", "HTTPS/REST / Circuit Breaker")
Rel(Search Integration Component, Search Engine, "Performs high-performance search queries", "mTLS")
Rel(Catalog Component, Async Event Bus, "Publishes domain events", "mTLS")
Rel(Circulation Component, Async Event Bus, "Publishes domain events", "mTLS")
Rel(Billing Component, Async Event Bus, "Publishes domain events", "mTLS")
Rel(Audit & Compliance Component, Logging & APM, "Sends telemetry, logs, and audit trails", "HTTPS")
Rel(core_domain_services, Identity Provider / SSO, "Authenticates users", "SAML/OIDC")

@enduml