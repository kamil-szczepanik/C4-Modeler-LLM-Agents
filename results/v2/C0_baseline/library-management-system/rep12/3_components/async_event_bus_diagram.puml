@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(async_event_bus, "Async Event Bus") {
    Component(Event_Broker_Cluster, "Event Broker Cluster", "Apache Kafka Brokers", "Managing distributed commit logs for high-throughput event streaming.")
    Component(Schema_Registry, "Schema Registry", "Confluent Schema Registry", "Enforcing Avro/JSON payloads, payload governance, and backward compatibility.")
    Component(Topic_Manager___ACL_Enforcer, "Topic Manager / ACL Enforcer", "Custom / Kafka Native", "Handles topic creation and role-based access control via TLS client certificates.")
    Component(Kafka_Connect, "Kafka Connect", "Confluent Kafka Connect", "Streaming data to external sinks such as the Search Engine.")
    Component(MirrorMaker_2, "MirrorMaker 2", "Apache Kafka MirrorMaker 2", "Implements automated cross-AZ mirroring for disaster recovery.")
}

Rel(Event_Broker_Cluster, Kafka_Connect, "Streams domain changes via TLS", "")
Rel(Schema_Registry, Event_Broker_Cluster, "Provides schema governance and validation for event payloads", "")
@enduml