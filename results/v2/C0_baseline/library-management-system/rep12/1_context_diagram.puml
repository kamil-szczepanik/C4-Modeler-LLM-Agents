@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(LibraryPatrons, "Library Patrons", "Public or academic library users who access the system via the Self-Service Portal.")
Person(LibraryStaff, "Library Staff", "Circulation staff and administrators who manage the system via the Admin/Staff Portal.")

System(LibraryManagementSystem, "Library Management System", "A cloud-hosted SaaS platform designed for public and academic libraries to catalogue physical and digital items, manage circulation, and provide self-service portals with strict EU-only data residency.")

System_Ext(PaymentGateway, "Payment Gateway", "External system used to charge fees.")
System_Ext(IdentityProvider, "Identity Provider / SSO", "External system used for authentication and federated academic SSO.")
System_Ext(NotificationService, "Notification Service", "External system used to send alerts.")
System_Ext(LoggingAPM, "Logging & APM", "External system (Datadog/Prometheus) used for observability and monitoring.")

Rel(LibraryPatrons, LibraryManagementSystem, "uses Self-Service Portal", "HTTPS")
Rel(LibraryStaff, LibraryManagementSystem, "manages Admin/Staff Portal", "HTTPS")
Rel(LibraryManagementSystem, PaymentGateway, "charges fees", "HTTPS/REST (Async via Message Queue)")
Rel(LibraryManagementSystem, IdentityProvider, "authenticates via", "SAML/OIDC")
Rel(LibraryManagementSystem, NotificationService, "sends alerts", "HTTPS/REST (Async via Message Queue)")

@enduml