@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(LibraryPatronStaff, "Library Patron & Library Staff", "Users who interact with the system to catalogue items, manage circulation, and use self-service portals.")

System(LibraryManagementSystem, "Library Management System", "A comprehensive digital solution for public and academic libraries designed to catalogue items, manage circulation, and provide self-service portals with strict EU-only data residency.")

System_Ext(ExternalIdentityProvider, "External Identity Provider", "Handles delegated authentication and tiered identity federation using OAuth2/OIDC.")
System_Ext(DigitalContentProviders, "Digital Content Providers", "Provide digital content via REST APIs.")
System_Ext(ThirdPartyPaymentProcessor, "Third-Party Payment Processor", "Processes payments securely.")
System_Ext(ExternalNotificationGateway, "External Notification Gateway", "Handles communications via SMTP/Push API and Webhooks.")
System_Ext(EUcertifiedCloudProviderInfrastructure, "EU-certified Cloud Provider Infrastructure", "Provides EU-hosted cloud region infrastructure enforcing strict data residency constraints.")

Rel(LibraryPatronStaff, LibraryManagementSystem, "Interacts with the system for cataloguing, circulation, and self-service portals", "HTTPS / TLS 1.3")
Rel(LibraryManagementSystem, ExternalIdentityProvider, "Integrates for delegated authentication and identity federation", "OAuth 2.0 / OIDC")
Rel(LibraryManagementSystem, DigitalContentProviders, "Calls for digital content integration", "REST APIs")
Rel(LibraryManagementSystem, ThirdPartyPaymentProcessor, "Connects to process payments securely", "HTTPS")
Rel(LibraryManagementSystem, ExternalNotificationGateway, "Communicates to send notifications", "REST / Webhooks")

@enduml