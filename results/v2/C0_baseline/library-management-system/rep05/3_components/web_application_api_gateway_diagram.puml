@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application / API Gateway container

Container_Boundary(web_app_api_gateway, "Web Application / API Gateway") {
    Component(NextSSRClient, "Next.js SSR Client", "Next.js / React / TypeScript", "Server-side rendering for fast initial loads, SEO, and accessibility (WCAG 2.1 AA).")
    Component(APIRouterMiddleware, "API Router & Proxy Middleware", "Node.js / Express", "Scalable API Gateway runtime for routing and middleware execution.")
    Component(gRPCRESTClientSDKs, "gRPC/REST Client SDKs", "gRPC over HTTP/2", "Low-latency communication for performance-critical catalog searches.")
    Component(EdgeFeatureFlagEvaluator, "Edge Feature Flag Evaluator", "TypeScript / Zod", "Strict payload sanitization, input validation at the edge, and feature flag evaluation.")
    Component(TelemetryTraceContextInjector, "Telemetry & Trace Context Injector", "OpenTelemetry", "End-to-end distributed tracing with W3C trace context injection.")
}

Rel(NextSSRClient, APIRouterMiddleware, "Routes client requests", "HTTPS")
Rel(APIRouterMiddleware, EdgeFeatureFlagEvaluator, "Validates and sanitizes payloads", "Zod")
Rel(APIRouterMiddleware, gRPCRESTClientSDKs, "Invokes backend services", "gRPC over HTTP/2, mTLS")
Rel(APIRouterMiddleware, TelemetryTraceContextInjector, "Injects trace context", "OpenTelemetry / W3C Trace Context")

@enduml