@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Event Bus container

Person(Producers, "Producers", "")
System_Ext(Catalog_Service, "Catalog Service", "")
System_Ext(Circulation_Service, "Circulation Service", "")
System_Ext(Notification_Service, "Notification Service", "")
System_Ext(OpenTelemetry_Backend, "OpenTelemetry Backend", "")

Container_Boundary(Event_Bus, "Event Bus") {
    Component(Broker_Engine, "Broker Engine", "Apache Kafka, Strimzi Operator", "Event-driven decoupling mechanism providing log retention, high throughput, and native stream-processing deployed on Kubernetes.")
    Component(Schema_Registry, "Schema Registry", "Avro, JSON Schema", "Enforces strict contract validation at the broker boundary over HTTP/TLS.")
    Component(Topic_Partition_Manager, "Topic Partition Manager", "Kafka Native Partition Assignment and Replication", "Manages partition assignment and replication with min. ISR = 2 for reliability.")
    Component(Dead_Letter_Queue_DLQ_Handler, "Dead Letter Queue (DLQ) Handler", "Encrypted Restricted Access Storage", "Captures poisoned messages with encrypted, restricted access.")
    Component(Event_Stream_Compaction_Engine, "Event Stream Compaction Engine", "Kafka State-Based Topic Management", "Manages state-based topics and audit trails.")
}

Rel(Catalog_Service, Schema_Registry, "Validate event schemas over HTTP/TLS", "")
Rel(Circulation_Service, Schema_Registry, "Validate event schemas over HTTP/TLS", "")
Rel(Producers, Broker_Engine, "Publish events via Kafka protocol over TLS 1.3 with mTLS, SASL/SCRAM-512, and idempotent producers", "")
Rel(Broker_Engine, Notification_Service, "Push-based consumer delivery using Kafka consumer groups", "")
Rel(Broker_Engine, OpenTelemetry_Backend, "Export metrics via Prometheus exporters and tracing headers (W3C Trace Context)", "")

@enduml