@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(web_api_gateway, "Web Application / API Gateway", "External gateway or application exporting telemetry.")
System_Ext(external_notification_gateway, "External Notification Gateway", "External service for dispatching incident alerts.")

Container_Boundary(observability_backend, "Observability Backend") {
    Component(otel_collector, "OpenTelemetry Collector", "Go", "Standardized, polyglot telemetry collection and built-in edge PII scrubbing.")
    Component(metrics_db, "Time-Series Metrics Database", "VictoriaMetrics / Prometheus - C++", "Efficient, high-cardinality metrics storage supporting R-05 search latency tracking.")
    Component(trace_store, "Distributed Trace Store", "Grafana Tempo - Go", "Cost-effective, object-storage-backed distributed trace analysis.")
    Component(grafana_ui, "Visualization UI & Alerting Engine", "Grafana - TypeScript/Go", "Unified visualization, RBAC dashboarding, and threshold-based alerting.")
}

Rel(web_api_gateway, otel_collector, "Exports traces/metrics", "OTLP/gRPC with mTLS")
Rel(otel_collector, metrics_db, "Writes metrics", "Prometheus Remote Write")
Rel(otel_collector, trace_store, "Writes spans", "OTLP/gRPC")
Rel(grafana_ui, metrics_db, "Queries data", "PromQL with OIDC RBAC")
Rel(grafana_ui, trace_store, "Queries data", "TraceQL with OIDC RBAC")
Rel(grafana_ui, external_notification_gateway, "Dispatches incident alerts", "HTTPS/REST with HMAC")

@enduml