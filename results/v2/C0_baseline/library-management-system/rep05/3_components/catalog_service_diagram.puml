@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Catalog Service container

Container_Boundary(catalog_service, "Catalog Service") {
    Component(CatalogController, "Catalog Controller", "Spring Boot Java", "Handles incoming catalog queries and commands from the API Gateway and delegates digital retrieval requests.")
    Component(CatalogManagementService, "Catalog Management Service", "Spring Boot Java", "Manages catalog metadata business logic, persists to relational storage, and publishes mutation events.")
    Component(SearchIndexingEngine, "Search & Indexing Engine", "Spring Boot Java / Elasticsearch Client", "Executes low-latency full-text searches against the search engine.")
    Component(ContentSyncClient, "Content Sync Client", "Spring Boot Java", "Synchronizes content data across services.")
    Component(DigitalAccessCoordinator, "Digital Access Coordinator", "Spring Boot Java", "Delegates digital retrieval requests and interacts with external digital content providers.")
}

Rel(CatalogController, DigitalAccessCoordinator, "Delegates digital retrieval requests", "gRPC")
Rel(CatalogManagementService, PostgreSQL, "Persists relational catalog metadata", "JDBC / Spring Data JPA")
Rel(SearchIndexingEngine, Elasticsearch, "Executes low-latency full-text searches", "Elasticsearch REST Client")
Rel(CatalogManagementService, EventBus, "Publishes metadata mutation events via Transactional Outbox Pattern", "Spring Kafka / AMQP")
Rel(DigitalAccessCoordinator, DigitalContentProviders, "Requests access tokens and streaming links", "HTTPS / OAuth2")

@enduml