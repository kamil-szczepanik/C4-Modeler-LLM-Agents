@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(Elasticsearch, "Elasticsearch") {
    Component(QueryParsingRoutingEngine, "Query Parsing & Routing Engine", "Elasticsearch Internal Module", "Parses incoming search queries and routes them internally via IPC.")
    Component(DistributedInvertedIndex, "Distributed Inverted Index", "Lucene-based Distributed Inverted Index", "Delivers sub-800ms P99 search latency by indexing and searching catalogue data.")
    Component(ClusterCoordinator, "Cluster Coordinator", "Elasticsearch Cluster Coordination", "Manages cluster state, node discovery, and self-healing operations within the EU cloud.")
    Component(FacetedAggregationEngine, "Faceted Aggregation Engine", "Elasticsearch Aggregations Module", "Computes analytic facets and aggregations for search results.")
    Component(FuzzyMatcher, "Fuzzy Matcher", "Elasticsearch Fuzzy Search", "Handles approximate string matching and typo-tolerant search queries.")
}

Rel(QueryParsingRoutingEngine, DistributedInvertedIndex, "Routes parsed queries via internal IPC", "Internal IPC")
Rel(QueryParsingRoutingEngine, FacetedAggregationEngine, "Routes aggregation requests via internal IPC", "Internal IPC")
Rel(QueryParsingRoutingEngine, FuzzyMatcher, "Routes fuzzy match requests via internal IPC", "Internal IPC")

@enduml