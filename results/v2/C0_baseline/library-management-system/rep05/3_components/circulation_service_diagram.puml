@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Circulation Service container

Component(WebApplicationAPIGateway, "Web Application / API Gateway", "gRPC / REST", "Routes circulation queries and commands.")
Component_Ext(ObservabilityBackend, "Observability Backend", "OpenTelemetry", "Exports distributed traces.")
Component_Ext(ThirdPartyPaymentProcessor, "Third-Party Payment Processor", "HTTPS/REST, OAuth2, mTLS", "Processes fine payments.")
Component_Ext(EventBus, "Event Bus", "Apache Kafka / RabbitMQ", "Publishes notification-bound events.")

Container_Boundary(CirculationService, "Circulation Service") {
    Component(LoanManagementComponent, "Loan Management Component", "Spring Boot Java", "Enforces lending policies and manages loans, persisting transaction history.")
    Component(FineFeeComponent, "Fine & Fee Component", "Spring Boot Java", "Processes fines and fees via a third-party payment processor.")
    Component(PolicyEngineComponent, "Policy Engine Component", "Spring Boot Java", "Enforces circulation and lending policies.")
    Component(NotificationDispatcherComponent, "Notification Dispatcher Component", "Spring Boot Java", "Dispatches internal domain events and publishes notification-bound events.")
    ComponentDb(PostgreSQL, "PostgreSQL", "PostgreSQL", "Persists transaction history securely within the EU region with AES-256 PII encryption.")
}

Rel(WebApplicationAPIGateway, CirculationService, "Routes circulation queries and commands", "gRPC / REST")
Rel(LoanManagementComponent, PostgreSQL, "Persists transaction history", "JDBC, TLS 1.3, EU region")
Rel(FineFeeComponent, ThirdPartyPaymentProcessor, "Processes fine payments", "HTTPS/REST, OAuth2, mTLS, Certificate Pinning")
Rel(LoanManagementComponent, NotificationDispatcherComponent, "Dispatches internal domain events", "Spring Application Events")
Rel(NotificationDispatcherComponent, EventBus, "Publishes notification-bound events", "AMQP / Kafka, mTLS, Application-level Envelope Encryption")
Rel(CirculationService, ObservabilityBackend, "Exports distributed traces", "OpenTelemetry")

@enduml