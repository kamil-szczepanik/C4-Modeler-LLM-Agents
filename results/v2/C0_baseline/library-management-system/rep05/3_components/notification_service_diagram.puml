@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(EventBus, "Event Bus", "Apache Kafka / RabbitMQ", "Reliable message transport with Dead-Letter Queues (DLQ).")
System_Ext(ExternalNotificationGateway, "External Notification Gateway", "External Service / REST / SMTP / HTTPS", "External gateway responsible for final message delivery.")
System_Ext(WebApplication, "Web Application", "External System", "Consumes internal APIs.")

Container_Boundary(NotificationService, "Notification Service") {
    Component(EventConsumerComponent, "Event Consumer Component", "Python FastAPI Container / Background Tasks", "Consumes domain events asynchronously from the Event Bus.")
    Component(TemplateEngineComponent, "Template Engine Component", "Jinja2", "Handles localized template rendering within the EU cloud boundary.")
    Component(DispatcherComponent, "Dispatcher Component", "Python FastAPI", "Coordinates message routing and dispatching logic.")
    Component(ChannelAdaptersComponent, "Channel Adapters Component", "Python / REST / SMTP / HTTPS", "Adapts messages for delivery through external notification gateways.")
    Component(PreferenceCacheComponent, "Preference Cache Component", "Redis", "Read-optimized preference caching with AOF persistence.")
    Component(StatusTrackerComponent, "Status Tracker Component", "Python FastAPI", "Tracks delivery statuses and receives webhooks from external gateways.")
    Component(InternalAPIComponent, "Internal API Component", "Python FastAPI / HTTP / JSON with JWT", "Exposes endpoints for retrieving notification logs and internal communication.")
}

Rel(EventBus, EventConsumerComponent, "Consumes domain events", "AMQP / Kafka")
Rel(ChannelAdaptersComponent, ExternalNotificationGateway, "Delivers messages", "REST / SMTP / HTTPS")
Rel(ExternalNotificationGateway, StatusTrackerComponent, "Sends delivery webhooks", "HTTPS")
Rel(WebApplication, InternalAPIComponent, "Retrieves notification logs", "HTTP / JSON with JWT")
Rel(EventBus, PreferenceCacheComponent, "Syncs user preferences", "AMQP / Kafka")

@enduml