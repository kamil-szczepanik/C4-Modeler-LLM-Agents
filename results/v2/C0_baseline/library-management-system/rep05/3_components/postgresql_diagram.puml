@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(postgresql, "PostgreSQL") {
    Component(PrimaryDatabaseEngine, "Primary Database Engine", "PostgreSQL v15+", "Primary relational database engine ensuring robust ACID compliance, zero data loss, and transactional integrity.")
    Component(ConnectionPooler, "Connection Pooler", "PgBouncer", "Prevents connection exhaustion under heavy load from Spring Boot services.")
    Component(FailoverManager, "Failover Manager", "Patroni", "Automated high-availability clustering and failover management.")
    Component(SchemaMigrationManager, "Schema Migration Manager", "Flyway / Liquibase", "Utilized for version-controlled, zero-downtime database schema migrations.")
    Component(AuditLogger, "Audit Logger", "pgaudit", "Enabled for comprehensive DDL, DCL, and data access logging to achieve audit readiness.")
}

Rel(ConnectionPooler, PrimaryDatabaseEngine, "Routes encrypted database connections via local UNIX domain sockets or loopback TCP with strict RBAC.")
Rel(FailoverManager, PrimaryDatabaseEngine, "Manages automated primary-replica failover.")
Rel(SchemaMigrationManager, PrimaryDatabaseEngine, "Applies version-controlled database schema migrations.")
Rel(AuditLogger, PrimaryDatabaseEngine, "Logs DDL, DCL, and data access events.")
@enduml