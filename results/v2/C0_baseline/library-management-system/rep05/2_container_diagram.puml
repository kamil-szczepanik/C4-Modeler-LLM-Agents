@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Library Management System

Person(Library_Patron_Library_Staff, "Library Patron & Library Staff", "Users who interact with the system to catalogue items, manage circulation, and use self-service portals.")

System_Ext(External_Identity_Provider, "External Identity Provider", "Handles delegated authentication and tiered identity federation using OAuth2/OIDC.")
System_Ext(Digital_Content_Providers, "Digital Content Providers", "Provide digital content via REST APIs.")
System_Ext(Third_Party_Payment_Processor, "Third-Party Payment Processor", "Processes payments securely.")
System_Ext(External_Notification_Gateway, "External Notification Gateway", "Handles communications via SMTP/Push API and Webhooks.")
System_Ext(EU_certified_Cloud_Provider_Infrastructure, "EU-certified Cloud Provider Infrastructure", "Provides EU-hosted cloud region infrastructure enforcing strict data residency constraints.")

System_Boundary(Library_Management_System, "Library Management System") {
    Container(Web_Application_API_Gateway, "Web Application / API Gateway", "Next.js / Node.js TypeScript", "Fast, scalable API gateway and client entry point.")
    Container(Catalog_Service, "Catalog Service", "Spring Boot Java", "Robust enterprise service for catalog management.")
    Container(Circulation_Service, "Circulation Service", "Spring Boot Java", "Robust enterprise service for circulation management.")
    Container(Notification_Service, "Notification Service", "Python FastAPI", "Lightweight service for notification handling.")
    ContainerDb(PostgreSQL, "PostgreSQL", "PostgreSQL", "Primary relational database for persistent storage.")
    ContainerDb(Elasticsearch, "Elasticsearch", "Elasticsearch", "Search engine enabling sub-800ms search capability.")
    Container(Event_Bus, "Event Bus", "Apache Kafka / RabbitMQ", "Event-driven decoupling and asynchronous processing with Dead Letter Queues.")
    Container(Observability_Backend, "Observability Backend", "OpenTelemetry", "Polyglot distributed tracing and observability backend.")
}

Rel(Library_Patron_Library_Staff, Web_Application_API_Gateway, "Accesses self-service portals and system features", "HTTPS (TLS 1.3, OAuth2/OIDC)")
Rel(Web_Application_API_Gateway, Catalog_Service, "Routes catalog queries and commands", "gRPC / REST")
Rel(Web_Application_API_Gateway, Circulation_Service, "Routes circulation queries and commands", "gRPC / REST")
Rel(Catalog_Service, Digital_Content_Providers, "Retrieves digital content", "HTTPS")
Rel(Circulation_Service, Event_Bus, "Publishes circulation events", "AMQP / Kafka (mTLS, Payload Encryption)")
Rel(Event_Bus, Notification_Service, "Consumes events to trigger notifications", "AMQP / Kafka")
Rel(Event_Bus, Circulation_Service, "Consumes asynchronous events", "AMQP / Kafka")
Rel(Web_Application_API_Gateway, Observability_Backend, "Sends telemetry and trace data", "OpenTelemetry")

@enduml