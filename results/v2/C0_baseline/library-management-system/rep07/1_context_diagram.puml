@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(LibraryPatrons, "Library Patrons", "End users who use self-service portals to access and borrow physical and digital library items.")
Person(LibrariansCirculationStaff, "Librarians / Circulation Staff", "Staff members responsible for managing item circulation and day-to-day library operations.")
Person(LibraryAdministrators, "Library Administrators", "Administrators who configure and manage the Library Management System.")
Person(ThirdPartyVendorsDigitalContentProviders, "Third-Party Vendors / Digital Content Providers", "External providers supplying digital content and items to the library system.")

System(LibraryManagementSystem, "Library Management System", "A EU-compliant platform designed for public and academic libraries to catalogue physical and digital items, manage circulation, and provide self-service portals, guaranteeing strict data residency and high-performance search capabilities.")

System_Ext(EUPaymentGateway, "EU Payment Gateway", "External payment processing system for financial transactions.")
System_Ext(NotificationService, "Notification Service", "External service used for sending notifications to users.")

Rel(LibraryPatrons, LibraryManagementSystem, "Accesses self-service portals for circulation and catalog tasks", "HTTPS (TLS 1.3), OAuth 2.0 / OIDC")
Rel(LibrariansCirculationStaff, LibraryManagementSystem, "Manages library items and circulation", "HTTPS (TLS 1.3), OAuth 2.0 / OIDC")
Rel(LibraryAdministrators, LibraryManagementSystem, "Configures and administers the platform", "HTTPS (TLS 1.3), OAuth 2.0 / OIDC")
Rel(ThirdPartyVendorsDigitalContentProviders, LibraryManagementSystem, "Provides digital content and items ingestion", "SFTP / HTTPS REST webhooks")
Rel(LibraryManagementSystem, EUPaymentGateway, "Processes payments securely", "HTTPS/REST protocols")
Rel(LibraryManagementSystem, NotificationService, "Sends asynchronous notifications", "HTTPS/SMTP protocols via message broker")

@enduml