@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(spa, "Single Page Application (SPA)") {
    Component(RoutingAuthModule, "Routing & Authentication Module", "React with TypeScript", "Manages application routes, user sessions, token handling, and strict security controls.")
    Component(CatalogSearchComponent, "Catalog & Search Component", "React with TypeScript", "Isolates high-frequency search input and displays catalog data to meet sub-800ms performance NFRs.")
    Component(CirculationAdminWorkspace, "Circulation & Admin Workspace", "React with TypeScript", "Provides interfaces for self-service patron portals, staff circulation workflows, and administration.")
    Component(ApiClientLayer, "API Client Layer (HTTP Interceptor) & State/Cache Manager", "React with TypeScript", "Handles HTTP requests, response interception, state management, and client-side caching.")
}

Rel(RoutingAuthModule, ApiClientLayer, "Sends authenticated requests", "HTTPS/REST/JSON")
Rel(CatalogSearchComponent, ApiClientLayer, "Fetches search and catalog data", "HTTPS/REST/JSON")
Rel(CirculationAdminWorkspace, ApiClientLayer, "Executes circulation and admin workflows", "HTTPS/REST/JSON")

@enduml