@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Domain Container container

Container_Boundary(core_domain_container, "Core Domain Container") {
    Component(Cataloguing Component, "Cataloguing Component", "Spring Data JPA", "Handles item cataloguing and data management within the core domain.")
    Component(Circulation Component, "Circulation Component", "Domain-Driven Design / Spring Transaction", "Manages circulation logic and transactional data processing.")
    Component(Outbox Pattern Component, "Outbox Pattern Component", "Debezium / JDBC Poller", "Ensures reliable event publishing via the transactional outbox pattern.")
    Component(Audit and Compliance Component, "Audit and Compliance Component", "Spring Data Envers / append-only tables", "Enforces compliance and maintains append-only audit data.")
    Component(Security and Context Propagation Component, "Security and Context Propagation Component", "Spring Security, OAuth2/OIDC JWT", "Handles authentication, JWT validation, and context propagation.")
}

Rel(Cataloguing Component, Audit and Compliance Component, "Logs cataloguing changes and audit data")
Rel(Circulation Component, Outbox Pattern Component, "Publishes domain events via outbox")
Rel(Security and Context Propagation Component, Circulation Component, "Propagates security context for requests")

@enduml