@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Search Container container

Container_Boundary(search_container, "Search Container") {
    Component(SearchService, "Search Service", "Java / Spring Boot", "Unified runtime for search routing, synchronization, and analytics.")
    Component(SearchIndex, "Search Index", "Elasticsearch 8.x", "Scalable storage with fuzzy matching and faceted search support.")
}

Rel(SearchService, SearchIndex, "Elasticsearch Native Bolt/REST with mTLS")

@enduml