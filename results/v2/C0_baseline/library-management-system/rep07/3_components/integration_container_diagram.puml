@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Container container

Person_Ext(Third_Party_Vendors_Digital_Content_Providers, "Third-Party Vendors / Digital Content Providers", "External providers of digital content.")
System_Ext(EU_Payment_Gateway, "EU Payment Gateway", "External secure payment processing gateway.")
System_Ext(Async_Event_Broker, "Async Event Broker", "Handles asynchronous event publishing using SASL/SCRAM and mTLS.")
System_Ext(Core_Domain_Container, "Core Domain Container", "Persists immutable audit trails and core library management data within an EU-isolated VPC.")

Container_Boundary(Integration_Container, "Integration Container") {
    Component(Webhook_Handler_Component, "Webhook Handler Component", "Node.js/Express", "Receives secure financial webhooks from the EU Payment Gateway with HMAC verification.")
    Component(Vendor_Ingestion_Service, "Vendor Ingestion Service", "Node.js/TypeScript with Zod", "Ingests digital content from Third-Party Vendors and provides strict schema validation.")
    Component(Outbox_Dispatcher_Component, "Outbox Dispatcher Component", "Node.js/TypeScript", "Publishes events reliably to the Async Event Broker.")
    Component(Audit_Logging_Component, "Audit Logging Component", "Node.js/Winston or Pino", "Persists immutable audit trails to the Core Domain Container.")
}

Rel(Third_Party_Vendors_Digital_Content_Providers, Vendor_Ingestion_Service, "Ingests digital content", "HTTPS / SFTP with TLS 1.3")
Rel(EU_Payment_Gateway, Webhook_Handler_Component, "Sends secure financial webhooks", "HTTPS with HMAC verification")
Rel(Outbox_Dispatcher_Component, Async_Event_Broker, "Publishes events reliably", "SASL/SCRAM, mTLS")
Rel(Audit_Logging_Component, Core_Domain_Container, "Persists immutable audit trails", "gRPC/REST over TLS within EU-isolated VPC")

@enduml