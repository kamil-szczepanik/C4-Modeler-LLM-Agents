@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(Edge_Router_and_Security_Filter, "Edge Router and Security Filter", "Spring Cloud Gateway", "Handles edge routing, security policies, and request normalization.")
    Component(Rate_Limiting_Evaluator, "Rate Limiting Evaluator", "Spring Cloud Gateway & Redis", "Evaluates traffic quotas and rate limits against the Redis cluster.")
}

Rel(Edge_Router_and_Security_Filter, Rate_Limiting_Evaluator, "Checks traffic quotas and rate limits")

@enduml