@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(async_event_broker, "Async Event Broker") {
    Component(Apache_Kafka, "Apache Kafka", "Append-only log architecture / KRaft", "Acts as the async event broker providing event sourcing and partition-level ordering across 3 EU availability zones.")
    Component(Strimzi_Operator, "Strimzi Operator", "Kubernetes Operator", "Manages deployment, KRaft consensus, and lifecycle management for the broker.")
    Component(KRaft_Metadata_Quorum, "KRaft Metadata Quorum", "KRaft", "Replaces ZooKeeper for broker state management and consensus.")
    Component(Confluent_Schema_Registry, "Confluent Schema Registry", "Avro / Confluent Schema Registry", "Co-located within the Strimzi footprint for Avro schema validation and contract compatibility.")
}

Rel(Strimzi_Operator, Apache_Kafka, "Manages deployment and KRaft consensus", "")
Rel(Apache_Kafka, Apache_Kafka, "Inter-broker communication secured", "Internal mTLS")
@enduml