@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "Individuals accessing their personal health records and appointments.")
Person("Clinical Staff", "Clinical Staff", "Doctors and nurses accessing patient records and clinical tools.")
Person("Administrative Staff", "Administrative Staff", "Staff managing scheduling and office operations.")

System_Ext("Identity Provider (IdP)", "Identity Provider (IdP)", "Centralized authentication service for OIDC/SAML MFA.")
System_Ext("Lab/Imaging Systems", "Lab/Imaging Systems", "Diagnostic systems providing medical data via HL7 FHIR.")

System_Boundary(cms, "Clinic Management System") {
    Container("Patient Portal", "Patient Portal", "React, Next.js", "Web interface for patients to manage appointments and view records.")
    Container("Administrative Dashboard", "Administrative Dashboard", "Angular", "Web interface for clinical and admin staff to manage operations.")
    Container("Spring Cloud Gateway", "Spring Cloud Gateway", "Spring Cloud Gateway", "Entry point for traffic routing, security, and OIDC/OAuth2 enforcement.")
    Container("Core EMR Service", "Core EMR Service", "Spring Boot", "Handles primary electronic medical record transactional logic.")
    Container("Billing Service", "Billing Service", "Go", "Manages financial transactions and billing cycles.")
    Container("Audit Visualization Service", "Audit Visualization Service", "Java/Spring", "Provides visual audit trails for compliance.")
    Container("Read-Only Analytics Service", "Read-Only Analytics Service", "Java/Spring", "Provides analytical reporting capabilities.")
    ContainerDb("PostgreSQL", "PostgreSQL", "CloudNativePG", "Primary transactional data store.")
    ContainerDb("ClickHouse", "ClickHouse", "ClickHouse", "High-performance analytical database.")
    Container("Debezium", "Debezium", "Debezium", "CDC connector for real-time data streaming.")
    Container("HashiCorp Vault", "HashiCorp Vault", "HashiCorp Vault", "Centralized management of dynamic secrets.")
}

Rel(Patients, "Patient Portal", "Accesses health records", "HTTPS")
Rel("Clinical Staff", "Administrative Dashboard", "Accesses clinical tools", "HTTPS")
Rel("Administrative Staff", "Administrative Dashboard", "Manages scheduling and billing", "HTTPS")
Rel("Patient Portal", "Spring Cloud Gateway", "Routes requests", "REST/gRPC")
Rel("Administrative Dashboard", "Spring Cloud Gateway", "Routes requests", "REST/gRPC")
Rel("Spring Cloud Gateway", "Identity Provider (IdP)", "Authenticates users", "OIDC/OAuth2")
Rel("Spring Cloud Gateway", "Core EMR Service", "Forwards requests", "mTLS")
Rel("Spring Cloud Gateway", "Billing Service", "Forwards requests", "mTLS")
Rel("Core EMR Service", "PostgreSQL", "Reads/Writes transactions", "SQL")
Rel("PostgreSQL", "Debezium", "Streams transactional changes", "CDC")
Rel("Debezium", "ClickHouse", "Populates analytics store", "Streaming")
Rel("Core EMR Service", "Lab/Imaging Systems", "Retrieves diagnostic data", "HL7 FHIR")
Rel("Core EMR Service", "HashiCorp Vault", "Retrieves secrets", "API")

@enduml