@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container(SpringCloudGateway, "Spring Cloud Gateway", "REST/gRPC", "Handles routing and request mediation for the portal.")
Container(HashiCorpVault, "HashiCorp Vault", "Secret Management", "Provides keys for application-level and message-level encryption.")
Container(IdP, "IdP", "OIDC/OAuth2", "Identity provider for claims-based access control validation.")

System_Boundary(PatientPortal, "Patient Portal") {
    Component(AuthenticationComponent, "Authentication Component", "OIDC/OAuth2", "Handles secure user authentication and identity provider integration.")
    Component(AppointmentManager, "Appointment Manager", "gRPC Client", "Manages patient appointment scheduling via gRPC service calls.")
    Component(RecordsViewer, "Records Viewer", "FHIR-compliant API", "Fetches and displays EMR data in a FHIR-compliant format.")
    Component(RelationshipManager, "Relationship Manager", "Logic Controller", "Manages delegation and proxy access permissions for patients.")
    Component(MessagingGateway, "Messaging Gateway", "WebSocket", "Facilitates real-time, secure communication between patients and care teams.")
    Component(AuditLoggingInterceptor, "Audit Logging Interceptor", "Asynchronous Sidecar", "Performs forensic tracking and logging of portal activities.")
}

Rel(PatientPortal, SpringCloudGateway, "Routes requests", "REST/gRPC")
Rel(MessagingGateway, HashiCorpVault, "Retrieves keys for message-level encryption", "Secret API")
Rel(AuthenticationComponent, IdP, "Validates credentials and performs CBAC validation", "OIDC/OAuth2")
Rel(AppointmentManager, SpringCloudGateway, "Invokes scheduling services", "gRPC")
Rel(RecordsViewer, SpringCloudGateway, "Fetches EMR data", "FHIR/REST")

@enduml