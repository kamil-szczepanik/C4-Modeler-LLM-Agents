@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container(Spring_Cloud_Gateway, "Spring Cloud Gateway", "Java/Spring", "Request forwarding via mTLS.")
Container(NATS, "NATS", "Message Queue", "Asynchronous claim submission and event streaming.")
Container_Ext(External_Billing_Gateway, "External Billing Gateway", "REST API", "Third-party financial transaction provider.")
ContainerDb(PostgreSQL, "PostgreSQL", "CloudNativePG", "Data persistence with field-level encryption and RLS.")
Container(Service_Mesh_Sidecar, "Service Mesh Sidecar", "Envoy/Istio", "Handles mTLS termination, retries, and rate-limiting.")

System_Boundary(Billing_Service, "Billing Service") {
    Component(Invoice_Manager, "Invoice Manager", "Go", "Handles billing cycle state transitions.")
    Component(Payment_Processor, "Payment Processor", "Go", "Manages external gateway interactions.")
    Component(Clearinghouse_Integration_Gateway, "Clearinghouse Integration Gateway", "Go", "Handles asynchronous claim submissions.")
    Component(Dispute_Reconciliation_Engine, "Dispute & Reconciliation Engine", "Go", "Manages collection pauses and audits.")
    Component(Event_Driven_Reporting_Projection, "Event-Driven Reporting Projection", "Go (CQRS)", "CQRS-based read-optimized aggregator.")
}

Rel(Spring_Cloud_Gateway, Billing_Service, "Forwards requests via mTLS")
Rel(Billing_Service, NATS, "Publishes claim submission events")
Rel(Billing_Service, External_Billing_Gateway, "Outbound API calls via Egress Proxy with circuit breakers")
Rel(Billing_Service, PostgreSQL, "Persists transaction data with RLS")
Rel(Service_Mesh_Sidecar, Billing_Service, "Manages mTLS, retries, and rate-limiting")

@enduml