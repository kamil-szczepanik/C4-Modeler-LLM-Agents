@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

System_Ext(gateway, "Spring Cloud Gateway", "External", "Forwards mTLS-secured requests")
System_Ext(postgres, "PostgreSQL", "Database", "Executes SQL transactions with Field-Level Encryption")
System_Ext(vault, "HashiCorp Vault", "Secrets Manager", "Retrieves Data Encryption Keys (DEKs)")
System_Ext(lab_systems, "Lab/Imaging Systems", "External", "Communicates via HL7 FHIR with Resilience4j circuit breaking")
System_Ext(audit_aggregator, "Compliance/Audit Log Aggregator", "External", "Performs synchronous, high-priority immutable event logging")
System_Ext(redis, "Redis", "Cache", "Caches FHIR resources to optimize latency")

Container_Boundary(core_emr_service, "Core EMR Service") {
    Component(patient_controller, "Patient Record Controller", "Spring Boot", "Primary entry point for managing patient medical records and transactional requests.")
    Component(encounter_manager, "Clinical Encounter Manager", "Spring Boot", "Orchestrates clinical encounter workflows and business logic.")
    Component(audit_interceptor, "Audit Trail Interceptor", "Spring Boot", "Intercepts requests to ensure all actions are logged for compliance.")
    Component(fhir_gateway, "FHIR Integration Gateway", "HAPI FHIR", "Handles interoperability and normalization of external lab and imaging data.")
    Component(emergency_manager, "Emergency Access Manager", "Spring Boot", "Manages break-glass access protocols and high-priority audit logging.")
    Component(normalization_engine, "Clinical Normalization Engine", "Spring Boot", "Transforms clinical data into a canonical internal model.")
    Component(opa_sidecar, "OPA Sidecar", "Open Policy Agent", "Enforces Attribute-Based Access Control (ABAC) for clinical data.")
}

Rel(gateway, core_emr_service, "Forwards mTLS-secured requests")
Rel(core_emr_service, postgres, "Executes SQL transactions with Field-Level Encryption")
Rel(core_emr_service, vault, "Retrieves Data Encryption Keys (DEKs)")
Rel(fhir_gateway, lab_systems, "Communicates via HL7 FHIR with Resilience4j circuit breaking")
Rel(emergency_manager, audit_aggregator, "Performs synchronous, high-priority immutable event logging")
Rel(core_emr_service, redis, "Caches FHIR resources to optimize latency")
Rel(core_emr_service, opa_sidecar, "Queries for authorization decisions")

@enduml