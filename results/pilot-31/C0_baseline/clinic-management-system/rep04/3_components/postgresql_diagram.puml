@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL container

Container_Boundary(PostgreSQL, "PostgreSQL") {
    Component(CloudNativePGOperator, "CloudNativePG Operator", "Kubernetes Operator", "Manages high-availability, synchronous replication, and declarative partitioning.")
    Component(pgaudit, "pgaudit", "PostgreSQL Extension", "Provides tamper-resistant logging for HIPAA/GDPR audit compliance.")
    Component(RLSEngine, "Row-Level Security (RLS) Engine", "PostgreSQL Native", "Enforces data access policies and supports cryptographic shredding for GDPR compliance.")
    Component(PartitioningModule, "Declarative Partitioning Module", "PostgreSQL Native", "Maintains P95 latency for EMR records over a 10-year retention period.")
    Component(PrometheusExporter, "Prometheus Exporter", "Sidecar", "Exports database metrics for observability in Grafana.")
}

Rel(CloudNativePGOperator, RLSEngine, "Configures access control policies", "Kubernetes API/SQL")
Rel(RLSEngine, pgaudit, "Logs access violations and modifications", "Internal Hook")
Rel(PartitioningModule, RLSEngine, "Applies policies to partitioned data segments", "SQL")
Rel(PrometheusExporter, CloudNativePGOperator, "Scrapes operational metrics", "HTTP")

@enduml