@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

System_Ext(Redis, "Redis", "Cache", "High-speed caching for token introspection and rate-limiting")
System_Ext(CoreEMR, "Core EMR Service", "Service", "Core clinical data management")
System_Ext(Billing, "Billing Service", "Service", "Administrative billing operations")
System_Ext(Audit, "Audit Visualization Service", "Service", "Compliance and audit log visualization")

Container_Boundary(SCG, "Spring Cloud Gateway") {
    Component(Router, "Request Router", "Project Reactor", "Handles non-blocking traffic routing and ingress management for clinical portals.")
    Component(Security, "Security Filter", "Spring Security / OIDC", "Manages authentication via OIDC/OAuth2 and interacts with Redis for token introspection.")
    Component(OPA, "OPA Sidecar Client", "Open Policy Agent", "Acts as a Policy Enforcement Point (PEP) communicating with the OPA sidecar for ABAC decisions.")
    Component(Telemetry, "Telemetry Interceptor", "OpenTelemetry", "Injects correlation IDs and traces for distributed monitoring.")
}

Rel(Router, Security, "Validates incoming requests", "Internal")
Rel(Security, Redis, "Performs JWT validation and token introspection", "TCP")
Rel(Security, OPA, "Requests ABAC policy decisions", "gRPC/Local")
Rel(Router, CoreEMR, "Routes mTLS-encrypted traffic", "mTLS")
Rel(Router, Billing, "Routes mTLS-encrypted traffic", "mTLS")
Rel(Router, Audit, "Routes mTLS-encrypted traffic", "mTLS")
Rel(Telemetry, CoreEMR, "Propagates X-Correlation-ID", "HTTP Header")

@enduml