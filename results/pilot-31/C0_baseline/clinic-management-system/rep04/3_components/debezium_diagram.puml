@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

System_Boundary(Debezium, "Debezium") {
    Component(PostgreSQL_Connector, "PostgreSQL Connector", "Debezium Connector", "Captures WAL events from PostgreSQL for real-time streaming.")
    Component(Kafka_Connect_Worker, "Kafka Connect Worker", "Distributed Java Node", "Distributed processing node for streaming tasks and connector execution.")
    Component(Credential_Manager, "Credential Manager", "HashiCorp Vault Integration", "Fetches dynamic credentials and performs Field-Level Encryption (FLE).")
    Component(Data_Transformer, "Data Transformer", "Java-based SMTs", "Performs pseudonymization and structural transformation with minimal CPU overhead.")
}

Rel(PostgreSQL_Connector, Kafka_Connect_Worker, "Streams change events to")
Rel(PostgreSQL_Connector, Credential_Manager, "Retrieves encryption keys and secrets from")
Rel(Kafka_Connect_Worker, Data_Transformer, "Executes SMTs via")

@enduml