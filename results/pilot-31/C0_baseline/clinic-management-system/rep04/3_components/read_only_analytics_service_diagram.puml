@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

System_Boundary(c1, "Read-Only Analytics Service") {
    Component(Aggregation_Controller, "Aggregation Controller", "Spring Boot", "Handles RESTful reporting requests from clients.")
    Component(Query_Orchestrator, "Query Orchestrator", "Spring Integration", "Manages asynchronous data fetching from ClickHouse.")
    Component(Privacy_Proxy, "Privacy Proxy", "Spring Security / Sidecar", "Enforces ABAC, dynamic data masking, and egress filtering.")
    Component(Audit_Interceptor, "Audit Interceptor", "Custom Interceptor", "Logs query context and access metadata to an immutable store.")
    Component(Metadata_Service, "Metadata Service", "Java", "Monitors Debezium replication lag for data freshness transparency.")
}

Container(ClickHouse, "ClickHouse", "Analytical Database", "Analytical data store for historical trends.")
Container(HashiCorp_Vault, "HashiCorp Vault", "Secret Management", "Manages secrets and field-level encryption keys.")
Container(Debezium, "Debezium", "CDC Tool", "Streams transactional data from PostgreSQL to ClickHouse.")
Container(Istio_Service_Mesh, "Istio Service Mesh", "Service Mesh", "Manages mTLS, traffic routing, and policy enforcement.")

Rel(Aggregation_Controller, Query_Orchestrator, "Forwards reporting requests")
Rel(Query_Orchestrator, ClickHouse, "Fetches analytical data")
Rel(Privacy_Proxy, Aggregation_Controller, "Intercepts and filters traffic")
Rel(Aggregation_Controller, Audit_Interceptor, "Logs request metadata")
Rel(Query_Orchestrator, HashiCorp_Vault, "Retrieves encryption keys")
Rel(Metadata_Service, Debezium, "Monitors replication lag")
Rel(c1, Istio_Service_Mesh, "Uses for mTLS and traffic routing")

@enduml