@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

System_Ext(EMR, "Core EMR Service", "Spring Boot application")
System_Ext(Workloads, "Workloads", "Microservices requiring secret access")
System_Ext(WORM, "WORM Storage", "Immutable destination for audit logs")
System_Ext(KMS, "KMS/HSM", "Hardware-backed protection for master keys")

System_Boundary(vault_boundary, "HashiCorp Vault") {
    Component(VaultCluster, "Vault Cluster", "Multi-node Raft-integrated cluster", "Primary storage and orchestration engine for secrets and replication.")
    Component(VaultAgent, "Vault Agent Sidecar", "Vault Agent", "Local cache and secret injector for microservices.")
    Component(VaultOperator, "Vault Secret Operator", "Kubernetes CRD", "Manages secret lifecycle and developer workflows within Kubernetes.")
    Component(TransitEngine, "Transit Secret Engine", "Vault Engine", "Centralized cryptographic offloading for PHI encryption.")
    Component(AuditDevice, "Vault Audit Device", "Audit Logger", "Generates immutable audit logs for compliance.")
}

Rel(VaultCluster, VaultCluster, "Performance Replication", "Raft protocol")
Rel(EMR, VaultAgent, "Accesses secrets", "Local shared memory volume")
Rel(AuditDevice, WORM, "Streams logs", "FluentBit sidecar")
Rel(Workloads, VaultCluster, "mTLS-encrypted communication", "SPIFFE IDs")
Rel(VaultCluster, KMS, "Seal Wrapping", "Master key protection")

@enduml