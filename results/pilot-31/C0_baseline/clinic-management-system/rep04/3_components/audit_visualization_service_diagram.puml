@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

System_Boundary(audit_service, "Audit Visualization Service") {
    Component(Audit_Event_Ingestor, "Audit Event Ingestor", "Spring Integration", "Handles real-time stream processing of audit events.")
    Component(Audit_Query_Engine, "Audit Query Engine", "Spring Data JPA", "Executes analytical queries against ClickHouse.")
    Component(Visualization_API_Controller, "Visualization API Controller", "Spring WebFlux", "Reactive gateway for audit visualization requests.")
    Component(Report_Generation_Engine, "Report Generation Engine", "Apache PDFBox/OpenPDF", "Asynchronous worker pool for generating compliance reports.")
    Component(Analytics_Aggregator, "Analytics Aggregator", "Spring Batch", "Performs heatmap pre-computation for analytical dashboards.")
}

Container_Ext(Debezium, "Debezium", "Kafka Connect", "Provides event streaming for audit normalization.")
Container_Ext(ClickHouse, "ClickHouse", "Columnar Database", "High-performance storage for time-series audit data.")
Container_Ext(HashiCorp_Vault, "HashiCorp Vault", "Secret Management", "Centralized secret management, encryption, and digital signature service.")
Container_Ext(Redis, "Redis", "In-memory Cache", "Caches pre-computed heatmap data for dashboard performance.")

Rel(Debezium, Audit_Event_Ingestor, "Streams normalized audit events", "Kafka")
Rel(Audit_Event_Ingestor, ClickHouse, "Persists time-series audit data", "JDBC/Native")
Rel(Visualization_API_Controller, HashiCorp_Vault, "Requests JIT access for field-level decryption via mTLS", "HTTPS")
Rel(Report_Generation_Engine, HashiCorp_Vault, "Applies digital signatures via Transit Engine", "HTTPS")
Rel(Analytics_Aggregator, Redis, "Stores pre-computed heatmap data", "Redis Protocol")
Rel(Audit_Query_Engine, ClickHouse, "Executes analytical queries", "JDBC")

@enduml