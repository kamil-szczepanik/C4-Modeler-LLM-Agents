@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

System_Boundary(ClickHouse, "ClickHouse") {
    Component(ClickHouseCluster, "ClickHouse Cluster", "ClickHouse MergeTree/ReplacingMergeTree", "High-performance analytical database engine for long-term trend analysis and operational reporting.")
    Component(ClickHouseKeeper, "ClickHouse Keeper", "ClickHouse Keeper", "Coordination service for cross-region consensus and cluster high availability.")
    Component(S3Storage, "S3-compatible Object Storage", "Object Storage", "Tiered storage layer for archival of historical analytical data.")
}

Rel(ClickHouseCluster, ClickHouseKeeper, "Uses for consensus and coordination", "Internal Protocol")
Rel(ClickHouseCluster, S3Storage, "Offloads archival data to", "S3 API")

@enduml