@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

System_Ext(IdP, "Identity Provider (IdP)", "External OIDC/JWT provider for authentication and ABAC claims.")
System_Ext(Gateway, "Spring Cloud Gateway", "Gateway with mTLS termination, handling REST and gRPC-Web traffic.")

Container_Boundary(AdminDashboard, "Administrative Dashboard") {
    Component(AuthGuard, "Auth Guard", "Angular Guard", "Handles route protection and session validation using OIDC/JWT.")
    Component(NgRx, "NgRx State Management", "NgRx/RxJS", "Manages global application state and synchronization via an event bus.")
    Component(ApiClient, "API Client Layer", "Axios/gRPC-Web", "Handles service communication, interceptors for audit logging, and real-time streaming.")
    Component(UIPolicyEngine, "UI Policy Engine", "Angular Service", "Enforces ABAC-based UI rendering rules and clinical/administrative workflow separation.")
    Component(ContextOrchestrator, "Context Orchestrator", "Angular Service", "Manages cross-module context and state synchronization for patient and clinical data.")
}

Rel(AuthGuard, IdP, "Validates OIDC/JWT and ABAC claims")
Rel(ApiClient, Gateway, "Communicates via REST and gRPC-Web")
Rel(NgRx, ContextOrchestrator, "Synchronizes application state via RxJS event bus")
Rel(UIPolicyEngine, AuthGuard, "Queries ABAC claims to restrict UI access")

@enduml