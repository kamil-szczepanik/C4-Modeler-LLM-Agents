@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

Person(ClinicalStaff, "Clinical Staff", "Doctors and nurses accessing patient records and clinical tools.")
Person(AdministrativeStaff, "Administrative Staff", "Staff managing scheduling and office operations.")
Person(Patients, "Patients", "Individuals accessing their personal health records and appointments.")
Person(HospitalManagement, "Hospital Management", "Management staff overseeing hospital operations and analytics.")

System(ClinicManagementSystem, "Clinic Management System", "A hybrid, high-availability platform for electronic medical records (EMR), billing, and scheduling, ensuring secure, compliant healthcare data access.")

System_Ext(IdentityProvider, "Identity Provider (IdP)", "Centralized authentication service for OIDC/SAML MFA.")
System_Ext(ExternalBillingGateway, "External Billing Gateway", "Third-party service for processing financial transactions.")
System_Ext(LabImagingSystems, "Lab/Imaging Systems", "Diagnostic systems providing medical data via HL7 FHIR.")
System_Ext(AnalyticsBISuite, "Analytics/BI Suite", "Platform for reporting and business intelligence using de-identified data.")

Rel(ClinicalStaff, ClinicManagementSystem, "Accesses EMR and clinical tools", "HTTPS/TLS 1.3")
Rel(AdministrativeStaff, ClinicManagementSystem, "Manages scheduling and billing tasks", "HTTPS/TLS 1.3")
Rel(Patients, ClinicManagementSystem, "Views medical records and appointments", "HTTPS/TLS 1.3")
Rel(HospitalManagement, ClinicManagementSystem, "Accesses management dashboards and reports", "HTTPS/TLS 1.3")

Rel(ClinicManagementSystem, IdentityProvider, "Validates user credentials and MFA", "OIDC/SAML")
Rel(ClinicManagementSystem, ExternalBillingGateway, "Processes payments and financial records", "REST/TLS 1.3")
Rel(ClinicManagementSystem, LabImagingSystems, "Retrieves diagnostic data", "HL7 FHIR")
Rel(ClinicManagementSystem, AnalyticsBISuite, "Exports de-identified data for reporting", "Read-only replication")

@enduml