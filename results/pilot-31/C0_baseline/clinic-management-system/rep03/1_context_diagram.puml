@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title System Context diagram for Clinic Management System

Person(ClinicalStaff, "Clinical Staff", "Healthcare professionals managing patient records and clinical workflows.")
Person(Patients, "Patients", "Individuals accessing their health records and portal services.")
Person(HospitalAdministrators, "Hospital Administrators", "Administrative staff overseeing operations and analytics.")

System_Ext(IdP, "Identity Provider (IdP)", "Centralized authentication and authorization service.")
System_Ext(PaymentGateway, "Secure Payment Gateway", "Third-party service for processing billing and payments.")
System_Ext(DiagnosticSystems, "External Diagnostic Systems", "Lab and imaging systems providing clinical data via HL7 FHIR.")

System_Boundary(CMS, "Clinic Management System") {
    System(EMRCore, "EMR Core", "On-premise core system for clinical data management.")
    System(PatientPortal, "Patient Portal", "Interface for patient engagement.")
    System(AdminDashboard, "Admin Analytics Dashboard", "Interface for administrative reporting and analytics.")
    System(APIGateway, "API Gateway", "Centralized ingress management for all actors.")
    System(DataSync, "Data Synchronization Service", "Service for hybrid-cloud data replication.")
    System(DataWarehouse, "Asynchronous Data Warehouse", "Data store for reporting and analytics.")
    System(Security, "Security Components", "WAF, KMS/HSM, and Immutable Storage for compliance.")
}

Rel(ClinicalStaff, APIGateway, "Accesses clinical workflows and records", "mTLS")
Rel(Patients, APIGateway, "Accesses health records and portal", "mTLS")
Rel(HospitalAdministrators, APIGateway, "Accesses administrative reports", "mTLS")

Rel(APIGateway, IdP, "Validates user identities", "OAuth/OIDC")
Rel(APIGateway, PaymentGateway, "Processes billing transactions", "HTTPS")

Rel(EMRCore, DiagnosticSystems, "Exchanges clinical data", "HL7 FHIR")
Rel(EMRCore, DataSync, "Synchronizes data between on-prem and cloud", "mTLS")
Rel(DataSync, DataWarehouse, "Populates reporting data", "ETL")

@enduml