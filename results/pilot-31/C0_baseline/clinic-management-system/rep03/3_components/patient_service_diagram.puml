@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

System_Boundary(patient_service, "Patient Service") {
    Component(registration_controller, "Registration Controller", "Spring WebFlux", "Handles high-concurrency patient intake requests and routing.")
    Component(demographics_manager, "Demographics Manager", "Java", "Manages patient demographic business logic and data integrity.")
    Component(identity_validator, "Identity Validator", "Java", "Validates patient and staff identities against internal security protocols.")
    Component(audit_logger, "Audit Logger", "Java", "Publishes immutable audit events to NATS JetStream.")
    Component(patient_profile_projection, "Patient Profile Projection", "Java", "Maintains read-optimized views of patient data for CQRS patterns.")
}

System_Ext(nats_jetstream, "NATS JetStream", "Messaging System", "Durable, asynchronous messaging for audit trails.")
System_Ext(postgresql, "PostgreSQL", "Database", "Primary storage with TDE and HSM-backed CMK for HIPAA/GDPR compliance.")
System_Ext(opa_sidecar, "OPA Sidecar", "Policy Engine", "Enforces ABAC-based authorization for all requests.")

Rel(registration_controller, demographics_manager, "Delegates intake processing", "Internal Call")
Rel(demographics_manager, identity_validator, "Verifies user authorization", "Internal Call")
Rel(demographics_manager, audit_logger, "Logs demographic changes", "Internal Call")
Rel(audit_logger, nats_jetstream, "Publishes audit events", "NATS protocol")
Rel(demographics_manager, postgresql, "Persists patient data", "JDBC/TLS")
Rel(registration_controller, opa_sidecar, "Requests ABAC policy enforcement", "REST/gRPC")

@enduml