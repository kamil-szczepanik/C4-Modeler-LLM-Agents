@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

System_Ext(External_Diagnostic_Systems, "External Diagnostic Systems", "External clinical systems exchanging data via HL7 FHIR R4.")

Container_Boundary(FHIR_Integration_Gateway, "FHIR Integration Gateway") {
    Component(Transformation_Engine, "Transformation Engine", "JOLT/Liquid", "Rule-based engine for mapping internal models to HL7 FHIR R4.")
    Component(Metadata_Registry, "Metadata Registry", "Centralized Store", "Centralized store for versioned, cryptographically signed FHIR profiles and templates.")
    Component(Audit_Reconciliation_Service, "Audit & Reconciliation Service", "Custom Service", "Monitors clinical data integrity and manages soft failure exceptions.")
    Component(Partner_Configuration_Portal, "Partner Configuration Portal", "Web UI", "UI for non-technical staff to manage diagnostic partner connections.")
    Component(Queue_Manager, "Queue Manager", "NATS JetStream", "High-throughput messaging for asynchronous data flow.")
    Component(Sidecar_Proxy, "Sidecar Proxy", "Envoy/Custom Proxy", "Handles mTLS termination and circuit breaking for network resilience.")
}

Rel(External_Diagnostic_Systems, Sidecar_Proxy, "Bi-directional exchange via HL7 FHIR R4 over mTLS", "HTTPS/TLS")
Rel(Sidecar_Proxy, Transformation_Engine, "Forwards validated requests", "Internal")
Rel(Transformation_Engine, Metadata_Registry, "Runtime retrieval of signed transformation templates", "API")
Rel(Transformation_Engine, Audit_Reconciliation_Service, "Event-based ingestion of payloads for clinical integrity monitoring", "Async")
Rel(Partner_Configuration_Portal, Metadata_Registry, "Management of partner-specific onboarding configurations", "HTTPS")
Rel(Transformation_Engine, Queue_Manager, "Asynchronous message queuing", "NATS")

@enduml