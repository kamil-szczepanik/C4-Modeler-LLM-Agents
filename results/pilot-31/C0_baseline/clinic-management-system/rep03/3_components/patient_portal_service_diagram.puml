@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container_Boundary(patient_portal_service, "Patient Portal Service") {
    Component(ui_orchestrator, "UI Orchestrator", "Next.js (SSR)", "Provides an accessible, responsive web interface for patient engagement and care plan management.")
    Component(patient_context_provider_bff, "Patient Context Provider (BFF)", "Node.js", "Aggregates EMR and Billing data to provide a unified patient context.")
    Component(consent_manager, "Consent Manager", "Go", "Enforces ABAC policies for family access and granular data permissions.")
    Component(security_proxy_layer, "Security Proxy Layer", "Middleware", "Enforces OIDC, MFA, and Content Security Policies.")
}

Container(api_gateway, "API Gateway", "Kong via Istio", "Manages traffic routing, mTLS termination, and security for the Clinic Management System.")
Container(redis, "Redis", "Redis", "Distributed cache for session data and UI state.")

Rel(ui_orchestrator, patient_context_provider_bff, "Communicates via gRPC", "gRPC")
Rel(patient_context_provider_bff, consent_manager, "Validates access rights via gRPC with mandatory ACL validation", "gRPC")
Rel(ui_orchestrator, security_proxy_layer, "Enforces authentication and security policies", "HTTPS")
Rel(patient_portal_service, api_gateway, "Routes PHI requests via mTLS-encrypted communication", "mTLS/HTTPS")
Rel(ui_orchestrator, redis, "Stores and retrieves session data and UI state", "Redis Protocol")

@enduml