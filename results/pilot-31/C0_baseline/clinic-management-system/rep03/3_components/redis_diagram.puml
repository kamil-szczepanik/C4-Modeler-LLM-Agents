@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

System_Ext(RedisCluster, "Redis Cluster", "High-availability distributed cache for EMR session states")

Container_Boundary(Redis, "Redis") {
    Component(RedisSentinel, "Redis Sentinel", "Redis Sentinel", "Manages high-availability, automated failover, and cross-site synchronization for the Redis cluster.")
    Component(VolatileLRU, "Volatile-LRU/TTL Policy Engine", "Redis Configuration", "Enforces eviction policies to ensure Redis remains a transient cache and prevents persistent storage of PII.")
    Component(PrometheusExporter, "Prometheus Exporter", "Prometheus", "Monitors cache health and performance metrics for the SIEM integration.")
}

Rel(RedisSentinel, RedisCluster, "Orchestrates failover and synchronization", "Redis Protocol")
Rel(PrometheusExporter, RedisSentinel, "Collects health metrics", "API")

@enduml