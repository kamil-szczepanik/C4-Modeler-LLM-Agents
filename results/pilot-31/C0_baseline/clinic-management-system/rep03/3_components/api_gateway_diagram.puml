@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Person(Clinical_Staff_Patients, "Clinical Staff/Patients", "Users accessing EMR, billing, and scheduling services")
System_Ext(External_Diagnostic_Systems, "External Diagnostic Systems", "External systems requiring secure data exchange")
System_Ext(HAPI_FHIR_Backend, "HAPI FHIR Backend", "Manages clinical data interoperability and resource routing")

System_Boundary(API_Gateway, "API Gateway") {
    Component(Kong_Ingress_Controller, "Kong Ingress Controller", "Kong", "Centralized ingress managing routing, security, and protocol translation.")
    Component(Context_Aware_Policy_Engine, "Context-Aware Policy Engine", "Custom Policy Service", "Component for ABAC and break-glass emergency access.")
    Component(Developer_Portal_Integration, "Developer Portal Integration", "Kong Dev Portal", "Manages partner API keys, quotas, and self-service onboarding.")
    Component(Request_Response_Transformer, "Request/Response Transformer", "Kong Plugin", "Handles PII masking and schema validation.")
    Component(Redis, "Redis", "Redis", "Backs rate-limiting and authorization attribute caching.")
    Component(OpenTelemetry, "OpenTelemetry", "OpenTelemetry", "Distributed tracing for latency isolation and observability.")
}

Rel(Clinical_Staff_Patients, Kong_Ingress_Controller, "Secure access via mTLS and OIDC/JWT", "HTTPS")
Rel(External_Diagnostic_Systems, Kong_Ingress_Controller, "Secure tunnel via Certificate Pinning and mTLS", "HTTPS")
Rel(Kong_Ingress_Controller, Request_Response_Transformer, "Validates schema and masks PII", "Internal")
Rel(Kong_Ingress_Controller, Context_Aware_Policy_Engine, "Enforces ABAC and emergency access", "Internal")
Rel(Kong_Ingress_Controller, Redis, "Checks rate-limits and auth attributes", "TCP")
Rel(Kong_Ingress_Controller, HAPI_FHIR_Backend, "Protocol translation and resource routing", "HTTPS")
Rel(Kong_Ingress_Controller, OpenTelemetry, "Exports telemetry data", "gRPC")

@enduml