@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

System_Ext(NATS, "NATS JetStream", "Event Bus", "Message persistence and decoupling across hybrid cloud boundaries.")
System_Ext(Postgres, "PostgreSQL", "Database", "Transactional data operations with automated failover.")
System_Ext(PatientPortal, "Patient Portal", "External System", "Secure, protocol-translated access via HL7 FHIR.")

Container_Boundary(EMR_Service, "EMR Service") {
    Component(RecordProcessor, "Record Processor", "Node.js/Fastify", "Handles primary clinical record processing and transactional logic.")
    Component(AuditManager, "Audit Manager", "Node.js/Fastify", "Manages immutable audit logs for compliance reporting.")
    Component(FHIRFacade, "FHIR Facade", "HAPI FHIR", "Provides protocol-translated access to clinical data via HL7 FHIR.")
    Component(ComplianceReporter, "Compliance Reporter", "Node.js/Fastify", "Generates reports to ensure HIPAA/GDPR compliance.")
}

Rel(RecordProcessor, NATS, "Asynchronous event streaming", "NATS Protocol")
Rel(FHIRFacade, PatientPortal, "Secure, protocol-translated access", "HL7 FHIR REST/HTTPS")
Rel(RecordProcessor, Postgres, "Executes transactional data operations", "PostgreSQL Protocol")
Rel(EMR_Service, NATS, "mTLS-encrypted communication", "gRPC/REST")

@enduml