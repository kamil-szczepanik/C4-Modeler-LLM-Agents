@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container_Boundary(nats_jetstream, "NATS JetStream") {
    Component(RAFT_Consensus_Engine, "RAFT Consensus Engine", "NATS JetStream RAFT", "Ensures distributed consistency and 99.99% availability across 3-5 nodes.")
    Component(Leaf_Node_Bridge, "Leaf Node Bridge", "NATS Leaf Nodes", "Bridges on-prem and cloud sites to mitigate WAN latency.")
    Component(Account_JWT_Auth_Service, "Account/JWT Auth Service", "NATS Auth/JWT", "Enforces granular, cryptographically verifiable multi-tenancy.")
    Component(Envelope_Encryption_Manager, "Envelope Encryption Manager", "KMS/HSM Integration", "Handles AES-256 field-level protection for PHI.")
    Component(Archival_Sidecar, "Archival Sidecar", "Sidecar Pattern", "Asynchronously moves data to S3/GCS cold storage with Object Lock.")
}

Rel(Leaf_Node_Bridge, RAFT_Consensus_Engine, "Synchronizes cross-site data streams", "NATS Protocol")
Rel(RAFT_Consensus_Engine, Envelope_Encryption_Manager, "Encrypts messages before persistence", "mTLS/Internal API")
Rel(RAFT_Consensus_Engine, Archival_Sidecar, "Streams persistent data for archival", "gRPC/Internal")
Rel(Account_JWT_Auth_Service, RAFT_Consensus_Engine, "Validates client access to event streams", "JWT/Auth")

@enduml