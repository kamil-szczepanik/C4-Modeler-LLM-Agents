@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Clinical_Staff, "Clinical Staff", "Healthcare professionals managing patient records and clinical workflows.")
Person(Patients, "Patients", "Individuals accessing their health records and portal services.")
Person(Hospital_Administrators, "Hospital Administrators", "Administrative staff overseeing operations and analytics.")
System_Ext(External_Diagnostic_Systems, "External Diagnostic Systems", "Lab and imaging systems providing clinical data via HL7 FHIR.")

System_Boundary(clinic_system, "Clinic Management System") {
    Container(API_Gateway, "API Gateway", "Kong", "Centralized ingress management for OAuth2/OIDC and mTLS.")
    Container(Patient_Service, "Patient Service", "Java, Spring Boot", "Manages core patient information and EMR data.")
    Container(EMR_Service, "EMR Service", "Node.js, Fastify", "Handles electronic medical record processing and session states.")
    Container(Billing_Service, "Billing Service", "Go", "Processes clinical billing and financial transactions.")
    Container(Patient_Portal_Service, "Patient Portal Service", "Next.js", "Provides a web interface for patient engagement.")
    Container(FHIR_Integration_Gateway, "FHIR Integration Gateway", "HAPI FHIR", "Maps internal models to HL7 FHIR R4 for external systems.")
    Container(NATS_JetStream, "NATS JetStream", "NATS", "Event bus for asynchronous audit logging and data ingestion.")
    ContainerDb(PostgreSQL, "PostgreSQL", "PostgreSQL", "Relational database for billing and clinical records.")
    ContainerDb(Redis, "Redis", "Redis", "Caching layer for EMR session states.")
    
    Component(Istio_Service_Mesh, "Istio Service Mesh", "Istio", "Enforces mTLS, circuit breaking, and traffic management.")
    Component(ArgoCD, "ArgoCD", "GitOps", "Orchestrates hybrid-cloud deployments.")
    Component(Falco, "Falco", "Security Scanning", "Runtime security scanning for anomalous process detection.")
}

Rel(Clinical_Staff, API_Gateway, "Accesses clinical workflows", "mTLS")
Rel(Patients, API_Gateway, "Accesses patient portal", "mTLS")
Rel(API_Gateway, Patient_Service, "Routes requests", "Istio")
Rel(API_Gateway, Patient_Portal_Service, "Routes requests", "Istio")
Rel(Patient_Service, EMR_Service, "Retrieves medical records", "gRPC/REST")
Rel(EMR_Service, Redis, "Caches session states", "Redis Protocol")
Rel(Billing_Service, PostgreSQL, "Persists billing data", "SQL")
Rel(FHIR_Integration_Gateway, External_Diagnostic_Systems, "Exchanges clinical data", "HL7 FHIR R4, mTLS")
Rel(Patient_Service, NATS_JetStream, "Publishes audit logs", "NATS")

@enduml