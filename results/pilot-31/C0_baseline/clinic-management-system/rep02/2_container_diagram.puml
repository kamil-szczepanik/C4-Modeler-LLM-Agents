@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(Clinical_Staff, "Clinical Staff", "Medical professionals managing patient care and clinical workflows.")
Person(Patients, "Patients", "Individuals accessing their health records and portal services.")
Person(Auditors, "Auditors", "Personnel responsible for ensuring system compliance and audit trail integrity.")

System_Boundary(Clinic_Management_System, "Clinic Management System") {
    Container(Clinical_API_Gateway, "Clinical API Gateway", "Go", "Entry point for clinical staff and internal services.")
    Container(Patient_Facing_API_Gateway, "Patient-Facing API Gateway", "Node.js/TypeScript", "Entry point for patient portal traffic.")
    Container(EMR_Scheduling_Services, "EMR/Scheduling Services", "Java/Spring Boot", "Core logic for electronic medical records and appointment scheduling.")
    Container(Reporting_Compliance_Service, "Reporting & Compliance Service", "Java/Spring Boot", "Handles data analytics and compliance reporting with dynamic masking.")
    Container(Audit_Logging_Sidecar, "Audit Logging Sidecar", "Sidecar Pattern", "Captures and streams audit trails to secure storage.")
    Container(Message_Broker, "Message Broker", "NATS/Kafka", "Facilitates asynchronous event-driven communication between services.")
    ContainerDb(PostgreSQL_Cluster, "PostgreSQL Cluster", "PostgreSQL/Patroni", "Primary ACID-compliant data store for clinical and billing data.")
    Container(Redis_Cache, "Redis Cache", "Redis", "In-memory store for sub-second EMR retrieval.")
    Container(WORM_Storage, "WORM Storage", "Write-Once-Read-Many", "Immutable storage for audit logs and compliance records.")
}

Rel(Clinical_Staff, Clinical_API_Gateway, "Accesses clinical workflows", "HTTPS/mTLS")
Rel(Patients, Patient_Facing_API_Gateway, "Accesses health records", "HTTPS/mTLS")
Rel(Clinical_API_Gateway, EMR_Scheduling_Services, "Routes clinical requests", "Istio Service Mesh")
Rel(EMR_Scheduling_Services, PostgreSQL_Cluster, "Persists patient data", "SQL")
Rel(EMR_Scheduling_Services, Redis_Cache, "Retrieves EMR data", "TCP")
Rel(EMR_Scheduling_Services, Message_Broker, "Publishes events", "Asynchronous Messaging")
Rel(Reporting_Compliance_Service, PostgreSQL_Cluster, "Reads from replicas", "SQL")
Rel(Audit_Logging_Sidecar, WORM_Storage, "Streams audit logs", "Encrypted Stream")
Rel(Auditors, Reporting_Compliance_Service, "Accesses compliance reports", "HTTPS")

@enduml