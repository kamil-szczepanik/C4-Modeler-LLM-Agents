@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Person(Auditors_Managers, "Auditors/Managers", "External users requesting dashboard and report data.")

System_Boundary(Reporting_Compliance_Service, "Reporting & Compliance Service") {
    Component(Query_Orchestrator, "Query Orchestrator", "Java/Spring Boot", "Manages read-only data retrieval from PostgreSQL replicas.")
    Component(Data_Masking_Engine, "Data Masking Engine", "ABAC/Java", "Applies dynamic ABAC-based PII/PHI obfuscation.")
    Component(Report_Generator, "Report Generator", "Java/Spring Boot", "Creates digitally signed, immutable compliance documents.")
    Component(Query_Builder_DSL_Engine, "Query Builder/DSL Engine", "Java/Spring Boot", "Facilitates self-service KPI generation with whitelist validation.")
    Component(Anomaly_Detection_Service, "Anomaly Detection Service", "Java/Spring Boot", "Monitors audit logs for regulatory gaps and security threats.")
    Component(Query_Governor, "Query Governor", "Java/Spring Boot", "Enforces resource quotas, timeouts, and rate-limiting.")
}

ContainerDb(PostgreSQL_Cluster, "PostgreSQL Cluster", "PostgreSQL (Patroni-managed)", "Read-heavy data storage for clinical operations.")
Container(WORM_Storage, "WORM Storage", "S3-compatible Object Storage", "Provides immutable, long-term document retention.")
Container(Message_Broker, "Message Broker", "NATS/Kafka", "Asynchronous log stream for anomaly detection.")
Container(KMS_HSM, "KMS/HSM", "Hardware Security Module", "Provides digital signature generation for non-repudiation.")

Rel(Auditors_Managers, Query_Builder_DSL_Engine, "Requests dashboard and reports", "HTTPS")
Rel(Query_Orchestrator, PostgreSQL_Cluster, "Executes read-only SQL queries", "mTLS")
Rel(Report_Generator, WORM_Storage, "Stores immutable documents", "S3-compatible API")
Rel(Anomaly_Detection_Service, Message_Broker, "Consumes asynchronous audit log streams", "NATS/Kafka")
Rel(Reporting_Compliance_Service, KMS_HSM, "Requests digital signatures for non-repudiation", "API")

@enduml