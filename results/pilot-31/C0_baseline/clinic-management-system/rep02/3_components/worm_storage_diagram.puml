@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

System_Ext(S3_Object_Lock_API, "S3 Object Lock API", "AWS S3", "External storage interface for immutable object locking.")
System_Ext(Audit_Logging_Sidecar, "Audit Logging Sidecar", "Sidecar Pattern", "Streams mTLS-encrypted logs via cryptographic manifests.")

Container_Boundary(WORM_Storage, "WORM Storage") {
    Component(Ingestion_Gateway, "Ingestion Gateway", "Go/Custom", "Handles incoming data streams and initial validation for WORM storage.")
    Component(Verification_Engine, "Verification Engine", "Go/Custom", "Performs cryptographic verification and ensures data integrity of records.")
    Component(Retention_Manager, "Retention Manager", "Go/AWS SDK", "Orchestrates lifecycle policies, Legal Hold states, and S3 Object Lock API interactions.")
    Component(Digital_Signature_Service, "Digital Signature Service", "HSM/PKI", "Generates cryptographic manifests and performs background drift detection.")
}

Rel(Audit_Logging_Sidecar, Ingestion_Gateway, "Streams mTLS-encrypted logs", "mTLS")
Rel(Ingestion_Gateway, Verification_Engine, "Sends data for asynchronous processing", "Local disk-backed queue")
Rel(Verification_Engine, Digital_Signature_Service, "Requests cryptographic manifest generation", "API")
Rel(Retention_Manager, S3_Object_Lock_API, "Orchestrates lifecycle policies and Legal Hold states", "HTTPS/AWS SDK")

@enduml