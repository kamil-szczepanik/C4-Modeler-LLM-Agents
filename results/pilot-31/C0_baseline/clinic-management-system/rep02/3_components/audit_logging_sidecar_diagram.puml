@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

System_Ext(WORM, "WORM Storage", "Immutable destination for audit trails")
System_Ext(Prometheus, "Prometheus", "Observability platform for metrics")
System_Ext(SIEM, "SIEM", "Security Information and Event Management for emergency alerts")

Container_Boundary(Sidecar, "Audit Logging Sidecar") {
    Component(LocalRuleEngine, "Local Rule Engine", "Rust", "Policy Enforcement Point (PEP) for operation classification and security policy evaluation.")
    Component(RocksDB, "RocksDB", "RocksDB", "Local buffer providing transient network partition resilience for audit logs.")
    Component(FluentBitForwarder, "Fluent Bit Forwarder", "Fluent Bit", "Handles structured log transformation, PII masking, and log streaming.")
    Component(CryptographicSigner, "Cryptographic Signer", "HSM/Nitro Enclave (Ed25519)", "Provides cryptographic signing for non-repudiation of audit records.")
}

Rel(LocalRuleEngine, RocksDB, "Buffers intercepted requests during network partitions", "Internal")
Rel(LocalRuleEngine, CryptographicSigner, "Requests digital signatures for audit trails", "Internal")
Rel(RocksDB, FluentBitForwarder, "Streams buffered logs for transformation and transmission", "Internal")
Rel(FluentBitForwarder, WORM, "Streams signed audit logs", "TLS 1.3/mTLS")
Rel(FluentBitForwarder, Prometheus, "Exports metrics", "HTTP")
Rel(FluentBitForwarder, SIEM, "Sends real-time alerts for emergency overrides", "HTTPS")

@enduml