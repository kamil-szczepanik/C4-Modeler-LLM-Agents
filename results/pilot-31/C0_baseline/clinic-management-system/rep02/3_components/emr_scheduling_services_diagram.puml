@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

System_Boundary(emr_scheduling, "EMR/Scheduling Services") {
    Component(patient_record_manager, "Patient Record Manager", "Java/Spring Boot", "Manages the lifecycle and retrieval of Electronic Medical Records.")
    Component(scheduling_engine, "Scheduling Engine", "Temporal.io", "Orchestrates complex, fault-tolerant clinical scheduling workflows.")
    Component(resource_orchestrator, "Resource Orchestrator", "Java/Spring Boot", "Coordinates clinical resource allocation and availability.")
    Component(fhir_facade, "FHIR Facade", "Java/Spring Boot", "Provides interoperability via HL7 FHIR standards.")
    Component(audit_logging_sidecar, "Audit Logging Sidecar", "Sidecar Pattern", "Captures and streams tamper-proof logs to WORM storage.")
}

ContainerDb(postgresql, "PostgreSQL Cluster", "PostgreSQL/Patroni", "High-availability relational storage with cross-region replication.")
Container(redis, "Redis Cache", "Redis", "Read-through cache for P95 latency.")
Container(message_broker, "Message Broker", "NATS/Kafka", "Asynchronous event-driven communication.")
Container(worm_storage, "WORM Storage", "Storage", "Tamper-proof storage for regulatory compliance.")

Rel(patient_record_manager, postgresql, "Persists patient data using optimistic locking", "JDBC/TLS")
Rel(patient_record_manager, redis, "Reads P95 latency-sensitive data from cache", "Redis Protocol")
Rel(scheduling_engine, message_broker, "Publishes asynchronous events for scheduling updates", "AMQP/NATS")
Rel(fhir_facade, patient_record_manager, "Queries patient records for FHIR-compliant responses", "Internal API")
Rel(audit_logging_sidecar, worm_storage, "Streams tamper-proof logs for regulatory compliance", "gRPC/HTTPS")

@enduml