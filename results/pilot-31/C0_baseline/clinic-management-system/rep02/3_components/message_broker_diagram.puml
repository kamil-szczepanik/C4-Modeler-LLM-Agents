@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Person_Ext(clinical_services, "Clinical Services", "External services publishing events via mTLS-secured asynchronous messaging.")
System_Ext(worm_storage, "WORM Storage", "Immutable storage for compliance-driven audit logs.")
System_Ext(dlq, "DLQ", "Dead Letter Queue for failed event processing.")

Container_Boundary(message_broker, "Message Broker") {
    Component(kafka_broker_cluster, "Kafka Broker Cluster", "Apache Kafka", "Federated event streaming cluster with replication factor 3 and acks=all for high durability.")
    Component(schema_registry, "Schema Registry", "Confluent Schema Registry", "Enforces HL7 FHIR-compliant message structures for all incoming event payloads.")
    Component(reconciliation_controller, "Reconciliation Controller", "Custom Go Service", "Monitors DLQ and performs state correlation to ensure data integrity.")
    Component(security_controller, "Security Controller", "mTLS / ABAC", "Manages encryption-in-transit and granular topic-level access control.")
}

Rel(clinical_services, kafka_broker_cluster, "Publishes events", "mTLS-secured asynchronous messaging")
Rel(kafka_broker_cluster, worm_storage, "Streams logs", "Administrative and audit logs for compliance")
Rel(reconciliation_controller, dlq, "Monitors failed events", "Triggers notifications for clinical administrators")
Rel(clinical_services, schema_registry, "Validates payloads", "FHIR standards validation")

@enduml