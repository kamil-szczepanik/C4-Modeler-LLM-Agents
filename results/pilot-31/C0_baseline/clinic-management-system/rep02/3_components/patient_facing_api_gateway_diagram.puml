@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

System_Boundary(c1, "Patient-Facing API Gateway") {
    Component(Authentication_Interceptor, "Authentication Interceptor", "Passport.js", "Handles identity validation and token binding using OIDC/DPoP.")
    Component(Request_Orchestrator, "Request Orchestrator", "Fastify", "Manages incoming requests and coordinates communication between backend services.")
    Component(ReBAC_Resolver, "ReBAC Resolver", "Custom Logic", "Resolves Relationship-Based Access Control for secure patient data access.")
    Component(Circuit_Breaker_Fallback_Handler, "Circuit-Breaker Fallback Handler", "Opossum", "Provides fault tolerance and fallback logic for downstream service outages.")
    Component(Audit_Logging_Sidecar, "Audit Logging Sidecar", "OpenTelemetry", "Handles non-blocking audit logging for compliance and observability.")
}

Rel(Authentication_Interceptor, Request_Orchestrator, "Validates identity before allowing request processing", "OIDC/DPoP")
Rel(Request_Orchestrator, ReBAC_Resolver, "Queries for access permissions on resources", "Internal API")
Rel(Request_Orchestrator, Circuit_Breaker_Fallback_Handler, "Wraps downstream gRPC/REST calls for resilience", "Opossum")
Rel(Request_Orchestrator, Audit_Logging_Sidecar, "Sends event data for secure audit trails", "OpenTelemetry")

@enduml