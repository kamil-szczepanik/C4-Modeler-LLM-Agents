@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

Person(ClinicalStaff, "Clinical Staff", "Medical professionals managing patient care and clinical workflows.")
Person(Patients, "Patients", "Individuals accessing their health records and portal services.")
Person(Auditors, "Auditors/Compliance Officers", "Personnel responsible for ensuring system compliance and audit trail integrity.")

System(CMS, "Clinic Management System", "A hybrid, high-availability platform designed to manage clinical workflows, patient records, and billing with HIPAA/GDPR compliance.")

System_Ext(IdP, "Identity Provider (IdP)", "External system providing OIDC/SAML authentication, MFA, and RBAC.")
System_Ext(Clearinghouse, "Clearinghouse Gateway", "External system for processing financial transactions.")
System_Ext(FHIR, "HL7 FHIR Integration Engine", "External system for standardized clinical data exchange.")

Rel(ClinicalStaff, CMS, "Accesses clinical workflows and patient records via API Gateway", "HTTPS/TLS 1.3")
Rel(Patients, CMS, "Accesses portal and records via API Gateway", "HTTPS/TLS 1.3")
Rel(Auditors, CMS, "Accesses audit logs and compliance reports", "HTTPS/TLS 1.3")
Rel(CMS, IdP, "Authenticates users and authorizes access", "OIDC/SAML")
Rel(CMS, Clearinghouse, "Processes financial transactions", "REST/SOAP")
Rel(CMS, FHIR, "Exchanges clinical data", "HL7 FHIR")

@enduml