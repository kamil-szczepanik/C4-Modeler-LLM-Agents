@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

Person(ClinicalStaff, "Clinical Staff", "Medical professionals managing patient workflows.")
Person(Patients, "Patients", "Individuals accessing health records and billing.")
Person(ComplianceOfficers, "Compliance Officers", "Staff responsible for auditing and regulatory oversight.")

System_Ext(LabImagingSystems, "Lab/Imaging Systems", "External diagnostic systems providing medical data.")

System_Boundary(CMS, "Clinic Management System") {
    Container(ClinicalAPIGateway, "Clinical API Gateway", "Go", "Entry point for all clinical traffic, enforcing mTLS and routing.")
    Container(EMRService, "EMR Service", "Java/Spring Boot", "Manages patient electronic medical records and clinical data.")
    Container(BillingService, "Billing Service", "Python/FastAPI", "Handles financial transactions and billing workflows.")
    Container(PatientPortal, "Patient Portal", "Node.js/React", "Interface for patients to view records and billing.")
    Container(AuditLogService, "Audit Log Service", "Go/S3 Glacier", "Immutable service for tracking system events and compliance logs.")
    Container(ReportingAnalyticsService, "Reporting & Analytics Service", "Python", "Aggregates data for clinical and operational insights.")
    Container(FHIRIntegrationService, "FHIR Integration Service", "Java/FHIR", "Facilitates interoperability with external lab and imaging systems.")
    
    Container(ServiceMesh, "Service Mesh", "Istio/Linkerd", "Manages traffic, circuit breaking, and service-to-service mTLS.")
    Container(IdentityProvider, "Identity Provider", "OIDC/MFA", "Centralized authentication and authorization service.")
}

Rel(ClinicalStaff, ClinicalAPIGateway, "Accesses clinical workflows", "HTTPS/mTLS")
Rel(Patients, PatientPortal, "Accesses personal health records", "HTTPS")
Rel(ClinicalAPIGateway, EMRService, "Routes clinical requests", "gRPC")
Rel(ClinicalAPIGateway, BillingService, "Routes billing requests", "gRPC")
Rel(EMRService, FHIRIntegrationService, "Exchanges data with external systems", "FHIR RESTful APIs")
Rel(FHIRIntegrationService, LabImagingSystems, "Interoperability interface", "RESTful APIs")
Rel(EMRService, AuditLogService, "Ships audit events asynchronously", "Sidecar Pattern")
Rel(ComplianceOfficers, AuditLogService, "Reviews immutable logs", "HTTPS")

@enduml