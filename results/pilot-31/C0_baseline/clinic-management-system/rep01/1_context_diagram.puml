@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

Person(Clinical_Staff, "Clinical Staff", "Medical professionals accessing patient records and imaging archives.")
Person(Patients, "Patients", "Individuals accessing their personal health records and billing information.")

System_Boundary(c1, "Clinic Management System") {
    System(Clinic_Management_System, "Clinic Management System", "A hybrid-cloud platform for patient records, billing, and clinical scheduling, ensuring 99.99% availability and HIPAA/GDPR compliance.")
}

System_Ext(Lab_and_Imaging_Services, "Lab and Imaging Services", "External providers exchanging standardized health data.")
System_Ext(Clearinghouse_Gateway, "Clearinghouse Gateway", "External financial entity for processing billing transactions.")

Rel(Clinical_Staff, Clinic_Management_System, "Accesses patient records and clinical scheduling", "HTTPS")
Rel(Patients, Clinic_Management_System, "Accesses portal for records and billing", "HTTPS")
Rel(Clinic_Management_System, Lab_and_Imaging_Services, "Exchanges standardized lab and imaging data", "FHIR APIs")
Rel(Clinic_Management_System, Clearinghouse_Gateway, "Processes billing transactions", "HTTPS/TLS 1.3")

@enduml