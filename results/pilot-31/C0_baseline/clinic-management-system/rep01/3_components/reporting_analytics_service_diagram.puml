@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container_Boundary(reporting_analytics_service, "Reporting & Analytics Service") {
    Component(Data_Ingestion_Processor, "Data Ingestion Processor", "Python, Celery", "ETL service responsible for processing and ingesting data.")
    Component(Analytics_Engine, "Analytics Engine", "Pandas, NumPy", "Processing engine for clinical and operational insights.")
    Component(Semantic_Layer, "Semantic Layer", "dbt", "Abstraction layer for defining business metrics-as-code.")
    Component(Query_Orchestrator, "Query Orchestrator", "Custom Routing Logic", "Dynamic routing between real-time PostgreSQL data and historical S3 data.")
    Component(Visualization_API, "Visualization API", "FastAPI", "Interface for serving dashboard data.")
    Component(Storage_Layer, "Storage Layer", "PostgreSQL, S3 (Parquet)", "Hybrid storage for analytical reads and immutable data lake storage.")
}

Rel(Data_Ingestion_Processor, Storage_Layer, "Writes processed data to PostgreSQL and S3", "CDC/ETL")
Rel(Query_Orchestrator, Storage_Layer, "Reads data based on age and type", "SQL/S3 API")
Rel(Visualization_API, Query_Orchestrator, "Requests data for dashboards", "REST/gRPC")
Rel(Analytics_Engine, Semantic_Layer, "Applies business metrics definitions", "Internal Call")
Rel(Analytics_Engine, Storage_Layer, "Processes raw data from storage", "Read")

@enduml