@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

System_Ext(EMR_Service, "EMR Service", "Java/Spring Boot", "Core electronic medical record service")
System_Ext(Billing_Service, "Billing Service", "Python/FastAPI", "Financial and billing operations service")

Container_Boundary(Patient_Portal, "Patient Portal") {
    Component(Patient_Dashboard_Controller, "Patient Dashboard Controller", "Express.js/GraphQL Federation", "Aggregates backend data from EMR and Billing services for the frontend.")
    Component(Relationship_Management_Component, "Relationship Management Component", "Node.js", "Manages delegated access permissions for caregivers and patients.")
    Component(Real_time_Messaging_Gateway, "Real-time Messaging Gateway", "Socket.io", "Enables secure, low-latency clinical communication between patients and caregivers.")
    Component(Identity_Provider_Interface, "Identity Provider Interface", "Auth0/OIDC", "Handles authentication, MFA, and token introspection.")
}

Rel(Patient_Dashboard_Controller, EMR_Service, "Executes GraphQL queries with field-level authorization via Istio mTLS", "GraphQL/mTLS")
Rel(Patient_Dashboard_Controller, Billing_Service, "Executes GraphQL queries via Istio mTLS", "GraphQL/mTLS")
Rel(Patient_Dashboard_Controller, Identity_Provider_Interface, "Validates tokens via OIDC introspection", "OIDC")
Rel(Relationship_Management_Component, Patient_Dashboard_Controller, "Provides authorization context for data aggregation", "Internal API")
Rel(Real_time_Messaging_Gateway, Patient_Dashboard_Controller, "Synchronizes session state and clinical alerts", "Internal API")

@enduml