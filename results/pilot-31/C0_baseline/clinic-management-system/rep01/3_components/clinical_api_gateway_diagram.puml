@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

System_Boundary(c1, "Clinical API Gateway") {
    Component(RequestRouter, "Request Router", "Envoy Proxy", "Handles high-performance routing, mTLS termination, and QoS traffic prioritization.")
    Component(AuthManager, "Authentication Manager", "Keycloak OIDC Client", "Validates identity tokens and enforces Token Binding (RFC 8471).")
    Component(GrpcWebAdapter, "gRPC-Web Adapter", "gRPC-web", "Minimizes serialization overhead for frontend-to-gateway communication.")
    Component(ServiceOrchestrator, "Service Orchestrator", "Go", "Manages gRPC communication with downstream services using circuit-breaker patterns.")
    Component(TelemetryCollector, "Telemetry Collector", "OpenTelemetry", "Instruments distributed tracing for observability and latency monitoring.")
}

System_Ext(EMR, "EMR Service", "Java/Spring Boot")
System_Ext(Billing, "Billing Service", "Python/FastAPI")
System_Ext(FHIR, "FHIR Integration Service", "Java")
System_Ext(Audit, "Audit Log Service", "Go/S3 Glacier")

Rel(RequestRouter, AuthManager, "Validates incoming requests", "OIDC/Token Binding")
Rel(RequestRouter, GrpcWebAdapter, "Routes frontend traffic", "gRPC-web")
Rel(ServiceOrchestrator, EMR, "Invokes via gRPC with circuit-breaker", "gRPC")
Rel(ServiceOrchestrator, Billing, "Invokes via gRPC with circuit-breaker", "gRPC")
Rel(ServiceOrchestrator, FHIR, "Invokes via REST/FHIR", "REST/FHIR")
Rel(ServiceOrchestrator, Audit, "Streams events asynchronously", "NATS/Kafka")

@enduml