@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

System_Ext(AuditLogService, "Audit Log Service", "Immutable, cryptographically signed event store")
System_Ext(FHIRIntegrationService, "FHIR Integration Service", "FHIR RESTful APIs for external data exchange")
System_Ext(ClinicalAPIGateway, "Clinical API Gateway", "Entry point for internal clinical requests")

Container_Boundary(EMRService, "EMR Service") {
    Component(ClinicalRecordManager, "Clinical Record Manager", "ACID-compliant Transaction Engine", "Handles primary clinical data write operations and event sourcing.")
    Component(ClinicalReadModel, "Clinical Read Model", "Optimized Projection Engine", "Provides low-latency data retrieval for clinical history.")
    Component(AccessControlProvider, "Access Control Provider", "Open Policy Agent (OPA)", "Enforces authorization policies for clinical data access.")
    Component(EmergencyAccessController, "Emergency Access Controller", "Break-glass Authorization Module", "Manages clinical emergency overrides for restricted records.")
}

Rel(ClinicalRecordManager, ClinicalReadModel, "Synchronizes via event sourcing", "CQRS pattern")
Rel(EMRService, AuditLogService, "Asynchronous event streaming", "Sidecar pattern")
Rel(EMRService, FHIRIntegrationService, "FHIR RESTful APIs", "HTTPS")
Rel(ClinicalAPIGateway, EMRService, "Internal routing", "gRPC")

@enduml