@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container_Boundary(fhir_integration_service, "FHIR Integration Service") {
    Component(FHIR_Facade_Controller, "FHIR Facade Controller", "REST Controller", "Handles request validation and routing for incoming FHIR API calls.")
    Component(Transformation_Engine, "Transformation Engine", "Java/HAPI FHIR", "Maps internal schemas to FHIR resources and performs data transformation.")
    Component(Outbox_Message_Queue, "Outbox/Message Queue", "Kafka", "Decouples processing and ensures asynchronous delivery of messages.")
    Component(Integration_Configuration_Manager, "Integration Configuration Manager", "HashiCorp Consul", "Manages vendor-specific metadata and dynamic connection secrets.")
    Component(Schema_Registry, "Schema Registry", "FHIR Profile Validator", "Enforces versioned FHIR profile validation for R4/R5 resources.")
    Component(Sidecar_Proxies, "Sidecar Proxies", "Istio", "Manages mTLS, logging, and HIPAA audit trails for the service.")
}

Rel(FHIR_Facade_Controller, Transformation_Engine, "Routes validated requests for mapping", "Internal API")
Rel(Transformation_Engine, Schema_Registry, "Validates payloads against versioned HL7 FHIR profiles", "REST/Internal")
Rel(Transformation_Engine, Outbox_Message_Queue, "Publishes transformed resources for asynchronous delivery", "Kafka Protocol")
Rel(Integration_Configuration_Manager, Transformation_Engine, "Provides dynamic routing and vendor-specific connection secrets", "Consul API")
Rel(Sidecar_Proxies, FHIR_Facade_Controller, "Secures traffic via mTLS and logs audit trails", "mTLS")

@enduml