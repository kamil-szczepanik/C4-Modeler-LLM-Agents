@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

System_Ext(ComplianceDashboard, "Compliance Dashboard", "External auditing interface for compliance monitoring.")
System_Ext(S3Glacier, "S3 Glacier", "WORM-compliant archival storage with quarterly checksum verification.")
System_Ext(IAMProvider, "IAM Provider", "Identity provider for validating claims and non-repudiable auditor access.")
System_Ext(IdentityProxy, "Identity Proxy", "Secures the Query API and manages authentication flow.")

System_Boundary(AuditLogService, "Audit Log Service") {
    Component(IngestionController, "Ingestion Controller", "Go", "Handles asynchronous event processing and implements circuit breaking for incoming logs.")
    Component(LogProcessor, "Log Processor", "Go", "Performs schema validation and cryptographic hashing of events.")
    Component(SearchIndexer, "Search Indexer", "OpenSearch", "Facilitates rapid retrieval and query performance for compliance monitoring.")
    Component(StorageController, "Storage Controller", "Go", "Interface for S3 Glacier with WORM Object Lock for immutable storage.")
    Component(EventOrchestrator, "Event Orchestrator", "Go", "Manages DSAR workflows, log redaction, and health scoring.")
    Component(QueryAPI, "Query API", "Go/gRPC", "Provides a read-only interface for auditors, secured via an Identity Proxy.")
    Component(Sidecar, "Sidecar", "EMR", "Handles local event buffering and mTLS-secured transmission.")
}

Rel(Sidecar, IngestionController, "Asynchronous event shipment via mTLS", "mTLS")
Rel(QueryAPI, ComplianceDashboard, "HTTPS/gRPC for secure, ABAC-restricted auditing", "HTTPS/gRPC")
Rel(StorageController, S3Glacier, "WORM-compliant archival with quarterly checksum verification", "HTTPS")
Rel(IdentityProxy, IAMProvider, "Validates claims for non-repudiable auditor access", "OIDC/SAML")

@enduml