@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Clinic Management Systems

Person(ClinicalStaff, "Clinical Staff", "Medical professionals who access patient records, manage admissions, and provide care.")
Person(AdministrativeStaff, "Administrative Staff", "Staff responsible for scheduling, billing, and clinic operations.")
Person(Patients, "Patients", "Individuals receiving care who access their personal health records and appointments.")

System_Ext(ExternalLabsImagingSystems, "External Labs/Imaging Systems", "External systems providing lab results and medical imaging data via HL7 FHIR APIs.")
System_Ext(ThirdPartyBillingInsuranceGateways, "Third-Party Billing/Insurance Gateways", "External systems handling payment processing and insurance claims.")

System_Boundary(ClinicManagementSystem, "Clinic Management System") {
    Container(APIGateway, "API Gateway", "HTTPS (TLS 1.3), REST, gRPC", "Routes internal and external traffic to downstream microservices.")
    Container(EMRService, "EMR Service", "Microservice, HL7 FHIR", "Manages electronic medical records and integrates with external labs and imaging.")
    Container(SchedulingService, "Scheduling Service", "Microservice", "Handles patient appointments and calendar management.")
    Container(BillingService, "Billing Service", "Microservice", "Processes financial transactions and insurance gateways.")
    Container(PatientRegistrationService, "Patient Registration Service", "Microservice", "Handles patient admissions and profile onboarding.")
    Container(MessageQueueEventBus, "Message Queue/Event Bus", "Message Bus", "Facilitates asynchronous event-driven communication between services.")
}

Rel(ClinicalStaff, APIGateway, "Access front-end applications with Multi-Factor Authentication", "HTTPS (TLS 1.3), MFA")
Rel(AdministrativeStaff, APIGateway, "Manage scheduling, billing, and administrative workflows", "HTTPS (TLS 1.3), MFA")
Rel(Patients, APIGateway, "Access personal health records and schedule appointments", "HTTPS (TLS 1.3), MFA")
Rel(APIGateway, EMRService, "Routes internal traffic", "gRPC and REST over TLS")
Rel(APIGateway, SchedulingService, "Routes internal traffic", "gRPC and REST over TLS")
Rel(APIGateway, BillingService, "Routes internal traffic", "gRPC and REST over TLS")
Rel(EMRService, ExternalLabsImagingSystems, "Integrates clinical data and imaging results", "HL7 FHIR APIs over HTTPS")

@enduml