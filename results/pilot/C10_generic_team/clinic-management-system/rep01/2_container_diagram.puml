@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Clinical_Staff, "Clinical Staff", "Medical professionals who access patient records, manage admissions, and provide care.")
Person(Administrative_Staff, "Administrative Staff", "Staff responsible for scheduling, billing, and clinic operations.")
Person(Patients, "Patients", "Individuals receiving care who access their personal health records and appointments.")

System_Ext(External_Labs_and_Imaging_Systems, "External Labs and Imaging Systems", "External systems providing lab results and medical imaging data via HL7 FHIR APIs.")
System_Ext(Third_Party_Billing_Insurance_Gateways, "Third-Party Billing/Insurance Gateways", "External systems handling payment processing and insurance claims.")

System_Boundary(Clinic_Management_System, "Clinic Management System") {
    Container(API_Gateway, "API Gateway", "HTTPS, TLS 1.3, OpenAPI", "Routes internal and external traffic to downstream microservices and handles security.")
    Container(EMR_Service, "EMR Service", "Microservice, HL7 FHIR", "Manages electronic medical records and clinical workflows.")
    Container(Scheduling_Service, "Scheduling Service", "Microservice", "Handles patient appointments and calendar management.")
    Container(Billing_Service, "Billing Service", "Microservice", "Processes financial transactions, invoicing, and third-party insurance gateways.")
    Container(Patient_Registration_Service, "Patient Registration Service", "Microservice", "Manages patient admissions and profile onboarding.")
    Container(Background_Worker_Pools, "Background Worker Pools", "Asynchronous Worker Nodes", "Handles asynchronous tasks and persistent queue processing.")
    Container(Caching_Layer, "Caching Layer", "Redis", "Provides high-performance caching for low-latency EMR load requirements.")
    Container(Message_Brokers, "Message Brokers", "Persistent Message Queues with Dead-Letter Routing", "Facilitates asynchronous event-driven communication between services.")
}

Rel(Clinical_Staff, API_Gateway, "Access system features via HTTPS with Multi-Factor Authentication", "HTTPS, MFA")
Rel(Administrative_Staff, API_Gateway, "Access administrative and scheduling features via HTTPS with MFA", "HTTPS, MFA")
Rel(Patients, API_Gateway, "Access personal health records and appointments via HTTPS with MFA", "HTTPS, MFA")

Rel(API_Gateway, EMR_Service, "Routes requests to EMR container", "REST, gRPC over TLS")
Rel(API_Gateway, Scheduling_Service, "Routes requests to Scheduling container", "REST, gRPC over TLS")
Rel(API_Gateway, Billing_Service, "Routes requests to Billing container", "REST, gRPC over TLS")
Rel(API_Gateway, Patient_Registration_Service, "Routes requests to Registration container", "REST, gRPC over TLS")
Rel(API_Gateway, External_Labs_and_Imaging_Systems, "Integrates external clinical data and imaging systems", "HL7 FHIR APIs")

Rel(EMR_Service, Caching_Layer, "Queries caching layer for performance optimization", "In-memory Redis Protocol")
Rel(Scheduling_Service, Caching_Layer, "Queries caching layer for performance optimization", "In-memory Redis Protocol")

Rel(Billing_Service, Third_Party_Billing_Insurance_Gateways, "Interacts with external billing and insurance gateways", "HTTPS, REST")

Rel(EMR_Service, Message_Brokers, "Communicates asynchronously with other services", "Persistent Queues")
Rel(Scheduling_Service, Message_Brokers, "Communicates asynchronously with other services", "Persistent Queues")
Rel(Billing_Service, Message_Brokers, "Communicates asynchronously with other services", "Persistent Queues")
Rel(Patient_Registration_Service, Message_Brokers, "Communicates asynchronously with other services", "Persistent Queues")

@enduml