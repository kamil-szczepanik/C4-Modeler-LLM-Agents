@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Message Brokers container

Container_Boundary(message_brokers, "Message Brokers") {
    Component(Persistent_Message_Queues, "Persistent Message Queues", "Persistent Message Queues with Tiered Storage", "Ensures reliable asynchronous event-driven communication and data integrity across hybrid boundaries.")
    Component(Dead_Letter_Routing, "Dead-Letter Routing", "Message Broker Routing Engine", "Handles undeliverable messages and failed event processing for system resilience.")
}

Rel(Persistent_Message_Queues, Dead_Letter_Routing, "Routes failed messages to")

@enduml