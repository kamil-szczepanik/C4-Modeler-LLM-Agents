@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Background Worker Pools container

Container_Boundary(background_worker_pools, "Background Worker Pools") {
    Component(BackgroundWorkerNodes, "Background Worker Nodes", "Kubernetes, Pluggable Job Handler Architecture", "Manages asynchronous tasks, decoupling heavy administrative and clinical processes from user-facing paths while executing workloads reliably.")
}

Component(MessageBrokers, "Message Brokers", "Persistent Message Queues with Dead-Letter Routing", "Provides persistent message queues with dead-letter routing for asynchronous task processing.")
Component(ExternalThirdPartyBillingGatewaysLabSystems, "External Third-Party Billing Gateways & Lab Systems", "HTTPS with Circuit Breakers", "External systems for third-party billing and lab integrations.")
Component(CoreMicroservices, "Core Microservices", "Transactional Outbox Patterns, Strongly Typed Payload Contracts", "Core services including EMR, Billing, Scheduling, and Registration interacting via transactional outbox patterns.")
Component(CentralizedJobMonitoringDashboard, "Centralized Job Monitoring Dashboard", "Dashboard and Metrics Reporting", "Monitors job execution and reports metrics for asynchronous workloads.")

Rel(BackgroundWorkerNodes, MessageBrokers, "Consumes tasks from Message Brokers via persistent message queues")
Rel(BackgroundWorkerNodes, ExternalThirdPartyBillingGatewaysLabSystems, "Communicates with External Third-Party Billing Gateways & Lab Systems via HTTPS with circuit breakers")
Rel(BackgroundWorkerNodes, CoreMicroservices, "Interacts with Core Microservices using transactional outbox patterns and strongly typed payload contracts")
Rel(BackgroundWorkerNodes, CentralizedJobMonitoringDashboard, "Reports metrics to the Centralized Job Monitoring Dashboard")

@enduml