@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Edge_Proxy, "Edge Proxy", "Stateless edge proxy deployed on on-prem-k8s and eu-central-1", "Routes external traffic and terminates secure client traffic at the edge with TLS 1.3.")
    Component(Routing_and_Validation_Engine, "Routing and Validation Engine", "OpenAPI, GitOps", "Enforces declarative infrastructure routing and strict contract validation at the edge.")
}

Rel(Edge_Proxy, Routing_and_Validation_Engine, "Validates and routes requests", "HTTPS, MFA")

@enduml