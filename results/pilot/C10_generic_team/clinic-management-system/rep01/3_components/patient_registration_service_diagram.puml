@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient Registration Service container

Container_Boundary(Patient_Registration_Service, "Patient Registration Service") {
    Component(Patient Registration Controller, "Patient Registration Controller", "REST/gRPC, OpenAPI", "Handles incoming patient admission requests and API Gateway traffic.")
    Component(Patient Domain Service, "Patient Domain Service", "Java, Domain-Driven Design, CQRS", "Implements business logic for patient registration, validation, and management.")
    Component(Patient Data Access Repository, "Patient Data Access Repository", "JDBC, TLS", "Manages persistence and retrieval of patient records with PostgreSQL.")
    Component(Registration Event Publisher, "Registration Event Publisher", "AMQP, TCP", "Publishes patient registration events to persistent message queues.")
}

Rel(Patient Registration Controller, Patient Domain Service, "Delegates business logic requests")
Rel(Patient Domain Service, Patient Data Access Repository, "Reads and writes transactional patient data")
Rel(Patient Domain Service, Registration Event Publisher, "Sends asynchronous domain events")

@enduml