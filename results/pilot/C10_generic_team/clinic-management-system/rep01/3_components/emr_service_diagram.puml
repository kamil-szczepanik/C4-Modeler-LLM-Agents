@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(emr_service_container, "EMR Service") {
    Component(emr_api_controller, "EMR API Controller", "Microservice / REST, gRPC", "Handles incoming routing requests from the API Gateway and exposes endpoints for clinical records.")
    Component(cqrs_handler, "CQRS Command/Query Handler", "CQRS Pattern", "Separates read and write operations on patient records for performance optimization.")
    Component(abac_engine, "ABAC Enforcement Engine", "Attribute-Based Access Control", "Enforces strict HIPAA/GDPR compliance and access control policies for patient data.")
    Component(fhir_adapter, "FHIR Interoperability Adapter", "HL7 FHIR", "Serializes and deserializes data for seamless interoperability with external labs and imaging systems.")
}

Rel(emr_api_controller, cqrs_handler, "Delegates read and write operations")
Rel(cqrs_handler, abac_engine, "Validates access permissions for data operations")
Rel(cqrs_handler, fhir_adapter, "Transforms clinical data to standardized formats")

@enduml