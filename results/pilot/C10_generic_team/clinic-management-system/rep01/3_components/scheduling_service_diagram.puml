@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Scheduling Service container

Container_Boundary("Scheduling_Service", "Scheduling Service") {
    Component("Booking_Controller", "Booking Controller", "Microservice REST/gRPC", "Handles incoming booking requests routed from the API Gateway.")
    Component("Reservation_Manager", "Reservation Manager", "Domain-Driven Design Domain Model", "Queries and manages time-slot reservations using distributed locks.")
    Component("Event_Publisher", "Event Publisher", "Persistent Message Queues / Saga Pattern", "Publishes asynchronous state change events to message brokers.")
    Component("Audit_Logger", "Audit Logger", "Secure Stream", "Streams immutable audit logs asynchronously to WORM storage.")
}

Rel("Booking_Controller", "Reservation_Manager", "Delegates time-slot reservation logic", "Internal Function Call")
Rel("Reservation_Manager", "Event_Publisher", "Triggers state change events", "Saga Pattern")
Rel("Reservation_Manager", "Audit_Logger", "Generates audit trail for reservation actions", "Secure Stream")

@enduml