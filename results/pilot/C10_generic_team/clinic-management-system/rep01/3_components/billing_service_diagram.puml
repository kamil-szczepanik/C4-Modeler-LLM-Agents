@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(billing_service, "Billing Service") {
    Component(OutboxProcessor, "Outbox Processor", "Outbox Pattern / Idempotent API Handlers", "Ensures reliable financial transaction processing without duplicates.")
    Component(SagaOrchestrator, "Saga Orchestrator", "Saga Pattern", "Manages distributed transaction consistency across complex workflows.")
    Component(ResilienceHandler, "Resilience Handler", "Circuit Breakers and Bulkhead Isolation", "Prevents cascading failures and isolates real-time copays from batch claims.")
    Component(AuditLogger, "Audit Logger", "Event-Sourcing and Immutable Append-Only Logs", "Satisfies 10-year data retention and strict auditability mandates.")
    Component(AntiCorruptionLayer, "Anti-Corruption Layer", "Adapter / ACL", "Isolates external insurance protocol changes from core domain logic.")
}

Rel(OutboxProcessor, SagaOrchestrator, "Triggers distributed workflow events")
Rel(SagaOrchestrator, ResilienceHandler, "Executes calls through resilient boundaries")
Rel(ResilienceHandler, AntiCorruptionLayer, "Communicates with external systems safely")
Rel(AuditLogger, OutboxProcessor, "Records immutable transaction events")

@enduml