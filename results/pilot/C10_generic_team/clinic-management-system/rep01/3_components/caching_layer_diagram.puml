@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Caching Layer container

Container_Boundary(caching_layer, "Caching Layer") {
    Component(RedisPrimaryReplicaStore, "Redis Primary-Replica Store", "Redis with Redis Sentinel/Cluster", "In-memory store with LRU eviction and memory-wiping mechanisms providing low latency and high availability.")
    Component(AccessControlLayerACL, "Access Control Layer (ACL)", "Redis ACL", "Restricts key-spaces to ensure strict HIPAA and GDPR compliance regulations.")
    Component(EventInvalidationListener, "Event Invalidation Listener", "AMQP/Kafka Client", "Receives asynchronous event-driven invalidation signals from the message broker.")
}

Rel(EventInvalidationListener, RedisPrimaryReplicaStore, "Triggers cache invalidation upon receiving events", "In-memory Redis Protocol over TLS 1.3")

@enduml