@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FrontDeskAdministrator, "Front Desk Administrator", "Manages patient registrations, check-ins, and front desk workflows.")
Person(Clinician, "Clinician", "Accesses and updates electronic medical records and clinical schedules.")
Person(BillingSpecialist, "Billing Specialist", "Manages billing, claims, and financial transactions.")
Person(Patient, "Patient", "Interacts with the patient portal for appointments and health records.")

System(ClinicManagementSystem, "Clinic Management System", "A hybrid cloud platform managing patient registrations, electronic medical records, scheduling, and billing for medium-sized hospitals and clinics, ensuring strict HIPAA and GDPR compliance.")

System_Ext(ExternalLabImagingSystems, "External Lab & Imaging Systems", "External systems providing lab results and medical imaging via HL7 FHIR APIs.")

Rel(FrontDeskAdministrator, ClinicManagementSystem, "Interacts with web client for administrative workflows", "HTTPS (TLS 1.3)")
Rel(Clinician, ClinicManagementSystem, "Interacts with web client for clinical workflows and EMR", "HTTPS (TLS 1.3)")
Rel(BillingSpecialist, ClinicManagementSystem, "Interacts with web client for billing and claims", "HTTPS (TLS 1.3)")
Rel(Patient, ClinicManagementSystem, "Interacts with patient portal for appointments and records", "HTTPS (TLS 1.3)")
Rel(ExternalLabImagingSystems, ClinicManagementSystem, "Exchanges lab and imaging data", "HL7 FHIR APIs over mTLS")

@enduml