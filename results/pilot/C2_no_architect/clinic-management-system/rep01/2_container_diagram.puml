@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(FrontDeskAdministrator, "Front Desk Administrator", "Manages patient admissions and front desk workflows.")
Person(Clinician, "Clinician", "Accesses EMRs and manages clinical schedules.")
Person(BillingSpecialist, "Billing Specialist", "Manages billing, claims, and financial workflows.")
Person(Patient, "Patient", "Interacts with the patient portal for appointments and records.")
System_Ext(ExternalLabImagingSystems, "External Lab & Imaging Systems", "External systems providing lab results and medical imaging.")

System_Boundary(ClinicManagementSystem, "Clinic Management System") {
    Container(PatientRegistration, "Patient Registration", "Kubernetes, REST API", "Manages patient admissions and registration workflows.")
    Container(AppointmentScheduling, "Appointment Scheduling", "Kubernetes, REST API", "Handles scheduling for clinical appointments.")
    Container(EMR, "EMR", "Kubernetes, Encrypted Distributed Storage", "Manages electronic medical records securely.")
    Container(BillingClaims, "Billing & Claims", "Kubernetes, Encrypted Distributed Storage", "Manages billing, financial workloads, and insurance claims.")
    Container(HL7FHIRInteroperability, "HL7 FHIR Interoperability", "Kubernetes, HL7 FHIR APIs", "Integrates with external lab and imaging systems.")
    Container(PatientPortal, "Patient Portal", "Kubernetes, REST API", "Provides patients access to appointments and health records.")
}

Rel(FrontDeskAdministrator, PatientRegistration, "Accesses via web interface for admissions", "HTTPS (TLS 1.3), OAuth2/OIDC MFA")
Rel(FrontDeskAdministrator, AppointmentScheduling, "Manages appointments", "HTTPS (TLS 1.3), OAuth2/OIDC MFA")
Rel(Clinician, EMR, "Views and updates medical records", "HTTPS (TLS 1.3), OAuth2/OIDC MFA")
Rel(Clinician, AppointmentScheduling, "Views clinical schedules", "HTTPS (TLS 1.3), OAuth2/OIDC MFA")
Rel(BillingSpecialist, BillingClaims, "Manages billing and claims", "HTTPS (TLS 1.3), OAuth2/OIDC MFA")
Rel(Patient, PatientPortal, "Views appointments and health records", "HTTPS (TLS 1.3), OAuth2/OIDC MFA")
Rel(HL7FHIRInteroperability, ExternalLabImagingSystems, "Exchanges lab and imaging data", "HL7 FHIR APIs over mTLS")
Rel(PatientRegistration, EMR, "Creates and updates patient records", "gRPC / REST via mTLS")
Rel(AppointmentScheduling, EMR, "Links appointments to patient records", "gRPC / REST via mTLS")
Rel(BillingClaims, EMR, "Accesses clinical encounter data for billing", "gRPC / REST via mTLS")
Rel(PatientPortal, AppointmentScheduling, "Books and views appointments", "gRPC / REST via mTLS")
Rel(HL7FHIRInteroperability, EMR, "Ingests lab and imaging results", "gRPC / REST via mTLS")

@enduml