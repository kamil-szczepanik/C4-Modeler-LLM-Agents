@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient Portal container

Container_Boundary(patient_portal, "Patient Portal") {
    Component(Portal_API_Gateway, "Portal API Gateway", "Kubernetes, REST API / gRPC, WAF", "Handles incoming requests from the Ingress layer, enforces rate-limiting, and routes traffic to internal services.")
    Component(Authentication_Authorization_Service, "Authentication & Authorization Service", "OAuth2/OIDC, JWT, mTLS", "Manages user authentication, MFA, and short-lived token validation with strict audience checks.")
    Component(Appointment_Interface_Manager, "Appointment Interface Manager", "gRPC, REST", "Communicates with the Appointment Scheduling Container to book and retrieve appointment data.")
    Component(EMR_Data_Aggregator, "EMR Data Aggregator", "gRPC, REST, Encrypted Distributed Storage", "Retrieves health records and lab results from the EMR Container and ensures PHI protection.")
    Component(FHIR_Integration_Client, "FHIR Integration Client", "HL7 FHIR APIs", "Exchanges health data securely with External Lab & Imaging Systems.")
}

Rel(Portal_API_Gateway, Authentication_Authorization_Service, "Validates OAuth2/OIDC tokens and MFA for incoming requests", "HTTPS (TLS 1.3)")
Rel(Portal_API_Gateway, Appointment_Interface_Manager, "Forwards requests to book and view appointments", "gRPC / REST via mTLS")
Rel(Portal_API_Gateway, EMR_Data_Aggregator, "Requests health records and lab results", "gRPC / REST via mTLS")
Rel(EMR_Data_Aggregator, FHIR_Integration_Client, "Synchronizes or exchanges health data with external partners", "HL7 FHIR APIs")

@enduml