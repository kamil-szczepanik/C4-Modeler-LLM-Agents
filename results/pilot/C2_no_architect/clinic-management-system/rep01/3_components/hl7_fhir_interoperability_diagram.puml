@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("HL7_FHIR_Interoperability", "HL7 FHIR Interoperability") {
    Component("FHIR_API_Gateway", "FHIR API Gateway", "API Gateway / REST / mTLS", "Handles incoming and outgoing HL7 FHIR requests from external lab systems and internal services.")
    Component("Data_Ingestion_Service", "Data Ingestion Service", "gRPC / Kafka", "Processes and standardizes incoming lab and imaging results for consumption by the EMR.")
}

Rel("FHIR_API_Gateway", "Data_Ingestion_Service", "Routes validated lab and imaging payloads", "gRPC / REST via mTLS")

@enduml