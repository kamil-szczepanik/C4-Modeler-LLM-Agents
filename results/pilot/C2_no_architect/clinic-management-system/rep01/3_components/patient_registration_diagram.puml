@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(patient_registration, "Patient Registration") {
    Component(Registration_API_Controller, "Registration API Controller", "Kubernetes container, REST API", "Handles incoming HTTP requests from the Front Desk Administrator and Patient Portal for patient admissions, intake, and demographics.")
    Component(Registration_Service, "Registration Service", "Business Logic Engine", "Processes patient registration logic and coordinates updates with downstream EMR systems.")
}

Rel(Registration_API_Controller, Registration_Service, "Invokes business logic for intake processing", "")

@enduml