@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing & Claims container

Person(BillingSpecialist, "Billing Specialist", "Manages financial workflows via HTTPS (TLS 1.3), OAuth2/OIDC MFA.")
Person(Patient, "Patient", "Accesses itemized billing via REST API with OAuth2 scopes.")
System_Ext(ExternalClearinghousesPaymentGateways, "External Clearinghouses & Payment Gateways", "Handles external insurance claims and payments.")
System_Ext(EMRContainer, "EMR Container", "Manages electronic medical records and encounter data.")
System_Ext(PatientPortalContainer, "Patient Portal Container", "Provides access for patients.")
System_Ext(HashiCorpVault, "HashiCorp Vault", "Provides dynamic database credential rotation and secret management.")
System_Ext(ApacheKafkaRabbitMQ, "Apache Kafka / RabbitMQ", "Provides queue-based load leveling for asynchronous claim submissions.")

Container_Boundary(BillingClaimsContainer_Boundary, "Billing & Claims") {
    Container(BillingClaimsContainer, "Billing & Claims Container", "Kubernetes, Encrypted Distributed Storage", "Automates financial workflows, insurance claims, and self-service payments.")
}

Rel(BillingSpecialist, BillingClaimsContainer, "Manages financial workflows", "HTTPS (TLS 1.3), OAuth2/OIDC MFA")
Rel(Patient, BillingClaimsContainer, "Accesses itemized billing", "REST API with OAuth2 scopes")
Rel(BillingClaimsContainer, EMRContainer, "Accesses encounter data", "gRPC / REST using mTLS")
Rel(BillingClaimsContainer, ExternalClearinghousesPaymentGateways, "Submits insurance claims", "mTLS and asynchronous messaging")

@enduml