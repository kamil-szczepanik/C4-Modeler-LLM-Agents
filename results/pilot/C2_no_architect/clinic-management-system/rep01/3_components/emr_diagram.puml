@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Clinician, "Clinician", "A medical professional who views and updates patient electronic medical records.")
System_Ext(PatientRegistration, "Patient Registration", "Creates and updates patient records.")
System_Ext(AppointmentScheduling, "Appointment Scheduling", "Links appointments to patient records.")
System_Ext(BillingClaims, "Billing & Claims", "Accesses clinical encounter data.")
System_Ext(HL7FHIRInteroperability, "HL7 FHIR Interoperability", "Ingests lab and imaging results.")
System_Ext(ExternalLabImagingSystems, "External Lab & Imaging Systems", "External systems for lab and imaging data.")

Container_Boundary(EMR, "EMR") {
    Component(MedicalRecordsManagementEngine, "Medical Records Management Engine", "Kubernetes Container, Encrypted Distributed Storage with NVMe & Tiered Object Storage", "Manages the creation, updating, and secure storage of electronic medical records with active-active multi-master replication, AES-256 storage-at-rest, and field-level encryption.")
    Component(ClinicianAccessInterface, "Clinician Access Interface", "HTTPS (TLS 1.3), OAuth2/OIDC MFA", "Handles secure clinician authentication and authorization for viewing and updating medical records.")
    Component(InternalIntegrationReceiver, "Internal Integration Receiver", "gRPC / REST via mTLS (SPIFFE/SPIRE)", "Processes incoming requests from Patient Registration, Appointment Scheduling, Billing & Claims, and HL7 FHIR Interoperability containers.")
}

Rel(Clinician, ClinicianAccessInterface, "Views and updates medical records", "HTTPS (TLS 1.3) with OAuth2/OIDC MFA")
Rel(PatientRegistration, InternalIntegrationReceiver, "Creates and updates patient records", "gRPC / REST via mTLS (SPIFFE/SPIRE)")
Rel(AppointmentScheduling, InternalIntegrationReceiver, "Links appointments to patient records", "gRPC / REST via mTLS")
Rel(BillingClaims, InternalIntegrationReceiver, "Accesses clinical encounter data", "gRPC / REST via mTLS")
Rel(HL7FHIRInteroperability, InternalIntegrationReceiver, "Ingests lab and imaging results", "gRPC / REST via mTLS")
Rel(MedicalRecordsManagementEngine, ExternalLabImagingSystems, "Exchanges data", "HL7 FHIR APIs")
@enduml