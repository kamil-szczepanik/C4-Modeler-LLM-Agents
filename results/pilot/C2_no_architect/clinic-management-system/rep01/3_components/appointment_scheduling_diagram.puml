@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Appointment Scheduling", "Appointment Scheduling") {
    Component(AppointmentController, "Appointment Controller", "REST / gRPC", "Handles incoming appointment booking and viewing requests from the Patient Portal and administrative users.")
    Component(AppointmentService, "Appointment Service", "Microservice Logic", "Manages business rules for scheduling, updating, and linking appointments to medical records.")
    Component(CalendarIntegrationEngine, "Calendar Integration Engine", "mTLS / gRPC", "Synchronizes clinician schedules and links appointment entries to the EMR container.")
}

Rel(AppointmentController, AppointmentService, "Validates and routes requests")
Rel(AppointmentService, CalendarIntegrationEngine, "Links appointments to patient records")
@enduml