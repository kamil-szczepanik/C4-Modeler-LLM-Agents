@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Apache Kafka Event Broker container

Container_Boundary(kafka_broker, "Apache Kafka Event Broker") {
    Component(Topic_Management_Engine, "Topic Management Engine", "Apache Kafka Topic Management", "Manages real-time, asynchronous clinical data streaming topics.")
    Component(KRaft_metadata_mode, "KRaft metadata mode", "Apache Kafka KRaft", "Provides metadata management without ZooKeeper for high availability and rapid failovers.")
}

Rel(Topic_Management_Engine, KRaft_metadata_mode, "Utilizes metadata consensus")

@enduml