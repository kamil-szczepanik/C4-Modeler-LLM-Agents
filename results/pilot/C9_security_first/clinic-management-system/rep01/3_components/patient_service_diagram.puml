@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(patient_service, "Patient Service") {
    Component(patient_controller, "Patient Controller", "Java & Spring Boot", "Handles incoming gRPC requests routed from the API Gateway and exposes endpoints for patient admission operations.")
    Component(patient_domain, "Patient Domain Model", "Java & Spring Boot", "Encapsulates the core business logic and state validation for patient records.")
    Component(patient_event_publisher, "Patient Event Publisher", "Apache Kafka", "Streams domain events to the Apache Kafka Event Broker via SASL/SCRAM authentication.")
    Component(patient_repo, "Patient Data Access Repository", "Distributed PostgreSQL", "Persists patient transactional data securely via AES-256 encrypted volumes.")
    Component(fhir_adapter, "FHIR Integration Adapter", "HL7 FHIR APIs", "Interoperates with third-party lab and imaging systems using standard HL7 FHIR protocols.")
}

Rel(patient_controller, patient_domain, "Delegates request business logic to")
Rel(patient_domain, patient_event_publisher, "Triggers domain events via")
Rel(patient_domain, patient_repo, "Persists and retrieves data using")
Rel(patient_domain, fhir_adapter, "Communicates with external systems via")

@enduml