@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(distributed_postgresql_database, "Distributed PostgreSQL Database") {
    Component(PostgreSQL_with_Citus, "PostgreSQL with Citus", "PostgreSQL, Citus", "Distributed database sharding for handling large-scale patient and transaction data.")
    Component(Patroni, "Patroni", "Patroni", "Provides active-active high availability and automated failover management.")
    Component(pgAudit, "pgAudit", "pgAudit", "Enables detailed session and object audit logging for HIPAA/GDPR compliance.")
    Component(AES_256_Encryption, "AES-256 Encryption", "AES-256", "Secures data at rest within the distributed storage layer.")
}

Rel(Patroni, PostgreSQL_with_Citus, "Manages high availability and failover for", "")
Rel(pgAudit, PostgreSQL_with_Citus, "Audits database activity on", "")
Rel(AES_256_Encryption, PostgreSQL_with_Citus, "Encrypts stored data for", "")

@enduml