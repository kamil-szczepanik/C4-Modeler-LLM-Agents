@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Apache Camel Integration Service container

Container_Boundary(apache_camel_integration_service, "Apache Camel Integration Service") {
    Component(FHIR-Parser-Component, "FHIR-Parser-Component", "Apache Camel / Java DSL", "Parses and validates incoming FHIR clinical data and financial claims.")
    Component(HL7-Transformation-Component, "HL7-Transformation-Component", "Apache Camel / Spring Boot", "Handles protocol translation and data structure mapping for interoperability.")
    Component(External-Connector-Pool, "External-Connector-Pool", "Resilience4j / Java", "Manages secure connections and circuit breaking for external third-party endpoints.")
    Component(Audit-Logging-Processor, "Audit-Logging-Processor", "OpenTelemetry / Java", "Enforces distributed tracing and HIPAA/GDPR-compliant audit logging.")
    Component(Dead Letter Channel, "Dead Letter Channel", "Apache Camel / PostgreSQL", "Provides zero-loss buffering and error management for failed transmissions.")
}

Rel(FHIR-Parser-Component, HL7-Transformation-Component, "Passes parsed payloads for structural transformation")
Rel(HL7-Transformation-Component, External-Connector-Pool, "Routes transformed messages to external healthcare networks")
Rel(External-Connector-Pool, Dead Letter Channel, "Redirects failed messages on endpoint failure")
Rel(FHIR-Parser-Component, Audit-Logging-Processor, "Sends transaction telemetry and audit trails")

@enduml