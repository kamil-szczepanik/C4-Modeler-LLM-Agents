@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the EMR Service container

Container_(nginx_kong_api_gateway, "NGINX/Kong API Gateway", "API Gateway", "Routes external requests using gRPC with mTLS.")

Container_Boundary(emr_service, "EMR Service") {
    Component(emr_query_component, "EMR Query Component", "Read-optimized Redis caching and PostgreSQL read replicas", "Internal component utilizing read-optimized Redis caching and PostgreSQL read replicas.")
    Component(fhir_mapper_component, "FHIR Mapper Component", "HAPI FHIR libraries and Apache Camel", "Internal component utilizing HAPI FHIR libraries and Apache Camel for interoperability.")
    Component(audit_service_component, "Audit Service Component", "Asynchronous compliance logging", "Internal component managing asynchronous, tamper-evident compliance logging.")
}

ContainerDb(distributed_postgresql_database, "Distributed PostgreSQL Database", "PostgreSQL", "Primary data store with AES-256 encryption at rest and schema-per-service isolation.")
Container(redis_caching_layer, "Redis Caching Layer", "Redis", "In-memory cache utilizing application-layer encryption for patient chart fragments.")
Container(apache_camel_integration_service, "Apache Camel Integration Service", "Apache Camel", "Integration service for transforming and transmitting clinical payloads.")
Container(apache_kafka_event_broker, "Apache Kafka Event Broker", "Apache Kafka", "Event streaming backbone using SASL/SCRAM authentication.")
System_Ext(external_lab_imaging_systems, "External Lab & Imaging Systems", "HL7 FHIR R4 over mTLS", "External systems exchanging standardized data using HL7 FHIR R4.")

Rel(nginx_kong_api_gateway, emr_service, "Routes external requests using gRPC with mTLS", "gRPC / mTLS")
Rel(emr_service, distributed_postgresql_database, "Persists and queries transactional health data via JDBC with HikariCP connection pooling", "JDBC")
Rel(emr_service, redis_caching_layer, "Retrieves and stores encrypted patient chart fragments via Spring Data Redis (Lettuce)", "Spring Data Redis")
Rel(emr_service, apache_camel_integration_service, "Transforms and transmits clinical payloads using internal gRPC stubs", "gRPC")
Rel(fhir_mapper_component, external_lab_imaging_systems, "Exchanges standardized data using HL7 FHIR R4 over mTLS", "HL7 FHIR R4 / mTLS")
Rel(emr_service, apache_kafka_event_broker, "Streams domain events using SASL/SCRAM authentication", "SASL/SCRAM")

@enduml