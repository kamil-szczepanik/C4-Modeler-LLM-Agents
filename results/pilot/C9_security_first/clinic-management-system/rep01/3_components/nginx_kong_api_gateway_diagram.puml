@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the NGINX/Kong API Gateway container

Container_Boundary(api_gateway_boundary, "NGINX/Kong API Gateway") {
    Component(api_gateway_perimeter_security_router, "API Gateway Perimeter Security Router", "Kong, Kubernetes Ingress", "Handles perimeter security, WAF, routing, and JWT validation.")
}

System_Ext(patient_service, "Patient Service", "Java, Spring Boot, gRPC")
System_Ext(scheduling_service, "Scheduling Service", "Java, Spring Boot, gRPC")
System_Ext(emr_service, "EMR Service", "Java, Spring Boot, gRPC")
System_Ext(billing_service, "Billing Service", "Java, Spring Boot, gRPC")

Rel(api_gateway_perimeter_security_router, patient_service, "Routes internal requests", "gRPC, mTLS")
Rel(api_gateway_perimeter_security_router, scheduling_service, "Routes internal requests", "gRPC, mTLS")
Rel(api_gateway_perimeter_security_router, emr_service, "Routes internal requests", "gRPC, mTLS")
Rel(api_gateway_perimeter_security_router, billing_service, "Routes internal requests", "gRPC, mTLS")

@enduml