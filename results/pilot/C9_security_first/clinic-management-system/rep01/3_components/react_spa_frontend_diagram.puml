@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the React SPA Frontend container

Container_Boundary("react_spa_frontend", "React SPA Frontend") {
    Component("Authentication Context", "Authentication Context", "React Context, OAuth2/OIDC", "Manages user authentication state, secure login flows, and MFA integration.")
    Component("Routing & Layout Engine", "Routing & Layout Engine", "React Router, TypeScript", "Handles client-side routing, code-splitting, lazy loading, and core layout rendering.")
    Component("EMR Workspace Module", "EMR Workspace Module", "React, TypeScript, IndexedDB with AES-GCM", "Provides the primary interface for clinicians to view and update electronic medical records with offline resilience.")
    Component("Scheduling & Billing Views", "Scheduling & Billing Views", "React, TypeScript", "Enables receptionists and billing specialists to manage appointments, admissions, and process bills.")
    Component("API Client Layer", "API Client Layer", "Axios, Fetch API, JWT", "Encapsulates communication with the NGINX/Kong API Gateway via HTTPS/WSS with token-based authentication.")
}

Rel("Routing & Layout Engine", "EMR Workspace Module", "Renders dynamically via lazy loading", "")
Rel("Routing & Layout Engine", "Scheduling & Billing Views", "Renders navigation views", "")
Rel("EMR Workspace Module", "API Client Layer", "Sends EMR queries and mutations", "")
Rel("Scheduling & Billing Views", "API Client Layer", "Sends scheduling and billing requests", "")
Rel("Authentication Context", "API Client Layer", "Injects JWT authorization headers", "")

@enduml