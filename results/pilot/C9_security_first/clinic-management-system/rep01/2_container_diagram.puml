@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Patients, "Patients", "Individuals receiving care who access the portal for appointments and records.")
Person(Receptionists, "Receptionists", "Front-desk staff handling patient admissions and scheduling.")
Person(Clinicians, "Clinicians", "Medical professionals managing electronic medical records and clinical workflows.")
Person(Billing Specialists, "Billing Specialists", "Financial staff managing billing and insurance claims.")

System_Ext(Third-Party Lab & Imaging Systems, "Third-Party Lab & Imaging Systems", "External diagnostic systems for lab results and medical imaging.")
System_Ext(External Payment Gateways, "External Payment Gateways", "External services processing patient payments.")
System_Ext(Insurance Clearinghouses, "Insurance Clearinghouses", "External systems processing insurance claims and verification.")

System_Boundary(Clinic_Management_System, "Clinic Management System") {
    Container(React SPA Frontend, "React SPA Frontend", "React, CDN/Nginx", "Provides the user interface for patients, receptionists, clinicians, and billing specialists.")
    Container(NGINX/Kong API Gateway, "NGINX/Kong API Gateway", "NGINX/Kong", "Handles single entry point, token exchange, routing, and security enforcement.")
    Container(Patient Service, "Patient Service", "Java, Spring Boot, gRPC", "Manages patient admissions and profile data.")
    Container(Scheduling Service, "Scheduling Service", "Java, Spring Boot, gRPC", "Manages appointment scheduling and calendar workflows.")
    Container(EMR Service, "EMR Service", "Java, Spring Boot, gRPC", "Manages electronic medical records with sub-second performance SLAs.")
    Container(Billing Service, "Billing Service", "Java, Spring Boot, gRPC", "Manages billing, payments, and financial processing.")
    Container(Apache Camel Integration Service, "Apache Camel Integration Service", "Apache Camel", "Handles HL7 FHIR translation and integration with external systems.")
    ContainerDb(Distributed PostgreSQL Database, "Distributed PostgreSQL Database", "PostgreSQL, Active-Active Hybrid Replication", "Provides distributed, partitioned transactional storage with AES-256 encryption.")
    Container(Apache Kafka Event Broker, "Apache Kafka Event Broker", "Apache Kafka, SASL/SCRAM", "Enables resilient asynchronous event streaming between microservices.")
}

Rel(Patients, React SPA Frontend, "Accesses portal, schedules appointments, and views records", "HTTPS/WSS, OAuth2/OIDC, MFA")
Rel(Receptionists, React SPA Frontend, "Manages patient admissions and scheduling", "HTTPS/WSS, OAuth2/OIDC, MFA")
Rel(Clinicians, React SPA Frontend, "Updates electronic medical records and clinical workflows", "HTTPS/WSS, OAuth2/OIDC, MFA")
Rel(Billing Specialists, React SPA Frontend, "Processes bills and claims", "HTTPS/WSS, OAuth2/OIDC, MFA")
Rel(React SPA Frontend, NGINX/Kong API Gateway, "Sends API requests", "HTTPS/WSS, OAuth2/OIDC, MFA")
Rel(NGINX/Kong API Gateway, Patient Service, "Routes requests via service mesh", "gRPC with mTLS")
Rel(NGINX/Kong API Gateway, Scheduling Service, "Routes requests via service mesh", "gRPC with mTLS")
Rel(NGINX/Kong API Gateway, EMR Service, "Routes requests via service mesh", "gRPC with mTLS")
Rel(NGINX/Kong API Gateway, Billing Service, "Routes requests via service mesh", "gRPC with mTLS")
Rel(Apache Camel Integration Service, Third-Party Lab & Imaging Systems, "Exchanges clinical data", "HL7 FHIR APIs over TLS")
Rel(Apache Camel Integration Service, External Payment Gateways, "Processes financial transactions", "HL7 FHIR APIs over TLS / Secure Webhooks")
Rel(Apache Camel Integration Service, Insurance Clearinghouses, "Submits and tracks insurance claims", "HL7 FHIR APIs over TLS")
Rel(Patient Service, Apache Kafka Event Broker, "Streams domain events", "SASL/SCRAM authenticated event streaming")
Rel(Scheduling Service, Apache Kafka Event Broker, "Streams domain events", "SASL/SCRAM authenticated event streaming")
Rel(EMR Service, Apache Kafka Event Broker, "Streams domain events", "SASL/SCRAM authenticated event streaming")
Rel(Billing Service, Apache Kafka Event Broker, "Streams domain events", "SASL/SCRAM authenticated event streaming")
Rel(Patient Service, Distributed PostgreSQL Database, "Persists transactional data", "AES-256 encrypted persistent volumes with schema-per-service")
Rel(Scheduling Service, Distributed PostgreSQL Database, "Persists transactional data", "AES-256 encrypted persistent volumes with schema-per-service")
Rel(EMR Service, Distributed PostgreSQL Database, "Persists transactional data", "AES-256 encrypted persistent volumes with schema-per-service")
Rel(Billing Service, Distributed PostgreSQL Database, "Persists transactional data", "AES-256 encrypted persistent volumes with schema-per-service")

@enduml