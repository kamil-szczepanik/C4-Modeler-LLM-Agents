@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Clinic Management System

Person(Patients, "Patients", "Individuals receiving care who access the portal for appointments and records.")
Person(Receptionists, "Receptionists", "Front-desk staff handling patient admissions and scheduling.")
Person(Clinicians, "Clinicians", "Medical professionals managing electronic medical records and clinical workflows.")
Person(BillingSpecialists, "Billing Specialists", "Financial staff managing billing and insurance claims.")

System(ClinicManagementSystem, "Clinic Management System", "A hybrid cloud clinical IT platform designed to handle patient admissions, electronic medical records, appointment scheduling, and billing for medium-sized hospitals and clinics.")

System_Ext(ThirdPartyLabImagingSystems, "Third-Party Lab & Imaging Systems", "External diagnostic systems for lab results and medical imaging.")
System_Ext(ExternalPaymentGateways, "External Payment Gateways", "External services processing patient payments.")
System_Ext(InsuranceClearinghouses, "Insurance Clearinghouses", "External systems processing insurance claims and verification.")

Rel(Patients, ClinicManagementSystem, "Accesses portal, schedules appointments, and views records", "HTTPS/TLS 1.3, OAuth 2.0 / OpenID Connect, MFA")
Rel(Receptionists, ClinicManagementSystem, "Manages patient admissions and scheduling", "HTTPS/TLS 1.3, OAuth 2.0 / OpenID Connect, MFA")
Rel(Clinicians, ClinicManagementSystem, "Updates electronic medical records and clinical workflows", "HTTPS/TLS 1.3, OAuth 2.0 / OpenID Connect, MFA")
Rel(BillingSpecialists, ClinicManagementSystem, "Processes bills and claims", "HTTPS/TLS 1.3, OAuth 2.0 / OpenID Connect, MFA")
Rel(ClinicManagementSystem, ThirdPartyLabImagingSystems, "Exchanges clinical data", "HL7 FHIR over RESTful APIs")
Rel(ClinicManagementSystem, ExternalPaymentGateways, "Processes financial transactions", "HTTPS, Secure Webhooks")
Rel(ClinicManagementSystem, InsuranceClearinghouses, "Submits and tracks insurance claims", "HTTPS, Secure Webhooks")
@enduml