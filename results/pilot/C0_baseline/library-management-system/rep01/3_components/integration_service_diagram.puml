@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Service container

Container_Boundary(integration_service, "Integration Service") {
    Component(Webhook_Receiver, "Webhook Receiver", "FastAPI", "Provides high-performance API endpoints for webhook ingestion with schema validation and invokes updates to the core service.")
    Component(Task_Dispatcher, "Task Dispatcher", "Celery", "Coordinates asynchronous jobs and background task execution via message broker queues.")
    Component(Provider_Adapters_Module, "Provider Adapters Module", "Python", "Synchronizes data with external digital content providers via outbound egress filtering.")
    Component(Sync_State_Manager, "Sync State Manager", "Python", "Tracks transaction state and patron metadata with column-level encryption.")
    Component(Redis_Cache_Tier, "Redis Cache Tier", "Redis", "Acts as the message broker with persistence enabled (AOF/RDB) for Celery queues.")
}

Component_Ext(Core_Circulation___Catalog_Service, "Core Circulation & Catalog Service", "Java/Spring Boot", "External core service that receives updates via gRPC over mTLS.")
Component_Ext(PostgreSQL_Database_Cluster, "PostgreSQL Database Cluster", "PostgreSQL", "Stores transaction states and patron metadata with column-level encryption.")
Component_Ext(External_Payment_Gateways, "External Payment Gateways", "HTTPS", "External provider handling payment processing and callback events.")
Component_Ext(OverDrive_and_JSTOR_Digital_Content_Providers, "OverDrive and JSTOR Digital Content Providers", "HTTPS, TLS 1.3", "External digital content providers synchronized via outbound egress filtering.")

Rel(Webhook_Receiver, Core_Circulation___Catalog_Service, "Invokes updates via gRPC over mTLS", "gRPC over TLS, mTLS")
Rel(Task_Dispatcher, Redis_Cache_Tier, "Coordinates asynchronous jobs via message broker queues", "Redis Protocol")
Rel(Provider_Adapters_Module, OverDrive_and_JSTOR_Digital_Content_Providers, "Synchronizes data via outbound egress filtering", "HTTPS, TLS 1.3")
Rel(Webhook_Receiver, External_Payment_Gateways, "Receives callback events", "Webhooks, HTTPS")
Rel(Sync_State_Manager, PostgreSQL_Database_Cluster, "Tracks transaction state with column-level encryption", "PostgreSQL Protocol, TLS")

@enduml