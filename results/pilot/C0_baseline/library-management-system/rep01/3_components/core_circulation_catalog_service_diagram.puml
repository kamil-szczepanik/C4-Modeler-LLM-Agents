@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Circulation & Catalog Service container

Container_Boundary(core_circulation_catalog_service, "Core Circulation & Catalog Service") {
    Component(CatalogManager, "CatalogManager", "Java / Spring Boot", "Metadata handling for physical and digital library items.")
    Component(CirculationEngine, "CirculationEngine", "Java / Spring Boot", "Loan workflows and fine calculations.")
    Component(FinePolicyEngine, "FinePolicyEngine", "Java / Spring Boot", "Modular loan policies and fine rules.")
    Component(InventoryRepository, "InventoryRepository", "Spring Data JPA", "Data persistence layer interacting with the PostgreSQL Database Cluster.")
    Component(ExternalSyncAdapter, "ExternalSyncAdapter", "Spring Cloud Circuit Breaker", "Digital provider integration for external vendors like OverDrive and JSTOR.")
}

Rel(CirculationEngine, FinePolicyEngine, "Applies loan policies and calculates fines")
Rel(CirculationEngine, InventoryRepository, "Persists loan and inventory state")
Rel(CatalogManager, InventoryRepository, "Persists catalog metadata")
Rel(CirculationEngine, ExternalSyncAdapter, "Synchronizes digital items and provider data")
@enduml