@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Web Application Frontend container

Container_Boundary(web_app_frontend, "Web Application Frontend") {
    Component(search_discovery, "Search & Discovery Module", "React/TypeScript SPA", "Provides cataloging and search functionalities meeting sub-800ms search responses.")
    Component(circulation_management, "Circulation Management Module", "React/TypeScript SPA", "Handles circulation operations and self-service portals for library patrons and staff.")
    Component(admin_dashboard, "Admin Configuration Dashboard", "React/TypeScript SPA", "Enables administration and configuration settings for library administrators.")
}

System_Ext(mobile_api_gateway, "Mobile API Gateway", "Node.js/Express")
System_Ext(auth_service, "Authentication & Session Service", "Node.js")

Rel(search_discovery, mobile_api_gateway, "API requests", "HTTPS/REST")
Rel(circulation_management, mobile_api_gateway, "API requests", "HTTPS/REST")
Rel(admin_dashboard, mobile_api_gateway, "API requests", "HTTPS/REST")

Rel(search_discovery, auth_service, "Session management with HTTP-only cookies", "HTTPS")
Rel(circulation_management, auth_service, "Session management with HTTP-only cookies", "HTTPS")
Rel(admin_dashboard, auth_service, "Session management with HTTP-only cookies", "HTTPS")

@enduml