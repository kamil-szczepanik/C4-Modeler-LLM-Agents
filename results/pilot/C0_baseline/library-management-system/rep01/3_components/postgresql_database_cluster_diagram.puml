@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL Database Cluster container

Container_Boundary(postgres_database_cluster, "PostgreSQL Database Cluster") {
    Component(primary_transactional_write_engine, "Primary transactional write engine", "PostgreSQL", "Primary transactional storage ensuring strict ACID compliance.")
    Component(dedicated_read_replica_nodes, "Dedicated read replica nodes", "PostgreSQL", "Read replica nodes for scaling read queries.")
    Component(pgbouncer, "PgBouncer", "PgBouncer", "Connection proxy component providing connection pooling and request queuing.")
    Component(patroni, "Patroni", "Patroni consensus agent", "Automated failover orchestration and distributed consensus for high availability.")
}

Rel(pgbouncer, primary_transactional_write_engine, "Routes write requests", "PostgreSQL wire protocol via mTLS")
Rel(pgbouncer, dedicated_read_replica_nodes, "Routes read queries", "PostgreSQL wire protocol via mTLS")
Rel(patroni, primary_transactional_write_engine, "Manages failover orchestration and distributed consensus", "")
@enduml