@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Mobile API Gateway container

Container_Boundary("Mobile API Gateway", "Mobile API Gateway") {
    Component(Request_Router___Rate_Limiter, "Request Router & Rate Limiter", "Node.js/Express", "Optimizes request routing and enforces rate limits for incoming traffic.")
    Component(GraphQL_REST_Adapter, "GraphQL/REST Adapter", "Node.js/Express", "Adapts incoming API requests between GraphQL and REST protocols.")
    Component(JWT_Validation_Middleware, "JWT Validation Middleware", "Node.js/Express Middleware", "Enforces zero-trust security by validating JSON Web Tokens.")
    Component(Telemetry_Interceptor, "Telemetry Interceptor", "OpenTelemetry", "Handles distributed tracing and performance metrics collection.")
    Component(WebSocket_Connection_Manager, "WebSocket Connection Manager", "Node.js WebSockets", "Manages real-time bidirectional connections for clients.")
    Component(Sync_Orchestration_Component, "Sync Orchestration Component", "Node.js/SQLite/LevelDB", "Supports offline-first synchronization and manages sync queues.")
    Component(Feature_Flag_Resolution_Engine, "Feature Flag Resolution Engine", "Node.js/Redis", "Resolves feature flag states dynamically for client applications.")
}

System_Ext(Search_Aggregator, "Search Aggregator", "External search service")
System_Ext(Core_Circulation___Catalog_Service, "Core Circulation & Catalog Service", "External circulation service")
System_Ext(Redis_Cache_Tier, "Redis Cache Tier", "External cache tier")

Rel(Request_Router___Rate_Limiter, GraphQL_REST_Adapter, "Routes requests to", "")
Rel(GraphQL_REST_Adapter, JWT_Validation_Middleware, "Authenticates requests via", "")
Rel(JWT_Validation_Middleware, Telemetry_Interceptor, "Monitored by", "")
Rel(Request_Router___Rate_Limiter, Search_Aggregator, "Communicates via gRPC over TLS", "gRPC over TLS, mTLS")
Rel(Request_Router___Rate_Limiter, Core_Circulation___Catalog_Service, "Communicates via gRPC over TLS", "gRPC over TLS, mTLS")
Rel(Feature_Flag_Resolution_Engine, Redis_Cache_Tier, "Manages session state and feature flags", "TCP")

@enduml