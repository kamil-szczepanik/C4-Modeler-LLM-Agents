@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Redis Cache Tier container

System_Ext(core_service, "Core Circulation & Catalog Service", "Java/Spring Boot service consuming cache")
System_Ext(search_aggregator, "Search Aggregator", "Node.js/GraphQL service executing faceted queries")
System_Ext(auth_service, "Authentication & Session Service", "Node.js service managing session tokens")
System_Ext(prometheus, "Prometheus", "Monitoring system")

Container_Boundary(redis_cache_tier, "Redis Cache Tier") {
    Component(redis_core, "Redis OSS Core Engine", "Redis OSS v7.2, Redis Cluster Topology", "Provides high-speed, low-latency in-memory data storage, cluster management, zero-data-loss failover, and AOF persistence with encrypted EBS.")
    Component(redis_modules, "Redis JSON and Search Modules", "Redis JSON & Search Modules", "Enables complex faceted catalog queries and advanced data structures directly in memory.")
    Component(security, "Security and Access Control", "Mutual TLS (mTLS) & Redis 6+ ACLs", "Secures wire protocol traffic and enforces strict cross-service access control and EU compliance.")
    Component(exporter, "Prometheus Redis Exporter", "Prometheus Redis exporter, OpenTelemetry collector", "Scrapes and exposes operational metrics such as memory fragmentation and eviction rates.")
}

Rel(core_service, redis_core, "Queries cache and triggers pub/sub invalidations", "Redis Protocol over TCP port 6379")
Rel(search_aggregator, redis_modules, "Executes faceted queries and utilizes client-side caching", "Redis Protocol over TCP port 6379")
Rel(auth_service, redis_core, "Manages session tokens via Redis Hashes", "Redis Protocol over TCP port 6379")
Rel(exporter, prometheus, "Scrapes metrics (memory fragmentation, eviction rates)", "HTTP")

@enduml