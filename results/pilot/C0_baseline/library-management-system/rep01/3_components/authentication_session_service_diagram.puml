@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Authentication & Session Service container

System_Ext(InstitutionalSSOProviders, "Institutional SSO Providers", "External identity providers.")
System_Ext(CoreCirculationCatalogService, "Core Circulation & Catalog Service", "External service validating sessions via gRPC over TLS with mTLS.")
System_Ext(MobileAPIGateway, "Mobile API Gateway", "External gateway querying session state via gRPC over TLS.")

Container_Boundary(AuthSessionService, "Authentication & Session Service") {
    Component(OIDCSAMLFederationAdapter, "OIDC/SAML Federation Adapter", "Passport.js", "Component using Passport.js for institutional SSO.")
    Component(LocalCredentialVerifier, "Local Credential Verifier", "Argon2id", "Component using Argon2id for public patron passwords.")
    Component(SessionManager, "Session Manager", "Redis", "Component using Redis for token state validation and session handling.")
    Component(RBACAuthorizationEngine, "RBAC Authorization Engine", "Casbin", "Component using Casbin for fine-grained permission enforcement.")
}

Rel(OIDCSAMLFederationAdapter, InstitutionalSSOProviders, "Authenticates via HTTPS using SAML 2.0 and OIDC.", "HTTPS")
Rel(CoreCirculationCatalogService, SessionManager, "Validates sessions via gRPC over TLS with mTLS.", "gRPC over TLS")
Rel(MobileAPIGateway, SessionManager, "Queries session state via gRPC over TLS.", "gRPC over TLS")

@enduml