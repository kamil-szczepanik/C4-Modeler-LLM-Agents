@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(LibraryPatronsAndStaff, "Library Patrons & Staff", "Users who interact with the system for circulation, cataloging, and self-service portals.")
Person(LibraryAdministrators, "Library Administrators", "Users who manage and administer the platform with elevated privileges.")

System(LibraryManagementSystem, "Library Management System", "A comprehensive platform designed for public and academic libraries to catalogue physical and digital items, manage circulation, and provide self-service portals with strict EU-only data residency.")

System_Ext(ExternalPaymentGateways, "External Payment Gateways", "External services used to process financial transactions.")
System_Ext(ExternalDigitalContentProvidersOverDriveJSTOR, "External Digital Content Providers (OverDrive, JSTOR)", "External providers supplying digital books, articles, and media content.")
System_Ext(InstitutionalSSOProviders, "Institutional SSO Providers", "External identity providers used for authentication.")
System_Ext(ElasticsearchOpenSearch, "Elasticsearch / OpenSearch", "Manages the catalogue search tier to satisfy high-performance search SLAs.")
System_Ext(Terraform, "Terraform", "Enforces automated residency guardrails within Frankfurt and Dublin cloud availability zones.")
System_Ext(OpenTelemetry, "OpenTelemetry", "Provides distributed tracing across API gateways and search clusters.")

Rel(LibraryPatronsAndStaff, LibraryManagementSystem, "Interact via TLS 1.3 / OAuth 2.0 with OIDC", "TLS 1.3, OAuth 2.0, OIDC")
Rel(LibraryAdministrators, LibraryManagementSystem, "Authenticate via SAML 2.0 / OIDC with hardware-backed MFA", "SAML 2.0, OIDC, Hardware-backed MFA")
Rel(LibraryManagementSystem, ExternalPaymentGateways, "Integrates for payment processing", "REST APIs, HTTPS")
Rel(LibraryManagementSystem, ExternalDigitalContentProvidersOverDriveJSTOR, "Integrates to access digital content", "REST APIs, HTTPS")
Rel(LibraryManagementSystem, InstitutionalSSOProviders, "Authenticates users via institutional identity providers", "SAML 2.0, OIDC")
Rel(LibraryManagementSystem, ElasticsearchOpenSearch, "Queries catalogue search tier", "REST APIs, HTTPS")

@enduml