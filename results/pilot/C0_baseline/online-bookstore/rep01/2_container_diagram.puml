@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Online Bookstore

Person(Customers, "Customers", "End-users browsing the catalogue, making purchases, and managing orders.")
Person(Administrators, "Administrators", "System administrators managing platform operations, catalogue data, and system configurations.")

System_Ext(Third_Party_Shipping_Providers, "Third-Party Shipping Providers", "External logistics and shipping partners handling order delivery.")
System_Ext(Payment_Gateway_APIs, "Payment Gateway APIs", "External payment processors handling PCI-DSS compliant checkout.")
System_Ext(Global_Tax_and_Currency_Conversion_Service, "Global Tax and Currency Conversion Service", "External financial service for global tax calculation and currency conversion.")
System_Ext(Transactional_Email_and_SMS_Service_Provider, "Transactional Email and SMS Service Provider", "External messaging service for notifications.")

System_Boundary(Online_Bookstore, "Online Bookstore") {
    Container(React_Single_Page_Application, "React Single Page Application", "React, Amazon CloudFront, AWS WAF", "Client-side single page application serving users with optimized global delivery.")
    Container(ECS_Fargate_Go_Microservices, "ECS Fargate Go Microservices", "Go, Amazon ECS Fargate, gRPC", "Backend container tier handling business logic, order fulfillment, and notifications.")
    ContainerDb(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL", "Amazon Aurora PostgreSQL", "ACID-compliant transactional database for core application data.")
    ContainerDb(AWS_DynamoDB, "AWS DynamoDB", "AWS DynamoDB", "High-velocity catalogue and recommendation database.")
    Container(Amazon_SQS_SNS, "Amazon SQS & SNS", "Amazon SQS, Amazon SNS", "Event-driven messaging service for asynchronous workflows.")
    ContainerDb(Redis, "Redis", "Redis", "Caching layer for currency and exchange rate data.")
}

Rel(Customers, React_Single_Page_Application, "Interacts with the application via secure edge connection", "HTTPS (TLS 1.3), Amazon CloudFront, AWS WAF")
Rel(Administrators, React_Single_Page_Application, "Manages platform operations", "HTTPS")
Rel(React_Single_Page_Application, ECS_Fargate_Go_Microservices, "Communicates for backend operations and API requests", "HTTPS, gRPC")
Rel(ECS_Fargate_Go_Microservices, Amazon_Aurora_PostgreSQL, "Persists and queries transactional data", "TLS 1.3, AES-256")
Rel(ECS_Fargate_Go_Microservices, AWS_DynamoDB, "Reads and writes catalogue and recommendation data", "TLS 1.3, AES-256")
Rel(ECS_Fargate_Go_Microservices, Amazon_SQS_SNS, "Publishes and consumes asynchronous events for order fulfillment and notifications", "AWS SDK")
Rel(ECS_Fargate_Go_Microservices, Redis, "Reads exchange rates and currency caching", "Redis Protocol")
Rel(ECS_Fargate_Go_Microservices, Third_Party_Shipping_Providers, "Dispatches shipping orders via restricted egress", "HTTPS REST APIs")
Rel(ECS_Fargate_Go_Microservices, Payment_Gateway_APIs, "Processes secure payments via restricted egress", "HTTPS REST APIs")
Rel(ECS_Fargate_Go_Microservices, Global_Tax_and_Currency_Conversion_Service, "Retrieves tax rates and currency conversion data", "HTTPS REST APIs")
Rel(ECS_Fargate_Go_Microservices, Transactional_Email_and_SMS_Service_Provider, "Dispatches emails and SMS notifications", "SMTP, HTTPS APIs")

@enduml