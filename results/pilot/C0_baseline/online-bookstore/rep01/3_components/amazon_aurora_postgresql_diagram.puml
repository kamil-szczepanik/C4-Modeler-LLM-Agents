@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(ECS_Fargate_Go_Microservices, "ECS Fargate Go Microservices", "External client services")
System_Ext(Amazon_S3, "Amazon S3", "Object storage service")

Container_Boundary(Amazon_Aurora_PostgreSQL, "Amazon Aurora PostgreSQL") {
    Component(Amazon_Aurora_PostgreSQL_Primary_Write_Instance, "Amazon Aurora PostgreSQL Primary Write Instance", "PostgreSQL 15 engine", "Serves as the transactional backbone for secure order processing, inventory tracking, and multi-currency support with ACID compliance.")
    Component(Amazon_Aurora_PostgreSQL_Read_Replicas, "Amazon Aurora PostgreSQL Read Replicas", "Distributed PostgreSQL 15 Engine", "Distributed across Availability Zones to support read workloads and high availability.")
    Component(PgBouncer_Connection_Pooling_Sidecar, "PgBouncer Connection Pooling Sidecar", "PgBouncer", "Manages and pools database connections to handle high-volume microservice requests.")
    Component(AWS_Secrets_Manager, "AWS Secrets Manager", "AWS Secrets Manager", "Manages automated 30-day credential rotation.")
    Component(AWS_Key_Management_Service__AWS_KMS_, "AWS Key Management Service (AWS KMS)", "AWS KMS", "Provides Transparent Data Encryption (TDE) via Customer Managed Keys.")
    Component(Amazon_CloudWatch_and_RDS_Data_Protection, "Amazon CloudWatch and RDS Data Protection", "Amazon CloudWatch", "Streams performance metrics, audit logs, and monitors data protection.")
}

Rel(ECS_Fargate_Go_Microservices, PgBouncer_Connection_Pooling_Sidecar, "Manages database connections", "TCP")
Rel(PgBouncer_Connection_Pooling_Sidecar, Amazon_Aurora_PostgreSQL_Primary_Write_Instance, "Executes queries and transactions", "TCP, TLS 1.3, mTLS")
Rel(Amazon_Aurora_PostgreSQL_Primary_Write_Instance, Amazon_S3, "Stores continuous point-in-time backups", "HTTPS")
Rel(Amazon_Aurora_PostgreSQL_Primary_Write_Instance, Amazon_CloudWatch_and_RDS_Data_Protection, "Streams performance metrics and audit logs", "HTTPS")
@enduml