@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(amazon_sqs_sns, "Amazon SQS & SNS") {
    Component(Amazon_SNS_Topics, "Amazon SNS Topics", "Amazon SNS", "Fan-out publishing for domain events (OrderEvents, InventoryEvents, NotificationEvents).")
    Component(Amazon_SQS_Queues, "Amazon SQS Queues", "Amazon SQS", "Point-to-point ingestion and buffering (Fulfillment Queue, Notification Queue, SQS FIFO queues).")
    Component(Dead_Letter_Queues_DLQs_, "Dead-Letter Queues (DLQs)", "Amazon SQS DLQ", "Poisoned payload isolation with a maxReceiveCount of 3.")
}

Rel(Amazon_SNS_Topics, Amazon_SQS_Queues, "Fans out asynchronous events", "AWS SNS-SQS Subscriptions")
Rel(Amazon_SQS_Queues, Dead_Letter_Queues_DLQs_, "Buffers failed messages", "AWS SQS Redrive Policy")

@enduml