@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(ecs_fargate_go_microservices, "ECS Fargate Go Microservices") {
    Component(http_grpc_api_routers, "HTTP/gRPC API Routers", "Go, gRPC, HTTP", "Handles incoming requests from clients and internal microservices.")
    Component(domain_handlers, "Domain Handlers", "Go", "Processes domain-specific requests and coordinates workflows.")
    Component(business_logic_services, "Business Logic Services", "Go (Goroutines)", "Contains the core business logic, order fulfillment, and notification handling.")
    Component(data_access_repositories, "Data Access Repositories", "Go, SQL, AWS SDK", "Manages persistence operations for databases and caches.")
    Component(event_consumers, "Event Consumers", "Go, Amazon SQS, Amazon SNS", "Consumes and produces asynchronous messages and events.")
    Component(outbound_adapters, "Outbound Adapters", "Go, HTTPS REST APIs", "Communicates with external integrations like payment gateways and shipping providers.")
}

Rel(http_grpc_api_routers, domain_handlers, "Routes requests to")
Rel(domain_handlers, business_logic_services, "Invokes business rules")
Rel(business_logic_services, data_access_repositories, "Reads and writes data via")
Rel(business_logic_services, event_consumers, "Triggers and handles events")
Rel(business_logic_services, outbound_adapters, "Calls external APIs via")

@enduml