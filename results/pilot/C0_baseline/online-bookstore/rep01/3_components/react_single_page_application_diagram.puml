@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the React Single Page Application container

System_Ext(ecs_microservices, "ECS Fargate Go Microservices", "Backend microservices providing APIs for the bookstore platform.")

Container_Boundary(react_spa, "React Single Page Application") {
    Component(catalogue_module, "Catalogue Module", "React 18, Tailwind CSS", "Delivers responsive catalogue browsing and product discovery across multiple currencies and regions.")
    Component(cart_module, "Cart Module", "React 18, Redux Toolkit, React Query", "Manages user shopping carts, item persistence, and state caching.")
    Component(checkout_module, "Checkout Module", "React 18, React Query", "Handles secure checkout flows and user payment processing interactions.")
    Component(admin_module, "Administration Module", "React 18, React Router", "Provides internal administrative operations for managing inventory, orders, and review moderation.")
    Component(routing_security, "Routing and Security Layer", "React Router, DOMPurify", "Enforces strict separation between customer and admin views and sanitizes data to prevent XSS.")
}

Rel(catalogue_module, ecs_microservices, "Fetches product catalogue data", "gRPC-Web over HTTPS")
Rel(cart_module, ecs_microservices, "Synchronizes cart state", "gRPC-Web over HTTPS")
Rel(checkout_module, ecs_microservices, "Submits orders and payment data", "gRPC-Web over HTTPS")
Rel(admin_module, ecs_microservices, "Manages inventory and orders", "gRPC-Web over HTTPS")
Rel(routing_security, catalogue_module, "Directs navigation and renders", "")
Rel(routing_security, cart_module, "Directs navigation and renders", "")
Rel(routing_security, checkout_module, "Directs navigation and renders", "")
Rel(routing_security, admin_module, "Enforces route segregation and renders", "")

@enduml