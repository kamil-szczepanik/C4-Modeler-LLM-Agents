@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Redis container

Container_Boundary(Redis, "Redis") {
    Component(In_Memory_Data_Store_Engine, "In-Memory Data Store Engine", "Redis Hash data structures", "Provides ultra-fast, in-memory currency exchange rate lookups using Redis Hash data structures.")
    Component(Eviction_Policy_Manager, "Eviction Policy Manager", "volatile-lru with TTL", "Manages data eviction using volatile-lru strategy with Time-To-Live settings.")
    Component(Replication_Persistence_Module, "Replication & Persistence Module", "AOF persistence, asynchronous master-replica", "Handles data persistence via AOF and manages asynchronous master-replica replication.")
    Component(Amazon_ElastiCache, "Amazon ElastiCache", "Multi-AZ with automatic failover", "Managed Redis service providing Multi-AZ high availability and automated failover.")
    Component(ECS_Fargate_Go_Microservices, "ECS Fargate Go Microservices", "Go", "Microservices that read currency exchange rates via Redis Serialization Protocol.")
    Component(AWS_KMS, "AWS KMS", "Customer-managed keys", "Encrypts data at rest using customer-managed keys for compliance and data protection.")
    Component(CloudWatch, "CloudWatch", "AWS Monitoring", "Collects and monitors metrics including DatabaseMemoryUsagePercentage and EngineCPUUtilization.")
}

Rel(ECS_Fargate_Go_Microservices, In_Memory_Data_Store_Engine, "Reads currency exchange rates via Redis Serialization Protocol (RESP) over TCP with TLS.", "RESP / TCP / TLS")
Rel(In_Memory_Data_Store_Engine, AWS_KMS, "Encrypts data at rest using customer-managed keys.", "API")
Rel(Amazon_ElastiCache, CloudWatch, "Exports metrics including DatabaseMemoryUsagePercentage and EngineCPUUtilization.", "AWS API")

@enduml