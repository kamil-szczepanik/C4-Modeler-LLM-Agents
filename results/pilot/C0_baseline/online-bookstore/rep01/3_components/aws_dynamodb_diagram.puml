@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AWS DynamoDB container

Container_Boundary(aws_dynamodb, "AWS DynamoDB") {
    Component(AWS_DynamoDB_Core_Tables, "AWS DynamoDB Core Tables", "AWS DynamoDB", "Primary storage for catalogue, reviews, and recommendations.")
    Component(DynamoDB_Accelerator__DAX_, "DynamoDB Accelerator (DAX)", "DynamoDB Accelerator (DAX)", "In-memory caching layer for high-velocity queries.")
    Component(DynamoDB_Table_Partitions, "DynamoDB Table Partitions", "DynamoDB Partitions", "Logical data partitions managed via consistent hashing.")
    Component(DynamoDB_Global_Secondary_Indexes__GSIs_, "DynamoDB Global Secondary Indexes (GSIs)", "AWS DynamoDB GSI", "Optimized indexes for flexible keyword searches.")
    Component(DynamoDB_Streams, "DynamoDB Streams", "AWS DynamoDB Streams", "Change data capture mechanism for asynchronous event propagation.")
    Component(AWS_KMS, "AWS KMS", "AWS KMS (CMK)", "Provides mandatory AES-256 storage and transit encryption.")
    Component(AWS_IAM, "AWS IAM", "AWS IAM (SigV4)", "Enforces fine-grained access control using SigV4 signing and dynamodb:LeadingKeys.")
    Component(AWS_DynamoDB_Global_Tables, "AWS DynamoDB Global Tables", "AWS DynamoDB Global Tables", "Replicates data across us-east-1, eu-west-1, and ap-southeast-1.")
}

Rel(DynamoDB_Accelerator__DAX_, AWS_DynamoDB_Core_Tables, "Caches high-velocity queries and data")
Rel(AWS_DynamoDB_Core_Tables, DynamoDB_Table_Partitions, "Organizes data into")
Rel(AWS_DynamoDB_Core_Tables, DynamoDB_Global_Secondary_Indexes__GSIs_, "Indexes data for")
Rel(AWS_DynamoDB_Core_Tables, DynamoDB_Streams, "Triggers change events via")
Rel(AWS_DynamoDB_Core_Tables, AWS_DynamoDB_Global_Tables, "Replicates across regions")

@enduml