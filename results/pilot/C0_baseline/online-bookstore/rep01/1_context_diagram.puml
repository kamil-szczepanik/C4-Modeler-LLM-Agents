@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Customers, "Customers", "End-users browsing the catalogue, making purchases, and managing orders via Web and Mobile clients.")
Person(Administrators, "Administrators", "System administrators managing platform operations, catalogue data, and system configurations.")

System(Online_Bookstore, "Online Bookstore", "An Amazon-style e-commerce platform designed to provide global catalogue browsing, secure multi-currency checkout, and personalized book recommendations with high availability and scalability.")

System_Ext(Third_Party_Shipping_Providers, "Third-Party Shipping Providers", "External logistics and shipping partners handling order delivery.")
System_Ext(Payment_Gateway_APIs, "Payment Gateway APIs", "External payment processors (e.g., Stripe) handling PCI-DSS compliant checkout.")
System_Ext(Global_CDN, "Global CDN", "Edge caching network (e.g., AWS CloudFront) providing fast global content delivery.")
System_Ext(Transactional_Email_and_SMS_Service_Provider, "Transactional Email and SMS Service Provider", "External messaging service (e.g., Amazon SES/SNS) for notifications.")
System_Ext(Global_Tax_and_Currency_Conversion_Service, "Global Tax and Currency Conversion Service", "External financial service (e.g., Avalara) for global tax calculation and currency conversion.")
System_Ext(AWS_DynamoDB_Global_Tables, "AWS DynamoDB Global Tables", "Multi-region distributed database for low-latency state replication.")

Rel(Customers, Global_CDN, "Browsing and accessing the bookstore via secure connection", "HTTPS/TLS 1.3")
Rel(Administrators, Online_Bookstore, "Managing platform operations and administration", "HTTPS")
Rel(Online_Bookstore, Payment_Gateway_APIs, "Processing secure payments for checkout", "HTTPS/REST/JSON")
Rel(Online_Bookstore, Third_Party_Shipping_Providers, "Dispatching and tracking shipping orders", "Webhook and REST/JSON")
Rel(Online_Bookstore, Transactional_Email_and_SMS_Service_Provider, "Sending transactional notifications to users", "SMTP and HTTPS APIs")
Rel(Online_Bookstore, Global_Tax_and_Currency_Conversion_Service, "Calculating taxes and converting currencies", "REST/JSON over TLS 1.3")
Rel(Online_Bookstore, AWS_DynamoDB_Global_Tables, "Persisting and replicating application state", "internal mTLS and AWS KMS")
@enduml