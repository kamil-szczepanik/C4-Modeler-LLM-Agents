@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalysts, "Fraud Analysts", "Investigate flagged transactions and manage cases")

Container_Boundary(CaseManagementPortal, "Case Management Portal") {
    Component(ReactWebUI, "React Web UI", "React, TypeScript", "Powers the analyst web UI for rapid, responsive case triage.")
    Component(NestJSAPIController, "NestJS API Controller", "NestJS, TypeScript", "Provides a structured, scalable REST API controller architecture.")
    Component(CaseService, "Case Service", "TypeScript", "Execute business logic for case resolution.")
    Component(PrismaORM, "Prisma ORM", "Prisma ORM", "Manages type-safe database access and parameterized queries to prevent injection vectors.")
}

System_Ext(AmazonRDSforPostgreSQL, "Amazon RDS for PostgreSQL", "Amazon RDS for PostgreSQL", "Stores relational case data securely with automated Multi-AZ failover and AWS KMS encryption at rest.")
System_Ext(ExternalIdentityProvider, "External Identity Provider", "OIDC/JWT", "Authenticate users and validate tokens.")
System_Ext(AuditStorage, "Audit Storage", "Amazon S3 with S3 Object Lock", "Retrieve historical decision explanations.")

Rel(FraudAnalysts, ReactWebUI, "Investigate flagged transactions and manage cases", "HTTPS/TLS 1.3")
Rel(ReactWebUI, NestJSAPIController, "Invoke REST endpoints and fetch investigation data", "HTTPS/TLS 1.3")
Rel(NestJSAPIController, CaseService, "Execute business logic for case resolution", "In-memory")
Rel(CaseService, PrismaORM, "Query and persist case metadata", "Internal")
Rel(PrismaORM, AmazonRDSforPostgreSQL, "Persist relational case data", "TCP/SSL, TLS 1.3, IAM authentication")
Rel(NestJSAPIController, ExternalIdentityProvider, "Authenticate users and validate tokens", "OIDC/JWT")
Rel(NestJSAPIController, AuditStorage, "Retrieve historical decision explanations", "Secure REST")

@enduml