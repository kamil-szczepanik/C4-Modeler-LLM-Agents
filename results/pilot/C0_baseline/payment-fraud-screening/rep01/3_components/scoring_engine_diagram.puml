@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Scoring Engine container

Container_Boundary(scoring_engine, "Scoring Engine") {
    Component(Request Handler Component, "Request Handler Component", "Go, gRPC", "Handles incoming payment evaluation requests and routes them via gRPC over HTTP/2.")
    Component(Model Evaluator Component, "Model Evaluator Component", "ONNX Runtime, Dual-Buffer Registry", "Executes machine learning models for fraud screening with zero-downtime model hot-swapping via atomic pointer swaps.")
    Component(Feature Aggregator Component, "Feature Aggregator Component", "Concurrent Redis Pipeline", "Performs in-memory feature lookups and velocity checks.")
    Component(Audit Dispatcher Component, "Audit Dispatcher Component", "Amazon SQS, AWS SDK", "Emits asynchronous, KMS-signed audit events.")
}

Rel(Request Handler Component, Feature Aggregator Component, "Fetches features for transactions")
Rel(Request Handler Component, Model Evaluator Component, "Evaluates models for transaction scoring")
Rel(Request Handler Component, Audit Dispatcher Component, "Dispatches audit events for transactions")

@enduml