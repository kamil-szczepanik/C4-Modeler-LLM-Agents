@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(audit_stream_processor, "Audit Stream Processor") {
    Component(KinesisFirehoseDeliveryStream, "Kinesis Firehose Delivery Stream", "Amazon Kinesis Data Firehose", "Ingests raw decision payloads from the Audit Queue and buffers them for batch delivery.")
    Component(EncryptionManager, "Encryption Manager", "AWS KMS", "Encrypts audit data streams and payloads to ensure security and compliance.")
}

Rel(KinesisFirehoseDeliveryStream, EncryptionManager, "Applies encryption via", "")

@enduml