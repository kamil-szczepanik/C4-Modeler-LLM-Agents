@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Feature Store container

Component_Ext(scoring_engine, "Scoring Engine", "External Container", "Performs in-memory feature lookups.")
System_Ext(amazon_s3, "Amazon S3", "AWS Storage", "External storage for asynchronous persistence and audit retention.")

Container_Boundary(feature_store_container, "Feature Store") {
    Component(feature_store, "Feature Store", "AWS ElastiCache Redis Cluster", "Provides low-latency behavioral feature lookups to power real-time fraud scoring for payment authorizations with sub-millisecond retrieval.")
    Component(feature_ingestion_worker, "Feature Ingestion Worker", "Python, Celery", "Ingests real-time transaction streams and updates behavioral aggregates.")
    Component(point_in_time_retrieval_api, "Point-in-Time Retrieval API", "Embedded Redis modules", "Handles point-in-time retrieval requests for features.")
    Component(data_synchronization_service, "Data Synchronization Service", "AWS KMS, HTTPS", "Manages asynchronous persistence for audit retention.")
    Component(schema_registry_component, "Schema Registry Component", "Internal", "Manages data schemas for features and ingestion streams.")
    Component(ttl_management_module, "TTL Management Module", "Redis TTL", "Manages strict memory TTLs for data retention and compliance.")
}

Rel(scoring_engine, feature_store, "Performs in-memory feature lookups", "TCP, Redis RESP, TLS")
Rel(feature_ingestion_worker, feature_store, "Ingests real-time transaction streams and updates behavioral aggregates", "TCP, Redis RESP")
Rel(data_synchronization_service, amazon_s3, "Manages asynchronous persistence for audit retention", "HTTPS, AWS KMS")
@enduml