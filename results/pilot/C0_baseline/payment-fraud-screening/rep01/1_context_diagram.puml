@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FraudAnalysts, "Fraud Analysts", "Internal users reviewing flagged transactions via TLS.")
System_Ext(MerchantIntegrationSystems, "Merchant Integration Systems", "External clients submitting payment authorizations via gRPC/HTTPS.")
System_Ext(IdentityProvider, "Identity Provider", "External OIDC/IAM service for analyst Single Sign-On.")
System_Ext(APIGatewayNetworkLoadBalancerNLB, "API Gateway / Network Load Balancer (NLB)", "AWS managed ingress terminating TLS and routing traffic.")
System_Ext(ScoringEngine, "Scoring Engine", "Containerized microservice processing real-time fraud scoring using cached rule sets.")
System_Ext(CaseManagementPortal, "Case Management Portal", "Web interface for analysts to investigate flagged transactions.")
System_Ext(AuditStorage, "Audit Storage", "AWS S3 with Object Lock and KMS encryption for tamper-evident 7-year retention.")

System(RealTimePaymentFraudScreening, "Real-Time Payment Fraud Screening", "Screens card-not-present payment authorizations for fraud at 3,000 TPS within a sub-50ms P99 latency window and manages suspicious cases for human analysts under PCI-DSS Level 1 constraints.")

Rel(MerchantIntegrationSystems, APIGatewayNetworkLoadBalancerNLB, "Push payment authorizations with mandatory mTLS and OAuth2/JWT validation", "gRPC/HTTPS")
Rel(FraudAnalysts, CaseManagementPortal, "Access review queues over TLS authenticated via OIDC", "TLS / OIDC")
Rel(ScoringEngine, AuditStorage, "Stream cryptographic hash-chained decision logs and inputs via AWS PrivateLink", "AWS PrivateLink")
Rel(ScoringEngine, TokenizationProxy, "Process ephemeral payment payloads to mask Primary Account Numbers (PAN)", "Internal API")

@enduml