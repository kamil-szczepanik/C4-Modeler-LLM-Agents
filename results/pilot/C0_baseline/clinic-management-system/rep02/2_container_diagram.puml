@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Patients, "Patients", "Patients accessing the healthcare platform for scheduling and viewing records.")
Person(Receptionists, "Receptionists", "Receptionists managing patient admissions and scheduling.")
Person(Physicians, "Physicians", "Physicians managing Electronic Medical Records (EMRs) and patient care.")
Person(BillingSpecialists, "Billing Specialists", "Billing specialists managing financial transactions and billing.")

System_Ext(PaymentGateways, "Payment Gateways", "External systems for processing patient payments.")
System_Ext(LabandImagingSystems, "Lab and Imaging Systems", "External medical systems providing lab results and imaging data.")
System_Ext(EnterpriseIDP, "Enterprise IDP", "External identity provider for authentication and token validation.")

System_Boundary(ClinicManagementSystem, "Clinic Management System") {
    Container(APIGateway, "API Gateway", "Go", "Secure entry point and API Gateway for handling incoming traffic.")
    Container(PatientPortalFrontend, "Patient Portal Frontend", "Node.js", "Frontend application providing secure patient portal services.")
    Container(PhysicianEMRFrontend, "Physician EMR Frontend", "React", "Frontend application providing physician EMR interfaces.")
    Container(EMRBackend, "EMR Backend", "Java Spring Boot", "Backend service managing physician EMRs and clinical logic.")
    Container(BillingService, "Billing Service", "Python", "Service managing billing and financial transactions.")
    Container(EventBroker, "Event Broker", "Apache Kafka", "Asynchronous event-driven messaging and backpressure handling.")
    ContainerDb(Database, "Database", "PostgreSQL & WORM Storage", "Relational data persistence and 10-year immutable audit logging.")
}

Rel(Patients, APIGateway, "Accesses patient portal services", "HTTPS / OAuth2/OIDC / mTLS")
Rel(Receptionists, APIGateway, "Manages admissions and scheduling", "HTTPS / OAuth2/OIDC / mTLS")
Rel(Physicians, APIGateway, "Accesses EMR services", "HTTPS / OAuth2/OIDC / mTLS")
Rel(BillingSpecialists, APIGateway, "Manages billing services", "HTTPS / OAuth2/OIDC / mTLS")
Rel(LabandImagingSystems, APIGateway, "Exchanges medical data and test results", "REST/JSON over HTTPS using HL7 FHIR standards")
Rel(APIGateway, PatientPortalFrontend, "Routes requests to patient frontend", "HTTPS")
Rel(APIGateway, PhysicianEMRFrontend, "Routes requests to physician frontend", "HTTPS")
Rel(PatientPortalFrontend, BillingService, "Communicates for billing operations", "gRPC with mTLS")
Rel(PhysicianEMRFrontend, EMRBackend, "Communicates for EMR operations", "gRPC with mTLS")
Rel(EMRBackend, EventBroker, "Publishes and consumes events", "TLS and SCRAM-SHA-512")
Rel(BillingService, EventBroker, "Publishes and consumes events", "TLS and SCRAM-SHA-512")
Rel(EMRBackend, Database, "Persists and retrieves EMR data and audit logs", "Encrypted TCP (AES-256)")
Rel(BillingService, Database, "Persists billing data", "Encrypted TCP (AES-256)")
Rel(BillingService, PaymentGateways, "Processes payments", "REST/JSON over HTTPS")

@enduml