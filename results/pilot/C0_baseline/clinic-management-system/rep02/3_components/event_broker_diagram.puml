@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Event Broker container

Container_Boundary(event_broker, "Event Broker") {
    Component(kafka, "Apache Kafka KRaft Broker", "Apache Kafka with KRaft mode", "Provides asynchronous messaging and backpressure handling for high throughput clinical and billing events.")
    Component(strimzi, "Strimzi Operator", "Strimzi Operator", "Enforces declarative Kubernetes cluster lifecycle management.")
    Component(schema_registry, "Schema Registry", "Quarkus", "Enforces Avro-based payload validation against HL7 FHIR standards.")
    Component(mirror_maker, "MirrorMaker 2", "MirrorMaker 2, mTLS", "Handles cross-cluster replication between on-prem-k8s and AWS eu-central-1.")
}

Rel(kafka, schema_registry, "Validates event payloads against HL7 FHIR standards", "Avro")
Rel(kafka, mirror_maker, "Replicates data cross-cluster", "mTLS")
Rel(strimzi, kafka, "Manages lifecycle", "Kubernetes API")

@enduml