@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(CoreProxyEngine, "Core Proxy Engine", "Go with fasthttp", "Handles high-throughput routing for incoming traffic.")
    Component(ClaimsValidator, "Claims Validator", "Go", "Validates security claims and JSON Web Tokens (JWT).")
    Component(TransformFilter, "Transform Filter", "Go", "Transforms and sanitizes payloads before forwarding to backend services.")
    Component(AuthMiddleware, "Auth Middleware", "Go", "Enforces edge authentication, OAuth2/OIDC, and mTLS verification.")
    Component(RateLimiter, "Rate Limiter", "Go with Redis", "Manages and limits request rates to protect backend infrastructure.")
    Component(TelemetryInterceptor, "Telemetry Interceptor", "Go with OpenTelemetry", "Intercepts requests for monitoring, metrics collection, and tracing.")
}

Rel(AuthMiddleware, ClaimsValidator, "Delegates token and claims validation", "")
Rel(CoreProxyEngine, TransformFilter, "Passes sanitized request payloads for transformation", "")
Rel(RateLimiter, CoreProxyEngine, "Regulates traffic flow through the proxy", "")
Rel(TelemetryInterceptor, CoreProxyEngine, "Monitors traffic passing through the proxy engine", "")
@enduml