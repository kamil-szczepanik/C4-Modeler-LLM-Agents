@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(database, "Database") {
    Component(RelationalDataStore, "Relational Data Store", "PostgreSQL", "Handles transactional workloads for patient records, scheduling, and billing with robust ACID compliance, row-level security, and pgaudit support.")
    Component(AuditLogEngine, "Audit Log Engine", "WORM Storage (AWS S3 Object Lock & On-Premise WORM)", "Provides immutable, append-only electronic medical record audit logs to meet the 10-year immutable audit retention requirement.")
    Component(PgBouncer, "PgBouncer", "PgBouncer", "Manages database connection pooling to prevent thread exhaustion under high concurrent loads.")
}

Rel(PgBouncer, RelationalDataStore, "Manages and pools database connections")
Rel(RelationalDataStore, AuditLogEngine, "Streams cryptographic audit events and logs")
@enduml