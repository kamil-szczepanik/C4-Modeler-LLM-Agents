@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(Physician_EMR_Frontend, "Physician EMR Frontend") {
    Component(React_Router_Views, "React Router & Views", "React with Vite", "Powers the Physician EMR Frontend UI for sub-second P95 performance and manages routing.")
    Component(Redux_Toolkit_State_Manager, "Redux Toolkit & State Manager", "Redux Toolkit", "Manages state caching for clinical workflows.")
    Component(Encrypted_IndexedDB_Storage, "Encrypted IndexedDB Storage", "Encrypted IndexedDB, Web Crypto API", "Secures cached PHI in browser storage per HIPAA/GDPR constraints and ensures secure draft persistence locally.")
}

Rel(React_Router_Views, Redux_Toolkit_State_Manager, "Dispatches actions and reads application state")
Rel(Redux_Toolkit_State_Manager, Encrypted_IndexedDB_Storage, "Persists and retrieves encrypted clinical drafts locally", "Web Crypto API")
@enduml