@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the EMR Backend container

Container_Boundary(emr_backend, "EMR Backend") {
    Component(emr_orchestrator, "EMR Orchestrator", "Spring WebFlux", "Reactive, non-blocking request handling for low latency and high-throughput clinical workflows.")
    Component(clinical_data_access_layer, "Clinical Data Access Layer", "Spring Data JPA & HikariCP", "Queries and persists patient records using high-performance database connection pooling.")
    Component(fhir_interoperability_adapter, "FHIR Interoperability Adapter", "Spring Boot & HL7 FHIR", "Exchanges medical data with external systems via REST/HTTPS.")
    Component(audit_log_interceptor, "Audit Log Interceptor", "Java", "Intercepts requests and writes immutable audit logs to WORM storage.")
    Component(in_memory_clinical_cache, "In-Memory Clinical Cache", "Hazelcast", "In-memory distributed caching for emergency room offline resilience.")
    Component(fhir_event_consumer, "FHIR Event Consumer", "Apache Kafka Client", "Ingests clinical events securely from the event broker.")
}

Component_Ext(physician_emr_frontend, "Physician EMR Frontend", "gRPC with mTLS", "External client frontend requesting clinical data.")
Component_Ext(external_systems, "External Systems", "REST/HTTPS", "External medical systems interacting via HL7 FHIR.")
Component_Ext(postgresql_worm_storage, "PostgreSQL & WORM Storage", "PostgreSQL & Cryptographic WORM", "Dual persistence model for transactional data and tamper-evident audit logs.")
Component_Ext(apache_kafka_event_broker, "Apache Kafka Event Broker", "Apache Kafka", "Asynchronous event streaming for decoupled lab ingestion.")

Rel(physician_emr_frontend, emr_orchestrator, "Requests clinical data", "gRPC with mTLS")
Rel(emr_orchestrator, clinical_data_access_layer, "Queries and persists patient records", "Encrypted TCP (AES-256)")
Rel(fhir_interoperability_adapter, external_systems, "Exchanges medical data", "REST/HTTPS via HL7 FHIR")
Rel(fhir_event_consumer, apache_kafka_event_broker, "Ingests clinical events", "TLS and SCRAM-SHA-512")
Rel(audit_log_interceptor, postgresql_worm_storage, "Writes immutable audit logs", "Cryptographic verification")
Rel(in_memory_clinical_cache, in_memory_clinical_cache, "Clusters cache replication across EMR Backend nodes", "TLS 1.3 mTLS")

@enduml