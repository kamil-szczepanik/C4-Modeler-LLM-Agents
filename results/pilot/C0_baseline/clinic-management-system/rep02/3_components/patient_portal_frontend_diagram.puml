@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Enterprise_IDP, "Enterprise IDP", "External Enterprise Identity Provider")
System_Ext(API_Gateway, "API Gateway", "External API Gateway")
System_Ext(Billing_Service, "Billing Service", "External Billing Service")

Container_Boundary(Patient_Portal_Frontend, "Patient Portal Frontend") {
    Component(Authentication_Handler, "Authentication Handler", "React.js / Node.js", "Manages user authentication, multi-factor authentication, and communicates with the Enterprise IDP using OAuth 2.0 / OIDC.")
    Component(Registration_Module, "Registration Module", "React.js", "Handles patient registrations independently within the secure single-page application.")
    Component(Scheduling_Widget, "Scheduling Widget", "React.js", "Enables patients to manage their scheduling and appointments.")
    Component(Session_Management_Module, "Session Management Module", "Node.js / React.js", "Manages active user sessions and enforces strict token security and zero plaintext PHI caching.")
    Component(API_Client_Service, "API Client Service", "React.js / Node.js", "Routes client requests to the API Gateway via HTTPS and communicates with the Billing Service using gRPC with mTLS.")
}

Rel(Authentication_Handler, Enterprise_IDP, "Manages user authentication and multi-factor auth", "OAuth 2.0 / OIDC")
Rel(API_Client_Service, API_Gateway, "Routes client requests and authenticates", "HTTPS")
Rel(API_Client_Service, Billing_Service, "Communicates for billing operations", "gRPC with mTLS")

@enduml