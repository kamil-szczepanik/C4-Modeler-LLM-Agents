@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "Patients accessing the healthcare platform for scheduling and viewing records.")
Person(Receptionists, "Receptionists", "Receptionists managing patient admissions and scheduling.")
Person(Physicians, "Physicians", "Physicians managing Electronic Medical Records (EMRs) and patient care.")
Person(Billing Specialists, "Billing Specialists", "Billing specialists managing financial transactions and billing.")

System(Clinic Management System, "Clinic Management System", "A hybrid healthcare platform designed to manage patient admissions, EMRs, scheduling, and billing for clinics with HIPAA/GDPR compliance and 99.99% high availability.")

System_Ext(Payment Gateways, "Payment Gateways", "External systems for processing patient payments.")
System_Ext(Lab and Imaging Systems, "Lab and Imaging Systems", "External medical systems providing lab results and imaging data.")
System_Ext(Enterprise IDP, "Enterprise IDP", "External identity provider for authentication and token validation.")

Rel(Patients, Clinic Management System, "Secure web and mobile access", "HTTPS/TLS")
Rel(Receptionists, Clinic Management System, "Manage patient admissions and scheduling", "HTTPS/TLS")
Rel(Physicians, Clinic Management System, "Manage EMRs and patient appointments", "HTTPS/TLS")
Rel(Billing Specialists, Clinic Management System, "Process and manage billing records", "HTTPS/TLS")
Rel(Clinic Management System, Payment Gateways, "Payment processing integration", "REST/JSON APIs")
Rel(Clinic Management System, Lab and Imaging Systems, "Exchange medical data and test results", "HL7 FHIR over secure HTTPS")
@enduml