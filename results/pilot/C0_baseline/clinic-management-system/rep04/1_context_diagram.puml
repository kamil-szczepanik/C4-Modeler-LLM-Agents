@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Clinic Management System

Person(Front_Desk_Staff, "Front Desk Staff", "Staff members responsible for managing patient admissions and scheduling.")
Person(Clinicians, "Clinicians", "Medical professionals managing electronic medical records and patient care.")
Person(Billing_Specialists, "Billing Specialists", "Personnel managing patient and insurance billing.")
Person(Patients, "Patients", "Individuals receiving care who interact with the system via the portal.")
Person(Clinic_Administrators, "Clinic Administrators", "Administrators managing system policies, compliance, and configurations.")

System_Ext(Third_Party_Payment_Gateways, "Third-Party Payment Gateways", "External systems processing financial transactions and payments.")
System_Ext(External_Insurance_Verification_Services, "External Insurance Verification Services", "External services used to verify patient insurance details.")
System_Ext(External_Lab_and_Imaging_Systems, "External Lab and Imaging Systems", "External medical systems providing lab and imaging results.")

System(Clinic_Management_System, "Clinic Management System", "A hybrid cloud platform that manages patient admissions, electronic medical records, scheduling, and billing for medium-sized clinics, ensuring high availability, regulatory compliance, and seamless interoperability.")

Rel(Front_Desk_Staff, Clinic_Management_System, "Interacts with the CMS for admissions and scheduling", "TLS-secured HTTPS")
Rel(Clinicians, Clinic_Management_System, "Interacts with the CMS for EMR and patient management", "TLS-secured HTTPS")
Rel(Billing_Specialists, Clinic_Management_System, "Interacts with the CMS for billing operations", "TLS-secured HTTPS")
Rel(Patients, Clinic_Management_System, "Interacts with the CMS via the patient portal", "TLS-secured HTTPS")
Rel(Clinic_Administrators, Clinic_Management_System, "Manages system configurations and policies", "TLS-secured HTTPS")

Rel(Clinic_Management_System, External_Lab_and_Imaging_Systems, "Integrates for lab and imaging data exchange", "HL7 FHIR APIs over HTTPS/REST")
Rel(Clinic_Management_System, Third_Party_Payment_Gateways, "Processes payments securely", "Secure RESTful APIs")
Rel(Clinic_Management_System, External_Insurance_Verification_Services, "Verifies insurance coverage", "Secure RESTful APIs")

@enduml