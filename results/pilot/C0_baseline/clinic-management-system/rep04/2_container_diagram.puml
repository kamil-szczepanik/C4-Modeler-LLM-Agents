@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

Person(FrontDeskStaff, "Front Desk Staff", "Staff members responsible for managing patient admissions and scheduling.")
Person(Clinicians, "Clinicians", "Medical professionals managing electronic medical records and patient care.")
Person(BillingSpecialists, "Billing Specialists", "Personnel managing patient and insurance billing.")
Person(Patients, "Patients", "Individuals receiving care who interact with the system via the portal.")
Person(ClinicAdministrators, "Clinic Administrators", "Administrators managing system policies, compliance, and configurations.")

System_Ext(ThirdPartyPaymentGateways, "Third-Party Payment Gateways", "External systems processing financial transactions and payments.")
System_Ext(ExternalInsuranceVerificationServices, "External Insurance Verification Services", "External services used to verify patient insurance details.")
System_Ext(ExternalLabandImagingSystems, "External Lab and Imaging Systems", "External medical systems providing lab and imaging results.")

System_Boundary(ClinicManagementSystem, "Clinic Management System") {
    Container(ReactSPA, "React Single Page Application (SPA)", "React, CDN", "Frontend application served via CDN accessed by users.")
    Container(APIGateway, "API Gateway", "NGINX / Kong, OAuth2, MFA", "Handles TLS termination, OAuth2, and MFA for perimeter requests.")
    Container(GoEMRService, "Go EMR Service", "Go, gRPC", "Backend service managing electronic medical records.")
    Container(NodeJSSchedulingService, "Node.js Scheduling Service", "Node.js, REST", "Backend service managing appointment scheduling.")
    Container(ReportingContainer, "Reporting Container", "Containerized Service", "Handles system reporting and analytics.")
    Container(ApacheCamelESB, "Apache Camel ESB", "Apache Camel, HL7 FHIR", "Integration container for HL7 FHIR translations.")
    Container(ApacheKafkaEventBus, "Apache Kafka Event Bus", "Apache Kafka", "Event bus handling asynchronous messaging and events.")
    ContainerDb(PostgreSQLCluster, "PostgreSQL Cluster", "PostgreSQL, Read Replicas, AES-256", "Primary relational database cluster with read replicas for transactional storage.")
    ContainerDb(RedisCluster, "Redis Cluster", "Redis, Redis Sentinel, TLS", "Caching cluster for real-time slot locking.")
}

Rel(FrontDeskStaff, ReactSPA, "Accesses portal via HTTPS", "HTTPS (TLS 1.3)")
Rel(Clinicians, ReactSPA, "Accesses portal via HTTPS", "HTTPS (TLS 1.3)")
Rel(BillingSpecialists, ReactSPA, "Accesses portal via HTTPS", "HTTPS (TLS 1.3)")
Rel(Patients, ReactSPA, "Accesses portal via HTTPS", "HTTPS (TLS 1.3)")
Rel(ClinicAdministrators, ReactSPA, "Accesses portal via HTTPS", "HTTPS (TLS 1.3)")

Rel(ReactSPA, APIGateway, "Sends perimeter requests to the API Gateway", "HTTPS")
Rel(APIGateway, GoEMRService, "Routes requests to the EMR service", "gRPC and REST over mTLS")
Rel(APIGateway, NodeJSSchedulingService, "Routes requests to the scheduling service", "gRPC and REST over mTLS")

Rel(GoEMRService, PostgreSQLCluster, "Persists transactional data", "AES-256 storage encryption")
Rel(NodeJSSchedulingService, RedisCluster, "Locks resources for scheduling", "TLS")

Rel(ApacheCamelESB, ExternalLabandImagingSystems, "Synchronizes data using HL7 FHIR APIs", "HL7 FHIR APIs over HTTPS")
Rel(ClinicManagementSystem, ThirdPartyPaymentGateways, "Integrates for payment processing", "Secure RESTful APIs")
Rel(ClinicManagementSystem, ExternalInsuranceVerificationServices, "Integrates for insurance verification", "Secure RESTful APIs")

@enduml