@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Go EMR Service container

System_Ext(api_gateway, "API Gateway", "External API Gateway routing requests")
System_Ext(redis_cluster, "Redis Cluster", "External Redis cluster for caching")
System_Ext(postgresql_cluster, "PostgreSQL Cluster", "External PostgreSQL database cluster")
System_Ext(kafka_bus, "Apache Kafka Event Bus", "External Kafka event bus for async events")

Container_Boundary(go_emr_service, "Go EMR Service") {
    Component(emr_query_handler, "EMR Query Handler", "Go, Redis Sentinel", "Manages read-optimized queries with Redis caching.")
    Component(clinical_command_processor, "Clinical Command Processor", "Go Routines, ABAC", "Executes write operations with Go routines and attribute-based access control (ABAC).")
    Component(audit_log_interceptor, "Audit Log Interceptor", "Go", "Generates immutable, cryptographically signed audit trails.")
    Component(fhir_adapter, "FHIR Adapter", "Go, HL7 FHIR", "Translates internal models to HL7 FHIR resources.")
    Component(data_masking_engine, "Data Masking Engine", "Go", "Dynamically redacts and tokenizes Protected Health Information (PHI).")
    Component(async_event_publisher, "Async Event Publisher", "Go, Apache Kafka", "Streams domain mutation events asynchronously.")
}

Rel(api_gateway, emr_query_handler, "Routes read requests", "gRPC and REST over mTLS")
Rel(api_gateway, clinical_command_processor, "Routes write requests", "gRPC and REST over mTLS")
Rel(emr_query_handler, redis_cluster, "Caches read-optimized data", "TLS")
Rel(clinical_command_processor, postgresql_cluster, "Persists transactional data", "AES-256 storage encryption")
Rel(async_event_publisher, kafka_bus, "Streams asynchronous events", "Payload-level encryption (JWE)")

@enduml