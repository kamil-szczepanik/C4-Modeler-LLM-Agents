@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL Cluster container

Container_Ext(go_emr_service, "Go EMR Service", "Go", "Persists transactional data")
Container_Ext(nodejs_scheduling_service, "Node.js Scheduling Service", "Node.js", "Manages appointment data")
Container_Ext(reporting_container, "Reporting Container", "Container", "Executes analytical queries")

Container_Boundary(postgresql_cluster, "PostgreSQL Cluster") {
    Component(Primary_Write_Node, "Primary Write Node", "PostgreSQL", "Manages transactional writes, enforces ACID compliance, and handles primary data persistence.")
    Component(Synchronous_Standby_Nodes, "Synchronous Standby Nodes", "PostgreSQL", "Provides synchronous data replication to ensure zero-data-loss failover.")
    Component(Read_Only_Replica_Nodes, "Read-Only Replica Nodes", "PostgreSQL", "Executes analytical queries and offloads read traffic from the primary node.")
    Component(PgBouncer_Connection_Pooler, "PgBouncer Connection Pooler", "PgBouncer", "Manages client connection pools efficiently to maintain low latency.")
    Component(pgaudit_Extension, "pgaudit Extension", "pgaudit", "Enforces database auditability to comply with HIPAA and GDPR mandates.")
    Component(HashiCorp_Vault_Secrets_Manager, "HashiCorp Vault Secrets Manager", "HashiCorp Vault", "Secures and rotates database superuser and replication credentials.")
    Component(Patroni___CloudNativePG_Orchestrator, "Patroni / CloudNativePG Orchestrator", "Patroni / CloudNativePG", "Orchestrates high availability and automated failover across hybrid Kubernetes environments.")
}

Rel(go_emr_service, Primary_Write_Node, "Persists transactional data", "PostgreSQL Wire Protocol over TCP/IP port 5432 with TLS 1.3 and SCRAM-SHA-256")
Rel(nodejs_scheduling_service, Primary_Write_Node, "Manages appointment data", "PostgreSQL Wire Protocol over TCP/IP port 5432 with TLS 1.3")
Rel(reporting_container, Read_Only_Replica_Nodes, "Executes analytical queries", "PostgreSQL protocol")
Rel(Primary_Write_Node, Synchronous_Standby_Nodes, "Replicates data", "native PostgreSQL streaming replication")

@enduml