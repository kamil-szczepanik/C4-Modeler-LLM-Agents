@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Kong_Gateway_Core, "Kong Gateway Core", "Kong, Lua", "Handles perimeter traffic routing, TLS 1.3 termination, and enforcement of security policies.")
    Component(OAuth2_MFA_Authentication_Module, "OAuth2 & MFA Authentication Module", "Lua Plugins", "Manages user authentication, OAuth2 token validation, and multi-factor authentication checks.")
    Component(Rate_Limiting_Traffic_Prioritization_Plugin, "Rate Limiting & Traffic Prioritization Plugin", "Lua Plugins", "Enforces distributed rate limits and prioritizes traffic across incoming requests.")
}

Rel(Kong_Gateway_Core, OAuth2_MFA_Authentication_Module, "Authenticates requests using", "")
Rel(Kong_Gateway_Core, Rate_Limiting_Traffic_Prioritization_Plugin, "Applies policies via", "")
@enduml