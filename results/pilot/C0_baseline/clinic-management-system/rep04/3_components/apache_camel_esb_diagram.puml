@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Apache Camel ESB container

Container_Boundary(apache_camel_esb, "Apache Camel ESB") {
    Component(RouteOrchestrationEngine, "Route Orchestration Engine", "Camel Java DSL", "Orchestrates integration workflows, mapping incoming data and dispatching messages.")
    Component(FHIRTransformationProcessor, "FHIR Transformation Processor", "Apache Camel DataFormats", "Maps incoming data and handles HL7 v2 to FHIR JSON mapping and schema validation.")
    Component(SecureProtocolAdapter, "Secure Protocol Adapter", "Camel HTTP/Netty components", "Dispatches messages securely over HTTPS/mTLS.")
    Component(DeadLetterChannelAuditLoggingComponents, "Dead Letter Channel & Audit Logging Components", "Apache Camel", "Handles integration fault-tolerance, failed payloads, and audit logging.")
    Component(PostgreSQLCluster, "PostgreSQL Cluster", "PostgreSQL with AES-256", "Persistent storage with encryption at rest for audit logs and DLC.")
    Component(RedisCluster, "Redis Cluster", "Redis", "High-performance caching and state management.")
}

System_Ext(ExternalLabandImagingSystems, "External Lab and Imaging Systems", "HL7 FHIR APIs over HTTPS/mTLS", "External medical systems synchronized via the ESB.")

Rel(apache_camel_esb, ExternalLabandImagingSystems, "Synchronizes data", "HL7 FHIR APIs over HTTPS/mTLS")
Rel(RouteOrchestrationEngine, FHIRTransformationProcessor, "Maps incoming data", "direct-vm endpoints")
Rel(RouteOrchestrationEngine, SecureProtocolAdapter, "Dispatches messages", "HTTPS/mTLS")
Rel(RouteOrchestrationEngine, PostgreSQLCluster, "Persists failed payloads", "JDBC with AES-256")

@enduml