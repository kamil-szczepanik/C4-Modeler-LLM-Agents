@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Users, "Users", "External users accessing the system")
System_Ext(API_Gateway, "API Gateway", "HTTPS / REST", "External entry point for user-facing interactions and dashboard access.")
System_Ext(Apache_Kafka, "Apache Kafka", "TLS / JSON", "Event bus for asynchronous domain event consumption.")
System_Ext(PostgreSQL_Cluster, "PostgreSQL Cluster", "PostgreSQL / mTLS", "Analytical read models and read replicas.")

Container_Boundary(Reporting_Container, "Reporting Container") {
    Component(Report_Scheduler, "Report Scheduler", "Python / Cron", "Manages cron-based and event-driven exports.")
    Component(Query_Orchestrator, "Query Orchestrator", "Python", "Routes read-only queries to database read replicas.")
    Component(Anonymization_Engine, "Anonymization Engine", "Python", "Applies masking rules and deterministic tokenization to PHI.")
    Component(Apache_Superset, "Apache Superset", "Apache Superset", "Core dashboarding and visualization tool.")
    Component(Pandas, "Pandas", "Python", "Data aggregation library.")
    Component(Gotenberg, "Gotenberg", "Gotenberg", "Headless document generation engine for PDF and Excel exports.")
}

Rel(Users, API_Gateway, "HTTPS / REST", "Dashboard access and report requests.")
Rel(Report_Scheduler, Gotenberg, "gRPC", "High-performance document rendering payloads.")
Rel(Report_Scheduler, API_Gateway, "HTTPS / REST", "User-facing interactions.")
Rel(Report_Scheduler, Apache_Kafka, "TLS / JSON", "Asynchronous event consumption.")
Rel(Report_Scheduler, PostgreSQL_Cluster, "mTLS", "Read-only queries against read replicas.")

@enduml