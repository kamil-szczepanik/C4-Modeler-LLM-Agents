@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Redis Cluster container

Container_Boundary(redis_cluster, "Redis Cluster") {
    Component(RedisSentinelManager, "Redis Sentinel Manager", "Redis Sentinel", "Monitors the Redis instances and handles automatic failover for high availability.")
    Component(DistributedLockingEngine, "Distributed Locking Engine", "Redis Cluster with TLS (ioredis)", "Manages real-time distributed slot locking for the scheduling service.")
}

Rel(DistributedLockingEngine, RedisSentinelManager, "Monitored and managed for failover by", "")

@enduml