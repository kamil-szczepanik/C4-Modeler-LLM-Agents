@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(apache_kafka_event_bus, "Apache Kafka Event Bus") {
    Component(Kafka_Brokers, "Kafka Brokers", "Apache Kafka, KRaft", "Handles distributed event streaming, log compaction, and message persistence across the event bus cluster.")
    Component(Schema_Registry, "Schema Registry", "Apache Avro", "Manages and validates data schemas for messages produced and consumed across core clinical and scheduling services.")
    Component(Strimzi_Operator, "Strimzi Operator", "Strimzi Operator", "Automates the management, provisioning, and scaling of the Apache Kafka cluster within the Kubernetes infrastructure.")
}

Rel(Kafka_Brokers, Schema_Registry, "Validates message schemas")
Rel(Strimzi_Operator, Kafka_Brokers, "Manages and deploys")
@enduml