@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component Diagram for the React Single Page Application (SPA) container

Container_Boundary("react_spa", "React Single Page Application (SPA)") {
    Component(Router & View Controller, "Router & View Controller", "React Router", "Manages client-side routing and page views for front desk, clinicians, billing, patients, and administrators.")
    Component(State Management & Data Fetching, "State Management & Data Fetching", "React Query", "Handles asynchronous data synchronization, caching, and state management for sub-second EMR loads.")
    Component(Authentication & Security Module, "Authentication & Security Module", "OAuth2 / OpenID Connect Client", "Manages user login tokens, session security, and MFA enforcement via HTTPS.")
}

System_Ext(API Gateway, "API Gateway", "NGINX/Kong API Gateway")

Rel(Router & View Controller, State Management & Data Fetching, "Triggers data fetching requests", "")
Rel(State Management & Data Fetching, API Gateway, "Sends perimeter requests via HTTPS", "HTTPS")

@enduml