@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Clinic Management System

Person(Patients, "Patients", "Individuals receiving care who access the system via the Patient Portal.")
Person(Receptionists, "Receptionists", "Clinic staff managing patient admissions and front-desk operations.")
Person("Attending Physicians", "Attending Physicians", "Medical professionals managing electronic medical records (EMRs) and patient treatments.")
Person("Billing Specialists", "Billing Specialists", "Financial staff handling patient billing, payments, and insurance claims.")
Person("Clinic Administrators", "Clinic Administrators", "Management staff overseeing system configuration, compliance, and administration.")

System_Ext("Identity Provider", "Identity Provider", "External system handling authentication and access control using OAuth2/OIDC.")
System_Ext("Third-Party Payment Gateways/Clearinghouses", "Third-Party Payment Gateways/Clearinghouses", "External financial systems for processing insurance claims and payments.")
System_Ext("External Laboratory & Imaging Systems", "External Laboratory & Imaging Systems", "External systems providing medical lab results and diagnostic images via HL7 FHIR.")

System_Boundary(cms_boundary, "Clinic Management System") {
    Container("Patient Portal", "Patient Portal", "Web/Mobile Frontend", "Interface allowing patients to interact with the clinic services.")
    Container("EMR Service", "EMR Service", "Microservice / Kubernetes", "Service responsible for electronic medical records management.")
    Container("Scheduling Service", "Scheduling Service", "Microservice / Kubernetes", "Service managing patient appointments and doctor schedules.")
    Container("Billing Service", "Billing Service", "Microservice / AWS", "Service managing financial transactions, billing, and insurance claims.")
    Container("API Gateway", "API Gateway", "HTTPS/TLS 1.3, MFA", "Entry point managing incoming traffic and security enforcement.")
    Container("Service Mesh", "Service Mesh", "Enterprise Service Mesh, mTLS", "Internal network management tool ensuring secure hybrid traffic routing.")
}

Rel(Patients, "API Gateway", "Accesses patient portal and services", "HTTPS/TLS 1.3, Multi-Factor Authentication (MFA)")
Rel(Receptionists, "API Gateway", "Manages patient admissions and scheduling", "HTTPS/TLS 1.3, Multi-Factor Authentication (MFA)")
Rel("Attending Physicians", "API Gateway", "Views and updates electronic medical records", "HTTPS/TLS 1.3, Multi-Factor Authentication (MFA)")
Rel("Billing Specialists", "API Gateway", "Processes billing and insurance claims", "HTTPS/TLS 1.3, Multi-Factor Authentication (MFA)")
Rel("Clinic Administrators", "API Gateway", "Administers system users and configurations", "HTTPS/TLS 1.3, Multi-Factor Authentication (MFA)")

Rel(cms_boundary, "Identity Provider", "Authenticates users and enforces access control", "OAuth2/OIDC")
Rel(cms_boundary, "External Laboratory & Imaging Systems", "Exchanges health data and lab results", "HL7 FHIR APIs over mutual TLS (mTLS)")
Rel(cms_boundary, "Third-Party Payment Gateways/Clearinghouses", "Processes payments and insurance claims", "REST/HTTPS")

@enduml