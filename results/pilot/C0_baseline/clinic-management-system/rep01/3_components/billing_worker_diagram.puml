@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing Worker container

Container_Boundary(billing_worker, "Billing Worker") {
    Component(Task_Consumer_Celery_Worker, "Task Consumer (Celery Worker)", "Python / Celery", "Orchestrates event handling and background task execution.")
    Component(Insurance_Claim_Formatter, "Insurance Claim Formatter", "Python", "Maps internal data models to HL7/X12 and regulatory formats.")
    Component(Payment_Gateway_Client, "Payment Gateway Client", "Python, Tenacity", "Handles secure outbound communication with external clearinghouses and implements circuit breaker patterns.")
}

Component(Apache_Kafka, "Apache Kafka", "Apache Kafka", "Message broker supplying asynchronous billing events via TCP.")
Component(PostgreSQL_Cluster, "PostgreSQL Cluster", "PostgreSQL", "Persistent storage ensuring transactional idempotency and AES-256 encryption.")
Component(Redis, "Redis", "Redis", "State-locking backend supporting concurrent claim processing.")
Component(Third_Party_Clearinghouses, "Third-Party Clearinghouses", "External Service", "External systems receiving batch financial payloads via mutual TLS (mTLS) over HTTPS.")

Rel(billing_worker, Apache_Kafka, "Consumes asynchronous claim generation tasks", "amqp over TCP")
Rel(billing_worker, PostgreSQL_Cluster, "Persists transaction states and claims", "TCP")
Rel(Payment_Gateway_Client, Third_Party_Clearinghouses, "Transmits batch financial payloads", "mTLS over HTTPS")
Rel(Task_Consumer_Celery_Worker, Redis, "Manages distributed state locking for concurrent execution")

@enduml