@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Redis container

System_Ext(Core_API_Service, "Core API Service", "Core API logic and Redlock execution.")
System_Ext(EMR_Engine, "EMR Engine", "High-performance EMR processing.")

Container_Boundary(Redis, "Redis") {
    Component(Redis_In_Memory_Cache, "Redis In-Memory Cache", "Redis Cluster v7.x", "Primary-replica caching and distributed locking for sub-second performance.")
    Component(Redis_JSON_RediSearch_Module, "Redis JSON & RediSearch Module", "Redis JSON / RediSearch", "In-memory indexing for fast EMR metadata retrieval.")
}

Rel(Core_API_Service, Redis_In_Memory_Cache, "Caches data and executes Redlock via ioredis", "TCP")
Rel(EMR_Engine, Redis_JSON_RediSearch_Module, "Caches EMR data and queries indexes via Redis JSON / RediSearch", "TCP")

@enduml