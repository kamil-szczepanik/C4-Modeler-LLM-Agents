@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(web_app_gateway, "Web Application Gateway") {
    Component(tls_termination, "TLS Termination Module", "NGINX", "Handles incoming HTTPS/TLS connections and decrypts traffic at the edge.")
    Component(reverse_proxy, "Reverse Proxy & Routing Engine", "NGINX", "Routes client requests to downstream core services and APIs.")
    Component(waf_module, "Rate Limiter & WAF Module", "NGINX Module", "Provides Web Application Firewall protection, rate limiting, and forwards security telemetry.")
    Component(jwt_filter, "JWT Validation Filter", "NGINX / Lua or Custom C Module", "Validates JSON Web Tokens (JWT) for incoming client requests.")
}

Rel(waf_module, audit_logging_sidecar, "Forwards security event telemetry", "Local IPC")

@enduml