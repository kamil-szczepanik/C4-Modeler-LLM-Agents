@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Kafka container

System_Boundary(Kafka, "Kafka") {
    Component(Broker_Node_Engine, "Broker Node Engine", "Apache Kafka / KRaft", "Manages cluster coordination and partition leadership via KRaft protocol.")
    Component(Partition_Log_Manager, "Partition Log Manager", "Apache Kafka", "Handles immutable segment files and tiering to object storage.")
    Component(Access_Control___Auth_Interceptor, "Access Control & Auth Interceptor", "Apache Ranger / mTLS / SASL/SCRAM", "Enforces security policies, mTLS, and token validation.")
    Component(Core_API_Service, "Core API Service", "TCP", "Publishes billing and event streams.")
    Component(Billing_Worker, "Billing Worker", "TCP", "Consumes event streams for financial processing.")
}

Rel(Core_API_Service, Access_Control___Auth_Interceptor, "Publishes billing messages securely", "TCP over TLS 1.3 / SASL/SCRAM")
Rel(Billing_Worker, Partition_Log_Manager, "Consumes billing and event streams", "TCP")
Rel(Broker_Node_Engine, Broker_Node_Engine, "Handles internal cluster consensus and replication", "TCP over mTLS using KRaft")

@enduml