@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core API Service container

Container_Boundary(core_api_service, "Core API Service") {
    Component(API_Gateway_Controller_Layer, "API Gateway Controller Layer", "Node.js / NestJS / Fastify", "Handles incoming routing and optimized throughput via Fastify adapters.")
    Component(Domain_Orchestration_Service, "Domain Orchestration Service", "Node.js / NestJS", "Executes business logic and manages clinical and administrative workflows.")
    Component(Data_Access_Repository_Layer, "Data Access Repository Layer", "Prisma ORM", "Provides type-safe query management against the PostgreSQL database.")
    Component(Security_Interceptor, "Security Interceptor", "Node.js / NestJS", "Validates authentication, authorization, and ensures security policies.")
    Component(Audit_Dispatcher_Component, "Audit Dispatcher Component", "Node.js / NestJS", "Dispatches logs and compliance events to the audit sidecar.")
    Component(Interoperability_Adapter_Component, "Interoperability Adapter Component", "Node.js / NestJS", "Integrates with external systems using HL7 FHIR and gRPC.")
    Component(Distributed_Locking_Component, "Distributed Locking Component", "Redis", "Coordinates atomic resource clash checks and distributed locking.")
}

Rel(API_Gateway_Controller_Layer, Security_Interceptor, "Validates requests")
Rel(Security_Interceptor, Domain_Orchestration_Service, "Passes authenticated requests")
Rel(Domain_Orchestration_Service, Data_Access_Repository_Layer, "Queries transactional data")
Rel(Domain_Orchestration_Service, Distributed_Locking_Component, "Coordinates locks")
Rel(Domain_Orchestration_Service, Audit_Dispatcher_Component, "Dispatches audit events")
Rel(Domain_Orchestration_Service, Interoperability_Adapter_Component, "Communicates externally")

@enduml