@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL cluster container

System_Ext(Core_Clinical_Services, "Core Clinical Services", "External system")
System_Ext(Finance_Billing, "Finance & Billing", "External system")
System_Ext(Prometheus, "Prometheus", "External system")

Container_Boundary(postgresql_cluster, "PostgreSQL cluster") {
    Component(PostgreSQL_Primary_and_Standby_Instances, "PostgreSQL Primary and Standby Instances", "PostgreSQL Core Engine", "Provides ACID-compliant relational persistence and replication.")
    Component(Patroni, "Patroni", "Patroni & Etcd", "Handles distributed consensus, automated failover, and leader election for 99.99% availability.")
    Component(PgBouncer, "PgBouncer", "PgBouncer", "Handles high-concurrency connection pooling for Spring Boot microservices.")
    Component(CloudNativePG___Patroni_Kubernetes_Operator, "CloudNativePG / Patroni Kubernetes Operator", "Kubernetes Operator", "Manages the deployment and lifecycle of the database cluster.")
    Component(pgAudit, "pgAudit", "pgAudit & pgcrypto", "Delivers regulatory compliance audit trails and encryption.")
    Component(Prometheus_PostgreSQL_Exporter, "Prometheus PostgreSQL Exporter", "Prometheus Exporter", "Scrapes cluster health and replication metrics.")
    Component(HashiCorp_Vault, "HashiCorp Vault", "HashiCorp Vault", "Manages short-lived, dynamic database credentials via SCRAM-SHA-256.")
    Component(Local_NVMe_with_dm_crypt, "Local NVMe with dm-crypt", "dm-crypt / AES-256", "Provides encrypted local storage and AES-256 encryption.")
}

Rel(Core_Clinical_Services, PgBouncer, "Persists transactional clinical data", "Secure TCP/TLS, port 5432, mTLS")
Rel(Finance_Billing, PgBouncer, "Persists financial data", "Secure TCP/TLS, port 5432, mTLS")
Rel(PgBouncer, PostgreSQL_Primary_and_Standby_Instances, "Routes pooled connection queries", "Secure TCP/TLS")
Rel(Prometheus_PostgreSQL_Exporter, Prometheus, "Scrapes cluster health and replication metrics", "HTTP")

@enduml