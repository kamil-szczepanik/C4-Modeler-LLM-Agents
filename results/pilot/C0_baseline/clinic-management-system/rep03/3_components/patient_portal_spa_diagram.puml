@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Patient Portal SPA", "Patient Portal SPA container") {
    Component("Routing Module", "Routing Module", "React Router / TypeScript", "Handles client-side routing and navigation within the patient portal.")
    Component("Appointment Scheduler Component", "Appointment Scheduler Component", "React 18 / TypeScript", "Provides interface for patients to view, book, and manage clinical appointments.")
    Component("Medical Records Viewer", "Medical Records Viewer", "React 18 / TypeScript", "Displays electronic medical records and test results to patients.")
    Component("API Client", "API Client", "Fetch API / Axios", "Communicates securely with the API Gateway via HTTPS (TLS 1.3).")
}

Rel("Routing Module", "Appointment Scheduler Component", "Renders based on URL")
Rel("Routing Module", "Medical Records Viewer", "Renders based on URL")
Rel("Appointment Scheduler Component", "API Client", "Sends scheduling requests")
Rel("Medical Records Viewer", "API Client", "Fetches patient records")

@enduml