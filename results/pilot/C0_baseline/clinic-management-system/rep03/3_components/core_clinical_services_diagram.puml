@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Core Clinical Services container

Container_Boundary(core_clinical_services, "Core Clinical Services") {
    Component(PatientAdmissionController, "Patient Admission Controller", "Spring Boot REST Controller", "Manages patient admission workflows and intake processing.")
    Component(EMRService, "EMR Service", "Spring Boot Service", "Handles Electronic Medical Records retrieval and updates.")
    Component(SchedulingManager, "Scheduling Manager", "Spring Boot Service", "Manages appointment scheduling and conflict prevention using Redis locking.")
}

Rel(PatientAdmissionController, EMRService, "Invokes EMR creation and updates", "Sync")
Rel(SchedulingManager, EMRService, "Coordinates appointment details with patient records", "Sync")

@enduml