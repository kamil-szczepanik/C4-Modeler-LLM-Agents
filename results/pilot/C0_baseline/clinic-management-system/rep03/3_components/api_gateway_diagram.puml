@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(CustomRoutingAndTransformationPlugin, "Custom Routing and Transformation Plugin", "Lua/Go", "Handles custom routing, transformation, and security checks at line rate.")
    Component(ProxyEngine, "Proxy Engine", "Kong/Envoy", "Proxies requests from external and internal clients to backend microservices.")
}

Rel(CustomRoutingAndTransformationPlugin, ProxyEngine, "Enforces security and transforms requests")

@enduml