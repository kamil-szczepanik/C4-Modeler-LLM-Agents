@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Clinician_Workspace_SPA", "Clinician Workspace SPA") {
    Component(State_Management_Engine, "State Management Engine", "Redux Toolkit", "Normalized local caching and state management for high-performance UI rendering.")
    Component(Routing_Lazy_Loading_Core, "Routing & Lazy-Loading Core", "React Router with code-splitting", "Manages routing and code-splitting for role-specific bundles.")
    Component(Role_Based_Access_Module, "Role-Based Access Module", "CASL", "Dynamic UI permission evaluation for authorized clinical and staff operations.")
    Component(FHIR_Client_Wrapper, "FHIR Client Wrapper", "React 18 / JavaScript", "Handles interoperability and data exchange for clinical EMRs.")
    Component(Offline_Storage_Sync_Manager, "Offline Storage & Sync Manager", "IndexedDB via Dexie.js with Web Crypto API", "Provides offline capabilities and encrypted local storage for cached PHI.")
    Component(WebSocket_Client_Component, "WebSocket Client Component", "WebSockets / JavaScript", "Enables real-time data streams and updates with the API Gateway.")
}

Rel(State_Management_Engine, FHIR_Client_Wrapper, "Provides cached state to", "")
Rel(Routing_Lazy_Loading_Core, Role_Based_Access_Module, "Evaluates permissions for", "")
Rel(Offline_Storage_Sync_Manager, State_Management_Engine, "Syncs offline data with", "")
Rel(WebSocket_Client_Component, State_Management_Engine, "Updates state via real-time streams", "")
@enduml