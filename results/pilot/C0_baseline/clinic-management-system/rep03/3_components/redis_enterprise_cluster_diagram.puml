@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Redis Enterprise cluster", "Redis Enterprise cluster") {
    Component("Distributed Caching Engine", "Distributed Caching Engine", "Redis Enterprise", "Delivers low-latency distributed caching for core clinical and billing data.")
    Component("Session Management Engine", "Session Management Engine", "Redis Enterprise", "Manages user and system sessions securely across hybrid environments.")
    Component("Appointment Locking Mechanism", "Appointment Locking Mechanism", "Redis Enterprise with CRDTs", "Handles distributed appointment locking ensuring consistency and conflict-free replication.")
}

Rel("Distributed Caching Engine", "Session Management Engine", "Shares memory space and state data")
Rel("Appointment Locking Mechanism", "Distributed Caching Engine", "Utilizes caching infrastructure for lock states")

@enduml