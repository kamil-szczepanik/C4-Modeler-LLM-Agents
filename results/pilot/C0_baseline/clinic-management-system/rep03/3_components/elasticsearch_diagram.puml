@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Elasticsearch container

Component(Core_Clinical_Services, "Core Clinical Services", "HTTPS, JSON, mTLS", "External service that queries and indexes EMR search data and audit logs.")
Component(Elasticsearch_Nodes, "Elasticsearch Nodes", "Transport Protocol, TLS 1.3", "Cluster nodes handling shard synchronization and cluster state updates.")
Component(Object_Storage, "Object Storage", "HTTPS, AES-256", "External storage for offloaded cold indices for long-term retention.")

Container_Boundary(elasticsearch, "Elasticsearch") {
    Component(Lucene_Index_Engine, "Lucene Index Engine", "Lucene Index Engine", "Inverted index execution for sub-second query performance.")
    Component(REST_Transport_Interface_layer, "REST/Transport Interface layer", "REST/Transport Interface", "Handles client requests and node communication over HTTP and transport protocols.")
    Component(Document_Routing_Sharding_Module, "Document Routing & Sharding Module", "Elasticsearch Routing", "Manages document routing, distribution, and shard synchronization.")
    Component(Query_Parser_Analyzer, "Query Parser & Analyzer", "Elasticsearch Analysis", "Parses and analyzes incoming search queries for full-text retrieval.")
    Component(Index_Lifecycle_Management_ILM_Module, "Index Lifecycle Management (ILM) Module", "Elasticsearch ILM", "Manages hot-warm-cold tiering and offloading of cold indices.")
}

Rel(Core_Clinical_Services, REST_Transport_Interface_layer, "Queries and indexes EMR search data and audit logs", "HTTPS, Port 9200, JSON, mTLS")
Rel(Elasticsearch_Nodes, Elasticsearch_Nodes, "Shard synchronization and cluster state updates", "Transport Protocol, TLS 1.3, Ports 9300-9400")
Rel(Index_Lifecycle_Management_ILM_Module, Object_Storage, "Offloads cold indices for long-term retention", "HTTPS, AES-256")
Rel(REST_Transport_Interface_layer, Query_Parser_Analyzer, "Passes incoming requests for analysis and execution")
Rel(Query_Parser_Analyzer, Lucene_Index_Engine, "Executes searches against the inverted index")
Rel(REST_Transport_Interface_layer, Document_Routing_Sharding_Module, "Routes documents to appropriate shards")

@enduml