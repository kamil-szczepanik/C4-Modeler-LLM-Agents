@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "Individuals receiving care who interact with the system via the patient portal.")
Person(FrontDeskStaff, "Front Desk Staff", "Administrative staff managing patient admissions and scheduling.")
Person(Clinicians, "Clinicians", "Medical professionals managing electronic medical records (EMRs) and clinical operations.")
Person(BillingSpecialists, "Billing Specialists", "Financial staff handling claims and billing processing.")

System(ClinicManagementSystem, "Clinic Management System", "A hybrid-cloud platform that manages patient admissions, EMRs, scheduling, and billing, providing secure and highly available clinical operations while ensuring strict HIPAA and GDPR compliance.")

System_Ext(PaymentGateway, "Payment Gateway", "External system for processing claims and payments.")
System_Ext(InsuranceVerificationRTEAPIs, "Insurance Verification/RTE APIs", "External clearinghouse APIs for Real-Time Eligibility checks.")
System_Ext(LabImagingSystems, "Lab & Imaging Systems", "External medical systems for laboratory and diagnostic imaging.")

Rel(Patients, ClinicManagementSystem, "Accesses patient portal and clinical services", "HTTPS over TLS 1.3 with OAuth2/MFA")
Rel(FrontDeskStaff, ClinicManagementSystem, "Manages patient admissions and scheduling", "HTTPS over TLS 1.3 with OAuth2/MFA")
Rel(Clinicians, ClinicManagementSystem, "Manages clinical operations and EMRs", "HTTPS over TLS 1.3 with OAuth2/MFA")
Rel(BillingSpecialists, ClinicManagementSystem, "Processes billing and claims", "HTTPS over TLS 1.3 with OAuth2/MFA")
Rel(ClinicManagementSystem, LabImagingSystems, "Exchanges medical data and test results", "RESTful HL7 FHIR APIs over mTLS")
Rel(ClinicManagementSystem, InsuranceVerificationRTEAPIs, "Performs real-time insurance eligibility verification", "TLS 1.3 with payload signatures")
Rel(ClinicManagementSystem, PaymentGateway, "Processes claims and financial transactions", "Secure HTTPS")
@enduml