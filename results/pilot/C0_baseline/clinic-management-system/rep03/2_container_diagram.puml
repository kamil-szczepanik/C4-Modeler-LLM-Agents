@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Patients, "Patients", "Individuals receiving care who interact with the system via the patient portal.")
Person(Front Desk Staff, "Front Desk Staff", "Administrative staff managing patient admissions and scheduling.")
Person(Clinicians, "Clinicians", "Medical professionals managing electronic medical records (EMRs) and clinical operations.")
Person(Billing Specialists, "Billing Specialists", "Financial staff handling claims and billing processing.")

System_Ext(Payment Gateway, "Payment Gateway", "External system for processing claims and payments.")
System_Ext(Insurance Verification/RTE APIs, "Insurance Verification/RTE APIs", "External clearinghouse APIs for Real-Time Eligibility checks.")
System_Ext(Lab & Imaging Systems, "Lab & Imaging Systems", "External medical systems for laboratory and diagnostic imaging.")

System_Boundary(Clinic Management System, "Clinic Management System") {
    Container(Patient Portal SPA, "Patient Portal SPA", "React", "Powers the patient portal for interactive user interface.")
    Container(Clinician Workspace SPA, "Clinician Workspace SPA", "React", "Powers the clinician workspace for interactive user interface.")
    Container(API Gateway, "API Gateway", "Kong/Envoy", "Acts as secure API Gateway handling OAuth2/OIDC and RBAC/ABAC.")
    Container(Core Clinical Services, "Core Clinical Services", "Spring Boot", "Implements core clinical services and business logic.")
    Container(Finance & Billing, "Finance & Billing", "Spring Boot", "Implements finance and billing business logic.")
    ContainerDb(PostgreSQL cluster, "PostgreSQL cluster", "PostgreSQL with PgBouncer", "Provides transactional persistence with AES-256 encryption at rest.")
    ContainerDb(Elasticsearch, "Elasticsearch", "Elasticsearch", "Enables indexed EMR full-text searches and audit log queries.")
    ContainerDb(Redis Enterprise cluster, "Redis Enterprise cluster", "Redis Enterprise", "Delivers low-latency caching and appointment locking.")
    Container(Kafka event bus, "Kafka event bus", "Apache Kafka (Confluent/MSK)", "Handles asynchronous event messaging between clinical and billing domains.")
}

Rel(Patients, Patient Portal SPA, "Accesses patient portal", "HTTPS (TLS 1.3)")
Rel(Front Desk Staff, Clinician Workspace SPA, "Manages admissions and scheduling", "HTTPS (TLS 1.3)")
Rel(Clinicians, Clinician Workspace SPA, "Manages EMRs and clinical operations", "HTTPS (TLS 1.3)")
Rel(Billing Specialists, Clinician Workspace SPA, "Accesses financial and billing operations", "HTTPS (TLS 1.3)")

Rel(Patient Portal SPA, API Gateway, "Routes requests to backend services", "HTTPS (TLS 1.3)")
Rel(Clinician Workspace SPA, API Gateway, "Routes requests to backend services", "HTTPS (TLS 1.3)")

Rel(API Gateway, Core Clinical Services, "Proxies requests to clinical backend", "gRPC over mTLS")
Rel(API Gateway, Finance & Billing, "Proxies requests to finance backend", "gRPC over mTLS")

Rel(Core Clinical Services, Kafka event bus, "Publishes asynchronous events for billing decoupling", "TCP/TLS")
Rel(Core Clinical Services, PostgreSQL cluster, "Persists transactional clinical data", "Secure TCP/TLS")
Rel(Core Clinical Services, Elasticsearch, "Queries and indexes EMR search data and audit logs", "Secure TCP/TLS")
Rel(Core Clinical Services, Redis Enterprise cluster, "Caches data and handles appointment locking", "Secure TCP/TLS")

Rel(Finance & Billing, PostgreSQL cluster, "Persists financial data", "Secure TCP/TLS")
Rel(Finance & Billing, Redis Enterprise cluster, "Caches billing session data", "Secure TCP/TLS")

Rel(Lab & Imaging Systems, API Gateway, "Exchanges medical data and test results", "HL7 FHIR over HTTPS REST")
Rel(API Gateway, Insurance Verification/RTE APIs, "Performs real-time insurance eligibility checks", "HTTPS REST")
Rel(Finance & Billing, Payment Gateway, "Processes claims and financial transactions", "HTTPS REST")

@enduml