@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Go Clinical Workspace Service container

System_Ext(nodejs_api_gateway, "Node.js API Gateway", "External gateway routing incoming client requests.")

Container_Boundary(go_clinical_workspace_service_container, "Go Clinical Workspace Service") {
    Component(go_clinical_workspace_service, "Go Clinical Workspace Service", "Go (Golang)", "Core container managing clinical workspace logic, session coordination, and prescription routing.")
    Component(session_management_handler_redis, "Session Management Handler & Redis", "Go, Redis", "Internal Go package and localized state caching for rural connection recovery.")
    Component(prescription_router_adapters, "Prescription Router & Adapters", "Go, REST, mTLS", "Translates domain models into payloads for US HL7 FHIR Adapters and EU National E-Prescription Formatters.")
    Component(security_infrastructure, "Security & Infrastructure", "Node.js, Envoy API Gateway, GCP Cloud KMS, GKE", "Manages gateway routing, regional container orchestration, and customer-managed encryption keys for compliance.")
}

Rel(nodejs_api_gateway, go_clinical_workspace_service, "Delegates clinical domain logic via gRPC over TLS 1.3.", "gRPC / TLS 1.3")
Rel(go_clinical_workspace_service, prescription_router_adapters, "Integrates with US HL7 FHIR and EU National E-Prescriptions via REST over mTLS.", "REST / mTLS")
Rel(go_clinical_workspace_service, session_management_handler_redis, "Caches session states locally for fast recovery.", "In-Memory / Redis protocol")

@enduml