@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(gcp_cloud_armor_envoy_api_gateway, "GCP Cloud Armor & Envoy API Gateway") {
    Component(gcp_cloud_armor_waf, "GCP Cloud Armor WAF", "Google Cloud Armor", "Provides Layer 7 geo-based ACLs, DDoS protection, and rate limiting for regional compliance.")
    Component(envoy_edge_proxy, "Envoy Edge Proxy", "Envoy Proxy & GCP Traffic Director", "Handles dynamic routing, mTLS, and HTTP/2 connection multiplexing at the edge.")
    Component(edge_cache_manager, "Edge Cache Manager", "Redis", "Caches validated OAuth2 tokens and consent scopes to minimize latency for rural users.")
    Component(ca_service_integrator, "CA Service Integrator", "GCP Certificate Authority Service", "Automates short-lived certificate rotation for secure mTLS tunnels.")
    Component(observability_exporter, "Observability Exporter", "Prometheus & Grafana", "Scrapes Envoy metrics endpoints for latency and circuit breaker monitoring.")
}

Rel(gcp_cloud_armor_waf, envoy_edge_proxy, "Inspects and forwards filtered client traffic", "HTTPS/TLS 1.3")
Rel(envoy_edge_proxy, edge_cache_manager, "Validates tokens and consent scopes synchronously", "Redis Cache")
Rel(ca_service_integrator, envoy_edge_proxy, "Provides short-lived certificates for mTLS tunnels", "mTLS")
Rel(observability_exporter, envoy_edge_proxy, "Scrapes `/stats/prometheus` endpoints for metrics", "HTTP")
@enduml