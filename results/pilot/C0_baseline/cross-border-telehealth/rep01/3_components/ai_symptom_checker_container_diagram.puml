@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the AI Symptom Checker Container container

System_Ext(nodejs_api_gateway, "Node.js API Gateway", "External gateway routing client requests.")
System_Ext(go_consent_engine, "Go Consent & Localization Engine", "Handles regional consent and localization requirements.")

Container_Boundary(ai_symptom_checker_container, "AI Symptom Checker Container") {
    Component(triage_orchestrator, "Triage Orchestrator", "Python, FastAPI", "Manages conversation flow and service coordination.")
    Component(model_inference_engine, "Model Inference Engine", "Hugging Face Transformers", "Executes localized LLM inference.")
    Component(clinical_rule_validator, "Clinical Rule Validator", "Pydantic", "Applies deterministic safety overrides and input validation.")
    Component(audit_logger, "Audit Logger", "Python", "Handles regional traceability and immutable logging.")
}

Rel(nodejs_api_gateway, triage_orchestrator, "Requests AI symptom analysis", "Internal gRPC, mTLS")
Rel(triage_orchestrator, model_inference_engine, "Coordinates local inference", "In-memory Python calls")
Rel(triage_orchestrator, clinical_rule_validator, "Coordinates validation", "In-memory Python calls")
Rel(audit_logger, go_consent_engine, "Dispatches structured JSON payloads and model version tags", "Internal gRPC, async")

@enduml