@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Go Consent & Localization Engine container

Container_Boundary(go_consent_localization_engine, "Go Consent & Localization Engine") {
    Component(Consent_Manager, "Consent Manager", "Go", "Manages patient consent records and compliance verification across jurisdictions.")
    Component(Localization_Engine, "Localization Engine", "Go", "Handles regional language, timezone, and regulatory localization rules.")
    Component(Audit_Logger, "Audit Logger", "Go", "Records access and consent changes for regulatory auditing purposes.")
}

Rel(Consent_Manager, Localization_Engine, "Queries localization rules for specific jurisdictions")
Rel(Consent_Manager, Audit_Logger, "Logs consent transactions")

@enduml