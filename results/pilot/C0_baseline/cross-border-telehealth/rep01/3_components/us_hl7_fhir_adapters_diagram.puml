@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(us_hl7_fhir_adapters, "US HL7 FHIR Adapters") {
    Component(FHIR_Resource_Mapper, "FHIR Resource Mapper", "Go / Python", "Transforms internal data models to and from HL7 FHIR standard formats.")
    Component(Client_Connection_Pooler, "Client Connection Pooler", "Go", "Manages outbound mTLS connections and connection pooling to external US HL7 FHIR Engines.")
    Component(Terminology_Translator, "Terminology Translator", "Python / Rust", "Translates medical terminologies and codes for US healthcare system interoperability.")
}

Rel(Client_Connection_Pooler, FHIR_Resource_Mapper, "Provides mapped FHIR resources over internal channels")
Rel(FHIR_Resource_Mapper, Terminology_Translator, "Requests code and terminology translations")

@enduml