@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the EU National E-Prescription Formatters container

Container_Boundary(eu_national_e_prescription_formatters, "EU National E-Prescription Formatters") {
    Component(Template_Engine_Component, "Template Engine Component", "Spring Boot, Java, HL7/XML parsing ecosystems", "Translates clinical data into national EU e-prescription formats.")
    Component(Validation_Engine_Component, "Validation Engine Component", "Spring Boot, Java, XMLDSig", "Validates formatted e-prescriptions and applies digital signatures.")
    Component(Gateway_Connector_Component, "Gateway Connector Component", "Spring Boot, Java, Resilience4j", "Sends formatted e-prescriptions to EU National E-Prescription Gateways with circuit breakers and backoff retries.")
}

Component(Go_Clinical_Workspace_Service, "Go Clinical Workspace Service", "Go, gRPC", "Caller service that invokes serialization.")
Component(EU_National_E_Prescription_Gateways, "EU National E-Prescription Gateways", "REST over HTTPS, mTLS, XMLDSig", "External system receiving compliant cross-border e-prescriptions.")
Component(GCP_Secret_Manager, "GCP Secret Manager", "API", "External system providing X.509 client certificates.")

Rel(Go_Clinical_Workspace_Service, Template_Engine_Component, "Invokes serialization", "gRPC")
Rel(Template_Engine_Component, Validation_Engine_Component, "Passes formatted prescription for validation and signing", "")
Rel(Validation_Engine_Component, Gateway_Connector_Component, "Passes validated e-prescription for transmission", "")
Rel(Gateway_Connector_Component, EU_National_E_Prescription_Gateways, "Sends formatted e-prescriptions", "REST over HTTPS, mTLS, XMLDSig")
Rel(Gateway_Connector_Component, GCP_Secret_Manager, "Retrieves X.509 client certificates", "API")

@enduml