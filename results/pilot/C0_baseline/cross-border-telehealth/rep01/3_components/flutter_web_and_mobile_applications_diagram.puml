@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Flutter Web and Mobile Applications container

Person(Patients_Clinicians, "Patients & Clinicians", "System users")
System_Ext(GCP_Cloud_Armor_Envoy_API_Gateway, "GCP Cloud Armor & Envoy API Gateway", "External API Gateway and Cloud Armor")
System_Ext(mediasoup_SFU, "mediasoup SFU", "External Selective Forwarding Unit for video")

Container_Boundary(Flutter_Web_and_Mobile_Applications, "Flutter Web and Mobile Applications") {
    Component(Presentation_Layer_UI, "Presentation Layer (UI)", "Flutter / Dart", "Adaptive screens for patient onboarding, telehealth consultations, and clinician workflows.")
    Component(State_Management_Engine, "State Management Engine", "Riverpod", "Coordinator for asynchronous data synchronization and offline-first resilience.")
    Component(Local_Secure_Storage_Service, "Local Secure Storage Service", "SQLCipher with platform-secure hardware keys (Keychain/EncryptedSharedPreferences)", "Stores encrypted consent profiles and draft data securely on client devices.")
    Component(Network_WebRTC_Client, "Network & WebRTC Client", "HTTPS/TLS 1.3, WebSockets, WebRTC, mediasoup", "Manages HTTPS/TLS 1.3, WebSockets, and adaptive bitrate streaming via mediasoup SFU.")
    Component(AI_Symptom_Checker_Wrapper, "AI Symptom Checker Wrapper", "Flutter / Dart", "Validates input payloads and captures traceability metadata.")
}

Rel(Patients_Clinicians, Presentation_Layer_UI, "Uses for UI interactions and telehealth consultations", "HTTPS/TLS 1.3, WebRTC")
Rel(Network_WebRTC_Client, GCP_Cloud_Armor_Envoy_API_Gateway, "Sends API requests and video streams", "HTTPS/TLS 1.3, WebRTC over UDP/TCP")
Rel(Network_WebRTC_Client, mediasoup_SFU, "Streams adaptive video consultations", "WebRTC")
Rel(State_Management_Engine, Local_Secure_Storage_Service, "Reads/writes encrypted consent profiles and draft data", "SQLCipher API")
Rel(AI_Symptom_Checker_Wrapper, GCP_Cloud_Armor_Envoy_API_Gateway, "Dispatches validated symptom payloads", "HTTPS/TLS 1.3")

@enduml