@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Patients and Licensed Clinicians, "Patients and Licensed Clinicians", "Users")
System_Ext(Go Clinical Workspace Service, "Go Clinical Workspace Service", "External Container")

Container_Boundary(mediasoup WebRTC SFU, "mediasoup WebRTC SFU") {
    Component(Worker Pool Manager, "Worker Pool Manager", "Node.js", "Manages C++ worker threads and packet forwarding.")
    Component(Signaling Event Handler, "Signaling Event Handler", "Node.js", "Handles signaling events and orchestrates rooms with external services.")
    Component(Transport & Congestion Controller, "Transport & Congestion Controller", "GCC / REMB, DTLS-SRTP", "Manages congestion control algorithms for bandwidth adaptation and encrypts media payloads.")
    Component(Media Router, "Media Router", "mediasoup / C++ worker modules", "Provides high-performance selective forwarding of video and audio packets.")
}

Rel(Worker Pool Manager, Media Router, "Manages C++ worker threads and packet forwarding", "IPC")
Rel(Go Clinical Workspace Service, Signaling Event Handler, "Orchestrates rooms", "gRPC over mTLS")
Rel(Patients and Licensed Clinicians, mediasoup WebRTC SFU, "Streams audio/video", "WebRTC, ICE, STUN, TURN via UDP/TCP")
@enduml