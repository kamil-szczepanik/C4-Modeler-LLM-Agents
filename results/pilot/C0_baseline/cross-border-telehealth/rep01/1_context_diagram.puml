@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "Patients in the EU and US seeking consultations, e-prescriptions, and AI symptom checks.")
Person(LicensedClinicians, "Licensed Clinicians", "Medical professionals providing secure video consultations and issuing prescriptions.")

System_Ext(ExternalPharmacies, "External Pharmacies", "Third-party pharmacies receiving e-prescription orders.")
System_Ext(NationalE_PrescriptionGateways, "National E-Prescription Gateways", "Gateways handling national e-prescription compliance and routing.")
System_Ext(RegionalIdentityProviders, "Regional Identity Providers", "Providers handling authentication and identity mapping.")

System_Boundary(CrossBorderTelehealthPlatform, "Cross-Border Telehealth Platform") {
    Container(RegionalAPIGateways, "Regional API Gateways", "HTTPS, REST, WebRTC", "Entry points for UI interactions and routing traffic.")
    Container(WebRTCMediaServers, "WebRTC Media Servers", "WebRTC", "Servers handling low-bandwidth video and audio consultations with adaptive TURN/STUN relays.")
    Container(AISymptomCheckerService, "AI Symptom Checker Service", "gRPC over TLS", "Service providing traceable triage recommendations.")
    Container(ConsentManagementService, "Consent Management Service", "Terraform/Pulumi, OPA Gatekeeper", "Service managing user consent and regulatory compliance policies.")
    ContainerDb(RegionalDatabases, "Regional Databases", "GCP Regional Storage, Cloud KMS", "Isolated storage instances ensuring zero cross-border database peering.")
}

Rel(Patients, RegionalAPIGateways, "Interacts for UI interactions and video consultations", "HTTPS/WebRTC")
Rel(LicensedClinicians, RegionalAPIGateways, "Interacts for UI interactions and video consultations", "HTTPS/WebRTC")
Rel(RegionalAPIGateways, ExternalPharmacies, "Sends e-prescriptions", "TLS-encrypted REST and HL7 FHIR APIs")
Rel(RegionalAPIGateways, NationalE_PrescriptionGateways, "Sends e-prescriptions", "TLS-encrypted REST and HL7 FHIR APIs")
Rel(RegionalAPIGateways, WebRTCMediaServers, "Routes media streams for consultations", "WebRTC")
Rel(RegionalAPIGateways, AISymptomCheckerService, "Requests triage recommendations", "gRPC over TLS")
Rel(AISymptomCheckerService, RegionalDatabases, "Persists audit logs and encrypted data", "Encrypted connections")
Rel(ConsentManagementService, RegionalDatabases, "Manages compliance and consent records", "Encrypted connections")

@enduml