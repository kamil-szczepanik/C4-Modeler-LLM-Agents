@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Cross-Border Telehealth Platform

Person(Patients, "Patients", "Patients in the EU and US seeking consultations, e-prescriptions, and AI symptom checks.")
Person(LicensedClinicians, "Licensed Clinicians", "Medical professionals providing secure video consultations and issuing prescriptions.")

System_Ext(USHl7FhirEngines, "US HL7 FHIR Engines", "External US healthcare systems handling HL7 FHIR interoperability.")
System_Ext(EUNationalEPrescriptionGateways, "EU National E-Prescription Gateways", "External EU gateways handling national e-prescription compliance and routing.")

System_Boundary(CrossBorderTelehealthPlatform, "Cross-Border Telehealth Platform") {
    Container(FlutterWebandMobileApplications, "Flutter Web and Mobile Applications", "Flutter Web, Mobile", "Client applications used by Patients and Licensed Clinicians.")
    Container(GCPCloudArmorEnvoyAPIGateway, "GCP Cloud Armor & Envoy API Gateway", "GCP Cloud Armor, Envoy, GCP Traffic Director", "Edge layer managing traffic ingress, security, and routing.")
    Container(NodejsAPIGateway, "Node.js API Gateway", "Node.js", "API gateway routing requests and handling client traffic.")
    Container(GoClinicalWorkspaceService, "Go Clinical Workspace Service", "Go", "Service managing clinical workspace logic and operations.")
    Container(GoConsentLocalizationEngine, "Go Consent & Localization Engine", "Go", "Engine ensuring strict regional data isolation and consent management.")
    Container(AISymptomCheckerContainer, "AI Symptom Checker Container", "Python, FastAPI", "AI-driven service providing triage recommendations and structured payload logging.")
    Container(mediasoupWebRTCSFU, "mediasoup WebRTC SFU", "mediasoup, WebRTC", "Selective Forwarding Unit handling real-time video streaming.")
    Container(USHL7FHIRAdapters, "US HL7 FHIR Adapters", "Containerized Integration", "Integration container connecting to US HL7 FHIR engines.")
    Container(EUNationalEPrescriptionFormatters, "EU National E-Prescription Formatters", "Containerized Integration", "Integration container connecting to EU national e-prescription gateways.")
}

Rel(Patients, FlutterWebandMobileApplications, "Uses for UI interactions and telehealth consultations", "HTTPS/TLS 1.3, WebRTC")
Rel(LicensedClinicians, FlutterWebandMobileApplications, "Uses for clinical workspace and consultations", "HTTPS/TLS 1.3, WebRTC")
Rel(FlutterWebandMobileApplications, GCPCloudArmorEnvoyAPIGateway, "Sends client requests and streams video", "HTTPS/TLS 1.3, WebRTC over UDP/TCP")
Rel(GCPCloudArmorEnvoyAPIGateway, NodejsAPIGateway, "Routes incoming API traffic", "mTLS, gRPC/REST")
Rel(NodejsAPIGateway, GoClinicalWorkspaceService, "Delegates clinical domain logic", "mTLS, gRPC/REST")
Rel(NodejsAPIGateway, GoConsentLocalizationEngine, "Validates localization and consent rules", "mTLS, gRPC/REST")
Rel(NodejsAPIGateway, AISymptomCheckerContainer, "Requests AI symptom analysis", "Internal gRPC")
Rel(NodejsAPIGateway, mediasoupWebRTCSFU, "Coordinates video streaming sessions", "WebRTC")
Rel(GoClinicalWorkspaceService, USHL7FHIRAdapters, "Integrates with US health records", "REST")
Rel(GoClinicalWorkspaceService, EUNationalEPrescriptionFormatters, "Formats and sends e-prescriptions", "REST")
Rel(AISymptomCheckerContainer, GoConsentLocalizationEngine, "Logs model versioning and structured payloads to regional storage", "Internal gRPC")
Rel(USHL7FHIRAdapters, USHl7FhirEngines, "Connects to external US healthcare systems", "REST APIs")
Rel(EUNationalEPrescriptionFormatters, EUNationalEPrescriptionGateways, "Connects to external EU e-prescription gateways", "REST APIs")

@enduml