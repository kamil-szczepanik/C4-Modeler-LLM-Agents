@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the React Single-Page Application (SPA) container

System_Ext(Azure_API_Management_Gateway, "Azure API Management Gateway", "API Gateway")

Container_Boundary(React_Single_Page_Application_SPA, "React Single-Page Application (SPA)") {
    Component(React_Router, "React Router", "React Router", "View orchestration and client-side routing component.")
    Component(Dynamic_Form_Renderer, "Dynamic Form Renderer", "React, TypeScript", "Schema-driven component for adaptive claim forms.")
    Component(TanStack_Query, "TanStack Query", "TanStack Query", "Data fetching, caching, and optimistic update component.")
    Component(Auth_Hook, "Auth Hook", "Web Crypto API, TypeScript", "Authentication and PKCE validation component using Web Crypto API.")
}

Rel(React_Router, Dynamic_Form_Renderer, "Renders adaptive claim forms based on routes")
Rel(Dynamic_Form_Renderer, TanStack_Query, "Fetches and mutates schema and claim data via")
Rel(Auth_Hook, Azure_API_Management_Gateway, "Authenticates requests using OAuth2/OIDC over", "HTTPS, OAuth2/OIDC")
Rel(TanStack_Query, Azure_API_Management_Gateway, "Sends API requests via OpenAPI client SDKs over", "HTTPS")

@enduml