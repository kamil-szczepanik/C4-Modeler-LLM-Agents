@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Modular Monolith container

Container_Boundary(modular_monolith, "Modular Monolith") {
    Component(ClaimManagement, "ClaimManagement", "Node.js with TypeScript, TSyringe or Inversify", "Core component that isolates domain logic and manages claim processing.")
    Component(PolicyVerification, "PolicyVerification", "Node.js with TypeScript, TSyringe or Inversify", "Component responsible for verifying insurance policies.")
    Component(DocumentHandling, "DocumentHandling", "Node.js with TypeScript, TSyringe or Inversify", "Component responsible for handling and processing documents.")
    ComponentDb(Azure_SQL_Database, "Azure SQL Database", "Azure SQL Database", "Relational storage utilizing transactional outbox pattern.")
    Component(Azure_Service_Bus, "Azure Service Bus", "Azure Service Bus", "Asynchronous messaging broker for event-driven consistency.")
    ComponentDb(Redis_Cache, "Redis Cache", "Redis Cache", "High-performance storage for low-latency adjuster screen reads.")
    Component(In_Process_Mediator, "In-Process Mediator", "In-Process Mediator", "Communicates via strongly-typed domain events.")
}

Rel(ClaimManagement, Azure_SQL_Database, "Persists transactional data", "T-SQL")
Rel(ClaimManagement, Azure_Service_Bus, "Publishes asynchronous domain events", "AMQP")
Rel(ClaimManagement, Redis_Cache, "Updates read-model projections", "Redis Protocol")
Rel(ClaimManagement, In_Process_Mediator, "Communicates via strongly-typed domain events", "In-Process")
Rel(PolicyVerification, In_Process_Mediator, "Communicates via strongly-typed domain events", "In-Process")
Rel(DocumentHandling, In_Process_Mediator, "Communicates via strongly-typed domain events", "In-Process")

@enduml