@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(redis_cache, "Redis Cache") {
    Component(Key_Eviction_Engine, "Key Eviction Engine", "Redis volatile-lru policy", "Manages memory limits and evicts least recently used keys with an expiration set.")
    Component(In_Memory_Data_Store, "In-Memory Data Store", "Redis Hashes and structured string keys", "Stores read-model projections with tenant and claim-type prefixes for rapid retrieval.")
    Component(RESP_Interface, "RESP Interface", "RESP Protocol, Azure Private Link, TCP with TLS 1.3", "Provides secure, encrypted, low-latency communication interface for clients.")
    Component(Persistence_Subsystem, "Persistence Subsystem", "Point-in-time RDB snapshots", "Handles disaster recovery backups via point-in-time snapshots.")
}

Rel(RESP_Interface, In_Memory_Data_Store, "Routes client queries and updates to", "RESP Protocol")
Rel(In_Memory_Data_Store, Key_Eviction_Engine, "Triggers eviction policies when memory thresholds are approached", "Internal")
Rel(In_Memory_Data_Store, Persistence_Subsystem, "Backs up state using", "RDB Snapshots")

@enduml