@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Integration Worker with ACL container

System_Ext(AzureServiceBus, "Azure Service Bus", "Azure Service Bus")
System_Ext(LegacyMainframe, "Legacy Mainframe COBOL/DB2 System", "External System")

Container_Boundary(IntegrationWorkerWithACL, "Integration Worker with ACL") {
    Component(EventConsumer, "Event Consumer", "Node.js, TypeScript, Azure Service Bus SDK", "Consumes asynchronous domain events from the Azure Service Bus and triggers integration workflows.")
    Component(AntiCorruptionLayerACL, "Anti-Corruption Layer (ACL)", "Node.js, TypeScript", "Translates modern domain models into legacy mainframe formats and isolates the volatile mainframe system.")
    Component(LegacySyncAdapter, "Legacy Sync Adapter", "Node.js, mTLS", "Secures communication and synchronizes data using batch payloads with the Legacy Mainframe COBOL/DB2 System.")
}

Rel(AzureServiceBus, EventConsumer, "Triggers asynchronous integration tasks", "AMQP")
Rel(EventConsumer, AntiCorruptionLayerACL, "Forwards consumed domain events for data transformation", "")
Rel(AntiCorruptionLayerACL, LegacySyncAdapter, "Sends translated batch payloads to the legacy communication adapter", "")
Rel(LegacySyncAdapter, LegacyMainframe, "Synchronizes data using batch payloads", "mTLS")
@enduml