@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(ModularMonolith, "Modular Monolith", "Node.js, TypeScript container", "Application interacting with the database")
System_Ext(AzureKeyVault, "Azure Key Vault", "Secrets management", "Stores keys for encryption")
System_Ext(AzureMonitor, "Azure Monitor", "Monitoring", "Collects logs and telemetry")

Container_Boundary(azure_sql_database, "Azure SQL Database") {
    Component(CoreSchema, "Core Schema", "Azure SQL Engine", "Primary relational data store for transactional data.")
    Component(OutboxSchema, "Outbox Schema", "Azure SQL Engine", "Transactional Outbox Table for domain event management.")
    Component(AuditSchema, "Audit Schema", "Azure SQL Engine", "Stores audit logs and telemetry data.")
}

Rel(ModularMonolith, CoreSchema, "Persists relational data", "Entity Framework Core, T-SQL over encrypted TDS, Managed Identities")
Rel(ModularMonolith, OutboxSchema, "Persists domain events", "Entity Framework Core, T-SQL over encrypted TDS, Managed Identities")
Rel(CoreSchema, AzureKeyVault, "Secures data encryption", "Transparent Data Encryption with Customer-Managed Keys")
Rel(CoreSchema, AzureMonitor, "Streams audit logs and telemetry", "TLS-secured log streaming")

@enduml