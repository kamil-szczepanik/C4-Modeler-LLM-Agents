@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(Adjuster_BFF, "Adjuster BFF") {
    Component(HTTP_Router_and_Request_Handler, "HTTP Router and Request Handler", "Node.js, TypeScript, Express.js", "Handles incoming HTTP routing from the Azure API Management Gateway and exposes endpoints for the adjuster web application.")
    Component(Reactive_Stream_Coordinator, "Reactive Stream Coordinator", "RxJS, Node.js", "Coordinates asynchronous I/O and reactive data streams to aggregate hybrid data sources without blocking the event loop.")
    Component(Cache_Manager, "Cache Manager", "Redis Cache, node-cache", "Manages transient claim state and caches legacy segments to meet sub-two-second latency SLAs.")
    Component(Legacy_Integration_Client, "Legacy Integration Client", "Node.js, TypeScript, HTTPS", "Fetches fallback legacy claim data and masks legacy mainframe latency from the integration layer.")
}

Rel(HTTP_Router_and_Request_Handler, Reactive_Stream_Coordinator, "Delegates request processing and data aggregation", "RxJS streams")
Rel(Reactive_Stream_Coordinator, Cache_Manager, "Retrieves and stores transient claim state and cached legacy segments", "TCP, TLS")
Rel(Reactive_Stream_Coordinator, Legacy_Integration_Client, "Requests fallback legacy claim data when needed", "HTTPS")

@enduml