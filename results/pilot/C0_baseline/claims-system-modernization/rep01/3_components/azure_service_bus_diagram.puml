@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Azure Service Bus container

Container_Boundary(azure_service_bus, "Azure Service Bus") {
    Component(Partitioned Topics Manager, "Partitioned Topics Manager", "Azure Service Bus Premium", "Handles asynchronous messaging and partitioned pub/sub routing.")
    Component(Session Handler, "Session Handler", "Azure Service Bus Premium", "Manages message sessions to ensure ordered processing of claim events.")
}

Rel(Partitioned Topics Manager, Session Handler, "Delegates ordered messages to", "")

@enduml