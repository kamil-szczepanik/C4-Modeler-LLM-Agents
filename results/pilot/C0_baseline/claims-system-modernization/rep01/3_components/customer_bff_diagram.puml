@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Customer BFF", "Customer BFF") {
    Component(Authentication_Controller, "Authentication Controller", "Node.js, TypeScript", "Handles incoming OAuth2/OIDC authentication and request context.")
    Component(Claim_Submission_Router, "Claim Submission Router", "Node.js, TypeScript", "Routes online claim submissions to appropriate downstream handlers.")
    Component(Downstream_Orchestrator, "Downstream Orchestrator", "Node.js, TypeScript", "Orchestrates claim operations and forwards requests to the Modular Monolith.")
    Component(Routing_Anti_Corruption_Layer_ACL, "Routing Anti-Corruption Layer (ACL)", "Node.js, TypeScript", "Translates and adapts requests to bridge hybrid legacy migration complexities.")
    Component(Validation_and_Sanitization_Component, "Validation and Sanitization Component", "Zod", "Performs TypeScript-first schema validation for strict payload sanitization.")
    Component(State_Cache_Manager, "State Cache Manager", "Redis Cache", "Persists multi-step wizard state for session recovery.")
    Component(Asset_Direct_Upload_Handler, "Asset Direct-Upload Handler", "Azure Blob Storage, SAS Tokens", "Issues SAS tokens and coordinates direct-to-cloud asset uploads.")
}

Rel(Claim_Submission_Router, Validation_and_Sanitization_Component, "Validates and sanitizes payloads", "")
Rel(Claim_Submission_Router, State_Cache_Manager, "Persists multi-step wizard state", "")
Rel(Claim_Submission_Router, Asset_Direct_Upload_Handler, "Issues SAS tokens for direct media uploads", "")
Rel(Downstream_Orchestrator, Routing_Anti_Corruption_Layer_ACL, "Adapts and forwards validated claim operations", "")

@enduml