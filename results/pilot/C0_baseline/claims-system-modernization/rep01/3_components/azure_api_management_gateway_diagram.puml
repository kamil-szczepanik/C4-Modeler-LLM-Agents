@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(apim_gateway, "Azure API Management Gateway") {
    Component(Policy_Enforcer, "Policy Enforcer", "Azure API Management", "Enforces security policies and validates JWT tokens for incoming requests.")
    Component(Request_Router, "Request Router", "Azure API Management", "Routes validated client requests to the appropriate downstream BFF.")
    Component(Transformation, "Transformation", "Azure API Management / Liquid Templates", "Transforms request and response payloads using Liquid templates.")
    Component(Telemetry_Publisher, "Telemetry Publisher", "Azure API Management", "Publishes operational telemetry and metrics for monitoring.")
}

Rel(Policy_Enforcer, Request_Router, "Validates and passes requests")
Rel(Request_Router, Transformation, "Routes requests for payload transformation")

@enduml