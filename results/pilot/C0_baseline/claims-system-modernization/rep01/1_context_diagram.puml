@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Insurance Claims Modernization

Person(Policyholders_and_Brokers, "Policyholders and Brokers", "Users who submit claims and interact with the insurance system online.")
Person(Claims_Adjusters, "Claims Adjusters", "Users who process and manage claims using modern workflows.")
System_Ext(On_Premises_Active_Directory, "On-Premises Active Directory", "Identity provider used for enterprise authentication and synchronization via Azure AD Connect.")
System_Ext(Legacy_Mainframe_COBOL_DB2_System, "Legacy Mainframe COBOL/DB2 System", "30-year-old system of record that maintains core data and is integrated via an Anti-Corruption Layer.")
System(Azure_Claims_Modernization_System, "Azure Claims Modernization System", "Cloud-native Azure platform hosting the web frontend, APIs, and business logic.")
System(Anti_Corruption_Layer_ACL_Azure_Service_Bus, "Anti-Corruption Layer (ACL) & Azure Service Bus", "Integration containers handling secure, asynchronous communication and data translation with the legacy mainframe.")

Rel(Policyholders_and_Brokers, Azure_Claims_Modernization_System, "Interact with Azure Web Frontend to submit claims and view status", "HTTPS")
Rel(Claims_Adjusters, Azure_Claims_Modernization_System, "Use Azure Web App with SSO for claim management workflows", "HTTPS, OpenID Connect / SAML")
Rel(Anti_Corruption_Layer_ACL_Azure_Service_Bus, Legacy_Mainframe_COBOL_DB2_System, "Communicates via asynchronous messaging and data synchronization", "mTLS")
Rel(On_Premises_Active_Directory, Azure_Claims_Modernization_System, "Synchronizes identity data and provides Single Sign-On", "Azure AD Connect, OpenID Connect / SAML")
@enduml