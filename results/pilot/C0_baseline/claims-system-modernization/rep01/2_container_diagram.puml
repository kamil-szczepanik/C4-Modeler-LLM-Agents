@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Insurance Claims Modernization System

Person(PolicyholdersAndBrokers, "Policyholders and Brokers", "Users who submit claims and interact with the insurance system online.")
Person(ClaimsAdjusters, "Claims Adjusters", "Users who process and manage claims using modern workflows.")

System_Ext(OnPremisesActiveDirectory, "On-Premises Active Directory", "Identity provider used for enterprise authentication.")
System_Ext(LegacyMainframeCOBOLDB2System, "Legacy Mainframe COBOL/DB2 System", "30-year-old system of record maintaining core data.")

System_Boundary(InsuranceClaimsModernizationSystem, "Insurance Claims Modernization System") {
    Container(ReactSinglePageApplicationSPA, "React Single-Page Application (SPA)", "React, Azure Blob Storage, CDN", "Frontend interface hosted for policyholders, brokers, and claims adjusters.")
    Container(CustomerBFF, "Customer BFF", "Node.js, TypeScript", "Backend-for-Frontend service for policyholders and brokers.")
    Container(AdjusterBFF, "Adjuster BFF", "Node.js, TypeScript", "Backend-for-Frontend service for claims adjusters.")
    Container(AzureAPIManagementGateway, "Azure API Management Gateway", "Azure API Management, OAuth2/OIDC", "Routes client requests and secures API endpoints.")
    Container(ModularMonolith, "Modular Monolith", "Node.js, TypeScript", "Core backend service handling domain logic and business operations.")
    Container(AzureServiceBus, "Azure Service Bus", "Azure Service Bus", "Handles asynchronous event distribution and messaging.")
    Container(IntegrationWorkerwithACL, "Integration Worker with ACL", "Node.js, mTLS", "Anti-Corruption Layer worker that synchronizes data with the legacy mainframe.")
    Container(RedisCache, "Redis Cache", "Redis Cache", "Caches read-model projections for fast retrieval.")
    ContainerDb(AzureSQLDatabase, "Azure SQL Database", "Azure SQL Database, Transactional Outbox", "Transactional data store ensuring guaranteed consistency.")
}

Rel(PolicyholdersAndBrokers, ReactSinglePageApplicationSPA, "Interacts with SPA for digital claim submissions and status tracking", "HTTPS")
Rel(ClaimsAdjusters, ReactSinglePageApplicationSPA, "Interacts with SPA for fast claim processing workflows", "HTTPS")
Rel(ReactSinglePageApplicationSPA, AzureAPIManagementGateway, "Sends client API requests", "HTTPS")
Rel(AzureAPIManagementGateway, CustomerBFF, "Routes customer requests", "HTTPS, OAuth2/OIDC")
Rel(AzureAPIManagementGateway, AdjusterBFF, "Routes adjuster requests", "HTTPS, OAuth2/OIDC")
Rel(CustomerBFF, ModularMonolith, "Invokes core domain operations", "HTTP/REST")
Rel(AdjusterBFF, ModularMonolith, "Invokes core domain operations", "HTTP/REST")
Rel(ModularMonolith, AzureServiceBus, "Publishes and consumes asynchronous events", "AMQP")
Rel(ModularMonolith, AzureSQLDatabase, "Persists transactional data using outbox pattern", "T-SQL")
Rel(ModularMonolith, RedisCache, "Reads and writes read-model projections", "Redis Protocol")
Rel(AzureServiceBus, IntegrationWorkerwithACL, "Triggers asynchronous integration tasks", "AMQP")
Rel(IntegrationWorkerwithACL, LegacyMainframeCOBOLDB2System, "Synchronizes data using file/batch payloads", "mTLS")
Rel(OnPremisesActiveDirectory, AzureAPIManagementGateway, "Authenticates users via identity federation", "OAuth2/OIDC")

@enduml