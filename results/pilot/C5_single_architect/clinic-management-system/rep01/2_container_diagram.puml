@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Clinic_Staff, "Clinic Staff", "Primary internal users accessing the system to manage clinical and administrative workflows.")
Person(Patients, "Patients", "External users interacting via a web and mobile portal for admissions, records, and scheduling.")

System_Ext(Insurance_Gateways, "Insurance Gateways", "External systems processing billing claims via secure protocols.")
System_Ext(Lab_and_Imaging_Systems, "Lab and Imaging Systems", "External diagnostic systems integrated via HL7 FHIR standards.")
System_Ext(Identity_Provider, "Identity Provider", "Enterprise authentication service managing OAuth 2.0 and OpenID Connect.")

System_Boundary(Clinic_Management_System, "Clinic Management System") {
    Container(Single_Page_Application, "Single Page Application", "React", "Provides high-performance, responsive UI for clinical staff and patients.")
    Container(API_Gateway, "API Gateway", "Edge Routing, OAuth2/OIDC", "Handles edge routing and OAuth2/OIDC authentication.")
    Container(Patient_Management_Microservice, "Patient Management Microservice", "Kubernetes, Microservice", "Manages patient admissions and profile information.")
    Container(EMR_Microservice, "EMR Microservice", "Kubernetes, Microservice", "Manages electronic medical records.")
    Container(Scheduling_Microservice, "Scheduling Microservice", "Kubernetes, Microservice", "Manages scheduling and real-time appointment clash checks.")
    Container(Billing_Microservice, "Billing Microservice", "Kubernetes, Microservice", "Manages billing and financial transactions.")
    Container(HL7_FHIR_Integration_Container, "HL7 FHIR Integration Container", "Apache Camel", "Standardizes internal data into HL7 FHIR resources for clinical interoperability.")
    ContainerDb(PostgreSQL_Database, "PostgreSQL Database", "PostgreSQL, AES-256", "Provides relational storage with AES-256 encryption for HIPAA/GDPR compliance.")
    ContainerDb(Redis_Cache, "Redis Cache", "Redis", "Delivers low-latency in-memory caching for real-time appointment scheduling clash checks.")
    ContainerDb(Elasticsearch_Audit_Trail, "Elasticsearch Audit Trail", "Elasticsearch", "Implements append-only, immutable storage for mandatory 10-year audit trails.")
    Container(Messaging_Backbone, "Messaging Backbone", "Apache Kafka", "Enables asynchronous, decoupled event-driven communication across services.")
}

Rel(Clinic_Staff, Single_Page_Application, "Interacts via HTTPS", "HTTPS, TLS 1.3")
Rel(Patients, Single_Page_Application, "Interacts via HTTPS", "HTTPS, TLS 1.3")
Rel(Single_Page_Application, API_Gateway, "Connects to API Gateway for routing and authentication", "HTTPS, OAuth2/OIDC")
Rel(API_Gateway, Patient_Management_Microservice, "Routes requests", "gRPC, mTLS")
Rel(API_Gateway, EMR_Microservice, "Routes requests", "gRPC, mTLS")
Rel(API_Gateway, Scheduling_Microservice, "Routes requests", "gRPC, mTLS")
Rel(API_Gateway, Billing_Microservice, "Routes requests", "gRPC, mTLS")
Rel(Patient_Management_Microservice, PostgreSQL_Database, "Persists data", "PostgreSQL")
Rel(EMR_Microservice, PostgreSQL_Database, "Persists data", "PostgreSQL")
Rel(Scheduling_Microservice, PostgreSQL_Database, "Persists data", "PostgreSQL")
Rel(Billing_Microservice, PostgreSQL_Database, "Persists data", "PostgreSQL")
Rel(Scheduling_Microservice, Redis_Cache, "Caches states and checks schedules", "Redis")
Rel(Patient_Management_Microservice, Messaging_Backbone, "Publishes domain events", "Apache Kafka")
Rel(EMR_Microservice, Messaging_Backbone, "Publishes domain events", "Apache Kafka")
Rel(Scheduling_Microservice, Messaging_Backbone, "Publishes domain events", "Apache Kafka")
Rel(Billing_Microservice, Messaging_Backbone, "Publishes domain events", "Apache Kafka")
Rel(HL7_FHIR_Integration_Container, Lab_and_Imaging_Systems, "Communicates diagnostic data and results", "HL7 FHIR APIs")
Rel(Billing_Microservice, Insurance_Gateways, "Submits billing claims", "HTTPS, REST")
Rel(API_Gateway, Identity_Provider, "Validates authentication and tokens", "OAuth2/OIDC")

@enduml