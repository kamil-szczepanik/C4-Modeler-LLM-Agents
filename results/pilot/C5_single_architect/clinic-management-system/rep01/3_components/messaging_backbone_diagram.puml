@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Messaging Backbone container

System_Ext(Microservices, "Microservices", "External microservices producing and consuming events.")
System_Ext(PostgreSQL_Elasticsearch, "PostgreSQL Replicas and Elasticsearch Audit Trail", "External data sinks for persistence and auditing.")
System_Ext(OnPrem_K8s, "On-Premises Kubernetes Cluster", "External on-premises deployment environment.")
System_Ext(AWS_Cloud, "AWS eu-central-1", "External cloud disaster recovery environment.")
System_Ext(Scheduling_Audit_Sinks, "Scheduling and Audit Sinks", "External sinks for scheduling data and audit logs.")

Container_Boundary(messaging_backbone, "Messaging Backbone") {
    Component(TopicPartitionManager, "Topic Partition Manager", "Apache Kafka", "Core messaging backbone for decoupled event-driven communication.")
    Component(ConfluentSchemaRegistry, "Confluent Schema Registry", "Confluent Schema Registry", "Enforces strict Avro schemas for HIPAA-compliant payload validation.")
    Component(KafkaConnectEngine, "Kafka Connect Engine", "Kafka Connect", "Secures encrypted data sinks using TLS 1.3 and SCRAM-SHA-512 authentication.")
    Component(MirrorMaker2, "MirrorMaker 2", "MirrorMaker 2", "Facilitates cross-cluster replication for active-active hybrid disaster recovery.")
    Component(ApacheKafkaStreams, "Apache Kafka Streams", "Apache Kafka Streams", "Executes real-time PHI masking and scheduling clash detection.")
}

Rel(Microservices, ConfluentSchemaRegistry, "Validates event payloads synchronously", "Avro, HTTP/REST")
Rel(KafkaConnectEngine, PostgreSQL_Elasticsearch, "Streams persistent records securely", "TLS 1.3, SCRAM-SHA-512")
Rel(OnPrem_K8s, AWS_Cloud, "Synchronizes clinical event streams via MirrorMaker 2", "TLS 1.3")
Rel(ApacheKafkaStreams, Scheduling_Audit_Sinks, "Performs real-time resource clash checks and PHI data masking", "In-memory processing")

@enduml