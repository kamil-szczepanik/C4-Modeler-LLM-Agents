@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "External API Gateway")
System_Ext(postgresql_db, "PostgreSQL Database", "External Database")
System_Ext(kafka, "Apache Kafka", "External Messaging Backbone")

Container_Boundary(scheduling_microservice, "Scheduling Microservice") {
    Component(AppointmentController, "AppointmentController", "gRPC with OAuth2/OIDC", "Handles incoming gRPC routing from the API Gateway with OAuth2/OIDC.")
    Component(SchedulingEngine, "SchedulingEngine", "Go", "Executes concurrent resource clash detection using an in-memory interval tree.")
    Component(SlotManager, "SlotManager", "Redis", "Interfaces with Redis for low-latency availability state checks.")
    Component(AppointmentRepository, "AppointmentRepository", "PostgreSQL", "Manages ACID-compliant persistence and field-level PII cryptographic masking in PostgreSQL.")
    Component(AuditInterceptor, "AuditInterceptor", "Apache Kafka, Elasticsearch", "Intercepts state-changing requests to generate cryptographically-signed audit logs routed to Elasticsearch via Apache Kafka.")
}

Rel(api_gateway, AppointmentController, "Routes incoming requests", "gRPC with mTLS")
Rel(SchedulingEngine, SlotManager, "Evaluates availability states", "in-process memory calls")
Rel(AppointmentRepository, postgresql_db, "Persists appointment data", "PostgreSQL protocol with AES-256 encryption")
Rel(AppointmentRepository, kafka, "Publishes domain events and audit logs asynchronously", "Messaging Backbone")

@enduml