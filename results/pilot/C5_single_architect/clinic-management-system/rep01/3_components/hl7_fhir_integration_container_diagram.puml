@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(hl7_fhir_integration_container, "HL7 FHIR Integration Container") {
    Component(Inbound_FHIR_Router, "Inbound FHIR Router", "Apache Camel", "Parses and forwards incoming payloads using Camel Direct Endpoints.")
    Component(Data_Mapper, "Data Mapper", "Apache Camel", "Transforms and formats payloads between external formats and FHIR resources.")
    Component(FHIR_Validation_Compliance_Engine, "FHIR Validation & Compliance Engine", "Apache Camel & HAPI FHIR", "Evaluates resource integrity and checks adherence to clinical compliance standards.")
    Component(Outbound_Dispatcher, "Outbound Dispatcher", "Apache Camel", "Queues validated payloads via Camel SEDA Queues for delivery.")
}

Rel(Inbound_FHIR_Router, Data_Mapper, "Parses and forwards incoming payloads", "Camel Direct Endpoints")
Rel(Data_Mapper, FHIR_Validation_Compliance_Engine, "Evaluates resource integrity", "Camel Direct Endpoints")
Rel(FHIR_Validation_Compliance_Engine, Outbound_Dispatcher, "Queues validated payloads", "Camel SEDA Queues")

@enduml