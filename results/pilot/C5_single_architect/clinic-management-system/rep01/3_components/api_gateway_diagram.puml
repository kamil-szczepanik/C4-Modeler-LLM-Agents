@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the API Gateway container

Container_Boundary(api_gateway, "API Gateway") {
    Component(EdgeRouterComponent, "Edge Router Component", "Envoy routing tables, HTTP/2, gRPC", "Routes internal traffic and handles high-performance edge routing.")
    Component(AuthFilterComponent, "Auth Filter Component", "JWT validation, RBAC", "Validates tokens and enforces role-based access control.")
    Component(RateLimiterComponent, "Rate Limiter Component", "Redis, local token-bucket", "Executes distributed sliding window checks and controls traffic.")
    Component(AuditLoggerComponent, "Audit Logger Component", "Apache Kafka", "Emits structured compliance logs asynchronously.")
}

System(PatientManagementMicroservice, "Patient Management Microservice", "Microservice")
System(EMRMicroservice, "EMR Microservice", "Microservice")
System(SchedulingMicroservice, "Scheduling Microservice", "Microservice")
System(BillingMicroservice, "Billing Microservice", "Microservice")
System_Ext(MessagingBackbone, "Messaging Backbone", "Apache Kafka")
System_Ext(RedisCache, "Redis Cache", "Redis")

Rel(EdgeRouterComponent, PatientManagementMicroservice, "Routes internal traffic", "gRPC, mTLS")
Rel(EdgeRouterComponent, EMRMicroservice, "Routes internal traffic", "gRPC, mTLS")
Rel(EdgeRouterComponent, SchedulingMicroservice, "Routes internal traffic", "gRPC, mTLS")
Rel(EdgeRouterComponent, BillingMicroservice, "Routes internal traffic", "gRPC, mTLS")
Rel(AuditLoggerComponent, MessagingBackbone, "Emits structured compliance logs asynchronously", "TCP")
Rel(RateLimiterComponent, RedisCache, "Executes distributed sliding window checks", "Redis Protocol")

@enduml