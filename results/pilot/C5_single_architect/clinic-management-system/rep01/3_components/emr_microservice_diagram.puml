@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the EMR Microservice container

System_Ext(api_gateway, "API Gateway", "External API Gateway routing traffic.")
System_Ext(postgresql_database, "PostgreSQL Database", "Stores patient data securely.")
System_Ext(redis_cache, "Redis Cache", "Provides fast in-memory caching.")
System_Ext(elasticsearch_audit, "Elasticsearch Audit Trail", "Stores compliance logs securely.")
System_Ext(messaging_backbone, "Messaging Backbone", "Handles asynchronous event distribution.")
System_Ext(lab_imaging_systems, "Lab & Imaging Systems", "External clinical systems.")

Container_Boundary(emr_microservice, "EMR Microservice") {
    Component(emr_controller, "EMR Controller", "Spring Boot, Java 17", "Manages incoming API requests and routes them within the EMR microservice.")
    Component(medical_record_manager, "Medical Record Manager", "Spring Boot, Java 17", "Handles business logic for processing and persisting patient medical records.")
    Component(audit_trail_generator, "Audit Trail Generator", "Spring Boot, Java 17", "Generates strict compliance logs for HIPAA and GDPR adherence.")
    Component(fhir_transformer, "FHIR Transformer", "Spring Boot, Java 17", "Integrates and transforms clinical data using HL7 FHIR standards.")
    Component(emr_cache_manager, "EMR Cache Manager", "Spring Cache, Java 17", "Manages caching mechanisms to ensure sub-second screen load times.")
    Component(event_publisher, "Event Publisher", "Spring Cloud Stream, Java 17", "Publishes domain events asynchronously to the messaging backbone.")
}

Rel(api_gateway, emr_controller, "Routes requests", "gRPC, mTLS")
Rel(medical_record_manager, postgresql_database, "Persists patient data", "JDBC, AES-256")
Rel(emr_cache_manager, redis_cache, "Retrieves cached records", "Redis Protocol, TLS")
Rel(audit_trail_generator, elasticsearch_audit, "Writes compliance logs", "REST, TLS")
Rel(event_publisher, messaging_backbone, "Publishes domain events", "Apache Kafka, TLS")
Rel(fhir_transformer, lab_imaging_systems, "Integrates clinical data", "HL7 FHIR APIs")

@enduml