@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "External API Gateway routing incoming traffic")
System_Ext(postgresql_database, "PostgreSQL Database", "External relational database with AES-256 encryption")
System_Ext(messaging_backbone, "Messaging Backbone", "External Apache Kafka event backbone")
System_Ext(insurance_gateways, "Insurance Gateways", "External insurance provider systems")

Container_Boundary(billing_microservice, "Billing Microservice") {
    Component(BillingController, "BillingController", "Spring MVC", "Spring MVC component handling incoming gRPC/REST endpoints from the API Gateway.")
    Component(ClaimProcessingService, "ClaimProcessingService", "Java", "Core business logic component orchestrating invoice generation and state transitions.")
    Component(InsuranceGatewayClient, "InsuranceGatewayClient", "Resilience4j WebClient", "Resilience4j-wrapped WebClient managing external HTTPS/REST communication.")
    Component(BillingRepository, "BillingRepository", "Spring Data JPA", "Spring Data JPA component managing secure database persistence.")
    Component(TokenizationService, "TokenizationService", "Token Vault", "Component isolating and handling patient financial instruments and credit card data via a token vault.")
    Component(ClaimStatusListener, "ClaimStatusListener", "Spring Kafka", "Spring Kafka message listener component consuming asynchronous updates from the Messaging Backbone.")
    Component(KafkaEventPublisher, "KafkaEventPublisher", "Apache Kafka", "Component publishing financial domain events.")
}

Rel(api_gateway, BillingController, "Routes incoming requests", "gRPC, mTLS")
Rel(BillingRepository, postgresql_database, "Persists financial data", "PostgreSQL, AES-256")
Rel(KafkaEventPublisher, messaging_backbone, "Publishes domain events", "Apache Kafka")
Rel(InsuranceGatewayClient, insurance_gateways, "Submits billing claims", "HTTPS, REST")
Rel(messaging_backbone, ClaimStatusListener, "Consumes claim status updates", "Apache Kafka")

@enduml