@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Elasticsearch Audit Trail container

Container_Boundary(elasticsearch_audit_trail, "Elasticsearch Audit Trail") {
    Component(Audit_Event_Ingestor, "Audit Event Ingestor", "Logstash / Elasticsearch Ingest Node", "Parses and normalizes incoming security logs and consumes security events from the Messaging Backbone.")
    Component(Index_Lifecycle_Manager, "Index Lifecycle Manager", "Elasticsearch ILM Policies", "Interacts with AES-256 encrypted storage for automated index tiering and ensures WORM constraints.")
    Component(Compliance_Query_API, "Compliance Query API", "Elasticsearch REST / JSON, TLS 1.3, OpenID Connect", "Serves secure read requests to administrators and enforces access control via OIDC tokens.")
    Component(Messaging_Backbone, "Messaging Backbone", "Apache Kafka", "Ensures reliable, high-throughput event streaming via Kafka Connect.")
    Component(Identity_Provider, "Identity Provider", "OIDC / OAuth2", "Provides identity and authentication services for secure access.")
}

Rel(Audit_Event_Ingestor, Messaging_Backbone, "Consumes security events from Messaging Backbone via Kafka Connect protocol", "Kafka Connect protocol")
Rel(Index_Lifecycle_Manager, Audit_Event_Ingestor, "Manages indices and automated tiering for stored security logs", "ILM Policies")
Rel(Compliance_Query_API, Identity_Provider, "Authenticates requests using OpenID Connect tokens via TLS 1.3", "TLS 1.3 / OIDC")

@enduml