@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(Scheduling_Microservice, "Scheduling Microservice", "External microservice that interacts with the cache layer.")

Container_Boundary(Redis_Cache, "Redis Cache") {
    Component(Redis_Cluster_Manager, "Redis Cluster Manager", "Redis Enterprise", "Manages distributed clustering, high availability, and failover for caching layers.")
    Component(Data_Structures_Engine, "Data Structures Engine", "Hashes, Sorted Sets", "Stores and retrieves structured session and scheduling cache data efficiently.")
    Component(L1_In_Memory_Cache_Wrapper, "L1 In-Memory Cache Wrapper", "In-memory wrapper", "Provides ultra-low latency local application caching alongside Redis Enterprise.")
}

Rel(Scheduling_Microservice, Redis_Cluster_Manager, "Sends RESP3 over TLS, TCP requests for caching and distributed locking", "RESP3 over TLS, TCP")
Rel(Redis_Cluster_Manager, Data_Structures_Engine, "Persists and queries hashes and sorted sets", "")
Rel(Data_Structures_Engine, L1_In_Memory_Cache_Wrapper, "Synchronizes local in-memory cache wrapper data", "")

@enduml