@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient Management Microservice container

Container_Boundary(patient_management_microservice, "Patient Management Microservice") {
    Component(PatientController, "PatientController", "Spring Boot Controller", "Handles incoming HTTP/gRPC requests, routing them to the service layer.")
    Component(PatientService, "PatientService", "Java 21, Spring Boot Service", "Encapsulates the core business logic for patient admissions and demographic capture.")
    Component(PatientRepository, "PatientRepository", "Spring Data JPA, Hibernate, JDBC", "Executes data persistence operations against the PostgreSQL database.")
    Component(PatientCacheManager, "PatientCacheManager", "Redis, Lettuce Drivers", "Manages fast in-memory caching to meet sub-second performance constraints.")
    Component(AuditLogger, "AuditLogger", "Java Logging / HTTP/S Client", "Emits security and compliance audit logs to the Elasticsearch Audit Trail.")
}

System_Ext(Messaging_Backbone, "Messaging Backbone", "Apache Kafka")
System_Ext(Elasticsearch_Audit_Trail, "Elasticsearch Audit Trail", "Elasticsearch")

Rel(PatientController, PatientService, "Delegates requests", "In-memory method calls")
Rel(PatientService, PatientRepository, "Executes queries", "Hibernate/JPA, JDBC over TLS 1.3")
Rel(PatientService, PatientCacheManager, "Manages cache", "Lettuce drivers")
Rel(PatientService, Messaging_Backbone, "Publishes domain events", "Apache Kafka, JSON, TCP")
Rel(AuditLogger, Elasticsearch_Audit_Trail, "Emits audit logs", "HTTP/S")

@enduml