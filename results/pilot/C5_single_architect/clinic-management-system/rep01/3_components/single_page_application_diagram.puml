@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Single Page Application container

System_Ext(api_gateway, "API Gateway", "Edge Routing, OAuth2/OIDC")

Container_Boundary(spa, "Single Page Application") {
    Component(ui_router_and_controller, "UI Router and Controller", "React Router", "Manages client-side routing, view rendering, and user session state for clinic staff and patients.")
    Component(authentication_client, "Authentication Client", "OAuth2/OIDC JS SDK", "Handles user login, token acquisition, and secure storage of JWT tokens for API communication.")
    Component(api_communication_service, "API Communication Service", "Axios / Fetch API", "Executes secure HTTPS requests carrying TLS 1.3 and JWT credentials to the API Gateway.")
}

Rel(ui_router_and_controller, authentication_client, "Triggers authentication and token management", "")
Rel(ui_router_and_controller, api_communication_service, "Requests data fetching and mutations", "")
Rel(api_communication_service, api_gateway, "Sends HTTPS requests with OAuth2/OIDC JWT", "HTTPS, OAuth2/OIDC, JWT")

@enduml