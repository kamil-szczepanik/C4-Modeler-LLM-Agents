@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Clinic Management System

Person(ClinicStaff, "Clinic Staff", "Primary internal users accessing the system to manage clinical and administrative workflows.")
Person(Patients, "Patients", "External users interacting via a web and mobile portal for admissions, records, and scheduling.")

System(ClinicManagementSystem, "Clinic Management System", "A hybrid cloud platform designed to handle patient admissions, electronic medical records, scheduling, and billing for medium-sized hospitals and clinics while ensuring HIPAA and GDPR compliance.")

System_Ext(InsuranceGateways, "Insurance Gateways", "External systems processing billing claims via secure REST and EDI protocols.")
System_Ext(LabandImagingSystems, "Lab and Imaging Systems", "External diagnostic systems integrated via HL7 FHIR standards.")
System_Ext(IdentityProvider, "Identity Provider", "Enterprise authentication service (Keycloak or Auth0) managing OAuth 2.0 and OpenID Connect.")
System_Ext(MessageQueues, "Message Queues", "Apache Kafka and AWS SQS handling asynchronous claim submissions.")

Rel(ClinicStaff, ClinicManagementSystem, "Interacts via HTTPS and MFA over TLS 1.3", "HTTPS, MFA, TLS 1.3")
Rel(Patients, ClinicManagementSystem, "Accesses patient portal via web and mobile interface", "HTTPS, TLS 1.3")
Rel(ClinicManagementSystem, InsuranceGateways, "Submits billing claims via secure REST/EDI using mutual TLS", "REST, EDI, mTLS")
Rel(ClinicManagementSystem, LabandImagingSystems, "Communicates diagnostic data and results", "HL7 FHIR")
Rel(ClinicManagementSystem, IdentityProvider, "Authenticates users via federation", "OAuth 2.0, OpenID Connect, TLS 1.3")
Rel(ClinicManagementSystem, MessageQueues, "Decouples asynchronous claim submissions", "Apache Kafka, AWS SQS")

@enduml