@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Patients, "Patients", "Self-Service Portal users interacting for registration and scheduling.")
Person(Clinical Staff, "Clinical Staff", "Front Desk Receptionists, Clinicians, and Billing Specialists managing clinical workflows.")
Person(Hospital Administrators, "Hospital Administrators", "Dashboard and Audit users overseeing system management and compliance.")

System_Ext(External Lab and Imaging Systems, "External Lab and Imaging Systems", "External systems providing laboratory and imaging data.")
System_Ext(Third-Party Insurance Clearinghouses, "Third-Party Insurance Clearinghouses", "External clearinghouses for submitting and processing insurance claims.")

System_Boundary(Clinic_Management_System, "Clinic Management System") {
    Container(Global Anycast Load Balancer and API Gateways, "Global Anycast Load Balancer and API Gateways", "Kong", "Entry points for routing global traffic to the core infrastructure with secure high-performance ingress routing.")
    Container(Patient Portal, "Patient Portal", "Node.js, React", "Isolated, decoupled frontend administration for patients.")
    Container(EMR & Scheduling Service, "EMR & Scheduling Service", "Java Spring Boot", "Core EMR and scheduling for robust transactional integrity.")
    Container(Billing & Insurance Claim Service, "Billing & Insurance Claim Service", "Python FastAPI", "Dedicated billing service for optimized insurance workflows.")
    Container(HL7 FHIR Interoperability Engine, "HL7 FHIR Interoperability Engine", "Apache Camel", "Engine connecting to external lab and imaging systems using HL7 FHIR APIs over persistent TCP connections.")
    ContainerDb(Database Tier, "Database Tier", "PostgreSQL with PgBouncer, AES-256", "Primary data store with row-level security and pooling.")
    Container(Messaging & Audit Layer, "Messaging & Audit Layer", "Apache Kafka, FluentBit, S3", "Asynchronous event streaming ensuring fault tolerance and audit trails.")
    Container(Infrastructure & Mesh, "Infrastructure & Mesh", "Kubernetes, AWS eu-central-1, on-prem-k8s, Envoy sidecar", "Hybrid deployment orchestration, GitOps synchronization, and service mesh for mTLS and distributed tracing.")
}

Rel(Patients, Global Anycast Load Balancer and API Gateways, "Accesses the system via HTTPS", "HTTPS")
Rel(Clinical Staff, Global Anycast Load Balancer and API Gateways, "Accesses the system via HTTPS", "HTTPS")
Rel(Hospital Administrators, Global Anycast Load Balancer and API Gateways, "Accesses the system via HTTPS", "HTTPS")
Rel(Global Anycast Load Balancer and API Gateways, Patient Portal, "Routes ingress traffic to Patient Portal", "HTTPS")
Rel(Global Anycast Load Balancer and API Gateways, EMR & Scheduling Service, "Routes ingress traffic to EMR and scheduling", "HTTPS")
Rel(Global Anycast Load Balancer and API Gateways, Billing & Insurance Claim Service, "Routes ingress traffic to billing service", "HTTPS")
Rel(Patient Portal, EMR & Scheduling Service, "Communicates with backend services via gRPC", "gRPC over mutual TLS (mTLS)")
Rel(Patient Portal, Billing & Insurance Claim Service, "Communicates with backend services via gRPC", "gRPC over mutual TLS (mTLS)")
Rel(EMR & Scheduling Service, Messaging & Audit Layer, "Interacts asynchronously via events", "Apache Kafka")
Rel(Billing & Insurance Claim Service, Messaging & Audit Layer, "Interacts asynchronously via events", "Apache Kafka")
Rel(HL7 FHIR Interoperability Engine, External Lab and Imaging Systems, "Connects to external lab and imaging systems", "HL7 FHIR APIs over persistent TCP connections")
Rel(EMR & Scheduling Service, Database Tier, "Persists state to PostgreSQL clusters", "Encrypted TCP connections")
Rel(Billing & Insurance Claim Service, Database Tier, "Persists state to PostgreSQL clusters", "Encrypted TCP connections")

@enduml