@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

title System Context diagram for Clinic Management System

Person(Patients, "Patients", "Self-Service Portal users interacting for registration and scheduling.")
Person(Clinical_Staff, "Clinical Staff", "Front Desk Receptionists, Clinicians, and Billing Specialists managing clinical workflows.")
Person(Hospital_Administrators, "Hospital Administrators", "Dashboard and Audit users overseeing system management and compliance.")

System(Clinic_Management_System, "Clinic Management System", "A hybrid cloud platform designed to manage patient admissions, electronic medical records, scheduling, and billing for medium-sized hospitals and clinics.")

System_Ext(External_Lab_and_Imaging_Systems, "External Lab and Imaging Systems", "External systems providing laboratory and imaging data.")
System_Ext(Third_Party_Insurance_Clearinghouses, "Third-Party Insurance Clearinghouses", "External clearinghouses for submitting and processing insurance claims.")
System_Ext(Global_Anycast_Load_Balancer_and_API_Gateways, "Global Anycast Load Balancer and API Gateways", "Entry points for routing global traffic to the core infrastructure.")

Rel(Patients, Clinic_Management_System, "Interacts via Patient Portal for registration and scheduling", "HTTPS, OpenID Connect")
Rel(Clinical_Staff, Clinic_Management_System, "Accesses the system for clinical and billing operations", "HTTPS, OAuth 2.0 with MFA")
Rel(Hospital_Administrators, Clinic_Management_System, "Accesses the system via dashboard and audit tools", "HTTPS, OAuth 2.0 with MFA")
Rel(Clinic_Management_System, External_Lab_and_Imaging_Systems, "Exchanges clinical data using standardized interoperability protocols", "HL7 FHIR over mutual TLS (mTLS)")
Rel(Clinic_Management_System, Third_Party_Insurance_Clearinghouses, "Submits insurance claims", "Secure REST APIs over TLS 1.3")

@enduml