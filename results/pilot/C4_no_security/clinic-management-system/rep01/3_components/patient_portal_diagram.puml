@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(patient_portal, "Patient Portal") {
    Component(React_Next_js_SSR_Engine, "React, Next.js SSR Engine", "React, Next.js", "Delivers server-side rendered, mobile-responsive frontend views with sub-second performance.")
    Component(Node_js_Express_Portal_Gateway, "Node.js Express Portal Gateway", "Node.js, Express", "Powers the API gateway proxy and routes ingress traffic.")
    Component(Auth_Manager, "Auth Manager", "OAuth2/OIDC, HTTPS", "Handles session issuance and authentication.")
    Component(Notification_Dispatcher, "Notification Dispatcher", "Node.js, Apache Kafka", "Dispatches async alerts and handles event streaming.")
}

Rel(Node_js_Express_Portal_Gateway, Auth_Manager, "Handles session issuance", "HTTPS / OAuth2/OIDC")
Rel(React_Next_js_SSR_Engine, Node_js_Express_Portal_Gateway, "Routes API requests")
Rel(Node_js_Express_Portal_Gateway, Notification_Dispatcher, "Dispatches async alerts", "Apache Kafka")
@enduml