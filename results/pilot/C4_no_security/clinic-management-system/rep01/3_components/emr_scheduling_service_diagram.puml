@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the EMR & Scheduling Service container

Container_Boundary(emr_scheduling_service, "EMR & Scheduling Service") {
    Component(emr_controller, "EMR Controller", "Java Spring Boot", "Handles incoming API requests for patient admissions and Electronic Medical Records.")
    Component(scheduling_service, "Scheduling Service", "Java Spring Boot", "Manages clinical appointments and scheduling logic using Hexagonal Architecture.")
}

Rel(emr_controller, scheduling_service, "Delegates scheduling and clinical operations", "")

@enduml