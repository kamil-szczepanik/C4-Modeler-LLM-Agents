@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Infrastructure & Mesh container

Container_Boundary(infrastructure_mesh, "Infrastructure & Mesh") {
    Component(Kubernetes_Istio, "Kubernetes & Istio", "Kubernetes, Istio, Envoy sidecar", "Hybrid orchestration and service mesh for multi-cluster routing and mutual TLS (mTLS) enforcement.")
    Component(ArgoCD, "ArgoCD", "ArgoCD (GitOps)", "Manages GitOps synchronization across on-premise clusters and AWS eu-central-1.")
}

Rel(ArgoCD, Kubernetes_Istio, "Synchronizes configurations and deploys workloads", "")

@enduml