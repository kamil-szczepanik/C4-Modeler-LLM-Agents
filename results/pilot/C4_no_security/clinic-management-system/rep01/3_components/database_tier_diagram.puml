@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database Tier container

Container_Boundary(database_tier, "Database Tier") {
    Component(PgBouncer Connection Pooler, "PgBouncer Connection Pooler", "PgBouncer", "Manages and optimizes database connections for high-throughput clinical workflows.")
    Component(PostgreSQL Database Engine, "PostgreSQL Database Engine", "PostgreSQL with Patroni, AES-256", "Provides active-active high availability and stores encrypted clinical, financial, and lab data.")
    Component(Encryption Key Manager, "Encryption Key Manager", "HashiCorp Vault", "Manages AES-256 encryption keys for Transparent Data Encryption (TDE).")
}

Rel(PgBouncer Connection Pooler, PostgreSQL Database Engine, "Routes and pools database queries", "Encrypted TCP, TLS 1.3")
Rel(Encryption Key Manager, PostgreSQL Database Engine, "Supplies encryption keys for TDE", "Secure API")

@enduml