@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(hl7_fhir_interoperability_engine, "HL7 FHIR Interoperability Engine") {
    Component(FHIR_API_Router, "FHIR API Router", "Apache Camel REST DSL", "Routes incoming requests from the patient portal and external systems to the appropriate processing routes.")
    Component(HL7_Transformation_Engine, "HL7 Transformation Engine", "Apache Camel DataFormat", "Transforms incoming legacy HL7 messages into standardized FHIR resources.")
    Component(TCP_Integration_Connector, "TCP Integration Connector", "Apache Camel Netty", "Manages persistent TCP connections to external lab and imaging systems.")
    Component(Audit_Event_Publisher, "Audit Event Publisher", "Apache Camel Kafka Producer", "Publishes interoperability audit logs and integration events to the messaging layer.")
}

System_Ext(Messaging_Audit_Layer, "Messaging & Audit Layer", "Apache Kafka, FluentBit, S3")

Rel(FHIR_API_Router, HL7_Transformation_Engine, "Forwards payloads for transformation")
Rel(HL7_Transformation_Engine, TCP_Integration_Connector, "Sends processed messages over persistent TCP")
Rel(FHIR_API_Router, Audit_Event_Publisher, "Sends transaction logs")
Rel(Audit_Event_Publisher, Messaging_Audit_Layer, "Kafka Protocol over TCP")

@enduml