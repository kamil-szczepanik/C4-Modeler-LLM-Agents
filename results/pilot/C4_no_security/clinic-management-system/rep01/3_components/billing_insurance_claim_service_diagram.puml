@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing & Insurance Claim Service container

Container_Boundary(billing_service, "Billing & Insurance Claim Service") {
    Component(ClaimGenerationEngine, "Claim Generation Engine", "Python FastAPI", "Handles the core logic for generating medical claims and processing insurance information.")
    Component(ClearinghouseIntegrationAdaptor, "Clearinghouse Integration Adaptor", "Python Asyncio", "Interfaces with third-party insurance clearinghouses securely.")
}

Rel(ClaimGenerationEngine, ClearinghouseIntegrationAdaptor, "Asyncio/HTTPS with mTLS", "Asyncio/HTTPS with mTLS")

@enduml