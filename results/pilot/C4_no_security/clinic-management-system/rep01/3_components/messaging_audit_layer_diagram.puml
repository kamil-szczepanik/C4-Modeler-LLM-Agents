@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Messaging & Audit Layer container

Container_Boundary(messaging_audit_layer, "Messaging & Audit Layer") {
    Component(Event_Streaming_Broker, "Event Streaming Broker", "Apache Kafka (KRaft mode)", "Delivers resilient, ZooKeeper-free asynchronous event streaming and active-active cross-site replication.")
    Component(Log_Collection_Agent, "Log Collection Agent", "FluentBit", "Collects application logs and forwards them to long-term storage for auditing.")
    Component(Immutable_Object_Storage, "Immutable Object Storage", "AWS S3 / on-prem S3-compatible object storage", "Enforces 10-year WORM-compliant audit retention and immutable archiving.")
}

Rel(Event_Streaming_Broker, Immutable_Object_Storage, "Asynchronous event publishing and immutable archiving", "TLS and Parquet")
Rel(Log_Collection_Agent, Immutable_Object_Storage, "Archives collected logs for compliance", "HTTPS")

@enduml