@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "Patients who interact with the clinic for admissions, scheduling, and records.")
Person(Clinical_Staff, "Clinical Staff", "Medical professionals who manage electronic medical records and patient care.")
Person(Hospital_Administrators, "Hospital Administrators", "Administrators who oversee operations, billing, and system management.")

System(Clinic_Management_System, "Clinic Management System", "A hybrid cloud platform that securely manages patient admissions, electronic medical records, scheduling, and billing for medium-sized hospitals and clinics with 99.99% high availability and compliance with HIPAA, GDPR, and 10-year data retention mandates.")

System_Ext(Global_Traffic_Manager_GTM, "Global Traffic Manager (GTM)", "Manages global traffic routing across hybrid cloud environments.")
System_Ext(API_Gateway, "API Gateway", "Handles incoming requests using OpenID Connect / OAuth 2.0 and MFA.")
System_Ext(Compliance_Archival_Gateway_WORM_Object_Storage, "Compliance Archival Gateway & WORM Object Storage", "Manages cold storage writes and 10-year data retention mandates.")
System_Ext(External_Lab_Imaging_and_HIE_Systems, "External Lab, Imaging, and HIE Systems", "External medical systems providing lab and imaging data.")
System_Ext(Insurance_Claim_Processors_Payment_Gateways, "Insurance Claim Processors & Payment Gateways", "External processors handling insurance claims and payments.")
System_Ext(Notification_Service_SIEM, "Notification Service & SIEM", "Handles notifications and security event monitoring.")

Rel(Patients, API_Gateway, "Interact with the system with MFA", "HTTPS/TLS 1.3")
Rel(Clinical_Staff, API_Gateway, "Interact with the system with MFA", "HTTPS/TLS 1.3")
Rel(Hospital_Administrators, API_Gateway, "Interact with the system with MFA", "HTTPS/TLS 1.3")
Rel(External_Lab_Imaging_and_HIE_Systems, Clinic_Management_System, "Connect via RESTful APIs and webhook subscriptions", "HL7 FHIR RESTful APIs over HTTPS")
Rel(Insurance_Claim_Processors_Payment_Gateways, Clinic_Management_System, "Integrate for claims and payments", "TLS 1.3 tunnels and X12 EDI/HTTPS")
Rel(Clinic_Management_System, Notification_Service_SIEM, "Streams security telemetry", "TLS-encrypted Syslog")
Rel(Clinic_Management_System, Compliance_Archival_Gateway_WORM_Object_Storage, "Offloads cold storage writes", "gRPC")

@enduml