@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Elasticsearch Containers container

Container_Boundary(elasticsearch_containers, "Elasticsearch Containers") {
    Component(lucene_searcher, "Lucene Index Searcher and Document Routing/Parsing engine", "Elasticsearch 3-node cluster, Kubernetes StatefulSets, Lucene", "Provides high-performance text-search indexing, document routing, and parsing for sub-second EMR search latencies.")
    Component(node_tiers, "Master, Data, and Ingest node tiers", "Kubernetes StatefulSets, POSIX Filesystem, bootstrap.memory_lock: true", "Separates cluster management, data storage, and ingestion across separate failure domains with locked JVM heap.")
    Component(ilm_slm, "Index Lifecycle Management (ILM) and Snapshot Lifecycle Management (SLM) execution engines", "Elasticsearch ILM/SLM", "Manages index retention, transitions, and automated backups for long-term audit trail and clinical data.")
    Component(security_plugin, "Security Plugin module", "Role-based access control, mTLS, REST API (port 9200), Transport Protocol (port 9300)", "Ensures secure internal service communication and access control meeting HIPAA/GDPR compliance.")
    Component(monitoring_exporter, "Internal monitoring and Prometheus metrics exporter component", "Prometheus scrape endpoints over HTTP", "Exports JVM and cluster metrics for observability.")
}

Container(patient_emr_service, "Patient & EMR Service", "gRPC over Envoy sidecar", "Retrieves indexed clinical records and patient demographics.")
Container(apache_kafka, "Apache Kafka", "Debezium & Apache Kafka CDC pipeline", "Ingests change data capture streams for real-time synchronization over HTTPS.")
Container(minio_storage, "Minio Object Storage Gateway Container", "Snapshot and Restore engine", "Backs up indices for 10-year retention.")
Container(observability_collector, "Observability Collector Container", "HTTP Prometheus scrape endpoints", "Collects JVM and cluster metrics.")

Rel(patient_emr_service, lucene_searcher, "Retrieves indexed clinical records and patient demographics via gRPC over Envoy sidecar (port 9200/HTTPS)", "gRPC / HTTPS")
Rel(apache_kafka, lucene_searcher, "Ingests change data capture (CDC) streams for real-time synchronization over HTTPS", "HTTPS")
Rel(ilm_slm, minio_storage, "Backs up indices via Snapshot and Restore engine for 10-year retention", "Snapshot/Restore")
Rel(monitoring_exporter, observability_collector, "Exports JVM and cluster metrics via Prometheus scrape endpoints over HTTP", "HTTP")

@enduml