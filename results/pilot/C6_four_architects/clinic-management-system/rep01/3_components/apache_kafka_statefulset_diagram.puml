@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Apache Kafka StatefulSet container

System(Patient_EMR_Service, "Patient & EMR Service", "Publishes and consumes domain events.")
System(Microservices, "Microservices", "Consumes schema definitions and enforces Avro payload validation.")
Container(MinIO_Object_Storage_Gateway, "MinIO Object Storage Gateway", "MinIO Object Storage Gateway Container", "Stores offloaded cold logs and data streams.")
Container(Hybrid_VPN_Gateway, "Hybrid VPN Gateway", "Hybrid VPN Gateway Container", "Connects on-premises infrastructure with cloud environments.")
Container(Observability_Collector, "Observability Collector", "Observability Collector Container", "Collects telemetry data and metrics from exporters.")
Container(Audit_Compliance_Sidecar, "Audit & Compliance Sidecar", "Audit & Compliance Sidecar Container", "Receives compliance and audit logs.")

Container_Boundary(Apache_Kafka_StatefulSet, "Apache Kafka StatefulSet") {
    Component(KRaft_Controller_Component, "KRaft Controller Component", "KRaft Consensus Protocol", "Replaces ZooKeeper for streamlined, decentralized metadata quorum management.")
    Component(Kafka_Broker_Engine, "Kafka Broker Engine", "Apache Kafka", "Event streaming platform providing partition fault tolerance and replication for high-throughput event sourcing.")
    Component(Schema_Registry, "Schema Registry", "Confluent Schema Registry", "Enforces strict Avro payload validation and backward compatibility.")
    Component(Kafka_Connect_Components, "Kafka Connect Components", "Apache Kafka Connect", "Integrates external data sources and sinks with the Kafka event streaming platform.")
    Component(Authorizer_Component, "Authorizer Component", "Native ACL / Apache Ranger", "Manages authorization and access control rules for Kafka resources.")
    Component(Cruise_Control_Component, "Cruise Control Component", "LinkedIn Cruise Control", "Automates cluster workload balancing, anomaly detection, and self-healing operations.")
    Component(Metrics_Exporter, "Metrics Exporter", "Prometheus JMX Exporter", "Scrapes JVM and broker performance metrics for observability.")
    Component(Tiered_Storage_Plugin, "Tiered Storage Plugin", "Kafka Tiered Storage", "Offloads cold logs and streams to object storage for cost-effective 10-year retention.")
    Component(MirrorMaker_2_Component, "MirrorMaker 2 Component", "Apache Kafka MirrorMaker 2", "Replicates transaction streams across on-prem and cloud regions.")
    Component(Data_Governance_and_Masking_Interceptor, "Data Governance and Masking Interceptor", "Custom Interceptor Plugin", "Masks and governs sensitive data payloads to satisfy HIPAA and GDPR requirements.")
    Component(Dead_Letter_Queue_DLQ_Management_Engine, "Dead Letter Queue (DLQ) Management Engine", "Kafka DLQ Pattern", "Manages failed message routing and reprocessing workflows.")
    Component(Client_Connection_Multiplexer, "Client Connection Multiplexer", "Envoy proxy sidecars", "Secures and multiplexes client connections using TLS 1.3 & SASL/SCRAM-SHA-512.")
    Component(Log_Compaction_and_Segment_Manager, "Log Compaction and Segment Manager", "Kafka Core Log Manager", "Manages log segments, retention policies, and log compaction routines.")
    Component(Backup_and_Snapshot_Controller, "Backup and Snapshot Controller", "Kafka Backup Controller", "Orchestrates cluster backups and state snapshots for disaster recovery.")
    Component(Health_Check_and_Cluster_Operator, "Health Check and Cluster Operator", "Strimzi-based Operator", "Automates cluster operations, provisioning, and failover handling on Kubernetes.")
    Component(Audit_Logging_Interceptor, "Audit Logging Interceptor", "Custom Interceptor Plugin", "Streams compliance and audit logs to security monitoring sidecars.")
}

Rel(Patient_EMR_Service, Kafka_Broker_Engine, "Publishes and consumes domain events", "Asynchronous Messaging / Kafka Protocol")
Rel(Schema_Registry, Microservices, "Enforces Avro payload validation", "HTTP/REST")
Rel(Kafka_Connect_Components, MinIO_Object_Storage_Gateway, "Offloads cold logs and streams", "S3/HTTPS")
Rel(Tiered_Storage_Plugin, MinIO_Object_Storage_Gateway, "Offloads cold logs and streams", "S3/HTTPS")
Rel(MirrorMaker_2_Component, Hybrid_VPN_Gateway, "Replicates transaction streams across on-prem and cloud", "Encrypted TCP")
Rel(Metrics_Exporter, Observability_Collector, "Bridges telemetry data", "OpenTelemetry / Prometheus")
Rel(Audit_Logging_Interceptor, Audit_Compliance_Sidecar, "Streams compliance logs", "Internal IPC")

@enduml