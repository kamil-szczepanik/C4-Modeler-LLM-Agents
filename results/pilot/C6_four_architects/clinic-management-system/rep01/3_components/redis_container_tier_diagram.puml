@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Redis Container tier container

System_Ext(PatientEMRService, "Patient & EMR Service", "External service interacting with Redis")
System_Ext(SchedulingService, "Scheduling Service", "External service interacting with Redis")
System_Ext(PostgreSQLContainercluster, "PostgreSQL Container cluster", "Fallback database cluster")
System_Ext(ObservabilityCollectorContainer, "Observability Collector Container", "Collects monitoring metrics")
System_Ext(AuditComplianceSidecarContainer, "Audit & Compliance Sidecar Container", "Collects audit logs")

Container_Boundary(RedisContainertier, "Redis Container tier") {
    Component(InMemoryDataStoreKeySpacePartitioningRouter, "In-Memory Data Store & Key-Space Partitioning Router", "Redis Enterprise Container Tier", "Delivers high-availability caching, distributed locking, and sub-second performance.")
    Component(DistributedLockManagerRedlockAlgorithms, "Distributed Lock Manager & Redlock Algorithms", "Redis Enterprise", "Manages distributed locks for patient admissions and scheduling.")
    Component(SessionStateEngineRBACEnforcer, "Session State Engine & RBAC Enforcer", "Redis Enterprise", "Handles session states and role-based access control enforcement.")
    Component(ActiveActiveConflictResolutionEngineCRDTs, "Active-Active Conflict Resolution Engine (CRDTs)", "Conflict-Free Replicated Data Types (CRDTs)", "Ensures active-active multi-region state convergence.")
    Component(PersistenceBackupCoordinatorRDBAOF, "Persistence & Backup Coordinator (RDB/AOF)", "Redis Enterprise", "Coordinates RDB and AOF persistence and backups.")
    Component(EncryptionAtRestManagerAES256PKCS11, "Encryption-At-Rest Manager (AES-256, PKCS#11)", "PKCS#11 & AES-256", "Manages encryption at rest to satisfy HIPAA and GDPR compliance.")
    Component(PubSubEventBrokerBulkIngestionPipeline, "Pub/Sub Event Broker & Bulk Ingestion Pipeline", "Redis Enterprise", "Facilitates pub/sub events and bulk data ingestion.")
    Component(GeoReplicationTunnelManagerClusterTopologyManager, "Geo-Replication Tunnel Manager & Cluster Topology Manager", "Redis Enterprise", "Manages hybrid geo-replication and cluster topologies.")
    Component(MemoryEvictionTTLPolicyControllerResourceQuotaEnforcer, "Memory Eviction, TTL Policy Controller & Resource Quota Enforcer", "Redis Enterprise", "Controls memory eviction, TTL policies, and resource quotas.")
    Component(TelemetryExporterAuditLogInterceptor, "Telemetry Exporter & Audit Log Interceptor", "Prometheus & OpenTelemetry", "Exports metrics and intercepts audit logs.")
    Component(DeadLetterFallbackHandler, "Dead Letter & Fallback Handler", "Redis Enterprise", "Handles dead letters and fallbacks.")
}

Rel(PatientEMRService, InMemoryDataStoreKeySpacePartitioningRouter, "Executes distributed locking and caching", "RESP3 over TLS")
Rel(SchedulingService, DistributedLockManagerRedlockAlgorithms, "Validates appointment resource clashes", "RESP3 over TLS")
Rel(InMemoryDataStoreKeySpacePartitioningRouter, PostgreSQLContainercluster, "Fallback read/write operations during partitions", "gRPC/SQL")
Rel(TelemetryExporterAuditLogInterceptor, ObservabilityCollectorContainer, "Exports metrics", "Prometheus scrapers")
Rel(TelemetryExporterAuditLogInterceptor, AuditComplianceSidecarContainer, "Streams administrative audit logs", "Structured Logs")

@enduml