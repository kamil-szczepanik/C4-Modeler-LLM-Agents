@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL Container cluster container

Container_Boundary(postgresql_cluster, "PostgreSQL Container cluster") {
    Component(Primary_PostgreSQL_Instance, "Primary PostgreSQL Instance", "PostgreSQL 15+", "Core relational database engine providing robust ACID compliance.")
    Component(Synchronous_Read_Only_Replicas, "Synchronous Read-Only Replicas", "PostgreSQL 15+", "Provides read scaling and high availability via streaming replication.")
    Component(PgBouncer_Connection_Pooling_Sidecars, "PgBouncer Connection Pooling Sidecars", "PgBouncer", "Manages thousands of concurrent microservice connections efficiently.")
    Component(Continuous_Backup_PITR_Daemon_pgBackRest_Barman, "Continuous Backup & PITR Daemon (pgBackRest/Barman)", "pgBackRest", "Facilitates continuous backups and point-in-time recovery for data retention mandates.")
    Component(Distributed_Consensus_Manager_Raft_CloudNativePG, "Distributed Consensus Manager (Raft / CloudNativePG)", "CloudNativePG Operator", "Orchestrates PostgreSQL lifecycle on Kubernetes for 99.99% uptime.")
    Component(Database_Policy_Enforcement_Component_PostgreSQL_RLS, "Database Policy Enforcement Component (PostgreSQL RLS)", "PostgreSQL RLS", "Enforces data access policies at the row level.")
    Component(PostgreSQL_Audit_Extension_pgaudit, "PostgreSQL Audit Extension (pgaudit)", "pgaudit", "Emits structured audit logs for compliance.")
    Component(Declarative_Partition_Management_Component, "Declarative Partition Management Component", "PostgreSQL Partitioning", "Manages table partitioning for optimized data retention and performance.")
    Component(Automated_Index_Maintenance_Daemon, "Automated Index Maintenance Daemon", "PostgreSQL Extension / Cron", "Performs automated index maintenance to sustain sub-second P95 performance.")
    Component(Health_Probe_and_Liveness_Sidecar, "Health Probe and Liveness Sidecar", "Kubernetes Liveness Probe", "Monitors container health and facilitates automated failover.")
}

Component(Patient_Scheduling_and_Billing_Services, "Patient, Scheduling, and Billing Services", "Microservices", "External services executing transactional queries and EMR searches.")
Component(Compliance_Archival_Gateway_WORM_Object_Storage, "Compliance Archival Gateway & WORM Object Storage", "Storage Gateway / WORM Storage", "Stores immutable WAL backups for regulatory compliance.")
Component(Observability_Collector_Container, "Observability Collector Container", "Observability Collector", "Collects structured audit logs and metrics.")

Rel(Patient_Scheduling_and_Billing_Services, PgBouncer_Connection_Pooling_Sidecars, "Executes transactional queries and EMR searches", "SQL / gRPC over mTLS")
Rel(Primary_PostgreSQL_Instance, Synchronous_Read_Only_Replicas, "Replicates transaction logs", "Streaming Replication / TCP")
Rel(Continuous_Backup_PITR_Daemon_pgBackRest_Barman, Compliance_Archival_Gateway_WORM_Object_Storage, "Streams WAL backups", "TLS")
Rel(PostgreSQL_Audit_Extension_pgaudit, Observability_Collector_Container, "Emits structured audit logs", "syslog / TCP")

@enduml