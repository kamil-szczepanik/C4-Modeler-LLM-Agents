@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Hybrid VPN Gateway Container container

Container_Boundary(hybrid_vpn_gateway_container, "Hybrid VPN Gateway Container") {
    Component(WireGuard_Core_Tunneling_Daemon, "WireGuard Core Tunneling Daemon", "BoringTun, Memory-safe user-space tunneling daemon", "Establishes secure, high-availability hybrid connectivity via bidirectional UDP encrypted tunnels over port 51820.")
    Component(Route_Agent, "Route Agent", "Bird BGP", "Handles dynamic BGP route propagation and failover.")
    Component(Configuration_Synchronizer, "Configuration Synchronizer", "gRPC", "Performs encrypted inter-container configuration synchronization and secret retrieval.")
    Component(IPsec_IKEv2_Fallback_Manager, "IPsec/IKEv2 Fallback Manager", "IPsec/IKEv2", "Manages redundant fallback connections to ensure sub-second failover.")
    Component(Traffic_Policer, "Traffic Policer", "Linux tc (Traffic Control)", "Enforces QoS queues for traffic prioritization.")
    Component(Network_Flow_Auditing_Component, "Network Flow Auditing Component", "NetFlow/IPFIX", "Exports network flow telemetry for compliance and auditing.")
    Component(Tunnel_Termination_Proxy, "Tunnel Termination Proxy", "Proxy Daemon", "Terminates incoming and outgoing hybrid tunnels securely.")
    Component(State_Synchronization_Daemon, "State Synchronization Daemon", "State Sync", "Maintains high-availability state across gateway instances.")
    Component(Cryptographic_Hardware_Acceleration_Module, "Cryptographic Hardware Acceleration Module", "Hardware Acceleration", "Accelerates cryptographic operations to protect sensitive patient information without performance degradation.")
    Component(MTU_Discovery_and_Fragmentation_Manager, "MTU Discovery and Fragmentation Manager", "Network Stack", "Manages packet sizes and fragmentation across the hybrid link.")
    Component(Kernel_Metrics_Exporter, "Kernel Metrics Exporter", "eBPF", "Gathers low-level transport telemetry and metric scraping via eBPF.")
    Component(Split_Tunnel_Policy_Enforcer, "Split-Tunnel Policy Enforcer", "nftables", "Enforces kernel-level packet filtering and policy routing for compliance.")
    Component(Dead_Peer_Detection_DPD_Watchdog, "Dead Peer Detection (DPD) Watchdog", "DPD", "Monitors tunnel health and triggers automated failover mechanisms.")
    Component(Packet_Inspection_and_Anti_Replay_Filter, "Packet Inspection and Anti-Replay Filter", "nftables / Security Filter", "Inspects packets and prevents replay attacks for HIPAA/GDPR compliance.")
    Component(DNS_Forwarding_and_Split_Resolver, "DNS Forwarding and Split-Resolver", "DNS Resolver", "Handles encrypted DNS query resolution to on-premise DNS servers.")
}

System_Ext(AWS_VPC, "AWS VPC", "AWS VPC endpoint for hybrid connectivity.")
System_Ext(Data_Encryption_Key_Management_Container, "Data Encryption & Key Management Container", "Key Management Container")
System_Ext(Audit_Compliance_Sidecar_Container, "Audit & Compliance Sidecar Container", "Audit Sidecar Container")
System_Ext(Observability_Collector_Container, "Observability Collector Container", "Observability Container")
System_Ext(On_Premise_DNS_Servers, "On-Premise DNS Servers", "On-Premise DNS infrastructure")

Rel(WireGuard_Core_Tunneling_Daemon, AWS_VPC, "Establishes bidirectional UDP encrypted tunnels over port 51820.", "UDP 51820")
Rel(Configuration_Synchronizer, Data_Encryption_Key_Management_Container, "Requests encrypted gRPC secret retrieval.", "gRPC")
Rel(Network_Flow_Auditing_Component, Audit_Compliance_Sidecar_Container, "Exports NetFlow/IPFIX telemetry.", "NetFlow/IPFIX")
Rel(Kernel_Metrics_Exporter, Observability_Collector_Container, "Exports eBPF transport telemetry.", "eBPF")
Rel(DNS_Forwarding_and_Split_Resolver, On_Premise_DNS_Servers, "Resolves encrypted DNS queries.", "Encrypted DNS")

@enduml