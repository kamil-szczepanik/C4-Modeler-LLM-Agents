@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("Scheduling Service", "Scheduling Service") {
    Component("Scheduling API Controller", "Scheduling API Controller", "Node.js & Express", "Exposes REST and gRPC endpoints for managing appointments and schedules.")
    Component("Appointment Domain Logic", "Appointment Domain Logic", "Node.js Domain Model", "Handles business rules and validation for patient admissions and appointment scheduling.")
    Component("Database Repository", "Database Repository", "PostgreSQL Client Driver", "Manages persistence and ACID-compliant queries for schedules over TLS.")
    Component("Cache Manager", "Cache Manager", "Redis Client / Redlock", "Handles sub-millisecond slot availability checks and distributed locking.")
    Component("Event Publisher", "Event Publisher", "Apache Kafka Client", "Streams asynchronous domain events for scheduling updates.")
}

Rel("Scheduling API Controller", "Appointment Domain Logic", "Delegates request processing")
Rel("Appointment Domain Logic", "Database Repository", "Persists schedule data using SQL over TLS")
Rel("Appointment Domain Logic", "Cache Manager", "Performs slot availability checks via RESP protocol")
Rel("Appointment Domain Logic", "Event Publisher", "Publishes domain events via Kafka binary protocol")
@enduml