@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(patient_emr_service, "Patient & EMR Service") {
    Component(EMR_Management_Engine, "EMR Management Engine", "Node.js / TypeScript", "Manages electronic medical records and clinical workflows.")
    Component(Patient_Demographics_Controller, "Patient Demographics Controller", "Fastify", "Handles patient admissions and demographic routing.")
    Component(Validation_Sanitization_Middleware, "Validation & Sanitization Middleware", "ajv", "Enforces fast schema validation for clinical payloads.")
    Component(Audit_Logging_Component, "Audit Logging Component", "Node.js", "Dispatches immutable audit logs.")
    Component(Crypto_Interceptor_Component, "Crypto Interceptor Component", "Node.js", "Handles field-level AES-256 encryption.")
    Component(Caching_Distributed_Locking_Component, "Caching & Distributed Locking Component", "ioredis", "Executes caching and distributed locking.")
    Component(HL7_FHIR_Transformation_Component, "HL7 FHIR Transformation Component", "Node.js", "Transforms clinical data into HL7 FHIR standards.")
    Component(Search_Index_Sync_Component, "Search Index Sync Component", "Node.js", "Synchronizes data for search indexes.")
    Component(FHIR_Resource_Validation_Component, "FHIR Resource Validation Component", "ajv", "Validates FHIR resources.")
    Component(Tenant_Context_Manager_Component, "Tenant Context Manager Component", "Node.js", "Manages multi-tenant context and isolation.")
    Component(DLQ_Handler_Component, "DLQ Handler Component", "Node.js", "Handles dead-letter queue messages.")
    Component(Offline_Sync_Conflict_Resolution_Component, "Offline Sync & Conflict Resolution Component", "Node.js", "Manages offline synchronization and conflict resolution.")
    Component(Access_Policy_Enforcer_Component, "Access Policy Enforcer Component", "Node.js", "Enforces access policies for compliance.")
    Component(Bulk_Export_Retention_Component, "Bulk Export & Retention Component", "Node.js", "Handles bulk data export and retention policies.")
    Component(CDS_Hook_Engine, "CDS Hook Engine", "Node.js", "Executes clinical decision support hooks.")
    Component(Consent_Management_Component, "Consent Management Component", "Node.js", "Manages explicit patient consent for compliance.")
    Component(Diagnostic_Telemetry_Interceptor_Component, "Diagnostic Telemetry Interceptor Component", "OpenTelemetry SDK", "Exports metrics and traces for observability.")
}

System_Ext(Observability_Collector_Container, "Observability Collector Container", "Collects metrics and traces.")

Rel(Patient_Demographics_Controller, Validation_Sanitization_Middleware, "Validates incoming request payloads", "")
Rel(EMR_Management_Engine, Crypto_Interceptor_Component, "Encrypts and decrypts sensitive clinical data", "")
Rel(EMR_Management_Engine, Caching_Distributed_Locking_Component, "Uses distributed locks and cache", "")
Rel(EMR_Management_Engine, HL7_FHIR_Transformation_Component, "Transforms clinical payloads", "")
Rel(EMR_Management_Engine, Audit_Logging_Component, "Sends audit events", "")
Rel(Diagnostic_Telemetry_Interceptor_Component, Observability_Collector_Container, "Exports metrics and traces via OpenTelemetry SDK", "")

@enduml