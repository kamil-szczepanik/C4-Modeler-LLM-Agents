@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(data_encryption_and_key_management_container, "Data Encryption & Key Management Container") {
    Component(Key_Management_Service, "Key Management Service", "PKCS#11, HSM", "Manages cryptographic keys securely using Hardware Security Modules.")
    Component(Encryption_Engine, "Encryption Engine", "AES-256, OpenSSL", "Performs encryption and decryption operations for data at rest and in transit.")
}

Rel(Key_Management_Service, Encryption_Engine, "Provides cryptographic keys", "gRPC")

@enduml