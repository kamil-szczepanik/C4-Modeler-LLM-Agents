@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Envoy Service Mesh Container container

Container_Boundary(envoy_service_mesh_container, "Envoy Service Mesh Container") {
    Component(EnvoyListenerSubsystem, "Envoy Listener Subsystem", "Envoy C++, BoringSSL", "Establishes bi-directional mTLS 1.3 tunnels over TCP with upstream and downstream microservices.")
    Component(xDSDynamicConfigurationClient, "xDS Dynamic Configuration Client", "Envoy C++, gRPC", "Manages dynamic configuration synchronization.")
    Component(RBACAuthorizationFilterEngine, "RBAC & Authorization Filter Engine", "Envoy C++", "Communicates locally with the Tenant Context & Authorization Proxy via Unix domain sockets.")
    Component(RateLimitFilterComponent, "Rate Limit Filter Component", "Envoy C++, gRPC", "Connects asynchronously via gRPC with a Redis caching tier.")
    Component(HealthCheckingOutlierDetectionComponent, "Health Checking & Outlier Detection Component", "Envoy C++", "Ensures fault tolerance and service availability.")
    Component(AccessLoggingServiceALS, "Access Logging Service (ALS)", "Envoy C++, gRPC", "Streams JSON audit telemetry via gRPC to the Observability Collector Container.")
    Component(EnvoyTracingFilterComponent, "Envoy Tracing Filter Component", "Envoy C++, OpenTelemetry, gRPC", "Exports OpenTelemetry data via gRPC over Unix domain sockets to the Observability Collector.")
    Component(EnvoyWASMExtensionHost, "Envoy WASM Extension Host", "WasmEdge, Rust", "Executes lightweight WebAssembly plugins for HIPAA payload inspection.")
    Component(EnvoyClusterManagerComponent, "Envoy Cluster Manager Component", "Envoy C++", "Manages upstream clusters and interacts with the DNS Resolver.")
    Component(EnvoyCircuitBreakerComponent, "Envoy Circuit Breaker Component", "Envoy C++", "Maintains high availability and fault tolerance across clinical workflows.")
    Component(EnvoyExt_AuthzFilterComponent, "Envoy Ext_Authz Filter Component", "Envoy C++, gRPC", "Maintains persistent HTTP/2 gRPC connections with the Authorization Proxy.")
    Component(EnvoyDNSResolverComponent, "Envoy DNS Resolver Component", "c-ares DNS", "Handles asynchronous DNS resolution and TTL caching, interacting with the Cluster Manager.")
}

System_Ext(UpstreamandDownstreamMicroservices, "Upstream and Downstream Microservices", "Microservices interacting via mTLS")
System_Ext(TenantContextAuthorizationProxyContainer, "Tenant Context & Authorization Proxy Container", "Authorization Proxy")
System_Ext(RedisContainertier, "Redis Container tier", "Redis Caching Tier")
System_Ext(ObservabilityCollectorContainer, "Observability Collector Container", "Observability Platform")

Rel(EnvoyListenerSubsystem, UpstreamandDownstreamMicroservices, "Establishes bi-directional mTLS 1.3 tunnels over TCP", "TCP / mTLS 1.3")
Rel(RBACAuthorizationFilterEngine, TenantContextAuthorizationProxyContainer, "Communicates locally via Unix domain sockets", "Unix domain sockets")
Rel(RateLimitFilterComponent, RedisContainertier, "Connects asynchronously via gRPC", "gRPC")
Rel(AccessLoggingServiceALS, ObservabilityCollectorContainer, "Streams JSON audit telemetry via gRPC", "gRPC")
Rel(EnvoyTracingFilterComponent, ObservabilityCollectorContainer, "Exports OpenTelemetry data via gRPC over Unix domain sockets", "gRPC / Unix domain sockets")
Rel(EnvoyExt_AuthzFilterComponent, TenantContextAuthorizationProxyContainer, "Maintains persistent HTTP/2 gRPC connections", "HTTP/2 gRPC")
Rel(EnvoyDNSResolverComponent, EnvoyClusterManagerComponent, "Interacts for endpoint resolution", "In-process")
@enduml