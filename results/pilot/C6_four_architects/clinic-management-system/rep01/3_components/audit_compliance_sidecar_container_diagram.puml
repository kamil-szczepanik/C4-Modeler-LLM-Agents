@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Audit & Compliance Sidecar Container container

Container_Boundary(audit_compliance_sidecar_container, "Audit & Compliance Sidecar Container") {
    Component(Log_Interceptor_Component, "Log Interceptor Component", "FluentBit/Vector, Unix Domain Sockets, mmap", "Consumes stdout/stderr logs via AF_UNIX and shared emptyDir volumes [Shared Memory].")
    Component(Policy_Validation_Component, "Policy Validation Component", "Go, WebAssembly, Rego rules", "Evaluates data sanitization policies and compiled Rego rules.")
    Component(Cryptographic_Signer___Formatter_Component, "Cryptographic Signer & Formatter Component", "Go, Canonical JSON RFC 8785, HMAC-SHA256", "Formats and cryptographically signs audit records.")
    Component(HSM_Key_Provider_Component, "HSM Key Provider Component", "PKCS#11, Hardware Security Module", "Performs hardware-backed digital signatures and key rotations.")
    Component(Resilient_Forwarder_Component, "Resilient Forwarder Component", "RocksDB persistent buffering, token-bucket rate limiter", "Manages persistent buffering and dispatches logs and alerts.")
}

Component(Compliance_Archival_Gateway___WORM_Object_Storage, "Compliance Archival Gateway & WORM Object Storage", "WORM Object Storage", "Stores long-term encrypted audit logs.")
Component(Elasticsearch_Containers_cluster, "Elasticsearch Containers cluster", "Elasticsearch", "Dispatches log batches for real-time analytics.")
Component(RabbitMQ_Container_cluster, "RabbitMQ Container cluster", "AMQP 0.9.1", "Publishes security alerts and tamper notifications.")
Component(Observability_Collector_Container, "Observability Collector Container", "OpenTelemetry, Prometheus", "Emits operational metrics.")
Component(Tenant_Context___Authorization_Proxy_Container, "Tenant Context & Authorization Proxy Container", "Proxy", "Provides context-aware masking policies and authorization context.")

Rel(Log_Interceptor_Component, audit_compliance_sidecar_container, "Consumes stdout/stderr logs", "AF_UNIX and shared emptyDir volumes [Shared Memory]")
Rel(Policy_Validation_Component, Tenant_Context___Authorization_Proxy_Container, "Fetches context-aware masking policies and compiled Rego rules", "gRPC/Wasm")
Rel(Cryptographic_Signer___Formatter_Component, HSM_Key_Provider_Component, "Performs hardware-backed digital signatures and key rotations", "PKCS#11")
Rel(Resilient_Forwarder_Component, Compliance_Archival_Gateway___WORM_Object_Storage, "Streams encrypted audit logs", "mTLS 1.3, gRPC")
Rel(Resilient_Forwarder_Component, Elasticsearch_Containers_cluster, "Dispatches log batches for real-time analytics", "TLS")
Rel(Resilient_Forwarder_Component, RabbitMQ_Container_cluster, "Publishes security alerts and tamper notifications", "AMQP 0.9.1, TLS 1.3")
Rel(Resilient_Forwarder_Component, Observability_Collector_Container, "Emits operational metrics", "HTTP, OpenTelemetry")
@enduml