@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the MinIO Object Storage Gateway Container container

Container_Boundary(minio_gateway, "MinIO Object Storage Gateway Container") {
    Component(S3_API_Handler, "S3 API Handler", "Go-based routing, HTTPS/REST", "Handles S3-compatible API requests using Go-based routing and HTTPS/REST.")
    Component(Erasure_Coding_Tiering_Engine, "Erasure Coding & Tiering Engine", "POSIX, NVMe-oF, AES-256", "Manages distributed erasure coding, tiering, and storage optimization.")
    Component(IAM_KMS_Policy_Enforcer, "IAM & KMS Policy Enforcer", "PKCS#11, gRPC", "Enforces IAM and KMS policies, integrating with key management systems.")
    Component(Object_Lifecycle_Management_Component_Object_Lock_Legal_Hold_Manager, "Object Lifecycle Management Component & Object Lock/Legal Hold Manager", "MinIO Object Lifecycle", "Manages object lifecycle rules, data retention, object lock, and legal holds.")
    Component(Multipart_Upload_Manager_Caching_Read_Ahead_Proxy, "Multipart Upload Manager & Caching/Read-Ahead Proxy", "Redis", "Manages multipart uploads and provides caching/read-ahead proxy capabilities using Redis.")
    Component(Event_Notification_Dispatcher, "Event Notification Dispatcher", "Apache Kafka", "Dispatches bucket events to Apache Kafka.")
    Component(Health_Probe_and_Self_Repair_Component, "Health Probe and Self-Repair Component", "HTTP", "Provides health checks and self-repair capabilities over HTTP.")
    Component(Compression_Malware_Scanning_and_Quota_Isolation_Components, "Compression, Malware Scanning, and Quota Isolation Components", "MinIO Native", "Handles data compression, malware scanning, and quota isolation.")
    Component(Bucket_Replication_Engine_Storage_Metrics_Aggregator, "Bucket Replication Engine & Storage Metrics Aggregator", "Prometheus", "Handles bucket replication across regions and aggregates storage metrics for Prometheus.")
}

System_Ext(DICOM_Document_Processing_Container, "DICOM & Document Processing Container", "External DICOM and Document Processing services")
System_Ext(Patient_EMR_Service, "Patient & EMR Service", "External Patient & EMR services")
System_Ext(Data_Encryption_Key_Management_Container, "Data Encryption & Key Management Container", "External Key Management Container")
System_Ext(Apache_Kafka_StatefulSet, "Apache Kafka StatefulSet", "External Apache Kafka cluster")
System_Ext(Observability_Collector_Container, "Observability Collector Container", "External Observability Collector")

Rel(DICOM_Document_Processing_Container, S3_API_Handler, "Receives HTTPS/REST traffic via Envoy mTLS", "HTTPS/REST / mTLS")
Rel(Patient_EMR_Service, S3_API_Handler, "Receives HTTPS/REST traffic via Envoy mTLS", "HTTPS/REST / mTLS")
Rel(IAM_KMS_Policy_Enforcer, Data_Encryption_Key_Management_Container, "Integrates synchronously using PKCS#11 over gRPC", "PKCS#11 / gRPC")
Rel(Event_Notification_Dispatcher, Apache_Kafka_StatefulSet, "Publishes bucket events using Kafka protocol", "Kafka protocol")
Rel(Bucket_Replication_Engine_Storage_Metrics_Aggregator, Observability_Collector_Container, "Exports Prometheus-formatted metrics over HTTP", "HTTP")

@enduml