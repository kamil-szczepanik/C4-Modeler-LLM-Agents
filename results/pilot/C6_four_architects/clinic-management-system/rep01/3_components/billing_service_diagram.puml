@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing Service container

Container_Boundary(billing_service, "Billing Service") {
    Component(invoice_engine, "Invoice Engine & Pricing Cache", "Node.js, Redis", "Manages invoice generation and in-memory pricing cache.")
    Component(claim_submitter, "Claim Submitter & X12 EDI Formatter", "Node.js, XState, ANSI X12 837/835", "Handles claim submission and X12 EDI formatting using state machines.")
    Component(payment_gateway, "Payment Gateway Integrator & PCI-DSS Tokenizer", "Node.js, HTTPS/TLS 1.3, Resilience4J", "Integrates with payment gateways and provides PCI-DSS tokenization.")
    Component(webhook_receiver, "Webhook Receiver & Signature Verifier", "Express.js, Node.js Crypto", "Receives webhooks and verifies cryptographic signatures.")
    Component(batch_settlement, "Batch Settlement Processor & Statement Generator", "Node.js Worker Threads, PDFKit", "Processes batch settlements and generates PDF statements.")
    Component(ledger_auditor, "Ledger Auditor & Analytics Emitter", "gRPC, Unix Domain Sockets, ClickHouse", "Audits ledgers and emits analytics data.")
}

System_Ext(postgresql, "PostgreSQL Container cluster", "ACID-compliant relational database")
System_Ext(kafka, "Apache Kafka StatefulSet", "Event streaming platform")
System_Ext(rabbitmq, "RabbitMQ Container cluster", "Message broker")
System_Ext(minio, "MinIO Object Storage Gateway Container", "S3-compatible object storage")
System_Ext(audit_sidecar, "Audit & Compliance Sidecar Container", "Sidecar for auditing")

Rel(billing_service, postgresql, "Executes transactional queries and connection pooling", "SQL / gRPC")
Rel(claim_submitter, kafka, "Streams financial events", "TLS / KafkaJS")
Rel(claim_submitter, rabbitmq, "Dispatches clearinghouse payloads", "AMQP 0-9-1")
Rel(batch_settlement, minio, "Uploads PDF statements", "HTTPS / S3 API")
Rel(ledger_auditor, audit_sidecar, "Streams audit events", "Local gRPC")

@enduml