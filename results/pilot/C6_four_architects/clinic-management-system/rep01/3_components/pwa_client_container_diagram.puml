@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PWA Client Container container

Container_Boundary(pwa_client_container, "PWA Client Container") {
    Component(UI_Component_Layer, "UI Component Layer", "React, TypeScript", "Handles user interface components and interactions for clinical workflows.")
    Component(Local_Persistence_Manager, "Local Persistence Manager", "IndexedDB", "Provides local storage for patient records with zero plaintext leakage.")
    Component(State_Management___Sync_Engine, "State Management & Sync Engine", "Service Workers", "Manages state and synchronization across offline and online modes.")
    Component(Client_Side_Cryptography_Provider, "Client-Side Cryptography Provider", "Web Crypto API", "Enforces AES-compatible client-side payload encryption for HIPAA compliance.")
    Component(Authentication___Session_Manager, "Authentication & Session Manager", "OpenID Connect, JWT", "Manages user authentication and session states securely.")
    Component(Client_Telemetry___Error_Boundary_Component, "Client Telemetry & Error Boundary Component", "OpenTelemetry JavaScript SDK", "Captures performance traces and error logs for P95 latency monitoring.")
    Component(API_Client___Request_Interceptor, "API Client & Request Interceptor", "Axios", "Handles outbound HTTP requests with interceptors and retry logic.")
    Component(Client_Side_Routing___View_Manager, "Client-Side Routing & View Manager", "React Router", "Manages client-side routing and view transitions.")
    Component(Offline_Transaction_Queue_Manager, "Offline Transaction Queue Manager", "Transactional Outbox", "Manages transactions when offline for later synchronization.")
    Component(Client_Side_Push_Notification___Real_Time_Sync_Coordinator, "Client-Side Push Notification & Real-Time Sync Coordinator", "Web Push API, SSE", "Coordinates push notifications and real-time synchronization.")
    Component(Client_Side_Audit___Integrity_Logger, "Client-Side Audit & Integrity Logger", "Cryptographic Hashing", "Logs audit and integrity events client-side.")
}

Container(API_Gateway_Container, "API Gateway Container", "Envoy / API Gateway", "External API gateway handling inbound and outbound traffic.")
Container(Observability_Collector_Container, "Observability Collector Container", "OpenTelemetry Collector", "Collects system metrics, traces, and error logs.")

Rel(UI_Component_Layer, State_Management___Sync_Engine, "Interacts via reactive state streams")
Rel(State_Management___Sync_Engine, Local_Persistence_Manager, "Communicates via asynchronous storage APIs")
Rel(State_Management___Sync_Engine, API_Gateway_Container, "Service Worker intercepts requests and routes traffic", "HTTPS")
Rel(API_Client___Request_Interceptor, API_Gateway_Container, "Communicates", "HTTPS")
Rel(Client_Telemetry___Error_Boundary_Component, Observability_Collector_Container, "Transmits metrics", "HTTPS")

@enduml