@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(External_Partners, "External Partners", "External partners connecting via secure protocols")
System_Ext(Hybrid_VPN_Gateway_Container, "Hybrid VPN Gateway Container", "Provides secure networking tunnel")
System_Ext(Data_Encryption_Key_Management_Container, "Data Encryption & Key Management Container", "Provides key management services")
System_Ext(MinIO_Object_Storage_Gateway, "MinIO Object Storage Gateway", "Object storage gateway via HTTPS/S3")
System_Ext(RabbitMQ, "RabbitMQ", "Message broker for asynchronous queues")
System_Ext(Audit_Sidecar_Container, "Audit Sidecar Container", "Collects structured JSON logs")

Container_Boundary(Secure_File_Transfer_Container, "Secure File Transfer Container") {
    Component(SFTP_FTPS_Server_Handler, "SFTP/FTPS Server Handler", "Go, SSH/TLS", "Manages inbound and outbound protocol connections via SSH/TLS.")
    Component(PGP_Cryptographic_Engine, "PGP Cryptographic Engine", "Go, OpenPGP, PKCS#11", "Handles mandatory file-level encryption, decryption, and key-rotation.")
    Component(Transfer_Orchestration_Worker, "Transfer Orchestration Worker", "Go, RabbitMQ", "Manages asynchronous batch queues, rate-limiting, and dead-letter queue routing.")
    Component(Audit_Logging_Interceptor, "Audit Logging Interceptor", "Go, gRPC", "Emits compliance events via gRPC.")
    Component(Virus_Malware_Scanning_Component, "Virus & Malware Scanning Component", "Go, ClamAV, UNIX Domain Sockets", "Inspects files using ClamAV via UNIX domain sockets.")
    Component(Transfer_State_Store_Component, "Transfer State Store Component", "Go, BoltDB", "Tracks resume pointers and session states using BoltDB.")
    Component(Metadata_Sanitization_Component, "Metadata Sanitization Component", "Go", "Strips sensitive EXIF/file-header metadata.")
    Component(Chunked_Stream_Assembler_Component, "Chunked Stream Assembler Component", "Go", "Processes large imaging payloads via constant-memory sliding windows.")
    Component(Bandwidth_Throttling_Component, "Bandwidth Throttling Component", "Go", "Controls network utilization via rate-limiting primitives.")
}

Rel(External_Partners, SFTP_FTPS_Server_Handler, "Connects via SSH/TLS protocols", "SSH/TLS through Hybrid VPN Gateway")
Rel(PGP_Cryptographic_Engine, Data_Encryption_Key_Management_Container, "Fetches keys dynamically", "PKCS#11")
Rel(SFTP_FTPS_Server_Handler, MinIO_Object_Storage_Gateway, "Streams decrypted payloads", "HTTPS/S3")
Rel(Transfer_Orchestration_Worker, RabbitMQ, "Coordinates state transitions and dead-letter routing", "AMQP")
Rel(Audit_Logging_Interceptor, Audit_Sidecar_Container, "Forwards structured JSON logs", "gRPC")

@enduml