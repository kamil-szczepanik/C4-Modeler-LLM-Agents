@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient & EMR Service container

System_Ext(api_gateway, "API Gateway", "External API Gateway routing traffic.")
System_Ext(keycloak, "Keycloak", "IAM / Identity Provider.")
System_Ext(postgresql, "PostgreSQL", "Relational database.")
System_Ext(s3_storage, "S3 Storage", "Object storage.")
System_Ext(kafka, "Apache Kafka", "Event streaming platform.")

Container_Boundary(patient_emr_service, "Patient & EMR Service") {
    Component(Demographics_Controller, "Demographics Controller", "Java / Spring Boot", "Manages patient registration and attribute-based access control.")
    Component(EMR_Document_Manager, "EMR Document Manager", "Java / Spring Boot", "Handles clinical data persistence, structured records, and blob storage.")
    Component(Audit_Interceptor, "Audit Interceptor", "AspectJ and HSM", "Generates cryptographic, tamper-evident audit trails.")
    Component(FHIR_Resource_Mapper, "FHIR Resource Mapper", "HAPI FHIR libraries", "Transforms domain models using HAPI FHIR libraries for interoperability.")
    Component(Patroni_PostgreSQL_Cluster, "Patroni PostgreSQL Cluster", "PostgreSQL with Patroni", "Provides high-availability relational data storage.")
    Component(S3_compatible_Tiered_Storage, "S3-compatible Tiered Storage", "AWS SDK v2 / S3", "Enforces 10-year WORM compliance for unstructured records.")
}

Rel(api_gateway, Demographics_Controller, "Routes client requests", "HTTPS / mTLS (Istio)")
Rel(api_gateway, EMR_Document_Manager, "Routes client requests", "HTTPS / mTLS (Istio)")
Rel(Demographics_Controller, keycloak, "Validates OAuth2/OIDC tokens and attribute-based access control", "")
Rel(EMR_Document_Manager, postgresql, "Executes transactional persistence", "JDBC / HikariCP")
Rel(EMR_Document_Manager, s3_storage, "Streams unstructured clinical objects", "AWS SDK v2 over HTTPS")
Rel(EMR_Document_Manager, kafka, "Publishes asynchronous clinical events", "SASL/SCRAM and JWE")

@enduml