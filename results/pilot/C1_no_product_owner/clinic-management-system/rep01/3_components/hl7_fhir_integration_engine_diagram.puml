@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary("HL7 FHIR Integration Engine", "HL7 FHIR Integration Engine") {
    Component("FHIR Route Orchestrator", "FHIR Route Orchestrator", "Apache Camel", "Orchestrates routes and message flows for clinical data within the integration engine.")
    Component("Data Transformation Processor", "Data Transformation Processor", "HAPI FHIR", "Parses and transforms clinical data structures using HAPI FHIR libraries.")
    Component("Validation & Compliance Interceptor", "Validation & Compliance Interceptor", "Java / Apache Camel Interceptor", "Validates messages against strict healthcare compliance and regulatory standards.")
    Component("External Protocol Adapter", "External Protocol Adapter", "Apache Camel", "Adapts external protocols for secure communication with external healthcare systems.")
}

Rel("FHIR Route Orchestrator", "Data Transformation Processor", "Delegates parsing and transformation", "Java method invocation")
Rel("FHIR Route Orchestrator", "Validation & Compliance Interceptor", "Passes messages for compliance checks", "Interceptor chain")
Rel("External Protocol Adapter", "FHIR Route Orchestrator", "Forwards ingested messages", "Internal Camel routing")

@enduml