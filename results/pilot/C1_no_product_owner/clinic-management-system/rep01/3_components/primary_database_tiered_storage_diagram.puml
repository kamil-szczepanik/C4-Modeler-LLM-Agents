@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Primary Database & Tiered Storage container

Container_Boundary(primary_database_tiered_storage, "Primary Database & Tiered Storage") {
    Component(Patroni PostgreSQL Cluster, "Patroni PostgreSQL Cluster", "PostgreSQL, Patroni, PgBouncer", "Manages hot transactional data with synchronous replication and dynamic connection pooling for 99.99% uptime.")
    Component(MinIO S3-compatible WORM storage, "MinIO S3-compatible WORM storage", "MinIO S3-Compatible Storage", "Provides Write-Once-Read-Many (WORM) object locking for 10-year compliance retention.")
    Component(Data Proxy Component, "Data Proxy Component", "Java / Custom Proxy", "Routes data access requests and enforces security policies between microservices and storage.")
    Component(Data Lifecycle Service, "Data Lifecycle Service", "Java / Spring Boot", "Manages data retention policies and moves data between hot storage and tiered cold storage.")
}

Rel(Data Proxy Component, Patroni PostgreSQL Cluster, "Routes relational queries and transactions", "TLS 1.3")
Rel(Data Lifecycle Service, MinIO S3-compatible WORM storage, "Archives compliance and long-term retention data", "HTTPS / S3 API")
Rel(Patroni PostgreSQL Cluster, MinIO S3-compatible WORM storage, "Offloads historical data and backups")
@enduml