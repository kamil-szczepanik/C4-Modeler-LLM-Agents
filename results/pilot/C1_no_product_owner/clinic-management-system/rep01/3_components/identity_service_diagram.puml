@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(identity_service, "Identity Service") {
    Component(Authentication_Engine, "Authentication Engine", "Keycloak", "Manages authentication, identity federation, and credential verification.")
    Component(Authorization_Token_Management_Module, "Authorization & Token Management Module", "Keycloak, Redis & Infinispan", "Handles authorization, OAuth2/OIDC token issuance, and sub-millisecond token validation.")
    Component(User_Federation_Provider, "User Federation Provider", "Keycloak", "Interoperates for staff credentials over LDAPS with enterprise LDAP directories.")
}

Rel(Authentication_Engine, Authorization_Token_Management_Module, "Passes authenticated identity context for token generation")
Rel(User_Federation_Provider, Authentication_Engine, "Validates staff credentials against external directories")
@enduml