@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing Service container

Container_Boundary(billing_service, "Billing Service") {
    Component(Spring_MVC_REST_Controllers, "Spring MVC REST Controllers", "Spring MVC REST Controllers", "Exposes REST endpoints for managing patient admissions, EMR, scheduling, and billing.")
    Component(Claim_Processing_Engine, "Claim Processing Engine", "Spring Boot / Java", "Evaluates business rules and processes financial and insurance claims.")
    Component(Payment_Gateway_Adapter, "Payment Gateway Adapter", "Spring Boot / Java", "Adapts and communicates with external payment gateways.")
    Component(Apache_Camel, "Apache Camel", "Embedded X12 EDI Mapping Component", "Performs X12 EDI formatting, schema validation, and maps claims for insurance gateways.")
    Component(Spring_Data_JPA, "Spring Data JPA", "Spring Data JPA with PostgreSQL and Flyway", "Persists financial data and manages database migrations securely.")
    Component(Spring_Cloud_Stream___Apache_Kafka, "Spring Cloud Stream & Apache Kafka", "Spring Cloud Stream & Apache Kafka", "Publishes and consumes asynchronous events for decoupled invoice workflows.")
    Component(Resilience4j, "Resilience4j", "Resilience4j Circuit Breakers", "Provides circuit breakers for fault-tolerant external gateway communication.")
    Component(Spring_Security_Filter_Chain, "Spring Security Filter Chain", "Spring Security (OAuth2/RBAC)", "Enforces token-based RBAC and filter-chain input sanitization.")
}

Rel(Spring_MVC_REST_Controllers, Claim_Processing_Engine, "Invokes business rule evaluation via internal application events", "")
Rel(Claim_Processing_Engine, Spring_Cloud_Stream___Apache_Kafka, "Publishes and consumes asynchronous events via Spring Cloud Stream", "")
Rel(Claim_Processing_Engine, Spring_Data_JPA, "Persists financial data using Spring Data JPA with column-level AES-256 encryption", "")
Rel(Apache_Camel, Payment_Gateway_Adapter, "Submits X12 EDI claims over HTTPS with mTLS and certificate pinning", "")
Rel(Spring_Security_Filter_Chain, Spring_MVC_REST_Controllers, "Secures and sanitizes incoming HTTP requests", "")

@enduml