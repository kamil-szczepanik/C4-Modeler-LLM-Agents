@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(event_broker, "Event Broker") {
    Component(Kafka Cluster Core, "Kafka Cluster Core", "Apache Kafka with KRaft consensus", "High-throughput, fault-tolerant event broker core managing asynchronous clinical message streams.")
    Component(Strimzi Operator, "Strimzi Operator", "Kubernetes Operator", "Automates the management, provisioning, and operations of the Kafka cluster.")
    Component(Schema Registry, "Schema Registry", "Confluent Schema Registry", "Enforces structural validation and schema evolution for event payloads.")
    Component(MirrorMaker 2, "MirrorMaker 2", "Apache Kafka MirrorMaker 2", "Replicates disaster recovery pipeline data across hybrid boundaries from on-prem-k8s to AWS eu-central-1.")
}

Rel(Strimzi Operator, Kafka Cluster Core, "Manages and configures")
Rel(Kafka Cluster Core, Schema Registry, "Validates message schemas against")
Rel(Kafka Cluster Core, MirrorMaker 2, "Replicates topic data to disaster recovery targets via")
@enduml