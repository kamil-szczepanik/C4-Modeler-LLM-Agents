@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients_Clinic_Staff, "Patients & Clinic Staff", "Users who interact with the clinic management system for admissions, EMRs, scheduling, and clinical operations.")
System_Ext(External_Labs_Imaging_Systems, "External Labs & Imaging Systems", "External systems that integrate with the CMS to provide laboratory and medical imaging data.")
System_Ext(Third_Party_Insurance_Gateways, "Third-Party Insurance Gateways", "External systems used for processing billing and claim submissions via messaging.")
System(Clinic_Management_System, "Clinic Management System", "Manages patient admissions, EMRs, scheduling, and billing for clinical IT environments with HIPAA/GDPR compliance, 99.99% availability, and 10-year data retention.")

Rel(Patients_Clinic_Staff, Clinic_Management_System, "Interact with API Gateway via HTTPS using OAuth 2.0 / OIDC", "HTTPS (OAuth 2.0 / OIDC)")
Rel(External_Labs_Imaging_Systems, Clinic_Management_System, "Interact with CMS via HL7 FHIR over mutual TLS", "HL7 FHIR over mTLS")
Rel(Third_Party_Insurance_Gateways, Clinic_Management_System, "Interact via Apache Kafka over TLS 1.3", "Apache Kafka over TLS 1.3")
@enduml