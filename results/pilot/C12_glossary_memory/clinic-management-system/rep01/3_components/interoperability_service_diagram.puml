@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Interoperability Service container

System_Ext(LIS, "Laboratory Information Systems (LIS)", "External Laboratory Information Systems")
System_Ext(PACS, "PACS Imaging Archives", "External PACS Imaging Archives")
System_Ext(Insurance, "Insurance Payment Gateways", "External Insurance Payment Gateways")

Container_Boundary(interoperability_service, "Interoperability Service") {
    Component(API_Router_Component, "API Router Component", "Python, FastAPI", "Routes incoming internal gRPC requests from the API Gateway to appropriate interoperability handlers.")
    Component(FHIR_Transformation_Engine, "FHIR Transformation Engine", "Python, Pydantic", "Transforms internal data models into HL7 FHIR standard payloads and vice versa.")
    Component(Outbound_mTLS_Dispatcher_Component, "Outbound mTLS Dispatcher Component", "Python, HTTPX", "Dispatches HL7 FHIR payloads securely to external systems using mutual TLS (mTLS).")
}

Rel(API_Router_Component, FHIR_Transformation_Engine, "Forwards payloads for transformation")
Rel(FHIR_Transformation_Engine, Outbound_mTLS_Dispatcher_Component, "Sends transformed FHIR payloads for dispatch")
Rel(Outbound_mTLS_Dispatcher_Component, LIS, "Transmits HL7 FHIR data over secure mutual TLS (mTLS)", "HL7 FHIR / mTLS")
Rel(Outbound_mTLS_Dispatcher_Component, PACS, "Transmits HL7 FHIR data over secure mutual TLS (mTLS)", "HL7 FHIR / mTLS")
Rel(Outbound_mTLS_Dispatcher_Component, Insurance, "Transmits HL7 FHIR data over secure mutual TLS (mTLS)", "HL7 FHIR / mTLS")

@enduml