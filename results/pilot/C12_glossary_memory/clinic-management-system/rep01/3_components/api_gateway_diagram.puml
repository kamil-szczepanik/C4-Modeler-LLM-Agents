@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(api_gateway, "API Gateway") {
    Component(Routing_and_Perimeter_Defense, "Routing and Perimeter Defense", "Node.js & Envoy", "Handles routing, perimeter defense, and entry point for incoming client requests.")
    Component(Authentication_Manager, "Authentication Manager", "OAuth 2.0 / OIDC and MFA", "Enforces OAuth/MFA authentication and security protocols for incoming requests.")
}

Rel(Routing_and_Perimeter_Defense, Authentication_Manager, "Delegates authentication and token validation")

@enduml