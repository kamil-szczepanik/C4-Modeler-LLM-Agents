@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Database container

Container_Boundary(database, "Database") {
    Component(patroni_coordinator, "Patroni Coordinator", "Patroni", "Manages PostgreSQL high availability, automatic failover, and consensus cluster state.")
    Component(pgbouncer_connection_pooler, "PgBouncer Connection Pooler", "PgBouncer", "Manages and optimizes database connection pooling for high-throughput microservice requests.")
    Component(postgresql_data_engine, "PostgreSQL Data Engine", "PostgreSQL 16 with pgcrypto", "Provides ACID-compliant relational data storage with AES-256 encryption at rest for patient EMR and billing data.")
}

Rel(pgbouncer_connection_pooler, postgresql_data_engine, "Routes and multiplexes queries")
Rel(patroni_coordinator, postgresql_data_engine, "Monitors and manages health and failover")
@enduml