@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Ext(api_gateway, "API Gateway", "Node.js", "Routing and OAuth/MFA enforcement container.")
System_Ext(insurance_payment_gateways, "Insurance Payment Gateways", "External System", "External systems for processing insurance claims and payments.")
ContainerDb(database, "Database", "PostgreSQL", "Encrypted PostgreSQL cluster providing ACID compliance and AES-256 encryption at rest.")

Container_Boundary(billing_engine, "Billing Engine") {
    Component(claim_generation_controller, "Claim Generation Controller", "Java Spring Boot component", "Handles incoming internal gRPC requests and enforces token validation.")
    Component(invoice_processor, "Invoice Processor", "Java Spring Boot component", "Manages itemized statement logic and domain event publishing using Spring Events.")
    Component(payment_orchestrator, "Payment Orchestrator", "Java Spring Boot component", "Coordinates external financial transactions and outbox patterns.")
    Component(billing_repository, "Billing Repository", "Java Spring Boot component", "Manages data access using Spring Data JPA with field-level encryption and Optimistic Locking.")
}

Rel(api_gateway, claim_generation_controller, "Routes internal financial requests", "Internal gRPC")
Rel(payment_orchestrator, insurance_payment_gateways, "Coordinates external financial transactions", "HTTPS REST over mutual TLS (mTLS) with public-key pinning")
Rel(billing_repository, database, "Manages data access and persistence", "JDBC with connection pooling and AES-256 encryption at rest")

@enduml