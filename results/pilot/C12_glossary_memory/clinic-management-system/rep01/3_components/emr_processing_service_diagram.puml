@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

System_Ext(api_gateway, "API Gateway", "Entry point for external and internal traffic")

Container_Boundary(emr_processing_service, "EMR Processing Service") {
    Component(ClinicalRecordController, "ClinicalRecordController", "Java Spring Boot", "Handles incoming gRPC requests from the API Gateway and exposes endpoints for clinical records.")
    Component(ClinicalRecordManager, "ClinicalRecordManager", "Java Spring Boot", "Contains the core clinical workflows, business logic, and orchestrates record management.")
    Component(AuditTrailService, "AuditTrailService", "Java Spring Boot", "Tracks and logs all clinical record access and modifications to ensure HIPAA and GDPR compliance.")
    Component(ClinicalRepositoryAdapter, "ClinicalRepositoryAdapter", "Java Spring Boot / Spring Data JPA", "Manages data access operations and persistence for clinical entities using JPA and Hibernate.")
    ComponentDb(Database, "Database", "PostgreSQL", "Encrypted relational storage ensuring ACID compliance and AES-256 encryption at rest.")
}

Rel(api_gateway, ClinicalRecordController, "Internal gRPC over mTLS", "gRPC")
Rel(ClinicalRecordController, ClinicalRecordManager, "In-process method call", "")
Rel(ClinicalRecordManager, ClinicalRepositoryAdapter, "In-process method call", "")
Rel(ClinicalRepositoryAdapter, Database, "JDBC over TLS", "JDBC")
Rel(ClinicalRecordManager, AuditTrailService, "Spring Application Event Publisher", "")

@enduml