@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(web_frontend, "Web Frontend") {
    Component(spa_container, "SPA Container", "React", "Powers the Single Page Application container with responsive UI and sub-second EMR rendering.")
}

System_Ext(api_gateway, "API Gateway", "Node.js", "Implements the API Gateway for routing, OAuth/MFA enforcement, and security policies.")

Rel(spa_container, api_gateway, "Sends HTTPS (TLS 1.3) requests", "HTTPS (TLS 1.3)")

@enduml