@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(FrontDeskStaff, "Front Desk Staff", "Manages patient admissions, check-ins, and basic scheduling.")
Person(Clinicians, "Clinicians", "Accesses and updates electronic medical records (EMR) and manages clinical workflows.")
Person(BillingSpecialists, "Billing Specialists", "Handles financial transactions, insurance claims, and billing operations.")
Person(Patients, "Patients", "Interacts via portal to view records, schedule appointments, and manage billing.")
Person(ClinicAdministrators, "Clinic Administrators", "Oversees clinic operations and administrative tasks.")
Person(PracticeManagers, "Practice Managers", "Monitors analytics dashboards and performance metrics.")

System(ClinicManagementSystem, "Clinic Management System", "A hybrid cloud clinical IT solution designed to manage patient admissions, electronic medical records, appointment scheduling, and billing for medium-sized hospitals and clinics with high availability and strict regulatory compliance.")

System_Ext(LaboratoryInformationSystemsLIS, "Laboratory Information Systems (LIS)", "External system for managing laboratory test orders and results.")
System_Ext(PACSImagingArchives, "PACS Imaging Archives", "External system for storing and managing medical imaging data.")
System_Ext(InsurancePaymentGateways, "Insurance Payment Gateways", "External systems for processing insurance claims and payments.")

Rel(FrontDeskStaff, ClinicManagementSystem, "Manages patient admissions and scheduling", "HTTPS (TLS 1.3) with OAuth 2.0 / OIDC and MFA")
Rel(Clinicians, ClinicManagementSystem, "Accesses EMR and clinical workflows", "HTTPS (TLS 1.3) with OAuth 2.0 / OIDC and MFA")
Rel(BillingSpecialists, ClinicManagementSystem, "Processes billing and insurance claims", "HTTPS (TLS 1.3) with OAuth 2.0 / OIDC and MFA")
Rel(Patients, ClinicManagementSystem, "Views records and schedules appointments via portal", "HTTPS (TLS 1.3) with OAuth 2.0 / OIDC and MFA")
Rel(ClinicAdministrators, ClinicManagementSystem, "Oversees clinic operations", "HTTPS (TLS 1.3) with OAuth 2.0 / OIDC and MFA")
Rel(PracticeManagers, ClinicManagementSystem, "Monitors analytics dashboards", "HTTPS (TLS 1.3) with OAuth 2.0 / OIDC and MFA")

Rel(ClinicManagementSystem, LaboratoryInformationSystemsLIS, "Exchanges lab orders and results", "HL7 FHIR APIs over secure mutual TLS (mTLS)")
Rel(ClinicManagementSystem, PACSImagingArchives, "Retrieves and stores medical imaging", "HL7 FHIR APIs over secure mutual TLS (mTLS)")
Rel(ClinicManagementSystem, InsurancePaymentGateways, "Processes insurance payments", "HL7 FHIR APIs over secure mutual TLS (mTLS)")

@enduml