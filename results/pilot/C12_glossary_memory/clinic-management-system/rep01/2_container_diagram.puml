@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(FrontDeskStaff, "Front Desk Staff", "Manages patient admissions, check-ins, and basic scheduling.")
Person(Clinicians, "Clinicians", "Accesses and updates electronic medical records (EMR) and manages clinical workflows.")
Person(BillingSpecialists, "Billing Specialists", "Handles financial transactions, insurance claims, and billing operations.")
Person(Patients, "Patients", "Interacts via portal to view records, schedule appointments, and manage billing.")
Person(ClinicAdministrators, "Clinic Administrators", "Oversees clinic operations and administrative tasks.")
Person(PracticeManagers, "Practice Managers", "Monitors analytics dashboards and performance metrics.")

System_Ext(LaboratoryInformationSystemsLIS, "Laboratory Information Systems (LIS)", "External system for managing laboratory test orders and results.")
System_Ext(PACSImagingArchives, "PACS Imaging Archives", "External system for storing and managing medical imaging data.")
System_Ext(InsurancePaymentGateways, "Insurance Payment Gateways", "External systems for processing insurance claims and payments.")

System_Boundary(ClinicManagementSystem, "Clinic Management System") {
    Container(WebFrontend, "Web Frontend", "React", "Single Page Application container providing responsive user interfaces.")
    Container(APIGateway, "API Gateway", "Node.js", "Routing and OAuth/MFA enforcement container.")
    Container(EMRProcessingService, "EMR Processing Service", "Java Spring Boot", "Core clinical records container.")
    Container(BillingEngine, "Billing Engine", "Java Spring Boot", "Isolated container for financial workflows and claims.")
    Container(InteroperabilityService, "Interoperability Service", "Python", "Container handling HL7 FHIR payloads.")
    ContainerDb(Database, "Database", "PostgreSQL", "Encrypted PostgreSQL cluster container with ACID compliance and AES-256 encryption at rest.")
}

Rel(FrontDeskStaff, APIGateway, "Accesses system functionalities securely", "HTTPS (TLS 1.3) with OAuth 2.0 / OIDC and MFA")
Rel(Clinicians, APIGateway, "Accesses EMR and clinical workflows securely", "HTTPS (TLS 1.3) with OAuth 2.0 / OIDC and MFA")
Rel(BillingSpecialists, APIGateway, "Accesses billing workflows securely", "HTTPS (TLS 1.3) with OAuth 2.0 / OIDC and MFA")
Rel(Patients, APIGateway, "Interacts with patient portal securely", "HTTPS (TLS 1.3) with OAuth 2.0 / OIDC and MFA")
Rel(ClinicAdministrators, APIGateway, "Oversees operations securely", "HTTPS (TLS 1.3) with OAuth 2.0 / OIDC and MFA")
Rel(PracticeManagers, APIGateway, "Monitors dashboards securely", "HTTPS (TLS 1.3) with OAuth 2.0 / OIDC and MFA")
Rel(WebFrontend, APIGateway, "Sends user requests to the backend", "HTTPS (TLS 1.3)")
Rel(APIGateway, EMRProcessingService, "Routes internal clinical requests", "Internal gRPC")
Rel(APIGateway, BillingEngine, "Routes internal financial requests", "Internal gRPC")
Rel(APIGateway, InteroperabilityService, "Routes internal HL7 FHIR integration requests", "Internal gRPC")
Rel(InteroperabilityService, LaboratoryInformationSystemsLIS, "Exchanges lab orders and results", "HL7 FHIR APIs over secure mutual TLS (mTLS)")
Rel(InteroperabilityService, PACSImagingArchives, "Retrieves and stores medical imaging", "HL7 FHIR APIs over secure mutual TLS (mTLS)")
Rel(InteroperabilityService, InsurancePaymentGateways, "Processes insurance claims and payments", "HL7 FHIR APIs over secure mutual TLS (mTLS)")
@enduml