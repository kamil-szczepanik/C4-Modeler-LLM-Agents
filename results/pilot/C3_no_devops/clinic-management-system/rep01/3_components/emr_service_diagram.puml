@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(emr_service, "EMR Service") {
    Component(ClinicalChartController, "ClinicalChartController", "Spring REST Controller", "Handles HTTP/gRPC requests for patient clinical charts.")
    Component(EncounterManagementEngine, "EncounterManagementEngine", "Business Logic Service", "Manages clinical encounters, diagnoses, and treatment workflows.")
    Component(AuditTrailLogger, "AuditTrailLogger", "Logging Service", "Generates immutable audit logs for regulatory compliance.")
    Component(DataAccessException, "DataAccessException", "Exception Handling Module", "Manages database access exceptions and error translations.")
    Component(InteroperabilityAdapter, "InteroperabilityAdapter", "Integration Adapter", "Adapts internal data structures to HL7 FHIR standards.")
    Component(CacheInvalidationManager, "CacheInvalidationManager", "Caching Component", "Manages Redis cache synchronization and invalidation for charts.")
}

Rel(ClinicalChartController, EncounterManagementEngine, "Delegates encounter and chart requests")
Rel(EncounterManagementEngine, DataAccessException, "Handles data access errors during database operations")
Rel(EncounterManagementEngine, AuditTrailLogger, "Publishes audit events for clinical record access")
Rel(ClinicalChartController, CacheInvalidationManager, "Triggers cache updates and invalidation")
Rel(EncounterManagementEngine, InteroperabilityAdapter, "Transforms clinical data for external interoperability")
@enduml