@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Person(Hospital Administrators & Clinical Directors, "Hospital Administrators & Clinical Directors", "Accesses executive dashboards to track efficiency and revenue.")
System_Ext(EMR Service & Billing Service, "EMR Service & Billing Service", "External system providing telemetry and usage data.")
System_Ext(Apache Kafka Message Broker, "Apache Kafka Message Broker", "Acts as the core message broker utilizing mutual TLS and SCRAM-SHA-512.")
System_Ext(External Vault/HSM, "External Vault/HSM", "Secures data at rest using Customer-Managed Keys for GDPR compliance.")

Container_Boundary(Analytics Service, "Analytics Service") {
    Component(Ingestion Consumer, "Ingestion Consumer", "Python / FastAPI", "Subscribes and consumes streams from the Apache Kafka Message Broker for high-throughput stream processing.")
    Component(Anonymization Engine, "Anonymization Engine", "Python component", "Passes raw event data and enforces rigorous anonymization to ensure HIPAA and GDPR compliance.")
    Component(Metric Aggregation Engine, "Metric Aggregation Engine", "Apache Spark component", "Executes distributed metric pre-aggregation to reduce storage costs and query latency.")
    Component(Data Warehouse Loader, "Data Warehouse Loader", "Apache Airflow component", "Orchestrates data warehouse loading tasks and pipeline schedules.")
    Component(OLAP Storage Layer, "OLAP Storage Layer", "AWS Redshift columnar store", "Serves as the OLAP storage layer optimized for analytical aggregations.")
    Component(Reporting API & Dashboard Backend, "Reporting API & Dashboard Backend", "Node.js / Express component", "Powers the Reporting API and dashboard backend serving GraphQL queries for hospital administrators.")
}

Rel(EMR Service & Billing Service, Apache Kafka Message Broker, "Streams telemetry and usage data", "Secure TLS tunnels")
Rel(Apache Kafka Message Broker, Ingestion Consumer, "Subscribes and consumes streams", "Native TCP/TLS with mTLS and SCRAM-SHA-512")
Rel(Ingestion Consumer, Anonymization Engine, "Passes raw event data", "In-memory function calls")
Rel(Anonymization Engine, Metric Aggregation Engine, "Forwards anonymized records", "Internal API")
Rel(Metric Aggregation Engine, Data Warehouse Loader, "Passes pre-aggregated rollups", "Optimized TCP binary protocols")
Rel(Data Warehouse Loader, OLAP Storage Layer, "Writes analytical data", "Encrypted SQL/HTTPS")
Rel(External Vault/HSM, OLAP Storage Layer, "Provides Customer-Managed Keys (CMK) for encryption at rest", "Secure KMS protocol")
Rel(Reporting API & Dashboard Backend, OLAP Storage Layer, "Queries aggregated metrics", "HTTPS/SQL with row-level security")
Rel(Hospital Administrators & Clinical Directors, Reporting API & Dashboard Backend, "Accesses executive dashboards", "HTTPS/GraphQL with ABAC")

@enduml