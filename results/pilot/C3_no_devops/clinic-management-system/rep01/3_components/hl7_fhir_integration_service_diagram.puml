@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the HL7 FHIR Integration Service container

Container_Boundary(hl7_fhir_integration_service, "HL7 FHIR Integration Service") {
    Component(FHIR Parser and Transformer, "FHIR Parser and Transformer", "Java, Spring Boot, HAPI FHIR, Apache Camel", "Parses FHIR R4 payloads and transforms data formats for internal and external systems.")
    Component(Integration Event Producer, "Integration Event Producer", "gRPC, Transactional Outbox Pattern", "Streams asynchronous integration events securely to the Apache Kafka message broker.")
}

Rel(FHIR Parser and Transformer, Integration Event Producer, "Sends transformed integration events", "gRPC, Transactional Outbox Pattern")

@enduml