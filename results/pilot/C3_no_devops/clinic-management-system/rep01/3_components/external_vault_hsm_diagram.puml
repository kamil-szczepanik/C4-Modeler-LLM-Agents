@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the External Vault/HSM container

Person(emr_service, "EMR Service", "External system calling the vault")
Person(billing_service, "Billing Service", "External system calling the vault")

Container_Boundary(external_vault_hsm, "External Vault/HSM") {
    Component(transit_secrets_engine, "Transit Secrets Engine", "HashiCorp Vault Enterprise", "Provides envelope encryption for the Clinic Management System via the /v1/transit API.")
    Component(kv_secret_engine, "KV Secret Engine", "HashiCorp Vault Enterprise", "Manages dynamic credential rotation via the /v1/secret API.")
    Component(hardware_security_root_of_trust, "Hardware Security Root of Trust", "Thales Luna and AWS CloudHSM (FIPS 140-2 Level 3 validated)", "Delivers hardware-backed cryptographic operations via PKCS#11 interfaces.")
    Component(vault_raft_storage_backend, "Vault Raft Storage Backend", "HashiCorp Vault Enterprise Storage", "Ensures encrypted state replication across hybrid nodes with automated multi-party unsealing.")
}

Rel(emr_service, transit_secrets_engine, "Invokes envelope encryption", "gRPC over mTLS, Vault Go SDK, AppRole")
Rel(emr_service, kv_secret_engine, "Fetches and rotates dynamic credentials", "gRPC over mTLS, Vault Go SDK, AppRole")
Rel(billing_service, transit_secrets_engine, "Invokes envelope encryption", "gRPC over mTLS, Vault Go SDK, AppRole")
Rel(billing_service, kv_secret_engine, "Fetches and rotates dynamic credentials", "gRPC over mTLS, Vault Go SDK, AppRole")
Rel(transit_secrets_engine, hardware_security_root_of_trust, "Executes cryptographic hardware operations", "PKCS#11")

@enduml