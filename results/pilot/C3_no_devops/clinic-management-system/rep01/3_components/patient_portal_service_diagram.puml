@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Patient Portal Service container

Container_Boundary(patient_portal_service, "Patient Portal Service") {
    Component(Authentication_Controller, "Authentication Controller", "Node.js / TypeScript", "Manages OAuth2/MFA flows via Identity Provider.")
    Component(Demographics_Manager, "Demographics Manager", "Prisma ORM / TypeScript", "Handles patient profile updates and demographic data.")
    Component(EMR_Viewer, "EMR Viewer", "Prisma ORM / TypeScript", "Handles record rendering and EMR viewing for patients and proxies.")
    Component(Proxy_Access_Controller, "Proxy Access Controller", "Node.js / TypeScript", "Supports delegated access management for proxies.")
    Component(Localization_Manager, "Localization Manager", "Node.js / TypeScript", "Supports multilingual rendering for the portal.")
}

System_Ext(Identity_Provider, "Identity Provider", "External Identity and Access Management system.")
ContainerDb(PostgreSQL_Database, "PostgreSQL Database", "Database", "Persists patient data and audit logs.")
System_Ext(Apache_Kafka_Message_Broker, "Apache Kafka Message Broker", "Event streaming platform.")
System_Ext(Scheduling_Service, "Scheduling Service", "Manages appointment scheduling and resources.")

Rel(Authentication_Controller, Identity_Provider, "Validates JWT tokens and multi-factor authentication", "OAuth2 / OIDC")
Rel(Demographics_Manager, PostgreSQL_Database, "Persists patient data and audit logs", "TLS 1.3 with AES-256 at rest")
Rel(EMR_Viewer, PostgreSQL_Database, "Queries patient records", "TLS 1.3 with AES-256 at rest")
Rel(Demographics_Manager, Apache_Kafka_Message_Broker, "Publishes domain events", "Internal TLS")
Rel(EMR_Viewer, Scheduling_Service, "Checks appointment resource clashes", "gRPC over mTLS")

@enduml