@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the PostgreSQL Database container

Container_Boundary(postgresql_database, "PostgreSQL Database") {
    Component(patient_schema, "patient_schema", "PostgreSQL Schema", "Stores patient demographics and core identity data.")
    Component(scheduling_schema, "scheduling_schema", "PostgreSQL Schema", "Manages appointment scheduling and clash check logic.")
    Component(emr_schema, "emr_schema", "PostgreSQL Schema", "Stores electronic medical records and audit trails.")
    Component(billing_schema, "billing_schema", "PostgreSQL Schema", "Handles insurance claims and billing data.")
    Component(patroni_cluster_with_etcd, "Patroni Cluster with etcd", "Patroni, etcd, PostgreSQL", "Provides high availability consensus, automated failover, and management.")
    Component(pgbouncer, "PgBouncer", "PgBouncer", "Provides connection pooling to maintain sub-second P95 EMR performance.")
    Component(analytics_service_read_replica, "Analytics Service Read Replica", "PostgreSQL Read Replica", "Offloads reporting workloads via logical replication.")
    Component(external_hsm___vault, "External HSM / Vault", "External HSM / Vault", "Manages AES-256 encryption keys with 90-day rotation.")
}

Rel(pgbouncer, patient_schema, "Pools connections for reading and writing patient demographics", "mTLS with AES-256 at rest")
Rel(pgbouncer, scheduling_schema, "Pools connections for reading and writing scheduling data", "mTLS with AES-256 at rest")
Rel(pgbouncer, emr_schema, "Pools connections for reading and writing electronic medical records", "mTLS with AES-256 at rest")
Rel(pgbouncer, billing_schema, "Pools connections for reading and writing billing data", "mTLS with AES-256 at rest")
Rel(patroni_cluster_with_etcd, analytics_service_read_replica, "Streams logical replication data", "TLS")

@enduml