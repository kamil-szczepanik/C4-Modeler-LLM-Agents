@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Billing Service container

System_Ext(Insurance_Clearinghouses, "Insurance Clearinghouses", "External insurance clearinghouses for claim submissions.")
System_Ext(Payment_Gateways, "Payment Gateways", "External payment gateways for processing financial transactions.")
System_Ext(PostgreSQL_Database, "PostgreSQL Database", "PostgreSQL database storing ledger and transactional data [AES-256].")
System_Ext(Apache_Kafka, "Apache Kafka", "Message broker for asynchronous domain events.")
System_Ext(External_Vault_HSM, "External Vault / HSM", "Hardware Security Module / Vault for secure secrets management.")

Container_Boundary(billing_service, "Billing Service") {
    Component(Invoice_Engine, "Invoice Engine", "Spring Boot / Java", "Manages financial transactions and itemized invoicing.")
    Component(Claim_Processor, "Claim Processor", "Spring Boot / Java", "Handles insurance claim submissions and communicates with external clearinghouses.")
    Component(Payment_Orchestrator, "Payment Orchestrator", "Spring Boot / Java with Resilience4j", "Processes payment transactions and interacts with external payment gateways.")
    Component(Billing_Data_Access_Repository, "Billing Data Access Repository", "Spring Data JPA & JDBC", "Persists ledger records and transactional data to the PostgreSQL Database.")
}

Rel(Invoice_Engine, Billing_Data_Access_Repository, "Persists ledger records", "TLS with AES-256 at rest")
Rel(Claim_Processor, Insurance_Clearinghouses, "Submits X12 EDI / HL7 FHIR claims", "Secure REST/HTTPS")
Rel(Payment_Orchestrator, Payment_Gateways, "Processes transactions with tokenized PANs", "Secure REST/HTTPS")
Rel(Billing_Data_Access_Repository, PostgreSQL_Database, "Persists transactional data", "TLS with AES-256 at rest")
Rel(billing_service, Apache_Kafka, "Publishes asynchronous domain events", "Internal TLS")
Rel(billing_service, External_Vault_HSM, "Retrieves API keys and PCI-DSS credentials", "Encrypted channels")

@enduml