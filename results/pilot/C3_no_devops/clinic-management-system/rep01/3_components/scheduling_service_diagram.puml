@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(scheduling_service, "Scheduling Service") {
    Component(Appointment_API_Controller, "Appointment API Controller", "Spring Boot", "Exposes endpoints for managing patient appointments and routes scheduling requests.")
    Component(Conflict_Resolution_Engine, "Conflict Resolution Engine", "Java 17", "Validates and resolves scheduling conflicts in real-time.")
    Component(Calendar_Management_Service, "Calendar Management Service", "Java 17", "Manages calendar availability and time slots.")
    Component(Notification_Dispatcher, "Notification Dispatcher", "Spring Boot", "Dispatches appointment notifications and reminders to users.")
    Component(Waitlist_Orchestrator, "Waitlist Orchestrator", "Java 17", "Orchestrates patient waitlists and manages slot reallocation.")
}

Rel(Appointment_API_Controller, Conflict_Resolution_Engine, "Invokes slot validation and conflict checks")
Rel(Conflict_Resolution_Engine, Calendar_Management_Service, "Queries and updates calendar data")
Rel(Appointment_API_Controller, Notification_Dispatcher, "Triggers notifications upon appointment changes")
Rel(Appointment_API_Controller, Waitlist_Orchestrator, "Manages waitlist entries when slots are unavailable")

@enduml