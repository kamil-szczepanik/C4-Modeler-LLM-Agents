@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Apache Kafka Message Broker container

Container_Boundary(kafka_broker_container, "Apache Kafka Message Broker") {
    Component(KafkaBroker, "Kafka Broker", "JVM-based stateful process", "Handles core messaging, event distribution, and cluster state management.")
    Component(KRaftControllerNodes, "KRaft Controller Nodes", "KRaft consensus mechanism", "Manages metadata and quorum coordination without ZooKeeper.")
    Component(LocalLogSegmentStorageVolumes, "Local Log Segment Storage Volumes", "Persistent Storage Volumes", "Stores append-only event logs for the message broker.")
    Component(KafkaStreamsPIIMaskingProcessor, "Kafka Streams PII-masking Processor", "Kafka Streams", "Processes and masks personally identifiable information from event streams.")
    Component(SchemaRegistry, "Schema Registry", "Avro Schema Registry", "Enforces strict schema rules for event streams using Avro serialization.")
}

Rel(KafkaBroker, LocalLogSegmentStorageVolumes, "Persists event logs")
Rel(KafkaBroker, KRaftControllerNodes, "Coordinates cluster metadata")
Rel(KafkaStreamsPIIMaskingProcessor, KafkaBroker, "Consumes and produces sanitized events")
Rel(SchemaRegistry, KafkaBroker, "Validates event schemas")

@enduml