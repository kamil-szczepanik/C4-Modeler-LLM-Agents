@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(Patients, "Patients", "Patients using the self-service portal for booking and real-time updates.")
Person(Receptionists, "Receptionists", "Staff managing front-desk operations, admissions, and scheduling.")
Person(Clinical Staff, "Clinical Staff", "Medical professionals accessing electronic medical records and clinical workflows.")
Person(Billing Specialists, "Billing Specialists", "Personnel managing patient billing, payments, and insurance claims.")

System(Clinic Management System, "Clinic Management System", "A hybrid cloud platform designed to manage patient admissions, electronic medical records, scheduling, and billing for clinics while maintaining strict HIPAA and GDPR compliance.")

System_Ext(External Labs/Imaging, "External Labs/Imaging", "External laboratory and imaging systems for diagnostic data exchange.")
System_Ext(Insurance Clearinghouses, "Insurance Clearinghouses", "External systems for processing insurance claims via X12/EDI.")
System_Ext(Payment Gateways, "Payment Gateways", "External payment processing services.")
System_Ext(Product Analytics, "Product Analytics", "Analytics platforms like Mixpanel and Segment for tracking usage metrics.")
System_Ext(Identity Provider, "Identity Provider", "External or internal IDP for multi-factor authentication via OIDC/SAML 2.0.")

Rel(Patients, Clinic Management System, "Self-service booking and real-time updates", "HTTPS/WebSockets")
Rel(Receptionists, Clinic Management System, "Manage patient admissions and scheduling", "HTTPS")
Rel(Clinical Staff, Clinic Management System, "Manage electronic medical records and clinical operations", "HTTPS")
Rel(Billing Specialists, Clinic Management System, "Process billing and insurance claims", "HTTPS")
Rel(Clinic Management System, External Labs/Imaging, "Exchange healthcare data and lab results", "HL7 FHIR over HTTPS")
Rel(Clinic Management System, Insurance Clearinghouses, "Submit and process insurance claims", "X12/EDI protocols")
Rel(Clinic Management System, Payment Gateways, "Process financial transactions", "REST APIs using TLS 1.3")
Rel(Clinic Management System, Identity Provider, "Authenticate users with multi-factor authentication", "OIDC/SAML 2.0")

@enduml