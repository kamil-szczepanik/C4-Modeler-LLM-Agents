@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

title Container diagram for Clinic Management System

Person(Users, "Patients, Clinicians, and Billing Staff", "Users who interact with the system to manage patient admissions, records, scheduling, and billing.")

System_Ext(ExternalPaymentGateways, "External Payment Gateways", "External systems used for processing payments.")
System_Ext(InsuranceClearinghouses, "Insurance Clearinghouses", "External systems used for managing insurance claims.")
System_Ext(LabandImagingSystems, "Lab and Imaging Systems", "External medical systems exchanging health data.")

System_Boundary(ClinicManagementSystem, "Clinic Management System") {
    Container(NextjsSinglePageApplication, "Next.js Single Page Application", "Next.js / CDN", "Frontend container delivering sub-second P95 frontend screen loads.")
    Container(GoAPIGateway, "Go API Gateway", "Go", "Powers the API Gateway for high-performance request routing and rate limiting.")
    Container(JavaSpringBootMicroservices, "Java Spring Boot Microservices", "Java Spring Boot", "Handles robust enterprise transactions for Patient, Scheduling, EMR, and Billing microservices.")
    Container(ApacheCamelKIntegrationBroker, "Apache Camel K Integration Broker", "Apache Camel K", "Manages isolated HL7 FHIR integrations and interoperability.")
    Container(ApacheKafka, "Apache Kafka", "Apache Kafka", "Provides event streaming and immutable audit logs for 10-year retention.")
    ContainerDb(MultimasterPostgreSQLClusterandRedisEnterprise, "Multi-master PostgreSQL Cluster and Redis Enterprise", "PostgreSQL, Redis, AES-256", "Ensures multi-master active-active persistence and low-latency scheduling checks with encryption.")
}

Rel(Users, NextjsSinglePageApplication, "Interacts with the application to manage admissions, EMRs, scheduling, and billing", "HTTPS/JSON")
Rel(NextjsSinglePageApplication, GoAPIGateway, "Routes frontend requests through the gateway", "HTTPS/JSON")
Rel(GoAPIGateway, JavaSpringBootMicroservices, "Routes requests to microservices", "gRPC with mTLS")
Rel(JavaSpringBootMicroservices, MultimasterPostgreSQLClusterandRedisEnterprise, "Reads and writes persistence and caching data", "gRPC and SQL protocols")
Rel(JavaSpringBootMicroservices, ApacheKafka, "Publishes and consumes audit events and streams", "TCP/TLS")
Rel(ApacheCamelKIntegrationBroker, LabandImagingSystems, "Exchanges health data with external medical systems", "HL7 FHIR over HTTPS")
Rel(JavaSpringBootMicroservices, ExternalPaymentGateways, "Processes payments and financial transactions", "HTTPS")
Rel(JavaSpringBootMicroservices, InsuranceClearinghouses, "Submits and reconciles insurance claims", "HTTPS")

@enduml