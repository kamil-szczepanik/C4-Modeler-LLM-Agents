@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

Container_Boundary(multi_master_postgresql_cluster_and_redis_enterprise, "Multi-master PostgreSQL Cluster and Redis Enterprise") {
    Component(Multi_master_PostgreSQL_Cluster, "Multi-master PostgreSQL Cluster", "PostgreSQL, AES-256", "Active-active multi-master data tier with CRDTs for low-latency persistence and regulatory-compliant encrypted storage.")
    Component(Redis_Enterprise_Cluster_Proxy, "Redis Enterprise Cluster Proxy", "Redis, RESP/RESP3", "In-memory data store for fast caching and scheduling locks.")
}

System(Java_Spring_Boot_Microservices, "Java Spring Boot Microservices", "Microservices framework for robust business logic")

Rel(Java_Spring_Boot_Microservices, Multi_master_PostgreSQL_Cluster, "Persists and queries relational data", "PostgreSQL Wire Protocol (TCP, gRPC)")
Rel(Java_Spring_Boot_Microservices, Redis_Enterprise_Cluster_Proxy, "Caches data and manages scheduling locks", "RESP/RESP3")

@enduml