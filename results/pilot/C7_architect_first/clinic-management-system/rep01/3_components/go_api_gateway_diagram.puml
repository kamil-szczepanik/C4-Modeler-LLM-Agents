@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Go API Gateway container

Container_Boundary(go_api_gateway, "Go API Gateway") {
    Component(HTTP Router, "HTTP Router", "gorilla/mux", "Inbound request router providing high-speed URL pattern matching.")
    Component(Auth Middleware, "Auth Middleware", "Go / JWT", "JWT validator enforcing HIPAA/GDPR access controls.")
    Component(Rate Limiter & Cacher, "Rate Limiter & Cacher", "Redis Enterprise, go-redis, ristretto", "Handles distributed throttling and local caching with 60-second TTL.")
    Component(gRPC Client Pool, "gRPC Client Pool", "gRPC, HTTP/2, sony/gopher-breaker, SPIFFE/SPIRE", "Manages internal service communication with circuit breaking and mTLS.")
    Component(Observability, "Observability", "Prometheus, OpenTelemetry", "Exports Prometheus metrics and OpenTelemetry distributed traces.")
}

Rel(HTTP Router, Auth Middleware, "Passes inbound requests for authentication", "JWT Validation")
Rel(Auth Middleware, Rate Limiter & Cacher, "Checks throttling limits", "TCP/Redis Protocol")
Rel(Rate Limiter & Cacher, HTTP Router, "Returns caching and rate-limiting status")
Rel(HTTP Router, gRPC Client Pool, "Forwards validated requests to internal services", "gRPC, mTLS")
Rel(HTTP Router, Observability, "Reports metrics and trace data")

@enduml