@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Java Spring Boot Microservices container

Container_Boundary("Java Spring Boot Microservices", "Java Spring Boot Microservices") {
    Component(PatientService, "PatientService", "Java Spring Boot 3.2", "Manages patient admissions and demographic records.")
    Component(SchedulingService, "SchedulingService", "Java Spring Boot 3.2", "Handles appointment scheduling and clinician calendars.")
    Component(EMRService, "EMRService", "Java Spring Boot 3.2", "Manages Electronic Medical Records and HL7 FHIR interoperability.")
    Component(BillingService, "BillingService", "Java Spring Boot 3.2", "Processes financial transactions, insurance claims, and billing.")
    Component(AuditService, "AuditService", "Java Spring Boot 3.2", "Streams and logs audit events for HIPAA and GDPR compliance.")
}

System_Ext("Multi-master PostgreSQL Cluster", "Multi-master PostgreSQL Cluster", "Database")
System_Ext("Redis Enterprise", "Redis Enterprise", "Cache")
System_Ext("Apache Kafka", "Apache Kafka", "Event Stream")

Rel(PatientService, "Multi-master PostgreSQL Cluster", "Persists patient data", "SQL/TLS")
Rel(SchedulingService, "Multi-master PostgreSQL Cluster", "Persists appointment data", "SQL/TLS")
Rel(EMRService, "Redis Enterprise", "Caches EMR data", "Lettuce")
Rel(EMRService, "Multi-master PostgreSQL Cluster", "Persists EMR data", "SQL/TLS")
Rel(BillingService, "Multi-master PostgreSQL Cluster", "Persists billing data", "SQL/TLS")
Rel(AuditService, "Apache Kafka", "Streams audit events and Saga messages", "TCP/TLS")

@enduml