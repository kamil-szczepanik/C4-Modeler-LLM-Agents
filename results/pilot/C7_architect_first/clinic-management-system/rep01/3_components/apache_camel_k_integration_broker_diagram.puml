@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Apache Camel K Integration Broker container

System_Ext(Apache_Kafka, "Apache Kafka", "External event streaming platform")
System_Ext(Third_Party_Lab_and_Imaging_Systems, "Third-Party Lab and Imaging Systems", "External medical systems")
System_Ext(HashiCorp_Vault, "HashiCorp Vault", "Secret management for dynamic mTLS certificate injection")

Container_Boundary(Apache_Camel_K_Integration_Broker, "Apache Camel K Integration Broker") {
    Component(FHIR_Transformer_Component, "FHIR Transformer Component", "Quarkus runtime, camel-fhir", "Clinical data mapping and validation using camel-fhir.")
    Component(Routing_Slip_Manager, "Routing Slip Manager", "Camel Enterprise Integration Pattern engine", "Manages asynchronous message flows.")
    Component(Kafka_Consumer_Component, "Kafka Consumer Component", "Reactive connectors, TCP/SASL", "Ingests events from Apache Kafka.")
    Component(HTTPS_REST_Dispatcher_Component, "HTTPS/REST Dispatcher Component", "TLS 1.3, mTLS", "Manages outbound traffic to external labs.")
}

Rel(Kafka_Consumer_Component, Apache_Kafka, "Ingests asynchronous events", "TCP/SASL")
Rel(HTTPS_REST_Dispatcher_Component, Third_Party_Lab_and_Imaging_Systems, "Exchanges health data", "HTTPS with TLS 1.3 and mTLS")
Rel(Routing_Slip_Manager, FHIR_Transformer_Component, "Direct in-memory exchanges for data transformation", "direct:// endpoints")
Rel(HashiCorp_Vault, HTTPS_REST_Dispatcher_Component, "Injects ephemeral client certificates for authentication", "Secure API")

@enduml