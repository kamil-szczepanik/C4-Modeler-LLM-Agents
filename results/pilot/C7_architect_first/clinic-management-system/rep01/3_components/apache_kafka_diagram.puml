@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_WITH_LEGEND()

title Component diagram for the Apache Kafka container

System_Ext(ClientMicroservices, "Client Microservices", "External client microservices.")
System_Ext(TieredObjectStorage, "Tiered Object Storage", "External object storage for log offloading.")
System_Ext(OnPremisesKubernetesCluster, "On-Premises Kubernetes Cluster", "External on-premises Kubernetes cluster.")
System_Ext(AWSEUCentral1, "AWS eu-central-1", "External AWS region for disaster recovery and replication.")

Container_Boundary(ApacheKafka, "Apache Kafka") {
    Component(NetworkProcessor, "Network Processor", "Java, TCP/TLS 1.3", "Manages client TCP connections and inbound requests.")
    Component(RequestChannelKafkaRequestHandlerPool, "Request Channel & KafkaRequestHandler Pool", "Java, Concurrency Framework", "Handles concurrency and request execution.")
    Component(LogManagerLogSegment, "Log Manager & LogSegment", "Java, NVMe Local Disks, Tiered Object Storage", "Manages segment storage, NVMe local disks, and tiered object storage offloading.")
    Component(KRaftMetadataQuorum, "KRaft Metadata Quorum", "KRaft Protocol, mTLS, TCP", "Provides cluster coordination, controller election, and metadata consensus.")
    Component(StrimziOperator, "Strimzi Operator", "Kubernetes, Go, CRDs", "Automates Kubernetes lifecycle management, rolling upgrades, and pod anti-affinity.")
    Component(CruiseControl, "Cruise Control", "Java, Apache Kafka", "Executes automated cluster rebalancing, self-healing, and workload redistribution.")
    Component(KafkaProducerKafkaConsumer, "KafkaProducer & KafkaConsumer", "Java Client Libraries", "Client libraries for application-level data publishing and consumption.")
}

Rel(ClientMicroservices, NetworkProcessor, "Publishes and consumes audit events and streams", "TCP/TLS 1.3, mTLS")
Rel(LogManagerLogSegment, TieredObjectStorage, "Offloads older log segments", "HTTPS/TLS")
Rel(LogManagerLogSegment, KRaftMetadataQuorum, "Coordinates metadata consensus", "mTLS, TCP")
Rel(OnPremisesKubernetesCluster, AWSEUCentral1, "Replicates critical audit topics", "MirrorMaker 2, TLS 1.3")

@enduml