@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person(PatientsCliniciansandBillingStaff, "Patients, Clinicians, and Billing Staff", "Users who interact with the system to manage patient admissions, records, scheduling, and billing.")
System(ClinicManagementSystemCMS, "Clinic Management System (CMS)", "An enterprise software solution designed for medium-sized hospitals and clinics to manage patient admissions, electronic medical records, scheduling, and billing with high availability and stringent compliance.")
System_Ext(ExternalPaymentGatewaysInsuranceClearinghouse, "External Payment Gateways & Insurance Clearinghouse", "External systems used to process copays and insurance claims.")
System_Ext(ThirdPartyLabandImagingSystems, "Third-Party Lab and Imaging Systems", "External medical systems that exchange health data.")
System_Ext(IdentityProviderIdP, "Identity Provider (IdP)", "System providing Multi-Factor Authentication and identity management.")
System_Ext(ExternalNotificationService, "External Notification Service", "SMS and Email providers used to dispatch alerts and MFA challenges.")

Rel(PatientsCliniciansandBillingStaff, ClinicManagementSystemCMS, "Interacts to manage records, scheduling, and billing", "HTTPS, OAuth 2.0 / OpenID Connect")
Rel(ClinicManagementSystemCMS, ExternalPaymentGatewaysInsuranceClearinghouse, "Processes copays and insurance claims", "REST/TLS")
Rel(ClinicManagementSystemCMS, ThirdPartyLabandImagingSystems, "Exchanges health data", "HL7 FHIR APIs over HTTPS")
Rel(ClinicManagementSystemCMS, ExternalNotificationService, "Dispatches alerts and MFA challenges", "SMPP and HTTPS")
@enduml